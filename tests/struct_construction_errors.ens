// @expect-error is missing the required field 'y'
// @expect-error has no field named 'z'
// @expect-error is set more than once
// @expect-error expected 'int', got 'string'
// @expect-error Cannot tell which struct
// @expect-error has no constructor to call
// Every struct-construction error in one place: a missing required field, an
// unknown field, a duplicate field, a value type mismatch, a literal with no
// target type, and a call on a struct with no constructor.
struct Point {
    int x;
    int y;
}

struct Solo {
    int x;
}

main() -> int {
    Point missing = {x: 1};
    Solo unknown = {x: 1, z: 2};
    Solo duplicate = {x: 1, x: 2};
    Solo mismatch = {x: "hi"};
    let untargeted = {x: 1};
    Solo noConstructor = Solo(1);
    return 0;
}
