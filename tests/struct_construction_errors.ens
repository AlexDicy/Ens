struct Point {
    protected int x;
    protected int y;
}

struct Solo {
    protected int x;
}

main() -> int {
    Point missing = {x: 1};
    Solo unknown = {x: 1, z: 2};
    Solo duplicate = {x: 1, x: 2};
    Solo mismatch = {x: "hi"};
    let untargeted = {x: 1};
    Solo noConstructor = Solo(1);
    return 0;
}
