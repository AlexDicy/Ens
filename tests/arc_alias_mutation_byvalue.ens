// @exit 5
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

struct Container {
    protected Box b = new Box();
}

mutateViaAlias(Container c) {
    let x = c;
    x.b = new Box();
    x.b.v = 999;
}

main() -> int {
    Container c = {};
    c.b.v = 5;
    mutateViaAlias(c);
    return c.b.v;
}
