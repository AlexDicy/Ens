// @expect-error Method 'toString' replaces the built-in text form of struct 'Point', so it must be as visible as 'Point' itself; mark it 'public'
// A struct's own 'toString' runs wherever the struct is rendered, so it may not be less
// visible than the struct itself. Unmarked it follows the struct; a modifier that
// narrows it is an error.

public struct Point {
    int x;

    protected override toString() -> string {
        return "Point({this.x})";
    }
}

main() -> int {
    Point p = {x: 1};
    print("{p}");
    return 0;
}
