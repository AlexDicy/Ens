// @exit 0
// @stdout new-keep 5
// A `new` keeps a plain local's own narrowing just as a call does: the constructor
// cannot reassign the caller's binding, and the local's reference keeps the narrowed
// object alive. Only member-path narrowings rooted at a passed value drop.
class Door {
    protected int code;

    protected constructor(this.code = 0);
}

class Wrapper {
    protected constructor(Door d) {
    }
}

read(Door? d) -> int {
    if (d != null) {
        let wrapper = new Wrapper(d);  // d passed to a constructor
        return d.code;                 // ok - d's own narrowing survives
    }
    return -1;
}

main() -> int {
    int result = read(new Door(5));
    print("new-keep " + result);
    return result - 5;
}
