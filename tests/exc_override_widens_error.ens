// @expect-error An override throws only what the method it overrides allows
class IOError extends Error { protected constructor(string m) { super(m); } }

class NetError extends Error { protected constructor(string m) { super(m); } }

class Base {
    read() -> int throws IOError { throw new IOError("x"); }
}

class Derived extends Base {
    override read() -> int throws { throw new NetError("y"); }   // NetError not allowed by Base
}

main() -> int { return 0; }