// @expect-error An override may only throw types already allowed
class IOError extends Error { IOError(string m) { super(m); } }

class NetError extends Error { NetError(string m) { super(m); } }

class Base {
    read() -> int throws IOError { throw new IOError("x"); }
}

class Derived extends Base {
    override read() -> int throws { throw new NetError("y"); }   // NetError not allowed by Base
}

main() -> int { return 0; }