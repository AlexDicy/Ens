// @expect-error Override 'read' can throw 'NetError', which the 'read' it overrides in 'Base' does not list. An override throws only what the method it overrides lists. Remove 'throws' and catch 'NetError' with a 'catch' clause after the body. Or add 'NetError' to the 'throws' list of 'read' in 'Base'.
// @expect-error build failed with 1 problem
// A type the overridden method does not list is refused as widening it, and an override marked
// with a bare 'throws' is told to remove it.
class IOError extends Error { protected constructor(string m) { super(m); } }

class NetError extends Error { protected constructor(string m) { super(m); } }

class Base {
    protected read() -> int throws IOError { throw new IOError("x"); }
}

class Derived extends Base {
    protected override read() -> int throws { throw new NetError("y"); }   // NetError not allowed by Base
}

main() -> int { return 0; }
