// @expect-error build failed with 5 problems
// A type the overridden or implemented method does not list is refused as widening it, and an
// override not marked 'throws' is not told to add a marker that would not compile.
class IOError extends Error { protected constructor(string m) { super(m); } }

class NetError extends Error { protected constructor(string m) { super(m); } }

fetch() throws NetError {
    throw new NetError("f");
}

class Base {
    protected read() -> int throws IOError { throw new IOError("x"); }

    protected write() throws IOError { throw new IOError("w"); }
}

class Derived extends Base {
    protected override read() -> int throws { throw new NetError("y"); }   // NetError not allowed by Base

    protected override write() {
        fetch();
        throw new NetError("z");
    }
}

interface Store {
    save() throws IOError;
}

class DiskStore implements Store {
    protected constructor();

    protected override save() {
        fetch();
        throw new NetError("s");
    }
}

main() -> int { return 0; }
