// @exit 0
// @stdout released hole
// @stdout pair hole
// @stdout after hole
// @stdout released object
// @stdout class object
// @stdout after object
// @stdout released text
// @stdout shown text
// @stdout after text
// @stdout released operand
// @stdout sum operand
// @stdout after operand
// @stdout released right
// @stdout released left
// @stdout same false
// @stdout released fallback
// @stdout coalesced fallback
// @stdout released present
// @stdout coalesced present
// @stdout released kept
// @stdout kept kept
// @stdout released element
// @stdout element element
// @stdout released first
// @stdout read assigned
// @stdout replaced second
// @stdout released assigned
// @stdout replaced third
// @stdout released while 0
// @stdout loop 0
// @stdout released while 1
// @stdout loop 1
// @stdout released while 2
// @stdout scope done
// @stdout released third
// @stdout released second
// @stdout scope gone
// @stdout visit array
// @stdout visit array second
// @stdout released array
// @stdout released array second
// @stdout after array
// @stdout released walk
// @stdout visit walk 1
// @stdout released walk 1
// @stdout visit walk 0
// @stdout released walk 0
// @stdout released iterator walk
// @stdout after walk
// @stdout visit broken
// @stdout released broken
// @stdout released broken second
// @stdout after broken
// @stdout released stopped
// @stdout visit stopped 1
// @stdout released stopped 1
// @stdout released iterator stopped
// @stdout after stopped
// @stdout released returned
// @stdout released returned 1
// @stdout released iterator returned
// @stdout first returned 1
// @stdout loops done
// @stdout loops gone
// A struct an expression makes and reads through, such as a call's result whose field is read, is
// released where the expression that uses it ends, the way a class temporary is: in an
// interpolation hole, an operand, a '??', a declaration's initial value, a read back out of an
// assignment and a loop condition. What a for-each loop walks, the iterator it makes and the last
// element it reads are released where the loop ends, and a struct it makes an iterator from once
// the iterator is made. Each Probe reports its own release, so a value kept until the end of its
// scope prints late and a missed release never prints.
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

class Probe {
    string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Pair {
    Probe probe;
}

struct Shown {
    Probe probe;

    override toString() -> string {
        return "shown " + this.probe.label;
    }
}

struct Keyed {
    Probe probe;

    override equals(Keyed other) -> bool {
        return this.probe.label == other.probe.label;
    }

    override hash() -> long {
        return 0;
    }
}

pair(string label) -> Pair {
    return {probe: new Probe(label)};
}

probe(string label) -> Probe {
    return new Probe(label);
}

shown(string label) -> Shown {
    return {probe: new Probe(label)};
}

keyed(string label) -> Keyed {
    return {probe: new Probe(label)};
}

maybe(string label, bool present) -> Pair? {
    if (present) {
        return pair(label);
    }
    return null;
}

probes(string label) -> Probe[] {
    return [new Probe(label)];
}

twoProbes(string label) -> Probe[] {
    return [new Probe(label), new Probe(label + " second")];
}

class Steps implements Iterator<Probe> {
    string prefix;
    int left;

    constructor(this.prefix, this.left);

    destructor() {
        print("released iterator " + this.prefix);
    }

    override next() -> Probe? {
        if (this.left == 0) {
            return null;
        }
        this.left--;
        return new Probe("{this.prefix} {this.left}");
    }
}

struct Walk implements Iterable<Probe> {
    Probe probe;

    override makeIterator() -> Iterator<Probe> {
        return new Steps(this.probe.label, 2);
    }
}

walk(string label) -> Walk {
    return {probe: new Probe(label)};
}

firstOf(string label) -> string {
    for (let step in walk(label)) {
        return step.label;
    }
    return "none";
}

main() -> int {
    {
        bool yes = "yes".length > 0;
        print("pair {pair("hole").probe.label}");
        print("after hole");
        print("class {probe("object").label}");
        print("after object");
        print("{shown("text")}");
        print("after text");
        print("sum " + pair("operand").probe.label);
        print("after operand");
        bool same = keyed("left") == keyed("right");
        print("same {same}");
        string coalesced = (maybe("absent", false) ?? pair("fallback")).probe.label;
        print("coalesced {coalesced}");
        coalesced = (maybe("present", yes) ?? pair("unused")).probe.label;
        print("coalesced {coalesced}");
        string kept = pair("kept").probe.label;
        print("kept {kept}");
        string element = probes("element")[0].label;
        print("element {element}");
        Pair held = pair("first");
        Pair other = pair("assigned");
        print("read {(held = other).probe.label}");
        held = pair("second");
        print("replaced {held.probe.label}");
        other = pair("third");
        print("replaced {other.probe.label}");
        int count = 0;
        while (pair("while {count}").probe.label.length < 9 && count < 2) {
            print("loop {count}");
            count++;
        }
        print("scope done");
    }
    print("scope gone");
    {
        for (let visited in twoProbes("array")) {
            print("visit " + visited.label);
        }
        print("after array");
        for (let step in walk("walk")) {
            print("visit " + step.label);
        }
        print("after walk");
        for (let visited in twoProbes("broken")) {
            print("visit " + visited.label);
            break;
        }
        print("after broken");
        for (let step in walk("stopped")) {
            print("visit " + step.label);
            break;
        }
        print("after stopped");
        print("first " + firstOf("returned"));
        print("loops done");
    }
    print("loops gone");
    return 0;
}
