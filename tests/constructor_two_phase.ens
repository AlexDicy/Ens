// @exit 0
// @stdout item argument
// @stdout item default
// @stdout derived default
// @stdout derived phase one
// @stdout base default
// @stdout base sees d x
// @stdout derived phase two d x
// @stdout base default
// @stdout base sees no
// @stdout branched no right
// @stdout base default
// @stdout base sees r
// @stdout retagged t
// @stdout implicit body
// @stdout middle default
// @stdout root default
// @stdout built root default middle default implicit body
// @stdout destroyed r
// @stdout destroyed no
// @stdout destroyed d
// @stdout released held x
// @stdout released argument
// @stdout caught refused
// A subclass constructor assigns its own fields before 'super(...)' runs the base constructor, so an
// override that constructor calls reads them, and one that writes no 'super(...)' builds its base
// where it finishes. The arguments of 'new' run before the defaults of the object, and one that
// throws abandons it, so only what the arguments built is released.
note(string text) -> string {
    print(text);
    return text;
}

class Item {
    string label = note("item default");

    constructor(string given) { }
}

class Held {
    string name;

    constructor(this.name);

    destructor() {
        print("released {this.name}");
    }
}

class Named {
    protected string name;
    protected string tag = note("base default");

    protected constructor(this.name) {
        print("base sees {this.describe()}");
    }

    protected describe() -> string {
        return this.name;
    }

    destructor() {
        print("destroyed {this.name}");
    }
}

class Derived extends Named {
    string extra;
    string mark = note("derived default");
    Held held;

    constructor(string name, string extra) {
        this.extra = extra;
        this.held = new Held("held {extra}");
        print("derived phase one");
        super(name);
        print("derived phase two {this.describe()}");
    }

    protected override describe() -> string {
        return "{this.name} {this.extra}";
    }
}

class Branched extends Named {
    string side;

    constructor(bool flag) {
        if (flag) {
            this.side = "left";
            super("yes");
        } else {
            this.side = "right";
            super("no");
        }
        print("branched {this.name} {this.side}");
    }
}

class Retagged extends Named {
    constructor(string name, this.tag) {
        super(name);
        print("retagged {this.tag}");
    }
}

class Root {
    protected string rooted = note("root default");
}

class Middle extends Root {
    protected string middled = note("middle default");
}

class Implicit extends Middle {
    string own;

    constructor() {
        this.own = note("implicit body");
    }
}

class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

make(bool fail) -> string throws Refusal {
    if (fail) {
        throw new Refusal();
    }
    return "made";
}

build() {
    Item item = new Item(note("item argument"));
    Derived derived = new Derived("d", "x");
    Branched branched = new Branched(false);
    Retagged retagged = new Retagged("r", "t");
    Implicit implicit = new Implicit();
    print("built {implicit.rooted} {implicit.middled} {implicit.own}");
}

abandon() {
    Held kept = new Held("argument");
    Derived abandoned = new Derived(try make(true), kept.name);
    print("never {abandoned.extra}");
} catch (Refusal refusal) {
    print("caught {refusal.message}");
}

main() -> int {
    build();
    abandon();
    return 0;
}
