// @expect-error 'Plant' does not extend 'Animal', so a value of type 'Animal' is never a 'Plant', and this 'is' test is always false.
// @expect-error build failed with 2 problems
class Animal {
    protected constructor();
}

class Plant {
    constructor();
}

main() -> int {
    Animal a = new Animal();
    if (a is Plant) { return 1; }
    bool never = a is Plant;
    return never ? 1 : 0;
}
