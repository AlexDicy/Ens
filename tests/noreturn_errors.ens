// @expect-error build failed with 18 problems
// Error cases for the `noreturn` modifier: a `return` statement, a body that can fall off the
// end, a return-type clause, `noreturn` on a constructor and on a destructor, an override that
// drops `noreturn`, and a safe call to a `noreturn` method, which does not end a path, so a null
// guard around it leaves the value nullable after it. A call that never returns, or a '?:' whose
// branches all never return, is refused where nothing states the type it would take.

noreturn usesReturn() {
    return;
}

noreturn fallsOffEnd() {
    print("this can complete normally");
}

noreturn withReturnType() -> int {
    panic("x");
}

class Widget {
    noreturn constructor() {
        panic("x");
    }

    noreturn destructor() {
        panic("x");
    }
}

abstract class Base {
    abstract noreturn boom();
}

class Derived extends Base {
    override boom() {
        panic("dropped the noreturn contract");
    }
}

// A safe call runs nothing when the object is null, so it does not end the path.
viaSafeCall(Base? base) -> int {
    base?.boom();
}

// For the same reason, 'text' is still nullable after the guard.
viaSafeCallGuard(string? text, Base? base) -> long {
    if (text == null) {
        base?.boom();
    }
    return text.length;
}

noreturn halt() {
    panic("halted");
}

