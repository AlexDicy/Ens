noreturn usesReturn() {
    return;
}

noreturn fallsOffEnd() {
    print("this can complete normally");
}

noreturn withReturnType() -> int {
    panic("x");
}

class Widget {
    noreturn constructor() {
        panic("x");
    }

    noreturn destructor() {
        panic("x");
    }
}

abstract class Base {
    abstract noreturn boom();
}

class Derived extends Base {
    override boom() {
        panic("dropped the noreturn contract");
    }
}

// A safe call runs nothing when the object is null, so it does not end the path.
viaSafeCall(Base? base) -> int {
    base?.boom();
}

// For the same reason, 'text' is still nullable after the guard.
viaSafeCallGuard(string? text, Base? base) -> long {
    if (text == null) {
        base?.boom();
    }
    return text.length;
}

noreturn halt() {
    panic("halted");
}

show(int value) {
}

show(string value) {
}

pick(int first, int second) {
}

pick(int first, string second) {
}

counted() -> int {
    return 1;
}

nothing() {
}

untyped(bool flag, int[] numbers) {
    int sum = 1 + halt();
    long hashed = halt().hash();
    string text = "{halt()}";
    let values = [halt(), 2];
    show(halt());
    pick(counted(), halt());
    int indexed = numbers[halt()];
    int picked = flag ? nothing() : halt();
    int both = 1 + (flag ? halt() : panic("other"));
}

stoppedValue() {
    return halt();
}
