untyped(bool flag, int[] numbers) {
    int sum = 1 + halt();
    long hashed = halt().hash();
    string text = "{halt()}";
    let values = [halt(), 2];
    show(halt());
    pick(counted(), halt());
    int indexed = numbers[halt()];
    int picked = flag ? nothing() : halt();
    int both = 1 + (flag ? halt() : panic("other"));
}

stoppedValue() {
