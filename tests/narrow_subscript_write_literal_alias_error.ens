// @expect-error Cannot read a member of 'Box?'
// Writing 'xs[0]' drops the identifier-index narrowing of 'xs[i]': i could be 0.
class Box {
    int v;
    constructor(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(1), new Box(2)];
    int i = 0;
    if (xs[i] != null) {
        xs[0] = null;
        return xs[i].v;
    }
    return 0;
}
