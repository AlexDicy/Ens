// @exit 0
// @stdout sum=6
// @stdout picked=2
// @stdout valued=3
// @stdout total=6
// @stdout loops=4
// Definite assignment accepts a local that is assigned on every path before it is read, whether
// the paths come from an if, from every arm of a switch statement or of a switch used as a value,
// or from a loop whose variable is assigned before the use after a break. A loop whose condition
// always holds, written as 'while (true)', 'while ((true))', 'for (;;)' or 'for (; true; )', ends
// only at a break.
main() -> int {
    // Declare, then assign, then read.
    int x;
    x = 5;

    // Assigned on both branches of an if.
    int both;
    if (x > 0) {
        both = 1;
    } else {
        both = 2;
    }
    print("sum={x + both}");

    // Assigned in every arm of an exhaustive switch.
    int picked;
    switch (x) {
        5 -> {
            picked = 2;
        }
        default -> {
            picked = 0;
        }
    }
    print("picked={picked}");

    // Assigned in every arm of a switch used as a value.
    int valued;
    bool positive = switch (x) {
        5 -> (valued = 3) > 0,
        default -> (valued = 4) > 0,
    };
    print("valued={valued}");

    // Assigned before every break reaches the loop's normal exit.
    int total;
    long i = 0;
    while (true) {
        total = x + 1;
        i = i + 1;
        if (i > 0) {
            break;
        }
    }
    print("total={total}");

    int first;
    while ((true)) {
        first = 1;
        break;
    }
    int second;
    for (;;) {
        second = 1;
        break;
    }
    int third;
    for (; true; ) {
        third = 1;
        break;
    }
    print("loops={first + second + third + 1}");

    return 0;
}
