// @exit 0
// Whole-file helpers in std.system: text and binary round trips, growth past the
// internal chunk size, empty files, overwriting, the exists check, and the
// missing-file error.
import @std.system;
import SystemError from @std.system;

main() -> int throws {
    const textPath = "build/tests/std_system_files_text.tmp";
    const bytesPath = "build/tests/std_system_files_bytes.tmp";

    // Text round trip, including an escaped newline.
    try system.writeAllText(textPath, "first line\nsecond line");
    string text = try system.readAllText(textPath);
    if (text != "first line\nsecond line") { return 10; }

    // Overwriting replaces the previous content.
    try system.writeAllText(textPath, "replaced");
    if (try system.readAllText(textPath) != "replaced") { return 11; }

    // Binary round trip: NUL, high bytes, CR, LF, and Ctrl-Z survive because the
    // helpers open files in binary mode.
    byte[] data = [0, 255, 13, 10, 26, 'x'];
    try system.writeAllBytes(bytesPath, data);
    byte[] readBack = try system.readAllBytes(bytesPath);
    if (readBack.length != data.length) { return 12; }
    for (long i = 0; i < data.length; i = i + 1) {
        if (readBack[i] != data[i]) { return 13; }
    }

    // Content larger than the 4096-byte chunk exercises the grow loop.
    byte[] big = new byte[10000];
    for (long i = 0; i < big.length; i = i + 1) {
        big[i] = (i % 251) as byte;
    }
    try system.writeAllBytes(bytesPath, big);
    byte[] bigBack = try system.readAllBytes(bytesPath);
    if (bigBack.length != big.length) { return 14; }
    for (long i = 0; i < big.length; i = i + 1) {
        if (bigBack[i] != big[i]) { return 15; }
    }

    // An empty write produces an empty read.
    byte[] empty = [];
    try system.writeAllBytes(bytesPath, empty);
    if ((try system.readAllBytes(bytesPath)).length != 0) { return 16; }
    try system.writeAllText(textPath, "");
    if (try system.readAllText(textPath) != "") { return 17; }

    // exists reports a readable file as true; a missing path or a directory reports false.
    if (!system.exists(textPath)) {
        return 20;
    }
    if (system.exists("build/tests/std_system_files_missing.tmp")) {
        return 21;
    }
    if (system.exists("build/tests")) {
        return 22;
    }

    return readMissingIsCaught();
}

// Reading a nonexistent file must raise a SystemError naming the path.
readMissingIsCaught() -> int {
    byte[] bytes = try system.readAllBytes("build/tests/std_system_files_missing.tmp");
    return 18;
} catch (SystemError e) {
    if (!e.message.contains("std_system_files_missing.tmp")) { return 19; }
    return 0;
}
