// @exit 0
// @stdout Submit Reload 0 ok missing other 2 -1 0 2 done
enum Command {
    Initialize,
    Reload,
    Submit,
    Exit,
}

code(Command c) -> int {
    // exhaustive enum switch expression, no default; multi-label arm
    return switch (c) {
        Initialize -> 17,
        Reload -> 18,
        Submit, Exit -> 0,
    };
}

describe(int n) -> string {
    return switch (n) {
        200 -> "ok",
        404 -> "missing",
        default -> "other",
    };
}

len(string? s) -> int {
    return switch (s) {
        "hi" -> 2,
        null -> -1,
        default -> 0,
    };
}

main() -> int {
    const Command a = Command.Submit;
    const Command b = Command.Reload;

    let ok = 0;
    if (a == Command.Submit && a != b) { ok = ok + 1; }

    // statement switch with a block arm and a default arm
    let viaStmt = 0;
    switch (b) {
        Reload -> { viaStmt = code(b); },
        default -> { viaStmt = -1; },
    }
    if (viaStmt == 18) { ok = ok + 1; }

    let ca = code(a);            // 0
    let d200 = describe(200);    // ok
    let d404 = describe(404);    // missing
    let d500 = describe(500);    // other
    let lhi = len("hi");         // 2
    let lnull = len(null);       // -1
    let lyo = len("yo");         // 0

    // enum interpolation prints the member name
    print("{a} {b} {ca} {d200} {d404} {d500} {lhi} {lnull} {lyo} {ok} done");
    return ok - 2;
}