// @exit 15
// A derived object's synthetic destructor must release both its inherited (base) and its
// own class-typed fields. Weak watchers observe whether each referenced Node is freed when
// the owning Derived is dropped. An inherited weak field initialized through super(...) must
// still watch rather than own, so the node it watches dies with the last strong reference.
class Node {
    int v;
    protected constructor(this.v = 0);
}

class Base {
    Node? baseRef;
    protected constructor(this.baseRef = null);
}

class Derived extends Base {
    Node? ownRef;
    protected constructor(Node? b, Node? o) {
        super(b);            // initializes the inherited baseRef
        this.ownRef = o;
    }
}

class Watcher {
    protected weak Node? wb;
    protected weak Node? wo;
    protected constructor();
}

class Observer {
    protected weak Node? seen;
    protected constructor(this.seen);
}

class DerivedObserver extends Observer {
    protected constructor(Node? n) {
        super(n);            // initializes the inherited weak field
    }
}

main() -> int {
    let watch = new Watcher();
    let nb = new Node();
    let no = new Node();
    watch.wb = nb;
    watch.wo = no;

    let d = new Derived(nb, no);   // d now strongly holds both nodes
    nb = new Node();               // drop our original strong refs; d keeps them alive
    no = new Node();

    d = new Derived(null, null);   // drop the old Derived -> its dtor runs

    int result = 0;
    if (watch.wb == null) { result = result + 1; }   // inherited field was released
    if (watch.wo == null) { result = result + 2; }   // own field was released

    let watched = new Node();
    let observer = new DerivedObserver(watched);
    if (observer.seen != null) { result = result + 4; }   // the weak field reads the live node
    watched = new Node();                                 // drop the only strong reference
    if (observer.seen == null) { result = result + 8; }    // watching kept nothing alive
    return result;
}