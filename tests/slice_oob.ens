// @exit 134
// @stderr-contains panic: tried to take the slice 3..1 of an array of length 4. Check that the start is at least 0 and at most the end, and that the end is at most length
// A slice whose start is past its end aborts, and the panic quotes the range back. Its advice
// covers all three ways a range breaks, since one guard reports them all.
main() -> int {
    int[] xs = new int[4];
    int[] ys = xs.slice(3, 1);
    return ys.length as int;
}
