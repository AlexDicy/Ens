// @expect-error A function type's 'throws' list needs the function type in parentheses: write '(() -> void throws Boom)'.
// @expect-error Write '((int) -> int throws Boom)' to have the returned function raise those types, or '((int) -> int) throws Boom' to have the declaration itself raise them.
// @expect-error A function type marked 'throws' must list its exception types
// @expect-error A declared throws type must be 'Error' or a subclass; 'Speaker' is not
// @expect-error overlaps with another type in the list
// @expect-error which its target function type does not list
// @expect-error its target function type declares no 'throws' list
// @expect-error can throw 'Boom'; prefix it with 'try'
// @expect-error 'callWithoutTry' can throw 'Boom' but is not marked 'throws'
// @expect-error 'try' is not needed here
// @expect-error A default value cannot call
// @expect-error A field default cannot call
// @expect-error build failed with 12 problems
// The rules a function type's throws list answers to: it needs its parentheses, it needs a list,
// the list holds distinct Error subclasses, a lambda is held to its target's list, and a call
// through the value is held to the same 'try' rules a call to a declaration is.
class Boom extends Error {
    protected constructor(string message) { super(message); }
}

class Other extends Error {
    protected constructor(string message) { super(message); }
}

interface Speaker {
    speak() -> string;
}

raise() throws Boom {
    throw new Boom("bang");
}

raiseOther() throws Other {
    throw new Other("other");
}

missingParentheses(() -> void throws Boom body) {
    print("refused");
}

// In a return position the same mistake has two plausible meanings, so the error names both
// spellings instead of only the function-type one.
ambiguousReturn() -> (int) -> int throws Boom {
    return (value) -> value;
}

noList((() -> void throws) body) {
    print("refused");
}

notAnError((() -> void throws Speaker) body) {
    print("refused");
}

overlapping((() -> void throws Boom, Error) body) {
    print("refused");
}

takesThrowing((() -> void throws Boom) body) throws Boom {
    try body();
}

takesPlain(() -> void body) {
    body();
}

callWithoutTry((() -> void throws Boom) body) {
    body();
}

tryWithoutThrows(() -> void body) {
    try body();
}

// A default value has nowhere to put a 'try', so a call through a throwing function value is
// refused there as any other throwing call is. Both places a default can be written are checked.
makeProducer() -> (() -> int throws Boom) {
    return () -> { try raise(); return 1; };
}

defaultCallsThrough(int value = makeProducer()()) {
    print("{value}");
}

class FieldDefault {
    int value = makeProducer()();

    protected constructor();
}

main() -> int {
    // The body raises a type the target does not list.
    try takesThrowing(() -> { try raiseOther(); });
    // The target lists nothing at all.
    takesPlain(() -> { try raise(); });
    return 0;
} catch (Boom e) {
    return 1;
}
