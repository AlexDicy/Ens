// @exit 0
// @stdout branch=hi
// @stdout param=Ada
// @stdout mixed=cli made
// @stdout counted=Ada 3
// @stdout short Ada
// @stdout counted=Ada 0
// @stdout labeled=base unnamed
// @stdout kept pre
// @stdout prefixed=pre 0
// @stdout selective Ada
// @stdout selected=Ada 0
// @stdout chained assigned
// @stdout chained=assigned
// @stdout chained=fallback
// @stdout announced Ada
// @stdout announce announced
// @stdout later announced
// @stdout recounted kept
// @stdout kind special
// @stdout kind plain
// Definite assignment credits a non-defaultable 'this' field that is assigned on every path
// through a constructor: balanced across the branches of an if/else, supplied by a 'this.field'
// parameter, and a mix of a parameter-initialized field with a body-initialized field.
// A catch clause that catches what 'super(...)' can throw ends with 'panic', while one that
// catches only what is thrown after the base class is constructed may finish the constructor. A
// field the body assigns before every call that can throw keeps its value in a catch clause, and so
// does a base class field in a clause that only catches what is thrown after 'super(...)'. A clause
// may read a field that is missing only where the body throws what another clause catches, and
// each call of a chain counts as a place the body can throw from, so a field assigned in the
// arguments of a later call of the chain has no value when an earlier one throws. Once every
// field has a value, 'this' may be used in any way, in the body and in a catch clause. Before then
// a switch may test its type with 'is' arms, and a field read through it may be passed to an
// overloaded function.
class Balanced {
    protected string value;
    protected constructor(bool useHigh) {
        if (useHigh) {
            this.value = "hi";
        } else {
            this.value = "lo";
        }
    }
}

class Named {
    protected string name;
    protected constructor(this.name);
}

class Mixed {
    protected string tag;
    protected string body;
    protected constructor(this.tag) {
        this.body = "made";
    }
}

class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

class Shortage extends Error {
    constructor() {
        super("short");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

checkedCount(int value) -> int throws Shortage {
    if (value < 0) {
        throw new Shortage();
    }
    return value;
}

class Counted extends Named {
    protected int count;

    protected constructor(string text, int value) {
        super(try checkedName(text));
        this.count = try checkedCount(value);
    } catch (Refusal refusal) {
        panic("a name is required");
    } catch (Shortage shortage) {
        print("short {this.name}");
        this.count = 0;
    }
}

class Prefixed {
    protected string label;
    protected int count;

    protected constructor(int value) {
        this.label = "pre";
        this.count = try checkedCount(value);
    } catch (Shortage shortage) {
        print("kept {this.label}");
    }
}

class Defaulted {
    protected string origin;

    protected constructor() {
        this.origin = "base";
    }
}

class Labeled extends Defaulted {
    protected string label;

    protected constructor(string text) {
        this.label = try checkedName(text);
    } catch (Refusal refusal) {
        this.label = "unnamed";
    }
}

class Selective {
    protected string label;
    protected int count;

    protected constructor(string text, int value) {
        this.label = try checkedName(text);
        this.count = try checkedCount(value);
    } catch (Refusal refusal) {
        panic("a label is required");
    } catch (Shortage shortage) {
        print("selective {this.label}");
        this.count = 0;
    }
}

class Source {
    protected constructor() {
    }

    protected use(string text) -> string throws Refusal {
        return try checkedName(text);
    }
}

makeSource(string text) -> Source throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return new Source();
}

class Chained {
    protected string label;

    protected constructor(string text) {
        string used = try makeSource(text).use(this.label = "assigned");
        print("chained {used}");
    } catch (Refusal refusal) {
        this.label = "fallback";
    }
}

class Announced extends Named {
    protected string label;

    protected constructor(string text) {
        this.label = "announced";
        super(text);
        print(this.render());
        announce(this);
        () -> void later = () -> {
            print("later {this.label}");
        };
        later();
    }

    protected render() -> string {
        return "{this.label} {this.name}";
    }
}

announce(Announced announced) {
    print("announce {announced.label}");
}

class Recounted {
    protected string label;
    protected int count;

    protected constructor(int value) {
        this.label = "kept";
        this.count = try checkedCount(value);
    } catch (Shortage shortage) {
        print(this.render());
        this.count = 0;
    }

    protected render() -> string {
        return "recounted {this.label}";
    }
}

class Kinded {
    protected string kind;
    protected string label;

    protected constructor() {
        this.kind = switch (this) {
            is Special -> "special",
            default -> "plain",
        };
        print(spelled(this.kind));
        this.label = "kinded";
    }
}

final class Special extends Kinded {
}

spelled(string text) -> string {
    return "kind {text}";
}

spelled(int number) -> string {
    return "number {number}";
}

main() -> int {
    Balanced b = new Balanced(true);
    print("branch={b.value}");
    Named n = new Named("Ada");
    print("param={n.name}");
    Mixed m = new Mixed("cli");
    print("mixed={m.tag} {m.body}");
    Counted counted = new Counted("Ada", 3);
    print("counted={counted.name} {counted.count}");
    Counted fallback = new Counted("Ada", -1);
    print("counted={fallback.name} {fallback.count}");
    Labeled labeled = new Labeled("");
    print("labeled={labeled.origin} {labeled.label}");
    Prefixed prefixed = new Prefixed(-1);
    print("prefixed={prefixed.label} {prefixed.count}");
    Selective selective = new Selective("Ada", -1);
    print("selected={selective.label} {selective.count}");
    Chained chained = new Chained("Ada");
    print("chained={chained.label}");
    Chained unchained = new Chained("");
    print("chained={unchained.label}");
    Announced announced = new Announced("Ada");
    Recounted recounted = new Recounted(-1);
    Kinded special = new Special();
    Kinded plain = new Kinded();
    return 0;
}
