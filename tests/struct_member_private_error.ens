// @expect-error 'id' is private to struct 'Key' and can only be used inside 'Key'. Mark it 'public' to use it here.
// A member-visibility diagnostic names the owner by its real declaration keyword, so a
// struct's private member is reported as belonging to a struct, not to a class.
struct Key {
    private int id;
}

main() -> int {
    Key key = {id: 1};
    print("{key.id}");
    return 0;
}
