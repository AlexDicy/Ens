// @expect-error Type parameter 'T' already has the class bound 'Animal'; at most one bound can be a class, every other bound must be an interface
class Animal {
    Animal();
}

class Robot {
    Robot();
}

class Pen<T: Animal + Robot> {
    private T occupant;
    Pen(this.occupant);
}

main() -> int {
    return 0;
}
