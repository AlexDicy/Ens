// @expect-error Type parameter 'T' already has the class bound 'Animal'; at most one bound can be a class. Keep one class bound and make the rest interfaces.
class Animal {
    constructor();
}

class Robot {
    constructor();
}

class Pen<T: Animal + Robot> {
    T occupant;
    constructor(this.occupant);
}

main() -> int {
    return 0;
}
