import List from @std.collections.list;

nothingAtAll() { }

public shared final class Reader {
    public constructor();
}

public class Refused {
    public weak lazy const Reader? cached = new Reader();
    public lazy const void nothing = nothingAtAll();
    public lazy const long mistyped = "text";
    public lazy const long first = Refused.second + 1;
    public lazy const long second = Refused.first + 1;
    public lazy const long reused = 4;
    public lazy const List<string> names = List.of(["a"]);
    public long shadowed = 2;
    public lazy const long shadowed = 3;

    public static reused() -> long {
        return 5;
    }
}

public class Box<T> {
    public lazy const T shared = 0;
}

main() -> int {
    Refused.first++;
    let called = Refused.first();
    let instance = new Refused();
    let throughInstance = instance.first;
    return 0;
}
