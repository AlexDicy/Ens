// @expect-error A 'lazy const' field already belongs to the type itself, so it cannot also be 'static': a static const holds a compile-time constant, while a lazy const builds its value on the first read. Remove 'static'.
// @expect-error A 'lazy' field must also be 'const'; its value is built once on the first read and never changes. Write 'lazy const long unmarked = ...', or make 'unmarked' an instance field.
// @expect-error Lazy const 'missing' needs its value on the declaration, because nothing else ever assigns it: write 'lazy const long missing = ...'.
// @expect-error A lazy const field cannot be 'weak': the program keeps its value to the end, so nothing ever releases it. Remove 'weak'.
// @expect-error Lazy const 'nothing' cannot have type 'void'; 'void' means no value, so there is nothing to keep. Give 'nothing' the type of the value its initializer builds.
// @expect-error The initializer of lazy const 'Refused.throwing' cannot call 'risky' because it can throw 'Boom'; it must not throw.
// @expect-error The initializer of lazy const 'Refused.mistyped': expected 'long', got 'string'
// @expect-error 'Refused.second' cannot take its value from 'Refused.first' here: the chain of lazy consts between them closes a cycle. Break the cycle by building one of the two values without reading the other.
// @expect-error Lazy const 'shared' cannot have type 'T': a lazy const belongs to the type itself, which every instantiation shares, so its type cannot use a type parameter.
// @expect-error 'reused' is already declared as a lazy const of 'Refused'; a field and a method cannot share a name.
// @expect-error The initializer of static const 'Refused.folded' must be a compile-time constant, but 'Refused.first' is a lazy const, whose value is built on its first read at run time. A constant is built from literals, '+', '-', '*', '/', '%', string concatenation, and other static consts read through their type name.
// @expect-error Cannot assign to 'Refused.first': a lazy const takes its one value from its initializer and never changes. Change the initializer, or use an instance field.
// @expect-error The '++' operator cannot change 'Refused.first': a lazy const takes its one value from its initializer and never changes.
// @expect-error 'Refused.first' is a lazy const, not a method, so it cannot be called. Remove the parentheses.
// @expect-error Use 'Refused.first'; a lazy const belongs to the type, not to an instance.
// @expect-error build failed with 15 problems
// Every 'lazy const' rule in one place: the modifiers it refuses, the mandatory initializer, the
// types it cannot hold, the initializer that may not throw or close a cycle, and the reads and
// writes that are not allowed to reach one.
public class Boom extends Error {
    public constructor(string message) {
        super(message);
    }
}

risky() -> long throws {
    throw new Boom("no");
}

nothingAtAll() { }

public class Reader {
    public constructor();
}

public class Refused {
    public static lazy const long both = 1;
    public lazy long unmarked = 2;
    public lazy const long missing;
    public weak lazy const Reader? cached = new Reader();
    public lazy const void nothing = nothingAtAll();
    public lazy const long throwing = risky();
    public lazy const long mistyped = "text";
    public lazy const long first = Refused.second + 1;
    public lazy const long second = Refused.first + 1;
    public lazy const long reused = 4;
    public static const long folded = Refused.first + 1;

    public static reused() -> long {
        return 5;
    }
}

public class Box<T> {
    public lazy const T shared = 0;
}

main() -> int {
    Refused.first = 3;
    Refused.first++;
    let called = Refused.first();
    let instance = new Refused();
    let throughInstance = instance.first;
    return 0;
}
