// @exit 7
// Calls on unrelated objects don't drop the narrowing.
class Door {
    int code;
    Door(this.code = 0);
}

class Room {
    Door? door;
    Room(this.door = null);
}

private noopInt(int x) -> int {
    return x;
}

main() -> int {
    let r = new Room(new Door(7));
    let r2 = new Room(new Door(99));

    if (r.door != null) {
        // Call that takes a primitive - r unaffected.
        let n = noopInt(1);

        // Call on an unrelated class root r2 - leaves r alone.
        if (r2.door != null) {
            r2.door.code;
        }

        // r.door narrowing should STILL be in effect here.
        return r.door.code;  // 7
    }
    return 0;
}