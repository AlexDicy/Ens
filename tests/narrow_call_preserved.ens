// @exit 7
// @stdout sum=6
// @stdout after-calls 5
// @stdout chain-keep 7 3
// A call drops nothing a stable place proved. No callee can reassign the caller's binding, so a
// local's own narrowing survives a call that takes it as the receiver or as an argument, and no
// callee can write a 'const' field, so a narrowing on a chain of them survives a call that
// reaches its root as an argument, as a receiver, or through a constructor.
import List from @std.collections.list;

class Door {
    protected int code;
    protected constructor(this.code = 0);

    protected open() {
    }
}

class Room {
    protected const Door? door;
    protected int tag;
    protected constructor(this.door = null, this.tag = 0);
}

class Wrapper {
    protected constructor(Room room) {
    }
}

noopInt(int x) -> int {
    return x;
}

touch(Room room) {
}

// The collection-loop pattern: the length() receiver call must not drop the
// narrowing that get() relies on.
sum(List<long>? xs) -> long {
    if (xs != null) {
        long total = 0;
        for (long i = 0; i < xs.length(); i = i + 1) {
            total = total + xs.get(i);
        }
        return total;
    }
    return -1;
}

// The root passed as an argument, the chain as a receiver, and the root handed to a constructor
// all leave 'room.door' narrowed.
afterCalls(Room room) -> int {
    if (room.door != null) {
        touch(room);
        room.door.open();
        let wrapper = new Wrapper(room);
        return room.door.code;
    }
    return -1;
}

// A call whose receiver is the chain 'r.door' keeps both 'r' and 'r.door' narrowed.
chainKeep(Room? r) -> int {
    if (r != null && r.door != null) {
        r.door.open();
        return r.tag + r.door.code;
    }
    return -1;
}

main() -> int {
    let numbers = new List<long>();
    numbers.push(1);
    numbers.push(2);
    numbers.push(3);
    print("sum={sum(numbers)}");
    print("after-calls {afterCalls(new Room(new Door(5)))}");
    print("chain-keep {chainKeep(new Room(new Door(3), 4))} {chainKeep(new Room(new Door(1), 2))}");

    let r = new Room(new Door(7));
    let r2 = new Room(new Door(99));

    Door? d = new Door(7);
    if (r.door != null) {
        // Call that takes a primitive - r unaffected.
        let n = noopInt(1);

        // Call on an unrelated class root r2 - leaves r alone.
        if (r2.door != null) {
            r2.door.code;
        }

        if (d != null) {
            // d as the receiver - the local binding's narrowing survives.
            d.open();
            return d.code;  // 7
        }

        // r.door narrowing should STILL be in effect here.
        return r.door.code;
    }
    return 0;
}
