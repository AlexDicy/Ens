// @exit 7
// @stdout sum=6
// Calls on unrelated objects don't drop a narrowing, and a method call with
// the narrowed local itself as the receiver keeps the binding's narrowing:
// no callee can reassign the caller's binding.
import Vector from @std.vector;

class Door {
    int code;
    Door(this.code = 0);

    open() {
    }
}

class Room {
    Door? door;
    Room(this.door = null);
}

private noopInt(int x) -> int {
    return x;
}

// The collection-loop pattern: the length() receiver call must not drop the
// narrowing that get() relies on.
private sum(Vector<long>? xs) -> long {
    if (xs != null) {
        long total = 0;
        for (long i = 0; i < xs.length(); i = i + 1) {
            total = total + xs.get(i);
        }
        return total;
    }
    return -1;
}

main() -> int {
    let numbers = new Vector<long>();
    numbers.push(1);
    numbers.push(2);
    numbers.push(3);
    print("sum={sum(numbers)}");

    let r = new Room(new Door(7));
    let r2 = new Room(new Door(99));

    Door? d = new Door(7);
    if (r.door != null) {
        // Call that takes a primitive - r unaffected.
        let n = noopInt(1);

        // Call on an unrelated class root r2 - leaves r alone.
        if (r2.door != null) {
            r2.door.code;
        }

        if (d != null) {
            // d as the receiver - the local binding's narrowing survives.
            d.open();
            return d.code;  // 7
        }

        // r.door narrowing should STILL be in effect here.
        return r.door.code;
    }
    return 0;
}
