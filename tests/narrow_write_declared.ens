// @exit 42
// Writes through a narrowed path check against the declared type and drop
// the narrowing from that point on.
class Door {
    int code;
    constructor(this.code = 0);
}

class Room {
    Door? door;
    constructor(this.door = null);
}

class Shape {
    constructor();
}

class Circle extends Shape {
    int radius;
    constructor(this.radius = 0);
}

class Canvas {
    Shape shape;
    constructor(this.shape);
}

class Meter {
    int? level;
    constructor(this.level = null);
}

main() -> int {
    int score = 0;

    // 1. Null out a just-checked nullable field.
    let r = new Room(new Door(7));
    if (r.door != null) {
        score = score + r.door.code;    // +7
        r.door = null;
    }
    if (r.door == null) {
        score = score + 1;              // +1 -> 8
    }

    // 2. Assign a base value over an is-narrowed field.
    let c = new Canvas(new Circle(5));
    if (c.shape is Circle) {
        score = score + c.shape.radius; // +5 -> 13
        c.shape = new Shape();
    }

    // 3. Write, re-check, then read again.
    let m = new Meter(3);
    if (m.level != null) {
        m.level = 9;
        if (m.level != null) {
            score = score + m.level;    // +9 -> 22
        }
    }

    // 4. Subscript writes: literal and identifier index.
    Door?[] doors = [new Door(4), new Door(6)];
    if (doors[0] != null) {
        doors[0] = null;
    }
    if (doors[0] == null) {
        score = score + 2;              // +2 -> 24
    }
    int i = 1;
    if (doors[i] != null) {
        score = score + doors[i].code;  // +6 -> 30
        doors[i] = null;
    }
    if (doors[i] == null) {
        score = score + 3;              // +3 -> 33
    }

    // 5. Value-type optional local: the write stores a wrapped 'int?'.
    int? n = 4;
    if (n != null) {
        n = 9;
    }
    score = score + (n ?? 0);           // +9 -> 42

    return score;
}
