// @exit 45
// Writes check against the declared type. A write into a mutable field or an element stores
// through a place that never narrows, so the reads after it go through a local copy, while a local
// written a value of its own narrowed type keeps it, whether a plain assignment, a compound
// operator, a '++' or a '--' wrote it.
class Door {
    protected int code;
    protected constructor(this.code = 0);
}

class Room {
    protected Door? door;
    protected constructor(this.door = null);
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;
    protected constructor(this.radius = 0);
}

class Canvas {
    protected Shape shape;
    protected constructor(this.shape);
}

class Meter {
    protected int? level;
    protected constructor(this.level = null);
}

main() -> int {
    int score = 0;

    // 1. Null out a nullable field read through a local copy.
    let r = new Room(new Door(7));
    let door = r.door;
    if (door != null) {
        score = score + door.code;      // +7
        r.door = null;
    }
    if (r.door == null) {
        score = score + 1;              // +1 -> 8
    }

    // 2. Assign a base value over a field whose copy was type-tested.
    let c = new Canvas(new Circle(5));
    let shape = c.shape;
    if (shape is Circle) {
        score = score + shape.radius;   // +5 -> 13
        c.shape = new Shape();
    }

    // 3. Write, then read the field again through a fresh copy.
    let m = new Meter(3);
    m.level = 9;
    let level = m.level;
    if (level != null) {
        score = score + level;          // +9 -> 22
    }

    // 4. Subscript writes: literal and identifier index.
    Door?[] doors = [new Door(4), new Door(6)];
    doors[0] = null;
    if (doors[0] == null) {
        score = score + 2;              // +2 -> 24
    }
    int i = 1;
    let atI = doors[i];
    if (atI != null) {
        score = score + atI.code;       // +6 -> 30
        doors[i] = null;
    }
    if (doors[i] == null) {
        score = score + 3;              // +3 -> 33
    }

    // 5. Value-type optional local: the write stores a wrapped 'int?'.
    int? n = 4;
    if (n != null) {
        n = 9;
    }
    score = score + (n ?? 0);           // +9 -> 42

    // 6. A local written a value stays narrowed, so the reads below need no second check.
    int? steps = 1;
    if (steps != null) {
        steps = 2;
        steps += 1;
        steps++;
        steps--;
        score = score + steps;          // +3 -> 45
    }

    return score;
}
