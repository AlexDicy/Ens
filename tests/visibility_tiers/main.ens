// @exit 38
// Public covers the whole package: the class, its members, the struct (whose
// fields follow it), and the free function all resolve from this module, and a
// protected member of a public class is reachable from a subclass declared here.
import Rectangle from lib.shapes;
import Shape from lib.shapes;
import lib.shapes;

class Triangle extends Shape {
    protected constructor() {
        super(3);
    }

    protected sideCount() -> long {
        return this.sides;
    }
}

main() -> int {
    let rectangle = new Rectangle(5, 6);
    shapes.Point start = {x: 1, y: 2};
    let moved = shapes.offset(start, 1);
    let triangle = new Triangle();
    return (rectangle.area() + moved.x + moved.y + triangle.sideCount()) as int;
}
