public class Rectangle {
    long width;
    long height;

    public constructor(this.width, this.height);

    public area() -> long {
        return this.width * this.height;
    }
}

public class Shape {
    protected long sides;

    public constructor(this.sides = 0);
}

public struct Point {
    public long x;
    public long y;
}

public offset(Point point, long amount) -> Point {
    return {x: point.x + amount, y: point.y + amount};
}
