// @expect-error The type after 'as?' cannot be nullable, because 'as? Derived' already produces 'Derived?'. Write 'as? Derived'.
class Base {
    protected constructor();
}

class Derived extends Base {
    protected constructor();
}

main() -> int {
    Base b = new Derived();
    let d = b as? Derived?;
    return 0;
}
