// @expect-error Cannot read a member of 'Door?'
// A constructor reaches its arguments exactly as any other call does: passing a
// narrowed object to `new Wrapper(room)` lets the constructor mutate `room.door`,
// so that field's narrowing cannot survive the `new`.
class Door {
    int code;

    protected constructor(this.code = 0);
}

class Room {
    protected Door? door;

    protected constructor(this.door = null);
}

class Wrapper {
    protected constructor(Room r) {
        r.door = null;
    }
}

main() -> int {
    let room = new Room(new Door(5));
    if (room.door != null) {
        let wrapper = new Wrapper(room);  // constructor may null room.door
        return room.door.code;            // error - room.door is back to 'Door?'
    }
    return 0;
}
