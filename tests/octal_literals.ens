// @exit 0
// @stdout 493 511 0 15 8
// An octal literal is a number in base 8 after '0o', with '_' between digits and the same 'L'
// suffix as any other integer literal.
main() -> int {
    int mode = 0o755;
    long wide = 0o7_7_7L;
    print("{mode} {wide} {0o0} {0o17} {0o10}");
    return 0;
}
