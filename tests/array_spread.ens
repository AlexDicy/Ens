// @exit 0
// @stdout 1 2 3
// @stdout numbers read
// @stdout 0 1 2 4 5 6
// @stdout 1 2
// @stdout 3 3
// @stdout 5 y
// @stdout 2
// @stdout p1
// @stdout 3
// @stdout released two
// @stdout released one
// '...' puts the elements of an array into an array literal, in order and read where written:
// several spreads, an empty one, a spread widened to the literal's element type, references and
// structs that the new array holds on its own, and a nullable element type.
class Tracked {
    const string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Point {
    int x = 0;
    string name = "";
}

joined(int[] values) -> string {
    string text = "";
    for (let value in values) {
        text = text.isEmpty() ? "{value}" : text + " {value}";
    }
    return text;
}

numbers() -> int[] {
    print("numbers read");
    return [4, 5];
}

main() -> int {
    int[] a = [1, 2];
    int[] b = [...a, 3];
    print(joined(b));
    print(joined([0, ...a, ...numbers(), 6]));
    int[] none = [];
    print(joined([...none, ...a, ...none]));
    long[] wide = [...a, 3L];
    print("{wide.length} {wide[2]}");
    string[] words = ["x", "y"];
    string[] more = [...words, "z", ...words];
    print("{more.length} {more[4]}");
    Tracked[] kept = [new Tracked("one")];
    Tracked[] copied = [...kept, new Tracked("two")];
    print("{copied.length}");
    Point[] points = [{x: 1, name: "p"}];
    Point[] both = [...points, ...points];
    print("{both[1].name}{both[1].x}");
    int?[] maybe = [...a, null];
    print("{maybe.length}");
    return 0;
}
