// @exit 0
// @stdout ran 1
// @stdout caught bang
// @stdout caught through a field
// @stdout released Payload
// @stdout caught while holding a payload
// @stdout two lists 7
// A function type may carry a throws list, written after the return type with the function type
// in parentheses. The list is part of the type, so the same shape with no list is a different type.
class Boom extends Error {
    protected constructor(string message) { super(message); }
}

class Other extends Error {
    protected constructor(string message) { super(message); }
}

class Payload {
    protected constructor();

    destructor() {
        print("released Payload");
    }
}

raise() throws Boom {
    throw new Boom("bang");
}

// A target with a list, called through with 'try'.
runThrowing((() -> void throws Boom) body) throws Boom {
    try body();
}

// A target with no list is a different type and needs no 'try'.
runPlain(() -> void body) {
    body();
}

// The list travels with the type wherever the type goes, a field included.
class Holder {
    (() -> void throws Boom) work;

    protected constructor(this.work);

    protected run() throws Boom {
        try this.work();
    }
}

// A reference argument crossing an unwinding call: the destructor's line proves it was released
// exactly once.
carry(((Payload) -> void throws Boom) body, Payload payload) throws Boom {
    try body(payload);
}

// Two listed types, and only one of them arrives.
pick(((int) -> int throws Boom, Other) body) -> int throws Boom, Other {
    return try body(7);
}

main() -> int {
    runPlain(() -> { print("ran 1"); });
    demonstrateThrow();
    demonstrateField();
    demonstrateCarry();
    print("two lists {try pick((int value) -> value)}");
    return 0;
} catch (Boom e) {
    print("unexpected {e.message}");
    return 1;
} catch (Other e) {
    print("unexpected {e.message}");
    return 1;
}

demonstrateThrow() {
    try runThrowing(() -> { try raise(); });
} catch (Boom e) {
    print("caught {e.message}");
}

demonstrateField() {
    let holder = new Holder(() -> { try raise(); });
    try holder.run();
} catch (Boom e) {
    print("caught through a field");
}

demonstrateCarry() {
    try carry((Payload held) -> { try raise(); }, new Payload());
} catch (Boom e) {
    print("caught while holding a payload");
}
