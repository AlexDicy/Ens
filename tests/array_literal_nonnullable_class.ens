// @exit 42
// `Box[]` (non-nullable elements) is a constructible type when materialised
// from a literal: every slot is initialized at construction, so the
// element-nullability rule that blocks `new Box[3]` does not apply.

class Box {
    protected int v;
    protected constructor(this.v = 0);
}

makeBoxes() -> Box[] {
    return [new Box(10), new Box(15), new Box(17)];
}

sumBoxes(Box[] bs) -> int {
    int total = 0;
    int i = 0;
    while (i < bs.length as int) {
        total = total + bs[i].v;
        i = i + 1;
    }
    return total;
}

main() -> int {
    let bs = makeBoxes();
    if (bs.length != 3L) { return 1; }
    return sumBoxes(bs);
}
