// @exit 134
// @stderr-contains panic: tried to skip a directory of the walk under 'nowhere', but its last next() returned no entry. Call skip() right after next() returns the directory to leave out
// A skip before the walk has returned anything names no directory, and nothing is read for it.
import Path from @std.fs;

main() -> int {
    let walker = Path("nowhere").walker();
    walker.skip();
    return 0;
}
