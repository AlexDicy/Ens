// @expect-error 'describe<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function value has no text form. Pass a name you keep beside the function, or a type argument whose values have one.
// @expect-error 'describe<string??>' cannot interpolate a value of type 'string??' because it may be null at more than one level. Pass a type argument nullable at one level at most, such as 'string?'.
// @expect-note 'describe<T>' interpolates a value of type 'T' here
// @expect-error Cannot interpolate a value of type '((int) -> int)?': a function value has no text form. Interpolate what the function returns, or a name you keep beside it.
// @expect-error Cannot interpolate a value of type 'Holder?': struct 'Holder' has no text form. Field 'shape' has type 'Shape', which has no text form
// @expect-error build failed with 4 problems
// A generic that interpolates its type parameter is rejected when an instance takes a type with
// no text form, judged per instantiation like the struct '==' rule. A refusal names the type the
// hole holds, so a nullable hole is named at the level it was written, and one earned by a type
// argument is reported at the call that supplied it with the hole as a note.
class Point {
    int x;
    protected constructor(this.x);
}

class Shape {
    protected constructor();
}

struct Holder {
    protected Shape shape;
}

describe<T>(T value) -> string {
    return "value is {value}";
}

nullableFunction(((int) -> int)? step) -> string {
    return "step {step}";
}

nullableHolder(Holder? holder) -> string {
    return "holder {holder}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    print(describe([1, 2]));
    string? once = "text";
    print(describe<string?>(once));
    string?? twice = once;
    print(describe<string??>(twice));
    (int) -> int doubler = (v) -> v * 2;
    print(describe(doubler));
    return 0;
}
