// @expect-error Cannot interpolate a value of type 'Point'
// A class instantiation of a generic that interpolates its type parameter is
// rejected when the instance is emitted, mirroring the struct '==' rule.
class Point {
    int x;
    Point(this.x);
}

describe<T>(T value) -> string {
    return "value is {value}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    return 0;
}
