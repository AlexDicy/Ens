// @expect-error 'describe<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function value has no text form. Pass a name you keep beside the function, or a type argument that has a text form.
// @expect-error 'describe<string??>' cannot interpolate a value of type 'string??', because it may be null at more than one level. Pass a type argument nullable at one level at most, such as 'string?'.
// @expect-note 'describe<T>' interpolates a value of type 'T' here
// @expect-error Cannot interpolate a value of type '((int) -> int)?': a function value has no text form. Interpolate what the function returns, or a name you keep beside it.
// @expect-error Cannot interpolate a value of type 'Holder?': struct 'Holder' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'shape' has the class type 'Shape', and a class value has no JSON form. Give 'Holder' an 'override toString() -> string', or remove field 'shape'.
// @expect-error 'describeAll<Labeled>' cannot interpolate a value of type 'Labeled[]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Labeled' declares its own 'toString'. Field 'shape' of 'Labeled' has the class type 'Shape', and a class value has no JSON form. Pass a type argument that has a JSON form, or remove field 'shape' from 'Labeled'.
// @expect-note 'describeAll<T>' interpolates a value of type 'T[]' here
// @expect-error 'render<(int) -> int>' cannot call 'toString' on a value of type '(int) -> int': a function value has no text form. Pass a name you keep beside the function, or a type argument that has a text form.
// @expect-note 'render<T>' calls 'toString' on a value of type 'T' here
// @expect-error 'renderAll<Labeled>' cannot call 'toString' on a value of type 'Labeled[]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Labeled' declares its own 'toString'. Field 'shape' of 'Labeled' has the class type 'Shape', and a class value has no JSON form. Pass a type argument that has a JSON form, or remove field 'shape' from 'Labeled'.
// @expect-note 'renderAll<T>' calls 'toString' on a value of type 'T[]' here
// @expect-error Struct 'Tagged' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'shape' has the class type 'Shape', and a class value has no JSON form. Give 'Tagged' an 'override toString() -> string', or remove field 'shape'.
// @expect-error 'Paired<Shape>' cannot interpolate a value of type 'Paired<Shape>': struct 'Paired' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'first' has the class type 'Shape', and a class value has no JSON form. Give 'Paired' an 'override toString() -> string', or pass a type argument that has a JSON form.
// @expect-note 'Paired<T>' interpolates a value of type 'Paired<T>' here
// @expect-error 'Paired<Shape>' cannot call 'toString' on a value of type 'Paired<Shape>': struct 'Paired' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'first' has the class type 'Shape', and a class value has no JSON form. Give 'Paired' an 'override toString() -> string', or pass a type argument that has a JSON form.
// @expect-note 'Paired<T>' calls 'toString' on a value of type 'Paired<T>' here
// @expect-error build failed with 11 problems
// A generic that interpolates its type parameter is rejected when an instance takes a type with
// no text form, judged per instantiation like the struct '==' rule. A refusal names the type the
// hole holds, so a nullable hole is named at the level it was written, and one earned by a type
// argument is reported at the call that supplied it with the hole as a note.
// A hole whose type has no text form for any type argument is refused once, in the generic body.
// 'this' in a generic struct's method is judged per instantiation the same way.
class Point {
    int x;
    protected constructor(this.x);
}

class Shape {
    protected constructor();
}

struct Holder {
    protected Shape shape;
}

struct Tagged<T> {
    protected Shape shape;
    protected T tag;
}

struct Paired<T> {
    protected T first;

    protected describe() -> string {
        return "pair {this} {this.toString()}";
    }
}

struct Labeled {
    protected Shape shape;

    protected override toString() -> string {
        return "labeled";
    }
}

describe<T>(T value) -> string {
    return "value is {value}";
}

describeAll<T>(T[] values) -> string {
    return "values are {values}";
}

render<T>(T value) -> string {
    return value.toString();
}

renderAll<T>(T[] values) -> string {
    return values.toString();
}

describeTagged<T>(Tagged<T> tagged) -> string {
    return "tagged {tagged} {tagged.toString()}";
}

nullableFunction(((int) -> int)? step) -> string {
    return "step {step}";
}

nullableHolder(Holder? holder) -> string {
    return "holder {holder}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    print(describe([1, 2]));
    string? once = "text";
    print(describe<string?>(once));
    string?? twice = once;
    print(describe<string??>(twice));
    (int) -> int doubler = (v) -> v * 2;
    print(describe(doubler));
    Labeled[] labeled = [{shape: new Shape()}];
    print(describeAll(labeled));
    print(render(doubler));
    print(renderAll(labeled));
    Tagged<int> tagged = {shape: new Shape(), tag: 1};
    print(describeTagged(tagged));
    print(describeTagged<string>({shape: new Shape(), tag: "x"}));
    Paired<Shape> paired = {first: new Shape()};
    print(paired.describe());
    return 0;
}
