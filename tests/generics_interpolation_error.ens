// @expect-error In 'describe<(int) -> int>': Cannot interpolate a value of type '(int) -> int': a function value has no text form
// @expect-error In 'describe<string??>': Cannot interpolate a value of type 'string??' because it may be null at more than one level
// @expect-error Cannot interpolate a value of type '((int) -> int)?': a function value has no text form. Interpolate what the function returns, or a name you keep beside it.
// @expect-error Cannot interpolate a value of type 'Holder?': struct 'Holder' has no text form. Field 'shape' has type 'Shape', which has no string form
// @expect-error build failed with 4 problems
// A generic that interpolates its type parameter is rejected when an instance takes a type with
// no text form, judged per instantiation like the struct '==' rule. A class or array
// instantiation is accepted, and so is one nullable level; a function value and a second
// nullable level stay refused. A refusal names the type the hole holds, so a nullable hole is
// named at the level it was written and the reason comes from what that level wraps.
class Point {
    int x;
    protected constructor(this.x);
}

class Shape {
    protected constructor();
}

struct Holder {
    protected Shape shape;
}

describe<T>(T value) -> string {
    return "value is {value}";
}

nullableFunction(((int) -> int)? step) -> string {
    return "step {step}";
}

nullableHolder(Holder? holder) -> string {
    return "holder {holder}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    print(describe([1, 2]));
    string? once = "text";
    print(describe<string?>(once));
    string?? twice = once;
    print(describe<string??>(twice));
    (int) -> int doubler = (v) -> v * 2;
    print(describe(doubler));
    return 0;
}
