// @expect-error Cannot interpolate a value of type 'int[]'
// A generic that interpolates its type parameter is rejected when an instance takes a type with
// no text form, judged per instantiation like the struct '==' rule. A class instantiation is
// accepted now that class values render from their runtime type.
class Point {
    int x;
    protected constructor(this.x);
}

describe<T>(T value) -> string {
    return "value is {value}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    print(describe([1, 2]));
    return 0;
}
