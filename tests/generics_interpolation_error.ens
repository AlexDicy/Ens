// @expect-error Cannot interpolate a value of type '(int) -> int'
// @expect-error In 'describe<string??>': Cannot interpolate a value of type 'string??' because it may be null at more than one level
// @expect-error build failed with 2 problems
// A generic that interpolates its type parameter is rejected when an instance takes a type with
// no text form, judged per instantiation like the struct '==' rule. A class or array
// instantiation is accepted, and so is one nullable level; a function value and a second
// nullable level stay refused.
class Point {
    int x;
    protected constructor(this.x);
}

describe<T>(T value) -> string {
    return "value is {value}";
}

main() -> int {
    let p = new Point(1);
    print(describe(p));
    print(describe([1, 2]));
    string? once = "text";
    print(describe<string?>(once));
    string?? twice = once;
    print(describe<string??>(twice));
    (int) -> int doubler = (v) -> v * 2;
    print(describe(doubler));
    return 0;
}
