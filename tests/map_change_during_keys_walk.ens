// @exit 134
// @stdout walked 1
// @stderr-contains panic: map changed during a walk: finish the walk before changing it, or use removeWhere
// A keys view walks the live map, so a set inside the walk aborts on the next step.
import Map from @std.collections.map;

main() -> int {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.set("bob", 41);
    long walked = 0;
    for (let key in ages.keys()) {
        walked = walked + 1;
        print("walked {walked}");
        ages.set(key + "!", 1);
    }
    return 0;
}
