// @exit 134
// @stderr-contains panic: tried to read the last key of an empty sorted map. Check isEmpty() first
// The other end of the rule sortedmap_first_key_empty pins.
import SortedMap from @std.collections.sortedmap;

main() -> int {
    let empty = new SortedMap<int, string>((a, b) -> a - b);
    return empty.lastKey();
}
