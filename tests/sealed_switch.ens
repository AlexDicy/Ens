// @exit 42
// Sealed class hierarchies and `is` type arms in switch: exhaustive switches
// over a sealed abstract root (statement and expression forms, with and
// without bindings), a subclass arm covering its descendants, a concrete
// sealed root behind `default`, a nullable scrutinee with a `null` arm, an
// open hierarchy requiring `default`, and ARC balance for an owned scrutinee.
sealed abstract class Expr {
    constructor();
}

class Num extends Expr {
    int value;
    constructor(this.value) { super(); }
}

class Neg extends Expr {
    Expr inner;
    constructor(this.inner) { super(); }
}

class SharpNeg extends Neg {
    constructor(Expr inner) { super(inner); }
}

class Add extends Expr {
    Expr left;
    Expr right;
    constructor(this.left, this.right) { super(); }
}

// Exhaustive expression switch: no default, every direct subclass has an arm,
// and the `is Neg` arm also matches the deeper SharpNeg.
eval(Expr e) -> int {
    return switch (e) {
        is Num n -> n.value,
        is Neg n -> 0 - eval(n.inner),
        is Add a -> eval(a.left) + eval(a.right),
    };
}

// Exhaustive statement switch with the bindings omitted.
kindOf(Expr e) -> string {
    let kind = "";
    switch (e) {
        is Add -> { kind = "add"; },
        is Neg -> { kind = "neg"; },
        is Num -> { kind = "num"; },
    }
    return kind;
}

// A concrete sealed root: a value may be a plain Token, so subclass arms
// alone cannot be exhaustive and `default` handles the root itself.
sealed class Token {
    constructor();
}

class WordToken extends Token {
    constructor() { super(); }
}

tokenScore(Token t) -> int {
    return switch (t) {
        is WordToken -> 2,
        default -> 1,
    };
}

// A nullable scrutinee: the `null` arm plus arms for every direct subclass
// keep the switch exhaustive without a default.
describeMaybe(Expr? e) -> int {
    return switch (e) {
        null -> -1,
        is Num n -> n.value,
        is Neg -> -2,
        is Add -> -3,
    };
}

// An open (unsealed) hierarchy always needs a default arm.
class Animal { constructor(); }
class Dog extends Animal { constructor() { super(); } }
class Cat extends Animal { constructor() { super(); } }

sound(Animal a) -> string {
    return switch (a) {
        is Dog -> "woof",
        is Cat -> "meow",
        default -> "...",
    };
}

class Watcher {
    weak Expr? seen;
    constructor();
}

make(Watcher w) -> Expr {
    let n = new Num(7);
    w.seen = n;
    return n;
}

// The owned scrutinee stays alive while the matched arm borrows it through
// the binding, and is released when the enclosing block ends.
arcCase() -> int {
    let w = new Watcher();
    int got = 0;
    {
        switch (make(w)) {
            is Num n -> { if (w.seen != null) { got = n.value; } },
            is Neg -> { got = -1; },
            is Add -> { got = -2; },
        }
    }
    if (w.seen != null) { return -100; }
    return got;
}

main() -> int {
    let e = new Add(new Num(20), new Neg(new SharpNeg(new Num(5))));
    int total = eval(e);                            // 20 - (-5) = 25
    if (kindOf(e) == "add") { total = total + 1; }  // 26
    total = total + tokenScore(new WordToken());    // 28
    total = total + tokenScore(new Token());        // 29
    Expr? maybe = null;
    total = total + describeMaybe(maybe) + 2;       // 30
    maybe = new Num(3);
    total = total + describeMaybe(maybe);           // 33
    let s = sound(new Dog()) + sound(new Cat());
    if (s == "woofmeow") { total = total + 2; }     // 35
    return total + arcCase();                       // 42
}
