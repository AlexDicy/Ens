// @expect-error '~' flips the bits of an integer, but 'scale' has type 'double'. Write '~(scale as long)' to flip the bits of its whole number part.
// Bits belong to integers. A floating-point value has no bit pattern to flip in the language's
// terms, so the operand is refused by the type the program actually wrote.
main() -> int {
    double scale = 2.5;
    let flipped = ~scale;
    return flipped as int;
}
