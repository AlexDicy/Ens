// @expect-error A 'lazy' field must also be 'const'; its value is built once on the first read and never changes. Write 'lazy const int loose = ...', or remove 'lazy' to make 'loose' a field that can change.
// @expect-error A lazy const field cannot be 'weak': its value is kept as long as the object. Remove 'weak'.
// @expect-error Lazy const 'missing' needs its value on the declaration, because nothing else ever assigns it. Write 'lazy const int missing = ...'.
// @expect-error The initializer of lazy const 'risky' of 'Holder' calls 'fail', which can throw 'Fault'. A lazy const is read without 'try', so its initializer must not throw. Move the call into a function that catches 'Fault' with a 'catch' clause, and call that function here.
// @expect-error Lazy const 'wrong' of 'Holder' has type 'string', but its initializer has type 'int'.
// @expect-error Lazy const 'second' of 'Holder' cannot take its value from 'this.first': the lazy consts between them form a cycle. Build one of the two without reading the other.
// @expect-error Lazy const 'this.doubled' is read before field 'count' of class 'Holder' has a value, and the first read runs its initializer, which may read 'count'. Assign 'count' before this line, for example 'this.count = ...;'.
// @expect-error Cannot assign to lazy const 'doubled': a lazy const keeps the value its initializer gives it on the first read. Change the initializer, or remove 'lazy' and the initializer and assign 'doubled' in a constructor.
// @expect-error A struct cannot declare a lazy const for each value, because every copy of the value would build it again. Write 'static' before 'lazy' for one value shared by the whole type, or make 'Point' a class.
// @expect-error 'this' is the object a method was called on, and the initializer of a static lazy const runs once for the whole type, on no object. Remove 'static' to give each object its own 'total'.
// @expect-error build failed with 11 problems
// A lazy const of each object refuses the modifiers and uses a static one does, throws nothing,
// is never assigned, and is read in a constructor only once every field has a value; a struct
// declares none, and a static one that needs an object is told to drop 'static'.
class Fault extends Error {
    constructor() {
        super("fault");
    }
}

class Holder {
    const int count;
    lazy const int doubled = this.count * 2;
    lazy int loose = 1;
    weak lazy const Holder? other = null;
    lazy const int missing;
    lazy const int risky = this.fail();
    lazy const string wrong = 3;
    lazy const int first = this.second + 1;
    lazy const int second = this.first + 1;

    constructor(int count) {
        print("{this.doubled}");
        this.count = count;
        this.doubled = 4;
    }

    fail() -> int throws Fault {
        throw new Fault();
    }
}

struct Point {
    int x = 0;
    lazy const int twice = 2;
}

class Totals {
    static lazy const int total = this.size();

    size() -> int {
        return 1;
    }
}

main() -> int {
    let holder = new Holder(1);
    holder.doubled = 3;
    return 0;
}
