// @expect-error Method 'doubled' of 'Counter' is marked 'override', and a struct inherits nothing to override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a struct. Remove 'override'.
// @expect-error build failed with 1 problem
// Structs have no base type, so the only struct methods that override anything are the
// ones replacing a behavior the language provides. Marking an ordinary method 'override'
// claims a base method that cannot exist.

public struct Counter {
    public int value;

    public override doubled() -> int {
        return this.value * 2;
    }
}

main() -> int {
    Counter counter = {value: 2};
    print("{counter.doubled()}");
    return 0;
}
