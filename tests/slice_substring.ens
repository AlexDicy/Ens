// @exit 0
// @stdout ints=20,30
// @stdout boxes=2,3
// @stdout points=3
// @stdout retain ok
// Happy paths for array slice(start, end), which is half-open. Slicing retains class elements, so
// they outlive the source array.
class Box {
    protected int v;
    protected constructor(this.v);
}

class Probe {
    protected weak Box? target;
    protected constructor();
}

struct Point {
    protected int x;
    protected int y;
}

main() -> int {
    int[] xs = [10, 20, 30, 40];
    int[] mid = xs.slice(1, 3);
    print("ints=" + mid[0] + "," + mid[1]);

    let boxes = [new Box(1), new Box(2), new Box(3)];
    let probe = new Probe();
    probe.target = boxes[1];
    Box[] pair = boxes.slice(1, 3);
    print("boxes=" + pair[0].v + "," + pair[1].v);

    Point[] points = new Point[3];
    points[1].x = 3;
    points[1].y = 4;
    let cut = points.slice(1, 2);
    print("points=" + cut[0].x);

    boxes = [new Box(9)];
    bool aliveWhileSliced = probe.target != null;
    pair = [new Box(8)];
    if (aliveWhileSliced && probe.target == null) {
        print("retain ok");
    }
    return 0;
}
