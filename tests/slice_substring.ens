// @exit 0
// @stdout sub=ell
// @stdout empty=0
// @stdout full=hello
// @stdout compose=world
// @stdout ints=20,30
// @stdout boxes=2,3
// @stdout points=3
// @stdout retain ok
// Happy paths for the range builtins: string.substring(start, end) and array
// slice(start, end), both half-open. Covers empty and full ranges, a range
// found via indexOf, primitive/class/struct element arrays, and that slicing
// retains class elements so they outlive the source array.
class Box {
    int v;
    Box(this.v);
}

class Probe {
    weak Box? target;
    Probe();
}

struct Point {
    int x;
    int y;
}

main() -> int {
    let s = "hello";
    print("sub=" + s.substring(1, 4));
    print("empty=" + s.substring(2, 2).length);
    print("full=" + s.substring(0, s.length));

    let text = "hello world";
    let at = text.indexOf("world");
    print("compose=" + text.substring(at, text.length));

    int[] xs = [10, 20, 30, 40];
    int[] mid = xs.slice(1, 3);
    print("ints=" + mid[0] + "," + mid[1]);

    let boxes = [new Box(1), new Box(2), new Box(3)];
    let probe = new Probe();
    probe.target = boxes[1];
    Box[] pair = boxes.slice(1, 3);
    print("boxes=" + pair[0].v + "," + pair[1].v);

    Point[] points = new Point[3];
    points[1].x = 3;
    points[1].y = 4;
    let cut = points.slice(1, 2);
    print("points=" + cut[0].x);

    boxes = [new Box(9)];
    bool aliveWhileSliced = probe.target != null;
    pair = [new Box(8)];
    if (aliveWhileSliced && probe.target == null) {
        print("retain ok");
    }
    return 0;
}
