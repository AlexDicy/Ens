// @exit 0
// @stdout still running with first
// @stdout result 2
// @stdout still running with listed
// @stdout listed 3
// @stdout still running with captured
// @stdout captured 4
// @stdout still here as receiver
// @stdout receiver 5
// @stdout still here as argument
// @stdout argument 6
// @stdout picked chosen
// @stdout picked 7
// @stdout still here as const
// @stdout const 8
// A call that overwrites the storage it was reached through keeps running over what it was handed:
// a closure read out of a field or an array element, a closure a lambda captured, an object a
// method is called on, an argument, the value a type switch binds, and a 'const' field of an
// object read out of a field.
class Holder {
    protected (int) -> int step;
    protected ((int) -> int)[] steps;

    protected constructor(this.step, this.steps);

    protected run(int value) -> int {
        return this.step(value);
    }

    protected runListed(int value) -> int {
        return this.steps[0](value);
    }
}

class Slot {
    protected Holder? holder;

    protected constructor() {
        this.holder = null;
    }
}

// A closure that replaces both of its holder's closures, then reads its own capture.
makeStep(Slot slot, string name) -> (int) -> int {
    return (int value) -> {
        Holder? current = slot.holder;
        if (current != null) {
            current.step = (int other) -> other;
            current.steps = [(int other) -> other];
        }
        print("still running with {name}");
        return value + 1;
    };
}

class Child {
    protected string name;

    protected constructor(this.name);

    protected replace(Owner owner) -> int {
        owner.held = new Child("replacement");
        print("still here as {this.name}");
        return 5;
    }
}

class Owner {
    protected Child held;
    protected Shape shape;

    protected constructor(this.held, this.shape);

    protected run() -> int {
        return this.held.replace(this);
    }

    protected pick() -> int {
        switch (this.shape) {
            is Circle circle -> {
                this.shape = new Shape();
                print("picked {circle.name}");
                return 7;
            },
            default -> {
                return 0;
            },
        }
    }
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected string name;

    protected constructor(this.name);
}

class Keeper {
    protected Wrapper current;

    protected constructor(this.current);

    protected runPayload() -> int {
        return this.current.payload.run(this);
    }
}

class Wrapper {
    protected const Payload payload;

    protected constructor(this.payload);
}

class Payload {
    protected string name;

    protected constructor(this.name);

    protected run(Keeper keeper) -> int {
        keeper.current = new Wrapper(new Payload("replacement"));
        print("still here as {this.name}");
        return 8;
    }
}

handOver(Owner owner, Child given) -> int {
    owner.held = new Child("replacement");
    print("still here as {given.name}");
    return 6;
}

main() -> int {
    let slot = new Slot();
    let holder = new Holder(makeStep(slot, "fi" + "rst"), []);
    slot.holder = holder;
    print("result {holder.run(1)}");
    let listedSlot = new Slot();
    let listed = new Holder((int value) -> value, [makeStep(listedSlot, "list" + "ed")]);
    listedSlot.holder = listed;
    print("listed {listed.runListed(2)}");
    let capturedSlot = new Slot();
    let captured = new Holder(makeStep(capturedSlot, "capt" + "ured"), []);
    capturedSlot.holder = captured;
    (int) -> int outer = callsThrough(captured);
    print("captured {outer(3)}");
    let owner = new Owner(new Child("rece" + "iver"), new Circle("cho" + "sen"));
    print("receiver {owner.run()}");
    owner.held = new Child("argu" + "ment");
    print("argument {handOver(owner, owner.held)}");
    print("picked {owner.pick()}");
    let keeper = new Keeper(new Wrapper(new Payload("con" + "st")));
    print("const {keeper.runPayload()}");
    return 0;
}

// A lambda that captured the closure the holder had when it was made, and calls it.
callsThrough(Holder holder) -> (int) -> int {
    (int) -> int step = holder.step;
    return (int value) -> step(value);
}
