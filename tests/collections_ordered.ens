// @exit 0
// @stdout deque-pop 2
// @stdout deque-clear 0
// @stdout deque-wrap 5
// @stdout deque-wrap-clear 0
// @stdout queue-pop 2
// @stdout queue-clear 0
// @stdout queue-grow 100
// @stdout queue-grow-clear 0
// @stdout map-remove 2
// @stdout map-overwrite 2
// @stdout map-remove-where 1
// @stdout map-clear 0
// @stdout map-grow 100
// @stdout map-grow-clear 0
// @stdout key-remove 2
// @stdout key-clear 0
// @stdout view-alive 3
// @stdout view-released 0
// Every way a deque, a priority queue, or a sorted map drops values releases each one exactly
// once, counted by the values' destructors, and a view keeps the sorted map it walks alive.
import Deque from @std.collections.deque;
import Iterable from @std.collections.iterator;
import PriorityQueue from @std.collections.priorityqueue;
import SortedMap from @std.collections.sortedmap;

class Ledger {
    protected long live;

    protected constructor() {
        this.live = 0;
    }
}

class Payload implements Comparable<Payload> {
    protected long tag;
    Ledger ledger;

    protected constructor(long tag, Ledger ledger) {
        this.tag = tag;
        this.ledger = ledger;
        ledger.live = ledger.live + 1;
    }

    destructor() {
        this.ledger.live = this.ledger.live - 1;
    }

    protected override compareTo(Payload other) -> int {
        if (this.tag < other.tag) {
            return -1;
        }
        if (this.tag > other.tag) {
            return 1;
        }
        return 0;
    }
}

filledDeque(Ledger ledger, long count) -> Deque<Payload> {
    let deque = new Deque<Payload>();
    for (long i = 0; i < count; i++) {
        deque.pushBack(new Payload(i, ledger));
    }
    return deque;
}

filledQueue(Ledger ledger, long count) -> PriorityQueue<Payload> {
    let queue = new PriorityQueue<Payload>();
    for (long i = 0; i < count; i++) {
        queue.push(new Payload((i * 7) % count, ledger));
    }
    return queue;
}

filledMap(Ledger ledger, long count) -> SortedMap<long, Payload> {
    let map = new SortedMap<long, Payload>((a, b) -> a < b ? -1 : (a > b ? 1 : 0));
    for (long i = 0; i < count; i++) {
        map.set((i * 7) % count, new Payload(i, ledger));
    }
    return map;
}

keysOf(Ledger ledger) -> Iterable<long> {
    let map = filledMap(ledger, 3);
    return map.keys();
}

main() -> int {
    let ledger = new Ledger();

    let deque = filledDeque(ledger, 3);
    deque.popFront();
    print("deque-pop {ledger.live}");
    deque.clear();
    print("deque-clear {ledger.live}");
    let ring = Deque<Payload>.withCapacity(4);
    for (long i = 0; i < 100; i++) {
        ring.pushBack(new Payload(i, ledger));
        if (ring.length() > 5) {
            ring.popFront();
        }
    }
    print("deque-wrap {ledger.live}");
    ring.clear();
    print("deque-wrap-clear {ledger.live}");

    let queue = filledQueue(ledger, 3);
    queue.pop();
    print("queue-pop {ledger.live}");
    queue.clear();
    print("queue-clear {ledger.live}");
    let grownQueue = filledQueue(ledger, 100);
    print("queue-grow {ledger.live}");
    grownQueue.clear();
    print("queue-grow-clear {ledger.live}");

    let map = filledMap(ledger, 3);
    map.remove(1);
    print("map-remove {ledger.live}");
    map.set(0, new Payload(10, ledger));
    print("map-overwrite {ledger.live}");
    map.removeWhere((key, payload) -> key == 2);
    print("map-remove-where {ledger.live}");
    map.clear();
    print("map-clear {ledger.live}");
    let grownMap = filledMap(ledger, 100);
    print("map-grow {ledger.live}");
    grownMap.clear();
    print("map-grow-clear {ledger.live}");

    let byPayload = new SortedMap<Payload, long>();
    byPayload.set(new Payload(2, ledger), 2);
    byPayload.set(new Payload(1, ledger), 1);
    byPayload.set(new Payload(3, ledger), 3);
    byPayload.remove(new Payload(2, ledger));
    print("key-remove {ledger.live}");
    byPayload.clear();
    print("key-clear {ledger.live}");

    if (true) {
        let keys = keysOf(ledger);
        print("view-alive {ledger.live}");
    }
    print("view-released {ledger.live}");
    return 0;
}
