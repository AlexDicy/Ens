// @exit 35
class Box {
    int v;
    constructor(this.v = 0);
}

private slotValue(Box? b) -> int {
    if (b != null) {
        return b.v;
    }
    return 0;
}

main() -> int {
    Box?[] boxes = [new Box(10), null, new Box(20)];
    if (boxes.length != 3L) { return 1; }
    if (boxes[1] != null) { return 2; }

    int sum = slotValue(boxes[0]) + slotValue(boxes[1]) + slotValue(boxes[2]);  // 10 + 0 + 20

    // Replace a slot - exercises the existing class write-barrier.
    boxes[1] = new Box(5);
    sum = sum + slotValue(boxes[1]);  // +5

    return sum;  // 35
}
