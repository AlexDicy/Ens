// @exit 134
// @stderr-contains panic: firstKey of an empty sorted map: check isEmpty() first
// Asking an empty sorted map for its first key aborts in the map's own words.
import SortedMap from @std.collections.sortedmap;

main() -> int {
    let empty = new SortedMap<int, string>((a, b) -> a - b);
    return empty.firstKey();
}
