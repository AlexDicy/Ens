// @expect-error Cannot read a member of 'string?' because it may be null
// The `else if` sees the negation of the preceding condition, so a positive check
// leaves the chained branch knowing the value IS null. Reading a member there must
// stay rejected; only the failed-check side of `value == null` proves non-null.
lookup(bool found) -> string? {
    if (found) {
        return "abc";
    }
    return null;
}

readInChain(bool found) -> long {
    let value = lookup(found);
    if (value != null) {
        return 1;
    } else if (found) {
        return value.length;
    }
    return 0;
}

main() -> int {
    print("{readInChain(true)}");
    return 0;
}
