// @stdlib primitive_stdlib
// The members the standard library declares for a primitive are called like any other member, on
// a literal and on a variable alike, and a conformance the binding declares satisfies a generic
// bound so one body serves every primitive that declares it.
// @stdout empty: true
// @stdout not empty: false
// @stdout size: 5
// @stdout scaled: 15
// @stdout repeated: abab
// @stdout repeated three times: ababab
// @stdout joined: left-right
// @stdout flipped: false
// @stdout largest of text: 5
// @stdout largest of numbers: 40
// @stdout in package: 6
// @exit 0
import Scaled from @std.text.binding;
import @std.text.inpackage;

largest<T: Scaled>(T[] values, long factor) -> long {
    long best = 0;
    for (let value in values) {
        long here = value.scaled(factor);
        if (here > best) {
            best = here;
        }
    }
    return best;
}

main() -> int {
    print("empty: {"".isEmpty()}");
    let text = "hello";
    print("not empty: {text.isEmpty()}");
    print("size: {text.size()}");
    print("scaled: {text.scaled(3L)}");
    print("repeated: {"ab".repeated()}");
    print("repeated three times: {"ab".repeated(3L)}");
    print("joined: {string.joined("left-", "right")}");
    print("flipped: {true.flipped()}");
    string[] words = ["a", "hello", "abc"];
    print("largest of text: {largest<string>(words, 1L)}");
    long[] numbers = [4L, 1L, 2L];
    print("largest of numbers: {largest<long>(numbers, 10L)}");
    print("in package: {inpackage.sizeOf(text)}");
    return 0;
}
