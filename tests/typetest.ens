// @exit 42
// `is` type tests and `as?` checked casts over a small class hierarchy:
// null cases, ?? chaining, flow narrowing (&&, branches, member chains,
// subscripts, loops), generics, and ARC balance around owned temporaries.
class Shape {
    int id;
    Shape(this.id = 0);
}

class Circle extends Shape {
    int radius;
    Circle(int id, this.radius = 0) { super(id); }
    diameter() -> int { return this.radius * 2; }
}

class Dot extends Circle {
    Dot() { super(9, 1); }
}

class Square extends Shape {
    int side;
    Square(int id, this.side = 0) { super(id); }
}

class Canvas {
    Shape shape;
    Canvas(this.shape);
}

class Watcher {
    weak Shape? seen;
    Watcher();
}

make(Watcher watch) -> Shape {
    let c = new Circle(1, 5);
    watch.seen = c;
    return c;
}

isCircle<T>(T value) -> bool {
    return value is Circle;
}

main() -> int {
    Shape s = new Circle(1, 5);
    int score = 0;

    // `is` hits the exact class and every ancestor, and misses siblings.
    if (s is Circle) { score = score + 1; }                       // +1
    if (s is Square) { return 100; }
    Shape deep = new Dot();
    if (deep is Circle && deep is Dot) { score = score + 1; }     // +1

    // A nullable scrutinee: null fails the test, a value passes it, and
    // testing the inner type itself is a combined null-plus-type check.
    Shape? maybe = null;
    if (maybe is Shape) { return 101; }
    maybe = s;
    if (maybe is Shape) { score = score + 1; }                    // +1
    if (maybe is Circle) { score = score + 1; }                   // +1

    // Narrowing through && lets the right side use Circle members.
    if (s is Circle && s.diameter() == 10) { score = score + 1; } // +1

    // Branch narrowing on a member chain.
    let canvas = new Canvas(s);
    if (canvas.shape is Circle) {
        score = score + canvas.shape.radius;                      // +5
    }

    // Branch narrowing on a literal-index subscript.
    Shape[] shapes = [deep, s];
    if (shapes[1] is Circle) {
        score = score + shapes[1].radius;                         // +5
    }

    // Loop-condition narrowing; the reassignment re-tests next iteration.
    Shape cursor = new Circle(2, 3);
    while (cursor is Circle && cursor.radius > 0) {
        score = score + 1;                                        // +3
        cursor = new Circle(2, cursor.radius - 1);
    }

    // `as?` keeps the value on success, and is null on failure or null input.
    Shape? boxed = new Square(3, 7);
    if (boxed as? Circle != null) { return 102; }
    let c = s as? Circle;
    if (c == null) { return 103; }
    Shape? none = null;
    if (none as? Circle != null) { return 104; }

    // ?? chaining over a failed and a successful checked cast.
    score = score + ((s as? Square)?.side ?? 2);                  // +2
    score = score + ((s as? Circle)?.radius ?? 0);                // +5

    // Generics: the test compiles and runs per instantiation.
    if (isCircle(s)) { score = score + 1; }                       // +1
    Shape other = new Square(4, 2);
    if (isCircle(other)) { return 105; }

    // ARC: a failed `as?` releases the owned temporary it consumed...
    let watch = new Watcher();
    if (make(watch) as? Square != null) { return 106; }
    if (watch.seen != null) { return 107; }

    // ...and a successful one hands the ownership through to the binding.
    let kept = make(watch) as? Circle;
    if (kept == null) { return 108; }
    int alive = 0;
    if (watch.seen != null) { alive = alive + 1; }   // kept holds it
    kept = null;
    if (watch.seen == null) { alive = alive + 1; }   // dropping kept freed it
    if (alive != 2) { return 109; }
    score = score + 1;                                            // +1

    return score + 15;
}
