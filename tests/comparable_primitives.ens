// @exit 0
// @stdout sorted-map 10 ten 20 twenty 30 thirty
// @stdout queue 1 3 5
// @stdout list 2 4 9
// @stdout chars abc
// @stdout sorted-copy 2 4 9
// @stdout doubles -0 0 1 2 nan
// @stdout queue-doubles 1 3 nan
// @stdout keys negative-zero zero one nan
// A number and a character sort with no comparison given, because the standard library's
// primitive bindings declare 'Comparable'. A sorted map takes a 'long' key, a priority queue
// holds 'int', 'sort' with no argument orders a list of 'int' and a list of 'char', and 'sorted'
// answers an ordered copy.
// A floating-point value sorts in the total order the bindings declare, so a NaN goes last in all
// three containers and negative zero comes before zero.
import List from @std.collections.list;
import PriorityQueue from @std.collections.priorityqueue;
import SortedMap from @std.collections.sortedmap;
import StringBuilder from @std.text.stringbuilder;

main() -> int {
    let byKey = new SortedMap<long, string>();
    byKey.set(30L, "thirty");
    byKey.set(10L, "ten");
    byKey.set(20L, "twenty");
    let walked = new StringBuilder();
    walked.append("sorted-map");
    for (let entry in byKey) {
        walked.append(" {entry.key} {entry.value}");
    }
    print(walked.toString());

    let queue = new PriorityQueue<int>();
    queue.push(5);
    queue.push(1);
    queue.push(3);
    let first = queue.pop();
    let second = queue.pop();
    let third = queue.pop();
    print("queue {first} {second} {third}");

    let values = new List<int>();
    values.push(4);
    values.push(2);
    values.push(9);
    values.sort();
    print("list {values.get(0)} {values.get(1)} {values.get(2)}");

    let letters = new List<char>();
    letters.push('c');
    letters.push('a');
    letters.push('b');
    letters.sort();
    print("chars {letters.get(0)}{letters.get(1)}{letters.get(2)}");

    let unsorted = new List<int>();
    unsorted.push(9);
    unsorted.push(4);
    unsorted.push(2);
    let copy = unsorted.sorted();
    print("sorted-copy {copy.get(0)} {copy.get(1)} {copy.get(2)}");

    double zero = 0.0;
    double notANumber = zero / zero;
    let doubles = new List<double>();
    doubles.push(2.0);
    doubles.push(notANumber);
    doubles.push(-0.0);
    doubles.push(zero);
    doubles.push(1.0);
    doubles.sort();
    let sortedDoubles = new StringBuilder();
    sortedDoubles.append("doubles");
    for (let value in doubles) {
        sortedDoubles.append(" {value}");
    }
    print(sortedDoubles.toString());

    let doubleQueue = new PriorityQueue<double>();
    doubleQueue.push(notANumber);
    doubleQueue.push(3.0);
    doubleQueue.push(1.0);
    let smallest = doubleQueue.pop();
    let middle = doubleQueue.pop();
    let largest = doubleQueue.pop();
    print("queue-doubles {smallest} {middle} {largest}");

    let byNumber = new SortedMap<double, string>();
    byNumber.set(notANumber, "nan");
    byNumber.set(1.0, "one");
    byNumber.set(-0.0, "negative-zero");
    byNumber.set(zero, "zero");
    let keys = new StringBuilder();
    keys.append("keys");
    for (let entry in byNumber) {
        keys.append(" {entry.value}");
    }
    print(keys.toString());
    return 0;
}
