// @exit 134
// @stderr-contains panic: substring range 1..9 is outside a string of 2 bytes
// @stderr-contains at string.substring
// A range past the end of the text aborts, and the message names the range and the text it was
// asked of.
main() -> int {
    let text = "hi";
    return text.substring(1, 9).length as int;
}
