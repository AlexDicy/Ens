// @exit 134
// @stderr-contains panic: tried to take the substring from 1 to 9 of a string of 2 bytes. Check that the start is at least 0 and at most the end, and that the end is at most the string's length
// @stderr-contains at string.substring
// A range past the end of the text aborts, and the message names the range and the text it was
// asked of.
main() -> int {
    let text = "hi";
    return text.substring(1, 9).length as int;
}
