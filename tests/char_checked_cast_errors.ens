// @expect-error Converting 'byte' to 'char' always succeeds, because every 'byte' value is a code point. Write 'as' instead of 'as?'.
// @expect-error 'letter' is already a 'char', so 'as? char' does not change it. Remove 'as? char'.
// @expect-error Cannot convert 'double' to 'char' with 'as?'. Only an integer can be checked against the code points of Unicode.
// @expect-error Cannot convert 'string' to 'char' with 'as?'. Only an integer can be checked against the code points of Unicode.
// @expect-error Cannot use 'as?' on a value of type 'int??', because 'as?' checks for only one level of null. Check 'deep' for null first ('if (deep != null)').
// @expect-error build failed with 5 problems
// 'as? char' is for an integer that may not be a code point, so a 'byte', which always is one,
// converts with 'as', a 'char' needs no conversion, a value that is not an integer has no code point
// to check, and a value with two levels of null is refused first, since 'as?' checks only one.
main() -> int {
    byte small = 65;
    char? fromByte = small as? char;
    char letter = 'a';
    char? same = letter as? char;
    double ratio = 65.0;
    char? fromDouble = ratio as? char;
    string text = "a";
    char? fromText = text as? char;
    int?? deep = null;
    char? fromDeep = deep as? char;
    return 0;
}
