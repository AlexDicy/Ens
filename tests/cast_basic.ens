// @exit 42
main() -> int {
    // Integer widening: int (i32) -> long (i64) via sext.
    int x = 5;
    long y = x as long;
    if (y != 5L) { return 1; }

    // Integer narrowing: long -> byte truncates the low 8 bits. 300 = 0x12C, byte = 0x2C = 44.
    long n = 300L;
    byte b = n as byte;
    if ((b as int) != 44) { return 2; }

    // Same-width sign reinterpret: int -1 -> uint 0xFFFFFFFF.
    int neg = -1;
    uint u = neg as uint;
    if ((u as long) != 4294967295L) { return 3; }

    // Float -> int (truncating toward zero).
    double d = 3.7;
    int t = d as int;
    if (t != 3) { return 4; }

    // Int -> float -> int round-trip via int (sitofp + fptosi).
    int i = 7;
    double dd = i as double;
    int back = dd as int;
    if (back != 7) { return 5; }

    // Same-type cast: no-op.
    int z = (5 + 1) as int;
    if (z != 6) { return 6; }

    // Precedence sanity: `as` binds tighter than `*`.
    // arr.length is long (4L), `2 as long` makes the RHS long, multiply in long space.
    int[] arr = new int[4];
    long product = arr.length * 2 as long;
    if (product != 8L) { return 7; }

    // float <-> double widening / narrowing.
    float f = 1.5f;
    double widened = f as double;
    if ((widened as int) != 1) { return 8; }

    return 42;
}
