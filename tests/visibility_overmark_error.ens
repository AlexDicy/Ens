public class Counter {
    long count;

    export bump() {
        this.count = this.count + 1;
    }
}

class Helper {
    public int value;

    public constructor(int value) {
        this.value = value;
    }
}

main() -> int {
    let helper = new Helper(1);
    return helper.value;
}
