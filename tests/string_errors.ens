// @expect-error build failed with 12 problems
// Numbers and bools convert to text implicitly, but a class has no such form of its own, so '+'
// names the type it could not render rather than guessing one for it, on either side.
// A string that can be null still makes '+' a join.
// The refusal names the null and the check that removes it.
class Shape {
    protected int sides;

    protected constructor(this.sides);
}

joins(string? label, bool flag, int? count, Shape shape) {
    print(label + 1);
    print(1 + label);
    print(label + "x");
    print("x" + label);
    print(label + label);
    print(label + flag);
    label += 1;
    print(count + "x");
    print(label + shape);
    print(shape + label);
}

main() -> int {
    let shape = new Shape(3);
    print("shape: " + shape);
    print(shape + " is a shape");
    joins(null, true, null, shape);
    return 0;
}
