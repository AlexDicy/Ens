// @expect-error Cannot concatenate a value of type 'Shape' onto a string; only string, number, and bool values are supported.
// Numbers and bools convert to text implicitly, but a class has no such form of its own, so '+'
// names the type it could not render rather than guessing one for it.
class Shape {
    protected int sides;

    protected constructor(this.sides);
}

main() -> int {
    let shape = new Shape(3);
    print("shape: " + shape);
    return 0;
}
