// @expect-error Cannot add a string to a value of type 'Shape'. Only a string, a number or a 'bool' can be added to one.
// @expect-error build failed with 2 problems
// A class has no text form of its own, so '+' names the type it could not render, on either side,
// even where the string beside it can be null.
class Shape {
    protected int sides;

    protected constructor(this.sides);
}

joins(string? label, Shape shape) {
    print(label + shape);
    print(shape + label);
}

main() -> int {
    joins(null, new Shape(3));
    return 0;
}
