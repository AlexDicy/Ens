// @expect-error Cannot add a string to a value of type 'Shape'; only a string, a number and a 'bool' can be added.
// @expect-error build failed with 2 problems
// Numbers and bools convert to text implicitly, but a class has no such form of its own, so '+'
// names the type it could not render rather than guessing one for it, on either side.
class Shape {
    protected int sides;

    protected constructor(this.sides);
}

main() -> int {
    let shape = new Shape(3);
    print("shape: " + shape);
    print(shape + " is a shape");
    return 0;
}
