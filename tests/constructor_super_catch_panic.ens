// @exit 134
// @stdout named=Ada
// @stderr-contains panic: a name is required
// When a call in the arguments of 'super(...)' throws, the base class is never constructed, so the
// catch clause that catches it ends with 'panic' and the half-built object is never returned.
class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

class Named {
    protected string name;

    protected constructor(this.name);

    destructor() {
        print("released {this.name}");
    }
}

class Required extends Named {
    protected constructor(string text) {
        super(try checkedName(text));
    } catch (Refusal refusal) {
        panic("a name is required");
    }
}

main() -> int {
    Required named = new Required("Ada");
    print("named={named.name}");
    Required unnamed = new Required("");
    print("unnamed={unnamed.name}");
    return 0;
}
