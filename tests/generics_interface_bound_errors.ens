// @expect-error Variable 'picked' has type 'Named?', but its value has type 'T?'. 'T' can be any type that implements 'Named', including a struct. A value of type 'Named' must be an object of a class, and a struct value is not one. Declare 'picked' as a 'T?', or bound 'T' by a class that implements 'Named', as in '<T: Person>'.
// @expect-error Variable 'named' has type 'Named', but its value has type 'T'. 'T' can be any type that implements 'Ranked', including a struct. A value of type 'Named' must be an object of a class, and a struct value is not one. Declare 'named' as a 'T', or bound 'T' by a class that implements 'Ranked'.
// @expect-error build failed with 2 problems
// A value of a type parameter bounded only by interfaces never converts to one of them, because the
// type argument can be a struct such as 'Tag', and a struct value is never an interface value. The
// refusal names the change that gives the place the type parameter, and a class to bound by where
// one implements the bound.
interface Named {
    name() -> string;
}

interface Ranked extends Named {
    rank() -> int;
}

class Person implements Named {
    string label;

    constructor(this.label);

    override name() -> string {
        return this.label;
    }
}

struct Tag implements Named {
    string label;

    override name() -> string {
        return this.label;
    }
}

optional<T: Named>(T? value) {
    Named? picked = true ? value : null;
}

extended<T: Ranked>(T value) {
    Named named = value;
}

main() {
    Tag tag = {label: "tag"};
    string name = declaredName(tag);
}

declaredName<T: Named>(T value) -> string {
    return value.name();
}
