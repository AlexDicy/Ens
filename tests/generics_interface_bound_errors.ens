// @expect-error Method 'take' returns 'Named', but this value has type 'T'. 'T' can be any type that implements 'Named', including a struct. A value of type 'Named' must be an object of a class, and a struct value is not one. Change the return type of 'take' to 'T', or bound 'T' by a class that implements 'Named', as in '<T: Person>'.
// @expect-error Variable 'named' has type 'Named', but its value has type 'T'. 'T' can be any type that implements 'Ranked', including a struct. A value of type 'Named' must be an object of a class, and a struct value is not one. Declare 'named' as a 'T', or bound 'T' by a class that implements 'Ranked'.
// @expect-error build failed with 20 problems
// A value of a type parameter bounded only by interfaces never converts to one of them, because the
// type argument can be a struct such as 'Tag', and a struct value is never an interface value. Each
// place a value converts says so, with the change that gives the place the type parameter where the
// place can take it, a call on the value where a call is made on the result, and a class to bound by.
interface Named {
    name() -> string;
}

interface Ranked extends Named {
    rank() -> int;
}

class Person implements Named {
    string label;

    constructor(this.label);

    override name() -> string {
        return this.label;
    }
}

struct Tag implements Named {
    string label;

    override name() -> string {
        return this.label;
    }
}

class Holder {
    Named? named;

    constructor(Named named) {
        this.named = named;
    }

    set(Named named) {
        this.named = named;
    }
}

greet(Named named) -> string {
    return named.name();
}

declared<T: Named>(T value) {
    Named named = value;
}

assigned<T: Named>(T value, Named named, Holder holder) {
    named = value;
    holder.named = value;
}

passed<T: Named>(T value, Holder holder) -> string {
    holder.set(value);
    let built = new Holder(value);
    return greet(value);
}

returned<T: Named>(T value) -> Named {
    return value;
}

stored<T: Named>(T value) {
    Named[] all = [value];
}

made<T: Named>(T value) {
    () -> Named make = () -> value;
}

fallback<T: Named>(T value, Named? absent) -> string {
    Named chosen = absent ?? value;
    return (absent ?? value).name();
}

branched<T: Named>(T value, Named other, bool pick) -> string {
    Named chosen = pick ? value : other;
    return (pick ? value : other).name();
}

switched<T: Named>(T value, Named other, int which) -> string {
    return (switch (which) {
        0 -> other,
        default -> value,
    }).name();
}

walked<T: Named>(T[] values) {
    for (Named each in values) {
    }
}

optional<T: Named>(T? value) {
    Named? maybe = value;
    Named? picked = true ? value : null;
}

class Box<T: Named> {
    T item;
    Named? kept;

    constructor(this.item);

    take() -> Named {
        this.kept = this.item;
        return this.item;
    }
}

extended<T: Ranked>(T value) {
    Named named = value;
}

main() {
    Tag tag = {label: "tag"};
    string name = declaredName(tag);
}

declaredName<T: Named>(T value) -> string {
    return value.name();
}
