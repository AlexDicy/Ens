// @exit 0
// @stdout loop guards 94
// Inside a loop, a guard clause that always exits the current iteration or the loop narrows the
// checked value for the rest of the body, exactly as `return`, `throw` and `panic` do outside one.
// Each helper reads a member of the guarded value on a line the guard protects.
class Cell {
    protected int value;

    protected constructor(this.value = 0);
}

class Shape {
    int id;

    protected constructor(this.id = 0);
}

class Circle extends Shape {
    protected int radius;

    protected constructor(int id, this.radius = 0) {
        super(id);
    }
}

// A `continue` guard over a plain local narrows it non-null below the guard.
sumViaContinue(Cell?[] items) -> int {
    int total = 0;
    for (let item in items) {
        if (item == null) {
            continue;
        }
        total = total + item.value;
    }
    return total;
}

// A `break` guard over a plain local narrows it non-null on the lines after it.
sumUntilNull(Cell?[] items) -> int {
    int total = 0;
    for (let item in items) {
        if (item == null) {
            break;
        }
        total = total + item.value;
    }
    return total;
}

// A `continue` guard on a subscript expression.
sumViaSubscript(Cell?[] items) -> int {
    int total = 0;
    for (long i = 0; i < items.length; i++) {
        if (items[i] == null) {
            continue;
        }
        total = total + items[i].value;
    }
    return total;
}

// A `continue` guard narrows a member chain such as `this.held`.
class Accumulator {
    Cell? held;

    protected constructor(this.held);

    protected total(int times) -> int {
        int sum = 0;
        for (int i = 0; i < times; i++) {
            if (this.held == null) {
                continue;
            }
            sum = sum + this.held.value;
        }
        return sum;
    }
}

// When the `else` branch exits with `continue`, the `is` narrowing from the `if`
// survives, so the circle members are readable afterward.
sumRadii(Shape[] shapes) -> int {
    int total = 0;
    for (let shape in shapes) {
        if (shape is Circle) {
        } else {
            continue;
        }
        total = total + shape.radius;
    }
    return total;
}

main() -> int {
    Cell?[] cells = [new Cell(10), null, new Cell(20)];
    Shape[] shapes = [new Circle(1, 7), new Shape(2), new Circle(3, 5)];
    let accumulator = new Accumulator(new Cell(3));

    int total = sumViaContinue(cells)       // 30
        + sumUntilNull(cells)               // 10, stops at the null
        + sumViaSubscript(cells)            // 30
        + accumulator.total(4)              // 12
        + sumRadii(shapes);                 // 12
    print("loop guards " + total);
    return total - 94;
}
