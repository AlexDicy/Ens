// A directory of this fixture's own to work in, under the system's temporary location, with a name
// no other call returns, so two test runners never share one and it is removed when the value dies.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import TemporaryDirectory from @std.fs.temporary;

public folder(string name) -> TemporaryDirectory throws FileSystemError {
    return try TemporaryDirectory.create("process_bridges-" + name);
}

// Two path texts joined as one. The bridges under test read and answer a path as text, so a test
// that builds one stays in text rather than converting at every call.
public joined(string folder, string name) -> string {
    return Path(folder).join(name).toString();
}
