// The command interpreter each platform runs a script through, and the other programs every host
// has. A Windows script goes to cmd.exe after /S /C in one pair of quotes, so it may hold none.
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;
import List from @std.collections.list;
import Request from bridges;
import Started from bridges;
import bridges;

public onWindows() -> bool {
    return environment.platform() == Platform.Windows;
}

// The interpreter a script runs through.
public interpreter() -> string {
    if (onWindows()) {
        return Environment.current().get("ComSpec") ?? "C:/Windows/System32/cmd.exe";
    }
    return "/bin/sh";
}

// Starts the script this platform's interpreter understands.
public start(string posixScript, string windowsScript, Request request) -> Started {
    return startWith(posixScript, [], windowsScript, request);
}

// The same, with `posixExtra` following the script as the interpreter's own further arguments.
public startWith(string posixScript, string[] posixExtra, string windowsScript,
                 Request request) -> Started {
    string program = interpreter();
    if (onWindows()) {
        return bridges.start(program, ["/S", "/C", windowsScript],
            "\"" + program + "\" /S /C \"" + windowsScript + "\"", request);
    }
    let arguments = new List<string>();
    arguments.push("-c");
    arguments.push(posixScript);
    for (let extra in posixExtra) {
        arguments.push(extra);
    }
    return bridges.start(program, arguments.toArray(),
        bridges.commandLineOf(program, arguments.toArray()), request);
}

// A child that reads its input to the end, writes nothing, and exits 0.
public startDrain(Request request) -> Started {
    return start("cat >/dev/null", "set /p a=& exit 0", request);
}

// A child that reads one line, reads on to the end of its input, and only then writes that line.
// cmd's prompt takes everything a pipe holds and keeps the first line of it, so one line is all a
// Windows child can be asked to hand back.
public startEchoingInput(Request request) -> Started {
    return start("read a; cat >/dev/null; echo \"$a\"", "set /p a=& set /p b=& call echo %a%",
        request);
}

// A child that stays for about the seconds given and then exits 0.
public startSleeper(long seconds, Request request) -> Started {
    long pings = seconds + 1;
    return start("sleep {seconds}", "ping -n {pings} 127.0.0.1 >nul", request);
}

// A child that exits with the code at once.
public startExiting(int code, Request request) -> Started {
    return start("exit {code}", "exit {code}", request);
}

// The two lines a flood writes, 64 characters each, one per stream so a line on the wrong stream
// is told apart.
public final class Flood {
    public static const string output = "out-oooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo";
    public static const string errors = "err-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";
}

// A child that writes `lines` lines to each stream in turn and then exits 0.
public startFlooding(long lines, Request request) -> Started {
    return start("i=0; while [ $i -lt {lines} ]; do echo {Flood.output}; echo {Flood.errors} >&2; "
        + "i=$((i+1)); done",
        "for /L %i in (1,1,{lines}) do @(echo {Flood.output}& 1>&2 echo {Flood.errors})",
        request);
}

// A child that writes a line to its output without end, until it is stopped.
public startChattering(Request request) -> Started {
    return start("while :; do echo chatter; done", "for /L %i in (1,0,2) do @echo chatter",
        request);
}

// A child that gives up both its outputs at once and then stays for about the seconds given. cmd
// keeps its own handles until it ends, so on Windows the outputs end with the child.
public startSilentSleeper(long seconds, Request request) -> Started {
    long pings = seconds + 1;
    return start("exec >/dev/null 2>&1; sleep {seconds}",
        "ping -n {pings} 127.0.0.1 >nul 2>&1", request);
}

// A child that exits at once and leaves a grandchild holding its outputs, which writes one line
// after about a second and then ends.
public startLeavingGrandchild(Request request) -> Started {
    return start("(sleep 1; echo late) & exit 0",
        "start /b cmd /c ping -n 2 127.0.0.1 ^>nul ^& echo late", request);
}

// A child that writes how many times its parent has given up the processor of its own accord,
// which Linux keeps in the parent's status file one line above the count of times it was made to.
public startCountingSwitches(Request request) -> Started {
    return start("grep ^voluntary_ctxt_switches /proc/$PPID/status | tr -dc 0-9; echo", "",
        request);
}

// A child that writes how many descriptors or handles its parent holds while it runs. A POSIX
// child reads its parent's descriptor table through /proc where there is one and through lsof
// elsewhere, and a Windows child asks PowerShell for its parent's handle count. Each of them
// reads its input to the end before it counts. Its parent closes that input once the start has
// returned.
public startCountingHeld(Request request) -> Started {
    if (onWindows()) {
        string program = (Environment.current().get("SystemRoot") ?? "C:/Windows")
            + "/System32/WindowsPowerShell/v1.0/powershell.exe";
        string command = "$null = [Console]::In.ReadToEnd(); (Get-Process -Id (Get-CimInstance "
            + "Win32_Process -Filter ('ProcessId=' + $PID)).ParentProcessId).HandleCount";
        return bridges.start(program, ["-NoProfile", "-Command", command],
            "\"" + program + "\" -NoProfile -Command \"" + command + "\"", request);
    }
    return start("read a; if [ -d /proc/$PPID/fd ]; then ls /proc/$PPID/fd | wc -l; "
        + "else lsof -p $PPID | wc -l; fi", "", request);
}
