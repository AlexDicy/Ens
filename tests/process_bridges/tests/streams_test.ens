// What reaches this process from a child's two output streams, what reaches the child through its
// input, and what an inherited stream does, on the host running the suite.
import @std.testing;
import Request from bridges;
import Stream from bridges;
import bridges;
import shell;

// cmd's echo keeps a space written before a redirection, so the redirection comes first.
test "the two streams stay separate" {
    let child = try bridges.running(shell.start("echo out; echo err >&2; exit 3",
        "echo out& 1>&2 echo err& exit 3", Request.reading()));
    let output = child.readAll(Stream.output);
    let errors = child.readAll(Stream.errors);
    try testing.assertEqual(output.error, 0);
    try testing.assertEqual(errors.error, 0);
    try testing.assertEqual(bridges.lines(output.bytes), ["out"]);
    try testing.assertEqual(bridges.lines(errors.bytes), ["err"]);
    let status = child.wait();
    try testing.assertEqual(status.error, 0);
    try testing.assertEqual(status.code, 3);
    try testing.assertEqual(status.signal, 0);
}

// The child writes the line it was given only once its input has ended, so the output proves both
// that the line arrived and that the close was seen.
test "input reaches the child and closing it is the end" {
    let child = try bridges.running(shell.startEchoingInput(Request.piped()));
    try testing.assertEqual(child.writeAll("hello\n".toBytes()), 0);
    try testing.assertEqual(child.closeInput(), 0);
    let output = child.readAll(Stream.output);
    try testing.assertEqual(output.error, 0);
    try testing.assertEqual(bridges.lines(output.bytes), ["hello"]);
    try testing.assertEqual(child.wait().code, 0);
}

test "closing the input twice is silence" {
    let child = try bridges.running(shell.startDrain(Request.piped()));
    try testing.assertEqual(child.closeInput(), 0);
    try testing.assertEqual(child.closeInput(), 0);
    let output = child.readAll(Stream.output);
    try testing.assertEqual(output.error, 0);
    try testing.assertEqual(child.wait().code, 0);
}

// The number is the one the system gives a writer whose reader has gone, one on each platform.
// On POSIX the write would end this process instead, were broken pipes not ignored at startup.
test "writing to a child that has gone says the pipe is closed" {
    let child = try bridges.running(shell.startExiting(0, Request.piped()));
    try testing.assertEqual(child.wait().code, 0);
    let written = child.write("late\n".toBytes());
    try testing.assertNotEqual(written.error, 0);
    int expected = 32;
    if (shell.onWindows()) {
        expected = 232;
    }
    try testing.assertEqual(written.error, expected);
}

// The child writes a word with no line ending onto this process's own output, and the newline
// after it is this process's, so the two arrive as one line. cmd's prompt reports the end of its
// input as a failure, so the script ends with a success of its own.
test "an inherited stream is this process's own" {
    let child = try bridges.running(shell.start("printf inherited",
        "<nul set /p .=inherited& exit 0", Request.inherited()));
    try testing.assertEqual(child.wait().code, 0);
    print("");
}

// The number is the bridge's own answer rather than the system's, so it is pinned by value.
test "a read on an inherited stream is refused" {
    let child = try bridges.running(shell.startExiting(0, Request.inherited()));
    let read = child.read(Stream.output, new byte[8]);
    int expected = 22;
    if (shell.onWindows()) {
        expected = 87;
    }
    try testing.assertEqual(read.error, expected);
    try testing.assertEqual(child.wait().code, 0);
}
