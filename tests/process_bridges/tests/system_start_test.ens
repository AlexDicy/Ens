// What the bridge behind std.system answers when it cannot start a program, on the host running
// the suite.
import @std.testing;
import Path from @std.fs;
import Failure from bridges;
import Part from bridges;
import bridges;
import scratch;
import shell;

test "a system start of a program that is not there names the program" {
    string folder = try scratch.folder("system.missing");
    string program = scratch.joined(folder, "missing-program");
    let attempt = bridges.startSystem(program, [], bridges.commandLineOf(program, []));
    try testing.assertFalse(attempt.started, "a program that is not there was started");
    try testing.assertEqual(bridges.failureOf(attempt.code), Failure.notFound);
    try testing.assertEqual(bridges.partOf(attempt.code), Part.program);
}

test "a system start of a directory names it as a directory" {
    string folder = try scratch.folder("system.folder");
    let attempt = bridges.startSystem(folder, [], bridges.commandLineOf(folder, []));
    try testing.assertFalse(attempt.started, "a directory was started");
    try testing.assertEqual(bridges.failureOf(attempt.code), Failure.permissionDenied);
    try testing.assertEqual(bridges.partOf(attempt.code), Part.directory);
}

// POSIX refuses a file nobody may execute as a permission, and Windows refuses a file that is no
// program image as a file it cannot run. Both name the file as no program.
test "a system start of a data file names it in each platform's own terms" {
    string folder = try scratch.folder("system.data");
    string program = scratch.joined(folder, "data.bin");
    try Path(program).writeBytes("not a program".toBytes());
    let attempt = bridges.startSystem(program, [], bridges.commandLineOf(program, []));
    try testing.assertFalse(attempt.started, "a data file was started");
    long expected = Failure.permissionDenied;
    if (shell.onWindows()) {
        expected = Failure.other;
    }
    try testing.assertEqual(bridges.failureOf(attempt.code), expected);
    try testing.assertEqual(bridges.partOf(attempt.code), Part.notProgram);
}

test "a system start that runs answers no code" {
    string program = shell.interpreter();
    string[] arguments = ["-c", "exit 3"];
    string commandLine = bridges.commandLineOf(program, arguments);
    if (shell.onWindows()) {
        arguments = ["/S", "/C", "exit 3"];
        commandLine = "\"" + program + "\" /S /C \"exit 3\"";
    }
    let attempt = bridges.startSystem(program, arguments, commandLine);
    try testing.assertTrue(attempt.started,
        "the shell did not start, the start answered {attempt.code}");
    try testing.assertEqual(attempt.code, 0);
    try testing.assertEqual(attempt.exitCode, 3L);
}
