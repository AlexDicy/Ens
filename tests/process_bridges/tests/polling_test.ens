// The poll that drains a child's two streams and waits on the child together, on the host running
// the suite.
import Platform from @std.platform;
import @std.environment;
import @std.testing;
import @std.text.parse;
import Ready from bridges;
import Request from bridges;
import Stream from bridges;
import bridges;
import shell;

// The system may end a bounded poll a little before the bound as the clock measures it, so the
// promise that the whole bound passed belongs to the wait that holds the deadline, and the raw poll
// is held only to answering nothing and not overrunning. The child's own outputs may stay open
// after it is stopped where a grandchild inherited them, so the last poll asks about this moment
// alone and only the child's end is pinned.
test "a timed wait reports still running and then returns the status" {
    let child = try bridges.running(shell.startSleeper(5, Request.piped()));
    long before = bridges.monotonicMillis();
    let polled = child.poll(100);
    long polledFor = bridges.monotonicMillis() - before;
    try testing.assertEqual(polled.error, 0);
    try testing.assertEqual(polled.ready, 0);
    try testing.assertTrue(polledFor < 2000, "a poll bounded at 100 milliseconds took {polledFor}");
    before = bridges.monotonicMillis();
    let still = child.waitFor(100);
    long waitedFor = bridges.monotonicMillis() - before;
    try testing.assertTrue(still == null, "the sleeper ended inside 100 milliseconds");
    try testing.assertTrue(waitedFor >= 100 && waitedFor < 2000,
        "a wait bounded at 100 milliseconds took {waitedFor}");
    try testing.assertEqual(child.kill(), 0);
    let status = child.wait();
    try testing.assertEqual(status.error, 0);
    try testing.assertEqual(status.code, 0);
    try testing.assertEqual(status.signal, 9);
    let after = child.poll(0);
    try testing.assertEqual(after.error, 0);
    try testing.assertEqual(after.ready & Ready.ended, Ready.ended);
}

// A child that never stops writing answers every poll at once, so only the clock can hold the wait
// to its bound.
test "a timed wait honors its bound across a chatty child" {
    let child = try bridges.running(shell.startChattering(Request.piped()));
    long before = bridges.monotonicMillis();
    let still = child.waitFor(100);
    long elapsed = bridges.monotonicMillis() - before;
    try testing.assertTrue(still == null, "the chatty child ended");
    try testing.assertTrue(elapsed >= 100 && elapsed < 1000,
        "a wait bounded at 100 milliseconds took {elapsed} across a chatty child");
    try testing.assertEqual(child.kill(), 0);
    let status = child.wait();
    try testing.assertEqual(status.error, 0);
    try testing.assertEqual(status.signal, 9);
}

// Once both streams have ended, only the child is left to wait on, and a poll that kept reporting
// an ended stream would answer at once with the wrong bit.
test "a child that closed its outputs and kept running is still collected by a wait" {
    let child = try bridges.running(shell.startSilentSleeper(1, Request.piped()));
    byte[] buffer = new byte[8192];
    bool outputEnded = false;
    bool errorsEnded = false;
    while (!outputEnded || !errorsEnded) {
        let polled = child.poll(20000);
        try testing.assertEqual(polled.error, 0);
        try testing.assertNotEqual(polled.ready, 0);
        if ((polled.ready & Ready.output) != 0 && !outputEnded) {
            outputEnded = child.read(Stream.output, buffer).count == 0;
        }
        if ((polled.ready & Ready.errors) != 0 && !errorsEnded) {
            errorsEnded = child.read(Stream.errors, buffer).count == 0;
        }
        if ((polled.ready & Ready.ended) != 0) {
            break;
        }
    }
    let last = child.poll(-1);
    try testing.assertEqual(last.error, 0);
    try testing.assertEqual(last.ready, Ready.ended);
    let status = child.wait();
    try testing.assertEqual(status.error, 0);
    try testing.assertEqual(status.code, 0);
}

// A poll that blocks once for its whole bound gives the processor up a handful of times, one that
// turns every 5 milliseconds a couple of hundred, and one that spins thousands. Only Linux keeps
// the count where a child can read it.
test "a quiet child costs the poll few turns" {
    if (environment.platform() != Platform.Linux) {
        return;
    }
    let sleeper = try bridges.running(shell.startSleeper(3, Request.piped()));
    long before = try switchesNow();
    let polled = sleeper.poll(1000);
    long after = try switchesNow();
    long turns = after - before;
    try testing.assertEqual(polled.error, 0);
    try testing.assertEqual(polled.ready, 0);
    try testing.assertTrue(turns < 300,
        "a second of polling a quiet child gave the processor up {turns} times");
    try testing.assertEqual(sleeper.kill(), 0);
    let stopped = sleeper.wait();
    try testing.assertEqual(stopped.error, 0);
}

test "a poll on a collected child returns at once" {
    let child = try bridges.running(shell.startExiting(0, Request.piped()));
    try testing.assertEqual(child.wait().code, 0);
    long before = bridges.monotonicMillis();
    let polled = child.poll(-1);
    long elapsed = bridges.monotonicMillis() - before;
    try testing.assertEqual(polled.error, 0);
    try testing.assertEqual(polled.ready & Ready.ended, Ready.ended);
    try testing.assertTrue(elapsed < 500, "a poll on a collected child took {elapsed}");
}

// Once the child is collected only its streams are left to wait on, so the poll waits for the
// grandchild's line rather than answering at once with an end it has already reported.
test "a poll on a collected child waits on a stream a grandchild still holds" {
    let child = try bridges.running(shell.startLeavingGrandchild(Request.reading()));
    let status = child.wait();
    try testing.assertEqual(status.error, 0);
    try testing.assertEqual(status.code, 0);
    long before = bridges.monotonicMillis();
    let polled = child.poll(-1);
    long waited = bridges.monotonicMillis() - before;
    try testing.assertEqual(polled.error, 0);
    try testing.assertEqual(polled.ready & Ready.ended, Ready.ended);
    try testing.assertEqual(polled.ready & Ready.output, Ready.output);
    try testing.assertTrue(waited >= 300,
        "the poll answered after {waited} milliseconds instead of waiting for the grandchild");
    let output = child.readAll(Stream.output);
    try testing.assertEqual(output.error, 0);
    try testing.assertEqual(bridges.lines(output.bytes), ["late"]);
}

// How many times this process has given up the processor of its own accord, as a child reads it
// from this process's status file.
switchesNow() -> long throws {
    let child = try bridges.running(shell.startCountingSwitches(Request.reading()));
    let output = child.readAll(Stream.output);
    try testing.assertEqual(output.error, 0);
    try testing.assertEqual(child.wait().code, 0);
    string[] printed = bridges.lines(output.bytes);
    try testing.assertEqual(printed.length, 1);
    long? switches = parse.parseLong(printed[0].trim());
    try testing.assertTrue(switches != null,
        "the child answered '{printed[0]}' rather than a count");
    return switches ?? 0;
}
