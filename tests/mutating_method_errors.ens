// @expect-error Cannot use 'bump' as a value, because a function value would change a copy of 'acting'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Call 'acting.bump()' where the change should happen, or make 'Counter' a class.
// @expect-error build failed with 27 problems
// A struct method that changes the struct it is called on must be 'mutating', the marker goes on
// a struct or interface method only, a struct matches an interface's marker both ways, and a
// 'mutating' method is refused on every value whose change would be refused or lost.
interface Bumpable {
    mutating bump();

    read() -> int;
}

interface Readable {
    read() -> int;
}

struct Counter implements Bumpable {
    int value;

    mutating constructor(this.value);

    override mutating bump() {
        this.value += 1;
    }

    override read() -> int {
        return this.value;
    }

    reset() {
        this.value = 0;
        this.value = 1;
    }

    step() {
        this.value++;
    }

    bumpThis() {
        this.bump();
    }

    static mutating make() -> Counter {
        return Counter(0);
    }

    override mutating toString() -> string {
        return "counter";
    }
}

struct Outer {
    Counter inner;

    peekInner() -> int {
        this.inner.bump();
        return this.inner.value;
    }
}

struct Loose implements Bumpable {
    int value;

    override bump() {
        this.value += 1;
    }

    override read() -> int {
        return this.value;
    }
}

struct Eager implements Readable {
    int value;

    override mutating read() -> int {
        return this.value;
    }
}

class Box {
    int size = 0;

    mutating constructor() {
    }

    mutating grow() {
        this.size++;
    }

    mutating destructor() {
    }
}

class Fields {
    mutating int count = 0;
}

mutating struct Shape {
    int sides;
}

mutating loose() {
}

class Settings {
    lazy const Counter counter = Counter(0);
    lazy const Outer outer = {inner: Counter(0)};
}

class Keeper {
    const Counter kept = Counter(0);

    constructor() {
        this.kept.bump();
    }

    bumpKept() {
        this.kept.bump();
    }
}

run(() -> void action) {
    action();
}

fresh() -> Counter {
    return Counter(0);
}

heldBound<T: Bumpable>(T value) {
    const T held = value;
    held.bump();
}

calls(Keeper keeper) {
    const Counter typed = Counter(0);
    typed.bump();
    const untyped = fresh();
    untyped.bump();
    const Outer outer = {inner: Counter(0)};
    outer.inner.bump();
    Settings.counter.bump();
    Settings.outer.inner.bump();
    fresh().bump();
    Counter captured = Counter(0);
    () -> void later = () -> {
        captured.bump();
    };
    later();
    keeper.kept.bump();
    Counter acting = Counter(0);
    run(acting.bump);
    int read = typed.read() + untyped.read();
}

main() -> int {
    calls(new Keeper());
    return 0;
}
