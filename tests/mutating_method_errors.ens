// @expect-error Method 'step' of struct 'Counter' changes the struct it is called on, so it must be marked 'mutating'. Write 'mutating' before 'step'.
// @expect-error Cannot call 'bump' on 'this.kept', because field 'kept' is 'const'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Give 'kept' its whole value in its one assignment, as in 'this.kept = ...;', or remove 'const' from the field if it needs to change.
// @expect-error build failed with 2 problems
// A struct method that changes the struct it is called on must be 'mutating', and a 'mutating'
// method is refused on a value whose change would be refused.
struct Counter {
    int value;

    constructor(this.value);

    mutating bump() {
        this.value += 1;
    }

    step() {
        this.value++;
    }
}

class Keeper {
    const Counter kept = Counter(0);

    constructor() {
        this.kept.bump();
    }
}

main() -> int {
    let keeper = new Keeper();
    return 0;
}
