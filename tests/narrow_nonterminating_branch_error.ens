// @expect-error Cannot read a member of 'Leaf?' because it may be null
// The then-branch does not terminate, so control can fall through with `x` still
// null. The check must not narrow `x` on the code after the `if`.
class Leaf {
    int field;
    Leaf(this.field = 1);
}

readField(Leaf? x) -> int {
    if (x == null) { print("maybe null"); }
    return x.field;
}

main() -> int {
    return readField(new Leaf());
}
