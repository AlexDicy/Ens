// @exit 0
// @stdout f0
// @stdout f1:7
// @stdout f2:12
// @stdout int:3
// @stdout string:hi
// @stdout bool:true
// @stdout long
// @stdout int
// @stdout long
// @stdout byte
// @stdout one:1
// @stdout two:3
// @stdout 5040
// @stdout 1,2
// @stdout at:0:5
// @stdout name:bob
// @stdout 4:2:9

f() -> string { return "f0"; }
f(int a) -> string { return "f1:" + a; }
f(int a, int b) -> string { return "f2:" + (a + b); }

describe(int v) -> string { return "int:" + v; }
describe(string v) -> string { return "string:" + v; }
describe(bool v) -> string { return "bool:" + v; }

pick(long v) -> string { return "long"; }
pick(string v) -> string { return "string"; }

value(int v) -> string { return "int"; }
value(long v) -> string { return "long"; }

choose(byte v) -> string { return "byte"; }
choose(long v) -> string { return "long"; }

single(int a) -> string { return "one:" + a; }
single(int a, int b = 2) -> string { return "two:" + (a + b); }

calculateArea(int width, int height) -> int { return width * height; }

pos(int x, int y) -> string { return x + "," + y; }

spawn(int x = 0, int y = 0) -> string { return "at:" + x + ":" + y; }
spawn(string name) -> string { return "name:" + name; }

make(int a, int b = 2, int c = 3) -> string { return a + ":" + b + ":" + c; }

main() -> int {
    print(f());
    print(f(7));
    print(f(5, 7));
    print(describe(3));
    print(describe("hi"));
    print(describe(true));
    print(pick(5));
    print(value(5));
    print(choose(5));
    byte small = 5;
    print(choose(small));
    print(single(1));
    print(single(1, 2));
    print("" + calculateArea(height: 56, width: 90));
    print(pos(y: 2, x: 1));
    print(spawn(y: 5));
    print(spawn("bob"));
    print(make(4, c: 9));
    return 0;
}
