// @expect-error Cannot read a member of 'Leaf?'
class Leaf {
    Leaf? next;
    Leaf(this.next = null);
}

main() -> int {
    let opt: Leaf? = new Leaf();
    if (opt != null) {
        // narrowed here, this is fine
        let inside = opt.next;
    }
    // narrowing must not leak outside the if-block.
    let outside = opt.next;
    return 0;
}
