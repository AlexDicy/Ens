// @expect-error Cannot read a member of 'Leaf?'
class Leaf {
    protected Leaf? next;
    protected constructor(this.next = null);
}

// A genuinely nullable source: the declared type stays 'Leaf?' with no
// straight-line refinement, so narrowing is confined to the if-block.
maybeLeaf() -> Leaf? {
    return new Leaf();
}

main() -> int {
    Leaf? opt = maybeLeaf();
    if (opt != null) {
        // narrowed here, this is fine
        let inside = opt.next;
    }
    // narrowing must not leak outside the if-block.
    let outside = opt.next;
    return 0;
}
