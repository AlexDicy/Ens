// @expect-error Method 'equals' overrides the built-in memberwise equality of struct 'Key'; mark it 'override'
// A struct compares memberwise until it says otherwise, so an 'equals' taking the struct's
// own type replaces a behavior the language provides and is written with 'override'. Without
// the marker it would read as an ordinary method while quietly deciding every '=='.

public struct Key {
    int id;

    public equals(Key other) -> bool {
        return this.id == other.id;
    }

    public override hash() -> long {
        return this.id;
    }
}

main() -> int {
    return 0;
}
