// @expect-error Method 'equals' of struct 'Key' replaces the built-in memberwise equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error Method 'equals' of struct 'Ranked' replaces the built-in memberwise equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error Method 'equals' of 'Mistyped' is marked 'override', and a struct inherits nothing to override. An 'equals' that does not take exactly one 'Mistyped' is an ordinary method, not the struct's equality. Remove 'override'.
// @expect-error Method 'equals' of 'Spoken' is marked 'override' but no interface 'Spoken' implements declares 'equals', and a struct inherits nothing. An 'equals' that does not take exactly one 'Spoken' is an ordinary method, not the struct's equality. Remove 'override'.
// @expect-error build failed with 4 problems
// A struct compares memberwise until it says otherwise, so an 'equals' taking the struct's
// own type replaces a behavior the language provides and is written with 'override'. Without
// the marker it would read as an ordinary method while quietly deciding every '=='. An 'equals'
// taking any other type is an ordinary method, which 'override' cannot mark.

public struct Key {
    int id;

    public equals(Key other) -> bool {
        return this.id == other.id;
    }

    public override hash() -> long {
        return this.id;
    }
}

// A generic struct names its own type with its type parameters.
public struct Ranked<T> {
    int rank;
    T payload;

    public equals(Ranked<T> other) -> bool {
        return this.rank == other.rank;
    }

    public override hash() -> long {
        return this.rank;
    }
}

struct Mistyped {
    int id;

    override equals(int other) -> bool {
        return this.id == other;
    }
}

interface Labeled {
    label() -> string;
}

struct Spoken implements Labeled {
    string text;

    override label() -> string {
        return this.text;
    }

    override equals(string other) -> bool {
        return this.text == other;
    }
}

main() -> int {
    return 0;
}
