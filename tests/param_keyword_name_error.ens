// @expect-error 'return' is a keyword, a word Ens keeps for its own use, so it cannot be a parameter name. Choose another name, such as 'value'.
// A reserved keyword in the parameter-name slot is reported once, with a
// suggestion, instead of cascading into a stream of follow-on errors.
greet(string return) -> int {
    return 1;
}

main() -> int {
    return greet("hi");
}
