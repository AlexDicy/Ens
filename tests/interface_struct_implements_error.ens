// What a struct conformance is held to, and what it does not buy. Every requirement needs a
// matching signature and the 'override' marker, and the conformance gives the struct no interface
// value, so a slot, a '??' fallback, a loop variable, an 'is' test and an 'as?' cast stay errors.
// @expect-error Struct 'Missing' implements 'Speaker' but does not provide 'speak() -> string'. Declare the method here, or stop implementing 'Speaker'.
// @expect-error Method 'mark' of struct 'Shaped' returns 'long', but interface 'Marker' requires 'int'. Change the return type of 'mark' to 'int'.
// @expect-error Method 'size' of struct 'Narrowed' returns 'int', but interface 'Sized' requires 'long', and an override must return exactly the same number type. Return 'long'.
// @expect-error Method 'ask' of struct 'Noisy' can throw 'Trouble', which the 'ask' declared by interface 'Quiet' does not list. An implementing method throws only what the interface lists. Remove 'throws' and catch 'Trouble' with a 'catch' clause after the body. Or mark 'ask' in 'Quiet' with 'throws Trouble'.
// @expect-error Method 'speak' of struct 'Unmarked' implements a method declared in interface 'Speaker' but is not marked 'override'. Write 'override' before 'speak'.
// @expect-error Method 'speak' of struct 'Hidden' is private, but it provides 'speak() -> string' for interface 'Loud', so it must be usable everywhere 'Hidden' is. Mark it 'export'.
// @expect-error Method 'speak' of struct 'Hidden' implements a method declared in interface 'Speaker' but is not marked 'override'. Write 'override' before 'speak'.
// @expect-error Method 'doubled' of 'Stray' is marked 'override' but no interface 'Stray' implements declares 'doubled', and a struct inherits nothing. Remove 'override'.
// @expect-error Method 'doubled' of 'Plain' is marked 'override', and a struct inherits nothing to override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a struct. Remove 'override'.
// @expect-error 'Holder' is a class, not an interface, and a struct never extends a class. Name an interface here, or give 'Extending' a field of type 'Holder'.
// @expect-error Interface 'Speaker' is listed more than once in the 'implements' clause. Remove this second 'Speaker'.
// @expect-error Method 'stop' of struct 'Running' must be marked 'noreturn', because interface 'Ender' declares it 'noreturn'.
// @expect-error Struct 'Conditional' provides 'mark() -> int' only for some type arguments, but 'Marker' needs it for every type argument. Remove the '<...>' list from 'mark', or stop implementing 'Marker'.
// @expect-error Method 'mark' of 'Conditional' cannot be both conditional and 'override': it exists only for some type arguments, and the method it replaces exists for all of them. Remove 'override', or remove the '<...>' list.
// @expect-error Variable 'slot' has type 'Speaker', but its value has type 'Unmarked'. 'Unmarked' implements 'Speaker', but a struct can only be passed where a type parameter such as '<T: Speaker>' is declared. A value of type 'Speaker' must be an object of a class, and a struct value is not one. Declare the type as 'Unmarked', or declare '<T: Speaker>' and use 'T'.
// @expect-error Argument 1 of 'heard' has type 'Unmarked', but parameter 'who' has type 'Speaker'. 'Unmarked' implements 'Speaker', but a struct can only be passed where a type parameter such as '<T: Speaker>' is declared. A value of type 'Speaker' must be an object of a class, and a struct value is not one. Declare the type as 'Unmarked', or declare '<T: Speaker>' and use 'T'.
// @expect-error Element 1 has type 'Unmarked', but the elements of this array have type 'Speaker'. 'Unmarked' implements 'Speaker', but a struct can only be passed where a type parameter such as '<T: Speaker>' is declared. A value of type 'Speaker' must be an object of a class, and a struct value is not one. Declare the type as 'Unmarked', or declare '<T: Speaker>' and use 'T'.
// @expect-error Cannot use 'is' on a value of type 'Unmarked', because only a class value can be tested with 'is'. 'Unmarked' implements 'Speaker', but a struct value is never a class instance. Remove the test, because every 'Unmarked' implements 'Speaker'.
// @expect-error Cannot use 'as?' on a value of type 'Unmarked', because only a class value can be cast with 'as?'. 'Unmarked' implements 'Speaker', but a struct value is never a class instance. Remove the cast, because every 'Unmarked' implements 'Speaker'.
// @expect-error Variable 'ordered' has type 'Comparable<Word>', but its value has type 'Word'. 'Word' implements 'Comparable<Word>', but a struct can only be passed where a type parameter such as '<T: Comparable<Word>>' is declared. A value of type 'Comparable<Word>' must be an object of a class, and a struct value is not one. Declare the type as 'Word', or declare '<T: Comparable<Word>>' and use 'T'.
// @expect-error The fallback after '??' has type 'Unmarked', but it replaces 'absent' when 'absent' is null, so it must have type 'Speaker'. 'Unmarked' implements 'Speaker', but a struct can only be passed where a type parameter such as '<T: Speaker>' is declared. A value of type 'Speaker' must be an object of a class, and a struct value is not one. Declare the type as 'Unmarked', or declare '<T: Speaker>' and use 'T'.
// @expect-error Loop variable 'ranked' has type 'Comparable<Word>', but this loop gives it 'Word' values. 'Word' implements 'Comparable<Word>', but a struct can only be passed where a type parameter such as '<T: Comparable<Word>>' is declared. A value of type 'Comparable<Word>' must be an object of a class, and a struct value is not one. Declare the type as 'Word', or declare '<T: Comparable<Word>>' and use 'T'.
// @expect-error 'Unmarked' cannot be used in 'for (... in ...)', because it does not implement 'Iterable' from '@std.collections.iterator'. Declare 'struct Unmarked implements Iterable<E>' and give it the method 'override makeIterator() -> Iterator<E>', where 'E' is the type of its elements.
// @expect-error build failed with 23 problems

interface Speaker {
    speak() -> string;
}

interface Loud extends Speaker {
    volume() -> int;
}

interface Marker {
    mark() -> int;
}

interface Sized {
    size() -> long;
}

interface Ender {
    noreturn stop();
}

interface Quiet {
    ask() -> int;
}

class Holder {
    constructor();
}

class Trouble extends Error {
    protected constructor(string message) {
        super(message);
    }
}

export struct Missing implements Speaker {
    export const int id;
}

export struct Shaped implements Marker {
    export const int id;

    export override mark() -> long {
        return 1L;
    }
}

export struct Narrowed implements Sized {
    export const int id;

    export override size() -> int {
        return this.id;
    }
}

export struct Noisy implements Quiet {
    export const int id;

    export override ask() -> int throws {
        throw new Trouble("boom");
    }
}

export struct Unmarked implements Speaker {
    export const int id;

    export speak() -> string {
        return "hi";
    }
}

export struct Hidden implements Loud {
    export const int id;

    speak() -> string {
        return "quiet";
    }

    export override volume() -> int {
        return 1;
    }
}

export struct Stray implements Speaker {
    export const int id;

    export override speak() -> string {
        return "hi";
    }

    override doubled() -> int {
        return this.id * 2;
    }
}

export struct Plain {
    export const int id;

    override doubled() -> int {
        return this.id * 2;
    }
}

export struct Extending implements Holder {
    export const int id;
}

export struct Repeated implements Speaker, Speaker {
    export const int id;

    export override speak() -> string {
        return "hi";
    }
}

export struct Running implements Ender {
    export const int id;

    export override stop() {
        print("never");
    }
}

export struct Conditional<T> implements Marker {
    export const T held;

    export constructor(this.held);

    export override mark<T: Comparable<T>>() -> int {
        return 0;
    }
}

export struct Word implements Comparable<Word> {
    export const string text;

    export constructor(this.text);

    export override compareTo(Word other) -> int {
        return this.text.compareTo(other.text);
    }
}

heard(Speaker who) -> string {
    return who.speak();
}

main() -> int {
    Unmarked note = {id: 1};
    Speaker slot = note;
    let passed = heard(note);
    Speaker[] all = [note];
    if (note is Speaker) {
        print("no");
    }
    let cast = note as? Speaker;
    Comparable<Word> ordered = Word("a");
    Speaker? absent = null;
    let fallback = absent ?? note;
    Word[] words = [Word("a")];
    for (Comparable<Word> ranked in words) {
        print("no");
    }
    // A conformance is what makes a value walkable, so a struct without one is refused by name
    // rather than for being a struct.
    for (let each in note) {
        print("no");
    }
    return 0;
}
