// What a struct conformance is held to, and what it does not buy. Every requirement needs a
// matching signature and the 'override' marker, and the conformance gives the struct no interface
// value, so a slot, a '??' fallback, a loop variable, an 'is' test and an 'as?' cast stay errors.
// @expect-error Struct 'Missing' implements 'Speaker' but does not provide 'speak() -> string'. Declare the method here, or stop implementing 'Speaker'.
// @expect-error Method 'mark' of struct 'Shaped' returns 'long', but interface 'Marker' requires 'int'. Change the return type of 'mark' to 'int'.
// @expect-error Method 'size' of struct 'Narrowed' returns 'int', but interface 'Sized' requires 'long', and the two are stored differently. An override may narrow a class, interface, array, string, function or handle reference, because each of those is one reference either way, but not a number and not a nullable value type. Return 'long'.
// @expect-error Method 'ask' of struct 'Noisy' can throw 'Trouble', which the 'ask' declared by interface 'Quiet' does not list. An implementing method throws only what the interface lists. Remove 'throws' and catch 'Trouble' with a 'catch' clause after the body. Or mark 'ask' in 'Quiet' with 'throws Trouble'.
// @expect-error Method 'speak' of struct 'Unmarked' implements a method declared in interface 'Speaker' but is not marked 'override'. Write 'override' before 'speak'.
// @expect-error Method 'speak' of struct 'Hidden' is private, but it provides 'speak() -> string' required by 'Loud', so it has to reach as far as 'Hidden' itself. Mark it 'export'.
// @expect-error Method 'speak' of struct 'Hidden' implements a method declared in interface 'Speaker' but is not marked 'override'. Write 'override' before 'speak'.
// @expect-error Method 'doubled' of 'Stray' is marked 'override' but no interface 'Stray' implements declares 'doubled', and a struct inherits nothing. Remove 'override'.
// @expect-error Method 'doubled' of 'Plain' is marked 'override', and a struct inherits nothing to override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a struct. Remove 'override'.
// @expect-error 'Holder' is a class, not an interface, and a struct never extends a class. Name an interface here, or hold a 'Holder' in a field of 'Extending'.
// @expect-error Interface 'Speaker' is listed more than once in the 'implements' clause.
// @expect-error Method 'stop' of struct 'Running' must be marked 'noreturn', because interface 'Ender' declares it 'noreturn'.
// @expect-error Struct 'Conditional' provides 'mark() -> int' only for some type arguments, and an interface requirement holds for all of them. Remove the '<...>' constraint list from 'mark', or stop implementing 'Marker'.
// @expect-error Method 'mark' of 'Conditional' cannot be both conditional and 'override'
// @expect-error Cannot assign value of type 'Unmarked' to variable of type 'Speaker'. 'Unmarked' does implement 'Speaker', but only as a generic bound: a '<T: Speaker>' parameter accepts 'Unmarked', while a value of type 'Speaker' has to be a class instance, and a struct never is. Write the slot as 'Unmarked', or make it a type parameter bounded by 'Speaker'.
// @expect-error Argument 1: expected 'Speaker', got 'Unmarked'. 'Unmarked' does implement 'Speaker', but only as a generic bound
// @expect-error Element 1: expected 'Speaker', got 'Unmarked'. 'Unmarked' does implement 'Speaker', but only as a generic bound
// @expect-error Cannot use 'is' on a value of type 'Unmarked'; only class values can be tested. 'Unmarked' does implement 'Speaker', but only as a generic bound: 'is' works on class instances, and a struct never is one.
// @expect-error Cannot use 'as?' on a value of type 'Unmarked'; only class values can be cast. 'Unmarked' does implement 'Speaker', but only as a generic bound: 'as?' works on class instances, and a struct never is one.
// @expect-error Cannot assign value of type 'Word' to variable of type 'Comparable<Word>'. 'Word' does implement 'Comparable<Word>', but only as a generic bound: a '<T: Comparable<Word>>' parameter accepts 'Word', while a value of type 'Comparable<Word>' has to be a class instance, and a struct never is. Write the slot as 'Word', or make it a type parameter bounded by 'Comparable<Word>'.
// @expect-error Right of '??' has type 'Unmarked', and '??' supplies the value for a null left side, so the fallback has to be a 'Speaker' too. 'Unmarked' does implement 'Speaker', but only as a generic bound: a '<T: Speaker>' parameter accepts 'Unmarked', while a value of type 'Speaker' has to be a class instance, and a struct never is. Write the slot as 'Unmarked', or make it a type parameter bounded by 'Speaker'.
// @expect-error Loop variable of type 'Comparable<Word>' cannot hold the 'Word' values this loop yields. 'Word' does implement 'Comparable<Word>', but only as a generic bound: a '<T: Comparable<Word>>' parameter accepts 'Word', while a value of type 'Comparable<Word>' has to be a class instance, and a struct never is. Write the slot as 'Word', or make it a type parameter bounded by 'Comparable<Word>'.
// @expect-error 'Unmarked' cannot be iterated: it does not implement 'Iterable' from '@std.collections.iterator'. Declare 'implements Iterable<T>' on it and give it a 'makeIterator() -> Iterator<T>' method.
// @expect-error build failed with 23 problems

interface Speaker {
    speak() -> string;
}

interface Loud extends Speaker {
    volume() -> int;
}

interface Marker {
    mark() -> int;
}

interface Sized {
    size() -> long;
}

interface Ender {
    noreturn stop();
}

interface Quiet {
    ask() -> int;
}

class Holder {
    constructor();
}

class Trouble extends Error {
    protected constructor(string message) {
        super(message);
    }
}

export struct Missing implements Speaker {
    export const int id;
}

export struct Shaped implements Marker {
    export const int id;

    export override mark() -> long {
        return 1L;
    }
}

export struct Narrowed implements Sized {
    export const int id;

    export override size() -> int {
        return this.id;
    }
}

export struct Noisy implements Quiet {
    export const int id;

    export override ask() -> int throws {
        throw new Trouble("boom");
    }
}

export struct Unmarked implements Speaker {
    export const int id;

    export speak() -> string {
        return "hi";
    }
}

export struct Hidden implements Loud {
    export const int id;

    speak() -> string {
        return "quiet";
    }

    export override volume() -> int {
        return 1;
    }
}

export struct Stray implements Speaker {
    export const int id;

    export override speak() -> string {
        return "hi";
    }

    override doubled() -> int {
        return this.id * 2;
    }
}

export struct Plain {
    export const int id;

    override doubled() -> int {
        return this.id * 2;
    }
}

export struct Extending implements Holder {
    export const int id;
}

export struct Repeated implements Speaker, Speaker {
    export const int id;

    export override speak() -> string {
        return "hi";
    }
}

export struct Running implements Ender {
    export const int id;

    export override stop() {
        print("never");
    }
}

export struct Conditional<T> implements Marker {
    export const T held;

    export constructor(this.held);

    export override mark<T: Comparable<T>>() -> int {
        return 0;
    }
}

export struct Word implements Comparable<Word> {
    export const string text;

    export constructor(this.text);

    export override compareTo(Word other) -> int {
        return this.text.compareTo(other.text);
    }
}

heard(Speaker who) -> string {
    return who.speak();
}

main() -> int {
    Unmarked note = {id: 1};
    Speaker slot = note;
    let passed = heard(note);
    Speaker[] all = [note];
    if (note is Speaker) {
        print("no");
    }
    let cast = note as? Speaker;
    Comparable<Word> ordered = Word("a");
    Speaker? absent = null;
    let fallback = absent ?? note;
    Word[] words = [Word("a")];
    for (Comparable<Word> ranked in words) {
        print("no");
    }
    // A conformance is what makes a value walkable, so a struct without one is refused by name
    // rather than for being a struct.
    for (let each in note) {
        print("no");
    }
    return 0;
}
