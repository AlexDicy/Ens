// @exit 30
// @stdout ab
// `main` calls only `relay`, never `leaf` or `zsink` directly, so the leaf
// instances become concrete only through the monomorphization cascade. Two
// distinct type arguments (int and string) each trip the whole chain.
import relay;

main() -> int {
    print(relay.relay<string>("ab"));
    return relay.relay<int>(30);
}
