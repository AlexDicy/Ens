import leaf;
import zsink;

// `relay<T>` turns concrete only when `main` monomorphizes it. Its body then
// discovers `leaf.identity<T>` (a module emitted before this one) and
// `zsink.sink<T>` (a module emitted after), so both cross-module cascade
// directions are exercised.
public relay<T>(T v) -> T {
    T a = leaf.identity<T>(v);
    return zsink.sink<T>(a);
}
