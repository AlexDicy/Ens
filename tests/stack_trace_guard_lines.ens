// @exit 134
// @stderr panic: tried to read index 5 of an array of length 2. Check the index against 'length' first
// @stderr-at O0   at pick (stack_trace_guard_lines.ens:10)
// @stderr-at O2   at pick (stack_trace_guard_lines.ens:10, inlined)
// @stderr   at main (stack_trace_guard_lines.ens:16)
// Two checked reads in one function fail the same way, and the trace names the line of the one that
// failed, at every optimization level.
pick(int[] xs, int i, int j) -> int {
    int a = xs[i];
    int b = xs[j];
    return a + b;
}

main() -> int {
    int[] xs = new int[2];
    return pick(xs, 0, 5);
}
