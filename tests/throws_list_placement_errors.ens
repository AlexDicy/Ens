// @expect-error 'twice' can throw 'SealError' and 'WriteError', which its 'throws' list does not name. Add them to the list, or catch them with a 'catch' clause.
// @expect-error 'measure' can throw 'WriteError', which its 'throws' list does not name
// @expect-error build failed with 2 problems
// A declared list is an upper bound the body is held to, at every placement where the list is
// legal.
class ReadError extends Error {
    protected constructor(string message) { super(message); }
}

class WriteError extends Error {
    protected constructor(string message) { super(message); }
}

interface Sized {
    size() -> int;
}

class SealError extends Error {
    protected constructor(string message) {
        super(message);
    }
}

twice(bool first) -> int throws ReadError {
    if (first) {
        throw new WriteError("wrong list");
    }
    throw new SealError("wrong list");
}

class Holder<T> {
    protected constructor();

    protected measure<T: Sized>(T value) -> int throws ReadError {
        throw new WriteError("wrong list");
    }
}

main() -> int {
    return 0;
}
