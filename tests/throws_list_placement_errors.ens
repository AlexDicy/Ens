// A declared list is an upper bound the body is held to, at every placement where the list is
// legal.
class ReadError extends Error {
    protected constructor(string message) { super(message); }
}

class WriteError extends Error {
    protected constructor(string message) { super(message); }
}

interface Sized {
    size() -> int;
}

free() -> int throws ReadError {
    throw new WriteError("wrong list");
}

final class Store {
    protected constructor();

    hidden() -> int throws ReadError {
        throw new WriteError("wrong list");
    }
}

// An entry that does not resolve leaves the thrown types unknown. The body and the caller's
// 'try' and 'catch' are then not judged.
misspelled() -> int throws ReedError {
    throw new WriteError("unknown list");
}

callsMisspelled() -> int {
    return try misspelled();
} catch (Error e) {
    return 0;
}

// A call to a function marked 'throws' needs 'try' whatever its list holds.
callsMisspelledWithoutTry() -> int {
    return misspelled();
}

class Holder<T> {
    protected constructor();

    protected measure<T: Sized>(T value) -> int throws ReadError {
        throw new WriteError("wrong list");
    }
}

main() -> int {
    return 0;
}
