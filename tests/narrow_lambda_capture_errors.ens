// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda copies 'kept' when it is created. The assignment 'kept = "abc"' comes later in the same call. Assign 'kept' before the call, for example 'kept = "abc";'.
// @expect-error build failed with 1 problem
// A lambda copies a local where it is created, so a write in a later argument of the same method
// call does not narrow the copy, even where the candidate is chosen only after that argument.

pick() -> string? {
    return null;
}

make(string? text) -> () -> long {
    return () -> 0;
}

class Runner {
    protected constructor();

    protected run((() -> long)[] bodies) -> long {
        return bodies[0]();
    }

    protected run(long[] values) -> long {
        return values[0];
    }
}

laterWriteMethod() -> long {
    string? kept = pick();
    return new Runner().run([() -> kept.length, make(kept = "abc")]);
}

main() -> int {
    return laterWriteMethod() as int;
}
