// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda reads 'holder.fixed' from the object when the lambda runs, and a 'const' field can still change until its object's constructor ends. Copy it into a local before the lambda, as in 'let fixed = holder.fixed;', and read the local inside the lambda.
// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda reads 'this.fixed' from the object when the lambda runs, and a 'const' field can still change until its object's constructor ends. Copy it into a local before the lambda, as in 'let fixed = this.fixed;', and read the local inside the lambda.
// @expect-error Type 'Shape' has no field or method named 'radius'. The lambda reads 'this.shape' from the object when the lambda runs, and a 'const' field can still change until its object's constructor ends. Copy it into a local before the lambda, as in 'let shape = this.shape;', and read the local inside the lambda.
// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda copies 'held' when it is created. The assignment 'held = "abc"' comes later in the same call. Assign 'held' before the call, for example 'held = "abc";'.
// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda copies 'kept' when it is created. The assignment 'kept = "abc"' comes later in the same call. Assign 'kept' before the call, for example 'kept = "abc";'.
// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda reads 'this.fixed' from the object when the lambda runs, and a 'const' field can still change until its object's constructor ends. Copy it into a local before the lambda, as in 'let fixed = this.fixed;'. Change the test 'this.fixed != null' to 'fixed != null', and read the local inside the lambda.
// @expect-error Cannot read a member of 'string?' because it may be null here. The lambda copies 'marked' when it is created. The assignment 'marked = "abc"' comes later in the same call. Assign 'marked' before the call, for example 'marked = "abc";'.
// @expect-error build failed with 7 problems
// A 'const' field of a class object is read from the object when a lambda runs, so a narrowing of
// one made outside a lambda does not reach its body. A lambda copies a local where it is created,
// so a write in a later argument of the same call does not narrow the copy, even where the
// candidate is chosen only after that argument or the lambda is a field of a '{...}' argument. A
// copy made before a statement holds no proof that a '?:' in it makes, so the fix moves the test
// onto the copy too.

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 1;

    protected constructor();
}

class Holder {
    protected const string? fixed = "start";
    protected const Shape shape = new Circle();
    protected () -> long measure = () -> 0;

    protected constructor() {
        this.measure = measureLater(this);
    }

    protected fixedLength() -> () -> long {
        if (this.fixed == null) {
            return () -> 0;
        }
        return () -> this.fixed.length;
    }

    protected ternaryLength() -> () -> long {
        return this.fixed != null ? () -> this.fixed.length : () -> 0;
    }

    protected radius() -> () -> int {
        if (this.shape is Circle) {
            return () -> this.shape.radius;
        }
        return () -> 0;
    }
}

measureLater(Holder holder) -> () -> long {
    if (holder.fixed == null) {
        return () -> -1;
    }
    return () -> {
        return holder.fixed.length;
    };
}

pick() -> string? {
    return null;
}

make(string? text) -> () -> long {
    return () -> 0;
}

consume((() -> long)[] bodies) -> long {
    return bodies[0]();
}

consume(long[] values) -> long {
    return values[0];
}

class Runner {
    protected constructor();

    protected run((() -> long)[] bodies) -> long {
        return bodies[0]();
    }

    protected run(long[] values) -> long {
        return values[0];
    }
}

laterWrite() -> long {
    string? held = pick();
    return consume([() -> held.length, make(held = "abc")]);
}

laterWriteMethod() -> long {
    string? kept = pick();
    return new Runner().run([() -> kept.length, make(kept = "abc")]);
}

struct Body {
    () -> long body;
}

runBody(Body holder, string? value) -> long {
    return holder.body();
}

laterWriteField() -> long {
    string? marked = pick();
    return runBody({ body: () -> marked.length }, marked = "abc");
}

main() -> int {
    let holder = new Holder();
    return (holder.measure() + holder.fixedLength()() + holder.ternaryLength()() + laterWrite()
        + laterWriteMethod() + laterWriteField()) as int + holder.radius()();
}
