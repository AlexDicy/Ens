// @exit 0
// @stdout struct-bound 3 -1
// @stdout class-bound 7 -1
// @stdout note 3
// @stdout note 7
// @stdout void-bound
// @stdout bound-field 4 -1
// @stdout bound-method derived none
// @stdout flattened 5 -1
// A '?.' on a 'T?' reaches the members of what bounds 'T', the same members '.' reaches once the
// value is checked for null.
interface Reader {
    read() -> int;
    note();
}

class Box implements Reader {
    int value = 0;

    constructor(int value) {
        this.value = value;
    }

    override read() -> int {
        return this.value;
    }

    override note() {
        print("note {this.value}");
    }
}

struct Counter implements Reader {
    int value;

    override read() -> int {
        return this.value;
    }

    override note() {
        print("note {this.value}");
    }
}

readOr<T: Reader>(T? item) -> int {
    int? read = item?.read();
    return read ?? -1;
}

noteIt<T: Reader>(T? item) {
    item?.note();
}

class Base {
    int field = 4;

    name() -> string {
        return "base";
    }
}

class Derived extends Base {
    override name() -> string {
        return "derived";
    }
}

class Holder {
    int? kept = null;

    constructor(int kept) {
        this.kept = kept;
    }

    take() -> int? {
        return this.kept;
    }
}

nameOf<T: Base>(T? item) -> string {
    return item?.name() ?? "none";
}

fieldOf<T: Base>(T? item) -> int {
    return item?.field ?? -1;
}

main() -> int {
    Counter? counter = {value: 3};
    Counter? noCounter = null;
    Box? box = new Box(7);
    Box? noBox = null;
    print("struct-bound {readOr(counter)} {readOr(noCounter)}");
    print("class-bound {readOr(box)} {readOr(noBox)}");
    noteIt(counter);
    noteIt(box);
    noteIt(noCounter);
    print("void-bound");

    Derived? derived = new Derived();
    Derived? noDerived = null;
    print("bound-field {fieldOf(derived)} {fieldOf(noDerived)}");
    print("bound-method {nameOf(derived)} {nameOf(noDerived)}");

    // A member that is itself nullable keeps its one level through '?.', as it does through '.'.
    Holder? holder = new Holder(5);
    Holder? noHolder = null;
    print("flattened {holder?.take() ?? -1} {(noHolder?.take() ?? null) ?? -1}");
    return 0;
}
