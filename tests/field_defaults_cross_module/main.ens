// @exit 0
// @stdout token0 Invalid 0 0
// @stdout token1 Identifier 5 3
// @stdout shape shape 3x4 12
// @stdout scaled 14
// @stdout boxed 9 nine
// @stdout labelled 15 tag
// A struct with analysis-dependent field defaults, declared here, used as a
// `List<T>` type argument whose template lives in another module. The defaults
// must still be applied when the instantiated constructor runs.
import List from @std.collections.list;
import Kind from tokens;
import RawToken from tokens;
import Shape from tokens;
import Scaler from tokens;
import Boxed from tokens;
import Labelled from tokens;

main() -> int {
    let tokens = new List<RawToken>();

    RawToken first = {offset: 0, length: 0};
    tokens.push(first);

    RawToken second = {kind: Kind.Identifier, offset: 5, length: 3};
    tokens.push(second);

    let a = tokens.get(0);
    let b = tokens.get(1);
    print("token0 {a.kind} {a.offset} {a.length}");
    print("token1 {b.kind} {b.offset} {b.length}");

    let shapes = new List<Shape>();
    Shape s = {};
    shapes.push(s);
    let got = shapes.get(0);
    print("shape {got.label} {got.area}");

    // A field default that is a lambda: the closure is built here, and the body it points at is
    // defined in the module that wrote the lambda.
    let scaler = new Scaler();
    print("scaled {scaler.step(7L)}");

    let numbers = new Boxed<long>();
    let words = new Boxed<string>();
    string word = words.pass("nine");
    print("boxed {numbers.pass(9L)} {word}");

    // Defaults whose lambdas captured a sibling field: a number, and a reference whose closure
    // carries a destructor defined in the declaring module.
    let labelled = new Labelled();
    string named = labelled.name(0L);
    print("labelled {labelled.scale(5L)} {named}");

    return 0;
}
