// @exit 0
// @stdout token0 Invalid 0 0
// @stdout token1 Identifier 5 3
// @stdout shape shape 3x4 12
// A struct with analysis-dependent field defaults, declared here, used as a
// `List<T>` type argument whose template lives in another module. The defaults
// must still be applied when the instantiated constructor runs.
import List from @std.list;
import Kind from tokens;
import RawToken from tokens;
import Shape from tokens;

main() -> int {
    let tokens = new List<RawToken>();

    RawToken first;
    tokens.push(first);

    RawToken second;
    second.kind = Kind.Identifier;
    second.offset = 5;
    second.length = 3;
    tokens.push(second);

    let a = tokens.get(0);
    let b = tokens.get(1);
    print("token0 {a.kind} {a.offset} {a.length}");
    print("token1 {b.kind} {b.offset} {b.length}");

    let shapes = new List<Shape>();
    Shape s;
    shapes.push(s);
    let got = shapes.get(0);
    print("shape {got.label} {got.area}");

    return 0;
}
