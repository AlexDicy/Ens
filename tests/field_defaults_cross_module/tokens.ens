public enum Kind {
    Invalid,
    Identifier,
    Number,
}

// The field default `Kind.Invalid` is an enum constant that only the declaring
// module's analysis can resolve. When this struct is a `List<RawToken>` type
// argument, the instantiated constructor is emitted in `@std.collections.list`, so codegen
// must reach back to this module to emit the default.
public struct RawToken {
    public Kind kind = Kind.Invalid;
    public long offset;
    public long length;
}

// Field defaults that are analysis-dependent in other ways: a plain literal, a
// sibling-field reference, and string interpolation over sibling fields.
public struct Shape {
    public long width = 3;
    public long height = 4;
    public long area = 12;
    public string label = "shape {width}x{height}";
}

// A field default that is a lambda. Its body is a function of its own, defined in this module
// because a default is lowered wherever the record is built, which is another module here.
public class Scaler {
    public (long) -> long step = (value) -> value * 2;
    public constructor();
}

// A field default that is a lambda inside a generic class. Its body is a function of its own,
// defined in this module and lowered once per instantiation.
public class Boxed<T> {
    public (T) -> T pass = (value) -> value;
    public constructor();
}

// Defaults whose lambdas capture a sibling field declared before them: one a number, one a
// reference, so the closure that keeps the reference carries a destructor this module defines and
// the module building the record names.
public class Labelled {
    public long factor = 3;
    public string prefix = "tag";
    public (long) -> long scale = (value) -> value * factor;
    public (long) -> string name = (value) -> prefix;

    public constructor();
}
