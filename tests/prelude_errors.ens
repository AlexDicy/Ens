// @stdlib prelude_stdlib
// What the prelude does not do. A function the implicitly imported module keeps to itself is not
// in scope.
// @expect-error Function 'inPackageOnly' is public inside package 'std' but not exported, so another package cannot use it.
// @expect-error Function 'fileOnly' is private to module '@std.core', so only that file can use it.
// @expect-error 'tally' is a static method of 'Counter', and a static method is always called through its type name, even inside 'Counter'. Write 'Counter.tally()'.
// @expect-error Function name 'StackFrame' is already the name of a type the language provides. Rename the function.
// @expect-error build failed with 4 problems

// Unlike a prelude function's name, a prelude type's name cannot be taken back.
StackFrame() -> int {
    return 0;
}

// A name no prelude module carries still reaches the suggestion a bare call to a static deserves.
class Counter {
    static tally() -> long {
        return 2;
    }

    static use() -> long {
        return tally();
    }
}

main() -> int {
    print(inPackageOnly());
    print(fileOnly());
    return 0;
}
