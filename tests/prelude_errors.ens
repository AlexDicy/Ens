// @stdlib prelude_stdlib
// What the prelude does not do. A function the implicitly imported module keeps to itself is not
// in scope, and a declaration of this file's own takes the name back from the prelude, so a call
// that does not fit the local declaration is measured against it rather than against the prelude.
// @expect-error Function 'inPackageOnly' is public inside package 'std' but not exported. Mark it 'export' in module 'std.core' to use it from another package.
// @expect-error Function 'fileOnly' is private to module 'std.core'; it can only be used inside that file. Mark it 'export' to use it from another package.
// @expect-error Argument 1: expected 'bool', got 'string'
// @expect-error Statics are called through the type name, even inside 'Counter'; write 'Counter.tally(...)'.
// @expect-error build failed with 4 problems

describe(bool flag) -> string {
    return "flag {flag}";
}

// A name no prelude module carries still reaches the suggestion a bare call to a static deserves.
class Counter {
    static tally() -> long {
        return 2;
    }

    static use() -> long {
        return tally();
    }
}

main() -> int {
    print(inPackageOnly());
    print(fileOnly());
    print(describe("abc"));
    return 0;
}
