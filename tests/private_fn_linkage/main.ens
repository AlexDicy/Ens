// @exit 12
// Two sibling modules each define a `private helper`. Each helper gets internal
// linkage under its unmangled name, so the two emissions do not collide at link
// time. Every public wrapper calls its own module's helper, and the distinct
// return values (5 and 7) confirm each call stays inside its module.
import alpha;
import beta;

main() -> int {
    return (alpha.wrapperAlpha() + beta.wrapperBeta()) as int;
}
