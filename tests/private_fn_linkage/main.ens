// @exit 12
// @stdout alpha says one
// @stdout beta says one two
// Two sibling modules each define a `private helper` of the same shape and a `private describe`
// with different parameter counts. Both keep internal linkage and each symbol is qualified by its
// module, so the cross-function passes never merge two same-named private functions' facts.
import alpha;
import beta;

main() -> int {
    print(alpha.sayAlpha("one"));
    print(beta.sayBeta("one", "two"));
    return (alpha.wrapperAlpha() + beta.wrapperBeta()) as int;
}
