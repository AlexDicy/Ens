// @exit 0
// @stdout local l0
// @stdout released l0
// @stdout local done
// @stdout released l1
// @stdout field f0
// @stdout released f0
// @stdout field done
// @stdout called c0
// @stdout released c0
// @stdout called done
// @stdout broken b0
// @stdout released b0
// @stdout broken done
// @stdout released b2
// @stdout released b1
// @stdout struct s0
// @stdout released s0
// @stdout struct done
// @stdout released s1
// @stdout kept k0
// @stdout-at O2 released k0
// @stdout kept done
// @stdout-at O0 released k0
// @stdout released f1
// @stdout released c1
// The variable of a for-each loop over an array keeps the element it took for the whole
// iteration, even when the body replaces that element in the array: directly in a local or a
// field array, through a call, before a 'break', or as a struct holding a reference. The replaced
// element is released when its iteration ends. At O2 a local array the loop reads last is moved
// into the loop, so it is released where the loop ends instead of where the function ends. A Probe
// renames itself when it is released, so a read of a released element prints the wrong name or
// faults.
class Probe {
    string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
        this.label = "FREED";
    }
}

struct Box {
    Probe probe;
}

class Holder {
    Probe[] nodes;
    Probe[] called;

    constructor() {
        this.nodes = [new Probe("f0")];
        this.called = [new Probe("c0")];
    }
}

replace(Holder holder) {
    holder.called[0] = new Probe("c1");
}

replacedLocal() {
    Probe[] nodes = [new Probe("l0")];
    for (let n in nodes) {
        nodes[0] = new Probe("l1");
        print("local " + n.label);
    }
    print("local done");
}

replacedField(Holder holder) {
    for (let n in holder.nodes) {
        holder.nodes[0] = new Probe("f1");
        print("field " + n.label);
    }
    print("field done");
}

replacedByCall(Holder holder) {
    for (let n in holder.called) {
        replace(holder);
        print("called " + n.label);
    }
    print("called done");
}

replacedBeforeBreak() {
    Probe[] nodes = [new Probe("b0"), new Probe("b1")];
    for (let n in nodes) {
        nodes[0] = new Probe("b2");
        print("broken " + n.label);
        break;
    }
    print("broken done");
}

replacedStruct() {
    Box[] boxes = [{probe: new Probe("s0")}];
    for (let box in boxes) {
        boxes[0] = {probe: new Probe("s1")};
        print("struct " + box.probe.label);
    }
    print("struct done");
}

kept() {
    Probe[] nodes = [new Probe("k0")];
    for (let n in nodes) {
        print("kept " + n.label);
    }
    print("kept done");
}

main() -> int {
    replacedLocal();
    let holder = new Holder();
    replacedField(holder);
    replacedByCall(holder);
    replacedBeforeBreak();
    replacedStruct();
    kept();
    return 0;
}
