// @exit 134
// @stderr panic: failed inside a task
// @stderr   at fail (tasks_trace.ens:17)
// @stderr   at fail (tasks_trace.ens:19)
// @stderr   at fail (tasks_trace.ens:19)
// @stderr   at lambda (tasks_trace.ens:24)
// @stderr-at O0   at runLaunched (tasks.ens:906)
// @stderr-at O2   at runLaunched (tasks.ens:906, inlined)
// @stderr   at lambda (tasks.ens:528)
// @stderr   at lambda (tasks.ens:1101)
// A panic inside a task prints the frames of the task's own stack, down to the library call that
// started its body, and nothing more: no frame of the scheduler's and no note of a cut-off trace.
import @std.tasks;

fail(long depth) {
    if (depth == 0) {
        panic("failed inside a task");
    }
    fail(depth - 1);
}

main() -> int {
    tasks.scope((scope) -> {
        scope.launch(() -> fail(2));
    });
    return 0;
}
