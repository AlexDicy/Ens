// @expect-error Method 'equals' of 'Widget' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
class Widget {
    int id;
    constructor(this.id);
    override hash() -> long { return this.id; }
    equals(Widget other) -> bool { return this.id == other.id; }
}

main() -> int {
    return 0;
}
