// @expect-error Method 'equals' of 'Widget' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error Method 'equals' of 'Holder' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error Method 'equals' of 'Mistyped' is marked 'override', but no base class or interface of 'Mistyped' declares 'equals'. An 'equals' that does not take exactly one 'Mistyped' is an ordinary method, not the class's equality. Remove 'override'.
// @expect-error build failed with 3 problems
class Widget {
    int id;
    constructor(this.id);
    override hash() -> long { return this.id; }
    equals(Widget other) -> bool { return this.id == other.id; }
}

// A generic class names its own type with its type parameters, so 'equals(Holder<T> other)' replaces '=='.
class Holder<T> {
    int id;

    constructor(this.id);

    override hash() -> long {
        return this.id;
    }

    equals(Holder<T> other) -> bool {
        return this.id == other.id;
    }
}

// An 'equals' taking any other type is an ordinary method, which 'override' cannot mark.
class Mistyped {
    int id;

    constructor(this.id);

    override equals(int other) -> bool {
        return this.id == other;
    }
}

main() -> int {
    return 0;
}
