// @exit 134
// @stderr-contains panic: 'Streams.width' was read while it was still being initialized
// A cycle a lazy const initializer closes through a function call is invisible to the compiler,
// so it stops the program on the read that closes it, naming the value.
public class Streams {
    public lazy const long width = doubled();
}

doubled() -> long {
    return Streams.width * 2;
}

main() -> int {
    print("{Streams.width}");
    return 0;
}
