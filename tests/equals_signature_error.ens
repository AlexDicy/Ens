// @expect-error Method 'equals' takes a value of type 'Gadget', so '==' uses it to compare two 'Gadget' values, and it must return 'bool'. Change its return type to 'bool', or rename the method.
// @expect-error Method 'equals' takes a value of type 'Lone', so '==' uses it to compare two 'Lone' values, and it must return 'bool'. Change its return type to 'bool', or rename the method and remove 'override'.
// @expect-error Method 'equals' takes a value of type 'Widget', so '==' uses it to compare two 'Widget' values, and it must return 'bool'. Change its return type to 'bool', or rename both 'hash' and 'equals' and remove 'override' from each.
// @expect-error Method 'equals' of 'Sprocket' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error A method named 'equals' cannot be marked 'throws': '==' calls it where no 'try' can be written. Remove 'throws', or rename both 'hash' and 'equals' and remove 'override' from 'hash'.
// @expect-error build failed with 5 problems
class Failure extends Error {
    constructor() {
        super("failure");
    }
}

class Gadget {
    int id;

    constructor(this.id);

    equals(Gadget other) -> int {
        return this.id - other.id;
    }
}

class Lone {
    int id;

    constructor(this.id);

    override equals(Lone other) -> int {
        return this.id - other.id;
    }
}

class Widget {
    int id;

    constructor(this.id);

    override hash() -> long {
        return this.id;
    }

    override equals(Widget other) -> int {
        return this.id - other.id;
    }
}

class Sprocket {
    int id;

    constructor(this.id);

    override hash() -> long {
        return this.id;
    }

    equals(Sprocket other) -> bool throws Failure {
        return this.id == other.id;
    }
}

main() -> int {
    return 0;
}
