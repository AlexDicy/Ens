// @exit 0
// @stdout released local
// @stdout local: 2 local2
// @stdout released field
// @stdout fields: 2 11 21
// @stdout released maybe
// @stdout structs: 32 41
// @stdout elements: 51 3 4
// @stdout loop 0: 4
// @stdout loop 1: 6
// @stdout loop 2: 8
// @stdout after the loop: 8 5
// @stdout released field2
// @stdout caught stop
// @stdout after the throw: 9 partial
// @stdout detached keeps partial 10
// @stdout released partial
// @stdout after the detach: null
// @stdout released local2
// @stdout cleared local: null
// @stdout released kept
// @stdout shown kept 7
// @stdout nested: 2 2 2
// @stdout released plain
// @stdout released maybe
// @stdout released owned
// @stdout replaced: 200 plainNew 200 maybeNew 200 ownedNew
// @stdout released cleared
// @stdout cleared: true
// @stdout released maybeNew
// @stdout released plainNew
// @stdout released ownedNew
// @stdout announce ran on held
// @stdout announce ran on heldRow
// @stdout announce ran on held
// @stdout cleared links: 2 1 true true true
// @stdout null at start: null
// @stdout released held
// @stdout released heldRow
// @stdout done
// @stdout released kept2
// @stdout released first
// @stdout released second
// @stdout released rows
// @stdout released maybe2
// @stdout released inner
// @stdout released nested
// @stdout released element
// A 'mutating' method called through '?.' on an optional struct changes the struct where it is
// kept, at every link of a chain: a local, a field of an object, of a struct and of 'this', an
// array element, inside a loop, and where the method throws. A method that sets the optional to
// null while it runs keeps a value of its own until it returns, and the optional stays null. The
// arguments run first, as they do for a call written with '.', so a change they make to the
// optional is kept, and the method is not called when they set the optional to null. An object or
// an array on the way is held, so the method still runs on it when an argument clears the
// reference, and the arguments do not run at all when the optional is null to begin with. Each Probe
// reports its own release, so a missed retain frees early and a missed release never reports at
// all.
class Probe {
    string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

class Failure extends Error {
    constructor(string message) {
        super(message);
    }
}

struct Tally {
    long count;
    Probe probe;

    mutating bump() {
        this.count++;
    }

    mutating relabel(string label) {
        this.probe = new Probe(label);
        this.count++;
    }

    mutating add(long amount) {
        this.count += amount;
    }

    mutating relabelled(string label) -> long {
        this.probe = new Probe(label);
        return this.count;
    }

    mutating next() -> long {
        this.count++;
        return this.count;
    }

    mutating bumpThenFail() throws {
        this.count++;
        this.probe = new Probe("partial");
        throw new Failure("stop");
    }

    mutating announce(long amount) {
        print("announce ran on {this.probe.label}");
        this.count += amount;
    }

    mutating detach(Owner owner) {
        owner.tally = null;
        this.count++;
        print("detached keeps {this.probe.label} {this.count}");
    }
}

struct Nest {
    Tally? inner;

    mutating bumpInner() {
        this.inner?.bump();
    }

    mutating clearInner() -> long {
        this.inner = null;
        return 1;
    }
}

class Owner {
    Tally? tally;
    Nest? nest;
    Tally?[] row;

    constructor(this.tally, this.nest, this.row);

    bumpField() {
        this.tally?.bump();
    }
}

struct Wrap {
    Owner? owner;
}

tally(string label, long count) -> Tally {
    return {count: count, probe: new Probe(label)};
}

shown(string label, long count) {
    print("shown {label} {count}");
}

taken(bool cleared) -> long {
    return 1;
}

passed(long amount) -> long {
    return amount;
}

noted(long amount) -> long {
    print("argument ran {amount}");
    return amount;
}

replaceTally(Owner owner) -> long {
    owner.tally = tally("ownedNew", 100);
    return 100;
}

failing(Owner owner) {
    try owner.tally?.bumpThenFail();
} catch (Failure e) {
    print("caught {e.message}");
}

writtenByArguments() {
    Owner owner = new Owner(tally("owned", 0), null, []);
    Tally plain = tally("plain", 0);
    plain.add(plain.next());
    Tally? maybe = tally("maybe", 0);
    maybe?.add(maybe?.next() ?? 0);
    owner.tally?.add(owner.tally?.next() ?? 0);
    print("nested: {plain.count} {maybe?.count} {owner.tally?.count}");
    plain.add(passed((plain = tally("plainNew", 100)).count));
    maybe?.add(passed((maybe = tally("maybeNew", 100)).count));
    owner.tally?.add(replaceTally(owner));
    print("replaced: {plain.count} {plain.probe.label} {maybe?.count} {maybe?.probe?.label} "
        + "{owner.tally?.count} {owner.tally?.probe?.label}");
    Nest nest = {inner: tally("cleared", 0)};
    nest.inner?.announce(nest.clearInner());
    print("cleared: {nest.inner == null}");
}

clearedLinks() {
    Owner? owner = new Owner(tally("held", 0), null, [tally("heldRow", 0)]);
    Owner? kept = owner;
    owner?.tally?.announce(taken((owner = null) == null));
    Tally?[]? row = kept?.row;
    row?[0]?.announce(taken((row = null) == null));
    Wrap wrap = {owner: kept};
    wrap.owner?.tally?.announce(taken((wrap.owner = null) == null));
    print("cleared links: {kept?.tally?.count} {kept?.row?[0]?.count} {owner == null} {row == null} "
        + "{wrap.owner == null}");
    Tally? none = null;
    none?.announce(noted(1));
    print("null at start: {none?.count}");
}

main() {
    Tally? local = tally("local", 0);
    local?.bump();
    local?.relabel("local2");
    print("local: {local?.count} {local?.probe?.label}");
    Owner owner = new Owner(tally("field", 0), {inner: tally("nested", 10)},
        [tally("element", 20), null]);
    owner.tally?.relabel("field2");
    owner.nest?.inner?.bump();
    owner.row[0]?.bump();
    owner.row[1]?.bump();
    owner.bumpField();
    print("fields: {owner.tally?.count} {owner.nest?.inner?.count} {owner.row[0]?.count}");
    Nest nest = {inner: tally("inner", 30)};
    nest.inner?.bump();
    nest.bumpInner();
    Nest? maybeNest = {inner: tally("maybe", 40)};
    maybeNest?.inner?.relabel("maybe2");
    print("structs: {nest.inner?.count} {maybeNest?.inner?.count}");
    Tally?[]? rows = [tally("rows", 50)];
    rows?[0]?.bump();
    Tally?[] pair = [tally("first", 0), tally("second", 1)];
    for (long i = 0; i < pair.length; i++) {
        pair[i]?.add(3);
    }
    print("elements: {rows?[0]?.count} {pair[0]?.count} {pair[1]?.count}");
    for (long i = 0; i < 3; i++) {
        owner.tally?.bump();
        local?.bump();
        print("loop {i}: {owner.tally?.next()}");
    }
    print("after the loop: {owner.tally?.count} {local?.count}");
    failing(owner);
    print("after the throw: {owner.tally?.count} {owner.tally?.probe?.label}");
    owner.tally?.detach(owner);
    print("after the detach: {owner.tally?.count}");
    local?.announce(taken((local = null) == null));
    print("cleared local: {local?.count}");
    Tally? kept = tally("kept", 7);
    if (kept != null) {
        shown(kept.probe.label, kept?.relabelled("kept2") ?? -1);
    }
    writtenByArguments();
    clearedLinks();
    print("done");
}
