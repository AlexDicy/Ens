// @expect-error A test cannot have modifiers such as 'noreturn'; write 'test' at the start of the line
// A test declaration takes no modifiers. The parser is what reports it, and a file the parser
// rejects is never analyzed further, so this case is a fixture of its own.

noreturn test "a test cannot be noreturn" {
    panic("x");
}

main() -> int {
    return 0;
}
