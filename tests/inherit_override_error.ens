class Base {
    protected constructor();

    protected greet() -> int {
        return 1;
    }
}

class Derived extends Base {
    protected constructor();

    protected override speak() -> int {
        return 2;
    }
}

public class Animal {
    protected constructor();

    protected sound() -> int {
        return 1;
    }
}

public class Unmarked extends Animal {
    protected constructor();

    override sound() -> int {
        return 2;
    }
}

public class Wider extends Animal {
    protected constructor();

    public override sound() -> int {
        return 3;
    }
}

public class Loud {
    public constructor();

    public sound() -> int {
        return 1;
    }
}

public class Narrower extends Loud {
    public constructor();

    protected override sound() -> int {
        return 4;
    }
}

export class Wide {
    export constructor();

    export greet() -> int {
        return 1;
    }

    public wave() -> int {
        return 2;
    }

    export spin() -> int {
        return 3;
    }
}

class Capped extends Wide {
    protected constructor();

    export override greet() -> int {
        return 5;
    }
}

public class Counter extends Wide {
    public constructor();

    export override greet() -> int {
        return 6;
    }

    export override wave() -> int {
        return 7;
    }

    protected override spin() -> int {
        return 8;
    }
}

public class Plain extends Wide {
