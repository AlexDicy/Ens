// @expect-error Method 'speak' is marked 'override' but no base class or implemented interface declares it
// @expect-error Override 'sound' must carry the visibility of the method it overrides in 'Animal'; mark it 'protected'.
// @expect-error Override 'sound' is marked 'public', but the 'sound' it overrides in 'Animal' is 'protected'; an override carries the visibility of the method it overrides, so mark it 'protected'.
// @expect-error Override 'sound' is marked 'protected', but the 'sound' it overrides in 'Loud' is 'public'; an override carries the visibility of the method it overrides, so mark it 'public'.
// @expect-error Override 'greet' is marked 'export', but the 'greet' it overrides in 'Wide' is 'export' and 'Capped' is private to its file, so the override reaches at most 'protected'; mark it 'protected'.
// @expect-error Override 'wave' must carry the visibility of the method it overrides in 'Wide'; mark it 'protected'.
// @expect-error build failed with 6 problems
// 'override' names something real and carries the visibility of the method it replaces: the base
// method's own marker, capped at what the subclass itself can hold.

class Base {
    protected constructor();

    protected greet() -> int {
        return 1;
    }
}

class Derived extends Base {
    protected constructor();

    protected override speak() -> int {
        return 2;
    }
}

class Animal {
    protected constructor();

    protected sound() -> int {
        return 1;
    }
}

class Unmarked extends Animal {
    protected constructor();

    override sound() -> int {
        return 2;
    }
}

class Wider extends Animal {
    protected constructor();

    public override sound() -> int {
        return 3;
    }
}

public class Loud {
    public constructor();

    public sound() -> int {
        return 1;
    }
}

public class Narrower extends Loud {
    public constructor();

    protected override sound() -> int {
        return 4;
    }
}

export class Wide {
    export constructor();

    export greet() -> int {
        return 1;
    }

    public wave() -> int {
        return 2;
    }
}

class Capped extends Wide {
    protected constructor();

    export override greet() -> int {
        return 5;
    }

    override wave() -> int {
        return 6;
    }
}

main() -> int {
    return 0;
}
