// @expect-error 'Twice<int>' uses 'Twice<int?>', which uses 'Twice<int??>', and so on without end, so no program can contain a value of these types. The types grow because 'Twice' uses 'Twice<T?>', where its type parameter 'T' is inside another type. Change 'Twice<T?>' to 'Twice<T>'.
// @expect-error 'Twice<int>' uses 'Twice<int[]>', which uses 'Twice<int[][]>', and so on without end, so no program can contain a value of these types. The types grow because 'Twice' uses 'Twice<T[]>', where its type parameter 'T' is inside another type. Change 'Twice<T[]>' to 'Twice<T>'.
// @expect-error 'deeper<int>' calls 'deeper<int[]>', which calls 'deeper<int[][]>', and so on without end, so no program can contain all of these calls. The calls grow because 'deeper' calls 'deeper<T[]>', where its type parameter 'T' is inside another type.
// @expect-error 'ping<int>' calls 'pong<int?>', which calls 'ping<int?>', and so on without end, so no program can contain all of these calls. The calls grow because 'ping' calls 'pong<T?>', where its type parameter 'T' is inside another type.
// @expect-error build failed with 5 problems
// A polymorphically recursive template: every instantiation of Node needs a
// deeper one, so the chain never terminates. The compiler must report this
// rather than expand instantiations until the stack overflows.
class Node<T> {
    Node<Node<T>>? child;
}

// Two fields that each wrap the type parameter grow one chain each, and each is refused once.
class Twice<T> {
    Twice<T?>? first = null;
    Twice<T[]>? second = null;
}

// A generic function whose calls wrap its type parameter, directly or through another generic
// function, needs a larger instantiation for every one it has.
deeper<T>(T value, int depth) -> int {
    if (depth == 0) {
        return 0;
    }
    T[] wrapped = [value];
    return deeper<T[]>(wrapped, depth - 1);
}

ping<T>(T value, int steps) -> int {
    return pong<T?>(value, steps);
}

pong<U>(U value, int steps) -> int {
    return ping<U>(value, steps);
}

main() -> int {
    int calls = deeper<int>(1, 2) + ping<int>(1, 2);
    let n = new Node<int>();
    let t = new Twice<int>();
    return 0;
}
