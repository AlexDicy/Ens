// @expect-error 'Node<Node<T>>' uses 'Node<Node<Node<T>>>', which uses 'Node<Node<Node<Node<T>>>>', and so on without end, so no program can contain a value of type 'Node<Node<T>>'. Remove the type argument that refers back to 'Node<Node<T>>'.
// @expect-error 'Node<int>' uses 'Node<Node<int>>', which uses 'Node<Node<Node<int>>>', and so on without end, so no program can contain a value of type 'Node<int>'. Remove the type argument that refers back to 'Node<int>'.
// A polymorphically recursive template: every instantiation of Node needs a
// deeper one, so the chain never terminates. The compiler must report this
// rather than expand instantiations until the stack overflows.
class Node<T> {
    Node<Node<T>>? child;
}

main() -> int {
    let n = new Node<int>();
    return 0;
}
