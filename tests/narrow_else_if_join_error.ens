// @expect-error Cannot read a member of 'string?' because it may be null
// The negation an `else if` sees does not escape the chain on its own: the first
// branch falls through without proving anything, so the intersection of the paths
// reaching the code after the chain is empty and the value stays nullable there.
lookup(bool found) -> string? {
    if (found) {
        return "abc";
    }
    return null;
}

readAfterChain(bool found) -> long {
    let value = lookup(found);
    long length = 0;
    if (value == null) {
        length = 1;
    } else if (found) {
        length = 2;
    }
    return value.length + length;
}

main() -> int {
    print("{readAfterChain(true)}");
    return 0;
}
