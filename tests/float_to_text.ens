// @stdout hole 1.5 call 1.5 concat 1.5
// @stdout short 0.1 0.5 0.25
// @stdout faithful 0.3 0.33333334
// @stdout whole 3 0 -0 1234567
// @stdout exponent 1e-05 1e+21 1e+15
// @stdout plain 0.0001 999999
// @stdout widest 121.174034 108032.016
// @stdout special inf -inf nan
// @stdout array [0.1, 2.5]
// A float renders as the shortest decimal text that reads back as the same float, judged at float
// precision rather than at the precision of the double it would widen to. Every case the spec
// names is pinned here, because the format is the contract programs depend on.
main() -> int {
    float f = 1.5f;
    print("hole {f} call {f.toString()} concat " + f);

    print("short {0.1f} {0.5f} {0.25f}");

    // Read back as this float, so a sum that is exact in float text says so, where the same sum
    // in doubles reads 0.30000000000000004.
    print("faithful {0.1f + 0.2f} {1.0f / 3.0f}");

    // Nothing after the point means no point, and negative zero keeps its sign.
    print("whole {3.0f} {0.0f} {-0.0f} {1234567.0f}");

    // Below 1e-4, or once the exponent reaches the digits shown, the exponent form is used.
    print("exponent {1e-5f} {1e21f} {1e15f}");
    print("plain {0.0001f} {999999.0f}");

    // The few values that need all nine significant digits to read back.
    print("widest {121.174034f} {108032.016f}");

    float huge = 1e38f * 10.0f;
    float nan = huge - huge;
    print("special {huge} {-huge} {nan}");

    float[] many = [0.1f, 2.5f];
    print("array {many}");
    return 0;
}
