// @exit 0
// @stdout one
// @stdout caught: unknown code 3
// @stdout ada
// @stdout caught: unknown name
// @stdout 7
// @stdout caught: unknown flag
// @stdout released held
// @stdout 3
// @stdout released held
// @stdout caught: unknown word
// A 'throw' may stand where a value is read: a switch arm, the right side of '??', a branch of
// '?:' and an argument. It gives no value and takes no part in the type of what holds it, and it
// leaves the way a throwing call does, releasing what the expression around it already holds.
class Unknown extends Error {
    constructor(string what) {
        super("unknown {what}");
    }
}

class Tracked {
    const string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

pick(int code) -> string throws Unknown {
    return switch (code) {
        1 -> "one",
        2 -> "two",
        default -> throw new Unknown("code {code}"),
    };
}

named(string? name) -> string throws Unknown {
    return name ?? throw new Unknown("name");
}

checked(bool ok) -> string throws Unknown {
    int value = ok ? 7 : throw new Unknown("flag");
    return "{value}";
}

paired(Tracked first, string second) -> string {
    return "{second.length}";
}

// The object made for the first argument is held while the second is read, so the 'throw' there
// releases it before the error leaves.
held(string? word) -> string throws Unknown {
    return paired(new Tracked("held"), word ?? throw new Unknown("word"));
}

report((() -> string throws Unknown) produce) {
    print(try produce());
} catch (Unknown e) {
    print("caught: {e.message}");
}

main() -> int {
    report(() -> try pick(1));
    report(() -> try pick(3));
    report(() -> try named("ada"));
    report(() -> try named(null));
    report(() -> try checked(true));
    report(() -> try checked(false));
    report(() -> try held("abc"));
    report(() -> try held(null));
    return 0;
}
