// @stdout out: written through the writer
// @stdout the same reader from two modules: true
// @stdout the same reader twice here: true
// @stderr err: written through the writer
// @exit 0
// The four calls @std.io answers with, reached by importing the module: a writer for each of the
// two output streams, the one reader standard input is read through, and a flush.
import @std.io;
import probe;
import IoError from @std.io.streams;
import @std.system;

main() -> int {
    try io.out().write("out: written through the writer\n".toBytes());
    try io.flush();
    try io.err().write("err: written through the writer\n".toBytes());
    print("the same reader from two modules: {io.in() == probe.reader()}");
    print("the same reader twice here: {io.in() == io.in()}");
    return 0;
} catch (IoError failure) {
    system.writeError(failure.message);
    return 1;
}
