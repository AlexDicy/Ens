// @exit 35
// A type arm that binds no name narrows the switched value inside the arm when that value is a
// place that narrows, in the statement and the expression forms and through 'this'. An 'as?' cast
// narrows nothing, so its result is kept in a local or given a fallback.
sealed abstract class Shape {
    protected constructor();

    size() -> int {
        switch (this) {
            is Circle -> {
                return this.radius;
            },
            is Square -> {
                return this.side;
            },
        }
    }
}

final class Circle extends Shape {
    int radius;

    constructor(int radius) {
        this.radius = radius;
    }
}

final class Square extends Shape {
    int side;

    constructor(int side) {
        this.side = side;
    }
}

final class Holder {
    const Shape shape;

    constructor(Shape shape) {
        this.shape = shape;
    }
}

area(Shape shape) -> int {
    switch (shape) {
        is Circle -> {
            return 3 * shape.radius * shape.radius;
        },
        is Square -> {
            return shape.side * shape.side;
        },
    }
}

width(Shape shape) -> int {
    return switch (shape) {
        is Circle -> 2 * shape.radius,
        is Square -> shape.side,
    };
}

held(Holder holder) -> int {
    return switch (holder.shape) {
        is Circle -> holder.shape.radius,
        is Square -> holder.shape.side,
    };
}

kept(Shape shape) -> int {
    Circle? circle = shape as? Circle;
    if (circle != null) {
        return circle.radius;
    }
    let fallback = shape as? Circle ?? new Circle(0);
    return fallback.radius;
}

main() -> int {
    Shape circle = new Circle(2);
    Shape square = new Square(3);
    return area(circle) + area(square) + width(circle) + width(square) + held(new Holder(square))
        + circle.size() + kept(circle) + kept(square);
}
