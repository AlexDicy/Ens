// @expect-error Interface method 'produce' cannot declare type parameter 'R' of its own, because each implementing class overrides it, and a generic method is a separate method for each list of type arguments, so it cannot be overridden. Remove the '<...>' list, or declare 'produce' in each implementing class instead.
// @expect-error Method 'make' of 'Base' cannot be 'abstract', because it declares type parameter 'R' of its own, and a generic method cannot be overridden, so no subclass could supply its body. Give 'make' a body and remove 'abstract', or remove type parameter 'R' from the '<...>' list.
// @expect-error Method 'run' of 'Derived' cannot be 'override', because it declares type parameter 'R' of its own, and a generic method is a separate method for each list of type arguments, so it cannot replace a method of a base class. Remove type parameter 'R' from the '<...>' list, or remove 'override' and rename the method.
// @expect-error Method 'keep' of 'Derived' has the name of method 'keep' of 'Base', and a generic method cannot share its name with another method, even one of a base class. Rename this 'keep'.
// @expect-error 'U' is not a type parameter of 'Box', whose only type parameter is 'T'. A constructor of 'Box' can add bounds to 'T' in its '<...>' list, but cannot declare type parameters of its own. Rename 'U' to 'T', or remove 'U' from the list.
// @expect-error Method 'pick' of 'Box' declares type parameter 'R' twice. Rename the second one, as in 'pick<R, S>'.
// @expect-error Method 'empty' of 'Box' declares an empty type-parameter list '<>'. Remove '<>', or name a type parameter inside it, as in 'empty<U>'.
// @expect-error Method 'convert' of 'Box' cannot be overloaded, because one of its declarations is generic, and a generic method cannot share its name. Rename one of them.
// @expect-error 'named' is generic, and a call to a generic method cannot name its arguments. Pass them in order, as in 'plain.named(1, 2)'.
// @expect-error 'unshown' is generic, and this call does not show what its type argument 'T' is. Write it, as in 'plain.unshown<int>()'.
// @expect-error Generic method 'named' takes one type argument, but this call passes two. Remove the extra type argument.
// @expect-error 'hashed<double>' cannot hash a value of type 'double': a NaN, the value a calculation such as 0.0 / 0.0 produces, is not equal to any value, including itself, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Pass the number's 'toCanonicalBits() as long' instead, which gives every NaN the same hash and the two zeros different ones.
// @expect-note 'hashed<T>' calls 'hash()' on a value of type 'T' here
// @expect-error Type argument 'int' for type parameter 'R' of 'sorted' must implement interface 'Comparable<string>'. Replace 'int' with a type that implements 'Comparable<string>'.
// @expect-error build failed with 13 problems
// A generic method is a separate method for each list of type arguments, so it neither overrides
// nor is overridden, and shares its name with no other method. A constructor and an interface method
// declare no type parameters of their own, and a call is checked like a generic function's.
interface Source {
    produce<R>() -> R;
}

abstract class Base {
    run(int count) -> int {
        return count;
    }

    abstract make<R>(R seed) -> R;

    keep<R>(R value) -> R {
        return value;
    }
}

class Derived extends Base {
    override run<R>(int count) -> int {
        return count;
    }

    keep(int value) -> int {
        return value;
    }
}

class Box<T> {
    T value;

    constructor<U>(this.value);

    pick<R, R>(R first) -> R {
        return first;
    }

    empty<>() {
    }

    convert<R>(R item) -> R {
        return item;
    }

    convert(int count) -> int {
        return count;
    }

    sorted<R: Comparable<T>>(R item) -> R {
        return item;
    }
}

class Plain {
    named<T>(T first, T second) -> T {
        return first;
    }

    unshown<T>() -> T[] {
        return [];
    }

    hashed<T>(T value) -> long {
        return value.hash();
    }
}

main() -> int {
    let plain = new Plain();
    let first = plain.named(first: 1, second: 2);
    let none = plain.unshown();
    let counted = plain.named<int, int>(1, 2);
    let hashed = plain.hashed(1.5);
    let box = new Box<string>("text");
    let sorted = box.sorted(3);
    return 0;
}
