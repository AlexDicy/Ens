// @exit 0
// @stdout count 3
// @stdout sum 6
// @stdout bag count 3
// @stdout bag iterator 6
// @stdout bag loop 6
// @stdout iterable sum 6
// @stdout upcast sum 6
// @stdout class sum 6
// @stdout bound class 6
// @stdout bound interface 6
// @stdout bound bag 3:6
// @stdout is bag yes
// @stdout is bag no
// @stdout as bag 3
// @stdout as bag miss
// @stdout safe count 3
// @stdout safe iterator true
// @stdout switch bag of 3
// @stdout switch plain iterable
// @stdout wrapped first 1
// @stdout words red-green
// @stdout named crate
// @stdout labeled box
// @stdout tagged fragile
// @stdout deep name crate
// @stdout render [crate]
// @stdout render wide [[crate]]
// @stdout is tagged yes
// @stdout as labeled box
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

// The two-level ladder the collections protocol uses, over the real std Iterable.
public interface Bag<T> extends Iterable<T> {
    count() -> long;
}

public class Numbers implements Bag<int> {
    int[] items;

    protected constructor(this.items);

    public override count() -> long {
        return this.items.length;
    }

    public override makeIterator() -> Iterator<int> {
        return new NumberIterator(this.items);
    }
}

public class NumberIterator implements Iterator<int> {
    int[] items;
    long index;

    protected constructor(this.items) {
        this.index = 0;
    }

    public override hasNext() -> bool {
        return this.index < this.items.length;
    }

    public override next() -> int {
        int value = this.items[this.index];
        this.index = this.index + 1;
        return value;
    }
}

// Implements only the ancestor, so a runtime test against 'Bag<int>' misses.
public class Solo implements Iterable<int> {
    int[] items;

    protected constructor(this.items);

    public override makeIterator() -> Iterator<int> {
        return new NumberIterator(this.items);
    }
}

// The same ladder at another type argument.
public class Words implements Bag<string> {
    string[] items;

    protected constructor(this.items);

    public override count() -> long {
        return this.items.length;
    }

    public override makeIterator() -> Iterator<string> {
        return new WordIterator(this.items);
    }
}

public class WordIterator implements Iterator<string> {
    string[] items;
    long index;

    protected constructor(this.items) {
        this.index = 0;
    }

    public override hasNext() -> bool {
        return this.index < this.items.length;
    }

    public override next() -> string {
        string value = this.items[this.index];
        this.index = this.index + 1;
        return value;
    }
}

// A struct field instantiates 'Holder<Bag<int>>' before 'Bag' has resolved its members, so the
// deferred bound check must read the filled instantiation's flattened conformance.
public class Holder<T: Iterable<int>> {
    T source;

    protected constructor(this.source);

    public firstOf() -> int {
        let iterator = this.source.makeIterator();
        if (iterator.hasNext()) {
            return iterator.next();
        }
        return -1;
    }
}

struct Wrapper {
    Holder<Bag<int>>? boxed;
}

// A three-level chain, with an overload pair split across the ladder: 'render()' on Named and
// 'render(int)' on Labeled are distinct requirements.
public interface Named {
    name() -> string;
    render() -> string;
}

public interface Labeled extends Named {
    label() -> string;
    render(int width) -> string;
}

public interface Tagged extends Labeled {
    tag() -> string;
}

public class Crate implements Tagged {
    protected constructor();

    public override name() -> string {
        return "crate";
    }

    public override render() -> string {
        return "[crate]";
    }

    public override label() -> string {
        return "box";
    }

    public override render(int width) -> string {
        if (width > 1) {
            return "[[crate]]";
        }
        return "[crate]";
    }

    public override tag() -> string {
        return "fragile";
    }
}

// The bound names the ancestor; both a class and a sub-interface type argument satisfy it
// through the ladder.
sumThrough<S: Iterable<int>>(S source) -> int {
    let iterator = source.makeIterator();
    int total = 0;
    while (iterator.hasNext()) {
        total = total + iterator.next();
    }
    return total;
}

// The bound names the sub-interface; the inherited requirement is reached through the bound.
countThrough<B: Bag<int>>(B source) -> string {
    let iterator = source.makeIterator();
    int total = 0;
    while (iterator.hasNext()) {
        total = total + iterator.next();
    }
    return "{source.count()}:{total}";
}

drain(Iterable<int> source) -> int {
    int total = 0;
    for (let value in source) {
        total = total + value;
    }
    return total;
}

joinWords(Bag<string> bag) -> string {
    string joined = "";
    for (let word in bag) {
        if (joined.length > 0) {
            joined = joined + "-";
        }
        joined = joined + word;
    }
    return joined;
}

deepName(Named named) -> string {
    return named.name();
}

describeSource(Iterable<int> source) -> string {
    switch (source) {
        is Bag<int> bag -> {
            return "bag of {bag.count()}";
        }
        default -> {
            return "plain iterable";
        }
    }
}

main() -> int {
    let numbers = new Numbers([1, 2, 3]);
    print("count {numbers.count()}");

    int direct = 0;
    for (let value in numbers) {
        direct = direct + value;
    }
    print("sum {direct}");

    // The sub-interface value answers its own requirement and the inherited one.
    Bag<int> bag = numbers;
    print("bag count {bag.count()}");
    let iterator = bag.makeIterator();
    int viaIterator = 0;
    while (iterator.hasNext()) {
        viaIterator = viaIterator + iterator.next();
    }
    print("bag iterator {viaIterator}");
    int viaLoop = 0;
    for (let value in bag) {
        viaLoop = viaLoop + value;
    }
    print("bag loop {viaLoop}");

    // Upcasts: the class value and the sub-interface value both convert to the ancestor.
    Iterable<int> iterable = numbers;
    Iterable<int> fromBag = bag;
    print("iterable sum {drain(iterable)}");
    print("upcast sum {drain(fromBag)}");
    print("class sum {drain(numbers)}");

    print("bound class {sumThrough<Numbers>(numbers)}");
    print("bound interface {sumThrough<Bag<int>>(bag)}");
    print("bound bag {countThrough<Numbers>(numbers)}");

    // 'is' and 'as?' through the ladder, decided by the runtime type.
    if (fromBag is Bag<int>) {
        print("is bag yes");
    }
    Iterable<int> solo = new Solo([4]);
    if (solo is Bag<int>) {
        print("is bag yes");
    } else {
        print("is bag no");
    }
    Bag<int>? back = fromBag as? Bag<int>;
    if (back != null) {
        print("as bag {back.count()}");
    }
    Bag<int>? miss = solo as? Bag<int>;
    if (miss == null) {
        print("as bag miss");
    }

    // '?.' on a nullable sub-interface receiver reaches both rungs.
    Bag<int>? maybe = numbers;
    print("safe count {maybe?.count() ?? -1}");
    let safeIterator = maybe?.makeIterator();
    if (safeIterator != null) {
        print("safe iterator {safeIterator.hasNext()}");
    }

    // A type switch tests a sub-interface arm over an ancestor-typed scrutinee.
    print("switch {describeSource(bag)}");
    print("switch {describeSource(solo)}");

    Wrapper wrapper = {boxed: new Holder<Bag<int>>(bag)};
    let boxed = wrapper.boxed;
    if (boxed != null) {
        print("wrapped first {boxed.firstOf()}");
    }

    let words = new Words(["red", "green"]);
    print("words {joinWords(words)}");

    // The three-level chain: every rung's requirements dispatch through every rung's type.
    let crate = new Crate();
    Tagged tagged = crate;
    Labeled labeled = tagged;
    Named named = labeled;
    print("named {named.name()}");
    print("labeled {labeled.label()}");
    print("tagged {tagged.tag()}");
    print("deep name {deepName(tagged)}");
    print("render {tagged.render()}");
    print("render wide {tagged.render(2)}");
    if (named is Tagged) {
        print("is tagged yes");
    }
    Labeled? asLabeled = named as? Labeled;
    if (asLabeled != null) {
        print("as labeled {asLabeled.label()}");
    }
    return 0;
}
