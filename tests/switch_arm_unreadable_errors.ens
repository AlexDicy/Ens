// @expect-error Expected a switch arm, for example '1 -> handleOne()'
// @expect-error Expected '->' after the switch labels, for example '1 -> handleOne()'
// @expect-error build failed with 2 problems
// An arm the parser cannot read still takes the shape of an arm, and still takes a separator after
// it, so the arms stay the list of pairs their slots assume. That is what keeps the checker walking
// a switch whose arms it can reason about and reporting the syntax error, instead of tripping over
// a slot holding something no arm could.
main() -> int {
    int value = 1;
    long tag = switch (value) {
        1 -> 1,
        ? -> 2,
        default -> 0,
    };
    print("tag " + tag);
    return 0;
}
