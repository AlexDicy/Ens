// @exit 0
// @stdout panic: tried to read from '<scratch>/closed.txt' after it was closed. Call read() before close(), or open the file again
// @stdout panic: tried to write to '<scratch>/closed.txt' after it was closed. Call write() before close(), or open the file again
// @stdout panic: tried to flush '<scratch>/closed.txt' after it was closed. Call flush() before close(), or open the file again
// A closed file has handed its handle back, so reading, writing or flushing it is a mistake in the
// program. Each use panics in a child of its own, and the parent prints the panic each child
// reports, with the scratch folder written as a placeholder.
import File from @std.fs.file;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import @std.environment;
import @std.process;

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length == 2) {
        return useAfterClose(arguments[0], Path(arguments[1]));
    }
    Path? self = environment.executablePath();
    if (self == null) {
        print("this system did not report the path of this program");
        return 1;
    }
    let scratch = try TemporaryDirectory.create("ens-use-after-close");
    Path file = scratch.path().join("closed.txt");
    try file.writeText("closed");
    for (let use in ["read", "write", "flush"]) {
        let ran = try process.run(self, [use, file.toString()], captureOutput: true);
        string[] reported = ran.stderr.lines();
        string first = "nothing";
        if (reported.length > 0) {
            first = reported[0];
        }
        print(first.replace(scratch.path().toString(), "<scratch>"));
    }
    return 0;
} catch (Error unexpected) {
    print(unexpected.message);
    return 1;
}

// Closes the file and then makes the use `use` names of it, which panics.
useAfterClose(string use, Path path) -> int {
    let opened = try path.append();
    try opened.close();
    switch (use) {
        "read" -> {
            byte[] buffer = new byte[4];
            let count = try opened.read(buffer);
        },
        "write" -> {
            try opened.write("late".toBytes());
        },
        default -> {
            try opened.flush();
        },
    }
    return 0;
} catch (Error unexpected) {
    print(unexpected.message);
    return 1;
}
