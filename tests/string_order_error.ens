// @expect-error Argument 1: expected 'string', got 'int'
// @expect-error Method 'compareTo' expects 1 argument(s), got 0
// @expect-error Operator '<' cannot be applied to 'string' and 'string'
// Ordering a string takes exactly one string to compare against, and strings carry no relational
// operators: compareTo is the only way to order them.
main() -> int {
    print("a".compareTo(5).toString());
    print("a".compareTo().toString());
    if ("a" < "b") {
        print("never");
    }
    return 0;
}
