// Ordering a string takes exactly one string to compare against.
// Strings carry no relational operators.
// 'compareTo' orders them instead.
// The example spells it with the operands' own names.
// A string that can be null needs a null check before 'compareTo', once for each '?'.
// A field needs a local copy for that check.
// A call's result needs a local to be stored in.
// Two such locals of one name get 'left' and 'right' names.
class Tally {
    protected string? title = "a";

    protected constructor();
}

find() -> string? {
    return "a";
}

order(string? label, string word, string?? deep, Tally t) {
    bool before = label < word;
    bool after = word >= label;
    bool same = label <= label;
    bool nested = deep > word;
    bool field = t.title < word;
    bool called = find() < word;
    bool pair = find() < find();
}

main() -> int {
    print("a".compareTo(5).toString());
    print("a".compareTo().toString());
    if ("a" < "b") {
        print("never");
    }
    order(null, "a", null, new Tally());
    return 0;
}
