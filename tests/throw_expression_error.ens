// @expect-error This 'throw' gives no value, so it cannot be used with '+'. Write it as a statement of its own, as in 'throw new Unknown();'.
// @expect-error This 'throw' gives no value, so it cannot fill an interpolation hole. Write it as a statement of its own, as in 'throw new Unknown();', and remove '{throw new Unknown()}' from the string.
// @expect-error Cannot throw a value of type 'string'. Only an 'Error', or an object of a subclass of 'Error', can be thrown. Throw an object of a class that extends 'Error' instead.
// @expect-error 'unlisted' can throw 'Unknown' but is not marked 'throws'. Add 'throws Unknown' after the signature, or catch it with a 'catch' clause after the body.
// @expect-error build failed with 4 problems
// A 'throw' gives no value, so it is refused where nothing states the type it would take, and it
// throws under the same rules as the statement does.
class Unknown extends Error {
    constructor() {
        super("unknown");
    }
}

sum(int a) -> int throws Unknown {
    return a + throw new Unknown();
}

hole() -> string throws Unknown {
    return "value {throw new Unknown()}";
}

notError(int code) -> int {
    return code > 0 ? code : throw "no";
}

export unlisted(int code) -> int {
    return code > 0 ? code : throw new Unknown();
}

main() -> int {
    return 0;
}
