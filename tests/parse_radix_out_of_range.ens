// @exit 134
// @stderr-contains panic: tried to read a number in radix 1, and a radix runs from 2 to 36. Check the radix first
// A base below two has no digits to read, so a parser asked for one aborts rather than answering
// null: the radix is the caller's own, where the text is the data.
import @std.text.parse;

main() -> int {
    let value = parse.parseLong("1", 1);
    return value == null ? 1 : 0;
}
