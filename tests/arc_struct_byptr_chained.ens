// @exit 33
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

struct Container {
    protected Box b = new Box();
}

innerRead(Container c) -> int {
    return c.b.v;
}

outerRead(Container c) -> int {
    return innerRead(c);
}

main() -> int {
    Container c = {};
    c.b.v = 33;
    return outerRead(c);
}
