// @exit 32
// Exported symbols cross the package boundary: the class and struct import by name, their
// exported members are callable, and a protected member of the exported non-final class is
// reachable from an external subclass. A 'this.field' parameter writes the field it names, so
// the subclass reaches the base class's protected field through one too.
import Counter from @acme.tools.counter;
import Badge from @acme.tools.counter;

class SeededCounter extends Counter {
    protected constructor(this.step) {
        super();
    }

    protected boost() {
        this.add(this.seed() + this.step);
    }
}

main() -> int {
    let counter = new SeededCounter(2);
    counter.add(16);
    counter.boost();
    Badge badge = {label: "gold", stars: 7};
    return (counter.value() + badge.stars) as int;
}
