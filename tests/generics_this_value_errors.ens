// @expect-error Argument 1: expected 'Box<int>', got 'Box<T>'
// @expect-error Cannot assign 'Box<T>' to 'Box<int>?'
// @expect-error Cannot return value of type 'Box<T>' from function returning 'Box<int>'
// @expect-error Argument 1: expected 'Pair<string, int>', got 'Pair<K, V>'
// @expect-error Argument 2: expected 'Box<T>', got 'Box<int>'. 'T' was inferred as 'Box<T>' from argument 1; pass the type arguments explicitly, as in 'first<T>(...)'.
// @expect-error build failed with 6 problems
// Inside a generic body `this` is the class at its own type parameters, and a diagnostic spells
// it that way: 'Box<T>', never a bare 'Box'. A generic function infers its parameter from `this`
// as that type, so another instantiation in the same slot is the mismatch.

public class Box<T> {
    protected T value;

    public constructor(this.value);

    protected describe() -> string {
        return label(this);
    }

    protected hold() -> Holder<int> {
        return new Holder<int>(this);
    }

    protected keep(Keeper<int> keeper) {
        keeper.kept = this;
    }

    protected asInt() -> Box<int> {
        return this;
    }

    protected mixed() -> Box<T> {
        return first(this, new Box<int>(1));
    }
}

public class Holder<T> {
    Box<T> held;

    public constructor(this.held);
}

public class Keeper<T> {
    public Box<T>? kept;

    public constructor() {
        this.kept = null;
    }
}

public class Pair<K, V> {
    protected K key;
    protected V value;

    public constructor(this.key, this.value);

    protected describe() -> string {
        return name(this);
    }
}

label(Box<int> box) -> string {
    return "box";
}

name(Pair<string, int> pair) -> string {
    return "pair";
}

first<T>(T one, T two) -> T {
    return one;
}

main() -> int {
    let number = new Box<int>(7);
    print(number.describe());
    let pair = new Pair<string, int>("seven", 7);
    print(pair.describe());
    return 0;
}
