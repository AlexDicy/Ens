// @expect-error Argument 1 of 'label' has type 'Box<T>', but parameter 'box' has type 'Box<int>'.
// @expect-error 'keeper.kept' has type 'Box<int>?', but the value assigned to it has type 'Box<T>'.
// @expect-error Method 'asInt' returns 'Box<int>', but this value has type 'Box<T>'.
// @expect-error Argument 1 of 'name' has type 'Pair<K, V>', but parameter 'pair' has type 'Pair<string, int>'.
// @expect-error Argument 2 of 'first' has type 'Box<int>', but parameter 'two' has type 'Box<T>'. 'T' is 'Box<T>' in this call, taken from argument 1. To choose it yourself, write 'first<Box<T>>(...)' and change 'Box<T>' to the type you want.
// @expect-error build failed with 6 problems
// Inside a generic body `this` is the class at its own type parameters, and a diagnostic spells
// it that way: 'Box<T>', never a bare 'Box'. A generic function infers its parameter from `this`
// as that type, so another instantiation in the same slot is the mismatch.

public class Box<T> {
    protected T value;

    public constructor(this.value);

    protected describe() -> string {
        return label(this);
    }

    protected hold() -> Holder<int> {
        return new Holder<int>(this);
    }

    protected keep(Keeper<int> keeper) {
        keeper.kept = this;
    }

    protected asInt() -> Box<int> {
        return this;
    }

    protected mixed() -> Box<T> {
        return first(this, new Box<int>(1));
    }
}

public class Holder<T> {
    Box<T> held;

    public constructor(this.held);
}

public class Keeper<T> {
    public Box<T>? kept;

    public constructor() {
        this.kept = null;
    }
}

public class Pair<K, V> {
    protected K key;
    protected V value;

    public constructor(this.key, this.value);

    protected describe() -> string {
        return name(this);
    }
}

label(Box<int> box) -> string {
    return "box";
}

name(Pair<string, int> pair) -> string {
    return "pair";
}

first<T>(T one, T two) -> T {
    return one;
}

main() -> int {
    let number = new Box<int>(7);
    print(number.describe());
    let pair = new Pair<string, int>("seven", 7);
    print(pair.describe());
    return 0;
}
