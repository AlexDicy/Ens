// @exit 42
// A 'null' branch or arm beside a 'T' one yields 'T?'; 'T' beside 'T?' stays 'T?'.
class Door {
    int code;
    Door(this.code = 0);
}

main() -> int {
    bool yes = true;
    bool no = false;
    int score = 0;

    // string with null, in either branch position.
    string? s1 = yes ? "first" : null;
    string? s2 = yes ? null : "second";
    score = score + ((s1 ?? "").length as int);   // +5
    if (s2 == null) { score = score + 1; }        // +1 -> 6

    // class with null.
    Door? d = no ? new Door(9) : null;
    if (d == null) { score = score + 2; }         // +2 -> 8

    // Value-type optional: the non-null branch wraps to 'int?'.
    int? n1 = yes ? 5 : null;
    int? n2 = no ? 6 : null;
    int? n3 = yes ? null : 7;
    score = score + (n1 ?? 0);                    // +5 -> 13
    score = score + (n2 ?? 8);                    // +8 -> 21
    score = score + (n3 ?? 9);                    // +9 -> 30

    // T beside T?: the result stays nullable.
    int? maybe = 3;
    int? n4 = yes ? maybe : 4;
    score = score + (n4 ?? 0);                    // +3 -> 33

    // Switch-expression arms unify a null arm the same way.
    int k = 2;
    string? w = switch (k) {
        1 -> "one",
        2 -> "two",
        default -> null,
    };
    if (w != null) { score = score + (w.length as int); } // +3 -> 36

    int? m = switch (k) {
        2 -> null,
        default -> 30,
    };
    if (m == null) { score = score + 6; }         // +6 -> 42

    return score;
}
