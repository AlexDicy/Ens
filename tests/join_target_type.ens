// @exit 0
// @stdout drag
// @stdout tap
// @stdout tap drag pinch
// @stdout none
// The arms of a switch and the branches of a '?:' that share no class each convert to the type
// the place reading them states: a declared variable, an argument, a return type and a nullable
// variable.
interface Interaction {
    name() -> string;
}

class Tap implements Interaction {
    override name() -> string {
        return "tap";
    }
}

class Drag implements Interaction {
    override name() -> string {
        return "drag";
    }
}

class Pinch implements Interaction {
    override name() -> string {
        return "pinch";
    }
}

describe(Interaction chosen) -> string {
    return chosen.name();
}

pick(int code) -> Interaction {
    return switch (code) {
        0 -> new Tap(),
        1 -> new Drag(),
        default -> new Pinch(),
    };
}

main() -> int {
    bool tapped = false;
    Interaction chosen = tapped ? new Tap() : new Drag();
    print(chosen.name());
    print(describe(!tapped ? new Tap() : new Drag()));
    print(pick(0).name() + " " + pick(1).name() + " " + pick(2).name());
    Interaction? maybe = tapped ? new Tap() : null;
    print(maybe == null ? "none" : "some");
    return 0;
}
