// @exit 134
// @stderr-contains panic: tried to await a task whose outcome another 'await' already took. A result or an error that another task may not hold is taken once, so keep what the first 'await' gave
// A result another task may not hold, such as a list, belongs to whoever awaits it first, so a second
// 'await' aborts the program.
import @std.tasks;
import Cancelled from @std.tasks;
import List from @std.collections.list;

main() -> int throws Cancelled {
    try tasks.scope((scope) -> {
        let made = scope.start(() -> List.of([1]));
        let first = try made.await();
        let second = try made.await();
    });
    return 0;
}
