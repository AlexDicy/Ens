// @exit 33
class Box {
    int v;
    constructor(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(10), new Box(20), null];
    int score = 0;

    // 1. Literal index narrowing.
    if (xs[0] != null) {
        score = score + xs[0].v;    // +10
    }

    // 2. Identifier index narrowing.
    int i = 1;
    if (xs[i] != null) {
        score = score + xs[i].v;    // +20
    }

    // 3. Index reassignment drops the narrowing inside the block.
    int j = 0;
    if (xs[j] != null) {
        score = score + xs[j].v;    // +10
        j = 1;                       // index variable reassigned
        if (xs[j] != null) {         // re-check under new index
            score = score + xs[j].v; // +20 -> total 60
        }
    }

    // 4. Else branch on equality.
    if (xs[2] == null) {
        score = score - 7;          // 60 - 7 = 53
    } else {
        score = score + xs[2].v;
    }

    // Goal: 53 - 20 = 33. The block 3 above bumps to 60, then 60 - 27 = 33.
    return score - 20;
}