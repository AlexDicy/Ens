// @exit 33
// An array element is never narrowed, since another reference to the array can write it between
// a check and a use, so each read goes through a local copy of the element, which narrows like
// any local: at a literal index, at an identifier index, after the index changes, and in the else
// branch of an equality check.
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(10), new Box(20), null];
    int score = 0;

    // 1. A copy of the element at a literal index.
    let first = xs[0];
    if (first != null) {
        score = score + first.v;    // +10
    }

    // 2. A copy of the element at an identifier index.
    int i = 1;
    let second = xs[i];
    if (second != null) {
        score = score + second.v;   // +20
    }

    // 3. A new index reads a new copy.
    int j = 0;
    let atJ = xs[j];
    if (atJ != null) {
        score = score + atJ.v;      // +10
        j = 1;
        let moved = xs[j];
        if (moved != null) {
            score = score + moved.v; // +20 -> total 60
        }
    }

    // 4. Else branch on equality.
    let third = xs[2];
    if (third == null) {
        score = score - 7;          // 60 - 7 = 53
    } else {
        score = score + third.v;
    }

    // Goal: 53 - 20 = 33.
    return score - 20;
}
