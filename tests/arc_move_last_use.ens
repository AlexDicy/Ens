// @exit 1
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

class Tag {
    protected int v;
    protected constructor(this.v);
}

class WideTag extends Tag {
    protected constructor(int v) {
        super(v);
    }
}

// A read inside a '!' prefix or an interpolation hole still counts as a use, so the earlier
// copy into 'held' must not steal the local's reference.
useAfterCopyStaysValid() -> int {
    Tag tag = new WideTag(7);
    Tag held = tag;
    if (!(tag is WideTag)) {
        return 0;
    }
    string shown = "tag {tag.v}";
    held = new Tag(1);
    if (shown == "tag 7") {
        return 1;
    }
    return 0;
}

main() -> int {
    Box? x = null;
    {
        let z = new Box();
        z.v = 99;
        x = z;
    }
    if (x == null) {
        return 0;
    }
    return useAfterCopyStaysValid();
}