// @exit 1
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

class Tag {
    protected int v;
    protected constructor(this.v);
}

class WideTag extends Tag {
    protected constructor(int v) {
        super(v);
    }
}

// A read inside a '!' prefix or an interpolation hole still counts as a use, so the earlier
// copy into 'held' must not steal the local's reference.
useAfterCopyStaysValid() -> int {
    Tag tag = new WideTag(7);
    Tag held = tag;
    if (!(tag is WideTag)) {
        return 0;
    }
    string shown = "tag {tag.v}";
    held = new Tag(1);
    if (shown == "tag 7") {
        return 1;
    }
    return 0;
}

// The first argument reads 'message' at +0, so the local's own reference is what keeps it valid
// for the call. The second argument hands that same local's reference on to the string it builds
// and gives it up again as soon as it has, all before the call runs, so a copy that stole the
// local's reference here would leave the first argument reading a freed string.
borrowedArgumentSurvivesItsCopy() -> int {
    string message = "abcdefghijklmnopqrst" + "uvwxyz0123456789ABCD";
    return readBoth(message, "note: {message}");
}

readBoth(string first, string second) -> int {
    // Allocated before the arguments are read and exactly as long as 'message', so a freed
    // 'message' is handed straight back out here and a stale first argument reads this instead.
    string reused = "12345678901234567890" + "12345678901234567890";
    if (first != "abcdefghijklmnopqrstuvwxyz0123456789ABCD") {
        return 0;
    }
    if (second != "note: abcdefghijklmnopqrstuvwxyz0123456789ABCD") {
        return 0;
    }
    if (reused.length != 40) {
        return 0;
    }
    return 1;
}

main() -> int {
    Box? x = null;
    {
        let z = new Box();
        z.v = 99;
        x = z;
    }
    if (x == null) {
        return 0;
    }
    if (useAfterCopyStaysValid() != 1) {
        return 0;
    }
    return borrowedArgumentSurvivesItsCopy();
}