// @expect-error An array of non-nullable 'Box' must be filled as it is created
// The fill loop must be the statement immediately after the declaration.
class Box {
    int v;
    constructor(this.v);
}

main() -> int {
    Box[] boxes = new Box[2];
    print("between");
    for (long i = 0; i < boxes.length; i = i + 1) {
        boxes[i] = new Box(1);
    }
    return 0;
}
