// @exit 134
// @stdout length 1
// @stderr-contains panic: list index 2 is out of bounds for length 1
// A list's backing store runs to its capacity, so a slot between the length and the capacity is
// inside the array and holds nothing the list was given. Reading one aborts in the list's own
// words rather than answering with whatever the slot holds.
import List from @std.collections.list;

class Item {
    string text;

    protected constructor(this.text);

    protected label() -> string {
        return this.text;
    }
}

main() -> int {
    let items = new List<Item>();
    items.push(new Item("first"));
    print("length {items.length()}");
    return items.get(2).label().length as int;
}
