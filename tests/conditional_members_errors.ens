interface Speaker {
    speak() -> string;
}

interface Sortable<T> {
    compareTo(T other) -> int;
}

class Talker implements Speaker {
    protected constructor();

    override speak() -> string {
        return "hi";
    }
}

class Mute {
    protected constructor();
}

class Crate<T> {
    T kept;

    protected constructor(this.kept);

    tag<T>() -> string {
        return "tag";
    }

    pick<U: Speaker>() -> string {
        return "pick";
    }

    both<T: Speaker, T: Speaker>() {
    }

    protected unconditionalLabel() -> string {
        Tag2<T> tag = {value: this.kept};
        return tag.label();
    }

    protected describeTag(Tag3<T> tag) -> string {
        return tag.label3();
    }
}

struct Tag2<T> {
    protected T value;

    protected label() -> string {
        return "{this.value}";
    }
}

// Mentioned only in the SIGNATURE of an unconditional member; its obligation still replays.
struct Tag3<T> {
    protected T value;

    protected label3() -> string {
        return "{this.value}";
    }
}

class Plain {
    protected constructor();

    pick<T: Speaker>() -> string {
        return "pick";
    }
}

class Box<T> {
    T item;

    protected constructor(this.item);

    protected shout<T: Speaker>() -> string {
        return this.item.speak();
    }

    describeLoud() -> string {
        return this.shout();
    }

    protected static loudest<T: Speaker>(T value) -> T {
        return value;
    }

    protected static noisiest<T: Speaker>(T value) -> string {
        return value.speak();
    }
}

class Chorus<T> {
    long size;

    protected constructor<T: Speaker>() {
        this.size = 0;
    }

    protected constructor(long capacity) {
        this.size = capacity;
    }
}

interface Node<T> {
    label<T: Speaker>() -> string;
}

class Holder<T> {
    T kept;

    protected constructor(this.kept);

    destructor<T: Speaker>() {
    }
}

class Base2<T> {
    protected constructor();

    label() -> string {
        return "base";
    }
}

class Derived2<T> extends Base2<T> {
    protected constructor();

    override label<T: Speaker>() -> string {
        return "derived";
    }
}

class Base3<T> {
    protected constructor();

    pickMe<T: Speaker>() -> string {
        return "base";
    }
}

class Derived3<T> extends Base3<T> {
    protected constructor();

    pickMe() -> string {
        return "derived";
    }
}

class Derived4<T> extends Base3<T> {
    protected constructor();

    override pickMe() -> string {
        return "derived4";
    }
}

class Chime<T> implements Speaker {
    protected constructor();

    speak<T: Sortable<T>>() -> string {
        return "chime";
    }
}

abstract class Vessel<T> {
    abstract fill<T: Speaker>();
}

class BaseOnly<T> {
    protected constructor<T: Speaker>() {
    }
}

class DerivedOpen<T> extends BaseOnly<T> {
    protected constructor() {
    }
}

class DerivedConcrete extends BaseOnly<Mute> {
    protected constructor() {
    }
}

class DerivedBare extends BaseOnly<Mute> {
}

// Declaration order decides the implicit choice: the excluded all-defaulted constructor comes
// first, so the existing all-defaulted one after it can never be the implicit chain's winner.
class DefaultedBase<T> {
    protected constructor<T: Speaker>(int x = 0) {
    }

    protected constructor(int a = 0, int b = 0) {
    }
}

class DefaultedDerived<T> extends DefaultedBase<T> {
    protected constructor() {
    }
}

class DefaultedBare<T> extends DefaultedBase<T> {
}

class Boom extends Error {
    protected constructor() {
        super("boom");
    }
}

class Boom2 extends Error {
    protected constructor() {
        super("boom2");
    }
}

interface Alarm {
    ring() -> string throws Boom;
}

// The conformance rejection is the only diagnostic here: the exceptions phase must not also
// hold the conditional 'ring' to the interface's throws contract it can never satisfy.
class Siren<T> implements Alarm {
    protected constructor();

    ring<T: Sortable<T>>() -> string throws Boom2 {
        return "chime";
    }
}

main() -> int {
    let box = new Box<Mute>(new Mute());
    let silent = box.shout();
    let quiet = Box<Mute>.loudest(new Mute());
    let inferred = Box.noisiest(new Mute());
    let missing = new Chorus<Mute>();
    let bare = new DerivedBare();
    let bareDefaulted = new DefaultedBare<Mute>();
    let crates = new Crate<int[]>(new int[1]);
    return 0;
}
