// @exit 0
// @stdout inner moved
// @stdout inner done
// @stdout released moved
// @stdout show passed
// @stdout passed done
// @stdout released passed
// @stdout returned returned
// @stdout released returned
// @stdout stored done
// @stdout released stored
// @stdout loop loop0
// @stdout loop 0 done
// @stdout released loop0
// @stdout loop loop1
// @stdout loop 1 done
// @stdout released loop1
// @stdout deep deep
// @stdout deep done
// @stdout released deep
// @stdout named named
// @stdout named done
// @stdout released named
// @stdout watched watched
// @stdout watched alive true
// An object a local refers to is destroyed when the last local holding it goes out of scope, at
// every optimization level: a copy into an inner local, an argument, a field or a loop variable
// keeps the outer local's reference, and so does a struct that holds the object deep inside or an
// interface the object is held through. A returned local hands its reference to the caller. A
// weak field watching an object reads it as alive until then.
class Probe {
    string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

class Plain {
    string label;

    constructor(this.label);
}

interface Named {
    name() -> string;
}

class Guard implements Named {
    string label;

    constructor(this.label);

    override name() -> string {
        return this.label;
    }

    destructor() {
        print("released " + this.label);
    }
}

struct Inner {
    Probe probe;
}

struct Outer {
    Inner inner;
}

class Deep {
    Outer outer;

    constructor(this.outer);
}

class Keeper {
    Probe? kept;

    constructor() {
        this.kept = null;
    }
}

class Watcher {
    weak Plain? watched;

    constructor() {
        this.watched = null;
    }
}

show(Probe probe) {
    print("show " + probe.label);
}

moved() {
    Probe p = new Probe("moved");
    {
        Probe q = p;
        print("inner " + q.label);
    }
    print("inner done");
}

passed() {
    Probe p = new Probe("passed");
    show(p);
    print("passed done");
}

returnedLocal() -> Probe {
    Probe p = new Probe("returned");
    return p;
}

stored(Keeper keeper) {
    Probe p = new Probe("stored");
    keeper.kept = p;
    keeper.kept = null;
    print("stored done");
}

looped() {
    for (int i = 0; i < 2; i++) {
        Probe p = new Probe("loop{i}");
        {
            Probe q = p;
            print("loop " + q.label);
        }
        print("loop {i} done");
    }
}

deep() {
    Deep d = new Deep({inner: {probe: new Probe("deep")}});
    {
        Deep e = d;
        print("deep " + e.outer.inner.probe.label);
    }
    print("deep done");
}

named() {
    Named n = new Guard("named");
    {
        Named m = n;
        print("named " + m.name());
    }
    print("named done");
}

watched() {
    let watcher = new Watcher();
    Plain p = new Plain("watched");
    watcher.watched = p;
    {
        Plain q = p;
        print("watched " + q.label);
    }
    print("watched alive {watcher.watched != null}");
}

main() -> int {
    moved();
    passed();
    {
        let r = returnedLocal();
        print("returned " + r.label);
    }
    stored(new Keeper());
    looped();
    deep();
    named();
    watched();
    return 0;
}
