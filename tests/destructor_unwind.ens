// @exit 0
// @stdout create direct
// @stdout destroy direct
// @stdout caught direct
// @stdout create inner
// @stdout destroy inner
// @stdout destroy derived guard
// @stdout destroy base guard
// @stdout caught propagated
// @stdout create local
// @stdout destroy local
// @stdout handled after body cleanup
// @stdout all done
// A guard local's destructor runs when a throw unwinds its frame: the frame that throws,
// every frame the exception propagates through, and the catching function's body before
// its catch clause runs. An inherited destructor chain keeps its most-derived-first order
// on the unwind path.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Guard {
    protected string name;

    protected constructor(this.name) {
        print("create " + this.name);
    }

    destructor() {
        print("destroy " + this.name);
    }
}

class BaseGuard {
    protected constructor();

    destructor() {
        print("destroy base guard");
    }
}

class DerivedGuard extends BaseGuard {
    protected constructor() {
        super();
    }

    destructor() {
        print("destroy derived guard");
    }
}

fail() throws {
    throw new Failure("boom");
}

throwsWithGuard() throws {
    let directGuard = new Guard("direct");
    throw new Failure("boom");
}

attemptDirect() {
    try throwsWithGuard();
} catch (Failure e) {
    print("caught direct");
}

inner() throws {
    let innerGuard = new Guard("inner");
    try fail();
}

middle() throws {
    let middleGuard = new DerivedGuard();
    try inner();
}

attemptPropagated() {
    try middle();
} catch (Failure e) {
    print("caught propagated");
}

handleLocally() {
    let localGuard = new Guard("local");
    try fail();
} catch (Failure e) {
    print("handled after body cleanup");
}

main() -> int {
    attemptDirect();
    attemptPropagated();
    handleLocally();
    print("all done");
    return 0;
}
