// @exit 0
// @stdout picked 1,2
// @stdout other 3,4
// @stdout row 7
// @stdout nested 9
// @stdout element null
// @stdout chained 9
// The safe subscript is '?[' with the two characters adjacent, exactly as '??' is two adjacent
// question marks. A '?' with a space after it begins a conditional instead, so a conditional whose
// branches are array literals is writable, while every adjacent spelling keeps indexing.
show(int[] values) -> string {
    return "" + values[0] + "," + values[1];
}

class Rows {
    protected int[]? first;
    protected int[]?[] grid;

    protected constructor(this.first, this.grid);

    protected head() -> int? {
        return this.first?[0];
    }

    protected cell(long row, long column) -> int? {
        return this.grid[row]?[column];
    }
}

main() -> int {
    bool pick = true;
    int[] picked = pick ? [1, 2] : [3, 4];
    print("picked " + show(picked));
    int[] other = !pick ? [1, 2] : [3, 4];
    print("other " + show(other));

    let rows = new Rows([7, 8], [[8, 9], null]);
    let head = rows.head();
    if (head == null) {
        print("row null");
    } else {
        print("row " + head);
    }
    let nested = rows.cell(0, 1);
    if (nested == null) {
        print("nested null");
    } else {
        print("nested " + nested);
    }
    let missing = rows.cell(1, 0);
    if (missing == null) {
        print("element null");
    } else {
        print("element " + missing);
    }

    // A conditional whose branches are an array literal and 'null', safe-subscripted.
    int[]? maybe = pick ? [9, 10] : null;
    let chained = maybe?[0];
    if (chained == null) {
        print("chained null");
    } else {
        print("chained " + chained);
    }
    return 0;
}
