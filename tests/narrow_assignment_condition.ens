// @stdout walk 6
// @stdout guard 0 3
// @stdout negated 3
// @stdout both 3 0
// @stdout either 0 3
// @stdout tested 5 0
// @stdout for 6
// @stdout ternary 5
// A null check or a type test of a plain assignment tests the value the assignment stores, so it narrows the
// place written: in the condition of a 'while' loop, a 'for' loop and an 'if' statement, under '!', on either
// side of '&&' and '||', and in a '?:'.
class Node {
    protected int value;
    protected Node? next;

    protected constructor(this.value, this.next = null);
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;

    protected constructor(this.radius) {
        super();
    }
}

class Square extends Shape {
    protected constructor() {
        super();
    }
}

list() -> Node {
    return new Node(1, new Node(2, new Node(3)));
}

walk(Node head) -> int {
    int total = 0;
    Node? cursor = head;
    Node? current = null;
    while ((current = cursor) != null) {
        total = total + current.value;
        cursor = current.next;
    }
    return total;
}

guard(Node? head) -> int {
    Node? node;
    if ((node = head) == null) {
        return 0;
    }
    return node.value;
}

negated(Node? head) -> int {
    Node? node = null;
    if (!((node = head) == null)) {
        return node.value;
    }
    return 0;
}

both(Node? head) -> int {
    Node? node = null;
    if ((node = head) != null && node.value > 0) {
        return node.value;
    }
    return 0;
}

either(Node? head) -> int {
    Node? node = null;
    if ((node = head) == null || node.value == 0) {
        return 0;
    }
    return node.value;
}

tested(Shape shape) -> int {
    Shape held = new Square();
    if (!((held = shape) is Circle)) {
        return 0;
    }
    return held.radius;
}

forLoop(Node head) -> int {
    int total = 0;
    Node? cursor = head;
    for (Node? node = null; (node = cursor) != null; cursor = node.next) {
        total = total + node.value;
    }
    return total;
}

ternary(Shape shape) -> int {
    Shape held = shape;
    return (held = shape) is Circle ? held.radius : 0;
}

main() -> int {
    Node head = list();
    print("walk {walk(head)}");
    print("guard {guard(null)} {guard(new Node(3))}");
    print("negated {negated(new Node(3))}");
    print("both {both(new Node(3))} {both(new Node(0))}");
    print("either {either(null)} {either(new Node(3))}");
    print("tested {tested(new Circle(5))} {tested(new Square())}");
    print("for {forLoop(head)}");
    print("ternary {ternary(new Circle(5))}");
    return 0;
}
