// @exit 0
// @stdout extension: txt | gz | <none> | <none> | <none>
// @stdout stem: notes | archive.tar | README | .gitignore
// @stdout absolute: true true false false
// @stdout resolved: /work/src/main.ens | /work/main.ens | C:/tools/ens.exe | /etc/hosts
// @stdout split: [a][b][c] | [a][][b] | [one] | []
// @stdout lines: [first][second][third][]
// @stdout joined: a, b, c | one | <empty>
// @stdout numbers: 0 42 -7 9223372036854775807 -9223372036854775808
// @stdout refused: <refused> <refused> <refused> <refused> <refused> <refused>
import @std.path;
import @std.text.strings;

main() -> int {
    print("extension: " + strings.joined([path.extension("dir/notes.txt"),
        path.extension("archive.tar.gz"), shown(path.extension("dir/README")),
        shown(path.extension(".gitignore")), shown(path.extension("a.b/plain"))], " | "));
    print("stem: " + strings.joined([path.stem("dir/notes.txt"), path.stem("archive.tar.gz"),
        path.stem("dir/README"), path.stem(".gitignore")], " | "));

    bool rooted = path.isAbsolute("/etc/hosts");
    bool drive = path.isAbsolute("C:/tools");
    bool relative = path.isAbsolute("src/main.ens");
    bool dotted = path.isAbsolute("./src");
    print("absolute: {rooted} {drive} {relative} {dotted}");
    print("resolved: " + strings.joined([path.absolute("src/main.ens", "/work"),
        path.absolute("./nested/../main.ens", "/work"), path.absolute("C:/tools/ens.exe", "/work"),
        path.absolute("/etc/hosts", "/work")], " | "));

    print("split: " + strings.joined([bracketed(strings.split("a,b,c", ",")),
        bracketed(strings.split("a,,b", ",")), bracketed(strings.split("one", ",")),
        bracketed(strings.split("", ","))], " | "));
    print("lines: " + bracketed(strings.lines("first\r\nsecond\nthird\n")));
    print("joined: " + strings.joined([strings.joined(["a", "b", "c"], ", "),
        strings.joined(["one"], ", "), shownEmpty(strings.joined([], ", "))], " | "));

    print("numbers: " + strings.joined([spelled("0"), spelled("42"), spelled("-7"),
        spelled("9223372036854775807"), spelled("-9223372036854775808")], " "));
    print("refused: " + strings.joined([spelled(""), spelled("-"), spelled("12a"),
        spelled(" 12"), spelled("9223372036854775808"),
        spelled("-9223372036854775809")], " "));
    return 0;
}

shown(string value) -> string {
    if (value.length == 0) {
        return "<none>";
    }
    return value;
}

shownEmpty(string value) -> string {
    if (value.length == 0) {
        return "<empty>";
    }
    return value;
}

// Every part in its own brackets, so an empty part is as visible as any other.
bracketed(string[] parts) -> string {
    string shape = "";
    for (let part in parts) {
        shape = shape + "[" + part + "]";
    }
    return shape;
}

spelled(string text) -> string {
    long? parsed = strings.parseInteger(text);
    if (parsed == null) {
        return "<refused>";
    }
    return parsed.toString();
}
