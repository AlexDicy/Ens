// @stdout readonly 1
// @stdout dtor 99
// @stdout whole returned 99
// @stdout caller after whole 1
// @stdout dtor 77
// @stdout field returned 77
// @stdout caller after field 1
// @stdout dtor 55
// @stdout dtor 66
// @stdout both returned 66
// @stdout caller after both 1
// @stdout dtor 88
// @stdout nested returned 88
// @stdout caller after nested 2
// @stdout end
// @stdout dtor 2
// @stdout dtor 1
class Noisy {
    protected long v;

    protected constructor(this.v);

    destructor() {
        print("dtor {this.v}");
    }
}

struct Holder {
    protected Noisy item;
}

struct Outer {
    protected Holder inner;
}

readOnly(Holder h) -> long {
    return h.item.v;
}

replaceWhole(Holder h) -> long {
    h = { item: new Noisy(99) };
    return h.item.v;
}

replaceField(Holder h) -> long {
    h.item = new Noisy(77);
    return h.item.v;
}

replaceBoth(Holder h) -> long {
    h = { item: new Noisy(55) };
    h.item = new Noisy(66);
    return h.item.v;
}

replaceNested(Outer o) -> long {
    o = { inner: { item: new Noisy(88) } };
    return o.inner.item.v;
}

main() -> int {
    let a = new Noisy(1);
    Holder box = { item: a };
    print("readonly {readOnly(box)}");
    print("whole returned {replaceWhole(box)}");
    print("caller after whole {box.item.v}");
    print("field returned {replaceField(box)}");
    print("caller after field {box.item.v}");
    print("both returned {replaceBoth(box)}");
    print("caller after both {box.item.v}");

    let b = new Noisy(2);
    Outer nest = { inner: { item: b } };
    print("nested returned {replaceNested(nest)}");
    print("caller after nested {nest.inner.item.v}");
    print("end");
    return 0;
}
