// @exit 109
// A 'try' written before a chain of calls covers every call in the chain, whichever of them can
// throw, and a 'catch' clause catches what any of them throws.
class Failure extends Error {
    constructor() {
        super("failed");
    }
}

class Program {
    int size;

    constructor(this.size);

    links() -> int {
        return this.size;
    }

    risky() -> int throws {
        if (this.size > 5) {
            throw new Failure();
        }
        return this.size;
    }
}

settle(int size) -> Program throws {
    if (size < 0) {
        throw new Failure();
    }
    return new Program(size);
}

linked(int size) -> int {
    return try settle(size).links();
} catch (Failure e) {
    return 100;
}

both(int size) -> int {
    return try settle(size).risky();
} catch (Failure e) {
    return 1;
}

main() -> int {
    return linked(4) + linked(-1) + both(7) + both(3) + both(-2);
}
