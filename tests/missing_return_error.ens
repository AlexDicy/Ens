// @expect-error Function 'lineIndexOf' returns 'long', but a path through its body ends without a 'return'. Add a 'return' at the end of every path.
// A non-void function whose body can fall off the end is rejected.
lineIndexOf(string line, string needle) -> long {
    long position = line.indexOf(needle);
    if (position >= 0) {
        return position;
    }
}

main() -> int {
    lineIndexOf("haystack", "hay");
    return 0;
}
