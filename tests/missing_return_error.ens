// @expect-error Function 'lineIndexOf' can reach the end of its body without returning a value
// A non-void function whose body can fall off the end is rejected.
lineIndexOf(string line, string needle) -> long {
    long position = line.indexOf(needle);
    if (position >= 0) {
        return position;
    }
}

main() -> int {
    lineIndexOf("haystack", "hay");
    return 0;
}
