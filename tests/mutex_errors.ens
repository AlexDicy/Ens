// @expect-error 'lock' declares '<shared R>', so its type argument for 'R' must be a type another task may hold, but 'List<int>' is a class that is not 'shared'.
// @expect-error This lambda is a 'shared (List<int>) -> void', so another task may run it, but it captures 'outside', which has type 'List<int>', a class that is not 'shared'. Freeze it before the lambda, as in 'let frozenOutside = outside.frozen();', and use 'frozenOutside' inside the lambda, or keep it in a 'Mutex<List<int>>' if the lambda changes it.
// @expect-error build failed with 2 problems
// The value a mutex holds stays inside its lock: a body cannot return it, and cannot capture a
// value another task may not hold.
import Cancelled from @std.tasks;
import Mutex from @std.tasks;
import List from @std.collections.list;

main() -> int throws Cancelled {
    let numbers = new Mutex<List<int>>(new List<int>());
    let escaped = try numbers.lock((list) -> list);
    let outside = new List<int>();
    try numbers.lock((list) -> outside.push(list.length() as int));
    return 0;
}
