// @exit 100
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

struct Container {
    protected Box b = new Box();
}

readOnly(Container c) -> int {
    let x = c;
    return x.b.v;
}

mutating(Container c) -> int {
    let y = c;
    y.b = new Box();
    y.b.v = 50;
    return y.b.v;
}

main() -> int {
    Container c = {};
    c.b.v = 50;
    let r1 = readOnly(c);
    let r2 = mutating(c);
    return r1 + r2;
}
