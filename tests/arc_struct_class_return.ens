// @exit 7
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

struct Container {
    protected Box b = new Box();
}

makeContainer() -> Container {
    Container c = {};
    c.b.v = 7;
    return c;
}

main() -> int {
    let result = makeContainer();
    return result.b.v;
}
