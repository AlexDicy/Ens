// The stand-in '@std.core' the prelude fixtures are compiled against: every program loads this
// module, so it carries the two shapes the compiler resolves by name, plus the functions a
// prelude module offers every other module without an import. The real one is
// libs/std/src/core.ens, which declares no functions yet.
export struct StackFrame {
    export const string function;
    export const string file;
    export const int line;
}

export class Error {
    export string message;

    long[]? frames;

    export constructor(this.message);

    export stackTrace() -> string {
        return "";
    }

    export stackFrames() -> StackFrame[] {
        return [];
    }
}

export greeting(string name) -> string {
    return "hello, " + name;
}

// One prelude function calling another: inside the module that declares them both, they are
// ordinary functions of the file.
export shout(string name) -> string {
    return greeting(name) + "!";
}

export describe(string text) -> string {
    return "text of {text.length} bytes";
}

export describe(long count) -> string {
    return "count {count}";
}

export doubled(long value) -> long {
    return value * 2;
}

// Public rather than exported: visible to the rest of package 'std' and to nobody else, so no
// program reaches it, qualified or not.
public inPackageOnly() -> string {
    return "package";
}

// Private to this file, which is as far from the prelude as a declaration can be.
fileOnly() -> string {
    return "file";
}
