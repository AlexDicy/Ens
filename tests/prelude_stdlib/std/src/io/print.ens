// The stand-in '@std.io.print': every program loads this module, so it carries the two names the
// prelude lends, written onto the same handles the real one writes onto.
external type CFile;

external from libc {
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fflush(CFile? stream) -> int;
    ens_standard_output() -> CFile;
    ens_standard_error() -> CFile;
}

export print(string message) {
    let written = writeLine(ens_standard_output(), message);
}

export eprint(string message) {
    let flushed = fflush(null);
    let written = writeLine(ens_standard_error(), message);
}

writeLine(CFile stream, string message) -> ulong {
    byte[] raw = (message + "\n").toBytes();
    return fwrite(raw, 1, raw.length as ulong, stream);
}
