// @exit 0
// @stdout-contains-at O0 at deep (stack_trace_caught.ens:14)
// @stdout-contains-at O2 at deep (stack_trace_caught.ens:14, inlined)
// @stdout-contains-at O0 at run (stack_trace_caught.ens:17)
// @stdout-contains-at O2 at run (stack_trace_caught.ens:17, inlined)
// @stdout-contains at main (stack_trace_caught.ens:20)
// A caught exception logged on demand: e.stackTrace() yields the originating chain
// as text, and e.stackFrames() the same as structured frames. Exit 0 only when the
// innermost structured frame reports the throw line.
class AppError extends Error {
    protected constructor(string m) { super(m); }
}
deep() -> int throws {
    throw new AppError("logged");
}
run() -> int throws {
    return try deep();
}
main() -> int {
    return try run();
} catch (AppError e) {
    print(e.stackTrace());
    let frames = e.stackFrames();
    if (frames[0].line == 14) { return 0; }
    return 1;
}