// @expect-error build failed with 4 problems
// '?.' and '?[' on a value that can never be null are refused. An assignment's value is what its target
// holds after the write, so storing a value that is not null into a nullable local gives one that is not
// null, and the fix writes the assignment in parentheses before the '.' or the '['. A local declared
// nullable at two levels whose initial value proves both present cannot be null either.
class Leaf {
    Leaf? next;
    protected constructor(this.next = null);
}

main() -> int {
    Leaf? held = null;
    let stored = (held = new Leaf())?.next;
    int[]? items = null;
    let first = (items = [1, 2])?[0];
    string?? present = "text";
    let size = present?.length;
    string[]?? presentRows = ["a"];
    let cell = presentRows?[0];
    return 0;
}
