// @expect-error 'leaf' has type 'Leaf', which can never be null, so it needs no '?.'. Write 'leaf.next'.
class Leaf {
    Leaf? next;
    protected constructor(this.next = null);
}

main() -> int {
    let leaf = new Leaf();
    // '?.' on a non-optional receiver is rejected.
    let bad = leaf?.next;
    return 0;
}
