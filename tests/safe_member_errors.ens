// @expect-error 'held = new Leaf()' has type 'Leaf', which can never be null, so it needs no '?.'. Write '(held = new Leaf()).next'.
// @expect-error 'items = [1, 2]' has type 'int[]', which can never be null, so it needs no '?['. Write '(items = [1, 2])[0]'.
// @expect-error build failed with 2 problems
// '?.' and '?[' on a value that can never be null are refused. An assignment's value is what its target
// holds after the write, so storing a value that is not null into a nullable local gives one that is not
// null, and the fix writes the assignment in parentheses before the '.' or the '['.
class Leaf {
    Leaf? next;
    protected constructor(this.next = null);
}

main() -> int {
    Leaf? held = null;
    let stored = (held = new Leaf())?.next;
    int[]? items = null;
    let first = (items = [1, 2])?[0];
    return 0;
}
