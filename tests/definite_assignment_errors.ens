// @expect-error Variable 'b' is used before it is assigned a value
// @expect-error Variable 'p' is used before it is assigned a value
// @expect-error Variable 'q' is used before it is assigned a value
// @expect-error build failed with 3 problems
// A local is readable only where it is definitely assigned on every path: reading it when only one
// branch of an 'if' assigned it, and touching a struct local's field before the whole struct is
// built are each errors.
struct Point {
    int x;
    int y;
}

conditionalOnly(bool c) -> int {
    int b;
    if (c) {
        b = 1;
    }
    return b;
}

structFieldAssign() -> int {
    Point p;
    p.x = 1;
    p.y = 2;
    return p.x;
}

useBeforeWholeStruct() -> int {
    Point q;
    return q.x;
}

main() -> int {
    return 0;
}
