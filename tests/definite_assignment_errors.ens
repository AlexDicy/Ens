// A local is readable only where it is definitely assigned on every path: reading it with no
// assignment, reading it when only one branch of an 'if' or a '?:' assigned it, reading it after an
// assignment that runs only on the right of '&&', and touching a struct local's field before the
// whole struct is built are each errors.
struct Point {
    int x;
    int y;
}

readBeforeAssign() -> int {
    int a;
    return a;
}

conditionalOnly(bool c) -> int {
    int b;
    if (c) {
        b = 1;
    }
    return b;
}

structFieldAssign() -> int {
    Point p;
    p.x = 1;
    p.y = 2;
    return p.x;
}

useBeforeWholeStruct() -> int {
    Point q;
    return q.x;
}

assignedOnlyWhenTheSwitchRuns(bool c) -> int {
    int r;
    bool matched = c && switch (1) {
        default -> (r = 1) > 0,
    };
    return r;
}

larger(int first, int second) -> bool {
    return first > second;
}

assignedBesideASwitch(bool c) -> int {
    int s;
    bool matched = c && larger(switch (1) {
        default -> 1,
    }, s = 2);
    return s;
}

assignedByOneBranch(bool c) -> int {
    int t;
    int picked = c ? (t = 1) : 0;
    return t;
}

assignedOnlyWhenTheBranchesRun(bool c) -> int {
    int u;
    bool matched = c && (c ? (u = 1) > 0 : (u = 2) > 0);
    return u;
}

main() -> int {
    return 0;
}
