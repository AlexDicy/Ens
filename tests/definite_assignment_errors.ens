// @expect-error Variable 'p' is used before it is assigned a value
// @expect-error Variable 'q' is used before it is assigned a value
// @expect-error Variable 'r' is used before it is assigned a value
// @expect-error Variable 's' is used before it is assigned a value
// @expect-error build failed with 6 problems
// A local is readable only where it is definitely assigned on every path: reading it with no
// assignment, reading it when only one branch assigned it, reading it after a switch on the right
// of '&&' assigned it, and touching a struct local's field before the whole struct is built are
// each errors.
struct Point {
    int x;
    int y;
}

readBeforeAssign() -> int {
    int a;
    return a;
}

conditionalOnly(bool c) -> int {
    int b;
    if (c) {
        b = 1;
    }
    return b;
}

structFieldAssign() -> int {
    Point p;
    p.x = 1;
    p.y = 2;
    return p.x;
}

useBeforeWholeStruct() -> int {
    Point q;
    return q.x;
}

assignedOnlyWhenTheSwitchRuns(bool c) -> int {
    int r;
    bool matched = c && switch (1) {
        default -> (r = 1) > 0,
    };
    return r;
}

larger(int first, int second) -> bool {
    return first > second;
}

assignedBesideASwitch(bool c) -> int {
    int s;
    bool matched = c && larger(switch (1) {
        default -> 1,
    }, s = 2);
    return s;
}

main() -> int {
    return 0;
}
