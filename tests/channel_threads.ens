// @exit 0
// @stdout 2000 100999000 true
// @stdout handed off
// @stdout -1 false
// @stdout could not send: the receiving end of the channel has been released, so nothing would ever receive the value. Keep the Channel while values are sent to it
// Two tasks send into one channel while the main task walks it, the walk ending when both senders
// are released; a channel of capacity zero hands a value over; a wait with a limit ends with
// nothing; and a send after the receiving end is released throws.
import @std.tasks;
import Cancelled from @std.tasks;
import Channel from @std.tasks;
import Sender from @std.tasks;
import ChannelClosed from @std.tasks;
import TaskScope from @std.tasks;

produce(Sender<long> out, long from) throws Cancelled {
    for (long i = 0; i < 1000; i++) {
        try out.send(from + i);
    }
} catch (ChannelClosed closed) {
    print("closed early");
}

startProducer(TaskScope scope, Channel<long> values, long from) {
    let out = values.sender();
    scope.launch(() -> try produce(out, from));
}

main() -> int throws Cancelled {
    let values = new Channel<long>(8);
    print(tasks.scope((scope) -> {
        startProducer(scope, values, 0);
        startProducer(scope, values, 100000);
        long total = 0;
        long seen = 0;
        for (let value in values) {
            total = total + value;
            seen++;
        }
        return "{seen} {total} {values.isClosed()}";
    }));

    let handoff = new Channel<string>(0);
    let out = handoff.sender();
    try tasks.scope((scope) -> {
        scope.launch(() -> {
            let ignored = try handoff.receive();
        });
        try out.send("passed");
    });
    print("handed off");

    let quiet = new Channel<int>(1);
    let keep = quiet.sender();
    print("{try quiet.receive(20) ?? -1} {quiet.isClosed()}");

    Sender<int>? orphan = null;
    {
        let gone = new Channel<int>(1);
        orphan = gone.sender();
    }
    if (orphan != null) {
        try orphan.send(1);
    }
    return 0;
} catch (ChannelClosed closed) {
    print(closed.message);
    return 0;
}
