// @exit 0
// @stdout 2000 100999000 true
// @stdout handed off
// @stdout -1 false
// @stdout could not send: the receiving end of the channel has been released, so nothing would ever receive the value. Keep the Channel while values are sent to it
// Two threads send into one channel while the main thread walks it, the walk ending when both
// senders are released; a channel of capacity zero hands a value over; a wait with a limit ends with
// nothing; and a send after the receiving end is released throws.
import Channel from @std.tasks;
import Sender from @std.tasks;
import ChannelClosed from @std.tasks;

external type NativeThread;

external from libc {
    ens_thread_start((() -> void) body, out int error) -> NativeThread?;
    ens_thread_join(NativeThread thread);
}

produce(Sender<long> out, long from) {
    for (long i = 0; i < 1000; i++) {
        try out.send(from + i);
    }
} catch (ChannelClosed closed) {
    print("closed early");
}

startProducer(Channel<long> values, long from) -> NativeThread? {
    let out = values.sender();
    int error = 0;
    return ens_thread_start(() -> produce(out, from), out error);
}

main() -> int {
    let values = new Channel<long>(8);
    let first = startProducer(values, 0);
    let second = startProducer(values, 100000);
    long total = 0;
    long seen = 0;
    for (let value in values) {
        total = total + value;
        seen++;
    }
    if (first != null) {
        ens_thread_join(first);
    }
    if (second != null) {
        ens_thread_join(second);
    }
    print("{seen} {total} {values.isClosed()}");

    let handoff = new Channel<string>(0);
    let out = handoff.sender();
    int error = 0;
    let thread = ens_thread_start(() -> {
        let ignored = handoff.receive();
    }, out error);
    try out.send("passed");
    if (thread != null) {
        ens_thread_join(thread);
    }
    print("handed off");

    let quiet = new Channel<int>(1);
    let keep = quiet.sender();
    print("{quiet.receive(20) ?? -1} {quiet.isClosed()}");

    Sender<int>? orphan = null;
    {
        let gone = new Channel<int>(1);
        orphan = gone.sender();
    }
    if (orphan != null) {
        try orphan.send(1);
    }
    return 0;
} catch (ChannelClosed closed) {
    print(closed.message);
    return 0;
}
