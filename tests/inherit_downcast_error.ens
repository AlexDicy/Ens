// @expect-error Cannot assign value of type 'Base' to variable of type 'Derived'
class Base {
    Base();
}

class Derived extends Base {
    int extra;
    Derived(this.extra = 0);
}

main() -> int {
    Base b = new Base();
    Derived d = b;   // a base value is not assignable to a derived variable
    return 0;
}