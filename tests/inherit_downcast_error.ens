// @expect-error Variable 'd' has type 'Derived', but its value has type 'Base'.
class Base {
    protected constructor();
}

class Derived extends Base {
    int extra;
    constructor(this.extra = 0);
}

main() -> int {
    Base b = new Base();
    Derived d = b;   // a base value is not assignable to a derived variable
    return 0;
}