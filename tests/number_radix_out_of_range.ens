// @exit 134
// @stderr-contains panic: radix 37 is outside 2 through 36, the bases the digits and letters spell
// @stderr-contains at long.toString
// A base beyond the digits and the letters together has no digits to write with, so asking for one
// is a broken contract rather than an answer.
main() -> int {
    long count = 255;
    return count.toString(37).length as int;
}
