// @expect-error Enum 'FirstUnvalued' assigns values to its members, so its first member 'Alpha' must have one too. Give it a value, as in 'Alpha = 0'.
// @expect-error Enum members 'B' and 'A' both have the value '1'. Give each member of enum 'DirectDuplicate' its own value.
// @expect-error Enum members 'C' and 'B' both have the value '2'. Give each member of enum 'ContinuationCollision' its own value.
// Declaration-level value errors for numeric enums: a numeric enum's first member must carry an
// explicit value, resulting values must be distinct (directly or after continuation), and a
// value must be an integer constant.
enum FirstUnvalued {
    Alpha,
    Beta = 5,
}

enum DirectDuplicate {
    A = 1,
    B = 1,
}

enum ContinuationCollision {
    A = 1,
    B,
    C = 2,
}

enum NonInteger {
    X = "nope",
}

main() -> int {
    return 0;
}
