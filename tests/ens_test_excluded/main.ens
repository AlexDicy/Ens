// @exit 7
// @stdout sum is 5
// A normal (non @ens-test) build of a folder that contains a *_test.ens file:
// the test file is excluded from the build. If it were seeded, its main()
// would collide with this one at link time and the build would fail.
main() -> int {
    print("sum is {2 + 3}");
    return 7;
}
