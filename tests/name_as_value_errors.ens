// to write instead.

import @std.text.stringbuilder;
import StringBuilder from @std.text.stringbuilder;
import @std.text.stringbuilder as builders;
import @std.process.blocks;

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

twice(int value) -> int {
    return value * 2;
}

risky(int value) -> int throws Failure {
    if (value < 0) {
        throw new Failure("negative");
    }
    return value;
}

overloaded(int value) -> int {
    return value;
}

overloaded(string value) -> string {
    return value;
}

untypedLocal() {
    let callback = twice;
}

throwingFunction() {
    let callback = risky;
}

overloadedName() {
    let callback = overloaded;
}

moduleQualifiedUnreachableFunction() {
    let held = blocks.nameOf;
}

importedTypeName() {
    let held = StringBuilder;
}

moduleQualifiedType() {
    let held = stringbuilder.StringBuilder;
}

moduleQualifiedTypeThroughAlias() {
    let held = builders.StringBuilder;
}

importedTypeCalled() {
    let held = StringBuilder();
}

moduleQualifiedTypeCalled() {
    let held = stringbuilder.StringBuilder();
}

moduleQualifiedTypeAsStaticHead() {
    let held = stringbuilder.StringBuilder.withCapacity(8);
}

primitiveCalled() {
    let held = string(3);
}

main() -> int {
    return 0;
}
