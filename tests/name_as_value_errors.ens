// A name that stands for a function, a module, or a method is not a value, and every position a
// value can be written in refuses one. A function value is a lambda instead.
// @expect-error 'twice' is a function, and a function's name is not a value. Call it as 'twice(...)', or hold a lambda in a declared function type, as in '(int) -> int callback = (value) -> twice(value);'.
// @expect-error 'risky' is a function, and a function's name is not a value. Call it as 'risky(...)', or hold a lambda in a declared function type, as in '((int) -> int throws Failure) callback = (value) -> try risky(value);'.
// @expect-error 'overloaded' is a function, and a function's name is not a value. Call it as 'overloaded(...)', or hold a lambda in a declared function type.
// @expect-error 'stringbuilder' names a module, not a value. A module name reaches what the module declares, as in 'stringbuilder.member(...)'.
// @expect-error 'bump' is a method of 'Counter', and a method's name is not a value. Call it as 'bump(...)'.
// @expect-error 'bump' is a method of 'Counter', so it cannot be assigned.
// @expect-error build failed with 11 problems

import @std.text.stringbuilder;

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public class Counter {
    int count;

    public constructor() {
        this.count = 0;
    }

    public bump(int by) -> int {
        this.count = this.count + by;
        return this.count;
    }

    public readsItsOwnMethod() {
        let held = this.bump;
    }
}

twice(int value) -> int {
    return value * 2;
}

risky(int value) -> int throws Failure {
    if (value < 0) {
        throw new Failure("negative");
    }
    return value;
}

overloaded(int value) -> int {
    return value;
}

overloaded(string value) -> string {
    return value;
}

applies((int) -> int f, int value) -> int {
    return f(value);
}

untypedLocal() {
    let callback = twice;
}

declaredFunctionType() {
    (int) -> int callback = twice;
}

callArgument() {
    print("{applies(twice, 3)}");
}

throwingFunction() {
    let callback = risky;
}

overloadedName() {
    let callback = overloaded;
}

assignedTo() {
    twice = 4;
}

moduleName() {
    let held = stringbuilder;
}

methodOfAValue() {
    let counter = new Counter();
    let held = counter.bump;
}

methodAssigned() {
    let counter = new Counter();
    counter.bump = 3;
}

methodThroughSafeAccess() {
    Counter? maybe = new Counter();
    let held = maybe?.bump;
}

main() -> int {
    return 0;
}
