// A name that stands for a function, a module, a method, or a type is not a value, and every
// position a value can be written in refuses one. A function value is a lambda instead. A module
// name is refused with a call to a function that module declares, and with nothing further where
// it declares none. A module-qualified name that names no type of that module reads as the
// function it is, as a visibility refusal where this file cannot reach it, and as absent where
// the module declares nothing under it. One that does name a type is refused as the type it is,
// spelled with the head this file writes. A type name this file imports is refused the same way,
// and a type this file declares itself is refused by the kind of type it is. Each refusal says
// how a value of that type is written. A call whose callee is one of these names is refused with
// those same routes. A type parameter stands for a different type at each use, so a parameter
// is the only value one has, and its refusal names a parameter of that type in reach, else the
// parameter to declare. A field default and a parameter default declare none, so the refusal
// there stops at the sentence, while a lambda written inside a default declares its own.
// @expect-error 'twice' is a function, and a function's name is not a value. Call it as 'twice(...)', or hold a lambda in a declared function type, as in '(int) -> int callback = (value) -> twice(value);'.
// @expect-error 'risky' is a function, and a function's name is not a value. Call it as 'risky(...)', or hold a lambda in a declared function type, as in '((int) -> int throws Failure) callback = (value) -> try risky(value);'.
// @expect-error 'overloaded' is a function, and a function's name is not a value. Call it as 'overloaded(...)', or hold a lambda in a declared function type.
// @expect-error 'stringbuilder' names a module, not a value.
// @expect-error 'parse' names a module, not a value. A module name reaches what the module declares, as in 'parse.parseLong(...)'.
// @expect-error 'bump' is a method of 'Counter', and a method's name is not a value. Call it as 'bump(...)'.
// @expect-error 'bump' is a method of 'Counter', so it cannot be assigned.
// @expect-error 'parse.parseInt' is a function, and a function's name is not a value. Call it as 'parse.parseInt(...)', or hold a lambda in a declared function type, as in '(string) -> int? callback = (text) -> parse.parseInt(text);'.
// @expect-error Function 'nameOf' is public inside package 'std' but not exported. Mark it 'export' in module 'std.process.blocks' to use it from another package.
// @expect-error 'nosuch' is not declared in module 'std.text.parse'.
// @expect-error 'StringBuilder' is a type, not a value. Write 'new StringBuilder()' to construct one, or write 'StringBuilder.withCapacity(...)' to reach a static member.
// @expect-error 'stringbuilder.StringBuilder' is a type, not a value. Write 'new stringbuilder.StringBuilder()' to construct one.
// @expect-error 'builders.StringBuilder' is a type, not a value. Write 'new builders.StringBuilder()' to construct one.
// @expect-error 'Counter' is a type, not a value. Write 'new Counter()' to construct one.
// @expect-error 'Kind' is a type, not a value. Write 'Kind.Large' to name one of its constants.
// @expect-error 'Point' is a type, not a value. Write 'Point value = {x: ..., y: ...};' to build one.
// @expect-error 'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as a parameter declared 'Tag value'.
// @expect-error 'Tag' is a type parameter, not a function. Use a value of type 'Tag', such as a parameter declared 'Tag value'.
// @expect-error 'StringBuilder' is a type, not a function. Write 'new StringBuilder()' to construct one, or write 'StringBuilder.withCapacity(...)' to reach a static member.
// @expect-error 'stringbuilder.StringBuilder' is a type, not a function. Write 'new stringbuilder.StringBuilder()' to construct one.
// @expect-error 'Kind' is a type, not a function. Write 'Kind.Large' to name one of its constants.
// @expect-error 'string' is a type, not a function. Write 'try string.fromBytes(...)' to reach a static member.
// @expect-error 'parse' names a module, not a function. A module name reaches what the module declares, as in 'parse.parseLong(...)'.
// @expect-error 'Slot' is a type parameter, not a value.
// @expect-error 'Slot' is a type parameter, not a function.
// @expect-error 'Mark' is a type parameter, not a value.
// @expect-error 'Load' is a type parameter, not a value. Use a value of type 'Load', such as 'each'.
// @expect-error 'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as 'given'.
// @expect-error build failed with 33 problems

import @std.text.stringbuilder;
import StringBuilder from @std.text.stringbuilder;
import @std.text.stringbuilder as builders;
import @std.text.parse;
import @std.process.blocks;

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public class Counter {
    int count;

    public constructor() {
        this.count = 0;
    }

    public bump(int by) -> int {
        this.count = this.count + by;
        return this.count;
    }

    public readsItsOwnMethod() {
        let held = this.bump;
    }
}

public enum Kind {
    Large,
    Small,
}

public struct Point {
    public int x;
    public int y;
}

twice(int value) -> int {
    return value * 2;
}

risky(int value) -> int throws Failure {
    if (value < 0) {
        throw new Failure("negative");
    }
    return value;
}

overloaded(int value) -> int {
    return value;
}

overloaded(string value) -> string {
    return value;
}

applies((int) -> int f, int value) -> int {
    return f(value);
}

untypedLocal() {
    let callback = twice;
}

declaredFunctionType() {
    (int) -> int callback = twice;
}

callArgument() {
    print("{applies(twice, 3)}");
}

throwingFunction() {
    let callback = risky;
}

overloadedName() {
    let callback = overloaded;
}

assignedTo() {
    twice = 4;
}

moduleName() {
    let held = stringbuilder;
}

moduleThatDeclaresAFunction() {
    let held = parse;
}

moduleQualifiedFunction() {
    let held = parse.parseInt;
}

moduleQualifiedUnreachableFunction() {
    let held = blocks.nameOf;
}

moduleQualifiedAbsentName() {
    let held = parse.nosuch;
}

importedTypeName() {
    let held = StringBuilder;
}

moduleQualifiedType() {
    let held = stringbuilder.StringBuilder;
}

moduleQualifiedTypeThroughAlias() {
    let held = builders.StringBuilder;
}

declaredClassName() {
    let held = Counter;
}

declaredEnumName() {
    let held = Kind;
}

declaredStructName() {
    let held = Point;
}

public class Crate<Tag> {
    public constructor();

    typeParameterAsValue() {
        let held = Tag;
    }

    typeParameterAsCallee() {
        let held = Tag(3);
    }

    typeParameterWithAValueInReach(Tag given) {
        let held = Tag;
    }
}

public class SlotInFieldDefault<Slot> {
    public int held = Slot;
    public int made = Slot(3);

    public constructor();
}

public class MarkInParameterDefault<Mark> {
    public constructor();

    takesIt(int held = Mark) -> int {
        return held;
    }
}

public class LoadInLambdaDefault<Load> {
    public ((Load) -> long) weigh = (each) -> Load;

    public constructor();
}

importedTypeCalled() {
    let held = StringBuilder();
}

moduleQualifiedTypeCalled() {
    let held = stringbuilder.StringBuilder();
}

declaredEnumCalled() {
    let held = Kind(1);
}

primitiveCalled() {
    let held = string(3);
}

moduleNameCalled() {
    let held = parse(3);
}

methodOfAValue() {
    let counter = new Counter();
    let held = counter.bump;
}

methodAssigned() {
    let counter = new Counter();
    counter.bump = 3;
}

methodThroughSafeAccess() {
    Counter? maybe = new Counter();
    let held = maybe?.bump;
}

main() -> int {
    return 0;
}
