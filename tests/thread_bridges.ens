// @exit 0
// @stdout woken
// @stdout total 400000
// @stdout tokens: steady true, own true, nonzero true
// The thread and lock bridges the compiler defines: four threads add to one count under a lock, a
// fifth sleeps on the lock's condition until it is woken, and a timed wait on the main thread ends
// by itself. A thread's token stays the same while it runs and differs from another thread's.
external type NativeThread;
external type NativeLock;

external from libc {
    ens_thread_start((() -> void) body, out int error) -> NativeThread?;
    ens_thread_join(NativeThread thread);
    ens_lock_create() -> NativeLock?;
    ens_lock_destroy(NativeLock lock);
    ens_lock_acquire(NativeLock lock);
    ens_lock_release(NativeLock lock);
    ens_lock_wait(NativeLock lock, long millis);
    ens_lock_notify_all(NativeLock lock);
    ens_thread_token() -> long;
}

final class Tokens {
    long other = 0;
}

final class Counter {
    long total;
    bool ready;
    const NativeLock lock;

    constructor(this.lock) {
        this.total = 0;
        this.ready = false;
    }
}

main() -> int {
    let lock = ens_lock_create();
    if (lock == null) {
        return 1;
    }
    let counter = new Counter(lock);
    let threads = new NativeThread?[4];
    for (long t = 0; t < 4; t++) {
        int error = 0;
        threads[t] = ens_thread_start(() -> {
            for (long i = 0; i < 100000; i++) {
                ens_lock_acquire(counter.lock);
                counter.total = counter.total + 1;
                ens_lock_release(counter.lock);
            }
        }, out error);
    }
    int waiterError = 0;
    let waiter = ens_thread_start(() -> {
        ens_lock_acquire(counter.lock);
        while (!counter.ready) {
            ens_lock_wait(counter.lock, -1);
        }
        ens_lock_release(counter.lock);
        print("woken");
    }, out waiterError);
    for (long t = 0; t < 4; t++) {
        let thread = threads[t];
        if (thread != null) {
            ens_thread_join(thread);
        }
    }
    ens_lock_acquire(lock);
    counter.ready = true;
    ens_lock_notify_all(lock);
    ens_lock_release(lock);
    if (waiter != null) {
        ens_thread_join(waiter);
    }
    ens_lock_acquire(lock);
    ens_lock_wait(lock, 20);
    ens_lock_release(lock);
    print("total {counter.total}");
    let tokens = new Tokens();
    int tokenError = 0;
    let reader = ens_thread_start(() -> {
        tokens.other = ens_thread_token();
    }, out tokenError);
    if (reader != null) {
        ens_thread_join(reader);
    }
    long mine = ens_thread_token();
    print("tokens: steady {mine == ens_thread_token()}, own {mine != tokens.other}, "
        + "nonzero {mine != 0 && tokens.other != 0}");
    return 0;
}
