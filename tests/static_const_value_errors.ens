// @expect-error Static const 'Limits.separator' has type 'char', but its initializer is the string '"/"'. Write a char literal such as '/'.
// @expect-error Static const 'Limits.huge' has type 'float', whose largest value is about 3.402e38, and this value is larger. Use 'double', or a smaller value.
// @expect-error Static const 'Limits.enormous' has type 'double', whose largest value is about 1.797e308, and this value is larger. Use a smaller value.
// @expect-error Static const 'Limits.low' has type 'float', whose smallest value is about -3.402e38, and this value is smaller. Use 'double', or a value inside the range.
// @expect-error Static const 'Limits.lowest' has type 'double', whose smallest value is about -1.797e308, and this value is smaller. Use a value inside the range.
// @expect-error Static const 'Limits.past' has type 'double', whose largest value is about 1.797e308, and this value is larger. Use a smaller value.
// @expect-error The initializer of static const 'Limits.wrapped' computes a number outside the range of every integer type.
// @expect-error Integer literal '99999999999999999999999' is too large for any integer type. The largest, 'ulong', goes up to 18446744073709551615.
// @expect-error The initializer of static const 'Limits.nothing' must be a compile-time constant, but a static const has a number type, 'char', 'bool' or 'string', and none of those can be null. A constant is built from literals, '+', '-', '*', '/', '%', string concatenation and other static consts read through their type name.
// @expect-error '%' in a constant expression works on integers only, and this one is used on the fractional number '1.5'.
// @expect-error '%' in a constant expression works on integers only, and this one is used on the fractional numbers '1.5' and '2.5'.
// @expect-error '*' in a constant expression works on two numbers, but this one is used on the string '"a"' and the number '2'.
// @expect-error '+' in a constant expression works on two numbers or two strings, but this one is used on the string '"a"' and the number '1'.
// @expect-error build failed with 13 problems
// Static const initializers that compute a value outside what the declared type can be.
class Limits {
    static const char separator = "/";
    static const float huge = 1e39;
    static const double enormous = 1e400;
    static const float low = -3.5e38;
    static const double lowest = -1e400;
    static const double past = 1.8e308;
    static const int wrapped = 18446744073709551615 + 1;
    static const long giant = 99999999999999999999999;
    static const string nothing = null;
    static const double remainder = 1.5 % 2;
    static const double remainders = 1.5 % 2.5;
    static const string doubled = "a" * 2;
    static const string joined = "a" + 1;
}

main() -> int {
    return 0;
}
