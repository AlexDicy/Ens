// @stdout base ctor
// @stdout derived ctor
// @stdout derived dtor
// @stdout base dtor
// @stdout after
// A destructor runs on final release, most-derived first then up the base chain, even when
// the object is held through a base reference and even though neither class has owning fields.
class Base {
    constructor() {
        print("base ctor");
    }
    destructor() {
        print("base dtor");
    }
}

class Derived extends Base {
    constructor() {
        super();
        print("derived ctor");
    }
    destructor() {
        print("derived dtor");
    }
}

make() {
    Base b = new Derived();
}

main() -> int {
    make();
    print("after");
    return 0;
}
