// @expect-error An array of non-nullable 'Box' must be filled as it is created
// The fill expression must not mention the array being filled.
class Box {
    int v;
    Box(this.v);
}

pick(Box[] source, long index) -> Box {
    return source[index];
}

main() -> int {
    Box[] boxes = new Box[2];
    for (long i = 0; i < boxes.length; i = i + 1) {
        boxes[i] = pick(boxes, i);
    }
    return 0;
}
