// @exit 0
// @stdout start=3
// @stdout end=8
// @stdout chained=5
// @stdout named=hello
// A struct returned by a call has no storage of its own; reading a field or
// calling a method on it materializes the value into a stack temporary.
struct Span {
    long start;
    long length;

    end() -> long {
        return this.start + this.length;
    }
}

struct Labeled {
    string name = "hello";
    long value;
}

class Node {
    Span span;

    Node(long start, long length) {
        this.span.start = start;
        this.span.length = length;
    }

    fullSpan() -> Span {
        return this.span;
    }
}

makeSpan(long start, long length) -> Span {
    Span s;
    s.start = start;
    s.length = length;
    return s;
}

makeLabeled() -> Labeled {
    Labeled l;
    l.value = 1;
    return l;
}

main() -> int {
    let node = new Node(3, 5);
    let start = node.fullSpan().start;
    let end = node.fullSpan().end();
    let chained = makeSpan(2, 3).end();
    let named = makeLabeled().name;
    print("start={start}");
    print("end={end}");
    print("chained={chained}");
    print("named={named}");
    return 0;
}
