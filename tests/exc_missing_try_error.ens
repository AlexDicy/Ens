// @expect-error Call to 'query' can throw 'Failure'. Prefix it with 'try'.
// @expect-error Call to 'query' can throw 'Failure'. Prefix it with 'try', and either catch it with a 'catch' clause or mark this function 'throws'.
// @expect-error Call to 'query' can throw 'Failure'. Prefix it with 'try', and catch it with a 'catch' clause after the constructor body.
// @expect-error Call to 'raise' can throw 'Failure'. Prefix it with 'try', and catch it with a 'catch' clause after the constructor body.
// @expect-error Call to 'raise' can throw 'Failure'. Prefix it with 'try', and add 'Failure' to the 'throws' list of the lambda's target function type, or move the call into a named function that catches it with a 'catch' clause.
// @expect-error 'mixed' can throw 'Other' but is not marked 'throws'. Add 'throws Other' after the signature, or catch it with a 'catch' clause after the body.
// @expect-error Call to 'raise' can throw 'Failure'. A 'catch' clause does not catch what its own body throws, and a constructor cannot be marked 'throws'. Move the call into a function that catches it with a 'catch' clause.
// @expect-error Call to 'raise' can throw 'Failure'. A 'catch' clause does not catch what its own body throws. Prefix it with 'try' and mark this function 'throws', or move the call into a function that catches it with a 'catch' clause.
// @expect-error Call to the function value can throw 'Failure'. Prefix it with 'try', and either catch it with a 'catch' clause or mark this function 'throws'.
// @expect-error 'throwsPlainly' can throw 'Other' but is not marked 'throws'. Add 'throws Other' after the signature, or catch it with a 'catch' clause after the body.
// @expect-error build failed with 15 problems
// The fix a missing 'try' is refused with is the one its position allows. That report is the one
// report about the call, so the function holding it is judged only on what else it throws.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Other extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Repo {
    query() -> int throws { throw new Failure("x"); }
    caller() -> int throws { return this.query(); }   // missing 'try'

    unmarked() -> int {
        return this.query();
    } catch (Failure e) {
        return 0;
    }

    protected constructor() {
        int value = this.query();
    } catch (Failure e) {
    }
}

raise() throws Failure {
    throw new Failure("raised");
}

class Opener {
    protected constructor() {
        raise();
    }
}

onlyCall() {
    raise();
}

mixed() {
    raise();
    throw new Other("other");
}

// An unmarked function that throws carries the one report. Its callers need no 'try' for it.
throwsPlainly() {
    throw new Other("plain");
}

callsPlainly() {
    throwsPlainly();
    try throwsPlainly();
}

class Closer {
    protected constructor() {
        try raise();
    } catch (Failure e) {
        raise();
    }
}

unmarkedCatch() {
    try raise();
} catch (Failure e) {
    raise();
}

markedCatch() throws Failure {
    try raise();
} catch (Failure e) {
    raise();
}

producer() -> (() -> void throws Failure) {
    return () -> raise();
}

multiline() {
    producer // the source
        ()();
}

run((() -> void throws Failure) body) throws Failure {
    try body();
}

plain(() -> void body) {
    body();
}

main() -> int {
    try run(() -> {
        raise();
    });
    plain(() -> {
        raise();
    });
    return 0;
} catch (Failure e) {
    return 1;
}
