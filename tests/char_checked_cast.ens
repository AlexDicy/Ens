// @exit 0
// @stdout valid: 65 0 65535 57344 1114111
// @stdout absent: true true true true true true true
// @stdout fallback: ? A
// @stdout from a byte: A
// An integer converts to a 'char' with 'as?', which gives the character when the integer is a code
// point and null for a surrogate, a negative value or one past 0x10FFFF, checked on the whole value
// so a wide one is never cut down to a code point first. A 'byte' still converts with 'as'.
codePoint(char? found) -> long {
    if (found == null) {
        return -1;
    }
    long code = found;
    return code;
}

main() -> int {
    int letter = 65;
    long zero = 0;
    ushort top = 65535;
    int afterSurrogates = 0xE000;
    uint last = 1114111;
    print("valid: {codePoint(letter as? char)} {codePoint(zero as? char)} {codePoint(top as? char)} "
        + "{codePoint(afterSurrogates as? char)} {codePoint(last as? char)}");
    int firstSurrogate = 0xD800;
    ushort lastSurrogate = 0xDFFF;
    int past = 0x110000;
    int negative = -1;
    uint wrapped = 4294967295;
    short low = -1;
    long cutDown = 4294967361;
    print("absent: {firstSurrogate as? char == null} {lastSurrogate as? char == null} "
        + "{past as? char == null} {negative as? char == null} {wrapped as? char == null} "
        + "{low as? char == null} {cutDown as? char == null}");
    char fallback = negative as? char ?? '?';
    char kept = letter as? char ?? '?';
    print("fallback: {fallback} {kept}");
    byte small = 65;
    char fromByte = small as char;
    print("from a byte: {fromByte}");
    return 0;
}
