// @expect-error is declared 'final' in
// @expect-error Method 'frozen' cannot be 'final': it is private to 'Base', so it is not inherited
// @expect-error build failed with 2 problems
// A 'final' method cannot be replaced. It has to be inheritable for the rule to bite at all, so
// the base marks it 'protected'; an unmarked one is private, so no subclass could reach it and
// there is no override for 'final' to forbid.
class Base {
    protected final greet() -> int { return 1; }

    final frozen() -> int { return 2; }
}

class Derived extends Base {
    override greet() -> int { return 4; }
}

main() -> int {
    return 0;
}
