// @expect-error is declared 'final' in
// @expect-error Method 'frozen' cannot be 'final': it is private to 'Base', so it is not inherited
// @expect-error Explicit 'throws' types are only allowed where the method can be overridden
// @expect-error build failed with 3 problems
// A 'final' method cannot be replaced. It has to be inheritable for the rule to bite at all, so
// the base marks it 'protected'; an unmarked one is private, so no subclass could reach it and
// there is no override for 'final' to forbid. The same holds for a declared throws list, which
// only means something where an override could have to honour it.
class Base {
    protected final greet() -> int { return 1; }

    final frozen() -> int { return 2; }

    read() -> int throws Failure { return 3; }
}

class Derived extends Base {
    override greet() -> int { return 4; }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

main() -> int {
    return 0;
}
