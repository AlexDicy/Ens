// @expect-error is declared 'final' in
// A 'final' method cannot be replaced. It has to be inheritable for the rule to bite at all, so
// the base marks it 'protected'; an unmarked one is private and no subclass could reach it.
class Base {
    protected final greet() -> int { return 1; }
}

class Derived extends Base {
    override greet() -> int { return 2; }
}

main() -> int {
    return 0;
}