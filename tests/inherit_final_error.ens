// @expect-error Cannot override 'greet', because it is declared 'final' in 'Base'. Rename this 'greet' and remove 'override', or remove 'final' from 'greet' in 'Base'.
// @expect-error Method 'frozen' cannot be 'final': it is private to 'Base', so no subclass can override it anyway
// @expect-error build failed with 2 problems
// A 'final' method cannot be replaced. An unmarked method of a 'public' class is private to it.
// No subclass can override such a method, so 'final' on it is refused.
public class Base {
    protected final greet() -> int { return 1; }

    final frozen() -> int { return 2; }
}

class Derived extends Base {
    protected override greet() -> int { return 4; }
}

main() -> int {
    return 0;
}
