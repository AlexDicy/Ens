// A syntax error inside one function body does not silence the semantic errors around it. Nothing
// outside a body can see what is in it, so every other declaration is analyzed and the reader is
// told everything wrong with the file at once instead of one round per fix. Only the function whose
// body the parser had to guess at goes unreported: 'value' never being used, and its type never
// being settled, are consequences of the syntax error rather than problems of their own.
// @expect-error Expected an expression, for example a value like '42', a variable name, or a call
// @expect-error Undefined function 'nowhere'
// @expect-error Cannot assign value of type 'int' to variable of type 'string'
// @expect-error No field or method 'missing' on type 'Box'
// @expect-error build failed with 5 problems
class Box {
    long width;
}

broken() {
    let value = 1 +
}

main() -> int {
    let found = nowhere();
    string text = 42;
    let box = new Box();
    let width = box.missing;
    return 0;
}
