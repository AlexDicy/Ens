// A syntax error inside one function body does not silence the semantic errors around it, because
// nothing outside a body can see what is in it. Only the function whose body the parser had to
// guess at goes unreported, since its problems are consequences of the syntax error.
// @expect-error Expected a value, such as '42', a variable's name or a call like 'count()'.
// @expect-error Undefined function 'nowhere'
// @expect-error Variable 'text' has type 'string', but its value has type 'int'.
// @expect-error Type 'Box' has no field or method named 'missing'.
// @expect-error build failed with 5 problems
class Box {
    long width;
}

broken() {
    let value = 1 +
}

main() -> int {
    let found = nowhere();
    string text = 42;
    let box = new Box();
    let width = box.missing;
    return 0;
}
