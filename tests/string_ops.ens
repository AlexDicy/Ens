// @exit 0
// @stdout eq-literal-concat
// @stdout neq
// @stdout len=11
// @stdout foobar!?
// @stdout 42 -7 0 true false
// @stdout bytes-roundtrip
// @stdout area = 100 for 20x5
// @stdout nested inner-5
// @stdout count: 5 ok=true
// Happy-path coverage for the string operations: content equality, length, concatenation chains,
// '.toString()', byte[] round-tripping, interpolation, and the implicit conversion an integer or
// bool operand of a concatenation takes.
main() -> int throws {
    let a = "foo";
    let b = "bar";
    if (("foo" + "bar") == "foobar") { print("eq-literal-concat"); }
    if (a != b) { print("neq"); }
    print("len=" + "hello world".length.toString());
    print(a + b + "!" + "?");
    print(42 + " " + -7 + " " + 0 + " " + true + " " + false);
    let bytes = "data".toBytes();
    if (try string.fromBytes(bytes) == "data") { print("bytes-roundtrip"); }
    let w = 20;
    let h = 5;
    print("area = {w * h} for {w}x{h}");
    print("nested {"inner-{h}"}");
    let count = 5;
    let ok = true;
    print("count: " + count + " ok=" + ok);
    return 0;
}
