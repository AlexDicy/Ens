// @exit 1
// @stdout-contains Unhandled exception SystemError: could not open file
// An uncaught SystemError prints a symbolicated trace and exits with status 1.
import @std.system;
import File from @std.system;

main() -> int throws {
    File reader = try system.openFile("build/tests/std_system_no_such_file_for_read.tmp", "r");
    return reader.close();
}
