// @stdout declared 3 null -5 200 65 1.5
// @stdout assigned 3 null
// @stdout argument 3 null
// @stdout returned 3 null
// @stdout field 3 null
// @stdout struct 3 null
// @stdout default 3
// @stdout lambda 3 null
// @stdout conditional 3 5 null
// @stdout switch 3 null
// @stdout array [3, null] [null, 3]
// @stdout list 3 null
// @stdout coalesce 3 3 null
// @stdout levels 3 inner-null outer-null
// @stdout wrapped 3 inner-null
// @stdout map 3 inner-null outer-null
// @stdout equality TFTF TFFT TTF
// @stdout overload int? long?
import List from @std.collections.list;
import Map from @std.collections.map;

// A nullable number converts the way its plain type does, at each level of null: an 'int?' widens
// to a 'long?' and an 'int??' to a 'long??', the payload widening only where it is present.

struct Reading {
    long? value;
}

class Meter {
    long? last;

    constructor(int? last) {
        this.last = last;
    }
}

maybe(bool present) -> int? {
    if (present) {
        return 3;
    }
    return null;
}

nested(int level) -> int?? {
    if (level == 0) {
        return null;
    }
    if (level == 1) {
        int? none = null;
        return none;
    }
    return 3;
}

widened(int? value) -> long? {
    return value;
}

widenedTwice(int?? value) -> long?? {
    return value;
}

unsignedWidened(byte? value) -> int? {
    return value;
}

codeOf(char? value) -> int? {
    return value;
}

halfOf(int? value) -> double {
    double? wide = value;
    return (wide ?? 0.0) / 2;
}

shown(long? value) -> string {
    return "{value}";
}

described(long?? value) -> string {
    if (value == null) {
        return "outer-null";
    }
    long? inner = value;
    if (inner == null) {
        return "inner-null";
    }
    return "{inner}";
}

defaulted(long? value = maybe(true)) -> string {
    return "{value}";
}

same(int? left, long right) -> string {
    return left == right ? "T" : "F";
}

sameNullable(int? left, long? right) -> string {
    return left == right ? "T" : "F";
}

sameAcross(int?? left, long? right) -> string {
    return left == right ? "T" : "F";
}

chosen(int? value) -> string {
    return "int?";
}

chosen(long? value) -> string {
    return "long?";
}

declarations() {
    long? present = maybe(true);
    long? absent = maybe(false);
    print("declared {present} {absent} {widened(-5)} {unsignedWidened(200)} {codeOf('A')} "
        + "{halfOf(3)}");
    long? total = 0L;
    total = maybe(true);
    long? cleared = 0L;
    cleared = maybe(false);
    print("assigned {total} {cleared}");
    print("argument {shown(maybe(true))} {shown(maybe(false))}");
    print("returned {widened(maybe(true))} {widened(maybe(false))}");
    let held = new Meter(maybe(true));
    let empty = new Meter(maybe(false));
    print("field {held.last} {empty.last}");
    Reading reading = {value: maybe(true)};
    Reading missing = {value: maybe(false)};
    print("struct {reading.value} {missing.value}");
    print("default {defaulted()}");
    (int?) -> long? widen = (value) -> value;
    print("lambda {widen(3)} {widen(null)}");
}

joins(bool flag) {
    let either = flag ? maybe(true) : 5L;
    let other = !flag ? maybe(true) : 5L;
    long? none = flag ? maybe(false) : null;
    print("conditional {either} {other} {none}");
    int code = flag ? 1 : 2;
    long? matched = switch (code) {
        1 -> maybe(true),
        default -> 0L,
    };
    long? unmatched = switch (code + 1) {
        1 -> 0L,
        default -> maybe(false),
    };
    print("switch {matched} {unmatched}");
    long?[] written = [maybe(true), maybe(false)];
    let inferred = [widened(maybe(false)), maybe(true)];
    print("array {written} {inferred}");
    let list = new List<long?>();
    list.push(maybe(true));
    list.push(maybe(false));
    print("list {list.get(0)} {list.get(1)}");
}

levels() {
    long?? deep = widenedTwice(nested(2));
    long? fromDeep = deep ?? maybe(false);
    long? fallback = widened(maybe(false)) ?? maybe(true);
    long? neither = widened(maybe(false)) ?? maybe(false);
    print("coalesce {fromDeep} {fallback} {neither}");
    print("levels {described(nested(2))} {described(nested(1))} {described(nested(0))}");
    print("wrapped {described(maybe(true))} {described(maybe(false))}");
    let counts = new Map<string, int?>();
    counts.set("held", 3);
    counts.set("empty", null);
    let held = counts.get("held");
    let empty = counts.get("empty");
    let missing = counts.get("missing");
    print("map {described(held)} {described(empty)} {described(missing)}");
}

main() {
    declarations();
    joins(true);
    levels();
    string plain = "{same(maybe(true), 3L)}{same(maybe(true), 4L)}{same(-1, -1L)}"
        + "{same(maybe(false), 3L)}";
    string nullable = "{sameNullable(maybe(true), 3L)}{sameNullable(maybe(true), null)}"
        + "{sameNullable(maybe(false), 3L)}{sameNullable(maybe(false), null)}";
    string across = "{sameAcross(nested(2), 3L)}{sameAcross(nested(1), null)}"
        + "{sameAcross(nested(0), null)}";
    print("equality {plain} {nullable} {across}");
    print("overload {chosen(maybe(true))} {chosen(widened(maybe(true)))}");
}
