// @expect-error Function 'add' is already declared with the same parameter types. Two functions can share a name only when their parameters differ in number or type. Rename one of them, or change the parameters of one.
add(int a, int b) -> int { return a + b; }
add(int x, int y) -> int { return x * y; }

main() -> int {
    return add(1, 2);
}
