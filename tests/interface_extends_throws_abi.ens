// @exit 0
// @stdout sub ok quiet:manifest
// @stdout ancestor ok quiet:chain
// @stdout failing err missing: ghost
// @stdout direct quiet:direct
// @stdout reload again
// A requirement inherited through 'extends' keeps the declaring rung's calling convention, so an
// implementation that drops the marker still carries the error slot and one that throws reports
// through it. Every edge to that one dispatch entry agrees.
public class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public interface Loader {
    load(string name) -> string throws Failure;
}

public interface Reloader extends Loader {
    reload() -> string;
}

public class Quiet implements Reloader {
    protected constructor();

    public override load(string name) -> string {
        return "quiet:" + name;
    }

    public override reload() -> string {
        return "again";
    }
}

public class Failing implements Reloader {
    protected constructor();

    public override load(string name) -> string throws Failure {
        throw new Failure("missing: " + name);
    }

    public override reload() -> string {
        return "never";
    }
}

throughSub(Reloader loader, string name) -> string {
    return "ok " + (try loader.load(name));
} catch (Failure e) {
    return "err " + e.message;
}

throughAncestor(Loader loader, string name) -> string {
    return "ok " + (try loader.load(name));
} catch (Failure e) {
    return "err " + e.message;
}

main() -> int {
    Reloader quiet = new Quiet();
    print("sub " + throughSub(quiet, "manifest"));
    print("ancestor " + throughAncestor(quiet, "chain"));
    print("failing " + throughSub(new Failing(), "ghost"));
    print("direct " + new Quiet().load("direct"));
    print("reload " + quiet.reload());
    return 0;
}
