// @exit 0
// @stdout shape:3
// @stdout pre:3
// @stdout square
// @stdout pre:4
// @stdout SQUARE
// @stdout scaled:8
// @stdout scaled2:9
// @stdout shape:4
// @stdout sum:5
// @stdout sum3:9
// @stdout bag:y
// @stdout bag:n
// @stdout named:7

class Shape {
    int sides;
    Shape() { this.sides = 0; }
    Shape(int s) { this.sides = s; }
    describe() -> string { return "shape:" + this.sides; }
    describe(string prefix) -> string { return prefix + ":" + this.sides; }
    scaled(int f) -> int { return this.sides * f; }
}

class Square extends Shape {
    Square() { super(4); }
    override describe() -> string { return "square"; }
    describe(bool upper) -> string { return upper ? "SQUARE" : "square"; }
    scaled(int f, int extra) -> int { return this.sides * f + extra; }
    viaSuper() -> string { return super.describe(); }
}

struct Point {
    int x;
    int y;
    sum() -> int { return this.x + this.y; }
    sum(int extra) -> int { return this.x + this.y + extra; }
}

class Bag {
    Bag() {}
    contains(int v) -> bool { return v == 1; }
    contains(string v) -> bool { return v.length > 1; }
}

main() -> int {
    Shape s = new Shape(3);
    print(s.describe());
    print(s.describe("pre"));
    Shape asBase = new Square();
    print(asBase.describe());
    print(asBase.describe("pre"));
    Square q = new Square();
    print(q.describe(true));
    print("scaled:" + q.scaled(2));
    print("scaled2:" + q.scaled(2, 1));
    print(q.viaSuper());
    Point p;
    p.x = 2;
    p.y = 3;
    print("sum:" + p.sum());
    print("sum3:" + p.sum(4));
    Bag bag = new Bag();
    print("bag:" + (bag.contains(1) ? "y" : "n"));
    print("bag:" + (bag.contains("y") ? "y" : "n"));
    Shape named = new Shape(s: 7);
    print("named:" + named.sides);
    return 0;
}
