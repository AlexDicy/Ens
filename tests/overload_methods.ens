// @exit 0
// @stdout shape:3
// @stdout pre:3
// @stdout square
// @stdout pre:4
// @stdout SQUARE
// @stdout scaled:8
// @stdout scaled2:9
// @stdout shape:4
// @stdout sum:5
// @stdout sum3:9
// @stdout bag:y
// @stdout bag:n
// @stdout named:7

class Shape {
    protected int sides;
    protected constructor() { this.sides = 0; }
    protected constructor(int s) { this.sides = s; }
    protected describe() -> string { return "shape:" + this.sides; }
    protected describe(string prefix) -> string { return prefix + ":" + this.sides; }
    protected scaled(int f) -> int { return this.sides * f; }
}

class Square extends Shape {
    protected constructor() { super(4); }
    protected override describe() -> string { return "square"; }
    protected describe(bool upper) -> string { return upper ? "SQUARE" : "square"; }
    protected scaled(int f, int extra) -> int { return this.sides * f + extra; }
    protected viaSuper() -> string { return super.describe(); }
}

struct Point {
    protected int x;
    protected int y;
    protected sum() -> int { return this.x + this.y; }
    protected sum(int extra) -> int { return this.x + this.y + extra; }
}

class Bag {
    protected constructor() {}
    protected contains(int v) -> bool { return v == 1; }
    protected contains(string v) -> bool { return v.length > 1; }
}

main() -> int {
    Shape s = new Shape(3);
    print(s.describe());
    print(s.describe("pre"));
    Shape asBase = new Square();
    print(asBase.describe());
    print(asBase.describe("pre"));
    Square q = new Square();
    print(q.describe(true));
    print("scaled:" + q.scaled(2));
    print("scaled2:" + q.scaled(2, 1));
    print(q.viaSuper());
    Point p = {x: 2, y: 3};
    print("sum:" + p.sum());
    print("sum3:" + p.sum(4));
    Bag bag = new Bag();
    print("bag:" + (bag.contains(1) ? "y" : "n"));
    print("bag:" + (bag.contains("y") ? "y" : "n"));
    Shape named = new Shape(s: 7);
    print("named:" + named.sides);
    return 0;
}
