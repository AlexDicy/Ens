import List from @std.collections.list;

class Node {
    constructor();
}

shared interface Named {
    name() -> string;
}

shared class Open {
    const int id;

    constructor(this.id);
}

shared abstract class Figure {
    protected constructor();
}

shared final class Counter {
    long count;
    const int[] items;
    const Node owner;
    const List<int> list;
    const (int) -> bool test;
    const Pair inner;
    const Named? named;
    const string label;

    constructor(this.items, this.owner, this.list, this.test, this.inner, this.label) {
        this.count = 0;
        this.named = null;
    }
}

struct Pair {
    int[] values;
    int plain;
}

shared final class Box<T> {
    const T held;

    constructor(this.held);
}

shared final class SafeBox<shared T> {
    const T held;

    constructor(this.held);
}

shared sealed class Shape {
    protected constructor();
}

final class Circle extends Shape {
    constructor() {
        super();
    }
}

final class Plain implements Named {
    constructor();

    override name() -> string {
        return "plain";
    }
}

struct Tag implements Named {
    int[] codes;

    override name() -> string {
        return "tag";
    }
}

class Base {
    int counter;

    constructor() {
        this.counter = 0;
    }
}

shared final class Derived extends Base {
    constructor() {
        super();
    }
}

keep<shared T>(T value) -> T {
    return value;
}

relay<T>(T value) -> T {
    return keep(value);
}

shared struct Point {
    int x;
}

shared enum Color {
    Red,
}

shared shout() {
}

final class Totals {
    shared int total;

    constructor() {
        this.total = 0;
    }
}

main() {
    let bad = new SafeBox<List<int>>(new List<int>());
    keep(new Node());
    keep(5);
    keep([1]);
}
