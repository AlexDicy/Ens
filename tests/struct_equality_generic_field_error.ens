// @expect-error 'compareBoxes<(int) -> int>' cannot compare two values of type 'Box<(int) -> int>' with '=='. Field 'value' has type '(int) -> int', which has no '=='; a function value has no identity. Use a type argument with an '==' of its own, or give 'Box' its own 'equals' and 'hash'.
// @expect-note 'compareBoxes<T>' compares two values of type 'Box<T>' with '==' here
// A generic struct compares memberwise only where its field type has its own '=='. The check
// cannot be decided on the open type parameter, so it defers to each instantiation, and an
// instantiation at a function type is what surfaces the error, at the call that wrote it.

external type Handle;

struct Box<T> {
    T value;
}

compareBoxes<T>(Box<T> a, Box<T> b) -> bool {
    return a == b;
}

useHandles(Box<Handle> a, Box<Handle> b) -> bool {
    return compareBoxes<Handle>(a, b);
}

useSteps(Box<(int) -> int> a, Box<(int) -> int> b) -> bool {
    return compareBoxes<(int) -> int>(a, b);
}

main() -> int {
    return 0;
}
