// @expect-error In 'compareBoxes<(int) -> int>': Struct 'Box' cannot be compared with '=='. Field 'value' has type '(int) -> int', which has no '=='
// A generic struct compares memberwise only where its field type has its own '=='. The check
// cannot be decided on the open type parameter, so it defers to each instantiation; instantiating
// 'Box' at a function type surfaces the error, while an instantiation at an external handle
// compares the handle by identity and passes.

external type Handle;

struct Box<T> {
    T value;
}

compareBoxes<T>(Box<T> a, Box<T> b) -> bool {
    return a == b;
}

useHandles(Box<Handle> a, Box<Handle> b) -> bool {
    return compareBoxes<Handle>(a, b);
}

useSteps(Box<(int) -> int> a, Box<(int) -> int> b) -> bool {
    return compareBoxes<(int) -> int>(a, b);
}

main() -> int {
    return 0;
}
