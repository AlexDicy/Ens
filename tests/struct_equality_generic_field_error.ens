// @expect-error Struct 'Box' cannot be compared with '=='. Field 'value'
// A generic struct compares memberwise only where its field type has its own
// '=='. The check cannot be decided on the open type parameter, so it defers to
// each instantiation; instantiating 'Box' at an external type surfaces the error.

external type Handle;

struct Box<T> {
    T value;
}

compareBoxes<T>(Box<T> a, Box<T> b) -> bool {
    return a == b;
}

useHandles(Box<Handle> a, Box<Handle> b) -> bool {
    return compareBoxes<Handle>(a, b);
}

main() -> int {
    return 0;
}
