// @expect-error 'compareBoxes<(int) -> int>' cannot compare two values of type 'Box<(int) -> int>' with '=='. Field 'value' has type '(int) -> int', which has no '=='; a function value has no identity. Use a type argument with an '==' of its own, or give 'Box' its own 'equals' and 'hash'.
// @expect-note 'compareBoxes<T>' compares two values of type 'Box<T>' with '==' here
// @expect-error 'hashBox<(int) -> int>' cannot hash a value of type 'Box<(int) -> int>'. Field 'value' has type '(int) -> int', which has no hash; a function value has no identity, so it has no hash. Use a type argument with a hash of its own, or give 'Box' its own 'equals' and 'hash'.
// @expect-note 'hashBox<T>' calls 'hash()' on a value of type 'Box<T>' here
// @expect-error 'Held<(int) -> int>' cannot compare two values of type 'Held<(int) -> int>' with '=='. Field 'value' has type '(int) -> int', which has no '=='; a function value has no identity. Use a type argument with an '==' of its own, or give 'Held' its own 'equals' and 'hash'.
// @expect-note 'Held<T>' compares two values of type 'Held<T>' with '==' here
// @expect-error 'Held<(int) -> int>' cannot hash a value of type 'Held<(int) -> int>'. Field 'value' has type '(int) -> int', which has no hash; a function value has no identity, so it has no hash. Use a type argument with a hash of its own, or give 'Held' its own 'equals' and 'hash'.
// @expect-note 'Held<T>' calls 'hash()' on a value of type 'Held<T>' here
// @expect-error build failed with 4 problems
// A generic struct compares and hashes memberwise only where its field types have an '==' and a
// hash of their own. A field whose type is the type parameter cannot be decided on the open
// type, so it defers to each instantiation, and an instantiation at a function type is what
// surfaces the error, at the call that wrote it. 'this' in a generic struct's method is judged
// per instantiation the same way.

external type Handle;

struct Box<T> {
    T value;
}

struct Held<T> {
    T value;

    same(Held<T> other) -> bool {
        return this == other && this.hash() == 0L;
    }
}

compareBoxes<T>(Box<T> a, Box<T> b) -> bool {
    return a == b;
}

hashBox<T>(Box<T> box) -> long {
    return box.hash();
}

useHandles(Box<Handle> a, Box<Handle> b) -> bool {
    return compareBoxes<Handle>(a, b);
}

useSteps(Box<(int) -> int> a, Box<(int) -> int> b) -> bool {
    return compareBoxes<(int) -> int>(a, b) && hashBox<(int) -> int>(a) == 0L;
}

useHeld(Held<int> numbers, Held<(int) -> int> steps) -> bool {
    return numbers.same(numbers) && steps.same(steps);
}

main() -> int {
    return 0;
}
