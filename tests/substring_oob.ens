// @exit 134
// @stderr-contains panic: tried to take the substring 1..9 of a string of 3 bytes. Check that the start is at least 0 and at most the end, and that the end is at most length
// An end offset past the string's length aborts inside the library's own check, which runs before
// the unchecked member the compiler guards.
main() -> int {
    let s = "abc";
    let t = s.substring(1, 9);
    print(t);
    return 0;
}
