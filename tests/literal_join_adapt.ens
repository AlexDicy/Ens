// @exit 0
// @stdout 250 0.5
// @stdout 3000000000 7
// @stdout 3000000000 18446744073709551615
// An explicit generic call gives an array literal argument its parameter type, so each literal in
// it takes the element type. An integer literal branch of a '?:' takes the type of the other
// branch, as a floating-point literal does, and a value too large for 'int' is written with an
// 'L' suffix or a cast.
firstOf<T>(T[] items) -> T {
    return items[0];
}

pick(bool flag, long wide, byte small) -> string {
    long chosen = flag ? wide : 3000000000;
    int widened = flag ? small : 7;
    return "{chosen} {widened}";
}

main() -> int {
    byte first = firstOf<byte>([250, 2]);
    float half = firstOf<float>([0.5, 2.5]);
    print("{first} {half}");
    print(pick(false, 1, 2));
    let suffixed = 3000000000L;
    let cast = 18446744073709551615 as ulong;
    print("{suffixed} {cast}");
    return 0;
}
