// @expect-error Method 'greet' of 'Person' implements a method declared in interface 'Greeter' but is not marked 'override'. Write 'override' before 'greet'.
interface Greeter {
    greet() -> string;
}

class Person implements Greeter {
    constructor();
    greet() -> string { return "hi"; }
}

main() -> int {
    return 0;
}
