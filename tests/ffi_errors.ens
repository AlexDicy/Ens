// @expect-error 'out' can only be used when calling an external function. Remove 'out' from the argument.
// @expect-error Parameter 'slot' of 'readInto' is an 'out' parameter, so it needs a variable to store into. Write 'out x'.
// @expect-error build failed with 2 problems
external from libc {
    abs(int x) -> int;

    readInto(out int slot) -> int;
}

regular(int n) -> int {
    return n;
}

main() -> int {
    int x = 0;
    // out is only valid on external functions.
    let y = regular(out x);
    // an 'out' parameter is passed as 'out <local>', never as a plain value.
    let filled = readInto(x);
    return abs(y) + filled;
}
