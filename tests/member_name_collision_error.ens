// @expect-error 'state' is already declared as a field of 'Resource'; a field and a method cannot share a name.
// @expect-error 'shared' is already declared as a field of 'Counter'; a field and a method cannot share a name.
// @expect-error 'total' is already declared as a field of 'Counter'; a field and a method cannot share a name.
// @expect-error Field 'y' is already declared in 'Pixel'.
// @expect-error 'x' is already declared as a field of 'Pixel'; a field and a method cannot share a name.
// @expect-error build failed with 5 problems
// A field and a method cannot share a name, and the message names the type that declares the
// field, which for an inherited one is the base class. A private base field is not inherited, so
// tests/inheritance.ens covers the method name it leaves free.
class Resource {
    int state;

    protected constructor(this.state = 0);

    protected state() -> int {
        return this.state;
    }
}

public class Counter {
    protected int shared;
    public int total;

    public constructor() {
        this.shared = 1;
        this.total = 2;
    }
}

public class Reported extends Counter {
    public constructor() {
        super();
    }

    protected shared() -> int {
        return 3;
    }

    public total() -> int {
        return 4;
    }
}

struct Pixel {
    int x;
    int y;
    int y;

    x() -> int {
        return this.x;
    }
}

main() -> int {
    return 0;
}