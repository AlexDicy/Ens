// @expect-error Struct 'Point' cannot declare a destructor. A destructor runs when the last reference to an object goes away, and a struct is copied, never referenced. Remove the destructor, or make 'Point' a class.
// Destructors are a class-only feature; structs keep only the synthesized field release.
struct Point {
    int x = 0;
    destructor() {
    }
}

main() -> int {
    return 0;
}
