export class Counter {
    // Three visibility tiers on one class, so a consuming package can pin what each reaches.
    long count;
    public long limit;
    protected long step;

    export constructor();

    export add(long amount) {
        this.count = this.count + amount;
    }

    export value() -> long {
        return this.count;
    }

    protected seed() -> long {
        return 7;
    }
}

export struct Badge {
    export string label;
    export int stars;
}
