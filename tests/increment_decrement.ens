// @exit 0
// @stdout post old=5 now=6
// @stdout pre new=7 now=7
// @stdout field 42
// @stdout this.field 43
// @stdout elem old=9 now=10
// @stdout index k=1 v=100
// @stdout while iters=3 m=-1
// @stdout float ok
// @stdout float post ok
// Happy-path coverage for '++'/'--': postfix yields the old value and prefix the
// new one, on a local, a class field (both 'obj.field' and 'this.field'), and an
// array element; 'arr[k++]' evaluates the index once; 'while (m-- > 0)' loops on
// the pre-decrement value; and increment works on a floating-point local too.
class Counter {
    protected int value;

    protected constructor(this.value);

    protected bump() {
        this.value++;
    }
}

main() -> int {
    int n = 5;
    int oldv = n++;
    print("post old={oldv} now={n}");
    int newv = ++n;
    print("pre new={newv} now={n}");

    let c = new Counter(41);
    c.value++;
    print("field {c.value}");
    c.bump();
    print("this.field {c.value}");

    int[] a = new int[3];
    a[2] = 9;
    int e = a[2]++;
    print("elem old={e} now={a[2]}");

    int[] b = new int[2];
    int k = 0;
    b[k++] = 100;
    print("index k={k} v={b[0]}");

    int m = 3;
    int iterations = 0;
    while (m-- > 0) {
        iterations = iterations + 1;
    }
    print("while iters={iterations} m={m}");

    double d = 2.5;
    d++;
    if (d == 3.5) {
        print("float ok");
    }
    double g = 3.5;
    double gold = g--;
    if (gold == 3.5 && g == 2.5) {
        print("float post ok");
    }
    return 0;
}
