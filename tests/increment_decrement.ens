// @exit 0
// @stdout post old=5 now=6
// @stdout pre new=7 now=7
// @stdout field 42
// @stdout this.field 43
// @stdout elem old=9 now=10
// @stdout index k=1 v=100
// @stdout while iters=3 m=-1
// @stdout float ok
// @stdout float post ok
// @stdout optional 6 6 0.5
// @stdout optional-narrowed 6
// @stdout paren 1
// @stdout paren-elem 1 1
// @stdout paren-field 3
// @stdout paren-recv 4
// Happy-path coverage for '++' and '--': postfix yields the old value and prefix the new one,
// whatever the target is. 'arr[k++]' evaluates the index once and 'while (m-- > 0)' loops on the
// pre-decrement value.
struct Corner {
    protected int x;
}

class Counter {
    protected int value;

    protected constructor(this.value);

    protected bump() {
        this.value++;
    }

    protected bumpThroughParentheses() {
        (this.value)++;
        ++((this).value);
    }
}

main() -> int {
    int n = 5;
    int oldv = n++;
    print("post old={oldv} now={n}");
    int newv = ++n;
    print("pre new={newv} now={n}");

    let c = new Counter(41);
    c.value++;
    print("field {c.value}");
    c.bump();
    print("this.field {c.value}");

    int[] a = new int[3];
    a[2] = 9;
    int e = a[2]++;
    print("elem old={e} now={a[2]}");

    int[] b = new int[2];
    int k = 0;
    b[k++] = 100;
    print("index k={k} v={b[0]}");

    int m = 3;
    int iterations = 0;
    while (m-- > 0) {
        iterations = iterations + 1;
    }
    print("while iters={iterations} m={m}");

    double d = 2.5;
    d++;
    if (d == 3.5) {
        print("float ok");
    }
    double g = 3.5;
    double gold = g--;
    if (gold == 3.5 && g == 2.5) {
        print("float post ok");
    }

    // A target declared optional and narrowed to its inner type steps the value under the
    // optional level and stores it back into the declared slot. The step leaves a value there,
    // so the location stays narrowed and the next line needs no second null check.
    int? maybe = 5;
    maybe++;
    int? held = 5;
    (held)++;
    double? fractional = 1.5;
    fractional--;
    print("optional {maybe} {held} {fractional}");

    int? stepped = 5;
    stepped++;
    --stepped;
    stepped += 1;
    print("optional-narrowed {stepped}");

    // Parentheses around what '++' or '--' changes name the same place, at any depth and on
    // either side of a member or an index hop, so each of these steps the place itself.
    int p = 1;
    (p)++;
    ((p))++;
    --(p);
    (p)--;
    print("paren {p}");

    int[] cells = new int[2];
    (cells[0])++;
    (cells)[1]++;
    print("paren-elem {cells[0]} {cells[1]}");

    Corner corner = {x: 1};
    (corner).x++;
    (corner.x)++;
    print("paren-field {corner.x}");

    let counter = new Counter(0);
    (counter).value++;
    (counter.value)++;
    counter.bumpThroughParentheses();
    print("paren-recv {counter.value}");
    return 0;
}
