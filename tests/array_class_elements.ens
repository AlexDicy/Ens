// @exit 42
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

slotValue(Box? b) -> int {
    if (b != null) {
        return b.v;
    }
    return 0;
}

main() -> int {
    Box?[] boxes = new Box?[3];
    boxes[0] = new Box(10);
    boxes[1] = new Box(15);
    boxes[2] = new Box(17);

    int sum = slotValue(boxes[0]) + slotValue(boxes[1]) + slotValue(boxes[2]);

    // Replace a slot: release old box, retain new.
    boxes[1] = new Box(20);
    int sum2 = slotValue(boxes[0]) + slotValue(boxes[1]) + slotValue(boxes[2]);

    // Drop a slot back to null - the array dtor still cleans up the rest.
    boxes[0] = null;
    if (slotValue(boxes[0]) != 0) { return 3; }

    if (sum != 42) { return 1; }
    if (sum2 != 47) { return 2; }
    return sum;
}