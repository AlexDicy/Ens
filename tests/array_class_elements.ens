// @exit 42
class Box {
    int v;
    Box(this.v = 0);
}

main() -> int {
    Box[] boxes = new Box[3];
    boxes[0] = new Box(10);
    boxes[1] = new Box(15);
    boxes[2] = new Box(17);

    int sum = boxes[0].v + boxes[1].v + boxes[2].v;
    // Replace a slot: release old box, retain new.
    boxes[1] = new Box(20);
    int sum2 = boxes[0].v + boxes[1].v + boxes[2].v;

    if (sum != 42) { return 1; }
    if (sum2 != 47) { return 2; }
    return sum;
}
