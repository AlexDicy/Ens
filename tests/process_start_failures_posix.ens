// @platform linux macos
// @exit 0
// @stdout could not start '<scratch>/plain': it does not start the way a program does. If it is a script, make its first line name the program that runs it, as in '#!/bin/sh'
// @stdout could not start '<scratch>/chained': its first line names '<scratch>/plain', which is not a program this system can run. Make the first line name a program, as in '#!/bin/sh'
// @stdout could not start '<scratch>/interpreted': its first line names '/no/such/interpreter', which is not there. Correct the first line, or install that program
// @stdout could not start '<scratch>/locked': permission was refused. Make the file executable, as with 'chmod +x', or start it as a user who may run it
// @stdout could not start '<scratch>/over-data': its first line names '<scratch>/data.bin', which this user may not run. Make '<scratch>/data.bin' executable, as with 'chmod +x', or make the first line name a program this user may run
// What a start reports for a file that may run but does not start as a program, and for a program
// nobody may run or read, which only a system with permission to run a file has. The scratch
// folder differs from run to run, so it is written as a placeholder.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import TemporaryDirectory from @std.fs.temporary;
import @std.environment;
import ProcessError from @std.process;
import @std.process;

main() -> int {
    let scratch = try TemporaryDirectory.create("ens-start-failures-posix");
    Path root = scratch.path();
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("this system did not report the path of this program");
        return 1;
    }
    Path plain = root.join("plain");
    Path chained = root.join("chained");
    Path interpreted = root.join("interpreted");
    Path locked = root.join("locked");
    Path data = root.join("data.bin");
    Path overData = root.join("over-data");
    try plain.writeText("echo no first line\n");
    try chained.writeText("#!{plain}\nexit 0\n");
    try interpreted.writeText("#!/no/such/interpreter\nexit 0\n");
    try self.copyTo(locked);
    try data.writeText("not a program");
    try overData.writeText("#!{data}\nexit 0\n");
    let made = try process.runShell("chmod +x '{plain}' '{chained}' '{interpreted}' '{overData}' "
        + "&& chmod 000 '{locked}'");
    if (!made.status.succeeded()) {
        eprint("the files were not given their permissions");
        return 1;
    }
    for (let program in [plain, chained, interpreted, locked, overData]) {
        print(failureOf(program).replace(root.toString(), "<scratch>"));
    }
    return 0;
} catch (FileSystemError refused) {
    eprint("process_start_failures_posix: {refused.message}");
    return 1;
} catch (ProcessError refused) {
    eprint("process_start_failures_posix: {refused.message}");
    return 1;
}

// The message the start of `program` failed with.
failureOf(Path program) -> string {
    let result = try process.run(program);
    return "'{program}' started";
} catch (ProcessError refused) {
    return refused.message;
}
