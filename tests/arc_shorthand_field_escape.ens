// @stdout kept 3
// @stdout first 7
// @exit 0
// A `this.field` shorthand parameter stores its argument into the field, so an array a method builds
// and hands to such a constructor outlives the method. Nothing about the constructor's own body says
// so, because it has none, which is exactly the case that has to be got right: a caller that read the
// parameter as never leaving the constructor would keep the array where the method's frame lives and
// leave the object pointing at it.
final class Box {
    long[] held;

    protected constructor(this.held);

    protected items() -> long[] {
        return this.held;
    }
}

final class Maker {
    protected constructor() { }

    protected make() -> Box {
        long[] listed = [7, 8, 9];
        return new Box(listed);
    }
}

main() -> int {
    let box = new Maker().make();
    print("kept {box.items().length}");
    print("first {box.items()[0]}");
    return 0;
}
