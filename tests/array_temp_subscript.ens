// @exit 0
// @stdout first: alpha
// @stdout last: gamma
// @stdout element outlives its array: alpha
// @stdout marks: 1 2
// @stdout written: delta
// Indexing an array an expression just produced: the array is a temporary nobody
// holds, so the element read out of it has to outlive the read while the array
// itself is given up exactly once, whether the element is a string or an object.
class Watcher {
    protected int mark;
    protected constructor(this.mark);

    protected value() -> int {
        return this.mark;
    }
}

names() -> string[] {
    return ["alpha", "beta", "gamma"];
}

watchers() -> Watcher[] {
    return [new Watcher(1), new Watcher(2)];
}

main() -> int {
    print("first: " + names()[0]);
    print("last: " + names()[names().length - 1]);
    string kept = names()[0];
    print("element outlives its array: " + kept);
    print("marks: {watchers()[0].value()} {watchers()[1].value()}");

    string[] mutable = names();
    mutable[1] = "delta";
    print("written: " + mutable[1]);
    return 0;
}
