// @expect-error '\u' must be followed by four hexadecimal digits, the code of a character. Write the code after '\u', for example '\u00E9' for 'é'.
// A \u escape needs exactly four hex digits: reject a non-hex digit and a
// sequence that is truncated before four digits.
main() -> int {
    let nonHex = "\uZZZZ";
    let truncated = "\u12";
    return 0;
}
