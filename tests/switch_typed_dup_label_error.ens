// @expect-error This switch already has an arm for '65'. Remove this second one.
// 65, 65L, and 'A' all name the same integer label (value 65), so listing more
// than one is a duplicate regardless of which literal form each is written in.
kind(long n) -> int {
    return switch (n) {
        65 -> 1,
        65L -> 2,
        'A' -> 3,
        default -> 0,
    };
}

main() -> int {
    return kind(65);
}
