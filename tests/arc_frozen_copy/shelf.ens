// A shelf of names, frozen once while its field still refers to the list and once from a list
// built in a local and frozen at its last use.
import List from @std.collections.list;
import FrozenList from @std.collections.frozen;

export class Shelf {
    List<string> names = new List<string>();

    export constructor();

    export add(string name) {
        this.names.push(name);
    }

    export snapshot() -> FrozenList<string> {
        return this.names.frozen();
    }
}

export built() -> FrozenList<string> {
    let names = new List<string>();
    names.push("a");
    return names.frozen();
}
