import @std.testing;
import Shelf from shelf;
import shelf;

test "a snapshot keeps the names the shelf had" {
    let books = new Shelf();
    books.add("a");
    let before = books.snapshot();
    books.add("b");
    try testing.assertEqual(before.length(), 1L);
    try testing.assertEqual(books.snapshot().length(), 2L);
}

test "a list frozen at its last use keeps its names" {
    try testing.assertEqual(shelf.built().get(0), "a");
}
