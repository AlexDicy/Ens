// @exit 0
// @stdout kinds 0 0 1 2 2
// @stdout piped input has no reader: error 0
// @stdout child exited 0
// The console bridges where no console is: a standard input that is a pipe is given no reader on
// any system, and a Win32 number from a stream read is classified by its own table, where 32 and 4
// are not the C runtime's broken pipe and interrupted call.
import Path from @std.fs;
import @std.environment;

shared external type Child;
shared external type ConsoleReader;
external type CFile;

external from libc {
    ens_console_open(CFile stream, out int error) -> ConsoleReader?;
    ens_console_release(ConsoleReader reader);
    ens_io_win32_kind(int code) -> int;
    ens_standard_input() -> CFile;
    ens_process_start(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes, int environmentGiven, string workingDirectory,
                      int stdinMode, int stdoutMode, int stderrMode, out int error) -> Child?;
    ens_process_read(Child child, int stream, byte[] buffer, long capacity,
                     out long count) -> int;
    ens_process_close_input(Child child) -> int;
    ens_process_wait(Child child, out int code, out int signal) -> int;
    ens_process_release(Child child);
}

// The child's side: its standard input is the pipe its parent made.
openPipedInput() -> int {
    int error = -1;
    ConsoleReader? reader = ens_console_open(ens_standard_input(), out error);
    if (reader != null) {
        print("piped input has a reader");
        ens_console_release(reader);
        return 1;
    }
    print("piped input has no reader: error {error}");
    return 0;
}

argumentBlock(string[] values) -> byte[] {
    long total = 0;
    for (let value in values) {
        total = total + value.length + 1;
    }
    byte[] block = new byte[total];
    long at = 0;
    for (let value in values) {
        let data = value.toBytes();
        for (long i = 0; i < data.length; i++) {
            block[at] = data[i];
            at++;
        }
        block[at] = 0;
        at++;
    }
    return block;
}

// Starts this program again with its input and output piped, and prints what it said.
runChild() -> bool {
    Path? self = environment.executablePath();
    if (self == null) {
        return false;
    }
    string program = self.toString();
    int error = 0;
    Child? child = ens_process_start(program, argumentBlock([program, "child"]), 2,
        "\"{program}\" child", new byte[0], 0, 0, 0, "", 1, 1, 0, out error);
    if (child == null) {
        print("the child did not start: error {error}");
        return false;
    }
    string said = "";
    byte[] buffer = new byte[256];
    while (true) {
        long count = 0;
        if (ens_process_read(child, 1, buffer, buffer.length, out count) != 0 || count == 0) {
            break;
        }
        said = said + string.fromBytesLossy(bytes.of(buffer.slice(0, count)));
    }
    print(said.trim());
    ens_process_close_input(child);
    int code = 0;
    int signal = 0;
    let waited = ens_process_wait(child, out code, out signal);
    ens_process_release(child);
    print("child exited {code}");
    return waited == 0;
}

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length > 0 && arguments[0] == "child") {
        return openPipedInput();
    }
    print("kinds {ens_io_win32_kind(109)} {ens_io_win32_kind(232)} {ens_io_win32_kind(995)} "
        + "{ens_io_win32_kind(32)} {ens_io_win32_kind(4)}");
    return runChild() ? 0 : 1;
}
