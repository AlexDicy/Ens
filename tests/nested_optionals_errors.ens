// @expect-error Cannot interpolate a value of type 'string??', because it may be null at more than one level. Check 'value' for null first ('if (value != null)').
// @expect-error Cannot interpolate a value of type 'int[]??', because it may be null at more than one level. Check 'value' for null first ('if (value != null)').
// @expect-error '?.' checks for one level of null, but the value on its left has type 'Node??', which can be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error '?[' checks for one level of null, but the value on its left has type 'int[]??', which can be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let rowsValue = rows.value();') and check the local.
// @expect-error Cannot index 'int[]??' because it may be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let rowsValue = rows.value();') and check the local twice, once for each '?' ('if (rowsValue != null) { if (rowsValue != null) { ... } }').
// @expect-error Cannot read a member of 'Node??' because it may be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local twice, once for each '?' ('if (nodesValue != null) { if (nodesValue != null) { ... } }').
// @expect-error Cannot interpolate a value of type 'string??', because it may be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let textsValue = texts.value();') and check the local.
// @expect-error Cannot use 'is' on a value of type 'Node??', because 'is' checks for only one level of null. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error Cannot use 'as?' on a value of type 'Node??', because 'as?' checks for only one level of null. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error Variable 'wrongLevel' has type 'string?', but its value has type 'string??'. The value may be null here. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let textsValue = texts.value();') and check the local.
// @expect-error Cannot switch on a value of type 'Node??': a 'null ->' arm covers one level of null, and this value may be null at more than one. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error 'for (... in ...)' cannot iterate 'int[]??' because it may be null at more than one level. Each call to 'value' returns its own result. A later call can return null even after a null check on an earlier one. Store the result in a local first ('let rowsValue = rows.value();') and check the local twice, once for each '?' ('if (rowsValue != null) { if (rowsValue != null) { ... } }').
// @expect-error The type after 'as?' cannot be nullable, because 'as? Node' already produces 'Node?'. Write 'as? Node'.
// @expect-error 'small as long' has type 'long', which can never be null, so the fallback after '??' is never used. Remove '?? 7'.
// @expect-error build failed with 15 problems

// Nested optionals: every operator that checks for one level of null refuses a value that can be
// null at two, and names the check that removes the extra level. A nullable target for 'as?' stays rejected,
// whether the value being cast has one nullable level or two.

class Node {
    protected int id;

    protected constructor(this.id);
}

class Slot<T> {
    protected T? stored;

    protected constructor(this.stored = null);

    protected value() -> T? {
        return this.stored;
    }
}

// A parameter carries its declared level with nothing narrowing it, so a hole holding one is
// refused whatever its payload would print as.
describeText(string?? value) -> string {
    return "text {value}";
}

describeRows(int[]?? value) -> string {
    return "rows {value}";
}

main() -> int {
    let nodes = new Slot<Node?>(new Node(1));
    let texts = new Slot<string?>("text");
    let rows = new Slot<int[]?>([1, 2]);

    long viaSafeMember = nodes.value()?.id ?? -1;
    long viaSafeIndex = rows.value()?[0] ?? -1;
    long viaIndex = rows.value()[0];
    long viaMember = nodes.value().id;
    print("hole {texts.value()}");
    bool viaIs = nodes.value() is Node;
    let viaCast = nodes.value() as? Node;
    string? wrongLevel = texts.value();
    long viaSwitch = switch (nodes.value()) {
        is Node node -> node.id,
        null -> 0,
    };
    for (let row in rows.value()) {
        print("row {row}");
    }

    Node? plain = new Node(2);
    let nullableTarget = plain as? Node?;
    let nestedNullableTarget = nodes.value() as? Node?;

    // The '??' belongs to the expression rather than to the cast target, so the complaint is
    // about the operator's left side and names the type the cast produced.
    int small = 4;
    long widened = small as long ?? 7;
    return 0;
}
