// @expect-error Cannot interpolate a value of type 'string??', because it may be null at more than one level. Check 'value' for null first ('if (value != null)').
// @expect-error Cannot interpolate a value of type 'int[]??', because it may be null at more than one level. Check 'value' for null first ('if (value != null)').
// @expect-error '?.' checks for one level of null, but the value on its left has type 'Node??', which can be null at more than one level. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error '?[' checks for one level of null, but the value on its left has type 'int[]??', which can be null at more than one level. Store the result in a local first ('let rowsValue = rows.value();') and check the local.
// @expect-error Cannot index 'int[]??' because it may be null at more than one level. Store the result in a local first ('let rowsValue = rows.value();'). A null check of the local tests only its outer level, so check it, then copy it into an 'int[]?' local and check that ('if (rowsValue != null) { let value = rowsValue; if (value != null) { ... } }').
// @expect-error Cannot read a member of 'Node??' because it may be null at more than one level. Store the result in a local first ('let nodesValue = nodes.value();'). A null check of the local tests only its outer level, so check it, then copy it into a 'Node?' local and check that ('if (nodesValue != null) { let value = nodesValue; if (value != null) { ... } }').
// @expect-error Cannot interpolate a value of type 'string??', because it may be null at more than one level. Store the result in a local first ('let textsValue = texts.value();') and check the local.
// @expect-error Cannot use 'is' on a value of type 'Node??', because 'is' checks for only one level of null. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error Cannot use 'as?' on a value of type 'Node??', because 'as?' checks for only one level of null. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error Variable 'wrongLevel' has type 'string?', but its value has type 'string??'. 'texts.value()' can return null. Store the result in a local first ('let textsValue = texts.value();') and check the local.
// @expect-error Cannot switch on a value of type 'Node??': a 'null ->' arm covers one level of null, and this value may be null at more than one. Store the result in a local first ('let nodesValue = nodes.value();') and check the local.
// @expect-error 'for (... in ...)' cannot iterate 'int[]??' because it may be null at more than one level. Store the result in a local first ('let rowsValue = rows.value();'). A null check of the local tests only its outer level, so check it, then copy it into an 'int[]?' local and check that ('if (rowsValue != null) { let value = rowsValue; if (value != null) { ... } }').
// @expect-error The type after 'as?' cannot be nullable, because 'as? Node' already produces 'Node?'. Write 'as? Node'.
// @expect-error 'small as long' has type 'long', which can never be null, so the fallback after '??' is never used. Remove '?? 7'.
// @expect-error Function 'fallenBack' returns 'string', but this value has type 'string?'. 'held' has type 'string??', and '??' replaces null only at its outer level, so 'held ?? "none"' is a 'string?'. Take both levels off, as in '(held ?? null) ?? "none"'.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'held' is declared as 'string??', but it is a 'string?' here, because its outer level is not null. A null check of 'held' tests only that outer level. Copy it into a 'string?' local and check that ('let value = held; if (value != null) { ... }').
// @expect-error Function 'fallenBackDeep' returns 'string', but this value has type 'string??'. 'held' has type 'string???', and '??' replaces null only at its outer level, so 'held ?? "none"' is a 'string??'. Take every level off, as in '((held ?? null) ?? null) ?? "none"'.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'held' is declared as 'string??', but its initial value 'maybeText()' has type 'string?', one level fewer, so the outer level of 'held' is never null. Declare 'held' as 'string?' ('string? held = maybeText();') and check it for null.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'held' is declared as 'string???', but it is a 'string?' here, because its two outer levels are not null. A null check of 'held' tests only the outermost of them. Copy it into a 'string?' local and check that ('let value = held; if (value != null) { ... }').
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'node' is null. 'node' is declared as 'Node??', but it is a 'Node?' here, because its outer level is not null. A null check of 'node' tests only that outer level. Copy it into a 'Node?' local and check that, as in 'let value = node; if (value != null) { value.id = ...; }'.
// @expect-error Cannot read a member of 'string??' because it may be null at more than one level. 'text' is declared as 'string???', but it is a 'string??' here, because its outer level is not null. A null check of 'text' tests only that outer level. Copy it into a 'string??' local and check that, then copy that into a 'string?' local and check that ('let value = text; if (value != null) { let value2 = value; if (value2 != null) { ... } }').
// @expect-error Cannot read a member of 'string???' because it may be null at more than one level. 'text' is declared as 'string????', but it is a 'string???' here, because its outer level is not null. A null check of 'text' tests only that outer level. Check a copy of it, then a copy of that copy, and so on, once for each '?' in 'string???' ('let value = text; if (value != null) { let value2 = value; if (value2 != null) { let value3 = value2; if (value3 != null) { ... } } }').
// @expect-error '+' joins a string only when neither side can be null, but 'first' and 'second' both have type 'string?'. 'first' and 'second' are declared as 'string??', and their outer levels are not null here. A null check of 'first' or 'second' tests only that outer level. Copy them into 'string?' locals and check those ('let leftValue = first; let rightValue = second; if (leftValue != null && rightValue != null) { ... }').
// @expect-error Cannot read a member of 'string?' because it may be null here. 'held' is declared as 'string??', but it is a 'string?' here, because its outer level is not null. A '??' after 'held' tests only that outer level, so take that level off with '(held ?? null)' before the fallback, as in '((held ?? null) ?? "").length'. Or read 'length' with '?.', as in 'held?.length ?? 0'.
// @expect-error build failed with 25 problems

// Nested optionals: every operator that checks for one level of null refuses a value that can be
// null at two, and names the check that removes the extra level. A nullable target for 'as?' stays rejected,
// whether the value being cast has one nullable level or two. A null check, and '??', test only the outer
// level, so checking the same value twice leaves its inner level for a copy to check.

class Node {
    protected int id;

    protected constructor(this.id);
}

class Slot<T> {
    protected T? stored;

    protected constructor(this.stored = null);

    protected value() -> T? {
        return this.stored;
    }
}

// A parameter carries its declared level with nothing narrowing it, so a hole holding one is
// refused whatever its payload would print as.
describeText(string?? value) -> string {
    return "text {value}";
}

describeRows(int[]?? value) -> string {
    return "rows {value}";
}

rechecked(string?? held) -> long {
    if (held != null && held != null) {
        return held.length;
    }
    return 0;
}

fallenBack(string?? held) -> string {
    if (held == null) {
        return "";
    }
    return held ?? "none";
}

fallenBackDeep(string??? held) -> string {
    return held ?? "none";
}

maybeText() -> string? {
    return null;
}

// A local that only its initial value writes is declared without the levels that value fills, and one
// written again is copied before its check.
initialized() -> long {
    string?? held = maybeText();
    return held.length;
}

rewritten(bool reset) -> long {
    string??? held = maybeText();
    long length = held.length;
    if (reset) {
        held = null;
    }
    return length;
}

written(Node?? node) {
    if (node != null) {
        node?.id = 3;
    }
}

deep(string??? text) -> long {
    if (text != null) {
        return text.length;
    }
    return 0;
}

deeper(string???? text) -> long {
    if (text != null) {
        return text.length;
    }
    return 0;
}

paired(string?? first, string?? second) -> string {
    if (first != null && second != null) {
        return first + second;
    }
    return "";
}

// Where no statement can go, '?? null' takes the outer level off before the fallback.
captured(string?? held) -> () -> long {
    if (held != null) {
        return () -> held.length;
    }
    return () -> 0;
}

main() -> int {
    let nodes = new Slot<Node?>(new Node(1));
    let texts = new Slot<string?>("text");
    let rows = new Slot<int[]?>([1, 2]);

    long viaSafeMember = nodes.value()?.id ?? -1;
    long viaSafeIndex = rows.value()?[0] ?? -1;
    long viaIndex = rows.value()[0];
    long viaMember = nodes.value().id;
    print("hole {texts.value()}");
    bool viaIs = nodes.value() is Node;
    let viaCast = nodes.value() as? Node;
    string? wrongLevel = texts.value();
    long viaSwitch = switch (nodes.value()) {
        is Node node -> node.id,
        null -> 0,
    };
    for (let row in rows.value()) {
        print("row {row}");
    }

    Node? plain = new Node(2);
    let nullableTarget = plain as? Node?;
    let nestedNullableTarget = nodes.value() as? Node?;

    // The '??' belongs to the expression rather than to the cast target, so the complaint is
    // about the operator's left side and names the type the cast produced.
    int small = 4;
    long widened = small as long ?? 7;
    return 0;
}
