// @expect-error The value on the left of '?.' has type 'Node??', which is nullable at more than one level, and '?.' looks through only one. Unwrap one level first: check the value for null ('if (value != null)') or supply a fallback ('value ?? null'), then use '?.' on the 'Node?' that remains.
// @expect-error The value on the left of '?[' has type 'int[]??', which is nullable at more than one level, and '?[' looks through only one. Unwrap one level first: check the value for null ('if (value != null)') or supply a fallback ('value ?? null'), then index the 'int[]?' that remains.
// @expect-error Cannot index 'int[]??' because it may be null at more than one level. Unwrap one level first: check it for null ('if (value != null)') or supply a fallback ('value ?? null'), then index the 'int[]?' that remains.
// @expect-error Cannot read a member of 'Node??' because it may be null at more than one level. Unwrap one level at a time, with a null check ('if (value != null)') or a fallback ('value ?? null'), until what remains is 'Node'.
// @expect-error Cannot interpolate a value of type 'string??' because it may be null at more than one level. Unwrap one level at a time, with a null check ('if (value != null)') or a fallback ('value ?? null'), until what remains is 'string'.
// @expect-error Cannot use 'is' on a value of type 'Node??', which is nullable at more than one level, and 'is' looks through only one. Unwrap one level first: check the value for null ('if (value != null)') or supply a fallback ('value ?? null'), then test the 'Node?' that remains.
// @expect-error Cannot use 'as?' on a value of type 'Node??', which is nullable at more than one level, and 'as?' looks through only one. Unwrap one level first: check the value for null ('if (value != null)') or supply a fallback ('value ?? null'), then test the 'Node?' that remains.
// @expect-error Cannot assign value of type 'string??' to variable of type 'string?'. The value may be null here; check it first ('if (value != null)'), or supply a fallback with '??'.
// @expect-error Cannot switch on a value of type 'Node??' because it may be null at more than one level, and a 'null ->' arm covers only the outer one. Unwrap one level first: check the value for null ('if (value != null)') or supply a fallback ('value ?? null'), then switch on the 'Node?' that remains.
// @expect-error 'for (... in ...)' cannot iterate 'int[]??' because it may be null at more than one level. Unwrap one level at a time, with a null check ('if (value != null)') or a fallback ('value ?? null'), until what remains is 'int[]'.
// @expect-error The target of 'as?' cannot be nullable; 'as? Node' already produces 'Node?'. Write the target without its '?', as 'as? Node'.
// @expect-error Left of '??' must be a nullable value, got 'long'. '??' supplies a fallback for null, so remove it here, or make the left side nullable.
// @expect-error Cannot interpolate a value of type 'int[]??' because it may be null at more than one level. Unwrap one level at a time, with a null check ('if (value != null)') or a fallback ('value ?? null'), until what remains is 'int[]'.
// @expect-error build failed with 15 problems

// Nested optionals: every operator that looks through one nullable level rejects a value that
// has two, and names the level to unwrap first. A nullable target for 'as?' stays rejected,
// whether the value being cast has one nullable level or two.

class Node {
    protected int id;

    protected constructor(this.id);
}

class Slot<T> {
    protected T? stored;

    protected constructor(this.stored = null);

    protected value() -> T? {
        return this.stored;
    }
}

// A parameter carries its declared level with nothing narrowing it, so a hole holding one is
// refused whatever its payload would print as.
describeText(string?? value) -> string {
    return "text {value}";
}

describeRows(int[]?? value) -> string {
    return "rows {value}";
}

main() -> int {
    let nodes = new Slot<Node?>(new Node(1));
    let texts = new Slot<string?>("text");
    let rows = new Slot<int[]?>([1, 2]);

    long viaSafeMember = nodes.value()?.id ?? -1;
    long viaSafeIndex = rows.value()?[0] ?? -1;
    long viaIndex = rows.value()[0];
    long viaMember = nodes.value().id;
    print("hole {texts.value()}");
    bool viaIs = nodes.value() is Node;
    let viaCast = nodes.value() as? Node;
    string? wrongLevel = texts.value();
    long viaSwitch = switch (nodes.value()) {
        is Node node -> node.id,
        null -> 0,
    };
    for (let row in rows.value()) {
        print("row {row}");
    }

    Node? plain = new Node(2);
    let nullableTarget = plain as? Node?;
    let nestedNullableTarget = nodes.value() as? Node?;

    // The '??' belongs to the expression rather than to the cast target, so the complaint is
    // about the operator's left side and names the type the cast produced.
    int small = 4;
    long widened = small as long ?? 7;
    return 0;
}
