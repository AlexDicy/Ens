// @expect-error A method named 'toString' must have the signature 'toString() -> string'
// A struct renders as text through 'toString', so one that cannot be called with no arguments for
// a 'string' result could never produce that text. The shape is pinned where the method is
// declared, so the struct never has a text form nothing can use.

public struct Point {
    int x;

    public override toString(int width) -> string {
        return "wide";
    }
}

describe(Point p) -> string {
    return "point {p}";
}

main() -> int {
    return 0;
}
