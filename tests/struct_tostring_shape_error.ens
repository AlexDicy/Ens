// @expect-error Struct 'Point' declares its own 'toString', so interpolating a 'Point' calls that method, but it cannot produce the text
// A struct that declares 'toString' renders through it, so a 'toString' that cannot
// be called with no arguments for a 'string' result leaves the hole with nothing to
// render; falling back to the JSON form would make an interpolation hole and an
// explicit call disagree.

public struct Point {
    int x;

    public toString(int width) -> string {
        return "wide";
    }
}

describe(Point p) -> string {
    return "point {p}";
}

main() -> int {
    return 0;
}
