export class Slots<T> {
    T[] cells;

    export constructor(long size) {
        this.cells = new T[size];
    }

    export count() -> long {
        return this.cells.length;
    }
}

export class Outer<T> {
    Slots<T> inner;

    export constructor(long size) {
        this.inner = new Slots<T>(size);
    }

    export count() -> long {
        return this.inner.count();
    }
}

export class Filled<T> {
    T[] cells;

    export constructor(T value, long size) {
        T[] filled = new T[size];
        for (long index = 0; index < filled.length; index++) {
            filled[index] = value;
        }
        this.cells = filled;
    }

    export count() -> long {
        return this.cells.length;
    }
}

export allocate<T>(long size) -> T[] {
    return new T[size];
}
