// @exit 0
// @stdout released first cur
// @stdout released a cur, cur holds b cur
// @stdout now b cur
// @stdout released unused
// @stdout released first element
// @stdout released a element, element holds b element
// @stdout now b element
// @stdout released unused
// @stdout released first pair
// @stdout released a pair, pair holds b pair
// @stdout now b pair
// @stdout released unused
// @stdout released b cur, cur holds a cur
// @stdout released a cur, cur holds b cur
// @stdout released b cur, cur holds c cur
// @stdout now c cur
// @stdout released unused
// @stdout released b element, element holds a element
// @stdout released a element, element holds b element
// @stdout released b element, element holds c element
// @stdout now c element
// @stdout released unused
// @stdout released b pair, pair holds a pair
// @stdout released a pair, pair holds b pair
// @stdout released b pair, pair holds c pair
// @stdout now c pair
// @stdout released unused
// @stdout released c cur
// @stdout released c element
// @stdout released c pair
// @stdout done
// @stdout released direct cur
// @stdout released direct element
// @stdout released direct pair
// An assignment stores the new value before it releases the old one, so a destructor the release
// runs finds the new value in the field, the element or the struct field it was replaced in, and
// a value that destructor writes there stays and is released once, at the end.
class Item {
    string label;
    weak Watch? owner;
    string place;
    bool rewrite;

    constructor(this.label, Watch? owner, this.place) {
        this.owner = owner;
        this.rewrite = false;
    }

    destructor() {
        let watch = this.owner;
        if (watch == null) {
            print("released " + this.label);
            return;
        }
        print("released " + this.label + ", " + this.place + " holds " + watch.read(this.place));
        if (this.rewrite) {
            this.rewrite = false;
            watch.write(this.place, new Item("c " + this.place, null, ""));
        }
    }
}

struct Pair {
    Item item;
}

class Watch {
    Item cur;
    Item[] items;
    Pair pair;

    constructor() {
        this.cur = new Item("first cur", null, "");
        this.items = [new Item("first element", null, "")];
        this.pair = {item: new Item("first pair", null, "")};
    }

    read(string place) -> string {
        return switch (place) {
            "cur" -> this.cur.label,
            "element" -> this.items[0].label,
            default -> this.pair.item.label,
        };
    }

    write(string place, Item item) {
        switch (place) {
            "cur" -> {
                this.cur = item;
            },
            "element" -> {
                this.items[0] = item;
            },
            default -> {
                this.pair.item = item;
            },
        }
    }
}

replaceTwice(Watch watch, string place, bool rewrite) {
    let old = new Item("a " + place, watch, place);
    old.rewrite = rewrite;
    watch.write(place, old);
    old = new Item("unused", null, "");
    watch.write(place, new Item("b " + place, watch, place));
    print("now " + watch.read(place));
}

main() -> int {
    let watch = new Watch();
    replaceTwice(watch, "cur", false);
    replaceTwice(watch, "element", false);
    replaceTwice(watch, "pair", false);
    replaceTwice(watch, "cur", true);
    replaceTwice(watch, "element", true);
    replaceTwice(watch, "pair", true);
    watch.cur = new Item("direct cur", null, "");
    watch.items[0] = new Item("direct element", null, "");
    watch.pair.item = new Item("direct pair", null, "");
    print("done");
    return 0;
}
