// @expect-error Native library 'zlib' is declared in two different ways. Package 'demo.pkga' declares it as 'native zlib;'. Package 'demo.pkgb' declares it as 'native zlib { windows "zlib1"; linux "z"; macos "z"; }'. A build links each native library one way for all of its packages, so every package must declare it the same way. Change the declaration in the manifest of 'demo.pkgb' to 'native zlib;'.
// @expect-error Native library 'zstd' is declared in two different ways. Package 'demo.pkga' declares it as 'native zstd { windows "zstd" "zstdstatic"; }'. Package 'demo.pkgb' declares it as 'native zstd { windows "zstdstatic" "zstd"; }'. A build links each native library one way for all of its packages, so every package must declare it the same way. Change the declaration in the manifest of 'demo.pkgb' to 'native zstd { windows "zstd" "zstdstatic"; }'.
// @expect-note package 'demo.pkga' declares native library 'zlib' here
// @expect-note package 'demo.pkga' declares native library 'zstd' here
// @expect-error build failed with 2 problems
// Two packages in one build must agree on a native library's binding. The two packages
// list the platforms of 'lz4' in different orders, which is still one way to declare it.
import @demo.pkga.lefttag;
import @demo.pkgb.righttag;

main() -> int {
    print(lefttag.tag() + righttag.tag());
    return 0;
}
