// @exit 0
// @stdout {"x": 3, "y": -4}
// @stdout {"x": 3, "y": -4}
// @stdout {"suit": "Hearts", "rank": 10, "pos": {"x": 1, "y": 2}, "label": "ace\t\"A\"\\", "bonus": 5, "note": null, "weight": 1.5, "flipped": true}
// @stdout {"suit": "Clubs", "rank": 2, "pos": {"x": 0, "y": 0}, "label": "plain", "bonus": null, "note": "seen", "weight": 0, "flipped": false}
// @stdout {"item": 99}
// @stdout {"item": {"x": 7, "y": 8}}
// @stdout {"letter": "A", "gap": "\t", "quote": "\"", "accent": "é", "mark": "Z"}
// @stdout {"letter": "B", "gap": "\t", "quote": "\"", "accent": "é", "mark": null}

// A struct serializes to JSON in string holes and through '.toString()', with its fields in
// declaration order and nested structs recursing. A char renders as a one-character string with
// its scalar encoded to UTF-8, so 'é' passes through as its UTF-8 bytes.

enum Suit { Clubs, Diamonds, Hearts, Spades }

struct Point {
    protected int x;
    protected int y;
}

struct Card {
    protected Suit suit;
    protected int rank;
    protected Point pos;
    protected string label;
    protected int? bonus;
    protected string? note;
    protected double weight;
    protected bool flipped;
}

struct Wrap<T> {
    protected T item;
}

struct Glyph {
    protected char letter;
    protected char gap;
    protected char quote;
    protected char accent;
    protected char? mark;
}

main() -> int {
    Point p = {x: 3, y: -4};
    print("{p}");
    print("{p.toString()}");

    Card first = {suit: Suit.Hearts, rank: 10, pos: {x: 1, y: 2},
        label: "ace\t\"A\"\\", bonus: 5, note: null, weight: 1.5, flipped: true};
    print("{first}");

    Card second = {suit: Suit.Clubs, rank: 2, pos: {x: 0, y: 0},
        label: "plain", bonus: null, note: "seen", weight: 0.0, flipped: false};
    print("{second}");

    Wrap<int> boxed = {item: 99};
    print("{boxed}");
    Wrap<Point> nested = {item: {x: 7, y: 8}};
    print("{nested}");

    Glyph present = {letter: 'A', gap: '\t', quote: '"', accent: 'é', mark: 'Z'};
    print("{present}");
    Glyph absent = {letter: 'B', gap: '\t', quote: '"', accent: 'é', mark: null};
    print("{absent}");

    return 0;
}
