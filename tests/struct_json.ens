// @exit 0
// @stdout {"x": 3, "y": -4}
// @stdout {"x": 3, "y": -4}
// @stdout {"suit": "Hearts", "rank": 10, "pos": {"x": 1, "y": 2}, "label": "ace\t\"A\"\\", "bonus": 5, "note": null, "weight": 1.5, "flipped": true}
// @stdout {"suit": "Clubs", "rank": 2, "pos": {"x": 0, "y": 0}, "label": "plain", "bonus": null, "note": "seen", "weight": 0, "flipped": false}
// @stdout {"item": 99}
// @stdout {"item": {"x": 7, "y": 8}}

// A struct serializes to JSON in string holes and through '.toString()': fields
// in declaration order, numbers as decimals, bools as true/false, strings and
// enum members quoted and escaped, absent optionals as null, nested and generic
// structs recursing.

enum Suit { Clubs, Diamonds, Hearts, Spades }

struct Point {
    int x;
    int y;
}

struct Card {
    Suit suit;
    int rank;
    Point pos;
    string label;
    int? bonus;
    string? note;
    double weight;
    bool flipped;
}

struct Wrap<T> {
    T item;
}

main() -> int {
    Point p = {x: 3, y: -4};
    print("{p}");
    print("{p.toString()}");

    Card first = {suit: Suit.Hearts, rank: 10, pos: {x: 1, y: 2},
        label: "ace\t\"A\"\\", bonus: 5, note: null, weight: 1.5, flipped: true};
    print("{first}");

    Card second = {suit: Suit.Clubs, rank: 2, pos: {x: 0, y: 0},
        label: "plain", bonus: null, note: "seen", weight: 0.0, flipped: false};
    print("{second}");

    Wrap<int> boxed = {item: 99};
    print("{boxed}");
    Wrap<Point> nested = {item: {x: 7, y: 8}};
    print("{nested}");

    return 0;
}
