// @expect-error Variable 'keep' has type 'int', but its value has type 'int?'. The value may be null here. Check 'n' for null first ('if (n != null)').
// 'out' is the one call form that drops the binding's own narrowing, because the callee writes the
// caller's variable directly. It is FFI-only and syntactically distinct from an ordinary argument.
external from libc {
    reset(out int? slot) -> int;
}

main() -> int {
    int? n = 3;
    if (n != null) {
        let discarded = reset(out n);  // 'out n' drops n's own narrowing
        int keep = n;                  // error - n is back to 'int?'
        return keep;
    }
    return 0;
}
