// @expect-error Cannot assign value of type 'int?' to variable of type 'int'
// 'out' is the one call form that drops the binding's OWN narrowing: the callee
// writes the caller's variable directly. ('out' is FFI-only and syntactically
// distinct from an ordinary argument.)
external from "c" {
    reset(out int? slot) -> int;
}

main() -> int {
    int? n = 3;
    if (n != null) {
        let discarded = reset(out n);  // 'out n' drops n's own narrowing
        int keep = n;                  // error - n is back to 'int?'
        return keep;
    }
    return 0;
}
