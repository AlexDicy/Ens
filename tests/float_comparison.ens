// @exit 0
// @stdout double nan vs one: == false != true < false <= false > false >= false
// @stdout double nan vs nan: == false != true
// @stdout double zeros: == true != false < false <= true
// @stdout double one vs two: == false != true < true <= true > false >= false
// @stdout float nan vs one: == false != true < false <= false > false >= false
// @stdout float zeros: == true != false
// Every comparison against a NaN answers false except '!=', which IEEE makes true, and the two
// zeros compare equal whatever their signs. The natural order the standard library declares parts
// company with both of those, and numbers_test.ens pins that side.
main() -> int {
    double zero = 0.0;
    double nan = zero / zero;
    double one = 1.0;
    double two = 2.0;
    print("double nan vs one: == {nan == one} != {nan != one} < {nan < one} <= {nan <= one}"
        + " > {nan > one} >= {nan >= one}");
    print("double nan vs nan: == {nan == nan} != {nan != nan}");
    double negativeZero = -0.0;
    print("double zeros: == {negativeZero == zero} != {negativeZero != zero}"
        + " < {negativeZero < zero} <= {negativeZero <= zero}");
    print("double one vs two: == {one == two} != {one != two} < {one < two} <= {one <= two}"
        + " > {one > two} >= {one >= two}");

    float floatZero = 0.0 as float;
    float floatNan = floatZero / floatZero;
    float floatOne = 1.0 as float;
    print("float nan vs one: == {floatNan == floatOne} != {floatNan != floatOne}"
        + " < {floatNan < floatOne} <= {floatNan <= floatOne} > {floatNan > floatOne}"
        + " >= {floatNan >= floatOne}");
    float floatNegativeZero = -0.0 as float;
    print("float zeros: == {floatNegativeZero == floatZero} != {floatNegativeZero != floatZero}");
    return 0;
}
