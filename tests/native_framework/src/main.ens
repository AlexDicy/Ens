// @platform macos
// @exit 0
// @stdout time is after 2001
// @stdout 16 random bytes written
external type SecRandom;

external from apple {
    CFAbsoluteTimeGetCurrent() -> double;
    SecRandomCopyBytes(SecRandom? generator, ulong count, byte[] bytes) -> int;
}

main() -> int {
    if (CFAbsoluteTimeGetCurrent() > 0.0) {
        print("time is after 2001");
    }
    byte[] random = new byte[16];
    if (SecRandomCopyBytes(null, random.length as ulong, random) == 0) {
        print("16 random bytes written");
    }
    return 0;
}
