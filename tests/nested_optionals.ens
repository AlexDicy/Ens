// @exit 0
// @stdout cursor: milk
// @stdout cursor: <none>
// @stdout cursor: tea
// @stdout cursor: ended after 3
// @stdout cursor ints: 1 <none> ended after 2
// @stdout written twice=text direct of length 6 once=inner outer=outer
// @stdout int twice=value 7 once=inner outer=outer
// @stdout point twice=1,2 once=inner outer=outer
// @stdout substituted text held of length 4 and outer
// @stdout coalesce lifted no-inner no-outer
// @stdout chained W lifted
// @stdout returns outer inner text lifted of length 6
// @stdout field default outer and outer
// @stdout field written text kept of length 4 and value 3
// @stdout array outer text cell of length 4
// @stdout list text pushed of length 6 outer
// @stdout struct literal value 5 outer inner
// @stdout three levels text deep of length 4 then outer
// @stdout equality TFFFTFFFT cross TFFTT null TFFT
// @stdout cast then coalesce 7 1
// @stdout alive probe 0
// @stdout released probe 0
// @stdout alive probe 1
// @stdout released probe 1
// @stdout alive probe 2
// @stdout released probe 2
// @stdout probes done

// Nested optionals: an optional over an optional keeps its two levels apart, so 'null' at the
// outer level and a null value inside it are different answers. A type stacks its '?' suffixes
// to say so, and substitution arrives at the same type when a member typed 'T?' is instantiated
// at a nullable T.
import List from @std.collections.list;

// A cursor over an array. 'next()' answers 'T?', which at 'T = string?' is 'string??': the outer
// level says whether there is an element at all and the inner one is that element, so a null
// element no longer ends the walk.
class Cursor<T> {
    protected T[] items;
    protected long position;

    protected constructor(this.items) {
        this.position = 0;
    }

    protected next() -> T? {
        if (this.position >= this.items.length) {
            return null;
        }
        let item = this.items[this.position];
        this.position = this.position + 1;
        return item;
    }
}

// A member typed 'T?' at 'T = string?' is the same type as a written 'string??', which is what
// lets a substituted value flow into an annotated one with no conversion in between.
class Slot<T> {
    protected T? stored;

    protected constructor(this.stored = null);

    protected value() -> T? {
        return this.stored;
    }
}

class Holder {
    protected string?? slot;
    protected int?? number;

    protected constructor(this.slot = null, this.number = null);
}

class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Point {
    protected int x;
    protected int y;
}

struct Cell {
    protected int?? value;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;

    protected constructor(this.radius);
}

class Square extends Shape {
    protected constructor();
}

// Two checks, one level each, reach the string itself.
describeText(string?? value) -> string {
    if (value == null) {
        return "outer";
    }
    string? inner = value;
    if (inner == null) {
        return "inner";
    }
    string text = inner;
    return "text " + text + " of length " + text.length;
}

describeInt(int?? value) -> string {
    if (value == null) {
        return "outer";
    }
    int? inner = value;
    if (inner == null) {
        return "inner";
    }
    int number = inner;
    return "value " + number;
}

describePoint(Point?? value) -> string {
    if (value == null) {
        return "outer";
    }
    Point? inner = value;
    if (inner == null) {
        return "inner";
    }
    Point point = inner;
    return "{point.x},{point.y}";
}

maybeText(bool present) -> string? {
    if (present) {
        return "present";
    }
    return null;
}

maybeInt(bool present) -> int? {
    if (present) {
        return 3;
    }
    return null;
}

maybePoint(bool present) -> Point? {
    if (present) {
        Point point = {x: 9, y: 9};
        return point;
    }
    return null;
}

// A bare value, a nullable one, and nothing at all all reach the same doubly-nullable type: the
// bare value wraps twice, the nullable one once, and 'null' fills the outer level.
liftText(long which) -> string?? {
    if (which == 0) {
        return null;
    }
    if (which == 1) {
        return maybeText(false);
    }
    return "lifted";
}

deepText() -> string??? {
    return "deep";
}

// A 'string?' wrapped once, so the outer level is always present and the inner one carries the
// answer.
liftOnce(bool present) -> string?? {
    return maybeText(present);
}

// Every shape of a doubly-nullable string against every other, in both directions: the outer
// levels have to agree first, and two present pairs compare the strings they hold. 'liftText'
// answers outer-absent, inner-null and present for 0, 1 and 2.
equalityGrid() -> string {
    string grid = "";
    for (long a = 0; a < 3; a++) {
        for (long b = 0; b < 3; b++) {
            grid = grid + (liftText(a) == liftText(b) ? "T" : "F");
        }
    }
    return grid;
}

walkText(Cursor<string?> cursor) -> long {
    long seen = 0;
    let element = cursor.next();
    while (element != null) {
        string? word = element;
        print("cursor: " + (word ?? "<none>"));
        seen = seen + 1;
        element = cursor.next();
    }
    return seen;
}

walkInts(Cursor<int?> cursor) -> string {
    string joined = "";
    let element = cursor.next();
    long seen = 0;
    while (element != null) {
        int? value = element;
        if (value == null) {
            joined = joined + "<none> ";
        } else {
            joined = joined + value + " ";
        }
        seen = seen + 1;
        element = cursor.next();
    }
    return joined + "ended after " + seen;
}

main() -> int {
    string?[] words = ["milk", null, "tea"];
    print("cursor: ended after " + walkText(new Cursor<string?>(words)));

    int?[] numbers = [1, null];
    print("cursor ints: " + walkInts(new Cursor<int?>(numbers)));

    // A bare value wraps twice, a nullable one wraps once, and 'null' fills the outer level.
    string?? twice = "direct";
    string?? once = maybeText(false);
    string?? outer = null;
    print("written twice=" + describeText(twice) + " once=" + describeText(once)
        + " outer=" + describeText(outer));

    int?? intTwice = 7;
    int?? intOnce = maybeInt(false);
    int?? intOuter = null;
    print("int twice=" + describeInt(intTwice) + " once=" + describeInt(intOnce)
        + " outer=" + describeInt(intOuter));

    Point?? pointTwice = {x: 1, y: 2};
    Point?? pointOnce = maybePoint(false);
    Point?? pointOuter = null;
    print("point twice=" + describePoint(pointTwice) + " once=" + describePoint(pointOnce)
        + " outer=" + describePoint(pointOuter));

    // A substituted 'T?' and a written 'string??' are one type, so this needs no conversion.
    string?? fromSlot = new Slot<string?>("held").value();
    string?? fromEmptySlot = new Slot<string?>().value();
    print("substituted " + describeText(fromSlot) + " and " + describeText(fromEmptySlot));

    // '??' takes exactly one level off, so the first fallback is reached only when the outer
    // level is absent. The values come from a call, because an initializer would prove the
    // levels it filled and narrow the local past what is being shown here.
    print("coalesce " + ((liftText(2) ?? "no-outer") ?? "no-inner") + " "
        + ((liftText(1) ?? "no-outer") ?? "no-inner") + " "
        + ((liftText(0) ?? "no-outer") ?? "no-inner"));
    print("chained " + ((liftText(1) ?? maybeText(true) ?? "Z") ?? "W") + " "
        + ((liftText(2) ?? maybeText(true) ?? "Z") ?? "W"));

    print("returns " + describeText(liftText(0)) + " " + describeText(liftText(1)) + " "
        + describeText(liftText(2)));

    let empty = new Holder();
    print("field default " + describeText(empty.slot) + " and " + describeInt(empty.number));
    let filled = new Holder();
    filled.slot = "kept";
    filled.number = maybeInt(true);
    print("field written " + describeText(filled.slot) + " and " + describeInt(filled.number));

    string??[] cells = [null, "cell"];
    print("array " + describeText(cells[0]) + " " + describeText(cells[1]));

    let texts = new List<string??>();
    texts.push("pushed");
    texts.push(null);
    print("list " + describeText(texts.get(0)) + " " + describeText(texts.get(1)));

    Cell five = {value: 5};
    Cell blank = {value: null};
    Cell inner = {value: maybeInt(false)};
    print("struct literal " + describeInt(five.value) + " " + describeInt(blank.value) + " "
        + describeInt(inner.value));

    string??? three = deepText();
    string??? threeOuter = null;
    print("three levels " + describeText(three ?? null) + " then "
        + describeText(threeOuter ?? null));

    // A shallower operand wraps into the deeper spelling before the comparison, and 'null' asks
    // about the outer level alone.
    string crossed = "";
    crossed = crossed + (liftOnce(true) == maybeText(true) ? "T" : "F");
    crossed = crossed + (liftOnce(false) == maybeText(true) ? "T" : "F");
    crossed = crossed + (liftText(0) == maybeText(true) ? "T" : "F");
    crossed = crossed + (maybeText(true) == liftOnce(true) ? "T" : "F");
    crossed = crossed + (liftText(1) != liftText(2) ? "T" : "F");
    string nulls = "";
    nulls = nulls + (liftText(0) == null ? "T" : "F");
    nulls = nulls + (liftText(1) == null ? "T" : "F");
    nulls = nulls + (liftText(2) == null ? "T" : "F");
    nulls = nulls + (null == liftText(0) ? "T" : "F");
    print("equality " + equalityGrid() + " cross " + crossed + " null " + nulls);

    // The target of 'as?' stops before an adjacent '??', so the cast answers a 'Circle?' that
    // the fallback completes.
    Shape round = new Circle(7);
    Shape boxy = new Square();
    Circle spare = new Circle(1);
    Circle hit = round as? Circle ?? spare;
    Circle missed = boxy as? Circle ?? spare;
    print("cast then coalesce {hit.radius} {missed.radius}");

    for (long i = 0; i < 3; i++) {
        Probe?? boxed = new Probe("probe " + i);
        Probe? alive = boxed ?? null;
        if (alive != null) {
            print("alive " + alive.label);
        }
    }
    print("probes done");
    return 0;
}
