// @expect-error Duplicate switch label
// 'A' and 65 name the same integer label (both 65), so listing both is a
// duplicate just like writing 65 twice.
kind(int n) -> int {
    return switch (n) {
        'A' -> 1,
        65 -> 2,
        default -> 0,
    };
}

main() -> int {
    return kind(65);
}
