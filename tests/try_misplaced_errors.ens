// @expect-error Call to 'settle' can throw 'Failure', and the 'try' before 'take' does not cover it: a call inside an argument needs its own 'try', and 'take' cannot throw. Move the 'try' to 'settle', as in 'take(try settle())', and either catch it with a 'catch' clause or mark this function 'throws'.
// @expect-error 'try' is not needed here: 'pair' cannot throw. Remove 'try'.
// @expect-error Call to 'settle' can throw 'Failure'. Prefix it with 'try'.
// @expect-error build failed with 5 problems
// A 'try' written before a call that cannot throw, with one call in its arguments that can, belongs
// on that inner call, and the one refusal moves it there. With two such calls, each takes its own.
class Failure extends Error {
    constructor() {
        super("failed");
    }
}

class Program {
    constructor();
}

settle() -> Program throws {
    throw new Failure();
}

take(Program program) -> bool {
    return true;
}

pair(Program one, Program two) -> bool {
    return true;
}

marked() -> bool throws {
    return try take(settle());
}

unmarked() -> bool {
    return try take(settle());
}

twice() -> bool throws {
    return try pair(settle(), settle());
}

main() -> int {
    return 0;
}
