// @expect-error Call to 'settle' can throw 'Failure', and the 'try' before 'take' does not cover it: a call inside an argument needs its own 'try', and 'take' cannot throw. Move the 'try' to 'settle', as in 'take(try settle())', and either catch it with a 'catch' clause or mark this function 'throws'.
// @expect-error The two calls to 'settle' can throw 'Failure', and the 'try' before 'pair' does not cover them: a call inside an argument needs its own 'try', and 'pair' cannot throw. Write a 'try' before each of them, and remove the one before 'pair', as in 'pair(try settle(), try settle())'.
// @expect-error 'settle' can throw 'Failure' and 'load' can throw 'Other', and the 'try' before 'pair' does not cover them: a call inside an argument needs its own 'try', and 'pair' cannot throw. Write a 'try' before each of them, and remove the one before 'pair', as in 'pair(try settle(), try load())'.
// @expect-error build failed with 4 problems
// A 'try' written before a call that cannot throw, with one call in its arguments that can, belongs
// on that inner call, and the one refusal moves it there. With several such calls, the one refusal
// writes a 'try' before each of them, whether they call one function or several.
class Failure extends Error {
    constructor() {
        super("failed");
    }
}

class Program {
    constructor();
}

settle() -> Program throws {
    throw new Failure();
}

take(Program program) -> bool {
    return true;
}

pair(Program one, Program two) -> bool {
    return true;
}

marked() -> bool throws {
    return try take(settle());
}

unmarked() -> bool {
    return try take(settle());
}

twice() -> bool throws {
    return try pair(settle(), settle());
}

class Other extends Error {
    constructor() {
        super("other");
    }
}

load() -> Program throws Other {
    throw new Other();
}

mixed() -> bool throws {
    return try pair(settle(), load());
}

main() -> int {
    return 0;
}
