// @exit 0
// @stdout pipe hello
// @stdout pipe 7
// @stdout kept 9
// @stdout drain 1 2 3
// @stdout bound shape:4 sides
// @stdout bound cmp:-1
// @stdout map 3
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import Map from @std.collections.map;

// A generic interface, specialized per type-argument set.
interface Source<T> {
    take() -> T;
}

class Constant<T> implements Source<T> {
    T item;
    protected constructor(this.item);
    protected override take() -> T { return this.item; }
}

// A struct field instantiates 'Keeper<Constant<int>>' before any class template completes, so
// the deferred bound check must read the filled instantiation's substituted conformance.
class Keeper<S: Source<int>> {
    S kept;

    protected constructor(this.kept);

    protected takeKept() -> int {
        return this.kept.take();
    }
}

struct Cache {
    protected Keeper<Constant<int>>? keeper;
}

// A generic class draining any Iterable<int> through the interface.
class Drain {
    protected constructor();
    protected drainAll(Iterable<int> values) -> string {
        string out = "";
        for (let v in values) {
            out = out + " " + v;
        }
        return out;
    }
}

class Numbers implements Iterable<int> {
    int[] items;
    protected constructor(this.items);
    protected override makeIterator() -> Iterator<int> { return new NumberIterator(this.items); }
}

class NumberIterator implements Iterator<int> {
    int[] items;
    long index;
    protected constructor(this.items) { this.index = 0; }
    protected override hasNext() -> bool { return this.index < this.items.length; }
    protected override next() -> int {
        int v = this.items[this.index];
        this.index = this.index + 1;
        return v;
    }
}

// Multiple generic bounds: one class bound plus interfaces, all usable on T.
interface Comparable {
    compareTo(int other) -> int;
}

class Shape {
    protected int sides;
    protected constructor(this.sides = 0);
    protected describe() -> string { return this.sides + " sides"; }
}

class Square extends Shape implements Comparable {
    protected constructor() { super(4); }
    protected override compareTo(int other) -> int {
        if (this.sides < other) { return -1; }
        if (this.sides > other) { return 1; }
        return 0;
    }
}

summarize<S: Shape + Comparable>(S value) -> string {
    return "shape:" + value.describe() + " cmp:" + value.compareTo(9);
}

main() -> int {
    Source<string> words = new Constant<string>("hello");
    print("pipe " + words.take());
    Source<int> sevens = new Constant<int>(7);
    print("pipe " + sevens.take());

    Cache cache = {keeper: new Keeper<Constant<int>>(new Constant<int>(9))};
    let keeper = cache.keeper;
    if (keeper != null) {
        print("kept " + keeper.takeKept());
    }

    int[] ns = [1, 2, 3];
    Drain d = new Drain();
    print("drain" + d.drainAll(new Numbers(ns)));

    string summary = summarize<Square>(new Square());
    long split = summary.indexOf(" cmp");
    print("bound " + summary.substring(0, split));
    print("bound " + summary.substring(split + 1, summary.length));

    // The std collections still iterate through the migrated interfaces.
    let counts = new Map<string, int>();
    counts.set("a", 1);
    counts.set("b", 2);
    int total = 0;
    for (let entry in counts) {
        total = total + entry.value;
    }
    print("map " + total);
    return 0;
}
