// @stdlib ../binding_intrinsics_stdlib
// @exit 134
// @stderr-contains panic: string byte index out of bounds
// @stderr-contains at main (main.ens:9)
// Reading past the last byte aborts, and the trace starts at the read rather than inside a helper,
// because the guard the compiler implements runs at the call site.
main() -> int {
    let text = "hi";
    return text.byteAt(5) as int;
}
