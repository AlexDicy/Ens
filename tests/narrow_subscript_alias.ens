// @exit 6
// Writing through a subscript only drops narrowings the written element could
// alias: elements narrowed at a different literal index stay narrowed.
class Box {
    int v;
    Box(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(1), new Box(2), new Box(3)];
    int score = 0;
    if (xs[0] != null && xs[1] != null) {
        xs[2] = null;
        score = score + xs[0].v + xs[1].v;  // +3: the xs[2] write cannot touch 0 or 1
        xs[0] = null;
        score = score + xs[1].v;            // +2: the xs[0] write cannot touch 1
        if (xs[0] == null) {
            score = score + 1;              // +1 -> 6
        }
    }
    return score;
}
