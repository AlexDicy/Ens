// @expect-error Struct 'Coordinate' defines 'equals' but not 'hash'
// The dangerous half of the pair: an equality that ignores a field, left with the built-in
// content hash, would store a value under one bucket and look it up in another.

struct Coordinate {
    int x;
    int y;

    override equals(Coordinate other) -> bool {
        return this.x == other.x;
    }
}

main() -> int {
    return 0;
}
