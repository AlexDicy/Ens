// @expect-error Cannot create an instance of abstract class 'Shape'
// @expect-error Cannot create an instance of abstract class 'Sized'
// @expect-error build failed with 2 problems
// An inaccessible constructor is not why an abstract class cannot be instantiated, so widening it
// would not help and its visibility is not reported alongside the abstractness.
abstract class Shape {
    abstract area() -> int;
}

abstract class Sized {
    int side;

    private constructor(this.side);

    abstract area() -> int;
}

main() -> int {
    Shape s = new Shape();
    Sized t = new Sized(2);
    return 0;
}
