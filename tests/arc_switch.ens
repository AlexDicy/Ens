// @exit 0
// @stdout arc switch done
// Switch arms that build owned strings, in both expression and block form, must
// release them without leaking or double-freeing, and so must a statement arm whose
// string or struct nothing reads, before the statement after the switch runs. Exit 0
// only if every round preserved its contents.
enum Mode { Fast, Slow, }

tagged(string label) -> string {
    return "tag-" + label;
}

class Node {
    protected constructor();
}

class Holder {
    protected weak Node? node;

    protected constructor();
}

struct Wrapped {
    protected Node node;
}

wrap(Holder holder) -> Wrapped {
    let node = new Node();
    holder.node = node;
    return {node: node};
}

main() -> int {
    let i = 0;
    let matched = 0;
    while (i < 1000) {
        let m = i % 2 == 0 ? Mode.Fast : Mode.Slow;
        let label = switch (m) {
            Fast -> "fast-" + i.toString(),
            Slow -> "slow-" + i.toString(),
        };
        switch (m) {
            Fast -> {
                let extra = "x-" + label;
                if (extra.length > 2) { matched = matched + 1; }
            },
            Slow -> {
                if (label.length > 0) { matched = matched + 1; }
            },
        }
        switch (m) {
            Fast -> tagged(label),
            Slow -> { },
        }
        let holder = new Holder();
        switch (m) {
            Fast -> { },
            Slow -> wrap(holder),
        }
        if (holder.node != null) {
            return 1;
        }
        i = i + 1;
    }
    print("arc switch done");
    return matched - 1000;
}