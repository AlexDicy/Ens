// @exit 10
// A type test on 'this' narrows it like one on a parameter: in a '?:', in an 'if', on the right
// side of '&&', and below a negative guard that returns.
class Base {
    constructor();

    measure() -> int {
        int total = this is Box ? this.width : 0;
        if (this is Box) {
            total = total + this.width;
        }
        if (this is Box && this.width > 1) {
            total = total + 1;
        }
        if (!(this is Box)) {
            return total;
        }
        return total + this.width;
    }
}

class Box extends Base {
    int width = 3;

    constructor();
}

main() -> int {
    Base plain = new Base();
    Base boxed = new Box();
    return plain.measure() + boxed.measure();
}
