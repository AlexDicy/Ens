// @exit 0
// @stdout arguments survived the round trip
// @stdout streams captured
// @stdout missing program reported
// Runs itself as a child process to prove the argument vector crosses the process boundary
// untouched, with arguments holding spaces, quotes and backslashes. It also checks that each
// stream lands in its own file and that a program that cannot be started reports 127.
import @std.system;
import SystemError from @std.system;

main() -> int throws {
    string[] arguments = system.arguments();
    if (arguments.length > 1) {
        return try child(arguments);
    }
    return try parent(arguments[0]);
}

// The child echoes every argument after the first on its own line, then exits with
// a code the parent recognizes; the "fail" mode writes to standard error instead by
// letting an error go unhandled.
child(string[] arguments) -> int throws {
    if (arguments[1] == "fail") {
        return try failing();
    }
    for (long i = 1; i < arguments.length; i++) {
        print("[" + arguments[i] + "]");
    }
    return 42;
}

failing() -> int throws {
    throw new SystemError("the child failed on purpose");
}

parent(string program) -> int throws {
    string stdoutPath = "build/tests/std_process.out";
    string stderrPath = "build/tests/std_process.err";
    string[] passed = ["speak", "with space", "quo\"ted", "back\\slash", "ends\\"];
    int code = try system.runCaptured(program, passed, stdoutPath, stderrPath);
    if (code != 42) {
        print("child exited {code}");
        return 10;
    }
    string echoed = try system.readAllText(stdoutPath);
    string expected = "";
    for (long i = 0; i < passed.length; i++) {
        expected = expected + "[" + passed[i] + "]\n";
    }
    if (!sameLines(echoed, expected)) {
        print("child echoed [{echoed}] instead of [{expected}]");
        return 11;
    }
    if (try system.readAllText(stderrPath) != "") {
        return 12;
    }
    print("arguments survived the round trip");

    int failed = try system.runCaptured(program, ["fail"], stdoutPath, stderrPath);
    if (failed != 1) {
        print("failing child exited {failed}");
        return 13;
    }
    if (try system.readAllText(stdoutPath) != "") {
        return 14;
    }
    if (!(try system.readAllText(stderrPath)).contains("the child failed on purpose")) {
        return 15;
    }
    print("streams captured");

    int missing = try system.runCaptured("ens_surely_no_such_program_42", [], stdoutPath,
        stderrPath);
    if (missing != 127) {
        print("missing program exited {missing}");
        return 16;
    }
    print("missing program reported");
    return 0;
}

// The captured text with carriage returns dropped, so a line the child ended with
// the platform's own newline compares equal to one line of expected text.
sameLines(string captured, string expected) -> bool {
    byte[] raw = captured.toBytes();
    byte[] kept = new byte[raw.length];
    long length = 0;
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] != '\r') {
            kept[length] = raw[i];
            length++;
        }
    }
    return string.fromBytes(kept.slice(0, length)) == expected;
}
