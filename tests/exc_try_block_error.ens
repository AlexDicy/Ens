// @expect-error Variable 'text' has type 'string', but its value has type 'int'. Declare 'text' as an 'int' instead.
// @expect-error build failed with 3 problems
// A block written after 'try' is reported once at its '{', as a statement and as a value, and a
// 'catch' clause after it adds nothing. The block is still read as a block, so the function after
// it is still checked.

attempt() {
    try {
        print("x");
    } catch (Error e) {
        print("y");
    }
}

value() -> int {
    let x = try { 1 };
    return x;
}

main() -> int {
    string text = 42;
    return 0;
}
