// @stdout the child's line held 3 bytes: 61 00 62
// @exit 0
// A message holding a NUL is printed whole. The line is read back from a child, because a NUL
// cannot be written into an expected-output directive.
import @std.system;

// The bytes of `line` as two-digit hexadecimal, spaced, which is a form a directive can carry.
hexOf(string line) -> string {
    string spelled = "";
    for (let raw in line.toBytes()) {
        if (spelled.length > 0) {
            spelled = spelled + " ";
        }
        spelled = spelled + digit(raw / 16) + digit(raw % 16);
    }
    return spelled;
}

digit(long value) -> string {
    if (value < 10) {
        return "{value}";
    }
    return "{('a' as long + value - 10) as char}";
}

main() -> int {
    let given = system.arguments();
    if (given.length > 1 && given[1] == "child") {
        print("a\0b");
        return 0;
    }
    let child = try system.start(system.executablePath(), ["child"]);
    string? line = try child.readLine();
    if (line == null) {
        eprint("the child printed nothing");
        return 1;
    }
    print("the child's line held {line.length} bytes: {hexOf(line)}");
    let status = try child.wait();
    return 0;
} catch (Error failure) {
    eprint(failure.message);
    return 1;
}
