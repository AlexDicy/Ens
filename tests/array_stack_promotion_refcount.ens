// @exit 0
// @stdout frame 0: 0 1 100
// @stdout frame 1: 1 2 100
// @stdout frame 2: 2 3 100
// A promoted array lives in frame storage, so a reference count that still reaches it must not be
// taken literally: copying it into 'alias' retains the frame pointer and reassigning 'alias'
// releases it again. The reservation carries a heap array's immortal header, which makes both a
// dynamic no-op; a real count instead reads and writes the eight bytes below the reservation and
// can hand frame storage to free.
main() -> int {
    int i = 0;
    while (i < 3) {
        int[] frame = new int[2];
        frame[0] = i;
        frame[1] = i + 1;
        int[] alias = frame;
        alias = new int[3];
        alias[0] = 100;
        print("frame {i}: {frame[0]} {frame[1]} {alias[0]}");
        i = i + 1;
    }
    return 0;
}
