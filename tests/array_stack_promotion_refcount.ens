// @exit 0
// @stdout frame 0: 0 1 100
// @stdout frame 1: 1 2 100
// @stdout frame 2: 2 3 100
// A promoted array lives in frame storage, so a reference count that still reaches it must not be
// taken literally. The reservation carries a heap array's immortal header, which makes every such
// count a dynamic no-op, where a real one would read the bytes below it and free frame storage.
main() -> int {
    int i = 0;
    while (i < 3) {
        int[] frame = new int[2];
        frame[0] = i;
        frame[1] = i + 1;
        int[] alias = frame;
        alias = new int[3];
        alias[0] = 100;
        print("frame {i}: {frame[0]} {frame[1]} {alias[0]}");
        i = i + 1;
    }
    return 0;
}
