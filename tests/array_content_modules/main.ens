// @exit 0
// @stdout main true false
// @stdout helper true false
// @stdout text ["a", "b"] ["a", "b"]
// Two modules comparing and rendering the same array type by content each get their own copy of
// the synthesized functions, so neither module has to own them and the symbols never collide.
import helper;

main() -> int {
    string[] left = ["a", "b"];
    string[] right = ["a", "b"];
    string[] other = ["a", "c"];
    print("main {left == right} {left == other}");
    print("helper {helper.sameWords(left, right)} {helper.sameWords(left, other)}");
    print("text {left} {helper.rendered(right)}");
    return 0;
}
