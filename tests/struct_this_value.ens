// @exit 0
// @stdout compared true
// @stdout returned 3
// @stdout rendered {"id": 3, "note": "n"}
// @stdout passed id=3 note=n

// 'this' inside a struct method names the whole value, not just a place to read fields
// from: it compares with '==', it is returned, it renders in an interpolation hole, and it
// is passed to a function taking the struct. A reference field rides along each time.

describe(Key key) -> string {
    return "id={key.id} note={key.note}";
}

struct Key {
    protected int id;
    protected string note;

    protected sameAs(Key other) -> bool {
        return this == other;
    }

    protected copy() -> Key {
        return this;
    }

    protected rendered() -> string {
        return "{this}";
    }

    protected described() -> string {
        return describe(this);
    }
}

main() -> int {
    Key key = {id: 3, note: "n"};
    Key twin = {id: 3, note: "n"};
    print("compared {key.sameAs(twin)}");
    print("returned {key.copy().id}");
    print("rendered {key.rendered()}");
    print("passed {key.described()}");
    return 0;
}
