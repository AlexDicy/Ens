// @expect-error 'grow<int>' calls 'grow<Box<int>>', which calls 'grow<Box<Box<int>>>', and so on without end, so no program can contain all of these calls. The calls grow because 'grow' calls 'grow<Box<T>>', where its type parameter 'T' is inside another type.
// @expect-error build failed with 1 problem
// Function-level polymorphic recursion: each call to grow needs a strictly deeper type argument,
// so building every instantiation would never finish. It is refused once, at the call.
class Box<T> {
    T value;
    protected constructor(this.value);
}

grow<T>(T value) -> int {
    return grow<Box<T>>(new Box<T>(value));
}

main() -> int {
    return grow<int>(0);
}
