// @expect-error never finishes
// @expect-error-at codegen the instantiation-depth guard fires while cloning generic
// bodies; sema never clones them, so this reject belongs to codegen.
// Function-level polymorphic recursion: each call to grow needs a strictly
// deeper type argument (int, Box<int>, Box<Box<int>>, ...), so monomorphization
// would never terminate. The compiler caps the instantiation cascade and reports
// it rather than expanding until the stack overflows.
class Box<T> {
    T value;
    constructor(this.value);
}

grow<T>(T value) -> int {
    return grow<Box<T>>(new Box<T>(value));
}

main() -> int {
    return grow<int>(0);
}
