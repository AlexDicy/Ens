// @exit 0
// @stdout spot 3,4
// @stdout tally 99
// @stdout gauge 777
// @stdout count 7
// @stdout scale 2.5
// @stdout pick ok
// @stdout direct 3,4
// @stdout read 22
// @stdout required 11
// @stdout counted 3
// @stdout measured 3
// @stdout inner 55
// @stdout chain deep 66
// @stdout chain middle 66
// @stdout chain leaf 66
// @stdout chain partial 1
// An override may narrow the return type its base class or an interface declared, so a dispatch
// slot and the implementation filling it can disagree on the machine shape of the result. Every
// edge to the slot has to read what the declaration promised: through a base reference, through an
// interface, through an abstract declaration, and through a generic instantiation. A reference
// narrowed out of its nullable form needs nothing, because both spellings are one pointer, while a
// tagged optional pair and a narrower integer or float each have to be rebuilt. A method answering
// two interfaces that declare different returns is read correctly through each of them. Calling the
// override directly still reads its own shape.
struct Point {
    protected int x;
    protected int y;

    protected show() -> string {
        return "" + this.x + "," + this.y;
    }
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected constructor();
}

class Base {
    protected constructor();

    protected spot() -> Point? {
        return null;
    }

    protected tally() -> long? {
        return null;
    }

    protected gauge() -> int? {
        return null;
    }

    protected count() -> long {
        return 5;
    }

    protected scale() -> double {
        return 1.5;
    }

    protected pick() -> Shape? {
        return null;
    }
}

class Derived extends Base {
    protected constructor();

    protected override spot() -> Point {
        Point made = {x: 3, y: 4};
        return made;
    }

    protected override tally() -> long {
        return 99;
    }

    protected override gauge() -> int {
        return 777;
    }

    protected override count() -> int {
        return 7;
    }

    protected override scale() -> float {
        return 2.5f;
    }

    protected override pick() -> Circle {
        return new Circle();
    }
}

abstract class Reader {
    protected constructor();

    protected abstract read() -> int?;

    // The abstract declaration owns the slot, so this call reads it at 'int?' whatever the
    // implementation returns.
    protected show() -> string {
        let value = this.read();
        if (value == null) {
            return "read null";
        }
        return "read " + value;
    }
}

class Constant extends Reader {
    protected constructor();

    protected override read() -> int {
        return 22;
    }
}

interface Required {
    amount() -> long?;
}

class Provider implements Required {
    protected constructor();

    protected override amount() -> long {
        return 11;
    }
}

interface Counted {
    quantity() -> long?;
}

interface Measured {
    quantity() -> double;
}

// One method, two requirements whose declared returns have no shape in common: each interface's
// table has to reach it at its own.
class Both implements Counted, Measured {
    protected constructor();

    protected override quantity() -> int {
        return 3;
    }
}

// Three levels, so the slot 'Deep' owns is read by two overrides at once and the last one narrows
// both the nullable level and the width away from what that slot declares.
class Deep {
    protected constructor();

    protected step() -> long? {
        return null;
    }
}

class Middle extends Deep {
    protected constructor();

    protected override step() -> long {
        return 1;
    }
}

class Leaf extends Middle {
    protected constructor();

    protected override step() -> int {
        return 66;
    }
}

class Box<T> {
    protected T stored;

    protected constructor(this.stored);

    protected value() -> T? {
        return this.stored;
    }
}

class Tight<T> extends Box<T> {
    protected constructor(T value) {
        super(value);
    }

    protected override value() -> T {
        return this.stored;
    }
}

reportPoint(string label, Point? point) {
    if (point == null) {
        print(label + " null");
        return;
    }
    print(label + " " + point.show());
}

main() -> int {
    Base base = new Derived();
    reportPoint("spot", base.spot());
    let tally = base.tally();
    if (tally == null) {
        print("tally null");
    } else {
        print("tally " + tally);
    }
    let gauge = base.gauge();
    if (gauge == null) {
        print("gauge null");
    } else {
        print("gauge " + gauge);
    }
    print("count " + base.count());
    print("scale " + base.scale());
    if (base.pick() == null) {
        print("pick null");
    } else {
        print("pick ok");
    }

    let derived = new Derived();
    print("direct " + derived.spot().show());

    Reader reader = new Constant();
    print(reader.show());

    Required required = new Provider();
    let amount = required.amount();
    if (amount == null) {
        print("required null");
    } else {
        print("required " + amount);
    }

    let both = new Both();
    Counted counted = both;
    Measured measured = both;
    let quantity = counted.quantity();
    if (quantity == null) {
        print("counted null");
    } else {
        print("counted " + quantity);
    }
    print("measured " + measured.quantity());

    Box<long> box = new Tight<long>(55);
    let inner = box.value();
    if (inner == null) {
        print("inner null");
    } else {
        print("inner " + inner);
    }

    Deep deep = new Leaf();
    let deepStep = deep.step();
    if (deepStep == null) {
        print("chain deep null");
    } else {
        print("chain deep " + deepStep);
    }
    Middle middle = new Leaf();
    print("chain middle " + middle.step());
    print("chain leaf " + new Leaf().step());
    Deep partial = new Middle();
    let partialStep = partial.step();
    if (partialStep == null) {
        print("chain partial null");
    } else {
        print("chain partial " + partialStep);
    }
    return 0;
}
