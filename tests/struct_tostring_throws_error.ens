// @expect-error Struct 'Point' declares 'toString' as 'throws', and an interpolation hole has nowhere to write 'try'
// A throwing conversion needs a 'try' the caller writes, and an interpolation hole
// has no room for one, so the call has to be spelled out.

public struct Point {
    int x;

    public toString() -> string throws {
        if (this.x < 0) {
            throw new Error("negative");
        }
        return "Point({this.x})";
    }
}

describe(Point p) -> string {
    return "point {p}";
}

main() -> int {
    return 0;
}
