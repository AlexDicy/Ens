// @expect-error A method named 'toString' cannot be marked 'throws'
// A throwing call needs a 'try' the caller writes, and an interpolation hole has no
// room for one, so a struct's text form may not fail at all.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public struct Point {
    int x;

    public override toString() -> string throws {
        if (this.x < 0) {
            throw new Failure("negative");
        }
        return "Point({this.x})";
    }
}

describe(Point p) -> string {
    return "point {p}";
}

main() -> int {
    return 0;
}
