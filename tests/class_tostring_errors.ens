// @expect-error A method named 'toString' cannot be marked 'throws'; a value's text form is used where there is no room for a 'try', such as an interpolation hole. Remove 'throws', or rename the method.
// @expect-error A method named 'toString' must have the signature 'toString() -> string'; it defines how values of this type render as text (for example in an interpolation hole). Give it a 'string' result, or a parameter to make it an ordinary method.
// @expect-error Method 'toString' of 'Ghost' cannot be 'abstract': every class already has a text form, its type's name, so a 'toString' override needs a body that replaces that default. Write the body, or remove the method.
// @expect-error Method 'toString' replaces the built-in text form of class 'Labeled', so it must be as visible as 'Labeled' itself; mark it 'public'.
// @expect-error Method 'toString' of 'Unmarked' replaces the text form every class already has; mark it 'override'.
// @expect-error Method 'toString' of 'Shaped' is marked 'override' but no base class or implemented interface declares it; a 'toString' that takes parameters is an ordinary method rather than the text form every class already has. Remove 'override'.
// @expect-error build failed with 7 problems

// A class's 'toString' that takes no parameters is held to the shape the text form needs,
// exactly like a struct's: a 'string' result and no 'throws'. It replaces the type-name form
// every class answers with, so it writes the marker, it cannot be 'abstract' because that
// default always stands in, and it may not be less visible than its class.
// One that takes parameters is an ordinary method, so the marker has nothing to answer.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public class Throwing {
    protected int x;

    public constructor(this.x);

    public override toString() -> string throws {
        if (this.x < 0) {
            throw new Failure("negative");
        }
        return "throwing";
    }
}

public class Shaped {
    public constructor();

    public override toString(int width) -> string {
        return "wide";
    }
}

public class Numbered {
    public constructor();

    public override toString() -> int {
        return 7;
    }
}

abstract class Ghost {
    abstract override toString() -> string;
}

public class Labeled {
    public constructor();

    protected override toString() -> string {
        return "labeled";
    }
}

class Unmarked {
    protected constructor();

    protected toString() -> string {
        return "unmarked";
    }
}

class Counted {
    protected constructor();

    protected toString() -> long {
        return 7;
    }
}

class Widget {
    protected constructor();
}

main() -> int {
    Widget? maybe = null;
    print("{maybe}");
    return 0;
}
