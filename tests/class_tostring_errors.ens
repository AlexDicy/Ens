// @expect-error A method named 'toString' cannot be marked 'throws'; a value's text form is used where there is no room for a 'try', such as an interpolation hole. Remove 'throws', or rename the method.
// @expect-error A method named 'toString' must have the signature 'toString() -> string'; it defines how values of this type render as text (for example in an interpolation hole).
// @expect-error Method 'toString' of 'Ghost' cannot be 'abstract': every class already answers with its type name, so a 'toString' override needs a body that replaces that default. Write the body, or remove the method.
// @expect-error Method 'toString' replaces the built-in text form of class 'Labeled', so it must be as visible as 'Labeled' itself; mark it 'public'.
// @expect-error build failed with 5 problems

// A class's marked 'toString' is held to the shape the text form needs, exactly like a struct's:
// no parameters, a 'string' result, and no 'throws'. It cannot be 'abstract', because the
// type-name default always stands in, and it may not be less visible than its class.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public class Throwing {
    protected int x;

    public constructor(this.x);

    public override toString() -> string throws {
        if (this.x < 0) {
            throw new Failure("negative");
        }
        return "throwing";
    }
}

public class Shaped {
    public constructor();

    public override toString(int width) -> string {
        return "wide";
    }
}

public class Numbered {
    public constructor();

    public override toString() -> int {
        return 7;
    }
}

abstract class Ghost {
    abstract override toString() -> string;
}

public class Labeled {
    public constructor();

    protected override toString() -> string {
        return "labeled";
    }
}

class Widget {
    protected constructor();
}

main() -> int {
    Widget? maybe = null;
    print("{maybe}");
    return 0;
}
