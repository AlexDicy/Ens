// A 'null' element names the declaration whose type would take null elements, and so does one
// passed where only one overload takes that many arguments or held by a field's default value.
class Box {
    int v;
    protected constructor(this.v = 0);
}

class Shelf {
    Box[][] rows = [[new Box(1), null]];

    constructor();
}

run(((int) -> int)[] steps) -> int {
    return steps.length as int;
}

pick(int[] values) -> int {
    return values.length as int;
}

pick(int first, int second) -> int {
    return first + second;
}

main() -> int {
    let xs = [new Box(1), null];
    return run([(x) -> x, null]) + pick([1, null]);
}
