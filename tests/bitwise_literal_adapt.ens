// @exit 42
// An untyped integer literal adapts to the other operand's type for every bitwise operator,
// the same way it already does for '+', '-' and '*'. A shift is the asymmetric case: the
// value being shifted decides the result type, and the distance adapts to it.
main() -> int {
    byte small = 0xF0;
    if ((small & 0x0F) != 0)           { return 1; }
    if ((small | 0x0F) != 0xFF)        { return 2; }
    if ((small ^ 0xFF) != 0x0F)        { return 3; }
    if ((small >> 4) != 0x0F)          { return 4; }

    ushort halfWord = 0xFF00;
    if ((halfWord & 0xFF) != 0)        { return 5; }
    if ((halfWord >> 8) != 0xFF)       { return 6; }
    if ((0x00FF | halfWord) != 0xFFFF) { return 7; }

    short signedHalf = -2;
    if ((signedHalf & 1) != 0)         { return 8; }
    if ((signedHalf >> 1) != -1)       { return 9; }
    if ((signedHalf << 1) != -4)       { return 10; }

    int word = -8;
    if ((word >> 2) != -2)             { return 11; }
    if ((word & 0xFF) != 0xF8)         { return 12; }

    // '>>>' fills with zeros where '>>' would copy the sign bit, and takes an untyped
    // literal distance like the other two shifts. On an unsigned type the two agree.
    if ((word >>> 1) != 2147483644)    { return 28; }
    long signedWide = -8;
    if ((signedWide >>> 1) != 9223372036854775804L) { return 29; }
    if ((signedWide >> 1) != -4L)      { return 30; }
    if ((small >>> 4) != (small >> 4)) { return 31; }

    uint unsignedWord = 0x12345678;
    if ((unsignedWord & 0xFF) != 0x78) { return 13; }
    if ((unsignedWord >> 24) != 0x12)  { return 14; }
    if ((unsignedWord << 8) != 0x34567800) { return 15; }
    if ((unsignedWord ^ 0xFFFFFFFF) != 0xEDCBA987) { return 16; }
    if ((0xFF & unsignedWord) != 0x78) { return 17; }

    long wide = -16;
    if ((wide >> 3) != -2)             { return 18; }
    if ((wide | 1) != -15)             { return 19; }

    ulong unsignedWide = 0xFFFFFFFFFFFFFFFF;
    if ((unsignedWide >> 60) != 0x0F)  { return 20; }
    if ((unsignedWide & 0xFF) != 0xFF) { return 21; }

    char letter = 'A';
    if ((letter | 0x20) != 'a')        { return 22; }

    // The compound forms fold the same operator, so they adapt the same way.
    uint folded = 0xF0F0F0F0;
    folded &= 0xFFFF;
    if (folded != 0xF0F0)              { return 23; }
    folded |= 0x000F;
    if (folded != 0xF0FF)              { return 24; }
    folded ^= 0x00FF;
    if (folded != 0xF000)              { return 25; }
    folded >>= 8;
    if (folded != 0xF0)                { return 26; }
    folded <<= 4;
    if (folded != 0xF00)               { return 27; }

    return 42;
}
