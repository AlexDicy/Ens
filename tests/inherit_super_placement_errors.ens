// @expect-error 'super(...)' must be the first statement of the constructor of 'Nested', so that base class 'Named' is constructed before anything else in the body runs. Move this call to the start of the constructor's body, and compute its arguments inside the parentheses.
// @expect-error 'super(...)' must be the first statement of the constructor of 'Prepared', so that base class 'Named' is constructed before anything else in the body runs. Move this call to the start of the constructor's body, and compute its arguments inside the parentheses.
// @expect-error 'super(...)' must be the first statement of the constructor of 'EarlyReturn', so that base class 'Named' is constructed before anything else in the body runs. Move this call to the start of the constructor's body, and compute its arguments inside the parentheses.
// @expect-error The constructor of 'Twice' already calls 'super(...)' in its first statement, and base class 'Named' is constructed only once. Remove this call.
// @expect-error 'super(...)' cannot be called in a 'catch' clause, because the constructor of 'InCatch' already constructs base class 'Named' with the 'super(...)' it starts with. Remove this call. To construct 'Named' with a fallback value, move the call to 'checkedName' into a function that catches 'Refusal' and returns a value to pass to the first 'super(...)'.
// @expect-error 'super(...)' cannot be called inside a lambda, because a lambda can run later or not at all. Call it as the first statement of the constructor of 'Deferred' instead.
// @expect-error 'super(...)' cannot be called inside a lambda, and the constructor of 'ChainedDeferred' already calls it in its first statement. Remove this call.
// @expect-error 'super(...)' runs the constructor of base class 'Named', so it can only be the first statement of a constructor. Remove this call.
// @expect-error 'super(...)' runs the constructor of base class 'Named', so it can only be the first statement of a constructor. Remove this call. To call the base class's version of 'rename', write 'super.rename(name)'.
// @expect-error build failed with 9 problems
// 'super(...)' constructs the base class, so it is allowed only as the first statement of a
// constructor. Written anywhere else, after other statements, inside a branch, a second time, in a
// 'catch' clause, inside a lambda, or in a method, it is refused where it is written, and that
// refusal is the only report about the constructor's base class.
class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

class Named {
    protected string name;

    protected constructor(this.name);

    protected describe() -> string {
        return this.name;
    }

    protected rename(string name) -> string {
        return name;
    }
}

class Nested extends Named {
    protected constructor(bool flag) {
        print("before");
        if (flag) {
            super("x");
        }
    }
}

class Prepared extends Named {
    protected constructor(string text) {
        string checked = try checkedName(text);
        super(checked);
    } catch (Refusal refusal) {
        print("caught");
    }
}

class EarlyReturn extends Named {
    protected constructor(bool early) {
        if (early) {
            return;
        }
        super("named");
    }
}

class Twice extends Named {
    protected constructor() {
        super("a");
        super("b");
    }
}

class InCatch extends Named {
    protected constructor(string text) {
        super(try checkedName(text));
    } catch (Refusal refusal) {
        super("fallback");
    }
}

class Deferred extends Named {
    protected constructor() {
        () -> void later = () -> {
            super("x");
        };
    }
}

class ChainedDeferred extends Named {
    protected constructor() {
        super("x");
        () -> void later = () -> {
            super("y");
        };
    }
}

class InMethod extends Named {
    protected constructor() {
        super("x");
    }

    protected override describe() -> string {
        super("again");
        return "method";
    }

    protected override rename(string name) -> string {
        super(name);
        return name;
    }
}

main() -> int {
    return 0;
}
