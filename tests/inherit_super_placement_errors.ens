// @expect-error 'super(...)' is not called on every path through the constructor of 'Nested', and base class 'Named' must be constructed before the constructor finishes. Call 'super(...)' on the path that skips it.
// @expect-error 'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is constructed only in the body of the constructor. Move the call to 'checkedName' into a function that catches 'Refusal' and returns a value to pass to 'super(...)', and remove this 'catch' clause. If the program cannot continue without that value, replace this call with 'panic(...)'.
// @expect-error build failed with 11 problems
// A subclass constructor calls 'super(...)' exactly once on every path that finishes it, as a
// statement of its own. A path that skips it, a second call on one path, a 'return' before it, a
// call in a loop, a 'catch' clause or a lambda, a call used as a value, and one in a method are
// each refused where they are written, and that refusal is the only report about the base class.
class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

class Named {
    protected string name;

    protected constructor(this.name);

    protected describe() -> string {
        return this.name;
    }

    protected rename(string name) -> string {
        return name;
    }
}

class Nested extends Named {
    protected constructor(bool flag) {
        print("before");
        if (flag) {
            super("x");
        }
    }
}

class Twice extends Named {
    protected constructor() {
        super("a");
        super("b");
    }
}

class Repeated extends Named {
    protected constructor(bool flag) {
        if (flag) {
            super("a");
        }
        super("b");
    }
}

class EarlyReturn extends Named {
    protected constructor(bool early) {
        if (early) {
            return;
        }
        super("named");
    }
}

class Looped extends Named {
    protected constructor(long count) {
        for (long i = 0; i < count; i++) {
            super("again");
        }
    }
}

class InCatch extends Named {
    protected constructor(string text) {
        super(try checkedName(text));
    } catch (Refusal refusal) {
        super("fallback");
    }
}

class Deferred extends Named {
    protected constructor() {
        () -> void later = () -> {
            super("x");
        };
    }
}

class ChainedDeferred extends Named {
    protected constructor() {
        super("x");
        () -> void later = () -> {
            super("y");
        };
    }
}

class Passed extends Named {
    protected constructor() {
        print(super("passed"));
    }
}

class InMethod extends Named {
    protected constructor() {
        super("x");
    }

    protected override describe() -> string {
        super("again");
        return "method";
    }

    protected override rename(string name) -> string {
        super(name);
        return name;
    }
}

main() -> int {
    return 0;
}
