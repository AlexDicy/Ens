// @exit 134
// @stdout-contains panic: something went wrong
// @stdout-contains at fail (panic_call.ens:7)
// @stdout-contains at main (panic_call.ens:10)
// panic() aborts with the message and a trace captured at the panic point.
fail() -> int {
    panic("something went wrong");
}
main() -> int {
    return fail();
}
