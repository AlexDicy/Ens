// @exit 134
// @stderr-contains panic: something went wrong
// @stderr-contains-at O0 at fail (panic_call.ens:8)
// @stderr-contains-at O2 at fail (panic_call.ens:8, inlined)
// @stderr-contains at main (panic_call.ens:11)
// panic() aborts with the message and a trace captured at the panic point.
fail() -> int {
    panic("something went wrong");
}
main() -> int {
    return fail();
}
