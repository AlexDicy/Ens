// @expect-error Method 'amount' of 'Provider' returns 'long', but interface 'Required' requires 'long?', and the two are held differently at run time. An override may narrow a class, interface, array, string, function or handle reference, where both spellings are one pointer, but not a number and not a nullable value type. Return 'long?'.
// @expect-error build failed with 7 problems
// A dispatch slot has one calling convention, so an override may only narrow its return type where
// that leaves the value held the same way. A type parameter is refused for the same reason, since
// what it stands for is not known to be a reference where the override is written.
struct Point {
    protected int x;
}

class Shape {
    protected constructor();
}

class Base {
    protected constructor();

    protected gauge() -> int? {
        return null;
    }

    protected count() -> long {
        return 0;
    }

    protected scale() -> double {
        return 0.0;
    }

    protected spot() -> Point? {
        return null;
    }

    protected twice() -> Shape?? {
        return null;
    }
}

class Derived extends Base {
    protected constructor();

    protected override gauge() -> int {
        return 7;
    }

    protected override count() -> int {
        return 7;
    }

    protected override scale() -> float {
        return 2.5f;
    }

    protected override spot() -> Point {
        Point made = {x: 3};
        return made;
    }

    protected override twice() -> Shape? {
        return null;
    }
}

class Box<T> {
    protected T stored;

    protected constructor(this.stored);

    protected held() -> T? {
        return this.stored;
    }
}

class Tight<T> extends Box<T> {
    protected constructor(T value) {
        super(value);
    }

    protected override held() -> T {
        return this.stored;
    }
}

interface Required {
    amount() -> long?;
}

class Provider implements Required {
    protected constructor();

    protected override amount() -> long {
        return 11;
    }
}

main() -> int {
    return 0;
}
