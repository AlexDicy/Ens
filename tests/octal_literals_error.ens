// @expect-error '0755' starts with a zero, which some languages read as an octal number, a number written in base 8. Write '0o755' for base 8, or '755' for base 10.
// @expect-error '00' starts with a zero, which some languages read as an octal number, a number written in base 8. Write '0o0' for base 8, or '0' for base 10.
// @expect-error '0o78' is an octal number, a number written in base 8, and base 8 has no digit '8'. Use only the digits 0 to 7, or remove '0o' to write a number in base 10.
// @expect-error '0O755' starts an octal number with a capital 'O', which is hard to tell from a zero. Write a small 'o' instead, as in '0o755'.
// @expect-error '0o' starts an octal number, a number written in base 8, but no digit follows it. Write at least one digit from 0 to 7 after '0o', for example '0o755'.
// @expect-error build failed with 5 problems
// A leading zero is refused in a whole number and allowed before a fraction, where nobody reads
// it as base 8.
main() -> int {
    int leading = 0755;
    int zeros = 00;
    int eight = 0o78;
    int capital = 0O755;
    int empty = 0o;
    double fraction = 0.5;
    double padded = 05.5;
    return 0;
}
