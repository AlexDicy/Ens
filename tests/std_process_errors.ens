// @exit 1
// @stderr-contains Unhandled exception SystemError: could not capture the output of
// A capture path that cannot be opened for writing raises a SystemError, which here
// goes unhandled and ends the program.
import @std.system;

main() -> int throws {
    string[] arguments = system.arguments();
    return try system.runCaptured(arguments[0], ["never runs"],
        "build/tests/no_such_folder_for_capture/out.txt",
        "build/tests/no_such_folder_for_capture/err.txt");
}
