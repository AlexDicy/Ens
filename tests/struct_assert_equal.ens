// @exit 0
// @stdout equal ok
// @stdout unequal threw

// testing.assertEqual works on structs now: it compares with '==' and renders
// each value with the struct's JSON form in the failure message.

import @std.testing;

struct Point {
    protected int x;
    protected int y;
}

main() -> int {
    Point a = {x: 1, y: 2};
    Point b = {x: 1, y: 2};
    try testing.assertEqual(a, b);
    print("equal ok");

    Point c = {x: 3, y: 4};
    try testing.assertEqual(a, c);
    print("unreached");
    return 0;
} catch (Error e) {
    print("unequal threw");
    return 0;
}
