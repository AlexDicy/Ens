// Library module: declares an exception hierarchy and a throwing method, plus a
// declared-contract method whose override (here) throws a subclass.
class DbError extends Error {
    int code;
    DbError(string m, this.code) { super(m); }
}
class TimeoutError extends DbError {
    TimeoutError(string m) { super(m, 7); }
}

abstract class Connection {
    abstract run(int q) -> int throws DbError;
}

class Db extends Connection {
    override run(int q) -> int throws {
        if (q == 0) { throw new TimeoutError("timed out"); }
        return q * 2;
    }
}