// Library module: declares an exception hierarchy and a throwing method, plus a
// declared-contract method whose override (here) throws a subclass.
public class DbError extends Error {
    public int code;
    protected constructor(string m, this.code) { super(m); }
}
class TimeoutError extends DbError {
    protected constructor(string m) { super(m, 7); }
}

public abstract class Connection {
    public abstract run(int q) -> int throws DbError;
}

public class Db extends Connection {
    public override run(int q) -> int throws {
        if (q == 0) { throw new TimeoutError("timed out"); }
        return q * 2;
    }
}