// @exit 9
// Cross-module: an exception thrown in lib.db propagates into main and is caught
// by its base class here, proving TypeDescriptor identity holds across modules.
import Db from lib.db;
import DbError from lib.db;

main() -> int {
    let db = new Db();
    int ok = try db.run(21);     // 42 on success
    return try db.run(0);        // throws TimeoutError
} catch (DbError e) {            // catches TimeoutError via the parent chain
    return e.code + 2;           // 7 + 2 = 9
}
