// @exit 7
// @stdout point 3,4
// @stdout config 80x24
// @stdout box 7
// @stdout made 5,50
// @stdout pair 1,2
// @stdout slot 9
// @stdout slotlit 8
// Struct construction in both forms: context-typed aggregate literals and
// call-style constructors, including a defaulted field, a non-defaultable field,
// and a generic instantiation built by both a literal and a generic constructor.
class Cell {
    int value;
    constructor(this.value);

    get() -> int {
        return this.value;
    }
}

struct Point {
    int x;
    int y;
}

struct Config {
    int width = 80;
    int height;
}

struct Box {
    Cell item;
}

struct Made {
    int a;
    int b;

    constructor(int start) {
        this.a = start;
        this.b = start * 10;
    }
}

struct Pair<A, B> {
    A key;
    B value;
}

struct Slot<T> {
    T value;

    constructor(this.value);
}

main() -> int {
    Point p = {x: 3, y: 4};
    print("point {p.x},{p.y}");

    Config c = {height: 24};
    print("config {c.width}x{c.height}");

    Cell cell = new Cell(7);
    Box b = {item: cell};
    print("box {b.item.get()}");

    Made m = Made(5);
    print("made {m.a},{m.b}");

    Cell c1 = new Cell(1);
    Cell c2 = new Cell(2);
    Pair<Cell, Cell> pair = {key: c1, value: c2};
    print("pair {pair.key.get()},{pair.value.get()}");

    Slot<int> slot = Slot<int>(9);
    print("slot {slot.value}");

    Slot<int> slotlit = {value: 8};
    print("slotlit {slotlit.value}");

    return p.x + p.y;
}
