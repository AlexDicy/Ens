// @exit 134
// @stderr-contains which waits for it in turn, so neither can ever finish
// Two tasks that await each other could wait for ever, so the one whose 'await' closes the cycle
// aborts the program, naming the lines that started both.
import @std.tasks;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import Task from @std.tasks;

main() -> int {
    let other = new Atomic<Task<(() -> int throws Cancelled)>?>(null);
    tasks.scope((scope) -> {
        Task<(() -> int throws Cancelled)> first = scope.start(() -> {
            while (other.read() == null) {
                try tasks.sleep(1);
            }
            return (try other.read()?.await()) ?? 0;
        });
        Task<(() -> int throws Cancelled)> second = scope.start(() -> try first.await());
        other.write(second);
    });
    return 0;
}
