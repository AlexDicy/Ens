// @exit 134
// @stderr-contains which waits for it in turn, so neither can ever finish
// Two tasks that await each other could wait for ever, so the one whose 'await' closes the cycle
// aborts the program, naming the lines that started both.
import @std.tasks;
import Atomic from @std.tasks;
import Task from @std.tasks;

main() -> int {
    let other = new Atomic<Task<() -> int>?>(null);
    tasks.scope((scope) -> {
        Task<() -> int> first = scope.start(() -> {
            while (other.read() == null) {
                tasks.sleep(1);
            }
            return other.read()?.await() ?? 0;
        });
        Task<() -> int> second = scope.start(() -> first.await());
        other.write(second);
    });
    return 0;
}
