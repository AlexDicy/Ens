// @exit 0
// @stdout parent before the child
// @stdout the child's own line
// @stdout parent after the child
// The parent's standard output is a file here, so it is buffered, while the child writes to the same
// file directly. Both lines therefore share one stream, and their order is only right if the runtime
// hands the parent's buffer over before the child starts.
import Path from @std.fs;
import @std.environment;
import ProcessError from @std.process;
import @std.process;

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length > 0) {
        print("the child's own line");
        return 0;
    }
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("output_flush_child: this system would not report the path of this program");
        return 1;
    }
    print("parent before the child");
    let ran = try process.run(self, ["child"]);
    print("parent after the child");
    return ran.status.code;
} catch (ProcessError e) {
    eprint("output_flush_child: {e.message}");
    return 1;
}
