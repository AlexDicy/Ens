// @exit 0
// @stdout parent before the child
// @stdout the child's own line
// @stdout parent after the child
// The parent's standard output is a file here, so it is buffered, while the child writes to the same
// file directly. Both lines therefore share one stream, and their order is only right if the runtime
// hands the parent's buffer over before the child starts.
import @std.system;
import SystemError from @std.system;

main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length > 1) {
        print("the child's own line");
        return 0;
    }
    print("parent before the child");
    int status = try system.run(system.executablePath(), ["child"]);
    print("parent after the child");
    return status;
} catch (SystemError e) {
    system.writeError("output_flush_child: {e.message}");
    return 1;
}
