// @expect-error Interface 'Marker' cannot extend class 'Widget'; an interface extends an interface. Write 'class Widget implements Marker' instead.
// @expect-error Interface 'Pointy' cannot extend struct 'Point', because an interface extends only an interface. Name an interface after 'extends'.
// @expect-error Interface 'Tinted' cannot extend enum 'Color', because an interface extends only an interface. Name an interface after 'extends'.
// @expect-error Interface 'Numeric' cannot extend primitive type 'int', because an interface extends only an interface. Name an interface after 'extends'.
// @expect-error Interface 'Odd' cannot extend type parameter 'T', because an interface extends only an interface. Name an interface after 'extends'.
// @expect-error Interface 'Loop' cannot extend itself. Remove 'extends Loop'.
// @expect-error Interface 'Alpha' extends 'Beta', which extends 'Alpha', so 'Alpha' would extend itself. Remove one of the 'extends' clauses in that chain.
// @expect-error Interface 'Repeat' already requires 'makeIterator() -> Iterator<T>', because it extends 'Iterable<T>', which declares it. Remove this second declaration of 'makeIterator'.
// @expect-error Interface 'Wide' is 'export', but the interface it extends, 'Hidden', is private to module 'main'. Mark 'Hidden' 'export', or remove 'export' from 'Wide'.
// @expect-error Interface 'WideLoad' is 'export', but 'Hidden', a type argument of the interface it extends, is private to module 'main'. Mark 'Hidden' 'export', or remove 'export' from 'WideLoad'.
// @expect-error Method 'speak' of 'Liar' can throw 'Failure', which the 'speak' declared by interface 'Mouth' does not list. An implementing method throws only what the interface lists. Remove 'throws Failure' and catch 'Failure' with a 'catch' clause after the body. Or mark 'speak' in 'Mouth' with 'throws Failure'.
// @expect-error Class 'Busted' implements 'Counter<int>' but does not provide 'makeIterator() -> Iterator<int>', required by 'Iterable<int>', which 'Counter<int>' extends. Declare the method, or inherit it from a base class.
// @expect-error Interface 'Packed' cannot extend class 'Crate<int>'; an interface extends an interface. Write 'class Crate<T> implements Packed' instead.
// @expect-error build failed with 13 problems
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

// The extends target must be an interface.
class Widget {
    protected constructor();
}

interface Marker extends Widget {
    mark() -> string;
}

class Crate<T> {
    protected constructor();
}

interface Packed extends Crate<int> {
}

struct Point {
    int x;
}

interface Pointy extends Point {
    point() -> Point;
}

enum Color {
    Red,
    Green,
}

interface Tinted extends Color {
    tint() -> Color;
}

interface Numeric extends int {
    magnitude() -> int;
}

interface Odd<T> extends T {
    odd() -> T;
}

// Self-extension and extension cycles are rejected.
interface Loop extends Loop {
    spin() -> int;
}

interface Alpha extends Beta {
}

interface Beta extends Alpha {
}

// A sub-interface inherits its ancestor's requirements and cannot redeclare one.
interface Repeat<T> extends Iterable<T> {
    makeIterator() -> Iterator<T>;
}

// An exported interface cannot extend a less-visible one, or one instantiated at a
// less-visible type argument.
interface Hidden {
    hide() -> int;
}

export interface Wide extends Hidden {
}

export interface Sack<T> {
    carry() -> T;
}

export interface WideLoad extends Sack<Hidden> {
}

// An implementation may only throw what the declaring rung of the ladder allows.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Mouth {
    speak() -> string;
}

interface Face extends Mouth {
    wink() -> string;
}

class Liar implements Face {
    protected constructor();

    protected override speak() -> string throws Failure {
        throw new Failure("no");
    }

    protected override wink() -> string {
        return "wink";
    }
}

// A class implementing a sub-interface owes the whole ladder; the message names the rung that
// declares the missing method.
interface Counter<T> extends Iterable<T> {
    length() -> long;
}

class Busted implements Counter<int> {
    protected constructor();

    protected override length() -> long {
        return 0;
    }
}

main() -> int {
    return 0;
}
