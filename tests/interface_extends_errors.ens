// @expect-error Interface 'Marker' cannot extend class 'Widget': interfaces extend interfaces, and classes implement them. Write 'class Widget implements Marker' to have 'Widget' implement it.
// @expect-error Interface 'Pointy' cannot extend struct 'Point': interfaces extend interfaces, and classes implement them.
// @expect-error Interface 'Tinted' cannot extend enum 'Color': interfaces extend interfaces, and classes implement them.
// @expect-error Interface 'Numeric' cannot extend primitive type 'int': interfaces extend interfaces, and classes implement them.
// @expect-error Interface 'Odd' cannot extend type parameter 'T': interfaces extend interfaces, and classes implement them.
// @expect-error Interface 'Loop' cannot extend itself.
// @expect-error Interface 'Alpha' eventually extends itself through the interfaces it extends. An interface cannot extend itself, directly or indirectly.
// @expect-error Interface 'Repeat' already requires 'makeIterator() -> Iterator<T>' through 'Iterable<T>', which it extends; an extending interface inherits every requirement. Remove the redeclaration.
// @expect-error Interface 'Wide' is visible as 'export' but the interface it extends, 'Hidden', is private to module
// @expect-error Interface 'WideLoad' is visible as 'export' but its extended interface type argument mentions 'Hidden', which is private to module
// @expect-error Method 'speak' of 'Liar' can throw 'Failure', which interface 'Mouth' does not allow. An implementing method may only throw types the interface method declares.
// @expect-error Class 'Busted' implements 'Counter<int>' but does not provide 'makeIterator() -> Iterator<int>', required by 'Iterable<int>', which 'Counter<int>' extends. Declare the method, or inherit it from a base class.
// @expect-error build failed with 12 problems
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

// The extends target must be an interface.
class Widget {
    protected constructor();
}

interface Marker extends Widget {
    mark() -> string;
}

struct Point {
    int x;
}

interface Pointy extends Point {
    point() -> Point;
}

enum Color {
    Red,
    Green,
}

interface Tinted extends Color {
    tint() -> Color;
}

interface Numeric extends int {
    magnitude() -> int;
}

interface Odd<T> extends T {
    odd() -> T;
}

// Self-extension and extension cycles are rejected.
interface Loop extends Loop {
    spin() -> int;
}

interface Alpha extends Beta {
}

interface Beta extends Alpha {
}

// A sub-interface inherits its ancestor's requirements and cannot redeclare one.
interface Repeat<T> extends Iterable<T> {
    makeIterator() -> Iterator<T>;
}

// An exported interface cannot extend a less-visible one, or one instantiated at a
// less-visible type argument.
interface Hidden {
    hide() -> int;
}

export interface Wide extends Hidden {
}

export interface Sack<T> {
    carry() -> T;
}

export interface WideLoad extends Sack<Hidden> {
}

// An implementation may only throw what the declaring rung of the ladder allows.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Mouth {
    speak() -> string;
}

interface Face extends Mouth {
    wink() -> string;
}

class Liar implements Face {
    protected constructor();

    override speak() -> string throws Failure {
        throw new Failure("no");
    }

    override wink() -> string {
        return "wink";
    }
}

// A class implementing a sub-interface owes the whole ladder; the message names the rung that
// declares the missing method.
interface Counter<T> extends Iterable<T> {
    length() -> long;
}

class Busted implements Counter<int> {
    protected constructor();

    override length() -> long {
        return 0;
    }
}

main() -> int {
    return 0;
}
