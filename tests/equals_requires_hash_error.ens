// @expect-error Class 'Coordinate' defines 'equals' but not 'hash'. A Map or Set uses the two together, so a type that replaces one must replace both. Add 'override hash() -> long'.
class Coordinate {
    int x;
    constructor(this.x);
    override equals(Coordinate other) -> bool { return this.x == other.x; }
}

main() -> int {
    return 0;
}
