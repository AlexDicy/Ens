// @expect-error Abstract method 'read' of 'Reader' is marked 'throws' but lists no exception types. Without a body, the types it throws must be written out. List them after 'throws', as in 'throws Error', or remove 'throws'.
abstract class Reader {
    abstract read() -> int throws;   // abstract 'throws' needs an explicit type list
}
main() -> int { return 0; }