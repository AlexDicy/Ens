// @exit 134
// @stderr-contains panic: tried to set an environment variable with no name. Give it a name
// Writing a variable with no name aborts in the set's own words, since no child could be given it.
import Environment from @std.environment;
import Platform from @std.environment;

main() -> int {
    let variables = Environment.empty(Platform.Linux);
    variables.set("", "value");
    return 0;
}
