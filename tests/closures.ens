// Function values: the three shapes the standard library needs, capture by value, and the places
// a function type can appear.
// @exit 0
// @stdout 1 3 5 9
// @stdout 9 5 3 1
// @stdout 2
// @stdout made
// @stdout 42 -42
// @stdout 5 2
// @stdout 7
// @stdout 3 -1
// @stdout true false
// @stdout 4 x
// @stdout 4 6
// @stdout 21
// @stdout 30
// @stdout 40
// @stdout 6
// @stdout 7
// @stdout 6
// @stdout 1
// @stdout 3
// @stdout 11
// @stdout live 0 of 1000
// @stdout 500000

public class Counter {
    public long total;

    public constructor() {
        this.total = 0;
    }

    public bump(long by) {
        this.total = this.total + by;
    }

    // A lambda capturing 'this' writes a field through the captured reference.
    public adder() -> (long) -> void {
        return (by) -> this.bump(by);
    }
}

// How many Tracked objects were made and how many are still alive, so capture by value can be
// shown to keep exactly one reference for the closure's lifetime and to give it back.
public class Ledger {
    public long made;
    public long live;

    public constructor() {
        this.made = 0;
        this.live = 0;
    }
}

public class Tracked {
    public long tag;
    Ledger ledger;

    public constructor(long tag, Ledger ledger) {
        this.tag = tag;
        this.ledger = ledger;
        ledger.made = ledger.made + 1;
        ledger.live = ledger.live + 1;
    }

    destructor() {
        this.ledger.live = this.ledger.live - 1;
    }
}

public class Sorter {
    (long, long) -> int order;
    ((long) -> bool)? filter;

    public constructor((long, long) -> int order) {
        this.order = order;
        this.filter = null;
    }

    public compare(long a, long b) -> int {
        return this.order(a, b);
    }

    public accept((long) -> bool test) {
        this.filter = test;
    }

    public accepts(long value) -> bool {
        let test = this.filter;
        if (test != null) {
            return test(value);
        }
        return true;
    }
}

// The '(T, T) -> int' shape: an insertion sort over whatever order it is handed.
sortWith(long[] values, (long, long) -> int order) {
    for (long i = 1; i < values.length; i++) {
        long current = values[i];
        long j = i - 1;
        while (j >= 0 && order(values[j], current) > 0) {
            values[j + 1] = values[j];
            j--;
        }
        values[j + 1] = current;
    }
}

// The '(T) -> bool' shape.
countWhere(long[] values, (long) -> bool test) -> long {
    long found = 0;
    for (let value in values) {
        if (test(value)) {
            found++;
        }
    }
    return found;
}

// The '() -> V' shape.
orElse(string? text, () -> string make) -> string {
    if (text != null) {
        return text;
    }
    return make();
}

// A lambda inside a generic body, instantiated per type argument.
twice<T>((T) -> T step, T start) -> T {
    return step(step(start));
}

identity<T>() -> (T) -> T {
    return (value) -> value;
}

// A lambda returned to a caller that calls it later.
scaler(long factor) -> (long) -> long {
    return (value) -> value * factor;
}

// A lambda inside a lambda: the outer one captures what the inner one reads.
nested(long base) -> () -> (long) -> long {
    return () -> (value) -> value + base;
}

// A lambda capturing two function values, which its closure gives up like any other reference.
compose((long) -> long first, (long) -> long second) -> (long) -> long {
    return (value) -> second(first(value));
}

// A function type written as another function type's parameter type: the parentheses around the
// inner one are the pair it is always written with, and the comma inside it belongs to it.
usingTest(((long) -> bool) -> long pick) -> long {
    return pick((v) -> v > 3L);
}

// A capture-free lambda in a hot loop: one immortal object, so no allocation per evaluation.
hotLoop() -> long {
    long total = 0;
    for (long i = 0; i < 100000; i++) {
        (long) -> long step = (value) -> value + 5;
        total = total + step(0L);
    }
    return total;
}

// Capture of a class reference in a loop: every closure keeps its own reference and gives it back
// with the closure, so nothing is left alive and nothing is released twice.
trackedLoop(Ledger ledger) {
    for (long i = 0; i < 1000; i++) {
        let tracked = new Tracked(i, ledger);
        (long) -> long tagged = (value) -> value + tracked.tag;
        long ignored = tagged(1L);
    }
}

printJoined(long[] values) {
    print("{values[0]} {values[1]} {values[2]} {values[3]}");
}

main() -> int {
    long[] values = [5L, 3L, 9L, 1L];
    sortWith(values, (a, b) -> (a - b) as int);
    printJoined(values);
    sortWith(values, (a, b) -> (b - a) as int);
    printJoined(values);

    long threshold = 4;
    print("{countWhere(values, (v) -> v > threshold)}");
    print(orElse(null, () -> "made"));

    // Explicit parameter types, and a block body.
    (int, int) -> int subtract = (int a, int b) -> {
        return a - b;
    };
    print("{subtract(84, 42)} {subtract(42, 84)}");

    // Parentheses group a lambda without hiding the type it is written against.
    (int, int) -> int wrapped = ((a, b) -> a + b);
    print("{wrapped(2, 3)} {countWhere(values, ((v) -> v > threshold))}");

    let counter = new Counter();
    let add = counter.adder();
    add(3L);
    add(4L);
    print("{counter.total}");

    let sorter = new Sorter((a, b) -> (a - b) as int);
    print("{sorter.compare(9L, 6L)} {sorter.compare(6L, 7L)}");
    sorter.accept((v) -> v > 0);
    print("{sorter.accepts(2L)} {sorter.accepts(-2L)}");

    // A lambda inside a generic function, at two type arguments.
    let numeric = identity<long>();
    let textual = identity<string>();
    print("{numeric(4L)} {textual("x")}");
    print("{twice<long>((v) -> v + 2L, 0L)} {twice<long>((v) -> v * 2L + 2L, 0L)}");

    // A function value in an array.
    ((long) -> long)[] steps = [(v) -> v + 1L, (v) -> v * 2L];
    print("{steps[0](20L) + steps[1](0L)}");

    let times3 = scaler(3L);
    print("{times3(10L)}");

    // Ordinary call syntax on whatever holds the value: the result of a call, and a nullable one
    // once '??' has supplied the fallback.
    print("{scaler(4L)(10L)}");
    ((long) -> long)? missing = null;
    print("{(missing ?? times3)(2L)}");
    print("{nested(5L)()(2L)}");
    let plusOneTimesThree = compose((v) -> v + 1L, times3);
    print("{plusOneTimesThree(1L)}");
    print("{usingTest((test) -> (test(4L) ? 1L : 0L))}");

    // A '?:' and a switch expression each produce one value, so their branches are written
    // against the same type the whole expression flows into and a lambda takes its shape there.
    bool ascending = true;
    (long, long) -> int chosen = ascending ? (a, b) -> (a - b) as int
        : (a, b) -> (b - a) as int;
    print("{chosen(9L, 6L)}");
    int mode = 1;
    (long) -> long adjust = switch (mode) {
        1 -> (v) -> v + 1L,
        default -> (v) -> v - 1L,
    };
    print("{adjust(10L)}");

    let ledger = new Ledger();
    trackedLoop(ledger);
    print("live {ledger.live} of {ledger.made}");

    print("{hotLoop()}");
    return 0;
}
