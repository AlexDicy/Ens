// @exit 0
// @stdout self true
// @stdout other true
// @stdout two true
// @stdout box true
// @stdout cycle true false
// @stdout base 7
// @stdout cell 3
// @stdout array true
// @stdout optional true

// A type argument names a type, it does not ask for its layout, so a class may hand itself to the
// interface it implements, to the generic base it extends, or to a generic class a field holds.
// Every shape below is an ordinary conformance or field whose type argument leads back to the type
// that wrote it.

public interface Same<T> {
    matches(T other) -> bool;
}

public interface Pairs<A, B> {
    link(A left, B right) -> bool;
}

// The self-referential conformance: 'Node' stands among its own interface's type arguments.
public class Node implements Same<Node> {
    protected int id;

    protected constructor(this.id);

    public override matches(Node other) -> bool {
        return this.id == other.id;
    }
}

// 'Same' implemented at a type argument that is not the implementing class.
public class Labeled implements Same<string> {
    protected string label;

    protected constructor(this.label);

    public override matches(string other) -> bool {
        return this.label == other;
    }
}

// Two type parameters, one of them the conforming class.
public class Linked implements Pairs<Linked, string> {
    protected int id;

    protected constructor(this.id);

    public override link(Linked left, string right) -> bool {
        return left.id == this.id && right.length > 0;
    }
}

// A generic class conforming at its own instantiation, so every instance's argument names itself.
public class Box<T> implements Same<Box<T>> {
    protected T item;
    protected int tag;

    protected constructor(this.item, this.tag);

    public override matches(Box<T> other) -> bool {
        return this.tag == other.tag;
    }
}

// Two classes conforming at each other, so the conformance graph carries a cycle.
public class Alpha implements Same<Beta> {
    protected constructor();

    public override matches(Beta other) -> bool {
        return true;
    }
}

public class Beta implements Same<Alpha> {
    protected constructor();

    public override matches(Alpha other) -> bool {
        return false;
    }
}

public class Holder<T> {
    protected int held;

    protected constructor(this.held);

    public tagged() -> int {
        return this.held;
    }
}

// A class extending a generic base at its own type.
public class SelfHeld extends Holder<SelfHeld> {
    protected constructor() {
        super(7);
    }
}

// A struct whose field is a generic class instantiated over the struct itself.
public struct Cell {
    public Holder<Cell>? held = null;
    public int count = 0;
}

// An array and an optional of the conforming class, as type arguments.
public class Listed implements Same<Listed[]> {
    protected constructor();

    public override matches(Listed[] other) -> bool {
        return other.length > 0;
    }
}

public class Maybe implements Same<Maybe?> {
    protected constructor();

    public override matches(Maybe? other) -> bool {
        return other != null;
    }
}

main() -> int {
    print("self {new Node(1).matches(new Node(1))}");
    print("other {new Labeled("x").matches("x")}");
    let linked = new Linked(2);
    print("two {linked.link(linked, "y")}");
    print("box {new Box<int>(3, 1).matches(new Box<int>(4, 1))}");
    let alpha = new Alpha();
    let beta = new Beta();
    print("cycle {alpha.matches(beta)} {beta.matches(alpha)}");
    print("base {new SelfHeld().tagged()}");
    Cell cell = {held: null, count: 3};
    print("cell {cell.count}");
    let listed = new Listed();
    print("array {listed.matches([listed])}");
    let maybe = new Maybe();
    print("optional {maybe.matches(maybe)}");
    return 0;
}
