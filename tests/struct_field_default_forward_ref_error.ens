// One mistake, one error, per reference: each field named before its own declaration is explained
// once, and not also as an undefined name at the same position.
// @expect-error The default value of field 'area' references 'width', which is declared later
// @expect-error The default value of field 'area' references 'height', which is declared later
// @expect-error build failed with 2 problems
struct Bad {
    int area = width * height;
    int width = 4;
    int height = 5;
}

main() -> int {
    Bad b = {area: 20};
    return b.area;
}
