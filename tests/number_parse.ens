// @stdout bases: ff 11111111 377 73 -ff
// @stdout padded: 00ff 00000101
// @stdout widest: 7fffffffffffffff -8000000000000000 ffffffffffffffff
// @stdout longs: 42 -7 0 9223372036854775807 -9223372036854775808
// @stdout long refusals: null null null null null null
// @stdout radix reads: 255 255 255 35 null
// @stdout round trip: agreed
// @stdout ints: 2147483647 -2147483648 null null
// @stdout doubles: 2.5 -2.5 1000 0.015 3
// @stdout double refusals: null null null null null null
// @stdout bools: true false null null
// @exit 0
// The numeric text and the parsers as a whole program sees them, including the round trip between
// a value's digits in a base and the value read back out of them.
import @std.text.parse;

main() -> int {
    long count = 255;
    print("bases: {count.toString(16)} {count.toString(2)} {count.toString(8)} "
        + "{count.toString(36)} {(0 - count).toString(16)}");
    print("padded: {count.toString(16).padStart(4, '0')} {5L.toString(2).padStart(8, '0')}");
    long largest = 9223372036854775807;
    long smallest = -9223372036854775808;
    ulong wide = 18446744073709551615;
    print("widest: {largest.toString(16)} {smallest.toString(16)} {wide.toString(16)}");

    print("longs: {shown(parse.parseLong("42"))} {shown(parse.parseLong("-7"))} "
        + "{shown(parse.parseLong("0"))} {shown(parse.parseLong("9223372036854775807"))} "
        + "{shown(parse.parseLong("-9223372036854775808"))}");
    print("long refusals: {shown(parse.parseLong(" 1"))} {shown(parse.parseLong("1 "))} "
        + "{shown(parse.parseLong("0x10"))} {shown(parse.parseLong("1_000"))} "
        + "{shown(parse.parseLong("1.5"))} {shown(parse.parseLong("9223372036854775808"))}");
    print("radix reads: {shown(parse.parseLong("ff", 16))} {shown(parse.parseLong("FF", 16))} "
        + "{shown(parse.parseLong("11111111", 2))} {shown(parse.parseLong("z", 36))} "
        + "{shown(parse.parseLong("ff", 10))}");

    bool agreed = roundTripped(largest) && roundTripped(smallest) && roundTripped(0)
        && roundTripped(-255);
    print("round trip: {agreed ? "agreed" : "differed"}");

    print("ints: {shownInt(parse.parseInt("2147483647"))} "
        + "{shownInt(parse.parseInt("-2147483648"))} {shownInt(parse.parseInt("2147483648"))} "
        + "{shownInt(parse.parseInt(" 42"))}");
    print("doubles: {shownDouble(parse.parseDouble("2.5"))} "
        + "{shownDouble(parse.parseDouble("-2.5"))} {shownDouble(parse.parseDouble("1e3"))} "
        + "{shownDouble(parse.parseDouble("1.5e-2"))} {shownDouble(parse.parseDouble("3"))}");
    print("double refusals: {shownDouble(parse.parseDouble(".5"))} "
        + "{shownDouble(parse.parseDouble("5."))} {shownDouble(parse.parseDouble("1_0.5"))} "
        + "{shownDouble(parse.parseDouble("inf"))} {shownDouble(parse.parseDouble("1e"))} "
        + "{shownDouble(parse.parseDouble("1e400"))}");
    print("bools: {shownBool(parse.parseBool("true"))} {shownBool(parse.parseBool("false"))} "
        + "{shownBool(parse.parseBool("TRUE"))} {shownBool(parse.parseBool("yes"))}");
    return 0;
}

// Whether the value's digits in every base read back as that value.
roundTripped(long value) -> bool {
    for (let radix in [2, 8, 16, 36]) {
        if (parse.parseLong(value.toString(radix), radix) != value) {
            return false;
        }
    }
    return true;
}

shown(long? value) -> string {
    return value == null ? "null" : "{value}";
}

shownInt(int? value) -> string {
    return value == null ? "null" : "{value}";
}

shownDouble(double? value) -> string {
    return value == null ? "null" : "{value}";
}

shownBool(bool? value) -> string {
    return value == null ? "null" : "{value}";
}
