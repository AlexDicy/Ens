// @stdout doubles: 2.5 -2.5 1000 0.015 3
// @exit 0
// The doubles the parser reads, printed in the text form a whole program writes them in.
import @std.text.parse;

main() -> int {
    print("doubles: {shownDouble(parse.parseDouble("2.5"))} "
        + "{shownDouble(parse.parseDouble("-2.5"))} {shownDouble(parse.parseDouble("1e3"))} "
        + "{shownDouble(parse.parseDouble("1.5e-2"))} {shownDouble(parse.parseDouble("3"))}");
    return 0;
}

shownDouble(double? value) -> string {
    return value == null ? "null" : "{value}";
}
