// @exit 0
// @stdout inherited ok base:manifest
// @stdout throwing err missing: ghost
// @stdout virtual deriving:chain
// @stdout direct base:direct
// @stdout deriving ok deriving:override
// A conformance satisfied by an inherited method fixes the calling convention of the base method
// that answers it, so that method and every override of it carry the interface's error slot even
// though nothing in the base's own file says so. All four edges to that one entry agree.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public interface Loader {
    load(string name) -> string throws Error;
}

public class Base {
    protected constructor();

    public load(string name) -> string {
        return "base:" + name;
    }
}

public class Inheriting extends Base implements Loader {
    protected constructor();
}

public class Deriving extends Inheriting {
    protected constructor();

    public override load(string name) -> string {
        return "deriving:" + name;
    }
}

public class Failing implements Loader {
    protected constructor();

    public override load(string name) -> string throws Error {
        throw new Failure("missing: " + name);
    }
}

throughInterface(Loader loader, string name) -> string {
    return "ok " + (try loader.load(name));
} catch (Error e) {
    return "err " + e.message;
}

main() -> int {
    Loader inherited = new Inheriting();
    Loader failing = new Failing();
    Base viaBase = new Deriving();
    print("inherited " + throughInterface(inherited, "manifest"));
    print("throwing " + throughInterface(failing, "ghost"));
    print("virtual " + viaBase.load("chain"));
    print("direct " + new Inheriting().load("direct"));
    print("deriving " + throughInterface(new Deriving(), "override"));
    return 0;
}
