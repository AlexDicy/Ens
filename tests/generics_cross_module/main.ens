// @exit 25
// List<int> is used in both this module and `util`, so the linker must collapse
// the two emissions into one. List<Widget> uses a type local to this module,
// proving the template's module can emit an instantiation over a type it cannot see.
// A generic function imported from `util` is monomorphized in `util` and called here.
import List from @std.collections.list;
import util;

class Widget { int id; constructor(this.id); }

main() -> int {
    let v = new List<int>();
    v.push(10);
    let w = new List<Widget>();
    w.push(new Widget(5));
    int chosen = util.pick<int>(3, 99, true);
    return (v.get(0) as int) + util.contribute() + w.get(0).id + chosen;
}