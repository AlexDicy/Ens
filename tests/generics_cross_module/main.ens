// @exit 22
// Vector<int> is used in both this module and `util`, so the linker must collapse
// the two emissions into one. Vector<Widget> uses a type local to this module,
// proving the template's module can emit an instantiation over a type it cannot see.
import Vector from @std.vector;
import util;

class Widget { int id; Widget(this.id); }

main() -> int {
    let v = new Vector<int>();
    v.push(10);
    let w = new Vector<Widget>();
    w.push(new Widget(5));
    return (v.get(0) as int) + util.contribute() + w.get(0).id;
}