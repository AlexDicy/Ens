// @exit 25
// List<int> is used in both this module and `util`, so the linker has to collapse the two
// emissions into one. List<Widget> uses a type local to this module, so the template's module
// emits an instantiation over a type it cannot see.
import List from @std.collections.list;
import util;

class Widget { protected int id; protected constructor(this.id); }

main() -> int {
    let v = new List<int>();
    v.push(10);
    let w = new List<Widget>();
    w.push(new Widget(5));
    int chosen = util.pick<int>(3, 99, true);
    return (v.get(0) as int) + util.contribute() + w.get(0).id + chosen;
}