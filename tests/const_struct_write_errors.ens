// @expect-error build failed with 14 problems
// A struct's fields are part of its value, so a write into one, at any depth and in any form,
// changes the constant that holds the struct: a lazy const, a 'const' local or a 'const' field.
struct Point {
    int x;
    int y;
}

struct Outer {
    Point inner;
}

struct Frame {
    const Point corner;

    constructor(this.corner);
}

class Settings {
    lazy const Point point = {x: 1, y: 2};
    lazy const Outer outer = {inner: {x: 1, y: 2}};
}

class Holder {
    const Point point;
    const Outer outer = {inner: {x: 0, y: 0}};

    constructor() {
        this.point = {x: 1, y: 2};
        this.point.x = 5;
    }

    shift() {
        this.point.y = 3;
        this.outer.inner.x += 1;
        this.point.x--;
    }
}

lazyWrites() {
    Settings.point.x = 5;
    Settings.outer.inner.x = 7;
    Settings.point.y += 1;
    Settings.point.x++;
}

localWrites() {
    const Point typed = {x: 1, y: 2};
    const untyped = Settings.point;
    const Outer nested = {inner: {x: 1, y: 2}};
    typed.x = 5;
    untyped.y -= 1;
    nested.inner.x = 3;
    ++typed.y;
}

fieldWrites(Holder holder) {
    holder.point.x = 4;
    let frame = Frame({x: 0, y: 0});
    frame.corner.y = 9;
}

main() -> int {
    lazyWrites();
    localWrites();
    fieldWrites(new Holder());
    return 0;
}
