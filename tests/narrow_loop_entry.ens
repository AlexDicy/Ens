// @exit 0
// @stdout loop-entry 6 12 8 4
// @stdout loop-stores 3 10 4
// @stdout loop-nested 9 24
// A narrowing made before a loop holds on every pass unless a write in the loop can store a value it
// does not cover. A condition-derived narrowing is re-established each iteration, a guard-clause
// narrowing inside the body is untouched, a narrowing on a 'const' field survives even when the body
// writes a sibling field, and a write that stores a value of the narrowed type keeps the narrowing.
class Node {
    protected int size;
    protected Node? next;

    protected constructor(this.size, this.next = null);
}

class Pair {
    protected const Node? left;
    protected Node? right;

    protected constructor(this.left, this.right);
}

// The loop condition narrows `cursor` fresh on every iteration, even though the body
// reassigns it - the write only drops the narrowing after the read.
walk(Node? cursor) -> int {
    int total = 0;
    while (cursor != null) {
        total = total + cursor.size;
        cursor = cursor.next;
    }
    return total;
}

// A `continue` guard narrows `item` inside the body, and what the loop drops where it starts
// leaves that in-body narrowing intact.
guarded(Node?[] items) -> int {
    int total = 0;
    for (let item in items) {
        if (item == null) {
            continue;
        }
        total = total + item.size;
    }
    return total;
}

// `pair.left` is a 'const' field, so it stays narrowed across iterations even though the
// body writes the sibling field `pair.right`.
sibling(Pair pair) -> int {
    if (pair.left != null && pair.right != null) {
        int total = 0;
        for (int i = 0; i < 2; i = i + 1) {
            total = total + pair.left.size;
            pair.right = null;
        }
        return total;
    }
    return -1;
}

// A loop in a lambda that writes a local of its own copies nothing from around the lambda, even
// where a local outside it has the same name and has no value yet.
ownLocal() -> int {
    int size;
    () -> int count = () -> {
        int rounds = 0;
        while (rounds < 4) {
            int size = 1;
            size = size + 1;
            rounds = rounds + size;
        }
        return rounds;
    };
    size = 0;
    return count() + size;
}

// Every write to `name` in the loop stores a 'string', so the narrowing made before the loop holds on
// every pass.
stored() -> long {
    string? name = "a";
    long total = 0;
    for (int i = 0; i < 3; i++) {
        total = total + name.length;
        name = "b";
    }
    return total;
}

// Both branches store a 'string', one of them built from `name` itself.
storedByEachBranch(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    while (total < 9) {
        total = total + name.length;
        if (total > 5) {
            name = "cc";
        } else {
            name = name + "d";
        }
    }
    return total;
}

// The write stores an element only once a check proves it is not null.
storedWhenChecked(string?[] items, string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (let item in items) {
        total = total + name.length;
        if (item != null) {
            name = item;
        }
    }
    return total;
}

// The inner loop stores a 'string' into `name`, so the narrowing made before the outer loop holds on
// every pass through both loops.
storedInside(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (int i = 0; i < 3; i++) {
        total = total + name.length;
        for (int j = 0; j < 2; j++) {
            total = total + name.length;
            name = "b";
        }
    }
    return total;
}

// A local declared inside the outer loop is declared again on every pass, and the loops inside drop
// or keep its narrowing the same way on each of them.
declaredInside(string? name, Node head) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    while (total < 20) {
        total = total + name.length;
        name = "bb";
        string? inner = "abc";
        for (int i = 0; i < 2; i++) {
            inner = null;
        }
        Node? cursor = head;
        while (cursor != null) {
            total = total + cursor.size;
            cursor = cursor.next;
        }
    }
    return total;
}

main() -> int {
    int a = walk(new Node(1, new Node(2, new Node(3))));   // 6
    int b = guarded([new Node(4), null, new Node(8)]);     // 12
    int c = sibling(new Pair(new Node(4), new Node(9)));   // 8
    int d = ownLocal();                                    // 4
    print("loop-entry " + a + " " + b + " " + c + " " + d);
    print("loop-stores {stored()} {storedByEachBranch("a")} {storedWhenChecked(["xyz", null], "a")}");
    print("loop-nested {storedInside("a")} {declaredInside("a", new Node(1, new Node(2)))}");
    return (a - 6) + (b - 12) + (c - 8) + (d - 4);
}
