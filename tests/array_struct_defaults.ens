// @exit 65
// `new T[n]` runs each slot through T's field defaults. Without per-slot
// initialization, every Box would be zero and the sum would be 0.
struct Box {
    int width = 20;
    int height = 5;
}

main() -> int {
    Box[] boxes = new Box[3];
    // 20 + 20 + 20 + 5 = 65 if defaults ran per slot.
    return boxes[0].width + boxes[1].width + boxes[2].width + boxes[2].height;
}