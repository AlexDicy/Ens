// @expect-error Duplicate switch label
// A hex-escape spelling and the plain letter name the same string (the
// letter A), so listing both is a duplicate even though the raw text differs.
kind(string s) -> int {
    return switch (s) {
        "\u0041" -> 1,
        "A" -> 2,
        default -> 0,
    };
}

main() -> int {
    return kind("A");
}
