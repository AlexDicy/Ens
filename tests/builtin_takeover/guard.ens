// A module that declares 'panic(string)' without 'noreturn'. The declaration takes nothing from
// the one the language provides, so it is an ordinary function here: it returns, and the
// statements after a call to it run.
import emit;

public panic(string message) {
    emit.line("guard: " + message);
}

public survive() -> long {
    panic("recorded");
    emit.line("guard: still running");
    return 5;
}
