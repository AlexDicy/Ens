// A module that declares 'panic(long)'. A different parameter list overloads the provided
// function instead of replacing it, so the provided 'panic(string)' still ends a path here.
import emit;

public panic(long code) {
    emit.line("own: code {code}");
}

public report(long code) -> long {
    panic(code);
    return code;
}

// Accepted only because the provided 'panic(string)' is still here and never returns; nothing
// calls this.
public stillProvided() -> long {
    panic("nothing returns from here");
}
