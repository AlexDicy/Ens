// A declaration replaces the function the language provides under the same name and parameter
// types, in the module that writes it and nowhere else, while a different parameter list
// overloads it instead.
// @stdout main: printed
// @stdout own: code 3
// @stdout guard: recorded
// @stdout guard: still running
// @exit 0
import emit;
import guard;
import own;

main() -> int {
    print("main: printed");
    if (own.report(3L) != 3L) {
        return 1;
    }
    if (guard.survive() != 5L) {
        return 2;
    }
    if (emit.chosen(true) != 4L) {
        return 3;
    }
    return 0;
}
