// A declaration replaces the function the language provides under the same name and parameter
// types, in the module that writes it and nowhere else. A different parameter list overloads
// instead of replacing, so this module keeps the provided 'print(string)' beside 'print(long)'.
// @stdout main: provided
// @stdout main: count 3
// @stdout own: through its own print
// @stdout own: qualified
// @stdout guard: recorded
// @stdout guard: still running
// @exit 0
import emit;
import guard;
import own;

print(long count) {
    print("main: count {count}");
}

main() -> int {
    print("main: provided");
    print(3L);
    own.speak("through its own print");
    own.print("qualified");
    if (guard.survive() != 5L) {
        return 1;
    }
    if (emit.chosen(true) != 4L) {
        return 2;
    }
    return 0;
}
