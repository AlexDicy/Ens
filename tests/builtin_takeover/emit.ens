// A module that declares neither name, so 'panic' is the language's own and still ends every path
// it sits on, which is what lets 'chosen' and 'required' be accepted.
public line(string text) {
    print(text);
}

public chosen(bool flag) -> long {
    long value;
    if (flag) {
        value = 4;
    } else {
        panic("no value to choose");
    }
    return value;
}

public required() -> long {
    panic("nothing calls this");
}
