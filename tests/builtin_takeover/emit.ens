// A module that declares neither of the names the language provides, so both calls here reach the
// language's own: 'print' writes the line, and 'panic' still ends every path it sits on, which is
// what lets 'chosen' and 'required' be accepted.
public line(string text) {
    print(text);
}

public chosen(bool flag) -> long {
    long value;
    if (flag) {
        value = 4;
    } else {
        panic("no value to choose");
    }
    return value;
}

public required() -> long {
    panic("nothing calls this");
}
