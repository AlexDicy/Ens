// @expect-error Fields 'extra' and 'other' of class 'Late' are assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Move 'this.extra = "e";' and 'this.other = "o";' above 'super("a");'.
// @expect-error Fields 'label' and 'mark' of class 'Greeting' are assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. 'this.label = this.name + "!";' reads 'name', a field of base class 'Named' that has no value until 'Named' is constructed. Compute 'label' from 'name', the constructor's parameter, as in 'this.label = name + "!";', and move it above 'super(name);'. 'this.mark = "{this.describe()}?";' calls 'describe' on 'this', and 'describe' may read the fields of 'Named'. Give 'mark' a first value above 'super(name);', as in 'this.mark = "";'.
// @expect-error Field 'label' of class 'Copied' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. 'this.label = this.name;' reads 'name', a field of base class 'Named' that has no value until 'Named' is constructed. Give 'label' a first value above 'super("fixed");', as in 'this.label = "";'.
// @expect-error Field 'reason' of class 'Chosen' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Move the 'if' statement that assigns 'reason' above 'super(given);'.
// @expect-error Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it cannot be read here. Give 'extra' a first value here, as in 'this.extra = "";', and write 'this.extra = this.name;' after 'super("a");'.
// @expect-error 'describe' is called on 'this' before base class 'Named' is constructed, and 'describe' may read the fields of 'Named'. Move this call after 'super(...)'.
// @expect-error 'super.describe()' is called before base class 'Named' is constructed, and the code it runs may read the fields of 'Named'. Move this call after 'super(...)'.
// @expect-error Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, because constructing 'Named' gives it its value. Pass the value to 'super(...)', as in 'super("n");', and remove this assignment.
// @expect-error 'super.describe()' is called before base class 'Root' is constructed, and the code it runs may read the fields of 'Root'. A constructor that does not call 'super(...)' constructs 'Root' when it finishes, so call 'super();' before this call.
// @expect-error Field 'count' of base class 'Root' has no value until 'Root' is constructed, so it cannot be read here. Give 'extra' a first value here, as in 'this.extra = "";', then call 'super();' and write 'this.extra = "{this.count}";' after it.
// @expect-error The constructor of 'Recovers' can return an object whose base class 'Named' was never constructed: 'checkedName' can throw 'Refusal' before 'super(...)', and this 'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' and returns a fallback value, and remove this 'catch' clause. If the program cannot continue without that value, end the clause with 'panic(...)'.
// @expect-error Field 'summary' of class 'CountsLate' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Filled' runs. 'this.summary = "{this.items.length()}";' reads 'items', a field of base class 'Filled' that has no value until 'Filled' is constructed. Give 'summary' a first value above 'super(given);', as in 'this.summary = "";'.
// @expect-error Field 'items' of base class 'Filled' has no value until 'Filled' is constructed, so it cannot be read here. Give 'summary' a first value here, as in 'this.summary = "";', and assign 'summary' its value after 'super(given);'.
// @expect-error Field 'copy' of class 'Bumped' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Counter' runs. 'this.copy = "{this.count += 1}";' also assigns 'count', a field of base class 'Counter' that cannot be assigned until 'Counter' is constructed. Give 'copy' a first value above 'super(given);', as in 'this.copy = "";'.
// @expect-error Field 'copy' of class 'Renames' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. 'this.copy = (this.name = "z");' also assigns 'name', a field of base class 'Named' that cannot be assigned until 'Named' is constructed. Give 'copy' a first value above 'super(given);', as in 'this.copy = "";'.
// @expect-error Field 'scaled' of class 'Scaled' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Amount' runs. 'this.scaled = "{this.amount * 1000000}";' reads 'amount', a field of base class 'Amount' that has no value until 'Amount' is constructed. Give 'scaled' a first value above 'super(given);', as in 'this.scaled = "";'.
// @expect-error Field 'shown' of class 'Noted' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Maybe' runs. 'this.shown = this.note ?? "none";' reads 'note', a field of base class 'Maybe' that has no value until 'Maybe' is constructed. Give 'shown' a first value above 'super(given);', as in 'this.shown = "";'.
// @expect-error Field 'kind' of class 'Sorted' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Holder' runs. 'this.kind = kind(this.shape);' reads 'shape', a field of base class 'Holder' that has no value until 'Holder' is constructed. Give 'kind' a first value above 'super(given);', as in 'this.kind = "";'.
// @expect-error Field 'label' of class 'Reassigns' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Field 'label' of class 'Suffixed' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. 'this.label = this.name + suffix;' reads 'name', a field of base class 'Named' that has no value until 'Named' is constructed. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, because constructing 'Named' gives it its value. Assign it after 'super(...)'.
// @expect-error Field 'label' of class 'Pushes' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Fields 'label', 'mark' and 'items' of class 'Migrates' are assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Announced' runs. Move 'this.label = label;', 'this.mark = mark;' and 'this.items = items;' above 'super(given);'.
// @expect-error Field 'label' of class 'Aliased' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Field 'label' of class 'ReadsLazy' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Field 'label' of class 'Releases' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "";'.
// @expect-error Field 'label' of class 'ChangesArgument' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'label' a first value above 'super(given + suffix);', as in 'this.label = "";'.
// @expect-error Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it cannot be read here. Give 'extra' a first value here, as in 'this.extra = "";', and assign 'extra' its value after 'super(given + (tag = "b"));'.
// @expect-error Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, because constructing 'Named' gives it its value. Assign it after 'super(...)'.
// @expect-error Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, because constructing 'Named' gives it its value. Assign it after 'super(...)'.
// @expect-error Field 'count' of base class 'Counter' has no value until 'Counter' is constructed, so '++' cannot change it here. Write this line after 'super(...)'.
// @expect-error Field 'count' of base class 'Counter' has no value until 'Counter' is constructed, so '--' cannot change it here. Write this line after 'super(...)'.
// @expect-error Field 'count' of base class 'Counter' has no value until 'Counter' is constructed, so the arguments of 'super(...)' cannot change it with '++'. Pass a value that does not come from 'this', such as a parameter of the constructor.
// @expect-error Field 'count' of base class 'Counter' has no value until 'Counter' is constructed, so '+=' cannot change it here. Write this line after 'super(...)'.
// @expect-error Field 'count' of base class 'Counter' cannot be changed in this 'catch' clause, because when 'checkedName' throws 'Refusal' before 'super(...)', 'Counter' is not constructed yet. Remove this increment, or remove this 'catch' clause and move the call to 'checkedName' into a function that catches 'Refusal' and returns a fallback value.
// @expect-error Field 'name' of base class 'Named' cannot be assigned in this 'catch' clause, because when 'checkedName' throws 'Refusal' before 'super(...)', 'Named' is not constructed yet. Remove this assignment, or remove this 'catch' clause and move the call to 'checkedName' into a function that catches 'Refusal' and returns a fallback value.
// @expect-error Field 'name' of base class 'Named' cannot be assigned in this 'catch' clause, because when 'checkedName' throws 'Refusal' in the arguments of 'super(...)', 'Named' is not constructed yet. Remove this assignment, or remove this 'catch' clause and move the call to 'checkedName' into a function that catches 'Refusal' and returns a value to pass to 'super(...)'.
// @expect-error Fields 'label' and 'mark' of class 'ReadsLate' are assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Named' runs. Give 'mark' and 'label' first values above 'super(given);', as in 'this.mark = "";' and 'this.label = "";'.
// @expect-error Field 'label' of class 'ReadsLate' cannot be null, and it is read here before every path through the constructor assigns it. Assign it before this line on every path, for example 'this.label = ...;'.
// @expect-error build failed with 39 problems
// Before 'super(...)' returns, a subclass constructor assigns its own fields and uses 'this' for
// nothing else, and one that writes no 'super(...)' is in that first phase until it finishes.
// A fix moves a statement past 'super(...)' or computes it from a parameter only where the
// program then does the same.
import List from @std.collections.list;

class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

class Named {
    protected string name;

    protected constructor(this.name);

    protected describe() -> string {
        return this.name;
    }
}

class Late extends Named {
    string extra;
    string other;

    constructor() {
        print("before");
        super("a");
        this.extra = "e";
        this.other = "o";
    }
}

class Greeting extends Named {
    string label;
    string mark;

    constructor(string name) {
        print("building");
        super(name);
        this.label = this.name + "!";
        this.mark = "{this.describe()}?";
    }
}

class Copied extends Named {
    string label;

    constructor() {
        print("building");
        super("fixed");
        this.label = this.name;
    }
}

class Chosen extends Named {
    string reason;

    constructor(string given) {
        print("building");
        super(given);
        if (given.length == 0) {
            this.reason = "none";
        } else {
            this.reason = given;
        }
    }
}

class Reads extends Named {
    string extra;

    constructor() {
        this.extra = this.name;
        super("a");
    }
}

class Calls extends Named {
    string extra;

    constructor() {
        this.extra = "e";
        print(this.describe());
        super("a");
    }
}

class BaseCalls extends Named {
    string extra;

    constructor() {
        this.extra = "e";
        print(super.describe());
        super("a");
    }
}

class Writes extends Named {
    constructor() {
        this.name = "n";
        super("a");
    }
}

class Root {
    protected int count = 1;

    protected describe() -> string {
        return "root";
    }
}

class BaseCallsAtExit extends Root {
    string extra;

    constructor() {
        this.extra = "e";
        print(super.describe());
    }
}

class Implicit extends Root {
    string extra;

    constructor() {
        this.extra = "{this.count}";
    }
}

class Recovers extends Named {
    string label;

    constructor(string text) {
        this.label = try checkedName(text);
        super("named");
    } catch (Refusal refusal) {
        this.label = "fallback";
    }
}

class Filled {
    protected List<int> items;

    protected constructor(this.items) {
        this.items.push(1);
    }
}

class CountsLate extends Filled {
    string summary;

    constructor(List<int> given) {
        print("building");
        super(given);
        this.summary = "{this.items.length()}";
    }
}

class CountsEarly extends Filled {
    string summary;

    constructor(List<int> given) {
        this.summary = "{this.items.length()}";
        super(given);
    }
}

class Counter {
    protected int count;

    protected constructor(this.count);
}

class Bumped extends Counter {
    string copy;

    constructor(int given) {
        print("building");
        super(given);
        this.copy = "{this.count += 1}";
    }
}

class Renames extends Named {
    string copy;

    constructor(string given) {
        print("building");
        super(given);
        this.copy = (this.name = "z");
    }
}

class Amount {
    protected long amount;

    protected constructor(this.amount);
}

class Scaled extends Amount {
    string scaled;

    constructor(int given) {
        print("building");
        super(given);
        this.scaled = "{this.amount * 1000000}";
    }
}

class Maybe {
    protected string? note;

    protected constructor(this.note);
}

class Noted extends Maybe {
    string shown;

    constructor(string given) {
        print("building");
        super(given);
        this.shown = this.note ?? "none";
    }
}

class Shape {
}

class Square extends Shape {
}

kind(Shape shape) -> string {
    return "shape";
}

kind(Square square) -> string {
    return "square";
}

class Holder {
    protected Shape shape;

    protected constructor(this.shape);
}

class Sorted extends Holder {
    string kind;

    constructor(Square given) {
        print("building");
        super(given);
        this.kind = kind(this.shape);
    }
}

class Reassigns extends Named {
    string label;

    constructor(string given) {
        string suffix = "a";
        super(given);
        suffix = "b";
        this.label = suffix;
    }
}

class Suffixed extends Named {
    string label;

    constructor(string given) {
        string suffix = "a";
        super(given);
        suffix = "b";
        this.label = this.name + suffix;
    }
}

class Overwrites extends Named {
    constructor(string given) {
        string value = "a";
        this.name = value;
        value = "b";
        super(given);
    }
}

class Pushes extends Named {
    string label;

    constructor(string given, List<string> parts) {
        print("building");
        super(given);
        parts.push("b");
        this.label = "{parts.length()}";
    }
}

class AssignsInCatch extends Named {
    string label;

    constructor(string text) {
        this.label = try checkedName(text);
        super("named");
    } catch (Refusal refusal) {
        this.name = "caught";
        panic("no name");
    }
}

class AppendsInCatch extends Named {
    constructor(string text) {
        super(try checkedName(text));
    } catch (Refusal refusal) {
        this.name += "caught";
        panic("no name");
    }
}

class ReadsLate extends Named {
    string label;
    string mark;

    constructor(string given) {
        print("building");
        super(given);
        this.mark = this.label;
        this.label = given;
    }
}

class Announced {
    protected string name;

    protected constructor(this.name) {
        print("announced {this.name}");
    }
}

class Migrates extends Announced {
    string label;
    string mark;
    List<int> items;

    constructor(string given, string label, List<int> items) {
        string mark = "{label}!";
        super(given);
        this.label = label;
        this.mark = mark;
        this.items = items;
    }
}

class Box {
    int value;

    constructor(this.value);
}

class Tracker {
    Box box;

    constructor(this.box);

    destructor() {
        this.box.value = 5;
    }
}

class Config {
    lazy const string value = "init";
}

class Aliased extends Named {
    string label;

    constructor(string given, Box first, Box second) {
        print("building");
        super(given);
        first.value = 5;
        this.label = "{second.value}";
    }
}

class ReadsLazy extends Named {
    string label;

    constructor(string given) {
        print("building");
        super(given);
        this.label = Config.value;
    }
}

class Releases extends Named {
    string label;

    constructor(string given, Box box) {
        Tracker? keeper = new Tracker(box);
        super(given);
        keeper = null;
        this.label = "{box.value}";
    }
}

class ChangesArgument extends Named {
    string label;

    constructor(string given) {
        string suffix = "a";
        super(given + suffix);
        this.label = (suffix = "b");
    }
}

class ArgumentChangesRead extends Named {
    string extra;

    constructor(string given) {
        string tag = "a";
        this.extra = this.name + tag;
        super(given + (tag = "b"));
    }
}

class PassesAcrossRelease extends Named {
    constructor(string given, Box box) {
        Tracker? keeper = new Tracker(box);
        this.name = "{box.value}";
        keeper = null;
        super(given);
    }
}

class PassesAcrossAlias extends Named {
    constructor(string given, Box first, Box second) {
        this.name = "{second.value}";
        first.value = 5;
        super(given);
    }
}

class Increments extends Counter {
    constructor() {
        this.count++;
        super(7);
    }
}

class Decrements extends Counter {
    constructor() {
        --this.count;
        super(7);
    }
}

class IncrementsInArgument extends Counter {
    constructor() {
        super(this.count++);
    }
}

class AddsBeforeSuper extends Counter {
    constructor() {
        this.count += 2;
        super(7);
    }
}

class IncrementsInCatch extends Counter {
    string label;

    constructor(string text) {
        this.label = try checkedName(text);
        super(0);
    } catch (Refusal refusal) {
        this.count++;
        panic("no count");
    }
}

main() -> int {
    return 0;
}
