// @expect-error 'super.describe()' is called before base class 'Root' is constructed, and the code it runs may read the fields of 'Root'. A constructor that does not call 'super(...)' constructs 'Root' when it finishes, so call 'super();' before this call.
// @expect-error Field 'kind' of class 'Sorted' is assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Holder' runs. 'this.kind = kind(this.shape);' reads 'shape', a field of base class 'Holder' that has no value until 'Holder' is constructed. Give 'kind' a first value above 'super(given);', as in 'this.kind = "";'.
// @expect-error Fields 'label', 'mark' and 'items' of class 'Migrates' are assigned after 'super(...)'. A subclass assigns its own fields before 'super(...)', so they have values when the constructor of 'Announced' runs. Move 'this.label = label;', 'this.mark = mark;' and 'this.items = items;' above 'super(given);'.
// @expect-error build failed with 4 problems
// Before 'super(...)' returns, a subclass constructor assigns its own fields and uses 'this' for
// nothing else, and one that writes no 'super(...)' is in that first phase until it finishes.
// A fix moves a statement past 'super(...)' or computes it from a parameter only where the
// program then does the same.
import List from @std.collections.list;

class Named {
    protected string name;

    protected constructor(this.name);

    protected describe() -> string {
        return this.name;
    }
}

class BaseCalls extends Named {
    string extra;

    constructor() {
        this.extra = "e";
        print(super.describe());
        super("a");
    }
}

class Root {
    protected describe() -> string {
        return "root";
    }
}

class BaseCallsAtExit extends Root {
    string extra;

    constructor() {
        this.extra = "e";
        print(super.describe());
    }
}

class Shape {
}

class Square extends Shape {
}

kind(Shape shape) -> string {
    return "shape";
}

kind(Square square) -> string {
    return "square";
}

class Holder {
    protected Shape shape;

    protected constructor(this.shape);
}

class Sorted extends Holder {
    string kind;

    constructor(Square given) {
        print("building");
        super(given);
        this.kind = kind(this.shape);
    }
}

class Announced {
    protected string name;

    protected constructor(this.name) {
        print("announced {this.name}");
    }
}

class Migrates extends Announced {
    string label;
    string mark;
    List<int> items;

    constructor(string given, string label, List<int> items) {
        string mark = "{label}!";
        super(given);
        this.label = label;
        this.mark = mark;
        this.items = items;
    }
}

main() -> int {
    return 0;
}
