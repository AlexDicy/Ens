// @expect-note 's' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 's' is assigned a value of type 'string?', which can be null. Check 's' for null after the 'for' loop ('if (s != null)').
// @expect-error Type 'Shape' has no field or method named 'radius'.
// @expect-error build failed with 3 problems
// A loop can be left where its condition is tested false and at each 'break'. A narrowing the condition
// makes by assigning holds after the loop only where every way out keeps it, so a 'break' after a write
// that drops it leaves the value without it.
class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 1;

    protected constructor() {
        super();
    }
}

pick() -> string? {
    return null;
}

name() -> string {
    return "x";
}

circle() -> Circle {
    return new Circle();
}

whileBreak(bool go, bool c) -> long {
    string? s = pick();
    while ((s = name()).length > 0 && go) {
        if (c) {
            s = pick();
            break;
        }
    }
    return s.length;
}

forBreak(bool go, bool c) -> long {
    string? s = pick();
    for (long i = 0; (s = name()).length > 0 && go; i++) {
        if (c) {
            s = pick();
            break;
        }
    }
    return s.length;
}

classBreak(Shape other, bool go, bool c) -> int {
    Shape s = other;
    while ((s = circle()).radius > 0 && go) {
        if (c) {
            s = other;
            break;
        }
    }
    return s.radius;
}

main() -> int {
    return 0;
}
