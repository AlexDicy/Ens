// @exit 0
// @stdout prefix yes
// @stdout suffix yes
// @stdout whole yes
// @stdout empty part yes
// @stdout longer part no
// @stdout wrong prefix no
// @stdout built prefix yes
// @stdout trimmed: [spaced out]
// @stdout trimStart: [spaced out   ]
// @stdout all whitespace: []
// @stdout nothing to trim: [tight]
// @stdout empty trim: []
// @stdout inner kept: [a  b]
// Happy-path coverage for the string edge members, over the parts that match, that are empty,
// that are longer than the text, and that were built at run time, and over text padded with each
// whitespace byte, text that is all whitespace, and text with nothing to remove.
main() -> int {
    let text = "hello, world";
    if (text.startsWith("hello")) { print("prefix yes"); }
    if (text.endsWith("world")) { print("suffix yes"); }
    if (text.startsWith(text) && text.endsWith(text)) { print("whole yes"); }
    if (text.startsWith("") && text.endsWith("")) { print("empty part yes"); }
    if (!"ab".startsWith("abc") && !"ab".endsWith("zab")) { print("longer part no"); }
    if (!text.startsWith("world") && !text.endsWith("hello")) { print("wrong prefix no"); }
    let built = "hel" + "lo";
    if (text.startsWith(built)) { print("built prefix yes"); }

    let padded = " \t\n\f\rspaced out \t\r\n";
    print("trimmed: [" + padded.trim() + "]");
    print("trimStart: [" + "   spaced out   ".trimStart() + "]");
    print("all whitespace: [" + "  \t \n ".trim() + "]");
    print("nothing to trim: [" + "tight".trim() + "]");
    print("empty trim: [" + "".trim() + "]");
    print("inner kept: [" + "  a  b  ".trim() + "]");
    return 0;
}
