// @expect-error Cannot store the result of '+=' back into 'int'
// A compound assignment is checked as the operator it stands for: 'total += amount'
// means 'total = total + amount', so 'int + long' produces a 'long' that does not
// fit an 'int' target. Narrowing a value needs an explicit 'as'.
main() -> int {
    int total = 1;
    long amount = 2;
    total += amount;
    print("total {total}");
    return 0;
}
