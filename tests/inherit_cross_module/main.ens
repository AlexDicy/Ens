// @exit 38
// A class extending a class in another module: inherited fields are flattened,
// inherited non-virtual methods are callable, and an override dispatches virtually
// through a base-typed reference, all resolved across the module boundary.
import Shape from lib.shape;

class Square extends Shape {
    int side;

    Square(int s) { super(4); this.side = s; }
    override area() -> int { return this.side * this.side; }
}

computeArea(Shape s) -> int { return s.area(); }   // imported base as a parameter type

main() -> int {
    let sq = new Square(5);
    int a = computeArea(sq);            // virtual dispatch -> Square.area = 25
    int sides = sq.describe();          // inherited method reading inherited field = 4
    int direct = sq.sides + sq.side;    // inherited field + own field = 4 + 5 = 9
    return a + sides + direct;          // 25 + 4 + 9 = 38
}