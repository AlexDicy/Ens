// @exit 129
// A class extending a class in another module: inherited fields are flattened,
// inherited non-virtual methods are callable, and an override dispatches virtually
// through a base-typed reference, all resolved across the module boundary. Cube
// extends Square, so the chain Shape (lib) -> Square -> Cube spans modules and
// two inheritance levels.
import Shape from lib.shape;

class Square extends Shape {
    protected int side;

    protected constructor(int s) { super(4); this.side = s; }
    protected override area() -> int { return this.side * this.side; }
}

class Cube extends Square {
    protected int depth;

    protected constructor(int s, int d) { super(s); this.depth = d; }
    protected override area() -> int { return this.side * this.side * this.depth; }
}

computeArea(Shape s) -> int { return s.area(); }   // imported base as a parameter type

main() -> int {
    let sq = new Square(5);
    int sqTotal = computeArea(sq) + sq.describe() + sq.sides + sq.side;   // 25 + 4 + 4 + 5 = 38

    let cube = new Cube(5, 3);
    int cubeArea = computeArea(cube);                     // virtual at depth 2 -> 5*5*3 = 75
    int cubeFields = cube.sides + cube.side + cube.depth; // 4 + 5 + 3 = 12
    int cubeDesc = cube.describe();                       // inherited two levels up = 4

    return sqTotal + cubeArea + cubeFields + cubeDesc;    // 38 + 75 + 12 + 4 = 129
}