// @exit 0
// @stdout this program: file=true folder=true slashes=true
// @stdout created a/b/c
// @stdout kinds: root=2 folder=2 file=1 missing=0
// @stdout listed a/b: c, one.txt, two.txt, zz
// @stdout listed a/b/c: <empty>
// @stdout exists: file=true folder=true missing=false
// @stdout createDirectory again: ok
// @stdout refused removeFile on a folder: true
// @stdout refused removeDirectory on a full folder: true
// @stdout refused listDirectory on a missing folder: true
// @stdout removed the tree: exists=false
// Every path is built under the running program's own folder, so the two test runners never share
// a scratch tree, and a leftover from an earlier run is cleaned up before anything else.
import @std.system;
import SystemError from @std.system;
import @std.path;

main() -> int {
    string self = system.executablePath();
    string here = system.currentDirectory();
    bool selfIsFile = system.isFile(self);
    bool hereIsFolder = system.isDirectory(here);
    bool slashed = !self.contains("\\") && !here.contains("\\");
    print("this program: file={selfIsFile} folder={hereIsFolder} slashes={slashed}");

    string root = path.join(path.parentFolder(self), "std_filesystem_scratch");
    removeTree(root);

    string folder = root + "/a/b";
    try system.createDirectory(folder + "/c");
    print("created a/b/c");

    string file = folder + "/one.txt";
    string missing = folder + "/nothing";
    try system.writeAllText(file, "one");
    try system.writeAllText(folder + "/two.txt", "two");
    try system.createDirectory(folder + "/zz");

    int rootKind = kindOf(root);
    int folderKind = kindOf(folder);
    int fileKind = kindOf(file);
    int missingKind = kindOf(missing);
    print("kinds: root={rootKind} folder={folderKind} file={fileKind} missing={missingKind}");
    print("listed a/b: " + try listed(folder));
    print("listed a/b/c: " + try listed(folder + "/c"));

    bool fileThere = system.exists(file);
    bool folderThere = system.exists(folder);
    bool missingThere = system.exists(missing);
    print("exists: file={fileThere} folder={folderThere} missing={missingThere}");

    try system.createDirectory(folder);
    print("createDirectory again: ok");

    print("refused removeFile on a folder: {refusedRemoveFile(folder)}");
    print("refused removeDirectory on a full folder: {refusedRemoveDirectory(folder)}");
    print("refused listDirectory on a missing folder: {refusedList(missing)}");

    removeTree(root);
    bool rootThere = system.exists(root);
    print("removed the tree: exists={rootThere}");
    return 0;
} catch (SystemError e) {
    system.writeError("std_filesystem: {e.message}");
    return 1;
}

kindOf(string target) -> int {
    if (system.isDirectory(target)) {
        return 2;
    }
    if (system.isFile(target)) {
        return 1;
    }
    return 0;
}

// The folder's entries in one line, in the order listDirectory reports them.
listed(string folder) -> string throws {
    string[] names = try system.listDirectory(folder);
    if (names.length == 0) {
        return "<empty>";
    }
    string line = names[0];
    for (long i = 1; i < names.length; i++) {
        line = line + ", " + names[i];
    }
    return line;
}

// Removes a folder and everything inside it. A folder that was never there is already removed,
// which is why this is the fixture's own cleanup and not a standard library function.
removeTree(string folder) {
    string[] names = try system.listDirectory(folder);
    for (let name in names) {
        string child = path.join(folder, name);
        if (system.isDirectory(child)) {
            removeTree(child);
        } else {
            try system.removeFile(child);
        }
    }
    try system.removeDirectory(folder);
} catch (SystemError e) {
    return;
}

refusedRemoveFile(string target) -> bool {
    try system.removeFile(target);
    return false;
} catch (SystemError e) {
    return true;
}

refusedRemoveDirectory(string target) -> bool {
    try system.removeDirectory(target);
    return false;
} catch (SystemError e) {
    return true;
}

refusedList(string target) -> bool {
    string[] names = try system.listDirectory(target);
    return false;
} catch (SystemError e) {
    return true;
}
