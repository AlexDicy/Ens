// @exit 0
// A Vector<T> of a class type must release its elements when it is dropped, and
// store primitives unboxed. The weak reference goes null only if the Node the
// Vector held was freed: that proves no leak and no double free.
import Vector from @std.vector;

class Node { int v; Node(this.v = 0); }
class Watcher { weak Node? seen; Watcher(); }

fillAndDrop(Watcher w) {
    let items = new Vector<Node>();
    let n = new Node();
    n.v = 99;
    w.seen = n;
    items.push(n);
    n = new Node();
    // `items` (the only strong owner of the first Node) is released here.
}

main() -> int {
    let counts = new Vector<int>();
    counts.push(1);
    counts.push(2);
    if (counts.get(0) + counts.get(1) != 3) { return 2; }

    let w = new Watcher();
    fillAndDrop(w);
    if (w.seen != null) { return 1; }
    return 0;
}