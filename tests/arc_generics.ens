// @exit 0
// A List<T> of a class type must release its elements when it is dropped, even
// across the reallocations that growth performs. The weak references go null only
// if the Nodes the List held were freed: that proves no leak and no double free.
// A List<int> alongside it stores its values unboxed.
import List from @std.collections.list;

class Node { int v; constructor(this.v = 0); }
class Watcher { weak Node? first; weak Node? last; constructor(); }

fillAndDrop(Watcher w) {
    let items = new List<Node>();
    let i = 0;
    while (i < 12) {
        let n = new Node();
        n.v = i;
        if (i == 0) { w.first = n; }
        if (i == 11) { w.last = n; }
        items.push(n);
        i = i + 1;
    }
    // 12 pushes force two reallocations (capacity 4 -> 8 -> 16). `items` is the
    // only strong owner of every Node, and it is released when this returns.
}

// toArray retains each copied element: the array is the only owner left once
// the list dies, and the elements die with the array.
copyOutlivesList(Watcher w) -> Node[] {
    let items = new List<Node>();
    let node = new Node(5);
    items.push(node);
    w.first = node;
    return items.toArray();
}

main() -> int {
    let counts = new List<int>();
    counts.push(1);
    counts.push(2);
    if (counts.get(0) + counts.get(1) != 3) { return 3; }

    let w = new Watcher();
    fillAndDrop(w);
    if (w.first != null) { return 1; }
    if (w.last != null) { return 2; }

    let w2 = new Watcher();
    if (true) {
        let kept = copyOutlivesList(w2);
        if (w2.first == null) { return 4; }
        if (kept[0].v != 5) { return 5; }
    }
    if (w2.first != null) { return 6; }
    return 0;
}
