// @exit 0
// A Vector<T> of a class type must release its elements when it is dropped, even
// across the reallocations that growth performs. The weak references go null only
// if the Nodes the Vector held were freed: that proves no leak and no double free.
// A Vector<int> alongside it stores its values unboxed.
import Vector from @std.vector;

class Node { int v; Node(this.v = 0); }
class Watcher { weak Node? first; weak Node? last; Watcher(); }

fillAndDrop(Watcher w) {
    let items = new Vector<Node>();
    let i = 0;
    while (i < 12) {
        let n = new Node();
        n.v = i;
        if (i == 0) { w.first = n; }
        if (i == 11) { w.last = n; }
        items.push(n);
        i = i + 1;
    }
    // 12 pushes force two reallocations (capacity 4 -> 8 -> 16). `items` is the
    // only strong owner of every Node, and it is released when this returns.
}

main() -> int {
    let counts = new Vector<int>();
    counts.push(1);
    counts.push(2);
    if (counts.get(0) + counts.get(1) != 3) { return 3; }

    let w = new Watcher();
    fillAndDrop(w);
    if (w.first != null) { return 1; }
    if (w.last != null) { return 2; }
    return 0;
}
