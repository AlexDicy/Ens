// @exit 3
// Two packages declaring the same native library with identical bindings dedupe: this
// package and demo.pkgc both declare 'native libc system;', and both bind functions from
// it through their own external blocks.
import @demo.pkgc.textutil;

external from libc {
    abs(int value) -> int;
}

main() -> int {
    byte[] word = new byte[3];
    word[0] = 'h';
    word[1] = 'i';
    return abs(-1) + textutil.byteLength(word) as int;
}
