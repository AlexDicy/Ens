// A class written with the function type it runs, the way '@std.tasks' writes 'Task'.
export shared final class Probe<shared () -> T throws E> {
    const (shared () -> T throws E) body;

    export constructor(this.body);

    export run() -> T throws E {
        return try this.body();
    }
}

export probing<shared T, E: Error>((shared () -> T throws E) body) -> Probe<(() -> T throws E)> {
    return new Probe<(() -> T throws E)>(body);
}
