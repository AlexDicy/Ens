// @expect-error Class 'Ghost' cannot be 'weak'; 'weak' goes on a class field that refers to an object without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.
// @expect-error Class 'Frozen' cannot be 'static'; 'static' goes on a method or a 'const' field of a class or a struct, where it makes the member belong to the type itself. Remove 'static'.
// @expect-error Struct 'Flat' cannot be 'abstract'; 'abstract' goes on a class or a method, where a subclass supplies what is missing. Remove 'abstract'.
// @expect-error Struct 'Fixed' cannot be 'const'; 'const' goes on a field or a variable inside a function, as in 'const string name;' or 'const limit = 10'. Remove 'const'.
// @expect-error Interface 'Contract' cannot be 'final'; 'final' stops a method from being overridden or a class from being extended. Remove 'final'.
// @expect-error Interface 'Closed' cannot be 'sealed'; 'sealed' goes on a class, where it means only the same module can extend it. Remove 'sealed'.
// @expect-error Enum 'Sort' cannot be 'override'; 'override' is for a method that replaces one the type inherits. Remove 'override'.
// @expect-error Enum 'Loud' cannot be 'noreturn'; 'noreturn' goes on a function or method that never finishes normally, because it always throws or calls 'panic'. Remove 'noreturn'.
// @expect-error build failed with 8 problems
// A type declaration takes visibility, and a class additionally 'abstract', 'final', and
// 'sealed'; every other modifier is rejected by name instead of being silently ignored.
weak class Ghost {
}

static class Frozen {
}

abstract struct Flat {
    int y;
}

const struct Fixed {
    int z;
}

final interface Contract {
    describe() -> string;
}

sealed interface Closed {
    close() -> bool;
}

override enum Sort {
    One,
}

noreturn enum Loud {
    Bang,
}

main() -> int {
    return 0;
}
