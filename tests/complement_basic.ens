// @exit 42
// Unary '~' flips every bit of an integer and keeps the operand's own type, so the result
// wraps at that type's width. 'char' counts as an integer type, so it is accepted too.
flipped(uint value) -> uint {
    return ~value;
}

main() -> int {
    byte small = 0x0F;
    if ((~small) != 0xF0)                  { return 1; }

    short signedHalf = 0;
    if ((~signedHalf) != -1)               { return 2; }

    ushort halfWord = 0x00FF;
    if ((~halfWord) != 0xFF00)             { return 3; }

    int word = 5;
    if ((~word) != -6)                     { return 4; }

    uint unsignedWord = 0x12345678;
    if ((~unsignedWord) != 0xEDCBA987)     { return 5; }

    long wide = 0;
    if ((~wide) != -1L)                    { return 6; }

    ulong unsignedWide = 0;
    if ((~unsignedWide) != 0xFFFFFFFFFFFFFFFF) { return 7; }

    char letter = 'A';
    if (((~letter) as long) != 0xFFFFFFBE) { return 8; }

    // Double complement is the identity, and '~' binds tighter than the binary operators.
    if ((~(~word)) != 5)                   { return 9; }
    if ((~word & 0xFF) != 0xFA)            { return 10; }
    if ((~word + 1) != -5)                 { return 11; }

    // A cast binds tighter than a prefix operator, so the complement applies to the widened
    // value rather than to the byte.
    if ((~small as int) != -16)            { return 12; }

    if (flipped(0) != 0xFFFFFFFF)          { return 13; }

    return 42;
}
