// @stdlib primitive_stdlib
// A binding member reaches only as far as its own modifier says: 'public' stops at the standard
// library's own package, exactly as it does for a class member.
// @expect-error 'inPackageOnly' of 'string' is public inside package 'std' but not exported. Mark it 'export' to use it from another package.
// @expect-error build failed with 1 problem
import @std.text.binding;

main() -> int {
    return "hello".inPackageOnly() as int;
}
