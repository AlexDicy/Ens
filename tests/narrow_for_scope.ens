// @exit 0
// A for statement inside a narrowed branch must not leak the branch's narrowing:
// after the if, 'maybe' is nullable again and the comparison below stays legal.
class Box {
    protected int value;
    protected constructor(this.value);
}

hasValue(Box? maybe) -> bool {
    if (maybe != null) {
        long total = 0;
        for (long i = 0; i < maybe.value; i++) {
            total = total + i;
        }
    }
    return maybe != null;
}

main() -> int {
    if (!hasValue(new Box(3))) {
        return 1;
    }
    if (hasValue(null)) {
        return 2;
    }
    return 0;
}
