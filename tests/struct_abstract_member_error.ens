// @expect-error Method 'poke' of struct 'Box' cannot be 'abstract'; a struct has no subclass to give it a body
// 'abstract' leaves a member for a subclass to implement. A struct is never a base type,
// so an abstract struct member could never be given a body and would be a method nothing
// can call.

public struct Box {
    int value;

    public abstract poke() -> int;
}

main() -> int {
    Box box = {value: 1};
    print("{box.value}");
    return 0;
}
