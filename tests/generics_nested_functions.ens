// @exit 0
// Nested generic free functions: monomorphizing a generic body cascades the
// instance's type arguments into the generic calls it makes. Covers two-level
// nesting, a three-level chain, self-recursion with an unchanged type argument,
// several concrete instances of one nested pair, a callee reached both directly
// and through a generic caller, and a generic method that calls a generic
// function with its class's type argument.

identity<T>(T value) -> T { return value; }

outer<T>(T value) -> T { return identity<T>(value); }

chainTop<T>(T value) -> T { return chainMid<T>(value); }
chainMid<T>(T value) -> T { return chainBottom<T>(value); }
chainBottom<T>(T value) -> T { return identity<T>(value); }

countDown<T>(T value, int n) -> T {
    if (n <= 0) { return value; }
    return countDown<T>(value, n - 1);
}

class Wrapper<T> {
    T value;
    protected constructor(this.value);
    protected echo() -> T { return outer<T>(this.value); }
}

main() -> int {
    if (identity<int>(7) != 7) { return 1; }

    if (outer<int>(42) != 42) { return 2; }
    if (!outer<bool>(true)) { return 3; }
    if (outer<string>("hi").length != 2) { return 4; }

    if (chainTop<int>(5) != 5) { return 5; }

    if (countDown<int>(9, 3) != 9) { return 6; }

    let w = new Wrapper<int>(100);
    if (w.echo() != 100) { return 7; }

    return 0;
}
