// Driven by the cli_workspace harness job: prints its arguments and exits with their count.
import @std.system;
import @demo.lib.greet;

main() -> int {
    print(greet.greeting());
    string[] arguments = system.arguments();
    int count = 0;
    for (long index = 1; index < arguments.length; index++) {
        print(arguments[index]);
        count++;
    }
    return count;
}
