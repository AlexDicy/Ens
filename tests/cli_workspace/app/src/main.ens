// Driven by the cli_build and cli_runtest harness jobs: prints the sibling member's greeting and
// its own arguments, and exits with their count.
import @std.environment;
import @demo.lib.greet;

main() -> int {
    print(greet.greeting());
    string[] arguments = environment.arguments();
    int count = 0;
    for (long index = 0; index < arguments.length; index++) {
        print(arguments[index]);
        count++;
    }
    return count;
}
