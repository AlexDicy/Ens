// @expect-error Literal 3.5e38 is too large for 'float', which holds about 3.4e38 at most; 'double' reaches further.
// A literal adapts only to a type that can hold its magnitude. Losing precision is part of the
// conversion, but a magnitude that would become infinity is refused and names the wider type.
main() -> int {
    float tooLarge = 3.5e38;
    return tooLarge > 0.0 ? 0 : 1;
}
