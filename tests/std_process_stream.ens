// @exit 0
// @stdout streamed: out one
// @stdout streamed: err one
// @stdout streamed: out two
// @stdout streamed: 3 line(s), null again true, code 3, asked again 3
// @stdout marked: child mark=one
// @stdout flooded: code 5 without a line being read
// @stdout abandoned 8 children, and the next one still streams: still here
// The program starts itself as the child, so one fixture covers both sides. The child's two output
// streams arrive merged in the order it wrote them, which is why the line it sent to standard error
// appears between the two it sent to standard output.
import @std.system;
import SystemError from @std.system;

main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length > 1) {
        return child(arguments[1]);
    }
    return try parent();
} catch (SystemError e) {
    system.writeError("std_process_stream: {e.message}");
    return 1;
}

// The child: this same program, started again with the part it is to play.
child(string mode) -> int {
    return switch (mode) {
        "lines" -> bothStreams(),
        "flood" -> moreThanAPipeHolds(),
        "mark" -> markFromEnvironment(),
        default -> 0,
    };
}

// One line on each stream and one more on the first, so the order they arrive in is observable.
bothStreams() -> int {
    print("out one");
    system.writeError("err one");
    print("out two");
    return 3;
}

// More output than a pipe holds, so a parent that never reads it would stop this child dead.
moreThanAPipeHolds() -> int {
    for (long i = 0; i < 4000; i++) {
        print("line {i} of far more output than the pipe between us can hold at once");
    }
    return 5;
}

markFromEnvironment() -> int {
    print("child mark=" + (system.getEnvironmentVariable("ENS_TEST_STREAM_MARK") ?? "<unset>"));
    return 0;
}

parent() -> int throws {
    string self = system.executablePath();

    let streamed = try system.start(self, ["lines"]);
    long lines = 0;
    string? line = try streamed.readLine();
    while (line != null) {
        print("streamed: {line}");
        lines = lines + 1;
        line = try streamed.readLine();
    }
    bool endsAgain = try streamed.readLine() == null;
    int code = try streamed.wait();
    int again = try streamed.wait();
    print("streamed: {lines} line(s), null again {endsAgain}, code {code}, asked again {again}");

    let marked = try system.start(self, ["mark"], ["ENS_TEST_STREAM_MARK=one"]);
    string? first = try marked.readLine();
    print("marked: " + (first ?? "<nothing>"));
    let markCode = try marked.wait();

    // Asking for the code without reading a line has to answer rather than deadlock, whatever the
    // child has written by then.
    let flooded = try system.start(self, ["flood"]);
    int floodCode = try flooded.wait();
    print("flooded: code {floodCode} without a line being read");

    for (long i = 0; i < 8; i++) {
        let abandoned = try system.start(self, ["quiet"]);
    }
    let after = try system.start(self, ["lines"]);
    string? survives = try after.readLine();
    let afterCode = try after.wait();
    print("abandoned 8 children, and the next one still streams: "
        + stillThere(survives ?? "<nothing>", afterCode));
    return 0;
}

stillThere(string line, int code) -> string {
    if (line == "out one" && code == 3) {
        return "still here";
    }
    return "the child answered '{line}' with code {code}";
}
