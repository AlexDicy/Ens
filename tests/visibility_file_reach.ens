// @exit 76
// @stdout helper 4 8 10 12
// @stdout spot 3 5 0
// @stdout plain 3 guarded 6
// @stdout tuned 20 square 9 meter 7
// An unmarked member of a file-private class or struct reaches the whole file, as the type
// itself does. Functions, lambdas and methods of other types here use its constructor, fields,
// methods and statics. A class with no constructor of its own is built here too. A subclass in
// the file inherits such a member and overrides it. Such a method also provides an interface
// requirement. An override in a file-private class may stay unmarked whatever its base method's
// mark is. 'protected' on a member of a file-private type reaches the same places.
interface Measured {
    measure() -> int;
}

class Helper implements Measured {
    int value;

    static const int LIMIT = 10;

    constructor(int value) {
        this.value = value;
    }

    doubled() -> int {
        return this.value * 2;
    }

    static make(int value) -> Helper {
        return new Helper(value);
    }

    override measure() -> int {
        return this.value;
    }
}

class Tuned extends Helper {
    constructor(int value) {
        super(value);
    }

    override doubled() -> int {
        return this.value * 3 + this.measure();
    }
}

struct Spot {
    int x;

    constructor(int x) {
        this.x = x;
    }

    shifted(int by) -> int {
        return this.x + by;
    }

    static origin() -> Spot {
        return {x: 0};
    }
}

class Plain {
    int count = 3;
}

class Guarded {
    protected int held;

    protected constructor(this.held);

    protected twice() -> int {
        return this.held * 2;
    }
}

class Reader {
    constructor();

    read(Helper helper) -> int {
        return helper.value + Helper.LIMIT;
    }
}

abstract class Shape {
    abstract area() -> int;
}

public class Meter {
    public constructor();

    public reading() -> int {
        return 1;
    }
}

class Needle extends Meter {
    constructor();

    override reading() -> int {
        return 7;
    }
}

class Square extends Shape {
    int side;

    constructor(this.side);

    final override area() -> int {
        return this.side * this.side;
    }
}

main() -> int {
    let helper = Helper.make(4);
    () -> int reach = () -> helper.doubled();
    let reader = new Reader();
    print("helper {helper.value} {reach()} {Helper.LIMIT} {reader.read(new Helper(2))}");
    Spot spot = Spot(3);
    print("spot {spot.x} {spot.shifted(2)} {Spot.origin().x}");
    let plain = new Plain();
    let guarded = new Guarded(3);
    print("plain {plain.count} guarded {guarded.twice()}");
    Helper tuned = new Tuned(5);
    Shape square = new Square(3);
    Meter meter = new Needle();
    print("tuned {tuned.doubled()} square {square.area()} meter {meter.reading()}");
    Measured measured = tuned;
    return helper.value + reach() + reader.read(helper) + spot.x + plain.count + guarded.held
        + tuned.doubled() + square.area() + measured.measure() + meter.reading();
}
