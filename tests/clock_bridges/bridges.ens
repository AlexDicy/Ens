// The two clock bridges the compiler synthesizes wherever they are named, declared here because
// nothing in the standard library reaches the wait yet. The clock is what measures the wait, so the
// two are declared together.
import Platform from @std.environment;

external from libc {
    ens_monotonic_millis() -> long;
    ens_sleep_millis(long millis);
}

// How far short of what it was asked a wait may come and still have kept the platform's promise.
// POSIX promises at least the interval, so it is owed nothing. Windows schedules against the system
// timer, whose default resolution is 15.625 milliseconds. A wait there can end one tick short of
// its count as the performance counter measures it. The allowance is the next whole millisecond
// above that resolution, since a bound counted in whole milliseconds cannot be 15.625.
public final class Tick {
    public static const long windowsMillis = 16;
}

// Milliseconds on a clock nothing sets back, counted from an origin no caller may rely on.
public monotonicMillis() -> long {
    return ens_monotonic_millis();
}

// Blocks this thread for `millis` milliseconds as the platform measures them.
public sleepMillis(long millis) {
    ens_sleep_millis(millis);
}

// The least a wait of `millis` may measure on this system, which is the count itself everywhere but
// Windows.
public floorFor(long millis, Platform platform) -> long {
    if (platform == Platform.Windows) {
        return millis - Tick.windowsMillis;
    }
    return millis;
}

// How long a wait of `millis` took by the clock.
public elapsedOver(long millis) -> long {
    long before = ens_monotonic_millis();
    ens_sleep_millis(millis);
    return ens_monotonic_millis() - before;
}
