// What the wait costs, measured on the host running the suite. Only a floor is asserted, since
// nothing bounds how long a loaded machine leaves a thread waiting. The floor is the platform's own
// rather than the count asked for.
import @std.testing;
import Platform from @std.environment;
import @std.environment;
import Tick from bridges;
import bridges;

// What each wait here asks for. It stands well clear of the Windows tick allowance, so a wait that
// did nothing at all still fails the floor rather than slipping under it.
final class Asked {
    protected static const long millis = 60;
}

test "a wait lasts at least as long as the platform promises" {
    long elapsed = bridges.elapsedOver(Asked.millis);
    long floor = bridges.floorFor(Asked.millis, environment.platform());
    try testing.assertTrue(elapsed >= floor,
        "a wait of {Asked.millis}ms measured {elapsed}ms, under the {floor}ms this platform "
        + "promises");
}

// The allowance is what Windows is owed and nothing more. It must not be softening the floor on a
// platform that promises the whole count.
test "only Windows is allowed to come short of the count" {
    try testing.assertEqual(bridges.floorFor(Asked.millis, Platform.Linux), Asked.millis);
    try testing.assertEqual(bridges.floorFor(Asked.millis, Platform.MacOS), Asked.millis);
    try testing.assertEqual(bridges.floorFor(Asked.millis, Platform.Windows),
        Asked.millis - Tick.windowsMillis);
}

// A second wait is a second wait, so a bridge that somehow satisfied the first by accident does not
// satisfy this one too.
test "a wait after a wait still lasts as long as the count given" {
    long floor = bridges.floorFor(Asked.millis, environment.platform());
    long first = bridges.elapsedOver(Asked.millis);
    long second = bridges.elapsedOver(Asked.millis);
    try testing.assertTrue(first >= floor,
        "the first wait measured {first}ms, under the {floor}ms promised");
    try testing.assertTrue(second >= floor,
        "the second wait measured {second}ms, under the {floor}ms promised");
}

// A count of nothing is what a caller holding a deadline asks for once the deadline has passed, so
// it has to return rather than wait on a system that reads it as something else.
test "a count of zero returns" {
    bridges.sleepMillis(0);
}

test "a count below zero returns" {
    bridges.sleepMillis(-1);
    bridges.sleepMillis(-1000);
}

// A wait moves the clock it is measured against. A clock that read the same on both sides of a wait
// could not measure one.
test "the clock moves over a wait" {
    long before = bridges.monotonicMillis();
    bridges.sleepMillis(Asked.millis);
    try testing.assertTrue(bridges.monotonicMillis() > before,
        "the clock read the same before and after a wait of {Asked.millis}ms");
}
