// @expect-error This 'catch (DbError ...)' never runs, because an earlier 'catch' clause already catches every 'DbError'. Move it above that clause, or remove it.
class DbError extends Error { protected constructor(string m) { super(m); } }
class Repo {
    query() -> int throws { throw new DbError("x"); }
    handle() -> int {
        return try this.query();
    } catch (Error e) {          // broad clause first
        return 1;
    } catch (DbError e) {        // shadowed by the Error clause above
        return 2;
    }
}
main() -> int { return 0; }