// @exit 0
// @stdout plain reads: 1 1 1 2
// @stdout plain reads reclaimed: true
// @stdout write targets: 5 3
// @stdout write targets reclaimed: true
// @stdout safe access: 2 2 2
// @stdout safe access reclaimed: true
// @stdout concat length: 6
// @stdout concat still readable: abcdef
// An owned temporary used as a receiver is only borrowed by what reads through it, so every form
// leaves the temporary for the enclosing scope to give up exactly once. Each function leaves its
// temporary as the last holder of one Watcher, so the weak probe reports what was reclaimed.
class Watcher {
    protected int mark;

    protected constructor(this.mark);

    protected value() -> int {
        return this.mark;
    }
}

class Box {
    protected Watcher held;
    protected int tag;

    protected constructor(this.held, this.tag);

    protected value() -> int {
        return this.held.value();
    }
}

class Probe {
    protected weak Watcher? seen;

    protected constructor(this.seen);

    protected gone() -> bool {
        return this.seen == null;
    }
}

boxOf(Watcher w, int tag) -> Box {
    return new Box(w, tag);
}

maybeBoxOf(Watcher w, int tag) -> Box? {
    return new Box(w, tag);
}

pair(Watcher first, Watcher second) -> Watcher[] {
    return [first, second];
}

maybePair(Watcher first, Watcher second) -> Watcher[]? {
    return [first, second];
}

plainReads() -> Probe {
    let held = new Watcher(1);
    print("plain reads: {boxOf(held, 1).tag} {boxOf(held, 1).value()} "
        + "{pair(held, held)[0].value()} {pair(held, held).length}");
    return new Probe(held);
}

writeTargets() -> Probe {
    let held = new Watcher(2);
    boxOf(held, 4).tag = 5;
    pair(held, held)[1] = new Watcher(3);
    print("write targets: 5 3");
    return new Probe(held);
}

safeAccess() -> Probe {
    let held = new Watcher(2);
    print("safe access: {maybeBoxOf(held, 2)?.tag ?? 0} {maybeBoxOf(held, 9)?.value() ?? 0} "
        + "{maybePair(held, held)?[0]?.value() ?? 0}");
    return new Probe(held);
}

main() -> int {
    Probe reads = plainReads();
    print("plain reads reclaimed: {reads.gone()}");
    Probe writes = writeTargets();
    print("write targets reclaimed: {writes.gone()}");
    Probe safe = safeAccess();
    print("safe access reclaimed: {safe.gone()}");

    string left = "abc";
    string right = "def";
    print("concat length: {(left + right).length}");
    print("concat still readable: " + (left + right));
    return 0;
}
