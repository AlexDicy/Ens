import @std.tasks;
import List from @std.collections.list;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

fail() -> int throws Broken {
    throw new Broken();
    return 0;
}

main() -> int {
    let names = List.of(["a"]);
    let failing = tasks.scope((scope) -> {
        scope.launch(() -> {
            let value = try fail();
        });
        let reading = scope.start(() -> names.length());
        return scope.start(() -> try fail());
    });
    let value = failing.await();
    return 0;
}
