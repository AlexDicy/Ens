// @expect-error Field 'first' cannot be 'abstract'; 'abstract' is for a method with no body, which each subclass then writes for itself. Remove 'abstract'.
// @expect-error Field 'second' cannot be 'override'; 'override' is for a method that replaces one the type inherits. Remove 'override'.
// @expect-error Field 'third' cannot be 'final'; 'final' stops a method from being overridden or a class from being extended. Remove 'final'.
// @expect-error Field 'fourth' cannot be 'sealed'; 'sealed' goes on a class, where it means only the same module can extend it. Remove 'sealed'.
// @expect-error Field 'fifth' cannot be 'noreturn'; 'noreturn' goes on a function or method that never finishes normally, because it always throws or calls 'panic'. Remove 'noreturn'.
// @expect-error Field 'x' cannot be 'const'; 'const' goes on a variable inside a function, as in 'const limit = 10'. Remove 'const'.
// A field carries visibility and 'weak'; every other modifier belongs to a method, a type, or a
// local declaration. Each is reported on the modifier itself, in a struct as in a class, because
// a field honors none of them wherever it is declared.

class Box {
    abstract int first = 0;
    override int second = 0;
    final int third = 0;
    sealed int fourth = 0;
    noreturn int fifth = 0;
}

struct Point {
    const int x = 0;
}

main() -> int {
    let box = new Box();
    Point point = {};
    print("{point.x}");
    return 0;
}
