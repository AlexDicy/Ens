// @expect-error A field cannot be 'abstract'; 'abstract' leaves a method for a subclass to implement, and nothing can implement a field
// @expect-error A field cannot be 'override'; 'override' marks a method that replaces one it inherits or a behavior the language provides, and a field replaces neither
// @expect-error A field cannot be 'final'; 'final' forbids overriding a method or extending a class
// @expect-error A field cannot be 'sealed'; 'sealed' closes a class hierarchy, so it belongs on a class
// @expect-error A field cannot be 'noreturn'; 'noreturn' states that a function never returns to its caller
// @expect-error A field cannot be 'const'; only a local declaration can be ('const limit = 10')
// A field carries visibility and 'weak'; every other modifier belongs to a method, a type, or a
// local declaration. Each is reported on the modifier itself, in a struct as in a class, because
// a field honors none of them wherever it is declared.

class Box {
    abstract int first = 0;
    override int second = 0;
    final int third = 0;
    sealed int fourth = 0;
    noreturn int fifth = 0;
}

struct Point {
    const int x = 0;
}

main() -> int {
    let box = new Box();
    Point point = {};
    print("{point.x}");
    return 0;
}
