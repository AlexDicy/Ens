// @exit 0
// @stdout first
// @stdout second
// A line written to a program's standard input reaches it while the pipe is still open: the child
// echoes each line it reads, and the parent writes the second only once the first came back.
import Path from @std.fs;
import ChildProcess from @std.process;
import ProcessError from @std.process;
import @std.environment;
import @std.io;
import @std.process;

echoLines() -> int throws {
    let input = io.in();
    while (true) {
        let line = try input.readLine();
        if (line == null) {
            return 0;
        }
        print(line);
        try io.flush();
    }
}

// Writes `line` to the child and returns what it echoed, or null when nothing came back in time.
roundTrip(ChildProcess child, string line) -> string? throws {
    try child.input().write("{line}\n".toBytes());
    try child.input().flush();
    if (!try child.waitForOutput(20000)) {
        return null;
    }
    return try child.stdout().readLine();
}

main() -> int throws {
    if (environment.arguments().length > 0) {
        return try echoLines();
    }
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("stdin_pipe_lines: this system would not report the path of this program");
        return 1;
    }
    let child = try process.spawn(self, ["child"]);
    for (let line in ["first", "second"]) {
        string? echoed = try roundTrip(child, line);
        if (echoed == null) {
            eprint("stdin_pipe_lines: '{line}' did not come back while the input stayed open");
            try child.kill();
            return 1;
        }
        print(echoed);
    }
    try child.closeInput();
    let status = try child.wait();
    return status.code;
}
