// @expect-error 'Opaque' cannot be used in 'for (... in ...)', because it does not implement 'Iterable' from '@std.collections.iterator'. Declare 'class Opaque implements Iterable<E>' and give it the method 'override makeIterator() -> Iterator<E>', where 'E' is the type of its elements.
class Opaque {
    int value;
    protected constructor(this.value);
}

main() -> int {
    let box = new Opaque(1);
    for (let item in box) {
        print("" + item);
    }
    return 0;
}
