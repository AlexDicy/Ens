// @exit 134
// @stderr-contains panic: tried to split an array and read the same array beside it, so one piece would read what another writes. Read a copy of it, or a different array
// A piece that read the array another piece writes would see half-written values, so naming the
// split array as the one read beside it aborts the program.
import @std.parallel;
import Cancelled from @std.tasks;

main() -> int throws Cancelled {
    int[] values = [1, 2, 3, 4];
    int[] equal = [1, 2, 3, 4];
    try parallel.split(values, 2, parallel.reading(equal), (slice, view) -> {
        slice.set(0, view.get(0));
    });
    print("an equal array is another array");
    try parallel.split(values, 2, parallel.reading(values), (slice, view) -> {
        slice.set(0, view.get(0));
    });
    return 0;
}
