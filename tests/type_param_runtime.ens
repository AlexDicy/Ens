// @exit 0
// @stdout caught bang
// @stdout no throw
// @stdout handled bang
// @stdout outer bang
// @stdout box bang
// @stdout conditional caught bang
// @stdout found middle
// @stdout middles 2
// @stdout other
// @stdout arm leaf
// @stdout forwarded bang
// @stdout relayed bang
// @stdout box raised bang
// @stdout conditional forwarded bang
// A type parameter is allowed where a class type is required at run time: catch, is, as?, a
// switch is-arm, and throw. Each instantiation judges the test against its own argument.
class Boom extends Error {
    protected constructor(string message) { super(message); }
}

raise() throws Boom {
    throw new Boom("bang");
}

// A value of type E is thrown through E's bound under Error, and the caller catches the class it
// supplied for E.
forward<E: Error>(E error) throws E {
    throw error;
}

// The thrown E travels through a second generic level before it reaches the concrete catch.
relay<E: Error>(E error) throws E {
    try forward<E>(error);
}

// The assertThrows shape: the body's type declares 'throws E', the clause catches E, and the
// caught error is answered with its concrete type.
expectThrown<E: Error>((() -> void throws E) body) -> E? {
    try body();
    return null;
} catch (E caught) {
    return caught;
}

// A base catch covers a thrown E, because every argument for E is an Error.
swallow<E: Error>((() -> void throws E) body) -> string {
    try body();
    return "no throw";
} catch (Error caught) {
    return "handled {caught.message}";
}

// E forwarded through a second generic substitutes at the concrete call site.
inner<E: Error>((() -> void throws E) body) throws E {
    try body();
}

outer<E: Error>((() -> void throws E) body) throws E {
    try inner<E>(body);
}

// 'throws E' on a method of a generic class, substituted by the instantiation.
class Box<E: Error> {
    (() -> void throws E) work;

    protected constructor(this.work);

    protected run() throws E {
        try this.work();
    }

    protected raise(E error) throws E {
        throw error;
    }
}

// A conditional member restates the enclosing parameter with a bound of its own, and that bound
// carries into the member's throws list, catch clause, and throw statements.
class Open<E> {
    protected constructor();

    protected swallow<E: Error>((() -> void throws E) body) -> string {
        try body();
        return "no throw";
    } catch (E caught) {
        return "conditional caught {caught.message}";
    }

    protected forward<E: Error>(E error) throws E {
        throw error;
    }
}

class Base {
    protected constructor();

    protected describe() -> string {
        return "base";
    }
}

class Middle extends Base {
    protected constructor() { super(); }

    protected override describe() -> string {
        return "middle";
    }
}

class Leaf extends Middle {
    protected constructor() { super(); }

    protected override describe() -> string {
        return "leaf";
    }
}

firstOf<T: Base>(Base[] values) -> T? {
    for (let value in values) {
        T? cast = value as? T;
        if (cast != null) {
            return cast;
        }
    }
    return null;
}

countOf<T: Base>(Base[] values) -> int {
    int count = 0;
    for (let value in values) {
        if (value is T) {
            count = count + 1;
        }
    }
    return count;
}

nameOf<T: Base>(Base value) -> string {
    switch (value) {
        is T narrowed -> {
            return "arm " + narrowed.describe();
        },
        default -> {
            return "other";
        },
    }
}

demonstrateOuter() {
    try outer<Boom>(() -> { try raise(); });
} catch (Boom e) {
    print("outer {e.message}");
}

demonstrateBox() {
    let box = new Box<Boom>(() -> { try raise(); });
    try box.run();
} catch (Boom e) {
    print("box {e.message}");
}

demonstrateForward() {
    try forward<Boom>(new Boom("bang"));
} catch (Boom e) {
    print("forwarded {e.message}");
}

demonstrateRelay() {
    try relay(new Boom("bang"));
} catch (Boom e) {
    print("relayed {e.message}");
}

demonstrateBoxRaise() {
    let box = new Box<Boom>(() -> { });
    try box.raise(new Boom("bang"));
} catch (Boom e) {
    print("box raised {e.message}");
}

demonstrateOpenForward() {
    let open = new Open<Boom>();
    try open.forward(new Boom("bang"));
} catch (Boom e) {
    print("conditional forwarded {e.message}");
}

main() -> int {
    let thrown = expectThrown<Boom>(() -> { try raise(); });
    print(thrown != null ? "caught {thrown.message}" : "nothing");
    print(swallow<Boom>(() -> { }));
    print(swallow<Boom>(() -> { try raise(); }));
    demonstrateOuter();
    demonstrateBox();
    let open = new Open<Boom>();
    print(open.swallow(() -> { try raise(); }));
    Base[] values = [new Base(), new Middle(), new Leaf()];
    let middle = firstOf<Middle>(values);
    print(middle != null ? "found " + middle.describe() : "none");
    print("middles {countOf<Middle>(values)}");
    print(nameOf<Leaf>(values[1]));
    print(nameOf<Middle>(values[2]));
    demonstrateForward();
    demonstrateRelay();
    demonstrateBoxRaise();
    demonstrateOpenForward();
    return 0;
}
