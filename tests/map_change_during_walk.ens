// @exit 134
// @stdout walked 1
// @stderr-contains panic: tried to keep looping over a map that changed during the loop. Change the map after the loop ends, or remove entries with removeWhere()
// Removing from a map inside a walk over it aborts on the next step, in the map's own words.
import Map from @std.collections.map;

main() -> int {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.set("bob", 41);
    long walked = 0;
    for (let entry in ages) {
        walked = walked + 1;
        print("walked {walked}");
        ages.remove(entry.key);
    }
    return 0;
}
