// @exit 0
// @stdout total 30
// When one branch of an `if` always exits, the other branch's narrowing of the
// condition survives into the code after the `if`. Each helper checks `x == null`
// in a branch that terminates, so `x` is non-nullable on the line that follows.
class Leaf {
    int field;
    constructor(this.field = 1);
}

// panic() terminates the then-branch.
viaPanic(Leaf? x) -> int {
    if (x == null) { panic("no"); }
    return x.field;
}

// return terminates the then-branch.
viaReturn(Leaf? x) -> int {
    if (x == null) { return -1; }
    return x.field;
}

// throw terminates the then-branch.
viaThrow(Leaf? x) -> int throws {
    if (x == null) { throw new Error("no"); }
    return x.field;
}

// while(true) with no break terminates the then-branch.
viaLoop(Leaf? x) -> int {
    if (x == null) { while (true) { print("unreachable"); } }
    return x.field;
}

// When the else-branch terminates, the then-side narrowing survives instead.
viaElseExits(Leaf? x) -> int {
    if (x != null) { } else { return -1; }
    return x.field;
}

class Holder {
    Leaf? node;
    constructor(this.node);
    // The narrowed path may be a member access such as `this.node`.
    get() -> int {
        if (this.node == null) { panic("no"); }
        return this.node.field;
    }
}

main() -> int {
    let leaf = new Leaf(5);
    let holder = new Holder(leaf);
    int total = viaPanic(leaf) + viaReturn(leaf) + viaLoop(leaf) +
        viaElseExits(leaf) + holder.get() + (try viaThrow(leaf));
    print("total " + total);
    return total - 30;
} catch (Error e) {
    return 99;
}
