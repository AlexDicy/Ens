// @exit 1
// @stderr-contains Unhandled exception NetworkError: connection refused
// @stderr-contains at main (exc_main_unhandled.ens:10)
// A throwing main whose exception escapes: the entry wrapper prints the type, the
// message, and a stack trace pointing at the throw site, then exits 1.
class NetworkError extends Error {
    protected constructor(string m) { super(m); }
}
main() -> int throws {
    throw new NetworkError("connection refused");
}
