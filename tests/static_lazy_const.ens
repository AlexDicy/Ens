// @exit 0
// @stdout built
// @stdout hi hi
// @stdout 3
// 'static lazy const' is the same field as 'lazy const': it belongs to the type, its initializer
// runs on the first read, and every later read sees that one value.
import FrozenList from @std.collections.frozen;

counted() -> string {
    print("built");
    return "hi";
}

class Settings {
    static lazy const string greeting = counted();
    lazy const FrozenList<string> names = ["a", "b", "c"].frozen();
}

main() -> int {
    print(Settings.greeting + " " + Settings.greeting);
    print("{Settings.names.length()}");
    return 0;
}
