// @expect-error In a string, '{' starts a value to insert, as in '"total: {count}"', and the text after this '{' is not one. Write '\{' to put the brace itself in the string.
// @expect-error build failed with 4 problems
// A '{' meant as text in a string is reported once, at the '{', in a test's title as in a
// function's body, and the declarations after it are read as written.
test "a brace '{' in a title" {
    int x = 1;
}

test "a { b" {
    int z = 3;
}

test "another" {
    int y = 2;
}

label() -> string {
    return "open { brace";
}

matches(string s) -> bool {
    if (s == "a {") {
        return true;
    }
    return false;
}

main() -> int {
    return label().length > 0 ? 0 : 1;
}
