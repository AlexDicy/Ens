// @expect-error 'try' is not needed here: none of the calls it covers can throw. Remove 'try'.
// @expect-error Call to 'settle' can throw 'Failure', and the 'try' before 'take' does not cover it: a call inside an argument needs its own 'try', and 'take' cannot throw. Move the 'try' to 'settle', as in 'take(try settle())'.
// @expect-error build failed with 2 problems
// A 'try' before a chain whose calls cannot throw is not needed, and a call inside an argument is
// not covered by the 'try' before the call it is passed to.
class Failure extends Error {
    constructor() {
        super("failed");
    }
}

class Program {
    constructor();

    links() -> bool {
        return true;
    }
}

plain() -> Program {
    return new Program();
}

settle() -> Program throws {
    throw new Failure();
}

take(Program program) -> bool {
    return true;
}

quiet() -> bool {
    return try plain().links();
}

argument() -> bool throws {
    return try take(settle());
}

main() -> int {
    return 0;
}
