// @exit 4
class Leaf {
    Leaf? next;
    Leaf(this.next = null);
}

main() -> int {
    int score = 0;

    let inner = new Leaf();
    let outer = new Leaf(inner);
    Leaf? optOuter = outer;
    Leaf? optEmpty = new Leaf();
    Leaf? optNull = null;

    // 1. then-branch narrowing: optOuter narrowed to Leaf, so .next works directly.
    if (optOuter != null) {
        if (optOuter.next != null) {
            score = score + 1;
        }
    }

    // 2. else-branch narrowing on x == null: optEmpty narrowed in else.
    if (optEmpty == null) {
        score = score + 100;
    } else {
        if (optEmpty.next == null) {
            score = score + 1;
        }
    }

    // 3. Reassignment inside the narrowed block drops the narrowing.
    if (optOuter != null) {
        optOuter = null;
        if (optOuter == null) {
            score = score + 1;
        }
    }

    // 4. Null branch on equality still works.
    if (optNull == null) {
        score = score + 1;
    }

    return score;
}
