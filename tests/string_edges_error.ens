// @expect-error 'startsWith' expects a string argument, got 'int'
// @expect-error 'endsWith' expects 1 argument (a string), got 2
// @expect-error 'trim' takes no arguments.
// The edge members take exactly the arguments their shape needs: one string for
// startsWith and endsWith, none for trim and trimStart.
main() -> int {
    if ("abc".startsWith(1)) {
        print("never");
    }
    if ("abc".endsWith("a", "b")) {
        print("never");
    }
    print("abc".trim(" "));
    return 0;
}
