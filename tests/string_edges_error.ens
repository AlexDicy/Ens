// @expect-error Argument 1 of 'startsWith' has type 'int', but parameter 'prefix' has type 'string'.
// @expect-error Method 'endsWith' takes one argument, but this call passes two. Remove the extra argument.
// @expect-error Method 'trim' takes no arguments, but this call passes one. Remove the extra argument.
// The edge members take exactly the arguments their shape needs: one string for startsWith and
// endsWith, none for trim and trimStart.
main() -> int {
    if ("abc".startsWith(1)) {
        print("never");
    }
    if ("abc".endsWith("a", "b")) {
        print("never");
    }
    print("abc".trim(" "));
    return 0;
}
