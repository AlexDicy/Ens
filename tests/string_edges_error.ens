// @expect-error Argument 1 of 'startsWith' has type 'int', but 'startsWith(string)', the only 'startsWith' that takes one argument, takes a 'string' there.
// @expect-error Method 'endsWith' takes one argument, but this call passes two. Remove the extra argument.
// @expect-error Method 'trim' takes no arguments, but this call passes one. Remove the extra argument.
// The edge members take exactly the arguments their shape needs: a string for startsWith, with an
// offset after it in its second form, one string for endsWith, and none for trim and trimStart.
main() -> int {
    if ("abc".startsWith(1)) {
        print("never");
    }
    if ("abc".endsWith("a", "b")) {
        print("never");
    }
    print("abc".trim(" "));
    return 0;
}
