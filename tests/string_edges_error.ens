// @expect-error Argument 1: expected 'string', got 'int'
// @expect-error Method 'endsWith' expects 1 argument(s), got 2
// @expect-error Method 'trim' expects 0 argument(s), got 1
// The edge members take exactly the arguments their shape needs: one string for startsWith and
// endsWith, none for trim and trimStart.
main() -> int {
    if ("abc".startsWith(1)) {
        print("never");
    }
    if ("abc".endsWith("a", "b")) {
        print("never");
    }
    print("abc".trim(" "));
    return 0;
}
