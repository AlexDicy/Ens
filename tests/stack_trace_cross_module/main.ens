// @exit 1
// @stderr-contains Unhandled exception DbError: query failed
// @stderr-contains at Db.query (db.ens:7)
// @stderr-contains at run (main.ens:11)
// @stderr-contains at main (main.ens:15)
// A cross-module throw: the trace spans both modules, naming the library method
// and file plus the caller frames in main.
import Db from lib.db;
import DbError from lib.db;
run(Db d) -> int throws {
    return try d.query(7);
}
main() -> int throws {
    let d = new Db();
    return try run(d);
}