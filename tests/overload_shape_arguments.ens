// @exit 0
// @stdout lambda:2
// @stdout lambda:12
// @stdout pair:7
// @stdout exact:4
// @stdout floats:2
// @stdout floats:3
// @stdout ints
// @stdout longs
// @stdout empty:0
// @stdout nested:3
// @stdout named:2
// @stdout method:10
// @stdout constructor:6
// A lambda fits only a parameter of function type that takes as many parameters as it declares, and an
// array literal fits only an array parameter whose element type its elements fit, so each picks the
// overload by what is written and is typed from the parameter it is given to.
apply((int) -> int step) -> string {
    return "lambda:{step(1)}";
}

apply(string text) -> string {
    return "text:{text}";
}

combine((int) -> int step) -> string {
    return "single:{step(1)}";
}

combine((int, int) -> int join) -> string {
    return "pair:{join(3, 4)}";
}

exactly(((int) -> int)? step) -> string {
    return "nullable";
}

exactly((int) -> int step) -> string {
    return "exact:{step(2)}";
}

takesFloats(float[] values) -> string {
    return "floats:{values.length}";
}

takesFloats(string text) -> string {
    return "text:{text}";
}

pick(int[] values) -> string {
    return "ints";
}

pick(long[] values) -> string {
    return "longs";
}

widen(long[] values) -> string {
    return "longs";
}

widen(double[] values) -> string {
    return "doubles";
}

empties(int[] values) -> string {
    return "empty:{values.length}";
}

empties(string text) -> string {
    return "text:{text}";
}

nest(long[][] rows) -> string {
    return "nested:{rows[0].length + rows[1].length}";
}

nest(string text) -> string {
    return "text:{text}";
}

scale(double[] values, int by) -> string {
    return "named:{values.length}";
}

class Counter {
    constructor();

    run((int) -> int step) -> string {
        return "method:{step(5)}";
    }

    run(string text) -> string {
        return "text:{text}";
    }
}

class Handler {
    string shown;

    constructor((int) -> int step) {
        this.shown = "constructor:{step(3)}";
    }

    constructor(string text) {
        this.shown = "text:{text}";
    }
}

main() -> int {
    float part = 0.5f;
    print(apply((x) -> x + 1));
    print(apply((x) -> {
        int doubled = x * 2;
        return doubled * 6;
    }));
    print(combine((a, b) -> a + b));
    print(exactly((x) -> x * 2));
    print(takesFloats([1.5, 2.5]));
    print(takesFloats([part, 2.5, 3]));
    print(pick([1, 2]));
    print(widen([1, 2]));
    print(empties([]));
    print(nest([[1], [2, 3]]));
    print(scale(by: 2, values: [1, 2.5]));
    print(new Counter().run((x) -> x * 2));
    print(new Handler((x) -> x * 2).shown);
    return 0;
}
