import List from @std.collections.list;
import Map from @std.collections.map;

class Wrap<T> {
    T item;

    constructor(T item) {
        this.item = item;
    }

    static both(T first, T second) -> Wrap<T> {
        return new Wrap<T>(second);
    }
}

run<T>(() -> T body) -> T {
    return body();
}

maybe<T>((() -> T)? body) -> T? {
    if (body != null) {
        return body();
    }
    return null;
}

firstOf<T>(List<() -> T> makers) -> T {
    return makers.get(0)();
}

nothing() {
}

relay((() -> void)? optional, Wrap<void> wrap) {
    maybe(optional);
}

main() -> int {
    () -> void callback = () -> nothing();
    let makers = new List<() -> void>();
    let made = new Wrap<void>(nothing());
    Map<void, int>? table = null;
    run<void>(callback);
    firstOf(makers);
    let paired = Wrap.both(nothing(), 1);
    return 0;
}
