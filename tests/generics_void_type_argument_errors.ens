import List from @std.collections.list;
import Map from @std.collections.map;

interface Ranked<T> {
    rank(T other) -> int;
}

class Wrap<T> {
    T item;

    constructor(T item) {
        this.item = item;
    }

    static both(T first, T second) -> Wrap<T> {
        return new Wrap<T>(second);
    }

    static of(T item) -> Wrap<T> {
        return new Wrap<T>(item);
    }

    static later(() -> T make) -> Wrap<T> {
        return new Wrap<T>(make());
    }
}

ranked<T: Ranked<void>>(T value) -> T {
    return value;
}

run<T>(() -> T body) -> T {
    return body();
}

maybe<T>((() -> T)? body) -> T? {
    if (body != null) {
        return body();
    }
    return null;
}

map<T, R>(T value, (T) -> R step) -> R {
    return step(value);
}

firstOf<T>(List<() -> T> makers) -> T {
    return makers.get(0)();
}

same<T>(T value) -> T {
    return value;
}

noreturn stop() {
    panic("stopped");
}

nothing() {
}

nothingWith(int value) {
}

compute() -> string {
    return "computed";
}

maker() -> () -> void {
    return () -> nothing();
}

relay((() -> void)? optional, Wrap<void> wrap) {
    maybe(optional);
}

main() -> int {
    bool flag = true;
    () -> void callback = () -> nothing();
    let makers = new List<() -> void>();
    let made = new Wrap<void>(nothing());
    Map<void, int>? table = null;
    same<void>(nothing());
    run<void>(callback);
    run(callback);
    let result = run(callback);
    run(() -> nothing());
    run(() -> {
        nothing();
    });
    map(1, (x) -> nothingWith(x));
    run(() -> compute());
    firstOf(makers);
    run(maker());
    run(callback, 5);
    run(() -> {
        return;
    });
    run(() -> flag ? [] : [1]);
    let kept = same(nothing());
    same(stop());
    let later = Wrap.later(callback);
    let wrapped = Wrap.of(nothing());
    let paired = Wrap.both(nothing(), 1);
    return 0;
}
