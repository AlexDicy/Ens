// @expect-error 'nothing' returns no value, so a call to it cannot be passed to the constructor of 'Wrap'. Call it as a statement of its own, as in 'nothing();'.
// @expect-error 'Map<void, int>' cannot use 'void' as an array element type: 'void' means no value, so the array would have nothing to hold.
// @expect-note 'RawArray<K>' is used here
// @expect-note 'RawArray<T>' creates an array of 'T' here
// @expect-error 'wrapped<void>' cannot use 'void' as an array element type: 'void' means no value, so the array would have nothing to hold.
// @expect-note 'wrapped<T>' creates an array of 'T' here
// @expect-error 'shown<void>' cannot interpolate a value of type 'void': a value of type 'void' has no text form. Pass a type argument that has a text form, or the text you want instead.
// @expect-note 'shown<T>' interpolates a value of type 'T' here
// @expect-error 'nothing' returns no value, so a call to it cannot be passed to 'both'. Call it as a statement of its own, as in 'nothing();', and pass an 'int' value to 'both'.
// @expect-error build failed with 5 problems
// 'void' is a type argument, but an argument that is itself no value, such as a call to a function
// that returns nothing, is still refused where a value is passed. A generic that keeps values of
// 'void' in an array, as a 'Map' does with its keys, or that writes one as text, is refused for
// that instantiation at the line that wrote it.
import Map from @std.collections.map;

class Wrap<T> {
    T item;

    constructor(T item) {
        this.item = item;
    }

    static both(T first, T second) -> Wrap<T> {
        return new Wrap<T>(second);
    }
}

wrapped<T>((() -> T) work) -> T[] {
    return [work()];
}

shown<T>((() -> T) work) -> string {
    T value = work();
    return "{value}";
}

nothing() {
}

main() -> int {
    let made = new Wrap<void>(nothing());
    Map<void, int>? table = null;
    wrapped(() -> nothing());
    print(shown(() -> nothing()));
    let paired = Wrap.both(nothing(), 1);
    return 0;
}
