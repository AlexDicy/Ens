// @expect-error Enum 'Plain' assigns no values to its members, so it does not convert to or from an integer. Give the members values, for example 'A = 0'.
// @expect-error Converting 'int' to enum 'Numbered' fails when no member has that value. Use 'as?', which gives 'Numbered?' and is null when no member matches.
// @expect-error Converting enum 'Numbered' to 'int' always succeeds; use 'as', not 'as?'.
// @expect-error Cannot convert 'string' to enum 'Numbered' with 'as?'; only an integer is matched against an enum's values.
// @expect-error build failed with 5 problems
// Cast-direction errors: a plain enum has no numeric contract in either direction, an integer
// converts to a numeric enum only through the checked 'as?', a numeric enum converts to an
// integer only through the infallible 'as', and only an integer is matched against an enum.
enum Plain {
    A,
    B,
}

enum Numbered {
    Zero = 0,
    One = 1,
}

plainToInt() -> int {
    let p = Plain.A;
    return p as int;
}

plainAsCheckedTarget() -> Plain? {
    return 0 as? Plain;
}

intToEnumUnchecked() -> Numbered {
    return 1 as Numbered;
}

enumToIntChecked() -> int? {
    return Numbered.Zero as? int;
}

textAsCheckedEnum() -> Numbered? {
    return "one" as? Numbered;
}

main() -> int {
    return 0;
}
