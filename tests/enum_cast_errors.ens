// @expect-error Enum 'Plain' assigns no values to its members, so it does not convert to or from an integer. Give the members values, for example 'A = 0'.
// @expect-error Converting 'int' to enum 'Numbered' fails when no member has that value. Use 'as?', which gives 'Numbered?' and is null when no member matches.
// @expect-error Converting enum 'Numbered' to 'int' always succeeds. Write 'as' instead of 'as?'.
// @expect-error Cannot convert 'string' to enum 'Numbered' with 'as?'. Only an integer can be matched against the values of an enum's members.
// @expect-error Cannot use 'as?' on a value of type 'int??', because 'as?' checks for only one level of null. Check 'deep' for null first ('if (deep != null)').
// @expect-error build failed with 6 problems
// Cast-direction errors: a plain enum has no numeric contract in either direction, an integer
// converts to a numeric enum only through the checked 'as?', a numeric enum converts to an
// integer only through the infallible 'as', and only an integer is matched against an enum. A value
// with two levels of null is refused before any of that, since 'as?' checks only one.
enum Plain {
    A,
    B,
}

enum Numbered {
    Zero = 0,
    One = 1,
}

plainToInt() -> int {
    let p = Plain.A;
    return p as int;
}

plainAsCheckedTarget() -> Plain? {
    return 0 as? Plain;
}

intToEnumUnchecked() -> Numbered {
    return 1 as Numbered;
}

enumToIntChecked() -> int? {
    return Numbered.Zero as? int;
}

textAsCheckedEnum() -> Numbered? {
    return "one" as? Numbered;
}

deepAsCheckedEnum(int?? deep) -> Numbered? {
    return deep as? Numbered;
}

main() -> int {
    return 0;
}
