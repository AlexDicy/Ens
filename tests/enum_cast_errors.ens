// @expect-error has no assigned values
// Cast-direction errors: a plain enum has no numeric contract in either direction, an integer
// converts to a numeric enum only through the checked 'as?', and a numeric enum converts to an
// integer only through the infallible 'as'.
enum Plain {
    A,
    B,
}

enum Numbered {
    Zero = 0,
    One = 1,
}

plainToInt() -> int {
    let p = Plain.A;
    return p as int;
}

plainAsCheckedTarget() -> Plain? {
    return 0 as? Plain;
}

intToEnumUnchecked() -> Numbered {
    return 1 as Numbered;
}

enumToIntChecked() -> int? {
    return Numbered.Zero as? int;
}

main() -> int {
    return 0;
}
