// @exit 0
// @stdout awaited 5 6
// @stdout received 10 45
// @stdout locked 400
// @stdout stopped: the task was cancelled
// @stdout dedicated 3
// Tasks that are awaited, a channel two tasks send through, a mutex four tasks lock, a sleeping task
// that is cancelled, and a task on a thread of its own at the highest priority, together, so every
// library call the task runtime makes is built and run for each target.
import @std.tasks;
import Cancelled from @std.tasks;
import Channel from @std.tasks;
import ChannelClosed from @std.tasks;
import Mutex from @std.tasks;
import Sender from @std.tasks;
import Task from @std.tasks;
import TaskPriority from @std.tasks;
import TaskScope from @std.tasks;

final class Tally {
    long count = 0;
}

produce(Sender<long> out, long from) throws Cancelled {
    for (long i = from; i < from + 5; i++) {
        try out.send(i);
    }
} catch (ChannelClosed closed) {
    print("closed early");
}

startProducer(TaskScope scope, Channel<long> values, long from) {
    let out = values.sender();
    scope.launch(() -> try produce(out, from));
}

addMany(Mutex<Tally> tally) throws Cancelled {
    for (int i = 0; i < 100; i++) {
        try tally.lock((held) -> {
            held.count = held.count + 1;
        });
    }
}

stopped(Task<(() -> string throws Cancelled)> task) -> string {
    return try task.await();
} catch (Cancelled stop) {
    return "stopped: {stop.message}";
}

main() -> int throws Cancelled {
    print(try tasks.scope((scope) -> {
        let first = scope.start(() -> "hello".length);
        let second = scope.start(() -> "worlds".length);
        return "awaited {try first.await()} {try second.await()}";
    }));

    let values = new Channel<long>(2);
    print(tasks.scope((scope) -> {
        startProducer(scope, values, 0);
        startProducer(scope, values, 5);
        long count = 0;
        long total = 0;
        for (let value in values) {
            count++;
            total = total + value;
        }
        return "received {count} {total}";
    }));

    let tally = new Mutex<Tally>(new Tally());
    tasks.scope((scope) -> {
        for (int t = 0; t < 4; t++) {
            scope.launch(() -> try addMany(tally));
        }
    });
    print("locked {try tally.lock((held) -> held.count)}");

    print(tasks.scope((scope) -> {
        let sleeping = scope.start(() -> {
            try tasks.sleep(60000);
            return "slept";
        });
        sleeping.cancel();
        return stopped(sleeping);
    }));

    print(try tasks.scope((scope) -> {
        let dedicated = scope.startDedicated(TaskPriority.Realtime, () -> 3);
        return "dedicated {try dedicated.await()}";
    }));
    return 0;
}
