// @exit 0
// @stdout local-default absent
// @stdout wrap 7
// @stdout coalesce 42
// @stdout coalesce-chain 9
// @stdout narrowed 7
// @stdout reassign ok
// @stdout param ok
// @stdout return ok
// @stdout compare ok
// @stdout bool ok
// @stdout float ok
// @stdout enum ok
// @stdout switch ok
// @stdout struct ok
// @stdout class ok

enum Color { Red, Green, Blue }

struct Holder {
    int? slot;
    int plain = 3;
}

class Cell {
    int? stored;
}

maybe(bool give) -> int? {
    if (give) { return 7; }
    return null;
}

describe(int? value) -> string {
    if (value == null) { return "nothing"; }
    return "got " + value;
}

main() -> int {
    int? a;
    if (a == null) { print("local-default absent"); }

    int? b = 7;
    if (b != null) { print("wrap " + b); }

    int? c = null;
    long coalesced = c ?? 42;
    print("coalesce " + coalesced);

    int? d = null;
    int? e = 9;
    int chained = d ?? e ?? 5;
    print("coalesce-chain " + chained);

    if (b != null) {
        int narrowed = b;
        print("narrowed " + narrowed);
    }

    b = null;
    if (b == null) { print("reassign ok"); }

    if (describe(null) == "nothing" && describe(4) == "got 4") { print("param ok"); }

    int? f = maybe(true);
    int? g = maybe(false);
    if (f != null && g == null) { print("return ok"); }

    if (f == 7 && 7 == f && f != g && g == null) { print("compare ok"); }

    bool? flag;
    if (flag == null) {
        flag = true;
    }
    if (flag == true) { print("bool ok"); }

    double? ratio = null;
    double resolved = ratio ?? 1.5;
    if (resolved == 1.5) { print("float ok"); }

    Color? tint = Color.Green;
    if (tint != null && tint == Color.Green) { print("enum ok"); }

    Color? empty = null;
    string label = switch (empty) {
        null -> "switch ok",
        Red -> "red",
        default -> "other",
    };
    print(label);

    Holder h;
    if (h.slot == null && h.plain == 3) {
        h.slot = 11;
        if (h.slot != null && h.slot == 11) { print("struct ok"); }
    }

    let cell = new Cell();
    if (cell.stored == null) {
        cell.stored = 13;
        if (cell.stored == 13) { print("class ok"); }
    }

    return 0;
}
