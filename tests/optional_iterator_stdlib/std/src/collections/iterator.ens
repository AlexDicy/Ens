// The optional-protocol iteration contracts, ahead of the real library's flip. 'next' answers
// the value it moved onto, or null when the walk is over, and every call after that answers
// null too.
export interface Iterator<T> {
    next() -> T?;
}

// Something 'for (let item in ...)' can walk: the loop asks for one iterator and draws values
// until it runs out.
export interface Iterable<T> {
    makeIterator() -> Iterator<T>;
}
