// The stand-in '@std.core' the optional-iterator fixture is compiled against: every program
// loads this module, so it carries the two shapes the compiler resolves by name and nothing
// else. The real one is libs/std/src/core.ens.
export struct StackFrame {
    export const string function;
    export const string file;
    export const int line;
}

export class Error {
    export string message;

    long[]? frames;

    export constructor(this.message);

    export stackTrace() -> string {
        return "";
    }

    export stackFrames() -> StackFrame[] {
        return [];
    }
}
