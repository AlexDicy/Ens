public enum Edition {
    Stable,
    Beta,
}

public class Box<T> {
    public static const int limit = 3;
    public const T held;

    public constructor(this.held);

    public static make(T value) -> Box<T> {
        return new Box<T>(value);
    }
}

public struct Point {
    public int x = 0;
}

public interface Named {
    name() -> string;
}

public class Tag implements Named {
    public override name() -> string {
        return "tag";
    }
}

hidden() -> int {
    return 1;
}

class Secret {
}

public struct Pair {
    public int a = 0;
    public int b = 0;

    public constructor(int a, int b) {
        this.a = a;
        this.b = b;
    }
}
