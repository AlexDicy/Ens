// @exit 0
// @stdout beta
// @stdout stable
// @stdout boxed 3
// @stdout 7
// @stdout 4
// @stdout tag
// @stdout 2
// @stdout none
// @stdout is tag
// @stdout 5
// @stdout 6
// A type is written through the module that declares it, under the module's own name or an
// alias: as a parameter, a variable, an enum member, a 'new', a generic instance and its statics,
// a struct literal's type, an interface, an array, a nullable, an 'is' operand and a struct's
// constructor, and a static const reads another one through it.
import version;
import version as v;

class Limits {
    static const int doubled = version.Box.limit * 2;
}

describe(version.Edition edition) -> string {
    return switch (edition) {
        Stable -> "stable",
        Beta -> "beta",
    };
}

main() -> int {
    version.Edition edition = version.Edition.Beta;
    print(describe(edition));
    print(describe(v.Edition.Stable));
    version.Box<string> box = new version.Box<string>("boxed");
    print(box.held + " {version.Box<int>.limit}");
    let made = version.Box<int>.make(7);
    print("{made.held}");
    version.Point point = {x: 4};
    print("{point.x}");
    version.Named named = new version.Tag();
    print(named.name());
    version.Edition[] all = [version.Edition.Stable, version.Edition.Beta];
    print("{all.length}");
    version.Edition? none = null;
    print(none == null ? "none" : "some");
    print(named is version.Tag ? "is tag" : "not tag");
    version.Pair pair = version.Pair(2, 3);
    print("{pair.a + pair.b}");
    print("{Limits.doubled}");
    return 0;
}
