// @exit 100

class Box {
    int v;
    constructor(this.v = 0);
}

private slotValue(Box? b) -> int {
    if (b != null) { return b.v; }
    return 0;
}

private sumLoop(int n) -> int {
    int total = 0;
    int k = 0;
    while (k < n) {
        // `xs` is freshly allocated each iteration. With stack promotion this
        // alloca is hoisted once but re-memset zeroed per iteration so the
        // class-element cleanup at end-of-iteration leaves no stale pointers.
        Box?[] xs = new Box?[2];
        xs[0] = new Box(k);
        xs[1] = new Box(k + 1);
        total = total + slotValue(xs[0]) + slotValue(xs[1]);
        k = k + 1;
    }
    return total;
}

main() -> int {
    // Primitive array, NoEscape, literal size.
    int[] a = new int[5];
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    int s1 = a[0] + a[1] + a[2] + a[3] + a[4];
    if (s1 != 100) { return 1; }

    // Array literal init.
    int[] b = [1, 2, 3, 4];
    if (b.length != 4L) { return 2; }
    if (b[0] + b[1] + b[2] + b[3] != 10) { return 3; }

    // Class-element array - cleanup must release each Box at scope end.
    Box?[] boxes = new Box?[3];
    boxes[0] = new Box(10);
    boxes[1] = new Box(15);
    boxes[2] = new Box(17);
    int sum = slotValue(boxes[0]) + slotValue(boxes[1]) + slotValue(boxes[2]);
    boxes[1] = new Box(20);
    int sum2 = slotValue(boxes[0]) + slotValue(boxes[1]) + slotValue(boxes[2]);
    boxes[0] = null;
    if (slotValue(boxes[0]) != 0) { return 4; }
    if (sum != 42) { return 5; }
    if (sum2 != 47) { return 6; }

    // Stack array inside a loop body - the alloca is shared across iterations
    // and re-memset gives each iteration a clean slate.
    int loopTotal = sumLoop(3);
    // k=0: 0 + 1 = 1
    // k=1: 1 + 2 = 3
    // k=2: 2 + 3 = 5
    // total = 9
    if (loopTotal != 9) { return 7; }

    // Zero-element array still works.
    int[] empty = new int[0];
    if (empty.length != 0L) { return 8; }

    return 100;
}