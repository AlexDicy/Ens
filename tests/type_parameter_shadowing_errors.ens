// A type parameter takes its name for the whole of the declaration that introduces it, so a
// type, a function or a module of that name outside it is unreachable inside it. Every position
// reads one refusal, a value, a call, an enum constant and a static head alike, and it names the
// meaning the parameter took the name from: one this file declares, one it imports, one an
// implicitly imported module declares, or a module it imports. The fix is to rename one of the
// two, except where the type that introduces the parameter declares a static of that name,
// which the type name still reaches. A call position offers that read with its arguments
// dropped, because a static const is not callable. A generic function's parameter takes its
// name the same way a class's does. A field default and a parameter default read the same
// refusal a body does, because the header declares the parameter for the whole declaration.
// A type position and a 'new' read that refusal too, and a head the parameter took from nothing
// reads what a type parameter qualifies instead.
// @expect-error 'Kind' means the type parameter of 'ValueOfEnum' here, not the enum this file declares, because inside 'ValueOfEnum' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'Kind' means the type parameter of 'CallOfEnum' here, not the enum this file declares, because inside 'CallOfEnum' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'Kind' means the type parameter of 'ConstantOfEnum' here, not the enum this file declares, because inside 'ConstantOfEnum' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'Made' means the type parameter of 'CallOfStruct' here, not the struct this file declares, because inside 'CallOfStruct' the name 'Made' always means the type parameter. Rename one of the two.
// @expect-error 'Holder' means the type parameter of 'StaticOfClass' here, not the class this file declares, because inside 'StaticOfClass' the name 'Holder' always means the type parameter. Rename one of the two.
// @expect-error 'Shown' means the type parameter of 'ValueOfInterface' here, not the interface this file declares, because inside 'ValueOfInterface' the name 'Shown' always means the type parameter. Rename one of the two.
// @expect-error 'helper' means the type parameter of 'CallOfFunction' here, not the function this file declares, because inside 'CallOfFunction' the name 'helper' always means the type parameter. Rename one of the two.
// @expect-error 'StringBuilder' means the type parameter of 'ValueOfImport' here, not the class declared in module 'std.text.stringbuilder', because inside 'ValueOfImport' the name 'StringBuilder' always means the type parameter. Rename one of the two.
// @expect-error 'parse' means the type parameter of 'CallOfModule' here, not the module 'std.text.parse' this file imports, because inside 'CallOfModule' the name 'parse' always means the type parameter. Rename one of the two.
// @expect-error 'print' means the type parameter of 'CallOfPrelude' here, not the function declared in module 'std.io.print', because inside 'CallOfPrelude' the name 'print' always means the type parameter. Rename one of the two.
// @expect-error 'Error' means the type parameter of 'ValueOfImplicit' here, not the class declared in module 'std.core', because inside 'ValueOfImplicit' the name 'Error' always means the type parameter. Rename one of the two.
// @expect-error 'Limit' is the type parameter of 'StaticConstOwner' here, not the static const it declares. Write 'StaticConstOwner.Limit' to read the static.
// @expect-error 'Limit' is the type parameter of 'StaticConstCaller' here, not the static const it declares, and neither one can be called. Remove the arguments and write 'StaticConstCaller.Limit' to read the static.
// @expect-error 'make' is the type parameter of 'StaticMethodOwner' here, not the static method it declares. Write 'StaticMethodOwner<make>.make(...)' to call the static.
// @expect-error 'Kind' means the type parameter of 'carries' here, not the enum this file declares, because inside 'carries' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'Kind' means the type parameter of 'ConstantInFieldDefault' here, not the enum this file declares, because inside 'ConstantInFieldDefault' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'Kind' means the type parameter of 'ConstantInParameterDefault' here, not the enum this file declares, because inside 'ConstantInParameterDefault' the name 'Kind' always means the type parameter. Rename one of the two.
// @expect-error 'stringbuilder' means the type parameter of 'TypeOfModule' here, not the module 'std.text.stringbuilder' this file imports, because inside 'TypeOfModule' the name 'stringbuilder' always means the type parameter. Rename one of the two.
// @expect-error 'stringbuilder' means the type parameter of 'NewOfModule' here, not the module 'std.text.stringbuilder' this file imports, because inside 'NewOfModule' the name 'stringbuilder' always means the type parameter. Rename one of the two.
// @expect-error 'Slot.StringBuilder' writes a type name after the type parameter 'Slot', and 'Slot' is a different type each time it is used, so 'Slot.StringBuilder' does not name one type. Write the type's own name instead.
// @expect-error build failed with 20 problems

import StringBuilder from @std.text.stringbuilder;
import @std.text.parse;
import @std.text.stringbuilder;

public enum Kind {
    Large,
    Small,
}

public struct Made {
    public int a;

    public constructor(this.a);
}

public class Holder {
    public static const int size = 1;

    public constructor();
}

public interface Shown {
    size() -> int;
}

helper(int value) -> int {
    return value;
}

public class ValueOfEnum<Kind> {
    public constructor();

    readsIt() {
        let held = Kind;
    }
}

public class CallOfEnum<Kind> {
    public constructor();

    callsIt() {
        let held = Kind(1);
    }
}

public class ConstantOfEnum<Kind> {
    public constructor();

    reachesIt() {
        let held = Kind.Large;
    }
}

public class CallOfStruct<Made> {
    public constructor();

    callsIt() {
        let held = Made(3);
    }
}

public class StaticOfClass<Holder> {
    public constructor();

    reachesIt() {
        let held = Holder.size;
    }
}

public class ValueOfInterface<Shown> {
    public constructor();

    readsIt() {
        let held = Shown;
    }
}

public class CallOfFunction<helper> {
    public constructor();

    callsIt() {
        let held = helper(1);
    }
}

public class ValueOfImport<StringBuilder> {
    public constructor();

    readsIt() {
        let held = StringBuilder;
    }
}

public class CallOfModule<parse> {
    public constructor();

    callsIt() {
        let held = parse.parseInt("3");
    }
}

public class CallOfPrelude<print> {
    public constructor();

    callsIt() {
        print("held");
    }
}

public class ValueOfImplicit<Error> {
    public constructor();

    readsIt() {
        let held = Error;
    }
}

public class StaticConstOwner<Limit> {
    public static const int Limit = 3;

    public constructor();

    readsIt() {
        let held = Limit;
    }
}

public class StaticConstCaller<Limit> {
    public static const int Limit = 3;

    public constructor();

    callsIt() {
        let held = Limit(1);
    }
}

public class StaticMethodOwner<make> {
    public constructor();

    public static make() -> int {
        return 1;
    }

    callsIt() {
        let held = make();
    }
}

public class ConstantInFieldDefault<Kind> {
    public int held = Kind.Large;

    public constructor();
}

public class ConstantInParameterDefault<Kind> {
    public constructor();

    reachesIt(int held = Kind.Large) -> int {
        return held;
    }
}

carries<Kind>() {
    let held = Kind.Large;
}

public class TypeOfModule<stringbuilder> {
    public constructor();

    readsIt() {
        stringbuilder.StringBuilder held;
    }
}

public class NewOfModule<stringbuilder> {
    public constructor();

    makesIt() {
        let held = new stringbuilder.StringBuilder();
    }
}

public class BareHead<Slot> {
    public constructor();

    readsIt() {
        Slot.StringBuilder held;
    }
}

main() -> int {
    return 0;
}
