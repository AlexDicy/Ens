// A type parameter takes its name for the whole of the declaration that introduces it, so a
// type, a function or a module of that name outside it is unreachable inside it. Every position
// reads one refusal, a value, a call, an enum constant and a static head alike, and it names the
// meaning the parameter took the name from: one this file declares, one it imports, one an
// implicitly imported module declares, or a module it imports. The fix is to rename one of the
// two, except where the type that introduces the parameter declares a static of that name,
// which the type name still reaches. A generic function's parameter takes its name the same
// way a class's does.
// @expect-error 'Kind' is the type parameter of 'ValueOfEnum' here, not the enum this file declares, because a type parameter takes the name for the whole of 'ValueOfEnum'. Rename one of the two.
// @expect-error 'Kind' is the type parameter of 'CallOfEnum' here, not the enum this file declares, because a type parameter takes the name for the whole of 'CallOfEnum'. Rename one of the two.
// @expect-error 'Kind' is the type parameter of 'ConstantOfEnum' here, not the enum this file declares, because a type parameter takes the name for the whole of 'ConstantOfEnum'. Rename one of the two.
// @expect-error 'Made' is the type parameter of 'CallOfStruct' here, not the struct this file declares, because a type parameter takes the name for the whole of 'CallOfStruct'. Rename one of the two.
// @expect-error 'Holder' is the type parameter of 'StaticOfClass' here, not the class this file declares, because a type parameter takes the name for the whole of 'StaticOfClass'. Rename one of the two.
// @expect-error 'Shown' is the type parameter of 'ValueOfInterface' here, not the interface this file declares, because a type parameter takes the name for the whole of 'ValueOfInterface'. Rename one of the two.
// @expect-error 'helper' is the type parameter of 'CallOfFunction' here, not the function this file declares, because a type parameter takes the name for the whole of 'CallOfFunction'. Rename one of the two.
// @expect-error 'StringBuilder' is the type parameter of 'ValueOfImport' here, not the class declared in module 'std.text.stringbuilder', because a type parameter takes the name for the whole of 'ValueOfImport'. Rename one of the two.
// @expect-error 'parse' is the type parameter of 'CallOfModule' here, not the module 'std.text.parse' this file imports, because a type parameter takes the name for the whole of 'CallOfModule'. Rename one of the two.
// @expect-error 'print' is the type parameter of 'CallOfPrelude' here, not the function declared in module 'std.io.print', because a type parameter takes the name for the whole of 'CallOfPrelude'. Rename one of the two.
// @expect-error 'Error' is the type parameter of 'ValueOfImplicit' here, not the class declared in module 'std.core', because a type parameter takes the name for the whole of 'ValueOfImplicit'. Rename one of the two.
// @expect-error 'Limit' is the type parameter of 'StaticConstOwner' here, not the static const it declares. Write 'StaticConstOwner.Limit' to read the static.
// @expect-error 'make' is the type parameter of 'StaticMethodOwner' here, not the static method it declares. Write 'StaticMethodOwner<make>.make(...)' to call the static.
// @expect-error 'Kind' is the type parameter of 'carries' here, not the enum this file declares, because a type parameter takes the name for the whole of 'carries'. Rename one of the two.
// @expect-error build failed with 14 problems

import StringBuilder from @std.text.stringbuilder;
import @std.text.parse;

public enum Kind {
    Large,
    Small,
}

public struct Made {
    public int a;

    public constructor(this.a);
}

public class Holder {
    public static const int size = 1;

    public constructor();
}

public interface Shown {
    size() -> int;
}

helper(int value) -> int {
    return value;
}

public class ValueOfEnum<Kind> {
    public constructor();

    readsIt() {
        let held = Kind;
    }
}

public class CallOfEnum<Kind> {
    public constructor();

    callsIt() {
        let held = Kind(1);
    }
}

public class ConstantOfEnum<Kind> {
    public constructor();

    reachesIt() {
        let held = Kind.Large;
    }
}

public class CallOfStruct<Made> {
    public constructor();

    callsIt() {
        let held = Made(3);
    }
}

public class StaticOfClass<Holder> {
    public constructor();

    reachesIt() {
        let held = Holder.size;
    }
}

public class ValueOfInterface<Shown> {
    public constructor();

    readsIt() {
        let held = Shown;
    }
}

public class CallOfFunction<helper> {
    public constructor();

    callsIt() {
        let held = helper(1);
    }
}

public class ValueOfImport<StringBuilder> {
    public constructor();

    readsIt() {
        let held = StringBuilder;
    }
}

public class CallOfModule<parse> {
    public constructor();

    callsIt() {
        let held = parse.parseInt("3");
    }
}

public class CallOfPrelude<print> {
    public constructor();

    callsIt() {
        print("held");
    }
}

public class ValueOfImplicit<Error> {
    public constructor();

    readsIt() {
        let held = Error;
    }
}

public class StaticConstOwner<Limit> {
    public static const int Limit = 3;

    public constructor();

    readsIt() {
        let held = Limit;
    }
}

public class StaticMethodOwner<make> {
    public constructor();

    public static make() -> int {
        return 1;
    }

    callsIt() {
        let held = make();
    }
}

carries<Kind>() {
    let held = Kind.Large;
}

main() -> int {
    return 0;
}
