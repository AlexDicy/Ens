// @expect-error Variable 'sum' has type 'float', but its value has type 'double'.
// A literal takes its type from what sits beside it, not from further out: the surrounding type
// does not reach through an operator into both of its operands. This matches the integer rule,
// where 'uint total = 1 + 4;' is refused for the same reason.
main() -> int {
    float sum = 1.0 + 2.0;
    return sum > 0.0 ? 0 : 1;
}
