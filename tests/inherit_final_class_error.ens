// @expect-error Cannot extend 'Sealed', because it is declared 'final'. Remove 'final' from 'Sealed', or stop extending it.
// @expect-error build failed with 1 problem
final class Sealed {
    int x;
    constructor(this.x = 0);

    area() -> int {
        return this.x;
    }
}

// The refused base is still the base of 'Bad', so its 'super' calls and its override are not
// refused as well.
class Bad extends Sealed {
    int y;

    constructor() {
        super(1);
        this.y = 0;
    }

    override area() -> int {
        return super.area() + this.y;
    }
}

main() -> int {
    return 0;
}
