// @expect-error Function 'narrowed' returns 'int?', but this value has type 'long?'. Change the return type of 'narrowed' to 'long?' instead.
// @expect-error Variable 'count' has type 'int?', but its value has type 'long?'. Declare 'count' as a 'long?' instead.
// @expect-error Variable 'nested' has type 'int??', but its value has type 'long?'. Declare 'nested' as a 'long??' instead.
// @expect-error Variable 'flat' has type 'long?', but its value has type 'int??'. 'deep(true)' can return null. Store the result in a local first ('let deepResult = deep(true);') and check the local.
// @expect-error Variable 'unsigned' has type 'uint?', but its value has type 'int?'. Declare 'unsigned' as an 'int?' instead.
// @expect-error Variable 'single' has type 'float?', but its value has type 'long?'. Declare 'single' as a 'long?' instead.
// @expect-error Variable 'letter' has type 'char?', but its value has type 'int?'. Declare 'letter' as an 'int?' instead.
// @expect-error Argument 1 of 'takeSmall' has type 'long?', but parameter 'value' has type 'int?'.
// @expect-error The two results of this '?:' are 'int?' and 'uint', which have no common type. Give both branches the same type.
// @expect-error Cannot compare 'int?' with 'uint', because neither type has every value of the other: an 'int' can be negative, and a 'uint' can be larger than any 'int'. Check 'held' for null first ('if (held != null)'). Convert both sides to 'long', as in 'held as long == positive as long'.
// @expect-error This call matches 'pick(long?)' and 'pick(double?)' equally well, so it is not clear which one to call. Argument 1 has type 'int?', which fits both 'long?' and 'double?'. Neither 'long' nor 'double' converts to the other without 'as', so neither is more specific. Declare argument 1 as a local first, as in 'long? value = held;', and pass 'value'.
// @expect-error build failed with 11 problems
// A nullable number converts only where its plain type would, at the same level of null or by
// adding levels: narrowing, a change of sign, a 'float' too narrow for every 'long', a number
// becoming a 'char', and dropping a level each stay refused.

wide(bool present) -> long? {
    if (present) {
        return 3L;
    }
    return null;
}

small(bool present) -> int? {
    if (present) {
        return 3;
    }
    return null;
}

deep(bool present) -> int?? {
    if (present) {
        return small(true);
    }
    return null;
}

takeSmall(int? value) -> int {
    return value ?? 0;
}

narrowed(long? value) -> int? {
    return value;
}

pick(long? value) -> string {
    return "long";
}

pick(double? value) -> string {
    return "double";
}

main() {
    long? total = wide(true);
    int? held = small(true);
    int? count = total;
    int?? nested = total;
    long? flat = deep(true);
    uint? unsigned = held;
    float? single = total;
    char? letter = held;
    int sum = takeSmall(total);
    bool flag = true;
    let mixed = flag ? held : (5 as uint);
    uint? positive = 5;
    bool same = held == positive;
    string chosen = pick(held);
}
