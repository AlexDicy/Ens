// @expect-error Static method 'make' of 'Widget' is already declared with the same parameter types; overloads must differ in parameter count or types.
// @expect-error Static member 'size' has the same name as a field of 'Widget'; a static and an instance member cannot share a name. Rename one of the two.
// @expect-error 'this' cannot be used in a static method; a static belongs to the type itself and has no instance. Take the instance as a parameter, or drop 'static'.
// @expect-error Statics are called through the type name, even inside 'Widget'; write 'Widget.make(...)'.
// @expect-error 'mark' is already declared as a static const of 'Clash'; a field and a method cannot share a name.
// @expect-error 'fetch' is already declared as a static method of 'Clash'; a static and an instance member cannot share a name. Rename one of the two.
// @expect-error Static method 'alpha' cannot be 'abstract': a static is called through the type name and never dispatches, so no subclass could supply its body. Remove one of the two.
// @expect-error Static method 'beta' cannot be 'override': statics are not inherited, so there is nothing to override. Remove one of the two.
// @expect-error Static method 'gamma' cannot be 'final': statics are not inherited, so there is no override to forbid. Remove one of the two.
// @expect-error A constructor cannot be 'static'; a constructor always builds an instance. Remove 'static', or make it a static factory method that returns the new instance.
// @expect-error A destructor cannot be 'static'; it runs when an instance is destroyed. Remove 'static'.
// @expect-error A 'static' field must also be 'const'; there is no mutable type-level state. Write 'static const int mutable = ...', or make 'mutable' an instance field.
// @expect-error Static const 'missing' needs its value on the declaration, because nothing else ever assigns it: write 'static const int missing = ...'.
// @expect-error Static const 'handle' has type 'Widget', but a static const holds a compile-time constant, so its type must be a primitive, 'char', 'bool', or 'string'.
// @expect-error A static const field cannot be 'weak': it holds a compile-time constant, not a reference to an object. Remove 'weak'.
// @expect-error The initializer of static const 'Consts.called' must be a compile-time constant, but it calls a function, which only runs at run time. A constant is built from literals, '+', '-', '*', '/', '%', string concatenation, and other static consts read through their type name.
// @expect-error The initializer of static const 'Consts.fresh' must be a compile-time constant, but it creates an object with 'new', which only happens at run time.
// @expect-error Static const 'agg' has type 'Point', but a static const holds a compile-time constant, so its type must be a primitive, 'char', 'bool', or 'string'.
// @expect-error The initializer of static const 'Consts.agg' must be a compile-time constant, but it builds a struct, and a static const holds a primitive, 'char', 'bool', or 'string'.
// @expect-error The initializer of static const 'Consts.listy' must be a compile-time constant, but it builds an array, and a static const holds a primitive, 'char', 'bool', or 'string'.
// @expect-error The initializer of static const 'Consts.inter' must be a compile-time constant, but string interpolation builds its text at run time; join the pieces with '+' instead.
// @expect-error 'Consts.second' cannot take its value from 'Consts.first' here: the chain of static consts between them closes a cycle. Break the cycle by giving one of them a literal value.
// @expect-error Statics are read through the type name even inside 'Consts'; write 'Consts.first'.
// @expect-error Static const 'Consts.tiny' has type 'byte', which holds 0..255; 300 is outside that range.
// @expect-error Static const 'Consts.wrongkind' has type 'string' but its initializer is the number 5.
// @expect-error The initializer of static const 'Consts.divided' divides by zero.
// @expect-error Static const 'bad' cannot have type 'T': a static belongs to the type itself, which every instantiation shares, so its type cannot use a type parameter.
// @expect-error Statics cannot be reached through a type parameter: 'T' stands for a different type in every instantiation, so 'T.member' names nothing the compiler can resolve. Name the type itself.
// @expect-error An interface cannot declare a static member; a static belongs on the class or struct itself, so declare 'load' there. Remove 'static', or move the member.
// @expect-error Function 'free' cannot be 'static'; 'static' goes on a method or a 'const' field of a class or a struct, where it makes the member belong to the type itself; a top-level function already belongs to no instance. Remove 'static'.
// @expect-error Use 'Widget.make(...)'; a static belongs to the type, not to an instance.
// @expect-error Use 'Widget.tag'; a static belongs to the type, not to an instance.
// @expect-error Statics are not inherited: 'create' is declared by 'Base', so it is reached only through that name. Write 'Base.create'.
// @expect-error Cannot tell the type arguments for 'Pair2.of': neither the call's arguments nor the surrounding context supplies them. Write them on the type name, as in 'Pair2<A, B>.of(...)'.
// @expect-error Cannot tell the type arguments for 'Pair2.wrap': neither the call's arguments nor the surrounding context supplies them. Write them on the type name, as in 'Pair2<A, B>.wrap(...)'.
// @expect-error Argument 2: expected 'int', got 'string'. 'T' was inferred as 'int' from argument 1; write the type arguments on the type name, as in 'Twin<T>.both(...)'.
// @expect-error A call that infers the type arguments of 'Pair2' does not support named arguments; pass the arguments in order, or write the type arguments on the type name, as in 'Pair2<A, B>.make(...)'.
// @expect-error Type arguments are never written on the method name, and 'Widget' is not generic; remove them.
// @expect-error Type arguments are never written on the method name; write them on the type name instead: 'Pair2<A, B>.of(...)'.
// @expect-error Cannot assign to 'Widget.tag': a static const takes its one value from its initializer and never changes. Change the initializer, or use an instance field.
// @expect-error The '++' operator cannot change 'Consts.first': a static const takes its one value from its initializer and never changes.
// @expect-error 'Widget.tag' is a static const, not a method, so it cannot be called. Remove the parentheses.
// @expect-error Type 'Widget' has no static member 'nope'.
// @expect-error Static method 'make' of 'Widget' must be called; write 'Widget.make(...)'.
// @expect-error build failed with 44 problems
// Every static enforcement rule in one place: type-name-only access from instances and
// subclasses, the uniform access rule inside the declaring type, no 'this' and no dispatch
// markers on statics, one namespace with instance members, 'static const' field shape and its
// compile-time initializer rules, no statics on interfaces or top-level functions or through a
// type parameter, type arguments never on the method name, and the uninferable bare call.

public class Widget {
    int size;

    public constructor(this.size);

    public static make() -> Widget {
        return new Widget(1);
    }

    public static make() -> Widget {
        return new Widget(2);
    }

    public static const string tag = "w";

    public static size(int value) -> int {
        return value;
    }

    public static broken() -> long {
        return this.size;
    }

    public helper() -> Widget {
        return make();
    }
}

public class Clash {
    public static const int mark = 1;

    public static mark(int value) -> int {
        return value;
    }

    public static fetch() -> int {
        return 2;
    }

    public fetch(int value) -> int {
        return value;
    }
}

public class Markers {
    public static abstract alpha() -> int {
        return 1;
    }

    public static override beta() -> int {
        return 2;
    }

    public static final gamma() -> int {
        return 3;
    }

    static constructor(int ignored);

    static destructor() { }
}

public class Consts {
    public static int mutable = 1;
    public static const int missing;
    public static const Widget handle = 3;
    public weak static const string wrong = "x";
    public static const int called = Consts.value();
    public static const int fresh = new Widget(1);
    public static const Point agg = {x: 1};
    public static const int listy = [1, 2];
    public static const string inter = "a{Consts.first}b";
    public static const int first = Consts.second + 1;
    public static const int second = Consts.first + 1;
    public static const int bare = first + 1;
    public static const byte tiny = 300;
    public static const string wrongkind = 5;
    public static const int divided = 1 / 0;
}

public struct Point {
    public int x;
}

public class Box<T> {
    public static const T bad = 0;
}

public class Factory<T> {
    public static create() -> long {
        return T.make();
    }
}

public class Base {
    public static create() -> int {
        return 5;
    }
}

public class Derived extends Base {
}

public interface Contract {
    static load() -> int;
}

public static free() -> int {
    return 0;
}

public struct Pair2<A, B> {
    public A first;
    public B second;

    public static of() -> long {
        return 0;
    }

    public static make(A first) -> long {
        return 1;
    }

    public static wrap(A? inner) -> long {
        return 2;
    }
}

public class Twin<T> {
    public static both(T first, T second) -> long {
        return 4;
    }
}

main() -> int {
    let widget = Widget.make();
    let viaInstance = widget.make();
    let viaInstanceConst = widget.tag;
    let fromSubclass = Derived.create();
    let uninferable = Pair2.of();
    let nullOnly = Pair2.wrap(null);
    let conflicted = Twin.both(1, "x");
    let named = Pair2.make(first: 1);
    let onPlainName = Widget.make<int>();
    let onGenericName = Pair2.of<int>();
    Widget.tag = "x";
    Consts.first++;
    let calledConst = Widget.tag();
    let nothing = Widget.nope();
    let unbound = Widget.make;
    return 0;
}
