public class Widget {
    int size;

    public constructor(this.size);

    public static make() -> Widget {
        return new Widget(1);
    }

    public static make() -> Widget {
        return new Widget(2);
    }

    public static const string tag = "w";

    public static size(int value) -> int {
        return value;
    }

    public static broken() -> long {
        return this.size;
    }

    public helper() -> Widget {
        return make();
    }
}

public class Clash {
    public static const int mark = 1;

    public static mark(int value) -> int {
        return value;
    }

    public static fetch() -> int {
        return 2;
    }

    public fetch(int value) -> int {
        return value;
    }
}

public class Markers {
    public static abstract alpha() -> int {
        return 1;
    }

    public static override beta() -> int {
        return 2;
    }

    public static final gamma() -> int {
        return 3;
    }

    static constructor(int ignored);

    static destructor() { }
}

public class Consts {
    public static int mutable = 1;
    public static const int missing;
    public static const Widget handle = 3;
    public weak static const string wrong = "x";
    public static const int called = Consts.value();
    public static const int fresh = new Widget(1);
    public static const Point agg = {x: 1};
    public static const int listy = [1, 2];
    public static const string inter = "a{Consts.first}b";
    public static const int first = Consts.second + 1;
    public static const int second = Consts.first + 1;
    public static const int bare = first + 1;
    public static const byte tiny = 300;
    public static const string wrongkind = 5;
    public static const int divided = 1 / 0;
}

public struct Point {
    public int x;
}

public class Box<T> {
    public static const T bad = 0;

    public static const int limit = 8;

    public static const int shared = T;

    public static const int reached = T.limit;
}

public class ReadsThroughArguments {
    // A static const never depends on type arguments, so a constant initializer names the type
    // without them.
    public static const int copied = Box<int>.limit;
}

public class Factory<T> {
    public static create() -> long {
        return T.make();
    }
}

public class Base {
    public static create() -> int {
        return 5;
    }
}

public class Derived extends Base {
}

public interface Contract {
    static load() -> int;
}

public static free() -> int {
    return 0;
}

public struct Pair2<A, B> {
    public A first;
    public B second;

    public static of() -> long {
        return 0;
    }

    public static make(A first) -> long {
        return 1;
    }

    public static wrap(A? inner) -> long {
        return 2;
    }
}

public class Twin<T> {
    public static both(T first, T second) -> long {
        return 4;
    }
}

main() -> int {
    let widget = Widget.make();
    let viaInstance = widget.make();
    let viaInstanceConst = widget.tag;
    let fromSubclass = Derived.create();
    let uninferable = Pair2.of();
    let nullOnly = Pair2.wrap(null);
    let conflicted = Twin.both(1, "x");
    let named = Pair2.make(first: 1);
    let onPlainName = Widget.make<int>();
    let onGenericName = Pair2.of<int>();
    Widget.tag = "x";
    Consts.first++;
    let calledConst = Widget.tag();
    let nothing = Widget.nope();
    let unbound = Widget.make;
    Widget.make = 3;
    let unboundGeneric = Twin<int>.both;
    return 0;
}
