// @exit 134
// @stderr-contains panic: tried to remove index 3 of a list of length 1. Check the index against length() first
// Removing names its own operation, so the same bound reports the removal rather than a read.
import List from @std.collections.list;

main() -> int {
    let items = new List<int>();
    items.push(7);
    return items.removeAt(3);
}
