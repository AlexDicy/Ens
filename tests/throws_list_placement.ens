// @exit 0
// @stdout free 1
// @stdout private 2
// @stdout final 3
// @stdout closed 4
// @stdout conditional 5
// @stdout reserved 6
// A declared throws list bounds the body that carries it, so it is legal wherever 'throws' is,
// and not only where an override could have to honor it: on a free function, on a private method,
// on a 'final' method, on a member of a 'final' class, and on a conditional member. A list may
// also name more than the body raises today, which is how an exported function keeps its thrown
// types stable while the body changes underneath.
class ReadError extends Error {
    protected constructor(string message) { super(message); }
}

class WriteError extends Error {
    protected constructor(string message) { super(message); }
}

interface Sized {
    size() -> int;
}

free(int n) -> int throws ReadError {
    if (n < 0) {
        throw new ReadError("negative");
    }
    return n;
}

class Store {
    hidden(int n) -> int throws ReadError {
        if (n < 0) {
            throw new ReadError("negative");
        }
        return n;
    }

    protected final frozen(int n) -> int throws ReadError {
        if (n < 0) {
            throw new ReadError("negative");
        }
        return n;
    }

    // The list names both, while this body raises only one of them.
    protected reserved(int n) -> int throws ReadError, WriteError {
        if (n < 0) {
            throw new ReadError("negative");
        }
        return n;
    }

    protected run() -> int {
        return try this.hidden(2);
    } catch (ReadError e) {
        return -1;
    }

    protected runFrozen() -> int {
        return try this.frozen(3);
    } catch (ReadError e) {
        return -1;
    }

    // Both declared types have to be handled, even though only one can arrive.
    protected runReserved() -> int {
        return try this.reserved(6);
    } catch (ReadError e) {
        return -1;
    } catch (WriteError e) {
        return -2;
    }
}

final class Closed {
    protected constructor();

    protected read(int n) -> int throws ReadError {
        if (n < 0) {
            throw new ReadError("negative");
        }
        return n;
    }
}

class Holder<T> {
    protected constructor();

    protected measure<T: Sized>(T value) -> int throws ReadError {
        if (value.size() < 0) {
            throw new ReadError("negative");
        }
        return value.size();
    }
}

class Five implements Sized {
    protected constructor();

    protected override size() -> int {
        return 5;
    }
}

report(string label, int value) {
    print("{label} {value}");
}

main() -> int {
    report("free", try free(1));
    let store = new Store();
    report("private", store.run());
    report("final", store.runFrozen());
    let closed = new Closed();
    report("closed", try closed.read(4));
    let holder = new Holder<Five>();
    report("conditional", try holder.measure(new Five()));
    report("reserved", store.runReserved());
    return 0;
} catch (ReadError e) {
    return 1;
}
