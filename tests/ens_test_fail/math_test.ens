import @std.testing;

subtract(int left, int right) -> int {
    return left - right;
}

test "subtraction handles negatives" {
    try testing.assertEqual(subtract(2, 3), -1);
}

test "subtraction fails on purpose" {
    try testing.assertEqual(subtract(2, 3), 1);
}

test "custom failure messages surface" {
    try testing.assertTrue(subtract(3, 2) == 1, "three minus two should be one");
}
