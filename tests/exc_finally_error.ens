// @expect-error Ens has no 'finally' block. Remove it, and write its cleanup before each 'return' and in the 'catch' block instead.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Repo {
    query() -> int throws { throw new Failure("x"); }
    handle() -> int {
        return try this.query();
    } catch (Error e) {
        return 0;
    } finally {
        return 1;
    }
}
main() -> int { return 0; }