// @exit 0
// @stdout plain 5
// @stdout with-ctor 5 1
// @stdout string label
// @stdout class-default 7
// @stdout sibling 7
// @stdout ctor-overwrite 9
// @stdout param-overwrite 4
// @stdout inherited 3 8
// @stdout generic 21
// @stdout default-released
// @stdout param-over-default 2
// @stdout owner-death released
// @stdout through-array 5 5
// @stdout through-object 6 6
// @stdout through-class 7 7
// @stdout through-element 8 8
// @stdout lambda-reads-sibling 11

class Plain {
    protected int value = 5;
}

class WithCtor {
    protected int value = 5;
    protected int other;
    protected constructor() { this.other = 1; }
}

class Labeled {
    protected string label = "label";
}

class Box {
    protected int content;
    protected constructor(this.content);
}

class Holder {
    protected Box first = new Box(7);
    protected Box second = first;
}

class Overwriter {
    protected int value = 5;
    protected constructor() { this.value = 9; }
}

class ParamOverwriter {
    protected int value = 5;
    protected constructor(this.value);
}

class BaseDefaults {
    protected int inherited = 3;
}

class DerivedDefaults extends BaseDefaults {
    protected int own = 8;
}

class Generic<T> {
    protected int tag = 21;
    protected T? stored;
}

class BoxKeeper {
    protected Box kept = new Box(1);
}

struct Corner {
    protected int x = 1;
}

class Frame {
    protected Corner corner = {};
    protected constructor();
}

// A default may write through a sibling. An element of the array one refers to, and a field of
// the object one refers to, are storage of their own rather than the sibling, whether the field
// written beyond them is a struct field or not. A lambda in a default reads a sibling by copying
// its value into the closure.
class ThroughSibling {
    protected int[] slots = new int[2];
    protected int written = (slots[0] = 5);
    protected Box box = new Box(1);
    protected int inner = (box.content = 6);
    protected Frame frame = new Frame();
    protected int throughClass = (frame.corner.x = 7);
    protected Corner[] corners = new Corner[2];
    protected int throughElement = (corners[0].x = 8);
    protected int doubled = written * 2;
    protected () -> int reader = () -> doubled + 1;
}

class Replaceable {
    protected Box item = new Box(1);
    protected constructor(this.item);
}

class Watcher {
    protected weak Box? seen;
}

main() -> int {
    print("plain " + new Plain().value);

    let withCtor = new WithCtor();
    print("with-ctor " + withCtor.value + " " + withCtor.other);

    print("string " + new Labeled().label);

    let holder = new Holder();
    print("class-default " + holder.first.content);
    print("sibling " + holder.second.content);

    print("ctor-overwrite " + new Overwriter().value);
    print("param-overwrite " + new ParamOverwriter(4).value);

    let derived = new DerivedDefaults();
    print("inherited " + derived.inherited + " " + derived.own);

    let generic = new Generic<string>();
    if (generic.stored == null) {
        print("generic " + generic.tag);
    }

    // Overwriting a class-typed field releases the default value it held.
    let watcher = new Watcher();
    let keeper = new BoxKeeper();
    watcher.seen = keeper.kept;
    keeper.kept = new Box(2);
    if (watcher.seen == null) { print("default-released"); }

    // A this.field constructor parameter overwrites (and releases) a default.
    let replaced = new Replaceable(new Box(2));
    print("param-over-default " + replaced.item.content);

    // Defaults held by an object are released when the object dies.
    if (true) {
        let dying = new Holder();
        watcher.seen = dying.first;
    }
    if (watcher.seen == null) { print("owner-death released"); }

    let through = new ThroughSibling();
    print("through-array " + through.slots[0] + " " + through.written);
    print("through-object " + through.box.content + " " + through.inner);
    print("through-class " + through.frame.corner.x + " " + through.throughClass);
    print("through-element " + through.corners[0].x + " " + through.throughElement);
    print("lambda-reads-sibling " + through.reader());

    return 0;
}