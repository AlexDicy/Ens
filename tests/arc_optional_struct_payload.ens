// @exit 0
// @stdout holder built
// @stdout copy built
// @stdout copy gone
// @stdout local built
// @stdout released local
// @stdout local gone
// @stdout keeper built
// @stdout released class field
// @stdout keeper gone
// @stdout released struct field
// A tagged optional whose payload holds a reference owns that reference through its presence
// tag: copying one retains the payload and leaving a scope releases it, whether the optional
// sits in a struct field, in a class field, or in a bare local. Each Probe reports its own
// release, so a missed release never reports at all and a release without the matching retain
// reports while the original is still alive.
class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Cell {
    protected Probe probe;
}

struct Holder {
    protected Cell? cell;
}

class Keeper {
    protected Cell? cell;

    protected constructor(this.cell);
}

copyOf(Holder holder) -> Holder {
    return holder;
}

main() -> int {
    Holder holder = {cell: {probe: new Probe("struct field")}};
    print("holder built");
    {
        Holder copy = copyOf(holder);
        print("copy built");
    }
    print("copy gone");

    {
        Cell? local = {probe: new Probe("local")};
        print("local built");
    }
    print("local gone");

    {
        Cell? owned = {probe: new Probe("class field")};
        let keeper = new Keeper(owned);
        print("keeper built");
    }
    print("keeper gone");
    return 0;
}
