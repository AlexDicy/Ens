import Kind from sizes.kinds;
import Vault from sizes.vault;

public class Failure extends Error {
    public constructor(string message) {
        super(message);
    }
}

public class Palette {
    public static warm() -> Kind {
        return Kind.Large;
    }
}

public class Crate<T> {
    public constructor() {
    }
}

public hold() -> Vault {
    return new Vault();
}
