// @exit 0
// @stdout sink built
// @stdout released struct arg
// @stdout sink gone
// @stdout consumed 8
// @stdout released call arg
// @stdout call done
// A struct literal holding a fresh object is an owned temporary at the call, since the callee's
// copy only borrows it, so the caller still has to release it when the scope ends. Both the
// by-pointer and the by-value path release it exactly once.
class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Cell {
    protected Probe probe;
}

class Sink {
    protected Cell cell;

    protected constructor(Cell incoming) {
        this.cell = incoming;
    }
}

consume(Cell taken) -> long {
    return taken.probe.label.length;
}

main() -> int {
    {
        let sink = new Sink({probe: new Probe("struct arg")});
        print("sink built");
    }
    print("sink gone");
    {
        print("consumed " + consume({probe: new Probe("call arg")}));
    }
    print("call done");
    return 0;
}
