// @exit 0
// @stdout sink built
// @stdout released struct arg
// @stdout sink gone
// @stdout released call arg
// @stdout consumed 8
// @stdout call done
// @stdout released held
// @stdout used held
// @stdout used done
// @stdout released replacement
// A struct an argument makes or copies is the call's own temporary, since the callee's copy only
// borrows it, so the caller releases it once the call returns: a literal holding a fresh object,
// on the by-pointer and the by-value path alike, and a copy of a field a later argument replaces.
class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Cell {
    protected Probe probe;
}

class Sink {
    protected Cell cell;

    protected constructor(Cell incoming) {
        this.cell = incoming;
    }
}

class Holder {
    protected Cell cell;

    protected constructor() {
        this.cell = {probe: new Probe("held")};
    }

    protected reset() -> int {
        this.cell = {probe: new Probe("replacement")};
        return 0;
    }
}

consume(Cell taken) -> long {
    return taken.probe.label.length;
}

useCell(Cell cell, int ignored) -> string {
    return cell.probe.label;
}

main() -> int {
    {
        let sink = new Sink({probe: new Probe("struct arg")});
        print("sink built");
    }
    print("sink gone");
    {
        print("consumed " + consume({probe: new Probe("call arg")}));
    }
    print("call done");
    {
        let holder = new Holder();
        print("used " + useCell(holder.cell, holder.reset()));
        print("used done");
    }
    return 0;
}
