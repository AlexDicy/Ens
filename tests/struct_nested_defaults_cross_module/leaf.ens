public enum Color {
    Red,
    Green,
    Blue,
}

// The `Color.Green` default is an enum constant only this module's analysis can
// resolve. When Leaf is a by-value field of a struct declared elsewhere, the
// recursion that applies its defaults must rebind to this declaring module.
public struct Leaf {
    public Color shade = Color.Green;
    public long x = 1;
}
