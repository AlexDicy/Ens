// @exit 0
// @stdout shade=Green x=1
import Color from leaf;
import Leaf from leaf;

// Mid is declared here; its by-value Leaf field pulls Leaf's defaults from the
// other module when `Mid m = {l: {}}` fills the Leaf field from its defaults.
struct Mid {
    Leaf l;
}

main() -> int {
    Mid m = {l: {}};
    print("shade={m.l.shade} x={m.l.x}");
    return 0;
}
