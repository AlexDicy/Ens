// @stdout Howdy, Ada! [override]
// @stdout Howdy, Root! [override]
// The root's ens.overrides redirects acme.tools to a sibling folder for the whole build:
// both the direct import here and demo.lib's own dependency resolve to the override,
// while demo.lib's own ens.overrides (pointing back at the real acme.tools) is ignored,
// because only the root workspace's overrides ever apply.
import @acme.tools.greeter;
import @demo.lib.relay;

main() -> int {
    print(greeter.greet("Ada"));
    print(relay.relayGreeting());
    return 0;
}
