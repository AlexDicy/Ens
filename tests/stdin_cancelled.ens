// @exit 0
// @stdout could not read standard input: the task was cancelled
// @stdout kind Cancelled, caused by Cancelled: true
// @stdout the reader exited 0
// A read of standard input waits parked while nothing arrives, so a time limit ends it: the child
// reads a pipe its parent never writes to, on its main thread under a time limit, and reports what
// the read threw.
import Path from @std.fs;
import IoError from @std.io.streams;
import Cancelled from @std.tasks;
import @std.environment;
import @std.io;
import @std.process;
import @std.tasks;

readUntilCancelled() -> string {
    let line = try io.in().readLine();
    return "the read returned";
} catch (IoError failure) {
    bool cancelledCause = failure.cause is Cancelled;
    return "{failure.message}\nkind {failure.kind}, caused by Cancelled: {cancelledCause}";
}

main() -> int throws {
    if (environment.arguments().length > 0) {
        string ended = try tasks.withTimeout(50, (scope) -> readUntilCancelled());
        print(ended);
        return 0;
    }
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("stdin_cancelled: this system would not report the path of this program");
        return 1;
    }
    let child = try process.spawn(self, ["reader"]);
    while (true) {
        string? line = try child.stdout().readLine();
        if (line == null) {
            break;
        }
        print(line);
    }
    try child.closeInput();
    let status = try child.wait();
    print("the reader exited {status.code}");
    return 0;
}
