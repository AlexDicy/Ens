// @exit 0
// @stdout arg-keep 111
// A call never drops a plain local's OWN narrowing, in argument position just
// as in receiver position: no callee can reassign the caller's binding, and the
// local's strong reference keeps the narrowed object alive. Member-path
// narrowings rooted at a passed value still drop - see the error fixtures.
class Door {
    protected int code;

    protected constructor(this.code = 0);

    open() {
    }
}

class Shape {
    protected int id;

    protected constructor(this.id = 0);
}

class Circle extends Shape {
    protected int radius;

    protected constructor(int id, this.radius = 0) {
        super(id);
    }
}

observe(Door d) -> int {
    return d.code;
}

observeShape(Shape s) -> int {
    return s.id;
}

// A null-narrowed local passed as an argument stays narrowed afterward, even
// across repeated calls.
readAfterArg(Door? d) -> int {
    if (d != null) {
        let first = observe(d);
        let second = observe(d);
        return d.code;
    }
    return -1;
}

// An 'is' narrowing survives argument passing the same way.
readAfterIsArg(Shape s) -> int {
    if (s is Circle) {
        let seen = observeShape(s);
        return s.radius;
    }
    return -1;
}

// A narrowed local passed as an argument inside a loop stays narrowed on every
// iteration.
sumInLoop(Door? d, int times) -> int {
    int total = 0;
    if (d != null) {
        for (int i = 0; i < times; i = i + 1) {
            let seen = observe(d);
            total = total + d.code;
        }
    }
    return total;
}

main() -> int {
    int score = 0;
    score = score + readAfterArg(new Door(7));          // 7
    score = score + readAfterIsArg(new Circle(1, 4));   // 4
    score = score + sumInLoop(new Door(25), 4);         // 100
    print("arg-keep " + score);
    return score - 111;
}
