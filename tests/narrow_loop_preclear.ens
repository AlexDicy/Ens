// @exit 0
// @stdout loop-preclear 6 12 8
// Loop-entry pre-clearing drops only what the body may write. A condition-derived
// narrowing is re-established each iteration, so a cursor walk still compiles; a
// guard-clause narrowing established inside the body is untouched; and a narrowing
// on a path the body never writes survives even when the body writes a sibling path.
class Node {
    int size;
    Node? next;

    constructor(this.size, this.next = null);
}

class Pair {
    Node? left;
    Node? right;

    constructor(this.left, this.right);
}

// The loop condition narrows `cursor` fresh on every iteration, even though the body
// reassigns it - the write only drops the narrowing after the read.
private walk(Node? cursor) -> int {
    int total = 0;
    while (cursor != null) {
        total = total + cursor.size;
        cursor = cursor.next;
    }
    return total;
}

// A `continue` guard narrows `item` inside the body; pre-clearing the outer scope
// leaves that in-body narrowing intact.
private guarded(Node?[] items) -> int {
    int total = 0;
    for (let item in items) {
        if (item == null) {
            continue;
        }
        total = total + item.size;
    }
    return total;
}

// `pair.left` is read but never written, so it stays narrowed across iterations even
// though the body writes the sibling path `pair.right`.
private sibling(Pair pair) -> int {
    if (pair.left != null && pair.right != null) {
        int total = 0;
        for (int i = 0; i < 2; i = i + 1) {
            total = total + pair.left.size;
            pair.right = null;
        }
        return total;
    }
    return -1;
}

main() -> int {
    int a = walk(new Node(1, new Node(2, new Node(3))));   // 6
    int b = guarded([new Node(4), null, new Node(8)]);     // 12
    int c = sibling(new Pair(new Node(4), new Node(9)));   // 8
    print("loop-preclear " + a + " " + b + " " + c);
    return (a - 6) + (b - 12) + (c - 8);
}
