// @exit 134
// @stderr-contains panic: tried to lock '
// @stderr-contains lock-after-close.txt' after it was closed. Call tryLock() before close()
// A closed file holds no lock any more, so asking it for one is a mistake in the program rather
// than a lock another file holds.
import File from @std.fs.file;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;

main() -> int {
    let opened = try closedAfterLocking();
    let again = try opened.tryLock();
    return 0;
} catch (Error unexpected) {
    eprint(unexpected.message);
    return 1;
}

// A file that took its lock and was then closed. Its folder is removed when this returns, so the
// panic leaves nothing behind.
closedAfterLocking() -> File throws {
    let scratch = try TemporaryDirectory.create("ens-lock-after-close");
    Path marker = scratch.path().join("lock-after-close.txt");
    try marker.writeText("");
    let opened = try marker.open();
    let locked = try opened.tryLock();
    try opened.close();
    return opened;
}
