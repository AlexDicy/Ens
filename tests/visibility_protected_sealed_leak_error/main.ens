// @expect-error Method 'reveal' of class 'Shape' is protected, and its return type uses 'Secret', which is private to module 'tree'. 'Shape' is sealed, but its subclass 'Polygon' is 'public' and neither 'final' nor 'sealed', so a class anywhere in the package can extend 'Polygon' and call 'reveal'. Mark 'Secret' 'public'.
// @expect-note 'Polygon' is declared here.
// @expect-error build failed with 1 problem
// A sealed class keeps its protected members to its file only while every subclass is closed too. The
// open 'Polygon' lets this file extend the hierarchy and call 'reveal', so its return type has to be
// nameable here, and 'Closed', which is 'final', keeps the same member to its own file.
import Polygon from tree;

class Square extends Polygon {
    constructor() {
        super();
    }

    protected peek() -> string {
        let held = this.reveal();
        return "{held}";
    }
}

main() -> int {
    return (new Square().peek().length) as int;
}
