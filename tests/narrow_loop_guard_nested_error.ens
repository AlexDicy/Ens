// @expect-error Cannot read a member of 'Cell?' because it may be null
// A `break` inside a NESTED loop binds to that inner loop, not to the outer loop's
// guard, so the guard does not exit the branch and `item` stays nullable after it.
class Cell {
    int value;

    constructor(this.value = 0);
}

sumBroken(Cell?[] items) -> int {
    int total = 0;
    for (let item in items) {
        if (item == null) {
            while (total < 0) {
                break;
            }
        }
        total = total + item.value;
    }
    return total;
}

main() -> int {
    return sumBroken([new Cell(1)]);
}
