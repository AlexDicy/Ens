import Channel from @std.tasks;
import @std.environment;

external from libc {
    exit(int code);
}

final class Signal {
    protected lazy const Channel<long> started = new Channel<long>(1);
    protected lazy const Channel<long> never = new Channel<long>(1);
}

// A test runs again by itself in a program started with one job, the program's first argument, and
// this suite was started with two.
alone() -> bool {
    string[] given = environment.arguments();
    return given.length > 0 && given[0] == "1";
}

test "the first test ends the program" {
    if (!alone()) {
        long? started = try Signal.started.receive();
    }
    exit(3);
}

test "the second test is still waiting" {
    if (alone()) {
        return;
    }
    try Signal.started.sender().send(1);
    long? nothing = try Signal.never.receive();
}

test "the third test runs after them" {
}
