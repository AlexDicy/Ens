// @exit 7
// An overloaded method called through '?.' still goes through overload resolution: the
// candidates come from the receiver's inner type, not from the optional wrapper.
class Tool {
    constructor();

    value(int a) -> int {
        return a;
    }

    value(int a, int b) -> int {
        return a + b;
    }
}

main() -> int {
    Tool? t = new Tool();
    return t?.value(3, 4) ?? 0;
}
