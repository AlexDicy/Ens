import @std.testing;

test "the first test adds" {
    try testing.assertEqual(1 + 2, 3);
}

test "the second test counts" {
    long total = 0;
    for (long i = 0; i < 1000; i++) {
        total = total + i;
    }
    try testing.assertEqual(total, 499500L);
}

test "the third test compares" {
    try testing.assertTrue("a".compareTo("b") < 0, "'a' sorts before 'b'");
}
