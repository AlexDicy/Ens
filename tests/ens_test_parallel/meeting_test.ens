import @std.testing;
import Channel from @std.tasks;

final class Meeting {
    protected lazy const Channel<long> asked = new Channel<long>(1);
    protected lazy const Channel<long> answered = new Channel<long>(1);
}

test "the first test hands a value to the second" {
    try Meeting.asked.sender().send(20);
    long? answer = try Meeting.answered.receive(60000);
    try testing.assertEqual(answer ?? 0, 21L);
}

test "the second test answers the first" {
    long? asked = try Meeting.asked.receive(60000);
    try Meeting.answered.sender().send((asked ?? 0) + 1);
    try testing.assertEqual(asked ?? 0, 20L);
}

test "a third test runs beside them" {
    try testing.assertEqual(1 + 2, 3);
}
