// @expect-error takes a value of an external type
// fromCString reads a foreign handle, so a non-external argument (here a string) is rejected. An
// ordinary generic '<T>(T handle)' would accept any type here; the rejection proves the call is
// checked by the intrinsic interception rather than routed through generic instantiation.
import @std.ffi;

main() -> int {
    let rejected = ffi.fromCString("not a handle");
    return 0;
}
