// @expect-error 'fromCString' takes a value of an external type, got 'string'. Pass a handle a C function returned.
// @expect-error 'fromCString' takes one argument, a handle a C function returned, but this call passes two. Remove the extra argument.
// @expect-error build failed with 2 problems
// fromCString reads a foreign handle, so a non-external argument (here a string) is rejected, and
// it takes exactly that one argument. An ordinary generic '<T>(T handle)' would accept any type
// here; the rejection proves the call is checked by the intrinsic interception rather than routed
// through generic instantiation.
import @std.ffi;

main() -> int {
    let rejected = ffi.fromCString("not a handle");
    let overfed = ffi.fromCString("one", "two");
    return 0;
}
