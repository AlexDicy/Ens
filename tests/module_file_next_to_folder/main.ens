// @exit 0
// @stdout opened by the file module: buffered stream
// @stdout named stream
// A file and a folder of the same name coexist: io.ens is the module 'io', and
// 'io.streams' resolves to streams.ens inside the io/ folder. The file module
// itself imports its sibling folder.
import io;
import io.streams;
import Stream from io.streams;

main() -> int {
    print(io.open());
    print(streams.describe(new Stream("named stream")));
    return 0;
}
