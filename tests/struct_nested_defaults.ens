// @exit 0
// @stdout label=3x4
// Nested by-value struct field defaults are applied transitively: an omitted
// field takes its default, and a struct field with no default fills from its own
// field defaults, leaving default-free leaf fields at their zero value. Array
// slots and class fields of struct type follow the same rule.
struct Leaf {
    long x = 1;
    long bare;
}

struct Mid {
    Leaf l;
    long tag = 7;
}

struct Deep {
    Mid m;
}

struct Sized {
    long width = 3;
    long height = 4;
    string label = "{width}x{height}";
}

struct HasSized {
    Sized s;
}

struct Plain {
    long a;
    long b;
}

struct Wrap<T> {
    T value;
    long marker = 9;
}

class Container {
    Mid held;
}

main() -> int {
    // Two-level nesting: an omitted 'tag' takes its default, and the 'l' field
    // fills from Leaf's field defaults, leaving the default-free 'bare' at 0.
    Mid m = {l: {bare: 0}};
    if (m.l.x != 1) { return 1; }
    if (m.tag != 7) { return 2; }
    if (m.l.bare != 0) { return 3; }

    // Three-level nesting.
    Deep d = {m: {l: {bare: 0}}};
    if (d.m.l.x != 1) { return 4; }
    if (d.m.tag != 7) { return 5; }

    // Plain primitive fields with no defaults, set explicitly.
    Plain p = {a: 0, b: 0};
    if (p.a != 0 || p.b != 0) { return 6; }

    // `new Mid[2]` slots each run the nested defaults.
    Mid[] arr = new Mid[2];
    if (arr[0].l.x != 1 || arr[1].l.x != 1) { return 7; }
    if (arr[0].tag != 7 || arr[1].tag != 7) { return 8; }

    // A class field of struct type gets nested defaults on `new`.
    Container c = new Container();
    if (c.held.l.x != 1) { return 9; }
    if (c.held.tag != 7) { return 10; }

    // Generic containment: Leaf's defaults reach the `T` slot of Wrap<Leaf>.
    Wrap<Leaf> w = {value: {bare: 0}};
    if (w.value.x != 1) { return 11; }
    if (w.marker != 9) { return 12; }

    // A nested string interpolation default over sibling fields (proves ARC and
    // module binding of the contained struct's defaults).
    HasSized hs = {s: {}};
    if (hs.s.width != 3 || hs.s.height != 4) { return 13; }
    print("label=" + hs.s.label);

    return 0;
}
