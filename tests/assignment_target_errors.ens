// The left side of an assignment, and the operand of '++' or '--', has to name storage the program
// can store into. A left side that names none says what one has to be, and parentheses around a
// left side are transparent, so what they hold is judged and they add no refusal of their own. A
// member that is not storage is refused by what it is: 'length' reports how much an array or a
// string holds, an enum's members are its constants, and a method is reached by calling it. Each
// of those refusals names the type rather than the expression, so it reads the same for a value no
// name reaches, and an array's names the element type a replacement is created with. '++' and '--'
// store back what they read, so they are refused the same way an assignment is. A '?.' write
// reports its own refusal beside the member's, and with no advice, because checking for null would
// not make that write work either.
// @expect-error The left side of '=' must be a variable, field, or array element.
// @expect-error 'length' is how many elements the 'T[]' holds, so it cannot be assigned. An array keeps the length it was created with, so create a new one of the size you need, as in 'new T[...]'.
// @expect-error 'length' is how many elements the 'int[]' holds, so it cannot be assigned. An array keeps the length it was created with, so create a new one of the size you need, as in 'new int[...]'.
// @expect-error 'length' is how many elements the 'string[]' holds, so it cannot be assigned. An array keeps the length it was created with, so create a new one of the size you need, as in 'new string[...]'.
// @expect-error 'length' is how many bytes the 'string' holds, so it cannot be assigned. A string never changes once it is made, so build the text you need and assign that.
// @expect-error 'Red' is a constant of enum 'Color', so it cannot be assigned.
// @expect-error 'bump' is a method of 'Counter', so it cannot be assigned.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'maybe' is null.
// @expect-error '?.' cannot appear on the left side of '+=', because there is nothing to write to when 'label' is null.
// @expect-error build failed with 18 problems

enum Color {
    Red,
    Green,
}

class Counter {
    protected int count = 0;

    protected constructor();

    protected bump() -> int {
        this.count = this.count + 1;
        return this.count;
    }
}

lengthOf<T>(T[] items) {
    items.length = 3;
}

names() -> string[] {
    return ["a"];
}

main() -> int {
    int x = 1;
    int[] slots = new int[2];
    string text = "ab";
    slots.length = 3;
    slots.length += 1;
    text.length = 3;
    names().length = 3;
    int[]? maybe = new int[2];
    if (maybe != null) {
        maybe.length = 3;
    }
    maybe?.length = 3;
    string? label = "ab";
    label?.length += 1;
    Color.Red = Color.Green;
    slots.length++;
    text.length--;
    Color.Red++;
    let counter = new Counter();
    counter.bump++;
    1 = 3;
    names() = ["b"];
    (x as long) = 3;
    lengthOf<int>(new int[1]);
    return 0;
}
