// 'print' and 'eprint' come from '@std.io.print' through the prelude, so a program says something
// with no import written, and a module declaring either name keeps it.
// @stdout main: no import needed
// @stdout other: through the prelude
// @stdout own: through its own print
// @stdout own: qualified
// @stderr main: on standard error
// @stderr other: through the prelude
// @exit 0
import other;
import own;

main() -> int {
    print("main: no import needed");
    eprint("main: on standard error");
    other.speak("through the prelude");
    own.speak("through its own print");
    own.print("qualified");
    return 0;
}
