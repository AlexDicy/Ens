// @exit 0
// @stdout mixed=count: 42, ok: true
// Happy path for StringBuilder: string, integer and bool appends mixed in one builder.
import StringBuilder from @std.text.stringbuilder;

main() -> int {
    let mixed = new StringBuilder();
    mixed.append("count: ");
    mixed.append(42);
    mixed.append(", ok: ");
    mixed.append(true);
    print("mixed=" + mixed.toString());
    return 0;
}
