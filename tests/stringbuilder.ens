// @exit 0
// @stdout empty=
// @stdout empty-len=0
// @stdout mixed=count: 42, ok: true
// @stdout grown-len=260
// @stdout grown-ends=xyz
// @stdout reuse=firstsecond
// Happy paths for StringBuilder: empty builder, mixed string/integer/bool
// appends, growth well past the initial capacity, and appending again after
// toString().
import StringBuilder from @std.stringbuilder;

main() -> int {
    let empty = new StringBuilder();
    print("empty=" + empty.toString());
    print("empty-len=" + empty.length());

    let mixed = new StringBuilder();
    mixed.append("count: ");
    mixed.append(42);
    mixed.append(", ok: ");
    mixed.append(true);
    print("mixed=" + mixed.toString());

    let grown = new StringBuilder();
    for (int i = 0; i < 257; i = i + 1) {
        grown.append("a");
    }
    grown.append("xyz");
    let text = grown.toString();
    print("grown-len=" + text.length);
    print("grown-ends=" + text.substring(text.length - 3, text.length));

    let reused = new StringBuilder();
    reused.append("first");
    let first = reused.toString();
    reused.append("second");
    if (first == "first") {
        print("reuse=" + reused.toString());
    }
    return 0;
}
