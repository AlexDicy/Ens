// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'held' for null first ('if (held != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'other' for null first ('if (other != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. 'later' is assigned a value of type 'string?', which can be null.
// @expect-note 'later' is assigned here
// @expect-error Variable 'count' is used before it is assigned a value. The lambda copies 'count' when it is created. The assignment 'count = 5' comes later in the same call. Assign 'count' before the call, for example 'count = 5;'.
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'listed' for null first ('if (listed != null)').
// @expect-error Variable 'total' is used before it is assigned a value. The lambda copies 'total' when it is created. The assignment 'total = 5' comes later in the same call. Assign 'total' before the call, for example 'total = 5;'.
// @expect-error Variable 'steps' is used before it is assigned a value. The lambda copies 'steps' when it is created. The assignment 'steps = 2' comes later in the same call. Assign 'steps' before the call, for example 'steps = 2;'.
// @expect-error build failed with 7 problems
// A call checks its arguments in the order it writes them, even an argument that waits for its
// parameter, such as a '{...}' literal or a lambda, and so are the elements of an array literal. So a
// write in a later argument or element reaches nothing before it, and a write in an earlier one ends
// a narrowing that the ones after it would read.

struct Count {
    long n;
}

take<T>(Count count, T value) -> long {
    return count.n;
}

apply<T, U>(() -> T body, U value) -> T {
    return body();
}

run(Count count, string? value) -> long {
    return count.n;
}

run(Count count, int value) -> long {
    return count.n;
}

countOf(string? text) -> Count {
    return { n: 1 };
}

consume(Count[] counts) -> long {
    return counts[0].n;
}

consume(long[] values) -> long {
    return values[0];
}

make(long value) -> () -> long {
    return () -> value;
}

runAll((() -> long)[] bodies) -> long {
    return bodies[0]();
}

runAll(long[] values) -> long {
    return values[0];
}

class Runner {
    protected constructor();

    protected runAll((() -> long)[] bodies) -> long {
        return bodies[0]();
    }

    protected runAll(long[] values) -> long {
        return values[0];
    }
}

pick() -> string? {
    return null;
}

laterWrite() -> long {
    string? held = pick();
    return take({ n: held.length }, held = "abc");
}

laterWriteOverloaded() -> long {
    string? other = pick();
    return run({ n: other.length }, other = "abc");
}

earlierWrite() -> long {
    string? later = "abc";
    return take({ n: (later = pick()) == null ? 0 : 1 }, later.length);
}

capturedBeforeAssigned() -> long {
    long count;
    return apply<long, long>(() -> count, count = 5);
}

laterElement() -> long {
    string? listed = pick();
    return consume([{ n: listed.length }, countOf(listed = "abc")]);
}

capturedBeforeElement() -> long {
    long total;
    return runAll([() -> total, make(total = 5)]);
}

capturedBeforeMethodElement() -> long {
    long steps;
    return new Runner().runAll([() -> steps, make(steps = 2)]);
}

main() -> int {
    return (laterWrite() + laterWriteOverloaded() + earlierWrite() + capturedBeforeAssigned() + laterElement()
        + capturedBeforeElement() + capturedBeforeMethodElement()) as int;
}
