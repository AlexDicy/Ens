// @expect-error Cannot read a member of 'string?' because it may be null here. 'later' is assigned a value of type 'string?', which can be null.
// @expect-note 'later' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'branched' for null first ('if (branched != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'armed' for null first ('if (armed != null)').
// @expect-error Variable 'chosen' is used before it is assigned a value. The lambda copies 'chosen' when it is created. The assignment 'chosen = 5' comes later in the same call. Assign 'chosen' before the call, for example 'chosen = 5;'.
// @expect-error build failed with 4 problems
// A call checks its arguments in the order it writes them, even an argument that waits for its
// parameter, such as a '{...}' literal, a lambda or a '?:' or a switch holding one. So a write in a
// later argument reaches nothing before it, and a write in an earlier one ends a narrowing that the
// ones after it would read.

struct Count {
    long n;
}

take<T>(Count count, T value) -> long {
    return count.n;
}

apply<T, U>(() -> T body, U value) -> T {
    return body();
}

run(Count count, string? value) -> long {
    return count.n;
}

run(Count count, int value) -> long {
    return count.n;
}

pick() -> string? {
    return null;
}

earlierWrite() -> long {
    string? later = "abc";
    return take({ n: (later = pick()) == null ? 0 : 1 }, later.length);
}

laterWriteInBranch(bool up) -> long {
    string? branched = pick();
    return take(up ? { n: branched.length } : { n: 0 }, branched = "abc");
}

laterWriteInOverloadedArm(long mode) -> long {
    string? armed = pick();
    return run(switch (mode) { 1 -> { n: armed.length }, default -> { n: 0 }, }, armed = "abc");
}

capturedBeforeAssignedInBranch(bool up) -> long {
    long chosen;
    return apply<long, long>(up ? () -> chosen : () -> 0, chosen = 5);
}

main() -> int {
    return (earlierWrite() + laterWriteInBranch(true) + laterWriteInOverloadedArm(1)
        + capturedBeforeAssignedInBranch(true)) as int;
}
