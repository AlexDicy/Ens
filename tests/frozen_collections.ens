// @exit 0
// @stdout 3 3 false true
// @stdout first
// @stdout 1 true
// @stdout true true
// @stdout readings 2 4
// @stdout nodes 1 7
// @stdout moved 5 6 true
// @stdout watched false 2
// @stdout held 2 3
// @stdout unhashed 0 0
// Frozen collections keep what they were frozen with and compare and hash by it, so one can be a
// key, while one over values with no hash, such as numbers with a fraction, is still a collection,
// and one over writable objects is still one within its own task. A collection nothing uses after
// 'frozen()' gives its storage to the frozen one, and one still in use is copied. One over values
// with no hash at all, such as handles or functions, is a collection too.
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import FrozenList from @std.collections.frozen;
import FrozenMap from @std.collections.frozen;
import FrozenSet from @std.collections.frozen;

external type Handle;

final class Node {
    int value = 7;
}

final class Watcher {
    weak List<int>? watched;
    List<int> held = List.of([1, 2]);
}

keyed() -> FrozenMap<string, int> {
    let map = new Map<string, int>();
    map.set("k", 1);
    return map.frozen();
}

// A weak reference sees the list end whether its storage moved or it was copied and released.
watchedFreeze(Watcher watcher) -> FrozenList<int> {
    let list = List.of([3, 4]);
    watcher.watched = list;
    return list.frozen();
}

main() -> int {
    let list = List.of([1, 2, 3]);
    let frozen = list.frozen();
    list.push(4);
    print("{frozen.length()} {frozen.get(2)} {frozen.contains(4)} "
        + "{frozen == FrozenList.of([1, 2, 3])}");
    let named = new Map<FrozenList<int>, string>();
    named.set(frozen, "first");
    print(named.get(FrozenList.of([1, 2, 3])) ?? "missing");
    let map = new Map<string, int>();
    map.set("a", 1);
    let frozenMap = map.frozen();
    print("{frozenMap.get("a") ?? -1} {frozenMap == FrozenMap.of(map)}");
    let set = Set.of(["x", "y"]);
    print("{FrozenSet.of(set).contains("y")} {FrozenSet.of(set) == FrozenSet.of(["y", "x"])}");
    let readings = FrozenList.of([1.5, 2.5]);
    double total = 0.0;
    for (let reading in readings) {
        total = total + reading;
    }
    print("readings {readings.length()} {total as int}");
    let nodes = FrozenList.of([new Node()]);
    print("nodes {nodes.length()} {nodes.get(0).value}");
    let moved = List.of([5, 6]).frozen();
    bool kept = keyed().contains("k") && Set.of(['c']).frozen().contains('c');
    print("moved {moved.get(0)} {moved.get(1)} {kept}");
    let watcher = new Watcher();
    let watched = watchedFreeze(watcher);
    print("watched {watcher.watched != null} {watched.length()}");
    let held = watcher.held.frozen();
    watcher.held.push(9);
    print("held {held.length()} {watcher.held.length()}");
    let handles = new List<Handle>().frozen();
    let actions = new List<() -> int>().frozen();
    print("unhashed {handles.length()} {actions.length()}");
    return 0;
}
