// @exit 134
// @stdout walked 1
// @stderr-contains panic: tried to keep looping over a sorted map that changed during the loop. Change the map after the loop ends, or remove entries with removeWhere()
// Inserting into a sorted map inside a walk over its keys aborts on the next step, in the map's
// own words.
import SortedMap from @std.collections.sortedmap;

main() -> int {
    let ages = new SortedMap<string, int>((a, b) -> a.compareTo(b));
    ages.set("ada", 36);
    ages.set("bob", 41);
    long walked = 0;
    for (let key in ages.keys()) {
        walked = walked + 1;
        print("walked {walked}");
        ages.set(key + "!", 1);
    }
    return 0;
}
