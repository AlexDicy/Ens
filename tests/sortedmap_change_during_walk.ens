// @exit 134
// @stdout walked 1
// @stderr-contains panic: sorted map changed during a walk: finish the walk before changing it, or use removeWhere
// Inserting into a sorted map inside a walk over its keys aborts on the next step, in the map's
// own words.
import SortedMap from @std.collections.sortedmap;

main() -> int {
    let ages = new SortedMap<string, int>((a, b) -> a.compareTo(b));
    ages.set("ada", 36);
    ages.set("bob", 41);
    long walked = 0;
    for (let key in ages.keys()) {
        walked = walked + 1;
        print("walked {walked}");
        ages.set(key + "!", 1);
    }
    return 0;
}
