// @exit 0
// @stdout 4 1
// @stdout 3
// @stdout true 7
// @stdout held 42
// @stdout plain shared
// A lambda written for a 'shared' function type captures values another task may hold, a shared
// function value is accepted where the same type without 'shared' is expected, a shared class
// may keep a shared function in a 'const' field, a generic one included, and a generic type made
// over a function type and over the same type written 'shared' is two instances.
import List from @std.collections.list;

shared final class Settings {
    const int limit;
    const shared (int) -> bool accept;

    constructor(this.limit, this.accept);
}

class Counter {
    long total;

    constructor() {
        this.total = 7;
    }

    plan() -> shared () -> long {
        long total = this.total;
        return () -> total;
    }
}

final class Holder<T> {
    const shared () -> T make;

    constructor(this.make);

    take() -> T {
        return this.make();
    }
}

later<T>(shared () -> T make) -> Holder<T> {
    return new Holder<T>(make);
}

run(shared () -> int work) -> int {
    return work();
}

plain(() -> int work) -> int {
    return work();
}

main() -> int {
    string label = "x";
    int limit = 3;
    print("{run(() -> limit + 1)} {run(() -> label.length as int)}");
    shared () -> int made = () -> limit;
    print("{plain(made)}");
    let settings = new Settings(2, (n) -> n > limit);
    print("{settings.accept(5)} {new Counter().plan()()}");
    print("held {later(() -> 41).take() + 1}");
    let plainActions = new List<(() -> string)>();
    plainActions.push(() -> "plain");
    let sharedActions = new List<(shared () -> string)>();
    sharedActions.push(() -> "shared");
    print("{plainActions.get(0)()} {sharedActions.get(0)()}");
    return 0;
}
