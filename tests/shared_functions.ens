// @exit 0
// @stdout 4 1
// @stdout 3
// @stdout true 7
// A lambda written for a 'shared' function type captures values another task may hold, a shared
// function value is accepted where the same type without 'shared' is expected, and a shared class
// may keep a shared function in a 'const' field.
shared final class Settings {
    const int limit;
    const shared (int) -> bool accept;

    constructor(this.limit, this.accept);
}

class Counter {
    long total;

    constructor() {
        this.total = 7;
    }

    plan() -> shared () -> long {
        long total = this.total;
        return () -> total;
    }
}

run(shared () -> int work) -> int {
    return work();
}

plain(() -> int work) -> int {
    return work();
}

main() -> int {
    string label = "x";
    int limit = 3;
    print("{run(() -> limit + 1)} {run(() -> label.length as int)}");
    shared () -> int made = () -> limit;
    print("{plain(made)}");
    let settings = new Settings(2, (n) -> n > limit);
    print("{settings.accept(5)} {new Counter().plan()()}");
    return 0;
}
