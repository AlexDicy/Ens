// @exit 134
// @stderr-contains panic: tried to create an array of length -1. Check that the length is at least 0
// A length below zero is refused where the array would have been allocated, and the panic names
// the length the program asked for. A panic ends the program, so this is a file of its own rather
// than another case in tests/array_oob.ens.
main() -> int {
    int[] xs = new int[-1];
    return xs.length as int;
}
