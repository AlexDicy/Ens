// @exit 42
// `this.field` narrowing on a 'const' field
class Shape {
    protected int area;
    protected constructor(this.area = 0);
}

class Drawing {
    const Shape? shape;
    protected constructor(this.shape = null);

    protected areaOrZero() -> int {
        if (this.shape != null) {
            return this.shape.area;
        }
        return 0;
    }
}

main() -> int {
    let d = new Drawing(new Shape(42));
    let empty = new Drawing();
    return d.areaOrZero() + empty.areaOrZero();
}