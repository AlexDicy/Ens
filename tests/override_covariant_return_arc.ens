// @exit 0
// @stdout cell 1
// @stdout round done
// @stdout freed 1
// @stdout cell 2
// @stdout round done
// @stdout freed 2
// @stdout narrow cell 3
// @stdout narrow done
// @stdout freed 3
// @stdout value 55
// @stdout caught derived
// @stdout end
// What a dispatch slot reads through a narrowing override still balances: the reference inside the
// struct payload the override returns is given up exactly once per round, so nothing leaks and
// nothing is released twice. Both edges to the slot are walked with a live reference in the
// payload: through the declaring type, where the slot's shape is what the caller expected, and
// through the overriding type, where the caller expected the narrowed shape and unwraps what the
// slot handed back. A throwing override on the same slot reports through the error slot the
// declaration owns, so the value converts on the normal path and the error still reaches the
// caller's 'catch' on the other.
class Cell {
    protected int value;

    protected constructor(this.value);

    destructor() {
        print("freed " + this.value);
    }

    protected read() -> int {
        return this.value;
    }
}

struct Holder {
    protected Cell item;

    protected show() -> string {
        return "cell " + this.item.read();
    }
}

class Picker {
    protected constructor();

    protected pick(int tag) -> Holder? {
        return null;
    }
}

class Filling extends Picker {
    protected constructor();

    protected override pick(int tag) -> Holder {
        Holder held = {item: new Cell(tag)};
        return held;
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Source {
    protected constructor();

    protected load(bool fail) -> long? throws {
        if (fail) {
            throw new Failure("base");
        }
        return null;
    }
}

class Loading extends Source {
    protected constructor();

    protected override load(bool fail) -> long throws {
        if (fail) {
            throw new Failure("derived");
        }
        return 55;
    }
}

class Runner {
    protected constructor();

    protected show(Source source, bool fail) -> string {
        let value = try source.load(fail);
        if (value == null) {
            return "null";
        }
        return "value " + value;
    } catch (Failure failure) {
        return "caught " + failure.message;
    }
}

// Through the overriding type, so the caller was checked at the narrowed 'Holder' while the slot
// it reads still answers at 'Holder?'. What the slot handed back is given up when this returns.
reportNarrowed(Filling filling, int tag) {
    let narrowed = filling.pick(tag);
    print("narrow " + narrowed.show());
    print("narrow done");
}

main() -> int {
    Picker picker = new Filling();
    for (int round = 1; round <= 2; round++) {
        let picked = picker.pick(round);
        if (picked == null) {
            print("pick null");
        } else {
            print(picked.show());
        }
        print("round done");
    }

    reportNarrowed(new Filling(), 3);

    Source source = new Loading();
    let runner = new Runner();
    print(runner.show(source, false));
    print(runner.show(source, true));
    print("end");
    return 0;
}
