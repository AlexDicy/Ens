// @expect-error Literal 18446744073709551615L does not fit in 'long' (range -9223372036854775808..9223372036854775807); declare 'ulong' to hold it.
// An 'L' suffix makes the literal a 'long', so the value has to fit a long; the unsigned form
// of the same width is what holds this one.
main() -> int {
    let beyondLong = 18446744073709551615L;
    return beyondLong as int;
}
