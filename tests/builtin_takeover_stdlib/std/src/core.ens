// The stand-in '@std.core' the take-over fixtures are compiled against: every program loads this
// module, so it carries the two shapes the compiler resolves by name, plus a 'print' of its
// own. The real one is libs/std/src/core.ens, which declares no functions yet.
import @std.emit;

export struct StackFrame {
    export const string function;
    export const string file;
    export const int line;
}

export class Error {
    export string message;

    long[]? frames;

    export constructor(this.message);

    export stackTrace() -> string {
        return "";
    }

    export stackFrames() -> StackFrame[] {
        return [];
    }
}

// A library module declaring the name the language provides, and exporting it. Every call in this
// module reaches this declaration, and another package reaches it by qualifying the call.
export print(string message) {
    emit.line("core: " + message);
}

// A prelude function whose own 'print' call goes to the declaration above, which is how a call
// written in another module reaches the library's version.
export announce(string message) {
    print(message);
}
