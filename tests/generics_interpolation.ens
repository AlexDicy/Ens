// @exit 0
// @stdout value is 42
// @stdout value is 9000000000
// @stdout value is true
// @stdout value is hello
// @stdout value is Green
// @stdout box of 7
// @stdout box of tools
// @stdout value is hi
// @stdout value is null
// @stdout value is 7
// @stdout value is null
// @stdout value is Green
// @stdout value is null
// @stdout value is {"x": 3}
// @stdout value is null
// @stdout value is cell 4
// @stdout value is null
// @stdout box of hi
// @stdout box of null
// @stdout here is hi and null
// Interpolating a generic type parameter resolves per instantiation, so integers, bools, strings
// and enums all render through the same hole. One nullable level renders the value's own text or
// 'null', however the hole came to be nullable.
enum Color { Red, Green, Blue, }

struct Point {
    protected int x;
}

class Cell {
    protected int id;

    protected constructor(this.id);

    protected override toString() -> string {
        return "cell {this.id}";
    }
}

class Box<T> {
    T item;
    protected constructor(T value) { this.item = value; }
    protected label() -> string { return "box of {this.item}"; }
}

describe<T>(T value) -> string {
    return "value is {value}";
}

maybeText(bool wanted) -> string? {
    if (wanted) {
        return "hi";
    }
    return null;
}

maybeNumber(bool wanted) -> int? {
    if (wanted) {
        return 7;
    }
    return null;
}

maybeColor(bool wanted) -> Color? {
    if (wanted) {
        return Color.Green;
    }
    return null;
}

maybePoint(bool wanted) -> Point? {
    if (wanted) {
        return {x: 3};
    }
    return null;
}

maybeCell(bool wanted) -> Cell? {
    if (wanted) {
        return new Cell(4);
    }
    return null;
}

main() -> int {
    print(describe(42));
    print(describe(9000000000L));
    print(describe(true));
    print(describe("hello"));
    print(describe(Color.Green));
    print(new Box<int>(7).label());
    print(new Box<string>("tools").label());
    print(describe<string?>(maybeText(true)));
    print(describe<string?>(maybeText(false)));
    print(describe<int?>(maybeNumber(true)));
    print(describe<int?>(maybeNumber(false)));
    print(describe<Color?>(maybeColor(true)));
    print(describe<Color?>(maybeColor(false)));
    print(describe<Point?>(maybePoint(true)));
    print(describe<Point?>(maybePoint(false)));
    print(describe<Cell?>(maybeCell(true)));
    print(describe<Cell?>(maybeCell(false)));
    print(new Box<string?>(maybeText(true)).label());
    print(new Box<string?>(maybeText(false)).label());
    print("here is {maybeText(true)} and {maybeCell(false)}");
    return 0;
}
