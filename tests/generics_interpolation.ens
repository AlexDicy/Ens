// @exit 0
// @stdout value is 42
// @stdout value is 9000000000
// @stdout value is true
// @stdout value is hello
// @stdout value is Green
// @stdout box of 7
// @stdout box of tools
// Interpolating a generic type parameter resolves per instantiation:
// integers, bools, strings, and enums all render through the same hole.
enum Color { Red, Green, Blue, }

class Box<T> {
    private T item;
    Box(T value) { this.item = value; }
    label() -> string { return "box of {this.item}"; }
}

describe<T>(T value) -> string {
    return "value is {value}";
}

main() -> int {
    print(describe(42));
    print(describe(9000000000L));
    print(describe(true));
    print(describe("hello"));
    print(describe(Color.Green));
    print(new Box<int>(7).label());
    print(new Box<string>("tools").label());
    return 0;
}
