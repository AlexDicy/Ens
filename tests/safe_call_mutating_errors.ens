// @expect-error Method 'peek' of struct 'Pair' changes the struct it is called on, so it must be marked 'mutating'. Write 'mutating' before 'peek'.
// @expect-note 'bump' is 'mutating' and is called on 'this.first' here
// @expect-error Cannot call 'bump' on 'makeCounter()', because 'makeCounter()' is not a variable, a field or an array element. 'bump' is 'mutating', which marks a method that changes the struct it is called on, so the change would be lost. Store the value in a local first, as in 'let value = makeCounter();', and call 'bump' on the local, as in 'value?.bump();'.
// @expect-error Cannot call 'bump' on 'makeOuter()?.inner', because it is part of 'makeOuter()', which is not a variable, a field or an array element. 'bump' is 'mutating', which marks a method that changes the struct it is called on, so the change would be lost. A struct's fields are part of its value. Store 'makeOuter()' in a local first, as in 'let value = makeOuter();', and call 'bump' on 'value?.inner'.
// @expect-error Cannot call 'bump' on '(makeOuter())?.inner', because it is part of 'makeOuter()', which is not a variable, a field or an array element. 'bump' is 'mutating', which marks a method that changes the struct it is called on, so the change would be lost. A struct's fields are part of its value. Store 'makeOuter()' in a local first, as in 'let value = makeOuter();', and call 'bump' on 'value?.inner'.
// @expect-error Cannot call 'bump' on 'fixed', because 'fixed' is declared 'const'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Remove 'const' from the declaration of 'fixed' if it needs to change.
// @expect-error Cannot call 'bump' on 'fixedOuter?.inner', because it is part of 'fixedOuter', which is declared 'const'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. A struct's fields are part of its value. Remove 'const' from the declaration of 'fixedOuter' if it needs to change.
// @expect-error Cannot call 'bump' on 'holder.kept', because field 'kept' is 'const'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Remove 'const' from the field if it needs to change.
// @expect-error Cannot call 'bump' on 'holder.outer?.fixed', because field 'fixed' is 'const'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Remove 'const' from the field if it needs to change.
// @expect-error Cannot call 'bump' on 'Settings.counter', because 'Settings.counter' is a lazy const. 'bump' is 'mutating', which marks a method that changes the struct it is called on. A lazy const keeps the value its initializer gives it. Change the initializer, or copy the value into a variable and call 'bump' on the copy, as in 'let counter = Settings.counter;'.
// @expect-error Cannot call 'bump' on 'Settings.outer?.inner', because it is part of the lazy const 'Settings.outer'. 'bump' is 'mutating', which marks a method that changes the struct it is called on. A struct's fields are part of its value. A lazy const keeps the value its initializer gives it. Change the initializer, or copy the value into a variable and call 'bump' on the copy, as in 'let outer = Settings.outer;' and then 'outer?.inner?.bump();'.
// @expect-error Cannot call 'bump' on 'captured' inside a lambda. 'bump' is 'mutating', which marks a method that changes the struct it is called on. A lambda works on copies of what it captures, so the 'captured' outside it would not change. Return the value the lambda computes and store it where the lambda is called, or keep the value in a field of an object the lambda uses.
// @expect-error Cannot call 'bump' on 'cell', because 'cell' is a copy of an element of 'cells', so 'cells' would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Loop over the indexes of 'cells', as in 'for (long i = 0; i < cells.length; i++)', and write 'cells[i]' instead of 'cell'.
// @expect-error Cannot call 'bump' on 'each?.inner', because 'each' is a copy of an element of 'outers', so 'outers' would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Loop over the indexes of 'outers', as in 'for (long i = 0; i < outers.length; i++)', and write 'outers[i]' instead of 'each'.
// @expect-error build failed with 13 problems
// A 'mutating' method called through '?.' is refused wherever the same call written with '.' on a
// plain struct is: on a value a call returns or a field of one, a 'const' local or field, a lazy
// const, a struct a lambda captured, the variable of a for-each loop, and 'this' in a method that
// is not 'mutating', at whichever link of a '?.' chain the reason is.
struct Counter {
    int value;

    mutating bump() {
        this.value += 1;
    }
}

struct Outer {
    Counter? inner;
    const Counter? fixed;
}

struct Pair {
    Counter? first;

    peek() {
        this.first?.bump();
    }
}

class Holder {
    const Counter? kept = null;
    Outer? outer = null;
}

class Settings {
    lazy const Counter? counter = {value: 0};
    lazy const Outer? outer = null;
}

makeCounter() -> Counter? {
    return null;
}

makeOuter() -> Outer? {
    return null;
}

refused(Holder holder, Counter?[] cells, Outer?[] outers) {
    makeCounter()?.bump();
    makeOuter()?.inner?.bump();
    (makeOuter())?.inner?.bump();
    const Counter? fixed = {value: 0};
    fixed?.bump();
    const Outer? fixedOuter = null;
    fixedOuter?.inner?.bump();
    holder.kept?.bump();
    holder.outer?.fixed?.bump();
    Settings.counter?.bump();
    Settings.outer?.inner?.bump();
    Counter? captured = {value: 0};
    () -> void later = () -> {
        captured?.bump();
    };
    later();
    for (let cell in cells) {
        cell?.bump();
    }
    for (let each in outers) {
        each?.inner?.bump();
    }
}

main() {
    refused(new Holder(), [], []);
}
