// The stand-in '@std.core' the primitive-binding fixtures are compiled against: every program
// loads this module, so it carries the two class shapes the compiler resolves by name and nothing
// else. The real one is libs/std/src/core.ens.
export class StackFrame {
    export string function;
    export string file;
    export int line;

    export constructor(this.function, this.file, this.line);
}

export class Error {
    export string message;

    long[]? frames;

    export constructor(this.message);

    export stackTrace() -> string {
        return "";
    }

    export stackFrames() -> StackFrame[] {
        return [new StackFrame("", "", 0)];
    }
}
