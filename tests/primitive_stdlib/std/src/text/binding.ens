// What the fixtures reach for: bindings that declare members on 'string' and on two numeric
// primitives, and the interface two of them conform to. The tree's own standard library cannot
// carry a binding until the seed that understands 'primitive' is released, so the fixtures compile
// against this stand-in instead.
export interface Measured {
    size() -> long;
}

export interface Scaled extends Measured {
    scaled(long factor) -> long;
}

primitive string implements Scaled {
    export isEmpty() -> bool {
        return this.length == 0;
    }

    export override size() -> long {
        return this.length;
    }

    export override scaled(long factor) -> long {
        return this.size() * factor;
    }

    export repeated(long times) -> string {
        string built = "";
        for (long i = 0; i < times; i++) {
            built = built + this;
        }
        return built;
    }

    export repeated() -> string {
        return this.repeated(2L);
    }

    export static joined(string left, string right) -> string {
        return left + right;
    }

    public inPackageOnly() -> long {
        return this.length + 1;
    }
}

primitive long implements Scaled {
    export override size() -> long {
        return this;
    }

    export override scaled(long factor) -> long {
        return this * factor;
    }
}

primitive bool {
    export flipped() -> bool {
        return !this;
    }
}
