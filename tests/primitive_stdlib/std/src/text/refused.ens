// Primitive bindings written wrong, in one standard-library module the error fixture imports.
// Nothing else imports it, so the fixtures that expect a clean build never load these
// declarations.
export interface Crasher {
    noreturn crash();
}

export interface Shown {
    toString() -> string;
}

primitive long implements Crasher {
    export override crash() {
        return;
    }
}

primitive double implements Shown {
}
