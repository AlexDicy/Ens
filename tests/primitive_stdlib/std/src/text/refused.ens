// Every way a primitive binding is written wrong, in one standard-library module the error
// fixture imports. Nothing else imports it, so the fixtures that expect a clean build never load
// these declarations.
export interface Refused {
    wanted() -> long;
}

export class Widget {
}

primitive Widget {
}

primitive void {
}

primitive decimal {
}

primitive char implements Widget {
}

primitive int implements Refused {
    export named() -> long {
        return this;
    }

    export override unrelated() -> long {
        return this;
    }
}

primitive ushort implements Refused {
    export wanted() -> long {
        return this;
    }
}

primitive string {
    export length() -> long {
        return 0;
    }

    export toString() -> string {
        return "";
    }

    long count;

    static const long limit = 4;

    export constructor();

    destructor() {
    }

    export abstract missing() -> long;

    export bodiless() -> long;

    export byteAt(long index) -> long;

    export final fixed() -> long {
        return 0;
    }
}

primitive float {
}

primitive float {
}

export interface Crasher {
    noreturn crash();
}

export interface Shown {
    toString() -> string;
}

primitive long implements Crasher {
    export override crash() {
        return;
    }
}

primitive double implements Shown {
}
