// @expect-error In 'allocate<Path>': Cannot use 'Path' as an array element type because freshly-allocated slots would not be valid values of 'Path'. Field 'text' of 'Path' is 'const' with no default value
// @expect-error build failed with 2 problems
// A 'new T[n]' in a dependency's generic body is judged for the argument a consuming package
// supplies: 'Slots<Path>' is reached only through 'Outer<Path>', and 'allocate<Path>' is a generic
// function of the dependency. The proven fill loop of 'Filled' and of 'List.toArray' is exempt.
import Outer from @acme.slots.slots;
import Filled from @acme.slots.slots;
import @acme.slots.slots;
import List from @std.collections.list;

public struct Path {
    public const string text;
}

main() -> int {
    let outer = new Outer<Path>(3);
    let filled = new Filled<Path>({text: "a"}, 3);
    Path[] raw = slots.allocate<Path>(2);
    let paths = new List<Path>();
    paths.push({text: "b"});
    Path[] copied = paths.toArray();
    return (outer.count() + filled.count() + raw.length + copied.length) as int;
}
