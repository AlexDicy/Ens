// @exit 0
// @stdout held alive
// @stdout base-field dead
// @stdout derived-field dead
// @stdout loop dead

class Payload {
    int tag;
    protected constructor(this.tag);
}

class Watcher {
    protected weak Payload? target;
}

abstract class Keeper<T> {
    protected abstract read() -> T;
}

class BaseHolder<T> extends Keeper<T> {
    T kept;
    protected constructor(this.kept);
    protected override read() -> T { return this.kept; }
}

class DerivedHolder<T> extends BaseHolder<T> {
    T extra;
    protected constructor(T kept, T extra) {
        super(kept);
        this.extra = extra;
    }
    protected readExtra() -> T { return this.extra; }
}

main() -> int {
    let watcher = new Watcher();

    if (true) {
        let holder = new BaseHolder<Payload>(new Payload(1));
        watcher.target = holder.read();
        if (watcher.target != null) { print("held alive"); }
    }
    if (watcher.target == null) { print("base-field dead"); }

    if (true) {
        let derived = new DerivedHolder<Payload>(new Payload(2), new Payload(3));
        watcher.target = derived.readExtra();
    }
    if (watcher.target == null) { print("derived-field dead"); }

    let i = 0;
    while (i < 3) {
        Keeper<Payload> keeper = new BaseHolder<Payload>(new Payload(4));
        watcher.target = keeper.read();
        i = i + 1;
    }
    if (watcher.target == null) { print("loop dead"); }

    return 0;
}
