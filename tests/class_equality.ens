// @exit 0
// @stdout eq content
// @stdout ne content
// @stdout eq identity
// @stdout null presence ok
// @stdout set-dedup 2
// @stdout inherited eq
// @stdout generic eq content
// @stdout generic set-dedup 2

import Set from @std.collections.set;

class Point {
    int x;
    int y;
    protected constructor(this.x, this.y);
    override hash() -> long { return this.x * 31 + this.y; }
    override equals(Point other) -> bool { return this.x == other.x && this.y == other.y; }
}

// A subclass that adds no state inherits both hash() and equals(), so '=='
// still compares by content and dispatches to the inherited method.
class Pixel extends Point {
    protected constructor(int x, int y) {
        super(x, y);
    }
}

// A generic class names its own type with its type parameters, so its 'equals' takes a 'Slot<T>'.
// Only 'id' decides, so two slots with different payloads still compare equal.
class Slot<T> {
    int id;
    T payload;

    protected constructor(this.id, this.payload);

    override hash() -> long {
        return this.id;
    }

    override equals(Slot<T> other) -> bool {
        return this.id == other.id;
    }
}

main() -> int {
    let a = new Point(1, 2);
    let b = new Point(1, 2);
    let c = new Point(3, 4);

    if (a == b) { print("eq content"); }
    if (a != c) { print("ne content"); }
    if (a == a) { print("eq identity"); }

    // A 'null' literal operand stays a presence check; comparing a value
    // against a null reference is not equal and never calls equals().
    Point? missing = null;
    if (missing == null && a != missing && !(a == missing)) {
        print("null presence ok");
    }

    let seen = new Set<Point>();
    seen.add(new Point(5, 5));
    seen.add(new Point(5, 5));
    seen.add(new Point(6, 6));
    if (seen.length() == 2 && seen.contains(new Point(5, 5))) {
        print("set-dedup 2");
    }

    Point p = new Pixel(7, 8);
    Point q = new Pixel(7, 8);
    if (p == q) { print("inherited eq"); }

    let first = new Slot<string>(1, "a");
    let second = new Slot<string>(1, "b");
    let third = new Slot<string>(2, "a");
    if (first == second && first != third) {
        print("generic eq content");
    }

    let slots = new Set<Slot<string>>();
    slots.add(first);
    slots.add(second);
    slots.add(third);
    if (slots.length() == 2 && slots.contains(new Slot<string>(2, "c"))) {
        print("generic set-dedup 2");
    }

    return 0;
}
