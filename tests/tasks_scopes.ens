// @exit 0
// @stdout 5 6
// @stdout caught could not parse 'bad'
// @stdout launched 8
// @stdout stopped: the task was cancelled
// @stdout shared twice
// @stdout dedicated 3 2 1
// Tasks started in a scope run at once and are awaited for what their bodies return or throw, a
// launched task is waited for when the scope ends, a cancelled scope stops a task that checks, and
// a result another task may hold is given to every awaiter. A dedicated task runs at the priority it
// asks for wherever the system allows it, and runs either way.
import @std.tasks;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import Task from @std.tasks;
import TaskPriority from @std.tasks;

class ParseError extends Error {
    constructor(string message) {
        super(message);
    }
}

parse(string text) -> int throws ParseError {
    if (text == "bad") {
        throw new ParseError("could not parse '{text}'");
    }
    return text.length as int;
}

loadBoth(string first, string second) -> int[] throws ParseError {
    return try tasks.scope((scope) -> {
        let parsing = scope.start(() -> try parse(first));
        let other = scope.start(() -> try parse(second));
        return [try parsing.await(), try other.await()];
    });
}

untilCancelled() -> int throws Cancelled {
    while (true) {
        try tasks.checkCancelled();
        tasks.sleep(1);
    }
    return 0;
}

outcome(Task<(() -> int throws Cancelled)> task) -> string {
    return "value {try task.await()}";
} catch (Cancelled stop) {
    return "stopped: {stop.message}";
}

loaded(string first, string second) -> string {
    let both = try loadBoth(first, second);
    return "{both[0]} {both[1]}";
} catch (ParseError error) {
    return "caught {error.message}";
}

main() -> int {
    print(loaded("hello", "worlds"));
    print(loaded("bad", "fine"));
    let counter = new Atomic<int>(0);
    tasks.scope((scope) -> {
        for (int i = 0; i < 8; i++) {
            scope.launch(() -> {
                counter.increment();
            });
        }
    });
    print("launched {counter.read()}");
    print(tasks.scope((scope) -> {
        let waiting = scope.start(() -> try untilCancelled());
        scope.cancel();
        return outcome(waiting);
    }));
    print(tasks.scope((scope) -> {
        let named = scope.start(() -> "shared");
        return named.await() + " " + (named.await() == "shared" ? "twice" : "once");
    }));
    print(tasks.scope((scope) -> {
        let realtime = scope.startDedicated(TaskPriority.Realtime, () -> 3);
        let high = scope.startDedicated(TaskPriority.High, () -> 2);
        let normal = scope.startDedicated(TaskPriority.Normal, () -> 1);
        return "dedicated {realtime.await()} {high.await()} {normal.await()}";
    }));
    return 0;
}
