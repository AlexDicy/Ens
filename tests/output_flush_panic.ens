// @exit 0
// @stdout the printed line came first
// A panic reports on standard error, which is never buffered, while a printed line waits in the
// buffer of a standard output that is a file. With both streams pointed at one file, the printed
// line has to come first, which holds only if the runtime flushes before it reports the panic.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Platform from @std.environment;
import @std.environment;
import ProcessError from @std.process;
import @std.process;

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length > 0) {
        print("the child printed this");
        panic("the child stopped here");
    }
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("output_flush_panic: this system would not report the path of this program");
        return 1;
    }
    Path merged = (self.parent() ?? Path(".")).join("output_flush_panic.merged");
    let ran = try process.runShell("\"" + shellPath(self) + "\" child > \""
        + shellPath(merged) + "\" 2>&1");
    string[] lines = (try merged.readText()).lines();
    try merged.removeFile();
    long printed = lineHolding(lines, "the child printed this");
    long reported = lineHolding(lines, "panic: the child stopped here");
    if (printed < 0 || reported < 0) {
        eprint("output_flush_panic: the child wrote " + string.joined(lines, " / "));
        return 1;
    }
    if (printed > reported) {
        eprint("output_flush_panic: the panic was reported before the printed line");
        return 1;
    }
    print("the printed line came first");
    return 0;
} catch (ProcessError e) {
    eprint("output_flush_panic: {e.message}");
    return 1;
} catch (FileSystemError e) {
    eprint("output_flush_panic: {e.message}");
    return 1;
}

// A path as the platform's own command interpreter reads it: cmd.exe takes '\' between the parts of
// a program's path and refuses the '/' every path here carries, while every other shell takes the
// path exactly as it is.
shellPath(Path target) -> string {
    if (environment.platform() != Platform.Windows) {
        return target.toString();
    }
    return target.toString().replace("/", "\\");
}

// Which line holds the text, or -1 when none of them does.
lineHolding(string[] lines, string text) -> long {
    for (long i = 0; i < lines.length; i++) {
        if (lines[i].contains(text)) {
            return i;
        }
    }
    return -1;
}
