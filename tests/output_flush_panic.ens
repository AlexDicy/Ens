// @exit 0
// @stdout the printed line came first
// A panic reports on standard error, which is never buffered, while a printed line waits in the
// buffer of a standard output that is a file. With both streams pointed at one file, the printed
// line has to come first, which holds only if the runtime flushes before it reports the panic.
import @std.system;
import SystemError from @std.system;
import @std.path;

main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length > 1) {
        print("the child printed this");
        panic("the child stopped here");
    }
    string self = system.executablePath();
    string merged = path.join(path.parentFolder(self), "output_flush_panic.merged");
    let ran = try system.run(shellCommand("\"" + shellPath(self) + "\" child > \""
        + shellPath(merged) + "\" 2>&1"));
    string[] lines = (try system.readAllText(merged)).lines();
    try system.removeFile(merged);
    long printed = lineHolding(lines, "the child printed this");
    long reported = lineHolding(lines, "panic: the child stopped here");
    if (printed < 0 || reported < 0) {
        system.writeError("output_flush_panic: the child wrote "
            + string.joined(lines, " / "));
        return 1;
    }
    if (printed > reported) {
        system.writeError("output_flush_panic: the panic was reported before the printed line");
        return 1;
    }
    print("the printed line came first");
    return 0;
} catch (SystemError e) {
    system.writeError("output_flush_panic: {e.message}");
    return 1;
}

// A command line as the platform's own interpreter reads it. cmd.exe drops the outermost pair of
// quotes from what it is handed, which would break a command whose first word is a quoted path, so
// one more pair goes around the whole line there.
shellCommand(string line) -> string {
    if (system.platform() != "windows") {
        return line;
    }
    return "\"" + line + "\"";
}

// A path as the platform's own command interpreter reads it: cmd.exe takes '\' between the parts of
// a program's path and refuses the '/' every '@std' path carries, while every other shell takes the
// path exactly as it is.
shellPath(string target) -> string {
    if (system.platform() != "windows") {
        return target;
    }
    byte[] raw = target.toBytes();
    byte[] native = new byte[raw.length];
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '/') {
            native[i] = '\\';
        } else {
            native[i] = raw[i];
        }
    }
    return string.fromBytesLossy(native);
}

// Which line holds the text, or -1 when none of them does.
lineHolding(string[] lines, string text) -> long {
    for (long i = 0; i < lines.length; i++) {
        if (lines[i].contains(text)) {
            return i;
        }
    }
    return -1;
}
