// The stream bridges the compiler synthesizes wherever they are named, declared here because
// nothing in the standard library reaches them yet. A path is opened through the file bridge that
// already exists, since a stream has to come from somewhere before it can be written to.
import TestFailure from @std.testing;

// An open stream, which the bridges below write, read, flush and give back.
public external type Stream;

external from libc {
    ens_fs_open(string path, int mode, out int error) -> Stream?;
    ens_stream_write(Stream handle, byte[] data, long count, out long written) -> int;
    ens_stream_read(Stream handle, byte[] buffer, long capacity, out long count) -> int;
    ens_stream_flush(Stream handle) -> int;
    ens_stream_close(Stream handle) -> int;
    ens_io_error_kind(int code) -> int;
}

// What a path is opened for, in the numbers the file bridge reads.
public final class OpenMode {
    public static const int reading = 0;
    public static const int fromEmpty = 1;
    public static const int atTheEnd = 2;
}

// The std.io.streams ErrorKind ordinals the classifier answers with.
public final class IoErrorKind {
    public static const int closed = 0;
    public static const int interrupted = 1;
    public static const int other = 2;
}

// How much a call moved, and why it did not move all of it. A `code` of 0 means the call did what
// it was asked, and any other value is the C library's own number.
public struct Moved {
    public const int code;
    public const long count;
}

// The stream a path was opened on, or the platform's own error number for why it was not.
public struct Opened {
    public const Stream? handle;
    public const int code;
}

public opened(string path, int mode) -> Opened {
    int code = 0;
    Stream? handle = ens_fs_open(path, mode, out code);
    Opened answer = {handle: handle, code: code};
    return answer;
}

// The stream a path was opened on, with a path that would not open reported as this fixture's own
// failure. Every test here needs a stream before it can exercise one, so none of them says what to
// do when there is none.
public mustOpen(string path, int mode) -> Stream throws TestFailure {
    let attempt = opened(path, mode);
    Stream? handle = attempt.handle;
    if (handle == null) {
        throw new TestFailure("'{path}' could not be opened in mode {mode}: the system reported "
            + "error {attempt.code}");
    }
    return handle;
}

public written(Stream handle, byte[] data) -> Moved {
    long count = 0;
    int code = ens_stream_write(handle, data, data.length, out count);
    Moved answer = {code: code, count: count};
    return answer;
}

public read(Stream handle, byte[] buffer) -> Moved {
    long count = 0;
    int code = ens_stream_read(handle, buffer, buffer.length, out count);
    Moved answer = {code: code, count: count};
    return answer;
}

public flushed(Stream handle) -> int {
    return ens_stream_flush(handle);
}

public closed(Stream handle) -> int {
    return ens_stream_close(handle);
}

public kindOf(int code) -> int {
    return ens_io_error_kind(code);
}
