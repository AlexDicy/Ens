// The two tables an errno becomes: the stream condition a program acts on, and the file-system kind
// the same number means when the failure was a file's. Both are fed by the C library's own numbers,
// so the shared set is assertable from any host rather than one platform at a time.
import @std.testing;
import Platform from @std.environment;
import @std.environment;
import FsErrorKind from bridges;
import IoErrorKind from bridges;
import bridges;

// A pipe whose reader has gone is EPIPE wherever the runtime ignores SIGPIPE, which it does before
// any user code runs, so this is the one number the library promises a stream reports as Closed.
test "a pipe with nothing reading it classifies as Closed" {
    try testing.assertEqual(bridges.kindOf(32), IoErrorKind.closed);
}

test "a call the system cut short classifies as Interrupted" {
    try testing.assertEqual(bridges.kindOf(4), IoErrorKind.interrupted);
}

// Each of these has more than one cause, so none of them establishes a stream condition. A stream
// that a program closed and a stream opened to read alone both answer EBADF, and a full file system
// is what a stream is a stream of rather than anything about the stream.
test "a number with more than one cause classifies as Other" {
    try testing.assertEqual(bridges.kindOf(9), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(28), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(5), IoErrorKind.other);
}

test "a number no stream call reports classifies as Other" {
    try testing.assertEqual(bridges.kindOf(0), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(-1), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(65535), IoErrorKind.other);
}

// The classifier is a pure function of its number, so the same number answers the same kind however
// often it is asked and whatever ran in between.
test "the same number classifies the same way every time" {
    for (long attempt = 0; attempt < 3; attempt++) {
        try testing.assertEqual(bridges.kindOf(32), IoErrorKind.closed);
        try testing.assertEqual(bridges.kindOf(4), IoErrorKind.interrupted);
        try testing.assertEqual(bridges.kindOf(9), IoErrorKind.other);
    }
}

// Every C library numbers these the same, so what they mean for a file holds on every host.
test "the file-system table maps the numbers every library agrees on" {
    try testing.assertEqual(bridges.fileKindOf(2), FsErrorKind.notFound);
    try testing.assertEqual(bridges.fileKindOf(1), FsErrorKind.permissionDenied);
    try testing.assertEqual(bridges.fileKindOf(13), FsErrorKind.permissionDenied);
    try testing.assertEqual(bridges.fileKindOf(30), FsErrorKind.permissionDenied);
    try testing.assertEqual(bridges.fileKindOf(17), FsErrorKind.alreadyExists);
    try testing.assertEqual(bridges.fileKindOf(20), FsErrorKind.notADirectory);
    try testing.assertEqual(bridges.fileKindOf(21), FsErrorKind.isADirectory);
    try testing.assertEqual(bridges.fileKindOf(28), FsErrorKind.noSpace);
}

// A full directory is the one kind each library numbers for itself, so this host's own number is
// the one its table has to carry.
test "the file-system table maps this library's own number for a full directory" {
    int full = 39;
    if (environment.platform() == Platform.Windows) {
        full = 41;
    }
    if (environment.platform() == Platform.MacOS) {
        full = 66;
    }
    try testing.assertEqual(bridges.fileKindOf(full), FsErrorKind.directoryNotEmpty);
}

// A stream failure that is nothing about the file system reaches a caller as an Other, which is
// what keeps a named kind from being claimed for a number that does not establish it.
test "a number that names no file-system condition classifies as Other" {
    try testing.assertEqual(bridges.fileKindOf(0), FsErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(4), FsErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(5), FsErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(9), FsErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(32), FsErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(65535), FsErrorKind.other);
}

// The two classifiers read one numbering space and answer for different things, so a number that
// means something to both has to reach each of them with its own kind.
test "one number means a stream condition and a file-system kind at once" {
    try testing.assertEqual(bridges.kindOf(32), IoErrorKind.closed);
    try testing.assertEqual(bridges.fileKindOf(32), FsErrorKind.other);
    try testing.assertEqual(bridges.kindOf(28), IoErrorKind.other);
    try testing.assertEqual(bridges.fileKindOf(28), FsErrorKind.noSpace);
}
