// The table an errno becomes. The bridge answers the same table on every target, because the calls
// feeding it are the C library's own and so report the C library's own numbers, which is what makes
// these numbers assertable from any host rather than one platform at a time.
import @std.testing;
import IoErrorKind from bridges;
import bridges;

// A pipe whose reader has gone is EPIPE wherever the runtime ignores SIGPIPE, which it does before
// any user code runs, so this is the one number the library promises a stream reports as Closed.
test "a pipe with nothing reading it classifies as Closed" {
    try testing.assertEqual(bridges.kindOf(32), IoErrorKind.closed);
}

test "a call the system cut short classifies as Interrupted" {
    try testing.assertEqual(bridges.kindOf(4), IoErrorKind.interrupted);
}

// Each of these has more than one cause, so none of them establishes a stream condition. A stream
// that a program closed and a stream opened to read alone both answer EBADF, and a full file system
// is what a stream is a stream of rather than anything about the stream.
test "a number with more than one cause classifies as Other" {
    try testing.assertEqual(bridges.kindOf(9), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(28), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(5), IoErrorKind.other);
}

test "a number no stream call reports classifies as Other" {
    try testing.assertEqual(bridges.kindOf(0), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(-1), IoErrorKind.other);
    try testing.assertEqual(bridges.kindOf(65535), IoErrorKind.other);
}

// The classifier is a pure function of its number, so the same number answers the same kind however
// often it is asked and whatever ran in between.
test "the same number classifies the same way every time" {
    for (long attempt = 0; attempt < 3; attempt++) {
        try testing.assertEqual(bridges.kindOf(32), IoErrorKind.closed);
        try testing.assertEqual(bridges.kindOf(4), IoErrorKind.interrupted);
        try testing.assertEqual(bridges.kindOf(9), IoErrorKind.other);
    }
}
