// A lambda or a '{...}' literal written as a branch of a '?:' or an arm of a switch takes its type from
// the parameter, the return type or the declared type the whole value goes to, in a call to one
// function, to overloads or to a generic function, whose type arguments the values with a type of
// their own show, also inside an array literal. With no context type, such a value takes the type the
// other values join to, which are analyzed first.
// @exit 0
// @stdout run:4
// @stdout run:6
// @stdout single:4
// @stdout pair:7
// @stdout method:12
// @stdout method:9
// @stdout named:5
// @stdout generic:8
// @stdout generic:3
// @stdout point:3
// @stdout point:7
// @stdout returned:11
// @stdout returned:2
// @stdout initialized:20 1
// @stdout offered:2 2
// @stdout offered:5 2
// @stdout fallback:10
// @stdout captured:5
// @stdout narrowed:3
// @stdout joined:6 9 4 3
// @stdout armed:10 6
// @stdout struct:1 2 7
// @stdout array:2 0
struct Point {
    int x;
    int y;
}

run((int) -> int step) -> string {
    return "run:{step(3)}";
}

combine((int) -> int step) -> string {
    return "single:{step(3)}";
}

combine((int, int) -> int join) -> string {
    return "pair:{join(3, 4)}";
}

place(Point point) -> string {
    return "point:{point.x + point.y}";
}

place(string text) -> string {
    return "text:{text}";
}

pick<T>(T value, (T) -> T change) -> T {
    return change(value);
}

measure(string label, () -> long length) -> string {
    return "{label}:{length()}";
}

count<T>(T[] values) -> long {
    return values.length;
}

same<T>(T value) -> T {
    return value;
}

class Scaler {
    int factor;

    constructor(this.factor);

    constructor((int) -> int make) {
        this.factor = make(3);
    }

    apply((int) -> int step) -> string {
        return "method:{step(this.factor)}";
    }

    apply(string text) -> string {
        return "text:{text}";
    }
}

class Shape {
    protected constructor();
}

class Square extends Shape {
    int side;

    protected constructor(this.side) {
        super();
    }
}

class Labels {
    static describe(string prefix, (int) -> int step) -> string {
        return "{prefix}:{step(4)}";
    }

    static describe(string prefix, Point point) -> string {
        return "{prefix}:{point.x}";
    }
}

chooseStep(bool up) -> (int) -> int {
    return up ? (x) -> x + 8 : (x) -> x - 1;
}

choosePoint(long mode) -> Point {
    return switch (mode) {
        1 -> {x: 1, y: 1},
        default -> {x: 2, y: 0},
    };
}

main() -> int {
    bool up = true;
    long mode = 2;
    print(run(up ? (x) -> x + 1 : (x) -> x - 1));
    print(run(switch (mode) {
        1 -> (x) -> x,
        default -> (x) -> x * 2,
    }));
    print(combine(up ? (x) -> x + 1 : (x) -> x - 1));
    print(combine(up ? (a, b) -> a + b : (a, b) -> a * b));
    print(new Scaler(4).apply(up ? (x) -> x * 3 : (x) -> x));
    print(new Scaler(up ? (x) -> x * 3 : (x) -> x).apply((x) -> x));
    print(Labels.describe(step: (up ? (x) -> x + 1 : (x) -> x), prefix: "named"));
    print("generic:{pick(4, up ? (x) -> x * 2 : (x) -> x)}");
    print("generic:{pick(3, ((x) -> x))}");
    print(place(up ? {x: 1, y: 2} : {x: 0, y: 0}));
    print(place(switch (mode) {
        1 -> {x: 0, y: 0},
        default -> {x: 3, y: 4},
    }));
    print("returned:{chooseStep(up)(3)}");
    print("returned:{choosePoint(mode).x}");
    (int) -> int doubled = up ? (x) -> x * 2 : (x) -> x;
    Point corner = switch (mode) {
        1 -> {x: 0, y: 0},
        default -> {x: 1, y: 1},
    };
    print("initialized:{doubled(10)} {corner.x}");
    long steps = count([doubled, up ? (x) -> x : (x) -> 1]);
    print("offered:{steps} {count([corner, up ? {x: 2, y: 2} : {x: 3, y: 3}])}");
    print("offered:{same([doubled, (x) -> x + 1])[1](4)} {same([[doubled], up ? [(x) -> x] : []]).length}");
    ((int) -> int)? missing = null;
    (int) -> int fallback = missing ?? (up ? (x) -> x + 7 : (x) -> x);
    print("fallback:{fallback(3)}");
    string word = "hello";
    print(measure("captured", up ? () -> word.length : () -> 0));
    string? maybe = up ? "abc" : null;
    print(measure("narrowed", maybe != null ? () -> maybe.length : () -> 0));
    (int) -> int tripled = (x) -> x * 3;
    let either = up ? (x) -> x * 2 : tripled;
    let arm = switch (mode) {
        1 -> (x) -> x,
        default -> tripled,
    };
    let nested = up ? (mode > 1 ? (x) -> x + 1 : (x) -> x) : tripled;
    let ending = switch (mode) {
        1 -> panic("one"),
        2 -> (x) -> x,
        default -> tripled,
    };
    print("joined:{either(3)} {arm(3)} {nested(3)} {ending(3)}");
    int bonus = 5;
    Shape shape = new Square(2);
    let scaled = switch (shape) {
        is Square square -> (x) -> x * square.side,
        default -> tripled,
    };
    let counted = switch (mode) {
        1 -> tripled,
        default -> (x) -> x + bonus,
    };
    print("armed:{scaled(5)} {counted(1)}");
    Point origin = {x: 1, y: 2};
    let other = up ? origin : {x: 5, y: 5};
    let built = switch (mode) {
        1 -> origin,
        default -> {x: bonus + 2, y: 0},
    };
    print("struct:{other.x} {other.y} {built.x}");
    int[] two = [1, 2];
    let filled = up ? two : [];
    let emptied = up ? [] : two;
    print("array:{filled.length} {emptied.length}");
    return 0;
}
