// @exit 0
// @stdout arith 2
// @stdout bitshift 12
// @stdout unsigned -8 2147483640
// @stdout widen 3000000000
// @stdout float ok
// @stdout str foobar
// @stdout str2 xyz
// @stdout str3 a1true7x
// @stdout narrowed 6 15 abc1
// @stdout field x=15 y=12
// @stdout elem 60 100 2
// @stdout once calls=1 val=15
// @stdout recv calls=1 val=10
// Happy-path coverage for the compound assignment operators. Each lowers to
// 'target = target OP rhs' with the target evaluated exactly once, whatever the target is.
struct Point {
    protected int x;
    protected int y;
}

class Indexer {
    protected int calls;

    protected constructor(this.calls);

    protected pick() -> int {
        this.calls = this.calls + 1;
        return 0;
    }
}

class Box {
    protected int value;

    protected constructor(this.value);
}

class Provider {
    protected int calls;
    protected Box box;

    protected constructor(this.calls, this.box);

    protected give() -> Box {
        this.calls = this.calls + 1;
        return this.box;
    }
}

main() -> int {
    int a = 20;
    a += 5;
    a -= 3;
    a *= 2;
    a /= 5;
    a %= 3;
    print("arith {a}");

    int b = 12;
    b &= 10;
    b |= 1;
    b ^= 15;
    b <<= 2;
    b >>= 1;
    print("bitshift {b}");

    int arith = -16;
    arith >>= 1;
    int logical = -16;
    logical >>>= 1;
    print("unsigned {arith} {logical}");

    long wide = 1000000000;
    int addend = 2000000000;
    wide += addend;
    print("widen {wide}");

    double d = 2.5;
    d += 0.5;
    d *= 2.0;
    d /= 4.0;
    if (d == 1.5) {
        print("float ok");
    }

    string s = "foo";
    s += "bar";
    print("str {s}");

    string t = "x";
    t += "y" + "z";
    print("str2 {t}");

    // '+=' on a string appends whatever '+' concatenates, not only another string.
    string mixed = "a";
    long count = 7;
    mixed += 1;
    mixed += true;
    mixed += count;
    mixed += "x";
    print("str3 {mixed}");

    // A target declared optional but narrowed to its inner type reads as that inner
    // type, so the operator applies and the result goes back into the optional slot.
    int? counter = 5;
    counter += 1;
    long? sum = 10;
    sum += 5;
    string? label = "a" + "b";
    label += "c";
    label += 1;
    print("narrowed {counter} {sum} {label}");

    Point p = {x: 10, y: 3};
    p.x += 5;
    p.y *= 4;
    print("field x={p.x} y={p.y}");

    int[] arr = new int[3];
    arr[0] = 100;
    arr[1] = 50;
    arr[2] = 8;
    arr[0] -= 40;
    arr[1] <<= 1;
    arr[2] %= 3;
    print("elem {arr[0]} {arr[1]} {arr[2]}");

    let ix = new Indexer(0);
    int[] cell = new int[1];
    cell[0] = 10;
    cell[ix.pick()] += 5;
    print("once calls={ix.calls} val={cell[0]}");

    let pr = new Provider(0, new Box(7));
    pr.give().value += 3;
    print("recv calls={pr.calls} val={pr.box.value}");

    return 0;
}
