// @expect-error Expected a statement, such as an assignment, a call or a declaration like 'let count = 0;'.
// @expect-error Variable 'text' has type 'string', but its value has type 'int'. Declare 'text' as an 'int' instead.
// @expect-error build failed with 11 problems
// Tokens that cannot go between a statement's header and the '{' of its body are reported once,
// and the block after them is still the statement's body, so each function goes on past it and the
// function after it is still checked. Junk where a statement should begin ends before a '{', so the
// block after it keeps its own '}'. A '{' after '=' begins a value, so it is never taken as a body.

enum Color {
    Red,
    Green,
}

junkAfterIf(int x) -> int {
    if (x == 1) && x > 0 {
        x = 1;
    }
    int after = 2;
    return after;
}

junkAfterElse(int x) -> int {
    if (x == 1) {
        x = 2;
    } else otherwise {
        x = 3;
    }
    int after = 2;
    return after;
}

junkAfterWhile(int x) -> int {
    while (x < 4) && x > 0 {
        x = x + 1;
    }
    int after = 2;
    return after;
}

junkAfterFor(int x) -> int {
    for (int i = 0; i < 4; i++) step {
        x = x + i;
    }
    int after = 2;
    return after;
}

junkAfterForEach(int[] items) -> int {
    int total = 0;
    for (let item in items) step {
        total = total + item;
    }
    int after = 2;
    return after;
}

junkBeforeNextLine(int x) -> int {
    if (x == 1) && x > 0
    {
        x = 1;
    }
    int after = 2;
    return after;
}

junkAfterSwitchStatement(Color color) -> int {
    switch (color) + 1 {
        Red -> {
            return 1;
        },
        Green -> {
            return 2;
        },
    }
    int after = 2;
    return after;
}

junkAfterSwitchExpression(Color color) -> int {
    return switch (color) + 1 {
        Red -> 1,
        Green -> 2,
    };
}

junkBeforeBlock(int x) -> int {
    && x > 0 {
        x = 1;
    }
    int after = 2;
    return after;
}

