// @exit 100
class Node {
    protected int v;
    protected constructor(this.v = 0);
}

class Holder {
    protected weak Node? n;
    protected constructor();
}

makeNodes() -> Node[] {
    return [new Node(7), new Node(8)];
}

firstValue() -> int {
    for (Node nd in makeNodes()) {
        return nd.v;
    }
    return -1;
}

main() -> int {
    // An owned local declared in a loop body is released each iteration.
    let h1 = new Holder();
    for (int i = 0; i < 3; i = i + 1) {
        let a = new Node();
        h1.n = a;
    }
    if (h1.n != null) {
        return 1;
    }

    // break releases owned locals live in the body.
    let h2 = new Holder();
    for (int i = 0; i < 10; i = i + 1) {
        let b = new Node();
        h2.n = b;
        if (i == 0) {
            break;
        }
    }
    if (h2.n != null) {
        return 2;
    }

    // continue releases owned locals live in the body.
    let h3 = new Holder();
    int k = 0;
    while (k < 3) {
        let c = new Node();
        h3.n = c;
        k = k + 1;
        if (k == 3) {
            continue;
        }
    }
    if (h3.n != null) {
        return 3;
    }

    // for-each binds each element as a borrow; the array stays intact.
    Node[] arr = [new Node(7), new Node(8)];
    int sum = 0;
    for (Node nd in arr) {
        sum = sum + nd.v;
    }
    if (sum != 15) {
        return 4;
    }
    if (arr[0].v != 7) {
        return 5;
    }

    // for-each over an owned temporary array releases it after the loop.
    int sum2 = 0;
    for (Node nd in makeNodes()) {
        sum2 = sum2 + nd.v;
    }
    if (sum2 != 15) {
        return 6;
    }

    if (firstValue() != 7) {
        return 7;
    }

    return 100;
}