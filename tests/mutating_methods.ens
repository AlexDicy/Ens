// @exit 0
// @stdout local: 2
// @stdout field of a local: 1
// @stdout parameter: 6, caller: 5
// @stdout nested field: 3
// @stdout class field: 4
// @stdout array element: 7
// @stdout through a bound: 2, caller: 0
// @stdout through a class: 1
// @stdout marked without a change: 9
// A 'mutating' method changes the struct it is called on wherever that struct may change: a local,
// a field of one, a parameter, a field of a class object, an array element, and a value passed to
// a generic bound whose interface declares the method 'mutating'.
interface Bumpable {
    mutating bump();

    read() -> int;
}

struct Counter implements Bumpable {
    int value;

    override mutating bump() {
        this.value = this.value + 1;
    }

    override read() -> int {
        return this.value;
    }

    mutating bumpTwice() {
        this.bump();
        this.bump();
    }

    mutating unchanged() -> int {
        return this.value;
    }
}

struct Pair {
    Counter left;
    Counter right;

    mutating bumpLeft() {
        this.left.bump();
    }
}

class Holder {
    Counter counter = {value: 3};
}

class Clicker implements Bumpable {
    int clicks = 0;

    override bump() {
        this.clicks++;
    }

    override read() -> int {
        return this.clicks;
    }
}

bumpCopy(Counter counter) -> int {
    counter.bump();
    return counter.value;
}

bumpAll<T: Bumpable>(T value) -> int {
    value.bump();
    value.bump();
    return value.read();
}

bumpOnce<T: Bumpable>(T value) -> int {
    value.bump();
    return value.read();
}

main() -> int {
    Counter local = {value: 0};
    local.bump();
    local.bump();
    print("local: {local.value}");
    Pair pair = {left: {value: 0}, right: {value: 0}};
    pair.bumpLeft();
    print("field of a local: {pair.left.value}");
    Counter five = {value: 5};
    let bumped = bumpCopy(five);
    print("parameter: {bumped}, caller: {five.value}");
    pair.right.bumpTwice();
    pair.right.bump();
    print("nested field: {pair.right.value}");
    let holder = new Holder();
    holder.counter.bump();
    print("class field: {holder.counter.value}");
    Counter[] counters = [{value: 6}];
    counters[0].bump();
    print("array element: {counters[0].value}");
    Counter bound = {value: 0};
    print("through a bound: {bumpAll(bound)}, caller: {bound.value}");
    print("through a class: {bumpOnce(new Clicker())}");
    Counter nine = {value: 9};
    print("marked without a change: {nine.unchanged()}");
    return 0;
}
