// @expect-error can throw 'Failure', which interface 'Quiet' does not allow
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Quiet {
    run() -> int;
}

class Noisy implements Quiet {
    constructor();
    run() -> int throws {
        throw new Failure("boom");
    }
}

main() -> int {
    return 0;
}
