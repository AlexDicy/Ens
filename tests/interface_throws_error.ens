// @expect-error Method 'run' of 'Noisy' can throw 'Failure', which the 'run' declared by interface 'Quiet' does not list. An implementing method throws only what the interface lists. Remove 'throws' and catch 'Failure' with a 'catch' clause after the body. Or mark 'run' in 'Quiet' with 'throws Failure'.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Quiet {
    run() -> int;
}

class Noisy implements Quiet {
    constructor();
    run() -> int throws {
        throw new Failure("boom");
    }
}

main() -> int {
    return 0;
}
