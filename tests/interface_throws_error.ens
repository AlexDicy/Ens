// @expect-error can throw 'Failure', which the 'run' declared by interface 'Quiet' does not list
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Quiet {
    run() -> int;
}

class Noisy implements Quiet {
    constructor();
    run() -> int throws {
        throw new Failure("boom");
    }
}

main() -> int {
    return 0;
}
