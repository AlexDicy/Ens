// @expect-error Literal 1e400 is too large for 'double', which holds about 1.8e308 at most.
// The promise is not family-specific: a floating-point literal nothing gives a type to is a
// 'double', and one past every floating-point type is reported instead of becoming infinity.
main() -> int {
    let beyondDouble = 1e400;
    return beyondDouble > 0.0 ? 0 : 1;
}
