// @exit 61
// Straight-line null refinement: assigning a statically non-null value to a local or a parameter
// of optional declared type narrows it from that point on, and a redundant presence check stays
// legal even where narrowing already proved the value non-null. A mutable field or an element
// never narrows, so a write through one refines nothing.
class Leaf {
    protected int v;
    protected constructor(this.v = 0);
}

fiveInt() -> int {
    return 5;
}

makeLeaf() -> Leaf {
    return new Leaf(11);
}

maybeInt() -> int? {
    return 3;
}

noop() {
}

// Assigning a non-null value to an optional parameter refines it.
paramRefine(int? p) -> int {
    p = 8;
    return p;
}

// An ordinary call does not drop a straight-line refinement.
callSurvive() -> int {
    int? c = 7;
    noop();
    return c;
}

// The refinement holds across loop iterations and body calls.
loopSurvive() -> int {
    int? base = 5;
    int sum = 0;
    for (int i = 0; i < 3; i = i + 1) {
        noop();
        sum = sum + base;
    }
    return sum;
}

main() -> int {
    int score = 0;

    // 1. A declared optional with a non-null initializer starts narrowed.
    int? a = 5;
    score = score + a;                 // +5 -> 5

    // 2. Declare null, assign a non-null value, then use as the inner type.
    int? n = null;
    n = fiveInt();
    score = score + n;                 // +5 -> 10

    // 3. '??' on a narrowed declared-optional is legal and yields the value.
    int? v = 4;
    score = score + (v ?? 99);         // +4 -> 14

    // 4. A redundant nested null check is legal on a narrowed binding.
    Leaf? x = makeLeaf();
    if (x != null) {
        if (x != null) {
            score = score + x.v;       // +11 -> 25
        }
    }

    // 5. A nullable reassignment drops the refinement; a fresh check restores it.
    int? r = 3;
    r = maybeInt();
    if (r != null) {
        score = score + r;             // +3 -> 28
    }

    // 6. An assignment in the branch that had no value, joined with the negated check that
    // proved one in the other branch, leaves the value proven on both paths.
    int? j = maybeInt();
    if (j == null) {
        j = 5;
    }
    score = score + j;                 // +3 -> 31

    score = score + paramRefine(0);    // +8 -> 39
    score = score + callSurvive();     // +7 -> 46
    score = score + loopSurvive();     // +15 -> 61

    return score;
}
