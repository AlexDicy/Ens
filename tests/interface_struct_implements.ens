// A struct may declare 'implements', which lets a generic bound accept the struct and calls the
// struct's own method directly. Plain and generic interfaces, an extended one, a generic struct,
// the library's own ordered containers, and 'for'-in over an 'Iterable' struct all reach the same
// conformance.
// @stdout sorted: a b c
// @stdout picked: apple
// @stdout map: nine=9 ten=10
// @stdout said: hello loudly at 11
// @stdout pair order: -1
// @stdout bumped: 3, caller still 1
// @stdout walked a local: 0123
// @stdout walked a temporary: 012
// @exit 0
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import List from @std.collections.list;
import SortedMap from @std.collections.sortedmap;
import StringBuilder from @std.text.stringbuilder;

export interface Speaker {
    speak() -> string;
}

export interface Loud extends Speaker {
    volume() -> int;
}

export interface Bumpable {
    bump();
}

export struct Name implements Comparable<Name> {
    export const string text;

    export constructor(this.text);

    export override compareTo(Name other) -> int {
        return this.text.compareTo(other.text);
    }

    export override toString() -> string {
        return this.text;
    }
}

export struct Greeting implements Loud {
    export const string word;
    export const int level;

    export constructor(this.word, this.level);

    export override speak() -> string {
        return this.word;
    }

    export override volume() -> int {
        return this.level;
    }
}

export struct Counter implements Bumpable {
    export int value;

    export override bump() {
        this.value = this.value + 1;
    }
}

export final class DigitCursor implements Iterator<int> {
    int position;
    export const int limit;

    export constructor(this.position, this.limit);

    export override next() -> int? {
        if (this.position >= this.limit) {
            return null;
        }
        let value = this.position;
        this.position = this.position + 1;
        return value;
    }
}

// A struct that declares 'Iterable<T>' is walked by 'for'-in, which calls 'makeIterator' on the
// struct directly. The iterator it answers is a class, as every iterator is.
export struct Digits implements Iterable<int> {
    export const int limit;

    export constructor(this.limit);

    export override makeIterator() -> Iterator<int> {
        return new DigitCursor(0, this.limit);
    }
}

// A generic struct conforms at its own instantiation, so 'Pair<int>' orders against 'Pair<int>'.
export struct Pair<T: Comparable<T>> implements Comparable<Pair<T>> {
    export const T left;
    export const T right;

    export constructor(this.left, this.right);

    export override compareTo(Pair<T> other) -> int {
        let first = this.left.compareTo(other.left);
        if (first != 0) {
            return first;
        }
        return this.right.compareTo(other.right);
    }
}

smallest<T: Comparable<T>>(List<T> values) -> T {
    T best = values.get(0);
    for (long i = 1; i < values.length(); i++) {
        if (values.get(i).compareTo(best) < 0) {
            best = values.get(i);
        }
    }
    return best;
}

// A bound naming an extended interface reaches the method the base interface declares.
announce<T: Loud>(T source) -> string {
    return "{source.speak()} loudly at {source.volume()}";
}

// A struct arrives by value, so the two bumps are visible here and nowhere else.
bumpTwice<T: Bumpable>(T value) -> T {
    value.bump();
    value.bump();
    return value;
}

joined(List<Name> names) -> string {
    let builder = new StringBuilder();
    for (long i = 0; i < names.length(); i++) {
        if (i > 0) {
            builder.append(" ");
        }
        builder.append(names.get(i).text);
    }
    return builder.toString();
}

main() -> int {
    let names = new List<Name>();
    names.push(Name("c"));
    names.push(Name("a"));
    names.push(Name("b"));
    print("sorted: {joined(names.sorted())}");
    let fruit = new List<Name>();
    fruit.push(Name("pear"));
    fruit.push(Name("apple"));
    print("picked: {smallest(fruit)}");

    let counts = new SortedMap<Name, int>();
    counts.set(Name("ten"), 10);
    counts.set(Name("nine"), 9);
    let shown = new StringBuilder();
    for (let entry in counts) {
        if (shown.length() > 0) {
            shown.append(" ");
        }
        shown.append("{entry.key}={entry.value}");
    }
    print("map: {shown.toString()}");

    print("said: {announce(Greeting("hello", 11))}");
    let low = Pair<Name>(Name("a"), Name("b"));
    let high = Pair<Name>(Name("a"), Name("c"));
    print("pair order: {low.compareTo(high)}");

    Counter counter = {value: 1};
    let bumped = bumpTwice(counter);
    print("bumped: {bumped.value}, caller still {counter.value}");

    // A local names its own storage; a temporary is materialized into a slot to be walked.
    let fromLocal = new StringBuilder();
    Digits counted = {limit: 4};
    for (let digit in counted) {
        fromLocal.append("{digit}");
    }
    print("walked a local: {fromLocal.toString()}");
    let fromTemporary = new StringBuilder();
    for (let digit in Digits(3)) {
        fromTemporary.append("{digit}");
    }
    print("walked a temporary: {fromTemporary.toString()}");
    return 0;
}
