// @exit 134
// @stderr-contains panic: tried to cut a string at offset 1, which is inside a character rather than at its start. Cut at a character boundary
// A substring that would cut a character in half aborts: text is always valid UTF-8, so an offset
// has to be where a character starts.
main() -> int {
    let text = "é";
    return text.substring(1).length as int;
}
