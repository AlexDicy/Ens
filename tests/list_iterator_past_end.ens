// @exit 134
// @stdout first one
// @stderr-contains panic: next past the end of a list
// The iterator is the other place a list exposes its backing store, so drawing a value it does
// not have aborts the same way an out-of-bounds read does instead of answering with a slot the
// list was never given.
import List from @std.collections.list;

main() -> int {
    let words = new List<string>();
    words.push("one");
    let walk = words.makeIterator();
    print("first {walk.next()}");
    return walk.next().length as int;
}
