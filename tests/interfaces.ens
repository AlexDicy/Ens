// @exit 0
// @stdout woof meow
// @stdout param woof
// @stdout inherited 42
// @stdout override MEOW
// @stdout stored MEOW
// @stdout same yes
// @stdout cross no
// @stdout nullable none
// @stdout array woof,meow
// @stdout watcher alive
// @stdout watcher gone
// @stdout throws loaded
// @stdout throws err:nope
// @stdout abstract polly
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

interface Speaker {
    speak() -> string;
}

// A throwing interface method declares its thrown types explicitly.
interface Loader {
    load(bool ok) -> string throws Error;
}

interface Valued {
    value() -> int;
}

class Dog implements Speaker {
    protected constructor();
    protected override speak() -> string { return "woof"; }
}

class Cat implements Speaker {
    protected constructor();
    protected override speak() -> string { return "meow"; }
}

class LoudCat extends Cat {
    protected constructor();
    protected override speak() -> string { return "MEOW"; }
}

// Interface satisfaction through an inherited method: the base declares
// value(), the subclass declares the conformance.
class Counter {
    protected constructor();
    protected value() -> int { return 42; }
}

class InheritedCounter extends Counter implements Valued {
    protected constructor();
}

class SpeakerBox implements Speaker {
    Speaker inner;
    protected constructor(this.inner);
    protected override speak() -> string { return this.inner.speak(); }
}

// An abstract class may satisfy an interface with an abstract method; the
// concrete subclasses' overrides provide the bodies.
abstract class AbstractSpeaker implements Speaker {
    protected constructor();
    protected abstract override speak() -> string;
}

class Parrot extends AbstractSpeaker {
    protected constructor();
    protected override speak() -> string { return "polly"; }
}

class Watcher {
    protected weak Dog? watched;
    protected constructor();
    protected status() -> string {
        if (this.watched != null) {
            return "alive";
        }
        return "gone";
    }
}

class FileLoader implements Loader {
    protected constructor();
    protected override load(bool ok) -> string throws Error {
        if (!ok) {
            throw new Failure("nope");
        }
        return "loaded";
    }
}

describe(Speaker s) -> string {
    return s.speak();
}

fetch(Loader l, bool ok) -> string {
    return try l.load(ok);
} catch (Error e) {
    return "err:" + e.message;
}

main() -> int {
    Speaker a = new Dog();
    Speaker b = new Cat();
    print(a.speak() + " " + b.speak());

    print("param " + describe(new Dog()));

    Valued v = new InheritedCounter();
    print("inherited " + v.value());

    // Dispatch through the interface runs the subclass override.
    Cat quiet = new LoudCat();
    print("override " + describe(quiet));

    // An interface-typed field dispatches like any other reference.
    SpeakerBox box = new SpeakerBox(new LoudCat());
    print("stored " + box.speak());

    // == compares identity, exactly like class references.
    Dog d = new Dog();
    Speaker s1 = d;
    Speaker s2 = d;
    print("same " + (s1 == s2 ? "yes" : "no"));
    print("cross " + (s1 == b ? "yes" : "no"));

    // I? behaves like any nullable reference.
    Speaker? maybe = null;
    print("nullable " + (maybe == null ? "none" : maybe.speak()));

    // I?[] arrays hold interface references; literals of concrete values work.
    Speaker?[] voices = new Speaker?[2];
    voices[0] = d;
    voices[1] = new Cat();
    string joined = "";
    for (let voice in voices) {
        if (voice != null) {
            if (joined.length > 0) {
                joined = joined + ",";
            }
            joined = joined + voice.speak();
        }
    }
    print("array " + joined);

    // ARC: an interface-typed local keeps its object alive; dropping the
    // last reference clears the weak watcher.
    Watcher w = new Watcher();
    Speaker holder = new Dog();
    w.watched = holder as? Dog;
    print("watcher " + w.status());
    holder = new Cat();
    print("watcher " + w.status());

    // Exceptions cross interface dispatch like any other virtual call.
    Loader loader = new FileLoader();
    print("throws " + fetch(loader, true));
    print("throws " + fetch(loader, false));

    print("abstract " + describe(new Parrot()));

    return 0;
}
