// @expect-error Cannot compare 'Meters' and 'Feet'
// @expect-error Struct 'Handleful' cannot be compared with '=='. Field 'handle'
// Two distinct struct types cannot be compared, and a struct with an external
// field has no memberwise '=='.

external type Handle;

struct Meters {
    int value;
}

struct Feet {
    int value;
}

struct Handleful {
    Handle handle;
}

crossType(Meters m, Feet f) -> bool {
    return m == f;
}

externalField(Handleful a, Handleful b) -> bool {
    return a == b;
}

main() -> int {
    return 0;
}
