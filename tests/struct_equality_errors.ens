// @expect-error Cannot compare 'Meters' with 'Feet', because a value of one of these types is never equal to a value of the other.
// Two distinct struct types cannot be compared.

struct Meters {
    int value;
}

struct Feet {
    int value;
}

crossType(Meters m, Feet f) -> bool {
    return m == f;
}

main() -> int {
    return 0;
}
