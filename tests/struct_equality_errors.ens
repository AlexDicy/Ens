// @expect-error Cannot compare 'Meters' and 'Feet'
// @expect-error Struct 'Stepper' cannot be compared with '=='. Field 'step'
// Two distinct struct types cannot be compared, and a struct with a function-valued field has no
// memberwise '=='.

struct Meters {
    int value;
}

struct Feet {
    int value;
}

struct Stepper {
    (int) -> int step;
}

crossType(Meters m, Feet f) -> bool {
    return m == f;
}

functionField(Stepper a, Stepper b) -> bool {
    return a == b;
}

main() -> int {
    return 0;
}
