// @expect-error Cannot catch 'T': a type parameter is caught through its class bound, and 'T' has none under 'Error'. Bound it as 'T: Error' or by an 'Error' subclass.
// @expect-error A declared throws type must be 'Error' or a subclass; 'T' promises that only through a class bound, and it has none under 'Error'. Bound it as 'T: Error' or by an 'Error' subclass.
// @expect-error In 'alwaysMatches<Base>': A value of type 'Base' is always a 'Base'; this 'is' test would always be true. Remove it.
// @expect-error In 'neverMatches<Apart>': A value of type 'Base' can never be a 'Apart'; this 'is' test would always be false. Remove it.
// @expect-error In 'primitiveTarget<int>': The target of 'is' resolves to 'int', and only a class or an interface can be tested at run time.
// @expect-error 'catchUnbounded' can throw 'Boom' but is not marked 'throws'
// @expect-error build failed with 6 problems
// The rules a type parameter answers to in a runtime type position: catch and a throws list need
// an Error class bound, and is, as?, and switch arms are judged per instantiation against the
// concrete argument, so a vacuous or impossible test is refused naming the instantiation.
class Boom extends Error {
    protected constructor(string message) { super(message); }
}

class Base {
    protected constructor();
}

class Apart {
    protected constructor();
}

raise() throws Boom {
    throw new Boom("bang");
}

catchUnbounded<T>((() -> void throws Boom) body) {
    try body();
} catch (T caught) {
    print("never");
}

raiseUnbounded<T>() throws T {
    print("never");
}

alwaysMatches<T: Base>(Base value) -> bool {
    return value is T;
}

neverMatches<T>(Base value) -> bool {
    return value is T;
}

primitiveTarget<T>(Base value) -> bool {
    return value is T;
}

main() -> int {
    print("{alwaysMatches<Base>(new Base())}");
    print("{neverMatches<Apart>(new Base())}");
    print("{primitiveTarget<int>(new Base())}");
    return 0;
}
