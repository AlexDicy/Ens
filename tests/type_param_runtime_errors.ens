// @expect-error Cannot catch 'T': a type parameter is caught through its class bound, and 'T' has none under 'Error'. Bound it as 'T: Error' or by an 'Error' subclass.
// @expect-error A declared throws type must be 'Error' or a subclass; 'T' is that only through a class bound, and it has none under 'Error'. Bound it as 'T: Error' or by an 'Error' subclass.
// @expect-error 'alwaysMatches<Base>' tests a value of type 'Base' against 'Base', which it always is, so the test would always be true. Use a type argument for which the test can be true or false.
// @expect-error 'neverMatches<Apart>' tests a value of type 'Base' against 'Apart', which it can never be, so the test would always be false. Use a type argument for which the test can be true or false.
// @expect-error 'primitiveTarget<int>' cannot use 'is' against 'int': only a class or an interface can be tested at run time. Pass a class or an interface as the type argument.
// @expect-note 'alwaysMatches<T>' tests a value of type 'Base' against 'T' here
// @expect-note 'neverMatches<T>' tests a value of type 'Base' against 'T' here
// @expect-note 'primitiveTarget<T>' tests a value of type 'Base' against 'T' here
// @expect-error 'catchUnbounded' can throw 'Boom' but is not marked 'throws'
// @expect-error Cannot throw a value of type 'T': a type parameter can be thrown only when it is bounded by 'Error' or a subclass of it, as in 'T: Error'.
// @expect-error build failed with 7 problems
// In a runtime type position a type parameter needs an Error class bound for catch, throws, and
// throw. Type tests are judged per instantiation, so a vacuous or impossible test is refused at
// the call that supplied the type argument, naming the instantiation, with the test itself as a
// note.
class Boom extends Error {
    protected constructor(string message) { super(message); }
}

class Base {
    protected constructor();
}

class Apart {
    protected constructor();
}

raise() throws Boom {
    throw new Boom("bang");
}

catchUnbounded<T>((() -> void throws Boom) body) {
    try body();
} catch (T caught) {
    print("never");
}

raiseUnbounded<T>() throws T {
    print("never");
}

throwUnbounded<T>(T value) throws {
    throw value;
}

alwaysMatches<T: Base>(Base value) -> bool {
    return value is T;
}

neverMatches<T>(Base value) -> bool {
    return value is T;
}

primitiveTarget<T>(Base value) -> bool {
    return value is T;
}

main() -> int {
    print("{alwaysMatches<Base>(new Base())}");
    print("{neverMatches<Apart>(new Base())}");
    print("{primitiveTarget<int>(new Base())}");
    return 0;
}
