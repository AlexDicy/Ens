// What a primitive's members are is a statement about the language, so only the standard library
// may make one; a program that writes 'primitive' is told what to write instead.
// @expect-error 'primitive' declares what the members of a built-in type are, which only the standard library may do. Elsewhere 'primitive' is an ordinary identifier. To add operations to 'string', write functions that take it, or a class or struct of your own.
// @expect-error 'primitive' declares what the members of a built-in type are, which only the standard library may do. Elsewhere 'primitive' is an ordinary identifier. To add operations to 'long', write functions that take it, or a class or struct of your own.
// @expect-error build failed with 2 problems
primitive string {
    export shouted() -> string {
        return this + "!";
    }
}

primitive long {
    export doubled() -> long {
        return this * 2;
    }
}

main() -> int {
    return 0;
}
