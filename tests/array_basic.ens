// @exit 100
main() -> int {
    int[] xs = new int[5];
    xs[0] = 10;
    xs[1] = 20;
    xs[2] = 30;
    xs[3] = 40;
    // xs[4] left as default 0

    int total = xs[0] + xs[1] + xs[2] + xs[3] + xs[4];
    if (total != 100) {
        return 1;
    }

    // .length returns long
    if (xs.length != 5L) {
        return 2;
    }

    // Element write-read loop with int index
    int[] ys = new int[4];
    int i = 0;
    while (i < 4) {
        ys[i] = i * 2;
        i = i + 1;
    }
    if (ys[0] != 0) { return 3; }
    if (ys[3] != 6) { return 4; }

    // Long index also works (subscript widens narrow types).
    long j = 2L;
    if (ys[j] != 4) { return 5; }

    // Nullable array - null-check narrowing
    int[]? maybe = null;
    if (maybe != null) {
        return 6;
    }

    int[]? present = new int[2];
    if (present == null) {
        return 7;
    } else {
        present[0] = 100;
        if (present[0] != 100) { return 8; }
    }

    return total;
}
