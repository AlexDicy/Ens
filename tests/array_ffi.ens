// @exit 8
// FFI smoke test: round-trip byte[] through libc. memset fills the buffer with
// the given int (the low 8 bits land in each slot), strlen walks until the
// first NUL byte.
//
// strlen returns size_t; we declare it as `int` so the result fits the
// program exit code. For the byte values used here (all 65 = 'A'), the low
// 32 bits of the size_t result hold the true length.

external from "c" {
    memset(byte[] buf, int c, int n) -> int;
    strlen(byte[] s) -> int;
}

main() -> int {
    byte[] buf = new byte[16];
    // calloc gave us a fully-zeroed buffer (length=16, all bytes 0). Fill half
    // the buffer with 'A' (65); the rest stays 0 so strlen stops cleanly.
    int half = (buf.length / 2L) as int;
    memset(buf, 65, half);
    if (buf.length != 16L) { return 1; }
    return strlen(buf);
}
