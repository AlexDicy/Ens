// @exit 3
// FFI smoke test: round-trip byte[] through libc strlen. strlen returns
// size_t; we declare it as `int` so the result fits the program exit code.

external from libc {
    strlen(byte[] s) -> int;
}

main() -> int {
    byte[] buf = new byte[16];
    // calloc gave us a fully-zeroed buffer. Write three ASCII chars; byte 3
    // stays 0 as the NUL terminator.
    buf[0] = 'H';
    buf[1] = 'i';
    buf[2] = '!';
    if (buf.length != 16) { return 1; }
    return strlen(buf);
}