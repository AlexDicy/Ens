// @expect-error Type argument 'Rock' for type parameter 'T' must implement interface 'Speaker'
interface Speaker {
    speak() -> string;
}

class Rock {
    constructor();
}

class Chorus<T: Speaker> {
    private T lead;
    constructor(this.lead);
}

main() -> int {
    let c = new Chorus<Rock>(new Rock());
    return 0;
}
