// @expect-error Type argument 'Rock' for type parameter 'T' of 'Chorus' must implement interface 'Speaker'. Replace 'Rock' with a type that implements 'Speaker', or add 'implements Speaker' to the declaration of 'Rock'.
interface Speaker {
    speak() -> string;
}

class Rock {
    protected constructor();
}

class Chorus<T: Speaker> {
    T lead;
    constructor(this.lead);
}

main() -> int {
    let c = new Chorus<Rock>(new Rock());
    return 0;
}
