tie((int) -> int step) -> int {
    return step(1);
}

tie((int) -> long step) -> int {
    return 0;
}

narrow(byte[] values) -> int {
    return 1;
}

narrow(short[] values) -> int {
    return 0;
}

empty(int[] values) -> int {
    return 1;
}

empty(string[] values) -> int {
    return 0;
}

over((int) -> int step) -> int {
    return step(1);
}

over(string text) -> int {
    return 0;
}

pair((int) -> int step, string text) -> int {
    return step(1);
}

pair(string text, int count) -> int {
    return count;
}

total(string[] names) -> int {
    return 1;
}

total(long amount, string label) -> int {
    return 0;
}

describe(int value) -> int {
    return value;
}

describe(string text) -> int {
    return 0;
}

identity<T>(T value) -> T {
    return value;
}

struct Point {
    int x;
}

struct Size {
    int x;
}

place(Point point) -> int {
    return point.x;
}

place(Size size) -> int {
    return 0;
}

class Plain {
    static make(int value) -> int {
        return value;
    }

    static twice(int value) -> int {
        return value * 2;
    }

    static twice(int value, int times) -> int {
        return value * times;
    }
}

class Counter {
    constructor();

    bump(int by) -> int {
        return by;
    }
}

main() -> int {
    let counter = new Counter();
    int a = tie((x) -> x + 1);
    int b = tie((x) -> {
        int next = x + 1;
        return next;
    });
    int c = narrow([1, 2]);
    int d = empty([]);
    int e = over((x, y) -> x);
    int m = pair((x, y) -> x, "a");
    int n = total([], "x");
    int f = over(Plain.make);
    int g = over(Plain.twice);
    int h = over(identity);
    int i = over(counter.bump);
    int j = tie(Plain.make);
    int k = describe(Plain.make);
    int l = place({x: 1});
    return 0;
}
