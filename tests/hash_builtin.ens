// The built-in '.hash()' every value answers when no declaration does, and how a declared hash
// takes over. An optional hashes as its payload does while present, and as -1 once absent
// whatever its inner type, so absent values of unrelated types collide on one bucket.
// @exit 0
// @stdout int 42
// @stdout long -7
// @stdout unsigned 4294967295
// @stdout string true true false
// @stdout struct true false
// @stdout class true false
// @stdout enum true
// @stdout declared 7
// @stdout optional 42 -1 -1 true
// @stdout optional struct true false -1 true
// @stdout optional field true false
// @stdout optional enum true
// @stdout optional keys seven nothing 2
// @stdout optional parameter 42 -1 true true
// @stdout declared field 623206522264852908 true false
// @stdout declared field absent true false true
// @stdout inherited field true false
// @stdout identity field true false true
// @stdout string field true true
// @stdout parameter route true true
// @stdout struct keys three nothing 2
// @stdout declared struct 124 true false
// @stdout declared struct field true false
// @stdout declared struct optional true false true
// @stdout declared struct element true false
// @stdout declared struct parameter true true
// @stdout declared class parameter true true true
// @stdout declared struct keys four 1
import Map from @std.collections.map;

enum Color {
    Red,
    Green,
    Blue,
}

struct Point {
    protected int x;
    protected string label;
}

struct Ranged {
    protected int? low;
    protected int high;
}

class Node {
}

class Keyed {
    int id;

    protected constructor(this.id);

    override hash() -> long {
        return 7;
    }

    override equals(Keyed other) -> bool {
        return this.id == other.id;
    }
}

// A class whose declared hash reads its own content, so what a field of this type hashes to says
// what the object holds rather than where it sits.
class Tally {
    int total;

    protected constructor(this.total);

    override hash() -> long {
        return this.total * 31 + 5;
    }

    override equals(Tally other) -> bool {
        return this.total == other.total;
    }
}

// A subclass answers with the hash it inherited.
class Counted extends Tally {
    protected constructor(int total) {
        super(total);
    }
}

struct Held {
    protected Tally? key;
    protected int tag;
}

struct Counting {
    protected Counted? key;
    protected int tag;
}

struct Boxed {
    protected Node? item;
    protected int tag;
}

struct Named {
    protected string? label;
    protected int tag;
}

// A struct that declares its own hash, paired with the equality that agrees with it: 'id' is the
// whole identity and 'note' rides along. Every place the language takes this struct's hash - a
// receiver written by hand, a field, an optional field, an array element, a type parameter, a Map
// key - has to answer through the declaration.
struct Ticket {
    protected int id;
    protected string note;

    override hash() -> long {
        return this.id * 31;
    }

    override equals(Ticket other) -> bool {
        return this.id == other.id;
    }
}

struct Booked {
    protected Ticket ticket;
    protected int tag;
}

struct Maybe {
    protected Ticket? ticket;
    protected int tag;
}

// A type parameter with no bound still answers 'hash()', so the concrete argument hashes the
// same way calling it directly does.
hashThrough<T>(T value) -> long {
    return value.hash();
}

// A parameter is never proven present, so these two hash whatever arrives, tag and all.
hashOfInt(int? value) -> long {
    return value.hash();
}

hashOfPoint(Point? value) -> long {
    return value.hash();
}

main() -> int {
    int i = 42;
    print("int {i.hash()}");
    long l = -7;
    print("long {l.hash()}");
    uint u = 4294967295;
    print("unsigned {u.hash()}");

    string a = "alpha";
    string b = "alph" + "a";
    string c = "beta";
    print("string {a.hash() == b.hash()} {a.hash() == a.hash()} {a.hash() == c.hash()}");

    Point p1 = {x: 3, label: "p"};
    Point p2 = {x: 3, label: "p"};
    Point p3 = {x: 4, label: "p"};
    print("struct {p1.hash() == p2.hash()} {p1.hash() == p3.hash()}");

    let n1 = new Node();
    let n2 = new Node();
    print("class {n1.hash() == n1.hash()} {n1.hash() == n2.hash()}");

    let color = Color.Green;
    print("enum {color.hash() == 1}");

    print("declared {new Keyed(3).hash()}");

    int? some = 42;
    int? none = null;
    double? noneToo = null;
    print("optional {some.hash()} {none.hash()} {noneToo.hash()} {some.hash() == i.hash()}");

    Point? presentPoint = {x: 3, label: "p"};
    Point? samePoint = {x: 3, label: "p"};
    Point? otherPoint = {x: 4, label: "p"};
    Point? absentPoint = null;
    print("optional struct {presentPoint.hash() == samePoint.hash()} "
        + "{presentPoint.hash() == otherPoint.hash()} {absentPoint.hash()} "
        + "{presentPoint.hash() == p1.hash()}");

    Ranged low = {low: 5, high: 9};
    Ranged sameLow = {low: 5, high: 9};
    Ranged noLow = {low: null, high: 9};
    print("optional field {low.hash() == sameLow.hash()} {low.hash() == noLow.hash()}");

    Color? tint = Color.Green;
    print("optional enum {tint.hash() == 1}");

    let byKey = new Map<int?, string>();
    byKey.set(7, "seven");
    byKey.set(null, "nothing");
    string seven = byKey.get(7) ?? "missing";
    string nothing = byKey.get(null) ?? "missing";
    print("optional keys {seven} {nothing} {byKey.length()}");

    print("optional parameter {hashOfInt(42)} {hashOfInt(null)} "
        + "{hashOfPoint(p1) == p1.hash()} {hashOfPoint(null) == -1}");

    Held held = {key: new Tally(3), tag: 1};
    Held sameHeld = {key: new Tally(3), tag: 1};
    Held otherHeld = {key: new Tally(4), tag: 1};
    print("declared field {held.hash()} {held.hash() == sameHeld.hash()} "
        + "{held.hash() == otherHeld.hash()}");

    Held absentHeld = {key: null, tag: 1};
    Held alsoAbsentHeld = {key: null, tag: 1};
    Ranged absentLow = {low: null, high: 1};
    print("declared field absent {absentHeld.hash() == alsoAbsentHeld.hash()} "
        + "{absentHeld.hash() == held.hash()} {absentHeld.hash() == absentLow.hash()}");

    Counting counting = {key: new Counted(3), tag: 1};
    print("inherited field {counting.hash() == held.hash()} "
        + "{counting.hash() == absentHeld.hash()}");

    Boxed boxed = {item: n1, tag: 1};
    Boxed sameBoxed = {item: n1, tag: 1};
    Boxed otherBoxed = {item: n2, tag: 1};
    Boxed absentBoxed = {item: null, tag: 1};
    print("identity field {boxed.hash() == sameBoxed.hash()} "
        + "{boxed.hash() == otherBoxed.hash()} {absentBoxed.hash() == absentLow.hash()}");

    Named named = {label: "alpha", tag: 1};
    Named sameNamed = {label: "alph" + "a", tag: 1};
    Named absentNamed = {label: null, tag: 1};
    print("string field {named.hash() == sameNamed.hash()} "
        + "{absentNamed.hash() == absentLow.hash()}");

    print("parameter route {hashThrough(held) == held.hash()} "
        + "{hashThrough(absentHeld) == absentHeld.hash()}");

    let byHeld = new Map<Held, string>();
    byHeld.set(held, "three");
    byHeld.set(absentHeld, "nothing");
    string three = byHeld.get(sameHeld) ?? "missing";
    string noKey = byHeld.get(alsoAbsentHeld) ?? "missing";
    print("struct keys {three} {noKey} {byHeld.length()}");

    // The declared hash ignores 'note', so these two differ only where it does not look.
    Ticket ticket = {id: 4, note: "a"};
    Ticket sameTicket = {id: 4, note: "b"};
    Ticket otherTicket = {id: 5, note: "a"};
    print("declared struct {ticket.hash()} {ticket.hash() == sameTicket.hash()} "
        + "{ticket.hash() == otherTicket.hash()}");

    Booked booked = {ticket: ticket, tag: 1};
    Booked sameBooked = {ticket: sameTicket, tag: 1};
    Booked otherBooked = {ticket: otherTicket, tag: 1};
    print("declared struct field {booked.hash() == sameBooked.hash()} "
        + "{booked.hash() == otherBooked.hash()}");

    Maybe maybe = {ticket: ticket, tag: 1};
    Maybe sameMaybe = {ticket: sameTicket, tag: 1};
    Maybe absentMaybe = {ticket: null, tag: 1};
    print("declared struct optional {maybe.hash() == sameMaybe.hash()} "
        + "{maybe.hash() == absentMaybe.hash()} {absentMaybe.hash() == absentLow.hash()}");

    Ticket[] tickets = [ticket, sameTicket, otherTicket];
    print("declared struct element {tickets[0].hash() == tickets[1].hash()} "
        + "{tickets[0].hash() == tickets[2].hash()}");

    Ticket? presentTicket = ticket;
    print("declared struct parameter {hashThrough(ticket) == ticket.hash()} "
        + "{presentTicket.hash() == ticket.hash()}");

    // A reference answers through the 'hash' its runtime type declared, whether the parameter is
    // handed the class that declared it or a subclass that inherited it.
    let tally = new Tally(7);
    let counted = new Counted(7);
    print("declared class parameter {hashThrough(tally) == tally.hash()} "
        + "{hashThrough(counted) == counted.hash()} {hashThrough(counted) == tally.hash()}");

    let byTicket = new Map<Ticket, string>();
    byTicket.set(ticket, "four");
    string four = byTicket.get(sameTicket) ?? "missing";
    byTicket.set(sameTicket, "still four");
    print("declared struct keys {four} {byTicket.length()}");
    return 0;
}
