// @expect-error Method 'fail' of class 'Channel' is protected, and 'Channel' is 'export', so a subclass in another package can call it, but its thrown type uses 'HiddenError', which is private to module 'main'. Mark 'HiddenError' as 'export'.
// A protected member of an open export class is reachable by subclasses in
// other packages, so its signature may not mention a less visible type.
class HiddenError extends Error {
    protected constructor() {
        super("hidden");
    }
}

export class Channel {
    export constructor();

    protected fail() throws HiddenError {
        throw new HiddenError();
    }
}

main() -> int {
    return 0;
}
