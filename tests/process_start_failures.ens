// @exit 0
// @stdout could not start '<scratch>/missing-program': nothing is there. Check that the path names the program
// @stdout could not start '<scratch>/tools': it is a directory, not a program. Name the program inside the directory
// @stdout could not start '<scratch>/data.bin': it is not a program. Check that the path names a program, not a document or data file
// @stdout could not start '<program>': the working directory '<scratch>/gone', the directory the program would run in, is not a directory that exists. Create it, or start the program in one that does
// @stdout could not start '<program>': the working directory '<scratch>/notes.txt' is a file, not a directory. Start the program in a directory
// Each part of a start that can fail is named in its own words. The scratch folder and this
// program's own path differ from run to run, so they are written as placeholders.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import TemporaryDirectory from @std.fs.temporary;
import @std.environment;
import ProcessError from @std.process;
import @std.process;

main() -> int {
    let scratch = try TemporaryDirectory.create("ens-start-failures");
    Path root = scratch.path();
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("this system did not report the path of this program");
        return 1;
    }
    try root.join("tools").createDirectories();
    Path data = root.join("data.bin");
    try data.writeText("not a program");
    Path notes = root.join("notes.txt");
    try notes.writeText("not a directory");
    print(placed(failureOf(root.join("missing-program")), root, self));
    print(placed(failureOf(root.join("tools")), root, self));
    print(placed(failureOf(data), root, self));
    print(placed(failureIn(self, root.join("gone")), root, self));
    print(placed(failureIn(self, notes), root, self));
    return 0;
} catch (FileSystemError refused) {
    eprint("process_start_failures: {refused.message}");
    return 1;
}

// The message the start of `program` failed with.
failureOf(Path program) -> string {
    let result = try process.run(program);
    return "'{program}' started";
} catch (ProcessError refused) {
    return refused.message;
}

// The message the start of `program` in `directory` failed with.
failureIn(Path program, Path directory) -> string {
    let result = try process.run(program, workingDirectory: directory);
    return "'{program}' started in '{directory}'";
} catch (ProcessError refused) {
    return refused.message;
}

// The message with the scratch folder and this program's path written as placeholders.
placed(string message, Path root, Path self) -> string {
    return message.replace(self.toString(), "<program>").replace(root.toString(), "<scratch>");
}
