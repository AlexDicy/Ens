// @exit 0
// @stdout {"x": 1, "y": -2}
// @stdout {"x": 1, "y": -2}
// @stdout {"flavor": "Salty", "count": 7, "total": 900000000000, "ready": true, "initial": "A", "gap": "\t", "label": "a\"b\\c\n", "weight": 1.5, "origin": {"x": 3, "y": 4}}
// @stdout {"flavor": "Salty", "count": 7, "total": 900000000000, "ready": true, "initial": "A", "gap": "\t", "label": "a\"b\\c\n", "weight": 1.5, "origin": {"x": 3, "y": 4}}
// @stdout {"flavor": "Sour", "count": -1, "total": 0, "ready": false, "initial": "Z", "gap": " ", "label": "", "weight": 0, "origin": {"x": 0, "y": 0}}

// The JSON text of a struct, through an interpolation hole and through
// '.toString()', which must agree. Fields come in declaration order whatever
// their visibility: integers and longs as decimals, bool as true or false, a
// char as a one-character quoted string, a string quoted with its escapes, an
// enum member as its quoted name, a double through the shortest decimal form,
// and a nested struct as its own object.

enum Flavor { Sweet, Salty, Sour }

struct Point {
    protected int x;
    protected int y;
}

struct Sample {
    protected Flavor flavor;
    protected int count;
    protected long total;
    protected bool ready;
    protected char initial;
    protected char gap;
    protected string label;
    protected double weight;
    protected Point origin;
}

main() -> int {
    Point p = {x: 1, y: -2};
    print("{p}");
    print(p.toString());

    Sample first = {flavor: Flavor.Salty, count: 7, total: 900000000000, ready: true,
        initial: 'A', gap: '\t', label: "a\"b\\c\n", weight: 1.5,
        origin: {x: 3, y: 4}};
    print("{first}");
    print(first.toString());

    Sample second = {flavor: Flavor.Sour, count: -1, total: 0, ready: false,
        initial: 'Z', gap: ' ', label: "", weight: 0.0, origin: {x: 0, y: 0}};
    print("{second}");

    return 0;
}
