// @expect-error use a 'default' arm instead
sealed abstract class Expr { Expr(); }
class Num extends Expr { Num() { super(); } }

main() -> int {
    Expr e = new Num();
    switch (e) {
        is Expr -> { },       // matches everything: that is what default is for
        is Num -> { },
    }
    return 0;
}
