// @expect-error 'is Expr' matches every value of this switch over 'Expr', so the switch always takes this arm. Write the statements of this arm instead of the switch.
sealed abstract class Expr { protected constructor(); }
class Num extends Expr { protected constructor() { super(); } }

main() -> int {
    Expr e = new Num();
    switch (e) {
        is Expr -> { },       // matches everything: that is what default is for
        is Num -> { },
    }
    return 0;
}
