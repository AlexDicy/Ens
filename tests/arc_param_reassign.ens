// @stdout dtor 99
// @stdout after call, r=99
// @stdout x.v=1
// @stdout returned 50
// @stdout dtor 10
// @stdout dtor 20
// @stdout twice 20
// @stdout dtor 30
// @stdout dtor 31
// @stdout dtor 32
// @stdout loop 32
// @stdout dtor 60
// @stdout optional 60
// @stdout string abc
// @stdout array 7
// @stdout end
// @stdout dtor 4
// @stdout dtor 3
// @stdout dtor 2
// @stdout dtor 50
// @stdout dtor 1
class Noisy {
    protected long v;

    protected constructor(this.v);

    destructor() {
        print("dtor {this.v}");
    }
}

reassign(Noisy n) -> long {
    n = new Noisy(99);
    return n.v;
}

reassignReturn(Noisy n) -> Noisy {
    n = new Noisy(50);
    return n;
}

reassignTwice(Noisy n) -> long {
    n = new Noisy(10);
    n = new Noisy(20);
    return n.v;
}

reassignLoop(Noisy n) -> long {
    for (long i = 0; i < 3; i++) {
        n = new Noisy(30 + i);
    }
    return n.v;
}

reassignOptional(Noisy? n) -> long {
    n = new Noisy(60);
    if (n == null) {
        return -1;
    }
    return n.v;
}

reassignString(string s) -> string {
    s += "b";
    s = s + "c";
    return s;
}

reassignArray(long[] a) -> long {
    a = [7, 8, 9];
    return a[0];
}

main() -> int {
    let x = new Noisy(1);
    long r = reassign(x);
    print("after call, r={r}");
    print("x.v={x.v}");

    let out = reassignReturn(x);
    print("returned {out.v}");

    let b = new Noisy(2);
    print("twice {reassignTwice(b)}");

    let c = new Noisy(3);
    print("loop {reassignLoop(c)}");

    let d = new Noisy(4);
    print("optional {reassignOptional(d)}");

    print("string {reassignString("a")}");
    long[] arr = [1, 2];
    print("array {reassignArray(arr)}");
    print("end");
    return 0;
}
