// @exit 134
// @stdout-at O0   at fail (inline_traces.ens:26)
// @stdout-at O2   at fail (inline_traces.ens:26, inlined)
// @stdout   at check (inline_traces.ens:30)
// @stdout   at attempt (inline_traces.ens:34)
// @stdout   at main (inline_traces.ens:45)
// @stdout fail 26
// @stdout check 30
// @stdout attempt 34
// @stdout main 45
// @stderr panic: tried to read index 3 of an array of length 1. Check the index against 'length' first
// @stderr-at O0   at element (inline_traces.ens:41)
// @stderr-at O2   at element (inline_traces.ens:41, inlined)
// @stderr   at main (inline_traces.ens:53)
// A small function is copied into the function that calls it at -O2, and a trace still names it
// with its own line, marked as inlined, ahead of the function it was copied into. The throw out of
// 'fail' is caught two frames up, in 'attempt', and the panic is inside 'element'; the structured
// frames are the same at every level.
class Failure extends Error {
    protected constructor() {
        super("failed");
    }
}

fail(Failure failure) -> int throws Failure {
    throw failure;
}

check(Failure failure) -> int throws Failure {
    return try fail(failure) + 1;
}

attempt() -> Failure? {
    let ignored = try check(new Failure());
    return null;
} catch (Failure e) {
    return e;
}

element(int[] items, long index) -> int {
    return items[index];
}

main() -> int {
    let caught = attempt();
    if (caught != null) {
        print(caught.stackTrace().trimEnd());
        for (let frame in caught.stackFrames()) {
            print("{frame.function} {frame.line}");
        }
    }
    int[] items = [7];
    return element(items, 3);
}
