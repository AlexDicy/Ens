// @exit 134
// @stdout-at O0   at fail (inline_traces.ens:28)
// @stdout-at O2   at fail (inline_traces.ens:28, inlined)
// @stdout-at O0   at check (inline_traces.ens:32)
// @stdout-at O2   at check (inline_traces.ens:32, inlined)
// @stdout-at O0   at attempt (inline_traces.ens:36)
// @stdout-at O2   at attempt (inline_traces.ens:36, inlined)
// @stdout   at main (inline_traces.ens:47)
// @stdout fail 28
// @stdout check 32
// @stdout attempt 36
// @stdout main 47
// @stderr panic: tried to read index 3 of an array of length 1. Check the index against 'length' first
// @stderr-at O0   at element (inline_traces.ens:43)
// @stderr-at O2   at element (inline_traces.ens:43, inlined)
// @stderr   at main (inline_traces.ens:55)
// A small function, or one called from a single place, is copied into its caller at -O2, and a
// trace still names it with its own line, marked as inlined, ahead of its caller's frame. The
// throw out of 'fail' is caught two frames up, in 'attempt', and the panic is inside 'element';
// the structured frames are the same at every level.
class Failure extends Error {
    protected constructor() {
        super("failed");
    }
}

fail(Failure failure) -> int throws Failure {
    throw failure;
}

check(Failure failure) -> int throws Failure {
    return try fail(failure) + 1;
}

attempt() -> Failure? {
    let ignored = try check(new Failure());
    return null;
} catch (Failure e) {
    return e;
}

element(int[] items, long index) -> int {
    return items[index];
}

main() -> int {
    let caught = attempt();
    if (caught != null) {
        print(caught.stackTrace().trimEnd());
        for (let frame in caught.stackFrames()) {
            print("{frame.function} {frame.line}");
        }
    }
    int[] items = [7];
    return element(items, 3);
}
