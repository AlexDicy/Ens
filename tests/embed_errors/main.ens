// @expect-error Cannot embed 'nothing.dat': there is no file at '
// @expect-error embed_errors/nothing.dat'. Check the spelling, or create the file.
// @expect-error 'assets' is a folder, and 'embed' reads one file. Write 'embed folder "assets"' to embed every file in it.
// @expect-error 'data.dat' is a file, and 'embed folder' reads every file in a folder. Remove 'folder' to embed this one file.
// @expect-error Cannot embed 'nowhere': there is no folder at '
// @expect-error embed_errors/nowhere'. Check the spelling, or create the folder.
// @expect-error Folders in an 'embed' path are separated with '/' on every system. Write 'assets/one.dat'.
// @expect-error '/etc/hosts' is an absolute path, so the program would build only where that file is. Write the path relative to the folder 'main.ens' is in.
// @expect-error '../../README.md' names '
// @expect-error /README.md', which is outside '
// @expect-error /tests', the folder this program is built from. Move the file into that folder.
// @expect-error 'embed' needs the path of a file between the quotes, as in 'embed "logo.png"'.
// @expect-error 'embed folder' needs the path of a folder between the quotes, as in 'embed folder "assets"'.
// @expect-error build failed with 9 problems
main() -> int {
    bytes missing = embed "nothing.dat";
    bytes folder = embed "assets";
    let file = embed folder "data.dat";
    let missingFolder = embed folder "nowhere";
    bytes backslash = embed "assets\\one.dat";
    bytes absolute = embed "/etc/hosts";
    bytes outside = embed "../../README.md";
    bytes empty = embed "";
    let emptyFolder = embed folder "";
    return 0;
}
