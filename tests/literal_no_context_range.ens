// @exit 42
// A literal that nothing gives a type to takes its own default, and that default has to hold
// the value. These are the forms right at the boundary, which do hold and so stay accepted.
main() -> int {
    // The default is 'int', and both ends of its range fit.
    let lastInt = 2147483647;
    let firstInt = -2147483648;
    if (lastInt != 2147483647)                  { return 1; }
    if (firstInt != -2147483648)                { return 2; }

    // A suffix moves the default to 'long', whose most negative value is only reachable
    // through the sign sitting outside the literal.
    let firstLong = -9223372036854775808L;
    if (firstLong != -9223372036854775808L)     { return 3; }

    // Naming a wider type is how a larger value is written.
    long beyondInt = 3000000000;
    ulong beyondLong = 18446744073709551615;
    if (beyondInt != 3000000000L)               { return 4; }
    if (beyondLong != 18446744073709551615)     { return 5; }

    // A cast names the width, so a literal the target holds adapts to it and stays exact
    // rather than passing through its default type first.
    uint full = 4294967295 as uint;
    long wide = 3000000000 as long;
    if (full != 4294967295)                     { return 6; }
    if (wide != 3000000000L)                    { return 7; }

    // A narrowing cast is still a deliberate truncation, which the language documents.
    byte truncated = 300 as byte;
    if (truncated != 44)                        { return 8; }

    // The floating-point default is 'double', and its limit is far out.
    let largestDouble = 1.7e308;
    if (largestDouble < 1.0e308)                { return 9; }

    return 42;
}
