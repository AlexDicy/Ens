// @exit 5
class Leaf {
    Leaf? next;
    constructor(this.next = null);

    self() -> Leaf {
        return this;
    }
}

class Node {
    Leaf? leaf;
    constructor(this.leaf = null);
}

main() -> int {
    int score = 0;

    let leaf = new Leaf();
    let chained = new Leaf(new Leaf());
    let emptyNode = new Node();
    let fullNode = new Node(leaf);

    Node? nullNode = null;
    Node? optEmpty = emptyNode;
    Node? optFull = fullNode;
    Leaf? optChained = chained;
    Leaf? optLeaf = leaf;

    // 1. ?.field on null receiver yields null.
    if (nullNode?.leaf == null) {
        score = score + 1;
    }

    // 2. ?.field on non-null receiver with null field yields null.
    if (optEmpty?.leaf == null) {
        score = score + 1;
    }

    // 3. ?.field on non-null receiver yields the field value.
    if (optFull?.leaf != null) {
        score = score + 1;
    }

    // 4. Two-level chain a?.b?.c reaches through both nullable links.
    if (optChained?.next?.next == null) {
        if (optChained?.next != null) {
            score = score + 1;
        }
    }

    // 5. ?.method() on non-null receiver returns the method result wrapped as nullable.
    if (optLeaf?.self() != null) {
        score = score + 1;
    }

    return score;
}
