// @exit 0
// A user FFI declaration of a libc function, here `strlen` typed to return `int`, must not perturb
// the runtime's own use of that symbol, which types it as `i64`. Both share the one libc symbol,
// but each call site keeps its own signature, so neither corrupts the other.
external from libc {
    strlen(byte[] s) -> int;
    getenv(string name) -> string?;
}

main() -> int {
    byte[] buf = new byte[4];
    buf[0] = 'H';
    buf[1] = 'i';
    buf[2] = '!';
    // buf[3] stays 0 (NUL): the user's strlen sees a 3-byte string.
    if (strlen(buf) != 3) { return 1; }

    // getenv's string return goes through the runtime string-from-cstr path,
    // which calls libc strlen as i64 in the same module as the i32 declaration.
    string? path = getenv("PATH");
    if (path == null) { return 2; }
    return 0;
}