// @expect-error Method 'hash' of struct 'Key' replaces the built-in content hash but is not marked 'override'. Write 'override' before 'hash'.
// A struct already hashes by its contents, so a struct's own 'hash' replaces a behavior
// the language provides and is written with 'override', exactly like a struct's
// 'toString' and 'equals' and a class's 'hash' and 'equals'.

public struct Key {
    int id;

    public hash() -> long {
        return this.id;
    }

    public override equals(Key other) -> bool {
        return this.id == other.id;
    }
}

main() -> int {
    Key key = {id: 1};
    print("{key.hash()}");
    return 0;
}
