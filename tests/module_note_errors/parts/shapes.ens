import Kind as MainKind from main;
import Link from main;

public enum Kind {
    Small,
    Large,
    Medium,
}

public class Holder {
    public const int count;
    int secret = 0;
    protected int guarded = 0;

    public constructor() {
        this.count = 1;
    }

    public static make() -> Holder {
        return new Holder();
    }
}

public struct Spot {
    public int x;

    public constructor(this.x);
}

public kind() -> Kind {
    return Kind.Small;
}

public holder() -> Holder {
    return new Holder();
}

public kinds() -> Kind[] {
    return [Kind.Small];
}

public spot() -> Spot {
    return Spot(1);
}

public use(Kind kind) {
}

public apply((Kind) -> int pick) {
}

public class Plain {
}

public combine((Kind, MainKind) -> int pick) {
}

public class Sealed {
    constructor() {
    }
}

public class Shaped {
    public constructor(int size) {
    }
}

public interface Living {
}

public class Animal implements Living {
    public constructor() {
    }
}

public class Dog extends Animal {
    public constructor() {
        super();
    }
}

public living() -> Living {
    return new Dog();
}

public struct Gauge {
    public byte level;

    public constructor(this.level);
}

public gauge(Gauge measured) {
}

public place(Spot placed) {
}

public struct Ring {
    Link link;
}

public mark(Kind kind) {
}

public mark(int count) {
}

public interface Rated {
}

public struct Score implements Rated {
    public int value;

    public constructor(this.value);
}

public score() -> Score {
    return Score(1);
}

public rate(Rated rated) {
}
