import Kind as MainKind from main;

public enum Kind {
    Small,
    Large,
}

public class Holder {
    public const int count;
    int secret = 0;

    public constructor() {
        this.count = 1;
    }

    public static make() -> Holder {
        return new Holder();
    }
}

public struct Spot {
    public int x;

    public constructor(this.x);
}

public kind() -> Kind {
    return Kind.Small;
}

public holder() -> Holder {
    return new Holder();
}

public kinds() -> Kind[] {
    return [Kind.Small];
}

public spot() -> Spot {
    return Spot(1);
}

public use(Kind kind) {
}

public apply((Kind) -> int pick) {
}

public class Plain {
}

public combine((Kind, MainKind) -> int pick) {
}
