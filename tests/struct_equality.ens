// @exit 0
// @stdout flat eq
// @stdout flat ne
// @stdout nested eq
// @stdout nested ne
// @stdout nullable both-null eq
// @stdout nullable one-null ne
// @stdout content eq across fields
// @stdout string field ne
// @stdout class identity ne
// @stdout generic int eq
// @stdout generic string ne
// @stdout nan ne
// @stdout declared equals ignored
// @stdout optional class and string eq
// @stdout optional string content ne
// @stdout optional one-absent ne
// @stdout optional both-absent eq

// Every struct comparison rule in one place: flat and nested memberwise '==',
// null-aware optional fields, a string field, a class field by identity, a class
// field that opted into content equality, a nullable class and string field, a
// generic struct at two instantiations, IEEE NaN inequality, and a struct method
// shaped like equality that '==' ignores.

class Tag {
    int id;
    protected constructor(this.id);
}

// A class that opts into content equality: two distinct 'Name' objects with the
// same text compare equal, and a struct field of this type follows suit.
class Name {
    string text;
    protected constructor(this.text);
    override hash() -> long { return this.text.length; }
    override equals(Name other) -> bool { return this.text == other.text; }
}

struct Point {
    protected int x;
    protected int y;
}

struct Segment {
    protected Point from;
    protected Point to;
}

struct Record {
    protected string label;
    protected int? count;
    protected Tag tag;
    protected Name name;
}

// A nullable class field and a nullable string field: each compares exactly as its
// non-optional spelling does, so the class's declared equality and the string's
// bytes still decide, and an absence on one side only settles it first.
struct Labeled {
    protected Name? name;
    protected string? text;
}

struct Box<T> {
    protected T value;
}

struct FloatBox {
    protected double value;
}

// A struct method shaped like an equality method stays an ordinary method; '=='
// remains memberwise and never dispatches to it.
struct Sneaky {
    protected int value;
    equals(Sneaky other) -> bool {
        return true;
    }
}

notANumber() -> double {
    double zero = 0.0;
    return zero / zero;
}

main() -> int {
    Point p = {x: 1, y: 2};
    Point q = {x: 1, y: 2};
    Point r = {x: 1, y: 9};
    if (p == q) { print("flat eq"); }
    if (p != r) { print("flat ne"); }

    Segment s1 = {from: {x: 1, y: 2}, to: {x: 3, y: 4}};
    Segment s2 = {from: {x: 1, y: 2}, to: {x: 3, y: 4}};
    Segment s3 = {from: {x: 1, y: 2}, to: {x: 3, y: 5}};
    if (s1 == s2) { print("nested eq"); }
    if (s1 != s3) { print("nested ne"); }

    let tag = new Tag(1);
    let first = new Name("a");
    let second = new Name("a");
    Record base = {label: "x", count: 5, tag: tag, name: first};

    Record absentA = {label: "x", count: null, tag: tag, name: first};
    Record absentB = {label: "x", count: null, tag: tag, name: first};
    if (absentA == absentB) { print("nullable both-null eq"); }
    if (base != absentA) { print("nullable one-null ne"); }

    // Equal content through a distinct 'Name' object (content equality), the same
    // 'Tag' identity, and an equal present count.
    Record twin = {label: "x", count: 5, tag: tag, name: second};
    if (base == twin) { print("content eq across fields"); }

    Record otherLabel = {label: "y", count: 5, tag: tag, name: first};
    if (base != otherLabel) { print("string field ne"); }

    Record otherTag = {label: "x", count: 5, tag: new Tag(1), name: first};
    if (base != otherTag) { print("class identity ne"); }

    Box<int> boxIntA = {value: 7};
    Box<int> boxIntB = {value: 7};
    if (boxIntA == boxIntB) { print("generic int eq"); }
    Box<string> boxStrA = {value: "hi"};
    Box<string> boxStrB = {value: "yo"};
    if (boxStrA != boxStrB) { print("generic string ne"); }

    FloatBox nanA = {value: notANumber()};
    FloatBox nanB = {value: notANumber()};
    if (nanA != nanB) { print("nan ne"); }

    Sneaky sneakyA = {value: 1};
    Sneaky sneakyB = {value: 2};
    if (sneakyA != sneakyB) { print("declared equals ignored"); }

    // A distinct 'Name' object holding the same text and a separately built equal
    // string, so neither field can be answering by identity.
    Labeled labeled = {name: first, text: "alpha"};
    Labeled twinLabeled = {name: second, text: "alph" + "a"};
    Labeled otherText = {name: first, text: "beta"};
    Labeled noName = {name: null, text: "alpha"};
    Labeled alsoNoName = {name: null, text: "alpha"};
    Labeled noText = {name: first, text: null};
    if (labeled == twinLabeled) { print("optional class and string eq"); }
    if (labeled != otherText) { print("optional string content ne"); }
    if (labeled != noName && labeled != noText) { print("optional one-absent ne"); }
    if (noName == alsoNoName) { print("optional both-absent eq"); }

    return 0;
}
