// @exit 70
class Box {
    int v;
    constructor(this.v = 0);
}

main() -> int {
    // 2D primitive grid, fully allocated in one call.
    int[][] grid = new int[3][4];
    grid[0][0] = 10;
    grid[1][2] = 20;
    grid[2][3] = 40;
    if (grid.length != 3L) { return 1; }
    if (grid[0].length != 4L) { return 2; }
    if (grid[1].length != 4L) { return 3; }

    int sum = grid[0][0] + grid[1][2] + grid[2][3];
    if (sum != 70) { return 4; }

    // 3D allocation: 2 x 3 x 4.
    int[][][] cube = new int[2][3][4];
    if (cube.length != 2L) { return 5; }
    if (cube[1][2].length != 4L) { return 6; }

    // Nullable element type works with multi-dim, inner slots are still
    // null-initialised; only the array spine is allocated.
    Box?[][] boxes = new Box?[2][3];
    if (boxes.length != 2L) { return 7; }
    if (boxes[0].length != 3L) { return 8; }
    if (boxes[1][0] != null) { return 9; }
    boxes[0][1] = new Box(99);
    Box? cell = boxes[0][1];
    if (cell != null) {
        if (cell.v != 99) { return 10; }
    } else {
        return 11;
    }

    return sum;
}
