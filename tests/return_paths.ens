// @exit 0
// @stdout branch=1
// @stdout switch=2
// @stdout catch=-1
// @stdout first=5
// Terminating shapes accepted by the missing-return check: if/else chains,
// exhaustive switches, 'while (true)' and a 'for' with no condition when no break binds to them,
// panic, and catch clauses.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

enum Color {
    Red,
    Green,
    Blue,
}

branches(int x) -> int {
    if (x > 0) {
        return 1;
    } else if (x < 0) {
        return -1;
    } else {
        panic("zero is not supported");
    }
}

pick(Color color) -> int {
    switch (color) {
        Red -> { return 1; }
        Green -> { return 2; }
        Blue -> { return 3; }
    }
}

// Never called: a 'while (true)' loop with no break counts as terminating.
spinForever() -> int {
    while (true) {
        let unused = 0;
    }
}

// Never called: a 'for' with no condition and no break counts as terminating too.
spinForeverByFor() -> int {
    for (;;) {
        let unused = 0;
    }
}

firstAbove(int[] values, int floor) -> int {
    for (long i = 0; ; i++) {
        if (values[i] > floor) {
            return values[i];
        }
    }
}

mayThrow(int x) -> int throws {
    if (x < 0) {
        throw new Failure("negative");
    }
    return x;
}

viaCatch() -> int {
    return try mayThrow(-5);
} catch (Error e) {
    return -1;
}

main() -> int {
    print("branch={branches(7)}");
    print("switch={pick(Color.Green)}");
    print("catch={viaCatch()}");
    print("first={firstAbove([1, 3, 5, 7], 4)}");
    return 0;
}
