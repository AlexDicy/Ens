// @exit 0
// @stdout widened: 97 97 97 97
// @stdout passed and returned: 97 97
// @stdout element and field: 97 97
// @stdout joined: 97 97 98
// @stdout past 16 bits: 128512 128512
// A 'char' value converts to 'int', 'uint', 'long' and 'ulong' on its own, since each of them has
// room for every code point, so it converts through a declaration, an argument, a return, an
// array element, a field, '??', '?:' and an operator beside an 'int', and keeps its number.
class Counter {
    int code = 0;
}

takesInt(int value) -> int {
    return value;
}

codeOf(char letter) -> int {
    return letter;
}

main() -> int {
    char letter = 'a';
    int asInt = letter;
    uint asUInt = letter;
    long asLong = letter;
    ulong asULong = letter;
    print("widened: {asInt} {asUInt} {asLong} {asULong}");
    print("passed and returned: {takesInt(letter)} {codeOf(letter)}");
    int[] codes = [letter];
    let counter = new Counter();
    counter.code = letter;
    print("element and field: {codes[0]} {counter.code}");
    int? missing = null;
    int fallback = missing ?? letter;
    bool flag = false;
    int chosen = flag ? 0 : letter;
    int one = 1;
    int next = letter + one;
    print("joined: {fallback} {chosen} {next}");
    char face = '😀';
    int wideInt = face;
    uint wideUInt = face;
    print("past 16 bits: {wideInt} {wideUInt}");
    return 0;
}
