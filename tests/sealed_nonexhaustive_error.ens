// @expect-error does not handle subclasses 'Neg', 'Add' of sealed class 'Expr'. Add arms for them or a 'default' arm.
sealed abstract class Expr { protected constructor(); }
class Num extends Expr { protected constructor() { super(); } }
class Neg extends Expr { constructor() { super(); } }
class Add extends Expr { constructor() { super(); } }

main() -> int {
    Expr e = new Num();
    switch (e) {
        is Num -> { },
    }
    return 0;
}
