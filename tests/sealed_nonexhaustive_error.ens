// @expect-error does not handle subclass(es) 'Neg', 'Add' of sealed class 'Expr'
sealed abstract class Expr { constructor(); }
class Num extends Expr { constructor() { super(); } }
class Neg extends Expr { constructor() { super(); } }
class Add extends Expr { constructor() { super(); } }

main() -> int {
    Expr e = new Num();
    switch (e) {
        is Num -> { },
    }
    return 0;
}
