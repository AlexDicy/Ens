// '?.' and '?[' read a value that is null when what stands in front of them is null, so neither
// can be written through: there would be nowhere to store into. The refusal names the value to
// check and spells the same write without its '?' inside a null check, and it names the value
// alone where the rest of the write is too long to quote, or nothing where the value is. A
// compound operator reports its own refusal beside it, since a nullable is not a number.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) { maybe.value = ...; }'.
// @expect-error '?[' cannot appear on the left side of '=', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { slots[0] = ...; }'.
// @expect-error '?.' cannot appear on the left side of '+=', because there is nothing to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) { maybe.value += ...; }'.
// @expect-error '+=' needs numbers on both sides, got 'int?' and 'int'.
// @expect-error '?[' cannot appear on the left side of '<<=', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { slots[0] <<= ...; }'.
// @expect-error '<<=' shifts an integer, got 'int?'.
// @expect-error '?[' cannot appear on the left side of '=', because there is nothing to write to when 'slots' is null. Check for null first, then write the same line without the '?'.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when the value in front of it is null. Check for null first, then write the same line without the '?'.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'held.inner' is null. Check for null first, as in 'if (held.inner != null) { held.inner.value = ...; }'.
// @expect-error build failed with 10 problems

public class Inner {
    public int value = 0;

    public constructor();
}

public class Outer {
    public Inner? inner = null;

    public constructor();
}

main() -> int {
    Inner? maybe = null;
    int[]? slots = null;
    int i = 0;
    maybe?.value = 3;
    slots?[0] = 4;
    maybe?.value += 1;
    slots?[0] <<= 1;
    (maybe?.value) = 5;
    slots?[i + 1] = 7;
    Outer? outer = null;
    outer?.inner?.value = 6;
    let held = new Outer();
    held.inner?.value = 8;
    return 0;
}
