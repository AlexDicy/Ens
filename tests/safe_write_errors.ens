// '?.' and '?[' read a value that is null when what stands in front of them is null, so neither
// can be written through: there would be nowhere to store into. A compound operator and '--'
// through '?[' are refused the same way, with the same write spelled without its '?' inside a
// null check.
// @expect-error '?[' cannot appear on the left side of '<<=', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { slots[0] <<= ...; }'.
// @expect-error '--' cannot change 'slots?[0]' through '?[', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { --slots[0]; }'.
// @expect-error '?[' cannot appear on the left side of '=', because there is nothing to write to when 'rows' is null. 'rows' can never be null here, so write 'rows[0] = ...'.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'box' is null. 'box' can never be null here, so write 'box.n = ...'.
// @expect-error build failed with 4 problems

class Box {
    int n;

    protected constructor(this.n);
}

main() -> int {
    int[]? slots = null;
    slots?[0] <<= 1;
    --slots?[0];
    int[]?? rows = [1];
    rows?[0] = 5;
    Box?? box = new Box(1);
    box?.n = 5;
    return 0;
}
