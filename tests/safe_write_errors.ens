// '?.' and '?[' read a value that is null when what stands in front of them is null, so neither
// can be written through: there would be nowhere to store into. The refusal names the value to
// check and spells the same write without its '?' inside a null check, and it names the value
// alone where the rest of the write is too long to quote, or nothing where the value is. A
// compound operator, '++' and '--' get the same refusal. A field that is nullable itself is
// refused for its null only once the '?.' is gone.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) { maybe.value = ...; }'.
// @expect-error '?[' cannot appear on the left side of '=', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { slots[0] = ...; }'.
// @expect-error '?.' cannot appear on the left side of '+=', because there is nothing to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) { maybe.value += ...; }'.
// @expect-error '?[' cannot appear on the left side of '<<=', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { slots[0] <<= ...; }'.
// @expect-error '++' cannot change 'maybe?.value' through '?.', because there is nothing to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) { maybe.value++; }'.
// @expect-error '--' cannot change 'slots?[0]' through '?[', because there is nothing to write to when 'slots' is null. Check for null first, as in 'if (slots != null) { --slots[0]; }'.
// @expect-error '?[' cannot appear on the left side of '=', because there is nothing to write to when 'slots' is null. Check for null first, then write the same line without the '?'.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'outer?.inner' is null. Copy 'outer?.inner' into a local first ('let inner = outer?.inner;') and check the local, as in 'if (inner != null) { inner.value = ...; }'.
// @expect-error '?.' cannot appear on the left side of '=', because there is nothing to write to when 'held.inner' is null. Copy 'held.inner' into a local first ('let inner = held.inner;') and check the local, as in 'if (inner != null) { inner.value = ...; }'.
// @expect-error '?.' cannot appear on the left side of '+=', because there is nothing to write to when 'counted' is null. Check for null first, as in 'if (counted != null) { counted.count += ...; }'.
// @expect-error '+=' needs numbers on both sides, but 'counted.count' has type 'int?'. 'counted.count' is a field, so it can change at any time. A later read of it can be null even after a null check. Copy it into a local first ('let count = counted.count;'), check the local, and write the result back to 'counted.count'.
// @expect-error build failed with 12 problems

public class Inner {
    public int value = 0;

    public constructor();
}

public class Counted {
    public int? count = 1;

    public constructor();
}

public class Outer {
    public Inner? inner = null;

    public constructor();
}

main() -> int {
    Inner? maybe = null;
    int[]? slots = null;
    int i = 0;
    maybe?.value = 3;
    slots?[0] = 4;
    maybe?.value += 1;
    slots?[0] <<= 1;
    maybe?.value++;
    --slots?[0];
    Counted? counted = null;
    counted?.count += 1;
    if (counted != null) {
        counted.count += 1;
    }
    (maybe?.value) = 5;
    slots?[i + 1] = 7;
    Outer? outer = null;
    outer?.inner?.value = 6;
    let held = new Outer();
    held.inner?.value = 8;
    return 0;
}
