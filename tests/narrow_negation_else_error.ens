// @expect-error No field or method 'radius' on type 'Shape'
// Only the negation form narrows. The plain else branch of a positive `is` test
// still proves nothing: failing a type test says nothing about the operand's type,
// so `s` remains a 'Shape' in the else branch and `s.radius` does not resolve.
class Shape {
    protected constructor();
}

class Circle extends Shape {
    int radius;
    protected constructor(this.radius = 0);
}

main() -> int {
    Shape s = new Circle(5);
    if (s is Circle) {
    } else {
        int r = s.radius;
    }
    return 0;
}
