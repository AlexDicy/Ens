// @exit 134
// @stderr-contains tried to lock a mutex inside a body this task is already running under its lock, which would wait for ever. Use the value that body was given instead
// A body that locks the mutex it runs under would wait for itself, so the program ends instead.
import Mutex from @std.tasks;

final class Tally {
    long count = 0;
}

main() -> int {
    let tally = new Mutex<Tally>(new Tally());
    tally.lock((outer) -> {
        tally.lock((inner) -> {
            inner.count = 1;
        });
    });
    return 0;
}
