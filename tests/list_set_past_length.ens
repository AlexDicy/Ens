// @exit 134
// @stdout length 1
// @stderr-contains panic: list index 3 is out of bounds for length 1
// Writing past the length is refused the same way reading is: the slot is inside the backing
// store but outside the list, so accepting the write would leave a value the length says is not
// there.
import List from @std.collections.list;

main() -> int {
    let numbers = new List<long>();
    numbers.push(7L);
    print("length {numbers.length()}");
    numbers.set(3, 99L);
    return 0;
}
