// @exit 0
// @stdout released equality left
// @stdout caught equality
// @stdout released optional equality left
// @stdout caught optional equality
// @stdout released wrapper
// @stdout caught construction
// @stdout released array element
// @stdout caught array
// @stdout released first
// @stdout caught literal
// @stdout released nested
// @stdout caught nested literal
// @stdout released default
// @stdout caught struct construction
// @stdout all done
// An owned temporary the expression is still holding when a later part throws is released on the
// unwind path rather than leaked, and so is every field a struct being built already holds. Each
// object reports its own release, and it has to arrive before the catch body runs.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

class Wrapper {
    protected long value;

    protected constructor(this.value);

    destructor() {
        print("released wrapper");
    }
}

struct Cell {
    protected Probe probe;
}

struct Pair {
    protected Probe first;
    protected Probe second;
}

struct Outer {
    protected Cell cell;
    protected long count;
}

struct Defaulted {
    protected Probe extra = new Probe("default");
    protected Probe given;

    protected constructor(Probe given) {
        this.given = given;
    }
}

fresh(string label) -> Probe {
    return new Probe(label);
}

refuseProbe() -> Probe throws {
    throw new Failure("no probe");
}

freshCell(string label) -> Cell? {
    return {probe: new Probe(label)};
}

refuseCell() -> Cell? throws {
    throw new Failure("no cell");
}

refuseLong() -> long throws {
    throw new Failure("no value");
}

compare() -> bool throws {
    return fresh("equality left") == (try refuseProbe());
}

compareOptionals() -> bool throws {
    return freshCell("optional equality left") == (try refuseCell());
}

construct() -> Wrapper throws {
    return new Wrapper(try refuseLong());
}

collect() -> Probe[] throws {
    return [fresh("array element"), try refuseProbe()];
}

literal() -> Pair throws {
    return {first: fresh("first"), second: try refuseProbe()};
}

nestedLiteral() -> Outer throws {
    return {cell: {probe: fresh("nested")}, count: try refuseLong()};
}

constructStruct() -> Defaulted throws {
    return Defaulted(try refuseProbe());
}

attemptCompare() {
    try compare();
} catch (Failure e) {
    print("caught equality");
}

attemptCompareOptionals() {
    try compareOptionals();
} catch (Failure e) {
    print("caught optional equality");
}

attemptConstruct() {
    try construct();
} catch (Failure e) {
    print("caught construction");
}

attemptCollect() {
    try collect();
} catch (Failure e) {
    print("caught array");
}

attemptLiteral() {
    try literal();
} catch (Failure e) {
    print("caught literal");
}

attemptNestedLiteral() {
    try nestedLiteral();
} catch (Failure e) {
    print("caught nested literal");
}

attemptConstructStruct() {
    try constructStruct();
} catch (Failure e) {
    print("caught struct construction");
}

main() -> int {
    attemptCompare();
    attemptCompareOptionals();
    attemptConstruct();
    attemptCollect();
    attemptLiteral();
    attemptNestedLiteral();
    attemptConstructStruct();
    print("all done");
    return 0;
}
