// @exit 0
// @stdout released equality left
// @stdout caught equality
// @stdout released optional equality left
// @stdout caught optional equality
// @stdout released wrapper default
// @stdout caught construction
// @stdout released array element
// @stdout caught array
// @stdout released first
// @stdout caught literal
// @stdout released nested
// @stdout caught nested literal
// @stdout released default
// @stdout caught struct construction
// @stdout caught interpolation
// @stdout released title
// @stdout released named default
// @stdout caught chain construction
// @stdout released nested argument
// @stdout caught nested construction
// @stdout caught abandoned argument
// @stdout all done
// An owned temporary the expression is still holding when a later part throws is released on the
// unwind path rather than leaked, and so is every field a struct being built already holds. An
// object whose constructor's argument throws releases what its fields hold without running its
// destructor. A destructor reports each release, and the report has to arrive before the catch
// body runs.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

class Wrapper {
    protected Probe extra = new Probe("wrapper default");
    protected long value;

    protected constructor(this.value);

    destructor() {
        print("released wrapper");
    }
}

class Named {
    protected Probe tag = new Probe("named default");
    protected string name;

    protected constructor(this.name);

    destructor() {
        print("released named " + this.name);
    }
}

class Titled extends Named {
    protected Probe title;

    protected constructor(Probe title, string name) {
        super(name);
        this.title = title;
    }
}

class Holder<T> {
    protected T held;
    protected string label;

    protected constructor(this.held, this.label);

    destructor() {
        print("released holder " + this.label);
    }
}

struct Cell {
    protected Probe probe;
}

struct Pair {
    protected Probe first;
    protected Probe second;
}

struct Outer {
    protected Cell cell;
    protected long count;
}

struct Defaulted {
    protected Probe extra = new Probe("default");
    protected Probe given;

    protected constructor(Probe given) {
        this.given = given;
    }
}

fresh(string label) -> Probe {
    return new Probe(label);
}

refuseProbe() -> Probe throws {
    throw new Failure("no probe");
}

freshCell(string label) -> Cell? {
    return {probe: new Probe(label)};
}

refuseCell() -> Cell? throws {
    throw new Failure("no cell");
}

refuseLong() -> long throws {
    throw new Failure("no value");
}

refuseText() -> string throws {
    throw new Failure("no text");
}

compare() -> bool throws {
    return fresh("equality left") == (try refuseProbe());
}

compareOptionals() -> bool throws {
    return freshCell("optional equality left") == (try refuseCell());
}

construct() -> Wrapper throws {
    return new Wrapper(try refuseLong());
}

collect() -> Probe[] throws {
    return [fresh("array element"), try refuseProbe()];
}

literal() -> Pair throws {
    return {first: fresh("first"), second: try refuseProbe()};
}

nestedLiteral() -> Outer throws {
    return {cell: {probe: fresh("nested")}, count: try refuseLong()};
}

constructStruct() -> Defaulted throws {
    return Defaulted(try refuseProbe());
}

interpolated() -> string throws {
    let probe = new Probe("interpolated {try refuseText()}");
    return probe.label;
}

constructChain() -> Titled throws {
    return new Titled(fresh("title"), try refuseText());
}

constructNested() -> Holder<Probe> throws {
    return new Holder<Probe>(new Probe("nested argument"), try refuseText());
}

constructAbandonedArgument() -> Holder<Probe> throws {
    return new Holder<Probe>(new Probe(try refuseText()), "outer");
}

attemptCompare() {
    try compare();
} catch (Failure e) {
    print("caught equality");
}

attemptCompareOptionals() {
    try compareOptionals();
} catch (Failure e) {
    print("caught optional equality");
}

attemptConstruct() {
    try construct();
} catch (Failure e) {
    print("caught construction");
}

attemptCollect() {
    try collect();
} catch (Failure e) {
    print("caught array");
}

attemptLiteral() {
    try literal();
} catch (Failure e) {
    print("caught literal");
}

attemptNestedLiteral() {
    try nestedLiteral();
} catch (Failure e) {
    print("caught nested literal");
}

attemptConstructStruct() {
    try constructStruct();
} catch (Failure e) {
    print("caught struct construction");
}

attemptInterpolated() {
    print(try interpolated());
} catch (Failure e) {
    print("caught interpolation");
}

attemptConstructChain() {
    try constructChain();
} catch (Failure e) {
    print("caught chain construction");
}

attemptConstructNested() {
    try constructNested();
} catch (Failure e) {
    print("caught nested construction");
}

attemptConstructAbandonedArgument() {
    try constructAbandonedArgument();
} catch (Failure e) {
    print("caught abandoned argument");
}

main() -> int {
    attemptCompare();
    attemptCompareOptionals();
    attemptConstruct();
    attemptCollect();
    attemptLiteral();
    attemptNestedLiteral();
    attemptConstructStruct();
    attemptInterpolated();
    attemptConstructChain();
    attemptConstructNested();
    attemptConstructAbandonedArgument();
    print("all done");
    return 0;
}
