// @exit 134
// @stderr-contains panic: tried to make a JSON number from a NaN, the value a calculation such as 0.0 / 0.0 produces, and JSON has no spelling for it. Check isNaN() first
// @stderr-contains at JsonNumber.of
// A NaN has no JSON form, so this is a contract violation. A panic ends the program, so it is a
// fixture rather than a unit test.
import JsonNumber from @std.json;

main() -> int {
    double zero = 0.0;
    return JsonNumber.of(zero / zero).text.length as int;
}
