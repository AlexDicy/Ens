// @exit 42
// Two sibling class values unify to their nearest common base class, in switch
// expressions and in '?:'. A nullable or 'null' operand keeps the result
// nullable, the base found is the nearest one (not always the root), and a
// generic subclass unifies with its base instantiation.
sealed abstract class Shape {
    constructor();
    abstract kind() -> int;
}

class Circle extends Shape {
    constructor() { super(); }
    override kind() -> int { return 1; }
}

abstract class Polygon extends Shape {
    constructor() { super(); }
}

class Square extends Polygon {
    constructor() { super(); }
    override kind() -> int { return 2; }
}

class Triangle extends Polygon {
    constructor() { super(); }
    override kind() -> int { return 4; }
}

// A switch expression over two sibling arms yields their common base Shape.
pickShape(int n) -> Shape {
    let circle = new Circle();
    let square = new Square();
    return switch (n) {
        1 -> circle,
        default -> square,
    };
}

// Square and Triangle share Polygon, which is nearer than the root Shape; the
// declared Polygon return type only accepts the switch when Polygon is found.
pickPolygon(int n) -> Polygon {
    let square = new Square();
    let triangle = new Triangle();
    return switch (n) {
        1 -> square,
        default -> triangle,
    };
}

class Source<T> {
    T value;
    constructor(this.value);
}

class Constant<T> extends Source<T> {
    constructor(T v) { super(v); }
}

main() -> int {
    int score = 0;

    // Switch expression: sibling classes -> nearest common base.
    score = score + pickShape(1).kind();        // Circle  -> 1  => 1
    score = score + pickShape(9).kind();         // Square  -> 2  => 3
    score = score + pickPolygon(1).kind();       // Square  -> 2  => 5
    score = score + pickPolygon(9).kind();       // Triangle-> 4  => 9

    // Ternary: sibling classes -> nearest common base Shape.
    let circle = new Circle();
    let square = new Square();
    Shape s = (score > 0) ? circle : square;
    score = score + s.kind();                    // Circle  -> 1  => 10

    // Nullable interplay: Circle? beside Square unifies to Shape?.
    Circle? optionalCircle = circle;
    Shape? u = (score > 100) ? optionalCircle : square;
    if (u != null) { score = score + u.kind(); } // Square  -> 2  => 12

    // A null arm beside two sibling arms yields the base optional Shape?.
    Shape? v = switch (score) {
        10 -> circle,
        12 -> square,
        default -> null,
    };
    if (v != null) { score = score + v.kind(); } // Square  -> 2  => 14
    else { score = score + 100; }

    // Generic subclass beside its base instantiation -> the base instantiation.
    Source<int> src = (score > 0) ? new Constant<int>(20) : new Source<int>(7);
    score = score + src.value;                   // 20            => 34

    // '?:' with a null branch beside a class stays that class, made nullable.
    Shape? maybe = (score > 0) ? circle : null;
    if (maybe != null) { score = score + maybe.kind() + 7; }  // 1 + 7 => 42

    return score;
}
