// @exit 0
// @stdout nan key found stored
// @stdout zeros are two keys 2 zero negative zero
// @stdout zeros are two elements 2
// @stdout float nan key found measured
// @stdout float zeros are two keys 2
// A struct holding floating-point fields keys a Map and a Set once it declares the pair that
// compares each such field with 'compareTo' and hashes it with 'toCanonicalBits'. A NaN then
// matches a NaN whatever payload either carries, and the two zeros stay two keys, which is the
// order a SortedMap would have keyed them by.
import Map from @std.collections.map;
import Set from @std.collections.set;

struct Vec3 {
    protected double x;
    protected double y;
    protected double z;

    override equals(Vec3 other) -> bool {
        return this.x.compareTo(other.x) == 0 && this.y.compareTo(other.y) == 0
            && this.z.compareTo(other.z) == 0;
    }

    override hash() -> long {
        return ((this.x.toCanonicalBits() as long) * 31 + (this.y.toCanonicalBits() as long)) * 31
            + (this.z.toCanonicalBits() as long);
    }
}

// The same pair at the narrower width, where the canonical bits are 32 of them.
struct Size2 {
    protected float width;
    protected float height;

    override equals(Size2 other) -> bool {
        return this.width.compareTo(other.width) == 0
            && this.height.compareTo(other.height) == 0;
    }

    override hash() -> long {
        return (this.width.toCanonicalBits() as long) * 31
            + (this.height.toCanonicalBits() as long);
    }
}

main() -> int {
    double firstNaN = double.fromBits(0x7FF8DEADBEEF0000);
    double secondNaN = double.fromBits(0xFFF8000000C0FFEE);
    let byVector = new Map<Vec3, string>();
    byVector.set({x: firstNaN, y: 1.0, z: 2.0}, "stored");
    Vec3 probe = {x: secondNaN, y: 1.0, z: 2.0};
    string atNaN = byVector.get(probe) ?? "missing";
    print("nan key found {atNaN}");

    let byZero = new Map<Vec3, string>();
    byZero.set({x: 0.0, y: 0.0, z: 0.0}, "zero");
    byZero.set({x: -0.0, y: 0.0, z: 0.0}, "negative zero");
    string atZero = byZero.get({x: 0.0, y: 0.0, z: 0.0}) ?? "missing";
    string atNegativeZero = byZero.get({x: -0.0, y: 0.0, z: 0.0}) ?? "missing";
    print("zeros are two keys {byZero.length()} {atZero} {atNegativeZero}");

    let vectors = new Set<Vec3>();
    vectors.add({x: 0.0, y: 0.0, z: 0.0});
    vectors.add({x: -0.0, y: 0.0, z: 0.0});
    vectors.add({x: 0.0, y: 0.0, z: 0.0});
    print("zeros are two elements {vectors.length()}");

    float one = 1.0;
    float floatZero = 0.0;
    let bySize = new Map<Size2, string>();
    bySize.set({width: float.fromBits(0x7FC0BEEF), height: one}, "measured");
    Size2 sizeProbe = {width: float.fromBits(0xFFC00001), height: one};
    string atFloatNaN = bySize.get(sizeProbe) ?? "missing";
    print("float nan key found {atFloatNaN}");

    let byFloatZero = new Map<Size2, string>();
    byFloatZero.set({width: floatZero, height: one}, "zero");
    byFloatZero.set({width: -floatZero, height: one}, "negative zero");
    print("float zeros are two keys {byFloatZero.length()}");

    return 0;
}
