// @exit 0
// @stdout join: [src/main.ens][src/main.ens][main.ens]
// @stdout parent: [/a/b][/][][]
// @stdout name: [main.ens][main.ens][a][a]
// @stdout normalize: [a/b][/a/b][a/b][.][/][../a][/a]
// @stdout built: [build/tests/out.txt]
// Happy paths for @std.path: joining, the parent folder, the last part of a path, and
// normalization over '.', '..', repeated separators, and paths that resolve to nothing.
//
// Two answers here changed when the module started answering through 'Path'. A root has no folder
// above it, so its parent is now none rather than the root itself, which is what stops a walk
// upwards from looping. And 'a/' names the same place as 'a', so its last part is now that name
// rather than nothing.
import @std.path;

main() -> int {
    print("join: " + boxed(path.join("src", "main.ens")) + boxed(path.join("src/", "main.ens"))
        + boxed(path.join("", "main.ens")));
    print("parent: " + boxed(path.parentFolder("/a/b/c.ens")) + boxed(path.parentFolder("/c.ens"))
        + boxed(path.parentFolder("c.ens")) + boxed(path.parentFolder("/")));
    print("name: " + boxed(path.fileName("/a/b/main.ens")) + boxed(path.fileName("main.ens"))
        + boxed(path.fileName("/a")) + boxed(path.fileName("a/")));
    print("normalize: " + boxed(path.normalize("a/./b")) + boxed(path.normalize("/a//b/"))
        + boxed(path.normalize("a/x/../b")) + boxed(path.normalize(""))
        + boxed(path.normalize("/")) + boxed(path.normalize("../a"))
        + boxed(path.normalize("/../a")));
    print("built: " + boxed(path.join(path.parentFolder("build/tests/in.txt"), "out.txt")));
    return 0;
}

boxed(string value) -> string {
    return "[" + value + "]";
}
