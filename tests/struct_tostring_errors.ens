// @expect-error A method named 'toString' must have the signature 'toString() -> string'. Give it a 'string' result, or remove 'override' and give it a parameter to make it an ordinary method.
// @expect-error Method 'toString' of 'Conforming' is marked 'override' but no interface 'Conforming' implements declares 'toString', and a struct inherits nothing. A 'toString' that takes parameters is an ordinary method, not the struct's text form. Remove 'override'.
// @expect-error build failed with 2 problems

// A struct's 'toString' that takes no parameters is held to the shape the text form needs, a
// 'string' result. One that takes parameters is an ordinary method, so the marker has nothing to
// answer, and it is told so even when the struct implements an interface.

public struct Numbered {
    int x;

    public override toString() -> int {
        return 7;
    }
}

public interface Sized {
    size() -> int;
}

public struct Conforming implements Sized {
    int x;

    public override size() -> int {
        return this.x;
    }

    public override toString(int width) -> string {
        return "wide";
    }
}

main() -> int {
    return 0;
}
