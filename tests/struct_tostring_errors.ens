// @expect-error A method named 'toString' cannot be marked 'throws'; a value's text form is used where there is no room for a 'try', such as an interpolation hole. Remove 'throws', or rename the method.
// @expect-error A method named 'toString' must have the signature 'toString() -> string'; it defines how values of this type render as text (for example in an interpolation hole). Give it a 'string' result, or a parameter to make it an ordinary method.
// @expect-error Method 'toString' replaces the built-in text form of struct 'Labeled', so it must be as visible as 'Labeled' itself; mark it 'public'.
// @expect-error Method 'toString' overrides the built-in text form of struct 'Unmarked'; mark it 'override'.
// @expect-error Method 'toString' of 'Shaped' is marked 'override' but structs do not inherit, so there is nothing to override; a 'toString' that takes parameters is an ordinary method rather than the struct's text form. Remove 'override'.
// @expect-error build failed with 5 problems

// A struct's 'toString' that takes no parameters is held to the shape the text form needs: a
// 'string' result and no 'throws', because an interpolation hole has nowhere to write a 'try'.
// It replaces the JSON form the language provides, so it writes the marker and may not be less
// visible than its struct. One that takes parameters is an ordinary method, so the marker has
// nothing to answer.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public struct Throwing {
    int x;

    public override toString() -> string throws {
        if (this.x < 0) {
            throw new Failure("negative");
        }
        return "throwing";
    }
}

public struct Numbered {
    int x;

    public override toString() -> int {
        return 7;
    }
}

public struct Labeled {
    int x;

    protected override toString() -> string {
        return "Labeled({this.x})";
    }
}

public struct Unmarked {
    int x;

    public toString() -> string {
        return "Unmarked({this.x})";
    }
}

public struct Shaped {
    int x;

    public override toString(int width) -> string {
        return "wide";
    }
}

main() -> int {
    return 0;
}
