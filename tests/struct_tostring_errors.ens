// @expect-error A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' can be written, such as inside a '{...}' in a string. Remove 'throws', or rename the method.
// @expect-error A method named 'toString' must have the signature 'toString() -> string'. Give it a 'string' result, or a parameter to make it an ordinary method.
// @expect-error Method 'toString' replaces the built-in text form of struct 'Labeled', so it must be as visible as 'Labeled' itself; mark it 'public'.
// @expect-error Method 'toString' overrides the built-in text form of struct 'Unmarked'; mark it 'override'.
// @expect-error Method 'toString' of 'Shaped' is marked 'override', and a struct inherits nothing to override; a 'toString' that takes parameters is an ordinary method rather than the struct's text form. Remove 'override'.
// @expect-error Method 'toString' of 'Conforming' is marked 'override' but no interface 'Conforming' implements declares 'toString', and a struct inherits nothing; a 'toString' that takes parameters is an ordinary method rather than the struct's text form. Remove 'override'.
// @expect-error build failed with 6 problems

// A struct's 'toString' that takes no parameters is held to the shape the text form needs: a
// 'string' result and no 'throws', because an interpolation hole has nowhere to write a 'try'.
// It replaces the JSON form the language provides, so it writes the marker and may not be less
// visible than its struct. One that takes parameters is an ordinary method, so the marker has
// nothing to answer, and it is told so whether or not the struct implements an interface, since
// the name alone is otherwise one of the three a struct does replace.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public struct Throwing {
    int x;

    public override toString() -> string throws {
        if (this.x < 0) {
            throw new Failure("negative");
        }
        return "throwing";
    }
}

public struct Numbered {
    int x;

    public override toString() -> int {
        return 7;
    }
}

public struct Labeled {
    int x;

    protected override toString() -> string {
        return "Labeled({this.x})";
    }
}

public struct Unmarked {
    int x;

    public toString() -> string {
        return "Unmarked({this.x})";
    }
}

public struct Shaped {
    int x;

    public override toString(int width) -> string {
        return "wide";
    }
}

public interface Sized {
    size() -> int;
}

public struct Conforming implements Sized {
    int x;

    public override size() -> int {
        return this.x;
    }

    public override toString(int width) -> string {
        return "wide";
    }
}

main() -> int {
    return 0;
}
