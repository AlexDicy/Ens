// @exit 6
// Char literals are integer constants, so they serve as labels in an integer
// switch over a byte (or any integer). Each label still has to fit the
// scrutinee's type, exactly like an integer label would.
kind(byte b) -> int {
    return switch (b) {
        '(' -> 1,
        ')' -> 2,
        'A' -> 3,
        default -> 0,
    };
}

main() -> int {
    // '(' is 40, ')' is 41, 'A' is 65; a byte holds each directly.
    byte open = 40;
    byte close = 41;
    byte a = 65;
    byte z = 90;
    return kind(open) + kind(close) + kind(a) + kind(z);
}
