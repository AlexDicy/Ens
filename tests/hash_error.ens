class Failure extends Error {
    constructor() {
        super("failure");
    }
}

class Badge {
    int number;

    constructor(this.number);

    hash(int seed) -> int {
        return this.number + seed;
    }
}

class Stamp {
    int number;

    constructor(this.number);

    override hash(int seed) -> int {
        return this.number + seed;
    }
}

class Plate {
    int number;

    constructor(this.number);

    hash() -> long throws Failure {
        return this.number;
    }
}

class Seal {
    int number;

    constructor(this.number);

    override hash() -> long throws Failure {
        return this.number;
    }
}

main() -> int {
    return 0;
