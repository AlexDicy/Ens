// @expect-error Method 'hash' of 'Badge' takes parameters and returns 'int'. A Map or Set calls 'hash()' to find a key. Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename the method.
class Badge {
    int number;
    constructor(this.number);
    hash(int seed) -> int { return this.number + seed; }
}

main() -> int {
    return 0;
}
