// @exit 62
// Field inheritance, abstract methods, override + virtual dispatch through a base-typed
// reference, super.method(), super(...) constructor chaining, upcast to Base and Base?,
// nullable narrowing, protected field access from a subclass, and an override in a file-private
// class carrying the capped marker of the public method it replaces.
abstract class Animal {
    protected int energy;

    protected constructor(this.energy = 0);

    protected abstract sound() -> int;
    protected describe() -> int { return this.energy; }
}

class Dog extends Animal {
    protected constructor(int e) { super(e); }

    protected override sound() -> int { return 10; }
    protected boost() -> int { return this.energy + 1; }   // inherited protected field
}

class Puppy extends Dog {
    protected constructor(int e) { super(e); }

    protected override sound() -> int { return super.sound() + 5; }  // calls Dog.sound
}

public class Gauge {
    public constructor();

    public reading() -> int {
        return 1;
    }
}

class Tuned extends Gauge {
    protected constructor();

    protected override reading() -> int {
        return 9;
    }
}

main() -> int {
    Dog d = new Dog(7);
    Animal a = d;                    // upcast Dog -> Animal
    Animal? maybe = new Puppy(20);   // upcast Puppy -> Animal?

    int total = a.sound();           // virtual: Dog.sound = 10
    total = total + d.boost();       // protected energy 7 + 1 = 8  -> 18
    if (maybe != null) {
        Animal m = maybe;                 // narrowed to non-null Animal
        total = total + m.sound();        // virtual: Puppy.sound = 10 + 5 = 15  -> 33
        total = total + m.describe();     // inherited non-virtual: energy 20   -> 53
    }
    Gauge gauge = new Tuned();
    total = total + gauge.reading();      // capped marker, dispatches to Tuned.reading = 9  -> 62
    return total;
}