// @exit 62
// @stdout base 7 own mine
// @stdout base 8 own changed
// @stdout defaults 3 three
// Field inheritance, abstract methods, virtual dispatch through a base-typed reference, super
// calls and constructor chaining, upcasts and nullable narrowing, protected access, and the
// marker an override in a file-private class carries. A private base field is not inherited.
abstract class Animal {
    protected int energy;

    protected constructor(this.energy = 0);

    protected abstract sound() -> int;
    protected describe() -> int { return this.energy; }
}

class Dog extends Animal {
    protected constructor(int e) { super(e); }

    protected override sound() -> int { return 10; }
    protected boost() -> int { return this.energy + 1; }   // inherited protected field
}

class Puppy extends Dog {
    protected constructor(int e) { super(e); }

    protected override sound() -> int { return super.sound() + 5; }  // calls Dog.sound
}

public class Gauge {
    public constructor();

    public reading() -> int {
        return 1;
    }
}

class Tuned extends Gauge {
    protected constructor();

    protected override reading() -> int {
        return 9;
    }
}

class Slotted {
    int slot;
    int count = 3;

    protected constructor(this.slot);

    protected baseSlot() -> int {
        return this.slot;
    }

    protected bumpBase() {
        this.slot = this.slot + 1;
    }

    protected baseCount() -> int {
        return this.count;
    }
}

class Reslotted extends Slotted {
    protected string slot;
    protected string count = "three";

    protected constructor(int base, this.slot) {
        super(base);
    }

    protected ownSlot() -> string {
        return this.slot;
    }

    protected setOwn(string value) {
        this.slot = value;
    }

    protected ownCount() -> string {
        return this.count;
    }
}

main() -> int {
    let slotted = new Reslotted(7, "mine");
    print("base {slotted.baseSlot()} own {slotted.ownSlot()}");
    slotted.bumpBase();
    slotted.setOwn("changed");
    print("base {slotted.baseSlot()} own {slotted.ownSlot()}");
    print("defaults {slotted.baseCount()} {slotted.ownCount()}");
    Dog d = new Dog(7);
    Animal a = d;                    // upcast Dog -> Animal
    Animal? maybe = new Puppy(20);   // upcast Puppy -> Animal?

    int total = a.sound();           // virtual: Dog.sound = 10
    total = total + d.boost();       // protected energy 7 + 1 = 8  -> 18
    if (maybe != null) {
        Animal m = maybe;                 // narrowed to non-null Animal
        total = total + m.sound();        // virtual: Puppy.sound = 10 + 5 = 15  -> 33
        total = total + m.describe();     // inherited non-virtual: energy 20   -> 53
    }
    Gauge gauge = new Tuned();
    total = total + gauge.reading();      // capped marker, dispatches to Tuned.reading = 9  -> 62
    return total;
}