// @exit 0
// @stdout streamed: out one
// @stdout streamed: err one
// @stdout streamed: out two
// @stdout streamed: 3 line(s), null again true, code 3, asked again 3
// @stdout marked: child mark=one
// @stdout flooded: code 5 without a line being read
// @stdout abandoned 8 children, and the next one still streams: still here
// The program starts itself as the child, so one fixture covers both sides. The child is spawned
// with its output merged, so its two output streams arrive in the order it wrote them, which is
// why the line it sent to standard error appears between the two it sent to standard output.
import Environment from @std.environment;
import @std.environment;
import Path from @std.fs;
import ChildProcess from @std.process;
import ProcessError from @std.process;
import @std.process;

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length > 0) {
        return child(arguments[0]);
    }
    return try parent();
} catch (Error e) {
    eprint("process_spawn_merged_stream: {e.message}");
    return 1;
}

// The child: this same program, started again with the part it is to play.
child(string mode) -> int {
    return switch (mode) {
        "lines" -> bothStreams(),
        "flood" -> moreThanAPipeHolds(),
        "mark" -> markFromEnvironment(),
        default -> 0,
    };
}

// One line on each stream and one more on the first, so the order they arrive in is observable.
bothStreams() -> int {
    print("out one");
    eprint("err one");
    print("out two");
    return 3;
}

// More output than a pipe holds, so a parent that never reads it would stop this child dead.
moreThanAPipeHolds() -> int {
    for (long i = 0; i < 4000; i++) {
        print("line {i} of far more output than the pipe between us can hold at once");
    }
    return 5;
}

markFromEnvironment() -> int {
    print("child mark=" + (Environment.current().get("ENS_TEST_STREAM_MARK") ?? "<unset>"));
    return 0;
}

parent() -> int throws {
    Path? found = environment.executablePath();
    if (found == null) {
        eprint("this system would not report the path of this program");
        return 1;
    }
    Path self = found;

    let streamed = try spawnMerged(self, ["lines"], null);
    let streamedOutput = streamed.stdout();
    long lines = 0;
    string? line = try streamedOutput.readLine();
    while (line != null) {
        print("streamed: {line}");
        lines = lines + 1;
        line = try streamedOutput.readLine();
    }
    bool endsAgain = try streamedOutput.readLine() == null;
    let status = try streamed.wait();
    let again = try streamed.wait();
    print("streamed: {lines} line(s), null again {endsAgain}, code {status.code}, asked again "
        + "{again.code}");

    // The child receives this process's variables with one more laid over them.
    let variables = Environment.current();
    variables.set("ENS_TEST_STREAM_MARK", "one");
    let marked = try spawnMerged(self, ["mark"], variables);
    string? first = try marked.stdout().readLine();
    print("marked: " + (first ?? "<nothing>"));
    let markStatus = try marked.wait();

    // Asking for the status without reading a line has to return rather than deadlock, whatever
    // the child has written by then.
    let flooded = try spawnMerged(self, ["flood"], null);
    let floodStatus = try flooded.wait();
    print("flooded: code {floodStatus.code} without a line being read");

    for (long i = 0; i < 8; i++) {
        let abandoned = try spawnMerged(self, ["quiet"], null);
    }
    let after = try spawnMerged(self, ["lines"], null);
    string? survives = try after.stdout().readLine();
    let afterStatus = try after.wait();
    print("abandoned 8 children, and the next one still streams: "
        + stillThere(survives ?? "<nothing>", afterStatus.code));
    return 0;
}

// This program as the child, with both of its output streams arriving through one pipe.
spawnMerged(Path program, string[] arguments, Environment? variables) -> ChildProcess
        throws ProcessError {
    return try process.spawn(program, arguments, environment: variables, mergeOutput: true);
}

stillThere(string line, int code) -> string {
    if (line == "out one" && code == 3) {
        return "still here";
    }
    return "the child answered '{line}' with code {code}";
}
