// @exit 134
// @stdout walked 1
// @stderr-contains panic: set changed during a walk: finish the walk before changing it, or use removeWhere
// Adding to a set inside a walk over it aborts on the next step, in the set's own words.
import Set from @std.collections.set;

main() -> int {
    let numbers = new Set<int>();
    numbers.add(1);
    long walked = 0;
    for (let value in numbers) {
        walked = walked + 1;
        print("walked {walked}");
        numbers.add(value + 100);
    }
    return 0;
}
