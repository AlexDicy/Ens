// @exit 27
main() -> int {
    // 1 sized + 1 empty: outer allocated, inner null.
    int[]?[] grid = new int[3][];
    if (grid.length != 3L) { return 1; }
    if (grid[0] != null) { return 2; }
    if (grid[2] != null) { return 3; }

    // Fill one row and read back through narrowing.
    grid[1] = new int[5];
    int[]? row = grid[1];
    if (row != null) {
        row[0] = 10;
        row[4] = 20;
        if (row[0] + row[4] != 30) { return 4; }
    } else {
        return 5;
    }

    // 2 sized + 1 empty: outer & middle allocated, innermost null.
    int[]?[][] cube = new int[2][4][];
    if (cube.length != 2L) { return 6; }
    if (cube[0].length != 4L) { return 7; }
    if (cube[1].length != 4L) { return 8; }
    if (cube[1][3] != null) { return 9; }
    cube[0][2] = new int[3];
    int[]? inner = cube[0][2];
    if (inner != null) {
        inner[1] = 7;
        if (inner[1] != 7) { return 10; }
    } else {
        return 11;
    }

    return 27;
}
