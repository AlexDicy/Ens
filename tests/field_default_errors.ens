// A field default follows the rules below, and each mistake is explained once. A default may read
// the fields declared above it, so one that names a later field, or its own field, is refused for the
// reference alone and not also as an undefined name at the same position. A default gives
// its own field a value, so one that assigns a sibling is refused as well, whether it assigns with
// '=', with a compound operator, with a '++' or with a '--', and on a struct as on a class.
// A struct field lives in the value that holds it, so a chain of them is a write to the sibling at
// its root and names that field, however many fields the chain steps through. A field a class
// inherits is declared in its base, not before the default, so a default cannot read it. A class,
// and a struct that declares a constructor, compute their defaults before any field is assigned, so
// an earlier field such a default reads needs a value already, and 'this' is not available in a
// default at all.
// @expect-error The default value of field 'area' uses 'width', which is declared below 'area', so 'width' has no value yet. Move 'width' above 'area', or remove 'width' from the default.
// @expect-error The default value of field 'area' uses 'height', which is declared below 'area', so 'height' has no value yet. Move 'height' above 'area', or remove 'height' from the default.
// @expect-error The default value of field 'x' uses 'x' itself, and 'x' has no value until this default is computed. Remove 'x' from its own default, or use a field declared above 'x'.
// @expect-error Field 'a' cannot be assigned inside the default of 'b'. A default gives its own field a value and reads earlier ones, so give 'a' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'a' cannot be assigned inside the default of 'c'. A default gives its own field a value and reads earlier ones, so give 'a' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'a' cannot be assigned inside the default of 'd'. A default gives its own field a value and reads earlier ones, so give 'a' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'a' cannot be assigned inside the default of 'e'. A default gives its own field a value and reads earlier ones, so give 'a' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'first' cannot be assigned inside the default of 'second'. A default gives its own field a value and reads earlier ones, so give 'first' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'corner' cannot be assigned inside the default of 'written'. A default gives its own field a value and reads earlier ones, so give 'corner' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'corner' cannot be assigned inside the default of 'deep'. A default gives its own field a value and reads earlier ones, so give 'corner' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'corner' cannot be assigned inside the default of 'stepped'. A default gives its own field a value and reads earlier ones, so give 'corner' its value in its own default, or assign both fields in a constructor.
// @expect-error Field 'corner' cannot be assigned inside the default of 'compounded'. A default gives its own field a value and reads earlier ones, so give 'corner' its value in its own default, or assign both fields in a constructor.
// @expect-error 'a' is a field 'Derived' inherits from 'Base', and the default of field 'b' can read only the fields declared before it in 'Derived'. Set 'b' in a constructor of 'Derived' instead, and write 'this.a' there.
// @expect-error The default value of field 'second' uses 'first', which has no value yet. Defaults are computed before a constructor of 'Labeled' runs, and 'first' has no default of its own. Give 'first' a default, as in 'protected string first = "";', or remove the default of 'second' and set 'second' in the constructor after 'first' is assigned.
// @expect-error 'this' is not available in the default of field 'third', because the object is still being built when defaults are computed. A default reads the fields declared above it by their names alone, so write 'count' instead of 'this.count'.
// @expect-error 'this' is not available in the default of field 'fourth', because the object is still being built when defaults are computed. Set 'fourth' in a constructor of 'Labeled' instead, after 'first' has a value.
// @expect-error The default value of field 'right' uses 'left', which has no value yet. Defaults are computed before a constructor of 'Built' runs, and 'left' has no default of its own. Give 'left' a default, as in 'string left = "";', or remove the default of 'right' and set 'right' in the constructor after 'left' is assigned.
// @expect-error build failed with 17 problems

struct Forward {
    protected int area = width * height;
    protected int width = 4;
    protected int height = 5;
}

struct SelfNaming {
    protected int x = x + 1;
}

class Writer {
    protected int a = 1;
    protected int b = (a = 5);
    protected int c = (a += 2);
    protected int d = (a++);
    protected int e = (--a);

    protected constructor();
}

struct Pair {
    protected int first = 1;
    protected int second = (first = 3);
}

struct Inner {
    protected int x = 1;
}

struct Corner {
    protected Inner inner = {};
    protected int x = 1;
}

class Chained {
    protected Corner corner = {};
    protected int written = (corner.x = 7);
    protected int deep = (corner.inner.x = 8);
    protected int stepped = (corner.x++);
    protected int compounded = (corner.x += 2);

    protected constructor();
}

class Base {
    protected int a = 1;

    protected constructor();
}

class Derived extends Base {
    protected int b = a + 1;

    protected constructor();
}

class Labeled {
    int count;
    protected string first;
    protected string second = "{first}!";
    protected string third = "{this.count}";
    protected string fourth = "{this.first}";

    protected constructor() {
        this.first = "a";
    }
}

struct Built {
    string left;
    string right = "{left}!";

    constructor(string given) {
        this.left = given;
    }
}

main() -> int {
    Forward forward = {area: 20};
    SelfNaming selfNaming = {x: 1};
    Pair pair = {first: 1, second: 3};
    return forward.area + selfNaming.x + new Writer().b + pair.second + new Chained().written;
}
