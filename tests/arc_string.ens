// @exit 0
// @stdout arc done
// Stresses the ownership of derived strings: each iteration builds concat,
// interpolation, and byte[] conversion results that must free without leaking
// or double-freeing. Exit 0 only if every round-trip preserved its contents.
main() -> int {
    let i = 0;
    let matched = 0;
    while (i < 1000) {
        let s = "item-{i}-" + (i * 2).toString();
        let restored = string.fromBytesLossy(s.toBytes());
        if (restored == s) { matched = matched + 1; }
        i = i + 1;
    }
    print("arc done");
    return matched - 1000;
}
