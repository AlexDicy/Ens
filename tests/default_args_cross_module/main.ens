// @exit 0
// Default arguments filled at a call site in another module: the default expressions are owned
// by the callee's module, so a negative literal, an enum constant, and a constructor default
// after 'this.field' parameters must all be resolved against that module's analysis.
import Counter from lib;
import Mode from lib;
import lib;

main() -> int {
    if (lib.adjust(10) != 7) {
        return 1;
    }
    if (lib.adjust(10, 5) != 15) {
        return 2;
    }
    if (lib.rate() != 10) {
        return 3;
    }
    if (lib.rate(Mode.Slow) != 1) {
        return 4;
    }
    let counter = new Counter(100);
    if (counter.step != -1) {
        return 5;
    }
    if (counter.advance() != 98) {
        return 6;
    }
    let stepped = new Counter(0, 4);
    if (stepped.advance(3) != 12) {
        return 7;
    }
    return 0;
}
