public enum Mode {
    Slow,
    Fast,
}

public class Counter {
    public long total;
    public long step;

    public constructor(this.total, long step = -1) {
        this.step = step;
    }

    public advance(long times = 2) -> long {
        this.total = this.total + this.step * times;
        return this.total;
    }
}

public adjust(long value, long delta = -3) -> long {
    return value + delta;
}

public rate(Mode mode = Mode.Fast) -> long {
    if (mode == Mode.Fast) {
        return 10;
    }
    return 1;
}
