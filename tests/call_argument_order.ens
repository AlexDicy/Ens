// @exit 0
// @stdout generic 3 3
// @stdout overloaded 4 4
// @stdout constructed 2 2
// @stdout named 5 5
// @stdout captured 1
// @stdout element 6 7
// A call runs and checks its arguments in the order it writes them, including an argument that waits
// for its parameter, such as a '{...}' literal or a lambda, and the elements of an array literal in
// the same order. A write in such an argument narrows the arguments after it, and a lambda copies the
// value a local holds before a later argument writes it.

struct Count {
    long n;
}

class Box {
    protected long total;

    protected constructor(Count count, long other) {
        this.total = count.n * 10 + other;
    }

    protected constructor(Count count, string other) {
        this.total = count.n;
    }
}

take<T>(Count count, T value) -> string {
    return "{count.n} {value}";
}

run(Count count, long value) -> string {
    return "{count.n} {value}";
}

run(Count count, string value) -> string {
    return value;
}

named(Count count, long value) -> string {
    return "{count.n} {value}";
}

apply<T, U>(() -> T body, U value) -> T {
    return body();
}

measure(string? text) -> long {
    return text == null ? -1 : text.length;
}

pick() -> string? {
    return null;
}

countOf(string? text) -> Count {
    return { n: text == null ? 0 : 1 };
}

consume(Count[] counts) -> long {
    return counts[counts.length - 1].n;
}

consume(long[] values) -> long {
    return values[0];
}

make(long value) -> () -> long {
    return () -> value;
}

runLast((() -> long)[] bodies) -> long {
    return bodies[bodies.length - 1]();
}

runLast(long[] values) -> long {
    return values[0];
}

generic() -> string {
    string? held = pick();
    return take({ n: measure(held = "abc") }, held.length);
}

overloaded() -> string {
    string? held = pick();
    return run({ n: measure(held = "abcd") }, held.length);
}

constructed() -> long {
    string? held = pick();
    return new Box({ n: measure(held = "ab") }, held.length).total;
}

byName() -> string {
    string? held = pick();
    return named(count: { n: measure(held = "abcde") }, value: held.length);
}

captured() -> long {
    long value = 1;
    return apply<long, long>(() -> value, value = 5);
}

element() -> long {
    string? held = pick();
    return consume([countOf(held = "abcdef"), { n: held.length }]);
}

capturedElement() -> long {
    long value = 1;
    return runLast([make(value = 7), () -> value]);
}

main() -> int {
    print("generic {generic()}");
    print("overloaded {overloaded()}");
    print("constructed {constructed() / 10} {constructed() % 10}");
    print("named {byName()}");
    print("captured {captured()}");
    print("element {element()} {capturedElement()}");
    return 0;
}
