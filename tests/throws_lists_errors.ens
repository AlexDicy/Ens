// @expect-error 'forward' uses its type parameter 'E' as the type of a value, so 'E' has to be one type, but here it stands for the throws list of argument 1, which is 'ParseError' and 'ReadError'.
// @expect-error 'forward' uses its type parameter 'E' as the type of a value, so 'E' has to be one type, but here it stands for an empty throws list, because argument 1 throws nothing.
// @expect-error Call to 'attempt' can throw 'ParseError' and 'ReadError'. Prefix it with 'try', and either catch it with a 'catch' clause or mark this function 'throws'.
// @expect-error build failed with 4 problems
// A throws list a type parameter stands for decides whether its call needs 'try', and one that is
// the type of a value as well has to be exactly one type.
class ParseError extends Error {
    constructor(string message) {
        super(message);
    }
}

class ReadError extends Error {
    constructor(string message) {
        super(message);
    }
}

attempt<V, E: Error>((() -> V throws E) body) -> V throws E {
    return try body();
}

forward<E: Error>((() -> void throws E) body, E fallback) throws E {
    try body();
}

either() -> int throws ParseError, ReadError {
    return 1;
}

main() -> int {
    int quiet = try attempt(() -> 1);
    (() -> void throws ParseError, ReadError) both = () -> {
        let ignored = try either();
    };
    (() -> void) nothing = () -> { };
    try forward(both, new ParseError("x"));
    forward(nothing, new ParseError("y"));
    int unhandled = attempt(() -> try either());
    return 0;
}
