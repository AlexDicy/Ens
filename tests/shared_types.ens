// @exit 0
// @stdout host:8080 3
// @stdout circle
// @stdout tag 7
// @stdout kept 12
// A 'shared' class whose fields never change and hold values another task may hold compiles, and so
// do a sealed shared class with shared subclasses, a struct implementing a shared interface, an
// external type marked 'shared', and a '<shared T>' parameter given types another task may hold.
// 'shared' stays an ordinary name everywhere else.
shared final class Config {
    const string host;
    const int port;
    const Shape? shape;
    const Mark mark;

    constructor(this.host, this.port, this.shape, this.mark);
}

struct Mark {
    int weight;
    Color color;
}

enum Color {
    Red,
    Blue,
}

shared interface Named {
    name() -> string;
}

shared sealed abstract class Shape {
    protected constructor();

    abstract name() -> string;
}

shared final class Circle extends Shape {
    constructor() {
        super();
    }

    override name() -> string {
        return "circle";
    }
}

struct Tag implements Named {
    int code;

    override name() -> string {
        return "tag {this.code}";
    }
}

shared external type HANDLE;

keep<shared T>(T value) -> T {
    return value;
}

forward<shared T>(T value) -> T {
    return keep(value);
}

main() -> int {
    long shared = 12;
    let config = new Config("host", 8080, new Circle(), {weight: 3, color: Color.Red});
    print("{config.host}:{config.port} {config.mark.weight}");
    print(config.shape?.name() ?? "none");
    Tag tag = {code: 7};
    print(tag.name());
    print("kept {forward(shared)}");
    return 0;
}
