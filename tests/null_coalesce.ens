// @exit 55
class Box {
    protected int v;
    protected constructor(this.v = 0);
}

main() -> int {
    Box? a = null;
    Box b = new Box(7);
    Box chosen = a ?? b;
    if (chosen.v != 7) {
        return 1;
    }

    Box? present = new Box(9);
    Box chosen2 = present ?? b;
    if (chosen2.v != 9) {
        return 2;
    }

    string? s = null;
    string sv = s ?? "fallback";
    if (sv != "fallback") {
        return 3;
    }

    Box? x = null;
    Box? y = null;
    Box z = new Box(5);
    Box r = x ?? y ?? z;
    if (r.v != 5) {
        return 4;
    }

    return 55;
}