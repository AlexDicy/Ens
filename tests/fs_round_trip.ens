// @exit 0
// @stdout written 24 bytes, read back the same: true
// @stdout appended, now 41 bytes
// @stdout entries: notes.txt (file), old (directory), old/draft.txt (file)
// @stdout moved: notes.txt gone true, archive.txt there true, text kept true
// @stdout removed: nothing left true
// A program that works a folder the way a tool does: it writes a file and reads it back, appends
// to it, lists what a folder holds, moves a file and removes the folder again. Its output names no
// path of the machine it runs on, so the same lines are expected on every target it runs on.
import EntryKind from @std.fs.metadata;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import List from @std.collections.list;

main() -> int {
    let scratch = try TemporaryDirectory.create("ens-fs-round-trip");
    Path root = scratch.path();
    Path notes = root.join("notes.txt");
    string first = "the first line of notes\n";
    try notes.writeText(first);
    bool same = try notes.readText() == first;
    long written = try lengthOf(notes);
    print("written {written} bytes, read back the same: {same}");

    let appending = try notes.append();
    try appending.write("and a second one\n".toBytes());
    try appending.close();
    long appended = try lengthOf(notes);
    print("appended, now {appended} bytes");

    Path old = root.join("old");
    try old.createDirectories();
    try old.join("draft.txt").writeText("draft");
    string entries = try listed(root);
    print("entries: " + entries);

    Path archive = root.join("archive.txt");
    bool moved = try notes.moveTo(archive);
    bool kept = try archive.readText() == first + "and a second one\n";
    bool gone = !notes.exists();
    bool there = archive.exists();
    print("moved: notes.txt gone {gone}, archive.txt there {there}, text kept {kept}");

    try root.removeRecursively();
    bool left = root.exists();
    print("removed: nothing left {!left}");
    return 0;
} catch (Error e) {
    eprint("fs_round_trip: {e.message}");
    return 1;
}

lengthOf(Path path) -> long throws {
    let metadata = try path.metadata();
    if (metadata == null) {
        return -1;
    }
    return metadata.length;
}

// Everything under the folder, named relative to it in name order, each with what kind it is.
listed(Path root) -> string throws {
    List<string> names = new List<string>();
    for (let entry in try root.walk()) {
        Path? relative = entry.path.relativeTo(root);
        string name = relative == null ? entry.name : relative.toString();
        names.push("{name} ({kindName(entry.kind)})");
    }
    names.sort();
    string text = "";
    for (let name in names) {
        text = text.length == 0 ? name : text + ", " + name;
    }
    return text;
}

kindName(EntryKind kind) -> string {
    return switch (kind) {
        EntryKind.File -> "file",
        EntryKind.Directory -> "directory",
        default -> "other",
    };
}
