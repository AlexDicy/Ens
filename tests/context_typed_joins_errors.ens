// A '?:' or a switch holding a lambda, a '{...}' literal or an array literal, passed to overloads none
// or several of which it fits, is refused once, with what its values are, and where one overload takes
// that many arguments, with only the values that overload does not take. One whose values have no
// common type is refused for that alone, and so is one with no context type whose values with no type
// of their own get none from its other values.
// @expect-error None of the declared 'apply' functions takes a '?:' that gives a lambda with two parameters. They are 'apply((int) -> int)' and 'apply(string)'. Change the argument to match one of them.
// @expect-error Switch arms produce a lambda and 'string', which have no common type. Give every arm the same type.
// @expect-error This call matches 'tie((int) -> int)' and 'tie((int) -> long)' equally well, so it is not clear which one to call. Declare the '?:' as a local first, as in '(int) -> int step = up ? (x) -> x + 1 : (x) -> x;', and pass 'step'.
// @expect-error Argument 1 of 'pair' is a '?:' that gives a lambda with two parameters, but 'pair((int) -> int, int)', the only 'pair' that takes two arguments, takes a '(int) -> int' there, which takes one parameter.
// @expect-error Argument 1 of 'total' is a '?:' that gives a '{...}' literal, but 'total(long, string)', the only 'total' that takes two arguments, takes a 'long' there, which is not a struct type.
// @expect-error Argument 1 of 'runAll' is a '?:' that gives an array literal, but 'runAll(((int) -> int)[])', the only 'runAll' that takes one argument, takes a '((int) -> int)[]' there, whose elements have type '(int) -> int'. Element 1 of the array literal after the '?' has type 'string'.
// @expect-error Argument 1 of 'runAll' is a switch that gives an array literal, but 'runAll(((int) -> int)[])', the only 'runAll' that takes one argument, takes a '((int) -> int)[]' there, whose elements have type '(int) -> int'. Element 2 of the array literal in the 'default ->' arm has type 'int'.
// @expect-error None of the declared 'shift' functions takes these arguments: argument 1 is a '?:' that gives a lambda with two parameters, and argument 2 is a value of type 'int'. They are 'shift((int) -> int, int)' and 'shift(string, int)'. Change the arguments to match one of them.
// @expect-error The two results of this '?:' are a '{...}' literal and 'int', which have no common type. Give both branches the same type.
// @expect-error This '?:' has no function type to give the lambdas in its branches, so their parameters and results have no types. Write the '?:' where a function type is declared, such as a variable, a field, a parameter, an array element or a return value.
// @expect-error This '?:' has no function type to give the lambda in one of its branches, so the lambda's parameters and result have no types. Write the '?:' where a function type is declared, such as a variable, a field, a parameter, an array element or a return value.
// @expect-error This switch has no function type to give the lambdas in its arms, so their parameters and results have no types. Write the switch where a function type is declared, such as a variable, a field, a parameter, an array element or a return value.
// @expect-error This '?:' has no declared struct type for the '{...}' literals in its branches to build. Write the '?:' where a struct type is declared, such as a variable, a field, a parameter, an array element or a return value.
// @expect-error This '?:' has no element type to give each empty '[]' in its branches. Write the '?:' where an array type is declared, as in 'int[] values = up ? [] : [];'.
// @expect-error This switch has no element type to give the empty '[]' in one of its arms. Write the switch where an array type is declared, as in 'int[]? values = [];'.
// @expect-error The two results of this '?:' are 'int' and a lambda, which have no common type. Give both branches the same type.
// @expect-error The two results of this '?:' are 'Dog' and a '{...}' literal, which have no common type. Give both branches the same type.
// @expect-error The two results of this '?:' are a lambda and a '{...}' literal, which have no common type. Give both branches the same type.
// @expect-error build failed with 19 problems
class Dog {
    constructor();
}

apply((int) -> int step) -> int {
    return step(1);
}

apply(string text) -> int {
    return 0;
}

tie((int) -> int step) -> int {
    return step(1);
}

tie((int) -> long step) -> int {
    return 0;
}

pair((int) -> int step, int value) -> int {
    return step(value);
}

pair(string first, string second, string third) -> int {
    return 0;
}

total(long first, string second) -> long {
    return first;
}

total(string first, string second, string third) -> long {
    return 0;
}

runAll(((int) -> int)[] steps) -> int {
    return steps[0](1);
}

runAll(string first, string second) -> int {
    return 0;
}

shift((int) -> int step, int count) -> int {
    return step(count);
}

shift(string text, int count) -> int {
    return count;
}

main() -> int {
    bool up = true;
    long mode = 1;
    int none = apply(up ? (x, y) -> x : (x, y) -> y);
    int mixed = apply(switch (mode) {
        1 -> (x) -> x,
        default -> "text",
    });
    int tied = tie(up ? (x) -> x + 1 : (x) -> x);
    int counted = pair(up ? (x, y) -> x : (x, y) -> y, 2);
    (int) -> int twice = (x) -> x * 2;
    int chosen = pair(up ? twice : (x, y) -> x, 2);
    int shifted = shift(up ? (x, y) -> x : (x, y) -> y, 2);
    long literals = total(up ? {x: 1} : {x: 2}, "x");
    long combined = total(up ? {x: 1} : 5, "x");
    int listed = runAll(up ? ["s", (x) -> x] : []);
    int armed = runAll(switch (mode) {
        1 -> [(x) -> x],
        default -> [(x) -> x, 2],
    });
    let both = up ? (a) -> a : (a) -> -a;
    let one = up ? (a) -> a : null;
    let arms = switch (mode) {
        1 -> (a) -> a,
        default -> (a) -> 0,
    };
    let points = up ? {x: 1} : {x: 2};
    let values = up ? [] : [];
    let maybe = switch (mode) {
        1 -> [],
        default -> null,
    };
    let numbered = up ? 1 : (x) -> x;
    let dog = up ? new Dog() : {x: 1};
    let kinds = up ? (x) -> x : {x: 1};
    return 0;
}
