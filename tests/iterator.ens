// @exit 0
// @stdout counted 1 2 3
// @stdout array 10 20
// @stdout nested 1a 1b 2a 2b
// @stdout break-at 2
// @stdout strings one two

import Iterable from @std.iterator;
import Iterator from @std.iterator;

class CountUp implements Iterator<int> {
    private int current;
    private int limit;
    CountUp(this.current, this.limit);
    hasNext() -> bool { return this.current <= this.limit; }
    next() -> int {
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class Range implements Iterable<int> {
    private int low;
    private int high;
    Range(this.low, this.high);
    makeIterator() -> Iterator<int> { return new CountUp(this.low, this.high); }
}

class WordIterator implements Iterator<string> {
    private string[] words;
    private long index;
    WordIterator(this.words) { this.index = 0; }
    hasNext() -> bool { return this.index < this.words.length; }
    next() -> string {
        string word = this.words[this.index];
        this.index = this.index + 1;
        return word;
    }
}

class Words implements Iterable<string> {
    private string[] items;
    Words(this.items);
    makeIterator() -> Iterator<string> { return new WordIterator(this.items); }
}

main() -> int {
    string line = "counted";
    for (let n in new Range(1, 3)) {
        line = line + " " + n;
    }
    print(line);

    int[] plain = new int[2];
    plain[0] = 10;
    plain[1] = 20;
    line = "array";
    for (let v in plain) {
        line = line + " " + v;
    }
    print(line);

    line = "nested";
    for (let outer in new Range(1, 2)) {
        for (let inner in new Range(0, 1)) {
            string tag = "a";
            if (inner == 1) { tag = "b"; }
            line = line + " " + outer + tag;
        }
    }
    print(line);

    for (let n in new Range(1, 9)) {
        if (n == 2) {
            print("break-at " + n);
            break;
        }
    }

    string[] words = ["one", "two"];
    line = "strings";
    for (let w in new Words(words)) {
        line = line + " " + w;
    }
    print(line);

    return 0;
}
