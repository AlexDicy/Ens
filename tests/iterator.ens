// @exit 0
// The iterator protocol and the loop that drives it: 'Iterator<T>' declares only 'next() -> T?',
// and only the outer optional level of its result ends the loop. The library contract alone
// decides how the loop is driven, whatever else the iterator declares.
// @stdout int: 1
// @stdout int: 2
// @stdout int: 3
// @stdout long total: 15
// @stdout array: 10 20
// @stdout word: alpha
// @stdout word: beta
// @stdout maybe: milk
// @stdout maybe: <none>
// @stdout maybe: tea
// @stdout interface total: 10
// @stdout even: 2
// @stdout even: 4
// @stdout even: 6
// @stdout skip and stop done
// @stdout pair: 1,3
// @stdout pair: 1,4
// @stdout pair: 2,3
// @stdout pair: 2,4
// @stdout decoy: 1
// @stdout decoy: 2
// @stdout decoy: 3
// @stdout counting: 1
// @stdout counting: 2
// @stdout counting: 3
// @stdout visiting t1
// @stdout destroyed t1
// @stdout visiting t2
// @stdout tracked walk done
// @stdout destroyed t2
// @stdout after tracked walk
// @stdout visiting b1
// @stdout destroyed b1
// @stdout visiting b2
// @stdout break walk done
// @stdout destroyed b2
// @stdout after break walk
// @stdout drained 2 values
// @stdout exhausted answers null: true
// @stdout exhausted again: true
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

// Counts through a closed range of ints; answers null once past the top and forever after.
class CountUp implements Iterator<int> {
    int current;
    int limit;

    protected constructor(this.current, this.limit);

    protected override next() -> int? {
        if (this.current > this.limit) {
            return null;
        }
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class Range implements Iterable<int> {
    int low;
    int high;

    protected constructor(this.low, this.high);

    protected override makeIterator() -> Iterator<int> {
        return new CountUp(this.low, this.high);
    }
}

class WordIterator implements Iterator<string> {
    string[] words;
    long position;

    protected constructor(this.words) {
        this.position = 0;
    }

    protected override next() -> string? {
        if (this.position >= this.words.length) {
            return null;
        }
        let word = this.words[this.position];
        this.position = this.position + 1;
        return word;
    }
}

class Words implements Iterable<string> {
    string[] items;

    protected constructor(this.items);

    protected override makeIterator() -> Iterator<string> {
        return new WordIterator(this.items);
    }
}

// 'next()' answers 'string??', so a present outer level holding null is a null element.
class MaybeWordIterator implements Iterator<string?> {
    string?[] words;
    long position;

    protected constructor(this.words) {
        this.position = 0;
    }

    protected override next() -> string?? {
        if (this.position >= this.words.length) {
            return null;
        }
        string? word = this.words[this.position];
        this.position = this.position + 1;
        return word;
    }
}

class MaybeWords implements Iterable<string?> {
    string?[] items;

    protected constructor(this.items);

    protected override makeIterator() -> Iterator<string?> {
        return new MaybeWordIterator(this.items);
    }
}

// An unrelated 'hasNext' that always answers false does not change how the loop is driven.
class DecoyCountUp implements Iterator<int> {
    int current;
    int limit;

    protected constructor(this.current, this.limit);

    protected hasNext() -> bool {
        return false;
    }

    protected override next() -> int? {
        if (this.current > this.limit) {
            return null;
        }
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class DecoyRange implements Iterable<int> {
    int low;
    int high;

    protected constructor(this.low, this.high);

    protected override makeIterator() -> DecoyCountUp {
        return new DecoyCountUp(this.low, this.high);
    }
}

// A sub-interface adds its own 'hasNext' and is what 'makeIterator' declares it returns.
interface CountingIterator<T> extends Iterator<T> {
    hasNext() -> bool;
}

class CountingCountUp implements CountingIterator<int> {
    int current;
    int limit;

    protected constructor(this.current, this.limit);

    protected override hasNext() -> bool {
        return false;
    }

    protected override next() -> int? {
        if (this.current > this.limit) {
            return null;
        }
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class CountingRange implements Iterable<int> {
    int low;
    int high;

    protected constructor(this.low, this.high);

    protected override makeIterator() -> CountingIterator<int> {
        return new CountingCountUp(this.low, this.high);
    }
}

class Tracked {
    string label;

    protected constructor(this.label);

    destructor() {
        print("destroyed {this.label}");
    }

    protected name() -> string {
        return this.label;
    }
}

class ParadeIterator implements Iterator<Tracked> {
    string prefix;
    int current;
    int limit;

    protected constructor(this.prefix, this.limit) {
        this.current = 0;
    }

    protected override next() -> Tracked? {
        if (this.current >= this.limit) {
            return null;
        }
        this.current = this.current + 1;
        return new Tracked("{this.prefix}{this.current}");
    }
}

class Parade implements Iterable<Tracked> {
    string prefix;
    int size;

    protected constructor(this.prefix, this.size);

    protected override makeIterator() -> Iterator<Tracked> {
        return new ParadeIterator(this.prefix, this.size);
    }
}

intWalk() {
    for (let n in new Range(1, 3)) {
        print("int: {n}");
    }
}

longWalk() {
    long total = 0;
    for (long n in new Range(4, 6)) {
        total = total + n;
    }
    print("long total: {total}");
}

arrayWalk() {
    int[] plain = [10, 20];
    string line = "array:";
    for (let value in plain) {
        line = line + " " + value;
    }
    print(line);
}

wordWalk() {
    for (let word in new Words(["alpha", "beta"])) {
        print("word: {word}");
    }
}

maybeWordWalk() {
    string?[] items = ["milk", null, "tea"];
    for (let word in new MaybeWords(items)) {
        print("maybe: " + (word ?? "<none>"));
    }
}

interfaceTotal(Iterable<int> values) -> int {
    int total = 0;
    for (let n in values) {
        total = total + n;
    }
    return total;
}

skipAndStop() {
    for (let n in new Range(1, 9)) {
        if (n % 2 == 1) {
            continue;
        }
        if (n > 6) {
            break;
        }
        print("even: {n}");
    }
    print("skip and stop done");
}

nestedWalk() {
    for (let a in new Range(1, 2)) {
        for (let b in new Range(3, 4)) {
            print("pair: {a},{b}");
        }
    }
}

decoyWalk() {
    for (let n in new DecoyRange(1, 3)) {
        print("decoy: {n}");
    }
}

countingWalk() {
    for (let n in new CountingRange(1, 3)) {
        print("counting: {n}");
    }
}

trackedWalk() {
    for (let item in new Parade("t", 2)) {
        print("visiting {item.name()}");
    }
    print("tracked walk done");
}

trackedBreak() {
    for (let item in new Parade("b", 3)) {
        print("visiting {item.name()}");
        if (item.name() == "b2") {
            break;
        }
    }
    print("break walk done");
}

exhausted() {
    let cursor = new CountUp(7, 8);
    long drained = 0;
    while (cursor.next() != null) {
        drained = drained + 1;
    }
    print("drained {drained} values");
    print("exhausted answers null: {cursor.next() == null}");
    print("exhausted again: {cursor.next() == null}");
}

main() -> int {
    intWalk();
    longWalk();
    arrayWalk();
    wordWalk();
    maybeWordWalk();
    print("interface total: {interfaceTotal(new Range(1, 4))}");
    skipAndStop();
    nestedWalk();
    decoyWalk();
    countingWalk();
    trackedWalk();
    print("after tracked walk");
    trackedBreak();
    print("after break walk");
    exhausted();
    return 0;
}
