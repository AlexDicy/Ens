// @exit 0
// @stdout first
// @stdout second
// @stdout matches 0
// An owned temporary passed as a call argument inside a short-circuited '&&' right side must
// not be released when the right side never runs, and must not be released twice across loop
// iterations.
import List from @std.collections.list;

class Box {
    int value;
    constructor(this.value);
}

class Item {
    string itemName;
    Box itemBox;

    constructor(this.itemName, this.itemBox);

    name() -> string {
        return this.itemName;
    }

    box() -> Box {
        return this.itemBox;
    }
}

private conforms(Box box) -> bool {
    return box.value > 0;
}

main() -> int {
    let items = new List<Item>();
    items.push(new Item("first", new Box(1)));
    items.push(new Item("second", new Box(2)));
    long matches = 0;
    for (long i = 0; i < items.length(); i++) {
        let item = items.get(i);
        if (item.name() == "missing" && conforms(item.box())) {
            matches++;
        }
    }
    for (long i = 0; i < items.length(); i++) {
        print(items.get(i).name());
    }
    print("matches {matches}");
    return 0;
}
