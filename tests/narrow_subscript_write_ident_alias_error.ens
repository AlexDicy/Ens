// @expect-error Cannot read a member of 'Box?'
// Writing 'xs[j]' drops the literal-index narrowing of 'xs[0]': j could be 0.
class Box {
    int v;
    constructor(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(1), new Box(2)];
    int j = 1;
    if (xs[0] != null) {
        xs[j] = null;
        return xs[0].v;
    }
    return 0;
}
