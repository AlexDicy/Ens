// @exit 0
// @stdout hello
// @stdout jello hello
// @stdout a.dat 1
// @stdout c.dat 3
// @stdout icons/b.dat 2
// @stdout 5 5
// @stdout 3
// @stdout 5
// @stdout 104
import EmbeddedFile from @std.embed;

final class Assets {
    lazy const byte[] greeting = embed "greeting.dat";
}

struct Holder {
    byte[] bytes = embed "assets/c.dat";
}

text(byte[] bytes) -> string throws {
    return try string.fromBytes(bytes);
}

measured(byte[] bytes = embed "greeting.dat") -> long {
    return bytes.length;
}

main() -> int throws {
    print(try text(embed "greeting.dat"));

    byte[] first = embed "greeting.dat";
    first[0] = 'j';
    byte[] second = embed "greeting.dat";
    print("{try text(first)} {try text(second)}");

    EmbeddedFile[] files = embed folder "assets";
    for (let file in files) {
        print("{file.path} {file.contents.length}");
    }

    print("{Assets.greeting.length} {measured()}");
    Holder holder = {};
    print("{holder.bytes.length}");
    () -> long count = () -> (embed "greeting.dat").length;
    print("{count()}");
    print("{Assets.greeting[0]}");
    return 0;
}
