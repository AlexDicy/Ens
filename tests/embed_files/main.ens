// @exit 0
// @stdout hello
// @stdout jello hello
// @stdout a.dat 1
// @stdout c.dat 3
// @stdout icons/b.dat 2
// @stdout 5 5
// @stdout 3
// @stdout 5
// @stdout 104
// @stdout true [104, 101, 108, 108, 111]
import EmbeddedFile from @std.embed;

final class Assets {
    lazy const bytes greeting = embed "greeting.dat";
}

struct Holder {
    bytes data = embed "assets/c.dat";
}

text(bytes data) -> string throws {
    return try string.fromBytes(data);
}

measured(bytes data = embed "greeting.dat") -> long {
    return data.length;
}

main() -> int throws {
    print(try text(embed "greeting.dat"));

    byte[] first = (embed "greeting.dat").toArray();
    first[0] = 'j';
    bytes second = embed "greeting.dat";
    print("{try string.fromBytes(first)} {try text(second)}");

    EmbeddedFile[] files = embed folder "assets";
    for (let file in files) {
        print("{file.path} {file.contents.length}");
    }

    print("{Assets.greeting.length} {measured()}");
    Holder holder = {};
    print("{holder.data.length}");
    () -> long count = () -> (embed "greeting.dat").length;
    print("{count()}");
    print("{Assets.greeting[0]}");
    let kept = embed "greeting.dat";
    bytes same = embed "greeting.dat";
    print("{kept == same} {kept}");
    return 0;
}
