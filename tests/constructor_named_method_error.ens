// @expect-error To declare a constructor, use the 'constructor' keyword
// Naming a method after its class (the pre-keyword constructor spelling) is rejected with a
// message that points at the 'constructor' keyword.
class Box {
    protected int value;
    Box(int initial) {
        this.value = initial;
    }
}

main() -> int {
    let b = new Box(5);
    return b.value;
}
