// The file bridges the compiler synthesizes wherever they are named, declared here because nothing
// in the standard library reaches them yet.
import List from @std.collections.list;

// An open file, which the C library's own calls read, write and close.
external type Stream;

// An open folder, which is read one entry at a time and released exactly once.
external type Folder;

external from libc {
    ens_fs_metadata(string path, int followLinks, out long kind, out long length,
                    out long modifiedMillis) -> int;
    ens_fs_real_path(string path, byte[] buffer, long capacity, out long needed) -> int;
    ens_current_directory(byte[] buffer, long capacity) -> long;
    ens_fs_error_kind(int code) -> int;
    ens_fs_open(string path, int mode, out int error) -> Stream?;
    ens_fs_create_directory(string path) -> int;
    ens_fs_remove_file(string path) -> int;
    ens_fs_remove_directory(string path) -> int;
    ens_fs_rename(string from, string to, int replaceExisting) -> int;
    ens_fs_copy_permissions(string from, string to) -> int;
    ens_fs_open_directory(string path, out int error) -> Folder?;
    ens_fs_next_entry(Folder folder, out long kind, out int error) -> string?;
    ens_fs_close_directory(Folder folder);
    fread(byte[] buffer, ulong size, ulong count, Stream stream) -> ulong;
    fwrite(byte[] buffer, ulong size, ulong count, Stream stream) -> ulong;
    fclose(Stream stream) -> int;
}

// The kinds a metadata answer names.
public final class Kind {
    public static const long file = 1;
    public static const long directory = 2;
    public static const long symbolicLink = 3;
    public static const long other = 4;
}

// The kinds a failure classifies into, in the order std.fs declares them.
public final class Failure {
    public static const long notFound = 0;
    public static const long permissionDenied = 1;
    public static const long alreadyExists = 2;
    public static const long notADirectory = 3;
    public static const long isADirectory = 4;
    public static const long directoryNotEmpty = 5;
    public static const long noSpace = 6;
    public static const long other = 7;
}

// What a path holds, or the platform's own number for why nothing could be read about it.
public final class Metadata {
    public const int error;
    public const long kind;
    public const long length;
    public const long modifiedMillis;

    public constructor(this.error, this.kind, this.length, this.modifiedMillis);
}

// The real form of a path, the room its text takes, and the reason there is none.
public final class RealPath {
    public const int error;
    public const long needed;
    public const string text;

    public constructor(this.error, this.needed, this.text);
}

public metadataOf(string path, bool followLinks) -> Metadata {
    long kind = 0;
    long length = 0;
    long modifiedMillis = 0;
    int why = ens_fs_metadata(path, followLinks ? 1 : 0, out kind, out length,
        out modifiedMillis);
    return new Metadata(why, kind, length, modifiedMillis);
}

// One attempt at the real path with exactly this much room, so a caller can watch what the bridge
// reports when its answer does not fit.
public realPathAttempt(string path, long capacity) -> RealPath {
    byte[] buffer = new byte[capacity + 1];
    long needed = 0;
    int why = ens_fs_real_path(path, buffer, capacity, out needed);
    if (why != 0 || needed > capacity) {
        return new RealPath(why, needed, "");
    }
    return new RealPath(0, needed, string.fromBytesLossy(buffer.slice(0, needed)));
}

// The real path, asking again with the room the first attempt said it needed.
public realPathOf(string path) -> RealPath {
    let first = realPathAttempt(path, 256);
    if (first.error != 0 || first.needed <= 256) {
        return first;
    }
    return realPathAttempt(path, first.needed);
}

// The directory this program was started in, as the operating system's own text.
public currentDirectory() -> string {
    long capacity = 256;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        long written = ens_current_directory(buffer, capacity);
        if (written > 0) {
            return string.fromBytesLossy(buffer.slice(0, written));
        }
        capacity = capacity * 8;
    }
    return "";
}

public failureOf(int code) -> long {
    return ens_fs_error_kind(code) as long;
}

// What a bridge is asked to open a path for.
public final class Mode {
    public static const int read = 0;
    public static const int writeTruncated = 1;
    public static const int appended = 2;
    public static const int createdNew = 3;
}

// What a path held, or the platform's own number for why it could not be read.
public final class Content {
    public const int error;
    public const byte[] bytes;

    public constructor(this.error, this.bytes);
}

// What a folder held as 'name:kind' text, or the platform's own number for why it could not be
// read. The bridge hands entries over in whatever order the file system enumerates them, so the
// sorting that makes an assertion repeatable is done here.
public final class Listing {
    public const int error;
    public const string[] entries;

    public constructor(this.error, this.entries);
}

public writeThrough(string path, int mode, byte[] content) -> int {
    int error = 0;
    Stream? stream = ens_fs_open(path, mode, out error);
    if (stream == null) {
        return error;
    }
    if (content.length > 0) {
        let written = fwrite(content, 1, content.length as ulong, stream);
    }
    let closed = fclose(stream);
    return 0;
}

public readThrough(string path) -> Content {
    int error = 0;
    Stream? stream = ens_fs_open(path, Mode.read, out error);
    if (stream == null) {
        return new Content(error, []);
    }
    byte[] buffer = new byte[65536];
    long count = fread(buffer, 1, buffer.length as ulong, stream) as long;
    let closed = fclose(stream);
    return new Content(0, buffer.slice(0, count));
}

// The number an open reported, with a stream that did open handed straight back.
public openError(string path, int mode) -> int {
    int error = 0;
    Stream? stream = ens_fs_open(path, mode, out error);
    if (stream == null) {
        return error;
    }
    let closed = fclose(stream);
    return 0;
}

public listThrough(string path) -> Listing {
    int error = 0;
    Folder? folder = ens_fs_open_directory(path, out error);
    if (folder == null) {
        return new Listing(error, []);
    }
    let names = new List<string>();
    long kind = 0;
    int reading = 0;
    string? name = ens_fs_next_entry(folder, out kind, out reading);
    while (name != null) {
        names.push("{name}:{kind}");
        name = ens_fs_next_entry(folder, out kind, out reading);
    }
    ens_fs_close_directory(folder);
    if (reading != 0) {
        return new Listing(reading, []);
    }
    names.sort();
    return new Listing(0, names.toArray());
}

public createDirectory(string path) -> int {
    return ens_fs_create_directory(path);
}

public removeFile(string path) -> int {
    return ens_fs_remove_file(path);
}

public removeDirectory(string path) -> int {
    return ens_fs_remove_directory(path);
}

public rename(string from, string to, bool replaceExisting) -> int {
    return ens_fs_rename(from, to, replaceExisting ? 1 : 0);
}

public copyPermissions(string from, string to) -> int {
    return ens_fs_copy_permissions(from, to);
}
