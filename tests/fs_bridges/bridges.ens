// The file bridges the compiler synthesizes wherever they are named, declared here because nothing
// in the standard library reaches them yet.

external from libc {
    ens_fs_metadata(string path, int followLinks, out long kind, out long length,
                    out long modifiedMillis) -> int;
    ens_fs_real_path(string path, byte[] buffer, long capacity, out long needed) -> int;
    ens_current_directory(byte[] buffer, long capacity) -> long;
    ens_fs_error_kind(int code) -> int;
}

// The kinds a metadata answer names.
public final class Kind {
    public static const long file = 1;
    public static const long directory = 2;
    public static const long symbolicLink = 3;
    public static const long other = 4;
}

// The kinds a failure classifies into, in the order std.fs declares them.
public final class Failure {
    public static const long notFound = 0;
    public static const long permissionDenied = 1;
    public static const long alreadyExists = 2;
    public static const long notADirectory = 3;
    public static const long isADirectory = 4;
    public static const long directoryNotEmpty = 5;
    public static const long noSpace = 6;
    public static const long other = 7;
}

// What a path holds, or the platform's own number for why nothing could be read about it.
public final class Metadata {
    public const int error;
    public const long kind;
    public const long length;
    public const long modifiedMillis;

    public constructor(this.error, this.kind, this.length, this.modifiedMillis);
}

// The real form of a path, the room its text takes, and the reason there is none.
public final class RealPath {
    public const int error;
    public const long needed;
    public const string text;

    public constructor(this.error, this.needed, this.text);
}

public metadataOf(string path, bool followLinks) -> Metadata {
    long kind = 0;
    long length = 0;
    long modifiedMillis = 0;
    int why = ens_fs_metadata(path, followLinks ? 1 : 0, out kind, out length,
        out modifiedMillis);
    return new Metadata(why, kind, length, modifiedMillis);
}

// One attempt at the real path with exactly this much room, so a caller can watch what the bridge
// reports when its answer does not fit.
public realPathAttempt(string path, long capacity) -> RealPath {
    byte[] buffer = new byte[capacity + 1];
    long needed = 0;
    int why = ens_fs_real_path(path, buffer, capacity, out needed);
    if (why != 0 || needed > capacity) {
        return new RealPath(why, needed, "");
    }
    return new RealPath(0, needed, string.fromBytesLossy(buffer.slice(0, needed)));
}

// The real path, asking again with the room the first attempt said it needed.
public realPathOf(string path) -> RealPath {
    let first = realPathAttempt(path, 256);
    if (first.error != 0 || first.needed <= 256) {
        return first;
    }
    return realPathAttempt(path, first.needed);
}

// The directory this program was started in, as the operating system's own text.
public currentDirectory() -> string {
    long capacity = 256;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        long written = ens_current_directory(buffer, capacity);
        if (written > 0) {
            return string.fromBytesLossy(buffer.slice(0, written));
        }
        capacity = capacity * 8;
    }
    return "";
}

public failureOf(int code) -> long {
    return ens_fs_error_kind(code) as long;
}
