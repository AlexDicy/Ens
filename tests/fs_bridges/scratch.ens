// A folder of this fixture's own to work in, under the running program, so two test runners never
// share one and a leftover from an earlier run is gone before anything reads it.
import @std.path;
import @std.system;
import SystemError from @std.system;

public folder(string name) -> string throws {
    string root = path.join(path.parentFolder(system.executablePath()), "fs_bridges_scratch");
    string mine = path.join(root, name);
    remove(mine);
    try system.createDirectory(mine);
    return mine;
}

// Everything under the folder and the folder itself, with whatever could not be removed left for
// the call that needs the name to report.
remove(string folder) {
    if (!system.isDirectory(folder)) {
        if (system.exists(folder)) {
            let removed = removeFile(folder);
        }
        return;
    }
    for (let entry in listed(folder)) {
        remove(path.join(folder, entry));
    }
    let removed = removeDirectory(folder);
}

listed(string folder) -> string[] {
    return try system.listDirectory(folder);
} catch (SystemError problem) {
    return [];
}

removeFile(string target) -> bool {
    try system.removeFile(target);
    return true;
} catch (SystemError problem) {
    return false;
}

removeDirectory(string target) -> bool {
    try system.removeDirectory(target);
    return true;
} catch (SystemError problem) {
    return false;
}
