// A folder of this fixture's own to work in, under the running program, so two test runners never
// share one and a leftover from an earlier run is gone before anything reads it.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import @std.environment;

public folder(string name) -> string throws FileSystemError {
    Path mine = programFolder().join("fs_bridges_scratch").join(name);
    if (mine.exists()) {
        try mine.removeRecursively();
    }
    try mine.createDirectories();
    return mine.toString();
}

// Where the running program sits, or where the run was started when this system will not say where
// the program is. The bridges under test are what a path is read through here, so the folder is
// named beside the program rather than under the system's temporary directory.
programFolder() -> Path {
    Path? self = environment.executablePath();
    if (self == null) {
        return environment.currentDirectory();
    }
    return self.parent() ?? environment.currentDirectory();
}

// Two path texts joined as one. The bridges under test read and answer a path as text, so a test
// that builds one stays in text rather than converting at every call.
public joined(string folder, string name) -> string {
    return Path(folder).join(name).toString();
}
