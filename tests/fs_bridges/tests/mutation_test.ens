// What the bridges that change what is on disk answer on the host running the suite, and what the
// wide open finally makes reachable, which is a name outside the system code page.
import @std.path;
import @std.system;
import @std.testing;
import Failure from bridges;
import Kind from bridges;
import Mode from bridges;
import bridges;
import scratch;

// A name no Windows code page can hold, which every bridge has to carry as the bytes it was given.
public final class Wide {
    public static const string name = "café-日本語.txt";
}

test "a file written through the wide open reads back byte for byte" {
    string folder = try scratch.folder("written");
    string file = path.join(folder, "plain.bin");
    byte[] content = "the whole of it".toBytes();
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, content), 0);

    let read = bridges.readThrough(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.bytes, content);
    try testing.assertEqual(bridges.metadataOf(file, true).length, content.length);
}

test "an open at the end adds to what is already there" {
    string folder = try scratch.folder("appended");
    string file = path.join(folder, "growing.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "one".toBytes()), 0);
    try testing.assertEqual(bridges.writeThrough(file, Mode.appended, "two".toBytes()), 0);

    let read = bridges.readThrough(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.bytes, "onetwo".toBytes());
}

test "an open from empty drops what was there" {
    string folder = try scratch.folder("truncated");
    string file = path.join(folder, "shrinking.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "longer".toBytes()),
        0);
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "no".toBytes()), 0);

    let read = bridges.readThrough(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.bytes, "no".toBytes());
}

test "an open that must create refuses a path that is already there" {
    string folder = try scratch.folder("exclusive");
    string file = path.join(folder, "claimed.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.createdNew, "mine".toBytes()), 0);

    int again = bridges.openError(file, Mode.createdNew);
    try testing.assertNotEqual(again, 0);
    try testing.assertEqual(bridges.failureOf(again), Failure.alreadyExists);
}

test "an open to read says why there is nothing to read" {
    string folder = try scratch.folder("unreadable");
    int why = bridges.openError(path.join(folder, "nothing"), Mode.read);
    try testing.assertNotEqual(why, 0);
    try testing.assertEqual(bridges.failureOf(why), Failure.notFound);
}

// Win32 has no code meaning that a directory was named, and reports a permission it does not have.
test "an open that writes is refused a directory in each platform's own terms" {
    string folder = try scratch.folder("directory.open");
    int why = bridges.openError(folder, Mode.writeTruncated);
    try testing.assertNotEqual(why, 0);
    long expected = Failure.isADirectory;
    if (system.platform() == "windows") {
        expected = Failure.permissionDenied;
    }
    try testing.assertEqual(bridges.failureOf(why), expected);
}

test "creating a directory that is already there says so" {
    string folder = try scratch.folder("claimed.directory");
    string inside = path.join(folder, "one");
    try testing.assertEqual(bridges.createDirectory(inside), 0);
    try testing.assertEqual(bridges.metadataOf(inside, true).kind, Kind.directory);

    int again = bridges.createDirectory(inside);
    try testing.assertNotEqual(again, 0);
    try testing.assertEqual(bridges.failureOf(again), Failure.alreadyExists);
}

test "removing a file that is not there says so" {
    string folder = try scratch.folder("removed");
    string file = path.join(folder, "brief.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "gone".toBytes()), 0);
    try testing.assertEqual(bridges.removeFile(file), 0);

    int again = bridges.removeFile(file);
    try testing.assertNotEqual(again, 0);
    try testing.assertEqual(bridges.failureOf(again), Failure.notFound);
}

test "removing a directory that still holds something says so" {
    string folder = try scratch.folder("full.directory");
    string inside = path.join(folder, "holder");
    try testing.assertEqual(bridges.createDirectory(inside), 0);
    try testing.assertEqual(bridges.writeThrough(path.join(inside, "held.bin"),
        Mode.writeTruncated, "held".toBytes()), 0);

    int full = bridges.removeDirectory(inside);
    try testing.assertNotEqual(full, 0);
    try testing.assertEqual(bridges.failureOf(full), Failure.directoryNotEmpty);

    try testing.assertEqual(bridges.removeFile(path.join(inside, "held.bin")), 0);
    try testing.assertEqual(bridges.removeDirectory(inside), 0);
}

test "a rename refuses a destination that is taken and replaces one when asked" {
    string folder = try scratch.folder("renamed");
    string from = path.join(folder, "from.bin");
    string to = path.join(folder, "to.bin");
    try testing.assertEqual(bridges.writeThrough(from, Mode.writeTruncated, "moving".toBytes()),
        0);
    try testing.assertEqual(bridges.writeThrough(to, Mode.writeTruncated, "standing".toBytes()),
        0);

    int taken = bridges.rename(from, to, false);
    try testing.assertNotEqual(taken, 0);
    try testing.assertEqual(bridges.failureOf(taken), Failure.alreadyExists);
    try testing.assertEqual(bridges.readThrough(to).bytes, "standing".toBytes());

    try testing.assertEqual(bridges.rename(from, to, true), 0);
    try testing.assertEqual(bridges.readThrough(to).bytes, "moving".toBytes());
    try testing.assertNotEqual(bridges.metadataOf(from, true).error, 0);
}

test "a rename into a free name needs no replacing" {
    string folder = try scratch.folder("moved");
    string from = path.join(folder, "from.bin");
    string to = path.join(folder, "to.bin");
    try testing.assertEqual(bridges.writeThrough(from, Mode.writeTruncated, "carried".toBytes()),
        0);
    try testing.assertEqual(bridges.rename(from, to, false), 0);
    try testing.assertEqual(bridges.readThrough(to).bytes, "carried".toBytes());
}

// A kind read at a wrong offset lands on a length or on the first letter of the name, and no letter
// is a kind any system reports, so a wrong offset cannot answer either of these correctly.
test "a folder hands over what it holds with each entry's kind" {
    string folder = try scratch.folder("listed");
    try testing.assertEqual(bridges.writeThrough(path.join(folder, "alpha.txt"),
        Mode.writeTruncated, "a".toBytes()), 0);
    try testing.assertEqual(bridges.createDirectory(path.join(folder, "beta")), 0);

    let listing = bridges.listThrough(folder);
    try testing.assertEqual(listing.error, 0);
    try testing.assertEqual(listing.entries, ["alpha.txt:{Kind.file}", "beta:{Kind.directory}"]);
}

test "a folder with nothing in it hands over nothing" {
    string folder = try scratch.folder("bare");
    let listing = bridges.listThrough(folder);
    try testing.assertEqual(listing.error, 0);
    try testing.assertEqual(listing.entries.length, 0);
}

test "a folder read where a file is says so" {
    string folder = try scratch.folder("not.a.folder");
    string file = path.join(folder, "barrier.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "no".toBytes()), 0);

    let listing = bridges.listThrough(file);
    try testing.assertNotEqual(listing.error, 0);
    try testing.assertEqual(bridges.failureOf(listing.error), Failure.notADirectory);
}

// Windows carries no permission bits a copy could hand over, so the answer alone is what it owes.
test "a copy hands over the permission bits on the systems that have them" {
    string folder = try scratch.folder("permissions");
    string from = path.join(folder, "runnable");
    string to = path.join(folder, "copy");
    try testing.assertEqual(bridges.writeThrough(from, Mode.writeTruncated, "#!/bin/sh\n"
        .toBytes()), 0);
    try testing.assertEqual(bridges.writeThrough(to, Mode.writeTruncated, "#!/bin/sh\n"
        .toBytes()), 0);
    if (system.platform() == "windows") {
        try testing.assertEqual(bridges.copyPermissions(from, to), 0);
        return;
    }
    try testing.assertEqual(try system.run("chmod +x '{from}'"), 0);
    try testing.assertNotEqual(try system.run("test -x '{to}'"), 0);
    try testing.assertEqual(bridges.copyPermissions(from, to), 0);
    try testing.assertEqual(try system.run("test -x '{to}'"), 0);
}

test "a copy of the permissions of nothing says why" {
    string folder = try scratch.folder("no.permissions");
    if (system.platform() == "windows") {
        try testing.assertEqual(bridges.copyPermissions(path.join(folder, "nothing"),
            path.join(folder, "nowhere")), 0);
        return;
    }
    int why = bridges.copyPermissions(path.join(folder, "nothing"), path.join(folder, "nowhere"));
    try testing.assertNotEqual(why, 0);
    try testing.assertEqual(bridges.failureOf(why), Failure.notFound);
}

// The whole point of reaching Windows through its wide entry points, which the narrow ones this
// library still uses elsewhere cannot do at all.
test "a name outside the system code page survives every bridge" {
    string folder = try scratch.folder("wide");
    string file = path.join(folder, Wide.name);
    byte[] content = "written wide".toBytes();
    try testing.assertEqual(bridges.writeThrough(file, Mode.createdNew, content), 0);

    let read = bridges.readThrough(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.bytes, content);

    let found = bridges.metadataOf(file, true);
    try testing.assertEqual(found.error, 0);
    try testing.assertEqual(found.kind, Kind.file);
    try testing.assertEqual(found.length, content.length);

    let listing = bridges.listThrough(folder);
    try testing.assertEqual(listing.error, 0);
    try testing.assertEqual(listing.entries, ["{Wide.name}:{Kind.file}"]);

    let real = bridges.realPathOf(file);
    try testing.assertEqual(real.error, 0);
    try testing.assertTrue(real.text.endsWith(Wide.name),
        "the real path '{real.text}' does not end with the name it was asked about");

    string moved = path.join(folder, "moved-" + Wide.name);
    try testing.assertEqual(bridges.rename(file, moved, false), 0);
    try testing.assertEqual(bridges.removeFile(moved), 0);
    try testing.assertNotEqual(bridges.metadataOf(moved, true).error, 0);
}
