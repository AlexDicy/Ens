// What the bridges that change what is on disk answer on the host running the suite, and what the
// wide open finally makes reachable, which is a name outside the system code page.
import Path from @std.fs;
import Platform from @std.platform;
import @std.environment;
import @std.process;
import @std.testing;
import Failure from bridges;
import HeldStream from bridges;
import Kind from bridges;
import LibraryStream from bridges;
import Mode from bridges;
import bridges;
import scratch;

// A name no Windows code page can hold, which every bridge has to carry as the bytes it was given.
public final class Wide {
    public static const string name = "café-日本語.txt";
}

// No mode may hand back a stream over a directory, since reading it would fail with nothing but a
// stream error to report. Win32 has no code meaning that a directory was named and reports a
// permission it does not have.
test "an open is refused a directory in every mode and in each platform's own terms" {
    string folder = try scratch.folder("directory.open");
    bool onWindows = environment.platform() == Platform.Windows;
    long expected = Failure.isADirectory;
    if (onWindows) {
        expected = Failure.permissionDenied;
    }
    int[] modes = [Mode.read, Mode.writeTruncated, Mode.appended];
    for (let mode in modes) {
        int why = bridges.openError(folder, mode);
        try testing.assertNotEqual(why, 0);
        try testing.assertEqual(bridges.failureOf(why), expected);
    }

    // Creating and refusing what is there makes two conditions true at once, and POSIX orders the
    // two errors nowhere, so pinning either would pin what today's kernels happen to check first.
    // Both answers are useful, since a caller that asked for a free name is told the name is taken.
    // The three modes above pin 'isADirectory' exactly, and an exclusive create over a file
    // pins 'alreadyExists' exactly, so accepting either kind here hides no wrong mapping.
    int taken = bridges.openError(folder, Mode.createdNew);
    try testing.assertNotEqual(taken, 0);
    long kind = bridges.failureOf(taken);
    if (onWindows) {
        try testing.assertEqual(kind, Failure.permissionDenied);
    } else {
        try testing.assertTrue(kind == Failure.alreadyExists || kind == Failure.isADirectory,
            "the exclusive create answered kind {kind} rather than that the name is taken or "
            + "that it names a directory");
    }
}

// A kind read at a wrong offset lands on a length or on the first letter of the name, and no letter
// is a kind any system reports, so a wrong offset cannot answer either of these correctly.
test "a folder lists what it holds with each entry's kind" {
    string folder = try scratch.folder("listed");
    try testing.assertEqual(bridges.writeThrough(scratch.joined(folder, "alpha.txt"),
        Mode.writeTruncated, "a".toBytes()), 0);
    try testing.assertEqual(bridges.createDirectory(scratch.joined(folder, "beta")), 0);

    let listing = bridges.listThrough(folder);
    try testing.assertEqual(listing.error, 0);
    try testing.assertEqual(listing.entries, ["alpha.txt:{Kind.file}", "beta:{Kind.directory}"]);
}

test "a folder read where a file is reports it" {
    string folder = try scratch.folder("not.a.folder");
    string file = scratch.joined(folder, "barrier.bin");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "no".toBytes()), 0);

    let listing = bridges.listThrough(file);
    try testing.assertNotEqual(listing.error, 0);
    try testing.assertEqual(bridges.failureOf(listing.error), Failure.notADirectory);
}

// A caller asking for a data file must not be handed an executable one. All three writing modes
// reach the same call, so a change that corrected one and not the others would pass a test that
// only tried one of them.
test "a file the bridge creates is not executable" {
    string folder = try scratch.folder("not.executable");
    int[] modes = [Mode.writeTruncated, Mode.appended, Mode.createdNew];
    string[] names = ["truncated.bin", "appended.bin", "created.bin"];
    for (long i = 0; i < modes.length; i++) {
        string file = scratch.joined(folder, names[i]);
        try testing.assertEqual(bridges.writeThrough(file, modes[i], "data".toBytes()), 0);
        try testing.assertEqual(bridges.metadataOf(file, true).kind, Kind.file);
        if (environment.platform() != Platform.Windows) {
            try testing.assertFalse(try runnable(file), "'{file}' was made executable");
        }
    }
}

// The child counts the descriptors it inherited, and a file held open through the bridge must not
// change that count. The C library's own open is the control, since it marks nothing
// close-on-exec. Windows hands a child only the handles it is told to, so a shell there has
// nothing to look for.
test "a file opened through the bridge does not reach a child" {
    if (environment.platform() == Platform.Windows) {
        return;
    }
    string folder = try scratch.folder("not.inherited");
    long baseline = try descriptorsReachingAChild();

    let control = new LibraryStream(scratch.joined(folder, "control.bin"));
    try testing.assertTrue(control.isOpen(), "the control file could not be opened");
    long withControl = try descriptorsReachingAChild();
    control.close();
    try testing.assertEqual(withControl, baseline + 1);

    let held = new HeldStream(scratch.joined(folder, "held.bin"), Mode.writeTruncated);
    try testing.assertTrue(held.isOpen(), "the bridge could not open the file to be held");
    long withHeld = try descriptorsReachingAChild();
    held.close();
    try testing.assertEqual(withHeld, baseline);
}

// How many descriptors a program started now finds open, its own included. The child is let go
// before this returns, so its pipes are not among what the next one sees.
descriptorsReachingAChild() -> long throws {
    let child = try process.spawn(Path("/bin/sh"), ["-c", "ls /dev/fd"]);
    long found = 0;
    string? line = try child.stdout().readLine();
    while (line != null) {
        found = found + 1;
        line = try child.stdout().readLine();
    }
    let ended = try child.wait();
    return found;
}

// Whether this system will run the file, asked of its own test program so no bridge under test
// takes part.
runnable(string file) -> bool throws {
    return (try process.runShell("test -x '{file}'")).status.succeeded();
}

// Windows carries no permission bits a copy could hand over, so the answer alone is what it owes.
test "a copy carries the permission bits on the systems that have them" {
    string folder = try scratch.folder("permissions");
    string from = scratch.joined(folder, "runnable");
    string to = scratch.joined(folder, "copy");
    try testing.assertEqual(bridges.writeThrough(from, Mode.writeTruncated, "#!/bin/sh\n"
        .toBytes()), 0);
    try testing.assertEqual(bridges.writeThrough(to, Mode.writeTruncated, "#!/bin/sh\n"
        .toBytes()), 0);
    if (environment.platform() == Platform.Windows) {
        try testing.assertEqual(bridges.copyPermissions(from, to), 0);
        return;
    }
    try testing.assertTrue((try process.runShell("chmod +x '{from}'")).status.succeeded(),
        "'{from}' could not be made executable");
    try testing.assertFalse(try runnable(to), "'{to}' was executable before the copy");
    try testing.assertEqual(bridges.copyPermissions(from, to), 0);
    try testing.assertTrue(try runnable(to), "'{to}' did not take the permission bits over");
}

// 0x1ED is rwxr-xr-x, 0x1A4 rw-r--r--, and 0x16D r-xr-xr-x, a read-only file on Windows.
test "permissions read back as they were set, and only the nine low bits are set" {
    string folder = try scratch.folder("permissions.set");
    string file = scratch.joined(folder, "runnable");
    try testing.assertEqual(bridges.writeThrough(file, Mode.writeTruncated, "#!/bin/sh\n"
        .toBytes()), 0);
    if (environment.platform() == Platform.Windows) {
        try testing.assertEqual(bridges.setPermissions(file, 0x16D), 0);
        let readOnly = bridges.permissions(file);
        try testing.assertEqual(readOnly.error, 0);
        try testing.assertEqual(readOnly.mode, 0x16D);
        try testing.assertEqual(bridges.setPermissions(file, 0x1A4), 0);
        try testing.assertEqual(bridges.permissions(file).mode, 0x1FF);
        return;
    }
    try testing.assertEqual(bridges.setPermissions(file, 0x1A4), 0);
    try testing.assertEqual(bridges.permissions(file).mode, 0x1A4);
    try testing.assertFalse(try runnable(file), "'{file}' is executable at rw-r--r--");
    try testing.assertEqual(bridges.setPermissions(file, 0xFED), 0);
    let read = bridges.permissions(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.mode, 0x1ED);
    try testing.assertTrue(try runnable(file), "'{file}' is not executable at rwxr-xr-x");
}

test "the permissions of nothing report why" {
    string folder = try scratch.folder("permissions.nothing");
    string nothing = scratch.joined(folder, "nothing");
    try testing.assertEqual(bridges.failureOf(bridges.permissions(nothing).error),
        Failure.notFound);
    try testing.assertEqual(bridges.failureOf(bridges.setPermissions(nothing, 0x1ED)),
        Failure.notFound);
}

test "a copy of the permissions of nothing reports why" {
    string folder = try scratch.folder("no.permissions");
    if (environment.platform() == Platform.Windows) {
        try testing.assertEqual(bridges.copyPermissions(scratch.joined(folder, "nothing"),
            scratch.joined(folder, "nowhere")), 0);
        return;
    }
    int why = bridges.copyPermissions(scratch.joined(folder, "nothing"),
        scratch.joined(folder, "nowhere"));
    try testing.assertNotEqual(why, 0);
    try testing.assertEqual(bridges.failureOf(why), Failure.notFound);
}

// The whole point of reaching Windows through its wide entry points, which the narrow ones this
// library still uses elsewhere cannot do at all.
test "a name outside the system code page survives every bridge" {
    string folder = try scratch.folder("wide");
    string file = scratch.joined(folder, Wide.name);
    byte[] content = "written wide".toBytes();
    try testing.assertEqual(bridges.writeThrough(file, Mode.createdNew, content), 0);

    let read = bridges.readThrough(file);
    try testing.assertEqual(read.error, 0);
    try testing.assertEqual(read.bytes, content);

    let found = bridges.metadataOf(file, true);
    try testing.assertEqual(found.error, 0);
    try testing.assertEqual(found.kind, Kind.file);
    try testing.assertEqual(found.length, content.length);

    let listing = bridges.listThrough(folder);
    try testing.assertEqual(listing.error, 0);
    try testing.assertEqual(listing.entries, ["{Wide.name}:{Kind.file}"]);

    let real = bridges.realPathOf(file);
    try testing.assertEqual(real.error, 0);
    try testing.assertTrue(real.text.endsWith(Wide.name),
        "the real path '{real.text}' does not end with the name it was asked about");

    string moved = scratch.joined(folder, "moved-" + Wide.name);
    try testing.assertEqual(bridges.rename(file, moved, false), 0);
    try testing.assertEqual(bridges.removeFile(moved), 0);
    try testing.assertNotEqual(bridges.metadataOf(moved, true).error, 0);
}
