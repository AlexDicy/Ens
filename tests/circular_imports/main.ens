// @exit 37
// @stdout left sees 35
// @stdout right sees 7
// @stdout greetings from right
// `left` and `right` import each other, with free functions calling both ways, classes holding
// references to each other, a generic from `left` instantiated with a class from `right`, and
// `right` implementing an interface declared in `left`.
import Left from left;
import Right from right;
import Greeter from right;
import left;
import right;

main() -> int {
    let l = new Left(7);
    let r = new Right(35);
    l.partner = r;
    r.partner = l;
    long leftView = l.partnerTag();
    long rightView = r.partnerTag();
    print("left sees {leftView}");
    print("right sees {rightView}");
    let g = new Greeter();
    print(g.describe());
    let boxed = right.boxedRight();
    return (left.leftValue() + right.rightValue() + boxed.get().tag()) as int;
}
