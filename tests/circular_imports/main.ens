// @exit 37
// @stdout left sees 35
// @stdout right sees 7
// @stdout greetings from right
// `left` and `right` import each other: free functions call across both ways,
// the classes hold references to each other, a generic from `left` is
// instantiated with a class from `right`, and `right` implements an interface
// declared in `left`.
import left;
import right;

main() -> int {
    let l = new left.Left(7);
    let r = new right.Right(35);
    l.partner = r;
    r.partner = l;
    long leftView = l.partnerTag();
    long rightView = r.partnerTag();
    print("left sees {leftView}");
    print("right sees {rightView}");
    let g = new right.Greeter();
    print(g.describe());
    let boxed = right.boxedRight();
    return (left.leftValue() + right.rightValue() + boxed.get().tag()) as int;
}
