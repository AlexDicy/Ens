import right;

public interface Describable {
    describe() -> string;
}

public class Box<T> {
    T item;

    public constructor(this.item);

    public get() -> T {
        return this.item;
    }
}

public class Left {
    public right.Right? partner;
    long value;

    public constructor(this.value);

    public tag() -> long {
        return this.value;
    }

    public partnerTag() -> long {
        if (this.partner != null) {
            return this.partner.tag();
        }
        return -1;
    }
}

public leftBase() -> long {
    return 10;
}

public leftValue() -> long {
    return right.rightBase() + 1;
}
