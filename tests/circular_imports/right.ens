import left;
import Describable from left;

public class Right {
    left.Left? partner;
    long value;

    Right(this.value);

    public tag() -> long {
        return this.value;
    }

    public partnerTag() -> long {
        if (this.partner != null) {
            return this.partner.tag();
        }
        return -1;
    }
}

public class Greeter implements Describable {
    Greeter();

    public override describe() -> string {
        return "greetings from right";
    }
}

public rightBase() -> long {
    return 20;
}

public rightValue() -> long {
    return left.leftBase() + 2;
}

public boxedRight() -> left.Box<Right> {
    return new left.Box<Right>(new Right(4));
}
