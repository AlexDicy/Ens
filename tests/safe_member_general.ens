// @exit 0
// @stdout class-field 4
// @stdout class-null ok
// @stdout value-field 9
// @stdout value-null ok
// @stdout method 8
// @stdout method-null -1
// @stdout void-call 1 0
// @stdout struct-recv 6
// @stdout struct-field ok
// @stdout string-length 5 -1
// @stdout array-length 3
// @stdout subscript 7 0
// @stdout optional-field collapse ok

class Engine {
    int power;
    Engine(this.power);
    boost() -> int { return this.power * 2; }
    markUsed() { this.power = this.power + 1; }
}

class Car {
    Engine? engine;
    int wheels = 4;
    Car(this.engine = null);
}

struct Point {
    int x;
    int y;
    sum() -> int { return this.x + this.y; }
}

makePoint(int x, int y) -> Point {
    Point p;
    p.x = x;
    p.y = y;
    return p;
}

main() -> int {
    Car? car = new Car(new Engine(4));
    Car? nothing = null;

    // A value-typed field through '?.' produces a value-type optional.
    int? wheels = nothing?.wheels;
    if ((car?.wheels ?? 0) == 4) { print("class-field 4"); }
    if (wheels == null) { print("class-null ok"); }

    let ninerCar = new Car();
    ninerCar.wheels = 9;
    Car? niner = ninerCar;
    print("value-field " + (niner?.wheels ?? 0));
    if (nothing?.wheels == null) { print("value-null ok"); }

    // Method calls through '?.' work for any return type.
    print("method " + (car?.engine?.boost() ?? -1));
    print("method-null " + (nothing?.engine?.boost() ?? -1));

    // A void safe call runs only when the receiver is present.
    Engine? used = new Engine(0);
    used?.markUsed();
    nothing?.engine?.markUsed();
    print("void-call " + (used?.power ?? -1) + " " + (nothing?.wheels ?? 0));

    // Nullable struct receivers unwrap per member access.
    Point? point = makePoint(2, 4);
    Point? missing = null;
    print("struct-recv " + (point?.sum() ?? -1));
    if (missing?.sum() == null && (point?.x ?? 0) == 2 && missing?.x == null) {
        print("struct-field ok");
    }

    // Nullable strings and arrays expose length through '?.'.
    string? name = "hello";
    string? unnamed = null;
    print("string-length " + (name?.length ?? 0) + " " + (unnamed?.length ?? -1));
    int[]? numbers = [1, 2, 3];
    print("array-length " + (numbers?.length ?? 0));

    // Safe subscript now supports value elements too.
    int[]? scores = [7, 8];
    int[]? absent = null;
    print("subscript " + (scores?[0] ?? 0) + " " + (absent?[0] ?? 0));

    // A field that is already nullable collapses: no double optional.
    Car? bare = new Car();
    Engine? viaChain = bare?.engine;
    if (viaChain == null) { print("optional-field collapse ok"); }

    return 0;
}