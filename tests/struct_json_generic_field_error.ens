// @expect-error 'render<Node>' cannot interpolate a value of type 'Wrap<Node>': struct 'Wrap' has no text form. Field 'item' has type 'Node', which has no string form; only value types, strings, enums, their nullable forms, and nested such structs serialize to JSON. Give 'Wrap' a 'toString' of its own, or pass a type argument that has a text form.
// @expect-note 'render<T>' interpolates a value of type 'Wrap<T>' here
// A generic struct serializes to JSON only where its field type does. The check
// cannot be decided on the open type parameter, so it defers to each
// instantiation; instantiating 'Wrap' at a class type surfaces the error, at the
// call that supplied the type argument.

class Node {
    int value;
    constructor(this.value);
}

struct Wrap<T> {
    T item;
}

render<T>(Wrap<T> w) -> string {
    return "wrapped {w}";
}

useNodes(Wrap<Node> w) -> string {
    return render<Node>(w);
}

main() -> int {
    return 0;
}
