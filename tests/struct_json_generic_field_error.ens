// @expect-error 'render<Node>' cannot interpolate a value of type 'Wrap<Node>': struct 'Wrap' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'item' has type 'Node', and a class value has no JSON form. Give 'Wrap' an 'override toString() -> string' of its own, or pass a type argument that has a JSON form.
// @expect-note 'render<T>' interpolates a value of type 'Wrap<T>' here
// @expect-error 'renderCalled<Node>' cannot call 'toString' on a value of type 'Wrap<Node>': struct 'Wrap' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'item' has type 'Node', and a class value has no JSON form. Give 'Wrap' an 'override toString() -> string' of its own, or pass a type argument that has a JSON form.
// @expect-note 'renderCalled<T>' calls 'toString' on a value of type 'Wrap<T>' here
// @expect-error 'renderBox<Node>' cannot interpolate a value of type 'Box<Node>': struct 'Box' has no text form. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'wrap.item' has type 'Node', and a class value has no JSON form. Give 'Box' an 'override toString() -> string' of its own, or pass a type argument that has a JSON form.
// @expect-note 'renderBox<T>' interpolates a value of type 'Box<T>' here
// @expect-error build failed with 3 problems
// A generic struct serializes to JSON only where its field type does. The check
// cannot be decided on the open type parameter, so it defers to each
// instantiation; instantiating 'Wrap' at a class type surfaces the error, at the
// call that supplied the type argument.

class Node {
    int value;
    constructor(this.value);
}

struct Wrap<T> {
    T item;
}

struct Box<T> {
    Wrap<T> wrap;
}

render<T>(Wrap<T> w) -> string {
    return "wrapped {w}";
}

renderCalled<T>(Wrap<T> w) -> string {
    return w.toString();
}

renderBox<T>(Box<T> b) -> string {
    return "boxed {b}";
}

useNodes(Wrap<Node> w, Box<Node> b) -> string {
    return render<Node>(w) + renderCalled<Node>(w) + renderBox<Node>(b);
}

main() -> int {
    return 0;
}
