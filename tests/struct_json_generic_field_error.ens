// @expect-error Struct 'Wrap' cannot be converted to a string. Field 'item'
// A generic struct serializes to JSON only where its field type does. The check
// cannot be decided on the open type parameter, so it defers to each
// instantiation; instantiating 'Wrap' at a class type surfaces the error.

class Node {
    int value;
    constructor(this.value);
}

struct Wrap<T> {
    T item;
}

render<T>(Wrap<T> w) -> string {
    return "wrapped {w}";
}

useNodes(Wrap<Node> w) -> string {
    return render<Node>(w);
}

main() -> int {
    return 0;
}
