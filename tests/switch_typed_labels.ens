// @exit 6
// A typed long literal labels an integer switch just like a plain int literal or
// a char literal. Over a long scrutinee each of 1L, 2, and 'A' names a distinct
// label; the value must fit the scrutinee's type as any integer label would.
kind(long n) -> int {
    return switch (n) {
        1L -> 1,
        2 -> 2,
        'A' -> 3,
        default -> 0,
    };
}

main() -> int {
    // 'A' is 65; each label holds directly in a long.
    long a = 1;
    long b = 2;
    long c = 65;
    long d = 99;
    return kind(a) + kind(b) + kind(c) + kind(d);
}
