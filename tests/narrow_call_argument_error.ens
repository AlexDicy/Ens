// @expect-error Cannot read a member of 'Door?'
// A call keeps a plain local's own narrowing, but drops any member-path
// narrowing rooted at a value the call touches. Passing 'box' lets the callee
// mutate 'box.door', so that field's narrowing cannot survive the call.
class Door {
    int code;

    constructor(this.code = 0);
}

class Box {
    Door? door;

    constructor(this.door = null);
}

private touch(Box b) {
}

main() -> int {
    let box = new Box(new Door(5));
    if (box.door != null) {
        touch(box);            // box passed as an argument: box.door narrowing dropped
        return box.door.code;  // error - box.door is back to 'Door?'
    }
    return 0;
}
