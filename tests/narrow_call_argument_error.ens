// @expect-error Cannot read a member of 'Door?'
// Passing the narrowed local as an argument still drops the narrowing: the
// callee could mutate state reachable through it.
class Door {
    int code;
    constructor(this.code = 0);
}

class Registry {
    Door? slot;
    constructor(this.slot = null);

    stash(Door? door) {
        this.slot = door;
    }
}

main() -> int {
    let registry = new Registry(null);
    Door? d = new Door(5);
    if (d != null) {
        registry.stash(d);  // d passed as an argument: narrowing dropped
        return d.code;      // error - d is back to 'Door?'
    }
    return 0;
}
