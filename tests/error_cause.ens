// @exit 0
// @stdout no cause: could not open config.toml
// @stdout one cause: could not open config.toml
// @stdout caused by ReadError: no such file or directory
// @stdout two causes: request failed
// @stdout caused by OpenError: could not open config.toml
// @stdout caused by ReadError: no such file or directory
// @stdout cause of the outer: could not open config.toml
// @stdout innermost cause: no such file or directory
// @stdout a chain reaching itself still ends
// An error wraps the error it was raised in response to. `cause` is null when it wraps nothing,
// reading the chain from the outside in goes from what failed to why, and the text form names each
// cause by its own type, since that is what a catch clause selects on. Only a bounded number of
// causes are written, so an error handed itself as its own cause still produces text.
class ReadError extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class OpenError extends Error {
    protected constructor(string message, Error? cause) {
        super(message, cause);
    }
}

class RequestError extends Error {
    protected constructor(string message, Error? cause) {
        super(message, cause);
    }
}

class SelfCaused extends Error {
    protected constructor(string message) {
        super(message, this);
    }
}

main() -> int {
    let alone = new OpenError("could not open config.toml", null);
    print("no cause: " + alone.toString());

    let inner = new ReadError("no such file or directory");
    let wrapped = new OpenError("could not open config.toml", inner);
    print("one cause: " + wrapped.toString());

    let outer = new RequestError("request failed", wrapped);
    print("two causes: " + outer.toString());

    let middle = outer.cause;
    if (middle == null) {
        return 1;
    }
    print("cause of the outer: " + middle.message);

    let deepest = middle.cause;
    if (deepest == null) {
        return 1;
    }
    print("innermost cause: " + deepest.message);

    if (deepest.cause != null) {
        return 1;
    }

    let looping = new SelfCaused("a cause reaching itself");
    if (looping.toString().indexOf("and further causes") < 0) {
        return 1;
    }
    print("a chain reaching itself still ends");
    return 0;
}
