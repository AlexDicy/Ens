// The stand-in '@std.core' whose 'StackFrame' is a struct rather than a class. The trace runtime
// builds a frame in whichever shape this module declares, so both shapes need a program that runs.
// The real one is libs/std/src/core.ens, which still declares a class until the seed that reads
// both is pinned.
export abstract class Error {
    export const string message;

    private long[]? frames;

    export const Error? cause;

    protected constructor(this.message, this.cause = null);

    export override toString() -> string {
        long remaining = 32;
        string text = this.message;
        Error? next = this.cause;
        while (next != null && remaining > 0) {
            text = text + "\ncaused by " + next.typeName() + ": " + next.message;
            next = next.cause;
            remaining = remaining - 1;
        }
        if (next != null) {
            text = text + "\nand further causes";
        }
        return text;
    }

    private final typeName() -> string {
        return "";
    }

    export final stackTrace() -> string {
        return "";
    }

    export final stackFrames() -> StackFrame[] {
        return [];
    }
}

export struct StackFrame {
    export const string function;
    export const string file;
    export const int line;
}
