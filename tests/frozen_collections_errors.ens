// A frozen collection has an '==' and a hash exactly when the values it holds do, so one over values
// with none is refused where it is compared, hashed or used as a key, and nowhere else. One is
// shareable when its values are, so one over writable objects stays inside its task.
import Map from @std.collections.map;
import FrozenList from @std.collections.frozen;
import FrozenSet from @std.collections.frozen;
import Channel from @std.tasks;

final class Node {
    int value = 1;
}

shared final class Shelf {
    const FrozenList<Node> nodes;

    constructor(this.nodes);
}

struct Sample {
    FrozenList<double> readings;
}

main() -> int {
    let doubles = FrozenList.of([1.5, 2.5]);
    long direct = doubles.hash();
    let table = new Map<FrozenList<double>, int>();
    (() -> int) one = () -> 1;
    let actions = FrozenList.of([one]);
    bool same = actions == FrozenList.of([one]);
    Sample sample = {readings: doubles};
    long folded = sample.hash();
    let points = FrozenSet.of([0.5]);
    let refused = new Channel<FrozenList<Node>>(1);
    int[] counts = [1];
    let argued = counts.frozen(1);
    return 0;
}
