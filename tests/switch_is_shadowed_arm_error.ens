// @expect-error This 'is Dot' arm is unreachable
sealed abstract class Shape { constructor(); }
class Circle extends Shape { constructor() { super(); } }
class Dot extends Circle { constructor() { super(); } }
class Square extends Shape { constructor() { super(); } }

main() -> int {
    Shape s = new Dot();
    switch (s) {
        is Circle -> { },
        is Dot -> { },        // already matched by the Circle arm above
        is Square -> { },
    }
    return 0;
}
