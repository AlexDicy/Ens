// @expect-error This 'is Dot' arm is unreachable
sealed abstract class Shape { Shape(); }
class Circle extends Shape { Circle() { super(); } }
class Dot extends Circle { Dot() { super(); } }
class Square extends Shape { Square() { super(); } }

main() -> int {
    Shape s = new Dot();
    switch (s) {
        is Circle -> { },
        is Dot -> { },        // already matched by the Circle arm above
        is Square -> { },
    }
    return 0;
}
