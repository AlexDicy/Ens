// @expect-error Argument 1 of 'substring' has type 'string', but 'substring(long, long)', the only 'substring' that takes two arguments, takes a 'long' there.
// @expect-error 'slice' takes integer indexes, but '"a"' has type 'string'.
// 'substring' is a member the standard library declares, so a wrong argument is an ordinary
// overload problem; 'slice' is still the compiler's own, and reports its own way.
main() -> int {
    let s = "hello";
    let t = s.substring("a", 2);
    byte[] raw = s.toBytes();
    let part = raw.slice("a", 2);
    return t.length as int;
}
