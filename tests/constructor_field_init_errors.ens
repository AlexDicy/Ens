// @expect-error Field 'value' of class 'OneBranch' is not assigned on every path through this constructor
// @expect-error Field 'label' of class 'EarlyReturn' is not assigned on every path through this constructor
// @expect-error Field 'name' of struct 'Tagged' is not assigned on every path through this constructor
// A non-nullable field must be definitely assigned on every path through each constructor.
// Assigning it in only one branch of an if, or only after a conditional early return, leaves a
// path on which the field is never given a value. The message names the kind of type it is
// about, a struct as a struct.
class OneBranch {
    string value;
    constructor(bool c) {
        if (c) {
            this.value = "x";
        }
    }
}

class EarlyReturn {
    string label;
    constructor(bool skip) {
        if (skip) {
            return;
        }
        this.label = "late";
    }
}

struct Tagged {
    string name;
    constructor(bool c) {
        if (c) {
            this.name = "x";
        }
    }
}

main() -> int {
    return 0;
}
