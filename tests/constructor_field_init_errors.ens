// @expect-error Field 'label' of class 'EarlyReturn' cannot be null, and it is not assigned on every path through this constructor. Assign it on every path, for example 'this.label = ...;'.
// @expect-error Field 'name' of struct 'Tagged' cannot be null, and it is not assigned on every path through this constructor. Assign it on every path, for example 'this.name = ...;'.
// @expect-error The constructor of 'Recovers' can return an object whose base class 'Named' was never constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', and this 'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' and returns a value to pass to 'super(...)'. If the program cannot continue without that value, end the clause with 'panic(...)'.
// @expect-error This 'return' can end the constructor of 'ReturnsEarly' after 'refuseText' throws 'Refusal' in the arguments of 'super(...)', so the object would be returned without its base class 'Named' constructed. Move the call into a function that catches 'Refusal' and returns a value to pass to 'super(...)'. If the program cannot continue without that value, replace 'return;' with 'panic(...)'.
// @expect-error The constructor of 'Leaf' can return an object whose base class 'Middle' was never constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', and this 'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' and returns a value to pass to 'super(...)'. If the program cannot continue without that value, end the clause with 'panic(...)'.
// @expect-error The constructor of 'TextBox' can return an object whose base class 'Box<string>' was never constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', and this 'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' and returns a value to pass to 'super(...)'. If the program cannot continue without that value, end the clause with 'panic(...)'.
// @expect-error build failed with 7 problems
// A non-nullable field must be definitely assigned on every path through each constructor, so
// assigning it in one branch of an if, or after a conditional early return, leaves a path that
// never gives it a value. The message names the kind of type it is about, a struct as a struct.
// The base class counts the same way: a catch clause that can catch what the arguments of
// 'super(...)' throw, and then finishes the constructor normally, would return an object whose
// base class was never constructed. A clause that only catches what is thrown later is not refused.
class OneBranch {
    string value;
    constructor(bool c) {
        if (c) {
            this.value = "x";
        }
    }
}

class EarlyReturn {
    string label;
    constructor(bool skip) {
        if (skip) {
            return;
        }
        this.label = "late";
    }
}

struct Tagged {
    string name;
    constructor(bool c) {
        if (c) {
            this.name = "x";
        }
    }
}

class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

class Shortage extends Error {
    constructor() {
        super("short");
    }
}

refuseText() -> string throws Refusal {
    throw new Refusal();
}

refuseCount() -> int throws Shortage {
    throw new Shortage();
}

class Named {
    protected string name;

    protected constructor(this.name);
}

class Recovers extends Named {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class ReturnsEarly extends Named {
    constructor() {
        super(try refuseText());
    } catch (Error error) {
        return;
    }
}

class Middle extends Named {
    protected constructor(string name) {
        super(name);
    }
}

class Leaf extends Middle {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class Box<T> {
    protected T value;

    protected constructor(this.value);
}

class TextBox extends Box<string> {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class Counted extends Named {
    int count;

    constructor() {
        super(try refuseText());
        this.count = try refuseCount();
    } catch (Refusal refusal) {
        panic("no name");
    } catch (Shortage shortage) {
        this.count = 0;
    }
}

main() -> int {
    return 0;
}
