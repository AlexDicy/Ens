// @expect-error build failed with 17 problems
// A non-nullable field must be definitely assigned on every path through each constructor, so
// assigning it in one branch of an if, or after a conditional early return, leaves a path that
// never gives it a value. The message names the kind of type it is about, a struct as a struct.
// The base class counts the same way: a catch clause that can catch what the arguments of
// 'super(...)' throw, and then finishes the constructor normally, would return an object whose
// base class was never constructed. A clause that only catches what is thrown later is not refused.
// A field with no value of its own is read only where every path has assigned it, and a compound
// assignment, a write to a member of a struct field, and a call of a function value the field
// holds each read it first. A base class field has its value once 'super(...)' finishes. A catch
// clause has a field only where it is assigned before each place the body can throw what the
// clause catches, and each call of a chain is one of them.
class OneBranch {
    string value;
    constructor(bool c) {
        if (c) {
            this.value = "x";
        }
    }
}

class EarlyReturn {
    string label;
    constructor(bool skip) {
        if (skip) {
            return;
        }
        this.label = "late";
    }
}

struct Tagged {
    string name;
    constructor(bool c) {
        if (c) {
            this.name = "x";
        }
    }
}

class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

class Shortage extends Error {
    constructor() {
        super("short");
    }
}

refuseText() -> string throws Refusal {
    throw new Refusal();
}

refuseCount() -> int throws Shortage {
    throw new Shortage();
}

class Named {
    protected string name;

    protected constructor(this.name);
}

class Recovers extends Named {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class ReturnsEarly extends Named {
    constructor() {
        super(try refuseText());
    } catch (Error error) {
        return;
    }
}

class Middle extends Named {
    protected constructor(string name) {
        super(name);
    }
}

class Leaf extends Middle {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class Box<T> {
    protected T value;

    protected constructor(this.value);
}

class TextBox extends Box<string> {
    constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print("recovered");
    }
}

class Counted extends Named {
    int count;

    constructor() {
        super(try refuseText());
        this.count = try refuseCount();
    } catch (Refusal refusal) {
        panic("no name");
    } catch (Shortage shortage) {
        this.count = 0;
    }
}

class ReadsEarly {
    string label;

    constructor() {
        print(this.label);
        this.label = "set";
    }
}

class FromSelf extends Named {
    protected constructor() {
        super(this.name);
    }
}

class Interrupted {
    string label;
    int count;

    constructor(int value) {
        this.count = try refuseCount();
        this.label = "set";
    } catch (Shortage shortage) {
        print(this.label);
        this.label = "fallback";
    }
}

class ReadsBase extends Named {
    protected constructor() {
        super(try refuseText());
    } catch (Refusal refusal) {
        print(this.name);
        panic("a name is required");
    }
}

class Appended {
    string label;

    constructor() {
        this.label += "x";
        this.label = "y";
    }
}

struct Pair {
    string left;
    string right;
}

class Halves {
    Pair pair;

    constructor() {
        this.pair.left = "l";
        this.pair = {left: "a", right: "b"};
    }
}

class Source {
    constructor() {
    }

    use(string text) -> string throws Refusal {
        return try refuseText();
    }
}

makeSource() -> Source throws Refusal {
    throw new Refusal();
}

class Chained {
    string label;

    constructor() {
        print(try makeSource().use(this.label = "assigned"));
    } catch (Refusal refusal) {
        print(this.label);
        this.label = "fallback";
    }
}

class Thrown {
    string label;

    constructor(bool fail) {
        if (fail) {
            throw new Shortage();
        }
        this.label = "set";
    } catch (Shortage shortage) {
        this.label += "!";
    }
}

class Unfinished {
    string label;

    constructor() {
        this.label = try refuseText();
    } catch (Refusal refusal) {
        print("unfinished");
    }
}

class Called {
    () -> string callback;

    constructor() {
        print(this.callback());
        this.callback = () -> "called";
    }
}

main() -> int {
    return 0;
}
