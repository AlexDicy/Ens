// @expect-error A value of type 'Derived' is always a 'Base', so this 'is' test is always true.
// @expect-error build failed with 2 problems
class Base {
    protected constructor();
}

class Derived extends Base {
    protected constructor();
}

make() -> Derived {
    return new Derived();
}

main() -> int {
    if (make() is Base) { return 2; }
    bool made = make() is Base;
    return made ? 1 : 0;
}
