// @expect-error A value of type 'Derived' is always of type 'Base', so this 'is' test is always true. Remove it.
class Base {
    protected constructor();
}

class Derived extends Base {
    protected constructor();
}

main() -> int {
    Derived d = new Derived();
    if (d is Base) { return 1; }
    return 0;
}
