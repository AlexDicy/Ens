// @exit 0
// @stdout ctrl 8 12
// @stdout uchar 233
// @stdout ulen 2
// @stdout uroundtrip
// @stdout basics ok
// Escape decoding across char and string literals. Backspace and form feed are the control codes
// 8 and 12 rather than the letters b and f, and U+00E9 reaches the program from ASCII source as an
// integer in a char literal and as its two-byte UTF-8 form in a string.
main() -> int {
    int b = '\b';
    int f = '\f';
    int uc = '\u00E9';
    print("ctrl {b} {f}");
    print("uchar {uc}");

    let accented = "\u00E9";
    print("ulen {accented.length}");
    if (string.fromBytesLossy(accented.toBytes()) == accented) {
        print("uroundtrip");
    }

    int nl = '\n';
    int tab = '\t';
    int cr = '\r';
    int bs = '\\';
    int sq = '\'';
    int nul = '\0';
    if (nl == 10 && tab == 9 && cr == 13 && bs == 92 && sq == 39 && nul == 0) {
        print("basics ok");
    }
    return 0;
}
