// @exit 0
// @stdout released first
// @stdout step second
// @stdout receiver done
// @stdout released second
// @stdout receiver gone
// @stdout step safe
// @stdout safe done
// @stdout released safe
// @stdout safe gone
// @stdout element element
// @stdout released element
// @stdout element gone
// @stdout released old
// @stdout old new
// @stdout released new
// @stdout released left
// @stdout left right
// @stdout arguments done
// @stdout released right
// @stdout arguments gone
// @stdout released start
// @stdout declared shared shared
// @stdout released shared
// @stdout declared gone
// @stdout released held
// @stdout released field
// @stdout checked field
// @stdout watching watched
// @stdout released brief
// @stdout watching nothing
// @stdout fields done
// @stdout released watched
// @stdout released replacement
// @stdout fields gone
// @stdout released cell
// @stdout cell next
// @stdout text ab
// @stdout released next
// @stdout values gone
// @stdout released first cell
// @stdout cells first cell second cell
// @stdout equals old name new name
// @stdout released old name
// @stdout named false
// @stdout equals maybe maybe
// @stdout released maybe
// @stdout maybe true
// @stdout text false
// @stdout comparisons done
// @stdout released maybe
// @stdout released new name
// @stdout released second cell
// @stdout comparisons gone
// @stdout arm leaf
// @stdout released leaf
// @stdout released source copy
// @stdout written source
// @stdout places done
// @stdout released source
// @stdout released after leaf
// @stdout places gone
// @stdout narrowed narrowed narrowed
// @stdout released narrowed
// @stdout narrowed gone
// @stdout payload payload 4
// @stdout released payload
// @stdout payload gone
// An assignment read as a value reads its target back once the write is done, so the value is the
// target's own whether the assignment is a receiver, an argument or a declaration's value. A value
// read out of a local or a field that a later part of the same expression assigns again stays the
// value that was read, and stays alive until what uses it is done: a call, a comparison, the copy
// a struct argument takes, a type switch's arms, or the write into a target inside it. Each Node
// reports its own release, so an early release prints out of order and a missed one never prints.
// The value is what the target holds after the write, so storing a Node into a 'Node?' gives a Node,
// and storing a struct or a number into a nullable one gives the struct or the number.
class Node {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }

    protected step() -> Node? {
        print("step " + this.label);
        return null;
    }
}

class Holder {
    protected Node node;
    protected weak Node? watched;

    protected constructor(this.node);

    // Replaces the node while the caller still uses the one it passed in.
    protected check(Node seen) -> string {
        this.node = new Node("replacement");
        return seen.label;
    }
}

class Leaf extends Node {
    protected constructor(string label) {
        super(label);
    }
}

struct Cell {
    protected Node node;
}

labelOf(Cell cell) -> string {
    return cell.node.label;
}

counted(int value) -> int {
    return value;
}

make(string label) -> Node {
    return new Node(label);
}

maybeMake(string label) -> Node? {
    return new Node(label);
}

maybeNodes(string label) -> Node[]? {
    return [new Node(label)];
}

both(Node first, Node second) -> string {
    return first.label + " " + second.label;
}

cells(Cell first, Cell second) -> string {
    return first.node.label + " " + second.node.label;
}

class Named {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }

    override equals(Named other) -> bool {
        print("equals " + this.label + " " + other.label);
        return this.label == other.label;
    }

    override hash() -> long {
        return this.label.length;
    }
}

main() -> int {
    {
        Node b = new Node("first");
        Node? r = (b = new Node("second")).step();
        print("receiver done");
    }
    print("receiver gone");

    {
        Node? a = null;
        Node? s = (a = maybeMake("safe"))?.step();
        print("safe done");
    }
    print("safe gone");

    {
        Node[]? nodes = null;
        Node? e = (nodes = maybeNodes("element"))?[0];
        print("element " + (e?.label ?? "missing"));
    }
    print("element gone");

    {
        Node b = new Node("old");
        print(both(b, b = new Node("new")));
        print(both(b = new Node("left"), b = new Node("right")));
        print("arguments done");
    }
    print("arguments gone");

    {
        Node b = new Node("start");
        Node c = (b = new Node("shared"));
        print("declared " + c.label + " " + b.label);
    }
    print("declared gone");

    {
        let holder = new Holder(new Node("held"));
        print("checked " + holder.check(holder.node = new Node("field")));
        Node kept = new Node("watched");
        print("watching " + ((holder.watched = kept)?.label ?? "nothing"));
        print("watching " + ((holder.watched = new Node("brief"))?.label ?? "nothing"));
        print("fields done");
    }
    print("fields gone");

    {
        Cell cell = {node: new Node("cell")};
        print("cell " + (cell = {node: new Node("next")}).node.label);
        string text = "a";
        print("text " + (text += "b"));
    }
    print("values gone");

    {
        Cell first = {node: new Node("first cell")};
        print("cells " + cells(first, first = {node: new Node("second cell")}));
        Named name = new Named("old name");
        print("named " + (name == (name = new Named("new name"))).toString());
        Named? maybe = new Named("maybe");
        print("maybe " + (maybe == (maybe = new Named("maybe"))).toString());
        string text = "a" + 1.toString();
        print("text " + (text == (text = "b" + 1.toString())).toString());
        print("comparisons done");
    }
    print("comparisons gone");

    {
        Node shape = new Leaf("leaf");
        switch (shape) {
            is Leaf leaf -> {
                shape = new Node("after leaf");
                print("arm " + leaf.label);
            },
            default -> {
                print("never");
            },
        }
        let holder = new Holder(new Node("target"));
        holder.node.label = (holder.node = new Node("source")).label + " copy";
        print("written " + holder.node.label);
        print("places done");
    }
    print("places gone");

    {
        Node? slot = null;
        print("narrowed " + both(slot = new Node("narrowed"), slot));
    }
    print("narrowed gone");

    {
        Cell? cell = null;
        int? number = null;
        string label = labelOf(cell = {node: new Node("payload")});
        print("payload " + label + " " + counted(number = 4).toString());
    }
    print("payload gone");
    return 0;
}
