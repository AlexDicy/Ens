// @expect-error '++' cannot change 'c', because 'c' is declared 'const'. Remove 'const' from its declaration if it needs to change.
// A 'const' binding cannot be reassigned, and '++' would change it, so it is
// rejected just like a plain assignment to a constant.
main() -> int {
    const int c = 5;
    ++c;
    return 0;
}
