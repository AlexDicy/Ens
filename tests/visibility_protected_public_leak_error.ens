// @expect-error is protected, and 'Registry' is an open public class
// A protected member of an open public class is reachable by subclasses in
// every module of the package, so it may not mention a file-private type.
class Secret {
    protected constructor();
}

public class Registry {
    protected Secret entry;

    protected constructor(this.entry);
}

main() -> int {
    return 0;
}
