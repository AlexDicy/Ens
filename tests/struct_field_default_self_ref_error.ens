// One mistake, one error: a default that names its own field is explained once, and not also as an
// undefined name at the same position. Which fields a default may name is one rule with one message,
// so a default that breaks it is still typed against the field it named rather than left unresolved.
// @expect-error The default value of field 'x' cannot reference the field itself
// @expect-error build failed with 1 problem
struct Bad {
    int x = x + 1;
}

main() -> int {
    Bad b = {x: 1};
    return b.x;
}
