// @exit 0
// @stdout 4 137 366 [137, 80, 78, 71]
// @stdout equal true false
// @stdout slice [80, 78] 4
// @stdout key png
// @stdout packet {"name": "sig", "payload": [137, 80, 78, 71]} true
// @stdout shared 4 4
// @stdout absent 0
// @stdout members 1 true [80, 78, 71] [9, 80, 78, 71] [137, 80, 78, 71]
// @stdout named 3
// 'bytes' reads like a 'byte[]', compares and hashes by content, keys a map, and is held by a struct,
// a 'shared' class and a '<shared T>' parameter, while the name stays free for a local. Its members
// search it, and it copies to and from a 'byte[]'.
import Map from @std.collections.map;

struct Packet {
    string name;
    bytes payload;
}

shared final class Archive {
    const bytes contents;

    constructor(bytes contents) {
        this.contents = contents;
    }
}

kept<shared T>(T value) -> T {
    return value;
}

total(bytes data) -> long {
    long sum = 0;
    for (let value in data) {
        sum = sum + value;
    }
    return sum;
}

main() -> int {
    bytes signature = [0x89, 'P', 'N', 'G'];
    bytes same = [0x89, 'P', 'N', 'G'];
    bytes other = [0x89, 'P'];
    print("{signature.length} {signature[0]} {total(signature)} {signature}");
    print("equal {signature == same} {signature == other}");
    let middle = signature.slice(1, 3);
    print("slice {middle} {signature.length}");
    let formats = new Map<bytes, string>();
    formats.set(signature, "png");
    print("key {formats.get(same) ?? "missing"}");
    Packet packet = { name: "sig", payload: signature };
    Packet copy = { name: "sig", payload: same };
    print("packet {packet} {packet == copy}");
    let archive = new Archive(signature);
    print("shared {kept(archive).contents.length} {kept(signature).length}");
    bytes? absent = null;
    print("absent {absent?.length ?? 0}");
    byte[] array = signature.toArray();
    array[0] = 9;
    let found = signature.indexOf(signature.slice(1, 2));
    let ends = signature.endsWith(signature.slice(2));
    print("members {found} {ends} {signature.slice(1)} {bytes.of(array)} {signature}");
    long bytes = 3;
    print("named {bytes}");
    return 0;
}
