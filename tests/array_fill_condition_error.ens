// @expect-error An array of non-nullable 'Box' must be filled as it is created
// The loop condition must compare against the array's own length.
class Box {
    int v;
    Box(this.v);
}

main() -> int {
    Box[] boxes = new Box[2];
    for (long i = 0; i < 2; i = i + 1) {
        boxes[i] = new Box(1);
    }
    return 0;
}
