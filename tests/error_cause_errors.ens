// @expect-error Cannot override 'typeName': 'Error' declares it privately, so it is not inherited
// @expect-error build failed with 7 problems
// The base of every error is abstract, so a program says which failure it is raising. What an
// error carries is fixed when it is raised, and how it names its own type is the library's
// business rather than something a program branches on. The three members the compiler answers
// from the captured trace and the runtime type cannot be replaced, since a replacement would
// stand in for something no Ens body computes.
instantiateTheBase() -> Error {
    return new Error("nothing throws the base");
}

rewriteTheMessage(Error thrown) {
    thrown.message = "something else";
}

rewriteTheCause(Error thrown) {
    thrown.cause = null;
}

nameTheType(Error thrown) -> string {
    return thrown.typeName();
}

class ReplacesTheTrace extends Error {
    protected constructor(string message) {
        super(message);
    }

    protected override stackTrace() -> string {
        return "";
    }

    protected override stackFrames() -> StackFrame[] {
        return [];
    }

    override typeName() -> string {
        return "";
    }
}

main() -> int {
    return 0;
}
