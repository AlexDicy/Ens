// @expect-error '((int) -> int)[]' cannot be compared with '==': an array compares element by element, and its element type '(int) -> int' has no '=='
// @expect-error Struct 'Stepper' cannot be compared with '=='. Field 'steps' has type '((int) -> int)[]', which has no '=='
// @expect-error Cannot interpolate a value of type '((int) -> int)[]': its elements are function values, which have no text form. Interpolate names you keep beside the functions instead.
// @expect-error Struct 'Board' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'shapes' has type 'Shape[]', and a class value has no JSON form. Give 'Board' an 'override toString() -> string' of its own, or remove field 'shapes'.
// @expect-error Cannot interpolate a value of type 'Board[]': each struct element of an array is written as JSON, which lists each field's name and value. Field 'shapes' of 'Board' has type 'Shape[]', and a class value has no JSON form. Remove field 'shapes' from 'Board'.
// @expect-error Cannot interpolate a value of type 'Styled[]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Styled' declares its own 'toString'. Field 'shape' of 'Styled' has type 'Shape', and a class value has no JSON form. Interpolate the elements one at a time in a 'for' loop, as in 'for (let styled in cells) { ... }', or remove field 'shape' from 'Styled'.
// @expect-error Cannot interpolate a value of type 'Styled?[]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Styled' declares its own 'toString'. Field 'shape' of 'Styled' has type 'Shape', and a class value has no JSON form. Interpolate the elements one at a time in a 'for' loop, as in 'for (let styled in gaps) { ... }', or remove field 'shape' from 'Styled'.
// @expect-error Cannot interpolate a value of type 'Styled[][]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Styled' declares its own 'toString'. Field 'shape' of 'Styled' has type 'Shape', and a class value has no JSON form. Interpolate the elements one at a time in a 'for' loop, or remove field 'shape' from 'Styled'.
// @expect-error Cannot call 'toString' on a value of type '((int) -> int)[]': its elements are function values, which have no text form. Use names you keep beside the functions instead.
// @expect-error Cannot call 'toString' on a value of type 'Styled[]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Styled' declares its own 'toString'. Field 'shape' of 'Styled' has type 'Shape', and a class value has no JSON form. Call 'toString' on the elements one at a time in a 'for' loop, as in 'for (let styled in cells) { ... }', or remove field 'shape' from 'Styled'.
// @expect-error 'toString' takes no arguments, but this call passes one. Remove the extra argument.
// @expect-error build failed with 11 problems
// What content semantics refuse. A class element keeps an array out of struct serialization even
// though the array alone would interpolate.
public class Shape {
    protected constructor();
}

public struct Stepper {
    public ((int) -> int)[] steps;
}

public struct Board {
    public string name;
    public Shape[] shapes;
}

takesFunctions(((int) -> int)[] left, ((int) -> int)[] right) -> bool {
    return left == right;
}

compareSteppers(Stepper left, Stepper right) -> bool {
    return left == right;
}

describeFunctions(((int) -> int)[] steps) {
    print("{steps}");
    print(steps.toString());
}

describeBoard(Board board) {
    print("{board}");
}

describeBoards(Board[] boards) {
    print("{boards}");
}

// A struct element renders as its JSON object even when it declares 'toString', so a struct with
// no JSON form is refused as an element.
public struct Styled {
    public Shape shape;

    public override toString() -> string {
        return "styled";
    }
}

describeStyled(Styled[] cells, Styled?[] gaps, Styled[][] rows) {
    print("{cells}");
    print("{gaps}");
    print("{rows}");
    print(cells.toString());
    print(cells[0].toString(1));
}

main() -> int {
    return 0;
}
