// @expect-error '((int) -> int)[]' cannot be compared with '==': an array compares element by element, and its element type '(int) -> int' has no '=='
// @expect-error Struct 'Stepper' cannot be compared with '=='. Field 'steps' has type '((int) -> int)[]', which has no '=='
// @expect-error Cannot interpolate a value of type 'Styled[][]': each struct element of an array is written as JSON, which lists each field's name and value, even though 'Styled' declares its own 'toString'. Field 'shape' of 'Styled' has the class type 'Shape', and a class value has no JSON form. Interpolate the elements one at a time in a 'for' loop, or remove field 'shape' from 'Styled'.
// @expect-error build failed with 3 problems
// What content semantics refuse.
public class Shape {
    protected constructor();
}

public struct Stepper {
    public ((int) -> int)[] steps;
}

takesFunctions(((int) -> int)[] left, ((int) -> int)[] right) -> bool {
    return left == right;
}

compareSteppers(Stepper left, Stepper right) -> bool {
    return left == right;
}

// A struct element renders as its JSON object even when it declares 'toString', so a struct with
// no JSON form is refused as an element.
public struct Styled {
    public Shape shape;

    public override toString() -> string {
        return "styled";
    }
}

describeStyled(Styled[][] rows) {
    print("{rows}");
}

main() -> int {
    return 0;
}
