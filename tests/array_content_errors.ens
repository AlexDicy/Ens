// @expect-error '((int) -> int)[]' cannot be compared with '==': an array compares element by element, and its element type '(int) -> int' has no '=='
// @expect-error Struct 'Stepper' cannot be compared with '=='. Field 'steps' has type '((int) -> int)[]', which has no '=='
// @expect-error Cannot interpolate a value of type '((int) -> int)[]': its elements are function values, which have no text form.
// @expect-error Struct 'Board' cannot be converted to a string. Field 'shapes' has type 'Shape', which has no string form
// @expect-error Struct 'Styled' cannot be converted to a string. Field 'shape' has type 'Shape', which has no string form
// @expect-error build failed with 5 problems
// What content semantics refuse. A class element keeps an array out of struct serialization even
// though the array alone would interpolate.
public class Shape {
    protected constructor();
}

public struct Stepper {
    public ((int) -> int)[] steps;
}

public struct Board {
    public string name;
    public Shape[] shapes;
}

takesFunctions(((int) -> int)[] left, ((int) -> int)[] right) -> bool {
    return left == right;
}

compareSteppers(Stepper left, Stepper right) -> bool {
    return left == right;
}

describeFunctions(((int) -> int)[] steps) {
    print("{steps}");
}

describeBoard(Board board) {
    print("{board}");
}

// A struct element renders as its JSON object even when it declares 'toString', so a struct with
// no JSON form is refused as an element.
public struct Styled {
    public Shape shape;

    public override toString() -> string {
        return "styled";
    }
}

describeStyled(Styled[] cells) {
    print("{cells}");
}

main() -> int {
    return 0;
}
