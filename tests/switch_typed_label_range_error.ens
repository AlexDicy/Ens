// @expect-error Literal 5000000000L is too large for 'int', whose largest value is 2147483647.
// A label's value must fit the scrutinee's type. 5000000000L is a valid long
// literal, but it is out of range for an 'int' switch, so it is rejected by value.
kind(int n) -> int {
    return switch (n) {
        5000000000L -> 1,
        default -> 0,
    };
}

main() -> int {
    return kind(0);
}
