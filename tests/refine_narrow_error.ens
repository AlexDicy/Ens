// @expect-error Cannot read a member of 'Door?'
// The boundaries of straight-line refinement: a nullable value never narrows,
// a write through a member path never refines, an assignment in one branch of
// an 'if' does not narrow after it, and a declared non-nullable binding still
// rejects presence operators.
class Door {
    int code;
    constructor(this.code = 0);
}

class Room {
    Door? door;
    constructor(this.door = null);
}

maybeInt() -> int? {
    return 3;
}

makeDoor() -> Door {
    return new Door(7);
}

// A nullable right-hand side does not narrow the target.
nullableRhs() -> int {
    int? n = maybeInt();
    return n;                   // error: 'int?' is not 'int'
}

// Writing through a member path does not refine that field.
memberWrite() -> int {
    let r = new Room();
    r.door = makeDoor();
    return r.door.code;         // error: r.door is still 'Door?'
}

// Assigning in one branch of an 'if' does not narrow after the 'if'.
branchJoin() -> int {
    int? x = maybeInt();
    if (x == null) {
        x = 5;
    }
    return x;                   // error: no flow join, x is still 'int?'
}

// A declared non-nullable binding still rejects presence operators.
nonNullablePresence() -> int {
    int y = 5;
    return y ?? 3;              // error: 'int' is not a nullable value
}

main() -> int {
    return nullableRhs() + memberWrite() + branchJoin() + nonNullablePresence();
}
