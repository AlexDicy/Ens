// The boundaries of straight-line refinement. A value that may itself be null narrows nothing.
// @expect-error Function 'nullableRhs' returns 'int', but this value has type 'int?'. The value may be null here. Check 'n' for null first ('if (n != null)').
// @expect-error build failed with 1 problem
maybeInt() -> int? {
    return 3;
}

// A nullable right-hand side does not narrow the target.
nullableRhs() -> int {
    int? n = maybeInt();
    return n;                   // error: 'int?' is not 'int'
}

main() -> int {
    return nullableRhs();
}
