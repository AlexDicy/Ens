// The boundaries of straight-line refinement. A value that may itself be null narrows nothing,
// and a declared non-nullable binding still rejects presence operators.
// @expect-error Cannot return value of type 'int?' from function returning 'int'. The value may be null here; check it first ('if (value != null)'), or supply a fallback with '??'.
// @expect-error Left of '??' must be a nullable value, got 'int', which can never be null. Remove the '??', or make the left side nullable.
// @expect-error build failed with 2 problems
maybeInt() -> int? {
    return 3;
}

// A nullable right-hand side does not narrow the target.
nullableRhs() -> int {
    int? n = maybeInt();
    return n;                   // error: 'int?' is not 'int'
}

// A declared non-nullable binding still rejects presence operators.
nonNullablePresence() -> int {
    int y = 5;
    return y ?? 3;              // error: 'int' is not a nullable value
}

main() -> int {
    return nullableRhs() + nonNullablePresence();
}
