// @expect-error 'this.level' is a 'byte', whose largest value is 255, so it is never equal to 300. Declare field 'level' of 'Gauge' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is never equal to 300. Declare 'small' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is always different from 300. Declare 'small' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is always less than 300. Declare 'small' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'count' is a 'uint', whose smallest value is 0, so it is never equal to -1. Declare 'count' as a signed type, such as 'long', if it should hold that value.
// @expect-error 'offset' is a 'short', whose smallest value is -32768, so it is always greater than -40000. Declare 'offset' as a wider type, such as 'int', if it should hold that value.
// @expect-error 'gauge.level' is a 'byte', whose largest value is 255, so it is always less than 256. Declare field 'level' of 'Gauge' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'gauge.level + 1' is a 'byte', whose largest value is 255, so it is never equal to 300.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is never equal to '€', whose code point, its number in Unicode, is 8364. If 'small' should hold characters, declare it as 'char'.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is always different from '€', whose code point, its number in Unicode, is 8364. If 'small' should hold characters, declare it as 'char'.
// @expect-error Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38. The literal takes its type from 'ratio', a 'float'. Declare 'ratio' as 'double' if it should hold that value.
// @expect-error 'ratio' is a 'float', whose smallest value is about -3.402e38, so it is never equal to -3.5e38. Declare 'ratio' as 'double' if it should hold that value.
// @expect-error 'ratio' is a 'float', whose largest value is about 3.402e38, so it is always different from 1e39. Declare 'ratio' as 'double' if it should hold that value.
// @expect-error Literal -9223372036854775809 is below the smallest value of 'long', which is -9223372036854775808.
// @expect-error build failed with 15 problems
// Comparing a value with a literal its type cannot hold is refused with the outcome, an integer
// literal and a char literal alike, and the fix widens the variable or the field rather than
// converting it, since converting a value does not change it. A 'float' ordering has no single
// outcome, since the value may be an infinity, so it states the range, and a literal past every
// integer type keeps the refusal that says so.
class Gauge {
    byte level = 0;

    full() -> bool {
        return this.level == 300;
    }
}

compare(byte small, uint count, short offset, float ratio, Gauge gauge) -> int {
    int matches = 0;
    if (small == 300) {
        matches++;
    }
    if (small != 300) {
        matches++;
    }
    if (small <= 300) {
        matches++;
    }
    if (300 > small) {
        matches++;
    }
    if (count == -1) {
        matches++;
    }
    if (offset < -40000) {
        matches++;
    }
    if (gauge.level >= 256) {
        matches++;
    }
    if (gauge.level + 1 == 300) {
        matches++;
    }
    if (small == '€') {
        matches++;
    }
    if ('€' != small) {
        matches++;
    }
    if (ratio > 3.5e38) {
        matches++;
    }
    if (ratio == -3.5e38) {
        matches++;
    }
    if (ratio != 1e39) {
        matches++;
    }
    long wide = 0;
    if (wide < -9223372036854775809) {
        matches++;
    }
    if (small < 255 && small == 'a' && ratio < 3.4e38) {
        matches++;
    }
    return matches;
}

main() -> int {
    return compare(1, 1, 1, 1.0, new Gauge());
}
