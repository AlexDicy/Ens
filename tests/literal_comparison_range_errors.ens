// @expect-error 'count' is a 'uint', whose smallest value is 0, so it is never equal to -1. Declare 'count' as a signed type, such as 'long', if it should hold that value.
// @expect-error 'offset' is a 'short', whose smallest value is -32768, so it is always greater than -40000. Declare 'offset' as a wider type, such as 'int', if it should hold that value.
// @expect-error 'gauge.level' is a 'byte', whose largest value is 255, so it is always less than 256. Declare field 'level' of 'Gauge' as a wider type, such as 'ushort', if it should hold that value.
// @expect-error 'small' is a 'byte', whose largest value is 255, so it is always different from '€', whose code point, its number in Unicode, is 8364. If 'small' should hold characters, declare it as 'char'.
// @expect-error 'ratio' is a 'float', whose smallest value is about -3.402e38, so it is never equal to -3.5e38. Declare 'ratio' as 'double' if it should hold that value.
// @expect-error 'ratio' is a 'float', whose largest value is about 3.402e38, so it is always different from 1e39. Declare 'ratio' as 'double' if it should hold that value.
// @expect-error 'gauge.level' is a 'byte', whose values are all whole numbers, so it is never equal to 2.5. Declare field 'level' of 'Gauge' as 'double' if it should hold that value, or compare with a whole number.
// @expect-error 'gauge.level + 1' is a 'byte', whose values are all whole numbers, so it is never equal to 2.5.
// @expect-error 'small' is a 'byte', whose smallest value is 0, so it is never equal to -(300). Declare 'small' as a signed type, such as 'short', if it should hold that value.
// @expect-error build failed with 11 problems
// Comparing a value with a literal its type cannot hold is refused with the outcome, an integer
// literal and a char literal alike, and the fix widens the variable or the field rather than
// converting it, since converting a value does not change it. A floating-point literal an integer
// value can never equal, past the range or with a fraction, is refused the same way, and an
// ordering only when the range decides its outcome.
class Gauge {
    byte level = 0;
}

compare(byte small, uint count, short offset, float ratio, int signed, Gauge gauge) -> int {
    int matches = 0;
    if (small <= 300) {
        matches++;
    }
    if (300 > small) {
        matches++;
    }
    if (count == -1) {
        matches++;
    }
    if (offset < -40000) {
        matches++;
    }
    if (gauge.level >= 256) {
        matches++;
    }
    if ('€' != small) {
        matches++;
    }
    if (ratio == -3.5e38) {
        matches++;
    }
    if (ratio != 1e39) {
        matches++;
    }
    if (gauge.level == 2.5) {
        matches++;
    }
    if (gauge.level + 1 == 2.5) {
        matches++;
    }
    if (small == -(300)) {
        matches++;
    }
    if (small < 1.5f || small == 2.0f || offset == 2.0d) {
        matches++;
    }
    if (small < 1.5 || small == 2.0 || count == 4294967295.0 || signed > -2147483648.0) {
        matches++;
    }
    if (small < 255 && small == 'a' && ratio < 3.4e38) {
        matches++;
    }
    return matches;
}

main() -> int {
    return compare(1, 1, 1, 1.0, 1, new Gauge());
}
