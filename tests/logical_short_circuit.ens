// @exit 42
class Counter {
    int n;
    constructor(this.n = 0);
    bump() -> bool {
        this.n = this.n + 1;
        return true;
    }
}

main() -> int {
    Counter c = new Counter();

    if (false && c.bump()) {
        return 1;
    }
    if (true || c.bump()) {
        c.n = c.n + 0;
    }
    if (c.n != 0) {
        return 2;
    }

    if (true && c.bump()) {
        c.n = c.n + 0;
    }
    if (false || c.bump()) {
        c.n = c.n + 0;
    }
    if (c.n != 2) {
        return 3;
    }

    return 42;
}