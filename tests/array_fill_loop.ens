// @exit 0
// @stdout sources 6
// @stdout names n0-n1
// @stdout table 4
// @stdout empty 0
// @stdout incr 24
// @stdout elements alive
// @stdout elements released
// @stdout partial released
// @stdout throw unwound

// A `new T[n]` with a non-nullable element type is legal when the declaration
// is immediately followed by the canonical fill loop. The loop writes every
// slot before any read, so no null is ever observed.
import List from @std.list;

class Node {
    int v;
    Node(this.v);
}

class Watcher {
    weak Node? first;
    weak Node? last;
}

class Builder {
    Watcher watch;

    Builder(this.watch);

    make(long index) -> Node throws {
        if (index == 2) {
            throw new Error("boom");
        }
        let node = new Node(index as int);
        this.watch.first = node;
        return node;
    }

    partialFill() -> long throws {
        Node[] nodes = new Node[4];
        for (long i = 0; i < nodes.length; i = i + 1) {
            nodes[i] = try this.make(i);
        }
        return nodes.length;
    }

    attempt() -> long {
        return try this.partialFill();
    } catch (Error e) {
        // The two slots written before the throw die with the frame's array:
        // no leak, no double free, observed through the weak watcher.
        if (this.watch.first == null) {
            print("partial released");
        }
        return -1;
    }
}

buildAndWatch(Watcher watcher) -> int {
    Node[] nodes = new Node[3];
    for (long i = 0; i < nodes.length; i = i + 1) {
        nodes[i] = new Node(i as int);
    }
    watcher.first = nodes[0];
    watcher.last = nodes[2];
    if (watcher.first != null && watcher.last != null) {
        print("elements alive");
    }
    return nodes[0].v + nodes[2].v;
}

main() -> int {
    // Fill from a List source, sized by the list itself.
    let source = new List<Node>();
    source.push(new Node(1));
    source.push(new Node(2));
    source.push(new Node(3));
    Node[] nodes = new Node[source.length()];
    for (long i = 0; i < nodes.length; i = i + 1) {
        nodes[i] = source.get(i);
    }
    print("sources " + (nodes[0].v + nodes[1].v + nodes[2].v));

    // Strings are non-nullable reference elements too; an int index works.
    string[] names = new string[2];
    for (int k = 0; k < names.length; k = k + 1) {
        names[k] = "n" + k;
    }
    print("names " + names[0] + "-" + names[1]);

    // Array-of-arrays element type, spelled `new string[][n]`.
    string[][] table = new string[][2];
    for (long row = 0; row < table.length; row = row + 1) {
        table[row] = names;
    }
    print("table " + (table[0].length + table[1].length));

    // A zero-length allocation is vacuously filled.
    Node[] none = new Node[0];
    for (long i = 0; i < none.length; i = i + 1) {
        none[i] = new Node(99);
    }
    print("empty " + none.length);

    // The fill loop's update may be written `i++` or `++i` too.
    Node[] incr = new Node[2];
    for (long i = 0; i < incr.length; i++) {
        incr[i] = new Node((i + 1) as int);
    }
    Node[] preIncr = new Node[2];
    for (long p = 0; p < preIncr.length; ++p) {
        preIncr[p] = new Node((p + 10) as int);
    }
    print("incr " + (incr[0].v + incr[1].v + preIncr[0].v + preIncr[1].v));

    let watcher = new Watcher();
    let total = buildAndWatch(watcher);
    if (total == 2 && watcher.first == null && watcher.last == null) {
        print("elements released");
    }

    let builder = new Builder(watcher);
    if (builder.attempt() == -1) {
        print("throw unwound");
    }
    return 0;
}
