// @exit 0
// @stdout declared 112 7 1.5 3 2 3000000000
// @stdout changed 15 2.5 200 25000 5
// @stdout fallback 9 1
// @stdout typed fallback 0 5
// @stdout parenthesized 3 4.5
// An untyped literal takes the type of a nullable target without its '?'. A target that cannot be
// null gives a literal its type the same way. This works for a declaration, an assignment, a
// compound assignment, an argument and a return value. It works for both arms of '?:' and of a
// switch, inside parentheses, and for the fallback on the right of '??'. An empty array literal
// and a lambda on the right of '??' take their types from the left side the same way. A literal in
// parentheses adapts like the literal alone.

halve(float? value) -> float {
    return (value ?? 0) / 2;
}

ceiling() -> byte? {
    return 200;
}

pick(bool first) -> short? {
    return first ? 25000 : 5;
}

main() -> int {
    byte? small = 1;
    byte? wrapped = (2);
    float? ratio = 1.5;
    float? whole = 3;
    double? wide = 2;
    long? big = 3000000000;
    ulong? mask = 12;
    if (small != null) {
        small += (1);
        small += small > 1 ? 10 : 20;
        small += switch (small) {
            12 -> 100,
            default -> 1,
        };
    }
    if (mask != null) {
        mask |= (3);
    }
    wrapped = 7;
    byte? missing = null;
    byte fallback = missing ?? (9);
    byte picked = missing ?? (wrapped == 7 ? 1 : 2);
    print("declared {small ?? 0} {wrapped ?? 0} {ratio ?? 0} {whole ?? 0} {wide ?? 0} {big ?? 0}");
    print("changed {mask ?? 0} {halve(5)} {ceiling() ?? 0} {pick(true) ?? 0} {pick(false) ?? 0}");
    print("fallback {fallback} {picked}");
    int[]? noItems = null;
    int[] items = noItems ?? [];
    ((int) -> int)? noStep = null;
    (int) -> int step = noStep ?? (x) -> x + 1;
    print("typed fallback {items.length} {step(4)}");
    byte one = 1;
    byte sum = one + (2);
    float half = 1.5f;
    float scaled = half * (3.0);
    print("parenthesized {sum} {scaled}");
    return 0;
}
