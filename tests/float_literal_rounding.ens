// @exit 0
// @stdout named 23 checked 0 differ
// @stdout powers 631 checked 0 differ
// @stdout largest same true accepted true
// @stdout past largest refused true
// @stdout negative zero -0 -0 true
// A literal and the same text read at run time name one value, because the compiler folds a literal
// through the library's own conversion. Both round once, to the nearest double, so a value halfway
// between two doubles goes to the even one and a magnitude past the range reads as an infinity.
// Every power of ten is checked in both directions, since scaling one step at a time used to drift
// by a unit in the last place from about 1e45 up and 1e-23 down.
import @std.text.parse;

class Tally {
    protected long checked;
    protected long differing;

    protected constructor() {
        this.checked = 0;
        this.differing = 0;
    }

    protected check(string text, double written) {
        this.checked = this.checked + 1;
        if (written != parse.nearestDouble(text)) {
            this.differing = this.differing + 1;
        }
    }

    protected report(string label) {
        print("{label} {this.checked} checked {this.differing} differ");
    }
}

main() -> int {
    let named = new Tally();
    // The exact decimal of the float nearest a tenth, which is longer than a double's own digits.
    named.check("0.100000001490116119384765625", 0.100000001490116119384765625);
    // Exactly halfway between two doubles, which goes to the even one.
    named.check("9007199254740993.0", 9007199254740993.0);
    named.check("32346409610841.197265625", 32346409610841.197265625);
    named.check("1e300", 1e300);
    named.check("1e23", 1e23);
    named.check("1.602176634e-19", 1.602176634e-19);
    named.check("6.62607015e-34", 6.62607015e-34);
    named.check("6.02214076e23", 6.02214076e23);
    named.check("3.141592653589793", 3.141592653589793);
    named.check("0.1", 0.1);
    named.check("2.5", 2.5);
    named.check("0.3000000000000000444089209850062616169452667236328125",
        0.3000000000000000444089209850062616169452667236328125);
    named.check("123456789012345678901234567890.0", 123456789012345678901234567890.0);
    named.check("1.0000000000000000555111512312578", 1.0000000000000000555111512312578);
    // The smallest subnormal and the two values that round onto and past it.
    named.check("5e-324", 5e-324);
    named.check("4.9406564584124654e-324", 4.9406564584124654e-324);
    named.check("2.4703282292062327e-324", 2.4703282292062327e-324);
    named.check("2.4703282292062328e-324", 2.4703282292062328e-324);
    named.check("1e-330", 1e-330);
    // The smallest normal and the band just under it.
    named.check("2.2250738585072014e-308", 2.2250738585072014e-308);
    named.check("2.2250738585072011e-308", 2.2250738585072011e-308);
    // The largest value the type holds, which the library's own range constant is written with.
    named.check("1.7976931348623157e308", 1.7976931348623157e308);
    named.check("0.0", 0.0);
    named.report("named");

    let powers = new Tally();
    powers.check("1e1", 1e1);
    powers.check("1e2", 1e2);
    powers.check("1e3", 1e3);
