    powers.report("powers");

    double largest = 1.7976931348623157e308;
    let parsedLargest = parse.parseDouble("1.7976931348623157e308");
    print("largest same {largest == parse.nearestDouble("1.7976931348623157e308")} "
        + "accepted {parsedLargest != null}");
    let pastLargest = parse.parseDouble("1.8e308");
    print("past largest refused {pastLargest == null}");

    // A negative zero is equal to zero, so only its text or a division through it shows the sign.
    double negativeZero = -0.0;
    double parsedNegativeZero = parse.nearestDouble("-0.0");
    print("negative zero {negativeZero} {parsedNegativeZero} "
        + "{1.0 / parsedNegativeZero < 0.0}");
    return 0;
}
