// @exit 51
// `type` is an ordinary identifier for variables, parameters, fields, methods,
// functions, and loop variables. It carries keyword meaning only after `external`,
// where `external type Name;` declares an opaque type; that still parses here.

external type Handle;

class Box {
    int type;

    constructor(int type) {
        this.type = type;
    }

    peek() -> int {
        return this.type;
    }
}

class Reader {
    int position;

    constructor() {
        this.position = 3;
    }

    type() -> int {
        return this.position;
    }
}

type(int type) -> int {
    return type + 1;
}

sumRange(int limit) -> int {
    int total = 0;
    for (int type = 0; type < limit; type++) {
        total = total + type;
    }
    int[] values = [10, 20];
    for (let type in values) {
        total = total + type;
    }
    return total;
}

isNull(Handle? handle) -> bool {
    return handle == null;
}

main() -> int {
    Handle? handle = null;
    if (!isNull(handle)) {
        return 99;
    }
    let box = new Box(5);
    int field = box.peek();
    let reader = new Reader();
    int method = reader.type();
    int called = type(6);
    int looped = sumRange(4);
    int type = field + method;
    return type + called + looped;
}
