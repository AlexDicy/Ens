// @exit 0
// @stdout entered 1
// @stdout back 1
// @stdout entered 2
// @stdout back 2
// @stdout ended 2
// @stdout reused 3
// @stdout deep 20000
// @stdout released
// The context bridges the compiler defines: a context with a stack of its own runs a body and
// switches back to the context that resumed it, the body's end switches back as well, the same
// stack then runs a second body, a third recurses deeply on it, and the context is released with
// its stack.
import Atomic from @std.tasks;

shared external type Context;

external from libc {
    ens_context_adopt() -> Context?;
    ens_context_create(long stackBytes, out int error) -> Context?;
    ens_context_set_body(Context context, (shared () -> void) body);
    ens_context_switch(Context from, Context to);
    ens_context_release(Context context);
}

deepen(long left, Atomic<long> depth) {
    if (left == 0) {
        print("deep {depth.read()}");
        return;
    }
    let entered = depth.increment();
    deepen(left - 1, depth);
    let exited = depth.decrement();
}

main() -> int {
    let home = ens_context_adopt();
    int error = 0;
    let worker = ens_context_create(8388608, out error);
    if (home == null || worker == null) {
        print("no context: error {error}");
        return 1;
    }
    let step = new Atomic<long>(0);
    ens_context_set_body(worker, () -> {
        for (long i = 1; i <= 2; i++) {
            print("entered {i}");
            let seen = step.increment();
            ens_context_switch(worker, home);
        }
    });
    ens_context_switch(home, worker);
    print("back {step.read()}");
    ens_context_switch(home, worker);
    print("back {step.read()}");
    ens_context_switch(home, worker);
    print("ended {step.read()}");
    ens_context_set_body(worker, () -> {
        print("reused {step.read() + 1}");
    });
    ens_context_switch(home, worker);
    let depth = new Atomic<long>(0);
    ens_context_set_body(worker, () -> deepen(20000, depth));
    ens_context_switch(home, worker);
    ens_context_release(worker);
    ens_context_release(home);
    print("released");
    return 0;
}
