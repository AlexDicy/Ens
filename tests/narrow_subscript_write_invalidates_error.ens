// @expect-error Cannot read a member of 'Box?'
// Writing 'xs[0]' drops the narrowing of 'xs[0]' itself.
class Box {
    int v;
    protected constructor(this.v = 0);
}

main() -> int {
    Box?[] xs = [new Box(1)];
    if (xs[0] != null) {
        xs[0] = null;
        return xs[0].v;
    }
    return 0;
}
