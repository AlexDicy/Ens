// @expect-error 'class' is a keyword and cannot be used as a method name
// One diagnostic, and the rest of the class still parses.
class Node {
    int value;

    protected constructor(this.value = 0);

    class() -> string {
        return "node";
    }

    protected other() -> int {
        return 1;
    }
}

main() -> int {
    let n = new Node(1);
    return n.other();
}
