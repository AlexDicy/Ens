// A '?:' and a switch expression each produce one value, so their branches answer to the type the
// whole expression flows into: an array literal and an aggregate literal take theirs from there,
// exactly as they would in the slot itself.
// @exit 100
// @stdout 3 4
// @stdout 5 6
// @stdout 3 4

struct Point {
    int x;
    int y;
}

main() -> int {
    bool first = true;
    Point corner = first ? {x: 3, y: 4} : {x: 5, y: 6};
    print("{corner.x} {corner.y}");

    int mode = 2;
    Point picked = switch (mode) {
        1 -> {x: 3, y: 4},
        default -> {x: 5, y: 6},
    };
    print("{picked.x} {picked.y}");

    int[] chosen = switch (mode) {
        1 -> [1, 2],
        default -> [3, 4],
    };
    print("{chosen[0]} {chosen[1]}");

    int x = 7;
    return x > 5 ? 100 : 200;
}
