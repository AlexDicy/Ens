// @exit 0
// @stdout body 3
// @stdout after 3
// @stdout partial 3
// @stdout deep 3
// @stdout condition 0
// @stdout negated 0
// An `else if` is reached only when the preceding condition failed, so the negation
// narrows there exactly as it does in a plain `else` block: inside the chained
// condition and body, and after the whole chain when every other path terminates.
lookup(bool found) -> string? {
    if (found) {
        return "abc";
    }
    return null;
}

// The narrowing reaches the body of the `else if`.
inBody(bool found) -> long {
    let value = lookup(found);
    if (value == null) {
        return 0;
    } else if (found) {
        return value.length;
    }
    return -1;
}

// It also survives past the whole chain, because both other paths return.
afterChain(bool found) -> long {
    let value = lookup(found);
    if (value == null) {
        return 0;
    } else if (!found) {
        return -1;
    }
    return value.length;
}

// A chained body that falls through still sees the narrowing inside itself.
inFallThroughBody(bool found) -> long {
    let value = lookup(found);
    long length = -1;
    if (value == null) {
        return 0;
    } else if (found) {
        length = value.length;
    }
    return length;
}

// The negation carries through every level of a longer chain.
deepChain(bool found, bool other) -> long {
    let value = lookup(found);
    if (value == null) {
        return 0;
    } else if (other) {
        return -1;
    } else if (found) {
        return value.length;
    }
    return -2;
}

// A chained condition may itself be the narrowing check.
inChainedCondition(bool found) -> long {
    let value = lookup(found);
    if (found) {
        return -1;
    } else if (value != null) {
        return value.length;
    }
    return 0;
}

// Negating a chained check narrows after the chain.
afterChainedCheck(bool found) -> long {
    let value = lookup(found);
    if (found) {
        return 0;
    } else if (value == null) {
        return 0;
    }
    return value.length;
}

main() -> int {
    print("body {inBody(true)}");
    print("after {afterChain(true)}");
    print("partial {inFallThroughBody(true)}");
    print("deep {deepChain(true, false)}");
    print("condition {inChainedCondition(false)}");
    print("negated {afterChainedCheck(false)}");
    return 0;
}
