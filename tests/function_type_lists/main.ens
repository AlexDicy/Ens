// @stdlib ../function_type_lists_stdlib
// @exit 149
// A class the standard library writes with the function type it runs is written that way where it
// is used: 'Probe<() -> int>' runs a function that throws nothing, so 'run' needs no 'try', and a
// lambda given where such a type is expected is held to the list the type names. A local holding a
// call's value takes its list from the lambda's body, or from the first type the local is given to.
import Probe from @std.tasks;
import @std.tasks;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

class Holder {
    Probe<() -> int>? kept;

    constructor();
}

total(Probe<() -> int> given) -> int {
    return given.run();
}

attempt(Probe<(() -> int throws Broken)> failing) -> int {
    return try failing.run();
} catch (Broken broken) {
    return 1;
}

main() -> int {
    Probe<() -> int> quiet = tasks.probing(() -> 42);
    int typed = quiet.run() + attempt(tasks.probing(() -> {
        throw new Broken();
        return 0;
    }));
    let inferred = tasks.probing(() -> 50);
    let passed = tasks.probing(() -> 30);
    let holder = new Holder();
    let stored = tasks.probing(() -> 20);
    holder.kept = stored;
    let failing = tasks.probing(() -> {
        throw new Broken();
        return 0;
    });
    int local = inferred.run() + total(passed) + (holder.kept?.run() ?? 0) + attempt(failing);
    return typed + local + 5;
}
