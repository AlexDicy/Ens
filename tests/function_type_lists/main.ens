// @stdlib ../function_type_lists_stdlib
// @exit 43
// A class the standard library writes with the function type it runs is written that way where it
// is used: 'Probe<() -> int>' runs a function that throws nothing, so 'run' needs no 'try', and a
// lambda given where such a type is expected is held to the list the type names.
import Probe from @std.tasks;
import @std.tasks;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

attempt(Probe<(() -> int throws Broken)> failing) -> int {
    return try failing.run();
} catch (Broken broken) {
    return 1;
}

main() -> int {
    Probe<() -> int> quiet = tasks.probing(() -> 42);
    return quiet.run() + attempt(tasks.probing(() -> {
        throw new Broken();
        return 0;
    }));
}
