// @exit 0
// @stdout direct 5
// @stdout virtual 5
// @stdout virtual-string hi
// @stdout struct-return 3 4
// @stdout base-field 9 5
// @stdout two-instances 5 hi

abstract class Box<T> {
    abstract get() -> T;
}

class IntBox<T> extends Box<T> {
    private T stored;
    IntBox(this.stored);
    override get() -> T { return this.stored; }
}

struct P<A, B> {
    A first;
    B second;
}

class PairBox<A, B> extends Box<P<A, B>> {
    private A firstStored;
    private B secondStored;
    PairBox(this.firstStored, this.secondStored);
    override get() -> P<A, B> {
        P<A, B> result;
        result.first = this.firstStored;
        result.second = this.secondStored;
        return result;
    }
}

class Counter<T> extends Box<T> {
    int uses;
    private T stored;
    Counter(this.stored) { this.uses = 9; }
    override get() -> T { return this.stored; }
}

readThroughBase(Box<int> box) -> int {
    return box.get();
}

main() -> int {
    let direct = new IntBox<int>(5);
    print("direct " + direct.get());

    Box<int> asBase = new IntBox<int>(5);
    print("virtual " + asBase.get());

    Box<string> asBaseString = new IntBox<string>("hi");
    print("virtual-string " + asBaseString.get());

    Box<P<int, int>> pairBase = new PairBox<int, int>(3, 4);
    P<int, int> pair = pairBase.get();
    print("struct-return " + pair.first + " " + pair.second);

    let counted = new Counter<int>(5);
    print("base-field " + counted.uses + " " + readThroughBase(counted));

    print("two-instances " + readThroughBase(new IntBox<int>(5)) + " " + asBaseString.get());
    return 0;
}
