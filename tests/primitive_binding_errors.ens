// @stdlib primitive_stdlib
// Every way a primitive binding is refused, plus what a declared conformance does not buy: it
// satisfies a generic bound and gives the primitive no interface value, so a slot, a '??'
// fallback, an 'is' test and an 'as?' cast all stay errors.
// @expect-error 'Widget' is not a primitive type, so it cannot carry a primitive binding. A binding names one of 'bool', 'byte', 'short', 'ushort', 'int', 'uint', 'long', 'ulong', 'float', 'double', 'char' and 'string'. Declare the members of 'Widget' in 'Widget' itself.
// @expect-error 'void' cannot carry a primitive binding: 'void' is the absence of a value, so there is nothing for a member to run on.
// @expect-error 'decimal' cannot carry a primitive binding: 'decimal' is reserved for a decimal type the language does not have yet, so there is nothing to declare members on.
// @expect-error 'char' can only implement an interface, and 'Widget' is not one. A binding never extends a class.
// @expect-error The binding for 'int' implements 'Refused' but does not provide 'wanted() -> long'. Declare the method here, or stop implementing 'Refused'.
// @expect-error Method 'unrelated' of the 'int' binding is marked 'override' but no interface it implements declares it. Remove 'override'.
// @expect-error Method 'wanted' of the 'ushort' binding implements a method declared in interface 'Refused'; mark it 'override'.
// @expect-error Method 'length' of the 'string' binding cannot be declared: 'string.length' is the byte count, read without parentheses, so a method named 'length' could never be called. Choose another name.
// @expect-error Method 'toString' of the 'string' binding cannot be declared: the text form of a value of type 'string' is what interpolation reads too, so a binding cannot replace it. Declare an overload that takes arguments instead, such as 'toString(int radix)'.
// @expect-error A binding for 'string' cannot declare a field: 'count' would need room in every value of type 'string', and a primitive has none. Declare methods here, and keep the field on a class or a struct that holds one.
// @expect-error A binding for 'string' cannot declare a static const; it declares only what a value of type 'string' can do. Declare 'limit' on a class or a struct of this module instead.
// @expect-error A binding for 'string' cannot declare a constructor; a value of type 'string' is written as a literal, never built with 'new'. Declare a static that returns one instead.
// @expect-error A binding for 'string' cannot declare a destructor; a value of type 'string' is copied, never destroyed.
// @expect-error Method 'missing' of the 'string' binding cannot be 'abstract'; a primitive has no subclass to give it a body.
// @expect-error Method 'bodiless' of the 'string' binding has no body, and 'bodiless() -> long' is not a member the compiler implements. The ones it does are 'byteAt(long) -> byte', 'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string', and 'static fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'bodiless' a body to write it in Ens.
// @expect-error Method 'byteAt' of the 'string' binding has no body, and 'byteAt(long) -> long' is not a member the compiler implements.
// @expect-error Method 'fixed' of the 'string' binding cannot be 'final'; a primitive has no subclass that could override it.
// @expect-error 'float' already has a primitive binding, declared in module 'std.text.refused'. One primitive takes one binding, so add the members there instead.
// @expect-error Cannot assign value of type 'int' to variable of type 'Refused'. 'int' does implement 'Refused', but only as a generic bound: a '<T: Refused>' parameter accepts 'int', while a value of type 'Refused' has to be a class instance, and a primitive never is. Write the slot as 'int', or make it a type parameter bounded by 'Refused'.
// @expect-error Argument 1: expected 'Refused', got 'int'. 'int' does implement 'Refused', but only as a generic bound
// @expect-error Element 1: expected 'Refused', got 'int'. 'int' does implement 'Refused', but only as a generic bound
// @expect-error Right of '??' has type 'int', and '??' supplies the value for a null left side, so the fallback has to be a 'Refused' too. 'int' does implement 'Refused', but only as a generic bound: a '<T: Refused>' parameter accepts 'int', while a value of type 'Refused' has to be a class instance, and a primitive never is. Write the slot as 'int', or make it a type parameter bounded by 'Refused'.
// @expect-error Cannot use 'is' on a value of type 'int'; only class values can be tested. 'int' does implement 'Refused', but only as a generic bound: 'is' works on class instances, and a primitive never is one.
// @expect-error Cannot use 'as?' on a value of type 'int'; only class values can be cast. 'int' does implement 'Refused', but only as a generic bound: 'as?' works on class instances, and a primitive never is one.
// @expect-error A 'string' cannot be iterated directly. Iterate '"text".chars()' to visit its characters, or '"text".bytes()' to visit its bytes.
// @expect-error Method 'crash' of the 'long' binding must be marked 'noreturn', because interface 'Crasher' declares it 'noreturn'.
// @expect-error because the compiler implements 'toString' on a value of type 'double' itself. Stop implementing 'Shown' here.
// @expect-error build failed with 27 problems
import Refused from @std.text.refused;

kept(Refused held) -> long {
    return 0;
}

main() -> int {
    Refused slot = 3;
    let passed = kept(3);
    Refused[] all = [3];
    Refused? absent = null;
    let fallback = absent ?? 3;
    if (3 is Refused) {
        print("no");
    }
    let cast = 3 as? Refused;
    for (let c in "text") {
        print("{c}");
    }
    return 0;
}
