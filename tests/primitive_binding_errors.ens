// @stdlib primitive_stdlib
// Every way a primitive binding is refused, plus what a declared conformance does not buy: it
// satisfies a generic bound and gives the primitive no interface value, so a slot, a '??'
// fallback, an 'is' test and an 'as?' cast all stay errors.
// @expect-error 'Widget' is not a primitive type, so it cannot carry a primitive binding. A binding names one of 'bool', 'byte', 'short', 'ushort', 'int', 'uint', 'long', 'ulong', 'float', 'double', 'char' and 'string'. Declare the members of 'Widget' in 'Widget' itself.
// @expect-error 'void' cannot carry a primitive binding: 'void' is the absence of a value, so there is nothing for a member to run on.
// @expect-error 'decimal' cannot carry a primitive binding: 'decimal' is reserved for a decimal type the language does not have yet, so there is nothing to declare members on.
// @expect-error 'char' can only implement an interface, and 'Widget' is not one. A binding never extends a class.
// @expect-error The binding for 'int' implements 'Refused' but does not provide 'wanted() -> long'. Declare the method here, or stop implementing 'Refused'.
// @expect-error Method 'unrelated' of the 'int' binding is marked 'override' but no interface it implements declares it. Remove 'override'.
// @expect-error Method 'wanted' of the 'ushort' binding implements a method declared in interface 'Refused' but is not marked 'override'. Write 'override' before 'wanted'.
// @expect-error Method 'length' of the 'string' binding cannot be declared: 'string.length' is the byte count, read without parentheses, so a method named 'length' could never be called. Choose another name.
// @expect-error Method 'toString' of the 'string' binding cannot be declared: interpolation such as '{count}' also uses the text form of a value of type 'string', so a binding cannot replace 'toString()'. Declare an overload that takes arguments instead, such as 'toString(int radix)'.
// @expect-error A binding for 'string' cannot declare a field: 'count' would need room in every value of type 'string', and a primitive has none. Declare methods here, and keep the field on a class or a struct that contains a value of type 'string'.
// @expect-error A binding for 'string' cannot declare a static const; it declares only what a value of type 'string' can do. Declare 'limit' on a class or a struct of this module instead.
// @expect-error A binding for 'string' cannot declare a constructor, because a value of type 'string' is written as a literal, never built with 'new'. Declare a static method that returns one instead.
// @expect-error A binding for 'string' cannot declare a destructor, because a value of type 'string' is copied, never destroyed. Remove the destructor.
// @expect-error Method 'missing' of the 'string' binding cannot be 'abstract', because a primitive has no subclass to give it a body. Give 'missing' a body, and remove 'abstract'.
// @expect-error Method 'bodiless' of the 'string' binding has no body, and 'bodiless() -> long' is not a member the compiler implements. The ones it does are 'byteAt(long) -> byte', 'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string' and 'static fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'bodiless' a body to write it in Ens.
// @expect-error Method 'byteAt' of the 'string' binding has no body, and 'byteAt(long) -> long' is not a member the compiler implements. The ones it does are 'byteAt(long) -> byte', 'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string' and 'static fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'byteAt' a body to write it in Ens.
// @expect-error Method 'fixed' of the 'string' binding cannot be 'final', because a primitive has no subclass that could override it. Remove 'final'.
// @expect-error 'float' already has a primitive binding, declared in module 'std.text.refused'. One primitive takes one binding, so add the members there instead.
// @expect-error Variable 'slot' has type 'Refused', but its value has type 'int'. 'int' implements 'Refused', but a primitive can only be passed where a type parameter such as '<T: Refused>' is declared. A value of type 'Refused' must be an object of a class, and a primitive value is not one. Declare the type as 'int', or declare '<T: Refused>' and use 'T'.
// @expect-error Argument 1 of 'kept' has type 'int', but parameter 'held' has type 'Refused'. 'int' implements 'Refused', but a primitive can only be passed where a type parameter such as '<T: Refused>' is declared. A value of type 'Refused' must be an object of a class, and a primitive value is not one. Declare the type as 'int', or declare '<T: Refused>' and use 'T'.
// @expect-error Element 1 has type 'int', but the elements of this array have type 'Refused'. 'int' implements 'Refused', but a primitive can only be passed where a type parameter such as '<T: Refused>' is declared. A value of type 'Refused' must be an object of a class, and a primitive value is not one. Declare the type as 'int', or declare '<T: Refused>' and use 'T'.
// @expect-error The fallback after '??' has type 'int', but it replaces 'absent' when 'absent' is null, so it must have type 'Refused'. 'int' implements 'Refused', but a primitive can only be passed where a type parameter such as '<T: Refused>' is declared. A value of type 'Refused' must be an object of a class, and a primitive value is not one. Declare the type as 'int', or declare '<T: Refused>' and use 'T'.
// @expect-error Cannot use 'is' on a value of type 'int', because only a class value can be tested with 'is'. 'int' implements 'Refused', but a primitive value is never a class instance. Remove the test, because every 'int' implements 'Refused'.
// @expect-error Cannot use 'as?' on a value of type 'int', because only a class value can be cast with 'as?'. 'int' implements 'Refused', but a primitive value is never a class instance. Remove the cast, because every 'int' implements 'Refused'.
// @expect-error A 'string' cannot be iterated directly. Iterate '"text".chars()' to visit its characters, or '"text".bytes()' to visit its bytes.
// @expect-error Method 'crash' of the 'long' binding must be marked 'noreturn', because interface 'Crasher' declares it 'noreturn'.
// @expect-error because the compiler implements 'toString' on a value of type 'double' itself. Stop implementing 'Shown' here.
// @expect-error build failed with 27 problems
import Refused from @std.text.refused;

kept(Refused held) -> long {
    return 0;
}

main() -> int {
    Refused slot = 3;
    let passed = kept(3);
    Refused[] all = [3];
    Refused? absent = null;
    let fallback = absent ?? 3;
    if (3 is Refused) {
        print("no");
    }
    let cast = 3 as? Refused;
    for (let c in "text") {
        print("{c}");
    }
    return 0;
}
