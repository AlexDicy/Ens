// @stdlib primitive_stdlib
// Every way a primitive binding is refused, plus what a declared conformance does not buy: it
// satisfies a generic bound and gives the primitive no interface value, so an interface-typed
// slot, an 'is' test, and an 'as?' cast all stay errors.
// @expect-error 'Widget' is not a primitive type, so it cannot carry a primitive binding. A binding names one of 'bool', 'byte', 'short', 'ushort', 'int', 'uint', 'long', 'ulong', 'float', 'double', 'char', and 'string'; a type declared in Ens carries its members in its own declaration.
// @expect-error 'void' cannot carry a primitive binding: 'void' is the absence of a value, so there is nothing for a member to run on.
// @expect-error 'decimal' cannot carry a primitive binding: 'decimal' is reserved for a decimal type the language does not have yet, so there is nothing to declare members on.
// @expect-error 'char' can only implement an interface, and 'Widget' is not one. A primitive has no object to inherit into, so a binding never extends a class.
// @expect-error The binding for 'int' implements 'Refused' but does not provide 'wanted() -> long'. Declare the method here, or stop implementing 'Refused'.
// @expect-error Method 'unrelated' of the 'int' binding is marked 'override' but no implemented interface declares it. A primitive has no base to override, so 'override' here only means the member answers a conformance.
// @expect-error Method 'wanted' of the 'ushort' binding implements a method declared in interface 'Refused'; mark it 'override'.
// @expect-error 'length' is provided by the compiler on every 'string', so a binding cannot declare it. Choose another name.
// @expect-error 'toString' is provided by the compiler on every 'string', so a binding cannot declare it. Choose another name.
// @expect-error 'string.fromBytes' is provided by the compiler, so a binding cannot declare it. Choose another name.
// @expect-error A binding for 'string' cannot declare a field: 'count' would need storage in every 'string' value, and a primitive carries none. Declare methods here, and put the state in a class or struct that holds a 'string'.
// @expect-error A binding for 'string' cannot declare a static const: it declares what a 'string' value can do, not constants under the primitive's name. Declare 'limit' on a class or struct of this module instead.
// @expect-error A binding for 'string' cannot declare a constructor: a 'string' is written as a literal or produced by an expression, never built with 'new'. Declare a static that returns a 'string' instead.
// @expect-error A binding for 'string' cannot declare a destructor: a primitive owns nothing to release, and its values are copied rather than destroyed.
// @expect-error Method 'missing' of the 'string' binding cannot be 'abstract': a primitive has no subclass to supply a body, so every member here is written out.
// @expect-error Method 'bodiless' of the 'string' binding needs a body: a primitive's members are ordinary Ens code, and nothing else supplies one.
// @expect-error Method 'fixed' of the 'string' binding cannot be 'final': 'final' forbids an override, and a primitive has nothing that could override it.
// @expect-error 'float' already has a primitive binding, declared in module 'std.text.refused'. One primitive takes one binding, so its members read in one place; add the members there instead.
// @expect-error Cannot assign value of type 'int' to variable of type 'Refused'. 'int' does implement 'Refused', but only as a generic bound: a '<T: Refused>' parameter accepts 'int', while an interface-typed slot needs a value that carries the interface, and a primitive is never wrapped in one. Write the slot as 'int', or make it a type parameter bounded by 'Refused'.
// @expect-error Argument 1: expected 'Refused', got 'int'. 'int' does implement 'Refused', but only as a generic bound
// @expect-error Element 1: expected 'Refused', got 'int'. 'int' does implement 'Refused', but only as a generic bound
// @expect-error Cannot use 'is' on a value of type 'int'; only class values can be tested. 'int' does implement 'Refused', but only as a generic bound: 'is' works over a value that carries the interface, and a primitive is never wrapped in one.
// @expect-error Cannot use 'as?' on a value of type 'int'; only class values can be cast. 'int' does implement 'Refused', but only as a generic bound: 'as?' works over a value that carries the interface, and a primitive is never wrapped in one.
// @expect-error 'for (... in ...)' cannot iterate a 'string': text is not a sequence of its own, so a walk over it says which view it reads. Iterate 'text.toBytes()' to visit the bytes.
// @expect-error Method 'crash' of the 'long' binding must be marked 'noreturn' because interface 'Crasher' declares it 'noreturn'; callers rely on it never returning.
// @expect-error because the compiler answers for 'toString' on 'double' itself. Stop implementing 'Shown' here.
// @expect-error build failed with 26 problems
import Refused from @std.text.refused;

kept(Refused held) -> long {
    return 0;
}

main() -> int {
    Refused slot = 3;
    let passed = kept(3);
    Refused[] all = [3];
    if (3 is Refused) {
        print("no");
    }
    let cast = 3 as? Refused;
    for (let c in "text") {
        print("{c}");
    }
    return 0;
}
