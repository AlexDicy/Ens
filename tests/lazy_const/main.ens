// @exit 0
// @stdout reader built
// @stdout input first line
// @stdout input first line
// @stdout limits built
// @stdout 40x80 3
// @stdout in out err
// @stdout in out err
// @stdout in out err
// @stdout input/40
// @stdout tag built
// @stdout shared shared
// @stdout still here: input
// A 'lazy const' is built on the first read and kept for the rest of the program: each
// initializer prints once however many functions, modules, and loop turns read the value, and
// the shared reader's destructor never runs even after a caller that held it has returned.
import Channel from streams;
import Streams from streams;

readName() -> string {
    return Streams.input.name;
}

readLine() -> string {
    let held = Streams.input;
    return held.first();
}

report() -> string {
    return "{Streams.limits.width}x{Streams.limits.height} {Streams.channels}";
}

main() -> int {
    print("{readName()} {readLine()}");
    print("{readName()} {readLine()}");
    print(report());
    for (long i = 0; i < 3; i++) {
        print("{Streams.names[0]} {Streams.names[1]} {Streams.names[2]}");
    }
    let streams = new Streams();
    print(streams.describe());
    print("{Channel<int>.tag} {Channel<string>.tag}");
    print("still here: {Streams.input.name}");
    return 0;
}
