// The module that declares the lazy consts the program next door reads through their type names.
import List from @std.collections.list;

public class Reader {
    public const string name;
    public const List<string> lines;

    public constructor(this.name, this.lines);

    destructor() {
        print("the shared reader was destroyed");
    }

    public first() -> string {
        return this.lines.get(0);
    }
}

public struct Limits {
    public long width;
    public long height;
}

makeReader() -> Reader {
    print("reader built");
    let lines = new List<string>();
    lines.push("first line");
    lines.push("second line");
    return new Reader("input", lines);
}

measure(long width) -> Limits {
    print("limits built");
    return {width: width, height: width * 2};
}

makeTag() -> string {
    print("tag built");
    return "shared";
}

// A lazy const on a generic type mentions none of its parameters, so every instantiation reads
// the one value.
public class Channel<T> {
    public const T? payload;
    public lazy const string tag = makeTag();

    public constructor(this.payload);
}

public class Streams {
    public lazy const Reader input = makeReader();
    public lazy const Limits limits = measure(40);
    public lazy const string[] names = ["in", "out", "err"];
    public static const long channels = 3;

    public describe() -> string {
        return "{Streams.input.name}/{Streams.limits.width}";
    }
}
