// @exit 99
class Inner {
    protected int v;
    protected constructor(this.v = 0);
}

class Outer {
    protected Inner i;
    protected constructor(Inner i) {
        this.i = i;
    }
}

main() -> int {
    let a = new Inner();
    let b = new Inner();
    a.v = 11;
    b.v = 99;
    let o = new Outer(a);
    o.i = b;
    return o.i.v;
}
