// @exit 0
// @stdout total 400000
// @stdout hits 40000 at 3,4
// @stdout words 3 apple 2
// @stdout caught broken, length 2
// Four tasks add to one object's count under a mutex and to a number through 'update', a struct
// changes through 'update', a map of words changes in place under its lock, and a body that throws
// releases the lock and passes the error on.
import @std.tasks;
import Cancelled from @std.tasks;
import Mutex from @std.tasks;
import List from @std.collections.list;
import Map from @std.collections.map;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

struct Point {
    int x;
    int y;
}

final class Tally {
    long count = 0;
}

addMany(Mutex<Tally> tally) throws Cancelled {
    for (long i = 0; i < 100000; i++) {
        try tally.lock((held) -> {
            held.count = held.count + 1;
        });
    }
}

failInside(Mutex<List<int>> numbers) -> string throws Cancelled {
    try numbers.lock((list) -> {
        list.push(2);
        if (list.length() > 1) {
            throw new Broken();
        }
        return list.length();
    });
    return "not thrown";
} catch (Broken broken) {
    long length = try numbers.lock((list) -> list.length());
    return "caught {broken.message}, length {length}";
}

main() -> int throws Cancelled {
    let tally = new Mutex<Tally>(new Tally());
    tasks.scope((scope) -> {
        for (long t = 0; t < 4; t++) {
            scope.launch(() -> try addMany(tally));
        }
    });
    long total = try tally.lock((held) -> held.count);
    print("total {total}");

    let hits = new Mutex<int>(0);
    tasks.scope((scope) -> {
        for (long t = 0; t < 4; t++) {
            scope.launch(() -> {
                for (long i = 0; i < 10000; i++) {
                    try hits.update((count) -> count + 1);
                }
            });
        }
    });
    Point origin = {x: 2, y: 4};
    let cursor = new Mutex<Point>(origin);
    try cursor.update((point) -> {
        Point moved = {x: point.x + 1, y: point.y};
        return moved;
    });
    int seen = try hits.lock((count) -> count);
    Point now = try cursor.lock((point) -> point);
    print("hits {seen} at {now.x},{now.y}");

    let words = new Mutex<Map<string, int>>(new Map<string, int>());
    for (let word in ["apple", "pear", "apple", "fig"]) {
        try words.lock((counts) -> counts.set(word, (counts.get(word) ?? 0) + 1));
    }
    long distinct = try words.lock((counts) -> counts.length());
    int apples = try words.lock((counts) -> counts.get("apple") ?? 0);
    print("words {distinct} apple {apples}");

    let numbers = new Mutex<List<int>>(new List<int>());
    try numbers.lock((list) -> list.push(1));
    print(try failInside(numbers));
    return 0;
}
