// @exit 30
class Box {
    int v;
    constructor(this.v = 0);
}

main() -> int {
    Box?[]?[] grid = new Box?[]?[3];
    grid[0] = new Box?[2];
    // grid[1] left as null
    grid[2] = new Box?[1];

    // Use ?[ to walk both axes without binding to a local per layer.
    // grid[r]?[c] returns Box?, null both when the row is null and when the
    // slot itself is null.
    Box?[]? row0 = grid[0];
    if (row0 != null) {
        row0[0] = new Box(10);
        row0[1] = new Box(20);
    }
    Box?[]? row2 = grid[2];
    if (row2 != null) {
        row2[0] = new Box(99);
    }

    int total = 0;
    int r = 0;
    while (r < 3) {
        Box? cell = grid[r]?[0];
        if (cell != null) {
            total = total + cell.v;
        }
        r = r + 1;
    }
    // grid[0]?[0] = Box(10), grid[1]?[0] = null (row null), grid[2]?[0] = Box(99)
    if (total != 109) { return 1; }

    // Out-of-row null: r=1 short-circuits to null and total stays unchanged
    // when we don't add it. Confirm by checking grid[1]?[0] == null directly.
    Box? maybe = grid[1]?[0];
    if (maybe != null) { return 2; }

    // ?[ on a non-null row still works (acts like normal subscript).
    Box? again = grid[0]?[1];
    if (again == null) { return 3; }
    return 30;
}