// @exit 0
// @stdout replaced by replacer
// @stdout visited 2
// @stdout counted by counter
// @stdout visited 1
// A visitor read out of a field and called through its base class keeps running over its own
// fields although it replaces that field: one of the overrides the call can reach writes the
// field, so the call keeps what it read alive, whichever override it reaches at run time.
class Visitor {
    protected string name;

    protected constructor(this.name);

    protected visit(Holder holder) -> int {
        holder.count = holder.count + 1;
        print("counted by {this.name}");
        return 1;
    }
}

class Replacer extends Visitor {
    protected constructor(string name) {
        super(name);
    }

    protected override visit(Holder holder) -> int {
        holder.visitor = new Visitor("replacement");
        print("replaced by {this.name}");
        return 2;
    }
}

class Holder {
    protected Visitor visitor;
    protected int count;

    protected constructor(this.visitor);

    protected run() -> int {
        return this.visitor.visit(this);
    }
}

pick(bool replacing) -> Visitor {
    if (replacing) {
        return new Replacer("repl" + "acer");
    }
    return new Visitor("coun" + "ter");
}

main() -> int {
    let replaced = new Holder(pick(true));
    print("visited {replaced.run()}");
    let counted = new Holder(pick(false));
    print("visited {counted.run()}");
    return 0;
}
