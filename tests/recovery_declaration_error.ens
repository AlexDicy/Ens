// A syntax error in what a file declares - here a field the parser found a type but no name for -
// leaves every reference to that declaration a guess, so no semantic diagnostic is reported at all.
// 'Box' has a field whose name the compiler invented, and both the constructor's 'this.value' and
// 'box.value' below would be reported as missing members of it: three complaints about one mistake,
// two of them consequences. Silence is the better answer, and the syntax error stands on its own.
// @expect-error Expected the field's name
// @expect-error build failed with 1 problem
class Box {
    long;
    constructor(this.value);
}

main() -> int {
    let box = new Box(1);
    return box.value;
}
