// A syntax error in what a file declares leaves every reference to that declaration a guess, so no
// semantic diagnostic is reported at all. Here a field has a name the compiler invented, and both
// reads of it would be consequences rather than problems, so the syntax error stands on its own. A
// class body left open ends at the next type declaration, so 'main' after it is read as written.
// @expect-error Expected the field's name.
// @expect-error Expected '}' to close the body of 'Open'.
// @expect-error build failed with 2 problems
class Box {
    long;
    constructor(this.value);
}

class Open {
    int count;

struct Later {
    int y;
}

main() -> int {
    let box = new Box(1);
    return box.value;
}
