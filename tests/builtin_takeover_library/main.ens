// @stdlib ../builtin_takeover_stdlib
// The shape a standard library takes a provided function over in: an implicitly imported module
// declares 'print' and exports it. Inside that module the declaration answers every call, so the
// prelude function 'announce' goes through it, and a qualified call from this package reaches it
// too. This module declares nothing, so its own unqualified 'print' is still the one the language
// provides, exported prelude declaration or not.
// @stdout main: provided
// @stdout core: through the library
// @stdout core: qualified
// @exit 0
import @std.core;

main() -> int {
    print("main: provided");
    announce("through the library");
    core.print("qualified");
    return 0;
}
