// @stdlib ../builtin_takeover_stdlib
// The shape a standard library takes a provided function over in: an implicitly imported module
// declares 'panic' and exports it. Inside that module the declaration answers every call, while
// this module declares nothing, so its own unqualified 'panic' is still the provided one.
// @stdout core: through the library
// @stdout core: qualified
// @exit 0
import @std.core;

// Accepted only because this module's own 'panic' is the provided one, which never returns;
// nothing calls this.
provided() -> long {
    panic("nothing calls this");
}

main() -> int {
    announce("through the library");
    core.panic("qualified");
    return 0;
}
