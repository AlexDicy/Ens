// @exit 0
// @stdout registry: 3
// @stdout registry: text
// @stdout value 20
// @stdout 4
// @stdout caught missing
// @stdout seed and 42; seed and seed
// @stdout true and 1.5
// @stdout 1 c
// @stdout 5 and x
// @stdout 5 and c
// @stdout 8,12
// @stdout a
// @stdout depth 7
// @stdout listed 2
// @stdout keyed 30
// @stdout locked 42
// A method declares type parameters of its own in its '<...>' list, beside any it restates from its
// type. A call infers them or writes them after the method's name, and each list of type arguments
// is a separate method, on a class, a struct, a static, an inherited or a '?.' call alike.
class Missing extends Error {
    constructor() {
        super("missing");
    }
}

class Registry {
    string label = "registry";

    describe<T>(T value) -> string {
        return "{this.label}: {value}";
    }
}

class Holder<T> {
    T value;

    constructor(this.value);

    mapped<R>((T) -> R transform) -> Holder<R> {
        return new Holder<R>(transform(this.value));
    }

    using<R, E: Error>(((T) -> R throws E) body) -> R throws E {
        return try body(this.value);
    }

    paired<U>(U other) -> string {
        return "{this.value} and {other}";
    }

    twice<U>(U other) -> string {
        (U) -> string joined = (U item) -> this.paired(item);
        return joined(other) + "; " + this.paired<T>(this.value);
    }

    keyed<K>(K key) -> long {
        return key.hash() + this.value.hash();
    }

    relay() -> long {
        return this.keyed<T>(this.value);
    }

    locked<shared R>((shared (T) -> R) body) -> R {
        return body(this.value);
    }

    static wrap<U>(U value) -> Holder<U> {
        return new Holder<U>(value);
    }

    static joined<U>(T left, U right) -> string {
        return "{left} {right}";
    }
}

class Counter extends Holder<int> {
    constructor() {
        super(5);
    }

    both() -> string {
        return super.paired("x");
    }
}

struct Point {
    int x;
    int y;

    scaled<N>(N factor, (int, N) -> int multiply) -> Point {
        Point result = {x: multiply(this.x, factor), y: multiply(this.y, factor)};
        return result;
    }
}

collect<T>(T value) -> T[] {
    return [value, value];
}

class Tools {
    static first<T>(T[] items) -> T {
        return items[0];
    }

    depth<T>(T value, int remaining) -> int {
        if (remaining == 0) {
            return 0;
        }
        return 1 + this.depth<T>(value, remaining - 1);
    }

    listed<T>(T value) -> long {
        return collect(value).length;
    }
}

attempt(Holder<string> holder) -> string {
    let never = try holder.using((text) -> {
        throw new Missing();
        return 0;
    });
    return "{never}";
} catch (Missing missing) {
    return "caught {missing.message}";
}

main() -> int {
    let registry = new Registry();
    print(registry.describe(3));
    print(registry.describe<string>("text"));
    let cell = new Holder<int>(20);
    print(cell.mapped((value) -> "value {value}").value);
    let holder = new Holder<string>("seed");
    long length = holder.using((text) -> text.length);
    print("{length}");
    print(attempt(holder));
    print(holder.twice(42));
    print(Holder<int>.wrap<bool>(true).paired(1.5));
    print(Holder.joined(1, 'c'));
    let counter = new Counter();
    print(counter.both());
    Holder<int>? maybe = counter;
    print(maybe?.paired('c') ?? "none");
    Point start = {x: 2, y: 3};
    let point = start.scaled(4L, (int axis, long factor) -> axis * (factor as int));
    print("{point.x},{point.y}");
    print(Tools.first(["a", "b"]));
    let tools = new Tools();
    print("depth {tools.depth("text", 7)}");
    print("listed {tools.listed("a")}");
    print("keyed {new Holder<long>(15).relay()}");
    int answer = new Holder<int>(41).locked((value) -> value + 1);
    print("locked {answer}");
    return 0;
}
