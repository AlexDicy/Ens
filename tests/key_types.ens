// @exit 0
// @stdout primitive true
// @stdout string true
// @stdout class true
// @stdout struct true
// @stdout array true
// @stdout declared pair true true
// @stdout map one two three four five
// @stdout set 2 1
// @stdout index 2 true
// @stdout ordered anchored stepped
// A user generic hashes whatever a hashable type argument brings, and a keyed container accepts
// every key whose hash cannot change under it, including a struct that declares its own pair
// around a field with no hash of its own. A container that walks an order asks its key for
// 'Comparable' and nothing else, so a struct holding a field with no hash keys one of those as
// long as it compares.
import Comparable from @std.core;
import Map from @std.collections.map;
import Set from @std.collections.set;
import SortedMap from @std.collections.sortedmap;

external type Handle;

external from libc {
    malloc(long size) -> Handle;
}

class Node {
    protected int value;

    protected constructor(this.value);
}

struct Point {
    protected int x;
    protected int y;
}

struct Slot {
    protected int id;
    protected Handle handle;

    override hash() -> long {
        return this.id;
    }

    override equals(Slot other) -> bool {
        return this.id == other.id;
    }
}

enum Color {
    Red,
    Green,
}

// Neither field has a hash, and neither needs one: the order comes from 'rank' through the
// struct's own 'compareTo', which is all a sorted map asks of a key.
struct Anchored implements Comparable<Anchored> {
    protected Handle slot;
    protected int rank;

    protected override compareTo(Anchored other) -> int {
        return this.rank - other.rank;
    }
}

struct Stepped implements Comparable<Stepped> {
    protected (int) -> int step;
    protected int rank;

    protected override compareTo(Stepped other) -> int {
        return this.rank - other.rank;
    }
}

hashOf<T>(T value) -> long {
    return value.hash();
}

index<K>(K first, K second) -> Map<K, int> {
    let table = new Map<K, int>();
    table.set(first, 1);
    table.set(second, 2);
    return table;
}

main() -> int {
    int number = 42;
    print("primitive {hashOf(number) == number.hash()}");
    string text = "key";
    print("string {hashOf(text) == text.hash()}");
    let node = new Node(1);
    print("class {hashOf(node) == node.hash()}");
    Point point = {x: 1, y: 2};
    print("struct {hashOf(point) == point.hash()}");
    int[] numbers = [1, 2, 3];
    print("array {hashOf(numbers) == numbers.hash()}");
    Slot slot = {id: 7, handle: malloc(8)};
    Slot sameSlot = {id: 7, handle: malloc(8)};
    print("declared pair {hashOf(slot) == sameSlot.hash()} {slot == sameSlot}");

    let byString = new Map<string, string>();
    byString.set(text, "one");
    let byClass = new Map<Node, string>();
    byClass.set(node, "two");
    let byStruct = new Map<Point, string>();
    byStruct.set(point, "three");
    let byEnum = new Map<Color, string>();
    byEnum.set(Color.Green, "four");
    let bySlot = new Map<Slot, string>();
    bySlot.set(slot, "five");
    Point samePoint = {x: 1, y: 2};
    string one = byString.get(text) ?? "missing";
    string two = byClass.get(node) ?? "missing";
    string three = byStruct.get(samePoint) ?? "missing";
    string four = byEnum.get(Color.Green) ?? "missing";
    string five = bySlot.get(sameSlot) ?? "missing";
    print("map {one} {two} {three} {four} {five}");

    let names = new Set<string>();
    names.add("x");
    names.add("y");
    names.add("x");
    let points = new Set<Point>();
    points.add(point);
    points.add(samePoint);
    print("set {names.length()} {points.length()}");

    let table = index("left", "right");
    bool hasRight = table.contains("right");
    print("index {table.length()} {hasRight}");

    let byAnchored = new SortedMap<Anchored, string>();
    Anchored anchored = {slot: malloc(8), rank: 1};
    byAnchored.set(anchored, "anchored");
    let byStepped = new SortedMap<Stepped, string>();
    Stepped stepped = {step: (value) -> value + 1, rank: 1};
    byStepped.set(stepped, "stepped");
    string anchoredValue = byAnchored.get(anchored) ?? "missing";
    string steppedValue = byStepped.get(stepped) ?? "missing";
    print("ordered {anchoredValue} {steppedValue}");
    return 0;
}
