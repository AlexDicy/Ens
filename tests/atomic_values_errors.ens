// @expect-error Cannot hold 'Point' in an 'Atomic': an 'Atomic' holds a number, a 'bool', a 'char', an enum or a reference, which the processor replaces in a single step, and 'Point' is a struct. Keep it in a 'Mutex<Point>' instead, which lets one task change it at a time.
// @expect-error Cannot hold 'int?' in an 'Atomic': an 'Atomic' holds a number, a 'bool', a 'char', an enum or a reference, which the processor replaces in a single step, and 'int?' is two values, the 'int' and whether it is there. Keep it in a 'Mutex<int?>' instead, which lets one task change it at a time.
// @expect-error 'increment' exists on 'Atomic<T>' only when 'T' satisfies 'Number<T>', and in 'Atomic<string>', 'T' is 'string', which does not implement 'Number<string>'.
// @expect-error 'holding<Point>' cannot hold 'Point' in an 'Atomic': an 'Atomic' holds a number, a 'bool', a 'char', an enum or a reference, which the processor replaces in a single step, and 'Point' is a struct. Keep it in a 'Mutex<Point>' instead, which lets one task change it at a time.
// @expect-note 'Atomic' holds 'T' here
// @expect-error build failed with 5 problems
// An Atomic holds only what the processor replaces in one step, judged where the type is written
// and, inside a generic, once for each instantiation at each line of the generic that names it. Its
// arithmetic exists only for numbers.
import Atomic from @std.tasks;

struct Point {
    int x;
    int y;
}

holding<shared T>(T value) -> Atomic<T> {
    return new Atomic<T>(value);
}

main() -> int {
    Point origin = {x: 0, y: 0};
    let points = new Atomic<Point>(origin);
    let maybe = new Atomic<int?>(null);
    let name = new Atomic<string>("a");
    name.increment();
    let wrapped = holding(origin);
    return 0;
}
