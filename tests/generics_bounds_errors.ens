// @expect-error Type argument 'Plain' for type parameter 'T' must implement interface 'Comparable<Plain>'.
// @expect-error Type argument 'Askew' for type parameter 'T' must implement interface 'Comparable<Askew>'.
// @expect-error Type argument 'Meters' for type parameter 'A' must implement interface 'Converts<Meters>'.
// @expect-error Type argument 'Meters' for type parameter 'B' must implement interface 'Converts<Meters>'.
// @expect-error A type-parameter bound must be a non-generic class or an interface; 'T' is not.
// @expect-error build failed with 8 problems
// A bound naming its own parameter is judged with the argument substituted in, at every site an
// argument reaches it: an explicit type argument, an inferred one, a class instantiation in an
// expression and in a field, and each side of a mutually referential pair. A parameter is in scope
// inside its own bound, but it is not itself a bound.
class Plain {
    protected constructor();
}

class Item implements Comparable<Item> {
    protected int value;

    protected constructor(this.value);

    protected override compareTo(Item other) -> int {
        return this.value - other.value;
    }
}

// Comparable, but to another type, so it does not satisfy 'Comparable<Askew>'.
class Askew implements Comparable<Item> {
    protected constructor();

    protected override compareTo(Item other) -> int {
        return 0;
    }
}

largest<T: Comparable<T>>(T[] values) -> T {
    return values[0];
}

class Sorted<T: Comparable<T>> {
    protected constructor();
}

struct Shelf {
    protected Sorted<Plain>? plains;
}

interface Converts<T> {
    convert() -> T;
}

class Meters implements Converts<Feet> {
    protected constructor();

    protected override convert() -> Feet {
        return new Feet();
    }
}

class Feet implements Converts<Meters> {
    protected constructor();

    protected override convert() -> Meters {
        return new Meters();
    }
}

roundTrip<A: Converts<B>, B: Converts<A>>(A start) -> A {
    return start.convert().convert();
}

mirror<T: T>(T value) -> T {
    return value;
}

main() -> int {
    Plain[] plains = [new Plain()];
    let explicit = largest<Plain>(plains);
    let inferred = largest(plains);
    let askew = largest<Askew>([new Askew()]);
    let sorted = new Sorted<Plain>();
    let trip = roundTrip<Meters, Meters>(new Meters());
    return 0;
}
