// @expect-error Type argument 'Askew' for type parameter 'T' of 'largest' must implement interface 'Comparable<Askew>'. Replace 'Askew' with a type that implements 'Comparable<Askew>', or add 'Comparable<Askew>' to the 'implements' list of 'Askew'.
// @expect-error Type argument 'Meters' for type parameter 'A' of 'roundTrip' must implement interface 'Converts<Meters>'. Replace 'Meters' with a type that implements 'Converts<Meters>', or add 'Converts<Meters>' to the 'implements' list of 'Meters'.
// @expect-error Type argument 'Meters' for type parameter 'B' of 'roundTrip' must implement interface 'Converts<Meters>'. Replace 'Meters' with a type that implements 'Converts<Meters>', or add 'Converts<Meters>' to the 'implements' list of 'Meters'.
// @expect-error A type-parameter bound must be a class that is not generic, or an interface, and 'T' is neither. Name a class or an interface, or remove the bound.
// @expect-error build failed with 8 problems
// A bound naming its own parameter is judged with the argument substituted in, at every site an
// argument reaches it. A parameter is in scope inside its own bound, but it is not itself a bound.
class Plain {
    protected constructor();
}

class Item implements Comparable<Item> {
    protected int value;

    protected constructor(this.value);

    protected override compareTo(Item other) -> int {
        return this.value - other.value;
    }
}

// Comparable, but to another type, so it does not satisfy 'Comparable<Askew>'.
class Askew implements Comparable<Item> {
    protected constructor();

    protected override compareTo(Item other) -> int {
        return 0;
    }
}

largest<T: Comparable<T>>(T[] values) -> T {
    return values[0];
}

class Sorted<T: Comparable<T>> {
    protected constructor();
}

struct Shelf {
    protected Sorted<Plain>? plains;
}

interface Converts<T> {
    convert() -> T;
}

class Meters implements Converts<Feet> {
    protected constructor();

    protected override convert() -> Feet {
        return new Feet();
    }
}

class Feet implements Converts<Meters> {
    protected constructor();

    protected override convert() -> Meters {
        return new Meters();
    }
}

roundTrip<A: Converts<B>, B: Converts<A>>(A start) -> A {
    return start.convert().convert();
}

mirror<T: T>(T value) -> T {
    return value;
}

main() -> int {
    Plain[] plains = [new Plain()];
    let explicit = largest<Plain>(plains);
    let inferred = largest(plains);
    let askew = largest<Askew>([new Askew()]);
    let sorted = new Sorted<Plain>();
    let trip = roundTrip<Meters, Meters>(new Meters());
    return 0;
}
