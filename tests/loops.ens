// @exit 50
main() -> int {
    int total = 0;

    for (int i = 0; i < 5; i = i + 1) {
        total = total + i;
    }

    int[] xs = new int[4];
    xs[0] = 1;
    xs[1] = 2;
    xs[2] = 3;
    xs[3] = 4;
    for (int x in xs) {
        total = total + x;
    }

    for (int i = 0; i < 100; i = i + 1) {
        if (i == 4) {
            break;
        }
        total = total + 1;
    }

    for (int i = 0; i < 5; i = i + 1) {
        if (i % 2 == 1) {
            continue;
        }
        total = total + i;
    }

    int j = 0;
    while (true) {
        if (j >= 10) {
            break;
        }
        total = total + 1;
        j = j + 1;
    }

    for (let x in xs) {
        total = total + x;
    }

    return total;
}