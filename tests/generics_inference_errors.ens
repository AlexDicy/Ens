import List from @std.collections.list;

pairUp<T>(T first, T second) -> T {
    return first;
}

combine<T>(T first, List<T> rest) -> T {
    return first;
}

fresh<T>(long count) -> T[] {
    return new T[count];
}

firstOf<T>(List<T> items) -> T {
    return items.get(0);
}

apply<T>(() -> T body) -> T {
    return body();
}

class Tally {
    const long count;
    const long total;

    constructor(long start) {
        this.total = apply(() -> this.count + start);
        this.count = start;
    }
}

class Shape {
    constructor();
}

class Circle extends Shape {
    constructor() {
        super();
    }
}

class Square extends Shape {
    constructor() {
        super();
    }
}

both<A>(() -> A make, () -> A other) -> long {
    return 0;
}

maybeInts() -> List<int>? {
    return null;
}

main() -> int {
    let a = pairUp(1, "x");
    let b = pairUp(null, 5);
    let names = new List<string>();
    let d = combine(1, names);
    let e = fresh(3);
    let f = firstOf(maybeInts());
    let h = fresh();
    long k = both(() -> new Circle(), () -> new Square());
    return 0;
}
