// Inference-driven diagnostics for generic function calls: a conflicting argument names the
// inferred parameter and where its binding came from, the nullability hint and the provenance
// chain as separate sentences, and a bare 'null' binds nothing rather than becoming the type
// argument.
pairUp<T>(T first, T second) -> T {
    return first;
}

identity<T>(T value) -> T {
    return value;
}

main() -> int {
    let a = pairUp(1, "x");
    let b = pairUp(null, 5);
    let c = identity(null);
    return 0;
}
