import List from @std.collections.list;

pairUp<T>(T first, T second) -> T {
    return first;
}

identity<T>(T value) -> T {
    return value;
}

combine<T>(T first, List<T> rest) -> T {
    return first;
}

fresh<T>(long count) -> T[] {
    return new T[count];
}

firstOf<T>(List<T> items) -> T {
    return items.get(0);
}

maybeInts() -> List<int>? {
    return null;
}

main() -> int {
    let a = pairUp(1, "x");
    let b = pairUp(null, 5);
    let c = identity(null);
    let names = new List<string>();
    let d = combine(1, names);
    let e = fresh(3);
    let f = firstOf(maybeInts());
    return 0;
}
