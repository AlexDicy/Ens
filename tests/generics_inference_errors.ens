import List from @std.collections.list;

pairUp<T>(T first, T second) -> T {
    return first;
}

identity<T>(T value) -> T {
    return value;
}

combine<T>(T first, List<T> rest) -> T {
    return first;
}

fresh<T>(long count) -> T[] {
    return new T[count];
}

firstOf<T>(List<T> items) -> T {
    return items.get(0);
}

apply<T>(() -> T body) -> T {
    return body();
}

measured(string? held) -> long {
    return apply(() -> held.length);
}

assigned() -> int {
    return apply(() -> {
        int size = "a";
        return size;
    });
}

class Tally {
    const long count;
    const long total;

    constructor(long start) {
        this.total = apply(() -> this.count + start);
        this.count = start;
    }
}

struct Count {
    long n;
}

first<T>(T[] items) -> T {
    return items[0];
}

pair<T>(Count[] counts, T[] others) -> long {
    return counts[0].n;
}

maybeInts() -> List<int>? {
    return null;
}

main() -> int {
    let a = pairUp(1, "x");
    let b = pairUp(null, 5);
    let c = identity(null);
    let names = new List<string>();
    let d = combine(1, names);
    let e = fresh(3);
    let f = firstOf(maybeInts());
    let g = identity();
    let h = fresh();
    Count i = first([{ n: 1 }]);
    long j = pair([{ n: 1 }], [{ n: 2 }]);
    return 0;
}
