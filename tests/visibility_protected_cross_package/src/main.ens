// @exit 0
// @stdout config load failed: missing key 'port'
// A protected constructor on an exported non-final class is reachable from subclasses
// in a consuming package: both subclasses call super(...) across the package boundary,
// and the constructor's signature may mention the exported base class itself.
import Reported from @acme.tools.reported;

class ParseFailure extends Reported {
    protected constructor(string message) {
        super(message, null);
    }
}

class ConfigFailure extends Reported {
    protected constructor(Reported cause) {
        super("config load failed", cause);
    }
}

main() -> int {
    let failure = new ConfigFailure(new ParseFailure("missing key 'port'"));
    print(failure.format());
    return 0;
}
