// @exit 42
// A floating-point literal's underscores group its digits for the reader and are no part of its
// value, and a magnitude too small for the type to hold rounds to zero rather than failing.
main() -> int {
    double grouped = 1_000.5;
    if (grouped < 1000.0)                   { return 1; }
    if (grouped > 1001.0)                   { return 2; }

    float groupedFloat = 1_000.5f;
    if ((groupedFloat as double) < 1000.0)  { return 3; }
    if ((groupedFloat as double) > 1001.0)  { return 4; }

    // Underscores group the integral and fractional digits; an exponent takes none.
    double exponent = 1_2.5_0e10;
    if (exponent < 1.0e11)                  { return 5; }
    if (exponent > 1.3e11)                  { return 6; }

    // Far below the smallest value a double can hold, so it rounds to zero.
    double tiny = 1e-400;
    if (tiny != 0.0)                        { return 7; }

    return 42;
}
