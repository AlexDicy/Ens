// @stdout circle 2
// @stdout circle 3
// @stdout square 4
// @stdout polygon 4
// @stdout circle 5
// @stdout radius 7
// @stdout total 10
// @stdout shape
// An assignment narrows a local or a parameter to the class of the value it stores, so a call made with
// it picks the overload for that class and a read reaches that class's members. Where branches meet, the
// value keeps the nearest class they share, a nested optional keeps the class under its remaining level of
// null, a loop that stores the same class keeps it on every pass, and a declaration keeps the class it
// declares.
class Shape {
    protected constructor();
}

class Polygon extends Shape {
    protected int sides;

    protected constructor(this.sides) {
        super();
    }
}

class Circle extends Shape {
    protected int radius;

    protected constructor(this.radius) {
        super();
    }
}

class Square extends Polygon {
    protected constructor() {
        super(4);
    }
}

class Triangle extends Polygon {
    protected constructor() {
        super(3);
    }
}

describe(Shape shape) -> string {
    return "shape";
}

describe(Circle circle) -> string {
    return "circle {circle.radius}";
}

describe(Square square) -> string {
    return "square {square.sides}";
}

describe(Polygon polygon) -> string {
    return "polygon {polygon.sides}";
}

found(int radius) -> Circle? {
    return new Circle(radius);
}

reassigned(Shape shape) -> string {
    shape = new Circle(3);
    return describe(shape);
}

joined(bool square) -> string {
    Shape? shape = null;
    if (square) {
        shape = new Square();
    } else {
        shape = new Triangle();
    }
    return describe(shape);
}

nested() -> string {
    Shape?? held = null;
    held = found(7);
    return "radius {held?.radius ?? 0}";
}

looped(int passes) -> string {
    Shape shape;
    shape = new Circle(1);
    int total = 0;
    for (int i = 0; i < passes; i++) {
        total = total + shape.radius;
        shape = new Circle(i + 2);
    }
    return "total {total}";
}

main() -> int {
    Shape shape;
    shape = new Circle(2);
    print(describe(shape));
    print(reassigned(new Square()));
    shape = new Square();
    print(describe(shape));
    print(joined(true));
    shape = new Circle(5);
    print(describe(shape));
    print(nested());
    print(looped(4));
    Shape declared = new Circle(6);
    print(describe(declared));
    return 0;
}
