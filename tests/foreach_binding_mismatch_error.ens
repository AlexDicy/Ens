// @expect-error Loop variable of type 'string' cannot hold the 'int' values this sequence yields.
// The sequence here is an Iterable<int>, not an array, so the mismatch names
// what the sequence yields rather than talking about array elements.
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

class CountUp implements Iterator<int> {
    private int current;
    constructor(this.current);
    override hasNext() -> bool { return this.current < 3; }
    override next() -> int {
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class Range implements Iterable<int> {
    constructor();
    override makeIterator() -> Iterator<int> { return new CountUp(0); }
}

main() -> int {
    for (string s in new Range()) {
        print(s);
    }
    return 0;
}
