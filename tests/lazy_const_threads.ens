// @exit 0
// @stdout built 1 time(s), value 42
// @stdout object built 1 time(s), value 7
// Eight threads read one lazy const at the same moment: the first of them builds the value while
// the others wait, so the initializer runs once and every thread reads the one value. The same
// holds for the lazy const of one object of a 'shared' class.
import Atomic from @std.tasks;

external type NativeThread;
external type NativeLock;

external from libc {
    ens_thread_start((shared () -> void) body, out int error) -> NativeThread?;
    ens_thread_join(NativeThread thread);
    ens_lock_create() -> NativeLock?;
    ens_lock_destroy(NativeLock lock);
    ens_lock_acquire(NativeLock lock);
    ens_lock_release(NativeLock lock);
    ens_lock_wait(NativeLock lock, long millis);
    ens_lock_notify_all(NativeLock lock);
}

shared final class Built {
    const long value;

    constructor(this.value);
}

final class Source {
    static lazy const Atomic<long> calls = new Atomic<long>(0);
    static lazy const Built value = slowBuild();
}

shared final class Gauge {
    const Atomic<long> calls;
    lazy const Built measured = this.slowMeasure();

    constructor(this.calls);

    slowMeasure() -> Built {
        this.calls.increment();
        ens_sleep_millis(50);
        return new Built(7);
    }
}

slowBuild() -> Built {
    Source.calls.increment();
    ens_sleep_millis(50);
    return new Built(42);
}

external from libc {
    ens_sleep_millis(long millis);
}

main() -> int {
    let calls = Source.calls;
    let gauge = new Gauge(new Atomic<long>(0));
    let threads = new NativeThread?[8];
    for (long t = 0; t < 8; t++) {
        int error = 0;
        threads[t] = ens_thread_start(() -> {
            if (Source.value.value != 42 || gauge.measured.value != 7) {
                print("wrong");
            }
        }, out error);
    }
    for (long t = 0; t < 8; t++) {
        let thread = threads[t];
        if (thread != null) {
            ens_thread_join(thread);
        }
    }
    print("built {calls.read()} time(s), value {Source.value.value}");
    print("object built {gauge.calls.read()} time(s), value {gauge.measured.value}");
    return 0;
}
