// @exit 0
// @stdout widget 1
// @stdout widget 1
// @stdout gadget 2
// @stdout gadget 2
// @stdout gadget 3
// @stdout Plain
// @stdout Plain
// @stdout Fancy
// @stdout Fancy
// @stdout sticker
// @stdout sticker
// @stdout legacy text
// @stdout Legacy
// @stdout sized 3
// @stdout Sized
// @stdout Box<int>
// @stdout Box<int>
// @stdout widget 9
// @stdout Plain
// @stdout 7
// @stdout {"a": 1, "b": 2}
// @stdout sticker
// @stdout Fancy

// A class replaces its built-in text form with 'override toString() -> string', and both an
// interpolation hole and an explicit '.toString()' render from the value's runtime type. A class
// with no override anywhere in its chain answers with its runtime type's name, and a method named
// 'toString' without 'override' stays an ordinary method whatever its shape.

interface Tagged {
}

class Widget {
    protected int id;

    protected constructor(this.id);

    override toString() -> string {
        return "widget {this.id}";
    }
}

class Gadget extends Widget {
    protected constructor(int id) {
        super(id);
    }

    final override toString() -> string {
        return "gadget {this.id}";
    }
}

class Gizmo extends Gadget {
    protected constructor(int id) {
        super(id);
    }
}

class Plain {
}

class Fancy extends Plain {
}

class Sticker implements Tagged {
    override toString() -> string {
        return "sticker";
    }
}

class Legacy {
    protected toString() -> string {
        return "legacy text";
    }
}

class Sized {
    protected toString(int scale) -> string {
        return "sized {scale}";
    }
}

class Box<T> {
    protected constructor();
}

class WeakHolder {
    protected weak Plain? kept;

    protected constructor(this.kept);
}

struct Pair {
    protected int a;
    protected int b;
}

render<T>(T value) -> string {
    return value.toString();
}

renderTagged<T: Tagged>(T value) -> string {
    return value.toString();
}

main() -> int {
    let widget = new Widget(1);
    print("{widget}");
    print(widget.toString());

    Widget disguised = new Gadget(2);
    print("{disguised}");
    print(disguised.toString());

    Widget inherited = new Gizmo(3);
    print("{inherited}");

    let plain = new Plain();
    print("{plain}");
    print(plain.toString());

    Plain based = new Fancy();
    print("{based}");
    print(based.toString());

    Tagged tagged = new Sticker();
    print("{tagged}");
    print(tagged.toString());

    let legacy = new Legacy();
    print(legacy.toString());
    print("{legacy}");

    let sized = new Sized();
    print(sized.toString(3));
    print("{sized}");

    let box = new Box<int>();
    print("{box}");
    print(box.toString());

    print(render(new Widget(9)));
    print(render(new Plain()));
    print(render(7));
    Pair pair = {a: 1, b: 2};
    print(render(pair));
    print(renderTagged(new Sticker()));

    Plain? strong = new Fancy();
    let weakHolder = new WeakHolder(strong);
    let kept = weakHolder.kept;
    if (kept != null) {
        strong = null;
        print("{kept}");
    }

    return 0;
}
