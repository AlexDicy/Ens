// @exit 0
// @stdout same true
// @stdout differ false
// @stdout shorter false
// @stdout self true
// @stdout not-equal true
// @stdout nan false
// @stdout nested true
// @stdout nested-differ false
// @stdout words true
// @stdout absent true
// @stdout mixed false
// @stdout hash-equal true
// @stdout hash-differs true
// @stdout ints [1, 2, 3]
// @stdout empty []
// @stdout words ["a, b", "c\"d"]
// @stdout absent [1, null, 3]
// @stdout nested [[1], [2, 3]]
// @stdout points [{"x": 1}, {"x": 2}]
// @stdout row {"label": "r", "cells": [1, 2]}
// @stdout row-equal true
// @stdout row-hash true
// @stdout tree {"value": 1, "children": [{"value": 2, "children": []}]}
// @stdout tree-equal true
// @stdout tree-hash true
// An array compares, hashes, and formats by content, its elements rendering as struct
// serialization writes them.
public struct Point {
    public int x;
}

public struct Row {
    public string label;
    public int[] cells;
}

// A struct may hold an array of its own type: the array is a reference, so the layout is finite,
// and equality, hash, and the text form recurse through it.
public struct Node {
    public int value;
    public Node[] children;
}

main() -> int {
    int[] a = [1, 2, 3];
    int[] b = [1, 2, 3];
    int[] c = [1, 2, 4];
    int[] d = [1, 2];
    print("same {a == b}");
    print("differ {a == c}");
    print("shorter {a == d}");
    print("self {a == a}");
    print("not-equal {a != c}");

    double[] weird = [0.0 / 0.0];
    print("nan {weird == weird}");

    int[][] nested = [[1], [2, 3]];
    int[][] nestedSame = [[1], [2, 3]];
    int[][] nestedOther = [[1], [2, 4]];
    print("nested {nested == nestedSame}");
    print("nested-differ {nested == nestedOther}");

    string[] words = ["a, b", "c\"d"];
    string[] wordsSame = ["a, b", "c\"d"];
    print("words {words == wordsSame}");

    int?[] absent = [1, null, 3];
    int?[] absentSame = [1, null, 3];
    int?[] mixed = [1, 2, 3];
    print("absent {absent == absentSame}");
    print("mixed {absent == mixed}");

    print("hash-equal {a.hash() == b.hash()}");
    print("hash-differs {a.hash() != c.hash()}");

    print("ints {a}");
    int[] empty = [];
    print("empty {empty}");
    print("words {words}");
    print("absent {absent}");
    print("nested {nested}");
    Point[] points = [{x: 1}, {x: 2}];
    print("points {points}");

    Row row = {label: "r", cells: [1, 2]};
    Row rowSame = {label: "r", cells: [1, 2]};
    print("row {row}");
    print("row-equal {row == rowSame}");
    print("row-hash {row.hash() == rowSame.hash()}");

    Node leaf = {value: 2, children: []};
    Node root = {value: 1, children: [leaf]};
    Node sameLeaf = {value: 2, children: []};
    Node sameRoot = {value: 1, children: [sameLeaf]};
    print("tree {root}");
    print("tree-equal {root == sameRoot}");
    print("tree-hash {root.hash() == sameRoot.hash()}");
    return 0;
}
