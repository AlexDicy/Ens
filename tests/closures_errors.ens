// Every rule a function value holds a program to.
// @expect-error A lambda's parameters are always written in parentheses: use '(a) -> ...' rather than 'a -> ...'
// @expect-error This lambda has nothing to take its parameter and return types from. Declare what holds it with a function type, for example '(int, int) -> int compare = (a, b) -> a - b;'.
// @expect-error A lambda is a function value, and 'int' is not a function type. Declare the target as a function type such as '(int, int) -> int'.
// @expect-error This lambda takes 1 parameter, but '(int, int) -> int' takes 2 parameters. Write it as '(a, b) -> ...'.
// @expect-error This lambda writes the type of some parameters and not others. Write every type or none, for example '(int a, int b) -> a - b' or '(a, b) -> a - b'.
// @expect-error Parameter 'a' is declared 'long', but '(int, int) -> int' passes 'int' there. Write 'int a', or leave the type out.
// @expect-error This lambda's body produces 'string', but its type returns 'int'
// @expect-error This lambda returns 'int', but its body can reach the end without a 'return'. Add a 'return' on every path.
// @expect-error Duplicate parameter name 'a' in this lambda; rename one of the parameters.
// @expect-error Cannot assign a new value to 'total' inside a lambda: a lambda works on copies of what it captures, so the 'total' outside it would not change. Return the value the lambda computes and store it at the call site, or keep the value in an object the lambda can reach.
// @expect-error Cannot change 'total' inside a lambda: a lambda works on copies of what it captures, so the 'total' outside it would not change. Return the value the lambda computes and store it at the call site, or keep the value in an object the lambda can reach.
// @expect-error Cannot change 'outer' inside a lambda: a lambda works on copies of what it captures, so the 'outer' outside it would not change. Return the value the lambda computes and store it at the call site, or keep the value in an object the lambda can reach.
// @expect-error This lambda's body can throw 'Failure', and its target function type declares no 'throws' list. Add the type to the target's list, written after its return type as in '(() -> void throws IOError)', or move the throwing code into a named function that catches it with a 'catch' clause.
// @expect-error A lambda cannot capture 'this' here: 'Point' is a struct, so the lambda would work on a copy of it. Copy the fields the lambda needs into locals, or make 'Point' a class.
// @expect-error A function type has no parameter names, so a function value takes its arguments by position. Write the values in order, without 'a:'.
// @expect-error A function type has no parameter names, so a function value takes its arguments by position. Write the values in order, without 'a:'.
// @expect-error 'order' has type '(int, int) -> int', so the call takes 2 arguments, got 1.
// @expect-error 'maybe' has type '((int) -> int)?', which may be null here. Check it for null first ('if (maybe != null)'), or supply a fallback with '??'.
// @expect-error A function value has no identity, so '(int) -> int' and '(int) -> int' cannot be compared. Compare what the functions produce, or keep a name or tag beside each one and compare that.
// @expect-error A function value has no members, so 'hash' cannot be used on '(int) -> int'. Call the value with '(...)', or keep the data you need beside it.
// @expect-error A function value has no members, so 'toString' cannot be used on '(int) -> int'. Call the value with '(...)', or keep the data you need beside it.
// @expect-error A function value has no members, so 'name' cannot be used on '(int) -> int'. Call the value with '(...)', or keep the data you need beside it.
// @expect-error Cannot interpolate a value of type '(int) -> int': a function value has no text form. Interpolate what the function returns, or a name you keep beside it.
// @expect-error 'void' means no value, so it cannot be a parameter type. Write '() -> ...' for a function value that takes nothing.
// @expect-error Remove the parentheses around 'int'; in a type, only a function type takes them, as in '((int) -> bool)?'.
// @expect-error Remove the parentheses around '(int) -> int'; in a type, only a function type takes them, as in '((int) -> bool)?'.
// @expect-error Cannot assign value of type 'null' to variable of type '(int) -> bool?'. '(int) -> bool?' can never be null; write the type as '((int) -> bool?)?' if it should allow null.
// @expect-error build failed with 29 problems

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

mayFail(int value) -> int throws {
    if (value < 0) {
        throw new Failure("negative");
    }
    return value;
}

struct Point {
    int x;

    ownFields() -> (int) -> int {
        return (v) -> v + this.x;
    }
}

struct Inner {
    protected int x = 0;
}

struct Outer {
    protected Inner inner = {};
}

// The parentheses around a lambda's parameters are not optional.
unparenthesized() {
    (int) -> int twice = a -> a * 2;
}

noTarget() {
    let f = (a) -> a * 2;
}

notAFunctionType() {
    int f = (a) -> a;
}

wrongArity() {
    (int, int) -> int order = (a) -> a;
}

mixedParameterTypes() {
    (int, int) -> int order = (int a, b) -> a - b;
}

wrongParameterType() {
    (int, int) -> int order = (long a, int b) -> b;
}

wrongBodyType() {
    (int) -> int f = (a) -> "text";
}

missingReturn() {
    (int) -> int f = (a) -> {
        if (a > 0) {
            return a;
        }
    };
}

duplicateParameters() {
    (int, int) -> int order = (a, a) -> 0;
}

writesCapture() {
    long total = 0;
    (long) -> void add = (v) -> total = total + v;
}

incrementsCapture() {
    long total = 0;
    () -> void bump = () -> total++;
}

// A struct field lives in the value that holds it, so a write through a captured struct changes
// the copy the lambda holds. The refusal names the local at the root of the chain, however many
// fields the chain steps through.
writesCapturedStructField() {
    Outer outer = {};
    (int) -> int assign = (v) -> (outer.inner.x = v);
    (int) -> int compound = (v) -> (outer.inner.x += v);
    () -> int step = () -> (outer.inner.x++);
}

throwingBody() {
    (int) -> int f = (a) -> try mayFail(a);
}

namedArguments() {
    (int, int) -> int order = (a, b) -> a - b;
    print("{order(a: 1, b: 2)}");
}

wrongArgumentCount() {
    (int, int) -> int order = (a, b) -> a - b;
    print("{order(1)}");
}

callsNullable() {
    ((int) -> int)? maybe = null;
    print("{maybe(1)}");
}

comparesFunctions() {
    (int) -> int f = (a) -> a;
    (int) -> int g = (a) -> a;
    if (f == g) {
        print("same");
    }
}

readsHash() {
    (int) -> int f = (a) -> a;
    print("{f.hash()}");
}

readsToString() {
    (int) -> int f = (a) -> a;
    print(f.toString());
}

readsField() {
    (int) -> int f = (a) -> a;
    print("{f.name}");
}

interpolates() {
    (int) -> int f = (a) -> a;
    print("{f}");
}

voidParameter() {
    (void) -> int f = (a) -> 0;
}

// Parentheses in a type are the pair that lets a suffix apply to a function type, so they belong
// around nothing else: every other type keeps its plain spelling.
parenthesizedPlainType() {
    (int) count = 1;
    print("{count}");
}

parenthesizedFunctionTypeTwice() {
    (((int) -> int)) f = (a) -> a;
    print("{f(1)}");
}

// A '?' written after a function type belongs to its return type, so the hint for a function
// reference that should allow null names the parenthesized form rather than a second '?'.
nullableReference() {
    (int) -> bool? notNullable = null;
}

main() -> int {
    return 0;
}
