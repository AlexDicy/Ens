// Every rule a function value holds a program to.
// @expect-error A lambda's parameters are always written in parentheses. Write '(a) -> ...' instead of 'a -> ...'.
// @expect-error This lambda has no function type to give its result a type. Write it where a function type is declared, as in '(int) -> int f2 = (int a) -> a + 1;'.
// @expect-error Type 'int' has no field or method named 'missing'.
// @expect-error This lambda returns 'int', but a path through its body ends without a 'return'. Add a 'return' at the end of every path.
// @expect-error Parameter 'a' is declared twice in this lambda. Rename one of the two.
// @expect-error A function value has no members, so 'toString' cannot be used on '(int) -> int'. Call the value with '(...)', or keep the data you need beside it.
// @expect-error A function value has no members, so 'name' cannot be used on '(int) -> int'. Call the value with '(...)', or keep the data you need beside it.
// @expect-error A function type has no parameter names, so a function value takes its arguments by position. Write the values in order, without 'b:'.
// @expect-error build failed with 11 problems

// The parentheses around a lambda's parameters are not optional.
unparenthesized() {
    (int) -> int twice = a -> a * 2;
}

noTarget() {
    let f = (a) -> a * 2;
    let typed = (int a) -> a.missing();
    let steps = [(int a) -> a + 1];
}

missingReturn() {
    (int) -> int f = (a) -> {
        if (a > 0) {
            return a;
        }
    };
}

duplicateParameters() {
    (int, int) -> int order = (a, a) -> 0;
}

namedArguments() {
    (int, int) -> int order = (a, b) -> a - b;
    print("{order(a: 1, b: 2)}");
}

readsToString() {
    (int) -> int f = (a) -> a;
    print(f.toString());
}

readsField() {
    (int) -> int f = (a) -> a;
    print("{f.name}");
}

main() -> int {
    return 0;
}
