// @exit 0
// @stdout describe(Circle)
// @stdout describe(Circle)
// @stdout describe(Shape)
// @stdout clip(Circle)
// @stdout clip(Circle?)
// @stdout outline(Circle?)
// @stdout outline(Circle?)
// @stdout render(Circle)
// @stdout render(Shape)
// @stdout greet(Speaker)
// @stdout greet(Speaker?)
// @stdout put(T)
// @stdout put(Shape)
// @stdout put(Shape)
// @stdout put(T)
// @stdout make(T)
// @stdout make(Shape)
// @stdout wrap(Circle, int)
// @stdout fit(Shape, int)
// An overload whose parameter types are the other's, a subclass of them or them without '?' is
// chosen over it, ahead of fewer defaulted parameters but after how well the arguments fit, and
// on an instantiation that makes two parameter types the same, the one written without a type
// parameter is chosen. A value that never returns takes part as the others do.

interface Speaker {
    speak() -> string;
}

class Shape {
    constructor();
}

class Circle extends Shape implements Speaker {
    constructor() {
        super();
    }

    override speak() -> string {
        return "circle";
    }
}

class Square extends Circle {
    constructor() {
        super();
    }
}

describe(Shape shape) -> string {
    return "describe(Shape)";
}

describe(Circle circle) -> string {
    return "describe(Circle)";
}

clip(Circle circle) -> string {
    return "clip(Circle)";
}

clip(Circle? circle) -> string {
    return "clip(Circle?)";
}

outline(Shape? shape) -> string {
    return "outline(Shape?)";
}

outline(Circle? circle) -> string {
    return "outline(Circle?)";
}

greet(Speaker speaker) -> string {
    return "greet(Speaker)";
}

greet(Speaker? speaker) -> string {
    return "greet(Speaker?)";
}

wrap(Circle circle, int times = 1) -> string {
    return "wrap(Circle, int)";
}

wrap(Shape shape) -> string {
    return "wrap(Shape)";
}

fit(Circle circle, long amount = 1) -> string {
    return "fit(Circle, long)";
}

fit(Shape shape, int amount = 1) -> string {
    return "fit(Shape, int)";
}

stop(Shape shape) -> int {
    return 0;
}

stop(Circle circle) -> string {
    return "stop(Circle)";
}

never() -> string {
    return stop(panic("never called"));
}

interface Renderer {
    render(Shape shape) -> string;

    render(Circle circle) -> string;
}

class Canvas implements Renderer {
    constructor();

    override render(Shape shape) -> string {
        return "render(Shape)";
    }

    override render(Circle circle) -> string {
        return "render(Circle)";
    }
}

class Box<T> {
    constructor();

    put(T value) -> string {
        return "put(T)";
    }

    put(Shape value) -> string {
        return "put(Shape)";
    }

    store(T value) -> string {
        return this.put(value);
    }

    static make(T value) -> string {
        return "make(T)";
    }

    static make(Shape value) -> string {
        return "make(Shape)";
    }
}

main() -> int {
    let circle = new Circle();
    let square = new Square();
    Shape held = new Circle();
    print(describe(circle));
    print(describe(square));
    print(describe(held));
    print(clip(square));
    print(clip(null));
    print(outline(square));
    print(outline(null));
    Renderer renderer = new Canvas();
    print(renderer.render(square));
    print(renderer.render(held));
    Speaker speaker = circle;
    print(greet(speaker));
    print(greet(null));
    print(new Box<Circle>().put(square));
    print(new Box<Shape>().put(square));
    print(new Box<Shape>().put(held));
    print(new Box<Circle>().store(circle));
    print(Box<Circle>.make(square));
    print(Box<Shape>.make(square));
    print(wrap(square));
    print(fit(square, 1));
    return 0;
}
