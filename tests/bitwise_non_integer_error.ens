// @expect-error '&' needs integers on both sides, got 'double' and 'int'
// Bits belong to integers, so a floating-point operand is refused by name rather than being
// reported as a type mismatch that a cast between the two could fix.
main() -> int {
    double scale = 2.5;
    let masked = scale & 1;
    return masked as int;
}
