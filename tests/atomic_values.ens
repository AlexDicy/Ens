// @exit 0
// @stdout 7 400000.5 true true false
// @stdout written 99999 written 99999
// @stdout 10 9
// Four threads change one Atomic of each kind at once and nothing they write is lost: an integer
// counted by one atomic add, a double through the compare-and-set loop, a 'bool', and references
// that are read while other threads replace and release them.
import Atomic from @std.tasks;

external type NativeThread;

external from libc {
    ens_thread_start((() -> void) body, out int error) -> NativeThread?;
    ens_thread_join(NativeThread thread);
}

shared final class Label {
    const string text;

    constructor(this.text);
}

main() -> int {
    let hits = new Atomic<long>(0);
    let ratio = new Atomic<double>(0.5);
    let flag = new Atomic<bool>(false);
    let name = new Atomic<string>("start");
    let label = new Atomic<Label?>(null);
    let threads = new NativeThread?[4];
    for (long t = 0; t < 4; t++) {
        int error = 0;
        threads[t] = ens_thread_start(() -> {
            for (long i = 0; i < 100000; i++) {
                hits.increment();
                ratio.add(1.0);
                name.write("written {i}");
                let current = name.read();
                label.write(new Label(current));
            }
            flag.write(true);
        }, out error);
    }
    for (long t = 0; t < 4; t++) {
        let thread = threads[t];
        if (thread != null) {
            ens_thread_join(thread);
        }
    }
    bool swapped = hits.compareAndSet(400000, 7);
    bool refused = hits.compareAndSet(400000, 9);
    print("{hits.read()} {ratio.read()} {flag.read()} {swapped} {refused}");
    print("{name.read()} {label.read()?.text ?? "none"}");
    print("{hits.add(3)} {hits.decrement()}");
    return 0;
}
