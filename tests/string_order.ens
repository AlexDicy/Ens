// @exit 0
// @stdout apple before banana: -1
// @stdout banana after apple: 1
// @stdout equal: 0
// @stdout prefix sorts first: -1
// @stdout built equal: 0
// @stdout case matters: 1
// @stdout empty first: -1
// @stdout high byte last: -1
// @stdout sorted: ada, bob, bob, cleo, dan
// @stdout sorted empty and one: ok
// Happy-path coverage for string ordering: compareTo over equal, ordered,
// prefix, empty and non-ASCII operands, and the natural-order List<string> sort
// from @std.collections.sorting, which is built on compareTo.
import List from @std.collections.list;
import @std.collections.sorting;

main() -> int {
    print("apple before banana: {"apple".compareTo("banana")}");
    print("banana after apple: {"banana".compareTo("apple")}");
    print("equal: {"apple".compareTo("apple")}");
    print("prefix sorts first: {"app".compareTo("apple")}");
    let built = "ap" + "ple";
    print("built equal: {built.compareTo("apple")}");
    print("case matters: {"a".compareTo("A")}");
    print("empty first: {"".compareTo("a")}");
    print("high byte last: {"a".compareTo("é")}");

    let names = new List<string>();
    names.push("cleo");
    names.push("bob");
    names.push("dan");
    names.push("ada");
    names.push("bob");
    sorting.sort(names);
    string joined = "";
    for (long i = 0; i < names.length(); i++) {
        if (i > 0) {
            joined = joined + ", ";
        }
        joined = joined + names.get(i);
    }
    print("sorted: " + joined);

    let empty = new List<string>();
    sorting.sort(empty);
    let single = new List<string>();
    single.push("only");
    sorting.sort(single);
    if (empty.length() == 0 && single.get(0) == "only") {
        print("sorted empty and one: ok");
    }
    return 0;
}
