// @exit 0
// @stdout copied field
// @stdout released field
// @stdout field gone
// @stdout replaced
// @stdout released first
// @stdout released second
// @stdout replacement gone
// @stdout narrowed narrow
// @stdout still narrow
// @stdout released narrow
// @stdout narrow gone
// @stdout inline field inline
// @stdout inline method inline
// @stdout released inline
// @stdout inline gone
// @stdout stored field stored
// @stdout stored swapped swapped
// @stdout released stored
// @stdout released swapped
// @stdout stored gone
// @stdout none is null
// @stdout last fallback
// @stdout released fallback
// @stdout null routes done
// @stdout chose left
// @stdout released right
// @stdout released left
// @stdout ternary done
// @stdout coalesced kept
// @stdout safe kept
// @stdout released unused
// @stdout released kept
// @stdout optional operators done
// @stdout safe call call
// @stdout safe member member
// @stdout shown void
// @stdout released void
// @stdout released member
// @stdout released call
// @stdout produced routes done
// @stdout nested nested
// @stdout picked nested
// @stdout picked missing
// @stdout released nested
// @stdout nested gone
// @stdout made made made
// @stdout released made
// @stdout made gone
// @stdout either second
// @stdout maybe first
// @stdout maybe missing
// @stdout released second
// @stdout released first
// @stdout returned routes done
// A tagged optional of a struct keeps its payload's references across every borrowed route, and
// reaching into the narrowed name lands in the payload rather than at the base of the
// {present, value} pair. A '?.' on an optional a call produces releases what its payload holds
// once, however the access went. A struct or optional returned from one place or from several
// hands its caller what it holds once, whether or not the call was copied into the caller. Each
// Probe reports its own release, so a missed retain frees early and a missed release never
// reports at all.
class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }
}

struct Cell {
    protected Probe probe;

    protected name() -> string {
        return this.probe.label;
    }

    protected show() {
        print("shown " + this.probe.label);
    }
}

class Holder {
    protected Cell? cell;

    protected constructor(this.cell);

    protected replace(Cell? incoming) {
        this.cell = incoming;
    }

    protected direct() -> string {
        let cell = this.cell;
        if (cell != null) {
            return cell.name();
        }
        return "absent";
    }

    // A field never narrows, so the struct is copied out, changed, and stored back.
    protected relabel(string label) {
        let cell = this.cell;
        if (cell != null) {
            cell.probe = new Probe(label);
            this.cell = cell;
        }
    }
}

chosenOf(bool flag, Cell a, Cell b) -> Cell {
    return flag ? a : b;
}

produced(string label) -> Cell? {
    return {probe: new Probe(label)};
}

none() -> Cell? {
    return null;
}

lastOf(Cell? cell) -> Cell {
    if (cell == null) {
        return {probe: new Probe("fallback")};
    }
    return cell;
}

text() -> string?? {
    return "a";
}

nestedOf(Probe probe) -> Probe?? {
    return probe;
}

pickedOf(bool first, Probe probe) -> Probe?? {
    if (first) {
        return probe;
    }
    return null;
}

madeOf(Probe probe) -> Cell {
    return {probe: probe};
}

copiedOf(Cell cell) -> Cell {
    return cell;
}

eitherOf(bool first, Cell a, Cell b) -> Cell {
    if (first) {
        return a;
    }
    return b;
}

maybeOf(bool present, Cell cell) -> Cell? {
    if (present) {
        return cell;
    }
    return null;
}

main() -> int {
    {
        let holder = new Holder({probe: new Probe("field")});
        Cell? copied = holder.cell;
        if (copied != null) {
            Cell present = copied;
            print("copied " + present.name());
        }
    }
    print("field gone");

    {
        let holder = new Holder({probe: new Probe("first")});
        Cell? incoming = {probe: new Probe("second")};
        holder.replace(incoming);
        print("replaced");
    }
    print("replacement gone");

    {
        Cell? cell = {probe: new Probe("narrow")};
        if (cell != null) {
            Cell present = cell;
            print("narrowed " + present.name());
        }
        print("still " + lastOf(cell).name());
    }
    print("narrow gone");

    {
        Cell? cell = {probe: new Probe("inline")};
        if (cell != null) {
            print("inline field " + cell.probe.label);
            print("inline method " + cell.name());
        }
    }
    print("inline gone");

    {
        let holder = new Holder({probe: new Probe("stored")});
        print("stored field " + holder.direct());
        holder.relabel("swapped");
        print("stored swapped " + holder.direct());
    }
    print("stored gone");

    {
        Cell? empty = null;
        empty = null;
        if (none() == null) {
            print("none is null");
        }
        print("last " + lastOf(null).name());
    }
    print("null routes done");

    {
        Cell left = {probe: new Probe("left")};
        Cell right = {probe: new Probe("right")};
        Cell chosen = chosenOf(true, left, right);
        print("chose " + chosen.name());
    }
    print("ternary done");

    {
        Cell? maybe = {probe: new Probe("kept")};
        Cell fallback = {probe: new Probe("unused")};
        Cell chosen = maybe ?? fallback;
        print("coalesced " + chosen.name());
        print("safe " + (maybe?.name() ?? "missing"));
    }
    print("optional operators done");

    {
        print("safe call " + (produced("call")?.name() ?? "missing"));
        Probe? member = produced("member")?.probe;
        print("safe member " + (member?.label ?? "missing"));
        produced("void")?.show();
    }
    print("produced routes done");

    string? inner = text() ?? null;
    if (inner == null) {
        return 1;
    }

    {
        let probe = new Probe("nested");
        Probe? unwrapped = nestedOf(probe) ?? null;
        print("nested " + (unwrapped?.label ?? "missing"));
        for (int i = 0; i < 2; i++) {
            Probe? picked = pickedOf(i == 0, probe) ?? null;
            print("picked " + (picked?.label ?? "missing"));
        }
    }
    print("nested gone");

    {
        Cell made = madeOf(new Probe("made"));
        Cell copied = copiedOf(made);
        print("made " + made.name() + " " + copied.name());
    }
    print("made gone");

    {
        Cell first = {probe: new Probe("first")};
        Cell second = {probe: new Probe("second")};
        Cell either = eitherOf(false, first, second);
        print("either " + either.name());
        for (int i = 0; i < 2; i++) {
            Cell? maybe = maybeOf(i == 0, first);
            print("maybe " + (maybe?.name() ?? "missing"));
        }
    }
    print("returned routes done");
    return 0;
}
