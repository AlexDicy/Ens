// @expect-error A value of type 'Rock' is never a 'Speaker': 'Rock' does not implement 'Speaker', and because it is 'final', no class extends it. This 'is' test is always false.
// @expect-error build failed with 1 problem
interface Speaker {
    speak() -> string;
}

final class Rock {
    protected constructor();
}

main() -> int {
    Rock r = new Rock();
    if (r is Speaker) {
        return 1;
    }
    return 0;
}
