// @expect-error A value of type 'Rock' can never be of type 'Speaker', because 'Rock' is 'final' and does not implement 'Speaker'. This 'is' test is always false. Remove it.
interface Speaker {
    speak() -> string;
}

final class Rock {
    protected constructor();
}

main() -> int {
    Rock r = new Rock();
    if (r is Speaker) {
        return 1;
    }
    return 0;
}
