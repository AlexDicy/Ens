// @exit 0
// @stdout parser: checked
// @stdout checker: checked
// @stdout parser tag int
// @stdout parser tag string
// @stdout checker tag
// Two sibling modules each export a public `checkProgram` with the same name
// and signature, which used to collide at link time under a bare source name.
// Each free function now links under its module-qualified name, so both are
// emitted and each call resolves to its own module's definition. The `tag`
// family adds a same-name/different-signature pair across modules plus an
// overload set within one module, proving the module qualifier composes with
// the overload suffix.
import lib.parser;
import lib.checker;

main() -> int {
    print(parser.checkProgram());
    print(checker.checkProgram());
    print(parser.tag(1));
    print(parser.tag("x"));
    print(checker.tag());
    return 0;
}
