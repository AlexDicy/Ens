// @exit 0
// @stdout parser: checked
// @stdout checker: checked
// @stdout parser tag int
// @stdout parser tag string
// @stdout checker tag
// Two sibling modules each export a public `checkProgram` with the same name and signature, which
// used to collide at link time under a bare source name. Each links under its module-qualified
// name now, and the `tag` family shows the qualifier composing with the overload suffix.
import lib.parser;
import lib.checker;

main() -> int {
    print(parser.checkProgram());
    print(checker.checkProgram());
    print(parser.tag(1));
    print(parser.tag("x"));
    print(checker.tag());
    return 0;
}
