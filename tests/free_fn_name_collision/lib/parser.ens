// Exports a public `checkProgram` sharing its name and signature with a
// same-named public function in the sibling `checker` module, plus an
// overloaded `tag` so the module qualifier composes with the overload suffix.
public checkProgram() -> string {
    return "parser: checked";
}

public tag(int n) -> string {
    return "parser tag int";
}

public tag(string s) -> string {
    return "parser tag string";
}
