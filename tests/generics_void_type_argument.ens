// @exit 0
// @stdout ran
// @stdout ran
// @stdout held 1
// @stdout tag 3
// @stdout present true
// @stdout absent false
// @stdout seven 7
// @stdout relayed 1
// @stdout one
// @stdout same true false
// @stdout text {"right": 1}
// @stdout hashed true
// @stdout first made
// A function that returns nothing binds a type parameter to 'void', and 'void' can be written as a
// type argument too. A value of type 'void' takes no storage: a local, a field, a parameter or a
// capture of that type holds nothing, a result of that type is no result, and a 'T?' over it is
// present or absent. A field of type 'void' takes no part in a struct's '==', its hash or its JSON.
import List from @std.collections.list;

apply<T>((() -> T) work) -> T {
    return work();
}

final class Holder<T> {
    T held;
    long count;

    constructor(this.held) {
        this.count = 1;
    }

    get() -> T {
        return this.held;
    }
}

struct Slot<T> {
    T value;
    int tag;
}

keep<T>((() -> T) work) -> Holder<T> {
    T value = work();
    return new Holder<T>(value);
}

maybe<T>(bool present, (() -> T) work) -> T? {
    if (present) {
        return work();
    }
    return null;
}

consume<T>(T value) -> int {
    return 1;
}

relay<T>((() -> T) work) -> int {
    T value = work();
    () -> T again = () -> value;
    again();
    return consume(value);
}

choose<T>(bool first, (() -> T) one, (() -> T) two) -> T {
    return first ? one() : two();
}

struct Pair<T> {
    T left;
    int right;
}

same<T>(Pair<T> a, Pair<T> b) -> bool {
    return a == b;
}

firstOf<T>(List<() -> T> makers) -> T {
    return makers.get(0)();
}

ran() {
    print("ran");
}

main() -> int {
    apply(() -> ran());
    let holder = keep<void>(() -> ran());
    holder.get();
    print("held {holder.count}");
    Slot<void> slot = {tag: 3};
    print("tag {slot.tag}");
    print("present {maybe(true, () -> {}) != null}");
    print("absent {maybe(false, () -> {}) != null}");
    print("seven {apply(() -> 7)}");
    print("relayed {relay(() -> {})}");
    choose(true, () -> print("one"), () -> print("two"));
    Pair<void> a = {right: 1};
    Pair<void> b = {right: 1};
    Pair<void> c = {right: 2};
    print("same {same(a, b)} {same(a, c)}");
    print("text {a}");
    print("hashed {a.hash() == b.hash()}");
    let makers = new List<() -> void>();
    makers.push(() -> print("first made"));
    firstOf(makers);
    return 0;
}
