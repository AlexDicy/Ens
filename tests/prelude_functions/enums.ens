// A module that declares 'describe' as an enum: its members read through the enum's own name,
// while 'greeting', which this file does not declare, still comes from the prelude.
enum describe {
    Alpha,
    Beta,
}

public class Holder {
    // A static of the enclosing type does not claim a bare name: a static is only ever reached
    // through the type name, so the prelude's 'greeting' answers the call below exactly as a
    // function of this module would.
    static greeting() -> string {
        return "static";
    }

    public static use() -> string {
        return greeting("static owner");
    }
}

public member() -> string {
    let chosen = describe.Alpha;
    return "enum {chosen}";
}

public stillPrelude() -> string {
    return greeting("enum module");
}

public throughStaticOwner() -> string {
    return Holder.use();
}
