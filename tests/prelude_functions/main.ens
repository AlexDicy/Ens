// @stdlib ../prelude_stdlib
// The prelude: the implicitly imported '@std.core' exports functions, and every module of a
// program calls them unqualified with no import written. Overloads among them resolve by the
// ordinary rules, the same functions stay reachable through an explicit import, a default argument
// another module owns is filled through the prelude too, and a module that declares the name itself
// keeps it, whether it declares a function, a struct, a class, or an enum.
// @stdout hello, world
// @stdout hello, world!
// @stdout text of 3 bytes
// @stdout count 7
// @stdout hello, deep
// @stdout hello, class!
// @stdout method
// @stdout filled / hello, default
// @stdout flag true
// @stdout struct value 5
// @stdout described up to 4
// @stdout hello, claims
// @stdout enum Alpha
// @stdout hello, enum module
// @stdout hello, static owner
// @stdout hello, qualified
// @exit 0
import @std.core;
import Reporter from deep;
import claims;
import deep;
import enums;

main() -> int {
    print(greeting("world"));
    print(shout("world"));
    print(describe("abc"));
    print(describe(7L));
    print(deep.fromAnotherModule());
    let reporter = new Reporter("class");
    print(reporter.report());
    print(reporter.shout());
    print(deep.labeled("filled"));
    print(deep.shadowed());
    print(claims.constructed());
    print(claims.statics());
    print(claims.qualified());
    print(enums.member());
    print(enums.stillPrelude());
    print(enums.throughStaticOwner());
    print(core.greeting("qualified"));
    if (doubled(21L) != 42L) {
        return 1;
    }
    return 0;
}
