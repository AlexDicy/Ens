// A second module of the same program: the prelude reaches every module and every scope inside
// one, and what this file declares itself is what its own calls mean.
public fromAnotherModule() -> string {
    return greeting("deep");
}

public class Reporter {
    public string subject;

    public constructor(this.subject);

    // A method sharing a prelude function's name claims nothing: a bare call is never a method
    // call in Ens, so the call in 'report' is the prelude's 'shout'.
    public shout() -> string {
        return "method";
    }

    public report() -> string {
        return shout(this.subject);
    }
}

// A default this module owns: the argument the caller leaves out is filled from here, so the
// prelude has to reach the default expression as well.
public labeled(string text, string mark = greeting("default")) -> string {
    return text + " / " + mark;
}

public describe(bool flag) -> string {
    return "flag {flag}";
}

public shadowed() -> string {
    return describe(true);
}
