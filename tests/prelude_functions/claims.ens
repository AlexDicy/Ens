// A module whose own type declarations carry names the prelude also exports. What this file
// declares wins, and the prelude's functions of those names stay reachable through a written
// import.
import @std.core;

public struct greeting {
    public long value;

    public constructor(this.value);
}

public class describe {
    public static const long limit = 4;

    public static tag() -> string {
        return "described";
    }
}

public constructed() -> string {
    let made = greeting(5L);
    return "struct value {made.value}";
}

public statics() -> string {
    return "{describe.tag()} up to {describe.limit}";
}

public qualified() -> string {
    return core.greeting("claims");
}
