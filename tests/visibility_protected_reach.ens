// @exit 9
// A protected member's leakage floor is the widest scope its class can be
// subclassed from: a final export class and a file-private open class both keep
// the file floor, so their protected members may mention file-private types.
class Secret {
    protected constructor();

    protected size() -> int {
        return 9;
    }
}

export final class Wrapper {
    Secret inner;

    protected constructor(this.inner);

    export size() -> int {
        return this.inner.size();
    }
}

class HiddenError extends Error {
    protected constructor() {
        super("hidden");
    }
}

class Open {
    protected Secret held;

    protected constructor(this.held);

    protected poke() throws HiddenError {
        throw new HiddenError();
    }
}

main() -> int {
    let wrapper = new Wrapper(new Secret());
    let opened = new Open(new Secret());
    return wrapper.size();
}
