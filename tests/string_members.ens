// @stdout empty: true false
// @stdout search: 2 3 -1 4 true
// @stdout edges: true false true false
// @stdout part: el llo hello
// @stdout trimmed: [in the middle] [left] [right]
// @stdout rewritten: a+b+c ababab ac
// @stdout padded: 007 7.. wide 00ff
// @stdout split: [a|b|c] [a||b] [one] []
// @stdout lines: [first|second] [first|second] [ends|]
// @stdout case: mixed 1! MIXED 1! éÉ true
// @stdout order: -1 1 0 true
// @stdout bytes: 2 104 105 hé
// @stdout characters: h é € 😀
// @stdout joined: a, b, c one
// @stdout lossy: a?b 5
// @exit 0
// Every member of 'string' as a whole program sees it, including the composition the design points
// at for width: text padded to a width through padStart rather than through a width argument.
import StringBuilder from @std.text.stringbuilder;

main() -> int {
    print("empty: {"".isEmpty()} {"x".isEmpty()}");
    print("search: {"hello".indexOf("l")} {"hello".indexOf("lo")} {"hello".indexOf("z")} "
        + "{"hello".lastIndexOf("o")} {"hello".contains("ell")}");
    print("edges: {"hello".startsWith("he")} {"hello".startsWith("je")} "
        + "{"hello".endsWith("lo")} {"hello".endsWith("hello!")}");
    print("part: {"hello".substring(1, 3)} {"hello".substring(2)} {"hello".substring(0)}");
    print("trimmed: [{"  in the middle  ".trim()}] [{"  left".trimStart()}] "
        + "[{"right  ".trimEnd()}]");
    print("rewritten: {"a-b-c".replace("-", "+")} {"ab".repeat(3)} {"abc".replace("b", "")}");
    print("padded: {"7".padStart(3, '0')} {"7".padEnd(3, '.')} {"wide".padStart(2, '0')} "
        + "{"ff".padStart(4, '0')}");
    print("split: [{string.joined("a,b,c".split(","), "|")}] "
        + "[{string.joined("a,,b".split(","), "|")}] "
        + "[{string.joined("one".split(","), "|")}] [{string.joined("".split(","), "|")}]");
    print("lines: [{string.joined("first\nsecond".lines(), "|")}] "
        + "[{string.joined("first\r\nsecond".lines(), "|")}] "
        + "[{string.joined("ends\n".lines(), "|")}]");
    print("case: {"Mixed 1!".toLowerAscii()} {"Mixed 1!".toUpperAscii()} "
        + "{"éÉ".toUpperAscii()} {"Hello".equalsIgnoreCaseAscii("hELLO")}");
    print("order: {"a".compareTo("b")} {"b".compareTo("a")} {"a".compareTo("a")} "
        + "{"ab".compareTo("abc") < 0}");
    byte[] raw = "hi".toBytes();
    print("bytes: {raw.length} {raw[0]} {raw[1]} {string.fromBytesLossy("hé".toBytes())}");
    let shown = new StringBuilder();
    for (let character in "hé€😀".chars()) {
        if (!shown.isEmpty()) {
            shown.append(" ");
        }
        shown.append(character);
    }
    print("characters: {shown.toString()}");
    print("joined: {string.joined(["a", "b", "c"], ", ")} {string.joined(["one"], ", ")}");
    byte[] broken = [0x61, 0xFF, 0x62];
    string replaced = string.fromBytesLossy(broken);
    print("lossy: {replaced.replace("\uFFFD", "?")} {replaced.length}");
    return 0;
}
