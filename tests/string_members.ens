// @stdout order: -1 1 0 true
// @stdout lossy: a?b 5
// @exit 0
// The exact values a string comparison returns, and the replacement character a lossy reading
// writes, matched by its escape in a literal.
main() -> int {
    print("order: {"a".compareTo("b")} {"b".compareTo("a")} {"a".compareTo("a")} "
        + "{"ab".compareTo("abc") < 0}");
    byte[] broken = [0x61, 0xFF, 0x62];
    string replaced = string.fromBytesLossy(broken);
    print("lossy: {replaced.replace("�", "?")} {replaced.length}");
    return 0;
}
