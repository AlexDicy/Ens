// @expect-error Method 'toString' overrides the built-in text form of struct 'Label'; mark it 'override'
// A struct already renders as its JSON form, so a struct's own 'toString' replaces a
// behavior the language provides and is written with 'override', exactly like a class's
// 'hash' and 'equals'.

public struct Label {
    int x;

    public toString() -> string {
        return "Label({this.x})";
    }
}

main() -> int {
    Label label = {x: 1};
    print("{label}");
    return 0;
}
