// @exit 0
// @stdout get a
// @stdout contains equal-key
// @stdout miss absent-key
// @stdout overwrite c
// @stdout set dedup 2
// @stdout set contains
// @stdout declared get one
// @stdout declared miss
// @stdout declared dedup 1

// A struct as a Map and Set key: lookups use a freshly built key equal by content
// (not by identity), which proves struct '==' and struct hash() agree on content.
// A struct that declared its own pair is keyed by what that pair says instead, so a
// field the pair ignores does not change which entry a key finds.

import Map from @std.collections.map;
import Set from @std.collections.set;

struct Coord {
    protected int row;
    protected int col;
}

struct Label {
    protected int id;
    protected string note;

    override hash() -> long {
        return this.id;
    }

    override equals(Label other) -> bool {
        return this.id == other.id;
    }
}

main() -> int {
    let grid = new Map<Coord, string>();
    grid.set({row: 2, col: 3}, "a");
    grid.set({row: 5, col: 8}, "b");

    Coord probe = {row: 2, col: 3};
    let found = grid.get(probe);
    if (found != null) { print("get {found}"); }
    if (grid.contains({row: 5, col: 8})) { print("contains equal-key"); }
    if (!grid.contains({row: 9, col: 9})) { print("miss absent-key"); }

    grid.set({row: 2, col: 3}, "c");
    let updated = grid.get({row: 2, col: 3});
    if (updated != null) { print("overwrite {updated}"); }

    let seen = new Set<Coord>();
    seen.add({row: 0, col: 0});
    seen.add({row: 0, col: 0});
    seen.add({row: 1, col: 1});
    print("set dedup {seen.length()}");
    if (seen.contains({row: 1, col: 1})) { print("set contains"); }

    let labels = new Map<Label, string>();
    labels.set({id: 1, note: "first"}, "one");
    let byIgnoredField = labels.get({id: 1, note: "different"});
    if (byIgnoredField != null) { print("declared get {byIgnoredField}"); }
    if (!labels.contains({id: 2, note: "first"})) { print("declared miss"); }

    let tags = new Set<Label>();
    tags.add({id: 3, note: "a"});
    tags.add({id: 3, note: "b"});
    print("declared dedup {tags.length()}");

    return 0;
}
