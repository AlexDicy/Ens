// @exit 42
// A 'char' keeps every integer use it had: it adapts to integer targets, drives the bitwise and
// shift operators, and takes the complement. Only the drift into a floating-point type is gone,
// and a cast still names the type where the code point's number is what the program wants.
takesDouble(double v) -> double {
    return v;
}

main() -> int {
    // Integer targets are untouched.
    int asInteger = 'A';
    long wide = 'A';
    byte narrow = 'A';
    if (asInteger != 65)                    { return 1; }
    if (wide != 65L)                        { return 2; }
    if ((narrow as int) != 65)              { return 3; }

    // The bitwise and shift operators, and the complement, all still take a 'char'.
    char letter = 'a';
    if ((letter & 'a') != 'a')              { return 4; }
    if ((letter | 0x20) != 'a')             { return 5; }
    if (((letter >> 1) as int) != 48)       { return 6; }
    if (((~letter) as long) != 0xFFFFFF9E)  { return 7; }

    // A cast is how the code point's number reaches a floating-point type.
    double viaCast = 'A' as double;
    float narrowCast = 'A' as float;
    double fromVariable = letter as double;
    if (viaCast != 65.0)                    { return 8; }
    if (narrowCast != 65.0)                 { return 9; }
    if (fromVariable != 97.0)               { return 10; }
    if (takesDouble('A' as double) != 65.0) { return 11; }

    // The cast reaches integer types the same way it always did.
    if (('A' as int) != 65)                 { return 12; }

    return 42;
}
