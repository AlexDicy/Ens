// @expect-error '&' needs the same integer type on both sides, but 'flags' has type 'uint' and 'width' has type 'int'. Convert both sides to 'long', as in 'flags as long & width as long'.
// Adaptation reaches an untyped literal only. Two named integer types of different widths
// still need a cast, so the difference stays visible where a value could be truncated.
main() -> int {
    uint flags = 0x12345678;
    int width = 255;
    let low = flags & width;
    return low as int;
}
