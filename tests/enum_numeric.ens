// @exit 13
// @stdout 1 2 13 | long 13
// @stdout EACCES EACCES null 1
// @stdout Low Zero One Big
// @stdout -2 -1 0 100
// @stdout none One
// @stdout plain Run run true
// @stdout {"code": "EACCES", "retries": 2}
// A numeric enum assigns explicit integer values; unvalued members continue previous + 1, and
// values may be negative or sparse. A plain enum keeps its today's-enum behavior.
enum Errno {
    EPERM = 1,
    ENOENT,
    EACCES = 13,
}

enum Flags {
    Low = -2,
    Zero,
    One,
    Big = 100,
}

enum Command {
    Initialize,
    Run,
    Stop,
}

struct Result {
    Errno code;
    int retries;
}

name(Flags f) -> string {
    return switch (f) {
        Flags.Low -> "Low",
        Flags.Zero -> "Zero",
        Flags.One -> "One",
        Flags.Big -> "Big",
    };
}

main() -> int {
    // Assigned value, continuation, and sparse value read out as integers.
    print("{Errno.EPERM as int} {Errno.ENOENT as int} {Errno.EACCES as int}"
        + " | long {Errno.EACCES as long}");

    // Checked conversion from an integer: the matching member, or null on a miss.
    let hit = 13 as? Errno;
    let miss = 7 as? Errno;
    string hitName = "none";
    if (hit != null) {
        hitName = "{hit}";
    }
    string missText = "null";
    if (miss != null) {
        missText = "{miss}";
    }
    print("{hit ?? Errno.EPERM} {hitName} {missText} {Errno.EPERM as int}");

    // Text form is the member name; switch matches by member over sparse/negative values.
    print("{name(Flags.Low)} {name(Flags.Zero)} {name(Flags.One)} {name(Flags.Big)}");
    print("{Flags.Low as int} {Flags.Zero as int} {Flags.One as int} {Flags.Big as int}");

    // '??' composition and '==' identity, still by member.
    let maybe = 0 as? Flags;
    string outcome = "none";
    if (maybe == Flags.Zero) {
        outcome = "hit";
    }
    print("{outcome} {maybe ?? Flags.One}");

    // A plain enum stays fully functional: switch, interpolation, ==, and equality.
    let c = Command.Run;
    string label = "other";
    switch (c) {
        Command.Initialize -> {
            label = "init";
        },
        Command.Run -> {
            label = "run";
        },
        Command.Stop -> {
            label = "stop";
        },
    }
    bool same = c == Command.Run;
    print("plain {c} {label} {same}");

    // A numeric enum field serializes to JSON as its member name.
    Result r = {code: Errno.EACCES, retries: 2};
    print("{r}");

    return Errno.EACCES as int;
}
