// @expect-error In 'Box<Cell>': An array of non-nullable 'Cell' must be filled as it is created
// @expect-error In 'Box<Pair>': Cannot use 'Pair' as an array element type because freshly-allocated slots would not be valid values of 'Pair'. Field 'key' of 'Pair' is 'const' with no default value
// @expect-error build failed with 2 problems
// 'new T[n]' in a generic body defers the element check, because whether a freshly allocated slot
// is a valid value depends on the argument. Each instantiation that occurs is judged and named,
// and the proven fill loop is exempt, which is what 'filled' below relies on.
public class Cell {
    public constructor() {
    }
}

public struct Pair {
    const int key;
    const int value;
}

public class Box<T> {
    T[] items;

    public constructor(long size) {
        this.items = new T[size];
    }

    public first() -> T {
        return this.items[0];
    }
}

filled<T>(T value, long size) -> T[] {
    T[] slots = new T[size];
    for (long i = 0; i < slots.length; i++) {
        slots[i] = value;
    }
    return slots;
}

main() -> int {
    let cells = new Box<Cell>(2);
    let pairs = new Box<Pair>(2);
    let sound = filled<Cell>(new Cell(), 2);
    return sound.length as int;
}
