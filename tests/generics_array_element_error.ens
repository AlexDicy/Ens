// @expect-error 'Box<Cell>' cannot use 'Cell' as an array element type because a new array's slots start as a zero, which is not a valid 'Cell'. Pass a type argument that makes the element type nullable, so a slot can start as null.
// @expect-error 'Box<Pair>' cannot use 'Pair' as an array element type because a new array's slots start as a zero, which is not a valid 'Pair'. Field 'key' of 'Pair' is 'const' with no default value
// @expect-note 'Box<T>' creates an array of 'T' here
// @expect-error build failed with 2 problems
// 'new T[n]' in a generic body defers the element check, because whether a freshly allocated slot
// is a valid value depends on the argument. Each instantiation that occurs is judged at the line
// that wrote it, with the allocation as a note, and the proven fill loop is exempt, which is what
// 'filled' below relies on.
public class Cell {
    public constructor() {
    }
}

public struct Pair {
    const int key;
    const int value;
}

public class Box<T> {
    T[] items;

    public constructor(long size) {
        this.items = new T[size];
    }

    public first() -> T {
        return this.items[0];
    }
}

filled<T>(T value, long size) -> T[] {
    T[] slots = new T[size];
    for (long i = 0; i < slots.length; i++) {
        slots[i] = value;
    }
    return slots;
}

main() -> int {
    let cells = new Box<Cell>(2);
    let pairs = new Box<Pair>(2);
    let sound = filled<Cell>(new Cell(), 2);
    return sound.length as int;
}
