// @stdout integer: long
// @stdout fractional: double
// @stdout typed: double
// @exit 0
// An untyped integer literal takes the integer overload wherever both exist, because the integers
// are its own family; a literal with a fractional part takes the floating-point one, and a value
// that is already a double takes it however it was spelled.
pick(long value) -> string {
    return "long";
}

pick(double value) -> string {
    return "double";
}

main() -> int {
    print("integer: {pick(5)}");
    print("fractional: {pick(5.5)}");
    double already = 5.0;
    print("typed: {pick(already)}");
    return 0;
}
