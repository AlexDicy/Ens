// @exit 0
// @stdout literal a!
// @stdout later b!
// @stdout held c!
// @stdout nested d!
// A default may read the fields declared before it. A struct literal assigns the fields it lists
// before it computes the defaults of the others, so a default can read a field that has no default
// of its own, and storage that is later assigned a whole struct computes no defaults before then.
struct Rect {
    int width = 4;
    int height = 5;
    protected int area = width * height;
}

struct Pair {
    string left;
    string right = "{left}!";
}

class Holder {
    Pair pair;

    constructor(string left) {
        this.pair = {left: left};
    }
}

struct Wrapper {
    Pair inner;
}

main() -> int {
    Rect r = {};
    if (r.area != 20) { return 1; }

    // Per-slot init through the array path.
    Rect[] rs = new Rect[2];
    if (rs[0].area != 20) { return 2; }
    if (rs[1].area != 20) { return 3; }

    Pair literal = {left: "a"};
    print("literal {literal.right}");
    Pair later;
    later = {left: "b"};
    print("later {later.right}");
    Holder holder = new Holder("c");
    print("held {holder.pair.right}");
    Wrapper wrapper = {inner: {left: "d"}};
    print("nested {wrapper.inner.right}");
    return 0;
}
