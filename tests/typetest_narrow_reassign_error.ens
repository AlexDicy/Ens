// @expect-error No field or method 'radius' on type 'Shape'
class Shape {
    Shape();
}

class Circle extends Shape {
    int radius;
    Circle(this.radius = 0);
}

main() -> int {
    Shape s = new Circle(5);
    if (s is Circle) {
        s = new Shape();
        int r = s.radius;   // the reassignment dropped the narrowing
    }
    return 0;
}
