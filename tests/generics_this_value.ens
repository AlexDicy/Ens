// @exit 0
// @stdout holder 7
// @stdout holder hi
// @stdout described Box<int> 7
// @stdout described Box<string> hi
// @stdout chained 8
// @stdout kept 8
// @stdout same 8
// @stdout same hi
// @stdout twice 8 8
// @stdout twice hi hi
// @stdout first 8
// @stdout first hi
// @stdout both 2 2
// @stdout spot {"x": 3} {"x": 3}
// Inside a generic class or struct, `this` is the type at its own type parameters, so a method can
// hand it to another generic class, to a generic function, to a nullable field, to an array
// literal, or back to its caller. A generic function infers its type parameter from `this` as that
// same type, and a struct method interpolates `this` like any other value of its type.

public class Box<T> {
    protected T value;

    public constructor(this.value);

    protected get() -> T {
        return this.value;
    }

    protected hold() -> Holder<T> {
        return new Holder<T>(this);
    }

    protected describe(string name) -> string {
        return label(this, name);
    }

    protected replaced(T value) -> Box<T> {
        this.value = value;
        return this;
    }

    protected keep(Keeper<T> keeper) {
        keeper.kept = this;
    }

    protected same() -> Box<T> {
        return identity(this);
    }

    protected twice() -> Pair<Box<T>> {
        return pair(this, this);
    }

    protected orOther(Box<T> other) -> Box<T> {
        return first(this, other);
    }

    protected both() -> long {
        return countAll([this, this]);
    }
}

public class Holder<T> {
    Box<T> held;

    public constructor(this.held);

    protected value() -> T {
        return this.held.get();
    }
}

public class Keeper<T> {
    protected Box<T>? kept;

    public constructor() {
        this.kept = null;
    }
}

public class Pair<T> {
    protected T left;
    protected T right;

    public constructor(this.left, this.right);
}

struct Spot<T> {
    T x;

    describe() -> string {
        return "spot {this} {this.toString()}";
    }
}

label<T>(Box<T> box, string name) -> string {
    return "described " + name + " {box.get()}";
}

identity<T>(T value) -> T {
    return value;
}

pair<T>(T left, T right) -> Pair<T> {
    return new Pair<T>(left, right);
}

first<T>(T one, T two) -> T {
    return one;
}

countAll<T>(T[] values) -> long {
    return values.length;
}

main() -> int {
    let number = new Box<int>(7);
    let text = new Box<string>("hi");
    print("holder {number.hold().value()}");
    print("holder {text.hold().value()}");
    print(number.describe("Box<int>"));
    print(text.describe("Box<string>"));
    print("chained {number.replaced(8).get()}");
    let keeper = new Keeper<int>();
    number.keep(keeper);
    let kept = keeper.kept;
    if (kept != null) {
        print("kept {kept.get()}");
    }
    print("same {number.same().get()}");
    print("same {text.same().get()}");
    let numbers = number.twice();
    print("twice {numbers.left.get()} {numbers.right.get()}");
    let texts = text.twice();
    print("twice {texts.left.get()} {texts.right.get()}");
    print("first {number.orOther(new Box<int>(9)).get()}");
    print("first {text.orOther(new Box<string>("bye")).get()}");
    print("both {number.both()} {text.both()}");
    Spot<int> spot = {x: 3};
    print(spot.describe());
    return 0;
}
