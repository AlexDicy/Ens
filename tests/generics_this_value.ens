// @exit 0
// @stdout holder 7
// @stdout holder hi
// @stdout described Box<int> 7
// @stdout described Box<string> hi
// @stdout chained 8
// @stdout kept 8
// Inside a generic class, `this` is the class at its own type parameters, so a method can hand it
// to another generic class, to a generic function, to a nullable field, or back to its caller.

public class Box<T> {
    protected T value;

    public constructor(this.value);

    protected get() -> T {
        return this.value;
    }

    protected hold() -> Holder<T> {
        return new Holder<T>(this);
    }

    protected describe(string name) -> string {
        return label(this, name);
    }

    protected replaced(T value) -> Box<T> {
        this.value = value;
        return this;
    }

    protected keep(Keeper<T> keeper) {
        keeper.kept = this;
    }
}

public class Holder<T> {
    Box<T> held;

    public constructor(this.held);

    protected value() -> T {
        return this.held.get();
    }
}

public class Keeper<T> {
    protected Box<T>? kept;

    public constructor() {
        this.kept = null;
    }
}

label<T>(Box<T> box, string name) -> string {
    return "described " + name + " {box.get()}";
}

main() -> int {
    let number = new Box<int>(7);
    let text = new Box<string>("hi");
    print("holder {number.hold().value()}");
    print("holder {text.hold().value()}");
    print(number.describe("Box<int>"));
    print(text.describe("Box<string>"));
    print("chained {number.replaced(8).get()}");
    let keeper = new Keeper<int>();
    number.keep(keeper);
    let kept = keeper.kept;
    if (kept != null) {
        print("kept {kept.get()}");
    }
    return 0;
}
