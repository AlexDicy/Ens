// @exit 0
// @stdout tasks started while main waited: 1000, on the main thread: 0
// @stdout main went on beside a task that never waits: true
// @stdout woken by another thread: 7
// @stdout gave up at the deadline: true
// The main thread runs 'main' and nothing else: while 'main' waits, every task it started runs on
// another thread, so a task that never waits cannot keep 'main' from going on. A wait on the main
// thread is still woken by another thread, and a timed one still ends at its deadline.
import @std.tasks;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import Channel from @std.tasks;
import ChannelClosed from @std.tasks;
import TaskPriority from @std.tasks;

external from libc {
    ens_is_main_thread() -> int;
}

main() -> int throws Cancelled, ChannelClosed {
    let ran = new Atomic<long>(0);
    let onMain = new Atomic<long>(0);
    tasks.scope((scope) -> {
        for (long i = 0; i < 1000; i++) {
            scope.launch(() -> {
                ran.increment();
                if (ens_is_main_thread() == 1) {
                    onMain.increment();
                }
            });
        }
    });
    print("tasks started while main waited: {ran.read()}, on the main thread: {onMain.read()}");

    let stop = new Atomic<bool>(false);
    try tasks.scope((scope) -> {
        scope.launch(() -> {
            while (!stop.read()) {
            }
        });
        try tasks.sleep(20);
        stop.write(true);
    });
    print("main went on beside a task that never waits: {stop.read()}");

    let values = new Channel<long>(0);
    let sender = values.sender();
    long received = try tasks.scope((scope) -> {
        let waker = scope.startDedicated(TaskPriority.Normal, () -> {
            try sender.send(7);
        });
        return try values.receive() ?? -1;
    });
    print("woken by another thread: {received}");
    print("gave up at the deadline: {try values.receive(20) == null}");
    return 0;
}
