// @exit 0
// @stdout every worker busy: true
// @stdout the task main awaited ran on the main thread: true
// @stdout woken by another thread: 7
// @stdout gave up at the deadline: true
// While 'main' waits, the main thread runs tasks. Every worker is kept busy first, so the task
// 'main' then starts and awaits can only run on the main thread. A wait on the main thread is still
// woken by another thread, and a timed one still ends at its deadline.
import @std.tasks;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import Channel from @std.tasks;
import ChannelClosed from @std.tasks;
import TaskPriority from @std.tasks;
import @std.environment;

external from libc {
    ens_is_main_thread() -> int;
}

main() -> int throws Cancelled, ChannelClosed {
    long workers = environment.processorCount();
    let spinning = new Atomic<long>(0);
    let release = new Atomic<bool>(false);
    bool ranOnMain = try tasks.scope((scope) -> {
        for (long i = 0; i < workers; i++) {
            scope.launch(() -> {
                spinning.increment();
                while (!release.read()) {
                }
            });
        }
        while (spinning.read() < workers) {
        }
        print("every worker busy: {spinning.read() == workers}");
        let probe = scope.start(() -> {
            bool here = ens_is_main_thread() == 1;
            release.write(true);
            return here;
        });
        return try probe.await();
    });
    print("the task main awaited ran on the main thread: {ranOnMain}");

    let values = new Channel<long>(0);
    let sender = values.sender();
    long received = try tasks.scope((scope) -> {
        let waker = scope.startDedicated(TaskPriority.Normal, () -> {
            try sender.send(7);
        });
        return try values.receive() ?? -1;
    });
    print("woken by another thread: {received}");
    print("gave up at the deadline: {try values.receive(20) == null}");
    return 0;
}
