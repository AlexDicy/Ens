// @stdout Hello, Ada! [acme.tools]
// Imports a module from the @acme.tools package, a dependency declared in ens.package and
// resolved by name against the enclosing workspace's members. The package's own greeter imports
// its sibling by bare name, so an internal import resolves to the same module as the external one.
import @acme.tools.greeter;

main() -> int {
    print(greeter.greet("Ada"));
    return 0;
}
