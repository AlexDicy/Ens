// @stdout Hello, Ada! [acme.tools]
// Imports a module from the @acme.tools package declared in dependencies.txt. The
// package's own greeter imports its sibling by bare name, proving a package's internal
// imports resolve to the same modules as the external @package import.
import @acme.tools.greeter;

main() -> int {
    print(greeter.greet("Ada"));
    return 0;
}
