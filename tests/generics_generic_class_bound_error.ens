// A generic class instantiation is not a bound, whether the class is open or final; interfaces
// stay usable as bounds in their instantiated form.
class Box<T> {
    T value;

    protected constructor(this.value);
}

final class FinalBox<T> {
    T value;

    protected constructor(this.value);
}

class Keeper<U: Box<int>> {
    U item;

    protected constructor(this.item);
}

hold<U: FinalBox<string>>(U value) -> U {
    return value;
}

main() -> int {
    return 0;
}
