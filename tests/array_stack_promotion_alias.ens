// @exit 0
// @stdout through parentheses: 42 2
// @stdout parentheses past the frame: 42
// @stdout through a ternary: 3
// @stdout ternary past the frame: 3
// @stdout through a struct literal: 21
// @stdout struct literal past the frame: 21
// A local array is only promoted to frame storage when nothing carries its reference out of the
// frame. The reference travels through more than a bare name: parentheses around the source, a
// ternary that chooses it, and a struct literal that stores it all hand it on, and a callee that
// keeps what it is given makes the receiver outlive the frame. Each shape below reads the array
// after the frame that declared it is gone, so a wrongly promoted array reads dead stack.
class Holder {
    protected int[] items;

    protected constructor(this.items);

    protected replace(int[] next) {
        this.items = next;
    }

    protected first() -> int {
        return this.items[0];
    }
}

struct Bag {
    protected int[] items;
}

passThrough(Holder holder, int[] values) -> int[] {
    holder.replace(values);
    return values;
}

throughParentheses() -> Holder {
    let source = new int[2];
    source[0] = 42;
    int[] carried = (source);
    let holder = new Holder(new int[1]);
    holder.replace(carried);
    print("through parentheses: {holder.first()} {source.length}");
    return holder;
}

throughTernary(bool flag) -> Holder {
    let source = new int[2];
    source[0] = 3;
    int[] carried = flag ? source : source;
    let holder = new Holder(carried);
    print("through a ternary: {holder.first()}");
    return holder;
}

throughStructLiteral() -> Holder {
    let source = new int[2];
    source[0] = 21;
    let holder = new Holder(new int[1]);
    Bag bag = {items: passThrough(holder, source)};
    print("through a struct literal: {bag.items[0]}");
    return holder;
}

// Reuses the frame the builder above left behind, so a promoted array's storage is overwritten
// before the caller reads what it handed on.
churn() -> int {
    let filler = new int[8];
    filler[0] = 999;
    filler[7] = 111;
    return filler[0] + filler[7];
}

main() -> int {
    let kept = throughParentheses();
    churn();
    print("parentheses past the frame: {kept.first()}");

    let chosen = throughTernary(true);
    churn();
    print("ternary past the frame: {chosen.first()}");

    let stored = throughStructLiteral();
    churn();
    print("struct literal past the frame: {stored.first()}");
    return 0;
}
