// @exit 42
class Door {
    int code;
    Door(this.code = 0);
}

class Room {
    Door? door;
    Room(this.door = null);
}

class House {
    Room? room;
    House(this.room = null);
}

main() -> int {
    let d = new Door(42);
    let r = new Room(d);
    let h = new House(r);

    int score = 0;

    // 1. Two-level member chain.
    if (r.door != null) {
        score = score + r.door.code;   // 42
    }

    // 2. Three-level member chain.
    if (h.room != null) {
        if (h.room.door != null) {
            score = score + h.room.door.code - h.room.door.code;  // +0, just exercising
        }
    }

    // 3. Else branch narrows on equality check.
    Room? maybeRoom = null;
    if (maybeRoom == null) {
        score = score + 0;
    } else {
        if (maybeRoom.door != null) {
            score = score + maybeRoom.door.code;  // unreachable - maybeRoom is null
        }
    }

    return score;
}