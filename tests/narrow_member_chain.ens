// @exit 42
// @stdout lazy label
// @stdout lazy door 7
// A chain of 'const' fields narrows link by link, and an else branch narrows on equality. A lazy
// const read through its type narrows too, alone and as the root of a chain.
class Door {
    protected int code;
    protected constructor(this.code = 0);
}

class Room {
    protected const Door? door;
    protected constructor(this.door = null);
}

class House {
    protected const Room? room;
    protected constructor(this.room = null);
}

main() -> int {
    let d = new Door(42);
    let r = new Room(d);
    let h = new House(r);

    int score = 0;

    // 1. Two-level member chain.
    if (r.door != null) {
        score = score + r.door.code;   // 42
    }

    // 2. Three-level member chain.
    if (h.room != null) {
        if (h.room.door != null) {
            score = score + h.room.door.code - h.room.door.code;  // +0, just exercising
        }
    }

    // 3. Else branch narrows on equality check.
    Room? maybeRoom = null;
    if (maybeRoom == null) {
        score = score + 0;
    } else {
        if (maybeRoom.door != null) {
            score = score + maybeRoom.door.code;  // unreachable - maybeRoom is null
        }
    }

    readLazyConsts();
    return score;
}

class Settings {
    protected lazy const string? label = pickLabel();
    protected lazy const Room room = new Room(new Door(7));
    protected lazy const Room? empty = new Room();
}

pickLabel() -> string? {
    return "lazy label";
}

readLazyConsts() {
    if (Settings.label != null) {
        print(Settings.label);
    }
    if (Settings.room.door != null) {
        print("lazy door {Settings.room.door.code}");
    }
    if (Settings.empty == null || Settings.empty.door == null) {
        return;
    }
    print("never printed {Settings.empty.door.code}");
}