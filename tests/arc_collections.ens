// @exit 0
// @stdout stored alive
// @stdout overwrite released
// @stdout map-death released
// @stdout map-removal released
// @stdout set-removal released
// @stdout set-death released
// @stdout iterate alive
// @stdout loop-bindings released
// @stdout break released

import Map from @std.collections.map;
import Set from @std.collections.set;

class Payload {
    int tag;
    protected constructor(this.tag);
}

class Watcher {
    protected weak Payload? first;
    protected weak Payload? second;
}

main() -> int {
    let watcher = new Watcher();

    // A stored value is kept alive by the map. The insert runs in an inner
    // block so the argument temporary is released before the checks below.
    let keeper = new Map<string, Payload>();
    if (true) {
        keeper.set("a", new Payload(1));
    }
    watcher.first = keeper.get("a");
    if (watcher.first != null) { print("stored alive"); }

    // Overwriting a key releases the previous value.
    keeper.set("a", new Payload(2));
    if (watcher.first == null) { print("overwrite released"); }

    // When the map itself dies, the values it still holds die with it.
    if (true) {
        let doomed = new Map<string, Payload>();
        doomed.set("kept", new Payload(3));
        doomed.set("removed", new Payload(4));
        doomed.remove("removed");
        watcher.first = doomed.get("kept");
    }
    if (watcher.first == null) { print("map-death released"); }

    // A removed slot gives its value up there and then, not at the container's death.
    if (true) {
        let holder = new Map<string, Payload>();
        holder.set("gone", new Payload(8));
        watcher.first = holder.get("gone");
        holder.remove("gone");
        if (watcher.first == null) { print("map-removal released"); }
    }

    if (true) {
        let bag = new Set<Payload>();
        {
            let member = new Payload(9);
            bag.add(member);
            watcher.second = member;
        }
        {
            let members = bag.items();
            bag.remove(members[0]);
        }
        if (watcher.second == null) { print("set-removal released"); }
    }

    if (true) {
        let bag = new Set<Payload>();
        let member = new Payload(5);
        bag.add(member);
        watcher.first = member;
    }
    if (watcher.first == null) { print("set-death released"); }

    // Iterating hands out retained references; they are released once the
    // loop's bindings go out of scope.
    if (true) {
        let iterated = new Map<string, Payload>();
        iterated.set("x", new Payload(6));
        for (let entry in iterated) {
            watcher.second = entry.value;
            if (watcher.second != null) { print("iterate alive"); }
        }
        watcher.first = iterated.get("x");
    }
    if (watcher.first == null && watcher.second == null) { print("loop-bindings released"); }

    // Breaking out of iteration still releases the iterator and element.
    if (true) {
        let source = new Map<string, Payload>();
        source.set("only", new Payload(7));
        for (let entry in source) {
            watcher.first = entry.value;
            break;
        }
    }
    if (watcher.first == null) { print("break released"); }

    return 0;
}
