// @exit 0
// Reading a weak field yields a retained strong reference (ens_weak_load upgrades
// via CAS). When that read is used in a comparison, the temporary must be released,
// or the referent leaks and stays alive. Here the weak field is live at the
// comparison, so releasing the temp is what lets the Node be freed once `observe`
// returns; the weak reference then reads back as null.
class Node { int v; constructor(this.v = 0); }
class Watcher { weak Node? seen; constructor(); }

observe(Watcher w) {
    let n = new Node();
    n.v = 7;
    w.seen = n;
    if (w.seen == null) { return; }
}

main() -> int {
    let w = new Watcher();
    observe(w);
    if (w.seen != null) { return 1; }
    return 0;
}