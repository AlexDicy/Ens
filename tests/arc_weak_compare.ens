// @exit 0
// Reading a weak field yields a retained strong reference, so a read used in a comparison must
// release the temporary or the referent leaks. Releasing it is what lets the Node be freed once
// `observe` returns, after which the weak reference reads back as null. An optional struct a call
// produces is released the same way once '==' compares it, with another optional, with an optional
// one level deeper, or with null, so the Node its payload holds is gone once the comparing function
// returns.
class Node {
    protected int v;

    protected constructor(this.v = 0);
}

class Watcher {
    protected weak Node? seen;

    protected constructor();
}

struct Wrapped {
    protected Node node;
}

observe(Watcher w) {
    let n = new Node();
    n.v = 7;
    w.seen = n;
    if (w.seen == null) {
        return;
    }
}

wrap(Watcher w) -> Wrapped? {
    let n = new Node();
    w.seen = n;
    return {node: n};
}

wrapDeeper(Watcher w) -> Wrapped?? {
    let n = new Node();
    w.seen = n;
    return {node: n};
}

sameWrapped(Watcher left, Watcher right) -> bool {
    return wrap(left) == wrap(right);
}

deeperWrapped(Watcher left, Watcher right) -> bool {
    return wrap(left) == wrapDeeper(right);
}

absentWrapped(Watcher w) -> bool {
    return wrap(w) == null;
}

main() -> int {
    let w = new Watcher();
    observe(w);
    if (w.seen != null) {
        return 1;
    }
    let left = new Watcher();
    let right = new Watcher();
    if (sameWrapped(left, right) || left.seen != null || right.seen != null) {
        return 2;
    }
    if (deeperWrapped(left, right) || left.seen != null || right.seen != null) {
        return 3;
    }
    if (absentWrapped(left) || left.seen != null) {
        return 4;
    }
    return 0;
}
