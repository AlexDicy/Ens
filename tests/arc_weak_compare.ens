// @exit 0
// Reading a weak field yields a retained strong reference, so a read used in a comparison must
// release the temporary or the referent leaks. Releasing it is what lets the Node be freed once
// `observe` returns, after which the weak reference reads back as null.
class Node { protected int v; protected constructor(this.v = 0); }
class Watcher { protected weak Node? seen; protected constructor(); }

observe(Watcher w) {
    let n = new Node();
    n.v = 7;
    w.seen = n;
    if (w.seen == null) { return; }
}

main() -> int {
    let w = new Watcher();
    observe(w);
    if (w.seen != null) { return 1; }
    return 0;
}