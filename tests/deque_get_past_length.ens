// @exit 134
// @stderr-contains panic: tried to read index 2 of a deque of length 1. Check the index against length() first
// A deque counts its indexes from the front, so one past the count aborts and names the deque's
// length rather than the slot its ring buffer would have read.
import Deque from @std.collections.deque;

main() -> int {
    let items = new Deque<int>();
    items.pushBack(7);
    return items.get(2);
}
