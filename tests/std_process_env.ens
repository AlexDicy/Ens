// @exit 0
// @stdout captured both: exit=0
// @stdout captured stdout: child out: mark=one path=true
// @stdout captured stderr: child err: mark=one path=true
// @stdout mixed: exit=0 stdout=child out: mark=two path=true
// @stdout inherited: exit=0
// @stdout without overrides: exit=0 stdout=child out: mark=<unset> path=true
// @stdout environment: entries=true sorted=true has-path=true
// @stderr child err: mark=two path=true
// @stderr child err: mark=three path=true
// The program spawns itself as the child, so one fixture covers both sides. A child with an
// inherited stream writes straight into this process's own stream, which is why the two lines
// above are asserted on standard error rather than through a capture file.
import @std.system;
import SystemError from @std.system;
import @std.path;

main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length > 1) {
        return reportEnvironment(arguments[1]);
    }
    return try spawnChildren();
} catch (SystemError e) {
    system.writeError("std_process_env: {e.message}");
    return 1;
}

// The child: what it was given as its environment. 'loud' reports on both streams, so a run that
// captures only one of them still proves the other arrived where it was asked for.
reportEnvironment(string mode) -> int {
    string mark = system.getEnvironmentVariable("ENS_TEST_SPAWN_MARK") ?? "<unset>";
    string searchPath = system.getEnvironmentVariable("PATH") ?? "";
    bool keptPath = searchPath.length > 0;
    if (mode == "loud") {
        print("child out: mark={mark} path={keptPath}");
    }
    system.writeError("child err: mark={mark} path={keptPath}");
    return 0;
}

spawnChildren() -> int throws {
    string self = system.executablePath();
    string folder = path.join(path.parentFolder(self), "std_process_env_scratch");
    try system.createDirectory(folder);
    string outPath = folder + "/child.out";
    string errPath = folder + "/child.err";

    int both = try system.runCaptured(self, ["loud"], ["ENS_TEST_SPAWN_MARK=one"],
        outPath, errPath);
    print("captured both: exit={both}");
    print("captured stdout: " + try captured(outPath));
    print("captured stderr: " + try captured(errPath));

    int mixed = try system.runCaptured(self, ["loud"], ["ENS_TEST_SPAWN_MARK=two"], outPath, "");
    print("mixed: exit={mixed} stdout=" + try captured(outPath));

    int streamed = try system.run(self, ["quiet"], ["ENS_TEST_SPAWN_MARK=three"]);
    print("inherited: exit={streamed}");

    int plain = try system.runCaptured(self, ["loud"], outPath, errPath);
    print("without overrides: exit={plain} stdout=" + try captured(outPath));

    string[] variables = system.environment();
    print("environment: entries={variables.length > 0} sorted={ascending(variables)} "
        + "has-path={holdsPath(variables)}");

    try system.removeFile(outPath);
    try system.removeFile(errPath);
    try system.removeDirectory(folder);
    return 0;
}

captured(string target) -> string throws {
    return (try system.readAllText(target)).trim();
}

ascending(string[] variables) -> bool {
    for (long i = 1; i < variables.length; i++) {
        if (variables[i - 1].compareTo(variables[i]) > 0) {
            return false;
        }
    }
    return true;
}

// True when the inherited environment still carries the search path, the variable a child needs to
// find the programs it runs.
holdsPath(string[] variables) -> bool {
    for (let entry in variables) {
        if (entry.startsWith("PATH=") || entry.startsWith("Path=")) {
            return true;
        }
    }
    return false;
}
