// @exit 0
// @stdout 5 edge! 12
// @stdout 3
// A lambda that reads a 'const' field of 'this' whose type another task may hold copies the field
// when it is created, so it is 'shared' without holding 'this', and reads the same value.
run(shared () -> int work) -> int {
    return work();
}

nested(shared () -> (shared () -> string) make) -> string {
    return make()();
}

final class Limits {
    const int limit;
    const string label;
    int changing;

    constructor(this.limit, this.label) {
        this.changing = 0;
    }

    total() -> int {
        return run(() -> this.limit + 1);
    }

    named() -> string {
        return nested(() -> () -> "{this.label}!");
    }

    both() -> int {
        return run(() -> this.limit * 2) + run(() -> (this).limit);
    }

    // A lambda that is not 'shared' may still change what it reads through 'this'.
    counted() -> int {
        () -> int bump = () -> {
            this.changing = this.changing + this.limit - 1;
            return this.changing;
        };
        return bump();
    }
}

main() -> int {
    let limits = new Limits(4, "edge");
    print("{limits.total()} {limits.named()} {limits.both()}");
    print("{limits.counted()}");
    return 0;
}
