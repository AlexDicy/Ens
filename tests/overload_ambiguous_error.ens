// @expect-error This call matches 'pick(long, double)' and 'pick(double, long)' equally well, so it is not clear which one to call. Convert the arguments with 'as', as in '5 as long' and '5 as double', so the call matches one of them exactly.
// Two candidates that each fit one argument better than the other leave nothing to choose between.
pick(long a, double b) -> string { return "left"; }
pick(double a, long b) -> string { return "right"; }

main() -> int {
    pick(5, 5);
    return 0;
}
