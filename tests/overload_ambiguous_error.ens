// @expect-error Call to 'pick' is ambiguous. Candidates: 'pick(long, double)', 'pick(double, long)'.
// Two candidates that each fit one argument better than the other leave nothing to choose between.
pick(long a, double b) -> string { return "left"; }
pick(double a, long b) -> string { return "right"; }

main() -> int {
    pick(5, 5);
    return 0;
}
