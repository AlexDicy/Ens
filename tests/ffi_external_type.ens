// @exit 0
// @stdout allocated
// @stdout present
// @stdout absent
// @stdout distinct
// @stdout struct
// @stdout array
// An external handle is a raw pointer, so a nullable one is the same word with null for absent and
// reference counting never touches it. A handle a call produced therefore reaches a comparison with
// no reference to give up afterwards, unlike a class reference of the same shape.
external type Handle;

external from libc {
    abs(int x) -> int;
    malloc(long size) -> Handle;
    free(Handle block);
}

struct Slot {
    protected Handle handle;
    protected Handle? spare;
}

isNullHandle(Handle? h) -> bool {
    return h == null;
}

allocate(long size) -> Handle? {
    return malloc(size);
}

echo(Handle handle) -> Handle? {
    return handle;
}

nothing() -> Handle? {
    return null;
}

sameSlot(Slot left, Slot right) -> bool {
    return left == right;
}

sameHandles(Handle[] left, Handle[] right) -> bool {
    return left == right;
}

main() -> int {
    Handle? unset = null;
    if (!isNullHandle(unset)) {
        return 1;
    }
    Handle? block = allocate(8);
    if (block == null) {
        return 2;
    }
    print("allocated");
    if (echo(block) == null) {
        return 3;
    }
    if (null == echo(block)) {
        return 4;
    }
    print("present");
    if (nothing() != null) {
        return 5;
    }
    print("absent");
    Handle? other = allocate(8);
    if (other == null) {
        return 6;
    }
    if (block == other || block != block) {
        return 7;
    }
    if (echo(block) != block || unset == block || block == unset) {
        return 8;
    }
    if (unset != unset || unset != nothing()) {
        return 9;
    }
    print("distinct");
    Slot first = {handle: block, spare: null};
    Slot second = {handle: block, spare: null};
    Slot third = {handle: other, spare: block};
    if (!sameSlot(first, second) || sameSlot(first, third)) {
        return 10;
    }
    print("struct");
    if (!sameHandles([block, other], [block, other])
            || sameHandles([block, other], [other, block])) {
        return 11;
    }
    Handle?[] sparse = [block, null];
    Handle?[] sparseAgain = [block, null];
    Handle?[] reversed = [null, block];
    if (sparse != sparseAgain || sparse == reversed) {
        return 12;
    }
    print("array");
    free(block);
    free(other);
    return abs(0);
}
