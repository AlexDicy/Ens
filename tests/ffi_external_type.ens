// @exit 0
// @stdout allocated
// @stdout present
// @stdout absent
// An external handle is a raw pointer, so a nullable one is the same word with null for absent
// and reference counting never touches it. A handle a call produced therefore reaches the
// comparison with no reference to give up afterwards, unlike a class reference of the same shape.
external type Handle;

external from libc {
    abs(int x) -> int;
    malloc(long size) -> Handle;
    free(Handle block);
}

isNullHandle(Handle? h) -> bool {
    return h == null;
}

allocate(long size) -> Handle? {
    return malloc(size);
}

echo(Handle handle) -> Handle? {
    return handle;
}

nothing() -> Handle? {
    return null;
}

main() -> int {
    Handle? unset = null;
    if (!isNullHandle(unset)) {
        return 1;
    }
    Handle? block = allocate(8);
    if (block == null) {
        return 2;
    }
    print("allocated");
    if (echo(block) == null) {
        return 3;
    }
    if (null == echo(block)) {
        return 4;
    }
    print("present");
    if (nothing() != null) {
        return 5;
    }
    print("absent");
    free(block);
    return abs(0);
}
