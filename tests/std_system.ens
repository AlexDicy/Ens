// @exit 0
// Happy paths for std.system: write bytes to a temp file, read them back, query the
// environment (set and unset), run a command, and catch a SystemError.
import @std.system;
import File from @std.system;
import SystemError from @std.system;

main() -> int throws {
    File writer = try system.openFile("build/tests/std_system.tmp", "w");
    byte[] data = new byte[3];
    data[0] = 'a';
    data[1] = 'b';
    data[2] = 'c';
    let written = try writer.write(data);
    let closedWriter = writer.close();
    if (written != 3) { return 10; }

    File reader = try system.openFile("build/tests/std_system.tmp", "r");
    byte[] buffer = new byte[3];
    let readCount = try reader.read(buffer);
    let closedReader = reader.close();
    if (readCount != 3) { return 11; }
    if (buffer[0] != 'a') { return 12; }
    if (buffer[2] != 'c') { return 13; }

    string? path = system.getEnvironmentVariable("PATH");
    if (path == null) { return 14; }
    string? missing = system.getEnvironmentVariable("ENS_SURELY_UNSET_VARIABLE_42");
    if (missing != null) { return 15; }

    int status = try system.run("true");
    if (status != 0) { return 16; }

    return openMissingIsCaught();
}

// Opening a nonexistent file for reading must raise a SystemError; catching it here
// returns 0, while reaching the end would return a failure code.
openMissingIsCaught() -> int {
    File reader = try system.openFile("build/tests/std_system_no_such_file.tmp", "r");
    let closed = reader.close();
    return 17;
} catch (SystemError e) {
    return 0;
}
