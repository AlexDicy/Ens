// @exit 0
// @stdout chain-keep 7
// A call whose receiver is a member chain (`r.door.open()`) drops the member-path
// narrowings rooted at `r`, but keeps `r`'s own non-null proof: no callee can
// reassign the caller's binding. Reading another member of `r` after the call is
// therefore still allowed.
class Door {
    int code;

    protected constructor(this.code = 0);

    protected open() {
    }
}

class Room {
    protected Door? door;
    protected int tag;

    protected constructor(this.door = null, this.tag = 0);
}

process(Room? r) -> int {
    if (r != null && r.door != null) {
        r.door.open();   // touches r.door: drops r.door, keeps r's own narrowing
        return r.tag;    // ok - r is still proven non-null
    }
    return -1;
}

main() -> int {
    int result = process(new Room(new Door(3), 7));
    print("chain-keep " + result);
    return result - 7;
}
