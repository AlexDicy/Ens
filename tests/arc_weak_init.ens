// @exit 0
// @stdout shorthand live 7
// @stdout node 7 gone
// @stdout shorthand dead
// @stdout teardown 9
// @stdout node 9 gone
// A weak field initialized by a 'this.field' constructor parameter must write a side-table
// entry and take no strong reference. The node dies while its watcher still lives, so a
// missed weak barrier shows up as a node that never dies and a watcher that keeps reading it
// back; the allocation after the watcher dies catches a bad free of the entry.

class Node {
    protected int v;

    protected constructor(this.v);

    destructor() {
        print("node " + this.v + " gone");
    }
}

class Watcher {
    protected weak Node? seen;

    protected constructor(this.seen);
}

report(string label, Watcher watcher) {
    let node = watcher.seen;
    if (node == null) {
        print(label + " dead");
    } else {
        print(label + " live " + node.v);
    }
}

watchThroughShorthand() -> Watcher {
    let node = new Node(7);
    let watcher = new Watcher(node);
    report("shorthand", watcher);
    return watcher;
}

main() -> int {
    if (true) {
        let shorthand = watchThroughShorthand();
        report("shorthand", shorthand);
    }

    let fresh = new Node(9);
    print("teardown " + fresh.v);
    return 0;
}
