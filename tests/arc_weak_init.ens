// @exit 0
// @stdout shorthand live 7
// @stdout node 7 gone
// @stdout shorthand dead
// @stdout default live 5
// @stdout node 5 gone
// @stdout default dead
// @stdout teardown 9
// @stdout node 9 gone
// Initializing a weak field must write a side-table entry and take no strong reference,
// whichever form does the writing: a 'this.field' constructor parameter or a declared default.
// Each watched node dies while the object watching it is still alive, so a missed weak barrier
// shows up as a node that never dies and a field that keeps reading it back; the allocation
// after the watchers die catches a bad free of an entry.

class Node {
    protected int v;

    protected constructor(this.v);

    destructor() {
        print("node " + this.v + " gone");
    }
}

class Watcher {
    protected weak Node? seen;

    protected constructor(this.seen);
}

class Defaulted {
    protected Node? owned = new Node(5);
    protected weak Node? mirror = owned;
}

report(string label, Node? node) {
    if (node == null) {
        print(label + " dead");
    } else {
        print(label + " live " + node.v);
    }
}

// A weak read hands back a strong reference the reader owns, released when the frame holding
// it unwinds; reporting from a called frame keeps that temporary out of the caller's scope.
reportMirror(string label, Defaulted defaulted) {
    report(label, defaulted.mirror);
}

watchThroughShorthand() -> Watcher {
    let node = new Node(7);
    let watcher = new Watcher(node);
    report("shorthand", watcher.seen);
    return watcher;
}

main() -> int {
    if (true) {
        let watcher = watchThroughShorthand();
        report("shorthand", watcher.seen);

        let defaulted = new Defaulted();
        reportMirror("default", defaulted);
        defaulted.owned = null;
        reportMirror("default", defaulted);
    }

    let fresh = new Node(9);
    print("teardown " + fresh.v);
    return 0;
}
