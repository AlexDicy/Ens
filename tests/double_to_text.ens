// @stdout hole 2.5 call 2.5 concat 2.5
// @stdout float 1.5 1.5 1.5
// @stdout short 2.5 0.1 0.5
// @stdout faithful 0.30000000000000004 0.3333333333333333
// @stdout whole 3 0 -0 1234567
// @stdout exponent 1e-05 1e+21 1e+15
// @stdout plain 0.0001 999999999999999 1234567890123456
// @stdout special inf -inf nan
// A floating-point value renders as the shortest decimal text that reads back as the same
// value. Every case the spec names is pinned here, because the format is the contract programs
// depend on and the two compilers have no other gate keeping them agreed on it.
main() -> int {
    double d = 2.5;
    print("hole {d} call {d.toString()} concat " + d);

    // A float widens to double losslessly, so both types print the same text for a value.
    float f = 1.5;
    print("float {f} {f.toString()} " + f);

    print("short {2.5} {0.1} {0.5}");

    // Enough digits to read back exactly, which is what makes the arithmetic visible.
    print("faithful {0.1 + 0.2} {1.0 / 3.0}");

    // Nothing after the point means no point, and negative zero keeps its sign.
    print("whole {3.0} {0.0} {-0.0} {1234567.0}");

    // Below 1e-4, or once the exponent reaches the digits shown, the exponent form is used.
    print("exponent {1e-5} {1e21} {1e15}");
    print("plain {0.0001} {999999999999999.0} {1234567890123456.0}");

    double huge = 1e308 * 10.0;
    double nan = huge - huge;
    print("special {huge} {-huge} {nan}");
    return 0;
}
