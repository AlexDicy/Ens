// @exit 134
// @stderr-contains panic: the environment variable name 'NAME=VALUE' holds '=', which separates a name from its value, so it cannot be given to a child
// Writing a variable whose name holds '=' aborts in the set's own words, since the name could not be
// told from its value in the block a child is given.
import Environment from @std.environment;
import Platform from @std.environment;

main() -> int {
    let variables = Environment.empty(Platform.Windows);
    variables.set("NAME=VALUE", "value");
    return 0;
}
