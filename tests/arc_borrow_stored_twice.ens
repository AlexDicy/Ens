// @exit 0
// @stdout two array slots: 14 7 alive true
// @stdout two array slots reclaimed: true
// @stdout mixed array slots: 11 3 alive true
// @stdout mixed array slots reclaimed: true
// @stdout one local in two slots: 10 5 alive true
// @stdout one local in two slots reclaimed: true
// @stdout two array literals: 16 8 alive true
// @stdout two array literals reclaimed: true
// @stdout two locals: 18 9 alive true
// @stdout two locals reclaimed: true
// @stdout two fields: 20 10 alive true
// @stdout two fields reclaimed: true
// @stdout two closures: 23 11 alive true
// @stdout two closures reclaimed: true
// @stdout kept and returned: 24 12 alive true
// @stdout kept and returned reclaimed: true
// @stdout argument slots: 26 13 alive true
// @stdout argument slots reclaimed: true
// @stdout generic array slots: 28 14 alive true
// @stdout generic array slots reclaimed: true
// A borrowed reference stored into more than one place gets a reference of its own for each of
// them, so 'this' fills both slots of an array literal, both of two locals, both of two fields
// and both of two closures. Every shape below builds what holds those references, reads each of
// them, and lets the holder die while one strong reference and a weak probe remain: a shape that
// took fewer references than it stored ends that holder's death with the object destroyed, which
// the probe reports as 'alive false', and one that took more leaks, which the reclaimed line
// reports as 'false'.
class Cell {
    protected long value;

    protected constructor(this.value);

    protected read() -> long {
        return this.value;
    }

    protected pairOfThis() -> Cell[] {
        return [this, this];
    }

    protected pairWith(Cell other) -> Cell[] {
        return [this, other];
    }

    protected twoLiterals() -> Cell[][] {
        Cell[] first = [this];
        Cell[] second = [this];
        return [first, second];
    }

    protected twoLocals() -> long {
        Cell first = this;
        Cell second = this;
        return first.read() + second.read();
    }

    protected fillBoth(Pair pair) {
        pair.left = this;
        pair.right = this;
    }

    protected twoReaders() -> Readers {
        () -> long first = () -> this.value;
        () -> long second = () -> this.value + 1;
        return new Readers(first, second);
    }

    protected keepAndReturn(Pair pair) -> Cell {
        pair.left = this;
        return this;
    }

    protected sentTwice() -> long {
        return readPair([this, this]);
    }
}

class Pair {
    protected Cell left;
    protected Cell right;

    protected constructor(this.left, this.right);
}

class Readers {
    protected () -> long first;
    protected () -> long second;

    protected constructor(this.first, this.second);
}

// A weak field watches one cell without keeping it alive, so it answers whether the references
// the shapes took were given up too early or not at all.
class Probe {
    protected weak Cell? seen;

    protected constructor(this.seen);

    protected alive() -> bool {
        return this.seen != null;
    }

    protected gone() -> bool {
        return this.seen == null;
    }
}

class Box<T> {
    protected T value;

    protected constructor(this.value);

    protected pairOfThis() -> Box<T>[] {
        return [this, this];
    }
}

class BoxProbe {
    protected weak Box<int>? seen;

    protected constructor(this.seen);

    protected alive() -> bool {
        return this.seen != null;
    }

    protected gone() -> bool {
        return this.seen == null;
    }
}

// Reads both slots and then gives up the array, which is what makes the array's own references
// the ones under test.
readPair(Cell[] slots) -> long {
    return slots[0].read() + slots[1].read();
}

readNested(Cell[][] both) -> long {
    return both[0][0].read() + both[1][0].read();
}

readBoxPair(Box<int>[] slots) -> long {
    return slots[0].value + slots[1].value;
}

readThroughPair(Cell cell) -> long {
    let placeholder = new Cell(0);
    let pair = new Pair(placeholder, placeholder);
    cell.fillBoth(pair);
    return pair.left.read() + pair.right.read();
}

readThroughReaders(Cell cell) -> long {
    let readers = cell.twoReaders();
    return readers.first() + readers.second();
}

readKeptAndReturned(Cell cell) -> long {
    let placeholder = new Cell(0);
    let pair = new Pair(placeholder, placeholder);
    let returned = cell.keepAndReturn(pair);
    return pair.left.read() + returned.read();
}

twoArraySlots() -> Probe {
    let cell = new Cell(7);
    let probe = new Probe(cell);
    long read = readPair(cell.pairOfThis());
    print("two array slots: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

mixedArraySlots() -> Probe {
    let cell = new Cell(3);
    let probe = new Probe(cell);
    long read = readPair(cell.pairWith(new Cell(8)));
    print("mixed array slots: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

oneLocalInTwoSlots() -> Probe {
    let cell = new Cell(5);
    let probe = new Probe(cell);
    long read = readPair([cell, cell]);
    print("one local in two slots: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

twoArrayLiterals() -> Probe {
    let cell = new Cell(8);
    let probe = new Probe(cell);
    long read = readNested(cell.twoLiterals());
    print("two array literals: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

twoLocals() -> Probe {
    let cell = new Cell(9);
    let probe = new Probe(cell);
    long read = cell.twoLocals();
    print("two locals: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

twoFields() -> Probe {
    let cell = new Cell(10);
    let probe = new Probe(cell);
    long read = readThroughPair(cell);
    print("two fields: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

twoClosures() -> Probe {
    let cell = new Cell(11);
    let probe = new Probe(cell);
    long read = readThroughReaders(cell);
    print("two closures: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

keptAndReturned() -> Probe {
    let cell = new Cell(12);
    let probe = new Probe(cell);
    long read = readKeptAndReturned(cell);
    print("kept and returned: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

argumentSlots() -> Probe {
    let cell = new Cell(13);
    let probe = new Probe(cell);
    long read = cell.sentTwice();
    print("argument slots: {read} {cell.read()} alive {probe.alive()}");
    return probe;
}

genericArraySlots() -> BoxProbe {
    let box = new Box<int>(14);
    let probe = new BoxProbe(box);
    long read = readBoxPair(box.pairOfThis());
    print("generic array slots: {read} {box.value} alive {probe.alive()}");
    return probe;
}

main() -> int {
    print("two array slots reclaimed: {twoArraySlots().gone()}");
    print("mixed array slots reclaimed: {mixedArraySlots().gone()}");
    print("one local in two slots reclaimed: {oneLocalInTwoSlots().gone()}");
    print("two array literals reclaimed: {twoArrayLiterals().gone()}");
    print("two locals reclaimed: {twoLocals().gone()}");
    print("two fields reclaimed: {twoFields().gone()}");
    print("two closures reclaimed: {twoClosures().gone()}");
    print("kept and returned reclaimed: {keptAndReturned().gone()}");
    print("argument slots reclaimed: {argumentSlots().gone()}");
    print("generic array slots reclaimed: {genericArraySlots().gone()}");
    return 0;
}
