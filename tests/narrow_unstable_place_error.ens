// @expect-error Cannot read a member of 'Door?' because it may be null here. 'door' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let door = r.door;') and check the local.
// @expect-error No field or method 'radius' on type 'Shape'. 'shape' is a field, so it can change at any time, and a type test on it does not carry to a later use. Copy it into a local first ('let shape = c.shape;') and test the local.
// @expect-error Cannot read a member of 'Door?' because it may be null here. 'doors[0]' is an array element, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let value = doors[0];') and check the local.
// @expect-error Cannot read a member of 'Door?' because it may be null here. 'doors[i]' is an array element, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let value = doors[i];') and check the local.
// @expect-error '+' needs numbers on both sides, got 'int?' and 'int'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;') and check the local.
// @expect-error '+=' needs numbers on both sides, got 'int?' and 'int'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;'), check the local, and write the result back to 't.count'.
// @expect-error The '++' operator works only on numbers, and this value has type 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;'), check the local, and write the result back to 't.count'.
// @expect-error '<=' compares numbers, got 'int?' and 'int'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;') and check the local.
// @expect-error '<<=' shifts an integer, got 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;'), check the local, and write the result back to 't.count'.
// @expect-error '<<' needs an integer shift distance, got 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;') and check the local.
// @expect-error '&=' needs integers on both sides, got 'int?' and 'int'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;'), check the local, and write the result back to 't.count'.
// @expect-error Cannot add a string to a value of type 'string?'; only a string, a number and a 'bool' can be added. 'label' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let label = t.label;'), check the local, and write the result back to 't.label'.
// @expect-error Cannot add a value of type 'string?' to a string; only a string, a number and a 'bool' can be added. 'label' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let label = t.label;') and check the local.
// @expect-error Unary '-' needs a number, got 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;') and check the local.
// @expect-error '!' negates a 'bool', got 'bool?'. 'flag' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let flag = t.flag;') and check the local.
// @expect-error '~' flips the bits of an integer, got 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = t.count;') and check the local.
// @expect-error '&&' needs 'bool' on both sides, got 'bool?' and 'bool'. 'flag' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let flag = t.flag;') and check the local.
// @expect-error The '++' operator works only on numbers, and this value has type 'int?'. 'count' is a field, so it can change at any time, and a null check on it does not carry to a later use. Copy it into a local first ('let count = ...;') and check the local.
// @expect-error build failed with 20 problems
// A mutable field and an array element are never stable places, because another reference can
// write either one between a check and a use. A null check on one proves nothing for the reads
// after it, a write through one refines nothing, and a type test on a mutable field narrows
// nothing either. Each refusal names the step that is not stable and the local copy that is,
// for a null check and for a type test, at a literal index, at an identifier index, after a
// write, and for every operator on a checked field. A compound form writes the result back,
// unless the field is read from a call's result, which no write can reach.
class Door {
    protected int code;
    protected constructor(this.code = 0);
}

class Room {
    protected Door? door;
    protected constructor(this.door = null);
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;
    protected constructor(this.radius = 0);
}

class Canvas {
    protected Shape shape;
    protected constructor(this.shape);
}

class Tally {
    protected int? count;
    protected string? label = "a";
    protected bool? flag = true;
    protected constructor(this.count = null);
}

checkedField(Room r) -> int {
    if (r.door != null) {
        return r.door.code;          // refused after a check on a field
    }
    return 0;
}

writtenField(Room r) -> int {
    r.door = new Door(8);
    return r.door.code;              // refused after a write through a field
}

testedField(Canvas c) -> int {
    if (c.shape is Circle) {
        return c.shape.radius;       // refused after a type test on a field
    }
    return 0;
}

checkedElement(Door?[] doors) -> int {
    if (doors[0] != null) {
        return doors[0].code;        // refused after a check on an element
    }
    return 0;
}

checkedElementByName(Door?[] doors, int i) -> int {
    if (doors[i] != null) {
        return doors[i].code;        // refused the same way at an identifier index
    }
    return 0;
}

writtenElement(Door?[] doors) -> int {
    doors[0] = new Door(9);
    return doors[0].code;            // refused after a write through an element
}

addedField(Tally t) -> int {
    if (t.count != null) {
        return t.count + 1;          // arithmetic refused after a check on a field
    }
    return 0;
}

addedInPlace(Tally t) {
    if (t.count != null) {
        t.count += 1;                // a compound assignment refused after a check
    }
}

steppedField(Tally t) {
    if (t.count != null) {
        t.count++;                   // '++' refused after a check on a field
    }
}

operators(Tally t) {
    if (t.count != null && t.label != null && t.flag != null) {
        bool compared = t.count <= 3;
        t.count <<= 1;
        int shifted = 1 << t.count;
        t.count &= 1;
        t.label += "x";
        string joined = "x" + t.label;
        int negated = -t.count;
        bool inverted = !t.flag;
        int flipped = ~t.count;
        bool both = t.flag && true;
    }
}

make() -> Tally {
    return new Tally(1);
}

temporary() {
    make().count++;                  // no write-back advice for a call's result
}

main() -> int {
    Door?[] doors = [new Door(1)];
    let tally = new Tally(1);
    addedInPlace(tally);
    steppedField(tally);
    operators(tally);
    temporary();
    return checkedField(new Room()) + writtenField(new Room()) + testedField(new Canvas(new Circle(2)))
        + checkedElement(doors) + checkedElementByName(doors, 0) + writtenElement(doors)
        + addedField(tally);
}
