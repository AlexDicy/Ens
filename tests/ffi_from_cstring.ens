// @exit 0
// @stdout absent=<null>
// @stdout present=[hermetic]
// fromCString lifts a foreign char* into string?: a null handle (an unset environment variable)
// becomes null, and a non-null one becomes the copied bytes. The test harness sets
// ENS_FROMCSTRING_PRESENT to a known value and guarantees ENS_FROMCSTRING_ABSENT is unset, so the
// fixture never depends on ambient environment variables. An optional external argument (the
// getenv result) and a non-optional one (after narrowing) both type-check and both yield string?.
import @std.ffi;

external type CStr;

external from libc {
    getenv(string name) -> CStr?;
}

fromHandle(CStr handle) -> string? {
    return ffi.fromCString(handle);
}

main() -> int {
    let absent = ffi.fromCString(getenv("ENS_FROMCSTRING_ABSENT"));
    if (absent == null) {
        print("absent=<null>");
    } else {
        print("absent=[{absent}]");
    }

    CStr? presentHandle = getenv("ENS_FROMCSTRING_PRESENT");
    string present = "<none>";
    if (presentHandle != null) {
        present = fromHandle(presentHandle) ?? "<none>";
    }
    print("present=[{present}]");

    if (absent == null && present == "hermetic") {
        return 0;
    }
    return 1;
}
