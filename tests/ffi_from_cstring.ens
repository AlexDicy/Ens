// @exit 0
// @stdout absent=<null>
// @stdout present=[hermetic]
// fromCString lifts a foreign char* into string?, so a null handle becomes null and a non-null one
// becomes the copied bytes. The harness sets ENS_TEST_FROMCSTRING_PRESENT and guarantees
// ENS_TEST_FROMCSTRING_ABSENT is unset, so the fixture depends on no ambient variable.
import @std.ffi;

external type CStr;

external from libc {
    getenv(string name) -> CStr?;
}

fromHandle(CStr handle) -> string? {
    return ffi.fromCString(handle);
}

main() -> int {
    let absent = ffi.fromCString(getenv("ENS_TEST_FROMCSTRING_ABSENT"));
    if (absent == null) {
        print("absent=<null>");
    } else {
        print("absent=[{absent}]");
    }

    CStr? presentHandle = getenv("ENS_TEST_FROMCSTRING_PRESENT");
    string present = "<none>";
    if (presentHandle != null) {
        present = fromHandle(presentHandle) ?? "<none>";
    }
    print("present=[{present}]");

    if (absent == null && present == "hermetic") {
        return 0;
    }
    return 1;
}
