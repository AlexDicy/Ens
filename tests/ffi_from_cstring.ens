// @exit 0
// @stdout unset=[] pathSet=true
// fromCString copies the NUL-terminated buffer a foreign handle points to into an Ens string.
// getenv returns a C string handle (an external type); an unset variable returns a null handle,
// which fromCString maps to the empty string, while a variable that is set (PATH) yields a
// non-empty string.
import @std.ffi;

external type CStr;

external from libc {
    getenv(string name) -> CStr?;
}

main() -> int {
    let unset = ffi.fromCString(getenv("ENS_SURELY_UNSET_ENVIRONMENT_VARIABLE_9Z"));
    let path = ffi.fromCString(getenv("PATH"));
    print("unset=[{unset}] pathSet={path.length > 0}");
    if (unset.length == 0 && path.length > 0) {
        return 0;
    }
    return 1;
}
