// @exit 0
// @stdout len=5
// @stdout roundtrip-ok
// @stdout eq-frombytes
// @stdout greeting=café!
// @stdout char=233
// @stdout emoji-len=4
// @stdout emoji-roundtrip
// @stdout eq-literal
// Non-ASCII source is decoded as UTF-8. A string literal holds its UTF-8
// bytes, so .length counts bytes: café is five and 😀 is four.
// Comments may contain non-ASCII text like café and 😀 too.
main() -> int {
    let s = "café";
    print("len=" + s.length.toString());
    let bytes = s.toBytes();
    if (string.fromBytes(bytes) == "café") { print("roundtrip-ok"); }
    byte[] raw = new byte[5];
    raw[0] = 'c'; raw[1] = 'a'; raw[2] = 'f'; raw[3] = 0xC3; raw[4] = 0xA9;
    if (string.fromBytes(raw) == "café") { print("eq-frombytes"); }
    print("greeting={s}!");
    int code = 'é';
    print("char=" + code.toString());
    let emoji = "😀";
    print("emoji-len=" + emoji.length.toString());
    if (string.fromBytes(emoji.toBytes()) == "😀") { print("emoji-roundtrip"); }
    if ("café" == s) { print("eq-literal"); }
    return 0;
}
