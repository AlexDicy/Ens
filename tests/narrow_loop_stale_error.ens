// @expect-error Cannot read a member of 'Door?' because it may be null here. Check 'door' for null first ('if (door != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'text' for null first ('if (text != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'first' for null first ('if (first != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. Check 'inner' for null first ('if (inner != null)').
// @expect-error build failed with 7 problems
// A narrowing established before a loop is stale once a later write in the loop can store a value it
// does not cover, because the read runs again on the next iteration after that write. Such a
// narrowing is dropped at the loop's entry, so the read is rejected. A write through parentheses
// names the same local, a write in the condition of a 'while' or a 'for' runs before every pass but
// the first, and a write that stores a local whose narrowing the loop drops can store null too.
class Door {
    protected int code;

    protected constructor(this.code = 0);
}

plain() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            door = null;                // later write kills the narrowing
        }
        return total;
    }
    return 0;
}

parenthesized() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            (door) = null;              // the same write, through parentheses
        }
        return total;
    }
    return 0;
}

pick(int round) -> string? {
    return round > 1 ? "ab" : null;
}

whileCondition() -> int {
    string? text = "abc";
    int round = 0;
    while (text.length > 5 || (text = pick(round)) == null) {  // refused, stale after the write
        round = round + 1;
    }
    return round;
}

forCondition() -> int {
    string? text = "abc";
    int round = 0;
    for (; text.length > 5 || (text = pick(round)) == null; round = round + 1) {  // refused the same way
    }
    return round;
}

chained() -> long {
    string? first = "a";
    string? second = "b";
    long total = 0;
    for (int i = 0; i < 3; i = i + 1) {
        total = total + first.length;  // refused, 'second' is null from the second pass
        first = second;
        second = pick(i);
    }
    return total;
}

apply<T>(() -> T body) -> T {
    return body();
}

keep(() -> long body, long value) -> long {
    return body();
}

keep(() -> long body, string value) -> long {
    return body();
}

// A trial checks no lambda passed to a generic or an overloaded call, so the loop in each lambda is
// settled on its own, and the write after the read drops 'inner' where that loop starts.
inGenericCall(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (int i = 0; i < 2; i = i + 1) {
        total = total + name.length;
        name = "b";
        total = total + apply<long>(() -> {
            string? inner = "abc";
            long count = 0;
            while (count < 10) {
                count = count + inner.length;  // refused, null after the first pass
                inner = pick(0);
            }
            return count;
        });
    }
    return total;
}

inOverloadedCall(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (int i = 0; i < 2; i = i + 1) {
        total = total + name.length;
        name = "b";
        total = total + keep(() -> {
            string? inner = "abc";
            long count = 0;
            for (int j = 0; j < 3; j = j + 1) {
                count = count + inner.length;  // refused the same way
                inner = pick(0);
            }
            return count;
        }, 1);
    }
    return total;
}

main() -> int {
    return plain() + parenthesized() + whileCondition() + forCondition() + chained() as int
        + inGenericCall("a") as int + inOverloadedCall("a") as int;
}
