// @expect-error Cannot read a member of 'Door?' because it may be null here. 'door' is not null when the loop starts, but the loop assigns it, so it may be null on a later pass. Check 'door' for null inside the loop ('if (door != null)').
// @expect-note 'door' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is not null when the loop starts, but the loop assigns it, so it may be null on a later pass.
// @expect-note 'text' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'first' is not null when the loop starts, but the loop assigns it, so it may be null on a later pass. Check 'first' for null inside the loop ('if (first != null)').
// @expect-note 'first' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'inner' is not null when the loop starts, but the loop assigns it, so it may be null on a later pass. Check 'inner' for null inside the loop ('if (inner != null)').
// @expect-note 'inner' is assigned here
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is assigned a 'Shape' in one branch of the 'if' statement, so 'shape' may be any 'Shape' here. Test 'shape' after the 'if' statement, as in 'if (shape is Circle)'.
// @expect-note 'shape' is assigned here
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is assigned a 'Shape' before 'continue', and the update runs after each 'continue', so 'shape' may be any 'Shape' here. Test 'shape' in the update by replacing 'shape.radius' with '(shape is Circle ? shape.radius : 0)'.
// @expect-error Type 'Shape' has no field or method named 'size'. 'shape' is assigned a 'Shape' in one branch of the 'if' statement, so 'shape' may be any 'Shape' here. Test 'shape' in the update by replacing 'shape.size()' with '(shape is Circle ? shape.size() : 0)'.
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is assigned a 'Shape' in one branch of the 'if' statement, so 'shape' may be any 'Shape' here. Test 'shape' in the update by replacing each 'shape.radius' with '(shape is Circle ? shape.radius : 0)'.
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is a 'Circle' when the loop starts, but the loop assigns it, so it may be any 'Shape' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Circle)'.
// @expect-error build failed with 13 problems
// A narrowing established before a loop is stale once a later write in the loop can store a value it
// does not cover, because the read runs again on the next iteration after that write. Such a
// narrowing is dropped at the loop's entry, so the read is rejected. A write through parentheses
// names the same local, a write in the condition of a 'while' or a 'for' runs before every pass but
// the first, and a write that stores a local whose narrowing the loop drops can store null too. A
// read the first pass reaches after a write in a branch names that write, with the test to write in a
// 'for' update where the read is there, and so does a read after a write that a test narrowed again.
class Door {
    protected int code;

    protected constructor(this.code = 0);
}

plain() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            door = null;                // later write kills the narrowing
        }
        return total;
    }
    return 0;
}

parenthesized() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            (door) = null;              // the same write, through parentheses
        }
        return total;
    }
    return 0;
}

pick(int round) -> string? {
    return round > 1 ? "ab" : null;
}

whileCondition() -> int {
    string? text = "abc";
    int round = 0;
    while (text.length > 5 || (text = pick(round)) == null) {  // refused, stale after the write
        round = round + 1;
    }
    return round;
}

forCondition() -> int {
    string? text = "abc";
    int round = 0;
    for (; text.length > 5 || (text = pick(round)) == null; round = round + 1) {  // refused the same way
    }
    return round;
}

chained() -> long {
    string? first = "a";
    string? second = "b";
    long total = 0;
    for (int i = 0; i < 3; i = i + 1) {
        total = total + first.length;  // refused, 'second' is null from the second pass
        first = second;
        second = pick(i);
    }
    return total;
}

apply<T>(() -> T body) -> T {
    return body();
}

keep(() -> long body, long value) -> long {
    return body();
}

keep(() -> long body, string value) -> long {
    return body();
}

// A trial checks no lambda passed to a generic or an overloaded call, so the loop in each lambda is
// settled on its own, and the write after the read drops 'inner' where that loop starts.
inGenericCall(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (int i = 0; i < 2; i = i + 1) {
        total = total + name.length;
        name = "b";
        total = total + apply<long>(() -> {
            string? inner = "abc";
            long count = 0;
            while (count < 10) {
                count = count + inner.length;  // refused, null after the first pass
                inner = pick(0);
            }
            return count;
        });
    }
    return total;
}

inOverloadedCall(string? name) -> long {
    if (name == null) {
        return -1;
    }
    long total = 0;
    for (int i = 0; i < 2; i = i + 1) {
        total = total + name.length;
        name = "b";
        total = total + keep(() -> {
            string? inner = "abc";
            long count = 0;
            for (int j = 0; j < 3; j = j + 1) {
                count = count + inner.length;  // refused the same way
                inner = pick(0);
            }
            return count;
        }, 1);
    }
    return total;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 2;

    protected constructor();

    size() -> int {
        return this.radius;
    }
}

class Square extends Shape {
    protected constructor();
}

branchInLoop(bool go, Shape shape, Shape other) -> int {
    shape = new Circle();
    int total = 0;
    while (go) {
        if (go) {
            shape = other;
        }
        total = total + shape.radius;
    }
    return total;
}

continueInUpdate(bool flag, Shape shape, Shape other) -> int {
    shape = new Circle();
    for (int i = 0; i < 3; i = i + shape.radius) {
        if (flag) {
            shape = other;
            continue;
        }
    }
    return 0;
}

methodInUpdate(bool flag, Shape shape, Shape other) -> int {
    shape = new Circle();
    for (int i = 0; i < 3; i = i + shape.size()) {
        if (flag) {
            shape = other;
        }
    }
    return 0;
}

twiceInUpdate(bool flag, Shape shape, Shape other) -> int {
    shape = new Circle();
    for (int i = 0; i < 3; i = shape.radius + shape.radius) {
        if (flag) {
            shape = other;
        }
    }
    return 0;
}

testedInLoop(bool go, Shape shape, Shape any) -> int {
    if (!(shape is Circle)) {
        return 0;
    }
    int total = 0;
    while (go) {
        total = total + shape.radius;
        shape = any;
        if (!(shape is Square)) {
            return 0;
        }
    }
    return total;
}

main() -> int {
    Shape circle = new Circle();
    return plain() + parenthesized() + whileCondition() + forCondition() + chained() as int
        + inGenericCall("a") as int + inOverloadedCall("a") as int + branchInLoop(true, circle, circle)
        + continueInUpdate(true, circle, circle) + methodInUpdate(true, circle, circle)
        + twiceInUpdate(true, circle, circle) + testedInLoop(true, circle, circle);
}
