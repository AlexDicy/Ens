// @expect-error Cannot read a member of 'Door?' because it may be null here. Check it for null first ('if (value != null)'), read it with '?.' to get a nullable result, or supply a fallback with '??'.
// @expect-error build failed with 2 problems
// A narrowing established before a loop is stale once a later body write kills it, because the
// read runs again on the next iteration after the local has been set to null. The one-pass
// analysis pre-clears such a narrowing at the loop's entry, so the read is rejected, and a write
// through parentheses names the same local, so it is pre-cleared the same way.
class Door {
    protected int code;

    protected constructor(this.code = 0);
}

plain() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            door = null;                // later write kills the narrowing
        }
        return total;
    }
    return 0;
}

parenthesized() -> int {
    Door? door = new Door(5);
    if (door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + door.code;  // refused, stale on the second iteration
            (door) = null;              // the same write, through parentheses
        }
        return total;
    }
    return 0;
}

main() -> int {
    return plain() + parenthesized();
}
