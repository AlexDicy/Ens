// @expect-error Cannot read a member of 'Door?'
// A narrowing established before a loop is stale once a later body write kills it:
// the read runs again on the next iteration, after `room.door` has been set to null.
// The one-pass analysis pre-clears such a narrowing at the loop's entry, so the read
// is rejected.
class Door {
    int code;

    protected constructor(this.code = 0);
}

class Room {
    protected Door? door;

    protected constructor(this.door = null);
}

main() -> int {
    let room = new Room(new Door(5));
    if (room.door != null) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + room.door.code;  // error - stale on the second iteration
            room.door = null;                // later write kills the narrowing
        }
        return total;
    }
    return 0;
}
