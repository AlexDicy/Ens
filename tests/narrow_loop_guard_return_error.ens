// @expect-error Function 'firstPositive' can reach the end of its body without returning a value
// A branch that ends in `continue` leaves the loop iteration, not the function, so a
// non-void function whose only return sits past such a guard can still fall off the end.
firstPositive(int[] values) -> int {
    for (let value in values) {
        if (value <= 0) {
            continue;
        }
        return value;
    }
}

main() -> int {
    return firstPositive([1, 2, 3]);
}
