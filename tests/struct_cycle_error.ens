// @expect-error Struct 'Chain' contains itself: field 'next' of 'Chain' has type 'Chain?'. A struct keeps its fields inside itself, so every 'Chain' would contain another 'Chain' without end. Make 'Chain' a class, as in 'class Chain { ... }', because a class field only refers to another object.
// @expect-error Structs 'Hub', 'Left' and 'Right' contain each other through the fields listed below. A struct keeps its fields inside itself, so each of these structs would contain another of them without end. Make 'Hub' a class, as in 'class Hub { ... }', because a class field only refers to another object.
// @expect-note field 'left' of 'Hub' has type 'Left'
// @expect-note field 'right' of 'Hub' has type 'Right'
// @expect-note field 'hub' of 'Left' has type 'Hub?'
// @expect-note field 'hub' of 'Right' has type 'Hub?'
// @expect-error Struct 'Knot' contains itself: field 'first' of 'Knot' has type 'Knot?' and field 'second' of 'Knot' has type 'Knot?'. A struct keeps its fields inside itself, so every 'Knot' would contain another 'Knot' without end. Make 'Knot' a class, as in 'class Knot { ... }', because a class field only refers to another object.
// @expect-error build failed with 3 problems
// A struct stores its fields inline, so no chain of by-value fields may loop
// back to the struct itself, directly or through another struct.
struct Chain {
    Chain? next;
    long value = 0;
}

// Two cycles through 'Hub' are one problem, reported once from 'Hub' with every field of both.
struct Hub {
    Left left;
    Right right;
}

struct Left {
    Hub? hub;
}

struct Right {
    Hub? hub;
}

struct Knot {
    Knot? first;
    Knot? second;
}

main() -> int {
    return 0;
}
