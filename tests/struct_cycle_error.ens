// @expect-error Struct 'Chain' contains itself by value: field 'next' of 'Chain' has type 'Chain?'
// A struct stores its fields inline, so no chain of by-value fields may loop
// back to the struct itself, directly or through another struct.
struct Chain {
    Chain? next;
    long value = 0;
}

struct Wheel {
    Spoke spoke;
}

struct Spoke {
    Wheel? hub;
}

main() -> int {
    return 0;
}
