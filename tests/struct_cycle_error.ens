// @expect-error Struct 'Chain' contains itself by value: field 'next' of 'Chain' has type 'Chain?'. A struct's fields are stored inline, so this one would have no end. Break the cycle, for example by making 'Chain' a class ('class Chain { ... }') so the field holds a reference.
// A struct stores its fields inline, so no chain of by-value fields may loop
// back to the struct itself, directly or through another struct.
struct Chain {
    Chain? next;
    long value = 0;
}

struct Wheel {
    Spoke spoke;
}

struct Spoke {
    Wheel? hub;
}

main() -> int {
    return 0;
}
