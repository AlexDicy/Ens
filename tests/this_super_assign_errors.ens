// 'this' names the object a method runs on and 'super' names that same object as its base class,
// and no line can point either at a different one, in a method, a constructor, a destructor, or
// through a compound operator. Parentheses around one are reported as the write they hold, not as
// parentheses to remove, because removing them leaves the same write. The refusal redirects the
// write to a field the code can reach, and stops after saying what happened where the type has
// none to name.
// @expect-error 'this' is not a variable, so it cannot be assigned. Assign the fields that should change, as in 'this.value = ...'.
// @expect-error 'this' is not a variable, so it cannot be assigned. Assign the fields that should change, as in 'this.value += ...'.
// @expect-error '+=' needs numbers on both sides, got 'Box' and 'Box'.
// @expect-error 'this' is not a variable, so it cannot be assigned. Assign the fields that should change, as in 'this.x = ...'.
// @expect-error 'this' is not a variable, so it cannot be assigned.
// @expect-error 'super' is not a variable, so it cannot be assigned. Assign the fields that should change, as in 'super.value = ...'.
// @expect-error 'super' is not a variable, so it cannot be assigned. Assign the fields that should change, as in 'super.value += ...'.
// @expect-error '+=' needs numbers on both sides, got 'Base' and 'Base'.
// @expect-error build failed with 12 problems

public class Box {
    public int value = 0;

    public constructor();

    public constructor(Box other) {
        this = other;
    }

    destructor() {
        this = new Box();
    }

    public replace(Box other) {
        this = other;
        (this) = other;
        this += other;
    }
}

public struct Point {
    public int x = 0;

    public replace(Point other) {
        this = other;
    }
}

public class Frozen {
    public const int kept = 1;

    public constructor();

    public replace(Frozen other) {
        this = other;
    }
}

public class Base {
    public int value = 0;

    public constructor();
}

public class Derived extends Base {
    public constructor();

    public replace(Base other) {
        super = other;
        (super) = other;
        super += other;
    }
}

main() -> int {
    return 0;
}
