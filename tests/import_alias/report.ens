// A second file naming the same types and aliasing the same modules under other names: a name is
// file-local, and a type stays one type however each file spells it.
import Kind as Size from sizes.kinds;
import Kind as Shade from colors.kinds;
import sizes.kinds as sizes;
import colors.kinds as colors;

public describe(Size size, Shade color) -> string {
    return "{sizes.label(size)} {colors.label(color)}";
}
