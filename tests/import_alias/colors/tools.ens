import Kind from colors.kinds;
import colors.kinds;

public class Brush {
    public Kind color;

    public constructor(Kind color) {
        this.color = color;
    }
}

public class Palette {
    public static const int slots = 4;

    public static warm() -> Kind {
        return Kind.Red;
    }
}

public class Failure extends Error {
    public constructor(string message) {
        super(message);
    }
}

public paint(Brush brush) -> string {
    return "painted {kinds.label(brush.color)}";
}

public check(int slots) throws Failure {
    if (slots > Palette.slots) {
        throw new Failure("a palette holds {Palette.slots} colors, not {slots}");
    }
}
