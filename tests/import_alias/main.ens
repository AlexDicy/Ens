// @exit 0
// @stdout large red
// @stdout small blue
// @stdout ruler 30
// @stdout painted red
// @stdout measured 30 and 49
// @stdout unit 10 slots 4
// @stdout rulers 2
// @stdout ruler yes cube no
// @stdout spot 3
// @stdout a size cannot be negative, got -1
// @stdout a palette holds 4 colors, not 9
// @stdout large blue
// @stdout stepped 2
// @stdout a size cannot be negative, got -2
// Two enums named Kind and two modules named tools live in one file under aliases, and an alias
// reaches everything the name it replaces would: calls, types, generic arguments, throws lists,
// 'is' and 'as?' operands, statics, constructors and struct literals.
import Kind as SizeKind from sizes.kinds;
import Kind as ColorKind from colors.kinds;
import sizes.tools as sizing;
import sizes.tools as measuring;
import colors.tools as coloring;
import Ruler as Measure from sizes.tools;
import Failure as SizeFailure from sizes.tools;
import Point as Spot from sizes.tools;
import Palette as Palette from colors.tools;
import List from @std.collections.list;
import report;

public class Cube implements sizing.Measurable {
    int edge;

    public constructor(int edge) {
        this.edge = edge;
    }

    public override size() -> int {
        return this.edge * this.edge;
    }
}

nameOf(SizeKind kind) -> string {
    return switch (kind) {
        Small -> "small",
        Large -> "large",
    };
}

nameOfColor(ColorKind kind) -> string {
    return switch (kind) {
        Red -> "red",
        Blue -> "blue",
    };
}

checkBoth(int size, int slots) throws SizeFailure, coloring.Failure {
    try sizing.check(size);
    try coloring.check(slots);
}

describeFailure(int size, int slots) -> string {
    try checkBoth(size, slots);
    return "fine";
} catch (SizeFailure e) {
    return e.message;
} catch (coloring.Failure e) {
    return e.message;
}

// The two fixes 'tests/import_alias_naming_errors' suggests, written here exactly as they read
// there: an aliased exception type inside a parenthesized function type, and the static call
// 'Palette.warm(...)' below.
runStep(((int) -> void throws SizeFailure) action, int size) -> string {
    try action(size);
    return "stepped {size}";
} catch (SizeFailure e) {
    return e.message;
}

tellApart(sizing.Measurable shape) -> string {
    string ruler = "no";
    if (shape is Measure) {
        ruler = "yes";
    }
    let maybeRuler = shape as? sizing.Ruler;
    if (maybeRuler == null) {
        ruler = "no";
    }
    string cube = "no";
    let maybeCube = shape as? Cube;
    if (maybeCube != null) {
        cube = "yes";
    }
    return "ruler {ruler} cube {cube}";
}

main() -> int {
    print("{nameOf(SizeKind.Large)} {nameOfColor(ColorKind.Red)}");
    print("{nameOf(sizing.kindOf(1))} {nameOfColor(ColorKind.Blue)}");
    sizing.Ruler ruler = new sizing.Ruler(3);
    print("ruler {ruler.size()}");
    print(coloring.paint(new coloring.Brush(Palette.warm())));
    let cube = new Cube(7);
    print("measured {measuring.measure(ruler)} and {sizing.measure(cube)}");
    print("unit {Measure.unit} slots {Palette.slots}");
    List<Measure> rulers = new List<Measure>();
    rulers.push(Measure.create(1));
    rulers.push(ruler);
    print("rulers {rulers.length()}");
    print(tellApart(ruler));
    Spot spot = {x: 1, y: 2};
    print("spot {spot.x + spot.y}");
    print(describeFailure(-1, 1));
    print(describeFailure(1, 9));
    print(report.describe(SizeKind.Large, ColorKind.Blue));
    print(runStep((value) -> try sizing.check(value), 2));
    print(runStep((value) -> try sizing.check(value), -2));
    return 0;
}
