// @exit 0
// @stdout one on standard output
// @stdout two on standard output
// @stderr first problem
// @stderr second problem: 42
// Both streams are asserted exactly, so a line written to the wrong one fails either way:
// system.writeError reaches standard error only, print standard output only.
import @std.system;

main() -> int {
    print("one on standard output");
    system.writeError("first problem");
    int code = 42;
    system.writeError("second problem: {code}");
    print("two on standard output");
    return 0;
}
