// @exit 0
// @stdout released left
// @stdout released right
// @stdout compared false
// @stdout released hashed
// @stdout hashed
// @stdout released text
// @stdout rendered cell text
// @stdout payload reads done
// @stdout released member
// @stdout member member
// @stdout released call
// @stdout described call
// @stdout released struct call
// @stdout call struct call
// @stdout released struct field
// @stdout field struct field
// @stdout shown void
// @stdout released void
// @stdout borrowed borrowed
// @stdout released borrowed
// @stdout receivers done
// @stdout described watched
// @stdout released watched
// @stdout replaced
// @stdout released replacement
// @stdout weak done
// @stdout shown present
// @stdout released present
// @stdout shown fallback
// @stdout released fallback
// @stdout coalesced
// @stdout released kept
// @stdout coalesce done
// @stdout released rendered item
// @stdout text item rendered item
// @stdout equals compared item other item
// @stdout released compared item
// @stdout equal false
// @stdout hash hashed item
// @stdout released hashed item
// @stdout hashed 11
// @stdout released other item
// @stdout shelf done
// What an optional operator holds lives only as long as the access that needs it. Comparing,
// hashing and rendering a struct optional read its payload where the pair keeps it, so a pair a
// call produced is released once the read is done, and a pair read out of a field that the item's
// own 'toString', 'equals' or 'hash' clears is retained until it returns. A '?.' or '?[' releases
// a receiver it produced, or the payload copy it called a method on, as the access ends, and a
// weak field's upgraded reference with it. A '??' hands its value on, so a call it is passed to
// releases it once the call returns. Each Probe reports its own release, so a value kept too long
// prints late and a missed release never prints.
class Probe {
    protected string label;

    protected constructor(this.label);

    destructor() {
        print("released " + this.label);
    }

    protected describe() -> string {
        return "described " + this.label;
    }
}

struct Cell {
    protected Probe probe;

    protected name() -> string {
        return this.probe.label;
    }

    protected show() {
        print("shown " + this.probe.label);
    }

    override toString() -> string {
        return "cell " + this.probe.label;
    }
}

// An item whose own 'toString', 'equals' and 'hash' take it off the shelf that holds it, which
// releases the shelf's pair while the behavior still reads the item.
struct Item {
    protected Probe probe;
    protected Shelf shelf;

    override toString() -> string {
        this.shelf.item = null;
        return "item " + this.probe.label;
    }

    override equals(Item other) -> bool {
        this.shelf.item = null;
        print("equals " + this.probe.label + " " + other.probe.label);
        return this.probe.label == other.probe.label;
    }

    override hash() -> long {
        this.shelf.item = null;
        print("hash " + this.probe.label);
        return this.probe.label.length;
    }
}

class Shelf {
    protected Item? item;

    protected constructor() {
        this.item = null;
    }
}

class Watcher {
    protected weak Probe? seen;

    protected constructor() {}
}

cell(string label) -> Cell? {
    return {probe: new Probe(label)};
}

probe(string label) -> Probe? {
    return new Probe(label);
}

missing() -> Probe? {
    return null;
}

fallback(string label) -> Probe {
    return new Probe(label);
}

show(Probe probe) {
    print("shown " + probe.label);
}

main() -> int {
    {
        print("compared " + (cell("left") == cell("right")).toString());
        long hashed = cell("hashed").hash();
        print("hashed");
        print("rendered {cell("text")}");
    }
    print("payload reads done");

    {
        print("member " + (probe("member")?.label ?? "none"));
        print(probe("call")?.describe() ?? "none");
        print("call " + (cell("struct call")?.name() ?? "none"));
        print("field " + (cell("struct field")?.probe?.label ?? "none"));
        cell("void")?.show();
        Cell? kept = cell("borrowed");
        print("borrowed " + (kept?.name() ?? "none"));
    }
    print("receivers done");

    {
        let watcher = new Watcher();
        Probe target = new Probe("watched");
        watcher.seen = target;
        print(watcher.seen?.describe() ?? "none");
        target = new Probe("replacement");
        print("replaced");
    }
    print("weak done");

    {
        show(probe("present") ?? fallback("unused"));
        show(missing() ?? fallback("fallback"));
        Probe kept = probe("kept") ?? fallback("spare");
        print("coalesced");
    }
    print("coalesce done");

    {
        let shelf = new Shelf();
        Item? other = {probe: new Probe("other item"), shelf: shelf};
        shelf.item = {probe: new Probe("rendered item"), shelf: shelf};
        print("text {shelf.item}");
        shelf.item = {probe: new Probe("compared item"), shelf: shelf};
        print("equal " + (shelf.item == other).toString());
        shelf.item = {probe: new Probe("hashed item"), shelf: shelf};
        print("hashed " + shelf.item.hash().toString());
    }
    print("shelf done");
    return 0;
}
