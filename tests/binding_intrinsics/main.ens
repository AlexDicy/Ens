// @stdlib ../binding_intrinsics_stdlib
// @stdout empty: true false
// @stdout byte: 104 101
// @stdout part: el tail: llo whole: hello
// @stdout starts: true false
// @stdout bytes: 5 first: 104
// @stdout radix: ff 255 decimal: 255
// @stdout joined: one|two
// @exit 0
// The members the standard library declares for a primitive without a body: the compiler
// implements those, the library's own Ens is written over them, and a program reaches all of it
// with no import, because the binding modules load for every program.
import @std.text.builder;

main() -> int {
    let text = "hello";
    print("empty: {"".isEmpty()} {text.isEmpty()}");
    print("byte: {text.byteAt(0)} {text.byteAt(1)}");

    // The two-argument form replaces the compiler's member of that name; the one-argument form is
    // an overload it never had.
    print("part: {text.substring(1, 3)} tail: {text.substring(2)} whole: {text.substring(0)}");
    print("starts: {text.startsWith("hell")} {text.startsWith("jell")}");

    byte[] raw = text.toBytes();
    print("bytes: {raw.length} first: {raw[0]}");

    // 'toString' with an argument is the library's; without one it is still the compiler's.
    long count = 255;
    print("radix: {count.toString(16)} {count.toString(10)} decimal: {count.toString()}");

    print("joined: {builder.joined(["one", "|", "two"])}");
    return 0;
}
