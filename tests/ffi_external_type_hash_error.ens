// @expect-error does not support hashing a 'Handle?' yet
// @expect-error does not support hashing a 'Handle' yet
// @expect-error build failed with 2 problems
// @expect-error-at codegen a handle satisfies the Hashable contract as far as sema is
// concerned, so the refusal belongs to the phase that would have to fold the value.
// A foreign handle is an address the program was handed and knows nothing else about, so it has
// no content to fold. Both spellings are refused the same way, and neither may fall through to a
// value nothing wrote.
external type Handle;

external from libc {
    malloc(long size) -> Handle;
}

grab() -> Handle? {
    return malloc(8);
}

hashOfNullable() -> long {
    return grab().hash();
}

hashOfHandle(Handle handle) -> long {
    return handle.hash();
}

main() -> int {
    return hashOfNullable() != 0 && hashOfHandle(malloc(8)) != 0 ? 0 : 1;
}
