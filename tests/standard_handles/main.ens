// @stdlib ../standard_handles_stdlib
// @stdout out: through the handle
// @stdout input handle is usable: true
// @stderr err: through the handle
// @exit 0
// Each standard stream reached through the handle the compiler hands over, which is the only way
// to reach one: C names all three with a macro no foreign declaration can refer to.
import @std.system;

main() -> int {
    system.writeOut("out: through the handle");
    system.writeErr("err: through the handle");
    print("input handle is usable: {system.inputUsable()}");
    return 0;
}
