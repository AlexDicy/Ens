// @exit 134
// @stderr-contains panic: tried to peek at an empty priority queue. Check isEmpty() first
// Peeking is a read rather than a removal, so it aborts in its own words.
import PriorityQueue from @std.collections.priorityqueue;

main() -> int {
    let empty = new PriorityQueue<int>((a, b) -> a - b);
    return empty.peek();
}
