// @expect-error 'shape' is still a 'Shape' here, because comparing an 'as?' cast with null does not narrow 'shape'. Write '!(shape is Circle) || shape.radius > 0' to narrow it.
// @expect-error 'shape' is still a 'Shape' here, because comparing an 'as?' cast with null does not narrow 'shape'. Write 'shape is Circle ? shape.radius : 0' to narrow it.
// @expect-error 'shape' is still a 'Shape' here, because comparing an 'as?' cast with null does not narrow 'shape'. Write 'while (shape is Circle)' to narrow it.
// @expect-error Type 'Shape' has no field or method named 'radius'. 'box.shape' is a field, so it can change at any time. A later read of it can be another type even after a type test. Copy it into a local first ('let shape = box.shape;') and test the local.
// @expect-error build failed with 4 problems
// An 'as?' cast compared with null narrows nothing, so a read that needs the cast's type is refused
// with the 'is' test to write, in each place a condition narrows. A type arm narrows only a place
// that cannot change, so a field it switches on is not narrowed.
sealed abstract class Shape {
    protected constructor();
}

final class Circle extends Shape {
    int radius = 1;

    constructor();
}

final class Square extends Shape {
    int side = 1;

    constructor();
}

final class Box {
    Shape shape = new Circle();

    constructor();
}

disjunction(Shape shape) -> bool {
    return (shape as? Circle) == null || shape.radius > 0;
}

ternary(Shape shape) -> int {
    return (shape as? Circle) != null ? shape.radius : 0;
}

loop(Shape shape) -> int {
    int total = 0;
    while ((shape as? Circle) != null) {
        total = total + shape.radius;
    }
    return total;
}

field(Box box) -> int {
    return switch (box.shape) {
        is Circle -> box.shape.radius,
        is Square -> 0,
    };
}

main() -> int {
    return ternary(new Circle()) + loop(new Square()) + field(new Box());
}
