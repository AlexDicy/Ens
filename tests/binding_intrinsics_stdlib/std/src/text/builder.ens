// A second module of the same library reaching the unchecked construction. The binding declares it
// 'public' rather than file-private for exactly this: text assembled byte by byte here is valid by
// construction, so nothing revalidates it.
export joined(string[] parts) -> string {
    long total = 0;
    for (let part in parts) {
        total = total + part.length;
    }
    byte[] bytes = new byte[total];
    long at = 0;
    for (let part in parts) {
        for (long i = 0; i < part.length; i++) {
            bytes[at] = part.byteAt(i);
            at = at + 1;
        }
    }
    return string.fromBytesUnchecked(bytes);
}
