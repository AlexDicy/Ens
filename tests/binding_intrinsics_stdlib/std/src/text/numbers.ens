// A miniature of the 'long' binding the standard library carries, which every program reads. Its
// 'toString' takes an argument, which the compiler's own no-argument 'toString' is left alongside
// rather than replaced by. Only what the fixture calls is written, so negative values are absent.
primitive long {
    export toString(int radix) -> string {
        long value = this;
        string digits = "";
        while (value > 0) {
            digits = "0123456789abcdefghijklmnopqrstuvwxyz".substring(value % radix,
                value % radix + 1) + digits;
            value = value / radix;
        }
        return digits.isEmpty() ? "0" : digits;
    }
}
