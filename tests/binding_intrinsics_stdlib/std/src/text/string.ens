// A miniature of the binding the standard library carries for 'string': the four members the
// compiler implements, named here without bodies, and the ordinary Ens written over them. Two of
// the four stay unexported, so the unchecked forms are reachable inside this library and nowhere
// else.
primitive string {
    export byteAt(long index) -> byte;

    export toBytes() -> byte[];

    public sliceUnchecked(long start, long end) -> string;

    public static fromBytesUnchecked(byte[] bytes) -> string;

    export isEmpty() -> bool {
        return this.length == 0;
    }

    // The bytes in [start, end), which replaces the member the compiler provides under this name.
    export substring(long start, long end) -> string {
        return this.sliceUnchecked(start, end);
    }

    // What the compiler never provided: the same name at a shape of its own.
    export substring(long start) -> string {
        return this.sliceUnchecked(start, this.length);
    }

    export startsWith(string prefix) -> bool {
        if (prefix.length > this.length) {
            return false;
        }
        for (long i = 0; i < prefix.length; i++) {
            if (this.byteAt(i) != prefix.byteAt(i)) {
                return false;
            }
        }
        return true;
    }
}
