// @expect-error Method 'hash' of 'Widget' replaces the built-in identity hash but is not marked 'override'. Write 'override' before 'hash'.
class Widget {
    int id;
    constructor(this.id);
    hash() -> long { return this.id; }
    override equals(Widget other) -> bool { return this.id == other.id; }
}

main() -> int {
    return 0;
}
