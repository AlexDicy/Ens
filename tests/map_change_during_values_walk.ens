// @exit 134
// @stdout walked 1
// @stderr-contains panic: map changed during a walk: finish the walk before changing it, or use removeWhere
// A values view walks the live map, so a clear inside the walk aborts on the next step.
import Map from @std.collections.map;

main() -> int {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    long walked = 0;
    for (let value in ages.values()) {
        walked = walked + 1;
        print("walked {walked}");
        ages.clear();
    }
    return 0;
}
