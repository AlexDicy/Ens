// @exit 0
// @stdout compared false
// @stdout released element 0
// @stdout struct box 0
// @stdout released box 2
// @stdout element element 2
// @stdout relabeled label 4
// @stdout holder done
// @stdout released element 2
// @stdout released box 0
// @stdout released box 3
// @stdout released element 3
// @stdout holder gone
// @stdout text probe first
// @stdout equals second other
// @stdout released second
// @stdout equal false
// @stdout hash third
// @stdout released third
// @stdout hashed 5
// @stdout shelf done
// @stdout released first
// @stdout released other
// @stdout shelf gone
// A value read out of a field or an array element stays the value that was read, and stays alive,
// until what uses it is done, when a later part of the same expression may replace that storage:
// a call, a constructor, a destructor a released value runs, or a user's 'equals', 'hash' or
// 'toString'. Each Probe reports its own release, so an early release prints out of order and a
// missed one never prints.
class Probe {
    string label;
    weak Shelf? shelf;

    constructor(this.label) {
        this.shelf = null;
    }

    destructor() {
        print("released " + this.label);
        this.label = "freed";
    }

    override toString() -> string {
        this.clearShelf();
        return "probe " + this.label;
    }

    override equals(Probe other) -> bool {
        this.clearShelf();
        print("equals " + this.label + " " + other.label);
        return this.label == other.label;
    }

    override hash() -> long {
        this.clearShelf();
        print("hash " + this.label);
        return this.label.length;
    }

    clearShelf() {
        let shelf = this.shelf;
        if (shelf != null) {
            shelf.item = null;
        }
    }
}

struct Box {
    Probe probe;
}

class Holder {
    string label;
    Box box;
    Box[] boxes;
    int changes;

    constructor() {
        this.label = "label 0";
        this.box = {probe: new Probe("box 0")};
        this.boxes = [{probe: new Probe("element 0")}];
        this.changes = 0;
    }

    relabel() -> string {
        this.changes = this.changes + 1;
        this.label = "label {this.changes}";
        return this.label;
    }

    reset() -> int {
        this.changes = this.changes + 1;
        this.box = {probe: new Probe("box {this.changes}")};
        this.boxes[0] = {probe: new Probe("element {this.changes}")};
        return 0;
    }
}

class Shelf {
    Probe? item;

    constructor() {
        this.item = null;
    }

    stock(string label) {
        let probe = new Probe(label);
        probe.shelf = this;
        this.item = probe;
    }
}

boxed(Box first, int ignored) -> string {
    return first.probe.label;
}

main() -> int {
    {
        let holder = new Holder();
        print("compared " + (holder.label == holder.relabel()).toString());
        print("struct " + boxed(holder.box, holder.reset()));
        print("element " + boxed(holder.boxes[0], holder.reset()));
        if (holder.label == "missing") {
            print("never");
        } else if (holder.label == holder.relabel()) {
            print("never");
        } else {
            print("relabeled " + holder.label);
        }
        print("holder done");
    }
    print("holder gone");

    {
        let shelf = new Shelf();
        Probe other = new Probe("other");
        shelf.stock("first");
        print("text {shelf.item}");
        shelf.stock("second");
        print("equal " + (shelf.item == other).toString());
        shelf.stock("third");
        print("hashed " + (shelf.item?.hash() ?? -1).toString());
        print("shelf done");
    }
    print("shelf gone");
    return 0;
}
