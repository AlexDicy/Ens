// @exit 0
// @stdout world at 7
// @stdout missing gives -1
// @stdout empty needle at 0
// @stdout prefix at 0
// @stdout suffix at 6
// @stdout has ell
// @stdout no needle too long
// @stdout self at 0
// @stdout found in concat
// Happy-path coverage for string search: indexOf byte offsets (start, middle,
// end, absent, empty needle, needle longer than the haystack) and contains,
// including non-literal receivers built at runtime.
main() -> int {
    let text = "hello, world";
    print("world at " + text.indexOf("world").toString());
    print("missing gives " + text.indexOf("moon").toString());
    print("empty needle at " + text.indexOf("").toString());
    print("prefix at " + text.indexOf("hello").toString());
    let overlap = "abababcd";
    print("suffix at " + overlap.indexOf("cd").toString());
    if (text.contains("ell")) { print("has ell"); }
    if (!"ab".contains("abc")) { print("no needle too long"); }
    print("self at " + text.indexOf(text).toString());
    let built = "wor" + "ld";
    if (text.contains(built)) { print("found in concat"); }
    return 0;
}
