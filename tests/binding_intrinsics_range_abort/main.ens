// @stdlib ../binding_intrinsics_stdlib
// @exit 134
// @stderr-contains panic: tried to take the sliceUnchecked 1..9 of a string of 2 bytes. Check that the start is at least 0 and at most the end, and that the end is at most length
// The range guard the compiler implements names the member it was asked for, so a library calling
// the unchecked member reads the unchecked member's name back rather than its own.
main() -> int {
    let text = "hi";
    return text.substring(1, 9).length as int;
}
