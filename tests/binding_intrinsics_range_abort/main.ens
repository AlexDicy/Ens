// @stdlib ../binding_intrinsics_stdlib
// @exit 134
// @stderr panic: tried to take the sliceUnchecked from 1 to 9 of a string of 2 bytes. Check that the start is at least 0 and at most the end, and that the end is at most the string's length
// @stderr   at string.substring (string.ens:20)
// @stderr   at main (main.ens:10)
// The range guard the compiler implements names the member it was asked for, so a library calling
// the unchecked member reads the unchecked member's name back rather than its own.
main() -> int {
    let text = "hi";
    return text.substring(1, 9).length as int;
}
