// @expect-error is dead
class DbError extends Error { DbError(string m) { super(m); } }
class ParseError extends Error { ParseError(string m) { super(m); } }
class Repo {
    query() -> int throws { throw new DbError("x"); }
    handle() -> int {
        return try this.query();
    } catch (DbError e) {
        return 1;
    } catch (ParseError e) {     // body never throws ParseError
        return 2;
    }
}
main() -> int { return 0; }