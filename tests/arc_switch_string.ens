// @exit 0
// @stdout arc done
// Stresses ownership of an owned string scrutinee: each iteration switches
// over a freshly built string, in expression and statement form and through
// a nullable scrutinee, which must free without leaking or double-freeing.
main() -> int {
    let i = 0;
    let matched = 0;
    while (i < 1000) {
        let hits = switch ("key-" + (i % 3).toString()) {
            "key-0" -> 1,
            "key-1" -> 1,
            default -> 0,
        };
        matched = matched + hits;

        switch ("mode-{i % 2}") {
            "mode-0", "mode-1" -> { matched = matched + 1; },
            default -> { matched = matched - 1000; },
        }

        string? tag = null;
        if (i % 2 == 0) { tag = "tag-" + i.toString(); }
        matched = matched + switch (tag) {
            null -> 1,
            default -> 1,
        };
        i = i + 1;
    }
    print("arc done");
    return matched - 2667;
}
