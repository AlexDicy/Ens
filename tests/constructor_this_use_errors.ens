// @expect-error 'describe' is called on 'this' before field 'label' of class 'Called' has a value, and 'describe' may read 'label'. Assign 'label' before this call, for example 'this.label = ...;'.
// @expect-error 'super.describe()' is called before field 'label' of class 'BaseCalled' has a value, and the code it runs may read 'label'. Assign 'label' before this call, for example 'this.label = ...;'.
// @expect-error 'this' is passed to 'show' before field 'label' of class 'Passed' has a value, and 'show' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is passed to the constructor of 'Holder' before field 'label' of class 'Held' has a value, and the constructor of 'Holder' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error '==' calls 'equals' on 'this' before field 'label' of class 'Compared' has a value, and 'equals' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error '!=' passes 'this' to 'equals' before field 'label' of class 'Matched' has a value, and 'equals' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error '{this}' calls 'toString' on 'this' before field 'label' of class 'Printed' has a value, and 'toString' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is stored in 'kept' before field 'label' of class 'Kept' has a value, and code that uses 'kept' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is stored in field 'next' before field 'label' of class 'Linked' has a value, and code that uses 'next' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is stored in 'chosen' before field 'label' of class 'Chosen' has a value, and code that uses 'chosen' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error This lambda uses 'this', and it is created before field 'label' of class 'Deferred' has a value, so calling it may read 'label'. Assign 'label' before this lambda, for example 'this.label = ...;'.
// @expect-error 'describe' is called on 'this' in the arguments of 'super(...)', before base class 'Named' is constructed, and 'describe' may read the fields of 'Named'. Pass 'super(...)' a value that does not come from 'this', such as a parameter of the constructor.
// @expect-error 'twice' is called on 'this' before field 'tag' of struct 'Point' has a value, and 'twice' may read 'tag'. Assign 'tag' before this call, for example 'this.tag = ...;'.
// @expect-error 'render' is called on 'this' in this 'catch' clause, and 'render' may read field 'label' of class 'Rendered'. When 'checkedCount' throws 'Shortage', the body has not assigned 'label' yet. Assign 'label' in the clause before this call, for example 'this.label = ...;'.
// @expect-error This lambda in a 'catch' clause uses 'this', so calling it may read field 'label' of class 'Captured'. When the body throws 'Shortage', it has not assigned 'label' yet. Assign 'label' in the clause before this lambda, for example 'this.label = ...;'.
// @expect-error 'describe' is called on 'this' in this 'catch' clause, and 'describe' may read field 'name' of base class 'Named'. When 'checkedName' throws 'Refusal' in the arguments of 'super(...)', 'Named' is not constructed yet. Remove this call, or remove this 'catch' clause and move the call to 'checkedName' into a function that catches 'Refusal' and returns a value to pass to 'super(...)'.
// @expect-error 'this' is passed to 'show' before field 'label' of class 'Offered' has a value, and 'show' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is put in an array before field 'label' of class 'Listed' has a value, and code that reads the array may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error 'this' is stored in 'narrowed' before field 'label' of class 'Switched' has a value, and code that uses 'narrowed' may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.
// @expect-error This lambda uses 'this', and it is created before field 'callback' of class 'Remembered' has a value, because 'callback' gets its value from the lambda. Until every field has a value, 'this' can only be used to read and write its fields and to test its type with 'is'. Give 'callback' a default value, as in '() -> string callback = () -> "";', so that every field has a value when the lambda is created.
// @expect-error build failed with 20 problems
// Until every field that needs a value has one, own and inherited, a constructor uses 'this' only
// to read and write its fields and to test its type with 'is'. A method call on 'this' or 'super',
// 'this' passed to a call, stored, put in an array, named by a switch arm or used on its own, its
// text form, a comparison with '==' or '!=', and a lambda that uses 'this' are refused before then,
// each once for the first field still missing. A lambda stored in the field that is missing is
// refused for that field. In a catch clause the same holds where the clause catches a throw that
// leaves the field without a value.
class Refusal extends Error {
    constructor() {
        super("refused");
    }
}

class Shortage extends Error {
    constructor() {
        super("short");
    }
}

checkedName(string text) -> string throws Refusal {
    if (text.length == 0) {
        throw new Refusal();
    }
    return text;
}

checkedCount(int value) -> int throws Shortage {
    if (value < 0) {
        throw new Shortage();
    }
    return value;
}

class Named {
    protected string name;

    protected constructor(this.name);

    protected describe() -> string {
        return this.name;
    }
}

show(Named shown) {
}

class Holder {
    constructor(Named held) {
    }
}

class Called extends Named {
    string label;

    constructor() {
        super("n");
        print(this.describe());
        print(this.label);
        this.label = "set";
    }
}

class BaseCalled extends Named {
    string label;

    constructor() {
        super("n");
        print(super.describe());
        this.label = "set";
    }
}

class Passed extends Named {
    string label;

    constructor() {
        super("n");
        show(this);
        this.label = "set";
    }
}

class Held extends Named {
    string label;

    constructor() {
        super("n");
        let holder = new Holder(this);
        this.label = "set";
    }
}

class Compared extends Named {
    string label;

    constructor(Named other) {
        super("n");
        if (this == other) {
            print("same");
        }
        this.label = "set";
    }
}

class Matched extends Named {
    string label;

    constructor(Named other) {
        super("n");
        if (other != this) {
            print("different");
        }
        this.label = "set";
    }
}

class Printed extends Named {
    string label;

    constructor() {
        super("n");
        print("printed {this}");
        this.label = "set";
    }
}

class Kept extends Named {
    string label;

    constructor() {
        super("n");
        Named kept = this;
        this.label = "set";
    }
}

class Linked extends Named {
    string label;
    Named? next;

    constructor() {
        super("n");
        this.next = this;
        this.label = "set";
    }
}

class Chosen extends Named {
    string label;

    constructor(bool flag, Named other) {
        super("n");
        Named chosen = flag ? this : other;
        this.label = "set";
    }
}

class Deferred extends Named {
    string label;

    constructor() {
        super("n");
        () -> void later = () -> {
            print(this.label);
        };
        later();
        this.label = "set";
    }
}

class Early extends Named {
    constructor() {
        super(this.describe());
    }
}

struct Point {
    int x;
    string tag;

    constructor() {
        this.x = this.twice();
        this.tag = "p";
    }

    twice() -> int {
        return 2;
    }
}

class Rendered {
    string label;
    int count;

    constructor(int value) {
        this.count = try checkedCount(value);
        this.label = "set";
    } catch (Shortage shortage) {
        print(this.render());
        this.label = "fallback";
    }

    render() -> string {
        return this.label;
    }
}

class Captured {
    string label;

    constructor(bool fail) {
        if (fail) {
            throw new Shortage();
        }
        this.label = "set";
    } catch (Shortage shortage) {
        () -> void later = () -> {
            print(this.label);
        };
        this.label = "fallback";
    }
}

class Unbuilt extends Named {
    constructor(string text) {
        super(try checkedName(text));
    } catch (Refusal refusal) {
        print(this.describe());
        panic("a name is required");
    }
}

class Offered extends Named {
    string label;

    constructor(bool flag) {
        super("n");
        show(flag ? this : new Named("other"));
        this.label = "set";
    }
}

class Listed extends Named {
    string label;

    constructor() {
        super("n");
        Named[] all = [this];
        this.label = "set";
    }
}

class Switched extends Named {
    string label;

    constructor() {
        super("n");
        string kind = switch (this) {
            is Narrowed narrowed -> narrowed.name,
            default -> "plain",
        };
        this.label = kind;
    }
}

class Narrowed extends Switched {
}

class Remembered {
    string label;
    () -> string callback;

    constructor() {
        this.label = "set";
        this.callback = () -> this.label;
    }
}

main() -> int {
    return 0;
}
