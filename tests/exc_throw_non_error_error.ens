// report nothing more.
class Widget {}
class Repo {
    f() -> int throws { throw new Widget(); }   // not an Error subclass
}

thrower() {
    throw new Widget();
}

fetch() -> int throws Widget {
    return 1;
}

caller() -> int {
    thrower();
