// @exit 0
// @stdout context program
// @stdout upcast program
// @stdout new program
// @stdout local program
// @stdout same program
// @stdout returned upcast program
// @stdout boxed program
// @stdout kept program
// A reference read out of a field of an object passed to a call stays alive while it is used, even
// once that call is inlined and the object is released right after it, when the object was the
// only owner of what the field holds: passed as it was made, renamed to a base class on the way
// in, or built by 'new' in the argument itself. It stays alive just the same when the object comes
// back out of an inlined call that returns its argument as it is or as its base class, when a
// later argument replaces the field the object was read from, and when a local keeps the object
// an inlined call returns. A Program renames itself when it is released, so a read after the
// release prints the wrong name or faults.
class Program {
    string label;

    constructor(this.label);

    destructor() {
        this.label = "released";
    }
}

class Base {
    Program held;

    constructor(this.held);
}

class Context extends Base {
    constructor(Program held) {
        super(held);
    }
}

class Box {
    Base base;

    constructor(this.base);

    replace() -> int {
        this.base = plan("replacement");
        return 0;
    }
}

plan(string label) -> Context {
    return new Context(new Program(label));
}

same(Context context) -> Context {
    return context;
}

asBase(Context context) -> Base {
    return context;
}

held(Context context) -> Program {
    return context.held;
}

heldOf(Base base) -> Program {
    return base.held;
}

heldBeside(Base base, int ignored) -> Program {
    return base.held;
}

show(Program program) -> string {
    return program.label + " program";
}

main() -> int {
    print(show(held(plan("context"))));
    print(show(heldOf(plan("upcast"))));
    print(show(heldOf(new Context(new Program("new")))));
    let context = plan("local");
    print(show(heldOf(context)));
    print(show(heldOf(same(plan("same")))));
    print(show(heldOf(asBase(plan("returned upcast")))));
    let box = new Box(plan("boxed"));
    print(show(heldBeside(box.base, box.replace())));
    let kept = plan("kept");
    print(show(heldOf(same(kept))));
    return 0;
}
