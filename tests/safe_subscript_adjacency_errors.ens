// @expect-error The two question marks of '??' must be written together, with nothing between them. Write 'value ?? fallback', which uses 'fallback' when 'value' is null.
// @expect-error This conditional expression is missing its ':'. Write 'condition ? valueWhenTrue : valueWhenFalse', with ':' between the two results. If you meant to index a value that may be null, write '?[' with no space before the bracket, for example 'rows?[0]'.
// @expect-error This conditional expression is missing its ':'. Write 'condition ? valueWhenTrue : valueWhenFalse', with ':' between the two results.
// @expect-error Expected an expression, for example a value like '42', a variable name, or a call
// @expect-error build failed with 5 problems
// The two spellings a space breaks, each naming the form that works. A separated '??' is read as
// the operator anyway, because no expression begins with '?', so its one message is the whole
// report rather than the head of a cascade. A conditional missing its ':' still reports the second
// branch it could not read afterwards, which is what any unfinished conditional does.
main() -> int {
    int? count = null;
    int chosen = count ? ? 7;

    int[]? rows = [1, 2];
    int? first = rows ? [0];

    bool ready = true;
    int either = ready ? 1;
    return chosen + (first ?? 0) + either;
}
