// @exit 0
// @stdout 8 0
// @stdout 3 30
// @stdout 4
// @stdout 6 1 9
// @stdout 1 2
// @stdout 1 only
// @stdout 1 5
// @stdout a/b/c
// @stdout / . 10 21 true
// @stdout 7:9
// @stdout (5, hi)
// @stdout parsed 42
// @stdout fallback -1
// A 'static' member belongs to the type and is reached through the type name, including the three
// ways a generic type's arguments reach a static call: written on the type name, inferred from the
// call's own arguments, and target-typed from the surrounding context.

public class Registry<T> {
    // Nullable slots because a registry holds capacity beyond its length, and a slot nothing has
    // written is no value of 'T'.
    T?[] slots;
    long used;

    public constructor(T?[] slots, long used) {
        this.slots = slots;
        this.used = used;
    }

    public static withCapacity(long capacity) -> Registry<T> {
        return new Registry<T>(new T?[capacity], 0);
    }

    public static of(T[] values) -> Registry<T> {
        T?[] copied = new T?[values.length];
        for (long i = 0; i < copied.length; i++) {
            copied[i] = values[i];
        }
        return new Registry<T>(copied, values.length);
    }

    public static single(T value) -> Registry<T> {
        return Registry.of([value]);
    }

    public static fromEither(T? maybe, T fallback) -> Registry<T> {
        let value = maybe;
        if (value == null) {
            return Registry.single(fallback);
        }
        return Registry.single(value);
    }

    public capacity() -> long {
        return this.slots.length;
    }

    public length() -> long {
        return this.used;
    }

    public get(long index) -> T {
        let value = this.slots[index];
        if (value == null) {
            panic("registry slot {index} holds no value");
        }
        return value;
    }
}

public class Path {
    public static const string separator = "/";
    public static const int limit = 10;
    public static const int doubled = Path.limit * 2 + 1;
    public static const bool enabled = true;
    public static const char marker = '.';

    public static join(string left, string right) -> string {
        return left + Path.separator + right;
    }
}

public struct Point {
    public int x;
    public int y;

    public static at(int x, int y) -> Point {
        return {x: x, y: y};
    }

    public shifted(int dx) -> Point {
        return Point.at(this.x + dx, this.y);
    }
}

public struct Pair<A, B> {
    public A first;
    public B second;

    public static of(A first, B second) -> Pair<A, B> {
        return {first: first, second: second};
    }
}

public class Parsed {
    public const int value;

    public constructor(this.value);

    public static parse(string text) -> Parsed throws {
        if (text.length == 0) {
            throw new Failure("nothing to parse");
        }
        return new Parsed(42);
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

consume(Registry<string> names) -> long {
    return names.capacity();
}

build() -> Registry<char> {
    return Registry.withCapacity(9);
}

describe(Pair<int, string> pair) -> string {
    return "({pair.first}, {pair.second})";
}

parseOr(string text, int fallback) -> int {
    let parsed = try Parsed.parse(text);
    return parsed.value;
} catch (Error e) {
    return fallback;
}

main() -> int {
    let explicit = Registry<int>.withCapacity(8);
    print("{explicit.capacity()} {explicit.length()}");
    let inferred = Registry.of([10, 20, 30]);
    print("{inferred.length()} {inferred.get(2)}");
    Registry<string> targeted = Registry.withCapacity(4);
    print("{targeted.capacity()}");
    targeted = Registry.withCapacity(6);
    print("{targeted.capacity()} {consume(Registry.withCapacity(1))} {build().capacity()}");
    Registry<bool>[] grid = [Registry.withCapacity(1), Registry.withCapacity(2)];
    print("{grid[0].capacity()} {grid[1].capacity()}");
    let solo = Registry<string>.single("only");
    print("{solo.length()} {solo.get(0)}");
    let either = Registry.fromEither(null, 5);
    print("{either.length()} {either.get(0)}");
    print(Path.join(Path.join("a", "b"), "c"));
    print("{Path.separator} {Path.marker} {Path.limit} {Path.doubled} {Path.enabled}");
    let moved = Point.at(3, 9).shifted(4);
    print("{moved.x}:{moved.y}");
    print(describe(Pair.of(5, "hi")));
    print("parsed {parseOr("x", -1)}");
    print("fallback {parseOr("", -1)}");
    return 0;
}
