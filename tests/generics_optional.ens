// @exit 0
// @stdout list-string get milk
// @stdout list-string null ok
// @stdout list-string coalesce fallback
// @stdout list-string nulls 1 of 3
// @stdout list-string pop tea
// @stdout list-int zero-vs-null ok
// @stdout list-int coalesce -1
// @stdout list-int set-null ok
// @stdout list-int array ok
// @stdout map get 0
// @stdout map stored-null vs missing ok
// @stdout map coalesce -6 -5
// @stdout map overwrite ok
// @stdout map values 3 present 2
// @stdout box value gift
// @stdout box narrowed 4
// @stdout box empty ok
// @stdout identity explicit ok
// @stdout identity inferred 3
// @stdout nested inner deep
// @stdout nested empty ok

// Generic types instantiated with optional type arguments: standard List and
// Map, a user-defined generic class, generic functions with explicit and
// inferred optional arguments, and one level of nesting.
import List from @std.collections.list;
import Map from @std.collections.map;

class Box<T> {
    T item;

    protected constructor(this.item);

    protected value() -> T {
        return this.item;
    }
}

identity<T>(T value) -> T {
    return value;
}

main() -> int {
    // List<string?>: reference elements that may be null.
    let words = new List<string?>();
    words.push("milk");
    words.push(null);
    words.push("tea");

    string? first = words.get(0);
    if (first != null) {
        print("list-string get " + first);
    }
    if (words.get(1) == null) {
        print("list-string null ok");
    }
    string chosen = words.get(1) ?? "fallback";
    print("list-string coalesce " + chosen);

    long nullCount = 0;
    for (let word in words) {
        if (word == null) {
            nullCount = nullCount + 1;
        }
    }
    print("list-string nulls " + nullCount + " of " + words.length());

    string? popped = words.pop();
    if (popped != null) {
        print("list-string pop " + popped);
    }

    // List<int?>: nullable value-type elements keep 0 and null distinct.
    let counts = new List<int?>();
    counts.push(0);
    counts.push(null);
    counts.push(7);
    if (counts.get(0) != null && counts.get(0) == 0 && counts.get(1) == null) {
        print("list-int zero-vs-null ok");
    }

    int coalesced = counts.get(1) ?? -1;
    print("list-int coalesce " + coalesced);

    counts.set(0, null);
    if (counts.get(0) == null && counts.get(2) == 7) {
        print("list-int set-null ok");
    }

    int?[] copied = counts.toArray();
    if (copied.length == 3 && copied[0] == null && copied[2] == 7) {
        print("list-int array ok");
    }

    // Map<string, int?>: 'get' returns V?, so with V = int? the result is doubly nullable. The
    // outer level says whether the key is there and the inner one is the value stored under it,
    // so a stored null and a missing key are different answers without asking contains().
    let scores = new Map<string, int?>();
    scores.set("zero", 0);
    scores.set("none", null);
    scores.set("seven", 7);

    let found = scores.get("zero");
    if (found != null) {
        int? zero = found;
        if (zero != null && zero == 0) {
            print("map get " + zero);
        }
    }

    let storedNull = scores.get("none");
    let absentKey = scores.get("missing");
    if (storedNull != null && (storedNull ?? null) == null && absentKey == null
            && scores.contains("none") && !scores.contains("missing")) {
        print("map stored-null vs missing ok");
    }

    int fallback = (scores.get("none") ?? -5) ?? -6;
    int missing = (scores.get("missing") ?? -5) ?? -6;
    print("map coalesce " + fallback + " " + missing);

    scores.set("seven", null);
    scores.set("none", 6);
    if ((scores.get("seven") ?? null) == null && (scores.get("none") ?? null) == 6
            && scores.length() == 3) {
        print("map overwrite ok");
    }

    int?[] stored = scores.values();
    long presentCount = 0;
    for (let value in stored) {
        if (value != null) {
            presentCount = presentCount + 1;
        }
    }
    print("map values " + stored.length + " present " + presentCount);

    // A user-defined generic class holding an optional field.
    let gift = new Box<string?>("gift");
    string? content = gift.value();
    if (content != null) {
        print("box value " + content);
    }

    string? held = gift.value();
    if (held != null) {
        print("box narrowed " + held.length);
    }

    let empty = new Box<string?>(null);
    if (empty.value() == null) {
        print("box empty ok");
    }

    // Generic functions with an optional type argument.
    string? nothing = identity<string?>(null);
    string? something = identity<string?>("here");
    if (nothing == null && something != null) {
        print("identity explicit ok");
    }

    int? seed = identity<int?>(3);
    let inferred = identity(seed);
    if (inferred != null && inferred == 3) {
        print("identity inferred " + inferred);
    }

    // One level of nesting: a Box of an optional Box of an optional string.
    let inner = new Box<string?>("deep");
    let full = new Box<Box<string?>?>(inner);
    Box<string?>? wrapped = full.value();
    if (wrapped != null) {
        string? deep = wrapped.value();
        if (deep != null) {
            print("nested inner " + deep);
        }
    }

    let hollow = new Box<Box<string?>?>(null);
    if (hollow.value() == null) {
        print("nested empty ok");
    }

    return 0;
}
