// @exit 134
// @stderr-contains panic: tried to insert at index 4 of a list of length 1. Check the index against length() first
// An insert takes an index up to the length, so one beyond that aborts and names the operation the
// caller asked for rather than the read a get would have made.
import List from @std.collections.list;

main() -> int {
    let items = new List<int>();
    items.push(7);
    items.insert(4, 9);
    return items.length() as int;
}
