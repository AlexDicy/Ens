// @exit 0
// @stdout child: input false, output false, error false
// The program starts itself as the child with a pipe on each of its three streams, so none of
// them is a terminal on any system the suite runs on, however the suite itself was started.
import @std.environment;
import Path from @std.fs;
import @std.io;
import @std.process;

main() -> int {
    string[] arguments = environment.arguments();
    if (arguments.length > 0) {
        print("input {io.in().isTerminal()}, output {io.out().isTerminal()}, error "
            + "{io.err().isTerminal()}");
        return 0;
    }
    return try parent();
} catch (Error e) {
    eprint("io_is_terminal: {e.message}");
    return 1;
}

parent() -> int throws {
    Path? found = environment.executablePath();
    if (found == null) {
        eprint("this system would not report the path of this program");
        return 1;
    }
    let child = try process.spawn(found, ["child"]);
    string? line = try child.stdout().readLine();
    let status = try child.wait();
    print("child: " + (line ?? "<nothing>"));
    return status.code;
}
