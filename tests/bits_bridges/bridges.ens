// The four bit-pattern bridges the compiler synthesizes wherever they are named, declared here
// because nothing in the standard library reaches them yet. Each direction is a reinterpretation of
// the same bytes, so the four are declared together.

external from libc {
    ens_double_bits(double value) -> ulong;
    ens_double_from_bits(ulong bits) -> double;
    ens_float_bits(float value) -> uint;
    ens_float_from_bits(uint bits) -> float;
}

// The IEEE bits of a `double`, with its sign in the top bit.
public doubleBits(double value) -> ulong {
    return ens_double_bits(value);
}

// The `double` those bits spell.
public doubleFromBits(ulong bits) -> double {
    return ens_double_from_bits(bits);
}

// The IEEE bits of a `float`, with its sign in the top bit.
public floatBits(float value) -> uint {
    return ens_float_bits(value);
}

// The `float` those bits spell.
public floatFromBits(uint bits) -> float {
    return ens_float_from_bits(bits);
}
