// The bit-pattern bridge the compiler synthesizes wherever it is named, declared here so the test
// reaches it with nothing of the standard library in between.

external from libc {
    ens_double_from_bits(ulong bits) -> double;
}

// The `double` those bits spell.
public doubleFromBits(ulong bits) -> double {
    return ens_double_from_bits(bits);
}
