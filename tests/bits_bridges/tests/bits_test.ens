// What the bridge answers about a pattern. The bits of a value are the same on every host, so the
// expected pattern is written out and not read off the machine.
import @std.testing;
import bridges;

// The exponent field filled over a zero mantissa, which a reader can check against the IEEE layout
// by hand.
final class Pattern {
    protected static const ulong infinity = 0x7FF0000000000000;
}

// The largest magnitude a `double` holds.
final class Largest {
    protected static const double doubleMagnitude = 1.7976931348623157e308;
}

// The exponent field filled over a zero mantissa is the one pattern above every number, so the
// value it spells has to outrank the largest magnitude the type holds.
test "the pattern one exponent above the numbers is an infinity" {
    double beyond = bridges.doubleFromBits(Pattern.infinity);
    try testing.assertTrue(beyond > Largest.doubleMagnitude,
        "{beyond} does not sit above the largest double {Largest.doubleMagnitude}");
    try testing.assertTrue(beyond.isInfinite(), "{beyond} is not one of the two infinities");
}
