// What the four bridges answer about a value and about a pattern. The bits of a value are the same
// on every host, so each expected pattern is written out and none of them is read off the machine.
import @std.testing;
import bridges;

// The patterns a reader can check against the IEEE layout by hand: one, the sign bit alone, the
// exponent above every number, a NaN with a payload no arithmetic would produce, and the smallest
// magnitude, at each width.
final class Pattern {
    protected static const ulong one = 0x3FF0000000000000;
    protected static const ulong signBit = 0x8000000000000000;
    protected static const ulong infinity = 0x7FF0000000000000;
    protected static const ulong payloadNaN = 0x7FF8DEADBEEF0000;
    protected static const ulong smallest = 0x0000000000000001;

    protected static const uint floatOne = 0x3F800000;
    protected static const uint floatSignBit = 0x80000000;
    protected static const uint floatSmallest = 0x00000001;
}

// The largest magnitude each type holds, both written as the `double` that equals it exactly.
final class Largest {
    protected static const double doubleMagnitude = 1.7976931348623157e308;
    protected static const double floatMagnitude = 3.4028234663852886e38;
}

// The smallest magnitude a `double` holds, which is a subnormal, reached by halving until one more
// halving would land on zero.
smallestDouble() -> double {
    double value = 1.0;
    while (value * 0.5 > 0.0) {
        value = value * 0.5;
    }
    return value;
}

// The smallest magnitude a `float` holds, which is a subnormal, reached the same way.
smallestFloat() -> float {
    float half = 0.5;
    float zero = 0.0;
    float value = 1.0;
    while (value * half > zero) {
        value = value * half;
    }
    return value;
}

// Both signs of zero, both ends of the range, a subnormal, and ordinary numbers in between.
finiteDoubles() -> double[] {
    double largest = Largest.doubleMagnitude;
    return [0.0, -0.0, 1.0, -1.0, 0.5, 3.141592653589793, largest, -largest, smallestDouble()];
}

// The same spread at the narrower width.
finiteFloats() -> float[] {
    float largest = Largest.floatMagnitude as float;
    float pi = 3.1415927;
    float one = 1.0;
    float half = 0.5;
    float zero = 0.0;
    return [zero, -zero, one, -one, half, pi, largest, -largest, smallestFloat()];
}

test "one, the zeros and the smallest double have the patterns IEEE spells" {
    ulong noBits = 0;
    try testing.assertEqual(bridges.doubleBits(1.0), Pattern.one);
    try testing.assertEqual(bridges.doubleBits(0.0), noBits);
    try testing.assertEqual(bridges.doubleBits(-0.0), Pattern.signBit);
    try testing.assertEqual(bridges.doubleBits(smallestDouble()), Pattern.smallest);
}

test "one, the zeros and the smallest float have the patterns IEEE spells" {
    uint noBits = 0;
    float one = 1.0;
    float zero = 0.0;
    try testing.assertEqual(bridges.floatBits(one), Pattern.floatOne);
    try testing.assertEqual(bridges.floatBits(zero), noBits);
    try testing.assertEqual(bridges.floatBits(-zero), Pattern.floatSignBit);
    try testing.assertEqual(bridges.floatBits(smallestFloat()), Pattern.floatSmallest);
}

// A NaN is the one value with bits to spare, and nothing along either bridge reads it as a number,
// so the payload it was built from comes back.
test "a NaN keeps the payload it was built from" {
    double notANumber = bridges.doubleFromBits(Pattern.payloadNaN);
    try testing.assertTrue(notANumber.isNaN(), "the payload pattern did not build a NaN");
    try testing.assertEqual(bridges.doubleBits(notANumber), Pattern.payloadNaN);
}

// The order `compareTo` puts two values in tells the two zeros apart, so a round trip that dropped
// the sign of a zero fails here rather than passing on equality.
test "every finite double comes back out of its bits unchanged" {
    for (let value in finiteDoubles()) {
        try testing.assertTrue(value.isFinite(),
            "the spread names {value}, which is not a finite value");
        double returned = bridges.doubleFromBits(bridges.doubleBits(value));
        try testing.assertTrue(returned.compareTo(value) == 0,
            "{value} came back as {returned} through its bits");
    }
}

test "every finite float comes back out of its bits unchanged" {
    for (let value in finiteFloats()) {
        try testing.assertTrue(value.isFinite(),
            "the spread names {value}, which is not a finite value");
        float returned = bridges.floatFromBits(bridges.floatBits(value));
        try testing.assertTrue(returned.compareTo(value) == 0,
            "{value} came back as {returned} through its bits");
    }
}

// The exponent field filled over a zero mantissa is the one pattern above every number, so the
// value it spells has to outrank the largest magnitude the type holds.
test "the pattern one exponent above the numbers is an infinity" {
    double beyond = bridges.doubleFromBits(Pattern.infinity);
    try testing.assertTrue(beyond > Largest.doubleMagnitude,
        "{beyond} does not sit above the largest double {Largest.doubleMagnitude}");
    try testing.assertTrue(beyond.isInfinite(), "{beyond} is not one of the two infinities");
}
