// @expect-error Method 'speak' cannot be 'weak'; 'weak' goes on a class field that refers to an object without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.
// @expect-error Method 'describe' cannot be 'sealed'; 'sealed' goes on a class, where it means only the same module can extend it. Remove 'sealed'.
// @expect-error A constructor cannot be 'const'; 'const' goes on a field or a variable inside a function, as in 'const string name;' or 'const limit = 10'. Remove 'const'.
// @expect-error A destructor cannot be 'weak'; 'weak' goes on a class field that refers to an object without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.
// @expect-error Function 'first' cannot be 'override'; 'override' is for a method that replaces one the type inherits. Remove 'override'.
// @expect-error Function 'second' cannot be 'final'; 'final' stops a method from being overridden or a class from being extended. Remove 'final'.
// @expect-error Function 'third' cannot be 'abstract'; 'abstract' is for a method with no body, which each subclass then writes for itself. Remove 'abstract'.
// @expect-error Function 'fourth' cannot be 'const'; 'const' goes on a field or a variable inside a function, as in 'const string name;' or 'const limit = 10'. Remove 'const'.
// 'weak' belongs to a class field, 'sealed' to a class, and 'const' to a field or a local
// declaration, so no callable carries any of them. A top-level function also refuses the dispatch
// markers, because nothing inherits a function. Each shape here is read by its own phase.

interface Speaker {
    weak speak() -> string;
}

struct Point {
    int x;

    sealed describe() -> int {
        return this.x;
    }
}

class Box {
    protected int tag = 0;

    const constructor();

    weak destructor() {
        print("gone");
    }
}

override first() -> int {
    return 1;
}

final second() -> int {
    return 2;
}

abstract third() -> int {
    return 3;
}

const fourth() -> int {
    return 4;
}

main() -> int {
    Point point = {x: 1};
    print("{point.x}");
    return 0;
}
