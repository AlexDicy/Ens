// @expect-error Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type from 'mask', a 'byte'. Declare 'bits' as 'ushort' and convert 'mask' ('ushort bits = mask as ushort & 300;').
// A bitwise operator adapts an untyped literal to the other side, so a literal the type
// cannot hold is refused there just as it is in a declaration.
main() -> int {
    byte mask = 0x0F;
    byte bits = mask & 300;
    return bits as int;
}
