// @expect-error Literal 300 does not fit in 'byte' (range 0..255)
// A bitwise operator adapts an untyped literal to the other side, so a literal the type
// cannot hold is refused there just as it is in a declaration.
main() -> int {
    byte mask = 0x0F;
    byte bits = mask & 300;
    return bits as int;
}
