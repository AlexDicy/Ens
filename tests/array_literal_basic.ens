// @exit 42
main() -> int {
    // Typed declaration drives element type and literal-element adaptation.
    int[] xs = [10, 20, 30, 40, 0];
    if (xs.length != 5L) { return 1; }
    int sum = xs[0] + xs[1] + xs[2] + xs[3] + xs[4];
    if (sum != 100) { return 2; }

    // First-wins inference.
    let zs = [1, 2, 3];
    if (zs.length != 3L) { return 3; }
    if (zs[0] + zs[1] + zs[2] != 6) { return 4; }

    // Empty literal with a target type is allowed.
    int[] empty = [];
    if (empty.length != 0L) { return 5; }

    // char/int narrow to byte through analyzeExprAdapt.
    byte[] buf = ['H', 'i', 0];
    if (buf.length != 3L) { return 6; }

    // Target type adapts int literals to long (1 and 3 widen, 2L matches).
    long[] ys = [1, 2L, 3];
    if (ys[0] != 1L) { return 7; }
    if (ys[1] != 2L) { return 8; }
    if (ys[2] != 3L) { return 9; }

    // Nested literals.
    let g = [[1, 2], [3, 4]];
    if (g.length != 2L) { return 10; }
    if (g[0].length != 2L) { return 11; }
    if (g[1][1] != 4) { return 12; }

    // Empty inner adopts target from the first inner literal.
    let h = [[1], []];
    if (h.length != 2L) { return 13; }
    if (h[1].length != 0L) { return 14; }

    return 42;
}
