// A local array passed to a constructor escapes into the object, so it must not be
// stack-promoted even when the constructor call is its only use. The list push used to
// crash when the same empty array literal was stored into two fields of the new object.
// @exit 7
import List from @std.collections.list;

class Holder {
    private long[] first;
    private long[] second;

    Holder(long[] first, long[] second) {
        this.first = first;
        this.second = second;
    }

    total() -> long {
        long sum = this.first.length + this.second.length;
        for (let value in this.first) {
            sum = sum + value;
        }
        return sum;
    }
}

private makeEmptyHolder() -> Holder {
    let items = new List<Holder>();
    long[] none = [];
    let holder = new Holder(none, none);
    items.push(holder);
    return items.get(0);
}

main() -> int {
    let empty = makeEmptyHolder();
    long[] values = [1, 2];
    let full = new Holder(values, values);
    return (empty.total() + full.total()) as int;
}
