// @exit 0
// @stdout list-remove 3
// @stdout list-remove-where 1
// @stdout list-clear 0
// @stdout list-grow 100
// @stdout list-grow-clear 0
// @stdout map-remove 2
// @stdout map-remove-where 1
// @stdout map-clear 0
// @stdout map-grow 100
// @stdout map-grow-clear 0
// @stdout set-remove-where 1
// @stdout view-alive 3
// @stdout view-released 0
// Every way a container drops values releases each one exactly once, counted by the values'
// destructors, and a view keeps the map it walks alive.
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import Iterable from @std.collections.iterator;

class Ledger {
    protected long live;

    protected constructor() {
        this.live = 0;
    }
}

class Payload {
    protected long tag;
    Ledger ledger;

    protected constructor(long tag, Ledger ledger) {
        this.tag = tag;
        this.ledger = ledger;
        ledger.live = ledger.live + 1;
    }

    destructor() {
        this.ledger.live = this.ledger.live - 1;
    }
}

filledList(Ledger ledger, long count) -> List<Payload> {
    let list = new List<Payload>();
    for (long i = 0; i < count; i++) {
        list.push(new Payload(i, ledger));
    }
    return list;
}

filledMap(Ledger ledger, long count) -> Map<long, Payload> {
    let map = new Map<long, Payload>();
    for (long i = 0; i < count; i++) {
        map.set(i, new Payload(i, ledger));
    }
    return map;
}

keysOf(Ledger ledger) -> Iterable<long> {
    let map = filledMap(ledger, 3);
    return map.keys();
}

main() -> int {
    let ledger = new Ledger();

    let list = filledList(ledger, 4);
    list.remove(list.get(1));
    print("list-remove {ledger.live}");
    list.removeWhere((payload) -> payload.tag != 0);
    print("list-remove-where {ledger.live}");
    list.clear();
    print("list-clear {ledger.live}");
    let grown = filledList(ledger, 100);
    print("list-grow {ledger.live}");
    grown.clear();
    print("list-grow-clear {ledger.live}");

    let map = filledMap(ledger, 3);
    map.remove(1);
    print("map-remove {ledger.live}");
    map.removeWhere((key, payload) -> key == 2);
    print("map-remove-where {ledger.live}");
    map.clear();
    print("map-clear {ledger.live}");
    let grownMap = filledMap(ledger, 100);
    print("map-grow {ledger.live}");
    grownMap.clear();
    print("map-grow-clear {ledger.live}");

    let set = new Set<Payload>();
    set.add(new Payload(1, ledger));
    set.add(new Payload(2, ledger));
    set.removeWhere((payload) -> payload.tag == 1);
    print("set-remove-where {ledger.live}");
    set.clear();

    if (true) {
        let keys = keysOf(ledger);
        print("view-alive {ledger.live}");
    }
    print("view-released {ledger.live}");
    return 0;
}
