// @exit 0
// @stdout is square yes
// @stdout is plain no
// @stdout cast 4
// @stdout cast miss
// @stdout iface-to-class dog
// @stdout iface-to-iface loud
// @stdout switch area 9
// @stdout switch loud
// @stdout switch dog
// @stdout switch speaker-default
interface Measurable {
    area() -> int;
}

interface Loud {
    shout() -> string;
}

interface Speaker {
    speak() -> string;
}

class Shape {
    protected constructor();
}

class Square extends Shape implements Measurable {
    int side;
    protected constructor(this.side);
    override area() -> int { return this.side * this.side; }
}

class Dog implements Speaker {
    protected constructor();
    protected override speak() -> string { return "dog"; }
}

class Megaphone implements Speaker, Loud {
    protected constructor();
    override speak() -> string { return "mega"; }
    override shout() -> string { return "loud"; }
}

class Robot implements Speaker {
    protected constructor();
    override speak() -> string { return "beep"; }
}

// Class scrutinee, interface target: decided at runtime.
classify(Shape s) -> string {
    if (s is Measurable) {
        return "yes";
    }
    return "no";
}

// as? with an interface target produces I?.
measureOrMiss(Shape s) -> string {
    Measurable? m = s as? Measurable;
    if (m != null) {
        return "" + m.area();
    }
    return "miss";
}

// A type switch over an interface scrutinee always needs a default:
// interfaces are open.
speakerKind(Speaker s) -> string {
    switch (s) {
        is Loud l -> { return "switch " + l.shout(); }
        is Dog -> { return "switch dog"; }
        default -> { return "switch speaker-default"; }
    }
}

main() -> int {
    print("is square " + classify(new Square(2)));
    print("is plain " + classify(new Shape()));
    print("cast " + measureOrMiss(new Square(2)));
    print("cast " + measureOrMiss(new Shape()));

    // Interface scrutinee against a class target.
    Speaker s = new Dog();
    if (s is Dog) {
        print("iface-to-class " + s.speak());
    }

    // Interface scrutinee against another interface target.
    Speaker m = new Megaphone();
    Loud? maybe = m as? Loud;
    if (maybe != null) {
        print("iface-to-iface " + maybe.shout());
    }

    // A switch over a class value can test interface arms; the binding
    // borrows the scrutinee at the interface type.
    Shape sq = new Square(3);
    switch (sq) {
        is Measurable meas -> { print("switch area " + meas.area()); }
        default -> { print("switch other"); }
    }

    print(speakerKind(new Megaphone()));
    print(speakerKind(new Dog()));
    print(speakerKind(new Robot()));
    return 0;
}
