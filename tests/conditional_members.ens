// @exit 0
// @stdout 10 20 30
// @stdout largest 30
// @stdout apple pear
// @stdout smallest 5
// @stdout smallest a
// @stdout rocks 1
// @stdout ranked(2)
// @stdout first 1 2
// @stdout plain(1)
// @stdout biggest 9
// @stdout pair 3 8
// @stdout grids 1
// @stdout Score
// @stdout accept 10
// @stdout labeled Score
// @stdout premium 5 ranked(1)
// Conditional members: a member's type-parameter list restates the enclosing type's parameters
// with a bound, and the member exists only on the instantiations that satisfy it. A non-satisfying
// instantiation stays usable for everything unconditional.
import List from @std.collections.list;

interface Comparable<T> {
    compareTo(T other) -> int;
}

interface Ranked<T> extends Comparable<T> {
    rank() -> int;
}

// Satisfies Comparable<Score> through the interface Ranked extends.
class Score implements Ranked<Score> {
    int points;

    protected constructor(this.points);

    protected override compareTo(Score other) -> int {
        return this.points - other.points;
    }

    protected override rank() -> int {
        return this.points;
    }
}

class Word implements Comparable<Word> {
    protected string text;

    protected constructor(this.text);

    protected override compareTo(Word other) -> int {
        if (this.text.compareTo(other.text) < 0) {
            return -1;
        }
        if (this.text == other.text) {
            return 0;
        }
        return 1;
    }
}

class Rock {
    protected constructor();
}

class Bag<T> {
    List<T> items;

    protected constructor() {
        this.items = new List<T>();
    }

    protected put(T value) {
        this.items.push(value);
    }

    protected get(long index) -> T {
        return this.items.get(index);
    }

    protected length() -> long {
        return this.items.length();
    }

    protected sort<T: Comparable<T>>() {
        for (long i = 0; i < this.items.length(); i++) {
            for (long j = i + 1; j < this.items.length(); j++) {
                if (this.items.get(j).compareTo(this.items.get(i)) < 0) {
                    T swapped = this.items.get(i);
                    this.items.set(i, this.items.get(j));
                    this.items.set(j, swapped);
                }
            }
        }
    }

    protected largest<T: Comparable<T>>() -> T {
        T best = this.items.get(0);
        for (long i = 1; i < this.items.length(); i++) {
            if (this.items.get(i).compareTo(best) > 0) {
                best = this.items.get(i);
            }
        }
        return best;
    }

    protected static smallestOf<T: Comparable<T>>(T first, T second) -> T {
        if (second.compareTo(first) < 0) {
            return second;
        }
        return first;
    }

    // Mentions another generic type: Tag's own interpolation obligation replays only for
    // instantiations this member exists on, so Bag<int[]> below stays legal.
    protected firstLabel<T: Comparable<T>>() -> string {
        Tag<T> tag = {value: this.items.get(0)};
        return tag.label();
    }

    // Mentions another generic type in signature position: the return and parameter types name
    // Tag<T>, and filling Bag<int[]> substitutes them without making Tag<int[]> real, so Tag's own
    // interpolation obligation replays only for instantiations this member exists on.
    protected makeTag<T: Comparable<T>>() -> Tag<T> {
        Tag<T> tag = {value: this.items.get(0)};
        return tag;
    }

    protected acceptTag<T: Comparable<T>>(Tag<T> tag) -> T {
        return tag.value;
    }
}

// A conditional constructor whose parameter type mentions another generic type.
class Labeled<T> {
    string shownText;

    protected constructor<T: Comparable<T>>(Tag<T> tag) {
        this.shownText = tag.label();
    }

    protected shown() -> string {
        return this.shownText;
    }
}

struct Tag<T> {
    protected T value;

    protected label() -> string {
        return "{this.value}";
    }
}

// The SortedSet shape: a conditional no-argument constructor beside an unconditional overload,
// and a conditional method whose body reaches another conditional member through the constraint.
class RankedBag<T> {
    Bag<T> inner;
    bool ranked;

    protected constructor<T: Comparable<T>>() {
        this.inner = new Bag<T>();
        this.ranked = true;
    }

    protected constructor(Bag<T> seed) {
        this.inner = seed;
        this.ranked = false;
    }

    protected add<T: Comparable<T>>(T value) {
        this.inner.put(value);
        this.inner.sort();
    }

    protected peek(long index) -> T {
        return this.inner.get(index);
    }

    protected describe() -> string {
        if (this.ranked) {
            return "ranked({this.inner.length()})";
        }
        return "plain({this.inner.length()})";
    }
}

// A constrained constructor chains implicitly to the base's conditional constructor: inside it,
// the constraint makes the base constructor exist.
class Premium<T> extends RankedBag<T> {
    protected constructor<T: Comparable<T>>() {
    }
}

struct Slot<T> {
    protected T value;

    protected biggest<T: Comparable<T>>(T other) -> T {
        if (other.compareTo(this.value) > 0) {
            return other;
        }
        return this.value;
    }
}

// A struct's conditional constructor.
struct PairOf<T> {
    protected T low;
    protected T high;

    protected constructor<T: Comparable<T>>(T first, T second) {
        if (second.compareTo(first) < 0) {
            this.low = second;
            this.high = first;
        } else {
            this.low = first;
            this.high = second;
        }
    }
}

main() -> int {
    let scores = new Bag<Score>();
    scores.put(new Score(30));
    scores.put(new Score(10));
    scores.put(new Score(20));
    scores.sort();
    print("{scores.get(0).rank()} {scores.get(1).rank()} {scores.get(2).rank()}");
    print("largest {scores.largest().rank()}");

    let words = new Bag<Word>();
    words.put(new Word("pear"));
    words.put(new Word("apple"));
    words.sort();
    print(words.get(0).text + " " + words.get(1).text);

    let low = Bag<Score>.smallestOf(new Score(7), new Score(5));
    print("smallest {low.rank()}");
    let lowWord = Bag.smallestOf(new Word("b"), new Word("a"));
    print("smallest " + lowWord.text);

    let rocks = new Bag<Rock>();
    rocks.put(new Rock());
    print("rocks {rocks.length()}");

    let ranked = new RankedBag<Score>();
    ranked.add(new Score(2));
    ranked.add(new Score(1));
    print(ranked.describe());
    print("first {ranked.peek(0).rank()} {ranked.peek(1).rank()}");

    let seeded = new RankedBag<Rock>(rocks);
    print(seeded.describe());

    Slot<Score> slot = {value: new Score(4)};
    print("biggest {slot.biggest(new Score(9)).rank()}");
    Slot<Rock> rockSlot = {value: new Rock()};

    let bounds = PairOf<Score>(new Score(8), new Score(3));
    print("pair {bounds.low.rank()} {bounds.high.rank()}");

    let grids = new Bag<int[]>();
    grids.put(new int[2]);
    Labeled<int[]>? unlabeled = null;
    print("grids {grids.length()}");
    print(scores.firstLabel());
    print("accept {scores.acceptTag(scores.makeTag()).rank()}");
    let labeled = new Labeled<Score>(scores.makeTag());
    print("labeled " + labeled.shown());

    let premium = new Premium<Score>();
    premium.add(new Score(5));
    print("premium {premium.peek(0).rank()} {premium.describe()}");

    return 0;
}
