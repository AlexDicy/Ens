// @exit 0
// @stdout join 41
// The narrowing after an if/else (or switch) is the intersection of the facts holding at the
// end of each branch that falls through. A reassignment in one branch and the failed check on
// the other both prove the value non-null, so it stays narrowed below the merge, and a switch
// whose every arm reassigns the value narrows it the same way.
class Leaf {
    int field;

    constructor(this.field = 1);
}

fallback() -> Leaf {
    return new Leaf(9);
}

// Reassign in the then-branch; the else-path carries the failed 'x == null' check.
reassignThen(Leaf? x) -> int {
    if (x == null) {
        x = fallback();
    }
    return x.field;
}

// Both branches prove the value non-null: the then-branch by reassignment, the empty else by
// the failed check.
bothBranches(Leaf? x) -> int {
    if (x == null) {
        x = fallback();
    } else {
    }
    return x.field;
}

// Reassign to non-null in the else-branch; the then-path carries the failed 'x != null' check.
reassignElse(Leaf? x) -> int {
    if (x != null) {
    } else {
        x = fallback();
    }
    return x.field;
}

// Every arm of an exhaustive switch reassigns the value to a non-null Leaf.
viaSwitch(int tag, Leaf? x) -> int {
    switch (tag) {
        1 -> {
            x = new Leaf(2);
        },
        2 -> {
            x = fallback();
        },
        default -> {
            x = fallback();
        },
    }
    return x.field;
}

main() -> int {
    int total = reassignThen(null)          // 9
        + reassignThen(new Leaf(3))         // 3
        + bothBranches(null)                // 9
        + reassignElse(null)                // 9
        + viaSwitch(1, null)                // 2
        + viaSwitch(9, new Leaf(5));        // 9
    print("join " + total);
    return total - 41;
}
