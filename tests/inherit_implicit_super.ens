// @exit 0
// @stdout derived sides=7
// @stdout plain v=5
// @stdout square label=shape
// @stdout crates int=box string=box
// @stdout leaf n=5
// @stdout chained n=5 extra=1
// @stdout super chained n=5 extra=2
// @stdout guarded plain=4 declared=4 leaf=4
// A base constructor whose parameters all have defaults must run on the
// implicit super call, both from a derived constructor that omits super(...)
// and when the derived class declares no constructor at all. The same holds
// over an abstract base and over a generic base at two type arguments. A
// chain whose middle class declares no constructor still runs the constructor
// of the class above it, with or without 'super()'. A private zero-argument
// constructor is out of a subclass's reach, so the implicit call runs the
// reachable one whose parameters all take defaults.
class Base {
    protected int sides;
    protected constructor(this.sides = 7);
}

class Derived extends Base {
    int extra;
    protected constructor() {
        this.extra = 1;
    }
}

class Holder {
    protected int v;
    constructor(int value = 5) {
        this.v = value;
    }
}

class Plain extends Holder {
}

abstract class Shape {
    protected string label = "none";

    protected constructor() {
        this.label = "shape";
    }
}

class Square extends Shape {
}

class Box<T> {
    protected string tag = "none";

    protected constructor() {
        this.tag = "box";
    }
}

class Crate<T> extends Box<T> {
}

class Grand {
    protected int n;

    protected constructor() {
        this.n = 5;
    }
}

class Middle extends Grand {
}

class Leaf extends Middle {
}

class Chained extends Middle {
    protected int extra;

    protected constructor() {
        this.extra = 1;
    }
}

class SuperChained extends Middle {
    protected int extra;

    protected constructor() {
        super();
        this.extra = 2;
    }
}

public class Guarded {
    protected int n;

    constructor() {
        this.n = 1;
    }

    protected constructor(int n = 4) {
        this.n = n;
    }
}

class GuardedPlain extends Guarded {
}

class GuardedDeclared extends Guarded {
    protected constructor() { }
}

class GuardedLeaf extends GuardedPlain {
    protected constructor() {
        super();
    }
}

main() -> int {
    let d = new Derived();
    print("derived sides=" + d.sides);
    let p = new Plain();
    print("plain v=" + p.v);
    let square = new Square();
    print("square label={square.label}");
    let ints = new Crate<int>();
    let strings = new Crate<string>();
    print("crates int={ints.tag} string={strings.tag}");
    let leaf = new Leaf();
    print("leaf n={leaf.n}");
    let chained = new Chained();
    print("chained n={chained.n} extra={chained.extra}");
    let superChained = new SuperChained();
    print("super chained n={superChained.n} extra={superChained.extra}");
    let guardedPlain = new GuardedPlain();
    let guardedDeclared = new GuardedDeclared();
    let guardedLeaf = new GuardedLeaf();
    print("guarded plain={guardedPlain.n} declared={guardedDeclared.n} leaf={guardedLeaf.n}");
    return 0;
}
