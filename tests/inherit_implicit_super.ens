// @exit 0
// @stdout derived sides=7
// @stdout plain v=5
// A base constructor whose parameters all have defaults must run on the
// implicit super call, both from a derived constructor that omits super(...)
// and when the derived class declares no constructor at all.
class Base {
    protected int sides;
    protected constructor(this.sides = 7);
}

class Derived extends Base {
    int extra;
    protected constructor() {
        this.extra = 1;
    }
}

class Holder {
    protected int v;
    constructor(int value = 5) {
        this.v = value;
    }
}

class Plain extends Holder {
}

main() -> int {
    let d = new Derived();
    print("derived sides=" + d.sides);
    let p = new Plain();
    print("plain v=" + p.v);
    return 0;
}
