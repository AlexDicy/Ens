// @expect-error Literal 1e400 is too large for 'double', whose largest value is about 1.797e308.
// A literal adapts only to a type that can hold its magnitude. 'double' is the widest
// floating-point type, so a literal past it is reported rather than quietly becoming infinity.
main() -> int {
    double tooLarge = 1e400;
    return tooLarge > 0.0 ? 0 : 1;
}
