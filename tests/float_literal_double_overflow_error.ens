// @expect-error Literal 1e400 is too large for 'double', which holds about 1.8e308 at most.
// The same rule guards the wider type, so a literal past every floating-point type is reported
// rather than quietly becoming infinity.
main() -> int {
    double tooLarge = 1e400;
    return tooLarge > 0.0 ? 0 : 1;
}
