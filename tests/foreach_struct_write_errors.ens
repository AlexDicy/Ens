// @expect-error Cannot use '+=' on 'counter.value', because 'counter' is a copy of an element of 'counters', so 'counters' would not change. Loop over the indexes of 'counters', as in 'for (long i = 0; i < counters.length; i++)', and write 'counters[i]' instead of 'counter'.
// @expect-error The '++' operator cannot change 'counter.value', because 'counter' is a copy of an element of 'counters', so 'counters' would not change. Loop over the indexes of 'counters', as in 'for (long i = 0; i < counters.length; i++)', and write 'counters[i]' instead of 'counter'.
// @expect-error Cannot call 'bump' on 'counter', because 'counter' is a copy of an element of 'counters', so 'counters' would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Loop over the indexes of 'counters', as in 'for (long i = 0; i < counters.length; i++)', and write 'counters[i]' instead of 'counter'.
// @expect-error Cannot assign to 'kept.value', because 'kept' is a copy of an element of 'counters', so 'counters' would not change. Loop over the indexes of 'counters', as in 'for (long i = 0; i < counters.length; i++)', and write 'counters[i]' instead of 'kept'.
// @expect-error Cannot assign to 'pair.left.value', because 'pair' is a copy of an element of 'pairs', so 'pairs' would not change. Loop over the indexes of 'pairs', as in 'for (long i = 0; i < pairs.length; i++)', and write 'pairs[i]' instead of 'pair'.
// @expect-error Cannot call 'bump' on 'pair.left', because 'pair' is a copy of an element of 'pairs', so 'pairs' would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Loop over the indexes of 'pairs', as in 'for (long i = 0; i < pairs.length; i++)', and write 'pairs[i]' instead of 'pair'.
// @expect-error Cannot assign to 'counter.value', because 'counter' is a copy of an element of the array 'makeCounters()' returns, so that array would not change. Store the array in a local first, as in 'let elements = makeCounters();', then loop over its indexes, as in 'for (long i = 0; i < elements.length; i++)', and write 'elements[i]' instead of 'counter'.
// @expect-error Cannot assign to 'counter.value', because 'counter' is a copy of an element of '[counters[0]]', so that array would not change.
// @expect-error Cannot call 'bump' on 'counter', because 'counter' is a copy of an element of '[counters[0]]', so that array would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on.
// @expect-error Cannot assign to 'counter.value', because 'counter' is a copy of a value 'bag' produces, so 'bag' would not change. Loop over the indexes of 'bag' instead, as in 'for (long i = 0; i < bag.length(); i++)', copy 'bag.get(i)' into a local, change the local, and store it back with 'bag.set(i, ...)'.
// @expect-error Cannot call 'bump' on 'counter', because 'counter' is a copy of a value from 'makeBag()', so it would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. If only the copy should change, copy 'counter' into a variable first, as in 'let changed = counter;'.
// @expect-error Cannot call 'bump' on 'counter' inside a lambda. 'bump' is 'mutating', which marks a method that changes the struct it is called on. A lambda works on copies of what it captures, so the 'counter' outside it would not change. Return the value the lambda computes and store it where the lambda is called, or keep the value in a field of an object the lambda uses.
// @expect-error Cannot call 'bump' on 'counter', because 'counter' is a copy of an element of 'shelf.counters', so 'shelf.counters' would not change. 'bump' is 'mutating', which marks a method that changes the struct it is called on. Loop over the indexes of 'shelf.counters', as in 'for (long i2 = 0; i2 < shelf.counters.length; i2++)', and write 'shelf.counters[i2]' instead of 'counter'.
// @expect-error build failed with 14 problems
// A for-each loop variable of struct type is a copy of the element the loop is on, so a write into
// one of its fields, at any depth and in any form, and a 'mutating' call on it are refused, while
// reading it, calling a method that changes nothing and changing a class element stay allowed.
import List from @std.collections.list;

struct Counter {
    int value;
    int[] history;

    mutating bump() {
        this.value += 1;
    }

    read() -> int {
        return this.value;
    }
}

struct Pair {
    Counter left;
}

class Box {
    int size = 0;
}

class Shelf {
    Counter[] counters = [];
}

makeCounters() -> Counter[] {
    return [{value: 0, history: []}];
}

makeBag() -> List<Counter> {
    return new List<Counter>();
}

writes(Counter[] counters, Pair[] pairs, List<Counter> bag) {
    for (let counter in counters) {
        counter.value = 5;
        counter.value += 1;
        counter.value++;
        counter.bump();
    }
    for (const kept in counters) {
        kept.value = 1;
    }
    for (Pair pair in pairs) {
        pair.left.value = 2;
        pair.left.bump();
    }
    for (let counter in makeCounters()) {
        counter.value = 3;
    }
    for (let counter in [counters[0]]) {
        counter.value = 6;
        counter.bump();
    }
    for (let counter in bag) {
        counter.value = 4;
    }
    for (let counter in makeBag()) {
        counter.bump();
    }
    for (let counter in counters) {
        () -> void later = () -> {
            counter.bump();
        };
        later();
    }
}

shelved(Shelf shelf) {
    long i = shelf.counters.length;
    print("{i} counters");
    for (let counter in shelf.counters) {
        counter.bump();
    }
}

allowed(Counter[] counters, Box[] boxes) -> int {
    int total = 0;
    for (let counter in counters) {
        total += counter.value + counter.read();
        counter.history[0] = 1;
        Counter copy = counter;
        copy.bump();
        counter = copy;
    }
    for (let box in boxes) {
        box.size = 2;
        box.size++;
    }
    return total;
}

main() -> int {
    return 0;
}
