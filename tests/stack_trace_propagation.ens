// @exit 1
// @stdout-contains Unhandled exception ParseError: bad token
// @stdout-contains at lex (stack_trace_propagation.ens:12)
// @stdout-contains at parse (stack_trace_propagation.ens:15)
// @stdout-contains at main (stack_trace_propagation.ens:18)
// Multi-hop propagation: the trace is captured at the originating throw (lex) and
// shows every caller up to main, never the last-running frame or a catcher.
class ParseError extends Error {
    constructor(string m) { super(m); }
}
lex() -> int throws {
    throw new ParseError("bad token");
}
parse() -> int throws {
    return try lex();
}
main() -> int throws {
    return try parse();
}