// @exit 1
// @stderr-contains Unhandled exception ParseError: bad token
// @stderr-contains-at O0 at lex (stack_trace_propagation.ens:14)
// @stderr-contains-at O2 at lex (stack_trace_propagation.ens:14, inlined)
// @stderr-contains-at O0 at parse (stack_trace_propagation.ens:17)
// @stderr-contains-at O2 at parse (stack_trace_propagation.ens:17, inlined)
// @stderr-contains at main (stack_trace_propagation.ens:20)
// Multi-hop propagation: the trace is captured at the originating throw (lex) and
// shows every caller up to main, never the last-running frame or a catcher.
class ParseError extends Error {
    protected constructor(string m) { super(m); }
}
lex() -> int throws {
    throw new ParseError("bad token");
}
parse() -> int throws {
    return try lex();
}
main() -> int throws {
    return try parse();
}