// @stdout out 1
// @stdout err through writeError
// @stdout out 2
// @stdout err through io.err()
// @stdout out 3
// @exit 0
// The order between standard output and standard error, which is only visible where the two arrive
// as one stream. Writing to standard error hands over everything already printed first.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Platform from @std.environment;
import @std.environment;
import @std.io;
import IoError from @std.io.streams;
import ProcessError from @std.process;
import @std.process;
import @std.system;

// The mixed sequence, written by the child so both of its streams reach one file in the order it
// wrote them.
emit() throws IoError {
    print("out 1");
    system.writeError("err through writeError");
    print("out 2");
    try io.err().write("err through io.err()\n".toBytes());
    print("out 3");
}

// Everything the child wrote, in order, echoed onto this program's own standard output. The child
// runs through the shell because one file behind both of its streams is what makes their order
// observable, and a redirection is what puts it there.
echoChild(Path self) throws {
    Path merged = (self.parent() ?? Path(".")).join("io_stream_order.merged");
    let ran = try process.runShell("\"" + shellPath(self) + "\" child > \""
        + shellPath(merged) + "\" 2>&1");
    if (!ran.status.succeeded()) {
        eprint("the child ended with code {ran.status.code}");
        return;
    }
    for (let line in (try merged.readText()).lines()) {
        print(line);
    }
    try merged.removeFile();
}

// A path as the platform's own command interpreter reads it: cmd.exe takes '\' between the parts of
// a program's path and refuses the '/' every path here carries, while every other shell takes the
// path exactly as it is.
shellPath(Path target) -> string {
    if (environment.platform() != Platform.Windows) {
        return target.toString();
    }
    return target.toString().replace("/", "\\");
}

main() -> int {
    let given = environment.arguments();
    if (given.length > 0 && given[0] == "child") {
        try emit();
        return 0;
    }
    Path? self = environment.executablePath();
    if (self == null) {
        eprint("this system would not report the path of this program");
        return 1;
    }
    try echoChild(self);
    return 0;
} catch (Error failure) {
    eprint(failure.message);
    return 1;
}
