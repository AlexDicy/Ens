// @stdout out 1
// @stdout err through writeError
// @stdout out 2
// @stdout err through io.err()
// @stdout out 3
// @exit 0
// The order between standard output and standard error, which is only visible where the two arrive
// as one stream. Writing to standard error hands over everything already printed first.
import @std.io;
import @std.system;
import IoError from @std.io.streams;

// The mixed sequence, written by the child so the parent reads both of its streams in the order
// the child wrote them.
emit() throws IoError {
    print("out 1");
    system.writeError("err through writeError");
    print("out 2");
    try io.err().write("err through io.err()\n".toBytes());
    print("out 3");
}

// Everything the child wrote, in order, echoed onto this program's own standard output.
echoChild() throws {
    let child = try system.start(system.executablePath(), ["child"]);
    string? line = try child.readLine();
    while (line != null) {
        print(line);
        line = try child.readLine();
    }
    let status = try child.wait();
}

main() -> int {
    let given = system.arguments();
    if (given.length > 1 && given[1] == "child") {
        try emit();
        return 0;
    }
    try echoChild();
    return 0;
} catch (Error failure) {
    system.writeError(failure.message);
    return 1;
}
