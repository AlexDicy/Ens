// @exit 42
// An untyped integer literal names a floating-point value as well as a fractional one does, so
// it takes a floating-point type from its surroundings under the same rule. Rounding to the
// nearest value the type has is part of the conversion, so the loss is silent.
takeFloat(float v) -> float {
    return v;
}

scaled(float factor = 2) -> float {
    return factor;
}

struct Ratio {
    protected float numerator = 1;
    protected float denominator;
}

main() -> int {
    float whole = 5;
    if (whole != 5.0)                       { return 1; }

    float negative = -5;
    if (negative != -5.0)                   { return 2; }

    double wide = 5;
    if (wide != 5.0)                        { return 3; }

    // 16777217 is the first whole number a float cannot tell from its neighbour, so it stores
    // as 16777216. The conversion rounds and says nothing, exactly as 0.1 does.
    float rounded = 16777217;
    if (rounded != 16777216.0)              { return 4; }

    // The largest and smallest integers there are still convert, since no 64-bit magnitude
    // reaches a float's limit.
    float huge = 9223372036854775807;
    if (huge < 9.0e18)                      { return 5; }

    if (takeFloat(7) != 7.0)                { return 6; }
    if (scaled() != 2.0)                    { return 7; }

    float sibling = whole + 2;
    if (sibling != 7.0)                     { return 8; }
    float leftSide = 2 + whole;
    if (leftSide != 7.0)                    { return 9; }

    float[] elements = [1, 2];
    if (elements[0] != 1.0)                 { return 10; }
    if (elements[1] != 2.0)                 { return 11; }

    Ratio ratio = { denominator: 4 };
    if (ratio.numerator != 1.0)             { return 12; }
    if (ratio.denominator != 4.0)           { return 13; }

    float ternary = true ? 3 : whole;
    if (ternary != 3.0)                     { return 14; }

    // A suffix still names the literal's type, so this one stays a 'long' and needs a cast.
    float suffixed = 5L as float;
    if (suffixed != 5.0)                    { return 15; }

    return 42;
}
