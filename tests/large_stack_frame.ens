// @exit 0
// @stdout 4096 1 4096
// A struct of 32 KB lives on the stack, so the frame spans several pages. On Windows a function
// with such a frame touches each page of it in turn before it uses it, through '__chkstk', and
// passing the struct to another function copies the whole of it.

struct Row {
    long a;
    long b;
    long c;
    long d;
    long e;
    long f;
    long g;
    long h;

    constructor() {
    }
}

struct Block {
    Row r0;
    Row r1;
    Row r2;
    Row r3;
    Row r4;
    Row r5;
    Row r6;
    Row r7;

    constructor() {
    }
}

struct Slab {
    Block b0;
    Block b1;
    Block b2;
    Block b3;
    Block b4;
    Block b5;
    Block b6;
    Block b7;

    constructor() {
    }
}

struct Big {
    Slab s0;
    Slab s1;
    Slab s2;
    Slab s3;
    Slab s4;
    Slab s5;
    Slab s6;
    Slab s7;

    constructor() {
    }
}

// The two fields that were set, read through a copy of the whole struct.
corners(Big big) -> long {
    return big.s0.b0.r0.a + big.s7.b7.r7.h;
}

main() -> int {
    Big big = Big();
    big.s0.b0.r0.a = 1;
    big.s7.b7.r7.h = 1;
    long filled = 4096;
    print("{filled} {big.s0.b0.r0.a} {filled * big.s7.b7.r7.h}");
    if (corners(big) != 2) {
        print("the copy lost a field");
        return 1;
    }
    return 0;
}
