// @exit 0
// @stdout base pair true true
// @stdout runtime types false true
// @stdout absent true true true
// @stdout struct field true false true
// @stdout array true true
// @stdout map six none
// @stdout set 2 true
// @stdout interface true true
// @stdout identity false true true
// @stdout inherited true false

import Map from @std.collections.map;
import Set from @std.collections.set;

// A base class declaring nothing: what one of its values compares and hashes as is decided by the
// runtime type that value turns out to have, not by the 'Shape' written in the source.
class Shape {
    protected int size;

    protected constructor(this.size);
}

// A subclass declaring the pair, so two of these are equal by content even where the code holding
// them only knows they are shapes.
class Sized extends Shape {
    protected constructor(int size) {
        super(size);
    }

    override hash() -> long {
        return this.size as long;
    }

    override equals(Sized other) -> bool {
        return this.size == other.size;
    }
}

// A second subclass declaring the pair for itself. Equal content is not enough: 'Sized.equals'
// takes a 'Sized', so two values only compare by content when their runtime types are the same.
class Tagged extends Shape {
    protected constructor(int size) {
        super(size);
    }

    override hash() -> long {
        return this.size as long;
    }

    override equals(Tagged other) -> bool {
        return this.size == other.size;
    }
}

// A subclass that declares nothing answers with what it inherited, and still only matches another
// value of its own runtime type.
class Inherited extends Sized {
    protected constructor(int size) {
        super(size);
    }
}

// No class in this one's subtree declares either method, so its values keep identity equality and
// the identity hash.
class Plain {
    protected int size;

    protected constructor(this.size);
}

// An interface naming the hashing contract, so a value can be held as one and still hash and
// compare as the class it turns out to be.
interface Keyed {
    hash() -> long;
}

class Named implements Keyed {
    protected int id;

    protected constructor(this.id);

    override hash() -> long {
        return this.id as long;
    }

    override equals(Named other) -> bool {
        return this.id == other.id;
    }
}

struct Holder {
    Shape shape;
    int tag;
}

main() -> int {
    Shape a = new Sized(3);
    Shape b = new Sized(3);
    Shape c = new Tagged(3);
    print("base pair {a == b} {a.hash() == b.hash()}");
    print("runtime types {a == c} {a != c}");

    Shape? missing = null;
    Shape? alsoMissing = null;
    print("absent {missing == null} {missing == alsoMissing} {a != missing}");

    // A class-typed struct field compares and hashes through the same rule, so the guard reaches
    // into an enclosing value. The two runtime types hash alike here and still compare unequal.
    Holder first = {shape: new Sized(4), tag: 1};
    Holder second = {shape: new Sized(4), tag: 1};
    Holder third = {shape: new Tagged(4), tag: 1};
    print("struct field {first == second} {first == third} "
        + "{first.hash() == third.hash()}");

    Shape[] shapes = [new Sized(5), new Sized(5)];
    print("array {shapes[0] == shapes[1]} {shapes[0].hash() == shapes[1].hash()}");

    // A map keyed by the base class finds the entry a derived key stored, which is what breaks
    // when equality and hashing follow the static type instead.
    let byShape = new Map<Shape, string>();
    byShape.set(new Sized(6), "six");
    string found = byShape.get(new Sized(6)) ?? "none";
    string foreign = byShape.get(new Tagged(6)) ?? "none";
    print("map {found} {foreign}");

    let seen = new Set<Shape>();
    seen.add(new Sized(7));
    seen.add(new Sized(7));
    seen.add(new Tagged(7));
    print("set {seen.length()} {seen.contains(new Sized(7))}");

    Keyed h1 = new Named(1);
    Keyed h2 = new Named(1);
    print("interface {h1 == h2} {h1.hash() == h2.hash()}");

    Plain p1 = new Plain(8);
    Plain p2 = new Plain(8);
    print("identity {p1 == p2} {p1 == p1} {p1.hash() == p1.hash()}");

    Shape i1 = new Inherited(9);
    Shape i2 = new Inherited(9);
    Shape sized9 = new Sized(9);
    print("inherited {i1 == i2} {i1 == sized9}");
    return 0;
}
