// @exit 134
// @stderr-contains panic: tried to start a task in a scope that has ended. Start it while the scope's body runs, or in a scope that is still open
// A scope that has ended starts no more tasks, since nothing would wait for them.
import @std.tasks;
import TaskScope from @std.tasks;

main() -> int {
    TaskScope kept = tasks.scope((scope) -> scope);
    kept.launch(() -> {});
    return 0;
}
