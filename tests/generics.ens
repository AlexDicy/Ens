// @exit 0
// Generic classes (primitive, string, class, and multi-parameter), a growable
// List from the standard library, a single base-class bound used through the
// parameter, and generic functions with explicit and inferred type arguments. A field
// default and a parameter default are built once per instantiation, so both may name the
// declaration's type parameters.
import List from @std.collections.list;

class Shape { protected int sides; protected constructor(this.sides = 0); protected sideCount() -> int { return this.sides; } }
class Square extends Shape { protected constructor() { super(4); } }

class Pair<A, B> {
    A first;
    B second;
    protected constructor(A a, B b) { this.first = a; this.second = b; }
    protected firstValue() -> A { return this.first; }
    protected secondValue() -> B { return this.second; }
}

struct Cell<T> {
    protected T value;
    protected held() -> T { return this.value; }
}

class Box<T> {
    T inner;
    protected constructor(T v) { this.inner = v; }
    protected unwrap() -> T { return this.inner; }
}

class Holder<T: Shape> {
    T item;
    protected constructor(T s) { this.item = s; }
    protected sides() -> int { return this.item.sideCount(); }
}

swap<T>(T a, T b, bool pickFirst) -> T {
    if (pickFirst) { return a; }
    return b;
}

class Zero<T> {
    protected constructor();

    protected static count() -> long {
        return 0;
    }
}

class Kept<Tag> {
    protected List<Tag> items = new List<Tag>();
    protected Tag?[] slots = new Tag?[2];
    protected (Tag) -> long weigh = (held) -> 1;
    protected long zeroed = Zero<Tag>.count();

    protected constructor();

    protected total(List<Tag> more = new List<Tag>()) -> long {
        return this.items.length() + more.length();
    }
}

struct Slotted<T> {
    protected List<T> held = new List<T>();
}

counts<Value>(List<Value> items = new List<Value>()) -> long {
    return items.length();
}

main() -> int {
    let pair = new Pair<int, string>(7, "hi");
    if (pair.firstValue() != 7) { return 1; }
    if (pair.secondValue().length != 2) { return 2; }

    Cell<int> cell = {value: 5};
    if (cell.held() != 5) { return 9; }

    let numbers = new List<int>();
    let i = 0;
    while (i < 10) { numbers.push(i); i = i + 1; }
    if (numbers.length() != 10) { return 3; }
    if (numbers.get(9) != 9) { return 4; }

    let shapes = new List<Square>();
    shapes.push(new Square());
    if (shapes.get(0).sideCount() != 4) { return 5; }

    int[] copiedNumbers = numbers.toArray();
    if (copiedNumbers.length != 10 || copiedNumbers[9] != 9) { return 10; }

    Square[] copiedShapes = shapes.toArray();
    if (copiedShapes.length != 1 || copiedShapes[0].sideCount() != 4) { return 11; }

    let emptied = new List<Square>();
    if (emptied.toArray().length != 0) { return 12; }

    let holder = new Holder<Square>(new Square());
    if (holder.sides() != 4) { return 6; }

    if (swap<int>(11, 22, true) != 11) { return 7; }
    if (swap(33, 44, false) != 44) { return 8; }

    let nested = new Box<Box<Box<Box<int>>>>(
        new Box<Box<Box<int>>>(new Box<Box<int>>(new Box<int>(42))));
    if (nested.unwrap().unwrap().unwrap().unwrap() != 42) { return 13; }

    let kept = new Kept<string>();
    kept.items.push("one");
    if (kept.items.length() != 1) { return 14; }
    if (kept.slots.length != 2 || kept.slots[0] != null) { return 15; }
    if (kept.weigh("one") != 1) { return 16; }
    if (kept.zeroed != 0) { return 17; }
    if (kept.total() != 1) { return 18; }

    Slotted<int> slotted = {};
    if (!slotted.held.isEmpty()) { return 19; }
    if (counts<int>() != 0) { return 20; }

    return 0;
}