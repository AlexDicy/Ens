// @exit 0
// Generic classes (primitive, string, class, and multi-parameter), a growable
// Vector from the standard library, a single base-class bound used through the
// parameter, and generic functions with explicit and inferred type arguments.
import Vector from @std.vector;

class Shape { protected int sides; Shape(this.sides = 0); sideCount() -> int { return this.sides; } }
class Square extends Shape { Square() { super(4); } }

class Pair<A, B> {
    private A first;
    private B second;
    Pair(A a, B b) { this.first = a; this.second = b; }
    firstValue() -> A { return this.first; }
    secondValue() -> B { return this.second; }
}

class Holder<T: Shape> {
    private T item;
    Holder(T s) { this.item = s; }
    sides() -> int { return this.item.sideCount(); }
}

swap<T>(T a, T b, bool pickFirst) -> T {
    if (pickFirst) { return a; }
    return b;
}

main() -> int {
    let pair = new Pair<int, string>(7, "hi");
    if (pair.firstValue() != 7) { return 1; }
    if (pair.secondValue().length != 2) { return 2; }

    let numbers = new Vector<int>();
    let i = 0;
    while (i < 10) { numbers.push(i); i = i + 1; }
    if (numbers.length() != 10) { return 3; }
    if (numbers.get(9) != 9) { return 4; }

    let shapes = new Vector<Square>();
    shapes.push(new Square());
    if (shapes.get(0).sideCount() != 4) { return 5; }

    let holder = new Holder<Square>(new Square());
    if (holder.sides() != 4) { return 6; }

    if (swap<int>(11, 22, true) != 11) { return 7; }
    if (swap(33, 44, false) != 44) { return 8; }

    return 0;
}