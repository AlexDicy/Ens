// @expect-error Method 'hash' replaces the built-in identity hash of class 'Key', so it must be as visible as 'Key' itself; mark it 'public'
// A class's 'hash' and 'equals' are called by '==' and by keyed collections wherever the
// class is used, so neither may be less visible than the class itself. Unmarked they
// follow the class; a marker that narrows them, such as 'protected' on a public class, is an
// error.

public class Key {
    int id;

    public constructor(this.id);

    protected override hash() -> long {
        return this.id;
    }

    public override equals(Key other) -> bool {
        return this.id == other.id;
    }
}

main() -> int {
    let key = new Key(1);
    print("{key.hash()}");
    return 0;
}
