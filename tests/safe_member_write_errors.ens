// A member written through a '?.' needs a place to store into, which a '??' fallback is not, so the
// refusal offers the null check alone.
// @expect-error Cannot write a member of 'Counter?' because it may be null here. 'holder?.plain' is null whenever 'holder' is null. A '??' fallback makes a copy, so a write to it would change only that copy. Check 'holder' for null first ('if (holder != null)') and write 'holder.plain'.
// @expect-error build failed with 1 problem
struct Counter {
    int value;
}

struct Holder {
    Counter plain;
}

main() -> int {
    Holder? holder = null;
    holder?.plain.value = 1;
    return 0;
}
