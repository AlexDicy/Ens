// @exit 0
// ARC across the error path: when an exception propagates through a frame holding
// an owned local (and an owned mid-expression temporary), the local must be
// released exactly once: no leak, no double-free. A weak reference observes the
// release: it reads null only if the strong owner was freed during unwinding.
class Node {
    int v;
    Node(this.v);
}
class Holder {
    weak Node? watch;
    Holder();
}

class Svc {
    boom() -> int throws { throw new Error("fail"); }

    consume(Node a, int n) -> int { return a.v + n; }

    leak(Holder h) -> int throws {
        let owned = new Node(10);          // owned local, released on unwind
        h.watch = owned;                   // non-owning weak observer
        return this.consume(new Node(5), try this.boom());  // temp + throwing arg
    }

    attempt(Holder h) -> int {
        return try this.leak(h);
    } catch (Error e) {
        if (h.watch == null) { return 0; } // freed during unwind: no leak
        return 1;
    }
}

main() -> int {
    let h = new Holder();
    let svc = new Svc();
    return svc.attempt(h);
}