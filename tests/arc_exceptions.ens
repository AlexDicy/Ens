// @exit 0
// ARC across the error path: an exception propagating through a frame that holds an owned local
// releases that local exactly once. A weak reference observes it, reading null only if the strong
// owner was freed during unwinding.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Node {
    protected int v;
    protected constructor(this.v);
}
class Holder {
    protected weak Node? watch;
    protected constructor();
}

class Svc {
    boom() -> int throws { throw new Failure("fail"); }

    consume(Node a, int n) -> int { return a.v + n; }

    leak(Holder h) -> int throws {
        let owned = new Node(10);          // owned local, released on unwind
        h.watch = owned;                   // non-owning weak observer
        return this.consume(new Node(5), try this.boom());  // temp + throwing arg
    }

    protected attempt(Holder h) -> int {
        return try this.leak(h);
    } catch (Error e) {
        if (h.watch == null) { return 0; } // freed during unwind: no leak
        return 1;
    }
}

main() -> int {
    let h = new Holder();
    let svc = new Svc();
    return svc.attempt(h);
}