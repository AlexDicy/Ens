import @std.testing;
import List from @std.collections.list;

class Node {
    int value;
    Node(this.value);
}

class Observer {
    weak Node? observed;
    Observer();
}

test "addition adds small integers" {
    try testing.assertEqual(2 + 3, 5);
    try testing.assertNotEqual(2 + 3, 6);
}

test "lists grow through pushes" {
    let numbers = new List<int>();
    let i = 0;
    while (i < 100) {
        numbers.push(i);
        i = i + 1;
    }
    try testing.assertEqual(numbers.length(), 100L);
}

test "objects allocated in a test body are reclaimed" {
    let observer = new Observer();
    let node = new Node(42);
    observer.observed = node;
    node = new Node(0);
    try testing.assertTrue(observer.observed == null, "the first node should have been released");
}

test "loop allocations are reclaimed" {
    let observer = new Observer();
    let i = 0;
    while (i < 3) {
        let node = new Node(i);
        observer.observed = node;
        i = i + 1;
    }
    try testing.assertTrue(observer.observed == null, "the last loop node should have been released");
}
