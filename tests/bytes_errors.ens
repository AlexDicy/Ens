// @expect-error Cannot write an element of 'data', because its type is 'bytes', and nothing can change a 'bytes' once it is made. Change a 'byte[]' instead, and make the 'bytes' from it with 'bytes.of' once it is complete.
// @expect-error Cannot write an element of 'maybe', because its type is 'bytes?', and nothing can change a 'bytes' once it is made. Change a 'byte[]' instead, and make the 'bytes' from it with 'bytes.of' once it is complete.
// @expect-error Variable 'array' has type 'byte[]', but its value has type 'bytes'. Declare 'array' as a 'bytes' instead.
// @expect-error Variable 'back' has type 'bytes', but its value has type 'byte[]'. Write 'bytes.of(new byte[2])' to make 'bytes' from the array, or declare 'back' as a 'byte[]'.
// @expect-error Argument 1 of 'fill' has type 'bytes', but parameter 'buffer' has type 'byte[]', whose elements can be changed. Nothing can change the elements of a 'bytes', so it cannot be passed as a 'byte[]'. Call 'toArray()' on it to pass a copy whose elements can be changed.
// @expect-error Argument 1 of 'first' has type 'bytes', but parameter 'items' has type 'byte[]', whose elements can be changed. Nothing can change the elements of a 'bytes', so it cannot be passed as a 'byte[]'. Call 'toArray()' on it to pass a copy whose elements can be changed.
// @expect-error Argument 1 of 'kept' has type 'byte[]', but parameter 'data' has type 'bytes'. Write 'bytes.of(chunk)' to make 'bytes' from the array.
// @expect-error Argument 2 of 'same' has type 'byte[]', but parameter 'right' has type 'bytes'. Write 'bytes.of(chunk)' to make 'bytes' from the array.
// @expect-error Argument 1 of 'measured' has type 'byte[]', but parameter 'data' has type 'bytes'.
// @expect-error build failed with 11 problems
// No element of a 'bytes' can be written, and neither 'bytes' nor 'byte[]' is given where the
// other is expected. An array is made into 'bytes' with 'bytes.of' wherever the name 'bytes' is free
// to write it.
first<T>(T[] items) -> T {
    return items[0];
}

fill(byte[] buffer) {
    buffer[0] = 1;
}

kept(bytes data) -> long {
    return data.length;
}

measured(bytes data) -> long {
    return data.length;
}

same<T>(T left, T right) -> bool {
    return left == right;
}

shadowed(byte[] array) -> long {
    long bytes = array.length;
    return measured(array) + bytes;
}

main() -> int {
    bytes data = [1, 2, 3];
    data[0] = 5;
    data[1] += 5;
    data[2]++;
    bytes? maybe = data;
    maybe?[0] = 4;
    byte[] array = data;
    bytes back = new byte[2];
    fill(data);
    let one = first(data);
    byte[] chunk = [1, 2];
    let length = kept(chunk);
    let equal = same(data, chunk);
    return 0;
}
