// No element of a 'bytes' can be written, and neither 'bytes' nor 'byte[]' is given where the
// other is expected.
first<T>(T[] items) -> T {
    return items[0];
}

fill(byte[] buffer) {
    buffer[0] = 1;
}

main() -> int {
    bytes data = [1, 2, 3];
    data[0] = 5;
    data[1] += 5;
    data[2]++;
    bytes? maybe = data;
    maybe?[0] = 4;
    byte[] array = data;
    bytes back = new byte[2];
    fill(data);
    let one = first(data);
    return 0;
}
