// @expect-error 'Rock' does not extend 'Dog', so a value of type 'Dog' is never a 'Rock', and this 'as?' cast always gives null.
// @expect-error build failed with 20 problems
// An 'as?' cast that can never succeed is reported once, at the cast, however it is used: assigned
// to a typed or an untyped local, under '??', compared with null, written as a statement, passed as
// an argument, or read and called through '?.'. The use around the cast reports nothing of its own.
class Animal {
    protected constructor();
}

class Dog extends Animal {
    constructor();
}

class Rock {
    int size = 1;

    constructor();

    roll() -> int {
        return this.size;
    }
}

makeDog() -> Dog {
    return new Dog();
}

take(Rock? rock) -> int {
    return 0;
}

names(Animal pet) -> int {
    Rock? typed = pet as? Rock;
    let rock = pet as? Rock;
    const fixed = pet as? Rock;
    let other = pet as? Rock ?? new Rock();
    bool missing = (pet as? Rock) == null;
    if ((pet as? Rock) != null) {
        return 1;
    }
    pet as? Rock;
    return take(pet as? Rock);
}

calls() -> int {
    Rock? typed = makeDog() as? Rock;
    let rock = makeDog() as? Rock;
    if ((makeDog() as? Rock) != null) {
        return 1;
    }
    makeDog() as? Rock;
    return 0;
}

chains(Animal pet) -> int {
    int? typed = (pet as? Rock)?.size;
    let untyped = (pet as? Rock)?.size;
    let rolled = (pet as? Rock)?.roll();
    int fallback = (pet as? Rock)?.size ?? 0;
    bool missing = (pet as? Rock)?.size == null;
    (pet as? Rock)?.roll();
    (makeDog() as? Rock)?.roll();
    let called = (makeDog() as? Rock)?.size;
    return fallback;
}

main() -> int {
    return names(new Dog()) + calls() + chains(new Dog());
}
