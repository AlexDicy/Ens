// @expect-error Cannot read a member of 'Leaf?' because it may be null
// The join narrows only when every falling-through branch proves the fact. Here just one
// branch reassigns the value; the condition proves nothing on the other path, so the
// intersection is empty and the value stays nullable after the 'if'.
class Leaf {
    int field;

    constructor(this.field = 1);
}

fallback() -> Leaf {
    return new Leaf();
}

readField(bool ready, Leaf? x) -> int {
    if (ready) {
        x = fallback();
    }
    return x.field;
}

main() -> int {
    return readField(true, null);
}
