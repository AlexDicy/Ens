// @exit 0
// @stdout hole=A
// @stdout lit=B
// @stdout method=C
// @stdout concat=xA
// @stdout accent=é
// @stdout digit=7
// @stdout code=55
// @stdout gap=[	]
// A char converts to text as the character itself, not its numeric code point,
// and the same conversion backs '.toString()', interpolation holes, and string
// '+'. 'A' becomes "A", the digit '7' becomes "7" (not its code 55), a multibyte
// scalar like 'é' becomes its UTF-8 bytes, and a control char like '\t' becomes a
// real tab byte. The numeric code point is still one 'as int' away.
main() -> int {
    char a = 'A';
    print("hole={a}");
    print("lit={'B'}");
    print("method=" + 'C'.toString());
    print("concat=x" + a);

    char accent = 'é';
    print("accent={accent}");

    char digit = '7';
    print("digit={digit}");
    print("code={digit as int}");

    char tab = '\t';
    print("gap=[{tab}]");
    return 0;
}
