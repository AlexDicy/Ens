// @expect-error The two results of this '?:' are 'Alpha' and 'Gamma', which have no common type. Give both branches the same type.
// @expect-error The two results of this '?:' are 'Alpha' and 'Beta', which have no common type. Both implement 'Drawable', so declare 'value' with that type: write 'Drawable value' instead of 'let value'.
// @expect-error The two results of this '?:' are 'Gamma' and 'Point', which have no common type. Give both branches the same type.
// @expect-error build failed with 3 problems
// Class values without a common base class do not unify: unrelated classes,
// classes sharing only an interface, and a class beside a struct all stay
// errors where nothing states the type.
interface Drawable {
    draw() -> int;
}

class Alpha implements Drawable {
    protected constructor();
    override draw() -> int { return 1; }
}

class Beta implements Drawable {
    protected constructor();
    override draw() -> int { return 2; }
}

class Gamma {
    protected constructor();
}

struct Point {
    int x = 0;
}

// Unrelated classes share no base class, so they do not unify.
unrelated(bool c) -> int {
    let value = c ? new Alpha() : new Gamma();
    return 0;
}

// Two classes whose only shared contract is an interface do not unify, and the
// error names the interface to declare the value with.
interfaceOnly(bool c) -> int {
    let value = c ? new Alpha() : new Beta();
    return 0;
}

// A class never unifies with a struct.
classVsStruct(bool c) -> int {
    Point point = {};
    let value = c ? new Gamma() : point;
    return 0;
}
