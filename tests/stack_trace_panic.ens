// @exit 134
// @stderr panic: tried to read index 9 of an array of length 2. Check the index against 'length' first
// @stderr-at O0   at crash (stack_trace_panic.ens:13)
// @stderr-at O2   at crash (stack_trace_panic.ens:13, inlined)
// @stderr   at lambda (stack_trace_panic.ens:19)
// @stderr-at O0   at through (stack_trace_panic.ens:16)
// @stderr-at O2   at through (stack_trace_panic.ens:16, inlined)
// @stderr   at main (stack_trace_panic.ens:19)
// panic() captures and prints a trace too, sharing the throw path's machinery.
// A lambda's body is a frame of its own, printed as 'lambda'.
crash() -> int {
    int[] xs = new int[2];
    return xs[9];
}
through(() -> int step) -> int {
    return step();
}
main() -> int {
    return through(() -> crash());
}
