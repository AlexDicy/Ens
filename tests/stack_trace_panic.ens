// @exit 134
// @stderr-contains panic: array index out of bounds
// @stderr-contains at crash (stack_trace_panic.ens:11)
// @stderr-contains at lambda (stack_trace_panic.ens:17)
// @stderr-contains at through (stack_trace_panic.ens:14)
// @stderr-contains at main (stack_trace_panic.ens:17)
// panic() captures and prints a trace too, sharing the throw path's machinery.
// A lambda's body is a frame of its own, printed as 'lambda'.
crash() -> int {
    int[] xs = new int[2];
    return xs[9];
}
through(() -> int step) -> int {
    return step();
}
main() -> int {
    return through(() -> crash());
}
