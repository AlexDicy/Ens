// @exit 134
// @stderr-contains panic: array index out of bounds
// @stderr-contains at crash (stack_trace_panic.ens:8)
// @stderr-contains at main (stack_trace_panic.ens:11)
// panic() captures and prints a trace too, sharing the throw path's machinery.
crash() -> int {
    int[] xs = new int[2];
    return xs[9];
}
main() -> int {
    return crash();
}