// @exit 134
// @stderr panic: tried to read index 9 of an array of length 2. Check the index against 'length' first
// @stderr   at crash (stack_trace_panic.ens:11)
// @stderr   at lambda (stack_trace_panic.ens:17)
// @stderr   at through (stack_trace_panic.ens:14)
// @stderr   at main (stack_trace_panic.ens:17)
// panic() captures and prints a trace too, sharing the throw path's machinery.
// A lambda's body is a frame of its own, printed as 'lambda'.
crash() -> int {
    int[] xs = new int[2];
    return xs[9];
}
through(() -> int step) -> int {
    return step();
}
main() -> int {
    return through(() -> crash());
}
