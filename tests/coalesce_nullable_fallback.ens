// @exit 0
// @stdout name ada
// @stdout name anonymous
// @stdout cell 1
// @stdout cell 2
// @stdout freed 2
// @stdout missing null
// @stdout owned 1
// @stdout owned 3
// @stdout freed 3
// @stdout cast 4
// @stdout end
// @stdout freed 1
// '??' whose right side is nullable too keeps the whole expression nullable, so the value the left
// holds reaches the result with no conversion between them. The present path owes the result its
// own reference and the absent path leaves the left alone, so the two must agree at the join.
class Cell {
    protected int value;

    protected constructor(this.value);

    destructor() {
        print("freed " + this.value);
    }

    protected read() -> int {
        return this.value;
    }
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int sides;

    protected constructor(this.sides);

    protected read() -> int {
        return this.sides;
    }
}

class Registry {
    protected Cell? held;

    protected constructor(this.held);

    // A field read is borrowed, so this is the shape that used to fail to lower.
    protected pick(Cell? given) -> Cell? {
        return given ?? this.held;
    }

    // A call's result is owned, and the absent path gives it up.
    protected owned(Cell? given) -> Cell? {
        return this.copy() ?? given;
    }

    protected copy() -> Cell? {
        return this.held;
    }
}

named(string? given, string? fallback) -> string? {
    return given ?? fallback;
}

report(string label, Cell? cell) {
    if (cell == null) {
        print(label + " null");
        return;
    }
    print(label + " " + cell.read());
}

main() -> int {
    print("name " + (named(null, "ada") ?? "none"));
    print("name " + (named(null, null) ?? "anonymous"));

    let registry = new Registry(new Cell(1));
    report("cell", registry.pick(null));
    report("cell", registry.pick(new Cell(2)));
    report("missing", new Registry(null).pick(null));
    report("owned", registry.owned(null));
    report("owned", new Registry(null).owned(new Cell(3)));

    Shape shape = new Circle(4);
    Circle? none = null;
    let cast = none ?? (shape as? Circle);
    if (cast == null) {
        print("cast null");
    } else {
        print("cast " + cast.read());
    }
    print("end");
    return 0;
}
