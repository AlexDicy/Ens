// @exit 0
// @stdout copy of a lazy const: 5, the lazy const: 1
// @stdout copy of a const local: 6, the const local: 1
// @stdout a struct field of a class a const local refers to: 7
// @stdout an element of an array a const local refers to: 8
// A write into a field of a constant struct is refused, but a copy of the struct takes it, and so do a
// class object and an array element reached from a constant, which each have storage of their own.
struct Point {
    int x;
    int y;
}

class Settings {
    lazy const Point point = {x: 1, y: 2};
}

class Box {
    Point point = {x: 1, y: 2};
}

main() -> int {
    let copy = Settings.point;
    copy.x = 5;
    print("copy of a lazy const: {copy.x}, the lazy const: {Settings.point.x}");
    const Point fixed = {x: 1, y: 2};
    Point changed = fixed;
    changed.x += 5;
    print("copy of a const local: {changed.x}, the const local: {fixed.x}");
    const Box box = new Box();
    box.point.x = 7;
    print("a struct field of a class a const local refers to: {box.point.x}");
    const Point[] points = [{x: 1, y: 2}];
    points[0].x = 8;
    print("an element of an array a const local refers to: {points[0].x}");
    return 0;
}
