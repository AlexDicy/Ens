// @exit 0
// @stdout hello/none/3
// @stdout chained/hello/9
// @stdout main:12:false
// @stdout callee:3:true
// @stdout 1:large
// @stdout 5 -1
// @stdout 0:2
// A 'const' field is assigned exactly once when the object is constructed and is readable
// everywhere afterwards: through a shorthand constructor parameter, a body assignment on every
// branch of an if or an exhaustive switch, a struct literal, a kept or overwritten default, or
// a catch clause when the body could not have assigned it first. A struct whose const fields
// all carry defaults keeps a default value of its own, so it can still be an array element.
public class Message {
    public const string text;
    public const Message? cause;
    const int code = 3;

    public constructor(this.text, this.cause = null) {
    }

    public constructor(string text, Message cause, int code) {
        this.text = text;
        this.cause = cause;
        this.code = code;
    }

    public describe() -> string {
        let parent = this.cause;
        string causeText = "none";
        if (parent != null) {
            causeText = parent.text;
        }
        return "{this.text}/{causeText}/{this.code}";
    }
}

public struct Frame {
    public const string name;
    public const int line;
    public const bool inlined = false;
}

public enum Kind {
    Small,
    Large,
}

public class Branchy {
    public const int chosen;
    public const string label;

    public constructor(bool flag, Kind kind) {
        if (flag) {
            this.chosen = 1;
        } else {
            this.chosen = 2;
        }
        switch (kind) {
            Small -> {
                this.label = "small";
            },
            Large -> {
                this.label = "large";
            },
        }
    }
}

public class Fallback {
    public const int parsed;

    public constructor(string text) {
        this.parsed = try measure(text);
    }
    catch (Error e) {
        this.parsed = -1;
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

measure(string text) -> int throws {
    if (text.length == 0) {
        throw new Failure("empty");
    }
    return text.length as int;
}

public struct Tick {
    public const int count = 0;
}

frameLine(Frame frame) -> string {
    return "{frame.name}:{frame.line}:{frame.inlined}";
}

main() -> int {
    let plain = new Message("hello");
    let chained = new Message("chained", plain, 9);
    Frame frame = {name: "main", line: 12};
    Frame marked = {name: "callee", line: 3, inlined: true};
    let branchy = new Branchy(true, Kind.Large);
    let counted = new Fallback("count");
    let caught = new Fallback("");
    print(plain.describe());
    print(chained.describe());
    print(frameLine(frame));
    print(frameLine(marked));
    print("{branchy.chosen}:{branchy.label}");
    print("{counted.parsed} {caught.parsed}");
    let ticks = new Tick[2];
    print("{ticks[0].count}:{ticks.length}");
    return 0;
}
