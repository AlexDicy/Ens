// What replacing a function the language provides does not do. A generic declaration replaces
// nothing, the provided 'print' still blocks an external declaration of that name, and a
// replacement carrying no 'noreturn' leaves the paths that leaned on the provided one incomplete.
// @expect-error 'print' is a function the language provides in every module, and a generic function cannot be overloaded, so a declaration of 'print' cannot have type parameters. Declare it as 'print(string message)' to replace the provided function in this module, or give this function a different name.
// @expect-error External function 'print' cannot share its name with another function; C symbols cannot be overloaded.
// @expect-error Function 'panic' is already declared with the same parameter types; overloads must differ in parameter count or types.
// @expect-error Variable 'value' is used before it is assigned a value. Assign it on every path that reaches this point first, for example 'value = ...;'.
// @expect-error Function 'required' can reach the end of its body without returning a value; add a 'return' on every path.
// @expect-error build failed with 5 problems
print<T>(T value) {
}

external from libc {
    print(int code);
}

panic(string message) {
    print("recorded: " + message);
}

panic(string message) {
    print("recorded twice: " + message);
}

choose(bool flag) -> long {
    long value;
    if (flag) {
        value = 1;
    } else {
        panic("no value to choose");
    }
    return value;
}

required() -> long {
    panic("nothing to return");
}

main() -> int {
    return 0;
}
