// What replacing a function the language provides does not do. The provided 'panic' still blocks
// an external declaration of that name, and a replacement carrying no 'noreturn' leaves the paths
// that leaned on the provided one incomplete.
// @expect-error External function 'panic' has the same name as function 'panic'. A native library function is looked up by its name alone, so two functions cannot share one. Remove this declaration, or rename the other 'panic'.
// @expect-error Variable 'value' is used before it is assigned a value. Assign it on every path that leads to this line, for example 'value = ...;'.
// @expect-error Function 'required' returns 'long', but a path through its body ends without a 'return'. Add a 'return' at the end of every path.
// @expect-error build failed with 3 problems
external from libc {
    panic(int code);
}

panic(string message) {
    print("recorded: " + message);
}

choose(bool flag) -> long {
    long value;
    if (flag) {
        value = 1;
    } else {
        panic("no value to choose");
    }
    return value;
}

required() -> long {
    panic("nothing to return");
}

main() -> int {
    return 0;
}
