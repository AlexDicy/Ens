// What replacing a function the language provides does not do. The provided 'print' still blocks
// an external declaration of that name, because C symbols cannot be overloaded. A second
// 'panic(string)' has nothing left to replace and is an ordinary duplicate. And the 'panic' this
// module declared carries no 'noreturn', so the paths that leaned on the provided one never
// returning are no longer complete: a branch that ends in it leaves a variable unassigned, and a
// body that is only a call to it returns nothing.
// @expect-error External function 'print' cannot share its name with another function; C symbols cannot be overloaded.
// @expect-error Function 'panic' is already declared with the same parameter types; overloads must differ in parameter count or types.
// @expect-error Variable 'value' is used before it is assigned a value. Assign it on every path that reaches this point first, for example 'value = ...;'.
// @expect-error Function 'required' can reach the end of its body without returning a value; add a 'return' on every path.
// @expect-error build failed with 4 problems
external from libc {
    print(int code);
}

panic(string message) {
    print("recorded: " + message);
}

panic(string message) {
    print("recorded twice: " + message);
}

choose(bool flag) -> long {
    long value;
    if (flag) {
        value = 1;
    } else {
        panic("no value to choose");
    }
    return value;
}

required() -> long {
    panic("nothing to return");
}

main() -> int {
    return 0;
}
