// @expect-error '<<' shifts a 'uint' here, so the shift distance must be a 'uint' too, but 'spread' has type 'byte'. Write 'spread as uint'.
// The shifted value decides the result type, so the distance must match it. Only an untyped
// literal distance adapts; a named type is cast at the call site so the width stays visible.
main() -> int {
    uint flags = 1;
    byte spread = 3;
    let wide = flags << spread;
    return wide as int;
}
