// @exit 0
// @stdout Point(1, -2)
// @stdout Point(1, -2)
// @stdout in a hole: Point(1, -2)
// @stdout {"x": 1, "y": -2}
// @stdout {"x": 1, "y": -2}
// @stdout {"origin": {"x": 3, "y": 4}, "count": 2}
// @stdout tagged 3 of 2
// @stdout tagged 3 of 2
// @stdout hidden 5
// @stdout hidden 5

// A struct that declares its own 'toString' renders through that method both in an
// interpolation hole and through an explicit call, and the two must agree. The method
// replaces the struct's built-in JSON form, so it is marked 'override'. A struct
// without one keeps its JSON form. A nested struct field always renders as its own
// JSON object, even when its type declares a 'toString' of its own. A declared
// 'toString' lifts the JSON-serializability requirement, so a field with no JSON
// form is fine as long as the struct renders itself. A 'toString' that writes no
// visibility modifier follows its struct, so a file-private struct needs nothing
// extra for either spelling to work.

public struct Point {
    public int x;
    protected int y;

    public override toString() -> string {
        return "Point({this.x}, {this.y})";
    }
}

struct Plain {
    protected int x;
    protected int y;
}

public struct Shape {
    public Point origin;
    public int count;
}

public struct Tagged {
    public int[] items;
    public int count;

    public override toString() -> string {
        return "tagged {this.items.length} of {this.count}";
    }
}

struct Hidden {
    protected int value;

    override toString() -> string {
        return "hidden {this.value}";
    }
}

main() -> int {
    Point p = {x: 1, y: -2};
    print("{p}");
    print(p.toString());
    print("in a hole: {p}");

    Plain plain = {x: 1, y: -2};
    print("{plain}");
    print(plain.toString());

    Shape shape = {origin: {x: 3, y: 4}, count: 2};
    print("{shape}");

    Tagged tagged = {items: [1, 2, 3], count: 2};
    print("{tagged}");
    print(tagged.toString());

    Hidden hidden = {value: 5};
    print("{hidden}");
    print(hidden.toString());

    return 0;
}
