// @expect-error Cannot read a member of 'Node?' because it may be null here. 'd.target' is a 'weak' field, so it can become null at any time. A later read of it can be null even after a null check. Copy it into a local first ('let target = d.target;') and check the local.
// @expect-error Cannot read a member of 'Node?' because it may be null here. 'n.target' is a 'weak' field, so it can become null at any time. A later read of it can be null even after a null check. Copy it into a local first ('let target = n.target;') and check the local.
// @expect-error Cannot read a member of 'Node?' because it may be null here. 'w.target' is a 'weak' field, so it can become null at any time. A later read of it can be null even after a null check. Copy it into a local first ('let target = w.target;') and check the local.
// @expect-error build failed with 3 problems
// A 'weak' field is never narrowed, because its value can become null whenever the referenced
// object loses its last strong reference, so a null check proves nothing about a later read
// through the field. The checks themselves stay legal as plain boolean expressions.
class Node {
    protected int size;

    protected constructor(this.size = 0);
}

class Holder {
    protected weak Node? target;

    protected constructor();
}

class Tall extends Node {
    protected constructor() {
        super();
    }
}

typeTestAfterCheck(Holder d) -> int {
    if (d.target is Tall) {
        return d.target.size;
    }
    return 0;
}

useAfterNegatedGuard(Holder n) -> int {
    if (n.target == null) {
        return 0;
    }
    return n.target.size;
}

drainWhileGuard(Holder w) -> int {
    int total = 0;
    while (w.target != null) {
        total = total + w.target.size;
    }
    return total;
}

main() -> int {
    let holder = new Holder();
    return typeTestAfterCheck(holder) + useAfterNegatedGuard(holder) + drainWhileGuard(holder);
}
