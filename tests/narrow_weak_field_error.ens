// A 'weak' field is never narrowed, because its value can become null whenever the referenced
// object loses its last strong reference, so a null check proves nothing about a later read
// through the field. The checks themselves stay legal as plain boolean expressions.
class Node {
    protected int size;

    protected constructor(this.size = 0);

    protected report() -> int {
        return this.size;
    }
}

class Holder {
    protected weak Node? target;

    protected constructor();
}

class Chain {
    protected Holder? holder;

    protected constructor(this.holder = null);
}

consume(Node node) {
}

readAfterCheck(Holder h) -> int {
    if (h.target != null) {
        return h.target.size;
    }
    return 0;
}

callAfterCheck(Holder k) -> int {
    if (k.target != null) {
        return k.target.report();
    }
    return 0;
}

interpolateAfterCheck(Holder h) -> string {
    if (h.target != null) {
        return "{h.target}";
    }
    return "gone";
}

passAfterCheck(Holder h) {
    if (h.target != null) {
        consume(h.target);
    }
}

throughLongerPath(Chain c) -> int {
    if (c.holder != null && c.holder.target != null) {
        return c.holder.target.size;
    }
    return 0;
}

class Tall extends Node {
    protected constructor() {
        super();
    }
}

typeTestAfterCheck(Holder d) -> int {
    if (d.target is Tall) {
        return d.target.size;
    }
    return 0;
}

useAfterNegatedGuard(Holder n) -> int {
    if (n.target == null) {
        return 0;
    }
    return n.target.size;
}

drainWhileGuard(Holder w) -> int {
    int total = 0;
    while (w.target != null) {
        total = total + w.target.size;
    }
    return total;
}

main() -> int {
    let holder = new Holder();
    passAfterCheck(holder);
    int total = readAfterCheck(holder) + callAfterCheck(holder)
        + throughLongerPath(new Chain());
    if (interpolateAfterCheck(holder) == "gone") {
        return total;
    }
    return total + 1;
}
