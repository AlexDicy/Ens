// @exit 0
// @stdout released call
// @stdout described call
// @stdout after call
// @stdout released struct call
// @stdout named struct call
// @stdout after struct call
// @stdout released then
// @stdout described then
// @stdout after ternary
// @stdout released one
// @stdout described one
// @stdout after switch
// @stdout released two
// @stdout described two
// @stdout after string switch
// @stdout released cat
// @stdout described cat
// @stdout after type switch
// @stdout kept kept
// @stdout scope done
// @stdout released kept
// @stdout scope gone
// A receiver a call produced is released once the method called on it returns, and the value a
// '?:' or a switch merges is handed on to what uses it, which releases it where its use ends.
// Each Probe reports its own release, so a value kept until the end of its scope prints late and
// a missed release never prints.
class Probe {
    string label;

    constructor(this.label);

    destructor() {
        print("released " + this.label);
    }

    describe() -> string {
        return "described " + this.label;
    }
}

struct Cell {
    Probe probe;

    name() -> string {
        return "named " + this.probe.label;
    }
}

class Animal {}

class Cat extends Animal {}

make(string label) -> Probe {
    return new Probe(label);
}

cell(string label) -> Cell {
    return {probe: new Probe(label)};
}

main() -> int {
    {
        bool flag = "yes".length > 0;
        int count = 1;
        string word = "two";
        Animal animal = new Cat();
        print(make("call").describe());
        print("after call");
        print(cell("struct call").name());
        print("after struct call");
        print((flag ? make("then") : make("else")).describe());
        print("after ternary");
        print((switch (count) { 1 -> make("one"), default -> make("other") }).describe());
        print("after switch");
        print((switch (word) { "two" -> make("two"), default -> make("other") }).describe());
        print("after string switch");
        print((switch (animal) { is Cat cat -> make("cat"), default -> make("other") }).describe());
        print("after type switch");
        Probe kept = flag ? make("kept") : make("unused");
        print("kept " + kept.label);
        print("scope done");
    }
    print("scope gone");
    return 0;
}
