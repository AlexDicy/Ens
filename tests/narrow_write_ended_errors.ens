// @expect-note 'text' is assigned here
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is assigned a 'Shape' in the condition after the test, so 'shape' may be any 'Shape' here. Test 'shape' again after the assignment, as in 'if (shape is Circle)'.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned a value of type 'string?' in the condition after the check, which can be null. Check 'text' for null again after the assignment, as in 'keep(text = other) && text != null'.
// @expect-error Type 'Shape' has no field or method named 'radius'. 's' is assigned a 'Shape' in the condition after the test, so 's' may be any 'Shape' here. Test 's' again after the assignment, as in 'keepShape(s = o) && s is Circle'.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned 'null' on the right of '||'. Check 'text' for null after the '||' ('if (text != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned a value of type 'string?' in the condition after the check, and the condition is only true when 'text' is null.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned a value of type 'string?' in the condition after the check, and the condition is only false when 'text' is null.
// @expect-error build failed with 20 problems
// A write that ends a narrowing is named where the value is read, with a note at the write: an
// assignment of a value that can be null, an assignment of 'null', which no check can fix, and an
// 'out' argument in a loop, which can write the value before a later pass reaches the read. The check
// goes after the 'if' whose branch assigns the value, and after the loop that assigns it, and a write in
// a loop that leaves a wider type there is named where a read needs the narrower one, inside the loop
// and after it. A write earlier in the same pass through a loop, in its body or its condition, is named
// as a plain assignment, and a write of 'null' in a branch or in a loop the read comes after names that
// branch or loop. A write in a condition after a check or a test of the same place is named where the
// condition holds, or after an 'if' its failed condition leaves. A read later in the condition of such a
// write is given the test to write right after the write, and a write of 'null' on the right of '||' is
// named after the '||'.

external from libc {
    reset(out int? slot) -> int;
}

pick() -> string? {
    return null;
}

assigned() -> long {
    string? name = "start";
    name = pick();
    return name.length;
}

assignedNull() -> long {
    string? name = "start";
    name = null;
    return name.length;
}

passedOut() -> int {
    int? count = 3;
    int total = 0;
    while (total < 9) {
        total = total + count;
        let ignored = reset(out count);
    }
    return total;
}

joinedRead(bool flag) -> long {
    string? joined = "start";
    if (flag) {
        joined = pick();
    }
    return joined.length;
}

afterLoop() -> long {
    string? left = "start";
    while (true) {
        left = pick();
        break;
    }
    return left.length;
}

samePass(bool go) -> long {
    string? fresh = "a";
    long total = 0;
    while (go) {
        fresh = pick();
        total = total + fresh.length;
    }
    return total;
}

conditionWrite() -> long {
    string? polled = "a";
    long total = 0;
    while ((polled = pick()) == null && total < 2) {
        total = total + polled.length;
    }
    return total;
}

joinedNull(bool flag) -> long {
    string? cleared = "start";
    if (flag) {
        cleared = null;
    }
    return cleared.length;
}

breakNull(bool go) -> long {
    string? stopped = "a";
    while (go) {
        stopped = null;
        if (go) {
            break;
        }
        stopped = "x";
    }
    return stopped.length;
}

innerBreak(bool go) -> long {
    string? inner = "a";
    long total = 0;
    while (total < 3) {
        total = total + 1;
        while (go) {
            inner = null;
            break;
        }
        total = total + inner.length;
        inner = "y";
    }
    return total;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 2;

    protected constructor();
}

class Square extends Shape {
    protected constructor();
}

keep(string? value) -> bool {
    return true;
}

keepShape(Shape value) -> bool {
    return true;
}

loopedClass(bool go, Shape shape, Shape other) -> int {
    shape = new Circle();
    while (go) {
        shape = other;
    }
    return shape.radius;
}

conditionCheck(string? text, string? other) -> long {
    if (text != null && (text = other) == other) {
        return text.length;
    }
    return 0;
}

conditionTest(Shape shape, Shape other) -> int {
    if (shape is Circle && keepShape(shape = other)) {
        return shape.radius;
    }
    return 0;
}

conditionGuard(Shape shape, Shape other) -> int {
    if (!(shape is Circle) || !keepShape(shape = other)) {
        return 0;
    }
    return shape.radius;
}

sameCondition(string? text, string? other) -> bool {
    return text != null && keep(text = other) && text.length > 0;
}

sameConditionTest(Shape s, Shape o) -> bool {
    return s is Circle && keepShape(s = o) && s.radius > 1;
}

disjunctionNull(string? text, bool done) -> long {
    text = "a";
    bool finished = done || keep(text = null);
    return text.length;
}

conditionRewrite() -> long {
    string? text = null;
    if ((text = pick()) != null && (text = pick()) == null) {
        return text.length;
    }
    return 0;
}

conditionReassigned(string? text, string? other) -> long {
    if (text == null || (text = other) != null) {
        return 0;
    }
    return text.length;
}

widened(Shape shape) -> int {
    if (!(shape is Circle)) {
        return 0;
    }
    int total = 0;
    for (int i = 0; i < 2; i++) {
        total = total + shape.radius;
        shape = new Square();
    }
    return total;
}

main() -> int {
    Shape circle = new Circle();
    long texts = assigned() + assignedNull() + joinedRead(true) + afterLoop() + samePass(true)
        + conditionWrite() + joinedNull(true) + breakNull(true) + innerBreak(true) + conditionCheck("a", null)
        + disjunctionNull("a", true) + conditionRewrite() + conditionReassigned("a", null);
    bool same = sameCondition("a", null) && sameConditionTest(circle, circle);
    return texts as int + passedOut() + widened(circle) + loopedClass(true, circle, circle)
        + conditionTest(circle, circle) + conditionGuard(circle, circle) + (same ? 1 : 0);
}
