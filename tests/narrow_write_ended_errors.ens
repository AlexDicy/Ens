// @expect-error Cannot read a member of 'string?' because it may be null here. 'name' is assigned a value of type 'string?', which can be null. Check 'name' for null after the assignment ('if (name != null)').
// @expect-note 'name' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'name' is assigned 'null'.
// @expect-error '+' needs numbers on both sides, but 'count' has type 'int?'. 'count' is not null when the loop starts, but the loop passes it as 'out' to 'reset', so it may be null on a later pass. Check 'count' for null inside the loop ('if (count != null)').
// @expect-note 'reset' can write 'count' here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'joined' is assigned a value of type 'string?', which can be null. Check 'joined' for null after the 'if' statement ('if (joined != null)').
// @expect-note 'joined' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'left' is assigned a value of type 'string?', which can be null. Check 'left' for null after the 'while' loop ('if (left != null)').
// @expect-note 'left' is assigned here
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is a 'Circle' when the loop starts, but the loop assigns it a 'Square', so it may be any 'Shape' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Circle)'.
// @expect-note 'shape' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'fresh' is assigned a value of type 'string?', which can be null. Check 'fresh' for null after the assignment ('if (fresh != null)').
// @expect-note 'fresh' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'polled' is assigned a value of type 'string?', which can be null. Check 'polled' for null after the assignment ('if (polled != null)').
// @expect-note 'polled' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'cleared' is assigned 'null' in one branch of the 'if' statement. Check 'cleared' for null after the 'if' statement ('if (cleared != null)').
// @expect-note 'cleared' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'stopped' is assigned 'null' in the 'while' loop. Check 'stopped' for null after the 'while' loop ('if (stopped != null)').
// @expect-note 'stopped' is assigned here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'inner' is assigned 'null' in the 'while' loop. Check 'inner' for null after the 'while' loop ('if (inner != null)').
// @expect-note 'inner' is assigned here
// @expect-error build failed with 11 problems
// A write that ends a narrowing is named where the value is read, with a note at the write: an
// assignment of a value that can be null, an assignment of 'null', which no check can fix, and an
// 'out' argument in a loop, which can write the value before a later pass reaches the read. The check
// goes after the 'if' whose branch assigns the value, and after the loop that assigns it, and a write in
// a loop that leaves a wider type there is named where a read needs the narrower one. A write earlier in
// the same pass through a loop, in its body or its condition, is named as a plain assignment, and a write
// of 'null' in a branch or in a loop the read comes after names that branch or loop.

external from libc {
    reset(out int? slot) -> int;
}

pick() -> string? {
    return null;
}

assigned() -> long {
    string? name = "start";
    name = pick();
    return name.length;
}

assignedNull() -> long {
    string? name = "start";
    name = null;
    return name.length;
}

passedOut() -> int {
    int? count = 3;
    int total = 0;
    while (total < 9) {
        total = total + count;
        let ignored = reset(out count);
    }
    return total;
}

joinedRead(bool flag) -> long {
    string? joined = "start";
    if (flag) {
        joined = pick();
    }
    return joined.length;
}

afterLoop() -> long {
    string? left = "start";
    while (true) {
        left = pick();
        break;
    }
    return left.length;
}

samePass(bool go) -> long {
    string? fresh = "a";
    long total = 0;
    while (go) {
        fresh = pick();
        total = total + fresh.length;
    }
    return total;
}

conditionWrite() -> long {
    string? polled = "a";
    long total = 0;
    while ((polled = pick()) == null && total < 2) {
        total = total + polled.length;
    }
    return total;
}

joinedNull(bool flag) -> long {
    string? cleared = "start";
    if (flag) {
        cleared = null;
    }
    return cleared.length;
}

breakNull(bool go) -> long {
    string? stopped = "a";
    while (go) {
        stopped = null;
        if (go) {
            break;
        }
        stopped = "x";
    }
    return stopped.length;
}

innerBreak(bool go) -> long {
    string? inner = "a";
    long total = 0;
    while (total < 3) {
        total = total + 1;
        while (go) {
            inner = null;
            break;
        }
        total = total + inner.length;
        inner = "y";
    }
    return total;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 2;

    protected constructor();
}

class Square extends Shape {
    protected constructor();
}

widened(Shape shape) -> int {
    if (!(shape is Circle)) {
        return 0;
    }
    int total = 0;
    for (int i = 0; i < 2; i++) {
        total = total + shape.radius;
        shape = new Square();
    }
    return total;
}

main() -> int {
    return (assigned() + assignedNull() + joinedRead(true) + afterLoop() + samePass(true) + conditionWrite()
        + joinedNull(true) + breakNull(true) + innerBreak(true)) as int + passedOut() + widened(new Circle());
}
