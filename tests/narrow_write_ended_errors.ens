// @expect-error '+' needs numbers on both sides, but 'count' has type 'int?'. 'count' is not null when the loop starts, but the loop passes it as 'out' to 'reset', so it may be null on a later pass. Check 'count' for null inside the loop ('if (count != null)').
// @expect-note 'reset' can write 'count' here
// @expect-error Cannot read a member of 'string?' because it may be null here. 'inner' is assigned 'null' in the 'while' loop. Check 'inner' for null after the 'while' loop ('if (inner != null)').
// @expect-note 'inner' is assigned here
// @expect-error Type 'Shape' has no field or method named 'radius'. 'shape' is assigned a 'Shape' in the condition after the test, so 'shape' may be any 'Shape' here. Test 'shape' again after the assignment, as in 'if (shape is Circle)'.
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned 'null' on the right of '||'. Check 'text' for null after the '||' ('if (text != null)').
// @expect-error Cannot read a member of 'string?' because it may be null here. 'text' is assigned a value of type 'string?' in the condition after the check, and the condition is only false when 'text' is null.
// @expect-error build failed with 5 problems
// A write that ends a narrowing is named where the value is read. An 'out' argument in a loop can
// write the value before a later pass reaches the read, and is named with a note at the write, and
// so is a write of 'null' in a loop inside the loop the read is in. A write in a condition after a
// test of the same place is named after an 'if' its failed condition leaves, a write of 'null' on
// the right of '||' is named after the '||', and a write that leaves the condition false only when
// the value is null says so.

external from libc {
    reset(out int? slot) -> int;
}

passedOut() -> int {
    int? count = 3;
    int total = 0;
    while (total < 9) {
        total = total + count;
        let ignored = reset(out count);
    }
    return total;
}

innerBreak(bool go) -> long {
    string? inner = "a";
    long total = 0;
    while (total < 3) {
        total = total + 1;
        while (go) {
            inner = null;
            break;
        }
        total = total + inner.length;
        inner = "y";
    }
    return total;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius = 2;

    protected constructor();
}

keep(string? value) -> bool {
    return true;
}

keepShape(Shape value) -> bool {
    return true;
}

conditionGuard(Shape shape, Shape other) -> int {
    if (!(shape is Circle) || !keepShape(shape = other)) {
        return 0;
    }
    return shape.radius;
}

disjunctionNull(string? text, bool done) -> long {
    text = "a";
    bool finished = done || keep(text = null);
    return text.length;
}

conditionReassigned(string? text, string? other) -> long {
    if (text == null || (text = other) != null) {
        return 0;
    }
    return text.length;
}

main() -> int {
    Shape circle = new Circle();
    long texts = innerBreak(true) + disjunctionNull("a", true) + conditionReassigned("a", null);
    return texts as int + passedOut() + conditionGuard(circle, circle);
}
