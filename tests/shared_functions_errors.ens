import List from @std.collections.list;

class Indexer {
    long total;

    constructor() {
        this.total = 0;
    }

    plan() -> shared () -> long {
        return () -> this.total;
    }
}

class Roster {
    const List<string> names;

    constructor() {
        this.names = new List<string>();
    }

    plan() -> shared () -> long {
        return () -> this.names.length();
    }
}

class Starter {
    const int seed;
    shared () -> int work = () -> 0;

    constructor() {
        this.seed = 2;
        this.work = () -> this.seed;
    }
}

class Node {
    int value;

    constructor() {
        this.value = 1;
    }
}

run(shared () -> int work) -> int {
    return work();
}

main() {
    let items = new List<int>();
    int[] codes = [1, 2];
    let node = new Node();
    run(() -> items.length() as int);
    run(() -> codes[0]);
    run(() -> node.value);
    () -> int loose = () -> 1;
    run(loose);
}
