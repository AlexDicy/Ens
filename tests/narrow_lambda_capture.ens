// A lambda works on its own copy of what it captures, and nothing can write that copy. A check
// written inside the lambda narrows a captured value wherever the check holds, exactly as it
// narrows a local: after a guard that returns, inside a branch, after a join, under a loop
// condition, a '?:', '&&' and '||', and inside a lambda nested in another. A narrowing that holds
// where the lambda is created holds inside it too: of a parameter, of a value an initializer gives,
// by a type test, of 'this', of a 'const' field of a struct and of a lazy const, in a nested lambda,
// in lambdas made in a loop, in a field default and in a generic call, and in an argument written
// after the argument that narrows it. The copy keeps its value and its narrowing when the local is
// written after the lambda is created.
// @exit 0
// @stdout guard 5 -1
// @stdout branch 5 -1
// @stdout typed 2 0
// @stdout typed guard 2 0
// @stdout loop 3 0
// @stdout ternary 5 -1
// @stdout logical true false true false
// @stdout joined 5 -1 5
// @stdout switched 5 -1
// @stdout nested 55 -1
// @stdout local 5 -1
// @stdout number 42 0
// @stdout field 4 -1
// @stdout carried 5 -1
// @stdout initializer 42
// @stdout carried test 2 0
// @stdout struct 3 -1
// @stdout lazy 5
// @stdout this 7 0
// @stdout carried nested 10 -1
// @stdout carried loop 5
// @stdout copy 5 -1
// @stdout default 3
// @stdout generic 5 -1
// @stdout conjunction true false
// @stdout copied field 4 -1
// @stdout earlier argument 3

import List from @std.collections.list;

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;

    protected constructor(this.radius);
}

class Label {
    protected const string? text;

    protected constructor(this.text);

    protected measure() -> () -> long {
        return () -> {
            if (this.text == null) {
                return -1;
            }
            return this.text.length;
        };
    }
}

length(string text) -> long {
    return text.length;
}

guarded(string? held) -> () -> long {
    return () -> {
        if (held == null) {
            return -1;
        }
        return length(held);
    };
}

branched(string? held) -> () -> long {
    return () -> {
        if (held != null) {
            return length(held);
        }
        return -1;
    };
}

typed(Shape shape) -> () -> int {
    return () -> {
        if (shape is Circle) {
            return shape.radius;
        }
        return 0;
    };
}

typedGuard(Shape shape) -> () -> int {
    return () -> {
        if (!(shape is Circle)) {
            return 0;
        }
        return shape.radius;
    };
}

looped(string? held) -> () -> long {
    return () -> {
        long total = 0;
        long rounds = 0;
        while (held != null && rounds < 3) {
            total = total + length(held);
            rounds = rounds + 1;
        }
        return total;
    };
}

ternary(string? held) -> () -> long {
    return () -> held != null ? length(held) : -1;
}

present(string? held) -> () -> bool {
    return () -> held != null && length(held) > 0;
}

absent(string? held) -> () -> bool {
    return () -> held == null || length(held) == 0;
}

joined(string? held, bool first) -> () -> long {
    return () -> {
        if (first) {
            if (held == null) {
                return -1;
            }
        } else {
            if (held == null) {
                return -1;
            }
        }
        return length(held);
    };
}

switched(string? held, int mode) -> () -> long {
    return () -> {
        switch (mode) {
            0 -> {
                if (held == null) {
                    return -1;
                }
            },
            default -> {
                if (held == null) {
                    return -1;
                }
            },
        }
        return length(held);
    };
}

nested(string? held) -> () -> () -> long {
    return () -> {
        if (held == null) {
            return () -> -1;
        }
        long outer = length(held);
        return () -> {
            if (held == null) {
                return -1;
            }
            return length(held) * 10 + outer;
        };
    };
}

pick(bool present) -> string? {
    if (present) {
        return "hello";
    }
    return null;
}

capturedLocal(bool present) -> () -> long {
    string? local = pick(present);
    return () -> {
        if (local == null) {
            return -1;
        }
        return length(local);
    };
}

number(int? held) -> () -> int {
    return () -> {
        if (held == null) {
            return 0;
        }
        return held;
    };
}

struct Pair {
    const string? fixed;
}

class Panel {
    protected constructor();

    protected widthOf() -> () -> int {
        if (this is WidePanel) {
            return () -> this.width;
        }
        return () -> 0;
    }
}

class WidePanel extends Panel {
    protected int width = 7;

    protected constructor();
}

class Settings {
    protected lazy const string? label = "label";
}

class Fields {
    protected string? name = "abc";
    protected () -> long measure = name != null ? () -> length(name) : () -> -1;

    protected constructor();
}

apply<T>(() -> T body) -> T {
    return body();
}

run(() -> long body) -> bool {
    return body() > 0;
}

carriedParameter(string? held) -> () -> long {
    if (held == null) {
        return () -> -1;
    }
    return () -> length(held);
}

carriedInitializer() -> () -> int {
    int? count = 41;
    return () -> count + 1;
}

carriedTest(Shape shape) -> () -> int {
    if (shape is Circle) {
        return () -> shape.radius;
    }
    return () -> 0;
}

carriedStruct(Pair pair) -> () -> long {
    if (pair.fixed == null) {
        return () -> -1;
    }
    return () -> length(pair.fixed);
}

carriedLazy() -> () -> long {
    if (Settings.label == null) {
        return () -> -1;
    }
    return () -> length(Settings.label);
}

carriedNested(string? held) -> () -> () -> long {
    if (held == null) {
        return () -> () -> -1;
    }
    return () -> () -> length(held) * 2;
}

carriedLoop(string?[] items) -> long {
    let measures = new List<() -> long>();
    for (let item in items) {
        if (item != null) {
            measures.push(() -> length(item));
        }
    }
    long total = 0;
    for (let measure in measures) {
        total = total + measure();
    }
    return total;
}

carriedCopy(bool present) -> long {
    string? held = pick(present);
    if (held == null) {
        return -1;
    }
    () -> long measure = () -> length(held);
    held = null;
    return measure();
}

carriedGeneric(string? held) -> long {
    if (held == null) {
        return -1;
    }
    return apply<long>(() -> length(held));
}

carriedConjunction(string? held) -> bool {
    return held != null && run(() -> length(held));
}

class Holder {
    protected const string? fixed;

    protected constructor(this.fixed);
}

// A 'const' field of a class object copied into a local before the lambda narrows the local inside it.
copiedField(Holder holder) -> () -> long {
    if (holder.fixed == null) {
        return () -> -1;
    }
    let fixed = holder.fixed;
    return () -> length(fixed);
}

makeBody(string? text) -> () -> long {
    return () -> 0;
}

runLast((() -> long)[] bodies) -> long {
    return bodies[bodies.length - 1]();
}

runLast(long[] values) -> long {
    return values[0];
}

// The second element narrows `first` because it is written after the element that assigns it.
earlierArgument() -> long {
    string? first = null;
    return runLast([makeBody(first = "abc"), () -> first.length]);
}

main() -> int {
    print("guard {guarded("hello")()} {guarded(null)()}");
    print("branch {branched("hello")()} {branched(null)()}");
    print("typed {typed(new Circle(2))()} {typed(new Shape())()}");
    print("typed guard {typedGuard(new Circle(2))()} {typedGuard(new Shape())()}");
    print("loop {looped("a")()} {looped(null)()}");
    print("ternary {ternary("hello")()} {ternary(null)()}");
    print("logical {present("a")()} {present(null)()} {absent(null)()} {absent("a")()}");
    print("joined {joined("hello", true)()} {joined(null, false)()} {joined("hello", false)()}");
    print("switched {switched("hello", 0)()} {switched(null, 1)()}");
    print("nested {nested("hello")()()} {nested(null)()()}");
    print("local {capturedLocal(true)()} {capturedLocal(false)()}");
    print("number {number(42)()} {number(null)()}");
    print("field {new Label("text").measure()()} {new Label(null).measure()()}");
    print("carried {carriedParameter("hello")()} {carriedParameter(null)()}");
    print("initializer {carriedInitializer()()}");
    print("carried test {carriedTest(new Circle(2))()} {carriedTest(new Shape())()}");
    print("struct {carriedStruct({ fixed: "abc" })()} {carriedStruct({ fixed: null })()}");
    print("lazy {carriedLazy()()}");
    print("this {new WidePanel().widthOf()()} {new Panel().widthOf()()}");
    print("carried nested {carriedNested("hello")()()} {carriedNested(null)()()}");
    print("carried loop {carriedLoop(["ab", null, "cde"])}");
    print("copy {carriedCopy(true)} {carriedCopy(false)}");
    print("default {new Fields().measure()}");
    print("generic {carriedGeneric("hello")} {carriedGeneric(null)}");
    print("conjunction {carriedConjunction("a")} {carriedConjunction(null)}");
    print("copied field {copiedField(new Holder("text"))()} {copiedField(new Holder(null))()}");
    print("earlier argument {earlierArgument()}");
    return 0;
}
