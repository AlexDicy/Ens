// 'primitive' introduces a standard-library declaration and is a plain identifier everywhere
// else, so a program may name a local, a field, a parameter, a method, and a function with it.
// @stdout primitive local: 3
// @stdout primitive field: 7
// @stdout primitive method: 14
// @stdout primitive function: 21
// @exit 0
export class Counter {
    export long primitive;

    export constructor(this.primitive);

    export doubled() -> long {
        return this.primitive * 2;
    }
}

export class Doubler {
    export primitive() -> long {
        return 0;
    }
}

primitive(long primitive) -> long {
    return primitive * 3;
}

main() -> int {
    let local = 3;
    print("primitive local: {local}");
    let counter = new Counter(7L);
    print("primitive field: {counter.primitive}");
    print("primitive method: {counter.doubled()}");
    print("primitive function: {primitive(7L)}");
    return 0;
}
