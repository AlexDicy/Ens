// @exit 0
// A 'public external type' crosses the module boundary within one package: main imports the handle
// type CStr from lib.cstr, names it in a parameter, and calls the wrapper that produces one. An
// unset environment variable deterministically yields a null handle.
import lib.cstr;
import CStr from lib.cstr;

isSet(CStr? handle) -> bool {
    return handle != null;
}

main() -> int {
    CStr? unset = cstr.lookup("ENS_SURELY_UNSET_ENVIRONMENT_VARIABLE_9Z");
    if (isSet(unset)) {
        return 1;
    }
    return 0;
}
