// A foreign handle marked 'public' is visible to every module in this package. Its external
// block and the calls it wraps stay private to this file; the wrapper 'lookup' is what other
// modules use to obtain a handle.
public external type CStr;

external from libc {
    getenv(string name) -> CStr?;
}

public lookup(string name) -> CStr? {
    return getenv(name);
}
