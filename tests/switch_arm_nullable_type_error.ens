// @expect-error The type of an 'is' arm cannot be nullable; 'is' never matches null. Test against 'Node' and handle null with a 'null ->' arm.
// @expect-error build failed with 1 problem
// An 'is' arm names a type, and a '?' on it is a real mistake with a real answer: the arm never
// matches null, and a 'null ->' arm is where the absent case belongs. The parser reads the suffix
// as part of the type so the arm keeps its shape, which is what lets the checker say so.
class Node {
    protected int id;

    protected constructor(this.id);
}

class Holder<T> {
    protected T stored;

    protected constructor(this.stored);

    protected value() -> T {
        return this.stored;
    }
}

main() -> int {
    let holder = new Holder<Node?>(new Node(3));
    long tag = switch (holder.value()) {
        is Node? -> 1,
        null -> 0,
        default -> -1,
    };
    print("tag " + tag);
    return 0;
}
