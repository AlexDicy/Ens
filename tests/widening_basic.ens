// @exit 42
addOne(long n) -> long {
    return n + 1;
}

firstPlus(int[] arr, int i, long bias) -> long {
    return arr[i] + bias;
}

main() -> int {
    // Polymorphic int literal into long / double / byte (unsigned 0..255).
    long y = 5;
    double d = 5;
    byte b = 5;
    byte high = 200;
    if (y != 5L)         { return 1; }
    if (d < 4.5)         { return 2; }
    if (d > 5.5)         { return 3; }
    if ((b as int) != 5) { return 4; }
    if ((high as int) != 200) { return 5; }

    // int variable widens to long via assignment.
    int xi = 7;
    long widenedFromInt = xi;
    if (widenedFromInt != 7L) { return 6; }

    // Binary widening: int + long -> long, no `as` needed.
    long sum = xi + 3L;
    if (sum != 10L)     { return 7; }

    // Forward loop where the bound is a long. With implicit widening the
    // `int i < long arr.length` comparison no longer requires a cast.
    int[] arr = new int[4];
    arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
    int loopSum = 0;
    int i = 0;
    while (i < arr.length) {
        loopSum = loopSum + arr[i];
        i = i + 1;
    }
    if (loopSum != 10)  { return 8; }

    // Ternary picking common type long.
    let mixed = true ? xi : 100L;
    if (mixed != 7L)    { return 9; }

    // Function call: int passed to long parameter.
    long called = addOne(xi);
    if (called != 8L)   { return 10; }

    // Mixed array element + bias param.
    long mixedSum = firstPlus(arr, 2, 100L);
    if (mixedSum != 103L) { return 11; }

    return 42;
}
