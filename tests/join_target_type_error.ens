// Where nothing states the type of a '?:' or a switch whose values share no class, the error names
// the interfaces they share and the declaration that gives the value one of them.
interface Interaction {
    name() -> string;
}

interface Gesture {
    fingers() -> int;
}

class Tap implements Interaction, Gesture {
    override name() -> string {
        return "tap";
    }

    override fingers() -> int {
        return 1;
    }
}

class Drag implements Interaction, Gesture {
    override name() -> string {
        return "drag";
    }

    override fingers() -> int {
        return 2;
    }
}

class Lone implements Interaction {
    override name() -> string {
        return "lone";
    }
}

class Plain {
}

main() -> int {
    bool tapped = true;
    let chosen = tapped ? new Tap() : new Drag();
    const fixed = switch (1) {
        0 -> new Tap(),
        default -> new Drag(),
    };
    print((tapped ? new Tap() : new Drag()).name());
    let single = tapped ? new Tap() : new Lone();
    let unrelated = tapped ? new Tap() : new Plain();
    return 0;
}
