import @std.testing;
import Account from ledger;
import Ledger from ledger;

test "a ledger sums its accounts" {
    let ledger = new Ledger(new Account(1), new Account(2), new Account(3));
    try testing.assertEqual(ledger.total(), 6);
}

test "an empty ledger sums to nothing" {
    let ledger = new Ledger(new Account(0), new Account(0), new Account(0));
    try testing.assertEqual(ledger.total(), 0);
}
