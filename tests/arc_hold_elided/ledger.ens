// A ledger over three accounts, summed by calling each account read out of its field.
export class Account {
    int balance;

    export constructor(this.balance);

    export amount() -> int {
        return this.balance;
    }
}

export class Ledger {
    Account first;
    Account second;
    Account third;

    export constructor(this.first, this.second, this.third);

    export total() -> int {
        return this.first.amount() + this.second.amount() + this.third.amount();
    }
}
