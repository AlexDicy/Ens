// @expect-error Cannot read a member of 'Door?'
class Door {
    int code;
    protected constructor(this.code = 0);

    protected open() {
        // could mutate the parent's door field via some back-reference
    }
}

class Room {
    protected Door? door;
    protected constructor(this.door = null);
}

main() -> int {
    let r = new Room(new Door(7));
    if (r.door != null) {
        r.door.open();      // this call exposes r.door's root (r); narrowing dropped
        return r.door.code; // error - r.door is back to 'Door?'
    }
    return 0;
}