// @exit 0
// @stdout largest 9
// @stdout largest word pear
// @stdout smallest 3
// @stdout sorted 3 9 of 3
// @stdout first 3
// @stdout shelf apple
// @stdout round trip 12
// A type parameter's bounds resolve with the whole list in scope, so a bound may name the
// parameter it constrains or a sibling. Each site judges the bound with the arguments substituted
// in, so 'Item' is asked for 'Comparable<Item>'.
import List from @std.collections.list;

class Item implements Comparable<Item> {
    protected int value;

    protected constructor(this.value);

    protected override compareTo(Item other) -> int {
        return this.value - other.value;
    }
}

class Word implements Comparable<Word> {
    protected string text;

    protected constructor(this.text);

    protected override compareTo(Word other) -> int {
        return this.text.compareTo(other.text);
    }
}

largest<T: Comparable<T>>(T[] values) -> T {
    T best = values[0];
    for (let value in values) {
        if (value.compareTo(best) > 0) {
            best = value;
        }
    }
    return best;
}

// The class's own list names T in T's bound; each static judges it at the type it settled on.
class Sorted<T: Comparable<T>> {
    List<T> items;

    protected constructor() {
        this.items = new List<T>();
    }

    protected static smallestOf(T first, T second) -> T {
        if (second.compareTo(first) < 0) {
            return second;
        }
        return first;
    }

    protected static of(T[] values) -> Sorted<T> {
        let sorted = new Sorted<T>();
        for (let value in values) {
            sorted.add(value);
        }
        return sorted;
    }

    protected add(T value) {
        this.items.push(value);
        long index = this.items.length() - 1;
        while (index > 0 && this.items.get(index - 1).compareTo(value) > 0) {
            this.items.set(index, this.items.get(index - 1));
            index = index - 1;
        }
        this.items.set(index, value);
    }

    protected first() -> T {
        return this.items.get(0);
    }

    protected last() -> T {
        return this.items.get(this.items.length() - 1);
    }

    protected count() -> long {
        return this.items.length();
    }
}

// A field instantiates the self-bounded class before any template completes, so the check waits
// for the filled conformance.
struct Shelf {
    protected Sorted<Word>? words;
}

// Two parameters bounded by each other: converting an A answers a B, and converting that answers
// an A again.
interface Converts<T> {
    convert() -> T;
}

class Meters implements Converts<Feet> {
    protected int count;

    protected constructor(this.count);

    protected override convert() -> Feet {
        return new Feet(this.count * 3);
    }
}

class Feet implements Converts<Meters> {
    protected int count;

    protected constructor(this.count);

    protected override convert() -> Meters {
        return new Meters(this.count / 3);
    }
}

roundTrip<A: Converts<B>, B: Converts<A>>(A start) -> A {
    return start.convert().convert();
}

main() -> int {
    Item[] items = [new Item(3), new Item(9), new Item(5)];
    print("largest {largest(items).value}");
    print("largest word {largest<Word>([new Word("apple"), new Word("pear")]).text}");
    print("smallest {Sorted.smallestOf(new Item(5), new Item(3)).value}");
    let sorted = Sorted.of(items);
    print("sorted {sorted.first().value} {sorted.last().value} of {sorted.count()}");
    print("first {Sorted<Item>.of(items).first().value}");
    Shelf shelf = {words: Sorted.of([new Word("pear"), new Word("apple")])};
    let words = shelf.words;
    if (words != null) {
        print("shelf {words.first().text}");
    }
    print("round trip {roundTrip<Meters, Feet>(new Meters(12)).count}");
    return 0;
}
