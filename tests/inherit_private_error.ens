// @expect-error 'secret' is private to class 'Base', so only code inside 'Base' can use it. Mark it 'public' to use it here.
// @expect-error 'secret' is private to 'Base', so 'Binds' has no field by that name. Declare one in 'Binds', or mark 'secret' 'protected' in 'Base'.
// @expect-error Field 'shared' is already declared in base class 'Base'.
// @expect-error No field 'missing' on type 'Absent'. Drop 'this.' and give the parameter a type, as in 'int missing'.
// @expect-error build failed with 4 problems
// A private base field is not inherited: a subclass cannot read it, and may declare a field of
// its own under the same name. A base field the subclass can see is inherited, so reusing its
// name is still a duplicate. A 'this.field' parameter binds a field of the class that declares
// the constructor, so it cannot reach the private base field either. A name no field of the
// chain declares is refused as the absent field it is.
class Base {
    int secret;
    protected int shared;

    protected constructor(this.secret = 0) {
        this.shared = 1;
    }
}

class Derived extends Base {
    reveal() -> int { return this.secret; }
}

class Reuses extends Base {
    protected string secret;

    protected constructor() {
        super();
        this.secret = "own";
    }

    protected own() -> string { return this.secret; }
}

class Collides extends Base {
    protected int shared;

    protected constructor() {
        super();
    }
}

class Binds extends Base {
    protected constructor(this.secret);
}

class Absent extends Base {
    protected constructor(this.missing);
}

main() -> int {
    return 0;
}
