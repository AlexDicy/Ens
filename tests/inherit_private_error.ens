// @expect-error 'secret' is private to class 'Base' and can only be accessed from inside 'Base'
// @expect-error Field 'shared' is already declared in base class 'Base'.
// @expect-error build failed with 2 problems
// A private base field is not inherited: a subclass cannot read it, and may declare a field of
// its own under the same name. A base field the subclass can see is inherited, so reusing its
// name is still a duplicate.
class Base {
    int secret;
    protected int shared;

    protected constructor(this.secret = 0) {
        this.shared = 1;
    }
}

class Derived extends Base {
    reveal() -> int { return this.secret; }
}

class Reuses extends Base {
    protected string secret;

    protected constructor() {
        super();
        this.secret = "own";
    }

    protected own() -> string { return this.secret; }
}

class Collides extends Base {
    protected int shared;

    protected constructor() {
        super();
    }
}

main() -> int {
    return 0;
}
