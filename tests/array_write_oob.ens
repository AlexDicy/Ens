// @exit 134
// @stderr-contains panic: tried to write index 5 of an array of length 3. Check the index against length first
// A store past the end aborts, and the panic says the store was what it refused, which is what
// tells a reader which of two accesses on the line was the broken one.
main() -> int {
    int[] xs = new int[3];
    xs[5] = 7;
    return xs[0];
}
