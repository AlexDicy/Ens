// A write that is refused never runs, so it drops no narrowing, after it or before a loop body
// that holds it, and each refused write is the one problem reported for it.
// @expect-error Cannot assign a new value to 'fixed', because 'fixed' is declared 'const'. Remove 'const' from its declaration if it needs to change.
// @expect-error Cannot assign a new value to 'held' inside a lambda: a lambda works on copies of what it captures, so the 'held' outside it would not change. Return the value the lambda computes and store it where the lambda is called, or keep the value in a field of an object the lambda uses.
// @expect-error Cannot pass 'slot' as 'out', because 'slot' is declared 'const'. Remove 'const' from its declaration if it needs to change.
// @expect-error build failed with 3 problems

external from libc {
    reset(out int? slot) -> int;
}

length(string text) -> long {
    return text.length;
}

pick() -> string? {
    return null;
}

constant() -> long {
    const string? fixed = pick();
    if (fixed == null) {
        return 0;
    }
    fixed = pick();
    return length(fixed);
}

captured(string? held) -> () -> long {
    return () -> {
        if (held == null) {
            return 0;
        }
        long total = 0;
        while (total < 4) {
            total = total + length(held);
            held = pick();
        }
        return total;
    };
}

constantOut() -> int {
    const int? slot = 1;
    if (slot == null) {
        return 0;
    }
    let ignored = reset(out slot);
    return slot;
}

main() -> int {
    return (constant() + captured("a")()) as int + constantOut();
}
