// @expect-error '\q' is not an escape. In a string, a backslash starts an escape that writes a special character, such as '\n' for a new line, '\t' for a tab or '\\' for a backslash. Write '\\q' for a backslash followed by 'q'.
// @expect-error '\w' is not an escape. In a character, a backslash starts an escape that writes a special character, such as '\n' for a new line, '\t' for a tab or '\\' for a backslash.
// Unknown backslash escapes are rejected in string literals, in char literals,
// and for the C-style \x that Ens does not support.
main() -> int {
    let s = "a\qb";
    let c = '\w';
    let hex = "\x41";
    return 0;
}
