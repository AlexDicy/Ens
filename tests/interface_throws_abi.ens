// @exit 0
// @stdout through interface ok 8
// @stdout through interface err negative id
// @stdout through interface ok 5
// @stdout direct 8
// An interface method that declares 'throws' fixes the calling convention for every
// implementation reached through that interface, including one that drops the marker because it
// cannot throw. Both edges agree: the interface call and the direct call to the same
// implementation pass the same arguments, the value comes back on the normal path, and the
// throwing implementation's error still reaches the catch.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

public interface Loader {
    load(long id) -> long throws Error;
}

class Strict implements Loader {
    protected constructor();

    override load(long id) -> long throws Error {
        if (id < 0) {
            throw new Failure("negative id");
        }
        return id * 2;
    }
}

public class Lenient implements Loader {
    protected constructor();

    public override load(long id) -> long {
        return id + 1;
    }
}

throughInterface(Loader loader, long id) -> string {
    return "ok " + (try loader.load(id));
} catch (Error e) {
    return "err " + e.message;
}

directly(Lenient loader) -> long {
    return loader.load(7);
}

main() -> int {
    Loader strict = new Strict();
    Loader lenient = new Lenient();
    print("through interface " + throughInterface(strict, 4));
    print("through interface " + throughInterface(strict, -1));
    print("through interface " + throughInterface(lenient, 4));
    print("direct " + directly(new Lenient()));
    return 0;
}
