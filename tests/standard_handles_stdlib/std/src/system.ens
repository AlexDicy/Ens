// The three handles a process's own streams are reached through. Each is a macro in C, so no
// foreign declaration can name one and the compiler defines the bridge that hands it over.
public external type CFile;

external from libc {
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fflush(CFile? stream) -> int;
    ferror(CFile stream) -> int;
    ens_standard_output() -> CFile;
    ens_standard_error() -> CFile;
    ens_standard_input() -> CFile;
}

// A handle never leaves the library, which is what keeps a program away from a native one.
export writeOut(string text) {
    writeLine(ens_standard_output(), text);
}

export writeErr(string text) {
    writeLine(ens_standard_error(), text);
}

// Whether standard input is a handle this process can read, which it is at every start whatever
// the stream is attached to.
export inputUsable() -> bool {
    return ferror(ens_standard_input()) == 0;
}

// `text` and a newline onto `stream`, handed to the operating system before the call returns.
writeLine(CFile stream, string text) {
    byte[] raw = (text + "\n").toBytes();
    let taken = fwrite(raw, 1, raw.length as ulong, stream);
    let flushed = fflush(stream);
}
