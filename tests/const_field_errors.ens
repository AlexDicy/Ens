public class Twice {
    public const int value;

    public constructor() {
        this.value = 1;
        this.value = 2;
    }
}

public class MaybeTwice {
    public const int value;

    public constructor(bool flag) {
        if (flag) {
            this.value = 1;
        }
        this.value = 2;
    }
}

public class DoubleDefault {
    public const int value = 1;

    public constructor(bool flag) {
        if (flag) {
            this.value = 2;
            this.value = 3;
        }
    }
}

public class Looped {
    public const int value;

    public constructor() {
        for (int i = 0; i < 3; i++) {
            this.value = i;
        }
    }
}

public class WhileCondition {
    public const int tick;

    public constructor(int limit) {
        int i = 0;
        while ((this.tick = i) < limit) {
            i++;
        }
    }
}

public class ForCondition {
    public const int mark;

    public constructor(int limit) {
        for (int i = 0; (this.mark = i) < limit; i++) {
        }
    }
}

public class Sometimes {
    public const int value;

    public constructor(bool flag) {
        if (flag) {
            this.value = 1;
        }
    }
}

public class Bumped {
    public const int value = 0;

    public constructor() {
        this.value++;
    }
}

public class Folded {
    public const int value = 0;

    public constructor() {
        this.value += 4;
    }
}

public class FromMethod {
    public const int value;

    public constructor(this.value);

    poke() {
        this.value = 9;
    }
}

public class FromDestructor {
    public const int value;

    public constructor(this.value);

    destructor() {
        this.value = 0;
    }
}

public class FromOther {
    public const int value;

    public constructor(FromOther other) {
        this.value = 1;
        other.value = 2;
    }
}

public class Root {
    public const int seed;

    public constructor(this.seed);
}

public class Stem extends Root {
    public constructor() {
        super(1);
        this.seed = 2;
    }

    public constructor(this.seed, bool ignored) {
        super(3);
    }
}

public struct Pair {
    public const int first;
    public const int second = 0;
}

public class Cell<T> {
    public const T seed;

    public constructor(this.seed);
}

public class Grown<T> extends Cell<T> {
    public constructor(T value) {
        super(value);
    }
}

grow() {
    let plant = new Grown<int>(1);
    plant.seed = 5;
}

public struct Slot<T> {
    public const T stored;
}

public class Holder {
    Pair bare;
}

allocate() {
    let pairs = new Pair[2];
    let slots = new Slot<int>[1];
}

public class Tangle {
    public weak const Tangle? neighbor;

    public constructor(this.neighbor);
}

public class Silent {
    public const int value;
}

public class TooLate {
    public const int early;

    public constructor() {
        this.early = 1;
        try shaky();
    }
    catch (Error e) {
        this.early = -1;
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

shaky() throws {
    throw new Failure("boom");
}

main() -> int {
    Pair pair = {first: 1};
    pair.first = 5;
    Pair partial = {};
    return 0;
}
