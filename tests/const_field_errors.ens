public class Twice {
    public const int value;

    public constructor() {
        this.value = 1;
        this.value = 2;
    }
}

public class MaybeTwice {
    public const int value;

    public constructor(bool flag) {
        if (flag) {
            this.value = 1;
        }
        this.value = 2;
    }
}

public class DoubleDefault {
    public const int value = 1;

    public constructor(bool flag) {
        if (flag) {
            this.value = 2;
            this.value = 3;
        }
    }
}

public class Looped {
    public const int value;

    public constructor() {
        for (int i = 0; i < 3; i++) {
            this.value = i;
        }
    }
}

public class WhileCondition {
    public const int tick;

    public constructor(int limit) {
        int i = 0;
        while ((this.tick = i) < limit) {
            i++;
        }
    }
}

public class ForCondition {
    public const int mark;

    public constructor(int limit) {
        for (int i = 0; (this.mark = i) < limit; i++) {
        }
    }
}

public class Sometimes {
    public const int value;

    public constructor(bool flag) {
        if (flag) {
            this.value = 1;
        }
    }
}

public class Bumped {
    public const int value = 0;

    public constructor() {
        this.value++;
    }
}

public class Folded {
    public const int value = 0;

    public constructor() {
        this.value += 4;
    }
}

public class FromMethod {
    public const int value;

    public constructor(this.value);

    poke() {
        this.value = 9;
    }
}

public class FromDestructor {
    public const int value;

    public constructor(this.value);

    destructor() {
        this.value = 0;
    }
}

public class FromOther {
    public const int value;

    public constructor(FromOther other) {
        this.value = 1;
        other.value = 2;
    }
}

public class Root {
    public const int seed;

    public constructor(this.seed);
}

public class Stem extends Root {
    public constructor() {
        super(1);
        this.seed = 2;
    }

    public constructor(this.seed, bool ignored) {
        super(3);
    }
}

public struct Pair {
    public const int first;
    public const int second = 0;
}

public class Cell<T> {
    public const T seed;

    public constructor(this.seed);
}

public class Grown<T> extends Cell<T> {
    public constructor(T value) {
        super(value);
    }
}

grow() {
    let plant = new Grown<int>(1);
    plant.seed = 5;
}

public struct Slot<T> {
    public const T stored;
}

public class Holder {
    Pair bare;
}

allocate() {
    let pairs = new Pair[2];
    let slots = new Slot<int>[1];
}

public class Tangle {
    public weak const Tangle? neighbor;

    public constructor(this.neighbor);
}

public class Silent {
    public const int value;
}

// A this-field shorthand parameter is the first assignment, so the note lands on the parameter.
public class Reassigned {
    public const int held;

    public constructor(this.held) {
        this.held = 2;
    }
}

public class TooLate {
    public const int early;

    public constructor() {
        this.early = 1;
        try shaky();
    }
    catch (Error e) {
        this.early = -1;
    }
}

// A default value is the one value of a 'const' field, so no constructor, parameter or literal
// gives it another, and a nullable 'const' field does not start as null.
public class Bound {
    public const int limit = 10;

    public constructor(this.limit);
}

public class Rooted {
    public const int seed = 1;

    public constructor();
}

public class Grafted extends Rooted {
    public constructor() {
        super();
        this.seed = 2;
    }
}

// Every field has a value once the default is computed, so 'this' can leave the constructor here,
// and code it reaches must never see 'fixed' change.
public class Watched {
    public const string? fixed = "start";

    public constructor() {
        observe(this);
        this.fixed = null;
    }
}

observe(Watched watched) {
}

public class Labeled {
    public const string? label;

    public constructor(bool flag) {
        if (flag) {
            this.label = "set";
        }
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

shaky() throws {
    throw new Failure("boom");
}

main() -> int {
    Pair pair = {first: 1};
    pair.first = 5;
    Pair partial = {};
    Pair both = {first: 1, second: 2};
    return 0;
}
