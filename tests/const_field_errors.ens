// @expect-error Field 'tick' is 'const' and cannot be assigned inside a loop, which can run more than once. Assign it once, outside the loop.
// @expect-error Field 'mark' is 'const' and cannot be assigned inside a loop, which can run more than once. Assign it once, outside the loop.
// @expect-error The '++' operator cannot change field 'value': a 'const' field gets its value when the object is constructed and never changes. Remove 'const' from the field if it needs to change.
// @expect-error Cannot use '+=' on field 'value': a 'const' field gets its value when the object is constructed and never changes. Remove 'const' from the field if it needs to change.
// @expect-error Cannot assign a new value to field 'value': it is 'const', so it is assigned exactly once, inside a constructor of 'FromDestructor' as 'this.value = ...'. Remove 'const' from the field if it needs to change.
// @expect-error Cannot assign a new value to field 'seed': it is 'const', so it is assigned exactly once, inside a constructor of 'Cell' as 'this.seed = ...'. Remove 'const' from the field if it needs to change.
// @expect-error Cannot use 'Pair' as an array element type: a new array's slots start as zero, which is not a valid 'Pair'. Field 'first' of 'Pair' is 'const' with no default value, so nothing could assign it in a new array's slot. Use 'Pair?[]' so a new array's slots can start as null.
// @expect-error Cannot use 'Slot<int>' as an array element type: a new array's slots start as zero, which is not a valid 'Slot<int>'. Field 'stored' of 'Slot<int>' is 'const' with no default value, so nothing could assign it in a new array's slot. Use 'Slot<int>?[]' so a new array's slots can start as null.
// @expect-error Field 'bare' of class 'Holder' has type 'Pair', which cannot be null, and nothing ever assigns it. Give it a default ('Pair bare = ...;'), make it nullable ('Pair? bare;') or add a constructor that assigns it ('constructor(this.bare);').
// @expect-error Field 'held' cannot be assigned here, because it is 'const' and is already assigned when this line runs. Remove this assignment.
// @expect-note 'held' is assigned here
// @expect-error Field 'fixed' cannot be assigned here, because it is 'const' and already has its default value. Remove this assignment, or remove the default '= "start"' and assign 'fixed' in every constructor of 'Watched'.
// @expect-note 'fixed' gets its default value here
// @expect-error Field 'label' of class 'Labeled' is 'const' with no default value and is not assigned on every path through this constructor. Assign it on every path, for example 'this.label = null;'.
// @expect-error build failed with 12 problems
// A 'const' field gets exactly one value when the object is constructed, its default or one
// assignment, so every other shape is rejected: a constructor giving a field with a default another
// value, a second write, a write from outside the declaring type's constructors, and a path that
// never assigns it at all, null included.
public class WhileCondition {
    public const int tick;

    public constructor(int limit) {
        int i = 0;
        while ((this.tick = i) < limit) {
            i++;
        }
    }
}

public class ForCondition {
    public const int mark;

    public constructor(int limit) {
        for (int i = 0; (this.mark = i) < limit; i++) {
        }
    }
}

public class Bumped {
    public const int value = 0;

    public constructor() {
        this.value++;
    }
}

public class Folded {
    public const int value = 0;

    public constructor() {
        this.value += 4;
    }
}

public class FromDestructor {
    public const int value;

    public constructor(this.value);

    destructor() {
        this.value = 0;
    }
}

public struct Pair {
    public const int first;
}

public class Cell<T> {
    public const T seed;

    public constructor(this.seed);
}

public class Grown<T> extends Cell<T> {
    public constructor(T value) {
        super(value);
    }
}

grow() {
    let plant = new Grown<int>(1);
    plant.seed = 5;
}

public struct Slot<T> {
    public const T stored;
}

public class Holder {
    Pair bare;
}

allocate() {
    let pairs = new Pair[2];
    let slots = new Slot<int>[1];
}

// A this-field shorthand parameter is the first assignment, so the note lands on the parameter.
public class Reassigned {
    public const int held;

    public constructor(this.held) {
        this.held = 2;
    }
}

// A default value is the one value of a 'const' field, and a nullable 'const' field does not
// start as null. Every field has a value once the default is computed, so 'this' can leave the
// constructor here, and code it reaches must never see 'fixed' change.
public class Watched {
    public const string? fixed = "start";

    public constructor() {
        observe(this);
        this.fixed = null;
    }
}

observe(Watched watched) {
}

public class Labeled {
    public const string? label;

    public constructor(bool flag) {
        if (flag) {
            this.label = "set";
        }
    }
}

main() -> int {
    return 0;
}
