// @expect-error Struct 'Coordinate' defines 'hash' but not 'equals'
// A struct's hash and equality are a matched pair, exactly as a class's are: a cheaper hash
// that ignores a field would put two equal values in different buckets unless equality
// ignores that field too.

struct Coordinate {
    int x;
    int y;

    override hash() -> long {
        return this.x;
    }
}

main() -> int {
    return 0;
}
