// @exit 0
// @stdout pick Circle
// @stdout payload 42
// @stdout freed 42
// @stdout label ada
// @stdout row 7
// @stdout test true
// @stdout through Circle
// @stdout direct 3
// @stdout end
// An override may narrow the return type its base class or an interface declared, as far as the
// narrowing leaves the value held the same way. Each case here is one pointer under both
// spellings, and what the slot handed back is still given up exactly once.
class Shape {
    protected constructor();

    protected name() -> string {
        return "Shape";
    }
}

class Circle extends Shape {
    protected constructor();

    protected override name() -> string {
        return "Circle";
    }
}

class Payload {
    protected int id;

    protected constructor(this.id);

    destructor() {
        print("freed " + this.id);
    }

    protected read() -> int {
        return this.id;
    }
}

class Base {
    protected constructor();

    protected pick() -> Shape? {
        return null;
    }

    protected find() -> Payload? {
        return null;
    }

    protected label() -> string? {
        return null;
    }

    protected row() -> int[]? {
        return null;
    }

    protected test() -> ((int) -> bool)? {
        return null;
    }
}

class Derived extends Base {
    protected constructor();

    protected override pick() -> Circle {
        return new Circle();
    }

    protected override find() -> Payload {
        return new Payload(42);
    }

    protected override label() -> string {
        return "ada";
    }

    protected override row() -> int[] {
        return [7, 8];
    }

    protected override test() -> (int) -> bool {
        return (int value) -> value > 0;
    }
}

interface Picker {
    choose() -> Shape?;
}

class Chooser implements Picker {
    protected constructor();

    protected override choose() -> Circle {
        return new Circle();
    }
}

// The narrowed reference the slot handed back lives until this returns, and is released once.
reportPayload(Base base) {
    let found = base.find();
    if (found == null) {
        print("payload null");
        return;
    }
    print("payload " + found.read());
}

main() -> int {
    Base base = new Derived();
    let picked = base.pick();
    if (picked == null) {
        print("pick null");
    } else {
        print("pick " + picked.name());
    }
    reportPayload(base);
    print("label " + (base.label() ?? "none"));
    let row = base.row();
    if (row == null) {
        print("row null");
    } else {
        print("row " + row[0]);
    }

    let predicate = base.test();
    if (predicate == null) {
        print("test null");
    } else {
        print("test " + predicate(5));
    }

    Picker picker = new Chooser();
    let chosen = picker.choose();
    if (chosen == null) {
        print("through null");
    } else {
        print("through " + chosen.name());
    }

    // Through the overriding type, where the caller was checked at the narrowed type and the call
    // still reads the slot.
    let derived = new Derived();
    print("direct " + derived.label().length);
    print("end");
    return 0;
}
