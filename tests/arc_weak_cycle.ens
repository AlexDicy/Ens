// @exit 7
class Child {
    protected int v;
    protected weak Parent? parent;
    protected constructor(this.v = 0);
}

class Parent {
    protected Child? child;
    protected constructor(this.child = null);
}

main() -> int {
    let p = new Parent();
    let c = new Child();
    c.v = 7;
    p.child = c;
    c.parent = p;
    return c.v;
}
