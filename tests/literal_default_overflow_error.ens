// @expect-error Literal 3000000000 is too large for 'int', whose largest value is 2147483647. Write '3000000000L' to make it a 'long'.
// A literal nothing gives a type to is an 'int', so a value past the int range has to name the
// type that holds it. Before this was diagnosed the value was silently truncated.
main() -> int {
    let beyondInt = 3000000000;
    return beyondInt;
}
