// @expect-error Cannot use 'int[]' as a Map key: an array's contents, and so its hash, can change while it sits in the table. Key by a value whose contents cannot change, such as a string or an integer.
// @expect-error Cannot use 'List<int>' as a Set element: a collection's contents, and so its hash, can change while it sits in the set. Key by a value whose contents cannot change, such as a string or an integer.
// @expect-error Cannot use 'Tagged' as a Map key: its field 'labels' has type 'string[]', whose contents can change while the key sits in the table. Key by the fields whose contents cannot change, give 'Tagged' its own 'equals' and 'hash' that leave 'labels' out, or key by a value you keep beside the key.
// @expect-error Cannot use 'Outer' as a Map key: its field 'inner.counts' has type 'Map<string, int>', whose contents can change while the key sits in the table. Key by the fields whose contents cannot change, give 'Outer' its own 'equals' and 'hash' that leave 'inner.counts' out, or key by a value you keep beside the key.
// @expect-error Cannot use 'Handle' as a Map key: an external type is an address with no value to hash. Wrap the handle in a class, which hashes by identity, or key by a value you keep beside it.
// @expect-error Cannot use '(int) -> int' as a Set element: a function value has no identity, so it has no hash. Keep a name or tag beside each function and key by that instead.
// @expect-error 'hashOf<Handle>' cannot hash a value of type 'Handle': an external type is an address with no value to hash. Wrap the handle in a class, which hashes by identity, and pass that, or pass a value you keep beside it.
// @expect-error 'hashOf<Callback>' cannot hash a value of type 'Callback'. Field 'step' has type '(int) -> int', which has no hash; a function value has no identity, so it has no hash. Use a type argument with a hash of its own, or give 'Callback' its own 'equals' and 'hash'.
// @expect-note 'hashOf<T>' calls 'hash()' on a value of type 'T' here
// @expect-error 'index<int[]>' cannot use 'int[]' as a Map key: an array's contents, and so its hash, can change while it sits in the table. Key by a value whose contents cannot change, such as a string or an integer.
// @expect-note 'Map' is keyed by 'K' here
// @expect-error Cannot hash a value of type 'Handle': an external type is an address with no value to hash. Wrap the handle in a class, which hashes by identity, or hash a value you keep beside it.
// @expect-error Cannot hash a value of type 'Handle?': an external type is an address with no value to hash. Wrap the handle in a class, which hashes by identity, or hash a value you keep beside it.
// @expect-error Cannot use 'double' as a Map key: a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Use a SortedMap, which finds a key by its order rather than by its hash, or key by a struct of your own whose 'equals' compares the number with 'compareTo(...) == 0' and whose 'hash' returns 'toCanonicalBits() as long'. A NaN then matches a NaN, and the two zeros stay two keys, just as they do in that order.
// @expect-error Cannot use 'float' as a Set element: a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Use a SortedMap, which finds a key by its order rather than by its hash, or key by a struct of your own whose 'equals' compares the number with 'compareTo(...) == 0' and whose 'hash' returns 'toCanonicalBits() as long'. A NaN then matches a NaN, and the two zeros stay two keys, just as they do in that order.
// @expect-error Cannot use 'Reading' as a Map key: its field 'value' has type 'double', which has no hash; a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Key by the fields that are exact, or give 'Reading' its own 'equals' and 'hash', comparing each floating-point field with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as long'. A NaN then matches a NaN, and the two zeros stay two keys, as a SortedMap orders them.
// @expect-error Cannot hash a value of type 'double': a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash the number's 'toCanonicalBits() as long' instead, which gives every NaN the same hash and the two zeros different ones.
// @expect-error Cannot hash a value of type 'double?': a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash the number's 'toCanonicalBits() as long' instead, which gives every NaN the same hash and the two zeros different ones.
// @expect-error 'double[]' cannot be hashed: an array hashes element by element, and its element type 'double' has no hash; a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash a value you keep beside the elements instead.
// @expect-error 'float[]' cannot be hashed: an array hashes element by element, and its element type 'float' has no hash; a NaN is equal to no value, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash a value you keep beside the elements instead.
// @expect-error build failed with 18 problems
// A key that hashes by content but can change is refused where the container is written, a struct
// key by the field that holds one, and a type with no hash wherever it would be hashed. Inside a
// generic the refusal lands on the instantiation that brought the type there, with the generic's
// own line as a note.
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

external type Handle;

external from libc {
    malloc(long size) -> Handle;
}

struct Tagged {
    protected int id;
    protected string[] labels;
}

struct Inner {
    protected Map<string, int> counts;
}

struct Outer {
    protected Inner inner;
}

struct Callback {
    protected (int) -> int step;
}

struct Reading {
    protected double value;
    protected int sensor;
}

struct Registry {
    protected Map<Handle, int>? byHandle;
}

hashOf<T>(T value) -> long {
    return value.hash();
}

index<K>(K first, K second) -> long {
    let table = new Map<K, int>();
    table.set(first, 1);
    table.set(second, 2);
    return table.length();
}

grab() -> Handle? {
    return malloc(8);
}

main() -> int {
    let byArray = new Map<int[], string>();
    let lists = new Set<List<int>>();
    let byTagged = new Map<Tagged, int>();
    let byOuter = new Map<Outer, int>();
    let steps = new Set<(int) -> int>();
    Handle handle = malloc(8);
    long hashedHandle = hashOf(handle);
    Callback callback = {step: (value) -> value + 1};
    long hashedCallback = hashOf(callback);
    long rows = index([1, 2], [3]);
    long direct = handle.hash();
    long nullable = grab().hash();
    let byNumber = new Map<double, string>();
    let floats = new Set<float>();
    let byReading = new Map<Reading, int>();
    double measure = 1.5;
    long hashedNumber = measure.hash();
    double? maybeNumber = null;
    long hashedMaybe = maybeNumber.hash();
    double[] measures = [1.5, 2.5];
    long hashedMeasures = measures.hash();
    float[] widths = [1.5 as float];
    long hashedWidths = widths.hash();
    return 0;
}
