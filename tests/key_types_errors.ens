// @expect-error 'index<int[]>' cannot use 'int[]' as a Map key: an array's contents, and so its hash, can change while it is in the map. Key by a value whose contents cannot change, such as a string or an integer.
// @expect-note 'Map' is keyed by 'K' here
// @expect-error Cannot hash a value of type 'Handle': an external type's contents belong to the C library, so Ens has nothing of it to hash. Wrap the handle in a class, which hashes by identity, or hash a value you keep beside it.
// @expect-error Cannot hash a value of type 'Handle?': an external type's contents belong to the C library, so Ens has nothing of it to hash. Wrap the handle in a class, which hashes by identity, or hash a value you keep beside it.
// @expect-error Cannot hash a value of type 'double?': a NaN, the value a calculation such as 0.0 / 0.0 produces, is not equal to any value, including itself, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash the number's 'toCanonicalBits() as long' instead, which gives every NaN the same hash and the two zeros different ones.
// @expect-error 'double[]' cannot be hashed: an array hashes element by element, and its element type 'double' has no hash; a NaN, the value a calculation such as 0.0 / 0.0 produces, is not equal to any value, including itself, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash a value you keep beside the elements instead.
// @expect-error 'float[]' cannot be hashed: an array hashes element by element, and its element type 'float' has no hash; a NaN, the value a calculation such as 0.0 / 0.0 produces, is not equal to any value, including itself, so nothing could find it again, and negative zero is equal to zero but hashes differently, so one key would become two entries. Hash a value you keep beside the elements instead.
// @expect-error build failed with 6 problems
// A type with no hash is refused wherever it would be hashed. Inside a generic, a key whose
// contents can change is refused at the instantiation that brought it there, with the
// generic's own line as a note.
import Map from @std.collections.map;

external type Handle;

external from libc {
    malloc(long size) -> Handle;
}

index<K>(K first, K second) -> long {
    let table = new Map<K, int>();
    table.set(first, 1);
    table.set(second, 2);
    return table.length();
}

grab() -> Handle? {
    return malloc(8);
}

main() -> int {
    Handle handle = malloc(8);
    long rows = index([1, 2], [3]);
    long direct = handle.hash();
    long nullable = grab().hash();
    double? maybeNumber = null;
    long hashedMaybe = maybeNumber.hash();
    double[] measures = [1.5, 2.5];
    long hashedMeasures = measures.hash();
    float[] widths = [1.5 as float];
    long hashedWidths = widths.hash();
    return 0;
}
