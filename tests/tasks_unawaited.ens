// @exit 134
// @stderr-contains panic: the task started at tasks_unawaited.ens:21 threw an error with the message 'broken', and the scope's body throws no error of that type, so nothing handled the error. Await the task with 'try' where the body runs, or catch the error inside the task's body
// A task started with 'start' that throws fails its scope, and when the scope's body throws no
// error of that type the failure has nowhere to go, so the program aborts when the scope ends,
// naming the line that started the task.
import @std.tasks;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

fail() -> int throws Broken {
    throw new Broken();
    return 0;
}

main() -> int {
    tasks.scope((scope) -> {
        let dropped = scope.start(() -> try fail());
    });
    return 0;
}
