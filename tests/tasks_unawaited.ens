// @exit 134
// @stderr-contains panic: the task started at tasks_unawaited.ens:20 threw an error with the message 'broken', and nothing awaited it, so nothing handled the error. Await every task started with 'start', or catch the error inside its body
// A task started with 'start' that throws and is never awaited aborts the program when its scope
// ends, naming the line that started it, because nothing handled the error.
import @std.tasks;

class Broken extends Error {
    constructor() {
        super("broken");
    }
}

fail() -> int throws Broken {
    throw new Broken();
    return 0;
}

main() -> int {
    tasks.scope((scope) -> {
        let dropped = scope.start(() -> try fail());
    });
    return 0;
}
