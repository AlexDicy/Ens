// @exit 134
// @stderr-contains panic: pop from an empty priority queue: check isEmpty() first
// Popping an empty priority queue aborts in the priority queue's own words, which name the type
// rather than calling it a queue, since a deque is one too.
import PriorityQueue from @std.collections.priorityqueue;

main() -> int {
    let empty = new PriorityQueue<int>((a, b) -> a - b);
    return empty.pop();
}
