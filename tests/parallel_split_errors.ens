import @std.parallel;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import Mutex from @std.tasks;
import ReadView from @std.parallel;
import Slice from @std.parallel;

final class Keeper {
    Slice<int>? kept = null;
}

pass(Slice<int> slice) -> Slice<int> {
    return slice;
}

gather(ReadView<int>[] views) { }

identity<T>(T value) -> T {
    return value;
}

main() -> int throws Cancelled {
    int[] values = new int[4];
    let stash = new Atomic<Mutex<Slice<int>>?>(null);
    try parallel.split(values, 2, (slice) -> {
        let again = identity(slice);
        () -> long later = () -> slice.length();
        slice.set(0, 1);
    });
    return 0;
}
