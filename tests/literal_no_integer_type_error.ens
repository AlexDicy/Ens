// @expect-error Literal 18446744073709551616 is too large for every integer type. The widest, 'ulong', has 18446744073709551615 as its largest value.
// @expect-error Literal 99999999999999999999 is too large for every integer type. The widest, 'ulong', has 18446744073709551615 as its largest value.
// @expect-error build failed with 2 problems
// Past every integer type there is no wider one to name, so the literal is simply wrong. It is
// reported once wherever it is written, and nothing that uses it is reported as well.
main() -> int {
    let beyondEveryType = 99999999999999999999;
    ulong large = 1;
    switch (large) {
        18446744073709551616 -> print("past"),
        default -> print("within"),
    }
    return beyondEveryType;
}
