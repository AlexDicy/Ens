// @expect-error Literal 99999999999999999999 does not fit in any integer type; the widest, 'ulong', holds up to 18446744073709551615.
// Past every integer type there is no wider one to name, so the literal is simply wrong.
main() -> int {
    let beyondEveryType = 99999999999999999999;
    return beyondEveryType;
}
