// @exit 0
// @stdout quiet
// @stdout 1 2 3
// @stdout caught one of the two: unreadable
// @stdout done
// @stdout nested 4 5
// @stdout written 6 6
// @stdout parse empty
// A type parameter in a throws list stands for the whole list a body throws: one type, several, or
// none, in which case the call throws nothing and needs no 'try'. A catch clause over the parameter
// catches every listed type and nothing else.
class ParseError extends Error {
    constructor(string message) {
        super(message);
    }
}

class ReadError extends Error {
    constructor(string message) {
        super(message);
    }
}

attempt<V, E: Error>((() -> V throws E) body) -> V throws E {
    return try body();
}

guarded<E: Error>((() -> void throws E) body) -> string throws E {
    try body();
    return "done";
} catch (E caught) {
    return "caught one of the two: {caught.message}";
}

nested<E: Error>((() -> int throws E) inner) -> int throws E {
    return try attempt(() -> try inner());
}

parse(string text) -> int throws ParseError {
    if (text.length == 0) {
        throw new ParseError("empty");
    }
    return text.length as int;
}

either(string text) -> int throws ParseError, ReadError {
    if (text == "x") {
        throw new ReadError("unreadable");
    }
    return try parse(text);
}

main() -> int {
    int one = attempt(() -> 1);
    int two = try attempt(() -> try parse("ab"));
    int three = try attempt(() -> try either("abc"));
    string none = guarded(() -> {
        print("quiet");
    });
    string caught = try guarded(() -> {
        let ignored = try either("x");
    });
    print("{one} {two} {three}");
    print(caught);
    print(none);
    int four = nested(() -> 4);
    int five = try nested(() -> try parse("abcde"));
    print("nested {four} {five}");
    (() -> int throws ParseError, ReadError) value = () -> try either("abcdef");
    int six = try attempt(value);
    int written = try attempt<int, ParseError>(() -> try parse("abcdef"));
    print("written {six} {written}");
    int failed = try attempt(() -> try parse(""));
    return failed;
} catch (ParseError problem) {
    print("parse {problem.message}");
    return 0;
} catch (ReadError problem) {
    return 2;
}
