// @exit 1
// A weak field reads null once the watched node loses its last strong reference, and the
// strong-local idiom is what carries a null check to a use: reading the field hands back a
// strong reference, so the local keeps the node alive past the owner's death, narrows like
// any local, and releases the node when it is dropped.
class Node {
    protected int v;
    protected constructor(this.v = 0);
}

class Holder {
    protected weak Node? n;
    protected constructor();
}

main() -> int {
    let h = new Holder();
    let n = new Node();
    n.v = 42;
    h.n = n;
    let pinned = h.n;
    if (pinned == null) {
        return 2;
    }
    n = new Node();
    if (pinned.v != 42) {
        return 3;
    }
    if (h.n == null) {
        return 4;
    }
    pinned = null;
    if (h.n == null) {
        return 1;
    }
    return 5;
}
