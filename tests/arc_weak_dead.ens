// @exit 1
class Node {
    protected int v;
    protected constructor(this.v = 0);
}

class Holder {
    protected weak Node? n;
    protected constructor();
}

main() -> int {
    let h = new Holder();
    let n = new Node();
    n.v = 42;
    h.n = n;
    n = new Node();
    if (h.n == null) {
        return 1;
    }
    return 2;
}
