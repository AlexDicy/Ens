// @exit 0
// @stdout made
// @stdout building the heading of one
// @stdout == one == == one ==
// @stdout 9 2
// @stdout building the heading of two
// @stdout == two ==
// @stdout box of 3
// @stdout end of three
// @stdout building the heading of three
// @stdout == three ==
// @stdout positive none
// @stdout 3 8
// @stdout == one ==
// A 'lazy const' without 'static' is a field of each object: its initializer runs on the first read
// of the field on one object, may use 'this', and builds a value that object keeps. It works on a
// generic class, is inherited, narrows like a 'const' field, may hold a lambda, and is read through
// '?.' too.
import List from @std.collections.list;

class Report {
    const string title;
    lazy const string heading = this.makeHeading();
    lazy const long length = this.heading.length;
    lazy const List<string> lines = this.makeLines();

    constructor(this.title);

    makeHeading() -> string {
        print("building the heading of {this.title}");
        return "== {this.title} ==";
    }

    makeLines() -> List<string> {
        let made = new List<string>();
        made.push(this.heading);
        made.push("body");
        return made;
    }
}

class Box<T> {
    const T held;
    lazy const string described = "box of {this.held}";

    constructor(this.held);
}

class Detailed extends Report {
    lazy const string footer = "end of {this.title}";

    constructor(string title) {
        super(title);
    }
}

class Node {
    const int value;
    lazy const string? label = this.value > 0 ? "positive" : null;
    lazy const () -> int adder = () -> this.value + 1;

    constructor(this.value);

    describe() -> string {
        () -> string read = () -> this.label ?? "none";
        return read();
    }
}

main() -> int {
    let first = new Report("one");
    let second = new Report("two");
    print("made");
    print(first.heading + " " + first.heading);
    print("{first.length} {first.lines.length()}");
    print(second.heading);
    print(new Box<int>(3).described);
    let detailed = new Detailed("three");
    print(detailed.footer);
    print(detailed.heading);
    let node = new Node(2);
    print(node.describe() + " " + new Node(0).describe());
    long total = 0;
    if (node.label != null) {
        total = node.label.length;
    }
    print("{node.adder()} {total}");
    Report? maybe = first;
    print(maybe?.heading ?? "none");
    return 0;
}
