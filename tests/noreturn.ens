// @exit 0
// @stdout good=5
// @stdout balance=42
// @stdout classify=non-negative
// @stdout viaInterface=9
// @stdout shade=1 light
// @stdout loops=4 0 -1
// @stdout count=6
// @stdout joins=1 4 1 -1 light 7 seven 4 6 2 3
// @stdout half=odd numbers have no half
// @stdout odd=0
// @stdout reading=no reading
// @stdout measured=5 8 0
// @stdout caught=no positive value
// Happy paths for the `noreturn` modifier: a path that ends in a `noreturn` call needs no return,
// narrows what a guard branch proved, and satisfies definite assignment, in an `if` branch, in a
// switch arm, in the initial value of a local and in a `for` loop's initializer alike, and the
// marker is part of an interface and abstract-method contract an override has to keep. A switch
// arm or a '?:' branch that never returns takes no part in the type of the whole, and a call that
// never returns takes the type the place it is read in states.
import @std.testing;
import TestFailure from @std.testing;

// A value-returning function whose fall-through path ends in a `noreturn` call.
firstPositive(int[] values) -> int throws {
    for (let value in values) {
        if (value > 0) {
            return value;
        }
    }
    try testing.fail("no positive value");
}

class Account {
    protected int balance;

    protected constructor(this.balance);
}

// `panic` in the guard branch ends the path, so `account` narrows to non-null afterwards.
balanceOf(Account? account) -> int {
    if (account == null) {
        panic("account is required");
    }
    return account.balance;
}

// The branch that calls a `noreturn` function counts as terminated, so `label` is definitely
// assigned on every path that reaches the return.
classify(int n) -> string throws {
    string label;
    if (n < 0) {
        try testing.fail("negative input");
    } else {
        label = "non-negative";
    }
    return label;
}

// A `noreturn` body may loop forever with no other exit.
noreturn spin() {
    while (true) {
    }
}

// `noreturn` is part of an interface and abstract-method contract; an override keeps it.
interface Crasher {
    noreturn crash(string message) throws TestFailure;
}

abstract class AbstractCrasher {
    protected abstract noreturn halt();
}

class RealCrasher extends AbstractCrasher implements Crasher {
    protected override noreturn crash(string message) throws {
        throw new TestFailure(message);
    }

    protected override noreturn halt() {
        panic("halt");
    }
}

// A method call to a `noreturn` method ends the caller's path too.
viaInterface(Crasher crasher, int? value) -> int throws {
    if (value != null) {
        return value;
    }
    try crasher.crash("value missing");
}

enum Shade {
    Light,
    Dark,
}

// A switch arm that calls a `noreturn` function ends its path, so only the other arms return.
levelOf(Shade shade) -> int {
    switch (shade) {
        Shade.Light -> {
            return 1;
        },
        Shade.Dark -> panic("dark has no level"),
    }
}

// Only the arms that do not end in a `noreturn` call have to assign `label`.
labelOf(Shade shade) -> string {
    string label;
    switch (shade) {
        Shade.Light -> label = "light",
        Shade.Dark -> panic("dark has no label"),
    }
    return label;
}

// A `for` initializer that never returns ends the path before the loop, so no `return` follows it.
// An update that never returns ends only the way back to the condition, so the loop still finishes
// when its condition fails before the first round.
startsStopped(int n) -> int {
    for (try testing.fail("the loop never starts"); n < 3; n++) {
    }
} catch (Error e) {
    return 4;
}

stopsAfterOneRound(int n) -> int {
    for (; n > 0; try testing.fail("the update never returns")) {
    }
    return n;
} catch (Error e) {
    return -1;
}

// A local whose initial value never returns is never created: the path ends at its declaration.
countOrStop(int n) -> int {
    if (n >= 0) {
        return n;
    }
    let stopped = panic("a count is never negative");
}

// A call that never returns stands wherever a value of a type the program states is read: an
// initial value, an assigned value, an argument, a return value, a lambda's result, a struct
// field's value and an element of an array whose type is given.
struct Reading {
    protected int value;
}

doubled(int value) -> int {
    return value * 2;
}

measured(bool known) -> int {
    () -> int unknown = () -> panic("no reading");
    Reading reading = {value: 3};
    if (!known) {
        reading = {value: unknown()};
        int[] values = [1, panic("no values")];
        print("{values.length}");
    }
    return reading.value + doubled(known ? 1 : panic("unknown"));
}

readingOf(bool known) -> int throws {
    if (known) {
        return doubled(4);
    }
    int typed = try testing.fail("no reading");
    return typed;
}

readingOrZero(bool known) -> int {
    return try readingOf(known);
} catch (Error e) {
    print("reading={e.message}");
    return 0;
}

// A switch arm or a '?:' branch that never returns gives no value, so the other arms decide the
// type of the whole, here inside a 'return'.
brightnessOf(Shade shade) -> long {
    return switch (shade) {
        Shade.Light -> 1,
        default -> panic("dark has no brightness"),
    };
}

// A 'try' in front of a call that never returns makes a branch that never returns too.
halfOf(int n) -> int throws {
    return n % 2 == 0 ? n / 2 : try testing.fail("odd numbers have no half");
}

halfOrZero(int n) -> int {
    return try halfOf(n);
} catch (Error e) {
    print("half={e.message}");
    return 0;
}

// A '?:' whose branches never return is itself a branch that never returns.
signOf(int n) -> int {
    return n > 0 ? 1 : (n < 0 ? -1 : panic("zero has no sign"));
}

// A switch in a lambda body, whose arms hold strings, and a generic function whose branch beside
// the value never returns.
nameOf(Shade shade) -> string {
    (Shade) -> string named = (each) -> switch (each) {
        Shade.Light -> "light",
        Shade.Dark -> panic("dark has no name"),
    };
    return named(shade);
}

onlyOf<T>(T[] values) -> T {
    return values.length == 1 ? values[0] : panic("expected one value");
}

class Gate {
    protected bool open;

    protected constructor(this.open);

    noreturn refuse() {
        panic("the gate is closed");
    }
}

// A method that never returns ends its branch as a function does.
passThrough(Gate gate, int value) -> int {
    return gate.open ? value : gate.refuse();
}

// Only the branch that gives a value has to assign 'seen' before it is read.
assignedBeside(bool flag) -> int {
    int seen;
    int value = flag ? (seen = 3) : panic("never");
    return seen + value;
}

// A '?:' or a switch whose every value never returns ends the path as a statement, and where a
// value is needed it takes the type the place expects.
checked(int n) -> int {
    if (n >= 0) {
        return n;
    }
    if (n < -100) {
        n < -1000 ? panic("far below zero") : panic("below zero");
    }
    return n < -10 ? panic("well below zero") : panic("just below zero");
}

stoppedBy(Shade shade, int n) -> int throws {
    if (n >= 0) {
        return n;
    }
    if (n < -100) {
        let farBelow = switch (shade) {
            Shade.Light -> panic("a light count is far below zero"),
            Shade.Dark -> try testing.fail("a dark count is far below zero"),
        };
    }
    int stopped = switch (shade) {
        Shade.Light -> panic("a light count is never negative"),
        Shade.Dark -> try testing.fail("a dark count is never negative"),
    };
}

main() -> int {
    print("good={try firstPositive([-1, 0, 5])}");
    print("balance={balanceOf(new Account(42))}");
    print("classify={try classify(7)}");
    print("viaInterface={try viaInterface(new RealCrasher(), 9)}");
    print("shade={levelOf(Shade.Light)} {labelOf(Shade.Light)}");
    print("loops={startsStopped(0)} {stopsAfterOneRound(0)} {stopsAfterOneRound(2)}");
    print("count={countOrStop(6)}");
    print("joins={brightnessOf(Shade.Light)} {try halfOf(8)} {signOf(5)} {signOf(-2)} "
        + "{nameOf(Shade.Light)} {onlyOf([7])} {onlyOf(["seven"])} "
        + "{passThrough(new Gate(true), 4)} {assignedBeside(true)} {checked(2)} "
        + "{try stoppedBy(Shade.Dark, 3)}");
    print("odd={halfOrZero(3)}");
    print("measured={measured(true)} {readingOrZero(true)} {readingOrZero(false)}");
    int last = try firstPositive([-3, -1]);
    print("unreached={last}");
    return 0;
} catch (Error e) {
    print("caught={e.message}");
    return 0;
}
