// @exit 0
// @stdout good=5
// @stdout balance=42
// @stdout classify=non-negative
// @stdout viaInterface=9
// @stdout caught=no positive value
// Happy paths for the `noreturn` modifier: a path that ends in a `noreturn` call needs no return,
// narrows what a guard branch proved, and satisfies definite assignment, and the marker is part of
// an interface and abstract-method contract an override has to keep.
import @std.testing;
import TestFailure from @std.testing;

// A value-returning function whose fall-through path ends in a `noreturn` call.
firstPositive(int[] values) -> int throws {
    for (let value in values) {
        if (value > 0) {
            return value;
        }
    }
    try testing.fail("no positive value");
}

class Account {
    protected int balance;

    protected constructor(this.balance);
}

// `panic` in the guard branch ends the path, so `account` narrows to non-null afterwards.
balanceOf(Account? account) -> int {
    if (account == null) {
        panic("account is required");
    }
    return account.balance;
}

// The branch that calls a `noreturn` function counts as terminated, so `label` is definitely
// assigned on every path that reaches the return.
classify(int n) -> string throws {
    string label;
    if (n < 0) {
        try testing.fail("negative input");
    } else {
        label = "non-negative";
    }
    return label;
}

// A `noreturn` body may loop forever with no other exit.
noreturn spin() {
    while (true) {
    }
}

// `noreturn` is part of an interface and abstract-method contract; an override keeps it.
interface Crasher {
    noreturn crash(string message) throws TestFailure;
}

abstract class AbstractCrasher {
    protected abstract noreturn halt();
}

class RealCrasher extends AbstractCrasher implements Crasher {
    protected override noreturn crash(string message) throws {
        throw new TestFailure(message);
    }

    protected override noreturn halt() {
        panic("halt");
    }
}

// A method call to a `noreturn` method ends the caller's path too.
viaInterface(Crasher crasher, int? value) -> int throws {
    if (value != null) {
        return value;
    }
    try crasher.crash("value missing");
}

main() -> int {
    print("good={try firstPositive([-1, 0, 5])}");
    print("balance={balanceOf(new Account(42))}");
    print("classify={try classify(7)}");
    print("viaInterface={try viaInterface(new RealCrasher(), 9)}");
    int last = try firstPositive([-3, -1]);
    print("unreached={last}");
    return 0;
} catch (Error e) {
    print("caught={e.message}");
    return 0;
}
