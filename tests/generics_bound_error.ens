// @expect-error Type argument 'int' for type parameter 'T' of 'Holder' must be 'Shape' or a subclass of it. Replace 'int' with 'Shape' or a class that extends it.
class Shape { int sides; constructor(this.sides = 0); }
class Holder<T: Shape> { private T item; constructor(T s) { this.item = s; } }

main() -> int {
    let h = new Holder<int>(5);
    return 0;
}