// @exit 0
// @stdout negation 164
// A logical-not flips what a check proves, so a negative guard clause narrows: `!(x is C)` proves
// `x is C` on the surviving side. Each helper reads a member the narrowing must prove well-typed,
// so a missing narrowing would fail to compile rather than misbehave.
class Shape {
    int id;

    protected constructor(this.id = 0);
}

class Circle extends Shape {
    protected int radius;

    protected constructor(int id, this.radius = 0) {
        super(id);
    }
}

class Node {
    protected int value;
    protected Node? next;

    protected constructor(this.value, this.next = null);
}

// 1. A negative-is guard that returns narrows the operand past the guard.
radiusOrZero(Shape s) -> int {
    if (!(s is Circle)) {
        return 0;
    }
    return s.radius;
}

// 2. A negative-is guard that continues narrows the rest of the iteration.
sumRadiiContinue(Shape[] shapes) -> int {
    int total = 0;
    for (let shape in shapes) {
        if (!(shape is Circle)) {
            continue;
        }
        total = total + shape.radius;
    }
    return total;
}

// 3. A negative-is guard that breaks narrows the lines after it.
sumRadiiUntilNonCircle(Shape[] shapes) -> int {
    int total = 0;
    for (let shape in shapes) {
        if (!(shape is Circle)) {
            break;
        }
        total = total + shape.radius;
    }
    return total;
}

// 4a. `!(x != null)` holds when x is null, so returning from it leaves x non-null.
valueOrZero(Node? x) -> int {
    if (!(x != null)) {
        return 0;
    }
    return x.value;
}

// 4b. `!(x == null)` narrows the then branch, exactly like `x != null` would.
valueInThen(Node? x) -> int {
    if (!(x == null)) {
        return x.value;
    }
    return 0;
}

// 5. The else branch of a negated condition narrows.
radiusInElse(Shape s) -> int {
    int r = 0;
    if (!(s is Circle)) {
        r = 0;
    } else {
        r = s.radius;
    }
    return r;
}

// 6. Double negation composes back to the positive test and narrows the then branch.
radiusDoubleNegation(Shape s) -> int {
    if (!(!(s is Circle))) {
        return s.radius;
    }
    return 0;
}

// 7. A negated condition narrows the while body.
sumList(Node? head) -> int {
    int total = 0;
    Node? node = head;
    while (!(node == null)) {
        total = total + node.value;
        node = node.next;
    }
    return total;
}

// 8. `!(...)` on the left of `&&` narrows the right side.
valueViaAnd(Node? x) -> int {
    if (!(x == null) && x.value > 0) {
        return x.value;
    }
    return 0;
}

// 9. A member-chain scrutinee narrows through a negated null check.
class Holder {
    Node? node;

    protected constructor(this.node);

    protected get() -> int {
        if (!(this.node == null)) {
            return this.node.value;
        }
        return 0;
    }
}

// 10. A subscript scrutinee narrows through a negated null check.
firstValue(Node?[] xs) -> int {
    if (!(xs[0] == null)) {
        return xs[0].value;
    }
    return 0;
}

// 11. A mixed form: `!(a is C) || b == null` is false only when a is C and b is
// non-null, so the else branch narrows both.
mixed(Shape a, Node? b) -> int {
    if (!(a is Circle) || b == null) {
        return 0;
    } else {
        return a.radius + b.value;
    }
}

// 12. `!` over a plain bool narrows nothing and behaves as an ordinary guard.
plainBoolGuard(bool ready, int n) -> int {
    if (!ready) {
        return 0;
    }
    return n;
}

main() -> int {
    let c1 = new Circle(1, 10);
    let c2 = new Circle(2, 20);
    let plain = new Shape(3);

    int total = radiusOrZero(c1)                                   // 10
        + radiusOrZero(plain)                                      // 0
        + sumRadiiContinue([c1, plain, c2])                        // 30
        + sumRadiiUntilNonCircle([c1, c2, plain])                  // 30
        + valueOrZero(new Node(7))                                 // 7
        + valueOrZero(null)                                        // 0
        + valueInThen(new Node(8))                                 // 8
        + radiusInElse(c1)                                         // 10
        + radiusDoubleNegation(c2)                                 // 20
        + sumList(new Node(1, new Node(2, new Node(3))))           // 6
        + valueViaAnd(new Node(9))                                 // 9
        + new Holder(new Node(4)).get()                            // 4
        + firstValue([new Node(11)])                               // 11
        + mixed(c1, new Node(6))                                   // 16
        + plainBoolGuard(true, 3)                                  // 3
        + plainBoolGuard(false, 5);                                // 0

    print("negation " + total);
    return total - 164;
}
