// @exit 53
// `from` is an ordinary identifier for variables, parameters, fields, methods,
// functions, and loop variables. It carries keyword meaning only in the
// import-binding and `external from` positions; the latter still parses here.

external from "c" {
    abs(int from) -> int;
}

class Box {
    int from;

    constructor(int from) {
        this.from = from;
    }

    peek() -> int {
        return this.from;
    }
}

class Reader {
    int position;

    constructor() {
        this.position = 3;
    }

    from() -> int {
        return this.position;
    }
}

from(int from) -> int {
    return from + 1;
}

sumRange(int limit) -> int {
    int total = 0;
    for (int from = 0; from < limit; from++) {
        total = total + from;
    }
    int[] values = [10, 20];
    for (let from in values) {
        total = total + from;
    }
    return total;
}

main() -> int {
    let box = new Box(5);
    int field = box.peek();
    let reader = new Reader();
    int method = reader.from();
    int called = from(6);
    int looped = sumRange(4);
    int from = field + method;
    return from + called + looped + abs(-2);
}
