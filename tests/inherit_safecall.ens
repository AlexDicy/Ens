// @exit 2
// A virtual (overridden) method called through `?.` must still dispatch on the runtime type,
// not the static `Base?` type.
class Token {
    int kind;
    Token(this.kind = 0);
}

class Lexer {
    next() -> Token { return new Token(1); }
}

class JsonLexer extends Lexer {
    override next() -> Token { return new Token(2); }
}

main() -> int {
    Lexer? lx = new JsonLexer();   // upcast to Base?
    let t = lx?.next();            // dynamic dispatch -> JsonLexer.next -> kind 2
    if (t != null) {
        return t.kind;
    }
    return 0;
}