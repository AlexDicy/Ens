// A closing bracket that closes nothing between a statement's header and its '{' is reported once,
// and the block after it is still the statement's body, so each function goes on past it and the
// function after it is still checked.

enum Color {
    Red,
    Green,
}

strayAfterIf(int x) -> int {
    if (x == -4)) {
        x = 1;
    }
    int after = 2;
    return after;
}

strayAfterElse(int x) -> int {
    if (x == 1) {
        x = 2;
    } else) {
        x = 3;
    }
    int after = 2;
    return after;
}

strayAfterWhile(int x) -> int {
    while (x < 4)) {
        x = x + 1;
    }
    int after = 2;
    return after;
}

strayAfterFor(int x) -> int {
    for (int i = 0; i < 4; i++)) {
        x = x + i;
    }
    int after = 2;
    return after;
}

strayAfterForEach(int[] items) -> int {
    int total = 0;
    for (let item in items)) {
        total = total + item;
    }
    int after = 2;
    return after;
}

strayBeforeNextLine(int x) -> int {
    if (x == -4))
    {
        x = 1;
    }
    int after = 2;
    return after;
}

strayBracket(int x) -> int {
    while (x < 4)] {
        x = x + 1;
    }
    int after = 2;
    return after;
}

strayRun(int x) -> int {
    if (x == -4) ) ] {
        x = 1;
    }
    int after = 2;
    return after;
}

straySwitchStatement(Color color) -> int {
    switch (color)) {
        Red -> {
            return 1;
        },
        Green -> {
            return 2;
        },
    }
    int after = 2;
    return after;
}

straySwitchExpression(Color color) -> int {
    return switch (color)) {
        Red -> 1,
        Green -> 2,
    };
}

