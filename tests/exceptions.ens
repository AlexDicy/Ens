// @exit 0
// Throw + catch, catch-by-base-class via the parent chain, value returned through
// `try` on success, multi-hop propagation, rethrow caught upstream, and a catch
// clause on a constructor.
class AppError extends Error {
    int code;
    AppError(string m, this.code) { super(m); }
}
class NetError extends AppError {
    NetError(string m) { super(m, 2); }
}

class Svc {
    ok(int n) -> int throws {
        if (n < 0) { throw new AppError("neg", 9); }
        return n;
    }

    safe(int n) -> int {
        return try this.ok(n);
    } catch (AppError e) {
        return -1;
    }

    deep() -> int throws { throw new NetError("net"); }

    middle() -> int throws { return try this.deep(); }

    handleDeep() -> int {
        return try this.middle();
    } catch (AppError e) {           // catches NetError via the parent chain
        return e.code;               // reads inherited field: 2
    }

    fail() -> int throws { throw new AppError("boom", 1); }

    wrap() -> int throws {
        return try this.fail();
    } catch (AppError e) {
        rethrow;                      // re-propagates the caught AppError
    }

    rethrowCaller() -> int {
        return try this.wrap();
    } catch (AppError e) {
        return 7;
    }
}

class Resource {
    int state;

    open(bool bad) -> int throws { if (bad) { throw new AppError("io", 3); } return 1; }

    Resource(bool bad) {
        this.state = try this.open(bad);
    } catch (AppError e) {
        this.state = 50;              // constructor swallows the failure
    }

    current() -> int { return this.state; }
}

main() -> int {
    let s = new Svc();
    int total = 0;
    total = total + s.safe(5);          // success through try: 5
    total = total + s.safe(-1);         // caught: -1   -> 4
    total = total + s.handleDeep();     // base catch reads subclass field: 2 -> 6
    total = total + s.rethrowCaller();  // rethrow caught upstream: 7 -> 13

    let r = new Resource(true);
    total = total + r.current();        // ctor caught the throw: 50 -> 63

    if (total == 63) { return 0; }
    return total;
}