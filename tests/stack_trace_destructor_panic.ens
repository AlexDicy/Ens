// @exit 134
// @stderr panic: tried to read index 5 of an array of length 1. Check the index against 'length' first
// @stderr   at Holder.destructor (stack_trace_destructor_panic.ens:18)
// @stderr   at consume (stack_trace_destructor_panic.ens:23)
// @stderr   at main (stack_trace_destructor_panic.ens:27)
// A destructor runs from inside the runtime's release of its object, and the routines between it and
// the function that dropped the object are not frames of the program, so the trace names only the
// destructor, the function and main, each once.
class Holder {
    int[] items;

    constructor() {
        this.items = new int[1];
    }

    destructor() {
        int i = 5;
        print("{this.items[i]}");
    }
}

consume() {
    let h = new Holder();
}

main() -> int {
    consume();
    return 0;
}
