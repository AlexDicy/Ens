// @expect-error '-=' needs numbers on both sides, got 'string' and 'string'
// The operator's own rules apply to a compound assignment, so a form '+' does not
// support is rejected by name: only '+' concatenates strings, and '-' never does.
main() -> int {
    string text = "abc";
    text -= "c";
    print("text {text}");
    return 0;
}
