// @expect-error A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be written, such as on a Map or Set key. Remove 'throws', or rename both 'hash' and 'equals' and remove 'override' from each.
// @expect-error A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be written, such as on a Map or Set key. Remove 'throws', or rename the method and remove 'override'.
// @expect-error A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be written, such as on a Map or Set key. Remove 'throws', or rename both 'hash' and 'equals' and remove 'override' from 'hash'.
// @expect-error Method 'equals' of 'Stamp' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be written, such as on a Map or Set key. Remove 'throws' and write 'override' before 'hash', or rename both 'hash' and 'equals' and remove 'override' from 'equals'.
// @expect-error A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be written, such as on a Map or Set key. Remove 'throws' and write 'override' before 'hash', or rename both 'hash' and 'equals'.
// @expect-error Method 'equals' of 'Plate' replaces the built-in identity equality but is not marked 'override'. Write 'override' before 'equals'.
// @expect-error build failed with 7 problems
// The language takes a value's hash wherever the value is keyed - a Map, a Set, a struct
// that holds it - and none of those places can write a 'try', so a hash that fails has
// nowhere to report the failure. The rule holds for a class and for a struct alike.

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Badge {
    int number;
    constructor(this.number);

    override hash() -> long throws {
        if (this.number < 0) {
            throw new Failure("negative");
        }
        return this.number;
    }

    override equals(Badge other) -> bool {
        return this.number == other.number;
    }
}

struct Key {
    int id;

    override hash() -> long throws {
        if (this.id < 0) {
            throw new Failure("negative");
        }
        return this.id;
    }
}

// Renaming one half of a 'hash' and 'equals' pair leaves the other without its partner, so
// the fix renames both, and removes 'override' from each one that has it.
class Stamp {
    int number;

    constructor(this.number);

    override hash() -> long throws {
        if (this.number < 0) {
            throw new Failure("negative");
        }
        return this.number;
    }

    equals(Stamp other) -> bool {
        return this.number == other.number;
    }
}

class Seal {
    int number;

    constructor(this.number);

    hash() -> long throws {
        if (this.number < 0) {
            throw new Failure("negative");
        }
        return this.number;
    }

    override equals(Seal other) -> bool {
        return this.number == other.number;
    }
}

class Plate {
    int number;

    constructor(this.number);

    hash() -> long throws {
        if (this.number < 0) {
            throw new Failure("negative");
        }
        return this.number;
    }

    equals(Plate other) -> bool {
        return this.number == other.number;
    }
}

main() -> int {
    return 0;
}
