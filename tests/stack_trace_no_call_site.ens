// @exit 134
// @stdout early 1
// @stderr panic: tried to read index 5 of an array of length 1. Check the index against 'length' first
// @stderr   at Holder.destructor (stack_trace_no_call_site.ens:16)
// @stderr-at O0   at consume (stack_trace_no_call_site.ens:25)
// @stderr-at O2   at consume (stack_trace_no_call_site.ens:25, inlined)
// @stderr   at main (stack_trace_no_call_site.ens:31)
// A frame whose function makes no marked call before the address it stops at, here the release at
// the end of 'consume', shows the function's own declaration line, never a line of the function
// laid out before it.
class Holder {
    int[] items = [0];

    destructor() {
        int i = 5;
        print("{this.items[i]}");
    }
}

early(int n) -> int {
    print("early {n}");
    return n;
}

consume() {
    let h = new Holder();
}

main() -> int {
    let ignored = early(1);
    consume();
    return 0;
}
