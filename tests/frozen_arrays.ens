// @exit 0
// @stdout 3 2 9
// @stdout true
// @stdout built 0 1 2
// An array's 'frozen()' gives a 'FrozenList' with nothing imported to name it. An array still in use
// is copied, so the frozen list keeps the values the array had, and one built in a local and frozen
// at its last use gives its storage.

// Nothing reads 'squares' after the freeze, so the frozen list takes its storage.
built() -> string {
    long[] squares = new long[3];
    for (long index = 0; index < squares.length; index++) {
        squares[index] = index * index;
    }
    let frozen = squares.frozen();
    return "built {frozen.get(0)} {frozen.get(1)} {frozen.length() - 1}";
}

main() -> int {
    int[] values = [3, 4];
    let frozen = values.frozen();
    values[0] = 9;
    print("{frozen.get(0)} {frozen.length()} {values[0]}");
    print("{[1, 2].frozen() == [1, 2].frozen()}");
    print(built());
    return 0;
}
