// @expect-error build failed with 4 problems
class Item {
    protected int size;

    protected constructor(this.size = 1);

    protected grow() -> int {
        return this.size;
    }
}

main() {
    string? text = null;
    if (text == null) {
        print("{text.length}");
    }
    Item? item = null;
    if (item != null) {
        print("present");
    } else {
        print("{item.grow()}");
    }
    int[]? rows = null;
    if (rows == null) {
        let n = 0;
        while (n < 2) {
            let first = rows[0];
            rows = [first];
            n = n + 1;
        }
    }
    int[]? other = null;
    if (other == null) {
        let k = 0;
        while (k < 2) {
            let first = other[0];
            k = k + first;
        }
    }
}
