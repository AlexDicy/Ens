// @expect-error Struct 'Holder' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'ref' has the class type 'Node', and a class value has no JSON form. Give 'Holder' an 'override toString() -> string', or remove field 'ref'.
// @expect-error Struct 'Outer' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'cell.ref' has the class type 'Node', and a class value has no JSON form. A struct inside another struct is written as JSON too, even though 'Cell' declares its own 'toString'. Give 'Outer' an 'override toString() -> string', or remove field 'ref' from 'Cell'.
// @expect-error Struct 'Deep' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'outers.cell.ref' has the class type 'Node', and a class value has no JSON form. A struct inside another struct is written as JSON too, even though 'Cell' declares its own 'toString'. Give 'Deep' an 'override toString() -> string', or remove field 'ref' from 'Cell'.
// @expect-error Cannot interpolate a value of type 'Outer[]': each struct element of an array is written as JSON, which lists each field's name and value. Field 'cell.ref' of 'Outer' has the class type 'Node', and a class value has no JSON form. A struct inside another struct is written as JSON too, even though 'Cell' declares its own 'toString'. Remove field 'ref' from 'Cell'.
// @expect-error Struct 'Box' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'wrap.item' has the class type 'Node', and a class value has no JSON form. Give 'Box' an 'override toString() -> string', or use 'Box' with a type argument that has a JSON form instead of 'Node'.
// @expect-error Struct 'Tagged' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'ref' has the class type 'Node', and a class value has no JSON form. Give 'Tagged' an 'override toString() -> string', or remove field 'ref'.
// @expect-error Struct 'UsesWrap' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'w.item' has the class type 'Node', and a class value has no JSON form. Give 'UsesWrap' an 'override toString() -> string', or change the type argument 'Node' in field 'w' to one that has a JSON form.
// @expect-error Struct 'Holds' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'uses.w.item' has the class type 'Node', and a class value has no JSON form. Give 'Holds' an 'override toString() -> string', or change the type argument 'Node' in field 'w' of 'UsesWrap' to one that has a JSON form.
// @expect-error Struct 'Nest' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'inner.item' has the class type 'Node', and a class value has no JSON form. Give 'Nest' an 'override toString() -> string', or use 'Nest' with a type argument that has a JSON form instead of 'Wrap<Node>'.
// @expect-error Struct 'PairWrap' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'w.item.first' has the class type 'Node', and a class value has no JSON form. Give 'PairWrap' an 'override toString() -> string', or change the type argument 'Node' in field 'w' to one that has a JSON form.
// @expect-error build failed with 10 problems
// A struct with a class field has no JSON form, so interpolating it is rejected;
// class references are not serializable. The fix names the field in the struct that declares it,
// however deep that struct is nested, and a field whose type a type argument chose is fixed where
// that argument is written.

class Node {
    int value;
    constructor(this.value);
}

struct Holder {
    int id;
    Node ref;
}

struct Cell {
    Node ref;

    override toString() -> string {
        return "cell";
    }
}

struct Outer {
    Cell cell;
}

struct Deep {
    Outer[] outers;
}

struct Wrap<T> {
    T item;
}

struct Box<T> {
    Wrap<T> wrap;
}

struct UsesWrap {
    Wrap<Node> w;
}

struct Holds {
    UsesWrap uses;
}

struct Nest<T> {
    T inner;
}

struct Duo<A, B> {
    A first;
    B second;
}

struct PairWrap {
    Wrap<Duo<Node, int>> w;
}

struct Tagged<T> {
    Node ref;
    T tag;
}

describe(Holder h) -> string {
    return "holder {h}";
}

describeNested(Outer outer, Deep deep, Outer[] outers) -> string {
    return "{outer} {deep} {outers}";
}

describeCarried(Nest<Wrap<Node>> nest, PairWrap pair) -> string {
    return "{nest} {pair}";
}

describeGeneric(Box<Node> box, Tagged<int> tagged, UsesWrap uses, Holds holds) -> string {
    return "{box} {tagged} {uses} {holds}";
}

main() -> int {
    return 0;
}
