// @expect-error Struct 'Holder' cannot be converted to a string. Field 'ref'
// A struct with a class field has no JSON form, so interpolating it is rejected;
// class references are not serializable.

class Node {
    int value;
    constructor(this.value);
}

struct Holder {
    int id;
    Node ref;
}

describe(Holder h) -> string {
    return "holder {h}";
}

main() -> int {
    return 0;
}
