// @expect-error Struct 'Holder' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'ref' has type 'Node', and a class value has no JSON form. Give 'Holder' an 'override toString() -> string' of its own, or remove field 'ref'.
// @expect-error Struct 'Outer' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'cell.ref' has type 'Node', and a class value has no JSON form. The 'toString' of 'Cell' is not used inside another struct. Give 'Outer' an 'override toString() -> string' of its own, or remove field 'ref' from 'Cell'.
// @expect-error Struct 'Deep' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'outers.cell.ref' has type 'Node', and a class value has no JSON form. The 'toString' of 'Cell' is not used inside another struct. Give 'Deep' an 'override toString() -> string' of its own, or remove field 'ref' from 'Cell'.
// @expect-error Cannot interpolate a value of type 'Outer[]': each struct element of an array is written as JSON, which lists each field's name and value. Field 'cell.ref' of 'Outer' has type 'Node', and a class value has no JSON form. The 'toString' of 'Cell' is not used inside another struct. Remove field 'ref' from 'Cell'.
// @expect-error Struct 'Box' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'wrap.item' has type 'Node', and a class value has no JSON form. Give 'Box' an 'override toString() -> string' of its own, or pass a type argument that has a JSON form.
// @expect-error Struct 'Tagged' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'ref' has type 'Node', and a class value has no JSON form. Give 'Tagged' an 'override toString() -> string' of its own, or remove field 'ref'.
// @expect-error Struct 'UsesWrap' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'w.item' has type 'Node', and a class value has no JSON form. Give 'UsesWrap' an 'override toString() -> string' of its own, or give the type of field 'w' a type argument that has a JSON form.
// @expect-error Struct 'Holds' cannot be converted to a string. Without an 'override toString() -> string', a struct is written as JSON, which lists each field's name and value. Field 'uses.w.item' has type 'Node', and a class value has no JSON form. Give 'Holds' an 'override toString() -> string' of its own, or give the type of field 'w' of 'UsesWrap' a type argument that has a JSON form.
// @expect-error build failed with 8 problems
// A struct with a class field has no JSON form, so interpolating it is rejected;
// class references are not serializable. The fix names the field in the struct that declares it,
// however deep that struct is nested, and a field whose type a type argument chose is fixed where
// that argument is written.

class Node {
    int value;
    constructor(this.value);
}

struct Holder {
    int id;
    Node ref;
}

struct Cell {
    Node ref;

    override toString() -> string {
        return "cell";
    }
}

struct Outer {
    Cell cell;
}

struct Deep {
    Outer[] outers;
}

struct Wrap<T> {
    T item;
}

struct Box<T> {
    Wrap<T> wrap;
}

struct UsesWrap {
    Wrap<Node> w;
}

struct Holds {
    UsesWrap uses;
}

struct Tagged<T> {
    Node ref;
    T tag;
}

describe(Holder h) -> string {
    return "holder {h}";
}

describeNested(Outer outer, Deep deep, Outer[] outers) -> string {
    return "{outer} {deep} {outers}";
}

describeGeneric(Box<Node> box, Tagged<int> tagged, UsesWrap uses, Holds holds) -> string {
    return "{box} {tagged} {uses} {holds}";
}

main() -> int {
    return 0;
}
