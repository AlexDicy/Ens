// @exit 0
// @stdout and 4
// @stdout or fallback
// @stdout chain 6
// @stdout conjunction 10
// @stdout ternary 4 0
// @stdout while 6
// @stdout for 6
// @stdout value-opt 7
// @stdout invalidated ok

class Node {
    int size;
    Node? next;
    Node(this.size, this.next = null);
}

measure(Node? node) -> int {
    if (node != null && node.size > 0) {
        return node.size;
    }
    return 0;
}

label(Node? node) -> string {
    if (node == null || node.size == 0) {
        return "fallback";
    }
    return "sized " + node.size;
}

main() -> int {
    print("and " + measure(new Node(4)));
    print("or " + label(null));

    // Chained conjunctions narrow member paths link by link.
    Node? chain = new Node(1, new Node(5));
    if (chain != null && chain.next != null && chain.next.size == 5) {
        print("chain " + (chain.size + chain.next.size));
    }

    // A conjunction in an if condition narrows the whole then-block.
    Node? a = new Node(3);
    Node? b = new Node(7);
    if (a != null && b != null) {
        print("conjunction " + (a.size + b.size));
    }

    // Ternary branches narrow from the condition.
    Node? c = new Node(4);
    Node? d = null;
    print("ternary " + (c != null ? c.size : -1) + " " + (d != null ? d.size : 0));

    // Loop conditions narrow their bodies; the reassignment re-checks.
    Node? cursor = new Node(1, new Node(2, new Node(3)));
    int total = 0;
    while (cursor != null) {
        total = total + cursor.size;
        cursor = cursor.next;
    }
    print("while " + total);

    Node? walker = new Node(1, new Node(2, new Node(3)));
    total = 0;
    for (; walker != null; walker = walker.next) {
        total = total + walker.size;
    }
    print("for " + total);

    // Value-type optionals narrow through && too.
    int? amount = 7;
    if (amount != null && amount > 0) {
        int plain = amount;
        print("value-opt " + plain);
    }

    // A write to the narrowed value inside the right operand is rejected
    // conservatively; a fresh check afterwards still works.
    Node? e = new Node(9);
    if (e != null && e.size == 9) {
        e = null;
    }
    if (e == null) { print("invalidated ok"); }

    return 0;
}