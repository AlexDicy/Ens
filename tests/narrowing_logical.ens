// @exit 0
// @stdout and 4
// @stdout or fallback
// @stdout chain 6
// @stdout conjunction 10
// @stdout ternary 4 0
// @stdout while 6
// @stdout for 6
// @stdout value-opt 7
// @stdout invalidated ok
// @stdout kept 3
// @stdout counted 2
// @stdout circle 3
// @stdout written 3

class Node {
    protected int size;
    protected const Node? next;
    protected constructor(this.size, this.next = null);
}

keep(string? value) -> bool {
    return true;
}

named(bool present) -> string? {
    return present ? "ab" : null;
}

counted(bool present) -> int? {
    return present ? 1 : null;
}

class Shape {
    protected constructor();
}

class Circle extends Shape {
    protected int radius;

    protected constructor(this.radius) {
        super();
    }
}

keepShape(Shape value) -> bool {
    return true;
}

nextCircle() -> Circle {
    return new Circle(3);
}

measure(Node? node) -> int {
    if (node != null && node.size > 0) {
        return node.size;
    }
    return 0;
}

label(Node? node) -> string {
    if (node == null || node.size == 0) {
        return "fallback";
    }
    return "sized " + node.size;
}

main() -> int {
    print("and " + measure(new Node(4)));
    print("or " + label(null));

    // Chained conjunctions narrow 'const' fields link by link.
    Node? chain = new Node(1, new Node(5));
    if (chain != null && chain.next != null && chain.next.size == 5) {
        print("chain " + (chain.size + chain.next.size));
    }

    // A conjunction in an if condition narrows the whole then-block.
    Node? a = new Node(3);
    Node? b = new Node(7);
    if (a != null && b != null) {
        print("conjunction " + (a.size + b.size));
    }

    // Ternary branches narrow from the condition.
    Node? c = new Node(4);
    Node? d = null;
    print("ternary " + (c != null ? c.size : -1) + " " + (d != null ? d.size : 0));

    // Loop conditions narrow their bodies; the reassignment re-checks.
    Node? cursor = new Node(1, new Node(2, new Node(3)));
    int total = 0;
    while (cursor != null) {
        total = total + cursor.size;
        cursor = cursor.next;
    }
    print("while " + total);

    Node? walker = new Node(1, new Node(2, new Node(3)));
    total = 0;
    for (; walker != null; walker = walker.next) {
        total = total + walker.size;
    }
    print("for " + total);

    // Value-type optionals narrow through && too.
    int? amount = 7;
    if (amount != null && amount > 0) {
        int plain = amount;
        print("value-opt " + plain);
    }

    // A write in the block drops the narrowing, and a fresh check afterwards narrows again.
    Node? e = new Node(9);
    if (e != null && e.size == 9) {
        e = null;
    }
    if (e == null) { print("invalidated ok"); }

    // A write on the right of '&&' that stores a value the check on the left proves keeps the check.
    string? text = named(true);
    if (text != null && keep(text = "abc")) {
        print("kept " + text.length);
    }
    int? count = counted(true);
    if (count != null && count++ > 0) {
        print("counted " + count);
    }

    // The same holds for a class the test on the left proves, and where nothing on the left is tested, a
    // write on the right narrows where the whole condition holds.
    Shape shape = new Circle(5);
    if (shape is Circle && keepShape(shape = nextCircle())) {
        print("circle " + shape.radius);
    }
    bool ready = count != null;
    string? late = null;
    if (ready && keep(late = "xyz")) {
        print("written " + late.length);
    }

    return 0;
}