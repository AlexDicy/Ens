// @exit 0
// @stdout warn: disk full
// @stdout stop: bad input!
// @stdout 44 6
// @stdout sealed: 9
// A generic bound may name a class: the parameter accepts that class or any subclass, the
// body reads the bound's members, and calls dispatch on the value's runtime type. Abstract
// and sealed classes are legal bounds.
public abstract class Fault {
    protected string reason;

    protected constructor(this.reason);

    public describe() -> string {
        return this.reason;
    }
}

public class Warning extends Fault {
    public constructor(string reason) {
        super(reason);
    }
}

public class Stop extends Fault {
    public constructor(string reason) {
        super(reason);
    }

    public override describe() -> string {
        return this.reason + "!";
    }
}

public class Shape {
    public int sides;

    public constructor(this.sides);

    public count() -> int {
        return this.sides;
    }
}

public class Square extends Shape {
    public constructor() {
        super(4);
    }

    public override count() -> int {
        return 40;
    }
}

public sealed class Gauge {
    public int level;

    public constructor(this.level);
}

format<F: Fault>(string label, F fault) -> string {
    return label + ": " + fault.describe();
}

measure<S: Shape>(S shape) -> int {
    return shape.count() + shape.sides;
}

read<G: Gauge>(G gauge) -> int {
    return gauge.level;
}

main() -> int {
    print(format("warn", new Warning("disk full")));
    print(format<Stop>("stop", new Stop("bad input")));
    Shape plain = new Shape(3);
    print("{measure(new Square())} {measure<Shape>(plain)}");
    print("sealed: {read(new Gauge(9))}");
    return 0;
}
