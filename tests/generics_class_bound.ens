// @exit 0
// @stdout warn: disk full
// @stdout stop: bad input!
// @stdout 44 6
// @stdout sealed: 9
// @stdout widened: 40 true false 2 40 40
// @stdout met: 3 40 40 3 5 40 40 5
// A generic bound may name a class: the parameter accepts that class or any subclass, the
// body reads the bound's members, and calls dispatch on the value's runtime type. Abstract
// and sealed classes are legal bounds. A value of a parameter bounded by a class converts to that
// class wherever a value of the class would: assigned, passed, returned, stored in a field, compared
// with '==', held by an array or joined by a '?:'. Values of two parameters bounded by classes, or of
// one and a class, meet in a '?:' or a switch at the nearest class they share.
public abstract class Fault {
    protected string reason;

    protected constructor(this.reason);

    public describe() -> string {
        return this.reason;
    }
}

public class Warning extends Fault {
    public constructor(string reason) {
        super(reason);
    }
}

public class Stop extends Fault {
    public constructor(string reason) {
        super(reason);
    }

    public override describe() -> string {
        return this.reason + "!";
    }
}

public class Shape {
    public int sides;

    public constructor(this.sides);

    public count() -> int {
        return this.sides;
    }
}

public class Square extends Shape {
    public constructor() {
        super(4);
    }

    public override count() -> int {
        return 40;
    }
}

public sealed class Gauge {
    public int level;

    public constructor(this.level);
}

format<F: Fault>(string label, F fault) -> string {
    return label + ": " + fault.describe();
}

measure<S: Shape>(S shape) -> int {
    return shape.count() + shape.sides;
}

read<G: Gauge>(G gauge) -> int {
    return gauge.level;
}

counted(Shape shape) -> int {
    return shape.count();
}

asShape<S: Shape>(S shape) -> Shape {
    return shape;
}

class Kept<S: Shape> {
    Shape held;

    constructor(S shape) {
        this.held = shape;
    }
}

widen<S: Shape>(S shape, Shape other) -> string {
    Shape assigned = other;
    assigned = shape;
    Shape?[] both = [shape, other];
    Shape joined = other.sides > 3 ? other : shape;
    let kept = new Kept<S>(shape);
    return "{counted(shape)} {assigned == shape} {other == shape} {both.length} "
        + "{asShape(shape).count()} {joined.count() + kept.held.sides - 4}";
}

meet<A: Shape, B: Shape>(bool up, A first, B second, Square square) -> string {
    Shape chosen = up ? first : second;
    let inferred = up ? second : first;
    let mixed = up ? square : first;
    let arm = switch (first.sides) {
        3 -> first,
        default -> second,
    };
    return "{chosen.count()} {inferred.count()} {mixed.count()} {arm.count()}";
}

main() -> int {
    print(format("warn", new Warning("disk full")));
    print(format<Stop>("stop", new Stop("bad input")));
    Shape plain = new Shape(3);
    print("{measure(new Square())} {measure<Shape>(plain)}");
    print("sealed: {read(new Gauge(9))}");
    print("widened: {widen(new Square(), plain)}");
    print("met: {meet(true, new Shape(3), new Square(), new Square())} "
        + "{meet(false, new Square(), new Shape(5), new Square())}");
    return 0;
}
