// Type-argument inference for generic function calls binds a type parameter wherever the parameter
// type mentions it: through arrays, optionals, generic types and their nesting, function types
// (the parameter types, the return type, and the thrown list), and the conformance of the
// argument's type (the interfaces a class implements, the classes it extends, and the interfaces
// an interface extends). The first argument that mentions a parameter binds it, a later argument
// that binds it directly agrees with it, and explicit type arguments win over what inference
// would pick.
// @exit 0
// @stdout first word: alpha
// @stdout drained: 3
// @stdout first in range: 1
// @stdout first in bag: 4
// @stdout first in extended: 7
// @stdout unboxed labeled: 5
// @stdout unboxed int box: 6
// @stdout first in group: 10
// @stdout first or null: 2
// @stdout first or fallback: 9
// @stdout last: c
// @stdout evens: 2 4
// @stdout attempt gave 41
// @stdout attempt failed: over the limit
// @stdout int 5
// @stdout long 5
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;

class CountUp implements Iterator<int> {
    int current;
    int limit;

    protected constructor(this.current, this.limit);

    protected override next() -> int? {
        if (this.current > this.limit) {
            return null;
        }
        int value = this.current;
        this.current = this.current + 1;
        return value;
    }
}

class Range implements Iterable<int> {
    int low;
    int high;

    protected constructor(this.low, this.high);

    protected override makeIterator() -> Iterator<int> {
        return new CountUp(this.low, this.high);
    }
}

// Reaches 'Iterable<int>' only through its base class.
class Extended extends Range {
    protected constructor(int low, int high) {
        super(low, high);
    }
}

interface Bag<T> extends Iterable<T> {
    count() -> long;
}

class Numbers implements Bag<int> {
    Range range;
    long size;

    protected constructor(this.range, this.size);

    protected override count() -> long {
        return this.size;
    }

    protected override makeIterator() -> Iterator<int> {
        return this.range.makeIterator();
    }
}

class Box<T> {
    protected T value;

    protected constructor(this.value);
}

class Labeled<T> extends Box<T> {
    protected string label;

    protected constructor(T value, string label) {
        super(value);
        this.label = label;
    }
}

class IntBox extends Box<int> {
    protected constructor(int value) {
        super(value);
    }
}

class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

// 'List<T>' binds T from a 'List<string>'.
firstOf<T>(List<T> items) -> T {
    return items.get(0);
}

// 'Iterator<T>' binds T from a class implementing 'Iterator<int>'.
drain<T>(Iterator<T> walk) -> long {
    long count = 0;
    while (walk.next() != null) {
        count++;
    }
    return count;
}

// 'Iterable<T>' binds T through whatever the argument's type conforms to.
firstIn<T>(Iterable<T> items) -> T? {
    return items.makeIterator().next();
}

// A generic class parameter binds from a subclass, generic or not.
unbox<T>(Box<T> box) -> T {
    return box.value;
}

// Nested generic types bind every parameter they mention; the second argument agrees with K.
firstInGroup<K, V>(Map<K, List<V>> groups, K key) -> V? {
    let items = groups.get(key);
    if (items == null) {
        return null;
    }
    if (items.length() == 0) {
        return null;
    }
    return items.get(0);
}

// An optional generic type binds through the optional.
firstOrNull<T>(List<T>? items) -> T? {
    if (items == null) {
        return null;
    }
    return items.get(0);
}

// The first argument binds T through the instantiation and the second agrees with it directly.
firstOrFallback<T>(List<T>? items, T fallback) -> T {
    if (items == null) {
        return fallback;
    }
    return items.get(0);
}

last<T>(T[] items) -> T {
    return items[items.length - 1];
}

// A function type binds T through its parameter types, from a variable holding a function value.
select<T>((T) -> bool keep, T[] items) -> T[] {
    let kept = new List<T>();
    for (let item in items) {
        if (keep(item)) {
            kept.push(item);
        }
    }
    return kept.toArray();
}

// A function type binds V through its return type and E through its thrown list.
attempt<V, E: Error>((() -> V throws E) work) -> V throws E {
    return try work();
}

describeAttempt((() -> int throws Failure) work) -> string {
    let value = try attempt(work);
    return "attempt gave {value}";
} catch (Failure caught) {
    return "attempt failed: {caught.message}";
}

keep<T>(T value) -> T {
    return value;
}

show(int value) {
    print("int {value}");
}

show(long value) {
    print("long {value}");
}

maybeInts(bool present) -> List<int>? {
    if (!present) {
        return null;
    }
    let items = new List<int>();
    items.push(2);
    return items;
}

joinInts(int[] values) -> string {
    string text = "";
    for (let value in values) {
        if (text.length > 0) {
            text = text + " ";
        }
        text = text + "{value}";
    }
    return text;
}

main() -> int {
    let words = new List<string>();
    words.push("alpha");
    words.push("beta");
    print("first word: {firstOf(words)}");

    print("drained: {drain(new CountUp(1, 3))}");

    print("first in range: {firstIn(new Range(1, 3)) ?? -1}");
    Bag<int> bag = new Numbers(new Range(4, 6), 3);
    print("first in bag: {firstIn(bag) ?? -1}");
    print("first in extended: {firstIn(new Extended(7, 9)) ?? -1}");

    print("unboxed labeled: {unbox(new Labeled<int>(5, "five"))}");
    print("unboxed int box: {unbox(new IntBox(6))}");

    let groups = new Map<string, List<int>>();
    let tens = new List<int>();
    tens.push(10);
    tens.push(11);
    groups.set("tens", tens);
    print("first in group: {firstInGroup(groups, "tens") ?? -1}");

    print("first or null: {firstOrNull(maybeInts(true)) ?? -1}");
    print("first or fallback: {firstOrFallback(maybeInts(false), 9)}");

    print("last: {last(["a", "b", "c"])}");

    (int) -> bool isEven = (value) -> value % 2 == 0;
    print("evens: {joinInts(select(isEven, [1, 2, 3, 4]))}");

    int limit = 1;
    (() -> int throws Failure) safe = () -> 41;
    (() -> int throws Failure) risky = () -> {
        if (limit > 0) {
            throw new Failure("over the limit");
        }
        return limit;
    };
    print(describeAttempt(safe));
    print(describeAttempt(risky));

    show(keep(5));
    show(keep<long>(5));
    return 0;
}
