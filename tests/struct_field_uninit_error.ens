// @expect-error has non-nullable type 'Wrap' but no initializer
class Inner {
    int v;
    constructor(this.v = 0);
}

// A struct may hold a non-defaultable field; the struct is then non-defaultable
// itself and must be constructed rather than zero-initialized.
struct Wrap {
    Inner inner;
}

main() -> int {
    Wrap w;
    return 0;
}
