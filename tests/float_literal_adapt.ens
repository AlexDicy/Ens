// @exit 42
// An unsuffixed floating-point literal takes the surrounding floating-point type, in every
// position an untyped integer literal already adapts in.
struct Point {
    protected float x = 1.5;
    protected float y;
}

class Holder {
    protected float scale = 0.25;
    protected constructor() { }
}

takeFloat(float v) -> float {
    return v;
}

onlyFloat(float v) -> float {
    return v;
}

onlyFloat(string label) -> float {
    return 0.0;
}

withDefault(float v = 2.5) -> float {
    return v;
}

returnsFloat() -> float {
    return 1.5;
}

main() -> int {
    float declared = 1.0;
    if (declared != 1.0)                    { return 1; }

    declared = 2.5;
    if (declared != 2.5)                    { return 2; }

    declared += 0.5;
    if (declared != 3.0)                    { return 3; }

    float negative = -1.5;
    if (negative != -1.5)                   { return 4; }

    // Rounding to the nearest value a float has is part of the conversion, so a literal no
    // binary floating-point type represents exactly still adapts.
    float precise = 0.1;
    if (precise < 0.09)                     { return 5; }
    if (precise > 0.11)                     { return 6; }

    if (takeFloat(2.5) != 2.5)              { return 7; }
    if (onlyFloat(1.0) != 1.0)              { return 8; }
    if (withDefault() != 2.5)               { return 9; }
    if (returnsFloat() != 1.5)              { return 10; }

    float[] elements = [1.0, 2.0];
    if (elements[0] != 1.0)                 { return 11; }
    if (elements[1] != 2.0)                 { return 12; }

    Point point = { x: 3.5, y: 4.5 };
    if (point.x != 3.5)                     { return 13; }
    if (point.y != 4.5)                     { return 14; }

    Point defaulted = { y: 1.0 };
    if (defaulted.x != 1.5)                 { return 15; }

    let holder = new Holder();
    if (holder.scale != 0.25)               { return 16; }

    // Either side of a binary operator adapts toward the other, as it does for '+' on integers.
    float sibling = declared + 1.0;
    if (sibling != 4.0)                     { return 17; }
    float siblingLeft = 1.0 + declared;
    if (siblingLeft != 4.0)                 { return 18; }
    if (declared > 100.0)                   { return 19; }
    if (!(declared == 3.0))                 { return 20; }

    float ternary = true ? 1.0 : declared;
    if (ternary != 1.0)                     { return 21; }

    // A suffix still names the type, and a double target is unchanged by all of this.
    float suffixed = 1.0f;
    if (suffixed != 1.0)                    { return 22; }
    double stillDouble = 1.0;
    if (stillDouble != 1.0)                 { return 23; }
    double fromFloat = 1.0f;
    if (fromFloat != 1.0)                   { return 24; }

    // The largest magnitude a float holds is accepted; a tiny one rounds to zero.
    float largest = 3.4e38;
    if (largest < 3.0e38)                   { return 25; }
    float rounded = 1e-60;
    if (rounded != 0.0)                     { return 26; }

    return 42;
}
