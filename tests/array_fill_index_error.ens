// @expect-error An array of non-nullable 'Box' must be filled as it is created
// The loop body must assign to the loop's own index, not another expression.
class Box {
    int v;
    constructor(this.v);
}

main() -> int {
    Box[] boxes = new Box[2];
    for (long i = 0; i < boxes.length; i = i + 1) {
        boxes[0] = new Box(1);
    }
    return 0;
}
