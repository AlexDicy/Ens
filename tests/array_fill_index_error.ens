// @expect-error An array of 'Box', which cannot be null, must be filled as it is created. Assign it to a new variable and follow the declaration with 'for (long i = 0; i < boxes.length; i++) { boxes[i] = ...; }'. Or use 'Box?[]' so a slot can start as null.
// The loop body must assign to the loop's own index, not another expression.
class Box {
    int v;
    protected constructor(this.v);
}

main() -> int {
    Box[] boxes = new Box[2];
    for (long i = 0; i < boxes.length; i = i + 1) {
        boxes[0] = new Box(1);
    }
    return 0;
}
