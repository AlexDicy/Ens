// 'decimal' is a reserved word with no type behind it, so every position that can name a type
// refuses it with the same guidance instead of carrying it further.
// @expect-error 'decimal' is a reserved word and not a usable type yet

struct Money {
    decimal amount;
}

public class Box<T> {
    protected T value;

    protected constructor(this.value);
}

public class Ledger {
    protected decimal balance = 0;
    protected decimal? pending = null;
    protected decimal[]? history = null;

    public constructor();

    public scale(decimal factor) -> decimal {
        return factor;
    }
}

main() -> int {
    decimal here = 0;
    decimal? maybe = null;
    decimal[] many = new decimal[2];
    Box<decimal>? boxed = null;
    let converted = 1 as decimal;
    print("{here} {maybe} {many.length} {boxed} {converted}");
    return 0;
}
