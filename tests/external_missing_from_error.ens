// @expect-error Expected 'from' after 'external'. For example, write 'external from libc { ... }'.
// @expect-error Expected an external function declaration, a name and parameters with no body. For example, write 'CloseHandle(HANDLE h) -> int;'.
// With 'from' absent after 'external', the external block still reports the
// missing keyword cleanly instead of misparsing the library string.
external "c" {
    abs(int x) -> int;
}

main() -> int {
    return 0;
}
