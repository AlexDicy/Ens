// @expect-error build failed with 12 problems
// Calls, catch clauses and interpolations whose refusals name what the call passes.
external type Handle;

external from libc {
    make_handle() -> Handle;
}

class Failure extends Error {
    constructor() {
        super("failed");
    }
}

risky() throws Failure {
    throw new Failure();
}

interface Speaker {
    speak() -> string;
}

interface Reader {
    read() -> int;
}

struct Voice implements Speaker {
    string word;

    override speak() -> string {
        return this.word;
    }
}

struct Token {
    int id;

    override equals(Token other) -> bool throws {
        return this.id == other.id;
    }

    override hash() -> long {
        return this.id as long;
    }
}

class Base {
    read() -> int {
        return 0;
    }
}

class Child extends Base {
    override read() -> int {
        try risky();
        return 0;
    } catch (Failure failure) {
        risky();
        return 1;
    }
}

class Implementer implements Reader {
    override read() -> int {
        try risky();
        return 0;
    } catch (Failure failure) {
        risky();
        return 1;
    }
}

class Both extends Base implements Reader {
    override read() -> int {
        try risky();
        return 0;
    } catch (Failure failure) {
        risky();
        return 1;
    }
}

class Built {
    constructor(int a) {
    }

    constructor(string s) {
    }

    single(int a) -> int {
        return a;
    }

    named(int a, int b) -> int {
        return a + b;
    }
}

shown<T>(T value) -> string {
    return "{value}";
}

isSpeaker<T: Speaker>(T value) -> bool {
    return value is Speaker;
}

main() -> int {
    Handle handle = make_handle();
    print("{handle}");
    print(shown<Handle>(handle));
    Voice voice = {word: "hi"};
    bool speaks = isSpeaker<Voice>(voice);
    let none = new Built();
    let built = new Built(1);
    int one = built.single(1, 2);
    int two = built.single(1, 2, 3);
    int three = built.named(a: 1);
    return 0;
}
