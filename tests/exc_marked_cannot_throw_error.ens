// @expect-error is marked 'throws' but cannot throw
// @expect-error build failed with 1 problem
// A function marked 'throws' that raises nothing is the one report. Its callers follow its marker,
// so their 'try', 'catch' and 'throws' are not judged against its body.
class Repo {
    safe() -> int throws { return 1; }   // body cannot throw

    direct() -> int {
        return try this.safe();
    } catch (Error e) {
        return 0;
    }

    relay() -> int throws {
        return try this.safe();
    }
}
main() -> int { return 0; }
