// @stdlib stackframe_stdlib
// @exit 0
// @stdout frames 2
// @stdout 0: deep (stack_frame_struct.ens:25)
// @stdout 1: main (stack_frame_struct.ens:29)
// @stdout wrapped: outer
// @stdout caused by Failure: deepest
// A captured trace read back as values when '@std.core' declares 'StackFrame' as a struct: the
// frames sit in the array's own elements rather than in objects it points at, so the fields are
// read through no reference and the array releases the two strings of each element itself. The
// same program against the class shape is stack_trace_caught.ens.
class Failure extends Error {
    protected constructor(string message) {
        super(message);
    }
}

class Wrapper extends Error {
    protected constructor(string message, Error? cause) {
        super(message, cause);
    }
}

deep() -> int throws {
    throw new Failure("deepest");
}

main() -> int {
    return try deep();
} catch (Failure caught) {
    let frames = caught.stackFrames();
    print("frames {frames.length}");
    for (long i = 0; i < frames.length; i++) {
        print("{i}: {frames[i].function} ({frames[i].file}:{frames[i].line})");
    }
    print("wrapped: " + new Wrapper("outer", caught).toString());
    return 0;
}
