// @exit 0
// @stdout get one
// @stdout absent ok
// @stdout overwrite 11
// @stdout contains ok
// @stdout remove ok
// @stdout reinsert length 2
// @stdout resize 40 ok
// @stdout int-key ok
// @stdout class-value ok
// @stdout identity-keys 2
// @stdout custom-hash ok
// @stdout entries 3 sum 33
// @stdout keys-values ok
// @stdout set ok
// @stdout set-dedup 3
// @stdout set-iterate 6
// @stdout set-resize 30 ok
// @stdout list-iterate 60
// @stdout list-strings ab

import Map from @std.map;
import Set from @std.set;
import List from @std.list;

class Payload {
    int score;
    Payload(this.score);
}

class Ticket {
    int number;
    Ticket(this.number);
    hash() -> long { return this.number; }
}

main() -> int {
    let ages = new Map<string, int>();
    ages.set("one", 1);
    ages.set("two", 2);

    int? found = ages.get("one");
    if (found == 1) { print("get one"); }
    if (ages.get("three") == null) { print("absent ok"); }

    ages.set("one", 11);
    print("overwrite " + (ages.get("one") ?? 0));

    if (ages.contains("two") && !ages.contains("three")) { print("contains ok"); }
    if (ages.remove("two") && !ages.remove("two") && !ages.contains("two")) { print("remove ok"); }

    ages.set("two", 2);
    print("reinsert length " + ages.length());

    let numbers = new Map<int, long>();
    let i = 0;
    while (i < 40) {
        numbers.set(i, i * 10);
        i = i + 1;
    }
    bool allThere = numbers.length() == 40;
    i = 0;
    while (i < 40) {
        if (numbers.get(i) != i * 10) { allThere = false; }
        i = i + 1;
    }
    if (allThere) { print("resize 40 ok"); }

    let byNumber = new Map<int, string>();
    byNumber.set(7, "seven");
    if ((byNumber.get(7) ?? "") == "seven") { print("int-key ok"); }

    let payloads = new Map<string, Payload>();
    payloads.set("a", new Payload(5));
    Payload? stored = payloads.get("a");
    if (stored != null) {
        if (stored.score == 5) { print("class-value ok"); }
    }

    // Class keys hash and compare by identity: equal contents, distinct keys.
    let byInstance = new Map<Payload, int>();
    let first = new Payload(1);
    let second = new Payload(1);
    byInstance.set(first, 10);
    byInstance.set(second, 20);
    if (byInstance.length() == 2 && byInstance.get(first) == 10 && byInstance.get(second) == 20) {
        print("identity-keys " + byInstance.length());
    }

    // A declared hash() -> long overrides the identity hash; keys still
    // compare by identity, so equal-hash instances stay distinct entries.
    let byTicket = new Map<Ticket, string>();
    let ticket = new Ticket(7);
    byTicket.set(ticket, "window");
    if ((byTicket.get(ticket) ?? "") == "window") { print("custom-hash ok"); }

    let small = new Map<string, int>();
    small.set("x", 10);
    small.set("y", 11);
    small.set("z", 12);
    long entryCount = 0;
    long total = 0;
    for (let entry in small) {
        entryCount = entryCount + 1;
        total = total + entry.value;
    }
    print("entries " + entryCount + " sum " + total);

    string[] keyList = small.keys();
    int[] valueList = small.values();
    if (keyList.length == 3 && valueList.length == 3) { print("keys-values ok"); }

    let names = new Set<string>();
    bool addedOnce = names.add("green");
    bool addedTwice = names.add("green");
    if (addedOnce && !addedTwice && names.contains("green") && !names.contains("red")) {
        if (names.remove("green") && !names.contains("green")) { print("set ok"); }
    }

    let letters = new Set<string>();
    letters.add("a");
    letters.add("b");
    letters.add("c");
    letters.add("a");
    letters.add("b");
    print("set-dedup " + letters.length());

    let values = new Set<int>();
    values.add(1);
    values.add(2);
    values.add(3);
    long sum = 0;
    for (let value in values) {
        sum = sum + value;
    }
    print("set-iterate " + sum);

    let wide = new Set<int>();
    i = 0;
    while (i < 30) {
        wide.add(i);
        i = i + 1;
    }
    bool allIn = wide.length() == 30;
    i = 0;
    while (i < 30) {
        if (!wide.contains(i)) { allIn = false; }
        i = i + 1;
    }
    if (allIn) { print("set-resize 30 ok"); }

    let measurements = new List<int>();
    measurements.push(10);
    measurements.push(20);
    measurements.push(30);
    long listSum = 0;
    for (let value in measurements) {
        listSum = listSum + value;
    }
    print("list-iterate " + listSum);

    let words = new List<string>();
    words.push("a");
    words.push("b");
    string joined = "";
    for (let word in words) {
        joined = joined + word;
    }
    print("list-strings " + joined);

    return 0;
}
