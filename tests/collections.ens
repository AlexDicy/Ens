// @exit 0
// @stdout reinsert length 2
// @stdout class-value ok
// @stdout identity-keys 2
// @stdout content-key ok
// @stdout list-iterate 60
// @stdout list-pop ok
// @stdout list-pop-reuse 7

import Map from @std.collections.map;
import List from @std.collections.list;

class Payload {
    protected int score;
    protected constructor(this.score);
}

class Ticket {
    int number;
    protected constructor(this.number);
    override hash() -> long { return this.number; }
    override equals(Ticket other) -> bool { return this.number == other.number; }
}

main() -> int {
    let ages = new Map<string, int>();
    ages.set("one", 1);
    ages.set("two", 2);
    ages.remove("two");
    ages.set("two", 2);
    print("reinsert length " + ages.length());

    let payloads = new Map<string, Payload>();
    payloads.set("a", new Payload(5));
    Payload? stored = payloads.get("a");
    if (stored != null) {
        if (stored.score == 5) { print("class-value ok"); }
    }

    // Class keys hash and compare by identity: equal contents, distinct keys.
    let byInstance = new Map<Payload, int>();
    let first = new Payload(1);
    let second = new Payload(1);
    byInstance.set(first, 10);
    byInstance.set(second, 20);
    if (byInstance.length() == 2 && byInstance.get(first) == 10 && byInstance.get(second) == 20) {
        print("identity-keys " + byInstance.length());
    }

    // A class that declares hash() and equals() is a content-matched key: two
    // distinct instances with equal contents collapse to one entry, and a fresh
    // key finds the value stored under an equal one.
    let byTicket = new Map<Ticket, string>();
    byTicket.set(new Ticket(7), "window");
    byTicket.set(new Ticket(7), "aisle");
    string seat = byTicket.get(new Ticket(7)) ?? "none";
    if (byTicket.length() == 1 && seat == "aisle") { print("content-key ok"); }

    let measurements = new List<int>();
    measurements.push(10);
    measurements.push(20);
    measurements.push(30);
    long listSum = 0;
    for (let value in measurements) {
        listSum = listSum + value;
    }
    print("list-iterate " + listSum);

    let stack = new List<int>();
    stack.push(1);
    stack.push(2);
    stack.push(3);
    int poppedThird = stack.pop();
    int poppedSecond = stack.pop();
    int poppedFirst = stack.pop();
    if (poppedThird == 3 && poppedSecond == 2 && poppedFirst == 1 && stack.length() == 0) {
        print("list-pop ok");
    }

    stack.push(7);
    print("list-pop-reuse " + stack.get(0));

    return 0;
}
