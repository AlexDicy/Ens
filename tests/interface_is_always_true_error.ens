// @expect-error A value of type 'Dog' is always of type 'Speaker', so this 'is' test is always true. Remove it.
interface Speaker {
    speak() -> string;
}

class Dog implements Speaker {
    protected constructor();
    speak() -> string { return "woof"; }
}

main() -> int {
    Dog d = new Dog();
    if (d is Speaker) {
        return 1;
    }
    return 0;
}
