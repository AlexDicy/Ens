// @expect-error Cannot read a member of 'Door?'
class Door {
    int code;
    constructor(this.code = 0);
}

class Room {
    Door? door;
    constructor(this.door = null);
}

main() -> int {
    let r = new Room(new Door(7));
    if (r.door != null) {
        r.door.code;        // narrowed - ok
        r.door = null;      // allowed - checked against the declared 'Door?'
        return r.door.code; // error - the write dropped the narrowing
    }
    return 0;
}
