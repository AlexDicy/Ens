// @expect-error Cannot read a member of 'Door?'
class Door {
    int code;
    Door(this.code = 0);
}

class Room {
    Door? door;
    Room(this.door = null);
}

main() -> int {
    let r = new Room(new Door(7));
    let other = new Door(0);
    if (r.door != null) {
        r.door.code;       // narrowed - ok
        r.door = other;    // member write at the narrowed path - drops it
        return r.door.code; // error - r.door is back to 'Door?'
    }
    return 0;
}