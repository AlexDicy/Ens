{
  "name": "language-support",
  "displayName": "Ens",
  "description": "Language support for Ens (development build).",
  "version": "0.1.0",
  "publisher": "ens",
  "icon": "images/ens-logo.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ens"],
  "main": "./client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ens",
        "aliases": ["Ens"],
        "extensions": [".ens"],
        "filenames": ["ens.package", "ens.overrides"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/ens-file-icon-light.svg",
          "dark": "./images/ens-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ens",
        "scopeName": "source.ens",
        "path": "./syntaxes/ens.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Ens",
      "properties": {
        "ens.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the ens-lsp executable. If empty, the extension uses ../../build/windows/x64/debug/ens-lsp.exe relative to this extension folder."
        },
        "ens.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VS Code and the ens-lsp server."
        }
      }
    }
  },
  "scripts": {
    "sync-assets": "node ./scripts/sync-assets.js",
    "prepare": "node ./scripts/sync-assets.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
