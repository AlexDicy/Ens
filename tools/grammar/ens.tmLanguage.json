{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Ens",
    "scopeName": "source.ens",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#declarations" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ens",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.ens",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "A string literal ends at the line break: the lexer reports an unterminated string per line, so the scope must not leak into the following lines",
                    "name": "string.quoted.double.ens",
                    "begin": "\"",
                    "end": "\"|(?=$)",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ens",
                            "match": "\\\\(?:[\\\\\"'nrtbf0]|u[0-9a-fA-F]{4})"
                        },
                        {
                            "name": "meta.template.expression.ens",
                            "begin": "(?<!\\\\)\\{",
                            "end": "\\}|(?=$)",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.ens",
                    "match": "'(?:\\\\(?:[\\\\\"'nrtbf0]|u[0-9a-fA-F]{4})|[^'\\\\])'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.ens",
                    "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]?\\b"
                },
                {
                    "name": "constant.numeric.binary.ens",
                    "match": "\\b0[bB][01][01_]*[lL]?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFdD]\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.ens",
                    "match": "\\b\\d[\\d_]*[lL]?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ens",
                    "match": "\\b(?:if|else|while|for|do|return|break|continue|switch|case|default|try|catch|finally|throw|throws|rethrow)\\b"
                },
                {
                    "name": "keyword.other.import.ens",
                    "match": "\\b(?:import|from|package)\\b"
                },
                {
                    "comment": "Manifest keywords (ens.package / ens.overrides) are contextual: each pattern demands the shape of its own declaration, so the same words stay plain identifiers in ordinary source",
                    "name": "keyword.other.manifest.ens",
                    "match": "^\\s*(?:workspace|overrides)\\b(?=\\s*\\{)"
                },
                {
                    "name": "keyword.other.manifest.ens",
                    "match": "^\\s*(?:version|ens|member)\\b(?=\\s+\")"
                },
                {
                    "name": "keyword.other.manifest.ens",
                    "match": "^\\s*dependency\\b(?=\\s+[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*(?:\\s+\"|\\s+from\\b|\\s*;))"
                },
                {
                    "comment": "The manifest `override name \"folder\";`, not the `override` modifier of a member declaration",
                    "name": "keyword.other.manifest.ens",
                    "match": "^\\s*override\\b(?=\\s+[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*\\s+\")"
                },
                {
                    "comment": "The system form `native libc system;`. Both keywords are scoped here because a second pattern could not re-anchor at the line start once this one has consumed the library name",
                    "match": "^\\s*(native)\\s+[A-Za-z_$][\\w$]*\\s+(system)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" },
                        "2": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "name": "keyword.other.manifest.ens",
                    "match": "^\\s*native\\b(?=\\s+[A-Za-z_$][\\w$]*\\s*[;{])"
                },
                {
                    "comment": "Native binding words inside a manifest's binding block",
                    "match": "^\\s*[A-Za-z_][\\w$]*\\s+(artifact)\\b(?=\\s*\")",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "name": "keyword.other.manifest.ens",
                    "match": "\\bhash\\b(?=\\s*\"sha256:)"
                },
                {
                    "comment": "The created type is scoped here rather than in #types, since #keywords is reached first and would otherwise leave the type to the function-call rule",
                    "begin": "\\b(new)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.new.ens" }
                    },
                    "end": "(?=[(\\[{;,)}]|$)",
                    "patterns": [
                        { "include": "#type-reference" }
                    ]
                },
                {
                    "name": "keyword.other.cast.ens",
                    "match": "\\b(?:as|is)\\b"
                },
                {
                    "name": "storage.type.let.ens",
                    "match": "\\blet\\b"
                },
                {
                    "name": "keyword.other.ens",
                    "match": "\\b(?:assert|computed|constructor|destructor|enum|extends|external|goto|implements|super|this|type)\\b"
                },
                {
                    "comment": "`out` is a contextual keyword: highlight it only in argument/parameter position (followed by a type or identifier), not when used as an ordinary name",
                    "name": "keyword.other.ens",
                    "match": "\\bout\\b(?=\\s+[A-Za-z_$])"
                },
                {
                    "comment": "`in` is a contextual keyword: highlight it only between a for-each loop variable and its iterable",
                    "match": "\\b[A-Za-z_$][\\w$]*\\s+(in)\\b(?=\\s+[A-Za-z_$(])",
                    "captures": {
                        "1": { "name": "keyword.control.ens" }
                    }
                },
                {
                    "comment": "`test` is a contextual keyword: highlight it only when it starts a test declaration (followed by a string literal)",
                    "name": "keyword.other.test.ens",
                    "match": "\\btest\\b(?=\\s*\")"
                },
                {
                    "name": "storage.modifier.visibility.ens",
                    "match": "\\b(?:private|protected|public|export)\\b"
                },
                {
                    "name": "storage.modifier.ens",
                    "match": "\\b(?:static|final|sealed|abstract|override|weak|const)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.ens",
                    "match": "\\b(?:true|false)\\b"
                },
                {
                    "name": "constant.language.null.ens",
                    "match": "\\bnull\\b"
                }
            ]
        },
        "primitive-types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.ens",
                    "match": "\\b(?:bool|byte|short|ushort|int|uint|long|ulong|float|double|decimal|char|string|void)\\b"
                }
            ]
        },
        "type-reference": {
            "comment": "One written type: an optional module qualifier, the name, and any type arguments",
            "patterns": [
                { "include": "#primitive-types" },
                {
                    "match": "([A-Za-z_$][\\w$]*)\\s*(\\.)",
                    "captures": {
                        "1": { "name": "entity.name.namespace.ens" },
                        "2": { "name": "punctuation.accessor.ens" }
                    }
                },
                {
                    "name": "entity.name.type.ens",
                    "match": "[A-Za-z_$][\\w$]*"
                },
                { "include": "#type-arguments" },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?"
                }
            ]
        },
        "type-arguments": {
            "comment": "Bails out at the line end so a stray `<` cannot swallow the rest of the file",
            "begin": "<",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.typeparameters.begin.ens" }
            },
            "end": ">|(?=$)",
            "endCaptures": {
                "0": { "name": "punctuation.definition.typeparameters.end.ens" }
            },
            "patterns": [
                { "include": "#type-reference" },
                {
                    "name": "punctuation.separator.comma.ens",
                    "match": ","
                }
            ]
        },
        "types": {
            "patterns": [
                { "include": "#primitive-types" },
                {
                    "comment": "Type name in struct/class/interface declaration",
                    "match": "\\b(struct|class|interface)\\s+([A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "storage.type.ens" },
                        "2": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "Capitalized identifier in type position (custom types), including array/optional suffixes like T[] or T?[]",
                    "match": "\\b([A-Z][\\w$]*)(?:\\?|\\[\\])*(?=\\s+[A-Za-z_$])",
                    "captures": {
                        "1": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "Capitalized identifier after `->`",
                    "match": "->\\s*([A-Z][\\w$]*)\\??",
                    "captures": {
                        "1": { "name": "entity.name.type.ens" }
                    }
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "Function/method definition: name(...) followed by -> or {",
                    "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\([^)]*\\)\\s*(?:->|\\{|;))",
                    "captures": {
                        "1": { "name": "entity.name.function.ens" }
                    }
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.ens" }
                    }
                }
            ]
        },
        "operators": {
            "comment": "TextMate keeps the first pattern that matches at a position, not the longest one, so every multi-character operator has to be listed before its one-character prefixes",
            "patterns": [
                {
                    "name": "keyword.operator.arrow.ens",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.assignment.ens",
                    "match": "(?:<<|>>>|>>|\\+|-|\\*|/|%|&|\\||\\^)="
                },
                {
                    "name": "keyword.operator.comparison.ens",
                    "match": "==|!=|<=|>="
                },
                {
                    "name": "keyword.operator.logical.ens",
                    "match": "&&|\\|\\|"
                },
                {
                    "name": "keyword.operator.bitwise.ens",
                    "match": "<<|>>>|>>"
                },
                {
                    "name": "keyword.operator.arithmetic.ens",
                    "match": "\\+\\+|--"
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?\\?|\\?\\."
                },
                {
                    "name": "keyword.operator.assignment.ens",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison.ens",
                    "match": "<|>"
                },
                {
                    "name": "keyword.operator.logical.ens",
                    "match": "!"
                },
                {
                    "name": "keyword.operator.arithmetic.ens",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.bitwise.ens",
                    "match": "&|\\||\\^"
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.ens",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.ens",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.ens",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.colon.ens",
                    "match": ":"
                }
            ]
        }
    }
}
