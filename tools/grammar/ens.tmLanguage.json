{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Ens",
    "scopeName": "source.ens",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#type-contexts" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#brackets" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ens",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.ens",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "A string literal ends at the line break: the lexer reports an unterminated string per line, so the scope must not leak into the following lines",
                    "name": "string.quoted.double.ens",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.ens" }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.ens" }
                    },
                    "patterns": [
                        { "include": "#string-escape" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "name": "string.quoted.single.ens",
                    "match": "(')((?:\\\\(?:[\\\\\"'nrtbf0{}]|u[0-9a-fA-F]{4})|[^'\\\\]))(')",
                    "captures": {
                        "1": { "name": "punctuation.definition.string.begin.ens" },
                        "2": { "patterns": [ { "include": "#string-escape" } ] },
                        "3": { "name": "punctuation.definition.string.end.ens" }
                    }
                }
            ]
        },
        "string-escape": {
            "comment": "The escapes the lexer accepts, including the braces that would otherwise open an interpolation hole",
            "patterns": [
                {
                    "name": "constant.character.escape.ens",
                    "match": "\\\\(?:[\\\\\"'nrtbf0{}]|u[0-9a-fA-F]{4})"
                }
            ]
        },
        "interpolation": {
            "comment": "An interpolation hole. Braces inside it are tracked, so a struct literal in a hole cannot close the hole early, and the hole gives up at the line end together with its string.",
            "name": "meta.template.expression.ens",
            "contentName": "meta.embedded.line.ens",
            "begin": "(?<!\\\\)(\\{)",
            "beginCaptures": {
                "1": { "name": "punctuation.definition.template-expression.begin.ens" }
            },
            "end": "(\\})|(?=$)",
            "endCaptures": {
                "1": { "name": "punctuation.definition.template-expression.end.ens" }
            },
            "patterns": [
                { "include": "#interpolation-braces" },
                { "include": "$self" }
            ]
        },
        "interpolation-braces": {
            "begin": "\\{",
            "beginCaptures": {
                "0": { "name": "punctuation.section.braces.begin.ens" }
            },
            "end": "\\}|(?=$)",
            "endCaptures": {
                "0": { "name": "punctuation.section.braces.end.ens" }
            },
            "patterns": [
                { "include": "#interpolation-braces" },
                { "include": "$self" }
            ]
        },
        "numbers": {
            "comment": "Underscores are allowed straight after a base prefix, as the lexer allows them",
            "patterns": [
                {
                    "name": "constant.numeric.hex.ens",
                    "match": "\\b0[xX][0-9a-fA-F_]+[lL]?\\b"
                },
                {
                    "name": "constant.numeric.binary.ens",
                    "match": "\\b0[bB][01_]+[lL]?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFdD]\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.ens",
                    "match": "\\b\\d[\\d_]*[lL]?\\b"
                }
            ]
        },
        "type-contexts": {
            "comment": "Positions where the grammar expects a type or a declared name. These come before #keywords so that a keyword rule cannot consume the introducer and leave its type to the function-call rule.",
            "patterns": [
                {
                    "comment": "`import a.b;`, `import @std.a.b;` and `import Name from a.b;`. `from` is a contextual keyword, so it is scoped here instead of as a bare word.",
                    "begin": "\\b(import)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.other.import.ens" }
                    },
                    "end": "(?=;)|$",
                    "patterns": [
                        {
                            "match": "(?<![\\w$])([A-Za-z_$][\\w$]*)\\s+(?=from\\b)",
                            "captures": {
                                "1": { "name": "entity.name.type.ens" }
                            }
                        },
                        {
                            "name": "keyword.other.import.ens",
                            "match": "\\bfrom\\b"
                        },
                        { "include": "#namespace-path" }
                    ]
                },
                {
                    "comment": "`external type Handle;`, the one position where the contextual keyword `type` introduces a declaration",
                    "match": "\\b(external)\\s+(type)\\s+([A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "keyword.other.ens" },
                        "2": { "name": "keyword.other.ens" },
                        "3": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "`external from libc { ... }`: the library names a native library of the containing package",
                    "match": "\\b(external)\\s+(from)\\s+([A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "keyword.other.ens" },
                        "2": { "name": "keyword.other.import.ens" },
                        "3": { "name": "entity.name.namespace.ens" }
                    }
                },
                {
                    "comment": "A struct, class, interface or enum declaration: its name and any type parameters",
                    "begin": "\\b(struct|class|interface|enum)\\s+([A-Za-z_$][\\w$]*)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.ens" },
                        "2": { "name": "entity.name.type.ens" }
                    },
                    "end": "(?=[{;]|\\b(?:extends|implements)\\b)|$",
                    "patterns": [
                        { "include": "#type-arguments" }
                    ]
                },
                {
                    "comment": "The type lists of the extends, implements and throws clauses. Each clause ends where the next one or the declaration's body begins.",
                    "begin": "\\b(extends|implements|throws)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.other.ens" }
                    },
                    "end": "(?=[{;)]|->|\\b(?:extends|implements|throws)\\b)|$",
                    "patterns": [
                        { "include": "#type-reference" },
                        {
                            "name": "punctuation.separator.comma.ens",
                            "match": ","
                        }
                    ]
                },
                {
                    "comment": "The target type of `x is T`, `x as T` and `x as? T`. A type-switch arm binds a name after its type, so only the type itself is matched.",
                    "match": "\\b(is|as)\\b\\s*(\\?)?\\s*((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)?[A-Za-z_$][\\w$]*(?:\\s*<[\\w$?\\[\\],.\\s<>]*>)?)",
                    "captures": {
                        "1": { "name": "keyword.other.cast.ens" },
                        "2": { "name": "keyword.operator.optional.ens" },
                        "3": { "patterns": [ { "include": "#type-reference" } ] }
                    }
                },
                {
                    "comment": "The caught type of a catch clause",
                    "match": "\\b(catch)\\s*(\\()\\s*((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)?[A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "keyword.control.ens" },
                        "2": { "name": "punctuation.section.parens.begin.ens" },
                        "3": { "patterns": [ { "include": "#type-reference" } ] }
                    }
                },
                {
                    "comment": "The return type after `->`. What follows tells a return type from a switch arm's body, which also sits after an arrow.",
                    "match": "(->)\\s*((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)?[A-Za-z_$][\\w$]*(?:\\s*<[\\w$?\\[\\],.\\s<>]*>)?)(?=(?:\\?|\\[\\])*\\s*(?:\\{|;|\\bthrows\\b))",
                    "captures": {
                        "1": { "name": "keyword.operator.arrow.ens" },
                        "2": { "patterns": [ { "include": "#type-reference" } ] }
                    }
                },
                {
                    "comment": "The created type of a `new` expression",
                    "begin": "\\b(new)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.new.ens" }
                    },
                    "end": "(?=[(\\[{;,)}]|$)",
                    "patterns": [
                        { "include": "#type-reference" }
                    ]
                },
                {
                    "comment": "A written-out generic type such as `List<Token> tokens`. The shape of the type arguments keeps this off comparisons like `a < b && c > d`, and a following `(` marks a call with explicit type arguments instead.",
                    "begin": "(?<![\\w$])([A-Za-z_$][\\w$]*)(?=\\s*<[\\w$?\\[\\],.\\s<>]*>(?!\\s*\\())",
                    "beginCaptures": {
                        "1": { "name": "entity.name.type.ens" }
                    },
                    "end": "(?<=>)|(?=$)",
                    "patterns": [
                        { "include": "#type-arguments" }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "A for-each header: `in` is a contextual keyword, and scoping it inside the header keeps the loop variable free for the rules that would otherwise scope it",
                    "begin": "\\b(for)\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.ens" },
                        "2": { "name": "punctuation.section.parens.begin.ens" }
                    },
                    "end": "(?=\\))|$",
                    "patterns": [
                        {
                            "name": "keyword.control.ens",
                            "match": "\\bin\\b"
                        },
                        { "include": "$self" }
                    ]
                },
                {
                    "name": "keyword.control.ens",
                    "match": "\\b(?:if|else|while|for|do|return|break|continue|switch|case|default|try|catch|finally|throw|rethrow)\\b"
                },
                {
                    "comment": "Manifest keywords (ens.package / ens.overrides) are contextual: each pattern demands the shape of its own declaration, so the same words stay plain identifiers in ordinary source",
                    "match": "^\\s*(workspace|overrides)\\b(?=\\s*\\{)",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "match": "^\\s*(version|ens|member)\\b(?=\\s+\")",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "match": "^\\s*(package)\\s+((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)*[A-Za-z_$][\\w$]*)(?=\\s*\\{)",
                    "captures": {
                        "1": { "name": "keyword.other.import.ens" },
                        "2": { "patterns": [ { "include": "#namespace-path" } ] }
                    }
                },
                {
                    "match": "^\\s*(dependency)\\s+((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)*[A-Za-z_$][\\w$]*)(?=\\s+\"|\\s+from\\b|\\s*;)",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" },
                        "2": { "patterns": [ { "include": "#namespace-path" } ] }
                    }
                },
                {
                    "comment": "The manifest `override name \"folder\";`, not the `override` modifier of a member declaration",
                    "match": "^\\s*(override)\\s+((?:[A-Za-z_$][\\w$]*\\s*\\.\\s*)*[A-Za-z_$][\\w$]*)(?=\\s+\")",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" },
                        "2": { "patterns": [ { "include": "#namespace-path" } ] }
                    }
                },
                {
                    "comment": "The system form `native libc system;`. Both keywords are scoped here because a second pattern could not re-anchor at the line start once this one has consumed the library name",
                    "match": "^\\s*(native)\\s+[A-Za-z_$][\\w$]*\\s+(system)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" },
                        "2": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "match": "^\\s*(native)\\b(?=\\s+[A-Za-z_$][\\w$]*\\s*[;{])",
                    "captures": {
                        "1": { "name": "keyword.other.manifest.ens" }
                    }
                },
                {
                    "comment": "The binding words of a manifest's native block, each introducing a quoted value",
                    "name": "keyword.other.manifest.ens",
                    "match": "\\b(?:artifact|hash)\\b(?=\\s*\")"
                },
                {
                    "comment": "The source of a manifest dependency, the only `from` outside an import or an external block",
                    "name": "keyword.other.import.ens",
                    "match": "\\bfrom\\b(?=\\s*\")"
                },
                {
                    "name": "keyword.other.import.ens",
                    "match": "\\bpackage\\b"
                },
                {
                    "name": "keyword.other.cast.ens",
                    "match": "\\b(?:as|is)\\b"
                },
                {
                    "name": "keyword.control.new.ens",
                    "match": "\\bnew\\b"
                },
                {
                    "name": "storage.type.let.ens",
                    "match": "\\blet\\b"
                },
                {
                    "comment": "The declaration keywords on their own, for a head whose name is not written yet",
                    "name": "storage.type.ens",
                    "match": "\\b(?:struct|class|interface|enum)\\b"
                },
                {
                    "name": "variable.language.this.ens",
                    "match": "\\bthis\\b"
                },
                {
                    "name": "variable.language.super.ens",
                    "match": "\\bsuper\\b"
                },
                {
                    "name": "keyword.other.ens",
                    "match": "\\b(?:assert|computed|constructor|destructor|extends|external|goto|implements|throws)\\b"
                },
                {
                    "comment": "`out` is a contextual keyword: highlight it only in argument/parameter position (followed by a type or identifier), not when used as an ordinary name",
                    "name": "keyword.other.ens",
                    "match": "\\bout\\b(?=\\s+[A-Za-z_$])"
                },
                {
                    "comment": "`test` is a contextual keyword: highlight it only when it starts a test declaration (followed by a string literal)",
                    "name": "keyword.other.test.ens",
                    "match": "\\btest\\b(?=\\s*\")"
                },
                {
                    "name": "storage.modifier.visibility.ens",
                    "match": "\\b(?:private|protected|public|export)\\b"
                },
                {
                    "name": "storage.modifier.ens",
                    "match": "\\b(?:static|final|sealed|abstract|override|weak|const|noreturn)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.ens",
                    "match": "\\b(?:true|false)\\b"
                },
                {
                    "name": "constant.language.null.ens",
                    "match": "\\bnull\\b"
                }
            ]
        },
        "namespace-path": {
            "comment": "A dotted path of an import, a package name or a manifest dependency",
            "patterns": [
                {
                    "name": "punctuation.definition.package.ens",
                    "match": "@"
                },
                {
                    "name": "punctuation.accessor.ens",
                    "match": "\\."
                },
                {
                    "name": "entity.name.namespace.ens",
                    "match": "[A-Za-z_$][\\w$]*"
                }
            ]
        },
        "primitive-types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.ens",
                    "match": "\\b(?:bool|byte|short|ushort|int|uint|long|ulong|float|double|decimal|char|string|void)\\b"
                }
            ]
        },
        "type-reference": {
            "comment": "One written type: an optional module qualifier, the name, and any type arguments",
            "patterns": [
                { "include": "#primitive-types" },
                {
                    "match": "([A-Za-z_$][\\w$]*)\\s*(\\.)",
                    "captures": {
                        "1": { "name": "entity.name.namespace.ens" },
                        "2": { "name": "punctuation.accessor.ens" }
                    }
                },
                {
                    "name": "entity.name.type.ens",
                    "match": "[A-Za-z_$][\\w$]*"
                },
                { "include": "#type-arguments" },
                {
                    "match": "(\\[)(\\])",
                    "captures": {
                        "1": { "name": "punctuation.section.brackets.begin.ens" },
                        "2": { "name": "punctuation.section.brackets.end.ens" }
                    }
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?"
                }
            ]
        },
        "type-arguments": {
            "comment": "A type argument list, and the type parameter lists of declarations with their bounds. Bails out at the line end so a stray `<` cannot swallow the rest of the file.",
            "begin": "<",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.typeparameters.begin.ens" }
            },
            "end": ">|(?=$)",
            "endCaptures": {
                "0": { "name": "punctuation.definition.typeparameters.end.ens" }
            },
            "patterns": [
                { "include": "#type-reference" },
                {
                    "name": "punctuation.separator.comma.ens",
                    "match": ","
                },
                {
                    "name": "punctuation.separator.colon.ens",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.bounds.ens",
                    "match": "\\+"
                }
            ]
        },
        "types": {
            "patterns": [
                { "include": "#primitive-types" },
                {
                    "comment": "Capitalized identifier in type position. The array and optional suffixes stay outside the match so the operator and bracket rules still scope them.",
                    "match": "\\b([A-Z][\\w$]*)(?=(?:\\?|\\[\\])*\\s+[A-Za-z_$])",
                    "captures": {
                        "1": { "name": "entity.name.type.ens" }
                    }
                }
            ]
        },
        "function-call": {
            "comment": "Covers both a definition and a call: without a parse there is nothing to tell them apart, and both name a function",
            "patterns": [
                {
                    "match": "(?<![\\w$])([A-Za-z_$][\\w$]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.ens" }
                    }
                }
            ]
        },
        "operators": {
            "comment": "TextMate keeps the first pattern that matches at a position, not the longest one, so every multi-character operator has to be listed before its one-character prefixes",
            "patterns": [
                {
                    "name": "keyword.operator.ellipsis.ens",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.arrow.ens",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.assignment.ens",
                    "match": "(?:<<|>>>|>>|\\+|-|\\*|/|%|&|\\||\\^)="
                },
                {
                    "name": "keyword.operator.comparison.ens",
                    "match": "==|!=|<=|>="
                },
                {
                    "name": "keyword.operator.logical.ens",
                    "match": "&&|\\|\\|"
                },
                {
                    "name": "keyword.operator.bitwise.ens",
                    "match": "<<|>>>|>>"
                },
                {
                    "name": "keyword.operator.arithmetic.ens",
                    "match": "\\+\\+|--"
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?\\?|\\?\\."
                },
                {
                    "name": "keyword.operator.assignment.ens",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison.ens",
                    "match": "<|>"
                },
                {
                    "name": "keyword.operator.logical.ens",
                    "match": "!"
                },
                {
                    "name": "keyword.operator.arithmetic.ens",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.bitwise.ens",
                    "match": "&|\\||\\^|~"
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?"
                }
            ]
        },
        "brackets": {
            "patterns": [
                {
                    "name": "punctuation.section.parens.begin.ens",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.ens",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.braces.begin.ens",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.braces.end.ens",
                    "match": "\\}"
                },
                {
                    "name": "punctuation.section.brackets.begin.ens",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.brackets.end.ens",
                    "match": "\\]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.ens",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.ens",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.ens",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.colon.ens",
                    "match": ":"
                }
            ]
        }
    }
}
