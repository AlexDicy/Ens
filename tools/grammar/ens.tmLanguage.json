{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Ens",
    "scopeName": "source.ens",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#declarations" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ens",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.ens",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ens",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ens",
                            "match": "\\\\(?:[\\\\\"'nrtbf0]|u[0-9a-fA-F]{4})"
                        },
                        {
                            "name": "meta.template.expression.ens",
                            "begin": "(?<!\\\\)\\{",
                            "end": "\\}",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.ens",
                    "match": "'(?:\\\\(?:[\\\\\"'nrtbf0]|u[0-9a-fA-F]{4})|[^'\\\\])'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.ens",
                    "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]?\\b"
                },
                {
                    "name": "constant.numeric.binary.ens",
                    "match": "\\b0[bB][01][01_]*[lL]?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFdD]\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.float.ens",
                    "match": "\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.ens",
                    "match": "\\b\\d[\\d_]*[lL]?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ens",
                    "match": "\\b(?:if|else|while|for|do|return|break|continue|switch|case|default|try|catch|finally|throw|throws|rethrow)\\b"
                },
                {
                    "name": "keyword.other.import.ens",
                    "match": "\\b(?:import|from|package)\\b"
                },
                {
                    "name": "keyword.operator.new.ens",
                    "match": "\\bnew\\b"
                },
                {
                    "name": "storage.type.let.ens",
                    "match": "\\blet\\b"
                },
                {
                    "name": "keyword.other.ens",
                    "match": "\\b(?:assert|computed|enum|extends|external|goto|out|super|type)\\b"
                },
                {
                    "name": "storage.modifier.visibility.ens",
                    "match": "\\b(?:private|protected|public)\\b"
                },
                {
                    "name": "storage.modifier.ens",
                    "match": "\\b(?:static|final|const)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.ens",
                    "match": "\\b(?:true|false)\\b"
                },
                {
                    "name": "constant.language.null.ens",
                    "match": "\\bnull\\b"
                },
                {
                    "name": "variable.language.this.ens",
                    "match": "\\bthis\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.ens",
                    "match": "\\b(?:bool|byte|short|ushort|int|uint|long|ulong|float|double|decimal|char|string|void)\\b"
                },
                {
                    "comment": "Type name after `new`",
                    "match": "\\b(new)\\s+([A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "keyword.operator.new.ens" },
                        "2": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "Type name in struct/class declaration",
                    "match": "\\b(struct|class)\\s+([A-Za-z_$][\\w$]*)",
                    "captures": {
                        "1": { "name": "storage.type.ens" },
                        "2": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "Capitalized identifier in type position (custom types)",
                    "match": "\\b([A-Z][\\w$]*)\\??(?=\\s+[A-Za-z_$])",
                    "captures": {
                        "1": { "name": "entity.name.type.ens" }
                    }
                },
                {
                    "comment": "Capitalized identifier after `->`",
                    "match": "->\\s*([A-Z][\\w$]*)\\??",
                    "captures": {
                        "1": { "name": "entity.name.type.ens" }
                    }
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "Function/method definition: name(...) followed by -> or {",
                    "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\([^)]*\\)\\s*(?:->|\\{|;))",
                    "captures": {
                        "1": { "name": "entity.name.function.ens" }
                    }
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.ens" }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.ens",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.assignment.ens",
                    "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>>?)?="
                },
                {
                    "name": "keyword.operator.comparison.ens",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.ens",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.ens",
                    "match": "\\+\\+|--|\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.bitwise.ens",
                    "match": "&|\\||\\^|~|<<|>>>?"
                },
                {
                    "name": "keyword.operator.optional.ens",
                    "match": "\\?\\?|\\?\\.|\\?"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.ens",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.ens",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.ens",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.colon.ens",
                    "match": ":"
                }
            ]
        }
    }
}
