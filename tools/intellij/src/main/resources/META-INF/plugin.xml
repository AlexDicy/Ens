<idea-plugin>
    <id>ens.intellij</id>
    <name>Ens</name>
    <vendor>Ens</vendor>
    <description>Language support for Ens: TextMate syntax highlighting and ens-lsp integration.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="ens.intellij.EnsTextMateBundleProvider"/>
        <projectConfigurable parentId="language" id="ens.settings" displayName="Ens"
                             instance="ens.intellij.EnsSettingsConfigurable" nonDefaultProject="true"/>
        <notificationGroup id="Ens" displayType="BALLOON"/>
        <postStartupActivity implementation="ens.intellij.EnsBackgroundDocumentSaver"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="ens" name="Ens Language Server" factoryClass="ens.intellij.EnsLanguageServerFactory"/>
        <fileNamePatternMapping patterns="*.ens" serverId="ens" languageId="ens"/>
    </extensions>
</idea-plugin>
