// Accumulates text in a growable byte buffer so building a string piece by
// piece stays linear; `+` on immutable strings would copy the whole prefix
// on every append.
public class StringBuilder {
    private byte[] buffer;
    private long count;

    StringBuilder() {
        this.buffer = new byte[16];
        this.count = 0;
    }

    append(string value) {
        byte[] bytes = value.toBytes();
        this.ensureCapacity(this.count + bytes.length);
        for (long i = 0; i < bytes.length; i = i + 1) {
            this.buffer[this.count + i] = bytes[i];
        }
        this.count = this.count + bytes.length;
    }

    append(long value) {
        this.append(value.toString());
    }

    append(bool value) {
        this.append(value.toString());
    }

    length() -> long {
        return this.count;
    }

    toString() -> string {
        return string.fromBytes(this.buffer.slice(0, this.count));
    }

    private ensureCapacity(long needed) {
        if (needed <= this.buffer.length) {
            return;
        }
        long newCapacity = this.buffer.length * 2;
        while (newCapacity < needed) {
            newCapacity = newCapacity * 2;
        }
        byte[] grown = new byte[newCapacity];
        for (long i = 0; i < this.count; i = i + 1) {
            grown[i] = this.buffer[i];
        }
        this.buffer = grown;
    }
}
