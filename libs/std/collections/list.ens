import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;

// A growable, generic array. The backing store is a `T[]` that doubles when
// full; only the first `count` slots hold pushed values.
export class List<T> implements Iterable<T> {
    T[] items;
    long count;

    export constructor() {
        this.items = new T[4];
        this.count = 0;
    }

    export push(T value) {
        if (this.count == this.items.length) {
            this.grow();
        }
        this.items[this.count] = value;
        this.count = this.count + 1;
    }

    export pop() -> T {
        let value = this.items[this.count - 1];
        this.count = this.count - 1;
        return value;
    }

    export get(long index) -> T {
        return this.items[index];
    }

    export set(long index, T value) {
        this.items[index] = value;
    }

    export length() -> long {
        return this.count;
    }

    export toArray() -> T[] {
        T[] copied = new T[this.count];
        long index = 0;
        while (index < this.count) {
            copied[index] = this.items[index];
            index = index + 1;
        }
        return copied;
    }

    export override makeIterator() -> Iterator<T> {
        return new ListIterator<T>(this.items, this.count);
    }

    grow() {
        long newCap = this.items.length * 2;
        T[] newItems = new T[newCap];
        long i = 0;
        while (i < this.count) {
            newItems[i] = this.items[i];
            i = i + 1;
        }
        this.items = newItems;
    }
}

class ListIterator<T> implements Iterator<T> {
    T[] items;
    long count;
    long position;

    protected constructor(this.items, this.count) {
        this.position = 0;
    }

    override hasNext() -> bool {
        return this.position < this.count;
    }

    override next() -> T {
        let value = this.items[this.position];
        this.position = this.position + 1;
        return value;
    }
}
