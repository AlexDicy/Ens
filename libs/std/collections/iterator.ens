// The iteration contracts used by `for (item in collection)`. A class is
// iterable when it implements Iterable<T>; the loop calls makeIterator()
// once, then draws values with next() while hasNext() is true. Arrays are
// iterated directly without an iterator object.
export interface Iterator<T> {
    hasNext() -> bool;
    next() -> T;
}

export interface Iterable<T> {
    makeIterator() -> Iterator<T>;
}
