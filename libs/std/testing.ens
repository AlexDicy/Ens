export class TestFailure extends Error {
    export constructor(string message) { super(message); }
}

export assertEqual<T>(T actual, T expected) throws {
    if (actual == expected) { return; }
    throw new TestFailure("expected {expected}, got {actual}");
}

export assertNotEqual<T>(T actual, T expected) throws {
    if (actual != expected) { return; }
    throw new TestFailure("expected values to differ, both were {actual}");
}

export assertTrue(bool condition, string message = "expected condition to be true") throws {
    if (condition) { return; }
    throw new TestFailure(message);
}

export assertFalse(bool condition, string message = "expected condition to be false") throws {
    if (!condition) { return; }
    throw new TestFailure(message);
}

export noreturn fail(string message) throws {
    throw new TestFailure(message);
}
