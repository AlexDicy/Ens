public class TestFailure extends Error {
    constructor(string message) { super(message); }
}

public assertEqual<T>(T actual, T expected) throws {
    if (actual == expected) { return; }
    throw new TestFailure("expected {expected}, got {actual}");
}

public assertNotEqual<T>(T actual, T expected) throws {
    if (actual != expected) { return; }
    throw new TestFailure("expected values to differ, both were {actual}");
}

public assertTrue(bool condition, string message = "expected condition to be true") throws {
    if (condition) { return; }
    throw new TestFailure(message);
}

public assertFalse(bool condition, string message = "expected condition to be false") throws {
    if (!condition) { return; }
    throw new TestFailure(message);
}

public fail(string message) throws {
    throw new TestFailure(message);
}
