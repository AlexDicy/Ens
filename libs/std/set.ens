import Hashable from @std.hash;
import Iterable from @std.iterator;
import Iterator from @std.iterator;

// A hash set with open addressing and linear probing, sharing Map's slot
// layout: states are 0 = empty, 1 = occupied, 2 = removed. Items compare
// with '==' and hash with hash().
public class Set<T: Hashable> implements Iterable<T> {
    private T[] slotItems;
    private byte[] slotStates;
    private long count;
    private long capacity;

    Set() {
        this.capacity = 16;
        this.slotItems = new T[this.capacity];
        this.slotStates = new byte[this.capacity];
        this.count = 0;
    }

    add(T item) -> bool {
        if (this.findSlot(item) >= 0) {
            return false;
        }
        if ((this.count + 1) * 4 > this.capacity * 3) {
            this.resize();
        }
        long slot = this.freeSlot(item);
        this.slotItems[slot] = item;
        this.slotStates[slot] = 1;
        this.count = this.count + 1;
        return true;
    }

    contains(T item) -> bool {
        return this.findSlot(item) >= 0;
    }

    remove(T item) -> bool {
        long slot = this.findSlot(item);
        if (slot < 0) {
            return false;
        }
        this.slotStates[slot] = 2;
        this.count = this.count - 1;
        return true;
    }

    length() -> long {
        return this.count;
    }

    items() -> T[] {
        T[] result = new T[this.count];
        long written = 0;
        long slot = 0;
        while (slot < this.capacity) {
            if (this.slotStates[slot] == 1) {
                result[written] = this.slotItems[slot];
                written = written + 1;
            }
            slot = slot + 1;
        }
        return result;
    }

    makeIterator() -> Iterator<T> {
        return new SetIterator<T>(this.slotItems, this.slotStates, this.capacity);
    }

    private findSlot(T item) -> long {
        long slot = item.hash() & (this.capacity - 1);
        long probed = 0;
        while (probed < this.capacity) {
            if (this.slotStates[slot] == 0) {
                return -1;
            }
            if (this.slotStates[slot] == 1 && this.slotItems[slot] == item) {
                return slot;
            }
            slot = (slot + 1) & (this.capacity - 1);
            probed = probed + 1;
        }
        return -1;
    }

    private freeSlot(T item) -> long {
        long slot = item.hash() & (this.capacity - 1);
        while (this.slotStates[slot] == 1) {
            slot = (slot + 1) & (this.capacity - 1);
        }
        return slot;
    }

    private resize() {
        long oldCapacity = this.capacity;
        T[] oldItems = this.slotItems;
        byte[] oldStates = this.slotStates;

        this.capacity = this.capacity * 2;
        this.slotItems = new T[this.capacity];
        this.slotStates = new byte[this.capacity];

        long slot = 0;
        while (slot < oldCapacity) {
            if (oldStates[slot] == 1) {
                long target = oldItems[slot].hash() & (this.capacity - 1);
                while (this.slotStates[target] == 1) {
                    target = (target + 1) & (this.capacity - 1);
                }
                this.slotItems[target] = oldItems[slot];
                this.slotStates[target] = 1;
            }
            slot = slot + 1;
        }
    }
}

class SetIterator<T> implements Iterator<T> {
    private T[] slotItems;
    private byte[] slotStates;
    private long capacity;
    private long position;

    SetIterator(this.slotItems, this.slotStates, this.capacity) {
        this.position = 0;
        this.skipToOccupied();
    }

    hasNext() -> bool {
        return this.position < this.capacity;
    }

    next() -> T {
        T item = this.slotItems[this.position];
        this.position = this.position + 1;
        this.skipToOccupied();
        return item;
    }

    private skipToOccupied() {
        while (this.position < this.capacity && this.slotStates[this.position] != 1) {
            this.position = this.position + 1;
        }
    }
}
