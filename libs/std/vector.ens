import Iterable from @std.iterator;
import Iterator from @std.iterator;

// A growable, generic array. The backing store is a `T[]` that doubles when
// full; only the first `count` slots hold pushed values.
public class Vector<T> implements Iterable<T> {
    private T[] items;
    private long count;

    Vector() {
        this.items = new T[4];
        this.count = 0;
    }

    push(T value) {
        if (this.count == this.items.length) {
            this.grow();
        }
        this.items[this.count] = value;
        this.count = this.count + 1;
    }

    get(long index) -> T {
        return this.items[index];
    }

    set(long index, T value) {
        this.items[index] = value;
    }

    length() -> long {
        return this.count;
    }

    toArray() -> T[] {
        T[] copied = new T[this.count];
        long index = 0;
        while (index < this.count) {
            copied[index] = this.items[index];
            index = index + 1;
        }
        return copied;
    }

    override makeIterator() -> Iterator<T> {
        return new VectorIterator<T>(this.items, this.count);
    }

    private grow() {
        long newCap = this.items.length * 2;
        T[] newItems = new T[newCap];
        long i = 0;
        while (i < this.count) {
            newItems[i] = this.items[i];
            i = i + 1;
        }
        this.items = newItems;
    }
}

class VectorIterator<T> implements Iterator<T> {
    private T[] items;
    private long count;
    private long position;

    VectorIterator(this.items, this.count) {
        this.position = 0;
    }

    override hasNext() -> bool {
        return this.position < this.count;
    }

    override next() -> T {
        let value = this.items[this.position];
        this.position = this.position + 1;
        return value;
    }
}