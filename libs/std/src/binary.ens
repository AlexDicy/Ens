// What binary data can do. The compiler provides `length`, indexing, `slice(start, end)`, `==` and
// the one member declared here without a body; everything else is ordinary Ens over those. Nothing
// can change a `bytes` once it is made, so every member that builds data returns new data.

primitive bytes {
    // `bytes` holding the contents of `array`, copied, so later writes to the array leave it as
    // it is.
    export static of(byte[] array) -> bytes;

    export isEmpty() -> bool {
        return this.length == 0;
    }

    export contains(bytes needle) -> bool {
        return this.indexOf(needle) >= 0;
    }

    // The offset of the first occurrence of `needle`, or -1 when there is none. An empty needle is
    // found at offset 0.
    export indexOf(bytes needle) -> long {
        return this.indexOf(needle, 0);
    }

    // The offset of the first occurrence of `needle` at or after `from`, or -1 when there is none.
    // An offset before the data counts as 0, an empty needle is found wherever the search starts,
    // and an offset past the end finds nothing at all.
    export indexOf(bytes needle, long from) -> long {
        long start = from < 0 ? 0 : from;
        if (start + needle.length > this.length) {
            return -1;
        }
        for (long at = start; at + needle.length <= this.length; at++) {
            if (this.matchesAt(at, needle)) {
                return at;
            }
        }
        return -1;
    }

    // The offset of the last occurrence of `needle`, or -1 when there is none. An empty needle is
    // found at the end, since that is the last place it occurs.
    export lastIndexOf(bytes needle) -> long {
        for (long at = this.length - needle.length; at >= 0; at--) {
            if (this.matchesAt(at, needle)) {
                return at;
            }
        }
        return -1;
    }

    // Whether the data begins with exactly `prefix`. An empty prefix always matches, and a prefix
    // longer than the data never does.
    export startsWith(bytes prefix) -> bool {
        return prefix.length <= this.length && this.matchesAt(0, prefix);
    }

    // Whether the data ends with exactly `suffix`. An empty suffix always matches, and a suffix
    // longer than the data never does.
    export endsWith(bytes suffix) -> bool {
        return suffix.length <= this.length && this.matchesAt(this.length - suffix.length, suffix);
    }

    // The bytes from `start` to the end as new data. A start before 0 or past the end aborts the
    // program.
    export slice(long start) -> bytes {
        return this.slice(start, this.length);
    }

    // The bytes as a new `byte[]`, which can be changed without changing this data.
    export toArray() -> byte[] {
        byte[] copied = new byte[this.length];
        for (long i = 0; i < copied.length; i++) {
            copied[i] = this[i];
        }
        return copied;
    }

    matchesAt(long at, bytes part) -> bool {
        for (long i = 0; i < part.length; i++) {
            if (this[at + i] != part[i]) {
                return false;
            }
        }
        return true;
    }
}
