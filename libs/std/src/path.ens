// Working with file paths as plain text. Nothing here touches the file system: every function is
// a rule about the characters of a path, so the answers are the same whatever exists on disk.
// '/' separates the parts of a path, on every platform.
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

// `base` and `relative` with one separator between them. An empty base gives back the relative
// path on its own, and a base that already ends in a separator does not gain a second one.
export join(string base, string relative) -> string {
    if (base.length == 0) {
        return relative;
    }
    if (base.endsWith("/")) {
        return base + relative;
    }
    return base + "/" + relative;
}

// The folder one level up: "" when the path names no folder at all, and "/" at the root.
export parentFolder(string path) -> string {
    long index = lastSeparator(path);
    if (index < 0) {
        return "";
    }
    if (index == 0) {
        return "/";
    }
    return path.substring(0, index);
}

// The last part of the path, which is the file or folder the path names.
export fileName(string path) -> string {
    return path.substring(lastSeparator(path) + 1, path.length);
}

// The path with its '.' parts, its repeated separators, and every '..' that has a part to remove
// dropped. A relative path keeps the leading '..' parts it cannot resolve, and one that turns out
// to name nowhere in particular becomes ".".
export normalize(string path) -> string {
    bool absolute = path.startsWith("/");
    let kept = new List<string>();
    for (let part in parts(path)) {
        if (part.length == 0 || part == ".") {
            continue;
        }
        if (part == "..") {
            if (kept.length() > 0 && kept.get(kept.length() - 1) != "..") {
                kept.pop();
                continue;
            }
            if (absolute) {
                continue;
            }
        }
        kept.push(part);
    }
    let builder = new StringBuilder();
    if (absolute) {
        builder.append("/");
    }
    for (long i = 0; i < kept.length(); i++) {
        if (i > 0) {
            builder.append("/");
        }
        builder.append(kept.get(i));
    }
    if (builder.length() == 0) {
        return ".";
    }
    return builder.toString();
}

// The parts between the separators, empty ones included.
parts(string path) -> string[] {
    let found = new List<string>();
    string rest = path;
    while (true) {
        long index = rest.indexOf("/");
        if (index < 0) {
            found.push(rest);
            break;
        }
        found.push(rest.substring(0, index));
        rest = rest.substring(index + 1, rest.length);
    }
    return found.toArray();
}

lastSeparator(string path) -> long {
    byte[] bytes = path.toBytes();
    for (long i = bytes.length - 1; i >= 0; i--) {
        if (bytes[i] == '/') {
            return i;
        }
    }
    return -1;
}
