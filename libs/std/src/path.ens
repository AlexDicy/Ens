// Working with file paths as plain text, in the shape this module has always had. Every function
// here now answers through 'Path' from '@std.fs', so no two spellings of a rule can drift apart;
// the module itself is kept only until its callers have all moved.
import Path from @std.fs;
import Platform from @std.environment;

// `base` and `relative` with one separator between them. An empty base gives back the relative
// path on its own, a base that already ends in a separator does not gain a second one, and a
// relative path that names its own place is given back alone.
export join(string base, string relative) -> string {
    return Path(base).join(relative).toString();
}

// The folder one level up, and "" where the path writes none: at a root, and for a name with no
// folder written before it.
export parentFolder(string path) -> string {
    Path? above = Path(path).parent();
    if (above == null) {
        return "";
    }
    return above.toString();
}

// The last part of the path, which is the file or folder the path names, and "" at a root.
export fileName(string path) -> string {
    return Path(path).fileName();
}

// The extension of the file the path names: the text after the last '.' of its name, without the
// dot. A name with no '.' has none, and neither has one whose only '.' starts it, the way a hidden
// file is named.
export extension(string path) -> string {
    return Path(path).extension();
}

// The name of the file the path names without its extension: "notes" for "notes.txt", and the
// whole name when there is no extension to drop.
export stem(string path) -> string {
    return Path(path).stem();
}

// True when the path names a place on its own, with no folder needed to read it against: one
// starting at a root, at a drive letter with a separator after it, or at a server share.
export isAbsolute(string path) -> bool {
    return Path(path).isAbsolute();
}

// `path` read against `workingDirectory` and normalized, so a relative path becomes the absolute
// one it names from there and an absolute path is only normalized. The folder to read against is
// given rather than looked up, which is what keeps this module a set of rules about text.
export absolute(string path, string workingDirectory) -> string {
    return Path(path).absolute(Path(workingDirectory)).toString();
}

// The path with its '.' parts, its repeated separators, and every '..' that has a part to remove
// dropped. A relative path keeps the leading '..' parts it cannot resolve, and one that turns out
// to name nowhere in particular becomes ".".
export normalize(string path) -> string {
    return Path(path).normalize().toString();
}

// `text` as a path in the form every function here reads, the conversion at the boundary where
// text from the operating system or a command line arrives. Windows writes '\' between the parts,
// so those become '/', and every other platform gives the text back as it came, because '\' is an
// ordinary character in a name there. The platform is named by the caller, not read here.
export fromNative(string text, string platform) -> string {
    return Path.fromNative(text, named(platform)).toString();
}

// The Platform a name stands for. Every name but "windows" reads as Linux, whose rule for the
// characters of a path every other system shares.
named(string platform) -> Platform {
    if (platform == "windows") {
        return Platform.Windows;
    }
    return Platform.Linux;
}
