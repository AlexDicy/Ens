// Working with file paths as plain text. Nothing here touches the file system: every function is
// a rule about the characters of a path, so the answers are the same whatever exists on disk.
// '/' separates the parts of a path, on every platform.
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

// `base` and `relative` with one separator between them. An empty base gives back the relative
// path on its own, and a base that already ends in a separator does not gain a second one.
export join(string base, string relative) -> string {
    if (base.length == 0) {
        return relative;
    }
    if (base.endsWith("/")) {
        return base + relative;
    }
    return base + "/" + relative;
}

// The folder one level up: "" when the path names no folder at all, and "/" at the root.
export parentFolder(string path) -> string {
    long index = lastSeparator(path);
    if (index < 0) {
        return "";
    }
    if (index == 0) {
        return "/";
    }
    return path.substring(0, index);
}

// The last part of the path, which is the file or folder the path names.
export fileName(string path) -> string {
    return path.substring(lastSeparator(path) + 1, path.length);
}

// The extension of the file the path names: the text after the last '.' of its name, without the
// dot. A name with no '.' has none, and neither has one whose only '.' starts it, the way a hidden
// file is named.
export extension(string path) -> string {
    string name = fileName(path);
    long dot = lastDot(name);
    if (dot <= 0) {
        return "";
    }
    return name.substring(dot + 1, name.length);
}

// The name of the file the path names without its extension: "notes" for "notes.txt", and the whole
// name when there is no extension to drop.
export stem(string path) -> string {
    string name = fileName(path);
    long dot = lastDot(name);
    if (dot <= 0) {
        return name;
    }
    return name.substring(0, dot);
}

// True when the path names a place on its own, with no folder needed to read it against: one
// starting at a root, or at a drive letter the way Windows writes one.
export isAbsolute(string path) -> bool {
    if (path.startsWith("/")) {
        return true;
    }
    return path.length >= 2 && startsWithDriveLetter(path) && path.substring(1, 2) == ":";
}

// `path` read against `workingDirectory` and normalized, so a relative path becomes the absolute one
// it names from there and an absolute path is only normalized. The folder to read against is given
// rather than looked up, which is what keeps this module a set of rules about text.
export absolute(string path, string workingDirectory) -> string {
    if (isAbsolute(path)) {
        return normalize(path);
    }
    return normalize(join(workingDirectory, path));
}

// The path with its '.' parts, its repeated separators, and every '..' that has a part to remove
// dropped. A relative path keeps the leading '..' parts it cannot resolve, and one that turns out
// to name nowhere in particular becomes ".".
export normalize(string path) -> string {
    bool absolute = path.startsWith("/");
    let kept = new List<string>();
    for (let part in parts(path)) {
        if (part.length == 0 || part == ".") {
            continue;
        }
        if (part == "..") {
            if (kept.length() > 0 && kept.get(kept.length() - 1) != "..") {
                kept.pop();
                continue;
            }
            if (absolute) {
                continue;
            }
        }
        kept.push(part);
    }
    let builder = new StringBuilder();
    if (absolute) {
        builder.append("/");
    }
    for (long i = 0; i < kept.length(); i++) {
        if (i > 0) {
            builder.append("/");
        }
        builder.append(kept.get(i));
    }
    if (builder.length() == 0) {
        return ".";
    }
    return builder.toString();
}

// The parts between the separators, empty ones included.
parts(string path) -> string[] {
    let found = new List<string>();
    string rest = path;
    while (true) {
        long index = rest.indexOf("/");
        if (index < 0) {
            found.push(rest);
            break;
        }
        found.push(rest.substring(0, index));
        rest = rest.substring(index + 1, rest.length);
    }
    return found.toArray();
}

lastDot(string name) -> long {
    byte[] raw = name.toBytes();
    for (long i = raw.length - 1; i >= 0; i--) {
        if (raw[i] == '.') {
            return i;
        }
    }
    return -1;
}

startsWithDriveLetter(string path) -> bool {
    byte[] raw = path.toBytes();
    return (raw[0] >= 'a' && raw[0] <= 'z') || (raw[0] >= 'A' && raw[0] <= 'Z');
}

lastSeparator(string path) -> long {
    byte[] bytes = path.toBytes();
    for (long i = bytes.length - 1; i >= 0; i--) {
        if (bytes[i] == '/') {
            return i;
        }
    }
    return -1;
}
