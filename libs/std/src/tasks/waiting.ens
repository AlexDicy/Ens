// How a task waits for another to wake it. A waiter stands in a list for one wait, and waking it
// once is all it takes: a second wake, from a deadline or a cancel that lost the race, does
// nothing. A task on a context parks, leaving its worker to run others, and is queued to run again
// when woken; a thread without a context, the program's main thread, a dedicated task's or one a
// library made, sleeps on a lock of its own. Deadlines for parked tasks, and waits for a stream or a
// child, are kept by one thread that waits on the readiness poller until the nearest deadline.
import Atomic from @std.tasks;
import TaskControl from @std.tasks;
import Deque from @std.collections.deque;
import List from @std.collections.list;
import Map from @std.collections.map;
import Poller from @std.system;
import ThreadLock from @std.system;
import @std.system;

export shared final class Waiter {
    const Atomic<bool> woken;
    protected long queued;
    const TaskControl? task;
    const ThreadLock? bed;

    // A waiter for `task` when it runs on a context, and for the calling thread otherwise.
    public constructor(TaskControl? task) {
        this.woken = new Atomic<bool>(false);
        this.queued = Queued.no;
        ThreadLock? bed = null;
        if (task == null) {
            bed = system.createLock();
        }
        this.task = task;
        this.bed = bed;
    }

    // Wakes the waiter, and returns whether this call was the one that did; later calls do
    // nothing.
    public wake() -> bool {
        if (!this.woken.compareAndSet(false, true)) {
            return false;
        }
        let task = this.task;
        if (task != null) {
            task.unpark();
            return true;
        }
        let bed = this.bed;
        if (bed != null) {
            system.acquireLock(bed);
            system.wakeLockWaiters(bed);
            system.releaseLock(bed);
        }
        return true;
    }

    public isWoken() -> bool {
        return this.woken.read();
    }

    // Waits until woken, or until `deadline` on the monotonic clock has passed when it is not
    // negative. A task parks; a thread sleeps.
    public await(long deadline) {
        let task = this.task;
        if (task != null) {
            if (deadline >= 0) {
                Clockwork.events.wakeAt(deadline, this);
            }
            task.park();
            return;
        }
        let bed = this.bed;
        if (bed == null) {
            return;
        }
        system.acquireLock(bed);
        while (!this.woken.read()) {
            long left = -1;
            if (deadline >= 0) {
                left = deadline - system.monotonicMillis();
                if (left <= 0) {
                    break;
                }
            }
            system.waitOnLock(bed, left);
        }
        system.releaseLock(bed);
    }

    destructor() {
        let bed = this.bed;
        if (bed != null) {
            system.destroyLock(bed);
        }
    }
}

// Where a waiter stands in its wait list: out of it, waiting in it, or still in it after its wait
// ended some other way, to be passed over and swept out.
final class Queued {
    protected static const long no = 0;
    protected static const long waiting = 1;
    protected static const long abandoned = 2;
}

// The waiters of one condition, in the order they arrived, guarded by the lock of the monitor they
// wait under. A waiter whose wait ends by a deadline or a cancel stays where it stands until it
// reaches the front or the abandoned ones are half the list, so leaving costs the same as waking.
export shared final class WaitList {
    Deque<Waiter> waiters;
    long abandoned;

    public constructor() {
        this.waiters = new Deque<Waiter>();
        this.abandoned = 0;
    }

    public add(Waiter waiter) {
        waiter.queued = Queued.waiting;
        this.waiters.pushBack(waiter);
    }

    public remove(Waiter waiter) {
        if (waiter.queued != Queued.waiting) {
            return;
        }
        waiter.queued = Queued.abandoned;
        this.abandoned = this.abandoned + 1;
        if (this.abandoned * 2 > this.waiters.length()) {
            this.sweep();
        }
    }

    // Wakes the waiter that has waited longest and is not woken already.
    public wakeOne() {
        while (!this.waiters.isEmpty()) {
            let waiter = this.waiters.popFront();
            if (this.leave(waiter) && waiter.wake()) {
                return;
            }
        }
    }

    public wakeAll() {
        let waiting = this.waiters;
        this.waiters = new Deque<Waiter>();
        for (let waiter in waiting) {
            if (this.leave(waiter)) {
                let woke = waiter.wake();
            }
        }
    }

    // Takes `waiter` out of the list's count, and returns whether it was still waiting.
    leave(Waiter waiter) -> bool {
        if (waiter.queued == Queued.abandoned) {
            this.abandoned = this.abandoned - 1;
            waiter.queued = Queued.no;
            return false;
        }
        waiter.queued = Queued.no;
        return true;
    }

    sweep() {
        let kept = new Deque<Waiter>();
        for (let waiter in this.waiters) {
            if (waiter.queued == Queued.waiting) {
                kept.pushBack(waiter);
            } else {
                waiter.queued = Queued.no;
            }
        }
        this.waiters = kept;
        this.abandoned = 0;
    }
}

// The events thread, made the first time a parked task waits with a deadline or for a stream.
public final class Clockwork {
    public lazy const Events events = new Events();
}

// Deadlines in order, the waiters and actions of watched streams and children by the token each
// was watched under, and the thread that waits on the poller until the nearest deadline, then wakes
// the waiters of the deadlines that passed and of the tokens that fired, and runs the actions that
// were due.
export shared final class Events {
    const ThreadLock lock;
    public const Poller poller;
    List<Timer> heap;
    Map<long, Waiter> watched;
    Map<long, (shared () -> void)> actions;
    long lastToken;

    protected constructor() {
        this.lock = system.createLock();
        this.poller = system.createPoller();
        this.heap = new List<Timer>();
        this.watched = new Map<long, Waiter>();
        this.actions = new Map<long, (shared () -> void)>();
        this.lastToken = 0;
        let thread = system.startThread(() -> this.run());
    }

    // Wakes `waiter` once `deadline` on the monotonic clock has passed.
    public wakeAt(long deadline, Waiter waiter) {
        this.schedule(new Timer(deadline, waiter, null));
    }

    // Runs `action` on the events thread once `deadline` has passed; it must not wait.
    public runAt(long deadline, (shared () -> void) action) {
        this.schedule(new Timer(deadline, null, action));
    }

    // A token no other watch holds, which wakes `waiter` when the poller returns it.
    public enlist(Waiter waiter) -> long {
        system.acquireLock(this.lock);
        long token = this.nextToken();
        this.watched.set(token, waiter);
        system.releaseLock(this.lock);
        return token;
    }

    // A token no other watch holds, which runs `action` on the events thread when the poller
    // returns it; the action must not wait.
    public enlistAction((shared () -> void) action) -> long {
        system.acquireLock(this.lock);
        long token = this.nextToken();
        this.actions.set(token, action);
        system.releaseLock(this.lock);
        return token;
    }

    // Forgets the token, so the poller returning it later wakes and runs nothing.
    public discharge(long token) {
        system.acquireLock(this.lock);
        let removedWaiter = this.watched.remove(token);
        let removedAction = this.actions.remove(token);
        system.releaseLock(this.lock);
    }

    nextToken() -> long {
        this.lastToken = this.lastToken + 1;
        return this.lastToken;
    }

    schedule(Timer timer) {
        system.acquireLock(this.lock);
        this.heap.push(timer);
        this.siftUp(this.heap.length() - 1);
        bool nearest = this.heap.get(0) == timer;
        system.releaseLock(this.lock);
        if (nearest) {
            system.wakePoller(this.poller);
        }
    }

    run() {
        long[] tokens = new long[64];
        while (true) {
            long got = system.waitOnPoller(this.poller, tokens, this.untilNearest());
            let woken = new List<Waiter>();
            let fired = new List<(shared () -> void)>();
            system.acquireLock(this.lock);
            for (long i = 0; i < got; i++) {
                Waiter? waiter = this.watched.get(tokens[i]);
                if (waiter != null) {
                    let removed = this.watched.remove(tokens[i]);
                    woken.push(waiter);
                }
                (shared () -> void)? action = this.actions.get(tokens[i]);
                if (action != null) {
                    let removed = this.actions.remove(tokens[i]);
                    fired.push(action);
                }
            }
            let due = this.takeDue();
            system.releaseLock(this.lock);
            for (let waiter in woken) {
                let woke = waiter.wake();
            }
            for (let action in fired) {
                action();
            }
            for (let timer in due) {
                timer.fire();
            }
        }
    }

    // How long the poller may wait before the nearest deadline, or -1 with none.
    untilNearest() -> long {
        system.acquireLock(this.lock);
        long left = -1;
        if (!this.heap.isEmpty()) {
            left = this.heap.get(0).deadline - system.monotonicMillis();
            if (left < 0) {
                left = 0;
            }
        }
        system.releaseLock(this.lock);
        return left;
    }

    // The timers whose deadlines have passed, taken off the heap.
    takeDue() -> List<Timer> {
        let due = new List<Timer>();
        long now = system.monotonicMillis();
        while (!this.heap.isEmpty() && this.heap.get(0).deadline <= now) {
            due.push(this.heap.get(0));
            this.popTop();
        }
        return due;
    }

    popTop() {
        let last = this.heap.pop();
        if (!this.heap.isEmpty()) {
            this.heap.set(0, last);
            this.siftDown(0);
        }
    }

    siftUp(long index) {
        long at = index;
        while (at > 0) {
            long parent = (at - 1) / 2;
            if (this.heap.get(parent).deadline <= this.heap.get(at).deadline) {
                return;
            }
            this.swap(parent, at);
            at = parent;
        }
    }

    siftDown(long index) {
        long at = index;
        long length = this.heap.length();
        while (true) {
            long left = at * 2 + 1;
            long right = left + 1;
            long smallest = at;
            if (left < length && this.heap.get(left).deadline < this.heap.get(smallest).deadline) {
                smallest = left;
            }
            if (right < length
                    && this.heap.get(right).deadline < this.heap.get(smallest).deadline) {
                smallest = right;
            }
            if (smallest == at) {
                return;
            }
            this.swap(at, smallest);
            at = smallest;
        }
    }

    swap(long first, long second) {
        let held = this.heap.get(first);
        this.heap.set(first, this.heap.get(second));
        this.heap.set(second, held);
    }
}

shared final class Timer {
    const long deadline;
    const Waiter? waiter;
    const (shared () -> void)? action;

    protected constructor(this.deadline, this.waiter, this.action);

    protected fire() {
        let waiter = this.waiter;
        if (waiter != null) {
            let woke = waiter.wake();
        }
        let action = this.action;
        if (action != null) {
            action();
        }
    }
}
