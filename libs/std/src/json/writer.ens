// Writing `Json` values as text. The one-line form matches how a struct prints, so a value and a
// struct with the same fields print the same text.
import Json from @std.json;
import JsonArray from @std.json;
import JsonBool from @std.json;
import JsonNull from @std.json;
import JsonNumber from @std.json;
import JsonObject from @std.json;
import JsonString from @std.json;
import StringBuilder from @std.text.stringbuilder;

// One line, with ", " between items and ": " after a key.
public compact(Json value) -> string {
    let out = new StringBuilder();
    write(out, value, null, 0);
    return out.toString();
}

// Several lines, one item per line, one `indent` per nesting level, and an empty array or object
// as "[]" or "{}".
public indented(Json value, string indent) -> string {
    let out = new StringBuilder();
    write(out, value, indent, 0);
    return out.toString();
}

write(StringBuilder out, Json value, string? indent, long depth) {
    switch (value) {
        is JsonNull -> {
            out.append("null");
        },
        is JsonBool flag -> {
            out.append(flag.value);
        },
        is JsonNumber number -> {
            out.append(number.text);
        },
        is JsonString text -> {
            quote(out, text.value);
        },
        is JsonArray array -> {
            writeArray(out, array, indent, depth);
        },
        is JsonObject object -> {
            writeObject(out, object, indent, depth);
        },
    }
}

writeArray(StringBuilder out, JsonArray array, string? indent, long depth) {
    out.append("[");
    bool first = true;
    for (let element in array) {
        separate(out, first, indent, depth + 1);
        first = false;
        write(out, element, indent, depth + 1);
    }
    if (!first) {
        breakLine(out, indent, depth);
    }
    out.append("]");
}

writeObject(StringBuilder out, JsonObject object, string? indent, long depth) {
    out.append("\{");
    bool first = true;
    for (let member in object) {
        separate(out, first, indent, depth + 1);
        first = false;
        quote(out, member.key);
        out.append(": ");
        write(out, member.value, indent, depth + 1);
    }
    if (!first) {
        breakLine(out, indent, depth);
    }
    out.append("\}");
}

// What goes before an item: a comma after the previous one, then a line break with indentation
// or, on one line, a space.
separate(StringBuilder out, bool first, string? indent, long depth) {
    if (!first) {
        out.append(",");
    }
    if (indent == null) {
        if (!first) {
            out.append(" ");
        }
        return;
    }
    breakLine(out, indent, depth);
}

breakLine(StringBuilder out, string? indent, long depth) {
    if (indent == null) {
        return;
    }
    out.append("\n");
    for (long level = 0; level < depth; level++) {
        out.append(indent);
    }
}

// The text in double quotes, escaped the way a struct's text form is: '"' and '\' with a
// backslash, the five named control characters by letter, other control characters as '\u00xx'.
public quote(StringBuilder out, string text) {
    out.append("\"");
    long runStart = 0;
    for (long i = 0; i < text.length; i++) {
        byte current = text.byteAt(i);
        string? escaped = escapeOf(current);
        if (escaped == null) {
            continue;
        }
        out.append(text.substring(runStart, i));
        out.append(escaped);
        runStart = i + 1;
    }
    out.append(text.substring(runStart));
    out.append("\"");
}

// The escape for a byte inside a JSON string, or null when it is written as is.
escapeOf(byte value) -> string? {
    if (value == '"') {
        return "\\\"";
    }
    if (value == '\\') {
        return "\\\\";
    }
    if (value == '\b') {
        return "\\b";
    }
    if (value == '\t') {
        return "\\t";
    }
    if (value == '\n') {
        return "\\n";
    }
    if (value == '\f') {
        return "\\f";
    }
    if (value == '\r') {
        return "\\r";
    }
    if (value < 0x20) {
        return "\\u00" + hexDigit(value / 16) + hexDigit(value % 16);
    }
    return null;
}

hexDigit(long value) -> string {
    return "0123456789abcdef".substring(value, value + 1);
}
