import StringBuilder from @std.text.stringbuilder;

external type CFile;

// The compiler defines the five 'ens_' bridges wherever they are referenced. The process bridge
// takes the arguments twice over: a POSIX target builds an argument vector out of the NUL
// separated block, and a Windows target passes the joined command line on, because one string is
// the only shape Win32 accepts. Building both here keeps the quoting rules in Ens instead of in
// two code generators.
external from libc {
    fopen(string path, string mode) -> CFile?;
    fread(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    ferror(CFile stream) -> int;
    feof(CFile stream) -> int;
    fclose(CFile stream) -> int;
    getenv(string name) -> string?;
    ens_run_process(string command) -> int;
    ens_run_process_captured(string program, byte[] argumentBlock, long count,
                             string commandLine, string stdoutPath, string stderrPath) -> long;
    ens_path_exists(string path) -> int;
    ens_write_error(string message);
    exit(int code);
    ens_arguments() -> string[];
}

export class SystemError extends Error {
    export constructor(string m) { super(m); }
}

export final class File {
    CFile handle;

    protected constructor(this.handle);

    export read(byte[] buffer) -> ulong throws {
        let count = fread(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file read failed");
        }
        return count;
    }

    export write(byte[] buffer) -> ulong throws {
        let count = fwrite(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file write failed");
        }
        return count;
    }

    export close() -> int {
        return fclose(this.handle);
    }
}

export openFile(string path, string mode) -> File throws {
    CFile? handle = fopen(path, mode);
    if (handle == null) {
        throw new SystemError("could not open file");
    }
    return new File(handle);
}

// Reports whether a file or directory exists at `path`, without throwing.
export exists(string path) -> bool {
    return ens_path_exists(path) == 0;
}

export readAllBytes(string path) -> byte[] throws {
    CFile? handle = fopen(path, "rb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    byte[] content = new byte[4096];
    long total = 0;
    byte[] chunk = new byte[4096];
    while (feof(handle) == 0) {
        long count = fread(chunk, 1, chunk.length as ulong, handle) as long;
        if (ferror(handle) != 0) {
            let closed = fclose(handle);
            throw new SystemError("could not read file '{path}'");
        }
        if (total + count > content.length) {
            long capacity = content.length * 2;
            while (capacity < total + count) {
                capacity = capacity * 2;
            }
            byte[] grown = new byte[capacity];
            for (long i = 0; i < total; i = i + 1) {
                grown[i] = content[i];
            }
            content = grown;
        }
        for (long i = 0; i < count; i = i + 1) {
            content[total + i] = chunk[i];
        }
        total = total + count;
    }
    let closed = fclose(handle);
    return content.slice(0, total);
}

export readAllText(string path) -> string throws {
    return string.fromBytes(try readAllBytes(path));
}

export writeAllBytes(string path, byte[] content) throws {
    CFile? handle = fopen(path, "wb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    let written = fwrite(content, 1, content.length as ulong, handle);
    if (written != content.length as ulong) {
        let closed = fclose(handle);
        throw new SystemError("could not write file '{path}'");
    }
    if (fclose(handle) != 0) {
        throw new SystemError("could not write file '{path}'");
    }
}

export writeAllText(string path, string content) throws {
    try writeAllBytes(path, content.toBytes());
}

// Writes `message` and a newline to standard error, the stream a program reports its problems on,
// the way 'print' writes to standard output.
export writeError(string message) {
    ens_write_error(message);
}

export run(string command) -> int throws {
    let status = ens_run_process(command);
    if (status == -1) {
        throw new SystemError("could not run command");
    }
    return status;
}

// Runs `program` with `arguments`, waits for it to finish, and writes everything it sent to its
// standard output and standard error into the two files. No shell takes part, so an argument
// reaches the program exactly as written here, spaces, quotes and all. Returns the program's exit
// code, or 127 when it could not be started.
export runCaptured(string program, string[] arguments, string stdoutPath,
                   string stderrPath) -> int throws {
    long status = ens_run_process_captured(program, argumentBlock(arguments), arguments.length,
        commandLineOf(program, arguments), stdoutPath, stderrPath);
    if (status < 0) {
        throw new SystemError("could not capture the output of '{program}' into "
            + "'{stdoutPath}' and '{stderrPath}'");
    }
    return status as int;
}

// Every argument's bytes with a NUL after each of them, which is the block a C argument vector
// points into. An argument holding a NUL byte cannot cross into a C string and is cut there.
argumentBlock(string[] arguments) -> byte[] {
    long total = 0;
    for (long i = 0; i < arguments.length; i++) {
        total = total + arguments[i].length + 1;
    }
    byte[] block = new byte[total];
    long at = 0;
    for (long i = 0; i < arguments.length; i++) {
        byte[] raw = arguments[i].toBytes();
        for (long b = 0; b < raw.length; b++) {
            block[at] = raw[b];
            at = at + 1;
        }
        block[at] = 0;
        at = at + 1;
    }
    return block;
}

// The program and its arguments as one command line, each part quoted so that a program started
// with it splits the parts back into exactly these values. This is the form Win32 takes; a POSIX
// target runs the argument vector instead and never reads it.
commandLineOf(string program, string[] arguments) -> string {
    let line = new StringBuilder();
    line.append(quoted(program));
    for (long i = 0; i < arguments.length; i++) {
        line.append(" ");
        line.append(quoted(arguments[i]));
    }
    return line.toString();
}

// One part in double quotes. A backslash is literal except where it would escape the closing
// quote, so a run of backslashes before a quote or at the very end is doubled.
quoted(string value) -> string {
    let part = new StringBuilder();
    part.appendByte('"');
    byte[] raw = value.toBytes();
    long backslashes = 0;
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '\\') {
            backslashes = backslashes + 1;
            continue;
        }
        if (raw[i] == '"') {
            appendBackslashes(part, backslashes * 2 + 1);
        } else {
            appendBackslashes(part, backslashes);
        }
        part.appendByte(raw[i]);
        backslashes = 0;
    }
    appendBackslashes(part, backslashes * 2);
    part.appendByte('"');
    return part.toString();
}

appendBackslashes(StringBuilder part, long count) {
    for (long i = 0; i < count; i++) {
        part.appendByte('\\');
    }
}

export getEnvironmentVariable(string name) -> string? {
    return getenv(name);
}

export arguments() -> string[] {
    return ens_arguments();
}
