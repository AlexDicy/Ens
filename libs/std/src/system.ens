import List from @std.collections.list;
import @std.collections.sorting;
import @std.path;
import @std.process;
import LineBuffer from @std.text.lines;

external type CFile;
external type ChildHandle;

// The compiler defines the 'ens_' bridges wherever they are referenced. The two bridges that start a
// program take the arguments twice over: a POSIX target builds an argument vector out of the NUL
// separated block, and a Windows target passes the joined command line on, because one string is the
// only shape Win32 accepts. Building both here keeps the quoting rules in Ens instead of in two code
// generators.
external from libc {
    fopen(string path, string mode) -> CFile?;
    fread(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    ferror(CFile stream) -> int;
    feof(CFile stream) -> int;
    fclose(CFile stream) -> int;
    fflush(CFile? stream) -> int;
    getenv(string name) -> string?;
    getcwd(byte[] buffer, int size) -> string?;
    remove(string path) -> int;
    rmdir(string path) -> int;
    rename(string path, string newPath) -> int;
    ens_run_process(string command) -> int;
    ens_spawn_process(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes, string stdoutPath, string stderrPath) -> long;
    ens_start_process(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes) -> ChildHandle?;
    ens_read_child(ChildHandle child, byte[] buffer, long capacity) -> long;
    ens_poll_child(ChildHandle child, long milliseconds) -> int;
    ens_kill_child(ChildHandle child) -> int;
    ens_wait_child(ChildHandle child) -> long;
    ens_release_child(ChildHandle child);
    ens_path_kind(string path) -> int;
    ens_list_directory(string folder) -> string[]?;
    ens_create_directory(string path) -> int;
    ens_executable_path(byte[] buffer, long capacity) -> long;
    ens_environment() -> string[];
    ens_platform() -> int;
    ens_write_error(string message);
    exit(int code);
    ens_arguments() -> string[];
}

export class SystemError extends Error {
    export constructor(string m) { super(m); }
}

export final class File {
    CFile handle;

    protected constructor(this.handle);

    export read(byte[] buffer) -> ulong throws {
        let count = fread(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file read failed");
        }
        return count;
    }

    export write(byte[] buffer) -> ulong throws {
        let count = fwrite(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file write failed");
        }
        return count;
    }

    export close() -> int {
        return fclose(this.handle);
    }
}

export openFile(string path, string mode) -> File throws {
    CFile? handle = fopen(path, mode);
    if (handle == null) {
        throw new SystemError("could not open file");
    }
    return new File(handle);
}

// Reports whether a file or directory exists at `path`, without throwing.
export exists(string path) -> bool {
    return ens_path_kind(path) != 0;
}

// Reports whether `path` names a file rather than a directory. A missing path reports false, so
// this never throws.
export isFile(string path) -> bool {
    return ens_path_kind(path) == 1;
}

export isDirectory(string path) -> bool {
    return ens_path_kind(path) == 2;
}

// The names of everything directly inside `folder`, without '.' and '..' and without the folder in
// front of them, in ascending order by their bytes so a walk over a tree visits the same names in
// the same order however the file system enumerates them.
export listDirectory(string folder) -> string[] throws {
    string[]? found = ens_list_directory(folder);
    if (found == null) {
        throw new SystemError("could not read the folder '{folder}'");
    }
    let names = new List<string>();
    for (let name in found) {
        names.push(name);
    }
    sorting.sort(names);
    return names.toArray();
}

// Creates the directory `path` names, and every parent of it that is missing. A path that is
// already a directory is left alone.
export createDirectory(string path) throws {
    if (path.length == 0) {
        throw new SystemError("could not create a folder: no path was given");
    }
    createParents(path);
    createLevel(path);
    if (ens_path_kind(path) != 2) {
        throw new SystemError("could not create the folder '{path}'");
    }
}

// Creates the directory `path` names and answers whether this call is the one that created it: true
// when it did, false when a directory was already there. Every missing parent above it is created the
// way 'createDirectory' creates them, and only the directory `path` itself names is claimed, so two
// programs asking for the same name at the same instant get different answers and exactly one of them
// may treat the folder as its own.
export createNewDirectory(string path) -> bool throws {
    if (path.length == 0) {
        throw new SystemError("could not create a folder: no path was given");
    }
    createParents(path);
    int outcome = ens_create_directory(path);
    if (outcome == 0) {
        return true;
    }
    if (outcome == 1) {
        if (ens_path_kind(path) != 2) {
            throw new SystemError("could not create the folder '{path}': a file of that name is "
                + "already there. Remove it, or ask for a folder under another name");
        }
        return false;
    }
    throw new SystemError("could not create the folder '{path}'");
}

// Every level above `path` that is missing. A parent that is already there is left alone, and one
// that could not be created is left to the call that needs it to report.
createParents(string path) {
    byte[] raw = path.toBytes();
    for (long i = 1; i < raw.length; i++) {
        if (raw[i] == '/') {
            createLevel(path.substring(0, i));
        }
    }
}

// Creates one level of a path when nothing is there yet. A root - a lone '/', a drive letter, or
// the start of a network share - is left alone, because no call creates one.
createLevel(string level) {
    if (level.length == 0 || level == "/" || driveRoot(level)) {
        return;
    }
    if (ens_path_kind(level) == 2) {
        return;
    }
    let created = ens_create_directory(level);
}

driveRoot(string level) -> bool {
    return level.length == 2 && level.endsWith(":");
}

// Removes the file `path` names. A directory is refused, because removing one is
// 'removeDirectory'.
export removeFile(string path) throws {
    if (ens_path_kind(path) == 2) {
        throw new SystemError("could not remove the file '{path}': it is a folder, so remove it "
            + "with removeDirectory");
    }
    if (remove(path) != 0) {
        throw new SystemError("could not remove the file '{path}'");
    }
}

// Removes the directory `path` names, which has to be empty already: removing what is inside it
// first is the caller's to decide.
export removeDirectory(string path) throws {
    if (rmdir(path) != 0) {
        throw new SystemError("could not remove the folder '{path}'");
    }
}

// Moves the file or folder `from` names to `to` and answers whether this call is the one that moved
// it: true when it did, and false when something was already at `to`. The move happens in one step,
// so no other program ever sees half of it and two programs racing for the same name get different
// answers; that is also why both paths have to be on the same volume, since a move across volumes
// would have to copy. A move that failed for any other reason raises a `SystemError`.
export move(string from, string to) -> bool throws {
    if (ens_path_kind(to) != 0) {
        return false;
    }
    if (rename(from, to) == 0) {
        return true;
    }
    if (ens_path_kind(to) != 0) {
        return false;
    }
    throw new SystemError("could not move '{from}' to '{to}'");
}

// The directory the program was started in, with '/' between its parts, or "." when the operating
// system would not report it. It is read, never written: a program that wants to work somewhere
// else joins that folder onto the paths it uses.
export currentDirectory() -> string {
    long capacity = 4096;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        string? folder = getcwd(buffer, capacity as int);
        if (folder != null) {
            return path.fromNative(folder, platform());
        }
        capacity = capacity * 8;
    }
    return ".";
}

// The path of the running program itself, with '/' between its parts, or "" when the operating
// system would not report it.
export executablePath() -> string {
    long capacity = 4096;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        long written = ens_executable_path(buffer, capacity);
        if (written > 0) {
            return path.fromNative(string.fromBytes(buffer.slice(0, written)), platform());
        }
        capacity = capacity * 8;
    }
    return "";
}

// The environment this process inherited, as 'NAME=VALUE' entries in ascending order by their
// bytes. It is a snapshot: nothing here changes the environment, and a child is given the
// variables it should see at the moment it is started.
export environment() -> string[] {
    let entries = new List<string>();
    for (let entry in ens_environment()) {
        entries.push(entry);
    }
    sorting.sort(entries);
    return entries.toArray();
}

// The system the program was built for, named the way a package manifest names one in a native
// binding: "windows", "linux" or "macos". Any other system the compiler can target reports "linux",
// whose behavior it shares.
export platform() -> string {
    return switch (ens_platform()) {
        0 -> "windows",
        2 -> "macos",
        default -> "linux",
    };
}

export getEnvironmentVariable(string name) -> string? {
    return getenv(name);
}

export arguments() -> string[] {
    return ens_arguments();
}

export readAllBytes(string path) -> byte[] throws {
    CFile? handle = fopen(path, "rb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    byte[] content = new byte[4096];
    long total = 0;
    byte[] chunk = new byte[4096];
    while (feof(handle) == 0) {
        long count = fread(chunk, 1, chunk.length as ulong, handle) as long;
        if (ferror(handle) != 0) {
            let closed = fclose(handle);
            throw new SystemError("could not read file '{path}'");
        }
        if (total + count > content.length) {
            long capacity = content.length * 2;
            while (capacity < total + count) {
                capacity = capacity * 2;
            }
            byte[] grown = new byte[capacity];
            for (long i = 0; i < total; i = i + 1) {
                grown[i] = content[i];
            }
            content = grown;
        }
        for (long i = 0; i < count; i = i + 1) {
            content[total + i] = chunk[i];
        }
        total = total + count;
    }
    let closed = fclose(handle);
    return content.slice(0, total);
}

export readAllText(string path) -> string throws {
    return string.fromBytes(try readAllBytes(path));
}

export writeAllBytes(string path, byte[] content) throws {
    CFile? handle = fopen(path, "wb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    let written = fwrite(content, 1, content.length as ulong, handle);
    if (written != content.length as ulong) {
        let closed = fclose(handle);
        throw new SystemError("could not write file '{path}'");
    }
    if (fclose(handle) != 0) {
        throw new SystemError("could not write file '{path}'");
    }
}

export writeAllText(string path, string content) throws {
    try writeAllBytes(path, content.toBytes());
}

// Writes `message` and a newline to standard error, the stream a program reports its problems on,
// the way 'print' writes to standard output.
export writeError(string message) {
    ens_write_error(message);
}

// Hands everything the program has written but not yet given to the operating system over to it, so
// a line printed before this call has left the program by the time the next statement runs. The
// runtime already does this wherever the order is observable - before a diagnostic, before a child
// starts, and before a panic is reported - so this is for the orders only the program itself knows,
// such as a line that has to be out before it waits for something.
export flush() {
    let flushed = fflush(null);
}

// Runs `command` through the operating system's command interpreter and returns its exit code.
export run(string command) -> int throws {
    let status = ens_run_process(command);
    if (status == -1) {
        throw new SystemError("could not run command");
    }
    return status;
}

// Runs `program` with `arguments` and waits for it to finish, leaving both output streams with
// this process so what the program writes appears as it is written. No shell takes part, so an
// argument reaches the program exactly as written here, spaces, quotes and all. Returns the
// program's exit code, or 127 when it could not be started.
export run(string program, string[] arguments) -> int throws {
    return try started(program, arguments, inherited(), "", "");
}

// The same, with `environmentOverrides` - 'NAME=VALUE' entries - applied over the environment this
// process inherited, so the child keeps every variable it is not given a new value for.
export run(string program, string[] arguments, string[] environmentOverrides) -> int throws {
    return try started(program, arguments, environmentOverrides, "", "");
}

// Runs `program` with `arguments` and writes everything it sent to its standard output and
// standard error into the two files. An empty path leaves that stream with this process instead of
// capturing it. Returns the program's exit code, or 127 when it could not be started.
export runCaptured(string program, string[] arguments, string stdoutPath,
                   string stderrPath) -> int throws {
    return try started(program, arguments, inherited(), stdoutPath, stderrPath);
}

// The same, with `environmentOverrides` applied over the inherited environment.
export runCaptured(string program, string[] arguments, string[] environmentOverrides,
                   string stdoutPath, string stderrPath) -> int throws {
    return try started(program, arguments, environmentOverrides, stdoutPath, stderrPath);
}

// A program this one started and is still running, whose output this one reads as it is written.
// What the child sent to its standard output and what it sent to its standard error arrive together,
// in the order it wrote them, which is the order a reader of both streams would have seen.
export final class ChildProcess {
    ChildHandle child;
    string program;
    byte[] chunk;
    LineBuffer lines;

    int code;
    bool ended;
    bool waited;
    bool stopped;

    protected constructor(ChildHandle child, string program) {
        this.child = child;
        this.program = program;
        this.chunk = new byte[4096];
        this.lines = new LineBuffer();
        this.code = 0;
        this.ended = false;
        this.waited = false;
        this.stopped = false;
    }

    // The next line of the child's output, without its ending, or null once the output has ended.
    // The call waits for as long as the child takes to write that line. Output that does not end in
    // a newline is a line of its own, handed over last, and every call after that answers null.
    export readLine() -> string? throws {
        string? line = this.lines.take();
        while (line == null && !this.ended) {
            try this.fill();
            line = this.lines.take();
        }
        if (line != null) {
            return line;
        }
        return this.lines.rest();
    }

    // Whether readLine() can go ahead without waiting for the child: true when a whole line is there
    // to be had, and true once the output has ended, because reading then answers null at once. False
    // means `milliseconds` went by with neither, and the child may still be about to write something.
    // A bound of 0 asks about this moment alone. Reading itself is unchanged, so a reader that is
    // content to wait for as long as the child takes never has to ask this.
    export waitForOutput(long milliseconds) -> bool throws {
        if (this.ended || this.lines.holdsLine()) {
            return true;
        }
        int ready = ens_poll_child(this.child, milliseconds);
        if (ready < 0) {
            throw new SystemError("could not wait for the output of '{this.program}'");
        }
        return ready > 0;
    }

    // Stops the child. Its output ends where the child was stopped, and its exit code is then 137 -
    // the code a system reports for a program that was ended rather than one that chose to stop -
    // unless the child had already finished on its own, in which case the code stays the one it
    // reported. A child that has already finished is left as it is, so stopping one twice, or
    // stopping one that beat the call by a moment, is not a failure.
    export kill() throws {
        if (ens_kill_child(this.child) != 0) {
            throw new SystemError("could not stop '{this.program}'");
        }
        this.stopped = true;
    }

    // The child's exit code, waiting for it to finish first. Output that has not been read is read
    // and thrown away before the wait, because a child whose output nobody reads would be stopped by
    // a full pipe: asking for the code is asking for the child to be finished with. Read every line
    // with readLine() first where the output matters. Asking again answers the same code.
    //
    // A child that was stopped is not read out first: its output is no longer wanted, and something
    // else it left behind holding the pipe would make asking for the code wait on that instead.
    //
    // A wait the system could not answer raises a 'SystemError': the child's code is then unknown,
    // and unknown must not be handed back as one code or another.
    export wait() -> int throws {
        if (this.waited) {
            return this.code;
        }
        if (!this.stopped) {
            try this.discardRest();
        }
        long reported = ens_wait_child(this.child);
        if (reported < 0) {
            throw new SystemError("could not wait for '{this.program}' to finish");
        }
        this.code = reported as int;
        this.waited = true;
        return this.code;
    }

    // The next bytes of the output, kept for the lines they hold.
    fill() throws {
        long count = try this.received();
        if (count > 0) {
            this.lines.feed(this.chunk, count);
        }
    }

    // Reads the rest of the output for nothing but the reading, so the child is never left waiting
    // for room in a pipe.
    discardRest() throws {
        while (!this.ended) {
            let discarded = try this.received();
        }
    }

    // How many bytes of output arrived, 0 once it has ended.
    received() -> long throws {
        long count = ens_read_child(this.child, this.chunk, this.chunk.length);
        if (count < 0) {
            throw new SystemError("could not read the output of '{this.program}'");
        }
        if (count == 0) {
            this.ended = true;
        }
        return count;
    }

    // Letting a child go without waiting for it hands back the pipe its output was arriving on and
    // this process's hold on the child itself. The child keeps running with nothing left reading it.
    destructor() {
        ens_release_child(this.child);
    }
}

// Starts `program` with `arguments` and hands the child back while it runs, so this process can read
// what it writes as it writes it. No shell takes part, so an argument reaches the program exactly as
// written here, spaces, quotes and all; standard input stays this process's own. Raises a
// 'SystemError' when the program could not be started at all.
export start(string program, string[] arguments) -> ChildProcess throws {
    return try startedChild(program, arguments, inherited());
}

// The same, with `environmentOverrides` - 'NAME=VALUE' entries - applied over the environment this
// process inherited, so the child keeps every variable it is not given a new value for.
export start(string program, string[] arguments,
             string[] environmentOverrides) -> ChildProcess throws {
    return try startedChild(program, arguments, environmentOverrides);
}

// No overrides, which hands the child the environment this process inherited.
inherited() -> string[] {
    return [];
}

// The variables a child is started with: the inherited environment under the caller's overrides, or
// none at all when there are none, which hands this process's own environment on unchanged.
childVariables(string[] environmentOverrides) -> string[] {
    if (environmentOverrides.length == 0) {
        return inherited();
    }
    return process.mergedEnvironment(ens_environment(), environmentOverrides, platform());
}

startedChild(string program, string[] arguments,
             string[] environmentOverrides) -> ChildProcess throws {
    string[] variables = childVariables(environmentOverrides);
    byte[] block = process.environmentBlock(variables);
    ChildHandle? child = ens_start_process(program, process.argumentBlock(arguments),
        arguments.length, process.commandLineOf(program, arguments), block, variables.length,
        block.length);
    if (child == null) {
        throw new SystemError("could not start '{program}': check that the name is right and that "
            + "the program is where this process can reach it");
    }
    return new ChildProcess(child, program);
}

started(string program, string[] arguments, string[] environmentOverrides, string stdoutPath,
        string stderrPath) -> int throws {
    string[] variables = childVariables(environmentOverrides);
    byte[] block = process.environmentBlock(variables);
    long status = ens_spawn_process(program, process.argumentBlock(arguments), arguments.length,
        process.commandLineOf(program, arguments), block, variables.length, block.length,
        stdoutPath, stderrPath);
    if (status == -2) {
        throw new SystemError("could not wait for '{program}' to finish");
    }
    if (status < 0) {
        throw new SystemError("could not capture the output of '{program}' into "
            + capturedInto(stdoutPath, stderrPath));
    }
    return status as int;
}

// The capture files a spawn was asked for, for the message when they could not be opened.
capturedInto(string stdoutPath, string stderrPath) -> string {
    if (stdoutPath.length == 0) {
        return "'{stderrPath}'";
    }
    if (stderrPath.length == 0) {
        return "'{stdoutPath}'";
    }
    return "'{stdoutPath}' and '{stderrPath}'";
}
