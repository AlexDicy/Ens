import List from @std.collections.list;
import @std.process.blocks;
import LineBuffer from @std.text.lines;
import EncodingError from @std.text;

public external type CFile;
public external type Folder;
public external type Child;
external type ChildHandle;

// The compiler defines the 'ens_' bridges wherever they are referenced. The two bridges that start a
// program take the arguments twice over: a POSIX target builds an argument vector out of the NUL
// separated block, and a Windows target passes the joined command line on, because one string is the
// only shape Win32 accepts. Building both here keeps the quoting rules in Ens instead of in two code
// generators.
external from libc {
    fopen(string path, string mode) -> CFile?;
    fread(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    ferror(CFile stream) -> int;
    feof(CFile stream) -> int;
    fclose(CFile stream) -> int;
    fflush(CFile? stream) -> int;
    ens_standard_output() -> CFile;
    ens_standard_error() -> CFile;
    ens_standard_input() -> CFile;
    getenv(string name) -> string?;
    getcwd(byte[] buffer, int size) -> string?;
    remove(string path) -> int;
    rmdir(string path) -> int;
    rename(string path, string newPath) -> int;
    ens_run_process(string command) -> int;
    ens_spawn_process(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes, string stdoutPath, string stderrPath) -> long;
    ens_start_process(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes) -> ChildHandle?;
    ens_read_child(ChildHandle child, byte[] buffer, long capacity) -> long;
    ens_poll_child(ChildHandle child, long milliseconds) -> int;
    ens_kill_child(ChildHandle child) -> int;
    ens_wait_child(ChildHandle child) -> long;
    ens_release_child(ChildHandle child);
    ens_path_kind(string path) -> int;
    ens_list_directory(string folder) -> string[]?;
    ens_create_directory(string path) -> int;
    ens_fs_error_kind(int code) -> int;
    ens_fs_metadata(string path, int followLinks, out long kind, out long length,
                    out long modifiedMillis) -> int;
    ens_fs_real_path(string path, byte[] buffer, long capacity, out long needed) -> int;
    ens_fs_open(string path, int mode, out int code) -> CFile?;
    ens_fs_create_directory(string path) -> int;
    ens_fs_remove_file(string path) -> int;
    ens_fs_remove_directory(string path) -> int;
    ens_fs_rename(string from, string to, int replaceExisting) -> int;
    ens_fs_copy_permissions(string from, string to) -> int;
    ens_fs_open_directory(string path, out int code) -> Folder?;
    ens_fs_next_entry(Folder folder, out long kind, out int code) -> string?;
    ens_fs_close_directory(Folder folder);
    ens_process_start(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes, int environmentGiven, string workingDirectory,
                      int stdinMode, int stdoutMode, int stderrMode, out int error) -> Child?;
    ens_process_read(Child child, int stream, byte[] buffer, long capacity,
                     out long count) -> int;
    ens_process_write(Child child, byte[] data, long count, out long written) -> int;
    ens_process_close_input(Child child) -> int;
    ens_process_poll(Child child, long millis, out int ready) -> int;
    ens_process_wait(Child child, out int code, out int signal) -> int;
    ens_process_kill(Child child) -> int;
    ens_process_release(Child child);
    ens_process_error_kind(int code) -> int;
    ens_monotonic_millis() -> long;
    ens_current_directory(byte[] buffer, long capacity) -> long;
    ens_executable_path(byte[] buffer, long capacity) -> long;
    ens_environment() -> string[];
    ens_platform() -> int;
    ens_write_error(string message);
    atof(string text) -> double;
    exit(int code);
    ens_arguments() -> string[];
}

export class SystemError extends Error {
    export constructor(string m, Error? cause = null) { super(m, cause); }
}

export final class File {
    CFile handle;

    protected constructor(this.handle);

    export read(byte[] buffer) -> ulong throws {
        let count = fread(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file read failed");
        }
        return count;
    }

    export write(byte[] buffer) -> ulong throws {
        let count = fwrite(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file write failed");
        }
        return count;
    }

    export close() -> int {
        return fclose(this.handle);
    }
}

export openFile(string path, string mode) -> File throws {
    CFile? handle = fopen(path, mode);
    if (handle == null) {
        throw new SystemError("could not open file");
    }
    return new File(handle);
}

// The three streams every process is born with, and the calls over one of their handles. All of
// this is public rather than exported: nothing outside this library reaches a native handle.
public standardOutput() -> CFile {
    return ens_standard_output();
}

public standardError() -> CFile {
    return ens_standard_error();
}

public standardInput() -> CFile {
    return ens_standard_input();
}

// Whether `handle` took all of `data`.
public writeToHandle(CFile handle, byte[] data) -> bool {
    long taken = fwrite(data, 1, data.length as ulong, handle) as long;
    return taken == data.length;
}

// How many bytes `handle` had ready, and 0 both at the end of the stream and on a failure, which
// 'handleFailed' tells apart.
public readFromHandle(CFile handle, byte[] buffer) -> long {
    return fread(buffer, 1, buffer.length as ulong, handle) as long;
}

// Whether everything written to `handle` has reached the operating system.
public flushHandle(CFile handle) -> bool {
    return fflush(handle) == 0;
}

// Hands `handle` back to the operating system and answers whether everything written to it got
// there. The handle must not be touched afterwards.
public closeHandle(CFile handle) -> bool {
    return fclose(handle) == 0;
}

public handleFailed(CFile handle) -> bool {
    return ferror(handle) != 0;
}

// What a metadata bridge answered. A `code` of 0 means the other three were written, and any other
// value is the platform's own error number with none of them written.
public struct NativeMetadata {
    public const int code;
    public const long kind;
    public const long length;
    public const long modifiedMillis;
}

// What a real-path bridge answered. A `code` of 0 means the bridge resolved the path, `needed`
// always holds the room the answer takes, and the buffer is left untouched whenever that room is
// above what the caller offered.
public struct NativeRealPath {
    public const int code;
    public const long needed;
}

// The stream a path was opened on, or the platform's own error number in `code` for why it was not.
public struct NativeStream {
    public const CFile? handle;
    public const int code;
}

// The folder a path was opened as, or the platform's own error number in `code` for why it was not.
public struct NativeFolder {
    public const Folder? handle;
    public const int code;
}

// One name a folder handed over, and null for `name` once it has handed over every name or the
// reading failed, which the platform's own error number in `code` tells apart. The `kind` is what
// the file system reported for the entry, and 0 when it reported none.
public struct NativeEntry {
    public const string? name;
    public const long kind;
    public const int code;
}

// The std.fs ErrorKind ordinal a platform's own error number means, from 0 for NotFound to 7 for
// Other.
public fsErrorKind(int code) -> int {
    return ens_fs_error_kind(code);
}

// What is at `path`, where a `followLinks` of true answers for what a symbolic link points to and
// false answers for the link itself.
public fsMetadata(string path, bool followLinks) -> NativeMetadata {
    long kind = 0;
    long length = 0;
    long modifiedMillis = 0;
    int code = ens_fs_metadata(path, followLinks ? 1 : 0, out kind, out length,
        out modifiedMillis);
    NativeMetadata answer = {code: code, kind: kind, length: length,
        modifiedMillis: modifiedMillis};
    return answer;
}

// One attempt at the real form of `path`, written into `buffer` with `capacity` bytes of room. The
// text is the operating system's own and carries no terminator.
public fsRealPath(string path, byte[] buffer, long capacity) -> NativeRealPath {
    long needed = 0;
    int code = ens_fs_real_path(path, buffer, capacity, out needed);
    NativeRealPath answer = {code: code, needed: needed};
    return answer;
}

// The C library stream `path` is open on. The mode is 0 to read, 1 to write from empty, 2 to write
// at the end, and 3 to create and refuse a path that is already there.
public fsOpen(string path, int mode) -> NativeStream {
    int code = 0;
    CFile? handle = ens_fs_open(path, mode, out code);
    NativeStream answer = {handle: handle, code: code};
    return answer;
}

// Creates the one level `path` names, answering 0 or the platform's own error number. Every level
// above it is the caller's to create first.
public fsCreateDirectory(string path) -> int {
    return ens_fs_create_directory(path);
}

// Removes the file `path` names, answering 0 or the platform's own error number.
public fsRemoveFile(string path) -> int {
    return ens_fs_remove_file(path);
}

// Removes the folder `path` names, answering 0 or the platform's own error number.
public fsRemoveDirectory(string path) -> int {
    return ens_fs_remove_directory(path);
}

// Moves `from` to `to` in one step, answering 0 or the platform's own error number. Both paths have
// to be on one volume, since nothing here copies.
public fsRename(string from, string to, bool replaceExisting) -> int {
    return ens_fs_rename(from, to, replaceExisting ? 1 : 0);
}

// Hands the nine permission bits of `from` over to `to`, answering 0 or the platform's own error
// number. Windows answers 0 without doing anything, because it carries no bits a copy could hand
// over.
public fsCopyPermissions(string from, string to) -> int {
    return ens_fs_copy_permissions(from, to);
}

// A stream over what the folder at `path` holds, released by exactly one call to
// 'fsCloseDirectory'.
public fsOpenDirectory(string path) -> NativeFolder {
    int code = 0;
    Folder? handle = ens_fs_open_directory(path, out code);
    NativeFolder answer = {handle: handle, code: code};
    return answer;
}

// The next name inside `folder`. The entries naming the folder itself and its parent are never
// answered, and the order is whatever the file system enumerates in.
public fsNextEntry(Folder folder) -> NativeEntry {
    long kind = 0;
    int code = 0;
    string? name = ens_fs_next_entry(folder, out kind, out code);
    NativeEntry answer = {name: name, kind: kind, code: code};
    return answer;
}

// Hands `folder` back to the operating system along with the stream itself, which no call may touch
// afterwards.
public fsCloseDirectory(Folder folder) {
    ens_fs_close_directory(folder);
}

// The child a start answered, or the platform's own error number in `code` for why there is none.
public struct NativeChild {
    public const Child? child;
    public const int code;
}

// How many bytes a read or a write moved. A `code` of 0 means `count` was written, and any other
// value is the platform's own error number with nothing moved.
public struct NativeCount {
    public const int code;
    public const long count;
}

// What a poll answered. A `code` of 0 means `ready` holds the mask, and any other value is the
// platform's own error number.
public struct NativePoll {
    public const int code;
    public const int ready;
}

// How a child ended. A `code` of 0 means the other two were written, and any other value is the
// platform's own error number with neither written.
public struct NativeStatus {
    public const int code;
    public const int exitCode;
    public const int signal;
}

// A child started from `program`, which is a path and is never searched for. The argument block
// holds the whole argument vector as NUL separated values, `program` itself first; a POSIX target
// executes it and a Windows target hands `commandLine` to the system instead. With
// `environmentGiven` the child sees exactly the block's variables, even none, and without it this
// process's own. An empty `workingDirectory` keeps this process's own. Each mode is 0 to inherit
// this process's stream and 1 to connect a pipe this process holds.
public processStart(string program, byte[] argumentBlock, long argumentCount, string commandLine,
                    byte[] environmentBlock, long environmentCount, bool environmentGiven,
                    string workingDirectory, int stdinMode, int stdoutMode,
                    int stderrMode) -> NativeChild {
    int code = 0;
    Child? child = ens_process_start(program, argumentBlock, argumentCount, commandLine,
        environmentBlock, environmentCount, environmentBlock.length, environmentGiven ? 1 : 0,
        workingDirectory, stdinMode, stdoutMode, stderrMode, out code);
    NativeChild answer = {child: child, code: code};
    return answer;
}

// Bytes of one of the child's piped output streams, 1 for its output and 2 for its errors, waiting
// for the child to write. A count of 0 says the stream has ended.
public processRead(Child child, int stream, byte[] buffer) -> NativeCount {
    long count = 0;
    int code = ens_process_read(child, stream, buffer, buffer.length, out count);
    NativeCount answer = {code: code, count: count};
    return answer;
}

// As many of `data`'s bytes as the child's input took, which may be fewer than offered. A child
// that has closed its input, or an input this process has closed, answers EPIPE on POSIX and
// ERROR_NO_DATA or ERROR_BROKEN_PIPE on Windows.
public processWrite(Child child, byte[] data) -> NativeCount {
    long written = 0;
    int code = ens_process_write(child, data, data.length, out written);
    NativeCount answer = {code: code, count: written};
    return answer;
}

// Gives up this process's end of the child's input, so the child reads the end of it, answering 0
// or the platform's own error number. Asking again answers 0.
public processCloseInput(Child child) -> int {
    return ens_process_close_input(child);
}

// What a caller can do with the child without waiting, as a mask: 1 when its output has bytes or
// has ended, 2 the same for its errors, and 4 when the child has ended, or 0 when `millis` passed
// with none of them. A negative `millis` waits without bound. The system may answer before the
// bound as 'monotonicMillis' measures it, so a caller holding a deadline reads the clock and asks
// again for the remainder. A collected child leaves only its streams to wait on, and its mask
// always carries 4.
public processPoll(Child child, long millis) -> NativePoll {
    int ready = 0;
    int code = ens_process_poll(child, millis, out ready);
    NativePoll answer = {code: code, ready: ready};
    return answer;
}

// How the child ended, waiting for it to end first. An exit writes its code and a signal of 0, and
// a signal writes the signal and a code of 0. Windows has no signals, so a crash there writes its
// NTSTATUS as a negative code, and a child stopped by 'processKill' writes signal 9 and code 0
// when the code the system reports is the one the kill passed. Asking again answers the same.
public processWait(Child child) -> NativeStatus {
    int exitCode = 0;
    int signal = 0;
    int code = ens_process_wait(child, out exitCode, out signal);
    NativeStatus answer = {code: code, exitCode: exitCode, signal: signal};
    return answer;
}

// Ends the child, answering 0 once it is no longer running, whether this call ended it or it had
// ended already, or the platform's own error number. Nothing here waits.
public processKill(Child child) -> int {
    return ens_process_kill(child);
}

// Gives every pipe end and handle back and frees the child's block, which no call may touch
// afterwards. A child that has already ended is collected, and one still running is left to the
// system.
public processRelease(Child child) {
    ens_process_release(child);
}

// The std.process ErrorKind ordinal a platform's own error number means: 0 for NotFound, 1 for
// PermissionDenied and 2 for Other.
public processErrorKind(int code) -> int {
    return ens_process_error_kind(code);
}

// Milliseconds on a clock that never goes backwards, counted from an origin no caller may rely on.
public monotonicMillis() -> long {
    return ens_monotonic_millis();
}

// How many bytes of the directory the program was started in were written into `buffer`, and -1
// where the operating system would not report it or the buffer is too small to hold it. The text is
// the operating system's own, so a Windows answer carries '\'.
public currentDirectoryInto(byte[] buffer, long capacity) -> long {
    return ens_current_directory(buffer, capacity);
}

// How many bytes of the running program's own path were written into `buffer`, and -1 where the
// operating system would not report it or the buffer is too small to hold it. The text is the
// operating system's own, so a Windows answer carries '\'.
public executablePathInto(byte[] buffer, long capacity) -> long {
    return ens_executable_path(buffer, capacity);
}

// The system the program was built for, as the number the bridge answers with: 0 for Windows, 2 for
// macOS, and 1 for everything else, which behaves as Linux does.
public platformCode() -> int {
    return ens_platform();
}

// The value the text spells, converted the way the C library converts one, so a value written out
// and read back is the same value. Nothing here checks the text: the caller has already decided
// that it spells a number, and text that spells none reads as zero. A program never asks for
// another locale, so the decimal point is always '.'.
public parsedDouble(string text) -> double {
    return atof(text);
}

// Reports whether a file or directory exists at `path`, without throwing.
export exists(string path) -> bool {
    return ens_path_kind(path) != 0;
}

// Reports whether `path` names a file rather than a directory. A missing path reports false, so
// this never throws.
export isFile(string path) -> bool {
    return ens_path_kind(path) == 1;
}

// Reports whether `path` names a directory rather than a file. A missing path reports false, so
// this never throws.
export isDirectory(string path) -> bool {
    return ens_path_kind(path) == 2;
}

// The names of everything directly inside `folder`, without '.' and '..' and without the folder in
// front of them, in ascending order by their bytes so a walk over a tree visits the same names in
// the same order however the file system enumerates them.
export listDirectory(string folder) -> string[] throws {
    string[]? found = ens_list_directory(folder);
    if (found == null) {
        throw new SystemError("could not read the folder '{folder}'");
    }
    let names = new List<string>();
    for (let name in found) {
        names.push(name);
    }
    names.sort();
    return names.toArray();
}

// Creates the directory `path` names, and every parent of it that is missing. A path that is
// already a directory is left alone.
export createDirectory(string path) throws {
    if (path.length == 0) {
        throw new SystemError("could not create a folder: no path was given");
    }
    createParents(path);
    createLevel(path);
    if (ens_path_kind(path) != 2) {
        throw new SystemError("could not create the folder '{path}'");
    }
}

// Creates the directory `path` names and answers whether this call is the one that created it: true
// when it did, false when a directory was already there. Every missing parent above it is created the
// way 'createDirectory' creates them, and only the directory `path` itself names is claimed, so two
// programs asking for the same name at the same instant get different answers and exactly one of them
// may treat the folder as its own.
export createNewDirectory(string path) -> bool throws {
    if (path.length == 0) {
        throw new SystemError("could not create a folder: no path was given");
    }
    createParents(path);
    int outcome = ens_create_directory(path);
    if (outcome == 0) {
        return true;
    }
    if (outcome == 1) {
        if (ens_path_kind(path) != 2) {
            throw new SystemError("could not create the folder '{path}': a file of that name is "
                + "already there. Remove it, or ask for a folder under another name");
        }
        return false;
    }
    throw new SystemError("could not create the folder '{path}'");
}

// Every level above `path` that is missing. A parent that is already there is left alone, and one
// that could not be created is left to the call that needs it to report.
createParents(string path) {
    byte[] raw = path.toBytes();
    for (long i = 1; i < raw.length; i++) {
        if (raw[i] == '/') {
            createLevel(path.substring(0, i));
        }
    }
}

// Creates one level of a path when nothing is there yet. A root - a lone '/', a drive letter, or
// the start of a network share - is left alone, because no call creates one.
createLevel(string level) {
    if (level.length == 0 || level == "/" || driveRoot(level)) {
        return;
    }
    if (ens_path_kind(level) == 2) {
        return;
    }
    let created = ens_create_directory(level);
}

driveRoot(string level) -> bool {
    return level.length == 2 && level.endsWith(":");
}

// Removes the file `path` names. A directory is refused, because removing one is
// 'removeDirectory'.
export removeFile(string path) throws {
    if (ens_path_kind(path) == 2) {
        throw new SystemError("could not remove the file '{path}': it is a folder, so remove it "
            + "with removeDirectory");
    }
    if (remove(path) != 0) {
        throw new SystemError("could not remove the file '{path}'");
    }
}

// Removes the directory `path` names, which has to be empty already: removing what is inside it
// first is the caller's to decide.
export removeDirectory(string path) throws {
    if (rmdir(path) != 0) {
        throw new SystemError("could not remove the folder '{path}'");
    }
}

// Moves the file or folder `from` names to `to` and answers whether this call is the one that moved
// it: true when it did, and false when something was already at `to`. The move happens in one step,
// so no other program ever sees half of it and two programs racing for the same name get different
// answers; that is also why both paths have to be on the same volume, since a move across volumes
// would have to copy. A move that failed for any other reason raises a `SystemError`.
export move(string from, string to) -> bool throws {
    if (ens_path_kind(to) != 0) {
        return false;
    }
    if (rename(from, to) == 0) {
        return true;
    }
    if (ens_path_kind(to) != 0) {
        return false;
    }
    throw new SystemError("could not move '{from}' to '{to}'");
}

// The directory the program was started in, with '/' between its parts, or "." when the operating
// system would not report it. It is read, never written: a program that wants to work somewhere
// else joins that folder onto the paths it uses.
export currentDirectory() -> string {
    long capacity = 4096;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        string? folder = getcwd(buffer, capacity as int);
        if (folder != null) {
            return nativePathText(folder);
        }
        capacity = capacity * 8;
    }
    return ".";
}

// The path of the running program itself, with '/' between its parts, or "" when the operating
// system would not report it.
export executablePath() -> string {
    long capacity = 4096;
    while (capacity <= 65536) {
        byte[] buffer = new byte[capacity];
        long written = ens_executable_path(buffer, capacity);
        if (written > 0) {
            return nativePathText(string.fromBytesLossy(buffer.slice(0, written)));
        }
        capacity = capacity * 8;
    }
    return "";
}

// Text the operating system reported, written the way the two functions above have always
// answered a path: with '/' between the parts on Windows, and byte for byte everywhere else,
// where '\' is an ordinary character in a name.
nativePathText(string text) -> string {
    if (platform() != "windows") {
        return text;
    }
    return text.replace("\\", "/");
}

// The environment this process inherited, as 'NAME=VALUE' entries in ascending order by their
// bytes. It is a snapshot: nothing here changes the environment, and a child is given the
// variables it should see at the moment it is started.
export environment() -> string[] {
    let entries = new List<string>();
    for (let entry in ens_environment()) {
        entries.push(entry);
    }
    entries.sort();
    return entries.toArray();
}

// The system the program was built for, named the way a package manifest names one in a native
// binding: "windows", "linux" or "macos". Any other system the compiler can target reports "linux",
// whose behavior it shares.
export platform() -> string {
    return switch (ens_platform()) {
        0 -> "windows",
        2 -> "macos",
        default -> "linux",
    };
}

export getEnvironmentVariable(string name) -> string? {
    return getenv(name);
}

export arguments() -> string[] {
    return ens_arguments();
}

export readAllBytes(string path) -> byte[] throws {
    CFile? handle = fopen(path, "rb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    byte[] content = new byte[4096];
    long total = 0;
    byte[] chunk = new byte[4096];
    while (feof(handle) == 0) {
        long count = fread(chunk, 1, chunk.length as ulong, handle) as long;
        if (ferror(handle) != 0) {
            let closed = fclose(handle);
            throw new SystemError("could not read file '{path}'");
        }
        if (total + count > content.length) {
            long capacity = content.length * 2;
            while (capacity < total + count) {
                capacity = capacity * 2;
            }
            byte[] grown = new byte[capacity];
            for (long i = 0; i < total; i = i + 1) {
                grown[i] = content[i];
            }
            content = grown;
        }
        for (long i = 0; i < count; i = i + 1) {
            content[total + i] = chunk[i];
        }
        total = total + count;
    }
    let closed = fclose(handle);
    return content.slice(0, total);
}

// A file as text. Bytes that spell no character are refused as this module's own failure, with the
// encoding error beneath it, so reading a file needs no second error type.
export readAllText(string path) -> string throws {
    return try string.fromBytes(try readAllBytes(path));
} catch (EncodingError problem) {
    throw new SystemError("the byte at offset {problem.offset} begins no UTF-8 character",
        problem);
}

export writeAllBytes(string path, byte[] content) throws {
    CFile? handle = fopen(path, "wb");
    if (handle == null) {
        throw new SystemError("could not open file '{path}'");
    }
    let written = fwrite(content, 1, content.length as ulong, handle);
    if (written != content.length as ulong) {
        let closed = fclose(handle);
        throw new SystemError("could not write file '{path}'");
    }
    if (fclose(handle) != 0) {
        throw new SystemError("could not write file '{path}'");
    }
}

export writeAllText(string path, string content) throws {
    try writeAllBytes(path, content.toBytes());
}

// Writes `message` and a newline to standard error, the stream a program reports its problems on,
// the way 'print' writes to standard output.
export writeError(string message) {
    ens_write_error(message);
}

// Hands everything the program has written but not yet given to the operating system over to it, so
// a line printed before this call has left the program by the time the next statement runs. The
// runtime already does this wherever the order is observable - before a diagnostic, before a child
// starts, and before a panic is reported - so this is for the orders only the program itself knows,
// such as a line that has to be out before it waits for something.
export flush() {
    let flushed = fflush(null);
}

// Runs `command` through the operating system's command interpreter and returns its exit code.
export run(string command) -> int throws {
    let status = ens_run_process(command);
    if (status == -1) {
        throw new SystemError("could not run command");
    }
    return status;
}

// Runs `program` with `arguments` and waits for it to finish, leaving both output streams with
// this process so what the program writes appears as it is written. No shell takes part, so an
// argument reaches the program exactly as written here, spaces, quotes and all. Returns the
// program's exit code, or 127 when it could not be started.
export run(string program, string[] arguments) -> int throws {
    return try started(program, arguments, inherited(), "", "");
}

// Runs `program` with `arguments` and waits for it to finish, leaving both output streams with this
// process so what the program writes appears as it is written. `environmentOverrides` are
// 'NAME=VALUE' entries applied over the environment this process inherited, so the child keeps every
// variable it is not given anew. No shell takes part, so an argument reaches the program exactly as
// written here, spaces, quotes and all. Returns the program's exit code, or 127 when it could not be
// started.
export run(string program, string[] arguments, string[] environmentOverrides) -> int throws {
    return try started(program, arguments, environmentOverrides, "", "");
}

// Runs `program` with `arguments` and writes everything it sent to its standard output and
// standard error into the two files. An empty path leaves that stream with this process instead of
// capturing it. Returns the program's exit code, or 127 when it could not be started.
export runCaptured(string program, string[] arguments, string stdoutPath, string stderrPath) -> int throws {
    return try started(program, arguments, inherited(), stdoutPath, stderrPath);
}

// Runs `program` with `arguments` and writes everything it sent to its standard output and standard
// error into the two files. An empty path leaves that stream with this process instead of capturing
// it. `environmentOverrides` are 'NAME=VALUE' entries applied over the environment this process
// inherited, so the child keeps every variable it is not given anew. Returns the program's exit
// code, or 127 when it could not be started.
export runCaptured(string program, string[] arguments, string[] environmentOverrides,
                   string stdoutPath, string stderrPath) -> int throws {
    return try started(program, arguments, environmentOverrides, stdoutPath, stderrPath);
}

// A program this one started and is still running, whose output this one reads as it is written.
// What the child sent to its standard output and what it sent to its standard error arrive together,
// in the order it wrote them, which is the order a reader of both streams would have seen.
export final class ChildProcess {
    ChildHandle child;
    string program;
    byte[] chunk;
    LineBuffer lines;

    int code;
    bool ended;
    bool waited;
    bool stopped;

    protected constructor(ChildHandle child, string program) {
        this.child = child;
        this.program = program;
        this.chunk = new byte[4096];
        this.lines = new LineBuffer();
        this.code = 0;
        this.ended = false;
        this.waited = false;
        this.stopped = false;
    }

    // The next line of the child's output, without its ending, or null once the output has ended.
    // The call waits for as long as the child takes to write that line. Output that does not end in
    // a newline is a line of its own, handed over last, and every call after that answers null.
    export readLine() -> string? throws {
        string? line = this.lines.take();
        while (line == null && !this.ended) {
            try this.fill();
            line = this.lines.take();
        }
        if (line != null) {
            return line;
        }
        return this.lines.rest();
    }

    // Whether readLine() can go ahead without waiting for the child: true when a whole line is there
    // to be had, and true once the output has ended, because reading then answers null at once. False
    // means `milliseconds` went by with neither, and the child may still be about to write something.
    // A bound of 0 asks about this moment alone. Reading itself is unchanged, so a reader that is
    // content to wait for as long as the child takes never has to ask this.
    export waitForOutput(long milliseconds) -> bool throws {
        if (this.ended || this.lines.holdsLine()) {
            return true;
        }
        int ready = ens_poll_child(this.child, milliseconds);
        if (ready < 0) {
            throw new SystemError("could not wait for the output of '{this.program}'");
        }
        return ready > 0;
    }

    // Stops the child. Its output ends where the child was stopped, and its exit code is then 137 -
    // the code a system reports for a program that was ended rather than one that chose to stop -
    // unless the child had already finished on its own, in which case the code stays the one it
    // reported. A child that has already finished is left as it is, so stopping one twice, or
    // stopping one that beat the call by a moment, is not a failure.
    export kill() throws {
        if (ens_kill_child(this.child) != 0) {
            throw new SystemError("could not stop '{this.program}'");
        }
        this.stopped = true;
    }

    // The child's exit code, waiting for it to finish first. Output that has not been read is read
    // and thrown away before the wait, because a child whose output nobody reads would be stopped
    // by a full pipe. Read every line with readLine() first where the output matters, and asking
    // again answers the same code. A child that was stopped is not read out first, since its output
    // is no longer wanted. A wait the system could not answer raises a 'SystemError', because an
    // unknown code must not be handed back as one code or another.
    export wait() -> int throws {
        if (this.waited) {
            return this.code;
        }
        if (!this.stopped) {
            try this.discardRest();
        }
        long reported = ens_wait_child(this.child);
        if (reported < 0) {
            throw new SystemError("could not wait for '{this.program}' to finish");
        }
        this.code = reported as int;
        this.waited = true;
        return this.code;
    }

    // The next bytes of the output, kept for the lines they hold.
    fill() throws {
        long count = try this.received();
        if (count > 0) {
            this.lines.feed(this.chunk, count);
        }
    }

    // Reads the rest of the output for nothing but the reading, so the child is never left waiting
    // for room in a pipe.
    discardRest() throws {
        while (!this.ended) {
            let discarded = try this.received();
        }
    }

    // How many bytes of output arrived, 0 once it has ended.
    received() -> long throws {
        long count = ens_read_child(this.child, this.chunk, this.chunk.length);
        if (count < 0) {
            throw new SystemError("could not read the output of '{this.program}'");
        }
        if (count == 0) {
            this.ended = true;
        }
        return count;
    }

    // Letting a child go without waiting for it hands back the pipe its output was arriving on and
    // this process's hold on the child itself. The child keeps running with nothing left reading it.
    destructor() {
        ens_release_child(this.child);
    }
}

// Starts `program` with `arguments` and hands the child back while it runs, so this process can read
// what it writes as it writes it. No shell takes part, so an argument reaches the program exactly as
// written here, spaces, quotes and all; standard input stays this process's own. Raises a
// 'SystemError' when the program could not be started at all.
export start(string program, string[] arguments) -> ChildProcess throws {
    return try startedChild(program, arguments, inherited());
}

// Starts `program` with `arguments` and hands the child back while it runs, so this process can read
// what it writes as it writes it. `environmentOverrides` are 'NAME=VALUE' entries applied over the
// environment this process inherited, so the child keeps every variable it is not given anew. No
// shell takes part, so an argument reaches the program exactly as written here, spaces, quotes and
// all; standard input stays this process's own. Raises a 'SystemError' when the program could not be
// started at all.
export start(string program, string[] arguments, string[] environmentOverrides) -> ChildProcess throws {
    return try startedChild(program, arguments, environmentOverrides);
}

// No overrides, which hands the child the environment this process inherited.
inherited() -> string[] {
    return [];
}

// The variables a child is started with: the inherited environment under the caller's overrides, or
// none at all when there are none, which hands this process's own environment on unchanged.
childVariables(string[] environmentOverrides) -> string[] {
    if (environmentOverrides.length == 0) {
        return inherited();
    }
    return blocks.mergedEnvironment(ens_environment(), environmentOverrides, platform());
}

startedChild(string program, string[] arguments, string[] environmentOverrides) -> ChildProcess throws {
    string[] variables = childVariables(environmentOverrides);
    byte[] block = blocks.environmentBlock(variables);
    ChildHandle? child = ens_start_process(program, blocks.argumentBlock(arguments),
        arguments.length, blocks.commandLineOf(program, arguments), block, variables.length,
        block.length);
    if (child == null) {
        throw new SystemError("could not start '{program}': check that the name is right and that "
            + "the program is where this process can reach it");
    }
    return new ChildProcess(child, program);
}

started(string program, string[] arguments, string[] environmentOverrides, string stdoutPath,
        string stderrPath) -> int throws {
    string[] variables = childVariables(environmentOverrides);
    byte[] block = blocks.environmentBlock(variables);
    long status = ens_spawn_process(program, blocks.argumentBlock(arguments), arguments.length,
        blocks.commandLineOf(program, arguments), block, variables.length, block.length,
        stdoutPath, stderrPath);
    if (status == -2) {
        throw new SystemError("could not wait for '{program}' to finish");
    }
    if (status < 0) {
        throw new SystemError("could not capture the output of '{program}' into "
            + capturedInto(stdoutPath, stderrPath));
    }
    return status as int;
}

// The capture files a spawn was asked for, for the message when they could not be opened.
capturedInto(string stdoutPath, string stderrPath) -> string {
    if (stdoutPath.length == 0) {
        return "'{stderrPath}'";
    }
    if (stderrPath.length == 0) {
        return "'{stdoutPath}'";
    }
    return "'{stdoutPath}' and '{stderrPath}'";
}
