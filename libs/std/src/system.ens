import @std.process.blocks;
import LineBuffer from @std.text.lines;

public external type CFile;
public external type Folder;
public external type Child;
external type ChildHandle;

// The compiler defines the 'ens_' bridges wherever they are referenced. The two bridges that start a
// program take the arguments twice over: a POSIX target builds an argument vector out of the NUL
// separated block, and a Windows target passes the joined command line on, because one string is the
// only shape Win32 accepts. Building both here keeps the quoting rules in Ens instead of in two code
// generators.
external from libc {
    ens_standard_output() -> CFile;
    ens_standard_error() -> CFile;
    ens_standard_input() -> CFile;
    ens_start_process(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes) -> ChildHandle?;
    ens_read_child(ChildHandle child, byte[] buffer, long capacity) -> long;
    ens_poll_child(ChildHandle child, long milliseconds) -> int;
    ens_kill_child(ChildHandle child) -> int;
    ens_wait_child(ChildHandle child) -> long;
    ens_release_child(ChildHandle child);
    ens_fs_error_kind(int code) -> int;
    ens_fs_metadata(string path, int followLinks, out long kind, out long length,
                    out long modifiedMillis) -> int;
    ens_fs_real_path(string path, byte[] buffer, long capacity, out long needed) -> int;
    ens_fs_open(string path, int mode, out int code) -> CFile?;
    ens_fs_create_directory(string path) -> int;
    ens_fs_remove_file(string path) -> int;
    ens_fs_remove_directory(string path) -> int;
    ens_fs_rename(string from, string to, int replaceExisting) -> int;
    ens_fs_copy_permissions(string from, string to) -> int;
    ens_fs_open_directory(string path, out int code) -> Folder?;
    ens_fs_next_entry(Folder folder, out long kind, out int code) -> string?;
    ens_fs_close_directory(Folder folder);
    ens_fs_errno_kind(int code) -> int;
    ens_stream_write(CFile handle, byte[] data, long count, out long written) -> int;
    ens_stream_read(CFile handle, byte[] buffer, long capacity, out long count) -> int;
    ens_stream_flush(CFile handle) -> int;
    ens_stream_close(CFile handle) -> int;
    ens_io_error_kind(int code) -> int;
    ens_process_start(string program, byte[] argumentBlock, long argumentCount,
                      string commandLine, byte[] environmentBlock, long environmentCount,
                      long environmentBytes, int environmentGiven, string workingDirectory,
                      int stdinMode, int stdoutMode, int stderrMode, out int error) -> Child?;
    ens_process_read(Child child, int stream, byte[] buffer, long capacity,
                     out long count) -> int;
    ens_process_write(Child child, byte[] data, long count, out long written) -> int;
    ens_process_close_input(Child child) -> int;
    ens_process_poll(Child child, long millis, out int ready) -> int;
    ens_process_wait(Child child, out int code, out int signal) -> int;
    ens_process_kill(Child child) -> int;
    ens_process_release(Child child);
    ens_process_error_kind(int code) -> int;
    ens_monotonic_millis() -> long;
    ens_sleep_millis(long millis);
    ens_current_directory(byte[] buffer, long capacity) -> long;
    ens_executable_path(byte[] buffer, long capacity) -> long;
    ens_environment() -> string[];
    ens_platform() -> int;
    ens_arguments() -> string[];
    ens_double_bits(double value) -> ulong;
    ens_double_from_bits(ulong bits) -> double;
    ens_float_bits(float value) -> uint;
    ens_float_from_bits(uint bits) -> float;
}

export class SystemError extends Error {
    export constructor(string message, Error? cause = null) {
        super(message, cause);
    }
}

// The three streams every process is born with, and the calls over one of their handles. All of
// this is public rather than exported: nothing outside this library reaches a native handle.
public standardOutput() -> CFile {
    return ens_standard_output();
}

public standardError() -> CFile {
    return ens_standard_error();
}

public standardInput() -> CFile {
    return ens_standard_input();
}

// All of `data`, with a `code` of 0 once every byte is the stream's. Any other value is the C
// library's own number for why the rest was not written, and `count` gives how far the write got.
public writeToHandle(CFile handle, byte[] data) -> NativeCount {
    long written = 0;
    int code = ens_stream_write(handle, data, data.length, out written);
    NativeCount result = {code: code, count: written};
    return result;
}

// As many bytes as `handle` had ready, and a `count` of 0 once the stream has ended. A `code` other
// than 0 is the C library's own number for a read that failed rather than ended.
public readFromHandle(CFile handle, byte[] buffer) -> NativeCount {
    long count = 0;
    int code = ens_stream_read(handle, buffer, buffer.length, out count);
    NativeCount result = {code: code, count: count};
    return result;
}

// Flushes everything written to `handle` to the operating system, returning 0 or the C library's
// own number for why it could not.
public flushHandle(CFile handle) -> int {
    return ens_stream_flush(handle);
}

// Closes `handle`, returning 0 or the C library's own number for a
// write it could not finish. The handle must not be touched afterwards either way.
public closeHandle(CFile handle) -> int {
    return ens_stream_close(handle);
}

// The std.io.streams ErrorKind ordinal an errno means, 0 for Closed, 1 for Interrupted and 2 for
// Other.
public ioErrorKind(int code) -> int {
    return ens_io_error_kind(code);
}

// The std.fs ErrorKind ordinal an errno means, from 0 for NotFound to 7 for Other. This is the
// table a failure a stream call reported is read through, where 'fsErrorKind' reads the one a file
// call reported.
public fsErrnoKind(int code) -> int {
    return ens_fs_errno_kind(code);
}

// What a metadata bridge returned. A `code` of 0 means the other three were written, and any other
// value is the platform's own error number with none of them written.
public struct NativeMetadata {
    public const int code;
    public const long kind;
    public const long length;
    public const long modifiedMillis;
}

// What a real-path bridge returned. A `code` of 0 means the bridge resolved the path, `needed`
// always holds the room the result takes, and the buffer is left untouched whenever that room is
// above what the caller offered.
public struct NativeRealPath {
    public const int code;
    public const long needed;
}

// The stream a path was opened on, or the platform's own error number in `code` for why it was not.
public struct NativeStream {
    public const CFile? handle;
    public const int code;
}

// The folder a path was opened as, or the platform's own error number in `code` for why it was not.
public struct NativeFolder {
    public const Folder? handle;
    public const int code;
}

// One name read from a folder, and null for `name` once every name has been read or the
// reading failed, which the platform's own error number in `code` distinguishes. The `kind` is what
// the file system reported for the entry, and 0 when it reported none.
public struct NativeEntry {
    public const string? name;
    public const long kind;
    public const int code;
}

// The std.fs ErrorKind ordinal a platform's own error number means, from 0 for NotFound to 7 for
// Other.
public fsErrorKind(int code) -> int {
    return ens_fs_error_kind(code);
}

// What is at `path`, where a `followLinks` of true describes what a symbolic link points to and
// false describes the link itself.
public fsMetadata(string path, bool followLinks) -> NativeMetadata {
    long kind = 0;
    long length = 0;
    long modifiedMillis = 0;
    int code = ens_fs_metadata(path, followLinks ? 1 : 0, out kind, out length,
        out modifiedMillis);
    NativeMetadata result = {code: code, kind: kind, length: length,
        modifiedMillis: modifiedMillis};
    return result;
}

// One attempt at the real form of `path`, written into `buffer` with `capacity` bytes of room. The
// text is the operating system's own and carries no terminator.
public fsRealPath(string path, byte[] buffer, long capacity) -> NativeRealPath {
    long needed = 0;
    int code = ens_fs_real_path(path, buffer, capacity, out needed);
    NativeRealPath result = {code: code, needed: needed};
    return result;
}

// The C library stream `path` is open on. The mode is 0 to read, 1 to write from empty, 2 to write
// at the end, and 3 to create and refuse a path that is already there.
public fsOpen(string path, int mode) -> NativeStream {
    int code = 0;
    CFile? handle = ens_fs_open(path, mode, out code);
    NativeStream result = {handle: handle, code: code};
    return result;
}

// Creates the one level `path` names, returning 0 or the platform's own error number. Every level
// above it is the caller's to create first.
public fsCreateDirectory(string path) -> int {
    return ens_fs_create_directory(path);
}

// Removes the file `path` names, returning 0 or the platform's own error number.
public fsRemoveFile(string path) -> int {
    return ens_fs_remove_file(path);
}

// Removes the folder `path` names, returning 0 or the platform's own error number.
public fsRemoveDirectory(string path) -> int {
    return ens_fs_remove_directory(path);
}

// Moves `from` to `to` in one step, returning 0 or the platform's own error number. Both paths have
// to be on one volume, since nothing here copies.
public fsRename(string from, string to, bool replaceExisting) -> int {
    return ens_fs_rename(from, to, replaceExisting ? 1 : 0);
}

// Copies the nine permission bits of `from` to `to`, returning 0 or the platform's own error
// number. Windows returns 0 without doing anything, because it has no bits a copy could carry.
public fsCopyPermissions(string from, string to) -> int {
    return ens_fs_copy_permissions(from, to);
}

// A stream over what the folder at `path` holds, released by exactly one call to
// 'fsCloseDirectory'.
public fsOpenDirectory(string path) -> NativeFolder {
    int code = 0;
    Folder? handle = ens_fs_open_directory(path, out code);
    NativeFolder result = {handle: handle, code: code};
    return result;
}

// The next name inside `folder`. The entries naming the folder itself and its parent are never
// returned, and the order is whatever the file system enumerates in.
public fsNextEntry(Folder folder) -> NativeEntry {
    long kind = 0;
    int code = 0;
    string? name = ens_fs_next_entry(folder, out kind, out code);
    NativeEntry result = {name: name, kind: kind, code: code};
    return result;
}

// Hands `folder` back to the operating system along with the stream itself, which no call may touch
// afterwards.
public fsCloseDirectory(Folder folder) {
    ens_fs_close_directory(folder);
}

// The child a start returned, or the platform's own error number in `code` for why there is none.
public struct NativeChild {
    public const Child? child;
    public const int code;
}

// How many bytes a read or a write moved. A `code` of 0 means `count` was written, and any other
// value is the platform's own error number with nothing moved.
public struct NativeCount {
    public const int code;
    public const long count;
}

// What a poll returned. A `code` of 0 means `ready` holds the mask, and any other value is the
// platform's own error number.
public struct NativePoll {
    public const int code;
    public const int ready;
}

// How a child ended. A `code` of 0 means the other two were written, and any other value is the
// platform's own error number with neither written.
public struct NativeStatus {
    public const int code;
    public const int exitCode;
    public const int signal;
}

// A child started from `program`, which is a path and is never searched for. The argument block
// holds the whole argument vector as NUL separated values, `program` itself first; a POSIX target
// executes it and a Windows target hands `commandLine` to the system instead. With
// `environmentGiven` the child receives exactly the block's variables, even none, and without it this
// process's own. An empty `workingDirectory` keeps this process's own. Each mode is 0 to inherit
// this process's stream and 1 to connect a pipe this process holds.
public processStart(string program, byte[] argumentBlock, long argumentCount, string commandLine,
                    byte[] environmentBlock, long environmentCount, bool environmentGiven,
                    string workingDirectory, int stdinMode, int stdoutMode,
                    int stderrMode) -> NativeChild {
    int code = 0;
    Child? child = ens_process_start(program, argumentBlock, argumentCount, commandLine,
        environmentBlock, environmentCount, environmentBlock.length, environmentGiven ? 1 : 0,
        workingDirectory, stdinMode, stdoutMode, stderrMode, out code);
    NativeChild result = {child: child, code: code};
    return result;
}

// Bytes of one of the child's piped output streams, 1 for its output and 2 for its errors, waiting
// for the child to write. A count of 0 means the stream has ended.
public processRead(Child child, int stream, byte[] buffer) -> NativeCount {
    long count = 0;
    int code = ens_process_read(child, stream, buffer, buffer.length, out count);
    NativeCount result = {code: code, count: count};
    return result;
}

// As many of `data`'s bytes as the child's input took, which may be fewer than offered. A child
// that has closed its input, or an input this process has closed, returns EPIPE on POSIX and
// ERROR_NO_DATA or ERROR_BROKEN_PIPE on Windows.
public processWrite(Child child, byte[] data) -> NativeCount {
    long written = 0;
    int code = ens_process_write(child, data, data.length, out written);
    NativeCount result = {code: code, count: written};
    return result;
}

// Closes this process's end of the child's input, so the child reads the end of it, returning 0
// or the platform's own error number. A second call returns 0.
public processCloseInput(Child child) -> int {
    return ens_process_close_input(child);
}

// What a caller can do with the child without waiting, as a mask: 1 when its output has bytes or
// has ended, 2 the same for its errors, and 4 when the child has ended, or 0 when `millis` passed
// with none of them. A negative `millis` waits without bound. The system may return before the
// bound as 'monotonicMillis' measures it, so a caller holding a deadline reads the clock and calls
// again for the remainder. A collected child leaves only its streams to wait on, and its mask
// always carries 4.
public processPoll(Child child, long millis) -> NativePoll {
    int ready = 0;
    int code = ens_process_poll(child, millis, out ready);
    NativePoll result = {code: code, ready: ready};
    return result;
}

// How the child ended, waiting for it to end first. An exit writes its code and a signal of 0, and
// a signal writes the signal and a code of 0. Windows has no signals, so a crash there writes its
// NTSTATUS as a negative code, and a child stopped by 'processKill' writes signal 9 and code 0
// when the code the system reports is the one the kill passed. A second call returns the same.
public processWait(Child child) -> NativeStatus {
    int exitCode = 0;
    int signal = 0;
    int code = ens_process_wait(child, out exitCode, out signal);
    NativeStatus result = {code: code, exitCode: exitCode, signal: signal};
    return result;
}

// Ends the child, returning 0 once it is no longer running, whether this call ended it or it had
// ended already, or the platform's own error number. Nothing here waits.
public processKill(Child child) -> int {
    return ens_process_kill(child);
}

// Gives every pipe end and handle back and frees the child's block, which no call may touch
// afterwards. A child that has already ended is collected, and one still running is left to the
// system.
public processRelease(Child child) {
    ens_process_release(child);
}

// The std.process ErrorKind ordinal a platform's own error number means: 0 for NotFound, 1 for
// PermissionDenied and 2 for Other.
public processErrorKind(int code) -> int {
    return ens_process_error_kind(code);
}

// Milliseconds on a clock that never goes backwards, counted from an origin no caller may rely on.
public monotonicMillis() -> long {
    return ens_monotonic_millis();
}

// Blocks this thread for `millis` milliseconds. A count of zero or less returns without waiting.
// The floor is the platform's own. On Windows a wait can end one system timer tick short of the
// count.
public sleepMillis(long millis) {
    ens_sleep_millis(millis);
}

// How many bytes of the directory the program was started in were written into `buffer`, and -1
// where the operating system would not report it or the buffer is too small to hold it. The text is
// the operating system's own, so a Windows result carries '\'.
public currentDirectoryInto(byte[] buffer, long capacity) -> long {
    return ens_current_directory(buffer, capacity);
}

// How many bytes of the running program's own path were written into `buffer`, and -1 where the
// operating system would not report it or the buffer is too small to hold it. The text is the
// operating system's own, so a Windows result carries '\'.
public executablePathInto(byte[] buffer, long capacity) -> long {
    return ens_executable_path(buffer, capacity);
}

// The system the program was built for, as the number the bridge returns: 0 for Windows, 2 for
// macOS, and 1 for everything else, which behaves as Linux does.
public platformCode() -> int {
    return ens_platform();
}

// The environment this process inherited, as 'NAME=VALUE' entries in whatever order the operating
// system holds them. It is a snapshot: nothing here changes the environment, and a child is given
// the variables it receives at the moment it is started.
public inheritedEnvironment() -> string[] {
    return ens_environment();
}

// The whole command line this process was started with, the program's own name first, which is how
// every system passes it.
public argumentVector() -> string[] {
    return ens_arguments();
}

// The IEEE bits of `value`, with its sign in the top bit. 'doubleFromBits' reads them back as the
// value they came from, a NaN's payload included.
public doubleBits(double value) -> ulong {
    return ens_double_bits(value);
}

// The double those bits spell. Every pattern spells one, so none of them is refused.
public doubleFromBits(ulong bits) -> double {
    return ens_double_from_bits(bits);
}

// The IEEE bits of `value`, with its sign in the top bit. 'floatFromBits' reads them back as the
// value they came from, a NaN's payload included.
public floatBits(float value) -> uint {
    return ens_float_bits(value);
}

// The float those bits spell. Every pattern spells one, so none of them is refused.
public floatFromBits(uint bits) -> float {
    return ens_float_from_bits(bits);
}

// A program this one started and is still running, whose output this one reads as it is written.
// What the child sent to its standard output and what it sent to its standard error arrive together,
// in the order it wrote them, which is the order a reader of both streams would have read.
export final class ChildProcess {
    ChildHandle child;
    string program;
    byte[] chunk;
    LineBuffer lines;

    int code;
    bool ended;
    bool waited;
    bool stopped;

    protected constructor(ChildHandle child, string program) {
        this.child = child;
        this.program = program;
        this.chunk = new byte[4096];
        this.lines = new LineBuffer();
        this.code = 0;
        this.ended = false;
        this.waited = false;
        this.stopped = false;
    }

    // The next line of the child's output, without its ending, or null once the output has ended.
    // The call waits for as long as the child takes to write that line. Output that does not end in
    // a newline is a line of its own, returned last, and every call after that returns null.
    export readLine() -> string? throws {
        string? line = this.lines.take();
        while (line == null && !this.ended) {
            try this.fill();
            line = this.lines.take();
        }
        if (line != null) {
            return line;
        }
        return this.lines.rest();
    }

    // Whether readLine() can go ahead without waiting for the child: true when a whole line is there
    // to be had, and true once the output has ended, because reading then returns null at once. False
    // means `milliseconds` went by with neither, and the child may still be about to write something.
    // A bound of 0 checks this moment alone. Reading itself is unchanged, so a reader that is
    // content to wait for as long as the child takes never has to call this.
    export waitForOutput(long milliseconds) -> bool throws {
        if (this.ended || this.lines.holdsLine()) {
            return true;
        }
        int ready = ens_poll_child(this.child, milliseconds);
        if (ready < 0) {
            throw new SystemError("could not wait for the output of '{this.program}'");
        }
        return ready > 0;
    }

    // Stops the child. Its output ends where the child was stopped, and its exit code is then 137,
    // which is the code a system reports for a program that was ended rather than one that chose
    // to stop. A child that had already finished keeps the code it reported and is left as it is,
    // so stopping one twice, or stopping one that beat the call by a moment, is not a failure.
    export kill() throws {
        if (ens_kill_child(this.child) != 0) {
            throw new SystemError("could not stop '{this.program}'");
        }
        this.stopped = true;
    }

    // The child's exit code, waiting for it to finish first. Output that has not been read is read
    // and thrown away before the wait, because a child whose output nobody reads would be stopped
    // by a full pipe. Read every line with readLine() first where the output matters, and calling
    // again returns the same code. A child that was stopped is not read out first, since its output
    // is no longer needed. A wait the system failed raises a 'SystemError', because an
    // unknown code must not be returned as one code or another.
    export wait() -> int throws {
        if (this.waited) {
            return this.code;
        }
        if (!this.stopped) {
            try this.discardRest();
        }
        long reported = ens_wait_child(this.child);
        if (reported < 0) {
            throw new SystemError("could not wait for '{this.program}' to finish");
        }
        this.code = reported as int;
        this.waited = true;
        return this.code;
    }

    // The next bytes of the output, kept for the lines they hold.
    fill() throws {
        long count = try this.received();
        if (count > 0) {
            this.lines.feed(this.chunk, count);
        }
    }

    // Reads the rest of the output for nothing but the reading, so the child is never left waiting
    // for room in a pipe.
    discardRest() throws {
        while (!this.ended) {
            let discarded = try this.received();
        }
    }

    // How many bytes of output arrived, 0 once it has ended.
    received() -> long throws {
        long count = ens_read_child(this.child, this.chunk, this.chunk.length);
        if (count < 0) {
            throw new SystemError("could not read the output of '{this.program}'");
        }
        if (count == 0) {
            this.ended = true;
        }
        return count;
    }

    // Dropping a child without waiting for it closes the pipe its output was arriving on and
    // this process's hold on the child itself. The child keeps running with nothing left reading it.
    destructor() {
        ens_release_child(this.child);
    }
}

// Starts `program` with `arguments` and hands the child back while it runs, so this process can read
// what it writes as it writes it. No shell takes part, so an argument reaches the program exactly as
// written here, spaces, quotes and all; standard input stays this process's own. Raises a
// 'SystemError' when the program could not be started at all.
export start(string program, string[] arguments) -> ChildProcess throws {
    return try startedChild(program, arguments, inherited());
}

// Starts `program` with `arguments` and hands the child back while it runs, so this process can read
// what it writes as it writes it. `environmentOverrides` are 'NAME=VALUE' entries applied over the
// environment this process inherited, so the child keeps every variable it is not given anew. No
// shell takes part, so an argument reaches the program exactly as written here, spaces, quotes and
// all; standard input stays this process's own. Raises a 'SystemError' when the program could not be
// started at all.
export start(string program, string[] arguments, string[] environmentOverrides) -> ChildProcess throws {
    return try startedChild(program, arguments, environmentOverrides);
}

// No overrides, which hands the child the environment this process inherited.
inherited() -> string[] {
    return [];
}

// The variables a child is started with: the inherited environment under the caller's overrides, or
// none at all when there are none, which hands this process's own environment on unchanged.
childVariables(string[] environmentOverrides) -> string[] {
    if (environmentOverrides.length == 0) {
        return inherited();
    }
    return blocks.mergedEnvironment(ens_environment(), environmentOverrides, platformName());
}

// The name a merge matches variable names by, which is what 'mergedEnvironment' reads. Only the
// child family needs it, so it is spelled here rather than exported.
platformName() -> string {
    return switch (platformCode()) {
        0 -> "windows",
        2 -> "macos",
        default -> "linux",
    };
}

startedChild(string program, string[] arguments, string[] environmentOverrides) -> ChildProcess throws {
    string[] variables = childVariables(environmentOverrides);
    byte[] block = blocks.environmentBlock(variables);
    ChildHandle? child = ens_start_process(program, blocks.argumentBlock(arguments),
        arguments.length, blocks.commandLineOf(program, arguments), block, variables.length,
        block.length);
    if (child == null) {
        throw new SystemError("could not start '{program}': check that the name is right and that "
            + "the program is where this process can reach it");
    }
    return new ChildProcess(child, program);
}

