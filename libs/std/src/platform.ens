// A system a program can be built for. The members are exactly the systems the compiler can build
// for, so a new one grows this enum rather than being reported as one of these. Each carries the
// number the bridge gives it.
export enum Platform {
    // Windows, where a path is written with '\' and two variable names differing only in ASCII
    // case are one variable.
    Windows = 0,

    // Linux, and every other system whose behavior the compiler treats as Linux's.
    Linux = 1,

    // macOS.
    MacOS = 2,
}
