// One body run over many pieces of data at once. Each call returns once every piece is done, on the
// task that called it, which waits inside the call the whole time. The work is cut into one share
// per processor, each run on a task of its own.
import FrozenList from @std.collections.frozen;
import List from @std.collections.list;
import @std.tasks;
import Cancelled from @std.tasks;
import Task from @std.tasks;
import @std.environment;

// Runs `body` once per item and returns the results in the items' order, however the pieces
// finished. The first piece to throw cancels the others, and the call throws once every piece has
// ended. A task cancelled while it waits throws 'Cancelled'.
export map<shared T, R, E: Error>(T[] items, (shared (T) -> R throws E) body) -> R[]
        throws E, Cancelled {
    let shared = FrozenList.of(items);
    long pieces = pieceCount(items.length);
    return try tasks.scope((scope) -> {
        let started = new List<Task<(() -> List<R> throws E, Cancelled)>>();
        for (long piece = 0; piece < pieces; piece++) {
            long from = shareStart(piece, pieces, items.length);
            long to = shareStart(piece + 1, pieces, items.length);
            started.push(scope.start(() -> try mapped(shared, from, to, body)));
        }
        let results = new List<R>();
        bool stopped = false;
        for (let task in started) {
            let piece = try mappedPiece<R, E>(task);
            if (piece == null) {
                stopped = true;
            } else if (!stopped) {
                results.pushAll(piece);
            }
        }
        if (stopped) {
            throw new Cancelled();
        }
        return results.toArray();
    });
}

// Runs `body` once per item, like 'map' for a body that returns nothing.
export each<shared T, E: Error>(T[] items, (shared (T) -> void throws E) body)
        throws E, Cancelled {
    let shared = FrozenList.of(items);
    long pieces = pieceCount(items.length);
    try tasks.scope((scope) -> {
        let started = new List<Task<(() -> void throws E, Cancelled)>>();
        for (long piece = 0; piece < pieces; piece++) {
            long from = shareStart(piece, pieces, items.length);
            long to = shareStart(piece + 1, pieces, items.length);
            started.push(scope.start(() -> try visited(shared, from, to, body)));
        }
        bool stopped = false;
        for (let task in started) {
            if (!(try finishedPiece<E>(task))) {
                stopped = true;
            }
        }
        if (stopped) {
            throw new Cancelled();
        }
    });
}

// Runs `body` once per index from `start` up to but not including `end`, like 'each'. A range that
// ends where it starts, or before, runs nothing.
export range<E: Error>(long start, long end, (shared (long) -> void throws E) body)
        throws E, Cancelled {
    long length = end > start ? end - start : 0;
    long pieces = pieceCount(length);
    try tasks.scope((scope) -> {
        let started = new List<Task<(() -> void throws E, Cancelled)>>();
        for (long piece = 0; piece < pieces; piece++) {
            long from = start + shareStart(piece, pieces, length);
            long to = start + shareStart(piece + 1, pieces, length);
            started.push(scope.start(() -> try counted(from, to, body)));
        }
        bool stopped = false;
        for (let task in started) {
            if (!(try finishedPiece<E>(task))) {
                stopped = true;
            }
        }
        if (stopped) {
            throw new Cancelled();
        }
    });
}

// Cuts `array` into `parts` disjoint slices, runs `body` once per slice on a task of its own, and
// gives the array back whole once every body has returned. Only the calling task could write the
// array, and it waits inside the call, so each body writes its slice with no copy and no lock. A
// count of parts below one aborts the program.
export split<shared T, E: Error>(T[] array, long parts, (shared (Slice<T>) -> void throws E) body)
        throws E, Cancelled {
    checkParts(parts);
    let lent = new Lent<T>(array);
    try tasks.scope((scope) -> {
        let started = new List<Task<(() -> void throws E, Cancelled)>>();
        for (long part = 0; part < parts; part++) {
            long from = shareStart(part, parts, array.length);
            long to = shareStart(part + 1, parts, array.length);
            started.push(scope.start(() -> try sliced(lent, from, to, body)));
        }
        bool stopped = false;
        for (let task in started) {
            if (!(try finishedPiece<E>(task))) {
                stopped = true;
            }
        }
        if (stopped) {
            throw new Cancelled();
        }
    });
}

// Like 'split', and lends every body a read view of the whole array `other` beside its slice, for
// data each piece reads while it writes its own part. Naming the split array as `other` aborts the
// program, since a piece would read what another writes.
export split<shared T, shared U, E: Error>(T[] array, long parts, Reading<U> other,
        (shared (Slice<T>, ReadView<U>) -> void throws E) body) throws E, Cancelled {
    checkParts(parts);
    if (new Storage().same(array, other.lent.array)) {
        panic("tried to split an array and read the same array beside it, so one piece would read "
            + "what another writes. Read a copy of it, or a different array");
    }
    let lent = new Lent<T>(array);
    let read = other.lent;
    try tasks.scope((scope) -> {
        let started = new List<Task<(() -> void throws E, Cancelled)>>();
        for (long part = 0; part < parts; part++) {
            long from = shareStart(part, parts, array.length);
            long to = shareStart(part + 1, parts, array.length);
            started.push(scope.start(() -> try slicedBeside(lent, from, to, read, body)));
        }
        bool stopped = false;
        for (let task in started) {
            if (!(try finishedPiece<E>(task))) {
                stopped = true;
            }
        }
        if (stopped) {
            throw new Cancelled();
        }
    });
}

// The array `array`, for 'split' to lend every body a read view of beside its slice.
export reading<shared U>(U[] array) -> Reading<U> {
    return new Reading<U>(new Lent<U>(array));
}

// A part of an array, which one body of 'split' reads and writes until it returns. A slice can be
// a parameter or a local, and nothing can keep it longer: it cannot be a field, an array element,
// a type argument or a return value, and no lambda can capture it.
export final class Slice<shared T> {
    const Lent<T> lent;
    const long end;

    // The index of the slice's first element in the array.
    export const long start;

    protected constructor(this.lent, this.start, this.end);

    // How many elements the slice has.
    export length() -> long {
        return this.end - this.start;
    }

    // The element at `index`, counted from the slice's first.
    export get(long index) -> T {
        this.check(index, "read");
        return this.lent.array[this.start + index];
    }

    // Replaces the element at `index`, counted from the slice's first.
    export set(long index, T value) {
        this.check(index, "write");
        this.lent.array[this.start + index] = value;
    }

    check(long index, string attempt) {
        if (index < 0 || index >= this.length()) {
            panic("tried to {attempt} index {index} of a slice of length {this.length()}. Check "
                + "the index against length() first");
        }
    }
}

// An array one body of 'split' reads beside its slice, until it returns. A view can be
// kept no longer than a 'Slice' can.
export final class ReadView<shared U> {
    const Lent<U> lent;

    protected constructor(this.lent);

    // How many elements the array has.
    export length() -> long {
        return this.lent.array.length;
    }

    // The element at `index`.
    export get(long index) -> U {
        if (index < 0 || index >= this.length()) {
            panic("tried to read index {index} of a view of length {this.length()}. Check the "
                + "index against length() first");
        }
        return this.lent.array[index];
    }
}

// An array named for 'split' to lend as a read view, which only 'split' opens.
export final class Reading<shared U> {
    protected const Lent<U> lent;

    protected constructor(this.lent);
}

// The array a 'split' lends its pieces. It crosses to their tasks only inside the call, while the
// task that owns the array waits.
shared final class Lent<T> {
    const T[] array;

    protected constructor(this.array);
}

// Tells two references to one array from two equal arrays, which '==' cannot, since it compares
// contents. The compiler compares the two references, so the body below never runs.
final class Storage {
    protected constructor();

    protected same<A, B>(A[] first, B[] second) -> bool {
        panic("Internal: 'same' is lowered to a comparison of the two references");
    }
}

checkParts(long parts) {
    if (parts < 1) {
        panic("tried to split an array into {parts} parts. Pass a count of at least one");
    }
}

sliced<shared T, E: Error>(Lent<T> lent, long from, long to,
        (shared (Slice<T>) -> void throws E) body) throws E, Cancelled {
    try tasks.checkCancelled();
    try body(new Slice<T>(lent, from, to));
}

slicedBeside<shared T, shared U, E: Error>(Lent<T> lent, long from, long to, Lent<U> read,
        (shared (Slice<T>, ReadView<U>) -> void throws E) body) throws E, Cancelled {
    try tasks.checkCancelled();
    try body(new Slice<T>(lent, from, to), new ReadView<U>(read));
}

// What one piece of 'map' gave: its results, or null when it stopped because another piece threw.
// A piece that throws passes its error on, so the call throws what failed rather than the
// 'Cancelled' of a piece stopped because of it, and a cancel of the calling task stops it.
mappedPiece<R, E: Error>(Task<(() -> List<R> throws E, Cancelled)> task) -> List<R>?
        throws E, Cancelled {
    return try task.await();
} catch (Cancelled stop) {
    if (tasks.isCancelled()) {
        rethrow;
    }
    return null;
}

// Whether one piece of 'each' or 'range' ran to its end, false when it stopped because another
// piece threw, as for 'mappedPiece'.
finishedPiece<E: Error>(Task<(() -> void throws E, Cancelled)> task) -> bool throws E, Cancelled {
    try task.await();
    return true;
} catch (Cancelled stop) {
    if (tasks.isCancelled()) {
        rethrow;
    }
    return false;
}

// How many tasks share `length` pieces of work: one per processor, and never more than the work.
pieceCount(long length) -> long {
    long processors = environment.processorCount();
    return length < processors ? length : processors;
}

// Where share `piece` of `pieces` starts in work `length` long, so the shares differ in length by
// one at most.
shareStart(long piece, long pieces, long length) -> long {
    return piece * length / pieces;
}

mapped<shared T, R, E: Error>(FrozenList<T> items, long from, long to,
        (shared (T) -> R throws E) body) -> List<R> throws E, Cancelled {
    let results = new List<R>();
    for (long i = from; i < to; i++) {
        try tasks.checkCancelled();
        results.push(try body(items.get(i)));
    }
    return results;
}

visited<shared T, E: Error>(FrozenList<T> items, long from, long to,
        (shared (T) -> void throws E) body) throws E, Cancelled {
    for (long i = from; i < to; i++) {
        try tasks.checkCancelled();
        try body(items.get(i));
    }
}

counted<E: Error>(long from, long to, (shared (long) -> void throws E) body)
        throws E, Cancelled {
    for (long i = from; i < to; i++) {
        try tasks.checkCancelled();
        try body(i);
    }
}
