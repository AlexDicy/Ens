// The streams every process is born with. The C library owns their buffering, so what a program
// prints is covered by the flush the runtime forces before a panic, a diagnostic, or a child.
import BufferedReader from @std.io.buffered;
import @std.io.streams;
import IoError from @std.io.streams;
import Reader from @std.io.streams;
import Writer from @std.io.streams;
import CFile from @std.system;
import ThreadLock from @std.system;
import @std.system;

// Standard output, buffered, so a line written here reaches the operating system once that buffer
// fills or something flushes it.
export out() -> Writer {
    return new HandleWriter(system.standardOutput(), "standard output");
}

// Standard error, unbuffered, so what a program reports survives a crash.
export err() -> Writer {
    return new ErrorWriter(new HandleWriter(system.standardError(), "standard error"));
}

// Standard input, as the one reader every call returns. Bytes read ahead cannot be put back,
// so two readers would silently steal from each other.
export in() -> StandardInput {
    return Standard.input;
}

// Everything accepted by `out` but not yet given to the operating system, written to it.
export flush() throws IoError {
    try out().flush();
}

// Where the shared reader is kept, since a value that outlives a call has to belong to a type.
final class Standard {
    protected lazy const StandardInput input = new StandardInput();
}

// Standard input, read through one buffer. Any task may read it, and tasks that read it at the same
// time take turns, each read or line whole.
export shared final class StandardInput implements Reader {
    const ThreadLock lock;
    const BufferedReader buffered;

    protected constructor() {
        this.lock = system.createLock();
        this.buffered = new BufferedReader(new HandleReader(system.standardInput(),
            "standard input"));
    }

    // Bytes out of the buffer, refilling it first when it is empty, and 0 only at the end of the
    // stream.
    export override read(byte[] buffer) -> long throws IoError {
        system.acquireLock(this.lock);
        long count = try this.buffered.read(buffer);
        system.releaseLock(this.lock);
        return count;
    } catch (IoError failure) {
        system.releaseLock(this.lock);
        rethrow;
    }

    // The next line without its ending, or null once the stream has ended. A carriage return
    // before the newline belongs to the ending, and a last line without one is a line of its own.
    export readLine() -> string? throws IoError {
        system.acquireLock(this.lock);
        let line = try this.buffered.readLine();
        system.releaseLock(this.lock);
        return line;
    } catch (IoError failure) {
        system.releaseLock(this.lock);
        rethrow;
    }

    // Everything left in the stream, as bytes.
    export readAll() -> bytes throws IoError {
        system.acquireLock(this.lock);
        bytes all = try this.buffered.readAll();
        system.releaseLock(this.lock);
        return all;
    } catch (IoError failure) {
        system.releaseLock(this.lock);
        rethrow;
    }

    // Everything left in the stream, as text. Bytes that do not spell UTF-8 are refused, since
    // text in Ens is always valid UTF-8.
    export readAllText() -> string throws IoError {
        system.acquireLock(this.lock);
        string all = try this.buffered.readAllText();
        system.releaseLock(this.lock);
        return all;
    } catch (IoError failure) {
        system.releaseLock(this.lock);
        rethrow;
    }
}

// Bytes onto one of the C library's own handles. That library holds whatever buffer there is, so
// this holds nothing and one instance behaves exactly like another.
final class HandleWriter implements Writer {
    const CFile handle;
    const string stream;

    protected constructor(this.handle, this.stream);

    protected override write(bytes data) throws IoError {
        let wrote = system.writeToHandle(this.handle, data);
        if (wrote.code != 0) {
            throw streams.failure("write {data.length} bytes to {this.stream}", wrote.code);
        }
    }

    protected override flush() throws IoError {
        int code = system.flushHandle(this.handle);
        if (code != 0) {
            throw streams.failure("finish writing what was written to {this.stream}", code);
        }
    }
}

// Standard error, which flushes everything already printed before each write, so the two
// streams read in the order the program wrote them.
final class ErrorWriter implements Writer {
    const Writer stream;

    protected constructor(this.stream);

    protected override write(bytes data) throws IoError {
        flushOutput();
        try this.stream.write(data);
    }

    protected override flush() throws IoError {
        try this.stream.flush();
    }
}

// Everything already printed, flushed before a line goes to standard error. A failure is
// dropped deliberately. Writing to standard error is what this call is for, and a standard output
// that cannot be flushed is not a failure that write should report.
flushOutput() {
    try flush();
} catch (IoError ignored) {
}

// Bytes from one of the C library's own handles, as many as have arrived.
final class HandleReader implements Reader {
    const CFile handle;
    const string stream;

    protected constructor(this.handle, this.stream);

    protected override read(byte[] buffer) -> long throws IoError {
        let read = system.readFromHandle(this.handle, buffer);
        if (read.code != 0) {
            throw streams.failure("read {this.stream}", read.code);
        }
        return read.count;
    }
}
