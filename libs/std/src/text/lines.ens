// Splitting a stream of bytes into lines. Bytes are handed in as whoever reads them gets them and
// whole lines are taken out one at a time, so a reader hands over a line the moment its ending
// arrives. Nothing here reads anything itself, so every rule below is about the bytes it was given.

// The bytes of a stream, split into lines as they arrive. A line ends at a newline and carries
// neither that newline nor a carriage return written before it, so text written with Windows line
// endings reads the same as text written with POSIX ones.
public final class LineBuffer {
    byte[] held;
    long start;
    long end;

    public constructor() {
        this.held = new byte[256];
        this.start = 0;
        this.end = 0;
    }

    // Hands in the first `count` bytes of `chunk`, which is what a reader has just read.
    public feed(byte[] chunk, long count) {
        this.makeRoom(count);
        for (long i = 0; i < count; i++) {
            this.held[this.end + i] = chunk[i];
        }
        this.end = this.end + count;
    }

    // The next whole line, or null when the bytes fed so far hold no ending to close one.
    public take() -> string? {
        long at = this.nextEnding();
        if (at < 0) {
            return null;
        }
        string line = this.text(this.start, lineEnd(this.held, this.start, at));
        this.start = at + 1;
        return line;
    }

    // Whether a whole line is held already, which is what tells a reader that taking one needs no
    // more bytes than are here.
    public holdsLine() -> bool {
        return this.nextEnding() >= 0;
    }

    // What is left once no more bytes will come: the text after the last ending as a line of its
    // own, or null when the bytes ended with one. It is given up once, so a second ask answers null.
    public rest() -> string? {
        if (this.start >= this.end) {
            return null;
        }
        string line = this.text(this.start, this.end);
        this.start = this.end;
        return line;
    }

    // How many bytes are held but not yet taken as a line.
    public pending() -> long {
        return this.end - this.start;
    }

    // Where the ending of the next line sits among the held bytes, or -1 when none of them ends one.
    nextEnding() -> long {
        for (long i = this.start; i < this.end; i++) {
            if (this.held[i] == '\n') {
                return i;
            }
        }
        return -1;
    }

    // Bytes a reader handed over can be anything, and a line has to come back all the same, so
    // what spells no character is replaced rather than refused.
    text(long from, long limit) -> string {
        return string.fromBytesLossy(this.held.slice(from, limit));
    }

    // Room for `count` more bytes: what has already been taken is dropped, and the buffer grows
    // when the rest and the new bytes together no longer fit.
    makeRoom(long count) {
        long kept = this.end - this.start;
        byte[] room = this.held;
        if (kept + count > this.held.length) {
            long capacity = this.held.length * 2;
            while (capacity < kept + count) {
                capacity = capacity * 2;
            }
            room = new byte[capacity];
        }
        for (long i = 0; i < kept; i++) {
            room[i] = this.held[this.start + i];
        }
        this.held = room;
        this.start = 0;
        this.end = kept;
    }
}

// Where a line's text ends before the newline at `newline`: one byte earlier when a carriage return
// sits there, because a Windows line ending writes both and neither of them belongs to the line.
lineEnd(byte[] bytes, long from, long newline) -> long {
    if (newline > from && bytes[newline - 1] == '\r') {
        return newline - 1;
    }
    return newline;
}
