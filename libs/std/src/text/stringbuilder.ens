// Accumulates text piece by piece in linear time, where `+` on immutable strings would copy the
// whole prefix on every append.

// A growable buffer of UTF-8 bytes. Every append takes text or a value with a text form, so what
// the buffer holds is valid UTF-8 by construction and `toString` needs no check of its own.
export final class StringBuilder {
    byte[] buffer;
    long count;

    export constructor() {
        this.buffer = new byte[16];
        this.count = 0;
    }

    // A builder whose buffer already holds `capacity` bytes, for text whose size is known ahead.
    export static withCapacity(long capacity) -> StringBuilder {
        let built = new StringBuilder();
        built.reserve(capacity);
        return built;
    }

    export append(string value) {
        this.ensureCapacity(this.count + value.length);
        for (long i = 0; i < value.length; i++) {
            this.buffer[this.count + i] = value.byteAt(i);
        }
        this.count = this.count + value.length;
    }

    // The one character `value` denotes, as its UTF-8 bytes.
    export append(char value) {
        this.append(value.toString());
    }

    export append(long value) {
        this.append(value.toString());
    }

    // The shortest text that reads back as this value, the same as interpolating it.
    export append(double value) {
        this.append(value.toString());
    }

    export append(bool value) {
        this.append(value.toString());
    }

    export appendLine(string value) {
        this.append(value);
        this.appendLine();
    }

    export appendLine() {
        this.append("\n");
    }

    // How many bytes the text built so far holds.
    export length() -> long {
        return this.count;
    }

    export isEmpty() -> bool {
        return this.count == 0;
    }

    // Forgets the text built so far, keeping the buffer for what comes next.
    export clear() {
        this.count = 0;
    }

    // Room for `capacity` bytes in total, so the appends that follow grow the buffer no further.
    export reserve(long capacity) {
        this.ensureCapacity(capacity);
    }

    // The text built so far. The buffer holds only bytes an append put there, so this is the one
    // place text is built from bytes that need no encoding check.
    export override toString() -> string {
        return string.fromBytesUnchecked(this.buffer.slice(0, this.count));
    }

    ensureCapacity(long needed) {
        if (needed <= this.buffer.length) {
            return;
        }
        long grown = this.buffer.length * 2;
        while (grown < needed) {
            grown = grown * 2;
        }
        byte[] wider = new byte[grown];
        for (long i = 0; i < this.count; i++) {
            wider[i] = this.buffer[i];
        }
        this.buffer = wider;
    }
}
