// Reading a value out of text. Every parser answers null for text that spells anything else:
// surrounding whitespace, a radix prefix, and digit grouping are all refused rather than guessed
// at, and so is text spelling a number the type cannot hold.
import @std.system;

// The `long` the text spells in base 10, or null. At most one '-' or '+' comes first, then nothing
// but digits.
export parseLong(string text) -> long? {
    return parseLong(text, 10);
}

// The `long` the text spells in `radix`, from 2 through 36, or null. At most one '-' or '+' comes
// first, then nothing but digits, where the letters stand for the digits above nine in either case,
// since a value reads back however it was typed. A radix outside that range aborts the program.
export parseLong(string text, int radix) -> long? {
    if (radix < 2 || radix > 36) {
        panic("radix {radix} is outside 2 through 36, the bases the digits and letters spell");
    }
    long at = 0;
    bool negative = false;
    if (text.length > 0 && (text.byteAt(0) == '-' || text.byteAt(0) == '+')) {
        negative = text.byteAt(0) == '-';
        at = 1;
    }
    if (at == text.length) {
        return null;
    }
    // The digits accumulate on the negative side of zero, which has room for one more of them, so
    // the smallest long still reads back. A value below the last whole step, or at it with a digit
    // past what is left, would step past that end.
    long step = LongRange.smallest / radix;
    long lastDigit = 0 - (LongRange.smallest - step * radix);
    long value = 0;
    for (long i = at; i < text.length; i++) {
        long digit = digitValue(text.byteAt(i), radix);
        if (digit < 0) {
            return null;
        }
        if (value < step || (value == step && digit > lastDigit)) {
            return null;
        }
        value = value * radix - digit;
    }
    if (negative) {
        return value;
    }
    if (value == LongRange.smallest) {
        return null;
    }
    return 0 - value;
}

// The `int` the text spells in base 10, or null, which a value outside an int's range also is.
export parseInt(string text) -> int? {
    let value = parseLong(text);
    if (value == null || value < -2147483648 || value > 2147483647) {
        return null;
    }
    return value as int;
}

// The `double` the text spells, or null. The text has the shape a floating-point literal has, so
// digits come first, then an optional point with more digits, then an optional exponent.
export parseDouble(string text) -> double? {
    if (!spellsDouble(text)) {
        return null;
    }
    double value = system.parsedDouble(text);
    // A magnitude a double cannot hold arrives as an infinity, and the shape above spells no
    // infinity of its own, so one means the text asked for more than the type holds. A magnitude
    // too small to tell from zero arrives as zero, which the type does hold.
    if (value > DoubleRange.largest || value < 0 - DoubleRange.largest) {
        return null;
    }
    return value;
}

// True or false spelled exactly that way, or null for anything else, "TRUE" and " true " included.
export parseBool(string text) -> bool? {
    if (text == "true") {
        return true;
    }
    if (text == "false") {
        return false;
    }
    return null;
}

// Whether the text spells a floating-point value the way a literal does, without the underscores a
// literal may group its digits with.
spellsDouble(string text) -> bool {
    long at = 0;
    if (at < text.length && (text.byteAt(at) == '-' || text.byteAt(at) == '+')) {
        at = at + 1;
    }
    long whole = digitRun(text, at);
    if (whole == 0) {
        return false;
    }
    at = at + whole;
    if (at < text.length && text.byteAt(at) == '.') {
        long fraction = digitRun(text, at + 1);
        if (fraction == 0) {
            return false;
        }
        at = at + 1 + fraction;
    }
    if (at < text.length && (text.byteAt(at) == 'e' || text.byteAt(at) == 'E')) {
        long signs = 0;
        if (at + 1 < text.length && (text.byteAt(at + 1) == '-' || text.byteAt(at + 1) == '+')) {
            signs = 1;
        }
        long exponent = digitRun(text, at + 1 + signs);
        if (exponent == 0) {
            return false;
        }
        at = at + 1 + signs + exponent;
    }
    return at == text.length;
}

// How many decimal digits sit at `from`, which is none when what is there is not one.
digitRun(string text, long from) -> long {
    long at = from;
    while (at < text.length && text.byteAt(at) >= '0' && text.byteAt(at) <= '9') {
        at = at + 1;
    }
    return at - from;
}

// What digit the byte spells in `radix`, or -1 when it spells none of them.
digitValue(byte value, int radix) -> long {
    long digit = -1;
    if (value >= '0' && value <= '9') {
        digit = value - '0';
    } else if (value >= 'a' && value <= 'z') {
        digit = value - 'a' + 10;
    } else if (value >= 'A' && value <= 'Z') {
        digit = value - 'A' + 10;
    }
    if (digit < 0 || digit >= radix) {
        return -1;
    }
    return digit;
}

final class LongRange {
    // The smallest long, which is the side of zero the digits accumulate on.
    protected static const long smallest = -9223372036854775808;
}

final class DoubleRange {
    // The largest magnitude a double holds, so a value above it is the infinity a too-large text
    // converted to.
    protected static const double largest = 1.7976931348623157e308;
}
