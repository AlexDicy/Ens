// What the number types and `char` can do beyond the operators the compiler provides: their
// order for a sort, the same value written in another base, whether a floating-point value is a
// number at all, and the bits one is made of. Decimal keeps the no-argument `toString` the
// language itself provides, so this module only ever adds the form that takes a radix, which only
// the integer types have.
import @std.system;

primitive byte implements Comparable<byte> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(byte other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive short implements Comparable<short> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this as long, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(short other) -> int {
        return compareSigned(this as long, other as long);
    }
}

primitive ushort implements Comparable<ushort> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(ushort other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive int implements Comparable<int> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this as long, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(int other) -> int {
        return compareSigned(this as long, other as long);
    }
}

primitive uint implements Comparable<uint> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(uint other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive long implements Comparable<long> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(long other) -> int {
        return compareSigned(this, other);
    }
}

primitive ulong implements Comparable<ulong> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(ulong other) -> int {
        return compareUnsigned(this, other);
    }
}

// The edge of the range a `double` covers, which a predicate about a value and a parser reading
// one both measure a magnitude against.
public final class DoubleRange {
    // The largest magnitude a double holds, so a value above it is an infinity.
    public static const double largest = 1.7976931348623157e308;
}

primitive float implements Comparable<float> {
    // Whether this is a NaN, the one value '==' calls unequal to itself.
    export isNaN() -> bool {
        return this != this;
    }

    // Whether this is a number, which every NaN and both infinities are not.
    export isFinite() -> bool {
        return (this as double).isFinite();
    }

    // Whether this is one of the two infinities.
    export isInfinite() -> bool {
        return (this as double).isInfinite();
    }

    // The IEEE bits of this value, with its sign in the top bit. `float.fromBits` reads them back
    // as the value they came from, a NaN's payload included.
    export toBits() -> uint {
        return system.floatBits(this);
    }

    // The value these bits spell. Every pattern spells one, so none of them is refused.
    export static fromBits(uint bits) -> float {
        return system.floatFromBits(bits);
    }

    // The bits of this value, with every NaN written as 0x7FC00000 and every other value left as
    // it is. Two values `compareTo` calls equal give the same pattern, and the two zeros give
    // different patterns, which a struct's own `hash` requires of a floating-point field.
    export toCanonicalBits() -> uint {
        if (this.isNaN()) {
            return 0x7FC00000;
        }
        return this.toBits();
    }

    // Value order, with NaN above every number and level with another NaN, and negative zero just
    // below zero. Those two are where this order and '==' disagree, since '==' calls a NaN unequal
    // to itself and the two zeros equal.
    export override compareTo(float other) -> int {
        return compareFloating(this as double, other as double);
    }
}

primitive double implements Comparable<double> {
    // Whether this is a NaN, the one value '==' calls unequal to itself.
    export isNaN() -> bool {
        return this != this;
    }

    // Whether this is a number, which every NaN and both infinities are not.
    export isFinite() -> bool {
        return this >= -DoubleRange.largest && this <= DoubleRange.largest;
    }

    // Whether this is one of the two infinities.
    export isInfinite() -> bool {
        return this > DoubleRange.largest || this < -DoubleRange.largest;
    }

    // The IEEE bits of this value, with its sign in the top bit. `double.fromBits` reads them back
    // as the value they came from, a NaN's payload included.
    export toBits() -> ulong {
        return system.doubleBits(this);
    }

    // The value these bits spell. Every pattern spells one, so none of them is refused.
    export static fromBits(ulong bits) -> double {
        return system.doubleFromBits(bits);
    }

    // The bits of this value, with every NaN written as 0x7FF8000000000000 and every other value
    // left as it is. Two values `compareTo` calls equal give the same pattern, and the two zeros
    // give different patterns, which a struct's own `hash` requires of a floating-point
    // field.
    export toCanonicalBits() -> ulong {
        if (this.isNaN()) {
            return 0x7FF8000000000000;
        }
        return this.toBits();
    }

    // Value order, with NaN above every number and level with another NaN, and negative zero just
    // below zero. Those two are where this order and '==' disagree, since '==' calls a NaN unequal
    // to itself and the two zeros equal.
    export override compareTo(double other) -> int {
        return compareFloating(this, other);
    }
}

primitive char implements Comparable<char> {
    // Codepoint order, which is also the order the two characters' UTF-8 bytes sort in. A list
    // of characters and the text spelling them therefore agree about which comes first.
    export override compareTo(char other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

// The order of `left` relative to `right`, in the form `Comparable` requires.
compareSigned(long left, long right) -> int {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

// The order of `left` relative to `right`, for values whose top bit a signed comparison would read
// as a sign rather than as magnitude.
compareUnsigned(ulong left, ulong right) -> int {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

// The total order the floating-point types sort in, which gives every value a place where `<`
// and `>` leave a NaN unordered against everything. A NaN orders above every number and level with
// another NaN, and negative zero orders just below zero. A `float` reaches this widened to `double`,
// which is exact and keeps both the sign of a zero and a NaN.
compareFloating(double left, double right) -> int {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    // Neither side is smaller, so these are the same number, two zeros of opposite sign, or at
    // least one NaN.
    bool leftIsNaN = left != left;
    bool rightIsNaN = right != right;
    if (leftIsNaN || rightIsNaN) {
        if (leftIsNaN && rightIsNaN) {
            return 0;
        }
        return leftIsNaN ? 1 : -1;
    }
    bool leftIsNegativeZero = isNegativeZero(left);
    if (leftIsNegativeZero == isNegativeZero(right)) {
        return 0;
    }
    return leftIsNegativeZero ? -1 : 1;
}

// Whether `value` is the negative zero, which `==` does not distinguish from the positive one. Its bits
// are the sign bit and nothing else.
isNegativeZero(double value) -> bool {
    return value.toBits() == 0x8000000000000000;
}

// The digits of a signed value, with '-' in front when it is negative. The magnitude goes through
// `ulong` because the smallest long has no positive form of its own.
signedDigits(long value, int radix) -> string {
    if (value < 0) {
        return "-" + digitsOf(0 - (value as ulong), radix);
    }
    return digitsOf(value as ulong, radix);
}

// The digits of a magnitude, written most significant first. They are built from the end of a
// buffer wide enough for the longest form, 64 digits of base 2, so nothing has to be reversed.
digitsOf(ulong value, int radix) -> string {
    if (radix < 2 || radix > 36) {
        panic("tried to write a number in radix {radix}, which is outside 2 through 36, the "
            + "bases the digits and letters spell");
    }
    ulong base = radix as ulong;
    byte[] written = new byte[64];
    long at = written.length;
    ulong rest = value;
    while (true) {
        at = at - 1;
        written[at] = Digits.lowercase.byteAt((rest % base) as long);
        rest = rest / base;
        if (rest == 0) {
            return string.fromBytesUnchecked(written.slice(at, written.length));
        }
    }
}

final class Digits {
    // What every base up to 36 spells its digits with. Lowercase, so one value reads the same
    // however it was written, and in value order, so the digit for a remainder is at that offset.
    protected static const string lowercase = "0123456789abcdefghijklmnopqrstuvwxyz";
}
