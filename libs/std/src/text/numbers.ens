// What the integer types and `char` can do beyond the operators the compiler provides: their
// order for a sort, and the same value written in another base. Decimal keeps the no-argument
// `toString` the language itself provides, so this module only ever adds the form that takes a
// radix.

primitive byte implements Comparable<byte> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(byte other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive short implements Comparable<short> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this as long, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(short other) -> int {
        return compareSigned(this as long, other as long);
    }
}

primitive ushort implements Comparable<ushort> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(ushort other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive int implements Comparable<int> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this as long, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(int other) -> int {
        return compareSigned(this as long, other as long);
    }
}

primitive uint implements Comparable<uint> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this as ulong, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(uint other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

primitive long implements Comparable<long> {
    // The value in `radix`, from 2 through 36, using lowercase digits, with '-' in front when
    // it is negative; a radix outside that range aborts the program.
    export toString(int radix) -> string {
        return signedDigits(this, radix);
    }

    // Value order, so every negative value sorts below every non-negative one.
    export override compareTo(long other) -> int {
        return compareSigned(this, other);
    }
}

primitive ulong implements Comparable<ulong> {
    // The value in `radix`, from 2 through 36, using lowercase digits; a radix outside that
    // range aborts the program.
    export toString(int radix) -> string {
        return digitsOf(this, radix);
    }

    // Value order, which runs to the top of the range because an unsigned value is never
    // negative.
    export override compareTo(ulong other) -> int {
        return compareUnsigned(this, other);
    }
}

primitive char implements Comparable<char> {
    // Codepoint order, which is also the order the two characters' UTF-8 bytes sort in. A list
    // of characters and the text spelling them therefore agree about which comes first.
    export override compareTo(char other) -> int {
        return compareUnsigned(this as ulong, other as ulong);
    }
}

// Where `left` sits relative to `right`, in the form `Comparable` asks for.
compareSigned(long left, long right) -> int {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

// Where `left` sits relative to `right`, for values whose top bit a signed comparison would read
// as a sign rather than as magnitude.
compareUnsigned(ulong left, ulong right) -> int {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

// The digits of a signed value, with '-' in front when it is negative. The magnitude goes through
// `ulong` because the smallest long has no positive form of its own.
signedDigits(long value, int radix) -> string {
    if (value < 0) {
        return "-" + digitsOf(0 - (value as ulong), radix);
    }
    return digitsOf(value as ulong, radix);
}

// The digits of a magnitude, written most significant first. They are built from the end of a
// buffer wide enough for the longest form, 64 digits of base 2, so nothing has to be reversed.
digitsOf(ulong value, int radix) -> string {
    if (radix < 2 || radix > 36) {
        panic("radix {radix} is outside 2 through 36, the bases the digits and letters spell");
    }
    ulong base = radix as ulong;
    byte[] written = new byte[64];
    long at = written.length;
    ulong rest = value;
    while (true) {
        at = at - 1;
        written[at] = Digits.lowercase.byteAt((rest % base) as long);
        rest = rest / base;
        if (rest == 0) {
            return string.fromBytesUnchecked(written.slice(at, written.length));
        }
    }
}

final class Digits {
    // What every base up to 36 spells its digits with. Lowercase, so one value reads the same
    // however it was written, and in value order, so the digit for a remainder is at that offset.
    protected static const string lowercase = "0123456789abcdefghijklmnopqrstuvwxyz";
}
