// Text as values: taking it apart, putting it back together, and reading a number out of it. An Ens
// string never changes, so every function here answers with new text and leaves what it was given
// as it was.
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

// The parts of `text` between the occurrences of `separator`, in order. Two neighboring separators
// give an empty part, text holding no separator at all gives one part - the text itself - and an
// empty separator has nothing to split on and does the same.
export split(string text, string separator) -> string[] {
    let parts = new List<string>();
    if (separator.length == 0) {
        parts.push(text);
        return parts.toArray();
    }
    string rest = text;
    while (true) {
        long at = rest.indexOf(separator);
        if (at < 0) {
            parts.push(rest);
            break;
        }
        parts.push(rest.substring(0, at));
        rest = rest.substring(at + separator.length, rest.length);
    }
    return parts.toArray();
}

// The lines of `text`, split on '\n' with a trailing '\r' dropped from each, so text written with
// either line ending reads the same. Text ending in a newline has a last, empty line.
export lines(string text) -> string[] {
    string[] parts = split(text, "\n");
    for (long i = 0; i < parts.length; i++) {
        if (parts[i].endsWith("\r")) {
            parts[i] = parts[i].substring(0, parts[i].length - 1);
        }
    }
    return parts;
}

// `parts` with `separator` between neighbors, and nothing before the first part or after the last.
export joined(string[] parts, string separator) -> string {
    let builder = new StringBuilder();
    for (long i = 0; i < parts.length; i++) {
        if (i > 0) {
            builder.append(separator);
        }
        builder.append(parts[i]);
    }
    return builder.toString();
}

// The number `text` spells, or null when it spells anything else: a '-' or '+' at most, then
// nothing but digits, and a value a `long` can hold. Surrounding whitespace, a radix prefix, and
// digit grouping are all refused rather than guessed at.
export parseInteger(string text) -> long? {
    byte[] raw = text.toBytes();
    long at = 0;
    bool negative = false;
    if (raw.length > 0 && (raw[0] == '-' || raw[0] == '+')) {
        negative = raw[0] == '-';
        at = 1;
    }
    if (at == raw.length) {
        return null;
    }
    // The digits accumulate as a negative value, the side of zero with room for one more of them,
    // so the smallest long still reads back. That value's tenth is -922337203685477580, so a value
    // below it, or at it with a digit past 8, would step past the smallest long.
    long tenth = -922337203685477580;
    long value = 0;
    for (long i = at; i < raw.length; i++) {
        if (raw[i] < '0' || raw[i] > '9') {
            return null;
        }
        long digit = raw[i] - '0';
        if (value < tenth || (value == tenth && digit > 8)) {
            return null;
        }
        value = value * 10 - digit;
    }
    if (negative) {
        return value;
    }
    if (value < -9223372036854775807) {
        return null;
    }
    return 0 - value;
}
