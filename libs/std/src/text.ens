// The failure text itself raises: bytes that do not spell UTF-8. The one condition needs no kind,
// so the offset of the first bad sequence is what the error carries instead.

// Bytes that are not valid UTF-8, where `offset` is where the first sequence that fits no
// character begins. Text in Ens is always valid UTF-8, so this is what refuses bytes that are not.
export class EncodingError extends Error {
    export const long offset;

    export constructor(string message, this.offset, Error? cause = null) {
        super(message, cause);
    }
}
