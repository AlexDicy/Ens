// Why a start of a program failed, in the words a message gives after "could not start
// '<program>':". The bridges carry what part of the start the system's number is about in the bits
// above the number, and the reason is chosen by that part and by the kind of the number.
import ErrorKind from @std.process;
import @std.process;
import EntryKind from @std.fs.metadata;
import Metadata from @std.fs.metadata;
import CFile from @std.system;
import Platform from @std.platform;
import @std.system;

// The system's own number in a code a start reported.
public startNumber(int code) -> int {
    return code & StartCode.numberMask;
}

// Why the start of `program`, tried at `path` in `directory`, failed with `code`, with what the
// file system shows about the cases whose reason names more: a program on Windows that is there
// with '.exe' after its name, and the program a script's first line names.
public startReasonAt(string program, string path, string directory, int code) -> string {
    string suggested = "";
    let part = startPartOf(code);
    if (process.kindFromCode(startNumber(code)) == ErrorKind.NotFound
            && part == StartPart.Program) {
        suggested = exeBeside(program, path);
    }
    FirstLine line = {program: "", longerThan: 0};
    if (part == StartPart.MissingInterpreter || part == StartPart.RefusedScript) {
        line = firstLineOf(path, system.platform());
    }
    return startReason(directory, code, system.platform(), suggested, line);
}

// Why a start in `directory`, empty for a start in this process's own, failed with `code` on
// `platform`. A code with nothing above its number comes from setting the start up, such as making
// its pipes, and never from the program or the working directory, so its reason is the condition
// the number means. `suggested` is the name to offer for a program that is not there, empty when
// there is none, and `line` what the first line of a script names.
public startReason(string directory, int code, Platform platform, string suggested,
                   FirstLine line) -> string {
    int number = startNumber(code);
    let kind = process.kindFromCode(number);
    return switch (startPartOf(code)) {
        StartPart.WorkingDirectory -> directoryReason(directory, kind, number),
        StartPart.WorkingDirectoryFile -> "the working directory '{directory}' is a file, not a "
            + "directory. Start the program in a directory",
        StartPart.Directory -> "it is a directory, not a program. Name the program inside the "
            + "directory",
        StartPart.NotRunnable -> "it is not a program this system can run. Check that the path "
            + "names a program built for this system",
        StartPart.NotProgram -> "it is not a program. Check that the path names a program, not a "
            + "document or data file",
        StartPart.SpecialFile -> "it is a special file, such as a named pipe or a device, not a "
            + "program. Name the program's own file instead",
        StartPart.MissingInterpreter -> interpreterReason(line.program),
        StartPart.RefusedScript -> refusedScriptReason(line, kind, platform),
        StartPart.NoProgramStart -> "it does not start the way a program does. If it is a "
            + "script, make its first line name the program that runs it, as in '#!/bin/sh'",
        StartPart.RefusedOnPath -> "permission was refused. Check that the file is executable, "
            + "as with 'chmod +x', and that this user may open every directory on its path",
        StartPart.Program -> programReason(kind, number, platform, suggested),
        StartPart.Unplaced -> setupReason(conditionOf(number), number),
    };
}

// Why a program written as a bare name was found in no directory the PATH variable lists.
public notOnPathReason() -> string {
    return "no directory that the PATH environment variable lists contains a program of that "
        + "name. Check the name, or give the program's full path";
}

// Why a start failed with the system's number `number`, which means `condition`, while it was set
// up, before any program was tried.
public setupReason(StartCondition condition, int number) -> string {
    string reported = "the system reported error {number}";
    return switch (condition) {
        StartCondition.OutOfMemory -> "there was not enough memory to prepare the new process: "
            + reported,
        StartCondition.ProgramFileLimit -> "the program starting it has reached its limit on open "
            + "files: {reported}. Close files that program no longer needs, or raise the limit "
            + "with 'ulimit -n' before running that program again",
        StartCondition.SystemFileLimit -> "the system has reached its limit on how many files all "
            + "programs together may have open: {reported}. Close programs that are no longer "
            + "needed",
        StartCondition.ProcessLimit -> "the system allows no more processes, for this user or in "
            + "total: {reported}. Wait for some programs to end, or raise this user's limit with "
            + "'ulimit -u'",
        StartCondition.SystemResources -> "there were not enough system resources to prepare the "
            + "new process: {reported}",
        StartCondition.NotFound, StartCondition.PermissionDenied, StartCondition.FileBeingWritten,
            StartCondition.Other -> "the new process could not be prepared: {reported}",
    };
}

// What the system's number `number` from a failed start means.
public conditionOf(int number) -> StartCondition {
    return system.processErrorKind(number) as? StartCondition ?? StartCondition.Other;
}

// What a failed start's number can mean, each condition carrying the ordinal the process bridge
// gives it: nothing at the path, a refused permission, no memory left, no more files the program
// doing the start may open, no more files the whole system may have open, no more processes, no
// more of the resources Windows sets aside for its own use, a program file still open for writing,
// and anything else. ErrorKind names the first two, and reports every other one as Other.
public enum StartCondition {
    NotFound = 0,
    PermissionDenied = 1,
    OutOfMemory = 2,
    ProgramFileLimit = 3,
    SystemFileLimit = 4,
    ProcessLimit = 5,
    SystemResources = 6,
    FileBeingWritten = 7,
    Other = 8,
}

// Why the program itself could not be started.
programReason(ErrorKind kind, int number, Platform platform, string suggested) -> string {
    if (kind == ErrorKind.NotFound && !suggested.isEmpty()) {
        return "nothing is there, but '{suggested}' is. Write the name with its '.exe'";
    }
    if (conditionOf(number) == StartCondition.FileBeingWritten) {
        return "the file is still open for writing, in this program or another one. Finish "
            + "writing it and close it before starting it";
    }
    return switch (kind) {
        ErrorKind.NotFound -> "nothing is there. Check that the path names the program",
        ErrorKind.PermissionDenied -> permissionReason(platform),
        ErrorKind.Other -> "the system reported error {number}",
    };
}

// Why a script whose first line names a program that is not there could not be started.
interpreterReason(string interpreter) -> string {
    string fix = "Correct the first line, or install that program";
    if (interpreter.isEmpty()) {
        return "its first line names a program that is not there. {fix}";
    }
    return "its first line names '{interpreter}', which is not there. {fix}";
}

// Why a script whose first line names a program that is there could not be started.
refusedScriptReason(FirstLine line, ErrorKind kind, Platform platform) -> string {
    if (kind == ErrorKind.PermissionDenied) {
        return refusedInterpreterReason(line.program);
    }
    if (line.longerThan > 0) {
        string shorten = "Shorten the path of the program it names";
        if (platform == Platform.MacOS) {
            shorten = shorten + ", or the arguments after it";
        }
        return "its first line is longer than the {line.longerThan} bytes this system reads of "
            + "it. {shorten}";
    }
    string fix = "Make the first line name a program, as in '#!/bin/sh'";
    if (line.program.isEmpty()) {
        return "its first line names no program this system can run. {fix}";
    }
    return "its first line names '{line.program}', which is not a program this system can run. "
        + fix;
}

// Why a script that may run was refused over the program its first line names, `interpreter`,
// empty when the line could not be read.
refusedInterpreterReason(string interpreter) -> string {
    if (interpreter.isEmpty()) {
        return "its first line names a program this user may not run. Make the first line name "
            + "a program this user may run";
    }
    if (kindAt(interpreter) == EntryKind.Directory) {
        return "its first line names '{interpreter}', which is a directory, not a program. Make "
            + "the first line name a program, as in '#!/bin/sh'";
    }
    return "its first line names '{interpreter}', which this user may not run. Make "
        + "'{interpreter}' executable, as with 'chmod +x', or make the first line name a program "
        + "this user may run";
}

// The program's name with '.exe' after it, when Windows was given a path with no extension and a
// program of that name and '.exe' is there, and empty otherwise.
exeBeside(string program, string path) -> string {
    if (system.platform() != Platform.Windows || hasExtension(path)) {
        return "";
    }
    if (kindAt(path + ".exe") == EntryKind.File) {
        return program + ".exe";
    }
    return "";
}

// Whether the name `path` ends in has a '.' after its first character, the way an extension is
// written.
hasExtension(string path) -> bool {
    long nameStart = 0;
    for (long i = 0; i < path.length; i++) {
        byte at = path.byteAt(i);
        if (at == '/' || (at == '\\' && system.platform() == Platform.Windows)) {
            nameStart = i + 1;
        }
    }
    long dot = path.lastIndexOf(".");
    return dot > nameStart;
}

// What is at `path` with links followed, and null when nothing can be read there.
kindAt(string path) -> EntryKind? {
    let found = system.fsMetadata(path, true);
    if (found.code != 0) {
        return null;
    }
    return Metadata.kindFromCode(found.kind);
}

// What the first line of a script names after its '#!': the program, empty when it names none or
// the file cannot be read, and the bytes of the line the system reads when the program's name runs
// past them, 0 when it does not.
public struct FirstLine {
    public const string program;
    public const long longerThan;
}

// The first line of the script at `path` as the system `platform` names reads it.
public firstLineOf(string path, Platform platform) -> FirstLine {
    FirstLine none = {program: "", longerThan: 0};
    long limit = ScriptLine.linux;
    if (platform == Platform.MacOS) {
        limit = ScriptLine.macOS;
    }
    let opened = system.fsOpen(path, 0);
    CFile? handle = opened.handle;
    if (handle == null) {
        return none;
    }
    byte[] buffer = new byte[limit];
    let read = system.readFromHandle(handle, buffer);
    long count = read.code == 0 ? read.count : 0;
    int closed = system.closeHandle(handle);
    if (count < 2 || buffer[0] != '#' || buffer[1] != '!') {
        return none;
    }
    long start = 2;
    while (start < count && (buffer[start] == ' ' || buffer[start] == '\t')) {
        start++;
    }
    long end = start;
    while (end < count && buffer[end] != ' ' && buffer[end] != '\t' && buffer[end] != '\n'
            && buffer[end] != '\r') {
        end++;
    }
    if (end == limit) {
        return {program: "", longerThan: limit};
    }
    return {program: string.fromBytesLossy(bytes.of(buffer.slice(start, end))), longerThan: 0};
}

// How many bytes of a script's first line each system reads to find the program it names.
final class ScriptLine {
    protected static const long linux = 256;
    protected static const long macOS = 512;
}

// A file the system refused to run. POSIX runs a file only when it is marked executable.
permissionReason(Platform platform) -> string {
    if (platform == Platform.Windows) {
        return "permission was refused. Check that this user may run the file";
    }
    return "permission was refused. Make the file executable, as with 'chmod +x', or start it as "
        + "a user who may run it";
}

// Why the working directory the program was to start in could not be entered.
directoryReason(string directory, ErrorKind kind, int number) -> string {
    return switch (kind) {
        ErrorKind.NotFound -> "the working directory '{directory}', the directory the program "
            + "would run in, is not a directory that exists. Create it, or start the program in "
            + "one that does",
        ErrorKind.PermissionDenied -> "permission to enter the working directory '{directory}' "
            + "was refused. Start the program in a directory this user may enter",
        ErrorKind.Other -> "the working directory '{directory}' could not be entered: the "
            + "system reported error {number}",
    };
}

// The part of a start a failure's code names: none, the program, the working directory, a program
// path that names a directory, a program built for another system, a file that is no program, a
// special file such as a named pipe, a working directory that is a file, a script whose first line
// names a program that is not there, a runnable file that starts neither as a program nor as a
// script, a refused permission on a file that is runnable, or a script the system would not start
// although the program its first line names is there. Each part carries the number the bridges give
// it.
public enum StartPart {
    Unplaced = 0,
    Program = 1,
    WorkingDirectory = 2,
    Directory = 3,
    NotRunnable = 4,
    NotProgram = 5,
    SpecialFile = 6,
    WorkingDirectoryFile = 7,
    MissingInterpreter = 8,
    NoProgramStart = 9,
    RefusedOnPath = 10,
    RefusedScript = 11,
}

// The part the bits above the system's number name, and Unplaced for a number no part has.
public startPartOf(int code) -> StartPart {
    return ((code >> StartCode.shift) & 0xFF) as? StartPart ?? StartPart.Unplaced;
}

// Where a failure's code holds the system's number and the part of the start above it.
final class StartCode {
    protected static const int shift = 24;
    protected static const int numberMask = 0xFFFFFF;
}
