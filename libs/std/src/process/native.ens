// What a child's start needs that only this machine can supply: the entries of an environment in
// the order a system requires them in, the head of a Win32 command line, the search for a program on
// PATH, and the numbers a platform reports for a pipe nobody reads. Only the search touches the
// disk. The shapes that are a rule about values alone are in '@std.process.blocks', which is what
// lets a program that only prints a line keep the file system out of its build.
import Environment from @std.environment;
import Platform from @std.environment;
import Path from @std.fs;
import List from @std.collections.list;
import @std.process.blocks;

// The variables of `environment` as the 'NAME=VALUE' entries a child's block is built from, in the
// order `platform` requires. Windows requires a block sorted without regard to case, since that
// is how it looks a name up, and everywhere else byte order of name serves.
public environmentEntries(Environment environment, Platform platform) -> string[] {
    let entries = new List<string>();
    for (let name in environment.names()) {
        entries.push(name + "=" + (environment.get(name) ?? ""));
    }
    if (platform == Platform.Windows) {
        entries.sort((left, right) ->
            compareIgnoringCase(blocks.nameOf(left), blocks.nameOf(right)));
    }
    return entries.toArray();
}

// Case-insensitive order over ASCII, with byte order deciding between two spellings of one name.
compareIgnoringCase(string left, string right) -> int {
    int folded = left.toUpperAscii().compareTo(right.toUpperAscii());
    if (folded != 0) {
        return folded;
    }
    return left.compareTo(right);
}

// The program's text as the head of its command line. On Windows it is written with '\', because
// cmd.exe reads a '/' in its own name as the start of a switch and then refuses the line; elsewhere
// the text is kept, since only Win32 reads the line at all.
public commandLineProgram(string program, Platform platform) -> string {
    if (platform == Platform.Windows) {
        return program.replace("/", "\\");
    }
    return program;
}

// Where a program named with no separator may be, one place under each directory `pathValue`
// lists, in that order. The value is split at ';' on Windows and at ':' elsewhere, and an empty
// entry is left out, because it names the current directory, which is never searched. On Windows
// the name is looked for as written when it has an extension and as `name.exe` otherwise, and a
// directory written in quotes is read without them.
public candidatesOnPath(string name, string pathValue, Platform platform) -> Path[] {
    string separator = ":";
    string fileName = name;
    if (platform == Platform.Windows) {
        separator = ";";
        if (Path(name).extension().isEmpty()) {
            fileName = name + ".exe";
        }
    }
    let candidates = new List<Path>();
    for (let entry in pathValue.split(separator)) {
        string directory = entry;
        if (platform == Platform.Windows) {
            directory = entry.replace("\"", "");
        }
        if (directory.isEmpty()) {
            continue;
        }
        candidates.push(Path.fromNative(directory, platform).join(fileName));
    }
    return candidates.toArray();
}

// Every file of that name in a PATH directory, in PATH's order and made absolute so both platforms
// hand the child's start the same text, for a start to try in turn until one runs. On Windows the
// first alone, because CreateProcess stops at the first `name.exe` it finds and there is no
// execute bit a later one could be preferred for. A null `pathValue` is a PATH that is not set,
// which holds no directory.
public programsOnPath(string name, string? pathValue, Platform platform) -> Path[] {
    let found = new List<Path>();
    if (pathValue == null) {
        return found.toArray();
    }
    for (let candidate in candidatesOnPath(name, pathValue, platform)) {
        if (candidate.isFile()) {
            found.push(candidate.absolute());
            if (platform == Platform.Windows) {
                break;
            }
        }
    }
    return found.toArray();
}

// Whether a write failed because nothing reads the pipe any more. A process bridge returns the
// platform's own number, which is a Win32 number on Windows and errno elsewhere, so a closed pipe
// is identified by each platform's own number rather than through the errno table '@std.io.streams'
// reads.
public meansPipeClosed(int code, Platform platform) -> bool {
    if (platform == Platform.Windows) {
        return code == ClosedPipe.errorNoData || code == ClosedPipe.errorBrokenPipe;
    }
    return code == ClosedPipe.epipe;
}

// The numbers a system reports for a write to a pipe whose reader has gone.
final class ClosedPipe {
    protected static const int epipe = 32;
    protected static const int errorBrokenPipe = 109;
    protected static const int errorNoData = 232;
}
