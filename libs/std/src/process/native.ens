// The shapes a child's start needs its inputs in, the search for a program on PATH, and the numbers
// a platform reports for a pipe nobody reads. Only the search touches the disk.
import Environment from @std.environment;
import Platform from @std.environment;
import Path from @std.fs;
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

// Every value's bytes with a NUL after each of them, which is the block a C argument vector points
// into. A value holding a NUL byte cannot cross into a C string and is cut there.
public argumentBlock(string[] arguments) -> byte[] {
    return separatedBlock(arguments, 0);
}

// Every variable's bytes with a NUL after each of them and one more NUL closing the block, which
// is the block a Win32 environment is passed as. A variable holding a NUL byte cannot cross into a
// C string and is cut there. An empty environment gives an empty block, which a spawn reads as
// "inherit unchanged".
public environmentBlock(string[] variables) -> byte[] {
    if (variables.length == 0) {
        return new byte[0];
    }
    return separatedBlock(variables, 1);
}

// Every variable's bytes with a NUL after each of them and one more NUL closing the block. No
// variables at all is the closing NUL and the empty entry before it, which is the smallest block
// Windows reads as an environment.
public givenEnvironmentBlock(string[] variables) -> byte[] {
    if (variables.length == 0) {
        return [0, 0];
    }
    return separatedBlock(variables, 1);
}

separatedBlock(string[] values, long trailing) -> byte[] {
    long total = trailing;
    for (long i = 0; i < values.length; i++) {
        total = total + values[i].length + 1;
    }
    byte[] block = new byte[total];
    long at = 0;
    for (long i = 0; i < values.length; i++) {
        byte[] raw = values[i].toBytes();
        for (long b = 0; b < raw.length; b++) {
            block[at] = raw[b];
            at = at + 1;
        }
        block[at] = 0;
        at = at + 1;
    }
    return block;
}

// The variables of `environment` as the 'NAME=VALUE' entries a child's block is built from, in the
// order `platform` wants them. Windows requires a block sorted without regard to case, since that
// is how it looks a name up, and everywhere else byte order of name serves.
public environmentEntries(Environment environment, Platform platform) -> string[] {
    let entries = new List<string>();
    for (let name in environment.names()) {
        entries.push(name + "=" + (environment.get(name) ?? ""));
    }
    if (platform == Platform.Windows) {
        entries.sort((left, right) -> compareIgnoringCase(nameOf(left), nameOf(right)));
    }
    return entries.toArray();
}

// Case-insensitive order over ASCII, with byte order deciding between two spellings of one name.
compareIgnoringCase(string left, string right) -> int {
    int folded = left.toUpperAscii().compareTo(right.toUpperAscii());
    if (folded != 0) {
        return folded;
    }
    return left.compareTo(right);
}

// The inherited environment with the overrides applied over it, in order, so the child sees one
// entry per name and keeps everything it was not given a new value for. On "windows" two names
// match without regard to case, the way that system matches them, so an override reaches the
// inherited entry however that entry spells its name; everywhere else 'PATH' and 'path' are two
// variables and both survive. The system is passed in rather than asked for, so both rules are a
// rule about the values handed to this function.
public mergedEnvironment(string[] inherited, string[] overrides, string platform) -> string[] {
    bool ignoringCase = platform == "windows";
    let merged = new List<string>();
    for (let entry in inherited) {
        if (!overriddenName(overrides, nameOf(entry), ignoringCase)) {
            merged.push(entry);
        }
    }
    for (let entry in overrides) {
        merged.push(entry);
    }
    merged.sort();
    return merged.toArray();
}

// The name an environment entry sets, which is everything before the first '='. An entry with no
// '=' names itself.
public nameOf(string entry) -> string {
    long separator = entry.indexOf("=");
    if (separator < 0) {
        return entry;
    }
    return entry.substring(0, separator);
}

overriddenName(string[] overrides, string name, bool ignoringCase) -> bool {
    for (let entry in overrides) {
        if (sameName(nameOf(entry), name, ignoringCase)) {
            return true;
        }
    }
    return false;
}

sameName(string left, string right, bool ignoringCase) -> bool {
    if (!ignoringCase) {
        return left == right;
    }
    return left.equalsIgnoreCaseAscii(right);
}

// The program and its arguments as one command line, which is the form Win32 hands a program. A
// part is quoted only where the program would otherwise split it differently, so the parts come
// back as exactly these values and a bare switch such as /C stays bare, which is how cmd.exe
// reads its own.
public commandLineOf(string program, string[] arguments) -> string {
    let line = new StringBuilder();
    line.append(quoted(program));
    for (long i = 0; i < arguments.length; i++) {
        line.append(" ");
        line.append(quoted(arguments[i]));
    }
    return line.toString();
}

// The program's text as the head of its command line. On Windows it is written with '\', because
// cmd.exe reads a '/' in its own name as the start of a switch and then refuses the line; elsewhere
// the text is kept, since only Win32 reads the line at all.
public commandLineProgram(string program, Platform platform) -> string {
    if (platform == Platform.Windows) {
        return program.replace("/", "\\");
    }
    return program;
}

// The command line that runs `line` through cmd.exe as written. After /S cmd strips the first and
// last quote of what follows /C and runs the rest, so the line inside may hold quotes of its own.
public shellCommandLine(string interpreter, string line) -> string {
    return "\"" + interpreter + "\" /S /C \"" + line + "\"";
}

// One part, in double quotes when it is empty or holds a space, a tab or a quote. A backslash is
// literal except where it would escape the closing quote, so a run of backslashes before a quote
// or at the very end is doubled.
quoted(string value) -> string {
    if (!needsQuotes(value)) {
        return value;
    }
    let part = new StringBuilder();
    part.append('"');
    long backslashes = 0;
    for (let character in value.chars()) {
        if (character == '\\') {
            backslashes = backslashes + 1;
            continue;
        }
        if (character == '"') {
            appendBackslashes(part, backslashes * 2 + 1);
        } else {
            appendBackslashes(part, backslashes);
        }
        part.append(character);
        backslashes = 0;
    }
    appendBackslashes(part, backslashes * 2);
    part.append('"');
    return part.toString();
}

needsQuotes(string value) -> bool {
    return value.isEmpty() || value.contains(" ") || value.contains("\t")
        || value.contains("\"");
}

appendBackslashes(StringBuilder part, long count) {
    for (long i = 0; i < count; i++) {
        part.append('\\');
    }
}

// Where a program named with no separator may be, one place under each directory `pathValue`
// lists, in that order. The value is split at ';' on Windows and at ':' elsewhere, and an empty
// entry is left out, because it names the current directory, which is never searched. On Windows
// the name is looked for as written when it has an extension and as `name.exe` otherwise, and a
// directory written in quotes is read without them.
public candidatesOnPath(string name, string pathValue, Platform platform) -> Path[] {
    string separator = ":";
    string fileName = name;
    if (platform == Platform.Windows) {
        separator = ";";
        if (Path(name).extension().isEmpty()) {
            fileName = name + ".exe";
        }
    }
    let candidates = new List<Path>();
    for (let entry in pathValue.split(separator)) {
        string directory = entry;
        if (platform == Platform.Windows) {
            directory = entry.replace("\"", "");
        }
        if (directory.isEmpty()) {
            continue;
        }
        candidates.push(Path.fromNative(directory, platform).join(fileName));
    }
    return candidates.toArray();
}

// Every file of that name in a PATH directory, in PATH's order and made absolute so both platforms
// hand the child's start the same text, for a start to try in turn until one runs. On Windows the
// first alone, because CreateProcess stops at the first `name.exe` it finds and there is no
// execute bit a later one could be preferred for. A null `pathValue` is a PATH that is not set,
// which holds no directory.
public programsOnPath(string name, string? pathValue, Platform platform) -> Path[] {
    let found = new List<Path>();
    if (pathValue == null) {
        return found.toArray();
    }
    for (let candidate in candidatesOnPath(name, pathValue, platform)) {
        if (candidate.isFile()) {
            found.push(candidate.absolute());
            if (platform == Platform.Windows) {
                break;
            }
        }
    }
    return found.toArray();
}

// Whether a write failed because nothing reads the pipe any more, which POSIX reports as EPIPE and
// Windows as ERROR_NO_DATA or ERROR_BROKEN_PIPE.
public meansPipeClosed(int code, Platform platform) -> bool {
    if (platform == Platform.Windows) {
        return code == ClosedPipe.errorNoData || code == ClosedPipe.errorBrokenPipe;
    }
    return code == ClosedPipe.epipe;
}

// The numbers a system reports for a write to a pipe whose reader has gone.
final class ClosedPipe {
    protected static const int epipe = 32;
    protected static const int errorBrokenPipe = 109;
    protected static const int errorNoData = 232;
}
