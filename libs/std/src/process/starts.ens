// The children this process is making. A child holds a copy of every file this process had open
// when the child was made until it runs its program, so a file this process has closed can stay
// open, and its lock held, until each child made before the close has been made.
import NativeChild from @std.system;
import SharedLock from @std.tasks;

public final class ChildStarts {
    protected lazy const SharedLock making = new SharedLock();

    // Makes a child with `start`, beside any other child being made.
    public static make((() -> NativeChild) start) -> NativeChild {
        ChildStarts.making.enterShared();
        let made = start();
        ChildStarts.making.leaveShared();
        return made;
    }

    // Waits until every child being made when it was called has been made, so none of them still
    // holds a copy of a file this process closed before the call.
    public static settle() {
        ChildStarts.making.enterAlone();
        ChildStarts.making.leaveAlone();
    }
}
