// The names every module can use without writing an import: the base class of every exception
// and the frames its captured stack trace resolves to.
export class StackFrame {
    export string function;
    export string file;
    export int line;

    export constructor(this.function, this.file, this.line);
}

export class Error {
    export string message;

    // Return addresses captured where this error was thrown, symbolicated only when read.
    long[]? frames;

    export constructor(this.message);

    // Both bodies are placeholders: the compiler lowers these calls to the trace runtime and
    // never emits them.
    export stackTrace() -> string {
        return "";
    }

    export stackFrames() -> StackFrame[] {
        return [new StackFrame("", "", 0)];
    }
}
