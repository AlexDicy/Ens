// What a test throws to fail, and the assertions that throw it. A failure's message points at the
// first difference rather than printing two long values, and a failure raised in response to
// another error carries it as the cause.
import @std.text.strings;

export class TestFailure extends Error {
    export constructor(string message, Error? cause = null) {
        super(message, cause);
    }
}

export assertEqual<T>(T actual, T expected) throws TestFailure {
    if (actual == expected) {
        return;
    }
    throw new TestFailure(difference("{actual}", "{expected}"));
}

export assertNotEqual<T>(T actual, T expected) throws TestFailure {
    if (actual != expected) {
        return;
    }
    throw new TestFailure("expected values to differ, both were {boundedValue("{actual}")}");
}

export assertTrue(bool condition, string message = "expected condition to be true") throws TestFailure {
    if (condition) {
        return;
    }
    throw new TestFailure(message);
}

export assertFalse(bool condition, string message = "expected condition to be false") throws TestFailure {
    if (!condition) {
        return;
    }
    throw new TestFailure(message);
}

export noreturn fail(string message) throws TestFailure {
    throw new TestFailure(message);
}

// Equality within `tolerance`, for values that arrive through arithmetic rather than exactly. A
// NaN on either side is never within any tolerance. Equal values pass before any subtraction, so
// two like infinities are near whatever the tolerance says.
export assertNear(double actual, double expected, double tolerance) throws TestFailure {
    if (actual == expected) {
        return;
    }
    double delta = actual - expected;
    if (delta < 0.0) {
        delta = -delta;
    }
    if (delta <= tolerance) {
        return;
    }
    throw new TestFailure("expected {expected} within {tolerance}, got {actual}");
}

// Runs `body` and answers the E it threw; a body that returns without throwing fails the test.
// The answer is the error itself, so the test goes on to check its kind or its message.
export assertThrows<E: Error>((() -> void throws E) body) -> E throws TestFailure {
    E? caught = runAndCatch<E>(body);
    if (caught == null) {
        throw new TestFailure("expected the body to throw, and it returned instead");
    }
    return caught;
}

// The catch lives apart from assertThrows so the failure it raises for a body that returned can
// never be mistaken for a caught E when E is TestFailure itself.
runAndCatch<E: Error>((() -> void throws E) body) -> E? {
    try body();
    return null;
} catch (E caught) {
    return caught;
}

// The widths the difference text is cut to.
class Diff {
    // How wide a single-line value may print in full before the message points at the offset.
    protected static const long fullValueLimit = 60;

    // How many bytes of context an offset excerpt keeps on each side of the first difference.
    protected static const long excerptReach = 24;
}

// The failure text for two values that differ: both values when they are short, the first line
// that differs when either is multi-line, and the first differing offset with excerpts when the
// values are long.
difference(string actual, string expected) -> string {
    if (actual == expected) {
        return "expected and actual print alike as {actual}, but compare unequal";
    }
    if (actual.indexOf("\n") >= 0 || expected.indexOf("\n") >= 0) {
        return lineDifference(actual, expected);
    }
    if (actual.length > Diff.fullValueLimit || expected.length > Diff.fullValueLimit) {
        return offsetDifference(actual, expected);
    }
    return "expected {expected}, got {actual}";
}

lineDifference(string actual, string expected) -> string {
    string[] actualLines = strings.lines(actual);
    string[] expectedLines = strings.lines(expected);
    long shared = actualLines.length;
    if (expectedLines.length < shared) {
        shared = expectedLines.length;
    }
    for (long i = 0; i < shared; i++) {
        if (actualLines[i] != expectedLines[i]) {
            long number = i + 1;
            return "line {number} differs\nexpected: {expectedLines[i]}\n"
                + "actual:   {actualLines[i]}";
        }
    }
    if (actualLines.length == expectedLines.length) {
        return "every line matches, so the values differ only in their line endings";
    }
    return "expected {expectedLines.length} line(s), got {actualLines.length}; they agree "
        + "through line {shared}";
}

offsetDifference(string actual, string expected) -> string {
    long limit = actual.length;
    if (expected.length < limit) {
        limit = expected.length;
    }
    byte[] actualBytes = actual.toBytes();
    byte[] expectedBytes = expected.toBytes();
    long offset = 0;
    while (offset < limit && actualBytes[offset] == expectedBytes[offset]) {
        offset = offset + 1;
    }
    return "values differ at offset {offset}\nexpected: {excerptAround(expected, offset)}\n"
        + "actual:   {excerptAround(actual, offset)}";
}

// A value cut to one bounded line, for a message that names it in passing.
boundedValue(string value) -> string {
    string line = value;
    bool cut = false;
    if (value.indexOf("\n") >= 0) {
        line = strings.lines(value)[0];
        cut = true;
    }
    if (line.length > Diff.fullValueLimit) {
        byte[] bytes = line.toBytes();
        line = line.substring(0, boundaryAtOrBefore(bytes, Diff.fullValueLimit));
        cut = true;
    }
    if (cut) {
        return line + "...";
    }
    return line;
}

// The value around the offset, cut at codepoint boundaries, with markers for what was dropped.
excerptAround(string value, long offset) -> string {
    byte[] bytes = value.toBytes();
    long start = offset - Diff.excerptReach;
    if (start < 0) {
        start = 0;
    }
    long end = offset + Diff.excerptReach;
    if (end > bytes.length) {
        end = bytes.length;
    }
    start = boundaryAtOrBefore(bytes, start);
    end = boundaryAtOrBefore(bytes, end);
    string excerpt = value.substring(start, end);
    if (start > 0) {
        excerpt = "..." + excerpt;
    }
    if (end < bytes.length) {
        excerpt = excerpt + "...";
    }
    return excerpt;
}

// The nearest codepoint boundary at or before the byte offset: a UTF-8 continuation byte carries
// the 10xxxxxx marker, and a boundary is any byte that does not.
boundaryAtOrBefore(byte[] bytes, long offset) -> long {
    long at = offset;
    while (at > 0 && at < bytes.length && (bytes[at] & 0xC0) == 0x80) {
        at = at - 1;
    }
    return at;
}
