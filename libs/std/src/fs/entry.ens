// One thing inside a directory, the reading that returns what a directory holds, and the walk
// under one.
import Path from @std.fs;
import EntryKind from @std.fs.metadata;
import Metadata from @std.fs.metadata;
import FileSystemError from @std.fs.error;
import @std.fs.error;
import Iterable from @std.collections.iterator;
import List from @std.collections.list;
import Set from @std.collections.set;
import Folder from @std.system;
import @std.system;

// One thing inside a directory, which is where it is, its own name, and what it is. A symbolic
// link reports Symlink and never what it points to.
export struct Entry {
    // Where the entry is, which is the directory that was read joined with the entry's name.
    export const Path path;

    // The name of the entry inside its directory, with no directory written in front of it.
    export const string name;

    // What the entry is. A directory listing may not report an entry's kind, so it is read
    // directly. The result is the same either way.
    export const EntryKind kind;
}

// What is directly inside `directory`, in ascending byte order of name. The directory is read
// fully before anything is returned, so the order holds however the file system enumerates it.
public entriesOf(Path directory) -> Iterable<Entry> throws FileSystemError {
    return try listedUnder(directory);
}

// Every entry under `directory`, in the order a walker returns them.
public walkOf(Path directory, bool followLinks) -> Iterable<Entry> throws FileSystemError {
    let walker = new Walker(directory, followLinks);
    let found = new List<Entry>();
    Entry? next = try walker.next();
    while (next != null) {
        found.push(next);
        next = try walker.next();
    }
    return found;
}

// Every entry under one directory, depth first, each directory's entries in ascending byte order
// of name. A directory is read only when the walk gets to it, and it is read to its end and sorted
// before the walk goes into any directory under it, so no directory is held open while a deeper
// one is read.
//
// A `followLinks` of false reports a symbolic link and never goes into it, and true goes into one
// that names a directory. Either way a link reaching a place the walk has already been is reported
// and not gone into again, so a tree of links cannot trap the walk.
export final class Walker {
    const Path root;
    const bool followsLinks;
    List<WalkLevel> levels;
    // Where each directory the walk has gone into resolves to, filled only when it follows links,
    // since a walk that follows none cannot reach one directory twice.
    Set<Path> entered;

    // The directory the walk goes into on the next call, which is the entry the last call
    // returned when it is one to go into.
    Path? descent;
    bool returnedEntry;
    bool started;
    bool ended;

    public constructor(this.root, this.followsLinks) {
        this.levels = new List<WalkLevel>();
        this.entered = new Set<Path>();
        this.descent = null;
        this.returnedEntry = false;
        this.started = false;
        this.ended = false;
    }

    // The next entry, or null once every entry has been returned. A directory is gone into on the
    // call after the one that returned it, unless 'skip()' came between. A failure to read a
    // directory ends the walk, so every call after one that threw returns null.
    export next() -> Entry? throws FileSystemError {
        this.returnedEntry = false;
        if (this.ended) {
            return null;
        }
        this.ended = true;
        Entry? found = try this.advance();
        if (found != null) {
            this.ended = false;
            this.returnedEntry = true;
        }
        return found;
    }

    // Leaves out everything under the entry 'next()' returned last, which is then never read. An
    // entry the walk would not go into, such as a file, has nothing under it to leave out, so
    // skipping one changes nothing.
    export skip() {
        if (!this.returnedEntry) {
            panic("tried to skip a directory of the walk under '{this.root}', but its last next() "
                + "returned no entry. Call skip() right after next() returns the directory to "
                + "leave out");
        }
        this.descent = null;
    }

    advance() -> Entry? throws FileSystemError {
        if (!this.started) {
            this.started = true;
            try this.enter(this.root);
        }
        Path? into = this.descent;
        if (into != null) {
            this.descent = null;
            try this.enter(into);
        }
        while (this.levels.length() > 0) {
            let level = this.levels.last();
            if (level.position < level.entries.length()) {
                let child = level.entries.get(level.position);
                level.position = level.position + 1;
                if (this.goesInto(child)) {
                    this.descent = child.path;
                }
                return child;
            }
            let finished = this.levels.pop();
        }
        return null;
    }

    goesInto(Entry child) -> bool {
        return child.kind == EntryKind.Directory
            || (this.followsLinks && child.kind == EntryKind.Symlink && child.path.isDirectory());
    }

    enter(Path directory) throws FileSystemError {
        if (this.followsLinks && !this.entered.add(try directory.realPath())) {
            return;
        }
        this.levels.push(new WalkLevel(try listedUnder(directory)));
    }
}

// One directory of a walk: its entries, read and sorted, and how many of them have been returned.
final class WalkLevel {
    protected List<Entry> entries;
    protected long position;

    protected constructor(this.entries) {
        this.position = 0;
    }
}

// Everything one directory holds, sorted. Nothing is returned until the directory has been read to
// its end, which is what makes the order a guarantee.
listedUnder(Path directory) -> List<Entry> throws FileSystemError {
    let folder = try OpenFolder.of(directory);
    let found = new List<Entry>();
    while (true) {
        Entry? next = try folder.next(directory);
        if (next == null) {
            break;
        }
        found.push(next);
    }
    found.sort((left, right) -> left.name.compareTo(right.name));
    return found;
}

// A directory being read, whose handle goes back to the operating system when this value is destroyed, so
// a reading that fails part way through still releases it.
final class OpenFolder {
    const Folder folder;

    protected constructor(this.folder);

    protected static of(Path directory) -> OpenFolder throws FileSystemError {
        let opened = system.fsOpenDirectory(directory.toString());
        Folder? handle = opened.handle;
        if (handle == null) {
            throw error.failed("read the directory", directory, opened.code);
        }
        return new OpenFolder(handle);
    }

    // The next entry, or null once every name has been returned. The entries naming the
    // directory itself and its parent are never among them.
    protected next(Path directory) -> Entry? throws FileSystemError {
        let result = system.fsNextEntry(this.folder);
        string? name = result.name;
        if (name == null) {
            if (result.code != 0) {
                throw error.failed("read the directory", directory, result.code);
            }
            return null;
        }
        let path = directory.join(name);
        EntryKind found = try kindOf(path, result.kind);
        Entry built = {path: path, name: name, kind: found};
        return built;
    }

    destructor() {
        system.fsCloseDirectory(this.folder);
    }
}

// The kind the enumeration reported, read from the entry itself where it reported none. The
// read never follows a symbolic link, which is what lets a walk report one without descending
// into it. An entry that is gone by the time it is read reports Other, since the walk has
// already guaranteed to name it.
kindOf(Path path, long reported) -> EntryKind throws FileSystemError {
    if (reported != 0) {
        return Metadata.kindFromCode(reported);
    }
    Metadata? found = try Metadata.read(path, false);
    if (found == null) {
        return EntryKind.Other;
    }
    return found.kind;
}
