// One thing inside a directory, and the reading that answers what a directory holds.
import Path from @std.fs;
import EntryKind from @std.fs.metadata;
import Metadata from @std.fs.metadata;
import FileSystemError from @std.fs.error;
import @std.fs.error;
import Iterable from @std.collections.iterator;
import List from @std.collections.list;
import Set from @std.collections.set;
import Folder from @std.system;
import @std.system;

// One thing inside a directory, which is where it is, its own name, and what it is. A symbolic
// link reports Symlink and never what it points to.
export struct Entry {
    // Where the entry is, which is the directory that was read joined with the entry's name.
    export const Path path;

    // The name of the entry inside its directory, with no directory written in front of it.
    export const string name;

    // What the entry is. A directory listing may not know an entry's kind, so it is asked for
    // directly. The answer is the same either way.
    export const EntryKind kind;
}

// What is directly inside `directory`, in ascending byte order of name. The directory is read
// fully before anything is answered, so the order holds however the file system enumerates it.
public entriesOf(Path directory) -> Iterable<Entry> throws FileSystemError {
    return try listedUnder(directory);
}

// Every entry under `directory`, depth first, each directory's entries in ascending byte order of
// name. A `followLinks` of false reports a symbolic link and never descends into it, and true
// descends into one that names a directory. Either way a link reaching a place the walk has
// already been is reported and not entered twice, so a tree of links cannot trap the walk.
public walkOf(Path directory, bool followLinks) -> Iterable<Entry> throws FileSystemError {
    let found = new List<Entry>();
    try collectUnder(directory, followLinks, new Set<Path>(), found);
    return found;
}

// Everything one directory holds, sorted. Nothing is answered until the directory has been read to
// its end, which is what lets the order be promised at all.
listedUnder(Path directory) -> List<Entry> throws FileSystemError {
    let folder = try OpenFolder.of(directory);
    let found = new List<Entry>();
    while (true) {
        Entry? next = try folder.next(directory);
        if (next == null) {
            break;
        }
        found.push(next);
    }
    found.sort((left, right) -> left.name.compareTo(right.name));
    return found;
}

// Each level's entries, then the entries under each directory among them. A level is read to its
// end before the walk descends, so no directory is held open while a deeper one is read.
//
// `entered` holds the place each directory the walk has gone into resolves to, which is what stops
// a link that reaches one of them being entered a second time. It is filled only for a walk that
// follows links, since a walk that follows none cannot reach one directory twice at all.
collectUnder(Path directory, bool followLinks, Set<Path> entered,
             List<Entry> found) throws FileSystemError {
    if (followLinks && !entered.add(try directory.realPath())) {
        return;
    }
    for (let child in try listedUnder(directory)) {
        found.push(child);
        if (child.kind == EntryKind.Directory) {
            try collectUnder(child.path, followLinks, entered, found);
            continue;
        }
        if (followLinks && child.kind == EntryKind.Symlink && child.path.isDirectory()) {
            try collectUnder(child.path, followLinks, entered, found);
        }
    }
}

// A directory being read, whose handle goes back to the operating system when this value dies, so
// a reading that fails part way through still gives it back.
final class OpenFolder {
    const Folder folder;

    protected constructor(this.folder);

    protected static of(Path directory) -> OpenFolder throws FileSystemError {
        let opened = system.fsOpenDirectory(directory.toString());
        Folder? handle = opened.handle;
        if (handle == null) {
            throw error.failed("read the directory", directory, opened.code);
        }
        return new OpenFolder(handle);
    }

    // The next entry, or null once every name has been handed over. The entries naming the
    // directory itself and its parent are never among them.
    protected next(Path directory) -> Entry? throws FileSystemError {
        let answer = system.fsNextEntry(this.folder);
        string? name = answer.name;
        if (name == null) {
            if (answer.code != 0) {
                throw error.failed("read the directory", directory, answer.code);
            }
            return null;
        }
        let path = directory.join(name);
        EntryKind found = try kindOf(path, answer.kind);
        Entry built = {path: path, name: name, kind: found};
        return built;
    }

    destructor() {
        system.fsCloseDirectory(this.folder);
    }
}

// The kind the enumeration reported, asked about the entry itself where it reported none. The
// asking never follows a symbolic link, which is what lets a walk report one without descending
// into it. An entry that is gone by the time it is asked about reports Other, since the walk has
// already promised to name it.
kindOf(Path path, long reported) -> EntryKind throws FileSystemError {
    if (reported != 0) {
        return Metadata.kindFromCode(reported);
    }
    Metadata? found = try Metadata.read(path, false);
    if (found == null) {
        return EntryKind.Other;
    }
    return found.kind;
}
