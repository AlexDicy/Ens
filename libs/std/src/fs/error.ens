// What a file-system operation raises when it could not do what was requested, and the conditions
// a program can act on.
import Path from @std.fs;
import @std.system;

// What a file-system operation could not do. `kind` is the condition a program acts on, and the
// message says what was attempted, on which path, and why it did not happen.
export class FileSystemError extends Error {
    // The condition that stopped the operation.
    export const ErrorKind kind;

    // The path the operation could not finish on.
    export const Path path;

    // The number the system itself reported. On Windows a failure a file-system call reported
    // carries a Win32 number and one a stream call reported carries the C library's errno, because
    // that is what each of them reports; every other platform carries errno throughout. It is 0
    // where no system call was made. A program acts on `kind` and logs this.
    export const int nativeError;

    // A failure of `kind` on `path`, where `message` says what was attempted and why it did not
    // happen, and `cause` carries the error this one was raised in response to.
    export constructor(string message, this.kind, this.path, this.nativeError,
                       Error? cause = null) {
        super(message, cause);
    }
}

// The conditions a file-system operation fails under. The set is closed, so a program that handles
// every member handles everything this library reports.
export enum ErrorKind {
    // Nothing is at the path, or a directory written above it is missing.
    NotFound,

    // The operation was refused. On Windows this also covers naming a directory where a file was
    // required, because Win32 has no error number that means a directory was named.
    PermissionDenied,

    // Something is already at the path, and the operation was one that will not replace it.
    AlreadyExists,

    // A path written above this one names a file, so nothing can be reached through it.
    NotADirectory,

    // A directory was named where a file was required, which only a system other than Windows
    // reports.
    IsADirectory,

    // A directory still holds entries, and removing one requires it empty first.
    DirectoryNotEmpty,

    // The file system has no room left, or a quota over it is used up.
    NoSpace,

    // Anything else the system reported, whose own error number the message carries.
    Other,
}

// The kind a system's own error number means, for a failure a file-system call reported. Every
// number such a call reports that means more than that something failed has a kind of its own, and
// every other number is an Other.
public errorKindFromCode(int code) -> ErrorKind {
    return kindOfOrdinal(system.fsErrorKind(code));
}

// The kind an errno means, for a failure a stream call reported rather than a file call. On
// Windows the two report from different numbering spaces, so a number has to be read through the table
// belonging to the call that produced it; everywhere else the two tables are one.
public errorKindFromErrno(int code) -> ErrorKind {
    return kindOfOrdinal(system.fsErrnoKind(code));
}

// The kind an ordinal names, which both tables list in the order this module declares its
// members.
kindOfOrdinal(int ordinal) -> ErrorKind {
    return switch (ordinal) {
        0 -> ErrorKind.NotFound,
        1 -> ErrorKind.PermissionDenied,
        2 -> ErrorKind.AlreadyExists,
        3 -> ErrorKind.NotADirectory,
        4 -> ErrorKind.IsADirectory,
        5 -> ErrorKind.DirectoryNotEmpty,
        6 -> ErrorKind.NoSpace,
        default -> ErrorKind.Other,
    };
}

// The failure a system's own error number stands for, where `attempt` says what was being done and
// ends just before the path belongs. Passing "read" for a missing file gives the message
// "could not read 'notes.txt': nothing is there".
public failed(string attempt, Path path, int code) -> FileSystemError {
    let kind = errorKindFromCode(code);
    return new FileSystemError(refusalText(attempt, path, kind, code), kind, path, code);
}

// The same for an operation that creates what it names. An absence is then the directory the new
// file would go in rather than the file itself, since that directory is what the caller has to
// make first.
public failedToCreate(string attempt, Path path, int code) -> FileSystemError {
    let kind = errorKindFromCode(code);
    if (kind != ErrorKind.NotFound) {
        return failed(attempt, path, code);
    }
    return new FileSystemError("could not {attempt} '{path}': the directory it would go in is not "
        + "there. Create it with createDirectories() first", kind, path, code);
}

// The failure an errno stands for, for an operation whose failure a stream call reported, with
// that failure underneath as the cause. The errno table is read rather than the file-system one,
// because on Windows the two number different things.
public failedFromErrno(string attempt, Path path, int code, Error cause) -> FileSystemError {
    let kind = errorKindFromErrno(code);
    return new FileSystemError(refusalText(attempt, path, kind, code), kind, path, code, cause);
}

// The failure a system's own error number stands for, for an operation over two paths. The error
// carries the source, because that is the path the caller named the operation on. Passing "move"
// for a missing source gives the message "could not move 'a' to 'b': nothing is there".
public failedBetween(string attempt, Path source, Path destination, int code) -> FileSystemError {
    let kind = errorKindFromCode(code);
    return new FileSystemError(refusalTextBetween(attempt, source, destination, kind, code), kind,
        source, code);
}

// The same for an operation over two paths whose failure a stream call reported, with that failure
// underneath as the cause.
public failedBetweenFromErrno(string attempt, Path source, Path destination, int code,
                              Error cause) -> FileSystemError {
    let kind = errorKindFromErrno(code);
    return new FileSystemError(refusalTextBetween(attempt, source, destination, kind, code), kind,
        source, code, cause);
}

// What every failure over one path reads, where `attempt` ends just before the path belongs.
refusalText(string attempt, Path path, ErrorKind kind, int code) -> string {
    return "could not {attempt} '{path}': {reasonOf(kind, code)}";
}

// What every failure over two paths reads, naming the source first.
refusalTextBetween(string attempt, Path source, Path destination, ErrorKind kind,
                   int code) -> string {
    return "could not {attempt} '{source}' to '{destination}': {reasonOf(kind, code)}";
}

// The short phrase a message carries for a kind. The system's own text is deliberately not read,
// because it is translated, and a message this library guarantees has to be the same everywhere.
reasonOf(ErrorKind kind, int code) -> string {
    return switch (kind) {
        ErrorKind.NotFound -> "nothing is there",
        ErrorKind.PermissionDenied -> "permission was refused",
        ErrorKind.AlreadyExists -> "something is already there",
        ErrorKind.NotADirectory -> "a directory written above it is a file",
        ErrorKind.IsADirectory -> "it is a directory",
        ErrorKind.DirectoryNotEmpty -> "the directory is not empty",
        ErrorKind.NoSpace -> "the file system has no room left",
        ErrorKind.Other -> "the system reported error {code}",
    };
}
