// On a directory, execute permission is what allows opening the files inside it.
export struct Access {
    export const bool read;
    export const bool write;
    export const bool execute;
}

export struct Permissions {
    export const Access owner;
    export const Access group;
    export const Access others;

    // From the nine low bits of a Unix mode.
    public static fromBits(int bits) -> Permissions {
        Permissions read = {owner: accessFrom(bits >> 6), group: accessFrom(bits >> 3),
            others: accessFrom(bits)};
        return read;
    }

    // The inverse of 'fromBits'.
    public bits() -> int {
        return (bitsOf(this.owner) << 6) | (bitsOf(this.group) << 3) | bitsOf(this.others);
    }
}

accessFrom(int bits) -> Access {
    Access access = {read: (bits & 4) != 0, write: (bits & 2) != 0, execute: (bits & 1) != 0};
    return access;
}

bitsOf(Access access) -> int {
    int bits = 0;
    if (access.read) {
        bits = bits | 4;
    }
    if (access.write) {
        bits = bits | 2;
    }
    if (access.execute) {
        bits = bits | 1;
    }
    return bits;
}
