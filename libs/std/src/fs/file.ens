// An open file, which reads and writes as a stream and names its path in every failure.
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import @std.fs.error;
import ErrorKind as IoErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import Reader from @std.io.streams;
import Writer from @std.io.streams;
import CFile from @std.system;
import @std.system;

// An open file. Reading and writing speak the stream contracts, so a file goes wherever a Reader
// or a Writer goes.
export final class File implements Reader, Writer {
    const CFile handle;
    const Path location;
    bool handedBack;

    protected constructor(this.handle, this.location) {
        this.handedBack = false;
    }

    // The file at `path`, open for reading. A directory is refused here rather than on the first
    // read, so no caller is handed a file that cannot be read at all.
    public static opened(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.reading, "open");
    }

    // The file at `path`, open for writing and holding nothing, created when nothing is there yet.
    public static created(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.fromEmpty, "create");
    }

    // The file at `path`, open for writing at its end, created when nothing is there yet.
    public static appended(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.atTheEnd, "open for appending");
    }

    // Claims `path` by creating a file there and closing it again, and answers whether this call
    // is the one that created it. Creating and refusing a path that is taken is one step, so of
    // two programs asking at the same instant exactly one is answered true, and being told the
    // name is taken is that answer rather than a failure.
    public static claim(Path path) -> bool throws FileSystemError {
        let opened = system.fsOpen(path.toString(), OpenMode.claiming);
        CFile? handle = opened.handle;
        if (handle == null) {
            if (error.errorKindFromCode(opened.code) == ErrorKind.AlreadyExists) {
                return false;
            }
            throw error.failed("create", path, opened.code);
        }
        let closed = system.closeHandle(handle);
        return true;
    }

    // How much of `buffer` the file had ready, and 0 once it has reached its end, so a shorter
    // answer means ask again.
    export override read(byte[] buffer) -> long throws IoError {
        long count = system.readFromHandle(this.handle, buffer);
        if (count == 0 && system.handleFailed(this.handle)) {
            throw new IoError("could not read from '{this.location}'", IoErrorKind.Other);
        }
        return count;
    }

    // Takes all of `data` and keeps nothing. A file that was opened for reading refuses the
    // write, since the operating system holds it open for reading alone.
    export override write(byte[] data) throws IoError {
        if (!system.writeToHandle(this.handle, data)) {
            throw new IoError("could not write {data.length} bytes to '{this.location}'",
                IoErrorKind.Other);
        }
    }

    // Hands everything written but not yet given to the operating system over to it, so a reader
    // opening the path afterwards sees those bytes.
    export override flush() throws IoError {
        if (!system.flushHandle(this.handle)) {
            throw new IoError("could not hand '{this.location}' over to the operating system",
                IoErrorKind.Other);
        }
    }

    // Hands the file back to the operating system, reporting a write that could not be finished.
    // Asking twice is allowed and the second answer is silence.
    export close() throws IoError {
        if (this.handedBack) {
            return;
        }
        this.handedBack = true;
        if (!system.closeHandle(this.handle)) {
            throw new IoError("could not finish writing '{this.location}'", IoErrorKind.Other);
        }
    }

    // Closes the file, keeping any failure to itself. A file that was written and matters is
    // closed with 'close', so the failure has somewhere to go.
    destructor() {
        if (this.handedBack) {
            return;
        }
        let closed = system.closeHandle(this.handle);
    }

    // The file the bridge opened, where `attempt` names what the caller asked for so a refusal
    // reads as the operation it refused.
    static openedIn(Path path, int mode, string attempt) -> File throws FileSystemError {
        let opened = system.fsOpen(path.toString(), mode);
        CFile? handle = opened.handle;
        if (handle == null) {
            throw error.failed(attempt, path, opened.code);
        }
        return new File(handle, path);
    }
}

// What a path is opened for, in the numbers the bridge reads.
final class OpenMode {
    protected static const int reading = 0;
    protected static const int fromEmpty = 1;
    protected static const int atTheEnd = 2;
    protected static const int claiming = 3;
}
