// An open file, which reads and writes as a stream and names its path in every failure.
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import @std.fs.error;
import @std.io.streams;
import IoError from @std.io.streams;
import Reader from @std.io.streams;
import Writer from @std.io.streams;
import CFile from @std.system;
import @std.system;

// An open file. Reading and writing speak the stream contracts, so a file can be used wherever a Reader
// or a Writer can.
export final class File implements Reader, Writer {
    const CFile handle;
    const Path location;
    bool closed;

    protected constructor(this.handle, this.location) {
        this.closed = false;
    }

    // The file at `path`, open for reading. A directory is refused here rather than on the first
    // read, so no caller is handed a file that cannot be read at all.
    public static opened(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.reading, "open", creating: false);
    }

    // The file at `path`, open for writing and holding nothing, created when nothing is there yet.
    public static created(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.fromEmpty, "create", creating: true);
    }

    // The file at `path`, open for writing at its end, created when nothing is there yet.
    public static appended(Path path) -> File throws FileSystemError {
        return try File.openedIn(path, OpenMode.atTheEnd, "append to", creating: true);
    }

    // Claims `path` by creating a file there and closing it again, and returns whether this call
    // is the one that created it. Creating and refusing a path that is taken is one step, so of
    // two programs calling at the same instant exactly one gets true, and a taken
    // name is that result rather than a failure.
    public static claim(Path path) -> bool throws FileSystemError {
        if (path.isEmpty()) {
            throw noPathGiven(path, creating: true);
        }
        let opened = system.fsOpen(path.toString(), OpenMode.claiming);
        CFile? handle = opened.handle;
        if (handle == null) {
            if (error.errorKindFromCode(opened.code) == ErrorKind.AlreadyExists) {
                return false;
            }
            throw error.failedToCreate("create", path, opened.code);
        }
        let code = system.closeHandle(handle);
        return true;
    }

    // How much of `buffer` the file had ready, and 0 once it has reached its end, so a shorter
    // count means call again.
    export override read(byte[] buffer) -> long throws IoError {
        let read = system.readFromHandle(this.handle, buffer);
        if (read.code != 0) {
            throw streams.failure("read from '{this.location}'", read.code);
        }
        return read.count;
    }

    // Takes all of `data` and keeps nothing. A file that was opened for reading refuses the
    // write, since the operating system holds it open for reading alone.
    export override write(byte[] data) throws IoError {
        let wrote = system.writeToHandle(this.handle, data);
        if (wrote.code != 0) {
            throw streams.failure("write {data.length} bytes to '{this.location}'", wrote.code);
        }
    }

    // Hands everything written but not yet given to the operating system over to it, so a reader
    // opening the path afterwards reads those bytes.
    export override flush() throws IoError {
        int code = system.flushHandle(this.handle);
        if (code != 0) {
            throw streams.failure("hand '{this.location}' over to the operating system", code);
        }
    }

    // Hands the file back to the operating system, reporting a write that could not be finished.
    // A second call is allowed and does nothing.
    export close() throws IoError {
        if (this.closed) {
            return;
        }
        this.closed = true;
        int code = system.closeHandle(this.handle);
        if (code != 0) {
            throw streams.failure("finish writing '{this.location}'", code);
        }
    }

    // Closes the file, keeping any failure to itself. A file that was written and matters is
    // closed with 'close', so the failure has somewhere to go.
    destructor() {
        if (this.closed) {
            return;
        }
        let code = system.closeHandle(this.handle);
    }

    // The file the bridge opened, where `attempt` names the operation the caller requested so a refusal
    // names the operation that failed. A path with no text is refused before the system is called,
    // and a `creating` open reports an absence as the missing directory, since a create needs the
    // directory rather than the file.
    static openedIn(Path path, int mode, string attempt, bool creating) -> File
            throws FileSystemError {
        if (path.isEmpty()) {
            throw noPathGiven(path, creating);
        }
        let opened = system.fsOpen(path.toString(), mode);
        CFile? handle = opened.handle;
        if (handle == null) {
            if (creating) {
                throw error.failedToCreate(attempt, path, opened.code);
            }
            throw error.failed(attempt, path, opened.code);
        }
        return new File(handle, path);
    }
}

// What a path is opened for, in the numbers the bridge reads.
final class OpenMode {
    protected static const int reading = 0;
    protected static const int fromEmpty = 1;
    protected static const int atTheEnd = 2;
    protected static const int claiming = 3;
}

// The refusal an open is met with when it was given no path, since an open names the file it works
// on and the empty path names none. Both messages are spelled in full, so each one is found by
// searching for the text a reader is given.
noPathGiven(Path path, bool creating) -> FileSystemError {
    if (creating) {
        return new FileSystemError("could not create a file: no path was given",
            ErrorKind.NotFound, path, 0);
    }
    return new FileSystemError("could not open a file: no path was given", ErrorKind.NotFound,
        path, 0);
}
