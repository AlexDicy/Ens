// What is at a path, and the four things a path can name.
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import @std.fs.error;
import @std.system;

// What is at a path. Reading it is one call, so a program that reads two of these values takes
// both from one Metadata rather than two calls.
export struct Metadata {
    // What is at the path. A result that followed a symbolic link describes what the link points
    // to, so such a result never reports Symlink.
    export const EntryKind kind;

    // The length in bytes, and 0 for a directory, whose own length is whatever the file system
    // happens to keep for it.
    export const long length;

    // When the content last changed, in milliseconds since 1970-01-01 UTC.
    export const long modifiedMillis;

    // What is at `path`, or null when nothing is. A `followLinks` of true describes what a
    // symbolic link points to, and false describes the link itself, which is what keeps a walk
    // over a tree of links finite. Every failure but an absence is raised, so a caller reads the
    // null as a result rather than as a problem.
    public static read(Path path, bool followLinks) -> Metadata? throws FileSystemError {
        let result = system.fsMetadata(path.toString(), followLinks);
        if (result.code != 0) {
            if (error.errorKindFromCode(result.code) == ErrorKind.NotFound) {
                return null;
            }
            throw error.failed("read what is at", path, result.code);
        }
        Metadata found = {kind: Metadata.kindFromCode(result.kind), length: result.length,
            modifiedMillis: result.modifiedMillis};
        return found;
    }

    // The kind the number names, and Other for a number that names none. A listing that reported
    // no kind is settled by reading the entry, before this is called.
    public static kindFromCode(long code) -> EntryKind {
        return switch (code) {
            1 -> EntryKind.File,
            2 -> EntryKind.Directory,
            3 -> EntryKind.Symlink,
            default -> EntryKind.Other,
        };
    }
}

// What one path names.
export enum EntryKind {
    // An ordinary file, which is anything holding content.
    File,

    // A directory, which holds entries rather than content.
    Directory,

    // A symbolic link, reported only by a read that did not follow it.
    Symlink,

    // Something the system keeps that is none of the three above, such as a device or a socket.
    Other,
}
