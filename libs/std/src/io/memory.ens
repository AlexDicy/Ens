// Streams over bytes already in memory, for assembling output and for driving anything written
// against Reader or Writer without an operating system taking part.
import Reader from @std.io.streams;
import Writer from @std.io.streams;

// Hands out the bytes it was given, in order, and then answers 0 for ever. The array is shared
// rather than copied, so changing it changes what is still to be read.
export final class BytesReader implements Reader {
    const byte[] source;
    long position;

    export constructor(this.source) {
        this.position = 0;
    }

    // As many of the bytes left as `buffer` holds, and 0 once they have all been handed out.
    export override read(byte[] buffer) -> long {
        long count = this.source.length - this.position;
        if (count > buffer.length) {
            count = buffer.length;
        }
        for (long i = 0; i < count; i++) {
            buffer[i] = this.source[this.position + i];
        }
        this.position = this.position + count;
        return count;
    }
}

// Collects everything written into one growing array. Nothing is ever handed on anywhere, so no
// write can fail and there is nothing for a flush to do.
export final class BytesWriter implements Writer {
    byte[] held;
    long count;

    export constructor() {
        this.held = new byte[64];
        this.count = 0;
    }

    export override write(byte[] data) {
        this.reserve(this.count + data.length);
        for (long i = 0; i < data.length; i++) {
            this.held[this.count + i] = data[i];
        }
        this.count = this.count + data.length;
    }

    export override flush() { }

    // The bytes written so far, copied, so writing more leaves an answer already taken as it was.
    export toBytes() -> byte[] {
        return this.held.slice(0, this.count);
    }

    export length() -> long {
        return this.count;
    }

    // Forgets everything written, leaving the writer as good as new.
    export clear() {
        this.count = 0;
    }

    // Room for `capacity` bytes, doubling the store until they fit.
    reserve(long capacity) {
        if (capacity <= this.held.length) {
            return;
        }
        long room = this.held.length * 2;
        while (room < capacity) {
            room = room * 2;
        }
        byte[] grown = new byte[room];
        for (long i = 0; i < this.count; i++) {
            grown[i] = this.held[i];
        }
        this.held = grown;
    }
}
