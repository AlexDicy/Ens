// One line of text, said out loud. The prelude lends these two to every module, so a program says
// something without importing anything.
import @std.system;

// `message` and a newline on standard output. A write the operating system refuses is dropped:
// saying something is not an operation a program should have to handle the failure of.
export print(string message) {
    system.writeToHandle(system.standardOutput(), (message + "\n").toBytes());
}

// `message` and a newline on standard error, with everything already printed handed over first so
// the two streams read in the order the program wrote them.
export eprint(string message) {
    system.flush();
    system.writeToHandle(system.standardError(), (message + "\n").toBytes());
}
