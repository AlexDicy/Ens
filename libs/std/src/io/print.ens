// One line of text, printed. The prelude lends these two to every module, so a program prints
// something without importing anything.
import @std.system;

// `message` and a newline on standard output. A write the operating system refuses is dropped.
// Printing is not an operation a program should have to handle the failure of.
export print(string message) {
    let wrote = system.writeToHandle(system.standardOutput(), (message + "\n").toBytes());
}

// `message` and a newline on standard error, with everything already printed flushed first so the
// two streams read in the order the program wrote them. A standard output that could not be flushed
// is dropped the same way a refused write is, since neither is a failure of printing something.
export eprint(string message) {
    let flushed = system.flushHandle(system.standardOutput());
    let wrote = system.writeToHandle(system.standardError(), (message + "\n").toBytes());
}
