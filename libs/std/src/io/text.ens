// Writing text onto a byte stream, as the UTF-8 bytes of that text.
import IoError from @std.io.streams;
import Writer from @std.io.streams;

// Text onto the byte stream it was given. Each call reaches the target once, so a line written
// here arrives whole rather than in pieces something else could get between.
export final class TextWriter {
    const Writer target;

    export constructor(this.target);

    export write(string text) throws IoError {
        try this.target.write(text.toBytes());
    }

    // `text` and a line ending after it, which is always a newline and never a carriage return.
    export writeLine(string text) throws IoError {
        try this.target.write((text + "\n").toBytes());
    }

    // A line ending on its own, which writes an empty line.
    export writeLine() throws IoError {
        try this.target.write("\n".toBytes());
    }

    export flush() throws IoError {
        try this.target.flush();
    }

    // Flushes what the target still holds, keeping any failure to itself. A program that has to
    // know whether the text arrived calls `flush` itself.
    destructor() {
        try this.flush();
    } catch (IoError ignored) {
    }
}
