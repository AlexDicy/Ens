// The two contracts a stream of bytes moves through and the failure they raise. Files, pipes,
// memory buffers and the standard streams all speak these, so code over them runs on any of them.
import @std.system;

// What went wrong while bytes were moving. `kind` names the condition a program acts on, and the
// message says which stream failed and what to do about it.
export class IoError extends Error {
    export const ErrorKind kind;

    // The number the system itself reported. It is the C library's errno wherever the failing call
    // was the C library's, which is every stream but a child's pipes. A child's pipes are the
    // system's own, so a write to one reports a Win32 number on Windows and errno everywhere else.
    // It is 0 where no system call was made, as it is for text that spells no character.
    // A program acts on `kind` and logs this.
    export const int nativeError;

    export constructor(string message, this.kind, this.nativeError, Error? cause = null) {
        super(message, cause);
    }
}

// The conditions a stream fails under. `Closed` is a stream no longer open, `Interrupted` a call
// the system cut short, and `Other` what the message alone describes.
export enum ErrorKind {
    Closed,
    Interrupted,
    Other,
}

// The kind a stream call's own error number means. Every number that means more than that the call
// failed has a kind of its own, and every other number is an Other.
public errorKindFromCode(int code) -> ErrorKind {
    return switch (system.ioErrorKind(code)) {
        0 -> ErrorKind.Closed,
        1 -> ErrorKind.Interrupted,
        default -> ErrorKind.Other,
    };
}

// The failure a stream call's own error number stands for, where `attempt` says what could not be
// done and reads on from "could not". Passing "read standard input" for a stream nothing holds any
// more gives "could not read standard input: the stream is closed".
public failure(string attempt, int code) -> IoError {
    let kind = errorKindFromCode(code);
    return new IoError("could not {attempt}: {reasonOf(kind, code)}", kind, code);
}

// The short phrase a message carries for a kind. The system's own text is deliberately not read,
// because it is translated, and a message this library guarantees has to be the same everywhere.
reasonOf(ErrorKind kind, int code) -> string {
    return switch (kind) {
        ErrorKind.Closed -> "the stream is closed",
        ErrorKind.Interrupted -> "the system cut the call short. Try it again",
        ErrorKind.Other -> "the system reported error {code}",
    };
}

// A source of bytes. `read` fills as much of `buffer` as it has ready and returns how many bytes it
// wrote, 0 only once the stream has ended, so a shorter count means call again.
export interface Reader {
    read(byte[] buffer) -> long throws IoError;
}

// A destination for bytes. `write` takes all of `data` and keeps nothing, and `flush` writes out
// everything accepted but not yet passed on.
export interface Writer {
    write(byte[] data) throws IoError;
    flush() throws IoError;
}

// Moves everything `source` has left into `target` and returns how many bytes moved. Neither stream
// is flushed or closed, so the caller decides when the target has everything.
export copy(Reader source, Writer target) -> long throws IoError {
    byte[] chunk = new byte[8192];
    long moved = 0;
    while (true) {
        long count = try source.read(chunk);
        if (count == 0) {
            return moved;
        }
        if (count == chunk.length) {
            try target.write(chunk);
        } else {
            try target.write(chunk.slice(0, count));
        }
        moved = moved + count;
    }
}
