// Wrappers that turn many small reads and writes into few large ones. The reader adds the
// line-shaped and read-everything calls a raw source cannot offer.
import BytesWriter from @std.io.memory;
import EncodingError from @std.text;
import ErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import Reader from @std.io.streams;
import TimedReader from @std.io.streams;
import @std.system;
import Writer from @std.io.streams;

// Reads ahead into a buffer, so a caller taking a few bytes at a time reaches the source once per
// bufferful. A capacity below one byte is raised to one.
export final class BufferedReader implements TimedReader {
    const Reader source;

    byte[] held;
    long start;
    long end;
    bool ended;

    export constructor(this.source, long capacity = 8192) {
        this.held = new byte[capacity < 1 ? 1 : capacity];
        this.start = 0;
        this.end = 0;
        this.ended = false;
    }

    // Bytes out of the buffer, refilling it first when it is empty, and 0 only at the end of the
    // stream. A request at least a bufferful wide is read straight from the source.
    export override read(byte[] buffer) -> long throws IoError {
        return try this.readBy(buffer, Deadline.none) ?? 0;
    }

    // The same, waiting at most `timeoutMillis` milliseconds for bytes when none are held, and null
    // when none arrived in time. The bound holds when the source is a TimedReader; another source
    // is read as it is.
    export override read(byte[] buffer, long timeoutMillis) -> long? throws IoError {
        return try this.readBy(buffer, deadlineAfter(timeoutMillis));
    }

    // The next line without its ending, or null once the stream has ended. A carriage return
    // before the newline belongs to the ending, and a last line without one is a line of its own.
    export readLine() -> string? throws IoError {
        return try this.lineBy(Deadline.none);
    }

    // The same, waiting at most `timeoutMillis` milliseconds for the line to end, and null when it
    // did not end in time, keeping what arrived of it for the next call; 'hasEnded' tells that null
    // from the one at the end of the stream. The bound holds when the source is a TimedReader.
    export readLine(long timeoutMillis) -> string? throws IoError {
        return try this.lineBy(deadlineAfter(timeoutMillis));
    }

    // Whether the stream has ended and every byte read from it has been taken.
    export hasEnded() -> bool {
        return this.ended && this.start == this.end;
    }

    // How many bytes were read from the source ahead of what the caller has taken, which is what
    // the next read or line is served from before the source is asked again.
    public pending() -> long {
        return this.end - this.start;
    }

    // Everything left in the stream, as bytes.
    export readAll() -> bytes throws IoError {
        let collected = new BytesWriter();
        while (true) {
            bool ready = try this.holdsBytes(Deadline.none) ?? false;
            if (!ready) {
                return collected.toBytes();
            }
            collected.write(this.heldBetween(this.start, this.end));
            this.start = this.end;
        }
    }

    // Everything left in the stream, as text. Bytes that do not spell UTF-8 are refused, since
    // text in Ens is always valid UTF-8.
    export readAllText() -> string throws IoError {
        bytes raw = try this.readAll();
        return try textOf(raw);
    }

    // Bytes out of the buffer by `deadline`, null when none arrived by then.
    readBy(byte[] buffer, long deadline) -> long? throws IoError {
        if (buffer.length == 0) {
            return 0;
        }
        if (this.start == this.end && buffer.length >= this.held.length) {
            return try this.bytesFromSource(buffer, deadline);
        }
        bool? ready = try this.holdsBytes(deadline);
        if (ready == null) {
            return null;
        }
        if (!ready) {
            return 0;
        }
        long count = this.end - this.start;
        if (count > buffer.length) {
            count = buffer.length;
        }
        for (long i = 0; i < count; i++) {
            buffer[i] = this.held[this.start + i];
        }
        this.start = this.start + count;
        return count;
    }

    // The next line by `deadline`: null at the end of the stream, and null when the line did not
    // end by then, with what arrived of it kept.
    lineBy(long deadline) -> string? throws IoError {
        bool? ready = try this.holdsBytes(deadline);
        if (ready == null || !ready) {
            return null;
        }
        long at = this.newlineIndex();
        if (at < 0) {
            return try this.lineAcrossFills(deadline);
        }
        bytes line = this.heldBetween(this.start, at);
        this.start = at + 1;
        return try textOf(withoutReturn(line));
    }

    // A line whose bytes did not all arrive in one fill. They stay in the buffer, which grows to
    // hold them, until the line's end arrives, so a read cut short by a failure, a cancel or the
    // deadline keeps them for the next call.
    lineAcrossFills(long deadline) -> string? throws IoError {
        long scanned = this.end - this.start;
        while (true) {
            long at = this.newlineIndexFrom(this.start + scanned);
            if (at >= 0) {
                bytes line = this.heldBetween(this.start, at);
                this.start = at + 1;
                return try textOf(withoutReturn(line));
            }
            scanned = this.end - this.start;
            long? arrived = try this.fillMore(deadline);
            if (arrived == null) {
                return null;
            }
            if (arrived == 0) {
                bytes last = this.heldBetween(this.start, this.end);
                this.start = this.end;
                return try textOf(withoutReturn(last));
            }
        }
    }

    // How many more bytes the source put in by `deadline` after those held, moved to the front of
    // the buffer and given room first: 0 at the end of the stream and null when none arrived.
    fillMore(long deadline) -> long? throws IoError {
        long kept = this.end - this.start;
        if (this.start > 0) {
            for (long i = 0; i < kept; i++) {
                this.held[i] = this.held[this.start + i];
            }
            this.start = 0;
            this.end = kept;
        }
        if (this.end == this.held.length) {
            byte[] grown = new byte[this.held.length * 2];
            for (long i = 0; i < kept; i++) {
                grown[i] = this.held[i];
            }
            this.held = grown;
        }
        byte[] room = new byte[this.held.length - this.end];
        long? arrived = try this.bytesFromSource(room, deadline);
        if (arrived == null) {
            return null;
        }
        for (long i = 0; i < arrived; i++) {
            this.held[this.end + i] = room[i];
        }
        this.end = this.end + arrived;
        return arrived;
    }

    // Whether the buffer holds a byte to take, reading more into it by `deadline` when it is empty:
    // false once the source has ended and nothing is left over, and null when nothing arrived.
    holdsBytes(long deadline) -> bool? throws IoError {
        if (this.start < this.end) {
            return true;
        }
        this.start = 0;
        this.end = 0;
        long? arrived = try this.bytesFromSource(this.held, deadline);
        if (arrived == null) {
            return null;
        }
        this.end = arrived;
        return this.end > 0;
    }

    // How many bytes the source itself put into `buffer`, with the end of the stream recorded so
    // nothing reads it again afterwards, and null when a source that can wait had none by
    // `deadline`.
    bytesFromSource(byte[] buffer, long deadline) -> long? throws IoError {
        if (this.ended) {
            return 0;
        }
        long? count = null;
        TimedReader? timed = this.source as? TimedReader;
        if (deadline == Deadline.none || timed == null) {
            count = try this.source.read(buffer);
        } else {
            long remaining = deadline - system.monotonicMillis();
            count = try timed.read(buffer, remaining < 0 ? 0 : remaining);
        }
        if (count == null) {
            return null;
        }
        if (count == 0) {
            this.ended = true;
        }
        return count;
    }

    // Copies out the buffered bytes in [from, to), because the next fill overwrites the buffer.
    heldBetween(long from, long to) -> bytes {
        return bytes.of(this.held.slice(from, to));
    }

    // The index of the next newline among the held bytes, or -1 when none of them ends a line.
    newlineIndex() -> long {
        return this.newlineIndexFrom(this.start);
    }

    newlineIndexFrom(long from) -> long {
        for (long i = from; i < this.end; i++) {
            if (this.held[i] == '\n') {
                return i;
            }
        }
        return -1;
    }
}

// Collects writes into a buffer and passes them on when it fills, when `flush` is called, or when
// the wrapper is dropped. A capacity below one byte is raised to one.
export final class BufferedWriter implements Writer {
    const Writer target;

    byte[] held;
    long count;

    export constructor(this.target, long capacity = 8192) {
        this.held = new byte[capacity < 1 ? 1 : capacity];
        this.count = 0;
    }

    // `data` into the buffer, writing out what is already there when the two together would not
    // fit. Data at least a bufferful wide goes to the target directly.
    export override write(bytes data) throws IoError {
        if (this.count + data.length > this.held.length) {
            try this.drainToTarget();
        }
        if (data.length >= this.held.length) {
            try this.target.write(data);
            return;
        }
        for (long i = 0; i < data.length; i++) {
            this.held[this.count + i] = data[i];
        }
        this.count = this.count + data.length;
    }

    // Everything the buffer holds, written to the target and then flushed through it, so a flush
    // here reaches wherever the bytes were going.
    export override flush() throws IoError {
        try this.drainToTarget();
        try this.target.flush();
    }

    // The buffer's bytes written to the target and cleared here. Bytes the target does not accept are
    // dropped, so no later call offers them a second time.
    drainToTarget() throws IoError {
        if (this.count == 0) {
            return;
        }
        bytes pending = bytes.of(this.held.slice(0, this.count));
        this.count = 0;
        try this.target.write(pending);
    }

    // Flushes what the buffer still holds, keeping any failure to itself. A program that has to
    // confirm the bytes were written calls `flush` itself.
    destructor() {
        try this.flush();
    } catch (IoError ignored) {
    }
}

final class Deadline {
    // No deadline at all: wait as long as the source takes.
    protected static const long none = -1;
}

// The point on the monotonic clock `timeoutMillis` from now, a bound below 0 counting as 0.
deadlineAfter(long timeoutMillis) -> long {
    return system.monotonicMillis() + (timeoutMillis < 0 ? 0 : timeoutMillis);
}

// `raw` without a carriage return at its end, which a Windows line ending writes before the
// newline and which belongs to the ending rather than to the line.
withoutReturn(bytes raw) -> bytes {
    if (raw.length > 0 && raw[raw.length - 1] == '\r') {
        return raw.slice(0, raw.length - 1);
    }
    return raw;
}

// The bytes as text, or the stream's own failure naming where they stop spelling UTF-8. A stream
// writes out whatever it holds, and the encoding failure is attached as the cause so a reader's throws
// list stays one type long.
textOf(bytes raw) -> string throws IoError {
    return try string.fromBytes(raw);
} catch (EncodingError problem) {
    throw new IoError("the text read from the stream is not valid UTF-8, the way Ens stores text "
        + "as bytes: the byte at offset {problem.offset} does not start a character. Read the "
        + "bytes with readAll() and convert them with string.fromBytesLossy()", ErrorKind.Other, 0,
        problem);
}
