// Sorting a list into its natural order. Ens has no function references yet, so a sort takes no
// comparison to call: every overload here knows the order of the values it sorts.
import List from @std.collections.list;

// Puts a list of strings in ascending order by `compareTo`, so by their UTF-8 bytes. The sort is a
// bottom-up merge sort: it is stable, and it does the same work whatever order the values arrive
// in. Each round merges neighboring runs into the second buffer, which then holds the runs of the
// round after it.
export sort(List<string> values) {
    if (values.length() < 2) {
        return;
    }
    string[] runs = values.toArray();
    string[] merged = new string[runs.length];
    for (long i = 0; i < merged.length; i++) {
        merged[i] = runs[i];
    }
    long width = 1;
    while (width < runs.length) {
        long start = 0;
        while (start < runs.length) {
            mergeRuns(runs, merged, start, limited(start + width, runs.length),
                limited(start + width * 2, runs.length));
            start = start + width * 2;
        }
        string[] previous = runs;
        runs = merged;
        merged = previous;
        width = width * 2;
    }
    for (long i = 0; i < runs.length; i++) {
        values.set(i, runs[i]);
    }
}

// Merges the runs [start, middle) and [middle, end) into merged over the same range, keeping equal
// values in the order they came in.
mergeRuns(string[] runs, string[] merged, long start, long middle, long end) {
    long left = start;
    long right = middle;
    for (long at = start; at < end; at++) {
        if (left < middle && (right >= end || runs[left].compareTo(runs[right]) <= 0)) {
            merged[at] = runs[left];
            left++;
        } else {
            merged[at] = runs[right];
            right++;
        }
    }
}

limited(long value, long limit) -> long {
    if (value > limit) {
        return limit;
    }
    return value;
}
