// Read-only collections. Nothing can change a frozen collection after it is made, so other tasks
// can hold it safely. Each one keeps a private List, Map or Set and exposes only its read methods;
// the 'to...' methods return a new writable copy.
import Collection from @std.collections.collection;
import Entry from @std.collections.entry;
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// A read-only list.
export shared final class FrozenList<T> implements Collection<T> {
    const List<T> items;

    public constructor(this.items);

    // Makes a frozen list with `values`, in order.
    export static of(T[] values) -> FrozenList<T> {
        return new FrozenList<T>(List.of(values));
    }

    // Makes a frozen list with a copy of the values in `list`.
    export static of(List<T> list) -> FrozenList<T> {
        return new FrozenList<T>(list.copy());
    }

    // Wraps `values` itself, for a call of 'frozen()' on an array nothing else refers to.
    public static wrapping(T[] values) -> FrozenList<T> {
        return new FrozenList<T>(List<T>.wrapping(values));
    }

    // The copy of `values` that 'frozen()' on an array keeps when something else refers to it.
    public static copied(T[] values) -> T[] {
        T[] copy = new T[values.length];
        for (long index = 0; index < copy.length; index++) {
            copy[index] = values[index];
        }
        return copy;
    }

    export override length() -> long {
        return this.items.length();
    }

    export override isEmpty() -> bool {
        return this.items.isEmpty();
    }

    export override contains(T value) -> bool {
        return this.items.contains(value);
    }

    export override makeIterator() -> Iterator<T> {
        return this.items.makeIterator();
    }

    export get(long index) -> T {
        return this.items.get(index);
    }

    export first() -> T {
        return this.items.first();
    }

    export last() -> T {
        return this.items.last();
    }

    // The position of the first value equal to `value`, or -1.
    export indexOf(T value) -> long {
        return this.items.indexOf(value);
    }

    // Returns a new writable list with the same values.
    export toList() -> List<T> {
        return this.items.copy();
    }

    export toArray() -> T[] {
        return this.items.toArray();
    }

    // Equal when both hold equal values in the same order.
    export override equals(FrozenList<T> other) -> bool {
        if (this.items.length() != other.items.length()) {
            return false;
        }
        for (long index = 0; index < this.items.length(); index++) {
            if (this.items.get(index) != other.items.get(index)) {
                return false;
            }
        }
        return true;
    }

    export override hash() -> long {
        long combined = 17;
        for (let value in this.items) {
            combined = combined * 31 + value.hash();
        }
        return combined;
    }
}

// A read-only map.
export shared final class FrozenMap<K, V> implements Iterable<Entry<K, V>> {
    const Map<K, V> entries;

    public constructor(this.entries);

    // Makes a frozen map with a copy of the entries in `map`.
    export static of(Map<K, V> map) -> FrozenMap<K, V> {
        return new FrozenMap<K, V>(map.copy());
    }

    export length() -> long {
        return this.entries.length();
    }

    export isEmpty() -> bool {
        return this.entries.isEmpty();
    }

    // The value stored under `key`, or null when there is none.
    export get(K key) -> V? {
        return this.entries.get(key);
    }

    export contains(K key) -> bool {
        return this.entries.contains(key);
    }

    export keys() -> Iterable<K> {
        return this.entries.keys();
    }

    export values() -> Iterable<V> {
        return this.entries.values();
    }

    export override makeIterator() -> Iterator<Entry<K, V>> {
        return this.entries.makeIterator();
    }

    // Returns a new writable map with the same entries.
    export toMap() -> Map<K, V> {
        return this.entries.copy();
    }

    // Equal when both hold the same keys, each with an equal value.
    export override equals(FrozenMap<K, V> other) -> bool {
        if (this.entries.length() != other.entries.length()) {
            return false;
        }
        for (let entry in this.entries) {
            let found = other.entries.get(entry.key);
            if (found == null || found != entry.value) {
                return false;
            }
        }
        return true;
    }

    // Adds up the entries' hashes, so the result does not depend on iteration order: two equal maps
    // can iterate in different orders.
    export override hash() -> long {
        long combined = 0;
        for (let entry in this.entries) {
            combined = combined + (entry.key.hash() * 31 ^ entry.value.hash());
        }
        return combined;
    }
}

// A read-only set.
export shared final class FrozenSet<T> implements Collection<T> {
    const Set<T> members;

    public constructor(this.members);

    // Makes a frozen set with each of `values` once.
    export static of(T[] values) -> FrozenSet<T> {
        return new FrozenSet<T>(Set.of(values));
    }

    // Makes a frozen set with a copy of the values in `set`.
    export static of(Set<T> set) -> FrozenSet<T> {
        return new FrozenSet<T>(set.copy());
    }

    export override length() -> long {
        return this.members.length();
    }

    export override isEmpty() -> bool {
        return this.members.isEmpty();
    }

    export override contains(T value) -> bool {
        return this.members.contains(value);
    }

    export override makeIterator() -> Iterator<T> {
        return this.members.makeIterator();
    }

    // Returns a new writable set with the same values.
    export toSet() -> Set<T> {
        return this.members.copy();
    }

    export toArray() -> T[] {
        return this.members.toArray();
    }

    // Equal when both hold the same values.
    export override equals(FrozenSet<T> other) -> bool {
        if (this.members.length() != other.members.length()) {
            return false;
        }
        for (let value in this.members) {
            if (!other.members.contains(value)) {
                return false;
            }
        }
        return true;
    }

    // Adds up the values' hashes, so the result does not depend on iteration order: two equal sets
    // can iterate in different orders.
    export override hash() -> long {
        long combined = 0;
        for (let value in this.members) {
            combined = combined + value.hash();
        }
        return combined;
    }
}
