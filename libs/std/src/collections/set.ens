import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import RawArray from @std.collections.rawarray;

// A hash set with open addressing and linear probing, sharing Map's slot
// layout: states are 0 = empty, 1 = occupied, 2 = removed. Items compare
// with '==' and hash with hash(). A slot holds an item only while its state
// says so, which is why the items are a raw store.
export class Set<T> implements Iterable<T> {
    RawArray<T> slotItems;
    byte[] slotStates;
    long count;
    long capacity;

    export constructor() {
        this.capacity = 16;
        this.slotItems = RawArray<T>.allocate(this.capacity);
        this.slotStates = new byte[this.capacity];
        this.count = 0;
    }

    export add(T item) -> bool {
        if (this.findSlot(item) >= 0) {
            return false;
        }
        if ((this.count + 1) * 4 > this.capacity * 3) {
            this.resize();
        }
        long slot = this.freeSlot(item);
        this.slotItems.write(slot, item);
        this.slotStates[slot] = 1;
        this.count = this.count + 1;
        return true;
    }

    export contains(T item) -> bool {
        return this.findSlot(item) >= 0;
    }

    export remove(T item) -> bool {
        long slot = this.findSlot(item);
        if (slot < 0) {
            return false;
        }
        this.slotStates[slot] = 2;
        this.slotItems.clear(slot);
        this.count = this.count - 1;
        return true;
    }

    export length() -> long {
        return this.count;
    }

    // Filled by walking the occupied slots in order, which is what the iterator does, so the
    // result is written once per slot from front to back.
    export items() -> T[] {
        let walk = this.makeIterator();
        T[] result = new T[this.count];
        for (long i = 0; i < result.length; i++) {
            result[i] = walk.next();
        }
        return result;
    }

    export override makeIterator() -> Iterator<T> {
        return new SetIterator<T>(this.slotItems, this.slotStates, this.capacity);
    }

    findSlot(T item) -> long {
        long slot = item.hash() & (this.capacity - 1);
        long probed = 0;
        while (probed < this.capacity) {
            if (this.slotStates[slot] == 0) {
                return -1;
            }
            if (this.slotStates[slot] == 1 && this.slotItems.read(slot) == item) {
                return slot;
            }
            slot = (slot + 1) & (this.capacity - 1);
            probed = probed + 1;
        }
        return -1;
    }

    freeSlot(T item) -> long {
        long slot = item.hash() & (this.capacity - 1);
        while (this.slotStates[slot] == 1) {
            slot = (slot + 1) & (this.capacity - 1);
        }
        return slot;
    }

    resize() {
        long oldCapacity = this.capacity;
        let oldItems = this.slotItems;
        byte[] oldStates = this.slotStates;

        this.capacity = this.capacity * 2;
        this.slotItems = RawArray<T>.allocate(this.capacity);
        this.slotStates = new byte[this.capacity];

        long slot = 0;
        while (slot < oldCapacity) {
            if (oldStates[slot] == 1) {
                let moved = oldItems.read(slot);
                long target = moved.hash() & (this.capacity - 1);
                while (this.slotStates[target] == 1) {
                    target = (target + 1) & (this.capacity - 1);
                }
                this.slotItems.write(target, moved);
                this.slotStates[target] = 1;
            }
            slot = slot + 1;
        }
    }
}

class SetIterator<T> implements Iterator<T> {
    RawArray<T> slotItems;
    byte[] slotStates;
    long capacity;
    long position;

    protected constructor(this.slotItems, this.slotStates, this.capacity) {
        this.position = 0;
        this.skipToOccupied();
    }

    override hasNext() -> bool {
        return this.position < this.capacity;
    }

    override next() -> T {
        if (this.position >= this.capacity) {
            panic("next past the end of a set");
        }
        T item = this.slotItems.read(this.position);
        this.position = this.position + 1;
        this.skipToOccupied();
        return item;
    }

    skipToOccupied() {
        while (this.position < this.capacity && this.slotStates[this.position] != 1) {
            this.position = this.position + 1;
        }
    }
}
