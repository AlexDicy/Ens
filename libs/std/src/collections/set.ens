import Collection from @std.collections.collection;
import Iterator from @std.collections.iterator;
import KeyIterator from @std.collections.map;
import Map from @std.collections.map;
import SlotWalk from @std.collections.map;

// A collection that holds each value once. The order a walk visits them in is not specified.
//
// The values are the keys of a map, so the table, its probing, and its change counting live there.
export final class Set<T> implements Collection<T>, Copyable<Set<T>> {
    Map<T, bool> table;

    export constructor() {
        this.table = new Map<T, bool>();
    }

    constructor(Map<T, bool> table) {
        this.table = table;
    }

    // A set that can hold `capacity` values before its table has to grow.
    export static withCapacity(long capacity) -> Set<T> {
        return new Set<T>(Map<T, bool>.withCapacity(capacity));
    }

    // A set holding `values`, each once.
    export static of(T[] values) -> Set<T> {
        let set = Set<T>.withCapacity(values.length);
        for (let value in values) {
            set.add(value);
        }
        return set;
    }

    export override length() -> long {
        return this.table.length();
    }

    export override isEmpty() -> bool {
        return this.table.isEmpty();
    }

    export override contains(T value) -> bool {
        return this.table.contains(value);
    }

    export override makeIterator() -> Iterator<T> {
        return new KeyIterator<T, bool>(this.walk());
    }

    // Adds `value`, and answers whether it was not already there.
    export add(T value) -> bool {
        return this.table.add(value, true);
    }

    export remove(T value) -> bool {
        return this.table.remove(value);
    }

    // Removes every value the test accepts, in one pass, and answers how many went.
    export removeWhere((T) -> bool test) -> long {
        return this.table.removeWhere((value, present) -> test(value));
    }

    export clear() {
        this.table.clear();
    }

    // The values in this set, in `other`, or in both.
    export union(Set<T> other) -> Set<T> {
        let result = this.copy();
        for (let value in other) {
            result.add(value);
        }
        return result;
    }

    // The values in both this set and `other`.
    export intersection(Set<T> other) -> Set<T> {
        let result = new Set<T>();
        for (let value in this) {
            if (other.contains(value)) {
                result.add(value);
            }
        }
        return result;
    }

    // The values in this set that `other` does not hold.
    export difference(Set<T> other) -> Set<T> {
        let result = new Set<T>();
        for (let value in this) {
            if (!other.contains(value)) {
                result.add(value);
            }
        }
        return result;
    }

    // Whether `other` holds every value in this set.
    export isSubsetOf(Set<T> other) -> bool {
        for (let value in this) {
            if (!other.contains(value)) {
                return false;
            }
        }
        return true;
    }

    export override copy() -> Set<T> {
        return new Set<T>(this.table.copy());
    }

    export toArray() -> T[] {
        let walk = this.walk();
        T[] values = new T[this.table.length()];
        for (long i = 0; i < values.length; i++) {
            values[i] = walk.keyAt(walk.nextSlot());
        }
        return values;
    }

    walk() -> SlotWalk<T, bool> {
        return new SlotWalk<T, bool>(this.table, "set");
    }
}
