// The iteration contracts used by `for (item in collection)`. A class is
// iterable when it implements Iterable<T>; the loop calls makeIterator()
// once, then draws values with next() until it answers null. Arrays are
// iterated directly without an iterator object.

// A walk over values, taken once. `next` answers the value it moved onto, or
// null when the walk is over. Every call after that answers null.
export interface Iterator<T> {
    next() -> T?;
}

// Something `for (let item in ...)` can walk. The loop asks for one iterator
// and draws values until it runs out.
export interface Iterable<T> {
    makeIterator() -> Iterator<T>;
}
