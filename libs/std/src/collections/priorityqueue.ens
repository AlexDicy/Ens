import Collection from @std.collections.collection;
import Iterator from @std.collections.iterator;
import RawArray from @std.collections.rawarray;

// Values taken out smallest first, whatever order they were put in. "Smallest" means what the
// natural order of T says, or what the order given at construction says.
//
// The first `count` slots of the store hold a binary heap: the value at `index` sorts no later
// than the values at `2 * index + 1` and `2 * index + 2`, so the smallest is always at 0.
export final class PriorityQueue<T> implements Collection<T>, Copyable<PriorityQueue<T>> {
    protected RawArray<T> items;
    protected long count;
    (T, T) -> int order;

    export constructor<T: Comparable<T>>() {
        this.items = RawArray<T>.allocate(4);
        this.count = 0;
        this.order = (a, b) -> a.compareTo(b);
    }

    // A queue whose values sort as `order` says: negative when its first argument sorts first, zero
    // when neither does, positive when the second does.
    export constructor((T, T) -> int order) {
        this.items = RawArray<T>.allocate(4);
        this.count = 0;
        this.order = order;
    }

    constructor((T, T) -> int order, long capacity) {
        this.items = RawArray<T>.allocate(capacity < 1 ? 1 : capacity);
        this.count = 0;
        this.order = order;
    }

    export override length() -> long {
        return this.count;
    }

    export override isEmpty() -> bool {
        return this.count == 0;
    }

    // Whether the queue holds a value equal to `value` by `==`, whatever the order says of it.
    export override contains(T value) -> bool {
        for (long index = 0; index < this.count; index++) {
            if (this.items.read(index) == value) {
                return true;
            }
        }
        return false;
    }

    // Walks every value once, in no particular order. Taking them out in order means calling `pop`.
    export override makeIterator() -> Iterator<T> {
        return new HeapIterator<T>(this);
    }

    export push(T value) {
        this.reserve(this.count + 1);
        this.items.write(this.count, value);
        this.count = this.count + 1;
        this.siftUp(this.count - 1);
    }

    // The smallest value, taken out. Aborts the program on an empty queue.
    export pop() -> T {
        if (this.count == 0) {
            panic("pop from an empty queue: check isEmpty() first");
        }
        let smallest = this.items.read(0);
        this.count = this.count - 1;
        let last = this.items.read(this.count);
        this.items.clear(this.count);
        if (this.count > 0) {
            this.items.write(0, last);
            this.siftDown(0);
        }
        return smallest;
    }

    // The smallest value, left where it is. Aborts the program on an empty queue.
    export peek() -> T {
        if (this.count == 0) {
            panic("peek at an empty queue: check isEmpty() first");
        }
        return this.items.read(0);
    }

    export clear() {
        for (long index = 0; index < this.count; index++) {
            this.items.clear(index);
        }
        this.count = 0;
    }

    export override copy() -> PriorityQueue<T> {
        let copied = new PriorityQueue<T>(this.order, this.count);
        for (long index = 0; index < this.count; index++) {
            copied.items.write(index, this.items.read(index));
        }
        copied.count = this.count;
        return copied;
    }

    reserve(long capacity) {
        if (capacity <= this.items.length()) {
            return;
        }
        long size = this.items.length();
        while (size < capacity) {
            size = size * 2;
        }
        let grown = RawArray<T>.allocate(size);
        for (long index = 0; index < this.count; index++) {
            grown.write(index, this.items.read(index));
        }
        this.items = grown;
    }

    // Moves the value at `index` up past every parent it sorts before.
    siftUp(long index) {
        let value = this.items.read(index);
        long at = index;
        while (at > 0) {
            long parent = (at - 1) / 2;
            let above = this.items.read(parent);
            if (this.order(value, above) >= 0) {
                break;
            }
            this.items.write(at, above);
            at = parent;
        }
        this.items.write(at, value);
    }

    // Moves the value at `index` down past every child that sorts before it, taking the smaller
    // child's place each time.
    siftDown(long index) {
        let value = this.items.read(index);
        long at = index;
        while (true) {
            long child = at * 2 + 1;
            if (child >= this.count) {
                break;
            }
            long right = child + 1;
            if (right < this.count
                    && this.order(this.items.read(right), this.items.read(child)) < 0) {
                child = right;
            }
            let below = this.items.read(child);
            if (this.order(below, value) >= 0) {
                break;
            }
            this.items.write(at, below);
            at = child;
        }
        this.items.write(at, value);
    }
}

class HeapIterator<T> implements Iterator<T> {
    PriorityQueue<T> queue;
    long position;

    protected constructor(this.queue) {
        this.position = 0;
    }

    protected override next() -> T? {
        if (this.position >= this.queue.count) {
            return null;
        }
        let value = this.queue.items.read(this.position);
        this.position = this.position + 1;
        return value;
    }
}
