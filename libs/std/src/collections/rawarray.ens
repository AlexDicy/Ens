// N slots of T with nothing in them yet, which is what a container needs in order to hold
// capacity beyond its length and sparse slots beyond its occupied ones. A slot nothing has written
// holds no value of T, so reading one is the caller's obligation to avoid: that read is the one
// unchecked operation in the language. The index is still checked against the slot count.
//
// The compiler lowers every method here to the array operation it stands for, so a field of this
// type costs exactly what a `T[]` field costs. The bodies are what a compiler that does not do
// that needs in order to behave the same way, except for `clear`, which Ens cannot express:
// without the compiler it keeps the slot's reference until the whole store is released, which
// delays a destructor and loses nothing.
public struct RawArray<T> {
    T[] cells;

    public read(long index) -> T {
        return this.cells[index];
    }

    public write(long index, T value) {
        this.cells[index] = value;
    }

    // Gives up whatever the slot holds and leaves it as it was before anything wrote to it, so a
    // container that drops a value stops keeping it alive.
    public clear(long index) {
    }

    public length() -> long {
        return this.cells.length;
    }
}

// A store of `size` slots, none of them written. A free function rather than a static because no
// published seed compiles a static yet.
public allocate<T>(long size) -> RawArray<T> {
    return {cells: new T[size]};
}
