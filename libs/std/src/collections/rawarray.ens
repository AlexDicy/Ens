// N slots of T with nothing in them yet, which is what a container needs in order to hold capacity
// beyond its length. Reading a slot nothing has written is the caller's obligation to avoid, and
// is the one unchecked operation in the language, though the index is still checked.
public struct RawArray<T> {
    T[] cells;

    // A store of `size` slots, none of them written.
    public static allocate(long size) -> RawArray<T> {
        return {cells: new T[size]};
    }

    public read(long index) -> T {
        return this.cells[index];
    }

    public write(long index, T value) {
        this.cells[index] = value;
    }

    // Gives up whatever the slot holds and leaves it as it was before anything wrote to it, so a
    // container that drops a value stops keeping it alive. The compiler lowers this to the array
    // operation it stands for, and the body below is the closest Ens can express: it keeps the
    // slot's reference until the whole store is released, which delays a destructor.
    public clear(long index) {
    }

    public length() -> long {
        return this.cells.length;
    }
}
