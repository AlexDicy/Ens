import List from @std.collections.list;
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import Pair from @std.collections.pair;
import RawArray from @std.collections.rawarray;

// A hash table with open addressing and linear probing. Slot states are
// 0 = empty, 1 = occupied, 2 = removed; removed slots are reused on insert
// and cleared by resize. Keys compare with '==' and hash with hash().
export class Map<K, V> implements Iterable<Pair<K, V>> {
    RawArray<K> slotKeys;
    RawArray<V> slotValues;
    byte[] slotStates;
    long count;
    long capacity;

    export constructor() {
        this.capacity = 16;
        this.slotKeys = RawArray<K>.allocate(this.capacity);
        this.slotValues = RawArray<V>.allocate(this.capacity);
        this.slotStates = new byte[this.capacity];
        this.count = 0;
    }

    export set(K key, V value) {
        long existing = this.findSlot(key);
        if (existing >= 0) {
            this.slotValues.write(existing, value);
            return;
        }
        if ((this.count + 1) * 4 > this.capacity * 3) {
            this.resize();
        }
        long slot = this.freeSlot(key);
        this.slotKeys.write(slot, key);
        this.slotValues.write(slot, value);
        this.slotStates[slot] = 1;
        this.count = this.count + 1;
    }

    export get(K key) -> V? {
        long slot = this.findSlot(key);
        if (slot < 0) {
            return null;
        }
        return this.slotValues.read(slot);
    }

    export contains(K key) -> bool {
        return this.findSlot(key) >= 0;
    }

    export remove(K key) -> bool {
        long slot = this.findSlot(key);
        if (slot < 0) {
            return false;
        }
        this.slotStates[slot] = 2;
        this.slotKeys.clear(slot);
        this.slotValues.clear(slot);
        this.count = this.count - 1;
        return true;
    }

    export length() -> long {
        return this.count;
    }

    // Reserved to the exact count, so the store never grows and each key is read once.
    export keys() -> K[] {
        let gathered = List<K>.withCapacity(this.count);
        long slot = 0;
        while (slot < this.capacity) {
            if (this.slotStates[slot] == 1) {
                gathered.push(this.slotKeys.read(slot));
            }
            slot = slot + 1;
        }
        return gathered.toArray();
    }

    export values() -> V[] {
        let gathered = List<V>.withCapacity(this.count);
        long slot = 0;
        while (slot < this.capacity) {
            if (this.slotStates[slot] == 1) {
                gathered.push(this.slotValues.read(slot));
            }
            slot = slot + 1;
        }
        return gathered.toArray();
    }

    export override makeIterator() -> Iterator<Pair<K, V>> {
        return new MapIterator<K, V>(this.slotKeys, this.slotValues, this.slotStates, this.capacity);
    }

    // First occupied slot holding this key, or -1. Removed slots are probed
    // through; an empty slot ends the chain.
    findSlot(K key) -> long {
        long slot = key.hash() & (this.capacity - 1);
        long probed = 0;
        while (probed < this.capacity) {
            if (this.slotStates[slot] == 0) {
                return -1;
            }
            if (this.slotStates[slot] == 1 && this.slotKeys.read(slot) == key) {
                return slot;
            }
            slot = (slot + 1) & (this.capacity - 1);
            probed = probed + 1;
        }
        return -1;
    }

    // First insertable slot (empty or removed) on the key's probe chain. The
    // caller has already ruled out an occupied slot holding this key.
    freeSlot(K key) -> long {
        long slot = key.hash() & (this.capacity - 1);
        while (this.slotStates[slot] == 1) {
            slot = (slot + 1) & (this.capacity - 1);
        }
        return slot;
    }

    resize() {
        long oldCapacity = this.capacity;
        let oldKeys = this.slotKeys;
        let oldValues = this.slotValues;
        byte[] oldStates = this.slotStates;

        this.capacity = this.capacity * 2;
        this.slotKeys = RawArray<K>.allocate(this.capacity);
        this.slotValues = RawArray<V>.allocate(this.capacity);
        this.slotStates = new byte[this.capacity];

        long slot = 0;
        while (slot < oldCapacity) {
            if (oldStates[slot] == 1) {
                let movedKey = oldKeys.read(slot);
                long target = movedKey.hash() & (this.capacity - 1);
                while (this.slotStates[target] == 1) {
                    target = (target + 1) & (this.capacity - 1);
                }
                this.slotKeys.write(target, movedKey);
                this.slotValues.write(target, oldValues.read(slot));
                this.slotStates[target] = 1;
            }
            slot = slot + 1;
        }
    }
}

class MapIterator<K, V> implements Iterator<Pair<K, V>> {
    RawArray<K> slotKeys;
    RawArray<V> slotValues;
    byte[] slotStates;
    long capacity;
    long position;

    protected constructor(this.slotKeys, this.slotValues, this.slotStates, this.capacity) {
        this.position = 0;
        this.skipToOccupied();
    }

    protected override hasNext() -> bool {
        return this.position < this.capacity;
    }

    protected override next() -> Pair<K, V> {
        if (this.position >= this.capacity) {
            panic("next past the end of a map");
        }
        Pair<K, V> entry = {
            key: this.slotKeys.read(this.position),
            value: this.slotValues.read(this.position),
        };
        this.position = this.position + 1;
        this.skipToOccupied();
        return entry;
    }

    skipToOccupied() {
        while (this.position < this.capacity && this.slotStates[this.position] != 1) {
            this.position = this.position + 1;
        }
    }
}
