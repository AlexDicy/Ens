import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import RawArray from @std.collections.rawarray;

// A growable, generic array. The store doubles when full, so only the first `count` slots hold
// pushed values and every indexed operation answers to `count` rather than to the store's size.
export class List<T> implements Iterable<T> {
    RawArray<T> items;
    long count;

    export constructor() {
        this.items = RawArray<T>.allocate(4);
        this.count = 0;
    }

    // A list with room for this many values before its store has to grow, for a caller that
    // knows the count it is about to push.
    export static withCapacity(long capacity) -> List<T> {
        return new List<T>(capacity);
    }

    constructor(long capacity) {
        this.items = RawArray<T>.allocate(capacity < 1 ? 1 : capacity);
        this.count = 0;
    }

    export push(T value) {
        if (this.count == this.items.length()) {
            this.grow();
        }
        this.items.write(this.count, value);
        this.count = this.count + 1;
    }

    export pop() -> T {
        if (this.count == 0) {
            panic("pop from an empty list");
        }
        let value = this.items.read(this.count - 1);
        this.count = this.count - 1;
        this.items.clear(this.count);
        return value;
    }

    export get(long index) -> T {
        if (index < 0 || index >= this.count) {
            panic("list index {index} is out of bounds for length {this.count}");
        }
        return this.items.read(index);
    }

    export set(long index, T value) {
        if (index < 0 || index >= this.count) {
            panic("list index {index} is out of bounds for length {this.count}");
        }
        this.items.write(index, value);
    }

    export length() -> long {
        return this.count;
    }

    export toArray() -> T[] {
        T[] copied = new T[this.count];
        for (long index = 0; index < copied.length; index++) {
            copied[index] = this.items.read(index);
        }
        return copied;
    }

    export override makeIterator() -> Iterator<T> {
        return new ListIterator<T>(this.items, this.count);
    }

    grow() {
        let grown = RawArray<T>.allocate(this.items.length() * 2);
        long i = 0;
        while (i < this.count) {
            grown.write(i, this.items.read(i));
            i = i + 1;
        }
        this.items = grown;
    }
}

class ListIterator<T> implements Iterator<T> {
    RawArray<T> items;
    long count;
    long position;

    protected constructor(this.items, this.count) {
        this.position = 0;
    }

    override hasNext() -> bool {
        return this.position < this.count;
    }

    override next() -> T {
        if (this.position >= this.count) {
            panic("next past the end of a list");
        }
        let value = this.items.read(this.position);
        this.position = this.position + 1;
        return value;
    }
}
