import Collection from @std.collections.collection;
import Iterator from @std.collections.iterator;
import RawArray from @std.collections.rawarray;

// A sequence that grows and shrinks at either end, keeping values in the order they were put in.
// The values sit in a ring over the store: the first one is at `head`, the rest follow it and wrap
// around at the end of the store, so both ends move in constant time.
export final class Deque<T> implements Collection<T>, Copyable<Deque<T>> {
    protected RawArray<T> items;
    protected long head;
    protected long count;

    export constructor() {
        this.items = RawArray<T>.allocate(4);
        this.head = 0;
        this.count = 0;
    }

    constructor(long capacity) {
        this.items = RawArray<T>.allocate(capacity < 1 ? 1 : capacity);
        this.head = 0;
        this.count = 0;
    }

    // A deque that can hold `capacity` values before it has to grow. The length is still zero.
    export static withCapacity(long capacity) -> Deque<T> {
        return new Deque<T>(capacity);
    }

    export override length() -> long {
        return this.count;
    }

    export override isEmpty() -> bool {
        return this.count == 0;
    }

    export override contains(T value) -> bool {
        for (long index = 0; index < this.count; index++) {
            if (this.items.read(this.slotOf(index)) == value) {
                return true;
            }
        }
        return false;
    }

    // Walks from the front to the back.
    export override makeIterator() -> Iterator<T> {
        return new DequeIterator<T>(this);
    }

    export pushFront(T value) {
        this.reserve(this.count + 1);
        this.head = this.head == 0 ? this.items.length() - 1 : this.head - 1;
        this.items.write(this.head, value);
        this.count = this.count + 1;
    }

    export pushBack(T value) {
        this.reserve(this.count + 1);
        this.items.write(this.slotOf(this.count), value);
        this.count = this.count + 1;
    }

    // Takes the first value off and answers it. Aborts the program on an empty deque.
    export popFront() -> T {
        if (this.count == 0) {
            panic("popFront from an empty deque: check isEmpty() first");
        }
        let value = this.items.read(this.head);
        this.items.clear(this.head);
        this.head = this.slotOf(1);
        this.count = this.count - 1;
        return value;
    }

    // Takes the last value off and answers it. Aborts the program on an empty deque.
    export popBack() -> T {
        if (this.count == 0) {
            panic("popBack from an empty deque: check isEmpty() first");
        }
        this.count = this.count - 1;
        long slot = this.slotOf(this.count);
        let value = this.items.read(slot);
        this.items.clear(slot);
        return value;
    }

    // The first and last values. Either one aborts the program on an empty deque.
    export first() -> T {
        if (this.count == 0) {
            panic("first of an empty deque: check isEmpty() first");
        }
        return this.items.read(this.head);
    }

    export last() -> T {
        if (this.count == 0) {
            panic("last of an empty deque: check isEmpty() first");
        }
        return this.items.read(this.slotOf(this.count - 1));
    }

    // The value `index` places from the front. An index outside the deque aborts the program,
    // because reading past an end is a mistake in the caller rather than a condition to recover
    // from.
    export get(long index) -> T {
        if (index < 0 || index >= this.count) {
            panic("deque index {index} is out of bounds for length {this.count}");
        }
        return this.items.read(this.slotOf(index));
    }

    export clear() {
        for (long index = 0; index < this.count; index++) {
            this.items.clear(this.slotOf(index));
        }
        this.head = 0;
        this.count = 0;
    }

    // Makes room for `capacity` values before the store has to grow again. The values start over
    // from the first slot of the new store.
    export reserve(long capacity) {
        if (capacity <= this.items.length()) {
            return;
        }
        long size = this.items.length();
        while (size < capacity) {
            size = size * 2;
        }
        let grown = RawArray<T>.allocate(size);
        for (long index = 0; index < this.count; index++) {
            grown.write(index, this.items.read(this.slotOf(index)));
        }
        this.items = grown;
        this.head = 0;
    }

    export override copy() -> Deque<T> {
        let copied = new Deque<T>(this.count);
        for (long index = 0; index < this.count; index++) {
            copied.items.write(index, this.items.read(this.slotOf(index)));
        }
        copied.count = this.count;
        return copied;
    }

    export toArray() -> T[] {
        T[] copied = new T[this.count];
        for (long index = 0; index < copied.length; index++) {
            copied[index] = this.items.read(this.slotOf(index));
        }
        return copied;
    }

    // The slot holding the value `index` places from the front, for an index below the store's
    // size.
    protected slotOf(long index) -> long {
        long slot = this.head + index;
        if (slot >= this.items.length()) {
            return slot - this.items.length();
        }
        return slot;
    }
}

class DequeIterator<T> implements Iterator<T> {
    Deque<T> deque;
    long position;

    protected constructor(this.deque) {
        this.position = 0;
    }

    protected override next() -> T? {
        if (this.position >= this.deque.count) {
            return null;
        }
        let value = this.deque.items.read(this.deque.slotOf(this.position));
        this.position = this.position + 1;
        return value;
    }
}
