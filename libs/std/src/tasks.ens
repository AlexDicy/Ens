// Tasks, and the types for sharing state between them. Every operation on these classes is
// thread-safe, so any number of tasks can hold the same instance. Tasks run over the pool of
// threads in @std.tasks.scheduler, each on a stack of its own, and a task that waits leaves its
// thread to the others until it is woken.
import RawArray from @std.collections.rawarray;
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import Context from @std.system;
import NativeWatch from @std.system;
import NativeThread from @std.system;
import Poller from @std.system;
import RecordSlot from @std.system;
import ThreadLock from @std.system;
import WatchState from @std.system;
import @std.system;
import Pool from @std.tasks.scheduler;
import Clockwork from @std.tasks.waiting;
import Waiter from @std.tasks.waiting;
import WaitList from @std.tasks.waiting;

// A value that tasks read and replace without a lock. The compiler turns 'read', 'write' and
// 'compareAndSet' into the processor's atomic instructions, so the bodies below never run.
// References are compared by identity.
export shared final class Atomic<shared T> {
    T value;

    export constructor(this.value);

    // Returns the current value.
    export read() -> T {
        return this.value;
    }

    // Replaces the value.
    export write(T value) {
        this.value = value;
    }

    // Replaces the value with `replacement` only if it is still `expected`, and returns whether it
    // did.
    export compareAndSet(T expected, T replacement) -> bool {
        panic("Internal: 'compareAndSet' is lowered to an atomic instruction");
    }

    // Adds `amount` and returns the new value.
    export add<T: Number<T>>(T amount) -> T {
        while (true) {
            T current = this.read();
            T next = current.plus(amount);
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }

    // Adds one and returns the new value.
    export increment<T: Number<T>>() -> T {
        while (true) {
            T current = this.read();
            T next = current.incremented();
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }

    // Subtracts one and returns the new value.
    export decrement<T: Number<T>>() -> T {
        while (true) {
            T current = this.read();
            T next = current.decremented();
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }
}

// A value that tasks change one at a time. The value itself does not need to be shareable, because
// it never leaves the lock.
export shared final class Mutex<T> {
    const TurnLock turn;
    T value;

    export constructor(this.value) {
        this.turn = new TurnLock();
    }

    // Waits until no other task holds the lock, then runs `body` with the value and returns its
    // result. `body` must be a shared function and its result must be shareable, so the value
    // cannot escape the lock. A task cancelled while it waits throws 'Cancelled' without running
    // `body`.
    export lock<shared R, E: Error>((shared (T) -> R throws E) body) -> R throws E, Cancelled {
        try this.enter();
        return try this.holding(body);
    }

    // Waits until no other task holds the lock, then replaces the value with what `body` returns.
    // Use this for numbers and structs: 'lock' passes them as a copy, so changes made there are
    // lost. A task cancelled while it waits throws 'Cancelled' without running `body`.
    export update<E: Error>((shared (T) -> T throws E) body) throws E, Cancelled {
        try this.enter();
        try this.replacing(body);
    }

    holding<shared R, E: Error>((shared (T) -> R throws E) body) -> R throws E {
        R result = try body(this.value);
        this.turn.leave();
        return result;
    } catch (E failure) {
        this.turn.leave();
        rethrow;
    }

    replacing<E: Error>((shared (T) -> T throws E) body) throws E {
        this.value = try body(this.value);
        this.turn.leave();
    } catch (E failure) {
        this.turn.leave();
        rethrow;
    }

    enter() throws Cancelled {
        if (this.turn.heldByCaller()) {
            string tried = "tried";
            let control = Registry.current();
            if (control != null) {
                let site = startSite(control.startedAt);
                if (site != null) {
                    tried = "the task started at {site} tried";
                }
            }
            panic("{tried} to lock a mutex inside a body this task is already running under its "
                + "lock, which would wait for ever. Use the value that body was given instead");
        }
        try this.turn.enter();
    }
}

// One task at a time: the others wait their turn in the order they came, parked when they run on
// the pool, and a task cancelled while it waits stops waiting.
public shared final class TurnLock {
    const Monitor guard;
    const WaitList free;
    long holder;

    public constructor() {
        this.guard = new Monitor();
        this.free = new WaitList();
        this.holder = 0;
    }

    // Whether the calling task holds the lock.
    public heldByCaller() -> bool {
        this.guard.enter();
        bool held = this.holder == system.taskToken();
        this.guard.leave();
        return held;
    }

    // Waits until no other task holds the lock and takes it, or throws 'Cancelled' without it when
    // the calling task is cancelled while it waits.
    public enter() throws Cancelled {
        long caller = system.taskToken();
        this.guard.enter();
        while (this.holder != 0) {
            if (!this.guard.waitUnlessCancelled(this.free, -1)) {
                this.guard.leave();
                throw new Cancelled();
            }
        }
        this.holder = caller;
        this.guard.leave();
    }

    public leave() {
        this.guard.enter();
        this.holder = 0;
        this.free.wakeOne();
        this.guard.leave();
    }
}

// Any number of tasks at once, or one task alone: one that enters alone waits until the others
// have left, and the others wait until it leaves.
public shared final class SharedLock {
    const Monitor guard;
    const WaitList changed;
    long sharing;
    bool alone;

    public constructor() {
        this.guard = new Monitor();
        this.changed = new WaitList();
        this.sharing = 0;
        this.alone = false;
    }

    public enterShared() {
        this.guard.enter();
        while (this.alone) {
            this.guard.wait(this.changed, -1);
        }
        this.sharing = this.sharing + 1;
        this.guard.leave();
    }

    public leaveShared() {
        this.guard.enter();
        this.sharing = this.sharing - 1;
        if (this.sharing == 0) {
            this.changed.wakeAll();
        }
        this.guard.leave();
    }

    public enterAlone() {
        this.guard.enter();
        while (this.alone) {
            this.guard.wait(this.changed, -1);
        }
        this.alone = true;
        while (this.sharing > 0) {
            this.guard.wait(this.changed, -1);
        }
        this.guard.leave();
    }

    public leaveAlone() {
        this.guard.enter();
        this.alone = false;
        this.changed.wakeAll();
        this.guard.leave();
    }
}

// Thrown by 'send' when the channel's receiving end has been released, so no one would ever receive
// the value.
export class ChannelClosed extends Error {
    export constructor() {
        super("could not send: the receiving end of the channel has been released, so nothing would "
            + "ever receive the value. Keep the Channel while values are sent to it");
    }
}

// The receiving end of a channel, which carries values from tasks that send to tasks that receive.
// The channel closes when its last Sender is released, and a 'for' loop over it ends once it is
// closed and empty.
export shared final class Channel<shared T> implements Iterable<T> {
    const ChannelState<T> state;

    // Makes a channel that buffers up to `capacity` values; 'send' waits while the buffer is full.
    // With a capacity of zero, every send waits until a task receives the value.
    export constructor(long capacity) {
        this.state = new ChannelState<T>(capacity);
    }

    // Returns the next value, waiting for one to be sent, or null once the channel is closed and
    // empty. A task cancelled while it waits throws 'Cancelled'.
    export receive() -> T? throws Cancelled {
        return try this.state.take(-1);
    }

    // Like 'receive()', but also returns null when nothing arrives within `timeoutMillis`
    // milliseconds. 'isClosed' tells the two cases apart.
    export receive(long timeoutMillis) -> T? throws Cancelled {
        return try this.state.take(timeoutMillis < 0 ? 0 : timeoutMillis);
    }

    // Returns whether every Sender has been released, so no more values can arrive.
    export isClosed() -> bool {
        return this.state.isClosed();
    }

    // Returns a new Sender for this channel. The channel stays open while any Sender is alive.
    export sender() -> Sender<T> {
        this.state.addSender();
        return new Sender<T>(this.state);
    }

    export override makeIterator() -> Iterator<T> {
        return new ChannelIterator<T>(this);
    }

    // Returns the next value like 'receive()', waiting for it even in a cancelled task.
    protected receiveWaiting() -> T? {
        return this.state.takeWaiting();
    }

    destructor() {
        this.state.releaseReceiver();
    }
}

// Sends values into one channel. Releasing the last Sender closes the channel.
export shared final class Sender<shared T> {
    const ChannelState<T> state;

    protected constructor(this.state);

    // Puts `value` into the channel. Waits while the buffer is full, or, with a capacity of zero,
    // until a task receives the value. A task cancelled while it waits throws 'Cancelled', and the
    // value is not sent.
    export send(T value) throws ChannelClosed, Cancelled {
        try this.state.put(value);
    }

    destructor() {
        this.state.releaseSender();
    }
}

// Walks a channel until it is closed and empty. Its waits go on in a cancelled task, because the
// channel closes once the tasks sending to it stop.
final class ChannelIterator<shared T> implements Iterator<T> {
    const Channel<T> channel;

    protected constructor(this.channel);

    protected override next() -> T? {
        return this.channel.receiveWaiting();
    }
}

// The state both ends of a channel share: a ring buffer of values not yet received, the lock that
// guards every change to it, and the tasks waiting for a value, for room, and for the receipt of
// the value a send with no capacity handed over. Each wait wakes only the tasks it concerns, so a
// channel with many waiting tasks costs each send one wake.
shared final class ChannelState<shared T> {
    const Monitor lock;
    const WaitList receivers;
    const WaitList room;
    const WaitList receipt;
    const long capacity;
    RawArray<T> slots;
    long head;
    long count;
    long received;
    long senders;
    bool everSent;
    bool receiverReleased;

    protected constructor(this.capacity) {
        this.lock = new Monitor();
        this.receivers = new WaitList();
        this.room = new WaitList();
        this.receipt = new WaitList();
        this.slots = RawArray<T>.allocate(this.capacity < 1 ? 1 : this.capacity);
        this.head = 0;
        this.count = 0;
        this.received = 0;
        this.senders = 0;
        this.everSent = false;
        this.receiverReleased = false;
    }

    protected put(T value) throws ChannelClosed, Cancelled {
        this.lock.enter();
        while (!this.receiverReleased && this.count == this.slots.length()) {
            if (!this.lock.waitUnlessCancelled(this.room, -1)) {
                this.lock.leave();
                throw new Cancelled();
            }
        }
        if (this.receiverReleased) {
            this.lock.leave();
            throw new ChannelClosed();
        }
        this.slots.write((this.head + this.count) % this.slots.length(), value);
        this.count++;
        long position = this.received + this.count;
        this.receivers.wakeOne();
        if (this.capacity == 0) {
            while (!this.receiverReleased && this.received < position) {
                if (!this.lock.waitUnlessCancelled(this.receipt, -1) && this.received < position) {
                    this.withdraw();
                    throw new Cancelled();
                }
            }
            if (this.received < position) {
                this.withdraw();
                throw new ChannelClosed();
            }
        }
        this.lock.leave();
    }

    // Takes back the value a send with a capacity of zero put in, which nothing received, and
    // releases the lock.
    withdraw() {
        this.slots.clear(this.head);
        this.count--;
        this.room.wakeOne();
        this.lock.leave();
    }

    // Returns the next value. A negative `limitMillis` waits with no time limit.
    protected take(long limitMillis) -> T? throws Cancelled {
        this.lock.enter();
        if (!this.awaitValue(limitMillis, true)) {
            this.lock.leave();
            throw new Cancelled();
        }
        return this.removeHead();
    }

    // Returns the next value, waiting for it with no time limit even in a cancelled task.
    protected takeWaiting() -> T? {
        this.lock.enter();
        let waited = this.awaitValue(-1, false);
        return this.removeHead();
    }

    // Waits, with the lock held, until a value is there, the channel is closed, or `limitMillis`
    // milliseconds pass when it is not negative. Returns false when `cancellable` is set and the
    // calling task is cancelled first.
    awaitValue(long limitMillis, bool cancellable) -> bool {
        long deadline = system.monotonicMillis() + limitMillis;
        while (this.count == 0 && !this.closed()) {
            long left = -1;
            if (limitMillis >= 0) {
                left = deadline - system.monotonicMillis();
                if (left <= 0) {
                    return true;
                }
            }
            if (!cancellable) {
                this.lock.wait(this.receivers, left);
            } else if (!this.lock.waitUnlessCancelled(this.receivers, left)) {
                return false;
            }
        }
        return true;
    }

    // Takes the value at the head, or null when there is none, and releases the lock. The sender
    // of a handed-over value is told of its receipt, and one sender waiting for room is given it.
    removeHead() -> T? {
        if (this.count == 0) {
            this.lock.leave();
            return null;
        }
        T value = this.slots.read(this.head);
        this.slots.clear(this.head);
        this.head = (this.head + 1) % this.slots.length();
        this.count--;
        this.received++;
        this.receipt.wakeAll();
        this.room.wakeOne();
        this.lock.leave();
        return value;
    }

    protected isClosed() -> bool {
        this.lock.enter();
        bool ended = this.closed();
        this.lock.leave();
        return ended;
    }

    // Whether a Sender was ever made and every one has been released.
    closed() -> bool {
        return this.everSent && this.senders == 0;
    }

    protected addSender() {
        this.lock.enter();
        this.senders++;
        this.everSent = true;
        this.lock.leave();
    }

    protected releaseSender() {
        this.lock.enter();
        this.senders--;
        if (this.senders == 0) {
            this.receivers.wakeAll();
        }
        this.lock.leave();
    }

    protected releaseReceiver() {
        this.lock.enter();
        this.receiverReleased = true;
        this.room.wakeAll();
        this.receipt.wakeAll();
        this.lock.leave();
    }
}

// Thrown by 'checkCancelled' in a task that was asked to stop.
export class Cancelled extends Error {
    export constructor() {
        super("the task was cancelled");
    }
}

// Runs `body` with a new scope on the calling task, and returns what the body returns once the body
// has returned and every task started in the scope has finished. When the body throws, the scope's
// tasks are cancelled and waited for before the error goes on.
export scope<R, E: Error>(((TaskScope) -> R throws E) body) -> R throws E {
    let created = new TaskScope();
    return try created.run(body);
}

// Returns whether the calling task was asked to stop, by its own 'cancel', by a scope it belongs to,
// or by the task that started that scope.
export isCancelled() -> bool {
    let control = Registry.current();
    return control != null && control.isCancelled();
}

// Throws 'Cancelled' when the calling task was asked to stop.
export checkCancelled() throws Cancelled {
    if (isCancelled()) {
        throw new Cancelled();
    }
}

// How a wait for a stream or a child ended: the event happened, or needs no wait; it cannot be
// watched, so the call that follows waits in the system; the calling task was cancelled; or the
// watch failed, with the system's number.
public enum EventEnd {
    Arrived,
    Unwatched,
    Cancelled,
    Failed,
}

public struct EventWait {
    public const EventEnd end;
    public const int code;
}

// Waits for the event `watch` registers, handing it the poller and the token to register it
// under, so a task parks rather than holding its thread, and a cancel ends the wait. A task
// already cancelled does not register at all.
public awaitEvent(((Poller, long) -> NativeWatch) watch) -> EventWait {
    let control = Registry.current();
    if (control != null && control.isCancelled()) {
        return eventEnd(EventEnd.Cancelled, 0);
    }
    let events = Clockwork.events;
    let waiter = control == null ? new Waiter(null) : control.waiter();
    long token = events.enlist(waiter);
    let watched = watch(events.poller, token);
    switch (watched.state) {
        WatchState.watching -> { },
        WatchState.ready -> {
            events.discharge(token);
            return eventEnd(EventEnd.Arrived, 0);
        },
        WatchState.unwatchable -> {
            events.discharge(token);
            return eventEnd(EventEnd.Unwatched, 0);
        },
        WatchState.failed -> {
            events.discharge(token);
            return eventEnd(EventEnd.Failed, watched.code);
        },
    }
    if (control == null) {
        waiter.await(-1);
        return eventEnd(EventEnd.Arrived, 0);
    }
    control.block(waiter);
    if (!control.isCancelled()) {
        waiter.await(-1);
    }
    control.unblock();
    if (control.isCancelled()) {
        events.discharge(token);
        return eventEnd(EventEnd.Cancelled, 0);
    }
    return eventEnd(EventEnd.Arrived, 0);
}

eventEnd(EventEnd end, int code) -> EventWait {
    EventWait wait = {end: end, code: code};
    return wait;
}

// Blocks the calling task until the monotonic clock has advanced by `millis` milliseconds. The wait
// can last longer, and a count of zero or less returns without waiting. A task cancelled while it
// waits throws 'Cancelled' at once.
export sleep(long millis) throws Cancelled {
    if (millis <= 0) {
        return;
    }
    long deadline = system.monotonicMillis() + millis;
    let control = Registry.current();
    while (system.monotonicMillis() < deadline) {
        if (control == null) {
            new Waiter(null).await(deadline);
            continue;
        }
        if (control.isCancelled()) {
            throw new Cancelled();
        }
        let waiter = control.waiter();
        control.block(waiter);
        if (!control.isCancelled()) {
            waiter.await(deadline);
        }
        control.unblock();
        if (control.isCancelled()) {
            throw new Cancelled();
        }
    }
}

// How urgently the system runs the thread of a task started with 'startDedicated'. A system that
// refuses a level, as one often does for a program without the privilege, runs the thread at the
// highest level it allows.
export enum TaskPriority {
    // As every other thread runs.
    Normal = 0,

    // Ahead of ordinary threads, for work someone is watching, such as rendering.
    High = 1,

    // As soon as it is ready, for work with a deadline, such as filling an audio buffer.
    Realtime = 2,
}

// A set of tasks that ends only when all of them have. Releasing a scope cancels the tasks still in
// it and waits for them.
export shared final class TaskScope {
    const ScopeState state;

    export constructor() {
        this.state = new ScopeState(Registry.current());
    }

    // Starts `body` on another task at once and returns the task without waiting for it.
    export start<T, E: Error>((shared () -> T throws E) body) -> Task<(() -> T throws E)> {
        let control = new TaskControl(this.state, system.captureTrace(8));
        let outcome = new TaskOutcome<T, E>(this.state.record(control.startedAt));
        this.state.begin(control, () -> {
            outcome.complete(body, control);
            if (outcome.threw()) {
                this.state.cancel();
            }
        });
        return new Task<(() -> T throws E)>(control, outcome);
    }

    // Starts `body` like 'start', on an operating-system thread of its own that the system runs at
    // `priority`, for a loop that must not share a thread, such as audio or rendering.
    export startDedicated<T, E: Error>(TaskPriority priority, (shared () -> T throws E) body)
            -> Task<(() -> T throws E)> {
        let control = new TaskControl(this.state, system.captureTrace(8));
        let outcome = new TaskOutcome<T, E>(this.state.record(control.startedAt));
        this.state.beginDedicated(control, priority as int, () -> {
            outcome.complete(body, control);
            if (outcome.threw()) {
                this.state.cancel();
            }
        });
        return new Task<(() -> T throws E)>(control, outcome);
    }

    // Starts `body`, which returns nothing, on another task, for work nobody waits for. The body
    // can throw only 'Cancelled', which ends a task that was asked to stop; thrown by a task
    // nothing cancelled, it aborts the program.
    export launch((shared () -> void throws Cancelled) body) {
        let control = new TaskControl(this.state, system.captureTrace(8));
        this.state.begin(control, () -> runLaunched(body, control));
    }

    // Asks every task in the scope to stop.
    export cancel() {
        this.state.cancel();
    }

    // Asks every task in the scope to stop once `millis` milliseconds have passed, unless the scope
    // has ended by then.
    export cancelAfter(long millis) {
        this.state.cancelAfter(millis);
    }

    public run<R, E: Error>(((TaskScope) -> R throws E) body) -> R throws E {
        R result = try body(this);
        this.state.end(true);
        return result;
    } catch (E failure) {
        this.state.cancel();
        this.state.end(false);
        rethrow;
    }

    destructor() {
        this.state.cancel();
        this.state.end(true);
    }
}

// A task a scope started, written with the function type it runs, as in 'Task<() -> int>'.
export shared final class Task<shared () -> T throws E> {
    const TaskControl control;
    const TaskOutcome<T, E> outcome;

    protected constructor(this.control, this.outcome);

    // Waits for the task and returns what its body returned, or throws what its body threw. A
    // result another task may not hold is taken once, and awaiting it again aborts the program. A
    // task that awaits a task waiting for it, directly or through others, aborts the program
    // instead of waiting for ever, and a task cancelled while it waits throws 'Cancelled'.
    export await() -> T throws E, Cancelled {
        let waiting = Registry.current();
        waiting?.startAwaiting(this.control);
        return try this.outcome.take(waiting);
    }

    // Asks this task, and every task it started, to stop.
    export cancel() {
        this.control.cancel();
    }
}

// Which task runs on the calling thread: the one its worker runs when the thread is the pool's,
// the one registered under the thread's token when the thread is a dedicated task's, and none
// otherwise.
final class Registry {
    protected lazy const DedicatedTasks dedicated = new DedicatedTasks();
    protected lazy const Atomic<long> tokens = new Atomic<long>(0);

    // The task running on the calling thread, or null outside every task.
    protected static current() -> TaskControl? {
        if (system.readThreadSlot(RecordSlot.worker) != 0) {
            return Pool.scheduler.currentWorker()?.running();
        }
        if (system.readThreadSlot(RecordSlot.task) == 0) {
            return null;
        }
        return Registry.dedicated.current();
    }

    // A token no two tasks share, and never zero.
    protected static nextToken() -> long {
        return Registry.tokens.increment();
    }
}

// The tasks running on threads of their own, by the token their thread carries.
shared final class DedicatedTasks {
    const ThreadLock lock;
    Map<long, TaskControl> byToken;

    protected constructor() {
        this.lock = system.createLock();
        this.byToken = new Map<long, TaskControl>();
    }

    protected enter(TaskControl control) {
        system.acquireLock(this.lock);
        this.byToken.set(control.token, control);
        system.releaseLock(this.lock);
        system.writeThreadSlot(RecordSlot.task, control.token);
    }

    protected leave(TaskControl control) {
        system.writeThreadSlot(RecordSlot.task, 0);
        system.acquireLock(this.lock);
        let removed = this.byToken.remove(control.token);
        system.releaseLock(this.lock);
    }

    protected current() -> TaskControl? {
        system.acquireLock(this.lock);
        let control = this.byToken.get(system.readThreadSlot(RecordSlot.task));
        system.releaseLock(this.lock);
        return control;
    }
}

// What a task's waiter and its worker agree on about a park: the task is running, it is parked, or
// it was woken before it finished parking and runs on at once.
final class ParkState {
    protected static const long running = 0;
    protected static const long parked = 1;
    protected static const long wakePending = 2;
}

// Whether one task was asked to stop, the scope it belongs to, what it is waiting on, and the
// scopes it started, whose tasks a cancel of this one wakes as well; and, for the scheduler, the
// body the task runs, the context it runs on, and whether it has parked or ended.
export shared final class TaskControl {
    const ScopeState scope;
    protected const long[] startedAt;
    public const long token;
    const Atomic<bool> cancelled;
    const Atomic<TaskControl?> awaiting;
    public const Atomic<bool> finished;
    const Atomic<long> parkState;
    const ThreadLock lock;
    Waiter? blockedOn;
    List<ScopeState> scopes;
    public (shared () -> void)? body;
    public Context? context;

    protected constructor(this.scope, this.startedAt) {
        this.token = Registry.nextToken();
        this.cancelled = new Atomic<bool>(false);
        this.awaiting = new Atomic<TaskControl?>(null);
        this.finished = new Atomic<bool>(false);
        this.parkState = new Atomic<long>(ParkState.running);
        this.lock = system.createLock();
        this.blockedOn = null;
        this.scopes = new List<ScopeState>();
        this.body = null;
        this.context = null;
    }

    // Records that this task waits for `target`, and aborts the program when `target` waits for
    // this one, directly or through other tasks.
    protected startAwaiting(TaskControl target) {
        this.awaiting.write(target);
        let chain = new List<TaskControl>();
        chain.push(this);
        TaskControl? next = target;
        while (next != null && chain.length() <= Limits.awaitChain) {
            if (next == this) {
                panic(cycleRefusal(chain));
            }
            chain.push(next);
            next = next.awaiting.read();
        }
    }

    protected stopAwaiting() {
        this.awaiting.write(null);
    }

    protected cancel() {
        this.cancelled.write(true);
        this.wake();
    }

    protected isCancelled() -> bool {
        return this.cancelled.read() || this.scope.isCancelled();
    }

    // A waiter for this task: one that parks it when it runs on the pool, one that puts its thread
    // to sleep when it has a thread of its own.
    protected waiter() -> Waiter {
        if (this.body == null) {
            return new Waiter(null);
        }
        return new Waiter(this);
    }

    // Records that the task waits on `waiter`.
    protected block(Waiter waiter) {
        system.acquireLock(this.lock);
        this.blockedOn = waiter;
        system.releaseLock(this.lock);
    }

    protected unblock() {
        system.acquireLock(this.lock);
        this.blockedOn = null;
        system.releaseLock(this.lock);
    }

    protected adopt(ScopeState started) {
        system.acquireLock(this.lock);
        this.scopes.push(started);
        system.releaseLock(this.lock);
    }

    protected disown(ScopeState ended) {
        system.acquireLock(this.lock);
        let removed = this.scopes.remove(ended);
        system.releaseLock(this.lock);
    }

    // Wakes the task from the wait it is in, and every task in the scopes it started, so each of
    // them checks again whether it was cancelled.
    protected wake() {
        system.acquireLock(this.lock);
        let waiter = this.blockedOn;
        let started = this.scopes.toArray();
        system.releaseLock(this.lock);
        if (waiter != null) {
            let woke = waiter.wake();
        }
        for (let scope in started) {
            scope.wakeTasks();
        }
    }

    // Leaves the task's context for its worker's until the task is queued and run again. Only the
    // task itself calls this, on its own context.
    public park() {
        let context = this.context;
        let worker = Pool.scheduler.currentWorker();
        if (context == null || worker == null) {
            panic("Internal: a task parked off its context");
        }
        system.switchContext(context, worker.homeContext());
    }

    // What the worker does once the task has left its context without ending: records the park,
    // or runs the task on at once when a wake arrived first.
    public completePark() {
        if (this.parkState.compareAndSet(ParkState.running, ParkState.parked)) {
            return;
        }
        this.parkState.write(ParkState.running);
        Pool.scheduler.makeRunnable(this);
    }

    // Queues the task to run again, or notes the wake for a park that is still under way.
    public unpark() {
        while (true) {
            long state = this.parkState.read();
            if (state == ParkState.parked) {
                if (this.parkState.compareAndSet(ParkState.parked, ParkState.running)) {
                    Pool.scheduler.makeRunnable(this);
                    return;
                }
            } else if (state == ParkState.running) {
                if (this.parkState.compareAndSet(ParkState.running, ParkState.wakePending)) {
                    return;
                }
            } else {
                return;
            }
        }
    }

    destructor() {
        system.destroyLock(this.lock);
    }
}

// A lock that tasks wait under, each on one of its wait lists, until another task wakes them. A task
// cancelled while it waits is woken through the waiter it keeps for as long as it waits.
shared final class Monitor {
    const ThreadLock lock;

    protected constructor() {
        this.lock = system.createLock();
    }

    protected enter() {
        system.acquireLock(this.lock);
    }

    protected leave() {
        system.releaseLock(this.lock);
    }

    // Waits, with the monitor held, on `list` until woken or `millis` milliseconds pass, with no
    // limit when `millis` is negative. The monitor is held again on return.
    protected wait(WaitList list, long millis) {
        let control = Registry.current();
        let waiter = control == null ? new Waiter(null) : control.waiter();
        this.waitWith(waiter, list, millis);
    }

    // Like 'wait', but returns false, without waiting or as soon as it is woken, when the calling
    // task is cancelled.
    protected waitUnlessCancelled(WaitList list, long millis) -> bool {
        let control = Registry.current();
        if (control == null) {
            this.wait(list, millis);
            return true;
        }
        let waiter = control.waiter();
        control.block(waiter);
        bool waiting = !control.isCancelled();
        if (waiting) {
            this.waitWith(waiter, list, millis);
        }
        control.unblock();
        return waiting && !control.isCancelled();
    }

    waitWith(Waiter waiter, WaitList list, long millis) {
        long deadline = -1;
        if (millis >= 0) {
            deadline = system.monotonicMillis() + millis;
        }
        list.add(waiter);
        this.leave();
        waiter.await(deadline);
        this.enter();
        list.remove(waiter);
    }

    destructor() {
        system.destroyLock(this.lock);
    }
}

// Whether a task threw and whether anything awaited it, which the scope reads when it ends, with
// where the task was started and what it threw.
shared final class FailureRecord {
    const Atomic<bool> failed;
    const Atomic<bool> awaited;
    const long[] startedAt;
    string thrown;

    protected constructor(this.startedAt) {
        this.failed = new Atomic<bool>(false);
        this.awaited = new Atomic<bool>(false);
        this.thrown = "";
    }

    protected fail(Error error) {
        this.thrown = "an error with the message '{error.message}'";
        this.failed.write(true);
    }

    protected unhandled() -> bool {
        return this.failed.read() && !this.awaited.read();
    }

    // Why the scope aborts the program for this task.
    protected refusal() -> string {
        string started = "a task this scope started";
        let site = startSite(this.startedAt);
        if (site != null) {
            started = "the task started at {site}";
        }
        return "{started} threw {this.thrown}, and nothing awaited it, so nothing handled the "
            + "error. Await every task started with 'start', or catch the error inside its body";
    }
}

final class Limits {
    // The most tasks an 'await' follows to find one that waits for the awaiting task.
    protected static const long awaitChain = 10000;
}

// Whether `thrown` is the 'Cancelled' of a task that was asked to stop, which did what it was
// asked.
stoppedAsAsked(Error thrown, TaskControl control) -> bool {
    return thrown is Cancelled && control.isCancelled();
}

// Runs the body of a task started with 'launch'.
runLaunched((shared () -> void throws Cancelled) body, TaskControl control) {
    try body();
} catch (Cancelled stop) {
    if (!control.isCancelled()) {
        string started = "a task started with 'launch'";
        let site = startSite(control.startedAt);
        if (site != null) {
            started = "the task started at {site}";
        }
        panic("{started} threw 'Cancelled' although nothing cancelled it, and nothing awaits a "
            + "task started with 'launch', so nothing would handle the error. Catch 'Cancelled' "
            + "inside its body");
    }
}

// The 'file:line' of the call that started a task, read off the trace captured when it started,
// or null when the trace does not reach it.
startSite(long[] startedAt) -> string? {
    let frames = system.traceFrames(startedAt);
    long caller = 0;
    while (caller < frames.length && !frames[caller].function.startsWith("TaskScope.")) {
        caller++;
    }
    while (caller < frames.length && frames[caller].function.startsWith("TaskScope.")) {
        caller++;
    }
    if (caller < frames.length) {
        return "{frames[caller].file}:{frames[caller].line}";
    }
    return null;
}

// Why tasks that wait for each other abort the program, naming where each was started.
cycleRefusal(List<TaskControl> chain) -> string {
    let sites = new List<string>();
    for (let control in chain) {
        sites.push(startSite(control.startedAt) ?? "a line the trace does not reach");
    }
    if (sites.length() == 2) {
        return "the task started at {sites.get(0)} waits for the task started at {sites.get(1)}, "
            + "which waits for it in turn, so neither can ever finish";
    }
    string listed = "";
    for (long i = 0; i < sites.length(); i++) {
        if (i > 0) {
            listed = listed + (i == sites.length() - 1 ? " and " : ", ");
        }
        listed = listed + sites.get(i);
    }
    return "the tasks started at {listed} each wait for the next, and the last for the first, so "
        + "none of them can ever finish";
}

// A value kept behind a reference, which a value of type 'void' keeps no storage in.
final class Kept<T> {
    const T value;

    protected constructor(this.value);
}

// What one task's body returned or threw, once it has finished.
shared final class TaskOutcome<T, E: Error> {
    const Monitor lock;
    const WaitList awaiters;
    const FailureRecord record;
    Kept<T>? result;
    E? failure;
    bool done;
    bool taken;

    protected constructor(this.record) {
        this.lock = new Monitor();
        this.awaiters = new WaitList();
        this.result = null;
        this.failure = null;
        this.done = false;
        this.taken = false;
    }

    // Runs `body` for the task `control` controls, and keeps what it returns or throws. A
    // 'Cancelled' the task throws after it was asked to stop is kept for an awaiter but is no
    // failure.
    protected complete((shared () -> T throws E) body, TaskControl control) {
        T value = try body();
        this.lock.enter();
        this.result = new Kept<T>(value);
        this.done = true;
        this.awaiters.wakeAll();
        this.lock.leave();
    } catch (E thrown) {
        this.lock.enter();
        this.failure = thrown;
        this.done = true;
        if (!stoppedAsAsked(thrown, control)) {
            this.record.fail(thrown);
        }
        this.awaiters.wakeAll();
        this.lock.leave();
    }

    protected threw() -> bool {
        return this.record.failed.read();
    }

    // Waits for the outcome and takes it. `waiting` is the task that awaits it, which stops
    // awaiting however the wait ends.
    protected take(TaskControl? waiting) -> T throws E, Cancelled {
        this.lock.enter();
        while (!this.done) {
            if (!this.lock.waitUnlessCancelled(this.awaiters, -1)) {
                this.lock.leave();
                waiting?.stopAwaiting();
                throw new Cancelled();
            }
        }
        waiting?.stopAwaiting();
        this.record.awaited.write(true);
        let thrown = this.failure;
        bool repeatable = thrown == null ? this.resultIsShareable() : this.failureIsShareable();
        if (this.taken && !repeatable) {
            this.lock.leave();
            panic("tried to await a task whose outcome another 'await' already took. A result or "
                + "an error that another task may not hold is taken once, so keep what the first "
                + "'await' gave");
        }
        this.taken = true;
        if (thrown != null) {
            this.lock.leave();
            throw thrown;
        }
        let kept = this.result;
        if (kept == null) {
            this.lock.leave();
            panic("Internal: a task finished with neither a result nor an error");
        }
        if (!repeatable) {
            this.result = null;
        }
        T value = kept.value;
        this.lock.leave();
        return value;
    }

    // Whether another task may hold a 'T'. The compiler answers this for each instance, so the body
    // below never runs.
    resultIsShareable() -> bool {
        return false;
    }

    // Whether another task may hold an 'E'. The compiler answers this for each instance, so the body
    // below never runs.
    failureIsShareable() -> bool {
        return false;
    }
}

// The tasks of one scope: those still running, the threads of its dedicated tasks, whether the
// scope was asked to stop, and whether it has ended.
shared final class ScopeState {
    const Monitor lock;
    const WaitList emptied;
    const TaskControl? owner;
    List<NativeThread> threads;
    List<FailureRecord> records;
    Map<long, TaskControl> running;
    long started;
    bool cancelled;
    bool ended;

    protected constructor(this.owner) {
        this.lock = new Monitor();
        this.emptied = new WaitList();
        this.threads = new List<NativeThread>();
        this.records = new List<FailureRecord>();
        this.running = new Map<long, TaskControl>();
        this.started = 0;
        this.cancelled = false;
        this.ended = false;
        let parent = this.owner;
        if (parent != null) {
            parent.adopt(this);
        }
    }

    protected record(long[] startedAt) -> FailureRecord {
        let created = new FailureRecord(startedAt);
        this.lock.enter();
        this.records.push(created);
        this.lock.leave();
        return created;
    }

    // Starts `work` for the task `control` controls on the pool.
    protected begin(TaskControl control, (shared () -> void) work) {
        long task = this.admit(control);
        control.body = () -> {
            work();
            this.finish(task);
            control.finished.write(true);
        };
        Pool.scheduler.makeRunnable(control);
    }

    // Starts `work` for the task `control` controls on a thread of its own at `priority`.
    protected beginDedicated(TaskControl control, int priority, (shared () -> void) work) {
        long task = this.admit(control);
        this.lock.enter();
        this.threads.push(system.startThread(() -> {
            system.raiseThreadPriority(priority);
            Registry.dedicated.enter(control);
            work();
            Registry.dedicated.leave(control);
            this.finish(task);
        }));
        this.lock.leave();
    }

    // Counts a task in, and panics when the scope has ended.
    admit(TaskControl control) -> long {
        this.lock.enter();
        if (this.ended) {
            this.lock.leave();
            panic("tried to start a task in a scope that has ended. Start it while the scope's body "
                + "runs, or in a scope that is still open");
        }
        long task = this.started;
        this.started++;
        this.running.set(task, control);
        this.lock.leave();
        return task;
    }

    finish(long task) {
        this.lock.enter();
        let removed = this.running.remove(task);
        if (this.running.isEmpty()) {
            this.emptied.wakeAll();
        }
        this.lock.leave();
    }

    protected cancel() {
        this.lock.enter();
        this.cancelled = true;
        this.lock.leave();
        this.wakeTasks();
    }

    // Wakes every task of the scope from the wait it is in.
    protected wakeTasks() {
        let controls = new List<TaskControl>();
        this.lock.enter();
        controls.pushAll(this.running.values());
        this.lock.leave();
        for (let control in controls) {
            control.wake();
        }
    }

    protected isCancelled() -> bool {
        this.lock.enter();
        bool asked = this.cancelled;
        this.lock.leave();
        let started = this.owner;
        return asked || (started != null && started.isCancelled());
    }

    // Sets a timer that cancels the scope at the deadline, unless the scope has ended by then.
    protected cancelAfter(long millis) {
        long deadline = system.monotonicMillis() + millis;
        this.lock.enter();
        if (this.ended) {
            this.lock.leave();
            panic("tried to set a deadline on a scope that has ended. Call 'cancelAfter' while the "
                + "scope's body runs");
        }
        this.lock.leave();
        Clockwork.events.runAt(deadline, () -> this.cancelIfOpen());
    }

    cancelIfOpen() {
        this.lock.enter();
        bool open = !this.ended;
        this.lock.leave();
        if (open) {
            this.cancel();
        }
    }

    // Waits for every task the scope started, including any they start meanwhile, then ends the
    // scope. When `reporting` is set, a task that threw and that nothing awaited aborts the program
    // here.
    protected end(bool reporting) {
        this.lock.enter();
        while (!this.running.isEmpty()) {
            this.lock.wait(this.emptied, -1);
        }
        this.ended = true;
        let threads = this.threads;
        this.threads = new List<NativeThread>();
        let finished = this.records;
        this.records = new List<FailureRecord>();
        this.lock.leave();
        for (let thread in threads) {
            system.joinThread(thread);
        }
        let parent = this.owner;
        if (parent != null) {
            parent.disown(this);
        }
        if (reporting) {
            for (let record in finished) {
                if (record.unhandled()) {
                    panic(record.refusal());
                }
            }
        }
    }
}
