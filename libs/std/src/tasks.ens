// What tasks share and change in turn. Every member of these classes is synchronized inside, so a
// value of one may be held by any number of tasks at once.

// One value that tasks read and replace without a lock. The compiler lowers 'read', 'write' and
// 'compareAndSet' to the processor's atomic instructions, so the bodies below are never emitted. A
// reference is compared by identity, the way the processor compares one.
export shared final class Atomic<shared T> {
    T value;

    export constructor(this.value);

    // The value as it is now.
    export read() -> T {
        return this.value;
    }

    // Replaces the value, so every later read returns `value`.
    export write(T value) {
        this.value = value;
    }

    // Replaces the value with `replacement` when it is still `expected`, and reports whether it did.
    export compareAndSet(T expected, T replacement) -> bool {
        panic("Internal: 'compareAndSet' is lowered to an atomic instruction");
    }

    // Adds `amount` to the value and returns the sum.
    export add<T: Number<T>>(T amount) -> T {
        while (true) {
            T current = this.read();
            T next = current.plus(amount);
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }

    // Adds one to the value and returns the result.
    export increment<T: Number<T>>() -> T {
        while (true) {
            T current = this.read();
            T next = current.incremented();
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }

    // Takes one from the value and returns the result.
    export decrement<T: Number<T>>() -> T {
        while (true) {
            T current = this.read();
            T next = current.decremented();
            if (this.compareAndSet(current, next)) {
                return next;
            }
        }
    }
}
