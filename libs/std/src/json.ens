// JSON values: a `Json` tree read from text with `Json.parse` and written back with `toString`.
import Entry from @std.collections.entry;
import Iterable from @std.collections.iterator;
import Iterator from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import @std.json.reader;
import @std.json.writer;
import @std.text.parse;

// Text that is not JSON. `offset`, `line` and `column` locate the problem, and the message says
// what was found there and what JSON allows in its place.
export class JsonError extends Error {
    // Byte offset from the start of the text.
    export const long offset;

    // 1-based; a line ends at a '\n'.
    export const long line;

    // 1-based, in bytes from the start of the line.
    export const long column;

    export constructor(string message, this.offset, this.line, this.column) {
        super(message);
    }
}

// A JSON value: null, a boolean, a number, a string, an array or an object. Two values are equal
// when they have the same kind and content, ignoring an object's key order.
export sealed abstract class Json {
    protected constructor();

    // Parses exactly one JSON value (RFC 8259), with whitespace allowed around it and a byte order
    // mark allowed in front. A key written twice in one object is an error unless
    // `allowDuplicateKeys` is set, in which case the last value wins.
    export static parse(string text, bool allowDuplicateKeys = false) -> Json throws JsonError {
        return try reader.parse(text, allowDuplicateKeys);
    }

    export isNull() -> bool {
        return false;
    }

    // The boolean, or null when this is not one.
    export asBool() -> bool? {
        return null;
    }

    // The number as a long, or null when this is not a number, has a fraction or an exponent, or
    // does not fit a long.
    export asLong() -> long? {
        return null;
    }

    // The number as the nearest double, or null when this is not a number or is out of a double's
    // range.
    export asDouble() -> double? {
        return null;
    }

    // The string, or null when this is not one.
    export asString() -> string? {
        return null;
    }

    // This as an array, or null when it is not one.
    export asArray() -> JsonArray? {
        return null;
    }

    // This as an object, or null when it is not one.
    export asObject() -> JsonObject? {
        return null;
    }

    // One-line JSON text in the form a struct prints as: ", " between items and ": " after a key.
    export override toString() -> string {
        return writer.compact(this);
    }

    // Multi-line JSON text: one item per line, each nesting level indented by one more `indent`,
    // and an empty array or object as "[]" or "{}".
    export toString(string indent) -> string {
        return writer.indented(this, indent);
    }

    export override equals(Json other) -> bool {
        return switch (this) {
            is JsonNull -> other is JsonNull,
            is JsonBool flag -> other is JsonBool && other.value == flag.value,
            is JsonNumber number -> other is JsonNumber && other.text == number.text,
            is JsonString text -> other is JsonString && other.value == text.value,
            is JsonArray array -> other is JsonArray && array.sameElements(other),
            is JsonObject object -> other is JsonObject && object.sameMembers(other),
        };
    }

    export override hash() -> long {
        return switch (this) {
            is JsonNull -> 7,
            is JsonBool flag -> flag.value.hash(),
            is JsonNumber number -> number.text.hash(),
            is JsonString text -> text.value.hash(),
            is JsonArray array -> array.elementsHash(),
            is JsonObject object -> object.membersHash(),
        };
    }
}

export final class JsonNull extends Json {
    export constructor();

    export override isNull() -> bool {
        return true;
    }
}

export final class JsonBool extends Json {
    export const bool value;

    export constructor(this.value);

    export override asBool() -> bool? {
        return this.value;
    }
}

// A number, kept as its JSON text, so reading and writing it changes nothing and a number too
// large for any numeric type passes through.
export final class JsonNumber extends Json {
    export const string text;

    public constructor(this.text);

    export static of(long value) -> JsonNumber {
        return new JsonNumber(value.toString());
    }

    // Written the way the value prints. Aborts on a NaN or an infinity, which have no JSON form.
    export static of(double value) -> JsonNumber {
        if (value.isNaN()) {
            panic("tried to make a JSON number from a NaN, the value a calculation such as "
                + "0.0 / 0.0 produces, and JSON has no spelling for it. Check isNaN() first");
        }
        if (value.isInfinite()) {
            panic("tried to make a JSON number from an infinity, and JSON has no spelling for "
                + "it. Check isFinite() first");
        }
        return new JsonNumber(value.toString());
    }

    export override asLong() -> long? {
        return parse.parseLong(this.text);
    }

    export override asDouble() -> double? {
        return parse.parseDouble(this.text);
    }
}

export final class JsonString extends Json {
    export const string value;

    export constructor(this.value);

    export override asString() -> string? {
        return this.value;
    }
}

export final class JsonArray extends Json implements Iterable<Json> {
    const List<Json> elements;

    export constructor() {
        this.elements = new List<Json>();
    }

    export static of(Json[] values) -> JsonArray {
        let array = new JsonArray();
        for (let value in values) {
            array.push(value);
        }
        return array;
    }

    export override asArray() -> JsonArray? {
        return this;
    }

    export length() -> long {
        return this.elements.length();
    }

    export isEmpty() -> bool {
        return this.elements.isEmpty();
    }

    // Aborts when `index` is out of range.
    export get(long index) -> Json {
        return this.elements.get(index);
    }

    export set(long index, Json value) {
        this.elements.set(index, value);
    }

    export push(Json value) {
        this.elements.push(value);
    }

    export removeAt(long index) -> Json {
        return this.elements.removeAt(index);
    }

    export clear() {
        this.elements.clear();
    }

    export override makeIterator() -> Iterator<Json> {
        return this.elements.makeIterator();
    }

    protected sameElements(JsonArray other) -> bool {
        if (this.elements.length() != other.elements.length()) {
            return false;
        }
        for (long i = 0; i < this.elements.length(); i++) {
            if (this.elements.get(i) != other.elements.get(i)) {
                return false;
            }
        }
        return true;
    }

    protected elementsHash() -> long {
        long combined = 3;
        for (let element in this.elements) {
            combined = combined * 31 + element.hash();
        }
        return combined;
    }
}

// Members by key, in insertion order, which is also the order they are written and walked in.
// Setting a key that is already there replaces its value and keeps its position.
export final class JsonObject extends Json implements Iterable<Entry<string, Json>> {
    const List<string> order;
    const Map<string, Json> members;

    export constructor() {
        this.order = new List<string>();
        this.members = new Map<string, Json>();
    }

    export override asObject() -> JsonObject? {
        return this;
    }

    export length() -> long {
        return this.order.length();
    }

    export isEmpty() -> bool {
        return this.order.isEmpty();
    }

    export contains(string key) -> bool {
        return this.members.contains(key);
    }

    // The value under `key`, or null when there is none.
    export get(string key) -> Json? {
        return this.members.get(key);
    }

    export set(string key, Json value) {
        if (!this.members.contains(key)) {
            this.order.push(key);
        }
        this.members.set(key, value);
    }

    // Returns whether a member was removed.
    export remove(string key) -> bool {
        if (!this.members.remove(key)) {
            return false;
        }
        this.order.remove(key);
        return true;
    }

    // The keys in insertion order, as a copy.
    export keys() -> Iterable<string> {
        return this.order.copy();
    }

    export override makeIterator() -> Iterator<Entry<string, Json>> {
        return new MemberIterator(this.order.makeIterator(), this.members);
    }

    protected sameMembers(JsonObject other) -> bool {
        if (this.order.length() != other.order.length()) {
            return false;
        }
        for (let key in this.order) {
            let mine = this.members.get(key);
            let theirs = other.members.get(key);
            if (mine == null || theirs == null || mine != theirs) {
                return false;
            }
        }
        return true;
    }

    // Order-independent, like equality.
    protected membersHash() -> long {
        long combined = 5;
        for (let key in this.order) {
            let value = this.members.get(key);
            if (value != null) {
                combined = combined + key.hash() * 31 + value.hash();
            }
        }
        return combined;
    }
}

final class MemberIterator implements Iterator<Entry<string, Json>> {
    Iterator<string> keys;
    Map<string, Json> members;

    protected constructor(this.keys, this.members);

    protected override next() -> Entry<string, Json>? {
        let key = this.keys.next();
        if (key == null) {
            return null;
        }
        let value = this.members.get(key);
        if (value == null) {
            return null;
        }
        Entry<string, Json> member = {key: key, value: value};
        return member;
    }
}
