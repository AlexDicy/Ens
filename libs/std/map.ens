import Hashable from @std.hash;
import Iterable from @std.iterator;
import Iterator from @std.iterator;
import Pair from @std.pair;

// A hash table with open addressing and linear probing. Slot states are
// 0 = empty, 1 = occupied, 2 = removed; removed slots are reused on insert
// and cleared by resize. Keys compare with '==' and hash with hash().
public class Map<K: Hashable, V> implements Iterable<Pair<K, V>> {
    private K[] slotKeys;
    private V[] slotValues;
    private byte[] slotStates;
    private long count;
    private long capacity;

    Map() {
        this.capacity = 16;
        this.slotKeys = new K[this.capacity];
        this.slotValues = new V[this.capacity];
        this.slotStates = new byte[this.capacity];
        this.count = 0;
    }

    set(K key, V value) {
        long existing = this.findSlot(key);
        if (existing >= 0) {
            this.slotValues[existing] = value;
            return;
        }
        if ((this.count + 1) * 4 > this.capacity * 3) {
            this.resize();
        }
        long slot = this.freeSlot(key);
        this.slotKeys[slot] = key;
        this.slotValues[slot] = value;
        this.slotStates[slot] = 1;
        this.count = this.count + 1;
    }

    get(K key) -> V? {
        long slot = this.findSlot(key);
        if (slot < 0) {
            return null;
        }
        return this.slotValues[slot];
    }

    contains(K key) -> bool {
        return this.findSlot(key) >= 0;
    }

    remove(K key) -> bool {
        long slot = this.findSlot(key);
        if (slot < 0) {
            return false;
        }
        this.slotStates[slot] = 2;
        this.count = this.count - 1;
        return true;
    }

    length() -> long {
        return this.count;
    }

    keys() -> K[] {
        K[] result = new K[this.count];
        long written = 0;
        long slot = 0;
        while (slot < this.capacity) {
            if (this.slotStates[slot] == 1) {
                result[written] = this.slotKeys[slot];
                written = written + 1;
            }
            slot = slot + 1;
        }
        return result;
    }

    values() -> V[] {
        V[] result = new V[this.count];
        long written = 0;
        long slot = 0;
        while (slot < this.capacity) {
            if (this.slotStates[slot] == 1) {
                result[written] = this.slotValues[slot];
                written = written + 1;
            }
            slot = slot + 1;
        }
        return result;
    }

    makeIterator() -> Iterator<Pair<K, V>> {
        return new MapIterator<K, V>(this.slotKeys, this.slotValues, this.slotStates, this.capacity);
    }

    // First occupied slot holding this key, or -1. Removed slots are probed
    // through; an empty slot ends the chain.
    private findSlot(K key) -> long {
        long slot = key.hash() & (this.capacity - 1);
        long probed = 0;
        while (probed < this.capacity) {
            if (this.slotStates[slot] == 0) {
                return -1;
            }
            if (this.slotStates[slot] == 1 && this.slotKeys[slot] == key) {
                return slot;
            }
            slot = (slot + 1) & (this.capacity - 1);
            probed = probed + 1;
        }
        return -1;
    }

    // First insertable slot (empty or removed) on the key's probe chain. The
    // caller has already ruled out an occupied slot holding this key.
    private freeSlot(K key) -> long {
        long slot = key.hash() & (this.capacity - 1);
        while (this.slotStates[slot] == 1) {
            slot = (slot + 1) & (this.capacity - 1);
        }
        return slot;
    }

    private resize() {
        long oldCapacity = this.capacity;
        K[] oldKeys = this.slotKeys;
        V[] oldValues = this.slotValues;
        byte[] oldStates = this.slotStates;

        this.capacity = this.capacity * 2;
        this.slotKeys = new K[this.capacity];
        this.slotValues = new V[this.capacity];
        this.slotStates = new byte[this.capacity];

        long slot = 0;
        while (slot < oldCapacity) {
            if (oldStates[slot] == 1) {
                long target = oldKeys[slot].hash() & (this.capacity - 1);
                while (this.slotStates[target] == 1) {
                    target = (target + 1) & (this.capacity - 1);
                }
                this.slotKeys[target] = oldKeys[slot];
                this.slotValues[target] = oldValues[slot];
                this.slotStates[target] = 1;
            }
            slot = slot + 1;
        }
    }
}

class MapIterator<K, V> implements Iterator<Pair<K, V>> {
    private K[] slotKeys;
    private V[] slotValues;
    private byte[] slotStates;
    private long capacity;
    private long position;

    MapIterator(this.slotKeys, this.slotValues, this.slotStates, this.capacity) {
        this.position = 0;
        this.skipToOccupied();
    }

    hasNext() -> bool {
        return this.position < this.capacity;
    }

    next() -> Pair<K, V> {
        Pair<K, V> entry;
        entry.key = this.slotKeys[this.position];
        entry.value = this.slotValues[this.position];
        this.position = this.position + 1;
        this.skipToOccupied();
        return entry;
    }

    private skipToOccupied() {
        while (this.position < this.capacity && this.slotStates[this.position] != 1) {
            this.position = this.position + 1;
        }
    }
}
