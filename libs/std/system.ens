external type CFile;

external from "c" {
    fopen(string path, string mode) -> CFile?;
    fread(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    fwrite(byte[] buffer, ulong size, ulong count, CFile stream) -> ulong;
    ferror(CFile stream) -> int;
    fclose(CFile stream) -> int;
    getenv(string name) -> string?;
    system(string command) -> int;
    exit(int code);
    ens_arguments() -> string[];
}

public class SystemError extends Error {
    SystemError(string m) { super(m); }
}

public class File {
    private CFile handle;

    File(this.handle);

    read(byte[] buffer) -> ulong throws {
        let count = fread(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file read failed");
        }
        return count;
    }

    write(byte[] buffer) -> ulong throws {
        let count = fwrite(buffer, 1, buffer.length as ulong, this.handle);
        if (ferror(this.handle) != 0) {
            throw new SystemError("file write failed");
        }
        return count;
    }

    close() -> int {
        return fclose(this.handle);
    }
}

public openFile(string path, string mode) -> File throws {
    CFile? handle = fopen(path, mode);
    if (handle == null) {
        throw new SystemError("could not open file");
    }
    return new File(handle);
}

public run(string command) -> int throws {
    let status = system(command);
    if (status == -1) {
        throw new SystemError("could not run command");
    }
    return status;
}

public getEnvironmentVariable(string name) -> string? {
    return getenv(name);
}

public arguments() -> string[] {
    return ens_arguments();
}