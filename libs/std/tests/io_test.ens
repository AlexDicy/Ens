// Tests for the standard streams. Everything about them that needs a real process lives in the
// fixtures; what is left is the one shared reader and that the writers accept bytes.
import @std.testing;
import @std.io;
import BufferedReader from @std.io.buffered;

// A second call site, so the shared reader is not one expression compared with itself.
sharedReader() -> BufferedReader {
    return io.in();
}

test "in answers the same reader every call, whichever call site asks" {
    try testing.assertTrue(io.in() == io.in(), "two calls answer one reader");
    try testing.assertTrue(io.in() == sharedReader(), "another call site answers the same one");
}

test "out and err answer writers that take bytes, and flushing reports success" {
    try io.out().write(new byte[0]);
    try io.err().write(new byte[0]);
    try io.flush();
}
