// Tests for the failure every stream raises and for the one call that joins a source to a
// destination.
import @std.testing;
import @std.io.streams;
import BytesReader from @std.io.memory;
import BytesWriter from @std.io.memory;
import ErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import io.support;
import ChunkedReader from io.support;
import FailingReader from io.support;
import FailingWriter from io.support;

// `count` bytes whose value follows their offset, so a copy that dropped or reordered part of them
// shows up in the comparison.
counted(long count) -> byte[] {
    byte[] raw = new byte[count];
    for (long i = 0; i < count; i++) {
        raw[i] = (i % 251) as byte;
    }
    return raw;
}

test "an IoError names what failed, the condition, and the error it followed" {
    let cause = new IoError("the pipe is gone", ErrorKind.Closed);
    let failure = new IoError("could not write the report", ErrorKind.Other, cause);
    try testing.assertEqual(failure.message, "could not write the report");
    try testing.assertEqual(failure.kind, ErrorKind.Other);
    try testing.assertEqual(failure.toString(),
        "could not write the report\ncaused by IoError: the pipe is gone");
}

test "copy moves everything the source has left and answers how many bytes moved" {
    let source = new BytesReader("all of it".toBytes());
    let target = new BytesWriter();
    try testing.assertEqual(try streams.copy(source, target), 9);
    try testing.assertEqual(support.collectedText(target), "all of it");
}

test "copy keeps asking after a read shorter than the buffer it offered" {
    let source = new ChunkedReader("one byte at a time".toBytes(), 1);
    let target = new BytesWriter();
    try testing.assertEqual(try streams.copy(source, target), 18);
    try testing.assertEqual(support.collectedText(target), "one byte at a time");
}

test "copy moves a source longer than the chunk it works through" {
    byte[] raw = counted(20000);
    let target = new BytesWriter();
    try testing.assertEqual(try streams.copy(new BytesReader(raw), target), 20000);
    try testing.assertEqual(target.toBytes(), raw);
}

test "copy over an empty source answers 0 and writes nothing" {
    let target = new BytesWriter();
    try testing.assertEqual(try streams.copy(new BytesReader(new byte[0]), target), 0);
    try testing.assertEqual(target.length(), 0);
}

test "a source that fails stops the copy and hands its condition on" {
    let target = new BytesWriter();
    let failure = try testing.assertThrows<IoError>(() -> {
        try streams.copy(new FailingReader(ErrorKind.Interrupted), target);
    });
    try testing.assertEqual(failure.kind, ErrorKind.Interrupted);
    try testing.assertEqual(failure.message, "the test source refuses to be read");
    try testing.assertEqual(target.length(), 0);
}

test "a destination that fails stops the copy on its first offer" {
    let target = new FailingWriter(ErrorKind.Closed);
    let failure = try testing.assertThrows<IoError>(() -> {
        try streams.copy(new BytesReader("some bytes".toBytes()), target);
    });
    try testing.assertEqual(failure.kind, ErrorKind.Closed);
    try testing.assertEqual(target.offers, 1);
}
