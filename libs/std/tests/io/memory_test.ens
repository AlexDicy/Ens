// Tests for the two streams over bytes already in memory: what a reader hands out, and what a
// writer collects.
import @std.testing;
import BytesReader from @std.io.memory;
import BytesWriter from @std.io.memory;
import io.support;

test "a reader hands out its bytes in order, a bufferful at a time" {
    let reader = new BytesReader("abcdef".toBytes());
    byte[] buffer = new byte[4];
    try testing.assertEqual(reader.read(buffer), 4);
    try testing.assertEqual(string.fromBytes(buffer), "abcd");
    try testing.assertEqual(reader.read(buffer), 2);
    try testing.assertEqual(string.fromBytes(buffer.slice(0, 2)), "ef");
}

test "a reader answers 0 once every byte has been handed out, and keeps answering it" {
    let reader = new BytesReader("ab".toBytes());
    byte[] buffer = new byte[8];
    try testing.assertEqual(reader.read(buffer), 2);
    try testing.assertEqual(reader.read(buffer), 0);
    try testing.assertEqual(reader.read(buffer), 0);
}

test "a reader over no bytes at all answers 0 straight away" {
    let reader = new BytesReader(new byte[0]);
    try testing.assertEqual(reader.read(new byte[4]), 0);
}

test "a reader shares the array it was given rather than copying it" {
    byte[] source = "ab".toBytes();
    let reader = new BytesReader(source);
    source[1] = 'c';
    byte[] buffer = new byte[2];
    try testing.assertEqual(reader.read(buffer), 2);
    try testing.assertEqual(string.fromBytes(buffer), "ac");
}

test "a writer joins what it was written in the order it arrived" {
    let target = new BytesWriter();
    target.write("first ".toBytes());
    target.write("second".toBytes());
    try testing.assertEqual(target.length(), 12);
    try testing.assertEqual(support.collectedText(target), "first second");
}

test "a writer grows past the store it started with" {
    let target = new BytesWriter();
    for (long i = 0; i < 500; i++) {
        target.write("0123456789".toBytes());
    }
    try testing.assertEqual(target.length(), 5000);
    try testing.assertEqual(string.fromBytes(target.toBytes().slice(4990, 5000)), "0123456789");
}

test "the bytes a writer answers are a copy, so writing more leaves them alone" {
    let target = new BytesWriter();
    target.write("kept".toBytes());
    byte[] taken = target.toBytes();
    target.write(" and more".toBytes());
    try testing.assertEqual(string.fromBytes(taken), "kept");
    try testing.assertEqual(support.collectedText(target), "kept and more");
}

test "clear forgets everything written and leaves the writer usable" {
    let target = new BytesWriter();
    target.write("gone".toBytes());
    target.clear();
    try testing.assertEqual(target.length(), 0);
    target.write("here".toBytes());
    try testing.assertEqual(support.collectedText(target), "here");
}

test "writing nothing changes nothing, and a flush has nothing to do" {
    let target = new BytesWriter();
    target.write("kept".toBytes());
    target.write(new byte[0]);
    target.flush();
    try testing.assertEqual(support.collectedText(target), "kept");
}
