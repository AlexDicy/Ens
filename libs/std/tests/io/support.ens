// What the io tests share: a source handing out a few bytes at a time, the two ends that fail, a
// destination counting how it was called, and one way of reading a memory writer back.
import BytesWriter from @std.io.memory;
import ErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import Reader from @std.io.streams;
import Writer from @std.io.streams;

// Hands out at most `limit` bytes per read however much room the caller offers, the way a pipe
// does when the far end writes more slowly than this end reads.
public final class ChunkedReader implements Reader {
    const byte[] source;
    const long limit;
    long position;

    public constructor(this.source, this.limit) {
        this.position = 0;
    }

    public override read(byte[] buffer) -> long {
        long count = this.source.length - this.position;
        if (count > this.limit) {
            count = this.limit;
        }
        if (count > buffer.length) {
            count = buffer.length;
        }
        for (long i = 0; i < count; i++) {
            buffer[i] = this.source[this.position + i];
        }
        this.position = this.position + count;
        return count;
    }
}

// Fails every read, so what a caller does with a source that has gone away is what the test sees.
public final class FailingReader implements Reader {
    const ErrorKind kind;

    public constructor(this.kind);

    public override read(byte[] buffer) -> long throws IoError {
        throw new IoError("the test source refuses to be read", this.kind);
    }
}

// Fails every write and every flush, counting the writes it was offered so a test can see that a
// wrapper did not offer the same bytes twice.
public final class FailingWriter implements Writer {
    const ErrorKind kind;
    public long offers;

    public constructor(this.kind) {
        this.offers = 0;
    }

    public override write(byte[] data) throws IoError {
        this.offers = this.offers + 1;
        throw new IoError("the test destination refuses {data.length} bytes", this.kind);
    }

    public override flush() throws IoError {
        throw new IoError("the test destination refuses to be flushed", this.kind);
    }
}

// Accepts everything and remembers how it was called: the bytes it was handed, how many writes made
// them up, and how many flushes were asked for.
public final class CountingWriter implements Writer {
    const BytesWriter collected;
    public long writes;
    public long flushes;

    public constructor() {
        this.collected = new BytesWriter();
        this.writes = 0;
        this.flushes = 0;
    }

    public override write(byte[] data) {
        this.collected.write(data);
        this.writes = this.writes + 1;
    }

    public override flush() {
        this.flushes = this.flushes + 1;
    }

    // Everything written so far, read back as text.
    public text() -> string {
        return string.fromBytes(this.collected.toBytes());
    }

    public length() -> long {
        return this.collected.length();
    }
}

// Everything a memory writer has collected, read back as text.
public collectedText(BytesWriter target) -> string {
    return string.fromBytes(target.toBytes());
}
