// Tests for writing text onto a byte stream: which bytes come out, and how many writes carry
// them.
import @std.testing;
import ErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import TextWriter from @std.io.text;
import CountingWriter from io.support;
import FailingWriter from io.support;

// A writer written to and then dropped without a flush, so only its destructor can flush the
// target.
dropAfterWriting(CountingWriter target, string text) throws IoError {
    let writer = new TextWriter(target);
    try writer.write(text);
}

test "write puts the text's UTF-8 bytes on the target in one write" {
    let target = new CountingWriter();
    let writer = new TextWriter(target);
    try writer.write("héllo");
    try testing.assertEqual(target.text(), "héllo");
    try testing.assertEqual(target.length(), 6);
    try testing.assertEqual(target.writes, 1);
}

test "writeLine adds a newline, and adds no carriage return before it" {
    let target = new CountingWriter();
    let writer = new TextWriter(target);
    try writer.writeLine("line");
    try testing.assertEqual(target.text(), "line\n");
    try testing.assertEqual(target.writes, 1);
}

test "writeLine on its own writes one newline" {
    let target = new CountingWriter();
    let writer = new TextWriter(target);
    try writer.writeLine();
    try writer.writeLine();
    try testing.assertEqual(target.text(), "\n\n");
}

test "flush goes through to the target" {
    let target = new CountingWriter();
    let writer = new TextWriter(target);
    try writer.write("text");
    try writer.flush();
    try testing.assertEqual(target.flushes, 1);
}

test "dropping the writer flushes the target" {
    let target = new CountingWriter();
    try dropAfterWriting(target, "written and dropped");
    try testing.assertEqual(target.text(), "written and dropped");
    try testing.assertEqual(target.flushes, 1);
}

test "a target that refuses the bytes is reported with its condition" {
    let writer = new TextWriter(new FailingWriter(ErrorKind.Closed));
    let failure = try testing.assertThrows<IoError>(() -> {
        try writer.writeLine("doomed");
    });
    try testing.assertEqual(failure.kind, ErrorKind.Closed);
    try testing.assertEqual(failure.message, "the test destination refuses 7 bytes");
}
