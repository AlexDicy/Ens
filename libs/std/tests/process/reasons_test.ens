// Tests for the reasons a failed start is given: the program a script's first line names, which
// decides two of them, the cases a caller words itself, as a bare name no PATH directory holds, and
// the part and kind each number the bridges give names.
import @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import Platform from @std.platform;
import NumberKind from @std.process.reasons;
import StartPart from @std.process.reasons;
import @std.process.reasons;

test "the program a script's first line names is read up to its arguments" {
    let scratch = try TemporaryDirectory.create("ens-std-process-first-line");
    Path folder = scratch.path();
    try folder.join("spaced").writeText("#!  /usr/bin/env python3\n");
    try folder.join("crlf").writeText("#!/bin/sh\r\nexit 0\r\n");
    try folder.join("bare").writeText("#!\n");
    try folder.join("plain").writeText("echo no first line\n");
    try folder.join("long").writeText("#!/{"no-such-directory/".repeat(16)}interpreter\n");
    try assertLine(folder.join("spaced"), Platform.Linux, "/usr/bin/env", 0);
    try assertLine(folder.join("crlf"), Platform.Linux, "/bin/sh", 0);
    try assertLine(folder.join("bare"), Platform.Linux, "", 0);
    try assertLine(folder.join("plain"), Platform.Linux, "", 0);
    try assertLine(folder.join("missing"), Platform.Linux, "", 0);
    try assertLine(folder.join("long"), Platform.Linux, "", 256);
    try assertLine(folder.join("long"), Platform.MacOS,
        "/{"no-such-directory/".repeat(16)}interpreter", 0);
}

// Fails unless the first line of the script at `path`, as the system `platform` names reads it,
// names `program` and runs past `longerThan` bytes.
assertLine(Path path, Platform platform, string program, long longerThan) throws {
    let line = reasons.firstLineOf(path.toString(), platform);
    try testing.assertEqual(line.program, program);
    try testing.assertEqual(line.longerThan, longerThan);
}

test "a bare name no PATH directory holds is given a reason of its own" {
    try testing.assertEqual(reasons.notOnPathReason(), "no directory that the PATH environment "
        + "variable lists contains a program of that name. Check the name, or give the "
        + "program's full path");
}

// The bridges number the part of a start in the bits above the system's number, and a number no
// part has is read as no part at all.
test "a code's part is the one the bridges number it with" {
    StartPart[] parts = [StartPart.Unplaced, StartPart.Program, StartPart.WorkingDirectory,
        StartPart.Directory, StartPart.NotRunnable, StartPart.NotProgram, StartPart.SpecialFile,
        StartPart.WorkingDirectoryFile, StartPart.MissingInterpreter, StartPart.NoProgramStart,
        StartPart.RefusedOnPath, StartPart.RefusedScript];
    for (int number = 0; number < parts.length; number++) {
        try testing.assertEqual(reasons.startPartOf((number << 24) | 13), parts[number]);
    }
    try testing.assertEqual(reasons.startPartOf(12 << 24), StartPart.Unplaced);
    try testing.assertEqual(reasons.startPartOf(255 << 24), StartPart.Unplaced);
}

test "an error number's kind is the one the bridge's ordinal names" {
    try testing.assertEqual(reasons.numberKindFrom(0), NumberKind.NotFound);
    try testing.assertEqual(reasons.numberKindFrom(1), NumberKind.PermissionDenied);
    try testing.assertEqual(reasons.numberKindFrom(2), NumberKind.Other);
    try testing.assertEqual(reasons.numberKindFrom(3), NumberKind.Other);
    try testing.assertEqual(reasons.numberKindFrom(-1), NumberKind.Other);
}
