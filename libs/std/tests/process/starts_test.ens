import @std.testing;
import @std.tasks;
import Atomic from @std.tasks;
import Cancelled from @std.tasks;
import ChildStarts from @std.process.starts;
import NativeChild from @std.system;

test "settling waits until every child being made has been made" {
    let making = new Atomic<bool>(false);
    let release = new Atomic<bool>(false);
    let made = new Atomic<bool>(false);
    let madeBeforeSettled = new Atomic<bool>(false);
    try tasks.scope((scope) -> {
        scope.launch(() -> {
            let child = ChildStarts.make(() -> pretendStart(making, release, made));
        });
        while (!making.read()) {
            try tasks.sleep(1);
        }
        scope.launch(() -> {
            ChildStarts.settle();
            madeBeforeSettled.write(made.read());
        });
        try tasks.sleep(10);
        release.write(true);
    });
    try testing.assertTrue(madeBeforeSettled.read(),
        "settling returned while a child was being made");
}

// A start that reports that it began, and once it is released, that it made its child.
pretendStart(Atomic<bool> making, Atomic<bool> release, Atomic<bool> made) -> NativeChild {
    making.write(true);
    while (!release.read()) {
        let slept = trySleep();
    }
    made.write(true);
    return {child: null, code: 0};
}

trySleep() -> bool {
    try tasks.sleep(1);
    return true;
} catch (Cancelled stopped) {
    return false;
}
