// Tests for the shapes a child's start hands the operating system: the blocks, the merge of an
// inherited environment with a caller's overrides, and the quoting of a Win32 command line. A rule
// that differs per system is given the system rather than reading it from the machine, so every
// system's rule is checked whatever system runs these tests.
import @std.testing;
import @std.process.blocks;

// The merged variables as one line, so an assertion shows the environment a child would receive.
shown(string[] variables) -> string {
    return string.joined(variables, " ");
}

test "an override replaces the inherited entry naming the same variable" {
    string[] merged = blocks.mergedEnvironment(["HOME=/h", "PATH=/a"], ["PATH=/b"], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b");
}

test "an override naming nothing inherited joins the environment" {
    string[] merged = blocks.mergedEnvironment(["HOME=/h"], ["ENS_TOOLCHAIN=local"], "linux");
    try testing.assertEqual(shown(merged), "ENS_TOOLCHAIN=local HOME=/h");
}

test "no overrides leave the inherited environment as it was" {
    string[] merged = blocks.mergedEnvironment(["PATH=/a", "HOME=/h"], [], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/a");
}

test "on windows an override reaches an inherited name spelled in another case" {
    string[] merged = blocks.mergedEnvironment(["Path=/a", "HOME=/h"], ["PATH=/b"], "windows");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b");
}

test "on linux a name differing only in case is a second variable and both survive" {
    string[] merged = blocks.mergedEnvironment(["path=/a", "HOME=/h"], ["PATH=/b"], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b path=/a");
}

test "on macos names match exactly, the way they do on linux" {
    string[] merged = blocks.mergedEnvironment(["path=/a"], ["PATH=/b"], "macos");
    try testing.assertEqual(shown(merged), "PATH=/b path=/a");
}

test "an entry's name is what precedes its first '='" {
    try testing.assertEqual(blocks.nameOf("PATH=/a=b"), "PATH");
    try testing.assertEqual(blocks.nameOf("BARE"), "BARE");
}

test "an environment block ends every entry and closes with one more terminator" {
    byte[] block = blocks.environmentBlock(["A=1", "B=2"]);
    try testing.assertTrue(block.length == 9,
        "the block is {block.length} bytes, expected 9 for 'A=1' and 'B=2'");
    try testing.assertTrue(block[3] == 0 && block[7] == 0 && block[8] == 0,
        "the entries and the block itself must each end in a terminator");
}

test "no variables give an empty block, which a spawn treats as inherit unchanged" {
    try testing.assertTrue(blocks.environmentBlock([]).length == 0,
        "an empty environment must give an empty block");
}

test "a given environment block closes with an empty entry, even with no variables" {
    byte[] none = [0, 0];
    byte[] single = [65, 61, 49, 0, 0];
    try testing.assertEqual(blocks.givenEnvironmentBlock([]), none);
    try testing.assertEqual(blocks.givenEnvironmentBlock(["A=1"]), single);
}

test "an argument block ends every argument and nothing more" {
    byte[] block = blocks.argumentBlock(["one", "two"]);
    try testing.assertTrue(block.length == 8,
        "the block is {block.length} bytes, expected 8 for 'one' and 'two'");
    try testing.assertTrue(block[3] == 0 && block[7] == 0,
        "every argument must end in a terminator");
}

// A part is left bare where a program would read it back whole, so cmd.exe's own switches reach it
// as it expects them, and quoted where a space, a tab, a quote or emptiness would split or lose it.
test "a command line quotes only the parts a program would split" {
    try testing.assertEqual(blocks.commandLineOf("git", ["commit", "-m", "a message"]),
        "git commit -m \"a message\"");
    try testing.assertEqual(blocks.commandLineOf("c:/a b/ens.exe", ["/S", "x\"y", "", "tab\there",
        "back\\slash", "ends\\", "dir with space\\"]),
        "\"c:/a b/ens.exe\" /S \"x\\\"y\" \"\" \"tab\there\" back\\slash ends\\ "
        + "\"dir with space\\\\\"");
}

test "a shell command line puts the line after /S /C in one pair of quotes" {
    try testing.assertEqual(blocks.shellCommandLine("C:\\Windows\\cmd.exe", "echo \"a b\" & dir"),
        "\"C:\\Windows\\cmd.exe\" /S /C \"echo \"a b\" & dir\"");
}
