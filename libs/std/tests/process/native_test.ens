// Tests for what a child's start requires this machine to supply: the order an environment's entries
// go in, the head of a Win32 command line, the search for a program on PATH, and the numbers a
// closed pipe is identified by. A rule that differs per system is given the system rather than reading
// it, so every system's rule is checked whatever system runs these tests.
import @std.testing;
import @std.process.native;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;
import List from @std.collections.list;

// cmd.exe reads a '/' in its own name as a switch, so the head of a Windows line is spelled the way
// Windows spells a path; nothing else reads the line, so the text stays as written elsewhere.
test "the program at the head of a windows command line is spelled with backslashes" {
    try testing.assertEqual(native.commandLineProgram("C:/Windows/cmd.exe", Platform.Windows),
        "C:\\Windows\\cmd.exe");
    try testing.assertEqual(native.commandLineProgram("git", Platform.Windows), "git");
    try testing.assertEqual(native.commandLineProgram("/bin/sh", Platform.Linux), "/bin/sh");
    try testing.assertEqual(native.commandLineProgram("/bin/sh", Platform.MacOS), "/bin/sh");
}

// Windows looks a variable up without regard to case, so its block has to be sorted that way; byte
// order puts every capital before every small letter, which everywhere else is the order required.
test "environment entries are ordered the way the child's platform requires" {
    let variables = Environment.empty(Platform.Linux);
    variables.set("b", "2");
    variables.set("A", "1");
    variables.set("C", "3");
    try testing.assertEqual(native.environmentEntries(variables, Platform.Windows),
        ["A=1", "b=2", "C=3"]);
    try testing.assertEqual(native.environmentEntries(variables, Platform.Linux),
        ["A=1", "C=3", "b=2"]);
    try testing.assertEqual(native.environmentEntries(variables, Platform.MacOS),
        ["A=1", "C=3", "b=2"]);
}

test "the candidates for a bare name are one per PATH directory, in PATH's order" {
    try testing.assertEqual(shownPaths(native.candidatesOnPath("tool", "/usr/bin::/opt/x/bin",
        Platform.Linux)), "/usr/bin/tool /opt/x/bin/tool");
    try testing.assertEqual(shownPaths(native.candidatesOnPath("tool", "/usr/bin:/opt/x/bin:",
        Platform.MacOS)), "/usr/bin/tool /opt/x/bin/tool");
    try testing.assertEqual(shownPaths(native.candidatesOnPath("tool", "", Platform.Linux)), "");
}

// On Windows the name is looked for as written when it has an extension and as an executable
// otherwise, never through PATHEXT, and a directory written in quotes is read without them.
test "on windows a bare name is looked for as an executable and a directory may be quoted" {
    string pathValue = "C:\\Windows\\system32;\"C:\\Program Files\\x\";;D:\\tools";
    try testing.assertEqual(shownPaths(native.candidatesOnPath("tool", pathValue,
        Platform.Windows)),
        "C:/Windows/system32/tool.exe C:/Program Files/x/tool.exe D:/tools/tool.exe");
    try testing.assertEqual(shownPaths(native.candidatesOnPath("tool.cmd", "C:\\bin",
        Platform.Windows)), "C:/bin/tool.cmd");
    try testing.assertEqual(shownPaths(native.candidatesOnPath("python3.12", "C:\\bin",
        Platform.Windows)), "C:/bin/python3.12");
}

test "a PATH that is not set holds no program" {
    try testing.assertEqual(native.programsOnPath("tool", null, Platform.Linux).length, 0);
    try testing.assertEqual(native.programsOnPath("tool", null, Platform.Windows).length, 0);
}

// Two directories each hold a file of the name. POSIX lists both, since a start passes over one
// it may not execute, and Windows the first alone, since CreateProcess would stop there.
test "the programs on PATH are every file of the name, or on windows the first" {
    let scratch = try TemporaryDirectory.create("ens-std-process-programs");
    Path first = scratch.path().join("first");
    Path second = scratch.path().join("second");
    try first.createDirectories();
    try second.createDirectories();
    try first.join("tool.exe").writeText("first");
    try second.join("tool.exe").writeText("second");
    string separator = ":";
    if (environment.platform() == Platform.Windows) {
        separator = ";";
    }
    string pathValue = first.toString() + separator + second.toString();
    Path[] found = native.programsOnPath("tool.exe", pathValue, environment.platform());
    if (environment.platform() == Platform.Windows) {
        try testing.assertEqual(shownPaths(found), first.join("tool.exe").toString());
    } else {
        try testing.assertEqual(shownPaths(found),
            first.join("tool.exe").toString() + " " + second.join("tool.exe").toString());
    }
    try testing.assertEqual(native.programsOnPath("tool.exe", second.toString(),
        environment.platform()).length, 1);
    try testing.assertEqual(native.programsOnPath("absent.exe", pathValue,
        environment.platform()).length, 0);
}

// The numbers are the ones each system gives a writer whose reader has gone, and no system's
// number means that on another.
test "a closed pipe is identified by each platform's own number" {
    try testing.assertTrue(native.meansPipeClosed(32, Platform.Linux), "EPIPE on Linux");
    try testing.assertTrue(native.meansPipeClosed(32, Platform.MacOS), "EPIPE on macOS");
    try testing.assertFalse(native.meansPipeClosed(32, Platform.Windows),
        "32 is not a Win32 pipe number");
    try testing.assertTrue(native.meansPipeClosed(232, Platform.Windows), "ERROR_NO_DATA");
    try testing.assertTrue(native.meansPipeClosed(109, Platform.Windows), "ERROR_BROKEN_PIPE");
    try testing.assertFalse(native.meansPipeClosed(109, Platform.Linux),
        "109 is no closed pipe on Linux");
    try testing.assertFalse(native.meansPipeClosed(0, Platform.Linux), "success is no failure");
}

// The candidates as one line, so an assertion shows the places a search would try.
shownPaths(Path[] candidates) -> string {
    let texts = new List<string>();
    for (let candidate in candidates) {
        texts.push(candidate.toString());
    }
    return string.joined(texts.toArray(), " ");
}
