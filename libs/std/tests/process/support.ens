// What the process tests share: the interpreter each platform runs a script through, the scripts
// a child plays, a file in the current directory that removes itself, and the lines a child wrote.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;

public onWindows() -> bool {
    return environment.platform() == Platform.Windows;
}

// The interpreter a script runs through, as a program a start is given.
public interpreter() -> Path {
    if (onWindows()) {
        return Path.fromNative(Environment.current().get("ComSpec")
            ?? "C:\\Windows\\System32\\cmd.exe", Platform.Windows);
    }
    return Path("/bin/sh");
}

// The arguments that make the interpreter run the script this platform understands. A Windows
// script reaches cmd.exe after /S /C inside one pair of quotes, so it may hold none of its own.
public scriptArguments(string posixScript, string windowsScript) -> string[] {
    if (onWindows()) {
        return ["/S", "/C", windowsScript];
    }
    return ["-c", posixScript];
}

// The script this platform's interpreter understands, for a run through the shell.
public script(string posixScript, string windowsScript) -> string {
    if (onWindows()) {
        return windowsScript;
    }
    return posixScript;
}

// The name of the variable every interactive session on this platform is given, and its value in
// this process.
public homeName() -> string {
    if (onWindows()) {
        return "USERPROFILE";
    }
    return "HOME";
}

// A script that writes the variable `name` and this platform's home variable, joined by a dash,
// where a variable that is not set reads "unset" on POSIX and stays as written on Windows.
public probeScript(string name) -> string {
    return script("echo \"$" + name + "-$\{" + homeName() + "-unset\}\"",
        "echo %" + name + "%-%" + homeName() + "%");
}

// The lines `text` holds, without their endings and without the carriage returns a Windows child
// writes before its newlines.
public lines(string text) -> string[] {
    string[] split = text.replace("\r", "").split("\n");
    if (split.length > 0 && split[split.length - 1].isEmpty()) {
        return split.slice(0, split.length - 1);
    }
    return split;
}

// The two lines a flood writes, 66 characters each, one per stream so a line on the wrong stream
// is told apart.
public final class Flood {
    public static const string output = "out-oooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo";
    public static const string errors = "err-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";
}

// A script writing `count` lines to each stream in turn.
public floodScript(long count) -> string {
    return script("i=0; while [ $i -lt {count} ]; do echo {Flood.output}; "
        + "echo {Flood.errors} >&2; i=$((i+1)); done",
        "for /L %i in (1,1,{count}) do @(echo {Flood.output}& 1>&2 echo {Flood.errors})");
}

// A file in this process's current directory for as long as the value lives, and removed when it
// dies even when an assertion failed first, so the tree the tests run in is left as it was found.
public final class CurrentDirectoryFile {
    const Path location;

    protected constructor(this.location);

    public static create(string name) -> CurrentDirectoryFile throws FileSystemError {
        Path location = environment.currentDirectory().join(name);
        try location.writeText("not a program");
        return new CurrentDirectoryFile(location);
    }

    public path() -> Path {
        return this.location;
    }

    destructor() {
        try this.location.removeFile();
    } catch (FileSystemError ignored) { }
}
