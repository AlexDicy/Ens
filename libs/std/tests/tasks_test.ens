// Tests for scopes and the tasks they start, and single-threaded tests for Atomic, Mutex and
// Channel, whose multi-threaded cases the fixtures in 'tests/' cover.
import @std.testing;
import @std.tasks;
import Cancelled from @std.tasks;
import Task from @std.tasks;
import TaskScope from @std.tasks;
import TaskPriority from @std.tasks;
import Atomic from @std.tasks;
import Mutex from @std.tasks;
import Channel from @std.tasks;
import ChannelClosed from @std.tasks;
import List from @std.collections.list;

test "an atomic reads what was written, and counts from it" {
    let count = new Atomic<int>(5);
    try testing.assertEqual(count.read(), 5);
    count.write(9);
    try testing.assertEqual(count.increment(), 10);
    try testing.assertEqual(count.add(-4), 6);
    try testing.assertEqual(count.decrement(), 5);
    try testing.assertTrue(count.compareAndSet(5, 1), "the value it holds is replaced");
    try testing.assertFalse(count.compareAndSet(5, 2), "a value it no longer holds is not");
    try testing.assertEqual(count.read(), 1);
}

test "an atomic reference is compared by identity" {
    let first = "a" + "b";
    let second = "a" + "b";
    let held = new Atomic<string>(first);
    try testing.assertFalse(held.compareAndSet(second, "c"), "equal text that is another string");
    try testing.assertTrue(held.compareAndSet(first, "c"), "the string it holds");
    try testing.assertEqual(held.read(), "c");
}

test "a channel hands values over in the order they were sent" {
    let channel = new Channel<int>(4);
    let sender = channel.sender();
    try sender.send(1);
    try sender.send(2);
    try sender.send(3);
    try testing.assertEqual<int?>(channel.receive(), 1);
    try testing.assertEqual<int?>(channel.receive(), 2);
    try testing.assertEqual<int?>(channel.receive(), 3);
}

test "a wait with a limit returns null with the channel still open" {
    let channel = new Channel<int>(1);
    let sender = channel.sender();
    try testing.assertEqual<int?>(channel.receive(1), null);
    try testing.assertFalse(channel.isClosed(), "a sender is still held");
}

test "releasing the last sender closes the channel once its values are received" {
    let channel = new Channel<string>(2);
    {
        let sender = channel.sender();
        try sender.send("left");
    }
    try testing.assertTrue(channel.isClosed(), "no sender is held");
    let walked = new List<string>();
    for (let value in channel) {
        walked.push(value);
    }
    try testing.assertEqual(walked.toArray(), ["left"]);
    try testing.assertEqual<string?>(channel.receive(), null);
}

test "a send after the receiving end is released throws" {
    let sender = new Channel<int>(1).sender();
    let failure = try testing.assertThrows<ChannelClosed>(() -> {
        try sender.send(1);
    });
    try testing.assertTrue(failure.message.startsWith("could not send"), failure.message);
}

final class Tally {
    long count = 0;
}

class Refused extends Error {
    constructor() {
        super("refused");
    }
}

countThrough(Mutex<Tally> tally, long limit) -> long throws Refused {
    return try tally.lock((held) -> {
        if (held.count >= limit) {
            throw new Refused();
        }
        held.count = held.count + 1;
        return held.count;
    });
}

refusedAt(Mutex<Tally> tally, long limit) -> bool {
    let ignored = try countThrough(tally, limit);
    return false;
} catch (Refused error) {
    return true;
}

test "a mutex body changes the value in place and gives its result back" {
    let tally = new Mutex<Tally>(new Tally());
    tally.lock((held) -> {
        held.count = 4;
    });
    long doubled = tally.lock((held) -> held.count * 2);
    try testing.assertEqual(doubled, 8L);
}

test "a mutex updates a number or a struct with what its body returns" {
    let hits = new Mutex<int>(0);
    hits.update((count) -> count + 1);
    hits.update((count) -> count + 1);
    try testing.assertEqual(hits.lock((count) -> count), 2);
}

test "a mutex body that throws passes the error on and leaves the mutex free" {
    let tally = new Mutex<Tally>(new Tally());
    try testing.assertEqual(try countThrough(tally, 1), 1L);
    try testing.assertTrue(refusedAt(tally, 1), "the second count is over the limit");
    try testing.assertEqual(try countThrough(tally, 5), 2L);
}

refuse() -> int throws Refused {
    throw new Refused();
    return 0;
}

// Checks for cancellation until it is asked to stop, so the test that starts it ends it.
untilCancelled() -> int throws Cancelled {
    while (true) {
        try tasks.checkCancelled();
        tasks.sleep(1);
    }
    return 0;
}

awaitedMessage(Task<(() -> int throws Cancelled)> task) -> string {
    return "{try task.await()}";
} catch (Cancelled stop) {
    return stop.message;
}

test "a scope returns what its body returns once every task it started has finished" {
    let finished = new Atomic<int>(0);
    int total = tasks.scope((scope) -> {
        let first = scope.start(() -> 20);
        let second = scope.start(() -> 22);
        scope.launch(() -> {
            finished.increment();
        });
        return first.await() + second.await();
    });
    try testing.assertEqual(total, 42);
    try testing.assertEqual(finished.read(), 1);
}

test "awaiting a task that threw throws what it threw" {
    string outcome = tasks.scope((scope) -> {
        let failing = scope.start(() -> try refuse());
        return attemptRefused(failing);
    });
    try testing.assertEqual(outcome, "refused");
}

attemptRefused(Task<(() -> int throws Refused)> task) -> string {
    return "{try task.await()}";
} catch (Refused refused) {
    return refused.message;
}

test "a shareable result is given to every awaiter" {
    string twice = tasks.scope((scope) -> {
        let named = scope.start(() -> "named");
        return named.await() + named.await();
    });
    try testing.assertEqual(twice, "namednamed");
}

test "a cancelled scope stops a task that checks, which then throws 'Cancelled'" {
    string outcome = tasks.scope((scope) -> {
        let waiting = scope.start(() -> try untilCancelled());
        scope.cancel();
        return awaitedMessage(waiting);
    });
    try testing.assertEqual(outcome, "the task was cancelled");
}

test "cancelling a task stops it and the tasks it started" {
    string outcome = tasks.scope((scope) -> {
        let parent = scope.start(() -> tasks.scope((inner) -> {
            let child = inner.start(() -> try untilCancelled());
            return awaitedMessage(child).length as int;
        }));
        parent.cancel();
        return "{parent.await()}";
    });
    try testing.assertEqual(outcome, "22");
}

test "a deadline cancels the scope's tasks once it passes" {
    string outcome = tasks.scope((scope) -> {
        scope.cancelAfter(5);
        return awaitedMessage(scope.start(() -> try untilCancelled()));
    });
    try testing.assertEqual(outcome, "the task was cancelled");
}

test "code outside every task is never cancelled" {
    try testing.assertFalse(tasks.isCancelled(), "no task was asked to stop");
    try tasks.checkCancelled();
}

test "a scope kept in an object cancels and waits for its tasks when it is released" {
    let stopped = new Atomic<bool>(false);
    let kept = new TaskScope();
    kept.launch(() -> {
        while (!tasks.isCancelled()) {
            tasks.sleep(1);
        }
        stopped.write(true);
    });
    kept = new TaskScope();
    try testing.assertTrue(stopped.read(), "the released scope waited for its task to stop");
}

test "a dedicated task runs its body whatever priority the system grants" {
    int total = tasks.scope((scope) -> {
        let realtime = scope.startDedicated(TaskPriority.Realtime, () -> 4);
        let high = scope.startDedicated(TaskPriority.High, () -> 2);
        return realtime.await() + high.await();
    });
    try testing.assertEqual(total, 6);
}
