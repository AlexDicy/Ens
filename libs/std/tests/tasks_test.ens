// Tests for the values tasks share, on one thread: what an Atomic returns, what a Mutex's body
// gives back, and the order, the limits and the ends of a channel. The fixtures run them across threads.
import @std.testing;
import Atomic from @std.tasks;
import Mutex from @std.tasks;
import Channel from @std.tasks;
import ChannelClosed from @std.tasks;
import List from @std.collections.list;

test "an atomic reads what was written, and counts from it" {
    let count = new Atomic<int>(5);
    try testing.assertEqual(count.read(), 5);
    count.write(9);
    try testing.assertEqual(count.increment(), 10);
    try testing.assertEqual(count.add(-4), 6);
    try testing.assertEqual(count.decrement(), 5);
    try testing.assertTrue(count.compareAndSet(5, 1), "the value it holds is replaced");
    try testing.assertFalse(count.compareAndSet(5, 2), "a value it no longer holds is not");
    try testing.assertEqual(count.read(), 1);
}

test "an atomic reference is compared by identity" {
    let first = "a" + "b";
    let second = "a" + "b";
    let held = new Atomic<string>(first);
    try testing.assertFalse(held.compareAndSet(second, "c"), "equal text that is another string");
    try testing.assertTrue(held.compareAndSet(first, "c"), "the string it holds");
    try testing.assertEqual(held.read(), "c");
}

test "a channel hands values over in the order they were sent" {
    let channel = new Channel<int>(4);
    let sender = channel.sender();
    try sender.send(1);
    try sender.send(2);
    try sender.send(3);
    try testing.assertEqual<int?>(channel.receive(), 1);
    try testing.assertEqual<int?>(channel.receive(), 2);
    try testing.assertEqual<int?>(channel.receive(), 3);
}

test "a wait with a limit returns null with the channel still open" {
    let channel = new Channel<int>(1);
    let sender = channel.sender();
    try testing.assertEqual<int?>(channel.receive(1), null);
    try testing.assertFalse(channel.isClosed(), "a sender is still held");
}

test "releasing the last sender closes the channel once its values are received" {
    let channel = new Channel<string>(2);
    {
        let sender = channel.sender();
        try sender.send("left");
    }
    try testing.assertTrue(channel.isClosed(), "no sender is held");
    let walked = new List<string>();
    for (let value in channel) {
        walked.push(value);
    }
    try testing.assertEqual(walked.toArray(), ["left"]);
    try testing.assertEqual<string?>(channel.receive(), null);
}

test "a send after the receiving end is released throws" {
    let sender = new Channel<int>(1).sender();
    let failure = try testing.assertThrows<ChannelClosed>(() -> {
        try sender.send(1);
    });
    try testing.assertTrue(failure.message.startsWith("could not send"), failure.message);
}

final class Tally {
    long count = 0;
}

class Refused extends Error {
    constructor() {
        super("refused");
    }
}

countThrough(Mutex<Tally> tally, long limit) -> long throws Refused {
    return try tally.lock((held) -> {
        if (held.count >= limit) {
            throw new Refused();
        }
        held.count = held.count + 1;
        return held.count;
    });
}

refusedAt(Mutex<Tally> tally, long limit) -> bool {
    let ignored = try countThrough(tally, limit);
    return false;
} catch (Refused error) {
    return true;
}

test "a mutex body changes the value in place and gives its result back" {
    let tally = new Mutex<Tally>(new Tally());
    tally.lock((held) -> {
        held.count = 4;
    });
    long doubled = tally.lock((held) -> held.count * 2);
    try testing.assertEqual(doubled, 8L);
}

test "a mutex updates a number or a struct with what its body returns" {
    let hits = new Mutex<int>(0);
    hits.update((count) -> count + 1);
    hits.update((count) -> count + 1);
    try testing.assertEqual(hits.lock((count) -> count), 2);
}

test "a mutex body that throws passes the error on and leaves the mutex free" {
    let tally = new Mutex<Tally>(new Tally());
    try testing.assertEqual(try countThrough(tally, 1), 1L);
    try testing.assertTrue(refusedAt(tally, 1), "the second count is over the limit");
    try testing.assertEqual(try countThrough(tally, 5), 2L);
}
