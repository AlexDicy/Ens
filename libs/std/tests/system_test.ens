// Tests for the facts '@std.system' reports about the system itself. What the file system and a
// spawned child do is verified end to end by the fixtures under 'tests/', so what belongs here is
// the part that is a rule rather than an effect.
import @std.testing;
import @std.system;

test "the platform is named the way a manifest names one" {
    string name = system.platform();
    try testing.assertTrue(name == "windows" || name == "linux" || name == "macos",
        "platform() answered '{name}', which no native binding could name");
}

// Flushing hands over a buffer and answers with nothing, so what it must do is leave everything
// else alone, with nothing waiting and with a line waiting. The order it guarantees is pinned by the
// 'output_flush_child' and 'output_flush_panic' fixtures, which run a real child and a real panic.
test "flushing what has been printed leaves the program running" {
    system.flush();
    print("std_library flushed this line");
    system.flush();
}

test "the platform agrees with the paths the system reports" {
    string here = system.currentDirectory();
    try testing.assertTrue(!here.contains("\\"),
        "the working directory '{here}' still holds a native separator");
    if (system.platform() == "windows") {
        try testing.assertTrue(here.length > 1 && here.substring(1, 2) == ":",
            "'{here}' should start at a drive letter on windows");
        return;
    }
    try testing.assertTrue(here.startsWith("/"),
        "'{here}' should start at the root");
}
