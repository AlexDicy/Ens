// Tests for the reasons a failed start is given: the program a script's first line names, which
// decides two of them, and the cases a caller words itself, as a bare name no PATH directory holds.
import @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import PlatformCode from @std.system;
import @std.system;

test "the program a script's first line names is read up to its arguments" {
    let scratch = try TemporaryDirectory.create("ens-std-process-first-line");
    Path folder = scratch.path();
    try folder.join("spaced").writeText("#!  /usr/bin/env python3\n");
    try folder.join("crlf").writeText("#!/bin/sh\r\nexit 0\r\n");
    try folder.join("bare").writeText("#!\n");
    try folder.join("plain").writeText("echo no first line\n");
    try folder.join("long").writeText("#!/{"no-such-directory/".repeat(16)}interpreter\n");
    try assertLine(folder.join("spaced"), PlatformCode.linux, "/usr/bin/env", 0);
    try assertLine(folder.join("crlf"), PlatformCode.linux, "/bin/sh", 0);
    try assertLine(folder.join("bare"), PlatformCode.linux, "", 0);
    try assertLine(folder.join("plain"), PlatformCode.linux, "", 0);
    try assertLine(folder.join("missing"), PlatformCode.linux, "", 0);
    try assertLine(folder.join("long"), PlatformCode.linux, "", 256);
    try assertLine(folder.join("long"), PlatformCode.macOS,
        "/{"no-such-directory/".repeat(16)}interpreter", 0);
}

// Fails unless the first line of the script at `path`, as the system `platform` names reads it,
// names `program` and runs past `longerThan` bytes.
assertLine(Path path, int platform, string program, long longerThan) throws {
    let line = system.firstLineOf(path.toString(), platform);
    try testing.assertEqual(line.program, program);
    try testing.assertEqual(line.longerThan, longerThan);
}

// A missing program is the program part with a number for absence, or the same number from a
// bridge that carries no part. Any other part is the start's own reason.
test "a code is a missing program only when the program itself is not there" {
    try testing.assertTrue(system.startProgramMissing((1 << 24) | 2), "the program part");
    try testing.assertTrue(system.startProgramMissing(2), "a code with no part");
    try testing.assertFalse(system.startProgramMissing((2 << 24) | 2), "the working directory");
    try testing.assertFalse(system.startProgramMissing((8 << 24) | 2), "a missing interpreter");
    try testing.assertEqual(system.notOnPathReason(), "no directory that the PATH environment "
        + "variable lists contains a program of that name. Check the name, or give the "
        + "program's full path");
}
