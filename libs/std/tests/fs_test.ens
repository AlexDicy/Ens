// Tests for the rules Path applies to its own text. None of them reads the disk, so every result
// here is the same whatever a file system happens to hold.
import @std.testing;
import Path from @std.fs;
import Platform from @std.environment;
import @std.environment;
import List from @std.collections.list;

test "the empty path is a value of its own" {
    try testing.assertTrue(Path("").isEmpty(), "the empty path is empty");
    try testing.assertEqual(Path("").toString(), "");
    try testing.assertFalse(Path("").isAbsolute(), "the empty path names no place on its own");
    try testing.assertEqual(Path("").fileName(), "");
    try testing.assertTrue(Path("").parent() == null, "nothing is written above the empty path");
    try testing.assertEqual(Path("").normalize(), Path("."));
    Path[] room = new Path[2];
    try testing.assertTrue(room[0].isEmpty(), "an array of paths starts out holding empty ones");
}

test "joining puts one separator between the two parts" {
    try testing.assertEqual(Path("a").join("b"), Path("a/b"));
    try testing.assertEqual(Path("a/").join("b"), Path("a/b"));
    try testing.assertEqual(Path("/a").join(Path("b/c")), Path("/a/b/c"));
    try testing.assertEqual(Path("").join("b"), Path("b"));
    try testing.assertEqual(Path("a").join(""), Path("a"));
}

// An absolute part names its place without anything in front of it, so joining one has to give
// the part rather than a path that would read the part against somewhere else.
test "joining an absolute part gives the part alone" {
    try testing.assertEqual(Path("a/b").join("/etc/hosts"), Path("/etc/hosts"));
    try testing.assertEqual(Path("/usr").join("C:/Windows"), Path("C:/Windows"));
    try testing.assertEqual(Path("relative").join("//server/share/file"),
        Path("//server/share/file"));
    try testing.assertEqual(Path("a/b").join("C:foo"), Path("a/b/C:foo"));
}

test "the parent is the directory one level up" {
    try testing.assertEqual(Path("a/b/c").parent(), Path("a/b"));
    try testing.assertEqual(Path("/a/b").parent(), Path("/a"));
    try testing.assertEqual(Path("/a").parent(), Path("/"));
    try testing.assertEqual(Path("C:/a").parent(), Path("C:/"));
    try testing.assertEqual(Path("//server/share/a").parent(), Path("//server/share"));
    try testing.assertEqual(Path("a//b").parent(), Path("a"));
    try testing.assertEqual(Path("a/b/").parent(), Path("a"));
}

// Nothing is written above a root, and nothing is written above a bare name either, which is a
// different thing from a name whose parent is the current directory.
test "a root and a bare name have no parent" {
    try testing.assertTrue(Path("/").parent() == null, "nothing is above the root");
    try testing.assertTrue(Path("C:/").parent() == null, "nothing is above a drive");
    try testing.assertTrue(Path("//server/share").parent() == null, "nothing is above a share");
    try testing.assertTrue(Path("//server").parent() == null, "nothing is above a server");
    try testing.assertTrue(Path("notes.txt").parent() == null, "a bare name writes no directory");
    try testing.assertTrue(Path("..").parent() == null, "'..' writes no directory either");
}

test "the file name is the last part, and a root has none" {
    try testing.assertEqual(Path("a/b/notes.txt").fileName(), "notes.txt");
    try testing.assertEqual(Path("/a").fileName(), "a");
    try testing.assertEqual(Path("notes.txt").fileName(), "notes.txt");
    try testing.assertEqual(Path("a/b/").fileName(), "b");
    try testing.assertEqual(Path("/").fileName(), "");
    try testing.assertEqual(Path("C:/").fileName(), "");
    try testing.assertEqual(Path("//server/share").fileName(), "");
}

test "the extension is what follows the last dot of the name" {
    try testing.assertEqual(Path("a/notes.txt").extension(), "txt");
    try testing.assertEqual(Path("a/archive.tar.gz").extension(), "gz");
    try testing.assertEqual(Path("a/notes").extension(), "");
    try testing.assertEqual(Path("a/notes.").extension(), "");
    try testing.assertEqual(Path("/").extension(), "");
}

// A name whose only dot starts it is how a hidden file is written, so that dot names no extension
// and the whole name is the stem.
test "a dotfile has no extension" {
    try testing.assertEqual(Path("a/.gitignore").extension(), "");
    try testing.assertEqual(Path("a/.gitignore").stem(), ".gitignore");
    try testing.assertEqual(Path(".gitignore").extension(), "");
    try testing.assertEqual(Path("a/.config.json").extension(), "json");
    try testing.assertEqual(Path("a/.config.json").stem(), ".config");
}

test "the stem is the name without its extension" {
    try testing.assertEqual(Path("a/notes.txt").stem(), "notes");
    try testing.assertEqual(Path("a/archive.tar.gz").stem(), "archive.tar");
    try testing.assertEqual(Path("a/notes").stem(), "notes");
    try testing.assertEqual(Path("a/notes.").stem(), "notes");
}

test "an absolute path names its place on its own" {
    try testing.assertTrue(Path("/etc/hosts").isAbsolute(), "a path from the root is absolute");
    try testing.assertTrue(Path("C:/Windows").isAbsolute(), "a drive with a separator is absolute");
    try testing.assertTrue(Path("c:/windows").isAbsolute(), "a drive is written in either case");
    try testing.assertTrue(Path("//server/share").isAbsolute(), "a server share is absolute");
    try testing.assertFalse(Path("a/b").isAbsolute(), "a bare path is relative");
    try testing.assertFalse(Path("").isAbsolute(), "the empty path is relative");
}

// 'C:foo' names a place only against whatever that drive's current directory happens to be, so it
// is relative text here, while 'C:/foo' names its place and stays absolute.
test "drive-relative text is relative" {
    try testing.assertFalse(Path("C:foo").isAbsolute(), "a drive with no separator is relative");
    try testing.assertFalse(Path("C:").isAbsolute(), "a drive alone is relative");
    try testing.assertTrue(Path("C:/foo").isAbsolute(), "a drive with a separator is absolute");
    try testing.assertEqual(Path("C:foo/./bar").normalize(), Path("C:foo/bar"));
    try testing.assertTrue(Path("C:foo").parent() == null, "no directory is written above it");
}

test "normalizing drops '.' parts and repeated separators" {
    try testing.assertEqual(Path("a/./b").normalize(), Path("a/b"));
    try testing.assertEqual(Path("a//b").normalize(), Path("a/b"));
    try testing.assertEqual(Path("a/b/").normalize(), Path("a/b"));
    try testing.assertEqual(Path("./a").normalize(), Path("a"));
    try testing.assertEqual(Path(".").normalize(), Path("."));
    try testing.assertEqual(Path("./").normalize(), Path("."));
    try testing.assertEqual(Path("/").normalize(), Path("/"));
    try testing.assertEqual(Path("/a/./b//c").normalize(), Path("/a/b/c"));
}

test "normalizing removes every '..' that has a part to remove" {
    try testing.assertEqual(Path("a/b/../c").normalize(), Path("a/c"));
    try testing.assertEqual(Path("a/b/..").normalize(), Path("a"));
    try testing.assertEqual(Path("a/..").normalize(), Path("."));
    try testing.assertEqual(Path("/a/b/../../c").normalize(), Path("/c"));
    try testing.assertEqual(Path("C:/a/../b").normalize(), Path("C:/b"));
}

// A relative path keeps the '..' parts it cannot resolve, because dropping them would name a
// different place; a root has nothing above it, so a '..' there is dropped.
test "a '..' beyond the root is dropped and a relative one is kept" {
    try testing.assertEqual(Path("/a/../../b").normalize(), Path("/b"));
    try testing.assertEqual(Path("/..").normalize(), Path("/"));
    try testing.assertEqual(Path("C:/..").normalize(), Path("C:/"));
    try testing.assertEqual(Path("//server/share/..").normalize(), Path("//server/share"));
    try testing.assertEqual(Path("a/../..").normalize(), Path(".."));
    try testing.assertEqual(Path("../../a").normalize(), Path("../../a"));
    try testing.assertEqual(Path("..").normalize(), Path(".."));
}

// A path starting '//' names a server and a share, and both of those separators are part of the
// place it starts from, so normalizing has to leave them alone.
test "normalizing keeps the leading '//' of a server share" {
    try testing.assertEqual(Path("//server/share/./a").normalize(), Path("//server/share/a"));
    try testing.assertEqual(Path("//server/share//a/b/..").normalize(),
        Path("//server/share/a"));
    try testing.assertEqual(Path("//server/share").normalize(), Path("//server/share"));
    try testing.assertEqual(Path("//server").normalize(), Path("//server"));
}

test "a relative path becomes absolute against a working directory" {
    try testing.assertEqual(Path("src/main.ens").absolute(Path("/home/alex/proj")),
        Path("/home/alex/proj/src/main.ens"));
    try testing.assertEqual(Path("../notes.txt").absolute(Path("/home/alex/proj")),
        Path("/home/alex/notes.txt"));
    try testing.assertEqual(Path("/etc/./hosts").absolute(Path("/home/alex")),
        Path("/etc/hosts"));
    try testing.assertEqual(Path("a").absolute(Path("C:/work")), Path("C:/work/a"));
}

// The overload with no argument reads the directory the program was started in, which is a fact
// about the process rather than about the disk.
test "a relative path becomes absolute against where the program started" {
    Path here = environment.currentDirectory();
    try testing.assertEqual(Path("notes.txt").absolute(), here.join("notes.txt").normalize());
    try testing.assertTrue(Path("notes.txt").absolute().isAbsolute(),
        "the answer names its place on its own");
}

test "windows text becomes a path written with '/'" {
    try testing.assertEqual(Path.fromNative("C:\\Users\\Alex\\notes.txt", Platform.Windows),
        Path("C:/Users/Alex/notes.txt"));
    try testing.assertEqual(Path.fromNative("src\\main.ens", Platform.Windows),
        Path("src/main.ens"));
    try testing.assertEqual(Path.fromNative("\\\\server\\share\\file", Platform.Windows),
        Path("//server/share/file"));
    try testing.assertEqual(Path.fromNative("\\", Platform.Windows), Path("/"));
}

// '\' is an ordinary character in a name on Linux and macOS, so converting it would name a
// different file; text from either system therefore is returned byte for byte.
test "a backslash in a linux or macos name survives untouched" {
    for (let naming in [Platform.Linux, Platform.MacOS]) {
        try testing.assertEqual(Path.fromNative("/home/alex/odd\\name.txt", naming),
            Path("/home/alex/odd\\name.txt"));
        try testing.assertEqual(Path.fromNative("a\\b\\c", naming), Path("a\\b\\c"));
        try testing.assertEqual(Path.fromNative("/usr/local/bin", naming),
            Path("/usr/local/bin"));
    }
}

test "text already written with '/' is unchanged on every platform" {
    for (let naming in [Platform.Windows, Platform.Linux, Platform.MacOS]) {
        try testing.assertEqual(Path.fromNative("C:/Users/Alex", naming), Path("C:/Users/Alex"));
        try testing.assertEqual(Path.fromNative("src/main.ens", naming), Path("src/main.ens"));
        try testing.assertEqual(Path.fromNative("", naming), Path(""));
    }
}

// Two paths are equal only when their text is equal, so a path that names the same place through
// different text sorts and compares as the different text it is.
test "paths compare and sort by the bytes of their text" {
    try testing.assertTrue(Path("a/b").compareTo(Path("a/b")) == 0, "the same text compares equal");
    try testing.assertTrue(Path("a/b").compareTo(Path("a/c")) < 0, "'b' sorts before 'c'");
    try testing.assertTrue(Path("a/c").compareTo(Path("a/b")) > 0, "'c' sorts after 'b'");
    try testing.assertNotEqual(Path("a/b"), Path("a/./b"));
    try testing.assertEqual(Path("a/./b").normalize(), Path("a/b"));

    let paths = new List<Path>();
    paths.push(Path("b/one"));
    paths.push(Path("a/two"));
    paths.push(Path("a/one"));
    let sorted = paths.sorted();
    try testing.assertEqual(sorted.get(0), Path("a/one"));
    try testing.assertEqual(sorted.get(1), Path("a/two"));
    try testing.assertEqual(sorted.get(2), Path("b/one"));
}
