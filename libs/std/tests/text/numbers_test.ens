// Tests for what this module adds to the number types and to `char`: the radix form of
// `toString`, the decimal form the compiler provides still being there beside it, the order
// `compareTo` puts two values in, the three questions a floating-point value answers about
// itself, and the bits one is made of. The radix-out-of-range abort is pinned by a fixture, since
// a broken contract ends the program rather than the test.
import @std.testing;

test "every integer type writes a value in another base and keeps its decimal form" {
    byte small = 255;
    short negativeShort = -300;
    ushort wideShort = 65535;
    int negativeInt = -255;
    uint wideInt = 4294967295;
    long negativeLong = -255;
    ulong wideLong = 18446744073709551615;
    try testing.assertEqual(small.toString(16), "ff");
    try testing.assertEqual(small.toString(), "255");
    try testing.assertEqual(negativeShort.toString(16), "-12c");
    try testing.assertEqual(negativeShort.toString(), "-300");
    try testing.assertEqual(wideShort.toString(16), "ffff");
    try testing.assertEqual(wideShort.toString(), "65535");
    try testing.assertEqual(negativeInt.toString(16), "-ff");
    try testing.assertEqual(negativeInt.toString(), "-255");
    try testing.assertEqual(wideInt.toString(16), "ffffffff");
    try testing.assertEqual(wideInt.toString(), "4294967295");
    try testing.assertEqual(negativeLong.toString(16), "-ff");
    try testing.assertEqual(negativeLong.toString(), "-255");
    try testing.assertEqual(wideLong.toString(16), "ffffffffffffffff");
    try testing.assertEqual(wideLong.toString(), "18446744073709551615");
}

test "the bases run from two through thirty-six, in lowercase" {
    try testing.assertEqual(255L.toString(2), "11111111");
    try testing.assertEqual(255L.toString(8), "377");
    try testing.assertEqual(255L.toString(10), "255");
    try testing.assertEqual(255L.toString(16), "ff");
    try testing.assertEqual(255L.toString(36), "73");
    try testing.assertEqual(35L.toString(36), "z");
    try testing.assertEqual(1295L.toString(36), "zz");
}

test "zero is one digit in every base, and a negative value keeps its sign" {
    try testing.assertEqual(0L.toString(2), "0");
    try testing.assertEqual(0L.toString(36), "0");
    try testing.assertEqual((-1L).toString(2), "-1");
    try testing.assertEqual((-255L).toString(16), "-ff");
    try testing.assertEqual((-1295L).toString(36), "-zz");
}

test "the ends of the widest types still read out" {
    long largest = 9223372036854775807;
    long smallest = -9223372036854775808;
    try testing.assertEqual(largest.toString(16), "7fffffffffffffff");
    try testing.assertEqual(largest.toString(36), "1y2p0ij32e8e7");
    // The smallest long has no positive form of its own, so its digits are counted as a magnitude.
    try testing.assertEqual(smallest.toString(16), "-8000000000000000");
    try testing.assertEqual(smallest.toString(36), "-1y2p0ij32e8e8");
    try testing.assertEqual(smallest.toString(2).length, 65L);
}

test "width comes from padStart rather than from an argument of its own" {
    try testing.assertEqual(255L.toString(16).padStart(4, '0'), "00ff");
    try testing.assertEqual(5L.toString(2).padStart(8, '0'), "00000101");
    try testing.assertEqual(255L.toString(16).padStart(2, '0'), "ff");
}

test "every integer type and 'char' order by value" {
    byte small = 2;
    byte large = 200;
    try testing.assertEqual(small.compareTo(large), -1);
    try testing.assertEqual(large.compareTo(small), 1);
    try testing.assertEqual(large.compareTo(large), 0);
    short negativeShort = -300;
    short zeroShort = 0;
    try testing.assertEqual(negativeShort.compareTo(zeroShort), -1);
    int negativeInt = -255;
    int positiveInt = 255;
    try testing.assertEqual(negativeInt.compareTo(positiveInt), -1);
    long smallest = -9223372036854775808;
    long largest = 9223372036854775807;
    try testing.assertEqual(smallest.compareTo(largest), -1);
    try testing.assertEqual(largest.compareTo(smallest), 1);
    try testing.assertEqual('a'.compareTo('b'), -1);
    try testing.assertEqual('b'.compareTo('a'), 1);
    try testing.assertEqual('a'.compareTo('a'), 0);
}

// Each unsigned type's high half has the sign bit of the signed type its bits would spell, so a
// value from there sorting above a small one is what says the comparison is unsigned.
test "an unsigned value above the signed range still sorts above a small one" {
    byte highByte = 200;
    byte oneByte = 1;
    try testing.assertEqual(highByte.compareTo(oneByte), 1);
    ushort highShort = 65535;
    ushort oneShort = 1;
    try testing.assertEqual(highShort.compareTo(oneShort), 1);
    uint highInt = 4294967295;
    uint oneInt = 1;
    try testing.assertEqual(highInt.compareTo(oneInt), 1);
    ulong highLong = 18446744073709551615;
    ulong oneLong = 1;
    try testing.assertEqual(highLong.compareTo(oneLong), 1);
}

// A character orders by codepoint, which is the order its UTF-8 bytes sort in, so a list of
// characters and the text they spell agree about which comes first.
test "'char' order follows the codepoint past ASCII" {
    try testing.assertEqual('é'.compareTo('z'), 1);
    try testing.assertEqual('z'.compareTo('é'), -1);
    try testing.assertEqual('é'.compareTo('€'), -1);
    try testing.assertEqual("é".compareTo("z"), 1);
}

// Every value has a place in this order, including the ones `<` and `>` leave unordered, so a NaN
// sorts above every number and level with another NaN and negative zero sorts just below zero.
test "'double' orders every value, NaN above the numbers and negative zero below zero" {
    double zero = 0.0;
    double nan = zero / zero;
    double infinity = 1.0 / zero;
    double negativeInfinity = -1.0 / zero;
    double negativeZero = -0.0;
    try testing.assertEqual((1.5).compareTo(2.5), -1);
    try testing.assertEqual((2.5).compareTo(1.5), 1);
    try testing.assertEqual((2.5).compareTo(2.5), 0);
    try testing.assertEqual((-2.5).compareTo(2.5), -1);
    try testing.assertEqual(negativeInfinity.compareTo(infinity), -1);
    try testing.assertEqual(infinity.compareTo(1.0), 1);
    try testing.assertEqual(nan.compareTo(1.0), 1);
    try testing.assertEqual((1.0).compareTo(nan), -1);
    try testing.assertEqual(nan.compareTo(infinity), 1);
    try testing.assertEqual(nan.compareTo(negativeInfinity), 1);
    try testing.assertEqual(nan.compareTo(zero), 1);
    try testing.assertEqual(nan.compareTo(nan), 0);
    try testing.assertEqual(nan.compareTo(zero / zero), 0);
    try testing.assertEqual(negativeZero.compareTo(zero), -1);
    try testing.assertEqual(zero.compareTo(negativeZero), 1);
    try testing.assertEqual(negativeZero.compareTo(negativeZero), 0);
    try testing.assertEqual(zero.compareTo(zero), 0);
}

// A `float` widens to `double` for the comparison, which is exact and keeps both the sign of a
// zero and a NaN, so the order reads the same at the narrower width.
test "'float' orders every value the same way" {
    float zero = 0.0 as float;
    float nan = zero / zero;
    float infinity = (1.0 as float) / zero;
    float negativeZero = -0.0 as float;
    float one = 1.0 as float;
    try testing.assertEqual(one.compareTo(2.0 as float), -1);
    try testing.assertEqual((2.0 as float).compareTo(one), 1);
    try testing.assertEqual(one.compareTo(one), 0);
    try testing.assertEqual(nan.compareTo(one), 1);
    try testing.assertEqual(one.compareTo(nan), -1);
    try testing.assertEqual(nan.compareTo(infinity), 1);
    try testing.assertEqual(nan.compareTo(nan), 0);
    try testing.assertEqual(negativeZero.compareTo(zero), -1);
    try testing.assertEqual(zero.compareTo(negativeZero), 1);
}

// The one answer three agreeing predicates spell, or all three of them when they contradict each
// other.
describe(bool notANumber, bool finite, bool infinite) -> string {
    if (notANumber && !finite && !infinite) {
        return "a NaN";
    }
    if (finite && !notANumber && !infinite) {
        return "a number";
    }
    if (infinite && !notANumber && !finite) {
        return "an infinity";
    }
    return "isNaN={notANumber}, isFinite={finite}, isInfinite={infinite}";
}

// Holds the three predicates to one agreed answer about one `double`.
assertDouble(double value, string expected) throws {
    string answered = describe(value.isNaN(), value.isFinite(), value.isInfinite());
    try testing.assertTrue(answered == expected,
        "'double' calls {value} {answered} rather than {expected}");
}

// Holds the three predicates to one agreed answer about one `float`.
assertFloat(float value, string expected) throws {
    string answered = describe(value.isNaN(), value.isFinite(), value.isInfinite());
    try testing.assertTrue(answered == expected,
        "'float' calls {value} {answered} rather than {expected}");
}

// The smallest magnitude a `double` holds, which is a subnormal, reached by halving until one more
// halving would land on zero.
smallestDouble() -> double {
    double value = 1.0;
    while (value * 0.5 > 0.0) {
        value = value * 0.5;
    }
    return value;
}

// The smallest magnitude a `float` holds, which is a subnormal, reached the same way.
smallestFloat() -> float {
    float half = 0.5;
    float zero = 0.0;
    float value = 1.0;
    while (value * half > zero) {
        value = value * half;
    }
    return value;
}

// Every value is a number, an infinity, or a NaN, so the three predicates answer between them and
// never two at once.
test "'double' calls every value a number, an infinity or a NaN" {
    double zero = 0.0;
    double largest = 1.7976931348623157e308;
    // Doubling has to grow this, or the literal is already an infinity and the answers below would
    // all be about the wrong value.
    try testing.assertTrue(largest * 2.0 > largest,
        "the largest finite double is written here as a value that is already infinite");
    try assertDouble(zero / zero, "a NaN");
    try assertDouble(largest * 2.0, "an infinity");
    try assertDouble(largest * -2.0, "an infinity");
    try assertDouble(1.0 / zero, "an infinity");
    try assertDouble(-1.0 / zero, "an infinity");
    try assertDouble(largest, "a number");
    try assertDouble(-largest, "a number");
    try assertDouble(smallestDouble(), "a number");
    try assertDouble(zero, "a number");
    try assertDouble(-0.0, "a number");
    try assertDouble(1.5, "a number");
}

// A `float` answers through the exact widening to `double`, so the narrower type reads the same
// about its own ends.
test "'float' calls every value a number, an infinity or a NaN" {
    float zero = 0.0;
    float one = 1.0;
    float two = 2.0;
    float middling = 1.5;
    float largest = 3.4028234663852886e38 as float;
    // Doubling has to grow this, or the literal is already an infinity and the answers below would
    // all be about the wrong value.
    try testing.assertTrue(largest * two > largest,
        "the largest finite float is written here as a value that is already infinite");
    try assertFloat(zero / zero, "a NaN");
    try assertFloat(largest * two, "an infinity");
    try assertFloat(largest * -two, "an infinity");
    try assertFloat(one / zero, "an infinity");
    try assertFloat(-one / zero, "an infinity");
    try assertFloat(largest, "a number");
    try assertFloat(-largest, "a number");
    try assertFloat(smallestFloat(), "a number");
    try assertFloat(zero, "a number");
    try assertFloat(-zero, "a number");
    try assertFloat(middling, "a number");
}

// A subnormal is a number below the smallest one with a full mantissa, and the halving that
// reaches it must not have landed on zero.
test "the smallest magnitude of each type is a subnormal above zero" {
    try testing.assertTrue(smallestDouble() > 0.0,
        "halving a 'double' to its smallest magnitude reached zero");
    try testing.assertTrue(smallestDouble() < 2.2250738585072014e-308,
        "the smallest 'double' magnitude {smallestDouble()} is not below the smallest normal one");
    float zero = 0.0;
    float smallestNormal = 1.1754943508222875e-38 as float;
    try testing.assertTrue(smallestFloat() > zero,
        "halving a 'float' to its smallest magnitude reached zero");
    try testing.assertTrue(smallestFloat() < smallestNormal,
        "the smallest 'float' magnitude {smallestFloat()} is not below the smallest normal one");
}

// The patterns a reader can check against the IEEE layout by hand: one, the sign bit alone, the
// smallest magnitude, the one NaN the canonical form writes, and two NaNs carrying payloads no
// arithmetic would produce, at each width. They are written out rather than read off the machine,
// since a value's bits are the same on every host.
final class Pattern {
    protected static const ulong one = 0x3FF0000000000000;
    protected static const ulong signBit = 0x8000000000000000;
    protected static const ulong smallest = 0x0000000000000001;
    protected static const ulong canonicalNaN = 0x7FF8000000000000;
    protected static const ulong firstNaN = 0x7FF8DEADBEEF0000;
    protected static const ulong secondNaN = 0xFFF8000000C0FFEE;

    protected static const uint floatOne = 0x3F800000;
    protected static const uint floatSignBit = 0x80000000;
    protected static const uint floatSmallest = 0x00000001;
    protected static const uint floatCanonicalNaN = 0x7FC00000;
    protected static const uint floatFirstNaN = 0x7FC0BEEF;
    protected static const uint floatSecondNaN = 0xFFC00001;
}

// Both zeros, two NaNs of different payloads, both infinities, both ends of the range, a
// subnormal, and ordinary numbers. The infinities come from dividing by zero, while two payloads
// can only be spelled as bits.
spreadOfDoubles() -> double[] {
    double zero = 0.0;
    double largest = 1.7976931348623157e308;
    double infinity = 1.0 / zero;
    return [zero, -zero, 1.0, -1.0, largest, -largest, smallestDouble(), infinity, -infinity,
        double.fromBits(Pattern.firstNaN), double.fromBits(Pattern.secondNaN)];
}

// The same spread at the narrower width.
spreadOfFloats() -> float[] {
    float zero = 0.0;
    float one = 1.0;
    float largest = 3.4028234663852886e38 as float;
    float infinity = one / zero;
    return [zero, -zero, one, -one, largest, -largest, smallestFloat(), infinity, -infinity,
        float.fromBits(Pattern.floatFirstNaN), float.fromBits(Pattern.floatSecondNaN)];
}

test "'double' bits spell the IEEE patterns for one, the zeros and the smallest magnitude" {
    ulong noBits = 0;
    try testing.assertEqual((1.0).toBits(), Pattern.one);
    try testing.assertEqual((0.0).toBits(), noBits);
    try testing.assertEqual((-0.0).toBits(), Pattern.signBit);
    try testing.assertEqual(smallestDouble().toBits(), Pattern.smallest);
}

test "'float' bits spell the IEEE patterns for one, the zeros and the smallest magnitude" {
    uint noBits = 0;
    float one = 1.0;
    float zero = 0.0;
    try testing.assertEqual(one.toBits(), Pattern.floatOne);
    try testing.assertEqual(zero.toBits(), noBits);
    try testing.assertEqual((-zero).toBits(), Pattern.floatSignBit);
    try testing.assertEqual(smallestFloat().toBits(), Pattern.floatSmallest);
}

// The order tells the two zeros apart, so a round trip that lost the sign of a zero fails here
// rather than passing on equality.
test "every value comes back out of its bits, the two zeros included" {
    for (let value in spreadOfDoubles()) {
        double returned = double.fromBits(value.toBits());
        try testing.assertTrue(returned.compareTo(value) == 0,
            "the value at bits {value.toBits()} came back at bits {returned.toBits()}");
    }
    for (let value in spreadOfFloats()) {
        float returned = float.fromBits(value.toBits());
        try testing.assertTrue(returned.compareTo(value) == 0,
            "the value at bits {value.toBits()} came back at bits {returned.toBits()}");
    }
}

// A NaN is the one value with bits to spare, and neither direction reads it as a number, so the
// payload it was built from comes back.
test "a NaN keeps its payload through the bits and back" {
    double doubleNaN = double.fromBits(Pattern.firstNaN);
    try testing.assertTrue(doubleNaN.isNaN(),
        "the pattern {Pattern.firstNaN} did not build a NaN");
    try testing.assertEqual(doubleNaN.toBits(), Pattern.firstNaN);
    float floatNaN = float.fromBits(Pattern.floatFirstNaN);
    try testing.assertTrue(floatNaN.isNaN(),
        "the pattern {Pattern.floatFirstNaN} did not build a NaN");
    try testing.assertEqual(floatNaN.toBits(), Pattern.floatFirstNaN);
}

test "'double' canonical bits write every NaN as one pattern and leave every other value alone" {
    try testing.assertEqual(double.fromBits(Pattern.firstNaN).toCanonicalBits(),
        Pattern.canonicalNaN);
    try testing.assertEqual(double.fromBits(Pattern.secondNaN).toCanonicalBits(),
        Pattern.canonicalNaN);
    for (let value in spreadOfDoubles()) {
        if (!value.isNaN()) {
            try testing.assertEqual(value.toCanonicalBits(), value.toBits());
        }
    }
}

test "'float' canonical bits write every NaN as one pattern and leave every other value alone" {
    try testing.assertEqual(float.fromBits(Pattern.floatFirstNaN).toCanonicalBits(),
        Pattern.floatCanonicalNaN);
    try testing.assertEqual(float.fromBits(Pattern.floatSecondNaN).toCanonicalBits(),
        Pattern.floatCanonicalNaN);
    for (let value in spreadOfFloats()) {
        if (!value.isNaN()) {
            try testing.assertEqual(value.toCanonicalBits(), value.toBits());
        }
    }
}

// What the `equals` and `hash` pair of a struct with a floating-point field rests on: a NaN
// matches a NaN, and the two zeros stay two values.
test "two 'double' values are level in the order exactly when their canonical bits match" {
    let values = spreadOfDoubles();
    for (let left in values) {
        for (let right in values) {
            bool level = left.compareTo(right) == 0;
            bool sameBits = left.toCanonicalBits() == right.toCanonicalBits();
            try testing.assertTrue(level == sameBits,
                "the values at bits {left.toBits()} and {right.toBits()} are level={level} in "
                    + "the order and sameBits={sameBits} in their canonical form");
        }
    }
}

// A `float` reaches the order widened to `double`, which keeps both the sign of a zero and a NaN,
// so the two agree at this width as well.
test "two 'float' values are level in the order exactly when their canonical bits match" {
    let values = spreadOfFloats();
    for (let left in values) {
        for (let right in values) {
            bool level = left.compareTo(right) == 0;
            bool sameBits = left.toCanonicalBits() == right.toCanonicalBits();
            try testing.assertTrue(level == sameBits,
                "the values at bits {left.toBits()} and {right.toBits()} are level={level} in "
                    + "the order and sameBits={sameBits} in their canonical form");
        }
    }
}
