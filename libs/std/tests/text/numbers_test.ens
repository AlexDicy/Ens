// Tests for what this module adds to the number types and to `char`: the radix form of
// `toString`, the decimal form the compiler provides still being there beside it, and the order
// `compareTo` puts two values in. The radix-out-of-range abort is pinned by a fixture, since a
// broken contract ends the program rather than the test.
import @std.testing;

test "every integer type writes a value in another base and keeps its decimal form" {
    byte small = 255;
    short negativeShort = -300;
    ushort wideShort = 65535;
    int negativeInt = -255;
    uint wideInt = 4294967295;
    long negativeLong = -255;
    ulong wideLong = 18446744073709551615;
    try testing.assertEqual(small.toString(16), "ff");
    try testing.assertEqual(small.toString(), "255");
    try testing.assertEqual(negativeShort.toString(16), "-12c");
    try testing.assertEqual(negativeShort.toString(), "-300");
    try testing.assertEqual(wideShort.toString(16), "ffff");
    try testing.assertEqual(wideShort.toString(), "65535");
    try testing.assertEqual(negativeInt.toString(16), "-ff");
    try testing.assertEqual(negativeInt.toString(), "-255");
    try testing.assertEqual(wideInt.toString(16), "ffffffff");
    try testing.assertEqual(wideInt.toString(), "4294967295");
    try testing.assertEqual(negativeLong.toString(16), "-ff");
    try testing.assertEqual(negativeLong.toString(), "-255");
    try testing.assertEqual(wideLong.toString(16), "ffffffffffffffff");
    try testing.assertEqual(wideLong.toString(), "18446744073709551615");
}

test "the bases run from two through thirty-six, in lowercase" {
    try testing.assertEqual(255L.toString(2), "11111111");
    try testing.assertEqual(255L.toString(8), "377");
    try testing.assertEqual(255L.toString(10), "255");
    try testing.assertEqual(255L.toString(16), "ff");
    try testing.assertEqual(255L.toString(36), "73");
    try testing.assertEqual(35L.toString(36), "z");
    try testing.assertEqual(1295L.toString(36), "zz");
}

test "zero is one digit in every base, and a negative value keeps its sign" {
    try testing.assertEqual(0L.toString(2), "0");
    try testing.assertEqual(0L.toString(36), "0");
    try testing.assertEqual((-1L).toString(2), "-1");
    try testing.assertEqual((-255L).toString(16), "-ff");
    try testing.assertEqual((-1295L).toString(36), "-zz");
}

test "the ends of the widest types still read out" {
    long largest = 9223372036854775807;
    long smallest = -9223372036854775808;
    try testing.assertEqual(largest.toString(16), "7fffffffffffffff");
    try testing.assertEqual(largest.toString(36), "1y2p0ij32e8e7");
    // The smallest long has no positive form of its own, so its digits are counted as a magnitude.
    try testing.assertEqual(smallest.toString(16), "-8000000000000000");
    try testing.assertEqual(smallest.toString(36), "-1y2p0ij32e8e8");
    try testing.assertEqual(smallest.toString(2).length, 65L);
}

test "width comes from padStart rather than from an argument of its own" {
    try testing.assertEqual(255L.toString(16).padStart(4, '0'), "00ff");
    try testing.assertEqual(5L.toString(2).padStart(8, '0'), "00000101");
    try testing.assertEqual(255L.toString(16).padStart(2, '0'), "ff");
}

test "every integer type and 'char' order by value" {
    byte small = 2;
    byte large = 200;
    try testing.assertEqual(small.compareTo(large), -1);
    try testing.assertEqual(large.compareTo(small), 1);
    try testing.assertEqual(large.compareTo(large), 0);
    short negativeShort = -300;
    short zeroShort = 0;
    try testing.assertEqual(negativeShort.compareTo(zeroShort), -1);
    int negativeInt = -255;
    int positiveInt = 255;
    try testing.assertEqual(negativeInt.compareTo(positiveInt), -1);
    long smallest = -9223372036854775808;
    long largest = 9223372036854775807;
    try testing.assertEqual(smallest.compareTo(largest), -1);
    try testing.assertEqual(largest.compareTo(smallest), 1);
    try testing.assertEqual('a'.compareTo('b'), -1);
    try testing.assertEqual('b'.compareTo('a'), 1);
    try testing.assertEqual('a'.compareTo('a'), 0);
}

// Each unsigned type's high half has the sign bit of the signed type its bits would spell, so a
// value from there sorting above a small one is what says the comparison is unsigned.
test "an unsigned value above the signed range still sorts above a small one" {
    byte highByte = 200;
    byte oneByte = 1;
    try testing.assertEqual(highByte.compareTo(oneByte), 1);
    ushort highShort = 65535;
    ushort oneShort = 1;
    try testing.assertEqual(highShort.compareTo(oneShort), 1);
    uint highInt = 4294967295;
    uint oneInt = 1;
    try testing.assertEqual(highInt.compareTo(oneInt), 1);
    ulong highLong = 18446744073709551615;
    ulong oneLong = 1;
    try testing.assertEqual(highLong.compareTo(oneLong), 1);
}

// A character orders by codepoint, which is the order its UTF-8 bytes sort in, so a list of
// characters and the text they spell agree about which comes first.
test "'char' order follows the codepoint past ASCII" {
    try testing.assertEqual('é'.compareTo('z'), 1);
    try testing.assertEqual('z'.compareTo('é'), -1);
    try testing.assertEqual('é'.compareTo('€'), -1);
    try testing.assertEqual("é".compareTo("z"), 1);
}
