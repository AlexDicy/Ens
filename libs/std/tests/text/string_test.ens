// Tests for the members of 'string': what each answers, and the edges the design fixes. The aborts
// are pinned by fixtures instead, since a broken contract ends the program rather than the test.
import @std.testing;
import EncodingError from @std.text;
import List from @std.collections.list;

test "empty text is empty and nothing else is" {
    try testing.assertTrue("".isEmpty(), "no bytes at all is empty");
    try testing.assertFalse(" ".isEmpty(), "a space is a byte");
    try testing.assertEqual("".length, 0L);
}

test "search answers the first offset, or -1" {
    try testing.assertEqual("hello".indexOf("l"), 2L);
    try testing.assertEqual("hello".indexOf("lo"), 3L);
    try testing.assertEqual("hello".indexOf("z"), -1L);
    try testing.assertTrue("hello".contains("ell"), "a needle inside the text is found");
    try testing.assertFalse("hello".contains("ELL"), "the search is by exact bytes");
}

test "an empty needle is found at the start, and at the end looking back" {
    try testing.assertEqual("hello".indexOf(""), 0L);
    try testing.assertEqual("".indexOf(""), 0L);
    try testing.assertEqual("hello".lastIndexOf(""), 5L);
    try testing.assertTrue("hello".contains(""), "every text holds the empty needle");
}

test "a search from an offset starts there, and one past the end finds nothing" {
    try testing.assertEqual("hello".indexOf("l", 3), 3L);
    try testing.assertEqual("hello".indexOf("l", 4), -1L);
    try testing.assertEqual("hello".indexOf("h", -4), 0L);
    try testing.assertEqual("hello".indexOf("h", 99), -1L);
    try testing.assertEqual("hello".indexOf("", 99), -1L);
}

test "the last occurrence is found from the end" {
    try testing.assertEqual("banana".lastIndexOf("a"), 5L);
    try testing.assertEqual("banana".lastIndexOf("na"), 4L);
    try testing.assertEqual("banana".lastIndexOf("z"), -1L);
}

test "an edge test compares exactly those bytes" {
    try testing.assertTrue("hello".startsWith("hell"), "the first bytes are the prefix");
    try testing.assertFalse("hello".startsWith("jell"), "other bytes are not");
    try testing.assertTrue("hello".endsWith("llo"), "the last bytes are the suffix");
    try testing.assertFalse("hello".endsWith("hello!"), "a part longer than the text never fits");
    try testing.assertTrue("hello".startsWith(""), "an empty part always matches");
    try testing.assertTrue("hello".endsWith(""), "at either end");
}

test "a substring is the bytes of its range" {
    try testing.assertEqual("hello".substring(1, 3), "el");
    try testing.assertEqual("hello".substring(2), "llo");
    try testing.assertEqual("hello".substring(0, 5), "hello");
    try testing.assertEqual("hello".substring(5), "");
    try testing.assertEqual("hello".substring(2, 2), "");
}

test "a substring keeps whole characters" {
    string text = "héllo";
    try testing.assertEqual(text.length, 6L);
    try testing.assertEqual(text.substring(0, 3), "hé");
    try testing.assertEqual(text.substring(3), "llo");
}

test "trimming drops the whitespace at the ends and nothing inside" {
    try testing.assertEqual("  in the middle  ".trim(), "in the middle");
    try testing.assertEqual("  left".trimStart(), "left");
    try testing.assertEqual("right  ".trimEnd(), "right");
    try testing.assertEqual("\t\n\f\r x \r\f\n\t".trim(), "x");
    try testing.assertEqual("   ".trim(), "");
    try testing.assertEqual("".trim(), "");
    try testing.assertEqual("nothing to drop".trim(), "nothing to drop");
}

test "replacing rewrites every occurrence" {
    try testing.assertEqual("a-b-c".replace("-", "+"), "a+b+c");
    try testing.assertEqual("aaa".replace("aa", "b"), "ba");
    try testing.assertEqual("abc".replace("b", ""), "ac");
    try testing.assertEqual("abc".replace("z", "!"), "abc");
    try testing.assertEqual("abc".replace("", "!"), "abc");
    try testing.assertEqual("one".replace("one", "the other"), "the other");
}

test "repeating gives that many copies, and none for zero" {
    try testing.assertEqual("ab".repeat(3), "ababab");
    try testing.assertEqual("ab".repeat(1), "ab");
    try testing.assertEqual("ab".repeat(0), "");
    try testing.assertEqual("".repeat(5), "");
}

test "padding reaches the width with whole fillers, and leaves wider text alone" {
    try testing.assertEqual("7".padStart(3, '0'), "007");
    try testing.assertEqual("7".padEnd(3, '.'), "7..");
    try testing.assertEqual("wide".padStart(2, '0'), "wide");
    try testing.assertEqual("wide".padEnd(4, '0'), "wide");
    // A filler of several bytes is only ever added whole, so a width its bytes do not divide is
    // approached rather than reached.
    try testing.assertEqual("7".padStart(4, 'é'), "é7");
}

test "splitting gives the parts between the separators" {
    try testing.assertEqual("a,b,c".split(","), ["a", "b", "c"]);
    try testing.assertEqual("a,,b".split(","), ["a", "", "b"]);
    try testing.assertEqual(",a,".split(","), ["", "a", ""]);
    try testing.assertEqual("one".split(","), ["one"]);
    try testing.assertEqual("".split(","), [""]);
    try testing.assertEqual("abc".split(""), ["abc"]);
    try testing.assertEqual("a--b".split("--"), ["a", "b"]);
}

test "lines read the same however the endings are written" {
    try testing.assertEqual("first\nsecond".lines(), ["first", "second"]);
    try testing.assertEqual("first\r\nsecond".lines(), ["first", "second"]);
    try testing.assertEqual("ends\n".lines(), ["ends", ""]);
    try testing.assertEqual("".lines(), [""]);
    try testing.assertEqual("\n".lines(), ["", ""]);
    try testing.assertEqual("only".lines(), ["only"]);
}

test "ASCII case conversion leaves every other byte alone" {
    try testing.assertEqual("Mixed Case 1!".toLowerAscii(), "mixed case 1!");
    try testing.assertEqual("Mixed Case 1!".toUpperAscii(), "MIXED CASE 1!");
    try testing.assertEqual("éÉ".toUpperAscii(), "éÉ");
    try testing.assertEqual("éÉ".toLowerAscii(), "éÉ");
    try testing.assertEqual("éÉ".toLowerAscii().length, 4L);
}

test "ASCII case is ignored on both sides of a comparison, and only for letters" {
    try testing.assertTrue("Hello".equalsIgnoreCaseAscii("hELLO"), "letters fold together");
    try testing.assertFalse("Hello".equalsIgnoreCaseAscii("hello!"), "lengths still have to match");
    try testing.assertTrue("é".equalsIgnoreCaseAscii("é"), "the same bytes always match");
    try testing.assertFalse("É".equalsIgnoreCaseAscii("é"), "other bytes match exactly");
}

test "comparing orders by code point" {
    try testing.assertTrue("a".compareTo("b") < 0, "'a' sorts before 'b'");
    try testing.assertTrue("b".compareTo("a") > 0, "and 'b' after it");
    try testing.assertEqual("a".compareTo("a"), 0);
    try testing.assertTrue("ab".compareTo("abc") < 0, "a prefix sorts before the longer text");
    try testing.assertTrue("Z".compareTo("a") < 0, "capitals sort before lowercase letters");
    try testing.assertTrue("é".compareTo("z") > 0, "and code points above ASCII sort after it");
}

test "a list of text sorts without being told how" {
    let words = new List<string>();
    words.push("pear");
    words.push("apple");
    words.push("fig");
    words.sort();
    try testing.assertEqual(words.toArray(), ["apple", "fig", "pear"]);
}

test "the bytes are handed over as an array of their own" {
    try testing.assertEqual("hi".toBytes(), [0x68 as byte, 0x69 as byte]);
    try testing.assertEqual("é".toBytes().length, 2L);
    try testing.assertEqual("".toBytes().length, 0L);
    byte[] taken = "hi".toBytes();
    taken[0] = 0x48;
    try testing.assertEqual("hi", "hi");
}

test "the byte view walks the bytes where they lie" {
    let seen = new List<long>();
    for (let value in "hé".bytes()) {
        seen.push(value as long);
    }
    try testing.assertEqual(seen.toArray(), [0x68L, 0xC3L, 0xA9L]);
    long counted = 0;
    for (let value in "".bytes()) {
        counted = counted + 1;
    }
    try testing.assertEqual(counted, 0L);
}

test "the character view decodes one character at a time" {
    let seen = new List<string>();
    for (let character in "hé€😀".chars()) {
        seen.push(character.toString());
    }
    try testing.assertEqual(seen.toArray(), ["h", "é", "€", "😀"]);
}

test "a view is walked from the start each time and copies nothing" {
    string text = "abc";
    let view = text.bytes();
    long first = 0;
    for (let value in view) {
        first = first + 1;
    }
    long second = 0;
    for (let value in view) {
        second = second + 1;
    }
    try testing.assertEqual(first, 3L);
    // One view answers a second walk with the same bytes, so nothing about it was consumed.
    try testing.assertEqual(second, 3L);
}

test "text from bytes is refused where the bytes spell no character" {
    let failure = try testing.assertThrows<EncodingError>(() -> {
        byte[] raw = [0x61, 0x62, 0xFF];
        let ignored = try string.fromBytes(raw);
    });
    try testing.assertEqual(failure.offset, 2L);
    try testing.assertTrue(failure.message.contains("offset 2"), "the message names the offset");
}

test "a surrogate, an overlong form and a truncated character are all refused" {
    try assertRefusedAt([0xED as byte, 0xA0 as byte, 0x80 as byte], 0L);
    try assertRefusedAt([0x41 as byte, 0xE0 as byte, 0x80 as byte, 0xAF as byte], 1L);
    try assertRefusedAt([0xE2 as byte, 0x82 as byte], 0L);
    try assertRefusedAt([0xF5 as byte], 0L);
}

test "text from bytes keeps every valid sequence" {
    byte[] raw = [0x68 as byte, 0xC3 as byte, 0xA9 as byte];
    try testing.assertEqual(try string.fromBytes(raw), "hé");
    byte[] none = [];
    try testing.assertEqual(try string.fromBytes(none), "");
}

test "the lossy reading writes one replacement per malformed sequence" {
    byte[] one = [0x61, 0xFF, 0x62];
    try testing.assertEqual(string.fromBytesLossy(one), "a�b");
    byte[] truncated = [0xE2, 0x82];
    try testing.assertEqual(string.fromBytesLossy(truncated), "�");
    byte[] surrogate = [0xED, 0xA0, 0x80];
    try testing.assertEqual(string.fromBytesLossy(surrogate), "���");
    byte[] valid = [0x68, 0xC3, 0xA9];
    try testing.assertEqual(string.fromBytesLossy(valid), "hé");
}

test "joining puts the separator between neighbors and nowhere else" {
    try testing.assertEqual(string.joined(["a", "b", "c"], ", "), "a, b, c");
    try testing.assertEqual(string.joined(["one"], ", "), "one");
    try testing.assertEqual(string.joined([], ", "), "");
    try testing.assertEqual(string.joined(["a", "b"], ""), "ab");
    try testing.assertEqual(string.joined(["", ""], "-"), "-");
}

test "splitting and joining are each other's opposite" {
    string text = "a/b/c";
    try testing.assertEqual(string.joined(text.split("/"), "/"), text);
}

// The bytes are refused, and the offset the failure names is the one expected.
assertRefusedAt(byte[] raw, long offset) throws {
    let failure = try testing.assertThrows<EncodingError>(() -> {
        let ignored = try string.fromBytes(raw);
    });
    try testing.assertEqual(failure.offset, offset);
}
