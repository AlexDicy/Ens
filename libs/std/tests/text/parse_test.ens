// Tests for the parsers: what each reads, and one test per refusal the design names, since a
// parser that guesses is worse than one that says no. The radix-out-of-range abort is pinned by a
// fixture, since a broken contract ends the program rather than the test.
import @std.testing;
import @std.text.parse;

test "a long reads with an optional sign in front of its digits" {
    try testing.assertEqual(parse.parseLong("42"), 42L);
    try testing.assertEqual(parse.parseLong("-7"), -7L);
    try testing.assertEqual(parse.parseLong("+7"), 7L);
    try testing.assertEqual(parse.parseLong("0"), 0L);
    try testing.assertEqual(parse.parseLong("-0"), 0L);
    try testing.assertEqual(parse.parseLong("007"), 7L);
}

test "a long refuses surrounding whitespace" {
    try assertNoLong(" 1");
    try assertNoLong("1 ");
    try assertNoLong("\t1");
    try assertNoLong("1\n");
    try assertNoLong(" ");
}

test "a long refuses a radix prefix" {
    try assertNoLong("0x10");
    try assertNoLong("0X10");
    try assertNoLong("0b101");
    try assertNoLong("0o17");
    try assertNoLong("#10");
}

test "a long refuses digit grouping" {
    try assertNoLong("1_000");
    try assertNoLong("1,000");
    try assertNoLong("1 000");
    try assertNoLong("1'000");
}

test "a long refuses anything else that is not simply digits" {
    try assertNoLong("");
    try assertNoLong("-");
    try assertNoLong("+");
    try assertNoLong("--1");
    try assertNoLong("1-");
    try assertNoLong("1.5");
    try assertNoLong("1e3");
    try assertNoLong("ten");
    try assertNoLong("ff");
}

test "a long reads the ends of its range and refuses a step past them" {
    try testing.assertEqual(parse.parseLong("9223372036854775807"), 9223372036854775807L);
    try testing.assertEqual(parse.parseLong("-9223372036854775808"), -9223372036854775808L);
    try assertNoLong("9223372036854775808");
    try assertNoLong("-9223372036854775809");
    try assertNoLong("99999999999999999999");
}

test "a long in another base reads the digits and the letters of that base" {
    try testing.assertEqual(parse.parseLong("ff", 16), 255L);
    try testing.assertEqual(parse.parseLong("11111111", 2), 255L);
    try testing.assertEqual(parse.parseLong("377", 8), 255L);
    try testing.assertEqual(parse.parseLong("73", 36), 255L);
    try testing.assertEqual(parse.parseLong("-ff", 16), -255L);
    try testing.assertEqual(parse.parseLong("z", 36), 35L);
}

test "a base reads a letter in either case, and refuses a digit that base has not got" {
    try testing.assertEqual(parse.parseLong("FF", 16), 255L);
    try testing.assertEqual(parse.parseLong("Ff", 16), 255L);
    try testing.assertTrue(parse.parseLong("ff", 10) == null, "'f' is no decimal digit");
    try testing.assertTrue(parse.parseLong("2", 2) == null, "base two stops at one");
    try testing.assertTrue(parse.parseLong("8", 8) == null, "base eight stops at seven");
    try testing.assertTrue(parse.parseLong("0x10", 16) == null, "the prefix is still refused");
}

test "what a value writes in a base reads back as that value, in every direction" {
    long[] values = [0, 1, -1, 255, -255, 1000000, 9223372036854775807, -9223372036854775808];
    for (let radix in [2, 8, 16, 36]) {
        for (let value in values) {
            string written = value.toString(radix);
            try testing.assertEqual(parse.parseLong(written, radix), value);
        }
    }
}

test "an int reads what fits an int and refuses what only a long holds" {
    try testing.assertEqual(parse.parseInt("42"), 42);
    try testing.assertEqual(parse.parseInt("-42"), -42);
    try testing.assertEqual(parse.parseInt("2147483647"), 2147483647);
    try testing.assertEqual(parse.parseInt("-2147483648"), -2147483648);
    try testing.assertTrue(parse.parseInt("2147483648") == null, "one past the largest int");
    try testing.assertTrue(parse.parseInt("-2147483649") == null, "one past the smallest int");
    try testing.assertTrue(parse.parseInt(" 42") == null, "whitespace is refused here too");
}

test "a double reads the shape a literal has" {
    try testing.assertEqual(parse.parseDouble("2.5"), 2.5);
    try testing.assertEqual(parse.parseDouble("-2.5"), -2.5);
    try testing.assertEqual(parse.parseDouble("+2.5"), 2.5);
    try testing.assertEqual(parse.parseDouble("3"), 3.0);
    try testing.assertEqual(parse.parseDouble("0.0"), 0.0);
    try testing.assertEqual(parse.parseDouble("1e3"), 1000.0);
    try testing.assertEqual(parse.parseDouble("1E3"), 1000.0);
    try testing.assertEqual(parse.parseDouble("1.5e-2"), 0.015);
    try testing.assertEqual(parse.parseDouble("1.5e+2"), 150.0);
}

test "a double reads back exactly what the text form wrote" {
    double awkward = 0.1 + 0.2;
    try testing.assertEqual(parse.parseDouble(awkward.toString()), awkward);
    try testing.assertEqual(parse.parseDouble((1.0 / 3.0).toString()), 1.0 / 3.0);
    try testing.assertEqual(parse.parseDouble("0.1"), 0.1);
}

test "a double refuses whitespace, grouping, and a shape a literal has not got" {
    try assertNoDouble(" 1.5");
    try assertNoDouble("1.5 ");
    try assertNoDouble("1_0.5");
    try assertNoDouble("1,5");
    try assertNoDouble("");
    try assertNoDouble(".");
    try assertNoDouble(".5");
    try assertNoDouble("5.");
    try assertNoDouble("1.5f");
    try assertNoDouble("1e");
    try assertNoDouble("1e+");
    try assertNoDouble("0x1p3");
    try assertNoDouble("inf");
    try assertNoDouble("nan");
    try assertNoDouble("infinity");
}

test "a double refuses a magnitude it cannot hold and reads a small one as zero" {
    try assertNoDouble("1e400");
    try assertNoDouble("-1e400");
    try testing.assertEqual(parse.parseDouble("1e-400"), 0.0);
}

test "a bool reads true and false spelled exactly that way" {
    try testing.assertEqual(parse.parseBool("true"), true);
    try testing.assertEqual(parse.parseBool("false"), false);
    try testing.assertTrue(parse.parseBool("TRUE") == null, "case is not guessed at");
    try testing.assertTrue(parse.parseBool("True") == null, "nor is a capital");
    try testing.assertTrue(parse.parseBool(" true") == null, "nor is whitespace");
    try testing.assertTrue(parse.parseBool("1") == null, "nor is a number");
    try testing.assertTrue(parse.parseBool("yes") == null, "nor is another word");
    try testing.assertTrue(parse.parseBool("") == null, "nor is nothing at all");
}

assertNoLong(string text) throws {
    try testing.assertTrue(parse.parseLong(text) == null, "'{text}' spells no long");
}

assertNoDouble(string text) throws {
    try testing.assertTrue(parse.parseDouble(text) == null, "'{text}' spells no double");
}
