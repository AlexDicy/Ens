// Tests for StringBuilder: what each append puts in, and that the text it hands back is the bytes
// it was given in the order it was given them.
import @std.testing;
import StringBuilder from @std.text.stringbuilder;

test "a builder starts empty and grows by what it is given" {
    let built = new StringBuilder();
    try testing.assertTrue(built.isEmpty(), "nothing appended yet");
    try testing.assertEqual(built.length(), 0L);
    try testing.assertEqual(built.toString(), "");
    built.append("one");
    built.append("two");
    try testing.assertFalse(built.isEmpty(), "two appends is not empty");
    try testing.assertEqual(built.length(), 6L);
    try testing.assertEqual(built.toString(), "onetwo");
}

test "text longer than the buffer is appended whole" {
    let built = new StringBuilder();
    for (long i = 0; i < 100; i++) {
        built.append("0123456789");
    }
    try testing.assertEqual(built.length(), 1000L);
    try testing.assertEqual(built.toString().substring(990), "0123456789");
}

test "a character is appended as its UTF-8 bytes" {
    let built = new StringBuilder();
    built.append('h');
    built.append('é');
    built.append('€');
    built.append('😀');
    try testing.assertEqual(built.toString(), "hé€😀");
    try testing.assertEqual(built.length(), 1L + 2L + 3L + 4L);
}

test "a number is appended as its decimal text" {
    let built = new StringBuilder();
    built.append(42L);
    built.append(" ");
    built.append(-7L);
    try testing.assertEqual(built.toString(), "42 -7");
}

test "a double is appended as the shortest text that reads back" {
    let built = new StringBuilder();
    built.append(2.5);
    built.append(" ");
    built.append(0.1);
    built.append(" ");
    built.append(0.1 + 0.2);
    try testing.assertEqual(built.toString(), "2.5 0.1 0.30000000000000004");
}

test "a bool is appended as true or false" {
    let built = new StringBuilder();
    built.append(true);
    built.append(" ");
    built.append(false);
    try testing.assertEqual(built.toString(), "true false");
}

test "a line append adds the newline, with or without text before it" {
    let built = new StringBuilder();
    built.appendLine("first");
    built.appendLine();
    built.appendLine("third");
    try testing.assertEqual(built.toString(), "first\n\nthird\n");
}

test "clearing forgets the text and keeps the builder usable" {
    let built = new StringBuilder();
    built.append("thrown away");
    built.clear();
    try testing.assertTrue(built.isEmpty(), "cleared text is gone");
    try testing.assertEqual(built.toString(), "");
    built.append("kept");
    try testing.assertEqual(built.toString(), "kept");
}

test "a builder asked for room holds the same text as one that was not" {
    let reserved = StringBuilder.withCapacity(1024);
    try testing.assertTrue(reserved.isEmpty(), "room is not text");
    reserved.append("exactly this");
    reserved.reserve(4096);
    try testing.assertEqual(reserved.toString(), "exactly this");
}

test "the text read back is the text appended, however often it is read" {
    let built = new StringBuilder();
    built.append("read");
    try testing.assertEqual(built.toString(), "read");
    try testing.assertEqual(built.toString(), "read");
    built.append(" again");
    try testing.assertEqual(built.toString(), "read again");
}
