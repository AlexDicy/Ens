// Tests for splitting a stream of bytes into lines. Every rule is asserted by feeding bytes the way a
// reader would get them - all at once, a few at a time, or ending without an ending - so a line that
// arrives in pieces is checked as precisely as one that arrives whole.
import @std.testing;
import LineBuffer from @std.text.lines;

test "whole lines come out in the order they were fed" {
    let buffer = fed("first\nsecond\nthird\n");
    try assertLine(buffer, "first");
    try assertLine(buffer, "second");
    try assertLine(buffer, "third");
    try assertNoLine(buffer);
    try assertNothingLeft(buffer);
}

test "a line arriving in pieces is one line once its ending is there" {
    let buffer = fed("half");
    try assertNoLine(buffer);
    feed(buffer, " and half");
    try assertNoLine(buffer);
    feed(buffer, "\nnext\n");
    try assertLine(buffer, "half and half");
    try assertLine(buffer, "next");
    try assertNoLine(buffer);
}

test "a carriage return before the newline belongs to the ending" {
    let buffer = fed("windows\r\nposix\n\r\n");
    try assertLine(buffer, "windows");
    try assertLine(buffer, "posix");
    try assertLine(buffer, "");
    try assertNoLine(buffer);
}

test "text that does not end in a newline is the last line, given up once" {
    let buffer = fed("whole\npartial");
    try assertLine(buffer, "whole");
    try assertNoLine(buffer);
    try assertRest(buffer, "partial");
    try assertNothingLeft(buffer);
}

test "a carriage return with no newline after it is text, not an ending" {
    let buffer = fed("torn\r");
    try assertRest(buffer, "torn\r");
}

test "an empty line between two endings is a line of its own" {
    let buffer = fed("one\n\ntwo\n");
    try assertLine(buffer, "one");
    try assertLine(buffer, "");
    try assertLine(buffer, "two");
    try assertNoLine(buffer);
}

test "a buffer says whether a whole line is in hand before it is taken" {
    let buffer = new LineBuffer();
    try testing.assertFalse(buffer.holdsLine(), "nothing has been fed yet");
    feed(buffer, "half");
    try testing.assertFalse(buffer.holdsLine(), "no ending has arrived to close the line");
    feed(buffer, " and half\nnext");
    try testing.assertTrue(buffer.holdsLine(), "the ending arrived with the rest of the line");
    try assertLine(buffer, "half and half");
    try testing.assertFalse(buffer.holdsLine(), "what is left over closes no line");
    feed(buffer, "\n");
    try testing.assertTrue(buffer.holdsLine(), "the ending of the line left over arrived");
    try assertLine(buffer, "next");
    try testing.assertFalse(buffer.holdsLine(), "every line has been taken");
}

test "nothing fed at all leaves no line and nothing over" {
    let buffer = new LineBuffer();
    try assertNoLine(buffer);
    try assertNothingLeft(buffer);
}

test "a line longer than the buffer started with grows it" {
    let buffer = new LineBuffer();
    string wide = repeated("0123456789", 100);
    feed(buffer, wide);
    feed(buffer, "\ntail\n");
    try assertLine(buffer, wide);
    try assertLine(buffer, "tail");
    try assertNoLine(buffer);
}

test "bytes already taken as lines make room for the ones still coming" {
    let buffer = new LineBuffer();
    for (long i = 0; i < 200; i++) {
        feed(buffer, "line {i}\n");
        try assertLine(buffer, "line {i}");
    }
    try testing.assertEqual(buffer.pending(), 0L);
}

test "text outside ASCII survives being split at a line ending" {
    let buffer = fed("héllo wörld\n日本語\n");
    try assertLine(buffer, "héllo wörld");
    try assertLine(buffer, "日本語");
}

test "a character split across two feeds is put back together" {
    let buffer = new LineBuffer();
    byte[] bytes = "é".toBytes();
    buffer.feed(bytes.slice(0, 1), 1);
    buffer.feed(bytes.slice(1, 2), 1);
    feed(buffer, "\n");
    try assertLine(buffer, "é");
}

// A buffer holding `text`, fed as one read.
fed(string text) -> LineBuffer {
    let buffer = new LineBuffer();
    feed(buffer, text);
    return buffer;
}

feed(LineBuffer buffer, string text) {
    byte[] bytes = text.toBytes();
    buffer.feed(bytes, bytes.length);
}

repeated(string text, long times) -> string {
    string built = "";
    for (long i = 0; i < times; i++) {
        built = built + text;
    }
    return built;
}

assertLine(LineBuffer buffer, string expected) throws {
    try testing.assertEqual(buffer.take() ?? "<no whole line>", expected);
}

assertNoLine(LineBuffer buffer) throws {
    try testing.assertTrue(buffer.take() == null, "no whole line should be there yet");
}

assertRest(LineBuffer buffer, string expected) throws {
    try testing.assertEqual(buffer.rest() ?? "<nothing left over>", expected);
}

assertNothingLeft(LineBuffer buffer) throws {
    try testing.assertTrue(buffer.rest() == null, "nothing should be left over");
}
