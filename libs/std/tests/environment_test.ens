// Tests for what '@std.environment' reports about the running program, and for the name matching
// an Environment applies, which is a rule about the values and so is checked for every system from
// whichever one runs the tests.
import @std.testing;
import Path from @std.fs;
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;
import @std.system;

test "the platform is one of the systems the compiler builds for" {
    string named = switch (environment.platform()) {
        Platform.Windows -> "windows",
        Platform.Linux -> "linux",
        Platform.MacOS -> "macos",
    };
    try testing.assertTrue(named.length > 0, "every member of Platform has an answer here");
}

// The path of the running program is the one thing that says which program this is, so what it
// answers has to name a real file that is there while the test runs.
test "the executable path names the program that is running" {
    Path? me = environment.executablePath();
    if (me == null) {
        try testing.fail("this system would not report the path of the running program");
    } else {
        try testing.assertTrue(me.isAbsolute(), "'{me}' names its place on its own");
        try testing.assertTrue(me.isFile(), "'{me}' is a file that is there");
        try testing.assertTrue(me.fileName().length > 0, "'{me}' ends in a name");
        try testing.assertFalse(me.toString().contains("\\"),
            "'{me}' still holds a native separator");
    }
}

// Every system passes the program's own name as the first entry of the vector it starts a program
// with, and that entry is the one this call leaves out. The raw vector is read here because it is
// the only thing that knows what the first entry was.
test "the arguments leave out the program's own name" {
    string[] raw = system.argumentVector();
    string[] given = environment.arguments();
    try testing.assertEqual(given.length, raw.length - 1);
    for (long i = 0; i < given.length; i++) {
        try testing.assertEqual(given[i], raw[i + 1]);
    }
    Path? me = environment.executablePath();
    if (me != null) {
        try testing.assertEqual(Path.fromNative(raw[0], environment.platform()).fileName(),
            me.fileName());
    }
}

test "the working directory is an absolute path written with '/'" {
    Path here = environment.currentDirectory();
    try testing.assertTrue(here.isAbsolute(), "'{here}' names its place on its own");
    try testing.assertTrue(here.isDirectory(), "'{here}' is a directory that is there");
    try testing.assertFalse(here.toString().contains("\\"),
        "'{here}' still holds a native separator");
}

// PATH is written 'Path' on Windows and 'PATH' everywhere else, so one inherited snapshot asked
// for one spelling answering on all three systems is the matching rule working end to end.
test "the inherited snapshot holds the variables this process was given" {
    let inherited = Environment.current();
    try testing.assertFalse(inherited.isEmpty(), "a process is given variables");
    try testing.assertTrue(inherited.length() > 0, "a process is given variables");
    try testing.assertEqual(inherited.platform(), environment.platform());
    try testing.assertTrue(inherited.contains("PATH"),
        "a process is given a PATH, whichever way this system spells it");
    try testing.assertTrue(inherited.get("PATH") != null, "and it has a value");
}

// An inherited name is never empty, which Windows makes worth pinning: it keeps a few entries
// whose text starts with '=' and which name no variable a program can read.
test "no inherited variable has an empty name" {
    let inherited = Environment.current();
    for (let name in inherited.names()) {
        try testing.assertTrue(name.length > 0, "an inherited name is never empty");
        try testing.assertFalse(name.startsWith("="), "'{name}' names no variable");
    }
}

test "changing a snapshot changes nothing outside it" {
    let first = Environment.current();
    long before = first.length();
    first.set("ENS_STD_ENVIRONMENT_TEST", "written");
    try testing.assertEqual(first.length(), before + 1);
    try testing.assertEqual(first.get("ENS_STD_ENVIRONMENT_TEST"), "written");

    let second = Environment.current();
    try testing.assertEqual(second.length(), before);
    try testing.assertTrue(second.get("ENS_STD_ENVIRONMENT_TEST") == null,
        "a second snapshot never saw the first one's write");
}

test "an empty set holds nothing until something is written to it" {
    let variables = Environment.empty(Platform.Linux);
    try testing.assertTrue(variables.isEmpty(), "an empty set holds nothing");
    try testing.assertEqual(variables.length(), 0L);
    try testing.assertEqual(variables.names(), []);
    try testing.assertFalse(variables.contains("PATH"), "and nothing is in it");
    try testing.assertTrue(variables.get("PATH") == null, "and nothing has a value");

    variables.set("PATH", "/usr/bin");
    try testing.assertFalse(variables.isEmpty(), "one write is enough to stop being empty");
    try testing.assertEqual(variables.length(), 1L);
    try testing.assertEqual(variables.names(), ["PATH"]);
    try testing.assertEqual(variables.get("PATH"), "/usr/bin");
}

// The matching is a rule about the values, so a set built for Windows matches names by case
// wherever the test runs, and one built for Linux never does.
test "a windows set matches two names differing only in case" {
    let variables = Environment.empty(Platform.Windows);
    variables.set("PATH", "/usr/bin");
    try testing.assertEqual(variables.get("path"), "/usr/bin");
    try testing.assertEqual(variables.get("Path"), "/usr/bin");
    try testing.assertTrue(variables.contains("pAtH"), "every spelling is the same variable");
    try testing.assertEqual(variables.length(), 1L);

    // The second write replaces the first, and the name last written is the name read back.
    variables.set("path", "/bin");
    try testing.assertEqual(variables.length(), 1L);
    try testing.assertEqual(variables.get("PATH"), "/bin");
    try testing.assertEqual(variables.names(), ["path"]);
    try testing.assertTrue(variables.remove("PATH"), "one spelling removes the variable");
    try testing.assertTrue(variables.isEmpty(), "and nothing is left");
}

test "a linux set keeps two names differing only in case apart" {
    let variables = Environment.empty(Platform.Linux);
    variables.set("PATH", "/usr/bin");
    variables.set("path", "/bin");
    try testing.assertEqual(variables.length(), 2L);
    try testing.assertEqual(variables.get("PATH"), "/usr/bin");
    try testing.assertEqual(variables.get("path"), "/bin");
    try testing.assertEqual(variables.names(), ["PATH", "path"]);
    try testing.assertTrue(variables.remove("PATH"), "one name is removed on its own");
    try testing.assertEqual(variables.names(), ["path"]);
}

test "a macos set keeps two names differing only in case apart" {
    let variables = Environment.empty(Platform.MacOS);
    variables.set("PATH", "/usr/bin");
    variables.set("path", "/bin");
    try testing.assertEqual(variables.length(), 2L);
    try testing.assertEqual(variables.get("PATH"), "/usr/bin");
    try testing.assertEqual(variables.get("path"), "/bin");
}

// A set that matches names by one system's rule can say which system it means, so a caller holding
// the set need not carry the answer alongside it.
test "a set says which system's rule it matches names by" {
    try testing.assertEqual(Environment.empty(Platform.Windows).platform(), Platform.Windows);
    try testing.assertEqual(Environment.empty(Platform.Linux).platform(), Platform.Linux);
    try testing.assertEqual(Environment.empty(Platform.MacOS).platform(), Platform.MacOS);
    try testing.assertEqual(Environment.empty(Platform.Windows).copy().platform(),
        Platform.Windows);
}

test "removing answers whether the variable was there" {
    let variables = Environment.empty(Platform.Linux);
    variables.set("ONE", "1");
    try testing.assertTrue(variables.remove("ONE"), "the variable was there");
    try testing.assertFalse(variables.remove("ONE"), "and it is not there a second time");
    try testing.assertFalse(variables.remove("NEVER_WRITTEN"), "nothing was ever written there");
}

test "a variable can hold an empty value, which is not the same as being absent" {
    let variables = Environment.empty(Platform.Linux);
    variables.set("EMPTY", "");
    try testing.assertTrue(variables.contains("EMPTY"), "the variable is there");
    try testing.assertEqual(variables.get("EMPTY"), "");
    try testing.assertEqual(variables.length(), 1L);
}

test "the names come back in ascending byte order" {
    let variables = Environment.empty(Platform.Linux);
    variables.set("beta", "2");
    variables.set("Alpha", "1");
    variables.set("gamma", "3");
    variables.set("ALPHA", "0");
    try testing.assertEqual(variables.names(), ["ALPHA", "Alpha", "beta", "gamma"]);
}

test "a copy holds the same variables and changing either leaves the other alone" {
    let original = Environment.empty(Platform.Linux);
    original.set("ONE", "1");
    original.set("TWO", "2");
    let copied = original.copy();
    try testing.assertEqual(copied.names(), ["ONE", "TWO"]);
    try testing.assertEqual(copied.get("ONE"), "1");

    copied.set("THREE", "3");
    let removed = original.remove("ONE");
    try testing.assertEqual(copied.names(), ["ONE", "THREE", "TWO"]);
    try testing.assertEqual(original.names(), ["TWO"]);
}
