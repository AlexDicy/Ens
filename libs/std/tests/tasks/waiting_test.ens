// Tests for waiters, wait lists and timers: a waiter is woken once and sleeps until its deadline,
// a wait list wakes the waiter that has waited longest and skips one already woken, and timers
// fire in deadline order.
import @std.testing;
import Atomic from @std.tasks;
import Channel from @std.tasks;
import Sender from @std.tasks;
import ChannelClosed from @std.tasks;
import Cancelled from @std.tasks;
import Clockwork from @std.tasks.waiting;
import Waiter from @std.tasks.waiting;
import WaitList from @std.tasks.waiting;
import @std.system;

test "a waiter for a thread is woken once, and a wait after the wake returns at once" {
    let waiter = new Waiter(null);
    try testing.assertFalse(waiter.isWoken(), "a new waiter counts as woken");
    try testing.assertTrue(waiter.wake(), "the first wake was not the one that woke it");
    try testing.assertFalse(waiter.wake(), "a second wake claimed to wake it");
    long before = system.monotonicMillis();
    waiter.await(before + 5000);
    try testing.assertTrue(system.monotonicMillis() - before < 1000,
        "a woken waiter waited for its deadline");
}

test "a waiter for a thread sleeps until its deadline when nothing wakes it" {
    let waiter = new Waiter(null);
    long before = system.monotonicMillis();
    waiter.await(before + 20);
    try testing.assertTrue(system.monotonicMillis() - before >= 20,
        "the waiter returned before its deadline");
    try testing.assertFalse(waiter.isWoken(), "a deadline counted as a wake");
}

test "a wait list wakes the waiter that has waited longest, skipping one already woken" {
    let list = new WaitList();
    let first = new Waiter(null);
    let second = new Waiter(null);
    let third = new Waiter(null);
    list.add(first);
    list.add(second);
    list.add(third);
    let woke = first.wake();
    list.wakeOne();
    try testing.assertTrue(second.isWoken(), "the longest waiting unwoken waiter was skipped");
    try testing.assertFalse(third.isWoken(), "a later waiter was woken ahead of its turn");
    list.wakeAll();
    try testing.assertTrue(third.isWoken(), "waking all left a waiter asleep");
}

test "timers fire in deadline order, however they were added" {
    let fired = new Channel<long>(8);
    let out = fired.sender();
    long now = system.monotonicMillis();
    Clockwork.timers.runAt(now + 60, () -> report(out, 3));
    Clockwork.timers.runAt(now + 20, () -> report(out, 1));
    Clockwork.timers.runAt(now + 40, () -> report(out, 2));
    try testing.assertEqual(try fired.receive(2000) ?? -1L, 1L);
    try testing.assertEqual(try fired.receive(2000) ?? -1L, 2L);
    try testing.assertEqual(try fired.receive(2000) ?? -1L, 3L);
}

report(Sender<long> out, long which) {
    try out.send(which);
} catch (ChannelClosed closed) {
} catch (Cancelled stop) {
}
