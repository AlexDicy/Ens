// Tests for the boundary conversion '@std.path' offers. Everything else in that module is a rule
// about '/' form text and is exercised by every program that reads a path; what belongs here is the
// one function that has to answer differently for different systems, so both answers are pinned on
// whichever system runs the tests.
import @std.testing;
import @std.path;

test "a Windows path becomes one written with '/'" {
    try testing.assertEqual(path.fromNative("C:\\Users\\Alex\\notes.txt", "windows"),
        "C:/Users/Alex/notes.txt");
    try testing.assertEqual(path.fromNative("src\\main.ens", "windows"), "src/main.ens");
    try testing.assertEqual(path.fromNative("\\\\server\\share\\file", "windows"),
        "//server/share/file");
    try testing.assertEqual(path.fromNative("\\", "windows"), "/");
}

// The case the design turns on: '\' is an ordinary character in a POSIX name, so converting it would
// name a different file. A path from a POSIX system therefore comes back byte for byte.
test "a backslash in a POSIX name survives untouched" {
    for (let posix in ["linux", "macos"]) {
        try testing.assertEqual(path.fromNative("/home/alex/odd\\name.txt", posix),
            "/home/alex/odd\\name.txt");
        try testing.assertEqual(path.fromNative("a\\b\\c", posix), "a\\b\\c");
        try testing.assertEqual(path.fromNative("\\", posix), "\\");
        try testing.assertEqual(path.fromNative("/usr/local/bin", posix), "/usr/local/bin");
    }
}

test "a path already written with '/' is unchanged on every platform" {
    for (let name in ["windows", "linux", "macos"]) {
        try testing.assertEqual(path.fromNative("C:/Users/Alex/notes.txt", name),
            "C:/Users/Alex/notes.txt");
        try testing.assertEqual(path.fromNative("src/main.ens", name), "src/main.ens");
        try testing.assertEqual(path.fromNative("", name), "");
        try testing.assertEqual(path.fromNative(".", name), ".");
    }
}

// A name this module does not know is treated as the systems that keep '\', because converting a
// name that may be a legitimate one is the answer that loses information.
test "a platform nobody named keeps the text as it came" {
    try testing.assertEqual(path.fromNative("a\\b", "plan9"), "a\\b");
    try testing.assertEqual(path.fromNative("a\\b", ""), "a\\b");
    try testing.assertEqual(path.fromNative("a\\b", "Windows"), "a\\b");
}

test "the conversion feeds the rest of the module" {
    string converted = path.fromNative("C:\\Users\\Alex\\src\\.\\main.ens", "windows");
    try testing.assertEqual(path.normalize(converted), "C:/Users/Alex/src/main.ens");
    try testing.assertEqual(path.fileName(converted), "main.ens");
    try testing.assertEqual(path.stem(converted), "main");
    try testing.assertEqual(path.extension(converted), "ens");
    try testing.assertTrue(path.isAbsolute(converted), "a drive letter names a place on its own");
    try testing.assertEqual(path.parentFolder(path.normalize(converted)), "C:/Users/Alex/src");
}

test "a path the running system reported needs no conversion" {
    string reported = "C:/Users/Alex";
    try testing.assertEqual(path.fromNative(reported, "windows"), reported);
}
