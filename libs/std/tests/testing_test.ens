// Tests for the failure type and the assertions, and what a failure's message points at.
import @std.testing;
import TestFailure from @std.testing;

class Boom extends Error {
    protected constructor(string message) {
        super(message);
    }
}

raiseBoom() throws Boom {
    throw new Boom("bang");
}

// The message a failing body raises, asserted through assertThrows itself.
failureMessage((() -> void throws TestFailure) body) -> string throws {
    let failure = try testing.assertThrows<TestFailure>(body);
    return failure.message;
}

// A nullable the compiler cannot narrow, so the assertion under test sees 'string?' itself.
maybeText(bool wanted) -> string? {
    if (wanted) {
        return "hi";
    }
    return null;
}

test "assertEqual stays silent on equal values and names both on short ones" {
    try testing.assertEqual(3, 3);
    try testing.assertEqual("same", "same");
    try testing.assertEqual([1, 2], [1, 2]);
    let message = try failureMessage(() -> { try testing.assertEqual(3, 4); });
    try testing.assertEqual(message, "expected 4, got 3");
}

test "assertEqual compares nullable values and prints an absent one as null" {
    string? present = maybeText(true);
    string? absent = maybeText(false);
    try testing.assertEqual<string?>(present, "hi");
    try testing.assertEqual<string?>(absent, null);
    try testing.assertEqual<int?>(null, null);
    let message = try failureMessage(() -> {
        try testing.assertEqual<string?>(maybeText(false), "hi");
    });
    try testing.assertEqual(message, "expected hi, got null");
    let other = try failureMessage(() -> {
        try testing.assertEqual<string?>(maybeText(true), null);
    });
    try testing.assertEqual(other, "expected null, got hi");
}

test "assertEqual points at the first line that differs in multi-line text" {
    let message = try failureMessage(() -> {
        try testing.assertEqual("one\ntwo\nthree", "one\ntzo\nthree");
    });
    try testing.assertEqual(message, "line 2 differs\nexpected: tzo\nactual:   two");
}

test "assertEqual names the line where one value runs out" {
    let missing = try failureMessage(() -> {
        try testing.assertEqual("one\ntwo", "one\ntwo\nthree");
    });
    try testing.assertEqual(missing,
        "line 3 is missing\nexpected: three\nactual ends after line 2");
    let extra = try failureMessage(() -> {
        try testing.assertEqual("one\ntwo", "one");
    });
    try testing.assertEqual(extra,
        "line 2 is extra\nactual: two\nexpected ends after line 1");
}

test "assertEqual points at the offset in long single-line text, cut at codepoint boundaries" {
    string actual = "the quick brown fox jumps over the lazy dog and then é keeps on running";
    string expected = "the quick brown fox jumps over the lazy dog and then è keeps on running";
    let message = try failureMessage(() -> { try testing.assertEqual(actual, expected); });
    try testing.assertEqual(message, "values differ at offset 54\n"
        + "expected: ... the lazy dog and then è keeps on running\n"
        + "actual:   ... the lazy dog and then é keeps on running");
}

test "unequal values that print alike are called out instead of shown twice" {
    let left = new Boom("twin");
    let right = new Boom("twin");
    let message = try failureMessage(() -> { try testing.assertEqual(left, right); });
    try testing.assertEqual(message,
        "the values are not equal, even though both print as twin");
}

test "assertNotEqual passes on differing values and reports the shared one, bounded" {
    try testing.assertNotEqual(3, 4);
    let message = try failureMessage(() -> { try testing.assertNotEqual("x", "x"); });
    try testing.assertEqual(message, "expected values to differ, both were x");
    string tall = "first line\nsecond line";
    let multi = try failureMessage(() -> { try testing.assertNotEqual(tall, tall); });
    try testing.assertEqual(multi, "expected values to differ, both were first line...");
    string wide = "a value that runs on and on far past the sixty byte width the message is cut to";
    let wideMessage = try failureMessage(() -> { try testing.assertNotEqual(wide, wide); });
    try testing.assertEqual(wideMessage,
        "expected values to differ, both were a value that runs on and on far past the sixty "
        + "byte width th...");
}

test "matching lines with differing endings are named instead of claimed to agree" {
    let message = try failureMessage(() -> {
        try testing.assertEqual("one\r\ntwo\r\nthree", "one\ntwo\nthree");
    });
    try testing.assertEqual(message,
        "every line matches, so the values differ only in their line endings");
}

test "assertTrue and assertFalse raise the caller's message" {
    try testing.assertTrue(true);
    try testing.assertFalse(false);
    let message = try failureMessage(() -> {
        try testing.assertTrue(false, "the flag should hold");
    });
    try testing.assertEqual(message, "the flag should hold");
    let fallback = try failureMessage(() -> { try testing.assertFalse(true); });
    try testing.assertEqual(fallback, "expected condition to be false");
}

test "fail raises its message and returns to no one" {
    let message = try failureMessage(() -> { try testing.fail("stopped on purpose"); });
    try testing.assertEqual(message, "stopped on purpose");
}

test "assertNear accepts the tolerance boundary and refuses beyond it, NaN included" {
    try testing.assertNear(1.0, 1.05, 0.1);
    try testing.assertNear(2.0, 1.5, 0.5);
    let message = try failureMessage(() -> { try testing.assertNear(1.0, 1.2, 0.1); });
    try testing.assertEqual(message, "expected 1.2 within 0.1, got 1");
    double sour = 0.0 / 0.0;
    let nan = try failureMessage(() -> { try testing.assertNear(sour, sour, 1000.0); });
    try testing.assertEqual(nan, "expected nan within 1000, got nan");
    double far = 1.0 / 0.0;
    try testing.assertNear(far, far, 0.0);
    try testing.assertNear(-far, -far, 0.0);
    let apart = try failureMessage(() -> { try testing.assertNear(far, -far, 1000.0); });
    try testing.assertEqual(apart, "expected -inf within 1000, got inf");
}

test "assertThrows answers the caught error and fails when the body returns" {
    let caught = try testing.assertThrows<Boom>(() -> { try raiseBoom(); });
    try testing.assertEqual(caught.message, "bang");
    let message = try failureMessage(() -> {
        let ignored = try testing.assertThrows<Boom>(() -> { });
    });
    try testing.assertEqual(message, "expected the body to throw, and it returned instead");
}

test "assertThrows tells a thrown TestFailure apart from its own no-throw failure" {
    let thrown = try testing.assertThrows<TestFailure>(() -> {
        try testing.fail("deliberate");
    });
    try testing.assertEqual(thrown.message, "deliberate");
}

test "a failure built in response to another error carries it as the cause" {
    let caught = try testing.assertThrows<Boom>(() -> { try raiseBoom(); });
    let failure = new TestFailure("wrapped", caught);
    try testing.assertEqual(failure.message, "wrapped");
    let cause = failure.cause;
    try testing.assertTrue(cause != null, "the cause is kept");
    if (cause != null) {
        try testing.assertEqual(cause.message, "bang");
    }
    try testing.assertEqual(failure.toString(), "wrapped\ncaused by Boom: bang");
}
