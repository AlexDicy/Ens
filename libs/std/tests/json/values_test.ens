// Value tree tests: accessors, number conversion, array and object content, equality. The abort
// on a NaN is a fixture, since a panic ends the program.
import List from @std.collections.list;
import Json from @std.json;
import JsonArray from @std.json;
import JsonBool from @std.json;
import JsonError from @std.json;
import JsonNull from @std.json;
import JsonNumber from @std.json;
import JsonObject from @std.json;
import JsonString from @std.json;
import @std.testing;

test "each kind answers its own accessor and null to every other" {
    Json none = new JsonNull();
    Json flag = new JsonBool(true);
    Json number = JsonNumber.of(7L);
    Json text = new JsonString("seven");
    Json array = new JsonArray();
    Json object = new JsonObject();

    try testing.assertTrue(none.isNull());
    try testing.assertFalse(flag.isNull());
    try testing.assertEqual(flag.asBool(), true);
    try testing.assertEqual(none.asBool(), null);
    try testing.assertEqual(number.asLong(), 7L);
    try testing.assertEqual(number.asDouble(), 7.0);
    try testing.assertEqual(text.asLong(), null);
    try testing.assertEqual(text.asDouble(), null);
    try testing.assertEqual(text.asString(), "seven");
    try testing.assertEqual(number.asString(), null);
    try testing.assertTrue(array.asArray() != null);
    try testing.assertTrue(object.asArray() == null);
    try testing.assertTrue(object.asObject() != null);
    try testing.assertTrue(array.asObject() == null);
}

test "a number made from a long or a double keeps the text the value prints as" {
    try testing.assertEqual(JsonNumber.of(42L).text, "42");
    try testing.assertEqual(JsonNumber.of(-9223372036854775808L).text, "-9223372036854775808");
    try testing.assertEqual(JsonNumber.of(2.5).text, "2.5");
    try testing.assertEqual(JsonNumber.of(3.0).text, "3");
    try testing.assertEqual(JsonNumber.of(-0.0).text, "-0");
    try testing.assertEqual(JsonNumber.of(1e21).text, "1e+21");
    try testing.assertEqual(JsonNumber.of(0.00001).text, "1e-05");
    try testing.assertEqual(JsonNumber.of(0.1 + 0.2).text, "0.30000000000000004");
}

test "a number reads as a long only when it is a whole number a long holds" {
    try testing.assertEqual(try number("0").asLong(), 0L);
    try testing.assertEqual(try number("-0").asLong(), 0L);
    try testing.assertEqual(try number("9223372036854775807").asLong(), 9223372036854775807L);
    try testing.assertEqual(try number("9223372036854775808").asLong(), null);
    try testing.assertEqual(try number("1.0").asLong(), null);
    try testing.assertEqual(try number("1e2").asLong(), null);
}

test "a number reads as the nearest double, or null past the range a double holds" {
    try testing.assertEqual(try number("1.5e3").asDouble(), 1500.0);
    try testing.assertEqual(try number("-2").asDouble(), -2.0);
    try testing.assertEqual(try number("123456789012345678901234567890").asDouble(),
        1.2345678901234568e29);
    try testing.assertEqual(try number("1e400").asDouble(), null);
    try testing.assertEqual(try number("1e-400").asDouble(), 0.0);
}

test "an array keeps its elements in order and is walked in it" {
    let array = new JsonArray();
    array.push(JsonNumber.of(1L));
    array.push(new JsonString("two"));
    array.push(new JsonNull());
    try testing.assertEqual(array.length(), 3L);
    try testing.assertFalse(array.isEmpty());
    try testing.assertEqual(array.get(1).asString(), "two");
    array.set(1, JsonNumber.of(2L));
    try testing.assertEqual(array.get(1).asLong(), 2L);
    try testing.assertTrue(array.removeAt(2).isNull());

    let seen = new List<string>();
    for (let element in array) {
        seen.push(element.toString());
    }
    try testing.assertEqual(seen.toArray(), ["1", "2"]);

    let built = JsonArray.of([new JsonBool(true), new JsonBool(false)]);
    try testing.assertEqual(built.length(), 2L);
    try testing.assertEqual(built.get(1).asBool(), false);
    built.clear();
    try testing.assertTrue(built.isEmpty());
}

test "an object keeps members in the order they were added, and a replaced one keeps its place" {
    let object = new JsonObject();
    object.set("b", JsonNumber.of(1L));
    object.set("a", JsonNumber.of(2L));
    object.set("b", JsonNumber.of(3L));
    try testing.assertEqual(object.length(), 2L);
    try testing.assertTrue(object.contains("a"));
    try testing.assertFalse(object.contains("c"));
    try testing.assertEqual(object.get("b")?.asLong(), 3L);
    try testing.assertEqual(object.get("c")?.asLong(), null);

    let keys = new List<string>();
    for (let key in object.keys()) {
        keys.push(key);
    }
    try testing.assertEqual(keys.toArray(), ["b", "a"]);

    let walked = new List<string>();
    for (let member in object) {
        walked.push("{member.key}={member.value}");
    }
    try testing.assertEqual(walked.toArray(), ["b=3", "a=2"]);

    try testing.assertTrue(object.remove("b"));
    try testing.assertFalse(object.remove("b"));
    try testing.assertEqual(object.length(), 1L);
    try testing.assertEqual(object.toString(), "\{\"a\": 2\}");
}

test "values are equal when they are the same kind with the same content" {
    try testing.assertEqual<Json>(new JsonNull(), new JsonNull());
    try testing.assertEqual<Json>(new JsonBool(true), new JsonBool(true));
    try testing.assertNotEqual<Json>(new JsonBool(true), new JsonBool(false));
    try testing.assertEqual<Json>(JsonNumber.of(1L), try number("1"));
    try testing.assertNotEqual<Json>(JsonNumber.of(1L), try number("1.0"));
    try testing.assertNotEqual<Json>(JsonNumber.of(1L), new JsonString("1"));
    try testing.assertEqual<Json>(new JsonString("a"), new JsonString("a"));
    try testing.assertNotEqual<Json>(new JsonNull(), new JsonBool(false));
}

test "arrays are equal element by element and hash alike when equal" {
    let left = try Json.parse("[1, [2, \"x\"], null]");
    let right = try Json.parse("[1, [2, \"x\"], null]");
    try testing.assertEqual(left, right);
    try testing.assertEqual(left.hash(), right.hash());
    try testing.assertNotEqual(left, try Json.parse("[1, [2, \"y\"], null]"));
    try testing.assertNotEqual(left, try Json.parse("[1, [2, \"x\"]]"));
}

test "objects are equal whatever order their members are in, and hash alike" {
    let left = try Json.parse("\{\"a\": 1, \"b\": [true]\}");
    let right = try Json.parse("\{\"b\": [true], \"a\": 1\}");
    try testing.assertEqual(left, right);
    try testing.assertEqual(left.hash(), right.hash());
    try testing.assertNotEqual(left, try Json.parse("\{\"a\": 1\}"));
    try testing.assertNotEqual(left, try Json.parse("\{\"a\": 1, \"c\": [true]\}"));
    try testing.assertNotEqual(left, try Json.parse("\{\"a\": 2, \"b\": [true]\}"));
}

number(string text) -> Json throws JsonError {
    return try Json.parse(text);
}
