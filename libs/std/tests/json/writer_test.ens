// Writer tests: the one-line form and its match with struct printing, the indented form,
// escaping, and round trips.
import Json from @std.json;
import JsonArray from @std.json;
import JsonBool from @std.json;
import JsonError from @std.json;
import JsonNull from @std.json;
import JsonNumber from @std.json;
import JsonObject from @std.json;
import JsonString from @std.json;
import @std.testing;

struct Sample {
    string name;
    int count;
    bool enabled;
    double? ratio;
    int[] sizes;
    string[] tags;
}

test "each kind writes as its JSON text on one line" {
    try testing.assertEqual(new JsonNull().toString(), "null");
    try testing.assertEqual(new JsonBool(true).toString(), "true");
    try testing.assertEqual(new JsonBool(false).toString(), "false");
    try testing.assertEqual(JsonNumber.of(-12L).toString(), "-12");
    try testing.assertEqual(new JsonString("text").toString(), "\"text\"");
    try testing.assertEqual(new JsonArray().toString(), "[]");
    try testing.assertEqual(new JsonObject().toString(), "\{\}");
    try testing.assertEqual(sample().toString(),
        "\{\"a\": 1, \"b\": [true, null, \"x\"], \"c\": \{\}, \"d\": [[]]\}");
}

test "the one-line form is the text a struct with the same fields prints as" {
    Sample value = {name: "quote \" slash \\ tab \t", count: 3, enabled: false, ratio: null,
        sizes: [1, 2], tags: ["a", "b\nc"]};
    let object = new JsonObject();
    object.set("name", new JsonString("quote \" slash \\ tab \t"));
    object.set("count", JsonNumber.of(3L));
    object.set("enabled", new JsonBool(false));
    object.set("ratio", new JsonNull());
    object.set("sizes", JsonArray.of([JsonNumber.of(1L), JsonNumber.of(2L)]));
    object.set("tags", JsonArray.of([new JsonString("a"), new JsonString("b\nc")]));
    try testing.assertEqual(object.toString(), value.toString());
    try testing.assertEqual(object.toString(), "{value}");

    Sample withRatio = {name: "", count: 0, enabled: true, ratio: 0.25, sizes: [], tags: []};
    let other = new JsonObject();
    other.set("name", new JsonString(""));
    other.set("count", JsonNumber.of(0L));
    other.set("enabled", new JsonBool(true));
    other.set("ratio", JsonNumber.of(0.25));
    other.set("sizes", new JsonArray());
    other.set("tags", new JsonArray());
    try testing.assertEqual(other.toString(), withRatio.toString());
}

test "a string is escaped the way a struct's text is, and nothing else is changed" {
    let text = new JsonString("a\"b\\c\n\t\b\f\r\u0001\u001f/é😀");
    try testing.assertEqual(text.toString(),
        "\"a\\\"b\\\\c\\n\\t\\b\\f\\r\\u0001\\u001f/é😀\"");
    let key = new JsonObject();
    key.set("new\nline", new JsonNull());
    try testing.assertEqual(key.toString(), "\{\"new\\nline\": null\}");
}

test "the indented form puts each element and member on its own line" {
    string expected = "\{\n"
        + "  \"a\": 1,\n"
        + "  \"b\": [\n"
        + "    true,\n"
        + "    null,\n"
        + "    \"x\"\n"
        + "  ],\n"
        + "  \"c\": \{\},\n"
        + "  \"d\": [\n"
        + "    []\n"
        + "  ]\n"
        + "\}";
    try testing.assertEqual(sample().toString("  "), expected);
    try testing.assertEqual(new JsonArray().toString("  "), "[]");
    try testing.assertEqual(JsonNumber.of(5L).toString("\t"), "5");
    try testing.assertEqual(JsonArray.of([new JsonNull()]).toString("\t"), "[\n\tnull\n]");
}

test "what is written reads back as the same value, and canonical text comes back unchanged" {
    let value = sample();
    try testing.assertEqual(try Json.parse(value.toString()), value);
    try testing.assertEqual(try Json.parse(value.toString("    ")), value);
    string canonical = "\{\"k\": [1.50, -0, 1e5, \"\\u0001\\\"\", \{\}], \"e\": []\}";
    try testing.assertEqual((try Json.parse(canonical)).toString(), canonical);
}

// {"a": 1, "b": [true, null, "x"], "c": {}, "d": [[]]}
sample() -> Json {
    let object = new JsonObject();
    object.set("a", JsonNumber.of(1L));
    object.set("b", JsonArray.of([new JsonBool(true), new JsonNull(), new JsonString("x")]));
    object.set("c", new JsonObject());
    object.set("d", JsonArray.of([new JsonArray()]));
    return object;
}
