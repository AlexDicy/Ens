// Tests for the wait '@std.thread' guarantees. Only a floor is asserted. Nothing bounds how long a
// loaded machine leaves a thread waiting.
import @std.testing;
import Thread from @std.thread;
import @std.system;

// The count every wait here requests. It is well above the coarsest system timer a supported host
// schedules against. A wait that did nothing at all fails the floor rather than slipping under it.
final class Requested {
    protected static const long millis = 60;
}

// The count is the floor on every platform, with no allowance for a coarse timer. The library
// waits out whatever the platform's own wait left over.
test "a wait advances the clock by the whole count" {
    long before = system.monotonicMillis();
    Thread.sleep(Requested.millis);
    long elapsed = system.monotonicMillis() - before;
    try testing.assertTrue(elapsed >= Requested.millis,
        "a wait of {Requested.millis}ms advanced the clock by {elapsed}ms");
}

// A second wait is a second wait. A wait that somehow satisfied the first by accident does not
// satisfy this one too.
test "a wait after a wait still lasts as long as the count given" {
    long before = system.monotonicMillis();
    Thread.sleep(Requested.millis);
    long first = system.monotonicMillis() - before;
    long between = system.monotonicMillis();
    Thread.sleep(Requested.millis);
    long second = system.monotonicMillis() - between;
    try testing.assertTrue(first >= Requested.millis,
        "the first wait advanced the clock by {first}ms");
    try testing.assertTrue(second >= Requested.millis,
        "the second wait advanced the clock by {second}ms");
}

// A count of nothing is what a caller holding a deadline passes once the deadline has passed. It
// has to return rather than wait on a system that reads it as something else.
test "a count of zero returns" {
    Thread.sleep(0);
}

test "a count below zero returns" {
    Thread.sleep(-1);
    Thread.sleep(-1000);
}
