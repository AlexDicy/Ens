// Tests for the iterator contract as the containers keep it: null once the walk is over, and on
// every later call.
import @std.testing;
import Iterator from @std.collections.iterator;
import Deque from @std.collections.deque;
import List from @std.collections.list;
import Map from @std.collections.map;
import Entry from @std.collections.entry;
import PriorityQueue from @std.collections.priorityqueue;
import Set from @std.collections.set;
import SortedMap from @std.collections.sortedmap;

assertExhausted<T>(Iterator<T> walk) throws {
    try testing.assertTrue(walk.next() == null,
        "the first call past the end should answer null");
    try testing.assertTrue(walk.next() == null, "every later call should answer null too");
}

test "a list iterator answers each value in order, then null for good" {
    let words = new List<string>();
    words.push("one");
    words.push("two");
    words.push("three");
    let walk = words.makeIterator();
    string drawn = "";
    let word = walk.next();
    while (word != null) {
        drawn = drawn + word + " ";
        word = walk.next();
    }
    try testing.assertEqual(drawn, "one two three ");
    try assertExhausted<string>(walk);
}

test "a map iterator answers each entry once, then null for good" {
    let counts = new Map<string, int>();
    counts.set("a", 1);
    counts.set("b", 2);
    counts.set("c", 3);
    let walk = counts.makeIterator();
    long entries = 0;
    int total = 0;
    let entry = walk.next();
    while (entry != null) {
        entries = entries + 1;
        total = total + entry.value;
        entry = walk.next();
    }
    try testing.assertEqual(entries, 3);
    try testing.assertEqual(total, 6);
    try assertExhausted<Entry<string, int>>(walk);
}

test "a set iterator answers each item once, then null for good" {
    let numbers = new Set<int>();
    numbers.add(1);
    numbers.add(2);
    numbers.add(3);
    let walk = numbers.makeIterator();
    long items = 0;
    int total = 0;
    let item = walk.next();
    while (item != null) {
        items = items + 1;
        total = total + item;
        item = walk.next();
    }
    try testing.assertEqual(items, 3);
    try testing.assertEqual(total, 6);
    try assertExhausted<int>(walk);
}

test "the deque, priority queue, and sorted map iterators answer each value, then null for good" {
    let deque = new Deque<int>();
    deque.pushBack(2);
    deque.pushFront(1);
    let dequeWalk = deque.makeIterator();
    try testing.assertEqual(dequeWalk.next() ?? 0, 1);
    try testing.assertEqual(dequeWalk.next() ?? 0, 2);
    try assertExhausted<int>(dequeWalk);

    let queue = new PriorityQueue<int>((a, b) -> a - b);
    queue.push(3);
    queue.push(4);
    let queueWalk = queue.makeIterator();
    int total = (queueWalk.next() ?? 0) + (queueWalk.next() ?? 0);
    try testing.assertEqual(total, 7);
    try assertExhausted<int>(queueWalk);

    let sorted = new SortedMap<int, string>((a, b) -> a - b);
    sorted.set(6, "b");
    sorted.set(5, "a");
    let sortedWalk = sorted.makeIterator();
    let first = sortedWalk.next();
    let second = sortedWalk.next();
    try testing.assertTrue(first != null && first.key == 5, "the smaller key comes first");
    try testing.assertTrue(second != null && second.value == "b", "the larger key comes second");
    try assertExhausted<Entry<int, string>>(sortedWalk);
}

test "an empty container's iterator is over from the first call" {
    try assertExhausted<string>(new List<string>().makeIterator());
    try assertExhausted<Entry<string, int>>(new Map<string, int>().makeIterator());
    try assertExhausted<int>(new Set<int>().makeIterator());
    try assertExhausted<int>(new Deque<int>().makeIterator());
    try assertExhausted<int>(new PriorityQueue<int>((a, b) -> a - b).makeIterator());
    try assertExhausted<Entry<int, int>>(new SortedMap<int, int>((a, b) -> a - b).makeIterator());
}
