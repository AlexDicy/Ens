// Tests for List, one behavior per test: what each operation leaves in the list and what it
// answers.
import @std.testing;
import Collection from @std.collections.iterator;
import List from @std.collections.list;

class Word implements Comparable<Word> {
    protected string text;

    protected constructor(this.text);

    protected override compareTo(Word other) -> int {
        return this.text.compareTo(other.text);
    }
}

// The values joined with spaces, so a whole list is checked in one assertion.
joined(List<string> words) -> string {
    string text = "";
    for (let word in words) {
        if (text.length > 0) {
            text = text + " ";
        }
        text = text + word;
    }
    return text;
}

joinedWords(List<Word> words) -> string {
    let texts = new List<string>();
    for (let word in words) {
        texts.push(word.text);
    }
    return joined(texts);
}

countOf<T>(Collection<T> items) -> long {
    return items.length();
}

test "push keeps values in the order they arrived, and length counts them" {
    let words = new List<string>();
    try testing.assertTrue(words.isEmpty(), "a new list is empty");
    words.push("a");
    words.push("b");
    words.push("c");
    try testing.assertEqual(words.length(), 3);
    try testing.assertFalse(words.isEmpty(), "a list holding values is not empty");
    try testing.assertEqual(joined(words), "a b c");
}

test "of holds the array's values in order, and withCapacity starts empty" {
    try testing.assertEqual(joined(List<string>.of(["x", "y"])), "x y");
    let reserved = List<int>.withCapacity(32);
    try testing.assertEqual(reserved.length(), 0);
    reserved.push(1);
    try testing.assertEqual(reserved.get(0), 1);
}

test "get reads and set overwrites by index" {
    let numbers = List<int>.of([1, 2, 3]);
    numbers.set(1, 20);
    try testing.assertEqual(numbers.get(0), 1);
    try testing.assertEqual(numbers.get(1), 20);
    try testing.assertEqual(numbers.get(2), 3);
}

test "first and last answer the two ends" {
    let words = List<string>.of(["head", "middle", "tail"]);
    try testing.assertEqual(words.first(), "head");
    try testing.assertEqual(words.last(), "tail");
}

test "pushAll takes every value of an iterable" {
    let words = List<string>.of(["a"]);
    words.pushAll(List<string>.of(["b", "c"]));
    try testing.assertEqual(joined(words), "a b c");
}

test "pop takes the last value off and answers it" {
    let numbers = List<int>.of([1, 2, 3]);
    try testing.assertEqual(numbers.pop(), 3);
    try testing.assertEqual(numbers.length(), 2);
    numbers.push(4);
    try testing.assertEqual(numbers.last(), 4);
}

test "insert moves the values from the index on up, and appends at the length" {
    let words = List<string>.of(["b", "d"]);
    words.insert(0, "a");
    words.insert(2, "c");
    words.insert(4, "e");
    try testing.assertEqual(joined(words), "a b c d e");
}

test "removeAt moves the later values down and answers the removed one" {
    let words = List<string>.of(["a", "b", "c"]);
    try testing.assertEqual(words.removeAt(1), "b");
    try testing.assertEqual(joined(words), "a c");
    try testing.assertEqual(words.removeAt(1), "c");
    try testing.assertEqual(joined(words), "a");
}

test "remove takes out the first equal value only, and answers whether there was one" {
    let words = List<string>.of(["a", "b", "a"]);
    try testing.assertTrue(words.remove("a"), "the first 'a' should go");
    try testing.assertEqual(joined(words), "b a");
    try testing.assertFalse(words.remove("z"), "a value the list does not hold answers false");
    try testing.assertEqual(words.length(), 2);
}

test "removeWhere removes every match in one pass and answers how many went" {
    let numbers = List<int>.of([1, 2, 3, 4, 5, 6]);
    try testing.assertEqual(numbers.removeWhere((n) -> n % 2 == 0), 3);
    try testing.assertEqual(numbers.length(), 3);
    try testing.assertEqual(numbers.get(0), 1);
    try testing.assertEqual(numbers.get(1), 3);
    try testing.assertEqual(numbers.get(2), 5);
    try testing.assertEqual(numbers.removeWhere((n) -> n > 100), 0);
    try testing.assertEqual(numbers.length(), 3);
}

test "clear empties the list, which keeps working afterwards" {
    let words = List<string>.of(["a", "b"]);
    words.clear();
    try testing.assertTrue(words.isEmpty(), "a cleared list is empty");
    words.push("c");
    try testing.assertEqual(joined(words), "c");
}

test "reserve makes room without changing what the list holds" {
    let numbers = List<int>.of([1]);
    numbers.reserve(100);
    try testing.assertEqual(numbers.length(), 1);
    for (int i = 2; i <= 100; i++) {
        numbers.push(i);
    }
    try testing.assertEqual(numbers.length(), 100);
    try testing.assertEqual(numbers.first(), 1);
    try testing.assertEqual(numbers.last(), 100);
}

test "contains and indexOf compare with ==, and indexOf answers -1 for a missing value" {
    let words = List<string>.of(["a", "b", "b"]);
    try testing.assertTrue(words.contains("b"), "the list holds 'b'");
    try testing.assertFalse(words.contains("z"), "the list does not hold 'z'");
    try testing.assertEqual(words.indexOf("b"), 1);
    try testing.assertEqual(words.indexOf("z"), -1);
}

test "indexWhere finds the first value the test accepts" {
    let numbers = List<int>.of([1, 4, 6, 8]);
    try testing.assertEqual(numbers.indexWhere((n) -> n % 2 == 0), 1);
    try testing.assertEqual(numbers.indexWhere((n) -> n > 10), -1);
}

test "sort puts the values in the order the comparison describes" {
    let numbers = List<int>.of([3, 1, 2, 5, 4, 9, 8, 7, 6]);
    numbers.sort((a, b) -> a - b);
    try testing.assertEqual("{numbers.toArray()}", "[1, 2, 3, 4, 5, 6, 7, 8, 9]");
    numbers.sort((a, b) -> b - a);
    try testing.assertEqual("{numbers.toArray()}", "[9, 8, 7, 6, 5, 4, 3, 2, 1]");
    let single = List<int>.of([1]);
    single.sort((a, b) -> a - b);
    try testing.assertEqual(single.get(0), 1);
    new List<int>().sort((a, b) -> a - b);
}

test "sort with no comparison uses the natural order of a Comparable element" {
    let words = new List<Word>();
    words.push(new Word("pear"));
    words.push(new Word("apple"));
    words.push(new Word("fig"));
    words.sort();
    try testing.assertEqual(joinedWords(words), "apple fig pear");
}

test "sorted and reversed answer new lists and leave the source untouched" {
    let words = new List<Word>();
    words.push(new Word("pear"));
    words.push(new Word("apple"));
    words.push(new Word("fig"));
    try testing.assertEqual(joinedWords(words.sorted()), "apple fig pear");
    try testing.assertEqual(joinedWords(words.sorted((a, b) -> b.compareTo(a))), "pear fig apple");
    try testing.assertEqual(joinedWords(words.reversed()), "fig apple pear");
    try testing.assertEqual(joinedWords(words), "pear apple fig");
}

test "reverse flips the values in place" {
    let numbers = List<int>.of([1, 2, 3, 4]);
    numbers.reverse();
    try testing.assertEqual("{numbers.toArray()}", "[4, 3, 2, 1]");
}

test "copy shares the values but not the list" {
    let original = new List<Word>();
    original.push(new Word("a"));
    original.push(new Word("b"));
    let copied = original.copy();
    copied.push(new Word("c"));
    try testing.assertEqual(original.length(), 2);
    try testing.assertEqual(copied.length(), 3);
    try testing.assertTrue(copied.get(0) == original.get(0), "the copy holds the same objects");
}

test "toArray answers a fresh array of exactly the length" {
    let words = List<string>.of(["a", "b"]);
    string[] array = words.toArray();
    words.push("c");
    try testing.assertEqual(array.length, 2);
    try testing.assertEqual(array[1], "b");
}

test "a list is a Collection, so a generic helper takes it with the type argument inferred" {
    try testing.assertEqual(countOf(List<string>.of(["a", "b", "c"])), 3);
}
