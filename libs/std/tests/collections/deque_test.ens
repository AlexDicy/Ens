// Tests for Deque, one behavior per test: what each operation leaves in the deque and what it
// answers, including once the ring has wrapped around its store.
import @std.testing;
import Collection from @std.collections.iterator;
import Deque from @std.collections.deque;

class Payload {
    protected long tag;

    protected constructor(this.tag);
}

// The values joined with spaces, front to back, so a whole deque is checked in one assertion.
joined(Deque<int> values) -> string {
    string text = "";
    for (let value in values) {
        if (text.length > 0) {
            text = text + " ";
        }
        text = text + value;
    }
    return text;
}

countOf<T>(Collection<T> items) -> long {
    return items.length();
}

test "pushBack adds at the back, pushFront at the front, and length counts both" {
    let values = new Deque<int>();
    try testing.assertTrue(values.isEmpty(), "a new deque is empty");
    values.pushBack(2);
    values.pushBack(3);
    values.pushFront(1);
    try testing.assertEqual(values.length(), 3);
    try testing.assertFalse(values.isEmpty(), "a deque holding values is not empty");
    try testing.assertEqual(joined(values), "1 2 3");
}

test "withCapacity starts empty and holds that many values before growing" {
    let reserved = Deque<int>.withCapacity(32);
    try testing.assertEqual(reserved.length(), 0);
    for (int i = 0; i < 32; i++) {
        reserved.pushBack(i);
    }
    try testing.assertEqual(reserved.length(), 32);
    try testing.assertEqual(reserved.get(31), 31);
}

test "get answers the value that many places from the front" {
    let values = new Deque<int>();
    values.pushBack(10);
    values.pushBack(20);
    values.pushFront(5);
    try testing.assertEqual(values.get(0), 5);
    try testing.assertEqual(values.get(1), 10);
    try testing.assertEqual(values.get(2), 20);
}

test "first and last answer the two ends" {
    let values = new Deque<int>();
    values.pushBack(1);
    values.pushBack(2);
    values.pushBack(3);
    try testing.assertEqual(values.first(), 1);
    try testing.assertEqual(values.last(), 3);
    values.pushFront(0);
    try testing.assertEqual(values.first(), 0);
}

test "popFront and popBack take a value off either end and answer it" {
    let values = new Deque<int>();
    values.pushBack(1);
    values.pushBack(2);
    values.pushBack(3);
    values.pushBack(4);
    try testing.assertEqual(values.popFront(), 1);
    try testing.assertEqual(values.popBack(), 4);
    try testing.assertEqual(joined(values), "2 3");
    try testing.assertEqual(values.popFront(), 2);
    try testing.assertEqual(values.popBack(), 3);
    try testing.assertTrue(values.isEmpty(), "both ends popped leave the deque empty");
    values.pushFront(9);
    try testing.assertEqual(joined(values), "9");
}

test "pushes and pops at both ends wrap around the ring many times" {
    let ring = Deque<int>.withCapacity(4);
    for (int i = 0; i < 4; i++) {
        ring.pushBack(i);
    }
    for (int round = 0; round < 1001; round++) {
        ring.pushBack(ring.popFront());
    }
    try testing.assertEqual(joined(ring), "1 2 3 0");
    for (int round = 0; round < 1002; round++) {
        ring.pushFront(ring.popBack());
    }
    try testing.assertEqual(joined(ring), "3 0 1 2");
    try testing.assertEqual(ring.length(), 4);
}

test "get, growth, and reserve keep the order once the ring has wrapped around" {
    let ring = Deque<int>.withCapacity(4);
    ring.pushBack(1);
    ring.pushBack(2);
    ring.pushBack(3);
    ring.popFront();
    ring.popFront();
    ring.pushBack(4);
    ring.pushBack(5);
    try testing.assertEqual(ring.get(0), 3);
    try testing.assertEqual(ring.get(1), 4);
    try testing.assertEqual(ring.get(2), 5);
    ring.pushBack(6);
    ring.pushBack(7);
    try testing.assertEqual(joined(ring), "3 4 5 6 7");
    ring.reserve(100);
    try testing.assertEqual(joined(ring), "3 4 5 6 7");
    try testing.assertEqual(ring.get(4), 7);
    ring.pushFront(2);
    try testing.assertEqual(joined(ring), "2 3 4 5 6 7");
}

test "contains compares with ==" {
    let values = new Deque<int>();
    values.pushBack(1);
    values.pushFront(2);
    try testing.assertTrue(values.contains(2), "the deque holds 2");
    try testing.assertFalse(values.contains(3), "the deque does not hold 3");
}

test "clear empties the deque, which keeps working afterwards" {
    let values = new Deque<int>();
    values.pushBack(1);
    values.pushBack(2);
    values.clear();
    try testing.assertTrue(values.isEmpty(), "a cleared deque is empty");
    values.pushFront(3);
    values.pushBack(4);
    try testing.assertEqual(joined(values), "3 4");
}

test "copy shares the values but not the deque" {
    let original = new Deque<Payload>();
    original.pushBack(new Payload(1));
    original.pushFront(new Payload(0));
    let copied = original.copy();
    copied.pushBack(new Payload(2));
    original.popFront();
    try testing.assertEqual(original.length(), 1);
    try testing.assertEqual(copied.length(), 3);
    try testing.assertTrue(copied.get(1) == original.first(), "the copy holds the same objects");
}

test "toArray answers a fresh array of exactly the length, front to back" {
    let values = new Deque<int>();
    values.pushBack(2);
    values.pushFront(1);
    int[] array = values.toArray();
    values.pushBack(3);
    try testing.assertEqual(array.length, 2);
    try testing.assertEqual(array[0], 1);
    try testing.assertEqual(array[1], 2);
}

test "a deque is a Collection, so a generic helper takes it with the type argument inferred" {
    let values = new Deque<string>();
    values.pushBack("a");
    values.pushBack("b");
    try testing.assertEqual(countOf(values), 2);
}
