// Tests for Map, one behavior per test: what each operation answers and what a walk sees.
import @std.testing;
import List from @std.collections.list;
import Map from @std.collections.map;

class Payload {
    protected long tag;

    protected constructor(this.tag);
}

// How often a `make` ran, kept on an object because a lambda captures by value.
class Calls {
    protected long made;

    protected constructor() {
        this.made = 0;
    }
}

// The keys sorted and joined, so a walk in any order compares equal.
sortedKeys(Map<string, int> map) -> string {
    let keys = new List<string>();
    keys.pushAll(map.keys());
    keys.sort((a, b) -> a.compareTo(b));
    string text = "";
    for (let key in keys) {
        if (text.length > 0) {
            text = text + " ";
        }
        text = text + key;
    }
    return text;
}

valueTotal(Map<string, int> map) -> long {
    long total = 0;
    for (let value in map.values()) {
        total = total + value;
    }
    return total;
}

test "set inserts or overwrites, and get answers null for a missing key" {
    let ages = new Map<string, int>();
    try testing.assertTrue(ages.isEmpty(), "a new map is empty");
    ages.set("ada", 36);
    ages.set("bob", 41);
    ages.set("ada", 37);
    try testing.assertEqual(ages.length(), 2);
    try testing.assertEqual(ages.get("ada") ?? -1, 37);
    try testing.assertEqual(ages.get("bob") ?? -1, 41);
    try testing.assertTrue(ages.get("cleo") == null, "a missing key answers null");
}

test "withCapacity holds that many entries" {
    let numbers = Map<int, int>.withCapacity(50);
    for (int i = 0; i < 50; i++) {
        numbers.set(i, i * i);
    }
    try testing.assertEqual(numbers.length(), 50);
    try testing.assertEqual(numbers.get(7) ?? -1, 49);
}

test "contains answers presence, and remove answers whether an entry went" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    try testing.assertTrue(ages.contains("ada"), "the key was set");
    try testing.assertFalse(ages.contains("bob"), "the key was never set");
    try testing.assertTrue(ages.remove("ada"), "the first removal finds the entry");
    try testing.assertFalse(ages.remove("ada"), "the second finds nothing");
    try testing.assertFalse(ages.contains("ada"), "the key is gone");
}

test "removeWhere removes every entry the test accepts in one pass and answers how many" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.set("bob", 41);
    ages.set("cleo", 29);
    ages.set("dan", 50);
    try testing.assertEqual(ages.removeWhere((name, age) -> age >= 40), 2);
    try testing.assertEqual(sortedKeys(ages), "ada cleo");
    try testing.assertEqual(ages.removeWhere((name, age) -> age > 100), 0);
}

test "clear empties the map, which keeps working afterwards" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.clear();
    try testing.assertTrue(ages.isEmpty(), "a cleared map is empty");
    try testing.assertFalse(ages.contains("ada"), "the cleared key is gone");
    ages.set("bob", 41);
    try testing.assertEqual(ages.get("bob") ?? -1, 41);
}

test "getOrInsert runs make only when the key is absent, and once" {
    let calls = new Calls();
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    int present = ages.getOrInsert("ada", () -> {
        calls.made = calls.made + 1;
        return 99;
    });
    try testing.assertEqual(present, 36);
    try testing.assertEqual(calls.made, 0);
    int made = ages.getOrInsert("bob", () -> {
        calls.made = calls.made + 1;
        return 41;
    });
    try testing.assertEqual(made, 41);
    try testing.assertEqual(calls.made, 1);
    try testing.assertEqual(ages.get("bob") ?? -1, 41);
    try testing.assertEqual(ages.length(), 2);
}

test "walking a map yields each entry once, as an Entry with key and value" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.set("bob", 41);
    long entries = 0;
    long total = 0;
    string keys = "";
    for (let entry in ages) {
        entries = entries + 1;
        total = total + entry.value;
        keys = keys + entry.key;
    }
    try testing.assertEqual(entries, 2);
    try testing.assertEqual(total, 77);
    try testing.assertEqual(keys.length, 6);
}

test "keys and values are views onto the live map" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    let keys = ages.keys();
    let values = ages.values();
    ages.set("bob", 41);
    long seen = 0;
    for (let key in keys) {
        seen = seen + 1;
    }
    try testing.assertEqual(seen, 2);
    long total = 0;
    for (let value in values) {
        total = total + value;
    }
    try testing.assertEqual(total, 77);
    try testing.assertEqual(sortedKeys(ages), "ada bob");
    try testing.assertEqual(valueTotal(ages), 77);
}

test "overwriting a value during a walk is allowed, since no entry moves" {
    let ages = new Map<string, int>();
    ages.set("ada", 36);
    ages.set("bob", 41);
    for (let entry in ages) {
        ages.set(entry.key, entry.value + 1);
    }
    try testing.assertEqual(ages.get("ada") ?? 0, 37);
    try testing.assertEqual(ages.get("bob") ?? 0, 42);
}

test "copy shares the keys and values but not the table" {
    let original = new Map<string, Payload>();
    original.set("a", new Payload(1));
    let copied = original.copy();
    copied.set("b", new Payload(2));
    original.remove("a");
    try testing.assertEqual(original.length(), 0);
    try testing.assertEqual(copied.length(), 2);
    try testing.assertTrue(copied.contains("a"), "the copy keeps the entry the original dropped");
}

test "a map grows past its first table and still finds every entry" {
    let squares = new Map<int, long>();
    for (int i = 0; i < 200; i++) {
        squares.set(i, i * i);
    }
    try testing.assertEqual(squares.length(), 200);
    for (int i = 0; i < 200; i++) {
        try testing.assertEqual(squares.get(i) ?? -1, i * i);
    }
    try testing.assertTrue(squares.get(200) == null, "a key never set stays absent");
}

test "removing and inserting many times keeps every lookup right" {
    let window = new Map<long, long>();
    for (long i = 0; i < 2000; i++) {
        window.set(i, i);
        window.remove(i - 3);
    }
    try testing.assertEqual(window.length(), 3);
    try testing.assertTrue(window.contains(1999), "the newest key is there");
    try testing.assertTrue(window.contains(1997), "the oldest kept key is there");
    try testing.assertFalse(window.contains(1996), "a removed key is gone");
}

test "a nullable value type tells a stored null from a missing key" {
    let scores = new Map<string, int?>();
    scores.set("blank", null);
    let stored = scores.get("blank");
    try testing.assertTrue(stored != null, "a stored null is present at the outer level");
    if (stored != null) {
        try testing.assertTrue(stored == null, "and null at the inner level");
    }
    try testing.assertTrue(scores.get("missing") == null, "a missing key is absent outright");
}
