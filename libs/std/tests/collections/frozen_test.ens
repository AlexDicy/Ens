// Tests for the frozen collections: reading, writable copies, and equality and hashing by content.
import @std.testing;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import FrozenList from @std.collections.frozen;
import FrozenMap from @std.collections.frozen;
import FrozenSet from @std.collections.frozen;

test "a frozen list keeps the values it was frozen with, whatever happens to the list" {
    let list = List.of([3, 1, 2]);
    let frozen = FrozenList.of(list);
    list.push(9);
    try testing.assertEqual(frozen.length(), 3L);
    try testing.assertEqual(frozen.get(0), 3);
    try testing.assertEqual(frozen.first(), 3);
    try testing.assertEqual(frozen.last(), 2);
    try testing.assertEqual(frozen.indexOf(1), 1L);
    try testing.assertFalse(frozen.contains(9), "the push came after the freeze");
    try testing.assertEqual(frozen.toArray(), [3, 1, 2]);
}

test "a writable copy of a frozen list changes on its own" {
    let frozen = FrozenList.of(["a", "b"]);
    let copy = frozen.toList();
    copy.push("c");
    try testing.assertEqual(copy.length(), 3L);
    try testing.assertEqual(frozen.length(), 2L);
}

test "frozen lists compare and hash by their values in order" {
    let first = FrozenList.of([1, 2]);
    try testing.assertTrue(first == FrozenList.of([1, 2]), "the same values in the same order");
    try testing.assertFalse(first == FrozenList.of([2, 1]), "the same values in another order");
    try testing.assertEqual(first.hash(), FrozenList.of([1, 2]).hash());
    let named = new Map<FrozenList<int>, string>();
    named.set(first, "pair");
    try testing.assertEqual<string?>(named.get(FrozenList.of([1, 2])), "pair");
}

test "a frozen map finds what the map held, and compares whatever order it walks in" {
    let map = new Map<string, int>();
    map.set("one", 1);
    map.set("two", 2);
    let frozen = FrozenMap.of(map);
    map.set("three", 3);
    try testing.assertEqual(frozen.length(), 2L);
    try testing.assertEqual<int?>(frozen.get("two"), 2);
    try testing.assertEqual<int?>(frozen.get("three"), null);
    let other = new Map<string, int>();
    other.set("two", 2);
    other.set("one", 1);
    try testing.assertTrue(frozen == FrozenMap.of(other), "the same entries");
    try testing.assertEqual(frozen.hash(), FrozenMap.of(other).hash());
    try testing.assertEqual(frozen.toMap().length(), 2L);
}

test "a frozen set holds each value once and compares as a set" {
    let set = FrozenSet.of(["x", "y", "x"]);
    try testing.assertEqual(set.length(), 2L);
    try testing.assertTrue(set.contains("y"), "a value it was frozen with");
    try testing.assertTrue(set == FrozenSet.of(["y", "x"]), "the same values");
    try testing.assertEqual(set.hash(), FrozenSet.of(["y", "x"]).hash());
    let writable = set.toSet();
    writable.add("z");
    try testing.assertFalse(set.contains("z"), "the copy is its own set");
}

test "frozen() on a list, a map and a set copies what it holds now" {
    let list = List.of([1, 2]);
    let frozenList = list.frozen();
    list.push(3);
    try testing.assertEqual(frozenList.length(), 2L);
    let map = new Map<string, int>();
    map.set("one", 1);
    let frozenMap = map.frozen();
    map.set("two", 2);
    try testing.assertEqual(frozenMap.length(), 1L);
    let set = Set.of(["x"]);
    let frozenSet = set.frozen();
    set.add("y");
    try testing.assertFalse(frozenSet.contains("y"), "the add came after the freeze");
}
