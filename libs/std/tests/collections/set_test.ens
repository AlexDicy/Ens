// Tests for Set, one behavior per test: what each operation answers and which values remain.
import @std.testing;
import Collection from @std.collections.collection;
import List from @std.collections.list;
import Set from @std.collections.set;

// The values sorted and joined, so a walk in any order compares equal.
sorted(Set<string> values) -> string {
    let words = new List<string>();
    words.pushAll(values);
    words.sort((a, b) -> a.compareTo(b));
    string text = "";
    for (let word in words) {
        if (text.length > 0) {
            text = text + " ";
        }
        text = text + word;
    }
    return text;
}

countOf<T>(Collection<T> items) -> long {
    return items.length();
}

test "add answers whether the value was new, and length counts each value once" {
    let names = new Set<string>();
    try testing.assertTrue(names.isEmpty(), "a new set is empty");
    try testing.assertTrue(names.add("ada"), "the first add is new");
    try testing.assertFalse(names.add("ada"), "the second add of the same value is not");
    try testing.assertTrue(names.add("bob"), "a different value is new");
    try testing.assertEqual(names.length(), 2);
}

test "of drops duplicates, and withCapacity starts empty" {
    try testing.assertEqual(sorted(Set<string>.of(["b", "a", "b", "c", "a"])), "a b c");
    try testing.assertTrue(Set<int>.withCapacity(40).isEmpty(), "reserved room holds nothing yet");
}

test "contains answers presence, and remove answers whether the value went" {
    let names = Set<string>.of(["ada", "bob"]);
    try testing.assertTrue(names.contains("ada"), "an added value is there");
    try testing.assertFalse(names.contains("cleo"), "a value never added is not");
    try testing.assertTrue(names.remove("ada"), "the first removal finds it");
    try testing.assertFalse(names.remove("ada"), "the second does not");
    try testing.assertEqual(sorted(names), "bob");
}

test "removeWhere removes every value the test accepts in one pass and answers how many" {
    let numbers = Set<int>.of([1, 2, 3, 4, 5, 6]);
    try testing.assertEqual(numbers.removeWhere((n) -> n % 2 == 0), 3);
    try testing.assertEqual(numbers.length(), 3);
    try testing.assertTrue(numbers.contains(1) && numbers.contains(3) && numbers.contains(5),
        "the odd values stay");
    try testing.assertEqual(numbers.removeWhere((n) -> n > 100), 0);
}

test "clear empties the set, which keeps working afterwards" {
    let names = Set<string>.of(["ada"]);
    names.clear();
    try testing.assertTrue(names.isEmpty(), "a cleared set is empty");
    try testing.assertTrue(names.add("ada"), "the cleared value is new again");
}

test "union, intersection, and difference answer new sets and leave both sources untouched" {
    let left = Set<string>.of(["a", "b", "c"]);
    let right = Set<string>.of(["c", "d"]);
    try testing.assertEqual(sorted(left.union(right)), "a b c d");
    try testing.assertEqual(sorted(left.intersection(right)), "c");
    try testing.assertEqual(sorted(left.difference(right)), "a b");
    try testing.assertEqual(sorted(right.difference(left)), "d");
    try testing.assertEqual(sorted(left), "a b c");
    try testing.assertEqual(sorted(right), "c d");
}

test "isSubsetOf answers whether the other set holds every value" {
    let small = Set<int>.of([1, 2]);
    let large = Set<int>.of([1, 2, 3]);
    try testing.assertTrue(small.isSubsetOf(large), "a smaller set inside a larger one");
    try testing.assertTrue(small.isSubsetOf(small), "a set is a subset of itself");
    try testing.assertTrue(new Set<int>().isSubsetOf(small), "the empty set is a subset of any");
    try testing.assertFalse(large.isSubsetOf(small), "the larger set is not inside the smaller");
}

test "copy shares the values but not the set" {
    let original = Set<string>.of(["a"]);
    let copied = original.copy();
    copied.add("b");
    original.remove("a");
    try testing.assertEqual(sorted(original), "");
    try testing.assertEqual(sorted(copied), "a b");
}

test "toArray holds each value once" {
    let names = Set<string>.of(["b", "a", "b"]);
    string[] array = names.toArray();
    try testing.assertEqual(array.length, 2);
    try testing.assertTrue(names.contains(array[0]) && names.contains(array[1]),
        "every array value is in the set");
    try testing.assertTrue(array[0] != array[1], "the two values differ");
}

test "walking a set yields each value once" {
    let numbers = Set<int>.of([1, 2, 3]);
    long seen = 0;
    long total = 0;
    for (let value in numbers) {
        seen = seen + 1;
        total = total + value;
    }
    try testing.assertEqual(seen, 3);
    try testing.assertEqual(total, 6);
}

test "a set grows past its first table and still holds everything" {
    let numbers = new Set<int>();
    for (int i = 0; i < 200; i++) {
        numbers.add(i);
    }
    try testing.assertEqual(numbers.length(), 200);
    for (int i = 0; i < 200; i++) {
        try testing.assertTrue(numbers.contains(i), "value {i} should be there");
    }
    try testing.assertFalse(numbers.contains(200), "a value never added is not there");
}

test "a set is a Collection, so a generic helper takes it with the type argument inferred" {
    try testing.assertEqual(countOf(Set<string>.of(["a", "b", "b"])), 2);
}
