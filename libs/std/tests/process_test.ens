// Tests for what @std.process does when a program starts and runs: its arguments, environment and
// working directory, what it writes and reads, how it ends, and how it is let go.
import @std.testing;
import TestFailure from @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import Environment from @std.environment;
import @std.environment;
import List from @std.collections.list;
import ChildProcess from @std.process;
import CommandOutput from @std.process;
import ExitStatus from @std.process;
import ProcessError from @std.process;
import @std.process;
import @std.system;
import @std.parallel;
import @std.tasks;
import Cancelled from @std.tasks;
import Pool from @std.tasks.scheduler;
import IoError from @std.io.streams;
import Flood from process.support;
import process.support;

// The arguments echoed back one per line by a program that receives them as a vector: sh on POSIX,
// and on Windows PowerShell running a script, since cmd.exe re-reads its own command line.
echoed(string[] passed) -> CommandOutput throws {
    let arguments = new List<string>();
    if (support.onWindows()) {
        let scratch = try TemporaryDirectory.create("ens-std-process-arguments");
        Path script = scratch.path().join("arguments.ps1");
        try script.writeText("foreach ($argument in $args) \{ [Console]::Out.WriteLine($argument) \}\n");
        arguments.push("-NoProfile");
        arguments.push("-ExecutionPolicy");
        arguments.push("Bypass");
        arguments.push("-File");
        arguments.push(script.toString());
        for (let value in passed) {
            arguments.push(value);
        }
        return try process.run(Path("powershell"), arguments.toArray(), captureOutput: true);
    }
    arguments.push("-c");
    arguments.push("printf '%s\\n' \"$@\"");
    arguments.push("sh");
    for (let value in passed) {
        arguments.push(value);
    }
    return try process.run(Path("/bin/sh"), arguments.toArray(), captureOutput: true);
}

test "arguments reach the program exactly as written" {
    string[] passed = ["with space", "quo\"ted", "back\\slash", "ends\\", "$HOME", "*", "",
        "last"];
    let result = try echoed(passed);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), passed);
}

// A '\' is Windows's own separator, so a program written with one names a place, as one written
// with '/' does, rather than a name to look for on PATH.
test "on Windows a program written with a backslash is run as a path" {
    if (!support.onWindows()) {
        return;
    }
    string interpreter = Environment.current().get("ComSpec") ?? "C:\\Windows\\System32\\cmd.exe";
    try testing.assertTrue(interpreter.contains("\\"), "ComSpec has no '\\': {interpreter}");
    let result = try process.run(Path(interpreter), ["/S", "/C", "echo ok"], captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["ok"]);
}

// cmd.exe reaches its own program files through SystemRoot, so a Windows child keeps that one.
test "a given environment replaces this process's own" {
    let given = Environment.empty(environment.platform());
    given.set("ENS_PROBE", "one");
    if (support.onWindows()) {
        given.set("SystemRoot", Environment.current().get("SystemRoot") ?? "");
    }
    let result = try process.runShell(support.probeScript("ENS_PROBE"), environment: given,
        captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    string expected = "one-unset";
    if (support.onWindows()) {
        expected = "one-%USERPROFILE%";
    }
    try testing.assertEqual(support.lines(result.stdout), [expected]);
}

test "no environment given hands this process's own on" {
    string? home = Environment.current().get(support.homeName());
    try testing.assertTrue(home != null, "this process has no {support.homeName()} to hand on");
    let result = try process.runShell(support.script("echo \"$HOME\"", "echo %USERPROFILE%"),
        captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), [home ?? ""]);
}

test "an empty environment reaches the child as no variables at all" {
    let result = try process.runShell(support.script("echo \"$\{HOME-unset\}\"",
        "echo %USERPROFILE%"), environment: Environment.empty(environment.platform()),
        captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    string expected = "unset";
    if (support.onWindows()) {
        expected = "%USERPROFILE%";
    }
    try testing.assertEqual(support.lines(result.stdout), [expected]);
}

test "the working directory is the child's" {
    let scratch = try TemporaryDirectory.create("ens-std-process-directory");
    let result = try process.runShell(support.script("pwd", "cd"),
        workingDirectory: scratch.path(), captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    string[] printed = support.lines(result.stdout);
    try testing.assertEqual(printed.length, 1);
    let reported = try Path.fromNative(printed[0], environment.platform()).realPath();
    try testing.assertEqual(reported, try scratch.path().realPath());
}

// cmd's echo keeps a space written before an operator, so the line holds none there.
test "a run through the shell interprets the line" {
    let result = try process.runShell(support.script("echo one && echo two",
        "echo one&& echo two"), captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["one", "two"]);
    try testing.assertEqual(result.stderr, "");
}

test "a run without capture returns the status and no text" {
    let result = try process.runShell(support.script("exit 3", "exit 3"));
    try testing.assertEqual(result.status.code, 3);
    try testing.assertEqual(result.status.signal, 0);
    try testing.assertFalse(result.status.succeeded(), "a code of 3 is not a success");
    try testing.assertEqual(result.stdout, "");
    try testing.assertEqual(result.stderr, "");
}

// Each stream gets 4096 lines of 66 characters, which is more than a pipe holds on any platform, so
// a capture reading one stream to its end before the other would wait forever, and so would the
// child.
test "captured output keeps the two streams apart when each outgrows a pipe" {
    let result = try process.runShell(support.floodScript(4096), captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the flood failed with {result.status.code}");
    string[] output = support.lines(result.stdout);
    string[] errors = support.lines(result.stderr);
    try testing.assertEqual(output.length, 4096);
    try testing.assertEqual(errors.length, 4096);
    for (let line in output) {
        try testing.assertEqual(line, Flood.output);
    }
    for (let line in errors) {
        try testing.assertEqual(line, Flood.errors);
    }
}

// The child exits at once and leaves a grandchild holding its output, which writes a line about a
// second later.
test "output a grandchild writes after the child ended is still captured" {
    let result = try process.runShell(support.script("(sleep 1; echo late) & exit 0",
        "start /b cmd /c ping -n 2 127.0.0.1 ^>nul ^& echo late"), captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the child failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["late"]);
}

// The child writes the line it was given only once its input has ended, so the output proves both
// that the line arrived and that the close was read. cmd's prompt keeps the first line of what a
// pipe holds and a second prompt takes the rest, and its echo keeps a space written before a
// redirection, so the redirection comes first.
test "a spawned child reads its input and its two outputs are read apart" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments(
        "read a; cat >/dev/null; echo \"$a\"; echo err >&2",
        "set /p a=& set /p b=& call echo %a%& 1>&2 echo err"));
    try child.input().write("hello\n".toBytes());
    try child.input().flush();
    try child.closeInput();
    try testing.assertEqual(try child.stdout().readLine(), "hello");
    try testing.assertEqual(try child.stderr().readLine(), "err");
    let status = try child.wait();
    try testing.assertTrue(status.succeeded(), "the child ended with code {status.code}");
    string? rest = try child.stdout().readLine();
    try testing.assertTrue(rest == null, "the output has ended");
}

// Both streams go into one pipe, so the line written to standard error arrives between the two
// written to standard output, which is the order the child wrote them.
test "a spawned child with merged output is read in the order it wrote both streams" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments(
        "echo out one; echo err one >&2; echo out two",
        "echo out one& 1>&2 echo err one& echo out two"), mergeOutput: true);
    try testing.assertEqual(try child.stdout().readLine(), "out one");
    try testing.assertEqual(try child.stdout().readLine(), "err one");
    try testing.assertEqual(try child.stdout().readLine(), "out two");
    let status = try child.wait();
    try testing.assertTrue(status.succeeded(), "the child ended with code {status.code}");
    string? rest = try child.stdout().readLine();
    try testing.assertTrue(rest == null, "the output has ended");
}

test "the standard error of a child with merged output has ended before anything is read" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments(
        "echo err >&2", "1>&2 echo err"), mergeOutput: true);
    string? line = try child.stderr().readLine();
    try testing.assertTrue(line == null, "the merged standard error gave a line");
    try testing.assertEqual(try child.stderr().read(new byte[8]), 0);
    try testing.assertEqual(try child.stdout().readLine(), "err");
    let status = try child.wait();
    try testing.assertTrue(status.succeeded(), "the child ended with code {status.code}");
    try testing.assertTrue(try child.stderr().readLine() == null, "the merged standard error "
        + "gave a line after the child ended");
}

// A task waiting for a child parks, so its worker runs other tasks. Were the wait held in the
// system, the pool would start a worker for each one stuck in it, about four for every processor
// here; tests beside this one may start a few for their own calls, never one for each processor.
test "tasks waiting for their children leave their workers to other tasks" {
    long processors = environment.processorCount();
    long before = Pool.scheduler.workerCount();
    tasks.scope((scope) -> {
        for (long i = 0; i < processors * 4; i++) {
            scope.launch(() -> napChild());
        }
    });
    long started = Pool.scheduler.workerCount() - before;
    try testing.assertTrue(started < processors,
        "the pool started {started} workers for tasks waiting on children");
}

napChild() {
    let result = try process.run(support.interpreter(), support.scriptArguments("sleep 1",
        "ping -n 2 127.0.0.1 >nul"));
} catch (ProcessError failure) {
}

// The bound belongs to the clock rather than to one call of it, since the system may return a
// little before it as the clock measures it.
test "a child that writes nothing gives false once the bound is spent" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("sleep 5",
        "ping -n 6 127.0.0.1 >nul"));
    long before = system.monotonicMillis();
    bool speaking = try child.waitForOutput(100);
    long waited = system.monotonicMillis() - before;
    try testing.assertFalse(speaking, "the sleeper wrote something");
    try testing.assertTrue(waited >= 100 && waited < 2000,
        "a bound of 100 milliseconds took {waited}");
    try child.kill();
    let status = try child.wait();
}

// The child writes both lines in one write, so the first read usually takes both into the reader
// while the pipe is already empty, and a bound of 0 is then answered from the reader alone. The
// system may still hand the two lines over apart, so when the reader holds nothing after the first
// line the second is awaited with a bound instead, and either way the second line is read and
// nothing is left after it. The child is started directly rather than through cmd.exe, whose echo
// writes one line at a time.
test "a line waiting inside the reader is reported without a wait" {
    ChildProcess child = try twoLinesInOneWrite();
    let output = child.stdout();
    try testing.assertEqual(try output.readLine(), "first");
    if (output.pending() > 0) {
        try testing.assertTrue(try child.waitForOutput(0), "the second line waits inside the reader");
    } else {
        try testing.assertTrue(try child.waitForOutput(20000), "the second line is on its way");
    }
    try testing.assertEqual(try output.readLine(), "second");
    try testing.assertFalse(try child.waitForOutput(0), "nothing is left to read at once");
    try child.kill();
    let status = try child.wait();
}

twoLinesInOneWrite() -> ChildProcess throws {
    if (support.onWindows()) {
        return try process.spawn(Path("powershell"), ["-NoProfile", "-Command",
            "[Console]::Out.Write(\"first`nsecond`n\"); Start-Sleep 5"]);
    }
    return try process.spawn(Path("/bin/sh"), ["-c", "printf 'first\\nsecond\\n'; sleep 5"]);
}

test "a child that writes gives true" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("echo said",
        "echo said"));
    try testing.assertTrue(try child.waitForOutput(20000), "the child wrote a line");
    try testing.assertEqual(try child.stdout().readLine(), "said");
    let status = try child.wait();
    try testing.assertTrue(status.succeeded(), "the child ended with code {status.code}");
}

// A stream that has ended returns at once, because reading it returns null without waiting.
test "a child that has ended gives true" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 0",
        "exit 0"));
    let status = try child.wait();
    long before = system.monotonicMillis();
    try testing.assertTrue(try child.waitForOutput(20000), "the child has ended");
    try testing.assertTrue(system.monotonicMillis() - before < 500,
        "an ended child was asked about and took a while to result");
    try testing.assertTrue(try child.stdout().readLine() == null, "there is nothing to read");
}

test "a bound of 0 checks this moment alone" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("sleep 5",
        "ping -n 6 127.0.0.1 >nul"));
    long before = system.monotonicMillis();
    bool speaking = try child.waitForOutput(0);
    try testing.assertFalse(speaking, "the sleeper wrote something at once");
    try testing.assertTrue(system.monotonicMillis() - before < 500,
        "a bound of 0 waited for the child");
    try child.kill();
    let status = try child.wait();
}

test "waiting twice returns the same status" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 7",
        "exit 7"));
    let first = try child.wait();
    let second = try child.wait();
    try testing.assertEqual(first.code, 7);
    try testing.assertEqual(first.signal, 0);
    try testing.assertEqual(second, first);
    try testing.assertFalse(first.succeeded(), "a code of 7 is not a success");
}

// A child this process stopped reports signal 9 and code 0 on every platform, which on Windows is
// what the code the stop passed is read back as.
test "a timed wait reports still running and a kill then reports the stopping signal" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("sleep 5",
        "ping -n 6 127.0.0.1 >nul"));
    long before = system.monotonicMillis();
    ExitStatus? still = try child.wait(100);
    long waited = system.monotonicMillis() - before;
    try testing.assertTrue(still == null, "the sleeper ended inside 100 milliseconds");
    try testing.assertTrue(waited >= 100 && waited < 2000,
        "a wait bounded at 100 milliseconds took {waited}");
    try child.kill();
    let status = try child.wait();
    try testing.assertEqual(status.signal, 9);
    try testing.assertEqual(status.code, 0);
    try testing.assertFalse(status.succeeded(), "a stopped child did not succeed");
    ExitStatus? again = try child.wait(0);
    if (again == null) {
        try testing.fail("a child already collected is still running");
    } else {
        try testing.assertEqual(again, status);
    }
}

test "a child that exited on its own keeps its code after a later kill" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 7",
        "exit 7"));
    let ended = try child.wait();
    try testing.assertEqual(ended.code, 7);
    try child.kill();
    let again = try child.wait();
    try testing.assertEqual(again.code, 7);
    try testing.assertEqual(again.signal, 0);
}

// Starts a child that stays for about three seconds and drops it at once.
dropChild() throws {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("sleep 3",
        "ping -n 4 127.0.0.1 >nul"));
}

test "dropping a child waits for nothing" {
    long before = system.monotonicMillis();
    try dropChild();
    long elapsed = system.monotonicMillis() - before;
    try testing.assertTrue(elapsed < 2000, "dropping a sleeping child took {elapsed} milliseconds");
}

// The program on PATH has a name of the test's own and is made where only the environment the
// child is given points, so finding it proves the search read that PATH.
test "a program named without a separator is found in a PATH directory" {
    let scratch = try TemporaryDirectory.create("ens-std-process-path");
    string name = "ens-std-process-probe";
    string fileName = name;
    if (support.onWindows()) {
        fileName = name + ".exe";
    }
    bool made = try support.writeFoundProgram(scratch.path().join(fileName));
    try testing.assertTrue(made, "the program on PATH could not be made runnable");
    let given = Environment.current();
    given.set("PATH", scratch.path().toString());
    let result = try process.run(Path(name), support.scriptArguments("echo found", "echo found"),
        environment: given, captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the program on PATH failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["found"]);
    let asWritten = try process.run(Path(fileName), support.scriptArguments("echo found",
        "echo found"), environment: given, captureOutput: true);
    try testing.assertEqual(support.lines(asWritten.stdout), ["found"]);
}

// The first PATH directory holds a file of the name nobody may execute, and the second the
// program; a start passes over the first the way execvp does, so the program still runs. Windows
// has no execute bit, so there the first match is the one tried.
test "a file nobody may execute earlier on PATH does not hide the program behind it" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-shadow");
    Path first = scratch.path().join("first");
    Path second = scratch.path().join("second");
    try first.createDirectories();
    try second.createDirectories();
    try first.join("ens-std-process-probe").writeText("not a program");
    bool made = try support.writeFoundProgram(second.join("ens-std-process-probe"));
    try testing.assertTrue(made, "the program on PATH could not be made runnable");
    let given = Environment.current();
    given.set("PATH", first.toString() + ":" + second.toString());
    let result = try process.run(Path("ens-std-process-probe"), ["-c", "echo found"],
        environment: given, captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the program on PATH failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["found"]);
}

// A start flushes the streams it shares with its child, and only those, so children started from
// several tasks at once while others open, write and close files all start and finish.
test "children start while other tasks open and close files" {
    try parallel.range(0, 8, (worker) -> {
        for (long round = 0; round < 10; round++) {
            if (worker % 2 == 0) {
                let ran = try process.runShell(support.script("echo started", "echo started"),
                    captureOutput: true);
                if (!ran.stdout.startsWith("started")) {
                    throw new TestFailure("a child wrote '{ran.stdout}'");
                }
            } else {
                let scratch = try TemporaryDirectory.create("ens-std-process-files");
                try scratch.path().join("note.txt").writeText("written while children start");
            }
        }
    });
}

// What reading a child that writes nothing ends with, in a task whose scope is cancelled while
// the read waits; the child is stopped afterwards either way.
readSilentChild() -> string throws ProcessError {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("sleep 30",
        "ping -n 30 127.0.0.1 >NUL"));
    string ended = readLineOf(child);
    try child.kill();
    let status = try child.wait();
    return ended;
}

readLineOf(ChildProcess child) -> string {
    let line = try child.stdout().readLine();
    return "the read returned";
} catch (IoError failure) {
    bool cancelledCause = failure.cause is Cancelled;
    return "{failure.message} ({failure.kind}, caused by Cancelled: {cancelledCause})";
}

test "a read of a child's output in a cancelled task ends with a cancelled read" {
    string ended = try tasks.scope((scope) -> {
        scope.cancelAfter(50);
        let reading = scope.start(() -> try readSilentChild());
        return try reading.await();
    });
    try testing.assertEqual(ended, "could not read the standard output of '{support.interpreter()}': "
        + "the task was cancelled (Cancelled, caused by Cancelled: true)");
}
