// Tests for the shapes a spawn hands the operating system. The environment merge is the one with a
// rule that differs per system, and because it is given the system's name rather than asking for it,
// both rules are checked here whatever system runs these tests.
import @std.testing;
import @std.process;

// The merged variables as one line, so an assertion reads as the environment a child would see.
shown(string[] variables) -> string {
    return string.joined(variables, " ");
}

test "an override replaces the inherited entry naming the same variable" {
    string[] merged = process.mergedEnvironment(["HOME=/h", "PATH=/a"], ["PATH=/b"], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b");
}

test "an override naming nothing inherited joins the environment" {
    string[] merged = process.mergedEnvironment(["HOME=/h"], ["ENS_TOOLCHAIN=local"], "linux");
    try testing.assertEqual(shown(merged), "ENS_TOOLCHAIN=local HOME=/h");
}

test "no overrides leave the inherited environment as it was" {
    string[] merged = process.mergedEnvironment(["PATH=/a", "HOME=/h"], [], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/a");
}

test "on windows an override reaches an inherited name spelled in another case" {
    string[] merged = process.mergedEnvironment(["Path=/a", "HOME=/h"], ["PATH=/b"], "windows");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b");
}

test "on linux a name differing only in case is a second variable and both survive" {
    string[] merged = process.mergedEnvironment(["path=/a", "HOME=/h"], ["PATH=/b"], "linux");
    try testing.assertEqual(shown(merged), "HOME=/h PATH=/b path=/a");
}

test "on macos names match exactly, the way they do on linux" {
    string[] merged = process.mergedEnvironment(["path=/a"], ["PATH=/b"], "macos");
    try testing.assertEqual(shown(merged), "PATH=/b path=/a");
}

test "an entry's name is what stands before its first '='" {
    try testing.assertEqual(process.nameOf("PATH=/a=b"), "PATH");
    try testing.assertEqual(process.nameOf("BARE"), "BARE");
}

test "an environment block ends every entry and closes with one more terminator" {
    byte[] block = process.environmentBlock(["A=1", "B=2"]);
    try testing.assertTrue(block.length == 9,
        "the block is {block.length} bytes, expected 9 for 'A=1' and 'B=2'");
    try testing.assertTrue(block[3] == 0 && block[7] == 0 && block[8] == 0,
        "the entries and the block itself must each end in a terminator");
}

test "no variables give an empty block, which a spawn reads as inherit unchanged" {
    try testing.assertTrue(process.environmentBlock([]).length == 0,
        "an empty environment must give an empty block");
}

test "an argument block ends every argument and nothing more" {
    byte[] block = process.argumentBlock(["one", "two"]);
    try testing.assertTrue(block.length == 8,
        "the block is {block.length} bytes, expected 8 for 'one' and 'two'");
    try testing.assertTrue(block[3] == 0 && block[7] == 0,
        "every argument must end in a terminator");
}

test "a command line quotes every part so it splits back into the same values" {
    try testing.assertEqual(process.commandLineOf("git", ["commit", "-m", "a message"]),
        "\"git\" \"commit\" \"-m\" \"a message\"");
    try testing.assertEqual(process.commandLineOf("c:/a b/ens.exe", ["x\"y"]),
        "\"c:/a b/ens.exe\" \"x\\\"y\"");
}
