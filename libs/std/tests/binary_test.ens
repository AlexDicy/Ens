// Tests for the members of 'bytes': what each returns, and the edges the design fixes. The aborts
// are pinned by fixtures instead, since a broken contract ends the program rather than the test.
import @std.testing;

test "empty data is empty and nothing else is" {
    bytes none = [];
    bytes zero = [0];
    try testing.assertTrue(none.isEmpty(), "no bytes at all is empty");
    try testing.assertFalse(zero.isEmpty(), "a zero is a byte");
}

test "search returns the first offset, or -1" {
    bytes data = [1, 2, 3, 2, 3];
    bytes pair = [2, 3];
    bytes missing = [4];
    try testing.assertEqual(data.indexOf(pair), 1L);
    try testing.assertEqual(data.indexOf(missing), -1L);
    try testing.assertTrue(data.contains(pair), "a needle inside the data is found");
    try testing.assertFalse(data.contains(missing), "a needle that is not there is not found");
}

test "an empty needle is found at the start, and at the end looking back" {
    bytes data = [1, 2, 3];
    bytes none = [];
    try testing.assertEqual(data.indexOf(none), 0L);
    try testing.assertEqual(none.indexOf(none), 0L);
    try testing.assertEqual(data.lastIndexOf(none), 3L);
    try testing.assertTrue(data.contains(none), "all data holds the empty needle");
}

test "a search from an offset starts there, and one past the end finds nothing" {
    bytes data = [1, 2, 3, 2, 3];
    bytes two = [2];
    bytes none = [];
    try testing.assertEqual(data.indexOf(two, 2), 3L);
    try testing.assertEqual(data.indexOf(two, 4), -1L);
    try testing.assertEqual(data.indexOf(two, -4), 1L);
    try testing.assertEqual(data.indexOf(none, 99), -1L);
}

test "the last occurrence is found from the end" {
    bytes data = [1, 2, 3, 2, 3];
    bytes pair = [2, 3];
    bytes missing = [4];
    try testing.assertEqual(data.lastIndexOf(pair), 3L);
    try testing.assertEqual(data.lastIndexOf(missing), -1L);
}

test "a prefix or a suffix matches only whole and in place" {
    bytes data = [1, 2, 3];
    bytes start = [1, 2];
    bytes end = [2, 3];
    bytes longer = [1, 2, 3, 4];
    bytes none = [];
    try testing.assertTrue(data.startsWith(start), "the first bytes");
    try testing.assertFalse(data.startsWith(end), "bytes that are not first");
    try testing.assertTrue(data.endsWith(end), "the last bytes");
    try testing.assertFalse(data.endsWith(start), "bytes that are not last");
    try testing.assertTrue(data.startsWith(none) && data.endsWith(none), "an empty part");
    try testing.assertFalse(data.startsWith(longer) || data.endsWith(longer), "a longer part");
}

test "a slice from an offset runs to the end and is new data" {
    bytes data = [1, 2, 3];
    bytes tail = [2, 3];
    bytes none = [];
    try testing.assertTrue(data.slice(1) == tail, "the bytes after the first");
    try testing.assertTrue(data.slice(3) == none, "a slice from the end is empty");
    try testing.assertEqual(data.length, 3L);
}

test "an array and data copy each other, so writing one leaves the other as it was" {
    bytes data = [1, 2, 3];
    byte[] array = data.toArray();
    array[0] = 9;
    bytes made = bytes.of(array);
    array[1] = 8;
    bytes original = [1, 2, 3];
    bytes copied = [9, 2, 3];
    try testing.assertTrue(data == original, "the data an array was copied from");
    try testing.assertTrue(made == copied, "the data copied from an array");
    try testing.assertEqual(array[1], 8 as byte);
}
