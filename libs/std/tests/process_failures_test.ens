// Tests for what @std.process reports when a program cannot be started or driven: the kind a
// program acts on, the message a person reads, and the program the failure names.
import @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import Environment from @std.environment;
import @std.environment;
import Platform from @std.platform;
import BufferedReader from @std.io.buffered;
import Writer from @std.io.streams;
import ErrorKind as IoErrorKind from @std.io.streams;
import IoError from @std.io.streams;
import ErrorKind from @std.process;
import ProcessError from @std.process;
import @std.process;
import FirstLine from @std.process.reasons;
import StartCondition from @std.process.reasons;
import @std.process.reasons;
import CurrentDirectoryFile from process.support;
import process.support;

test "a program that is not there reports that nothing is there" {
    let scratch = try TemporaryDirectory.create("ens-std-process-missing");
    Path missing = scratch.path().join("missing-program");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(missing);
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    try testing.assertEqual(refused.message,
        "could not start '{missing}': nothing is there. Check that the path names the program");
    try testing.assertEqual(refused.program, missing.toString());
    // A start reports the platform's own number, and both number a program that is not there 2.
    try testing.assertEqual(refused.nativeError, 2);
}

test "a name no PATH directory holds is reported without starting anything" {
    string name = "ens-std-process-no-such-program";
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(Path(name));
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    try testing.assertEqual(refused.message,
        "could not start '{name}': no directory that the PATH environment variable lists "
            + "contains a program of that name. Check the name, or give the program's full path");
    try testing.assertEqual(refused.program, name);
    // The search returned before any system call, so there is no number to carry.
    try testing.assertEqual(refused.nativeError, 0);
}

test "a program with no name is refused" {
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let child = try process.spawn(Path(""));
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    try testing.assertEqual(refused.message, "could not start a program: no name was given");
    try testing.assertEqual(refused.program, "");
}

// POSIX refuses to run a file nobody may execute as a permission, and Windows refuses a file that
// is no program image as a format, so the kinds differ while the file's content decides the text.
test "a data file is refused as no program on every platform" {
    let scratch = try TemporaryDirectory.create("ens-std-process-data");
    Path data = scratch.path().join("data.bin");
    try data.writeText("not a program");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(data);
    });
    try testing.assertEqual(refused.program, data.toString());
    try testing.assertEqual(refused.message, "could not start '{data}': it is not a program. "
        + "Check that the path names a program, not a document or data file");
    if (support.onWindows()) {
        try testing.assertEqual(refused.kind, ErrorKind.Other);
        try testing.assertEqual(refused.nativeError, 193);
        return;
    }
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
}

test "a script nobody may execute is refused as a permission" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-script-mode");
    Path script = scratch.path().join("script");
    try script.writeText("#!/bin/sh\nexit 0\n");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(script);
    });
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(refused.message, "could not start '{script}': permission was "
        + "refused. Make the file executable, as with 'chmod +x', or start it as a user who may "
        + "run it");
}

// Each file may run, so only what it starts with keeps the system from running it.
test "a runnable file is told apart by how it starts" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-runnable");
    Path interpreted = scratch.path().join("interpreted");
    Path plain = scratch.path().join("plain");
    Path foreign = scratch.path().join("foreign");
    Path chained = scratch.path().join("chained");
    Path overlong = scratch.path().join("long");
    Path data = scratch.path().join("data.bin");
    Path overData = scratch.path().join("over-data");
    Path overFolder = scratch.path().join("over-folder");
    try interpreted.writeText("#!/no/such/interpreter -x\nexit 0\n");
    try plain.writeText("echo no first line\n");
    try foreign.writeText("\u007FELF, then nothing a program image holds\n");
    try chained.writeText("#!{plain}\nexit 0\n");
    try overlong.writeText("#!/{"no-such-directory/".repeat(34)}interpreter\nexit 0\n");
    try data.writeText("not a program");
    try overData.writeText("#!{data}\nexit 0\n");
    try overFolder.writeText("#!{scratch.path()}\nexit 0\n");
    let made = try process.runShell("chmod +x '{interpreted}' '{plain}' '{foreign}' '{chained}' "
        + "'{overlong}' '{overData}' '{overFolder}'");
    try testing.assertTrue(made.status.succeeded(), "the files were not made runnable");
    let notRunnable = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(overData);
    });
    try testing.assertEqual(notRunnable.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(notRunnable.message, "could not start '{overData}': its first line "
        + "names '{data}', which this user may not run. Make '{data}' executable, as with 'chmod "
        + "+x', or make the first line name a program this user may run");
    let folderNamed = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(overFolder);
    });
    try testing.assertEqual(folderNamed.message, "could not start '{overFolder}': its first line "
        + "names '{scratch.path()}', which is a directory, not a program. Make the first line "
        + "name a program, as in '#!/bin/sh'");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(chained);
    });
    try testing.assertEqual(refused.message, "could not start '{chained}': its first line names "
        + "'{plain}', which is not a program this system can run. Make the first line name a "
        + "program, as in '#!/bin/sh'");
    long limit = 256;
    string shorten = "Shorten the path of the program it names";
    if (environment.platform() == Platform.MacOS) {
        limit = 512;
        shorten = shorten + ", or the arguments after it";
    }
    let tooLong = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(overlong);
    });
    try testing.assertEqual(tooLong.message, "could not start '{overlong}': its first line is "
        + "longer than the {limit} bytes this system reads of it. {shorten}");
    let missing = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(interpreted);
    });
    try testing.assertEqual(missing.kind, ErrorKind.NotFound);
    try testing.assertEqual(missing.message, "could not start '{interpreted}': its first line "
        + "names '/no/such/interpreter', which is not there. Correct the first line, or install "
        + "that program");
    let unmarked = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(plain);
    });
    try testing.assertEqual(unmarked.message, "could not start '{plain}': it does not start the "
        + "way a program does. If it is a script, make its first line name the program that runs "
        + "it, as in '#!/bin/sh'");
    let image = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(foreign);
    });
    try testing.assertEqual(image.message, "could not start '{foreign}': it is not a program this "
        + "system can run. Check that the path names a program built for this system");
}

// A program nobody may run or read is refused as a permission, since what it holds cannot be read.
test "an unreadable program is refused as a permission" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-unreadable");
    Path locked = scratch.path().join("locked");
    try support.interpreter().copyTo(locked);
    let made = try process.runShell("chmod 000 '{locked}'");
    try testing.assertTrue(made.status.succeeded(), "the program was not locked");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(locked);
    });
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(refused.message, "could not start '{locked}': permission was refused. "
        + "Make the file executable, as with 'chmod +x', or start it as a user who may run it");
}

// POSIX refuses to run a named pipe as a permission. Reading its first bytes would wait for a
// writer that never comes, so a start that came back is the check that it was told apart without
// being opened.
test "a named pipe marked runnable is refused without being opened" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-pipe");
    Path pipe = scratch.path().join("pipe");
    let made = try process.runShell("mkfifo '{pipe}' && chmod +x '{pipe}'");
    try testing.assertTrue(made.status.succeeded(), "the named pipe was not made");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(pipe);
    });
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(refused.message, "could not start '{pipe}': it is a special file, such "
        + "as a named pipe or a device, not a program. Name the program's own file instead");
}

test "a directory is refused as a program and named as a directory" {
    let scratch = try TemporaryDirectory.create("ens-std-process-folder");
    Path tools = scratch.path().join("tools");
    try tools.createDirectories();
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(tools);
    });
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(refused.message, "could not start '{tools}': it is a directory, not a "
        + "program. Name the program inside the directory");
}

test "a working directory that is not there is named as the working directory" {
    let scratch = try TemporaryDirectory.create("ens-std-process-nowhere");
    Path gone = scratch.path().join("gone");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.runShell("exit 0", workingDirectory: gone);
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    try testing.assertEqual(refused.message, "could not start '{refused.program}': the working "
        + "directory '{gone}', the directory the program would run in, is not a directory that "
        + "exists. Create it, or start the program in one that does");
}

test "a working directory that is a file is named as a file" {
    let scratch = try TemporaryDirectory.create("ens-std-process-file-directory");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("not a directory");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.runShell("exit 0", workingDirectory: notes);
    });
    try testing.assertEqual(refused.message, "could not start '{refused.program}': the working "
        + "directory '{notes}' is a file, not a directory. Start the program in a directory");
}

test "only a missing file and a refused permission have kinds apart from Other" {
    try testing.assertEqual(process.kindOf(StartCondition.NotFound), ErrorKind.NotFound);
    try testing.assertEqual(process.kindOf(StartCondition.PermissionDenied),
        ErrorKind.PermissionDenied);
    for (let condition in [StartCondition.OutOfMemory, StartCondition.ProgramFileLimit,
            StartCondition.SystemFileLimit, StartCondition.ProcessLimit,
            StartCondition.SystemResources, StartCondition.Other]) {
        try testing.assertEqual(process.kindOf(condition), ErrorKind.Other);
    }
}

// The bridge numbers each condition the way StartCondition declares it, so each of this system's
// own numbers reads back as its condition, and a number the bridge leaves out reads as Other.
test "an error number's condition is the one the bridge's ordinal names" {
    int missing = 2;
    int denied = 13;
    if (support.onWindows()) {
        denied = 5;
    }
    try testing.assertEqual(reasons.conditionOf(missing), StartCondition.NotFound);
    try testing.assertEqual(reasons.conditionOf(denied), StartCondition.PermissionDenied);
    for (let row in setupNumbers()) {
        try testing.assertEqual(reasons.conditionOf(row.number), row.condition);
    }
    try testing.assertEqual(reasons.conditionOf(999999), StartCondition.Other);
}

// The text is chosen by the part of the start the code names and by the kind of the system's
// number, so each is rendered from a code built the way a bridge builds it. A number of 2 is a
// thing that is not there on every platform; a refused permission is 5 on Windows and 13 elsewhere.
test "each part of a failed start has a text of its own" {
    int denied = 13;
    if (support.onWindows()) {
        denied = 5;
    }
    int program = 1 << 24;
    int directory = 2 << 24;
    string where = "/work/build";
    try testing.assertEqual(text(program | 2, where),
        "could not start '/work/tool': nothing is there. Check that the path names the program");
    try testing.assertEqual(text(program | 999, where),
        "could not start '/work/tool': the system reported error 999");
    try testing.assertEqual(text(directory | 2, where),
        "could not start '/work/tool': the working directory '/work/build', the directory "
            + "the program would run in, is not a directory that exists. Create it, or start the "
            + "program in one that does");
    try testing.assertEqual(text(directory | denied, where),
        "could not start '/work/tool': permission to enter the working directory '/work/build' "
            + "was refused. Start the program in a directory this user may enter");
    try testing.assertEqual(text(directory | 999, where),
        "could not start '/work/tool': the working directory '/work/build' could not be entered: "
            + "the system reported error 999");
    try testing.assertEqual(text((3 << 24) | denied, ""),
        "could not start '/work/tool': it is a directory, not a program. Name the program "
            + "inside the directory");
    try testing.assertEqual(text((5 << 24) | 999, ""),
        "could not start '/work/tool': it is not a program. Check that the path names a "
            + "program, not a document or data file");
    try testing.assertEqual(text((6 << 24) | denied, ""),
        "could not start '/work/tool': it is a special file, such as a named pipe or a device, "
            + "not a program. Name the program's own file instead");
    try testing.assertEqual(text((4 << 24) | 999, ""),
        "could not start '/work/tool': it is not a program this system can run. Check that the "
            + "path names a program built for this system");
    try testing.assertEqual(text((7 << 24) | 20, where),
        "could not start '/work/tool': the working directory '/work/build' is a file, not a "
            + "directory. Start the program in a directory");
    try testing.assertEqual(text((8 << 24) | 2, ""),
        "could not start '/work/tool': its first line names a program that is not there. "
            + "Correct the first line, or install that program");
    try testing.assertEqual(process.startFailure("/work/tool", "", (8 << 24) | 2, Platform.Linux,
        "", {program: "/usr/bin/python9", longerThan: 0}).message,
        "could not start '/work/tool': its first line names '/usr/bin/python9', which is not "
            + "there. Correct the first line, or install that program");
    try testing.assertEqual(text((9 << 24) | 8, ""),
        "could not start '/work/tool': it does not start the way a program does. If it is a "
            + "script, make its first line name the program that runs it, as in '#!/bin/sh'");
    try testing.assertEqual(text((10 << 24) | denied, ""),
        "could not start '/work/tool': permission was refused. Check that the file is "
            + "executable, as with 'chmod +x', and that this user may open every directory on its "
            + "path");
    try testing.assertEqual(scriptText({program: "/work/plain", longerThan: 0}),
        "could not start '/work/tool': its first line names '/work/plain', which is not a program "
            + "this system can run. Make the first line name a program, as in '#!/bin/sh'");
    try testing.assertEqual(scriptText(noLine()),
        "could not start '/work/tool': its first line names no program this system can run. Make "
            + "the first line name a program, as in '#!/bin/sh'");
    try testing.assertEqual(scriptText({program: "", longerThan: 256}),
        "could not start '/work/tool': its first line is longer than the 256 bytes this system "
            + "reads of it. Shorten the path of the program it names");
    try testing.assertEqual(process.startFailure("/work/tool", "", (11 << 24) | 8,
        Platform.MacOS, "", {program: "", longerThan: 512}).message,
        "could not start '/work/tool': its first line is longer than the 512 bytes this system "
            + "reads of it. Shorten the path of the program it names, or the arguments after it");
}

// A runnable script refused as a permission is refused over the program its first line names,
// which is told apart by whether it is a directory.
test "a script whose first line names a program this user may not run names that program" {
    let scratch = try TemporaryDirectory.create("ens-std-process-refused-interpreter");
    Path folder = scratch.path();
    try testing.assertEqual(refusedScriptText({program: "/work/data.bin", longerThan: 0}),
        "could not start '/work/tool': its first line names '/work/data.bin', which this user may "
            + "not run. Make '/work/data.bin' executable, as with 'chmod +x', or make the first "
            + "line name a program this user may run");
    try testing.assertEqual(refusedScriptText({program: folder.toString(), longerThan: 0}),
        "could not start '/work/tool': its first line names '{folder}', which is a directory, not "
            + "a program. Make the first line name a program, as in '#!/bin/sh'");
    try testing.assertEqual(refusedScriptText(noLine()),
        "could not start '/work/tool': its first line names a program this user may not run. "
            + "Make the first line name a program this user may run");
}

// The message a script at '/work/tool' that the system would not start reads, on Linux.
scriptText(FirstLine line) -> string {
    return process.startFailure("/work/tool", "", (11 << 24) | 8, Platform.Linux, "", line).message;
}

// The message a runnable script at '/work/tool' refused as a permission reads, on Linux. A
// refused permission is numbered 5 on Windows and 13 elsewhere.
refusedScriptText(FirstLine line) -> string {
    int denied = 13;
    if (support.onWindows()) {
        denied = 5;
    }
    return process.startFailure("/work/tool", "", (11 << 24) | denied, Platform.Linux, "", line)
        .message;
}

test "a refused permission says what to do on each platform" {
    int denied = 13;
    if (support.onWindows()) {
        denied = 5;
    }
    int code = (1 << 24) | denied;
    try testing.assertEqual(process.startFailure("/work/tool", "", code, Platform.Linux, "",
        noLine()).message,
        "could not start '/work/tool': permission was refused. Make the file executable, as with "
            + "'chmod +x', or start it as a user who may run it");
    try testing.assertEqual(process.startFailure("/work/tool", "", code, Platform.Windows, "",
        noLine()).message,
        "could not start '/work/tool': permission was refused. Check that this user may run the "
            + "file");
}

// Windows runs a program named without its '.exe' only when it is found on PATH, so a path written
// without it names no file even when the program sits beside that path.
test "a path missing its '.exe' is offered the name with it" {
    let failure = process.startFailure("C:/work/tool", "", (1 << 24) | 2, Platform.Windows,
        "C:/work/tool.exe", noLine());
    try testing.assertEqual(failure.message, "could not start 'C:/work/tool': nothing is there, "
        + "but 'C:/work/tool.exe' is. Write the name with its '.exe'");
    if (!support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-exe");
    Path tool = scratch.path().join("tool");
    try scratch.path().join("tool.exe").writeText("not run");
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(tool);
    });
    try testing.assertEqual(refused.message, "could not start '{tool}': nothing is there, but "
        + "'{tool}.exe' is. Write the name with its '.exe'");
}

test "each condition of setting a start up has a text of its own" {
    try testing.assertEqual(reasons.setupReason(StartCondition.OutOfMemory, 12), "there was not "
        + "enough memory to prepare the new process: the system reported error 12");
    try testing.assertEqual(reasons.setupReason(StartCondition.ProgramFileLimit, 24), "the "
        + "program starting it has reached its limit on open files: the system reported error "
        + "24. Close files that program no longer needs, or raise the limit with 'ulimit -n' "
        + "before running that program again");
    try testing.assertEqual(reasons.setupReason(StartCondition.SystemFileLimit, 23), "the system "
        + "has reached its limit on how many files all programs together may have open: the "
        + "system reported error 23. Close programs that are no longer needed");
    try testing.assertEqual(reasons.setupReason(StartCondition.ProcessLimit, 11), "the system "
        + "allows no more processes, for this user or in total: the system reported error 11. "
        + "Wait for some programs to end, or raise this user's limit with 'ulimit -u'");
    try testing.assertEqual(reasons.setupReason(StartCondition.SystemResources, 1450), "there "
        + "were not enough system resources to prepare the new process: the system reported "
        + "error 1450");
    for (let condition in [StartCondition.NotFound, StartCondition.PermissionDenied,
            StartCondition.Other]) {
        try testing.assertEqual(reasons.setupReason(condition, 999),
            "the new process could not be prepared: the system reported error 999");
    }
}

// A code with no part above its number comes from setting the start up, so its text is the one
// for the condition this system's number means, and a number that means a missing or refused file
// names no program and no working directory.
test "a code that names no part of the start names the condition of setting it up" {
    for (let row in setupNumbers()) {
        try testing.assertEqual(process.startFailure("/work/tool", "", row.number,
            environment.platform(), "", noLine()).message,
            "could not start '/work/tool': {reasons.setupReason(row.condition, row.number)}");
    }
    try testing.assertEqual(text(2, "/work/build"), "could not start '/work/tool': the new "
        + "process could not be prepared: the system reported error 2");
    let failure = process.startFailure("/work/tool", "", (1 << 24) | 2, Platform.Linux, "",
        noLine());
    try testing.assertEqual(failure.nativeError, 2);
}

// Each condition this system reports a setup failure under, beside the number it reports it with.
setupNumbers() -> SetupNumber[] {
    if (support.onWindows()) {
        return [{number: 8, condition: StartCondition.OutOfMemory},
            {number: 14, condition: StartCondition.OutOfMemory},
            {number: 1450, condition: StartCondition.SystemResources}];
    }
    int tryAgain = 11;
    if (environment.platform() == Platform.MacOS) {
        tryAgain = 35;
    }
    return [{number: 12, condition: StartCondition.OutOfMemory},
        {number: 24, condition: StartCondition.ProgramFileLimit},
        {number: 23, condition: StartCondition.SystemFileLimit},
        {number: tryAgain, condition: StartCondition.ProcessLimit}];
}

struct SetupNumber {
    const int number;
    const StartCondition condition;
}

// A file of the name is in this process's current directory, and the PATH the child is given
// names an empty directory instead, so finding it would mean the current directory was searched.
test "the current directory is never searched for a program" {
    string name = "ens-std-process-cwd-probe";
    string fileName = name;
    if (support.onWindows()) {
        fileName = name + ".exe";
    }
    let probe = try CurrentDirectoryFile.create(fileName);
    let scratch = try TemporaryDirectory.create("ens-std-process-empty-path");
    let given = Environment.current();
    given.set("PATH", scratch.path().toString());
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(Path(name), environment: given);
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    try testing.assertTrue(probe.path().isFile(), "the probe was there to be found");
}

// Every PATH directory holds a script of the name nobody may execute, so a start passes over each
// and reports the first refusal once the last has been tried.
test "a program refused in every PATH directory reports the first refusal" {
    if (support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-refused");
    Path first = scratch.path().join("first");
    Path second = scratch.path().join("second");
    try first.createDirectories();
    try second.createDirectories();
    try first.join("ens-std-process-probe").writeText("#!/bin/sh\necho first\n");
    try second.join("ens-std-process-probe").writeText("#!/bin/sh\necho second\n");
    let given = Environment.current();
    given.set("PATH", first.toString() + ":" + second.toString());
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(Path("ens-std-process-probe"), environment: given);
    });
    try testing.assertEqual(refused.kind, ErrorKind.PermissionDenied);
    try testing.assertEqual(refused.message,
        "could not start 'ens-std-process-probe': permission was refused. Make the file "
            + "executable, as with 'chmod +x', or start it as a user who may run it");
    try testing.assertEqual(refused.program, "ens-std-process-probe");
}

// A script is found by name only through the interpreter, which reads PATHEXT; the search of `run`
// looks for `name.exe` alone, because starting a script directly would run cmd.exe without the
// caller having requested a shell.
test "on Windows a script is not found by name without its extension" {
    if (!support.onWindows()) {
        return;
    }
    let scratch = try TemporaryDirectory.create("ens-std-process-script");
    try scratch.path().join("tool.cmd").writeText("@echo tool\r\n");
    let given = Environment.current();
    given.set("PATH", scratch.path().toString());
    let refused = try testing.assertThrows<ProcessError>(() -> {
        let result = try process.run(Path("tool"), environment: given);
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    let result = try process.runShell("tool", environment: given, captureOutput: true);
    try testing.assertTrue(result.status.succeeded(), "the shell failed: {result.stderr}");
    try testing.assertEqual(support.lines(result.stdout), ["tool"]);
}

test "writing to a child that has gone reports the pipe as closed" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 0",
        "exit 0"));
    let ended = try child.wait();
    try testing.assertEqual(ended.code, 0);
    let refused = try testing.assertThrows<IoError>(() -> {
        try child.input().write("late\n".toBytes());
    });
    try testing.assertEqual(refused.kind, IoErrorKind.Closed);
    try testing.assertEqual(refused.message,
        "could not write to the input of '{support.interpreter()}': the stream is closed");
    // A process bridge returns the platform's own number. Windows reports one of two, each pinned
    // in the native tests as meaning a pipe nobody reads.
    if (support.onWindows()) {
        try testing.assertTrue(refused.nativeError == 109 || refused.nativeError == 232,
            "a closed pipe reported {refused.nativeError}, which is neither ERROR_BROKEN_PIPE "
            + "nor ERROR_NO_DATA");
    } else {
        try testing.assertEqual(refused.nativeError, 32);
    }
}

test "writing after closing the input reports the pipe as closed" {
    let child = try process.spawn(support.interpreter(), support.scriptArguments(
        "cat >/dev/null", "set /p a=& exit 0"));
    try child.closeInput();
    try child.closeInput();
    let refused = try testing.assertThrows<IoError>(() -> {
        try child.input().write("late\n".toBytes());
    });
    try testing.assertEqual(refused.kind, IoErrorKind.Closed);
    let ended = try child.wait();
    try testing.assertEqual(ended.code, 0);
}

// The message a start of '/work/tool' in `directory` that failed with `code` reads, on Linux.
text(int code, string directory) -> string {
    return process.startFailure("/work/tool", directory, code, Platform.Linux, "", noLine())
        .message;
}

// A script line that names nothing, which every part but a script's own leaves unread.
noLine() -> FirstLine {
    return {program: "", longerThan: 0};
}

// The child value is destroyed when this returns, and the reader taken from it outlives it.
orphanReader() -> BufferedReader throws {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 0",
        "exit 0"));
    let status = try child.wait();
    return child.stdout();
}

// The child value is destroyed when this returns, and the writer taken from it outlives it.
orphanWriter() -> Writer throws {
    let child = try process.spawn(support.interpreter(), support.scriptArguments("exit 0",
        "exit 0"));
    let status = try child.wait();
    return child.input();
}

test "a writer kept after the child value was dropped reports the child as dropped" {
    let orphan = try orphanWriter();
    let refused = try testing.assertThrows<IoError>(() -> {
        try orphan.write("late\n".toBytes());
    });
    try testing.assertEqual(refused.kind, IoErrorKind.Closed);
    try testing.assertEqual(refused.message, "could not write to the input of "
        + "'{support.interpreter()}': the ChildProcess it came from has been destroyed, so the "
        + "stream is closed. Keep the ChildProcess in a variable while its input is written");
}

test "a reader kept after the child value was dropped reports the child as dropped" {
    let orphan = try orphanReader();
    let refused = try testing.assertThrows<IoError>(() -> {
        let line = try orphan.readLine();
    });
    try testing.assertEqual(refused.kind, IoErrorKind.Closed);
    try testing.assertEqual(refused.message, "could not read the standard output of "
        + "'{support.interpreter()}': the ChildProcess it came from has been destroyed, so the "
        + "stream is closed. Keep the ChildProcess in a variable while its standard output is "
        + "read");
}
