// Tests for what Path does to a real file system when the operation succeeds: files read and
// written, directories made and walked, and the guards that remove what they made.
import @std.testing;
import Path from @std.fs;
import @std.fs;
import Entry from @std.fs.entry;
import Walker from @std.fs.entry;
import EntryKind from @std.fs.metadata;
import Metadata from @std.fs.metadata;
import FileSystemError from @std.fs.error;
import ErrorKind from @std.fs.error;
import TemporaryDirectory from @std.fs.temporary;
import TemporaryFile from @std.fs.temporary;
import Platform from @std.system;
import @std.environment;
import @std.process;
import List from @std.collections.list;

test "a file written is a file read back" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-write");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("hello");
    try testing.assertEqual(try notes.readText(), "hello");
    try testing.assertEqual(try notes.readBytes(), "hello".toBytes());

    try testing.assertTrue(notes.exists(), "'{notes}' is there once it has been written");
    try testing.assertTrue(notes.isFile(), "'{notes}' is a file");
    try testing.assertFalse(notes.isDirectory(), "'{notes}' is not a directory");
    try testing.assertTrue(scratch.path().isDirectory(), "the scratch root is a directory");
}

test "writing over a file replaces everything it held" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-replace");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("a much longer first version");
    try notes.writeText("short");
    try testing.assertEqual(try notes.readText(), "short");
}

test "appending adds to what a file already holds" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-append");
    Path log = scratch.path().join("log.txt");
    try log.writeText("first\n");
    let stream = try log.append();
    try stream.write("second\n".toBytes());
    try stream.close();
    try testing.assertEqual(try log.readText(), "first\nsecond\n");
}

test "bytes with no text in them survive a write and a read" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-bytes");
    Path blob = scratch.path().join("blob.bin");
    byte[] content = new byte[512];
    for (long i = 0; i < content.length; i++) {
        content[i] = (i % 256) as byte;
    }
    try blob.writeBytes(content);
    try testing.assertEqual(try blob.readBytes(), content);
    Metadata? found = try blob.metadata();
    if (found == null) {
        try testing.fail("'{blob}' should be there right after it was written");
    } else {
        try testing.assertEqual(found.length, 512L);
    }
}

test "metadata reports what is at a path and returns null where nothing is" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-metadata");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("12345");

    Metadata? file = try notes.metadata();
    if (file == null) {
        try testing.fail("'{notes}' should be there right after it was written");
    } else {
        try testing.assertEqual(file.kind, EntryKind.File);
        try testing.assertEqual(file.length, 5L);
        try testing.assertTrue(file.modifiedMillis >= Window.earliest,
            "a file written now reports {file.modifiedMillis}, which is before 2025");
    }

    Metadata? directory = try scratch.path().metadata();
    if (directory == null) {
        try testing.fail("the scratch root should be there");
    } else {
        try testing.assertEqual(directory.kind, EntryKind.Directory);
        try testing.assertEqual(directory.length, 0L);
    }

    try testing.assertTrue(try scratch.path().join("nothing").metadata() == null,
        "an absence is the one answer metadata gives instead of failing");
    try testing.assertFalse(scratch.path().join("nothing").exists(),
        "nothing is at a name nothing was written to");
}

// A reader of the target reads the old content or the new, so what has to be true afterwards is
// that the content moved over in one piece and that the sibling the write went through is gone.
test "an atomic write replaces the content and leaves no sibling behind" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-atomic");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("old");
    try notes.writeTextAtomic("new");
    try testing.assertEqual(try notes.readText(), "new");
    try testing.assertEqual(try namesUnder(scratch.path()), ["notes.txt"]);

    try notes.writeBytesAtomic("newer".toBytes());
    try testing.assertEqual(try notes.readText(), "newer");
    try testing.assertEqual(try namesUnder(scratch.path()), ["notes.txt"]);
}

test "an atomic write creates a file that was not there yet" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-atomic-new");
    Path notes = scratch.path().join("fresh.txt");
    try notes.writeTextAtomic("content");
    try testing.assertEqual(try notes.readText(), "content");
    try testing.assertEqual(try namesUnder(scratch.path()), ["fresh.txt"]);
}

test "createDirectories makes every level and leaves an existing one alone" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-levels");
    Path deep = scratch.path().join("a/b/c");
    try deep.createDirectories();
    try testing.assertTrue(deep.isDirectory(), "'{deep}' is there");
    try testing.assertTrue(scratch.path().join("a").isDirectory(), "the first level is there");
    try testing.assertTrue(scratch.path().join("a/b").isDirectory(), "the second level is there");
    try deep.createDirectories();
    try testing.assertTrue(deep.isDirectory(), "asking again leaves the directory alone");
}

// Two programs racing for one name both come through this call, and the result is what
// distinguishes them, so exactly one of any two calls over the same name may return true.
test "createDirectoryExclusive returns true only for the call that created the directory" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-exclusive");
    Path claimed = scratch.path().join("claimed");
    try testing.assertTrue(try claimed.createDirectoryExclusive(),
        "the first call is the one that created it");
    try testing.assertFalse(try claimed.createDirectoryExclusive(),
        "the second call finds a directory already there");
}

// The order is the file system's to enumerate in and the library's to return in, so what is pinned
// here is byte order rather than any order a particular file system happens to enumerate in.
test "entries returns what is directly inside in ascending byte order of name" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-entries");
    Path root = scratch.path();
    try root.join("b.txt").writeText("b");
    try root.join("a.txt").writeText("a");
    try root.join("C.txt").writeText("c");
    try root.join("sub").createDirectories();
    try root.join("sub/deep.txt").writeText("d");

    try testing.assertEqual(try namesUnder(root), ["C.txt", "a.txt", "b.txt", "sub"]);
    try testing.assertEqual(try namesUnder(root.join("sub")), ["deep.txt"]);

    let kinds = new List<string>();
    for (let child in try root.entries()) {
        kinds.push("{child.name}:{child.kind}");
        try testing.assertEqual(child.path, root.join(child.name));
    }
    try testing.assertEqual(kinds.toArray(),
        ["C.txt:File", "a.txt:File", "b.txt:File", "sub:Directory"]);
}

test "an empty directory has no entries at all" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-empty");
    Path bare = scratch.path().join("bare");
    try bare.createDirectories();
    try testing.assertEqual(try namesUnder(bare), []);
}

test "walk visits a tree depth first, each level in the order entries returns" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walk");
    Path root = scratch.path();
    try root.join("one/two").createDirectories();
    try root.join("one/two/leaf.txt").writeText("leaf");
    try root.join("one/beside.txt").writeText("beside");
    try root.join("zz.txt").writeText("last");

    try testing.assertEqual(try walkedNames(root),
        ["one", "beside.txt", "two", "leaf.txt", "zz.txt"]);
}

test "a walker returns what walk returns, in the same order" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walker");
    Path root = scratch.path();
    try root.join("one/two").createDirectories();
    try root.join("one/two/leaf.txt").writeText("leaf");
    try root.join("one/beside.txt").writeText("beside");
    try root.join("zz.txt").writeText("last");

    try testing.assertEqual(try walkerNames(root.walker()),
        ["one", "beside.txt", "two", "leaf.txt", "zz.txt"]);
    try testing.assertEqual(try walkerNames(root.walker()), try walkedNames(root));
}

// A directory is read when the walk gets to it, and all of it before the walk goes further down,
// so a name added to the root after the walk started is not returned, while one added to a
// directory the walk has not reached yet is.
test "a walker reads each directory when it gets there, and all of it at once" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walker-lazy");
    Path root = scratch.path();
    try root.join("one").createDirectories();
    try root.join("one/early.txt").writeText("early");
    try root.join("two").createDirectories();

    let walker = root.walker();
    let first = try walker.next();
    try testing.assertEqual(first?.name ?? "", "one");
    try root.join("added.txt").writeText("too late for the root");
    try root.join("two/late.txt").writeText("read when the walk gets here");
    try testing.assertEqual(try walkerNames(walker), ["early.txt", "two", "late.txt"]);
}

// Skipping right after a directory leaves out everything under it, and skipping after a file,
// which has nothing under it, changes nothing.
test "skip leaves out the directory the walker returned last" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walker-skip");
    Path root = scratch.path();
    try root.join("a/inner").createDirectories();
    try root.join("a/inner/deep.txt").writeText("deep");
    try root.join("a/held.txt").writeText("held");
    try root.join("b.txt").writeText("b");
    try root.join("c").createDirectories();
    try root.join("c/kept.txt").writeText("kept");

    let walker = root.walker();
    let found = new List<string>();
    Entry? next = try walker.next();
    while (next != null) {
        found.push(next.name);
        if (next.name == "a" || next.name == "b.txt") {
            walker.skip();
        }
        next = try walker.next();
    }
    try testing.assertEqual(found.toArray(), ["a", "b.txt", "c", "kept.txt"]);
}

// The failure names the directory that could not be read, and the walk is over once it has
// thrown, even though entries the walk had not reached are still there.
test "a walker that fails to read a directory ends there" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walker-fails");
    Path root = scratch.path();
    try root.join("gone").createDirectories();
    try root.join("still.txt").writeText("still");

    let walker = root.walker();
    let first = try walker.next();
    try testing.assertEqual(first?.name ?? "", "gone");
    try root.join("gone").removeDirectory();
    let failure = try testing.assertThrows<FileSystemError>(() -> {
        let never = try walker.next();
    });
    string gone = root.join("gone").toString();
    try testing.assertTrue(failure.message.indexOf(gone) >= 0, failure.message);
    let after = try walker.next();
    try testing.assertTrue(after == null, "a walk that threw returned another entry");

    let missing = root.join("missing").walker();
    let refused = try testing.assertThrows<FileSystemError>(() -> {
        let never = try missing.next();
    });
    try testing.assertEqual(refused.kind, ErrorKind.NotFound);
    let afterRefusal = try missing.next();
    try testing.assertTrue(afterRefusal == null, "a walk that threw returned an entry");
}

// The walk that follows links goes into a link the way it goes into a directory, so skipping
// right after one leaves out what the link names.
test "skip leaves out a linked directory a walker would follow" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-walker-link");
    Path tree = scratch.path().join("tree");
    Path beside = scratch.path().join("beside");
    try tree.createDirectories();
    try beside.createDirectories();
    try beside.join("held.txt").writeText("held");
    try testing.assertTrue(try linked(beside, tree.join("beside-link")),
        "this system would not make a link under '{tree}' to test with");

    try testing.assertEqual(try walkerNames(tree.walker(followLinks: true)),
        ["beside-link", "held.txt"]);
    let walker = tree.walker(followLinks: true);
    let link = try walker.next();
    try testing.assertEqual(link?.name ?? "", "beside-link");
    walker.skip();
    let after = try walker.next();
    try testing.assertTrue(after == null, "the skipped link was followed");
}

// A link pointing at its own parent is a cycle, so a walk that followed it would never end. The
// link is made through the system's own command, and Windows makes a junction, which needs no
// privilege a test run may lack.
test "walk reports a symbolic link and does not follow it" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-link");
    Path tree = scratch.path().join("tree");
    try tree.join("inner").createDirectories();
    try tree.join("inner/file.txt").writeText("inner");
    Path loop = tree.join("loop");
    try testing.assertTrue(try linked(tree, loop),
        "this system would not make a link under '{tree}' to test with");

    try testing.assertEqual(try walkedNames(tree), ["inner", "file.txt", "loop"]);
    for (let child in try tree.entries()) {
        if (child.name == "loop") {
            try testing.assertEqual(child.kind, EntryKind.Symlink);
        }
    }

    // Removing a tree must remove a link as the link it is, so what the link pointed at is still
    // there after the removal, and nothing else is.
    try loop.removeRecursively();
    try testing.assertFalse(loop.exists(), "the link itself is gone");
    try testing.assertEqual(try tree.join("inner/file.txt").readText(), "inner");
}

// The link points at its own parent, so a walk that entered it twice would never end. It is entered
// once, which is what the walk's result shows, and the link is still reported as the link it is.
test "a walk that follows links enters a place it has already been only once" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-follow-loop");
    Path tree = scratch.path().join("tree");
    try tree.join("inner").createDirectories();
    try tree.join("inner/file.txt").writeText("inner");
    Path loop = tree.join("loop");
    try testing.assertTrue(try linked(tree, loop),
        "this system would not make a link under '{tree}' to test with");

    try testing.assertEqual(try followedNames(tree), ["inner", "file.txt", "loop"]);
    // A walk that follows nothing returns the same over this tree, since the link is its only
    // entry that could be entered at all.
    try testing.assertEqual(try walkedNames(tree), ["inner", "file.txt", "loop"]);
}

// A link out of the tree is where following is worth having, since the entries it reaches are
// there under a path the walk was given and nowhere else in the result.
test "a walk that follows links enters one that leaves the tree" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-follow-out");
    Path tree = scratch.path().join("tree");
    Path beside = scratch.path().join("beside");
    try tree.createDirectories();
    try beside.join("deeper").createDirectories();
    try beside.join("held.txt").writeText("held");
    try beside.join("deeper/deep.txt").writeText("deep");
    Path linkedBeside = tree.join("beside-link");
    try testing.assertTrue(try linked(beside, linkedBeside),
        "this system would not make a link under '{tree}' to test with");

    try testing.assertEqual(try followedNames(tree),
        ["beside-link", "deeper", "deep.txt", "held.txt"]);
    // A walk that follows nothing reports the link and stops there.
    try testing.assertEqual(try walkedNames(tree), ["beside-link"]);

    // Removing the tree never follows the link, whatever a walk over it was configured to do, so what
    // is outside the tree is still there afterwards.
    try tree.removeRecursively();
    try testing.assertFalse(tree.exists(), "the tree is gone");
    try testing.assertEqual(try beside.join("held.txt").readText(), "held");
    try testing.assertEqual(try beside.join("deeper/deep.txt").readText(), "deep");
}

// A link's target comes back exactly as the link stores it, so a relative one stays relative, and
// one whose target is gone still has one. Windows makes these tests' links as junctions, which
// store an absolute target.
test "linkTarget returns what a link stores, and null for what is not a link" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-link-target");
    Path beside = scratch.path().join("beside");
    try beside.createDirectories();
    Path link = scratch.path().join("link");
    try testing.assertTrue(try linked(beside, link),
        "this system would not make a link under '{scratch.path()}' to test with");
    try testing.assertTrue(try link.linkTarget() == beside, "the target is the linked directory");
    Path file = scratch.path().join("file.txt");
    try file.writeText("not a link");
    try testing.assertTrue(try file.linkTarget() == null, "a file is not a link");
    try testing.assertTrue(try beside.linkTarget() == null, "a directory is not a link");
    if (environment.platform() != Platform.Windows) {
        Path dangling = scratch.path().join("dangling");
        let made = try process.runShell("ln -s 'nowhere/below' '{dangling}'");
        try testing.assertTrue(made.status.succeeded(), "the relative link was not made");
        try testing.assertTrue(try dangling.linkTarget() == Path("nowhere/below"),
            "the relative target is kept as written");
    }
}

// A name only the system substitutes, as a volume mount point stores, keeps the form Win32 reads.
test "a Windows link's substituted name is turned into a path Win32 accepts" {
    try testing.assertEqual(fs.windowsLinkText("\\??\\C:\\work\\target"), "C:\\work\\target");
    try testing.assertEqual(fs.windowsLinkText("\\??\\UNC\\server\\share\\folder"),
        "\\\\server\\share\\folder");
    try testing.assertEqual(fs.windowsLinkText("\\??\\Volume\{a338a9fb-6a8f-4edb-a80b\}\\"),
        "\\\\?\\Volume\{a338a9fb-6a8f-4edb-a80b\}\\");
    try testing.assertEqual(fs.windowsLinkText("C:\\work\\written"), "C:\\work\\written");
    try testing.assertEqual(fs.windowsLinkText("relative\\target"), "relative\\target");
}

test "linkTarget of a path where nothing is there is refused" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-link-missing");
    Path missing = scratch.path().join("missing");
    let refused = try testing.assertThrows<FileSystemError>(() -> {
        let target = try missing.linkTarget();
    });
    try testing.assertEqual(refused.message,
        "could not read the link '{missing}': nothing is there");
}

test "removeRecursively removes a whole tree and leaves nothing behind" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-remove-tree");
    Path tree = scratch.path().join("tree");
    try tree.join("a/b").createDirectories();
    try tree.join("a/b/deep.txt").writeText("deep");
    try tree.join("a/beside.txt").writeText("beside");
    try tree.join("top.txt").writeText("top");

    try tree.removeRecursively();
    try testing.assertFalse(tree.exists(), "'{tree}' is gone");
    try testing.assertEqual(try namesUnder(scratch.path()), []);
}

test "removeFile and removeDirectory each remove one thing" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-remove-one");
    Path root = scratch.path();
    Path notes = root.join("notes.txt");
    Path bare = root.join("bare");
    try notes.writeText("gone soon");
    try bare.createDirectories();

    try notes.removeFile();
    try testing.assertFalse(notes.exists(), "the file is gone");
    try bare.removeDirectory();
    try testing.assertFalse(bare.exists(), "the directory is gone");
    try testing.assertEqual(try namesUnder(root), []);
}

// The result is what distinguishes two programs racing for one name, so a destination that is taken
// is a result rather than a failure.
test "moveTo moves in one step and returns false where something is already there" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-move");
    Path root = scratch.path();
    Path from = root.join("from.txt");
    Path to = root.join("to.txt");
    try from.writeText("content");

    try testing.assertTrue(try from.moveTo(to), "the move happened");
    try testing.assertFalse(from.exists(), "the source is gone");
    try testing.assertEqual(try to.readText(), "content");

    try from.writeText("second");
    try testing.assertFalse(try from.moveTo(to), "the destination was already taken");
    // The destination and the source are both left exactly as they were.
    try testing.assertEqual(try to.readText(), "content");
    try testing.assertEqual(try from.readText(), "second");
}

// With 'replace' the move goes over what is at the destination in one step, and over nothing just
// as well, so it always reports the move.
test "moveTo with replace moves over what is already there" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-move-replace");
    Path root = scratch.path();
    Path from = root.join("from.txt");
    Path to = root.join("to.txt");
    try from.writeText("first");

    try testing.assertTrue(try from.moveTo(to, true), "a move to a free name happened");
    try testing.assertFalse(from.exists(), "the source is gone");
    try testing.assertEqual(try to.readText(), "first");

    try from.writeText("second");
    try testing.assertTrue(try from.moveTo(to, true), "the move over a taken name happened");
    try testing.assertFalse(from.exists(), "the source is gone again");
    try testing.assertEqual(try to.readText(), "second");
}

test "copyTo copies the content and replaces what was at the destination" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-copy");
    Path root = scratch.path();
    Path from = root.join("from.txt");
    Path to = root.join("to.txt");
    try from.writeText("copied");
    try to.writeText("a much longer thing that was there before");

    try from.copyTo(to);
    try testing.assertEqual(try to.readText(), "copied");
    try testing.assertEqual(try from.readText(), "copied");
}

// The result is compared against the real path of the directory the test made, because the
// operating system is free to return a different spelling of the same place than the one it
// was given. The directory the '..' walks through is created first, since resolving reads every
// part of the path rather than removing '..' from the text.
test "realPath resolves the parts of a path away" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-real");
    Path root = try scratch.path().realPath();
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("real");
    try scratch.path().join("through").createDirectories();

    try testing.assertEqual(try scratch.path().join("./notes.txt").realPath(),
        root.join("notes.txt"));
    try testing.assertEqual(try scratch.path().join("through/../notes.txt").realPath(),
        root.join("notes.txt"));
    try testing.assertTrue((try notes.realPath()).isAbsolute(),
        "a resolved path names its place on its own");
}

test "a file can be used wherever a reader or a writer can" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-stream");
    Path notes = scratch.path().join("notes.txt");
    let target = try notes.create();
    try target.write("streamed".toBytes());
    try target.flush();
    // Closing a file twice is allowed, and the second call does nothing.
    try target.close();
    try target.close();

    let source = try notes.open();
    byte[] buffer = new byte[64];
    long count = try source.read(buffer);
    try testing.assertEqual(count, 8L);
    try testing.assertEqual(buffer.slice(0, count), "streamed".toBytes());
    // A read returns 0 only once the stream has ended, so a caller can stop on that alone.
    try testing.assertEqual(try source.read(buffer), 0L);
    try source.close();
}

// A second open of the same file holds it the way another program would, so one process is enough
// to see the lock keep out a second holder.
test "tryLock takes a file's lock once, until the file holding it is closed" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-lock");
    Path marker = scratch.path().join("marker");
    try marker.writeText("");
    let first = try marker.open();
    let second = try marker.open();
    try testing.assertTrue(try first.tryLock(), "the first file did not take the free lock");
    try testing.assertTrue(try first.tryLock(), "a file holding its lock was refused it");
    try testing.assertFalse(try second.tryLock(), "a second file took a lock the first holds");
    try first.close();
    try testing.assertTrue(try second.tryLock(), "a lock its holder closed was not taken again");
    try second.close();
}

test "a file's lock does not keep anyone from reading or writing it" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-lock-use");
    Path notes = scratch.path().join("notes.txt");
    try notes.writeText("first");
    let holder = try notes.open();
    try testing.assertTrue(try holder.tryLock(), "the free lock was not taken");
    let writer = try notes.append();
    try writer.write(" second".toBytes());
    try writer.close();
    try testing.assertEqual(try notes.readText(), "first second");
    try holder.close();
}

// Windows refuses to remove a file that is open, so only another system can remove the file
// between the open and the lock.
test "tryLock does not take the lock of a file that was removed after it was opened" {
    let scratch = try TemporaryDirectory.create("ens-std-fs-lock-removed");
    Path marker = scratch.path().join("marker");
    try marker.writeText("");
    let opened = try marker.open();
    if (environment.platform() == Platform.Windows) {
        try testing.assertTrue(removalRefused(marker), "a file that is open was removed");
        try opened.close();
        return;
    }
    try marker.removeFile();
    try testing.assertFalse(try opened.tryLock(), "a removed file's lock was taken");
    try opened.close();
}

test "a temporary directory is removed when its guard is destroyed" {
    Path made = try madeAndDroppedDirectory();
    try testing.assertFalse(made.exists(), "'{made}' should be gone once its guard died");
}

test "a kept temporary directory survives its guard" {
    Path kept = try madeAndKeptDirectory();
    try testing.assertTrue(kept.isDirectory(), "a kept directory is the caller's to remove");
    try testing.assertEqual(try kept.join("inside.txt").readText(), "content");
    try kept.removeRecursively();
}

test "a temporary file is claimed empty and removed when its guard is destroyed" {
    let guard = try TemporaryFile.create("ens-std-fs-file");
    Path made = guard.path();
    try testing.assertTrue(made.isFile(), "'{made}' is a file the moment it is claimed");
    Metadata? found = try made.metadata();
    if (found == null) {
        try testing.fail("'{made}' should be there right after it was claimed");
    } else {
        try testing.assertEqual(found.length, 0L);
    }

    Path dropped = try madeAndDroppedFile();
    try testing.assertFalse(dropped.exists(), "'{dropped}' should be gone once its guard died");
}

test "a kept temporary file survives its guard" {
    Path kept = try madeAndKeptFile();
    try testing.assertTrue(kept.isFile(), "a kept file is the caller's to remove");
    try testing.assertEqual(try kept.readText(), "content");
    try kept.removeFile();
}

// A name no other call returns is what the guards guarantee, and two calls under one prefix are the
// smallest way to check that guarantee.
test "two temporary guards under one prefix take two names" {
    let first = try TemporaryDirectory.create("ens-std-fs-twice");
    let second = try TemporaryDirectory.create("ens-std-fs-twice");
    try testing.assertNotEqual(first.path(), second.path());

    let firstFile = try TemporaryFile.create("ens-std-fs-twice-file");
    let secondFile = try TemporaryFile.create("ens-std-fs-twice-file");
    try testing.assertNotEqual(firstFile.path(), secondFile.path());
}

// The guard is built and dropped inside a call of its own, so its destructor has run by the time
// the caller reads the path it returned.
madeAndDroppedDirectory() -> Path throws {
    let guard = try TemporaryDirectory.create("ens-std-fs-dropped");
    Path made = guard.path();
    try made.join("inside.txt").writeText("content");
    try testing.assertTrue(made.isDirectory(), "the directory is there while its guard lives");
    return made;
}

// The guard is built, dismissed and dropped inside a call of its own, so a path that outlived its
// guard is what the caller is handed.
madeAndKeptDirectory() -> Path throws {
    let guard = try TemporaryDirectory.create("ens-std-fs-kept");
    try guard.path().join("inside.txt").writeText("content");
    return guard.keep();
}

// The guard is built and dropped inside a call of its own, so its destructor has run by the time
// the caller reads the path it returned.
madeAndDroppedFile() -> Path throws {
    let guard = try TemporaryFile.create("ens-std-fs-dropped-file");
    Path made = guard.path();
    try testing.assertTrue(made.isFile(), "the file is there while its guard lives");
    return made;
}

// The guard is built, dismissed and dropped inside a call of its own, so a path that outlived its
// guard is what the caller is handed.
madeAndKeptFile() -> Path throws {
    let guard = try TemporaryFile.create("ens-std-fs-kept-file");
    try guard.path().writeText("content");
    return guard.keep();
}

// Whether removing the file at `path` was refused.
removalRefused(Path path) -> bool {
    try path.removeFile();
    return false;
} catch (FileSystemError refused) {
    return true;
}

// The names 'entries' returned, in the order it returned them.
namesUnder(Path directory) -> string[] throws FileSystemError {
    let found = new List<string>();
    for (let child in try directory.entries()) {
        found.push(child.name);
    }
    return found.toArray();
}

// The names 'walk' returned, in the order it returned them.
walkedNames(Path directory) -> string[] throws FileSystemError {
    let found = new List<string>();
    for (let child in try directory.walk()) {
        found.push(child.name);
    }
    return found.toArray();
}

// The names the walker returns from where it stands until the walk is over.
walkerNames(Walker walker) -> string[] throws FileSystemError {
    let found = new List<string>();
    Entry? next = try walker.next();
    while (next != null) {
        found.push(next.name);
        next = try walker.next();
    }
    return found.toArray();
}

// The names a walk that follows links returned, in the order it returned them.
followedNames(Path directory) -> string[] throws FileSystemError {
    let found = new List<string>();
    for (let child in try directory.walk(followLinks: true)) {
        found.push(child.name);
    }
    return found.toArray();
}

// A link at `link` naming `target`, made through the system's own command so nothing under test
// takes part in making it.
linked(Path target, Path link) -> bool throws {
    string command = "ln -s '{target}' '{link}'";
    if (environment.platform() == Platform.Windows) {
        command = "mklink /J \"{nativeText(link)}\" \"{nativeText(target)}\" > nul";
    }
    return (try process.runShell(command)).status.succeeded();
}

nativeText(Path path) -> string {
    return path.toString().replace("/", "\\");
}

// The window a modification time has to fall in to be milliseconds since 1970 rather than seconds
// or some other unit.
final class Window {
    // 2025-01-01T00:00:00Z in milliseconds, which every file these tests write is later than.
    protected static const long earliest = 1735689600000;
}
