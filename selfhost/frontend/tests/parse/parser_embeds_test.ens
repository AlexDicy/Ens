// 'embed' in source and in a manifest: the two forms of the expression, the manifest line, and the
// two words staying ordinary names everywhere else.
import @std.testing;
import parse.parser_support;
import syntax.generated.factory;
import SyntaxKind from syntax.generated.kind;
import EmbedExpressionNode from syntax.generated.nodes;
import EmbedDeclarationNode from syntax.generated.nodes;
import ManifestFileNode from syntax.generated.nodes;
import PackageDeclarationNode from syntax.generated.nodes;

test "an embed names a file, or with 'folder' a folder" {
    let file = try parser_support.expressionNode("embed \"logo.png\"");
    if (file is EmbedExpressionNode) {
        try testing.assertEqual(file.embedKeyword().kind(), SyntaxKind.EmbedKeyword);
        try testing.assertTrue(file.folderKeyword() == null, "a file embed has no 'folder'");
        try testing.assertEqual(file.path().text(), "\"logo.png\"");
    } else {
        try testing.fail("'embed \"logo.png\"' should be an embed expression");
    }
    let folder = try parser_support.expressionNode("embed folder \"assets\"");
    if (folder is EmbedExpressionNode) {
        try testing.assertTrue(folder.folderKeyword()?.kind() == SyntaxKind.FolderKeyword,
            "the folder word is re-tagged");
        try testing.assertEqual(folder.path().text(), "\"assets\"");
    } else {
        try testing.fail("'embed folder \"assets\"' should be an embed expression");
    }
}

test "'embed' and 'folder' stay ordinary names everywhere else" {
    let expected = [
        "embed", "embed(1)", "embed.size", "embed + 1", "folder", "folder(embed)",
    ];
    let kinds = [
        SyntaxKind.IdentifierExpression, SyntaxKind.CallExpression,
        SyntaxKind.MemberExpression, SyntaxKind.BinaryExpression,
        SyntaxKind.IdentifierExpression, SyntaxKind.CallExpression,
    ];
    for (long i = 0; i < expected.length; i++) {
        let node = try parser_support.expressionNode(expected[i]);
        try testing.assertEqual(node.kind(), kinds[i]);
    }
    let declared = try parser_support.statementNode("int embed = 1;");
    try testing.assertEqual(declared.kind(), SyntaxKind.VariableDeclaration);
    let named = try parser_support.statementNode("let folder = embed;");
    try testing.assertEqual(named.kind(), SyntaxKind.VariableDeclaration);
}

test "an embed without its path is reported at the path" {
    let folder = parser_support.parseStatementText("let files = embed folder;");
    try parser_support.assertRoundTrip("let files = embed folder;", folder);
    try parser_support.assertDiagnosticCount(folder, 1);
    try parser_support.assertMentions(folder, "Expected the folder's path in quotes after "
        + "'embed folder'. For example, write 'embed folder \"assets\"'.");
}

test "a package manifest lists a folder to embed from" {
    string text = "package demo.app \{\n    ens \"0.1\";\n    embed \"../shared\";\n\}\n";
    let result = parser_support.parseManifestText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertNoDiagnostics(result);
    let root = factory.createRoot(result.root());
    if (!(root is ManifestFileNode)) {
        try testing.fail("the root should be a manifest file");
        return;
    }
    let declaration = root.declarations(0);
    if (!(declaration is PackageDeclarationNode)) {
        try testing.fail("the manifest should declare a package");
        return;
    }
    let item = declaration.items(1);
    if (item is EmbedDeclarationNode) {
        try testing.assertEqual(item.embedKeyword().kind(), SyntaxKind.EmbedKeyword);
        try testing.assertEqual(item.folder().text(), "\"../shared\"");
    } else {
        try testing.fail("the second item should be an embed declaration");
    }
}

test "an embed line without its folder is reported" {
    let result = parser_support.parseManifestText("package demo.app \{ embed; \}");
    try parser_support.assertMentions(result, "Expected the folder the package embeds files "
        + "from, in quotes. For example, write 'embed \"../assets\";'.");
}
