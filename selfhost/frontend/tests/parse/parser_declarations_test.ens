// Declaration parsing: imports, externals, functions, types, enums, and tests, plus whole
// realistic programs that must parse with zero diagnostics and round trip byte for byte.
import @std.testing;
import parse.parser_support;
import SyntaxKind from syntax.generated.kind;
import syntax.generated.factory;
import syntax.generated.dump;
import SourceFileNode from syntax.generated.nodes;
import ImportDeclarationNode from syntax.generated.nodes;
import ExternalTypeDeclarationNode from syntax.generated.nodes;
import ExternalBlockNode from syntax.generated.nodes;
import ExternalFunctionDeclarationNode from syntax.generated.nodes;
import FunctionDeclarationNode from syntax.generated.nodes;
import StructDeclarationNode from syntax.generated.nodes;
import ClassDeclarationNode from syntax.generated.nodes;
import InterfaceDeclarationNode from syntax.generated.nodes;
import EnumDeclarationNode from syntax.generated.nodes;
import TestDeclarationNode from syntax.generated.nodes;
import FieldDeclarationNode from syntax.generated.nodes;
import MemberListNode from syntax.generated.nodes;
import NamedTypeNode from syntax.generated.nodes;
import ParameterNode from syntax.generated.nodes;
import BlockNode from syntax.generated.nodes;
import CallExpressionNode from syntax.generated.nodes;
import VariableDeclarationNode from syntax.generated.nodes;
import ExpressionStatementNode from syntax.generated.nodes;
import Member from syntax.generated.nodes;
import TopLevelItem from syntax.generated.nodes;

sourceFileNode(string text) -> SourceFileNode throws {
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertNoDiagnostics(result);
    let root = factory.createRoot(result.root());
    if (root is SourceFileNode) {
        return root;
    }
    panic("the root should be a SourceFileNode");
}

test "imports parse the plain, binding, and package forms" {
    let file = try sourceFileNode("import engine.renderer;\n"
        + "import Renderer from engine.renderer;\n"
        + "import List from @std.collections.list;\n");
    try testing.assertEqual(file.itemsCount(), 3L);
    let plain = file.items(0);
    if (plain is ImportDeclarationNode) {
        try testing.assertTrue(plain.binding() == null, "no binding on the plain form");
        try testing.assertTrue(plain.path().at() == null, "no '@' on a local import");
        try testing.assertEqual(plain.path().segmentsCount(), 2L);
        try testing.assertEqual(plain.path().segments(1).text(), "renderer");
    } else {
        try testing.fail("the first item should be an import");
    }
    let bound = file.items(1);
    if (bound is ImportDeclarationNode) {
        let binding = bound.binding();
        if (binding == null) {
            try testing.fail("the binding should be present");
        } else {
            try testing.assertEqual(binding.name().text(), "Renderer");
        }
    } else {
        try testing.fail("the second item should be an import");
    }
    let packaged = file.items(2);
    if (packaged is ImportDeclarationNode) {
        try testing.assertTrue(packaged.path().at() != null, "the package form keeps its '@'");
    } else {
        try testing.fail("the third item should be an import");
    }
}

test "'from' stays an identifier and disambiguates the import binding" {
    let file = try sourceFileNode("import Widget from from;\n"
        + "import from.core;\n"
        + "from(int from) -> int \{\n"
        + "    int from = from + 1;\n"
        + "    return from;\n"
        + "\}\n");
    try testing.assertEqual(file.itemsCount(), 3L);

    let bound = file.items(0);
    if (bound is ImportDeclarationNode) {
        let binding = bound.binding();
        if (binding == null) {
            try testing.fail("the binding should be present when 'from' names the module");
        } else {
            try testing.assertEqual(binding.name().text(), "Widget");
            try testing.assertTrue(binding.fromKeyword().kind() == SyntaxKind.FromKeyword,
                "the binding 'from' is re-tagged");
        }
        try testing.assertEqual(bound.path().segments(0).text(), "from");
    } else {
        try testing.fail("the first item should be an import");
    }

    let module = file.items(1);
    if (module is ImportDeclarationNode) {
        try testing.assertTrue(module.binding() == null, "no binding when 'from' opens the path");
        try testing.assertEqual(module.path().segments(0).text(), "from");
        try testing.assertEqual(module.path().segments(1).text(), "core");
    } else {
        try testing.fail("the second item should be an import");
    }

    let function = file.items(2);
    if (function is FunctionDeclarationNode) {
        let name = function.name();
        if (name == null) {
            try testing.fail("the function should have a name");
        } else {
            try testing.assertEqual(name.text(), "from");
        }
        try testing.assertEqual(function.parameters().parametersCount(), 1L);
        try testing.assertEqual(function.parameters().parameters(0).name().text(), "from");
    } else {
        try testing.fail("the third item should be a function");
    }
}

test "external declarations parse types and blocks" {
    let file = try sourceFileNode("external type HANDLE;\n"
        + "\n"
        + "external from kernel32 \{\n"
        + "    ReadFile(HANDLE h, byte[] buf, uint n, out uint bytesRead, HANDLE? ov) -> int;\n"
        + "    CloseHandle(HANDLE h) -> int;\n"
        + "\}\n");
    try testing.assertEqual(file.itemsCount(), 2L);
    let opaque = file.items(0);
    if (opaque is ExternalTypeDeclarationNode) {
        try testing.assertEqual(opaque.name().text(), "HANDLE");
    } else {
        try testing.fail("the first item should be an external type");
    }
    let block = file.items(1);
    if (block is ExternalBlockNode) {
        try testing.assertEqual(block.library().text(), "kernel32");
        try testing.assertEqual(block.functionsCount(), 2L);
        let read = block.functions(0);
        if (read is ExternalFunctionDeclarationNode) {
            try testing.assertEqual(read.parameters().parametersCount(), 5L);
            let outParameter = read.parameters().parameters(3);
            try testing.assertTrue(outParameter.outKeyword()?.kind() == SyntaxKind.OutKeyword,
                "the out modifier is re-tagged");
            try testing.assertTrue(read.returnType() != null, "the return type is present");
        } else {
            try testing.fail("the first item should be an external function");
        }
    } else {
        try testing.fail("the second item should be an external block");
    }
}

test "'type' stays an identifier outside the external-type position" {
    let file = try sourceFileNode("external type Handle;\n"
        + "type(int type) -> int \{\n"
        + "    int type = type + 1;\n"
        + "    return type;\n"
        + "\}\n");
    try testing.assertEqual(file.itemsCount(), 2L);

    let opaque = file.items(0);
    if (opaque is ExternalTypeDeclarationNode) {
        try testing.assertTrue(opaque.typeKeyword().kind() == SyntaxKind.TypeKeyword,
            "the external 'type' keyword is re-tagged");
        try testing.assertEqual(opaque.name().text(), "Handle");
    } else {
        try testing.fail("the first item should be an external type");
    }

    let function = file.items(1);
    if (function is FunctionDeclarationNode) {
        let name = function.name();
        if (name == null) {
            try testing.fail("the function should have a name");
        } else {
            try testing.assertEqual(name.text(), "type");
        }
        try testing.assertEqual(function.parameters().parametersCount(), 1L);
        try testing.assertEqual(function.parameters().parameters(0).name().text(), "type");
    } else {
        try testing.fail("the second item should be a function");
    }
}

test "functions parse generics, throws clauses, and catch clauses" {
    let file = try sourceFileNode(
        "public swap<T: Shape + Speaker>(T left, T right) -> T throws IOError, ParseError \{\n"
        + "    return left;\n"
        + "\} catch (IOError e) \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "\n"
        + "private tally(long start = 0) throws \{\n"
        + "    panic(\"unreachable\");\n"
        + "\}\n");
    try testing.assertEqual(file.itemsCount(), 2L);
    let generic = file.items(0);
    if (generic is FunctionDeclarationNode) {
        try testing.assertEqual(generic.modifiersCount(), 1L);
        let genericName = generic.name();
        if (genericName == null) {
            try testing.fail("the method should have a name");
        } else {
            try testing.assertEqual(genericName.text(), "swap");
        }
        let typeParameters = generic.typeParameters();
        if (typeParameters == null) {
            try testing.fail("the type parameters should be present");
        } else {
            try testing.assertEqual(typeParameters.parametersCount(), 1L);
            let bounds = typeParameters.parameters(0).bounds();
            if (bounds == null) {
                try testing.fail("the bounds should be present");
            } else {
                try testing.assertEqual(bounds.boundsCount(), 2L);
            }
        }
        let throwsClause = generic.throwsClause();
        if (throwsClause == null) {
            try testing.fail("the throws clause should be present");
        } else {
            try testing.assertEqual(throwsClause.typesCount(), 2L);
        }
        try testing.assertTrue(generic.body() != null, "the body is present");
        try testing.assertTrue(generic.semicolon() == null, "no bodiless semicolon");
        try testing.assertEqual(generic.catchClausesCount(), 1L);
        try testing.assertEqual(generic.catchClauses(0).name().text(), "e");
    } else {
        try testing.fail("the first item should be a function");
    }
    let bare = file.items(1);
    if (bare is FunctionDeclarationNode) {
        let throwsClause = bare.throwsClause();
        if (throwsClause == null) {
            try testing.fail("the bare throws clause should be present");
        } else {
            try testing.assertEqual(throwsClause.typesCount(), 0L);
        }
        let defaultValue = bare.parameters().parameters(0).defaultValue();
        try testing.assertTrue(defaultValue != null, "the default value is present");
    } else {
        try testing.fail("the second item should be a function");
    }
}

test "'noreturn' parses as a declaration modifier on functions and methods" {
    let file = try sourceFileNode(
        "public noreturn fail(string message) throws \{\n"
        + "    throw new Error(message);\n"
        + "\}\n"
        + "\n"
        + "interface Crasher \{\n"
        + "    noreturn crash() throws Error;\n"
        + "\}\n");
    let function = file.items(0);
    if (function is FunctionDeclarationNode) {
        try testing.assertEqual(function.modifiersCount(), 2L);
        try testing.assertTrue(function.modifiers(0).kind() == SyntaxKind.PublicKeyword,
            "the first modifier is 'public'");
        try testing.assertTrue(function.modifiers(1).kind() == SyntaxKind.NoreturnKeyword,
            "the second modifier is 'noreturn'");
        try testing.assertTrue(function.returnType() == null, "a noreturn function has no return type");
    } else {
        try testing.fail("the first item should be a function");
    }
    let interfaceNode = file.items(1);
    if (interfaceNode is InterfaceDeclarationNode) {
        let method = interfaceNode.body().members(0);
        if (method is FunctionDeclarationNode) {
            try testing.assertEqual(method.modifiersCount(), 1L);
            try testing.assertTrue(method.modifiers(0).kind() == SyntaxKind.NoreturnKeyword,
                "the interface method carries 'noreturn'");
        } else {
            try testing.fail("the interface member should be a method");
        }
    } else {
        try testing.fail("the second item should be an interface");
    }
}

test "classes parse extends, implements, fields, and member forms" {
    let file = try sourceFileNode(
        "public sealed abstract class Shape \{\n"
        + "    protected int sides;\n"
        + "\n"
        + "    constructor(this.sides = 0);\n"
        + "\n"
        + "    abstract area() -> int;\n"
        + "\}\n"
        + "\n"
        + "class Square extends Shape implements Speaker<int>, Comparable \{\n"
        + "    int side = 1;\n"
        + "    weak Square? twin;\n"
        + "    List<List<int>> history;\n"
        + "\n"
        + "    override area() -> int \{\n"
        + "        return this.side * this.side;\n"
        + "    \}\n"
        + "\}\n");
    try testing.assertEqual(file.itemsCount(), 2L);
    let base = file.items(0);
    if (base is ClassDeclarationNode) {
        try testing.assertEqual(base.modifiersCount(), 3L);
        try testing.assertEqual(base.body().membersCount(), 3L);
        let ctor = base.body().members(1);
        if (ctor is FunctionDeclarationNode) {
            try testing.assertTrue(ctor.introducer() != null, "the constructor has a 'constructor' introducer");
            try testing.assertTrue(ctor.body() == null, "the shorthand has no body");
            try testing.assertTrue(ctor.semicolon() != null, "the shorthand ends in ';'");
            let parameter = ctor.parameters().parameters(0);
            try testing.assertTrue(parameter.thisPrefix() != null, "the this-prefix is present");
            try testing.assertEqual(parameter.name().text(), "sides");
        } else {
            try testing.fail("the second member should be the shorthand constructor");
        }
        let method = base.body().members(2);
        if (method is FunctionDeclarationNode) {
            try testing.assertTrue(method.body() == null, "abstract methods have no body");
        } else {
            try testing.fail("the third member should be the abstract method");
        }
    } else {
        try testing.fail("the first item should be the Shape class");
    }
    let square = file.items(1);
    if (square is ClassDeclarationNode) {
        let extendsClause = square.extendsClause();
        if (extendsClause == null) {
            try testing.fail("the extends clause should be present");
        } else {
            try testing.assertEqual(extendsClause.base().name().text(), "Shape");
        }
        let implementsClause = square.implementsClause();
        if (implementsClause == null) {
            try testing.fail("the implements clause should be present");
        } else {
            try testing.assertEqual(implementsClause.interfacesCount(), 2L);
            try testing.assertTrue(implementsClause.interfaces(0).typeArguments() != null,
                "the first interface keeps its type arguments");
        }
        let nested = square.body().members(2);
        if (nested is FieldDeclarationNode) {
            let declared = nested.declaredType();
            if (declared is NamedTypeNode) {
                try testing.assertTrue(declared.typeArguments() != null,
                    "the nested generic field type keeps its arguments");
            } else {
                try testing.fail("the field type should be a named type");
            }
        } else {
            try testing.fail("the third member should be the history field");
        }
    } else {
        try testing.fail("the second item should be the Square class");
    }
}

test "structs parse clauses liberally and interfaces parse extends" {
    let file = try sourceFileNode(
        "struct Rectangle extends Base implements Printable \{\n"
        + "    uint width;\n"
        + "\}\n"
        + "\n"
        + "interface Source<T> extends Supply<T> \{\n"
        + "    take() -> T;\n"
        + "\}\n");
    let rectangle = file.items(0);
    if (rectangle is StructDeclarationNode) {
        try testing.assertTrue(rectangle.extendsClause() != null,
            "struct extends parses for the analyzer to reject");
        try testing.assertTrue(rectangle.implementsClause() != null,
            "struct implements parses for the analyzer to reject");
    } else {
        try testing.fail("the first item should be a struct");
    }
    let source = file.items(1);
    if (source is InterfaceDeclarationNode) {
        try testing.assertEqual(source.name().text(), "Source");
        try testing.assertTrue(source.typeParameters() != null, "the interface is generic");
        let extendsClause = source.extendsClause();
        if (extendsClause == null) {
            try testing.fail("the extends clause should be present");
        } else {
            try testing.assertEqual(extendsClause.base().name().text(), "Supply");
            try testing.assertTrue(extendsClause.base().typeArguments() != null,
                "the extended interface keeps its type arguments");
        }
        try testing.assertEqual(source.body().membersCount(), 1L);
    } else {
        try testing.fail("the second item should be an interface");
    }
}

test "enums allow a trailing comma and test declarations take both descriptions" {
    let file = try sourceFileNode(
        "enum Command \{\n"
        + "    Initialize,\n"
        + "    Exit,\n"
        + "\}\n"
        + "\n"
        + "test \"plain description\" \{\n"
        + "    run();\n"
        + "\}\n"
        + "\n"
        + "test \"holes \{count\} work\" \{\n"
        + "    run();\n"
        + "\}\n");
    let command = file.items(0);
    if (command is EnumDeclarationNode) {
        try testing.assertEqual(command.membersCount(), 2L);
        try testing.assertEqual(command.members(1).name().text(), "Exit");
    } else {
        try testing.fail("the first item should be an enum");
    }
    let plain = file.items(1);
    if (plain is TestDeclarationNode) {
        try testing.assertEqual(plain.testKeyword().kind(), SyntaxKind.TestKeyword);
        try testing.assertTrue(plain.descriptionToken() != null, "the description is a token");
        try testing.assertTrue(plain.descriptionNode() == null, "no interpolated description");
    } else {
        try testing.fail("the second item should be a test declaration");
    }
    let interpolated = file.items(2);
    if (interpolated is TestDeclarationNode) {
        try testing.assertTrue(interpolated.descriptionToken() == null,
            "the interpolated description is not a token");
        try testing.assertTrue(interpolated.descriptionNode() != null,
            "the interpolated description is a node");
    } else {
        try testing.fail("the third item should be a test declaration");
    }
}

test "generic calls and nested angle brackets disambiguate from comparisons" {
    let file = try sourceFileNode(
        "run() \{\n"
        + "    let cache = make<Map<string, List<int>>>(16);\n"
        + "    let both = f(a < b, c > d);\n"
        + "    let cast = value as Map<string, List<int>>;\n"
        + "    flag = a < b;\n"
        + "\}\n");
    let run = file.items(0);
    if (run is FunctionDeclarationNode) {
        let body = run.body();
        if (body == null) {
            try testing.fail("the body should be present");
        } else {
            let first = body.statements(0);
            if (first is VariableDeclarationNode) {
                let initializer = first.initializer();
                if (initializer == null) {
                    try testing.fail("the initializer should be present");
                } else {
                    let call = initializer.value();
                    if (call is CallExpressionNode) {
                        try testing.assertTrue(call.typeArguments() != null,
                            "the generic call keeps its type arguments");
                        try testing.assertEqual(call.arguments().argumentsCount(), 1L);
                    } else {
                        try testing.fail("the initializer should be a generic call");
                    }
                }
            } else {
                try testing.fail("the first statement should be a variable declaration");
            }
            let second = body.statements(1);
            if (second is VariableDeclarationNode) {
                let initializer = second.initializer();
                if (initializer == null) {
                    try testing.fail("the initializer should be present");
                } else {
                    let call = initializer.value();
                    if (call is CallExpressionNode) {
                        try testing.assertTrue(call.typeArguments() == null,
                            "comparisons in arguments stay comparisons");
                        try testing.assertEqual(call.arguments().argumentsCount(), 2L);
                    } else {
                        try testing.fail("the second initializer should be a plain call");
                    }
                }
            } else {
                try testing.fail("the second statement should be a variable declaration");
            }
        }
    } else {
        try testing.fail("the item should be a function");
    }
}

test "a realistic interpolation-heavy program parses cleanly and dumps" {
    let text =
        "import StringBuilder from @std.text.stringbuilder;\n"
        + "\n"
        + "report(string name, long count, bool ok) -> string \{\n"
        + "    let inner = \"\{name\}: \{count > 9 ? \"many\" : \"few\"\}\";\n"
        + "    let outer = \"result=\{inner\} ok=\{ok\} tail\";\n"
        + "    return outer;\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertNoDiagnostics(result);
    let tree = dump.dumpTree(factory.createRoot(result.root()));
    try testing.assertTrue(tree.contains("InterpolatedStringExpression"),
        "the dump names the interpolated string");
    try testing.assertTrue(tree.contains("InterpolationPart"),
        "the dump names the continuation parts");
    try testing.assertTrue(tree.contains("TernaryExpression"),
        "the hole holds the ternary");
}

test "the dump names the declaration shapes of a full program" {
    let text =
        "class Counter implements Ticker \{\n"
        + "    long value;\n"
        + "\n"
        + "    override tick() \{\n"
        + "        this.value++;\n"
        + "    \}\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertNoDiagnostics(result);
    let tree = dump.dumpTree(factory.createRoot(result.root()));
    try testing.assertTrue(tree.contains("ClassDeclaration"), "the class is dumped");
    try testing.assertTrue(tree.contains("ImplementsClause"), "the implements clause is dumped");
    try testing.assertTrue(tree.contains("MemberList"), "the member list is dumped");
    try testing.assertTrue(tree.contains("FieldDeclaration"), "the field is dumped");
    try testing.assertTrue(tree.contains("FunctionDeclaration"), "the method is dumped");
    try testing.assertTrue(tree.contains("PostfixExpression"), "the increment is dumped");
}
