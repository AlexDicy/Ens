// Declaration-level recovery and adversarial inputs: every parse, however broken, must round
// trip byte for byte and never loop or panic.
import @std.testing;
import parse.parser_support;
import SyntaxKind from syntax.generated.kind;
import syntax.generated.factory;
import SourceFileNode from syntax.generated.nodes;
import ErrorDeclarationNode from syntax.generated.nodes;
import ExternalTypeDeclarationNode from syntax.generated.nodes;
import InterfaceDeclarationNode from syntax.generated.nodes;
import ClassDeclarationNode from syntax.generated.nodes;
import FunctionDeclarationNode from syntax.generated.nodes;
import CallExpressionNode from syntax.generated.nodes;
import ErrorExpressionNode from syntax.generated.nodes;
import IdentifierExpressionNode from syntax.generated.nodes;
import TernaryExpressionNode from syntax.generated.nodes;
import SyntaxNode from syntax.node;
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

parseFile(string text) -> SourceFileNode {
    let result = parser_support.parseText(text);
    let root = factory.createRoot(result.root());
    if (root is SourceFileNode) {
        return root;
    }
    panic("the root should be a SourceFileNode");
}

test "a visibility modifier on an external type is captured by the declaration" {
    let text = "public external type HANDLE;\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 0);
    let file = parseFile(text);
    try testing.assertEqual(file.itemsCount(), 1L);
    let opaque = file.items(0);
    if (opaque is ExternalTypeDeclarationNode) {
        try testing.assertEqual(opaque.modifiersCount(), 1L);
        try testing.assertTrue(opaque.modifiers(0).kind() == SyntaxKind.PublicKeyword,
            "the public modifier is captured");
        try testing.assertEqual(opaque.name().text(), "HANDLE");
    } else {
        try testing.fail("a modified external type is still an external type declaration");
    }
}

test "a visibility modifier on an external block is an error declaration" {
    let text = "public external from libc \{\n    abs(int x) -> int;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "An external block is always private to its file, so it takes no modifier such as "
        + "'public'. Remove 'public', and call its functions from Ens functions that other "
        + "files can use.");
    let file = parseFile(text);
    try testing.assertTrue(file.items(0) is ErrorDeclarationNode, "the modifier is junk");
}

test "modifiers before a test become their own error declaration" {
    let text = "noreturn test \"boom\" \{\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "A test takes no modifiers, and this one is marked 'noreturn'. Remove 'noreturn' so the "
        + "line starts with 'test'.");
    let file = parseFile(text);
    try testing.assertTrue(file.items(0) is ErrorDeclarationNode, "the modified test is junk");
}

test "an interface with implements keeps its members after the junk" {
    let text = "interface I implements J \{\n"
        + "    speak() -> string;\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "An interface cannot use 'implements'. Write 'extends' instead to build this interface "
        + "on another one, as in 'interface Shape extends Named'.");
    let file = parseFile(text);
    let item = file.items(0);
    if (item is InterfaceDeclarationNode) {
        let body = item.body();
        try testing.assertEqual(body.openBrace().kind(), SyntaxKind.Missing);
        try testing.assertEqual(body.membersCount(), 2L);
        try testing.assertTrue(body.members(0) is ErrorDeclarationNode,
            "the stray clause is wrapped as junk");
        try testing.assertTrue(body.members(1) is FunctionDeclarationNode,
            "the method signature survives");
    } else {
        try testing.fail("the item should still be an interface");
    }
}

test "keyword names recover with one diagnostic each" {
    let text = "class Meta \{\n"
        + "    class() -> long \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    copy(string return) \{\n"
        + "    \}\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    let file = parseFile(text);
    let item = file.items(0);
    if (item is ClassDeclarationNode) {
        let method = item.body().members(0);
        if (method is FunctionDeclarationNode) {
            let methodName = method.name();
            if (methodName == null) {
                try testing.fail("the keyword-named member should keep its name token");
            } else {
                try testing.assertEqual(methodName.kind(), SyntaxKind.Identifier);
                try testing.assertEqual(methodName.text(), "class");
            }
        } else {
            try testing.fail("the keyword-named member should parse as a method");
        }
    } else {
        try testing.fail("the item should be a class");
    }
}

test "parameter lists recover from missing commas and junk" {
    let missingComma = "combine(int a int b) -> int \{\n    return a + b;\n\}\n";
    let result = parser_support.parseText(missingComma);
    try parser_support.assertRoundTrip(missingComma, result);
    try parser_support.assertDiagnosticCount(result, 1);
    let file = parseFile(missingComma);
    let item = file.items(0);
    if (item is FunctionDeclarationNode) {
        try testing.assertEqual(item.parameters().parametersCount(), 2L);
    } else {
        try testing.fail("the item should be a function");
    }

    let junk = "draw(??? , int x) \{\n\}\n";
    let junkResult = parser_support.parseText(junk);
    try parser_support.assertRoundTrip(junk, junkResult);
    try testing.assertTrue(junkResult.diagnostics().length > 0, "the junk is reported");
}

test "top-level statements are rejected with a helpful message" {
    let text = "let x = 5;\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "'x' is a variable, and a variable cannot be declared outside a function. Move 'x' into "
        + "a function, or write a function that returns its value, for example "
        + "'x() -> int \{ return 5; \}'.");
    let typed = parser_support.parseText("const string name = \"Ens\";\n");
    try testing.assertEqual(typed.diagnostics()[0].message(),
        "'name' is a variable, and a variable cannot be declared outside a function. Move 'name' "
        + "into a function, or write a function that returns its value, for example "
        + "'name() -> string \{ return \"Ens\"; \}'.");
    let called = parser_support.parseText("let total = compute();\n");
    try testing.assertEqual(called.diagnostics()[0].message(),
        "'total' is a variable, and a variable cannot be declared outside a function. Move "
        + "'total' into a function, or write a function that returns its value.");
}

test "unterminated declarations still round trip" {
    let samples = [
        "class C \{ foo() \{",
        "class C \{ int x \}",
        "import a.b",
        "external from libc \{ Read(",
        "enum E \{ A B \}",
        "test \"unfinished\" \{ run();",
        "struct S \{ \{ \} \}",
        "interface \{ \}",
        "foo(",
    ];
    for (let text in samples) {
        let result = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, result);
        try testing.assertTrue(result.diagnostics().length > 0,
            "'{text}' should report at least one diagnostic");
    }
}

test "adversarial token soup round trips at every entry point" {
    let samples = [
        ">>>= >>> >> << <<= ?? ?. ?[ ... :: @ #",
        "class class class ( \} \{ ) ;;",
        "\"unterminated \{hole",
        "a<b<c<d<e<f(((((((",
        "new new new [ ] ] ] \} \} \}",
        "if while for switch else catch finally",
        "x ?\{ : ?: \} [ , ] =",
        "0x 0b 'unclosed \\q \"bad\\u12\"",
    ];
    for (let text in samples) {
        let fileResult = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, fileResult);
        let statementResult = parser_support.parseStatementText(text);
        try parser_support.assertRoundTrip(text, statementResult);
        let expressionResult = parser_support.parseExpressionText(text);
        try parser_support.assertRoundTrip(text, expressionResult);
    }
}

test "deeply nested expressions stop at the depth guard instead of crashing" {
    let builder = "x";
    for (long i = 0; i < 600; i++) {
        builder = "(" + builder;
    }
    let result = parser_support.parseExpressionText(builder);
    try parser_support.assertRoundTrip(builder, result);
    try testing.assertTrue(result.diagnostics().length > 0, "the depth guard reports");
}

// A well-formed but over-deep construct is reported once and abandoned whole: the parser takes the
// rest of it with the error node, so every construct around it still finds its closing token and
// nothing downstream walks a tree deeper than the guard allows.
test "a balanced over-deep expression is one diagnostic and still round trips" {
    let text = "main() \{\n    int value = " + repeated("(", 600) + "1" + repeated(")", 600)
        + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
}

// Types count into the same depth as expressions, so nesting them has the same bound. The second
// diagnostic is the innermost surviving function type's return type, which has no depth left.
test "a balanced over-deep type is bounded by the same guard" {
    let text = "deep(" + repeated("(", 600) + "int" + repeated(") -> int", 600)
        + " parameter) \{\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try testing.assertEqual(result.diagnostics()[0].message(), deeplyNestedType());
}

// A chain of type suffixes nests nothing the parser recurses through, but every suffix wraps what
// came before, so it counts into the same bound and goes the same way past it. Both suffix kinds
// count, and the chain is read to its end so the type is abandoned whole rather than in halves.
test "a long chain of type suffixes is bounded by the same guard" {
    let text = "main() \{\n    int" + repeated("?[]", 300) + " value = null;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(), deeplyNestedType());
}

// The point of reading the chain to its end: a construct abandoned for depth is still that
// construct, so the statement classifier's speculative type parse still recognizes a declaration
// and the statement keeps its shape. Reading it as an expression instead would report one problem
// per suffix.
test "a declaration whose type was abandoned for depth is still a declaration" {
    let text = "int" + repeated("?[]", 300) + " value = null;\n";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(parser_support.standaloneNode(result).kind(),
        SyntaxKind.VariableDeclaration);
}

// A chain of operators nests nothing, so the parser walks it without recursing, but every link
// wraps what came before and the phases that walk the result recurse once per level. It therefore
// counts into the same bound, and goes the same way past it.
test "a long chain of infix operators is bounded by the same guard" {
    let text = "main() \{\n    long total = 0" + repeated(" + 1", 700) + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
}

test "a long chain of postfix calls is bounded by the same guard" {
    let text = "main() \{\n    let end = start()" + repeated(".step()", 700) + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
}

// Blocks nest through statements rather than expressions, so the body past the bound becomes one
// error statement holding its tokens and the braces around it still match.
test "deeply nested blocks are bounded by the same guard" {
    let text = "main() \{\n    " + repeated("\{ ", 700) + "return;" + repeated(" \}", 700)
        + "\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "These blocks are nested too deeply to compile. Move the inner blocks into functions of "
        + "their own.");
}

// An 'if' holds blocks, so a deep nest of them reaches the bound at an 'if' and reports the blocks,
// not the condition of the innermost one.
test "a deep nest of 'if' statements is bounded by the same guard" {
    let text = "main() \{\n    int x = 0;\n    " + repeated("if (x > 0) \{ ", 600) + "x = 1;"
        + repeated(" \}", 600) + "\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "These blocks are nested too deeply to compile. Move the inner blocks into functions of "
        + "their own.");
}

// Each 'else if' nests the next 'if' inside the one before it, so a long chain is bounded by the
// same guard, and the rest of the chain past the bound is taken whole as one error statement.
test "a long 'else if' chain is bounded by the same guard" {
    let text = elseChain(2500);
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(), longElseChain());
}

// 482 links after the first 'if' are the most a chain directly in a function body can have.
test "the longest 'else if' chain parses whole and one more link is refused" {
    let longest = elseChain(482);
    let longestResult = parser_support.parseText(longest);
    try parser_support.assertRoundTrip(longest, longestResult);
    try parser_support.assertDiagnosticCount(longestResult, 0);
    let past = elseChain(483);
    let pastResult = parser_support.parseText(past);
    try parser_support.assertRoundTrip(past, pastResult);
    try parser_support.assertDiagnosticCount(pastResult, 1);
    try testing.assertEqual(pastResult.diagnostics()[0].message(), longElseChain());
}

// A link whose block reaches the bound first reports the blocks, and the links after it, which are
// deeper still, are taken without a second report.
test "a chain whose links hold deep blocks reports once" {
    let link = " else if (flag) \{ " + repeated("if (flag) \{ ", 30) + "return;" + repeated(" \}", 30)
        + " \}";
    let text = "main(bool flag) \{\n    if (flag) \{ \}" + repeated(link, 480) + " else \{ \}\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "These blocks are nested too deeply to compile. Move the inner blocks into functions of "
        + "their own.");
}

// The rest of a refused chain is one error statement, so the statement after the chain still parses
// and reports its own problem.
test "the statement after a refused 'else if' chain is still parsed" {
    let text = "main(bool flag) \{\n    if (flag) \{ \}" + repeated(" else if (flag) \{ \}", 600)
        + " else \{ \}\n    int after = ;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try testing.assertEqual(result.diagnostics()[0].message(), longElseChain());
    try testing.assertEqual(result.diagnostics()[1].message(),
        "Expected a value, such as '42', a variable's name or a call like 'count()'.");
}

// A link whose condition reaches the limit was refused for nothing but its condition, so the links
// after it are parsed and report their own problems.
test "a long condition in one link leaves the rest of the chain parsed" {
    let text = "main(int x) \{\n    if (x" + repeated(" + 1", 600)
        + " > 0) \{ \} else if (x == 1) \{ x = ; \}\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
    try testing.assertEqual(result.diagnostics()[1].message(),
        "Expected a value, such as '42', a variable's name or a call like 'count()'.");
}

// A function whose body is an 'if' with 'links' 'else if' links after it and a final 'else'.
elseChain(long links) -> string {
    return "main(bool flag) \{\n    if (flag) \{ \}" + repeated(" else if (flag) \{ \}", links)
        + " else \{ \}\n\}\n";
}

longElseChain() -> string {
    return "This chain of 'else if' branches is nested too deeply to compile, because each 'else if' "
        + "nests one level deeper inside the blocks around it. Move some of its branches, or the "
        + "blocks around it, into functions of their own, or use a 'switch' if every condition "
        + "compares the same value.";
}

// A switch arm's block and a lambda's block body are blocks like any other, so a deep nest of either
// reaches the bound at a block and reports the blocks once. The statement after the nest still
// parses, so its own problem is the second diagnostic.
test "switch arm blocks and lambda block bodies are bounded by the same guard" {
    string[] opens = ["switch (x) \{ 0 -> \{ ", "() -> int f = () -> \{ "];
    string[] closes = [" \}, default -> \{ \}, \}", " return 1; \};"];
    for (long i = 0; i < opens.length; i++) {
        let text = "main() \{\n    int x = 0;\n    \{ " + repeated(opens[i], 600) + "x = 1;"
            + repeated(closes[i], 600) + " \}\n    int after = ;\n\}\n";
        let result = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, result);
        try parser_support.assertDiagnosticCount(result, 2);
        try testing.assertEqual(result.diagnostics()[0].message(),
            "These blocks are nested too deeply to compile. Move the inner blocks into functions of "
            + "their own.");
        try testing.assertEqual(result.diagnostics()[1].message(),
            "Expected a value, such as '42', a variable's name or a call like 'count()'.");
    }
}

// Inside 496 parentheses the call's first argument is entered one level under the limit, so the
// limit is reached at its '>' after 'x' was read. The abandoned argument takes 'x' with it and
// fills its one slot, so the call keeps its two arguments.
test "an expression abandoned at an operator still fills one slot" {
    let text = "deepArgument(int x) -> int \{\n    return " + repeated("(", 496) + "pick(x > 0, x)"
        + repeated(")", 496) + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
    let call = nodeIn(factory.createRoot(result.root()), SyntaxKind.CallExpression);
    if (call is CallExpressionNode) {
        let arguments = call.arguments();
        try testing.assertEqual(arguments.argumentsCount(), 2L);
        try testing.assertTrue(arguments.arguments(0) is ErrorExpressionNode,
            "the abandoned argument is one error expression");
        try testing.assertTrue(arguments.arguments(1) is IdentifierExpressionNode,
            "the argument after it keeps its own slot");
    } else {
        try testing.fail("the call to 'pick' is missing from the tree");
    }
}

// Each value is placed so that its hole, its first branch or its label is entered at the limit and
// abandoned at the '+'. The abandoned expression stops before the '}', ':' or '->' after it, and a
// type's '?' inside it, as in 'int?', opens no conditional. So the string, the conditional and the
// arm keep their own tokens and the limit is the only problem.
test "an expression abandoned before its parent's next token leaves that token to the parent" {
    string[] values = ["\"a\{x + 1\}b\"", "flag ? x + 1 : x", "switch (x) \{ 0 + 1 -> 1, default -> 0 \}",
        "flag ? x + pick<int?>(1) : x"];
    long[] depths = [497L, 496L, 497L, 496L];
    for (long i = 0; i < values.length; i++) {
        let text = returnedInParentheses(values[i], depths[i]);
        let result = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, result);
        try parser_support.assertDiagnosticCount(result, 1);
        try testing.assertEqual(result.diagnostics()[0].message(),
            "This expression is nested too deeply to compile. Split it into smaller expressions, "
            + "each stored in a local variable.");
    }
    let result = parser_support.parseText(returnedInParentheses(values[1], depths[1]));
    let conditional = nodeIn(factory.createRoot(result.root()), SyntaxKind.TernaryExpression);
    if (conditional is TernaryExpressionNode) {
        try testing.assertTrue(conditional.thenValue() is ErrorExpressionNode,
            "the abandoned branch is one error expression");
        try testing.assertEqual(conditional.colon().text(), ":");
        try testing.assertTrue(conditional.elseValue() is IdentifierExpressionNode,
            "the branch after the ':' keeps its own slot");
    } else {
        try testing.fail("the conditional is missing from the tree");
    }
}

// A lambda's block body and a switch's arms are inside braces the abandoned expression opened, so
// their ';' and '}' do not end it and the limit is the only problem.
test "an abandoned expression takes the braces it opens whole" {
    string[] values = ["run(() -> \{ return x + 1; \})", "switch (x) \{ 0 -> 1, default -> 0 \}"];
    long[] depths = [497L, 499L];
    for (long i = 0; i < values.length; i++) {
        let text = returnedInParentheses(values[i], depths[i]);
        let result = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, result);
        try parser_support.assertDiagnosticCount(result, 1);
        try testing.assertEqual(result.diagnostics()[0].message(),
            "This expression is nested too deeply to compile. Split it into smaller expressions, "
            + "each stored in a local variable.");
    }
}

// A lambda body missing its '}' ends at the ')' of the call around it, so the skip leaves the
// function's own '}' to the function and the next function reports its own problem.
test "an abandoned lambda body missing its brace ends at the bracket around it" {
    let text = returnedInParentheses("run(() -> \{ return x + 1; )", 497)
        + "after() -> int \{\n    int y = ;\n    return y;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression is nested too deeply to compile. Split it into smaller expressions, "
        + "each stored in a local variable.");
    try testing.assertEqual(result.diagnostics()[1].message(),
        "Expected a value, such as '42', a variable's name or a call like 'count()'.");
}

// A function returning 'value' inside 'depth' parentheses.
returnedInParentheses(string value, long depth) -> string {
    return "deep(bool flag, int x) -> int \{\n    return " + repeated("(", depth) + value
        + repeated(")", depth) + ";\n\}\n";
}

// The first node of 'kind' found under 'root', or null when there is none.
nodeIn(SyntaxNode root, SyntaxKind kind) -> SyntaxNode? {
    let pending = new List<SyntaxNode>();
    pending.push(root);
    while (!pending.isEmpty()) {
        let node = pending.pop();
        if (node.kind() == kind) {
            return node;
        }
        for (let child in node.childNodes()) {
            pending.push(child);
        }
    }
    return null;
}

// A statement the parser cannot read as a type keeps the reading it was written as, so the type
// reports its own problem once. Read as an expression instead, every '?[]' of the chain would be
// an empty safe subscript with a problem of its own, and the count would grow with the chain.
test "a statement whose type is unreadable stays a declaration" {
    string head = "main() \{\n    (int" + repeated("?[]", 160) + " value = 0;\n    return 0;\n\}\n";
    let result = parser_support.parseText(head);
    try parser_support.assertRoundTrip(head, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "Expected ')' after the type in parentheses. A function type also needs '->' and a "
        + "return type, as in '(int, int) -> int'.");
}

// Nothing more was written to say what the chain was, so the tokens already read as a type stay
// one and the declaration reports the parts it is missing. The count is the same whatever the
// chain's length.
test "a chain truncated at end of file is bounded whatever its length" {
    string shorter = "main() -> int \{\n    int" + repeated("?[]", 40);
    string longer = "main() -> int \{\n    int" + repeated("?[]", 160);
    let fewer = parser_support.parseText(shorter);
    try parser_support.assertRoundTrip(shorter, fewer);
    try parser_support.assertDiagnosticCount(fewer, 3);
    let more = parser_support.parseText(longer);
    try parser_support.assertRoundTrip(longer, more);
    try parser_support.assertDiagnosticCount(more, 3);
    try testing.assertEqual(more.diagnostics()[0].message(),
        "Expected the variable's name after its type. For example, write 'int count = 0;'.");
}

// A declaration the parser abandoned for depth still reports it: the reading that reached the limit
// is dropped without its tokens being read again, so the limit it reported is carried past the
// rewind rather than leaving the recovery's own message to stand alone.
test "an over-deep type-parameter bound reports the depth limit it reached" {
    string text = "class Box<T> \{\n    protected constructor();\n\}\n\nsample<T: "
        + repeated("Box<", 600) + "int" + repeated(">", 600)
        + ">(T value) -> int \{\n    return 0;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try parser_support.assertMentions(result, deeplyNestedType());
}

// A parameter's type has no comparison to fall back on, so a '<' the type parse left behind is a
// type-argument list it could not read, and the rest of it belongs to that parameter. Left for the
// list loop, every link would start something that looks like another parameter and cost a problem
// of its own.
test "an over-deep parameter type is bounded and keeps the parameter" {
    string text = "class Box<T> \{\n    protected constructor();\n\}\n\nsample("
        + repeated("Box<", 600) + "int" + repeated(">", 600)
        + " value) -> int \{\n    return 0;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try parser_support.assertMentions(result, deeplyNestedType());
}

// The leftovers are only skipped where the type could not read them, so a separator the author
// discarded is still reported rather than swallowed.
test "a missing separator between parameters is still reported" {
    string text = "take(int a string b) -> int \{\n    return 0;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "Expected ',' between parameters.");
}

repeated(string piece, long times) -> string {
    let builder = new StringBuilder();
    for (long i = 0; i < times; i++) {
        builder.append(piece);
    }
    return builder.toString();
}

deeplyNestedType() -> string {
    return "This type is nested too deeply to compile. Put fewer type arguments, parentheses and "
        + "'?' or '[]' suffixes inside one another.";
}
