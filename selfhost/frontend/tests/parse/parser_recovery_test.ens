// Declaration-level recovery and adversarial inputs: every parse, however broken, must round
// trip byte for byte and never loop or panic.
import @std.testing;
import parse.parser_support;
import SyntaxKind from syntax.generated.kind;
import syntax.generated.factory;
import SourceFileNode from syntax.generated.nodes;
import ErrorDeclarationNode from syntax.generated.nodes;
import ExternalTypeDeclarationNode from syntax.generated.nodes;
import InterfaceDeclarationNode from syntax.generated.nodes;
import ClassDeclarationNode from syntax.generated.nodes;
import FunctionDeclarationNode from syntax.generated.nodes;
import StringBuilder from @std.text.stringbuilder;

parseFile(string text) -> SourceFileNode {
    let result = parser_support.parseText(text);
    let root = factory.createRoot(result.root());
    if (root is SourceFileNode) {
        return root;
    }
    panic("the root should be a SourceFileNode");
}

test "a visibility modifier on an external type is captured by the declaration" {
    let text = "public external type HANDLE;\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 0);
    let file = parseFile(text);
    try testing.assertEqual(file.itemsCount(), 1L);
    let opaque = file.items(0);
    if (opaque is ExternalTypeDeclarationNode) {
        try testing.assertEqual(opaque.modifiersCount(), 1L);
        try testing.assertTrue(opaque.modifiers(0).kind() == SyntaxKind.PublicKeyword,
            "the public modifier is captured");
        try testing.assertEqual(opaque.name().text(), "HANDLE");
    } else {
        try testing.fail("a modified external type is still an external type declaration");
    }
}

test "a visibility modifier on an external block is an error declaration" {
    let text = "public external from libc \{\n    abs(int x) -> int;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "An external function block is always private to its file and cannot carry a "
        + "visibility modifier; wrap its calls in Ens functions to share them");
    let file = parseFile(text);
    try testing.assertTrue(file.items(0) is ErrorDeclarationNode, "the modifier is junk");
}

test "modifiers before a test become their own error declaration" {
    let text = "noreturn test \"boom\" \{\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "A test cannot have modifiers such as 'noreturn'; write 'test' at the start of the line");
    let file = parseFile(text);
    try testing.assertTrue(file.items(0) is ErrorDeclarationNode, "the modified test is junk");
}

test "an interface with implements keeps its members after the junk" {
    let text = "interface I implements J \{\n"
        + "    speak() -> string;\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "An interface cannot use 'implements'; an interface builds on another one with "
        + "'extends', and classes implement interfaces");
    let file = parseFile(text);
    let item = file.items(0);
    if (item is InterfaceDeclarationNode) {
        let body = item.body();
        try testing.assertEqual(body.openBrace().kind(), SyntaxKind.Missing);
        try testing.assertEqual(body.membersCount(), 2L);
        try testing.assertTrue(body.members(0) is ErrorDeclarationNode,
            "the stray clause is wrapped as junk");
        try testing.assertTrue(body.members(1) is FunctionDeclarationNode,
            "the method signature survives");
    } else {
        try testing.fail("the item should still be an interface");
    }
}

test "keyword names recover with one diagnostic each" {
    let text = "class Meta \{\n"
        + "    class() -> long \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    copy(string return) \{\n"
        + "    \}\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    let file = parseFile(text);
    let item = file.items(0);
    if (item is ClassDeclarationNode) {
        let method = item.body().members(0);
        if (method is FunctionDeclarationNode) {
            let methodName = method.name();
            if (methodName == null) {
                try testing.fail("the keyword-named member should keep its name token");
            } else {
                try testing.assertEqual(methodName.kind(), SyntaxKind.Identifier);
                try testing.assertEqual(methodName.text(), "class");
            }
        } else {
            try testing.fail("the keyword-named member should parse as a method");
        }
    } else {
        try testing.fail("the item should be a class");
    }
}

test "parameter lists recover from missing commas and junk" {
    let missingComma = "combine(int a int b) -> int \{\n    return a + b;\n\}\n";
    let result = parser_support.parseText(missingComma);
    try parser_support.assertRoundTrip(missingComma, result);
    try parser_support.assertDiagnosticCount(result, 1);
    let file = parseFile(missingComma);
    let item = file.items(0);
    if (item is FunctionDeclarationNode) {
        try testing.assertEqual(item.parameters().parametersCount(), 2L);
    } else {
        try testing.fail("the item should be a function");
    }

    let junk = "draw(??? , int x) \{\n\}\n";
    let junkResult = parser_support.parseText(junk);
    try parser_support.assertRoundTrip(junk, junkResult);
    try testing.assertTrue(junkResult.diagnostics().length > 0, "the junk is reported");
}

test "top-level statements are rejected with a helpful message" {
    let text = "let x = 5;\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "Variables cannot be declared at the top level; move 'x' inside a function, or expose "
        + "the value through a function, for example 'pi() -> int \{ return 3; \}'");
}

test "unterminated declarations still round trip" {
    let samples = [
        "class C \{ foo() \{",
        "class C \{ int x \}",
        "import a.b",
        "external from libc \{ Read(",
        "enum E \{ A B \}",
        "test \"unfinished\" \{ run();",
        "struct S \{ \{ \} \}",
        "interface \{ \}",
        "foo(",
    ];
    for (let text in samples) {
        let result = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, result);
        try testing.assertTrue(result.diagnostics().length > 0,
            "'{text}' should report at least one diagnostic");
    }
}

test "adversarial token soup round trips at every entry point" {
    let samples = [
        ">>>= >>> >> << <<= ?? ?. ?[ ... :: @ #",
        "class class class ( \} \{ ) ;;",
        "\"unterminated \{hole",
        "a<b<c<d<e<f(((((((",
        "new new new [ ] ] ] \} \} \}",
        "if while for switch else catch finally",
        "x ?\{ : ?: \} [ , ] =",
        "0x 0b 'unclosed \\q \"bad\\u12\"",
    ];
    for (let text in samples) {
        let fileResult = parser_support.parseText(text);
        try parser_support.assertRoundTrip(text, fileResult);
        let statementResult = parser_support.parseStatementText(text);
        try parser_support.assertRoundTrip(text, statementResult);
        let expressionResult = parser_support.parseExpressionText(text);
        try parser_support.assertRoundTrip(text, expressionResult);
    }
}

test "deeply nested expressions stop at the depth guard instead of crashing" {
    let builder = "x";
    for (long i = 0; i < 600; i++) {
        builder = "(" + builder;
    }
    let result = parser_support.parseExpressionText(builder);
    try parser_support.assertRoundTrip(builder, result);
    try testing.assertTrue(result.diagnostics().length > 0, "the depth guard reports");
}

// A well-formed but over-deep construct is reported once and abandoned whole: the parser takes the
// rest of it with the error node, so every construct around it still finds its closing token and
// nothing downstream walks a tree deeper than the guard allows.
test "a balanced over-deep expression is one diagnostic and still round trips" {
    let text = "main() \{\n    int value = " + repeated("(", 600) + "1" + repeated(")", 600)
        + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression nests too deeply to be parsed; split it into smaller expressions");
}

// Types count into the same depth as expressions, so nesting them has the same bound. The second
// diagnostic is the innermost surviving function type's return type, which has no depth left.
test "a balanced over-deep type is bounded by the same guard" {
    let text = "deep(" + repeated("(", 600) + "int" + repeated(") -> int", 600)
        + " parameter) \{\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try testing.assertEqual(result.diagnostics()[0].message(), deeplyNestedType());
}

// A chain of type suffixes nests nothing the parser recurses through, but every suffix wraps what
// came before, so it counts into the same bound and goes the same way past it. Both suffix kinds
// count, and the chain is read to its end so the type is given up whole rather than in halves.
test "a long chain of type suffixes is bounded by the same guard" {
    let text = "main() \{\n    int" + repeated("?[]", 300) + " value = null;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(), deeplyNestedType());
}

// The point of reading the chain to its end: a construct given up for depth is still that
// construct, so the statement classifier's speculative type parse still recognizes a declaration
// and the statement keeps its shape. Reading it as an expression instead would report one problem
// per suffix.
test "a declaration whose type was given up for depth is still a declaration" {
    let text = "int" + repeated("?[]", 300) + " value = null;\n";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(parser_support.standaloneNode(result).kind(),
        SyntaxKind.VariableDeclaration);
}

// A chain of operators nests nothing, so the parser walks it without recursing, but every link
// wraps what came before and the phases that walk the result recurse once per level. It therefore
// counts into the same bound, and goes the same way past it.
test "a long chain of infix operators is bounded by the same guard" {
    let text = "main() \{\n    long total = 0" + repeated(" + 1", 700) + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression nests too deeply to be parsed; split it into smaller expressions");
}

test "a long chain of postfix calls is bounded by the same guard" {
    let text = "main() \{\n    let end = start()" + repeated(".step()", 700) + ";\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "This expression nests too deeply to be parsed; split it into smaller expressions");
}

// Blocks nest through statements rather than expressions, so the body past the bound becomes one
// error statement holding its tokens and the braces around it still match.
test "deeply nested blocks are bounded by the same guard" {
    let text = "main() \{\n    " + repeated("\{ ", 700) + "return;" + repeated(" \}", 700)
        + "\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "These blocks nest too deeply to be parsed; move the inner ones into functions of "
        + "their own");
}

// A statement the parser cannot read as a type keeps the reading it was written as, so the type
// reports its own problem once. Read as an expression instead, every '?[]' of the chain would be
// an empty safe subscript with a problem of its own, and the count would grow with the chain.
test "a statement whose type is unreadable stays a declaration" {
    string head = "main() \{\n    (int" + repeated("?[]", 160) + " value = 0;\n    return 0;\n\}\n";
    let result = parser_support.parseText(head);
    try parser_support.assertRoundTrip(head, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "Expected ')' after the type in parentheses; a function type needs '->' and its return "
        + "type too, for example '(int, int) -> int'");
}

// Nothing more was written to say what the chain was, so the tokens already read as a type stay
// one and the declaration reports the parts it is missing. The count is the same whatever the
// chain's length.
test "a chain truncated at end of file is bounded whatever its length" {
    string shorter = "main() -> int \{\n    int" + repeated("?[]", 40);
    string longer = "main() -> int \{\n    int" + repeated("?[]", 160);
    let fewer = parser_support.parseText(shorter);
    try parser_support.assertRoundTrip(shorter, fewer);
    try parser_support.assertDiagnosticCount(fewer, 3);
    let more = parser_support.parseText(longer);
    try parser_support.assertRoundTrip(longer, more);
    try parser_support.assertDiagnosticCount(more, 3);
    try testing.assertEqual(more.diagnostics()[0].message(),
        "Expected the variable's name after its type, for example 'int count = 0;'");
}

// A declaration the parser gave up on for depth still says so: the reading that reached the limit
// is dropped without its tokens being read again, so the limit it reported is carried past the
// rewind rather than leaving the recovery's own message to stand alone.
test "an over-deep type-parameter bound reports the depth limit it reached" {
    string text = "class Box<T> \{\n    protected constructor();\n\}\n\nsample<T: "
        + repeated("Box<", 600) + "int" + repeated(">", 600)
        + ">(T value) -> int \{\n    return 0;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 2);
    try parser_support.assertMentions(result, deeplyNestedType());
}

repeated(string piece, long times) -> string {
    let builder = new StringBuilder();
    for (long i = 0; i < times; i++) {
        builder.append(piece);
    }
    return builder.toString();
}

deeplyNestedType() -> string {
    return "This type nests too deeply to be parsed; reduce how deeply its type arguments, "
        + "parentheses and '?' or '[]' suffixes nest";
}
