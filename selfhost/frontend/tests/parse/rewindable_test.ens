// The list every part of the parser a failed speculation has to forget is kept in. The property
// that matters is that a rewind is not a deletion: the entries an abandoned attempt wrote stay in
// the backing storage and the next appends overwrite them, so a speculation costs no allocation.
import @std.testing;
import RewindableList from parse.rewindable;
import Diagnostic from support.diagnostics;
import support.source;

test "a rewindable list appends, reads back, and answers with the landing index" {
    let list = new RewindableList<long>();
    try testing.assertEqual(list.count(), 0L);
    try testing.assertEqual(list.push(10L), 0L);
    try testing.assertEqual(list.push(20L), 1L);
    try testing.assertEqual(list.count(), 2L);
    try testing.assertEqual(list.get(1), 20L);
    list.set(1, 25L);
    try testing.assertEqual(list.get(1), 25L);
}

test "truncating drops what a speculation appended, and the next push takes the slot back" {
    let list = new RewindableList<long>();
    let mark = list.count();
    let discarded = list.push(1L);
    let alsoDiscarded = list.push(2L);
    list.truncate(mark);
    try testing.assertEqual(list.count(), 0L);
    try testing.assertEqual(list.push(3L), 0L);
    try testing.assertEqual(list.get(0), 3L);
    try testing.assertEqual(list.count(), 1L);
}

test "toArray answers with the logical length, not what the storage still holds" {
    let list = new RewindableList<long>();
    for (long i = 0; i < 8; i++) {
        let index = list.push(i);
    }
    list.truncate(3);
    let kept = list.toArray();
    try testing.assertEqual(kept.length, 3L);
    try testing.assertEqual(kept[2], 2L);
}

test "a rewindable list of references behaves the same as one of values" {
    let list = new RewindableList<Diagnostic>();
    let first = list.push(new Diagnostic("first", source.makeSpan(0, 1)));
    let second = list.push(new Diagnostic("second", source.makeSpan(1, 1)));
    try testing.assertEqual(second, 1L);
    list.truncate(1);
    let replaced = list.push(new Diagnostic("replaced", source.makeSpan(2, 1)));
    try testing.assertEqual(replaced, 1L);
    let kept = list.toArray();
    try testing.assertEqual(kept.length, 2L);
    try testing.assertEqual(kept[0].message(), "first");
    try testing.assertEqual(kept[1].message(), "replaced");
}
