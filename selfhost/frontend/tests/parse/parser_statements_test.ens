// Statement parsing: every form of the statement grammar through the typed accessors, plus
// statement-level recovery. Every parse asserts the byte-for-byte round trip.
import @std.testing;
import parse.parser_support;
import SyntaxKind from syntax.generated.kind;
import SyntaxNode from syntax.node;
import Expression from syntax.generated.nodes;
import BlockNode from syntax.generated.nodes;
import VariableDeclarationNode from syntax.generated.nodes;
import IfStatementNode from syntax.generated.nodes;
import ElseClauseNode from syntax.generated.nodes;
import WhileStatementNode from syntax.generated.nodes;
import ForStatementNode from syntax.generated.nodes;
import ForEachStatementNode from syntax.generated.nodes;
import ReturnStatementNode from syntax.generated.nodes;
import ThrowStatementNode from syntax.generated.nodes;
import ExpressionStatementNode from syntax.generated.nodes;
import SwitchStatementNode from syntax.generated.nodes;
import ValueArmNode from syntax.generated.nodes;
import TypeArmNode from syntax.generated.nodes;
import OptionalTypeNode from syntax.generated.nodes;
import DefaultArmNode from syntax.generated.nodes;
import ErrorStatementNode from syntax.generated.nodes;
import InitializerNode from syntax.generated.nodes;

test "variable declarations cover the let, const, and typed forms" {
    let inferred = try parser_support.statementNode("let count = 0;");
    if (inferred is VariableDeclarationNode) {
        try testing.assertTrue(inferred.modifier()?.kind() == SyntaxKind.LetKeyword,
            "the modifier is 'let'");
        try testing.assertTrue(inferred.declaredType() == null, "no declared type");
        try testing.assertEqual(inferred.name().text(), "count");
        try testing.assertTrue(inferred.initializer() != null, "the initializer is present");
    } else {
        try testing.fail("'let count = 0;' should be a variable declaration");
    }

    let constant = try parser_support.statementNode("const int max = 100;");
    if (constant is VariableDeclarationNode) {
        try testing.assertTrue(constant.modifier()?.kind() == SyntaxKind.ConstKeyword,
            "the modifier is 'const'");
        try testing.assertTrue(constant.declaredType() != null, "the type is declared");
    } else {
        try testing.fail("'const int max = 100;' should be a variable declaration");
    }

    let typed = try parser_support.statementNode("List<int>? items = null;");
    if (typed is VariableDeclarationNode) {
        try testing.assertTrue(typed.modifier() == null, "no modifier");
        try testing.assertTrue(typed.declaredType()?.kind() == SyntaxKind.OptionalType,
            "the declared type keeps its suffixes");
        try testing.assertEqual(typed.name().text(), "items");
    } else {
        try testing.fail("'List<int>? items = null;' should be a variable declaration");
    }

    let bare = try parser_support.statementNode("let x;");
    if (bare is VariableDeclarationNode) {
        try testing.assertTrue(bare.initializer() == null, "no initializer");
    } else {
        try testing.fail("'let x;' should be a variable declaration");
    }
}

test "if chains nest through else clauses" {
    let node = try parser_support.statementNode(
        "if (a) \{ one(); \} else if (b) \{ two(); \} else \{ three(); \}");
    if (node is IfStatementNode) {
        try testing.assertEqual(node.thenBranch().statementsCount(), 1L);
        let elseClause = node.elseClause();
        if (elseClause == null) {
            try testing.fail("the first else clause should be present");
        } else {
            let body = elseClause.body();
            if (body is IfStatementNode) {
                try testing.assertTrue(body.elseClause() != null, "the inner if has an else");
            } else {
                try testing.fail("'else if' should nest an if statement");
            }
        }
    } else {
        try testing.fail("the root should be an if statement");
    }
}

test "while loops parse their condition and body" {
    let node = try parser_support.statementNode("while (i < n) \{ i++; \}");
    if (node is WhileStatementNode) {
        try testing.assertEqual(node.condition().kind(), SyntaxKind.BinaryExpression);
        try testing.assertEqual(node.body().statementsCount(), 1L);
    } else {
        try testing.fail("the root should be a while statement");
    }
}

test "c-style for loops fill every clause combination" {
    let full = try parser_support.statementNode("for (long i = 0; i < n; i++) \{ use(i); \}");
    if (full is ForStatementNode) {
        try testing.assertTrue(full.initializer() != null, "the initializer is present");
        try testing.assertTrue(full.initializerSemicolon() == null,
            "a present initializer owns its semicolon");
        try testing.assertTrue(full.condition() != null, "the condition is present");
        try testing.assertTrue(full.update() != null, "the update is present");
    } else {
        try testing.fail("the root should be a for statement");
    }

    let empty = try parser_support.statementNode("for (;;) \{ \}");
    if (empty is ForStatementNode) {
        try testing.assertTrue(empty.initializer() == null, "no initializer");
        try testing.assertTrue(empty.initializerSemicolon() != null,
            "the bare first ';' sits in its own slot");
        try testing.assertTrue(empty.condition() == null, "no condition");
        try testing.assertTrue(empty.update() == null, "no update");
    } else {
        try testing.fail("'for (;;)' should be a for statement");
    }

    let walker = try parser_support.statementNode(
        "for (; cursor != null; cursor = cursor.next) \{ total = total + cursor.size; \}");
    if (walker is ForStatementNode) {
        try testing.assertTrue(walker.initializer() == null, "no initializer");
        try testing.assertTrue(walker.condition() != null, "the condition is present");
    } else {
        try testing.fail("the walker loop should be a for statement");
    }

    let exprInit = try parser_support.statementNode("for (i = 0; i < n;) \{ i++; \}");
    if (exprInit is ForStatementNode) {
        let initializer = exprInit.initializer();
        try testing.assertTrue(initializer is ExpressionStatementNode,
            "an assignment initializer is an expression statement");
        try testing.assertTrue(exprInit.update() == null, "no update");
    } else {
        try testing.fail("the assignment-initialized loop should be a for statement");
    }
}

test "for-each loops re-tag the contextual in keyword" {
    let inferred = try parser_support.statementNode("for (let item in items) \{ use(item); \}");
    if (inferred is ForEachStatementNode) {
        try testing.assertTrue(inferred.letKeyword()?.kind() == SyntaxKind.LetKeyword,
            "the binding uses let");
        try testing.assertTrue(inferred.declaredType() == null, "no declared type");
        try testing.assertEqual(inferred.name().text(), "item");
        try testing.assertEqual(inferred.inKeyword().kind(), SyntaxKind.InKeyword);
        try testing.assertEqual(inferred.inKeyword().text(), "in");
    } else {
        try testing.fail("the root should be a for-each statement");
    }

    let typed = try parser_support.statementNode("for (int x in xs) \{ total = total + x; \}");
    if (typed is ForEachStatementNode) {
        try testing.assertTrue(typed.letKeyword() == null, "no let keyword");
        try testing.assertTrue(typed.declaredType() != null, "the type is declared");
    } else {
        try testing.fail("the typed loop should be a for-each statement");
    }

    let generic = try parser_support.statementNode("for (Pair<K, V> entry in map) \{ \}");
    try testing.assertEqual(generic.kind(), SyntaxKind.ForEachStatement);

    let inAsName = try parser_support.statementNode("in = in + 1;");
    try testing.assertEqual(inAsName.kind(), SyntaxKind.ExpressionStatement);
}

test "jump statements parse with and without values" {
    let breakNode = try parser_support.statementNode("break;");
    try testing.assertEqual(breakNode.kind(), SyntaxKind.BreakStatement);
    let continueNode = try parser_support.statementNode("continue;");
    try testing.assertEqual(continueNode.kind(), SyntaxKind.ContinueStatement);
    let rethrowNode = try parser_support.statementNode("rethrow;");
    try testing.assertEqual(rethrowNode.kind(), SyntaxKind.RethrowStatement);

    let bareReturn = try parser_support.statementNode("return;");
    if (bareReturn is ReturnStatementNode) {
        try testing.assertTrue(bareReturn.value() == null, "no return value");
    } else {
        try testing.fail("'return;' should be a return statement");
    }
    let valueReturn = try parser_support.statementNode("return total + 1;");
    if (valueReturn is ReturnStatementNode) {
        try testing.assertTrue(valueReturn.value() != null, "the return value is present");
    } else {
        try testing.fail("'return total + 1;' should be a return statement");
    }
    let throwNode = try parser_support.statementNode("throw new ParseError(\"bad\");");
    if (throwNode is ThrowStatementNode) {
        try testing.assertEqual(throwNode.value().kind(), SyntaxKind.NewExpression);
    } else {
        try testing.fail("the root should be a throw statement");
    }
}

test "switch statements parse value, type, and default arms" {
    let text = "switch (shape) \{\n"
        + "    1, 2 -> handleSmall(),\n"
        + "    is Circle c -> \{ render(c); \},\n"
        + "    is Square -> renderSquare(),\n"
        + "    default -> \{ \},\n"
        + "\}";
    let node = try parser_support.statementNode(text);
    if (node is SwitchStatementNode) {
        try testing.assertEqual(node.armsCount(), 4L);
        let first = node.arms(0);
        if (first is ValueArmNode) {
            try testing.assertEqual(first.labelsCount(), 2L);
            try testing.assertTrue(first.body() is Expression, "the first arm body is a value");
        } else {
            try testing.fail("the first arm should be a value arm");
        }
        let second = node.arms(1);
        if (second is TypeArmNode) {
            try testing.assertEqual(second.target().name().text(), "Circle");
            try testing.assertTrue(second.binding()?.text() == "c", "the binding is named c");
            try testing.assertTrue(second.body() is BlockNode, "the second arm body is a block");
        } else {
            try testing.fail("the second arm should be a type arm");
        }
        let third = node.arms(2);
        if (third is TypeArmNode) {
            try testing.assertTrue(third.binding() == null, "no binding on the third arm");
        } else {
            try testing.fail("the third arm should be a type arm");
        }
        try testing.assertTrue(node.arms(3) is DefaultArmNode, "the last arm is default");
    } else {
        try testing.fail("the root should be a switch statement");
    }
}

test "a switch expression can initialize a variable" {
    let node = try parser_support.statementNode(
        "let label = switch (code) \{ 200 -> \"ok\", default -> \"other\", \};");
    if (node is VariableDeclarationNode) {
        let initializer = node.initializer();
        if (initializer == null) {
            try testing.fail("the initializer should be present");
        } else {
            try testing.assertEqual(initializer.value().kind(), SyntaxKind.SwitchExpression);
        }
    } else {
        try testing.fail("the root should be a variable declaration");
    }
}

test "blocks nest and empty blocks parse" {
    let node = try parser_support.statementNode("\{ let a = 1; \{ use(a); \} \}");
    if (node is BlockNode) {
        try testing.assertEqual(node.statementsCount(), 2L);
        try testing.assertEqual(node.statements(1).kind(), SyntaxKind.Block);
    } else {
        try testing.fail("the root should be a block");
    }
    let empty = try parser_support.statementNode("\{ \}");
    try testing.assertEqual(empty.kind(), SyntaxKind.Block);
}

test "a missing semicolon anchors at the statement end" {
    let text = "\{ let a = 1\n    use(a); \}";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    let span = result.diagnostics()[0].span();
    try testing.assertEqual(span.start, 11L);
    try testing.assertEqual(span.length, 0L);
}

test "junk inside a block becomes an error statement and the block survives" {
    let text = "\{ let a = 1; ??? %%% ; use(a); \}";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try testing.assertTrue(result.diagnostics().length > 0, "the junk is reported");
    let node = parser_support.standaloneNode(result);
    if (node is BlockNode) {
        try testing.assertEqual(node.statementsCount(), 3L);
        try testing.assertTrue(node.statements(1) is ErrorStatementNode,
            "the junk is wrapped in an error statement");
        try testing.assertEqual(node.statements(2).kind(), SyntaxKind.ExpressionStatement);
    } else {
        try testing.fail("the root should still be a block");
    }
}

test "an unclosed block reports the missing brace and round trips" {
    let text = "\{ start();";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
}

test "a stray catch statement gets a tailored message" {
    let text = "catch (Error e) \{ \}";
    let result = parser_support.parseStatementText(text);
    try parser_support.assertRoundTrip(text, result);
    try testing.assertTrue(result.diagnostics().length > 0, "the stray catch is reported");
    try testing.assertEqual(result.diagnostics()[0].message(),
        "A 'catch' block can only follow a function body's closing '\}'");
}

test "switch bodies recover from junk and accept omitted commas" {
    let noCommas = "switch (color) \{\n"
        + "    Red -> \{ return 1; \}\n"
        + "    Blue -> \{ return 3; \}\n"
        + "\}";
    let result = parser_support.parseStatementText(noCommas);
    try parser_support.assertRoundTrip(noCommas, result);
    try parser_support.assertNoDiagnostics(result);
    let node = parser_support.standaloneNode(result);
    if (node is SwitchStatementNode) {
        try testing.assertEqual(node.armsCount(), 2L);
        try testing.assertTrue(node.arms(1) is ValueArmNode, "the second arm reads correctly");
    } else {
        try testing.fail("the root should be a switch statement");
    }

    let junk = "switch (x) \{ ??? ,, 1 -> a() \}";
    let junkResult = parser_support.parseStatementText(junk);
    try parser_support.assertRoundTrip(junk, junkResult);
    try testing.assertTrue(junkResult.diagnostics().length > 0, "the junk is reported");

    let malformed = "switch \{ \}";
    let malformedResult = parser_support.parseStatementText(malformed);
    try parser_support.assertRoundTrip(malformed, malformedResult);
    try testing.assertTrue(malformedResult.diagnostics().length > 0,
        "the missing header is reported");
}

test "malformed statements still round trip byte for byte" {
    let samples = [
        "if a \{ \}",
        "while () do();",
        "for (let in items) \{ \}",
        "let = 5;",
        "int x",
        "return",
        "throw ;",
        "\{ \{ \{",
    ];
    for (let text in samples) {
        let result = parser_support.parseStatementText(text);
        try parser_support.assertRoundTrip(text, result);
        try testing.assertTrue(result.diagnostics().length > 0,
            "'{text}' should report at least one diagnostic");
    }
}

test "a type stacks its optional suffixes, in a declaration and inside type arguments" {
    let twice = try parser_support.statementNode("string?? text = null;");
    if (twice is VariableDeclarationNode) {
        let declared = twice.declaredType();
        if (declared is OptionalTypeNode) {
            try testing.assertEqual(declared.inner().kind(), SyntaxKind.OptionalType);
            try testing.assertEqual(declared.question().text(), "?");
        } else {
            try testing.fail("'string??' should be an optional over an optional");
        }
    } else {
        try testing.fail("'string?? text = null;' should be a variable declaration");
    }

    let three = try parser_support.statementNode("string??? deep = null;");
    if (three is VariableDeclarationNode) {
        let declared = three.declaredType();
        if (declared is OptionalTypeNode) {
            let second = declared.inner();
            if (second is OptionalTypeNode) {
                try testing.assertEqual(second.inner().kind(), SyntaxKind.OptionalType);
            } else {
                try testing.fail("'string???' should nest three optionals");
            }
        } else {
            try testing.fail("'string???' should be an optional type");
        }
    } else {
        try testing.fail("'string??? deep = null;' should be a variable declaration");
    }

    // The suffixes belong to the type argument, so the '>' still closes the argument list.
    let inArguments = try parser_support.statementNode("List<string??> texts = null;");
    if (inArguments is VariableDeclarationNode) {
        try testing.assertTrue(inArguments.declaredType()?.kind() == SyntaxKind.NamedType,
            "'List<string??>' is a named type with one argument");
    } else {
        try testing.fail("'List<string??> texts = null;' should be a variable declaration");
    }

    let arrayOfTwice = try parser_support.statementNode("string??[] cells = null;");
    if (arrayOfTwice is VariableDeclarationNode) {
        try testing.assertTrue(arrayOfTwice.declaredType()?.kind() == SyntaxKind.ArrayType,
            "'string??[]' is an array of a doubly-nullable element");
    } else {
        try testing.fail("'string??[] cells = null;' should be a variable declaration");
    }

    // Both suffix splits at once: the pair of '?' belongs to the innermost argument and the
    // '>>' closes two argument lists.
    let nested = try parser_support.statementNode("List<List<string??>> rows = null;");
    if (nested is VariableDeclarationNode) {
        try testing.assertTrue(nested.declaredType()?.kind() == SyntaxKind.NamedType,
            "'List<List<string??>>' is a named type");
    } else {
        try testing.fail("'List<List<string??>> rows = null;' should be a variable declaration");
    }
}
