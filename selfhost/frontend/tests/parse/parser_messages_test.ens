// Every message the parser reports, drawn from a source that produces it and asserted whole.
import parse.parser_support;

test "each source file problem reads as written" {
    try expectMessage("import ;",
        "Expected the path of the module to import. For example, write 'import engine.renderer;'.");
    try expectMessage("import a.b", "Expected ';' after the import path.");
    try expectMessage("import engine.renderer as ;",
        "Expected the alias after 'as'. For example, write 'import engine.renderer as gfx;'.");
    try expectMessage("external type ;",
        "Expected the external type's name. For example, write 'external type HANDLE;'.");
    try expectMessage("external type HANDLE", "Expected ';' after the external type declaration.");
    try expectMessage("external from libc", "Expected '\{' to begin the external block.");
    try expectMessage("external from libc", "Expected '\}' to close the external block.");
    try expectMessage("external from libc \{ 42 \}",
        "Expected an external function declaration, a name and parameters with no body. For "
            + "example, write 'CloseHandle(HANDLE h) -> int;'.");
    try expectMessage("external from libc \{ f(int x) -> ; \}", "Expected the return type after '->'.");
    try expectMessage("external from libc \{ f(int x) \}",
        "Expected ';' after the external function declaration.");
    try expectMessage("test \{ \}",
        "Expected a declaration, such as a function, class, struct, interface, enum, import or "
            + "test. Only declarations can be written outside a function.");
    try expectMessage("test \"adds\"", "Expected '\{' to begin the test body.");
    try expectMessage("area() -> \{ \}", "Expected the return type after '->'. For example, write '-> int'.");
    try expectMessage("area(int a,) \{ \}",
        "Expected a parameter after ','. Remove the ',' or write another parameter after it.");
    try expectMessage("area(int a int b) \{ \}", "Expected ',' between parameters.");
    try expectMessage("area(this x) \{ \}",
        "Expected '.' after 'this'. A parameter that sets a field is written 'this.' and the "
            + "field's name, as in 'constructor(this.x);'.");
    try expectMessage("area(this.) \{ \}", "Expected the field's name after 'this.'.");
    try expectMessage("area(int) \{ \}", "Expected the parameter's name. For example, write 'int value'.");
    try expectMessage("area(42) \{ \}",
        "Expected a parameter, a type followed by a name, such as 'int value'.");
    try expectMessage("main() \{ \} catch \{ \}",
        "Expected '(' after 'catch'. For example, write 'catch (Error e)'.");
    try expectMessage("main() \{ \} catch \{ \}",
        "Expected the type of error to catch. For example, write 'catch (Error e)'.");
    try expectMessage("main() \{ \} catch \{ \}",
        "Expected a name for the caught error. For example, write 'catch (Error e)'.");
    try expectMessage("main() \{ \} catch (Error e \{ \}", "Expected ')' after the caught error's name.");
    try expectMessage("main() \{ \} catch (Error e)", "Expected '\{' to begin the catch body.");
    try expectMessage("class \{ \}",
        "Expected the name of the class. For example, write 'class Point \{ ... \}'.");
    try expectMessage("class Point extends \{ \}", "Expected the base class's name after 'extends'.");
    try expectMessage("class Point implements \{ \}", "Expected an interface's name after 'implements'.");
    try expectMessage("class Point implements Shape, \{ \}", "Expected an interface's name after ','.");
    try expectMessage("interface \{ \}", "Expected the interface's name.");
    try expectMessage("interface Shape extends \{ \}",
        "Expected the name of the interface to extend after 'extends'.");
    try expectMessage("class Point", "Expected '\{' to begin the body of 'Point'.");
    try expectMessage("class Point", "Expected '\}' to close the body of 'Point'.");
    try expectMessage("class Point \{ 42 \}",
        "Expected a field or a method declaration, such as 'int count;' or 'area() -> int \{ ... \}'.");
    try expectMessage("class Point \{ int; \}", "Expected the field's name.");
    try expectMessage("class Point \{ int x \}", "Expected ';' after the field declaration.");
    try expectMessage("enum \{ \}", "Expected the enum's name.");
    try expectMessage("enum Color", "Expected '\{' to begin the enum's members.");
    try expectMessage("enum Color", "Expected '\}' to close the enum.");
    try expectMessage("enum Color \{ Red Green \}", "Expected ',' after the enum member 'Red'.");
    try expectMessage("enum Color \{ Red,", "Expected the name of an enum member, such as 'Red'.");
    try expectMessage("main() \{ let x = items[0; \}", "Expected ']' to close the index, as in 'items[0]'.");
    try expectMessage("main() \{ let x = items?[0; \}",
        "Expected ']' to close the index, as in 'items?[0]'.");
    try expectMessage("main() \{ let x = a.; \}", "Expected a member's name after '.'.");
    try expectMessage("main() \{ let x = a?.; \}", "Expected a member's name after '?.'.");
    try expectMessage("main() \{ let x = a as? ; \}",
        "Expected a type after 'as?'. For example, write 'x as? Circle'.");
    try expectMessage("main() \{ let x = a as ; \}",
        "Expected a type after 'as'. For example, write 'x as long'.");
    try expectMessage("main() \{ let x = a is ; \}",
        "Expected a type after 'is'. For example, write 'x is Circle'.");
    try expectMessage("main() \{ let x = (1; \}", "Expected ')' to match the '(' before it.");
    try expectMessage("main() \{ let x = ; \}",
        "Expected a value, such as '42', a variable's name or a call like 'count()'.");
    try expectMessage("main() \{ let f = (a, b) a; \}",
        "Expected ';' after the variable declaration. For example, write 'let count = 0;'.");
    try expectMessage("main() \{ let f = (a, b) a; \}",
        "Expected a statement, such as an assignment, a call or a declaration like 'let count = 0;'.");
    try expectMessage("main() \{ let x = [1, 2; \}", "Expected ']' to close the array literal.");
    try expectMessage("main() \{ let x = \{x: 1; \}", "Expected '\}' to close the struct literal.");
    try expectMessage("main() \{ let x = \{: 1\}; \}",
        "Expected a field's name. For example, write '\{x: 1, y: 2\}'.");
    try expectMessage("main() \{ let x = new Point; \}",
        "Expected '(' with the constructor's arguments, or '[' with an array size, after the "
            + "type in 'new'. For example, write 'new Point(0, 0)' or 'new int[8]'.");
    try expectMessage("main() \{ let x = new ; \}",
        "Expected a type after 'new'. For example, write 'new Point(0, 0)'.");
    try expectMessage("main() \{ let x = new int[3; \}", "Expected ']' after the array size.");
    try expectMessage("main() \{ let x = f(1; \}", "Expected ')' to close the call's arguments.");
    try expectMessage("main() \{ break \}", "Expected ';' after 'break'.");
    try expectMessage("main() \{ continue \}", "Expected ';' after 'continue'.");
    try expectMessage("main() \{ rethrow \}", "Expected ';' after 'rethrow'.");
    try expectMessage("main() \{ catch \}",
        "A 'catch' block can only follow the closing '\}' of a function's body. Move this "
            + "'catch' block to right after the function's '\}'.");
    try expectMessage("main() \{ finally \}",
        "Ens has no 'finally' block. Remove it, and write its cleanup before each 'return' and "
            + "in the 'catch' block instead.");
    try expectMessage("main() \{ let = 1; \}",
        "Expected the variable's name. For example, write 'let count = 0;'.");
    try expectMessage("main() \{ if (a \{ \} \}", "Expected ')' after the condition of 'if'.");
    try expectMessage("main() \{ if (a) x(); \}",
        "Expected '\{' to begin the body of 'if'. The branches of 'if' are always blocks, as in "
            + "'if (ready) \{ start(); \}'.");
    try expectMessage("main() \{ if (a) \{ \} else x(); \}", "Expected '\{' or another 'if' after 'else'.");
    try expectMessage("main() \{ while (a \{ \} \}", "Expected ')' after the condition of 'while'.");
    try expectMessage("main() \{ while (a) x(); \}", "Expected '\{' to begin the loop body.");
    try expectMessage("main() \{ for x \}",
        "Expected '(' after 'for'. For example, write 'for (let item in items) \{ ... \}'.");
    try expectMessage("main() \{ for x \}",
        "Expected ';' after the expression. For example, write 'total = total + 1;'.");
    try expectMessage("main() \{ for x \}",
        "Expected ';' after the condition of 'for'. The three parts are separated by ';', as in "
            + "'for (int i = 0; i < 10; i++)'.");
    try expectMessage("main() \{ for (let item in items \{ \} \}",
        "Expected ')' after the values the loop walks through, as in 'for (let item in items)'.");
    try expectMessage("main() \{ for (int i = 0; i < 3; i++ \{ \} \}",
        "Expected ')' after the three parts of 'for', as in 'for (int i = 0; i < 10; i++)'.");
    try expectMessage("main() \{ return 1 \}",
        "Expected ';' after the return statement. For example, write 'return value;'.");
    try expectMessage("main() \{ throw x \}", "Expected ';' after the throw statement.");
    try expectMessage("main() \{ switch x \{ \} \}",
        "Expected '(' after 'switch'. For example, write 'switch (color) \{ ... \}'.");
    try expectMessage("main() \{ switch x \{ \} \}", "Expected ')' after the switch value.");
    try expectMessage("main() \{ switch (x) \}", "Expected '\{' to begin the switch's arms.");
    try expectMessage("main() \{ switch (x) \}", "Expected '\}' to close the block that starts on line 1.");
    try expectMessage("main() \{ switch (x) \{ default a() \} \}",
        "Expected '->' after 'default'. For example, write 'default -> handleOther()'.");
    try expectMessage("main() \{ switch (x) \{ is -> a() \} \}",
        "Expected a type after 'is'. For example, write 'is Circle c -> c.radius'.");
    try expectMessage("main() \{ switch (x) \{ is Circle c c.radius \} \}",
        "Expected '->' after 'is Circle c'. For example, write 'is Circle c -> c.radius'.");
    try expectMessage("main() \{ switch (x) \{ 1 a() \} \}",
        "Expected '->' after the switch labels. For example, write '1 -> handleOne()'.");
    try expectMessage("main() \{ switch (x) \{ ) \} \}",
        "Expected a switch arm. For example, write '1 -> handleOne()'.");
    try expectMessage("main() \{ (,) -> int f = null; \}",
        "Expected a parameter type. For example, write '(int, int) -> int'.");
    try expectMessage("main() \{ (int) -> f = null; \}",
        "Expected the parameter's name after its type. For example, write '(int a, int b) -> a - b'.");
    try expectMessage("f() throws Error, \{ \}", "Expected an error type after ','.");
    try expectMessage("main() \{ (int f = null; \}",
        "Expected ')' after the type in parentheses. A function type also needs '->' and a "
            + "return type, as in '(int, int) -> int'.");
    try expectMessage("main() \{ string s = \"a \{x y\}\"; \}",
        "Expected '\}' after the value inside '\{...\}' in this string. Only one expression goes "
            + "between the braces.");
}

test "each manifest problem reads as written" {
    try expectManifestMessage("package \{ \}",
        "Expected the package's name after 'package'. For example, write 'package acme.tools \{ ... \}'.");
    try expectManifestMessage("package acme.tools", "Expected '\{' to begin the package declaration.");
    try expectManifestMessage("package acme.tools", "Expected '\}' to close the package declaration.");
    try expectManifestMessage("workspace", "Expected '\{' to begin the workspace declaration.");
    try expectManifestMessage("workspace", "Expected '\}' to close the workspace declaration.");
    try expectManifestMessage("overrides", "Expected '\{' to begin the overrides declaration.");
    try expectManifestMessage("overrides", "Expected '\}' to close the overrides declaration.");
    try expectManifestMessage("package acme.tools \{ version 1; \}",
        "Expected the package's version in quotes. For example, write 'version \"1.3.0\";'.");
    try expectManifestMessage("package acme.tools \{ version 1; \}",
        "Expected ';' after the version declaration.");
    try expectManifestMessage("package acme.tools \{ version 1; \}",
        "Expected a 'version', 'ens', 'dependency' or 'native' line inside the package declaration.");
    try expectManifestMessage("package acme.tools \{ ens 1; \}",
        "Expected the version of Ens the package is written for, in quotes. For example, write "
            + "'ens \"1.2\";'.");
    try expectManifestMessage("package acme.tools \{ ens 1; \}", "Expected ';' after the 'ens' declaration.");
    try expectManifestMessage("package acme.tools \{ dependency ; \}",
        "Expected the name of the package to depend on. For example, write 'dependency acme.json;'.");
    try expectManifestMessage("package acme.tools \{ dependency acme.json from ; \}",
        "Expected the package's git URL in quotes after 'from'. For example, write 'dependency "
            + "acme.json \"2.0\" from \"https://github.com/acme/json.git\";'.");
    try expectManifestMessage("package acme.tools \{ dependency acme.json \}",
        "Expected ';' after the dependency declaration.");
    try expectManifestMessage("package acme.tools \{ native ; \}",
        "Expected the native library's name. For example, write 'native zlib;'.");
    try expectManifestMessage("package acme.tools \{ native zlib \}",
        "Expected ';' after the native library's name, or a '\{ ... \}' block naming its library "
            + "for each platform. For example, write 'native zlib;'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ 42 \} \}",
        "Expected a platform and its library names. For example, write 'windows \"LLVM-C\";'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows artifact ; \} \}",
        "Expected the artifact's URL in quotes after 'artifact'. For example, write 'windows "
            + "artifact \"https://example.com/z.lib\" hash \"sha256:...\";'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows artifact ; \} \}",
        "Expected 'hash' and the artifact's sha256 hash after the URL. For example, write 'hash "
            + "\"sha256:...\"'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows artifact ; \} \}",
        "Expected the artifact's sha256 hash in quotes after 'hash'. For example, write 'hash "
            + "\"sha256:...\"'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows artifact \"u\" hash \"h\" \} \}",
        "Expected ';' after the artifact's hash.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows ; \} \}",
        "Expected at least one library name in quotes, without 'lib' in front or a file ending. "
            + "For example, write 'windows \"LLVM-C\";'.");
    try expectManifestMessage("package acme.tools \{ native zlib \{ windows \"z\" \} \}",
        "Expected ';' after the platform's library names.");
    try expectManifestMessage("workspace \{ member ; \}",
        "Expected the member's folder in quotes. For example, write 'member \"frontend\";'.");
    try expectManifestMessage("workspace \{ member \"a\" \}", "Expected ';' after the member declaration.");
    try expectManifestMessage("workspace \{ frobnicate; \}",
        "Expected a 'member' line inside the workspace declaration. For example, write 'member "
            + "\"frontend\";'.");
    try expectManifestMessage("overrides \{ override ; \}",
        "Expected the name of the package to override after 'override'. For example, write "
            + "'override alex.library \"../library\";'.");
    try expectManifestMessage("overrides \{ override ; \}",
        "Expected the folder to take the package from, in quotes. For example, write 'override "
            + "alex.library \"../library\";'.");
    try expectManifestMessage("overrides \{ override a.b \"../b\" \}",
        "Expected ';' after the override declaration.");
    try expectManifestMessage("overrides \{ frobnicate; \}",
        "Expected an 'override' line inside the overrides declaration. For example, write "
            + "'override alex.library \"../library\";'.");
    try expectManifestMessage("frobnicate",
        "Expected 'package', 'workspace' or 'overrides' at the start of the manifest. For "
            + "example, write 'package acme.tools \{ ... \}'.");
}

expectMessage(string text, string message) throws {
    try parser_support.assertMentions(parser_support.parseText(text), message);
}

expectManifestMessage(string text, string message) throws {
    try parser_support.assertMentions(parser_support.parseManifestText(text), message);
}
