// What the parser records about its own guesses: which absent tokens cost the tree something, and
// how far each guess reaches. A later phase reads these to decide which parts of a recovered tree
// it can still answer for, so the classification is the contract, not the count of diagnostics.
import @std.testing;
import parse.parser_support;
import Recovery from parse.recovery;
import RecoveryScope from parse.recovery;
import ParseResult from parse.parser;

assertScopes(ParseResult result, RecoveryScope[] expected) throws {
    let recoveries = result.recoveries();
    try testing.assertEqual(recoveries.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertTrue(recoveries[i].scope() == expected[i],
            "recovery {i} should be {expected[i]} but is {recoveries[i].scope()}");
    }
}

test "a sound parse records no guesses" {
    let text = "main() -> int \{\n    return 0;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertDiagnosticCount(result, 0);
    try assertScopes(result, []);
}

test "an absent separator or terminator costs the tree nothing" {
    // The parser fills one in without consuming a token, so both fields and both arms still mean
    // what they say and the next declaration parses as it would have.
    let text = "class Pair \{\n    long left\n    long right;\n\}\n"
        + "pick(long value) -> long \{\n"
        + "    return switch (value) \{\n"
        + "        0 -> 1\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try testing.assertEqual(result.diagnostics()[0].message(),
        "Expected ';' after the field declaration");
    try assertScopes(result, []);
}

test "an absent name is a guess about one construct" {
    let text = "class Box \{\n    long;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 1);
    try assertScopes(result, [RecoveryScope.Construct]);
}

test "an unclosed brace is a guess about the whole file" {
    let text = "main() \{\n    print(\"hi\");\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try assertScopes(result, [RecoveryScope.File]);
}

test "a statement body the source never opened is a guess in place" {
    let text = "main() \{\n    if (true) print(\"hi\");\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try assertScopes(result, [RecoveryScope.Construct]);
}

test "text that does not tokenize is a guess about the whole file" {
    let text = "main() \{\n    let text = \"unterminated;\n\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try testing.assertTrue(result.recoveries().length > 0, "a lex error is recorded as a guess");
    try testing.assertTrue(result.recoveries()[0].scope() == RecoveryScope.File,
        "an untokenizable run leaves the whole file a guess");
}

test "a guess made inside a rewound speculation is not recorded" {
    // 'Pair<long> left' opens with a speculative type parse; the same source without the type
    // arguments makes 'this.left' a shorthand parameter, and neither shape leaves a guess behind.
    let text = "class Pair<T> \{\n"
        + "    T left;\n"
        + "    constructor(this.left) \{\n"
        + "        let compared = 1 < 2;\n"
        + "    \}\n"
        + "\}\n";
    let result = parser_support.parseText(text);
    try parser_support.assertRoundTrip(text, result);
    try parser_support.assertDiagnosticCount(result, 0);
    try assertScopes(result, []);
}
