// Shared helpers for the parser test files. Every parse asserts the round-trip invariant: the
// green tree's full text reproduces the source byte for byte.
import @std.testing;
import Source from source;
import parser;
import ParseResult from parser;
import SyntaxKind from syntax.kind;
import syntax.factory;
import SyntaxNode from syntax.node;
import ListNode from syntax.nodes;

public parseText(string text) -> ParseResult {
    return parser.parse(new Source("test.ens", text));
}

public parseExpressionText(string text) -> ParseResult {
    return parser.parseExpressionOnly(new Source("test.ens", text));
}

public assertRoundTrip(string text, ParseResult result) throws {
    try testing.assertEqual(result.root().fullText(), text);
}

public assertNoDiagnostics(ParseResult result) throws {
    let diagnostics = result.diagnostics();
    if (diagnostics.length != 0) {
        try testing.fail("expected no diagnostics but found {diagnostics.length}; "
            + "first: {diagnostics[0].message()}");
    }
}

public assertDiagnosticCount(ParseResult result, long expected) throws {
    let diagnostics = result.diagnostics();
    if (diagnostics.length != expected) {
        string first = "";
        if (diagnostics.length > 0) {
            first = diagnostics[0].message();
        }
        try testing.fail("expected {expected} diagnostics but found {diagnostics.length}; "
            + "first: {first}");
    }
}

// Parses text as a standalone expression, asserting the round trip and no diagnostics, and
// returns the typed red node of the expression.
public expressionNode(string text) -> SyntaxNode throws {
    let result = parseExpressionText(text);
    try assertRoundTrip(text, result);
    try assertNoDiagnostics(result);
    return standaloneNode(result);
}

// The typed red node for the first child of a standalone parse's List root.
public standaloneNode(ParseResult result) -> SyntaxNode {
    let root = factory.createRoot(result.root());
    if (root is ListNode) {
        return root.childNodeAt(0);
    }
    panic("expected a List root from a standalone parse");
}
