import @std.testing;
import Source from support.source;
import SyntaxKind from syntax.generated.kind;
import lex.lexer;
import lex.lexer_support;

test "an unterminated string literal is reported over its whole span" {
    let text = "\"abc";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "This string has no closing '\"' on its line. A "
        + "string ends on the line it starts on. Add '\"' where the text ends.", 0L, 4L);
    try lexer_support.assertTiling(text, result);
}

test "an unterminated block comment is reported" {
    let text = "/* abc";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "This comment starts with '/*' and is never "
        + "closed. Write '*/' where the comment ends.", 0L, 6L);
    try lexer_support.assertTiling(text, result);
}

test "an unterminated character literal is reported" {
    let text = "'a";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "This character has no closing quote on its "
        + "line. Write one character between two single quotes, for example 'a'.", 0L, 2L);
    try lexer_support.assertTiling(text, result);
}

test "an invalid escape sequence is reported over the backslash and its target" {
    let text = "\"a\\qb\"";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "'\\q' is not an escape. In a string, a "
        + "backslash starts an escape that writes a special character, such as '\\n' for a new "
        + "line, '\\t' for a tab or '\\\\' for a backslash. Write '\\\\q' for a backslash "
        + "followed by 'q'.", 2L, 4L);
    try testing.assertTrue(result.tokens()[0].kind == SyntaxKind.StringLiteral, "the string still lexes as one literal");
    try lexer_support.assertTiling(text, result);
}

test "an invalid escape in a character literal offers no two-character fix" {
    let text = "'\\q'";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "'\\q' is not an escape. In a character, a "
        + "backslash starts an escape that writes a special character, such as '\\n' for a new "
        + "line, '\\t' for a tab or '\\\\' for a backslash.", 1L, 3L);
    try lexer_support.assertTiling(text, result);
}

test "an invalid escape of a multi-byte character spans the whole character" {
    byte[] raw = new byte[5];
    raw[0] = '"';
    raw[1] = '\\';
    raw[2] = 0xC3;
    raw[3] = 0xA9;
    raw[4] = '"';
    let text = string.fromBytesLossy(raw);
    let result = lexer.lex(new Source("errors.ens", text));
    let character = text.substring(2, 4);
    try lexer_support.assertOneDiagnostic(result, "'\\{character}' is not an escape. In a string, "
        + "a backslash starts an escape that writes a special character, such as '\\n' for a new "
        + "line, '\\t' for a tab or '\\\\' for a backslash. Write '\\\\{character}' for a "
        + "backslash followed by '{character}'.", 1L, 4L);
    try lexer_support.assertTiling(text, result);
}

test "an incomplete unicode escape is reported" {
    let text = "\"a\\u12\"";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "'\\u' must be followed by four hexadecimal "
        + "digits, the code of a character. Write the code after '\\u', for example '\\u00E9' "
        + "for '\u00E9'.", 2L, 4L);
    try lexer_support.assertTiling(text, result);
}

test "a stray ASCII character becomes an Invalid token with a diagnostic" {
    let text = "a # b";
    let result = lexer_support.lexText(text);
    try lexer_support.assertOneDiagnostic(result, "'#' cannot appear in code outside a string or a "
        + "comment. Remove it, or move it into a string.", 2L, 3L);
    bool sawInvalid = false;
    for (let piece in result.pieces()) {
        if (piece.kind == SyntaxKind.Invalid) {
            sawInvalid = true;
            try testing.assertEqual(piece.offset, 2L);
            try testing.assertEqual(piece.length, 1L);
        }
    }
    try testing.assertTrue(sawInvalid, "the stray character should produce an Invalid token");
    try lexer_support.assertTiling(text, result);
}

test "a non-ASCII byte outside a literal spans its whole codepoint as Invalid" {
    byte[] raw = new byte[4];
    raw[0] = 'a';
    raw[1] = 0xC3;
    raw[2] = 0xA9;
    raw[3] = 'b';
    let text = string.fromBytesLossy(raw);
    let result = lexer.lex(new Source("errors.ens", text));
    try testing.assertEqual(result.diagnostics().length, 1L);
    let diagnostic = result.diagnostics()[0];
    try testing.assertTrue(diagnostic.message().contains("' cannot appear in code outside a "
        + "string or a comment. Remove it, or move it into a string."),
        "reports an unexpected character");
    try testing.assertEqual(diagnostic.span().start, 1L);
    try testing.assertEqual(diagnostic.span().end(), 3L);
    bool sawInvalid = false;
    for (let piece in result.pieces()) {
        if (piece.kind == SyntaxKind.Invalid) {
            sawInvalid = true;
            try testing.assertEqual(piece.offset, 1L);
            try testing.assertEqual(piece.length, 2L);
        }
    }
    try testing.assertTrue(sawInvalid, "the codepoint should produce one Invalid token");
    try lexer_support.assertTiling(text, result);
}

test "a byte order mark away from the start of the file is an invalid character" {
    let text = "a" + lexer_support.markedText("b");
    let result = lexer_support.lexText(text);
    try testing.assertEqual(result.diagnostics().length, 1L);
    let diagnostic = result.diagnostics()[0];
    try testing.assertTrue(diagnostic.message().contains("' cannot appear in code outside a "
        + "string or a comment. Remove it, or move it into a string."),
        "reports an unexpected character");
    try testing.assertEqual(diagnostic.span().start, 1L);
    try testing.assertEqual(diagnostic.span().end(), 4L);
    try lexer_support.assertTiling(text, result);
}

test "malformed hex and binary literals are reported" {
    let hex = lexer_support.lexText("0x");
    try lexer_support.assertOneDiagnostic(hex, "'0x' starts a hexadecimal number, a number written "
        + "in base 16, but no digit follows it. Write at least one digit from 0 to 9 or A to F "
        + "after '0x', for example '0x1F'.", 0L, 2L);
    try testing.assertTrue(hex.tokens()[0].kind == SyntaxKind.IntLiteral, "the malformed hex still lexes as a literal");

    let binary = lexer_support.lexText("0b");
    try lexer_support.assertOneDiagnostic(binary, "'0b' starts a binary number, a number written "
        + "in base 2, but no digit follows it. Write at least one 0 or 1 after '0b', for example "
        + "'0b1010'.", 0L, 2L);

    let upper = lexer_support.lexText("0X");
    try lexer_support.assertOneDiagnostic(upper, "'0X' starts a hexadecimal number, a number "
        + "written in base 16, but no digit follows it. Write at least one digit from 0 to 9 or A "
        + "to F after '0X', for example '0x1F'.", 0L, 2L);
}
