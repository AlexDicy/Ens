import @std.testing;
import SyntaxKind from syntax.generated.kind;
import lex.lexer_support;

test "trailing trivia stops at the first newline and leading picks up after it" {
    let text = "  a // hi\nb\n// tail";
    let result = lexer_support.lexText(text);
    let tokens = result.tokens();
    try testing.assertEqual(tokens.length, 3L);

    let first = tokens[0];
    try testing.assertTrue(first.kind == SyntaxKind.Identifier, "the first token is the identifier a");
    try testing.assertEqual(first.leading.length, 1L);
    try testing.assertTrue(first.leading[0].kind == SyntaxKind.Whitespace, "leading is the file's opening whitespace");
    try testing.assertEqual(text.substring(first.leading[0].offset, first.leading[0].end()), "  ");
    try testing.assertEqual(first.trailing.length, 3L);
    try testing.assertTrue(first.trailing[0].kind == SyntaxKind.Whitespace, "trailing starts with a space");
    try testing.assertTrue(first.trailing[1].kind == SyntaxKind.LineComment, "then the same-line comment");
    try testing.assertTrue(first.trailing[2].kind == SyntaxKind.Newline, "and ends at the newline");

    let second = tokens[1];
    try testing.assertTrue(second.kind == SyntaxKind.Identifier, "the second token is the identifier b");
    try testing.assertEqual(second.leading.length, 0L);
    try testing.assertEqual(second.trailing.length, 1L);
    try testing.assertTrue(second.trailing[0].kind == SyntaxKind.Newline, "b's trailing is its line's newline");

    try lexer_support.assertTiling(text, result);
    try lexer_support.assertAttachmentTiling(text, result);
}

test "the end-of-file token owns the trailing tail as leading trivia" {
    let text = "  a // hi\nb\n// tail";
    let result = lexer_support.lexText(text);
    let tokens = result.tokens();
    let endOfFile = tokens[tokens.length - 1];
    try testing.assertTrue(endOfFile.kind == SyntaxKind.EndOfFile, "the last token is end of file");
    try testing.assertEqual(endOfFile.leading.length, 1L);
    try testing.assertTrue(endOfFile.leading[0].kind == SyntaxKind.LineComment, "the trailing comment is EOF leading");
    try testing.assertEqual(text.substring(endOfFile.leading[0].offset, endOfFile.leading[0].end()), "// tail");
    try testing.assertEqual(endOfFile.trailing.length, 0L);
}

test "a file that is only trivia gives all of it to the end-of-file token" {
    let text = "  // just a comment\n";
    let result = lexer_support.lexText(text);
    let tokens = result.tokens();
    try testing.assertEqual(tokens.length, 1L);
    let endOfFile = tokens[0];
    try testing.assertTrue(endOfFile.kind == SyntaxKind.EndOfFile, "the only token is end of file");
    try testing.assertEqual(endOfFile.leading.length, 3L);
    try testing.assertTrue(endOfFile.leading[0].kind == SyntaxKind.Whitespace, "leading whitespace");
    try testing.assertTrue(endOfFile.leading[1].kind == SyntaxKind.LineComment, "leading comment");
    try testing.assertTrue(endOfFile.leading[2].kind == SyntaxKind.Newline, "leading newline");
    try testing.assertEqual(endOfFile.trailing.length, 0L);
    try lexer_support.assertTiling(text, result);
    try lexer_support.assertAttachmentTiling(text, result);
}

test "an empty file lexes to a single end-of-file token with no trivia" {
    let text = "";
    let result = lexer_support.lexText(text);
    let tokens = result.tokens();
    try testing.assertEqual(tokens.length, 1L);
    try testing.assertTrue(tokens[0].kind == SyntaxKind.EndOfFile, "the only token is end of file");
    try testing.assertEqual(tokens[0].leading.length, 0L);
    try testing.assertEqual(tokens[0].trailing.length, 0L);
    try lexer_support.assertTiling(text, result);
}
