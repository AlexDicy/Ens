import @std.testing;
import syntax.generated.kind;
import syntax.generated.factory;
import syntax.generated.dump;
import SyntaxKind from syntax.generated.kind;
import GreenTrivia from syntax.green;
import GreenToken from syntax.green;
import GreenNode from syntax.green;
import SyntaxToken from syntax.node;
import Expression from syntax.generated.nodes;
import SourceFileNode from syntax.generated.nodes;
import ErrorDeclarationNode from syntax.generated.nodes;
import ReturnStatementNode from syntax.generated.nodes;
import IdentifierExpressionNode from syntax.generated.nodes;
import ArgumentListNode from syntax.generated.nodes;

// The green tree for "// header\nlet x = 42;\n": one error declaration whose
// skipped list holds five tokens, wrapped in the source file's item list.
private buildGreenFile() -> GreenNode {
    let letKeyword = new GreenToken(SyntaxKind.LetKeyword, "let",
        [new GreenTrivia(SyntaxKind.LineComment, "// header"), new GreenTrivia(SyntaxKind.Newline, "\n")],
        [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    let name = new GreenToken(SyntaxKind.Identifier, "x", [], [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    let equals = new GreenToken(SyntaxKind.Equals, "=", [], [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    let value = new GreenToken(SyntaxKind.IntLiteral, "42", [], []);
    let semicolon = new GreenToken(SyntaxKind.Semicolon, ";", [], [new GreenTrivia(SyntaxKind.Newline, "\n")]);
    let skipped = new GreenNode(SyntaxKind.List, [letKeyword, name, equals, value, semicolon]);
    let declaration = new GreenNode(SyntaxKind.ErrorDeclaration, [skipped]);
    let items = new GreenNode(SyntaxKind.List, [declaration]);
    let endOfFile = new GreenToken(SyntaxKind.EndOfFile, "", [], []);
    return new GreenNode(SyntaxKind.SourceFile, [items, endOfFile]);
}

test "kind predicates separate trivia, tokens, and nodes" {
    try testing.assertTrue(kind.isTrivia(SyntaxKind.Whitespace), "whitespace is trivia");
    try testing.assertTrue(kind.isTrivia(SyntaxKind.BlockComment), "comments are trivia");
    try testing.assertFalse(kind.isTrivia(SyntaxKind.Identifier), "identifiers are not trivia");
    try testing.assertTrue(kind.isToken(SyntaxKind.Missing), "missing placeholders are tokens");
    try testing.assertFalse(kind.isToken(SyntaxKind.Newline), "trivia is not a token");
    try testing.assertFalse(kind.isToken(SyntaxKind.SourceFile), "nodes are not tokens");
    try testing.assertTrue(kind.isNode(SyntaxKind.SourceFile), "rules are nodes");
    try testing.assertTrue(kind.isNode(SyntaxKind.List), "the synthetic list kind is a node");
    try testing.assertTrue(kind.isKeyword(SyntaxKind.LetKeyword), "let is a keyword");
    try testing.assertFalse(kind.isKeyword(SyntaxKind.Arrow), "punctuation is not a keyword");
    try testing.assertTrue(kind.isExpressionKind(SyntaxKind.LiteralExpression), "literals are expressions");
    try testing.assertFalse(kind.isExpressionKind(SyntaxKind.Block), "blocks are statements");
    try testing.assertTrue(kind.isStatementKind(SyntaxKind.Block), "blocks are statements");
}

test "text lookups map reserved and contextual keywords" {
    try testing.assertTrue(kind.keywordFromText("let") == SyntaxKind.LetKeyword, "let is reserved");
    try testing.assertTrue(kind.keywordFromText("bool") == SyntaxKind.BoolKeyword, "primitive types are reserved");
    try testing.assertTrue(kind.keywordFromText("out") == null, "contextual keywords lex as identifiers");
    try testing.assertTrue(kind.keywordFromText("banana") == null, "identifiers are not keywords");
    try testing.assertTrue(kind.contextualKeywordFromText("out") == SyntaxKind.OutKeyword, "out is contextual");
    try testing.assertTrue(kind.contextualKeywordFromText("let") == null, "reserved keywords are not contextual");
    try testing.assertEqual(kind.kindName(SyntaxKind.OpenParenthesis), "OpenParenthesis");
    try testing.assertEqual(kind.kindName(SyntaxKind.List), "List");
}

test "green tokens split content width from trivia width" {
    let token = new GreenToken(SyntaxKind.LetKeyword, "let",
        [new GreenTrivia(SyntaxKind.LineComment, "// header"), new GreenTrivia(SyntaxKind.Newline, "\n")],
        [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    try testing.assertEqual(token.kind(), SyntaxKind.LetKeyword);
    try testing.assertEqual(token.text(), "let");
    try testing.assertEqual(token.contentLength(), 3L);
    try testing.assertEqual(token.leadingLength(), 10L);
    try testing.assertEqual(token.trailingLength(), 1L);
    try testing.assertEqual(token.fullLength(), 14L);
    try testing.assertEqual(token.fullText(), "// header\nlet ");
    try testing.assertEqual(token.leadingTrivia().length, 2L);
    try testing.assertEqual(token.trailingTrivia().length, 1L);
}

test "green nodes sum slot widths and reconstruct the file" {
    let file = buildGreenFile();
    try testing.assertEqual(file.kind(), SyntaxKind.SourceFile);
    try testing.assertEqual(file.slotCount(), 2L);
    try testing.assertEqual(file.fullLength(), 22L);
    try testing.assertEqual(file.fullText(), "// header\nlet x = 42;\n");
}

test "red nodes carry offsets, spans, and parents" {
    let root = factory.createRoot(buildGreenFile());
    try testing.assertEqual(root.kind(), SyntaxKind.SourceFile);
    try testing.assertTrue(root.parent() == null, "the root has no parent");
    try testing.assertEqual(root.fullText(), "// header\nlet x = 42;\n");
    let rootFullSpan = root.fullSpan();
    try testing.assertEqual(rootFullSpan.start, 0L);
    try testing.assertEqual(rootFullSpan.length, 22L);
    let rootSpan = root.span();
    try testing.assertEqual(rootSpan.start, 10L);
    try testing.assertEqual(rootSpan.end(), 22L);

    if (root is SourceFileNode) {
        SourceFileNode sourceFile = root;
        try testing.assertEqual(sourceFile.itemsCount(), 1L);
        let eofToken = sourceFile.eof();
        try testing.assertEqual(eofToken.kind(), SyntaxKind.EndOfFile);
        let eofSpan = eofToken.span();
        try testing.assertEqual(eofSpan.start, 22L);
        try testing.assertEqual(eofSpan.length, 0L);

        let item = sourceFile.items(0);
        if (item is ErrorDeclarationNode) {
            ErrorDeclarationNode declaration = item;
            try testing.assertEqual(declaration.kind(), SyntaxKind.ErrorDeclaration);
            try testing.assertTrue(declaration.parent()?.kind() == SyntaxKind.List,
                "the item's parent is the item list");
            try testing.assertTrue(declaration.parent()?.parent() == sourceFile,
                "the item list's parent is the root");
            let itemSpan = declaration.span();
            try testing.assertEqual(itemSpan.start, 10L);
            try testing.assertEqual(itemSpan.length, 11L);
            let itemFullSpan = declaration.fullSpan();
            try testing.assertEqual(itemFullSpan.start, 0L);
            try testing.assertEqual(itemFullSpan.length, 22L);

            try testing.assertEqual(declaration.skippedCount(), 5L);
            let letToken = declaration.skipped(0);
            try testing.assertEqual(letToken.kind(), SyntaxKind.LetKeyword);
            try testing.assertEqual(letToken.text(), "let");
            try testing.assertTrue(letToken.parent()?.kind() == SyntaxKind.List,
                "the token's parent is the skipped list");
            try testing.assertEqual(letToken.leadingTrivia().length, 2L);
            let letSpan = letToken.span();
            try testing.assertEqual(letSpan.start, 10L);
            try testing.assertEqual(letSpan.length, 3L);
            let letFullSpan = letToken.fullSpan();
            try testing.assertEqual(letFullSpan.start, 0L);
            try testing.assertEqual(letFullSpan.length, 14L);

            let valueToken = declaration.skipped(3);
            try testing.assertEqual(valueToken.kind(), SyntaxKind.IntLiteral);
            let valueSpan = valueToken.span();
            try testing.assertEqual(valueSpan.start, 18L);
            try testing.assertEqual(valueSpan.length, 2L);
        } else {
            try testing.fail("the item should be an ErrorDeclarationNode");
        }
    } else {
        try testing.fail("the root should be a SourceFileNode");
    }
}

test "token walks find the first and last tokens" {
    let root = factory.createRoot(buildGreenFile());
    let first = root.firstToken();
    if (first == null) {
        try testing.fail("the tree should start with a token");
    } else {
        SyntaxToken firstToken = first;
        try testing.assertEqual(firstToken.kind(), SyntaxKind.LetKeyword);
        try testing.assertTrue(firstToken.parent()?.kind() == SyntaxKind.List,
            "the first token hangs off the skipped list");
        try testing.assertTrue(firstToken.parent()?.parent()?.kind() == SyntaxKind.ErrorDeclaration,
            "the skipped list hangs off the declaration");
    }
    let last = root.lastToken();
    if (last == null) {
        try testing.fail("the tree should end with a token");
    } else {
        SyntaxToken lastToken = last;
        try testing.assertEqual(lastToken.kind(), SyntaxKind.EndOfFile);
        try testing.assertTrue(lastToken.parent()?.kind() == SyntaxKind.SourceFile,
            "the end-of-file token hangs off the root");
        let lastSpan = lastToken.span();
        try testing.assertEqual(lastSpan.start, 22L);
        try testing.assertEqual(lastSpan.length, 0L);
    }
}

// The green tree for "return x;" with the value present, and "return ;"
// shaped green with the optional value slot left null.
test "typed accessors read required and optional slots" {
    let returnKeyword = new GreenToken(SyntaxKind.ReturnKeyword, "return", [],
        [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    let name = new GreenToken(SyntaxKind.Identifier, "x", [], []);
    let valueExpression = new GreenNode(SyntaxKind.IdentifierExpression, [name]);
    let semicolon = new GreenToken(SyntaxKind.Semicolon, ";", [], []);
    let withValue = factory.createRoot(
        new GreenNode(SyntaxKind.ReturnStatement, [returnKeyword, valueExpression, semicolon]));
    if (withValue is ReturnStatementNode) {
        ReturnStatementNode statement = withValue;
        try testing.assertEqual(statement.returnKeyword().text(), "return");
        try testing.assertEqual(statement.semicolon().kind(), SyntaxKind.Semicolon);
        let value = statement.value();
        if (value == null) {
            try testing.fail("the value should be present");
        } else {
            Expression expression = value;
            try testing.assertEqual(expression.kind(), SyntaxKind.IdentifierExpression);
            let valueSpan = expression.span();
            try testing.assertEqual(valueSpan.start, 7L);
            try testing.assertEqual(valueSpan.length, 1L);
            if (expression is IdentifierExpressionNode) {
                IdentifierExpressionNode identifier = expression;
                try testing.assertEqual(identifier.name().text(), "x");
            } else {
                try testing.fail("the value should be an IdentifierExpressionNode");
            }
        }
    } else {
        try testing.fail("the root should be a ReturnStatementNode");
    }

    let bareReturn = factory.createRoot(
        new GreenNode(SyntaxKind.ReturnStatement, [returnKeyword, null, semicolon]));
    if (bareReturn is ReturnStatementNode) {
        ReturnStatementNode statement = bareReturn;
        try testing.assertTrue(statement.value() == null, "the empty optional slot reads as null");
        try testing.assertEqual(statement.semicolon().text(), ";");
    } else {
        try testing.fail("the root should be a ReturnStatementNode");
    }
}

// The green tree for "(a, b)": a separated list with the comma at child 1.
test "list accessors step over separators" {
    let openParenthesis = new GreenToken(SyntaxKind.OpenParenthesis, "(", [], []);
    let first = new GreenNode(SyntaxKind.IdentifierExpression,
        [new GreenToken(SyntaxKind.Identifier, "a", [], [])]);
    let comma = new GreenToken(SyntaxKind.Comma, ",", [], [new GreenTrivia(SyntaxKind.Whitespace, " ")]);
    let second = new GreenNode(SyntaxKind.IdentifierExpression,
        [new GreenToken(SyntaxKind.Identifier, "b", [], [])]);
    let arguments = new GreenNode(SyntaxKind.List, [first, comma, second]);
    let closeParenthesis = new GreenToken(SyntaxKind.CloseParenthesis, ")", [], []);
    let root = factory.createRoot(
        new GreenNode(SyntaxKind.ArgumentList, [openParenthesis, arguments, closeParenthesis]));
    try testing.assertEqual(root.fullText(), "(a, b)");
    if (root is ArgumentListNode) {
        ArgumentListNode argumentList = root;
        try testing.assertEqual(argumentList.openParenthesis().text(), "(");
        try testing.assertEqual(argumentList.closeParenthesis().text(), ")");
        try testing.assertEqual(argumentList.argumentsCount(), 2L);
        let firstArgument = argumentList.arguments(0);
        if (firstArgument is IdentifierExpressionNode) {
            IdentifierExpressionNode identifier = firstArgument;
            try testing.assertEqual(identifier.name().text(), "a");
        } else {
            try testing.fail("the first argument should be an IdentifierExpressionNode");
        }
        let secondArgument = argumentList.arguments(1);
        if (secondArgument is IdentifierExpressionNode) {
            IdentifierExpressionNode identifier = secondArgument;
            try testing.assertEqual(identifier.name().text(), "b");
            let secondSpan = identifier.span();
            try testing.assertEqual(secondSpan.start, 4L);
            try testing.assertEqual(secondSpan.length, 1L);
        } else {
            try testing.fail("the second argument should be an IdentifierExpressionNode");
        }
    } else {
        try testing.fail("the root should be an ArgumentListNode");
    }
}

test "the dump prints kinds, spans, and token text" {
    let root = factory.createRoot(buildGreenFile());
    let text = dump.dumpTree(root);
    try testing.assertTrue(text.contains("SourceFile [10..22)"), "the root line shows the span");
    try testing.assertTrue(text.contains("ErrorDeclaration [10..21)"), "node lines show content spans");
    try testing.assertTrue(text.contains("LetKeyword \"let\" [10..13)"), "token lines show text and span");
    try testing.assertTrue(text.contains("IntLiteral \"42\" [18..20)"), "literal tokens keep their text");
    try testing.assertTrue(text.contains("EndOfFile \"\" [22..22)"), "the end-of-file token is empty");
}
