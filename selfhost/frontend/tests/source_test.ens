import @std.testing;
import Source from support.source;
import LineIndex from support.source;

test "source exposes path, text, length, and bytes" {
    let sample = new Source("sample.ens", "ab\ncd");
    try testing.assertEqual(sample.path(), "sample.ens");
    try testing.assertEqual(sample.text(), "ab\ncd");
    try testing.assertEqual(sample.length(), 5L);
    try testing.assertTrue(sample.byteAt(0) == 'a', "byte 0 should be 'a'");
    try testing.assertTrue(sample.byteAt(2) == '\n', "byte 2 should be the line feed");
}

test "offsets map to lines and columns across LF and CRLF" {
    let index = new LineIndex(new Source("sample.ens", "ab\ncd\r\nef"));
    try testing.assertEqual(index.lineCount(), 3L);

    let start = index.positionAt(0);
    try testing.assertEqual(start.line, 1L);
    try testing.assertEqual(start.column, 1L);

    let lineFeed = index.positionAt(2);
    try testing.assertEqual(lineFeed.line, 1L);
    try testing.assertEqual(lineFeed.column, 3L);

    let secondLine = index.positionAt(3);
    try testing.assertEqual(secondLine.line, 2L);
    try testing.assertEqual(secondLine.column, 1L);

    let carriageReturn = index.positionAt(5);
    try testing.assertEqual(carriageReturn.line, 2L);
    try testing.assertEqual(carriageReturn.column, 3L);

    let thirdLine = index.positionAt(7);
    try testing.assertEqual(thirdLine.line, 3L);
    try testing.assertEqual(thirdLine.column, 1L);

    let endOfFile = index.positionAt(9);
    try testing.assertEqual(endOfFile.line, 3L);
    try testing.assertEqual(endOfFile.column, 3L);
}

test "empty and newline-terminated files still map" {
    let empty = new LineIndex(new Source("empty.ens", ""));
    try testing.assertEqual(empty.lineCount(), 1L);
    let onlyPosition = empty.positionAt(0);
    try testing.assertEqual(onlyPosition.line, 1L);
    try testing.assertEqual(onlyPosition.column, 1L);

    let terminated = new LineIndex(new Source("terminated.ens", "a\n"));
    try testing.assertEqual(terminated.lineCount(), 2L);
    let pastEnd = terminated.positionAt(2);
    try testing.assertEqual(pastEnd.line, 2L);
    try testing.assertEqual(pastEnd.column, 1L);
}
