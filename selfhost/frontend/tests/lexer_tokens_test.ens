import @std.testing;
import SyntaxKind from syntax.kind;
import lexer_support;

test "punctuation is maximal-munched, ?? is one token, and ?[ stays split" {
    let text = ">>>= >>> >>= <<= ... == != <= >= -> && || ++ -- << >> += ?? ?. ?[ ?";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.GreaterGreaterGreaterEquals, SyntaxKind.GreaterGreaterGreater,
        SyntaxKind.GreaterGreaterEquals, SyntaxKind.LessLessEquals, SyntaxKind.Ellipsis,
        SyntaxKind.EqualsEquals, SyntaxKind.NotEquals, SyntaxKind.LessEquals,
        SyntaxKind.GreaterEquals, SyntaxKind.Arrow, SyntaxKind.AmpersandAmpersand,
        SyntaxKind.PipePipe, SyntaxKind.PlusPlus, SyntaxKind.MinusMinus, SyntaxKind.LessLess,
        SyntaxKind.GreaterGreater, SyntaxKind.PlusEquals, SyntaxKind.QuestionQuestion,
        SyntaxKind.QuestionDot, SyntaxKind.Question, SyntaxKind.OpenBracket, SyntaxKind.Question,
        SyntaxKind.EndOfFile,
    ]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}

test "reserved keywords lex as keywords; contextual keywords stay identifiers" {
    let text = "class if let out in test foo return";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.ClassKeyword, SyntaxKind.IfKeyword, SyntaxKind.LetKeyword,
        SyntaxKind.Identifier, SyntaxKind.Identifier, SyntaxKind.Identifier,
        SyntaxKind.Identifier, SyntaxKind.ReturnKeyword, SyntaxKind.EndOfFile,
    ]);
    try lexer_support.assertTiling(text, result);
}

test "numeric literals classify by suffix, fraction, and exponent" {
    let text = "0 42 1_000 0xFF 0b1010 3.14 1.5e-3 10L 2.0f 3.0d 5f 0x1Fl";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.IntLiteral, SyntaxKind.IntLiteral, SyntaxKind.IntLiteral,
        SyntaxKind.IntLiteral, SyntaxKind.IntLiteral, SyntaxKind.DoubleLiteral,
        SyntaxKind.DoubleLiteral, SyntaxKind.LongLiteral, SyntaxKind.FloatLiteral,
        SyntaxKind.DoubleLiteral, SyntaxKind.FloatLiteral, SyntaxKind.LongLiteral,
        SyntaxKind.EndOfFile,
    ]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}

test "a trailing dot is not part of an integer literal" {
    let text = "1.";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [SyntaxKind.IntLiteral, SyntaxKind.Dot, SyntaxKind.EndOfFile]);
    try lexer_support.assertTiling(text, result);
}

test "a plain string is one literal but a hole opens an interpolation triple" {
    let plain = lexer_support.lexText("\"hello\"");
    try lexer_support.assertKinds(plain.tokens(), [SyntaxKind.StringLiteral, SyntaxKind.EndOfFile]);

    let interpolated = lexer_support.lexText("\"a\{x\}b\"");
    try lexer_support.assertKinds(interpolated.tokens(), [
        SyntaxKind.InterpolatedStringStart, SyntaxKind.Identifier,
        SyntaxKind.InterpolatedStringEnd, SyntaxKind.EndOfFile,
    ]);
    try lexer_support.assertTiling("\"a\{x\}b\"", interpolated);
}

test "valid escapes carry no diagnostic" {
    let text = "\"x\\n\\\{\\\}\\u00FF\"";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [SyntaxKind.StringLiteral, SyntaxKind.EndOfFile]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}

test "nested interpolated strings inside a hole lex with a brace-depth stack" {
    let text = "\"outer \{\"inner-\{x\}\"\} tail\"";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.InterpolatedStringStart, SyntaxKind.InterpolatedStringStart,
        SyntaxKind.Identifier, SyntaxKind.InterpolatedStringEnd,
        SyntaxKind.InterpolatedStringEnd, SyntaxKind.EndOfFile,
    ]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}

test "braces inside a hole nest without closing the hole early" {
    let text = "\"a\{ f(x)[0] \}b\"";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.InterpolatedStringStart, SyntaxKind.Identifier, SyntaxKind.OpenParenthesis,
        SyntaxKind.Identifier, SyntaxKind.CloseParenthesis, SyntaxKind.OpenBracket,
        SyntaxKind.IntLiteral, SyntaxKind.CloseBracket, SyntaxKind.InterpolatedStringEnd,
        SyntaxKind.EndOfFile,
    ]);
    try lexer_support.assertTiling(text, result);
}

test "character literals cover plain and escaped forms" {
    let text = "'a' '\\n' '\\''";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.CharLiteral, SyntaxKind.CharLiteral, SyntaxKind.CharLiteral,
        SyntaxKind.EndOfFile,
    ]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}

test "comments are trivia and the newline is a separate piece" {
    let text = "a // line\nb /* block */ c";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.Identifier, SyntaxKind.Identifier, SyntaxKind.Identifier, SyntaxKind.EndOfFile,
    ]);
    bool sawLineComment = false;
    bool sawBlockComment = false;
    bool sawNewline = false;
    for (let piece in result.pieces()) {
        if (piece.kind == SyntaxKind.LineComment) {
            sawLineComment = true;
        }
        if (piece.kind == SyntaxKind.BlockComment) {
            sawBlockComment = true;
        }
        if (piece.kind == SyntaxKind.Newline) {
            sawNewline = true;
        }
    }
    try testing.assertTrue(sawLineComment, "the line comment should be a trivia piece");
    try testing.assertTrue(sawBlockComment, "the block comment should be a trivia piece");
    try testing.assertTrue(sawNewline, "the newline should be its own trivia piece");
    try lexer_support.assertTiling(text, result);
}

test "CRLF and LF each lex as a single newline piece" {
    let result = lexer_support.lexText("a\r\nb\nc");
    long crlfLength = 0;
    long lfLength = 0;
    long newlineCount = 0;
    for (let piece in result.pieces()) {
        if (piece.kind == SyntaxKind.Newline) {
            newlineCount = newlineCount + 1;
            if (newlineCount == 1) {
                crlfLength = piece.length;
            } else {
                lfLength = piece.length;
            }
        }
    }
    try testing.assertEqual(newlineCount, 2L);
    try testing.assertEqual(crlfLength, 2L);
    try testing.assertEqual(lfLength, 1L);
    try lexer_support.assertTiling("a\r\nb\nc", result);
}

test "a realistic program lexes into the expected token stream" {
    let text = "class C \{\n  greet(string name) -> string \{\n    // hi\n    return \"Hello, \{name\}!\";\n  \}\n\}\n";
    let result = lexer_support.lexText(text);
    try lexer_support.assertKinds(result.tokens(), [
        SyntaxKind.ClassKeyword, SyntaxKind.Identifier, SyntaxKind.OpenBrace,
        SyntaxKind.Identifier, SyntaxKind.OpenParenthesis, SyntaxKind.StringKeyword,
        SyntaxKind.Identifier, SyntaxKind.CloseParenthesis, SyntaxKind.Arrow,
        SyntaxKind.StringKeyword, SyntaxKind.OpenBrace, SyntaxKind.ReturnKeyword,
        SyntaxKind.InterpolatedStringStart, SyntaxKind.Identifier,
        SyntaxKind.InterpolatedStringEnd, SyntaxKind.Semicolon, SyntaxKind.CloseBrace,
        SyntaxKind.CloseBrace, SyntaxKind.EndOfFile,
    ]);
    try testing.assertEqual(result.diagnostics().length, 0L);
    try lexer_support.assertTiling(text, result);
}
