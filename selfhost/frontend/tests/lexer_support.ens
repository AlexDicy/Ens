// Shared helpers for the lexer test files. Kept in one module so the test
// binary links a single copy; top-level functions share a global namespace.
import @std.testing;
import StringBuilder from @std.stringbuilder;
import Source from source;
import SyntaxKind from syntax.kind;
import lexer;
import LexResult from lexer;
import RawToken from token;
import LexedToken from token;

public lexText(string text) -> LexResult {
    return lexer.lex(new Source("test.ens", text));
}

// The layer-1 invariant every test asserts: the flat pieces tile the file, so
// concatenating each piece's bytes reproduces the source exactly.
public assertTiling(string text, LexResult result) throws {
    let builder = new StringBuilder();
    for (let piece in result.pieces()) {
        builder.append(text.substring(piece.offset, piece.end()));
    }
    try testing.assertEqual(builder.toString(), text);
}

// The layer-2 invariant: walking each token's leading trivia, the token, then
// its trailing trivia, in token order, also reproduces the file byte for byte.
public assertAttachmentTiling(string text, LexResult result) throws {
    let builder = new StringBuilder();
    for (let token in result.tokens()) {
        for (let leadingTrivia in token.leading) {
            builder.append(text.substring(leadingTrivia.offset, leadingTrivia.end()));
        }
        builder.append(text.substring(token.offset, token.end()));
        for (let trailingTrivia in token.trailing) {
            builder.append(text.substring(trailingTrivia.offset, trailingTrivia.end()));
        }
    }
    try testing.assertEqual(builder.toString(), text);
}

public assertKinds(LexedToken[] tokens, SyntaxKind[] expected) throws {
    try testing.assertEqual(tokens.length, expected.length);
    for (long i = 0; i < expected.length; i = i + 1) {
        try testing.assertTrue(tokens[i].kind == expected[i], "significant token {i} has the wrong kind");
    }
}

public assertOneDiagnostic(LexResult result, string message, long start, long end) throws {
    try testing.assertEqual(result.diagnostics().length, 1L);
    let diagnostic = result.diagnostics()[0];
    try testing.assertEqual(diagnostic.message(), message);
    try testing.assertEqual(diagnostic.span().start, start);
    try testing.assertEqual(diagnostic.span().end(), end);
}
