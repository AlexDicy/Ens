// The red layer base: position-aware, parent-linked views over green elements,
// created on demand and thrown away freely. Generated node classes extend
// SyntaxNode and read their slots through the protected helpers; red children
// are built through the NodeFactory implemented by the generated factory.
import SyntaxKind from syntax.kind;
import GreenTrivia from syntax.green;
import GreenToken from syntax.green;
import GreenNode from syntax.green;
import Span from source;
import source;
import internal;

public class SyntaxToken {
    private GreenToken greenToken;
    private long fullStart;
    private SyntaxNode? parentNode;

    SyntaxToken(GreenToken green, long fullStart, SyntaxNode? parent) {
        this.greenToken = green;
        this.fullStart = fullStart;
        this.parentNode = parent;
    }

    kind() -> SyntaxKind { return this.greenToken.kind(); }
    text() -> string { return this.greenToken.text(); }
    green() -> GreenToken { return this.greenToken; }
    parent() -> SyntaxNode? { return this.parentNode; }
    leadingTrivia() -> GreenTrivia[] { return this.greenToken.leadingTrivia(); }
    trailingTrivia() -> GreenTrivia[] { return this.greenToken.trailingTrivia(); }

    // The token text alone, trivia excluded.
    span() -> Span {
        return source.makeSpan(this.fullStart + this.greenToken.leadingLength(),
                               this.greenToken.contentLength());
    }

    // The token together with all its trivia.
    fullSpan() -> Span {
        return source.makeSpan(this.fullStart, this.greenToken.fullLength());
    }
}

// Creates the typed red node for a green node. Implemented by the generated
// factory module, so this base layer never names the generated classes.
public interface NodeFactory {
    create(GreenNode green, long fullStart, SyntaxNode? parent) -> SyntaxNode;
}

public abstract class SyntaxNode {
    private GreenNode greenNode;
    private long fullStart;
    private SyntaxNode? parentNode;
    private NodeFactory factory;

    SyntaxNode(GreenNode green, long fullStart, SyntaxNode? parent, NodeFactory factory) {
        this.greenNode = green;
        this.fullStart = fullStart;
        this.parentNode = parent;
        this.factory = factory;
    }

    kind() -> SyntaxKind { return this.greenNode.kind(); }
    green() -> GreenNode { return this.greenNode; }
    parent() -> SyntaxNode? { return this.parentNode; }
    fullText() -> string { return this.greenNode.fullText(); }

    fullSpan() -> Span {
        return source.makeSpan(this.fullStart, this.greenNode.fullLength());
    }

    // From the first token's content start to the last token's content end; a
    // node with no tokens collapses to a zero-length span at its full start.
    span() -> Span {
        let first = this.firstToken();
        if (first == null) {
            return source.makeSpan(this.fullStart, 0);
        }
        let last = this.lastToken();
        if (last == null) {
            return source.makeSpan(this.fullStart, 0);
        }
        let firstSpan = first.span();
        let lastSpan = last.span();
        return source.makeSpan(firstSpan.start, lastSpan.end() - firstSpan.start);
    }

    firstToken() -> SyntaxToken? {
        long offset = this.fullStart;
        for (long i = 0; i < this.greenNode.slotCount(); i = i + 1) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                long width = child.fullLength();
                if (child is GreenToken) {
                    return new SyntaxToken(child, offset, this);
                }
                if (child is GreenNode) {
                    let token = this.factory.create(child, offset, this).firstToken();
                    if (token != null) {
                        return token;
                    }
                }
                offset = offset + width;
            }
        }
        return null;
    }

    lastToken() -> SyntaxToken? {
        long offset = this.fullStart + this.greenNode.fullLength();
        for (long i = this.greenNode.slotCount() - 1; i >= 0; i = i - 1) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                offset = offset - child.fullLength();
                if (child is GreenToken) {
                    return new SyntaxToken(child, offset, this);
                }
                if (child is GreenNode) {
                    let token = this.factory.create(child, offset, this).lastToken();
                    if (token != null) {
                        return token;
                    }
                }
            }
        }
        return null;
    }

    protected slotCount() -> long { return this.greenNode.slotCount(); }

    protected tokenAt(long slotIndex) -> SyntaxToken {
        let token = this.tokenAtOrNull(slotIndex);
        if (token != null) {
            return token;
        }
        internal.fatal("slot {slotIndex} of a {this.kind()} node does not hold a token");
        while (true) { }
    }

    protected tokenAtOrNull(long slotIndex) -> SyntaxToken? {
        let child = this.greenNode.slot(slotIndex);
        if (child == null) {
            return null;
        }
        if (child is GreenToken) {
            return new SyntaxToken(child, this.slotStart(slotIndex), this);
        }
        return null;
    }

    protected nodeAt(long slotIndex) -> SyntaxNode {
        let node = this.nodeAtOrNull(slotIndex);
        if (node != null) {
            return node;
        }
        internal.fatal("slot {slotIndex} of a {this.kind()} node does not hold a node");
        while (true) { }
    }

    protected nodeAtOrNull(long slotIndex) -> SyntaxNode? {
        let child = this.greenNode.slot(slotIndex);
        if (child == null) {
            return null;
        }
        if (child is GreenNode) {
            return this.factory.create(child, this.slotStart(slotIndex), this);
        }
        return null;
    }

    // Absolute full start of the element in the given slot.
    private slotStart(long slotIndex) -> long {
        long offset = this.fullStart;
        for (long i = 0; i < slotIndex; i = i + 1) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                offset = offset + child.fullLength();
            }
        }
        return offset;
    }
}
