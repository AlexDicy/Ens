// PLACEHOLDER: hand-written subset of a generated module. The syntaxgen tool
// will overwrite this file with the full SyntaxKind enum and predicates derived
// from selfhost/syntax.grammar.

public enum SyntaxKind {
    Whitespace,
    Newline,
    LineComment,
    BlockComment,
    EndOfFile,
    Invalid,
    Missing,
    Identifier,
    IntLiteral,
    StringLiteral,
    OpenParenthesis,
    CloseParenthesis,
    OpenBrace,
    CloseBrace,
    Semicolon,
    Equals,
    ClassKeyword,
    LetKeyword,
    SourceFile,
    ErrorDeclaration,
}

public isTrivia(SyntaxKind kind) -> bool {
    return switch (kind) {
        Whitespace, Newline, LineComment, BlockComment -> true,
        default -> false,
    };
}

public isToken(SyntaxKind kind) -> bool {
    return switch (kind) {
        EndOfFile, Invalid, Missing, Identifier, IntLiteral, StringLiteral,
        OpenParenthesis, CloseParenthesis, OpenBrace, CloseBrace, Semicolon,
        Equals, ClassKeyword, LetKeyword -> true,
        default -> false,
    };
}
