}

public class SyntaxNodeFactory implements NodeFactory {
    SyntaxNodeFactory();

    override create(GreenNode green, long fullStart, SyntaxNode? parent) -> SyntaxNode {
        switch (green.kind()) {
            SourceFile -> { return new SourceFileNode(green, fullStart, parent, this); },
            ErrorDeclaration -> { return new ErrorDeclarationNode(green, fullStart, parent, this); },
            default -> { },
        }
        internal.fatal("no typed node is registered for kind {green.kind()}");
        while (true) { }
    }
}

// Builds the typed red root for a green tree.
public createRoot(GreenNode green) -> SyntaxNode {
    return new SyntaxNodeFactory().create(green, 0, null);
}
