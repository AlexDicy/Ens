public class SourceFileNode extends SyntaxNode {
    SourceFileNode(GreenNode green, long fullStart, SyntaxNode? parent, NodeFactory factory) {
        super(green, fullStart, parent, factory);
    }

    itemCount() -> long { return this.slotCount(); }
    item(long index) -> SyntaxNode { return this.nodeAt(index); }
}

public class ErrorDeclarationNode extends SyntaxNode {
    ErrorDeclarationNode(GreenNode green, long fullStart, SyntaxNode? parent, NodeFactory factory) {
        super(green, fullStart, parent, factory);
