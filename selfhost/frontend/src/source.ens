// Source text and position mapping for the self-hosted front end. All offsets are UTF-8 byte
// offsets; lines and columns are 1-based.

public struct Span {
    long start;
    long length;

    end() -> long {
        return this.start + this.length;
    }
}

public makeSpan(long start, long length) -> Span {
    Span span;
    span.start = start;
    span.length = length;
    return span;
}

public struct LinePosition {
    long line;
    long column;
}

public class Source {
    private string sourcePath;
    private string sourceText;
    private byte[] sourceBytes;

    Source(string path, string text) {
        this.sourcePath = path;
        this.sourceText = text;
        this.sourceBytes = text.toBytes();
    }

    path() -> string {
        return this.sourcePath;
    }

    text() -> string {
        return this.sourceText;
    }

    length() -> long {
        return this.sourceBytes.length;
    }

    byteAt(long offset) -> byte {
        return this.sourceBytes[offset];
    }
}

// Maps a byte offset to its 1-based line and byte column. The line start table is built once at
// construction; lookups binary search it. A "\r\n" sequence ends its line at the "\n", so both
// bytes still belong to the line they end.
public class LineIndex {
    private long[] lineStarts;

    LineIndex(Source source) {
        long lines = 1;
        for (long i = 0; i < source.length(); i++) {
            if (source.byteAt(i) == '\n') {
                lines++;
            }
        }
        long[] starts = new long[lines];
        starts[0] = 0;
        long next = 1;
        for (long i = 0; i < source.length(); i++) {
            if (source.byteAt(i) == '\n') {
                starts[next] = i + 1;
                next++;
            }
        }
        this.lineStarts = starts;
    }

    lineCount() -> long {
        return this.lineStarts.length;
    }

    positionAt(long offset) -> LinePosition {
        long index = this.lineIndexOf(offset);
        LinePosition position;
        position.line = index + 1;
        position.column = offset - this.lineStarts[index] + 1;
        return position;
    }

    // Index of the greatest line start not past the offset.
    private lineIndexOf(long offset) -> long {
        long low = 0;
        long high = this.lineStarts.length - 1;
        while (low < high) {
            long middle = (low + high + 1) / 2;
            if (this.lineStarts[middle] <= offset) {
                low = middle;
            } else {
                high = middle - 1;
            }
        }
        return low;
    }
}
