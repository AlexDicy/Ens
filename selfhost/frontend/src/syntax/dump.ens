// Generated by syntaxgen from selfhost/syntax.grammar. Do not edit.
// Kind-agnostic printer for red trees: one element per line with its kind, span, and token text.
// Emitted verbatim, so it is stable across grammar changes.
import syntax.kind;
import GreenToken from syntax.green;
import GreenNode from syntax.green;
import NodeFactory from syntax.node;
import SyntaxNode from syntax.node;
import SyntaxNodeFactory from syntax.factory;
import StringBuilder from @std.text.stringbuilder;

public dumpTree(SyntaxNode root) -> string {
    let builder = new StringBuilder();
    writeNode(root, new SyntaxNodeFactory(), builder, 0);
    return builder.toString();
}

private writeNode(SyntaxNode node, NodeFactory factory, StringBuilder builder, long depth) {
    writeIndent(builder, depth);
    let span = node.span();
    builder.append(kind.kindName(node.kind()));
    builder.append(" [");
    builder.append(span.start);
    builder.append("..");
    builder.append(span.end());
    builder.append(")\n");
    let green = node.green();
    let fullSpan = node.fullSpan();
    long offset = fullSpan.start;
    for (long i = 0; i < green.slotCount(); i++) {
        let child = green.slot(i);
        if (child != null) {
            long width = child.fullLength();
            if (child is GreenToken) {
                writeToken(child, offset, builder, depth + 1);
            }
            if (child is GreenNode) {
                writeNode(factory.create(child, offset, node), factory, builder, depth + 1);
            }
            offset = offset + width;
        }
    }
}

private writeToken(GreenToken token, long offset, StringBuilder builder, long depth) {
    writeIndent(builder, depth);
    long start = offset + token.leadingLength();
    builder.append(kind.kindName(token.kind()));
    builder.append(" \"");
    builder.append(escapeText(token.text()));
    builder.append("\" [");
    builder.append(start);
    builder.append("..");
    builder.append(start + token.contentLength());
    builder.append(")\n");
}

private writeIndent(StringBuilder builder, long depth) {
    for (long i = 0; i < depth; i++) {
        builder.append("  ");
    }
}

private escapeText(string text) -> string {
    let builder = new StringBuilder();
    byte[] bytes = text.toBytes();
    for (long i = 0; i < bytes.length; i++) {
        byte value = bytes[i];
        switch (value) {
            '\n' -> builder.append("\\n"),
            '\r' -> builder.append("\\r"),
            '\t' -> builder.append("\\t"),
            '"' -> builder.append("\\\""),
            '\\' -> builder.append("\\\\"),
            default -> builder.appendByte(value),
        }
    }
    return builder.toString();
}
