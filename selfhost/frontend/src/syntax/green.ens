// The immutable green layer of the syntax tree: kinds, text, and widths, no absolute positions.
// Immutability is by convention: private fields, public accessors, everything computed at
// construction.
import SyntaxKind from syntax.generated.kind;
import StringBuilder from @std.text.stringbuilder;

public class GreenTrivia {
    SyntaxKind triviaKind;
    string triviaText;

    public constructor(SyntaxKind kind, string text) {
        this.triviaKind = kind;
        this.triviaText = text;
    }

    kind() -> SyntaxKind {
        return this.triviaKind;
    }

    protected text() -> string {
        return this.triviaText;
    }

    protected length() -> long {
        return this.triviaText.length;
    }
}

export sealed abstract class GreenElement {
    SyntaxKind elementKind;
    long elementFullLength;

    protected constructor(SyntaxKind kind, long fullLength) {
        this.elementKind = kind;
        this.elementFullLength = fullLength;
    }

    export kind() -> SyntaxKind {
        return this.elementKind;
    }

    // Total width in bytes, including the trivia attached to every token below.
    export fullLength() -> long {
        return this.elementFullLength;
    }

    protected abstract writeTo(StringBuilder builder);

    export fullText() -> string {
        let builder = new StringBuilder();
        this.writeTo(builder);
        return builder.toString();
    }
}

export class GreenToken extends GreenElement {
    string tokenText;
    GreenTrivia[] leading;
    GreenTrivia[] trailing;

    public constructor(SyntaxKind kind, string text, GreenTrivia[] leading, GreenTrivia[] trailing) {
        super(kind, triviaWidth(leading) + text.length + triviaWidth(trailing));
        this.tokenText = text;
        this.leading = leading;
        this.trailing = trailing;
    }

    export text() -> string {
        return this.tokenText;
    }

    export contentLength() -> long {
        return this.tokenText.length;
    }

    public leadingTrivia() -> GreenTrivia[] {
        return this.leading;
    }

    public trailingTrivia() -> GreenTrivia[] {
        return this.trailing;
    }

    export leadingLength() -> long {
        return triviaWidth(this.leading);
    }

    public trailingLength() -> long {
        return triviaWidth(this.trailing);
    }

    protected override writeTo(StringBuilder builder) {
        for (let trivia in this.leading) {
            builder.append(trivia.text());
        }
        builder.append(this.tokenText);
        for (let trivia in this.trailing) {
            builder.append(trivia.text());
        }
    }
}

export class GreenNode extends GreenElement {
    // One entry per structural slot; null marks an absent optional slot.
    GreenElement?[] slots;

    public constructor(SyntaxKind kind, GreenElement?[] slots) {
        super(kind, slotsWidth(slots));
        this.slots = slots;
    }

    export slotCount() -> long {
        return this.slots.length;
    }

    export slot(long index) -> GreenElement? {
        return this.slots[index];
    }

    protected override writeTo(StringBuilder builder) {
        for (let child in this.slots) {
            if (child != null) {
                child.writeTo(builder);
            }
        }
    }
}

triviaWidth(GreenTrivia[] list) -> long {
    long total = 0;
    for (let trivia in list) {
        total = total + trivia.length();
    }
    return total;
}

slotsWidth(GreenElement?[] slots) -> long {
    long total = 0;
    for (let child in slots) {
        if (child != null) {
            total = total + child.fullLength();
        }
    }
    return total;
}
