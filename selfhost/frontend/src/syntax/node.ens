// The red layer base, holding position-aware parent-linked views over green elements that are
// created on demand and thrown away freely. Generated node classes extend SyntaxNode and read
// their slots through the protected helpers.
import SyntaxKind from syntax.generated.kind;
import GreenTrivia from syntax.green;
import GreenToken from syntax.green;
import GreenNode from syntax.green;
import Span from support.source;
import support.source;
import List from @std.collections.list;

export class SyntaxToken {
    GreenToken greenToken;
    long fullStart;
    SyntaxNode? parentNode;

    protected constructor(GreenToken green, long fullStart, SyntaxNode? parent) {
        this.greenToken = green;
        this.fullStart = fullStart;
        this.parentNode = parent;
    }

    export kind() -> SyntaxKind {
        return this.greenToken.kind();
    }

    export text() -> string {
        return this.greenToken.text();
    }

    green() -> GreenToken {
        return this.greenToken;
    }

    public parent() -> SyntaxNode? {
        return this.parentNode;
    }

    public leadingTrivia() -> GreenTrivia[] {
        return this.greenToken.leadingTrivia();
    }

    trailingTrivia() -> GreenTrivia[] {
        return this.greenToken.trailingTrivia();
    }

    // The token text alone, trivia excluded.
    export span() -> Span {
        return source.makeSpan(this.fullStart + this.greenToken.leadingLength(),
                               this.greenToken.contentLength());
    }

    // The token together with all its trivia.
    public fullSpan() -> Span {
        return source.makeSpan(this.fullStart, this.greenToken.fullLength());
    }
}

// Implemented by the generated factory, so this base layer never names the generated classes.
export interface NodeFactory {
    create(GreenNode green, long fullStart, SyntaxNode? parent) -> SyntaxNode;
}

export abstract class SyntaxNode {
    GreenNode greenNode;
    long fullStart;
    SyntaxNode? parentNode;
    NodeFactory factory;

    public constructor(GreenNode green, long fullStart, SyntaxNode? parent, NodeFactory factory) {
        this.greenNode = green;
        this.fullStart = fullStart;
        this.parentNode = parent;
        this.factory = factory;
    }

    public kind() -> SyntaxKind {
        return this.greenNode.kind();
    }

    export green() -> GreenNode {
        return this.greenNode;
    }

    public parent() -> SyntaxNode? {
        return this.parentNode;
    }

    public fullText() -> string {
        return this.greenNode.fullText();
    }

    export fullSpan() -> Span {
        return source.makeSpan(this.fullStart, this.greenNode.fullLength());
    }

    // From the first token's content start to the last token's content end; a node with no tokens
    // collapses to a zero-length span at its full start.
    export span() -> Span {
        let first = this.firstToken();
        if (first == null) {
            return source.makeSpan(this.fullStart, 0);
        }
        let last = this.lastToken();
        if (last == null) {
            return source.makeSpan(this.fullStart, 0);
        }
        let firstSpan = first.span();
        let lastSpan = last.span();
        return source.makeSpan(firstSpan.start, lastSpan.end() - firstSpan.start);
    }

    public firstToken() -> SyntaxToken? {
        long offset = this.fullStart;
        for (long i = 0; i < this.greenNode.slotCount(); i++) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                long width = child.fullLength();
                if (child is GreenToken) {
                    return new SyntaxToken(child, offset, this);
                }
                if (child is GreenNode) {
                    let token = this.factory.create(child, offset, this).firstToken();
                    if (token != null) {
                        return token;
                    }
                }
                offset = offset + width;
            }
        }
        return null;
    }

    public lastToken() -> SyntaxToken? {
        long offset = this.fullStart + this.greenNode.fullLength();
        for (long i = this.greenNode.slotCount() - 1; i >= 0; i--) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                offset = offset - child.fullLength();
                if (child is GreenToken) {
                    return new SyntaxToken(child, offset, this);
                }
                if (child is GreenNode) {
                    let token = this.factory.create(child, offset, this).lastToken();
                    if (token != null) {
                        return token;
                    }
                }
            }
        }
        return null;
    }

    // The direct child nodes, tokens skipped, each red child reconstructed on demand.
    export childNodes() -> List<SyntaxNode> {
        let result = new List<SyntaxNode>();
        long offset = this.fullStart;
        for (long i = 0; i < this.greenNode.slotCount(); i++) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                if (child is GreenNode) {
                    result.push(this.factory.create(child, offset, this));
                }
                offset = offset + child.fullLength();
            }
        }
        return result;
    }

    protected slotCount() -> long {
        return this.greenNode.slotCount();
    }

    protected tokenAt(long slotIndex) -> SyntaxToken {
        let token = this.tokenAtOrNull(slotIndex);
        if (token != null) {
            return token;
        }
        panic("Internal: slot {slotIndex} of a {this.kind()} node does not hold a token");
    }

    protected tokenAtOrNull(long slotIndex) -> SyntaxToken? {
        let child = this.greenNode.slot(slotIndex);
        if (child == null) {
            return null;
        }
        if (child is GreenToken) {
            return new SyntaxToken(child, this.slotStart(slotIndex), this);
        }
        return null;
    }

    protected nodeAt(long slotIndex) -> SyntaxNode {
        let node = this.nodeAtOrNull(slotIndex);
        if (node != null) {
            return node;
        }
        panic("Internal: slot {slotIndex} of a {this.kind()} node does not hold a node");
    }

    protected nodeAtOrNull(long slotIndex) -> SyntaxNode? {
        let child = this.greenNode.slot(slotIndex);
        if (child == null) {
            return null;
        }
        if (child is GreenNode) {
            return this.factory.create(child, this.slotStart(slotIndex), this);
        }
        return null;
    }

    slotStart(long slotIndex) -> long {
        long offset = this.fullStart;
        for (long i = 0; i < slotIndex; i++) {
            let child = this.greenNode.slot(i);
            if (child != null) {
                offset = offset + child.fullLength();
            }
        }
        return offset;
    }
}
