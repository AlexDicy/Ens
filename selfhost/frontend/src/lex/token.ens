// The lexer speaks in spans, never copied text. A piece is (kind, offset, length) over the source
// bytes; the actual characters are recovered from the source on demand through a LineIndex or
// substring. Both records are fully defaulted so they can back a List and be sliced into
// fixed-size arrays.
import SyntaxKind from syntax.generated.kind;
import Span from support.source;
import support.source;

// One piece of the flat lexed stream: a significant token or a trivia piece, distinguished by kind.
// isTrivia(piece.kind) tells the two apart.
public struct RawToken {
    SyntaxKind kind = SyntaxKind.Invalid;
    long offset;
    long length;

    end() -> long {
        return this.offset + this.length;
    }

    span() -> Span {
        return source.makeSpan(this.offset, this.length);
    }
}

// A significant token with its attached trivia. Leading trivia precedes the token; trailing trivia
// runs to the end of the token's own line. The offset and length cover the token content alone,
// excluding the trivia.
public struct LexedToken {
    SyntaxKind kind = SyntaxKind.EndOfFile;
    long offset;
    long length;

    RawToken[] leading = [];
    RawToken[] trailing = [];

    end() -> long {
        return this.offset + this.length;
    }

    span() -> Span {
        return source.makeSpan(this.offset, this.length);
    }
}
