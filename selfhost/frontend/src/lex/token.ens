// The lexer speaks in spans, never copied text. Characters are recovered from the source on demand.
// Both records are fully defaulted so they can back a List and be sliced into fixed-size arrays.
import SyntaxKind from syntax.generated.kind;
import Span from support.source;
import support.source;

// One piece of the flat lexed stream; isTrivia(kind) tells a significant token from a trivia piece.
public struct RawToken {
    public SyntaxKind kind = SyntaxKind.Invalid;
    public long offset;
    public long length;

    public end() -> long {
        return this.offset + this.length;
    }

    span() -> Span {
        return source.makeSpan(this.offset, this.length);
    }
}

// Leading trivia precedes the token, and trailing trivia runs to the end of the token's own line.
// The offset and length cover the token content alone, excluding the trivia.
public struct LexedToken {
    public SyntaxKind kind = SyntaxKind.EndOfFile;
    public long offset;
    public long length;

    public RawToken[] leading = [];
    public RawToken[] trailing = [];

    public end() -> long {
        return this.offset + this.length;
    }

    span() -> Span {
        return source.makeSpan(this.offset, this.length);
    }
}
