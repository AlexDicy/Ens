// A pure per-file function over UTF-8 bytes, giving back the flat piece stream, the
// significant-token stream with attached trivia, and the diagnostics found along the way. Each
// call owns its output, with no shared state, no sink passed in, and no cache that outlives it.
import Source from support.source;
import support.source;
import SyntaxKind from syntax.generated.kind;
import syntax.generated.kind;
import Diagnostic from support.diagnostics;
import RawToken from lex.token;
import LexedToken from lex.token;
import List from @std.collections.list;

// The flat piece stream tiles the file exactly, so concatenating the pieces in order reproduces
// every source byte once.
public class LexResult {
    RawToken[] rawPieces;
    LexedToken[] significantTokens;
    Diagnostic[] lexDiagnostics;

    protected constructor(RawToken[] pieces, LexedToken[] tokens, Diagnostic[] diagnostics) {
        this.rawPieces = pieces;
        this.significantTokens = tokens;
        this.lexDiagnostics = diagnostics;
    }

    // Every token and every trivia piece, ending with EndOfFile.
    public pieces() -> RawToken[] {
        return this.rawPieces;
    }

    // Significant tokens, each carrying its leading and trailing trivia, ending with EndOfFile.
    public tokens() -> LexedToken[] {
        return this.significantTokens;
    }

    public diagnostics() -> Diagnostic[] {
        return this.lexDiagnostics;
    }
}

public lex(Source input) -> LexResult {
    let lexer = new Lexer(input);
    lexer.scanAll();
    let pieces = lexer.collectedPieces();
    let diagnostics = lexer.collectedDiagnostics();
    let tokens = attachTrivia(pieces);
    return new LexResult(pieces, tokens, diagnostics);
}

class Lexer {
    Source lexerSource;
    string sourceText;
    long sourceLength;
    long position;

    List<RawToken> pieces;
    List<Diagnostic> diagnostics;

    // A stack of per-hole brace depths, so nested braces and nested interpolated strings inside a
    // hole lex correctly. holeDepthCount is the logical size, so the backing list never pops.
    List<long> holeDepthStack;
    long holeDepthCount;

    protected constructor(Source input) {
        this.lexerSource = input;
        this.sourceText = input.text();
        this.sourceLength = input.length();
        this.position = 0;
        this.pieces = new List<RawToken>();
        this.diagnostics = new List<Diagnostic>();
        this.holeDepthStack = new List<long>();
        this.holeDepthCount = 0;
    }

    protected scanAll() {
        this.scanByteOrderMark();
        while (!this.atEnd()) {
            this.scanPiece();
        }
        this.emit(SyntaxKind.EndOfFile, this.position);
    }

    // A byte order mark at the very start of the file is whitespace trivia, so the piece stream
    // still tiles every byte. The same bytes further in take the invalid path instead.
    scanByteOrderMark() {
        if (this.peek(0) != 0xEF || this.peek(1) != 0xBB || this.peek(2) != 0xBF) {
            return;
        }
        this.advance();
        this.advance();
        this.advance();
        this.emit(SyntaxKind.Whitespace, 0);
    }

    protected collectedPieces() -> RawToken[] {
        return this.pieces.toArray();
    }

    protected collectedDiagnostics() -> Diagnostic[] {
        return this.diagnostics.toArray();
    }

    atEnd() -> bool {
        return this.position >= this.sourceLength;
    }

    // The byte at position + offset, or 0 past the end. 0 is a safe sentinel because callers guard
    // real work with atEnd, and a NUL byte in the source begins no token form either.
    peek(long offset) -> byte {
        let index = this.position + offset;
        if (index < this.sourceLength) {
            return this.lexerSource.byteAt(index);
        }
        return 0;
    }

    advance() {
        if (this.position < this.sourceLength) {
            this.position++;
        }
    }

    emit(SyntaxKind pieceKind, long startPosition) {
        RawToken piece = {
            kind: pieceKind,
            offset: startPosition,
            length: this.position - startPosition,
        };
        this.pieces.push(piece);
    }

    report(string message, long startPosition, long endPosition) {
        let span = source.makeSpan(startPosition, endPosition - startPosition);
        this.diagnostics.push(new Diagnostic(message, span));
    }

    holeStackEmpty() -> bool {
        return this.holeDepthCount == 0;
    }

    holeTop() -> long {
        return this.holeDepthStack.get(this.holeDepthCount - 1);
    }

    setHoleTop(long value) {
        this.holeDepthStack.set(this.holeDepthCount - 1, value);
    }

    pushHole(long value) {
        if (this.holeDepthCount == this.holeDepthStack.length()) {
            this.holeDepthStack.push(value);
        } else {
            this.holeDepthStack.set(this.holeDepthCount, value);
        }
        this.holeDepthCount++;
    }

    popHole() {
        this.holeDepthCount--;
    }

    scanPiece() {
        let startPosition = this.position;
        let c = this.peek(0);

        // Inside an interpolation hole a `}` at brace depth 0 closes the hole and resumes string
        // lexing; deeper `{`/`}` are ordinary braces whose nesting is tracked to tell them apart.
        if (!this.holeStackEmpty()) {
            let depth = this.holeTop();
            if (c == '}' && depth == 0) {
                this.advance();
                this.lexStringBody(startPosition, false);
                return;
            }
            if (c == '{') {
                this.setHoleTop(depth + 1);
            } else if (c == '}') {
                this.setHoleTop(depth - 1);
            }
        }

        if (c == ' ' || c == '\t' || c == '\f' || c == 0x0B) {
            this.lexWhitespace(startPosition);
            return;
        }
        if (c == '\n' || c == '\r') {
            this.lexNewline(startPosition);
            return;
        }
        if (c == '/') {
            let following = this.peek(1);
            if (following == '/') {
                this.lexLineComment(startPosition);
                return;
            }
            if (following == '*') {
                this.lexBlockComment(startPosition);
                return;
            }
            this.lexOperator(startPosition);
            return;
        }
        if (isDigit(c)) {
            this.lexNumber(startPosition);
            return;
        }
        if (isIdentifierStart(c)) {
            this.lexIdentifierOrKeyword(startPosition);
            return;
        }
        if (c == '"') {
            this.lexString(startPosition);
            return;
        }
        if (c == '\'') {
            this.lexCharacter(startPosition);
            return;
        }
        this.lexOperator(startPosition);
    }

    lexWhitespace(long startPosition) {
        while (!this.atEnd()) {
            let c = this.peek(0);
            if (c == ' ' || c == '\t' || c == '\f' || c == 0x0B) {
                this.advance();
            } else {
                break;
            }
        }
        this.emit(SyntaxKind.Whitespace, startPosition);
    }

    // One line terminator per piece; "\r\n" counts as a single Newline.
    lexNewline(long startPosition) {
        let c = this.peek(0);
        this.advance();
        if (c == '\r' && this.peek(0) == '\n') {
            this.advance();
        }
        this.emit(SyntaxKind.Newline, startPosition);
    }

    // The terminating newline is left for a separate Newline piece.
    lexLineComment(long startPosition) {
        this.advance();
        this.advance();
        while (!this.atEnd()) {
            let c = this.peek(0);
            if (c == '\n' || c == '\r') {
                break;
            }
            this.advance();
        }
        this.emit(SyntaxKind.LineComment, startPosition);
    }

    // Block comments do not nest: the first `*/` closes.
    lexBlockComment(long startPosition) {
        this.advance();
        this.advance();
        bool closed = false;
        while (!this.atEnd()) {
            let c = this.peek(0);
            if (c == '*' && this.peek(1) == '/') {
                this.advance();
                this.advance();
                closed = true;
                break;
            }
            this.advance();
        }
        if (!closed) {
            this.report("Unterminated block comment: close it with '*/' before the end of the file", startPosition, this.position);
        }
        this.emit(SyntaxKind.BlockComment, startPosition);
    }

    lexIdentifierOrKeyword(long startPosition) {
        while (!this.atEnd() && isIdentifierContinue(this.peek(0))) {
            this.advance();
        }
        let text = this.sourceText.substring(startPosition, this.position);
        let keyword = kind.keywordFromText(text);
        if (keyword == null) {
            this.emit(SyntaxKind.Identifier, startPosition);
        } else {
            this.emit(keyword, startPosition);
        }
    }

    // Decimal, hex, and binary literals with underscores and an optional suffix. The suffix and the
    // presence of a fraction or exponent pick the literal kind.
    lexNumber(long startPosition) {
        bool isFloat = false;
        bool isLong = false;
        bool isFloatSuffix = false;

        if (this.peek(0) == '0' && (this.peek(1) == 'x' || this.peek(1) == 'X')) {
            this.advance();
            this.advance();
            bool anyDigit = false;
            while (!this.atEnd() && (isHexDigit(this.peek(0)) || this.peek(0) == '_')) {
                anyDigit = true;
                this.advance();
            }
            if (!anyDigit) {
                this.report("A hexadecimal number needs at least one digit after '0x', for example '0x1F'", startPosition, this.position);
            }
        } else if (this.peek(0) == '0' && (this.peek(1) == 'b' || this.peek(1) == 'B')) {
            this.advance();
            this.advance();
            bool anyDigit = false;
            while (!this.atEnd() && (this.peek(0) == '0' || this.peek(0) == '1' || this.peek(0) == '_')) {
                anyDigit = true;
                this.advance();
            }
            if (!anyDigit) {
                this.report("A binary number needs at least one digit after '0b', for example '0b1010'", startPosition, this.position);
            }
        } else {
            while (!this.atEnd() && (isDigit(this.peek(0)) || this.peek(0) == '_')) {
                this.advance();
            }
            if (this.peek(0) == '.' && isDigit(this.peek(1))) {
                isFloat = true;
                this.advance();
                while (!this.atEnd() && (isDigit(this.peek(0)) || this.peek(0) == '_')) {
                    this.advance();
                }
            }
            if (this.peek(0) == 'e' || this.peek(0) == 'E') {
                isFloat = true;
                this.advance();
                if (this.peek(0) == '+' || this.peek(0) == '-') {
                    this.advance();
                }
                while (!this.atEnd() && isDigit(this.peek(0))) {
                    this.advance();
                }
            }
        }

        if (this.peek(0) == 'f' || this.peek(0) == 'F') {
            isFloat = true;
            isFloatSuffix = true;
            this.advance();
        } else if (this.peek(0) == 'd' || this.peek(0) == 'D') {
            isFloat = true;
            this.advance();
        } else if (this.peek(0) == 'l' || this.peek(0) == 'L') {
            isLong = true;
            this.advance();
        }

        if (isFloatSuffix) {
            this.emit(SyntaxKind.FloatLiteral, startPosition);
        } else if (isFloat) {
            this.emit(SyntaxKind.DoubleLiteral, startPosition);
        } else if (isLong) {
            this.emit(SyntaxKind.LongLiteral, startPosition);
        } else {
            this.emit(SyntaxKind.IntLiteral, startPosition);
        }
    }

    lexString(long startPosition) {
        this.advance();
        this.lexStringBody(startPosition, true);
    }

    // atStart marks the opening `"...`, and otherwise this resumes after a hole's `}`. The result
    // is a plain StringLiteral, or InterpolatedString Start, Middle, or End around holes.
    lexStringBody(long startPosition, bool atStart) {
        bool closed = false;
        bool hole = false;
        while (!this.atEnd()) {
            let c = this.peek(0);
            if (c == '"') {
                this.advance();
                closed = true;
                break;
            }
            if (c == '{') {
                this.advance();
                hole = true;
                break;
            }
            if (c == '\n' || c == '\r') {
                break;
            }
            if (c == '\\') {
                this.consumeEscape();
                continue;
            }
            this.advance();
        }
        if (!closed && !hole) {
            this.report("Unterminated string literal: add a closing '\"' before the end of the line", startPosition, this.position);
        }
        if (atStart && !hole) {
            this.emit(SyntaxKind.StringLiteral, startPosition);
            return;
        }
        if (atStart) {
            this.pushHole(0);
            this.emit(SyntaxKind.InterpolatedStringStart, startPosition);
            return;
        }
        if (hole) {
            this.emit(SyntaxKind.InterpolatedStringMiddle, startPosition);
            return;
        }
        if (!this.holeStackEmpty()) {
            this.popHole();
        }
        this.emit(SyntaxKind.InterpolatedStringEnd, startPosition);
    }

    lexCharacter(long startPosition) {
        this.advance();
        bool closed = false;
        while (!this.atEnd()) {
            let c = this.peek(0);
            if (c == '\'') {
                this.advance();
                closed = true;
                break;
            }
            if (c == '\n' || c == '\r') {
                break;
            }
            if (c == '\\') {
                this.consumeEscape();
                continue;
            }
            this.advance();
        }
        if (!closed) {
            this.report("Unterminated character literal: add a closing ' after the character, for example 'a'", startPosition, this.position);
        }
        this.emit(SyntaxKind.CharLiteral, startPosition);
    }

    // A valid \uXXXX consumes its four hex digits too. The token span is the same either way,
    // since those bytes are string content regardless.
    consumeEscape() {
        let escapeStart = this.position;
        this.advance();
        if (this.atEnd()) {
            return;
        }
        let escaped = this.peek(0);
        if (isSimpleEscape(escaped)) {
            this.advance();
            return;
        }
        if (escaped == 'u') {
            this.advance();
            if (isHexDigit(this.peek(0)) && isHexDigit(this.peek(1))
                && isHexDigit(this.peek(2)) && isHexDigit(this.peek(3))) {
                this.advance();
                this.advance();
                this.advance();
                this.advance();
                return;
            }
            let sequence = this.sourceText.substring(escapeStart, this.position);
            this.report("Invalid Unicode escape sequence '{sequence}': write four hex digits, for example \\u00E9", escapeStart, this.position);
            return;
        }
        this.advance();
        let sequence = this.sourceText.substring(escapeStart, this.position);
        this.report("Invalid escape sequence '{sequence}': valid escapes include \\n, \\t, and \\\\", escapeStart, this.position);
    }

    // Maximal-munch operators from the grammar's token list, with one deliberate exception. `??`
    // is not merged, so a type can stack its `?` suffixes and the parser joins the pair where an
    // operator is what was meant. `?[` stays Question then OpenBracket for the same reason.
    lexOperator(long startPosition) {
        let c0 = this.peek(0);
        let c1 = this.peek(1);
        let c2 = this.peek(2);
        let c3 = this.peek(3);
        switch (c0) {
            '>' -> {
                if (c1 == '>' && c2 == '>' && c3 == '=') {
                    this.consumeOperator(4, SyntaxKind.GreaterGreaterGreaterEquals, startPosition);
                } else if (c1 == '>' && c2 == '>') {
                    this.consumeOperator(3, SyntaxKind.GreaterGreaterGreater, startPosition);
                } else if (c1 == '>' && c2 == '=') {
                    this.consumeOperator(3, SyntaxKind.GreaterGreaterEquals, startPosition);
                } else if (c1 == '>') {
                    this.consumeOperator(2, SyntaxKind.GreaterGreater, startPosition);
                } else if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.GreaterEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Greater, startPosition);
                }
            },
            '<' -> {
                if (c1 == '<' && c2 == '=') {
                    this.consumeOperator(3, SyntaxKind.LessLessEquals, startPosition);
                } else if (c1 == '<') {
                    this.consumeOperator(2, SyntaxKind.LessLess, startPosition);
                } else if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.LessEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Less, startPosition);
                }
            },
            '.' -> {
                if (c1 == '.' && c2 == '.') {
                    this.consumeOperator(3, SyntaxKind.Ellipsis, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Dot, startPosition);
                }
            },
            '=' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.EqualsEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Equals, startPosition);
                }
            },
            '!' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.NotEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Exclamation, startPosition);
                }
            },
            '-' -> {
                switch (c1) {
                    '>' -> this.consumeOperator(2, SyntaxKind.Arrow, startPosition),
                    '-' -> this.consumeOperator(2, SyntaxKind.MinusMinus, startPosition),
                    '=' -> this.consumeOperator(2, SyntaxKind.MinusEquals, startPosition),
                    default -> this.consumeOperator(1, SyntaxKind.Minus, startPosition),
                }
            },
            '&' -> {
                switch (c1) {
                    '&' -> this.consumeOperator(2, SyntaxKind.AmpersandAmpersand, startPosition),
                    '=' -> this.consumeOperator(2, SyntaxKind.AmpersandEquals, startPosition),
                    default -> this.consumeOperator(1, SyntaxKind.Ampersand, startPosition),
                }
            },
            '|' -> {
                switch (c1) {
                    '|' -> this.consumeOperator(2, SyntaxKind.PipePipe, startPosition),
                    '=' -> this.consumeOperator(2, SyntaxKind.PipeEquals, startPosition),
                    default -> this.consumeOperator(1, SyntaxKind.Pipe, startPosition),
                }
            },
            '+' -> {
                switch (c1) {
                    '+' -> this.consumeOperator(2, SyntaxKind.PlusPlus, startPosition),
                    '=' -> this.consumeOperator(2, SyntaxKind.PlusEquals, startPosition),
                    default -> this.consumeOperator(1, SyntaxKind.Plus, startPosition),
                }
            },
            '*' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.StarEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Star, startPosition);
                }
            },
            '/' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.SlashEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Slash, startPosition);
                }
            },
            '%' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.PercentEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Percent, startPosition);
                }
            },
            '^' -> {
                if (c1 == '=') {
                    this.consumeOperator(2, SyntaxKind.CaretEquals, startPosition);
                } else {
                    this.consumeOperator(1, SyntaxKind.Caret, startPosition);
                }
            },
            '?' -> {
                switch (c1) {
                    '.' -> this.consumeOperator(2, SyntaxKind.QuestionDot, startPosition),
                    default -> this.consumeOperator(1, SyntaxKind.Question, startPosition),
                }
            },
            default -> {
                let single = singleCharacterKind(c0);
                if (single != null) {
                    this.consumeOperator(1, single, startPosition);
                } else {
                    this.lexInvalidCharacter(startPosition, c0);
                }
            },
        }
    }

    consumeOperator(long count, SyntaxKind operatorKind, long startPosition) {
        for (long i = 0; i < count; i++) {
            this.advance();
        }
        this.emit(operatorKind, startPosition);
    }

    // The Invalid token spans the whole offending character, a full UTF-8 codepoint when the lead
    // byte is one. Lexing carries on so one bad byte does not derail the rest.
    lexInvalidCharacter(long startPosition, byte lead) {
        this.advance();
        let trailing = utf8SequenceLength(lead) - 1;
        long consumed = 0;
        while (consumed < trailing && !this.atEnd() && isContinuationByte(this.peek(0))) {
            this.advance();
            consumed++;
        }
        let sequence = this.sourceText.substring(startPosition, this.position);
        this.report("Unexpected character '{sequence}': this character is not allowed here", startPosition, this.position);
        this.emit(SyntaxKind.Invalid, startPosition);
    }
}

// A token's trailing trivia runs from just after it up to and including the first newline or the
// end of file, and the rest becomes the next token's leading. The EndOfFile token, always last,
// owns the file's remaining tail as leading.
attachTrivia(RawToken[] pieces) -> LexedToken[] {
    let tokens = new List<LexedToken>();
    let count = pieces.length;
    long index = 0;
    while (index < count) {
        let leadingStart = index;
        while (index < count && kind.isTrivia(pieces[index].kind)) {
            index++;
        }
        let tokenIndex = index;
        let tokenPiece = pieces[index];
        index++;
        let trailingStart = index;
        while (index < count && kind.isTrivia(pieces[index].kind)) {
            let triviaKind = pieces[index].kind;
            index++;
            if (triviaKind == SyntaxKind.Newline) {
                break;
            }
        }
        LexedToken lexed = {
            kind: tokenPiece.kind,
            offset: tokenPiece.offset,
            length: tokenPiece.length,
            leading: sliceRawTokens(pieces, leadingStart, tokenIndex),
            trailing: sliceRawTokens(pieces, trailingStart, index),
        };
        tokens.push(lexed);
        if (tokenPiece.kind == SyntaxKind.EndOfFile) {
            break;
        }
    }
    return tokens.toArray();
}

sliceRawTokens(RawToken[] pieces, long startIndex, long endIndex) -> RawToken[] {
    RawToken[] result = new RawToken[endIndex - startIndex];
    for (long i = 0; i < result.length; i++) {
        result[i] = pieces[startIndex + i];
    }
    return result;
}

isAsciiLetter(byte c) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

isDigit(byte c) -> bool {
    return c >= '0' && c <= '9';
}

isHexDigit(byte c) -> bool {
    return isDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

isIdentifierStart(byte c) -> bool {
    return isAsciiLetter(c) || c == '_' || c == '$';
}

isIdentifierContinue(byte c) -> bool {
    return isIdentifierStart(c) || isDigit(c);
}

isSimpleEscape(byte c) -> bool {
    return c == '\\' || c == '"' || c == '\'' || c == 'n' || c == 'r'
        || c == 't' || c == 'b' || c == 'f' || c == '0' || c == '{' || c == '}';
}

isContinuationByte(byte c) -> bool {
    return c >= 0x80 && c <= 0xBF;
}

// Byte length of a UTF-8 codepoint from its lead byte; 1 for ASCII or a byte that is not a valid
// lead, so a stray byte spans just itself.
utf8SequenceLength(byte lead) -> long {
    if (lead < 0x80) {
        return 1;
    }
    if (lead >= 0xF0 && lead <= 0xF7) {
        return 4;
    }
    if (lead >= 0xE0 && lead <= 0xEF) {
        return 3;
    }
    if (lead >= 0xC0 && lead <= 0xDF) {
        return 2;
    }
    return 1;
}

singleCharacterKind(byte c) -> SyntaxKind? {
    return switch (c) {
        '(' -> SyntaxKind.OpenParenthesis,
        ')' -> SyntaxKind.CloseParenthesis,
        '{' -> SyntaxKind.OpenBrace,
        '}' -> SyntaxKind.CloseBrace,
        '[' -> SyntaxKind.OpenBracket,
        ']' -> SyntaxKind.CloseBracket,
        ';' -> SyntaxKind.Semicolon,
        ',' -> SyntaxKind.Comma,
        '.' -> SyntaxKind.Dot,
        ':' -> SyntaxKind.Colon,
        '+' -> SyntaxKind.Plus,
        '-' -> SyntaxKind.Minus,
        '*' -> SyntaxKind.Star,
        '/' -> SyntaxKind.Slash,
        '%' -> SyntaxKind.Percent,
        '^' -> SyntaxKind.Caret,
        '=' -> SyntaxKind.Equals,
        '!' -> SyntaxKind.Exclamation,
        '~' -> SyntaxKind.Tilde,
        '?' -> SyntaxKind.Question,
        '<' -> SyntaxKind.Less,
        '>' -> SyntaxKind.Greater,
        '&' -> SyntaxKind.Ampersand,
        '|' -> SyntaxKind.Pipe,
        '@' -> SyntaxKind.At,
        default -> null,
    };
}
