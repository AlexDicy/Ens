// A growable list a speculation can roll back: truncate drops everything appended since a mark. The
// backing storage only grows, so the appends after a rewind reuse the slots the abandoned attempt
// wrote and no allocation is repeated; count is the logical length.
//
// The parser keeps one of these for each thing a failed speculation has to forget - its events, its
// diagnostics, the tokens it had to invent - and a mark records one count for each.
import List from @std.collections.list;

public class RewindableList<T> {
    List<T> backing;
    long logicalCount;

    public constructor() {
        this.backing = new List<T>();
        this.logicalCount = 0;
    }

    public count() -> long {
        return this.logicalCount;
    }

    public get(long index) -> T {
        return this.backing.get(index);
    }

    public set(long index, T value) {
        this.backing.set(index, value);
    }

    // Appends the value and answers with the index it landed at, which is what a caller recording a
    // position in the list keeps.
    public push(T value) -> long {
        if (this.logicalCount == this.backing.length()) {
            this.backing.push(value);
        } else {
            this.backing.set(this.logicalCount, value);
        }
        this.logicalCount++;
        return this.logicalCount - 1;
    }

    public truncate(long newCount) {
        this.logicalCount = newCount;
    }

    public toArray() -> T[] {
        T[] result = new T[this.logicalCount];
        for (long i = 0; i < result.length; i++) {
            result[i] = this.backing.get(i);
        }
        return result;
    }
}
