// The grammar of manifest files, their package, workspace and overrides declarations.
import SyntaxKind from syntax.generated.kind;
import Parser from parse.parser;

// One declaration of a manifest file, which is a package, a workspace or an overrides block, or an
// error node over tokens that begin none of them.
public parseManifestDeclaration(Parser parser) {
    if (parser.at(SyntaxKind.PackageKeyword)) {
        parsePackageDeclaration(parser);
        return;
    }
    if (parser.atContextual("workspace")) {
        parseWorkspaceDeclaration(parser);
        return;
    }
    if (parser.atContextual("overrides")) {
        parseOverridesDeclaration(parser);
        return;
    }
    parseManifestDeclarationError(parser);
}

atManifestDeclarationStart(Parser parser) -> bool {
    return parser.at(SyntaxKind.PackageKeyword) || parser.atContextual("workspace")
        || parser.atContextual("overrides");
}

parsePackageDeclaration(Parser parser) {
    let marker = parser.start();
    parser.bump();
    parsePackagePath(parser, "Expected the package's name after 'package'. For example, write "
        + "'package acme.tools \{ ... \}'.");
    parser.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the package declaration.");
    let items = parser.start();
    while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
        parsePackageItem(parser);
    }
    parser.complete(items, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the package declaration.");
    parser.complete(marker, SyntaxKind.PackageDeclaration);
}

parseWorkspaceDeclaration(Parser parser) {
    let marker = parser.start();
    parser.bumpAs(SyntaxKind.WorkspaceKeyword);
    parser.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the workspace declaration.");
    let items = parser.start();
    while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
        parseWorkspaceItem(parser);
    }
    parser.complete(items, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the workspace declaration.");
    parser.complete(marker, SyntaxKind.WorkspaceDeclaration);
}

parseOverridesDeclaration(Parser parser) {
    let marker = parser.start();
    parser.bumpAs(SyntaxKind.OverridesKeyword);
    parser.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the overrides declaration.");
    let items = parser.start();
    while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
        parseOverridesItem(parser);
    }
    parser.complete(items, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the overrides declaration.");
    parser.complete(marker, SyntaxKind.OverridesDeclaration);
}

parsePackagePath(Parser parser, string missingMessage) {
    let marker = parser.start();
    let segments = parser.start();
    parser.expect(SyntaxKind.Identifier, missingMessage);
    while (parser.at(SyntaxKind.Dot) && parser.peekKind(1) == SyntaxKind.Identifier) {
        parser.bump();
        parser.bump();
    }
    parser.complete(segments, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.PackagePath);
}

parsePackageItem(Parser parser) {
    if (parser.atContextual("version")) {
        parseManifestValueItem(parser, SyntaxKind.VersionKeyword, SyntaxKind.VersionDeclaration,
            "Expected the package's version in quotes. For example, write 'version \"1.3.0\";'.",
            "Expected ';' after the version declaration.");
        return;
    }
    if (parser.atContextual("ens")) {
        parseManifestValueItem(parser, SyntaxKind.EnsKeyword, SyntaxKind.EnsDeclaration,
            "Expected the version of Ens the package is written for, in quotes. For example, "
            + "write 'ens \"1.2\";'.",
            "Expected ';' after the 'ens' declaration.");
        return;
    }
    if (parser.atContextual("dependency")) {
        parseDependencyDeclaration(parser);
        return;
    }
    if (parser.atContextual("native")) {
        parseNativeDeclaration(parser);
        return;
    }
    parseManifestItemError(parser, SyntaxKind.ErrorPackageItem, "Expected a 'version', 'ens', "
        + "'dependency' or 'native' line inside the package declaration.");
}

parseManifestValueItem(Parser parser, SyntaxKind keywordKind, SyntaxKind nodeKind,
                       string valueMessage, string semicolonMessage) {
    let marker = parser.start();
    parser.bumpAs(keywordKind);
    parser.expect(SyntaxKind.StringLiteral, valueMessage);
    parser.expect(SyntaxKind.Semicolon, semicolonMessage);
    parser.complete(marker, nodeKind);
}

parseDependencyDeclaration(Parser parser) {
    let marker = parser.start();
    parser.bumpAs(SyntaxKind.DependencyKeyword);
    parsePackagePath(parser, "Expected the name of the package to depend on. For example, write "
        + "'dependency acme.json;'.");
    if (parser.at(SyntaxKind.StringLiteral)) {
        parser.bump();
    } else {
        parser.nullSlot();
    }
    if (parser.atContextual("from")) {
        let source = parser.start();
        parser.bumpAs(SyntaxKind.FromKeyword);
        parser.expect(SyntaxKind.StringLiteral, "Expected the package's git URL in quotes after "
            + "'from'. For example, write 'dependency acme.json \"2.0\" from "
            + "\"https://github.com/acme/json.git\";'.");
        parser.complete(source, SyntaxKind.FromClause);
    } else {
        parser.nullSlot();
    }
    parser.expect(SyntaxKind.Semicolon, "Expected ';' after the dependency declaration.");
    parser.complete(marker, SyntaxKind.DependencyDeclaration);
}

parseNativeDeclaration(Parser parser) {
    let marker = parser.start();
    parser.bumpAs(SyntaxKind.NativeKeyword);
    parser.expect(SyntaxKind.Identifier, "Expected the native library's name. For example, "
        + "write 'native zlib;'.");
    if (parser.atContextual("system")) {
        parser.bumpAs(SyntaxKind.SystemKeyword);
    } else {
        parser.nullSlot();
    }
    if (parser.at(SyntaxKind.OpenBrace)) {
        parseNativeBindingList(parser);
        parser.nullSlot();
    } else {
        parser.nullSlot();
        parser.expect(SyntaxKind.Semicolon, "Expected ';' after the native library's name, or a "
            + "'\{ ... \}' block naming its library for each platform. For example, write "
            + "'native zlib;'.");
    }
    parser.complete(marker, SyntaxKind.NativeDeclaration);
}

parseNativeBindingList(Parser parser) {
    let marker = parser.start();
    parser.bump();
    let bindings = parser.start();
    while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
        parseNativeBinding(parser);
    }
    parser.complete(bindings, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the native library's block.");
    parser.complete(marker, SyntaxKind.NativeBindingList);
}

parseNativeBinding(Parser parser) {
    if (!parser.at(SyntaxKind.Identifier)) {
        parseManifestItemError(parser, SyntaxKind.ErrorNativeBinding, "Expected a platform and "
            + "its library names. For example, write 'windows \"LLVM-C\";'.");
        return;
    }
    if (parser.peekIsContextual(1, "artifact")) {
        let marker = parser.start();
        parser.bump();
        parser.bumpAs(SyntaxKind.ArtifactKeyword);
        parser.expect(SyntaxKind.StringLiteral, "Expected the artifact's URL in quotes after "
            + "'artifact'. For example, write 'windows artifact \"https://example.com/z.lib\" "
            + "hash \"sha256:...\";'.");
        if (parser.atContextual("hash")) {
            parser.bumpAs(SyntaxKind.HashKeyword);
        } else {
            parser.missing(SyntaxKind.HashKeyword,
                "Expected 'hash' and the artifact's sha256 hash after the URL. For example, "
                + "write 'hash \"sha256:...\"'.");
        }
        parser.expect(SyntaxKind.StringLiteral, "Expected the artifact's sha256 hash in quotes "
            + "after 'hash'. For example, write 'hash \"sha256:...\"'.");
        parser.expect(SyntaxKind.Semicolon, "Expected ';' after the artifact's hash.");
        parser.complete(marker, SyntaxKind.NativeArtifactBinding);
        return;
    }
    let marker = parser.start();
    parser.bump();
    let names = parser.start();
    parser.expect(SyntaxKind.StringLiteral, "Expected at least one library name in quotes, "
        + "without 'lib' in front or a file ending. For example, write 'windows \"LLVM-C\";'.");
    while (parser.at(SyntaxKind.StringLiteral)) {
        parser.bump();
    }
    parser.complete(names, SyntaxKind.List);
    parser.expect(SyntaxKind.Semicolon, "Expected ';' after the platform's library names.");
    parser.complete(marker, SyntaxKind.NativeLibraryBinding);
}

parseWorkspaceItem(Parser parser) {
    if (parser.atContextual("member")) {
        let marker = parser.start();
        parser.bumpAs(SyntaxKind.MemberKeyword);
        parser.expect(SyntaxKind.StringLiteral, "Expected the member's folder in quotes. For "
            + "example, write 'member \"frontend\";'.");
        parser.expect(SyntaxKind.Semicolon, "Expected ';' after the member declaration.");
        parser.complete(marker, SyntaxKind.MemberDeclaration);
        return;
    }
    parseManifestItemError(parser, SyntaxKind.ErrorWorkspaceItem, "Expected a 'member' line "
        + "inside the workspace declaration. For example, write 'member \"frontend\";'.");
}

parseOverridesItem(Parser parser) {
    if (parser.at(SyntaxKind.OverrideKeyword)) {
        let marker = parser.start();
        parser.bump();
        parsePackagePath(parser, "Expected the name of the package to override after "
            + "'override'. For example, write 'override alex.library \"../library\";'.");
        parser.expect(SyntaxKind.StringLiteral, "Expected the folder to take the package from, "
            + "in quotes. For example, write 'override alex.library \"../library\";'.");
        parser.expect(SyntaxKind.Semicolon, "Expected ';' after the override declaration.");
        parser.complete(marker, SyntaxKind.OverrideDeclaration);
        return;
    }
    parseManifestItemError(parser, SyntaxKind.ErrorOverridesItem, "Expected an 'override' line "
        + "inside the overrides declaration. For example, write "
        + "'override alex.library \"../library\";'.");
}

// The junk is wrapped in the block's error kind. A ';' ends it and is consumed into it, a
// braced region is skipped whole, and a '}' ends it unconsumed so the block can close.
parseManifestItemError(Parser parser, SyntaxKind errorKind, string message) {
    parser.reportAtCurrent(message);
    let marker = parser.start();
    let skipped = parser.start();
    while (!parser.atEnd()) {
        let kind = parser.currentKind();
        if (kind == SyntaxKind.CloseBrace) {
            break;
        }
        if (kind == SyntaxKind.Semicolon) {
            parser.bump();
            break;
        }
        if (kind == SyntaxKind.OpenBrace) {
            parser.bumpBalancedBraces();
            break;
        }
        parser.bump();
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.complete(marker, errorKind);
}

// Recovery at the top of a manifest: skips to the next declaration keyword, taking braced
// regions whole.
parseManifestDeclarationError(Parser parser) {
    parser.reportAtCurrent("Expected 'package', 'workspace' or 'overrides' at the start of the "
        + "manifest. For example, write 'package acme.tools \{ ... \}'.");
    let marker = parser.start();
    let skipped = parser.start();
    bool first = true;
    while (!parser.atEnd()) {
        if (!first && atManifestDeclarationStart(parser)) {
            break;
        }
        if (parser.currentKind() == SyntaxKind.OpenBrace) {
            parser.bumpBalancedBraces();
            break;
        }
        parser.bump();
        first = false;
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.ErrorManifestDeclaration);
}
