// The grammar of written types, and the tables of the token kinds that begin one.
import support.source;
import SyntaxKind from syntax.generated.kind;
import Parser from parse.parser;

// ============================================================ types

// Type = a type head with any chain of '?' and '[]' suffixes.
public parseType(Parser parser, string missingMessage) -> long {
    return parseTypeAndSuffixes(parser, missingMessage, false);
}

// Every written type is parsed here, which is where its nesting is bounded. A type's slots
// hold one head that its suffixes wrap, so half a chain has no shape a type position could
// hold: an over-long chain is read to its end and then abandoned whole.
public parseTypeAndSuffixes(Parser parser, string missingMessage, bool leaveCoalesceToExpression) -> long {
    if (!parser.enterNesting(deeplyNestedType())) {
        return parser.abandoned(SyntaxKind.ErrorType);
    }
    let restore = parser.mark();
    long completed = parseTypeSuffixes(parser, parseTypeHead(parser, missingMessage),
        leaveCoalesceToExpression);
    parser.leaveNesting();
    if (completed >= 0) {
        return completed;
    }
    long end = parser.position();
    parser.rewind(restore);
    return abandonedDeepType(parser, end);
}

// A type abandoned for depth, as one error type holding the tokens it was written with. The
// parse ends where the type ended, so the declaration around it keeps its shape. The rewind
// above dropped the limit the nested parse reported, so it is reported here, at the type.
abandonedDeepType(Parser parser, long end) -> long {
    let marker = parser.start();
    long start = parser.tokens()[parser.position()].offset;
    let skipped = parser.start();
    while (parser.position() < end && !parser.atEnd()) {
        parser.bump();
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.reportDepthLimit(deeplyNestedType(), source.makeSpan(start, 0));
    return parser.complete(marker, SyntaxKind.ErrorType);
}

// The head a type starts with: a function type or a type in parentheses when it opens with
// '(', and a named type otherwise.
public parseTypeHead(Parser parser, string missingMessage) -> long {
    if (parser.at(SyntaxKind.OpenParenthesis)) {
        if (parser.atArrowAfterParentheses()) {
            return parseFunctionType(parser);
        }
        return parseParenthesizedType(parser);
    }
    return parseNamedType(parser, missingMessage);
}

// FunctionType = '(' parameterTypes ')' '->' returnedType. The caller has established that
// the token after the matching ')' is '->'.
parseFunctionType(Parser parser) -> long {
    let marker = parser.start();
    parser.bump();
    let list = parser.start();
    if (!parser.at(SyntaxKind.CloseParenthesis) && !parser.atEnd()) {
        parseType(parser, "Expected a parameter type, for example '(int, int) -> int'");
        while (parser.at(SyntaxKind.Comma)) {
            parser.bump();
            if (parser.at(SyntaxKind.CloseParenthesis)) {
                break;
            }
            parseType(parser, "Expected a parameter type after ','");
        }
    }
    parser.complete(list, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseParenthesis,
        "Expected ')' to close the function type's parameter types");
    parser.expect(SyntaxKind.Arrow,
        "Expected '->' after the parameter types, for example '(int, int) -> int'");
    parseType(parser, "Expected the return type after '->', for example '(int, int) -> int'");
    if (parser.at(SyntaxKind.ThrowsKeyword)) {
        parseThrowsClause(parser);
    } else {
        parser.nullSlot();
    }
    return parser.complete(marker, SyntaxKind.FunctionType);
}

// ThrowsClause = 'throws' errorTypes, at the 'throws' keyword. The list of types may be empty.
public parseThrowsClause(Parser parser) {
    let marker = parser.start();
    parser.bump();
    let types = parser.start();
    if (isTypeStart(parser.currentKind())) {
        parseNamedType(parser, "Expected an error type after 'throws'");
        while (parser.at(SyntaxKind.Comma)) {
            parser.bump();
            parseNamedType(parser, "Expected an error type after ','");
        }
    }
    parser.complete(types, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.ThrowsClause);
}

// ParenthesizedType = '(' inner: Type ')'. The parentheses exist so a '?' or '[]' suffix can
// apply to a function type, which is the only type they are allowed around. The restriction is
// a semantic one, because a type in parentheses is parsed speculatively wherever a statement
// could begin with one, and a rejection reported here would cost the declaration its shape.
parseParenthesizedType(Parser parser) -> long {
    let marker = parser.start();
    parser.bump();
    parseType(parser, "Expected a type inside the parentheses, for example '((int) -> bool)?'");
    parser.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the type in parentheses; a "
        + "function type needs '->' and its return type too, for example '(int, int) -> int'");
    return parser.complete(marker, SyntaxKind.ParenthesizedType);
}

// The target of 'as' or 'as?'. This is the one type position an expression continues from, so
// it is the one where a '?' can belong to the expression: in 'x as? Foo ?? fallback' the pair
// is the coalescing operator, and in 'x as? Foo?[0]' the '?[' is the safe subscript. Giving
// the suffixes up here loses no valid reading, since 'as' rejects a nullable target outright.
public parseCastTargetType(Parser parser, string missingMessage) -> long {
    return parseTypeAndSuffixes(parser, missingMessage, true);
}

// True where the '?' at the type suffixes' position opens an operator instead: the two of a
// '??', or the one of a '?[' that indexes rather than the '?[]' that spells an array of a
// nullable element.
leavesQuestionToExpression(Parser parser) -> bool {
    if (parser.atNullCoalesce()) {
        return true;
    }
    return parser.atSafeSubscript() && parser.peekKind(2) != SyntaxKind.CloseBracket;
}

// Every suffix wraps what came before, so a chain's length is the depth of the type tree and
// counts against the same limit parentheses and type arguments do. The levels a chain took are
// returned together, because they are one type rather than one per suffix. Reaching the
// limit reads the rest of the chain and returns -1 for the caller to abandon the type.
parseTypeSuffixes(Parser parser, long named, bool leaveCoalesceToExpression) -> long {
    long completed = named;
    long taken = 0;
    while (true) {
        if (parser.at(SyntaxKind.Question)) {
            if (leaveCoalesceToExpression && leavesQuestionToExpression(parser)) {
                break;
            }
            if (!parser.enterNesting(deeplyNestedType())) {
                parser.leaveNestingTimes(taken);
                skipTypeSuffixes(parser, leaveCoalesceToExpression);
                return -1;
            }
            taken++;
            let marker = parser.precede(completed);
            parser.bump();
            completed = parser.complete(marker, SyntaxKind.OptionalType);
            continue;
        }
        if (parser.at(SyntaxKind.OpenBracket) && parser.peekKind(1) == SyntaxKind.CloseBracket) {
            if (!parser.enterNesting(deeplyNestedType())) {
                parser.leaveNestingTimes(taken);
                skipTypeSuffixes(parser, leaveCoalesceToExpression);
                return -1;
            }
            taken++;
            let marker = parser.precede(completed);
            parser.bump();
            parser.bump();
            completed = parser.complete(marker, SyntaxKind.ArrayType);
            continue;
        }
        break;
    }
    parser.leaveNestingTimes(taken);
    return completed;
}

skipTypeSuffixes(Parser parser, bool leaveCoalesceToExpression) {
    while (true) {
        if (parser.at(SyntaxKind.Question)
                && !(leaveCoalesceToExpression && leavesQuestionToExpression(parser))) {
            parser.bump();
            continue;
        }
        if (parser.at(SyntaxKind.OpenBracket) && parser.peekKind(1) == SyntaxKind.CloseBracket) {
            parser.bump();
            parser.bump();
            continue;
        }
        break;
    }
}

// NamedType = qualifier? name typeArguments?. A '<' after the name is taken as type arguments
// only when they parse cleanly; otherwise it is left for the caller (a comparison, in
// expression positions).
public parseNamedType(Parser parser, string missingMessage) -> long {
    let marker = parser.start();
    bool qualifiable = parser.at(SyntaxKind.Identifier);
    if (qualifiable && parser.peekKind(1) == SyntaxKind.Dot && parser.peekKind(2) == SyntaxKind.Identifier) {
        let qualifier = parser.start();
        parser.bump();
        parser.bump();
        parser.complete(qualifier, SyntaxKind.TypeQualifier);
    } else {
        parser.nullSlot();
    }
    if (isTypeStart(parser.currentKind())) {
        parser.bump();
    } else {
        parser.missing(SyntaxKind.Identifier, missingMessage);
    }
    if (!parser.at(SyntaxKind.Less) || !tryParseTypeArgumentList(parser)) {
        parser.nullSlot();
    }
    return parser.complete(marker, SyntaxKind.NamedType);
}

// Commits the type argument list when it parses without diagnostics, and rewinds otherwise.
// A list abandoned for depth keeps that limit: in a type position nothing re-reads the '<',
// and where a comparison does, how deep the text nests is worth reporting either way.
tryParseTypeArgumentList(Parser parser) -> bool {
    let restore = parser.mark();
    parseTypeArgumentList(parser);
    if (parser.clean(restore)) {
        return true;
    }
    parser.carryDepthLimits(restore);
    parser.rewind(restore);
    return false;
}

public parseTypeArgumentList(Parser parser) {
    let marker = parser.start();
    parser.expectOpeningAngle("Expected '<' to begin the type arguments");
    let list = parser.start();
    if (!parser.atClosingAngle() && !parser.atEnd()) {
        parseType(parser, "Expected a type argument, for example 'List<int>'");
        while (parser.at(SyntaxKind.Comma)) {
            parser.bump();
            if (parser.atClosingAngle()) {
                break;
            }
            parseType(parser, "Expected a type argument after ','");
        }
    }
    parser.complete(list, SyntaxKind.List);
    parser.expectClosingAngle("Expected '>' to close the type arguments");
    parser.complete(marker, SyntaxKind.TypeArgumentList);
}

// ============================================================ kind tables

// True for a token that can begin a NamedType, which is a name or a primitive type keyword.
public isTypeStart(SyntaxKind kind) -> bool {
    return kind == SyntaxKind.Identifier || isPrimitiveTypeKeyword(kind);
}

// Where a whole Type is expected rather than a NamedType: a '(' opens a function type or a type
// in parentheses.
public isTypeOrGroupStart(SyntaxKind kind) -> bool {
    return isTypeStart(kind) || kind == SyntaxKind.OpenParenthesis;
}

// True for a keyword that names a primitive type, such as 'int' or 'string'.
public isPrimitiveTypeKeyword(SyntaxKind kind) -> bool {
    return switch (kind) {
        BoolKeyword, ByteKeyword, ShortKeyword, UShortKeyword, IntKeyword, UIntKeyword,
        LongKeyword, ULongKeyword, FloatKeyword, DoubleKeyword, DecimalKeyword, CharKeyword,
        StringKeyword, VoidKeyword -> true,
        default -> false,
    };
}

// What a type too deep to parse reports. Its three sources share one count, so all three are
// named rather than guessing which one filled it.
deeplyNestedType() -> string {
    return "This type nests too deeply to be parsed; reduce how deeply its type arguments, "
        + "parentheses and '?' or '[]' suffixes nest";
}
