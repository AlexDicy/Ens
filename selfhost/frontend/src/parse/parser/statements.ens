// The grammar of statements and blocks, switch statements and switch expressions included.
import support.source;
import SyntaxKind from syntax.generated.kind;
import Parser from parse.parser;
import parse.parser.types;
import parse.parser.expressions;

// ============================================================ statements

// One statement, chosen by its first token, or an error statement where no statement can begin.
public parseStatement(Parser parser) {
    switch (parser.currentKind()) {
        OpenBrace -> parseBlock(parser),
        LetKeyword, ConstKeyword -> parseVariableDeclaration(parser),
        IfKeyword -> parseIfStatement(parser),
        WhileKeyword -> parseWhileStatement(parser),
        ForKeyword -> parseForStatement(parser),
        SwitchKeyword -> parseSwitchStatement(parser),
        BreakKeyword -> parseKeywordStatement(parser, SyntaxKind.BreakStatement,
            "Expected ';' after 'break'."),
        ContinueKeyword -> parseKeywordStatement(parser, SyntaxKind.ContinueStatement,
            "Expected ';' after 'continue'."),
        RethrowKeyword -> parseKeywordStatement(parser, SyntaxKind.RethrowStatement,
            "Expected ';' after 'rethrow'."),
        ReturnKeyword -> parseReturnStatement(parser),
        ThrowKeyword -> parseThrowStatement(parser),
        CatchKeyword -> parseStatementError(parser,
            "A 'catch' block can only follow the closing '}' of a function's body. Move this "
            + "'catch' block to right after the function's '}'."),
        FinallyKeyword -> parseStatementError(parser, finallyMessage()),
        default -> {
            if (atTypedVariableDeclaration(parser)) {
                parseVariableDeclaration(parser);
            } else if (expressions.canStartExpression(parser.currentKind())) {
                parseExpressionStatement(parser);
            } else {
                parseStatementError(parser, "Expected a statement, such as an assignment, a call "
                    + "or a declaration like 'let count = 0;'.");
            }
        },
    }
}

// What a 'finally' block reports, as a statement and as a declaration alike.
public finallyMessage() -> string {
    return "Ens has no 'finally' block. Remove it, and write its cleanup before each 'return' "
        + "and in the 'catch' block instead.";
}

// A block holds statements that hold blocks, so its nesting counts towards the same limit an
// expression's and a type's do: all three deepen the tree the later phases walk. A block with
// statements and no room left for them reports at its '{', and its body becomes one error
// statement holding the tokens, so the braces around it still match.
public parseBlock(Parser parser) {
    let marker = parser.start();
    bool opened = parser.at(SyntaxKind.OpenBrace);
    long openOffset = parser.tokens()[parser.position()].offset;
    parser.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the block.");
    let statements = parser.start();
    if (parser.enterNesting(deeplyNestedBlocks())) {
        if (!parser.at(SyntaxKind.CloseBrace)
                && parser.refuseWithoutRoom(BlockNesting.room, deeplyNestedBlocks(), openOffset)) {
            skipDeepBlockBody(parser);
        } else {
            while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
                parseStatement(parser);
            }
        }
        parser.leaveNesting();
    } else {
        skipDeepBlockBody(parser);
    }
    parser.complete(statements, SyntaxKind.List);
    if (parser.at(SyntaxKind.CloseBrace)) {
        parser.bump();
    } else if (opened) {
        parser.missing(SyntaxKind.CloseBrace, "Expected '\}' to close the block that starts on "
            + "line {parser.lineAt(openOffset)}.");
    } else {
        parser.missing(SyntaxKind.CloseBrace, "Expected '\}' to close the block.");
    }
    parser.complete(marker, SyntaxKind.Block);
}

// What a block too deep to parse reports, whether it nests directly or through a statement that
// opens it, such as an 'if' or a loop.
deeplyNestedBlocks() -> string {
    return "These blocks are nested too deeply to compile. Move the inner blocks into functions of "
        + "their own.";
}

final class BlockNesting {
    // A block's statements are parsed only while this many levels are left under the nesting
    // limit below the block's own level. Their conditions, expressions and types nest through
    // them, and so does a block one of them opens, which checks again from its own level.
    protected static const long room = 16;
}

// The statements of a block too deep to parse, taken as tokens up to the brace that closes it,
// so the enclosing blocks still find their own closers.
skipDeepBlockBody(Parser parser) {
    let marker = parser.start();
    let skipped = parser.start();
    long depth = 0;
    while (!parser.atEnd()) {
        let kind = parser.currentKind();
        if (kind == SyntaxKind.CloseBrace) {
            if (depth == 0) {
                break;
            }
            depth--;
        } else if (kind == SyntaxKind.OpenBrace) {
            depth++;
        }
        parser.bump();
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.ErrorStatement);
}

// For a required Block slot with no '{' present. An empty Block with missing braces keeps the
// typed accessors total. It is zero-width and consumes nothing, so the pair of braces is one
// guess reaching no further than the statement being built.
public parseBlockOrMissing(Parser parser, string message) {
    if (parser.at(SyntaxKind.OpenBrace)) {
        parseBlock(parser);
        return;
    }
    parser.report(message, source.makeSpan(parser.lastContentEnd(), 0));
    let marker = parser.start();
    parser.missingInPlace();
    let statements = parser.start();
    parser.complete(statements, SyntaxKind.List);
    parser.pushMissingToken();
    parser.complete(marker, SyntaxKind.Block);
}

// Recovery inside blocks: wraps the junk in an ErrorStatement; a ';' ends the junk and is
// consumed into it, and a '}' ends it unconsumed so the enclosing block can close.
parseStatementError(Parser parser, string message) {
    parser.reportAtCurrent(message);
    let marker = parser.start();
    let skipped = parser.start();
    while (!parser.atEnd()) {
        let kind = parser.currentKind();
        if (kind == SyntaxKind.CloseBrace) {
            break;
        }
        if (kind == SyntaxKind.Semicolon) {
            parser.bump();
            break;
        }
        parser.bump();
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.ErrorStatement);
}

// True at `Type name = ...` or `Type name;`. The type is parsed speculatively and always
// rewound, and the caller re-parses it for real. A type the parser could not read keeps the
// reading it was written as, so it reports its own problem once. Dropping the statement to the
// expression path would re-read the same text and report once per link of a broken chain.
public atTypedVariableDeclaration(Parser parser) -> bool {
    if (!types.isTypeOrGroupStart(parser.currentKind())) {
        return false;
    }
    let restore = parser.mark();
    types.parseType(parser, "");
    bool named = parser.at(SyntaxKind.Identifier)
        && (parser.peekKind(1) == SyntaxKind.Equals
            || parser.peekKind(1) == SyntaxKind.Semicolon);
    // A chain that ran into the end of the file has no name to look for, and nothing more was
    // written to say what it was: the tokens already read as a type stay one. A single name
    // there is left to the expression path, which is what an unfinished statement usually is.
    bool truncatedChain = parser.atEnd() && parser.position() - restore.position > 1;
    bool result = named || truncatedChain;
    parser.rewind(restore);
    return result;
}

// A variable outside a function, named by the message. The declaration is read speculatively
// and rewound; its example function is given only when the type and a one-token value are known.
public topLevelVariableMessage(Parser parser) -> string {
    let restore = parser.mark();
    if (parser.at(SyntaxKind.LetKeyword) || parser.at(SyntaxKind.ConstKeyword)) {
        parser.bump();
    }
    bool bareName = parser.at(SyntaxKind.Identifier)
        && (parser.peekKind(1) == SyntaxKind.Equals || parser.peekKind(1) == SyntaxKind.Semicolon);
    string typeText = "";
    if (!bareName && types.isTypeOrGroupStart(parser.currentKind())) {
        long typeStart = parser.tokens()[parser.position()].offset;
        types.parseType(parser, "");
        typeText = parser.text().substring(typeStart, parser.lastContentEnd());
    }
    string name = "";
    string value = "";
    if (parser.at(SyntaxKind.Identifier)) {
        name = parser.currentText();
        if (parser.peekKind(1) == SyntaxKind.Equals && parser.peekKind(3) == SyntaxKind.Semicolon) {
            let token = parser.tokens()[parser.position() + 2];
            value = parser.text().substring(token.offset, token.end());
            if (typeText.length == 0) {
                typeText = literalTypeName(parser.peekKind(2));
            }
        }
    }
    parser.rewind(restore);
    if (name.length == 0) {
        return "A variable cannot be declared outside a function. Move the declaration into a "
            + "function.";
    }
    string message = "'{name}' is a variable, and a variable cannot be declared outside a "
        + "function. Move '{name}' into a function, or write a function that returns its value";
    if (typeText.length == 0 || value.length == 0) {
        return message + ".";
    }
    return message + ", for example '{name}() -> {typeText} \{ return {value}; \}'.";
}

// The type a literal of this kind has, or "" for a kind that is not a literal.
literalTypeName(SyntaxKind kind) -> string {
    return switch (kind) {
        IntLiteral -> "int",
        LongLiteral -> "long",
        FloatLiteral -> "float",
        DoubleLiteral -> "double",
        StringLiteral -> "string",
        CharLiteral -> "char",
        TrueKeyword, FalseKeyword -> "bool",
        default -> "",
    };
}

// VariableDeclaration = modifier? declaredType? name initializer? ';'. Whether at least one
// of modifier and declared type is present is checked semantically, not here.
parseVariableDeclaration(Parser parser) {
    let marker = parser.start();
    if (parser.at(SyntaxKind.LetKeyword) || parser.at(SyntaxKind.ConstKeyword)) {
        parser.bump();
    } else {
        parser.nullSlot();
    }
    bool bareName = parser.at(SyntaxKind.Identifier)
        && (parser.peekKind(1) == SyntaxKind.Equals || parser.peekKind(1) == SyntaxKind.Semicolon);
    if (bareName) {
        parser.nullSlot();
        parser.bump();
    } else if (types.isTypeOrGroupStart(parser.currentKind())) {
        types.parseType(parser, "Expected the variable's type.");
        parser.expect(SyntaxKind.Identifier,
            "Expected the variable's name after its type. For example, write 'int count = 0;'.");
    } else {
        parser.nullSlot();
        parser.missing(SyntaxKind.Identifier,
            "Expected the variable's name. For example, write 'let count = 0;'.");
    }
    if (parser.at(SyntaxKind.Equals)) {
        parseInitializer(parser);
    } else {
        parser.nullSlot();
    }
    parser.expect(SyntaxKind.Semicolon,
        "Expected ';' after the variable declaration. For example, write 'let count = 0;'.");
    parser.complete(marker, SyntaxKind.VariableDeclaration);
}

// Initializer = '=' value. The caller is at '='.
public parseInitializer(Parser parser) {
    let marker = parser.start();
    parser.bump();
    expressions.parseExpression(parser);
    parser.complete(marker, SyntaxKind.Initializer);
}

parseIfStatement(Parser parser) {
    let marker = parser.start();
    parser.bump();
    parseCondition(parser, "Expected '(' before the condition of 'if'. Write the condition in "
        + "parentheses, as in 'if (ready) \{ ... \}'.", "Expected ')' after the condition of 'if'.");
    parseBlockOrMissing(parser, "Expected '\{' to begin the body of 'if'. The branches of 'if' "
        + "are always blocks, as in 'if (ready) \{ start(); \}'.");
    if (parser.at(SyntaxKind.ElseKeyword)) {
        let elseMarker = parser.start();
        parser.bump();
        if (parser.at(SyntaxKind.IfKeyword)) {
            parseIfStatement(parser);
        } else {
            parseBlockOrMissing(parser, "Expected '\{' or another 'if' after 'else'.");
        }
        parser.complete(elseMarker, SyntaxKind.ElseClause);
    } else {
        parser.nullSlot();
    }
    parser.complete(marker, SyntaxKind.IfStatement);
}

parseWhileStatement(Parser parser) {
    let marker = parser.start();
    parser.bump();
    parseCondition(parser, "Expected '(' before the condition of 'while'. Write the condition in "
        + "parentheses, as in 'while (running) \{ ... \}'.",
        "Expected ')' after the condition of 'while'.");
    parseBlockOrMissing(parser, "Expected '\{' to begin the loop body.");
    parser.complete(marker, SyntaxKind.WhileStatement);
}

// The parenthesized condition of 'if' and 'while'. When the '(' is missing, a missing ')' is
// the same mistake, so only the '(' is reported.
parseCondition(Parser parser, string openMessage, string closeMessage) {
    bool opened = parser.at(SyntaxKind.OpenParenthesis);
    parser.expect(SyntaxKind.OpenParenthesis, openMessage);
    expressions.parseExpression(parser);
    if (parser.at(SyntaxKind.CloseParenthesis)) {
        parser.bump();
    } else if (opened) {
        parser.missing(SyntaxKind.CloseParenthesis, closeMessage);
    } else {
        parser.missingUnreported(SyntaxKind.CloseParenthesis);
    }
}

parseForStatement(Parser parser) {
    let marker = parser.start();
    parser.bump();
    parser.expect(SyntaxKind.OpenParenthesis, "Expected '(' after 'for'. For example, write "
        + "'for (let item in items) \{ ... \}'.");
    if (atForEachHeader(parser)) {
        if (parser.at(SyntaxKind.LetKeyword) || parser.at(SyntaxKind.ConstKeyword)) {
            parser.bump();
        } else {
            parser.nullSlot();
        }
        if (parser.at(SyntaxKind.Identifier) && parser.peekIsContextual(1, "in")) {
            parser.nullSlot();
            parser.bump();
        } else {
            types.parseType(parser, "Expected 'let' or a type for the loop variable. For example, "
                + "write 'for (let item in items)'.");
            parser.expect(SyntaxKind.Identifier, "Expected the loop variable's name.");
        }
        if (parser.atContextual("in")) {
            parser.bumpAs(SyntaxKind.InKeyword);
        } else {
            parser.missing(SyntaxKind.InKeyword,
                "Expected 'in' between the loop variable and the values it walks through. For "
                + "example, write 'for (let item in items)'.");
        }
        expressions.parseExpression(parser);
        parser.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the values the loop walks "
            + "through, as in 'for (let item in items)'.");
        parseBlockOrMissing(parser, "Expected '\{' to begin the loop body.");
        parser.complete(marker, SyntaxKind.ForEachStatement);
        return;
    }
    if (parser.at(SyntaxKind.Semicolon)) {
        parser.nullSlot();
        parser.bump();
    } else {
        if (parser.at(SyntaxKind.LetKeyword) || parser.at(SyntaxKind.ConstKeyword)
                || atTypedVariableDeclaration(parser)) {
            parseVariableDeclaration(parser);
        } else {
            parseExpressionStatement(parser);
        }
        parser.nullSlot();
    }
    if (parser.at(SyntaxKind.Semicolon) || !expressions.canStartExpression(parser.currentKind())) {
        parser.nullSlot();
    } else {
        expressions.parseExpression(parser);
    }
    parser.expect(SyntaxKind.Semicolon, "Expected ';' after the condition of 'for'. The three "
        + "parts are separated by ';', as in 'for (int i = 0; i < 10; i++)'.");
    if (parser.at(SyntaxKind.CloseParenthesis) || !expressions.canStartExpression(parser.currentKind())) {
        parser.nullSlot();
    } else {
        expressions.parseExpression(parser);
    }
    parser.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the three parts of 'for', as "
        + "in 'for (int i = 0; i < 10; i++)'.");
    parseBlockOrMissing(parser, "Expected '\{' to begin the loop body.");
    parser.complete(marker, SyntaxKind.ForStatement);
}

// At the first token inside the for parentheses: true for `[let|const]? [Type]? name in`.
// Purely speculative; everything is rewound.
atForEachHeader(Parser parser) -> bool {
    let restore = parser.mark();
    if (parser.at(SyntaxKind.LetKeyword) || parser.at(SyntaxKind.ConstKeyword)) {
        parser.bump();
    }
    bool result;
    if (parser.at(SyntaxKind.Identifier) && parser.peekIsContextual(1, "in")) {
        result = true;
    } else if (types.isTypeOrGroupStart(parser.currentKind())) {
        types.parseType(parser, "");
        result = parser.clean(restore) && parser.at(SyntaxKind.Identifier)
            && parser.peekIsContextual(1, "in");
    } else {
        result = false;
    }
    parser.rewind(restore);
    return result;
}

parseKeywordStatement(Parser parser, SyntaxKind statementKind, string semicolonMessage) {
    let marker = parser.start();
    parser.bump();
    parser.expect(SyntaxKind.Semicolon, semicolonMessage);
    parser.complete(marker, statementKind);
}

parseReturnStatement(Parser parser) {
    let marker = parser.start();
    parser.bump();
    if (parser.at(SyntaxKind.Semicolon)
            || (!expressions.canStartExpression(parser.currentKind()) && !parser.at(SyntaxKind.OpenBrace))) {
        parser.nullSlot();
    } else {
        expressions.parseExpression(parser);
    }
    parser.expect(SyntaxKind.Semicolon,
        "Expected ';' after the return statement. For example, write 'return value;'.");
    parser.complete(marker, SyntaxKind.ReturnStatement);
}

parseThrowStatement(Parser parser) {
    let marker = parser.start();
    parser.bump();
    if (parser.at(SyntaxKind.Semicolon)) {
        parser.report("'throw' needs an error value, an object of a class that extends 'Error', "
            + "such as one you declare with 'class ParseError extends Error \{ ... \}'. To throw "
            + "the caught error again inside a 'catch' block, write 'rethrow;'.",
            source.makeSpan(parser.lastContentEnd(), 0));
        let empty = parser.start();
        let skipped = parser.start();
        parser.complete(skipped, SyntaxKind.List);
        parser.complete(empty, SyntaxKind.ErrorExpression);
    } else {
        expressions.parseExpression(parser);
    }
    parser.expect(SyntaxKind.Semicolon, "Expected ';' after the throw statement.");
    parser.complete(marker, SyntaxKind.ThrowStatement);
}

parseExpressionStatement(Parser parser) {
    let marker = parser.start();
    expressions.parseExpression(parser);
    parser.expect(SyntaxKind.Semicolon,
        "Expected ';' after the expression. For example, write 'total = total + 1;'.");
    parser.complete(marker, SyntaxKind.ExpressionStatement);
}

// ============================================================ switch

parseSwitchStatement(Parser parser) {
    let marker = parser.start();
    parseSwitchParts(parser);
    parser.complete(marker, SyntaxKind.SwitchStatement);
}

// A switch in expression position, returned completed so the operators after it can wrap it.
public parseSwitchExpression(Parser parser) -> long {
    let marker = parser.start();
    parseSwitchParts(parser);
    return parser.complete(marker, SyntaxKind.SwitchExpression);
}

parseSwitchParts(Parser parser) {
    parser.bump();
    parser.expect(SyntaxKind.OpenParenthesis, "Expected '(' after 'switch'. For example, write "
        + "'switch (color) \{ ... \}'.");
    expressions.parseExpression(parser);
    parser.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the switch value.");
    parser.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the switch's arms.");
    let arms = parser.start();
    bool needSeparator = false;
    while (!parser.at(SyntaxKind.CloseBrace) && !parser.atEnd()) {
        if (needSeparator) {
            if (parser.at(SyntaxKind.Comma)) {
                parser.bump();
            } else {
                // The comma between arms is optional in the language; a zero-width Missing
                // token keeps the separated list's odd separator indices without a diagnostic.
                parser.pushMissingToken();
            }
            if (parser.at(SyntaxKind.CloseBrace)) {
                break;
            }
        }
        let kind = parser.currentKind();
        if (kind == SyntaxKind.DefaultKeyword || kind == SyntaxKind.IsKeyword
                || expressions.canStartExpression(kind)) {
            parseSwitchArm(parser);
            needSeparator = true;
        } else {
            // An arm the parser could not read is still an arm, and still takes a separator
            // after it, so the list stays the item-then-separator pairs its slots assume.
            parseSwitchArmError(parser);
            needSeparator = true;
        }
    }
    parser.complete(arms, SyntaxKind.List);
    parser.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the switch.");
}

parseSwitchArm(Parser parser) {
    switch (parser.currentKind()) {
        DefaultKeyword -> {
            let marker = parser.start();
            parser.bump();
            parseArmArrowAndBody(parser, "Expected '->' after 'default'. For example, write "
                + "'default -> handleOther()'.");
            parser.complete(marker, SyntaxKind.DefaultArm);
        },
        IsKeyword -> {
            let marker = parser.start();
            long armStart = parser.tokens()[parser.position()].offset;
            parser.bump();
            types.parseTypeAndSuffixes(parser, "Expected a type after 'is'. For example, write "
                + "'is Circle c -> c.radius'.", false);
            if (parser.at(SyntaxKind.Identifier)) {
                parser.bump();
            } else {
                parser.nullSlot();
            }
            let armText = parser.text().substring(armStart, parser.lastContentEnd());
            parseArmArrowAndBody(parser, "Expected '->' after '{armText}'. For example, write "
                + "'is Circle c -> c.radius'.");
            parser.complete(marker, SyntaxKind.TypeArm);
        },
        default -> {
            let marker = parser.start();
            let labels = parser.start();
            bool outerLabels = parser.inArmLabels();
            parser.setInArmLabels(true);
            expressions.parseExpression(parser);
            while (parser.at(SyntaxKind.Comma)) {
                // 'default' and 'is' begin an arm and can never be a label, so a comma before
                // one separated arms; left unconsumed, the arm list takes it as its separator.
                if (parser.peekKind(1) == SyntaxKind.DefaultKeyword
                        || parser.peekKind(1) == SyntaxKind.IsKeyword) {
                    break;
                }
                parser.bump();
                if (parser.at(SyntaxKind.Arrow) || parser.at(SyntaxKind.CloseBrace) || parser.atEnd()) {
                    break;
                }
                expressions.parseExpression(parser);
            }
            parser.setInArmLabels(outerLabels);
            parser.complete(labels, SyntaxKind.List);
            parseArmArrowAndBody(parser, "Expected '->' after the switch labels. For example, "
                + "write '1 -> handleOne()'.");
            parser.complete(marker, SyntaxKind.ValueArm);
        },
    }
}

// A body written without the arrow is still taken as the body, so the arrow is the only
// diagnostic. With nothing that could be a body after it, the slot takes an empty node, because
// reading the next arm there would report it twice.
parseArmArrowAndBody(Parser parser, string missingMessage) {
    if (parser.at(SyntaxKind.Arrow)) {
        parser.bump();
        parseArmBody(parser);
        return;
    }
    parser.missing(SyntaxKind.Arrow, missingMessage);
    if (parser.at(SyntaxKind.OpenBrace) || expressions.canStartExpression(parser.currentKind())) {
        parseArmBody(parser);
        return;
    }
    let ignored = expressions.emptyErrorExpression(parser);
}

parseArmBody(Parser parser) {
    if (parser.at(SyntaxKind.OpenBrace) && !expressions.atStructLiteralStart(parser)) {
        parseBlock(parser);
    } else {
        expressions.parseExpression(parser);
    }
}

// Junk between switch arms; stops before the ',' or '}' so the arm loop stays in charge.
parseSwitchArmError(Parser parser) {
    parser.reportAtCurrent("Expected a switch arm. For example, write '1 -> handleOne()'.");
    let marker = parser.start();
    let skipped = parser.start();
    bool first = true;
    while (!parser.atEnd()) {
        let kind = parser.currentKind();
        if (kind == SyntaxKind.CloseBrace) {
            break;
        }
        bool armBoundary = kind == SyntaxKind.Comma || kind == SyntaxKind.DefaultKeyword
            || kind == SyntaxKind.IsKeyword || expressions.canStartExpression(kind);
        if (!first && armBoundary) {
            break;
        }
        parser.bump();
        first = false;
    }
    parser.complete(skipped, SyntaxKind.List);
    parser.complete(marker, SyntaxKind.ErrorSwitchArm);
}
