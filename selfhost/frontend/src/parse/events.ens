// The parser's flat output: a rewindable list of events the tree builder folds into a green tree.
// Events reference tokens by index into the lexed significant-token stream, so speculation can
// roll the cursor and the list back to a mark without touching any tree state.
import SyntaxKind from syntax.kind;
import List from @std.collections.list;

public enum EventKind {
    // A node the parser opened but has not finished yet, or abandoned; the tree builder skips it.
    Tombstone,
    StartNode,
    FinishNode,
    Token,
    // An absent optional slot; the tree builder stores a null child to keep slot indices fixed.
    NullSlot,
}

// One parse event. A Token event consumes a piece of a lexed token: pieceStart and pieceLength
// select the consumed content bytes (the whole content for ordinary tokens, a single byte for the
// '>' halves of a split '>>'), and takeLeading/takeTrailing say which attached trivia spans the
// piece keeps. A tokenIndex of -1 marks a parser-inserted Missing token with no text.
//
// A StartNode event may name a forwardParent: the index of a later StartNode event that wraps this
// node retroactively (Pratt-style). The tree builder opens the forward parent first, so the
// wrapping node contains everything from the wrapped node's start.
public struct ParseEvent {
    EventKind eventKind = EventKind.Tombstone;
    SyntaxKind kind = SyntaxKind.Invalid;

    long tokenIndex = -1;
    long pieceStart;
    long pieceLength;
    bool takeLeading = true;
    bool takeTrailing = true;

    long forwardParent = -1;
}

// A growable event list with rewind: truncate drops everything after a speculation mark. The
// backing list only grows; count is the logical length.
public class EventList {
    private List<ParseEvent> backing;
    private long eventCount;

    constructor() {
        this.backing = new List<ParseEvent>();
        this.eventCount = 0;
    }

    count() -> long {
        return this.eventCount;
    }

    get(long index) -> ParseEvent {
        return this.backing.get(index);
    }

    set(long index, ParseEvent event) {
        this.backing.set(index, event);
    }

    // Appends the event and returns its index.
    push(ParseEvent event) -> long {
        if (this.eventCount == this.backing.length()) {
            this.backing.push(event);
        } else {
            this.backing.set(this.eventCount, event);
        }
        this.eventCount++;
        return this.eventCount - 1;
    }

    truncate(long newCount) {
        this.eventCount = newCount;
    }

    toArray() -> ParseEvent[] {
        ParseEvent[] result = new ParseEvent[this.eventCount];
        for (long i = 0; i < result.length; i++) {
            result[i] = this.backing.get(i);
        }
        return result;
    }
}
