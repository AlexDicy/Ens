// The parser: a pure per-file function from source text to a ParseResult holding the green
// SourceFile root and every diagnostic, lex and parse merged in span order. Each call owns all of
// its state; there is no shared sink, no global counter, and no cache that outlives the call, so
// files can parse in parallel.
//
// The parser never touches trees: it walks the lexed significant-token stream and emits a flat
// event stream (see events.ens), and the tree builder folds the events into the green tree.
// Speculation records a mark and rewinds the cursor, the events, and the diagnostics on failure;
// a speculation that succeeds simply keeps what it emitted.
import Source from support.source;
import Span from support.source;
import support.source;
import SyntaxKind from syntax.generated.kind;
import syntax.generated.kind;
import Diagnostic from support.diagnostics;
import LexedToken from lex.token;
import lex.lexer;
import LexResult from lex.lexer;
import GreenNode from syntax.green;
import EventKind from parse.events;
import ParseEvent from parse.events;
import Recovery from parse.recovery;
import RecoveryScope from parse.recovery;
import parse.recovery;
import RewindableList from parse.rewindable;
import parse.treebuilder;
import List from @std.collections.list;

export class ParseResult {
    GreenNode greenRoot;
    Diagnostic[] allDiagnostics;
    Recovery[] allRecoveries;

    protected constructor(GreenNode root, Diagnostic[] diagnostics, Recovery[] recoveries) {
        this.greenRoot = root;
        this.allDiagnostics = diagnostics;
        this.allRecoveries = recoveries;
    }

    // The green root; factory.createRoot builds the typed red tree over it. For parse() this is
    // a SourceFile node (or a ManifestFile node for a manifest) whose full text equals the source
    // byte for byte.
    export root() -> GreenNode {
        return this.greenRoot;
    }

    // Lex and parse diagnostics merged, ordered by span start.
    export diagnostics() -> Diagnostic[] {
        return this.allDiagnostics;
    }

    // Which parts of the tree are the parser's guess rather than the author's text: the tokens it
    // had to invent, in the order it invented them, behind a whole-file guess when the text did not
    // even tokenize. Error nodes are the other half of the picture, and the tree carries those.
    export recoveries() -> Recovery[] {
        return this.allRecoveries;
    }
}

// Parses input as ordinary source, or as a manifest when its file name says so (see
// isManifestPath).
export parse(Source input) -> ParseResult {
    if (isManifestPath(input.path())) {
        return parseManifest(input);
    }
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseSourceFile();
    return finishParse(input, lexed, parser);
}

// Parses one manifest file; the root is a ManifestFile node.
export parseManifest(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseManifestFile();
    return finishParse(input, lexed, parser);
}

// True for the file names that hold manifests, with any folder prefix: 'ens.package' marks a
// package or workspace, 'ens.overrides' holds local overrides.
export isManifestPath(string path) -> bool {
    string name = fileName(path);
    return name == "ens.package" || name == "ens.overrides";
}

fileName(string path) -> string {
    byte[] bytes = path.toBytes();
    long start = 0;
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '/' || bytes[i] == '\\') {
            start = i + 1;
        }
    }
    return path.substring(start, path.length);
}

// Testing entry: parses one expression. The root is a List node holding the expression, any
// unconsumed tokens, and the end-of-file token, so the round-trip invariant covers the whole
// source.
public parseExpressionOnly(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseStandaloneExpression();
    return finishParse(input, lexed, parser);
}

// Testing entry: parses one statement, wrapped the same way as parseExpressionOnly.
public parseStatementOnly(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseStandaloneStatement();
    return finishParse(input, lexed, parser);
}

finishParse(Source input, LexResult lexed, Parser parser) -> ParseResult {
    let root = treebuilder.buildTree(input, lexed.tokens(), parser.finishedEvents());
    let diagnostics = mergeDiagnostics(lexed.diagnostics(), parser.collectedDiagnostics());
    return new ParseResult(root, diagnostics, allRecoveries(lexed, parser));
}

// The parser's own guesses, and one for the whole file when the text did not even tokenize: a run
// of bytes that is not a token leaves the parser reading a stream the author did not write, so no
// construct after it keeps a shape worth trusting.
allRecoveries(LexResult lexed, Parser parser) -> Recovery[] {
    let parsed = parser.collectedRecoveries();
    if (lexed.diagnostics().length == 0) {
        return parsed;
    }
    let all = new List<Recovery>();
    all.push(new Recovery(lexed.diagnostics()[0].span(), RecoveryScope.File));
    for (let recovery in parsed) {
        all.push(recovery);
    }
    return all.toArray();
}

// Two-pointer merge of the position-ordered lex and parse diagnostic lists; lex wins ties.
mergeDiagnostics(Diagnostic[] first, Diagnostic[] second) -> Diagnostic[] {
    let merged = new List<Diagnostic>();
    long i = 0;
    long j = 0;
    while (i < first.length || j < second.length) {
        bool takeFirst = j >= second.length
            || (i < first.length && first[i].span().start <= second[j].span().start);
        if (takeFirst) {
            merged.push(first[i]);
            i++;
        } else {
            merged.push(second[j]);
            j++;
        }
    }
    return merged.toArray();
}

// A snapshot of everything speculation can change: the token cursor (including split state), the
// event list, the diagnostics, and the recoveries.
struct ParserMark {
    long position;
    long splitOffset;
    long lastContentEnd;
    long eventCount;
    long diagnosticCount;
    long recoveryCount;
}

// Expressions nest through recursion; beyond this depth the parser stops recursing and emits an
// error expression so pathological inputs cannot exhaust the stack.
maximumExpressionDepth() -> long {
    return 500;
}

class Parser {
    Source input;
    string text;
    LexedToken[] tokens;

    // Cursor: position indexes the significant-token stream; splitOffset counts the bytes of the
    // current token already consumed as split pieces ('>' halves of '>>' and friends);
    // lastContentEnd is the byte offset just past the last consumed content, where missing-token
    // diagnostics anchor.
    long position;
    long splitOffset;
    long lastContentEnd;

    RewindableList<ParseEvent> events;
    RewindableList<Diagnostic> diagnostics;
    RewindableList<Recovery> recoveries;
    long expressionDepth;

    protected constructor(Source input, LexedToken[] tokens) {
        this.input = input;
        this.text = input.text();
        this.tokens = tokens;
        this.position = 0;
        this.splitOffset = 0;
        this.lastContentEnd = 0;
        this.events = new RewindableList<ParseEvent>();
        this.diagnostics = new RewindableList<Diagnostic>();
        this.recoveries = new RewindableList<Recovery>();
        this.expressionDepth = 0;
    }

    protected finishedEvents() -> ParseEvent[] {
        return this.events.toArray();
    }

    protected collectedDiagnostics() -> Diagnostic[] {
        return this.diagnostics.toArray();
    }

    protected collectedRecoveries() -> Recovery[] {
        return this.recoveries.toArray();
    }

    // ============================================================ entries

    protected parseSourceFile() {
        let marker = this.start();
        let items = this.start();
        while (!this.atEnd()) {
            this.parseTopLevelItem();
        }
        this.complete(items, SyntaxKind.List);
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.SourceFile);
    }

    protected parseManifestFile() {
        let marker = this.start();
        let declarations = this.start();
        while (!this.atEnd()) {
            this.parseManifestDeclaration();
        }
        this.complete(declarations, SyntaxKind.List);
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.ManifestFile);
    }

    protected parseStandaloneExpression() {
        let marker = this.start();
        this.parseExpression();
        while (!this.atEnd()) {
            this.bump();
        }
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.List);
    }

    protected parseStandaloneStatement() {
        let marker = this.start();
        this.parseStatement();
        while (!this.atEnd()) {
            this.bump();
        }
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.List);
    }

    // ============================================================ cursor

    currentKind() -> SyntaxKind {
        let kind = this.tokens[this.position].kind;
        if (this.splitOffset == 0) {
            return kind;
        }
        return splitRemainderKind(kind, this.splitOffset);
    }

    at(SyntaxKind kind) -> bool {
        return this.currentKind() == kind;
    }

    atEnd() -> bool {
        return this.currentKind() == SyntaxKind.EndOfFile;
    }

    // The kind ahead tokens after the current one; ahead 0 is the current kind including split
    // state, and past the end everything reads as EndOfFile.
    peekKind(long ahead) -> SyntaxKind {
        if (ahead == 0) {
            return this.currentKind();
        }
        let index = this.position + ahead;
        if (index >= this.tokens.length) {
            return SyntaxKind.EndOfFile;
        }
        return this.tokens[index].kind;
    }

    currentText() -> string {
        let token = this.tokens[this.position];
        return this.text.substring(token.offset + this.splitOffset, token.end());
    }

    atContextual(string word) -> bool {
        return this.at(SyntaxKind.Identifier) && this.currentText() == word;
    }

    peekIsContextual(long ahead, string word) -> bool {
        let index = this.position + ahead;
        if (index >= this.tokens.length) {
            return false;
        }
        let token = this.tokens[index];
        if (token.kind != SyntaxKind.Identifier) {
            return false;
        }
        return this.text.substring(token.offset, token.end()) == word;
    }

    // ============================================================ events

    // Opens a node whose kind is decided at completion; returns a marker.
    start() -> long {
        ParseEvent event = {};
        return this.events.push(event);
    }

    // Closes the node opened at the marker with the given kind; returns the marker as a completed
    // node usable with precede.
    complete(long marker, SyntaxKind nodeKind) -> long {
        let event = this.events.get(marker);
        event.eventKind = EventKind.StartNode;
        event.kind = nodeKind;
        this.events.set(marker, event);
        ParseEvent finish = {eventKind: EventKind.FinishNode};
        this.events.push(finish);
        return marker;
    }

    // Opens a node that retroactively wraps an already-completed one; everything emitted from the
    // completed node's start onward becomes part of the new node. Never call this on a node
    // completed before a mark that may still be rewound.
    precede(long completed) -> long {
        let marker = this.start();
        let event = this.events.get(completed);
        event.forwardParent = marker;
        this.events.set(completed, event);
        return marker;
    }

    nullSlot() {
        ParseEvent event = {eventKind: EventKind.NullSlot};
        this.events.push(event);
    }

    pushTokenEvent(SyntaxKind kind, long tokenIndex, long pieceStart, long pieceLength,
                           bool takeLeading, bool takeTrailing) {
        ParseEvent event = {
            eventKind: EventKind.Token,
            kind: kind,
            tokenIndex: tokenIndex,
            pieceStart: pieceStart,
            pieceLength: pieceLength,
            takeLeading: takeLeading,
            takeTrailing: takeTrailing,
        };
        this.events.push(event);
    }

    // Consumes the rest of the current token under its own kind.
    bump() {
        this.bumpAs(this.currentKind());
    }

    // Consumes the rest of the current token re-tagged with the given kind: contextual keywords
    // (out/in/test) and keywords recovered as names are emitted this way.
    bumpAs(SyntaxKind kind) {
        if (this.atEnd()) {
            return;
        }
        let token = this.tokens[this.position];
        this.pushTokenEvent(kind, this.position, this.splitOffset, token.length - this.splitOffset,
                            this.splitOffset == 0, true);
        this.lastContentEnd = token.end();
        this.position++;
        this.splitOffset = 0;
    }

    // Consumes the first remaining byte of the current multi-character operator as its own token,
    // leaving the rest in place; used to close or open nested generics lexed greedily as '>>',
    // '>>>', '>>=', '>>>=', or '<<'. The first piece keeps the leading trivia, the last piece
    // (consumed later by bump) keeps the trailing trivia, middle pieces get none.
    bumpSplit(SyntaxKind pieceKind) {
        let token = this.tokens[this.position];
        this.pushTokenEvent(pieceKind, this.position, this.splitOffset, 1,
                            this.splitOffset == 0, false);
        this.splitOffset++;
        this.lastContentEnd = token.offset + this.splitOffset;
    }

    // The end-of-file token carries the file's trailing trivia; parseSourceFile emits it into the
    // eof slot without advancing.
    emitEndOfFile() {
        let token = this.tokens[this.position];
        this.pushTokenEvent(SyntaxKind.EndOfFile, this.position, 0, token.length, true, true);
    }

    // ============================================================ diagnostics

    report(string message, Span span) {
        this.diagnostics.push(new Diagnostic(message, span));
    }

    reportAtCurrent(string message) {
        let token = this.tokens[this.position];
        let start = token.offset + this.splitOffset;
        this.report(message, source.makeSpan(start, token.end() - start));
    }

    // A zero-length Missing token at the end of the previous token's content, with a diagnostic
    // anchored there, recorded as a guess unless the token was a separator carrying no meaning.
    missing(SyntaxKind expected, string message) {
        this.pushMissingToken();
        if (!recovery.missingCostsNothing(expected)) {
            this.recovered(recovery.scopeForMissing(expected));
        }
        this.report(message, source.makeSpan(this.lastContentEnd, 0));
    }

    // A Missing token the parser puts in a slot the source was never going to fill, with the
    // diagnostic reported by the caller: nothing is consumed, so the guess reaches no further than
    // the construct being built.
    missingInPlace() {
        this.pushMissingToken();
        this.recovered(RecoveryScope.Construct);
    }

    pushMissingToken() {
        this.pushTokenEvent(SyntaxKind.Missing, -1, 0, 0, false, false);
    }

    recovered(RecoveryScope scope) {
        this.recoveries.push(new Recovery(source.makeSpan(this.lastContentEnd, 0), scope));
    }

    expect(SyntaxKind kind, string message) {
        if (this.at(kind)) {
            this.bump();
        } else {
            this.missing(kind, message);
        }
    }

    // ============================================================ speculation

    mark() -> ParserMark {
        return {
            position: this.position,
            splitOffset: this.splitOffset,
            lastContentEnd: this.lastContentEnd,
            eventCount: this.events.count(),
            diagnosticCount: this.diagnostics.count(),
            recoveryCount: this.recoveries.count(),
        };
    }

    rewind(ParserMark restore) {
        this.position = restore.position;
        this.splitOffset = restore.splitOffset;
        this.lastContentEnd = restore.lastContentEnd;
        this.events.truncate(restore.eventCount);
        this.diagnostics.truncate(restore.diagnosticCount);
        this.recoveries.truncate(restore.recoveryCount);
    }

    // A speculative parse succeeded when it neither reported nor guessed anything since the mark.
    // Every guess is reported today, so the second test is redundant and kept anyway: a guess that
    // stopped reporting would otherwise let a speculation look clean while leaving an invented
    // token in the tree it kept.
    clean(ParserMark restore) -> bool {
        return this.diagnostics.count() == restore.diagnosticCount
            && this.recoveries.count() == restore.recoveryCount;
    }

    // ============================================================ angle brackets

    atClosingAngle() -> bool {
        return switch (this.currentKind()) {
            Greater, GreaterGreater, GreaterGreaterGreater, GreaterEquals, GreaterGreaterEquals,
            GreaterGreaterGreaterEquals -> true,
            default -> false,
        };
    }

    expectClosingAngle(string message) {
        switch (this.currentKind()) {
            Greater -> this.bump(),
            GreaterGreater, GreaterGreaterGreater, GreaterEquals, GreaterGreaterEquals,
            GreaterGreaterGreaterEquals -> this.bumpSplit(SyntaxKind.Greater),
            default -> this.missing(SyntaxKind.Greater, message),
        }
    }

    expectOpeningAngle(string message) {
        switch (this.currentKind()) {
            Less -> this.bump(),
            LessLess, LessLessEquals -> this.bumpSplit(SyntaxKind.Less),
            default -> this.missing(SyntaxKind.Less, message),
        }
    }

    // ============================================================ top level

    parseTopLevelItem() {
        if (this.at(SyntaxKind.ImportKeyword)) {
            this.parseImportDeclaration();
            return;
        }
        if (this.at(SyntaxKind.ExternalKeyword)) {
            this.parseExternalDeclaration();
            return;
        }
        bool testStart = this.peekKind(1) == SyntaxKind.StringLiteral
            || this.peekKind(1) == SyntaxKind.InterpolatedStringStart;
        if (testStart && this.atContextual("test")) {
            this.parseTestDeclaration();
            return;
        }
        long modifierCount = 0;
        while (isModifier(this.peekKind(modifierCount))) {
            modifierCount++;
        }
        let afterModifiers = this.peekKind(modifierCount);
        if (afterModifiers == SyntaxKind.StructKeyword) {
            this.parseTypeDeclaration(SyntaxKind.StructDeclaration);
            return;
        }
        if (afterModifiers == SyntaxKind.ClassKeyword) {
            this.parseTypeDeclaration(SyntaxKind.ClassDeclaration);
            return;
        }
        if (afterModifiers == SyntaxKind.InterfaceKeyword) {
            this.parseInterfaceDeclaration();
            return;
        }
        if (afterModifiers == SyntaxKind.EnumKeyword) {
            this.parseEnumDeclaration();
            return;
        }
        if (afterModifiers == SyntaxKind.ExternalKeyword) {
            this.parseExternalDeclaration();
            return;
        }
        if (modifierCount > 0 && this.peekIsContextual(modifierCount, "test")
                && (this.peekKind(modifierCount + 1) == SyntaxKind.StringLiteral
                    || this.peekKind(modifierCount + 1) == SyntaxKind.InterpolatedStringStart)) {
            this.parseTopLevelError("A test cannot have modifiers such as 'noreturn'; write "
                + "'test' at the start of the line");
            return;
        }
        if (this.looksLikeFunctionDeclaration(false)) {
            this.parseFunctionDeclaration(asMethod: false);
            return;
        }
        if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)
                || this.atTypedVariableDeclaration()) {
            this.parseTopLevelError(this.topLevelVariableMessage());
            return;
        }
        if (this.at(SyntaxKind.FinallyKeyword)) {
            this.parseTopLevelError("'finally' is not supported; write the cleanup before each "
                + "return or in the catch clause");
            return;
        }
        this.parseTopLevelError("Expected a top-level declaration such as a function, "
            + "class, struct, interface, enum, import, or test");
    }

    // ============================================================ manifests

    parseManifestDeclaration() {
        if (this.at(SyntaxKind.PackageKeyword)) {
            this.parsePackageDeclaration();
            return;
        }
        if (this.atContextual("workspace")) {
            this.parseWorkspaceDeclaration();
            return;
        }
        if (this.atContextual("overrides")) {
            this.parseOverridesDeclaration();
            return;
        }
        this.parseManifestDeclarationError();
    }

    atManifestDeclarationStart() -> bool {
        return this.at(SyntaxKind.PackageKeyword) || this.atContextual("workspace")
            || this.atContextual("overrides");
    }

    parsePackageDeclaration() {
        let marker = this.start();
        this.bump();
        this.parsePackagePath("Expected the package name after 'package', for example "
            + "'package acme.tools'");
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the package declaration");
        let items = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parsePackageItem();
        }
        this.complete(items, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the package declaration");
        this.complete(marker, SyntaxKind.PackageDeclaration);
    }

    parseWorkspaceDeclaration() {
        let marker = this.start();
        this.bumpAs(SyntaxKind.WorkspaceKeyword);
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the workspace declaration");
        let items = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseWorkspaceItem();
        }
        this.complete(items, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the workspace declaration");
        this.complete(marker, SyntaxKind.WorkspaceDeclaration);
    }

    parseOverridesDeclaration() {
        let marker = this.start();
        this.bumpAs(SyntaxKind.OverridesKeyword);
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the overrides declaration");
        let items = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseOverridesItem();
        }
        this.complete(items, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the overrides declaration");
        this.complete(marker, SyntaxKind.OverridesDeclaration);
    }

    parsePackagePath(string missingMessage) {
        let marker = this.start();
        let segments = this.start();
        this.expect(SyntaxKind.Identifier, missingMessage);
        while (this.at(SyntaxKind.Dot) && this.peekKind(1) == SyntaxKind.Identifier) {
            this.bump();
            this.bump();
        }
        this.complete(segments, SyntaxKind.List);
        this.complete(marker, SyntaxKind.PackagePath);
    }

    parsePackageItem() {
        if (this.atContextual("version")) {
            this.parseManifestValueItem(SyntaxKind.VersionKeyword, SyntaxKind.VersionDeclaration,
                "Expected the package version as a string, for example 'version \"1.3.0\";'",
                "Expected ';' after the version declaration");
            return;
        }
        if (this.atContextual("ens")) {
            this.parseManifestValueItem(SyntaxKind.EnsKeyword, SyntaxKind.EnsDeclaration,
                "Expected the language version as a string, for example 'ens \"1.2\";'",
                "Expected ';' after the ens declaration");
            return;
        }
        if (this.atContextual("dependency")) {
            this.parseDependencyDeclaration();
            return;
        }
        if (this.atContextual("native")) {
            this.parseNativeDeclaration();
            return;
        }
        this.parseManifestItemError(SyntaxKind.ErrorPackageItem, "Expected a package item: "
            + "'version', 'ens', 'dependency', or 'native'");
    }

    parseManifestValueItem(SyntaxKind keywordKind, SyntaxKind nodeKind, string valueMessage,
                           string semicolonMessage) {
        let marker = this.start();
        this.bumpAs(keywordKind);
        this.expect(SyntaxKind.StringLiteral, valueMessage);
        this.expect(SyntaxKind.Semicolon, semicolonMessage);
        this.complete(marker, nodeKind);
    }

    parseDependencyDeclaration() {
        let marker = this.start();
        this.bumpAs(SyntaxKind.DependencyKeyword);
        this.parsePackagePath("Expected the dependency's package name, for example "
            + "'dependency acme.json;'");
        if (this.at(SyntaxKind.StringLiteral)) {
            this.bump();
        } else {
            this.nullSlot();
        }
        if (this.atContextual("from")) {
            let source = this.start();
            this.bumpAs(SyntaxKind.FromKeyword);
            this.expect(SyntaxKind.StringLiteral, "Expected the package's git URL as a string "
                + "after 'from', for example 'dependency acme.json \"2.0\" from "
                + "\"https://github.com/acme/json.git\";'");
            this.complete(source, SyntaxKind.FromClause);
        } else {
            this.nullSlot();
        }
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the dependency declaration");
        this.complete(marker, SyntaxKind.DependencyDeclaration);
    }

    parseNativeDeclaration() {
        let marker = this.start();
        this.bumpAs(SyntaxKind.NativeKeyword);
        this.expect(SyntaxKind.Identifier, "Expected the native library's name, for example "
            + "'native zlib;'");
        if (this.atContextual("system")) {
            this.bumpAs(SyntaxKind.SystemKeyword);
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.OpenBrace)) {
            this.parseNativeBindingList();
            this.nullSlot();
        } else {
            this.nullSlot();
            this.expect(SyntaxKind.Semicolon, "Expected ';' or a '\{ ... \}' binding block "
                + "after the native library's name");
        }
        this.complete(marker, SyntaxKind.NativeDeclaration);
    }

    parseNativeBindingList() {
        let marker = this.start();
        this.bump();
        let bindings = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseNativeBinding();
        }
        this.complete(bindings, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the binding block");
        this.complete(marker, SyntaxKind.NativeBindingList);
    }

    parseNativeBinding() {
        if (!this.at(SyntaxKind.Identifier)) {
            this.parseManifestItemError(SyntaxKind.ErrorNativeBinding, "Expected a platform "
                + "binding, for example 'windows \"LLVM-C\";'");
            return;
        }
        if (this.peekIsContextual(1, "artifact")) {
            let marker = this.start();
            this.bump();
            this.bumpAs(SyntaxKind.ArtifactKeyword);
            this.expect(SyntaxKind.StringLiteral, "Expected the artifact URL as a string");
            if (this.atContextual("hash")) {
                this.bumpAs(SyntaxKind.HashKeyword);
            } else {
                this.missing(SyntaxKind.HashKeyword,
                    "Expected 'hash' and the artifact's checksum after the URL");
            }
            this.expect(SyntaxKind.StringLiteral, "Expected the artifact's checksum as a "
                + "string, for example 'hash \"sha256:...\"'");
            this.expect(SyntaxKind.Semicolon, "Expected ';' after the artifact binding");
            this.complete(marker, SyntaxKind.NativeArtifactBinding);
            return;
        }
        let marker = this.start();
        this.bump();
        let names = this.start();
        this.expect(SyntaxKind.StringLiteral, "Expected at least one library base name as a "
            + "string, for example 'windows \"LLVM-C\";'");
        while (this.at(SyntaxKind.StringLiteral)) {
            this.bump();
        }
        this.complete(names, SyntaxKind.List);
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the platform binding");
        this.complete(marker, SyntaxKind.NativeLibraryBinding);
    }

    parseWorkspaceItem() {
        if (this.atContextual("member")) {
            let marker = this.start();
            this.bumpAs(SyntaxKind.MemberKeyword);
            this.expect(SyntaxKind.StringLiteral, "Expected the member's folder as a string, "
                + "for example 'member \"frontend\";'");
            this.expect(SyntaxKind.Semicolon, "Expected ';' after the member declaration");
            this.complete(marker, SyntaxKind.MemberDeclaration);
            return;
        }
        this.parseManifestItemError(SyntaxKind.ErrorWorkspaceItem, "Expected a member "
            + "declaration, for example 'member \"frontend\";'");
    }

    parseOverridesItem() {
        if (this.at(SyntaxKind.OverrideKeyword)) {
            let marker = this.start();
            this.bump();
            this.parsePackagePath("Expected the overridden package's name after 'override'");
            this.expect(SyntaxKind.StringLiteral, "Expected the replacement folder as a "
                + "string, for example 'override alex.library \"../library\";'");
            this.expect(SyntaxKind.Semicolon, "Expected ';' after the override declaration");
            this.complete(marker, SyntaxKind.OverrideDeclaration);
            return;
        }
        this.parseManifestItemError(SyntaxKind.ErrorOverridesItem, "Expected an override "
            + "declaration, for example 'override alex.library \"../library\";'");
    }

    // Recovery inside a manifest block: wraps the junk in the block's error kind. A ';' ends the
    // junk and is consumed into it, a braced region is skipped whole, and a '\}' ends it
    // unconsumed so the enclosing block can close.
    parseManifestItemError(SyntaxKind errorKind, string message) {
        this.reportAtCurrent(message);
        let marker = this.start();
        let skipped = this.start();
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseBrace) {
                break;
            }
            if (kind == SyntaxKind.Semicolon) {
                this.bump();
                break;
            }
            if (kind == SyntaxKind.OpenBrace) {
                this.bumpBalancedBraces();
                break;
            }
            this.bump();
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, errorKind);
    }

    // Recovery at the top of a manifest: skips to the next declaration keyword, taking braced
    // regions whole.
    parseManifestDeclarationError() {
        this.reportAtCurrent("Expected 'package', 'workspace', or 'overrides' to begin the "
            + "manifest declaration");
        let marker = this.start();
        let skipped = this.start();
        bool first = true;
        while (!this.atEnd()) {
            if (!first && this.atManifestDeclarationStart()) {
                break;
            }
            if (this.currentKind() == SyntaxKind.OpenBrace) {
                this.bumpBalancedBraces();
                break;
            }
            this.bump();
            first = false;
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorManifestDeclaration);
    }

    // ============================================================ declarations

    parseImportDeclaration() {
        let marker = this.start();
        this.bump();
        if (this.at(SyntaxKind.Identifier) && this.peekIsContextual(1, "from")) {
            let binding = this.start();
            this.bump();
            this.bumpAs(SyntaxKind.FromKeyword);
            this.complete(binding, SyntaxKind.ImportBinding);
        } else {
            this.nullSlot();
        }
        let path = this.start();
        if (this.at(SyntaxKind.At)) {
            this.bump();
        } else {
            this.nullSlot();
        }
        let segments = this.start();
        this.expect(SyntaxKind.Identifier,
            "Expected the import path, for example 'import engine.renderer;'");
        while (this.at(SyntaxKind.Dot) && this.peekKind(1) == SyntaxKind.Identifier) {
            this.bump();
            this.bump();
        }
        this.complete(segments, SyntaxKind.List);
        this.complete(path, SyntaxKind.ImportPath);
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the import path");
        this.complete(marker, SyntaxKind.ImportDeclaration);
    }

    parseExternalDeclaration() {
        long modifierCount = 0;
        while (isModifier(this.peekKind(modifierCount))) {
            modifierCount++;
        }
        // The type form may carry a visibility modifier; the block form stays file-private.
        if (this.peekIsContextual(modifierCount + 1, "type")) {
            let marker = this.start();
            this.parseModifierList();
            this.bump();
            this.bumpAs(SyntaxKind.TypeKeyword);
            this.expect(SyntaxKind.Identifier,
                "Expected the external type's name, for example 'external type HANDLE;'");
            this.expect(SyntaxKind.Semicolon, "Expected ';' after the external type declaration");
            this.complete(marker, SyntaxKind.ExternalTypeDeclaration);
            return;
        }
        if (modifierCount > 0) {
            this.parseTopLevelError("An external function block is always private to its file and "
                + "cannot carry a visibility modifier; wrap its calls in Ens functions to share "
                + "them");
            return;
        }
        let marker = this.start();
        this.bump();
        if (this.atContextual("from")) {
            this.bumpAs(SyntaxKind.FromKeyword);
        } else {
            this.missing(SyntaxKind.FromKeyword, "Expected 'from' after 'external', for example "
                + "'external from libc \{ ... \}'");
        }
        this.expect(SyntaxKind.Identifier, "Expected the native library's name after 'from', "
            + "for example 'external from libc \{ ... \}'");
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the external block");
        let functions = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            if (this.at(SyntaxKind.Identifier)) {
                this.parseExternalFunctionDeclaration();
            } else {
                this.parseMemberError("Expected an external function signature, for example "
                    + "'CloseHandle(HANDLE h) -> int;'");
            }
        }
        this.complete(functions, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the external block");
        this.complete(marker, SyntaxKind.ExternalBlock);
    }

    parseExternalFunctionDeclaration() {
        let marker = this.start();
        this.bump();
        this.parseParameterList();
        if (this.at(SyntaxKind.Arrow)) {
            let returnType = this.start();
            this.bump();
            this.parseType("Expected the return type after '->'");
            this.complete(returnType, SyntaxKind.ReturnTypeClause);
        } else {
            this.nullSlot();
        }
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the external function declaration");
        this.complete(marker, SyntaxKind.ExternalFunctionDeclaration);
    }

    parseTestDeclaration() {
        let marker = this.start();
        this.bumpAs(SyntaxKind.TestKeyword);
        if (this.at(SyntaxKind.StringLiteral)) {
            this.bump();
        } else if (this.at(SyntaxKind.InterpolatedStringStart)) {
            this.parseInterpolatedString();
        } else {
            this.missing(SyntaxKind.StringLiteral,
                "Expected the test description string, for example "
                + "'test \"adds numbers\" \{ ... \}'");
        }
        this.parseBlockOrMissing("Expected '\{' for the test body");
        this.complete(marker, SyntaxKind.TestDeclaration);
    }

    parseFunctionDeclaration(bool asMethod) {
        string what = "function";
        if (asMethod) {
            what = "method";
        }
        let marker = this.start();
        this.parseModifierList();
        if (this.at(SyntaxKind.ConstructorKeyword) || this.at(SyntaxKind.DestructorKeyword)) {
            this.bump();
            this.nullSlot();
        } else {
            this.nullSlot();
            if (kind.isKeyword(this.currentKind())) {
                this.reportAtCurrent("'{this.currentText()}' is a keyword and cannot be used as a "
                    + "{what} name; choose a different name");
                this.bumpAs(SyntaxKind.Identifier);
            } else {
                this.expect(SyntaxKind.Identifier, "Expected the {what}'s name");
            }
        }
        if (this.at(SyntaxKind.Less)) {
            this.parseTypeParameterList();
        } else {
            this.nullSlot();
        }
        this.parseParameterList();
        if (this.at(SyntaxKind.Arrow)) {
            let returnType = this.start();
            this.bump();
            this.parseType("Expected the return type after '->', for example '-> int'");
            this.complete(returnType, SyntaxKind.ReturnTypeClause);
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.ThrowsKeyword)) {
            this.parseThrowsClause();
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.OpenBrace)) {
            this.parseBlock();
            this.nullSlot();
        } else if (this.at(SyntaxKind.Semicolon)) {
            this.nullSlot();
            this.bump();
        } else {
            this.nullSlot();
            this.missing(SyntaxKind.OpenBrace,
                "Expected '\{' to begin the {what} body, or ';' for a bodiless declaration");
        }
        let catches = this.start();
        while (this.at(SyntaxKind.CatchKeyword)) {
            this.parseCatchClause();
        }
        this.complete(catches, SyntaxKind.List);
        this.complete(marker, SyntaxKind.FunctionDeclaration);
    }

    parseModifierList() {
        let modifiers = this.start();
        while (isModifier(this.currentKind())) {
            this.bump();
        }
        this.complete(modifiers, SyntaxKind.List);
    }

    parseParameterList() {
        let marker = this.start();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' to begin the parameter list");
        let parameters = this.start();
        bool needSeparator = false;
        while (!this.at(SyntaxKind.CloseParenthesis) && !this.at(SyntaxKind.OpenBrace)
                && !this.at(SyntaxKind.Semicolon) && !this.atEnd()) {
            if (needSeparator) {
                if (this.at(SyntaxKind.Comma)) {
                    this.bump();
                    if (this.at(SyntaxKind.CloseParenthesis)) {
                        this.report("Expected a parameter after ','",
                            source.makeSpan(this.lastContentEnd, 0));
                        break;
                    }
                } else {
                    this.missing(SyntaxKind.Comma, "Expected ',' between parameters");
                }
            }
            if (this.atParameterStart()) {
                this.parseParameter();
            } else {
                this.parseParameterError();
            }
            needSeparator = true;
        }
        this.complete(parameters, SyntaxKind.List);
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' to close the parameter list");
        this.complete(marker, SyntaxKind.ParameterList);
    }

    atParameterStart() -> bool {
        return this.at(SyntaxKind.ThisKeyword) || isTypeStart(this.currentKind());
    }

    parseParameter() {
        let marker = this.start();
        if (this.at(SyntaxKind.ThisKeyword)) {
            this.nullSlot();
            this.nullSlot();
            let prefix = this.start();
            this.bump();
            this.expect(SyntaxKind.Dot, "Expected '.' after 'this' in the parameter, for "
                + "example 'constructor(this.x);'");
            this.complete(prefix, SyntaxKind.ThisPrefix);
            this.expect(SyntaxKind.Identifier, "Expected the field name after 'this.'");
        } else {
            if (this.atContextual("out") && isTypeStart(this.peekKind(1))) {
                this.bumpAs(SyntaxKind.OutKeyword);
            } else {
                this.nullSlot();
            }
            this.parseType("Expected the parameter's type, for example 'int value'");
            this.nullSlot();
            if (kind.isKeyword(this.currentKind())) {
                this.reportAtCurrent("'{this.currentText()}' is a keyword and cannot be used as "
                    + "a parameter name; choose a different name such as 'value'");
                this.bumpAs(SyntaxKind.Identifier);
            } else {
                this.expect(SyntaxKind.Identifier,
                    "Expected the parameter's name, for example 'int value'");
            }
        }
        if (this.at(SyntaxKind.Equals)) {
            this.parseInitializer();
        } else {
            this.nullSlot();
        }
        this.complete(marker, SyntaxKind.Parameter);
    }

    // Junk in a parameter list; stops before ',' or the next parameter so the list loop stays in
    // charge, and before ')', '\{', or ';' so the declaration can continue.
    parseParameterError() {
        this.reportAtCurrent("Expected a parameter, for example 'int value'");
        let marker = this.start();
        let skipped = this.start();
        bool first = true;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseParenthesis || kind == SyntaxKind.OpenBrace
                    || kind == SyntaxKind.Semicolon) {
                break;
            }
            if (!first && (kind == SyntaxKind.Comma || this.atParameterStart())) {
                break;
            }
            this.bump();
            first = false;
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorDeclaration);
    }

    parseThrowsClause() {
        let marker = this.start();
        this.bump();
        let types = this.start();
        if (isTypeStart(this.currentKind())) {
            this.parseNamedType("Expected an error type after 'throws'");
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                this.parseNamedType("Expected an error type after ','");
            }
        }
        this.complete(types, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ThrowsClause);
    }

    parseCatchClause() {
        let marker = this.start();
        this.bump();
        this.expect(SyntaxKind.OpenParenthesis,
            "Expected '(' after 'catch', for example 'catch (IOError e)'");
        this.parseNamedType(
            "Expected the error type in the catch clause, for example 'catch (IOError e)'");
        this.expect(SyntaxKind.Identifier,
            "Expected a name for the caught error, for example 'catch (IOError e)'");
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the catch binding");
        this.parseBlockOrMissing("Expected '\{' for the catch body");
        this.complete(marker, SyntaxKind.CatchClause);
    }

    parseTypeDeclaration(SyntaxKind declarationKind) {
        let marker = this.start();
        this.parseModifierList();
        this.bump();
        this.expect(SyntaxKind.Identifier, "Expected the type's name");
        if (this.at(SyntaxKind.Less)) {
            this.parseTypeParameterList();
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.ExtendsKeyword)) {
            let extendsClause = this.start();
            this.bump();
            this.parseNamedType("Expected the base class name after 'extends'");
            this.complete(extendsClause, SyntaxKind.ExtendsClause);
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.ImplementsKeyword)) {
            let implementsClause = this.start();
            this.bump();
            let interfaces = this.start();
            this.parseNamedType("Expected an interface name after 'implements'");
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                this.parseNamedType("Expected an interface name after ','");
            }
            this.complete(interfaces, SyntaxKind.List);
            this.complete(implementsClause, SyntaxKind.ImplementsClause);
        } else {
            this.nullSlot();
        }
        this.parseMemberList(false);
        this.complete(marker, declarationKind);
    }

    parseInterfaceDeclaration() {
        let marker = this.start();
        this.parseModifierList();
        this.bump();
        this.expect(SyntaxKind.Identifier, "Expected the interface's name");
        if (this.at(SyntaxKind.Less)) {
            this.parseTypeParameterList();
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.ExtendsKeyword)) {
            let extendsClause = this.start();
            this.bump();
            this.parseNamedType("Expected the interface name after 'extends'");
            this.complete(extendsClause, SyntaxKind.ExtendsClause);
        } else {
            this.nullSlot();
        }
        if (this.at(SyntaxKind.ImplementsKeyword)) {
            this.reportAtCurrent("An interface cannot use 'implements'; an interface builds on "
                + "another one with 'extends', and classes implement interfaces");
            this.parseMemberList(true);
        } else {
            this.parseMemberList(false);
        }
        this.complete(marker, SyntaxKind.InterfaceDeclaration);
    }

    // withLeadingJunk handles clauses that have no slot (an interface's stray 'implements ...'):
    // the open brace slot becomes a Missing token, and the junk up to and including the real '\{'
    // lands in an ErrorDeclaration at the head of the member list, keeping source order intact.
    parseMemberList(bool withLeadingJunk) {
        let marker = this.start();
        if (withLeadingJunk) {
            this.missingInPlace();
        } else {
            this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the body");
        }
        let members = this.start();
        if (withLeadingJunk) {
            let junk = this.start();
            let skipped = this.start();
            while (!this.atEnd() && !this.at(SyntaxKind.CloseBrace)) {
                if (this.at(SyntaxKind.OpenBrace)) {
                    this.bump();
                    break;
                }
                this.bump();
            }
            this.complete(skipped, SyntaxKind.List);
            this.complete(junk, SyntaxKind.ErrorDeclaration);
        }
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseMember();
        }
        this.complete(members, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the body");
        this.complete(marker, SyntaxKind.MemberList);
    }

    parseMember() {
        if (this.at(SyntaxKind.FinallyKeyword)) {
            this.parseMemberError("'finally' is not supported; write the cleanup before each "
                + "return or in the catch clause");
            return;
        }
        if (this.looksLikeFunctionDeclaration(true) || this.looksLikeKeywordNamedMethod()) {
            this.parseFunctionDeclaration(asMethod: true);
            return;
        }
        long modifierCount = 0;
        while (isModifier(this.peekKind(modifierCount))) {
            modifierCount++;
        }
        if (isTypeStart(this.peekKind(modifierCount))) {
            this.parseFieldDeclaration();
            return;
        }
        this.parseMemberError("Expected a field or a method declaration");
    }

    parseFieldDeclaration() {
        let marker = this.start();
        this.parseModifierList();
        this.parseType("Expected the field's type");
        this.expect(SyntaxKind.Identifier, "Expected the field's name");
        if (this.at(SyntaxKind.Equals)) {
            this.parseInitializer();
        } else {
            this.nullSlot();
        }
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the field declaration");
        this.complete(marker, SyntaxKind.FieldDeclaration);
    }

    // Junk in a member list: a ';' ends it and is consumed, a braced region is skipped whole so a
    // stray body cannot end the enclosing type early, and '\}' ends it unconsumed.
    parseMemberError(string message) {
        this.reportAtCurrent(message);
        let marker = this.start();
        let skipped = this.start();
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseBrace) {
                break;
            }
            if (kind == SyntaxKind.Semicolon) {
                this.bump();
                break;
            }
            if (kind == SyntaxKind.OpenBrace) {
                this.bumpBalancedBraces();
                break;
            }
            this.bump();
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorDeclaration);
    }

    parseEnumDeclaration() {
        let marker = this.start();
        this.parseModifierList();
        this.bump();
        this.expect(SyntaxKind.Identifier, "Expected the enum's name");
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the enum members");
        let members = this.start();
        bool needSeparator = false;
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            if (needSeparator) {
                if (this.at(SyntaxKind.Comma)) {
                    this.bump();
                } else {
                    this.missing(SyntaxKind.Comma, "Expected ',' after the enum member");
                }
                if (this.at(SyntaxKind.CloseBrace)) {
                    break;
                }
            }
            if (this.at(SyntaxKind.Identifier)) {
                let member = this.start();
                this.bump();
                if (this.at(SyntaxKind.Equals)) {
                    this.parseInitializer();
                } else {
                    this.nullSlot();
                }
                this.complete(member, SyntaxKind.EnumMember);
                needSeparator = true;
            } else {
                this.parseEnumMemberError();
                needSeparator = false;
            }
        }
        this.complete(members, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the enum");
        this.complete(marker, SyntaxKind.EnumDeclaration);
    }

    parseEnumMemberError() {
        this.reportAtCurrent("Expected an enum member name");
        let marker = this.start();
        let skipped = this.start();
        bool first = true;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseBrace) {
                break;
            }
            if (!first && (kind == SyntaxKind.Comma || kind == SyntaxKind.Identifier)) {
                break;
            }
            this.bump();
            first = false;
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorDeclaration);
    }

    parseTypeParameterList() {
        let marker = this.start();
        this.expectOpeningAngle("Expected '<' to begin the type parameters");
        let parameters = this.start();
        if (!this.atClosingAngle() && !this.atEnd()) {
            this.parseTypeParameter();
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                if (this.atClosingAngle()) {
                    break;
                }
                this.parseTypeParameter();
            }
        }
        this.complete(parameters, SyntaxKind.List);
        this.expectClosingAngle("Expected '>' to close the type parameters");
        this.complete(marker, SyntaxKind.TypeParameterList);
    }

    parseTypeParameter() {
        let marker = this.start();
        this.expect(SyntaxKind.Identifier, "Expected the type parameter's name, for example "
            + "'<T>'");
        if (this.at(SyntaxKind.Colon)) {
            let bounds = this.start();
            this.bump();
            let list = this.start();
            this.parseNamedType("Expected a bound after ':', for example '<T: Shape>'");
            while (this.at(SyntaxKind.Plus)) {
                this.bump();
                this.parseNamedType("Expected a bound after '+'");
            }
            this.complete(list, SyntaxKind.List);
            this.complete(bounds, SyntaxKind.BoundsClause);
        } else {
            this.nullSlot();
        }
        this.complete(marker, SyntaxKind.TypeParameter);
    }

    // True at `Modifier* Identifier TypeParameterList? ( ... )` followed by '->', '\{', 'throws',
    // or (for members) ';'. Speculative; everything is rewound.
    looksLikeFunctionDeclaration(bool allowBodiless) -> bool {
        let restore = this.mark();
        while (isModifier(this.currentKind())) {
            this.bump();
        }
        bool result = false;
        if (this.at(SyntaxKind.Identifier)) {
            this.bump();
            bool headerOk = true;
            if (this.at(SyntaxKind.Less)) {
                this.parseTypeParameterList();
                headerOk = this.clean(restore);
            }
            if (headerOk && this.at(SyntaxKind.OpenParenthesis)
                    && this.skipBalancedParentheses()) {
                let after = this.currentKind();
                result = after == SyntaxKind.Arrow || after == SyntaxKind.OpenBrace
                    || after == SyntaxKind.ThrowsKeyword
                    || (allowBodiless && after == SyntaxKind.Semicolon);
            }
        }
        this.rewind(restore);
        return result;
    }

    // A reserved word in a member-name position followed by '(' parses as a method so one bad
    // name does not cascade through the member list; parseFunctionDeclaration reports it.
    looksLikeKeywordNamedMethod() -> bool {
        let restore = this.mark();
        while (isModifier(this.currentKind())) {
            this.bump();
        }
        bool result = false;
        if (kind.isKeyword(this.currentKind())) {
            this.bump();
            result = this.at(SyntaxKind.OpenParenthesis);
        }
        this.rewind(restore);
        return result;
    }

    // At '('; consumes through the matching ')'. False when the file ends first.
    skipBalancedParentheses() -> bool {
        long depth = 0;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.OpenParenthesis) {
                depth++;
            } else if (kind == SyntaxKind.CloseParenthesis) {
                depth--;
            }
            this.bump();
            if (depth == 0) {
                return true;
            }
        }
        return false;
    }

    // Recovery at the top level: wraps the junk in an ErrorDeclaration. A ';' ends the junk and
    // is consumed into it; a braced region is skipped whole so a stray block cannot derail the
    // items after it; declaration-starting keywords end the junk without being consumed.
    parseTopLevelError(string message) {
        this.reportAtCurrent(message);
        let marker = this.start();
        let skipped = this.start();
        bool first = true;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (!first && atTopLevelDeclarationStart(kind)) {
                break;
            }
            if (kind == SyntaxKind.Semicolon) {
                this.bump();
                break;
            }
            if (kind == SyntaxKind.OpenBrace) {
                this.bumpBalancedBraces();
                break;
            }
            this.bump();
            first = false;
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorDeclaration);
    }

    bumpBalancedBraces() {
        long depth = 0;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.OpenBrace) {
                depth++;
            } else if (kind == SyntaxKind.CloseBrace) {
                depth--;
            }
            this.bump();
            if (depth == 0) {
                return;
            }
        }
    }

    // ============================================================ statements

    parseStatement() {
        switch (this.currentKind()) {
            OpenBrace -> this.parseBlock(),
            LetKeyword, ConstKeyword -> this.parseVariableDeclaration(),
            IfKeyword -> this.parseIfStatement(),
            WhileKeyword -> this.parseWhileStatement(),
            ForKeyword -> this.parseForStatement(),
            SwitchKeyword -> this.parseSwitchStatement(),
            BreakKeyword -> this.parseKeywordStatement(SyntaxKind.BreakStatement,
                "Expected ';' after 'break'"),
            ContinueKeyword -> this.parseKeywordStatement(SyntaxKind.ContinueStatement,
                "Expected ';' after 'continue'"),
            RethrowKeyword -> this.parseKeywordStatement(SyntaxKind.RethrowStatement,
                "Expected ';' after 'rethrow'"),
            ReturnKeyword -> this.parseReturnStatement(),
            ThrowKeyword -> this.parseThrowStatement(),
            CatchKeyword -> this.parseStatementError(
                "A 'catch' block can only follow a function body's closing '}'"),
            FinallyKeyword -> this.parseStatementError("'finally' is not supported; write the "
                + "cleanup before each return or in the catch clause"),
            default -> {
                if (this.atTypedVariableDeclaration()) {
                    this.parseVariableDeclaration();
                } else if (canStartExpression(this.currentKind())) {
                    this.parseExpressionStatement();
                } else {
                    this.parseStatementError("Expected a statement, for example an assignment, "
                        + "a call, or a declaration like 'let count = 0;'");
                }
            },
        }
    }

    parseBlock() {
        let marker = this.start();
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the block");
        let statements = this.start();
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseStatement();
        }
        this.complete(statements, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the block");
        this.complete(marker, SyntaxKind.Block);
    }

    // For a required Block slot when no '{' is present: an empty Block with missing braces keeps
    // the typed accessors total, and the single diagnostic explains what was expected. The block is
    // zero-width and nothing is consumed, so the pair of braces is one guess reaching no further
    // than the statement being built.
    parseBlockOrMissing(string message) {
        if (this.at(SyntaxKind.OpenBrace)) {
            this.parseBlock();
            return;
        }
        this.report(message, source.makeSpan(this.lastContentEnd, 0));
        let marker = this.start();
        this.missingInPlace();
        let statements = this.start();
        this.complete(statements, SyntaxKind.List);
        this.pushMissingToken();
        this.complete(marker, SyntaxKind.Block);
    }

    // Recovery inside blocks: wraps the junk in an ErrorStatement; a ';' ends the junk and is
    // consumed into it, and a '}' ends it unconsumed so the enclosing block can close.
    parseStatementError(string message) {
        this.reportAtCurrent(message);
        let marker = this.start();
        let skipped = this.start();
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseBrace) {
                break;
            }
            if (kind == SyntaxKind.Semicolon) {
                this.bump();
                break;
            }
            this.bump();
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorStatement);
    }

    // True at `Type name = ...` or `Type name;`, the typed variable-declaration shape. The type
    // is parsed speculatively and always rewound; the caller re-parses it for real.
    atTypedVariableDeclaration() -> bool {
        if (!isTypeStart(this.currentKind())) {
            return false;
        }
        let restore = this.mark();
        this.parseType("");
        bool result = this.clean(restore) && this.at(SyntaxKind.Identifier);
        if (result) {
            let after = this.peekKind(1);
            result = after == SyntaxKind.Equals || after == SyntaxKind.Semicolon;
        }
        this.rewind(restore);
        return result;
    }

    // Nothing at file scope holds a value, so the message names the variable it read and says
    // where the value can live instead.
    topLevelVariableMessage() -> string {
        string name = this.declaredVariableName();
        string what = "the declaration";
        if (name.length > 0) {
            what = "'{name}'";
        }
        return "Variables cannot be declared at the top level; move {what} inside a function, or "
            + "expose the value through a function, for example 'pi() -> int \{ return 3; \}'";
    }

    // The name a variable declaration gives, read speculatively and always rewound, or "" when
    // the declaration is too broken to reach a name.
    declaredVariableName() -> string {
        let restore = this.mark();
        if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)) {
            this.bump();
        }
        bool bareName = this.at(SyntaxKind.Identifier)
            && (this.peekKind(1) == SyntaxKind.Equals || this.peekKind(1) == SyntaxKind.Semicolon);
        if (!bareName && isTypeStart(this.currentKind())) {
            this.parseType("");
        }
        string name = "";
        if (this.at(SyntaxKind.Identifier)) {
            name = this.currentText();
        }
        this.rewind(restore);
        return name;
    }

    // VariableDeclaration = modifier? declaredType? name initializer? ';'. Whether at least one
    // of modifier and declared type is present is checked semantically, not here.
    parseVariableDeclaration() {
        let marker = this.start();
        if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)) {
            this.bump();
        } else {
            this.nullSlot();
        }
        bool bareName = this.at(SyntaxKind.Identifier)
            && (this.peekKind(1) == SyntaxKind.Equals || this.peekKind(1) == SyntaxKind.Semicolon);
        if (bareName) {
            this.nullSlot();
            this.bump();
        } else if (isTypeStart(this.currentKind())) {
            this.parseType("Expected the variable's type");
            this.expect(SyntaxKind.Identifier,
                "Expected the variable's name after its type, for example 'int count = 0;'");
        } else {
            this.nullSlot();
            this.missing(SyntaxKind.Identifier,
                "Expected the variable's name, for example 'let count = 0;'");
        }
        if (this.at(SyntaxKind.Equals)) {
            this.parseInitializer();
        } else {
            this.nullSlot();
        }
        this.expect(SyntaxKind.Semicolon,
            "Expected ';' after the variable declaration, for example 'let count = 0;'");
        this.complete(marker, SyntaxKind.VariableDeclaration);
    }

    parseInitializer() {
        let marker = this.start();
        this.bump();
        this.parseExpression();
        this.complete(marker, SyntaxKind.Initializer);
    }

    parseIfStatement() {
        let marker = this.start();
        this.bump();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' before the if condition, for "
            + "example 'if (ready) \{ ... \}'");
        this.parseExpression();
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the if condition");
        this.parseBlockOrMissing("Expected '\{' for the if body; the branches of 'if' are always "
            + "blocks, for example 'if (ready) \{ start(); \}'");
        if (this.at(SyntaxKind.ElseKeyword)) {
            let elseMarker = this.start();
            this.bump();
            if (this.at(SyntaxKind.IfKeyword)) {
                this.parseIfStatement();
            } else {
                this.parseBlockOrMissing("Expected '\{' or another 'if' after 'else'");
            }
            this.complete(elseMarker, SyntaxKind.ElseClause);
        } else {
            this.nullSlot();
        }
        this.complete(marker, SyntaxKind.IfStatement);
    }

    parseWhileStatement() {
        let marker = this.start();
        this.bump();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' before the while condition, for "
            + "example 'while (running) \{ ... \}'");
        this.parseExpression();
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the while condition");
        this.parseBlockOrMissing("Expected '\{' for the loop body");
        this.complete(marker, SyntaxKind.WhileStatement);
    }

    parseForStatement() {
        let marker = this.start();
        this.bump();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' after 'for'");
        if (this.atForEachHeader()) {
            if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)) {
                this.bump();
            } else {
                this.nullSlot();
            }
            if (this.at(SyntaxKind.Identifier) && this.peekIsContextual(1, "in")) {
                this.nullSlot();
                this.bump();
            } else {
                this.parseType("Expected the loop variable's type or 'let'");
                this.expect(SyntaxKind.Identifier, "Expected the loop variable's name");
            }
            if (this.atContextual("in")) {
                this.bumpAs(SyntaxKind.InKeyword);
            } else {
                this.missing(SyntaxKind.InKeyword,
                    "Expected 'in' between the loop variable and the values, for example "
                    + "'for (let item in items)'");
            }
            this.parseExpression();
            this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the for-each header");
            this.parseBlockOrMissing("Expected '\{' for the loop body");
            this.complete(marker, SyntaxKind.ForEachStatement);
            return;
        }
        if (this.at(SyntaxKind.Semicolon)) {
            this.nullSlot();
            this.bump();
        } else {
            if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)
                    || this.atTypedVariableDeclaration()) {
                this.parseVariableDeclaration();
            } else {
                this.parseExpressionStatement();
            }
            this.nullSlot();
        }
        if (this.at(SyntaxKind.Semicolon) || !canStartExpression(this.currentKind())) {
            this.nullSlot();
        } else {
            this.parseExpression();
        }
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the for condition");
        if (this.at(SyntaxKind.CloseParenthesis) || !canStartExpression(this.currentKind())) {
            this.nullSlot();
        } else {
            this.parseExpression();
        }
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the for clauses");
        this.parseBlockOrMissing("Expected '\{' for the loop body");
        this.complete(marker, SyntaxKind.ForStatement);
    }

    // At the first token inside the for parentheses: true for `[let|const]? [Type]? name in`.
    // Purely speculative; everything is rewound.
    atForEachHeader() -> bool {
        let restore = this.mark();
        if (this.at(SyntaxKind.LetKeyword) || this.at(SyntaxKind.ConstKeyword)) {
            this.bump();
        }
        bool result;
        if (this.at(SyntaxKind.Identifier) && this.peekIsContextual(1, "in")) {
            result = true;
        } else if (isTypeStart(this.currentKind())) {
            this.parseType("");
            result = this.clean(restore) && this.at(SyntaxKind.Identifier)
                && this.peekIsContextual(1, "in");
        } else {
            result = false;
        }
        this.rewind(restore);
        return result;
    }

    parseKeywordStatement(SyntaxKind statementKind, string semicolonMessage) {
        let marker = this.start();
        this.bump();
        this.expect(SyntaxKind.Semicolon, semicolonMessage);
        this.complete(marker, statementKind);
    }

    parseReturnStatement() {
        let marker = this.start();
        this.bump();
        if (this.at(SyntaxKind.Semicolon)
                || (!canStartExpression(this.currentKind()) && !this.at(SyntaxKind.OpenBrace))) {
            this.nullSlot();
        } else {
            this.parseExpression();
        }
        this.expect(SyntaxKind.Semicolon,
            "Expected ';' after the return statement, for example 'return value;'");
        this.complete(marker, SyntaxKind.ReturnStatement);
    }

    parseThrowStatement() {
        let marker = this.start();
        this.bump();
        if (this.at(SyntaxKind.Semicolon)) {
            this.report("'throw' needs an error value, for example 'throw new "
                + "ParseError(\"bad input\");'. To rethrow the current error inside a catch "
                + "block, use 'rethrow;'", source.makeSpan(this.lastContentEnd, 0));
            let empty = this.start();
            let skipped = this.start();
            this.complete(skipped, SyntaxKind.List);
            this.complete(empty, SyntaxKind.ErrorExpression);
        } else {
            this.parseExpression();
        }
        this.expect(SyntaxKind.Semicolon, "Expected ';' after the throw statement");
        this.complete(marker, SyntaxKind.ThrowStatement);
    }

    parseExpressionStatement() {
        let marker = this.start();
        this.parseExpression();
        this.expect(SyntaxKind.Semicolon,
            "Expected ';' after the expression, for example 'total = total + 1;'");
        this.complete(marker, SyntaxKind.ExpressionStatement);
    }

    // ============================================================ switch

    parseSwitchStatement() {
        let marker = this.start();
        this.parseSwitchParts();
        this.complete(marker, SyntaxKind.SwitchStatement);
    }

    parseSwitchExpression() -> long {
        let marker = this.start();
        this.parseSwitchParts();
        return this.complete(marker, SyntaxKind.SwitchExpression);
    }

    parseSwitchParts() {
        this.bump();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' after 'switch'");
        this.parseExpression();
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' after the switch value");
        this.expect(SyntaxKind.OpenBrace, "Expected '\{' to begin the switch arms");
        let arms = this.start();
        bool needSeparator = false;
        while (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            if (needSeparator) {
                if (this.at(SyntaxKind.Comma)) {
                    this.bump();
                } else {
                    // The comma between arms is optional in the language; a zero-width Missing
                    // token keeps the separated list's odd separator indices without complaining.
                    this.pushMissingToken();
                }
                if (this.at(SyntaxKind.CloseBrace)) {
                    break;
                }
            }
            let kind = this.currentKind();
            if (kind == SyntaxKind.DefaultKeyword || kind == SyntaxKind.IsKeyword
                    || canStartExpression(kind)) {
                this.parseSwitchArm();
                needSeparator = true;
            } else {
                this.parseSwitchArmError();
                needSeparator = false;
            }
        }
        this.complete(arms, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the switch");
    }

    parseSwitchArm() {
        switch (this.currentKind()) {
            DefaultKeyword -> {
                let marker = this.start();
                this.bump();
                this.expect(SyntaxKind.Arrow, "Expected '->' after 'default'");
                this.parseArmBody();
                this.complete(marker, SyntaxKind.DefaultArm);
            },
            IsKeyword -> {
                let marker = this.start();
                this.bump();
                this.parseNamedType("Expected a type after 'is', for example 'is Circle c -> "
                    + "c.radius'");
                if (this.at(SyntaxKind.Identifier)) {
                    this.bump();
                } else {
                    this.nullSlot();
                }
                this.expect(SyntaxKind.Arrow, "Expected '->' after the type arm");
                this.parseArmBody();
                this.complete(marker, SyntaxKind.TypeArm);
            },
            default -> {
                let marker = this.start();
                let labels = this.start();
                this.parseExpression();
                while (this.at(SyntaxKind.Comma)) {
                    this.bump();
                    if (this.at(SyntaxKind.Arrow) || this.at(SyntaxKind.CloseBrace)
                            || this.atEnd()) {
                        break;
                    }
                    this.parseExpression();
                }
                this.complete(labels, SyntaxKind.List);
                this.expect(SyntaxKind.Arrow, "Expected '->' after the switch labels, for "
                    + "example '1 -> handleOne()'");
                this.parseArmBody();
                this.complete(marker, SyntaxKind.ValueArm);
            },
        }
    }

    parseArmBody() {
        if (this.at(SyntaxKind.OpenBrace) && !this.atStructLiteralStart()) {
            this.parseBlock();
        } else {
            this.parseExpression();
        }
    }

    // Junk between switch arms; stops before the ',' or '}' so the arm loop stays in charge.
    parseSwitchArmError() {
        this.reportAtCurrent("Expected a switch arm, for example '1 -> handleOne()'");
        let marker = this.start();
        let skipped = this.start();
        bool first = true;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.CloseBrace) {
                break;
            }
            bool armBoundary = kind == SyntaxKind.Comma || kind == SyntaxKind.DefaultKeyword
                || kind == SyntaxKind.IsKeyword || canStartExpression(kind);
            if (!first && armBoundary) {
                break;
            }
            this.bump();
            first = false;
        }
        this.complete(skipped, SyntaxKind.List);
        this.complete(marker, SyntaxKind.ErrorStatement);
    }

    // ============================================================ types

    // Type = NamedType with any chain of '?' and '[]' suffixes; returns the completed marker.
    parseType(string missingMessage) -> long {
        long completed = this.parseNamedType(missingMessage);
        while (true) {
            if (this.at(SyntaxKind.Question)) {
                let marker = this.precede(completed);
                this.bump();
                completed = this.complete(marker, SyntaxKind.OptionalType);
                continue;
            }
            if (this.at(SyntaxKind.OpenBracket) && this.peekKind(1) == SyntaxKind.CloseBracket) {
                let marker = this.precede(completed);
                this.bump();
                this.bump();
                completed = this.complete(marker, SyntaxKind.ArrayType);
                continue;
            }
            break;
        }
        return completed;
    }

    // NamedType = qualifier? name typeArguments?. A '<' after the name is taken as type arguments
    // only when they parse cleanly; otherwise it is left for the caller (a comparison, in
    // expression positions).
    parseNamedType(string missingMessage) -> long {
        let marker = this.start();
        bool qualifiable = this.at(SyntaxKind.Identifier);
        if (qualifiable && this.peekKind(1) == SyntaxKind.Dot
                && this.peekKind(2) == SyntaxKind.Identifier) {
            let qualifier = this.start();
            this.bump();
            this.bump();
            this.complete(qualifier, SyntaxKind.TypeQualifier);
        } else {
            this.nullSlot();
        }
        if (isTypeStart(this.currentKind())) {
            this.bump();
        } else {
            this.missing(SyntaxKind.Identifier, missingMessage);
        }
        if (!this.at(SyntaxKind.Less) || !this.tryParseTypeArgumentList()) {
            this.nullSlot();
        }
        return this.complete(marker, SyntaxKind.NamedType);
    }

    // Commits the type argument list when it parses without diagnostics, and rewinds otherwise.
    tryParseTypeArgumentList() -> bool {
        let restore = this.mark();
        this.parseTypeArgumentList();
        if (this.clean(restore)) {
            return true;
        }
        this.rewind(restore);
        return false;
    }

    parseTypeArgumentList() {
        let marker = this.start();
        this.expectOpeningAngle("Expected '<' to begin the type arguments");
        let list = this.start();
        if (!this.atClosingAngle() && !this.atEnd()) {
            this.parseType("Expected a type argument, for example 'List<int>'");
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                if (this.atClosingAngle()) {
                    break;
                }
                this.parseType("Expected a type argument after ','");
            }
        }
        this.complete(list, SyntaxKind.List);
        this.expectClosingAngle("Expected '>' to close the type arguments");
        this.complete(marker, SyntaxKind.TypeArgumentList);
    }

    // ============================================================ expressions

    parseExpression() -> long {
        return this.parsePrecedence(1);
    }

    parsePrecedence(long minPrecedence) -> long {
        if (this.expressionDepth >= maximumExpressionDepth()) {
            this.report("This expression nests too deeply to be parsed; split it into smaller "
                + "expressions", source.makeSpan(this.lastContentEnd, 0));
            return this.emptyErrorExpression();
        }
        this.expressionDepth++;
        long completed = this.parsePrefix();
        while (true) {
            let operator = this.currentKind();
            if (operator == SyntaxKind.Less && this.tryParseGenericCallSuffix()) {
                let call = this.precede(completed);
                this.parseArgumentList();
                completed = this.complete(call, SyntaxKind.CallExpression);
                continue;
            }
            bool safeSubscript = operator == SyntaxKind.Question
                && this.peekKind(1) == SyntaxKind.OpenBracket;
            long precedence = infixPrecedence(operator);
            if (safeSubscript) {
                precedence = 14;
            }
            if (precedence < minPrecedence || precedence == 0) {
                break;
            }
            if (safeSubscript) {
                let marker = this.precede(completed);
                this.bump();
                this.bump();
                this.parseExpression();
                this.expect(SyntaxKind.CloseBracket, "Expected ']' to close the subscript");
                completed = this.complete(marker, SyntaxKind.SafeSubscriptExpression);
                continue;
            }
            switch (operator) {
                QuestionQuestion -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.parsePrecedence(precedence);
                    completed = this.complete(marker, SyntaxKind.NullCoalesceExpression);
                },
                Question -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.parseExpression();
                    this.expect(SyntaxKind.Colon,
                        "Expected ':' between the two branches of the '?:' expression");
                    this.parsePrecedence(1);
                    completed = this.complete(marker, SyntaxKind.TernaryExpression);
                },
                OpenParenthesis -> {
                    let marker = this.precede(completed);
                    this.nullSlot();
                    this.parseArgumentList();
                    completed = this.complete(marker, SyntaxKind.CallExpression);
                },
                OpenBracket -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.parseExpression();
                    this.expect(SyntaxKind.CloseBracket, "Expected ']' to close the subscript");
                    completed = this.complete(marker, SyntaxKind.SubscriptExpression);
                },
                PlusPlus, MinusMinus -> {
                    let marker = this.precede(completed);
                    this.bump();
                    completed = this.complete(marker, SyntaxKind.PostfixExpression);
                },
                Dot -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.expect(SyntaxKind.Identifier, "Expected a member name after '.'");
                    completed = this.complete(marker, SyntaxKind.MemberExpression);
                },
                QuestionDot -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.expect(SyntaxKind.Identifier, "Expected a member name after '?.'");
                    completed = this.complete(marker, SyntaxKind.SafeMemberExpression);
                },
                AsKeyword -> {
                    bool checked = this.peekKind(1) == SyntaxKind.Question;
                    let marker = this.precede(completed);
                    this.bump();
                    if (checked) {
                        this.bump();
                        this.parseType("Expected a type after 'as?', for example 'x as? Circle'");
                        completed = this.complete(marker, SyntaxKind.CheckedCastExpression);
                    } else {
                        this.parseType("Expected a type after 'as', for example 'x as long'");
                        completed = this.complete(marker, SyntaxKind.CastExpression);
                    }
                },
                IsKeyword -> {
                    let marker = this.precede(completed);
                    this.bump();
                    this.parseNamedType("Expected a type after 'is', for example 'x is Circle'");
                    completed = this.complete(marker, SyntaxKind.TypeTestExpression);
                },
                default -> {
                    let marker = this.precede(completed);
                    this.bump();
                    if (isAssignmentOperator(operator)) {
                        this.parsePrecedence(precedence);
                        completed = this.complete(marker, SyntaxKind.AssignmentExpression);
                    } else {
                        this.parsePrecedence(precedence + 1);
                        completed = this.complete(marker, SyntaxKind.BinaryExpression);
                    }
                },
            }
        }
        this.expressionDepth--;
        return completed;
    }

    // At a '<' after an expression: commits type arguments only when they parse cleanly and a
    // call's '(' follows, the `callee<TypeArgs>(args)` shape; otherwise rewinds so the '<' stays
    // a comparison.
    tryParseGenericCallSuffix() -> bool {
        let restore = this.mark();
        this.parseTypeArgumentList();
        if (this.clean(restore) && this.at(SyntaxKind.OpenParenthesis)) {
            return true;
        }
        this.rewind(restore);
        return false;
    }

    parsePrefix() -> long {
        switch (this.currentKind()) {
            IntLiteral, LongLiteral, FloatLiteral, DoubleLiteral, StringLiteral, CharLiteral,
            TrueKeyword, FalseKeyword, NullKeyword -> {
                return this.parseSingleTokenExpression(SyntaxKind.LiteralExpression);
            },
            Identifier, StringKeyword -> {
                return this.parseSingleTokenExpression(SyntaxKind.IdentifierExpression);
            },
            ThisKeyword -> {
                return this.parseSingleTokenExpression(SyntaxKind.ThisExpression);
            },
            SuperKeyword -> {
                return this.parseSingleTokenExpression(SyntaxKind.SuperExpression);
            },
            OpenParenthesis -> {
                let marker = this.start();
                this.bump();
                this.parseExpression();
                this.expect(SyntaxKind.CloseParenthesis, "Expected ')' to close the parentheses");
                return this.complete(marker, SyntaxKind.ParenthesizedExpression);
            },
            Minus, Plus, Exclamation, Tilde, PlusPlus, MinusMinus -> {
                let marker = this.start();
                this.bump();
                this.parsePrecedence(13);
                return this.complete(marker, SyntaxKind.PrefixExpression);
            },
            OpenBracket -> {
                return this.parseArrayLiteral();
            },
            OpenBrace -> {
                return this.parseStructLiteral();
            },
            NewKeyword -> {
                return this.parseNewExpression();
            },
            TryKeyword -> {
                let marker = this.start();
                this.bump();
                this.parsePrecedence(14);
                return this.complete(marker, SyntaxKind.TryExpression);
            },
            SwitchKeyword -> {
                return this.parseSwitchExpression();
            },
            InterpolatedStringStart -> {
                return this.parseInterpolatedString();
            },
            default -> {
                this.report("Expected an expression, for example a value like '42', a variable "
                    + "name, or a call", source.makeSpan(this.lastContentEnd, 0));
                return this.emptyErrorExpression();
            },
        }
    }

    parseSingleTokenExpression(SyntaxKind nodeKind) -> long {
        let marker = this.start();
        this.bump();
        return this.complete(marker, nodeKind);
    }

    // InterpolatedStringExpression = start firstHole (middle hole)* end; the lexer guarantees
    // text segments and holes alternate, so the slots read in source order.
    parseInterpolatedString() -> long {
        let marker = this.start();
        this.bump();
        this.parseExpression();
        let continuations = this.start();
        while (this.at(SyntaxKind.InterpolatedStringMiddle)) {
            let part = this.start();
            this.bump();
            this.parseExpression();
            this.complete(part, SyntaxKind.InterpolationPart);
        }
        this.complete(continuations, SyntaxKind.List);
        this.expect(SyntaxKind.InterpolatedStringEnd,
            "Expected the end of the interpolated string");
        return this.complete(marker, SyntaxKind.InterpolatedStringExpression);
    }

    emptyErrorExpression() -> long {
        let marker = this.start();
        let skipped = this.start();
        this.complete(skipped, SyntaxKind.List);
        return this.complete(marker, SyntaxKind.ErrorExpression);
    }

    parseArrayLiteral() -> long {
        let marker = this.start();
        this.bump();
        let list = this.start();
        if (!this.at(SyntaxKind.CloseBracket) && !this.atEnd()) {
            this.parseExpression();
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                if (this.at(SyntaxKind.CloseBracket)) {
                    break;
                }
                this.parseExpression();
            }
        }
        this.complete(list, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBracket, "Expected ']' to close the array literal");
        return this.complete(marker, SyntaxKind.ArrayLiteralExpression);
    }

    // A '{' begins a struct literal only in expression position; blocks and switch-arm bodies are
    // dispatched before reaching here, and the arm body checks atStructLiteralStart first.
    parseStructLiteral() -> long {
        let marker = this.start();
        this.bump();
        let list = this.start();
        if (!this.at(SyntaxKind.CloseBrace) && !this.atEnd()) {
            this.parseStructLiteralField();
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                if (this.at(SyntaxKind.CloseBrace)) {
                    break;
                }
                this.parseStructLiteralField();
            }
        }
        this.complete(list, SyntaxKind.List);
        this.expect(SyntaxKind.CloseBrace, "Expected '\}' to close the struct literal");
        return this.complete(marker, SyntaxKind.StructLiteralExpression);
    }

    parseStructLiteralField() {
        let marker = this.start();
        this.expect(SyntaxKind.Identifier,
            "Expected a field name, for example '\{x: 1, y: 2\}'");
        this.expect(SyntaxKind.Colon,
            "Expected ':' after the field name, for example '\{x: 1\}'");
        this.parseExpression();
        this.complete(marker, SyntaxKind.StructLiteralField);
    }

    // A '{' whose next two tokens are `IDENT :` starts a struct literal; Ens has no labels, so that
    // shape can never begin a statement. Every other '{' is a block.
    atStructLiteralStart() -> bool {
        return this.at(SyntaxKind.OpenBrace) && this.peekKind(1) == SyntaxKind.Identifier
            && this.peekKind(2) == SyntaxKind.Colon;
    }

    // NewExpression = 'new' createdType arguments? dimensions*. The created type keeps '?'
    // suffixes and any '[]' pair that more suffixes follow ('new Box?[]?[3]'); a final '[...]'
    // run is the dimension list ('new int[3][4]').
    parseNewExpression() -> long {
        let marker = this.start();
        this.bump();
        this.parseNewCreatedType();
        if (this.at(SyntaxKind.OpenParenthesis)) {
            this.parseArgumentList();
            let dimensions = this.start();
            this.complete(dimensions, SyntaxKind.List);
        } else if (this.at(SyntaxKind.OpenBracket)) {
            this.nullSlot();
            this.parseArrayDimensions();
        } else {
            this.nullSlot();
            let dimensions = this.start();
            this.complete(dimensions, SyntaxKind.List);
            this.report("Expected '(' for constructor arguments or '[' for an array size after "
                + "the type in 'new', for example 'new Point(0, 0)' or 'new int[8]'",
                source.makeSpan(this.lastContentEnd, 0));
        }
        return this.complete(marker, SyntaxKind.NewExpression);
    }

    parseNewCreatedType() {
        long completed =
            this.parseNamedType("Expected a type after 'new', for example 'new Point(0, 0)'");
        while (true) {
            if (this.at(SyntaxKind.Question)) {
                let marker = this.precede(completed);
                this.bump();
                completed = this.complete(marker, SyntaxKind.OptionalType);
                continue;
            }
            bool elementBrackets = this.at(SyntaxKind.OpenBracket)
                && this.peekKind(1) == SyntaxKind.CloseBracket
                && (this.peekKind(2) == SyntaxKind.Question
                    || this.peekKind(2) == SyntaxKind.OpenBracket);
            if (elementBrackets) {
                let marker = this.precede(completed);
                this.bump();
                this.bump();
                completed = this.complete(marker, SyntaxKind.ArrayType);
                continue;
            }
            break;
        }
    }

    parseArrayDimensions() {
        let list = this.start();
        bool seenEmpty = false;
        while (this.at(SyntaxKind.OpenBracket)) {
            let dimension = this.start();
            this.bump();
            if (this.at(SyntaxKind.CloseBracket)) {
                this.nullSlot();
                this.bump();
                seenEmpty = true;
            } else {
                if (seenEmpty) {
                    this.reportAtCurrent("Sized dimensions must come before any '[]' dimensions, "
                        + "for example 'new int[3][]'");
                }
                this.parseExpression();
                this.expect(SyntaxKind.CloseBracket, "Expected ']' after the array size");
            }
            this.complete(dimension, SyntaxKind.ArrayDimension);
        }
        this.complete(list, SyntaxKind.List);
    }

    parseArgumentList() {
        let marker = this.start();
        this.expect(SyntaxKind.OpenParenthesis, "Expected '(' to begin the arguments");
        let list = this.start();
        if (!this.at(SyntaxKind.CloseParenthesis) && !this.atEnd()) {
            this.parseArgument();
            while (this.at(SyntaxKind.Comma)) {
                this.bump();
                if (this.at(SyntaxKind.CloseParenthesis)) {
                    break;
                }
                this.parseArgument();
            }
        }
        this.complete(list, SyntaxKind.List);
        this.expect(SyntaxKind.CloseParenthesis, "Expected ')' to close the arguments");
        this.complete(marker, SyntaxKind.ArgumentList);
    }

    parseArgument() {
        if (this.atContextual("out") && this.peekKind(1) == SyntaxKind.Identifier) {
            let marker = this.start();
            this.bumpAs(SyntaxKind.OutKeyword);
            this.bump();
            this.complete(marker, SyntaxKind.OutArgument);
            return;
        }
        if (this.at(SyntaxKind.Identifier) && this.peekKind(1) == SyntaxKind.Colon) {
            let marker = this.start();
            this.bump();
            this.bump();
            this.parseExpression();
            this.complete(marker, SyntaxKind.NamedArgument);
            return;
        }
        this.parseExpression();
    }
}

// ============================================================ kind tables

isTypeStart(SyntaxKind kind) -> bool {
    return kind == SyntaxKind.Identifier || isPrimitiveTypeKeyword(kind);
}

isPrimitiveTypeKeyword(SyntaxKind kind) -> bool {
    return switch (kind) {
        BoolKeyword, ByteKeyword, ShortKeyword, UShortKeyword, IntKeyword, UIntKeyword,
        LongKeyword, ULongKeyword, FloatKeyword, DoubleKeyword, DecimalKeyword, CharKeyword,
        StringKeyword, VoidKeyword -> true,
        default -> false,
    };
}

isModifier(SyntaxKind kind) -> bool {
    return switch (kind) {
        PublicKeyword, PrivateKeyword, ProtectedKeyword, ExportKeyword, AbstractKeyword,
        OverrideKeyword, FinalKeyword, SealedKeyword, WeakKeyword, ConstKeyword,
        NoreturnKeyword -> true,
        default -> false,
    };
}

atTopLevelDeclarationStart(SyntaxKind kind) -> bool {
    return switch (kind) {
        ImportKeyword, StructKeyword, ClassKeyword, InterfaceKeyword, EnumKeyword,
        ExternalKeyword, PublicKeyword, PrivateKeyword, ProtectedKeyword, ExportKeyword,
        AbstractKeyword, FinalKeyword, SealedKeyword -> true,
        default -> false,
    };
}

canStartExpression(SyntaxKind kind) -> bool {
    return switch (kind) {
        IntLiteral, LongLiteral, FloatLiteral, DoubleLiteral, StringLiteral, CharLiteral,
        InterpolatedStringStart, Identifier, StringKeyword, TrueKeyword, FalseKeyword,
        NullKeyword, ThisKeyword, SuperKeyword, NewKeyword, TryKeyword, SwitchKeyword,
        OpenParenthesis, OpenBracket, Minus, Plus, Exclamation, Tilde, PlusPlus,
        MinusMinus -> true,
        default -> false,
    };
}

isAssignmentOperator(SyntaxKind kind) -> bool {
    return switch (kind) {
        Equals, PlusEquals, MinusEquals, StarEquals, SlashEquals, PercentEquals, AmpersandEquals,
        PipeEquals, CaretEquals, LessLessEquals, GreaterGreaterEquals,
        GreaterGreaterGreaterEquals -> true,
        default -> false,
    };
}

// The binding strength of an infix or postfix operator, or 0 when the kind ends an expression.
// Assignment and '??' are right-associative; the caller passes the same precedence back down for
// those and precedence + 1 for the left-associative rest.
infixPrecedence(SyntaxKind kind) -> long {
    if (isAssignmentOperator(kind)) {
        return 1;
    }
    return switch (kind) {
        Question -> 2,
        PipePipe, QuestionQuestion -> 3,
        AmpersandAmpersand -> 4,
        Pipe -> 5,
        Caret -> 6,
        Ampersand -> 7,
        EqualsEquals, NotEquals -> 8,
        Less, Greater, LessEquals, GreaterEquals, IsKeyword -> 9,
        LessLess, GreaterGreater, GreaterGreaterGreater -> 10,
        Plus, Minus -> 11,
        Star, Slash, Percent -> 12,
        AsKeyword -> 13,
        Dot, QuestionDot, OpenParenthesis, OpenBracket, PlusPlus, MinusMinus -> 14,
        default -> 0,
    };
}

// The kind of the unconsumed tail of a partially split token.
splitRemainderKind(SyntaxKind kind, long consumed) -> SyntaxKind {
    return switch (kind) {
        GreaterGreater -> SyntaxKind.Greater,
        GreaterGreaterGreater ->
            consumed == 1 ? SyntaxKind.GreaterGreater : SyntaxKind.Greater,
        GreaterEquals -> SyntaxKind.Equals,
        GreaterGreaterEquals -> consumed == 1 ? SyntaxKind.GreaterEquals : SyntaxKind.Equals,
        GreaterGreaterGreaterEquals -> consumed == 1
            ? SyntaxKind.GreaterGreaterEquals
            : (consumed == 2 ? SyntaxKind.GreaterEquals : SyntaxKind.Equals),
        LessLess -> SyntaxKind.Less,
        LessEquals -> SyntaxKind.Equals,
        LessLessEquals -> consumed == 1 ? SyntaxKind.LessEquals : SyntaxKind.Equals,
        default -> panicSplit(kind),
    };
}

panicSplit(SyntaxKind kind) -> SyntaxKind {
    panic("Internal: a {kind} token cannot be split");
}
