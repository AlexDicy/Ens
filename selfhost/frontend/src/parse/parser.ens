// A pure per-file function from source text to a ParseResult holding the green SourceFile root and
// every diagnostic, lex and parse merged in span order. Each call owns all of its state, with no
// shared sink and no cache that outlives it, so files can parse in parallel.
import Source from support.source;
import Span from support.source;
import support.source;
import SyntaxKind from syntax.generated.kind;
import Diagnostic from support.diagnostics;
import LexedToken from lex.token;
import lex.lexer;
import LexResult from lex.lexer;
import GreenNode from syntax.green;
import EventKind from parse.events;
import ParseEvent from parse.events;
import Recovery from parse.recovery;
import RecoveryScope from parse.recovery;
import parse.recovery;
import RewindableList from parse.rewindable;
import parse.treebuilder;
import parse.parser.declarations;
import parse.parser.manifests;
import parse.parser.statements;
import parse.parser.expressions;
import List from @std.collections.list;

export class ParseResult {
    GreenNode greenRoot;
    Diagnostic[] allDiagnostics;
    Recovery[] allRecoveries;

    protected constructor(GreenNode root, Diagnostic[] diagnostics, Recovery[] recoveries) {
        this.greenRoot = root;
        this.allDiagnostics = diagnostics;
        this.allRecoveries = recoveries;
    }

    // The green root, from parse() a SourceFile or ManifestFile node whose full text equals the
    // source byte for byte.
    export root() -> GreenNode {
        return this.greenRoot;
    }

    // Lex and parse diagnostics merged, ordered by span start.
    export diagnostics() -> Diagnostic[] {
        return this.allDiagnostics;
    }

    // The tokens the parser had to invent, in the order it invented them, behind a whole-file guess
    // when the text did not even tokenize. Error nodes are the other half, carried by the tree.
    export recoveries() -> Recovery[] {
        return this.allRecoveries;
    }
}

// Parses input as ordinary source, or as a manifest when its file name marks it as one.
export parse(Source input) -> ParseResult {
    if (isManifestPath(input.path())) {
        return parseManifest(input);
    }
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseSourceFile();
    return finishParse(input, lexed, parser);
}

// The root is a ManifestFile node.
export parseManifest(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseManifestFile();
    return finishParse(input, lexed, parser);
}

// True for the file names that hold manifests, with any folder prefix: 'ens.package' marks a
// package or workspace, 'ens.overrides' holds local overrides.
export isManifestPath(string path) -> bool {
    string name = fileName(path);
    return name == "ens.package" || name == "ens.overrides";
}

fileName(string path) -> string {
    byte[] bytes = path.toBytes();
    long start = 0;
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '/' || bytes[i] == '\\') {
            start = i + 1;
        }
    }
    return path.substring(start, path.length);
}

// A testing entry. The root is a List node holding the expression, any unconsumed tokens, and the
// end-of-file token, so the round-trip invariant covers the whole source.
public parseExpressionOnly(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseStandaloneExpression();
    return finishParse(input, lexed, parser);
}

// A testing entry, wrapped the same way as parseExpressionOnly.
public parseStatementOnly(Source input) -> ParseResult {
    let lexed = lexer.lex(input);
    let parser = new Parser(input, lexed.tokens());
    parser.parseStandaloneStatement();
    return finishParse(input, lexed, parser);
}

finishParse(Source input, LexResult lexed, Parser parser) -> ParseResult {
    let root = treebuilder.buildTree(input, lexed.tokens(), parser.finishedEvents());
    let diagnostics = mergeDiagnostics(lexed.diagnostics(), parser.collectedDiagnostics());
    return new ParseResult(root, diagnostics, allRecoveries(lexed, parser));
}

// The parser's own guesses, and one for the whole file when the text did not even tokenize. A run
// of bytes that is not a token leaves the parser reading a stream the author did not write.
allRecoveries(LexResult lexed, Parser parser) -> Recovery[] {
    let parsed = parser.collectedRecoveries();
    if (lexed.diagnostics().length == 0) {
        return parsed;
    }
    let all = new List<Recovery>();
    all.push(new Recovery(lexed.diagnostics()[0].span(), RecoveryScope.File));
    for (let recovery in parsed) {
        all.push(recovery);
    }
    return all.toArray();
}

// Merges the position-ordered lex and parse diagnostic lists; lex wins ties.
mergeDiagnostics(Diagnostic[] first, Diagnostic[] second) -> Diagnostic[] {
    let merged = new List<Diagnostic>();
    long i = 0;
    long j = 0;
    while (i < first.length || j < second.length) {
        bool takeFirst = j >= second.length
            || (i < first.length && first[i].span().start <= second[j].span().start);
        if (takeFirst) {
            merged.push(first[i]);
            i++;
        } else {
            merged.push(second[j]);
            j++;
        }
    }
    return merged.toArray();
}

// True when the same limit was already reached at the same place, which is what one construct's
// nested readings all report.
hasDepthLimit(Diagnostic[] limits, Diagnostic limit) -> bool {
    for (let seen in limits) {
        if (seen.span().start == limit.span().start && seen.message() == limit.message()) {
            return true;
        }
    }
    return false;
}

// A snapshot of everything speculation can change, the token cursor's split state included.
public struct ParserMark {
    public long position;
    protected long splitOffset;
    protected long lastContentEnd;
    protected long eventCount;
    protected long diagnosticCount;
    protected long depthLimitCount;
    protected long recoveryCount;
}

final class Nesting {
    // How deep a tree one declaration may be written as. Expressions, types and blocks all count
    // against it, because every later phase walks the result by recursing once per level. A long
    // chain counts too, since each operator that extends what came before wraps it in one more
    // level.
    protected static const long maximumDepth = 500;
}

public final class Parser {
    Source input;
    string sourceText;
    LexedToken[] lexedTokens;

    // cursor indexes the significant-token stream. splitOffset counts the bytes of the current
    // token already consumed as split pieces, such as the '>' halves of '>>'. contentEnd is
    // the byte offset just past the last consumed content, where missing-token diagnostics anchor.
    long cursor;
    long splitOffset;
    long contentEnd;

    RewindableList<ParseEvent> events;
    RewindableList<Diagnostic> diagnostics;
    RewindableList<Recovery> recoveries;

    long nestingDepth;

    // Depth limits are kept apart from the other diagnostics so that 'clean' can ignore them: a
    // reading abandoned for nesting too deeply is still that reading.
    RewindableList<Diagnostic> depthLimits;
    List<Diagnostic> carriedDepthLimits;

    // True while a switch arm's labels are being parsed. There a '->' ends the labels, so
    // 'Circle -> ...' and '(1) -> ...' are the arm rather than a lambda; a label is a constant,
    // so no lambda can appear inside one anyway.
    bool parsingArmLabels;

    protected constructor(Source input, LexedToken[] tokens) {
        this.input = input;
        this.sourceText = input.text();
        this.lexedTokens = tokens;
        this.cursor = 0;
        this.splitOffset = 0;
        this.contentEnd = 0;
        this.events = new RewindableList<ParseEvent>();
        this.diagnostics = new RewindableList<Diagnostic>();
        this.recoveries = new RewindableList<Recovery>();
        this.nestingDepth = 0;
        this.depthLimits = new RewindableList<Diagnostic>();
        this.carriedDepthLimits = new List<Diagnostic>();
        this.parsingArmLabels = false;
    }

    public text() -> string {
        return this.sourceText;
    }

    // The file's significant tokens, ending with the end-of-file token.
    public tokens() -> LexedToken[] {
        return this.lexedTokens;
    }

    // The index of the current token in tokens().
    public position() -> long {
        return this.cursor;
    }

    // The byte offset just past the last consumed content.
    public lastContentEnd() -> long {
        return this.contentEnd;
    }

    public inArmLabels() -> bool {
        return this.parsingArmLabels;
    }

    public setInArmLabels(bool inLabels) {
        this.parsingArmLabels = inLabels;
    }

    protected finishedEvents() -> ParseEvent[] {
        return this.events.toArray();
    }

    // A carried limit is there so a file the parser abandoned for depth cannot come out silent
    // about it. Where a reading did report a limit, the diagnostic names how deeply the file nests,
    // and the carried ones report the same about the same text a link apart, so they are dropped.
    protected collectedDiagnostics() -> Diagnostic[] {
        Diagnostic[] live = this.depthLimits.toArray();
        if (live.length > 0 || this.carriedDepthLimits.length() == 0) {
            return mergeDiagnostics(this.diagnostics.toArray(), live);
        }
        return mergeDiagnostics(this.diagnostics.toArray(),
            this.carriedDepthLimits.toArray());
    }

    protected collectedRecoveries() -> Recovery[] {
        return this.recoveries.toArray();
    }

    // ============================================================ entries

    protected parseSourceFile() {
        let marker = this.start();
        let items = this.start();
        while (!this.atEnd()) {
            declarations.parseTopLevelItem(this);
        }
        this.complete(items, SyntaxKind.List);
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.SourceFile);
    }

    protected parseManifestFile() {
        let marker = this.start();
        let declarations = this.start();
        while (!this.atEnd()) {
            manifests.parseManifestDeclaration(this);
        }
        this.complete(declarations, SyntaxKind.List);
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.ManifestFile);
    }

    protected parseStandaloneExpression() {
        let marker = this.start();
        expressions.parseExpression(this);
        while (!this.atEnd()) {
            this.bump();
        }
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.List);
    }

    protected parseStandaloneStatement() {
        let marker = this.start();
        statements.parseStatement(this);
        while (!this.atEnd()) {
            this.bump();
        }
        this.emitEndOfFile();
        this.complete(marker, SyntaxKind.List);
    }

    // ============================================================ cursor

    // The kind of the current token, or of its unconsumed tail once a split has begun.
    public currentKind() -> SyntaxKind {
        let kind = this.lexedTokens[this.cursor].kind;
        if (this.splitOffset == 0) {
            return kind;
        }
        return splitRemainderKind(kind, this.splitOffset);
    }

    public at(SyntaxKind kind) -> bool {
        return this.currentKind() == kind;
    }

    public atEnd() -> bool {
        return this.currentKind() == SyntaxKind.EndOfFile;
    }

    // The kind ahead tokens after the current one; ahead 0 is the current kind including split
    // state, and past the end every token is EndOfFile.
    public peekKind(long ahead) -> SyntaxKind {
        if (ahead == 0) {
            return this.currentKind();
        }
        let index = this.cursor + ahead;
        if (index >= this.lexedTokens.length) {
            return SyntaxKind.EndOfFile;
        }
        return this.lexedTokens[index].kind;
    }

    // The text of the current token, less any split pieces already consumed.
    public currentText() -> string {
        let token = this.lexedTokens[this.cursor];
        return this.sourceText.substring(token.offset + this.splitOffset, token.end());
    }

    // True at an identifier whose text is the given contextual keyword.
    public atContextual(string word) -> bool {
        return this.at(SyntaxKind.Identifier) && this.currentText() == word;
    }

    // True when the token 'ahead' places past the current one is an identifier spelled 'word'.
    public peekIsContextual(long ahead, string word) -> bool {
        let index = this.cursor + ahead;
        if (index >= this.lexedTokens.length) {
            return false;
        }
        let token = this.lexedTokens[index];
        if (token.kind != SyntaxKind.Identifier) {
            return false;
        }
        return this.sourceText.substring(token.offset, token.end()) == word;
    }

    // ============================================================ events

    // Opens a node whose kind is fixed at completion.
    public start() -> long {
        ParseEvent event = {};
        return this.events.push(event);
    }

    // Returns the marker as a completed node, which precede can then wrap.
    public complete(long marker, SyntaxKind nodeKind) -> long {
        let event = this.events.get(marker);
        event.eventKind = EventKind.StartNode;
        event.kind = nodeKind;
        this.events.set(marker, event);
        ParseEvent finish = {eventKind: EventKind.FinishNode};
        this.events.push(finish);
        return marker;
    }

    // Opens a node that retroactively wraps an already-completed one; everything emitted from the
    // completed node's start onward becomes part of the new node. Never call this on a node
    // completed before a mark that may still be rewound.
    public precede(long completed) -> long {
        let marker = this.start();
        let event = this.events.get(completed);
        event.forwardParent = marker;
        this.events.set(completed, event);
        return marker;
    }

    // Leaves the next slot of the node being built empty.
    public nullSlot() {
        ParseEvent event = {eventKind: EventKind.NullSlot};
        this.events.push(event);
    }

    pushTokenEvent(SyntaxKind kind, long tokenIndex, long pieceStart, long pieceLength,
                           bool takeLeading, bool takeTrailing) {
        ParseEvent event = {
            eventKind: EventKind.Token,
            kind: kind,
            tokenIndex: tokenIndex,
            pieceStart: pieceStart,
            pieceLength: pieceLength,
            takeLeading: takeLeading,
            takeTrailing: takeTrailing,
        };
        this.events.push(event);
    }

    // Consumes the rest of the current token under its own kind.
    public bump() {
        this.bumpAs(this.currentKind());
    }

    // Consumes the rest of the current token re-tagged. Contextual keywords (out/in/test) and
    // keywords recovered as names are emitted this way.
    public bumpAs(SyntaxKind kind) {
        if (this.atEnd()) {
            return;
        }
        let token = this.lexedTokens[this.cursor];
        this.pushTokenEvent(kind, this.cursor, this.splitOffset, token.length - this.splitOffset,
                            this.splitOffset == 0, true);
        this.contentEnd = token.end();
        this.cursor++;
        this.splitOffset = 0;
    }

    // Consumes the first remaining byte of the current multi-character operator as its own token,
    // which is how nested generics lexed greedily as '>>', '>>>', '>>=', '>>>=', or '<<' are
    // split. The first piece keeps the leading trivia, the last the trailing, and the rest none.
    bumpSplit(SyntaxKind pieceKind) {
        let token = this.lexedTokens[this.cursor];
        this.pushTokenEvent(pieceKind, this.cursor, this.splitOffset, 1,
                            this.splitOffset == 0, false);
        this.splitOffset++;
        this.contentEnd = token.offset + this.splitOffset;
    }

    // The end-of-file token carries the file's trailing trivia; parseSourceFile emits it into the
    // eof slot without advancing.
    emitEndOfFile() {
        let token = this.lexedTokens[this.cursor];
        this.pushTokenEvent(SyntaxKind.EndOfFile, this.cursor, 0, token.length, true, true);
    }

    // ============================================================ diagnostics

    public report(string message, Span span) {
        this.diagnostics.push(new Diagnostic(message, span));
    }

    // Records that a nesting limit was reached, apart from the diagnostics 'clean' counts.
    public reportDepthLimit(string message, Span span) {
        this.depthLimits.push(new Diagnostic(message, span));
    }

    // Keeps a speculation's depth limits past its rewind, so a classifier that drops a reading
    // does not drop the only account of why. One entry per place and message.
    public carryDepthLimits(ParserMark restore) {
        for (long i = restore.depthLimitCount; i < this.depthLimits.count(); i++) {
            let limit = this.depthLimits.get(i);
            if (!hasDepthLimit(this.carriedDepthLimits.toArray(), limit)) {
                this.carriedDepthLimits.push(limit);
            }
        }
    }

    // Records a diagnostic over the rest of the current token.
    public reportAtCurrent(string message) {
        let token = this.lexedTokens[this.cursor];
        let start = token.offset + this.splitOffset;
        this.report(message, source.makeSpan(start, token.end() - start));
    }

    // A zero-length Missing token at the end of the previous token's content, with a diagnostic
    // anchored there, recorded as a guess unless the token was a separator carrying no meaning.
    public missing(SyntaxKind expected, string message) {
        this.pushMissingToken();
        if (!recovery.missingCostsNothing(expected)) {
            this.recovered(recovery.scopeForMissing(expected));
        }
        this.report(message, source.makeSpan(this.contentEnd, 0));
    }

    // A Missing token for a slot the source was never going to fill, with the diagnostic reported
    // by the caller. Nothing is consumed, so the guess reaches no further than the construct.
    public missingInPlace() {
        this.pushMissingToken();
        this.recovered(RecoveryScope.Construct);
    }

    // A zero-length Missing token with no diagnostic and no recorded guess.
    public pushMissingToken() {
        this.pushTokenEvent(SyntaxKind.Missing, -1, 0, 0, false, false);
    }

    recovered(RecoveryScope scope) {
        this.recoveries.push(new Recovery(source.makeSpan(this.contentEnd, 0), scope));
    }

    // Consumes a token of the given kind, or emits a Missing token with message as its diagnostic.
    public expect(SyntaxKind kind, string message) {
        if (this.at(kind)) {
            this.bump();
        } else {
            this.missing(kind, message);
        }
    }

    // ============================================================ speculation

    // A snapshot to rewind to after a speculative parse.
    public mark() -> ParserMark {
        return {
            position: this.cursor,
            splitOffset: this.splitOffset,
            lastContentEnd: this.contentEnd,
            eventCount: this.events.count(),
            diagnosticCount: this.diagnostics.count(),
            depthLimitCount: this.depthLimits.count(),
            recoveryCount: this.recoveries.count(),
        };
    }

    // Restores everything the mark recorded, dropping what was parsed since.
    public rewind(ParserMark restore) {
        this.cursor = restore.position;
        this.splitOffset = restore.splitOffset;
        this.contentEnd = restore.lastContentEnd;
        this.events.truncate(restore.eventCount);
        this.diagnostics.truncate(restore.diagnosticCount);
        this.depthLimits.truncate(restore.depthLimitCount);
        this.recoveries.truncate(restore.recoveryCount);
    }

    // A speculative parse succeeded when it neither reported nor guessed anything since the mark.
    // Every guess is reported today, so the second test is redundant and kept anyway. A guess that
    // stopped reporting would otherwise clear a speculation of diagnostics while leaving an invented
    // token in the tree it kept. A depth limit never lands here, so a reading abandoned for depth
    // is still that reading.
    public clean(ParserMark restore) -> bool {
        return this.diagnostics.count() == restore.diagnosticCount
            && this.recoveries.count() == restore.recoveryCount;
    }

    // ============================================================ angle brackets

    // True at a '>' or at an operator that starts with one, such as the '>>' closing two type
    // argument lists.
    public atClosingAngle() -> bool {
        return switch (this.currentKind()) {
            Greater, GreaterGreater, GreaterGreaterGreater, GreaterEquals, GreaterGreaterEquals,
            GreaterGreaterGreaterEquals -> true,
            default -> false,
        };
    }

    // Consumes one '>', split off the front of an operator that starts with one.
    public expectClosingAngle(string message) {
        switch (this.currentKind()) {
            Greater -> this.bump(),
            GreaterGreater, GreaterGreaterGreater, GreaterEquals, GreaterGreaterEquals,
            GreaterGreaterGreaterEquals -> this.bumpSplit(SyntaxKind.Greater),
            default -> this.missing(SyntaxKind.Greater, message),
        }
    }

    // True at a '<' or at an operator that starts with one.
    public atOpeningAngle() -> bool {
        return switch (this.currentKind()) {
            Less, LessLess, LessLessEquals -> true,
            default -> false,
        };
    }

    // Consumes one '<', split off the front of an operator that starts with one.
    public expectOpeningAngle(string message) {
        switch (this.currentKind()) {
            Less -> this.bump(),
            LessLess, LessLessEquals -> this.bumpSplit(SyntaxKind.Less),
            default -> this.missing(SyntaxKind.Less, message),
        }
    }

    // ============================================================ adjacent questions

    // True at the first '?' of a '??' written with nothing between the two. The lexer emits two
    // Question tokens so a type can stack its suffixes ('string??'), and the operator is the
    // adjacent pair. A separated pair is a ternary whose then-branch starts with '?'.
    public atNullCoalesce() -> bool {
        return this.atQuestionPair() && this.questionsAreAdjacent();
    }

    // A '?' with something between it and the second one. No valid expression begins with '?', so
    // the pair can only be a mistyped '??', which is what the caller reports and reads it as.
    public atSeparatedNullCoalesce() -> bool {
        return this.atQuestionPair() && !this.questionsAreAdjacent();
    }

    atQuestionPair() -> bool {
        if (this.currentKind() != SyntaxKind.Question) {
            return false;
        }
        let next = this.cursor + 1;
        return next < this.lexedTokens.length && this.lexedTokens[next].kind == SyntaxKind.Question;
    }

    questionsAreAdjacent() -> bool {
        return this.lexedTokens[this.cursor].end() == this.lexedTokens[this.cursor + 1].offset;
    }

    // Reported over both question marks, so the fix is spelled where the gap is.
    public reportSeparatedQuestions() {
        let first = this.lexedTokens[this.cursor];
        let second = this.lexedTokens[this.cursor + 1];
        this.report("The two question marks of '??' must be written together, with nothing "
            + "between them. Write 'value ?? fallback', which uses 'fallback' when 'value' is "
            + "null.", source.makeSpan(first.offset, second.end() - first.offset));
    }

    // The safe subscript '?[', which is adjacent for the reason '??' is: a '?' with a space after
    // it begins a conditional expression, whose first branch may well be an array literal.
    public atSafeSubscript() -> bool {
        if (this.currentKind() != SyntaxKind.Question) {
            return false;
        }
        let next = this.cursor + 1;
        if (next >= this.lexedTokens.length || this.lexedTokens[next].kind != SyntaxKind.OpenBracket) {
            return false;
        }
        return this.lexedTokens[this.cursor].end() == this.lexedTokens[next].offset;
    }

    // ============================================================ nesting depth

    // Enters one level of nesting, or reports that the limit is reached and leaves it to the caller
    // to abandon what it was parsing. Expressions and types share the count because each can
    // contain the other, so neither can carry the pair past the limit on its own.
    public enterNesting(string message) -> bool {
        if (this.nestingDepth >= Nesting.maximumDepth) {
            this.reportDepthLimit(message, source.makeSpan(this.contentEnd, 0));
            return false;
        }
        this.nestingDepth++;
        return true;
    }

    // Gives back the level enterNesting took.
    public leaveNesting() {
        this.nestingDepth--;
    }

    // Gives back the levels one construct took together: a chain of operators is one expression,
    // so its links are entered one at a time and left in a single step when it finishes.
    public leaveNestingTimes(long count) {
        this.nestingDepth = this.nestingDepth - count;
    }

    // A node standing in for a construct the parser abandoned, holding that construct's tokens.
    public abandoned(SyntaxKind nodeKind) -> long {
        let marker = this.start();
        let skipped = this.start();
        this.skipAbandonedTokens();
        this.complete(skipped, SyntaxKind.List);
        return this.complete(marker, nodeKind);
    }

    // Nesting inside an abandoned construct is consumed whole, so the constructs around it still
    // find the closing tokens they are waiting for instead of reporting one problem per enclosing
    // level. A closer or ',' at the outer level ends the skip, as does a ';' or '}' anywhere.
    skipAbandonedTokens() {
        long depth = 0;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.Semicolon || kind == SyntaxKind.CloseBrace) {
                return;
            }
            if (kind == SyntaxKind.OpenParenthesis || kind == SyntaxKind.OpenBracket) {
                depth++;
            } else if (kind == SyntaxKind.CloseParenthesis || kind == SyntaxKind.CloseBracket) {
                if (depth == 0) {
                    return;
                }
                depth--;
            } else if (depth == 0 && kind == SyntaxKind.Comma) {
                return;
            }
            this.bump();
        }
    }

    // At '{'; consumes through the matching '}', or to the end of the file.
    public bumpBalancedBraces() {
        long depth = 0;
        while (!this.atEnd()) {
            let kind = this.currentKind();
            if (kind == SyntaxKind.OpenBrace) {
                depth++;
            } else if (kind == SyntaxKind.CloseBrace) {
                depth--;
            }
            this.bump();
            if (depth == 0) {
                return;
            }
        }
    }

    // ============================================================ arrow after parentheses

    // At '(', true when the token after the matching ')' is '->'. In type position that distinguishes a
    // function type from a type in parentheses, and in expression position a lambda from a
    // parenthesized expression. Reads token kinds directly, so it costs no events and no stack.
    public atArrowAfterParentheses() -> bool {
        long depth = 0;
        long index = this.cursor;
        while (index < this.lexedTokens.length) {
            let kind = this.lexedTokens[index].kind;
            if (kind == SyntaxKind.EndOfFile) {
                return false;
            }
            if (kind == SyntaxKind.OpenParenthesis) {
                depth++;
            } else if (kind == SyntaxKind.CloseParenthesis) {
                depth--;
            }
            index++;
            if (depth == 0) {
                return index < this.lexedTokens.length && this.lexedTokens[index].kind == SyntaxKind.Arrow;
            }
        }
        return false;
    }
}

// ============================================================ kind tables

// The kind of the unconsumed tail of a partially split token.
splitRemainderKind(SyntaxKind kind, long consumed) -> SyntaxKind {
    return switch (kind) {
        GreaterGreater -> SyntaxKind.Greater,
        GreaterGreaterGreater -> consumed == 1 ? SyntaxKind.GreaterGreater : SyntaxKind.Greater,
        GreaterEquals -> SyntaxKind.Equals,
        GreaterGreaterEquals -> consumed == 1 ? SyntaxKind.GreaterEquals : SyntaxKind.Equals,
        GreaterGreaterGreaterEquals -> consumed == 1
            ? SyntaxKind.GreaterGreaterEquals
            : (consumed == 2 ? SyntaxKind.GreaterEquals : SyntaxKind.Equals),
        LessLess -> SyntaxKind.Less,
        LessEquals -> SyntaxKind.Equals,
        LessLessEquals -> consumed == 1 ? SyntaxKind.LessEquals : SyntaxKind.Equals,
        default -> panicSplit(kind),
    };
}

panicSplit(SyntaxKind kind) -> SyntaxKind {
    panic("Internal: a {kind} token cannot be split");
}
