// Where the parser invented something the source did not say, and how far the invention reaches.
// A file with a syntax error still has a tree, and these records say which parts of that tree are
// the parser's guess rather than the author's text.
import Span from support.source;
import SyntaxKind from syntax.generated.kind;

export enum RecoveryScope {
    // The parser read on from the same token, so only the construct holding the guess lost meaning.
    Construct,

    // A bracket never arrived, so the construct ran to the end of the file and swallowed whatever
    // followed it. Nothing in the file keeps a shape worth trusting.
    File,
}

export class Recovery {
    Span recoverySpan;
    RecoveryScope recoveryScope;

    public constructor(Span span, RecoveryScope scope) {
        this.recoverySpan = span;
        this.recoveryScope = scope;
    }

    export span() -> Span {
        return this.recoverySpan;
    }

    export scope() -> RecoveryScope {
        return this.recoveryScope;
    }
}

// '}' closes a construct the parser only gives up on at the end of the file, so everything from an
// unclosed brace onward belongs to whatever it guessed. Every other bracket is abandoned in place.
export scopeForMissing(SyntaxKind expected) -> RecoveryScope {
    if (expected == SyntaxKind.CloseBrace) {
        return RecoveryScope.File;
    }
    return RecoveryScope.Construct;
}

// A separator or terminator carries no meaning, and the parser consumes nothing in its place.
export missingCostsNothing(SyntaxKind expected) -> bool {
    return expected == SyntaxKind.Semicolon || expected == SyntaxKind.Comma;
}
