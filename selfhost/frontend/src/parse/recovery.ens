// Where the parser invented something the source did not say, and how far the invention reaches.
// The parser recovers instead of stopping, so a file with a syntax error still has a tree; these
// records say which parts of that tree are the parser's guess rather than the author's text.
//
// A missing ';' or ',' is not recorded. The parser fills one in without consuming a token, so the
// construct around it keeps both its extent and its meaning, and the next construct parses exactly
// as it would have with the separator written.
import Span from support.source;
import SyntaxKind from syntax.generated.kind;

export enum RecoveryScope {
    // Filled in place: the parser read on from the same token, so only the construct holding the
    // guess lost meaning and every construct around it still has the extent the source gave it.
    Construct,

    // A bracket never arrived, so the construct ran to the end of the file and swallowed whatever
    // followed it. Nothing in the file keeps a shape worth trusting.
    File,
}

export class Recovery {
    Span recoverySpan;
    RecoveryScope recoveryScope;

    public constructor(Span span, RecoveryScope scope) {
        this.recoverySpan = span;
        this.recoveryScope = scope;
    }

    export span() -> Span {
        return this.recoverySpan;
    }

    export scope() -> RecoveryScope {
        return this.recoveryScope;
    }
}

// The scope a missing token of this kind leaves behind. '}' closes a construct the parser only
// gives up on at the end of the file, so everything from the unclosed brace onward belongs to
// whatever it guessed; every other bracket is abandoned where it stands.
export scopeForMissing(SyntaxKind expected) -> RecoveryScope {
    if (expected == SyntaxKind.CloseBrace) {
        return RecoveryScope.File;
    }
    return RecoveryScope.Construct;
}

// Whether a missing token of this kind costs anything. A separator or a terminator carries no
// meaning of its own and the parser consumes nothing in its place.
export missingCostsNothing(SyntaxKind expected) -> bool {
    return expected == SyntaxKind.Semicolon || expected == SyntaxKind.Comma;
}
