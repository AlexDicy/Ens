// A diagnostic is a plain message anchored to a source span. The lexer collects these in position
// order; later phases reuse the same shape.
import Span from support.source;

export class Diagnostic {
    string diagnosticMessage;
    Span diagnosticSpan;

    public constructor(string message, Span span) {
        this.diagnosticMessage = message;
        this.diagnosticSpan = span;
    }

    export message() -> string {
        return this.diagnosticMessage;
    }

    export span() -> Span {
        return this.diagnosticSpan;
    }
}
