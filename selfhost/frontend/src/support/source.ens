// Source text and position mapping for the self-hosted front end. All offsets are UTF-8 byte
// offsets; lines and columns are 1-based.

export struct Span {
    export long start;
    export long length;

    export end() -> long {
        return this.start + this.length;
    }
}

export makeSpan(long start, long length) -> Span {
    return {start: start, length: length};
}

export struct LinePosition {
    export long line;
    export long column;
}

export class Source {
    string sourcePath;
    string sourceText;
    byte[] sourceBytes;

    export constructor(string path, string text) {
        this.sourcePath = path;
        this.sourceText = text;
        this.sourceBytes = text.toBytes();
    }

    export path() -> string {
        return this.sourcePath;
    }

    export text() -> string {
        return this.sourceText;
    }

    public length() -> long {
        return this.sourceBytes.length;
    }

    public byteAt(long offset) -> byte {
        return this.sourceBytes[offset];
    }
}

// Maps a byte offset to its 1-based line and byte column. A "\r\n" sequence ends its line at the
// "\n", so both bytes still belong to the line they end.
export class LineIndex {
    long[] lineStarts;

    export constructor(Source source) {
        long lines = 1;
        for (long i = 0; i < source.length(); i++) {
            if (source.byteAt(i) == '\n') {
                lines++;
            }
        }
        long[] starts = new long[lines];
        starts[0] = 0;
        long next = 1;
        for (long i = 0; i < source.length(); i++) {
            if (source.byteAt(i) == '\n') {
                starts[next] = i + 1;
                next++;
            }
        }
        this.lineStarts = starts;
    }

    public lineCount() -> long {
        return this.lineStarts.length;
    }

    export positionAt(long offset) -> LinePosition {
        long index = this.lineIndexOf(offset);
        return {
            line: index + 1,
            column: offset - this.lineStarts[index] + 1,
        };
    }

    // Index of the greatest line start not past the offset.
    lineIndexOf(long offset) -> long {
        long low = 0;
        long high = this.lineStarts.length - 1;
        while (low < high) {
            long middle = (low + high + 1) / 2;
            if (this.lineStarts[middle] <= offset) {
                low = middle;
            } else {
                high = middle - 1;
            }
        }
        return low;
    }
}
