// The corpus round-trip harness over every source and manifest file the build system lists. The
// green tree's full text must reproduce the source byte for byte, including for the parse-error
// fixtures, and a file may carry parse diagnostics only when it holds an "@expect-error" directive.
import @std.system;
import SystemError from @std.system;
import List from @std.collections.list;
import Source from @ens.frontend.support.source;
import @ens.frontend.parse.parser;

// The single argument is the manifest of absolute paths, one per line. Every failure is printed
// before the nonzero exit, so one run names every regression.
main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length < 2) {
        print("corpus: usage: corpus <manifest-path>");
        return 2;
    }
    string manifestText = try system.readAllText(arguments[1]);
    string[] paths = manifestText.lines();

    long total = 0;
    let roundTripFailures = new List<string>();
    let diagnosticFailures = new List<string>();

    for (long i = 0; i < paths.length; i++) {
        string path = paths[i];
        if (path.length == 0) {
            continue;
        }
        total++;
        // A fixture may hold malformed bytes on purpose, and the front end still has to parse what
        // it is given losslessly, so what cannot be decoded is replaced rather than refused.
        string text = string.fromBytesLossy(try system.readAllBytes(path));
        let result = parser.parse(new Source(path, text));

        string produced = result.root().fullText();
        if (produced != text) {
            long offset = firstDifference(text, produced);
            roundTripFailures.push("{path}: round-trip differs at byte {offset} "
                + "(source {text.length} bytes, produced {produced.length} bytes)");
        }

        if (!text.contains("@expect-error")) {
            let diagnostics = result.diagnostics();
            if (diagnostics.length != 0) {
                let span = diagnostics[0].span();
                diagnosticFailures.push("{path}: {diagnostics.length} unexpected parse "
                    + "diagnostic(s); first at byte {span.start} length {span.length}: "
                    + diagnostics[0].message());
            }
        }
    }

    print("corpus: processed {total} file(s)");
    print("corpus: {roundTripFailures.length()} round-trip failure(s), "
        + "{diagnosticFailures.length()} unexpected-diagnostic file(s)");
    for (long i = 0; i < roundTripFailures.length(); i++) {
        print("  round-trip: {roundTripFailures.get(i)}");
    }
    for (long i = 0; i < diagnosticFailures.length(); i++) {
        print("  diagnostic: {diagnosticFailures.get(i)}");
    }

    if (roundTripFailures.length() == 0 && diagnosticFailures.length() == 0) {
        print("corpus: all files round-trip and parse cleanly");
        return 0;
    }
    return 1;
} catch (SystemError e) {
    print("corpus: {e.message}");
    return 2;
}

// The first byte offset at which two strings differ, or the shorter length when one is a prefix of
// the other. Used only to make a round-trip failure report actionable.
firstDifference(string expected, string actual) -> long {
    byte[] expectedBytes = expected.toBytes();
    byte[] actualBytes = actual.toBytes();
    long limit = expectedBytes.length;
    if (actualBytes.length < limit) {
        limit = actualBytes.length;
    }
    for (long i = 0; i < limit; i++) {
        if (expectedBytes[i] != actualBytes[i]) {
            return i;
        }
    }
    return limit;
}
