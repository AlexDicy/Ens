// The link-only libraries a Linux program links against, written from the symbol lists ens carries:
// glibc's C library, maths library and loader, and libgcc_s, which unwinds the stack for a trace.
// A link reads these and never the machine's own, so a Linux program links the same way on every
// machine, and runs on every system with at least the glibc the lists were read at.
import EmbeddedFile from @std.embed;
import EncodingError from @std.text;
import List from @std.collections.list;
import ContentStore from @ens.packages.store;
import Architecture from @ens.target.triple;
import BundledFolder from cache;
import cache;
import SymbolList from symbols;
import symbols;
import elf;

// The folder the libraries for `architecture` are written in, inside the one 'systemLibraries'
// returns.
export folderFor(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "linux-x64",
        Architecture.Arm64 -> "linux-arm64",
    };
}

// What the system libraries export to a Linux program for `architecture`.
export listFor(Architecture architecture) -> SymbolList {
    byte[] text = switch (architecture) {
        Architecture.X64 -> embed "../symbols/linux-x64.symbols",
        Architecture.Arm64 -> embed "../symbols/linux-arm64.symbols",
    };
    return symbols.read(try string.fromBytes(text));
} catch (EncodingError unreadable) {
    panic("Internal: the Linux symbol list ens carries is not UTF-8 text");
}

// Each library's file, at its path inside the folder 'systemLibraries' returns.
export libraryFiles(Architecture architecture) -> string[] {
    let files = new List<string>();
    for (let library in listFor(architecture).libraries()) {
        files.push(folderFor(architecture) + "/" + library.name());
    }
    return files.toArray();
}

// The folder in `store` holding the link-only libraries for `architecture`, written there first
// when no earlier run has written them.
export systemLibraries(ContentStore store, Architecture architecture) -> BundledFolder {
    let files = new List<EmbeddedFile>();
    for (let library in listFor(architecture).libraries()) {
        files.push({path: folderFor(architecture) + "/" + library.name(),
            contents: elf.sharedLibrary(library, architecture)});
    }
    return cache.written(store, files.toArray());
}
