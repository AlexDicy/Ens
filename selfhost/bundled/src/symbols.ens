// The symbol lists ens links a program's system libraries against, in the text form
// scripts/refresh_system_symbols.lua writes: one entry a line, a word saying what it is first, and
// '#' starting a comment.
import List from @std.collections.list;

// What one system library exports, and which SDK the list was read from.
export final class SymbolList {
    string sdk;
    string install;
    string current;
    string[] exported;
    string[] weakExported;

    protected constructor(this.sdk, this.install, this.current, this.exported, this.weakExported);

    // The version of the SDK the list was read from, which a program records as the SDK it was
    // built against.
    export sdkVersion() -> string {
        return this.sdk;
    }

    // The path a program records for the library and loads it from when it runs.
    export installName() -> string {
        return this.install;
    }

    export currentVersion() -> string {
        return this.current;
    }

    export symbols() -> string[] {
        return this.exported;
    }

    // The symbols the library defines as weak, which a program links against like any other.
    export weakSymbols() -> string[] {
        return this.weakExported;
    }
}

// The list `text` holds. The lists are generated and carried inside ens, so a line this cannot
// read is a bug in the script that wrote it.
export read(string text) -> SymbolList {
    string sdk = "";
    string install = "";
    string current = "";
    let exported = new List<string>();
    let weakExported = new List<string>();
    for (let line in text.split("\n")) {
        if (line.length == 0 || line.startsWith("#")) {
            continue;
        }
        long space = line.indexOf(" ");
        if (space <= 0) {
            panic("Internal: the symbol list line '{line}' names no value");
        }
        string value = line.substring(space + 1, line.length);
        switch (line.substring(0, space)) {
            "sdk" -> {
                sdk = value;
            },
            "library" -> {
                long versionAt = value.lastIndexOf(" ");
                if (versionAt <= 0) {
                    panic("Internal: the symbol list line '{line}' names no library version");
                }
                install = value.substring(0, versionAt);
                current = value.substring(versionAt + 1, value.length);
            },
            "symbol" -> {
                exported.push(value);
            },
            "weak-symbol" -> {
                weakExported.push(value);
            },
            default -> {
                panic("Internal: the symbol list line '{line}' starts with a word no list uses");
            },
        }
    }
    if (sdk.length == 0 || install.length == 0) {
        panic("Internal: a symbol list names no SDK or no library");
    }
    return new SymbolList(sdk, install, current, exported.toArray(), weakExported.toArray());
}
