// The standard library this compiler was built with, carried inside it, so a build needs no copy
// of the library on the machine.
import EmbeddedFile from @std.embed;
import List from @std.collections.list;
import ContentStore from @ens.packages.store;
import BundledFolder from cache;
import cache;

// The folder in `store` that holds 'std/', written there first when no earlier run has written it.
export standardLibrary(ContentStore store) -> BundledFolder {
    return cache.written(store, files());
}

// The library's files, laid out the way the folder that holds 'std/' lays them out.
export files() -> EmbeddedFile[] {
    let laidOut = new List<EmbeddedFile>();
    laidOut.push({path: "std/ens.package", contents: embed "../../../libs/std/ens.package"});
    for (let module in embed folder "../../../libs/std/src") {
        laidOut.push({path: "std/src/" + module.path, contents: module.contents});
    }
    return laidOut.toArray();
}
