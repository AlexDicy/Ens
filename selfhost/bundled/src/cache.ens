// Files this compiler carries, written into the cache so a build reads them as it reads any other
// files. The folder is named after the digest of what it holds and moved into place whole, so a
// run never reads a folder another run is still writing, and a compiler carrying different files
// writes a folder of its own.
import EmbeddedFile from @std.embed;
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import ContentStore from @ens.packages.store;
import @ens.packages.hashing;
import @ens.host.scratch;

// Where the files are in the cache, or why they could not be put there.
export final class BundledFolder {
    Path folderPath;
    string problem;
    string leftover;

    protected constructor(this.folderPath, this.problem, this.leftover);

    // The folder holding the files, or an empty path when they could not be put in the cache.
    export path() -> Path {
        return this.folderPath;
    }

    // Why the files could not be put in the cache, or empty text when they are there.
    export failure() -> string {
        return this.problem;
    }

    // What writing the files left in the cache that nothing removed, or empty text. It does not
    // decide whether the files are there.
    export leftBehind() -> string {
        return this.leftover;
    }
}

// The folder in `store` holding exactly `files`, each at its own path, written there first when no
// earlier run has written it.
export written(ContentStore store, EmbeddedFile[] files) -> BundledFolder {
    string digest = hashing.ofFiles(files);
    if (store.hasTree(digest)) {
        return new BundledFolder(store.treeFolder(digest), "", "");
    }
    let staging = store.stage("bundled");
    if (staging.failure().length > 0) {
        return refused(staging.failure(), "");
    }
    return published(store, staging.folder(), digest, files);
}

// Writes the files under `staging` and moves them into the store under `digest`.
published(ContentStore store, Path staging, string digest, EmbeddedFile[] files)
        -> BundledFolder {
    Path tree = staging.join("tree");
    try tree.createDirectories();
    for (let file in files) {
        Path target = tree.join(file.path);
        Path? parent = target.parent();
        if (parent != null) {
            try parent.createDirectories();
        }
        try target.writeBytes(file.contents);
    }
    let stored = try store.publishTree(tree, digest);
    return new BundledFolder(stored.path(), "",
        linesOf(stored.leftBehind(), scratch.discard(staging)));
} catch (FileSystemError stopped) {
    return refused(stopped.message, scratch.discard(staging));
}

linesOf(string first, string second) -> string {
    if (second.length == 0) {
        return first;
    }
    if (first.length == 0) {
        return second;
    }
    return first + "\n" + second;
}

refused(string problem, string leftover) -> BundledFolder {
    return new BundledFolder(Path(""), problem, leftover);
}
