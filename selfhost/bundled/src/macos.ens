// The system library an arm64 macOS program links against, written from the symbol list ens
// carries, so a link needs no SDK from the machine it runs on. libSystem re-exports the rest of the
// C runtime, so every symbol it provides is listed as its own, which is how the system resolves it
// when the program runs.
import ContentStore from @ens.packages.store;
import StringBuilder from @std.text.stringbuilder;
import EncodingError from @std.text;
import BundledFolder from cache;
import cache;
import SymbolList from symbols;
import ExportKind from symbols;
import List from @std.collections.list;
import symbols;

// Where the link-only libSystem is inside the folder 'systemLibrary' writes.
export libSystemFile() -> string {
    return "macos-arm64/libSystem.tbd";
}

// What libSystem exports to an arm64 macOS program.
export arm64List() -> SymbolList {
    return symbols.read(try string.fromBytes(embed "../symbols/macos-arm64.symbols"));
} catch (EncodingError unreadable) {
    panic("Internal: the macOS symbol list ens carries is not UTF-8 text");
}

// The folder in `store` holding the link-only libSystem, written there first when no earlier run
// has written it.
export systemLibrary(ContentStore store) -> BundledFolder {
    return cache.written(store, [{path: libSystemFile(), contents: tbdOf(arm64List()).toBytes()}]);
}

// The list as a text-based library file, the form a macOS SDK describes a system library in and
// the one the linker reads in its place.
export tbdOf(SymbolList list) -> string {
    let library = list.libraries()[0];
    let code = new List<string>();
    let weakCode = new List<string>();
    for (let entry in library.exports()) {
        if (entry.kind() == ExportKind.WeakCode) {
            weakCode.push(entry.name());
        } else {
            code.push(entry.name());
        }
    }
    let text = new StringBuilder();
    text.append("--- !tapi-tbd\n");
    text.append("tbd-version:     4\n");
    text.append("targets:         [ arm64-macos ]\n");
    text.append("install-name:    {quoted(library.name())}\n");
    text.append("current-version: {library.currentVersion()}\n");
    text.append("exports:\n");
    text.append("  - targets:         [ arm64-macos ]\n");
    appendNames(text, "symbols", code.toArray());
    appendNames(text, "weak-symbols", weakCode.toArray());
    text.append("...\n");
    return text.toString();
}

appendNames(StringBuilder text, string key, string[] names) {
    if (names.length == 0) {
        return;
    }
    text.append("    {key}: [ ");
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            text.append(",\n        ");
        }
        text.append(quoted(names[i]));
    }
    text.append(" ]\n");
}

// A name as a single-quoted YAML scalar, which reads every character literally but the quote,
// written twice.
quoted(string name) -> string {
    return "'" + name.replace("'", "''") + "'";
}
