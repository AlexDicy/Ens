// The import libraries a Windows program links against, written from the symbol lists ens carries:
// kernel32, the C runtime Windows ships with the system, and shell32 for reading the command
// line. A link reads these and never the machine's own, so a Windows program that links nothing
// else builds the same way on every machine.
import EmbeddedFile from @std.embed;
import EncodingError from @std.text;
import List from @std.collections.list;
import ContentStore from @ens.packages.store;
import Architecture from @ens.target.triple;
import BundledFolder from cache;
import cache;
import ListedLibrary from symbols;
import SymbolList from symbols;
import symbols;
import coff;

// The folder the libraries for `architecture` are written in, inside the one 'systemLibraries'
// returns.
export folderFor(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "windows-x64",
        Architecture.Arm64 -> "windows-arm64",
    };
}

// What the system lets a Windows program for `architecture` import.
export listFor(Architecture architecture) -> SymbolList {
    byte[] text = switch (architecture) {
        Architecture.X64 -> embed "../symbols/windows-x64.symbols",
        Architecture.Arm64 -> embed "../symbols/windows-arm64.symbols",
    };
    return symbols.read(try string.fromBytes(text));
} catch (EncodingError unreadable) {
    panic("Internal: the Windows symbol list ens carries is not UTF-8 text");
}

// Each import library's file, at its path inside the folder 'systemLibraries' returns.
export libraryFiles(Architecture architecture) -> string[] {
    let files = new List<string>();
    for (let library in listFor(architecture).libraries()) {
        files.push(fileOf(architecture, library));
    }
    return files.toArray();
}

// The folder in `store` holding the import libraries for `architecture`, written there first
// when no earlier run has written them.
export systemLibraries(ContentStore store, Architecture architecture) -> BundledFolder {
    let files = new List<EmbeddedFile>();
    for (let library in listFor(architecture).libraries()) {
        files.push({path: fileOf(architecture, library),
            contents: coff.importLibrary(library, architecture)});
    }
    return cache.written(store, files.toArray());
}

// A DLL's import library is named after it, as 'KERNEL32.dll' has 'KERNEL32.lib'.
fileOf(Architecture architecture, ListedLibrary library) -> string {
    string name = library.name();
    if (name.toLowerAscii().endsWith(".dll")) {
        name = name.substring(0, name.length - 4);
    }
    return folderFor(architecture) + "/" + name + ".lib";
}
