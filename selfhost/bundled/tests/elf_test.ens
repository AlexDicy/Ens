// The link-only shared libraries, read back field by field: what the linker takes from one is the
// soname, the version nodes, and each symbol's kind, section, size and version.
import @std.testing;
import Architecture from @ens.target.triple;
import List from @std.collections.list;
import elf;
import symbols;

field(byte[] bytes, long at, long width) -> long {
    long value = 0;
    for (long i = width - 1; i >= 0; i--) {
        value = (value << 8) | ((bytes[at + i] as long) & 0xff);
    }
    return value;
}

// The text that starts at `at` and runs to the next zero byte.
text(byte[] bytes, long at) -> string throws {
    long end = at;
    while (bytes[end] != 0) {
        end++;
    }
    return try string.fromBytes(bytes.slice(at, end));
}

// Where section `index` starts in the file, and how long it is.
sectionOffset(byte[] bytes, long index) -> long {
    return field(bytes, field(bytes, 40, 8) + index * 64 + 24, 8);
}

sectionSize(byte[] bytes, long index) -> long {
    return field(bytes, field(bytes, 40, 8) + index * 64 + 32, 8);
}

test "a library is a shared object for the architecture, with one section header per part" {
    let list = symbols.read("glibc 2.34\nlibrary libc.so.6\nsymbol memcpy GLIBC_2.14\n");
    byte[] x64 = elf.sharedLibrary(list.libraries()[0], Architecture.X64);
    try testing.assertEqual(field(x64, 0, 4), 0x464c457fL);
    try testing.assertEqual(field(x64, 16, 2), 3L);
    try testing.assertEqual(field(x64, 18, 2), 62L);
    try testing.assertEqual(field(x64, 60, 2), 10L);
    try testing.assertEqual(field(x64, 62, 2), 9L);
    byte[] arm64 = elf.sharedLibrary(list.libraries()[0], Architecture.Arm64);
    try testing.assertEqual(field(arm64, 18, 2), 183L);
}

test "every symbol carries its kind, its size, and the version a program records it under" {
    let list = symbols.read("glibc 2.34\nlibrary libc.so.6\nsymbol memcpy GLIBC_2.14\n"
        + "object stdout GLIBC_2.2.5 8\nsymbol __libc_start_main GLIBC_2.34\n");
    byte[] bytes = elf.sharedLibrary(list.libraries()[0], Architecture.X64);
    long symbolsAt = sectionOffset(bytes, 4);
    long stringsAt = sectionOffset(bytes, 5);
    long versionsAt = sectionOffset(bytes, 6);
    try testing.assertEqual(sectionSize(bytes, 4), 4L * 24);

    long stdoutAt = symbolsAt + 2 * 24;
    try testing.assertEqual(try text(bytes, stringsAt + field(bytes, stdoutAt, 4)), "stdout");
    try testing.assertEqual(field(bytes, stdoutAt + 4, 1), 0x11L);
    try testing.assertEqual(field(bytes, stdoutAt + 6, 2), 2L);
    try testing.assertEqual(field(bytes, stdoutAt + 16, 8), 8L);
    try testing.assertEqual(field(bytes, symbolsAt + 24 + 4, 1), 0x12L);

    try testing.assertEqual(field(bytes, versionsAt, 2), 0L);
    try testing.assertEqual(field(bytes, versionsAt + 2, 2), 2L);
    try testing.assertEqual(field(bytes, versionsAt + 4, 2), 3L);
    try testing.assertEqual(field(bytes, versionsAt + 6, 2), 4L);

    long definitionsAt = sectionOffset(bytes, 7);
    let named = new List<string>();
    long at = definitionsAt;
    for (long i = 0; i < 4; i++) {
        long auxiliary = at + field(bytes, at + 12, 4);
        named.push(try text(bytes, stringsAt + field(bytes, auxiliary, 4)));
        at = at + field(bytes, at + 16, 4);
    }
    try testing.assertEqual(string.joined(named.toArray(), " "),
        "libc.so.6 GLIBC_2.14 GLIBC_2.2.5 GLIBC_2.34");
}

test "the dynamic section names the library by its soname" {
    let list = symbols.read("glibc 2.34\nlibrary libgcc_s.so.1\nsymbol _Unwind_Backtrace GCC_3.3\n");
    byte[] bytes = elf.sharedLibrary(list.libraries()[0], Architecture.Arm64);
    long dynamicAt = sectionOffset(bytes, 8);
    try testing.assertEqual(field(bytes, dynamicAt, 8), 14L);
    try testing.assertEqual(try text(bytes, sectionOffset(bytes, 5)
        + field(bytes, dynamicAt + 8, 8)), "libgcc_s.so.1");
}
