// The Windows libraries ens carries: what their lists hold for each processor, and the files they
// are written as.
import @std.testing;
import Map from @std.collections.map;
import TemporaryDirectory from @std.fs.temporary;
import ContentStore from @ens.packages.store;
import Architecture from @ens.target.triple;
import Export from symbols;
import windows;

// Every entry of the list for `architecture`, under its DLL's name and its own.
entries(Architecture architecture) -> Map<string, Export> {
    let found = new Map<string, Export>();
    for (let library in windows.listFor(architecture).libraries()) {
        for (let entry in library.exports()) {
            found.set(library.name() + " " + entry.name(), entry);
        }
    }
    return found;
}

test "each processor's list holds what a program starts, traces and copies memory through" {
    for (let architecture in [Architecture.X64, Architecture.Arm64]) {
        let found = entries(architecture);
        for (let wanted in ["KERNEL32.dll GetCommandLineW", "KERNEL32.dll RtlCaptureStackBackTrace",
                "KERNEL32.dll RtlCopyMemory", "KERNEL32.dll RtlMoveMemory",
                "KERNEL32.dll RtlFillMemory", "KERNEL32.dll RtlCompareMemory",
                "SHELL32.dll CommandLineToArgvW", "api-ms-win-crt-heap-l1-1-0.dll malloc",
                "api-ms-win-crt-stdio-l1-1-0.dll __stdio_common_vsprintf",
                "api-ms-win-crt-runtime-l1-1-0.dll exit"]) {
            try testing.assertTrue(found.get(wanted) != null, "'{wanted}' is not listed");
        }
        try testing.assertTrue(found.get("ntdll.dll memcpy") == null,
            "the list names what only ntdll provides");
    }
}

test "the import libraries are written into the cache, one a DLL, named after it" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let written = windows.systemLibraries(new ContentStore(holder.path()), Architecture.X64);
    try testing.assertEqual(written.failure(), "");
    string[] files = windows.libraryFiles(Architecture.X64);
    try testing.assertEqual(files[0], "windows-x64/KERNEL32.lib");
    try testing.assertEqual(files[1], "windows-x64/SHELL32.lib");
    for (let file in files) {
        try testing.assertTrue(written.path().join(file).isFile(), "'{file}' was not written");
    }
}
