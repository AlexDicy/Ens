// Reading a symbol list in the form the refresh script writes it.
import @std.testing;
import ExportKind from symbols;
import symbols;

test "a macOS list names its SDK and library, and every symbol in the order it lists them" {
    let list = symbols.read("# a comment\nsdk 26.5\nlibrary /usr/lib/libSystem.B.dylib 1356\n"
        + "symbol _abort\nweak-symbol _hook\nsymbol R8289209$_close\n\n");
    try testing.assertEqual(list.sdkVersion(), "26.5");
    try testing.assertEqual(list.libraries().length, 1L);
    let library = list.libraries()[0];
    try testing.assertEqual(library.name(), "/usr/lib/libSystem.B.dylib");
    try testing.assertEqual(library.currentVersion(), "1356");
    let entries = library.exports();
    try testing.assertEqual(entries.length, 3L);
    try testing.assertEqual(entries[1].name(), "_hook");
    try testing.assertEqual(entries[1].kind(), ExportKind.WeakCode);
    try testing.assertEqual(entries[2].name(), "R8289209$_close");
}

test "a Linux list holds several libraries, each entry with its version and data with its size" {
    let list = symbols.read("glibc 2.34\nlibrary libc.so.6\nsymbol memcpy GLIBC_2.14\n"
        + "object stdout GLIBC_2.2.5 8\ntls counter GLIBC_2.30 4\nlibrary libgcc_s.so.1\n"
        + "symbol _Unwind_Backtrace GCC_3.3\n");
    try testing.assertEqual(list.glibcVersion(), "2.34");
    try testing.assertEqual(list.libraries().length, 2L);
    let libc = list.libraries()[0];
    try testing.assertEqual(libc.name(), "libc.so.6");
    try testing.assertEqual(libc.exports()[0].version(), "GLIBC_2.14");
    try testing.assertEqual(libc.exports()[1].kind(), ExportKind.Data);
    try testing.assertEqual(libc.exports()[1].size(), 8L);
    try testing.assertEqual(libc.exports()[2].kind(), ExportKind.ThreadData);
    try testing.assertEqual(list.libraries()[1].exports()[0].name(), "_Unwind_Backtrace");
}
