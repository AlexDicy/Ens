// Reading a symbol list in the form the refresh script writes it.
import @std.testing;
import symbols;

test "a list names its SDK and library, and every symbol in the order it lists them" {
    let list = symbols.read("# a comment\nsdk 26.5\nlibrary /usr/lib/libSystem.B.dylib 1356\n"
        + "symbol _abort\nweak-symbol _hook\nsymbol R8289209$_close\n\n");
    try testing.assertEqual(list.sdkVersion(), "26.5");
    try testing.assertEqual(list.installName(), "/usr/lib/libSystem.B.dylib");
    try testing.assertEqual(list.currentVersion(), "1356");
    try testing.assertEqual(string.joined(list.symbols(), " "), "_abort R8289209$_close");
    try testing.assertEqual(string.joined(list.weakSymbols(), " "), "_hook");
}
