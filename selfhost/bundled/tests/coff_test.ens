// The import libraries, read back member by member: the archive's symbol table names each
// symbol's member, and each member imports one symbol from the DLL for the right machine.
import @std.testing;
import Architecture from @ens.target.triple;
import coff;
import symbols;

field(byte[] bytes, long at, long width) -> long {
    long value = 0;
    for (long i = width - 1; i >= 0; i--) {
        value = (value << 8) | ((bytes[at + i] as long) & 0xff);
    }
    return value;
}

bigEndianField(byte[] bytes, long at) -> long {
    long value = 0;
    for (long i = 0; i < 4; i++) {
        value = (value << 8) | ((bytes[at + i] as long) & 0xff);
    }
    return value;
}

// The text that starts at `at` and runs to the next zero byte.
text(byte[] bytes, long at) -> string throws {
    long end = at;
    while (bytes[end] != 0) {
        end++;
    }
    return try string.fromBytes(bytes.slice(at, end));
}

// The text of a header field, without the spaces that pad it.
headerField(byte[] bytes, long at, long width) -> string throws {
    return (try string.fromBytes(bytes.slice(at, at + width))).trim();
}

test "an import library is an archive whose symbol table names a member for each symbol" {
    let list = symbols.read("sdk 10\nlibrary KERNEL32.dll\nsymbol CloseHandle\n"
        + "data NlsAnsiCodePage\n");
    byte[] bytes = coff.importLibrary(list.libraries()[0], Architecture.X64);
    try testing.assertEqual(try string.fromBytes(bytes.slice(0, 8)), "!<arch>\n");
    try testing.assertEqual(try headerField(bytes, 8, 16), "/");
    long tableAt = 8 + 60;
    try testing.assertEqual(bigEndianField(bytes, tableAt), 3L);
    long namesAt = tableAt + 4 + 4 * 3;
    try testing.assertEqual(try text(bytes, namesAt), "__imp_CloseHandle");
    long second = namesAt + "__imp_CloseHandle".length + 1;
    try testing.assertEqual(try text(bytes, second), "CloseHandle");
    long third = second + "CloseHandle".length + 1;
    try testing.assertEqual(try text(bytes, third), "__imp_NlsAnsiCodePage");

    long firstMember = bigEndianField(bytes, tableAt + 4);
    try testing.assertEqual(bigEndianField(bytes, tableAt + 8), firstMember);
    try testing.assertEqual(try headerField(bytes, firstMember, 16), "/0");
    long header = firstMember + 60;
    try testing.assertEqual(field(bytes, header, 2), 0L);
    try testing.assertEqual(field(bytes, header + 2, 2), 0xffffL);
    try testing.assertEqual(field(bytes, header + 6, 2), 0x8664L);
    try testing.assertEqual(field(bytes, header + 18, 2), 1L << 2);
    try testing.assertEqual(try text(bytes, header + 20), "CloseHandle");
    try testing.assertEqual(try text(bytes, header + 20 + "CloseHandle".length + 1),
        "KERNEL32.dll");

    long dataMember = bigEndianField(bytes, tableAt + 12);
    long dataHeader = dataMember + 60;
    try testing.assertEqual(field(bytes, dataHeader + 18, 2), 1L | (1L << 2));
    try testing.assertEqual(try text(bytes, dataHeader + 20), "NlsAnsiCodePage");
}

test "the machine follows the architecture" {
    let list = symbols.read("sdk 10\nlibrary SHELL32.dll\nsymbol CommandLineToArgvW\n");
    byte[] bytes = coff.importLibrary(list.libraries()[0], Architecture.Arm64);
    long firstMember = bigEndianField(bytes, 8 + 60 + 4);
    try testing.assertEqual(field(bytes, firstMember + 60 + 6, 2), 0xaa64L);
}
