// The link-only libSystem: what the list ens carries holds, the file it is written as, and where
// that file goes in the cache.
import @std.testing;
import Set from @std.collections.set;
import TemporaryDirectory from @std.fs.temporary;
import ContentStore from @ens.packages.store;
import macos;
import symbols;

test "the list ens carries is libSystem's, read from an SDK, and holds what a program calls" {
    let list = macos.arm64List();
    try testing.assertEqual(list.libraries()[0].name(), "/usr/lib/libSystem.B.dylib");
    try testing.assertTrue(list.sdkVersion().length > 0, "the list names no SDK");
    let listed = new Set<string>();
    for (let entry in list.libraries()[0].exports()) {
        listed.add(entry.name());
    }
    for (let wanted in ["_malloc", "_write", "__Unwind_Resume", "___stack_chk_fail",
            "dyld_stub_binder"]) {
        try testing.assertTrue(listed.contains(wanted), "'{wanted}' is not listed");
    }
}

test "a list is written as a text-based library file with every name quoted" {
    let list = symbols.read("sdk 26.5\nlibrary /usr/lib/libSystem.B.dylib 1356\nsymbol _abort\n"
        + "symbol R8289209$_close\nsymbol _it's\nweak-symbol _hook\n");
    try testing.assertEqual(macos.tbdOf(list), "--- !tapi-tbd\n"
        + "tbd-version:     4\n"
        + "targets:         [ arm64-macos ]\n"
        + "install-name:    '/usr/lib/libSystem.B.dylib'\n"
        + "current-version: 1356\n"
        + "exports:\n"
        + "  - targets:         [ arm64-macos ]\n"
        + "    symbols: [ '_abort',\n"
        + "        'R8289209$_close',\n"
        + "        '_it''s' ]\n"
        + "    weak-symbols: [ '_hook' ]\n"
        + "...\n");
}

test "the link-only libSystem is written into the cache once" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let store = new ContentStore(holder.path());
    let first = macos.systemLibrary(store);
    try testing.assertEqual(first.failure(), "");
    let written = try first.path().join(macos.libSystemFile()).readText();
    try testing.assertEqual(written, macos.tbdOf(macos.arm64List()));
    try testing.assertEqual(macos.systemLibrary(store).path(), first.path());
}
