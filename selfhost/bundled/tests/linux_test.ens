// The Linux libraries ens carries: what their lists hold for each architecture, and the files
// they are written as.
import @std.testing;
import Map from @std.collections.map;
import TemporaryDirectory from @std.fs.temporary;
import ContentStore from @ens.packages.store;
import Architecture from @ens.target.triple;
import Export from symbols;
import linux;

// Every entry of the list for `architecture`, under its library's name and its own.
entries(Architecture architecture) -> Map<string, Export> {
    let found = new Map<string, Export>();
    for (let library in linux.listFor(architecture).libraries()) {
        for (let entry in library.exports()) {
            found.set(library.name() + " " + entry.name(), entry);
        }
    }
    return found;
}

test "each architecture's list holds what a program starts and traces through, at glibc 2.34" {
    for (let architecture in [Architecture.X64, Architecture.Arm64]) {
        try testing.assertEqual(linux.listFor(architecture).glibcVersion(), "2.34");
        let found = entries(architecture);
        try testing.assertEqual(found.get("libc.so.6 __libc_start_main")?.version(),
            "GLIBC_2.34");
        try testing.assertEqual(found.get("libc.so.6 stdout")?.size(), 8L);
        try testing.assertEqual(found.get("libgcc_s.so.1 _Unwind_Backtrace")?.version(),
            "GCC_3.3");
        try testing.assertTrue(found.get("libc.so.6 malloc") != null, "'malloc' is not listed");
    }
    try testing.assertEqual(entries(Architecture.X64).get("libc.so.6 memcpy")?.version(),
        "GLIBC_2.14");
    try testing.assertEqual(entries(Architecture.Arm64).get("libc.so.6 memcpy")?.version(),
        "GLIBC_2.17");
}

test "the libraries are written into the cache, one file a library, under the architecture" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let written = linux.systemLibraries(new ContentStore(holder.path()), Architecture.Arm64);
    try testing.assertEqual(written.failure(), "");
    try testing.assertEqual(string.joined(linux.libraryFiles(Architecture.Arm64), " "),
        "linux-arm64/libc.so.6 linux-arm64/libm.so.6 linux-arm64/ld-linux-aarch64.so.1 "
            + "linux-arm64/libgcc_s.so.1");
    for (let file in linux.libraryFiles(Architecture.Arm64)) {
        try testing.assertTrue(written.path().join(file).isFile(), "'{file}' was not written");
    }
}
