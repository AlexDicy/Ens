// The standard library as this compiler carries it.
import @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import ContentStore from @ens.packages.store;
import library;

test "the library is laid out under 'std/', with its manifest and the modules every program reads" {
    for (let file in library.files()) {
        try testing.assertTrue(file.path.startsWith("std/"), "'{file.path}' is outside 'std/'");
    }
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let written = library.standardLibrary(new ContentStore(holder.path()));
    try testing.assertEqual(written.failure(), "");
    for (let module in ["std/ens.package", "std/src/core.ens", "std/src/io/print.ens",
            "std/src/embed.ens"]) {
        try testing.assertTrue(written.path().join(module).isFile(), "'{module}' was not written");
    }
}
