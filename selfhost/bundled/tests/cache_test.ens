// Writing carried files into a real store, since what the cache guarantees is about folders the
// operating system creates and moves.
import @std.testing;
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import EmbeddedFile from @std.embed;
import ContentStore from @ens.packages.store;
import @ens.packages.hashing;
import cache;

files() -> EmbeddedFile[] {
    EmbeddedFile manifest = {path: "lib/ens.package", contents: "the manifest\n".toBytes()};
    EmbeddedFile module = {path: "lib/src/deep/module.ens", contents: "the module\n".toBytes()};
    return [manifest, module];
}

test "files are written under their digest, and a later run reads the same folder" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let store = new ContentStore(holder.path());
    let first = cache.written(store, files());
    try testing.assertEqual(first.failure(), "");
    try testing.assertEqual(first.leftBehind(), "");
    try testing.assertEqual(first.path(), store.treeFolder(hashing.ofFiles(files())));
    try testing.assertEqual(try first.path().join("lib/src/deep/module.ens").readText(),
        "the module\n");
    try testing.assertEqual(try hashing.ofTree(first.path()), hashing.ofFiles(files()));
    try testing.assertEqual(string.joined(try hashing.filesUnder(holder.path().join("staging")),
        " "), "");

    let second = cache.written(store, files());
    try testing.assertEqual(second.failure(), "");
    try testing.assertEqual(second.path(), first.path());
}

test "a folder an interrupted run left half written is never read" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let store = new ContentStore(holder.path());
    Path abandoned = holder.path().join("staging/bundled-1/tree/lib");
    try abandoned.createDirectories();
    try abandoned.join("ens.package").writeText("half");
    let written = cache.written(store, files());
    try testing.assertEqual(written.failure(), "");
    try testing.assertEqual(try written.path().join("lib/ens.package").readText(),
        "the manifest\n");
}

test "different files are written to a folder of their own" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    let store = new ContentStore(holder.path());
    let first = cache.written(store, files());
    EmbeddedFile changed = {path: "lib/ens.package", contents: "another manifest\n".toBytes()};
    let second = cache.written(store, [changed]);
    try testing.assertTrue(second.path() != first.path(), "two sets of files shared a folder");
    try testing.assertEqual(try first.path().join("lib/ens.package").readText(), "the manifest\n");
}

test "a store that cannot be written to says why, and names no folder" {
    let holder = try TemporaryDirectory.create("ens-bundled-test");
    Path blocked = holder.path().join("cache");
    try blocked.writeText("a file where the cache would be");
    let written = cache.written(new ContentStore(blocked), files());
    try testing.assertEqual(written.path(), Path(""));
    try testing.assertEqual(written.failure(), "could not create the directory "
        + "'{blocked.join("staging")}': something in the path is a file, not a directory");
}
