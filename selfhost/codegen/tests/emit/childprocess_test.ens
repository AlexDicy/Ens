// Tests for the bridges that start and drive a child, each defined from inside a host function
// exactly as emission does and checked with the real LLVM verifier. A retarget that passes proves
// the half builds well-formed IR and proves nothing about whether a number in it is true.
import @std.testing;
import @ens.llvm.memory;
import @ens.llvm.target;
import EmissionHost from support;
import OutputRecord from emit.childprocess;
import PosixChild from emit.childprocess;
import WindowsChild from emit.childprocess;
import WatchSlot from emit.pollers;
import emit.childprocess;
import emit.clock;
import emit.nativeshapes;
import support;

// One call of every child bridge, with the arguments a start takes in the order it takes them.
callEveryBridge(EmissionHost host) {
    let runtime = host.runtime;
    let text = runtime.payloadData(runtime.stringLiteral("git".toBytes()));
    let error = memory.buildAlloca(host.builder, runtime.int32Type, "error");
    let count = memory.buildAlloca(host.builder, runtime.int64Type, "count");
    let code = memory.buildAlloca(host.builder, runtime.int32Type, "code");
    let signal = memory.buildAlloca(host.builder, runtime.int32Type, "signal");
    let ready = memory.buildAlloca(host.builder, runtime.int32Type, "ready");
    let child = runtime.call(childprocess.startRuntime(runtime), [text, text, runtime.int64(1),
        text, text, runtime.int64(0), runtime.int64(2), runtime.int32(1), text, runtime.int32(1),
        runtime.int32(1), runtime.int32(1), error], "child");
    runtime.call(childprocess.pollRuntime(runtime), [child, runtime.int64(250), ready], "polled");
    runtime.call(childprocess.readRuntime(runtime), [child, runtime.int32(1), text,
        runtime.int64(3), count], "read");
    runtime.call(childprocess.writeRuntime(runtime), [child, text, runtime.int64(3), count],
        "written");
    runtime.call(childprocess.closeInputRuntime(runtime), [child], "closed");
    runtime.call(childprocess.waitRuntime(runtime), [child, code, signal], "waited");
    runtime.call(childprocess.killRuntime(runtime), [child], "stopped");
    runtime.call(childprocess.releaseRuntime(runtime), [child], "");
    runtime.call(clock.monotonicMillisRuntime(runtime), [], "now");
}

test "the child bridges and the clock verify on the host" {
    let host = new EmissionHost("childprocess_host");
    callEveryBridge(host);
    try host.finish();
}

test "each child bridge is defined once however often it is called" {
    let host = new EmissionHost("childprocess_reuse");
    let first = childprocess.startRuntime(host.runtime);
    let second = childprocess.startRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the start");
    let firstRead = childprocess.readRuntime(host.runtime);
    try testing.assertTrue(
        firstRead.function == childprocess.readRuntime(host.runtime).function,
        "the second use redefined the read");
    let firstClock = clock.monotonicMillisRuntime(host.runtime);
    try testing.assertTrue(
        firstClock.function == clock.monotonicMillisRuntime(host.runtime).function,
        "the second use redefined the clock");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal ptr @ens_process_start(") >= 0,
        "the start was never defined: {text}");
    try testing.assertTrue(text.indexOf("define internal i32 @ens_process_read(") >= 0,
        "the read was never defined: {text}");
    let firstPoll = childprocess.pollRuntime(host.runtime);
    try testing.assertTrue(
        firstPoll.function == childprocess.pollRuntime(host.runtime).function,
        "the second use redefined the poll");
    string polled = host.text();
    try testing.assertTrue(polled.indexOf("define internal i32 @ens_process_poll(") >= 0,
        "the poll was never defined: {polled}");
    try testing.assertTrue(text.indexOf("define internal i64 @ens_monotonic_millis()") >= 0,
        "the clock was never defined: {text}");
    try host.finish();
}

// Only the host platform's half of a bridge reaches an object file, so the other halves are held
// to the verifier here instead.
test "every target's child bridges build code the verifier accepts" {
    for (let triple in coveredTriples()) {
        let host = new EmissionHost("childprocess_{triple}");
        host.retarget(triple);
        callEveryBridge(host);
        try host.finish();
    }
}

// Every target with a half of its own and this machine's own triple, which is the half its object
// files actually hold.
coveredTriples() -> string[] {
    return [target.hostTargetTriple(), "x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23",
        "aarch64-apple-darwin23"];
}

// A working directory that cannot be entered carries 7 above its number when a file is at its path
// and 2 otherwise. The kind of what is there is read only after the change of directory failed
// with the number for a path that is not a directory.
test "a start tells a working directory that is a file from one that is not there" {
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"]) {
        let host = new EmissionHost("childprocess_directory_{triple}");
        host.retarget(triple);
        childprocess.startRuntime(host.runtime);
        string text = host.text();
        try assertHolds(triple, text, "label %child.directory.file, label %start.child.report");
        try assertHolds(triple, text, "select i1 %directory.file, i32 7, i32 2");
        try host.finish();
    }
    let host = new EmissionHost("childprocess_directory_windows");
    host.retarget("x86_64-pc-windows-msvc");
    childprocess.startRuntime(host.runtime);
    string text = host.text();
    try assertHolds("windows", text, "label %start.cause.program, label %start.cause.directory");
    try assertHolds("windows", text, "select i1 %missing, i32 2, i32 7");
    try testing.assertTrue(text.indexOf("@GetFileAttributesW(") > text.indexOf("@CreateProcessW("),
        "windows: the file system is asked before the start: {text}");
    try host.finish();
}

// A failed exec carries what it failed on above errno: 3 for a path naming a directory, 4 for a
// program image of any system's format the system could not run, 5 for a file that is no program,
// 6 for a special file such as a named pipe, 8 for a script whose first line names a program that
// is not there, 9 for a runnable file that starts neither as an image nor as a script, 10 for a
// refusal on a runnable program image, 11 for a script the system would not start or refused over
// the program its first line names, and 1 otherwise. A file is opened only once its kind shows it
// is a regular file, or once the system reported it could not run it, so a pipe that would block
// the open is never opened. A file that cannot be opened counts as one that may hold a program.
test "a POSIX start carries the part of the start its exec failed on" {
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"]) {
        let host = new EmissionHost("childprocess_cause_{triple}");
        host.retarget(triple);
        childprocess.startRuntime(host.runtime);
        string text = host.text();
        let flags = nativeshapes.openFlags(support.targetOf(triple).platform());
        long magicFlags = flags.readOnly | flags.nonBlocking | flags.noControllingTerminal;
        try assertHolds(triple, text, "@strchr(ptr %0, i32 47)");
        try assertHolds(triple, text, "label %exec.cause.unrunnable, label %exec.cause.refused");
        try assertBlockHolds(triple, text, "exec.cause.unrunnable", ["store i32 4, ptr %cause",
            "label %exec.cause.image, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.image",
            ["@open(ptr %0, i32 {magicFlags})", "label %exec.magic.read, label %exec.magic.done"]);
        try assertBlockHolds(triple, text, "exec.magic.read", ["@read(", "@close("]);
        try assertBlockHolds(triple, text, "exec.magic.done", ["%image = or i1",
            "i1 %script, i32 11, i32 9", "i1 %image, i32 4, i32 %"]);
        try assertBlockHolds(triple, text, "exec.cause.refused",
            ["label %exec.cause.kind, label %exec.cause.missing"]);
        try assertBlockHolds(triple, text, "exec.cause.kind", ["i32 3, i32 %", "i32 10, i32 6",
            "label %exec.cause.regular, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.regular",
            ["@open(ptr %0, i32 {magicFlags})"]);
        for (let line in ["xor i1 %magic.opened", "%holds.program = or i1",
                "%runnable.cause = select i1 %script", ", i32 11, i32 10",
                "select i1 %runnable, i32 %runnable.cause, i32 1",
                "select i1 %holds.program, i32 %"]) {
            try assertHolds(triple, text, line);
        }
        try assertBlockHolds(triple, text, "exec.cause.missing",
            ["label %exec.cause.left, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.left", ["i32 8, i32 1"]);
        try assertBlockHolds(triple, text, "exec.cause.done", ["shl i32 %cause.found, 24",
            "store i32 %caused"]);
        try host.finish();
    }
}

// Flushing every stream locks each one, which waits on a thread opening or closing a file at that
// moment, so a start flushes only the two streams a child shares with this process.
test "a start flushes standard output and standard error and no other stream" {
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin23",
            "x86_64-pc-windows-msvc"]) {
        let host = new EmissionHost("childprocess_flush_{triple}");
        host.retarget(triple);
        childprocess.startRuntime(host.runtime);
        string text = host.text();
        string start = text.substring(text.indexOf("@ens_process_start("), text.length);
        start = start.substring(0, start.indexOf("\n}"));
        try testing.assertTrue(start.indexOf("@fflush(ptr null)") < 0,
            "{triple}: a start flushes every stream: {start}");
        long first = start.indexOf("call i32 @fflush(ptr %");
        try testing.assertTrue(first >= 0
            && start.indexOf("call i32 @fflush(ptr %", first + 1) > first,
            "{triple}: a start does not flush both standard streams: {start}");
        try host.finish();
    }
}

// A failed CreateProcessW carries what it failed on above its number: 3 for a program path naming
// a directory, 4 for a file with the 'MZ' header Windows could not run, 5 for one without it, and
// 1 otherwise. The file system is asked only once the start has failed.
test "a Windows start carries the part of the start it failed on" {
    let host = new EmissionHost("childprocess_cause_windows");
    host.retarget("x86_64-pc-windows-msvc");
    childprocess.startRuntime(host.runtime);
    string text = host.text();
    try assertBlockHolds("windows", text, "start.cause.program",
        ["store i32 1, ptr %program.cause", ", 5",
        "label %start.cause.program.directory, label %start.cause.program.format"]);
    try assertBlockHolds("windows", text, "start.cause.program.directory",
        ["@GetFileAttributesW(ptr %program)", "select i1 %directory", ", i32 3, i32 1"]);
    try assertBlockHolds("windows", text, "start.cause.program.format", [", 193", ", 216",
        "%unrunnable = or i1",
        "label %start.cause.program.image, label %start.cause.program.done"]);
    try assertBlockHolds("windows", text, "start.cause.program.image",
        ["@CreateFileW(ptr %program, i32 -2147483648"]);
    try assertBlockHolds("windows", text, "start.cause.header.read", ["@ReadFile(", "i32 2",
        "@CloseHandle("]);
    try assertBlockHolds("windows", text, "start.cause.header.done",
        ["icmp eq i16 %header.word, 23117", "select i1 %image.header, i32 4, i32 5"]);
    try assertBlockHolds("windows", text, "start.cause.done", ["shl i32 %cause.found, 24"]);
    try testing.assertTrue(text.indexOf("@GetFileAttributesW(") > text.indexOf("@CreateProcessW("),
        "windows: the file system is asked before the start: {text}");
    try host.finish();
}

// Fails unless the printed module holds the line.
assertHolds(string triple, string text, string line) throws {
    try testing.assertTrue(text.indexOf(line) >= 0, "{triple}: no '{line}' in: {text}");
}

// Fails unless the block of the printed module under `label` holds every one of the lines.
assertBlockHolds(string triple, string text, string label, string[] lines) throws {
    string block = blockText(text, label);
    for (let line in lines) {
        try testing.assertTrue(block.indexOf(line) >= 0,
            "{triple}: block '{label}' has no '{line}': {block}");
    }
}

// The block under `label`, from its label to the blank line that ends it, and empty when the
// printed module has no such block.
blockText(string text, string label) -> string {
    long start = text.indexOf("\n{label}:");
    if (start < 0) {
        return "";
    }
    long end = text.indexOf("\n\n", start + 1);
    if (end < 0) {
        return text.substring(start + 1);
    }
    return text.substring(start + 1, end);
}

// A field read at an offset another field also uses would serve both, so the layouts are held
// to being disjoint and inside the block rather than to their numbers.
test "a POSIX child's block holds its fields apart and inside the block" {
    long[] offsets = [PosixChild.pid, PosixChild.pidDescriptor, PosixChild.input,
        PosixChild.output, PosixChild.errors, PosixChild.outputEnded, PosixChild.errorsEnded,
        PosixChild.reaped, PosixChild.code, PosixChild.signal];
    try assertDisjoint(offsets, 4, PosixChild.structBytes);
}

test "a Windows child's block holds its handles, two records, its status and a watch apart" {
    long[] wide = [WindowsChild.process, WindowsChild.input];
    try assertDisjoint(wide, 8, WindowsChild.output);
    try testing.assertTrue(
        WindowsChild.output + OutputRecord.structBytes <= WindowsChild.errors,
        "the output record runs into the errors record");
    try testing.assertTrue(
        WindowsChild.errors + OutputRecord.structBytes <= WindowsChild.reaped,
        "the errors record runs into the status");
    long[] status = [WindowsChild.reaped, WindowsChild.code, WindowsChild.signal,
        WindowsChild.killed];
    try assertDisjoint(status, 4, WindowsChild.endWatch);
    try testing.assertTrue(WindowsChild.endWatch % 8 == 0
        && WindowsChild.endWatch + WatchSlot.bytes <= WindowsChild.structBytes,
        "the end's watch slot is unaligned or runs past the block");
    try testing.assertEqual(WindowsChild.structBytes % 8, 0);
}

test "an output record holds its handles, its OVERLAPPED, its counters and its watch apart" {
    try testing.assertTrue(OutputRecord.event >= OutputRecord.pipe + 8, "the event overlaps the pipe");
    try testing.assertTrue(OutputRecord.overlapped >= OutputRecord.event + 8,
        "the OVERLAPPED overlaps the event");
    try testing.assertTrue(OutputRecord.staging >= OutputRecord.overlapped + 32,
        "the staging pointer sits inside the OVERLAPPED");
    long[] counters = [OutputRecord.filled, OutputRecord.consumed, OutputRecord.pending,
        OutputRecord.ended, OutputRecord.closed];
    try testing.assertTrue(OutputRecord.filled >= OutputRecord.staging + 8,
        "the counters overlap the staging pointer");
    try assertDisjoint(counters, 4, OutputRecord.watch);
    try testing.assertTrue(OutputRecord.watch % 8 == 0
        && OutputRecord.watch + WatchSlot.bytes <= OutputRecord.structBytes,
        "the watch slot is unaligned or runs past the record");
    try testing.assertEqual(OutputRecord.structBytes % 8, 0);
}

// Every offset at least `width` bytes from every other and at most `limit` minus `width`.
assertDisjoint(long[] offsets, long width, long limit) throws {
    for (long i = 0; i < offsets.length; i++) {
        try testing.assertTrue(offsets[i] + width <= limit,
            "the field at {offsets[i]} runs past the block of {limit} bytes");
        for (long j = i + 1; j < offsets.length; j++) {
            long apart = offsets[i] - offsets[j];
            if (apart < 0) {
                apart = 0 - apart;
            }
            try testing.assertTrue(apart >= width,
                "the fields at {offsets[i]} and {offsets[j]} overlap");
        }
    }
}
