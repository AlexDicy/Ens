// Tests for the bridges that ask about one path. Each one defines the bridge from inside a host
// function exactly as emission does and asserts the real LLVM verifier accepts the module.
import @std.testing;
import @ens.llvm.memory;
import @ens.llvm.target;
import EmissionHost from support;
import emit.filesystem;

test "the path kind bridge verifies" {
    let host = new EmissionHost("filesystem_kind");
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.pathKindRuntime(host.runtime), [path], "kind");
    try host.finish();
}

test "the create directory bridge verifies" {
    let host = new EmissionHost("filesystem_create");
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.createDirectoryRuntime(host.runtime), [path], "created");
    try host.finish();
}

test "a path bridge needed twice is defined once" {
    let host = new EmissionHost("filesystem_reuse");
    let first = filesystem.pathKindRuntime(host.runtime);
    let second = filesystem.pathKindRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the bridge");
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(first, [path], "kind");
    try host.finish();
}

// Only the host platform's half of a bridge reaches an object file, so the other halves are held
// to the verifier here instead. Two of the three seed hosts cannot be run by hand.
test "every target's metadata half builds code the verifier accepts" {
    for (let triple in coveredTriples()) {
        let host = new EmissionHost("filesystem_metadata_{triple}");
        host.retarget(triple);
        let path = host.runtime.payloadData(host.runtime.stringLiteral("file".toBytes()));
        let kind = memory.buildAlloca(host.builder, host.runtime.int64Type, "kind");
        let length = memory.buildAlloca(host.builder, host.runtime.int64Type, "length");
        let millis = memory.buildAlloca(host.builder, host.runtime.int64Type, "millis");
        host.runtime.call(filesystem.metadataRuntime(host.runtime),
            [path, host.runtime.int32(1), kind, length, millis], "why");
        try host.finish();
    }
}

test "every target's real path half builds code the verifier accepts" {
    for (let triple in coveredTriples()) {
        let host = new EmissionHost("filesystem_real_path_{triple}");
        host.retarget(triple);
        let path = host.runtime.payloadData(host.runtime.stringLiteral("folder/..".toBytes()));
        let buffer = host.runtime.call(host.runtime.malloc(), [host.runtime.int64(64)], "buffer");
        let needed = memory.buildAlloca(host.builder, host.runtime.int64Type, "needed");
        host.runtime.call(filesystem.realPathRuntime(host.runtime),
            [path, buffer, host.runtime.int64(64), needed], "why");
        try host.finish();
    }
}

// Every target with a half of its own, one architecture that carries no statx number, and this
// machine's own triple, which is the half its object files actually hold.
coveredTriples() -> string[] {
    return [target.hostTargetTriple(), "x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-musl",
        "wasm32-unknown-unknown", "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
}
