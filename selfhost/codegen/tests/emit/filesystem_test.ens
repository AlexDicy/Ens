// Tests for the bridges that look at the file system. Each one defines the bridge from inside a host
// function exactly as emission does and asserts the real LLVM verifier accepts the module. Only the
// host platform's half of a bridge is emitted, which is the half these tests verify.
import @std.testing;
import EmissionHost from support;
import support;
import emit.filesystem;

test "the path kind bridge verifies" {
    let host = new EmissionHost("filesystem_kind");
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.pathKindRuntime(host.runtime), [path], "kind");
    try host.finish();
}

test "the create directory bridge verifies" {
    let host = new EmissionHost("filesystem_create");
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.createDirectoryRuntime(host.runtime), [path], "created");
    try host.finish();
}

test "the directory listing bridge verifies" {
    let host = new EmissionHost("filesystem_list");
    let store = try support.freshStore();
    let finalizer = host.finalizers.arrayFinalizer(store.stringType());
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.listDirectoryRuntime(host.runtime, finalizer), [path], "names");
    try host.finish();
}

test "the listing bridge collects into one string array helper" {
    let host = new EmissionHost("filesystem_list_helper");
    let store = try support.freshStore();
    let finalizer = host.finalizers.arrayFinalizer(store.stringType());
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(filesystem.listDirectoryRuntime(host.runtime, finalizer), [path], "names");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal ptr @ens_string_list(") >= 0,
        "the string array helper was never defined: {text}");
    try testing.assertTrue(text.indexOf("@_dtor_string_array") >= 0,
        "the listing did not pass the element destructor: {text}");
    try host.finish();
}
