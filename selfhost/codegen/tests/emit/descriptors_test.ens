// Emission tests for the type descriptors: a module defines the descriptors it owns with their
// vtables and conformance tables, declares the ones it only references, and the runtime type
// helpers all pass the real LLVM verifier.
import @std.testing;
import @ens.llvm.analysis;
import @ens.llvm.globals;
import layout.descriptors;
import layout.vtables;
import lower.index;
import @ens.llvm.target;
import ModuleEmitter from emit.context;
import support;

test "a module defines its descriptors, tables, and type helpers verifiably" {
    let checked = try support.analyzeMain(
        "interface Speaker \{\n"
        + "    speak() -> int;\n"
        + "\}\n"
        + "abstract class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected abstract sound() -> int;\n"
        + "\}\n"
        + "class Dog extends Animal implements Speaker \{\n"
        + "    protected constructor();\n"
        + "    protected override sound() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    override speak() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(checked);
    let tables = vtables.assignSlots(programIndex);
    let plans = descriptors.planProgram(programIndex, tables);
    let emitter = new ModuleEmitter("main", plans, target.hostTargetTriple());
    emitter.descriptors.defineModuleDescriptors(emitter, "main");
    let ignoredIs = emitter.descriptors.typeIs();
    let ignoredConforms = emitter.descriptors.conforms();
    try testing.assertTrue(
        globals.getNamedGlobal(emitter.module, "_typedesc$main$Dog") != null,
        "Dog's descriptor was never defined");
    try testing.assertTrue(
        globals.getNamedGlobal(emitter.module, "_typedesc$main$Speaker") != null,
        "Speaker's descriptor was never defined");
    try testing.assertTrue(
        globals.getNamedGlobal(emitter.module, "_vtable_typedesc$main$Dog") != null,
        "Dog's vtable was never emitted");
    try testing.assertTrue(
        globals.getNamedGlobal(emitter.module, "_itables_typedesc$main$Dog") != null,
        "Dog's conformance table was never emitted");
    string verdict = analysis.verify(emitter.module);
    emitter.dispose();
    try testing.assertTrue(verdict.length == 0, "verification failed: {verdict}");
}
