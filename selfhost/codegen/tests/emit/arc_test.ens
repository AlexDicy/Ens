// The reference counting instructions emitted from hand-built EIR and read back as LLVM IR.
import @std.testing;
import @ens.llvm.analysis;
import PrimitiveKind from @ens.sema.model.types;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import EirAbandonConstruction from eir.model;
import EirRelease from eir.model;
import EirRetain from eir.model;
import EirStringToBytes from eir.model;
import EirReturn from eir.model;
import ModuleEmitter from emit.context;
import emit.bodies;
import emit.signatures;
import support;

test "a retain of a struct retains each reference it holds, a payload's only while present" {
    let program = try support.lowerWholeProgram(
        "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    protected Probe first;\n"
        + "    protected long count;\n"
        + "    protected Cell? second;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let pair = try support.structNamed(program.analysis, "Pair");
    let builder = new EirFunctionBuilder("copied", false, null, [new EirParameter("given", pair)],
        pair);
    builder.append(new EirRetain(0));
    builder.terminate(new EirReturn(0));
    let function = builder.finish();
    let emitter = new ModuleEmitter("main", program.plans, support.hostTarget(), null);
    signatures.declareFunction(emitter, function);
    try testing.assertEqual(bodies.emitFunction(emitter, function), "");
    string text = analysis.moduleText(emitter.module);
    string verdict = analysis.verify(emitter.module);
    emitter.dispose();
    try testing.assertEqual(verdict, "");
    try testing.assertEqual(occurrences(text, "call void @ens_retain("), 2L);
    try testing.assertTrue(text.indexOf("extractvalue %Pair %0, 0") >= 0,
        "the first field is not retained: {text}");
    try testing.assertTrue(text.indexOf("select i1 ") >= 0,
        "the payload's reference is retained whether or not the tag marks it present: {text}");
}

test "a string's 'bytes' is the string itself with one more owner, not a copy" {
    let program = try support.lowerWholeProgram("main() -> int \{\n    return 0;\n\}\n");
    let store = program.analysis.store();
    let builder = new EirFunctionBuilder("shared", false, null,
        [new EirParameter("text", store.stringType())], store.bytesType());
    long data = builder.newTemp(store.bytesType());
    builder.append(new EirStringToBytes(data, store.bytesType(), 0));
    builder.terminate(new EirReturn(data));
    let function = builder.finish();
    let emitter = new ModuleEmitter("main", program.plans, support.hostTarget(), null);
    signatures.declareFunction(emitter, function);
    try testing.assertEqual(bodies.emitFunction(emitter, function), "");
    string text = analysis.moduleText(emitter.module);
    string verdict = analysis.verify(emitter.module);
    emitter.dispose();
    try testing.assertEqual(verdict, "");
    try testing.assertEqual(occurrences(text, "call void @ens_retain(ptr %0)"), 1L);
    try testing.assertTrue(text.indexOf("ret ptr %0") >= 0, "the string itself: {text}");
    try testing.assertEqual(occurrences(text, "memcpy"), 0L);
}

test "an abandoned construction points the header at its finalizer before the release" {
    let program = try support.lowerWholeProgram(
        "class Box \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "    destructor() \{\n"
        + "        print(this.label);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let box = try support.classNamed(program.analysis, "Box");
    let voidType = program.analysis.store().primitive(PrimitiveKind.Void);
    let builder = new EirFunctionBuilder("abandoned", false, null, [new EirParameter("box", box)],
        voidType);
    builder.append(new EirAbandonConstruction(0, "_dtor$main$Box$fields"));
    builder.append(new EirRelease(0));
    builder.terminate(new EirReturn(-1));
    let function = builder.finish();
    let emitter = new ModuleEmitter("main", program.plans, support.hostTarget(), null);
    signatures.declareFunction(emitter, function);
    try testing.assertEqual(bodies.emitFunction(emitter, function), "");
    string text = analysis.moduleText(emitter.module);
    string verdict = analysis.verify(emitter.module);
    emitter.dispose();
    try testing.assertEqual(verdict, "");
    long start = text.indexOf("define void @abandoned");
    try testing.assertTrue(start >= 0, "the function is not defined: {text}");
    try testing.assertEqual(text.substring(start, text.indexOf("\}\n", start) + 2),
        "define void @abandoned(ptr %0) \{\n"
        + "b0.entry:\n"
        + "  %1 = getelementptr i8, ptr %0, i64 -16\n"
        + "  store ptr @\"_dtor$main$Box$fields\", ptr %1, align 8\n"
        + "  call void @ens_release(ptr %0)\n"
        + "  ret void\n"
        + "\}\n");
}

occurrences(string text, string needle) -> long {
    long found = 0;
    string rest = text;
    while (true) {
        long next = rest.indexOf(needle);
        if (next < 0) {
            return found;
        }
        found = found + 1;
        rest = rest.substring(next + needle.length, rest.length);
    }
}
