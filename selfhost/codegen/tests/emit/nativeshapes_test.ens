// Every target's structure layout and entry-point name, pinned from whichever host runs the suite.
// A machine that cannot run a target still holds its table to what the kernel headers say.
import @std.testing;
import ChildExit from emit.nativeshapes;
import ChildStream from emit.nativeshapes;
import DarwinStat from emit.nativeshapes;
import DescriptorControl from emit.nativeshapes;
import DirentKind from emit.nativeshapes;
import FileKind from emit.nativeshapes;
import FileMode from emit.nativeshapes;
import FilePermissions from emit.nativeshapes;
import Kevent from emit.nativeshapes;
import NamedPipe from emit.nativeshapes;
import PollEvent from emit.nativeshapes;
import PollReady from emit.nativeshapes;
import PollTurn from emit.nativeshapes;
import Pollfd from emit.nativeshapes;
import OpenMode from emit.nativeshapes;
import Overlapped from emit.nativeshapes;
import ProcessCreation from emit.nativeshapes;
import ProcessInformation from emit.nativeshapes;
import Rename from emit.nativeshapes;
import SecurityAttributes from emit.nativeshapes;
import Signal from emit.nativeshapes;
import StartupInfo from emit.nativeshapes;
import Statx from emit.nativeshapes;
import StdioMode from emit.nativeshapes;
import Timespec from emit.nativeshapes;
import WaitStatus from emit.nativeshapes;
import emit.nativeshapes;

test "a statx call carries its architecture's own number" {
    try testing.assertEqual(nativeshapes.statxSystemCall("x86_64-unknown-linux-gnu"), 332);
    try testing.assertEqual(nativeshapes.statxSystemCall("x86_64-unknown-linux-musl"), 332);
    try testing.assertEqual(nativeshapes.statxSystemCall("aarch64-unknown-linux-gnu"), 291);
    try testing.assertEqual(nativeshapes.statxSystemCall("riscv64-unknown-linux-gnu"), 291);
}

test "an architecture with no statx number answers none rather than another call's" {
    try testing.assertEqual(nativeshapes.statxSystemCall("wasm32-unknown-unknown"), 0);
    try testing.assertEqual(nativeshapes.statxSystemCall("i686-unknown-linux-gnu"), 0);
}

test "a statx answer holds its fields where the kernel puts them" {
    try testing.assertEqual(Statx.maskOffset, 0);
    try testing.assertEqual(Statx.modeOffset, 28);
    try testing.assertEqual(Statx.sizeOffset, 40);
    try testing.assertEqual(Statx.secondsOffset, 112);
    try testing.assertEqual(Statx.nanosecondsOffset, 120);
    try testing.assertEqual(Statx.structBytes, 256);
}

test "a statx request asks for the type, the size and the modification time" {
    try testing.assertEqual(Statx.typeRequest, 0x1);
    try testing.assertEqual(Statx.modifiedRequest, 0x40);
    try testing.assertEqual(Statx.sizeRequest, 0x200);
    try testing.assertEqual(Statx.typeRequest | Statx.modifiedRequest | Statx.sizeRequest, 0x241);
}

test "a statx call names the working directory and the flag that stops at a link" {
    try testing.assertEqual(Statx.currentDirectory, -100);
    try testing.assertEqual(Statx.noFollowFlag, 0x100);
}

test "a statx answer that is missing a field is a failure a caller can read" {
    try testing.assertEqual(Statx.unsupportedError, 38);
    try testing.assertEqual(Statx.incompleteError, 5);
}

test "a Darwin stat holds its mode ahead of its times and its size behind them" {
    try testing.assertEqual(DarwinStat.modeOffset, 4);
    try testing.assertEqual(DarwinStat.secondsOffset, 48);
    try testing.assertEqual(DarwinStat.nanosecondsOffset, 56);
    try testing.assertEqual(DarwinStat.sizeOffset, 96);
    try testing.assertEqual(DarwinStat.structBytes, 144);
}

test "a directory entry names itself at each platform's own offset" {
    try testing.assertEqual(nativeshapes.direntNameOffset("x86_64-unknown-linux-gnu"), 19);
    try testing.assertEqual(nativeshapes.direntNameOffset("aarch64-unknown-linux-gnu"), 19);
    try testing.assertEqual(nativeshapes.direntNameOffset("aarch64-apple-darwin23"), 21);
    try testing.assertEqual(nativeshapes.direntNameOffset("x86_64-apple-darwin23"), 21);
}

test "only Darwin x86_64 reaches its 64-bit inode entry points by another name" {
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "stat"),
        "stat$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "lstat"),
        "lstat$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "readdir"),
        "readdir$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("aarch64-apple-darwin23", "stat"), "stat");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-unknown-linux-gnu", "stat"),
        "stat");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-pc-windows-msvc", "stat"), "stat");
}

test "a mode word names a file's type with the bits every POSIX system shares" {
    try testing.assertEqual(FileMode.typeMask, 0xF000);
    try testing.assertEqual(FileMode.regular, 0x8000);
    try testing.assertEqual(FileMode.directory, 0x4000);
    try testing.assertEqual(FileMode.symbolicLink, 0xA000);
}

test "no kind is zero, so an untouched answer is never read as one" {
    try testing.assertEqual(FileKind.file, 1);
    try testing.assertEqual(FileKind.directory, 2);
    try testing.assertEqual(FileKind.symbolicLink, 3);
    try testing.assertEqual(FileKind.other, 4);
}

test "a triple names its platform" {
    try testing.assertTrue(nativeshapes.onWindowsTriple("x86_64-pc-windows-msvc"),
        "an msvc triple is a Windows one");
    try testing.assertTrue(nativeshapes.onWindowsTriple("aarch64-pc-windows-msvc"),
        "an arm64 msvc triple is a Windows one");
    try testing.assertFalse(nativeshapes.onWindowsTriple("x86_64-unknown-linux-gnu"),
        "a Linux triple is not a Windows one");
    try testing.assertTrue(nativeshapes.onDarwinTriple("aarch64-apple-darwin23"),
        "an apple triple is a Darwin one");
    try testing.assertFalse(nativeshapes.onDarwinTriple("x86_64-unknown-linux-musl"),
        "a musl triple is not a Darwin one");
}

test "a renameat2 call carries its architecture's own number" {
    try testing.assertEqual(nativeshapes.renameSystemCall("x86_64-unknown-linux-gnu"), 316);
    try testing.assertEqual(nativeshapes.renameSystemCall("aarch64-unknown-linux-gnu"), 276);
    try testing.assertEqual(nativeshapes.renameSystemCall("riscv64-unknown-linux-gnu"), 276);
    try testing.assertEqual(nativeshapes.renameSystemCall("i686-unknown-linux-gnu"), 0);
}

test "each system asks to refuse a taken destination under its own flag" {
    try testing.assertEqual(Rename.linuxNoReplace, 0x1);
    try testing.assertEqual(Rename.darwinExclusive, 0x4);
    try testing.assertEqual(Rename.windowsReplace, 0x1);
    try testing.assertEqual(Rename.destinationExists, 17);
}

test "each system reports refusing a no-replace rename with its own numbers" {
    let linux = nativeshapes.unsupportedRenameErrors("x86_64-unknown-linux-gnu");
    try testing.assertEqual(linux, [22L, 38L, 95L]);
    let darwin = nativeshapes.unsupportedRenameErrors("aarch64-apple-darwin23");
    try testing.assertEqual(darwin, [22L, 45L, 78L]);
}

test "each system spells the open flags with values of its own" {
    let linux = nativeshapes.openFlags("x86_64-unknown-linux-gnu");
    try testing.assertEqual(linux.readOnly, 0);
    try testing.assertEqual(linux.writeOnly, 1);
    try testing.assertEqual(linux.create, 0x40);
    try testing.assertEqual(linux.exclusive, 0x80);
    try testing.assertEqual(linux.truncate, 0x200);
    try testing.assertEqual(linux.append, 0x400);
    try testing.assertEqual(linux.closeOnExec, 0x80000);

    let darwin = nativeshapes.openFlags("aarch64-apple-darwin23");
    try testing.assertEqual(darwin.readOnly, 0);
    try testing.assertEqual(darwin.writeOnly, 1);
    try testing.assertEqual(darwin.create, 0x200);
    try testing.assertEqual(darwin.exclusive, 0x800);
    try testing.assertEqual(darwin.truncate, 0x400);
    try testing.assertEqual(darwin.append, 0x8);
    try testing.assertEqual(darwin.closeOnExec, 0x1000000);
}

test "both architectures of a system spell the open flags alike" {
    let intel = nativeshapes.openFlags("x86_64-unknown-linux-musl");
    let arm = nativeshapes.openFlags("aarch64-unknown-linux-gnu");
    try testing.assertEqual(intel.create, arm.create);
    try testing.assertEqual(intel.truncate, arm.truncate);
    try testing.assertEqual(intel.append, arm.append);
    try testing.assertEqual(intel.exclusive, arm.exclusive);
    try testing.assertEqual(intel.closeOnExec, arm.closeOnExec);
}

// The flag is added to every mode's flags, so it has to be a bit of its own on each system: one
// shared with another flag would change what the mode asks for.
test "close-on-exec is a bit no other open flag uses" {
    string[] triples = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let flags = nativeshapes.openFlags(triple);
        long others = flags.readOnly | flags.writeOnly | flags.create | flags.exclusive
            | flags.truncate | flags.append;
        try testing.assertNotEqual(flags.closeOnExec, 0);
        try testing.assertEqual(flags.closeOnExec & others, 0);
    }
}

test "a directory entry reports its kind one byte ahead of its name" {
    string[] triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        try testing.assertEqual(nativeshapes.direntKindOffset(triple) + 1,
            nativeshapes.direntNameOffset(triple));
    }
    try testing.assertEqual(nativeshapes.direntKindOffset("x86_64-unknown-linux-gnu"), 18);
    try testing.assertEqual(nativeshapes.direntKindOffset("aarch64-apple-darwin23"), 20);
}

test "a directory entry names its kinds the way both systems number them" {
    try testing.assertEqual(DirentKind.unknown, 0);
    try testing.assertEqual(DirentKind.directory, 4);
    try testing.assertEqual(DirentKind.regular, 8);
    try testing.assertEqual(DirentKind.symbolicLink, 10);
}

test "an open mode is asked for by the number the bridge documents" {
    try testing.assertEqual(OpenMode.read, 0);
    try testing.assertEqual(OpenMode.writeTruncated, 1);
    try testing.assertEqual(OpenMode.appended, 2);
    try testing.assertEqual(OpenMode.createdNew, 3);
}

// A file and a directory are created under different conventions, and the executable bits are what
// tell the two apart, so they are asserted as bits rather than only as numbers.
test "a created file asks for no executable bit and a created directory asks for all three" {
    try testing.assertEqual(FilePermissions.createdFile, 0x1B6);
    try testing.assertEqual(FilePermissions.createdDirectory, 0x1FF);
    try testing.assertEqual(FilePermissions.createdFile & 0x49, 0);
    try testing.assertEqual(FilePermissions.createdDirectory & 0x49, 0x49);
}

// A copy that carried a set-user-id bit would hand a caller a privilege it never asked for, so the
// three bits above the permissions are asserted absent rather than only the nine asserted present.
test "a copy hands over the nine permission bits and none of the three above them" {
    try testing.assertEqual(FilePermissions.copied, 0x1FF);
    try testing.assertEqual(FilePermissions.copied & 0xE00, 0);
    try testing.assertEqual(Statx.permissionsRequest, 0x2);
}

// Inherit is the zero a request left untouched carries, and the two stream numbers are the
// descriptors a POSIX child writes those streams to, which is what lets one number name both the
// stream a read asks for and the descriptor a start aims.
test "a start names stream modes and child streams by the numbers the bridge documents" {
    try testing.assertEqual(StdioMode.inherit, 0);
    try testing.assertEqual(StdioMode.pipe, 1);
    try testing.assertEqual(ChildStream.output, 1);
    try testing.assertEqual(ChildStream.errors, 2);
}

// The code Windows is told to report for a stopped child is the one a shell reports for a POSIX
// child that SIGKILL ended, so the two platforms print alike.
test "a stopped child reports 128 plus the kill signal" {
    try testing.assertEqual(ChildExit.stopped, 128 + Signal.kill);
    try testing.assertEqual(Signal.kill, 9);
    try testing.assertEqual(Signal.pipe, 13);
    try testing.assertEqual(Signal.ignored, 1);
}

test "the descriptor flag calls are spelled alike and the duplicating one is each system's own" {
    try testing.assertEqual(DescriptorControl.setFlags, 2);
    try testing.assertEqual(DescriptorControl.closeOnExec, 1);
    try testing.assertEqual(DescriptorControl.lowestFreeDescriptor, 3);
    try testing.assertEqual(nativeshapes.duplicateCloseOnExecCommand("x86_64-unknown-linux-gnu"),
        1030);
    try testing.assertEqual(nativeshapes.duplicateCloseOnExecCommand("aarch64-unknown-linux-gnu"),
        1030);
    try testing.assertEqual(nativeshapes.duplicateCloseOnExecCommand("aarch64-apple-darwin23"),
        67);
}

test "a wait status keeps the signal in its low seven bits and the code above them" {
    try testing.assertEqual(WaitStatus.signalMask, 0x7F);
    try testing.assertEqual(WaitStatus.codeShift, 8);
    try testing.assertEqual(WaitStatus.codeMask, 0xFF);
    try testing.assertEqual(WaitStatus.noHang, 1);
}

test "the monotonic clock is each system's own number and a timespec is two words" {
    try testing.assertEqual(nativeshapes.monotonicClock("x86_64-unknown-linux-gnu"), 1);
    try testing.assertEqual(nativeshapes.monotonicClock("x86_64-unknown-linux-musl"), 1);
    try testing.assertEqual(nativeshapes.monotonicClock("aarch64-apple-darwin23"), 6);
    try testing.assertEqual(Timespec.seconds, 0);
    try testing.assertEqual(Timespec.nanoseconds, 8);
    try testing.assertEqual(Timespec.structBytes, 16);
}

// The attribute list is the one field the extended form adds, so it sits exactly where the plain
// form ends, and the three standard handles are consecutive pointers.
test "the Win32 startup information holds its fields where the headers put them" {
    try testing.assertEqual(StartupInfo.plainBytes, 104);
    try testing.assertEqual(StartupInfo.attributeList, StartupInfo.plainBytes);
    try testing.assertEqual(StartupInfo.extendedBytes, StartupInfo.plainBytes + 8);
    try testing.assertEqual(StartupInfo.flags, 60);
    try testing.assertEqual(StartupInfo.standardInput, 80);
    try testing.assertEqual(StartupInfo.standardOutput, StartupInfo.standardInput + 8);
    try testing.assertEqual(StartupInfo.standardError, StartupInfo.standardOutput + 8);
    try testing.assertEqual(ProcessInformation.process, 0);
    try testing.assertEqual(ProcessInformation.thread, 8);
    try testing.assertEqual(ProcessInformation.structBytes, 24);
    try testing.assertEqual(SecurityAttributes.inheritHandle, 16);
    try testing.assertEqual(SecurityAttributes.structBytes, 24);
    try testing.assertEqual(Overlapped.event, 24);
    try testing.assertEqual(Overlapped.structBytes, 32);
}

test "the Win32 creation flags and waits carry their documented values" {
    try testing.assertEqual(ProcessCreation.extendedStartupInfo, 0x80000);
    try testing.assertEqual(ProcessCreation.unicodeEnvironment, 0x400);
    try testing.assertEqual(ProcessCreation.useStandardHandles, 0x100);
    try testing.assertEqual(ProcessCreation.handleListAttribute, 0x20002);
    try testing.assertEqual(ProcessCreation.duplicateSameAccess, 2);
    try testing.assertEqual(ProcessCreation.inheritFlag, 1);
    try testing.assertEqual(ProcessCreation.infinite, 0xFFFFFFFF);
    try testing.assertEqual(ProcessCreation.waitObject, 0);
    try testing.assertEqual(ProcessCreation.waitFailed, 0xFFFFFFFF);
}

// The reading end is overlapped and the first of its name, and the buffer holds as much as a Linux
// pipe does, so a child fills neither sooner than the other.
test "an output pipe is inbound, overlapped, first of its name and a Linux pipe wide" {
    try testing.assertEqual(NamedPipe.accessInbound, 1);
    try testing.assertEqual(NamedPipe.overlappedFlag, 0x40000000);
    try testing.assertEqual(NamedPipe.firstInstance, 0x80000);
    try testing.assertEqual(NamedPipe.rejectRemoteClients, 8);
    try testing.assertEqual(NamedPipe.byteStream, 0);
    try testing.assertEqual(NamedPipe.bufferBytes, 65536);
    try testing.assertEqual(NamedPipe.attributeNormal, 0x80);
    try testing.assertTrue(NamedPipe.nameAttempts > 1, "one attempt at a name is no retry");
}

// The three answers of a poll are combined by or, so each has to be a bit of its own, and the
// turn a kernel with no pidfd falls back to is short enough not to be noticed by a reader.
test "a poll answers with three bits that share none" {
    try testing.assertEqual(PollReady.output, 1);
    try testing.assertEqual(PollReady.errors, 2);
    try testing.assertEqual(PollReady.ended, 4);
    try testing.assertEqual(PollReady.output & PollReady.errors, 0);
    try testing.assertEqual(PollReady.output & PollReady.ended, 0);
    try testing.assertEqual(PollReady.errors & PollReady.ended, 0);
    try testing.assertEqual(PollTurn.millis, 5);
}

test "a pollfd holds its three fields in eight bytes and asks for input" {
    try testing.assertEqual(Pollfd.descriptor, 0);
    try testing.assertEqual(Pollfd.events, 4);
    try testing.assertEqual(Pollfd.revents, Pollfd.events + 2);
    try testing.assertEqual(Pollfd.structBytes, 8);
    try testing.assertEqual(PollEvent.input, 1);
}

// Unlike statx, pidfd_open postdates the unified table, so one row serves every architecture and
// a target that is not Linux has no number at all.
test "pidfd_open carries one number on every Linux architecture and none elsewhere" {
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("x86_64-unknown-linux-gnu"), 434);
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("aarch64-unknown-linux-gnu"), 434);
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("riscv64-unknown-linux-gnu"), 434);
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("x86_64-unknown-linux-musl"), 434);
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("aarch64-apple-darwin23"), 0);
    try testing.assertEqual(nativeshapes.pidfdOpenSystemCall("x86_64-pc-windows-msvc"), 0);
}

test "a Darwin kevent holds its fields where the header puts them" {
    try testing.assertEqual(Kevent.ident, 0);
    try testing.assertEqual(Kevent.filter, 8);
    try testing.assertEqual(Kevent.flags, Kevent.filter + 2);
    try testing.assertEqual(Kevent.filterFlags, 12);
    try testing.assertEqual(Kevent.data, 16);
    try testing.assertEqual(Kevent.userData, 24);
    try testing.assertEqual(Kevent.structBytes, 32);
    try testing.assertEqual(Kevent.readFilter, -1);
    try testing.assertEqual(Kevent.processFilter, -5);
    try testing.assertEqual(Kevent.add, 0x1);
    try testing.assertEqual(Kevent.oneShot, 0x10);
    try testing.assertEqual(Kevent.error, 0x4000);
    try testing.assertEqual(Kevent.exitNote, 0x80000000);
}
