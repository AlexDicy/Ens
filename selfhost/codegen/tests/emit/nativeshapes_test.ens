// Every target's structure layout and entry-point name, pinned from whichever host runs the suite.
// A machine that cannot run a target still holds its table to what the kernel headers say.
import @std.testing;
import DarwinStat from emit.nativeshapes;
import DirentKind from emit.nativeshapes;
import FileKind from emit.nativeshapes;
import FileMode from emit.nativeshapes;
import FilePermissions from emit.nativeshapes;
import OpenMode from emit.nativeshapes;
import Rename from emit.nativeshapes;
import Statx from emit.nativeshapes;
import emit.nativeshapes;

test "a statx call carries its architecture's own number" {
    try testing.assertEqual(nativeshapes.statxSystemCall("x86_64-unknown-linux-gnu"), 332);
    try testing.assertEqual(nativeshapes.statxSystemCall("x86_64-unknown-linux-musl"), 332);
    try testing.assertEqual(nativeshapes.statxSystemCall("aarch64-unknown-linux-gnu"), 291);
    try testing.assertEqual(nativeshapes.statxSystemCall("riscv64-unknown-linux-gnu"), 291);
}

test "an architecture with no statx number answers none rather than another call's" {
    try testing.assertEqual(nativeshapes.statxSystemCall("wasm32-unknown-unknown"), 0);
    try testing.assertEqual(nativeshapes.statxSystemCall("i686-unknown-linux-gnu"), 0);
}

test "a statx answer holds its fields where the kernel puts them" {
    try testing.assertEqual(Statx.maskOffset, 0);
    try testing.assertEqual(Statx.modeOffset, 28);
    try testing.assertEqual(Statx.sizeOffset, 40);
    try testing.assertEqual(Statx.secondsOffset, 112);
    try testing.assertEqual(Statx.nanosecondsOffset, 120);
    try testing.assertEqual(Statx.structBytes, 256);
}

test "a statx request asks for the type, the size and the modification time" {
    try testing.assertEqual(Statx.typeRequest, 0x1);
    try testing.assertEqual(Statx.modifiedRequest, 0x40);
    try testing.assertEqual(Statx.sizeRequest, 0x200);
    try testing.assertEqual(Statx.typeRequest | Statx.modifiedRequest | Statx.sizeRequest, 0x241);
}

test "a statx call names the working directory and the flag that stops at a link" {
    try testing.assertEqual(Statx.currentDirectory, -100);
    try testing.assertEqual(Statx.noFollowFlag, 0x100);
}

test "a statx answer that is missing a field is a failure a caller can read" {
    try testing.assertEqual(Statx.unsupportedError, 38);
    try testing.assertEqual(Statx.incompleteError, 5);
}

test "a Darwin stat holds its mode ahead of its times and its size behind them" {
    try testing.assertEqual(DarwinStat.modeOffset, 4);
    try testing.assertEqual(DarwinStat.secondsOffset, 48);
    try testing.assertEqual(DarwinStat.nanosecondsOffset, 56);
    try testing.assertEqual(DarwinStat.sizeOffset, 96);
    try testing.assertEqual(DarwinStat.structBytes, 144);
}

test "a directory entry names itself at each platform's own offset" {
    try testing.assertEqual(nativeshapes.direntNameOffset("x86_64-unknown-linux-gnu"), 19);
    try testing.assertEqual(nativeshapes.direntNameOffset("aarch64-unknown-linux-gnu"), 19);
    try testing.assertEqual(nativeshapes.direntNameOffset("aarch64-apple-darwin23"), 21);
    try testing.assertEqual(nativeshapes.direntNameOffset("x86_64-apple-darwin23"), 21);
}

test "only Darwin x86_64 reaches its 64-bit inode entry points by another name" {
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "stat"),
        "stat$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "lstat"),
        "lstat$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-apple-darwin23", "readdir"),
        "readdir$INODE64");
    try testing.assertEqual(nativeshapes.entryPointName("aarch64-apple-darwin23", "stat"), "stat");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-unknown-linux-gnu", "stat"),
        "stat");
    try testing.assertEqual(nativeshapes.entryPointName("x86_64-pc-windows-msvc", "stat"), "stat");
}

test "a mode word names a file's type with the bits every POSIX system shares" {
    try testing.assertEqual(FileMode.typeMask, 0xF000);
    try testing.assertEqual(FileMode.regular, 0x8000);
    try testing.assertEqual(FileMode.directory, 0x4000);
    try testing.assertEqual(FileMode.symbolicLink, 0xA000);
}

test "no kind is zero, so an untouched answer is never read as one" {
    try testing.assertEqual(FileKind.file, 1);
    try testing.assertEqual(FileKind.directory, 2);
    try testing.assertEqual(FileKind.symbolicLink, 3);
    try testing.assertEqual(FileKind.other, 4);
}

test "a triple names its platform" {
    try testing.assertTrue(nativeshapes.onWindowsTriple("x86_64-pc-windows-msvc"),
        "an msvc triple is a Windows one");
    try testing.assertTrue(nativeshapes.onWindowsTriple("aarch64-pc-windows-msvc"),
        "an arm64 msvc triple is a Windows one");
    try testing.assertFalse(nativeshapes.onWindowsTriple("x86_64-unknown-linux-gnu"),
        "a Linux triple is not a Windows one");
    try testing.assertTrue(nativeshapes.onDarwinTriple("aarch64-apple-darwin23"),
        "an apple triple is a Darwin one");
    try testing.assertFalse(nativeshapes.onDarwinTriple("x86_64-unknown-linux-musl"),
        "a musl triple is not a Darwin one");
}

test "a renameat2 call carries its architecture's own number" {
    try testing.assertEqual(nativeshapes.renameSystemCall("x86_64-unknown-linux-gnu"), 316);
    try testing.assertEqual(nativeshapes.renameSystemCall("aarch64-unknown-linux-gnu"), 276);
    try testing.assertEqual(nativeshapes.renameSystemCall("riscv64-unknown-linux-gnu"), 276);
    try testing.assertEqual(nativeshapes.renameSystemCall("i686-unknown-linux-gnu"), 0);
}

test "each system asks to refuse a taken destination under its own flag" {
    try testing.assertEqual(Rename.linuxNoReplace, 0x1);
    try testing.assertEqual(Rename.darwinExclusive, 0x4);
    try testing.assertEqual(Rename.windowsReplace, 0x1);
    try testing.assertEqual(Rename.destinationExists, 17);
}

test "each system reports refusing a no-replace rename with its own numbers" {
    let linux = nativeshapes.unsupportedRenameErrors("x86_64-unknown-linux-gnu");
    try testing.assertEqual(linux, [22L, 38L, 95L]);
    let darwin = nativeshapes.unsupportedRenameErrors("aarch64-apple-darwin23");
    try testing.assertEqual(darwin, [22L, 45L, 78L]);
}

test "each system spells the open flags with values of its own" {
    let linux = nativeshapes.openFlags("x86_64-unknown-linux-gnu");
    try testing.assertEqual(linux.readOnly, 0);
    try testing.assertEqual(linux.writeOnly, 1);
    try testing.assertEqual(linux.create, 0x40);
    try testing.assertEqual(linux.exclusive, 0x80);
    try testing.assertEqual(linux.truncate, 0x200);
    try testing.assertEqual(linux.append, 0x400);

    let darwin = nativeshapes.openFlags("aarch64-apple-darwin23");
    try testing.assertEqual(darwin.readOnly, 0);
    try testing.assertEqual(darwin.writeOnly, 1);
    try testing.assertEqual(darwin.create, 0x200);
    try testing.assertEqual(darwin.exclusive, 0x800);
    try testing.assertEqual(darwin.truncate, 0x400);
    try testing.assertEqual(darwin.append, 0x8);
}

test "both architectures of a system spell the open flags alike" {
    let intel = nativeshapes.openFlags("x86_64-unknown-linux-musl");
    let arm = nativeshapes.openFlags("aarch64-unknown-linux-gnu");
    try testing.assertEqual(intel.create, arm.create);
    try testing.assertEqual(intel.truncate, arm.truncate);
    try testing.assertEqual(intel.append, arm.append);
    try testing.assertEqual(intel.exclusive, arm.exclusive);
}

test "a directory entry reports its kind one byte ahead of its name" {
    string[] triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        try testing.assertEqual(nativeshapes.direntKindOffset(triple) + 1,
            nativeshapes.direntNameOffset(triple));
    }
    try testing.assertEqual(nativeshapes.direntKindOffset("x86_64-unknown-linux-gnu"), 18);
    try testing.assertEqual(nativeshapes.direntKindOffset("aarch64-apple-darwin23"), 20);
}

test "a directory entry names its kinds the way both systems number them" {
    try testing.assertEqual(DirentKind.unknown, 0);
    try testing.assertEqual(DirentKind.directory, 4);
    try testing.assertEqual(DirentKind.regular, 8);
    try testing.assertEqual(DirentKind.symbolicLink, 10);
}

test "an open mode is asked for by the number the bridge documents" {
    try testing.assertEqual(OpenMode.read, 0);
    try testing.assertEqual(OpenMode.writeTruncated, 1);
    try testing.assertEqual(OpenMode.appended, 2);
    try testing.assertEqual(OpenMode.createdNew, 3);
}

test "a copy hands over the permission bits and nothing above them" {
    try testing.assertEqual(FilePermissions.mask, 0xFFF);
    try testing.assertEqual(FilePermissions.created, 0x1FF);
    try testing.assertEqual(Statx.permissionsRequest, 0x2);
}
