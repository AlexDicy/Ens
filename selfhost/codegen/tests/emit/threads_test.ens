// The thread bridges each platform is given, held to the verifier from whichever host runs the
// suite. These pin which call names the running thread on each platform, and which calls raise a
// dedicated task's thread on each.
import @std.testing;
import @ens.llvm.target;
import EmissionHost from support;
import emit.threads;

// The body of one target's thread token, from its definition to the brace that closes it.
tokenBody(string triple) -> string throws {
    let host = new EmissionHost("token_{triple}");
    host.retarget(triple);
    host.runtime.call(threads.threadTokenRuntime(host.runtime), [], "token");
    string text = host.text();
    try host.finish();
    long start = text.indexOf("define internal i64 @ens_thread_token(");
    try testing.assertTrue(start >= 0, "'{triple}' never defined the thread token: {text}");
    string rest = text.substring(start, text.length);
    long end = rest.indexOf("\n}");
    try testing.assertTrue(end >= 0, "'{triple}' left the thread token unclosed: {rest}");
    return rest.substring(0, end);
}

test "a Windows thread token is the thread's id and no POSIX call" {
    string body = try tokenBody("x86_64-pc-windows-msvc");
    try testing.assertTrue(body.indexOf("call i32 @GetCurrentThreadId()") >= 0,
        "a Windows token does not read GetCurrentThreadId: {body}");
    try testing.assertTrue(body.indexOf("pthread_self") < 0,
        "a Windows token reaches pthread_self: {body}");
}

test "a POSIX thread token is pthread_self" {
    for (let triple in [target.hostTargetTriple(), "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu", "aarch64-apple-darwin23"]) {
        if (triple.indexOf("windows") >= 0) {
            continue;
        }
        string body = try tokenBody(triple);
        try testing.assertTrue(body.indexOf("call i64 @pthread_self()") >= 0,
            "'{triple}' does not read pthread_self: {body}");
    }
}

// The body of one target's thread priority bridge.
raiseBody(string triple) -> string throws {
    let host = new EmissionHost("raise_{triple}");
    host.retarget(triple);
    host.runtime.call(threads.raiseRuntime(host.runtime), [host.runtime.int32(2)], "");
    string text = host.text();
    try host.finish();
    long start = text.indexOf("define internal void @ens_thread_raise(");
    try testing.assertTrue(start >= 0, "'{triple}' never defined the priority bridge: {text}");
    string rest = text.substring(start, text.length);
    return rest.substring(0, rest.indexOf("\n}"));
}

test "each platform raises a thread with its own calls, falling back from realtime to high" {
    string windows = try raiseBody("x86_64-pc-windows-msvc");
    try testing.assertTrue(windows.indexOf("@SetThreadPriority(") >= 0
        && windows.indexOf("select i1 %realtime, i32 15, i32 2") >= 0,
        "Windows sets the time-critical or the highest priority: {windows}");
    string linux = try raiseBody("x86_64-unknown-linux-gnu");
    try testing.assertTrue(linux.indexOf("@sched_get_priority_max(i32 1)") >= 0
        && linux.indexOf("@setpriority(i32 0, i32 0, i32 -10)") >= 0,
        "Linux asks for SCHED_FIFO, then a lower nice value: {linux}");
    string darwin = try raiseBody("aarch64-apple-darwin23");
    try testing.assertTrue(darwin.indexOf("@sched_get_priority_max(i32 2)") >= 0
        && darwin.indexOf("@pthread_set_qos_class_self_np(i32 33, i32 0)") >= 0,
        "macOS asks for SCHED_RR, then the user-interactive class: {darwin}");
}

// The body of one target's processor count bridge.
processorBody(string triple) -> string throws {
    let host = new EmissionHost("processors_{triple}");
    host.retarget(triple);
    host.runtime.call(threads.processorCountRuntime(host.runtime), [], "count");
    string text = host.text();
    try host.finish();
    long start = text.indexOf("define internal i64 @ens_processor_count(");
    try testing.assertTrue(start >= 0, "'{triple}' never defined the processor count: {text}");
    string rest = text.substring(start, text.length);
    return rest.substring(0, rest.indexOf("\n}"));
}

test "each platform counts the processors the program may run on, and never fewer than one" {
    string windows = try processorBody("x86_64-pc-windows-msvc");
    try testing.assertTrue(windows.indexOf("call i32 @GetProcessAffinityMask(ptr %process") >= 0
        && windows.indexOf("call i32 @GetActiveProcessorCount(i16 -1)") >= 0,
        "Windows does not read the process's mask beside every group's processors: {windows}");
    string linux = try processorBody("aarch64-unknown-linux-gnu");
    try testing.assertTrue(linux.indexOf("call i32 @sched_getaffinity(i32 0, i64 128, ptr %mask)")
        >= 0 && linux.indexOf("call i64 @sysconf(i32 84)") >= 0,
        "Linux does not read the affinity mask, falling back to the online processors: {linux}");
    try testing.assertTrue(linux.indexOf("@llvm.ctpop.i64") >= 0,
        "Linux does not count the processors the mask sets: {linux}");
    string darwin = try processorBody("aarch64-apple-darwin23");
    try testing.assertTrue(darwin.indexOf("call i64 @sysconf(i32 58)") >= 0,
        "macOS does not ask sysconf for the online processors: {darwin}");
    for (let body in [windows, linux, darwin]) {
        try testing.assertTrue(body.indexOf("select i1 %few, i64 1, i64 %") >= 0,
            "a count below one is not raised to one: {body}");
    }
}

test "the main thread check compares the thread's token with the one the entry stored" {
    for (let triple in ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
            "aarch64-apple-darwin23"]) {
        let host = new EmissionHost("main_thread_{triple}");
        host.retarget(triple);
        host.runtime.call(threads.isMainThreadRuntime(host.runtime), [], "main");
        string text = host.text();
        try host.finish();
        try testing.assertTrue(text.indexOf("@ens_main_thread = external global i64") >= 0,
            "'{triple}' does not declare the stored token: {text}");
        long start = text.indexOf("define internal i32 @ens_is_main_thread(");
        try testing.assertTrue(start >= 0, "'{triple}' never defined the check: {text}");
        string body = text.substring(start, text.length);
        try testing.assertTrue(body.indexOf("load i64, ptr @ens_main_thread") >= 0,
            "'{triple}' does not read the stored token: {body}");
        try testing.assertTrue(body.indexOf("icmp eq i64") >= 0,
            "'{triple}' does not compare the tokens: {body}");
    }
}
