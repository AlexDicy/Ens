// The side tables a trace is resolved through. A function no symbol entry records, such as a runtime
// routine, has its start recorded apart, so a return address inside it resolves to no function
// rather than to the recorded one laid out before it.
import @std.testing;
import @ens.llvm.globals;
import Value from @ens.llvm.values;
import TraceTables from emit.traces;
import EmissionHost from support;

test "every defined function no entry records has its start kept apart" {
    let host = new EmissionHost("traces_internal");
    let allocate = host.runtime.alloc();
    host.runtime.call(allocate, [host.runtime.int64(8), host.runtime.nullPointer(),
        host.runtime.nullPointer()], "");
    let recorded = globals.getNamedFunction(host.module, "host");
    if (recorded == null) {
        try testing.fail("the host function should be in the module");
    } else {
        let tables = new TraceTables();
        tables.record(recorded, "host", "host.ens", 1, false);
        Value[] starts = tables.internalStarts(host.runtime);
        bool routineKept = false;
        for (let start in starts) {
            try testing.assertFalse(start.sameAs(recorded), "a recorded function is not kept apart");
            if (start.sameAs(allocate.function)) {
                routineKept = true;
            }
        }
        try testing.assertTrue(routineKept, "the runtime's allocator is kept apart");
        tables.emitRegistration(host.runtime);
    }
    try host.finish();
}
