// Tests for the bridges answering with the running process's own facts, each defined from inside a
// host function exactly as emission does and checked with the real LLVM verifier.
import @std.testing;
import Value from @ens.llvm.values;
import @ens.llvm.target;
import EmissionHost from support;
import support;
import emit.system;

// The finalizer an owned string[] carries, which is what every bridge building one is handed.
stringFinalizer(EmissionHost host) -> Value throws {
    let store = try support.freshStore();
    return host.finalizers.arrayFinalizer(store.stringType());
}

test "the process arguments bridge verifies" {
    let host = new EmissionHost("system_arguments");
    host.runtime.call(system.argumentsRuntime(host.runtime, try stringFinalizer(host)), [],
        "arguments");
    try host.finish();
}

test "the inherited environment bridge verifies" {
    let host = new EmissionHost("system_environment");
    host.runtime.call(system.environmentRuntime(host.runtime, try stringFinalizer(host)), [],
        "environment");
    try host.finish();
}

test "the executable path bridge verifies" {
    let host = new EmissionHost("system_executable_path");
    let buffer = host.runtime.call(host.runtime.malloc(), [host.runtime.int64(64)], "buffer");
    host.runtime.call(system.executablePathRuntime(host.runtime),
        [buffer, host.runtime.int64(64)], "written");
    try host.finish();
}

test "the platform bridge verifies and answers with a constant" {
    let host = new EmissionHost("system_platform");
    host.runtime.call(system.platformRuntime(host.runtime), [], "platform");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal i32 @ens_platform()") >= 0,
        "the platform bridge was never defined: {text}");
    string triple = target.hostTargetTriple();
    string code = "1";
    if (triple.contains("windows")) {
        code = "0";
    } else if (triple.contains("darwin") || triple.contains("apple")) {
        code = "2";
    }
    try testing.assertTrue(text.indexOf("ret i32 {code}") >= 0,
        "the host '{triple}' should answer with the code {code}: {text}");
    try host.finish();
}

test "a bridge needed twice is defined once" {
    let host = new EmissionHost("system_reuse");
    let first = system.executablePathRuntime(host.runtime);
    let second = system.executablePathRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the bridge");
    host.runtime.call(first, [host.runtime.nullPointer(), host.runtime.int64(0)], "");
    try host.finish();
}

// Only the host platform's half of a bridge reaches an object file, so the other half is held to
// the verifier here instead.
test "every target's current directory half builds code the verifier accepts" {
    string[] triples = [target.hostTargetTriple(), "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let host = new EmissionHost("system_current_directory_{triple}");
        host.retarget(triple);
        let buffer = host.runtime.call(host.runtime.malloc(), [host.runtime.int64(64)], "buffer");
        host.runtime.call(system.currentDirectoryRuntime(host.runtime),
            [buffer, host.runtime.int64(64)], "written");
        try host.finish();
    }
}
