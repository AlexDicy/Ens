// Tests for the bridges that start another program. Each one defines the bridge from inside a host
// function exactly as emission does and asserts the real LLVM verifier accepts the module, which is
// what catches a mistyped call into the operating system's process entry points. Only the host
// platform's half of the spawn is emitted, which is the half these tests verify.
import @std.testing;
import EmissionHost from support;
import emit.processes;

test "the shell runner verifies" {
    let host = new EmissionHost("processes_shell");
    let command = host.runtime.payloadData(host.runtime.stringLiteral("echo hi".toBytes()));
    host.runtime.call(processes.runProcessRuntime(host.runtime), [command], "status");
    try host.finish();
}

test "the spawn verifies" {
    let host = new EmissionHost("processes_spawn");
    let program = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
    let block = host.runtime.payloadData(host.runtime.stringLiteral("status".toBytes()));
    let commandLine = host.runtime.payloadData(host.runtime.stringLiteral("git status".toBytes()));
    let empty = host.runtime.payloadData(host.runtime.stringLiteral("".toBytes()));
    host.runtime.call(processes.spawnProcessRuntime(host.runtime), [program, block,
        host.runtime.int64(1), commandLine, block, host.runtime.int64(1), host.runtime.int64(7),
        empty, empty], "status");
    try host.finish();
}

test "the spawn is defined once however often it is called" {
    let host = new EmissionHost("processes_spawn_reuse");
    let first = processes.spawnProcessRuntime(host.runtime);
    let second = processes.spawnProcessRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the spawn");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal i64 @ens_spawn_process(") >= 0,
        "the spawn was never defined: {text}");
    try host.finish();
}
