// Tests for the directory listing bridge. It defines the bridge from inside a host function exactly
// as emission does, asserts the real LLVM verifier accepts the module, and pins the two things the
// listing depends on being emitted: the shared array helper and the element destructor the names are
// released through. Only the host platform's half of the bridge is emitted, which is the half these
// tests verify.
import @std.testing;
import EmissionHost from support;
import support;
import emit.directories;

test "the directory listing bridge verifies" {
    let host = new EmissionHost("directories_list");
    let store = try support.freshStore();
    let finalizer = host.finalizers.arrayFinalizer(store.stringType());
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(directories.listDirectoryRuntime(host.runtime, finalizer), [path], "names");
    try host.finish();
}

test "the listing collects its names through the shared string array helper" {
    let host = new EmissionHost("directories_helper");
    let store = try support.freshStore();
    let finalizer = host.finalizers.arrayFinalizer(store.stringType());
    let path = host.runtime.payloadData(host.runtime.stringLiteral("folder".toBytes()));
    host.runtime.call(directories.listDirectoryRuntime(host.runtime, finalizer), [path], "names");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal ptr @ens_string_list(") >= 0,
        "the string array helper was never defined: {text}");
    try testing.assertTrue(text.indexOf("@_dtor_string_array") >= 0,
        "the listing did not pass the element destructor: {text}");
    try host.finish();
}
