// The capture keeps the call each return address comes back from, so a function whose last
// instruction is a call that never returns is still the function its frame resolves to.
import @std.testing;
import EmissionHost from support;
import emit.tracecapture;

// The capture routine's body as emitted for the target, from its definition to its closing brace.
captureBody(string targetTriple) -> string throws {
    let host = new EmissionHost("trace_capture");
    host.retarget(targetTriple);
    tracecapture.defineCapture(host.runtime);
    string module = host.text();
    try host.finish();
    long start = module.indexOf("@ens_capture_trace(i32");
    try testing.assertTrue(start >= 0, "the capture routine was never defined: {module}");
    string rest = module.substring(start, module.length);
    long end = rest.indexOf("\n}");
    try testing.assertTrue(end >= 0, "the capture routine was left unclosed: {rest}");
    return rest.substring(0, end);
}

assertResolvedAtCall(string targetTriple) throws {
    string body = try captureBody(targetTriple);
    try testing.assertTrue(body.indexOf("%call.address = sub i64 %return.address, 1") >= 0,
        "the frame is not moved back onto its call: {body}");
    try testing.assertTrue(body.indexOf("@ens_resolve_addr(i64 %call.address)") >= 0,
        "the frame is resolved somewhere other than its call: {body}");
    try testing.assertTrue(body.indexOf("store i64 %call.address, ptr") >= 0,
        "the trace keeps something other than the call it resolved: {body}");
}

test "a frame captured on Windows is resolved and kept at its call" {
    try assertResolvedAtCall("x86_64-pc-windows-msvc");
}

test "a frame captured through the unwinder is resolved and kept at its call" {
    try assertResolvedAtCall("aarch64-apple-darwin23");
}
