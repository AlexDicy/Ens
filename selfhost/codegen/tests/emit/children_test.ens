// Tests for the bridges behind a child this process reads as it runs, each defined from inside a
// host function exactly as emission does and checked with the real LLVM verifier.
import @std.testing;
import @ens.llvm.target;
import EmissionHost from support;
import ChildExit from emit.children;
import emit.children;

test "starting a child verifies" {
    let host = new EmissionHost("children_start");
    let program = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
    let block = host.runtime.payloadData(host.runtime.stringLiteral("status".toBytes()));
    let commandLine = host.runtime.payloadData(host.runtime.stringLiteral("git status".toBytes()));
    host.runtime.call(children.startProcessRuntime(host.runtime), [program, block,
        host.runtime.int64(1), commandLine, block, host.runtime.int64(1), host.runtime.int64(7)],
        "child");
    try host.finish();
}

test "reading, waiting and releasing a child verify" {
    let host = new EmissionHost("children_read");
    let child = host.runtime.nullPointer();
    let buffer = host.runtime.payloadData(host.runtime.stringLiteral("....".toBytes()));
    host.runtime.call(children.readChildRuntime(host.runtime), [child, buffer,
        host.runtime.int64(4)], "count");
    host.runtime.call(children.waitChildRuntime(host.runtime), [child], "code");
    host.runtime.call(children.releaseChildRuntime(host.runtime), [child], "");
    try host.finish();
}

test "waiting a bounded while for output and stopping a child verify" {
    let host = new EmissionHost("children_poll");
    let child = host.runtime.nullPointer();
    host.runtime.call(children.pollChildRuntime(host.runtime), [child,
        host.runtime.int64(250)], "ready");
    host.runtime.call(children.killChildRuntime(host.runtime), [child], "stopped");
    try host.finish();
}

test "a stopped child reports the code a system reports for one ended from outside" {
    try testing.assertEqual(ChildExit.stopped, 137L);
}

test "each child bridge is defined once however often it is called" {
    let host = new EmissionHost("children_reuse");
    let first = children.startProcessRuntime(host.runtime);
    let second = children.startProcessRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the start");
    let firstRead = children.readChildRuntime(host.runtime);
    try testing.assertTrue(firstRead.function == children.readChildRuntime(host.runtime).function,
        "the second use redefined the read");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal ptr @ens_start_process(") >= 0,
        "the start was never defined: {text}");
    try testing.assertTrue(text.indexOf("define internal i64 @ens_read_child(") >= 0,
        "the read was never defined: {text}");
    try host.finish();
}

// Only the host platform's half of a bridge reaches an object file, so the other halves are held
// to the verifier here instead.
test "every target's child bridges build code the verifier accepts" {
    for (let triple in childTriples()) {
        let host = new EmissionHost("children_{triple}");
        host.retarget(triple);
        let child = host.runtime.nullPointer();
        let text = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
        host.runtime.call(children.startProcessRuntime(host.runtime), [text, text,
            host.runtime.int64(1), text, text, host.runtime.int64(1), host.runtime.int64(7)],
            "child");
        host.runtime.call(children.readChildRuntime(host.runtime), [child, text,
            host.runtime.int64(4)], "count");
        host.runtime.call(children.pollChildRuntime(host.runtime), [child,
            host.runtime.int64(250)], "ready");
        host.runtime.call(children.killChildRuntime(host.runtime), [child], "stopped");
        host.runtime.call(children.waitChildRuntime(host.runtime), [child], "code");
        host.runtime.call(children.releaseChildRuntime(host.runtime), [child], "");
        try host.finish();
    }
}

// Both halves of every child bridge, and this machine's own triple, which is the half its object
// files actually hold.
childTriples() -> string[] {
    return [target.hostTargetTriple(), "x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin23"];
}
