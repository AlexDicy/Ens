// Tests for the bridges behind a child this process reads as it runs, each defined from inside a
// host function exactly as emission does and checked with the real LLVM verifier.
import @std.testing;
import @ens.llvm.target;
import EmissionHost from support;
import ChildExit from emit.children;
import emit.children;
import emit.nativeshapes;

test "starting a child verifies" {
    let host = new EmissionHost("children_start");
    let program = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
    let block = host.runtime.payloadData(host.runtime.stringLiteral("status".toBytes()));
    let commandLine = host.runtime.payloadData(host.runtime.stringLiteral("git status".toBytes()));
    host.runtime.call(children.startProcessRuntime(host.runtime), [program, block,
        host.runtime.int64(1), commandLine, block, host.runtime.int64(1), host.runtime.int64(7)],
        "child");
    try host.finish();
}

// F_SETFD is 2 and FD_CLOEXEC is 1 on both POSIX triples; the lift is F_DUPFD_CLOEXEC from 3.
test "a POSIX start closes every pipe end on exec and reports a failed exec" {
    for (let triple in posixTriples()) {
        let host = new EmissionHost("children_report_{triple}");
        host.retarget(triple);
        children.startProcessRuntime(host.runtime);
        string text = host.text();
        long lift = nativeshapes.duplicateCloseOnExecCommand(triple);
        try assertBlockHolds(triple, text, "start.flags", ["@fcntl(i32 %read.end, i32 2, i32 1)",
            "@fcntl(i32 %write.end, i32 2, i32 1)", "@fcntl(i32 %report.read, i32 2, i32 1)",
            "@fcntl(i32 %report.write, i32 2, i32 1)",
            "label %start.fork, label %start.close.report"]);
        try assertBlockHolds(triple, text, "start.child",
            ["%start.child.output.end = load i32, ptr %write.slot",
                "label %start.child.output.lift, label %start.child.lifted"]);
        try assertBlockHolds(triple, text, "start.child.output.lift",
            ["@fcntl(i32 %start.child.output.end, i32 {lift}, i32 3)",
                "label %start.child.lifted, label %start.child.failed"]);
        try assertBlockHolds(triple, text, "start.child.lifted",
            ["%output = load i32, ptr %write.slot",
                "%aimed.output = call i32 @dup2(i32 %output, i32 1)",
                "icmp sge i32 %aimed.output, 0",
                "label %start.child.aim.errors, label %start.child.failed"]);
        try assertBlockHolds(triple, text, "start.child.aim.errors",
            ["%aimed.errors = call i32 @dup2(i32 %output, i32 2)", "icmp sge i32 %aimed.errors, 0",
                "label %start.child.aimed, label %start.child.failed"]);
        try assertBlockHolds(triple, text, "start.child.failed",
            ["@write(i32 %report.write, ptr %reported, i64 4)", "@_exit(i32 127)"]);
        try host.finish();
    }
}

// The branches and 'preds' lines pin the order: the parent closes both writing ends before it
// reads the report, and a failed exec is waited for, its read end closed and its block freed
// before the start returns null.
test "a POSIX start closes its writing ends before the report read and releases a failed exec" {
    for (let triple in posixTriples()) {
        let host = new EmissionHost("children_order_{triple}");
        host.retarget(triple);
        children.startProcessRuntime(host.runtime);
        string text = host.text();
        try assertBlockHolds(triple, text, "start.parent", ["@close(i32 %write.end)",
            "@close(i32 %report.write)", "label %start.unforked, label %start.report.await"]);
        try assertBlockHolds(triple, text, "start.report.await", ["preds = %start.parent\n",
            "br label %report.read.call"]);
        try assertBlockHolds(triple, text, "report.read.call",
            ["preds = %report.read.refused, %start.report.await\n",
                "@read(i32 %report.read, ptr %reported, i64 4)"]);
        try assertBlockHolds(triple, text, "report.read.done", ["@close(i32 %report.read)",
            "label %start.exec.failed, label %start.record"]);
        try assertBlockHolds(triple, text, "start.exec.failed", ["br label %collect.call"]);
        try assertBlockHolds(triple, text, "collect.call",
            ["@waitpid(i32 %child, ptr %collect.status, i32 0)"]);
        try assertBlockHolds(triple, text, "collect.known", ["br label %start.close.read"]);
        try assertBlockHolds(triple, text, "start.close.read", ["@close(i32 %read.end)",
            "br label %start.release"]);
        try assertBlockHolds(triple, text, "start.release", ["@free(ptr %child.block)",
            "br label %start.failed"]);
        try assertBlockHolds(triple, text, "start.failed", ["ret ptr null"]);
        try host.finish();
    }
}

// The start that reports its code writes it into its last parameter on the one path every failure
// leaves through, and the start that reports none writes nothing there.
test "a start that reports its code writes it on the way out of every failure" {
    for (let triple in childTriples()) {
        let host = new EmissionHost("children_code_{triple}");
        host.retarget(triple);
        let program = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
        let code = host.runtime.payloadData(host.runtime.stringLiteral("code".toBytes()));
        host.runtime.call(children.startChildRuntime(host.runtime), [program, program,
            host.runtime.int64(0), program, program, host.runtime.int64(0), host.runtime.int64(0),
            code], "child");
        host.runtime.call(children.startProcessRuntime(host.runtime), [program, program,
            host.runtime.int64(0), program, program, host.runtime.int64(0), host.runtime.int64(0)],
            "child.plain");
        string text = host.text();
        string reporting = try functionText(text, "ens_start_child");
        string plain = try functionText(text, "ens_start_process");
        try testing.assertTrue(reporting.indexOf("store i32 %code.found, ptr %7") >= 0,
            "{triple}: the start does not write its code: {reporting}");
        try testing.assertTrue(plain.indexOf("store i32 %code.found") < 0,
            "{triple}: the start with no code parameter writes one: {plain}");
        try host.finish();
    }
}

// A failed exec carries what it failed on above errno: 3 for a path naming a directory, 4 for a
// program image of any system's format the system could not run, 5 for a file that is no program,
// 6 for a special file such as a named pipe, 8 for a script whose first line names a program that
// is not there, 9 for a runnable file that starts neither as an image nor as a script, 10 for a
// refusal on a runnable program image, 11 for a script the system would not start or refused over
// the program its first line names, and 1 otherwise. A file is opened only once its kind shows it
// is a regular file, or once the system reported it could not run it, so a pipe that would block
// the open is never opened. A file that cannot be opened counts as one that may hold a program.
test "a POSIX start carries the part of the start its exec failed on" {
    for (let triple in posixTriples()) {
        let host = new EmissionHost("children_cause_{triple}");
        host.retarget(triple);
        children.startChildRuntime(host.runtime);
        string text = host.text();
        let flags = nativeshapes.openFlags(triple);
        long magicFlags = flags.readOnly | flags.nonBlocking | flags.noControllingTerminal;
        try assertBlockHolds(triple, text, "start.child.exec", ["@strchr(ptr %0, i32 47)",
            "label %exec.cause.unrunnable, label %exec.cause.refused"]);
        try assertBlockHolds(triple, text, "exec.cause.unrunnable", ["store i32 4, ptr %cause",
            "label %exec.cause.image, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.image",
            ["@open(ptr %0, i32 {magicFlags})", "label %exec.magic.read, label %exec.magic.done"]);
        try assertBlockHolds(triple, text, "exec.magic.read", ["@read(", "@close("]);
        try assertBlockHolds(triple, text, "exec.magic.done", ["%image = or i1",
            "i1 %script, i32 11, i32 9", "i1 %image, i32 4, i32 %"]);
        try assertBlockHolds(triple, text, "exec.cause.refused",
            ["label %exec.cause.kind, label %exec.cause.missing"]);
        try assertBlockHolds(triple, text, "exec.cause.kind", ["i32 3, i32 %", "i32 10, i32 6",
            "label %exec.cause.regular, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.regular",
            ["@open(ptr %0, i32 {magicFlags})"]);
        for (let line in ["xor i1 %magic.opened", "%holds.program = or i1",
                "%runnable.cause = select i1 %script", ", i32 11, i32 10",
                "select i1 %runnable, i32 %runnable.cause, i32 1",
                "select i1 %holds.program, i32 %"]) {
            try testing.assertTrue(text.indexOf(line) >= 0, "{triple}: no '{line}' in: {text}");
        }
        try assertBlockHolds(triple, text, "exec.cause.missing",
            ["label %exec.cause.left, label %exec.cause.done"]);
        try assertBlockHolds(triple, text, "exec.cause.left", ["i32 8, i32 1"]);
        try assertBlockHolds(triple, text, "exec.cause.done", ["shl i32 %cause.found, 24",
            "store i32 %caused, ptr %reported"]);
        try host.finish();
    }
}

// A failed CreateProcessW carries what it failed on above its number: 3 for a program path naming
// a directory, 4 for a file with the 'MZ' header Windows could not run, 5 for one without it, and
// 1 otherwise. The file system is asked only once the start has failed.
test "a Windows start carries the part of the start it failed on" {
    let host = new EmissionHost("children_cause_windows");
    host.retarget("x86_64-pc-windows-msvc");
    children.startChildRuntime(host.runtime);
    string text = host.text();
    try assertBlockHolds("windows", text, "start.cause.probe",
        ["label %start.cause.program.directory, label %start.cause.program.format"]);
    try assertBlockHolds("windows", text, "start.cause.program.directory",
        ["@GetFileAttributesW(ptr %program.wide)", "i1 %directory, i32 3, i32 1"]);
    try assertBlockHolds("windows", text, "start.cause.program.format",
        ["label %start.cause.program.image, label %start.cause.program.done"]);
    try assertBlockHolds("windows", text, "start.cause.program.image",
        ["@CreateFileW(ptr %program.wide"]);
    try assertBlockHolds("windows", text, "start.cause.header.read", ["@ReadFile(", "i32 2",
        "@CloseHandle("]);
    try assertBlockHolds("windows", text, "start.cause.header.done",
        ["icmp eq i16 %header.word, 23117", "i1 %image.header, i32 4, i32 5"]);
    try testing.assertTrue(text.indexOf("@GetFileAttributesW(") > text.indexOf("@CreateProcessW("),
        "the file system is asked before the start: {text}");
    try host.finish();
}

// The entry block prints first, so a block allocated there comes before every pipe and the fork.
test "a POSIX start allocates the child's block before anything can start" {
    for (let triple in posixTriples()) {
        let host = new EmissionHost("children_block_{triple}");
        host.retarget(triple);
        children.startProcessRuntime(host.runtime);
        string text = host.text();
        long allocated = text.indexOf("%child.block = call ptr @malloc(i64 16)");
        long piped = text.indexOf("%piped = call i32 @pipe(");
        try testing.assertTrue(allocated >= 0 && piped > allocated,
            "{triple} does not allocate the block before the first pipe: {text}");
        try testing.assertTrue(text.indexOf("@free(ptr %child.block)") >= 0,
            "{triple} never frees the block of a start that failed: {text}");
        try host.finish();
    }
}

test "reading, waiting and releasing a child verify" {
    let host = new EmissionHost("children_read");
    let child = host.runtime.nullPointer();
    let buffer = host.runtime.payloadData(host.runtime.stringLiteral("....".toBytes()));
    host.runtime.call(children.readChildRuntime(host.runtime), [child, buffer,
        host.runtime.int64(4)], "count");
    host.runtime.call(children.waitChildRuntime(host.runtime), [child], "code");
    host.runtime.call(children.releaseChildRuntime(host.runtime), [child], "");
    try host.finish();
}

test "waiting a bounded while for output and stopping a child verify" {
    let host = new EmissionHost("children_poll");
    let child = host.runtime.nullPointer();
    host.runtime.call(children.pollChildRuntime(host.runtime), [child,
        host.runtime.int64(250)], "ready");
    host.runtime.call(children.killChildRuntime(host.runtime), [child], "stopped");
    try host.finish();
}

test "a stopped child reports the code a system reports for one ended from outside" {
    try testing.assertEqual(ChildExit.stopped, 137L);
}

test "each child bridge is defined once however often it is called" {
    let host = new EmissionHost("children_reuse");
    let first = children.startProcessRuntime(host.runtime);
    let second = children.startProcessRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the start");
    let firstRead = children.readChildRuntime(host.runtime);
    try testing.assertTrue(firstRead.function == children.readChildRuntime(host.runtime).function,
        "the second use redefined the read");
    string text = host.text();
    try testing.assertTrue(text.indexOf("define internal ptr @ens_start_process(") >= 0,
        "the start was never defined: {text}");
    try testing.assertTrue(text.indexOf("define internal i64 @ens_read_child(") >= 0,
        "the read was never defined: {text}");
    try host.finish();
}

// Only the host platform's half of a bridge reaches an object file, so the other halves are held
// to the verifier here instead.
test "every target's child bridges build code the verifier accepts" {
    for (let triple in childTriples()) {
        let host = new EmissionHost("children_{triple}");
        host.retarget(triple);
        let child = host.runtime.nullPointer();
        let text = host.runtime.payloadData(host.runtime.stringLiteral("git".toBytes()));
        host.runtime.call(children.startProcessRuntime(host.runtime), [text, text,
            host.runtime.int64(1), text, text, host.runtime.int64(1), host.runtime.int64(7)],
            "child");
        host.runtime.call(children.readChildRuntime(host.runtime), [child, text,
            host.runtime.int64(4)], "count");
        host.runtime.call(children.pollChildRuntime(host.runtime), [child,
            host.runtime.int64(250)], "ready");
        host.runtime.call(children.killChildRuntime(host.runtime), [child], "stopped");
        host.runtime.call(children.waitChildRuntime(host.runtime), [child], "code");
        host.runtime.call(children.releaseChildRuntime(host.runtime), [child], "");
        try host.finish();
    }
}

// Both halves of every child bridge, and this machine's own triple, which is the half its object
// files actually hold.
childTriples() -> string[] {
    return [target.hostTargetTriple(), "x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin23"];
}

posixTriples() -> string[] {
    return ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"];
}

// The text of the function called `name`, from its definition to its closing brace.
functionText(string text, string name) -> string throws {
    long start = text.indexOf("define internal ptr @{name}(");
    try testing.assertTrue(start >= 0, "'{name}' was never defined: {text}");
    string rest = text.substring(start, text.length);
    long end = rest.indexOf("\n}");
    try testing.assertTrue(end >= 0, "'{name}' was left unclosed: {rest}");
    return rest.substring(0, end);
}

// Fails unless the printed block holds every line, naming the first one it lacks.
assertBlockHolds(string triple, string text, string label, string[] lines) throws {
    string block = blockText(text, label);
    for (let line in lines) {
        try testing.assertTrue(block.indexOf(line) >= 0,
            "{triple}: block '{label}' has no '{line}': {block}");
    }
}

// One printed block, from its label line to the blank line that ends it, or "" when there is none.
blockText(string text, string label) -> string {
    long start = text.indexOf("\n{label}:");
    if (start < 0) {
        return "";
    }
    long end = text.indexOf("\n\n", start + 1);
    if (end < 0) {
        return text.substring(start + 1);
    }
    return text.substring(start + 1, end);
}
