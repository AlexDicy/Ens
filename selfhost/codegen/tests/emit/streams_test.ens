// The four bridges over the C library's streams and the table an errno becomes, each held to the
// verifier from whichever host runs the suite. The error number is the library's own on every
// target, so the halves that differ are the name of the errno cell and nothing else.
import @std.testing;
import @ens.llvm.target;
import EmissionHost from support;
import ErrorMapping from emit.errorkinds;
import IoErrorKind from emit.errorkinds;
import emit.errorkinds;
import Unnamed from emit.streams;
import emit.streams;

// Every target a stream bridge is emitted for, the host's own first so a run always covers it.
triples() -> string[] {
    return [target.hostTargetTriple(), "x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
}

// The kind the table gives a number, or -1 where the table leaves it to be an Other.
kindOf(ErrorMapping[] mappings, long code) -> long {
    for (let mapping in mappings) {
        if (mapping.code == code) {
            return mapping.kind;
        }
    }
    return -1;
}

// A pipe whose reader has gone is the one condition the SIGPIPE ruling promises a stream reports as
// Closed, and a call the system cut short is the one a caller may retry.
test "the io table names the two conditions a stream can act on" {
    let mappings = errorkinds.ioErrorMappings();
    try testing.assertEqual(kindOf(mappings, 32), IoErrorKind.closed);
    try testing.assertEqual(kindOf(mappings, 4), IoErrorKind.interrupted);
}

// Each of these has more than one cause, so none of them establishes a stream condition and each is
// left to be an Other.
test "the io table claims nothing about a number with more than one cause" {
    let mappings = errorkinds.ioErrorMappings();
    try testing.assertEqual(kindOf(mappings, 9), -1);
    try testing.assertEqual(kindOf(mappings, 28), -1);
    try testing.assertEqual(kindOf(mappings, 5), -1);
    try testing.assertEqual(kindOf(mappings, 0), -1);
}

test "the io table maps no number twice and answers Other outright for none" {
    let mappings = errorkinds.ioErrorMappings();
    try testing.assertTrue(mappings.length > 0, "the io table maps nothing");
    for (long i = 0; i < mappings.length; i++) {
        try testing.assertNotEqual(mappings[i].kind, IoErrorKind.other);
        for (long j = i + 1; j < mappings.length; j++) {
            try testing.assertNotEqual(mappings[j].code, mappings[i].code);
        }
    }
}

// One table serves every target because a stream bridge answers the C library's errno rather than
// the platform's own error number, which is what the file and process tables answer.
test "the io table is one table for every target" {
    let mappings = errorkinds.ioErrorMappings();
    for (let triple in triples()) {
        let host = new EmissionHost("io_errorkinds_{triple}");
        host.retarget(triple);
        host.runtime.call(errorkinds.ioErrorKindRuntime(host.runtime), [host.runtime.int32(32)],
            "kind");
        string text = host.text();
        try testing.assertTrue(text.indexOf("define internal i32 @ens_io_error_kind(") >= 0,
            "'{triple}' never defined the io bridge: {text}");
        try testing.assertTrue(text.indexOf("label %kind.2 [") >= 0,
            "'{triple}' does not fall through to Other: {text}");
        try host.finish();
    }
    try testing.assertEqual(kindOf(mappings, 32), IoErrorKind.closed);
}

// The number a failure answers where the library named none is the same on every target, which is
// what lets one constant serve all of them rather than a table of its own.
test "the unnamed failure is one number every target shares" {
    for (let triple in triples()) {
        let host = new EmissionHost("stream_unnamed_{triple}");
        host.retarget(triple);
        let runtime = host.runtime;
        runtime.call(streams.writeRuntime(runtime), [runtime.nullPointer(),
            runtime.nullPointer(), runtime.int64(0), runtime.nullPointer()], "wrote");
        try testing.assertTrue(host.text().indexOf("i32 {Unnamed.failure}, i32 %") >= 0,
            "'{triple}' answers something other than the shared number: {host.text()}");
        try host.finish();
    }
}

test "every target's stream bridges build code the verifier accepts" {
    for (let triple in triples()) {
        let host = new EmissionHost("streams_{triple}");
        host.retarget(triple);
        let runtime = host.runtime;
        runtime.call(streams.writeRuntime(runtime), [runtime.nullPointer(),
            runtime.nullPointer(), runtime.int64(0), runtime.nullPointer()], "wrote");
        runtime.call(streams.readRuntime(runtime), [runtime.nullPointer(), runtime.nullPointer(),
            runtime.int64(0), runtime.nullPointer()], "read");
        runtime.call(streams.flushRuntime(runtime), [runtime.nullPointer()], "flushed");
        runtime.call(streams.closeRuntime(runtime), [runtime.nullPointer()], "closed");
        string text = host.text();
        for (let name in ["ens_stream_write", "ens_stream_read", "ens_stream_flush",
                "ens_stream_close"]) {
            try testing.assertTrue(text.indexOf("define internal i32 @{name}(") >= 0,
                "'{triple}' never defined {name}: {text}");
        }
        try host.finish();
    }
}

// Windows reaches the errno cell through the Microsoft runtime's own name, and nothing else about a
// stream bridge differs between targets.
test "each target reads the errno cell its own library names" {
    let windows = new EmissionHost("stream_errno_windows");
    windows.retarget("x86_64-pc-windows-msvc");
    windows.runtime.call(streams.flushRuntime(windows.runtime), [windows.runtime.nullPointer()],
        "flushed");
    try testing.assertTrue(windows.text().indexOf("@_errno()") >= 0,
        "windows does not read _errno: {windows.text()}");
    try windows.finish();

    let linux = new EmissionHost("stream_errno_linux");
    linux.retarget("x86_64-unknown-linux-gnu");
    linux.runtime.call(streams.flushRuntime(linux.runtime), [linux.runtime.nullPointer()],
        "flushed");
    try testing.assertTrue(linux.text().indexOf("@__errno_location()") >= 0,
        "linux does not read __errno_location: {linux.text()}");
    try linux.finish();

    let darwin = new EmissionHost("stream_errno_darwin");
    darwin.retarget("aarch64-apple-darwin23");
    darwin.runtime.call(streams.flushRuntime(darwin.runtime), [darwin.runtime.nullPointer()],
        "flushed");
    try testing.assertTrue(darwin.text().indexOf("@__error()") >= 0,
        "darwin does not read __error: {darwin.text()}");
    try darwin.finish();
}

test "a stream bridge needed twice is defined once" {
    let host = new EmissionHost("streams_reuse");
    let first = streams.flushRuntime(host.runtime);
    let second = streams.flushRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the bridge");
    host.runtime.call(first, [host.runtime.nullPointer()], "flushed");
    try host.finish();
}

// The four bridges are four functions, since a caller that cannot tell a write from a close cannot
// say which one failed.
test "the four stream bridges are four functions" {
    let host = new EmissionHost("streams_distinct");
    let runtime = host.runtime;
    let written = streams.writeRuntime(runtime);
    let read = streams.readRuntime(runtime);
    let flushed = streams.flushRuntime(runtime);
    let closed = streams.closeRuntime(runtime);
    try testing.assertTrue(written.function != read.function, "write and read share a bridge");
    try testing.assertTrue(flushed.function != closed.function, "flush and close share a bridge");
    try testing.assertTrue(written.function != flushed.function, "write and flush share a bridge");
    runtime.call(written, [runtime.nullPointer(), runtime.nullPointer(), runtime.int64(0),
        runtime.nullPointer()], "wrote");
    runtime.call(read, [runtime.nullPointer(), runtime.nullPointer(), runtime.int64(0),
        runtime.nullPointer()], "read");
    runtime.call(flushed, [runtime.nullPointer()], "flushed");
    runtime.call(closed, [runtime.nullPointer()], "closed");
    try host.finish();
}
