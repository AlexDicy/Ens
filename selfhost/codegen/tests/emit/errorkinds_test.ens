// Every platform's error-number table, pinned from whichever host runs the suite, and the bridge
// the table becomes. The numbers above 32 differ between Linux and Darwin, so each has its own row.
import @std.testing;
import @ens.llvm.target;
import EmissionHost from support;
import ErrorKind from emit.errorkinds;
import ErrorMapping from emit.errorkinds;
import ProcessErrorKind from emit.errorkinds;
import emit.errorkinds;

// The kind the table gives a number, or -1 where the table leaves it to be an Other.
kindOf(ErrorMapping[] mappings, long code) -> long {
    for (let mapping in mappings) {
        if (mapping.code == code) {
            return mapping.kind;
        }
    }
    return -1;
}

test "a Linux table maps the errno numbers a file call reports" {
    let mappings = errorkinds.errorMappings("x86_64-unknown-linux-gnu");
    try testing.assertEqual(kindOf(mappings, 2), ErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 1), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 13), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 30), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 17), ErrorKind.alreadyExists);
    try testing.assertEqual(kindOf(mappings, 20), ErrorKind.notADirectory);
    try testing.assertEqual(kindOf(mappings, 21), ErrorKind.isADirectory);
    try testing.assertEqual(kindOf(mappings, 28), ErrorKind.noSpace);
    try testing.assertEqual(kindOf(mappings, 39), ErrorKind.directoryNotEmpty);
    try testing.assertEqual(kindOf(mappings, 122), ErrorKind.noSpace);
}

test "a Darwin table maps its own numbers for a full directory and a spent quota" {
    let mappings = errorkinds.errorMappings("aarch64-apple-darwin23");
    try testing.assertEqual(kindOf(mappings, 66), ErrorKind.directoryNotEmpty);
    try testing.assertEqual(kindOf(mappings, 69), ErrorKind.noSpace);
    try testing.assertEqual(kindOf(mappings, 39), -1);
    try testing.assertEqual(kindOf(mappings, 122), -1);
}

test "both POSIX tables agree on the numbers below 32" {
    let linux = errorkinds.errorMappings("x86_64-unknown-linux-gnu");
    let darwin = errorkinds.errorMappings("x86_64-apple-darwin23");
    for (let mapping in linux) {
        if (mapping.code < 32) {
            try testing.assertEqual(kindOf(darwin, mapping.code), mapping.kind);
        }
    }
}

test "a Windows table maps Win32 codes and never claims IsADirectory" {
    let mappings = errorkinds.errorMappings("x86_64-pc-windows-msvc");
    try testing.assertEqual(kindOf(mappings, 2), ErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 3), ErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 5), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 32), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 80), ErrorKind.alreadyExists);
    try testing.assertEqual(kindOf(mappings, 183), ErrorKind.alreadyExists);
    try testing.assertEqual(kindOf(mappings, 145), ErrorKind.directoryNotEmpty);
    try testing.assertEqual(kindOf(mappings, 267), ErrorKind.notADirectory);
    try testing.assertEqual(kindOf(mappings, 112), ErrorKind.noSpace);
    for (let mapping in mappings) {
        try testing.assertNotEqual(mapping.kind, ErrorKind.isADirectory);
    }
}

test "no table maps a number twice or maps to Other outright" {
    string[] triples = ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let mappings = errorkinds.errorMappings(triple);
        try testing.assertTrue(mappings.length > 0, "'{triple}' maps nothing");
        for (long i = 0; i < mappings.length; i++) {
            try testing.assertNotEqual(mappings[i].kind, ErrorKind.other);
            try testing.assertEqual(kindOf(mappings, mappings[i].code), mappings[i].kind);
            for (long j = i + 1; j < mappings.length; j++) {
                try testing.assertNotEqual(mappings[j].code, mappings[i].code);
            }
        }
    }
}

test "an error kind bridge needed twice is defined once" {
    let host = new EmissionHost("errorkinds_reuse");
    let first = errorkinds.errorKindRuntime(host.runtime);
    let second = errorkinds.errorKindRuntime(host.runtime);
    try testing.assertTrue(first.function == second.function,
        "the second use redefined the bridge");
    host.runtime.call(first, [host.runtime.int32(2)], "kind");
    try host.finish();
}

// The table each target turns into a switch, held to the verifier from whichever host runs.
test "every target's error kind switch builds code the verifier accepts" {
    string[] triples = [target.hostTargetTriple(), "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23",
        "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let host = new EmissionHost("errorkinds_{triple}");
        host.retarget(triple);
        host.runtime.call(errorkinds.errorKindRuntime(host.runtime), [host.runtime.int32(2)],
            "kind");
        try host.finish();
    }
}

// Linux and Darwin file bridges already return errno, so classifying one is the table they have.
test "a target whose file calls return errno uses one table for both bridges" {
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin23", "aarch64-apple-darwin23"]) {
        let native = errorkinds.errorMappings(triple);
        let errno = errorkinds.fsErrnoMappings(triple);
        try testing.assertEqual(errno.length, native.length);
        for (let mapping in native) {
            try testing.assertEqual(kindOf(errno, mapping.code), mapping.kind);
        }
    }
}

// The Microsoft runtime agrees on the shared set and numbers a full directory 41 where Linux
// numbers it 39, which is the one row that moves.
test "a Windows errno table maps the C runtime's own numbers" {
    let mappings = errorkinds.fsErrnoMappings("x86_64-pc-windows-msvc");
    try testing.assertEqual(kindOf(mappings, 2), ErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 1), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 13), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 30), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 17), ErrorKind.alreadyExists);
    try testing.assertEqual(kindOf(mappings, 20), ErrorKind.notADirectory);
    try testing.assertEqual(kindOf(mappings, 21), ErrorKind.isADirectory);
    try testing.assertEqual(kindOf(mappings, 28), ErrorKind.noSpace);
    try testing.assertEqual(kindOf(mappings, 41), ErrorKind.directoryNotEmpty);
    try testing.assertEqual(kindOf(mappings, 39), -1);
}

// A Windows errno table is not a Win32 table, and the numbers that mean different things in the two
// are what would go wrong if one were read for the other.
test "the Windows errno and Win32 tables disagree where the numbering does" {
    let errno = errorkinds.fsErrnoMappings("x86_64-pc-windows-msvc");
    let win32 = errorkinds.errorMappings("x86_64-pc-windows-msvc");
    try testing.assertEqual(kindOf(errno, 5), -1);
    try testing.assertEqual(kindOf(win32, 5), ErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(errno, 21), ErrorKind.isADirectory);
    try testing.assertEqual(kindOf(win32, 21), -1);
    try testing.assertEqual(kindOf(errno, 32), -1);
    try testing.assertEqual(kindOf(win32, 32), ErrorKind.permissionDenied);
}

// The Microsoft runtime defines no quota error, so nothing on Windows carries the number Linux and
// Darwin each give a spent quota.
test "no errno table claims a quota number another platform owns" {
    let windows = errorkinds.fsErrnoMappings("x86_64-pc-windows-msvc");
    try testing.assertEqual(kindOf(windows, 122), -1);
    try testing.assertEqual(kindOf(windows, 69), -1);
    try testing.assertEqual(kindOf(errorkinds.fsErrnoMappings("x86_64-unknown-linux-gnu"), 122),
        ErrorKind.noSpace);
    try testing.assertEqual(kindOf(errorkinds.fsErrnoMappings("x86_64-apple-darwin23"), 69),
        ErrorKind.noSpace);
}

test "no errno table maps a number twice or maps to Other outright" {
    string[] triples = ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let mappings = errorkinds.fsErrnoMappings(triple);
        try testing.assertTrue(mappings.length > 0, "'{triple}' maps nothing");
        for (long i = 0; i < mappings.length; i++) {
            try testing.assertNotEqual(mappings[i].kind, ErrorKind.other);
            for (long j = i + 1; j < mappings.length; j++) {
                try testing.assertNotEqual(mappings[j].code, mappings[i].code);
            }
        }
    }
}

// The errno bridge is defined beside the two the module already builds, so a program that classifies
// both a stream failure and a file call gets three switches rather than one shared by accident.
test "every target's errno kind switch builds beside the other two" {
    string[] triples = [target.hostTargetTriple(), "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let host = new EmissionHost("fs_errnokinds_{triple}");
        host.retarget(triple);
        let native = errorkinds.errorKindRuntime(host.runtime);
        let errno = errorkinds.fsErrnoKindRuntime(host.runtime);
        try testing.assertTrue(native.function != errno.function,
            "'{triple}' answers both numbering spaces through one bridge");
        host.runtime.call(native, [host.runtime.int32(2)], "native.kind");
        host.runtime.call(errno, [host.runtime.int32(2)], "errno.kind");
        string text = host.text();
        try testing.assertTrue(text.indexOf("define internal i32 @ens_fs_errno_kind(") >= 0,
            "'{triple}' never defined the errno bridge: {text}");
        try host.finish();
    }
}

test "a Linux table maps the numbers a start reports" {
    let mappings = errorkinds.processErrorMappings("x86_64-unknown-linux-gnu");
    try testing.assertEqual(kindOf(mappings, 2), ProcessErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 20), ProcessErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 1), ProcessErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 13), ProcessErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 8), -1);
    try testing.assertEqual(kindOf(mappings, 22), -1);
}

test "both POSIX process tables are one table" {
    let linux = errorkinds.processErrorMappings("x86_64-unknown-linux-gnu");
    let darwin = errorkinds.processErrorMappings("aarch64-apple-darwin23");
    try testing.assertEqual(linux.length, darwin.length);
    for (let mapping in linux) {
        try testing.assertEqual(kindOf(darwin, mapping.code), mapping.kind);
    }
}

// A program image Windows cannot run has no kind of its own, so a script handed to a start is an
// Other rather than a permission or an absence.
test "a Windows table maps the numbers a start reports and gives a bad image no kind" {
    let mappings = errorkinds.processErrorMappings("x86_64-pc-windows-msvc");
    try testing.assertEqual(kindOf(mappings, 2), ProcessErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 3), ProcessErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 267), ProcessErrorKind.notFound);
    try testing.assertEqual(kindOf(mappings, 5), ProcessErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 740), ProcessErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 1260), ProcessErrorKind.permissionDenied);
    try testing.assertEqual(kindOf(mappings, 193), -1);
}

test "no process table maps a number twice or maps to Other outright" {
    string[] triples = ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu", "x86_64-apple-darwin23", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let mappings = errorkinds.processErrorMappings(triple);
        try testing.assertTrue(mappings.length > 0, "'{triple}' maps nothing");
        for (long i = 0; i < mappings.length; i++) {
            try testing.assertNotEqual(mappings[i].kind, ProcessErrorKind.other);
            try testing.assertEqual(kindOf(mappings, mappings[i].code), mappings[i].kind);
            for (long j = i + 1; j < mappings.length; j++) {
                try testing.assertNotEqual(mappings[j].code, mappings[i].code);
            }
        }
    }
}

// The two bridges share one switch emitter, and each switch falls through to its own last kind.
test "every target's process error kind switch builds beside the file one" {
    string[] triples = [target.hostTargetTriple(), "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu", "aarch64-apple-darwin23"];
    for (let triple in triples) {
        let host = new EmissionHost("process_errorkinds_{triple}");
        host.retarget(triple);
        let files = errorkinds.errorKindRuntime(host.runtime);
        let processes = errorkinds.processErrorKindRuntime(host.runtime);
        try testing.assertTrue(files.function != processes.function,
            "the two kinds of error share one bridge");
        host.runtime.call(files, [host.runtime.int32(2)], "file.kind");
        host.runtime.call(processes, [host.runtime.int32(2)], "process.kind");
        string text = host.text();
        try testing.assertTrue(text.indexOf("define internal i32 @ens_process_error_kind(") >= 0,
            "the process bridge was never defined: {text}");
        try testing.assertTrue(text.indexOf("label %kind.7 [") >= 0,
            "the file switch does not fall through to Other: {text}");
        try testing.assertTrue(text.indexOf("label %kind.2 [") >= 0,
            "the process switch does not fall through to Other: {text}");
        try host.finish();
    }
}
