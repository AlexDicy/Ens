// The address resolver searches a sorted index once one thread has built it, and scans the chunks
// while it is being built or when there was no memory for it.
import @std.testing;
import EmissionHost from support;
import emit.traceresolvers;

// The body of one function of the emitted resolver, from its definition to its closing brace.
functionBody(string module, string signature) -> string throws {
    long start = module.indexOf(signature);
    try testing.assertTrue(start >= 0, "'{signature}' was never defined: {module}");
    string rest = module.substring(start, module.length);
    long end = rest.indexOf("\n}");
    try testing.assertTrue(end >= 0, "'{signature}' was left unclosed: {rest}");
    return rest.substring(0, end);
}

resolverModule() -> string throws {
    let host = new EmissionHost("trace_resolvers");
    traceresolvers.defineResolveAddress(host.runtime);
    string module = host.text();
    try host.finish();
    return module;
}

test "the resolver claims the index once and scans while another thread builds it" {
    string body = try functionBody(try resolverModule(), "@ens_resolve_addr(i64");
    try testing.assertTrue(body.indexOf("load atomic i64, ptr @ens_trace_index_state acquire")
        >= 0, "the resolver does not read whether the index is ready: {body}");
    try testing.assertTrue(body.indexOf("cmpxchg ptr @ens_trace_index_state, i64 0, i64 1") >= 0,
        "the resolver does not claim the building of the index: {body}");
    try testing.assertTrue(body.indexOf("call ptr @ens_resolve_addr_scan(") >= 0,
        "the resolver has no scan to fall back on: {body}");
    try testing.assertTrue(body.indexOf("lshr i64") >= 0,
        "the resolver does not halve its range: {body}");
}

test "the index is sorted by qsort and published only once it is filled" {
    string body = try functionBody(try resolverModule(), "@ens_trace_index_build()");
    long sorted = body.indexOf("call void @qsort(");
    long published = body.indexOf("store atomic i64 2, ptr @ens_trace_index_state release");
    try testing.assertTrue(sorted >= 0, "the index is never sorted: {body}");
    try testing.assertTrue(published > sorted, "the index is published before it is sorted: {body}");
    try testing.assertTrue(body.indexOf("store atomic i64 3, ptr @ens_trace_index_state release")
        >= 0, "an index with no memory is never marked as failed: {body}");
}
