// The ownership verifier and the place model, over hand-built EIR: a balanced function passes,
// and each way naive ARC lowering can go wrong reports its own violation. The place model is
// checked through the identity checks the verifier and the later passes run on it.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import ProgramAnalysis from @ens.sema.pipeline;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirConstInt from eir.model;
import EirConstString from eir.model;
import EirStringConcat from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirReleasePtr from eir.model;
import EirTakePtr from eir.model;
import EirStorePtr from eir.model;
import EirSlotAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirFieldAddress from eir.model;
import EirLoadSlot from eir.model;
import EirRetainPtr from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirArrayNew from eir.model;
import EirArrayFreeze from eir.model;
import EirAccess from eir.model;
import EirBoundsCheck from eir.model;
import EirBranch from eir.model;
import EirJump from eir.model;
import EirReturn from eir.model;
import EirConstBool from eir.model;
import EirConstNull from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPresence from eir.model;
import EirPayloadRead from eir.model;
import PlaceRelation from eir.place;
import eir.place;
import eir.ownership;
import eir.storage;
import eir.verify;
import support;

test "a produced string stored into a slot and released at the end balances" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("balanced", false, null, [], intType);
    long slot = builder.addSlot("s", stringType, true, false);
    long left = builder.newTemp(stringType);
    builder.append(new EirConstString(left, stringType, "a".toBytes()));
    long right = builder.newTemp(stringType);
    builder.append(new EirConstString(right, stringType, "b".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, left, right));
    builder.append(new EirStoreSlot(slot, joined));
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, slot));
    builder.append(new EirReleasePtr(address));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
}

test "what a take moves out of storage is owned, so a store over it and its release balance" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("replaced", false, null, [], intType);
    long slot = builder.addSlot("s", stringType, true, false);
    long text = builder.newTemp(stringType);
    builder.append(new EirConstString(text, stringType, "a".toBytes()));
    long first = builder.newTemp(stringType);
    builder.append(new EirStringConcat(first, stringType, text, text));
    builder.append(new EirStoreSlot(slot, first));
    long second = builder.newTemp(stringType);
    builder.append(new EirStringConcat(second, stringType, text, text));
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, slot));
    long previous = builder.newTemp(stringType);
    builder.append(new EirTakePtr(previous, stringType, address));
    builder.append(new EirStorePtr(address, second));
    builder.append(new EirRelease(previous));
    builder.append(new EirReleasePtr(address));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
    try assertNoViolations(storage.verifyStorage(function));
}

test "a produced string never passed on is reported as a leak" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("leaks", false, null, [], intType);
    long left = builder.newTemp(stringType);
    builder.append(new EirConstString(left, stringType, "a".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, left, left));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "%1 still owns a reference where the function returns");
}

test "releasing the same temp twice and using it afterwards are both reported" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("doubled", false, null, [], intType);
    long text = builder.newTemp(stringType);
    builder.append(new EirConstString(text, stringType, "a".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, text, text));
    builder.append(new EirRelease(joined));
    builder.append(new EirRelease(joined));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let violations = ownership.verifyOwnership(builder.finish());
    try assertMentions(violations, "released after its reference was already given up");
    try assertMentions(violations, "is used after its reference was given up");
}

test "a freeze takes the array's reference, so returning the 'bytes' balances" {
    let store = try support.freshStore();
    let longType = store.primitive(PrimitiveKind.Long);
    let array = store.arrayOf(store.primitive(PrimitiveKind.Byte));
    let builder = new EirFunctionBuilder("frozen", false, null, [], store.bytesType());
    long size = builder.newTemp(longType);
    builder.append(new EirConstInt(size, longType, 2));
    long made = builder.newTemp(array);
    builder.append(new EirArrayNew(made, array, size));
    long frozen = builder.newTemp(store.bytesType());
    builder.append(new EirArrayFreeze(frozen, store.bytesType(), made));
    builder.terminate(new EirReturn(frozen));
    try assertNoViolations(ownership.verifyOwnership(builder.finish()));
}

test "an array released or frozen again after a freeze is reported" {
    let store = try support.freshStore();
    let longType = store.primitive(PrimitiveKind.Long);
    let array = store.arrayOf(store.primitive(PrimitiveKind.Byte));
    let builder = new EirFunctionBuilder("refrozen", false, null, [], store.bytesType());
    long size = builder.newTemp(longType);
    builder.append(new EirConstInt(size, longType, 2));
    long made = builder.newTemp(array);
    builder.append(new EirArrayNew(made, array, size));
    long frozen = builder.newTemp(store.bytesType());
    builder.append(new EirArrayFreeze(frozen, store.bytesType(), made));
    long again = builder.newTemp(store.bytesType());
    builder.append(new EirArrayFreeze(again, store.bytesType(), made));
    builder.append(new EirRelease(again));
    builder.append(new EirRelease(made));
    builder.terminate(new EirReturn(frozen));
    let violations = ownership.verifyOwnership(builder.finish());
    try assertMentions(violations, "%1 is frozen after its reference was already given up");
    try assertMentions(violations, "%1 is released after its reference was already given up");
}

test "releasing a borrowed value is reported" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("borrowed", false,
        null, [new EirParameter("text", stringType)], intType);
    builder.append(new EirRelease(0));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "released although it owns no reference");
}

test "storing a borrowed value without retaining it is reported" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("unretained", false,
        null, [new EirParameter("text", stringType)], intType);
    long slot = builder.addSlot("copy", stringType, true, false);
    builder.append(new EirStoreSlot(slot, 0));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "without owning a reference");
}

test "a retain on a borrowed value makes a store balance" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("retained", false,
        null, [new EirParameter("text", stringType)], intType);
    long slot = builder.addSlot("copy", stringType, true, false);
    builder.append(new EirRetain(0));
    builder.append(new EirStoreSlot(slot, 0));
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, slot));
    builder.append(new EirReleasePtr(address));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
}

test "a borrowed value retained once for each of two stores balances" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("shared", false,
        null, [new EirParameter("text", stringType)], intType);
    long first = builder.addSlot("first", stringType, true, false);
    long second = builder.addSlot("second", stringType, true, false);
    builder.append(new EirRetain(0));
    builder.append(new EirStoreSlot(first, 0));
    builder.append(new EirRetain(0));
    builder.append(new EirStoreSlot(second, 0));
    long firstAddress = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(firstAddress, stringType, first));
    builder.append(new EirReleasePtr(firstAddress));
    long secondAddress = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(secondAddress, stringType, second));
    builder.append(new EirReleasePtr(secondAddress));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
}

test "a second store of a borrowed value with only one retain is reported" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("unbalanced", false,
        null, [new EirParameter("text", stringType)], intType);
    long first = builder.addSlot("first", stringType, true, false);
    long second = builder.addSlot("second", stringType, true, false);
    builder.append(new EirRetain(0));
    builder.append(new EirStoreSlot(first, 0));
    builder.append(new EirStoreSlot(second, 0));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "%0 is stored into $1 without owning a reference");
}

test "a borrowed value retained and never passed on is reported as a leak" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("held", false,
        null, [new EirParameter("text", stringType)], intType);
    builder.append(new EirRetain(0));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "%0 still owns a reference where the function returns");
}

// A comparison numbers the block it jumps to on a difference before the blocks that jump into it,
// which is what makes a pass reading a block before its predecessors report a conflict against the
// state it guessed there.
test "a block reached only from a later block balances once the states settle" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("backwards", false,
        null, [new EirParameter("text", stringType)], intType);
    long slot = builder.addSlot("copy", stringType, true, false);
    long stored = builder.newBlock("stored");
    long forward = builder.newBlock("forward");
    long exit = builder.newBlock("exit");
    builder.terminate(new EirJump(forward));
    builder.moveTo(stored);
    builder.append(new EirRetain(0));
    builder.append(new EirStoreSlot(slot, 0));
    builder.terminate(new EirJump(exit));
    builder.moveTo(forward);
    builder.terminate(new EirJump(stored));
    builder.moveTo(exit);
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, slot));
    builder.append(new EirReleasePtr(address));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
}

test "a reference released on one path only is reported where the paths join" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("onepath", false, null, [], intType);
    long text = builder.newTemp(stringType);
    builder.append(new EirConstString(text, stringType, "a".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, text, text));
    long condition = builder.newTemp(boolType);
    builder.append(new EirConstBool(condition, boolType, true));
    long thenBlock = builder.newBlock("then");
    long merge = builder.newBlock("merge");
    builder.terminate(new EirBranch(condition, thenBlock, merge));
    builder.moveTo(thenBlock);
    builder.append(new EirRelease(joined));
    builder.terminate(new EirJump(merge));
    builder.moveTo(merge);
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "the ownership of %1 differs between the paths");
}

test "an address written into storage is rejected" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("stored", false, null, [], intType);
    long slot = builder.addSlot("s", stringType, true, false);
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, slot));
    builder.append(new EirStoreSlot(slot, address));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(verify.verifyFunction(builder.finish()),
        "addresses may be passed to a call but never stored");
}

test "a value where an address belongs is rejected" {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("mixed", false, null, [], intType);
    long text = builder.newTemp(stringType);
    builder.append(new EirConstString(text, stringType, "a".toBytes()));
    builder.append(new EirReleasePtr(text));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    try assertMentions(verify.verifyFunction(builder.finish()),
        "release_ptr takes an address but %0 is a value");
}

test "two element addresses through one index name the same place, through two do not" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let arrayType = store.arrayOf(intType);
    let builder = new EirFunctionBuilder("places", false, null, [], intType);
    long size = builder.newTemp(longType);
    builder.append(new EirConstInt(size, longType, 4));
    long array = builder.newTemp(arrayType);
    builder.append(new EirArrayNew(array, arrayType, size));
    long index = builder.newTemp(longType);
    builder.append(new EirConstInt(index, longType, 1));
    long other = builder.newTemp(longType);
    builder.append(new EirConstInt(other, longType, 1));
    long first = builder.newTemp(intType);
    builder.append(new EirBoundsCheck(array, index, EirAccess.Read));
    builder.append(new EirElementAddress(first, intType, array, index));
    long second = builder.newTemp(intType);
    builder.append(new EirElementAddress(second, intType, array, index));
    long third = builder.newTemp(intType);
    builder.append(new EirElementAddress(third, intType, array, other));
    long loaded = builder.newTemp(intType);
    builder.append(new EirLoadPtr(loaded, intType, first));
    builder.append(new EirRelease(array));
    builder.terminate(new EirReturn(loaded));
    let function = builder.finish();

    let firstPlace = place.placeOf(function, first);
    let secondPlace = place.placeOf(function, second);
    let thirdPlace = place.placeOf(function, third);
    if (firstPlace == null || secondPlace == null || thirdPlace == null) {
        try testing.fail("an element address has no place");
        return;
    }
    try testing.assertTrue(place.relate(firstPlace, secondPlace) == PlaceRelation.Same,
        "one index temp should name one place");
    try testing.assertTrue(place.relate(firstPlace, thirdPlace) == PlaceRelation.Unknown,
        "two index temps holding equal values are not decidably the same place");
}

test "a struct receiver address is an opaque root, so identity against it stays unknown" {
    let analysis = try support.analyzeMain(
        "struct Point \{\n"
        + "    protected int x;\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let point = try support.structNamed(analysis, "Point");
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("opaque", false, point, [], intType);
    long slot = builder.addSlot("local", intType, false, false);
    long slotAddress = builder.newTemp(intType);
    builder.append(new EirSlotAddress(slotAddress, intType, slot));
    long loaded = builder.newTemp(intType);
    builder.append(new EirLoadPtr(loaded, intType, 0));
    builder.terminate(new EirReturn(loaded));
    let function = builder.finish();

    let receiverPlace = place.placeOf(function, 0);
    let slotPlace = place.placeOf(function, slotAddress);
    if (receiverPlace == null || slotPlace == null) {
        try testing.fail("an address has no place");
        return;
    }
    try testing.assertTrue(place.relate(receiverPlace, receiverPlace) == PlaceRelation.Same,
        "the receiver names itself");
    try testing.assertTrue(place.relate(receiverPlace, slotPlace) == PlaceRelation.Unknown,
        "nothing is known about what a receiver address points at");
    try testing.assertTrue(place.relate(slotPlace, slotPlace) == PlaceRelation.Same,
        "a slot address names its own slot");
}

test "two distinct slots are different places" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("slots", false, null, [], intType);
    long first = builder.addSlot("a", intType, false, false);
    long second = builder.addSlot("b", intType, false, false);
    long firstAddress = builder.newTemp(intType);
    builder.append(new EirSlotAddress(firstAddress, intType, first));
    long secondAddress = builder.newTemp(intType);
    builder.append(new EirSlotAddress(secondAddress, intType, second));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();

    let firstPlace = place.placeOf(function, firstAddress);
    let secondPlace = place.placeOf(function, secondAddress);
    if (firstPlace == null || secondPlace == null) {
        try testing.fail("a slot address has no place");
        return;
    }
    try testing.assertTrue(place.relate(firstPlace, secondPlace) == PlaceRelation.Different,
        "distinct slots cannot overlap");
}

test "a struct a call produces and nothing stores or returns is reported as a leak" {
    let analysis = try cellProgram();
    let cell = try support.structNamed(analysis, "Cell");
    let builder = new EirFunctionBuilder("dropped", false, null, [],
        analysis.store().primitive(PrimitiveKind.Void));
    long made = madeValue(builder, cell);
    builder.terminate(new EirReturn(-1));
    let violations = ownership.verifyOwnership(builder.finish());
    try testing.assertEqual(violations.length, 1L);
    try testing.assertEqual(violations[0], "dropped: b0.entry: the struct %0 still owns the "
        + "references it holds where the function returns, which leaks them");
}

test "a struct a call produces balances once an owning slot takes it or it is returned" {
    let analysis = try cellProgram();
    let cell = try support.structNamed(analysis, "Cell");
    let builder = new EirFunctionBuilder("kept", false, null, [], cell);
    long slot = builder.addSlot("kept", cell, true, false);
    builder.append(new EirStoreSlot(slot, madeValue(builder, cell)));
    builder.terminate(new EirReturn(madeValue(builder, cell)));
    try assertNoViolations(ownership.verifyOwnership(builder.finish()));
}

test "a struct written into a borrowing slot still owns its references" {
    let analysis = try cellProgram();
    let cell = try support.structNamed(analysis, "Cell");
    let builder = new EirFunctionBuilder("parked", false, null, [],
        analysis.store().primitive(PrimitiveKind.Void));
    long slot = builder.addSlot("parked", cell, false, true);
    builder.append(new EirStoreSlot(slot, madeValue(builder, cell)));
    builder.terminate(new EirReturn(-1));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "the struct %0 still owns the references it holds where the function returns");
}

test "a struct read out of storage is stored once its references are retained there" {
    let analysis = try cellProgram();
    let cell = try support.structNamed(analysis, "Cell");
    Type probe = cell.fields().get(0).type();
    let builder = new EirFunctionBuilder("copied", false, null, [new EirParameter("from", cell)],
        cell);
    long source = builder.addSlot("from", cell, false, true);
    builder.append(new EirStoreSlot(source, 0));
    long first = builder.addSlot("first", cell, true, false);
    long second = builder.addSlot("second", cell, true, false);
    long read = builder.newTemp(cell);
    builder.append(new EirLoadSlot(read, cell, source));
    retainField(builder, cell, probe, source);
    builder.append(new EirStoreSlot(first, read));
    retainField(builder, cell, probe, source);
    builder.append(new EirStoreSlot(second, read));
    releaseField(builder, cell, probe, first);
    releaseField(builder, cell, probe, second);
    builder.append(new EirRetain(read));
    builder.terminate(new EirReturn(read));
    let function = builder.finish();
    try assertNoViolations(ownership.verifyOwnership(function));
    try assertNoViolations(storage.verifyStorage(function));
}

test "a borrowed struct or optional returned as it is is reported" {
    let analysis = try cellProgram();
    let cell = try support.structNamed(analysis, "Cell");
    let optional = analysis.store().optionalOf(cell);
    let returnedStruct = new EirFunctionBuilder("struct", false, null,
        [new EirParameter("given", cell)], cell);
    returnedStruct.terminate(new EirReturn(0));
    try assertMentions(ownership.verifyOwnership(returnedStruct.finish()),
        "%0 is returned without owning a reference");

    let returnedOptional = new EirFunctionBuilder("optional", false, null,
        [new EirParameter("given", optional)], optional);
    returnedOptional.terminate(new EirReturn(0));
    try assertMentions(ownership.verifyOwnership(returnedOptional.finish()),
        "%0 is returned without owning a reference");
}

test "a borrowed struct or optional a retain gives its own references can be returned" {
    let analysis = try cellProgram();
    Type cell = try support.structNamed(analysis, "Cell");
    let optional = analysis.store().optionalOf(cell);
    for (let type in [cell, optional]) {
        let returned = new EirFunctionBuilder("returned", false, null,
            [new EirParameter("given", type)], type);
        returned.append(new EirRetain(0));
        returned.terminate(new EirReturn(0));
        let function = returned.finish();
        try assertNoViolations(verify.verifyFunction(function));
        try assertNoViolations(ownership.verifyOwnership(function));

        let kept = new EirFunctionBuilder("kept", false, null, [new EirParameter("given", type)],
            analysis.store().primitive(PrimitiveKind.Void));
        kept.append(new EirRetain(0));
        kept.terminate(new EirReturn(-1));
        try assertMentions(ownership.verifyOwnership(kept.finish()),
            "%0 still owns the references");
    }
}

test "retaining a struct or optional that already owns what it holds is reported" {
    let analysis = try cellProgram();
    Type cell = try support.structNamed(analysis, "Cell");
    let optional = analysis.store().optionalOf(cell);
    for (let type in [cell, optional]) {
        let builder = new EirFunctionBuilder("twice", false, null, [], type);
        long made = madeValue(builder, type);
        builder.append(new EirRetain(made));
        builder.terminate(new EirReturn(made));
        try assertMentions(ownership.verifyOwnership(builder.finish()),
            "%0 is retained while it already owns a reference, which leaks one");
    }
}

test "a struct or optional taken out of a slot that owns it owns what it holds" {
    let analysis = try cellProgram();
    Type cell = try support.structNamed(analysis, "Cell");
    let optional = analysis.store().optionalOf(cell);
    let returned = new EirFunctionBuilder("returned", false, null, [], optional);
    long slot = returned.addSlot("kept", optional, false, false);
    returned.append(new EirStoreSlot(slot, madeValue(returned, optional)));
    long taken = returned.newTemp(optional);
    returned.append(new EirTakeSlot(taken, optional, slot));
    returned.terminate(new EirReturn(taken));
    let function = returned.finish();
    try assertNoViolations(verify.verifyFunction(function));
    try assertNoViolations(ownership.verifyOwnership(function));
    try assertNoViolations(storage.verifyStorage(function));

    let dropped = new EirFunctionBuilder("dropped", false, null, [],
        analysis.store().primitive(PrimitiveKind.Void));
    long held = dropped.addSlot("held", cell, false, false);
    dropped.append(new EirStoreSlot(held, madeValue(dropped, cell)));
    long ignored = dropped.newTemp(cell);
    dropped.append(new EirTakeSlot(ignored, cell, held));
    dropped.terminate(new EirReturn(-1));
    try assertMentions(ownership.verifyOwnership(dropped.finish()),
        "the struct %1 still owns the references it holds where the function returns");
}

test "an optional a call produces and nothing stores or returns is reported as a leak" {
    let analysis = try cellProgram();
    let optional = analysis.store().optionalOf(try support.structNamed(analysis, "Cell"));
    let builder = new EirFunctionBuilder("dropped", false, null, [],
        analysis.store().primitive(PrimitiveKind.Void));
    let ignored = madeValue(builder, optional);
    builder.terminate(new EirReturn(-1));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "the optional %0 still owns the references its payload holds where the function returns");
}

test "a payload moved out of an owned optional takes over what the optional held" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let returned = new EirFunctionBuilder("returned", false, null, [], payload);
    long moved = payloadOf(returned, madeValue(returned, optional), payload, EirPayloadRead.Move);
    returned.terminate(new EirReturn(moved));
    try assertNoViolations(ownership.verifyOwnership(returned.finish()));

    let dropped = new EirFunctionBuilder("dropped", false, null, [], payload);
    let ignored = payloadOf(dropped, madeValue(dropped, optional), payload, EirPayloadRead.Move);
    dropped.terminate(new EirReturn(nullOf(dropped, payload)));
    try assertMentions(ownership.verifyOwnership(dropped.finish()),
        "%1 still owns a reference where the function returns");
}

test "a payload borrowed from an owned optional leaves the optional owning what it held" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let builder = new EirFunctionBuilder("borrowed", false, null, [], payload);
    long pair = madeValue(builder, optional);
    long borrowed = payloadOf(builder, pair, payload, EirPayloadRead.Borrow);
    builder.append(new EirRelease(borrowed));
    builder.terminate(new EirReturn(nullOf(builder, payload)));
    let violations = ownership.verifyOwnership(builder.finish());
    try assertMentions(violations, "%1 is released although it owns no reference");
    try assertMentions(violations,
        "the optional %0 still owns the references its payload holds where the function returns");
}

test "a payload moved out of a borrowed optional is borrowed" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let released = new EirFunctionBuilder("released", false, null,
        [new EirParameter("given", optional)], payload);
    long freed = payloadOf(released, 0, payload, EirPayloadRead.Move);
    released.append(new EirRelease(freed));
    released.terminate(new EirReturn(nullOf(released, payload)));
    try assertMentions(ownership.verifyOwnership(released.finish()),
        "%1 is released although it owns no reference");

    let retained = new EirFunctionBuilder("retained", false, null,
        [new EirParameter("given", optional)], payload);
    long kept = payloadOf(retained, 0, payload, EirPayloadRead.Move);
    retained.append(new EirRetain(kept));
    retained.append(new EirRetain(kept));
    retained.terminate(new EirReturn(kept));
    try assertMentions(ownership.verifyOwnership(retained.finish()),
        "%1 is retained while it already owns a reference, which leaks one");
}

test "an optional owns nothing along the edge where its tag reads absent" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let tested = new EirFunctionBuilder("tested", false, null, [], payload);
    long pair = madeValue(tested, optional);
    long present = tested.newTemp(boolType);
    tested.append(new EirOptionalPresence(present, boolType, pair));
    long presentBlock = tested.newBlock("present");
    long absentBlock = tested.newBlock("absent");
    tested.terminate(new EirBranch(present, presentBlock, absentBlock));
    tested.moveTo(presentBlock);
    tested.terminate(new EirReturn(payloadOf(tested, pair, payload, EirPayloadRead.Move)));
    tested.moveTo(absentBlock);
    tested.terminate(new EirReturn(nullOf(tested, payload)));
    try assertNoViolations(ownership.verifyOwnership(tested.finish()));

    let untested = new EirFunctionBuilder("untested", false, null, [], payload);
    long other = madeValue(untested, optional);
    long condition = untested.newTemp(boolType);
    untested.append(new EirConstBool(condition, boolType, true));
    long thenBlock = untested.newBlock("then");
    long elseBlock = untested.newBlock("else");
    untested.terminate(new EirBranch(condition, thenBlock, elseBlock));
    untested.moveTo(thenBlock);
    untested.terminate(new EirReturn(payloadOf(untested, other, payload, EirPayloadRead.Move)));
    untested.moveTo(elseBlock);
    untested.terminate(new EirReturn(nullOf(untested, payload)));
    try assertMentions(ownership.verifyOwnership(untested.finish()),
        "else: the optional %0 still owns the references its payload holds");
}
test "an optional still owns what it holds along the edge where its tag reads present" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("dropped", false, null, [], payload);
    long pair = madeValue(builder, optional);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, pair));
    long presentBlock = builder.newBlock("present");
    long absentBlock = builder.newBlock("absent");
    builder.terminate(new EirBranch(present, presentBlock, absentBlock));
    builder.moveTo(presentBlock);
    builder.terminate(new EirReturn(nullOf(builder, payload)));
    builder.moveTo(absentBlock);
    builder.terminate(new EirReturn(nullOf(builder, payload)));
    let violations = ownership.verifyOwnership(builder.finish());
    try testing.assertEqual(violations.length, 1L);
    try assertMentions(violations,
        "present: the optional %0 still owns the references its payload holds");
}

test "an optional tested by a branch with one target for both edges still owns what it holds" {
    let store = try support.freshStore();
    let payload = store.optionalOf(store.stringType());
    let optional = store.optionalOf(payload);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("joined", false, null, [], payload);
    long pair = madeValue(builder, optional);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, pair));
    long joined = builder.newBlock("joined");
    builder.terminate(new EirBranch(present, joined, joined));
    builder.moveTo(joined);
    builder.terminate(new EirReturn(nullOf(builder, payload)));
    try assertMentions(ownership.verifyOwnership(builder.finish()),
        "joined: the optional %0 still owns the references its payload holds");
}


// A program declaring 'Cell', a struct whose one field holds a reference.
cellProgram() -> ProgramAnalysis throws {
    return try support.analyzeMain("class Probe \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    Probe probe;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
}

// Retains the reference a 'Cell' slot holds, the way lowering gives a copy read out of it its own.
retainField(EirFunctionBuilder builder, Type cell, Type probe, long slot) {
    long address = builder.newTemp(cell);
    builder.append(new EirSlotAddress(address, cell, slot));
    long field = builder.newTemp(probe);
    builder.append(new EirFieldAddress(field, probe, address, 0));
    builder.append(new EirRetainPtr(field));
}

releaseField(EirFunctionBuilder builder, Type cell, Type probe, long slot) {
    long address = builder.newTemp(cell);
    builder.append(new EirSlotAddress(address, cell, slot));
    long field = builder.newTemp(probe);
    builder.append(new EirFieldAddress(field, probe, address, 0));
    builder.append(new EirReleasePtr(field));
}

// A value of the given type a call returns, owning what it holds.
madeValue(EirFunctionBuilder builder, Type type) -> long {
    long made = builder.newTemp(type);
    builder.append(new EirCall(made, type, new EirCallee("make", null, [], type), -1, [], -1,
        null));
    return made;
}

payloadOf(EirFunctionBuilder builder, long pair, Type payload, EirPayloadRead read) -> long {
    long value = builder.newTemp(payload);
    builder.append(new EirOptionalPayload(value, payload, pair, read));
    return value;
}

// The absent reference, retained the way lowering hands it to a return.
nullOf(EirFunctionBuilder builder, Type type) -> long {
    long absent = builder.newTemp(type);
    builder.append(new EirConstNull(absent, type));
    builder.append(new EirRetain(absent));
    return absent;
}

assertNoViolations(string[] violations) throws {
    if (violations.length > 0) {
        try testing.fail("expected no violations, got {violations.length}: {violations[0]}");
    }
}

assertMentions(string[] violations, string fragment) throws {
    for (let violation in violations) {
        if (violation.indexOf(fragment) >= 0) {
            return;
        }
    }
    string seen = "none";
    if (violations.length > 0) {
        seen = violations[0];
    }
    try testing.fail("no violation mentions '{fragment}' ({violations.length} reported; "
        + "first: {seen})");
}
