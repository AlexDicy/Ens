// The structural verifier: each check catches its own class of malformed EIR, and a
// well-formed function passes with no findings.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import EirBinaryOp from eir.model;
import EirConstInt from eir.model;
import EirConstBool from eir.model;
import EirConstString from eir.model;
import EirStringByteAt from eir.model;
import EirBinary from eir.model;
import EirOptionalPresence from eir.model;
import EirStoreSlot from eir.model;
import EirRetain from eir.model;
import EirReturn from eir.model;
import EirBranch from eir.model;
import EirJump from eir.model;
import EirTakeSlot from eir.model;
import EirSlotAddress from eir.model;
import EirReleasePtr from eir.model;
import EirTakePtr from eir.model;
import EirZeroStruct from eir.model;
import EirAbandonConstruction from eir.model;
import EirWrapOptional from eir.model;
import EirInlineFrame from eir.model;
import EirTraceSite from eir.model;
import List from @std.collections.list;
import eir.verify;
import support;

test "a temp assigned twice is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long temp = builder.newTemp(intType);
    builder.append(new EirConstInt(temp, intType, 1));
    builder.append(new EirConstInt(temp, intType, 2));
    builder.terminate(new EirReturn(temp));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "assigned more than once");
}

test "an inline frame called from a later frame, or a site in a missing one, is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    builder.append(new EirTraceSite(3, 2));
    long zero = builder.newTemp(intType);
    builder.append(new EirConstInt(zero, intType, 0));
    builder.terminate(new EirReturn(zero));
    let built = builder.finish();
    let frames = new List<EirInlineFrame>();
    frames.push(new EirInlineFrame("helper", "main.ens", 4, 1));
    string[] violations = verify.verifyFunction(built.withInlinedBody(built.parameters(),
        built.slots(), built.blocks(), built.tempTypes(), frames));
    try assertMentions(violations, "inline frame #0 is called from frame #1, which is not an "
        + "earlier frame of the table");
    try assertMentions(violations, "an instruction was inlined from frame #2, which the "
        + "function's inline frame table does not hold");
}

test "a block without a terminator is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long temp = builder.newTemp(intType);
    builder.append(new EirConstInt(temp, intType, 1));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "has no terminator");
}

test "operand and slot type disagreements are rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long slot = builder.addSlot("x", intType, false, false);
    long wide = builder.newTemp(longType);
    builder.append(new EirConstInt(wide, longType, 1));
    builder.append(new EirStoreSlot(slot, wide));
    long narrow = builder.newTemp(intType);
    builder.append(new EirConstInt(narrow, intType, 2));
    long mixed = builder.newTemp(intType);
    builder.append(new EirBinary(mixed, intType, EirBinaryOp.Add, wide, narrow));
    builder.terminate(new EirReturn(mixed));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "store of long into $0");
    try assertMentions(violations, "combines operands of different types");
}

test "a byte read must produce a byte over a string and an integer index" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let stringType = store.stringType();
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long text = builder.newTemp(stringType);
    builder.append(new EirConstString(text, stringType, "a".toBytes()));
    long read = builder.newTemp(intType);
    builder.append(new EirStringByteAt(read, intType, text, text));
    builder.terminate(new EirReturn(read));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "str.byte %1 must produce byte");
    try assertMentions(violations, "a byte index");
}

test "a comparison must produce bool and a return must match the function type" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long left = builder.newTemp(intType);
    builder.append(new EirConstInt(left, intType, 1));
    long right = builder.newTemp(intType);
    builder.append(new EirConstInt(right, intType, 2));
    long comparison = builder.newTemp(intType);
    builder.append(new EirBinary(comparison, intType, EirBinaryOp.CmpLtSigned, left, right));
    builder.terminate(new EirReturn(comparison));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "must produce bool");
}

test "a terminator naming a missing block is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    builder.terminate(new EirJump(9));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "names missing block b9");
}

test "a temp defined on only one path may not be used after the merge" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long condition = builder.newTemp(boolType);
    builder.append(new EirConstBool(condition, boolType, true));
    long thenBlock = builder.newBlock("then");
    long elseBlock = builder.newBlock("else");
    long merge = builder.newBlock("merge");
    builder.terminate(new EirBranch(condition, thenBlock, elseBlock));
    builder.moveTo(thenBlock);
    long partial = builder.newTemp(intType);
    builder.append(new EirConstInt(partial, intType, 1));
    builder.terminate(new EirJump(merge));
    builder.moveTo(elseBlock);
    builder.terminate(new EirJump(merge));
    builder.moveTo(merge);
    builder.terminate(new EirReturn(partial));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "used before it is definitely defined");
}

test "a by-address parameter is an address and may not be stored" {
    let analysis = try support.analyzeMain(
        "struct Pair \{\n"
        + "    protected string label;\n"
        + "    protected int n;\n"
        + "\}\n"
        + "main() \{\}\n");
    let pair = try support.structNamed(analysis, "Pair");
    let intType = analysis.store().primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("p", pair, true)], intType);
    long slot = builder.addSlot("copy", pair, false, false);
    builder.append(new EirStoreSlot(slot, 0));
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "stores the address %0");
}

test "a take from a borrowing slot is rejected" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let box = try support.classNamed(analysis, "Box");
    let intType = analysis.store().primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long borrowed = builder.addSlot("b", box, false, true);
    long taken = builder.newTemp(box);
    builder.append(new EirTakeSlot(taken, box, borrowed));
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "borrows a reference this function does not own");
}

test "a release through each borrowing slot is rejected, and through an owning slot is not" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let box = try support.classNamed(analysis, "Box");
    let intType = analysis.store().primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long owned = builder.addSlot("kept", box, true, false);
    long first = builder.addSlot("lent", box, false, true);
    long second = builder.addSlot("passed", box, false, true);
    for (let slot in [owned, first, second]) {
        long address = builder.newTemp(box);
        builder.append(new EirSlotAddress(address, box, slot));
        builder.append(new EirReleasePtr(address));
    }
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try testing.assertEqual(violations.length, 2L);
    try assertMentions(violations, "release_ptr through $1 'lent', which borrows a reference");
    try assertMentions(violations, "release_ptr through $2 'passed', which borrows a reference");
}

test "a take through each borrowing slot is rejected, and through an owning slot is not" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let box = try support.classNamed(analysis, "Box");
    let intType = analysis.store().primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long owned = builder.addSlot("kept", box, true, false);
    long first = builder.addSlot("lent", box, false, true);
    long second = builder.addSlot("passed", box, false, true);
    for (let slot in [owned, first, second]) {
        long address = builder.newTemp(box);
        builder.append(new EirSlotAddress(address, box, slot));
        long taken = builder.newTemp(box);
        builder.append(new EirTakePtr(taken, box, address));
    }
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try testing.assertEqual(violations.length, 2L);
    try assertMentions(violations, "take_ptr through $1 'lent', which borrows a reference");
    try assertMentions(violations, "take_ptr through $2 'passed', which borrows a reference");
}

test "a take of storage holding no reference is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long slot = builder.addSlot("count", intType, false, false);
    long address = builder.newTemp(intType);
    builder.append(new EirSlotAddress(address, intType, slot));
    long taken = builder.newTemp(intType);
    builder.append(new EirTakePtr(taken, intType, address));
    builder.terminate(new EirReturn(taken));
    try assertMentions(verify.verifyFunction(builder.finish()),
        "take_ptr %1 reads int, which owns no reference to move");
}

test "a retain of a struct holding no reference is rejected" {
    let analysis = try support.analyzeMain(
        "struct Point \{\n"
        + "    protected long x;\n"
        + "\}\n"
        + "main() \{\}\n");
    let point = try support.structNamed(analysis, "Point");
    let builder = new EirFunctionBuilder("broken", false, null, [new EirParameter("given", point)],
        point);
    builder.append(new EirRetain(0));
    builder.terminate(new EirReturn(0));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "retain of %0, which holds Point and owns no reference");
}

test "a take of a slot holding no reference is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long slot = builder.addSlot("n", intType, false, false);
    long taken = builder.newTemp(intType);
    builder.append(new EirTakeSlot(taken, intType, slot));
    builder.terminate(new EirReturn(taken));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "owns no reference to move");
}

test "a zero that produces anything but a struct or 'void' is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long zero = builder.newTemp(intType);
    builder.append(new EirZeroStruct(zero, intType));
    builder.terminate(new EirReturn(zero));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "zero %0 must produce a struct or 'void', got int");

    let voidType = store.primitive(PrimitiveKind.Void);
    let accepted = new EirFunctionBuilder("nothing", false, null, [], voidType);
    long nothing = accepted.newTemp(voidType);
    accepted.append(new EirZeroStruct(nothing, voidType));
    accepted.terminate(new EirReturn(-1));
    try testing.assertEqual(verify.verifyFunction(accepted.finish()).length, 0L);
}

test "a tagged optional wrap must agree with the payload type" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let optionalType = store.optionalOf(intType);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long wide = builder.newTemp(longType);
    builder.append(new EirConstInt(wide, longType, 5));
    long wrapped = builder.newTemp(optionalType);
    builder.append(new EirWrapOptional(wrapped, optionalType, wide));
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "opt.wrap");
}

test "reading the tag of a non-optional value is rejected" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long plain = builder.newTemp(intType);
    builder.append(new EirConstInt(plain, intType, 5));
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, plain));
    builder.terminate(new EirReturn(plain));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "not a tagged optional");
}

test "a type parameter surviving into lowered EIR is rejected" {
    let analysis = try support.analyzeMain(
        "class Box<T> \{\n"
        + "    T inner;\n"
        + "    protected constructor(this.inner);\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let template = try support.classNamed(analysis, "Box");
    let parameter = store.typeParameter(template.declaration(), 0, "T");
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long leaked = builder.newTemp(parameter);
    builder.append(new EirConstInt(leaked, parameter, 1));
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 0));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "which no lowered function may carry");
}

test "an abandoned construction must mark a class object and name a finalizer" {
    let analysis = try support.analyzeMain(
        "struct Point \{\n"
        + "    protected long x;\n"
        + "\}\n"
        + "class Box \{\n"
        + "    protected long x;\n"
        + "\}\n"
        + "main() \{\}\n");
    let point = try support.structNamed(analysis, "Point");
    let box = try support.classNamed(analysis, "Box");
    let voidType = analysis.store().primitive(PrimitiveKind.Void);
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("point", point), new EirParameter("box", box)], voidType);
    builder.append(new EirAbandonConstruction(0, "_dtor$main$Point$fields"));
    builder.append(new EirAbandonConstruction(1, ""));
    builder.terminate(new EirReturn(-1));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "abandon.construction marks %0, which is not a class object");
    try assertMentions(violations, "abandon.construction %1 names no finalizer to store in the "
        + "object header");
}

assertMentions(string[] violations, string fragment) throws {
    for (let violation in violations) {
        if (violation.indexOf(fragment) >= 0) {
            return;
        }
    }
    string seen = "none";
    if (violations.length > 0) {
        seen = violations[0];
    }
    try testing.fail("no violation mentions '{fragment}' ({violations.length} reported; "
        + "first: {seen})");
}
