// The EIR builder and its textual dump: hand-built functions render deterministically, with
// temps, slots, block labels, typed constants, and every terminator form spelled the same way
// the golden lowering tests rely on.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import EirBinaryOp from eir.model;
import EirConstInt from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirReturn from eir.model;
import EirBranch from eir.model;
import EirJump from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import eir.dump;
import eir.verify;
import support;

test "a straight-line function dumps slots, constants, and arithmetic" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("half", true, [new EirParameter("n", intType)],
        intType);
    long slot = builder.addSlot("n", intType);
    builder.append(new EirStoreSlot(slot, 0));
    long loaded = builder.newTemp(intType);
    builder.append(new EirLoadSlot(loaded, intType, slot));
    long two = builder.newTemp(intType);
    builder.append(new EirConstInt(two, intType, 2));
    long half = builder.newTemp(intType);
    builder.append(new EirBinary(half, intType, EirBinaryOp.DivSigned, loaded, two));
    builder.terminate(new EirReturn(half));
    let function = builder.finish();

    string[] violations = verify.verifyFunction(function);
    try testing.assertTrue(violations.length == 0, "verifier rejected the function");
    try testing.assertEqual(dump.dumpFunction(function),
        "func internal @half(%0: int) -> int \{\n"
        + "  $0 n: int\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: int\n"
        + "  %2 = const 2: int\n"
        + "  %3 = div.s %1, %2: int\n"
        + "  ret %3\n"
        + "\}\n");
}

test "unsigned constants dump as bit patterns and branches name their blocks" {
    let store = try support.freshStore();
    let ulongType = store.primitive(PrimitiveKind.ULong);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("pick", false, [], ulongType);
    long condition = builder.newTemp(boolType);
    builder.append(new EirConstBool(condition, boolType, true));
    long thenBlock = builder.newBlock("then");
    long elseBlock = builder.newBlock("else");
    builder.terminate(new EirBranch(condition, thenBlock, elseBlock));
    builder.moveTo(thenBlock);
    long everything = builder.newTemp(ulongType);
    builder.append(new EirConstInt(everything, ulongType, -1));
    builder.terminate(new EirReturn(everything));
    builder.moveTo(elseBlock);
    long zero = builder.newTemp(ulongType);
    builder.append(new EirConstInt(zero, ulongType, 0));
    builder.terminate(new EirReturn(zero));
    let function = builder.finish();

    string[] violations = verify.verifyFunction(function);
    try testing.assertTrue(violations.length == 0, "verifier rejected the function");
    try testing.assertEqual(dump.dumpFunction(function),
        "func @pick() -> ulong \{\n"
        + "b0.entry:\n"
        + "  %0 = const true: bool\n"
        + "  br %0, b1.then, b2.else\n"
        + "b1.then:\n"
        + "  %1 = const 18446744073709551615: ulong\n"
        + "  ret %1\n"
        + "b2.else:\n"
        + "  %2 = const 0: ulong\n"
        + "  ret %2\n"
        + "\}\n");
}

test "switch, jump, and unreachable terminators dump their targets" {
    let store = try support.freshStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("route", false, [new EirParameter("n", intType)],
        intType);
    long caseBlock = builder.newBlock("switch.case");
    long defaultBlock = builder.newBlock("switch.default");
    long merge = builder.newBlock("switch.end");
    builder.terminate(new EirSwitch(0, [7], [caseBlock], defaultBlock));
    builder.moveTo(caseBlock);
    builder.terminate(new EirJump(merge));
    builder.moveTo(defaultBlock);
    builder.terminate(new EirUnreachable());
    builder.moveTo(merge);
    long result = builder.newTemp(intType);
    builder.append(new EirConstInt(result, intType, 1));
    builder.terminate(new EirReturn(result));
    let function = builder.finish();

    try testing.assertEqual(dump.dumpFunction(function),
        "func @route(%0: int) -> int \{\n"
        + "b0.entry:\n"
        + "  switch %0, [7 -> b1.switch.case], default b2.switch.default\n"
        + "b1.switch.case:\n"
        + "  jump b3.switch.end\n"
        + "b2.switch.default:\n"
        + "  unreachable\n"
        + "b3.switch.end:\n"
        + "  %1 = const 1: int\n"
        + "  ret %1\n"
        + "\}\n");
}
