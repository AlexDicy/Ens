// The take verifier over hand-built EIR: the shape the move rewrite may produce passes, and each
// way a take can move a reference out too early reports its own violation, in a loop too. Each bad
// function counts every reference exactly right, so the value and storage verifiers stay silent.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import EirFunction from eir.model;
import EirFunctionBuilder from eir.model;
import EirConstString from eir.model;
import EirConstBool from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirLoadSlot from eir.model;
import EirRelease from eir.model;
import EirReleasePtr from eir.model;
import EirSlotAddress from eir.model;
import EirStoreSlot from eir.model;
import EirStringConcat from eir.model;
import EirStringLength from eir.model;
import EirTakeSlot from eir.model;
import EirReturn from eir.model;
import eir.ownership;
import eir.storage;
import eir.takes;
import eir.slotuses;
import support;

// A function whose one slot owns the only reference to a fresh string, ready for a take.
final class Held {
    protected EirFunctionBuilder builder;
    protected TypeStore store;
    protected long slot;

    protected constructor(this.builder, this.store, this.slot);
}

holdingAString(string symbol, bool returnsLength) -> Held throws {
    let store = try support.freshStore();
    let stringType = store.stringType();
    Type returnType = stringType;
    if (returnsLength) {
        returnType = store.primitive(PrimitiveKind.Long);
    }
    let builder = new EirFunctionBuilder(symbol, false, null, [], returnType);
    long slot = builder.addSlot("text", stringType, true, false);
    long left = builder.newTemp(stringType);
    builder.append(new EirConstString(left, stringType, "hel".toBytes()));
    long right = builder.newTemp(stringType);
    builder.append(new EirConstString(right, stringType, "lo".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, left, right));
    builder.append(new EirStoreSlot(slot, joined));
    return new Held(builder, store, slot);
}

// The length of a string, as the last thing the function does with it.
measure(Held held, long text) -> long {
    let longType = held.store.primitive(PrimitiveKind.Long);
    long length = held.builder.newTemp(longType);
    held.builder.append(new EirStringLength(length, longType, text));
    return length;
}

test "a take whose slot nothing reads again is accepted" {
    let held = try holdingAString("moved", false);
    let builder = held.builder;
    let stringType = held.store.stringType();
    long taken = builder.newTemp(stringType);
    builder.append(new EirTakeSlot(taken, stringType, held.slot));
    long address = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(address, stringType, held.slot));
    builder.append(new EirReleasePtr(address));
    builder.terminate(new EirReturn(taken));
    try assertNoViolations(takes.verifyTakes(builder.finish()));
}

test "reading the slot after the take is reported" {
    let held = try holdingAString("readsAgain", true);
    let builder = held.builder;
    let stringType = held.store.stringType();
    long taken = builder.newTemp(stringType);
    builder.append(new EirTakeSlot(taken, stringType, held.slot));
    builder.append(new EirRelease(taken));
    long reread = builder.newTemp(stringType);
    builder.append(new EirLoadSlot(reread, stringType, held.slot));
    builder.terminate(new EirReturn(measure(held, reread)));
    let function = builder.finish();
    try assertBalanced(function);
    try assertMentions(takes.verifyTakes(function),
        "slot $0 'text' is read again after the take moved its reference out");
}

test "using a reference borrowed before the take is reported" {
    let held = try holdingAString("borrowOutlives", true);
    let builder = held.builder;
    let stringType = held.store.stringType();
    long borrowed = builder.newTemp(stringType);
    builder.append(new EirLoadSlot(borrowed, stringType, held.slot));
    long taken = builder.newTemp(stringType);
    builder.append(new EirTakeSlot(taken, stringType, held.slot));
    builder.append(new EirRelease(taken));
    builder.terminate(new EirReturn(measure(held, borrowed)));
    let function = builder.finish();
    try assertBalanced(function);
    try assertMentions(takes.verifyTakes(function),
        "borrows what slot $0 'text' held and is still used after the take");
}

// The borrow each pass around the loop reads is used before that pass's take, and the next pass
// reads a borrow of its own, so no use follows a take of the reference it borrowed.
test "a borrow read again each time around a loop is not in use after that pass's take" {
    let looped = try loopingOverASlot("looped");
    let builder = looped.builder;
    let stringType = looped.store.stringType();
    builder.append(new EirStoreSlot(looped.slot, joinedString(builder, stringType)));
    long borrowed = builder.newTemp(stringType);
    builder.append(new EirLoadSlot(borrowed, stringType, looped.slot));
    long length = measure(looped, borrowed);
    long taken = builder.newTemp(stringType);
    builder.append(new EirTakeSlot(taken, stringType, looped.slot));
    builder.append(new EirRelease(taken));
    let function = closeLoop(looped, length);
    try assertBalanced(function);
    try assertNoViolations(takes.verifyTakes(function));
}

// The read right after the take comes before the next pass writes the slot again.
test "reading the slot after the take is reported in a loop that writes the slot first" {
    let looped = try loopingOverASlot("loopReadsAgain");
    let builder = looped.builder;
    let stringType = looped.store.stringType();
    builder.append(new EirStoreSlot(looped.slot, joinedString(builder, stringType)));
    long taken = builder.newTemp(stringType);
    builder.append(new EirTakeSlot(taken, stringType, looped.slot));
    builder.append(new EirRelease(taken));
    long reread = builder.newTemp(stringType);
    builder.append(new EirLoadSlot(reread, stringType, looped.slot));
    let function = closeLoop(looped, measure(looped, reread));
    try assertBalanced(function);
    try assertMentions(takes.verifyTakes(function),
        "slot $0 'text' is read again after the take moved its reference out");
}

test "a take leaves its slot to clear only when a release of the slot can follow it" {
    let released = try holdingAString("released", false);
    long movedOut = takeOut(released);
    releaseSlot(released);
    released.builder.terminate(new EirReturn(movedOut));
    try testing.assertTrue(usedAfterTake(released.builder.finish()),
        "the release after the take is not counted");

    let last = try holdingAString("last", false);
    last.builder.terminate(new EirReturn(takeOut(last)));
    try testing.assertFalse(usedAfterTake(last.builder.finish()),
        "a take with nothing after it is counted");

    let rewritten = try holdingAString("rewritten", false);
    let stringType = rewritten.store.stringType();
    long first = takeOut(rewritten);
    rewritten.builder.append(new EirStoreSlot(rewritten.slot,
        joinedString(rewritten.builder, stringType)));
    releaseSlot(rewritten);
    rewritten.builder.terminate(new EirReturn(first));
    try testing.assertFalse(usedAfterTake(rewritten.builder.finish()),
        "a release after the slot is written again is counted");
}

test "a take in a loop leaves its slot to clear only when a path out of the loop releases it" {
    let releasedOnExit = try loopingOverASlot("releasedOnExit");
    let builder = releasedOnExit.builder;
    let stringType = releasedOnExit.store.stringType();
    builder.append(new EirStoreSlot(releasedOnExit.slot, joinedString(builder, stringType)));
    builder.append(new EirRelease(takeOut(releasedOnExit)));
    let boolType = releasedOnExit.store.primitive(PrimitiveKind.Bool);
    long again = builder.newTemp(boolType);
    builder.append(new EirConstBool(again, boolType, false));
    long body = builder.current();
    long exit = builder.newBlock("exit");
    builder.terminate(new EirBranch(again, body, exit));
    builder.moveTo(exit);
    releaseSlot(releasedOnExit);
    builder.terminate(new EirReturn(measure(releasedOnExit, joinedString(builder, stringType))));
    try testing.assertTrue(usedAfterTake(builder.finish()),
        "the release after the loop is not counted");

    let writtenEachPass = try loopingOverASlot("writtenEachPass");
    let passBuilder = writtenEachPass.builder;
    passBuilder.append(new EirStoreSlot(writtenEachPass.slot,
        joinedString(passBuilder, stringType)));
    long taken = takeOut(writtenEachPass);
    long length = measure(writtenEachPass, taken);
    passBuilder.append(new EirRelease(taken));
    try testing.assertFalse(usedAfterTake(closeLoop(writtenEachPass, length)),
        "the next pass's write is not counted as writing the slot first");
}

takeOut(Held held) -> long {
    let stringType = held.store.stringType();
    long taken = held.builder.newTemp(stringType);
    held.builder.append(new EirTakeSlot(taken, stringType, held.slot));
    return taken;
}

releaseSlot(Held held) {
    let stringType = held.store.stringType();
    long address = held.builder.newTemp(stringType);
    held.builder.append(new EirSlotAddress(address, stringType, held.slot));
    held.builder.append(new EirReleasePtr(address));
}

// Whether the function's first take is followed by a read or a release of its slot.
usedAfterTake(EirFunction function) -> bool {
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (instruction is EirTakeSlot) {
                return slotuses.readOrReleasedAfter(function, instruction.slot, b, i);
            }
        }
    }
    panic("the function has no take");
}

// A function returning a length whose slot is written inside a loop body, positioned in that body.
loopingOverASlot(string symbol) -> Held throws {
    let store = try support.freshStore();
    let stringType = store.stringType();
    let builder = new EirFunctionBuilder(symbol, false, null, [],
        store.primitive(PrimitiveKind.Long));
    long slot = builder.addSlot("text", stringType, true, false);
    long body = builder.newBlock("body");
    builder.terminate(new EirJump(body));
    builder.moveTo(body);
    return new Held(builder, store, slot);
}

// Ends the loop body with a branch back into it or out to a return of the length.
closeLoop(Held looped, long length) -> EirFunction {
    let builder = looped.builder;
    let boolType = looped.store.primitive(PrimitiveKind.Bool);
    long again = builder.newTemp(boolType);
    builder.append(new EirConstBool(again, boolType, false));
    long body = builder.current();
    long exit = builder.newBlock("exit");
    builder.terminate(new EirBranch(again, body, exit));
    builder.moveTo(exit);
    builder.terminate(new EirReturn(length));
    return builder.finish();
}

// A fresh string that owns its reference.
joinedString(EirFunctionBuilder builder, Type stringType) -> long {
    long left = builder.newTemp(stringType);
    builder.append(new EirConstString(left, stringType, "hel".toBytes()));
    long right = builder.newTemp(stringType);
    builder.append(new EirConstString(right, stringType, "lo".toBytes()));
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, left, right));
    return joined;
}

// Asserts the two ownership verifiers accept the function, so the violation the take verifier
// reports is one neither of them can detect.
assertBalanced(EirFunction function) throws {
    try assertNoViolations(ownership.verifyOwnership(function));
    try assertNoViolations(storage.verifyStorage(function));
}

assertNoViolations(string[] violations) throws {
    if (violations.length > 0) {
        try testing.fail("expected no violations, got {violations.length}: {violations[0]}");
    }
}

assertMentions(string[] violations, string fragment) throws {
    for (let violation in violations) {
        if (violation.indexOf(fragment) >= 0) {
            return;
        }
    }
    string seen = "none";
    if (violations.length > 0) {
        seen = violations[0];
    }
    try testing.fail("no violation mentions '{fragment}' ({violations.length} reported; "
        + "first: {seen})");
}
