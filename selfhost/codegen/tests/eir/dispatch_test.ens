// The structural checks the dispatch and runtime-type instructions added: each negative case
// constructs the malformed EIR directly and asserts its violation fires.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirTypeTest from eir.model;
import EirCheckedCast from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirReturn from eir.model;
import eir.verify;
import support;

test "a type test needs a class-like target and a class-like value" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let boxType = try support.classNamed(analysis, "Box");
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("n", intType)], boolType);
    long test = builder.newTemp(boolType);
    builder.append(new EirTypeTest(test, boolType, 0, intType));
    builder.terminate(new EirReturn(test));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "which is neither a class nor an interface");
    try assertMentions(violations, "which carries none");
}

test "a checked cast must produce the target made optional" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let boxType = try support.classNamed(analysis, "Box");
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("b", boxType)], boxType);
    long cast = builder.newTemp(boxType);
    builder.append(new EirCheckedCast(cast, boxType, 0, boxType));
    builder.terminate(new EirReturn(cast));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "must produce Box?");
}

test "a runtime-type comparison needs two values that carry a runtime type" {
    let analysis = try support.analyzeMain("main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("n", intType)], boolType);
    long equal = builder.newTemp(boolType);
    builder.append(new EirDynamicEquals(equal, boolType, 0, 0));
    builder.terminate(new EirReturn(equal));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "dynamic_equals %1 reads the runtime type of int");
}

test "a runtime-type hash produces a long over a value that carries a runtime type" {
    let analysis = try support.analyzeMain("main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("n", intType)], boolType);
    long hashed = builder.newTemp(boolType);
    builder.append(new EirDynamicHash(hashed, boolType, 0));
    builder.terminate(new EirReturn(hashed));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "dynamic_hash %1 must produce a long");
    try assertMentions(violations, "dynamic_hash %1 reads the runtime type of int");
}

test "a runtime-type text form produces a string over a value that carries a runtime type" {
    let analysis = try support.analyzeMain("main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder("broken", false, null,
        [new EirParameter("n", intType)], boolType);
    long text = builder.newTemp(boolType);
    builder.append(new EirDynamicToString(text, boolType, 0));
    builder.terminate(new EirReturn(text));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "dynamic_tostring %1 must produce a string");
    try assertMentions(violations, "dynamic_tostring %1 reads the runtime type of int");
}

test "a dispatched call needs a class-like receiver to read the runtime type from" {
    let analysis = try support.analyzeMain(
        "class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long result = builder.newTemp(intType);
    builder.append(new EirCall(result, intType,
        new EirCallee("target", null, [], intType), -1, [], 0, null));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "has no class-like receiver");
}

test "an interface dispatch names a slot in the interface's method table" {
    let analysis = try support.analyzeMain(
        "interface Speaker \{\n"
        + "    speak() -> int;\n"
        + "\}\n"
        + "main() \{\}\n");
    let store = analysis.store();
    let intType = store.primitive(PrimitiveKind.Int);
    let builder = new EirFunctionBuilder("broken", false, null, [], intType);
    long result = builder.newTemp(intType);
    builder.append(new EirCall(result, intType,
        new EirCallee("target", null, [], intType), -1, [], -1, intType));
    builder.terminate(new EirReturn(result));
    string[] violations = verify.verifyFunction(builder.finish());
    try assertMentions(violations, "but no slot in its method table");
}

assertMentions(string[] violations, string fragment) throws {
    for (let violation in violations) {
        if (violation.indexOf(fragment) >= 0) {
            return;
        }
    }
    string seen = "none";
    if (violations.length > 0) {
        seen = violations[0];
    }
    try testing.fail("no violation mentions '{fragment}' ({violations.length} reported; "
        + "first: {seen})");
}
