// The code-generation settings: what a '-O' level means to the EIR pipeline and to LLVM, which
// passes a build leaves out, and how a target triple names the objects a compilation writes. Every
// rule here is a pure function of the settings, so the answers for targets this machine cannot run
// are checked on it all the same.
import @std.testing;
import CodegenSettings from settings;
import OptimizationLevel from settings;
import settings;
import passes.optimize;

test "a -O level reads as itself and anything else as no level" {
    try testing.assertTrue(settings.levelFromText("0") == OptimizationLevel.None, "0 is none");
    try testing.assertTrue(settings.levelFromText("1") == OptimizationLevel.Less, "1 is less");
    try testing.assertTrue(settings.levelFromText("2") == OptimizationLevel.Default,
        "2 is the default");
    try testing.assertTrue(settings.levelFromText("3") == OptimizationLevel.Aggressive,
        "3 is aggressive");
    try testing.assertTrue(settings.levelFromText("4") == null, "4 names no level");
    try testing.assertTrue(settings.levelFromText("") == null, "empty text names no level");
    try testing.assertTrue(settings.levelFromText("O2") == null, "'O2' names no level");
}

test "every level writes back as the text it was read from" {
    try testing.assertEqual(settings.levelText(OptimizationLevel.None), "0");
    try testing.assertEqual(settings.levelText(OptimizationLevel.Less), "1");
    try testing.assertEqual(settings.levelText(OptimizationLevel.Default), "2");
    try testing.assertEqual(settings.levelText(OptimizationLevel.Aggressive), "3");
    for (let text in ["0", "1", "2", "3"]) {
        let level = settings.levelFromText(text);
        if (level == null) {
            try testing.fail("'{text}' should name a level");
            return;
        }
        try testing.assertEqual(settings.levelText(level), text);
    }
}

test "only level none turns the EIR pipeline off" {
    try testing.assertFalse(at(OptimizationLevel.None).optimizesEir(), "none optimizes nothing");
    try testing.assertTrue(at(OptimizationLevel.Less).optimizesEir(), "less optimizes");
    try testing.assertTrue(at(OptimizationLevel.Default).optimizesEir(), "the default optimizes");
    try testing.assertTrue(at(OptimizationLevel.Aggressive).optimizesEir(),
        "aggressive optimizes");
}

test "the level travels on to LLVM as its own code-generation level" {
    try testing.assertEqual(at(OptimizationLevel.None).llvmOptimizationLevel(), 0);
    try testing.assertEqual(at(OptimizationLevel.Less).llvmOptimizationLevel(), 1);
    try testing.assertEqual(at(OptimizationLevel.Default).llvmOptimizationLevel(), 2);
    try testing.assertEqual(at(OptimizationLevel.Aggressive).llvmOptimizationLevel(), 3);
}

test "the object extension follows the target's object format" {
    try testing.assertEqual(forTriple("x86_64-pc-windows-msvc").objectExtension(), ".obj");
    try testing.assertEqual(forTriple("aarch64-pc-windows-msvc").objectExtension(), ".obj");
    try testing.assertEqual(forTriple("x86_64-unknown-linux-gnu").objectExtension(), ".o");
    try testing.assertEqual(forTriple("aarch64-unknown-linux-gnu").objectExtension(), ".o");
    try testing.assertEqual(forTriple("arm64-apple-macosx14.0").objectExtension(), ".o");
    try testing.assertEqual(forTriple("x86_64-apple-darwin23").objectExtension(), ".o");
}

test "every pass runs unless the build names it" {
    let all = at(OptimizationLevel.Default);
    for (let name in optimize.passNames()) {
        try testing.assertTrue(all.runsPass(name), "'{name}' must run by default");
    }
    let without = new CodegenSettings(OptimizationLevel.Default, "x86_64-pc-windows-msvc",
        ["stack-promotion", "cleanup-pruning"], false, false);
    try testing.assertFalse(without.runsPass("stack-promotion"), "stack promotion is off");
    try testing.assertFalse(without.runsPass("cleanup-pruning"), "cleanup pruning is off");
    try testing.assertTrue(without.runsPass("devirtualization"), "devirtualization still runs");
    try testing.assertEqual(without.disabledPasses().length, 2);
}

test "the pipeline names the passes a build may leave out, in the order they run" {
    string[] expected = ["borrow-rewriting", "by-address-parameters", "stack-promotion",
        "devirtualization", "cleanup-pruning"];
    string[] named = optimize.passNames();
    try testing.assertEqual(named.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(named[i], expected[i]);
    }
}

test "an ordinary build verifies once, explains nothing, and runs no IR pipeline" {
    let ordinary = at(OptimizationLevel.Default);
    try testing.assertFalse(ordinary.verifiesAfterEachPass(), "verification is once at the end");
    try testing.assertFalse(ordinary.explainsArc(), "nothing is explained unless asked");
    try testing.assertFalse(ordinary.runsIrPassPipeline(), "LLVM's IR pipeline stays off");
}

at(OptimizationLevel level) -> CodegenSettings {
    return new CodegenSettings(level, "x86_64-pc-windows-msvc");
}

forTriple(string triple) -> CodegenSettings {
    return new CodegenSettings(OptimizationLevel.Default, triple);
}
