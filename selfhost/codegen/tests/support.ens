// Shared helpers for the codegen tests: an in-memory file tree standing in for the file system,
// single-file program analysis through the real sema pipeline, lowering straight to the textual
// EIR dump the golden tests compare, and a one-function LLVM module the emission tests build into.
import @std.testing;
import TestFailure from @std.testing;
import Map from @std.collections.map;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;
import FileDiagnostic from @ens.sema.support.diagnostics;
import @ens.sema.program.graph;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.sema.pipeline;
import TypeStore from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import @ens.sema.model.types;
import Context from @ens.llvm.core;
import Module from @ens.llvm.core;
import Builder from @ens.llvm.core;
import @ens.llvm.core;
import @ens.llvm.instructions;
import @ens.llvm.analysis;
import EirFunction from eir.model;
import eir.dump;
import eir.verify;
import eir.ownership;
import eir.storage;
import eir.takes;
import DescriptorPlans from layout.descriptors;
import layout.descriptors;
import layout.vtables;
import mono.closure;
import CodegenSettings from settings;
import OptimizationLevel from settings;
import PassContext from passes.optimize;
import PassOutcome from passes.optimize;
import passes.optimize;
import List from @std.collections.list;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import lower.destructors;
import lower.index;
import lower.lower;
import FunctionLowering from lower.lower;
import @ens.llvm.target;
import Runtime from emit.runtime;
import TypeMapper from emit.types;
import Finalizers from emit.finalizers;

public class MemoryFileLoader implements FileLoader {
    Map<string, string> files;

    public constructor() {
        this.files = new Map<string, string>();
        this.addStandardLibrary();
    }

    // Every graph loads the implicitly imported modules, so the fake tree carries a stand-in
    // standard library at the root the helpers below pass. Its core module mirrors the real one,
    // because code generation now emits those two classes into every program.
    addStandardLibrary() {
        this.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
        this.add("/stdlib/std/src/core.ens", "export class StackFrame \{\n"
            + "    export string function;\n"
            + "    export string file;\n"
            + "    export int line;\n"
            + "    export constructor(this.function, this.file, this.line);\n"
            + "\}\n"
            + "export class Error \{\n"
            + "    export string message;\n"
            + "    long[]? frames;\n"
            + "    export constructor(this.message);\n"
            + "    export stackTrace() -> string \{\n"
            + "        return \"\";\n"
            + "    \}\n"
            + "    export stackFrames() -> StackFrame[] \{\n"
            + "        return [new StackFrame(\"\", \"\", 0)];\n"
            + "    \}\n"
            + "\}\n");
    }

    public add(string path, string text) {
        this.files.set(path, text);
    }

    override exists(string path) -> bool {
        return this.files.contains(path);
    }

    override readText(string path) -> string throws FileError {
        let text = this.files.get(path);
        if (text == null) {
            throw new FileError("Could not read '{path}'.");
        }
        return text;
    }
}

// Analyzes a single-file program and asserts the whole pipeline accepted it.
public analyzeMain(string text) -> ProgramAnalysis throws {
    let loader = new MemoryFileLoader();
    loader.add("/src/main.ens", text);
    return try analyzeLoaded(loader);
}

// Analyzes the program rooted at '/src/main.ens' in a loaded file tree, so a test can spread it
// over several modules, and asserts the whole pipeline accepted it.
public analyzeLoaded(MemoryFileLoader loader) -> ProgramAnalysis throws {
    let result = graph.buildFileProgram(loader, "/src", "", "/stdlib", "main.ens");
    try assertNone("graph", result.diagnostics());
    for (let loaded in result.modules()) {
        if (loaded.parseResult().diagnostics().length > 0) {
            try testing.fail("parse failed: "
                + loaded.parseResult().diagnostics()[0].message());
        }
    }
    let analysis = pipeline.analyzeProgram(result);
    try assertNone("declare", analysis.declareDiagnostics());
    try assertNone("link", analysis.linkDiagnostics());
    try assertNone("signatures", analysis.signatureDiagnostics());
    try assertNone("layout", analysis.layoutDiagnostics());
    try assertNone("checks", analysis.checkDiagnostics());
    try assertNone("bodies", analysis.bodyDiagnostics());
    try assertNone("exceptions", analysis.exceptionDiagnostics());
    return analysis;
}

assertNone(string stage, FileDiagnostic[] diagnostics) throws {
    if (diagnostics.length > 0) {
        try testing.fail("{stage} reported {diagnostics.length} diagnostic(s); first: "
            + diagnostics[0].message());
    }
}

// A type store for hand-built EIR: the one behind an empty analyzed program.
public freshStore() -> TypeStore throws {
    let analysis = try analyzeMain("main() \{\}");
    return analysis.store();
}

// The full stage-A index: the concrete declarations plus everything the monomorphization
// closure planned, registered the way the driver registers it.
public indexProgram(ProgramAnalysis analysis) -> ProgramIndex throws {
    let programIndex = index.buildIndex(analysis);
    let plan = closure.close(analysis, programIndex);
    if (plan.problems().length() > 0) {
        try testing.fail("the closure reported: " + plan.problems().get(0).message());
    }
    closure.apply(plan, programIndex);
    index.indexLambdas(programIndex, analysis.store());
    return programIndex;
}

// The struct type a test program declares, searched across its modules so a test does not have to
// spell the module's canonical path.
public structNamed(ProgramAnalysis analysis, string name) -> StructType throws {
    let contexts = analysis.contexts();
    for (long i = 0; i < contexts.length(); i++) {
        let found = analysis.store().findDeclared(contexts.get(i).module().canonicalPath(), name);
        if (found is StructType) {
            return found;
        }
    }
    throw new TestFailure("no struct named '{name}'");
}

// The class type a test program declares, searched across its modules the way structNamed is.
public classNamed(ProgramAnalysis analysis, string name) -> ClassType throws {
    let contexts = analysis.contexts();
    for (long i = 0; i < contexts.length(); i++) {
        let found = analysis.store().findDeclared(contexts.get(i).module().canonicalPath(), name);
        if (found is ClassType) {
            return found;
        }
    }
    throw new TestFailure("no class named '{name}'");
}

// Synthesizes one class's destructor, asserts every verifier is satisfied, and returns its dump.
public destructorDump(string programText, string className) -> string throws {
    let analysis = try analyzeMain(programText);
    let programIndex = try indexProgram(analysis);
    let classType = try classNamed(analysis, className);
    let synthesized = destructors.synthesize(classType, programIndex, analysis.store());
    if (synthesized == null) {
        throw new TestFailure("'{className}' has no destructor to synthesize");
    }
    try assertVerified(synthesized, className);
    return dump.dumpFunction(synthesized);
}

// Synthesizes the destructor of one lambda's closure object, asserts every verifier is
// satisfied, and returns its dump. The symbol is the lambda's own, not the destructor's.
public closureDestructorDump(string programText, string symbol) -> string throws {
    let analysis = try analyzeMain(programText);
    let synthesized = try closureDestructor(analysis, symbol);
    if (synthesized == null) {
        throw new TestFailure("'{symbol}' has no closure destructor to synthesize");
    }
    try assertVerified(synthesized, symbol);
    return dump.dumpFunction(synthesized);
}

// True when the lambda's closure object carries a destructor, which it does exactly when one of
// its captures holds a reference.
public hasClosureDestructor(ProgramAnalysis analysis, string symbol) -> bool throws {
    return try closureDestructor(analysis, symbol) != null;
}

closureDestructor(ProgramAnalysis analysis, string symbol) -> EirFunction? throws {
    let programIndex = try indexProgram(analysis);
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        for (long i = 0; i < moduleFunctions.functions().length(); i++) {
            let info = moduleFunctions.functions().get(i);
            if (info.symbol() == symbol) {
                return destructors.synthesizeClosure(info, analysis.store());
            }
        }
    }
    throw new TestFailure("no lambda with symbol '{symbol}'");
}

public functionNamed(ProgramAnalysis analysis, ProgramIndex index, string name)
        -> FunctionInfo throws {
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        for (long i = 0; i < moduleFunctions.functions().length(); i++) {
            let info = moduleFunctions.functions().get(i);
            if (info.signature().name() == name) {
                return info;
            }
        }
    }
    throw new TestFailure("no lowerable function named '{name}'");
}

// Lowers one method of a named record, so a test can reach a constructor without colliding with the
// constructors the standard library declares under the same name.
public loweredMethodDump(string programText, string recordName, string methodName)
        -> string throws {
    let analysis = try analyzeMain(programText);
    let programIndex = try indexProgram(analysis);
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        for (long i = 0; i < moduleFunctions.functions().length(); i++) {
            let info = moduleFunctions.functions().get(i);
            let receiver = info.receiverType();
            if (info.signature().name() != methodName || receiver == null
                    || types.display(receiver) != recordName) {
                continue;
            }
            let outcome = lower.lowerFunction(info, programIndex,
                vtables.assignSlots(programIndex), analysis.store());
            let function = outcome.function();
            if (function == null) {
                string reason = "no diagnostics";
                if (outcome.diagnostics().length > 0) {
                    reason = outcome.diagnostics()[0].message();
                }
                throw new TestFailure("lowering '{recordName}.{methodName}' failed: {reason}");
            }
            try assertVerified(function, "{recordName}.{methodName}");
            return dump.dumpFunction(function);
        }
    }
    throw new TestFailure("no lowerable method '{recordName}.{methodName}'");
}

// Lowers one function of an accepted program, asserts the structural verifier is satisfied,
// and returns its textual dump.
public loweredDump(string programText, string functionName) -> string throws {
    let analysis = try analyzeMain(programText);
    return try loweredLoadedDump(analysis, functionName);
}

// The same over an already analyzed program, for tests that load several modules.
public loweredLoadedDump(ProgramAnalysis analysis, string functionName) -> string throws {
    let programIndex = try indexProgram(analysis);
    let info = try functionNamed(analysis, programIndex, functionName);
    let outcome = lower.lowerFunction(info, programIndex, vtables.assignSlots(programIndex),
        analysis.store());
    let function = outcome.function();
    if (function == null) {
        string reason = "no diagnostics";
        if (outcome.diagnostics().length > 0) {
            reason = outcome.diagnostics()[0].message();
        }
        throw new TestFailure("lowering '{functionName}' failed: {reason}");
    }
    try assertVerified(function, functionName);
    return dump.dumpFunction(function);
}

// Lowers the function with the given linker symbol - the way a generic instance is named - and
// returns its dump after all three verifiers accept it.
public loweredSymbolDump(string programText, string symbol) -> string throws {
    let analysis = try analyzeMain(programText);
    return try loweredLoadedSymbolDump(analysis, symbol);
}

// The same over an already analyzed program.
public loweredLoadedSymbolDump(ProgramAnalysis analysis, string symbol) -> string throws {
    return dump.dumpFunction(try loweredBySymbol(analysis, symbol));
}

// The lowered function itself, verified, for tests that assert on its own facts - the trace
// name a stack frame prints, the throws marker - beside or instead of its dump.
public loweredBySymbol(ProgramAnalysis analysis, string symbol) -> EirFunction throws {
    let programIndex = try indexProgram(analysis);
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        for (long i = 0; i < moduleFunctions.functions().length(); i++) {
            let info = moduleFunctions.functions().get(i);
            if (info.symbol() != symbol) {
                continue;
            }
            let outcome = lower.lowerFunction(info, programIndex,
                vtables.assignSlots(programIndex), analysis.store());
            let function = outcome.function();
            if (function == null) {
                string reason = "no diagnostics";
                if (outcome.diagnostics().length > 0) {
                    reason = outcome.diagnostics()[0].message();
                }
                throw new TestFailure("lowering '{symbol}' failed: {reason}");
            }
            try assertVerified(function, symbol);
            return function;
        }
    }
    throw new TestFailure("no lowerable function with symbol '{symbol}'");
}

// Asserts every verifier accepts a lowered function, showing the dump when one does not.
assertVerified(EirFunction function, string described) throws {
    string[] violations = verify.verifyFunction(function);
    if (violations.length > 0) {
        throw new TestFailure("the verifier rejected '{described}': {violations[0]}\n"
            + dump.dumpFunction(function));
    }
    string[] unbalanced = ownership.verifyOwnership(function);
    if (unbalanced.length > 0) {
        throw new TestFailure("ownership does not balance in '{described}': "
            + "{unbalanced[0]}\n" + dump.dumpFunction(function));
    }
    string[] unbalancedStorage = storage.verifyStorage(function);
    if (unbalancedStorage.length > 0) {
        throw new TestFailure("storage ownership does not balance in '{described}': "
            + "{unbalancedStorage[0]}\n" + dump.dumpFunction(function));
    }
    string[] earlyTakes = takes.verifyTakes(function);
    if (earlyTakes.length > 0) {
        throw new TestFailure("a slot's reference moves out too early in '{described}': "
            + "{earlyTakes[0]}\n" + dump.dumpFunction(function));
    }
}

// The whole program lowered the way the driver lowers it: every function and synthesized
// destructor of every module, each verified, beside the descriptor plans the passes consume.
public class LoweredProgram {
    public ProgramAnalysis analysis;
    public List<EirFunction> functions;
    public DescriptorPlans plans;

    public constructor(this.analysis, this.functions, this.plans);
}

public lowerWholeProgram(string programText) -> LoweredProgram throws {
    return try lowerLoadedProgram(try analyzeMain(programText));
}

public lowerLoadedProgram(ProgramAnalysis analysis) -> LoweredProgram throws {
    let programIndex = try indexProgram(analysis);
    let tables = vtables.assignSlots(programIndex);
    let plans = descriptors.planProgram(programIndex, tables);
    let functions = new List<EirFunction>();
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        for (long i = 0; i < moduleFunctions.functions().length(); i++) {
            let info = moduleFunctions.functions().get(i);
            let outcome = lower.lowerFunction(info, programIndex, tables, analysis.store());
            let function = outcome.function();
            if (function == null) {
                string reason = "no diagnostics";
                if (outcome.diagnostics().length > 0) {
                    reason = outcome.diagnostics()[0].message();
                }
                throw new TestFailure("lowering '{info.symbol()}' failed: {reason}");
            }
            try assertVerified(function, info.symbol());
            functions.push(function);
        }
        for (long c = 0; c < moduleFunctions.classes().length(); c++) {
            let finalizer = destructors.synthesize(moduleFunctions.classes().get(c),
                programIndex, analysis.store());
            if (finalizer != null) {
                try assertVerified(finalizer, finalizer.symbol());
                functions.push(finalizer);
            }
        }
        for (long c = 0; c < moduleFunctions.instantiations().length(); c++) {
            let instantiation = moduleFunctions.instantiations().get(c);
            bool classInstance = instantiation is ClassType
                || (instantiation is InstantiationType && instantiation.template() is ClassType);
            if (!classInstance) {
                continue;
            }
            let finalizer = destructors.synthesize(instantiation, programIndex,
                analysis.store());
            if (finalizer != null) {
                try assertVerified(finalizer, finalizer.symbol());
                functions.push(finalizer);
            }
        }
    }
    return new LoweredProgram(analysis, functions, plans);
}

// The code-generation settings every test compiles with: this machine's target, the default
// optimization level, and verification after every single pass, so a pass that breaks an
// invariant is named by the pass rather than found at emission.
public testSettings() -> CodegenSettings {
    string[] everyPass = [];
    return new CodegenSettings(OptimizationLevel.Default, target.hostTargetTriple(), everyPass,
        true, false);
}

// The same settings at a chosen level, with the named passes left out and the account of what the
// pipeline elided gathered when asked for.
public settingsAt(OptimizationLevel level, string[] disabledPasses,
                  bool explainArc) -> CodegenSettings {
    return new CodegenSettings(level, target.hostTargetTriple(), disabledPasses, true,
        explainArc);
}

// The pass context the pipeline computes over a lowered program.
public passContext(LoweredProgram program) -> PassContext {
    return optimize.planProgram(program.functions, program.plans);
}

public functionBySymbol(LoweredProgram program, string symbol) -> EirFunction throws {
    for (long i = 0; i < program.functions.length(); i++) {
        if (program.functions.get(i).symbol() == symbol) {
            return program.functions.get(i);
        }
    }
    throw new TestFailure("no lowered function with symbol '{symbol}'");
}

// Runs one function through the whole pipeline with verification between every pass, and
// returns the optimized dump.
public optimizedDump(LoweredProgram program, string symbol) -> string throws {
    let outcome = try pipelineOutcome(program, symbol, testSettings());
    return dump.dumpFunction(outcome.function());
}

// Runs one function through the pipeline under the given settings, failing the test when one of
// its passes broke an invariant.
public pipelineOutcome(LoweredProgram program, string symbol,
                       CodegenSettings settings) -> PassOutcome throws {
    let outcome = optimize.runFunction(try functionBySymbol(program, symbol),
        passContext(program), settings);
    if (outcome.problems().length > 0) {
        throw new TestFailure("the pipeline broke '{symbol}': {outcome.problems()[0]}\n"
            + dump.dumpFunction(outcome.function()));
    }
    return outcome;
}

// Asserts every verifier accepts a pass's output, the way the pipeline does between passes.
public assertOptimized(EirFunction function, string described) throws {
    try assertVerified(function, described);
}

// A construct every sema phase accepts and lowering does not support yet: slicing an array whose
// elements hold a reference inside a struct. The declaration and the statements are separate so a
// test can place them in whichever module it wants to fail.
public unlowerableDeclaration() -> string {
    return "struct Tagged \{\n"
        + "    protected string label = \"x\";\n"
        + "\}\n";
}

public unlowerableStatements() -> string {
    return "    Tagged[] items = new Tagged[2];\n"
        + "    let part = items.slice(0, 1);\n";
}

public unlowerableProgram() -> string {
    return unlowerableDeclaration()
        + "main() -> int \{\n"
        + unlowerableStatements()
        + "    return 0;\n"
        + "\}\n";
}

// Lowers one function expecting failure, and returns the first diagnostic's message.
public loweringFailure(string programText, string functionName) -> string throws {
    let analysis = try analyzeMain(programText);
    let programIndex = try indexProgram(analysis);
    let info = try functionNamed(analysis, programIndex, functionName);
    let outcome = lower.lowerFunction(info, programIndex, vtables.assignSlots(programIndex),
        analysis.store());
    if (outcome.function() != null) {
        throw new TestFailure("lowering '{functionName}' unexpectedly succeeded");
    }
    if (outcome.diagnostics().length == 0) {
        throw new TestFailure("lowering '{functionName}' failed without a diagnostic");
    }
    return outcome.diagnostics()[0].message();
}

// A module with one host function the builder sits inside, so every primitive and every finalizer
// is emitted the way emission emits it: from within a function whose insertion point has to be
// restored afterwards.
public class EmissionHost {
    public Context context;
    public Module module;
    public Builder builder;
    public Runtime runtime;
    public TypeMapper mapper;
    public Finalizers finalizers;

    public constructor(string name) {
        this.context = core.createContext();
        this.module = this.context.createModule(name);
        this.builder = this.context.createBuilder();
        let host = this.module.addFunction("host", this.context.voidType().functionType([]));
        this.builder.positionAtEnd(this.context.appendBasicBlock(host, "entry"));
        this.runtime = new Runtime(this.context, this.module, this.builder,
            target.hostTargetTriple());
        this.mapper = new TypeMapper(this.context);
        this.finalizers = new Finalizers(this.runtime, this.mapper);
    }

    // The module's IR, for a test that asserts on the shape of what was emitted.
    public text() -> string {
        return analysis.moduleText(this.module);
    }

    // Ends the host function and asserts the module verifies, reporting LLVM's own message.
    public finish() throws {
        instructions.buildRetVoid(this.builder);
        string problem = analysis.verify(this.module);
        this.builder.dispose();
        this.context.dispose();
        try testing.assertTrue(problem.length == 0, "verification failed: {problem}");
    }
}
