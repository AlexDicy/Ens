// Golden tests for the destructor every class carries. What it releases and in what order is the
// whole of an object's cleanup, so these dumps are where a forgotten field or a strong release of a
// weak one shows up.
import @std.testing;
import TestFailure from @std.testing;
import support;

test "a class whose fields hold nothing still gets a destructor, which does nothing" {
    let dumped = try support.destructorDump(
        "class Empty \{\n"
        + "    protected int value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Empty().value;\n"
        + "\}\n", "Empty");
    try testing.assertEqual(dumped,
        "func @_dtor$main$Empty(%0: Empty) -> void \{\n"
        + "b0.entry:\n"
        + "  ret\n"
        + "\}\n");
}

test "every owning field is released, and a weak one only stops watching" {
    let dumped = try support.destructorDump(
        "class Node \{\n"
        + "    protected int v;\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected string label;\n"
        + "    protected Node owned;\n"
        + "    protected weak Node? watched;\n"
        + "    protected int count;\n"
        + "    protected constructor(this.label, this.owned);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Holder(\"a\", new Node()).count;\n"
        + "\}\n", "Holder");
    try testing.assertEqual(dumped,
        "func @_dtor$main$Holder(%0: Holder) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 0: &string  ; %0.label\n"
        + "  release_ptr %1\n"
        + "  %2 = object_field_addr %0, 1: &Node  ; %0.owned\n"
        + "  release_ptr %2\n"
        + "  %3 = object_field_addr %0, 2: &Node?  ; %0.watched\n"
        + "  weak.release %3\n"
        + "  ret\n"
        + "\}\n");
}

test "a declared destructor runs before any field is released" {
    let dumped = try support.destructorDump(
        "class Noisy \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "    destructor() \{\n"
        + "        print(this.label);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let n = new Noisy(\"bye\");\n"
        + "    return 0;\n"
        + "\}\n", "Noisy");
    try testing.assertEqual(dumped,
        "func @_dtor$main$Noisy(%0: Noisy) -> void \{\n"
        + "b0.entry:\n"
        + "  call @main$Noisy$destructor(this %0)\n"
        + "  %1 = object_field_addr %0, 0: &string  ; %0.label\n"
        + "  release_ptr %1\n"
        + "  ret\n"
        + "\}\n");
}

test "a struct field is walked into for the references it holds" {
    let dumped = try support.destructorDump(
        "struct Pair \{\n"
        + "    string left;\n"
        + "    int middle;\n"
        + "    string right;\n"
        + "\}\n"
        + "class Owner \{\n"
        + "    protected Pair pair;\n"
        + "    protected constructor(this.pair);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let o = new Owner(\{left: \"a\", middle: 1, right: \"b\"\});\n"
        + "    return 0;\n"
        + "\}\n", "Owner");
    try testing.assertEqual(dumped,
        "func @_dtor$main$Owner(%0: Owner) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 0: &Pair  ; %0.pair\n"
        + "  %2 = field_addr %1, 0: &string  ; %0.pair.left\n"
        + "  release_ptr %2\n"
        + "  %3 = field_addr %1, 2: &string  ; %0.pair.right\n"
        + "  release_ptr %3\n"
        + "  ret\n"
        + "\}\n");
}

// The standard library's Error is an ordinary class living in a real module, so code generation
// emits its destructor into every program; only its two trace accessors are intercepted.
test "the standard library's Error gets its fields released like any other class" {
    let dumped = try support.destructorDump("main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "Error");
    try testing.assertEqual(dumped,
        "func @_dtor$std.core$Error(%0: Error) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 0: &string  ; %0.message\n"
        + "  release_ptr %1\n"
        + "  %2 = object_field_addr %0, 1: &long[]?  ; %0.frames\n"
        + "  release_ptr %2\n"
        + "  ret\n"
        + "\}\n");
}

// Error's trace accessors are intercepted at their call sites, so their placeholder bodies are
// never indexed for lowering; a call reads the captured trace instead (see the exceptions
// lowering tests).
expectStackTraceNotLowerable() throws {
    let dumped = try support.loweredMethodDump("main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "Error", "stackTrace");
    try testing.fail("the placeholder body was lowered anyway:\n" + dumped);
} catch (TestFailure failure) {
    if (failure.message.indexOf("no lowerable method 'Error.stackTrace'") < 0) {
        rethrow;
    }
}

test "Error's stack-trace methods are intercepted, so no placeholder body is ever lowered" {
    try expectStackTraceNotLowerable();
}
