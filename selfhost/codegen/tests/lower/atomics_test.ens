// Golden facts for the Atomic<T> intercept: its members lower to atomic instructions over the one
// field, never to calls of the bodies the class spells.
import @std.testing;
import support;
import MemoryFileLoader from support;

atomicLoader(string mainSource) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/tasks.ens", "export interface Counted<T> \{\n"
        + "    incremented() -> T;\n"
        + "\}\n"
        + "export shared final class Atomic<shared T> \{\n"
        + "    T value;\n"
        + "    export constructor(this.value);\n"
        + "    export read() -> T \{\n"
        + "        return this.value;\n"
        + "    \}\n"
        + "    export write(T value) \{\n"
        + "        this.value = value;\n"
        + "    \}\n"
        + "    export compareAndSet(T expected, T replacement) -> bool \{\n"
        + "        return false;\n"
        + "    \}\n"
        + "    export increment<T: Counted<T>>() -> T \{\n"
        + "        return this.value.incremented();\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/src/main.ens", mainSource);
    return loader;
}

test "an Atomic's members lower to atomic instructions over its field" {
    let loader = atomicLoader("import Atomic from @std.tasks;\n"
        + "main() -> int \{\n"
        + "    let count = new Atomic<int>(0);\n"
        + "    let name = new Atomic<string>(\"a\");\n"
        + "    name.write(\"b\");\n"
        + "    bool swapped = count.compareAndSet(0, 1);\n"
        + "    return count.read() + name.read().length as int;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(dumped.indexOf("atomic.store %") > 0, "'write' stores: {dumped}");
    try testing.assertTrue(dumped.indexOf("= atomic.cas %") > 0, "'compareAndSet' swaps: {dumped}");
    try testing.assertTrue(dumped.indexOf("= atomic.load %") > 0, "'read' loads: {dumped}");
    for (let member in ["read", "write", "compareAndSet"]) {
        try testing.assertTrue(dumped.indexOf("___{member}(") < 0,
            "the body of '{member}' is not called: {dumped}");
    }
}
