// Golden lowering tests for runtime type tests: the 'is' chain a condition builds, the retained
// result and released source of 'as?', and the test chain a type switch runs its arms through.
import @std.testing;
import support;

test "an is chain tests each target in turn and narrows the branch" {
    let dumped = try support.loweredDump(
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius;\n"
        + "    protected constructor(this.radius = 5);\n"
        + "\}\n"
        + "class Dot extends Circle \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Dot();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Shape s = pick();\n"
        + "    if (s is Circle && s is Dot) \{\n"
        + "        return s.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 s: Shape zeroed\n"
        + "  $1 logical: bool\n"
        + "b0.entry:\n"
        + "  %0 = call @main$pick(): Shape\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Shape\n"
        + "  %2 = type_test %1 is Circle: bool\n"
        + "  store $1, %2\n"
        + "  br %2, b1.and.rhs, b2.and.end\n"
        + "b1.and.rhs:\n"
        + "  %3 = load $0: Shape\n"
        + "  %4 = type_test %3 is Dot: bool\n"
        + "  store $1, %4\n"
        + "  jump b2.and.end\n"
        + "b2.and.end:\n"
        + "  %5 = load $1: bool\n"
        + "  br %5, b3.if.then, b4.if.end\n"
        + "b3.if.then:\n"
        + "  %6 = load $0: Shape\n"
        + "  %7 = reinterpret %6: Dot\n"
        + "  %8 = object_field_addr %7, 0: &int  ; %7.radius\n"
        + "  %9 = load_ptr %8: int\n"
        + "  %10 = slot_addr $0: &Shape  ; s\n"
        + "  release_ptr %10\n"
        + "  ret %9\n"
        + "b4.if.end:\n"
        + "  %11 = const 0: int\n"
        + "  %12 = slot_addr $0: &Shape  ; s\n"
        + "  release_ptr %12\n"
        + "  ret %11\n"
        + "\}\n");
}

test "a checked cast retains what it hands back and releases an owned source once" {
    let dumped = try support.loweredDump(
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Circle();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let c = pick() as? Circle;\n"
        + "    if (c == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 c: Circle? zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @main$pick(): Shape\n"
        + "  %1 = checked_cast %0 as? Circle: Circle?\n"
        + "  retain %1\n"
        + "  release %0\n"
        + "  store $0, %1\n"
        + "  %2 = load $0: Circle?\n"
        + "  %3 = const null: null\n"
        + "  %4 = reinterpret %3: Circle?\n"
        + "  %5 = cmp.eq %2, %4: bool\n"
        + "  br %5, b1.if.then, b2.if.end\n"
        + "b1.if.then:\n"
        + "  %6 = const 1: int\n"
        + "  %7 = slot_addr $0: &Circle?  ; c\n"
        + "  release_ptr %7\n"
        + "  ret %6\n"
        + "b2.if.end:\n"
        + "  %8 = const 0: int\n"
        + "  %9 = slot_addr $0: &Circle?  ; c\n"
        + "  release_ptr %9\n"
        + "  ret %8\n"
        + "\}\n");
}

test "a sealed exhaustive type switch chains its tests and ends unreachable" {
    let dumped = try support.loweredDump(
        "sealed abstract class Expr \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Num extends Expr \{\n"
        + "    protected int value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "class Neg extends Expr \{\n"
        + "    protected Expr inner;\n"
        + "    protected constructor(this.inner);\n"
        + "\}\n"
        + "eval(Expr e) -> int \{\n"
        + "    return switch (e) \{\n"
        + "        is Num n -> n.value,\n"
        + "        is Neg n -> 0 - eval(n.inner),\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return eval(new Num(4));\n"
        + "\}\n", "eval");
    try testing.assertEqual(dumped,
        "func internal @main$eval(%0: Expr) -> int \{\n"
        + "  $0 e: Expr borrowed\n"
        + "  $1 typeswitch: int\n"
        + "  $2 n: Num borrowed\n"
        + "  $3 n: Neg borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Expr\n"
        + "  %2 = type_test %1 is Num: bool\n"
        + "  br %2, b1.typeswitch.arm, b4.typeswitch.next\n"
        + "b1.typeswitch.arm:\n"
        + "  %4 = reinterpret %1: Num\n"
        + "  store $2, %4\n"
        + "  %5 = load $2: Num\n"
        + "  %6 = object_field_addr %5, 0: &int  ; %5.value\n"
        + "  %7 = load_ptr %6: int\n"
        + "  store $1, %7\n"
        + "  jump b6.typeswitch.end\n"
        + "b2.typeswitch.arm:\n"
        + "  %8 = reinterpret %1: Neg\n"
        + "  store $3, %8\n"
        + "  %9 = const 0: int\n"
        + "  %10 = load $3: Neg\n"
        + "  %11 = object_field_addr %10, 0: &Expr  ; %10.inner\n"
        + "  %12 = load_ptr %11: Expr\n"
        + "  %13 = call @main$eval(%12): int\n"
        + "  %14 = sub %9, %13: int\n"
        + "  store $1, %14\n"
        + "  jump b6.typeswitch.end\n"
        + "b3.typeswitch.unreachable:\n"
        + "  unreachable\n"
        + "b4.typeswitch.next:\n"
        + "  %3 = type_test %1 is Neg: bool\n"
        + "  br %3, b2.typeswitch.arm, b5.typeswitch.next\n"
        + "b5.typeswitch.next:\n"
        + "  jump b3.typeswitch.unreachable\n"
        + "b6.typeswitch.end:\n"
        + "  %15 = load $1: int\n"
        + "  ret %15\n"
        + "\}\n");
}

test "an interface call dispatches through the interface's method table" {
    let dumped = try support.loweredDump(
        "interface Speaker \{\n"
        + "    speak() -> int;\n"
        + "\}\n"
        + "class Dog implements Speaker \{\n"
        + "    protected constructor();\n"
        + "    override speak() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "hear(Speaker s) -> int \{\n"
        + "    return s.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return hear(new Dog());\n"
        + "\}\n", "hear");
    try testing.assertEqual(dumped,
        "func internal @main$hear(%0: Speaker) -> int \{\n"
        + "  $0 s: Speaker borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Speaker\n"
        + "  %2 = call @main$Speaker$speak(this %1) itable[Speaker, 0]: int\n"
        + "  ret %2\n"
        + "\}\n");
}
