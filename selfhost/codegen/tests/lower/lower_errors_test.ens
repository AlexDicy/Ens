// Constructs outside the supported surface fail lowering with a diagnostic instead of emitting
// wrong code; the message names what is missing.
import @std.testing;
import support;

test "a nullable local is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "main() -> int \{\n"
        + "    string? s = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type 'string?'") >= 0,
        "unexpected message: {message}");
}

test "a call to the built-in print is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "main() -> int \{\n"
        + "    print(\"hi\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(
        message.indexOf("does not support the built-in function 'print'") >= 0,
        "unexpected message: {message}");
}

test "a throwing function is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "boom() throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "boom");
    try testing.assertTrue(message.indexOf("does not support a throwing function") >= 0,
        "unexpected message: {message}");
}

test "a class local is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "class Box \{\n"
        + "    int value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box? b = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type 'Box?'") >= 0,
        "unexpected message: {message}");
}
