// Constructs outside the supported surface fail lowering with a diagnostic instead of emitting
// wrong code; the message names what is missing.
import @std.testing;
import support;

test "slicing an array of structs holding references is diagnosed as unsupported" {
    let message = try support.loweringFailure(support.unlowerableProgram(), "main");
    try testing.assertTrue(message.indexOf("does not support slicing an array whose elements "
        + "hold references inside a struct") >= 0, "unexpected message: {message}");
}

test "a checked cast to a numeric enum tests each member value and wraps the match" {
    let dumped = try support.loweredDump(
        "enum Errno \{\n"
        + "    EPERM = 1,\n"
        + "    ENOENT = 2,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let code = 1 as? Errno;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "a matching value should wrap into the present optional: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "a missing value should produce the absent optional: {dumped}");
}
