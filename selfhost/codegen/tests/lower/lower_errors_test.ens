// Constructs outside the supported surface fail lowering with a diagnostic instead of emitting
// wrong code; the message names what is missing.
import @std.testing;
import support;

import MemoryFileLoader from support;

test "slicing an array of structs holding references is diagnosed as unsupported" {
    let message = try support.loweringFailure(support.unlowerableProgram(), "main");
    try testing.assertTrue(message.indexOf("The compiler does not support slicing an array of "
        + "'Tagged', whose elements hold references") >= 0, "unexpected message: {message}");
}

// A refusal lands in the file that wrote the construct, so it spells the type the way that file
// can write it: under the alias the import bound, not the name the declaring module gave it.
test "a refused construct names an aliased type as the reporting file writes it" {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/cards.ens",
        "public struct Tagged \{\n"
        + "    protected string label = \"x\";\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import Tagged as Card from lib.cards;\n"
        + "main() -> int \{\n"
        + "    Card[] items = new Card[2];\n"
        + "    let part = items.slice(0, 1);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    try testing.assertEqual(try support.loweringLoadedFailure(analysis, "main"),
        "The compiler does not support slicing an array of 'Card', whose elements hold "
        + "references yet.");
}

test "a checked cast to a numeric enum tests each member value and wraps the match" {
    let dumped = try support.loweredDump(
        "enum Errno \{\n"
        + "    EPERM = 1,\n"
        + "    ENOENT = 2,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let code = 1 as? Errno;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "a matching value should wrap into the present optional: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "a missing value should produce the absent optional: {dumped}");
}
