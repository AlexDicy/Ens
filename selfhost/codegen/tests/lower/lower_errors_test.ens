// Constructs outside the supported surface fail lowering with a diagnostic instead of emitting
// wrong code; the message names what is missing.
import @std.testing;
import support;

test "an optional decimal is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "main() -> int \{\n"
        + "    decimal? n = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type 'decimal?'") >= 0,
        "unexpected message: {message}");
}

test "an instantiation over an unsupported argument is diagnosed, not laid out" {
    let message = try support.loweringFailure(
        "class Box<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box<decimal>? boxed = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type "
        + "'Box<decimal>?'") >= 0, "unexpected message: {message}");
}

test "a checked cast to a numeric enum tests each member value and wraps the match" {
    let dumped = try support.loweredDump(
        "enum Errno \{\n"
        + "    EPERM = 1,\n"
        + "    ENOENT = 2,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let code = 1 as? Errno;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "a matching value should wrap into the present optional: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "a missing value should produce the absent optional: {dumped}");
}
