// Constructs outside the supported surface fail lowering with a diagnostic instead of emitting
// wrong code; the message names what is missing.
import @std.testing;
import support;

test "an optional value type is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "main() -> int \{\n"
        + "    int? n = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type 'int?'") >= 0,
        "unexpected message: {message}");
}

test "a throwing function is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "boom() throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "boom");
    try testing.assertTrue(message.indexOf("does not support a throwing function") >= 0,
        "unexpected message: {message}");
}

test "a class extending a generic instantiation is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "class Box<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "class IntBox extends Box<int> \{\n"
        + "    protected constructor() \{\n"
        + "        super(1);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let boxed = new IntBox();\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("does not support a local of type 'IntBox'") >= 0,
        "unexpected message: {message}");
}

test "a checked cast to a numeric enum is diagnosed as unsupported" {
    let message = try support.loweringFailure(
        "enum Errno \{\n"
        + "    EPERM = 1,\n"
        + "    ENOENT = 2,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    1 as? Errno;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(message.indexOf("'as?' to a numeric enum") >= 0,
        "unexpected message: {message}");
}
