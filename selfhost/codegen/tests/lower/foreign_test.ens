// Golden dumps for foreign calls: arguments pass in declaration order at their declared types,
// an out argument passes the address of the local the C function writes back to, the fromCString
// intercept lifts a handle into an owned string with no generic instance anywhere, and a produced
// handle compared against null gives up nothing, unlike the reference of the same shape.
import @std.testing;
import support;

test "a foreign call passes converted values and an out argument passes the local's address" {
    let dumped = try support.loweredDump(
        "external from libc \{\n"
        + "    abs(int value) -> int;\n"
        + "    frexp(double value, out int exponent) -> double;\n"
        + "\}\n"
        + "probe() -> int \{\n"
        + "    int exponent = 0;\n"
        + "    let ignored = frexp(8.0, out exponent);\n"
        + "    return abs(0 - exponent);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "probe");
    try testing.assertEqual(dumped,
        "func internal @main$probe() -> int \{\n"
        + "  $0 exponent: int\n"
        + "  $1 ignored: double\n"
        + "b0.entry:\n"
        + "  %0 = const 0: int\n"
        + "  store $0, %0\n"
        + "  %1 = const 8.0: double\n"
        + "  %2 = slot_addr $0: &int  ; exponent\n"
        + "  %3 = foreign @frexp(%1, out %2): double\n"
        + "  store $1, %3\n"
        + "  %4 = const 0: int\n"
        + "  %5 = load $0: int\n"
        + "  %6 = sub %4, %5: int\n"
        + "  %7 = foreign @abs(%6): int\n"
        + "  ret %7\n"
        + "\}\n");
}

test "the fromCString intercept lifts a foreign handle into an owned string" {
    let loader = new support.MemoryFileLoader();
    loader.add("/stdlib/std/src/ffi.ens",
        "export fromCString<T>(T handle) -> string? \{\n"
        + "    return null;\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import @std.ffi;\n"
        + "external type CStr;\n"
        + "external from libc \{\n"
        + "    getenv(string name) -> CStr?;\n"
        + "\}\n"
        + "lookup(string name) -> string? \{\n"
        + "    return ffi.fromCString(getenv(name));\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedDump(analysis, "lookup");
    try testing.assertEqual(dumped,
        "func internal @main$lookup(%0: string) -> string? \{\n"
        + "  $0 name: string borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: string\n"
        + "  %2 = foreign @getenv(%1): CStr?\n"
        + "  %3 = cstring %2: string?\n"
        + "  ret %3\n"
        + "\}\n");
}

test "a produced nullable handle compared against null gives up no reference" {
    let dumped = try support.loweredDump(
        "external type Handle;\n"
        + "external from libc \{\n"
        + "    malloc(long size) -> Handle;\n"
        + "\}\n"
        + "grab() -> Handle? \{\n"
        + "    return malloc(8);\n"
        + "\}\n"
        + "probe() -> bool \{\n"
        + "    return grab() == null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "probe");
    try testing.assertEqual(dumped,
        "func internal @main$probe() -> bool \{\n"
        + "b0.entry:\n"
        + "  %0 = call @main$grab(): Handle?\n"
        + "  %1 = const null: null\n"
        + "  %2 = reinterpret %1: Handle?\n"
        + "  %3 = cmp.eq %0, %2: bool\n"
        + "  ret %3\n"
        + "\}\n");
}

test "a produced nullable reference of the same shape does give its reference up" {
    let dumped = try support.loweredDump(
        "class Cell \{\n"
        + "\}\n"
        + "grab() -> Cell? \{\n"
        + "    return new Cell();\n"
        + "\}\n"
        + "probe() -> bool \{\n"
        + "    return grab() == null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "probe");
    try testing.assertEqual(dumped,
        "func internal @main$probe() -> bool \{\n"
        + "b0.entry:\n"
        + "  %0 = call @main$grab(): Cell?\n"
        + "  %1 = const null: null\n"
        + "  %2 = reinterpret %1: Cell?\n"
        + "  %3 = cmp.eq %0, %2: bool\n"
        + "  release %0\n"
        + "  ret %3\n"
        + "\}\n");
}
