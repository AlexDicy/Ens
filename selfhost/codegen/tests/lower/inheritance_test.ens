// Golden lowering tests for inheritance: virtual dispatch through a base-typed reference, the
// direct calls a super receiver and a never-overridden method keep, constructor chaining both
// spelled and implicit, and the flattened field indexes an inherited field reads by. A private
// base field is not inherited, so a subclass reaches its own slot under that name or no slot
// at all.
import @std.testing;
import support;

test "an overridden method dispatches through its vtable slot and an upcast is a rename" {
    let dumped = try support.loweredDump(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected sound() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    protected legs() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override sound() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Animal a = new Dog();\n"
        + "    return a.sound() + a.legs();\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 a: Animal zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Dog: Dog\n"
        + "  call @main$Dog$constructor(this %0)\n"
        + "  %1 = reinterpret %0: Animal\n"
        + "  store $0, %1\n"
        + "  %2 = load $0: Animal\n"
        + "  %3 = call @main$Animal$sound(this %2) vtable[0]: int\n"
        + "  %4 = load $0: Animal\n"
        + "  %5 = call @main$Animal$legs(this %4): int\n"
        + "  %6 = add %3, %5: int\n"
        + "  %7 = slot_addr $0: &Animal  ; a\n"
        + "  release_ptr %7\n"
        + "  ret %6\n"
        + "\}\n");
}

test "super.method calls the base implementation directly, bypassing the override" {
    let dumped = try support.loweredMethodDump(
        "class Base \{\n"
        + "    protected int worth;\n"
        + "    protected constructor(this.worth = 1);\n"
        + "    protected score() -> int \{\n"
        + "        return this.worth;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor(int w) \{\n"
        + "        super(w);\n"
        + "    \}\n"
        + "    protected override score() -> int \{\n"
        + "        return super.score() + 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Derived(3).score();\n"
        + "\}\n", "Derived", "score");
    try testing.assertEqual(dumped,
        "func @main$Derived$score(%0: Derived) -> int \{\n"
        + "b0.entry:\n"
        + "  %1 = reinterpret %0: Base\n"
        + "  %2 = call @main$Base$score(this %1): int\n"
        + "  %3 = const 1: int\n"
        + "  %4 = add %2, %3: int\n"
        + "  ret %4\n"
        + "\}\n");
}

test "a constructor with no super call builds the base subobject first" {
    let dumped = try support.loweredMethodDump(
        "class Base \{\n"
        + "    protected int sides;\n"
        + "    protected constructor(this.sides = 7);\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected int extra;\n"
        + "    protected constructor() \{\n"
        + "        this.extra = 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Derived().sides;\n"
        + "\}\n", "Derived", "constructor");
    try testing.assertEqual(dumped,
        "func @main$Derived$constructor(%0: Derived) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = const 7: int\n"
        + "  call @main$Base$constructor(this %0, %1)\n"
        + "  %2 = object_field_addr %0, 1: &int  ; %0.extra\n"
        + "  %3 = const 1: int\n"
        + "  store_ptr %2, %3\n"
        + "  ret\n"
        + "\}\n");
}

test "an inherited field reads at its flattened index through a derived reference" {
    let dumped = try support.loweredDump(
        "class Base \{\n"
        + "    protected int first;\n"
        + "    protected constructor(this.first = 2);\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected int second;\n"
        + "    protected constructor() \{\n"
        + "        this.second = 3;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let d = new Derived();\n"
        + "    return d.first + d.second;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 d: Derived zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Derived: Derived\n"
        + "  call @main$Derived$constructor(this %0)\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Derived\n"
        + "  %2 = object_field_addr %1, 0: &int  ; %1.first\n"
        + "  %3 = load_ptr %2: int\n"
        + "  %4 = load $0: Derived\n"
        + "  %5 = object_field_addr %4, 1: &int  ; %4.second\n"
        + "  %6 = load_ptr %5: int\n"
        + "  %7 = add %3, %6: int\n"
        + "  %8 = slot_addr $0: &Derived  ; d\n"
        + "  release_ptr %8\n"
        + "  ret %7\n"
        + "\}\n");
}

// A private base field is not inherited, so a subclass field may reuse its name. The two hold
// slots of their own, and a write through a subclass reference lands in the subclass's.
test "a subclass field reusing a private base field's name writes its own slot" {
    let dumped = try support.loweredMethodDump(
        "public class Metered \{\n"
        + "    int ticks = 4;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Remetered extends Metered \{\n"
        + "    protected int ticks = 11;\n"
        + "    protected constructor();\n"
        + "    protected retick() \{\n"
        + "        this.ticks = 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Remetered();\n"
        + "    m.retick();\n"
        + "    return 0;\n"
        + "\}\n", "Remetered", "retick");
    try testing.assertEqual(dumped,
        "func @main$Remetered$retick(%0: Remetered) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 1: &int  ; %0.ticks\n"
        + "  %2 = const 7: int\n"
        + "  store_ptr %1, %2\n"
        + "  ret\n"
        + "\}\n");
}

// The same name with no field of the subclass under it reaches the method 'Remetered' declares,
// while the base's slot holds storage no code outside 'Metered' can name. Lowering computes no
// field address for it, rather than reaching into slot 0.
test "a name only a private base field uses lowers to no field address" {
    // Sema refuses this program, because 'm.ticks' names a method, so only a refused program
    // reaches this lowering. A function coming out of it at all fails this test, because a field
    // address here would write the base's own storage, and the refusal's wording is a limit
    // rather than the rule, so it is deliberately not pinned.
    try support.rejectedFunctionFailure(
        "public class Metered \{\n"
        + "    int ticks = 4;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Remetered extends Metered \{\n"
        + "    protected constructor();\n"
        + "    protected ticks() -> int \{\n"
        + "        return 11;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Remetered();\n"
        + "    m.ticks++;\n"
        + "    return m.ticks();\n"
        + "\}\n", "main");
}

// A 'this.field' parameter resolves its name the same way a written assignment does, so the
// subclass's own slot takes the value and the base's keeps whatever the base put there.
// A search ignoring a field's visibility reaches slot 1 here too.
// This dump therefore pins the slot arithmetic, not the private-base-field rule.
test "a 'this.field' parameter reusing a private base field's name writes its own slot" {
    let dumped = try support.loweredMethodDump(
        "public class Metered \{\n"
        + "    int ticks = 4;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Remetered extends Metered \{\n"
        + "    protected int ticks;\n"
        + "    protected constructor(this.ticks);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Remetered(7);\n"
        + "    return 0;\n"
        + "\}\n", "Remetered", "constructor");
    try testing.assertEqual(dumped,
        "func @main$Remetered$constructor(%0: Remetered, %1: int) -> void \{\n"
        + "  $0 ticks: int\n"
        + "b0.entry:\n"
        + "  call @main$Metered$constructor(this %0)\n"
        + "  store $0, %1\n"
        + "  %2 = object_field_addr %0, 1: &int  ; %0.ticks\n"
        + "  store_ptr %2, %1\n"
        + "  ret\n"
        + "\}\n");
}

// 'Remetered' has no field named 'ticks', so a 'this.ticks' parameter of its constructor binds
// nothing and sema refuses the program. Lowering such a program produces no function at all,
// so nothing writes the base's own slot 0 under that name.
test "a 'this.field' parameter naming only a private base field lowers to nothing" {
    // 'rejectedMethodFailure' fails this test if a function comes out of lowering, and that is
    // the whole assertion. The message it returns belongs to a bug-catcher, so its wording is
    // deliberately not pinned.
    try support.rejectedMethodFailure(
        "public class Metered \{\n"
        + "    int ticks = 4;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Remetered extends Metered \{\n"
        + "    protected constructor(this.ticks);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Remetered(7);\n"
        + "    return 0;\n"
        + "\}\n", "Remetered", "constructor");
}

test "a destructor chain runs the user destructors most derived first" {
    let dumped = try support.destructorDump(
        "class Base \{\n"
        + "    protected string tag;\n"
        + "    protected constructor(this.tag = \"b\");\n"
        + "    destructor() \{\n"
        + "        print(\"base gone\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    destructor() \{\n"
        + "        print(\"derived gone\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\n"
        + "    let d = new Derived();\n"
        + "\}\n", "Derived");
    try testing.assertEqual(dumped,
        "func @_dtor$main$Derived(%0: Derived) -> void \{\n"
        + "b0.entry:\n"
        + "  call @main$Derived$destructor(this %0)\n"
        + "  call @main$Base$destructor(this %0)\n"
        + "  %1 = object_field_addr %0, 0: &string  ; %0.tag\n"
        + "  release_ptr %1\n"
        + "  ret\n"
        + "\}\n");
}
