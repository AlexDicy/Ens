// Golden lowering tests for lazy consts. The goldens pin what a read costs once the value is
// there and what the initializer does with the one reference the program keeps.
import @std.testing;
import support;

test "a lazy const read tests the state byte and calls the initializer on the cold edge" {
    let dumped = try support.loweredDump(
        "build() -> long \{\n"
        + "    return 7;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public lazy const long value = build();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.value as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$value: &byte\n"
        + "  %1 = load_ptr %0: byte\n"
        + "  %2 = const 2: byte\n"
        + "  %3 = cmp.eq %1, %2: bool\n"
        + "  br %3, b1.lazy.ready, b2.lazy.build\n"
        + "b1.lazy.ready:\n"
        + "  %4 = global_addr @_lazyvalue$main$Holder$value: &long\n"
        + "  %5 = load_ptr %4: long\n"
        + "  %6 = trunc %5: int\n"
        + "  ret %6\n"
        + "b2.lazy.build:\n"
        + "  call @_lazyinit$main$Holder$value()\n"
        + "  jump b1.lazy.ready\n"
        + "\}\n");
}

test "a lazy const initializer refuses a read that closes a cycle and keeps the reference" {
    let dumped = try support.loweredSymbolDump(
        "public class Reader \{\n"
        + "    public const long size;\n"
        + "\n"
        + "    public constructor(this.size);\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public lazy const Reader input = new Reader(3);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.input.size as int;\n"
        + "\}\n", "_lazyinit$main$Holder$input");
    try testing.assertEqual(dumped,
        "func @_lazyinit$main$Holder$input() -> void \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$input: &byte\n"
        + "  %1 = load_ptr %0: byte\n"
        + "  %2 = const 1: byte\n"
        + "  %3 = cmp.eq %1, %2: bool\n"
        + "  br %3, b1.lazy.cycle, b2.lazy.build\n"
        + "b1.lazy.cycle:\n"
        + "  %4 = const \"'Holder.input' was read while it was still being initialized\": "
        + "string\n"
        + "  panic %4\n"
        + "  unreachable\n"
        + "b2.lazy.build:\n"
        + "  %5 = const 1: byte\n"
        + "  %6 = global_addr @_lazystate$main$Holder$input: &byte\n"
        + "  store_ptr %6, %5\n"
        + "  %7 = class.new @_dtor$main$Reader: Reader\n"
        + "  %8 = const 3: long\n"
        + "  call @main$Reader$constructor(this %7, %8)\n"
        + "  %9 = global_addr @_lazyvalue$main$Holder$input: &Reader\n"
        + "  store_ptr %9, %7\n"
        + "  %10 = const 2: byte\n"
        + "  %11 = global_addr @_lazystate$main$Holder$input: &byte\n"
        + "  store_ptr %11, %10\n"
        + "  ret\n"
        + "\}\n");
}
