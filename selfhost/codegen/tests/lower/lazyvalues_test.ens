// Golden lowering tests for lazy consts. The goldens pin what a read costs once the value is
// there, how the initializer takes the guard, and what it does with the one reference the program
// keeps.
import @std.testing;
import support;

test "a lazy const read asks the guard whether the value is there and builds it on the cold edge" {
    let dumped = try support.loweredDump(
        "build() -> long \{\n"
        + "    return 7;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public lazy const long value = build();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.value as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$value: &long\n"
        + "  %1 = foreign @ens_lazy_ready(out %0): bool\n"
        + "  br %1, b1.lazy.ready, b2.lazy.build\n"
        + "b1.lazy.ready:\n"
        + "  %2 = global_addr @_lazyvalue$main$Holder$value: &long\n"
        + "  %3 = load_ptr %2: long\n"
        + "  %4 = trunc %3: int\n"
        + "  ret %4\n"
        + "b2.lazy.build:\n"
        + "  call @_lazyinit$main$Holder$value()\n"
        + "  jump b1.lazy.ready\n"
        + "\}\n");
}

test "a lazy const initializer enters the guard, refuses a cycle, and keeps the reference immortal" {
    let dumped = try support.loweredSymbolDump(
        "public class Reader \{\n"
        + "    public const long size;\n"
        + "\n"
        + "    public constructor(this.size);\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public lazy const Reader input = new Reader(3);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.input.size as int;\n"
        + "\}\n", "_lazyinit$main$Holder$input");
    try testing.assertEqual(dumped,
        "func @_lazyinit$main$Holder$input() -> void \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$input: &long\n"
        + "  %1 = foreign @ens_lazy_enter(out %0): int\n"
        + "  %2 = const 0: int\n"
        + "  %3 = cmp.eq %1, %2: bool\n"
        + "  br %3, b2.lazy.built, b1.lazy.check\n"
        + "b1.lazy.check:\n"
        + "  %4 = const 2: int\n"
        + "  %5 = cmp.eq %1, %4: bool\n"
        + "  br %5, b3.lazy.cycle, b4.lazy.build\n"
        + "b2.lazy.built:\n"
        + "  ret\n"
        + "b3.lazy.cycle:\n"
        + "  %6 = const \"'Holder.input' was read while it was still being initialized\": "
        + "string\n"
        + "  panic %6\n"
        + "  unreachable\n"
        + "b4.lazy.build:\n"
        + "  %7 = class.new @_dtor$main$Reader: Reader\n"
        + "  %8 = const 3: long\n"
        + "  call @main$Reader$constructor(this %7, %8)\n"
        + "  %9 = global_addr @_lazyvalue$main$Holder$input: &Reader\n"
        + "  store_ptr %9, %7\n"
        + "  %10 = global_addr @_lazyvalue$main$Holder$input: &Reader\n"
        + "  foreign @ens_lazy_keep(out %10)\n"
        + "  %11 = global_addr @_lazystate$main$Holder$input: &long\n"
        + "  foreign @ens_lazy_leave(out %11)\n"
        + "  ret\n"
        + "\}\n");
}
