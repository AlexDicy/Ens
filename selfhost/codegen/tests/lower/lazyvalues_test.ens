// Golden lowering tests for lazy consts. The goldens pin what a read costs once the value is
// there, how the initializer takes the guard, and what it does with the one reference the program
// keeps, for a static lazy const and for one of each object.
import @std.testing;
import support;

test "a lazy const read asks the guard whether the value is there and builds it on the cold edge" {
    let dumped = try support.loweredDump(
        "build() -> long \{\n"
        + "    return 7;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public static lazy const long value = build();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.value as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$value: &long\n"
        + "  %1 = foreign @ens_lazy_ready(out %0): bool\n"
        + "  br %1, b1.lazy.ready, b2.lazy.build\n"
        + "b1.lazy.ready:\n"
        + "  %2 = global_addr @_lazyvalue$main$Holder$value: &long\n"
        + "  %3 = load_ptr %2: long\n"
        + "  %4 = trunc %3: int\n"
        + "  ret %4\n"
        + "b2.lazy.build:\n"
        + "  call @_lazyinit$main$Holder$value()\n"
        + "  jump b1.lazy.ready\n"
        + "\}\n");
}

test "a lazy const initializer enters the guard, refuses a cycle, and keeps the reference immortal" {
    let dumped = try support.loweredSymbolDump(
        "public shared final class Reader \{\n"
        + "    public const long size;\n"
        + "\n"
        + "    public constructor(this.size);\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public static lazy const Reader input = new Reader(3);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.input.size as int;\n"
        + "\}\n", "_lazyinit$main$Holder$input");
    try testing.assertEqual(dumped,
        "func @_lazyinit$main$Holder$input() -> void \{\n"
        + "b0.entry:\n"
        + "  %0 = global_addr @_lazystate$main$Holder$input: &long\n"
        + "  %1 = foreign @ens_lazy_enter(out %0): int\n"
        + "  %2 = const 0: int\n"
        + "  %3 = cmp.eq %1, %2: bool\n"
        + "  br %3, b2.lazy.built, b1.lazy.check\n"
        + "b1.lazy.check:\n"
        + "  %4 = const 2: int\n"
        + "  %5 = cmp.eq %1, %4: bool\n"
        + "  br %5, b3.lazy.cycle, b4.lazy.build\n"
        + "b2.lazy.built:\n"
        + "  ret\n"
        + "b3.lazy.cycle:\n"
        + "  %6 = const \"'Holder.input' was read while it was still being initialized\": "
        + "string\n"
        + "  panic %6\n"
        + "  unreachable\n"
        + "b4.lazy.build:\n"
        + "  %7 = class.new @_dtor$main$Reader: Reader\n"
        + "  %8 = const 3: long\n"
        + "  call @main$Reader$constructor(this %7, %8)\n"
        + "  %9 = global_addr @_lazyvalue$main$Holder$input: &Reader\n"
        + "  store_ptr %9, %7\n"
        + "  %10 = global_addr @_lazyvalue$main$Holder$input: &Reader\n"
        + "  foreign @ens_lazy_keep(out %10)\n"
        + "  %11 = global_addr @_lazystate$main$Holder$input: &long\n"
        + "  foreign @ens_lazy_leave(out %11)\n"
        + "  ret\n"
        + "\}\n");
}

test "a lazy const of each object is read through the guard on the state word after it" {
    let dumped = try support.loweredDump(
        "public class Holder \{\n"
        + "    public const long base;\n"
        + "    public lazy const long value = this.base * 2;\n"
        + "\n"
        + "    public constructor(this.base);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder(3);\n"
        + "    return holder.value as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 holder: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Holder: Holder\n"
        + "  %1 = const 3: long\n"
        + "  call @main$Holder$constructor(this %0, %1)\n"
        + "  store $0, %0\n"
        + "  %2 = load $0: Holder\n"
        + "  %3 = object_field_addr %2, 2: &long  ; %2.value state\n"
        + "  %4 = foreign @ens_lazy_ready(out %3): bool\n"
        + "  br %4, b1.lazy.ready, b2.lazy.build\n"
        + "b1.lazy.ready:\n"
        + "  %5 = object_field_addr %2, 1: &long  ; %2.value\n"
        + "  %6 = load_ptr %5: long\n"
        + "  %7 = trunc %6: int\n"
        + "  %8 = slot_addr $0: &Holder  ; holder\n"
        + "  release_ptr %8\n"
        + "  ret %7\n"
        + "b2.lazy.build:\n"
        + "  call @_lazyobject$main$Holder$value(this %2)\n"
        + "  jump b1.lazy.ready\n"
        + "\}\n");
}

test "a lazy const initializer of each object stores into the object and keeps nothing immortal" {
    let dumped = try support.loweredSymbolDump(
        "public class Holder \{\n"
        + "    public const string name;\n"
        + "    public lazy const string greeting = \"hi \" + this.name;\n"
        + "\n"
        + "    public constructor(this.name);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Holder(\"x\").greeting.length as int;\n"
        + "\}\n", "_lazyobject$main$Holder$greeting");
    try testing.assertEqual(dumped,
        "func @_lazyobject$main$Holder$greeting(%0: Holder) -> void \{\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 2: &long  ; %0.greeting state\n"
        + "  %2 = foreign @ens_lazy_enter(out %1): int\n"
        + "  %3 = const 0: int\n"
        + "  %4 = cmp.eq %2, %3: bool\n"
        + "  br %4, b2.lazy.built, b1.lazy.check\n"
        + "b1.lazy.check:\n"
        + "  %5 = const 2: int\n"
        + "  %6 = cmp.eq %2, %5: bool\n"
        + "  br %6, b3.lazy.cycle, b4.lazy.build\n"
        + "b2.lazy.built:\n"
        + "  ret\n"
        + "b3.lazy.cycle:\n"
        + "  %7 = const \"'Holder.greeting' was read while it was still being initialized\": "
        + "string\n"
        + "  panic %7\n"
        + "  unreachable\n"
        + "b4.lazy.build:\n"
        + "  %8 = const \"hi \": string\n"
        + "  retain %8\n"
        + "  %9 = object_field_addr %0, 0: &string  ; %0.name\n"
        + "  %10 = load_ptr %9: string\n"
        + "  retain %10\n"
        + "  %11 = str.concat %8, %10: string\n"
        + "  release %8\n"
        + "  release %10\n"
        + "  %12 = object_field_addr %0, 1: &string  ; %0.greeting\n"
        + "  store_ptr %12, %11\n"
        + "  %13 = object_field_addr %0, 2: &long  ; %0.greeting state\n"
        + "  foreign @ens_lazy_leave(out %13)\n"
        + "  ret\n"
        + "\}\n");
}
