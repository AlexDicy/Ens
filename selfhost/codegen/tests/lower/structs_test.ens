// Golden lowering tests for structs as value aggregates: literals with defaults, field reads and
// writes, methods over a receiver address, and the field-wise ARC a struct holding a string needs.
// The goldens pin where a field's reference changes hands.
import @std.testing;
import MemoryFileLoader from support;
import support;

// A program whose interface, conforming struct, and bounded generic function are all one file.
conformanceProgram() -> string {
    return "interface Measured \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "struct Box implements Measured \{\n"
        + "    protected long count;\n"
        + "\n"
        + "    protected override size() -> long \{\n"
        + "        return this.count;\n"
        + "    \}\n"
        + "\}\n"
        + "sizeOf<T: Measured>(T value) -> long \{\n"
        + "    return value.size();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box box = \{count: 3\};\n"
        + "    return sizeOf<Box>(box) as int - 3;\n"
        + "\}\n";
}

test "a literal fills the written fields then the omitted ones from their defaults" {
    let dumped = try support.loweredDump(
        "struct Box \{\n"
        + "    protected int width = 20;\n"
        + "    protected int height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box b = \{height: 5\};\n"
        + "    return b.width + b.height;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 b: Box zeroed\n"
        + "  $1 structlit: Box zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Box  ; structlit\n"
        + "  %1 = const 5: int\n"
        + "  %2 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = const 20: int\n"
        + "  %4 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = load $1: Box\n"
        + "  store $0, %5\n"
        + "  %6 = slot_addr $0: &Box  ; b\n"
        + "  %7 = field_addr %6, 0: &int  ; b.width\n"
        + "  %8 = load_ptr %7: int\n"
        + "  %9 = slot_addr $0: &Box  ; b\n"
        + "  %10 = field_addr %9, 1: &int  ; b.height\n"
        + "  %11 = load_ptr %10: int\n"
        + "  %12 = add %8, %11: int\n"
        + "  ret %12\n"
        + "\}\n");
}

test "writing a field goes through the field's own address" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    protected int x;\n"
        + "    protected int y;\n"
        + "\}\n"
        + "shift(Point p) -> int \{\n"
        + "    p.x = 9;\n"
        + "    p.y += 2;\n"
        + "    return p.x + p.y;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, y: 2\};\n"
        + "    return shift(p);\n"
        + "\}\n", "shift");
    try testing.assertEqual(dumped,
        "func internal @main$shift(%0: Point) -> int \{\n"
        + "  $0 p: Point zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Point  ; p\n"
        + "  %2 = field_addr %1, 0: &int  ; p.x\n"
        + "  %3 = const 9: int\n"
        + "  store_ptr %2, %3\n"
        + "  %4 = slot_addr $0: &Point  ; p\n"
        + "  %5 = field_addr %4, 1: &int  ; p.y\n"
        + "  %6 = load_ptr %5: int\n"
        + "  %7 = const 2: int\n"
        + "  %8 = add %6, %7: int\n"
        + "  store_ptr %5, %8\n"
        + "  %9 = slot_addr $0: &Point  ; p\n"
        + "  %10 = field_addr %9, 0: &int  ; p.x\n"
        + "  %11 = load_ptr %10: int\n"
        + "  %12 = slot_addr $0: &Point  ; p\n"
        + "  %13 = field_addr %12, 1: &int  ; p.y\n"
        + "  %14 = load_ptr %13: int\n"
        + "  %15 = add %11, %14: int\n"
        + "  ret %15\n"
        + "\}\n");
}

test "a method call passes the receiver's address ahead of the arguments" {
    let dumped = try support.loweredDump(
        "struct Rectangle \{\n"
        + "    protected int width;\n"
        + "    protected int height;\n"
        + "    protected scaled(int by) -> int \{\n"
        + "        return this.width * this.height * by;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rectangle r = \{width: 6, height: 7\};\n"
        + "    return r.scaled(2);\n"
        + "\}\n", "main");
    try testing.assertTrue(
        dumped.indexOf("  %6 = slot_addr $0: &Rectangle  ; r\n") >= 0,
        "the receiver should be the address of the local: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %8 = call @main$Rectangle$scaled(this %6, %7): int\n") >= 0,
        "the receiver address should lead the arguments: {dumped}");
}

test "a method body reads its fields through the receiver address in temp zero" {
    let dumped = try support.loweredDump(
        "struct Rectangle \{\n"
        + "    protected int width;\n"
        + "    protected int height;\n"
        + "    protected area() -> int \{\n"
        + "        return this.width * this.height;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rectangle r = \{width: 6, height: 7\};\n"
        + "    return r.area();\n"
        + "\}\n", "area");
    try testing.assertEqual(dumped,
        "func @main$Rectangle$area(%0: &Rectangle) -> int \{\n"
        + "b0.entry:\n"
        + "  %1 = field_addr %0, 0: &int  ; this.width\n"
        + "  %2 = load_ptr %1: int\n"
        + "  %3 = field_addr %0, 1: &int  ; this.height\n"
        + "  %4 = load_ptr %3: int\n"
        + "  %5 = mul %2, %4: int\n"
        + "  ret %5\n"
        + "\}\n");
}

test "copying a struct with a string field retains and releases that field by address" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Holder a = \{name: \"x\"\};\n"
        + "    Holder b = a;\n"
        + "    b = a;\n"
        + "    return b.name.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 a: Holder zeroed\n"
        + "  $1 structlit: Holder\n"
        + "  $2 b: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = zero: Holder\n"
        + "  store $1, %0\n"
        + "  %1 = slot_addr $1: &Holder  ; structlit\n"
        + "  %2 = const \"x\": string\n"
        + "  %3 = field_addr %1, 0: &string  ; structlit.name\n"
        + "  retain %2\n"
        + "  store_ptr %3, %2\n"
        + "  %4 = take $1: Holder\n"
        + "  store $0, %4\n"
        + "  %5 = slot_addr $0: &Holder  ; a\n"
        + "  %6 = load_ptr %5: Holder\n"
        + "  %7 = field_addr %5, 0: &string  ; a.name\n"
        + "  retain_ptr %7\n"
        + "  store $2, %6\n"
        + "  %8 = slot_addr $0: &Holder  ; a\n"
        + "  %9 = load_ptr %8: Holder\n"
        + "  %10 = field_addr %8, 0: &string  ; a.name\n"
        + "  retain_ptr %10\n"
        + "  %11 = slot_addr $2: &Holder  ; b\n"
        + "  %12 = field_addr %11, 0: &string  ; b.name\n"
        + "  release_ptr %12\n"
        + "  store $2, %9\n"
        + "  %13 = slot_addr $2: &Holder  ; b\n"
        + "  %14 = field_addr %13, 0: &string  ; b.name\n"
        + "  %15 = load_ptr %14: string\n"
        + "  %16 = str.len %15: long\n"
        + "  %17 = trunc %16: int\n"
        + "  %18 = slot_addr $2: &Holder  ; b\n"
        + "  %19 = field_addr %18, 0: &string  ; b.name\n"
        + "  release_ptr %19\n"
        + "  %20 = slot_addr $0: &Holder  ; a\n"
        + "  %21 = field_addr %20, 0: &string  ; a.name\n"
        + "  release_ptr %21\n"
        + "  ret %17\n"
        + "\}\n");
}

test "a struct temporary passed as an argument is released once the call returns" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "takes(Holder h) -> long \{\n"
        + "    return h.name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return takes(\{name: \"a\"\}) as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 structlit: Holder\n"
        + "  $1 materialized: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = zero: Holder\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Holder  ; structlit\n"
        + "  %2 = const \"a\": string\n"
        + "  %3 = field_addr %1, 0: &string  ; structlit.name\n"
        + "  retain %2\n"
        + "  store_ptr %3, %2\n"
        + "  %4 = take $0: Holder\n"
        + "  store $1, %4\n"
        + "  %5 = slot_addr $1: &Holder  ; materialized\n"
        + "  %6 = load_ptr %5: Holder\n"
        + "  %7 = call @main$takes(%6): long\n"
        + "  %8 = slot_addr $1: &Holder  ; materialized\n"
        + "  %9 = field_addr %8, 0: &string  ; materialized.name\n"
        + "  release_ptr %9\n"
        + "  %10 = trunc %7: int\n"
        + "  ret %10\n"
        + "\}\n");
}

test "a struct a call makes only for a method call is released once the call returns" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    protected string name;\n"
        + "    protected size() -> long \{\n"
        + "        return this.name.length;\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Holder \{\n"
        + "    return \{name: \"a\"\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return make().size() as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 materialized: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @main$make(): Holder\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Holder  ; materialized\n"
        + "  %2 = call @main$Holder$size(this %1): long\n"
        + "  %3 = slot_addr $0: &Holder  ; materialized\n"
        + "  %4 = field_addr %3, 0: &string  ; materialized.name\n"
        + "  release_ptr %4\n"
        + "  %5 = trunc %2: int\n"
        + "  ret %5\n"
        + "\}\n");
}

test "a struct a call makes for a field read is released where the read's use ends" {
    let dumped = try support.loweredDump(
        "struct Named \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "named() -> Named \{\n"
        + "    return \{name: \"a\"\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string kept = named().name;\n"
        + "    long count = 0;\n"
        + "    while (named().name.length > count) \{\n"
        + "        count++;\n"
        + "    \}\n"
        + "    return kept.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 kept: string zeroed\n"
        + "  $1 materialized: Named zeroed\n"
        + "  $2 count: long\n"
        + "  $3 materialized: Named zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @main$named(): Named\n"
        + "  store $1, %0\n"
        + "  %1 = slot_addr $1: &Named  ; materialized\n"
        + "  %2 = field_addr %1, 0: &string  ; materialized.name\n"
        + "  %3 = load_ptr %2: string\n"
        + "  retain %3\n"
        + "  store $0, %3\n"
        + "  %4 = slot_addr $1: &Named  ; materialized\n"
        + "  %5 = field_addr %4, 0: &string  ; materialized.name\n"
        + "  release_ptr %5\n"
        + "  %6 = const 0: long\n"
        + "  store $2, %6\n"
        + "  jump b1.while.cond\n"
        + "b1.while.cond:\n"
        + "  %7 = call @main$named(): Named\n"
        + "  store $3, %7\n"
        + "  %8 = slot_addr $3: &Named  ; materialized\n"
        + "  %9 = field_addr %8, 0: &string  ; materialized.name\n"
        + "  %10 = load_ptr %9: string\n"
        + "  %11 = str.len %10: long\n"
        + "  %12 = slot_addr $3: &Named  ; materialized\n"
        + "  %13 = field_addr %12, 0: &string  ; materialized.name\n"
        + "  release_ptr %13\n"
        + "  %14 = load $2: long\n"
        + "  %15 = cmp.sgt %11, %14: bool\n"
        + "  br %15, b2.while.body, b3.while.end\n"
        + "b2.while.body:\n"
        + "  %16 = load $2: long\n"
        + "  %17 = const 1: long\n"
        + "  %18 = add %16, %17: long\n"
        + "  store $2, %18\n"
        + "  jump b1.while.cond\n"
        + "b3.while.end:\n"
        + "  %19 = load $0: string\n"
        + "  %20 = str.len %19: long\n"
        + "  %21 = trunc %20: int\n"
        + "  %22 = slot_addr $0: &string  ; kept\n"
        + "  release_ptr %22\n"
        + "  ret %21\n"
        + "\}\n");
}

test "a struct parameter owns the references its copy holds for the call" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "takes(Holder h) -> long \{\n"
        + "    return h.name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return takes(\{name: \"a\"\}) as int;\n"
        + "\}\n", "takes");
    try testing.assertEqual(dumped,
        "func internal @main$takes(%0: Holder) -> long \{\n"
        + "  $0 h: Holder zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Holder  ; h\n"
        + "  %2 = field_addr %1, 0: &string  ; h.name\n"
        + "  retain_ptr %2\n"
        + "  %3 = slot_addr $0: &Holder  ; h\n"
        + "  %4 = field_addr %3, 0: &string  ; h.name\n"
        + "  %5 = load_ptr %4: string\n"
        + "  %6 = str.len %5: long\n"
        + "  %7 = slot_addr $0: &Holder  ; h\n"
        + "  %8 = field_addr %7, 0: &string  ; h.name\n"
        + "  release_ptr %8\n"
        + "  ret %6\n"
        + "\}\n");
}

test "a returned struct read out of storage is retained as the value it reads" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "same(Holder h) -> Holder \{\n"
        + "    return h;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return same(\{name: \"a\"\}).name.length as int - 1;\n"
        + "\}\n", "same");
    try testing.assertEqual(dumped,
        "func internal @main$same(%0: Holder) -> Holder \{\n"
        + "  $0 h: Holder zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Holder  ; h\n"
        + "  %2 = field_addr %1, 0: &string  ; h.name\n"
        + "  retain_ptr %2\n"
        + "  %3 = slot_addr $0: &Holder  ; h\n"
        + "  %4 = load_ptr %3: Holder\n"
        + "  retain %4\n"
        + "  %5 = slot_addr $0: &Holder  ; h\n"
        + "  %6 = field_addr %5, 0: &string  ; h.name\n"
        + "  release_ptr %6\n"
        + "  ret %4\n"
        + "\}\n");
}

test "a literal releases the fields it already wrote when a later field throws" {
    let dumped = try support.loweredDump(
        "class Failure extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"no\");\n"
        + "    \}\n"
        + "\}\n"
        + "struct Named \{\n"
        + "    protected string name;\n"
        + "    protected long count;\n"
        + "\}\n"
        + "counted() -> long throws \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "built(string name) -> Named throws \{\n"
        + "    return \{name: name, count: try counted()\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "built");
    try testing.assertEqual(dumped,
        "func internal @main$built(%0: string) -> Named throws \{\n"
        + "  $0 name: string borrowed\n"
        + "  $1 structlit: Named\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = zero: Named\n"
        + "  store $1, %1\n"
        + "  %2 = slot_addr $1: &Named  ; structlit\n"
        + "  %3 = load $0: string\n"
        + "  %4 = field_addr %2, 0: &string  ; structlit.name\n"
        + "  retain %3\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = try_call @main$counted(): long, error %6, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  %9 = field_addr %2, 1: &long  ; structlit.count\n"
        + "  store_ptr %9, %5\n"
        + "  %10 = take $1: Named\n"
        + "  ret %10\n"
        + "b2.try.unwind:\n"
        + "  %7 = slot_addr $1: &Named  ; structlit\n"
        + "  %8 = field_addr %7, 0: &string  ; structlit.name\n"
        + "  release_ptr %8\n"
        + "  propagate %6\n"
        + "\}\n");
}

test "a constructor call releases the defaults it applied when an argument throws" {
    let dumped = try support.loweredDump(
        "class Failure extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"no\");\n"
        + "    \}\n"
        + "\}\n"
        + "struct Named \{\n"
        + "    protected string extra = \"default\";\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(string name) \{\n"
        + "        this.name = name;\n"
        + "    \}\n"
        + "\}\n"
        + "named() -> string throws \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "built() -> Named throws \{\n"
        + "    return Named(try named());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "built");
    try testing.assertEqual(dumped,
        "func internal @main$built() -> Named throws \{\n"
        + "  $0 structctor: Named\n"
        + "b0.entry:\n"
        + "  %0 = zero: Named\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Named  ; structctor\n"
        + "  %2 = const \"default\": string\n"
        + "  %3 = field_addr %1, 0: &string  ; structctor.extra\n"
        + "  retain %2\n"
        + "  store_ptr %3, %2\n"
        + "  %4 = try_call @main$named(): string, error %5, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  call @main$Named$constructor(this %1, %4)\n"
        + "  release %4\n"
        + "  %9 = take $0: Named\n"
        + "  ret %9\n"
        + "b2.try.unwind:\n"
        + "  %6 = slot_addr $0: &Named  ; structctor\n"
        + "  %7 = field_addr %6, 0: &string  ; structctor.extra\n"
        + "  release_ptr %7\n"
        + "  %8 = field_addr %6, 1: &string  ; structctor.name\n"
        + "  release_ptr %8\n"
        + "  propagate %5\n"
        + "\}\n");
}

test "a default reading an earlier sibling reads it out of the aggregate being filled" {
    let dumped = try support.loweredDump(
        "struct Rect \{\n"
        + "    int width = 4;\n"
        + "    int height = 5;\n"
        + "    protected int area = width * height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rect r = \{\};\n"
        + "    return r.area;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 r: Rect zeroed\n"
        + "  $1 structlit: Rect zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Rect  ; structlit\n"
        + "  %1 = const 4: int\n"
        + "  %2 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = const 5: int\n"
        + "  %4 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  %6 = load_ptr %5: int\n"
        + "  %7 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  %8 = load_ptr %7: int\n"
        + "  %9 = mul %6, %8: int\n"
        + "  %10 = field_addr %0, 2: &int  ; structlit.area\n"
        + "  store_ptr %10, %9\n"
        + "  %11 = load $1: Rect\n"
        + "  store $0, %11\n"
        + "  %12 = slot_addr $0: &Rect  ; r\n"
        + "  %13 = field_addr %12, 2: &int  ; r.area\n"
        + "  %14 = load_ptr %13: int\n"
        + "  ret %14\n"
        + "\}\n");
}

test "an allocated array of structs runs each slot through the element's defaults" {
    let dumped = try support.loweredDump(
        "struct Box \{\n"
        + "    protected int width = 20;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box[] boxes = new Box[3];\n"
        + "    return boxes[0].width;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("b2.fill.body:\n") >= 0,
        "the allocation should loop over the slots: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %7 = element_addr %2[%6]: &Box  ; %2[%6]\n") >= 0,
        "each slot should be reached by its element address: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %9 = field_addr %7, 0: &int  ; %2[%6].width\n") >= 0,
        "the default should be written into the slot's field: {dumped}");
}

test "comparing two structs walks their fields and short-circuits at the first difference" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    protected int x;\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point a = \{x: 1, label: \"a\"\};\n"
        + "    Point b = \{x: 1, label: \"a\"\};\n"
        + "    if (a == b) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("struct.eq.differ") >= 0,
        "the comparison should short-circuit into a differ block: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the string field should compare by content: {dumped}");
}

test "a struct that declared equals is compared through the declaration, field and all" {
    let dumped = try support.loweredDump(
        "struct Key \{\n"
        + "    protected int id;\n"
        + "    protected string note;\n"
        + "    override hash() -> long \{ return this.id; \}\n"
        + "    override equals(Key other) -> bool \{ return this.id == other.id; \}\n"
        + "\}\n"
        + "struct Wrapper \{\n"
        + "    protected Key key;\n"
        + "    protected int tag;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Wrapper a = \{key: \{id: 1, note: \"a\"\}, tag: 1\};\n"
        + "    Wrapper b = \{key: \{id: 1, note: \"b\"\}, tag: 1\};\n"
        + "    if (a == b) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("call @main$Key$equals(this %") >= 0,
        "the nested field should compare through the declaration: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") < 0,
        "the ignored string field should never be compared: {dumped}");
}

test "an optional struct field compares behind a presence guard" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    int x;\n"
        + "    string label;\n"
        + "\}\n"
        + "struct Spotted \{\n"
        + "    protected Point? spot;\n"
        + "    protected int tag;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Spotted a = \{spot: null, tag: 1\};\n"
        + "    Spotted b = \{spot: null, tag: 1\};\n"
        + "    if (a == b) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("optstructeq.payload") >= 0
        && dumped.indexOf("optstructeq.end") >= 0,
        "the comparison should branch on presence: {dumped}");
    try testing.assertTrue(dumped.indexOf("payload: Point borrowed") >= 0,
        "the present payloads should be borrowed into slots of their own: {dumped}");
}

test "a call through a generic bound reaches the struct's own method directly" {
    let analysis = try support.analyzeMain(conformanceProgram());
    let dumped = try support.loweredLoadedSymbolDump(analysis, "main$sizeOf__main_Box__");
    try testing.assertTrue(dumped.indexOf("call @main$Box$size(this %") > 0,
        "the instance at 'Box' calls the struct's own method: {dumped}");
    try testing.assertTrue(dumped.indexOf("dispatch") < 0,
        "nothing looks the target up in a dispatch table: {dumped}");
}

test "a struct that conforms gets no type descriptor and no method table" {
    let analysis = try support.analyzeMain(conformanceProgram());
    let program = try support.lowerLoadedProgram(analysis);
    let box = try support.structNamed(analysis, "Box");
    try testing.assertTrue(program.plans.planFor(box) == null,
        "a struct carries no runtime type identity, so nothing plans a descriptor for it");
}

test "a for-in over an Iterable struct calls makeIterator directly over the receiver address" {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    int limit;\n"
        + "    protected constructor(this.current, this.limit);\n"
        + "    protected override next() -> int? \{\n"
        + "        if (this.current > this.limit) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        int value = this.current;\n"
        + "        this.current = this.current + 1;\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Range implements Iterable<int> \{\n"
        + "    protected int low;\n"
        + "    protected int high;\n"
        + "    protected override makeIterator() -> Iterator<int> \{\n"
        + "        return new CountUp(this.low, this.high);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int total = 0;\n"
        + "    Range range = \{low: 1, high: 3\};\n"
        + "    for (let n in range) \{\n"
        + "        total = total + n;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedDump(analysis, "main");
    try testing.assertTrue(dumped.indexOf("call @main$Range$makeIterator(this %") > 0,
        "the walk opens with a direct call to the struct's own method: {dumped}");
    try testing.assertTrue(dumped.indexOf("slot_addr $1: &Range  ; range") >= 0,
        "the receiver is the address of the struct's storage: {dumped}");
    try testing.assertTrue(dumped.indexOf("itable[Iterable<int>") < 0,
        "nothing consults a method table for the struct: {dumped}");
    try testing.assertTrue(dumped.indexOf("itable[Iterator<int>, 0]") >= 0,
        "the iterator it answers still dispatches as a class: {dumped}");
}

test "a struct a for-in makes is released once its iterator is made, and the iterator where the loop ends" {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountDown implements Iterator<int> \{\n"
        + "    int left;\n"
        + "    protected constructor(this.left);\n"
        + "    protected override next() -> int? \{\n"
        + "        if (this.left == 0) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        this.left = this.left - 1;\n"
        + "        return this.left;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Named implements Iterable<int> \{\n"
        + "    protected string name;\n"
        + "    protected override makeIterator() -> Iterator<int> \{\n"
        + "        return new CountDown(this.name.length as int);\n"
        + "    \}\n"
        + "\}\n"
        + "named() -> Named \{\n"
        + "    return \{name: \"abc\"\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int total = 0;\n"
        + "    for (let n in named()) \{\n"
        + "        total = total + n;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedDump(analysis, "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 total: int\n"
        + "  $1 materialized: Named zeroed\n"
        + "  $2 iterator: Iterator<int> zeroed\n"
        + "  $3 n: int\n"
        + "b0.entry:\n"
        + "  %0 = const 0: int\n"
        + "  store $0, %0\n"
        + "  %1 = call @main$named(): Named\n"
        + "  store $1, %1\n"
        + "  %2 = slot_addr $1: &Named  ; materialized\n"
        + "  %3 = call @main$Named$makeIterator(this %2): Iterator<int>\n"
        + "  %4 = slot_addr $1: &Named  ; materialized\n"
        + "  %5 = field_addr %4, 0: &string  ; materialized.name\n"
        + "  release_ptr %5\n"
        + "  store $2, %3\n"
        + "  jump b1.foreach.cond\n"
        + "b1.foreach.cond:\n"
        + "  %6 = load $2: Iterator<int>\n"
        + "  %7 = call @std.collections.iterator$Iterator__int___next(this %6) itable[Iterator<int>, 0]: int?\n"
        + "  %8 = opt.present %7: bool\n"
        + "  br %8, b2.foreach.body, b4.foreach.absent\n"
        + "b2.foreach.body:\n"
        + "  %9 = opt.payload move %7: int\n"
        + "  store $3, %9\n"
        + "  %10 = load $0: int\n"
        + "  %11 = load $3: int\n"
        + "  %12 = add %10, %11: int\n"
        + "  store $0, %12\n"
        + "  jump b1.foreach.cond\n"
        + "b3.foreach.end:\n"
        + "  %13 = slot_addr $2: &Iterator<int>  ; iterator\n"
        + "  release_ptr %13\n"
        + "  %14 = load $0: int\n"
        + "  ret %14\n"
        + "b4.foreach.absent:\n"
        + "  jump b3.foreach.end\n"
        + "\}\n");
}
