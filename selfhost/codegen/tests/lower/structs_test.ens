// Golden lowering tests for structs as value aggregates: literals with defaults, field reads and
// writes, methods over a receiver address, and the field-wise ARC a struct holding a string needs.
// The goldens pin where a field's reference changes hands, which is the part a later pass may only
// move if it keeps the counts balanced.
import @std.testing;
import support;

test "a literal fills the written fields then the omitted ones from their defaults" {
    let dumped = try support.loweredDump(
        "struct Box \{\n"
        + "    int width = 20;\n"
        + "    int height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box b = \{height: 5\};\n"
        + "    return b.width + b.height;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 b: Box zeroed\n"
        + "  $1 structlit: Box zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Box  ; structlit\n"
        + "  %1 = const 5: int\n"
        + "  %2 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = const 20: int\n"
        + "  %4 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = load_ptr %0: Box\n"
        + "  store $0, %5\n"
        + "  %6 = slot_addr $0: &Box  ; b\n"
        + "  %7 = field_addr %6, 0: &int  ; b.width\n"
        + "  %8 = load_ptr %7: int\n"
        + "  %9 = slot_addr $0: &Box  ; b\n"
        + "  %10 = field_addr %9, 1: &int  ; b.height\n"
        + "  %11 = load_ptr %10: int\n"
        + "  %12 = add %8, %11: int\n"
        + "  ret %12\n"
        + "\}\n");
}

test "writing a field goes through the field's own address" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    int x;\n"
        + "    int y;\n"
        + "\}\n"
        + "shift(Point p) -> int \{\n"
        + "    p.x = 9;\n"
        + "    p.y += 2;\n"
        + "    return p.x + p.y;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, y: 2\};\n"
        + "    return shift(p);\n"
        + "\}\n", "shift");
    try testing.assertEqual(dumped,
        "func internal @shift(%0: Point) -> int \{\n"
        + "  $0 p: Point zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Point  ; p\n"
        + "  %2 = field_addr %1, 0: &int  ; p.x\n"
        + "  %3 = const 9: int\n"
        + "  store_ptr %2, %3\n"
        + "  %4 = slot_addr $0: &Point  ; p\n"
        + "  %5 = field_addr %4, 1: &int  ; p.y\n"
        + "  %6 = load_ptr %5: int\n"
        + "  %7 = const 2: int\n"
        + "  %8 = add %6, %7: int\n"
        + "  store_ptr %5, %8\n"
        + "  %9 = slot_addr $0: &Point  ; p\n"
        + "  %10 = field_addr %9, 0: &int  ; p.x\n"
        + "  %11 = load_ptr %10: int\n"
        + "  %12 = slot_addr $0: &Point  ; p\n"
        + "  %13 = field_addr %12, 1: &int  ; p.y\n"
        + "  %14 = load_ptr %13: int\n"
        + "  %15 = add %11, %14: int\n"
        + "  ret %15\n"
        + "\}\n");
}

test "a method call passes the receiver's address ahead of the arguments" {
    let dumped = try support.loweredDump(
        "struct Rectangle \{\n"
        + "    protected int width;\n"
        + "    protected int height;\n"
        + "    protected scaled(int by) -> int \{\n"
        + "        return this.width * this.height * by;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rectangle r = \{width: 6, height: 7\};\n"
        + "    return r.scaled(2);\n"
        + "\}\n", "main");
    try testing.assertTrue(
        dumped.indexOf("  %6 = slot_addr $0: &Rectangle  ; r\n") >= 0,
        "the receiver should be the address of the local: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %8 = call @main$Rectangle$scaled(this %6, %7): int\n") >= 0,
        "the receiver address should lead the arguments: {dumped}");
}

test "a method body reads its fields through the receiver address in temp zero" {
    let dumped = try support.loweredDump(
        "struct Rectangle \{\n"
        + "    protected int width;\n"
        + "    protected int height;\n"
        + "    protected getArea() -> int \{\n"
        + "        return this.width * this.height;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rectangle r = \{width: 6, height: 7\};\n"
        + "    return r.getArea();\n"
        + "\}\n", "getArea");
    try testing.assertEqual(dumped,
        "func @main$Rectangle$getArea(%0: &Rectangle) -> int \{\n"
        + "b0.entry:\n"
        + "  %1 = field_addr %0, 0: &int  ; this.width\n"
        + "  %2 = load_ptr %1: int\n"
        + "  %3 = field_addr %0, 1: &int  ; this.height\n"
        + "  %4 = load_ptr %3: int\n"
        + "  %5 = mul %2, %4: int\n"
        + "  ret %5\n"
        + "\}\n");
}

test "copying a struct with a string field retains and releases that field by address" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    string name;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Holder a = \{name: \"x\"\};\n"
        + "    Holder b = a;\n"
        + "    b = a;\n"
        + "    return b.name.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 a: Holder zeroed\n"
        + "  $1 structlit: Holder zeroed\n"
        + "  $2 b: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Holder  ; structlit\n"
        + "  %1 = const \"x\": string\n"
        + "  %2 = field_addr %0, 0: &string  ; structlit.name\n"
        + "  retain %1\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = load_ptr %0: Holder\n"
        + "  store $0, %3\n"
        + "  %4 = slot_addr $0: &Holder  ; a\n"
        + "  %5 = load_ptr %4: Holder\n"
        + "  %6 = field_addr %4, 0: &string  ; a.name\n"
        + "  retain_ptr %6\n"
        + "  store $2, %5\n"
        + "  %7 = slot_addr $0: &Holder  ; a\n"
        + "  %8 = load_ptr %7: Holder\n"
        + "  %9 = field_addr %7, 0: &string  ; a.name\n"
        + "  retain_ptr %9\n"
        + "  %10 = slot_addr $2: &Holder  ; b\n"
        + "  %11 = field_addr %10, 0: &string  ; b.name\n"
        + "  release_ptr %11\n"
        + "  store $2, %8\n"
        + "  %12 = slot_addr $2: &Holder  ; b\n"
        + "  %13 = field_addr %12, 0: &string  ; b.name\n"
        + "  %14 = load_ptr %13: string\n"
        + "  %15 = str.len %14: long\n"
        + "  %16 = trunc %15: int\n"
        + "  %17 = slot_addr $2: &Holder  ; b\n"
        + "  %18 = field_addr %17, 0: &string  ; b.name\n"
        + "  release_ptr %18\n"
        + "  %19 = slot_addr $0: &Holder  ; a\n"
        + "  %20 = field_addr %19, 0: &string  ; a.name\n"
        + "  release_ptr %20\n"
        + "  ret %16\n"
        + "\}\n");
}

test "a struct temporary passed as an argument is released where the caller's scope ends" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    string name;\n"
        + "\}\n"
        + "takes(Holder h) -> long \{\n"
        + "    return h.name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return takes(\{name: \"a\"\}) as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 structlit: Holder zeroed\n"
        + "  $1 materialized: Holder zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $0: &Holder  ; structlit\n"
        + "  %1 = const \"a\": string\n"
        + "  %2 = field_addr %0, 0: &string  ; structlit.name\n"
        + "  retain %1\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = load_ptr %0: Holder\n"
        + "  store $1, %3\n"
        + "  %4 = slot_addr $1: &Holder  ; materialized\n"
        + "  %5 = load_ptr %4: Holder\n"
        + "  %6 = call @takes(%5): long\n"
        + "  %7 = trunc %6: int\n"
        + "  %8 = slot_addr $1: &Holder  ; materialized\n"
        + "  %9 = field_addr %8, 0: &string  ; materialized.name\n"
        + "  release_ptr %9\n"
        + "  ret %7\n"
        + "\}\n");
}

test "a struct parameter owns the references its copy holds for the call" {
    let dumped = try support.loweredDump(
        "struct Holder \{\n"
        + "    string name;\n"
        + "\}\n"
        + "takes(Holder h) -> long \{\n"
        + "    return h.name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return takes(\{name: \"a\"\}) as int;\n"
        + "\}\n", "takes");
    try testing.assertEqual(dumped,
        "func internal @takes(%0: Holder) -> long \{\n"
        + "  $0 h: Holder zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Holder  ; h\n"
        + "  %2 = field_addr %1, 0: &string  ; h.name\n"
        + "  retain_ptr %2\n"
        + "  %3 = slot_addr $0: &Holder  ; h\n"
        + "  %4 = field_addr %3, 0: &string  ; h.name\n"
        + "  %5 = load_ptr %4: string\n"
        + "  %6 = str.len %5: long\n"
        + "  %7 = slot_addr $0: &Holder  ; h\n"
        + "  %8 = field_addr %7, 0: &string  ; h.name\n"
        + "  release_ptr %8\n"
        + "  ret %6\n"
        + "\}\n");
}

test "a default reading an earlier sibling reads it out of the aggregate being filled" {
    let dumped = try support.loweredDump(
        "struct Rect \{\n"
        + "    int width = 4;\n"
        + "    int height = 5;\n"
        + "    protected int area = width * height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Rect r = \{\};\n"
        + "    return r.area;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 r: Rect zeroed\n"
        + "  $1 structlit: Rect zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Rect  ; structlit\n"
        + "  %1 = const 4: int\n"
        + "  %2 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = const 5: int\n"
        + "  %4 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = field_addr %0, 0: &int  ; structlit.width\n"
        + "  %6 = load_ptr %5: int\n"
        + "  %7 = field_addr %0, 1: &int  ; structlit.height\n"
        + "  %8 = load_ptr %7: int\n"
        + "  %9 = mul %6, %8: int\n"
        + "  %10 = field_addr %0, 2: &int  ; structlit.area\n"
        + "  store_ptr %10, %9\n"
        + "  %11 = load_ptr %0: Rect\n"
        + "  store $0, %11\n"
        + "  %12 = slot_addr $0: &Rect  ; r\n"
        + "  %13 = field_addr %12, 2: &int  ; r.area\n"
        + "  %14 = load_ptr %13: int\n"
        + "  ret %14\n"
        + "\}\n");
}

test "an allocated array of structs runs each slot through the element's defaults" {
    let dumped = try support.loweredDump(
        "struct Box \{\n"
        + "    protected int width = 20;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box[] boxes = new Box[3];\n"
        + "    return boxes[0].width;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("b2.fill.body:\n") >= 0,
        "the allocation should loop over the slots: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %7 = element_addr %2[%6]: &Box  ; %2[%6]\n") >= 0,
        "each slot should be reached by its element address: {dumped}");
    try testing.assertTrue(
        dumped.indexOf("  %9 = field_addr %7, 0: &int  ; %2[%6].width\n") >= 0,
        "the default should be written into the slot's field: {dumped}");
}

test "comparing two structs is reported as unsupported rather than compared as machine words" {
    let message = try support.loweringFailure(
        "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point a = \{x: 1\};\n"
        + "    Point b = \{x: 1\};\n"
        + "    if (a == b) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(
        message.indexOf("does not support comparing 'Point' with 'Point'") >= 0,
        "unexpected message: {message}");
}

test "a struct's JSON text is reported as unsupported" {
    let message = try support.loweringFailure(
        "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point a = \{x: 1\};\n"
        + "    print(a.toString());\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(
        message.indexOf("does not support converting 'Point' to text") >= 0,
        "unexpected message: {message}");
}
