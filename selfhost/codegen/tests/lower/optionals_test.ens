// Tagged value-type optionals: construction from a value and from null, the narrowing read that
// extracts a proven payload, the '??' and '?.' operators, and the generic 'V?' return that makes
// a map lookup work per instance.
import @std.testing;
import support;

test "a tagged optional builds from a value and from null, and narrows back to its payload" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int? n = 7;\n"
        + "    if (n != null) \{\n"
        + "        int narrowed = n;\n"
        + "        return narrowed;\n"
        + "    \}\n"
        + "    n = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the initializer should wrap 7 into the pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.present") >= 0,
        "the null test should read the tag: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload") >= 0,
        "the narrowed read should extract the payload: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "the null reassignment should store the absent pair: {dumped}");
}

test "null-coalescing takes the present payload and the fallback otherwise" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int? c = null;\n"
        + "    long chosen = c ?? 42;\n"
        + "    return chosen as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("coalesce.present") >= 0
        && dumped.indexOf("coalesce.absent") >= 0,
        "the coalesce should branch on presence: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload") >= 0,
        "the present path should extract the payload: {dumped}");
}

test "a safe member read guards on the receiver and wraps the value member" {
    let dumped = try support.loweredDump(
        "class Car \{\n"
        + "    protected int wheels;\n"
        + "    protected constructor(this.wheels = 4);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Car? car = new Car();\n"
        + "    int? wheels = car?.wheels;\n"
        + "    return wheels ?? 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("safe.present") >= 0
        && dumped.indexOf("safe.absent") >= 0,
        "the safe read should branch on the receiver: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the present member should wrap into the optional result: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "the absent path should produce the absent pair: {dumped}");
}

test "a borrowed optional-of-struct read from a class field retains through the field's address" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Cell? cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder(\{probe: new Probe()\});\n"
        + "    Cell? copied = holder.cell;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("load_ptr") >= 0,
        "the field read should load through the field's address: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.arc") >= 0,
        "the retain should guard on the pair's presence tag: {dumped}");
    try testing.assertTrue(dumped.indexOf("retain_ptr") >= 0,
        "the present payload's reference should be retained in place: {dumped}");
    try testing.assertTrue(dumped.indexOf("parked") < 0,
        "a field read has storage of its own and needs no parking: {dumped}");
}

test "a narrowed read of an optional-of-struct steps into the payload before loading" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell? cell = \{label: \"x\"\};\n"
        + "    if (cell != null) \{\n"
        + "        Cell present = cell;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    long unwrapped = dumped.indexOf("opt.payload_addr");
    try testing.assertTrue(unwrapped >= 0,
        "the narrowed read should project the payload's address: {dumped}");
    let afterUnwrap = dumped.substring(unwrapped, dumped.length);
    try testing.assertTrue(afterUnwrap.indexOf(": Cell\n") >= 0,
        "the load through the projected address should read the payload type: {dumped}");
    try testing.assertTrue(afterUnwrap.indexOf("retain_ptr") >= 0,
        "the copy should retain through the projected address: {dumped}");
}

test "a borrowed struct with no storage of its own is parked so its references can be retained" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell a = \{label: \"a\"\};\n"
        + "    Cell b = \{label: \"b\"\};\n"
        + "    Cell chosen = true ? a : b;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("parked: Cell borrowed") >= 0,
        "the merged value should be parked in a borrowing slot: {dumped}");
    long merged = dumped.indexOf("ternary.end");
    try testing.assertTrue(merged >= 0,
        "the arms should merge before the parking: {dumped}");
    let afterMerge = dumped.substring(merged, dumped.length);
    try testing.assertTrue(afterMerge.indexOf("retain_ptr") >= 0,
        "the retain should walk the parked storage: {dumped}");
}

test "a narrowed return retains the payload it hands out before the scopes release" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "lastOf(Cell? cell) -> Cell \{\n"
        + "    if (cell == null) \{\n"
        + "        return \{label: \"fallback\"\};\n"
        + "    \}\n"
        + "    return cell;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ignored = lastOf(null);\n"
        + "    return 0;\n"
        + "\}\n", "lastOf");
    long unwrapped = dumped.indexOf("opt.payload_addr");
    try testing.assertTrue(unwrapped >= 0,
        "the narrowed return should project the payload's address: {dumped}");
    let afterUnwrap = dumped.substring(unwrapped, dumped.length);
    long retained = afterUnwrap.indexOf("retain_ptr");
    try testing.assertTrue(retained >= 0,
        "the returned payload should be retained through the projected address: {dumped}");
    try testing.assertTrue(
        afterUnwrap.substring(retained, afterUnwrap.length).indexOf("release_ptr") >= 0,
        "the parameter's scope should release only after the retain: {dumped}");
}

test "a safe member read through an optional of a reference-holding struct owns its scratch copy" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell? maybe = \{label: \"x\"\};\n"
        + "    string? read = maybe?.label;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("safepayload") >= 0,
        "the present payload should be parked in the scratch slot: {dumped}");
    try testing.assertTrue(dumped.indexOf("retain_ptr") >= 0,
        "the scratch copy should retain the references the payload holds: {dumped}");
}

test "a generic lookup returning V? wraps its found value per instance" {
    string program =
        "class Store<V> \{\n"
        + "    V kept;\n"
        + "    protected constructor(this.kept);\n"
        + "    protected find(bool hit) -> V? \{\n"
        + "        if (hit) \{\n"
        + "            return this.kept;\n"
        + "        \}\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ints = new Store<int>(4);\n"
        + "    int? found = ints.find(true);\n"
        + "    return found ?? 0;\n"
        + "\}\n";
    let find = try support.loweredSymbolDump(program, "Store__int___find");
    try testing.assertTrue(find.indexOf("-> int?") >= 0,
        "the instance should return the tagged optional: {find}");
    try testing.assertTrue(find.indexOf("opt.wrap") >= 0,
        "the found value should wrap into 'int?': {find}");
    try testing.assertTrue(find.indexOf("opt.absent") >= 0,
        "the miss should return the absent 'int?': {find}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("call @Store__int___find(") >= 0,
        "the lookup should target the planned instance: {caller}");
    try testing.assertTrue(caller.indexOf("opt.payload") >= 0,
        "the coalesce should unwrap the found payload: {caller}");
}

test "a narrowed optional array is iterated, measured and indexed at its array type" {
    let dumped = try support.loweredDump(
        "maybe(bool present) -> string[]? \{\n"
        + "    if (present) \{\n"
        + "        return [\"one\"];\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string[]? found = maybe(true);\n"
        + "    if (found == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    long total = found.length;\n"
        + "    for (let name in found) \{\n"
        + "        total = total + name.length;\n"
        + "    \}\n"
        + "    return (total + found[0].length) as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("iterated: string[]") >= 0,
        "the loop should hold the narrowed value at its array type: {dumped}");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the narrowed reads should rename the reference to 'string[]': {dumped}");
    try testing.assertTrue(dumped.indexOf("foreach.body") >= 0,
        "the loop over the narrowed array should be lowered: {dumped}");
}

test "a generic lookup at a nullable argument answers a nested pair over its inner level" {
    string program =
        "class Store<V> \{\n"
        + "    V kept;\n"
        + "    protected constructor(this.kept);\n"
        + "    protected find(bool hit) -> V? \{\n"
        + "        if (hit) \{\n"
        + "            return this.kept;\n"
        + "        \}\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ints = new Store<int?>(4);\n"
        + "    let found = ints.find(true);\n"
        + "    if (found == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    int? inner = found;\n"
        + "    return inner ?? 0;\n"
        + "\}\n";
    let find = try support.loweredSymbolDump(program, "Store__opt_int___find");
    try testing.assertTrue(find.indexOf("-> int??") >= 0,
        "the instance should return the nested optional: {find}");
    try testing.assertTrue(find.indexOf("opt.wrap") >= 0,
        "the kept 'int?' should wrap once into 'int??': {find}");
    try testing.assertTrue(find.indexOf("opt.absent: int??") >= 0,
        "the miss should return the absent outer level: {find}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("found: int??") >= 0,
        "the local should hold the nested pair: {caller}");
    try testing.assertTrue(caller.indexOf("inner: int?") >= 0,
        "the narrowed read should land one level down: {caller}");
    try testing.assertTrue(caller.indexOf("opt.present") >= 0,
        "the null check should read the outer tag: {caller}");
    try testing.assertTrue(caller.indexOf("opt.payload") >= 0,
        "the narrowed read should peel the outer payload: {caller}");
}

test "a nested optional of a reference owns its payload through the outer tag" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "\}\n"
        + "class Store<V> \{\n"
        + "    V? kept;\n"
        + "    protected constructor(this.kept = null);\n"
        + "    protected value() -> V? \{\n"
        + "        return this.kept;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = new Store<Probe?>(new Probe(\"x\"));\n"
        + "    let kept = held.value();\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("kept: Probe??") >= 0,
        "the local should hold the nested pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the bare 'Probe' argument should wrap twice on its way to 'Probe??': {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.arc") >= 0,
        "releasing the local should test the outer tag first: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload_addr") >= 0,
        "the release should reach the payload through its address: {dumped}");
    try testing.assertTrue(dumped.indexOf("release_ptr") >= 0,
        "the payload's reference should be released: {dumped}");
}

test "comparing nested optional strings strips each level before the string comparison" {
    // Both verifiers run over the dump, so a payload reaching 'str.eq' still nullable fails here.
    let dumped = try support.loweredDump(
        "text(bool present) -> string?? \{\n"
        + "    if (present) \{\n"
        + "        return \"a\";\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    if (text(true) == text(false)) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.present") >= 0,
        "both outer tags should be read: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload") >= 0,
        "the outer payloads should be extracted: {dumped}");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the nullable payload should be renamed to a bare string first: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the payloads should compare by content: {dumped}");
}

test "a nested optional narrowed to its value compares at the type it narrowed to" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    string?? left = \"a\";\n"
        + "    string?? right = \"a\";\n"
        + "    if (left == right) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("left: string??") >= 0,
        "the storage should stay a nested pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the initializers proved both levels, so this is a plain string comparison: {dumped}");
}

test "'??' over a borrowed left of the result's own type stores a rename of it" {
    let dumped = try support.loweredDump(
        "class Cell \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick(Cell? given, Cell? fallback) -> Cell? \{\n"
        + "    return given ?? fallback;\n"
        + "\}\n"
        + "main() \{\}\n", "pick");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the present path should store a rename, not the left temp itself: {dumped}");
}

test "'??' over an owned left releases it on the absent path instead of renaming" {
    let dumped = try support.loweredDump(
        "class Cell \{\n"
        + "    protected constructor();\n"
        + "    protected copy() -> Cell? \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n"
        + "pick(Cell source, Cell? fallback) -> Cell? \{\n"
        + "    return source.copy() ?? fallback;\n"
        + "\}\n"
        + "main() \{\}\n", "pick");
    try testing.assertTrue(dumped.indexOf("release %") >= 0,
        "the absent path should give up the owned left: {dumped}");
}
