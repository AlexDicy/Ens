// Tagged value-type optionals: construction from a value and from null, the narrowing read that
// extracts a proven payload, the '??' and '?.' operators, and the generic 'V?' return that makes
// a map lookup work per instance.
import @std.testing;
import support;

test "a tagged optional builds from a value and from null, and narrows back to its payload" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int? n = 7;\n"
        + "    if (n != null) \{\n"
        + "        int narrowed = n;\n"
        + "        return narrowed;\n"
        + "    \}\n"
        + "    n = null;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the initializer should wrap 7 into the pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.present") >= 0,
        "the null test should read the tag: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload move") >= 0,
        "the narrowed read should take the payload over from the pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "the null reassignment should store the absent pair: {dumped}");
}

test "null-coalescing takes the present payload and the fallback otherwise" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int? c = null;\n"
        + "    long chosen = c ?? 42;\n"
        + "    return chosen as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("coalesce.present") >= 0 && dumped.indexOf("coalesce.absent") >= 0,
        "the coalesce should branch on presence: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload move") >= 0,
        "the present path should take the payload over from the left: {dumped}");
}

test "a safe member read guards on the receiver and wraps the value member" {
    let dumped = try support.loweredDump(
        "class Car \{\n"
        + "    protected int wheels;\n"
        + "    protected constructor(this.wheels = 4);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Car? car = new Car();\n"
        + "    int? wheels = car?.wheels;\n"
        + "    return wheels ?? 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("safe.present") >= 0 && dumped.indexOf("safe.absent") >= 0,
        "the safe read should branch on the receiver: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the present member should wrap into the optional result: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.absent") >= 0,
        "the absent path should produce the absent pair: {dumped}");
}

test "a borrowed optional-of-struct read from a class field retains through the field's address" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Cell? cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder(\{probe: new Probe()\});\n"
        + "    Cell? copied = holder.cell;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("load_ptr") >= 0,
        "the field read should load through the field's address: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.arc") >= 0,
        "the retain should guard on the pair's presence tag: {dumped}");
    try testing.assertTrue(dumped.indexOf("retain_ptr") >= 0,
        "the present payload's reference should be retained in place: {dumped}");
    try testing.assertTrue(dumped.indexOf("parked") < 0,
        "a field read has storage of its own and needs no parking: {dumped}");
}

test "a narrowed read of an optional-of-struct steps into the payload before loading" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell? cell = \{label: \"x\"\};\n"
        + "    if (cell != null) \{\n"
        + "        Cell present = cell;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    long unwrapped = dumped.indexOf("opt.payload_addr");
    try testing.assertTrue(unwrapped >= 0,
        "the narrowed read should project the payload's address: {dumped}");
    let afterUnwrap = dumped.substring(unwrapped, dumped.length);
    try testing.assertTrue(afterUnwrap.indexOf(": Cell\n") >= 0,
        "the load through the projected address should read the payload type: {dumped}");
    try testing.assertTrue(afterUnwrap.indexOf("retain_ptr") >= 0,
        "the copy should retain through the projected address: {dumped}");
}

test "a borrowed struct with no storage of its own is parked so its references can be retained" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Cell cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Holder? holder = new Holder(\{label: \"a\"\});\n"
        + "    Cell? chosen = holder?.cell;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    long parked = dumped.indexOf("parked: Cell? borrowed");
    try testing.assertTrue(parked >= 0,
        "the field read on the present path should be parked in a borrowing slot: {dumped}");
    long present = dumped.indexOf("safe.present:");
    try testing.assertTrue(present >= 0, "the read should run on the present path: {dumped}");
    let afterRead = dumped.substring(present, dumped.length);
    try testing.assertTrue(afterRead.indexOf("retain_ptr") >= 0,
        "the retain should walk the parked storage: {dumped}");
}

test "a borrowed optional with no storage of its own is retained as the value it returns" {
    let dumped = try support.loweredDump(
        "text() -> string?? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string? inner = text() ?? null;\n"
        + "    if (inner == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "text");
    try testing.assertEqual(dumped,
        "func internal @main$text() -> string?? \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"a\": string\n"
        + "  %1 = reinterpret %0: string?\n"
        + "  %2 = opt.wrap %1: string??\n"
        + "  retain %2\n"
        + "  ret %2\n"
        + "\}\n");
}

test "a narrowed return retains the payload it returns before the scopes release" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "lastOf(Cell? cell) -> Cell \{\n"
        + "    if (cell == null) \{\n"
        + "        return \{label: \"fallback\"\};\n"
        + "    \}\n"
        + "    return cell;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ignored = lastOf(null);\n"
        + "    return 0;\n"
        + "\}\n", "lastOf");
    long unwrapped = dumped.indexOf("opt.payload_addr");
    try testing.assertTrue(unwrapped >= 0,
        "the narrowed return should project the payload's address: {dumped}");
    let afterUnwrap = dumped.substring(unwrapped, dumped.length);
    long retained = afterUnwrap.indexOf("retain_ptr");
    try testing.assertTrue(retained >= 0,
        "the returned payload should be retained through the projected address: {dumped}");
    try testing.assertTrue(
        afterUnwrap.substring(retained, afterUnwrap.length).indexOf("release_ptr") >= 0,
        "the parameter's scope should release only after the retain: {dumped}");
}

test "a safe member read through a borrowed optional struct reads the payload where it is" {
    let dumped = try support.loweredDump(
        "struct Cell \{\n"
        + "    protected string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell? maybe = \{label: \"x\"\};\n"
        + "    string? read = maybe?.label;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 maybe: Cell? zeroed\n"
        + "  $1 structlit: Cell\n"
        + "  $2 read: string? zeroed\n"
        + "  $3 safe: string?\n"
        + "  $4 payload: Cell borrowed\n"
        + "b0.entry:\n"
        + "  %0 = zero: Cell\n"
        + "  store $1, %0\n"
        + "  %1 = slot_addr $1: &Cell  ; structlit\n"
        + "  %2 = const \"x\": string\n"
        + "  %3 = field_addr %1, 0: &string  ; structlit.label\n"
        + "  retain %2\n"
        + "  store_ptr %3, %2\n"
        + "  %4 = take $1: Cell\n"
        + "  %5 = opt.wrap %4: Cell?\n"
        + "  store $0, %5\n"
        + "  %6 = load $0: Cell?\n"
        + "  %7 = opt.present %6: bool\n"
        + "  br %7, b1.safe.present, b2.safe.absent\n"
        + "b1.safe.present:\n"
        + "  %8 = opt.payload borrow %6: Cell\n"
        + "  store $4, %8\n"
        + "  %9 = slot_addr $4: &Cell  ; payload\n"
        + "  %10 = field_addr %9, 0: &string  ; payload.label\n"
        + "  %11 = load_ptr %10: string\n"
        + "  %12 = reinterpret %11: string?\n"
        + "  retain %12\n"
        + "  store $3, %12\n"
        + "  jump b3.safe.end\n"
        + "b2.safe.absent:\n"
        + "  %13 = const null: string?\n"
        + "  retain %13\n"
        + "  store $3, %13\n"
        + "  jump b3.safe.end\n"
        + "b3.safe.end:\n"
        + "  %14 = take $3: string?\n"
        + "  store $2, %14\n"
        + "  %15 = const 0: int\n"
        + "  %16 = slot_addr $2: &string?  ; read\n"
        + "  release_ptr %16\n"
        + "  %17 = slot_addr $0: &Cell?  ; maybe\n"
        + "  %18 = load_ptr %17: Cell?\n"
        + "  %19 = opt.present %18: bool\n"
        + "  br %19, b4.opt.arc, b5.opt.arc.end\n"
        + "b4.opt.arc:\n"
        + "  %20 = opt.payload_addr %17: &Cell\n"
        + "  %21 = field_addr %20, 0: &string  ; maybe.payload.label\n"
        + "  release_ptr %21\n"
        + "  jump b5.opt.arc.end\n"
        + "b5.opt.arc.end:\n"
        + "  ret %15\n"
        + "\}\n");
}

test "a safe member read through a reference a call produced releases it where the access ends" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected string label = \"p\";\n"
        + "\}\n"
        + "probe() -> Probe? \{\n"
        + "    return new Probe();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string? read = probe()?.label;\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 read: string? zeroed\n"
        + "  $1 safe: string?\n"
        + "b0.entry:\n"
        + "  %0 = call @main$probe(): Probe?\n"
        + "  %1 = const null: Probe?\n"
        + "  %2 = cmp.ne %0, %1: bool\n"
        + "  br %2, b1.safe.present, b2.safe.absent\n"
        + "b1.safe.present:\n"
        + "  %3 = object_field_addr %0, 0: &string  ; %0.label\n"
        + "  %4 = load_ptr %3: string\n"
        + "  %5 = reinterpret %4: string?\n"
        + "  retain %5\n"
        + "  store $1, %5\n"
        + "  jump b3.safe.end\n"
        + "b2.safe.absent:\n"
        + "  %6 = const null: string?\n"
        + "  retain %6\n"
        + "  store $1, %6\n"
        + "  jump b3.safe.end\n"
        + "b3.safe.end:\n"
        + "  %7 = take $1: string?\n"
        + "  release %0\n"
        + "  store $0, %7\n"
        + "  %8 = const 0: int\n"
        + "  %9 = slot_addr $0: &string?  ; read\n"
        + "  release_ptr %9\n"
        + "  ret %8\n"
        + "\}\n");
}

test "'??' moves its merged value out of its slot, so the call it is passed to releases it" {
    let dumped = try support.loweredDump(
        "class Probe \{\}\n"
        + "show(Probe probe) \{\}\n"
        + "main() -> int \{\n"
        + "    Probe? maybe = null;\n"
        + "    Probe other = new Probe();\n"
        + "    show(maybe ?? other);\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 maybe: Probe? zeroed\n"
        + "  $1 other: Probe zeroed\n"
        + "  $2 coalesce: Probe\n"
        + "b0.entry:\n"
        + "  %0 = const null: null\n"
        + "  %1 = reinterpret %0: Probe?\n"
        + "  retain %1\n"
        + "  store $0, %1\n"
        + "  %2 = class.new @_dtor$main$Probe: Probe\n"
        + "  store $1, %2\n"
        + "  %3 = load $0: Probe?\n"
        + "  %4 = const null: Probe?\n"
        + "  %5 = cmp.ne %3, %4: bool\n"
        + "  br %5, b1.coalesce.present, b2.coalesce.absent\n"
        + "b1.coalesce.present:\n"
        + "  %6 = reinterpret %3: Probe\n"
        + "  retain %6\n"
        + "  store $2, %6\n"
        + "  jump b3.coalesce.end\n"
        + "b2.coalesce.absent:\n"
        + "  %7 = load $1: Probe\n"
        + "  retain %7\n"
        + "  store $2, %7\n"
        + "  jump b3.coalesce.end\n"
        + "b3.coalesce.end:\n"
        + "  %8 = take $2: Probe\n"
        + "  call @main$show(%8)\n"
        + "  release %8\n"
        + "  %9 = const 0: int\n"
        + "  %10 = slot_addr $1: &Probe  ; other\n"
        + "  release_ptr %10\n"
        + "  %11 = slot_addr $0: &Probe?  ; maybe\n"
        + "  release_ptr %11\n"
        + "  ret %9\n"
        + "\}\n");
}

test "a generic lookup returning V? wraps its found value per instance" {
    string program =
        "class Store<V> \{\n"
        + "    V kept;\n"
        + "    protected constructor(this.kept);\n"
        + "    protected find(bool hit) -> V? \{\n"
        + "        if (hit) \{\n"
        + "            return this.kept;\n"
        + "        \}\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ints = new Store<int>(4);\n"
        + "    int? found = ints.find(true);\n"
        + "    return found ?? 0;\n"
        + "\}\n";
    let find = try support.loweredSymbolDump(program, "main$Store__int___find");
    try testing.assertTrue(find.indexOf("-> int?") >= 0,
        "the instance should return the tagged optional: {find}");
    try testing.assertTrue(find.indexOf("opt.wrap") >= 0,
        "the found value should wrap into 'int?': {find}");
    try testing.assertTrue(find.indexOf("opt.absent") >= 0,
        "the miss should return the absent 'int?': {find}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("call @main$Store__int___find(") >= 0,
        "the lookup should target the planned instance: {caller}");
    try testing.assertTrue(caller.indexOf("opt.payload") >= 0,
        "the coalesce should unwrap the found payload: {caller}");
}

test "a narrowed optional array is iterated, measured and indexed at its array type" {
    let dumped = try support.loweredDump(
        "maybe(bool present) -> string[]? \{\n"
        + "    if (present) \{\n"
        + "        return [\"one\"];\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string[]? found = maybe(true);\n"
        + "    if (found == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    long total = found.length;\n"
        + "    for (let name in found) \{\n"
        + "        total = total + name.length;\n"
        + "    \}\n"
        + "    return (total + found[0].length) as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("iterated: string[]") >= 0,
        "the loop should hold the narrowed value at its array type: {dumped}");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the narrowed reads should rename the reference to 'string[]': {dumped}");
    try testing.assertTrue(dumped.indexOf("foreach.body") >= 0,
        "the loop over the narrowed array should be lowered: {dumped}");
}

test "a generic lookup at a nullable argument returns a nested pair over its inner level" {
    string program =
        "class Store<V> \{\n"
        + "    V kept;\n"
        + "    protected constructor(this.kept);\n"
        + "    protected find(bool hit) -> V? \{\n"
        + "        if (hit) \{\n"
        + "            return this.kept;\n"
        + "        \}\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ints = new Store<int?>(4);\n"
        + "    let found = ints.find(true);\n"
        + "    if (found == null) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    int? inner = found;\n"
        + "    return inner ?? 0;\n"
        + "\}\n";
    let find = try support.loweredSymbolDump(program, "main$Store__opt_int___find");
    try testing.assertTrue(find.indexOf("-> int??") >= 0,
        "the instance should return the nested optional: {find}");
    try testing.assertTrue(find.indexOf("opt.wrap") >= 0,
        "the kept 'int?' should wrap once into 'int??': {find}");
    try testing.assertTrue(find.indexOf("opt.absent: int??") >= 0,
        "the miss should return the absent outer level: {find}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("found: int??") >= 0,
        "the local should hold the nested pair: {caller}");
    try testing.assertTrue(caller.indexOf("inner: int?") >= 0,
        "the narrowed read should land one level down: {caller}");
    try testing.assertTrue(caller.indexOf("opt.present") >= 0,
        "the null check should read the outer tag: {caller}");
    try testing.assertTrue(caller.indexOf("opt.payload") >= 0,
        "the narrowed read should peel the outer payload: {caller}");
}

test "a nested optional of a reference owns its payload through the outer tag" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "\}\n"
        + "class Store<V> \{\n"
        + "    V? kept;\n"
        + "    protected constructor(this.kept = null);\n"
        + "    protected value() -> V? \{\n"
        + "        return this.kept;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = new Store<Probe?>(new Probe(\"x\"));\n"
        + "    let kept = held.value();\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("kept: Probe??") >= 0,
        "the local should hold the nested pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.wrap") >= 0,
        "the bare 'Probe' argument should wrap twice on its way to 'Probe??': {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.arc") >= 0,
        "releasing the local should test the outer tag first: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload_addr") >= 0,
        "the release should reach the payload through its address: {dumped}");
    try testing.assertTrue(dumped.indexOf("release_ptr") >= 0,
        "the payload's reference should be released: {dumped}");
}

test "comparing nested optional strings strips each level before the string comparison" {
    // Both verifiers run over the dump, so a payload reaching 'str.eq' still nullable fails here.
    let dumped = try support.loweredDump(
        "text(bool present) -> string?? \{\n"
        + "    if (present) \{\n"
        + "        return \"a\";\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    if (text(true) == text(false)) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opt.present") >= 0,
        "both outer tags should be read: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload borrow") >= 0,
        "the outer payloads should be borrowed from their pairs: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload move") < 0,
        "a comparison should leave every pair holding what it held: {dumped}");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the nullable payload should be renamed to a bare string first: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the payloads should compare by content: {dumped}");
}

test "a nested optional narrowed to its value compares at the type it narrowed to" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    string?? left = \"a\";\n"
        + "    string?? right = \"a\";\n"
        + "    if (left == right) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("left: string??") >= 0,
        "the storage should stay a nested pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the initializers proved both levels, so this is a plain string comparison: {dumped}");
}

test "'??' over a borrowed left of the result's own type stores a rename of it" {
    let dumped = try support.loweredDump(
        "class Cell \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick(Cell? given, Cell? fallback) -> Cell? \{\n"
        + "    return given ?? fallback;\n"
        + "\}\n"
        + "main() \{\}\n", "pick");
    try testing.assertTrue(dumped.indexOf("reinterpret") >= 0,
        "the present path should store a rename, not the left temp itself: {dumped}");
}

test "'??' over an owned left releases it on the absent path instead of renaming" {
    let dumped = try support.loweredDump(
        "class Cell \{\n"
        + "    protected constructor();\n"
        + "    protected copy() -> Cell? \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n"
        + "pick(Cell source, Cell? fallback) -> Cell? \{\n"
        + "    return source.copy() ?? fallback;\n"
        + "\}\n"
        + "main() \{\}\n", "pick");
    try testing.assertTrue(dumped.indexOf("release %") >= 0,
        "the absent path should give up the owned left: {dumped}");
}

test "'==' over produced optional structs releases both operands once it has the result" {
    let dumped = try support.loweredDump(producedCells()
        + "same() -> bool \{\n"
        + "    return made() == made();\n"
        + "\}\n"
        + "main() \{\}\n", "same");
    try testing.assertEqual(countOccurrences(dumped, "released: Cell?"), 2L);
    try testing.assertEqual(countOccurrences(dumped, "payload: Cell borrowed"), 2L);
    try testing.assertEqual(countOccurrences(dumped, "retain"), 0L);
    let againstNull = try support.loweredDump(producedCells()
        + "absent() -> bool \{\n"
        + "    return made() == null;\n"
        + "\}\n"
        + "main() \{\}\n", "absent");
    try testing.assertEqual(countOccurrences(againstNull, "released: Cell?"), 1L);
}

test "'?.' on a produced optional struct moves its payload into a copy released after the call" {
    let dumped = try support.loweredDump(producedCells()
        + "named() -> string? \{\n"
        + "    return made()?.name();\n"
        + "\}\n"
        + "main() \{\}\n", "named");
    try testing.assertEqual(dumped,
        "func internal @main$named() -> string? \{\n"
        + "  $0 safecall: string?\n"
        + "  $1 safepayload: Cell\n"
        + "b0.entry:\n"
        + "  %0 = call @main$made(): Cell?\n"
        + "  %1 = opt.present %0: bool\n"
        + "  br %1, b1.safecall.present, b2.safecall.absent\n"
        + "b1.safecall.present:\n"
        + "  %2 = opt.payload move %0: Cell\n"
        + "  store $1, %2\n"
        + "  %3 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %4 = call @main$Cell$name(this %3): string\n"
        + "  %5 = reinterpret %4: string?\n"
        + "  store $0, %5\n"
        + "  %6 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %7 = field_addr %6, 0: &Probe  ; safepayload.probe\n"
        + "  release_ptr %7\n"
        + "  jump b3.safecall.end\n"
        + "b2.safecall.absent:\n"
        + "  %8 = const null: string?\n"
        + "  retain %8\n"
        + "  store $0, %8\n"
        + "  jump b3.safecall.end\n"
        + "b3.safecall.end:\n"
        + "  %9 = take $0: string?\n"
        + "  ret %9\n"
        + "\}\n");
}

// '++' on a location declared optional steps the value under the optional level and wraps the
// result back into the declared storage, the way a compound assignment on the same location does.
test "'++' on a narrowed optional steps its payload and stores the pair back" {
    let dumped = try support.loweredDump(
        "step() \{\n"
        + "    int? counter = 5;\n"
        + "    counter++;\n"
        + "    int? other = 5;\n"
        + "    (other)++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    step();\n"
        + "    return 0;\n"
        + "\}\n", "step");
    try testing.assertTrue(dumped.indexOf("counter: int?") >= 0, "the storage should stay a pair: {dumped}");
    try testing.assertTrue(dumped.indexOf("const 1: int\n") >= 0,
        "the step should be an 'int' one rather than an 'int?' one: {dumped}");
    try testing.assertTrue(dumped.indexOf("const 1: int?") < 0,
        "no constant should carry the optional type: {dumped}");
    try testing.assertEqual(countOccurrences(dumped, "opt.payload"), 2L);
    try testing.assertEqual(countOccurrences(dumped, "opt.wrap"), 4L);
}

// A 'mutating' method called through '?.' changes the optional struct where it is kept. Nothing
// but an argument can write a local while the call runs, so the call runs over the payload in the
// local's own storage.
test "a 'mutating' method through '?.' on a local runs over the payload where the local keeps it" {
    let dumped = try support.loweredDump(storedCells()
        + "bumped(Cell? cell) \{\n"
        + "    cell?.bump();\n"
        + "\}\n"
        + "main() \{\}\n", "bumped");
    try testing.assertEqual(dumped,
        "func internal @main$bumped(%0: Cell?) -> void \{\n"
        + "  $0 cell: Cell? zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Cell?  ; cell\n"
        + "  %2 = load_ptr %1: Cell?\n"
        + "  %3 = opt.present %2: bool\n"
        + "  br %3, b1.opt.arc, b2.opt.arc.end\n"
        + "b1.opt.arc:\n"
        + "  %4 = opt.payload_addr %1: &Cell\n"
        + "  %5 = field_addr %4, 0: &Probe  ; cell.payload.probe\n"
        + "  retain_ptr %5\n"
        + "  jump b2.opt.arc.end\n"
        + "b2.opt.arc.end:\n"
        + "  %6 = slot_addr $0: &Cell?  ; cell\n"
        + "  %7 = load_ptr %6: Cell?\n"
        + "  %8 = opt.present %7: bool\n"
        + "  br %8, b4.safecall.link, b3.safecall.absent\n"
        + "b3.safecall.absent:\n"
        + "  jump b5.safecall.end\n"
        + "b4.safecall.link:\n"
        + "  %9 = opt.payload_addr %6: &Cell\n"
        + "  call @main$Cell$bump(this %9)\n"
        + "  jump b5.safecall.end\n"
        + "b5.safecall.end:\n"
        + "  %10 = slot_addr $0: &Cell?  ; cell\n"
        + "  %11 = load_ptr %10: Cell?\n"
        + "  %12 = opt.present %11: bool\n"
        + "  br %12, b6.opt.arc, b7.opt.arc.end\n"
        + "b6.opt.arc:\n"
        + "  %13 = opt.payload_addr %10: &Cell\n"
        + "  %14 = field_addr %13, 0: &Probe  ; cell.payload.probe\n"
        + "  release_ptr %14\n"
        + "  jump b7.opt.arc.end\n"
        + "b7.opt.arc.end:\n"
        + "  ret\n"
        + "\}\n");
}

// The code a call runs may set a field to null, which would leave the method changing a value that
// is gone, so the call runs over a copy, and the copy is stored back while the field holds a value.
test "a 'mutating' method through '?.' on a field runs over a copy stored back while one is there" {
    let dumped = try support.loweredDump(storedCells()
        + "class Holder \{\n"
        + "    protected Cell? cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "counted(Holder holder) -> long? \{\n"
        + "    return holder.cell?.next();\n"
        + "\}\n"
        + "main() \{\}\n", "counted");
    try testing.assertEqual(dumped,
        "func internal @main$counted(%0: Holder) -> long? \{\n"
        + "  $0 holder: Holder borrowed\n"
        + "  $1 safepayload: Cell\n"
        + "  $2 released: Cell\n"
        + "  $3 safecall: long?\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Holder\n"
        + "  %2 = object_field_addr %1, 0: &Cell?  ; %1.cell\n"
        + "  %3 = load_ptr %2: Cell?\n"
        + "  %4 = opt.present %3: bool\n"
        + "  br %4, b2.safecall.link, b1.safecall.absent\n"
        + "b1.safecall.absent:\n"
        + "  %20 = opt.absent: long?\n"
        + "  store $3, %20\n"
        + "  jump b6.safecall.end\n"
        + "b2.safecall.link:\n"
        + "  %5 = opt.payload_addr %2: &Cell\n"
        + "  %6 = load_ptr %5: Cell\n"
        + "  %7 = field_addr %5, 0: &Probe  ; %1.cell.payload.probe\n"
        + "  retain_ptr %7\n"
        + "  store $1, %6\n"
        + "  %8 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %9 = call @main$Cell$next(this %8): long\n"
        + "  %10 = load_ptr %2: Cell?\n"
        + "  %11 = opt.present %10: bool\n"
        + "  br %11, b3.storeback, b4.storeback.dropped\n"
        + "b3.storeback:\n"
        + "  %12 = opt.payload_addr %2: &Cell\n"
        + "  %13 = take $1: Cell\n"
        + "  %14 = take_ptr %12: Cell\n"
        + "  store_ptr %12, %13\n"
        + "  store $2, %14\n"
        + "  %15 = slot_addr $2: &Cell  ; released\n"
        + "  %16 = field_addr %15, 0: &Probe  ; released.probe\n"
        + "  release_ptr %16\n"
        + "  jump b5.storeback.end\n"
        + "b4.storeback.dropped:\n"
        + "  %17 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %18 = field_addr %17, 0: &Probe  ; safepayload.probe\n"
        + "  release_ptr %18\n"
        + "  jump b5.storeback.end\n"
        + "b5.storeback.end:\n"
        + "  %19 = opt.wrap %9: long?\n"
        + "  store $3, %19\n"
        + "  jump b6.safecall.end\n"
        + "b6.safecall.end:\n"
        + "  %21 = load $3: long?\n"
        + "  ret %21\n"
        + "\}\n");
}

// A method that throws leaves the changes it made before the throw, so the unwind edge stores the
// copy back the way the return does.
test "a throwing 'mutating' method through '?.' on a field stores its copy back on the unwind too" {
    let dumped = try support.loweredDump(storedCells()
        + "class Holder \{\n"
        + "    protected Cell? cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "failed(Holder holder) throws \{\n"
        + "    try holder.cell?.fail();\n"
        + "\}\n"
        + "main() \{\}\n", "failed");
    try testing.assertEqual(dumped,
        "func internal @main$failed(%0: Holder) -> void throws \{\n"
        + "  $0 holder: Holder borrowed\n"
        + "  $1 safepayload: Cell\n"
        + "  $2 released: Cell\n"
        + "  $3 released: Cell\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Holder\n"
        + "  %2 = object_field_addr %1, 0: &Cell?  ; %1.cell\n"
        + "  %3 = load_ptr %2: Cell?\n"
        + "  %4 = opt.present %3: bool\n"
        + "  br %4, b2.safecall.link, b1.safecall.absent\n"
        + "b1.safecall.absent:\n"
        + "  jump b11.safecall.end\n"
        + "b2.safecall.link:\n"
        + "  %5 = opt.payload_addr %2: &Cell\n"
        + "  %6 = load_ptr %5: Cell\n"
        + "  %7 = field_addr %5, 0: &Probe  ; %1.cell.payload.probe\n"
        + "  retain_ptr %7\n"
        + "  store $1, %6\n"
        + "  %8 = slot_addr $1: &Cell  ; safepayload\n"
        + "  try_call @main$Cell$fail(this %8), error %9, to b3.try.ok, unwind b4.try.unwind\n"
        + "b3.try.ok:\n"
        + "  %19 = load_ptr %2: Cell?\n"
        + "  %20 = opt.present %19: bool\n"
        + "  br %20, b8.storeback, b9.storeback.dropped\n"
        + "b4.try.unwind:\n"
        + "  %10 = load_ptr %2: Cell?\n"
        + "  %11 = opt.present %10: bool\n"
        + "  br %11, b5.storeback, b6.storeback.dropped\n"
        + "b5.storeback:\n"
        + "  %12 = opt.payload_addr %2: &Cell\n"
        + "  %13 = take $1: Cell\n"
        + "  %14 = take_ptr %12: Cell\n"
        + "  store_ptr %12, %13\n"
        + "  store $2, %14\n"
        + "  %15 = slot_addr $2: &Cell  ; released\n"
        + "  %16 = field_addr %15, 0: &Probe  ; released.probe\n"
        + "  release_ptr %16\n"
        + "  jump b7.storeback.end\n"
        + "b6.storeback.dropped:\n"
        + "  %17 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %18 = field_addr %17, 0: &Probe  ; safepayload.probe\n"
        + "  release_ptr %18\n"
        + "  jump b7.storeback.end\n"
        + "b7.storeback.end:\n"
        + "  propagate %9\n"
        + "b8.storeback:\n"
        + "  %21 = opt.payload_addr %2: &Cell\n"
        + "  %22 = take $1: Cell\n"
        + "  %23 = take_ptr %21: Cell\n"
        + "  store_ptr %21, %22\n"
        + "  store $3, %23\n"
        + "  %24 = slot_addr $3: &Cell  ; released\n"
        + "  %25 = field_addr %24, 0: &Probe  ; released.probe\n"
        + "  release_ptr %25\n"
        + "  jump b10.storeback.end\n"
        + "b9.storeback.dropped:\n"
        + "  %26 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %27 = field_addr %26, 0: &Probe  ; safepayload.probe\n"
        + "  release_ptr %27\n"
        + "  jump b10.storeback.end\n"
        + "b10.storeback.end:\n"
        + "  jump b11.safecall.end\n"
        + "b11.safecall.end:\n"
        + "  ret\n"
        + "\}\n");
}

// A chain of '?.' reaches the storage of each struct inside the one before it, checking each tag.
test "a 'mutating' method through a chain of '?.' checks every link before it runs in place" {
    let dumped = try support.loweredDump(storedCells()
        + "struct Shelf \{\n"
        + "    protected Cell? cell;\n"
        + "\}\n"
        + "bumped(Shelf? shelf) \{\n"
        + "    shelf?.cell?.bump();\n"
        + "\}\n"
        + "main() \{\}\n", "bumped");
    try testing.assertEqual(dumped,
        "func internal @main$bumped(%0: Shelf?) -> void \{\n"
        + "  $0 shelf: Shelf? zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Shelf?  ; shelf\n"
        + "  %2 = load_ptr %1: Shelf?\n"
        + "  %3 = opt.present %2: bool\n"
        + "  br %3, b1.opt.arc, b2.opt.arc.end\n"
        + "b1.opt.arc:\n"
        + "  %4 = opt.payload_addr %1: &Shelf\n"
        + "  %5 = field_addr %4, 0: &Cell?  ; shelf.payload.cell\n"
        + "  %6 = load_ptr %5: Cell?\n"
        + "  %7 = opt.present %6: bool\n"
        + "  br %7, b3.opt.arc, b4.opt.arc.end\n"
        + "b2.opt.arc.end:\n"
        + "  %10 = slot_addr $0: &Shelf?  ; shelf\n"
        + "  %11 = load_ptr %10: Shelf?\n"
        + "  %12 = opt.present %11: bool\n"
        + "  br %12, b6.safecall.link, b5.safecall.absent\n"
        + "b3.opt.arc:\n"
        + "  %8 = opt.payload_addr %5: &Cell\n"
        + "  %9 = field_addr %8, 0: &Probe  ; shelf.payload.cell.payload.probe\n"
        + "  retain_ptr %9\n"
        + "  jump b4.opt.arc.end\n"
        + "b4.opt.arc.end:\n"
        + "  jump b2.opt.arc.end\n"
        + "b5.safecall.absent:\n"
        + "  jump b8.safecall.end\n"
        + "b6.safecall.link:\n"
        + "  %13 = opt.payload_addr %10: &Shelf\n"
        + "  %14 = field_addr %13, 0: &Cell?  ; shelf.payload.cell\n"
        + "  %15 = load_ptr %14: Cell?\n"
        + "  %16 = opt.present %15: bool\n"
        + "  br %16, b7.safecall.link, b5.safecall.absent\n"
        + "b7.safecall.link:\n"
        + "  %17 = opt.payload_addr %14: &Cell\n"
        + "  call @main$Cell$bump(this %17)\n"
        + "  jump b8.safecall.end\n"
        + "b8.safecall.end:\n"
        + "  %18 = slot_addr $0: &Shelf?  ; shelf\n"
        + "  %19 = load_ptr %18: Shelf?\n"
        + "  %20 = opt.present %19: bool\n"
        + "  br %20, b9.opt.arc, b10.opt.arc.end\n"
        + "b9.opt.arc:\n"
        + "  %21 = opt.payload_addr %18: &Shelf\n"
        + "  %22 = field_addr %21, 0: &Cell?  ; shelf.payload.cell\n"
        + "  %23 = load_ptr %22: Cell?\n"
        + "  %24 = opt.present %23: bool\n"
        + "  br %24, b11.opt.arc, b12.opt.arc.end\n"
        + "b10.opt.arc.end:\n"
        + "  ret\n"
        + "b11.opt.arc:\n"
        + "  %25 = opt.payload_addr %22: &Cell\n"
        + "  %26 = field_addr %25, 0: &Probe  ; shelf.payload.cell.payload.probe\n"
        + "  release_ptr %26\n"
        + "  jump b12.opt.arc.end\n"
        + "b12.opt.arc.end:\n"
        + "  jump b10.opt.arc.end\n"
        + "\}\n");
}

// An argument may set the local to null, so its presence is checked again once the arguments have
// run, and the method runs in place only while the local still holds a value. The path that skips
// the call releases what the arguments made, as the call's own path does.
test "a 'mutating' method through '?.' on a local checks it again after the arguments run" {
    let dumped = try support.loweredDump(storedCells()
        + "held(Cell? cell) \{\n"
        + "    cell?.hold(new Probe());\n"
        + "\}\n"
        + "main() \{\}\n", "held");
    try testing.assertEqual(dumped,
        "func internal @main$held(%0: Cell?) -> void \{\n"
        + "  $0 cell: Cell? zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Cell?  ; cell\n"
        + "  %2 = load_ptr %1: Cell?\n"
        + "  %3 = opt.present %2: bool\n"
        + "  br %3, b1.opt.arc, b2.opt.arc.end\n"
        + "b1.opt.arc:\n"
        + "  %4 = opt.payload_addr %1: &Cell\n"
        + "  %5 = field_addr %4, 0: &Probe  ; cell.payload.probe\n"
        + "  retain_ptr %5\n"
        + "  jump b2.opt.arc.end\n"
        + "b2.opt.arc.end:\n"
        + "  %6 = slot_addr $0: &Cell?  ; cell\n"
        + "  %7 = load_ptr %6: Cell?\n"
        + "  %8 = opt.present %7: bool\n"
        + "  br %8, b4.safecall.link, b3.safecall.absent\n"
        + "b3.safecall.absent:\n"
        + "  jump b7.safecall.end\n"
        + "b4.safecall.link:\n"
        + "  %9 = opt.payload_addr %6: &Cell\n"
        + "  %10 = class.new @_dtor$main$Probe: Probe\n"
        + "  call @main$Probe$constructor(this %10)\n"
        + "  %11 = load_ptr %6: Cell?\n"
        + "  %12 = opt.present %11: bool\n"
        + "  br %12, b6.safecall.link, b5.safecall.cleared\n"
        + "b5.safecall.cleared:\n"
        + "  release %10\n"
        + "  jump b3.safecall.absent\n"
        + "b6.safecall.link:\n"
        + "  call @main$Cell$hold(this %9, %10)\n"
        + "  release %10\n"
        + "  jump b7.safecall.end\n"
        + "b7.safecall.end:\n"
        + "  %13 = slot_addr $0: &Cell?  ; cell\n"
        + "  %14 = load_ptr %13: Cell?\n"
        + "  %15 = opt.present %14: bool\n"
        + "  br %15, b8.opt.arc, b9.opt.arc.end\n"
        + "b8.opt.arc:\n"
        + "  %16 = opt.payload_addr %13: &Cell\n"
        + "  %17 = field_addr %16, 0: &Probe  ; cell.payload.probe\n"
        + "  release_ptr %17\n"
        + "  jump b9.opt.arc.end\n"
        + "b9.opt.arc.end:\n"
        + "  ret\n"
        + "\}\n");
}

// The copy a call on a field runs over is taken once the arguments have run and the field still
// holds a value, so a change an argument makes to the field is not undone.
test "a 'mutating' method through '?.' on a field is copied once the arguments have run" {
    let dumped = try support.loweredDump(storedCells()
        + "class Holder \{\n"
        + "    protected Cell? cell;\n"
        + "    protected constructor(this.cell);\n"
        + "\}\n"
        + "added(Holder holder) \{\n"
        + "    holder.cell?.add(1);\n"
        + "\}\n"
        + "main() \{\}\n", "added");
    try testing.assertEqual(dumped,
        "func internal @main$added(%0: Holder) -> void \{\n"
        + "  $0 holder: Holder borrowed\n"
        + "  $1 safepayload: Cell\n"
        + "  $2 released: Cell\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Holder\n"
        + "  %2 = object_field_addr %1, 0: &Cell?  ; %1.cell\n"
        + "  %3 = load_ptr %2: Cell?\n"
        + "  %4 = opt.present %3: bool\n"
        + "  br %4, b2.safecall.link, b1.safecall.absent\n"
        + "b1.safecall.absent:\n"
        + "  jump b8.safecall.end\n"
        + "b2.safecall.link:\n"
        + "  %5 = opt.payload_addr %2: &Cell\n"
        + "  %6 = const 1: long\n"
        + "  %7 = load_ptr %2: Cell?\n"
        + "  %8 = opt.present %7: bool\n"
        + "  br %8, b4.safecall.link, b3.safecall.cleared\n"
        + "b3.safecall.cleared:\n"
        + "  jump b1.safecall.absent\n"
        + "b4.safecall.link:\n"
        + "  %9 = load_ptr %5: Cell\n"
        + "  %10 = field_addr %5, 0: &Probe  ; %1.cell.payload.probe\n"
        + "  retain_ptr %10\n"
        + "  store $1, %9\n"
        + "  %11 = slot_addr $1: &Cell  ; safepayload\n"
        + "  call @main$Cell$add(this %11, %6)\n"
        + "  %12 = load_ptr %2: Cell?\n"
        + "  %13 = opt.present %12: bool\n"
        + "  br %13, b5.storeback, b6.storeback.dropped\n"
        + "b5.storeback:\n"
        + "  %14 = opt.payload_addr %2: &Cell\n"
        + "  %15 = take $1: Cell\n"
        + "  %16 = take_ptr %14: Cell\n"
        + "  store_ptr %14, %15\n"
        + "  store $2, %16\n"
        + "  %17 = slot_addr $2: &Cell  ; released\n"
        + "  %18 = field_addr %17, 0: &Probe  ; released.probe\n"
        + "  release_ptr %18\n"
        + "  jump b7.storeback.end\n"
        + "b6.storeback.dropped:\n"
        + "  %19 = slot_addr $1: &Cell  ; safepayload\n"
        + "  %20 = field_addr %19, 0: &Probe  ; safepayload.probe\n"
        + "  release_ptr %20\n"
        + "  jump b7.storeback.end\n"
        + "b7.storeback.end:\n"
        + "  jump b8.safecall.end\n"
        + "b8.safecall.end:\n"
        + "  ret\n"
        + "\}\n");
}

// How many times the fragment appears in the text, for a dump that should hold one instruction
// per step rather than an unknown number.
countOccurrences(string text, string fragment) -> long {
    long found = 0;
    long at = text.indexOf(fragment);
    while (at >= 0) {
        found++;
        at = text.indexOf(fragment, at + fragment.length);
    }
    return found;
}

// A struct holding a reference and a function producing an optional one, for the tests on what a
// produced optional owns.
producedCells() -> string {
    return "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "    protected name() -> string \{\n"
        + "        return \"cell\";\n"
        + "    \}\n"
        + "\}\n"
        + "made() -> Cell? \{\n"
        + "    return \{probe: new Probe()\};\n"
        + "\}\n";
}

// A struct holding a reference with 'mutating' methods, for the tests on a '?.' call that changes
// the optional it is called on.
storedCells() -> string {
    return "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Failure extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"failed\");\n"
        + "    \}\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "    protected long count;\n"
        + "    protected mutating bump() \{\n"
        + "        this.count++;\n"
        + "    \}\n"
        + "    protected mutating next() -> long \{\n"
        + "        this.count++;\n"
        + "        return this.count;\n"
        + "    \}\n"
        + "    protected mutating add(long amount) \{\n"
        + "        this.count += amount;\n"
        + "    \}\n"
        + "    protected mutating hold(Probe probe) \{\n"
        + "        this.probe = probe;\n"
        + "    \}\n"
        + "    protected mutating fail() throws \{\n"
        + "        this.count++;\n"
        + "        throw new Failure();\n"
        + "    \}\n"
        + "\}\n";
}
