// The synthesized content hash of an optional: the tag guards the read, so the payload is only
// hashed where it is present and an absent value folds a constant instead. A receiver sema already
// narrowed needs no guard, because the payload is what it reads. A foreign handle has no content
// to fold and is refused in both spellings.
import @std.testing;
import support;

test "a tagged optional hashes through a presence guard" {
    let dumped = try support.loweredDump(
        "hashOf(int? value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return hashOf(7) as int;\n"
        + "\}\n", "hashOf");
    try testing.assertTrue(dumped.indexOf("opthash.present") >= 0
        && dumped.indexOf("opthash.absent") >= 0,
        "the hash should branch on presence: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload") >= 0,
        "the present path should hash the payload: {dumped}");
    try testing.assertTrue(dumped.indexOf("const -1") >= 0,
        "the absent path should fold the absent hash: {dumped}");
}

test "an optional struct hashes its payload's fields over a scratch copy" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    int x;\n"
        + "    string label;\n"
        + "\}\n"
        + "hashOf(Point? value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return hashOf(null) as int;\n"
        + "\}\n", "hashOf");
    try testing.assertTrue(dumped.indexOf("opthash.present") >= 0,
        "the hash should branch on presence: {dumped}");
    try testing.assertTrue(dumped.indexOf("safepayload") >= 0,
        "the present payload should be parked in a scratch slot: {dumped}");
    try testing.assertTrue(dumped.indexOf("hash ") >= 0,
        "the payload's fields should fold as leaves: {dumped}");
}

test "a struct that declared hash answers for a nested field instead of folding it" {
    let dumped = try support.loweredDump(
        "struct Key \{\n"
        + "    int id;\n"
        + "    string note;\n"
        + "    override hash() -> long \{ return this.id; \}\n"
        + "    override equals(Key other) -> bool \{ return this.id == other.id; \}\n"
        + "\}\n"
        + "struct Wrapper \{\n"
        + "    Key key;\n"
        + "    int tag;\n"
        + "\}\n"
        + "hashOf(Wrapper value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Wrapper w = \{key: \{id: 1, note: \"a\"\}, tag: 1\};\n"
        + "    return hashOf(w) as int;\n"
        + "\}\n", "hashOf");
    try testing.assertTrue(dumped.indexOf("call @main$Key$hash(this %") >= 0,
        "the nested field should hash through the declaration: {dumped}");
    try testing.assertTrue(dumped.indexOf("hash %") >= 0,
        "the enclosing struct should still fold its own remaining field: {dumped}");
}

test "a narrowed optional receiver hashes its projected payload with no guard" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int? n = 7;\n"
        + "    long h = n.hash();\n"
        + "    return h as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("opthash.present") < 0,
        "a receiver proven present needs no guard: {dumped}");
    try testing.assertTrue(dumped.indexOf("opt.payload") >= 0,
        "the narrowed read should project the payload before folding it: {dumped}");
}

test "hashing a foreign handle is refused in both spellings" {
    string program = "external type Handle;\n"
        + "external from libc \{\n"
        + "    malloc(long size) -> Handle;\n"
        + "\}\n"
        + "grab() -> Handle? \{\n"
        + "    return malloc(8);\n"
        + "\}\n"
        + "nullable() -> long \{\n"
        + "    return grab().hash();\n"
        + "\}\n"
        + "plain(Handle handle) -> long \{\n"
        + "    return handle.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let nullableMessage = try support.loweringFailure(program, "nullable");
    try testing.assertTrue(nullableMessage.indexOf("hashing a 'Handle?'") >= 0,
        "unexpected message: {nullableMessage}");
    let plainMessage = try support.loweringFailure(program, "plain");
    try testing.assertTrue(plainMessage.indexOf("hashing a 'Handle'") >= 0,
        "unexpected message: {plainMessage}");
}

test "a produced optional of a struct gives its payload's reference up through storage" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    Probe probe;\n"
        + "\}\n"
        + "grab() -> Cell? \{\n"
        + "    return \{probe: new Probe()\};\n"
        + "\}\n"
        + "probe() -> long \{\n"
        + "    return grab().hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "probe");
    try testing.assertTrue(dumped.indexOf("released: Cell?") >= 0,
        "the produced pair needs storage for the release to reach its field: {dumped}");
    try testing.assertTrue(dumped.indexOf("; released.payload.probe") >= 0,
        "the payload's reference should be released through that storage: {dumped}");
}
