// Lowering the members a primitive binding declares: each one is a function under the
// primitive's name whose receiver is the primitive value, with no dispatch anywhere, and a call
// through a generic bound reaches the binding's member at every primitive it is planned for.
import @std.testing;
import support;
import MemoryFileLoader from support;

// A program whose stand-in standard library carries one binding module, imported by main.
loadWithBinding(string bindingSource, string mainSource) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/text.ens", bindingSource);
    loader.add("/src/main.ens", mainSource);
    return loader;
}

test "a binding member lowers under the primitive's name, over the primitive value" {
    let loader = loadWithBinding(
        "primitive string \{\n"
        + "    export doubledLength() -> long \{\n"
        + "        return this.length + this.length;\n"
        + "    \}\n"
        + "\}\n",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    return \"ab\".doubledLength() as int;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "std.text$string$doubledLength");
    try testing.assertTrue(
        dumped.startsWith("func @std.text$string$doubledLength(%0: string) -> long"),
        "the member is a function under the primitive's name, taking it first: {dumped}");
    try testing.assertTrue(dumped.indexOf("$0 this: string borrowed") > 0,
        "the primitive arrives borrowed, like a parameter: {dumped}");
    try testing.assertTrue(dumped.indexOf("= str.len ") > 0,
        "'this.length' still reads the intrinsic: {dumped}");
}

test "a call to a binding member passes the receiver and never dispatches" {
    let loader = loadWithBinding(
        "primitive string \{\n"
        + "    export isEmpty() -> bool \{\n"
        + "        return this.length == 0;\n"
        + "    \}\n"
        + "\}\n",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    let empty = \"ab\".isEmpty();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(dumped.indexOf("call @std.text$string$isEmpty(this %") > 0,
        "the call names the member directly and hands it the receiver: {dumped}");
    try testing.assertTrue(dumped.indexOf("dispatch") < 0,
        "nothing looks the target up in a dispatch table: {dumped}");
}

test "a static of a binding lowers with only its declared parameters" {
    let loader = loadWithBinding(
        "primitive string \{\n"
        + "    export static joined(string left, string right) -> string \{\n"
        + "        return left + right;\n"
        + "    \}\n"
        + "\}\n",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    let joined = string.joined(\"a\", \"b\");\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "std.text$string$joined");
    try testing.assertTrue(
        dumped.startsWith("func @std.text$string$joined(%0: string, %1: string) -> string"),
        "a static takes no receiver: {dumped}");
    let caller = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(caller.indexOf("call @std.text$string$joined(%0, %1)") > 0,
        "the static call passes only the written arguments: {caller}");
}

test "a call through a generic bound reaches the binding's member at each primitive" {
    let loader = loadWithBinding(
        "export interface Measured \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive string implements Measured \{\n"
        + "    export override size() -> long \{\n"
        + "        return this.length;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "primitive long implements Measured \{\n"
        + "    export override size() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n",
        "import Measured from @std.text;\n"
        + "sizeOf<T: Measured>(T value) -> long \{\n"
        + "    return value.size();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let text = sizeOf<string>(\"abc\");\n"
        + "    let number = sizeOf<long>(4L);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let atText = try support.loweredLoadedSymbolDump(analysis, "main$sizeOf__string__");
    try testing.assertTrue(atText.indexOf("call @std.text$string$size(this %") > 0,
        "the instance at 'string' calls that binding's member: {atText}");
    let atNumber = try support.loweredLoadedSymbolDump(analysis, "main$sizeOf__long__");
    try testing.assertTrue(atNumber.indexOf("call @std.text$long$size(this %") > 0,
        "the instance at 'long' calls the other binding's member: {atNumber}");
}

test "the whole program with a binding lowers and verifies" {
    let loader = loadWithBinding(
        "export interface Measured \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive string implements Measured \{\n"
        + "    export override size() -> long \{\n"
        + "        return this.length;\n"
        + "    \}\n"
        + "\n"
        + "    export repeated(long times) -> string \{\n"
        + "        string built = \"\";\n"
        + "        for (long i = 0; i < times; i++) \{\n"
        + "            built = built + this;\n"
        + "        \}\n"
        + "        return built;\n"
        + "    \}\n"
        + "\n"
        + "    export static joined(string left, string right) -> string \{\n"
        + "        return left + right;\n"
        + "    \}\n"
        + "\}\n",
        "import Measured from @std.text;\n"
        + "sizeOf<T: Measured>(T value) -> long \{\n"
        + "    return value.size();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let joined = string.joined(\"a\", \"b\");\n"
        + "    let grown = joined.repeated(3L);\n"
        + "    return sizeOf<string>(grown) as int - 6;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let program = try support.lowerLoadedProgram(analysis);
    bool sawMember = false;
    bool sawStatic = false;
    for (long i = 0; i < program.functions.length(); i++) {
        string symbol = program.functions.get(i).symbol();
        if (symbol == "std.text$string$repeated") {
            sawMember = true;
        }
        if (symbol == "std.text$string$joined") {
            sawStatic = true;
        }
    }
    try testing.assertTrue(sawMember, "the binding's members are among the emitted functions");
    try testing.assertTrue(sawStatic, "so are its statics");
}

test "a lambda inside a binding member captures the primitive by value" {
    let loader = loadWithBinding(
        "primitive string \{\n"
        + "    export offsetLength(long extra) -> long \{\n"
        + "        (long) -> long sizes = (more) -> this.length + more;\n"
        + "        return sizes(extra);\n"
        + "    \}\n"
        + "\}\n",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    return \"abc\".offsetLength(1L) as int - 4;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "std.text$string$offsetLength");
    try testing.assertTrue(dumped.indexOf("closure.new @std.text$lambda0") > 0,
        "the member builds a closure: {dumped}");
    try testing.assertTrue(dumped.indexOf("closure_capture") > 0,
        "and the receiver travels in it as a capture: {dumped}");
}
