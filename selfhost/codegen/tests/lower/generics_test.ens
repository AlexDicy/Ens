// Lowering generic instances: a body is lowered once per type-argument tuple and a method under
// its instantiation's substitution. Also covers foreach through the iterator protocol and
// bounded calls.
import @std.testing;
import MemoryFileLoader from support;
import support;

test "a generic function lowers one body per type-argument tuple" {
    string program =
        "identity<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let text = identity<string>(\"x\");\n"
        + "    return identity<int>(7);\n"
        + "\}\n";
    let intInstance = try support.loweredSymbolDump(program, "main$identity__int__");
    try testing.assertTrue(intInstance.indexOf("@main$identity__int__(%0: int) -> int") >= 0,
        "the int instance should carry concrete types: {intInstance}");
    let stringInstance = try support.loweredSymbolDump(program, "main$identity__string__");
    try testing.assertTrue(
        stringInstance.indexOf("@main$identity__string__(%0: string) -> string") >= 0,
        "the string instance should carry concrete types: {stringInstance}");
    try testing.assertTrue(stringInstance.indexOf("retain") >= 0,
        "the string instance should own its returned reference: {stringInstance}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("call @main$identity__int__(") >= 0,
        "the call should target the planned instance: {caller}");
}

test "a generic class method lowers under its instantiation's substitution" {
    string program =
        "class Box<T> \{\n"
        + "    T inner;\n"
        + "    protected constructor(this.inner);\n"
        + "    protected unwrap() -> T \{\n"
        + "        return this.inner;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Box<int>(41).unwrap() + 1;\n"
        + "\}\n";
    let unwrap = try support.loweredSymbolDump(program, "Box__int___unwrap");
    try testing.assertTrue(unwrap.indexOf("@Box__int___unwrap(%0: Box<int>) -> int") >= 0,
        "the method should run over the instantiation at its concrete types: {unwrap}");
    try testing.assertTrue(unwrap.indexOf(": &int") >= 0,
        "the field projection should be typed at the substituted field type: {unwrap}");
    let caller = try support.loweredDump(program, "main");
    try testing.assertTrue(caller.indexOf("call @Box__int___constructor(") >= 0,
        "the constructor call should target the instance: {caller}");
    try testing.assertTrue(caller.indexOf("call @Box__int___unwrap(") >= 0,
        "the method call should target the instance: {caller}");
}

test "foreach refuses an Iterator contract whose next() returns a non-optional value" {
    string program =
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    protected constructor(this.current);\n"
        + "    protected override next() -> int \{\n"
        + "        int value = this.current;\n"
        + "        this.current = this.current + 1;\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "class Range implements Iterable<int> \{\n"
        + "    protected constructor();\n"
        + "    protected override makeIterator() -> Iterator<int> \{\n"
        + "        return new CountUp(1);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int total = 0;\n"
        + "    for (let n in new Range()) \{\n"
        + "        total = total + n;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n";
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/src/main.ens", program);
    let analysis = try support.analyzeLoaded(loader);
    let message = try support.loweringLoadedFailure(analysis, "main");
    try testing.assertEqual(message, "Internal: 'Iterator<int>' declares 'next()' returning "
        + "'int', and the loop needs an optional to know when the walk is over");
}

test "foreach over a user iterable drives makeIterator and next, branching on presence" {
    string program =
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    int limit;\n"
        + "    protected constructor(this.current, this.limit);\n"
        + "    protected override next() -> int? \{\n"
        + "        if (this.current > this.limit) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        int value = this.current;\n"
        + "        this.current = this.current + 1;\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "class Range implements Iterable<int> \{\n"
        + "    int low;\n"
        + "    int high;\n"
        + "    protected constructor(this.low, this.high);\n"
        + "    protected override makeIterator() -> Iterator<int> \{\n"
        + "        return new CountUp(this.low, this.high);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int total = 0;\n"
        + "    for (let n in new Range(1, 3)) \{\n"
        + "        total = total + n;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n";
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/src/main.ens", program);
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedDump(analysis, "main");
    try testing.assertTrue(dumped.indexOf("makeIterator") >= 0,
        "the loop should open with makeIterator: {dumped}");
    try testing.assertTrue(dumped.indexOf("itable[Iterator<int>, 0]") >= 0,
        "next should dispatch through the iterator's method table: {dumped}");
    try testing.assertTrue(dumped.indexOf("= opt.present %") >= 0,
        "the loop should branch on the presence of next's result: {dumped}");
    try testing.assertTrue(dumped.indexOf("hasNext") < 0,
        "the loop should call nothing but next to know when the walk is over: {dumped}");
}

test "foreach reads the protocol from the Iterator contract, not the iterator's own members" {
    string program =
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    int limit;\n"
        + "    protected constructor(this.current, this.limit);\n"
        + "    protected hasNext() -> bool \{\n"
        + "        return false;\n"
        + "    \}\n"
        + "    protected override next() -> int? \{\n"
        + "        if (this.current > this.limit) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        int value = this.current;\n"
        + "        this.current = this.current + 1;\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "class Range implements Iterable<int> \{\n"
        + "    int low;\n"
        + "    int high;\n"
        + "    protected constructor(this.low, this.high);\n"
        + "    protected override makeIterator() -> CountUp \{\n"
        + "        return new CountUp(this.low, this.high);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int total = 0;\n"
        + "    for (let n in new Range(1, 3)) \{\n"
        + "        total = total + n;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n";
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/src/main.ens", program);
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedDump(analysis, "main");
    try testing.assertTrue(dumped.indexOf("call @main$CountUp$next(") >= 0,
        "next should be called on the concrete iterator: {dumped}");
    try testing.assertTrue(dumped.indexOf("= opt.present %") >= 0,
        "the loop should branch on the presence of next's result: {dumped}");
    try testing.assertTrue(dumped.indexOf("hasNext") < 0,
        "the class's unrelated hasNext must not gate the loop: {dumped}");
}

test "a hash call through a type parameter folds the synthesized hash" {
    let loader = new MemoryFileLoader();
    loader.add("/src/main.ens",
        "hashOf<T>(T value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let byValue = hashOf<int>(4);\n"
        + "    let byText = hashOf<string>(\"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let intInstance = try support.loweredLoadedSymbolDump(analysis, "main$hashOf__int__");
    try testing.assertTrue(intInstance.indexOf("= hash %") >= 0,
        "an int hashes as a widened leaf: {intInstance}");
    let stringInstance = try support.loweredLoadedSymbolDump(analysis,
        "main$hashOf__string__");
    try testing.assertTrue(stringInstance.indexOf("= hash %") >= 0,
        "a string hashes as a leaf the emitter folds: {stringInstance}");
}
