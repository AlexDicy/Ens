// Tests for how a type is spelled inside a linker symbol: two types an instance can be made over
// never spell alike, since the two instances would share one symbol.
import @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import lower.symbols;
import support;

test "a function type's throws list is part of its spelling" {
    let store = try support.freshStore();
    let integer = store.primitive(PrimitiveKind.Int);
    let text = store.stringType();
    string quiet = symbols.mangledTypeArgument(store.functionOf([], integer, []));
    string loud = symbols.mangledTypeArgument(store.functionOf([], integer, [text]));
    try testing.assertEqual(quiet, "fn_to_int");
    try testing.assertEqual(loud, "fn_to_int_throws_string");
}

test "a shared function type is spelled apart from the same type without 'shared'" {
    let store = try support.freshStore();
    let integer = store.primitive(PrimitiveKind.Int);
    try testing.assertEqual(symbols.mangledTypeArgument(store.functionOf([integer], integer, [],
        true)), "sharedfn_int_to_int");
    try testing.assertEqual(symbols.mangledTypeArgument(store.functionOf([integer], integer, [])),
        "fn_int_to_int");
}

test "a throws list is spelled by its members, and the empty one apart from any type" {
    let store = try support.freshStore();
    let text = store.stringType();
    let wide = store.primitive(PrimitiveKind.Long);
    let fallback = store.errorType();
    try testing.assertEqual(symbols.mangledTypeArgument(store.thrownListOf([text, wide], fallback)),
        "thrown_string_long");
    try testing.assertEqual(symbols.mangledTypeArgument(store.thrownListOf([], fallback)), "thrown");
}
