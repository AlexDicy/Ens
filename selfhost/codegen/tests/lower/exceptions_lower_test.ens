// Golden dumps for the exception lowering, from a throw's captured trace through the unwind-edge
// cleanup and the catch dispatch to the trace accessors. All three verifiers gate every dump.
import @std.testing;
import eir.dump;
import support;

test "a throw captures the trace onto the owned error and propagates it" {
    let dumped = try support.loweredDump(
        "risky() -> int throws \{\n"
        + "    throw new Error(\"boom\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "risky");
    try testing.assertEqual(dumped,
        "func internal @main$risky() -> int throws \{\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$std.core$Error: Error\n"
        + "  %1 = const \"boom\": string\n"
        + "  call @std.core$Error$constructor(this %0, %1)\n"
        + "  capture_trace %0, line 2\n"
        + "  propagate %0\n"
        + "\}\n");
}

test "a throwing call terminates its block and releases the owned local on the unwind edge" {
    let dumped = try support.loweredDump(
        "risky() -> int throws \{\n"
        + "    throw new Error(\"boom\");\n"
        + "\}\n"
        + "relay() -> int throws \{\n"
        + "    let held = \"a\" + \"b\";\n"
        + "    return try risky();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "relay");
    try testing.assertEqual(dumped,
        "func internal @main$relay() -> int throws \{\n"
        + "  $0 held: string zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const \"a\": string\n"
        + "  retain %0\n"
        + "  %1 = const \"b\": string\n"
        + "  retain %1\n"
        + "  %2 = str.concat %0, %1: string\n"
        + "  release %0\n"
        + "  release %1\n"
        + "  store $0, %2\n"
        + "  %3 = try_call @main$risky(): int, error %4, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  %6 = slot_addr $0: &string  ; held\n"
        + "  release_ptr %6\n"
        + "  ret %3\n"
        + "b2.try.unwind:\n"
        + "  %5 = slot_addr $0: &string  ; held\n"
        + "  release_ptr %5\n"
        + "  propagate %4\n"
        + "\}\n");
}

test "an owned argument temporary is released on a later argument's unwind edge" {
    let dumped = try support.loweredDump(
        "consume(string a, int n) -> int \{\n"
        + "    return n;\n"
        + "\}\n"
        + "boom() -> int throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "mix() -> int throws \{\n"
        + "    return consume(\"p\" + \"q\", try boom());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "mix");
    try testing.assertEqual(dumped,
        "func internal @main$mix() -> int throws \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"p\": string\n"
        + "  retain %0\n"
        + "  %1 = const \"q\": string\n"
        + "  retain %1\n"
        + "  %2 = str.concat %0, %1: string\n"
        + "  release %0\n"
        + "  release %1\n"
        + "  %3 = try_call @main$boom(): int, error %4, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  %5 = call @main$consume(%2, %3): int\n"
        + "  release %2\n"
        + "  ret %5\n"
        + "b2.try.unwind:\n"
        + "  release %2\n"
        + "  propagate %4\n"
        + "\}\n");
}

test "a struct temporary is released on an unwind edge inside its statement and on none after it" {
    let dumped = try support.loweredDump(
        "struct Named \{\n"
        + "    protected string name;\n"
        + "\}\n"
        + "named() -> Named \{\n"
        + "    return \{name: \"a\"\};\n"
        + "\}\n"
        + "consume(string text, int n) -> int \{\n"
        + "    return n;\n"
        + "\}\n"
        + "boom() -> int throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "mix() -> int throws \{\n"
        + "    long first = consume(named().name, try boom());\n"
        + "    return try boom();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "mix");
    try testing.assertEqual(dumped,
        "func internal @main$mix() -> int throws \{\n"
        + "  $0 first: long\n"
        + "  $1 materialized: Named zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @main$named(): Named\n"
        + "  store $1, %0\n"
        + "  %1 = slot_addr $1: &Named  ; materialized\n"
        + "  %2 = field_addr %1, 0: &string  ; materialized.name\n"
        + "  %3 = load_ptr %2: string\n"
        + "  %4 = try_call @main$boom(): int, error %5, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  %8 = call @main$consume(%3, %4): int\n"
        + "  %9 = slot_addr $1: &Named  ; materialized\n"
        + "  %10 = field_addr %9, 0: &string  ; materialized.name\n"
        + "  release_ptr %10\n"
        + "  %11 = sext %8: long\n"
        + "  store $0, %11\n"
        + "  %12 = try_call @main$boom(): int, error %13, to b3.try.ok, unwind b4.try.unwind\n"
        + "b2.try.unwind:\n"
        + "  %6 = slot_addr $1: &Named  ; materialized\n"
        + "  %7 = field_addr %6, 0: &string  ; materialized.name\n"
        + "  release_ptr %7\n"
        + "  propagate %5\n"
        + "b3.try.ok:\n"
        + "  ret %12\n"
        + "b4.try.unwind:\n"
        + "  propagate %13\n"
        + "\}\n");
}

test "catch clauses dispatch on the runtime type, bind the error owned, and rethrow re-raises" {
    let dumped = try support.loweredDump(
        "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{\n"
        + "        super(m);\n"
        + "    \}\n"
        + "\}\n"
        + "risky(int n) -> int throws \{\n"
        + "    if (n < 0) \{\n"
        + "        throw new NetError(\"neg\");\n"
        + "    \}\n"
        + "    if (n == 0) \{\n"
        + "        throw new Error(\"zero\");\n"
        + "    \}\n"
        + "    return n;\n"
        + "\}\n"
        + "handle(int n) -> int throws \{\n"
        + "    return try risky(n);\n"
        + "\} catch (NetError e) \{\n"
        + "    return 0;\n"
        + "\} catch (Error e) \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "handle");
    try testing.assertEqual(dumped,
        "func internal @main$handle(%0: int) -> int throws \{\n"
        + "  $0 err.dispatch: Error zeroed\n"
        + "  $1 n: int\n"
        + "  $2 e: NetError zeroed\n"
        + "  $3 e: Error zeroed\n"
        + "b0.entry:\n"
        + "  store $1, %0\n"
        + "  %1 = load $1: int\n"
        + "  %2 = try_call @main$risky(%1): int, error %3, to b2.try.ok, unwind b3.try.unwind\n"
        + "b1.catch.dispatch:\n"
        + "  %5 = slot_addr $0: &Error  ; err.dispatch\n"
        + "  %6 = load_ptr %5: Error\n"
        + "  retain %6\n"
        + "  %7 = type_test %6 is NetError: bool\n"
        + "  br %7, b4.catch.body, b5.catch.next\n"
        + "b2.try.ok:\n"
        + "  %4 = slot_addr $0: &Error  ; err.dispatch\n"
        + "  release_ptr %4\n"
        + "  ret %2\n"
        + "b3.try.unwind:\n"
        + "  store $0, %3\n"
        + "  jump b1.catch.dispatch\n"
        + "b4.catch.body:\n"
        + "  %8 = reinterpret %6: NetError\n"
        + "  store $2, %8\n"
        + "  %9 = const 0: int\n"
        + "  %10 = slot_addr $2: &NetError  ; e\n"
        + "  release_ptr %10\n"
        + "  %11 = slot_addr $0: &Error  ; err.dispatch\n"
        + "  release_ptr %11\n"
        + "  ret %9\n"
        + "b5.catch.next:\n"
        + "  %12 = type_test %6 is Error: bool\n"
        + "  br %12, b6.catch.body, b7.catch.next\n"
        + "b6.catch.body:\n"
        + "  store $3, %6\n"
        + "  %13 = slot_addr $3: &Error  ; e\n"
        + "  %14 = load_ptr %13: Error\n"
        + "  retain %14\n"
        + "  %15 = slot_addr $3: &Error  ; e\n"
        + "  release_ptr %15\n"
        + "  %16 = slot_addr $0: &Error  ; err.dispatch\n"
        + "  release_ptr %16\n"
        + "  propagate %14\n"
        + "b7.catch.next:\n"
        + "  %17 = slot_addr $0: &Error  ; err.dispatch\n"
        + "  release_ptr %17\n"
        + "  propagate %6\n"
        + "\}\n");
}

test "the trace accessors lower to reads of the captured trace" {
    let dumped = try support.loweredDump(
        "describe(Error e) -> string \{\n"
        + "    return e.stackTrace();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertEqual(dumped,
        "func internal @main$describe(%0: Error) -> string \{\n"
        + "  $0 e: Error borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Error\n"
        + "  %2 = error_trace %1 formatted: string\n"
        + "  ret %2\n"
        + "\}\n");
}

test "an override that drops the throws marker still carries its root's error slot" {
    let dumped = try support.loweredMethodDump(
        "public class Base \{\n"
        + "    public m() -> int throws \{\n"
        + "        throw new Error(\"x\");\n"
        + "    \}\n"
        + "\}\n"
        + "public class Sub extends Base \{\n"
        + "    public override m() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "Sub", "m");
    try testing.assertTrue(dumped.indexOf("-> int throws") >= 0,
        "the override lost its root's error slot: {dumped}");
}

test "an argument that throws abandons the construction, so no destructor runs over the object" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "    destructor() \{\n"
        + "        print(this.label);\n"
        + "    \}\n"
        + "\}\n"
        + "named() -> string throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "built() -> Probe throws \{\n"
        + "    return new Probe(try named());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "built");
    try testing.assertEqual(dumped,
        "func internal @main$built() -> Probe throws \{\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Probe: Probe\n"
        + "  %1 = try_call @main$named(): string, error %2, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  call @main$Probe$constructor(this %0, %1)\n"
        + "  release %1\n"
        + "  ret %0\n"
        + "b2.try.unwind:\n"
        + "  abandon.construction %0 @_dtor$main$Probe$fields\n"
        + "  release %0\n"
        + "  propagate %2\n"
        + "\}\n");
}

test "an object whose chain declares no destructor is released as it is when an argument throws" {
    let dumped = try support.loweredDump(
        "class Probe \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "\}\n"
        + "named() -> string throws \{\n"
        + "    throw new Error(\"x\");\n"
        + "\}\n"
        + "built() -> Probe throws \{\n"
        + "    return new Probe(try named());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "built");
    try testing.assertEqual(dumped,
        "func internal @main$built() -> Probe throws \{\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Probe: Probe\n"
        + "  %1 = try_call @main$named(): string, error %2, to b1.try.ok, unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  call @main$Probe$constructor(this %0, %1)\n"
        + "  release %1\n"
        + "  ret %0\n"
        + "b2.try.unwind:\n"
        + "  release %0\n"
        + "  propagate %2\n"
        + "\}\n");
}

test "a throws list a type parameter stands for decides the call's unwind edge and the catch's tests" {
    let program = try support.lowerWholeProgram(
        "class ParseError extends Error \{\n"
        + "    constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "class ReadError extends Error \{\n"
        + "    constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "attempt<V, E: Error>((() -> V throws E) body) -> V throws E \{\n"
        + "    return try body();\n"
        + "\}\n"
        + "guarded<E: Error>((() -> void throws E) body) -> int \{\n"
        + "    try body();\n"
        + "    return 0;\n"
        + "\} catch (E caught) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "either() -> int throws ParseError, ReadError \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int quiet = attempt(() -> 1);\n"
        + "    return quiet + guarded(() -> \{\n"
        + "        let ignored = try either();\n"
        + "    \});\n"
        + "\}\n");
    string main = dump.dumpFunction(try support.functionBySymbol(program, "ens.main"));
    try testing.assertTrue(main.indexOf("try_call") < 0,
        "a call whose list is empty raises nothing, so it has no unwind edge: {main}");
    string caught = "";
    for (let function in program.functions) {
        if (function.symbol().startsWith("main$guarded")) {
            caught = dump.dumpFunction(function);
        }
    }
    try testing.assertTrue(caught.indexOf("is ParseError") > 0 && caught.indexOf("is ReadError") > 0,
        "a clause over 'E' tests each listed type: {caught}");
    try testing.assertTrue(caught.indexOf("is Error") < 0,
        "and not the base they share, which would catch more: {caught}");
}
