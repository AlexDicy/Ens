// The '@std.tasks' intercept: whether a task's result and its error may be held by another task is a
// constant of each 'TaskOutcome' instance, so the library's placeholder bodies never run.
import @std.testing;
import MemoryFileLoader from support;
import support;

test "whether a task's result or error is shareable is a constant of each instance" {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/tasks.ens", "export final class TaskOutcome<T, E: Error> \{\n"
        + "    export constructor();\n"
        + "\n"
        + "    export resultIsShareable() -> bool \{\n"
        + "        return false;\n"
        + "    \}\n"
        + "\n"
        + "    export failureIsShareable() -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/src/main.ens", "import TaskOutcome from @std.tasks;\n"
        + "final class Box \{\n"
        + "    int value = 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let text = new TaskOutcome<string, Error>();\n"
        + "    let boxed = new TaskOutcome<Box, Error>();\n"
        + "    bool first = text.resultIsShareable();\n"
        + "    bool second = boxed.resultIsShareable();\n"
        + "    bool third = text.failureIsShareable();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(dumped.indexOf("IsShareable") < 0,
        "no placeholder body is called: {dumped}");
    try testing.assertTrue(dumped.indexOf("  %2 = const true: bool\n  store $2, %2\n"
        + "  %3 = const false: bool\n  store $3, %3\n  %4 = const false: bool\n") > 0,
        "a string result is shareable, a 'Box' result and an 'Error' are not: {dumped}");
}
