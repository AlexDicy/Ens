// Golden lowering tests for arrays: allocation, literals, bounds-checked element access, and
// iteration, with the goldens pinning where the element and array references change hands.
import @std.testing;
import support;

test "an allocated array is released at the end and every access is bounds checked" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[] xs = new int[3];\n"
        + "    xs[0] = 7;\n"
        + "    return xs[0];\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 xs: int[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 3: int\n"
        + "  %1 = sext %0: long\n"
        + "  %2 = array.new %1: int[]\n"
        + "  store $0, %2\n"
        + "  %3 = load $0: int[]\n"
        + "  %4 = const 0: int\n"
        + "  %5 = sext %4: long\n"
        + "  bounds_check %3[%5]\n"
        + "  %6 = element_addr %3[%5]: &int  ; %3[%5]\n"
        + "  %7 = const 7: int\n"
        + "  store_ptr %6, %7\n"
        + "  %8 = load $0: int[]\n"
        + "  %9 = const 0: int\n"
        + "  %10 = sext %9: long\n"
        + "  bounds_check %8[%10]\n"
        + "  %11 = element_addr %8[%10]: &int  ; %8[%10]\n"
        + "  %12 = load_ptr %11: int\n"
        + "  %13 = slot_addr $0: &int[]  ; xs\n"
        + "  release_ptr %13\n"
        + "  ret %12\n"
        + "\}\n");
}

test "a literal retains each element it stores, because the array owns them" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    string[] names = [\"a\", \"b\"];\n"
        + "    return names.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 names: string[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 2: long\n"
        + "  %1 = array.new %0: string[]\n"
        + "  %2 = const \"a\": string\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %1[%3]\n"
        + "  %4 = element_addr %1[%3]: &string  ; %1[%3]\n"
        + "  retain %2\n"
        + "  store_ptr %4, %2\n"
        + "  %5 = const \"b\": string\n"
        + "  %6 = const 1: long\n"
        + "  bounds_check %1[%6]\n"
        + "  %7 = element_addr %1[%6]: &string  ; %1[%6]\n"
        + "  retain %5\n"
        + "  store_ptr %7, %5\n"
        + "  store $0, %1\n"
        + "  %8 = load $0: string[]\n"
        + "  %9 = array.len %8: long\n"
        + "  %10 = trunc %9: int\n"
        + "  %11 = slot_addr $0: &string[]  ; names\n"
        + "  release_ptr %11\n"
        + "  ret %10\n"
        + "\}\n");
}

test "iteration keeps the array alive for the loop and borrows each element" {
    let dumped = try support.loweredDump(
        "total(int[] xs) -> int \{\n"
        + "    int sum = 0;\n"
        + "    for (let x in xs) \{\n"
        + "        sum += x;\n"
        + "    \}\n"
        + "    return sum;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return total([1, 2]);\n"
        + "\}\n", "total");
    try testing.assertEqual(dumped,
        "func internal @total(%0: int[]) -> int \{\n"
        + "  $0 xs: int[] borrowed\n"
        + "  $1 sum: int\n"
        + "  $2 iterated: int[] zeroed\n"
        + "  $3 index: long\n"
        + "  $4 x: int borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = const 0: int\n"
        + "  store $1, %1\n"
        + "  %2 = load $0: int[]\n"
        + "  retain %2\n"
        + "  store $2, %2\n"
        + "  %3 = const 0: long\n"
        + "  store $3, %3\n"
        + "  jump b1.foreach.cond\n"
        + "b1.foreach.cond:\n"
        + "  %4 = load $2: int[]\n"
        + "  %5 = array.len %4: long\n"
        + "  %6 = load $3: long\n"
        + "  %7 = cmp.slt %6, %5: bool\n"
        + "  br %7, b2.foreach.body, b4.foreach.end\n"
        + "b2.foreach.body:\n"
        + "  %8 = load $2: int[]\n"
        + "  %9 = load $3: long\n"
        + "  bounds_check %8[%9]\n"
        + "  %10 = element_addr %8[%9]: &int  ; %8[%9]\n"
        + "  %11 = load_ptr %10: int\n"
        + "  store $4, %11\n"
        + "  %12 = load $1: int\n"
        + "  %13 = load $4: int\n"
        + "  %14 = add %12, %13: int\n"
        + "  store $1, %14\n"
        + "  jump b3.foreach.step\n"
        + "b3.foreach.step:\n"
        + "  %15 = load $3: long\n"
        + "  %16 = const 1: long\n"
        + "  %17 = add %15, %16: long\n"
        + "  store $3, %17\n"
        + "  jump b1.foreach.cond\n"
        + "b4.foreach.end:\n"
        + "  %18 = load $1: int\n"
        + "  %19 = slot_addr $2: &int[]  ; iterated\n"
        + "  release_ptr %19\n"
        + "  ret %18\n"
        + "\}\n");
}

test "a multidimensional allocation fills every outer slot with a fresh inner array" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[][] grid = new int[2][3];\n"
        + "    return grid[1][2];\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("  %2 = array.new %1: int[][]\n") >= 0,
        "the outer level should be allocated: {dumped}");
    try testing.assertTrue(dumped.indexOf("  %8 = array.new %7: int[]\n") >= 0,
        "each inner level should be allocated: {dumped}");
    try testing.assertTrue(dumped.indexOf("  store_ptr %10, %8\n") >= 0,
        "the inner array's reference should move into the outer slot: {dumped}");
    try testing.assertTrue(dumped.indexOf("retain %8") < 0,
        "the inner array's own reference should not be retained again: {dumped}");
}

test "an array an expression produced is parked before it is indexed" {
    let dumped = try support.loweredDump(
        "names() -> string[] \{\n"
        + "    return [\"a\"];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(names()[0]);\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 held: string[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @names(): string[]\n"
        + "  %1 = slot_addr $0: &string[]  ; held\n"
        + "  release_ptr %1\n"
        + "  store $0, %0\n"
        + "  %2 = load $0: string[]\n"
        + "  %3 = const 0: int\n"
        + "  %4 = sext %3: long\n"
        + "  bounds_check %2[%4]\n"
        + "  %5 = element_addr %2[%4]: &string  ; %2[%4]\n"
        + "  %6 = load_ptr %5: string\n"
        + "  print %6\n"
        + "  %7 = const 0: int\n"
        + "  %8 = slot_addr $0: &string[]  ; held\n"
        + "  release_ptr %8\n"
        + "  ret %7\n"
        + "\}\n");
}

test "a slice range-checks its bounds and produces an owned copy" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[] xs = new int[4];\n"
        + "    int[] ys = xs.slice(1, 2);\n"
        + "    return ys.length as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(
        dumped.indexOf("range_check %5, %7, %8, \"slice range out of bounds\"") >= 0,
        "the range must be checked before the copy: {dumped}");
    try testing.assertTrue(dumped.indexOf("%9 = array.slice %3, %5, %7: int[]") >= 0,
        "the copy is missing: {dumped}");
}
