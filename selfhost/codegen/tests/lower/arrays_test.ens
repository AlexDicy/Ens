// Golden lowering tests for arrays: allocation, literals, bounds-checked element access, and
// iteration, with the goldens pinning where the element and array references change hands.
import @std.testing;
import support;

test "an allocated array is released at the end and every access is bounds checked" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[] xs = new int[3];\n"
        + "    xs[0] = 7;\n"
        + "    return xs[0];\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 xs: int[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 3: int\n"
        + "  %1 = sext %0: long\n"
        + "  %2 = array.new %1: int[]\n"
        + "  store $0, %2\n"
        + "  %3 = load $0: int[]\n"
        + "  %4 = const 0: int\n"
        + "  %5 = sext %4: long\n"
        + "  bounds_check %3[%5] write\n"
        + "  %6 = element_addr %3[%5]: &int  ; %3[%5]\n"
        + "  %7 = const 7: int\n"
        + "  store_ptr %6, %7\n"
        + "  %8 = load $0: int[]\n"
        + "  %9 = const 0: int\n"
        + "  %10 = sext %9: long\n"
        + "  bounds_check %8[%10] read\n"
        + "  %11 = element_addr %8[%10]: &int  ; %8[%10]\n"
        + "  %12 = load_ptr %11: int\n"
        + "  %13 = slot_addr $0: &int[]  ; xs\n"
        + "  release_ptr %13\n"
        + "  ret %12\n"
        + "\}\n");
}

test "a literal retains each element it stores, because the array owns them" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    string[] names = [\"a\", \"b\"];\n"
        + "    return names.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 names: string[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 2: long\n"
        + "  %1 = array.new %0: string[]\n"
        + "  %2 = const \"a\": string\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %1[%3] write\n"
        + "  %4 = element_addr %1[%3]: &string  ; %1[%3]\n"
        + "  retain %2\n"
        + "  store_ptr %4, %2\n"
        + "  %5 = const \"b\": string\n"
        + "  %6 = const 1: long\n"
        + "  bounds_check %1[%6] write\n"
        + "  %7 = element_addr %1[%6]: &string  ; %1[%6]\n"
        + "  retain %5\n"
        + "  store_ptr %7, %5\n"
        + "  store $0, %1\n"
        + "  %8 = load $0: string[]\n"
        + "  %9 = array.len %8: long\n"
        + "  %10 = trunc %9: int\n"
        + "  %11 = slot_addr $0: &string[]  ; names\n"
        + "  release_ptr %11\n"
        + "  ret %10\n"
        + "\}\n");
}

test "a literal holding the receiver twice retains it once for each slot" {
    let dumped = try support.loweredMethodDump(
        "class Cell \{\n"
        + "    protected long value;\n"
        + "    protected constructor(this.value);\n"
        + "    protected pair() -> Cell[] \{\n"
        + "        return [this, this];\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Cell(1).pair().length as int;\n"
        + "\}\n", "Cell", "pair");
    try testing.assertEqual(dumped,
        "func @main$Cell$pair(%0: Cell) -> Cell[] \{\n"
        + "b0.entry:\n"
        + "  %1 = const 2: long\n"
        + "  %2 = array.new %1: Cell[]\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %2[%3] write\n"
        + "  %4 = element_addr %2[%3]: &Cell  ; %2[%3]\n"
        + "  retain %0\n"
        + "  store_ptr %4, %0\n"
        + "  %5 = const 1: long\n"
        + "  bounds_check %2[%5] write\n"
        + "  %6 = element_addr %2[%5]: &Cell  ; %2[%5]\n"
        + "  retain %0\n"
        + "  store_ptr %6, %0\n"
        + "  ret %2\n"
        + "\}\n");
}

test "iteration keeps the array alive for the loop and borrows each element" {
    let dumped = try support.loweredDump(
        "total(int[] xs) -> int \{\n"
        + "    int sum = 0;\n"
        + "    for (let x in xs) \{\n"
        + "        sum += x;\n"
        + "    \}\n"
        + "    return sum;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return total([1, 2]);\n"
        + "\}\n", "total");
    try testing.assertEqual(dumped,
        "func internal @main$total(%0: int[]) -> int \{\n"
        + "  $0 xs: int[] borrowed\n"
        + "  $1 sum: int\n"
        + "  $2 iterated: int[] zeroed\n"
        + "  $3 index: long\n"
        + "  $4 x: int borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = const 0: int\n"
        + "  store $1, %1\n"
        + "  %2 = load $0: int[]\n"
        + "  retain %2\n"
        + "  store $2, %2\n"
        + "  %3 = const 0: long\n"
        + "  store $3, %3\n"
        + "  jump b1.foreach.cond\n"
        + "b1.foreach.cond:\n"
        + "  %4 = load $2: int[]\n"
        + "  %5 = array.len %4: long\n"
        + "  %6 = load $3: long\n"
        + "  %7 = cmp.slt %6, %5: bool\n"
        + "  br %7, b2.foreach.body, b4.foreach.end\n"
        + "b2.foreach.body:\n"
        + "  %8 = load $2: int[]\n"
        + "  %9 = load $3: long\n"
        + "  bounds_check %8[%9] read\n"
        + "  %10 = element_addr %8[%9]: &int  ; %8[%9]\n"
        + "  %11 = load_ptr %10: int\n"
        + "  store $4, %11\n"
        + "  %12 = load $1: int\n"
        + "  %13 = load $4: int\n"
        + "  %14 = add %12, %13: int\n"
        + "  store $1, %14\n"
        + "  jump b3.foreach.step\n"
        + "b3.foreach.step:\n"
        + "  %15 = load $3: long\n"
        + "  %16 = const 1: long\n"
        + "  %17 = add %15, %16: long\n"
        + "  store $3, %17\n"
        + "  jump b1.foreach.cond\n"
        + "b4.foreach.end:\n"
        + "  %18 = slot_addr $2: &int[]  ; iterated\n"
        + "  release_ptr %18\n"
        + "  %19 = load $1: int\n"
        + "  ret %19\n"
        + "\}\n");
}

test "a multidimensional allocation fills every outer slot with a fresh inner array" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[][] grid = new int[2][3];\n"
        + "    return grid[1][2];\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("  %2 = array.new %1: int[][]\n") >= 0,
        "the outer level should be allocated: {dumped}");
    try testing.assertTrue(dumped.indexOf("  %8 = array.new %7: int[]\n") >= 0,
        "each inner level should be allocated: {dumped}");
    try testing.assertTrue(dumped.indexOf("  store_ptr %10, %8\n") >= 0,
        "the inner array's reference should move into the outer slot: {dumped}");
    try testing.assertTrue(dumped.indexOf("retain %8") < 0,
        "the inner array's own reference should not be retained again: {dumped}");
}

test "an array an expression produced is parked before it is indexed" {
    let dumped = try support.loweredDump(
        "names() -> string[] \{\n"
        + "    return [\"a\"];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(names()[0]);\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 held: string[] zeroed\n"
        + "b0.entry:\n"
        + "  %0 = call @main$names(): string[]\n"
        + "  %1 = slot_addr $0: &string[]  ; held\n"
        + "  release_ptr %1\n"
        + "  store $0, %0\n"
        + "  %2 = load $0: string[]\n"
        + "  %3 = const 0: int\n"
        + "  %4 = sext %3: long\n"
        + "  bounds_check %2[%4] read\n"
        + "  %5 = element_addr %2[%4]: &string  ; %2[%4]\n"
        + "  %6 = load_ptr %5: string\n"
        + "  retain %6\n"
        + "  %7 = slot_addr $0: &string[]  ; held\n"
        + "  release_ptr %7\n"
        + "  call @std.io.print$print(%6)\n"
        + "  release %6\n"
        + "  %8 = const 0: int\n"
        + "  ret %8\n"
        + "\}\n");
}

test "a slice range-checks its bounds and produces an owned copy" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    int[] xs = new int[4];\n"
        + "    int[] ys = xs.slice(1, 2);\n"
        + "    return ys.length as int;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("range_check %5, %7, %8, array.slice") >= 0,
        "the range must be checked before the copy: {dumped}");
    try testing.assertTrue(dumped.indexOf("%9 = array.slice %3, %5, %7: int[]") >= 0,
        "the copy is missing: {dumped}");
}

test "a spread literal builds each part first and copies every element into the result" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    string[] a = [\"x\"];\n"
        + "    string[] b = [...a, \"y\"];\n"
        + "    return b.length as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 a: string[] zeroed\n"
        + "  $1 b: string[] zeroed\n"
        + "  $2 spread.position: long\n"
        + "  $3 spread.index: long\n"
        + "  $4 spread.index: long\n"
        + "b0.entry:\n"
        + "  %0 = const 1: long\n"
        + "  %1 = array.new %0: string[]\n"
        + "  %2 = const \"x\": string\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %1[%3] write\n"
        + "  %4 = element_addr %1[%3]: &string  ; %1[%3]\n"
        + "  retain %2\n"
        + "  store_ptr %4, %2\n"
        + "  store $0, %1\n"
        + "  %5 = load $0: string[]\n"
        + "  retain %5\n"
        + "  %6 = const 1: long\n"
        + "  %7 = array.new %6: string[]\n"
        + "  %8 = const \"y\": string\n"
        + "  %9 = const 0: long\n"
        + "  bounds_check %7[%9] write\n"
        + "  %10 = element_addr %7[%9]: &string  ; %7[%9]\n"
        + "  retain %8\n"
        + "  store_ptr %10, %8\n"
        + "  %11 = const 0: long\n"
        + "  %12 = array.len %5: long\n"
        + "  %13 = add %11, %12: long\n"
        + "  %14 = array.len %7: long\n"
        + "  %15 = add %13, %14: long\n"
        + "  %16 = array.new %15: string[]\n"
        + "  %17 = const 0: long\n"
        + "  store $2, %17\n"
        + "  %18 = array.len %5: long\n"
        + "  %19 = const 0: long\n"
        + "  store $3, %19\n"
        + "  jump b1.spread.cond\n"
        + "b1.spread.cond:\n"
        + "  %20 = load $3: long\n"
        + "  %21 = cmp.slt %20, %18: bool\n"
        + "  br %21, b2.spread.body, b3.spread.end\n"
        + "b2.spread.body:\n"
        + "  %22 = load $3: long\n"
        + "  bounds_check %5[%22] read\n"
        + "  %23 = element_addr %5[%22]: &string  ; %5[%22]\n"
        + "  %24 = load_ptr %23: string\n"
        + "  %25 = load $2: long\n"
        + "  bounds_check %16[%25] write\n"
        + "  %26 = element_addr %16[%25]: &string  ; %16[%25]\n"
        + "  retain %24\n"
        + "  store_ptr %26, %24\n"
        + "  %27 = const 1: long\n"
        + "  %28 = add %22, %27: long\n"
        + "  store $3, %28\n"
        + "  %29 = add %25, %27: long\n"
        + "  store $2, %29\n"
        + "  jump b1.spread.cond\n"
        + "b3.spread.end:\n"
        + "  %30 = array.len %7: long\n"
        + "  %31 = const 0: long\n"
        + "  store $4, %31\n"
        + "  jump b4.spread.cond\n"
        + "b4.spread.cond:\n"
        + "  %32 = load $4: long\n"
        + "  %33 = cmp.slt %32, %30: bool\n"
        + "  br %33, b5.spread.body, b6.spread.end\n"
        + "b5.spread.body:\n"
        + "  %34 = load $4: long\n"
        + "  bounds_check %7[%34] read\n"
        + "  %35 = element_addr %7[%34]: &string  ; %7[%34]\n"
        + "  %36 = load_ptr %35: string\n"
        + "  %37 = load $2: long\n"
        + "  bounds_check %16[%37] write\n"
        + "  %38 = element_addr %16[%37]: &string  ; %16[%37]\n"
        + "  retain %36\n"
        + "  store_ptr %38, %36\n"
        + "  %39 = const 1: long\n"
        + "  %40 = add %34, %39: long\n"
        + "  store $4, %40\n"
        + "  %41 = add %37, %39: long\n"
        + "  store $2, %41\n"
        + "  jump b4.spread.cond\n"
        + "b6.spread.end:\n"
        + "  release %7\n"
        + "  release %5\n"
        + "  store $1, %16\n"
        + "  %42 = load $1: string[]\n"
        + "  %43 = array.len %42: long\n"
        + "  %44 = trunc %43: int\n"
        + "  %45 = slot_addr $1: &string[]  ; b\n"
        + "  release_ptr %45\n"
        + "  %46 = slot_addr $0: &string[]  ; a\n"
        + "  release_ptr %46\n"
        + "  ret %44\n"
        + "\}\n");
}
