// Golden lowering tests for the reads that own what they read: a read retains its value when a
// part of its expression evaluated while the value is in use may replace what it was read from.
import @std.testing;
import support;

test "a local that a later argument assigns is retained until the call returns" {
    let dumped = try support.loweredDump(
        "class Node \{\}\n"
        + "both(Node first, Node second) \{\}\n"
        + "main() -> int \{\n"
        + "    Node b = new Node();\n"
        + "    both(b, b = new Node());\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 b: Node zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Node: Node\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: Node\n"
        + "  retain %1\n"
        + "  %2 = class.new @_dtor$main$Node: Node\n"
        + "  %3 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %3\n"
        + "  store $0, %2\n"
        + "  %4 = load $0: Node\n"
        + "  call @main$both(%1, %4)\n"
        + "  release %1\n"
        + "  %5 = const 0: int\n"
        + "  %6 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %6\n"
        + "  ret %5\n"
        + "\}\n");
}

test "a struct local that a later argument assigns is copied before it is replaced" {
    let dumped = try support.loweredDump(
        "class Node \{\}\n"
        + "struct Box \{\n"
        + "    protected Node node;\n"
        + "\}\n"
        + "pair(Box first, Box second) \{\}\n"
        + "main() -> int \{\n"
        + "    Box box = \{node: new Node()\};\n"
        + "    pair(box, box = \{node: new Node()\});\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 box: Box zeroed\n"
        + "  $1 structlit: Box\n"
        + "  $2 materialized: Box zeroed\n"
        + "  $3 structlit: Box\n"
        + "b0.entry:\n"
        + "  %0 = zero: Box\n"
        + "  store $1, %0\n"
        + "  %1 = slot_addr $1: &Box  ; structlit\n"
        + "  %2 = class.new @_dtor$main$Node: Node\n"
        + "  %3 = field_addr %1, 0: &Node  ; structlit.node\n"
        + "  store_ptr %3, %2\n"
        + "  %4 = take $1: Box\n"
        + "  store $0, %4\n"
        + "  %5 = slot_addr $0: &Box  ; box\n"
        + "  %6 = load_ptr %5: Box\n"
        + "  %7 = field_addr %5, 0: &Node  ; box.node\n"
        + "  retain_ptr %7\n"
        + "  store $2, %6\n"
        + "  %8 = slot_addr $2: &Box  ; materialized\n"
        + "  %9 = load_ptr %8: Box\n"
        + "  %10 = zero: Box\n"
        + "  store $3, %10\n"
        + "  %11 = slot_addr $3: &Box  ; structlit\n"
        + "  %12 = class.new @_dtor$main$Node: Node\n"
        + "  %13 = field_addr %11, 0: &Node  ; structlit.node\n"
        + "  store_ptr %13, %12\n"
        + "  %14 = take $3: Box\n"
        + "  %15 = slot_addr $0: &Box  ; box\n"
        + "  %16 = field_addr %15, 0: &Node  ; box.node\n"
        + "  release_ptr %16\n"
        + "  store $0, %14\n"
        + "  %17 = load $0: Box\n"
        + "  call @main$pair(%9, %17)\n"
        + "  %18 = slot_addr $2: &Box  ; materialized\n"
        + "  %19 = field_addr %18, 0: &Node  ; materialized.node\n"
        + "  release_ptr %19\n"
        + "  %20 = const 0: int\n"
        + "  %21 = slot_addr $0: &Box  ; box\n"
        + "  %22 = field_addr %21, 0: &Node  ; box.node\n"
        + "  release_ptr %22\n"
        + "  ret %20\n"
        + "\}\n");
}

test "the condition of an 'else if' is read under the owned reads of its own statement" {
    let dumped = try support.loweredDump(
        "class Node \{\}\n"
        + "same(Node first, Node second) -> bool \{\n"
        + "    return first == second;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Node b = new Node();\n"
        + "    int count = 0;\n"
        + "    if (count > 0) \{\n"
        + "        return 1;\n"
        + "    \} else if (same(b, b = new Node())) \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 b: Node zeroed\n"
        + "  $1 count: int\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Node: Node\n"
        + "  store $0, %0\n"
        + "  %1 = const 0: int\n"
        + "  store $1, %1\n"
        + "  %2 = load $1: int\n"
        + "  %3 = const 0: int\n"
        + "  %4 = cmp.sgt %2, %3: bool\n"
        + "  br %4, b1.if.then, b2.if.else\n"
        + "b1.if.then:\n"
        + "  %5 = const 1: int\n"
        + "  %6 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %6\n"
        + "  ret %5\n"
        + "b2.if.else:\n"
        + "  %7 = load $0: Node\n"
        + "  retain %7\n"
        + "  %8 = class.new @_dtor$main$Node: Node\n"
        + "  %9 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %9\n"
        + "  store $0, %8\n"
        + "  %10 = load $0: Node\n"
        + "  %11 = call @main$same(%7, %10): bool\n"
        + "  release %7\n"
        + "  br %11, b4.if.then, b5.if.end\n"
        + "b3.if.end:\n"
        + "  %14 = const 0: int\n"
        + "  %15 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %15\n"
        + "  ret %14\n"
        + "b4.if.then:\n"
        + "  %12 = const 2: int\n"
        + "  %13 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %13\n"
        + "  ret %12\n"
        + "b5.if.end:\n"
        + "  jump b3.if.end\n"
        + "\}\n");
}

test "a field read is retained only when a later call may replace the object it is read from" {
    let dumped = try support.loweredDump(
        "class Node \{\n"
        + "    protected string label;\n"
        + "    protected const string fixed;\n"
        + "    protected constructor(this.label, this.fixed);\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Node node;\n"
        + "    protected constructor(this.node);\n"
        + "    protected relabel() -> string \{\n"
        + "        this.node = new Node(\"b\", \"c\");\n"
        + "        return this.node.label;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let h = new Holder(new Node(\"a\", \"c\"));\n"
        + "    bool changed = h.node.label == h.relabel();\n"
        + "    bool same = h.node.label == \"a\";\n"
        + "    bool fixed = h.node.fixed == h.relabel();\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 h: Holder zeroed\n"
        + "  $1 changed: bool\n"
        + "  $2 same: bool\n"
        + "  $3 fixed: bool\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Holder: Holder\n"
        + "  %1 = class.new @_dtor$main$Node: Node\n"
        + "  %2 = const \"a\": string\n"
        + "  %3 = const \"c\": string\n"
        + "  call @main$Node$constructor(this %1, %2, %3)\n"
        + "  call @main$Holder$constructor(this %0, %1)\n"
        + "  release %1\n"
        + "  store $0, %0\n"
        + "  %4 = load $0: Holder\n"
        + "  %5 = object_field_addr %4, 0: &Node  ; %4.node\n"
        + "  %6 = load_ptr %5: Node\n"
        + "  %7 = object_field_addr %6, 0: &string  ; %6.label\n"
        + "  %8 = load_ptr %7: string\n"
        + "  retain %8\n"
        + "  %9 = load $0: Holder\n"
        + "  %10 = call @main$Holder$relabel(this %9): string\n"
        + "  %11 = str.eq %8, %10: bool\n"
        + "  release %8\n"
        + "  release %10\n"
        + "  store $1, %11\n"
        + "  %12 = load $0: Holder\n"
        + "  %13 = object_field_addr %12, 0: &Node  ; %12.node\n"
        + "  %14 = load_ptr %13: Node\n"
        + "  %15 = object_field_addr %14, 0: &string  ; %14.label\n"
        + "  %16 = load_ptr %15: string\n"
        + "  %17 = const \"a\": string\n"
        + "  %18 = str.eq %16, %17: bool\n"
        + "  store $2, %18\n"
        + "  %19 = load $0: Holder\n"
        + "  %20 = object_field_addr %19, 0: &Node  ; %19.node\n"
        + "  %21 = load_ptr %20: Node\n"
        + "  %22 = object_field_addr %21, 1: &string  ; %21.fixed\n"
        + "  %23 = load_ptr %22: string\n"
        + "  retain %23\n"
        + "  %24 = load $0: Holder\n"
        + "  %25 = call @main$Holder$relabel(this %24): string\n"
        + "  %26 = str.eq %23, %25: bool\n"
        + "  release %23\n"
        + "  release %25\n"
        + "  store $3, %26\n"
        + "  %27 = const 0: int\n"
        + "  %28 = slot_addr $0: &Holder  ; h\n"
        + "  release_ptr %28\n"
        + "  ret %27\n"
        + "\}\n");
}

test "a hole whose 'toString' a user wrote keeps its object alive while that runs" {
    let dumped = try support.loweredDump(
        "class Node \{\n"
        + "    protected string label;\n"
        + "    protected constructor(this.label);\n"
        + "    override toString() -> string \{\n"
        + "        return this.label;\n"
        + "    \}\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Node node;\n"
        + "    protected string name;\n"
        + "    protected constructor(this.node, this.name);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let h = new Holder(new Node(\"a\"), \"n\");\n"
        + "    string text = \"\{h.node\} \{h.name\}\";\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 h: Holder zeroed\n"
        + "  $1 text: string zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Holder: Holder\n"
        + "  %1 = class.new @_dtor$main$Node: Node\n"
        + "  %2 = const \"a\": string\n"
        + "  call @main$Node$constructor(this %1, %2)\n"
        + "  %3 = const \"n\": string\n"
        + "  call @main$Holder$constructor(this %0, %1, %3)\n"
        + "  release %1\n"
        + "  store $0, %0\n"
        + "  %4 = const \"\": string\n"
        + "  retain %4\n"
        + "  %5 = load $0: Holder\n"
        + "  %6 = object_field_addr %5, 0: &Node  ; %5.node\n"
        + "  %7 = load_ptr %6: Node\n"
        + "  retain %7\n"
        + "  %8 = call @main$Node$toString(this %7): string\n"
        + "  release %7\n"
        + "  %9 = str.concat %4, %8: string\n"
        + "  release %4\n"
        + "  release %8\n"
        + "  %10 = const \" \": string\n"
        + "  %11 = str.concat %9, %10: string\n"
        + "  release %9\n"
        + "  %12 = load $0: Holder\n"
        + "  %13 = object_field_addr %12, 1: &string  ; %12.name\n"
        + "  %14 = load_ptr %13: string\n"
        + "  retain %14\n"
        + "  %15 = str.concat %11, %14: string\n"
        + "  release %11\n"
        + "  release %14\n"
        + "  store $1, %15\n"
        + "  %16 = const 0: int\n"
        + "  %17 = slot_addr $1: &string  ; text\n"
        + "  release_ptr %17\n"
        + "  %18 = slot_addr $0: &Holder  ; h\n"
        + "  release_ptr %18\n"
        + "  ret %16\n"
        + "\}\n");
}

test "a type switch whose arms run no code reads its scrutinee in place" {
    let dumped = try support.loweredMethodDump(
        "class Shape \{\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int size;\n"
        + "    protected constructor(this.size);\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Shape shape;\n"
        + "    protected constructor(this.shape);\n"
        + "    protected pick() -> int \{\n"
        + "        switch (this.shape) \{\n"
        + "            is Circle circle -> \{\n"
        + "                return circle.size;\n"
        + "            \},\n"
        + "            default -> \{\n"
        + "                return 0;\n"
        + "            \},\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Holder(new Circle(1)).pick();\n"
        + "\}\n", "Holder", "pick");
    try testing.assertEqual(dumped,
        "func @main$Holder$pick(%0: Holder) -> int \{\n"
        + "  $0 circle: Circle borrowed\n"
        + "b0.entry:\n"
        + "  %1 = object_field_addr %0, 0: &Shape  ; %0.shape\n"
        + "  %2 = load_ptr %1: Shape\n"
        + "  %3 = type_test %2 is Circle: bool\n"
        + "  br %3, b1.typeswitch.arm, b3.typeswitch.next\n"
        + "b1.typeswitch.arm:\n"
        + "  %4 = reinterpret %2: Circle\n"
        + "  store $0, %4\n"
        + "  %5 = load $0: Circle\n"
        + "  %6 = object_field_addr %5, 0: &int  ; %5.size\n"
        + "  %7 = load_ptr %6: int\n"
        + "  ret %7\n"
        + "b2.typeswitch.default:\n"
        + "  %8 = const 0: int\n"
        + "  ret %8\n"
        + "b3.typeswitch.next:\n"
        + "  jump b2.typeswitch.default\n"
        + "b4.typeswitch.end:\n"
        + "  unreachable\n"
        + "\}\n");
}

test "a loop variable owns each element when the body may replace an element of the array" {
    let dumped = try support.loweredDump(
        "class Node \{\}\n"
        + "main() -> int \{\n"
        + "    Node[] nodes = [new Node()];\n"
        + "    for (let n in nodes) \{\n"
        + "        nodes[0] = new Node();\n"
        + "        Node kept = n;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 nodes: Node[] zeroed\n"
        + "  $1 iterated: Node[] zeroed\n"
        + "  $2 index: long\n"
        + "  $3 n: Node zeroed\n"
        + "  $4 kept: Node zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 1: long\n"
        + "  %1 = array.new %0: Node[]\n"
        + "  %2 = class.new @_dtor$main$Node: Node\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %1[%3] write\n"
        + "  %4 = element_addr %1[%3]: &Node  ; %1[%3]\n"
        + "  store_ptr %4, %2\n"
        + "  store $0, %1\n"
        + "  %5 = load $0: Node[]\n"
        + "  retain %5\n"
        + "  store $1, %5\n"
        + "  %6 = const 0: long\n"
        + "  store $2, %6\n"
        + "  jump b1.foreach.cond\n"
        + "b1.foreach.cond:\n"
        + "  %7 = load $1: Node[]\n"
        + "  %8 = array.len %7: long\n"
        + "  %9 = load $2: long\n"
        + "  %10 = cmp.slt %9, %8: bool\n"
        + "  br %10, b2.foreach.body, b4.foreach.end\n"
        + "b2.foreach.body:\n"
        + "  %11 = load $1: Node[]\n"
        + "  %12 = load $2: long\n"
        + "  bounds_check %11[%12] read\n"
        + "  %13 = element_addr %11[%12]: &Node  ; %11[%12]\n"
        + "  %14 = load_ptr %13: Node\n"
        + "  retain %14\n"
        + "  store $3, %14\n"
        + "  %15 = load $0: Node[]\n"
        + "  %16 = const 0: int\n"
        + "  %17 = sext %16: long\n"
        + "  bounds_check %15[%17] write\n"
        + "  %18 = element_addr %15[%17]: &Node  ; %15[%17]\n"
        + "  %19 = class.new @_dtor$main$Node: Node\n"
        + "  %20 = take_ptr %18: Node\n"
        + "  store_ptr %18, %19\n"
        + "  release %20\n"
        + "  %21 = load $3: Node\n"
        + "  retain %21\n"
        + "  store $4, %21\n"
        + "  %22 = slot_addr $4: &Node  ; kept\n"
        + "  release_ptr %22\n"
        + "  %23 = slot_addr $3: &Node  ; n\n"
        + "  release_ptr %23\n"
        + "  jump b3.foreach.step\n"
        + "b3.foreach.step:\n"
        + "  %24 = load $2: long\n"
        + "  %25 = const 1: long\n"
        + "  %26 = add %24, %25: long\n"
        + "  store $2, %26\n"
        + "  jump b1.foreach.cond\n"
        + "b4.foreach.end:\n"
        + "  %27 = slot_addr $1: &Node[]  ; iterated\n"
        + "  release_ptr %27\n"
        + "  %28 = const 0: int\n"
        + "  %29 = slot_addr $0: &Node[]  ; nodes\n"
        + "  release_ptr %29\n"
        + "  ret %28\n"
        + "\}\n");
}

test "a loop variable borrows each element when the body runs no code that could replace one" {
    let dumped = try support.loweredDump(
        "class Node \{\}\n"
        + "main() -> int \{\n"
        + "    Node[] nodes = [new Node()];\n"
        + "    int count = 0;\n"
        + "    for (let n in nodes) \{\n"
        + "        Node kept = n;\n"
        + "        count = count + 1;\n"
        + "    \}\n"
        + "    return count;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 nodes: Node[] zeroed\n"
        + "  $1 count: int\n"
        + "  $2 iterated: Node[] zeroed\n"
        + "  $3 index: long\n"
        + "  $4 n: Node borrowed\n"
        + "  $5 kept: Node zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const 1: long\n"
        + "  %1 = array.new %0: Node[]\n"
        + "  %2 = class.new @_dtor$main$Node: Node\n"
        + "  %3 = const 0: long\n"
        + "  bounds_check %1[%3] write\n"
        + "  %4 = element_addr %1[%3]: &Node  ; %1[%3]\n"
        + "  store_ptr %4, %2\n"
        + "  store $0, %1\n"
        + "  %5 = const 0: int\n"
        + "  store $1, %5\n"
        + "  %6 = load $0: Node[]\n"
        + "  retain %6\n"
        + "  store $2, %6\n"
        + "  %7 = const 0: long\n"
        + "  store $3, %7\n"
        + "  jump b1.foreach.cond\n"
        + "b1.foreach.cond:\n"
        + "  %8 = load $2: Node[]\n"
        + "  %9 = array.len %8: long\n"
        + "  %10 = load $3: long\n"
        + "  %11 = cmp.slt %10, %9: bool\n"
        + "  br %11, b2.foreach.body, b4.foreach.end\n"
        + "b2.foreach.body:\n"
        + "  %12 = load $2: Node[]\n"
        + "  %13 = load $3: long\n"
        + "  bounds_check %12[%13] read\n"
        + "  %14 = element_addr %12[%13]: &Node  ; %12[%13]\n"
        + "  %15 = load_ptr %14: Node\n"
        + "  store $4, %15\n"
        + "  %16 = load $4: Node\n"
        + "  retain %16\n"
        + "  store $5, %16\n"
        + "  %17 = load $1: int\n"
        + "  %18 = const 1: int\n"
        + "  %19 = add %17, %18: int\n"
        + "  store $1, %19\n"
        + "  %20 = slot_addr $5: &Node  ; kept\n"
        + "  release_ptr %20\n"
        + "  jump b3.foreach.step\n"
        + "b3.foreach.step:\n"
        + "  %21 = load $3: long\n"
        + "  %22 = const 1: long\n"
        + "  %23 = add %21, %22: long\n"
        + "  store $3, %23\n"
        + "  jump b1.foreach.cond\n"
        + "b4.foreach.end:\n"
        + "  %24 = slot_addr $2: &Node[]  ; iterated\n"
        + "  release_ptr %24\n"
        + "  %25 = load $1: int\n"
        + "  %26 = slot_addr $0: &Node[]  ; nodes\n"
        + "  release_ptr %26\n"
        + "  ret %25\n"
        + "\}\n");
}

// A 'mutating' method called through '?.' on a local runs in place even where an argument sets
// the local to null, because the arguments run before the local is checked again, and the method
// is called only while it still holds a value.
test "a local an argument of a 'mutating' call through '?.' assigns is still changed in place" {
    let source = "class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "    protected long count;\n"
        + "    protected mutating add(long amount) \{\n"
        + "        this.count += amount;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Tally \{\n"
        + "    protected long count;\n"
        + "    protected mutating add(long amount) \{\n"
        + "        this.count += amount;\n"
        + "    \}\n"
        + "\}\n"
        + "taken(bool gone) -> long \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "kept(Cell? cell, Tally? tally) \{\n"
        + "    cell?.add(1);\n"
        + "    tally?.add(1);\n"
        + "\}\n"
        + "cleared(Cell? cell, Tally? tally) \{\n"
        + "    cell?.add(taken((cell = null) == null));\n"
        + "    tally?.add(taken((tally = null) == null));\n"
        + "\}\n"
        + "main() \{\}\n";
    let kept = try support.loweredDump(source, "kept");
    try testing.assertTrue(kept.indexOf("safepayload") < 0, "nothing should be copied: {kept}");
    let cleared = try support.loweredDump(source, "cleared");
    try testing.assertTrue(cleared.indexOf("safepayload") < 0, "nothing should be copied: {cleared}");
    try testing.assertTrue(cleared.indexOf("safecall.cleared:\n") >= 0,
        "a local the arguments set to null should skip the call: {cleared}");
}

// A 'mutating' method called through '?.' on a local changes the local in place, so a read of the
// local in use while the call runs is retained, as it is for a call written with '.'.
test "a read of a local in use while a 'mutating' call through '?.' changes it is retained" {
    let dumped = try support.loweredDump("class Probe \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Cell \{\n"
        + "    protected Probe probe;\n"
        + "    protected mutating replaced() -> long \{\n"
        + "        this.probe = new Probe();\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "shown(Probe probe, long count) \{\}\n"
        + "kept(Cell? cell) \{\n"
        + "    if (cell != null) \{\n"
        + "        shown(cell.probe, cell?.replaced() ?? -1);\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n", "kept");
    try testing.assertEqual(dumped,
        "func internal @main$kept(%0: Cell?) -> void \{\n"
        + "  $0 cell: Cell? zeroed\n"
        + "  $1 safecall: long?\n"
        + "  $2 coalesce: long\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Cell?  ; cell\n"
        + "  %2 = load_ptr %1: Cell?\n"
        + "  %3 = opt.present %2: bool\n"
        + "  br %3, b1.opt.arc, b2.opt.arc.end\n"
        + "b1.opt.arc:\n"
        + "  %4 = opt.payload_addr %1: &Cell\n"
        + "  %5 = field_addr %4, 0: &Probe  ; cell.payload.probe\n"
        + "  retain_ptr %5\n"
        + "  jump b2.opt.arc.end\n"
        + "b2.opt.arc.end:\n"
        + "  %6 = load $0: Cell?\n"
        + "  %7 = const null: null\n"
        + "  %8 = opt.present %6: bool\n"
        + "  %9 = not %8: bool\n"
        + "  %10 = not %9: bool\n"
        + "  br %10, b3.if.then, b4.if.end\n"
        + "b3.if.then:\n"
        + "  %11 = slot_addr $0: &Cell?  ; cell\n"
        + "  %12 = opt.payload_addr %11: &Cell\n"
        + "  %13 = field_addr %12, 0: &Probe  ; cell.payload.probe\n"
        + "  %14 = load_ptr %13: Probe\n"
        + "  retain %14\n"
        + "  %15 = slot_addr $0: &Cell?  ; cell\n"
        + "  %16 = load_ptr %15: Cell?\n"
        + "  %17 = opt.present %16: bool\n"
        + "  br %17, b6.safecall.link, b5.safecall.absent\n"
        + "b4.if.end:\n"
        + "  %28 = slot_addr $0: &Cell?  ; cell\n"
        + "  %29 = load_ptr %28: Cell?\n"
        + "  %30 = opt.present %29: bool\n"
        + "  br %30, b11.opt.arc, b12.opt.arc.end\n"
        + "b5.safecall.absent:\n"
        + "  %21 = opt.absent: long?\n"
        + "  store $1, %21\n"
        + "  jump b7.safecall.end\n"
        + "b6.safecall.link:\n"
        + "  %18 = opt.payload_addr %15: &Cell\n"
        + "  %19 = call @main$Cell$replaced(this %18): long\n"
        + "  %20 = opt.wrap %19: long?\n"
        + "  store $1, %20\n"
        + "  jump b7.safecall.end\n"
        + "b7.safecall.end:\n"
        + "  %22 = load $1: long?\n"
        + "  %23 = opt.present %22: bool\n"
        + "  br %23, b8.coalesce.present, b9.coalesce.absent\n"
        + "b8.coalesce.present:\n"
        + "  %24 = opt.payload move %22: long\n"
        + "  store $2, %24\n"
        + "  jump b10.coalesce.end\n"
        + "b9.coalesce.absent:\n"
        + "  %25 = const 1: long\n"
        + "  %26 = neg %25: long\n"
        + "  store $2, %26\n"
        + "  jump b10.coalesce.end\n"
        + "b10.coalesce.end:\n"
        + "  %27 = load $2: long\n"
        + "  call @main$shown(%14, %27)\n"
        + "  release %14\n"
        + "  jump b4.if.end\n"
        + "b11.opt.arc:\n"
        + "  %31 = opt.payload_addr %28: &Cell\n"
        + "  %32 = field_addr %31, 0: &Probe  ; cell.payload.probe\n"
        + "  release_ptr %32\n"
        + "  jump b12.opt.arc.end\n"
        + "b12.opt.arc.end:\n"
        + "  ret\n"
        + "\}\n");
}
