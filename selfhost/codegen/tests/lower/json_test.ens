// Golden lowering tests for a struct's JSON text form. The goldens pin the concatenation chain and
// the release of every piece it consumes: the accumulator owns a reference from the opening brace
// to the closing one, and the ownership verifier gates each dump, so a leaked or twice-released
// piece fails the test rather than the program.
import @std.testing;
import support;

test "a struct renders as a JSON object built through one owned accumulator" {
    let dumped = try support.loweredDump(
        "struct Entry \{\n"
        + "    int id;\n"
        + "    string name;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Entry e = \{id: 7, name: \"a\"\};\n"
        + "    print(e.toString());\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 e: Entry zeroed\n"
        + "  $1 structlit: Entry zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Entry  ; structlit\n"
        + "  %1 = const 7: int\n"
        + "  %2 = field_addr %0, 0: &int  ; structlit.id\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = const \"a\": string\n"
        + "  %4 = field_addr %0, 1: &string  ; structlit.name\n"
        + "  retain %3\n"
        + "  store_ptr %4, %3\n"
        + "  %5 = load_ptr %0: Entry\n"
        + "  store $0, %5\n"
        + "  %6 = slot_addr $0: &Entry  ; e\n"
        + "  %7 = const \"\{\": string\n"
        + "  retain %7\n"
        + "  %8 = const \"\\\"id\\\": \": string\n"
        + "  %9 = str.concat %7, %8: string\n"
        + "  release %7\n"
        + "  %10 = field_addr %6, 0: &int  ; e.id\n"
        + "  %11 = load_ptr %10: int\n"
        + "  %12 = sext %11: long\n"
        + "  %13 = int.str %12 signed: string\n"
        + "  %14 = str.concat %9, %13: string\n"
        + "  release %9\n"
        + "  release %13\n"
        + "  %15 = const \", \\\"name\\\": \": string\n"
        + "  %16 = str.concat %14, %15: string\n"
        + "  release %14\n"
        + "  %17 = field_addr %6, 1: &string  ; e.name\n"
        + "  %18 = load_ptr %17: string\n"
        + "  %19 = json.escape %18: string\n"
        + "  %20 = str.concat %16, %19: string\n"
        + "  release %16\n"
        + "  release %19\n"
        + "  %21 = const \"\}\": string\n"
        + "  %22 = str.concat %20, %21: string\n"
        + "  release %20\n"
        + "  print %22\n"
        + "  release %22\n"
        + "  %23 = const 0: int\n"
        + "  %24 = slot_addr $0: &Entry  ; e\n"
        + "  %25 = field_addr %24, 1: &string  ; e.name\n"
        + "  release_ptr %25\n"
        + "  ret %23\n"
        + "\}\n");
}

test "a char field becomes a one-character string before it is escaped" {
    let dumped = try support.loweredDump(
        "struct Glyph \{\n"
        + "    char letter;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Glyph g = \{letter: 'A'\};\n"
        + "    print(\"\{g\}\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 g: Glyph zeroed\n"
        + "  $1 structlit: Glyph zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Glyph  ; structlit\n"
        + "  %1 = const 65: char\n"
        + "  %2 = field_addr %0, 0: &char  ; structlit.letter\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = load_ptr %0: Glyph\n"
        + "  store $0, %3\n"
        + "  %4 = const \"\": string\n"
        + "  retain %4\n"
        + "  %5 = slot_addr $0: &Glyph  ; g\n"
        + "  %6 = const \"\{\": string\n"
        + "  retain %6\n"
        + "  %7 = const \"\\\"letter\\\": \": string\n"
        + "  %8 = str.concat %6, %7: string\n"
        + "  release %6\n"
        + "  %9 = field_addr %5, 0: &char  ; g.letter\n"
        + "  %10 = load_ptr %9: char\n"
        + "  %11 = char.str %10: string\n"
        + "  %12 = json.escape %11: string\n"
        + "  release %11\n"
        + "  %13 = str.concat %8, %12: string\n"
        + "  release %8\n"
        + "  release %12\n"
        + "  %14 = const \"\}\": string\n"
        + "  %15 = str.concat %13, %14: string\n"
        + "  release %13\n"
        + "  %16 = str.concat %4, %15: string\n"
        + "  release %4\n"
        + "  release %15\n"
        + "  print %16\n"
        + "  release %16\n"
        + "  %17 = const 0: int\n"
        + "  ret %17\n"
        + "\}\n");
}

test "an enum field becomes its member name before it is escaped" {
    let dumped = try support.loweredDump(
        "enum Suit \{ Clubs, Hearts \}\n"
        + "struct Card \{\n"
        + "    Suit suit;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Card c = \{suit: Suit.Hearts\};\n"
        + "    print(c.toString());\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 c: Card zeroed\n"
        + "  $1 structlit: Card zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Card  ; structlit\n"
        + "  %1 = const 1: Suit\n"
        + "  %2 = field_addr %0, 0: &Suit  ; structlit.suit\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = load_ptr %0: Card\n"
        + "  store $0, %3\n"
        + "  %4 = slot_addr $0: &Card  ; c\n"
        + "  %5 = const \"\{\": string\n"
        + "  retain %5\n"
        + "  %6 = const \"\\\"suit\\\": \": string\n"
        + "  %7 = str.concat %5, %6: string\n"
        + "  release %5\n"
        + "  %8 = field_addr %4, 0: &Suit  ; c.suit\n"
        + "  %9 = load_ptr %8: Suit\n"
        + "  %10 = enum.str %9 Suit: string\n"
        + "  %11 = json.escape %10: string\n"
        + "  release %10\n"
        + "  %12 = str.concat %7, %11: string\n"
        + "  release %7\n"
        + "  release %11\n"
        + "  %13 = const \"\}\": string\n"
        + "  %14 = str.concat %12, %13: string\n"
        + "  release %12\n"
        + "  print %14\n"
        + "  release %14\n"
        + "  %15 = const 0: int\n"
        + "  ret %15\n"
        + "\}\n");
}

test "a struct declaring toString renders through a call to it, not a concatenation" {
    let dumped = try support.loweredDump(
        "struct Entry \{\n"
        + "    int id;\n"
        + "\n"
        + "    protected toString() -> string \{\n"
        + "        return \"entry\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Entry e = \{id: 7\};\n"
        + "    print(\"\{e\}\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 e: Entry zeroed\n"
        + "  $1 structlit: Entry zeroed\n"
        + "b0.entry:\n"
        + "  %0 = slot_addr $1: &Entry  ; structlit\n"
        + "  %1 = const 7: int\n"
        + "  %2 = field_addr %0, 0: &int  ; structlit.id\n"
        + "  store_ptr %2, %1\n"
        + "  %3 = load_ptr %0: Entry\n"
        + "  store $0, %3\n"
        + "  %4 = const \"\": string\n"
        + "  retain %4\n"
        + "  %5 = slot_addr $0: &Entry  ; e\n"
        + "  %6 = call @main$Entry$toString(this %5): string\n"
        + "  %7 = str.concat %4, %6: string\n"
        + "  release %4\n"
        + "  release %6\n"
        + "  print %7\n"
        + "  release %7\n"
        + "  %8 = const 0: int\n"
        + "  ret %8\n"
        + "\}\n");
}

test "a struct declaring toString needs no JSON form for its fields" {
    let dumped = try support.loweredDump(
        "struct Entry \{\n"
        + "    int[] items;\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return \"\{this\}\";\n"
        + "    \}\n"
        + "\n"
        + "    protected toString() -> string \{\n"
        + "        return \"entry\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(
        dumped.indexOf("call @main$Entry$toString(this %0): string") >= 0,
        "the receiver address should reach the declared method: {dumped}");
    try testing.assertTrue(dumped.indexOf("json.escape") < 0,
        "nothing should be serialized: {dumped}");
}

test "a field with no JSON form names the struct, the field, and its type" {
    let message = try support.loweringFailure(
        "struct Card \{\n"
        + "    int? bonus;\n"
        + "\n"
        + "    describe() -> string \{\n"
        + "        return this.toString();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(
        message.indexOf("converting 'Card' to text: its field 'bonus' has type 'int?'") >= 0,
        "unexpected message: {message}");
}

test "a nested struct field renders in place through its own field address" {
    let dumped = try support.loweredDump(
        "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "struct Shape \{\n"
        + "    Point origin;\n"
        + "    bool filled;\n"
        + "\}\n"
        + "render(Shape s) -> string \{\n"
        + "    return s.toString();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(render(\{origin: \{x: 2\}, filled: true\}));\n"
        + "    return 0;\n"
        + "\}\n", "render");
    try testing.assertEqual(dumped,
        "func internal @render(%0: Shape) -> string \{\n"
        + "  $0 s: Shape zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = slot_addr $0: &Shape  ; s\n"
        + "  %2 = const \"\{\": string\n"
        + "  retain %2\n"
        + "  %3 = const \"\\\"origin\\\": \": string\n"
        + "  %4 = str.concat %2, %3: string\n"
        + "  release %2\n"
        + "  %5 = field_addr %1, 0: &Point  ; s.origin\n"
        + "  %6 = const \"\{\": string\n"
        + "  retain %6\n"
        + "  %7 = const \"\\\"x\\\": \": string\n"
        + "  %8 = str.concat %6, %7: string\n"
        + "  release %6\n"
        + "  %9 = field_addr %5, 0: &int  ; s.origin.x\n"
        + "  %10 = load_ptr %9: int\n"
        + "  %11 = sext %10: long\n"
        + "  %12 = int.str %11 signed: string\n"
        + "  %13 = str.concat %8, %12: string\n"
        + "  release %8\n"
        + "  release %12\n"
        + "  %14 = const \"\}\": string\n"
        + "  %15 = str.concat %13, %14: string\n"
        + "  release %13\n"
        + "  %16 = str.concat %4, %15: string\n"
        + "  release %4\n"
        + "  release %15\n"
        + "  %17 = const \", \\\"filled\\\": \": string\n"
        + "  %18 = str.concat %16, %17: string\n"
        + "  release %16\n"
        + "  %19 = field_addr %1, 1: &bool  ; s.filled\n"
        + "  %20 = load_ptr %19: bool\n"
        + "  %21 = bool.str %20: string\n"
        + "  %22 = str.concat %18, %21: string\n"
        + "  release %18\n"
        + "  release %21\n"
        + "  %23 = const \"\}\": string\n"
        + "  %24 = str.concat %22, %23: string\n"
        + "  release %22\n"
        + "  ret %24\n"
        + "\}\n");
}
