// Golden lowering tests for an assignment read as a value: the write, then the target read back.
import @std.testing;
import support;

test "an assignment used as a receiver reads its target back after the write" {
    let dumped = try support.loweredDump(
        "class Node \{\n"
        + "    protected step() -> Node? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Node b = new Node();\n"
        + "    Node? r = (b = new Node()).step();\n"
        + "    b = new Node();\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 b: Node zeroed\n"
        + "  $1 r: Node? zeroed\n"
        + "b0.entry:\n"
        + "  %0 = class.new @_dtor$main$Node: Node\n"
        + "  store $0, %0\n"
        + "  %1 = class.new @_dtor$main$Node: Node\n"
        + "  %2 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %2\n"
        + "  store $0, %1\n"
        + "  %3 = load $0: Node\n"
        + "  %4 = call @main$Node$step(this %3): Node?\n"
        + "  store $1, %4\n"
        + "  %5 = class.new @_dtor$main$Node: Node\n"
        + "  %6 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %6\n"
        + "  store $0, %5\n"
        + "  %7 = const 0: int\n"
        + "  %8 = slot_addr $1: &Node?  ; r\n"
        + "  release_ptr %8\n"
        + "  %9 = slot_addr $0: &Node  ; b\n"
        + "  release_ptr %9\n"
        + "  ret %7\n"
        + "\}\n");
}
