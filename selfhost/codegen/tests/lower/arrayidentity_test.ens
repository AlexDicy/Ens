// The '@std.parallel' intercept: whether two arrays are one array is a comparison of the two
// references, so the library's placeholder body never runs.
import @std.testing;
import MemoryFileLoader from support;
import support;

test "whether two arrays are one is a comparison of their references" {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/parallel.ens", "export final class Storage \{\n"
        + "    export constructor();\n"
        + "\n"
        + "    export same<A, B>(A[] first, B[] second) -> bool \{\n"
        + "        return false;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/src/main.ens", "import Storage from @std.parallel;\n"
        + "main() -> int \{\n"
        + "    int[] first = [1];\n"
        + "    long[] second = [1];\n"
        + "    bool same = new Storage().same(first, second);\n"
        + "    return same ? 1 : 0;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(dumped.indexOf("Storage$same") < 0,
        "no placeholder body is called: {dumped}");
    try testing.assertTrue(dumped.indexOf(" = reinterpret ") > 0 && dumped.indexOf(" = cmp.eq ") > 0,
        "the second reference is compared with the first: {dumped}");
}
