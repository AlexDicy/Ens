// Golden lowering tests for strings, where the goldens pin retain and release placement: a leak
// or a double release shows up as a diff here, and the ownership verifier gates every dump.
import @std.testing;
import support;

test "a string literal borrows its immortal bytes and print releases nothing" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    print(\"hi\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"hi\": string\n"
        + "  print %0\n"
        + "  %1 = const 0: int\n"
        + "  ret %1\n"
        + "\}\n");
}

test "a string an argument built for one call is released once the call has run" {
    let dumped = try support.loweredDump(
        "takes(string s) -> long \{\n"
        + "    return s.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return takes(\"a\" + \"b\") as int;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"a\": string\n"
        + "  retain %0\n"
        + "  %1 = const \"b\": string\n"
        + "  retain %1\n"
        + "  %2 = str.concat %0, %1: string\n"
        + "  release %0\n"
        + "  release %1\n"
        + "  %3 = call @main$takes(%2): long\n"
        + "  release %2\n"
        + "  %4 = trunc %3: int\n"
        + "  ret %4\n"
        + "\}\n");
}

test "a concatenated local takes the produced reference and gives it up at the end" {
    let dumped = try support.loweredDump(
        "greet(string name) -> string \{\n"
        + "    let greeting = \"Hello, \" + name;\n"
        + "    return greeting;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(greet(\"world\"));\n"
        + "    return 0;\n"
        + "\}\n", "greet");
    try testing.assertEqual(dumped,
        "func internal @main$greet(%0: string) -> string \{\n"
        + "  $0 name: string borrowed\n"
        + "  $1 greeting: string zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = const \"Hello, \": string\n"
        + "  retain %1\n"
        + "  %2 = load $0: string\n"
        + "  retain %2\n"
        + "  %3 = str.concat %1, %2: string\n"
        + "  release %1\n"
        + "  release %2\n"
        + "  store $1, %3\n"
        + "  %4 = load $1: string\n"
        + "  retain %4\n"
        + "  %5 = slot_addr $1: &string  ; greeting\n"
        + "  release_ptr %5\n"
        + "  ret %4\n"
        + "\}\n");
}

test "interpolation folds through one owned accumulator" {
    let dumped = try support.loweredDump(
        "label(int n) -> string \{\n"
        + "    return \"n=\{n\}!\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(label(2));\n"
        + "    return 0;\n"
        + "\}\n", "label");
    try testing.assertEqual(dumped,
        "func internal @main$label(%0: int) -> string \{\n"
        + "  $0 n: int\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = const \"n=\": string\n"
        + "  retain %1\n"
        + "  %2 = load $0: int\n"
        + "  %3 = sext %2: long\n"
        + "  %4 = int.str %3 signed: string\n"
        + "  %5 = str.concat %1, %4: string\n"
        + "  release %1\n"
        + "  release %4\n"
        + "  %6 = const \"!\": string\n"
        + "  %7 = str.concat %5, %6: string\n"
        + "  release %5\n"
        + "  ret %7\n"
        + "\}\n");
}

test "comparison and length read a borrowed parameter without touching its refcount" {
    let dumped = try support.loweredDump(
        "same(string a) -> long \{\n"
        + "    if (a == \"x\") \{\n"
        + "        return a.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return same(\"x\") as int;\n"
        + "\}\n", "same");
    try testing.assertEqual(dumped,
        "func internal @main$same(%0: string) -> long \{\n"
        + "  $0 a: string borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: string\n"
        + "  %2 = const \"x\": string\n"
        + "  %3 = str.eq %1, %2: bool\n"
        + "  br %3, b1.if.then, b2.if.end\n"
        + "b1.if.then:\n"
        + "  %4 = load $0: string\n"
        + "  %5 = str.len %4: long\n"
        + "  ret %5\n"
        + "b2.if.end:\n"
        + "  %6 = const 0: long\n"
        + "  ret %6\n"
        + "\}\n");
}

test "a reassigned string parameter owns its slot instead of borrowing it" {
    let dumped = try support.loweredDump(
        "rename(string name) -> long \{\n"
        + "    name = \"fixed\";\n"
        + "    return name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return rename(\"x\") as int;\n"
        + "\}\n", "rename");
    try testing.assertEqual(dumped,
        "func internal @main$rename(%0: string) -> long \{\n"
        + "  $0 name: string zeroed\n"
        + "b0.entry:\n"
        + "  retain %0\n"
        + "  store $0, %0\n"
        + "  %1 = const \"fixed\": string\n"
        + "  retain %1\n"
        + "  %2 = slot_addr $0: &string  ; name\n"
        + "  release_ptr %2\n"
        + "  store $0, %1\n"
        + "  %3 = load $0: string\n"
        + "  %4 = str.len %3: long\n"
        + "  %5 = slot_addr $0: &string  ; name\n"
        + "  release_ptr %5\n"
        + "  ret %4\n"
        + "\}\n");
}

test "appending to a string local retains the old text before it is joined and released" {
    let dumped = try support.loweredDump(
        "grow(string name) -> string \{\n"
        + "    string text = \"Hello, \";\n"
        + "    text += name;\n"
        + "    return text;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(grow(\"world\"));\n"
        + "    return 0;\n"
        + "\}\n", "grow");
    try testing.assertEqual(dumped,
        "func internal @main$grow(%0: string) -> string \{\n"
        + "  $0 name: string borrowed\n"
        + "  $1 text: string zeroed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  %1 = const \"Hello, \": string\n"
        + "  retain %1\n"
        + "  store $1, %1\n"
        + "  %2 = load $1: string\n"
        + "  retain %2\n"
        + "  %3 = load $0: string\n"
        + "  retain %3\n"
        + "  %4 = str.concat %2, %3: string\n"
        + "  release %2\n"
        + "  release %3\n"
        + "  %5 = slot_addr $1: &string  ; text\n"
        + "  release_ptr %5\n"
        + "  store $1, %4\n"
        + "  %6 = load $1: string\n"
        + "  retain %6\n"
        + "  %7 = slot_addr $1: &string  ; text\n"
        + "  release_ptr %7\n"
        + "  ret %6\n"
        + "\}\n");
}

test "appending to an array element writes back through the element's address" {
    let dumped = try support.loweredDump(
        "extend(string[] parts, string extra) \{\n"
        + "    parts[0] += extra;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    string[] parts = new string[1];\n"
        + "    for (long i = 0; i < parts.length; i++) \{ parts[i] = \"a\"; \}\n"
        + "    extend(parts, \"x\");\n"
        + "    return 0;\n"
        + "\}\n", "extend");
    try testing.assertEqual(dumped,
        "func internal @main$extend(%0: string[], %1: string) -> void \{\n"
        + "  $0 parts: string[] borrowed\n"
        + "  $1 extra: string borrowed\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  store $1, %1\n"
        + "  %2 = load $0: string[]\n"
        + "  %3 = const 0: int\n"
        + "  %4 = sext %3: long\n"
        + "  bounds_check %2[%4]\n"
        + "  %5 = element_addr %2[%4]: &string  ; %2[%4]\n"
        + "  %6 = load_ptr %5: string\n"
        + "  retain %6\n"
        + "  %7 = load $1: string\n"
        + "  retain %7\n"
        + "  %8 = str.concat %6, %7: string\n"
        + "  release %6\n"
        + "  release %7\n"
        + "  release_ptr %5\n"
        + "  store_ptr %5, %8\n"
        + "  ret\n"
        + "\}\n");
}

test "an escaped literal decodes to its bytes" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    print(\"a\\tb\\u00e9\\n\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("const \"a\\tbé\\n\": string") >= 0,
        "unexpected dump: {dumped}");
}

// The shape of the arc_string fixture: a loop that builds a concatenation, an interpolation, and
// a byte round-trip every iteration. Ownership has to balance per iteration, not just per
// function, or the loop leaks.
test "a loop building derived strings balances every iteration" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    let i = 0;\n"
        + "    let matched = 0;\n"
        + "    while (i < 1000) \{\n"
        + "        let s = \"item-\{i\}-\" + (i * 2).toString();\n"
        + "        let restored = string.fromBytes(s.toBytes());\n"
        + "        if (restored == s) \{ matched = matched + 1; \}\n"
        + "        i = i + 1;\n"
        + "    \}\n"
        + "    return matched - 1000;\n"
        + "\}\n", "main");
    try testing.assertTrue(dumped.indexOf("bytes.str") >= 0,
        "the byte round-trip should lower: {dumped}");
    try testing.assertTrue(dumped.indexOf("str.eq") >= 0,
        "the comparison should lower: {dumped}");
}

test "compareTo gives up the string it was built from and borrows the literal" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    return (\"a\" + \"b\").compareTo(\"ab\");\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"a\": string\n"
        + "  retain %0\n"
        + "  %1 = const \"b\": string\n"
        + "  retain %1\n"
        + "  %2 = str.concat %0, %1: string\n"
        + "  release %0\n"
        + "  release %1\n"
        + "  %3 = const \"ab\": string\n"
        + "  %4 = str.compare %2, %3: int\n"
        + "  release %2\n"
        + "  ret %4\n"
        + "\}\n");
}

test "trim produces a string of its own and leaves the text it read borrowed" {
    let dumped = try support.loweredDump(
        "main() -> int \{\n"
        + "    let padded = \" x \";\n"
        + "    print(padded.trim());\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "  $0 padded: string zeroed\n"
        + "b0.entry:\n"
        + "  %0 = const \" x \": string\n"
        + "  retain %0\n"
        + "  store $0, %0\n"
        + "  %1 = load $0: string\n"
        + "  %2 = str.trim %1: string\n"
        + "  print %2\n"
        + "  release %2\n"
        + "  %3 = const 0: int\n"
        + "  %4 = slot_addr $0: &string  ; padded\n"
        + "  release_ptr %4\n"
        + "  ret %3\n"
        + "\}\n");
}

test "a discarded string result is released where the statement ends" {
    let dumped = try support.loweredDump(
        "build(string a) -> string \{\n"
        + "    return a + \"!\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    build(\"x\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"x\": string\n"
        + "  %1 = call @main$build(%0): string\n"
        + "  release %1\n"
        + "  %2 = const 0: int\n"
        + "  ret %2\n"
        + "\}\n");
}

test "a class hole with one runtime type and no override folds the type name" {
    let dumped = try support.loweredDump(
        "class Leaf \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "describe(Leaf value) -> string \{\n"
        + "    return \"seen \{value\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(new Leaf()));\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(dumped.indexOf("const \"Leaf\"") >= 0,
        "the default should fold to the type name: {dumped}");
    try testing.assertTrue(dumped.indexOf("dynamic_tostring") < 0,
        "one possible runtime type needs no dispatch: {dumped}");
}

test "a class hole with subclasses reads the text off the runtime type" {
    let dumped = try support.loweredDump(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "describe(Base value) -> string \{\n"
        + "    return \"seen \{value\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(new Derived()));\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(dumped.indexOf("dynamic_tostring") >= 0,
        "more than one runtime type is possible, so the descriptor decides: {dumped}");
    try testing.assertTrue(dumped.indexOf("const \"Base\"") < 0,
        "the static type's name must not stand in: {dumped}");
}

test "a declared override with one runtime type is called without a descriptor" {
    let dumped = try support.loweredDump(
        "class Leaf \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"leaf\";\n"
        + "    \}\n"
        + "\}\n"
        + "describe(Leaf value) -> string \{\n"
        + "    return \"seen \{value\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(new Leaf()));\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(dumped.indexOf("call @main$Leaf$toString(this %") >= 0,
        "the declaration should answer through a direct call: {dumped}");
    try testing.assertTrue(dumped.indexOf("dynamic_tostring") < 0,
        "one possible runtime type needs no dispatch: {dumped}");
}

test "a toString without the override marker stays outside the hole dispatch" {
    let dumped = try support.loweredDump(
        "class Legacy \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    toString() -> string \{\n"
        + "        return \"legacy\";\n"
        + "    \}\n"
        + "\}\n"
        + "describe(Legacy value) -> string \{\n"
        + "    return \"seen \{value\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(new Legacy()));\n"
        + "    return 0;\n"
        + "\}\n", "describe");
    try testing.assertTrue(dumped.indexOf("const \"Legacy\"") >= 0,
        "the hole should fold the type name: {dumped}");
    try testing.assertTrue(dumped.indexOf("call @main$Legacy$toString") < 0,
        "an unmarked toString is never called by a hole: {dumped}");
}
