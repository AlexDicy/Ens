// 'frozen()' on a standard-library collection: the call takes a reference of its own for the
// take-or-copy, so a collection at its last use becomes the frozen one's contents.
import @std.testing;
import MemoryFileLoader from support;
import OptimizationLevel from settings;
import support;

test "'frozen()' takes the list, copying it with 'copy' when another owner holds it" {
    let loader = collectionsLoader("import List from @std.collections.list;\n"
        + "main() -> int \{\n"
        + "    let fresh = new List<int>().frozen();\n"
        + "    let kept = new List<int>();\n"
        + "    let frozen = kept.frozen();\n"
        + "    return (kept.count + frozen.items.count) as int;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    try testing.assertTrue(dumped.indexOf("  %1 = take.or.copy %0, "
        + "@std.collections.list$List__int___copy: List<int>\n"
        + "  %2 = call @std.collections.list$List__int___frozenWithoutCopy(this %1)") > 0,
        "a fresh list is taken and wrapped without a copy: {dumped}");
    try testing.assertTrue(dumped.indexOf("  %4 = load $1: List<int>\n  retain %4\n"
        + "  %5 = take.or.copy %4, ") > 0,
        "the list a variable holds is retained for the take: {dumped}");
}

test "a variable read for the last time by 'frozen()' moves into the take" {
    let program = try support.lowerLoadedProgram(try support.analyzeLoaded(lastUseLoader()));
    let moved = try support.optimizedDump(program, "main$build");
    try testing.assertTrue(moved.indexOf(" = take.or.copy ") > 0 && moved.indexOf("retain") < 0,
        "the last read gives the list to the take: {moved}");
    let read = try support.optimizedDump(program, "main$kept");
    try testing.assertTrue(read.indexOf("retain") > 0,
        "a variable read again keeps its own reference, so the take copies: {read}");
}

test "the account names each 'frozen()' that copies, and none that takes the storage" {
    let program = try support.lowerLoadedProgram(try support.analyzeLoaded(lastUseLoader()));
    string[] everyPass = [];
    let explained = support.settingsAt(OptimizationLevel.Default, everyPass, true);
    let copied = (try support.pipelineOutcome(program, "main$kept", explained)).account();
    try testing.assertTrue(copied.length > 0 && copied[copied.length - 1] == "  line 11: "
        + "'frozen()' copies the 'List<int>' instead of taking its storage, because something "
        + "else still refers to it", "the account names the freeze that copies: {copied}");
    for (let line in (try support.pipelineOutcome(program, "main$build", explained)).account()) {
        try testing.assertTrue(!line.contains("'frozen()'"),
            "the account names no freeze that takes the storage: {line}");
    }
}

test "'frozen()' on an array takes it, copying it with 'FrozenList.copied' when it is shared" {
    let loader = collectionsLoader("main() -> int \{\n"
        + "    int[] values = [1];\n"
        + "    let frozen = values.frozen();\n"
        + "    return frozen.items.count as int;\n"
        + "\}\n");
    let analysis = try support.analyzeLoaded(loader);
    let dumped = try support.loweredLoadedSymbolDump(analysis, "ens.main");
    long taken = dumped.indexOf(" = take.or.copy %");
    long copied = dumped.indexOf(", @std.collections.frozen$FrozenList__int___copied: int[]\n");
    long wrapped = dumped.indexOf(" = call @std.collections.frozen$FrozenList__int___wrapping(%");
    try testing.assertTrue(taken > 0 && copied > taken && wrapped > copied,
        "the array is taken, or copied by 'copied', and wrapped: {dumped}");
}

test "an array read for the last time by 'frozen()' moves into the take" {
    let loader = collectionsLoader("import FrozenList from @std.collections.frozen;\n"
        + "build(long length) -> FrozenList<long> \{\n"
        + "    long[] values = new long[length];\n"
        + "    return values.frozen();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return build(2).items.count as int;\n"
        + "\}\n");
    let program = try support.lowerLoadedProgram(try support.analyzeLoaded(loader));
    let moved = try support.optimizedDump(program, "main$build");
    try testing.assertTrue(moved.indexOf(" = take.or.copy ") > 0 && moved.indexOf("retain") < 0,
        "the last read gives the array to the take: {moved}");
}

// One list frozen at its last read, and one read again after it is frozen.
lastUseLoader() -> MemoryFileLoader {
    return collectionsLoader("import List from @std.collections.list;\n"
        + "import FrozenList from @std.collections.frozen;\n"
        + "build() -> FrozenList<int> \{\n"
        + "    let list = new List<int>();\n"
        + "    list.count = 2;\n"
        + "    return list.frozen();\n"
        + "\}\n"
        + "\n"
        + "kept() -> long \{\n"
        + "    let list = new List<int>();\n"
        + "    let frozen = list.frozen();\n"
        + "    return frozen.items.count + list.count;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return (build().items.count + kept()) as int;\n"
        + "\}\n");
}

// A program over stand-ins for the list and the frozen list of '@std.collections'.
collectionsLoader(string mainSource) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/src/collections/list.ens",
        "import FrozenList from @std.collections.frozen;\n"
        + "export final class List<T> \{\n"
        + "    export long count = 0;\n"
        + "\n"
        + "    export constructor();\n"
        + "\n"
        + "    export copy() -> List<T> \{\n"
        + "        let result = new List<T>();\n"
        + "        result.count = this.count;\n"
        + "        return result;\n"
        + "    \}\n"
        + "\n"
        + "    export frozen() -> FrozenList<T> \{\n"
        + "        return new FrozenList<T>(this.copy());\n"
        + "    \}\n"
        + "\n"
        + "    public frozenWithoutCopy() -> FrozenList<T> \{\n"
        + "        return new FrozenList<T>(this);\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/stdlib/std/src/collections/frozen.ens",
        "import List from @std.collections.list;\n"
        + "export final class FrozenList<T> \{\n"
        + "    export List<T> items;\n"
        + "\n"
        + "    public constructor(this.items);\n"
        + "\n"
        + "    public static wrapping(T[] values) -> FrozenList<T> \{\n"
        + "        return new FrozenList<T>(new List<T>());\n"
        + "    \}\n"
        + "\n"
        + "    public static copied(T[] values) -> T[] \{\n"
        + "        return values;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/src/main.ens", mainSource);
    return loader;
}
