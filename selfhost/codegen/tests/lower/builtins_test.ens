// Lowering the free functions the language provides. The interception is keyed on the entry a call
// resolved to, never on the name, so a module that declares 'print' or 'panic' of its own is
// lowered as an ordinary call while a sibling module still reaches the intrinsic.
import @std.testing;
import MemoryFileLoader from support;
import support;

// A program whose 'own' module declares something of the language's own names and whose 'plain'
// module declares nothing.
twoModules(string ownText) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/own.ens", ownText);
    loader.add("/src/plain.ens",
        "public write(string text) \{\n"
        + "    print(text);\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import own;\n"
        + "import plain;\n"
        + "main() -> int \{\n"
        + "    print(\"main\");\n"
        + "    own.speak(\"own\");\n"
        + "    plain.write(\"plain\");\n"
        + "    return 0;\n"
        + "\}\n");
    return loader;
}

test "a declared 'print' lowers as a call while a sibling module reaches the intrinsic" {
    let analysis = try support.analyzeLoaded(twoModules(
        "import plain;\n"
        + "public print(string message) \{\n"
        + "    plain.write(\"own: \" + message);\n"
        + "\}\n"
        + "public speak(string message) \{\n"
        + "    print(message);\n"
        + "\}\n"));
    let speak = try support.loweredLoadedSymbolDump(analysis, "own$speak");
    try testing.assertTrue(speak.indexOf("call @own$print(") >= 0,
        "the module's own 'print' answers its calls: {speak}");
    try testing.assertTrue(speak.indexOf("print %") < 0,
        "nothing in that module lowers to the intrinsic: {speak}");
    let write = try support.loweredLoadedSymbolDump(analysis, "plain$write");
    try testing.assertTrue(write.indexOf("print %") >= 0,
        "a module that declares nothing still reaches the intrinsic: {write}");
    let entry = try support.loweredLoadedDump(analysis, "main");
    try testing.assertTrue(entry.indexOf("print %") >= 0,
        "so does the main module: {entry}");
}

test "a declared 'panic' lowers as a call the block continues after" {
    let analysis = try support.analyzeLoaded(twoModules(
        "import plain;\n"
        + "public panic(string message) \{\n"
        + "    plain.write(\"own: \" + message);\n"
        + "\}\n"
        + "public speak(string message) \{\n"
        + "    panic(message);\n"
        + "    plain.write(\"after\");\n"
        + "\}\n"));
    let speak = try support.loweredLoadedSymbolDump(analysis, "own$speak");
    try testing.assertTrue(speak.indexOf("call @own$panic(") >= 0,
        "the module's own 'panic' answers its calls: {speak}");
    try testing.assertTrue(speak.indexOf("panic %") < 0,
        "nothing in that module aborts: {speak}");
    try testing.assertTrue(speak.indexOf("call @plain$write(") >= 0,
        "the statement after the call is lowered: {speak}");
}

test "the provided 'panic' still lowers to the abort" {
    let dumped = try support.loweredDump(
        "fail() -> int \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return fail();\n"
        + "\}\n", "fail");
    try testing.assertEqual(dumped,
        "func internal @main$fail() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const \"stop\": string\n"
        + "  panic %0\n"
        + "  unreachable\n"
        + "\}\n");
}

test "an overload beside the provided 'print' lowers to whichever the call resolved to" {
    let dumped = try support.loweredDump(
        "print(long count) \{\n"
        + "    print(\"count\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(7L);\n"
        + "    print(\"text\");\n"
        + "    return 0;\n"
        + "\}\n", "main");
    try testing.assertEqual(dumped,
        "func internal @ens.main() -> int \{\n"
        + "b0.entry:\n"
        + "  %0 = const 7: long\n"
        + "  call @main$print$long(%0)\n"
        + "  %1 = const \"text\": string\n"
        + "  print %1\n"
        + "  %2 = const 0: int\n"
        + "  ret %2\n"
        + "\}\n");
}
