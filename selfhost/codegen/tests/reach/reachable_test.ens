// The walk itself, one test per kind of EIR node that names something. Each program reaches the
// body under test through the node the test is about and through nothing else, so a node the walk
// stops reading leaves that body unreached.
import @std.testing;
import TestFailure from @std.testing;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import EirDynamicEquals from eir.model;
import EirFunction from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirInstruction from eir.model;
import EirRuntimeTypeName from eir.model;
import eir.walk;
import DescriptorPlan from layout.descriptors;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import SlotKind from reach.reachable;
import reach.reachable;
import LoweredProgram from support;
import MemoryFileLoader from support;
import support;
import List from @std.collections.list;

test "a call names its callee and a call nothing makes names nobody" {
    let program = try support.lowerWholeProgram(
        "called() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "uncalled() -> int \{\n"
        + "    return called();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return called();\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("main$called"), "the entry point calls 'called'");
    try testing.assertFalse(reached.reaches("main$uncalled"),
        "a function that calls a reached one is not reached itself");
}

test "a throwing call names its callee from the terminator that ends the block" {
    let program = try support.lowerWholeProgram(
        "refuses() -> int throws \{\n"
        + "    throw new Error(\"no\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try refuses();\n"
        + "\} catch (Error caught) \{\n"
        + "    return 1;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("main$refuses"), "the try call names its callee");
    try testing.assertTrue(try namesSymbol(program, "ens.main", "main$refuses"),
        "the entry point's terminator is what names it");
}

test "a class allocation names the destructor of the class it makes" {
    let program = try support.lowerWholeProgram(
        "class Made \{\n"
        + "    protected string held;\n"
        + "\n"
        + "    protected constructor(this.held);\n"
        + "\}\n"
        + "class Unmade \{\n"
        + "    protected string held;\n"
        + "\n"
        + "    protected constructor(this.held);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let made = new Made(\"a\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("_dtor$main$Made"),
        "the allocation names the destructor its object header carries");
    try testing.assertFalse(reached.reaches("_dtor$main$Unmade"),
        "a class nothing allocates has no reference to its destructor");
    try testing.assertFalse(reached.reaches("main$Unmade$constructor"),
        "nor to its constructor");
}

test "a synthesized destructor names the one the class writes" {
    let program = try support.lowerWholeProgram(
        "class Held \{\n"
        + "    protected string text;\n"
        + "\n"
        + "    protected constructor(this.text);\n"
        + "\n"
        + "    destructor() \{\n"
        + "        print(this.text);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = new Held(\"a\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("_dtor$main$Held"), "the allocation names it");
    try testing.assertTrue(reached.reaches("main$Held$destructor"),
        "the synthesized destructor calls the one the class writes");
}

test "a closure names its body and the destructor of its captures" {
    let program = try support.lowerWholeProgram(
        "class Box \{\n"
        + "    protected int value;\n"
        + "\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let box = new Box(7);\n"
        + "    (int) -> int add = (a) -> a + box.value;\n"
        + "    return add(1);\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("main$lambda0"),
        "the closure names the body its code pointer holds");
    try testing.assertTrue(reached.reaches("main$lambda0$dtor"),
        "and the destructor that gives the captured reference back");
}

test "a foreign call names a C symbol the program defines no body for" {
    let program = try support.lowerWholeProgram(
        "external from libc \{\n"
        + "    abs(int value) -> int;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return abs(0 - 1);\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(try namesSymbol(program, "ens.main", "abs"),
        "the call names the C function it runs");
    try testing.assertFalse(reached.reaches("abs"),
        "nothing the program lowers defines that name");
}

test "reading a lazy const names its initializer and the storage it fills" {
    let program = try support.lowerWholeProgram(
        "build() -> long \{\n"
        + "    return 7;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public lazy const long value = build();\n"
        + "\}\n"
        + "public class Unread \{\n"
        + "    public lazy const long value = build();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Holder.value as int;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("_lazyinit$main$Holder$value"),
        "the read calls the initializer on its cold edge");
    try testing.assertTrue(reached.reaches("main$build"),
        "and the initializer takes what it calls with it");
    try testing.assertFalse(reached.reaches("_lazyinit$main$Unread$value"),
        "nothing reads the other const");
    try testing.assertTrue(try namesSymbol(program, "ens.main", "_lazystate$main$Holder$value"),
        "the read names the state byte it tests");
    try testing.assertTrue(try namesSymbol(program, "ens.main", "_lazyvalue$main$Holder$value"),
        "and the storage it reads the value out of");
}

test "a type test and a checked cast name the descriptor of their target" {
    let program = try support.lowerWholeProgram(
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Absent extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Shape();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Shape one = pick();\n"
        + "    let cast = one as? Square;\n"
        + "    if (one is Circle) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(
        reached.namesDescriptor(try support.classNamed(program.analysis, "Circle")),
        "the type test names the descriptor it tests against");
    try testing.assertTrue(
        reached.namesDescriptor(try support.classNamed(program.analysis, "Square")),
        "the checked cast names the descriptor it casts to");
    try testing.assertTrue(
        reached.namesDescriptor(try support.classNamed(program.analysis, "Shape")),
        "the allocation names its own descriptor, and both targets name it as their parent");
    try testing.assertFalse(
        reached.namesDescriptor(try support.classNamed(program.analysis, "Absent")),
        "a class the reached code never mentions is named by nothing");
}

// Nothing here allocates an Animal, so the interface descriptor the dispatched call reads is the
// only one any reached body names.
test "a call dispatched through an interface names that interface's descriptor" {
    let program = try support.lowerWholeProgram(
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal implements Speaker \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override speak() -> string \{\n"
        + "        return \"...\";\n"
        + "    \}\n"
        + "\}\n"
        + "find() -> Speaker? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "say(Speaker who) -> string \{\n"
        + "    return who.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let found = find();\n"
        + "    if (found != null) \{\n"
        + "        let said = say(found);\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.namesDescriptor(try declaredType(program, "Speaker")),
        "the dispatched call reads the method table of the interface it goes through");
    try testing.assertFalse(reached.namesDescriptor(try declaredType(program, "Animal")),
        "nothing reached allocates an Animal, so nothing names its descriptor");
}

test "a named descriptor drags the descriptors its own initializer names" {
    let program = try support.lowerWholeProgram(
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal implements Speaker \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override speak() -> string \{\n"
        + "        return \"...\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Cat extends Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let made = new Dog();\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.namesDescriptor(try declaredType(program, "Dog")),
        "the allocation names the descriptor it stores in the object header");
    try testing.assertTrue(reached.namesDescriptor(try declaredType(program, "Animal")),
        "Dog's descriptor names its parent");
    try testing.assertTrue(reached.namesDescriptor(try declaredType(program, "Speaker")),
        "and every interface its conformance table lists");
    try testing.assertFalse(reached.namesDescriptor(try declaredType(program, "Cat")),
        "a sibling nothing allocates is named by nothing");
}

// The plan behind this work lists these four beside the nodes that name a symbol. They name none:
// each one calls a runtime helper that reads the descriptor the value itself carries, so the walk
// follows them as reads of a slot rather than as names.
test "the runtime-type instructions name no symbol and no descriptor" {
    let program = try support.lowerWholeProgram("main() \{\}\n");
    let store = program.analysis.store();
    Type boolType = store.primitive(PrimitiveKind.Bool);
    Type longType = store.primitive(PrimitiveKind.Long);
    Type text = store.stringType();
    try assertNamesNothing(new EirDynamicEquals(1, boolType, 0, 0), "dynamic_equals");
    try assertNamesNothing(new EirDynamicHash(1, longType, 0), "dynamic_hash");
    try assertNamesNothing(new EirDynamicToString(1, text, 0), "dynamic_to_string");
    try assertNamesNothing(new EirRuntimeTypeName(1, text, 0), "runtime_type_name");
}

// A dispatched call reads the slot of whatever class its receiver is at run time, which can only be
// one the program allocates, so a sibling nothing allocates keeps neither its slot nor its body.
test "a dispatched call reaches the slot of each allocated class below the receiver" {
    let program = try support.lowerWholeProgram(
        "abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override area() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override area() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Square();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick().area();\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("main$Square$area"),
        "Square is allocated, so the call can run its 'area'");
    try testing.assertFalse(reached.reaches("main$Circle$area"),
        "nothing allocates a Circle, so the call can never run its 'area'");
    try testing.assertTrue(reached.keepsSlot(try planOf(program, "Square"), SlotKind.Method,
        null, 0), "Square's slot holds what the call runs");
}

// The interface's method table of each allocated class that conforms is what such a call reads.
test "a call through an interface reaches the slot of each allocated class conforming to it" {
    let program = try support.lowerWholeProgram(
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal implements Speaker \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override speak() -> string \{\n"
        + "        return \"...\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Robot implements Speaker \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override speak() -> string \{\n"
        + "        return \"beep\";\n"
        + "    \}\n"
        + "\}\n"
        + "say(Speaker who) -> string \{\n"
        + "    return who.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let said = say(new Animal());\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.reaches("main$Animal$speak"),
        "the implementation sits in Animal's Speaker table and in no vtable");
    try testing.assertFalse(reached.reaches("main$Robot$speak"), "nothing allocates a Robot");
    try testing.assertTrue(reached.keepsSlot(try planOf(program, "Animal"), SlotKind.Interface,
        try declaredType(program, "Speaker"), 0), "Animal's Speaker slot is kept");
}

// Allocating a class reads none of the slots the language calls. A text form of a value that can
// hold more than one class reads the 'toString' slot, and only that one.
test "the built-in behaviors are reached by the calls that read them" {
    let program = try support.lowerWholeProgram(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Widget extends Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    override hash() -> long \{\n"
        + "        return 1L;\n"
        + "    \}\n"
        + "\n"
        + "    override equals(Widget other) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"widget\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Base made = new Widget();\n"
        + "    string text = \"\{made\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    let widget = try planOf(program, "Widget");
    try testing.assertTrue(reached.reaches("main$Widget$toString"),
        "the text form of a Base reads the slot of the Widget it holds");
    try testing.assertTrue(reached.keepsSlot(widget, SlotKind.ToString, null, 0),
        "the 'toString' slot is kept");
    try testing.assertFalse(reached.reaches("main$Widget$hash"), "nothing hashes a Widget");
    try testing.assertFalse(reached.keepsSlot(widget, SlotKind.Hash, null, 0),
        "the 'hash' slot is dropped");
    try testing.assertFalse(reached.keepsSlot(widget, SlotKind.Equals, null, 0),
        "the 'equals' slot is dropped");
}

// A type test reads the target's descriptor and calls nothing through it, so the descriptor is
// written and every slot of it is dropped.
test "a class only tested against keeps its descriptor and none of its slots" {
    let program = try support.lowerWholeProgram(
        "abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override area() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override area() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Square();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    if (pick() is Circle) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reached = walked(program);
    try testing.assertTrue(reached.namesDescriptor(try declaredType(program, "Circle")),
        "the test reads Circle's descriptor");
    try testing.assertFalse(reached.keepsSlot(try planOf(program, "Circle"), SlotKind.Method,
        null, 0), "no call reads a slot of a Circle");
    try testing.assertFalse(reached.reaches("main$Circle$area"), "nor runs its 'area'");
}

// A program that links a library may dispatch through any of its descriptors, so a library keeps
// them all and every slot in them.
test "a library keeps every descriptor and every slot" {
    let loader = new MemoryFileLoader();
    loader.add("/src/main.ens",
        "export class Tool \{\n"
        + "    export constructor();\n"
        + "\n"
        + "    export override toString() -> string \{\n"
        + "        return \"tool\";\n"
        + "    \}\n"
        + "\}\n"
        + "export offered() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    let program = try support.lowerLoadedProgram(try support.analyzeLoaded(loader));
    let reached = walked(program);
    let tool = try planOf(program, "Tool");
    try testing.assertTrue(reached.namesDescriptor(tool.type()), "the descriptor is written");
    try testing.assertTrue(reached.keepsSlot(tool, SlotKind.ToString, null, 0),
        "its 'toString' slot is kept");
    try testing.assertTrue(reached.reaches("main$Tool$toString"), "and what the slot holds");
}

// The entry calls 'helper', and 'inlined' is the entry's body as an inliner would leave it once the
// call is replaced by what 'helper' does.
test "retaining after inlining drops a callee whose every call was inlined" {
    let program = try support.lowerWholeProgram(
        "helper() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "inlined() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return helper();\n"
        + "\}\n");
    let decided = walked(program);
    try testing.assertTrue(decided.reaches("main$helper"), "the entry calls 'helper'");
    let retained = reachable.retainFrom(decided, try replaced(program, "ens.main", "main$inlined"));
    try testing.assertTrue(retained.reaches("ens.main"), "the entry is a root");
    try testing.assertFalse(retained.reaches("main$helper"), "nothing calls 'helper' any more");
    try testing.assertEqual(retained.order().length(), 1);
}

// A rewritten body that names a function the first walk never reached does not reach it: the
// first walk decided what the program holds, and the dangling-reference check reports the rest.
test "retaining reaches nothing the first walk did not" {
    let program = try support.lowerWholeProgram(
        "unused() -> int \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "calling() -> int \{\n"
        + "    return unused();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let decided = walked(program);
    let retained = reachable.retainFrom(decided, try replaced(program, "ens.main", "main$calling"));
    try testing.assertTrue(retained.reaches("ens.main"), "the entry is a root");
    try testing.assertFalse(retained.reaches("main$unused"), "the first walk never reached it");
}

// The entry's only dispatch is gone from its rewritten body, and Square's descriptor still holds
// its 'area', so the slot stays kept and the body it holds stays reached.
test "retaining keeps the descriptors and slots as decided and what each kept slot holds" {
    let program = try support.lowerWholeProgram(
        "abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override area() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> Shape \{\n"
        + "    return new Square();\n"
        + "\}\n"
        + "constant() -> int \{\n"
        + "    return 4;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick().area();\n"
        + "\}\n");
    let decided = walked(program);
    let retained = reachable.retainFrom(decided, try replaced(program, "ens.main", "main$constant"));
    let square = try planOf(program, "Square");
    try testing.assertTrue(retained.namedPlans() == decided.namedPlans(),
        "the named descriptors are the ones the first walk named");
    try testing.assertTrue(retained.namesDescriptor(square.type()), "Square's descriptor is kept");
    try testing.assertTrue(retained.keepsSlot(square, SlotKind.Method, null, 0),
        "Square's 'area' slot is kept");
    try testing.assertTrue(retained.reaches("main$Square$area"), "and what the slot holds");
    try testing.assertFalse(retained.reaches("main$pick"), "nothing calls 'pick' any more");
    try testing.assertEqual(retained.roots().length(), decided.roots().length());
}

// The program's modules with the body under `symbol` replaced by the body under `replacement`,
// renamed to `symbol`, the way an inliner hands back a rewritten body.
replaced(LoweredProgram program, string symbol, string replacement) -> List<ModuleBodies> throws {
    let source = try support.functionBySymbol(program, replacement);
    let rewritten = new EirFunction(symbol, source.internalLinkage(), source.receiverType(),
        source.parameters(), source.returnType(), source.slots(), source.blocks(),
        source.tempTypes(), source.throwing(), source.traceName(), source.traceFile(),
        source.traceLine(), source.isEntryPoint());
    let modules = new List<ModuleBodies>();
    for (let unit in program.modules) {
        let bodies = new List<EirFunction>();
        for (let body in unit.bodies()) {
            if (body.symbol() == symbol) {
                bodies.push(rewritten);
            } else {
                bodies.push(body);
            }
        }
        modules.push(new ModuleBodies(unit.modulePath(), bodies));
    }
    return modules;
}

// The walk over a program lowered the way the driver lowers it.
walked(LoweredProgram program) -> ReachedProgram {
    return reachable.analyze(program.index, program.plans, program.modules);
}

// Whether one body names a symbol, read through the shared instruction walk the reachability walk
// reads it through.
namesSymbol(LoweredProgram program, string bodySymbol, string named) -> bool throws {
    let body = try support.functionBySymbol(program, bodySymbol);
    let blocks = body.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let block = blocks.get(b);
        let instructions = block.instructions();
        for (long i = 0; i < instructions.length(); i++) {
            for (let symbol in walk.symbolsOf(instructions.get(i))) {
                if (symbol == named) {
                    return true;
                }
            }
        }
        let terminator = block.terminator();
        if (terminator == null) {
            continue;
        }
        for (let symbol in walk.terminatorSymbolsOf(terminator)) {
            if (symbol == named) {
                return true;
            }
        }
    }
    return false;
}

assertNamesNothing(EirInstruction instruction, string described) throws {
    try testing.assertTrue(walk.symbolsOf(instruction).length == 0,
        "{described} names a symbol");
    try testing.assertTrue(walk.descriptorTypesOf(instruction).length == 0,
        "{described} names a descriptor");
}

// The descriptor plan of one of the test program's own types.
planOf(LoweredProgram program, string name) -> DescriptorPlan throws {
    let plan = program.plans.planFor(try declaredType(program, name));
    if (plan == null) {
        throw new TestFailure("no descriptor is planned for '{name}'");
    }
    return plan;
}

// The type one of the test program's own declarations names, class or interface alike.
declaredType(LoweredProgram program, string name) -> Type throws {
    let found = program.analysis.store().findDeclared("main", name);
    if (found == null) {
        throw new TestFailure("no type named '{name}'");
    }
    return found;
}
