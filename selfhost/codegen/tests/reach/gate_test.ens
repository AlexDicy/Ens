// What emission is left with once the walk has answered: the bodies of a module the program
// reaches, whether a module with none of them left still writes an object file, and which object
// each of the program's descriptors is defined in once one of them writes none.
import @std.testing;
import TestFailure from @std.testing;
import EirFunction from eir.model;
import DescriptorPlan from layout.descriptors;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import reach.gate;
import reach.reachable;
import reach.roots;
import StandardLibrary from @ens.sema.program.implicit;
import LoweredProgram from support;
import MemoryFileLoader from support;
import support;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// A program whose modules cover the rules: 'main' declares a type it constructs and one nothing
// names, and 'lib.helper' declares none and exports one function the program never calls.
twoModuleProgram() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/helper.ens",
        "public used() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "public unused() -> int \{\n"
        + "    return 2;\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import lib.helper;\n"
        + "class Note \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Spare \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let note = new Note();\n"
        + "    return helper.used() - 1;\n"
        + "\}\n");
    return loader;
}

test "a module keeps the bodies the program reaches and drops the rest" {
    let program = try support.lowerWholeProgram(
        "first() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "second() -> int \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "third() -> int \{\n"
        + "    return 3;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return first() + third() - 4;\n"
        + "\}\n");
    let reached = walked(program);
    let kept = try bodiesOf(gate.reachedBodies(program.modules, reached), "main");
    try testing.assertTrue(holds(kept, "main$first"), "'first' is called");
    try testing.assertTrue(holds(kept, "main$third"), "'third' is called");
    try testing.assertFalse(holds(kept, "main$second"), "nothing calls 'second'");
    try assertReachOrder(kept, reached);
}

test "a module the program reaches no body in writes no object file" {
    try testing.assertFalse(gate.writesObject("lib.helper", 0),
        "a module with nothing left to define has no object file to write");
}

test "a module with a body left to define writes an object file" {
    try testing.assertTrue(gate.writesObject("lib.helper", 1),
        "a module still defining a body writes the object file it is defined in");
}

test "the core module writes an object file whatever the program reaches" {
    try testing.assertTrue(gate.writesObject(StandardLibrary.coreModule, 0),
        "the core module's object defines the trace runtime");
}

test "a module writing an object defines the descriptors it owns" {
    let program = try support.lowerLoadedProgram(
        try support.analyzeLoaded(twoModuleProgram()));
    let writing = writingSet(["main", StandardLibrary.coreModule]);
    let reached = walked(program);
    try testing.assertTrue(
        defines(gate.definedDescriptors("main", reached, writing), "_typedesc$main$Note"),
        "'main' declares the class its own object defines the descriptor of");
    try testing.assertFalse(defines(gate.definedDescriptors(StandardLibrary.coreModule,
        reached, writing), "_typedesc$main$Note"),
        "the core module defines nothing a module writing its own object owns");
    try assertDefinedOnce(program, ["main", StandardLibrary.coreModule]);
}

// Nothing reads the descriptor of a type the reached bodies never name, so no object defines it.
test "a descriptor the reached bodies do not name is defined nowhere" {
    let program = try support.lowerLoadedProgram(
        try support.analyzeLoaded(twoModuleProgram()));
    let writing = writingSet(["main", StandardLibrary.coreModule]);
    let reached = walked(program);
    for (let modulePath in ["main", StandardLibrary.coreModule]) {
        try testing.assertFalse(defines(gate.definedDescriptors(modulePath, reached,
            writing), "_typedesc$main$Spare"), "'{modulePath}' defines 'Spare'");
    }
}

// A module the program reaches no body in writes no object, so the descriptors it owns have no
// definition site of their own and the core module's object becomes theirs.
test "the core module defines the descriptors of a module writing no object" {
    let program = try support.lowerLoadedProgram(
        try support.analyzeLoaded(twoModuleProgram()));
    let writing = writingSet([StandardLibrary.coreModule]);
    try testing.assertTrue(defines(gate.definedDescriptors(StandardLibrary.coreModule,
        walked(program), writing), "_typedesc$main$Note"),
        "'main' writes no object, so its descriptor is defined in the core module's");
    try assertDefinedOnce(program, [StandardLibrary.coreModule]);
}


writingSet(string[] modulePaths) -> Set<string> {
    let writing = new Set<string>();
    for (let modulePath in modulePaths) {
        let ignored = writing.add(modulePath);
    }
    return writing;
}

defines(List<DescriptorPlan> defined, string symbol) -> bool {
    for (let plan in defined) {
        if (plan.symbol() == symbol) {
            return true;
        }
    }
    return false;
}

// Every descriptor the reached bodies name is defined in exactly one of the objects the program
// writes, which is what keeps the link resolving and keeps nothing defined twice.
assertDefinedOnce(LoweredProgram program, string[] writingModules) throws {
    let writing = writingSet(writingModules);
    let reached = walked(program);
    let counts = new Map<string, long>();
    for (let modulePath in writingModules) {
        for (let plan in gate.definedDescriptors(modulePath, reached, writing)) {
            counts.set(plan.symbol(), (counts.get(plan.symbol()) ?? 0) + 1);
        }
    }
    for (let plan in program.plans.all()) {
        long expected = 0;
        if (reached.namesDescriptor(plan.type())) {
            expected = 1;
        }
        try testing.assertTrue((counts.get(plan.symbol()) ?? 0) == expected,
            "'{plan.symbol()}' is defined {counts.get(plan.symbol()) ?? 0} time(s), not "
            + "{expected}");
    }
}
// One walk of the whole program from its own roots.
walked(LoweredProgram program) -> ReachedProgram {
    return reachable.analyzeFrom(program.plans, program.modules,
        roots.collect(program.index));
}

bodiesOf(List<ModuleBodies> modules, string modulePath) -> List<EirFunction> throws {
    for (long m = 0; m < modules.length(); m++) {
        if (modules.get(m).modulePath() == modulePath) {
            return modules.get(m).bodies();
        }
    }
    throw new TestFailure("the program has no module '{modulePath}'");
}

holds(List<EirFunction> bodies, string symbol) -> bool {
    for (long b = 0; b < bodies.length(); b++) {
        if (bodies.get(b).symbol() == symbol) {
            return true;
        }
    }
    return false;
}

// The kept bodies come in the order the walk reached them, whatever order lowering produced.
assertReachOrder(List<EirFunction> kept, ReachedProgram reached) throws {
    long at = 0;
    for (let symbol in reached.order()) {
        if (at < kept.length() && kept.get(at).symbol() == symbol) {
            at++;
        }
    }
    try testing.assertEqual(kept.length(), at);
}
