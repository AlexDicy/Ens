// The descriptor plans: the symbol and parent link, the implementation each vtable slot resolves
// to, and the flattened conformance table with its per-interface method tables.
import @std.testing;
import support;
import DescriptorPlan from layout.descriptors;
import layout.descriptors;
import layout.vtables;
import lower.index;

test "a class descriptor names its parent and hashes a stable id" {
    let analysis = try support.analyzeMain(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let plans = descriptors.planProgram(programIndex, vtables.assignSlots(programIndex));
    let animal = try support.classNamed(analysis, "Animal");
    let dog = try support.classNamed(analysis, "Dog");
    let dogPlan = plans.planFor(dog);
    if (dogPlan == null) {
        try testing.fail("no plan for Dog");
        return;
    }
    try testing.assertEqual(dogPlan.symbol(), "_typedesc$main$Dog");
    try testing.assertEqual(dogPlan.name(), "Dog");
    try testing.assertTrue(dogPlan.parent() == animal, "Dog's parent is Animal");
    try testing.assertTrue(dogPlan.typeId() > 0, "the type id is folded away from zero");
    let animalPlan = plans.planFor(animal);
    if (animalPlan == null) {
        try testing.fail("no plan for Animal");
        return;
    }
    try testing.assertTrue(animalPlan.parent() == null, "Animal has no parent");
    try testing.assertTrue(animalPlan.typeId() != dogPlan.typeId(), "distinct ids");
}

test "a vtable slot resolves to the most derived implementation" {
    let analysis = try support.analyzeMain(
        "abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "    protected override area() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "class Cube extends Square \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let plans = descriptors.planProgram(programIndex, vtables.assignSlots(programIndex));
    let shapePlan = plans.planFor(try support.classNamed(analysis, "Shape"));
    let squarePlan = plans.planFor(try support.classNamed(analysis, "Square"));
    let cubePlan = plans.planFor(try support.classNamed(analysis, "Cube"));
    if (shapePlan == null || squarePlan == null || cubePlan == null) {
        try testing.fail("a class has no plan");
        return;
    }
    try testing.assertEqual(shapePlan.vtable().length, 1);
    try testing.assertTrue(shapePlan.vtable()[0] == null, "the abstract slot stays null");
    let squareArea = squarePlan.vtable()[0];
    if (squareArea == null) {
        try testing.fail("Square's slot is empty");
        return;
    }
    try testing.assertEqual(squareArea.symbol(), "main$Square$area");
    let cubeArea = cubePlan.vtable()[0];
    if (cubeArea == null) {
        try testing.fail("Cube's slot is empty");
        return;
    }
    try testing.assertEqual(cubeArea.symbol(), "main$Square$area");
}

test "conformances flatten the chain and resolve each interface method" {
    let analysis = try support.analyzeMain(
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "interface Valued \{\n"
        + "    value() -> int;\n"
        + "\}\n"
        + "class Animal implements Speaker \{\n"
        + "    protected constructor();\n"
        + "    override speak() -> string \{\n"
        + "        return \"...\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal implements Valued \{\n"
        + "    protected constructor();\n"
        + "    override value() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    override speak() -> string \{\n"
        + "        return \"woof\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let plans = descriptors.planProgram(programIndex, vtables.assignSlots(programIndex));
    let dogPlan = plans.planFor(try support.classNamed(analysis, "Dog"));
    if (dogPlan == null) {
        try testing.fail("no plan for Dog");
        return;
    }
    try testing.assertEqual(dogPlan.conformances().length, 2);
    let valued = dogPlan.conformances()[0];
    let speaker = dogPlan.conformances()[1];
    try testing.assertEqual(valued.implementations().length, 1);
    let valueImplementation = valued.implementations()[0];
    if (valueImplementation == null) {
        try testing.fail("Valued.value resolves to nothing");
        return;
    }
    try testing.assertEqual(valueImplementation.symbol(), "main$Dog$value");
    let speakImplementation = speaker.implementations()[0];
    if (speakImplementation == null) {
        try testing.fail("Speaker.speak resolves to nothing");
        return;
    }
    try testing.assertEqual(speakImplementation.symbol(), "main$Dog$speak");
}

test "conformances cover the interfaces an implemented interface extends" {
    let analysis = try support.analyzeMain(
        "interface Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Buffered extends Source \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "class Numbers implements Buffered \{\n"
        + "    protected constructor();\n"
        + "    override get() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "    override size() -> long \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let plans = descriptors.planProgram(programIndex, vtables.assignSlots(programIndex));
    let numbersPlan = plans.planFor(try support.classNamed(analysis, "Numbers"));
    if (numbersPlan == null) {
        try testing.fail("no plan for Numbers");
        return;
    }
    try testing.assertEqual(numbersPlan.conformances().length, 2);
    let buffered = numbersPlan.conformances()[0];
    let source = numbersPlan.conformances()[1];
    try testing.assertEqual(buffered.implementations().length, 1);
    let sizeImplementation = buffered.implementations()[0];
    if (sizeImplementation == null) {
        try testing.fail("Buffered.size resolves to nothing");
        return;
    }
    try testing.assertEqual(sizeImplementation.symbol(), "main$Numbers$size");
    try testing.assertEqual(source.implementations().length, 1);
    let getImplementation = source.implementations()[0];
    if (getImplementation == null) {
        try testing.fail("Source.get resolves to nothing");
        return;
    }
    try testing.assertEqual(getImplementation.symbol(), "main$Numbers$get");
}
