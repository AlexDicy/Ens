// The dispatch slot assignment: which methods get vtable slots, how overrides share them, and
// where an interface method sits in its method table.
import @std.testing;
import support;
import layout.vtables;
import lower.index;

test "a method nobody overrides gets no slot and stays a direct call" {
    let analysis = try support.analyzeMain(
        "class Greeter \{\n"
        + "    protected constructor();\n"
        + "    hello() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let greeter = try support.classNamed(analysis, "Greeter");
    try testing.assertEqual(tables.vtableSizeOf(greeter), 0);
    try testing.assertEqual(tables.vtableSlotOf(greeter.methods().get(1).signature()), -1);
}

test "an override shares its base method's slot and untouched siblings stay direct" {
    let analysis = try support.analyzeMain(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected sound() -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    protected describe() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override sound() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let animal = try support.classNamed(analysis, "Animal");
    let dog = try support.classNamed(analysis, "Dog");
    let baseSound = animal.methods().get(1).signature();
    let describe = animal.methods().get(2).signature();
    let dogSound = dog.methods().get(1).signature();
    try testing.assertEqual(tables.vtableSlotOf(baseSound), 0);
    try testing.assertEqual(tables.vtableSlotOf(dogSound), 0);
    try testing.assertEqual(tables.vtableSlotOf(describe), -1);
    try testing.assertEqual(tables.vtableSizeOf(animal), 1);
    try testing.assertEqual(tables.vtableSizeOf(dog), 1);
}

test "an override skipping a level still finds the declaring base's slot" {
    let analysis = try support.analyzeMain(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected act() -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Middle extends Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected constructor();\n"
        + "    protected override act() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let base = try support.classNamed(analysis, "Base");
    let leaf = try support.classNamed(analysis, "Leaf");
    try testing.assertEqual(tables.vtableSlotOf(base.methods().get(1).signature()), 0);
    try testing.assertEqual(tables.vtableSlotOf(leaf.methods().get(1).signature()), 0);
    try testing.assertEqual(tables.vtableSizeOf(leaf), 1);
}

test "an abstract method gets a slot even before anything overrides it" {
    let analysis = try support.analyzeMain(
        "abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "    protected override area() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let shape = try support.classNamed(analysis, "Shape");
    let square = try support.classNamed(analysis, "Square");
    try testing.assertEqual(tables.vtableSlotOf(shape.methods().get(1).signature()), 0);
    try testing.assertEqual(tables.vtableSlotOf(square.methods().get(1).signature()), 0);
}

test "a subclass's new virtual method extends the base's table" {
    let analysis = try support.analyzeMain(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected first() -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Middle extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override first() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    protected second() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected constructor();\n"
        + "    protected override second() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let middle = try support.classNamed(analysis, "Middle");
    let leaf = try support.classNamed(analysis, "Leaf");
    try testing.assertEqual(tables.vtableSlotOf(middle.methods().get(1).signature()), 0);
    try testing.assertEqual(tables.vtableSlotOf(middle.methods().get(2).signature()), 1);
    try testing.assertEqual(tables.vtableSlotOf(leaf.methods().get(1).signature()), 1);
    try testing.assertEqual(tables.vtableSizeOf(leaf), 2);
}

test "interface methods number their table in declaration order" {
    let analysis = try support.analyzeMain(
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "    shout() -> string;\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = index.buildIndex(analysis);
    let tables = vtables.assignSlots(programIndex);
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        for (long i = 0; i < modules.get(m).interfaces().length(); i++) {
            let declared = modules.get(m).interfaces().get(i);
            if (declared.name() != "Speaker") {
                continue;
            }
            try testing.assertEqual(
                tables.itableSlotOf(declared.methods().get(0).signature()), 0);
            try testing.assertEqual(
                tables.itableSlotOf(declared.methods().get(1).signature()), 1);
            return;
        }
    }
    try testing.fail("no interface named 'Speaker'");
}
