// Who declares 'hash', 'equals' and 'toString' among the runtime types a value can have. A generic
// class answers for every instantiation of it, so the answer never depends on which instantiations
// the program has.
import @std.testing;
import TestFailure from @std.testing;
import ProgramAnalysis from @ens.sema.pipeline;
import Type from @ens.sema.model.types;
import layout.behaviors;
import support;

// 'Boxed' writes its own type as 'Boxed<T>', and its 'equals' still counts for a 'Container'.
test "a generic subclass's equals counts for the base it extends" {
    let analysis = try support.analyzeMain(
        "class Container \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Boxed<T> extends Container \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    override hash() -> long \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\n"
        + "    override equals(Boxed<T> other) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = try support.indexProgram(analysis);
    let container = try declaredNamed(analysis, "Container");
    try testing.assertTrue(behaviors.subtreeDeclares(programIndex, container, "equals"),
        "'Boxed' declares 'equals'");
    try testing.assertTrue(behaviors.subtreeDeclares(programIndex, container, "hash"),
        "'Boxed' declares 'hash'");
    try testing.assertFalse(behaviors.subtreeDeclares(programIndex, container, "toString"),
        "no class extending 'Container' declares 'toString'");
}

// Nothing instantiates 'Box', and its 'hash' and 'equals' still count for a 'Keyed' value.
test "a generic class that is never instantiated declares a behavior for its interface" {
    let analysis = try support.analyzeMain(
        "interface Keyed \{\n"
        + "\}\n"
        + "class Box<T> implements Keyed \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override hash() -> long \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\n"
        + "    override equals(Box<T> other) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = try support.indexProgram(analysis);
    let keyed = try declaredNamed(analysis, "Keyed");
    try testing.assertTrue(behaviors.subtreeDeclares(programIndex, keyed, "hash"),
        "'Box' declares 'hash' for every instantiation of it");
    try testing.assertTrue(behaviors.subtreeDeclares(programIndex, keyed, "equals"),
        "'Box' declares 'equals' for every instantiation of it");
    try testing.assertFalse(behaviors.subtreeDeclares(programIndex, keyed, "toString"),
        "no class conforming to 'Keyed' declares 'toString'");
}

// 'Pair<T>' conforms to 'Named<T>', so it answers for 'Named<int>' whatever 'T' becomes.
test "a generic class answers for every instantiation of the generic interface it implements" {
    let analysis = try support.analyzeMain(
        "interface Named<T> \{\n"
        + "\}\n"
        + "class Pair<T> implements Named<T> \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"pair\";\n"
        + "    \}\n"
        + "\}\n"
        + "show(Named<int> named) -> string \{\n"
        + "    return \"\{named\}\";\n"
        + "\}\n"
        + "main() \{\}\n");
    let programIndex = try support.indexProgram(analysis);
    let show = try support.functionNamed(analysis, programIndex, "show");
    Type named = show.signature().parameters()[0].type();
    try testing.assertTrue(behaviors.subtreeDeclares(programIndex, named, "toString"),
        "'Pair' declares 'toString' for 'Named<int>'");
    try testing.assertFalse(behaviors.subtreeDeclares(programIndex, named, "hash"),
        "no class conforming to 'Named' declares 'hash'");
}

declaredNamed(ProgramAnalysis analysis, string name) -> Type throws {
    let contexts = analysis.contexts();
    for (long i = 0; i < contexts.length(); i++) {
        let found = analysis.store().findDeclared(contexts.get(i).module().canonicalPath(), name);
        if (found != null) {
            return found;
        }
    }
    throw new TestFailure("no type named '{name}'");
}
