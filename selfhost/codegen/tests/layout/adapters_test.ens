// The forwarding entries a dispatch slot names when the implementation filling it returns a shape
// the slot is not called at: which overrides get one, which do not, and what the entry's body does.
import @std.testing;
import support;
import @ens.sema.model.types;
import layout.descriptors;
import layout.vtables;
import lower.index;

test "an override narrowing an optional payload away gets a forwarding entry" {
    let analysis = try support.analyzeMain(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected tally() -> long? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override tally() -> long \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Base base = new Derived();\n"
        + "    return base.tally() == null ? 1 : 0;\n"
        + "\}\n");
    let adapters = try support.returnAdaptersOf(analysis);
    try testing.assertEqual(adapters.length(), 1);
    let adapter = adapters.get(0);
    try testing.assertEqual(adapter.target().symbol(), "main$Derived$tally");
    try testing.assertEqual(adapter.entry().symbol(), "_ret$opt_long$main$Derived$tally");
    try testing.assertEqual(types.display(adapter.entry().signature().returnType()), "long?");
    try testing.assertTrue(adapter.entry().receiverType() == adapter.target().receiverType(),
        "the entry runs over the same receiver the implementation does");
}

test "a narrowing that changes no machine shape keeps the implementation in the slot" {
    let analysis = try support.analyzeMain(
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected pick() -> Shape? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override pick() -> Circle \{\n"
        + "        return new Circle();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Base base = new Derived();\n"
        + "    return base.pick() == null ? 1 : 0;\n"
        + "\}\n");
    let adapters = try support.returnAdaptersOf(analysis);
    try testing.assertEqual(adapters.length(), 0);
    let programIndex = try support.indexProgram(analysis);
    let tables = vtables.assignSlots(programIndex);
    let plans = descriptors.planProgram(programIndex, tables, analysis.store());
    let plan = plans.planFor(try support.classNamed(analysis, "Derived"));
    if (plan == null) {
        try testing.fail("Derived has no plan");
        return;
    }
    let slot = plan.vtable()[0];
    if (slot == null) {
        try testing.fail("Derived's slot 0 is empty");
        return;
    }
    try testing.assertEqual(slot.symbol(), "main$Derived$pick");
}

test "an override returning what its slot declares needs no entry" {
    let analysis = try support.analyzeMain(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected tally() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override tally() -> long \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Base base = new Derived();\n"
        + "    return base.tally() as int;\n"
        + "\}\n");
    let adapters = try support.returnAdaptersOf(analysis);
    try testing.assertEqual(adapters.length(), 0);
}

test "one method answering two interfaces gets one entry per declared shape" {
    let analysis = try support.analyzeMain(
        "interface Counted \{\n"
        + "    quantity() -> long?;\n"
        + "\}\n"
        + "interface Measured \{\n"
        + "    quantity() -> double;\n"
        + "\}\n"
        + "class Both implements Counted, Measured \{\n"
        + "    protected constructor();\n"
        + "    protected override quantity() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let both = new Both();\n"
        + "    Counted counted = both;\n"
        + "    Measured measured = both;\n"
        + "    return counted.quantity() == null ? 1 : measured.quantity() as int;\n"
        + "\}\n");
    let adapters = try support.returnAdaptersOf(analysis);
    try testing.assertEqual(adapters.length(), 2);
    let first = adapters.get(0);
    let second = adapters.get(1);
    try testing.assertEqual(first.target().symbol(), "main$Both$quantity");
    try testing.assertEqual(second.target().symbol(), "main$Both$quantity");
    try testing.assertTrue(first.entry().symbol() != second.entry().symbol(),
        "two slots declaring different shapes need two entries");
    try testing.assertEqual(
        types.display(first.entry().signature().returnType()) + " and "
            + types.display(second.entry().signature().returnType()),
        "long? and double");
}

test "the entry a slot names forwards, converts and returns" {
    let dumped = try support.returnAdapterDump(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected gauge(int scale) -> int? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override gauge(int scale) -> int \{\n"
        + "        return scale;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Base base = new Derived();\n"
        + "    return base.gauge(2) == null ? 1 : 0;\n"
        + "\}\n", "main$Derived$gauge");
    try testing.assertEqual(dumped,
        "func @_ret$opt_int$main$Derived$gauge(%0: Derived, %1: int) -> int? \{\n"
        + "b0.entry:\n"
        + "  %2 = call @main$Derived$gauge(this %0, %1): int\n"
        + "  %3 = opt.wrap %2: int?\n"
        + "  ret %3\n"
        + "\}\n");
}

test "a throwing override's entry propagates on the unwind edge" {
    let dumped = try support.returnAdapterDump(
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected load() -> long? throws \{\n"
        + "        throw new Error(\"base\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override load() -> long throws \{\n"
        + "        throw new Error(\"derived\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Runner \{\n"
        + "    protected constructor();\n"
        + "    protected show(Base base) -> long \{\n"
        + "        return try base.load() ?? 0;\n"
        + "    \} catch (Error e) \{\n"
        + "        return -1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Runner().show(new Derived()) as int;\n"
        + "\}\n", "main$Derived$load");
    try testing.assertEqual(dumped,
        "func @_ret$opt_long$main$Derived$load(%0: Derived) -> long? throws \{\n"
        + "b0.entry:\n"
        + "  %1 = try_call @main$Derived$load(this %0): long, error %2, to b1.try.ok, "
        + "unwind b2.try.unwind\n"
        + "b1.try.ok:\n"
        + "  %3 = opt.wrap %1: long?\n"
        + "  ret %3\n"
        + "b2.try.unwind:\n"
        + "  propagate %2\n"
        + "\}\n");
}
