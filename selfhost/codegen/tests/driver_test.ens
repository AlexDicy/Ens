// The driver stages the whole program: every module is lowered and verified before any module is
// emitted, so a problem in one module neither hides another module's problems nor leaves object
// files behind for a compile that failed. The tests point emission at the current folder, which
// stays untouched exactly because nothing is emitted.
import @std.testing;
import support;
import MemoryFileLoader from support;
import driver;

// A two-module program: 'main' calls the helper, and each module's text is given separately so a
// test can decide which of them lowers cleanly.
twoModuleProgram(string mainBody, string helperBody) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/main.ens",
        "import lib.helper;\n"
        + "main() -> int \{\n"
        + mainBody
        + "    return helper.doubled(21);\n"
        + "\}\n");
    loader.add("/src/lib/helper.ens",
        "public doubled(int n) -> int \{\n"
        + helperBody
        + "    return n + n;\n"
        + "\}\n");
    return loader;
}

test "a module that lowers cleanly is not emitted when a later module fails" {
    let analysis = try support.analyzeLoaded(
        twoModuleProgram("", "    decimal? label = null;\n"));
    let emitted = driver.emitProgram(analysis, ".", "ens-codegen-driver-test.");
    try testing.assertFalse(emitted.succeeded(),
        "a module that cannot be lowered must fail the program");
    try testing.assertEqual(emitted.objects().length(), 0);
    try testing.assertEqual(emitted.diagnostics().length, 1);
    try testing.assertTrue(
        emitted.diagnostics()[0].message().indexOf("a local of type 'decimal?'") >= 0,
        "unexpected message: {emitted.diagnostics()[0].message()}");
}

test "every failing module reports its own problem" {
    let analysis = try support.analyzeLoaded(twoModuleProgram(
        "    decimal? here = null;\n", "    decimal? there = null;\n"));
    let emitted = driver.emitProgram(analysis, ".", "ens-codegen-driver-test.");
    try testing.assertEqual(emitted.objects().length(), 0);
    try testing.assertEqual(emitted.diagnostics().length, 2);
    try testing.assertNotEqual(emitted.diagnostics()[0].file(),
        emitted.diagnostics()[1].file());
    try testing.assertTrue(
        emitted.diagnostics()[1].message().indexOf("a local of type 'decimal?'") >= 0,
        "unexpected message: {emitted.diagnostics()[1].message()}");
}
