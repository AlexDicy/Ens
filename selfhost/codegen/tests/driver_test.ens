// The driver stages the whole program: every module is lowered and verified before any module is
// emitted, so a problem in one module neither hides another's nor leaves object files behind. The
// failing tests point emission at the current folder, which stays untouched.
import @std.testing;
import Path from @std.fs;
import FileDiagnostic from @ens.sema.support.diagnostics;
import ProgramAnalysis from @ens.sema.pipeline;
import StandardLibrary from @ens.sema.program.implicit;
import @ens.llvm.target;
import CodegenSettings from settings;
import OptimizationLevel from settings;
import support;
import MemoryFileLoader from support;
import driver;
import List from @std.collections.list;

// A two-module program: 'main' calls the helper, and each module's text is given separately so a
// test can select which of them lowers cleanly. Both carry the declaration the unlowerable
// statements need, so either body can be the failing one.
twoModuleProgram(string mainBody, string helperBody) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/main.ens",
        "import lib.helper;\n"
        + support.unlowerableDeclaration()
        + "main() -> int \{\n"
        + mainBody
        + "    return helper.doubled(21);\n"
        + "\}\n");
    loader.add("/src/lib/helper.ens",
        support.unlowerableDeclaration()
        + "public doubled(int n) -> int \{\n"
        + helperBody
        + "    return n + n;\n"
        + "\}\n");
    return loader;
}

test "a module that lowers cleanly is not emitted when a later module fails" {
    let analysis = try support.analyzeLoaded(twoModuleProgram("", support.unlowerableStatements()));
    let emitted = driver.emitProgram(analysis, ".", "ens-codegen-driver-test.",
        support.testSettings());
    try testing.assertFalse(emitted.succeeded(),
        "a module that cannot be lowered must fail the program");
    try testing.assertEqual(emitted.objects().length(), 0);
    try testing.assertEqual(emitted.diagnostics().length, 1);
    try testing.assertEqual(emitted.diagnostics()[0].message(),
        "The compiler does not support 'slice' on an array of 'Tagged' values yet.");
}

test "every failing module reports its own problem" {
    let analysis = try support.analyzeLoaded(twoModuleProgram(
        support.unlowerableStatements(), support.unlowerableStatements()));
    let emitted = driver.emitProgram(analysis, ".", "ens-codegen-driver-test.",
        support.testSettings());
    try testing.assertEqual(emitted.objects().length(), 0);
    try testing.assertEqual(emitted.diagnostics().length, 2);
    try testing.assertNotEqual(emitted.diagnostics()[0].file(),
        emitted.diagnostics()[1].file());
    try testing.assertEqual(emitted.diagnostics()[1].message(),
        "The compiler does not support 'slice' on an array of 'Tagged' values yet.");
}

test "a program emits at every optimization level" {
    let analysis = try support.analyzeLoaded(twoModuleProgram("", ""));
    for (let level in [OptimizationLevel.None, OptimizationLevel.Less,
            OptimizationLevel.Default, OptimizationLevel.Aggressive]) {
        string folder = try scratchFolder();
        let emitted = driver.emitProgram(analysis, folder, "levels.",
            new CodegenSettings(level, hostTriple()));
        try testing.assertTrue(emitted.succeeded(),
            "one optimization level failed to emit: {describe(emitted.diagnostics())}");
        try testing.assertTrue(emitted.objects().length() >= 2,
            "both modules must be emitted, got {emitted.objects().length()} object(s)");
        try emptyFolder(Path(folder));
    }
}

// Emission writes an object file for the modules the program reaches into, and 'lib.spare'
// declares no type whose descriptor would need one, so nothing is written for it until the program
// calls it.
test "a module the program reaches nothing in writes no object file" {
    let unreached = try support.analyzeLoaded(spareProgram("0"));
    string folder = try scratchFolder();
    let without = driver.emitProgram(unreached, folder, "spare.", support.testSettings());
    try testing.assertTrue(without.succeeded(),
        "the program must emit: {describe(without.diagnostics())}");
    try testing.assertFalse(names(without.objects(), "lib.spare"),
        "nothing in the program reaches 'lib.spare'");
    try emptyFolder(Path(folder));

    let called = try support.analyzeLoaded(spareProgram("spare.spare() - 1"));
    folder = try scratchFolder();
    let withCall = driver.emitProgram(called, folder, "spare.", support.testSettings());
    try testing.assertTrue(withCall.succeeded(),
        "the program must emit: {describe(withCall.diagnostics())}");
    try testing.assertTrue(names(withCall.objects(), "lib.spare"),
        "the call reaches 'lib.spare'");
    try emptyFolder(Path(folder));
}

// A module the program reaches no body in writes no object file even where it declares the type
// whose descriptor the program holds, because an object with no code in it makes the Mach-O linker
// leave the next object's first function without unwind information. The core module's object is
// the definition site of that descriptor instead.
test "a module owning a descriptor and no reached body writes no object file" {
    let analysis = try support.analyzeLoaded(descriptorOnlyProgram());
    string folder = try scratchFolder();
    let emitted = driver.emitProgram(analysis, folder, "shapes.", support.testSettings());
    try testing.assertTrue(emitted.succeeded(),
        "the program must emit: {describe(emitted.diagnostics())}");
    try testing.assertFalse(names(emitted.objects(), "lib.shapes"),
        "nothing in the program reaches a body in 'lib.shapes'");
    try testing.assertTrue(names(emitted.objects(), StandardLibrary.coreModule),
        "the core module's object is what defines the descriptor 'lib.shapes' owns");
    try emptyFolder(Path(folder));
}

test "the objects of a cross target are named the target's way" {
    let analysis = try support.analyzeLoaded(twoModuleProgram("", ""));
    string folder = try scratchFolder();
    let emitted = driver.emitProgram(analysis, folder, "cross.",
        new CodegenSettings(OptimizationLevel.Default, "x86_64-unknown-linux-gnu"));
    try testing.assertTrue(emitted.succeeded(),
        "a Linux target must emit: {describe(emitted.diagnostics())}");
    string[] objects = emitted.objects().toArray();
    try testing.assertTrue(objects.length >= 2,
        "both modules must be emitted, got {objects.length} object(s)");
    for (let object in objects) {
        try testing.assertTrue(object.endsWith(".o"), "an ELF object is named '.o': {object}");
    }
    try emptyFolder(Path(folder));
}

// Sema refuses an entry point returning anything but 'int', so this catcher answers for a
// compiler bug rather than for a program. Its text still names the return type as the file
// declaring 'main' writes it, which is the alias here and not the declared name.
test "a refused entry return type reads under the name the entry file imports it as" {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/notes.ens", "public class Note \{\n    public constructor();\n\}\n");
    loader.add("/src/main.ens",
        "import Note as Memo from lib.notes;\n"
        + "main() -> Memo \{\n"
        + "    return new Memo();\n"
        + "\}\n");
    let analysis = try support.analyzeRejected(loader);
    let emitted = driver.emitProgram(analysis, ".", "ens-codegen-entry-test.",
        support.testSettings());
    try testing.assertFalse(emitted.succeeded(), "an entry point of that shape must be refused");
    try testing.assertEqual(emitted.diagnostics().length, 1);
    try testing.assertTrue(
        emitted.diagnostics()[0].message().indexOf("it returns 'Memo'") >= 0,
        "unexpected message: {emitted.diagnostics()[0].message()}");
}

test "the account of an explained build closes with the program's total" {
    let analysis = try support.analyzeLoaded(twoModuleProgram("", ""));
    string folder = try scratchFolder();
    string[] everyPass = [];
    let emitted = driver.emitProgram(analysis, folder, "explained.",
        new CodegenSettings(OptimizationLevel.Default, hostTriple(), everyPass, false, true));
    try testing.assertTrue(emitted.succeeded(), "the program must emit");
    string[] account = emitted.explanation();
    try testing.assertTrue(account.length > 0, "an explained build must account for itself");
    try testing.assertTrue(account[account.length - 1].endsWith(" removed in the whole program"),
        "unexpected closing line: {account[account.length - 1]}");
    try emptyFolder(Path(folder));
}

// A build that lowers every body verifies more than one that lowers what it reaches, and writes
// the same objects byte for byte, so what codegencheck verifies is what every build emits.
test "lowering every body emits the same objects as lowering what is reached" {
    let analysis = try support.analyzeLoaded(bothModesProgram());
    for (let level in [OptimizationLevel.None, OptimizationLevel.Default]) {
        string[] everyPass = [];
        let reached = try emittedBytes(analysis, new CodegenSettings(level, hostTriple()));
        let everything = try emittedBytes(analysis, new CodegenSettings(level, hostTriple(),
            everyPass, false, false, false, true));
        try testing.assertEqual(everything.length(), reached.length());
        for (long i = 0; i < reached.length(); i++) {
            try testing.assertEqual(everything.get(i).name, reached.get(i).name);
            try testing.assertTrue(everything.get(i).bytes == reached.get(i).bytes,
                "'{reached.get(i).name}' differs between the two modes");
        }
    }
}

// A program with what reachability decides about: a class hierarchy dispatched through, an
// interface, the built-in behaviors, a generic class and a generic function, a closure, and a
// function, a class and a generic instance nothing reaches.
bothModesProgram() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/shapes.ens",
        "public interface Measured \{\n"
        + "    measure() -> int;\n"
        + "\}\n"
        + "public class Shape implements Measured \{\n"
        + "    public int side;\n"
        + "    public constructor(this.side);\n"
        + "    public override measure() -> int \{\n"
        + "        return this.side;\n"
        + "    \}\n"
        + "    public area() -> int \{\n"
        + "        return this.side * this.side;\n"
        + "    \}\n"
        + "    public override hash() -> long \{\n"
        + "        return this.side;\n"
        + "    \}\n"
        + "    public override equals(Shape other) -> bool \{\n"
        + "        return this.side == other.side;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Square extends Shape \{\n"
        + "    public constructor(int side) \{\n"
        + "        super(side);\n"
        + "    \}\n"
        + "    public override area() -> int \{\n"
        + "        return this.side * this.side + 1;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Unused \{\n"
        + "    public constructor();\n"
        + "    public value() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Box<T> \{\n"
        + "    public T held;\n"
        + "    public constructor(this.held);\n"
        + "    public get() -> T \{\n"
        + "        return this.held;\n"
        + "    \}\n"
        + "\}\n"
        + "public first<T>(T[] items) -> T \{\n"
        + "    return items[0];\n"
        + "\}\n"
        + "public unreached() -> int \{\n"
        + "    let box = new Box<string>(\"never\");\n"
        + "    return first<int>([new Unused().value()]) + (box.get().length as int);\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import lib.shapes;\n"
        + "import Shape from lib.shapes;\n"
        + "import Square from lib.shapes;\n"
        + "import Measured from lib.shapes;\n"
        + "import Box from lib.shapes;\n"
        + "main() -> int \{\n"
        + "    Shape shape = new Square(3);\n"
        + "    Measured measured = shape;\n"
        + "    let box = new Box<int>(shape.area());\n"
        + "    (int) -> int add = (n) -> n + measured.measure();\n"
        + "    return add(box.get()) + shapes.first<int>([1, 2]) + (shape.hash() as int);\n"
        + "\}\n");
    return loader;
}

// One object file a build wrote: its name without the folder, and its bytes.
final class EmittedFile {
    protected string name;
    protected byte[] bytes;

    protected constructor(this.name, this.bytes);
}

// The object files one build of the program writes, in the order it reports them, with the folder
// removed again afterwards.
emittedBytes(ProgramAnalysis analysis, CodegenSettings settings) -> List<EmittedFile> throws {
    string folder = try scratchFolder();
    let emitted = driver.emitProgram(analysis, folder, "modes.", settings);
    try testing.assertTrue(emitted.succeeded(),
        "the program must emit: {describe(emitted.diagnostics())}");
    let files = new List<EmittedFile>();
    for (let object in emitted.objects()) {
        Path path = Path(object);
        files.push(new EmittedFile(path.fileName(), try path.readBytes()));
    }
    try emptyFolder(Path(folder));
    return files;
}

// A two-module program whose 'lib.spare' module declares one function and no type, with what
// 'main' returns given so a test chooses whether anything calls it.
spareProgram(string returned) -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/spare.ens",
        "public spare() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import lib.spare;\n"
        + "main() -> int \{\n"
        + "    return " + returned + ";\n"
        + "\}\n");
    return loader;
}

// A two-module program whose 'lib.shapes' module declares an interface and nothing else, so the
// program names its descriptor, through the class 'main' allocates, while reaching no body in it.
descriptorOnlyProgram() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/src/lib/shapes.ens",
        "public interface Shape \{\n"
        + "\}\n");
    loader.add("/src/main.ens",
        "import Shape from lib.shapes;\n"
        + "class Square implements Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let made = new Square();\n"
        + "    return 0;\n"
        + "\}\n");
    return loader;
}

// Whether one of the object files written is named after this module.
names(List<string> objects, string modulePath) -> bool {
    for (long i = 0; i < objects.length(); i++) {
        if (objects.get(i).contains(modulePath)) {
            return true;
        }
    }
    return false;
}

hostTriple() -> string {
    return target.hostTargetTriple();
}

describe(FileDiagnostic[] diagnostics) -> string {
    if (diagnostics.length == 0) {
        return "no problems";
    }
    return diagnostics[0].message();
}

// The folder the emitting tests write their objects into, empty when they start with it.
scratchFolder() -> string throws {
    Path folder = Path("ens-codegen-driver-test-objects");
    try emptyFolder(folder);
    try folder.createDirectories();
    return folder.toString();
}

emptyFolder(Path folder) throws {
    if (!folder.isDirectory()) {
        return;
    }
    try folder.removeRecursively();
}
