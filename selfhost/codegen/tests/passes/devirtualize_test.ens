// Devirtualization: a dispatched call on a receiver born from 'new' in the same function goes
// direct, through an upcast or a single-class local slot alike; a receiver nothing proves keeps
// its table read.
import @std.testing;
import eir.dump;
import passes.devirtualize;
import support;

test "a call on a freshly made derived object goes direct" {
    let program = try support.lowerWholeProgram(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected speak() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override speak() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "call() -> int \{\n"
        + "    let d = new Dog();\n"
        + "    return d.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return call() - 2;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "main$call");
    let after = devirtualize.run(before, support.passContext(program).plans());
    try support.assertOptimized(after, "call");
    string beforeDump = dump.dumpFunction(before);
    string afterDump = dump.dumpFunction(after);
    try testing.assertTrue(beforeDump.indexOf("vtable[") >= 0,
        "the overridden method dispatches naively");
    try testing.assertTrue(afterDump.indexOf("vtable[") < 0,
        "the dispatch is gone: {afterDump}");
    try testing.assertTrue(afterDump.indexOf("call @main$Dog$speak(this ") >= 0,
        "the call goes straight to Dog's implementation: {afterDump}");
}

test "an upcast into a base-typed local still proves the exact class" {
    let program = try support.lowerWholeProgram(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected speak() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override speak() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "call() -> int \{\n"
        + "    Animal a = new Dog();\n"
        + "    return a.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return call() - 2;\n"
        + "\}\n");
    let after = devirtualize.run(try support.functionBySymbol(program, "main$call"),
        support.passContext(program).plans());
    try support.assertOptimized(after, "call");
    try testing.assertTrue(dump.dumpFunction(after).indexOf("call @main$Dog$speak(this ") >= 0,
        "the base-typed local held exactly a Dog");
}

test "an interface call on a known class resolves through its conformance" {
    let program = try support.lowerWholeProgram(
        "interface Greeter \{\n"
        + "    greet() -> int;\n"
        + "\}\n"
        + "class Friendly implements Greeter \{\n"
        + "    protected constructor();\n"
        + "    protected override greet() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\}\n"
        + "class Grumpy implements Greeter \{\n"
        + "    protected constructor();\n"
        + "    protected override greet() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "call() -> int \{\n"
        + "    Greeter g = new Friendly();\n"
        + "    return g.greet();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Greeter grumpy = new Grumpy();\n"
        + "    return call() + grumpy.greet() - 7;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "main$call");
    let after = devirtualize.run(before, support.passContext(program).plans());
    try support.assertOptimized(after, "call");
    try testing.assertTrue(dump.dumpFunction(before).indexOf("itable[") >= 0,
        "the interface call dispatches naively");
    try testing.assertTrue(dump.dumpFunction(after).indexOf("call @main$Friendly$greet(this ")
        >= 0, "the conformance resolves the slot: {dump.dumpFunction(after)}");
}

test "a receiver from a parameter keeps its dispatch" {
    let program = try support.lowerWholeProgram(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected speak() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override speak() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "poke(Animal a) -> int \{\n"
        + "    return a.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return poke(new Dog()) - 2;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "main$poke");
    let after = devirtualize.run(before, support.passContext(program).plans());
    try testing.assertEqual(dump.dumpFunction(after), dump.dumpFunction(before));
}

test "a slot fed two different classes keeps its dispatch" {
    let program = try support.lowerWholeProgram(
        "class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected speak() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "    protected override speak() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "pick(bool loud) -> int \{\n"
        + "    Animal a = new Animal();\n"
        + "    if (loud) \{\n"
        + "        a = new Dog();\n"
        + "    \}\n"
        + "    return a.speak();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick(true) - 2;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "main$pick");
    let after = devirtualize.run(before, support.passContext(program).plans());
    try testing.assertEqual(dump.dumpFunction(after), dump.dumpFunction(before));
}
