// Cleanup pruning: empty forwarder blocks are threaded past, a branch whose arms agree becomes
// a jump, unreachable blocks disappear, and a graph with no dead weight comes back unchanged.
import @std.testing;
import eir.dump;
import passes.pruning;
import support;

test "an empty merge block is threaded past and dropped" {
    let program = try support.lowerWholeProgram(
        "pick(bool a, bool b) -> int \{\n"
        + "    if (a) \{\n"
        + "        if (b) \{\n"
        + "            return 1;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return 2;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick(true, false);\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "pick");
    let after = pruning.run(before);
    try support.assertOptimized(after, "pick");
    try testing.assertTrue(dump.dumpFunction(before).indexOf("b4.if.end:") >= 0,
        "the naive lowering carries the inner empty merge");
    try testing.assertEqual(dump.dumpFunction(after),
        "func internal @pick(%0: bool, %1: bool) -> int \{\n"
        + "  $0 a: bool\n"
        + "  $1 b: bool\n"
        + "b0.entry:\n"
        + "  store $0, %0\n"
        + "  store $1, %1\n"
        + "  %2 = load $0: bool\n"
        + "  br %2, b1.if.then, b2.if.end\n"
        + "b1.if.then:\n"
        + "  %3 = load $1: bool\n"
        + "  br %3, b3.if.then, b2.if.end\n"
        + "b2.if.end:\n"
        + "  %5 = const 2: int\n"
        + "  ret %5\n"
        + "b3.if.then:\n"
        + "  %4 = const 1: int\n"
        + "  ret %4\n"
        + "\}\n");
}

test "a switch whose arms are all empty collapses to a jump" {
    let program = try support.lowerWholeProgram(
        "tag(int x) -> int \{\n"
        + "    switch (x) \{\n"
        + "        1 -> \{\},\n"
        + "        default -> \{\},\n"
        + "    \}\n"
        + "    return x + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return tag(1) - 2;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "tag");
    let after = pruning.run(before);
    try support.assertOptimized(after, "tag");
    try testing.assertTrue(dump.dumpFunction(before).indexOf("switch %") >= 0,
        "the naive lowering carries the switch");
    try testing.assertTrue(dump.dumpFunction(after).indexOf("switch %") < 0,
        "every arm agreed, so the switch is gone");
}

test "a graph with no empty blocks comes back unchanged" {
    let program = try support.lowerWholeProgram(
        "count(int limit) -> int \{\n"
        + "    int total = 0;\n"
        + "    int i = 0;\n"
        + "    while (i < limit) \{\n"
        + "        total += i;\n"
        + "        i++;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return count(5);\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "count");
    let after = pruning.run(before);
    try testing.assertEqual(dump.dumpFunction(after), dump.dumpFunction(before));
}

test "an unwind path that carries cleanup is left alone" {
    let program = try support.lowerWholeProgram(
        "class Trouble extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"trouble\");\n"
        + "    \}\n"
        + "\}\n"
        + "risky(int x) -> int throws \{\n"
        + "    if (x > 0) \{\n"
        + "        throw new Trouble();\n"
        + "    \}\n"
        + "    return x;\n"
        + "\}\n"
        + "carry(int x) -> int throws \{\n"
        + "    let label = \"held \{x\}\";\n"
        + "    let result = try risky(x);\n"
        + "    return result + label.length as int;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try carry(0);\n"
        + "\} catch (Trouble t) \{\n"
        + "    return 1;\n"
        + "\}\n");
    let before = try support.functionBySymbol(program, "carry");
    let after = pruning.run(before);
    try support.assertOptimized(after, "carry");
    try testing.assertTrue(dump.dumpFunction(before).indexOf("try.unwind") >= 0,
        "the throwing call carries an unwind block");
    try testing.assertEqual(dump.dumpFunction(after), dump.dumpFunction(before));
}
