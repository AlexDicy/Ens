// Observable destruction: a value is destroyed observably when it, or anything it can own, runs
// a declared destructor or is watched by a weak field. Each test judges the locals of one
// function, so the type of each local is the one the program spells.
import @std.testing;
import TestFailure from @std.testing;
import EirFunction from eir.model;
import DestructionFacts from passes.destruction;
import LoweredProgram from support;
import support;

test "a class that declares a destructor or extends one that does is destroyed observably" {
    let program = try support.lowerWholeProgram(
        "class Guard \{\n"
        + "    protected constructor();\n"
        + "    destructor() \{\n"
        + "        print(\"released\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Child extends Guard \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n"
        + "class Plain \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "locals() \{\n"
        + "    let guard = new Guard();\n"
        + "    let child = new Child();\n"
        + "    let plain = new Plain();\n"
        + "    string text = \"text\";\n"
        + "    long[] numbers = [1];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    locals();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertJudged(program, "main$locals", ["guard", "child"],
        ["plain", "text", "numbers"]);
}

test "a value that owns an observably destroyed value is destroyed observably" {
    let program = try support.lowerWholeProgram(
        "class Guard \{\n"
        + "    protected constructor();\n"
        + "    destructor() \{\n"
        + "        print(\"released\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Plain \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    Guard guard;\n"
        + "\}\n"
        + "struct Outer \{\n"
        + "    Inner inner;\n"
        + "\}\n"
        + "class Deep \{\n"
        + "    protected Outer outer;\n"
        + "    protected constructor(this.outer);\n"
        + "\}\n"
        + "class Box<T> \{\n"
        + "    protected T item;\n"
        + "    protected constructor(this.item);\n"
        + "\}\n"
        + "locals() \{\n"
        + "    let guard = new Guard();\n"
        + "    let plain = new Plain();\n"
        + "    let deep = new Deep(\{inner: \{guard: guard\}\});\n"
        + "    Guard? maybe = guard;\n"
        + "    Guard[] guards = [guard];\n"
        + "    Outer[] outers = [\{inner: \{guard: guard\}\}];\n"
        + "    let boxedGuard = new Box<Guard>(guard);\n"
        + "    let boxedPlain = new Box<Plain>(plain);\n"
        + "    () -> Guard capturing = () -> guard;\n"
        + "    (long) -> Plain quiet = (n) -> plain;\n"
        + "    Plain[] plains = [plain];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    locals();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertJudged(program, "main$locals",
        ["deep", "maybe", "guards", "outers", "boxedGuard", "capturing"],
        ["boxedPlain", "quiet", "plains"]);
}

test "a base class or an interface is judged by the classes the program allocates under it" {
    let program = try support.lowerWholeProgram(
        "interface Named \{\n"
        + "    name() -> string;\n"
        + "\}\n"
        + "interface Silent \{\n"
        + "    quiet() -> string;\n"
        + "\}\n"
        + "class Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Quiet extends Base implements Silent \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    override quiet() -> string \{\n"
        + "        return \"quiet\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Loud extends Base implements Named \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    override name() -> string \{\n"
        + "        return \"loud\";\n"
        + "    \}\n"
        + "    destructor() \{\n"
        + "        print(\"released\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Lonely \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class NeverMade extends Lonely \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    destructor() \{\n"
        + "        print(\"released\");\n"
        + "    \}\n"
        + "\}\n"
        + "locals() \{\n"
        + "    Base base = new Quiet();\n"
        + "    Named named = new Loud();\n"
        + "    Silent silent = new Quiet();\n"
        + "    let lonely = new Lonely();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    locals();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertJudged(program, "main$locals", ["base", "named"], ["silent", "lonely"]);
}

test "an object a weak field can watch is destroyed observably, and a cycle is judged once" {
    let program = try support.lowerWholeProgram(
        "class Node \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    protected weak Node? seen;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Link \{\n"
        + "    protected Link? next;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Chain \{\n"
        + "    protected Chain? next;\n"
        + "    protected Node? node;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "locals() \{\n"
        + "    let node = new Node();\n"
        + "    let watcher = new Watcher();\n"
        + "    let link = new Link();\n"
        + "    let chain = new Chain();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    locals();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertJudged(program, "main$locals", ["node", "chain"], ["watcher", "link"]);
}

// Asserts which locals of one function are destroyed observably and which are not.
assertJudged(LoweredProgram program, string symbol, string[] observable,
             string[] unobservable) throws {
    let facts = support.passContext(program).destruction();
    let function = try support.functionBySymbol(program, symbol);
    for (let name in observable) {
        try testing.assertTrue(try judged(facts, function, name),
            "destroying '{name}' is observable");
    }
    for (let name in unobservable) {
        try testing.assertFalse(try judged(facts, function, name),
            "destroying '{name}' is not observable");
    }
}

judged(DestructionFacts facts, EirFunction function, string name) -> bool throws {
    for (let slot in function.slots()) {
        if (slot.name() == name) {
            return facts.isObservable(slot.type());
        }
    }
    throw new TestFailure("no local '{name}' in '{function.symbol()}'");
}
