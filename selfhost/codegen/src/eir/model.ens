// The Ens intermediate representation lowering produces and emission consumes. It is SSA-lite:
// values are single-assignment temps, mutable storage is explicit slots, and control flow is a
// flat graph of basic blocks each ending in exactly one terminator. There are no phi nodes; a
// merged value travels through a slot. Types reference the interned sema type model directly, so
// type equality is reference identity here too.
//
// Lvalue paths are address temps: EirSlotAddress, EirFieldAddress, and EirElementAddress produce
// a temp whose recorded type is the pointee, and whose addressness follows from its defining
// instruction. Addresses may be passed as call arguments but never stored: no slot holds an
// address and no address is stored through another address. An address that arrives as a
// function's receiver is an opaque root with no known base.
//
// Ownership is two-level. EirRetain and EirRelease move the +1 a VALUE temp owns; EirRetainPtr
// and EirReleasePtr move the +1 held by the STORAGE an address names, and appear wherever a
// struct's reference fields or a slot's current value change hands.
//
// A class reference is a value that already points at its object, so a class method's receiver is
// that reference rather than an address, and a field inside it is reached with
// EirObjectFieldAddress. A struct method's receiver stays the address of the storage it runs over.
import Type from @ens.sema.model.types;
import List from @std.collections.list;

// One incoming parameter. Parameter i is pre-defined as temp i at function entry. A parameter
// passed by address arrives as the address of the caller's storage rather than as a value; its
// temp is then an opaque address root whose recorded type stays the pointee.
export final class EirParameter {
    string parameterName;
    Type parameterType;
    bool addressed;

    public constructor(this.parameterName, this.parameterType, this.addressed = false);

    export name() -> string {
        return this.parameterName;
    }

    export type() -> Type {
        return this.parameterType;
    }

    export byAddress() -> bool {
        return this.addressed;
    }
}

// One mutable stack slot. Slots hold locals, parameters, and the merge points a branch writes
// through; loads and stores are explicit. A slot whose type holds references starts zeroed, so
// the first write can release what was there without reading uninitialized memory. A borrowing
// slot holds a reference somebody else owns for as long as this function runs: writing into it
// transfers no ownership and it is never released, which is what makes a call boundary free of
// atomics.
export final class EirSlot {
    string slotName;
    Type slotType;
    bool zeroed;
    bool borrowing;

    public constructor(this.slotName, this.slotType, this.zeroed, this.borrowing);

    export name() -> string {
        return this.slotName;
    }

    export type() -> Type {
        return this.slotType;
    }

    export startsZeroed() -> bool {
        return this.zeroed;
    }

    export borrows() -> bool {
        return this.borrowing;
    }
}

export enum EirBinaryOp {
    Add,
    Sub,
    Mul,
    DivSigned,
    DivUnsigned,
    RemSigned,
    RemUnsigned,
    FloatAdd,
    FloatSub,
    FloatMul,
    FloatDiv,
    FloatRem,
    And,
    Or,
    Xor,
    ShiftLeft,
    ShiftRightSigned,
    ShiftRightUnsigned,
    CmpEq,
    CmpNe,
    CmpLtSigned,
    CmpLeSigned,
    CmpGtSigned,
    CmpGeSigned,
    CmpLtUnsigned,
    CmpLeUnsigned,
    CmpGtUnsigned,
    CmpGeUnsigned,
    FloatCmpEq,
    FloatCmpNe,
    FloatCmpLt,
    FloatCmpLe,
    FloatCmpGt,
    FloatCmpGe,
}

// True for the comparison forms, whose result type is bool while the operands share their own
// common type.
export isComparison(EirBinaryOp op) -> bool {
    return switch (op) {
        CmpEq, CmpNe, CmpLtSigned, CmpLeSigned, CmpGtSigned, CmpGeSigned, CmpLtUnsigned,
        CmpLeUnsigned, CmpGtUnsigned, CmpGeUnsigned, FloatCmpEq, FloatCmpNe, FloatCmpLt,
        FloatCmpLe, FloatCmpGt, FloatCmpGe -> true,
        default -> false,
    };
}

export isFloatBinary(EirBinaryOp op) -> bool {
    return switch (op) {
        FloatAdd, FloatSub, FloatMul, FloatDiv, FloatRem, FloatCmpEq, FloatCmpNe, FloatCmpLt,
        FloatCmpLe, FloatCmpGt, FloatCmpGe -> true,
        default -> false,
    };
}

export enum EirUnaryOp {
    Neg,
    FloatNeg,
    Not,
}

export enum EirCastOp {
    Trunc,
    ZeroExtend,
    SignExtend,
    FloatTrunc,
    FloatExtend,
    SignedToFloat,
    UnsignedToFloat,
    FloatToSigned,
    FloatToUnsigned,
    Reinterpret,
}

// The callee of a call: its linker symbol and the sema types its LLVM function type derives
// from. Parameter types list every parameter after default filling, in parameter order. A
// method callee additionally names its receiver's type, passed by address before the
// parameters. A throwing callee's ABI carries one more trailing parameter, the address of the
// caller's error slot; whether a given call site checks that slot is the call's own shape.
export final class EirCallee {
    string calleeSymbol;
    Type? calleeReceiverType;
    Type[] calleeParameterTypes;
    Type calleeReturnType;
    bool calleeThrows;
    bool[] calleeByAddress;

    public constructor(this.calleeSymbol, this.calleeReceiverType, this.calleeParameterTypes,
                this.calleeReturnType, bool throwing = false, bool[] byAddress = []) {
        this.calleeThrows = throwing;
        this.calleeByAddress = byAddress;
    }

    export symbol() -> string {
        return this.calleeSymbol;
    }

    export receiverType() -> Type? {
        return this.calleeReceiverType;
    }

    export parameterTypes() -> Type[] {
        return this.calleeParameterTypes;
    }

    export returnType() -> Type {
        return this.calleeReturnType;
    }

    export throwing() -> bool {
        return this.calleeThrows;
    }

    // The parameters whose ABI takes an address instead of a value; empty means none do.
    export byAddressParameters() -> bool[] {
        return this.calleeByAddress;
    }

    export passesByAddress(long index) -> bool {
        return index >= 0 && index < this.calleeByAddress.length && this.calleeByAddress[index];
    }
}

export sealed abstract class EirInstruction {
}

// An integer constant. The value is the two's-complement bit pattern, sized by the type.
export final class EirConstInt extends EirInstruction {
    public long result;
    public Type type;
    public long bits;

    public constructor(this.result, this.type, this.bits);
}

// A floating-point constant. The source spelling is kept for the textual dump.
export final class EirConstFloat extends EirInstruction {
    public long result;
    public Type type;
    public double value;
    public string text;

    public constructor(this.result, this.type, this.value, this.text);
}

export final class EirConstBool extends EirInstruction {
    public long result;
    public Type type;
    public bool value;

    public constructor(this.result, this.type, this.value);
}

// A binary operation. For arithmetic forms the result and both operands share the type; for
// comparison forms the result is bool and the operands share their own type.
export final class EirBinary extends EirInstruction {
    public long result;
    public Type type;
    public EirBinaryOp op;
    public long left;
    public long right;

    public constructor(this.result, this.type, this.op, this.left, this.right);
}

export final class EirUnary extends EirInstruction {
    public long result;
    public Type type;
    public EirUnaryOp op;
    public long operand;

    public constructor(this.result, this.type, this.op, this.operand);
}

// A primitive conversion. Reinterpret changes only the type (same width, same bits) and emits
// no machine operation.
export final class EirCast extends EirInstruction {
    public long result;
    public Type type;
    public EirCastOp op;
    public long operand;

    public constructor(this.result, this.type, this.op, this.operand);
}

export final class EirLoadSlot extends EirInstruction {
    public long result;
    public Type type;
    public long slot;

    public constructor(this.result, this.type, this.slot);
}

export final class EirStoreSlot extends EirInstruction {
    public long slot;
    public long value;

    public constructor(this.slot, this.value);
}

// Takes the reference a slot owns: reads the value and leaves the slot null, so the +1 the slot
// held now belongs to the result temp and the cleanup that still releases the slot finds nothing.
// The move-rewriting pass introduces these; lowering never does, and a borrowing slot has no
// reference to take.
export final class EirTakeSlot extends EirInstruction {
    public long result;
    public Type type;
    public long slot;

    public constructor(this.result, this.type, this.slot);
}

// A non-throwing call. result is -1 when the callee returns void, receiver is -1 unless the
// callee is a method, in which case it is the storage the method runs over: the address of a
// struct, or the reference a class value holds. Throwing calls become their own terminator with
// an unwind edge when exceptions arrive; this form stays for calls that cannot unwind.
//
// dispatchSlot below -1 keeps the call direct at the callee's symbol. At 0 or above the call is
// dynamic: the target is read from the receiver's runtime type, at that slot of its vtable, or
// of its method table for dispatchInterface when one is named. The slot is symbolic; the
// descriptor layout belongs to emission.
//
// line is the call's 1-based source line, or -1 when the call never appears in a stack trace;
// emission marks each lined call site so a captured return address resolves back to it.
export final class EirCall extends EirInstruction {
    public long result;
    public Type type;
    public EirCallee callee;
    public long receiver;
    public long[] arguments;
    public long dispatchSlot;
    public Type? dispatchInterface;
    public long line;

    public constructor(this.result, this.type, this.callee, this.receiver, this.arguments,
                this.dispatchSlot, this.dispatchInterface, long line = -1) {
        this.line = line;
    }
}

// Takes over the +1 a reference-typed value temp does not yet own: the value was just loaded
// out of storage and the retain gives the temp its own reference.
export final class EirRetain extends EirInstruction {
    public long value;

    public constructor(this.value);
}

// Gives up the +1 a reference-typed value temp owns; the temp is dead afterwards.
export final class EirRelease extends EirInstruction {
    public long value;

    public constructor(this.value);
}

// Bumps the +1 held by the reference-typed storage an address names, without producing a temp.
export final class EirRetainPtr extends EirInstruction {
    public long address;

    public constructor(this.address);
}

// Drops the +1 held by the reference-typed storage an address names, and leaves that storage
// empty. Clearing it is part of the operation, not an optimization: storage released when its
// scope ends is written again the next time around a loop, and that write releases whatever it
// finds, so a release that left the old reference behind would drop it twice. A pass that moves
// or removes a release has to preserve that.
export final class EirReleasePtr extends EirInstruction {
    public long address;

    public constructor(this.address);
}

// The address of a mutable slot.
export final class EirSlotAddress extends EirInstruction {
    public long result;
    public Type type;
    public long slot;

    public constructor(this.result, this.type, this.slot);
}

// The address of a program-lifetime global, either a lazy const's value or the byte tracking how
// far its initialization has got. Defines is true in the one module that emits the storage.
export final class EirGlobalAddress extends EirInstruction {
    public long result;
    public Type type;
    public string symbol;
    public bool defines;

    public constructor(this.result, this.type, this.symbol, this.defines);
}

// The address of field fieldIndex inside the struct an address names. The index is symbolic;
// byte layout belongs to LLVM.
export final class EirFieldAddress extends EirInstruction {
    public long result;
    public Type type;
    public long base;
    public long fieldIndex;

    public constructor(this.result, this.type, this.base, this.fieldIndex);
}

// The address of element index inside an array value. A bounds check must have proven the
// index; the address itself performs no checking.
export final class EirElementAddress extends EirInstruction {
    public long result;
    public Type type;
    public long array;
    public long index;

    public constructor(this.result, this.type, this.array, this.index);
}

export final class EirLoadPtr extends EirInstruction {
    public long result;
    public Type type;
    public long address;

    public constructor(this.result, this.type, this.address);
}

export final class EirStorePtr extends EirInstruction {
    public long address;
    public long value;

    public constructor(this.address, this.value);
}

// The absent reference. It carries the type it stands for so storage and operands keep agreeing;
// its own +1 is nothing, which is why it counts as owned like any other producer.
export final class EirConstNull extends EirInstruction {
    public long result;
    public Type type;

    public constructor(this.result, this.type);
}

// A fresh instance of a class: a zeroed allocation whose header names the destructor that will
// release its fields, with a strong count of one. The value arrives owned.
export final class EirClassNew extends EirInstruction {
    public long result;
    public Type type;
    public string destructorSymbol;

    public constructor(this.result, this.type, this.destructorSymbol);
}

// The address of field fieldIndex inside the object a class reference names. The index is symbolic,
// counted over the class's flattened fields; byte layout belongs to LLVM. The base is a value, not
// an address, because a class reference already points at its object.
export final class EirObjectFieldAddress extends EirInstruction {
    public long result;
    public Type type;
    public long object;
    public long fieldIndex;

    public constructor(this.result, this.type, this.object, this.fieldIndex);
}

// A fresh function value: a zeroed closure object whose first word is the code pointer of the
// lambda's body and whose remaining words are room for one capture each, in capture order. The
// header names the destructor that gives the captured references back. The captures themselves
// are written by ordinary stores through closure_capture addresses, so a capture's reference
// changes hands through the same barrier a field's does. The value arrives owned.
//
// A lambda with nothing to capture allocates nothing: there is one immortal object per such
// lambda, so evaluating it in a loop costs no allocation and no reference counting.
export final class EirClosureNew extends EirInstruction {
    public long result;
    public Type type;
    public string targetSymbol;
    public string destructorSymbol;
    public Type[] captureTypes;

    public constructor(this.result, this.type, this.targetSymbol, this.destructorSymbol,
                this.captureTypes);
}

// The address of one capture inside the closure object a function value names. The index counts
// over the captures alone, so the code pointer the object leads with is not one of them. The base
// is a value, not an address, because a function value already points at its object.
//
// The whole capture list travels with the instruction because a function type describes the call
// and not the object: nothing else says how the captures are laid out, and the body, the
// destructor, and the creation site all have the list in hand.
export final class EirClosureCapture extends EirInstruction {
    public long result;
    public Type type;
    public long closure;
    public long captureIndex;
    public Type[] captureTypes;

    public constructor(this.result, this.type, this.closure, this.captureIndex,
                this.captureTypes);
}

// A call through a function value: the target is the code pointer the closure object leads with,
// and the object itself arrives ahead of the arguments. A target type that declares throws uses
// EirTryClosureCall instead.
export final class EirClosureCall extends EirInstruction {
    public long result;
    public Type type;
    public long closure;
    public long[] arguments;
    public Type[] parameterTypes;
    public long line;

    public constructor(this.result, this.type, this.closure, this.arguments,
                this.parameterTypes, long line = -1) {
        this.line = line;
    }
}

// Points weak storage at an object, giving up whatever it watched before. The object is read at
// +0: weak storage never owns a strong reference, so a caller holding a +1 still has to give it up.
export final class EirWeakStore extends EirInstruction {
    public long address;
    public long value;

    public constructor(this.address, this.value);
}

// Reads weak storage, upgrading to a strong reference the caller owns, or producing null when the
// object it watched is already gone.
export final class EirWeakLoad extends EirInstruction {
    public long result;
    public Type type;
    public long address;

    public constructor(this.result, this.type, this.address);
}

// Stops watching whatever weak storage points at, and leaves that storage empty.
export final class EirWeakRelease extends EirInstruction {
    public long address;

    public constructor(this.address);
}

// True when the value is a non-null instance of the target class or a subclass, or of a class
// conforming to the target interface. The test reads the value's runtime type; a null value is
// simply false, so one instruction serves plain and nullable scrutinees alike.
export final class EirTypeTest extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public Type target;

    public constructor(this.result, this.type, this.value, this.target);
}

// The value when the type test would succeed, and null otherwise. The result aliases the value
// at the target's nullable type and owns nothing of its own; lowering retains it like any other
// borrowed production it hands on.
export final class EirCheckedCast extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public Type target;

    public constructor(this.result, this.type, this.value, this.target);
}

// '==' over two references decided by their runtime types: equal when they are the same object,
// and otherwise when both are there, both carry the same runtime type, and that type's declared
// 'equals' says so. A type that declared none compares by identity. Lowering emits this only where
// some runtime type the operands can hold declares one; everywhere else '==' stays a plain
// comparison.
export final class EirDynamicEquals extends EirInstruction {
    public long result;
    public Type type;
    public long left;
    public long right;

    public constructor(this.result, this.type, this.left, this.right);
}

// The hash of one reference decided by its runtime type: the 'hash' that type declared, or the
// identity hash when it declared none. Lowering emits this only where some runtime type the value
// can hold declares one.
export final class EirDynamicHash extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The text form of one reference decided by its runtime type: the 'toString' that type declared,
// or the type's name when it declared none. The result is an owned string. Lowering emits this
// only where a value can hold more than one runtime type; a single known type answers in place.
export final class EirDynamicToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The name of one reference's runtime type, whatever text form that type declares. The result is
// an owned string. Only the standard library's intercepted 'Error.typeName' lowers to this, so a
// wrapped error's chain can name the type of each cause it prints.
export final class EirRuntimeTypeName extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// Aborts the program when index is outside the array's bounds. line is the subscript's source
// line, printed as the innermost frame of the panic's stack trace.
export final class EirBoundsCheck extends EirInstruction {
    public long array;
    public long index;
    public long line;

    public constructor(this.array, this.index, long line = -1) {
        this.line = line;
    }
}

// Aborts the program with the message unless 0 <= start <= end <= length.
export final class EirRangeCheck extends EirInstruction {
    public long start;
    public long end;
    public long length;
    public string message;
    public long line;

    public constructor(this.start, this.end, this.length, this.message, long line = -1) {
        this.line = line;
    }
}

// An immortal string literal. The bytes are the decoded UTF-8 contents.
export final class EirConstString extends EirInstruction {
    public long result;
    public Type type;
    public byte[] bytes;

    public constructor(this.result, this.type, this.bytes);
}

// A fresh array of the given length, zero-initialized. Aborts on a negative size.
//
// The stack promotion pass may pin the allocation to the frame: stackLength then holds the
// proven constant length and emission reserves the storage once at entry, laid out exactly like
// a heap array behind an immortal header, so element access, length, and any stray reference
// count all behave; the value owns nothing and dies with the frame.
export final class EirArrayNew extends EirInstruction {
    public long result;
    public Type type;
    public long size;
    public long stackLength;

    public constructor(this.result, this.type, this.size, this.stackLength = -1);

    public onStack() -> bool {
        return this.stackLength >= 0;
    }
}

export final class EirArrayLength extends EirInstruction {
    public long result;
    public Type type;
    public long array;

    public constructor(this.result, this.type, this.array);
}

// The elements of the half-open range [start, end) as a fresh array the caller owns; each copied
// reference element is retained, so the slice outlives its source. A range check must have
// proven the range; the copy itself performs no checking.
export final class EirArraySlice extends EirInstruction {
    public long result;
    public Type type;
    public long array;
    public long start;
    public long end;

    public constructor(this.result, this.type, this.array, this.start, this.end);
}

export final class EirStringConcat extends EirInstruction {
    public long result;
    public Type type;
    public long left;
    public long right;

    public constructor(this.result, this.type, this.left, this.right);
}

export final class EirStringEqual extends EirInstruction {
    public long result;
    public Type type;
    public long left;
    public long right;

    public constructor(this.result, this.type, this.left, this.right);
}

// Where the left string sorts relative to the right one, as a negative number, zero, or a
// positive number.
export final class EirStringCompare extends EirInstruction {
    public long result;
    public Type type;
    public long left;
    public long right;

    public constructor(this.result, this.type, this.left, this.right);
}

// The synthesized hash of one leaf value, always a long: an integer or enum widens by its
// signedness, a float hashes as its bit pattern, a string folds its bytes, and a reference
// hashes as its identity. Aggregates never reach this instruction; lowering folds their fields.
export final class EirHashValue extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// A present tagged optional built from a value of the payload type. The type is the optional; a
// reference optional never reaches these four instructions, because its absent form is the null
// pointer and needs no tag.
export final class EirWrapOptional extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The absent tagged optional: the tag clear and the payload zeroed.
export final class EirAbsentOptional extends EirInstruction {
    public long result;
    public Type type;

    public constructor(this.result, this.type);
}

// The presence tag of a tagged optional value, as a bool.
export final class EirOptionalPresence extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The payload of a tagged optional value, typed at the payload type. Reading an absent
// optional's payload yields its zeroed bits; a narrowing read is only lowered where sema proved
// presence, so nothing observes them.
export final class EirOptionalPayload extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The address of a tagged optional's payload inside the storage the base address names, for the
// ownership walks that reach the references a present struct payload holds.
export final class EirOptionalPayloadAddress extends EirInstruction {
    public long result;
    public Type type;
    public long base;

    public constructor(this.result, this.type, this.base);
}

export final class EirStringIndexOf extends EirInstruction {
    public long result;
    public Type type;
    public long haystack;
    public long needle;

    public constructor(this.result, this.type, this.haystack, this.needle);
}

// Whether the part's bytes are the first, or with atEnd the last, bytes of the text.
export final class EirStringHasAffix extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public long part;
    public bool atEnd;

    public constructor(this.result, this.type, this.value, this.part, this.atEnd);
}

// The text without its leading whitespace, and without its trailing whitespace when trailing is
// set, as a fresh string.
export final class EirStringTrim extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public bool trailing;

    public constructor(this.result, this.type, this.value, this.trailing);
}

// The bytes of the half-open range [start, end) as a fresh string. Aborts when the range is
// invalid.
export final class EirStringSubstring extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public long start;
    public long end;

    public constructor(this.result, this.type, this.value, this.start, this.end);
}

export final class EirStringLength extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

export final class EirStringToBytes extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

export final class EirStringFromBytes extends EirInstruction {
    public long result;
    public Type type;
    public long bytes;

    public constructor(this.result, this.type, this.bytes);
}

// The decimal text of a long value, read as unsigned when signed is false.
export final class EirIntToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public bool signed;

    public constructor(this.result, this.type, this.value, this.signed);
}

// The UTF-8 encoding of a Unicode scalar as a one-character string.
export final class EirCharToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

export final class EirBoolToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The declared name of the enum member whose value the operand holds, resolved by matching the
// member values so sparse and negative assignments stay correct.
export final class EirEnumToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;
    public Type enumType;

    public constructor(this.result, this.type, this.value, this.enumType);
}

export final class EirDoubleToString extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// The JSON string form of a string: double-quoted with escapes; a null string renders as "".
export final class EirJsonEscape extends EirInstruction {
    public long result;
    public Type type;
    public long value;

    public constructor(this.result, this.type, this.value);
}

// Writes the string and a newline to standard output.
export final class EirPrint extends EirInstruction {
    public long value;

    public constructor(this.value);
}

// A call to a foreign function under its exact C name. Arguments and the result marshal by the
// declared sema types: a string or array argument passes its data pointer, an out-flagged
// argument is the address of the local the C function writes back to, and a declared string
// result is lifted into an owned Ens string. Foreign calls never unwind.
export final class EirForeignCall extends EirInstruction {
    public long result;
    public Type type;
    public string symbol;
    public long[] arguments;
    public Type[] parameterTypes;
    public bool[] outFlags;

    public constructor(this.result, this.type, this.symbol, this.arguments,
                this.parameterTypes, this.outFlags);
}

// The bytes a foreign NUL-terminated handle points at, copied into an owned Ens string; a null
// handle lifts to the null string?, so unset stays distinct from empty.
export final class EirCStringLift extends EirInstruction {
    public long result;
    public Type type;
    public long handle;

    public constructor(this.result, this.type, this.handle);
}

// Writes "panic: " and the string to standard error with a stack trace captured here, then
// exits with code 134.
export final class EirPanic extends EirInstruction {
    public long value;
    public long line;

    public constructor(this.value, long line = -1) {
        this.line = line;
    }
}

// Captures the current stack into the error object's trace, releasing whatever trace it carried
// before. line is the throw's source line, the innermost frame of the captured trace.
export final class EirCaptureTrace extends EirInstruction {
    public long error;
    public long line;

    public constructor(this.error, this.line);
}

// The trace an error carries, symbolicated lazily: as the formatted text when structured is
// false, and as the StackFrame array when it is true. The result is a fresh value the caller
// owns.
export final class EirErrorTrace extends EirInstruction {
    public long result;
    public Type type;
    public long error;
    public bool structured;

    public constructor(this.result, this.type, this.error, this.structured);
}

export sealed abstract class EirTerminator {
}

// Returns value, or returns void when value is -1.
export final class EirReturn extends EirTerminator {
    public long value;

    public constructor(this.value);
}

export final class EirJump extends EirTerminator {
    public long target;

    public constructor(this.target);
}

export final class EirBranch extends EirTerminator {
    public long condition;
    public long thenTarget;
    public long elseTarget;

    public constructor(this.condition, this.thenTarget, this.elseTarget);
}

// An integer switch. caseValues and caseTargets are parallel; values are the scrutinee-typed
// constants as two's-complement bit patterns.
export final class EirSwitch extends EirTerminator {
    public long value;
    public long[] caseValues;
    public long[] caseTargets;
    public long defaultTarget;

    public constructor(this.value, this.caseValues, this.caseTargets, this.defaultTarget);
}

export final class EirUnreachable extends EirTerminator {
    public constructor();
}

// A call whose callee may throw, so the block ends here: the callee reports through the error
// slot the caller passes, and control continues at normalTarget when the slot stays null or at
// unwindTarget when it does not. The call fields mirror EirCall's. result is defined only along
// the normal edge; errorResult holds the thrown error, owned, only along the unwind edge. The
// unwind block carries the cleanup lowering materialized for exactly this site.
export final class EirTryCall extends EirTerminator {
    public long result;
    public Type type;
    public EirCallee callee;
    public long receiver;
    public long[] arguments;
    public long dispatchSlot;
    public Type? dispatchInterface;
    public long errorResult;
    public long normalTarget;
    public long unwindTarget;
    public long line;

    public constructor(this.result, this.type, this.callee, this.receiver, this.arguments,
                this.dispatchSlot, this.dispatchInterface, this.errorResult, this.normalTarget,
                this.unwindTarget, this.line);
}

// A call through a function value whose target type declares throws, ending the block as
// EirTryCall does. The closure and argument fields mirror EirClosureCall's; the error and edge
// fields mirror EirTryCall's.
export final class EirTryClosureCall extends EirTerminator {
    public long result;
    public Type type;
    public long closure;
    public long[] arguments;
    public Type[] parameterTypes;
    public long errorResult;
    public long normalTarget;
    public long unwindTarget;
    public long line;

    public constructor(this.result, this.type, this.closure, this.arguments,
                this.parameterTypes, this.errorResult, this.normalTarget, this.unwindTarget,
                this.line);
}

// Hands a thrown error to the caller: writes it into the error slot the caller passed and
// returns the zero of the function's return type. The error's +1 transfers to the caller, and
// every other owned value must have been released before this point.
export final class EirPropagate extends EirTerminator {
    public long error;

    public constructor(this.error);
}

export final class EirBlock {
    string blockLabel;
    List<EirInstruction> blockInstructions;
    EirTerminator? blockTerminator;

    public constructor(string label) {
        this.blockLabel = label;
        this.blockInstructions = new List<EirInstruction>();
        this.blockTerminator = null;
    }

    export label() -> string {
        return this.blockLabel;
    }

    export instructions() -> List<EirInstruction> {
        return this.blockInstructions;
    }

    export terminator() -> EirTerminator? {
        return this.blockTerminator;
    }

    public setTerminator(EirTerminator terminator) {
        this.blockTerminator = terminator;
    }
}

// One lowered function. When the function is a method, temp 0 is the receiver's address and
// the parameters follow it; otherwise the first parameters().length temps are the parameters.
// Every temp's type is recorded in tempTypes, indexed by temp id. Block 0 is the entry block.
//
// A throwing function's ABI carries one more trailing parameter, the address of its caller's
// error slot; the slot never appears as a temp, because EirPropagate is the only thing that
// writes it. The trace fields describe the function as a stack trace prints it - its display
// name, its file, and the line it is declared on - with an empty name meaning the function
// never appears in a trace; traceEntry marks the program entry, where a captured trace stops.
export final class EirFunction {
    string functionSymbol;
    bool internal;
    Type? functionReceiverType;
    EirParameter[] functionParameters;
    Type functionReturnType;
    List<EirSlot> functionSlots;
    List<EirBlock> functionBlocks;
    List<Type> functionTempTypes;
    bool functionThrows;
    string functionTraceName;
    string functionTraceFile;
    long functionTraceLine;
    bool functionTraceEntry;

    public constructor(string symbol, bool internalLinkage, Type? receiverType,
                EirParameter[] parameters, Type returnType, List<EirSlot> slots,
                List<EirBlock> blocks, List<Type> tempTypes, bool throwing = false,
                string traceName = "", string traceFile = "", long traceLine = -1,
                bool traceEntry = false) {
        this.functionSymbol = symbol;
        this.internal = internalLinkage;
        this.functionReceiverType = receiverType;
        this.functionParameters = parameters;
        this.functionReturnType = returnType;
        this.functionSlots = slots;
        this.functionBlocks = blocks;
        this.functionTempTypes = tempTypes;
        this.functionThrows = throwing;
        this.functionTraceName = traceName;
        this.functionTraceFile = traceFile;
        this.functionTraceLine = traceLine;
        this.functionTraceEntry = traceEntry;
    }

    export symbol() -> string {
        return this.functionSymbol;
    }

    export internalLinkage() -> bool {
        return this.internal;
    }

    export receiverType() -> Type? {
        return this.functionReceiverType;
    }

    export parameters() -> EirParameter[] {
        return this.functionParameters;
    }

    // The temps defined before the entry block runs: the receiver's address when there is one,
    // then the parameters.
    export entryTempCount() -> long {
        long count = this.functionParameters.length;
        if (this.functionReceiverType != null) {
            count++;
        }
        return count;
    }

    export returnType() -> Type {
        return this.functionReturnType;
    }

    export slots() -> List<EirSlot> {
        return this.functionSlots;
    }

    export blocks() -> List<EirBlock> {
        return this.functionBlocks;
    }

    export tempTypes() -> List<Type> {
        return this.functionTempTypes;
    }

    export throwing() -> bool {
        return this.functionThrows;
    }

    export traceName() -> string {
        return this.functionTraceName;
    }

    export traceFile() -> string {
        return this.functionTraceFile;
    }

    export traceLine() -> long {
        return this.functionTraceLine;
    }

    export isEntryPoint() -> bool {
        return this.functionTraceEntry;
    }
}

// Builds one function. Temp numbering and block labels are builder-local, so lowering different
// functions in parallel never contends on shared state.
export final class EirFunctionBuilder {
    string symbol;
    bool internal;
    Type? receiverType;
    EirParameter[] parameters;
    Type returnType;
    List<EirSlot> slots;
    List<EirBlock> blocks;
    List<Type> tempTypes;
    long currentBlock;
    bool throwingFunction;
    string functionTraceName;
    string functionTraceFile;
    long functionTraceLine;
    bool functionTraceEntry;

    public constructor(string symbol, bool internalLinkage, Type? receiverType,
                EirParameter[] parameters, Type returnType) {
        this.symbol = symbol;
        this.internal = internalLinkage;
        this.receiverType = receiverType;
        this.parameters = parameters;
        this.returnType = returnType;
        this.slots = new List<EirSlot>();
        this.blocks = new List<EirBlock>();
        this.tempTypes = new List<Type>();
        this.throwingFunction = false;
        this.functionTraceName = "";
        this.functionTraceFile = "";
        this.functionTraceLine = -1;
        this.functionTraceEntry = false;
        if (receiverType != null) {
            this.tempTypes.push(receiverType);
        }
        for (let parameter in parameters) {
            this.tempTypes.push(parameter.type());
        }
        this.currentBlock = this.newBlock("entry");
    }

    // Marks the function as reporting through a trailing error-slot parameter.
    public setThrowing() {
        this.throwingFunction = true;
    }

    public isThrowing() -> bool {
        return this.throwingFunction;
    }

    // Records how a stack trace prints this function, and whether it is the program entry.
    public setTrace(string name, string file, long line, bool entryPoint) {
        this.functionTraceName = name;
        this.functionTraceFile = file;
        this.functionTraceLine = line;
        this.functionTraceEntry = entryPoint;
    }

    public newTemp(Type type) -> long {
        this.tempTypes.push(type);
        return this.tempTypes.length() - 1;
    }

    public tempType(long temp) -> Type {
        return this.tempTypes.get(temp);
    }

    // Adds a slot. A slot holding references starts zeroed so the first write into it can
    // release the previous contents unconditionally; a borrowing slot owns nothing it holds.
    public addSlot(string name, Type type, bool zeroed, bool borrowing) -> long {
        this.slots.push(new EirSlot(name, type, zeroed, borrowing));
        return this.slots.length() - 1;
    }

    public slotType(long slot) -> Type {
        return this.slots.get(slot).type();
    }

    public newBlock(string hint) -> long {
        let index = this.blocks.length();
        this.blocks.push(new EirBlock("b{index}.{hint}"));
        return index;
    }

    public current() -> long {
        return this.currentBlock;
    }

    public moveTo(long block) {
        this.currentBlock = block;
    }

    // True when the current block already ended; nothing more may be appended to it.
    public terminated() -> bool {
        return this.blocks.get(this.currentBlock).terminator() != null;
    }

    public append(EirInstruction instruction) {
        this.blocks.get(this.currentBlock).instructions().push(instruction);
    }

    public terminate(EirTerminator terminator) {
        this.blocks.get(this.currentBlock).setTerminator(terminator);
    }

    public finish() -> EirFunction {
        return new EirFunction(this.symbol, this.internal, this.receiverType, this.parameters,
            this.returnType, this.slots, this.blocks, this.tempTypes, this.throwingFunction,
            this.functionTraceName, this.functionTraceFile, this.functionTraceLine,
            this.functionTraceEntry);
    }
}
