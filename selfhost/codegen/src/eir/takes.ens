// The take verifier, for the one rewrite that moves a slot's +1 out of it. A later read of the
// slot would find null, and a reference borrowed out before the take would outlive the +1 that
// kept it valid, which balances perfectly and so is invisible to the other two verifiers.
import EirFunction from eir.model;
import EirTakeSlot from eir.model;
import eir.slotuses;
import List from @std.collections.list;

// Verifies every take in one function; the returned list is empty when all of them hold.
export verifyTakes(EirFunction function) -> string[] {
    let problems = new List<string>();
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (!(instruction is EirTakeSlot)) {
                continue;
            }
            checkTake(function, instruction.slot, b, i, problems);
        }
    }
    return problems.toArray();
}

// One take, reported at most once: a slot read again says everything a borrowed reference would
// say about the same mistake.
checkTake(EirFunction function, long slot, long block, long index, List<string> problems) {
    let uses = slotuses.forMove(function, slot, block, index);
    string label = function.blocks().get(block).label();
    if (uses.readAgain()) {
        problems.push("{function.symbol()}: {label}: {describeSlot(function, slot)} is read again "
            + "after the take moved its reference out, so that read finds null instead of the "
            + "object that was there");
        return;
    }
    long borrowed = uses.borrowStillUsed();
    if (borrowed < 0) {
        return;
    }
    problems.push("{function.symbol()}: {label}: %{borrowed} borrows what "
        + "{describeSlot(function, slot)} held and is still used after the take moved that "
        + "reference out, so the object it names may already be gone");
}

describeSlot(EirFunction function, long slot) -> string {
    if (slot < 0 || slot >= function.slots().length()) {
        return "slot ${slot}";
    }
    return "slot ${slot} '{function.slots().get(slot).name()}'";
}
