// Normalizes an address temp into the place it names: a root plus a projection path. The walk
// follows each address temp's single defining instruction, so it always terminates at a slot, at
// an array value, at the object a class reference names, or at an address that arrived as the
// function's receiver. A receiver is an opaque root: nothing is known about its base, so identity
// questions across it answer unknown, never different. The ownership verifier is the first
// consumer; later passes ask the same questions through this module instead of re-tracing
// instructions.
import Type from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Field from @ens.sema.model.types;
import @ens.sema.model.types;
import EirFunction from eir.model;
import EirInstruction from eir.model;
import EirSlotAddress from eir.model;
import EirFieldAddress from eir.model;
import EirObjectFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirOptionalPayloadAddress from eir.model;
import List from @std.collections.list;
import support.primitives;

export enum PlaceRoot {
    Slot,
    Receiver,
    Array,
    Object,
}

export enum PlaceStepKind {
    Field,
    Element,
    Payload,
}

// One projection step: a symbolic field index into a struct, an element index held by a temp,
// or the payload of a tagged optional, which projects without an index.
export final class PlaceStep {
    PlaceStepKind stepKind;
    long stepValue;

    public constructor(this.stepKind, this.stepValue);

    export kind() -> PlaceStepKind {
        return this.stepKind;
    }

    export isField() -> bool {
        return this.stepKind == PlaceStepKind.Field;
    }

    // The field index for a field step, the index temp for an element step.
    export value() -> long {
        return this.stepValue;
    }
}

export final class Place {
    PlaceRoot rootKind;
    long rootValue;
    List<PlaceStep> path;

    public constructor(this.rootKind, this.rootValue, this.path);

    export root() -> PlaceRoot {
        return this.rootKind;
    }

    // The slot id for a slot root, and otherwise the temp the root reached: the receiver, the
    // array, or the class reference the object sits behind.
    export rootId() -> long {
        return this.rootValue;
    }

    export steps() -> List<PlaceStep> {
        return this.path;
    }
}

export enum PlaceRelation {
    Same,
    Different,
    Unknown,
}

// The place an address temp names, or null when the temp is not an address of this function.
export placeOf(EirFunction function, long address) -> Place? {
    let definitions = addressDefinitions(function);
    return resolvePlace(function, definitions, address);
}

// How two places relate: Same only when they provably name one location, Different only when
// they provably cannot, Unknown otherwise. A receiver root is opaque, so any question across
// one that is not structurally identical stays Unknown; two distinct array or object temps may
// hold the same reference, so those stay Unknown too. A place that is a strict prefix of the other
// contains it, which is neither same nor disjoint, so that is Unknown as well.
export relate(Place first, Place second) -> PlaceRelation {
    if (first.root() != second.root()) {
        if (first.root() == PlaceRoot.Receiver || second.root() == PlaceRoot.Receiver) {
            return PlaceRelation.Unknown;
        }
        return PlaceRelation.Different;
    }
    if (first.rootId() != second.rootId()) {
        return switch (first.root()) {
            Slot -> PlaceRelation.Different,
            default -> PlaceRelation.Unknown,
        };
    }
    let firstSteps = first.steps();
    let secondSteps = second.steps();
    long shared = firstSteps.length();
    if (secondSteps.length() < shared) {
        shared = secondSteps.length();
    }
    bool exact = true;
    for (long i = 0; i < shared; i++) {
        let a = firstSteps.get(i);
        let b = secondSteps.get(i);
        if (a.kind() != b.kind()) {
            return PlaceRelation.Unknown;
        }
        if (a.isField()) {
            if (a.value() != b.value()) {
                return PlaceRelation.Different;
            }
        } else if (a.kind() == PlaceStepKind.Element && a.value() != b.value()) {
            exact = false;
        }
    }
    if (firstSteps.length() != secondSteps.length()) {
        return PlaceRelation.Unknown;
    }
    if (exact) {
        return PlaceRelation.Same;
    }
    return PlaceRelation.Unknown;
}

// The type of the storage a place names, or null when the walk cannot see it - which happens for a
// place rooted at an opaque receiver whose type is unknown, or one whose steps do not match the
// types along the path.
export typeOfPlace(EirFunction function, Place named) -> Type? {
    Type? current = rootTypeOf(function, named);
    let steps = named.steps();
    for (long i = 0; i < steps.length(); i++) {
        current = stepThrough(current, steps.get(i));
    }
    return current;
}

// The declared field a place's last step names, or null when the place does not end in a field or
// the walk cannot see the owner's type. This is what tells a storage check whether it is looking at
// a weak field, which is reached by different operations than a strong one.
export finalFieldOf(EirFunction function, Place named) -> Field? {
    let steps = named.steps();
    if (steps.length() == 0) {
        return null;
    }
    Type? current = rootTypeOf(function, named);
    for (long i = 0; i + 1 < steps.length(); i++) {
        current = stepThrough(current, steps.get(i));
    }
    return fieldAt(current, steps.get(steps.length() - 1));
}

rootTypeOf(EirFunction function, Place named) -> Type? {
    return switch (named.root()) {
        Slot -> function.slots().get(named.rootId()).type(),
        Receiver -> opaqueRootType(function, named.rootId()),
        default -> tempTypeOf(function, named.rootId()),
    };
}

// The type one projection step reaches, or null when the step does not fit the current type.
stepThrough(Type? current, PlaceStep step) -> Type? {
    if (step.kind() == PlaceStepKind.Element) {
        return elementTypeAfterIndex(current);
    }
    if (step.kind() == PlaceStepKind.Payload) {
        if (current is OptionalType && !primitives.isReferenceType(current)) {
            return current.inner();
        }
        return null;
    }
    let field = fieldAt(current, step);
    if (field == null) {
        return null;
    }
    return field.type();
}

fieldAt(Type? owner, PlaceStep step) -> Field? {
    if (!step.isField()) {
        return null;
    }
    let fields = fieldsOf(owner);
    if (fields == null || step.value() < 0 || step.value() >= fields.length()) {
        return null;
    }
    return fields.get(step.value());
}

// A readable spelling of the place an address temp names, for the dump: the slot's name, 'this'
// for the receiver, or the array temp, followed by field names and [%index] steps. Returns ""
// when the temp is not an address.
export describe(EirFunction function, long address) -> string {
    let place = placeOf(function, address);
    if (place == null) {
        return "";
    }
    string text = switch (place.root()) {
        Slot -> function.slots().get(place.rootId()).name(),
        Receiver -> opaqueRootName(function, place.rootId()),
        default -> "%{place.rootId()}",
    };
    Type? current = rootTypeOf(function, place);
    let steps = place.steps();
    for (long i = 0; i < steps.length(); i++) {
        let step = steps.get(i);
        if (step.isField()) {
            let field = fieldAt(current, step);
            text = text + "." + (field == null ? "{step.value()}" : field.name());
        } else if (step.kind() == PlaceStepKind.Payload) {
            text = text + ".payload";
        } else {
            text = text + "[%{step.value()}]";
        }
        current = stepThrough(current, step);
    }
    return text;
}

resolvePlace(EirFunction function, List<AddressDefinition> definitions, long address)
        -> Place? {
    let steps = new List<PlaceStep>();
    long current = address;
    while (true) {
        if (isOpaqueRoot(function, current)) {
            return new Place(PlaceRoot.Receiver, current, reversed(steps));
        }
        let definition = definitionOf(definitions, current);
        if (definition == null) {
            return null;
        }
        switch (definition.instruction) {
            is EirSlotAddress slotAddress -> {
                return new Place(PlaceRoot.Slot, slotAddress.slot, reversed(steps));
            },
            is EirFieldAddress fieldAddress -> {
                steps.push(new PlaceStep(PlaceStepKind.Field, fieldAddress.fieldIndex));
                current = fieldAddress.base;
            },
            is EirObjectFieldAddress fieldAddress -> {
                steps.push(new PlaceStep(PlaceStepKind.Field, fieldAddress.fieldIndex));
                return new Place(PlaceRoot.Object, fieldAddress.object, reversed(steps));
            },
            is EirElementAddress elementAddress -> {
                steps.push(new PlaceStep(PlaceStepKind.Element, elementAddress.index));
                return new Place(PlaceRoot.Array, elementAddress.array, reversed(steps));
            },
            is EirOptionalPayloadAddress payloadAddress -> {
                steps.push(new PlaceStep(PlaceStepKind.Payload, 0));
                current = payloadAddress.base;
            },
            default -> {
                return null;
            },
        }
    }
}

// True for the receiver address a struct method runs over, which is an opaque root: its caller
// owns the storage and nothing here knows where it lives. A class method's receiver is a
// reference, not an address, so it is not one of these.
export isOpaqueReceiver(EirFunction function, long temp) -> bool {
    let receiverType = function.receiverType();
    return temp == 0 && receiverType != null && primitives.classOf(receiverType) == null;
}

// True for any address that arrived with the function: the struct receiver, or a parameter the
// ABI passes by address. Every one is an opaque root the place walk stops at.
export isOpaqueRoot(EirFunction function, long temp) -> bool {
    if (isOpaqueReceiver(function, temp)) {
        return true;
    }
    long offset = 0;
    if (function.receiverType() != null) {
        offset = 1;
    }
    long index = temp - offset;
    let parameters = function.parameters();
    return index >= 0 && index < parameters.length && parameters[index].byAddress();
}

// The declared type behind an opaque root: the receiver's, or the by-address parameter's.
opaqueRootType(EirFunction function, long temp) -> Type? {
    let receiverType = function.receiverType();
    if (temp == 0 && receiverType != null) {
        return receiverType;
    }
    long offset = 0;
    if (receiverType != null) {
        offset = 1;
    }
    long index = temp - offset;
    let parameters = function.parameters();
    if (index >= 0 && index < parameters.length) {
        return parameters[index].type();
    }
    return null;
}

opaqueRootName(EirFunction function, long temp) -> string {
    if (temp == 0 && function.receiverType() != null) {
        return "this";
    }
    long offset = 0;
    if (function.receiverType() != null) {
        offset = 1;
    }
    long index = temp - offset;
    let parameters = function.parameters();
    if (index >= 0 && index < parameters.length) {
        return parameters[index].name();
    }
    return "%{temp}";
}

fieldsOf(Type? owner) -> List<Field>? {
    if (owner == null) {
        return null;
    }
    if (owner is StructType) {
        return owner.fields();
    }
    let classType = primitives.classOf(owner);
    if (classType != null) {
        return types.fieldsOf(classType);
    }
    let structType = primitives.structOf(owner);
    if (structType != null) {
        return types.fieldsOf(structType);
    }
    return null;
}

class AddressDefinition {
    protected long result;
    protected EirInstruction instruction;

    protected constructor(this.result, this.instruction);
}

addressDefinitions(EirFunction function) -> List<AddressDefinition> {
    let definitions = new List<AddressDefinition>();
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            switch (instruction) {
                is EirSlotAddress slotAddress -> {
                    definitions.push(new AddressDefinition(slotAddress.result, instruction));
                },
                is EirFieldAddress fieldAddress -> {
                    definitions.push(new AddressDefinition(fieldAddress.result, instruction));
                },
                is EirObjectFieldAddress fieldAddress -> {
                    definitions.push(new AddressDefinition(fieldAddress.result, instruction));
                },
                is EirElementAddress elementAddress -> {
                    definitions.push(new AddressDefinition(elementAddress.result, instruction));
                },
                is EirOptionalPayloadAddress payloadAddress -> {
                    definitions.push(new AddressDefinition(payloadAddress.result,
                        instruction));
                },
                default -> { },
            }
        }
    }
    return definitions;
}

definitionOf(List<AddressDefinition> definitions, long temp) -> AddressDefinition? {
    for (long i = 0; i < definitions.length(); i++) {
        if (definitions.get(i).result == temp) {
            return definitions.get(i);
        }
    }
    return null;
}

reversed(List<PlaceStep> steps) -> List<PlaceStep> {
    let out = new List<PlaceStep>();
    for (long i = steps.length() - 1; i >= 0; i--) {
        out.push(steps.get(i));
    }
    return out;
}

tempTypeOf(EirFunction function, long temp) -> Type? {
    if (temp < 0 || temp >= function.tempTypes().length()) {
        return null;
    }
    return function.tempTypes().get(temp);
}

elementTypeAfterIndex(Type? arrayType) -> Type? {
    if (arrayType == null) {
        return null;
    }
    let array = primitives.arrayOf(arrayType);
    if (array != null) {
        return array.element();
    }
    return null;
}
