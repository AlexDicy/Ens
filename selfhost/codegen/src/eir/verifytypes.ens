// No type parameter may survive lowering: a generic body lowers per instance under a complete
// substitution, so every type a lowered function mentions - its signature, its slots, its temps,
// and the types embedded in calls and runtime type tests - must be concrete. A leak here means a
// substitution was skipped, and would emit as a garbage layout, so it is rejected before anything
// downstream can trust the types.
import ArrayType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeParamType from @ens.sema.model.types;
import @ens.sema.model.types;
import EirCall from eir.model;
import EirCheckedCast from eir.model;
import EirClassNew from eir.model;
import EirFunction from eir.model;
import EirInstruction from eir.model;
import EirTypeTest from eir.model;
import VerificationContext from eir.verifycontext;

public checkConcreteTypes(VerificationContext verification) {
    let function = verification.function();
    let receiver = function.receiverType();
    if (receiver != null) {
        checkType(verification, receiver, "the receiver");
    }
    let parameters = function.parameters();
    for (long i = 0; i < parameters.length; i++) {
        checkType(verification, parameters[i].type(), "parameter '{parameters[i].name()}'");
    }
    checkType(verification, function.returnType(), "the return type");
    let slots = function.slots();
    for (long i = 0; i < slots.length(); i++) {
        checkType(verification, slots.get(i).type(), "slot ${i}");
    }
    let temps = function.tempTypes();
    for (long i = 0; i < temps.length(); i++) {
        checkType(verification, temps.get(i), "%{i}");
    }
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            checkEmbedded(verification, instructions.get(i));
        }
    }
}

// The types an instruction carries beyond its result temp's.
checkEmbedded(VerificationContext verification, EirInstruction instruction) {
    switch (instruction) {
        is EirCall call -> {
            let callee = call.callee;
            let receiver = callee.receiverType();
            if (receiver != null) {
                checkType(verification, receiver, "the callee receiver of '{callee.symbol()}'");
            }
            let parameters = callee.parameterTypes();
            for (long i = 0; i < parameters.length; i++) {
                checkType(verification, parameters[i],
                    "a callee parameter of '{callee.symbol()}'");
            }
            checkType(verification, callee.returnType(),
                "the callee return of '{callee.symbol()}'");
            let dispatched = call.dispatchInterface;
            if (dispatched != null) {
                checkType(verification, dispatched, "the dispatch interface");
            }
        },
        is EirTypeTest test -> {
            checkType(verification, test.target, "the tested type");
        },
        is EirCheckedCast cast -> {
            checkType(verification, cast.target, "the cast target");
        },
        is EirClassNew allocation -> {
            checkType(verification, allocation.type, "the allocated class");
        },
        default -> { },
    }
}

checkType(VerificationContext verification, Type type, string where) {
    if (mentionsTypeParameter(type)) {
        verification.report("{where} mentions the type parameter type "
            + "'{types.display(type)}', which no lowered function may carry: the substitution "
            + "did not reach it");
    }
}

mentionsTypeParameter(Type type) -> bool {
    switch (type) {
        is TypeParamType parameter -> {
            return true;
        },
        is OptionalType optional -> {
            return mentionsTypeParameter(optional.inner());
        },
        is ArrayType array -> {
            return mentionsTypeParameter(array.element());
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                if (mentionsTypeParameter(argument)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}
