// The storage half of ownership verification, the companion to the value half in eir.ownership.
// Every instruction that moves the +1 a location holds names it through an address, which this
// pass normalizes into a place. That a callee leaves its caller's storage alone is assumed.
import EirFunction from eir.model;
import EirBlock from eir.model;
import EirCall from eir.model;
import EirClosureCall from eir.model;
import EirForeignCall from eir.model;
import EirFieldAddress from eir.model;
import EirInstruction from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirStorePtr from eir.model;
import EirStoreSlot from eir.model;
import EirSlotAddress from eir.model;
import EirTakeSlot from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import AddressPlaces from eir.place;
import Place from eir.place;
import PlaceRelation from eir.place;
import PlaceRoot from eir.place;
import eir.dump;
import eir.place;
import eir.walk;
import @ens.sema.model.typenames;
import support.primitives;
import List from @std.collections.list;

// Verifies one function's storage-level ownership; the returned list is empty when it holds.
export verifyStorage(EirFunction function) -> string[] {
    let problems = new List<string>();
    let places = place.addressPlaces(function);
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        checkBlock(function, places, blocks.get(b), problems);
    }
    checkWrittenBeforeRead(function, places, problems);
    return problems.toArray();
}

checkBlock(EirFunction function, AddressPlaces places, EirBlock block, List<string> problems) {
    let released = new List<Place>();
    let instructions = block.instructions();
    for (long i = 0; i < instructions.length(); i++) {
        let instruction = instructions.get(i);
        switch (instruction) {
            is EirRetainPtr retain -> {
                checkOwning(function, places, block, retain.address, "retain_ptr", problems);
            },
            is EirReleasePtr release -> {
                checkOwning(function, places, block, release.address, "release_ptr", problems);
                let named = places.placeOf(release.address);
                if (named != null) {
                    reportRepeatedRelease(function, block, named, released, problems);
                    released.push(named);
                }
            },
            is EirStorePtr store -> {
                checkNotWeak(function, places, block, store.address, "store_ptr", problems);
                released = releasesSurvivingWrite(places, store.address, released);
            },
            // A write into a whole slot replaces everything inside it, references included.
            is EirStoreSlot store -> {
                released = releasesOutsideSlot(released, store.slot);
            },
            // A take writes null into the slot, so earlier releases of it no longer apply.
            is EirTakeSlot taken -> {
                released = releasesOutsideSlot(released, taken.slot);
            },
            is EirWeakStore store -> {
                checkWeak(function, places, block, store.address, "weak.store", problems);
            },
            is EirWeakLoad load -> {
                checkWeak(function, places, block, load.address, "weak.load", problems);
            },
            is EirWeakRelease release -> {
                checkWeak(function, places, block, release.address, "weak.release", problems);
            },
            // A callee may write any storage it was handed, so nothing released before a call is
            // still known to be empty afterwards. A foreign callee writes its out arguments the
            // same way.
            is EirCall ignored -> {
                released = new List<Place>();
            },
            is EirClosureCall ignored -> {
                released = new List<Place>();
            },
            is EirForeignCall ignored -> {
                released = new List<Place>();
            },
            default -> { },
        }
    }
}

// A slot that does not start zeroed holds whatever the stack held until something writes it, so
// reading it, a release included, is sound only once every path from the entry has written it.
// A forward dataflow computes the slots definitely written at each block entry, to a fixpoint.
checkWrittenBeforeRead(EirFunction function, AddressPlaces places, List<string> problems) {
    let slots = function.slots();
    long slotCount = slots.length();
    bool[] zeroed = new bool[slotCount + 1];
    bool watching = false;
    for (long s = 0; s < slotCount; s++) {
        zeroed[s] = slots.get(s).startsZeroed();
        watching = watching || !zeroed[s];
    }
    let blocks = function.blocks();
    long blockCount = blocks.length();
    if (!watching || blockCount == 0) {
        return;
    }
    let addresses = new SlotAddresses(function, places);
    bool[][] writtenInBlock = new bool[blockCount][slotCount + 1];
    for (long b = 0; b < blockCount; b++) {
        applyBlock(function, addresses, blocks.get(b), writtenInBlock[b], null);
    }
    bool[][] writtenAtEntry = new bool[blockCount][slotCount + 1];
    bool[] reached = new bool[blockCount + 1];
    writtenAtEntry[0] = zeroed;
    reached[0] = true;
    bool changed = true;
    while (changed) {
        changed = false;
        for (long b = 0; b < blockCount; b++) {
            if (!reached[b]) {
                continue;
            }
            bool[] entry = writtenAtEntry[b];
            bool[] inside = writtenInBlock[b];
            for (let successor in walk.successorsOf(blocks.get(b))) {
                if (successor < 0 || successor >= blockCount) {
                    continue;
                }
                bool[] known = writtenAtEntry[successor];
                bool first = !reached[successor];
                reached[successor] = true;
                for (long s = 0; s < slotCount; s++) {
                    bool written = entry[s] || inside[s];
                    if (first) {
                        known[s] = written;
                    } else if (known[s] && !written) {
                        known[s] = false;
                        changed = true;
                    }
                }
                changed = changed || first;
            }
        }
    }
    for (long b = 0; b < blockCount; b++) {
        if (reached[b]) {
            applyBlock(function, addresses, blocks.get(b), copied(writtenAtEntry[b]), problems);
        }
    }
}

// Marks the slots one block writes, in order, and reports each read of a slot not written yet
// when problems is given. A call reads what it is handed, except a foreign call's out argument,
// which the C function writes.
applyBlock(EirFunction function, SlotAddresses addresses, EirBlock block, bool[] written,
           List<string>? problems) {
    let instructions = block.instructions();
    for (long i = 0; i < instructions.length(); i++) {
        let instruction = instructions.get(i);
        switch (instruction) {
            is EirStoreSlot store -> {
                markWritten(written, store.slot);
            },
            is EirLoadSlot load -> {
                checkRead(function, block, instruction, load.slot, written, problems);
            },
            is EirTakeSlot taken -> {
                checkRead(function, block, instruction, taken.slot, written, problems);
                markWritten(written, taken.slot);
            },
            is EirStorePtr store -> {
                markWritten(written, addresses.wholeSlotOf(store.address));
            },
            is EirSlotAddress ignored -> { },
            is EirFieldAddress ignored -> { },
            is EirOptionalPayloadAddress ignored -> { },
            is EirForeignCall call -> {
                for (long a = 0; a < call.arguments.length; a++) {
                    long argument = call.arguments[a];
                    if (a < call.outFlags.length && call.outFlags[a]) {
                        markWritten(written, addresses.wholeSlotOf(argument));
                    } else {
                        checkRead(function, block, instruction, addresses.slotOf(argument),
                            written, problems);
                    }
                }
            },
            default -> {
                for (let used in walk.usesOf(instruction)) {
                    checkRead(function, block, instruction, addresses.slotOf(used), written,
                        problems);
                }
            },
        }
    }
    let terminator = block.terminator();
    if (terminator == null || problems == null) {
        return;
    }
    for (let used in walk.terminatorUsesOf(terminator)) {
        long slot = addresses.slotOf(used);
        if (slot >= 0 && slot < written.length && !written[slot]) {
            reportUnwritten(function, block, dump.terminatorText(function, terminator), slot,
                problems);
        }
    }
}

checkRead(EirFunction function, EirBlock block, EirInstruction instruction, long slot,
          bool[] written, List<string>? problems) {
    if (problems == null || slot < 0 || slot >= written.length || written[slot]) {
        return;
    }
    reportUnwritten(function, block, dump.instructionText(instruction), slot, problems);
}

reportUnwritten(EirFunction function, EirBlock block, string reader, long slot,
                List<string> problems) {
    report(function, block, problems, "'{reader}' reads ${slot} "
        + "'{function.slots().get(slot).name()}' on a path that never wrote it; the slot does "
        + "not start zeroed, so the read finds whatever the stack held there");
}

markWritten(bool[] written, long slot) {
    if (slot >= 0 && slot < written.length) {
        written[slot] = true;
    }
}

copied(bool[] flags) -> bool[] {
    bool[] copy = new bool[flags.length];
    for (long i = 0; i < flags.length; i++) {
        copy[i] = flags[i];
    }
    return copy;
}

// The slot each address temp of one function reaches into, and whether it names that whole slot.
final class SlotAddresses {
    long[] slots;
    bool[] whole;

    constructor(EirFunction function, AddressPlaces places) {
        long count = function.tempTypes().length();
        this.slots = new long[count + 1];
        this.whole = new bool[count + 1];
        for (long t = 0; t < this.slots.length; t++) {
            this.slots[t] = -1;
        }
        let blocks = function.blocks();
        for (long b = 0; b < blocks.length(); b++) {
            let instructions = blocks.get(b).instructions();
            for (long i = 0; i < instructions.length(); i++) {
                let instruction = instructions.get(i);
                long result = walk.resultOf(instruction);
                if (!walk.producesAddress(instruction) || result < 0 || result >= count) {
                    continue;
                }
                let named = places.placeOf(result);
                if (named != null && named.root() == PlaceRoot.Slot) {
                    this.slots[result] = named.rootId();
                    this.whole[result] = named.steps().length() == 0;
                }
            }
        }
    }

    // The slot the temp is an address inside, or -1 when it is not one.
    slotOf(long temp) -> long {
        if (temp < 0 || temp >= this.slots.length) {
            return -1;
        }
        return this.slots[temp];
    }

    // The slot the temp is the address of as a whole, or -1 when it names part of one or none.
    wholeSlotOf(long temp) -> long {
        if (temp < 0 || temp >= this.slots.length || !this.whole[temp]) {
            return -1;
        }
        return this.slots[temp];
    }
}

// Storage reference counting may reach: it holds a reference and it is not a weak field. Reaching
// a weak field with a strong operation either leaks an object forever or frees a live one.
checkOwning(EirFunction function, AddressPlaces places, EirBlock block, long address,
            string what, List<string> problems) {
    checkNotWeak(function, places, block, address, what, problems);
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let stored = place.typeOfPlace(function, named);
    if (stored != null && primitives.referenceOf(stored) == null) {
        report(function, block, problems, "{what} reaches "
            + "{place.describe(function, address)}, which holds {typenames.display(stored)} and so "
            + "owns no reference");
    }
}

checkNotWeak(EirFunction function, AddressPlaces places, EirBlock block, long address,
             string what, List<string> problems) {
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let field = place.finalFieldOf(function, named);
    if (field != null && field.isWeak()) {
        report(function, block, problems, "{what} reaches the weak field '{field.name()}', which "
            + "watches an object without owning it; weak storage is written with weak.store and "
            + "read with weak.load");
    }
}

// Storage a weak operation may reach: a field declared weak.
checkWeak(EirFunction function, AddressPlaces places, EirBlock block, long address,
          string what, List<string> problems) {
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let field = place.finalFieldOf(function, named);
    if (field == null) {
        report(function, block, problems, "{what} reaches "
            + "{place.describe(function, address)}, which is not a field, so nothing there was "
            + "declared weak");
        return;
    }
    if (!field.isWeak()) {
        report(function, block, problems, "{what} reaches the field '{field.name()}', which owns "
            + "a strong reference; only a field declared weak has a side-table entry to read");
    }
}

reportRepeatedRelease(EirFunction function, EirBlock block, Place named, List<Place> released,
                      List<string> problems) {
    for (long i = 0; i < released.length(); i++) {
        if (place.relate(released.get(i), named) == PlaceRelation.Same) {
            report(function, block, problems, "the +1 held by "
                + "{describePlace(function, named)} is released twice with nothing written into "
                + "it in between, so the second release gives up a reference this function no "
                + "longer holds");
            return;
        }
    }
}

// A write into a location gives it a reference again, so an earlier release of it no longer
// applies. Only the releases the write provably cannot have reached are kept, which keeps a place
// the write may alias out of the double-release report.
releasesSurvivingWrite(AddressPlaces places, long address, List<Place> released) -> List<Place> {
    let kept = new List<Place>();
    let written = places.placeOf(address);
    if (written == null) {
        return kept;
    }
    for (long i = 0; i < released.length(); i++) {
        if (place.relate(released.get(i), written) == PlaceRelation.Different) {
            kept.push(released.get(i));
        }
    }
    return kept;
}

releasesOutsideSlot(List<Place> released, long slot) -> List<Place> {
    let kept = new List<Place>();
    for (long i = 0; i < released.length(); i++) {
        let named = released.get(i);
        if (named.root() != PlaceRoot.Slot || named.rootId() != slot) {
            kept.push(named);
        }
    }
    return kept;
}

describePlace(EirFunction function, Place named) -> string {
    if (named.steps().length() > 0) {
        let field = place.finalFieldOf(function, named);
        if (field != null) {
            return "the field '{field.name()}'";
        }
    }
    return switch (named.root()) {
        Slot -> "${named.rootId()} '{function.slots().get(named.rootId()).name()}'",
        default -> "the storage %{named.rootId()} names",
    };
}

report(EirFunction function, EirBlock block, List<string> problems, string problem) {
    problems.push("{function.symbol()}: {block.label()}: {problem}");
}
