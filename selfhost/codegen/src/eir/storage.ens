// The storage half of ownership verification, the companion to the value half in eir.ownership.
// Every instruction that moves the +1 a location holds names it through an address, which this
// pass normalizes into a place.
import EirFunction from eir.model;
import EirAbsentOptional from eir.model;
import EirBlock from eir.model;
import EirBranch from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirClosureCall from eir.model;
import EirConstNull from eir.model;
import EirForeignCall from eir.model;
import EirFieldAddress from eir.model;
import EirInstruction from eir.model;
import EirLoadPtr from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirPropagate from eir.model;
import EirReturn from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirStorePtr from eir.model;
import EirStoreSlot from eir.model;
import EirSlotAddress from eir.model;
import EirTakeSlot from eir.model;
import EirTryCall from eir.model;
import EirTryClosureCall from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import EirZeroStruct from eir.model;
import AddressPlaces from eir.place;
import Place from eir.place;
import PlaceRelation from eir.place;
import PlaceRoot from eir.place;
import PlaceStep from eir.place;
import PlaceStepKind from eir.place;
import eir.dump;
import eir.place;
import eir.walk;
import @ens.sema.model.typenames;
import Type from @ens.sema.model.types;
import support.primitives;
import ReferenceWalker from support.references;
import support.references;
import List from @std.collections.list;

// Verifies one function's storage-level ownership; the returned list is empty when it holds.
export verifyStorage(EirFunction function) -> string[] {
    let problems = new List<string>();
    let places = place.addressPlaces(function);
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        checkBlock(function, places, blocks.get(b), problems);
    }
    checkWrittenBeforeRead(function, places, problems);
    checkHeldReferencesReleased(function, places, problems);
    return problems.toArray();
}

checkBlock(EirFunction function, AddressPlaces places, EirBlock block, List<string> problems) {
    let released = new List<Place>();
    let instructions = block.instructions();
    for (long i = 0; i < instructions.length(); i++) {
        let instruction = instructions.get(i);
        switch (instruction) {
            is EirRetainPtr retain -> {
                checkOwning(function, places, block, retain.address, "retain_ptr", problems);
            },
            is EirReleasePtr release -> {
                checkOwning(function, places, block, release.address, "release_ptr", problems);
                let named = places.placeOf(release.address);
                if (named != null) {
                    reportRepeatedRelease(function, block, named, released, problems);
                    released.push(named);
                }
            },
            is EirStorePtr store -> {
                checkNotWeak(function, places, block, store.address, "store_ptr", problems);
                released = releasesSurvivingWrite(places, store.address, released);
            },
            // A write into a whole slot replaces everything inside it, references included.
            is EirStoreSlot store -> {
                released = releasesOutsideSlot(released, store.slot);
            },
            // A take writes null into the slot, so earlier releases of it no longer apply.
            is EirTakeSlot taken -> {
                released = releasesOutsideSlot(released, taken.slot);
            },
            is EirWeakStore store -> {
                checkWeak(function, places, block, store.address, "weak.store", problems);
            },
            is EirWeakLoad load -> {
                checkWeak(function, places, block, load.address, "weak.load", problems);
            },
            is EirWeakRelease release -> {
                checkWeak(function, places, block, release.address, "weak.release", problems);
            },
            // A callee may write any storage it was handed, so nothing released before a call is
            // still known to be empty afterwards. A foreign callee writes its out arguments the
            // same way.
            is EirCall ignored -> {
                released = new List<Place>();
            },
            is EirClosureCall ignored -> {
                released = new List<Place>();
            },
            is EirForeignCall ignored -> {
                released = new List<Place>();
            },
            default -> { },
        }
    }
}

// A slot that does not start zeroed holds whatever the stack held until something writes it, so
// reading it, a release included, is sound only once every path from the entry has written it.
// A forward dataflow computes the slots definitely written at each block entry, to a fixpoint.
checkWrittenBeforeRead(EirFunction function, AddressPlaces places, List<string> problems) {
    let slots = function.slots();
    long slotCount = slots.length();
    bool[] zeroed = new bool[slotCount + 1];
    bool watching = false;
    for (long s = 0; s < slotCount; s++) {
        zeroed[s] = slots.get(s).startsZeroed();
        watching = watching || !zeroed[s];
    }
    let blocks = function.blocks();
    long blockCount = blocks.length();
    if (!watching || blockCount == 0) {
        return;
    }
    let addresses = new SlotAddresses(function, places);
    bool[][] writtenInBlock = new bool[blockCount][slotCount + 1];
    for (long b = 0; b < blockCount; b++) {
        applyBlock(function, addresses, blocks.get(b), writtenInBlock[b], null);
    }
    bool[][] writtenAtEntry = new bool[blockCount][slotCount + 1];
    bool[] reached = new bool[blockCount + 1];
    writtenAtEntry[0] = zeroed;
    reached[0] = true;
    bool changed = true;
    while (changed) {
        changed = false;
        for (long b = 0; b < blockCount; b++) {
            if (!reached[b]) {
                continue;
            }
            bool[] entry = writtenAtEntry[b];
            bool[] inside = writtenInBlock[b];
            for (let successor in walk.successorsOf(blocks.get(b))) {
                if (successor < 0 || successor >= blockCount) {
                    continue;
                }
                bool[] known = writtenAtEntry[successor];
                bool first = !reached[successor];
                reached[successor] = true;
                for (long s = 0; s < slotCount; s++) {
                    bool written = entry[s] || inside[s];
                    if (first) {
                        known[s] = written;
                    } else if (known[s] && !written) {
                        known[s] = false;
                        changed = true;
                    }
                }
                changed = changed || first;
            }
        }
    }
    for (long b = 0; b < blockCount; b++) {
        if (reached[b]) {
            applyBlock(function, addresses, blocks.get(b), copied(writtenAtEntry[b]), problems);
        }
    }
}

// Marks the slots one block writes, in order, and reports each read of a slot not written yet
// when problems is given. A call reads what it is handed, except a foreign call's out argument,
// which the C function writes.
applyBlock(EirFunction function, SlotAddresses addresses, EirBlock block, bool[] written,
           List<string>? problems) {
    let instructions = block.instructions();
    for (long i = 0; i < instructions.length(); i++) {
        let instruction = instructions.get(i);
        switch (instruction) {
            is EirStoreSlot store -> {
                markWritten(written, store.slot);
            },
            is EirLoadSlot load -> {
                checkRead(function, block, instruction, load.slot, written, problems);
            },
            is EirTakeSlot taken -> {
                checkRead(function, block, instruction, taken.slot, written, problems);
                markWritten(written, taken.slot);
            },
            is EirStorePtr store -> {
                markWritten(written, addresses.wholeSlotOf(store.address));
            },
            is EirSlotAddress ignored -> { },
            is EirFieldAddress ignored -> { },
            is EirOptionalPayloadAddress ignored -> { },
            is EirForeignCall call -> {
                for (long a = 0; a < call.arguments.length; a++) {
                    long argument = call.arguments[a];
                    if (a < call.outFlags.length && call.outFlags[a]) {
                        markWritten(written, addresses.wholeSlotOf(argument));
                    } else {
                        checkRead(function, block, instruction, addresses.slotOf(argument),
                            written, problems);
                    }
                }
            },
            default -> {
                for (let used in walk.usesOf(instruction)) {
                    checkRead(function, block, instruction, addresses.slotOf(used), written,
                        problems);
                }
            },
        }
    }
    let terminator = block.terminator();
    if (terminator == null || problems == null) {
        return;
    }
    for (let used in walk.terminatorUsesOf(terminator)) {
        long slot = addresses.slotOf(used);
        if (slot >= 0 && slot < written.length && !written[slot]) {
            reportUnwritten(function, block, dump.terminatorText(function, terminator), slot,
                problems);
        }
    }
}

checkRead(EirFunction function, EirBlock block, EirInstruction instruction, long slot,
          bool[] written, List<string>? problems) {
    if (problems == null || slot < 0 || slot >= written.length || written[slot]) {
        return;
    }
    reportUnwritten(function, block, dump.instructionText(instruction), slot, problems);
}

reportUnwritten(EirFunction function, EirBlock block, string reader, long slot,
                List<string> problems) {
    report(function, block, problems, "'{reader}' reads ${slot} "
        + "'{function.slots().get(slot).name()}' on a path that never wrote it; the slot does "
        + "not start zeroed, so the read finds whatever the stack held there");
}

markWritten(bool[] written, long slot) {
    if (slot >= 0 && slot < written.length) {
        written[slot] = true;
    }
}

copied(bool[] flags) -> bool[] {
    bool[] copy = new bool[flags.length];
    for (long i = 0; i < flags.length; i++) {
        copy[i] = flags[i];
    }
    return copy;
}

// Every reference an owning slot holds is the function's to give up: each path that returns or
// propagates has released or taken it first, and no store writes over it while it is still held.
// Two forward dataflows run to a fixpoint. One computes which loads out of an owning slot still
// read what their place holds, the other which references some path into each block may still
// hold.
checkHeldReferencesReleased(EirFunction function, AddressPlaces places, List<string> problems) {
    let blocks = function.blocks();
    let owned = new SlotReferences(function, places);
    if (owned.count() == 0 || blocks.length() == 0) {
        return;
    }
    owned.solve(blocks);
    for (long b = 0; b < blocks.length(); b++) {
        owned.reportBlock(function, b, blocks.get(b), problems);
    }
}

// What one point of a block may still hold, and which tracked loads are still fresh there.
final class HeldState {
    long[] held;
    long[] fresh;

    constructor(this.held, this.fresh);
}

// The references the owning slots of one function can hold, numbered slot by slot in the order
// the reference walk visits them, so the references inside any one place are a contiguous run.
// The loads out of those places that a presence test or a store reads are tracked as well, each
// fresh while nothing may have written its place since it ran.
final class SlotReferences {
    List<Place> places;
    EirInstruction?[] definitions;
    long[] slotStart;
    long[] slotEnd;
    long[] addressStart;
    long[] addressEnd;
    Place?[] addressPlaces;
    Place?[] slotPlaces;
    long[] loadIndex;
    List<Place> loadPlaces;
    List<long> loadStart;
    List<long> loadEnd;
    List<List<long>> slotLoads;
    bool[] reached;
    long[][] heldAtEntry;
    long[][] freshAtEntry;

    constructor(EirFunction function, AddressPlaces addresses) {
        this.places = new List<Place>();
        this.loadPlaces = new List<Place>();
        this.loadStart = new List<long>();
        this.loadEnd = new List<long>();
        this.reached = new bool[0];
        this.heldAtEntry = new long[0][0];
        this.freshAtEntry = new long[0][0];
        let slots = function.slots();
        this.slotStart = new long[slots.length()];
        this.slotEnd = new long[slots.length()];
        this.slotPlaces = new Place?[slots.length()];
        this.slotLoads = new List<List<long>>();
        for (long s = 0; s < slots.length(); s++) {
            this.slotStart[s] = this.places.length();
            this.slotLoads.push(new List<long>());
            let slot = slots.get(s);
            if (!slot.borrows() && primitives.hasArcContent(slot.type())) {
                this.slotPlaces[s] = new Place(PlaceRoot.Slot, s, new List<PlaceStep>());
                references.walk<List<PlaceStep>>(new ReferencePlaces(this.places, s),
                    new List<PlaceStep>(), slot.type());
            }
            this.slotEnd[s] = this.places.length();
        }
        long tempCount = this.places.length() == 0 ? 0 : function.tempTypes().length();
        this.definitions = new EirInstruction?[tempCount];
        this.addressStart = new long[tempCount];
        this.addressEnd = new long[tempCount];
        this.addressPlaces = new Place?[tempCount];
        this.loadIndex = new long[tempCount];
        if (tempCount == 0) {
            return;
        }
        for (let block in function.blocks()) {
            for (let instruction in block.instructions()) {
                long result = walk.resultOf(instruction);
                if (result < 0 || result >= tempCount) {
                    continue;
                }
                this.definitions[result] = instruction;
                if (walk.producesAddress(instruction)) {
                    this.recordRange(result, addresses.placeOf(result));
                }
            }
        }
        this.trackLoads(function, tempCount);
    }

    count() -> long {
        return this.places.length();
    }

    placeOf(long reference) -> Place {
        return this.places.get(reference);
    }

    // Solves both dataflows: first which tracked loads are fresh as each block starts, those fresh
    // on every path into it, then what some path into each block may still hold as it starts.
    solve(List<EirBlock> blocks) {
        long blockCount = blocks.length();
        this.freshAtEntry = new long[blockCount][wordsFor(this.loadPlaces.length())];
        this.heldAtEntry = new long[blockCount][wordsFor(this.count())];
        if (!this.loadPlaces.isEmpty()) {
            this.solveFreshness(blocks);
        }
        this.solveHeld(blocks);
    }

    solveFreshness(List<EirBlock> blocks) {
        long blockCount = blocks.length();
        bool[] seen = new bool[blockCount];
        bool[] queued = new bool[blockCount];
        let pending = new List<long>();
        seen[0] = true;
        queued[0] = true;
        pending.push(0);
        while (!pending.isEmpty()) {
            long b = pending.pop();
            queued[b] = false;
            let state = this.run(blocks.get(b), this.heldAtEntry[b], this.freshAtEntry[b], null,
                null);
            for (let successor in walk.successorsOf(blocks.get(b))) {
                if (successor < 0 || successor >= blockCount) {
                    continue;
                }
                bool changed = !seen[successor];
                if (changed) {
                    seen[successor] = true;
                    this.freshAtEntry[successor] = copiedWords(state.fresh);
                } else {
                    changed = meetInto(this.freshAtEntry[successor], state.fresh);
                }
                if (changed && !queued[successor]) {
                    queued[successor] = true;
                    pending.push(successor);
                }
            }
        }
    }

    solveHeld(List<EirBlock> blocks) {
        long blockCount = blocks.length();
        this.reached = new bool[blockCount];
        bool[] queued = new bool[blockCount];
        let pending = new List<long>();
        this.reached[0] = true;
        queued[0] = true;
        pending.push(0);
        while (!pending.isEmpty()) {
            long b = pending.pop();
            queued[b] = false;
            let block = blocks.get(b);
            let state = this.run(block, this.heldAtEntry[b], this.freshAtEntry[b], null, null);
            long[] successors = walk.successorsOf(block);
            for (long edge = 0; edge < successors.length; edge++) {
                long successor = successors[edge];
                if (successor < 0 || successor >= blockCount) {
                    continue;
                }
                bool grew = joinInto(this.heldAtEntry[successor],
                    this.alongEdge(block, edge, state)) || !this.reached[successor];
                this.reached[successor] = true;
                if (grew && !queued[successor]) {
                    queued[successor] = true;
                    pending.push(successor);
                }
            }
        }
    }

    // Runs one reached block from its entry states, reporting each store over a reference that may
    // still be held and each reference still held where the block leaves the function.
    reportBlock(EirFunction function, long index, EirBlock block, List<string> problems) {
        if (!this.reached[index]) {
            return;
        }
        let state = this.run(block, this.heldAtEntry[index], this.freshAtEntry[index], function,
            problems);
        let terminator = block.terminator();
        if (terminator == null || !(terminator is EirReturn || terminator is EirPropagate)) {
            return;
        }
        for (long reference = 0; reference < this.count(); reference++) {
            if (contains(state.held, reference)) {
                string leaked = place.placeText(function, this.placeOf(reference));
                report(function, block, problems, "'{dump.terminatorText(function, terminator)}' "
                    + "leaves the function while '{leaked}' still holds a reference, so the "
                    + "reference leaks");
            }
        }
    }

    // Both states once a block has run, from copies of the states it starts with.
    run(EirBlock block, long[] heldAtEntry, long[] freshAtEntry, EirFunction? function,
        List<string>? problems) -> HeldState {
        let state = new HeldState(copiedWords(heldAtEntry), copiedWords(freshAtEntry));
        for (let instruction in block.instructions()) {
            long overwritten = this.apply(instruction, state);
            if (overwritten >= 0 && function != null && problems != null) {
                string written = place.placeText(function, this.placeOf(overwritten));
                report(function, block, problems, "'{dump.instructionText(instruction)}' writes "
                    + "over '{written}' while it may still hold a reference, so that reference "
                    + "leaks");
            }
        }
        let terminator = block.terminator();
        if (terminator is EirTryCall) {
            this.call(state, terminator.callee, terminator.receiver, terminator.arguments);
        } else if (terminator is EirTryClosureCall) {
            this.mayWriteAll(state, terminator.arguments);
        }
        return state;
    }

    // Applies one instruction; returns the reference a store writes over while it may still be
    // held, or -1.
    apply(EirInstruction instruction, HeldState state) -> long {
        long overwritten = -1;
        switch (instruction) {
            is EirStoreSlot store -> {
                overwritten = this.store(state, this.slotStart[store.slot],
                    this.slotEnd[store.slot], this.slotPlaces[store.slot], store.value);
            },
            is EirStorePtr store -> {
                overwritten = this.store(state, this.addressStart[store.address],
                    this.addressEnd[store.address], this.addressPlaces[store.address],
                    store.value);
            },
            is EirTakeSlot taken -> {
                this.empty(state, this.slotStart[taken.slot], this.slotEnd[taken.slot]);
            },
            is EirReleasePtr release -> {
                this.empty(state, this.addressStart[release.address],
                    this.addressEnd[release.address]);
            },
            is EirCall call -> {
                this.call(state, call.callee, call.receiver, call.arguments);
            },
            is EirClosureCall call -> {
                this.mayWriteAll(state, call.arguments);
            },
            is EirForeignCall call -> {
                this.mayWriteAll(state, call.arguments);
            },
            default -> { },
        }
        long load = this.loadOf(walk.resultOf(instruction));
        if (load >= 0) {
            setRange(state.fresh, load, load + 1, true);
        }
        return overwritten;
    }

    // The absent side of a branch on whether a fresh load's optional is present holds nothing in
    // the place it was loaded from.
    alongEdge(EirBlock block, long edge, HeldState state) -> long[] {
        let terminator = block.terminator();
        if (!(terminator is EirBranch) || edge != 1) {
            return state.held;
        }
        let presence = this.definitionOf(terminator.condition);
        if (!(presence is EirOptionalPresence)) {
            return state.held;
        }
        long load = this.loadOf(presence.value);
        if (load < 0 || !contains(state.fresh, load)) {
            return state.held;
        }
        long[] refined = copiedWords(state.held);
        setRange(refined, this.loadStart.get(load), this.loadEnd.get(load), false);
        return refined;
    }

    // A store holds what it writes, except a zero, a null or an absent optional, which hold
    // nothing. Writing back the value a fresh load read out of the same place changes nothing.
    store(HeldState state, long start, long end, Place? target, long value) -> long {
        long load = this.loadOf(value);
        if (load >= 0 && contains(state.fresh, load) && target != null
                && place.relate(this.loadPlaces.get(load), target) == PlaceRelation.Same) {
            return -1;
        }
        long overwritten = -1;
        for (long r = start; r < end && overwritten < 0; r++) {
            if (contains(state.held, r)) {
                overwritten = r;
            }
        }
        let written = this.definitionOf(value);
        bool empty = written is EirZeroStruct || written is EirConstNull
            || written is EirAbsentOptional;
        setRange(state.held, start, end, !empty);
        this.invalidate(state, start, end);
        return overwritten;
    }

    empty(HeldState state, long start, long end) {
        setRange(state.held, start, end, false);
        this.invalidate(state, start, end);
    }

    // A callee may write through the receiver it is handed and through any address it is not
    // handed by address. A by-address parameter is one the callee only reads.
    call(HeldState state, EirCallee callee, long receiver, long[] arguments) {
        this.mayWrite(state, receiver);
        for (long i = 0; i < arguments.length; i++) {
            if (!callee.passesByAddress(i)) {
                this.mayWrite(state, arguments[i]);
            }
        }
    }

    // A callee handed an address may write anything inside the place it names.
    mayWrite(HeldState state, long operand) {
        if (operand >= 0 && operand < this.addressStart.length) {
            long start = this.addressStart[operand];
            long end = this.addressEnd[operand];
            setRange(state.held, start, end, true);
            this.invalidate(state, start, end);
        }
    }

    mayWriteAll(HeldState state, long[] operands) {
        for (let operand in operands) {
            this.mayWrite(state, operand);
        }
    }

    // A write anywhere inside a load's place leaves the load no longer fresh.
    invalidate(HeldState state, long start, long end) {
        if (start >= end) {
            return;
        }
        for (let load in this.slotLoads.get(this.places.get(start).rootId())) {
            if (start < this.loadEnd.get(load) && this.loadStart.get(load) < end) {
                setRange(state.fresh, load, load + 1, false);
            }
        }
    }

    definitionOf(long temp) -> EirInstruction? {
        if (temp < 0 || temp >= this.definitions.length) {
            return null;
        }
        return this.definitions[temp];
    }

    // The tracked load a temp is the result of, or -1.
    loadOf(long temp) -> long {
        if (temp < 0 || temp >= this.loadIndex.length) {
            return -1;
        }
        return this.loadIndex[temp];
    }

    // Records the run of references inside the place an address temp names, which stays empty
    // when the place is not inside an owning slot.
    recordRange(long address, Place? named) {
        if (named == null || named.root() != PlaceRoot.Slot) {
            return;
        }
        this.addressPlaces[address] = named;
        long slot = named.rootId();
        for (long r = this.slotStart[slot]; r < this.slotEnd[slot]; r++) {
            if (!startsWith(this.places.get(r).steps(), named.steps())) {
                continue;
            }
            if (this.addressEnd[address] == 0) {
                this.addressStart[address] = r;
            }
            this.addressEnd[address] = r + 1;
        }
    }

    // Numbers the loads out of a place holding references whose value a presence test or a store
    // reads.
    trackLoads(EirFunction function, long tempCount) {
        bool[] read = new bool[tempCount];
        for (let block in function.blocks()) {
            for (let instruction in block.instructions()) {
                long value = switch (instruction) {
                    is EirOptionalPresence presence -> presence.value,
                    is EirStoreSlot store -> store.value,
                    is EirStorePtr store -> store.value,
                    default -> -1,
                };
                if (value >= 0 && value < tempCount) {
                    read[value] = true;
                }
            }
        }
        for (long temp = 0; temp < tempCount; temp++) {
            this.loadIndex[temp] = -1;
            let loaded = this.definitions[temp];
            if (!read[temp] || loaded == null) {
                continue;
            }
            if (loaded is EirLoadSlot) {
                this.trackLoad(temp, this.slotStart[loaded.slot], this.slotEnd[loaded.slot],
                    this.slotPlaces[loaded.slot]);
            } else if (loaded is EirLoadPtr) {
                this.trackLoad(temp, this.addressStart[loaded.address],
                    this.addressEnd[loaded.address], this.addressPlaces[loaded.address]);
            }
        }
    }

    trackLoad(long temp, long start, long end, Place? source) {
        if (start >= end || source == null) {
            return;
        }
        this.slotLoads.get(source.rootId()).push(this.loadPlaces.length());
        this.loadIndex[temp] = this.loadPlaces.length();
        this.loadPlaces.push(source);
        this.loadStart.push(start);
        this.loadEnd.push(end);
    }
}

// Collects the place of each reference a slot's value holds.
final class ReferencePlaces implements ReferenceWalker<List<PlaceStep>> {
    List<Place> found;
    long slot;

    constructor(this.found, this.slot);

    override reference(List<PlaceStep> steps) {
        this.found.push(new Place(PlaceRoot.Slot, this.slot, steps));
    }

    override field(List<PlaceStep> record, Type recordType, long index, Type fieldType)
            -> List<PlaceStep> {
        return extended(record, new PlaceStep(PlaceStepKind.Field, index));
    }

    override payload(List<PlaceStep> pair, Type optionalType, Type payloadType)
            -> List<PlaceStep> {
        return extended(pair, new PlaceStep(PlaceStepKind.Payload, 0));
    }

    override endPayload() { }
}

extended(List<PlaceStep> steps, PlaceStep step) -> List<PlaceStep> {
    let longer = new List<PlaceStep>();
    for (let existing in steps) {
        longer.push(existing);
    }
    longer.push(step);
    return longer;
}

// Whether a reference's steps begin with a place's, which puts the reference inside that place.
startsWith(List<PlaceStep> steps, List<PlaceStep> prefix) -> bool {
    if (prefix.length() > steps.length()) {
        return false;
    }
    for (long i = 0; i < prefix.length(); i++) {
        let step = steps.get(i);
        let expected = prefix.get(i);
        if (step.kind() != expected.kind()
                || (step.isField() && step.value() != expected.value())) {
            return false;
        }
    }
    return true;
}

wordsFor(long bits) -> long {
    return (bits + 63) / 64;
}

setRange(long[] bits, long start, long end, bool value) {
    for (long i = start; i < end; i++) {
        if (value) {
            bits[i / 64] = bits[i / 64] | (1L << (i % 64));
        } else {
            bits[i / 64] = bits[i / 64] & ~(1L << (i % 64));
        }
    }
}

contains(long[] bits, long index) -> bool {
    return (bits[index / 64] & (1L << (index % 64))) != 0;
}

copiedWords(long[] words) -> long[] {
    long[] copy = new long[words.length];
    for (long i = 0; i < words.length; i++) {
        copy[i] = words[i];
    }
    return copy;
}

// Adds the bits of `added` to `into`; true when that changed it.
joinInto(long[] into, long[] added) -> bool {
    bool grew = false;
    for (long i = 0; i < into.length; i++) {
        long joined = into[i] | added[i];
        if (joined != into[i]) {
            into[i] = joined;
            grew = true;
        }
    }
    return grew;
}

// Keeps only the bits of `into` that `other` has too; true when that changed it.
meetInto(long[] into, long[] other) -> bool {
    bool shrank = false;
    for (long i = 0; i < into.length; i++) {
        long met = into[i] & other[i];
        if (met != into[i]) {
            into[i] = met;
            shrank = true;
        }
    }
    return shrank;
}

// The slot each address temp of one function reaches into, and whether it names that whole slot.
final class SlotAddresses {
    long[] slots;
    bool[] whole;

    constructor(EirFunction function, AddressPlaces places) {
        long count = function.tempTypes().length();
        this.slots = new long[count + 1];
        this.whole = new bool[count + 1];
        for (long t = 0; t < this.slots.length; t++) {
            this.slots[t] = -1;
        }
        let blocks = function.blocks();
        for (long b = 0; b < blocks.length(); b++) {
            let instructions = blocks.get(b).instructions();
            for (long i = 0; i < instructions.length(); i++) {
                let instruction = instructions.get(i);
                long result = walk.resultOf(instruction);
                if (!walk.producesAddress(instruction) || result < 0 || result >= count) {
                    continue;
                }
                let named = places.placeOf(result);
                if (named != null && named.root() == PlaceRoot.Slot) {
                    this.slots[result] = named.rootId();
                    this.whole[result] = named.steps().length() == 0;
                }
            }
        }
    }

    // The slot the temp is an address inside, or -1 when it is not one.
    slotOf(long temp) -> long {
        if (temp < 0 || temp >= this.slots.length) {
            return -1;
        }
        return this.slots[temp];
    }

    // The slot the temp is the address of as a whole, or -1 when it names part of one or none.
    wholeSlotOf(long temp) -> long {
        if (temp < 0 || temp >= this.slots.length || !this.whole[temp]) {
            return -1;
        }
        return this.slots[temp];
    }
}

// Storage reference counting may reach: it holds a reference and it is not a weak field. Reaching
// a weak field with a strong operation either leaks an object forever or frees a live one.
checkOwning(EirFunction function, AddressPlaces places, EirBlock block, long address,
            string what, List<string> problems) {
    checkNotWeak(function, places, block, address, what, problems);
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let stored = place.typeOfPlace(function, named);
    if (stored != null && primitives.referenceOf(stored) == null) {
        report(function, block, problems, "{what} reaches "
            + "{place.describe(function, address)}, which holds {typenames.display(stored)} and so "
            + "owns no reference");
    }
}

checkNotWeak(EirFunction function, AddressPlaces places, EirBlock block, long address,
             string what, List<string> problems) {
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let field = place.finalFieldOf(function, named);
    if (field != null && field.isWeak()) {
        report(function, block, problems, "{what} reaches the weak field '{field.name()}', which "
            + "watches an object without owning it; weak storage is written with weak.store and "
            + "read with weak.load");
    }
}

// Storage a weak operation may reach: a field declared weak.
checkWeak(EirFunction function, AddressPlaces places, EirBlock block, long address,
          string what, List<string> problems) {
    let named = places.placeOf(address);
    if (named == null) {
        return;
    }
    let field = place.finalFieldOf(function, named);
    if (field == null) {
        report(function, block, problems, "{what} reaches "
            + "{place.describe(function, address)}, which is not a field, so nothing there was "
            + "declared weak");
        return;
    }
    if (!field.isWeak()) {
        report(function, block, problems, "{what} reaches the field '{field.name()}', which owns "
            + "a strong reference; only a field declared weak has a side-table entry to read");
    }
}

reportRepeatedRelease(EirFunction function, EirBlock block, Place named, List<Place> released,
                      List<string> problems) {
    for (long i = 0; i < released.length(); i++) {
        if (place.relate(released.get(i), named) == PlaceRelation.Same) {
            report(function, block, problems, "the +1 held by "
                + "{describePlace(function, named)} is released twice with nothing written into "
                + "it in between, so the second release gives up a reference this function no "
                + "longer holds");
            return;
        }
    }
}

// A write into a location gives it a reference again, so an earlier release of it no longer
// applies. Only the releases the write provably cannot have reached are kept, which keeps a place
// the write may alias out of the double-release report.
releasesSurvivingWrite(AddressPlaces places, long address, List<Place> released) -> List<Place> {
    let kept = new List<Place>();
    let written = places.placeOf(address);
    if (written == null) {
        return kept;
    }
    for (long i = 0; i < released.length(); i++) {
        if (place.relate(released.get(i), written) == PlaceRelation.Different) {
            kept.push(released.get(i));
        }
    }
    return kept;
}

releasesOutsideSlot(List<Place> released, long slot) -> List<Place> {
    let kept = new List<Place>();
    for (long i = 0; i < released.length(); i++) {
        let named = released.get(i);
        if (named.root() != PlaceRoot.Slot || named.rootId() != slot) {
            kept.push(named);
        }
    }
    return kept;
}

describePlace(EirFunction function, Place named) -> string {
    if (named.steps().length() > 0) {
        let field = place.finalFieldOf(function, named);
        if (field != null) {
            return "the field '{field.name()}'";
        }
    }
    return switch (named.root()) {
        Slot -> "${named.rootId()} '{function.slots().get(named.rootId()).name()}'",
        default -> "the storage %{named.rootId()} names",
    };
}

report(EirFunction function, EirBlock block, List<string> problems, string problem) {
    problems.push("{function.symbol()}: {block.label()}: {problem}");
}
