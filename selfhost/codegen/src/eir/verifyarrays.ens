// The array instructions and the checks that guard an access: element addressing, the bounds and
// range checks, allocation, and the length read.
import EirBlock from eir.model;
import EirElementAddress from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import EirArrayNew from eir.model;
import EirArrayLength from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import ArrayType from @ens.sema.model.types;
import @ens.sema.model.types;
import support.primitives;

public checkElementAddress(VerificationContext verification, EirBlock block,
                           EirElementAddress address) {
    verifyoperands.checkResultType(verification, block, address.result, address.type);
    verifyoperands.checkOperand(verification, block, address.array);
    verifyoperands.checkOperand(verification, block, address.index);
    verifyoperands.checkArrayOperand(verification, block, address.array, "element_addr");
    verifyoperands.checkIntegerOperand(verification, block, address.index, "an element index");
    if (verification.validTemp(address.array)) {
        let arrayType = primitives.arrayOf(verification.typeOf(address.array));
        if (arrayType != null && arrayType.element() != address.type) {
            verification.report("{block.label()}: element_addr %{address.result} is typed "
                + "{types.display(address.type)} but the array holds "
                + "{types.display(arrayType.element())}");
        }
    }
}

public checkBoundsCheck(VerificationContext verification, EirBlock block, EirBoundsCheck check) {
    verifyoperands.checkOperand(verification, block, check.array);
    verifyoperands.checkOperand(verification, block, check.index);
    verifyoperands.checkArrayOperand(verification, block, check.array, "bounds_check");
    verifyoperands.checkIntegerOperand(verification, block, check.index, "an element index");
}

public checkRangeCheck(VerificationContext verification, EirBlock block, EirRangeCheck check) {
    verifyoperands.checkOperand(verification, block, check.start);
    verifyoperands.checkOperand(verification, block, check.end);
    verifyoperands.checkOperand(verification, block, check.length);
    verifyoperands.checkIntegerOperand(verification, block, check.start, "a range start");
    verifyoperands.checkIntegerOperand(verification, block, check.end, "a range end");
    verifyoperands.checkIntegerOperand(verification, block, check.length, "a range length");
}

public checkArrayNew(VerificationContext verification, EirBlock block, EirArrayNew allocation) {
    verifyoperands.checkResultType(verification, block, allocation.result, allocation.type);
    verifyoperands.checkOperand(verification, block, allocation.size);
    verifyoperands.checkIntegerOperand(verification, block, allocation.size, "an array size");
    if (!primitives.isArrayType(allocation.type)) {
        verification.report("{block.label()}: array.new %{allocation.result} produces "
            + "{types.display(allocation.type)}, which is not an array");
    }
}

public checkArrayLength(VerificationContext verification, EirBlock block,
                        EirArrayLength length) {
    verifyoperands.checkResultType(verification, block, length.result, length.type);
    verifyoperands.checkOperand(verification, block, length.array);
    verifyoperands.checkArrayOperand(verification, block, length.array, "array.len");
    verifyoperands.checkLongResult(verification, block, length.result, length.type, "array.len");
}
