// The inline frame table a function carries once something was inlined into it: each frame was
// called from an earlier frame or from the function itself, and every instruction names a frame
// of the table or none.
import VerificationContext from eir.verifycontext;
import eir.walk;

public checkInlineFrames(VerificationContext verification) {
    let function = verification.function();
    let frames = function.inlineFrames();
    for (long f = 0; f < frames.length(); f++) {
        long parent = frames.get(f).parent();
        if (parent < -1 || parent >= f) {
            verification.report("inline frame #{f} is called from frame #{parent}, which is not "
                + "an earlier frame of the table");
        }
    }
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let block = blocks.get(b);
        for (let instruction in block.instructions()) {
            checkFrame(verification, block.label(), walk.inlinedAtOf(instruction),
                frames.length());
        }
        let terminator = block.terminator();
        if (terminator != null) {
            checkFrame(verification, block.label(), walk.terminatorInlinedAtOf(terminator),
                frames.length());
        }
    }
}

checkFrame(VerificationContext verification, string label, long frame, long frameCount) {
    if (frame < -1 || frame >= frameCount) {
        verification.report("{label}: an instruction was inlined from frame #{frame}, which the "
            + "function's inline frame table does not hold");
    }
}
