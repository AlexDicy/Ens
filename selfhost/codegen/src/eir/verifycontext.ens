// The state one function's structural verification threads through the check modules: the
// function under verification, which of its temps hold addresses, and the problems found so far.
// Collecting the definitions is the first step of a verification and fills the address table
// every later check reads.
import EirFunction from eir.model;
import EirSlot from eir.model;
import Type from @ens.sema.model.types;
import eir.walk;
import List from @std.collections.list;

public final class VerificationContext {
    EirFunction verifiedFunction;
    long temps;
    protected bool[] addressTemp;
    List<string> foundProblems;

    public constructor(EirFunction function) {
        this.verifiedFunction = function;
        this.temps = function.tempTypes().length();
        this.addressTemp = new bool[this.temps];
        this.foundProblems = new List<string>();
    }

    public function() -> EirFunction {
        return this.verifiedFunction;
    }

    public tempCount() -> long {
        return this.temps;
    }

    public slots() -> List<EirSlot> {
        return this.verifiedFunction.slots();
    }

    public validTemp(long temp) -> bool {
        return temp >= 0 && temp < this.temps;
    }

    // The recorded type of a valid temp.
    public typeOf(long temp) -> Type {
        return this.verifiedFunction.tempTypes().get(temp);
    }

    // True when the temp holds an address rather than a value.
    public isAddress(long temp) -> bool {
        return this.validTemp(temp) && this.addressTemp[temp];
    }

    public report(string problem) {
        this.foundProblems.push("{this.verifiedFunction.symbol()}: {problem}");
    }

    public problems() -> string[] {
        return this.foundProblems.toArray();
    }
}

// Records which temps hold addresses and rejects a temp defined twice. The receiver and the
// parameters are defined before the entry block runs, so an instruction defining one of them is
// a second definition.
public collectDefinitions(VerificationContext verification) {
    let function = verification.function();
    long tempCount = verification.tempCount();
    bool[] defined = new bool[tempCount];
    for (long i = 0; i < function.entryTempCount(); i++) {
        defined[i] = true;
    }
    if (function.receiverType() != null && tempCount > 0) {
        verification.addressTemp[0] = true;
    }
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            long result = walk.resultOf(instruction);
            if (result < 0) {
                continue;
            }
            if (result >= tempCount) {
                verification.report("instruction defines %{result} but only {tempCount} "
                    + "temps exist");
                continue;
            }
            if (defined[result]) {
                verification.report("%{result} is assigned more than once");
                continue;
            }
            defined[result] = true;
            verification.addressTemp[result] = walk.producesAddress(instruction);
        }
    }
}
