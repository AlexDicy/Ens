// The structural checks over the three closure instructions: creating a function value, reaching
// a capture inside the object one names, and calling through the code pointer that object leads
// with.
//
// A function type says what a call goes through, not what one closure object holds, which is why
// the capture list travels with the instructions that reach into one. Every check here reads only
// what the instructions carry: the shapes they produce and consume, each capture's position and
// type against that list, and the call against the callee's function type. The three are generated
// together from one lambda, so a disagreement between them is a compiler bug, not a program's.
import EirBlock from eir.model;
import EirClosureNew from eir.model;
import EirClosureCapture from eir.model;
import EirClosureCall from eir.model;
import EirTryClosureCall from eir.model;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import support.primitives;

public checkClosureNew(VerificationContext verification, EirBlock block, EirClosureNew closure) {
    verifyoperands.checkResultType(verification, block, closure.result, closure.type);
    if (primitives.functionOf(closure.type) == null) {
        verification.report("{block.label()}: closure.new %{closure.result} produces "
            + "{types.display(closure.type)}, which is not a function type");
    }
    if (closure.targetSymbol.length == 0) {
        verification.report("{block.label()}: closure.new %{closure.result} names no body to "
            + "store as its code pointer");
    }
    for (let captureType in closure.captureTypes) {
        if (primitives.hasArcContent(captureType) && closure.destructorSymbol.length == 0) {
            verification.report("{block.label()}: closure.new %{closure.result} captures "
                + "{types.display(captureType)}, which holds a reference, but names no "
                + "destructor to store in the object header");
            return;
        }
    }
}

public checkClosureCapture(VerificationContext verification, EirBlock block,
                           EirClosureCapture capture) {
    verifyoperands.checkResultType(verification, block, capture.result, capture.type);
    verifyoperands.checkOperand(verification, block, capture.closure);
    verifyoperands.checkNotAddress(verification, block, capture.closure,
        "the closure of closure_capture");
    if (verification.validTemp(capture.closure)
            && primitives.functionOf(verification.typeOf(capture.closure)) == null) {
        verification.report("{block.label()}: closure_capture %{capture.result} reaches into "
            + "{types.display(verification.typeOf(capture.closure))}, which is not a function "
            + "value");
    }
    if (capture.captureIndex < 0 || capture.captureIndex >= capture.captureTypes.length) {
        verification.report("{block.label()}: closure_capture %{capture.result} names capture "
            + "{capture.captureIndex} of {capture.captureTypes.length}");
        return;
    }
    if (capture.captureTypes[capture.captureIndex] != capture.type) {
        verification.report("{block.label()}: closure_capture %{capture.result} is typed "
            + "{types.display(capture.type)} but capture {capture.captureIndex} holds "
            + "{types.display(capture.captureTypes[capture.captureIndex])}");
    }
}

public checkClosureCall(VerificationContext verification, EirBlock block, EirClosureCall call) {
    verifyoperands.checkOperand(verification, block, call.closure);
    verifyoperands.checkNotAddress(verification, block, call.closure,
        "the callee of closure_call");
    if (call.result >= 0) {
        verifyoperands.checkResultType(verification, block, call.result, call.type);
    }
    for (let argument in call.arguments) {
        verifyoperands.checkOperand(verification, block, argument);
    }
    if (call.arguments.length != call.parameterTypes.length) {
        verification.report("{block.label()}: closure_call passes {call.arguments.length} "
            + "argument(s) against {call.parameterTypes.length} parameter type(s)");
    }
    if (!verification.validTemp(call.closure)) {
        return;
    }
    let functionType = primitives.functionOf(verification.typeOf(call.closure));
    if (functionType == null) {
        verification.report("{block.label()}: closure_call calls "
            + "{types.display(verification.typeOf(call.closure))}, which is not a function "
            + "value");
        return;
    }
    if (functionType.declaresThrows()) {
        verification.report("{block.label()}: closure_call calls "
            + "{types.display(functionType)}, which declares throws and so must end its block "
            + "as try_closure_call");
    }
    Type[] declared = functionType.parameterTypes();
    if (declared.length != call.parameterTypes.length) {
        verification.report("{block.label()}: closure_call passes "
            + "{call.parameterTypes.length} parameter type(s) to "
            + "{types.display(functionType)}");
        return;
    }
    for (long i = 0; i < declared.length; i++) {
        if (declared[i] != call.parameterTypes[i]) {
            verification.report("{block.label()}: closure_call passes parameter {i} as "
                + "{types.display(call.parameterTypes[i])} to {types.display(functionType)}");
        }
    }
    if (call.result >= 0 && functionType.returnType() != call.type) {
        verification.report("{block.label()}: closure_call produces "
            + "{types.display(call.type)} from {types.display(functionType)}");
    }
}

// The terminator form of a closure call, for a target type that declares throws: the same
// argument and result checks as closure_call, plus the error temp try_call also carries.
public checkTryClosureCall(VerificationContext verification, EirBlock block,
                           EirTryClosureCall call) {
    verifyoperands.checkOperand(verification, block, call.closure);
    verifyoperands.checkNotAddress(verification, block, call.closure,
        "the callee of try_closure_call");
    if (call.result >= 0) {
        verifyoperands.checkResultType(verification, block, call.result, call.type);
    }
    for (let argument in call.arguments) {
        verifyoperands.checkOperand(verification, block, argument);
    }
    if (call.arguments.length != call.parameterTypes.length) {
        verification.report("{block.label()}: try_closure_call passes "
            + "{call.arguments.length} argument(s) against {call.parameterTypes.length} "
            + "parameter type(s)");
    }
    if (verification.validTemp(call.closure)) {
        let functionType = primitives.functionOf(verification.typeOf(call.closure));
        if (functionType == null) {
            verification.report("{block.label()}: try_closure_call calls "
                + "{types.display(verification.typeOf(call.closure))}, which is not a function "
                + "value");
        } else {
            if (!functionType.declaresThrows()) {
                verification.report("{block.label()}: try_closure_call calls "
                    + "{types.display(functionType)}, which declares no throws");
            }
            Type[] declared = functionType.parameterTypes();
            if (declared.length != call.parameterTypes.length) {
                verification.report("{block.label()}: try_closure_call passes "
                    + "{call.parameterTypes.length} parameter type(s) to "
                    + "{types.display(functionType)}");
            } else {
                for (long i = 0; i < declared.length; i++) {
                    if (declared[i] != call.parameterTypes[i]) {
                        verification.report("{block.label()}: try_closure_call passes "
                            + "parameter {i} as {types.display(call.parameterTypes[i])} to "
                            + "{types.display(functionType)}");
                    }
                }
                if (call.result >= 0 && functionType.returnType() != call.type) {
                    verification.report("{block.label()}: try_closure_call produces "
                        + "{types.display(call.type)} from {types.display(functionType)}");
                }
            }
        }
    }
    if (!verification.validTemp(call.errorResult)) {
        verification.report("{block.label()}: try_closure_call defines the invalid error temp "
            + "%{call.errorResult}");
        return;
    }
    if (!primitives.isClassLike(verification.typeOf(call.errorResult))) {
        verification.report("{block.label()}: try_closure_call error %{call.errorResult} has "
            + "type {types.display(verification.typeOf(call.errorResult))}, which is not an "
            + "error object's");
    }
}
