// The textual form of EIR, used by the golden lowering tests and for debugging. The dump is
// deterministic: temps as %N, slots as $N, blocks by their label, types by their sema display
// name, and no addresses anywhere.
import EirFunction from eir.model;
import EirBlock from eir.model;
import EirInstruction from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirCall from eir.model;
import EirTerminator from eir.model;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import EirBinaryOp from eir.model;
import EirUnaryOp from eir.model;
import EirCastOp from eir.model;
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import @ens.sema.model.types;
import StringBuilder from @std.text.stringbuilder;

export dumpFunction(EirFunction function) -> string {
    let out = new StringBuilder();
    out.append("func ");
    if (function.internalLinkage()) {
        out.append("internal ");
    }
    out.append("@");
    out.append(function.symbol());
    out.append("(");
    let parameters = function.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            out.append(", ");
        }
        out.append("%{i}: {types.display(parameters[i].type())}");
    }
    out.append(") -> {types.display(function.returnType())} \{\n");
    for (long i = 0; i < function.slots().length(); i++) {
        let slot = function.slots().get(i);
        out.append("  ${i} {slot.name()}: {types.display(slot.type())}\n");
    }
    for (long i = 0; i < function.blocks().length(); i++) {
        appendBlock(out, function, function.blocks().get(i));
    }
    out.append("}\n");
    return out.toString();
}

appendBlock(StringBuilder out, EirFunction function, EirBlock block) {
    out.append(block.label());
    out.append(":\n");
    for (long i = 0; i < block.instructions().length(); i++) {
        out.append("  ");
        out.append(instructionText(block.instructions().get(i)));
        out.append("\n");
    }
    let terminator = block.terminator();
    if (terminator == null) {
        out.append("  <no terminator>\n");
    } else {
        out.append("  ");
        out.append(terminatorText(function, terminator));
        out.append("\n");
    }
}

export instructionText(EirInstruction instruction) -> string {
    switch (instruction) {
        is EirConstInt constant -> {
            return "%{constant.result} = const {integerText(constant.bits, constant.type)}"
                + ": {types.display(constant.type)}";
        },
        is EirConstFloat constant -> {
            return "%{constant.result} = const {constant.text}: {types.display(constant.type)}";
        },
        is EirConstBool constant -> {
            string spelled = "false";
            if (constant.value) {
                spelled = "true";
            }
            return "%{constant.result} = const {spelled}: {types.display(constant.type)}";
        },
        is EirBinary binary -> {
            return "%{binary.result} = {binaryOpText(binary.op)} %{binary.left}, "
                + "%{binary.right}: {types.display(binary.type)}";
        },
        is EirUnary unary -> {
            return "%{unary.result} = {unaryOpText(unary.op)} %{unary.operand}"
                + ": {types.display(unary.type)}";
        },
        is EirCast cast -> {
            return "%{cast.result} = {castOpText(cast.op)} %{cast.operand}"
                + ": {types.display(cast.type)}";
        },
        is EirLoadSlot load -> {
            return "%{load.result} = load ${load.slot}: {types.display(load.type)}";
        },
        is EirStoreSlot store -> {
            return "store ${store.slot}, %{store.value}";
        },
        is EirCall call -> {
            let arguments = new StringBuilder();
            for (long i = 0; i < call.arguments.length; i++) {
                if (i > 0) {
                    arguments.append(", ");
                }
                arguments.append("%{call.arguments[i]}");
            }
            if (call.result < 0) {
                return "call @{call.callee.symbol()}({arguments.toString()})";
            }
            return "%{call.result} = call @{call.callee.symbol()}({arguments.toString()})"
                + ": {types.display(call.type)}";
        },
    }
}

terminatorText(EirFunction function, EirTerminator terminator) -> string {
    switch (terminator) {
        is EirReturn returned -> {
            if (returned.value < 0) {
                return "ret";
            }
            return "ret %{returned.value}";
        },
        is EirJump jump -> {
            return "jump {labelOf(function, jump.target)}";
        },
        is EirBranch branch -> {
            return "br %{branch.condition}, {labelOf(function, branch.thenTarget)}, "
                + "{labelOf(function, branch.elseTarget)}";
        },
        is EirSwitch switched -> {
            let cases = new StringBuilder();
            for (long i = 0; i < switched.caseValues.length; i++) {
                if (i > 0) {
                    cases.append(", ");
                }
                cases.append("{switched.caseValues[i]} -> "
                    + labelOf(function, switched.caseTargets[i]));
            }
            return "switch %{switched.value}, [{cases.toString()}], "
                + "default {labelOf(function, switched.defaultTarget)}";
        },
        is EirUnreachable ignored -> {
            return "unreachable";
        },
    }
}

labelOf(EirFunction function, long target) -> string {
    if (target < 0 || target >= function.blocks().length()) {
        return "<missing b{target}>";
    }
    return function.blocks().get(target).label();
}

// Signed types print their value; unsigned types print the bit pattern as a ulong.
integerText(long bits, Type type) -> string {
    if (type is PrimitiveType) {
        let signed = switch (type.kind()) {
            Short, Int, Long -> true,
            default -> false,
        };
        if (!signed) {
            return "{bits as ulong}";
        }
    }
    return "{bits}";
}

binaryOpText(EirBinaryOp op) -> string {
    return switch (op) {
        Add -> "add",
        Sub -> "sub",
        Mul -> "mul",
        DivSigned -> "div.s",
        DivUnsigned -> "div.u",
        RemSigned -> "rem.s",
        RemUnsigned -> "rem.u",
        FloatAdd -> "fadd",
        FloatSub -> "fsub",
        FloatMul -> "fmul",
        FloatDiv -> "fdiv",
        FloatRem -> "frem",
        And -> "and",
        Or -> "or",
        Xor -> "xor",
        ShiftLeft -> "shl",
        ShiftRightSigned -> "shr.s",
        ShiftRightUnsigned -> "shr.u",
        CmpEq -> "cmp.eq",
        CmpNe -> "cmp.ne",
        CmpLtSigned -> "cmp.slt",
        CmpLeSigned -> "cmp.sle",
        CmpGtSigned -> "cmp.sgt",
        CmpGeSigned -> "cmp.sge",
        CmpLtUnsigned -> "cmp.ult",
        CmpLeUnsigned -> "cmp.ule",
        CmpGtUnsigned -> "cmp.ugt",
        CmpGeUnsigned -> "cmp.uge",
        FloatCmpEq -> "fcmp.oeq",
        FloatCmpNe -> "fcmp.one",
        FloatCmpLt -> "fcmp.olt",
        FloatCmpLe -> "fcmp.ole",
        FloatCmpGt -> "fcmp.ogt",
        FloatCmpGe -> "fcmp.oge",
    };
}

unaryOpText(EirUnaryOp op) -> string {
    return switch (op) {
        Neg -> "neg",
        FloatNeg -> "fneg",
        Not -> "not",
    };
}

castOpText(EirCastOp op) -> string {
    return switch (op) {
        Trunc -> "trunc",
        ZeroExtend -> "zext",
        SignExtend -> "sext",
        FloatTrunc -> "fptrunc",
        FloatExtend -> "fpext",
        SignedToFloat -> "sitofp",
        UnsignedToFloat -> "uitofp",
        FloatToSigned -> "fptosi",
        FloatToUnsigned -> "fptoui",
        Reinterpret -> "reinterpret",
    };
}
