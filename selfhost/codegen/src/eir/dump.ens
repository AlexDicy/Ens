// The textual form of EIR, used by the golden lowering tests and for debugging. The dump is
// deterministic: temps as %N, slots as $N, blocks by their label, types by their sema display
// name, and no addresses anywhere.
import EirFunction from eir.model;
import EirBlock from eir.model;
import EirInstruction from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirCall from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirSlotAddress from eir.model;
import EirFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import EirConstString from eir.model;
import EirConstNull from eir.model;
import EirClassNew from eir.model;
import EirObjectFieldAddress from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import EirArrayNew from eir.model;
import EirArrayLength from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirStringIndexOf from eir.model;
import EirStringSubstring from eir.model;
import EirStringLength from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirIntToString from eir.model;
import EirCharToString from eir.model;
import EirBoolToString from eir.model;
import EirEnumToString from eir.model;
import EirDoubleToString from eir.model;
import EirJsonEscape from eir.model;
import EirPrint from eir.model;
import EirPanic from eir.model;
import EirTerminator from eir.model;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import EirBinaryOp from eir.model;
import EirUnaryOp from eir.model;
import EirCastOp from eir.model;
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import @ens.sema.model.types;
import eir.place;
import support.primitives;
import StringBuilder from @std.text.stringbuilder;

export dumpFunction(EirFunction function) -> string {
    let out = new StringBuilder();
    out.append("func ");
    if (function.internalLinkage()) {
        out.append("internal ");
    }
    out.append("@");
    out.append(function.symbol());
    out.append("(");
    long offset = 0;
    let receiverType = function.receiverType();
    if (receiverType != null) {
        // A struct's receiver is the address of its storage; a class's is the reference itself.
        string marker = primitives.classOf(receiverType) == null ? "&" : "";
        out.append("%0: {marker}{types.display(receiverType)}");
        offset = 1;
    }
    let parameters = function.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0 || offset > 0) {
            out.append(", ");
        }
        out.append("%{i + offset}: {types.display(parameters[i].type())}");
    }
    out.append(") -> {types.display(function.returnType())} \{\n");
    for (long i = 0; i < function.slots().length(); i++) {
        let slot = function.slots().get(i);
        out.append("  ${i} {slot.name()}: {types.display(slot.type())}");
        if (slot.borrows()) {
            out.append(" borrowed");
        } else if (slot.startsZeroed()) {
            out.append(" zeroed");
        }
        out.append("\n");
    }
    for (long i = 0; i < function.blocks().length(); i++) {
        appendBlock(out, function, function.blocks().get(i));
    }
    out.append("}\n");
    return out.toString();
}

appendBlock(StringBuilder out, EirFunction function, EirBlock block) {
    out.append(block.label());
    out.append(":\n");
    for (long i = 0; i < block.instructions().length(); i++) {
        let instruction = block.instructions().get(i);
        out.append("  ");
        out.append(instructionText(instruction));
        string annotation = placeAnnotation(function, instruction);
        if (annotation.length > 0) {
            out.append("  ; ");
            out.append(annotation);
        }
        out.append("\n");
    }
    let terminator = block.terminator();
    if (terminator == null) {
        out.append("  <no terminator>\n");
    } else {
        out.append("  ");
        out.append(terminatorText(function, terminator));
        out.append("\n");
    }
}

export instructionText(EirInstruction instruction) -> string {
    switch (instruction) {
        is EirConstInt constant -> {
            return "%{constant.result} = const {integerText(constant.bits, constant.type)}"
                + ": {types.display(constant.type)}";
        },
        is EirConstFloat constant -> {
            return "%{constant.result} = const {constant.text}: {types.display(constant.type)}";
        },
        is EirConstBool constant -> {
            string spelled = "false";
            if (constant.value) {
                spelled = "true";
            }
            return "%{constant.result} = const {spelled}: {types.display(constant.type)}";
        },
        is EirBinary binary -> {
            return "%{binary.result} = {binaryOpText(binary.op)} %{binary.left}, "
                + "%{binary.right}: {types.display(binary.type)}";
        },
        is EirUnary unary -> {
            return "%{unary.result} = {unaryOpText(unary.op)} %{unary.operand}"
                + ": {types.display(unary.type)}";
        },
        is EirCast cast -> {
            return "%{cast.result} = {castOpText(cast.op)} %{cast.operand}"
                + ": {types.display(cast.type)}";
        },
        is EirLoadSlot load -> {
            return "%{load.result} = load ${load.slot}: {types.display(load.type)}";
        },
        is EirStoreSlot store -> {
            return "store ${store.slot}, %{store.value}";
        },
        is EirCall call -> {
            let arguments = new StringBuilder();
            if (call.receiver >= 0) {
                arguments.append("this %{call.receiver}");
            }
            for (long i = 0; i < call.arguments.length; i++) {
                if (i > 0 || call.receiver >= 0) {
                    arguments.append(", ");
                }
                arguments.append("%{call.arguments[i]}");
            }
            if (call.result < 0) {
                return "call @{call.callee.symbol()}({arguments.toString()})";
            }
            return "%{call.result} = call @{call.callee.symbol()}({arguments.toString()})"
                + ": {types.display(call.type)}";
        },
        is EirRetain retain -> {
            return "retain %{retain.value}";
        },
        is EirRelease release -> {
            return "release %{release.value}";
        },
        is EirRetainPtr retain -> {
            return "retain_ptr %{retain.address}";
        },
        is EirReleasePtr release -> {
            return "release_ptr %{release.address}";
        },
        is EirSlotAddress address -> {
            return "%{address.result} = slot_addr ${address.slot}"
                + ": &{types.display(address.type)}";
        },
        is EirFieldAddress address -> {
            return "%{address.result} = field_addr %{address.base}, {address.fieldIndex}"
                + ": &{types.display(address.type)}";
        },
        is EirElementAddress address -> {
            return "%{address.result} = element_addr %{address.array}[%{address.index}]"
                + ": &{types.display(address.type)}";
        },
        is EirLoadPtr load -> {
            return "%{load.result} = load_ptr %{load.address}: {types.display(load.type)}";
        },
        is EirStorePtr store -> {
            return "store_ptr %{store.address}, %{store.value}";
        },
        is EirBoundsCheck check -> {
            return "bounds_check %{check.array}[%{check.index}]";
        },
        is EirRangeCheck check -> {
            return "range_check %{check.start}, %{check.end}, %{check.length}, "
                + "\"{check.message}\"";
        },
        is EirConstString constant -> {
            return "%{constant.result} = const \"{stringText(constant.bytes)}\""
                + ": {types.display(constant.type)}";
        },
        is EirConstNull constant -> {
            return "%{constant.result} = const null: {types.display(constant.type)}";
        },
        is EirClassNew allocation -> {
            return "%{allocation.result} = class.new @{allocation.destructorSymbol}"
                + ": {types.display(allocation.type)}";
        },
        is EirObjectFieldAddress address -> {
            return "%{address.result} = object_field_addr %{address.object}, "
                + "{address.fieldIndex}: &{types.display(address.type)}";
        },
        is EirWeakStore store -> {
            return "weak.store %{store.address}, %{store.value}";
        },
        is EirWeakLoad load -> {
            return "%{load.result} = weak.load %{load.address}: {types.display(load.type)}";
        },
        is EirWeakRelease release -> {
            return "weak.release %{release.address}";
        },
        is EirArrayNew allocation -> {
            return "%{allocation.result} = array.new %{allocation.size}"
                + ": {types.display(allocation.type)}";
        },
        is EirArrayLength length -> {
            return "%{length.result} = array.len %{length.array}"
                + ": {types.display(length.type)}";
        },
        is EirStringConcat concat -> {
            return "%{concat.result} = str.concat %{concat.left}, %{concat.right}"
                + ": {types.display(concat.type)}";
        },
        is EirStringEqual equal -> {
            return "%{equal.result} = str.eq %{equal.left}, %{equal.right}"
                + ": {types.display(equal.type)}";
        },
        is EirStringIndexOf search -> {
            return "%{search.result} = str.indexof %{search.haystack}, %{search.needle}"
                + ": {types.display(search.type)}";
        },
        is EirStringSubstring substring -> {
            return "%{substring.result} = str.substr %{substring.value}, %{substring.start}, "
                + "%{substring.end}: {types.display(substring.type)}";
        },
        is EirStringLength length -> {
            return "%{length.result} = str.len %{length.value}"
                + ": {types.display(length.type)}";
        },
        is EirStringToBytes bytes -> {
            return "%{bytes.result} = str.bytes %{bytes.value}: {types.display(bytes.type)}";
        },
        is EirStringFromBytes text -> {
            return "%{text.result} = bytes.str %{text.bytes}: {types.display(text.type)}";
        },
        is EirIntToString text -> {
            string form = "unsigned";
            if (text.signed) {
                form = "signed";
            }
            return "%{text.result} = int.str %{text.value} {form}"
                + ": {types.display(text.type)}";
        },
        is EirCharToString text -> {
            return "%{text.result} = char.str %{text.value}: {types.display(text.type)}";
        },
        is EirBoolToString text -> {
            return "%{text.result} = bool.str %{text.value}: {types.display(text.type)}";
        },
        is EirEnumToString text -> {
            return "%{text.result} = enum.str %{text.value} {types.display(text.enumType)}"
                + ": {types.display(text.type)}";
        },
        is EirDoubleToString text -> {
            return "%{text.result} = double.str %{text.value}: {types.display(text.type)}";
        },
        is EirJsonEscape escaped -> {
            return "%{escaped.result} = json.escape %{escaped.value}"
                + ": {types.display(escaped.type)}";
        },
        is EirPrint printed -> {
            return "print %{printed.value}";
        },
        is EirPanic panicked -> {
            return "panic %{panicked.value}";
        },
    }
}

// The place annotation for an address-producing instruction, or "" for everything else.
placeAnnotation(EirFunction function, EirInstruction instruction) -> string {
    switch (instruction) {
        is EirSlotAddress address -> {
            return place.describe(function, address.result);
        },
        is EirFieldAddress address -> {
            return place.describe(function, address.result);
        },
        is EirObjectFieldAddress address -> {
            return place.describe(function, address.result);
        },
        is EirElementAddress address -> {
            return place.describe(function, address.result);
        },
        default -> {
            return "";
        },
    }
}

// The dump spelling of a literal's bytes: quotes and backslashes escaped, control bytes as
// their short escapes or \u00XX, everything else passed through as UTF-8.
stringText(byte[] bytes) -> string {
    let out = new StringBuilder();
    for (long i = 0; i < bytes.length; i++) {
        byte value = bytes[i];
        if (value == '"') {
            out.append("\\\"");
        } else if (value == '\\') {
            out.append("\\\\");
        } else if (value == '\n') {
            out.append("\\n");
        } else if (value == '\t') {
            out.append("\\t");
        } else if (value == '\r') {
            out.append("\\r");
        } else if (value < 0x20) {
            out.append("\\u00");
            out.appendByte(hexDigit(value / 16));
            out.appendByte(hexDigit(value % 16));
        } else {
            out.appendByte(value);
        }
    }
    return out.toString();
}

hexDigit(byte value) -> byte {
    if (value < 10) {
        return (value + '0') as byte;
    }
    return (value - 10 + 'a') as byte;
}

terminatorText(EirFunction function, EirTerminator terminator) -> string {
    switch (terminator) {
        is EirReturn returned -> {
            if (returned.value < 0) {
                return "ret";
            }
            return "ret %{returned.value}";
        },
        is EirJump jump -> {
            return "jump {labelOf(function, jump.target)}";
        },
        is EirBranch branch -> {
            return "br %{branch.condition}, {labelOf(function, branch.thenTarget)}, "
                + "{labelOf(function, branch.elseTarget)}";
        },
        is EirSwitch switched -> {
            let cases = new StringBuilder();
            for (long i = 0; i < switched.caseValues.length; i++) {
                if (i > 0) {
                    cases.append(", ");
                }
                cases.append("{switched.caseValues[i]} -> "
                    + labelOf(function, switched.caseTargets[i]));
            }
            return "switch %{switched.value}, [{cases.toString()}], "
                + "default {labelOf(function, switched.defaultTarget)}";
        },
        is EirUnreachable ignored -> {
            return "unreachable";
        },
    }
}

labelOf(EirFunction function, long target) -> string {
    if (target < 0 || target >= function.blocks().length()) {
        return "<missing b{target}>";
    }
    return function.blocks().get(target).label();
}

// Signed types print their value; unsigned types print the bit pattern as a ulong.
integerText(long bits, Type type) -> string {
    if (type is PrimitiveType) {
        let signed = switch (type.kind()) {
            Short, Int, Long -> true,
            default -> false,
        };
        if (!signed) {
            return "{bits as ulong}";
        }
    }
    return "{bits}";
}

binaryOpText(EirBinaryOp op) -> string {
    return switch (op) {
        Add -> "add",
        Sub -> "sub",
        Mul -> "mul",
        DivSigned -> "div.s",
        DivUnsigned -> "div.u",
        RemSigned -> "rem.s",
        RemUnsigned -> "rem.u",
        FloatAdd -> "fadd",
        FloatSub -> "fsub",
        FloatMul -> "fmul",
        FloatDiv -> "fdiv",
        FloatRem -> "frem",
        And -> "and",
        Or -> "or",
        Xor -> "xor",
        ShiftLeft -> "shl",
        ShiftRightSigned -> "shr.s",
        ShiftRightUnsigned -> "shr.u",
        CmpEq -> "cmp.eq",
        CmpNe -> "cmp.ne",
        CmpLtSigned -> "cmp.slt",
        CmpLeSigned -> "cmp.sle",
        CmpGtSigned -> "cmp.sgt",
        CmpGeSigned -> "cmp.sge",
        CmpLtUnsigned -> "cmp.ult",
        CmpLeUnsigned -> "cmp.ule",
        CmpGtUnsigned -> "cmp.ugt",
        CmpGeUnsigned -> "cmp.uge",
        FloatCmpEq -> "fcmp.oeq",
        FloatCmpNe -> "fcmp.one",
        FloatCmpLt -> "fcmp.olt",
        FloatCmpLe -> "fcmp.ole",
        FloatCmpGt -> "fcmp.ogt",
        FloatCmpGe -> "fcmp.oge",
    };
}

unaryOpText(EirUnaryOp op) -> string {
    return switch (op) {
        Neg -> "neg",
        FloatNeg -> "fneg",
        Not -> "not",
    };
}

castOpText(EirCastOp op) -> string {
    return switch (op) {
        Trunc -> "trunc",
        ZeroExtend -> "zext",
        SignExtend -> "sext",
        FloatTrunc -> "fptrunc",
        FloatExtend -> "fpext",
        SignedToFloat -> "sitofp",
        UnsignedToFloat -> "uitofp",
        FloatToSigned -> "fptosi",
        FloatToUnsigned -> "fptoui",
        Reinterpret -> "reinterpret",
    };
}
