// The structural EIR verifier. It runs over every lowered function, in unit tests and in the
// compile path, and reports shape violations no valid lowering may produce: a temp assigned
// twice or used where it may not be defined yet, a block without exactly one terminator, an
// operand or result whose type disagrees with its instruction, a slot accessed at the wrong
// type, or a terminator naming a block that does not exist. Ownership balance joins these
// checks when retain and release instructions arrive.
import EirFunction from eir.model;
import EirBlock from eir.model;
import EirInstruction from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirCall from eir.model;
import EirTerminator from eir.model;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import eir.model;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import support.primitives;
import List from @std.collections.list;

// Verifies one function; the returned list is empty when the function is well formed.
export verifyFunction(EirFunction function) -> string[] {
    let verifier = new FunctionVerifier(function);
    return verifier.run();
}

class FunctionVerifier {
    EirFunction function;
    long tempCount;
    List<string> problems;
    long[] definingBlock;
    long[] definingIndex;

    protected constructor(EirFunction function) {
        this.function = function;
        this.tempCount = function.tempTypes().length();
        this.problems = new List<string>();
        this.definingBlock = new long[this.tempCount];
        this.definingIndex = new long[this.tempCount];
    }

    protected run() -> string[] {
        this.collectDefinitions();
        this.checkBlocks();
        this.checkDefiniteDefinition();
        return this.problems.toArray();
    }

    report(string problem) {
        this.problems.push("{this.function.symbol()}: {problem}");
    }

    // Records where each temp is defined and rejects double definitions. Parameters are defined
    // before the entry block; their defining index stays -1 in block -1.
    collectDefinitions() {
        for (long i = 0; i < this.tempCount; i++) {
            this.definingBlock[i] = -2;
            this.definingIndex[i] = -1;
        }
        for (long i = 0; i < this.function.parameters().length; i++) {
            this.definingBlock[i] = -1;
        }
        let blocks = this.function.blocks();
        for (long b = 0; b < blocks.length(); b++) {
            let instructions = blocks.get(b).instructions();
            for (long i = 0; i < instructions.length(); i++) {
                long result = resultOf(instructions.get(i));
                if (result < 0) {
                    continue;
                }
                if (result >= this.tempCount) {
                    this.report("instruction defines %{result} but only {this.tempCount} "
                        + "temps exist");
                    continue;
                }
                if (this.definingBlock[result] != -2) {
                    this.report("%{result} is assigned more than once");
                    continue;
                }
                this.definingBlock[result] = b;
                this.definingIndex[result] = i;
            }
        }
    }

    checkBlocks() {
        let blocks = this.function.blocks();
        if (blocks.length() == 0) {
            this.report("function has no blocks");
            return;
        }
        for (long b = 0; b < blocks.length(); b++) {
            let block = blocks.get(b);
            let instructions = block.instructions();
            for (long i = 0; i < instructions.length(); i++) {
                this.checkInstruction(block, instructions.get(i));
            }
            let terminator = block.terminator();
            if (terminator == null) {
                this.report("block {block.label()} has no terminator");
            } else {
                this.checkTerminator(block, terminator);
            }
        }
    }

    checkInstruction(EirBlock block, EirInstruction instruction) {
        switch (instruction) {
            is EirConstInt constant -> {
                this.checkResultType(block, constant.result, constant.type);
                if (!primitives.isIntegerType(constant.type)) {
                    this.report("{block.label()}: const %{constant.result} has non-integer "
                        + "type {types.display(constant.type)}");
                }
            },
            is EirConstFloat constant -> {
                this.checkResultType(block, constant.result, constant.type);
                if (!primitives.isFloatType(constant.type)) {
                    this.report("{block.label()}: const %{constant.result} has non-float "
                        + "type {types.display(constant.type)}");
                }
            },
            is EirConstBool constant -> {
                this.checkResultType(block, constant.result, constant.type);
                if (!primitives.isBoolType(constant.type)) {
                    this.report("{block.label()}: const %{constant.result} has non-bool "
                        + "type {types.display(constant.type)}");
                }
            },
            is EirBinary binary -> {
                this.checkResultType(block, binary.result, binary.type);
                this.checkOperand(block, binary.left);
                this.checkOperand(block, binary.right);
                if (this.validTemp(binary.left) && this.validTemp(binary.right)) {
                    let leftType = this.function.tempTypes().get(binary.left);
                    let rightType = this.function.tempTypes().get(binary.right);
                    if (leftType != rightType) {
                        this.report("{block.label()}: %{binary.result} combines operands of "
                            + "different types {types.display(leftType)} and "
                            + "{types.display(rightType)}");
                    } else if (model.isComparison(binary.op)) {
                        if (!primitives.isBoolType(binary.type)) {
                            this.report("{block.label()}: comparison %{binary.result} must "
                                + "produce bool, got {types.display(binary.type)}");
                        }
                    } else if (leftType != binary.type) {
                        this.report("{block.label()}: %{binary.result} of type "
                            + "{types.display(binary.type)} disagrees with its operands of "
                            + "type {types.display(leftType)}");
                    }
                }
            },
            is EirUnary unary -> {
                this.checkResultType(block, unary.result, unary.type);
                this.checkOperand(block, unary.operand);
                if (this.validTemp(unary.operand)
                        && this.function.tempTypes().get(unary.operand) != unary.type) {
                    this.report("{block.label()}: %{unary.result} of type "
                        + "{types.display(unary.type)} disagrees with its operand");
                }
            },
            is EirCast cast -> {
                this.checkResultType(block, cast.result, cast.type);
                this.checkOperand(block, cast.operand);
            },
            is EirLoadSlot load -> {
                this.checkResultType(block, load.result, load.type);
                if (load.slot < 0 || load.slot >= this.function.slots().length()) {
                    this.report("{block.label()}: load of missing slot ${load.slot}");
                } else if (this.function.slots().get(load.slot).type() != load.type) {
                    this.report("{block.label()}: load of ${load.slot} at type "
                        + "{types.display(load.type)} but the slot holds "
                        + "{types.display(this.function.slots().get(load.slot).type())}");
                }
            },
            is EirStoreSlot store -> {
                this.checkOperand(block, store.value);
                if (store.slot < 0 || store.slot >= this.function.slots().length()) {
                    this.report("{block.label()}: store to missing slot ${store.slot}");
                } else if (this.validTemp(store.value)
                        && this.function.slots().get(store.slot).type()
                            != this.function.tempTypes().get(store.value)) {
                    this.report("{block.label()}: store of "
                        + "{types.display(this.function.tempTypes().get(store.value))} into "
                        + "${store.slot} which holds "
                        + "{types.display(this.function.slots().get(store.slot).type())}");
                }
            },
            is EirCall call -> {
                if (call.result >= 0) {
                    this.checkResultType(block, call.result, call.type);
                    if (call.type != call.callee.returnType()) {
                        this.report("{block.label()}: call result type "
                            + "{types.display(call.type)} disagrees with callee "
                            + "@{call.callee.symbol()} returning "
                            + "{types.display(call.callee.returnType())}");
                    }
                }
                Type[] parameterTypes = call.callee.parameterTypes();
                if (call.arguments.length != parameterTypes.length) {
                    this.report("{block.label()}: call to @{call.callee.symbol()} passes "
                        + "{call.arguments.length} argument(s) for "
                        + "{parameterTypes.length} parameter(s)");
                } else {
                    for (long i = 0; i < call.arguments.length; i++) {
                        this.checkOperand(block, call.arguments[i]);
                        if (this.validTemp(call.arguments[i])
                                && this.function.tempTypes().get(call.arguments[i])
                                    != parameterTypes[i]) {
                            this.report("{block.label()}: argument {i + 1} of "
                                + "@{call.callee.symbol()} has type "
                                + "{types.display(this.function.tempTypes().get(call.arguments[i]))} "
                                + "but the parameter takes "
                                + "{types.display(parameterTypes[i])}");
                        }
                    }
                }
            },
        }
    }

    checkTerminator(EirBlock block, EirTerminator terminator) {
        switch (terminator) {
            is EirReturn returned -> {
                bool returnsVoid = types.isVoidType(this.function.returnType());
                if (returned.value < 0) {
                    if (!returnsVoid) {
                        this.report("{block.label()}: ret without a value in a function "
                            + "returning {types.display(this.function.returnType())}");
                    }
                } else {
                    this.checkOperand(block, returned.value);
                    if (returnsVoid) {
                        this.report("{block.label()}: ret with a value in a void function");
                    } else if (this.validTemp(returned.value)
                            && this.function.tempTypes().get(returned.value)
                                != this.function.returnType()) {
                        this.report("{block.label()}: ret of type "
                            + "{types.display(this.function.tempTypes().get(returned.value))} "
                            + "in a function returning "
                            + "{types.display(this.function.returnType())}");
                    }
                }
            },
            is EirJump jump -> {
                this.checkTarget(block, jump.target);
            },
            is EirBranch branch -> {
                this.checkOperand(block, branch.condition);
                if (this.validTemp(branch.condition)
                        && !primitives.isBoolType(this.function.tempTypes().get(branch.condition))) {
                    this.report("{block.label()}: branch condition %{branch.condition} is "
                        + "not bool");
                }
                this.checkTarget(block, branch.thenTarget);
                this.checkTarget(block, branch.elseTarget);
            },
            is EirSwitch switched -> {
                this.checkOperand(block, switched.value);
                if (this.validTemp(switched.value)
                        && !primitives.isIntegerType(this.function.tempTypes().get(switched.value))) {
                    this.report("{block.label()}: switch over non-integer "
                        + "%{switched.value}");
                }
                if (switched.caseValues.length != switched.caseTargets.length) {
                    this.report("{block.label()}: switch case values and targets differ in "
                        + "count");
                }
                for (let target in switched.caseTargets) {
                    this.checkTarget(block, target);
                }
                this.checkTarget(block, switched.defaultTarget);
            },
            is EirUnreachable ignored -> { },
        }
    }

    checkTarget(EirBlock block, long target) {
        if (target < 0 || target >= this.function.blocks().length()) {
            this.report("{block.label()}: terminator names missing block b{target}");
        }
    }

    validTemp(long temp) -> bool {
        return temp >= 0 && temp < this.tempCount;
    }

    checkOperand(EirBlock block, long temp) {
        if (!this.validTemp(temp)) {
            this.report("{block.label()}: use of invalid temp %{temp}");
        }
    }

    checkResultType(EirBlock block, long result, Type type) {
        if (!this.validTemp(result)) {
            this.report("{block.label()}: definition of invalid temp %{result}");
            return;
        }
        if (this.function.tempTypes().get(result) != type) {
            this.report("{block.label()}: %{result} is recorded as "
                + "{types.display(this.function.tempTypes().get(result))} but its "
                + "instruction produces {types.display(type)}");
        }
    }

    // Def-before-use over the flow graph: a forward dataflow computes, to a fixpoint, the temps
    // definitely defined at each block entry (the intersection over predecessors), then every
    // use must be covered by that set or by an earlier definition in its own block.
    checkDefiniteDefinition() {
        let blocks = this.function.blocks();
        long blockCount = blocks.length();
        if (blockCount == 0) {
            return;
        }
        bool[][] definedAtEntry = new bool[blockCount][this.tempCount + 1];
        bool[] reached = new bool[blockCount];
        for (long i = 0; i < this.function.parameters().length; i++) {
            definedAtEntry[0][i] = true;
        }
        reached[0] = true;
        bool changed = true;
        while (changed) {
            changed = false;
            for (long b = 0; b < blockCount; b++) {
                if (!reached[b]) {
                    continue;
                }
                bool[] defined = new bool[this.tempCount + 1];
                for (long i = 0; i < this.tempCount; i++) {
                    defined[i] = definedAtEntry[b][i];
                }
                let instructions = blocks.get(b).instructions();
                for (long i = 0; i < instructions.length(); i++) {
                    long result = resultOf(instructions.get(i));
                    if (result >= 0 && result < this.tempCount) {
                        defined[result] = true;
                    }
                }
                for (let successor in this.successorsOf(blocks.get(b))) {
                    if (successor < 0 || successor >= blockCount) {
                        continue;
                    }
                    if (!reached[successor]) {
                        reached[successor] = true;
                        for (long i = 0; i < this.tempCount; i++) {
                            definedAtEntry[successor][i] = defined[i];
                        }
                        changed = true;
                        continue;
                    }
                    for (long i = 0; i < this.tempCount; i++) {
                        if (definedAtEntry[successor][i] && !defined[i]) {
                            definedAtEntry[successor][i] = false;
                            changed = true;
                        }
                    }
                }
            }
        }
        for (long b = 0; b < blockCount; b++) {
            if (!reached[b]) {
                continue;
            }
            let block = blocks.get(b);
            bool[] defined = new bool[this.tempCount + 1];
            for (long i = 0; i < this.tempCount; i++) {
                defined[i] = definedAtEntry[b][i];
            }
            let instructions = block.instructions();
            for (long i = 0; i < instructions.length(); i++) {
                let instruction = instructions.get(i);
                for (let used in usesOf(instruction)) {
                    if (this.validTemp(used) && !defined[used]) {
                        this.report("{block.label()}: %{used} is used before it is "
                            + "definitely defined");
                    }
                }
                long result = resultOf(instruction);
                if (result >= 0 && result < this.tempCount) {
                    defined[result] = true;
                }
            }
            let terminator = block.terminator();
            if (terminator != null) {
                for (let used in terminatorUsesOf(terminator)) {
                    if (this.validTemp(used) && !defined[used]) {
                        this.report("{block.label()}: %{used} is used before it is "
                            + "definitely defined");
                    }
                }
            }
        }
    }

    successorsOf(EirBlock block) -> long[] {
        let terminator = block.terminator();
        if (terminator == null) {
            return [];
        }
        switch (terminator) {
            is EirReturn ignored -> {
                return [];
            },
            is EirJump jump -> {
                return [jump.target];
            },
            is EirBranch branch -> {
                return [branch.thenTarget, branch.elseTarget];
            },
            is EirSwitch switched -> {
                let successors = new List<long>();
                for (let target in switched.caseTargets) {
                    successors.push(target);
                }
                successors.push(switched.defaultTarget);
                return successors.toArray();
            },
            is EirUnreachable ignored -> {
                return [];
            },
        }
    }
}

resultOf(EirInstruction instruction) -> long {
    switch (instruction) {
        is EirConstInt constant -> {
            return constant.result;
        },
        is EirConstFloat constant -> {
            return constant.result;
        },
        is EirConstBool constant -> {
            return constant.result;
        },
        is EirBinary binary -> {
            return binary.result;
        },
        is EirUnary unary -> {
            return unary.result;
        },
        is EirCast cast -> {
            return cast.result;
        },
        is EirLoadSlot load -> {
            return load.result;
        },
        is EirStoreSlot ignored -> {
            return -1;
        },
        is EirCall call -> {
            return call.result;
        },
    }
}

usesOf(EirInstruction instruction) -> long[] {
    switch (instruction) {
        is EirConstInt ignored -> {
            return [];
        },
        is EirConstFloat ignored -> {
            return [];
        },
        is EirConstBool ignored -> {
            return [];
        },
        is EirBinary binary -> {
            return [binary.left, binary.right];
        },
        is EirUnary unary -> {
            return [unary.operand];
        },
        is EirCast cast -> {
            return [cast.operand];
        },
        is EirLoadSlot ignored -> {
            return [];
        },
        is EirStoreSlot store -> {
            return [store.value];
        },
        is EirCall call -> {
            return call.arguments;
        },
    }
}

terminatorUsesOf(EirTerminator terminator) -> long[] {
    switch (terminator) {
        is EirReturn returned -> {
            if (returned.value < 0) {
                return [];
            }
            return [returned.value];
        },
        is EirJump ignored -> {
            return [];
        },
        is EirBranch branch -> {
            return [branch.condition];
        },
        is EirSwitch switched -> {
            return [switched.value];
        },
        is EirUnreachable ignored -> {
            return [];
        },
    }
}
