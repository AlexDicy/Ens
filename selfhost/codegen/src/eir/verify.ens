// The structural EIR verifier over every lowered function, reporting the shape violations no
// valid lowering may produce. The checks themselves live in the value, memory, array, call,
// string, and control-flow modules, as free functions over one VerificationContext.
import EirFunction from eir.model;
import EirBlock from eir.model;
import EirInstruction from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirCall from eir.model;
import EirConstString from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirSlotAddress from eir.model;
import EirGlobalAddress from eir.model;
import EirFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import EirTypeTest from eir.model;
import EirCheckedCast from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirRuntimeTypeName from eir.model;
import EirConstNull from eir.model;
import EirClassNew from eir.model;
import EirClosureNew from eir.model;
import EirClosureCapture from eir.model;
import EirClosureCall from eir.model;
import EirObjectFieldAddress from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import EirArrayNew from eir.model;
import EirArrayLength from eir.model;
import EirArraySlice from eir.model;
import EirAbsentOptional from eir.model;
import EirHashValue from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirWrapOptional from eir.model;
import EirStringSubstring from eir.model;
import EirStringLength from eir.model;
import EirStringByteAt from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirIntToString from eir.model;
import EirCharToString from eir.model;
import EirBoolToString from eir.model;
import EirEnumToString from eir.model;
import EirDoubleToString from eir.model;
import EirJsonEscape from eir.model;
import EirPanic from eir.model;
import EirCaptureTrace from eir.model;
import EirErrorTrace from eir.model;
import EirForeignCall from eir.model;
import EirCStringLift from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyarrays;
import eir.verifycalls;
import eir.verifyclasses;
import eir.verifyclosures;
import eir.verifycontext;
import eir.verifyflow;
import eir.verifymemory;
import eir.verifyoptionals;
import eir.verifystrings;
import eir.verifytypes;
import eir.verifyvalues;

// Verifies one function; the returned list is empty when the function is well formed.
export verifyFunction(EirFunction function) -> string[] {
    let verification = new VerificationContext(function);
    verifycontext.collectDefinitions(verification);
    checkBlocks(verification);
    verifyflow.checkDefiniteDefinition(verification);
    verifytypes.checkConcreteTypes(verification);
    return verification.problems();
}

// Every block holds instructions that check out and ends in exactly one terminator.
checkBlocks(VerificationContext verification) {
    let blocks = verification.function().blocks();
    if (blocks.length() == 0) {
        verification.report("function has no blocks");
        return;
    }
    for (long b = 0; b < blocks.length(); b++) {
        let block = blocks.get(b);
        let instructions = block.instructions();
        for (long i = 0; i < instructions.length(); i++) {
            checkInstruction(verification, block, instructions.get(i));
        }
        let terminator = block.terminator();
        if (terminator == null) {
            verification.report("block {block.label()} has no terminator");
        } else {
            verifyflow.checkTerminator(verification, block, terminator);
        }
    }
}

// The switch has no default arm, so a new instruction kind cannot be added without saying what
// verifies it.
checkInstruction(VerificationContext verification, EirBlock block, EirInstruction instruction) {
    switch (instruction) {
        is EirConstInt constant -> {
            verifyvalues.checkConstInt(verification, block, constant);
        },
        is EirConstFloat constant -> {
            verifyvalues.checkConstFloat(verification, block, constant);
        },
        is EirConstBool constant -> {
            verifyvalues.checkConstBool(verification, block, constant);
        },
        is EirBinary binary -> {
            verifyvalues.checkBinary(verification, block, binary);
        },
        is EirUnary unary -> {
            verifyvalues.checkUnary(verification, block, unary);
        },
        is EirCast cast -> {
            verifyvalues.checkCast(verification, block, cast);
        },
        is EirLoadSlot load -> {
            verifymemory.checkLoadSlot(verification, block, load);
        },
        is EirStoreSlot store -> {
            verifymemory.checkStoreSlot(verification, block, store);
        },
        is EirTakeSlot taken -> {
            verifymemory.checkTakeSlot(verification, block, taken);
        },
        is EirCall call -> {
            verifycalls.checkCall(verification, block, call);
        },
        is EirConstString constant -> {
            verifyvalues.checkConstString(verification, block, constant);
        },
        is EirConstNull constant -> {
            verifyclasses.checkConstNull(verification, block, constant);
        },
        is EirClassNew allocation -> {
            verifyclasses.checkClassNew(verification, block, allocation);
        },
        is EirClosureNew closure -> {
            verifyclosures.checkClosureNew(verification, block, closure);
        },
        is EirClosureCapture capture -> {
            verifyclosures.checkClosureCapture(verification, block, capture);
        },
        is EirClosureCall call -> {
            verifyclosures.checkClosureCall(verification, block, call);
        },
        is EirTypeTest test -> {
            verifyclasses.checkTypeTest(verification, block, test);
        },
        is EirCheckedCast cast -> {
            verifyclasses.checkCheckedCast(verification, block, cast);
        },
        is EirDynamicEquals equal -> {
            verifyclasses.checkDynamicEquals(verification, block, equal);
        },
        is EirDynamicHash hashed -> {
            verifyclasses.checkDynamicHash(verification, block, hashed);
        },
        is EirDynamicToString text -> {
            verifyclasses.checkDynamicToString(verification, block, text);
        },
        is EirRuntimeTypeName named -> {
            verifyclasses.checkRuntimeTypeName(verification, block, named);
        },
        is EirObjectFieldAddress address -> {
            verifyclasses.checkObjectFieldAddress(verification, block, address);
        },
        is EirWeakStore store -> {
            verifyclasses.checkWeakStore(verification, block, store);
        },
        is EirWeakLoad load -> {
            verifyclasses.checkWeakLoad(verification, block, load);
        },
        is EirWeakRelease release -> {
            verifyclasses.checkWeakRelease(verification, block, release);
        },
        is EirRetain retain -> {
            verifymemory.checkRetain(verification, block, retain);
        },
        is EirRelease release -> {
            verifymemory.checkRelease(verification, block, release);
        },
        is EirRetainPtr retain -> {
            verifymemory.checkRetainPtr(verification, block, retain);
        },
        is EirReleasePtr release -> {
            verifymemory.checkReleasePtr(verification, block, release);
        },
        is EirSlotAddress address -> {
            verifymemory.checkSlotAddress(verification, block, address);
        },
        is EirGlobalAddress address -> {
            verifymemory.checkGlobalAddress(verification, block, address);
        },
        is EirFieldAddress address -> {
            verifymemory.checkFieldAddress(verification, block, address);
        },
        is EirElementAddress address -> {
            verifyarrays.checkElementAddress(verification, block, address);
        },
        is EirLoadPtr load -> {
            verifymemory.checkLoadPtr(verification, block, load);
        },
        is EirStorePtr store -> {
            verifymemory.checkStorePtr(verification, block, store);
        },
        is EirBoundsCheck check -> {
            verifyarrays.checkBoundsCheck(verification, block, check);
        },
        is EirRangeCheck check -> {
            verifyarrays.checkRangeCheck(verification, block, check);
        },
        is EirArrayNew allocation -> {
            verifyarrays.checkArrayNew(verification, block, allocation);
        },
        is EirArrayLength length -> {
            verifyarrays.checkArrayLength(verification, block, length);
        },
        is EirArraySlice sliced -> {
            verifyarrays.checkArraySlice(verification, block, sliced);
        },
        is EirStringConcat concat -> {
            verifystrings.checkStringConcat(verification, block, concat);
        },
        is EirStringEqual equal -> {
            verifystrings.checkStringEqual(verification, block, equal);
        },
        is EirHashValue hashed -> {
            verifyvalues.checkHashValue(verification, block, hashed);
        },
        is EirWrapOptional wrapped -> {
            verifyoptionals.checkWrapOptional(verification, block, wrapped);
        },
        is EirAbsentOptional absent -> {
            verifyoptionals.checkAbsentOptional(verification, block, absent);
        },
        is EirOptionalPresence presence -> {
            verifyoptionals.checkOptionalPresence(verification, block, presence);
        },
        is EirOptionalPayload payload -> {
            verifyoptionals.checkOptionalPayload(verification, block, payload);
        },
        is EirOptionalPayloadAddress payloadAddress -> {
            verifyoptionals.checkOptionalPayloadAddress(verification, block, payloadAddress);
        },
        is EirStringSubstring substring -> {
            verifystrings.checkStringSubstring(verification, block, substring);
        },
        is EirStringLength length -> {
            verifystrings.checkStringLength(verification, block, length);
        },
        is EirStringByteAt read -> {
            verifystrings.checkStringByteAt(verification, block, read);
        },
        is EirStringToBytes bytes -> {
            verifystrings.checkStringToBytes(verification, block, bytes);
        },
        is EirStringFromBytes text -> {
            verifystrings.checkStringFromBytes(verification, block, text);
        },
        is EirIntToString text -> {
            verifystrings.checkIntToString(verification, block, text);
        },
        is EirCharToString text -> {
            verifystrings.checkCharToString(verification, block, text);
        },
        is EirBoolToString text -> {
            verifystrings.checkBoolToString(verification, block, text);
        },
        is EirEnumToString text -> {
            verifystrings.checkEnumToString(verification, block, text);
        },
        is EirDoubleToString text -> {
            verifystrings.checkDoubleToString(verification, block, text);
        },
        is EirJsonEscape escaped -> {
            verifystrings.checkJsonEscape(verification, block, escaped);
        },
        is EirPanic panicked -> {
            verifystrings.checkPanic(verification, block, panicked);
        },
        is EirCaptureTrace captured -> {
            verifyclasses.checkCaptureTrace(verification, block, captured);
        },
        is EirErrorTrace trace -> {
            verifyclasses.checkErrorTrace(verification, block, trace);
        },
        is EirForeignCall call -> {
            verifycalls.checkForeignCall(verification, block, call);
        },
        is EirCStringLift lifted -> {
            verifycalls.checkCStringLift(verification, block, lifted);
        },
    }
}
