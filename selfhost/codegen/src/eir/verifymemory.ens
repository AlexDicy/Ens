// The instructions that reach storage: slot loads and stores, the slot and field address
// projections, loads and stores through an address, and the reference counting that moves the +1
// a value temp or a location holds.
import EirBlock from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirSlotAddress from eir.model;
import EirFieldAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import StructType from @ens.sema.model.types;
import @ens.sema.model.types;
import support.primitives;

public checkLoadSlot(VerificationContext verification, EirBlock block, EirLoadSlot load) {
    verifyoperands.checkResultType(verification, block, load.result, load.type);
    let slots = verification.slots();
    if (load.slot < 0 || load.slot >= slots.length()) {
        verification.report("{block.label()}: load of missing slot ${load.slot}");
    } else if (slots.get(load.slot).type() != load.type) {
        verification.report("{block.label()}: load of ${load.slot} at type "
            + "{types.display(load.type)} but the slot holds "
            + "{types.display(slots.get(load.slot).type())}");
    }
}

public checkStoreSlot(VerificationContext verification, EirBlock block, EirStoreSlot store) {
    verifyoperands.checkOperand(verification, block, store.value);
    verifyoperands.checkNotAddress(verification, block, store.value,
        "the store into ${store.slot}");
    let slots = verification.slots();
    if (store.slot < 0 || store.slot >= slots.length()) {
        verification.report("{block.label()}: store to missing slot ${store.slot}");
    } else if (verification.validTemp(store.value)
            && slots.get(store.slot).type() != verification.typeOf(store.value)) {
        verification.report("{block.label()}: store of "
            + "{types.display(verification.typeOf(store.value))} into "
            + "${store.slot} which holds "
            + "{types.display(slots.get(store.slot).type())}");
    }
}

// A take moves the reference a slot owns, so the slot must exist at the taken type, hold a
// reference, and own what it holds - taking from a borrowing slot would steal a reference the
// caller still counts on.
public checkTakeSlot(VerificationContext verification, EirBlock block, EirTakeSlot taken) {
    verifyoperands.checkResultType(verification, block, taken.result, taken.type);
    let slots = verification.slots();
    if (taken.slot < 0 || taken.slot >= slots.length()) {
        verification.report("{block.label()}: take from missing slot ${taken.slot}");
        return;
    }
    let slot = slots.get(taken.slot);
    if (slot.type() != taken.type) {
        verification.report("{block.label()}: take from ${taken.slot} at type "
            + "{types.display(taken.type)} but the slot holds {types.display(slot.type())}");
    }
    if (!primitives.isReferenceType(slot.type())) {
        verification.report("{block.label()}: take from ${taken.slot} '{slot.name()}', which "
            + "holds {types.display(slot.type())} and owns no reference to move");
    }
    if (slot.borrows()) {
        verification.report("{block.label()}: take from ${taken.slot} '{slot.name()}', which "
            + "borrows a reference this function does not own");
    }
}

public checkSlotAddress(VerificationContext verification, EirBlock block,
                        EirSlotAddress address) {
    verifyoperands.checkResultType(verification, block, address.result, address.type);
    let slots = verification.slots();
    if (address.slot < 0 || address.slot >= slots.length()) {
        verification.report("{block.label()}: address of missing slot ${address.slot}");
    } else if (slots.get(address.slot).type() != address.type) {
        verification.report("{block.label()}: address of ${address.slot} at type "
            + "{types.display(address.type)} but the slot holds "
            + "{types.display(slots.get(address.slot).type())}");
    }
}

public checkFieldAddress(VerificationContext verification, EirBlock block,
                         EirFieldAddress address) {
    verifyoperands.checkResultType(verification, block, address.result, address.type);
    verifyoperands.checkOperand(verification, block, address.base);
    verifyoperands.checkIsAddress(verification, block, address.base, "the base of field_addr");
    if (verification.validTemp(address.base)) {
        let owner = verification.typeOf(address.base);
        let structType = primitives.structOf(owner);
        if (structType != null) {
            let fields = types.fieldsOf(structType);
            if (fields == null) {
                verification.report("{block.label()}: field_addr %{address.result} reaches "
                    + "into {types.display(owner)}, which exposes no fields");
            } else if (address.fieldIndex < 0 || address.fieldIndex >= fields.length()) {
                verification.report("{block.label()}: field_addr %{address.result} names "
                    + "field {address.fieldIndex} of {types.display(owner)}, which "
                    + "has {fields.length()}");
            } else if (fields.get(address.fieldIndex).type() != address.type) {
                verification.report("{block.label()}: field_addr %{address.result} is typed "
                    + "{types.display(address.type)} but field "
                    + "'{fields.get(address.fieldIndex).name()}' holds "
                    + "{types.display(fields.get(address.fieldIndex).type())}");
            }
        } else {
            verification.report("{block.label()}: field_addr %{address.result} reaches into "
                + "{types.display(owner)}, which has no fields");
        }
    }
}

public checkLoadPtr(VerificationContext verification, EirBlock block, EirLoadPtr load) {
    verifyoperands.checkResultType(verification, block, load.result, load.type);
    verifyoperands.checkOperand(verification, block, load.address);
    verifyoperands.checkIsAddress(verification, block, load.address, "load_ptr");
    if (verification.validTemp(load.address)
            && verification.typeOf(load.address) != load.type) {
        verification.report("{block.label()}: load_ptr %{load.result} reads "
            + "{types.display(load.type)} through an address to "
            + "{types.display(verification.typeOf(load.address))}");
    }
}

public checkStorePtr(VerificationContext verification, EirBlock block, EirStorePtr store) {
    verifyoperands.checkOperand(verification, block, store.address);
    verifyoperands.checkOperand(verification, block, store.value);
    verifyoperands.checkIsAddress(verification, block, store.address, "store_ptr");
    verifyoperands.checkNotAddress(verification, block, store.value,
        "the store through %{store.address}");
    if (verification.validTemp(store.address) && verification.validTemp(store.value)
            && verification.typeOf(store.address) != verification.typeOf(store.value)) {
        verification.report("{block.label()}: store_ptr writes "
            + "{types.display(verification.typeOf(store.value))} through "
            + "an address to {types.display(verification.typeOf(store.address))}");
    }
}

public checkRetain(VerificationContext verification, EirBlock block, EirRetain retain) {
    verifyoperands.checkOperand(verification, block, retain.value);
    verifyoperands.checkOwnable(verification, block, retain.value, "retain");
}

public checkRelease(VerificationContext verification, EirBlock block, EirRelease release) {
    verifyoperands.checkOperand(verification, block, release.value);
    verifyoperands.checkOwnable(verification, block, release.value, "release");
}

public checkRetainPtr(VerificationContext verification, EirBlock block, EirRetainPtr retain) {
    verifyoperands.checkOperand(verification, block, retain.address);
    verifyoperands.checkIsAddress(verification, block, retain.address, "retain_ptr");
}

public checkReleasePtr(VerificationContext verification, EirBlock block,
                       EirReleasePtr release) {
    verifyoperands.checkOperand(verification, block, release.address);
    verifyoperands.checkIsAddress(verification, block, release.address, "release_ptr");
    verifyoperands.checkNotBorrowedStorage(verification, block, release.address);
}
