// The class instructions: the absent reference, an allocation, the address of a field inside an
// object, and the three weak operations. Weak storage is checked here only for its shape; that it
// is reached by the weak operations and never by plain reference counting is the storage pass's
// question, because answering it needs the place an address names.
import EirBlock from eir.model;
import EirConstNull from eir.model;
import EirClassNew from eir.model;
import EirObjectFieldAddress from eir.model;
import EirTypeTest from eir.model;
import EirCheckedCast from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import OptionalType from @ens.sema.model.types;
import @ens.sema.model.types;
import support.primitives;

public checkConstNull(VerificationContext verification, EirBlock block, EirConstNull constant) {
    verifyoperands.checkResultType(verification, block, constant.result, constant.type);
    if (primitives.referenceOf(constant.type) == null) {
        verification.report("{block.label()}: null const %{constant.result} has type "
            + "{types.display(constant.type)}, which holds no reference");
    }
}

public checkClassNew(VerificationContext verification, EirBlock block, EirClassNew allocation) {
    verifyoperands.checkResultType(verification, block, allocation.result, allocation.type);
    if (primitives.classOf(allocation.type) == null) {
        verification.report("{block.label()}: class.new %{allocation.result} produces "
            + "{types.display(allocation.type)}, which is not a class");
    }
    if (allocation.destructorSymbol.length == 0) {
        verification.report("{block.label()}: class.new %{allocation.result} names no "
            + "destructor to store in the object header");
    }
}

public checkObjectFieldAddress(VerificationContext verification, EirBlock block,
                               EirObjectFieldAddress address) {
    verifyoperands.checkResultType(verification, block, address.result, address.type);
    verifyoperands.checkOperand(verification, block, address.object);
    verifyoperands.checkNotAddress(verification, block, address.object,
        "the object of object_field_addr");
    if (!verification.validTemp(address.object)) {
        return;
    }
    let owner = primitives.classOf(verification.typeOf(address.object));
    if (owner == null) {
        verification.report("{block.label()}: object_field_addr %{address.result} reaches into "
            + "{types.display(verification.typeOf(address.object))}, which is not a class");
        return;
    }
    let fields = types.fieldsOf(owner);
    if (fields == null) {
        verification.report("{block.label()}: object_field_addr %{address.result} reaches into "
            + "{types.display(owner)}, which exposes no fields");
        return;
    }
    if (address.fieldIndex < 0 || address.fieldIndex >= fields.length()) {
        verification.report("{block.label()}: object_field_addr %{address.result} names field "
            + "{address.fieldIndex} of {types.display(owner)}, which has {fields.length()}");
    } else if (fields.get(address.fieldIndex).type() != address.type) {
        verification.report("{block.label()}: object_field_addr %{address.result} is typed "
            + "{types.display(address.type)} but field "
            + "'{fields.get(address.fieldIndex).name()}' holds "
            + "{types.display(fields.get(address.fieldIndex).type())}");
    }
}

public checkTypeTest(VerificationContext verification, EirBlock block, EirTypeTest test) {
    verifyoperands.checkResultType(verification, block, test.result, test.type);
    verifyoperands.checkOperand(verification, block, test.value);
    verifyoperands.checkNotAddress(verification, block, test.value, "the value of type_test");
    if (!primitives.isBoolType(test.type)) {
        verification.report("{block.label()}: type_test %{test.result} must produce bool, got "
            + "{types.display(test.type)}");
    }
    if (!primitives.isClassLike(test.target)) {
        verification.report("{block.label()}: type_test %{test.result} tests against "
            + "{types.display(test.target)}, which is neither a class nor an interface");
    }
    if (verification.validTemp(test.value)
            && !primitives.isClassLike(verification.typeOf(test.value))) {
        verification.report("{block.label()}: type_test %{test.result} reads the runtime type "
            + "of {types.display(verification.typeOf(test.value))}, which carries none");
    }
}

public checkCheckedCast(VerificationContext verification, EirBlock block, EirCheckedCast cast) {
    verifyoperands.checkResultType(verification, block, cast.result, cast.type);
    verifyoperands.checkOperand(verification, block, cast.value);
    verifyoperands.checkNotAddress(verification, block, cast.value, "the value of checked_cast");
    if (!primitives.isClassLike(cast.target)) {
        verification.report("{block.label()}: checked_cast %{cast.result} casts to "
            + "{types.display(cast.target)}, which is neither a class nor an interface");
    }
    if (!(cast.type is OptionalType) || cast.type.inner() != cast.target) {
        verification.report("{block.label()}: checked_cast %{cast.result} produces "
            + "{types.display(cast.type)}, but a cast to {types.display(cast.target)} may fail, "
            + "so it must produce {types.display(cast.target)}?");
    }
    if (verification.validTemp(cast.value)
            && !primitives.isClassLike(verification.typeOf(cast.value))) {
        verification.report("{block.label()}: checked_cast %{cast.result} reads the runtime "
            + "type of {types.display(verification.typeOf(cast.value))}, which carries none");
    }
}

public checkWeakStore(VerificationContext verification, EirBlock block, EirWeakStore store) {
    verifyoperands.checkOperand(verification, block, store.address);
    verifyoperands.checkOperand(verification, block, store.value);
    verifyoperands.checkIsAddress(verification, block, store.address, "weak.store");
    verifyoperands.checkNotAddress(verification, block, store.value,
        "the weak store through %{store.address}");
    if (verification.validTemp(store.value)
            && primitives.classOf(verification.typeOf(store.value)) == null) {
        verification.report("{block.label()}: weak.store writes "
            + "{types.display(verification.typeOf(store.value))}, and only a class reference can "
            + "be watched weakly");
    }
}

public checkWeakLoad(VerificationContext verification, EirBlock block, EirWeakLoad load) {
    verifyoperands.checkResultType(verification, block, load.result, load.type);
    verifyoperands.checkOperand(verification, block, load.address);
    verifyoperands.checkIsAddress(verification, block, load.address, "weak.load");
    if (!primitives.isOptionalType(load.type)) {
        verification.report("{block.label()}: weak.load %{load.result} produces "
            + "{types.display(load.type)}, but the object it watched may be gone, so its result "
            + "must be optional");
    }
}

public checkWeakRelease(VerificationContext verification, EirBlock block,
                        EirWeakRelease release) {
    verifyoperands.checkOperand(verification, block, release.address);
    verifyoperands.checkIsAddress(verification, block, release.address, "weak.release");
}
