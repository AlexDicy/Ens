// The string instructions, the conversions that produce a string from another value, and the two
// instructions that write a string out.
import EirBlock from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirStringCompare from eir.model;
import EirStringIndexOf from eir.model;
import EirStringHasAffix from eir.model;
import EirStringTrim from eir.model;
import EirStringSubstring from eir.model;
import EirStringLength from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirIntToString from eir.model;
import EirCharToString from eir.model;
import EirBoolToString from eir.model;
import EirEnumToString from eir.model;
import EirDoubleToString from eir.model;
import EirJsonEscape from eir.model;
import EirPanic from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import @ens.sema.model.types;
import support.primitives;

public checkStringConcat(VerificationContext verification, EirBlock block, EirStringConcat concat) {
    verifyoperands.checkResultType(verification, block, concat.result, concat.type);
    verifyoperands.checkOperand(verification, block, concat.left);
    verifyoperands.checkOperand(verification, block, concat.right);
    verifyoperands.checkStringOperand(verification, block, concat.left, "str.concat");
    verifyoperands.checkStringOperand(verification, block, concat.right, "str.concat");
    verifyoperands.checkStringResult(verification, block, concat.result, concat.type,
        "str.concat");
}

public checkStringEqual(VerificationContext verification, EirBlock block, EirStringEqual equal) {
    verifyoperands.checkResultType(verification, block, equal.result, equal.type);
    verifyoperands.checkOperand(verification, block, equal.left);
    verifyoperands.checkOperand(verification, block, equal.right);
    verifyoperands.checkStringOperand(verification, block, equal.left, "str.eq");
    verifyoperands.checkStringOperand(verification, block, equal.right, "str.eq");
    if (!primitives.isBoolType(equal.type)) {
        verification.report("{block.label()}: str.eq %{equal.result} must produce bool, got "
            + "{types.display(equal.type)}");
    }
}

public checkStringCompare(VerificationContext verification, EirBlock block, EirStringCompare order) {
    verifyoperands.checkResultType(verification, block, order.result, order.type);
    verifyoperands.checkOperand(verification, block, order.left);
    verifyoperands.checkOperand(verification, block, order.right);
    verifyoperands.checkStringOperand(verification, block, order.left, "str.compare");
    verifyoperands.checkStringOperand(verification, block, order.right, "str.compare");
    verifyoperands.checkIntResult(verification, block, order.result, order.type, "str.compare");
}

public checkStringIndexOf(VerificationContext verification, EirBlock block, EirStringIndexOf search) {
    verifyoperands.checkResultType(verification, block, search.result, search.type);
    verifyoperands.checkOperand(verification, block, search.haystack);
    verifyoperands.checkOperand(verification, block, search.needle);
    verifyoperands.checkStringOperand(verification, block, search.haystack, "str.indexof");
    verifyoperands.checkStringOperand(verification, block, search.needle, "str.indexof");
    verifyoperands.checkLongResult(verification, block, search.result, search.type,
        "str.indexof");
}

public checkStringHasAffix(VerificationContext verification, EirBlock block, EirStringHasAffix affix) {
    string operation = "str.startswith";
    if (affix.atEnd) {
        operation = "str.endswith";
    }
    verifyoperands.checkResultType(verification, block, affix.result, affix.type);
    verifyoperands.checkOperand(verification, block, affix.value);
    verifyoperands.checkOperand(verification, block, affix.part);
    verifyoperands.checkStringOperand(verification, block, affix.value, operation);
    verifyoperands.checkStringOperand(verification, block, affix.part, operation);
    if (!primitives.isBoolType(affix.type)) {
        verification.report("{block.label()}: {operation} %{affix.result} must produce bool, got "
            + "{types.display(affix.type)}");
    }
}

public checkStringTrim(VerificationContext verification, EirBlock block, EirStringTrim trimmed) {
    string operation = "str.trimstart";
    if (trimmed.trailing) {
        operation = "str.trim";
    }
    verifyoperands.checkResultType(verification, block, trimmed.result, trimmed.type);
    verifyoperands.checkOperand(verification, block, trimmed.value);
    verifyoperands.checkStringOperand(verification, block, trimmed.value, operation);
    verifyoperands.checkStringResult(verification, block, trimmed.result, trimmed.type, operation);
}

public checkStringSubstring(VerificationContext verification, EirBlock block, EirStringSubstring substring) {
    verifyoperands.checkResultType(verification, block, substring.result, substring.type);
    verifyoperands.checkOperand(verification, block, substring.value);
    verifyoperands.checkOperand(verification, block, substring.start);
    verifyoperands.checkOperand(verification, block, substring.end);
    verifyoperands.checkStringOperand(verification, block, substring.value, "str.substr");
    verifyoperands.checkIntegerOperand(verification, block, substring.start,
        "a substring start");
    verifyoperands.checkIntegerOperand(verification, block, substring.end, "a substring end");
    verifyoperands.checkStringResult(verification, block, substring.result, substring.type,
        "str.substr");
}

public checkStringLength(VerificationContext verification, EirBlock block, EirStringLength length) {
    verifyoperands.checkResultType(verification, block, length.result, length.type);
    verifyoperands.checkOperand(verification, block, length.value);
    verifyoperands.checkStringOperand(verification, block, length.value, "str.len");
    verifyoperands.checkLongResult(verification, block, length.result, length.type, "str.len");
}

public checkStringToBytes(VerificationContext verification, EirBlock block, EirStringToBytes bytes) {
    verifyoperands.checkResultType(verification, block, bytes.result, bytes.type);
    verifyoperands.checkOperand(verification, block, bytes.value);
    verifyoperands.checkStringOperand(verification, block, bytes.value, "str.bytes");
    if (!primitives.isArrayType(bytes.type)) {
        verification.report("{block.label()}: str.bytes %{bytes.result} must produce an "
            + "array, got {types.display(bytes.type)}");
    }
}

public checkStringFromBytes(VerificationContext verification, EirBlock block, EirStringFromBytes text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.bytes);
    verifyoperands.checkArrayOperand(verification, block, text.bytes, "bytes.str");
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "bytes.str");
}

public checkIntToString(VerificationContext verification, EirBlock block, EirIntToString text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.value);
    verifyoperands.checkIntegerOperand(verification, block, text.value, "an int.str operand");
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "int.str");
}

public checkCharToString(VerificationContext verification, EirBlock block, EirCharToString text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.value);
    verifyoperands.checkIntegerOperand(verification, block, text.value, "a char.str operand");
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "char.str");
}

public checkBoolToString(VerificationContext verification, EirBlock block, EirBoolToString text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.value);
    if (verification.validTemp(text.value)
            && !primitives.isBoolType(verification.typeOf(text.value))) {
        verification.report("{block.label()}: bool.str takes bool, got "
            + "{types.display(verification.typeOf(text.value))}");
    }
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "bool.str");
}

public checkEnumToString(VerificationContext verification, EirBlock block, EirEnumToString text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.value);
    verifyoperands.checkIntegerOperand(verification, block, text.value, "an enum.str operand");
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "enum.str");
    if (!primitives.isEnumType(text.enumType)) {
        verification.report("{block.label()}: enum.str %{text.result} names "
            + "{types.display(text.enumType)}, which is not an enum");
    }
}

public checkDoubleToString(VerificationContext verification, EirBlock block, EirDoubleToString text) {
    verifyoperands.checkResultType(verification, block, text.result, text.type);
    verifyoperands.checkOperand(verification, block, text.value);
    if (verification.validTemp(text.value)
            && !primitives.isFloatType(verification.typeOf(text.value))) {
        verification.report("{block.label()}: double.str takes a floating-point value, got "
            + "{types.display(verification.typeOf(text.value))}");
    }
    verifyoperands.checkStringResult(verification, block, text.result, text.type, "double.str");
}

public checkJsonEscape(VerificationContext verification, EirBlock block, EirJsonEscape escaped) {
    verifyoperands.checkResultType(verification, block, escaped.result, escaped.type);
    verifyoperands.checkOperand(verification, block, escaped.value);
    verifyoperands.checkStringOperand(verification, block, escaped.value, "json.escape");
    verifyoperands.checkStringResult(verification, block, escaped.result, escaped.type,
        "json.escape");
}

public checkPanic(VerificationContext verification, EirBlock block, EirPanic panicked) {
    verifyoperands.checkOperand(verification, block, panicked.value);
    verifyoperands.checkStringOperand(verification, block, panicked.value, "panic");
}
