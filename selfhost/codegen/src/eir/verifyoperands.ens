// The operand and result checks every instruction area shares: that a temp belongs to this
// function, that it holds a value or an address as its instruction requires, that it may give up
// or take on a reference, and that the type it carries is the one the instruction works on.
import EirBlock from eir.model;
import PlaceRoot from eir.place;
import eir.place;
import VerificationContext from eir.verifycontext;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import support.primitives;

public checkOperand(VerificationContext verification, EirBlock block, long temp) {
    if (!verification.validTemp(temp)) {
        verification.report("{block.label()}: use of invalid temp %{temp}");
    }
}

public checkResultType(VerificationContext verification, EirBlock block, long result, Type type) {
    if (!verification.validTemp(result)) {
        verification.report("{block.label()}: definition of invalid temp %{result}");
        return;
    }
    if (verification.typeOf(result) != type) {
        verification.report("{block.label()}: %{result} is recorded as "
            + "{types.display(verification.typeOf(result))} but its "
            + "instruction produces {types.display(type)}");
    }
}

public checkIsAddress(VerificationContext verification, EirBlock block, long temp, string what) {
    if (verification.validTemp(temp) && !verification.isAddress(temp)) {
        verification.report("{block.label()}: {what} takes an address but %{temp} is a value");
    }
}

// Addresses may travel into a call, which is how a method reaches its receiver and how an 'out'
// argument works, but they may never be written into storage: no slot holds an address and no
// address is stored through another address. Without this rule the walk from an address back to
// the place it names would not terminate at a known root.
public checkNotAddress(VerificationContext verification, EirBlock block, long temp, string what) {
    if (verification.isAddress(temp)) {
        verification.report("{block.label()}: {what} stores the address %{temp}; addresses may "
            + "be passed to a call but never stored");
    }
}

// The place an address names decides whether releasing through it is allowed: a borrowing slot
// holds a reference this function never owned, so releasing it would take away somebody else's.
public checkNotBorrowedStorage(VerificationContext verification, EirBlock block, long address) {
    if (!verification.isAddress(address)) {
        return;
    }
    let named = place.placeOf(verification.function(), address);
    if (named == null || named.root() != PlaceRoot.Slot) {
        return;
    }
    let slot = verification.slots().get(named.rootId());
    if (slot.borrows() && named.steps().length() == 0) {
        verification.report("{block.label()}: releasing ${named.rootId()} '{slot.name()}', "
            + "which borrows a reference this function does not own");
    }
}

// Only a reference-typed value temp can carry the +1 retain and release move.
public checkOwnable(VerificationContext verification, EirBlock block, long temp, string what) {
    if (!verification.validTemp(temp)) {
        return;
    }
    if (verification.isAddress(temp)) {
        verification.report("{block.label()}: {what} takes a value but %{temp} is an address");
        return;
    }
    if (!primitives.isReferenceType(verification.typeOf(temp))) {
        verification.report("{block.label()}: {what} of %{temp}, which holds "
            + "{types.display(verification.typeOf(temp))} and owns no reference");
    }
}

public checkStringOperand(VerificationContext verification, EirBlock block, long temp, string what) {
    if (verification.validTemp(temp) && primitives.stringOf(verification.typeOf(temp)) == null) {
        verification.report("{block.label()}: {what} takes a string, got "
            + "{types.display(verification.typeOf(temp))}");
    }
}

public checkArrayOperand(VerificationContext verification, EirBlock block, long temp, string what) {
    if (verification.validTemp(temp) && primitives.arrayOf(verification.typeOf(temp)) == null) {
        verification.report("{block.label()}: {what} takes an array, got "
            + "{types.display(verification.typeOf(temp))}");
    }
}

public checkIntegerOperand(VerificationContext verification, EirBlock block, long temp, string what) {
    if (verification.validTemp(temp) && !primitives.isIntegerLike(verification.typeOf(temp))) {
        verification.report("{block.label()}: {what} must be an integer, got "
            + "{types.display(verification.typeOf(temp))}");
    }
}

public checkStringResult(VerificationContext verification, EirBlock block, long result,
                         Type type, string what) {
    if (!primitives.isStringType(type)) {
        verification.report("{block.label()}: {what} %{result} must produce a string, got "
            + "{types.display(type)}");
    }
}

public checkIntResult(VerificationContext verification, EirBlock block, long result, Type type, string what) {
    if (primitives.bitWidth(type) != 32 || !primitives.isIntegerType(type)) {
        verification.report("{block.label()}: {what} %{result} must produce an int, got "
            + "{types.display(type)}");
    }
}

public checkLongResult(VerificationContext verification, EirBlock block, long result, Type type,
                       string what) {
    if (primitives.bitWidth(type) != 64 || !primitives.isIntegerType(type)) {
        verification.report("{block.label()}: {what} %{result} must produce a long, got "
            + "{types.display(type)}");
    }
}
