// The tagged-optional instructions. A tagged optional is an optional over a value type - a
// reference optional is the plain pointer and must never reach these - and every projection has
// to agree with the payload type, or emission would read the pair at the wrong shape.
import EirAbsentOptional from eir.model;
import EirBlock from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirWrapOptional from eir.model;
import OptionalType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import support.primitives;

// The payload type when the type is a tagged optional, or null for everything else.
taggedPayloadOf(Type type) -> Type? {
    return primitives.taggedPayloadOf(type);
}

public checkWrapOptional(VerificationContext verification, EirBlock block,
                         EirWrapOptional wrapped) {
    verifyoperands.checkResultType(verification, block, wrapped.result, wrapped.type);
    verifyoperands.checkOperand(verification, block, wrapped.value);
    verifyoperands.checkNotAddress(verification, block, wrapped.value,
        "the value of opt.wrap");
    let payload = taggedPayloadOf(wrapped.type);
    if (payload == null) {
        verification.report("{block.label()}: opt.wrap %{wrapped.result} must produce a "
            + "tagged optional, got {types.display(wrapped.type)}");
        return;
    }
    if (verification.validTemp(wrapped.value)
            && verification.typeOf(wrapped.value) != payload) {
        verification.report("{block.label()}: opt.wrap %{wrapped.result} wraps a "
            + "{types.display(verification.typeOf(wrapped.value))} into "
            + "{types.display(wrapped.type)}");
    }
}

public checkAbsentOptional(VerificationContext verification, EirBlock block,
                           EirAbsentOptional absent) {
    verifyoperands.checkResultType(verification, block, absent.result, absent.type);
    if (taggedPayloadOf(absent.type) == null) {
        verification.report("{block.label()}: opt.absent %{absent.result} must produce a "
            + "tagged optional, got {types.display(absent.type)}");
    }
}

public checkOptionalPresence(VerificationContext verification, EirBlock block,
                             EirOptionalPresence presence) {
    verifyoperands.checkResultType(verification, block, presence.result, presence.type);
    verifyoperands.checkOperand(verification, block, presence.value);
    verifyoperands.checkNotAddress(verification, block, presence.value,
        "the value of opt.present");
    if (!primitives.isBoolType(presence.type)) {
        verification.report("{block.label()}: opt.present %{presence.result} must produce "
            + "bool, got {types.display(presence.type)}");
    }
    if (verification.validTemp(presence.value)
            && taggedPayloadOf(verification.typeOf(presence.value)) == null) {
        verification.report("{block.label()}: opt.present %{presence.result} reads the tag of "
            + "{types.display(verification.typeOf(presence.value))}, which is not a tagged "
            + "optional");
    }
}

public checkOptionalPayload(VerificationContext verification, EirBlock block,
                            EirOptionalPayload payload) {
    verifyoperands.checkResultType(verification, block, payload.result, payload.type);
    verifyoperands.checkOperand(verification, block, payload.value);
    verifyoperands.checkNotAddress(verification, block, payload.value,
        "the value of opt.payload");
    if (!verification.validTemp(payload.value)) {
        return;
    }
    let inner = taggedPayloadOf(verification.typeOf(payload.value));
    if (inner == null) {
        verification.report("{block.label()}: opt.payload %{payload.result} reads the payload "
            + "of {types.display(verification.typeOf(payload.value))}, which is not a tagged "
            + "optional");
    } else if (inner != payload.type) {
        verification.report("{block.label()}: opt.payload %{payload.result} is typed "
            + "{types.display(payload.type)} but the payload holds {types.display(inner)}");
    }
}

public checkOptionalPayloadAddress(VerificationContext verification, EirBlock block,
                                   EirOptionalPayloadAddress payloadAddress) {
    verifyoperands.checkResultType(verification, block, payloadAddress.result,
        payloadAddress.type);
    verifyoperands.checkOperand(verification, block, payloadAddress.base);
    verifyoperands.checkIsAddress(verification, block, payloadAddress.base,
        "the base of opt.payload_addr");
    if (!verification.validTemp(payloadAddress.base)) {
        return;
    }
    let inner = taggedPayloadOf(verification.typeOf(payloadAddress.base));
    if (inner == null) {
        verification.report("{block.label()}: opt.payload_addr %{payloadAddress.result} "
            + "reaches into {types.display(verification.typeOf(payloadAddress.base))}, which "
            + "is not a tagged optional");
    } else if (inner != payloadAddress.type) {
        verification.report("{block.label()}: opt.payload_addr %{payloadAddress.result} is "
            + "typed {types.display(payloadAddress.type)} but the payload holds "
            + "{types.display(inner)}");
    }
}
