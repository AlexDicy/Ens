// The instructions that produce a value out of constants and other values: the typed constants,
// the binary and unary operations, and the primitive conversions.
import EirBlock from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirConstString from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import @ens.sema.model.types;
import support.primitives;

public checkConstInt(VerificationContext verification, EirBlock block, EirConstInt constant) {
    verifyoperands.checkResultType(verification, block, constant.result, constant.type);
    if (!primitives.isIntegerLike(constant.type)) {
        verification.report("{block.label()}: const %{constant.result} has non-integer "
            + "type {types.display(constant.type)}");
    }
}

public checkConstFloat(VerificationContext verification, EirBlock block,
                       EirConstFloat constant) {
    verifyoperands.checkResultType(verification, block, constant.result, constant.type);
    if (!primitives.isFloatType(constant.type)) {
        verification.report("{block.label()}: const %{constant.result} has non-float "
            + "type {types.display(constant.type)}");
    }
}

public checkConstBool(VerificationContext verification, EirBlock block, EirConstBool constant) {
    verifyoperands.checkResultType(verification, block, constant.result, constant.type);
    if (!primitives.isBoolType(constant.type)) {
        verification.report("{block.label()}: const %{constant.result} has non-bool "
            + "type {types.display(constant.type)}");
    }
}

public checkConstString(VerificationContext verification, EirBlock block,
                        EirConstString constant) {
    verifyoperands.checkResultType(verification, block, constant.result, constant.type);
    if (!primitives.isStringType(constant.type)) {
        verification.report("{block.label()}: string const %{constant.result} has type "
            + "{types.display(constant.type)}");
    }
}

public checkBinary(VerificationContext verification, EirBlock block, EirBinary binary) {
    verifyoperands.checkResultType(verification, block, binary.result, binary.type);
    verifyoperands.checkOperand(verification, block, binary.left);
    verifyoperands.checkOperand(verification, block, binary.right);
    if (verification.validTemp(binary.left) && verification.validTemp(binary.right)) {
        let leftType = verification.typeOf(binary.left);
        let rightType = verification.typeOf(binary.right);
        if (leftType != rightType) {
            verification.report("{block.label()}: %{binary.result} combines operands of "
                + "different types {types.display(leftType)} and "
                + "{types.display(rightType)}");
        } else if (model.isComparison(binary.op)) {
            if (!primitives.isBoolType(binary.type)) {
                verification.report("{block.label()}: comparison %{binary.result} must "
                    + "produce bool, got {types.display(binary.type)}");
            }
        } else if (leftType != binary.type) {
            verification.report("{block.label()}: %{binary.result} of type "
                + "{types.display(binary.type)} disagrees with its operands of "
                + "type {types.display(leftType)}");
        }
    }
}

public checkUnary(VerificationContext verification, EirBlock block, EirUnary unary) {
    verifyoperands.checkResultType(verification, block, unary.result, unary.type);
    verifyoperands.checkOperand(verification, block, unary.operand);
    if (verification.validTemp(unary.operand)
            && verification.typeOf(unary.operand) != unary.type) {
        verification.report("{block.label()}: %{unary.result} of type "
            + "{types.display(unary.type)} disagrees with its operand");
    }
}

public checkCast(VerificationContext verification, EirBlock block, EirCast cast) {
    verifyoperands.checkResultType(verification, block, cast.result, cast.type);
    verifyoperands.checkOperand(verification, block, cast.operand);
}
