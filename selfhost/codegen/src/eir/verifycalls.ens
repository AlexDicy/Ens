// The call instruction: its result type follows the callee's return type, a method call passes
// its receiver by address, and every argument matches the parameter it fills.
import EirBlock from eir.model;
import EirCall from eir.model;
import VerificationContext from eir.verifycontext;
import eir.verifyoperands;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;

public checkCall(VerificationContext verification, EirBlock block, EirCall call) {
    if (call.result >= 0) {
        verifyoperands.checkResultType(verification, block, call.result, call.type);
        if (call.type != call.callee.returnType()) {
            verification.report("{block.label()}: call result type "
                + "{types.display(call.type)} disagrees with callee "
                + "@{call.callee.symbol()} returning "
                + "{types.display(call.callee.returnType())}");
        }
    }
    let receiverType = call.callee.receiverType();
    if (receiverType != null) {
        if (call.receiver < 0) {
            verification.report("{block.label()}: call to @{call.callee.symbol()} passes no "
                + "receiver but the callee is a method on "
                + "{types.display(receiverType)}");
        } else {
            verifyoperands.checkOperand(verification, block, call.receiver);
            verifyoperands.checkIsAddress(verification, block, call.receiver,
                "the receiver of @{call.callee.symbol()}");
        }
    } else if (call.receiver >= 0) {
        verification.report("{block.label()}: call to @{call.callee.symbol()} passes a "
            + "receiver but the callee takes none");
    }
    Type[] parameterTypes = call.callee.parameterTypes();
    if (call.arguments.length != parameterTypes.length) {
        verification.report("{block.label()}: call to @{call.callee.symbol()} passes "
            + "{call.arguments.length} argument(s) for "
            + "{parameterTypes.length} parameter(s)");
        return;
    }
    for (long i = 0; i < call.arguments.length; i++) {
        verifyoperands.checkOperand(verification, block, call.arguments[i]);
        if (verification.validTemp(call.arguments[i])
                && verification.typeOf(call.arguments[i]) != parameterTypes[i]) {
            verification.report("{block.label()}: argument {i + 1} of "
                + "@{call.callee.symbol()} has type "
                + "{types.display(verification.typeOf(call.arguments[i]))} "
                + "but the parameter takes "
                + "{types.display(parameterTypes[i])}");
        }
    }
}
