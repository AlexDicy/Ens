// Instruction and terminator walks shared by the verifiers and the place model: which temp an
// instruction defines, which temps it reads, and where a block can go next.
import EirInstruction from eir.model;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirBinary from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirCall from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirSlotAddress from eir.model;
import EirFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import EirTypeTest from eir.model;
import EirCheckedCast from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirRuntimeTypeName from eir.model;
import EirConstString from eir.model;
import EirConstNull from eir.model;
import EirClassNew from eir.model;
import EirClosureNew from eir.model;
import EirClosureCapture from eir.model;
import EirClosureCall from eir.model;
import EirObjectFieldAddress from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import EirArrayNew from eir.model;
import EirArrayLength from eir.model;
import EirArraySlice from eir.model;
import EirAbsentOptional from eir.model;
import EirHashValue from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirStringCompare from eir.model;
import EirWrapOptional from eir.model;
import EirStringIndexOf from eir.model;
import EirStringHasAffix from eir.model;
import EirStringTrim from eir.model;
import EirStringSubstring from eir.model;
import EirStringLength from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirIntToString from eir.model;
import EirCharToString from eir.model;
import EirBoolToString from eir.model;
import EirEnumToString from eir.model;
import EirDoubleToString from eir.model;
import EirJsonEscape from eir.model;
import EirPrint from eir.model;
import EirPanic from eir.model;
import EirCaptureTrace from eir.model;
import EirErrorTrace from eir.model;
import EirForeignCall from eir.model;
import EirCStringLift from eir.model;
import EirTerminator from eir.model;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import EirTryCall from eir.model;
import EirPropagate from eir.model;
import EirBlock from eir.model;
import List from @std.collections.list;

// The temp an instruction defines, or -1 when it defines none.
export resultOf(EirInstruction instruction) -> long {
    switch (instruction) {
        is EirConstInt constant -> {
            return constant.result;
        },
        is EirConstFloat constant -> {
            return constant.result;
        },
        is EirConstBool constant -> {
            return constant.result;
        },
        is EirConstString constant -> {
            return constant.result;
        },
        is EirConstNull constant -> {
            return constant.result;
        },
        is EirClassNew allocation -> {
            return allocation.result;
        },
        is EirObjectFieldAddress address -> {
            return address.result;
        },
        is EirWeakLoad load -> {
            return load.result;
        },
        is EirBinary binary -> {
            return binary.result;
        },
        is EirUnary unary -> {
            return unary.result;
        },
        is EirCast cast -> {
            return cast.result;
        },
        is EirLoadSlot load -> {
            return load.result;
        },
        is EirTakeSlot taken -> {
            return taken.result;
        },
        is EirCall call -> {
            return call.result;
        },
        is EirClosureNew closure -> {
            return closure.result;
        },
        is EirClosureCapture capture -> {
            return capture.result;
        },
        is EirClosureCall call -> {
            return call.result;
        },
        is EirSlotAddress address -> {
            return address.result;
        },
        is EirFieldAddress address -> {
            return address.result;
        },
        is EirElementAddress address -> {
            return address.result;
        },
        is EirLoadPtr load -> {
            return load.result;
        },
        is EirTypeTest test -> {
            return test.result;
        },
        is EirCheckedCast cast -> {
            return cast.result;
        },
        is EirDynamicEquals equal -> {
            return equal.result;
        },
        is EirDynamicHash hashed -> {
            return hashed.result;
        },
        is EirDynamicToString text -> {
            return text.result;
        },
        is EirRuntimeTypeName named -> {
            return named.result;
        },
        is EirArrayNew allocation -> {
            return allocation.result;
        },
        is EirArrayLength length -> {
            return length.result;
        },
        is EirArraySlice sliced -> {
            return sliced.result;
        },
        is EirStringConcat concat -> {
            return concat.result;
        },
        is EirStringEqual equal -> {
            return equal.result;
        },
        is EirStringCompare order -> {
            return order.result;
        },
        is EirHashValue hashed -> {
            return hashed.result;
        },
        is EirWrapOptional wrapped -> {
            return wrapped.result;
        },
        is EirAbsentOptional absent -> {
            return absent.result;
        },
        is EirOptionalPresence presence -> {
            return presence.result;
        },
        is EirOptionalPayload payload -> {
            return payload.result;
        },
        is EirOptionalPayloadAddress payloadAddress -> {
            return payloadAddress.result;
        },
        is EirStringIndexOf search -> {
            return search.result;
        },
        is EirStringHasAffix affix -> {
            return affix.result;
        },
        is EirStringTrim trimmed -> {
            return trimmed.result;
        },
        is EirStringSubstring substring -> {
            return substring.result;
        },
        is EirStringLength length -> {
            return length.result;
        },
        is EirStringToBytes bytes -> {
            return bytes.result;
        },
        is EirStringFromBytes text -> {
            return text.result;
        },
        is EirIntToString text -> {
            return text.result;
        },
        is EirCharToString text -> {
            return text.result;
        },
        is EirBoolToString text -> {
            return text.result;
        },
        is EirEnumToString text -> {
            return text.result;
        },
        is EirDoubleToString text -> {
            return text.result;
        },
        is EirJsonEscape escaped -> {
            return escaped.result;
        },
        is EirErrorTrace trace -> {
            return trace.result;
        },
        is EirForeignCall call -> {
            return call.result;
        },
        is EirCStringLift lifted -> {
            return lifted.result;
        },
        default -> {
            return -1;
        },
    }
}

// The temps an instruction reads.
export usesOf(EirInstruction instruction) -> long[] {
    switch (instruction) {
        is EirBinary binary -> {
            return [binary.left, binary.right];
        },
        is EirUnary unary -> {
            return [unary.operand];
        },
        is EirCast cast -> {
            return [cast.operand];
        },
        is EirStoreSlot store -> {
            return [store.value];
        },
        is EirCall call -> {
            let used = new List<long>();
            if (call.receiver >= 0) {
                used.push(call.receiver);
            }
            for (let argument in call.arguments) {
                used.push(argument);
            }
            return used.toArray();
        },
        is EirClosureCapture capture -> {
            return [capture.closure];
        },
        is EirClosureCall call -> {
            let used = new List<long>();
            used.push(call.closure);
            for (let argument in call.arguments) {
                used.push(argument);
            }
            return used.toArray();
        },
        is EirRetain retain -> {
            return [retain.value];
        },
        is EirRelease release -> {
            return [release.value];
        },
        is EirRetainPtr retain -> {
            return [retain.address];
        },
        is EirReleasePtr release -> {
            return [release.address];
        },
        is EirFieldAddress address -> {
            return [address.base];
        },
        is EirObjectFieldAddress address -> {
            return [address.object];
        },
        is EirWeakStore store -> {
            return [store.address, store.value];
        },
        is EirWeakLoad load -> {
            return [load.address];
        },
        is EirWeakRelease release -> {
            return [release.address];
        },
        is EirElementAddress address -> {
            return [address.array, address.index];
        },
        is EirLoadPtr load -> {
            return [load.address];
        },
        is EirStorePtr store -> {
            return [store.address, store.value];
        },
        is EirBoundsCheck check -> {
            return [check.array, check.index];
        },
        is EirRangeCheck check -> {
            return [check.start, check.end, check.length];
        },
        is EirTypeTest test -> {
            return [test.value];
        },
        is EirCheckedCast cast -> {
            return [cast.value];
        },
        is EirDynamicEquals equal -> {
            return [equal.left, equal.right];
        },
        is EirDynamicHash hashed -> {
            return [hashed.value];
        },
        is EirDynamicToString text -> {
            return [text.value];
        },
        is EirRuntimeTypeName named -> {
            return [named.value];
        },
        is EirArrayNew allocation -> {
            return [allocation.size];
        },
        is EirArrayLength length -> {
            return [length.array];
        },
        is EirArraySlice sliced -> {
            return [sliced.array, sliced.start, sliced.end];
        },
        is EirStringConcat concat -> {
            return [concat.left, concat.right];
        },
        is EirStringEqual equal -> {
            return [equal.left, equal.right];
        },
        is EirStringCompare order -> {
            return [order.left, order.right];
        },
        is EirHashValue hashed -> {
            return [hashed.value];
        },
        is EirWrapOptional wrapped -> {
            return [wrapped.value];
        },
        is EirAbsentOptional absent -> {
            return [];
        },
        is EirOptionalPresence presence -> {
            return [presence.value];
        },
        is EirOptionalPayload payload -> {
            return [payload.value];
        },
        is EirOptionalPayloadAddress payloadAddress -> {
            return [payloadAddress.base];
        },
        is EirStringIndexOf search -> {
            return [search.haystack, search.needle];
        },
        is EirStringHasAffix affix -> {
            return [affix.value, affix.part];
        },
        is EirStringTrim trimmed -> {
            return [trimmed.value];
        },
        is EirStringSubstring substring -> {
            return [substring.value, substring.start, substring.end];
        },
        is EirStringLength length -> {
            return [length.value];
        },
        is EirStringToBytes bytes -> {
            return [bytes.value];
        },
        is EirStringFromBytes text -> {
            return [text.bytes];
        },
        is EirIntToString text -> {
            return [text.value];
        },
        is EirCharToString text -> {
            return [text.value];
        },
        is EirBoolToString text -> {
            return [text.value];
        },
        is EirEnumToString text -> {
            return [text.value];
        },
        is EirDoubleToString text -> {
            return [text.value];
        },
        is EirJsonEscape escaped -> {
            return [escaped.value];
        },
        is EirPrint printed -> {
            return [printed.value];
        },
        is EirPanic panicked -> {
            return [panicked.value];
        },
        is EirCaptureTrace captured -> {
            return [captured.error];
        },
        is EirErrorTrace trace -> {
            return [trace.error];
        },
        is EirForeignCall call -> {
            return call.arguments;
        },
        is EirCStringLift lifted -> {
            return [lifted.handle];
        },
        default -> {
            return [];
        },
    }
}

export terminatorUsesOf(EirTerminator terminator) -> long[] {
    switch (terminator) {
        is EirReturn returned -> {
            if (returned.value < 0) {
                return [];
            }
            return [returned.value];
        },
        is EirJump ignored -> {
            return [];
        },
        is EirBranch branch -> {
            return [branch.condition];
        },
        is EirSwitch switched -> {
            return [switched.value];
        },
        is EirUnreachable ignored -> {
            return [];
        },
        is EirTryCall call -> {
            let used = new List<long>();
            if (call.receiver >= 0) {
                used.push(call.receiver);
            }
            for (let argument in call.arguments) {
                used.push(argument);
            }
            return used.toArray();
        },
        is EirPropagate propagated -> {
            return [propagated.error];
        },
    }
}

export successorsOf(EirBlock block) -> long[] {
    let terminator = block.terminator();
    if (terminator == null) {
        return [];
    }
    return successorsOfTerminator(terminator);
}

export successorsOfTerminator(EirTerminator terminator) -> long[] {
    switch (terminator) {
        is EirReturn ignored -> {
            return [];
        },
        is EirJump jump -> {
            return [jump.target];
        },
        is EirBranch branch -> {
            return [branch.thenTarget, branch.elseTarget];
        },
        is EirSwitch switched -> {
            let successors = new List<long>();
            for (let target in switched.caseTargets) {
                successors.push(target);
            }
            successors.push(switched.defaultTarget);
            return successors.toArray();
        },
        is EirUnreachable ignored -> {
            return [];
        },
        is EirTryCall call -> {
            return [call.normalTarget, call.unwindTarget];
        },
        is EirPropagate ignored -> {
            return [];
        },
    }
}

// Every temp a terminator defines on any edge, for the single-assignment check.
export terminatorResultsOf(EirTerminator terminator) -> long[] {
    switch (terminator) {
        is EirTryCall call -> {
            if (call.result < 0) {
                return [call.errorResult];
            }
            return [call.result, call.errorResult];
        },
        default -> {
            return [];
        },
    }
}

// The temps a terminator defines along its edge to one successor block: a try call's result
// exists only where the call returned normally, and its error only where it unwound. A block
// reached both ways sees neither, matching the intersection the definite-definition pass takes.
export terminatorDefsFor(EirTerminator terminator, long successor) -> long[] {
    switch (terminator) {
        is EirTryCall call -> {
            let defined = new List<long>();
            if (successor == call.normalTarget && call.result >= 0
                    && successor != call.unwindTarget) {
                defined.push(call.result);
            }
            if (successor == call.unwindTarget && successor != call.normalTarget) {
                defined.push(call.errorResult);
            }
            return defined.toArray();
        },
        default -> {
            return [];
        },
    }
}

// True when the instruction's result is an address rather than a value.
export producesAddress(EirInstruction instruction) -> bool {
    switch (instruction) {
        is EirSlotAddress ignored -> {
            return true;
        },
        is EirFieldAddress ignored -> {
            return true;
        },
        is EirObjectFieldAddress ignored -> {
            return true;
        },
        is EirClosureCapture ignored -> {
            return true;
        },
        is EirElementAddress ignored -> {
            return true;
        },
        is EirOptionalPayloadAddress ignored -> {
            return true;
        },
        default -> {
            return false;
        },
    }
}
