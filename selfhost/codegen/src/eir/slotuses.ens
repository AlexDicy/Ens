// What still reads what a slot holds, at the point its reference moves out of it. Every value read
// out of an owning slot borrows its one +1, and so does every interior address reached through
// such a value, so moving that +1 out is safe only past the last use of all of them.
import EirFunction from eir.model;
import EirInstruction from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirSlotAddress from eir.model;
import EirReleasePtr from eir.model;
import eir.ownership;
import eir.walk;
import support.primitives;
import List from @std.collections.list;

// One slot's picture around one move: the temps that borrow what it holds there, the addresses of
// it, and what reads it. Computed fresh from the function it describes and never shared beyond
// the call that requested it.
public final class SlotUses {
    EirFunction function;
    long slot;
    long block;
    long index;

    bool[] borrowing;
    bool[] addresses;
    SlotReads reads;

    protected constructor(this.function, this.slot, this.block, this.index, this.borrowing,
                this.addresses, this.reads);

    // True when what the slot holds is still needed at or after the move: either the slot is read
    // again, or a reference already borrowed out of it is still in use. Releasing the slot's own
    // storage is not a read, and neither is a read at a point that cannot run before the move.
    public contentsNeeded() -> bool {
        return this.readAgain() || this.borrowStillUsed() >= 0;
    }

    // Whether the slot itself is read again from the move on, on some path, before anything writes
    // it again.
    public readAgain() -> bool {
        return this.reads.after(this.function, this.block, this.index);
    }

    // The first temp borrowing what the slot holds that is still used after the move, or -1 when
    // none is. A use counts when some path from the move reaches it without defining the temp
    // again, so a loop that comes back around to a fresh borrow does not count the old one.
    public borrowStillUsed() -> long {
        let tracked = new List<long>();
        long[] position = new long[this.borrowing.length];
        for (long t = 0; t < this.borrowing.length; t++) {
            position[t] = -1;
            if (this.borrowing[t]) {
                position[t] = tracked.length();
                tracked.push(t);
            }
        }
        long width = tracked.length();
        if (width == 0) {
            return -1;
        }
        let blocks = this.function.blocks();
        bool[] liveOut = this.borrowsLiveOut(position, width);
        bool[] defined = new bool[width];
        let instructions = blocks.get(this.block).instructions();
        for (long i = this.index + 1; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            long used = this.borrowUsedBy(instruction, position, defined);
            if (used >= 0) {
                return used;
            }
            markDefined(walk.resultOf(instruction), position, defined);
        }
        let terminator = blocks.get(this.block).terminator();
        if (terminator != null) {
            for (let used in walk.terminatorUsesOf(terminator)) {
                if (this.borrows(used) && !defined[position[used]]) {
                    return used;
                }
            }
        }
        for (long j = 0; j < width; j++) {
            if (liveOut[this.block * width + j] && !defined[j]) {
                return tracked.get(j);
            }
        }
        return -1;
    }

    // Whether the temp holds a reference the slot keeps alive, or an address inside one.
    public borrows(long temp) -> bool {
        return temp >= 0 && temp < this.borrowing.length && this.borrowing[temp];
    }

    // Which borrowing temps are live where each block ends, one row of 'width' per block. A use
    // flows up to the blocks before it until it meets the temp's definition.
    borrowsLiveOut(long[] position, long width) -> bool[] {
        let blocks = this.function.blocks();
        long count = blocks.length();
        bool[] usedFirst = new bool[count * width + 1];
        bool[] definedIn = new bool[count * width + 1];
        for (long b = 0; b < count; b++) {
            bool[] defined = new bool[width];
            for (let instruction in blocks.get(b).instructions()) {
                long used = this.borrowUsedBy(instruction, position, defined);
                if (used >= 0) {
                    usedFirst[b * width + position[used]] = true;
                }
                markDefined(walk.resultOf(instruction), position, defined);
            }
            let terminator = blocks.get(b).terminator();
            if (terminator != null) {
                for (let used in walk.terminatorUsesOf(terminator)) {
                    if (this.borrows(used) && !defined[position[used]]) {
                        usedFirst[b * width + position[used]] = true;
                    }
                }
            }
            for (long j = 0; j < width; j++) {
                definedIn[b * width + j] = defined[j];
            }
        }
        bool[] liveOut = new bool[count * width + 1];
        bool changed = true;
        while (changed) {
            changed = false;
            for (long b = count - 1; b >= 0; b--) {
                for (let successor in walk.successorsOf(blocks.get(b))) {
                    if (successor < 0 || successor >= count) {
                        continue;
                    }
                    for (long j = 0; j < width; j++) {
                        long entry = successor * width + j;
                        bool liveIn = usedFirst[entry] || (liveOut[entry] && !definedIn[entry]);
                        if (liveIn && !liveOut[b * width + j]) {
                            liveOut[b * width + j] = true;
                            changed = true;
                        }
                    }
                }
            }
        }
        return liveOut;
    }

    // The borrowing temp one instruction uses that its own block has not defined by then, or -1.
    // Releasing what the slot's own storage holds is no use of the reference that storage held.
    borrowUsedBy(EirInstruction instruction, long[] position, bool[] defined) -> long {
        if (instruction is EirReleasePtr && this.namesSlot(instruction.address)) {
            return -1;
        }
        for (let used in walk.usesOf(instruction)) {
            if (this.borrows(used) && !defined[position[used]]) {
                return used;
            }
        }
        return -1;
    }

    namesSlot(long temp) -> bool {
        return namedBy(this.addresses, temp);
    }
}

// Marks a borrowing temp as defined, so a later use in the same block reads that definition.
markDefined(long result, long[] position, bool[] defined) {
    if (result >= 0 && result < position.length && position[result] >= 0) {
        defined[position[result]] = true;
    }
}

// One slot's picture around the instruction at `index` in `block` that moves its reference out:
// the load a take is about to replace, or the take itself.
public forMove(EirFunction function, long slot, long block, long index) -> SlotUses {
    bool[] addresses = slotAddresses(function, slot);
    bool[] reaching = blocksReaching(function, block);
    return new SlotUses(function, slot, block, index,
        borrowedTemps(function, slot, block, index, reaching), addresses,
        new SlotReads(slot, addresses, escapingAddresses(function, addresses), false));
}

// Whether the slot is read or released again after the instruction at `index` in `block`, on some
// path, before anything writes it again.
public readOrReleasedAfter(EirFunction function, long slot, long block, long index) -> bool {
    bool[] addresses = slotAddresses(function, slot);
    let reads = new SlotReads(slot, addresses, escapingAddresses(function, addresses), true);
    return reads.after(function, block, index);
}

// The temps holding the address of the slot itself.
slotAddresses(EirFunction function, long slot) -> bool[] {
    bool[] addresses = new bool[function.tempTypes().length() + 1];
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (instruction is EirSlotAddress && instruction.slot == slot
                    && instruction.result >= 0 && instruction.result < addresses.length) {
                addresses[instruction.result] = true;
            }
        }
    }
    return addresses;
}

// The addresses of the slot that outlast the release of what it holds. A release of the
// slot's storage empties it; every other reader of the address reads the reference there,
// terminators included.
escapingAddresses(EirFunction function, bool[] addresses) -> bool[] {
    bool[] escaping = new bool[addresses.length];
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (instruction is EirReleasePtr) {
                continue;
            }
            for (let used in walk.usesOf(instruction)) {
                if (used >= 0 && used < addresses.length && addresses[used]) {
                    escaping[used] = true;
                }
            }
        }
        let terminator = blocks.get(b).terminator();
        if (terminator == null) {
            continue;
        }
        for (let used in walk.terminatorUsesOf(terminator)) {
            if (used >= 0 && used < addresses.length && addresses[used]) {
                escaping[used] = true;
            }
        }
    }
    return escaping;
}

// Every temp that borrows what the slot holds at the move: what a read of the slot that can run
// before the move yields, and what renaming, interior addressing, and reading through such an
// address yield from those in turn. A temp produced owning a +1 of its own - a call's result,
// a fresh string, a weak upgrade - borrows nothing, so the walk stops there.
borrowedTemps(EirFunction function, long slot, long block, long index, bool[] reaching) -> bool[] {
    long count = function.tempTypes().length();
    bool[] borrowing = new bool[count + 1];
    let blocks = function.blocks();
    bool changed = true;
    while (changed) {
        changed = false;
        for (long b = 0; b < blocks.length(); b++) {
            let instructions = blocks.get(b).instructions();
            for (long i = 0; i < instructions.length(); i++) {
                let instruction = instructions.get(i);
                long result = walk.resultOf(instruction);
                if (result < 0 || result >= count || borrowing[result]) {
                    continue;
                }
                bool starts = readsBeforeMove(b, i, block, index, reaching)
                    && startsBorrow(instruction, slot);
                if (!starts && !carriesBorrow(function, instruction, borrowing)) {
                    continue;
                }
                borrowing[result] = true;
                changed = true;
            }
        }
    }
    return borrowing;
}

// Whether the instruction at that position can run before the move: earlier in the move's own
// block, later in it when a path leads back around to it, or in a block a path leads from to the
// move's. The move itself is not one, since what it reads becomes the moved reference.
readsBeforeMove(long b, long i, long block, long index, bool[] reaching) -> bool {
    if (b == block) {
        return i < index || (reaching[block] && i > index);
    }
    return reaching[b];
}

startsBorrow(EirInstruction instruction, long slot) -> bool {
    if (instruction is EirLoadSlot && instruction.slot == slot) {
        return true;
    }
    return instruction is EirSlotAddress && instruction.slot == slot;
}

// True when the instruction passes on a reference, or an address inside one, that it was given
// rather than producing one of its own.
carriesBorrow(EirFunction function, EirInstruction instruction, bool[] borrowing) -> bool {
    if (ownership.producesOwned(instruction)) {
        return false;
    }
    long result = walk.resultOf(instruction);
    if (!walk.producesAddress(instruction) && !primitives.isReferenceType(function.tempTypes().get(result))) {
        return false;
    }
    for (let used in walk.usesOf(instruction)) {
        if (used >= 0 && used < borrowing.length && borrowing[used]) {
            return true;
        }
    }
    return false;
}

// What reads a slot: a load or a take of it, and a use of its address for anything but releasing
// what it holds. When releases count, a release through its address reads it as well.
final class SlotReads {
    long slot;
    bool[] addresses;
    bool[] escaping;
    bool releases;

    protected constructor(this.slot, this.addresses, this.escaping, this.releases);

    // Whether the slot is read again after the instruction at `index` in `block`, on some path,
    // before anything writes it again.
    protected after(EirFunction function, long block, long index) -> bool {
        let instructions = function.blocks().get(block).instructions();
        for (long i = index + 1; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (this.readBy(instruction)) {
                return true;
            }
            if (this.writtenBy(instruction)) {
                return false;
            }
        }
        return this.liveOut(function)[block];
    }

    // Backward liveness of the reads at block exits.
    liveOut(EirFunction function) -> bool[] {
        let blocks = function.blocks();
        long count = blocks.length();
        // 0 none, 1 reads first, 2 writes first
        long[] firstEffect = new long[count + 1];
        for (long b = 0; b < count; b++) {
            for (let instruction in blocks.get(b).instructions()) {
                if (this.readBy(instruction)) {
                    firstEffect[b] = 1;
                    break;
                }
                if (this.writtenBy(instruction)) {
                    firstEffect[b] = 2;
                    break;
                }
            }
        }
        bool[] liveOut = new bool[count + 1];
        bool changed = true;
        while (changed) {
            changed = false;
            for (long b = 0; b < count; b++) {
                bool live = false;
                for (let successor in walk.successorsOf(blocks.get(b))) {
                    if (successor < 0 || successor >= count) {
                        continue;
                    }
                    if (firstEffect[successor] == 1
                            || (firstEffect[successor] == 0 && liveOut[successor])) {
                        live = true;
                    }
                }
                if (live && !liveOut[b]) {
                    liveOut[b] = true;
                    changed = true;
                }
            }
        }
        return liveOut;
    }

    readBy(EirInstruction instruction) -> bool {
        switch (instruction) {
            is EirLoadSlot load -> {
                return load.slot == this.slot;
            },
            is EirTakeSlot taken -> {
                return taken.slot == this.slot;
            },
            is EirSlotAddress address -> {
                return address.slot == this.slot && namedBy(this.escaping, address.result);
            },
            is EirReleasePtr release -> {
                return this.releases && namedBy(this.addresses, release.address);
            },
            default -> {
                return false;
            },
        }
    }

    writtenBy(EirInstruction instruction) -> bool {
        return instruction is EirStoreSlot && instruction.slot == this.slot;
    }
}

namedBy(bool[] temps, long temp) -> bool {
    return temp >= 0 && temp < temps.length && temps[temp];
}

// The blocks a path leads from to this one, itself included only when it lies on a cycle.
blocksReaching(EirFunction function, long block) -> bool[] {
    let blocks = function.blocks();
    long count = blocks.length();
    bool[] reaching = new bool[count + 1];
    bool changed = true;
    while (changed) {
        changed = false;
        for (long b = 0; b < count; b++) {
            if (reaching[b]) {
                continue;
            }
            for (let successor in walk.successorsOf(blocks.get(b))) {
                if (successor == block || (successor >= 0 && successor < count && reaching[successor])) {
                    reaching[b] = true;
                    changed = true;
                }
            }
        }
    }
    return reaching;
}
