// 'frozen()' on a 'List', a 'Map' or a 'Set' of '@std.collections'. The freeze takes a reference of
// its own, so a collection that nothing reads again after the call, a temporary or a variable at its
// last use, becomes the frozen collection's contents, and any other is copied.
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import Method from @ens.sema.model.typemembers;
import @ens.sema.model.typemembers;
import @ens.sema.model.typenames;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirTakeOrCopy from eir.model;
import FunctionInfo from lower.index;
import LoweringContext from lower.context;
import lower.calls;
import lower.expressions;
import lower.ownership;
import lower.places;

public takesStorage(Method method) -> bool {
    if (method.name() != "frozen" || method.signature().parameters().length != 0) {
        return false;
    }
    let owner = types.authorityOf(method.definingType());
    if (owner == null) {
        return false;
    }
    switch (owner.name()) {
        "List" -> {
            return owner.modulePath() == "std.collections.list";
        },
        "Map" -> {
            return owner.modulePath() == "std.collections.map";
        },
        "Set" -> {
            return owner.modulePath() == "std.collections.set";
        },
        default -> {
            return false;
        },
    }
}

// The collection is taken whole when nothing else owns it and copied otherwise, then wrapped by the
// standard library's 'frozenWithoutCopy', which keeps what it is given.
public lowerFrozen(LoweringContext lowering, MemberExpressionNode member, Type classType,
                   Span span) -> long {
    let copy = methodInfo(lowering, classType, "copy", span);
    let wrap = methodInfo(lowering, classType, "frozenWithoutCopy", span);
    if (copy == null || wrap == null) {
        return -1;
    }
    long collection = expressions.lowerConverted(lowering, member.object(), classType);
    if (collection < 0) {
        return -1;
    }
    if (!places.producesOwnedValue(lowering, member.object())) {
        ownership.retainValue(lowering, collection);
    }
    let builder = lowering.builder();
    long taken = builder.newTemp(classType);
    builder.append(new EirTakeOrCopy(taken, classType, collection,
        calls.calleeFor(lowering, copy, classType)));
    long frozen = calls.emitCall(lowering, wrap, classType, taken, [], -1, null, span);
    ownership.releaseValue(lowering, taken);
    return frozen;
}

methodInfo(LoweringContext lowering, Type classType, string name, Span span) -> FunctionInfo? {
    let method = typemembers.inheritedOrOwnMethod(classType, name);
    if (method == null) {
        lowering.internalError("'{typenames.display(classType)}' declares no '{name}' for "
            + "'frozen()' to call", span);
        return null;
    }
    let info = lowering.index().infoFor(method.signature());
    if (info == null) {
        lowering.internalError("the method '{typenames.display(classType)}.{name}' resolves to no "
            + "indexed function", span);
    }
    return info;
}
