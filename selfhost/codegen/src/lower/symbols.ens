// Linker symbol names. Every function is qualified by its defining module with '$', a character
// no Ens identifier can contain, and an overloaded name carries a '$'-prefixed parameter-type
// suffix, so one symbol names one function program-wide even for a file-private one.
import ArrayType from @ens.sema.model.types;
import DeclaredType from @ens.sema.model.types;
import FunctionType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import NullType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import Parameter from @ens.sema.model.types;
import StringType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import StringBuilder from @std.text.stringbuilder;

public linkName(Signature signature, bool isExternal, string modulePath, bool overloaded) -> string {
    if (signature.name() == "main") {
        return "ens.main";
    }
    string base = signature.name() + overloadSuffix(signature, overloaded);
    if (isExternal) {
        return base;
    }
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length == 0) {
        return base;
    }
    return sanitized + "$" + base;
}

// A method's symbol names its defining module and its record as well as the method, so two
// records declaring the same method name never collide, whatever module either lives in. A
// constructor is named 'constructor' and a destructor 'destructor', the names sema stores them
// under.
public methodLinkName(string modulePath, string recordName, Signature signature, bool overloaded) -> string {
    string base = recordName + "$" + signature.name() + overloadSuffix(signature, overloaded);
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length == 0) {
        return base;
    }
    return sanitized + "$" + base;
}

// The symbol of the destructor a class stores in its object header. The leading '_dtor$' cannot
// collide with anything a program declares: a module path sanitizes to letters, digits, '_' and
// '.', so no user symbol ever starts with it.
public destructorLinkName(string modulePath, string className) -> string {
    return "_dtor$" + sanitizeModulePath(modulePath) + "$" + className;
}

// The three symbols one lazy const owns, for its initializer, its value, and its state byte.
public lazyInitializerLinkName(string modulePath, string typeName, string field) -> string {
    return lazyLinkName("_lazyinit", modulePath, typeName, field);
}

public lazyValueLinkName(string modulePath, string typeName, string field) -> string {
    return lazyLinkName("_lazyvalue", modulePath, typeName, field);
}

public lazyStateLinkName(string modulePath, string typeName, string field) -> string {
    return lazyLinkName("_lazystate", modulePath, typeName, field);
}

lazyLinkName(string prefix, string modulePath, string typeName, string field) -> string {
    return prefix + "$" + sanitizeModulePath(modulePath) + "$" + typeName + "$" + field;
}

overloadSuffix(Signature signature, bool overloaded) -> string {
    if (!overloaded) {
        return "";
    }
    Parameter[] parameters = signature.parameters();
    if (parameters.length == 0) {
        return "$void";
    }
    let suffix = new StringBuilder();
    suffix.append("$");
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            suffix.append("_");
        }
        suffix.append(mangleTypeForName(parameters[i].type()));
    }
    return suffix.toString();
}

// A symbol-safe spelling of a type name: '?' becomes '_opt', '[]' becomes '_arr', and the
// angle brackets of a generic reference are dropped.
public mangleTypeForName(Type type) -> string {
    string displayed = types.display(type);
    byte[] raw = displayed.toBytes();
    let out = new StringBuilder();
    long i = 0;
    while (i < raw.length) {
        byte value = raw[i];
        if (value == '?') {
            out.append("_opt");
        } else if (value == '[' && i + 1 < raw.length && raw[i + 1] == ']') {
            out.append("_arr");
            i++;
        } else if (value == '<' || value == '>') {
        } else {
            out.appendByte(value);
        }
        i++;
    }
    return out.toString();
}

// The instantiation mangling: 'List<int>' renders as '<module>$List__int__', its 'push' as
// '<module>$List__int___push', and a generic function instance as '<module>$<name>__<arguments>__'.
// A plain declared type is qualified by its defining module; a primitive renders as its keyword.
public mangledTypeArgument(Type type) -> string {
    switch (type) {
        is ArrayType array -> {
            return "arr_" + mangledTypeArgument(array.element());
        },
        is OptionalType optional -> {
            return "opt_" + mangledTypeArgument(optional.inner());
        },
        is FunctionType functionType -> {
            let builder = new StringBuilder();
            builder.append("fn");
            for (let parameter in functionType.parameterTypes()) {
                builder.append("_");
                builder.append(mangledTypeArgument(parameter));
            }
            builder.append("_to_");
            builder.append(mangledTypeArgument(functionType.returnType()));
            return builder.toString();
        },
        is InstantiationType instantiation -> {
            return instantiationName(instantiation);
        },
        is DeclaredType declared -> {
            string sanitized = sanitizeModulePath(declared.modulePath());
            if (sanitized.length == 0) {
                return declared.name();
            }
            return sanitized + "_" + declared.name();
        },
        is StringType ignored -> {
            return "string";
        },
        is PrimitiveType primitive -> {
            return primitiveKeyword(primitive.kind());
        },
        is NullType ignored -> {
            return "null";
        },
        default -> {
            return "_";
        },
    }
}

// The keyword spelling of each primitive, the form a mangled name carries.
primitiveKeyword(PrimitiveKind kind) -> string {
    return switch (kind) {
        Bool -> "bool",
        Byte -> "byte",
        Short -> "short",
        UShort -> "ushort",
        Int -> "int",
        UInt -> "uint",
        Long -> "long",
        ULong -> "ulong",
        Float -> "float",
        Double -> "double",
        Decimal -> "decimal",
        Char -> "char",
        Void -> "void",
    };
}

// 'List<int>' -> 'std.collections.list$List__int__': the template's module and name folded with
// the mangled arguments. The module is the template's rather than the user's, so every module that
// needs the instantiation names it the same way and the home module's single definition is the one
// they all resolve to, while two same-named templates from different modules never share a name.
public instantiationName(InstantiationType instantiation) -> string {
    let out = new StringBuilder();
    let template = instantiation.template();
    string sanitized = sanitizeModulePath(template.modulePath());
    if (sanitized.length > 0) {
        out.append(sanitized);
        out.append("$");
    }
    out.append(template.name());
    out.append("__");
    Type[] arguments = instantiation.arguments();
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            out.append("_");
        }
        out.append(mangledTypeArgument(arguments[i]));
    }
    out.append("__");
    return out.toString();
}

// A method of an instantiation: 'std.collections.list$List__int___push'. An overloaded name takes
// its suffix from the template's parameter spellings, so two overloads that collapse to one
// parameter list after substitution still get distinct symbols.
public instantiationMethodLinkName(InstantiationType owner, string methodName,
                              Signature templateSignature, bool overloaded) -> string {
    return instantiationName(owner) + "_" + methodName
        + overloadSuffix(templateSignature, overloaded);
}

// A generic function instance: '<module>$<name>__<arguments>__', qualified by the module that
// defines it.
public genericInstanceLinkName(string modulePath, string name, Type[] arguments) -> string {
    let out = new StringBuilder();
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length > 0) {
        out.append(sanitized);
        out.append("$");
    }
    out.append(name);
    out.append(instanceSuffix(arguments));
    return out.toString();
}

// The '__<arguments>__' tail that tells one instance's symbol from another's.
public instanceSuffix(Type[] arguments) -> string {
    let out = new StringBuilder();
    out.append("__");
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            out.append("_");
        }
        out.append(mangledTypeArgument(arguments[i]));
    }
    out.append("__");
    return out.toString();
}

// The body of one lambda, numbered by its position among its module's lambdas: '<module>$lambdaN'
// for ordinary code, with the enclosing instance's type arguments appended inside a template
// body. Nothing about which function holds the lambda is in the name, because a lambda written in
// a parameter default is lowered at every call site rather than in one place.
public lambdaLinkName(string modulePath, long index, Type[] arguments) -> string {
    let out = new StringBuilder();
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length > 0) {
        out.append(sanitized);
        out.append("$");
    }
    out.append("lambda");
    out.append("{index}");
    if (arguments.length > 0) {
        out.append(instanceSuffix(arguments));
    }
    return out.toString();
}

// The destructor an instantiation's objects carry, named by the instantiation, whose name already
// carries the template's module; the home module defines it once.
public instanceDestructorLinkName(InstantiationType instantiation) -> string {
    return "_dtor$" + instantiationName(instantiation);
}

// Module paths keep letters, digits, '_' and '.'; everything else becomes '_'.
public sanitizeModulePath(string modulePath) -> string {
    byte[] raw = modulePath.toBytes();
    let out = new StringBuilder();
    for (long i = 0; i < raw.length; i++) {
        byte value = raw[i];
        bool kept = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
            || (value >= '0' && value <= '9') || value == '_' || value == '.';
        if (kept) {
            out.appendByte(value);
        } else {
            out.appendByte('_');
        }
    }
    return out.toString();
}
