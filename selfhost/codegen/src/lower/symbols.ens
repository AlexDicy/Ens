// Linker symbol names, matching the runtime contract: 'main' is renamed to 'ens.main' and
// wrapped, a private function links under its bare name with internal linkage, a public or
// exported function is qualified by its defining module with '$' (a character no Ens identifier
// can contain), and an overloaded name carries a '$'-prefixed parameter-type suffix. A method is
// named by its defining module and its struct, so its identity holds across modules.
import Signature from @ens.sema.model.types;
import Parameter from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import Visibility from @ens.sema.model.types;
import @ens.sema.model.types;
import StringBuilder from @std.text.stringbuilder;

public linkName(Signature signature, Visibility visibility, bool isExternal, string modulePath,
                bool overloaded) -> string {
    if (signature.name() == "main") {
        return "ens.main";
    }
    string base = signature.name() + overloadSuffix(signature, overloaded);
    if (visibility == Visibility.Private || isExternal) {
        return base;
    }
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length == 0) {
        return base;
    }
    return sanitized + "$" + base;
}

// A method's symbol names its defining module and its struct as well as the method, so two
// structs declaring the same method name never collide, whatever module either lives in. A
// constructor is named 'constructor', the name sema stores it under.
public methodLinkName(string modulePath, string structName, Signature signature,
                      bool overloaded) -> string {
    string base = structName + "$" + signature.name() + overloadSuffix(signature, overloaded);
    string sanitized = sanitizeModulePath(modulePath);
    if (sanitized.length == 0) {
        return base;
    }
    return sanitized + "$" + base;
}

overloadSuffix(Signature signature, bool overloaded) -> string {
    if (!overloaded) {
        return "";
    }
    Parameter[] parameters = signature.parameters();
    if (parameters.length == 0) {
        return "$void";
    }
    let suffix = new StringBuilder();
    suffix.append("$");
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            suffix.append("_");
        }
        suffix.append(mangleTypeForName(parameters[i].type()));
    }
    return suffix.toString();
}

// A symbol-safe spelling of a type name: '?' becomes '_opt', '[]' becomes '_arr', and the
// angle brackets of a generic reference are dropped.
public mangleTypeForName(Type type) -> string {
    string displayed = types.display(type);
    byte[] raw = displayed.toBytes();
    let out = new StringBuilder();
    long i = 0;
    while (i < raw.length) {
        byte value = raw[i];
        if (value == '?') {
            out.append("_opt");
        } else if (value == '[' && i + 1 < raw.length && raw[i + 1] == ']') {
            out.append("_arr");
            i++;
        } else if (value == '<' || value == '>') {
        } else {
            out.appendByte(value);
        }
        i++;
    }
    return out.toString();
}

// Module paths keep letters, digits, '_' and '.'; everything else becomes '_'.
public sanitizeModulePath(string modulePath) -> string {
    byte[] raw = modulePath.toBytes();
    let out = new StringBuilder();
    for (long i = 0; i < raw.length; i++) {
        byte value = raw[i];
        bool kept = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
            || (value >= '0' && value <= '9') || value == '_' || value == '.';
        if (kept) {
            out.appendByte(value);
        } else {
            out.appendByte('_');
        }
    }
    return out.toString();
}
