// Field defaults, the declared value every field an aggregate leaves unset takes. A default is
// checked in the module that declares the struct, so its side tables are read from there while it
// lowers. The fields declared before the one being filled are in scope as siblings.
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import LocalBinding from @ens.sema.model.scopes;
import ClassType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Substitution from mono.substitution;
import mono.substitution;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import layout.vtables;
import support.primitives;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirConstInt from eir.model;
import EirJump from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import LoweringContext from lower.context;
import lower.arrays;
import lower.ownership;
import lower.records;
import lower.stores;
import lower.weakfields;
import List from @std.collections.list;

// True when the record declares a default somewhere inside it, so filling a fresh one of it is more
// than zeroing. The walk descends into a struct field, whose storage is inline and needs its own
// defaults, but stops at a class field: an object's defaults are applied where the object is
// created, which is also what keeps a class holding one of itself from recursing forever.
public declaresDefaults(Type type) -> bool {
    let fields = records.fieldsOf(type);
    if (fields == null) {
        return false;
    }
    for (long i = 0; i < fields.length(); i++) {
        let fieldType = fields.get(i).type();
        if (fields.get(i).hasDefault()
                || (primitives.structOf(fieldType) != null && declaresDefaults(fieldType))) {
            return true;
        }
    }
    return false;
}

// The substitution one record level's default expressions lower under: the instantiation's own
// for a generic level, none for a plain one.
levelSubstitution(Type level) -> Substitution? {
    if (level is InstantiationType) {
        return substitution.forInstantiation(level);
    }
    return null;
}

// Fills every field of a fresh record from its declared defaults.
public applyAll(LoweringContext lowering, long destination, Type type, Span span) -> bool {
    let fields = records.fieldsOf(type);
    if (fields == null) {
        return true;
    }
    return applyOmitted(lowering, destination, type, new bool[fields.length()], span);
}

// Fills every field of a fresh object from the declared defaults of its whole chain, base
// classes first, the order the flattened fields sit in. Each class's defaults were written and
// checked in its own module, so the walk rebinds per level while the destination and the field
// indexes stay the concrete class's.
public applyClassDefaults(LoweringContext lowering, long destination, Type classType, Span span) -> bool {
    if (!declaresDefaults(classType)) {
        return true;
    }
    let fields = records.fieldsOf(classType);
    if (fields == null) {
        return true;
    }
    bool[] written = new bool[fields.length()];
    let chain = new List<Type>();
    Type? current = classType;
    while (current != null) {
        chain.push(current);
        current = vtables.baseClassOf(current);
    }
    for (long i = chain.length() - 1; i >= 0; i--) {
        let level = chain.get(i);
        let owner = lowering.index().recordFor(level);
        if (owner == null) {
            lowering.internalError("'{types.display(level)}' has no declaration to read its "
                + "field defaults from", span);
            return false;
        }
        let caller = lowering.enterModule(owner.context());
        let callerSubstitution = lowering.enterSubstitution(levelSubstitution(level));
        lowering.pushFieldDefaults(destination, classType, level);
        bool filled = fill(lowering, destination, classType, level, owner.members(), written,
            span);
        lowering.popFieldDefaults();
        let ignored = lowering.enterSubstitution(callerSubstitution);
        let restored = lowering.enterModule(caller);
        if (!filled) {
            return false;
        }
    }
    return true;
}

// Fills a slot declared without an initializer, which a struct with defaults still needs.
public applyToSlot(LoweringContext lowering, long slot, Type type, Span span) -> bool {
    if (primitives.structOf(type) == null || !declaresDefaults(type)) {
        return true;
    }
    return applyAll(lowering, ownership.slotAddress(lowering, slot, type), type, span);
}

// Fills the fields the caller did not write. The storage is fresh, so a write initializes it and
// has nothing to release, except a weak field, whose write always retires whatever entry it held.
public applyOmitted(LoweringContext lowering, long destination, Type type, bool[] written,
                    Span span) -> bool {
    if (!declaresDefaults(type)) {
        return true;
    }
    let owner = lowering.index().recordFor(type);
    if (owner == null) {
        lowering.internalError("'{types.display(type)}' has no declaration to read its field "
            + "defaults from", span);
        return false;
    }
    let caller = lowering.enterModule(owner.context());
    let callerSubstitution = lowering.enterSubstitution(levelSubstitution(type));
    lowering.pushFieldDefaults(destination, type, type);
    bool filled = fill(lowering, destination, type, type, owner.members(), written, span);
    lowering.popFieldDefaults();
    let ignored = lowering.enterSubstitution(callerSubstitution);
    let restored = lowering.enterModule(caller);
    return filled;
}

// Walks the declaration in source order, which is the order the fields sit in and the order sema
// brought them into scope, so a default may read a field declared before it. A name resolves
// against the level that declared it, whose fields hold the same indexes in the record's
// flattened layout, so a subclass field of the same name never takes a base default.
fill(LoweringContext lowering, long destination, Type type, Type level, MemberListNode body,
     bool[] written, Span span) -> bool {
    let fields = records.fieldsOf(type);
    if (fields == null) {
        return true;
    }
    for (long i = 0; i < body.membersCount(); i++) {
        let member = body.members(i);
        if (!(member is FieldDeclarationNode)) {
            continue;
        }
        long index = records.fieldIndexOf(level, member.name().text());
        if (index < 0 || written[index]) {
            continue;
        }
        let field = fields.get(index);
        let fieldType = field.type();
        let defaultValue = member.defaultValue();
        if (defaultValue != null) {
            let operand = stores.lowerOperand(lowering, defaultValue.value(), fieldType);
            if (operand == null) {
                return false;
            }
            long fieldAddress = records.fieldAddressIn(lowering, destination, type, fieldType,
                index);
            if (field.isWeak()) {
                weakfields.store(lowering, fieldAddress, operand);
                continue;
            }
            if (!stores.initializeThroughAddress(lowering, fieldAddress, fieldType, operand)) {
                lowering.internalError("the default of field '{member.name().text()}' borrows a "
                    + "struct with no storage to retain", defaultValue.value().span());
                return false;
            }
            continue;
        }
        if (primitives.structOf(fieldType) != null && declaresDefaults(fieldType)) {
            long nested = records.fieldAddressIn(lowering, destination, type, fieldType, index);
            if (!applyAll(lowering, nested, fieldType, span)) {
                return false;
            }
        }
    }
    return true;
}

// Runs a struct element type's field defaults over every slot of a freshly allocated array, so an
// allocated slot reads the way a literal of that struct would. An element type with nothing to
// default stays at the zero the allocation left it at.
public fillArray(LoweringContext lowering, long array, Type elementType, long count, Span span)
        -> bool {
    if (primitives.structOf(elementType) == null || !declaresDefaults(elementType)) {
        return true;
    }
    let builder = lowering.builder();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long indexSlot = builder.addSlot("filled", longType, false, false);
    long zero = builder.newTemp(longType);
    builder.append(new EirConstInt(zero, longType, 0));
    builder.append(new EirStoreSlot(indexSlot, zero));
    long conditionBlock = builder.newBlock("fill.cond");
    long bodyBlock = builder.newBlock("fill.body");
    long exitBlock = builder.newBlock("fill.end");
    builder.terminate(new EirJump(conditionBlock));
    builder.moveTo(conditionBlock);
    long index = builder.newTemp(longType);
    builder.append(new EirLoadSlot(index, longType, indexSlot));
    long more = builder.newTemp(boolType);
    builder.append(new EirBinary(more, boolType, EirBinaryOp.CmpLtSigned, index, count));
    builder.terminate(new EirBranch(more, bodyBlock, exitBlock));
    builder.moveTo(bodyBlock);
    long slotIndex = builder.newTemp(longType);
    builder.append(new EirLoadSlot(slotIndex, longType, indexSlot));
    long address = arrays.elementAddress(lowering, array, slotIndex, elementType);
    if (!applyAll(lowering, address, elementType, span)) {
        return false;
    }
    long one = builder.newTemp(longType);
    builder.append(new EirConstInt(one, longType, 1));
    long next = builder.newTemp(longType);
    builder.append(new EirBinary(next, longType, EirBinaryOp.Add, slotIndex, one));
    builder.append(new EirStoreSlot(indexSlot, next));
    builder.terminate(new EirJump(conditionBlock));
    builder.moveTo(exitBlock);
    return true;
}

// The address of the sibling field an identifier inside a field default names, or -1 when no
// default is being lowered or the name is not one of the record's fields.
public siblingFieldAddress(LoweringContext lowering, LocalBinding binding) -> long {
    let owner = lowering.fieldDefaultOwner();
    let level = lowering.fieldDefaultLevel();
    if (owner == null || level == null) {
        return -1;
    }
    long index = records.fieldIndexOf(level, binding.name());
    if (index < 0) {
        return -1;
    }
    let fields = records.fieldsOf(owner);
    if (fields == null) {
        return -1;
    }
    return records.fieldAddressIn(lowering, lowering.fieldDefaultDestination(), owner,
        fields.get(index).type(), index);
}
