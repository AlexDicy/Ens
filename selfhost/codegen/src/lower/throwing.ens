// Which callables report through a trailing error-slot parameter, and which call sites must check
// it. The slot follows the root declaration of a method's dispatch contract, while the check
// follows the static target's own contract, which is exactly where sema requires the 'try'.
import Method from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import @ens.sema.model.types;
import FunctionInfo from lower.index;

// True when the callable's ABI carries the trailing error-slot parameter. A callable without a
// declaration, a built-in or an external, follows its own 'throws' marker.
public abiThrows(FunctionInfo info) -> bool {
    let declaration = info.signature().declaration();
    if (declaration == null) {
        return info.signature().declaresThrows();
    }
    let recorded = info.context().result().abiThrowsOf(declaration);
    if (recorded == null) {
        return info.signature().declaresThrows();
    }
    return recorded;
}

// True when a call to this target can actually raise, which is where sema requires 'try' and
// lowering builds the unwind edge. The contract is judged at the static target: its declared
// list when it names types, its recorded outward set otherwise.
public contractThrows(FunctionInfo info) -> bool {
    let signature = info.signature();
    if (signature.declaresThrows() && signature.throwsTypes().length > 0) {
        return true;
    }
    let declaration = signature.declaration();
    if (declaration == null) {
        return false;
    }
    let thrown = info.context().result().throwsSetOf(declaration);
    return thrown != null && thrown.length > 0;
}

// The base class of every thrown value, the type an in-flight error travels at.
public errorClassOf(TypeStore store) -> Type? {
    return store.findDeclared("std.core", "Error");
}

// True for the Error accessors the compiler intercepts: their placeholder bodies are never
// emitted, and a call to one lowers to the trace runtime or the runtime type read instead.
public isInterceptedErrorMethod(Type owner, Method method) -> bool {
    let authority = types.authorityOf(owner);
    if (authority == null || authority.name() != "Error"
            || authority.modulePath() != "std.core") {
        return false;
    }
    string name = method.name();
    return name == "stackTrace" || name == "stackFrames" || name == "typeName";
}
