// The state one function's lowering owns: the EIR builder, the slot map, the loop stack, the
// ownership bookkeeping, the collected diagnostics, and the sema side tables the walk currently
// reads. One instance lives for the duration of one function and is threaded through the
// lowering area modules, so nothing is shared between functions and lowering can run in
// parallel. The one exception is the array-content plan, shared by every function of a module
// so each element type's helpers are defined exactly once in the module's object file.
//
// Ownership bookkeeping is a stack of scopes, each listing the slots whose contents that scope
// owns. Leaving a scope releases its slots innermost first; a loop remembers the depth it began
// at so 'break' and 'continue' release exactly the scopes they leave; a 'return' releases every
// scope. The releases themselves are emitted by lower.ownership.
import Expression from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import LineIndex from @ens.frontend.support.source;
import ModuleContext from @ens.sema.context;
import SemaResult from @ens.sema.result;
import LocalBinding from @ens.sema.model.scopes;
import Parameter from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import FileDiagnostic from @ens.sema.support.diagnostics;
import EirFunctionBuilder from eir.model;
import EirParameter from eir.model;
import DispatchTables from layout.vtables;
import Substitution from mono.substitution;
import mono.substitution;
import ArrayContentPlan from lower.arraycontent;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import lower.throwing;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;

// The blocks 'break' and 'continue' jump to in one enclosing loop, and the scope depth the loop
// body began at.
class LoopTargets {
    protected long breakTarget;
    protected long continueTarget;
    protected long scopeDepth;

    protected constructor(this.breakTarget, this.continueTarget, this.scopeDepth);
}

// The slots one scope owns the contents of, released when the scope ends.
class OwnedScope {
    protected List<long> slots;

    protected constructor() {
        this.slots = new List<long>();
    }
}

// One struct or class whose field defaults are being lowered, and the destination they fill: the
// address of a struct aggregate, or the reference an object sits behind. Sema keeps the fields
// declared earlier in scope while it checks a default, so an identifier inside one names a field of
// this record rather than a local.
class FieldDefaults {
    protected long destination;
    protected Type owner;

    protected constructor(this.destination, this.owner);
}

public final class LoweringContext {
    FunctionInfo functionInfo;
    ProgramIndex programIndex;
    DispatchTables dispatchTables;
    TypeStore typeStore;
    ArrayContentPlan contentPlan;

    EirFunctionBuilder functionBuilder;
    Map<LocalBinding, long> slotsByBinding;
    List<LoopTargets> loops;
    List<OwnedScope> scopes;
    List<FieldDefaults> fieldDefaults;

    ModuleContext currentModule;
    SemaResult currentResult;
    string currentFile;
    Substitution? currentSubstitution;
    Map<string, LineIndex> lineIndexes;

    Type? errorClass;
    List<long> unwindProtected;
    long errorDispatchSlot;
    long errorDispatchBlock;
    bool catchBodyActive;
    long catchBodySlot;

    // The borrowing slot a primitive receiver was placed in, so 'this' reads like a parameter
    // rather than as the incoming temp itself; -1 for every other receiver shape.
    long boundReceiverSlotId;

    // The slot holding the receiver a lambda captured, and its type. Inside such a body 'this'
    // is that copy rather than an incoming receiver; -1 everywhere else.
    long capturedReceiverSlotId;
    Type? capturedReceiverKind;

    List<FileDiagnostic> problems;
    bool lowerFailed;

    public constructor(FunctionInfo info, ProgramIndex index, DispatchTables tables,
                TypeStore store, ArrayContentPlan plan) {
        this.functionInfo = info;
        this.programIndex = index;
        this.dispatchTables = tables;
        this.typeStore = store;
        this.contentPlan = plan;
        this.currentSubstitution = info.substitution();
        let signature = info.signature();
        Parameter[] parameters = signature.parameters();
        let eirParameters = new EirParameter[parameters.length];
        for (long i = 0; i < eirParameters.length; i++) {
            eirParameters[i] = new EirParameter(parameters[i].name(),
                substitution.apply(store, info.substitution(), parameters[i].type()));
        }
        this.functionBuilder = new EirFunctionBuilder(info.symbol(), info.internalLinkage(),
            info.receiverType(), eirParameters,
            substitution.apply(store, info.substitution(), signature.returnType()));
        this.slotsByBinding = new Map<LocalBinding, long>();
        this.loops = new List<LoopTargets>();
        this.scopes = new List<OwnedScope>();
        this.fieldDefaults = new List<FieldDefaults>();
        this.currentModule = info.context();
        this.currentResult = info.context().result();
        this.currentFile = info.context().module().filePath();
        this.lineIndexes = new Map<string, LineIndex>();
        this.errorClass = throwing.errorClassOf(store);
        this.unwindProtected = new List<long>();
        this.errorDispatchSlot = -1;
        this.errorDispatchBlock = -1;
        this.catchBodyActive = false;
        this.catchBodySlot = -1;
        this.boundReceiverSlotId = -1;
        this.capturedReceiverSlotId = -1;
        this.capturedReceiverKind = null;
        this.problems = new List<FileDiagnostic>();
        this.lowerFailed = false;
    }

    public info() -> FunctionInfo {
        return this.functionInfo;
    }

    public index() -> ProgramIndex {
        return this.programIndex;
    }

    // The array-content plan shared by every function of this module.
    public arrayContent() -> ArrayContentPlan {
        return this.contentPlan;
    }

    public tables() -> DispatchTables {
        return this.dispatchTables;
    }

    public store() -> TypeStore {
        return this.typeStore;
    }

    public builder() -> EirFunctionBuilder {
        return this.functionBuilder;
    }

    public result() -> SemaResult {
        return this.currentResult;
    }

    public failed() -> bool {
        return this.lowerFailed;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.problems.toArray();
    }

    // Reads the side tables of another module for as long as an expression from that module is
    // being lowered; passing the returned module back restores the previous one.
    public enterModule(ModuleContext owner) -> ModuleContext {
        let previous = this.currentModule;
        this.currentModule = owner;
        this.currentResult = owner.result();
        this.currentFile = owner.module().filePath();
        return previous;
    }

    // Lowers under another owner's substitution - a callee's default expression belongs to the
    // callee's declaration - until the returned one is passed back.
    public enterSubstitution(Substitution? active) -> Substitution? {
        let previous = this.currentSubstitution;
        this.currentSubstitution = active;
        return previous;
    }

    // The type-argument assignment lowering is running under, which is what puts an instance's
    // arguments in the symbol of a lambda written inside a template body.
    public substitution() -> Substitution? {
        return this.currentSubstitution;
    }

    // Records the borrowing slot a primitive receiver was placed in, so every read of 'this' is a
    // load out of it rather than the incoming temp itself.
    public setBoundReceiver(long slot) {
        this.boundReceiverSlotId = slot;
    }

    public boundReceiverSlot() -> long {
        return this.boundReceiverSlotId;
    }

    // Records the slot a lambda's captured receiver lives in.
    public setCapturedReceiver(long slot, Type type) {
        this.capturedReceiverSlotId = slot;
        this.capturedReceiverKind = type;
    }

    public capturedReceiverSlot() -> long {
        return this.capturedReceiverSlotId;
    }

    public capturedReceiverType() -> Type? {
        return this.capturedReceiverKind;
    }

    // The type with the active substitution applied: concrete for ordinary code, and the
    // instance's concrete form for a type recorded inside a template body.
    public substituted(Type type) -> Type {
        return substitution.apply(this.typeStore, this.currentSubstitution, type);
    }

    public substitutedAll(Type[] typeList) -> Type[] {
        return substitution.applyAll(this.typeStore, this.currentSubstitution, typeList);
    }

    // The 1-based source line the span starts on, in whichever module is being lowered.
    public lineAt(Span span) -> long {
        let cached = this.lineIndexes.get(this.currentFile);
        if (cached != null) {
            return cached.positionAt(span.start).line;
        }
        let built = new LineIndex(this.currentModule.module().source());
        this.lineIndexes.set(this.currentFile, built);
        return built.positionAt(span.start).line;
    }

    // The class every thrown value extends, or null when the standard library is malformed.
    public errorType() -> Type? {
        return this.errorClass;
    }

    // Marks a value temp whose +1 is in flight across a possibly-unwinding call, so every unwind
    // edge inside the window releases it; the holder unprotects it when it consumes the value.
    public protectValue(long temp) {
        this.unwindProtected.push(temp);
    }

    public unprotectValue(long temp) {
        let kept = new List<long>();
        while (this.unwindProtected.length() > 0) {
            long top = this.unwindProtected.pop();
            if (top == temp) {
                break;
            }
            kept.push(top);
        }
        while (kept.length() > 0) {
            this.unwindProtected.push(kept.pop());
        }
    }

    // The protected temps, oldest first.
    public protectedValues() -> long[] {
        return this.unwindProtected.toArray();
    }

    // The slot and block the function's catch clauses read an in-flight error from.
    public setDispatch(long slot, long block) {
        this.errorDispatchSlot = slot;
        this.errorDispatchBlock = block;
    }

    public hasDispatch() -> bool {
        return this.errorDispatchBlock >= 0;
    }

    public dispatchSlot() -> long {
        return this.errorDispatchSlot;
    }

    public dispatchBlock() -> long {
        return this.errorDispatchBlock;
    }

    // Marks that a catch clause's body is being lowered, whose throws propagate to the caller
    // rather than back into the dispatch, and whose bound error 'rethrow' re-raises.
    public beginCatchBody(long bindingSlot) {
        this.catchBodyActive = true;
        this.catchBodySlot = bindingSlot;
    }

    public endCatchBody() {
        this.catchBodyActive = false;
        this.catchBodySlot = -1;
    }

    public inCatchBody() -> bool {
        return this.catchBodyActive;
    }

    public catchBindingSlot() -> long {
        return this.catchBodySlot;
    }

    public unsupported(string what, Span span) {
        this.problems.push(new FileDiagnostic(this.currentFile,
            "The self-hosted code generator does not support {what} yet.", span));
        this.lowerFailed = true;
    }

    public internalError(string message, Span span) {
        this.problems.push(new FileDiagnostic(this.currentFile, "Internal: " + message, span));
        this.lowerFailed = true;
    }

    public typeOf(Expression node) -> Type? {
        let recorded = this.currentResult.typeOf(node.green());
        if (recorded == null) {
            this.internalError("expression has no recorded type", node.span());
            return null;
        }
        return this.substituted(recorded);
    }

    public supportsValueType(Type type) -> bool {
        return primitives.isRepresentable(type);
    }

    public supportsClassLayout(Type classType) -> bool {
        return primitives.isRepresentableClass(classType);
    }

    // Gives a local its mutable slot, which owns whatever it holds.
    public defineSlot(LocalBinding binding, string name, Type type) -> long {
        return this.defineSlotAs(binding, name, type, false);
    }

    // Gives a parameter or local its mutable slot. A borrowing slot holds a reference its caller
    // owns, so it is neither zeroed nor released. A struct starts zeroed whether or not it holds
    // references, because a field the program never writes still has to read as zero.
    public defineSlotAs(LocalBinding binding, string name, Type type, bool borrowing) -> long {
        bool zeroed = (primitives.hasArcContent(type) || primitives.structOf(type) != null)
            && !borrowing;
        long slot = this.functionBuilder.addSlot(name, type, zeroed, borrowing);
        this.slotsByBinding.set(binding, slot);
        return slot;
    }

    public slotFor(LocalBinding binding) -> long? {
        return this.slotsByBinding.get(binding);
    }

    public pushLoop(long breakBlock, long continueBlock) {
        this.loops.push(new LoopTargets(breakBlock, continueBlock, this.scopes.length()));
    }

    public popLoop() {
        this.loops.pop();
    }

    public inLoop() -> bool {
        return this.loops.length() > 0;
    }

    public breakBlock() -> long {
        return this.loops.get(this.loops.length() - 1).breakTarget;
    }

    public continueBlock() -> long {
        return this.loops.get(this.loops.length() - 1).continueTarget;
    }

    // The scope depth the innermost loop's body began at; 'break' and 'continue' release every
    // scope above it.
    public loopScopeDepth() -> long {
        return this.loops.get(this.loops.length() - 1).scopeDepth;
    }

    public pushScope() {
        this.scopes.push(new OwnedScope());
    }

    public popScope() {
        this.scopes.pop();
    }

    public scopeDepth() -> long {
        return this.scopes.length();
    }

    // Records that the innermost scope owns this slot's contents.
    public ownSlot(long slot) {
        if (this.scopes.length() == 0) {
            return;
        }
        this.scopes.get(this.scopes.length() - 1).slots.push(slot);
    }

    // The slots one scope owns, innermost-last order preserved.
    public ownedSlotsAt(long depth) -> long[] {
        if (depth < 0 || depth >= this.scopes.length()) {
            return [];
        }
        return this.scopes.get(depth).slots.toArray();
    }

    public pushFieldDefaults(long destination, Type owner) {
        this.fieldDefaults.push(new FieldDefaults(destination, owner));
    }

    public popFieldDefaults() {
        this.fieldDefaults.pop();
    }

    // The record whose field defaults are being lowered right now, or null outside one. A nested
    // record's defaults shadow the enclosing one's, so the innermost frame answers.
    public fieldDefaultOwner() -> Type? {
        if (this.fieldDefaults.length() == 0) {
            return null;
        }
        return this.fieldDefaults.get(this.fieldDefaults.length() - 1).owner;
    }

    // The destination the current field defaults fill, or -1 outside one.
    public fieldDefaultDestination() -> long {
        if (this.fieldDefaults.length() == 0) {
            return -1;
        }
        return this.fieldDefaults.get(this.fieldDefaults.length() - 1).destination;
    }
}
