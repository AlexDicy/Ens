// Expression lowering: the dispatcher every other area calls back into, the leaf forms
// (literals and slot-backed identifiers), the explicit cast, and the ternary. Operators, calls,
// assignments, and switch expressions each lower in their own module.
//
// Every entry point returns the temp holding the value, or -1 once lowering has failed.
import Expression from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import PostfixExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CastExpressionNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import LoweringContext from lower.context;
import lower.assignments;
import lower.calls;
import lower.conversions;
import lower.literals;
import lower.operators;
import lower.switches;

public lower(LoweringContext lowering, Expression node) -> long {
    if (lowering.failed()) {
        return -1;
    }
    switch (node) {
        is LiteralExpressionNode literal -> {
            return lowerLiteral(lowering, literal);
        },
        is IdentifierExpressionNode identifier -> {
            return lowerIdentifier(lowering, identifier);
        },
        is ParenthesizedExpressionNode parenthesized -> {
            return lower(lowering, parenthesized.inner());
        },
        is PrefixExpressionNode prefix -> {
            return operators.lowerPrefix(lowering, prefix);
        },
        is PostfixExpressionNode postfix -> {
            return operators.lowerPostfix(lowering, postfix);
        },
        is BinaryExpressionNode binary -> {
            return operators.lowerBinary(lowering, binary);
        },
        is CastExpressionNode cast -> {
            return lowerCast(lowering, cast);
        },
        is AssignmentExpressionNode assignment -> {
            return assignments.lower(lowering, assignment);
        },
        is TernaryExpressionNode ternary -> {
            return lowerTernary(lowering, ternary);
        },
        is CallExpressionNode call -> {
            return calls.lower(lowering, call);
        },
        is SwitchExpressionNode switched -> {
            return switches.lowerExpression(lowering, switched);
        },
        default -> {
            lowering.unsupported("this expression", node.span());
            return -1;
        },
    }
}

public lowerConverted(LoweringContext lowering, Expression node, Type target) -> long {
    long value = lower(lowering, node);
    if (value < 0) {
        return -1;
    }
    return conversions.convert(lowering, value, target, node.span());
}

lowerLiteral(LoweringContext lowering, LiteralExpressionNode literal) -> long {
    let builder = lowering.builder();
    let type = lowering.typeOf(literal);
    if (type == null) {
        return -1;
    }
    switch (literal.value().kind()) {
        IntLiteral, LongLiteral -> {
            let magnitude = literals.integerMagnitude(literal.value().text());
            if (magnitude == null) {
                lowering.internalError("integer literal '{literal.value().text()}' does not "
                    + "parse", literal.span());
                return -1;
            }
            long temp = builder.newTemp(type);
            builder.append(new EirConstInt(temp, type, magnitude as long));
            return temp;
        },
        CharLiteral -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstInt(temp, type,
                literals.charCodepoint(literal.value().text()) as long));
            return temp;
        },
        FloatLiteral, DoubleLiteral -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstFloat(temp, type,
                literals.floatValue(literal.value().text()), literal.value().text()));
            return temp;
        },
        TrueKeyword -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstBool(temp, type, true));
            return temp;
        },
        FalseKeyword -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstBool(temp, type, false));
            return temp;
        },
        default -> {
            lowering.unsupported("this literal", literal.span());
            return -1;
        },
    }
}

lowerIdentifier(LoweringContext lowering, IdentifierExpressionNode identifier) -> long {
    let binding = lowering.result().bindingOf(identifier.green());
    if (binding == null) {
        lowering.internalError("identifier '{identifier.name().text()}' has no binding",
            identifier.span());
        return -1;
    }
    let slot = lowering.slotFor(binding);
    if (slot == null) {
        lowering.internalError("'{identifier.name().text()}' has no storage slot",
            identifier.span());
        return -1;
    }
    let builder = lowering.builder();
    long temp = builder.newTemp(binding.type());
    builder.append(new EirLoadSlot(temp, binding.type(), slot));
    return temp;
}

lowerCast(LoweringContext lowering, CastExpressionNode cast) -> long {
    let targetType = lowering.typeOf(cast);
    if (targetType == null) {
        return -1;
    }
    if (!lowering.supportsValueType(targetType)) {
        lowering.unsupported("a cast to '{types.display(targetType)}'", cast.span());
        return -1;
    }
    long value = lower(lowering, cast.value());
    if (value < 0) {
        return -1;
    }
    return conversions.convert(lowering, value, targetType, cast.span());
}

lowerTernary(LoweringContext lowering, TernaryExpressionNode ternary) -> long {
    let resultType = lowering.typeOf(ternary);
    if (resultType == null) {
        return -1;
    }
    if (!lowering.supportsValueType(resultType)) {
        lowering.unsupported("a conditional of type '{types.display(resultType)}'",
            ternary.span());
        return -1;
    }
    long condition = lower(lowering, ternary.condition());
    if (condition < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long slot = builder.addSlot("ternary", resultType);
    long thenBlock = builder.newBlock("ternary.then");
    long elseBlock = builder.newBlock("ternary.else");
    long merge = builder.newBlock("ternary.end");
    builder.terminate(new EirBranch(condition, thenBlock, elseBlock));
    builder.moveTo(thenBlock);
    long thenValue = lowerConverted(lowering, ternary.thenValue(), resultType);
    if (thenValue < 0) {
        return -1;
    }
    builder.append(new EirStoreSlot(slot, thenValue));
    builder.terminate(new EirJump(merge));
    builder.moveTo(elseBlock);
    long elseValue = lowerConverted(lowering, ternary.elseValue(), resultType);
    if (elseValue < 0) {
        return -1;
    }
    builder.append(new EirStoreSlot(slot, elseValue));
    builder.terminate(new EirJump(merge));
    builder.moveTo(merge);
    long temp = builder.newTemp(resultType);
    builder.append(new EirLoadSlot(temp, resultType, slot));
    return temp;
}
