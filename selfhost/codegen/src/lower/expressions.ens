// Expression lowering: the dispatcher every other area calls back into, the leaf forms, the
// explicit cast, and the ternary. Every entry point returns the temp holding the value, or -1
// for a value of type 'void' or once lowering has failed.
import Expression from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import PostfixExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CastExpressionNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import InterpolatedStringExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import NewExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArrayLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import SubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeSubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import NullCoalesceExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import TypeTestExpressionNode from @ens.frontend.syntax.generated.nodes;
import CheckedCastExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import EmbedExpressionNode from @ens.frontend.syntax.generated.nodes;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import @ens.sema.model.literalvalues;
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirConstNull from eir.model;
import EirZeroStruct from eir.model;
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirUnreachable from eir.model;
import LoweringContext from lower.context;
import lower.arrays;
import lower.assignments;
import lower.calls;
import lower.embeds;
import lower.classes;
import lower.closures;
import lower.conversions;
import lower.defaults;
import lower.literals;
import lower.members;
import lower.operators;
import lower.optionals;
import lower.ownership;
import lower.places;
import lower.statements;
import lower.stores;
import lower.strings;
import lower.structs;
import lower.switches;
import lower.typetests;
import support.primitives;

// Lowers 'node', and releases the temporaries made for it once its value no longer borrows from
// them: a value it owns or one holding no references. A borrowed value leaves them to whatever
// uses it.
public lower(LoweringContext lowering, Expression node) -> long {
    if (lowering.failed()) {
        return -1;
    }
    long mark = lowering.temporaryMark();
    long value = lowerKeepingTemporaries(lowering, node);
    if (lowering.temporaryMark() > mark && !lowering.failed()
            && !borrowsTemporaries(lowering, node)) {
        ownership.releaseTemporaries(lowering, mark);
    }
    return value;
}

borrowsTemporaries(LoweringContext lowering, Expression node) -> bool {
    let type = lowering.typeOf(node);
    return type != null && primitives.hasArcContent(type)
        && !places.producesOwnedValue(lowering, node);
}

lowerKeepingTemporaries(LoweringContext lowering, Expression node) -> long {
    if (lowering.result().isNeverReturningValue(node.green())) {
        return lowerNeverReturningValue(lowering, node);
    }
    if (lowering.ownsRead(node) && !(node is AssignmentExpressionNode)) {
        return places.lowerRetained(lowering, node);
    }
    return lowerForm(lowering, node);
}

// Lowers 'node', which never returns but is written where a value of its recorded type is read.
// The path ends after it, and the code after it, which nothing reaches, reads a value of that type
// from a slot no path writes.
lowerNeverReturningValue(LoweringContext lowering, Expression node) -> long {
    long value = lowerForm(lowering, node);
    let valueType = lowering.typeOf(node);
    if (lowering.failed() || value >= 0 || valueType == null) {
        return value;
    }
    let builder = lowering.builder();
    if (!builder.terminated()) {
        builder.terminate(new EirUnreachable());
    }
    builder.moveTo(builder.newBlock("unreachable"));
    long slot = ownership.defineStandInSlot(lowering, "unreachable", valueType);
    long temp = builder.newTemp(valueType);
    builder.append(new EirLoadSlot(temp, valueType, slot));
    return temp;
}

// Lowers 'node' by its form alone, so a value that never returns gets no stand-in value, as suits
// one nothing reads.
public lowerForm(LoweringContext lowering, Expression node) -> long {
    switch (node) {
        is LiteralExpressionNode literal -> {
            return lowerLiteral(lowering, literal);
        },
        is IdentifierExpressionNode identifier -> {
            return lowerIdentifier(lowering, identifier);
        },
        is ParenthesizedExpressionNode parenthesized -> {
            return lower(lowering, parenthesized.inner());
        },
        is PrefixExpressionNode prefix -> {
            return operators.lowerPrefix(lowering, prefix);
        },
        is PostfixExpressionNode postfix -> {
            return operators.lowerPostfix(lowering, postfix);
        },
        is BinaryExpressionNode binary -> {
            return operators.lowerBinary(lowering, binary);
        },
        is CastExpressionNode cast -> {
            return lowerCast(lowering, cast);
        },
        is AssignmentExpressionNode assignment -> {
            return assignments.lower(lowering, assignment);
        },
        is TernaryExpressionNode ternary -> {
            return lowerTernary(lowering, ternary);
        },
        is CallExpressionNode call -> {
            return calls.lower(lowering, call);
        },
        is SwitchExpressionNode switched -> {
            return switches.lowerExpression(lowering, switched);
        },
        is LambdaExpressionNode lambda -> {
            return closures.lowerCreation(lowering, lambda);
        },
        is InterpolatedStringExpressionNode interpolated -> {
            return strings.lowerInterpolation(lowering, interpolated);
        },
        is MemberExpressionNode member -> {
            return members.lower(lowering, member);
        },
        is NewExpressionNode created -> {
            if (created.dimensionsCount() > 0) {
                return arrays.lowerNew(lowering, created);
            }
            return classes.lowerNew(lowering, created);
        },
        is ArrayLiteralExpressionNode literal -> {
            return arrays.lowerLiteral(lowering, literal);
        },
        is StructLiteralExpressionNode literal -> {
            return structs.lowerLiteral(lowering, literal);
        },
        is SubscriptExpressionNode subscript -> {
            return arrays.lowerSubscript(lowering, subscript);
        },
        is ThisExpressionNode receiver -> {
            return members.lowerReceiver(lowering, receiver);
        },
        // A bare 'super' is the method's own receiver read at its base type; which implementation
        // a call through it binds is the call's business.
        is SuperExpressionNode receiver -> {
            return classes.lowerReceiver(lowering);
        },
        is TypeTestExpressionNode test -> {
            return typetests.lowerTypeTest(lowering, test);
        },
        is CheckedCastExpressionNode cast -> {
            return typetests.lowerCheckedCast(lowering, cast);
        },
        is NullCoalesceExpressionNode coalesce -> {
            return optionals.lowerCoalesce(lowering, coalesce);
        },
        is SafeMemberExpressionNode safeMember -> {
            return optionals.lowerSafeMember(lowering, safeMember);
        },
        is SafeSubscriptExpressionNode safeSubscript -> {
            return optionals.lowerSafeSubscript(lowering, safeSubscript);
        },
        // 'try' is checked syntax: the unwind edge follows from the callee's contract, so the
        // marker itself lowers to nothing.
        is TryExpressionNode tried -> {
            return lower(lowering, tried.operand());
        },
        is EmbedExpressionNode embedded -> {
            return embeds.lowerEmbed(lowering, embedded);
        },
        default -> {
            lowering.internalError("this kind of expression has no lowering", node.span());
            return -1;
        },
    }
}

// Releases what an expression produced for one use only.
public releaseTemporary(LoweringContext lowering, Expression source, long value) {
    if (places.producesOwnedValue(lowering, source)) {
        ownership.releaseOwned(lowering, value);
    }
}

public lowerConverted(LoweringContext lowering, Expression node, Type target) -> long {
    long value = lower(lowering, node);
    if (value < 0 && !lowering.failed() && !lowering.builder().terminated()) {
        let produced = lowering.typeOf(node);
        if (produced != null && types.isVoidType(produced)) {
            value = noValue(lowering);
        }
    }
    if (value < 0) {
        return -1;
    }
    return conversions.convert(lowering, value, target, node.span());
}

// The temp holding the one value of 'void', for a place that keeps a value of a type argument that
// is 'void'. It takes no storage.
public noValue(LoweringContext lowering) -> long {
    let nothing = lowering.store().primitive(PrimitiveKind.Void);
    long temp = lowering.builder().newTemp(nothing);
    lowering.builder().append(new EirZeroStruct(temp, nothing));
    return temp;
}

lowerLiteral(LoweringContext lowering, LiteralExpressionNode literal) -> long {
    let builder = lowering.builder();
    let type = lowering.typeOf(literal);
    if (type == null) {
        return -1;
    }
    switch (literal.value().kind()) {
        IntLiteral, LongLiteral -> {
            let magnitude = literals.integerMagnitude(literal.value().text());
            if (magnitude == null) {
                lowering.internalError("integer literal '{literal.value().text()}' does not "
                    + "parse", literal.span());
                return -1;
            }
            long temp = builder.newTemp(type);
            // An integer literal that took a floating-point type from its surroundings is that
            // value; the sign, when there is one, is a prefix over this node.
            if (primitives.isFloatType(type)) {
                builder.append(new EirConstFloat(temp, type, magnitude as double,
                    literal.value().text()));
                return temp;
            }
            builder.append(new EirConstInt(temp, type, magnitude as long));
            return temp;
        },
        CharLiteral -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstInt(temp, type,
                literals.charCodepoint(literal.value().text()) as long));
            return temp;
        },
        FloatLiteral, DoubleLiteral -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstFloat(temp, type,
                literalvalues.floatMagnitude(literal.value().text()), literal.value().text()));
            return temp;
        },
        TrueKeyword -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstBool(temp, type, true));
            return temp;
        },
        FalseKeyword -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstBool(temp, type, false));
            return temp;
        },
        StringLiteral -> {
            return strings.lowerLiteral(lowering, literal, type);
        },
        NullKeyword -> {
            long temp = builder.newTemp(type);
            builder.append(new EirConstNull(temp, type));
            return temp;
        },
        default -> {
            lowering.internalError("the literal '{literal.value().text()}' has no lowering",
                literal.span());
            return -1;
        },
    }
}

lowerIdentifier(LoweringContext lowering, IdentifierExpressionNode identifier) -> long {
    let binding = lowering.result().bindingOf(identifier.green());
    if (binding == null) {
        lowering.internalError("identifier '{identifier.name().text()}' has no binding",
            identifier.span());
        return -1;
    }
    let bindingType = lowering.substituted(binding.type());
    let slot = lowering.slotFor(binding);
    if (slot == null) {
        long sibling = defaults.siblingFieldAddress(lowering, binding);
        if (sibling >= 0) {
            return narrowedRead(lowering, identifier,
                places.loadFrom(lowering, sibling, bindingType), bindingType);
        }
        lowering.internalError("'{identifier.name().text()}' has no storage slot",
            identifier.span());
        return -1;
    }
    let builder = lowering.builder();
    long temp = builder.newTemp(bindingType);
    builder.append(new EirLoadSlot(temp, bindingType, slot));
    return narrowedRead(lowering, identifier, temp, bindingType);
}

// A read produces the type sema recorded for it, which flow narrowing may have proven shallower
// than the storage's own type: a value proven present at its outer level is its payload from here
// on. The projection belongs to the read, so no read depends on the storage being deeper. An
// assignment reads its target back this way.
public narrowedRead(LoweringContext lowering, Expression read, long value, Type storageType) -> long {
    if (value < 0) {
        return value;
    }
    let recorded = lowering.result().typeOf(read.green());
    if (recorded == null) {
        return value;
    }
    let narrowed = lowering.substituted(recorded);
    if (primitives.optionalDepth(narrowed) >= primitives.optionalDepth(storageType)) {
        return value;
    }
    return conversions.convert(lowering, value, narrowed, read.span());
}

lowerCast(LoweringContext lowering, CastExpressionNode cast) -> long {
    let targetType = lowering.typeOf(cast);
    if (targetType == null) {
        return -1;
    }
    if (!lowering.supportsValueType(targetType)) {
        lowering.unsupported(lowering.names().quotedCode(["as ", ""], [targetType]), cast.span());
        return -1;
    }
    long value = lower(lowering, cast.value());
    if (value < 0) {
        return -1;
    }
    return conversions.convert(lowering, value, targetType, cast.span());
}

lowerTernary(LoweringContext lowering, TernaryExpressionNode ternary) -> long {
    let resultType = lowering.typeOf(ternary);
    if (resultType == null) {
        return -1;
    }
    bool valued = !types.isVoidType(resultType);
    if (valued && !lowering.supportsValueType(resultType)) {
        lowering.unsupported("a '? :' expression of type {lowering.names().quoted(resultType)}",
            ternary.span());
        return -1;
    }
    long condition = lower(lowering, ternary.condition());
    if (condition < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long slot = -1;
    if (valued) {
        slot = ownership.defineJoinSlot(lowering, "ternary", resultType);
    }
    long thenBlock = builder.newBlock("ternary.then");
    long elseBlock = builder.newBlock("ternary.else");
    long merge = builder.newBlock("ternary.end");
    builder.terminate(new EirBranch(condition, thenBlock, elseBlock));
    bool joined = false;
    builder.moveTo(thenBlock);
    if (!lowerJoinValue(lowering, slot, resultType, ternary.thenValue())) {
        return -1;
    }
    if (!builder.terminated()) {
        builder.terminate(new EirJump(merge));
        joined = true;
    }
    builder.moveTo(elseBlock);
    if (!lowerJoinValue(lowering, slot, resultType, ternary.elseValue())) {
        return -1;
    }
    if (!builder.terminated()) {
        builder.terminate(new EirJump(merge));
        joined = true;
    }
    builder.moveTo(merge);
    if (!valued || !joined) {
        return -1;
    }
    return ownership.moveOutOf(lowering, slot, resultType);
}

// Lowers one value of a '?:' or of a switch used as a value into 'slot', the place the values
// merge through. A value that never returns, or one of a join of type 'void', is lowered as a
// statement of its own instead, so it ends its path or gives the merge nothing.
public lowerJoinValue(LoweringContext lowering, long slot, Type resultType, Expression value)
        -> bool {
    if (types.isVoidType(resultType) || lowering.result().neverReturns(value.green())) {
        statements.lowerDiscarded(lowering, value);
        return !lowering.failed();
    }
    return storeArm(lowering, slot, resultType, value);
}

// Writes one arm's value into the slot the branches merge through, which holds nothing yet and
// takes the value's own reference.
public storeArm(LoweringContext lowering, long slot, Type resultType, Expression value) -> bool {
    let operand = stores.lowerOperand(lowering, value, resultType);
    if (operand == null) {
        return false;
    }
    if (!primitives.hasArcContent(resultType)) {
        lowering.builder().append(new EirStoreSlot(slot, operand.value()));
        return true;
    }
    if (!stores.initializeSlot(lowering, slot, resultType, operand)) {
        lowering.internalError("a branch yields a struct with no storage to retain",
            value.span());
        return false;
    }
    return true;
}
