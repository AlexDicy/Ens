// Weak fields: storage that watches an object without keeping it alive. What the field holds is a
// side-table entry, not the object, so none of the three operations touches a strong count of the
// object itself.
//
// A write points the field at a new object and stops watching whatever it watched before. Because
// the write takes no strong ownership, a value that arrived owning a +1 is still the writer's to
// give up, which is the one place a store releases its own operand.
import Type from @ens.sema.model.types;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import LoweringContext from lower.context;
import Operand from lower.stores;
import lower.ownership;

// Points weak storage at what the operand names. A produced reference is released afterwards: the
// field watches the object but owns nothing, so nobody else would ever give that +1 up.
public store(LoweringContext lowering, long address, Operand operand) {
    lowering.builder().append(new EirWeakStore(address, operand.value()));
    if (operand.owned()) {
        ownership.releaseValue(lowering, operand.value());
    }
}

// Reads weak storage as a strong reference the reader owns, or as null when the object it watched
// is already gone.
public load(LoweringContext lowering, long address, Type fieldType) -> long {
    let builder = lowering.builder();
    long value = builder.newTemp(fieldType);
    builder.append(new EirWeakLoad(value, fieldType, address));
    return value;
}

// Stops watching, which is what an object's destructor does to each of its weak fields.
public release(LoweringContext lowering, long address) {
    lowering.builder().append(new EirWeakRelease(address));
}
