// Switch lowering, shared by the statement and the expression form: one integer switch terminator
// over the arm blocks, an unreachable default when the arms are exhaustive without one, and a
// single join block. The expression form routes every arm's value through a result slot.
import Expression from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchArm from @ens.frontend.syntax.generated.nodes;
import ArmBody from @ens.frontend.syntax.generated.nodes;
import ValueArmNode from @ens.frontend.syntax.generated.nodes;
import DefaultArmNode from @ens.frontend.syntax.generated.nodes;
import TypeArmNode from @ens.frontend.syntax.generated.nodes;
import ErrorSwitchArmNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import Type from @ens.sema.model.types;
import EnumType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirConstNull from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayload from eir.model;
import EirStoreSlot from eir.model;
import EirStringEqual from eir.model;
import EirJump from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import LoweringContext from lower.context;
import lower.classes;
import lower.expressions;
import lower.literals;
import lower.optionals;
import lower.ownership;
import lower.statements;
import lower.typetests;
import support.primitives;
import List from @std.collections.list;

public lowerStatement(LoweringContext lowering, SwitchStatementNode switched) {
    lowerSwitch(lowering, switched.scrutinee(), statementArms(switched), null, switched.span());
}

public lowerExpression(LoweringContext lowering, SwitchExpressionNode switched) -> long {
    let resultType = lowering.typeOf(switched);
    if (resultType == null) {
        return -1;
    }
    return lowerSwitch(lowering, switched.scrutinee(), expressionArms(switched), resultType,
        switched.span());
}

// Lowers a value switch over an integer scrutinee. With a result type the switch is an
// expression: every arm stores its converted value into the result slot; exactly one arm runs,
// and the merged value is loaded after the join. A switch whose arms test types is its own form
// and lowers as a chain of runtime type tests instead.
lowerSwitch(LoweringContext lowering, Expression scrutinee, List<SwitchArm> arms,
            Type? resultType, Span span) -> long {
    let scrutineeType = lowering.typeOf(scrutinee);
    if (scrutineeType == null) {
        return -1;
    }
    if (hasTypeArm(arms)) {
        return typetests.lowerTypeSwitch(lowering, scrutinee, arms, resultType, span);
    }
    if (isStringScrutinee(scrutineeType)) {
        return lowerStringSwitch(lowering, scrutinee, scrutineeType, arms, resultType, span);
    }
    let payloadType = primitives.taggedPayloadOf(scrutineeType);
    bool tagged = payloadType != null && primitives.isIntegerLike(payloadType);
    if (!primitives.isIntegerLike(scrutineeType) && !tagged) {
        lowering.unsupported("a switch over '{types.display(scrutineeType)}'", span);
        return -1;
    }
    if (resultType != null && !lowering.supportsValueType(resultType)) {
        lowering.unsupported("a switch producing '{types.display(resultType)}'", span);
        return -1;
    }
    long scrutineeValue = expressions.lower(lowering, scrutinee);
    if (scrutineeValue < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long resultSlot = -1;
    if (resultType != null) {
        resultSlot = ownership.defineMergeSlot(lowering, "switch", resultType);
    }
    let caseValues = new List<long>();
    let caseTargets = new List<long>();
    let armBlocks = new List<long>();
    long defaultTarget = -1;
    long nullTarget = -1;
    for (long a = 0; a < arms.length(); a++) {
        switch (arms.get(a)) {
            is ValueArmNode arm -> {
                long block = builder.newBlock("switch.case");
                armBlocks.push(block);
                for (long i = 0; i < arm.labelsCount(); i++) {
                    if (isNullLabel(lowering, arm.labels(i))) {
                        nullTarget = block;
                        continue;
                    }
                    let label = integerLabelBits(lowering, arm.labels(i));
                    if (label == null) {
                        return -1;
                    }
                    caseValues.push(label);
                    caseTargets.push(block);
                }
            },
            is DefaultArmNode arm -> {
                long block = builder.newBlock("switch.default");
                armBlocks.push(block);
                defaultTarget = block;
            },
            is TypeArmNode arm -> {
                lowering.internalError("a type arm reached the integer switch lowering",
                    arm.span());
                return -1;
            },
            is ErrorSwitchArmNode arm -> {
                lowering.internalError("a switch arm the parser could not read reached code "
                    + "generation", arm.span());
                return -1;
            },
        }
    }
    long unreachableBlock = -1;
    if (defaultTarget < 0) {
        unreachableBlock = builder.newBlock("switch.unreachable");
        defaultTarget = unreachableBlock;
    }
    long merge = builder.newBlock("switch.end");
    if (tagged && payloadType != null) {
        // An absent scrutinee takes the null arm, or the default when no arm names null; a
        // present one switches over the payload.
        if (nullTarget < 0) {
            nullTarget = defaultTarget;
        }
        long present = optionals.presenceOf(lowering, scrutineeValue, scrutineeType);
        long valueBlock = builder.newBlock("switch.present");
        builder.terminate(new EirBranch(present, valueBlock, nullTarget));
        builder.moveTo(valueBlock);
        long payload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayload(payload, payloadType, scrutineeValue));
        scrutineeValue = payload;
    }
    builder.terminate(new EirSwitch(scrutineeValue, caseValues.toArray(),
        caseTargets.toArray(), defaultTarget));
    if (unreachableBlock >= 0) {
        builder.moveTo(unreachableBlock);
        builder.terminate(new EirUnreachable());
    }
    for (long a = 0; a < arms.length(); a++) {
        let body = armBodyOf(arms.get(a));
        if (body == null) {
            continue;
        }
        builder.moveTo(armBlocks.get(a));
        lowerArmBody(lowering, body, resultType, resultSlot);
        if (lowering.failed()) {
            return -1;
        }
        if (!builder.terminated()) {
            builder.terminate(new EirJump(merge));
        }
    }
    builder.moveTo(merge);
    if (resultType == null) {
        return -1;
    }
    long temp = builder.newTemp(resultType);
    builder.append(new EirLoadSlot(temp, resultType, resultSlot));
    return temp;
}

// A switch over a string or string? scrutinee: a chain of content comparisons in source order,
// with a null arm caught by a pointer test before the chain runs. The scrutinee is borrowed for
// the whole statement, with an owned one parked in a scope-owned slot, so every arm compares the
// same reference and it is given up exactly once.
lowerStringSwitch(LoweringContext lowering, Expression scrutinee, Type scrutineeType,
                  List<SwitchArm> arms, Type? resultType, Span span) -> long {
    if (resultType != null && !lowering.supportsValueType(resultType)) {
        lowering.unsupported("a switch producing '{types.display(resultType)}'", span);
        return -1;
    }
    long scrutineeValue = classes.borrowedReference(lowering, scrutinee, scrutineeType);
    if (scrutineeValue < 0) {
        return -1;
    }
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long resultSlot = -1;
    if (resultType != null) {
        resultSlot = ownership.defineMergeSlot(lowering, "switch", resultType);
    }
    let armBlocks = new List<long>();
    let labelExpressions = new List<Expression>();
    let labelTargets = new List<long>();
    long defaultTarget = -1;
    long nullTarget = -1;
    for (long a = 0; a < arms.length(); a++) {
        switch (arms.get(a)) {
            is ValueArmNode arm -> {
                long block = builder.newBlock("switch.case");
                armBlocks.push(block);
                for (long i = 0; i < arm.labelsCount(); i++) {
                    if (isNullLabel(lowering, arm.labels(i))) {
                        nullTarget = block;
                        continue;
                    }
                    labelExpressions.push(arm.labels(i));
                    labelTargets.push(block);
                }
            },
            is DefaultArmNode arm -> {
                long block = builder.newBlock("switch.default");
                armBlocks.push(block);
                defaultTarget = block;
            },
            is TypeArmNode arm -> {
                lowering.internalError("a type arm reached the string switch lowering",
                    arm.span());
                return -1;
            },
            is ErrorSwitchArmNode arm -> {
                lowering.internalError("a switch arm the parser could not read reached code "
                    + "generation", arm.span());
                return -1;
            },
        }
    }
    long unreachableBlock = -1;
    if (defaultTarget < 0) {
        unreachableBlock = builder.newBlock("switch.unreachable");
        defaultTarget = unreachableBlock;
    }
    long merge = builder.newBlock("switch.end");
    if (primitives.isOptionalType(scrutineeType)) {
        long absent = builder.newTemp(scrutineeType);
        builder.append(new EirConstNull(absent, scrutineeType));
        long isAbsent = builder.newTemp(boolType);
        builder.append(new EirBinary(isAbsent, boolType, EirBinaryOp.CmpEq, scrutineeValue,
            absent));
        long chainBlock = builder.newBlock("switch.chain");
        long absentTarget = nullTarget;
        if (absentTarget < 0) {
            absentTarget = defaultTarget;
        }
        builder.terminate(new EirBranch(isAbsent, absentTarget, chainBlock));
        builder.moveTo(chainBlock);
    }
    for (long i = 0; i < labelExpressions.length(); i++) {
        long label = expressions.lower(lowering, labelExpressions.get(i));
        if (label < 0) {
            return -1;
        }
        long matched = builder.newTemp(boolType);
        builder.append(new EirStringEqual(matched, boolType, scrutineeValue, label));
        long next = builder.newBlock("switch.next");
        builder.terminate(new EirBranch(matched, labelTargets.get(i), next));
        builder.moveTo(next);
    }
    builder.terminate(new EirJump(defaultTarget));
    if (unreachableBlock >= 0) {
        builder.moveTo(unreachableBlock);
        builder.terminate(new EirUnreachable());
    }
    for (long a = 0; a < arms.length(); a++) {
        let body = armBodyOf(arms.get(a));
        if (body == null) {
            continue;
        }
        builder.moveTo(armBlocks.get(a));
        lowerArmBody(lowering, body, resultType, resultSlot);
        if (lowering.failed()) {
            return -1;
        }
        if (!builder.terminated()) {
            builder.terminate(new EirJump(merge));
        }
    }
    builder.moveTo(merge);
    if (resultType == null) {
        return -1;
    }
    long temp = builder.newTemp(resultType);
    builder.append(new EirLoadSlot(temp, resultType, resultSlot));
    return temp;
}

// True for a string or string? scrutinee, which dispatches by content comparison.
isStringScrutinee(Type scrutineeType) -> bool {
    if (primitives.isStringType(scrutineeType)) {
        return true;
    }
    if (!primitives.isOptionalType(scrutineeType)) {
        return false;
    }
    let referent = primitives.referenceOf(scrutineeType);
    return referent != null && primitives.isStringType(referent);
}

public lowerArmBody(LoweringContext lowering, ArmBody body, Type? resultType, long resultSlot) {
    switch (body) {
        is BlockNode block -> {
            statements.lowerBlock(lowering, block);
        },
        is Expression expression -> {
            if (resultType != null) {
                let stored = expressions.storeArm(lowering, resultSlot, resultType, expression);
            } else {
                let ignored = expressions.lower(lowering, expression);
            }
        },
        default -> {
            lowering.unsupported("this switch arm body",
                lowering.info().signature().nameSpan());
        },
    }
}

// True for the 'null' label an optional scrutinee's arm may carry.
isNullLabel(LoweringContext lowering, Expression label) -> bool {
    let labelType = lowering.result().typeOf(label.green());
    return labelType != null && primitives.isNullType(labelType);
}

// The constant an integer switch label names, as scrutinee-typed bits: a char literal's
// codepoint or an int or long literal's value behind an optional sign.
integerLabelBits(LoweringContext lowering, Expression label) -> long? {
    let constant = lowering.result().enumConstantOf(label.green());
    if (constant != null) {
        let labelType = lowering.typeOf(label);
        if (labelType == null) {
            return null;
        }
        if (!(labelType is EnumType)) {
            lowering.internalError("an enum switch label has type "
                + "'{types.display(labelType)}'", label.span());
            return null;
        }
        long[] values = labelType.memberValues();
        if (constant < 0 || constant >= values.length) {
            lowering.internalError("enum member {constant} is outside "
                + "'{types.display(labelType)}'", label.span());
            return null;
        }
        return values[constant];
    }
    Expression core = label;
    bool negative = false;
    if (core is PrefixExpressionNode) {
        negative = core.operator().kind() == SyntaxKind.Minus;
        core = core.operand();
    }
    if (!(core is LiteralExpressionNode)) {
        lowering.unsupported("this switch label", label.span());
        return null;
    }
    SyntaxKind kind = core.value().kind();
    if (kind == SyntaxKind.CharLiteral) {
        return literals.charCodepoint(core.value().text()) as long;
    }
    if (kind == SyntaxKind.IntLiteral || kind == SyntaxKind.LongLiteral) {
        let magnitude = literals.integerMagnitude(core.value().text());
        if (magnitude == null) {
            lowering.internalError("switch label '{core.value().text()}' does not parse",
                label.span());
            return null;
        }
        long value = magnitude as long;
        if (negative) {
            return 0 - value;
        }
        return value;
    }
    lowering.unsupported("this switch label", label.span());
    return null;
}

public armBodyOf(SwitchArm arm) -> ArmBody? {
    switch (arm) {
        is ValueArmNode value -> {
            return value.body();
        },
        is DefaultArmNode defaulted -> {
            return defaulted.body();
        },
        is TypeArmNode typed -> {
            return typed.body();
        },
        is ErrorSwitchArmNode ignored -> {
            return null;
        },
    }
}

hasTypeArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        if (arms.get(i) is TypeArmNode) {
            return true;
        }
    }
    return false;
}

statementArms(SwitchStatementNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        arms.push(node.arms(i));
    }
    return arms;
}

expressionArms(SwitchExpressionNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        arms.push(node.arms(i));
    }
    return arms;
}
