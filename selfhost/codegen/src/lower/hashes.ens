// The synthesized 'hash()' behind the '@std.hash' Hashable contract. Every Ens type satisfies
// the contract; a class or struct that declares its own conforming 'hash() -> long' answers
// through it, and everything else hashes by its contents: integers and enums by value, floats by
// bit pattern, strings by an FNV-1a fold of their bytes, references by identity, structs by
// folding their fields' hashes, and an optional by its payload's hash while it is present and by
// -1 once it is absent, whatever its inner type.
//
// Aggregates fold here in lowering, so emission only ever sees one leaf instruction; a class that
// declared its own hash is called mid-fold like any method.
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import InterfaceType from @ens.sema.model.types;
import Method from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirConstInt from eir.model;
import EirHashValue from eir.model;
import EirJump from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayload from eir.model;
import EirStoreSlot from eir.model;
import LoweringContext from lower.context;
import lower.calls;
import lower.classes;
import lower.conversions;
import lower.expressions;
import lower.optionals;
import lower.places;
import lower.records;
import lower.structs;
import support.primitives;

// True when the recorded method is the Hashable contract itself, which a bounded type parameter
// resolves calls against; the concrete receiver decides what actually answers.
public isHashableContract(Method method) -> bool {
    if (method.name() != "hash") {
        return false;
    }
    let authority = types.authorityOf(method.definingType());
    if (!(authority is InterfaceType)) {
        return false;
    }
    return authority.name() == "Hashable" && authority.modulePath() == "std.hash";
}

// 'value.hash()' where no declaration answers: the synthesized content hash.
public lowerSynthesizedHash(LoweringContext lowering, CallExpressionNode call,
                            Expression receiver, Type receiverType) -> long {
    if (primitives.structOf(receiverType) != null) {
        long address = structs.addressOf(lowering, receiver, receiverType);
        if (address < 0) {
            return -1;
        }
        return hashAt(lowering, address, receiverType, call.span());
    }
    if (!lowering.supportsValueType(receiverType)) {
        lowering.unsupported("hashing a '{types.display(receiverType)}'", call.span());
        return -1;
    }
    long value = expressions.lower(lowering, receiver);
    if (value < 0) {
        return -1;
    }
    // A receiver sema narrowed out of its optional storage arrives as the whole pair, so the read
    // projects the payload before it is folded, exactly like every other narrowed read.
    long adapted = conversions.convert(lowering, value, receiverType, call.span());
    if (adapted < 0) {
        return -1;
    }
    long hashed = hashOfValue(lowering, adapted, receiverType, call.span());
    expressions.releaseTemporary(lowering, receiver, value);
    return hashed;
}

// One loaded value's hash: an optional answers through its presence, a class that declared its own
// conforming hash answers through it, and everything else folds as a leaf.
hashOfValue(LoweringContext lowering, long value, Type type, Span span) -> long {
    if (primitives.isOptionalType(type)) {
        return hashOfOptional(lowering, value, type, span);
    }
    let classType = primitives.classOf(type);
    if (classType != null) {
        let declared = declaredHashOf(classType);
        if (declared != null) {
            return callDeclaredHash(lowering, classType, declared, value, span);
        }
    }
    return hashLeaf(lowering, value);
}

// An optional hashes as its payload does when its presence says it holds one, and as -1 whatever
// its inner type when it is absent, so an absent value never reads a payload that holds nothing.
// The two paths merge through a slot, the phi-free form every branching value in lowering uses.
hashOfOptional(LoweringContext lowering, long value, Type optionalType, Span span) -> long {
    let payloadType = payloadTypeOf(optionalType);
    if (payloadType == null) {
        return -1;
    }
    let builder = lowering.builder();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long answer = builder.addSlot("opthash", longType, false, false);
    long present = optionals.presenceOf(lowering, value, optionalType);
    long presentBlock = builder.newBlock("opthash.present");
    long absentBlock = builder.newBlock("opthash.absent");
    long endBlock = builder.newBlock("opthash.end");
    builder.terminate(new EirBranch(present, presentBlock, absentBlock));

    builder.moveTo(presentBlock);
    long payloadHash = hashOfPayload(lowering, value, payloadType, span);
    if (payloadHash < 0) {
        return -1;
    }
    builder.append(new EirStoreSlot(answer, payloadHash));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(absentBlock);
    long missing = builder.newTemp(longType);
    builder.append(new EirConstInt(missing, longType, -1));
    builder.append(new EirStoreSlot(answer, missing));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    long merged = builder.newTemp(longType);
    builder.append(new EirLoadSlot(merged, longType, answer));
    return merged;
}

// What an optional holds while it is present: a tagged optional's payload, or the referent a
// nullable reference points at, which is the same pointer under its non-optional name.
payloadTypeOf(Type optionalType) -> Type? {
    let tagged = primitives.taggedPayloadOf(optionalType);
    if (tagged != null) {
        return tagged;
    }
    return primitives.referenceOf(optionalType);
}

// The present payload's hash: a struct folds its fields over a scratch copy of the payload, so it
// reads out of real storage, a reference hashes exactly as its non-optional spelling does, and
// everything else is a leaf.
hashOfPayload(LoweringContext lowering, long value, Type payloadType, Span span) -> long {
    if (primitives.structOf(payloadType) != null) {
        long base = optionals.taggedScratchAddress(lowering, value, payloadType);
        if (base < 0) {
            lowering.internalError("the hashed payload borrows a value with no storage to retain",
                span);
            return -1;
        }
        return hashAt(lowering, base, payloadType, span);
    }
    if (primitives.isReferenceType(payloadType)) {
        long referent = conversions.convert(lowering, value, payloadType, span);
        if (referent < 0) {
            return -1;
        }
        return hashOfValue(lowering, referent, payloadType, span);
    }
    let builder = lowering.builder();
    long payload = builder.newTemp(payloadType);
    builder.append(new EirOptionalPayload(payload, payloadType, value));
    return hashLeaf(lowering, payload);
}

// The FNV-1a fold of a struct's fields, each by its own hash: nested structs recurse in place,
// a class field with a declared conforming hash is asked, and every other field is a leaf.
hashAt(LoweringContext lowering, long base, Type structType, Span span) -> long {
    let builder = lowering.builder();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long hash = builder.newTemp(longType);
    builder.append(new EirConstInt(hash, longType, -3750763034362895579));
    let fields = records.fieldsOf(structType);
    if (fields == null) {
        return hash;
    }
    for (long i = 0; i < fields.length(); i++) {
        let fieldType = fields.get(i).type();
        long fieldAddress = structs.fieldAddressAt(lowering, base, fieldType, i);
        long fieldHash = -1;
        if (primitives.structOf(fieldType) != null) {
            fieldHash = hashAt(lowering, fieldAddress, fieldType, span);
        } else {
            long value = places.loadFrom(lowering, fieldAddress, fieldType);
            fieldHash = hashOfValue(lowering, value, fieldType, span);
        }
        if (fieldHash < 0) {
            return -1;
        }
        long mixed = builder.newTemp(longType);
        builder.append(new EirBinary(mixed, longType, EirBinaryOp.Xor, hash, fieldHash));
        long prime = builder.newTemp(longType);
        builder.append(new EirConstInt(prime, longType, 1099511628211));
        long folded = builder.newTemp(longType);
        builder.append(new EirBinary(folded, longType, EirBinaryOp.Mul, mixed, prime));
        hash = folded;
    }
    return hash;
}

// The 'hash' a class declared for itself, dispatched like any other method call.
callDeclaredHash(LoweringContext lowering, Type classType, Method declared, long value, Span span)
        -> long {
    let info = lowering.index().infoFor(declared.signature());
    if (info == null || !calls.supportedDispatchTarget(lowering, info, "method 'hash'", span)) {
        return -1;
    }
    return calls.emitCall(lowering, info, classType, value, [],
        lowering.tables().vtableSlotOf(declared.signature()), null, span);
}

hashLeaf(LoweringContext lowering, long value) -> long {
    let builder = lowering.builder();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long hashed = builder.newTemp(longType);
    builder.append(new EirHashValue(hashed, longType, value));
    return hashed;
}

// The conforming 'hash() -> long' a class declares or inherits, or null when the synthesized
// identity hash stands in.
declaredHashOf(Type classType) -> Method? {
    Type? current = classType;
    while (current != null) {
        let methods = types.methodsOf(current);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.isConstructor() || method.isDestructor() || method.name() != "hash") {
                continue;
            }
            let signature = method.signature();
            if (signature.parameters().length != 0 || signature.declaresThrows()) {
                continue;
            }
            return method;
        }
        current = types.baseOf(current);
    }
    return null;
}
