// The '@std.parallel' intercept: whether two arrays are one array, which the library's 'Storage'
// asks to tell the array a 'split' writes from one it reads, so the call compares the two
// references and its Ens body never runs.
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import Method from @ens.sema.model.typemembers;
import ClassType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirCast from eir.model;
import EirCastOp from eir.model;
import LoweringContext from lower.context;
import lower.expressions;
import lower.ownership;
import lower.places;

final class Modules {
    protected static const string parallel = "std.parallel";
}

public isIntercepted(Type receiverType, Method method) -> bool {
    return receiverType is ClassType && receiverType.name() == "Storage"
        && receiverType.modulePath() == Modules.parallel && method.name() == "same";
}

public lowerCall(LoweringContext lowering, CallExpressionNode call, MemberExpressionNode callee)
        -> long {
    let arguments = call.arguments();
    let first = arguments.arguments(0);
    let second = arguments.arguments(1);
    if (arguments.argumentsCount() != 2 || !(first is Expression) || !(second is Expression)) {
        lowering.internalError("'Storage.same' reached lowering without its two arrays",
            call.span());
        return -1;
    }
    let firstType = lowering.typeOf(first);
    if (firstType == null) {
        return -1;
    }
    long left = expressions.lower(lowering, first);
    long right = expressions.lower(lowering, second);
    if (left < 0 || right < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long renamed = builder.newTemp(firstType);
    builder.append(new EirCast(renamed, firstType, EirCastOp.Reinterpret, right));
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long same = builder.newTemp(boolType);
    builder.append(new EirBinary(same, boolType, EirBinaryOp.CmpEq, left, renamed));
    if (places.producesOwnedValue(lowering, first)) {
        ownership.releaseValue(lowering, left);
    }
    if (places.producesOwnedValue(lowering, second)) {
        ownership.releaseValue(lowering, right);
    }
    return same;
}
