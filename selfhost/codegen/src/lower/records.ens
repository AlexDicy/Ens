// Field access shared by structs and classes. A struct is stored inline, so its base is the address of
// its storage, while a class is behind a reference, so its base is the reference. Both project
// by the same symbolic field index, which is what lets the store barriers work over either.
import Field from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirFieldAddress from eir.model;
import EirObjectFieldAddress from eir.model;
import LoweringContext from lower.context;
import support.primitives;
import List from @std.collections.list;

// The fields a struct or class declares, or null for anything else. A class's list is flattened,
// inherited fields first, so an index counts over the whole layout. An instantiation exposes its
// substituted fields the same way.
public fieldsOf(Type record) -> List<Field>? {
    if (record is StructType) {
        return record.fields();
    }
    let classType = primitives.classOf(record);
    if (classType != null) {
        return types.fieldsOf(classType);
    }
    let structType = primitives.structOf(record);
    if (structType != null) {
        return types.fieldsOf(structType);
    }
    return null;
}

// The address of one field inside the record a destination names: a projection from a struct's
// address, or from the object a class reference points at. The index is the field's position in
// the record's layout, which types.inheritedOrOwnFieldIndex resolves a name to, and which the
// record's LLVM struct uses as its element index.
public fieldAddressIn(LoweringContext lowering, long destination, Type record, Type fieldType,
                      long index) -> long {
    let builder = lowering.builder();
    long address = builder.newTemp(fieldType);
    if (primitives.classOf(record) != null) {
        builder.append(new EirObjectFieldAddress(address, fieldType, destination, index));
    } else {
        builder.append(new EirFieldAddress(address, fieldType, destination, index));
    }
    return address;
}
