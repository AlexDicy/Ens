// Field access shared by structs and classes: the fields a record declares, the position of one,
// and the address of one inside the storage the record occupies. A struct sits inline, so its base
// is the address of that storage; a class sits behind a reference, so its base is the reference.
// Both project by the same symbolic field index, which is what lets the field defaults and the
// store barriers work over either without knowing which they have.
import Field from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirFieldAddress from eir.model;
import EirObjectFieldAddress from eir.model;
import LoweringContext from lower.context;
import support.primitives;
import List from @std.collections.list;

// The fields a struct or class declares, or null for anything else. A class's list is flattened,
// inherited fields first, so an index counts over the whole layout. An instantiation exposes its
// substituted fields the same way.
public fieldsOf(Type record) -> List<Field>? {
    if (record is StructType) {
        return record.fields();
    }
    let classType = primitives.classOf(record);
    if (classType != null) {
        return types.fieldsOf(classType);
    }
    let structType = primitives.structOf(record);
    if (structType != null) {
        return types.fieldsOf(structType);
    }
    return null;
}

// The position of a field in its record's layout, which is the symbolic index an address carries
// and the element index its LLVM struct uses, or -1 for a name the record does not have.
public fieldIndexOf(Type record, string name) -> long {
    let fields = fieldsOf(record);
    if (fields == null) {
        return -1;
    }
    // Searched most derived first, the way sema resolves the name: a subclass field may reuse
    // the name of a private base field, and the two hold slots of their own.
    for (long i = fields.length() - 1; i >= 0; i--) {
        if (fields.get(i).name() == name) {
            return i;
        }
    }
    return -1;
}

// The address of one field inside the record a destination names: a projection from a struct's
// address, or from the object a class reference points at.
public fieldAddressIn(LoweringContext lowering, long destination, Type record, Type fieldType,
                      long index) -> long {
    let builder = lowering.builder();
    long address = builder.newTemp(fieldType);
    if (primitives.classOf(record) != null) {
        builder.append(new EirObjectFieldAddress(address, fieldType, destination, index));
    } else {
        builder.append(new EirFieldAddress(address, fieldType, destination, index));
    }
    return address;
}
