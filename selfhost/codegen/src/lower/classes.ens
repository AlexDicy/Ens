// Classes as heap objects: creating one, reading and writing a field of one, calling a method on
// one, and the 'this' a method runs over. A class value is the reference, so nothing here builds
// storage the way a struct literal does; the object is allocated, its defaults are filled in place,
// and its constructor runs over the same reference the expression hands back.
//
// The +1 a 'new' produces belongs to whoever takes the value. An object reached only to read a
// field or call a method is parked in a slot the enclosing scope owns, so the borrowed pointer that
// comes back stays valid for as long as anything can use it and the +1 is given up exactly once.
import Expression from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import NewExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import ClassType from @ens.sema.model.types;
import DeclaredType from @ens.sema.model.types;
import Field from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import Method from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirClassNew from eir.model;
import EirErrorTrace from eir.model;
import EirLoadSlot from eir.model;
import layout.vtables;
import LoweringContext from lower.context;
import lower.calls;
import lower.conversions;
import lower.defaults;
import lower.expressions;
import lower.ownership;
import lower.places;
import lower.records;
import lower.stores;
import lower.symbols;
import lower.throwing;
import lower.weakfields;
import support.primitives;

// The user destructor a class declares, or null when it declares none.
public declaredDestructor(Type classType) -> Method? {
    let methods = types.methodsOf(classType);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).isDestructor()) {
            return methods.get(i);
        }
    }
    return null;
}

// The linker symbol of the destructor an object of this class stores in its header. An
// instantiation's is named by its module-independent instantiation name; a declared class's by
// its module and name.
public destructorSymbol(Type classType) -> string {
    if (classType is InstantiationType) {
        return symbols.instanceDestructorLinkName(classType);
    }
    let authority = types.authorityOf(classType);
    if (authority != null) {
        return symbols.destructorLinkName(authority.modulePath(), authority.name());
    }
    return "_dtor$" + types.display(classType);
}

// The concrete method a recorded resolution reaches once the receiver's type is substituted.
// Sema checks a template's body once, so a call inside one records the template's own method, or
// a generic base's; the instance the call targets exists only per instantiation. The mapping is
// positional - an instantiation's methods are filled parallel to its template's - so overloads
// that collapse to one parameter list after substitution still resolve to the right one.
public resolveConcreteMethod(LoweringContext lowering, Type receiver, Method recorded)
        -> Method? {
    let definingType = recorded.definingType();
    if (receiver == definingType) {
        return recorded;
    }
    let authority = types.authorityOf(definingType);
    Type? current = receiver;
    while (current != null) {
        if (current == definingType) {
            return recorded;
        }
        if (types.authorityOf(current) == authority) {
            let definingMethods = types.methodsOf(definingType);
            let currentMethods = types.methodsOf(current);
            if (definingMethods == null || currentMethods == null) {
                return null;
            }
            for (long i = 0; i < definingMethods.length(); i++) {
                if (definingMethods.get(i) == recorded && i < currentMethods.length()) {
                    return currentMethods.get(i);
                }
            }
            return null;
        }
        current = types.baseOf(current);
    }
    return null;
}

// The interface method with the active substitution applied. A bound like 'Comparable<T>'
// records its member against the open instantiation, whose parameter types still mention the
// template's parameters; the concrete instantiation's lists fill parallel to it, so the position
// transfers, and the concrete member's parameter types are what a class implementation repeats.
concreteInterfaceMethod(LoweringContext lowering, Method recorded) -> Method {
    Type concreteOwner = lowering.substituted(recorded.definingType());
    if (concreteOwner == recorded.definingType()) {
        return recorded;
    }
    let recordedMethods = types.methodsOf(recorded.definingType());
    let concreteMethods = types.methodsOf(concreteOwner);
    if (recordedMethods == null || concreteMethods == null) {
        return recorded;
    }
    for (long i = 0; i < recordedMethods.length(); i++) {
        if (recordedMethods.get(i) == recorded && i < concreteMethods.length()) {
            return concreteMethods.get(i);
        }
    }
    return recorded;
}

// The class's own implementation of an interface-declared method, found the way a conformance
// table is built: the nearest declaration down the chain with the method's name and parameter
// types. Null when no class in the chain declares one, which for the built-in contracts (hash)
// means the synthesized behavior stands in.
public implementationOnClass(Type receiver, Method interfaceMethod) -> Method? {
    Type? current = receiver;
    while (current != null) {
        let methods = types.methodsOf(current);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.isConstructor() || method.isDestructor()
                    || method.name() != interfaceMethod.name()) {
                continue;
            }
            if (primitives.sameParameterTypes(method.signature(),
                    interfaceMethod.signature())) {
                return method;
            }
        }
        current = types.baseOf(current);
    }
    return null;
}

// 'new C(args)': a zeroed object whose header names its destructor, then the declared field
// defaults of the whole chain, then the constructor over the same reference. A class declaring no
// constructor of its own still runs the nearest inherited one callable with no arguments; only a
// chain with no constructor at all is complete once its defaults are in place.
public lowerNew(LoweringContext lowering, NewExpressionNode node) -> long {
    let type = lowering.typeOf(node);
    if (type == null) {
        return -1;
    }
    let classType = primitives.classOf(type);
    if (classType == null || !lowering.supportsClassLayout(classType)) {
        lowering.unsupported("creating a '{types.display(type)}'", node.span());
        return -1;
    }
    let builder = lowering.builder();
    long object = builder.newTemp(type);
    builder.append(new EirClassNew(object, type, destructorSymbol(classType)));
    if (!defaults.applyClassDefaults(lowering, object, classType, node.span())) {
        return -1;
    }
    Method? initializer = lowering.result().methodOf(node.green());
    if (initializer != null) {
        initializer = resolveConcreteMethod(lowering, classType, initializer);
    } else {
        initializer = inheritedConstructor(classType);
    }
    if (initializer == null) {
        return object;
    }
    let info = lowering.index().infoFor(initializer.signature());
    if (info == null) {
        lowering.internalError("the constructor of '{types.display(classType)}' resolves to no "
            + "indexed function", node.span());
        return -1;
    }
    if (!calls.supportedCallee(lowering, info, "constructor of '{types.display(classType)}'",
            node.span())) {
        return -1;
    }
    // The fresh object is owned here and nowhere else yet, so an argument that unwinds must
    // release it; its zeroed and defaulted fields make the destructor safe to run early.
    lowering.protectValue(object);
    let ignored = calls.lowerInvocation(lowering, info, node.arguments(), node.green(),
        node.span(), classType, object);
    lowering.unprotectValue(object);
    if (lowering.failed()) {
        return -1;
    }
    return object;
}

// The constructor a class with none of its own runs: the nearest one up the chain callable with
// no arguments, a zero-parameter one preferred over one whose parameters all take defaults.
inheritedConstructor(Type classType) -> Method? {
    let current = vtables.baseClassOf(classType);
    while (current != null) {
        let found = implicitConstructorOf(current);
        if (found != null) {
            return found;
        }
        current = vtables.baseClassOf(current);
    }
    return null;
}

// The constructor an implicit call binds on one class, or null when the class declares none that
// takes no arguments. The choice rule lives with the sema model, where the body checks ask
// whether the same winner exists on the instantiation before lowering can reach it.
public implicitConstructorOf(Type classType) -> Method? {
    return types.implicitConstructorChoice(classType);
}

// 'value.field' as an address, or -1 when the base names no class field.
public lowerFieldAddress(LoweringContext lowering, MemberExpressionNode member) -> long {
    let objectType = lowering.typeOf(member.object());
    if (objectType == null) {
        return -1;
    }
    let classType = primitives.classOf(objectType);
    if (classType == null) {
        return -1;
    }
    long index = records.fieldIndexOf(classType, member.member().text());
    if (index < 0) {
        return -1;
    }
    if (!lowering.supportsClassLayout(classType)) {
        lowering.unsupported("reaching into a '{types.display(classType)}'", member.span());
        return -1;
    }
    let fields = records.fieldsOf(classType);
    if (fields == null) {
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), objectType);
    if (object < 0) {
        return -1;
    }
    return records.fieldAddressIn(lowering, object, classType, fields.get(index).type(), index);
}

// The field a member expression names on a class, or null when it names something else.
public fieldOf(LoweringContext lowering, Expression node) -> Field? {
    if (!(node is MemberExpressionNode)) {
        return null;
    }
    let recordedType = lowering.result().typeOf(node.object().green());
    if (recordedType == null) {
        return null;
    }
    let classType = primitives.classOf(lowering.substituted(recordedType));
    if (classType == null) {
        return null;
    }
    long index = records.fieldIndexOf(classType, node.member().text());
    if (index < 0) {
        return null;
    }
    let fields = records.fieldsOf(classType);
    if (fields == null) {
        return null;
    }
    return fields.get(index);
}

// True when an expression names a weak field, which is read and written by its own operations
// rather than by a plain load and store.
public readsWeakField(LoweringContext lowering, Expression node) -> bool {
    let field = fieldOf(lowering, node);
    return field != null && field.isWeak();
}

// 'value.field' as a value. A strong field hands back what it holds, borrowed; a weak one upgrades
// to a strong reference the reader owns, or to null when the object it watched is gone.
public lowerFieldRead(LoweringContext lowering, MemberExpressionNode member, Field field,
                      Type resultType) -> long {
    long address = lowerFieldAddress(lowering, member);
    if (address < 0) {
        if (!lowering.failed()) {
            lowering.unsupported("reading the field '{field.name()}' of this expression",
                member.span());
        }
        return -1;
    }
    if (field.isWeak()) {
        return conversions.convert(lowering, weakfields.load(lowering, address, field.type()),
            resultType, member.span());
    }
    return places.readFrom(lowering, address, resultType, member.span());
}

// 'value.method(args)': the method runs over the reference the receiver expression names, which is
// the same pointer the object was allocated at. A method with a vtable slot dispatches through the
// receiver's runtime type; a 'super.' receiver stays a direct call to the inherited
// implementation, which is what bypassing an override means.
public lowerMethodCall(LoweringContext lowering, CallExpressionNode call,
                       MemberExpressionNode member, Method method) -> long {
    let receiverType = lowering.typeOf(member.object());
    if (receiverType == null) {
        return -1;
    }
    let classType = primitives.classOf(receiverType);
    if (classType == null || !lowering.supportsClassLayout(classType)) {
        lowering.unsupported("calling the method '{method.name()}' on "
            + "'{types.display(receiverType)}'", call.span());
        return -1;
    }
    if (throwing.isInterceptedTraceMethod(method.definingType(), method)) {
        return lowerTraceRead(lowering, call, member, method, receiverType);
    }
    Method? resolved = resolveConcreteMethod(lowering, classType, method);
    if (resolved == null && primitives.interfaceOf(method.definingType()) != null) {
        resolved = implementationOnClass(classType, concreteInterfaceMethod(lowering, method));
    }
    if (resolved == null) {
        lowering.internalError("the method '{types.display(classType)}.{method.name()}' "
            + "resolves to no concrete method", call.span());
        return -1;
    }
    let info = lowering.index().infoFor(resolved.signature());
    if (info == null) {
        lowering.internalError("the method '{types.display(classType)}.{method.name()}' "
            + "resolves to no indexed function", call.span());
        return -1;
    }
    long dispatchSlot = -1;
    if (!resolved.isConstructor() && !(member.object() is SuperExpressionNode)) {
        dispatchSlot = lowering.tables().vtableSlotOf(resolved.signature());
    }
    string described = "method '{types.display(classType)}.{method.name()}'";
    if (dispatchSlot >= 0) {
        if (!calls.supportedDispatchTarget(lowering, info, described, call.span())) {
            return -1;
        }
    } else if (!calls.supportedCallee(lowering, info, described, call.span())) {
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), receiverType);
    if (object < 0) {
        return -1;
    }
    return calls.lowerDispatchedCall(lowering, info, call, classType, object, dispatchSlot,
        null);
}

// 'e.stackTrace()' and 'e.stackFrames()': the placeholder bodies the standard library writes are
// never emitted; the call reads the trace the error captured when it was thrown, symbolicated
// into text or frames by the runtime.
lowerTraceRead(LoweringContext lowering, CallExpressionNode call, MemberExpressionNode member,
               Method method, Type receiverType) -> long {
    let resultType = lowering.typeOf(call);
    if (resultType == null) {
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), receiverType);
    if (object < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long result = builder.newTemp(resultType);
    builder.append(new EirErrorTrace(result, resultType, object,
        method.name() == "stackFrames"));
    return result;
}

// 'value.method(args)' on an interface-typed receiver: the implementation is read from the
// runtime type's method table for the interface that declared the method, which for an
// inherited requirement is an interface the receiver's own type extends.
public lowerInterfaceCall(LoweringContext lowering, CallExpressionNode call,
                          MemberExpressionNode member, Method method) -> long {
    let receiverType = lowering.typeOf(member.object());
    if (receiverType == null) {
        return -1;
    }
    let interfaceType = primitives.interfaceOf(receiverType);
    if (interfaceType == null
            || (interfaceType is DeclaredType && interfaceType.isGeneric())) {
        lowering.unsupported("calling the method '{method.name()}' on "
            + "'{types.display(receiverType)}'", call.span());
        return -1;
    }
    let resolved = resolveConcreteMethod(lowering, interfaceType, method);
    if (resolved == null) {
        lowering.internalError("the interface method "
            + "'{types.display(interfaceType)}.{method.name()}' resolves to no concrete method",
            call.span());
        return -1;
    }
    let info = lowering.index().infoFor(resolved.signature());
    if (info == null) {
        lowering.internalError("the interface method "
            + "'{types.display(interfaceType)}.{method.name()}' resolves to no indexed function",
            call.span());
        return -1;
    }
    if (!calls.supportedDispatchTarget(lowering, info,
            "interface method '{types.display(interfaceType)}.{method.name()}'", call.span())) {
        return -1;
    }
    long dispatchSlot = lowering.tables().itableSlotOf(resolved.signature());
    if (dispatchSlot < 0) {
        lowering.internalError("the interface method "
            + "'{types.display(interfaceType)}.{method.name()}' has no slot in its method "
            + "table", call.span());
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), receiverType);
    if (object < 0) {
        return -1;
    }
    return calls.lowerDispatchedCall(lowering, info, call, interfaceType, object, dispatchSlot,
        resolved.definingType());
}

// A bare 'this' inside a class method: the reference the method was handed, which is temp 0.
public lowerReceiver(LoweringContext lowering) -> long {
    return 0;
}

// A reference to read through, borrowed. An expression that produces a +1 is parked in a slot the
// enclosing scope owns: the value read back is then somebody else's to release, so every path out
// of the enclosing scope gives the reference up exactly once, whichever way the reader uses it.
public borrowedReference(LoweringContext lowering, Expression node, Type type) -> long {
    if (!places.producesOwnedValue(lowering, node)) {
        return expressions.lowerConverted(lowering, node, type);
    }
    let operand = stores.lowerOperand(lowering, node, type);
    if (operand == null) {
        return -1;
    }
    let builder = lowering.builder();
    long slot = builder.addSlot("held", type, true, false);
    if (!stores.assignSlot(lowering, slot, type, operand)) {
        lowering.internalError("a produced reference could not be parked in a slot",
            node.span());
        return -1;
    }
    ownership.trackSlot(lowering, slot, type);
    long value = builder.newTemp(type);
    builder.append(new EirLoadSlot(value, type, slot));
    return value;
}
