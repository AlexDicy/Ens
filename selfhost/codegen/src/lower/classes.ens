// Classes as heap objects: creating one, reading and writing a field of one, calling a method on
// one, and the 'this' a method runs over. A class value is the reference, so nothing here builds
// storage the way a struct literal does; the object is allocated, its defaults are filled in place,
// and its constructor runs over the same reference the expression hands back.
//
// The +1 a 'new' produces belongs to whoever takes the value. An object reached only to read a
// field or call a method is parked in a slot the enclosing scope owns, so the borrowed pointer that
// comes back stays valid for as long as anything can use it and the +1 is given up exactly once.
import Expression from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import NewExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import ClassType from @ens.sema.model.types;
import Field from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import Method from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirClassNew from eir.model;
import EirLoadSlot from eir.model;
import layout.vtables;
import LoweringContext from lower.context;
import lower.calls;
import lower.conversions;
import lower.defaults;
import lower.expressions;
import lower.ownership;
import lower.places;
import lower.records;
import lower.stores;
import lower.symbols;
import lower.weakfields;
import support.primitives;

// The user destructor a class declares, or null when it declares none.
public declaredDestructor(ClassType classType) -> Method? {
    let methods = classType.methods();
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).isDestructor()) {
            return methods.get(i);
        }
    }
    return null;
}

// The linker symbol of the destructor an object of this class stores in its header.
public destructorSymbol(ClassType classType) -> string {
    return symbols.destructorLinkName(classType.modulePath(), classType.name());
}

// 'new C(args)': a zeroed object whose header names its destructor, then the declared field
// defaults of the whole chain, then the constructor over the same reference. A class declaring no
// constructor of its own still runs the nearest inherited one callable with no arguments; only a
// chain with no constructor at all is complete once its defaults are in place.
public lowerNew(LoweringContext lowering, NewExpressionNode node) -> long {
    let type = lowering.typeOf(node);
    if (type == null) {
        return -1;
    }
    let classType = primitives.classOf(type);
    if (classType == null || !lowering.supportsClassLayout(classType)) {
        lowering.unsupported("creating a '{types.display(type)}'", node.span());
        return -1;
    }
    let builder = lowering.builder();
    long object = builder.newTemp(type);
    builder.append(new EirClassNew(object, type, destructorSymbol(classType)));
    if (!defaults.applyClassDefaults(lowering, object, classType, node.span())) {
        return -1;
    }
    let initializer = lowering.result().methodOf(node.green());
    if (initializer == null) {
        initializer = inheritedConstructor(classType);
    }
    if (initializer == null) {
        return object;
    }
    let info = lowering.index().infoFor(initializer.signature());
    if (info == null) {
        lowering.internalError("the constructor of '{classType.name()}' resolves to no indexed "
            + "function", node.span());
        return -1;
    }
    if (!calls.supportedCallee(lowering, info, "constructor of '{classType.name()}'",
            node.span())) {
        return -1;
    }
    let ignored = calls.lowerInvocation(lowering, info, node.arguments(), node.green(),
        node.span(), classType, object);
    if (lowering.failed()) {
        return -1;
    }
    return object;
}

// The constructor a class with none of its own runs: the nearest one up the chain callable with
// no arguments, a zero-parameter one preferred over one whose parameters all take defaults.
inheritedConstructor(ClassType classType) -> Method? {
    let current = vtables.baseClassOf(classType);
    while (current != null) {
        let found = implicitConstructorOf(current);
        if (found != null) {
            return found;
        }
        current = vtables.baseClassOf(current);
    }
    return null;
}

// The constructor an implicit call binds on one class, or null when the class declares none that
// takes no arguments.
public implicitConstructorOf(ClassType classType) -> Method? {
    Method? fallback = null;
    let methods = classType.methods();
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (!method.isConstructor()) {
            continue;
        }
        if (method.signature().parameters().length == 0) {
            return method;
        }
        if (fallback == null && requiredParameterCount(method.signature()) == 0) {
            fallback = method;
        }
    }
    return fallback;
}

requiredParameterCount(Signature signature) -> long {
    let parameters = signature.parameters();
    long required = 0;
    for (long i = 0; i < parameters.length; i++) {
        if (parameters[i].hasDefault()) {
            break;
        }
        required++;
    }
    return required;
}

// 'value.field' as an address, or -1 when the base names no class field.
public lowerFieldAddress(LoweringContext lowering, MemberExpressionNode member) -> long {
    let objectType = lowering.typeOf(member.object());
    if (objectType == null) {
        return -1;
    }
    let classType = primitives.classOf(objectType);
    if (classType == null) {
        return -1;
    }
    long index = records.fieldIndexOf(classType, member.member().text());
    if (index < 0) {
        return -1;
    }
    if (!lowering.supportsClassLayout(classType)) {
        lowering.unsupported("reaching into a '{types.display(classType)}'", member.span());
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), objectType);
    if (object < 0) {
        return -1;
    }
    return records.fieldAddressIn(lowering, object, classType,
        classType.fields().get(index).type(), index);
}

// The field a member expression names on a class, or null when it names something else.
public fieldOf(LoweringContext lowering, Expression node) -> Field? {
    if (!(node is MemberExpressionNode)) {
        return null;
    }
    let objectType = lowering.result().typeOf(node.object().green());
    if (objectType == null) {
        return null;
    }
    let classType = primitives.classOf(objectType);
    if (classType == null) {
        return null;
    }
    long index = records.fieldIndexOf(classType, node.member().text());
    if (index < 0) {
        return null;
    }
    return classType.fields().get(index);
}

// True when an expression names a weak field, which is read and written by its own operations
// rather than by a plain load and store.
public readsWeakField(LoweringContext lowering, Expression node) -> bool {
    let field = fieldOf(lowering, node);
    return field != null && field.isWeak();
}

// 'value.field' as a value. A strong field hands back what it holds, borrowed; a weak one upgrades
// to a strong reference the reader owns, or to null when the object it watched is gone.
public lowerFieldRead(LoweringContext lowering, MemberExpressionNode member, Field field,
                      Type resultType) -> long {
    long address = lowerFieldAddress(lowering, member);
    if (address < 0) {
        if (!lowering.failed()) {
            lowering.unsupported("reading the field '{field.name()}' of this expression",
                member.span());
        }
        return -1;
    }
    if (field.isWeak()) {
        return conversions.convert(lowering, weakfields.load(lowering, address, field.type()),
            resultType, member.span());
    }
    return places.readFrom(lowering, address, resultType, member.span());
}

// 'value.method(args)': the method runs over the reference the receiver expression names, which is
// the same pointer the object was allocated at. A method with a vtable slot dispatches through the
// receiver's runtime type; a 'super.' receiver stays a direct call to the inherited
// implementation, which is what bypassing an override means.
public lowerMethodCall(LoweringContext lowering, CallExpressionNode call,
                       MemberExpressionNode member, Method method) -> long {
    let receiverType = lowering.typeOf(member.object());
    if (receiverType == null) {
        return -1;
    }
    let classType = primitives.classOf(receiverType);
    if (classType == null || !lowering.supportsClassLayout(classType)) {
        lowering.unsupported("calling the method '{method.name()}' on "
            + "'{types.display(receiverType)}'", call.span());
        return -1;
    }
    let info = lowering.index().infoFor(method.signature());
    if (info == null) {
        lowering.internalError("the method '{classType.name()}.{method.name()}' resolves to no "
            + "indexed function", call.span());
        return -1;
    }
    long dispatchSlot = -1;
    if (!method.isConstructor() && !(member.object() is SuperExpressionNode)) {
        dispatchSlot = lowering.tables().vtableSlotOf(method.signature());
    }
    string described = "method '{classType.name()}.{method.name()}'";
    if (dispatchSlot >= 0) {
        if (!calls.supportedDispatchTarget(lowering, info, described, call.span())) {
            return -1;
        }
    } else if (!calls.supportedCallee(lowering, info, described, call.span())) {
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), receiverType);
    if (object < 0) {
        return -1;
    }
    return calls.lowerDispatchedCall(lowering, info, call, classType, object, dispatchSlot,
        null);
}

// 'value.method(args)' on an interface-typed receiver: the implementation is read from the
// runtime type's method table for the interface that declared the method.
public lowerInterfaceCall(LoweringContext lowering, CallExpressionNode call,
                          MemberExpressionNode member, Method method) -> long {
    let receiverType = lowering.typeOf(member.object());
    if (receiverType == null) {
        return -1;
    }
    let interfaceType = primitives.interfaceOf(receiverType);
    if (interfaceType == null || interfaceType.isGeneric()) {
        lowering.unsupported("calling the method '{method.name()}' on "
            + "'{types.display(receiverType)}'", call.span());
        return -1;
    }
    let info = lowering.index().infoFor(method.signature());
    if (info == null) {
        lowering.internalError("the interface method "
            + "'{interfaceType.name()}.{method.name()}' resolves to no indexed function",
            call.span());
        return -1;
    }
    if (!calls.supportedDispatchTarget(lowering, info,
            "interface method '{interfaceType.name()}.{method.name()}'", call.span())) {
        return -1;
    }
    long dispatchSlot = lowering.tables().itableSlotOf(method.signature());
    if (dispatchSlot < 0) {
        lowering.internalError("the interface method "
            + "'{interfaceType.name()}.{method.name()}' has no slot in its method table",
            call.span());
        return -1;
    }
    long object = borrowedReference(lowering, member.object(), receiverType);
    if (object < 0) {
        return -1;
    }
    return calls.lowerDispatchedCall(lowering, info, call, interfaceType, object, dispatchSlot,
        interfaceType);
}

// A bare 'this' inside a class method: the reference the method was handed, which is temp 0.
public lowerReceiver(LoweringContext lowering) -> long {
    return 0;
}

// A reference to read through, borrowed. An expression that produces a +1 is parked in a slot the
// enclosing scope owns: the value read back is then somebody else's to release, so every path out
// of the enclosing scope gives the reference up exactly once, whichever way the reader uses it.
public borrowedReference(LoweringContext lowering, Expression node, Type type) -> long {
    if (!places.producesOwnedValue(lowering, node)) {
        return expressions.lowerConverted(lowering, node, type);
    }
    let operand = stores.lowerOperand(lowering, node, type);
    if (operand == null) {
        return -1;
    }
    let builder = lowering.builder();
    long slot = builder.addSlot("held", type, true, false);
    if (!stores.assignSlot(lowering, slot, type, operand)) {
        lowering.internalError("a produced reference could not be parked in a slot",
            node.span());
        return -1;
    }
    ownership.trackSlot(lowering, slot, type);
    long value = builder.newTemp(type);
    builder.append(new EirLoadSlot(value, type, slot));
    return value;
}
