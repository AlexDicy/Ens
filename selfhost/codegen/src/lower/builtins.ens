// The calls that resolve to no user function. Sema types the string and array members
// structurally and records no callee for them, so lowering recognizes those by member name and
// receiver type. A free function is recognized by the entry the call resolved to instead.
import Expression from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import BuiltinFunction from @ens.sema.context;
import Type from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import PrimitiveIntrinsic from @ens.sema.model.types;
import @ens.sema.model.types;
import EirStringSubstring from eir.model;
import EirStringByteAt from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirStringLength from eir.model;
import EirArrayLength from eir.model;
import EirArraySlice from eir.model;
import EirRangeCheck from eir.model;
import EirPanic from eir.model;
import LoweringContext from lower.context;
import lower.expressions;
import lower.hashes;
import lower.places;
import lower.strings;
import support.primitives;
import List from @std.collections.list;

public final class BuiltinResult {
    // The result meaning "this call is not a built-in", distinct from -1, which means lowering
    // failed. Temps are never negative, so any negative value is free for this.
    public static const long notIntercepted = -2;
}

// 'panic' reports the message and ends the program. It takes one string, and gives up the string
// its argument produced for the call.
public lowerBuiltinCall(LoweringContext lowering, CallExpressionNode call, BuiltinFunction which) -> long {
    let argument = singleArgument(call.arguments());
    if (argument == null) {
        lowering.internalError("the built-in {which} reached lowering with "
            + "{call.arguments().argumentsCount()} argument(s)", call.span());
        return -1;
    }
    long text = expressions.lower(lowering, argument);
    if (text < 0) {
        return -1;
    }
    let builder = lowering.builder();
    switch (which) {
        Panic -> {
            builder.append(new EirPanic(text, lowering.lineAt(call.span())));
        },
    }
    return -1;
}

// A member call sema resolved structurally. Returns BuiltinResult.notIntercepted when the call
// is an ordinary function or method call.
public lowerMemberCall(LoweringContext lowering, CallExpressionNode call) -> long {
    let callee = call.callee();
    if (!(callee is MemberExpressionNode)) {
        return BuiltinResult.notIntercepted;
    }
    if (lowering.result().methodOf(callee.green()) != null) {
        return BuiltinResult.notIntercepted;
    }
    if (lowering.result().callableOf(callee.green()) != null) {
        return BuiltinResult.notIntercepted;
    }
    string name = callee.member().text();
    let object = callee.object();
    let receiverType = lowering.typeOf(object);
    if (receiverType == null) {
        return -1;
    }
    // Sema resolves '.hash()' here only when no declaration answers it, so this is always the
    // synthesized content hash.
    if (name == "hash") {
        return hashes.lowerSynthesizedHash(lowering, call, object, receiverType);
    }
    if (primitives.isStringType(receiverType)) {
        if (name == "toString") {
            return strings.lowerToString(lowering, object);
        }
        lowering.unsupported("the string member '{name}'", call.span());
        return -1;
    }
    if (name == "toString") {
        return lowerValueToString(lowering, object);
    }
    if (primitives.isArrayType(receiverType)) {
        if (name == "slice") {
            return lowerSlice(lowering, call, object, receiverType);
        }
        lowering.unsupported("the array member '{name}'", call.span());
        return -1;
    }
    return BuiltinResult.notIntercepted;
}

// A call to a binding member the compiler implements. The declaration carries no body, so this is
// where its body is: the instruction the intrinsic names, in place of a call to a symbol that
// nothing defines.
public lowerIntrinsicMember(LoweringContext lowering, CallExpressionNode call, Expression object,
                            PrimitiveIntrinsic intrinsic) -> long {
    switch (intrinsic) {
        StringByteAt -> {
            return lowerByteAt(lowering, call, object);
        },
        StringToBytes -> {
            return lowerToBytes(lowering, call, object);
        },
        StringSliceUnchecked -> {
            return lowerSubstring(lowering, call, object, "sliceUnchecked");
        },
        StringFromBytesUnchecked -> {
            lowering.internalError("the intrinsic '{intrinsic}' is a static, called here with a "
                + "receiver", call.span());
            return -1;
        },
    }
}

public lowerIntrinsicStatic(LoweringContext lowering, CallExpressionNode call,
                            PrimitiveIntrinsic intrinsic) -> long {
    if (intrinsic != PrimitiveIntrinsic.StringFromBytesUnchecked) {
        lowering.internalError("the intrinsic '{intrinsic}' takes a receiver, called here as a "
            + "static", call.span());
        return -1;
    }
    return lowerFromBytes(lowering, call, "fromBytesUnchecked");
}

// One byte of a string's bytes, read at a byte offset the instruction guards.
lowerByteAt(LoweringContext lowering, CallExpressionNode call, Expression object) -> long {
    let argument = singleArgument(call.arguments());
    if (argument == null) {
        lowering.internalError("'byteAt' reached lowering with "
            + "{call.arguments().argumentsCount()} argument(s)", call.span());
        return -1;
    }
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long text = expressions.lower(lowering, object);
    if (text < 0) {
        return -1;
    }
    bool textOwned = places.producesOwnedValue(lowering, object);
    if (textOwned) {
        lowering.protectValue(text);
    }
    long index = expressions.lowerConverted(lowering, argument, longType);
    if (textOwned) {
        lowering.unprotectValue(text);
    }
    if (index < 0) {
        return -1;
    }
    let builder = lowering.builder();
    let byteType = lowering.store().primitive(PrimitiveKind.Byte);
    long result = builder.newTemp(byteType);
    builder.append(new EirStringByteAt(result, byteType, text, index,
        lowering.lineAt(call.span())));
    expressions.releaseTemporary(lowering, object, text);
    return result;
}

// A byte array read as text, with no encoding check of its own.
lowerFromBytes(LoweringContext lowering, CallExpressionNode call, string member) -> long {
    let argument = singleArgument(call.arguments());
    if (argument == null) {
        lowering.internalError("'string.{member}' reached lowering with "
            + "{call.arguments().argumentsCount()} argument(s)", call.span());
        return -1;
    }
    long bytes = expressions.lower(lowering, argument);
    if (bytes < 0) {
        return -1;
    }
    let builder = lowering.builder();
    let stringType = lowering.store().stringType();
    long text = builder.newTemp(stringType);
    builder.append(new EirStringFromBytes(text, stringType, bytes));
    expressions.releaseTemporary(lowering, argument, bytes);
    return text;
}

// A value's own text form, for '.toString()' on a value whose type declares no 'toString'.
lowerValueToString(LoweringContext lowering, Expression object) -> long {
    let receiverType = lowering.typeOf(object);
    if (receiverType == null) {
        return -1;
    }
    if (primitives.isNumericType(receiverType) || primitives.isBoolType(receiverType)
            || primitives.isEnumType(receiverType) || primitives.structOf(receiverType) != null
            || primitives.arrayOf(receiverType) != null) {
        return strings.lowerToString(lowering, object);
    }
    if (!primitives.isOptionalType(receiverType) && primitives.isClassLike(receiverType)) {
        return strings.lowerToString(lowering, object);
    }
    return BuiltinResult.notIntercepted;
}

lowerToBytes(LoweringContext lowering, CallExpressionNode call, Expression object) -> long {
    let resultType = lowering.typeOf(call);
    if (resultType == null) {
        return -1;
    }
    long text = expressions.lower(lowering, object);
    if (text < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long bytes = builder.newTemp(resultType);
    builder.append(new EirStringToBytes(bytes, resultType, text));
    expressions.releaseTemporary(lowering, object, text);
    return bytes;
}

// A byte range copied into fresh text, aborting when the range is not inside the string. The
// member is named by the guard's message, since the guard is what reports the broken range.
lowerSubstring(LoweringContext lowering, CallExpressionNode call, Expression object,
               string member) -> long {
    let arguments = argumentValues(call.arguments());
    if (arguments == null || arguments.length() != 2) {
        lowering.internalError("'{member}' reached lowering with "
            + "{call.arguments().argumentsCount()} argument(s)", call.span());
        return -1;
    }
    let stringType = lowering.store().stringType();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long text = expressions.lower(lowering, object);
    if (text < 0) {
        return -1;
    }
    bool textOwned = places.producesOwnedValue(lowering, object);
    if (textOwned) {
        lowering.protectValue(text);
    }
    long start = expressions.lowerConverted(lowering, arguments.get(0), longType);
    long end = -1;
    if (start >= 0) {
        end = expressions.lowerConverted(lowering, arguments.get(1), longType);
    }
    if (textOwned) {
        lowering.unprotectValue(text);
    }
    if (start < 0 || end < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long length = builder.newTemp(longType);
    builder.append(new EirStringLength(length, longType, text));
    builder.append(new EirRangeCheck(start, end, length, "{member} range out of bounds",
        lowering.lineAt(call.span())));
    long result = builder.newTemp(stringType);
    builder.append(new EirStringSubstring(result, stringType, text, start, end));
    expressions.releaseTemporary(lowering, object, text);
    return result;
}

// 'slice' copies an element range into a fresh array, aborting when the range is not inside the
// source. Each copied reference element is retained, so the slice outlives its source array.
lowerSlice(LoweringContext lowering, CallExpressionNode call, Expression object, Type receiverType) -> long {
    let arrayType = primitives.arrayOf(receiverType);
    if (arrayType == null) {
        return -1;
    }
    let element = arrayType.element();
    if (primitives.hasArcContent(element) && !primitives.isReferenceType(element)) {
        lowering.unsupported("slicing an array of '{types.display(element)}', whose elements "
            + "hold references", call.span());
        return -1;
    }
    let arguments = argumentValues(call.arguments());
    if (arguments == null || arguments.length() != 2) {
        lowering.internalError("'slice' reached lowering with "
            + "{call.arguments().argumentsCount()} argument(s)", call.span());
        return -1;
    }
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    long array = expressions.lower(lowering, object);
    if (array < 0) {
        return -1;
    }
    bool arrayOwned = places.producesOwnedValue(lowering, object);
    if (arrayOwned) {
        lowering.protectValue(array);
    }
    long start = expressions.lowerConverted(lowering, arguments.get(0), longType);
    long end = -1;
    if (start >= 0) {
        end = expressions.lowerConverted(lowering, arguments.get(1), longType);
    }
    if (arrayOwned) {
        lowering.unprotectValue(array);
    }
    if (start < 0 || end < 0) {
        return -1;
    }
    let builder = lowering.builder();
    long length = builder.newTemp(longType);
    builder.append(new EirArrayLength(length, longType, array));
    builder.append(new EirRangeCheck(start, end, length, "slice range out of bounds",
        lowering.lineAt(call.span())));
    long result = builder.newTemp(receiverType);
    builder.append(new EirArraySlice(result, receiverType, array, start, end));
    expressions.releaseTemporary(lowering, object, array);
    return result;
}

singleArgument(ArgumentListNode arguments) -> Expression? {
    let values = argumentValues(arguments);
    if (values == null || values.length() != 1) {
        return null;
    }
    return values.get(0);
}

// The written arguments in source order, or null when one of them is an 'out' argument.
argumentValues(ArgumentListNode arguments) -> List<Expression>? {
    let values = new List<Expression>();
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression) {
            values.push(argument);
        } else {
            return null;
        }
    }
    return values;
}
