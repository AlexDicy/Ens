// Calls to the members a primitive binding declares. The primitive value is the receiver, passed
// like a class reference and never dispatched: a primitive carries no type descriptor, so there is
// nothing to look a slot up in, and the concrete member is always known here.
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import Method from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import LoweringContext from lower.context;
import lower.builtins;
import lower.calls;
import lower.classes;
import support.primitives;

public lowerMemberCall(LoweringContext lowering, CallExpressionNode call,
                       MemberExpressionNode member, Method method) -> long {
    let receiverType = lowering.typeOf(member.object());
    if (receiverType == null) {
        return -1;
    }
    let resolved = resolveConcreteMember(lowering, receiverType, method);
    if (resolved == null) {
        lowering.internalError("the member '{types.display(receiverType)}.{method.name()}' "
            + "resolves to no member of the binding", call.span());
        return -1;
    }
    let intrinsic = resolved.intrinsic();
    if (intrinsic != null) {
        return builtins.lowerIntrinsicMember(lowering, call, member.object(), intrinsic);
    }
    let info = lowering.index().infoFor(resolved.signature());
    if (info == null) {
        lowering.internalError("the member '{types.display(receiverType)}.{method.name()}' "
            + "resolves to no indexed function", call.span());
        return -1;
    }
    string described = "member '{types.display(receiverType)}.{method.name()}'";
    if (!calls.supportedCallee(lowering, info, described, call.span())) {
        return -1;
    }
    long value = classes.borrowedReference(lowering, member.object(), receiverType);
    if (value < 0) {
        return -1;
    }
    return calls.lowerCall(lowering, info, call, receiverType, value);
}

// The binding member a recorded resolution reaches: the member itself for a call written on a
// primitive, or the binding's implementation of the requirement when the call went through a
// generic bound and sema recorded the interface's method.
resolveConcreteMember(LoweringContext lowering, Type receiverType, Method method) -> Method? {
    if (method.definingType() == receiverType) {
        return method;
    }
    if (primitives.interfaceOf(method.definingType()) == null) {
        return null;
    }
    return classes.implementationOn(receiverType,
        classes.concreteInterfaceMethod(lowering, method));
}
