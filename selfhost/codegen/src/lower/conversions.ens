// Conversions between primitive value types, applied wherever a value has to reach a declared
// type: initializers, arguments, returns, operator operands, and explicit casts.
import Span from @ens.frontend.support.source;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import EirAbsentOptional from eir.model;
import EirBranch from eir.model;
import EirCastOp from eir.model;
import EirCast from eir.model;
import EirJump from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPresence from eir.model;
import EirPayloadRead from eir.model;
import EirStoreSlot from eir.model;
import EirWrapOptional from eir.model;
import LoweringContext from lower.context;
import lower.ownership;
import support.primitives;

// Converts a temp between primitive value types, matching the reference semantics: integer
// widening extends by the source's signedness, narrowing truncates, same-width conversion
// reinterprets the bits, integer-to-float converts by source signedness, float-to-integer
// truncates toward zero by target signedness, and float widths extend or truncate.
public convert(LoweringContext lowering, long value, Type target, Span span) -> long {
    let builder = lowering.builder();
    let source = builder.tempType(value);
    if (source == target) {
        return value;
    }
    // Two spellings of one reference are the same pointer, so narrowing an optional away, widening
    // into one, and the null literal reaching a nullable reference are all renames.
    if (primitives.sameReferent(source, target)) {
        long renamed = builder.newTemp(target);
        builder.append(new EirCast(renamed, target, EirCastOp.Reinterpret, value));
        return renamed;
    }
    // A tagged optional is built from null or by wrapping a value of its payload type, one level
    // per wrap, and a narrowing read peels payloads until the levels match. The optional depths
    // decide the direction, because either side of a nested conversion can be a tagged pair.
    let targetPayload = primitives.taggedPayloadOf(target);
    if (targetPayload != null) {
        if (primitives.isNullType(source)) {
            long absent = builder.newTemp(target);
            builder.append(new EirAbsentOptional(absent, target));
            return absent;
        }
        if (primitives.optionalDepth(source) < primitives.optionalDepth(target)) {
            long payload = convert(lowering, value, targetPayload, span);
            if (payload < 0) {
                return -1;
            }
            long wrapped = builder.newTemp(target);
            builder.append(new EirWrapOptional(wrapped, target, payload));
            return wrapped;
        }
    }
    let sourcePayload = primitives.taggedPayloadOf(source);
    if (targetPayload != null && sourcePayload != null
            && primitives.optionalDepth(source) == primitives.optionalDepth(target)) {
        return widenPresent(lowering, value, sourcePayload, target, targetPayload, span);
    }
    if (sourcePayload != null && primitives.optionalDepth(source) > primitives.optionalDepth(target)) {
        long payload = builder.newTemp(sourcePayload);
        builder.append(new EirOptionalPayload(payload, sourcePayload, value, EirPayloadRead.Move));
        return convert(lowering, payload, target, span);
    }
    if (!lowering.supportsValueType(source) || !lowering.supportsValueType(target)
            || primitives.isBoolType(source) || primitives.isBoolType(target)) {
        lowering.unsupported("converting {lowering.names().quoted(source)} to "
            + "{lowering.names().quoted(target)}", span);
        return -1;
    }
    bool sourceFloat = primitives.isFloatType(source);
    bool targetFloat = primitives.isFloatType(target);
    long sourceWidth = primitives.bitWidth(source);
    long targetWidth = primitives.bitWidth(target);
    let op = EirCastOp.Reinterpret;
    if (!sourceFloat && !targetFloat) {
        if (sourceWidth == targetWidth) {
            op = EirCastOp.Reinterpret;
        } else if (sourceWidth > targetWidth) {
            op = EirCastOp.Trunc;
        } else if (primitives.isSignedType(source)) {
            op = EirCastOp.SignExtend;
        } else {
            op = EirCastOp.ZeroExtend;
        }
    } else if (!sourceFloat) {
        op = EirCastOp.SignedToFloat;
        if (!primitives.isSignedType(source)) {
            op = EirCastOp.UnsignedToFloat;
        }
    } else if (!targetFloat) {
        op = EirCastOp.FloatToSigned;
        if (!primitives.isSignedType(target)) {
            op = EirCastOp.FloatToUnsigned;
        }
    } else if (sourceWidth > targetWidth) {
        op = EirCastOp.FloatTrunc;
    } else if (sourceWidth < targetWidth) {
        op = EirCastOp.FloatExtend;
    } else {
        return value;
    }
    long temp = builder.newTemp(target);
    builder.append(new EirCast(temp, target, op, value));
    return temp;
}

// A nullable number converted to the nullable number 'target' at the same level of null: the
// payload converts only where it is present, and an absent value stays absent.
widenPresent(LoweringContext lowering, long value, Type sourcePayload, Type target,
             Type targetPayload, Span span) -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long slot = ownership.defineJoinSlot(lowering, "widen", target);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, value));
    long presentBlock = builder.newBlock("widen.present");
    long absentBlock = builder.newBlock("widen.absent");
    long mergeBlock = builder.newBlock("widen.end");
    builder.terminate(new EirBranch(present, presentBlock, absentBlock));

    builder.moveTo(presentBlock);
    long payload = builder.newTemp(sourcePayload);
    builder.append(new EirOptionalPayload(payload, sourcePayload, value, EirPayloadRead.Move));
    long converted = convert(lowering, payload, targetPayload, span);
    if (converted < 0) {
        return -1;
    }
    long wrapped = builder.newTemp(target);
    builder.append(new EirWrapOptional(wrapped, target, converted));
    builder.append(new EirStoreSlot(slot, wrapped));
    builder.terminate(new EirJump(mergeBlock));

    builder.moveTo(absentBlock);
    long absent = builder.newTemp(target);
    builder.append(new EirAbsentOptional(absent, target));
    builder.append(new EirStoreSlot(slot, absent));
    builder.terminate(new EirJump(mergeBlock));

    builder.moveTo(mergeBlock);
    return ownership.moveOutOf(lowering, slot, target);
}
