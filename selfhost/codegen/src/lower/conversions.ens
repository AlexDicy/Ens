// Conversions between primitive value types, applied wherever a value has to reach a declared
// type: initializers, arguments, returns, operator operands, and explicit casts.
import Span from @ens.frontend.support.source;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirCastOp from eir.model;
import EirCast from eir.model;
import LoweringContext from lower.context;
import support.primitives;

// Converts a temp between primitive value types, matching the reference semantics: integer
// widening extends by the source's signedness, narrowing truncates, same-width conversion
// reinterprets the bits, integer-to-float converts by source signedness, float-to-integer
// truncates toward zero by target signedness, and float widths extend or truncate.
public convert(LoweringContext lowering, long value, Type target, Span span) -> long {
    let builder = lowering.builder();
    let source = builder.tempType(value);
    if (source == target) {
        return value;
    }
    if (!lowering.supportsValueType(source) || !lowering.supportsValueType(target)
            || primitives.isBoolType(source) || primitives.isBoolType(target)) {
        lowering.unsupported("converting '{types.display(source)}' to "
            + "'{types.display(target)}'", span);
        return -1;
    }
    bool sourceFloat = primitives.isFloatType(source);
    bool targetFloat = primitives.isFloatType(target);
    long sourceWidth = primitives.bitWidth(source);
    long targetWidth = primitives.bitWidth(target);
    let op = EirCastOp.Reinterpret;
    if (!sourceFloat && !targetFloat) {
        if (sourceWidth == targetWidth) {
            op = EirCastOp.Reinterpret;
        } else if (sourceWidth > targetWidth) {
            op = EirCastOp.Trunc;
        } else if (primitives.isSignedType(source)) {
            op = EirCastOp.SignExtend;
        } else {
            op = EirCastOp.ZeroExtend;
        }
    } else if (!sourceFloat) {
        op = EirCastOp.SignedToFloat;
        if (!primitives.isSignedType(source)) {
            op = EirCastOp.UnsignedToFloat;
        }
    } else if (!targetFloat) {
        op = EirCastOp.FloatToSigned;
        if (!primitives.isSignedType(target)) {
            op = EirCastOp.FloatToUnsigned;
        }
    } else if (sourceWidth > targetWidth) {
        op = EirCastOp.FloatTrunc;
    } else if (sourceWidth < targetWidth) {
        op = EirCastOp.FloatExtend;
    } else {
        return value;
    }
    long temp = builder.newTemp(target);
    builder.append(new EirCast(temp, target, op, value));
    return temp;
}
