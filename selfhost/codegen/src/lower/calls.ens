// Call lowering: resolving the callee through the program index, evaluating the written
// arguments in source order into their parameter positions, filling the parameters left unbound
// from the callee's declared defaults, emitting the call, and giving up every temporary an argument
// produced only for it. Struct constructors and struct methods share all of that and differ only in
// the receiver they pass, so they resolve here and lower in lower.structs.
import Expression from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import NamedArgumentNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import Parameter from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirCallee from eir.model;
import EirCall from eir.model;
import FunctionInfo from lower.index;
import LoweringContext from lower.context;
import lower.builtins;
import lower.classes;
import lower.expressions;
import lower.ownership;
import lower.places;
import lower.structs;
import support.primitives;
import List from @std.collections.list;

public lower(LoweringContext lowering, CallExpressionNode call) -> long {
    long intercepted = builtins.lowerMemberCall(lowering, call);
    if (intercepted != builtins.notIntercepted()) {
        return intercepted;
    }
    // A constructor is recorded on the call, a method on the member the call names.
    let structConstructor = lowering.result().methodOf(call.green());
    if (structConstructor != null) {
        return structs.lowerConstructorCall(lowering, call, structConstructor);
    }
    let callee = call.callee();
    if (callee is MemberExpressionNode) {
        let method = lowering.result().methodOf(callee.green());
        if (method != null) {
            let receiverType = lowering.typeOf(callee.object());
            if (receiverType == null) {
                return -1;
            }
            if (primitives.classOf(receiverType) != null) {
                return classes.lowerMethodCall(lowering, call, callee, method);
            }
            return structs.lowerMethodCall(lowering, call, callee, method);
        }
    }
    let signature = calleeSignatureOf(lowering, call);
    if (signature == null) {
        lowering.unsupported("this call", call.span());
        return -1;
    }
    let info = lowering.index().infoFor(signature);
    if (info == null) {
        lowering.internalError("call to '{signature.name()}' resolves to no indexed function",
            call.span());
        return -1;
    }
    if (info.isBuiltin()) {
        return builtins.lowerFreeCall(lowering, call, signature.name());
    }
    if (!supportedCallee(lowering, info, "function '{signature.name()}'", call.span())) {
        return -1;
    }
    return lowerCall(lowering, info, call, null, -1);
}

// The arguments, the call, and the end of every reference an argument produced for the call. An
// argument passes at +0, so a temporary the caller built for it is still the caller's to give up.
public lowerCall(LoweringContext lowering, FunctionInfo info, CallExpressionNode call,
                 Type? receiverType, long receiver) -> long {
    return lowerInvocation(lowering, info, call.arguments(), call.green(), call.span(),
        receiverType, receiver);
}

// The same walk over a written argument list that no call expression holds, which is how a class
// constructor reached through 'new' shares argument evaluation and default filling. The order key is
// the node sema recorded the argument-to-parameter mapping on.
public lowerInvocation(LoweringContext lowering, FunctionInfo info, ArgumentListNode? arguments,
                       GreenNode orderKey, Span span, Type? receiverType, long receiver) -> long {
    let temporaries = new List<long>();
    let values = lowerArguments(lowering, info, arguments, orderKey, span, temporaries);
    if (values == null) {
        return -1;
    }
    long result = emitCall(lowering, info, receiverType, receiver, values);
    for (long i = 0; i < temporaries.length(); i++) {
        ownership.releaseValue(lowering, temporaries.get(i));
    }
    return result;
}

// True when the callee's shape is one lowering can emit. 'described' names the callee the way the
// diagnostic should read it, as in "function 'total'" or "method 'Rectangle.getArea'".
public supportedCallee(LoweringContext lowering, FunctionInfo info, string described, Span span)
        -> bool {
    let signature = info.signature();
    if (info.isExternal()) {
        lowering.unsupported("calling the external {described}", span);
        return false;
    }
    if (signature.isGeneric()) {
        lowering.unsupported("calling the generic {described}", span);
        return false;
    }
    if (signature.declaresThrows()) {
        lowering.unsupported("calling the throwing {described}", span);
        return false;
    }
    let declaration = info.declaration();
    if (declaration != null && declaration.body() == null && !info.isConstructor()) {
        lowering.unsupported("calling the {described}, which declares no body", span);
        return false;
    }
    for (let parameter in signature.parameters()) {
        if (!lowering.supportsValueType(parameter.type())) {
            lowering.unsupported("passing a '{types.display(parameter.type())}' argument", span);
            return false;
        }
    }
    let returnType = signature.returnType();
    if (!types.isVoidType(returnType) && !lowering.supportsValueType(returnType)) {
        lowering.unsupported("a call returning '{types.display(returnType)}'", span);
        return false;
    }
    return true;
}

// The argument temps in parameter order: each written argument converted to its parameter's type,
// then every parameter left unbound filled from its declared default. Every reference an argument
// produced lands in 'temporaries' for the call site to give up once the call has run.
lowerArguments(LoweringContext lowering, FunctionInfo info, ArgumentListNode? arguments,
               GreenNode orderKey, Span span, List<long> temporaries) -> long[]? {
    Parameter[] parameters = info.signature().parameters();
    let writtenArguments = argumentExpressions(arguments);
    if (writtenArguments == null) {
        lowering.unsupported("'out' arguments", span);
        return null;
    }
    long[] slots = new long[parameters.length];
    bool[] filled = new bool[parameters.length];
    let mapping = lowering.result().argumentOrderOf(orderKey);
    for (long i = 0; i < writtenArguments.length(); i++) {
        long parameterIndex = i;
        if (mapping != null && i < mapping.length) {
            parameterIndex = mapping[i];
        }
        if (parameterIndex < 0 || parameterIndex >= parameters.length) {
            lowering.internalError("argument {i + 1} maps to no parameter", span);
            return null;
        }
        long value = lowerArgument(lowering, writtenArguments.get(i),
            parameters[parameterIndex].type(), temporaries);
        if (value < 0) {
            return null;
        }
        slots[parameterIndex] = value;
        filled[parameterIndex] = true;
    }
    for (long j = 0; j < parameters.length; j++) {
        if (filled[j]) {
            continue;
        }
        long value = lowerDefaultArgument(lowering, info, j, parameters[j].type(), span,
            temporaries);
        if (value < 0) {
            return null;
        }
        slots[j] = value;
    }
    return slots;
}

// One argument at its parameter's type. A reference the argument produced is remembered so the call
// site gives it up afterwards; a struct it produced goes into storage the enclosing scope releases,
// because a struct's +1 lives in its fields and only an address reaches them.
lowerArgument(LoweringContext lowering, Expression argument, Type parameterType,
              List<long> temporaries) -> long {
    if (!primitives.hasArcContent(parameterType)
            || !places.producesOwnedValue(lowering, argument)) {
        return expressions.lowerConverted(lowering, argument, parameterType);
    }
    if (primitives.isReferenceType(parameterType)) {
        long value = expressions.lowerConverted(lowering, argument, parameterType);
        if (value < 0) {
            return -1;
        }
        temporaries.push(value);
        return value;
    }
    long address = structs.addressOf(lowering, argument, parameterType);
    if (address < 0) {
        return -1;
    }
    return places.loadFrom(lowering, address, parameterType);
}

// Emits the call and hands back its result temp, or -1 when the callee returns nothing. A method
// takes the address of the storage it runs over; a free function passes -1 for its receiver.
public emitCall(LoweringContext lowering, FunctionInfo info, Type? receiverType, long receiver,
                long[] arguments) -> long {
    let signature = info.signature();
    let returnType = signature.returnType();
    let builder = lowering.builder();
    let callee = new EirCallee(info.symbol(), receiverType, parameterTypesOf(signature),
        returnType);
    long resultTemp = -1;
    if (!types.isVoidType(returnType)) {
        resultTemp = builder.newTemp(returnType);
    }
    builder.append(new EirCall(resultTemp, returnType, callee, receiver, arguments));
    return resultTemp;
}

parameterTypesOf(Signature signature) -> Type[] {
    Parameter[] parameters = signature.parameters();
    let declared = new Type[parameters.length];
    for (long i = 0; i < declared.length; i++) {
        declared[i] = parameters[i].type();
    }
    return declared;
}

public calleeSignatureOf(LoweringContext lowering, CallExpressionNode call) -> Signature? {
    switch (call.callee()) {
        is IdentifierExpressionNode identifier -> {
            return lowering.result().callableOf(identifier.green());
        },
        is MemberExpressionNode member -> {
            return lowering.result().callableOf(member.green());
        },
        default -> {
            return null;
        },
    }
}

// A parameter left unbound takes its declared default, evaluated at the call site. The default
// expression lives in the callee's module, so its side tables come from there.
lowerDefaultArgument(LoweringContext lowering, FunctionInfo callee, long parameterIndex,
                     Type parameterType, Span callSpan, List<long> temporaries) -> long {
    let declaration = callee.declaration();
    if (declaration == null) {
        lowering.internalError("callee '{callee.signature().name()}' has no declaration for "
            + "its defaults", callSpan);
        return -1;
    }
    let parameterList = declaration.parameters();
    if (parameterIndex >= parameterList.parametersCount()) {
        lowering.internalError("callee '{callee.signature().name()}' has no parameter "
            + "{parameterIndex + 1}", callSpan);
        return -1;
    }
    let defaultValue = parameterList.parameters(parameterIndex).defaultValue();
    if (defaultValue == null) {
        lowering.internalError("parameter {parameterIndex + 1} of "
            + "'{callee.signature().name()}' has no default to fill", callSpan);
        return -1;
    }
    let caller = lowering.enterModule(callee.context());
    long value = lowerArgument(lowering, defaultValue.value(), parameterType, temporaries);
    let ignored = lowering.enterModule(caller);
    return value;
}

// The written argument expressions in source order, or null when an 'out' argument appears. A
// missing list is a callee written with no parentheses, whose parameters all take their defaults.
argumentExpressions(ArgumentListNode? arguments) -> List<Expression>? {
    let values = new List<Expression>();
    if (arguments == null) {
        return values;
    }
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                values.push(named.value());
            },
            is Expression value -> {
                values.push(value);
            },
            default -> {
                return null;
            },
        }
    }
    return values;
}
