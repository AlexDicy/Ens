// Call lowering: resolving the callee through the program index, evaluating the written
// arguments in source order into their parameter positions, filling the parameters left unbound
// from the callee's declared defaults, and emitting the call.
import Expression from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import NamedArgumentNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import Parameter from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirCallee from eir.model;
import EirCall from eir.model;
import FunctionInfo from lower.index;
import LoweringContext from lower.context;
import lower.expressions;
import List from @std.collections.list;

public lower(LoweringContext lowering, CallExpressionNode call) -> long {
    let signature = calleeSignatureOf(lowering, call);
    if (signature == null) {
        lowering.unsupported("this call", call.span());
        return -1;
    }
    let info = lowering.index().infoFor(signature);
    if (info == null) {
        lowering.internalError("call to '{signature.name()}' resolves to no indexed function",
            call.span());
        return -1;
    }
    if (info.isBuiltin()) {
        lowering.unsupported("the built-in function '{signature.name()}'", call.span());
        return -1;
    }
    if (info.isExternal()) {
        lowering.unsupported("calling the external function '{signature.name()}'",
            call.span());
        return -1;
    }
    if (signature.isGeneric()) {
        lowering.unsupported("calling the generic function '{signature.name()}'",
            call.span());
        return -1;
    }
    if (signature.declaresThrows()) {
        lowering.unsupported("calling the throwing function '{signature.name()}'",
            call.span());
        return -1;
    }
    Parameter[] parameters = signature.parameters();
    for (let parameter in parameters) {
        if (!lowering.supportsValueType(parameter.type())) {
            lowering.unsupported("passing a '{types.display(parameter.type())}' argument",
                call.span());
            return -1;
        }
    }
    let returnType = signature.returnType();
    if (!types.isVoidType(returnType) && !lowering.supportsValueType(returnType)) {
        lowering.unsupported("a call returning '{types.display(returnType)}'", call.span());
        return -1;
    }
    let writtenArguments = argumentExpressions(call.arguments());
    if (writtenArguments == null) {
        lowering.unsupported("'out' arguments", call.span());
        return -1;
    }
    long[] slots = new long[parameters.length];
    bool[] filled = new bool[parameters.length];
    let mapping = lowering.result().argumentOrderOf(call.green());
    for (long i = 0; i < writtenArguments.length(); i++) {
        long parameterIndex = i;
        if (mapping != null && i < mapping.length) {
            parameterIndex = mapping[i];
        }
        if (parameterIndex < 0 || parameterIndex >= parameters.length) {
            lowering.internalError("argument {i + 1} maps to no parameter", call.span());
            return -1;
        }
        long value = expressions.lowerConverted(lowering, writtenArguments.get(i),
            parameters[parameterIndex].type());
        if (value < 0) {
            return -1;
        }
        slots[parameterIndex] = value;
        filled[parameterIndex] = true;
    }
    for (long j = 0; j < parameters.length; j++) {
        if (filled[j]) {
            continue;
        }
        long value = lowerDefaultArgument(lowering, info, j, parameters[j].type(), call.span());
        if (value < 0) {
            return -1;
        }
        slots[j] = value;
    }
    let parameterTypes = new Type[parameters.length];
    for (long j = 0; j < parameterTypes.length; j++) {
        parameterTypes[j] = parameters[j].type();
    }
    let builder = lowering.builder();
    let callee = new EirCallee(info.symbol(), parameterTypes, returnType);
    long resultTemp = -1;
    if (!types.isVoidType(returnType)) {
        resultTemp = builder.newTemp(returnType);
    }
    builder.append(new EirCall(resultTemp, returnType, callee, slots));
    return resultTemp;
}

public calleeSignatureOf(LoweringContext lowering, CallExpressionNode call) -> Signature? {
    switch (call.callee()) {
        is IdentifierExpressionNode identifier -> {
            return lowering.result().callableOf(identifier.green());
        },
        is MemberExpressionNode member -> {
            return lowering.result().callableOf(member.green());
        },
        default -> {
            return null;
        },
    }
}

// A parameter left unbound takes its declared default, evaluated at the call site. The default
// expression lives in the callee's module, so its side tables come from there.
lowerDefaultArgument(LoweringContext lowering, FunctionInfo callee, long parameterIndex,
                     Type parameterType, Span callSpan) -> long {
    let declaration = callee.declaration();
    if (declaration == null) {
        lowering.internalError("callee '{callee.signature().name()}' has no declaration for "
            + "its defaults", callSpan);
        return -1;
    }
    let parameterList = declaration.parameters();
    if (parameterIndex >= parameterList.parametersCount()) {
        lowering.internalError("callee '{callee.signature().name()}' has no parameter "
            + "{parameterIndex + 1}", callSpan);
        return -1;
    }
    let defaultValue = parameterList.parameters(parameterIndex).defaultValue();
    if (defaultValue == null) {
        lowering.internalError("parameter {parameterIndex + 1} of "
            + "'{callee.signature().name()}' has no default to fill", callSpan);
        return -1;
    }
    let caller = lowering.enterModule(callee.context());
    long value = expressions.lowerConverted(lowering, defaultValue.value(), parameterType);
    let ignored = lowering.enterModule(caller);
    return value;
}

// The written argument expressions in source order, or null when an 'out' argument appears.
argumentExpressions(ArgumentListNode arguments) -> List<Expression>? {
    let values = new List<Expression>();
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                values.push(named.value());
            },
            is Expression value -> {
                values.push(value);
            },
            default -> {
                return null;
            },
        }
    }
    return values;
}
