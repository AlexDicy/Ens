// Per-function lowering from the checked syntax tree to EIR, as a pure step returning the lowered
// function and its diagnostics as values. Nothing is shared between functions except the
// immutable program index, so functions can lower in parallel. Merges go through slots, not phis.
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import SyntaxToken from @ens.frontend.syntax.node;
import Span from @ens.frontend.support.source;
import LocalBinding from @ens.sema.model.scopes;
import ClassType from @ens.sema.model.types;
import Parameter from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import @ens.sema.model.types;
import Type from @ens.sema.model.types;
import FileDiagnostic from @ens.sema.support.diagnostics;
import EirFunction from eir.model;
import EirStoreSlot from eir.model;
import EirReturn from eir.model;
import EirUnreachable from eir.model;
import DispatchTables from layout.vtables;
import layout.vtables;
import ArrayContentPlan from lower.arraycontent;
import FunctionInfo from lower.index;
import LazyValueInfo from lower.index;
import ProgramIndex from lower.index;
import LoweringContext from lower.context;
import Operand from lower.stores;
import lower.calls;
import lower.classes;
import lower.closures;
import lower.exceptions;
import lower.lazyvalues;
import lower.literals;
import lower.ownership;
import lower.records;
import lower.statements;
import lower.stores;
import lower.throwing;
import lower.weakfields;
import support.primitives;

public final class FunctionLowering {
    EirFunction? loweredFunction;
    FileDiagnostic[] loweringDiagnostics;

    public constructor(this.loweredFunction, this.loweringDiagnostics);

    public function() -> EirFunction? {
        return this.loweredFunction;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.loweringDiagnostics;
    }
}

// Lowers one free function to EIR. The result carries either the function or the diagnostics
// that explain why it could not be lowered.
public lowerFunction(FunctionInfo info, ProgramIndex index, DispatchTables tables, TypeStore store,
                     ArrayContentPlan contentPlan) -> FunctionLowering {
    let lowering = new LoweringContext(info, index, tables, store, contentPlan);
    let test = info.testDeclaration();
    if (test != null) {
        return lowerTest(lowering, test);
    }
    let lambda = info.lambdaDeclaration();
    if (lambda != null) {
        return lowerLambda(lowering, lambda);
    }
    let lazyValue = info.lazyValue();
    if (lazyValue != null) {
        return lowerLazyInitializer(lowering, lazyValue);
    }
    let declaration = info.declaration();
    if (declaration == null) {
        return new FunctionLowering(null, lowering.diagnostics());
    }
    let signature = info.signature();
    let body = declaration.body();
    if (body == null && !info.isConstructor()) {
        lowering.internalError("function '{signature.name()}' has no body to lower",
            signature.nameSpan());
        return new FunctionLowering(null, lowering.diagnostics());
    }
    let builder = lowering.builder();
    if (throwing.abiThrows(info)) {
        builder.setThrowing();
    }
    builder.setTrace(traceNameOf(info), fileNameOf(info.context().module().filePath()),
        lowering.lineAt(signature.nameSpan()), info == index.entryFunction());
    lowering.pushScope();
    if (declaration.catchClausesCount() > 0) {
        let errorType = lowering.errorType();
        if (errorType == null) {
            lowering.internalError("the standard library declares no Error class",
                signature.nameSpan());
            return new FunctionLowering(null, lowering.diagnostics());
        }
        long dispatchSlot = builder.addSlot("err.dispatch", errorType, true, false);
        ownership.trackSlot(lowering, dispatchSlot, errorType);
        lowering.setDispatch(dispatchSlot, builder.newBlock("catch.dispatch"));
    }
    if (info.isConstructor() && !hasExplicitSuperCall(body)) {
        chainImplicitSuper(lowering, declaration);
    }
    bindParameters(lowering, declaration, body);
    if (body != null) {
        statements.lowerBlock(lowering, body);
    }
    if (lowering.failed()) {
        return new FunctionLowering(null, lowering.diagnostics());
    }
    if (!builder.terminated()) {
        if (signature.isNoreturn() || !types.isVoidType(signature.returnType())) {
            builder.terminate(new EirUnreachable());
        } else {
            ownership.releaseAllScopes(lowering);
            builder.terminate(new EirReturn(-1));
        }
    }
    if (declaration.catchClausesCount() > 0) {
        exceptions.lowerCatchClauses(lowering, declaration);
        if (lowering.failed()) {
            return new FunctionLowering(null, lowering.diagnostics());
        }
    }
    lowering.popScope();
    return new FunctionLowering(builder.finish(), lowering.diagnostics());
}

// Lowers one test declaration: a public zero-parameter void function on the error-slot ABI,
// whose body may throw anything and propagates it to the caller. Its stack-trace name is the
// quoted description, which is how the runner's failure report names the frame.
lowerTest(LoweringContext lowering, TestDeclarationNode test) -> FunctionLowering {
    let builder = lowering.builder();
    if (throwing.abiThrows(lowering.info())) {
        builder.setThrowing();
    }
    Span at = test.testKeyword().span();
    let description = test.descriptionToken();
    if (description != null) {
        at = description.span();
    }
    builder.setTrace(testTraceName(description),
        fileNameOf(lowering.info().context().module().filePath()), lowering.lineAt(at), false);
    lowering.pushScope();
    statements.lowerBlock(lowering, test.body());
    if (lowering.failed()) {
        return new FunctionLowering(null, lowering.diagnostics());
    }
    if (!builder.terminated()) {
        ownership.releaseAllScopes(lowering);
        builder.terminate(new EirReturn(-1));
    }
    lowering.popScope();
    return new FunctionLowering(builder.finish(), lowering.diagnostics());
}

// Lowers one lambda's body: an internal function whose receiver is the closure object holding
// the captures. The body carries the trailing error-slot parameter when the target type declares
// throws, and never has catch clauses of its own.
lowerLambda(LoweringContext lowering, LambdaExpressionNode lambda) -> FunctionLowering {
    let builder = lowering.builder();
    if (lambdaThrows(lowering, lambda)) {
        builder.setThrowing();
    }
    builder.setTrace("lambda", fileNameOf(lowering.info().context().module().filePath()),
        lowering.lineAt(lambda.arrow().span()), false);
    if (!closures.lowerBody(lowering, lambda)) {
        return new FunctionLowering(null, lowering.diagnostics());
    }
    return new FunctionLowering(builder.finish(), lowering.diagnostics());
}

// Lowers the function that builds one lazy const's value. It takes no parameters and returns
// nothing, because what it produces is the value in the storage reads load from.
lowerLazyInitializer(LoweringContext lowering, LazyValueInfo lazyValue) -> FunctionLowering {
    let builder = lowering.builder();
    builder.setTrace(lazyValue.display(),
        fileNameOf(lowering.info().context().module().filePath()),
        lowering.lineAt(lazyValue.field().nameSpan()), false);
    if (!lazyvalues.lowerInitializer(lowering, lazyValue)) {
        return new FunctionLowering(null, lowering.diagnostics());
    }
    return new FunctionLowering(builder.finish(), lowering.diagnostics());
}

// True when the lambda's target type declares throws, which gives its body the trailing
// error-slot parameter.
lambdaThrows(LoweringContext lowering, LambdaExpressionNode lambda) -> bool {
    let info = lowering.result().lambdaOf(lambda.green());
    if (info == null) {
        return false;
    }
    let functionType = primitives.functionOf(lowering.substituted(info.type()));
    return functionType != null && functionType.declaresThrows();
}

// Stack traces show the quoted description, not the internal '$test<N>' name.
testTraceName(SyntaxToken? description) -> string {
    if (description == null) {
        return "\"\"";
    }
    return "\"" + string.fromBytesLossy(literals.decodeStringBytes(description.text())) + "\"";
}

// The function as a stack trace prints it: a method, static or not, by its record and name, a
// free function by its name alone.
traceNameOf(FunctionInfo info) -> string {
    let receiver = info.receiverType();
    if (receiver != null) {
        return types.display(receiver) + "." + info.signature().name();
    }
    let method = info.method();
    if (method != null) {
        return types.display(method.definingType()) + "." + info.signature().name();
    }
    return info.signature().name();
}

// The file a stack trace names: the path's last segment.
fileNameOf(string path) -> string {
    byte[] raw = path.toBytes();
    long start = 0;
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '/' || raw[i] == '\\') {
            start = i + 1;
        }
    }
    return path.substring(start, path.length);
}

// True when the constructor body chains to its base itself, with a top-level 'super(...)'.
hasExplicitSuperCall(BlockNode? body) -> bool {
    if (body == null) {
        return false;
    }
    for (long i = 0; i < body.statementsCount(); i++) {
        let statement = body.statements(i);
        if (!(statement is ExpressionStatementNode)) {
            continue;
        }
        let expression = statement.expression();
        if (expression is CallExpressionNode && expression.callee() is SuperExpressionNode) {
            return true;
        }
    }
    return false;
}

// A constructor that does not chain builds its base subobject first, before its own field
// parameters and body run: the base constructor callable with no arguments, preferring a
// zero-parameter one over one whose parameters all take defaults. A base with no constructor
// leaves nothing to run.
chainImplicitSuper(LoweringContext lowering, FunctionDeclarationNode declaration) {
    let receiverType = lowering.info().receiverType();
    if (receiverType == null || primitives.classOf(receiverType) == null) {
        return;
    }
    let base = vtables.baseClassOf(receiverType);
    if (base == null) {
        return;
    }
    let baseConstructor = classes.implicitConstructorOf(base);
    if (baseConstructor == null) {
        return;
    }
    let info = lowering.index().infoFor(baseConstructor.signature());
    if (info == null) {
        lowering.internalError("the implicit base constructor of '{types.display(base)}' "
            + "resolves to no indexed function", lowering.info().signature().nameSpan());
        return;
    }
    if (!calls.supportedCallee(lowering, info, "base constructor of '{types.display(base)}'",
            lowering.info().signature().nameSpan())) {
        return;
    }
    let ignored = calls.lowerInvocation(lowering, info, null, declaration.green(),
        lowering.info().signature().nameSpan(), base, 0);
}

// Every parameter gets a slot holding its incoming temp, so the body reads parameters exactly
// the way it reads locals. A reference argument arrives borrowed and stays the caller's, so the
// slot owns nothing; a struct argument is a copy this function may change, so it retains the
// references it holds and releases them when the function ends.
//
// A constructor parameter written 'this.field' also assigns that field, through the same barrier a
// written assignment uses, because a field default may already occupy it.
bindParameters(LoweringContext lowering, FunctionDeclarationNode declaration, BlockNode? body) {
    let signature = lowering.info().signature();
    Parameter[] parameters = signature.parameters();
    let parameterList = declaration.parameters();
    long offset = 0;
    let receiverType = lowering.info().receiverType();
    if (receiverType != null) {
        offset = 1;
        bindPrimitiveReceiver(lowering, receiverType);
    }
    for (long i = 0; i < parameters.length; i++) {
        let parameter = parameters[i];
        let parameterType = lowering.substituted(parameter.type());
        if (!lowering.supportsValueType(parameterType)) {
            lowering.unsupported("a parameter of type '{types.display(parameterType)}'",
                parameter.span());
            return;
        }
        if (i >= parameterList.parametersCount()) {
            lowering.internalError("parameter list is shorter than the signature",
                signature.nameSpan());
            return;
        }
        let binding = lowering.result().bindingOf(parameterList.parameters(i).green());
        if (binding == null) {
            lowering.internalError("parameter '{parameter.name()}' has no binding",
                parameter.span());
            return;
        }
        bool borrowing = primitives.isReferenceType(parameterType)
            && !assignsTo(lowering, body, binding);
        long slot = lowering.defineSlotAs(binding, parameter.name(), parameterType, borrowing);
        bool owns = !borrowing && primitives.hasArcContent(parameterType);
        if (owns && primitives.isReferenceType(parameterType)) {
            ownership.retainValue(lowering, i + offset);
        }
        lowering.builder().append(new EirStoreSlot(slot, i + offset));
        if (owns) {
            if (!primitives.isReferenceType(parameterType)) {
                long address = ownership.slotAddress(lowering, slot, parameterType);
                ownership.retainAt(lowering, address, parameterType);
            }
            ownership.trackSlot(lowering, slot, parameterType);
        }
        if (parameter.bindsField() && !bindField(lowering, parameter, slot, i + offset)) {
            return;
        }
    }
}

// A binding member's receiver is the primitive value itself, borrowed from the caller exactly as a
// parameter is, so it gets the same borrowing slot: every read of 'this' loads out of it, which is
// what lets a body use 'this' more than once without retaining the incoming temp in place.
bindPrimitiveReceiver(LoweringContext lowering, Type receiverType) {
    if (types.bindingOf(receiverType) == null) {
        return;
    }
    long slot = lowering.builder().addSlot("this", receiverType, false, true);
    lowering.builder().append(new EirStoreSlot(slot, 0));
    lowering.setBoundReceiver(slot);
}

// Assigns the field a 'this.field' parameter names. The incoming value is borrowed, so the field
// retains what it takes and gives up what it held, exactly as a written assignment would.
bindField(LoweringContext lowering, Parameter parameter, long slot, long incoming) -> bool {
    let receiverType = lowering.info().receiverType();
    if (receiverType == null) {
        lowering.internalError("a 'this.{parameter.name()}' parameter outside a constructor",
            parameter.span());
        return false;
    }
    let parameterType = lowering.substituted(parameter.type());
    let fields = records.fieldsOf(receiverType);
    long index = records.fieldIndexOf(receiverType, parameter.name());
    if (fields == null || index < 0) {
        lowering.internalError("'{types.display(receiverType)}' has no field "
            + "'{parameter.name()}' for its constructor parameter to assign", parameter.span());
        return false;
    }
    let field = fields.get(index);
    long destination = 0;
    long address = records.fieldAddressIn(lowering, destination, receiverType, field.type(),
        index);
    long source = -1;
    if (!primitives.isReferenceType(parameterType)
            && primitives.hasArcContent(parameterType)) {
        source = ownership.slotAddress(lowering, slot, parameterType);
    }
    let operand = new Operand(incoming, false, source);
    if (field.isWeak()) {
        weakfields.store(lowering, address, operand);
        return true;
    }
    if (!stores.assignThroughAddress(lowering, address, field.type(), operand)) {
        lowering.internalError("the constructor parameter '{parameter.name()}' borrows a struct "
            + "with no storage to retain", parameter.span());
        return false;
    }
    return true;
}

// True when the body assigns to this binding. A reference parameter that is only read keeps its
// caller's reference and pays no atomics; one that is written over has to own what it holds, so
// its slot takes a reference of its own at entry and gives it up at the end.
assignsTo(LoweringContext lowering, BlockNode? body, LocalBinding binding) -> bool {
    if (body == null) {
        return false;
    }
    return assignsWithin(lowering, body, binding);
}

assignsWithin(LoweringContext lowering, SyntaxNode node, LocalBinding binding) -> bool {
    if (node is AssignmentExpressionNode) {
        let target = node.target();
        if (target is IdentifierExpressionNode
                && lowering.result().bindingOf(target.green()) == binding) {
            return true;
        }
    }
    for (let child in node.childNodes()) {
        if (assignsWithin(lowering, child, binding)) {
            return true;
        }
    }
    return false;
}
