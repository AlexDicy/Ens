// A struct's text form, which is JSON: '{' then every field as '"name": value' in declaration
// order, separated by ', ', then '}'. Private and protected fields are included, because
// visibility does not change what a value looks like as text.
import Expression from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import EnumType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBranch from eir.model;
import EirJsonEscape from eir.model;
import EirJump from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirStoreSlot from eir.model;
import LoweringContext from lower.context;
import lower.arraycontent;
import lower.conversions;
import lower.optionals;
import lower.ownership;
import lower.places;
import lower.records;
import lower.stores;
import lower.strings;
import lower.structs;
import support.primitives;

// The JSON text of the struct an expression names, as a string the caller owns.
public lowerStruct(LoweringContext lowering, Expression node, Type type) -> long {
    long base = structs.addressOf(lowering, node, type);
    if (base < 0) {
        if (!lowering.failed()) {
            lowering.unsupported("converting this expression to text", node.span());
        }
        return -1;
    }
    return renderAt(lowering, base, type, node.span());
}

// The JSON text of the struct the storage at an address holds.
public renderAt(LoweringContext lowering, long base, Type type, Span span) -> long {
    long accumulator = strings.literalText(lowering, "\{");
    ownership.retainValue(lowering, accumulator);
    let fields = records.fieldsOf(type);
    if (fields == null) {
        return -1;
    }
    for (long i = 0; i < fields.length(); i++) {
        string separator = "";
        if (i > 0) {
            separator = ", ";
        }
        accumulator = strings.appendText(lowering, accumulator,
            separator + "\"" + fields.get(i).name() + "\": ");
        long rendered = renderField(lowering, base, type, i, span);
        if (rendered < 0) {
            return -1;
        }
        accumulator = strings.appendOwned(lowering, accumulator, rendered);
    }
    return strings.appendText(lowering, accumulator, "\}");
}

// One field's JSON value, as a string the caller owns. A char and an enum member become text
// first and are then escaped like any other string, so a char renders as a one-character quoted
// string rather than a code point.
renderField(LoweringContext lowering, long base, Type owner, long index, Span span)
        -> long {
    let fields = records.fieldsOf(owner);
    if (fields == null) {
        return -1;
    }
    let field = fields.get(index);
    let fieldType = field.type();
    if (!rendersAsJson(fieldType)) {
        lowering.unsupported("converting '{types.display(owner)}' to text: its field "
            + "'{field.name()}' has type '{types.display(fieldType)}', and only integers, bool, "
            + "char, float, double, string, enum, their nullable forms, and nested structs of "
            + "those render as JSON", span);
        return -1;
    }
    long address = structs.fieldAddressAt(lowering, base, fieldType, index);
    return renderValueAt(lowering, address, fieldType, span);
}

// The JSON value of the storage an address names, as a string the caller owns. An absent
// nullable field renders as 'null' and a present one as its payload's own form.
renderValueAt(LoweringContext lowering, long address, Type type, Span span) -> long {
    let builder = lowering.builder();
    let stringType = lowering.store().stringType();
    let payloadType = primitives.taggedPayloadOf(type);
    if (payloadType != null) {
        long pair = places.loadFrom(lowering, address, type);
        long present = optionals.presenceOf(lowering, pair, type);
        long slot = ownership.defineMergeSlot(lowering, "jsonopt", stringType);
        long presentBlock = builder.newBlock("json.opt.present");
        long absentBlock = builder.newBlock("json.opt.absent");
        long mergeBlock = builder.newBlock("json.opt.end");
        builder.terminate(new EirBranch(present, presentBlock, absentBlock));
        builder.moveTo(presentBlock);
        long payloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(payloadAddress, payloadType, address));
        long rendered = renderValueAt(lowering, payloadAddress, payloadType, span);
        if (rendered < 0) {
            return -1;
        }
        if (!stores.assignSlot(lowering, slot, stringType,
                new stores.Operand(rendered, true, -1))) {
            return -1;
        }
        builder.terminate(new EirJump(mergeBlock));
        builder.moveTo(absentBlock);
        if (!storeNullText(lowering, slot, stringType)) {
            return -1;
        }
        builder.terminate(new EirJump(mergeBlock));
        builder.moveTo(mergeBlock);
        return loadOwnedText(lowering, slot, stringType);
    }
    if (type is OptionalType && primitives.isStringType(type.inner())) {
        long value = places.loadFrom(lowering, address, type);
        long present = optionals.presenceOf(lowering, value, type);
        long slot = ownership.defineMergeSlot(lowering, "jsonopt", stringType);
        long presentBlock = builder.newBlock("json.opt.present");
        long absentBlock = builder.newBlock("json.opt.absent");
        long mergeBlock = builder.newBlock("json.opt.end");
        builder.terminate(new EirBranch(present, presentBlock, absentBlock));
        builder.moveTo(presentBlock);
        long narrowed = conversions.convert(lowering, value, lowering.store().stringType(),
            span);
        if (narrowed < 0) {
            return -1;
        }
        if (!stores.assignSlot(lowering, slot, stringType,
                new stores.Operand(escaped(lowering, narrowed), true, -1))) {
            return -1;
        }
        builder.terminate(new EirJump(mergeBlock));
        builder.moveTo(absentBlock);
        if (!storeNullText(lowering, slot, stringType)) {
            return -1;
        }
        builder.terminate(new EirJump(mergeBlock));
        builder.moveTo(mergeBlock);
        return loadOwnedText(lowering, slot, stringType);
    }
    if (primitives.structOf(type) != null) {
        return renderAt(lowering, address, type, span);
    }
    if (primitives.arrayOf(type) != null) {
        long array = places.loadFrom(lowering, address, type);
        return arraycontent.lowerToString(lowering, array, type, span);
    }
    long value = places.loadFrom(lowering, address, type);
    if (primitives.isStringType(type)) {
        return escaped(lowering, value);
    }
    if (primitives.isCharType(type) || type is EnumType) {
        long text = strings.convertToString(lowering, value, type, span);
        if (text < 0) {
            return -1;
        }
        long quoted = escaped(lowering, text);
        ownership.releaseValue(lowering, text);
        return quoted;
    }
    return strings.convertToString(lowering, value, type, span);
}

// The field types with a JSON form. An array always has one, since sema already refused any
// element type JSON cannot render.
rendersAsJson(Type type) -> bool {
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        return rendersAsJson(payload);
    }
    if (primitives.arrayOf(type) != null) {
        return true;
    }
    if (type is OptionalType) {
        return primitives.isStringType(type.inner());
    }
    return primitives.isNumericType(type) || primitives.isBoolType(type)
        || primitives.isStringType(type) || type is EnumType
        || primitives.structOf(type) != null;
}

// Fills a merge slot's arm with the literal 'null'.
storeNullText(LoweringContext lowering, long slot, Type stringType) -> bool {
    long absent = strings.literalText(lowering, "null");
    return stores.assignSlot(lowering, slot, stringType, new stores.Operand(absent, false, -1));
}

// The merged text with a reference of its own, so the caller owns what it hands on while the
// scope-owned slot keeps and later releases its copy.
loadOwnedText(LoweringContext lowering, long slot, Type stringType) -> long {
    let builder = lowering.builder();
    long merged = builder.newTemp(stringType);
    builder.append(new EirLoadSlot(merged, stringType, slot));
    ownership.retainValue(lowering, merged);
    return merged;
}

// The JSON string form of a string: quoted and escaped, as a fresh string the caller owns. The
// quotes come from the escape itself, so nothing wraps its result.
escaped(LoweringContext lowering, long text) -> long {
    let builder = lowering.builder();
    let stringType = lowering.store().stringType();
    long result = builder.newTemp(stringType);
    builder.append(new EirJsonEscape(result, stringType, text));
    return result;
}
