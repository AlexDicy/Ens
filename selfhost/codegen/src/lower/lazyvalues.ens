// The two globals one lazy const keeps its value and its state in, the function that builds the
// value, and the guard a read is fronted by. The value is built once however many tasks read it
// first, by the first of them while the others wait, and a reference it holds is made immortal, so a
// read returns a borrowed one that no task's count changes and the cycle refusal stays off the hot
// path. A lazy const of each object keeps its value and its state in two fields of the object
// instead, and is released with the object's other fields.
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import Field from @ens.sema.model.typemembers;
import @ens.sema.model.typemembers;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirConstInt from eir.model;
import EirGlobalAddress from eir.model;
import EirJump from eir.model;
import EirPanic from eir.model;
import EirReturn from eir.model;
import EirForeignCall from eir.model;
import EirUnreachable from eir.model;
import LazyValueInfo from lower.index;
import LoweringContext from lower.context;
import lower.ownedreads;
import lower.ownership;
import lower.places;
import lower.records;
import lower.symbols;
import lower.stores;
import lower.strings;
import support.primitives;

// What the guard's entry answers: another thread built the value, this one is to build it, or this
// one is building it already.
final class LazyEntry {
    protected static const long built = 0;
    protected static const long build = 1;
    protected static const long cycle = 2;
}

// Reads one lazy const, taking the initializer call only on the cold edge. Returns the address
// of the value, which the caller reads at the type the expression was recorded at.
public lowerReadAddress(LoweringContext lowering, MemberExpressionNode member, Field field) -> long {
    let lazyValue = lowering.index().lazyValueOf(field);
    if (lazyValue == null) {
        lowering.internalError("lazy const '{field.name()}' reached lowering with no storage "
            + "planned for it", member.span());
        return -1;
    }
    guardRead(lowering, member.span(), stateAddress(lowering, lazyValue),
        initializerCallee(lowering, lazyValue), -1);
    return valueAddress(lowering, lazyValue);
}

// Reads the lazy const at 'index' of the object 'object' of 'classType', taking the call of the
// initializer of the class that declares it only on the cold edge. Returns the address of the value.
public lowerObjectReadAddress(LoweringContext lowering, Span span, Type classType, long object,
                              long index) -> long {
    let fields = records.fieldsOf(classType);
    if (fields == null) {
        return -1;
    }
    let field = fields.get(index);
    let declaring = field.definingType();
    string symbol = symbols.objectLazyInitializerLinkName(declaring, field.name());
    if (lowering.index().functionForSymbol(symbol) == null) {
        lowering.internalError("lazy const '{field.name()}' reached lowering with no initializer "
            + "planned for it", span);
        return -1;
    }
    long state = records.fieldAddressIn(lowering, object, classType, stateType(lowering), index + 1);
    guardRead(lowering, span, state, new EirCallee(symbol, declaring, [], voidType(lowering)),
        object);
    return records.fieldAddressIn(lowering, object, classType, field.type(), index);
}

// The guard in front of a read: the value is there, or the initializer 'callee' builds it, run over
// 'receiver' where it takes one.
guardRead(LoweringContext lowering, Span span, long state, EirCallee callee, long receiver) {
    let builder = lowering.builder();
    long ready = guardCall(lowering, booleanType(lowering), "ens_lazy_ready", state);
    let readyBlock = builder.newBlock("lazy.ready");
    let buildBlock = builder.newBlock("lazy.build");
    builder.terminate(new EirBranch(ready, readyBlock, buildBlock));
    builder.moveTo(buildBlock);
    builder.append(new EirCall(-1, voidType(lowering), callee, receiver, [], -1, null,
        lowering.lineAt(span)));
    builder.terminate(new EirJump(readyBlock));
    builder.moveTo(readyBlock);
}

// Builds one lazy const's value in the module that declares it, between the marks that record the
// building has begun and that the value is there.
public lowerInitializer(LoweringContext lowering, LazyValueInfo lazyValue) -> bool {
    let builder = lowering.builder();
    long index = -1;
    if (lazyValue.isForEachObject()) {
        index = typemembers.inheritedOrOwnFieldIndex(lazyValue.owner(), lazyValue.field().name());
    }
    long entry = guardCall(lowering, entryType(lowering), "ens_lazy_enter",
        storedStateAddress(lowering, lazyValue, index));
    let checkBlock = builder.newBlock("lazy.check");
    let builtBlock = builder.newBlock("lazy.built");
    let cycleBlock = builder.newBlock("lazy.cycle");
    let buildBlock = builder.newBlock("lazy.build");
    builder.terminate(new EirBranch(entryTest(lowering, entry, LazyEntry.built), builtBlock,
        checkBlock));
    builder.moveTo(builtBlock);
    builder.terminate(new EirReturn(-1));
    builder.moveTo(checkBlock);
    builder.terminate(new EirBranch(entryTest(lowering, entry, LazyEntry.cycle), cycleBlock,
        buildBlock));
    builder.moveTo(cycleBlock);
    long message = strings.literalText(lowering, "'{lazyValue.display()}' was read while it "
        + "was still being initialized");
    builder.append(new EirPanic(message, lowering.lineAt(lazyValue.initializer().span())));
    builder.terminate(new EirUnreachable());
    builder.moveTo(buildBlock);
    Type valueType = lowering.substituted(lazyValue.field().type());
    lowering.pushScope();
    let outer = lowering.enterOwnedReads(ownedreads.ofExpression(lowering,
        lazyValue.initializer()));
    let operand = stores.lowerOperand(lowering, lazyValue.initializer(), valueType);
    let ignored = lowering.enterOwnedReads(outer);
    if (operand == null) {
        return false;
    }
    long address = storedValueAddress(lowering, lazyValue, index);
    if (!stores.initializeThroughAddress(lowering, address, valueType, operand)) {
        lowering.internalError("the initializer of lazy const '{lazyValue.display()}' borrows "
            + "a value with no storage to retain", lazyValue.initializer().span());
        return false;
    }
    if (!lazyValue.isForEachObject() && primitives.isReferenceType(valueType)) {
        builder.append(new EirForeignCall(-1, voidType(lowering), "ens_lazy_keep",
            [valueAddress(lowering, lazyValue)], [valueType], [true]));
    }
    guardCall(lowering, voidType(lowering), "ens_lazy_leave",
        storedStateAddress(lowering, lazyValue, index));
    ownership.releaseAllScopes(lowering);
    builder.terminate(new EirReturn(-1));
    lowering.popScope();
    return true;
}

// Calls one of the guard's bridges over the state word, which it is handed by address, and returns
// the temp holding what it answers, or -1 for a bridge that answers nothing.
guardCall(LoweringContext lowering, Type type, string symbol, long address) -> long {
    let builder = lowering.builder();
    long result = -1;
    if (!types.isVoidType(type)) {
        result = builder.newTemp(type);
    }
    builder.append(new EirForeignCall(result, type, symbol, [address], [stateType(lowering)],
        [true]));
    return result;
}

// Tests what the guard's entry answered against one answer.
entryTest(LoweringContext lowering, long entry, long against) -> long {
    let builder = lowering.builder();
    long expected = builder.newTemp(entryType(lowering));
    builder.append(new EirConstInt(expected, entryType(lowering), against));
    long result = builder.newTemp(booleanType(lowering));
    builder.append(new EirBinary(result, booleanType(lowering), EirBinaryOp.CmpEq, entry,
        expected));
    return result;
}

// The state word an initializer marks: a global, or the field after the value in the object the
// initializer runs over, whose layout places the value at 'index'.
storedStateAddress(LoweringContext lowering, LazyValueInfo lazyValue, long index) -> long {
    if (!lazyValue.isForEachObject()) {
        return stateAddress(lowering, lazyValue);
    }
    return records.fieldAddressIn(lowering, 0, lazyValue.owner(), stateType(lowering), index + 1);
}

storedValueAddress(LoweringContext lowering, LazyValueInfo lazyValue, long index) -> long {
    if (!lazyValue.isForEachObject()) {
        return valueAddress(lowering, lazyValue);
    }
    Type valueType = lowering.substituted(lazyValue.field().type());
    return records.fieldAddressIn(lowering, 0, lazyValue.owner(), valueType, index);
}

stateAddress(LoweringContext lowering, LazyValueInfo lazyValue) -> long {
    let builder = lowering.builder();
    long address = builder.newTemp(stateType(lowering));
    builder.append(new EirGlobalAddress(address, stateType(lowering), lazyValue.stateSymbol(),
        definesStorage(lowering, lazyValue)));
    return address;
}

valueAddress(LoweringContext lowering, LazyValueInfo lazyValue) -> long {
    let builder = lowering.builder();
    Type valueType = lowering.substituted(lazyValue.field().type());
    long address = builder.newTemp(valueType);
    builder.append(new EirGlobalAddress(address, valueType, lazyValue.valueSymbol(),
        definesStorage(lowering, lazyValue)));
    return address;
}

// True while lowering this value's own initializer, which only its declaring module does, so
// that is the module whose object file carries the storage.
definesStorage(LoweringContext lowering, LazyValueInfo lazyValue) -> bool {
    return lowering.info().lazyValue() == lazyValue;
}

initializerCallee(LoweringContext lowering, LazyValueInfo lazyValue) -> EirCallee {
    return new EirCallee(lazyValue.initializerSymbol(), null, [], voidType(lowering));
}

stateType(LoweringContext lowering) -> Type {
    return lowering.store().primitive(PrimitiveKind.Long);
}

entryType(LoweringContext lowering) -> Type {
    return lowering.store().primitive(PrimitiveKind.Int);
}

booleanType(LoweringContext lowering) -> Type {
    return lowering.store().primitive(PrimitiveKind.Bool);
}

voidType(LoweringContext lowering) -> Type {
    return lowering.store().primitive(PrimitiveKind.Void);
}
