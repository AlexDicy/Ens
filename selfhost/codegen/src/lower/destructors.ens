// The destructor every class carries in its object header. The runtime calls it once, when the last
// strong reference goes away and before the allocation is freed, handing it the object.
//
// It runs the user destructors of the class's whole chain first, most derived to base, while every
// field is still readable, then gives up what each flattened field holds: a strong reference is
// released, a weak field stops watching, and a struct field is walked into for the references
// inside it. The header names the concrete type's destructor at allocation, which is what makes
// destruction through a base reference polymorphic with no dispatch table. A class whose fields
// hold nothing and that declares no destructor still gets one, an empty function: what to release
// is not a decision worth encoding in two places, and removing a call that does nothing is a job
// for a pass that can see it does nothing.
//
// It is built straight from the class rather than from a declaration, so nothing here walks a
// syntax tree and no expression lowering is involved.
import LambdaCapture from @ens.sema.model.lambdas;
import ClassType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBranch from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirClosureCapture from eir.model;
import EirFieldAddress from eir.model;
import EirFunction from eir.model;
import EirFunctionBuilder from eir.model;
import EirJump from eir.model;
import EirLoadPtr from eir.model;
import EirObjectFieldAddress from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirParameter from eir.model;
import EirReleasePtr from eir.model;
import EirReturn from eir.model;
import EirWeakRelease from eir.model;
import layout.vtables;
import mono.substitution;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import lower.classes;
import lower.closures;
import support.primitives;
import List from @std.collections.list;

// Builds the destructor of one class, declared or instantiated. Returns null when the class is
// one code generation cannot lay out, in which case nothing that touches it will lower either.
public synthesize(Type classType, ProgramIndex index, TypeStore store) -> EirFunction? {
    if (!primitives.isRepresentableClass(classType)) {
        return null;
    }
    let voidType = store.primitive(PrimitiveKind.Void);
    let builder = new EirFunctionBuilder(classes.destructorSymbol(classType), false, null,
        [new EirParameter("object", classType)], voidType);
    long object = 0;
    Type? current = classType;
    while (current != null) {
        callDeclaredDestructor(builder, current, index, voidType, object);
        current = vtables.baseClassOf(current);
    }
    let fields = types.fieldsOf(classType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (!field.isWeak() && !primitives.hasArcContent(field.type())) {
            continue;
        }
        long address = builder.newTemp(field.type());
        builder.append(new EirObjectFieldAddress(address, field.type(), object, i));
        if (field.isWeak()) {
            builder.append(new EirWeakRelease(address));
        } else {
            releaseStorage(builder, store, address, field.type());
        }
    }
    builder.terminate(new EirReturn(-1));
    return builder.finish();
}

// Builds the destructor of one closure object: it gives up every captured value that holds a
// reference, in capture order. A capture-free lambda needs none, because its one object is
// immortal and is never freed. Returns null when the lambda's shape is one code generation cannot
// lay out, in which case nothing that creates it will lower either.
public synthesizeClosure(FunctionInfo info, TypeStore store) -> EirFunction? {
    let lambda = info.lambdaDeclaration();
    if (lambda == null) {
        return null;
    }
    let recorded = info.context().result().lambdaOf(lambda.green());
    let closureType = info.receiverType();
    if (recorded == null || closureType == null) {
        return null;
    }
    LambdaCapture[] captures = recorded.captures();
    let captureTypes = new List<Type>();
    for (let capture in captures) {
        Type captureType = substitution.apply(store, info.substitution(), capture.type());
        if (!primitives.isRepresentable(captureType)) {
            return null;
        }
        captureTypes.push(captureType);
    }
    Type[] layout = captureTypes.toArray();
    string symbol = closures.destructorSymbolOf(info.symbol(), layout);
    if (symbol.length == 0) {
        return null;
    }
    let voidType = store.primitive(PrimitiveKind.Void);
    // External, like the lambda's body and like a class's destructor: the module that writes the
    // lambda defines it, and any module that builds a closure over it names it.
    let builder = new EirFunctionBuilder(symbol, false, null,
        [new EirParameter("closure", closureType)], voidType);
    long closure = 0;
    for (long i = 0; i < captures.length; i++) {
        if (!primitives.hasArcContent(layout[i])) {
            continue;
        }
        long address = builder.newTemp(layout[i]);
        builder.append(new EirClosureCapture(address, layout[i], closure, i, layout));
        releaseStorage(builder, store, address, layout[i]);
    }
    builder.terminate(new EirReturn(-1));
    return builder.finish();
}

callDeclaredDestructor(EirFunctionBuilder builder, Type classType, ProgramIndex index,
                       Type voidType, long object) {
    let declared = classes.declaredDestructor(classType);
    if (declared == null) {
        return;
    }
    let info = index.infoFor(declared.signature());
    if (info == null) {
        return;
    }
    let callee = new EirCallee(info.symbol(), classType, [], voidType);
    builder.append(new EirCall(-1, voidType, callee, object, [], -1, null));
}

// Gives up the references the storage at an address holds: a reference directly, a struct field by
// field.
releaseStorage(EirFunctionBuilder builder, TypeStore store, long address, Type type) {
    if (primitives.isReferenceType(type)) {
        builder.append(new EirReleasePtr(address));
        return;
    }
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        if (!primitives.hasArcContent(payload)) {
            return;
        }
        let boolType = store.primitive(PrimitiveKind.Bool);
        long pair = builder.newTemp(type);
        builder.append(new EirLoadPtr(pair, type, address));
        long present = builder.newTemp(boolType);
        builder.append(new EirOptionalPresence(present, boolType, pair));
        long walkBlock = builder.newBlock("dtor.opt");
        long doneBlock = builder.newBlock("dtor.opt.end");
        builder.terminate(new EirBranch(present, walkBlock, doneBlock));
        builder.moveTo(walkBlock);
        long payloadAddress = builder.newTemp(payload);
        builder.append(new EirOptionalPayloadAddress(payloadAddress, payload, address));
        releaseStorage(builder, store, payloadAddress, payload);
        builder.terminate(new EirJump(doneBlock));
        builder.moveTo(doneBlock);
        return;
    }
    let structType = primitives.structOf(type);
    if (structType == null) {
        return;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (!primitives.hasArcContent(field.type())) {
            continue;
        }
        long fieldAddress = builder.newTemp(field.type());
        builder.append(new EirFieldAddress(fieldAddress, field.type(), address, i));
        releaseStorage(builder, store, fieldAddress, field.type());
    }
}
