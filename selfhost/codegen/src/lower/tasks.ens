// The '@std.tasks' intercept: whether another task may hold a task's result or its error, which each
// instance of the library's 'TaskOutcome' answers from its type arguments, so the call is that
// constant and its Ens body never runs.
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import Method from @ens.sema.model.typemembers;
import @ens.sema.model.sharing;
import InstantiationType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import ThrownListType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import EirConstBool from eir.model;
import LoweringContext from lower.context;

final class Modules {
    protected static const string tasks = "std.tasks";
}

public isIntercepted(Type receiverType, Method method) -> bool {
    if (!(receiverType is InstantiationType)) {
        return false;
    }
    let template = receiverType.template();
    if (template.name() != "TaskOutcome" || template.modulePath() != Modules.tasks
            || receiverType.arguments().length != 2) {
        return false;
    }
    return method.name() == "resultIsShareable" || method.name() == "failureIsShareable";
}

public lowerCall(LoweringContext lowering, CallExpressionNode call, Type receiverType,
                 Method method) -> long {
    if (!(receiverType is InstantiationType)) {
        return -1;
    }
    Type[] arguments = receiverType.arguments();
    bool shareable = listIsShareable(arguments[1]);
    if (method.name() == "resultIsShareable") {
        shareable = sharing.whyUnshareable(arguments[0]) == null;
    }
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long result = lowering.builder().newTemp(boolType);
    lowering.builder().append(new EirConstBool(result, boolType, shareable));
    return result;
}

// Whether every type a throws list names is one another task may hold.
listIsShareable(Type listed) -> bool {
    if (!(listed is ThrownListType)) {
        return sharing.whyUnshareable(listed) == null;
    }
    for (let member in listed.members()) {
        if (sharing.whyUnshareable(member) != null) {
            return false;
        }
    }
    return true;
}
