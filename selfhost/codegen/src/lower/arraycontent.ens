// Arrays compare, hash, and render by content through one synthesized function per element
// type, with internal linkage named by the module that builds it. A plan memoizes a symbol before
// building its body, so a struct holding an array of itself recurses into the same symbol instead
// of looping forever, and every synthesized function is null-safe, so a nested call needs no guard.
import Span from @ens.frontend.support.source;
import Type from @ens.sema.model.types;
import ArrayType from @ens.sema.model.types;
import EnumType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import Method from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirCall from eir.model;
import EirCallee from eir.model;
import EirCast from eir.model;
import EirCastOp from eir.model;
import EirCharToString from eir.model;
import EirConstBool from eir.model;
import EirConstInt from eir.model;
import EirConstNull from eir.model;
import EirConstString from eir.model;
import EirDoubleToString from eir.model;
import EirBoolToString from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirElementAddress from eir.model;
import EirEnumToString from eir.model;
import EirFieldAddress from eir.model;
import EirFunction from eir.model;
import EirFunctionBuilder from eir.model;
import EirHashValue from eir.model;
import EirIntToString from eir.model;
import EirJump from eir.model;
import EirJsonEscape from eir.model;
import EirLoadPtr from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirParameter from eir.model;
import EirRelease from eir.model;
import EirReleasePtr from eir.model;
import EirRetain from eir.model;
import EirSlotAddress from eir.model;
import EirReturn from eir.model;
import EirStoreSlot from eir.model;
import EirStringConcat from eir.model;
import EirTakeSlot from eir.model;
import EirStringEqual from eir.model;
import EirUnary from eir.model;
import EirUnaryOp from eir.model;
import EirArrayLength from eir.model;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import LoweringContext from lower.context;
import lower.symbols;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;

// One module's array-content functions, built once each and collected by the driver after the
// module's functions have all lowered.
public final class ArrayContentPlan {
    ProgramIndex planIndex;
    TypeStore planStore;
    string planModulePath;
    Map<Type, string> equalsSymbols;
    Map<Type, string> hashSymbols;
    Map<Type, string> textSymbols;
    List<EirFunction> synthesized;

    public constructor(ProgramIndex index, TypeStore store, string modulePath) {
        this.planIndex = index;
        this.planStore = store;
        this.planModulePath = modulePath;
        this.equalsSymbols = new Map<Type, string>();
        this.hashSymbols = new Map<Type, string>();
        this.textSymbols = new Map<Type, string>();
        this.synthesized = new List<EirFunction>();
    }

    public index() -> ProgramIndex {
        return this.planIndex;
    }

    public store() -> TypeStore {
        return this.planStore;
    }

    // Every function the plan has built so far, in the order requests first reached them.
    public builtFunctions() -> EirFunction[] {
        return this.synthesized.toArray();
    }

    // The symbol of 'bool(T[], T[])' for this element type, built on first request.
    public equalsSymbol(Type elementType) -> string {
        let cached = this.equalsSymbols.get(elementType);
        if (cached != null) {
            return cached;
        }
        string symbol = this.symbolFor("_arreq", elementType);
        this.equalsSymbols.set(elementType, symbol);
        this.synthesized.push(buildEquals(this, elementType, symbol));
        return symbol;
    }

    // The symbol of 'long(T[])' for this element type, built on first request.
    public hashSymbol(Type elementType) -> string {
        let cached = this.hashSymbols.get(elementType);
        if (cached != null) {
            return cached;
        }
        string symbol = this.symbolFor("_arrhash", elementType);
        this.hashSymbols.set(elementType, symbol);
        this.synthesized.push(buildHash(this, elementType, symbol));
        return symbol;
    }

    // The symbol of 'string(T[])' for this element type, built on first request.
    public textSymbol(Type elementType) -> string {
        let cached = this.textSymbols.get(elementType);
        if (cached != null) {
            return cached;
        }
        string symbol = this.symbolFor("_arrtext", elementType);
        this.textSymbols.set(elementType, symbol);
        this.synthesized.push(buildText(this, elementType, symbol));
        return symbol;
    }

    // '<kind>$<module>$<element>': every lowered symbol is unique program-wide, and the leading
    // '_' keeps it apart from anything a program declares.
    symbolFor(string kind, Type elementType) -> string {
        return kind + "$" + symbols.sanitizeModulePath(this.planModulePath) + "$"
            + symbols.mangleTypeForName(elementType);
    }
}

// Retypes an array value to the bare array type a synthesized function declares. Every spelling
// of an array shares one representation, so the pointer is unchanged.
public reinterpretArray(EirFunctionBuilder builder, long value, Type bareArrayType) -> long {
    return reinterpretTo(builder, value, bareArrayType);
}

// Retypes a nullable reference to its bare referent type, which shares its representation. The
// string instructions are shaped around the bare type, so a 'string?' element passes through
// here first.
reinterpretTo(EirFunctionBuilder builder, long value, Type bareType) -> long {
    if (builder.tempType(value) == bareType) {
        return value;
    }
    long renamed = builder.newTemp(bareType);
    builder.append(new EirCast(renamed, bareType, EirCastOp.Reinterpret, value));
    return renamed;
}

// ---------------------------------------------------------------------------------------------
// Entry points for the lowering passes. Each borrows its argument; the caller still owns it
// afterward.

// 'left == right' over two arrays of the same type, by content. 'negated' gives '!='.
public lowerEqual(LoweringContext lowering, long left, long right, Type arrayType, bool negated,
                  Type resultType, Span span) -> long {
    let array = primitives.arrayOf(arrayType);
    if (array == null) {
        lowering.internalError("array content equality asked about a non-array type", span);
        return -1;
    }
    let bareArrayType = lowering.store().arrayOf(array.element());
    string symbol = lowering.arrayContent().equalsSymbol(array.element());
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    let callee = new EirCallee(symbol, null, [bareArrayType, bareArrayType], boolType);
    long leftBare = reinterpretArray(builder, left, bareArrayType);
    long rightBare = reinterpretArray(builder, right, bareArrayType);
    long result = builder.newTemp(boolType);
    builder.append(new EirCall(result, boolType, callee, -1, [leftBare, rightBare], -1, null,
        lowering.lineAt(span)));
    if (!negated) {
        return result;
    }
    long inverted = builder.newTemp(resultType);
    builder.append(new EirUnary(inverted, resultType, EirUnaryOp.Not, result));
    return inverted;
}

// 'value.hash()' over an array, by content.
public lowerHash(LoweringContext lowering, long value, Type arrayType, Span span) -> long {
    let array = primitives.arrayOf(arrayType);
    if (array == null) {
        lowering.internalError("array content hash asked about a non-array type", span);
        return -1;
    }
    let bareArrayType = lowering.store().arrayOf(array.element());
    string symbol = lowering.arrayContent().hashSymbol(array.element());
    let builder = lowering.builder();
    let longType = lowering.store().primitive(PrimitiveKind.Long);
    let callee = new EirCallee(symbol, null, [bareArrayType], longType);
    long bare = reinterpretArray(builder, value, bareArrayType);
    long result = builder.newTemp(longType);
    builder.append(new EirCall(result, longType, callee, -1, [bare], -1, null,
        lowering.lineAt(span)));
    return result;
}

// The text form of an array, as a fresh string the caller owns.
public lowerToString(LoweringContext lowering, long value, Type arrayType, Span span) -> long {
    let array = primitives.arrayOf(arrayType);
    if (array == null) {
        lowering.internalError("array content text asked about a non-array type", span);
        return -1;
    }
    let bareArrayType = lowering.store().arrayOf(array.element());
    string symbol = lowering.arrayContent().textSymbol(array.element());
    let builder = lowering.builder();
    let stringType = lowering.store().stringType();
    let callee = new EirCallee(symbol, null, [bareArrayType], stringType);
    long bare = reinterpretArray(builder, value, bareArrayType);
    long result = builder.newTemp(stringType);
    builder.append(new EirCall(result, stringType, callee, -1, [bare], -1, null,
        lowering.lineAt(span)));
    return result;
}

// bool _arreq$<module>$<T>(T[] left, T[] right). The same object is not special-cased, since a float
// element compares by IEEE rules even against itself, and the loop only reads the elements.
buildEquals(ArrayContentPlan plan, Type elementType, string symbol) -> EirFunction {
    let store = plan.store();
    let arrayType = store.arrayOf(elementType);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let longType = store.primitive(PrimitiveKind.Long);
    let builder = new EirFunctionBuilder(symbol, true, null,
        [new EirParameter("left", arrayType), new EirParameter("right", arrayType)], boolType);
    long left = 0;
    long right = 1;

    long falseBlock = builder.newBlock("arreq.false");
    long trueBlock = builder.newBlock("arreq.true");
    long leftAbsent = absentTest(builder, boolType, left, arrayType);
    long rightAbsent = absentTest(builder, boolType, right, arrayType);
    long eitherAbsent = boolTemp(builder, boolType, EirBinaryOp.Or, leftAbsent, rightAbsent);
    long bothAbsentBlock = builder.newBlock("arreq.bothabsent");
    long lengthBlock = builder.newBlock("arreq.length");
    builder.terminate(new EirBranch(eitherAbsent, bothAbsentBlock, lengthBlock));

    builder.moveTo(bothAbsentBlock);
    long bothAbsent = boolTemp(builder, boolType, EirBinaryOp.And, leftAbsent, rightAbsent);
    builder.terminate(new EirBranch(bothAbsent, trueBlock, falseBlock));

    builder.moveTo(lengthBlock);
    long leftLength = arrayLength(builder, longType, left);
    long rightLength = arrayLength(builder, longType, right);
    long sameLength = boolTemp(builder, boolType, EirBinaryOp.CmpEq, leftLength, rightLength);
    long loopInit = builder.newBlock("arreq.init");
    builder.terminate(new EirBranch(sameLength, loopInit, falseBlock));

    builder.moveTo(loopInit);
    long indexSlot = builder.addSlot("index", longType, false, false);
    storeConst(builder, indexSlot, constInt(builder, longType, 0));
    long testBlock = builder.newBlock("arreq.test");
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(testBlock);
    long index = loadSlot(builder, longType, indexSlot);
    long more = boolTemp(builder, boolType, EirBinaryOp.CmpLtSigned, index, leftLength);
    long bodyBlock = builder.newBlock("arreq.body");
    builder.terminate(new EirBranch(more, bodyBlock, trueBlock));

    builder.moveTo(bodyBlock);
    long leftAddress = elementAddress(builder, elementType, left, index);
    long rightAddress = elementAddress(builder, elementType, right, index);
    long elementsEqual = elementEqualAt(builder, plan, leftAddress, rightAddress, elementType);
    long stepBlock = builder.newBlock("arreq.step");
    builder.terminate(new EirBranch(elementsEqual, stepBlock, falseBlock));

    builder.moveTo(stepBlock);
    storeConst(builder, indexSlot, boolTemp(builder, boolType, EirBinaryOp.Add, index,
        constInt(builder, longType, 1)));
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(trueBlock);
    builder.terminate(new EirReturn(constBool(builder, boolType, true)));

    builder.moveTo(falseBlock);
    builder.terminate(new EirReturn(constBool(builder, boolType, false)));

    return builder.finish();
}

// long _arrhash$<module>$<T>(T[] array): -1 for an absent array, otherwise the 31-multiply fold of the
// element hashes seeded at 17.
buildHash(ArrayContentPlan plan, Type elementType, string symbol) -> EirFunction {
    let store = plan.store();
    let arrayType = store.arrayOf(elementType);
    let longType = store.primitive(PrimitiveKind.Long);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder(symbol, true, null,
        [new EirParameter("array", arrayType)], longType);
    long array = 0;

    long absentBlock = builder.newBlock("arrhash.absent");
    long presentBlock = builder.newBlock("arrhash.present");
    builder.terminate(new EirBranch(absentTest(builder, boolType, array, arrayType), absentBlock, presentBlock));

    builder.moveTo(absentBlock);
    builder.terminate(new EirReturn(constInt(builder, longType, -1)));

    builder.moveTo(presentBlock);
    long length = arrayLength(builder, longType, array);
    long hashSlot = builder.addSlot("hash", longType, false, false);
    storeConst(builder, hashSlot, constInt(builder, longType, 17));
    long indexSlot = builder.addSlot("index", longType, false, false);
    storeConst(builder, indexSlot, constInt(builder, longType, 0));
    long testBlock = builder.newBlock("arrhash.test");
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(testBlock);
    long index = loadSlot(builder, longType, indexSlot);
    long more = boolTemp(builder, boolType, EirBinaryOp.CmpLtSigned, index, length);
    long bodyBlock = builder.newBlock("arrhash.body");
    long doneBlock = builder.newBlock("arrhash.done");
    builder.terminate(new EirBranch(more, bodyBlock, doneBlock));

    builder.moveTo(bodyBlock);
    long address = elementAddress(builder, elementType, array, index);
    long elementHash = elementHashAt(builder, plan, address, elementType);
    long hash = loadSlot(builder, longType, hashSlot);
    long scaled = boolTemp(builder, boolType, EirBinaryOp.Mul, hash, constInt(builder, longType, 31));
    storeConst(builder, hashSlot, boolTemp(builder, boolType, EirBinaryOp.Add, scaled, elementHash));
    storeConst(builder, indexSlot, boolTemp(builder, boolType, EirBinaryOp.Add, index,
        constInt(builder, longType, 1)));
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(doneBlock);
    builder.terminate(new EirReturn(loadSlot(builder, longType, hashSlot)));

    return builder.finish();
}

// string _arrtext$<module>$<T>(T[] array): 'null' for an absent array, otherwise the elements' text in
// brackets. The accumulator slot owns its reference throughout.
buildText(ArrayContentPlan plan, Type elementType, string symbol) -> EirFunction {
    let store = plan.store();
    let arrayType = store.arrayOf(elementType);
    let stringType = store.stringType();
    let longType = store.primitive(PrimitiveKind.Long);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let builder = new EirFunctionBuilder(symbol, true, null,
        [new EirParameter("array", arrayType)], stringType);
    long array = 0;

    long absentBlock = builder.newBlock("arrtext.absent");
    long presentBlock = builder.newBlock("arrtext.present");
    builder.terminate(new EirBranch(absentTest(builder, boolType, array, arrayType), absentBlock, presentBlock));

    builder.moveTo(absentBlock);
    builder.terminate(new EirReturn(ownedLiteral(builder, stringType, "null")));

    builder.moveTo(presentBlock);
    long length = arrayLength(builder, longType, array);
    long textSlot = builder.addSlot("text", stringType, true, false);
    storeConst(builder, textSlot, ownedLiteral(builder, stringType, "["));
    long indexSlot = builder.addSlot("index", longType, false, false);
    storeConst(builder, indexSlot, constInt(builder, longType, 0));
    long testBlock = builder.newBlock("arrtext.test");
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(testBlock);
    long index = loadSlot(builder, longType, indexSlot);
    long more = boolTemp(builder, boolType, EirBinaryOp.CmpLtSigned, index, length);
    long bodyBlock = builder.newBlock("arrtext.body");
    long doneBlock = builder.newBlock("arrtext.done");
    builder.terminate(new EirBranch(more, bodyBlock, doneBlock));

    builder.moveTo(bodyBlock);
    long separatorBlock = builder.newBlock("arrtext.sep");
    long elementBlock = builder.newBlock("arrtext.element");
    long isFirst = boolTemp(builder, boolType, EirBinaryOp.CmpEq, index, constInt(builder, longType, 0));
    builder.terminate(new EirBranch(isFirst, elementBlock, separatorBlock));

    builder.moveTo(separatorBlock);
    appendOwnedInto(builder, stringType, textSlot, literal(builder, stringType, ", "), false);
    builder.terminate(new EirJump(elementBlock));

    builder.moveTo(elementBlock);
    long address = elementAddress(builder, elementType, array, index);
    long elementText = elementTextAt(builder, plan, address, elementType);
    appendOwnedInto(builder, stringType, textSlot, elementText, true);
    storeConst(builder, indexSlot, boolTemp(builder, boolType, EirBinaryOp.Add, index,
        constInt(builder, longType, 1)));
    builder.terminate(new EirJump(testBlock));

    builder.moveTo(doneBlock);
    appendOwnedInto(builder, stringType, textSlot, literal(builder, stringType, "]"), false);
    builder.terminate(new EirReturn(takeSlot(builder, stringType, textSlot)));

    return builder.finish();
}

// '==' over the elements the two addresses name. Only a tagged optional and a struct need the
// address rather than the loaded value.
elementEqualAt(EirFunctionBuilder builder, ArrayContentPlan plan, long leftAddress,
              long rightAddress, Type type) -> long {
    let store = plan.store();
    let boolType = store.primitive(PrimitiveKind.Bool);
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        return taggedEqualAt(builder, plan, leftAddress, rightAddress, type, payload);
    }
    let structType = primitives.structOf(type);
    if (structType != null) {
        return structEqualAt(builder, plan, leftAddress, rightAddress, structType);
    }
    long left = loadAt(builder, leftAddress, type);
    long right = loadAt(builder, rightAddress, type);
    let arrayType = primitives.arrayOf(type);
    if (arrayType != null) {
        return callArrayEquals(builder, plan, left, right, arrayType.element());
    }
    let stringType = primitives.stringOf(type);
    if (stringType != null) {
        long result = builder.newTemp(boolType);
        builder.append(new EirStringEqual(result, boolType, reinterpretTo(builder, left,
            stringType), reinterpretTo(builder, right, stringType)));
        return result;
    }
    if (primitives.isClassLike(type)) {
        long result = builder.newTemp(boolType);
        builder.append(new EirDynamicEquals(result, boolType, left, right));
        return result;
    }
    let op = primitives.isFloatType(type) ? EirBinaryOp.FloatCmpEq : EirBinaryOp.CmpEq;
    return boolTemp(builder, boolType, op, left, right);
}

// '==' over the tagged pairs the two addresses name. The payload is read only once presence is
// proven, since a struct payload may hold a reference field over storage that was never written.
taggedEqualAt(EirFunctionBuilder builder, ArrayContentPlan plan, long leftAddress,
             long rightAddress, Type optionalType, Type payloadType) -> long {
    let store = plan.store();
    let boolType = store.primitive(PrimitiveKind.Bool);
    long leftPair = loadAt(builder, leftAddress, optionalType);
    long rightPair = loadAt(builder, rightAddress, optionalType);
    long leftPresent = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(leftPresent, boolType, leftPair));
    long rightPresent = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(rightPresent, boolType, rightPair));
    long samePresence = boolTemp(builder, boolType, EirBinaryOp.CmpEq, leftPresent, rightPresent);

    long answer = builder.addSlot("opteq", boolType, false, false);
    storeConst(builder, answer, samePresence);
    long bothPresent = boolTemp(builder, boolType, EirBinaryOp.And, samePresence, leftPresent);
    long payloadBlock = builder.newBlock("opteq.payload");
    long endBlock = builder.newBlock("opteq.end");
    builder.terminate(new EirBranch(bothPresent, payloadBlock, endBlock));

    builder.moveTo(payloadBlock);
    long payloadEqual = -1;
    if (primitives.structOf(payloadType) != null) {
        long leftPayloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(leftPayloadAddress, payloadType,
            leftAddress));
        long rightPayloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(rightPayloadAddress, payloadType,
            rightAddress));
        payloadEqual = elementEqualAt(builder, plan, leftPayloadAddress, rightPayloadAddress,
            payloadType);
    } else {
        long leftPayload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayload(leftPayload, payloadType, leftPair));
        long rightPayload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayload(rightPayload, payloadType, rightPair));
        payloadEqual = elementEqualAt(builder, plan, addressOfValue(builder, leftPayload,
            payloadType), addressOfValue(builder, rightPayload, payloadType), payloadType);
    }
    storeConst(builder, answer, payloadEqual);
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    return loadSlot(builder, boolType, answer);
}

// '==' over the structs the two addresses name, through the struct's own 'equals' when it
// declared one.
structEqualAt(EirFunctionBuilder builder, ArrayContentPlan plan, long leftAddress,
             long rightAddress, Type structType) -> long {
    let store = plan.store();
    let boolType = store.primitive(PrimitiveKind.Bool);
    let declared = declaredEqualsOf(structType);
    if (declared != null) {
        long other = loadAt(builder, rightAddress, structType);
        return callDeclared(builder, plan, declared, leftAddress, [other], boolType);
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return constBool(builder, boolType, true);
    }
    long answer = builder.addSlot("structeq", boolType, false, false);
    storeConst(builder, answer, constBool(builder, boolType, true));
    long differBlock = builder.newBlock("structeq.differ");
    long endBlock = builder.newBlock("structeq.end");
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        long leftField = builder.newTemp(field.type());
        builder.append(new EirFieldAddress(leftField, field.type(), leftAddress, i));
        long rightField = builder.newTemp(field.type());
        builder.append(new EirFieldAddress(rightField, field.type(), rightAddress, i));
        long fieldEqual = elementEqualAt(builder, plan, leftField, rightField, field.type());
        long next = builder.newBlock("structeq.next");
        builder.terminate(new EirBranch(fieldEqual, next, differBlock));
        builder.moveTo(next);
    }
    builder.terminate(new EirJump(endBlock));
    builder.moveTo(differBlock);
    storeConst(builder, answer, constBool(builder, boolType, false));
    builder.terminate(new EirJump(endBlock));
    builder.moveTo(endBlock);
    return loadSlot(builder, boolType, answer);
}

elementHashAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type type)
        -> long {
    let store = plan.store();
    let longType = store.primitive(PrimitiveKind.Long);
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        return taggedHashAt(builder, plan, address, type, payload);
    }
    let structType = primitives.structOf(type);
    if (structType != null) {
        return structHashAt(builder, plan, address, structType);
    }
    long value = loadAt(builder, address, type);
    let arrayType = primitives.arrayOf(type);
    if (arrayType != null) {
        return callArrayHash(builder, plan, value, arrayType.element());
    }
    let stringType = primitives.stringOf(type);
    if (stringType != null) {
        long result = builder.newTemp(longType);
        builder.append(new EirHashValue(result, longType, reinterpretTo(builder, value,
            stringType)));
        return result;
    }
    if (primitives.isClassLike(type)) {
        long result = builder.newTemp(longType);
        builder.append(new EirDynamicHash(result, longType, value));
        return result;
    }
    long result = builder.newTemp(longType);
    builder.append(new EirHashValue(result, longType, value));
    return result;
}

// -1 for an absent tagged pair, otherwise its payload's own hash.
taggedHashAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type optionalType,
            Type payloadType) -> long {
    let store = plan.store();
    let longType = store.primitive(PrimitiveKind.Long);
    let boolType = store.primitive(PrimitiveKind.Bool);
    long pair = loadAt(builder, address, optionalType);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, pair));
    long answer = builder.addSlot("opthash", longType, false, false);
    long presentBlock = builder.newBlock("opthash.present");
    long absentBlock = builder.newBlock("opthash.absent");
    long endBlock = builder.newBlock("opthash.end");
    builder.terminate(new EirBranch(present, presentBlock, absentBlock));

    builder.moveTo(presentBlock);
    long payloadHash = -1;
    if (primitives.structOf(payloadType) != null) {
        long payloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(payloadAddress, payloadType, address));
        payloadHash = elementHashAt(builder, plan, payloadAddress, payloadType);
    } else {
        long payload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayload(payload, payloadType, pair));
        payloadHash = elementHashAt(builder, plan, addressOfValue(builder, payload, payloadType),
            payloadType);
    }
    storeConst(builder, answer, payloadHash);
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(absentBlock);
    storeConst(builder, answer, constInt(builder, longType, -1));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    return loadSlot(builder, longType, answer);
}

// The FNV-1a fold of a struct's fields, or the struct's own 'hash' when it declared one. Matches
// hashAt for a struct reached any other way.
structHashAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type structType)
        -> long {
    let store = plan.store();
    let longType = store.primitive(PrimitiveKind.Long);
    let declared = declaredHashOf(structType);
    if (declared != null) {
        return callDeclared(builder, plan, declared, address, [], longType);
    }
    long hash = constInt(builder, longType, -3750763034362895579);
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return hash;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        long fieldAddress = builder.newTemp(field.type());
        builder.append(new EirFieldAddress(fieldAddress, field.type(), address, i));
        long fieldHash = elementHashAt(builder, plan, fieldAddress, field.type());
        long mixed = boolTemp(builder, longType, EirBinaryOp.Xor, hash, fieldHash);
        hash = boolTemp(builder, longType, EirBinaryOp.Mul, mixed, constInt(builder, longType,
            1099511628211));
    }
    return hash;
}

// The text of one element the given address names, as a string the caller owns.
elementTextAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type type)
        -> long {
    let store = plan.store();
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        return taggedTextAt(builder, plan, address, type, payload);
    }
    let structType = primitives.structOf(type);
    if (structType != null) {
        return structTextAt(builder, plan, address, structType);
    }
    long value = loadAt(builder, address, type);
    let arrayType = primitives.arrayOf(type);
    if (arrayType != null) {
        return callArrayText(builder, plan, value, arrayType.element());
    }
    let stringType = store.stringType();
    if (primitives.stringOf(type) != null) {
        long bare = reinterpretTo(builder, value, stringType);
        if (!(type is OptionalType)) {
            long result = builder.newTemp(stringType);
            builder.append(new EirJsonEscape(result, stringType, bare));
            return result;
        }
        // EirJsonEscape renders a null string as "" rather than 'null', so an absent string is
        // told apart first.
        let boolType = store.primitive(PrimitiveKind.Bool);
        long absent = absentTest(builder, boolType, bare, stringType);
        long answer = builder.addSlot("strtext", stringType, true, false);
        long presentBlock = builder.newBlock("strtext.present");
        long absentBlock = builder.newBlock("strtext.absent");
        long endBlock = builder.newBlock("strtext.end");
        builder.terminate(new EirBranch(absent, absentBlock, presentBlock));

        builder.moveTo(presentBlock);
        long escaped = builder.newTemp(stringType);
        builder.append(new EirJsonEscape(escaped, stringType, bare));
        storeConst(builder, answer, escaped);
        builder.terminate(new EirJump(endBlock));

        builder.moveTo(absentBlock);
        storeConst(builder, answer, ownedLiteral(builder, stringType, "null"));
        builder.terminate(new EirJump(endBlock));

        builder.moveTo(endBlock);
        return takeSlot(builder, stringType, answer);
    }
    if (primitives.isClassLike(type)) {
        long result = builder.newTemp(stringType);
        builder.append(new EirDynamicToString(result, stringType, value));
        return result;
    }
    if (primitives.isCharType(type) || type is EnumType) {
        long text = leafToString(builder, plan, value, type);
        long quoted = builder.newTemp(stringType);
        builder.append(new EirJsonEscape(quoted, stringType, text));
        builder.append(new EirRelease(text));
        return quoted;
    }
    return leafToString(builder, plan, value, type);
}

// 'null' for an absent tagged pair, otherwise its payload's own text.
taggedTextAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type optionalType,
            Type payloadType) -> long {
    let store = plan.store();
    let stringType = store.stringType();
    let boolType = store.primitive(PrimitiveKind.Bool);
    long pair = loadAt(builder, address, optionalType);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, pair));
    long answer = builder.addSlot("opttext", stringType, true, false);
    long presentBlock = builder.newBlock("opttext.present");
    long absentBlock = builder.newBlock("opttext.absent");
    long endBlock = builder.newBlock("opttext.end");
    builder.terminate(new EirBranch(present, presentBlock, absentBlock));

    builder.moveTo(presentBlock);
    long rendered = -1;
    if (primitives.structOf(payloadType) != null) {
        long payloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(payloadAddress, payloadType, address));
        rendered = structTextAt(builder, plan, payloadAddress, payloadType);
    } else {
        long payload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayload(payload, payloadType, pair));
        rendered = elementTextAt(builder, plan, addressOfValue(builder, payload, payloadType),
            payloadType);
    }
    storeConst(builder, answer, rendered);
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(absentBlock);
    storeConst(builder, answer, ownedLiteral(builder, stringType, "null"));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    return takeSlot(builder, stringType, answer);
}

// The JSON object of the struct the address names, in the shape json.renderAt builds. A nested
// struct never renders through a declared 'toString', and sema already refused any field type
// this cannot render.
structTextAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type structType)
        -> long {
    let store = plan.store();
    let stringType = store.stringType();
    long accumulator = literal(builder, stringType, "\{");
    builder.append(new EirRetain(accumulator));
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return accumulator;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        string separator = "";
        if (i > 0) {
            separator = ", ";
        }
        accumulator = concatOwned(builder, stringType, accumulator,
            literal(builder, stringType, separator + "\"" + field.name() + "\": "), false);
        long fieldAddress = builder.newTemp(field.type());
        builder.append(new EirFieldAddress(fieldAddress, field.type(), address, i));
        long rendered = jsonValueAt(builder, plan, fieldAddress, field.type());
        accumulator = concatOwned(builder, stringType, accumulator, rendered, true);
    }
    return concatOwned(builder, stringType, accumulator, literal(builder, stringType, "\}"),
        false);
}

jsonValueAt(EirFunctionBuilder builder, ArrayContentPlan plan, long address, Type type) -> long {
    let store = plan.store();
    let stringType = store.stringType();
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        return taggedTextAt(builder, plan, address, type, payload);
    }
    let arrayType = primitives.arrayOf(type);
    if (arrayType != null) {
        long value = loadAt(builder, address, type);
        return callArrayText(builder, plan, value, arrayType.element());
    }
    if (type is OptionalType && primitives.isStringType(type.inner())) {
        return elementTextAt(builder, plan, address, type.inner());
    }
    let structType = primitives.structOf(type);
    if (structType != null) {
        return structTextAt(builder, plan, address, structType);
    }
    return elementTextAt(builder, plan, address, type);
}

// A leaf value's text form, built without a LoweringContext.
leafToString(EirFunctionBuilder builder, ArrayContentPlan plan, long value, Type type) -> long {
    let store = plan.store();
    let stringType = store.stringType();
    if (primitives.isBoolType(type)) {
        long text = builder.newTemp(stringType);
        builder.append(new EirBoolToString(text, stringType, value));
        return text;
    }
    if (type is EnumType) {
        long text = builder.newTemp(stringType);
        builder.append(new EirEnumToString(text, stringType, value, type));
        return text;
    }
    if (primitives.isCharType(type)) {
        long text = builder.newTemp(stringType);
        builder.append(new EirCharToString(text, stringType, value));
        return text;
    }
    if (primitives.isFloatType(type)) {
        long text = builder.newTemp(stringType);
        builder.append(new EirDoubleToString(text, stringType, value,
            primitives.bitWidth(type) == 32));
        return text;
    }
    long widened = value;
    if (primitives.bitWidth(type) != 64) {
        let target = store.primitive(PrimitiveKind.Long);
        widened = builder.newTemp(target);
        let op = primitives.isSignedType(type) ? EirCastOp.SignExtend : EirCastOp.ZeroExtend;
        builder.append(new EirCast(widened, target, op, value));
    }
    long text = builder.newTemp(stringType);
    builder.append(new EirIntToString(text, stringType, widened, primitives.isSignedType(type)));
    return text;
}

// Calls a nested array element's helper, requested from the plan so each is built once per module.
callArrayEquals(EirFunctionBuilder builder, ArrayContentPlan plan, long left, long right,
                Type innerElementType) -> long {
    string symbol = plan.equalsSymbol(innerElementType);
    let store = plan.store();
    let innerArrayType = store.arrayOf(innerElementType);
    let boolType = store.primitive(PrimitiveKind.Bool);
    long leftBare = reinterpretArray(builder, left, innerArrayType);
    long rightBare = reinterpretArray(builder, right, innerArrayType);
    let callee = new EirCallee(symbol, null, [innerArrayType, innerArrayType], boolType);
    long result = builder.newTemp(boolType);
    builder.append(new EirCall(result, boolType, callee, -1, [leftBare, rightBare], -1, null));
    return result;
}

callArrayHash(EirFunctionBuilder builder, ArrayContentPlan plan, long value, Type innerElementType) -> long {
    string symbol = plan.hashSymbol(innerElementType);
    let store = plan.store();
    let innerArrayType = store.arrayOf(innerElementType);
    let longType = store.primitive(PrimitiveKind.Long);
    long bare = reinterpretArray(builder, value, innerArrayType);
    let callee = new EirCallee(symbol, null, [innerArrayType], longType);
    long result = builder.newTemp(longType);
    builder.append(new EirCall(result, longType, callee, -1, [bare], -1, null));
    return result;
}

callArrayText(EirFunctionBuilder builder, ArrayContentPlan plan, long value, Type innerElementType) -> long {
    string symbol = plan.textSymbol(innerElementType);
    let store = plan.store();
    let innerArrayType = store.arrayOf(innerElementType);
    let stringType = store.stringType();
    long bare = reinterpretArray(builder, value, innerArrayType);
    let callee = new EirCallee(symbol, null, [innerArrayType], stringType);
    long result = builder.newTemp(stringType);
    builder.append(new EirCall(result, stringType, callee, -1, [bare], -1, null));
    return result;
}

// Calls a struct's declared method by symbol. A struct has no runtime type beyond its own, so
// there is nothing to dispatch on.
callDeclared(EirFunctionBuilder builder, ArrayContentPlan plan, Method declared, long receiver,
            long[] arguments, Type returnType) -> long {
    let info = plan.index().infoFor(declared.signature());
    if (info == null) {
        return fallbackFor(builder, returnType);
    }
    let parameterTypes = new List<Type>();
    for (let parameter in declared.signature().parameters()) {
        parameterTypes.push(parameter.type());
    }
    let callee = new EirCallee(info.symbol(), declared.definingType(), parameterTypes.toArray(),
        returnType);
    long result = builder.newTemp(returnType);
    builder.append(new EirCall(result, returnType, callee, receiver, arguments, -1, null));
    return result;
}

fallbackFor(EirFunctionBuilder builder, Type returnType) -> long {
    if (primitives.isBoolType(returnType)) {
        return constBool(builder, returnType, false);
    }
    if (primitives.isStringType(returnType)) {
        return ownedLiteral(builder, returnType, "");
    }
    return constInt(builder, returnType, 0);
}

// A struct's declared 'equals', or null when memberwise folding stands in. Matches the rule in
// lower.equality.
declaredEqualsOf(Type structType) -> Method? {
    let methods = types.methodsOf(structType);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (method.isConstructor() || method.name() != "equals") {
            continue;
        }
        let signature = method.signature();
        if (signature.parameters().length != 1 || signature.declaresThrows()) {
            continue;
        }
        if (primitives.structOf(signature.parameters()[0].type()) != structType) {
            continue;
        }
        if (primitives.isBoolType(signature.returnType())) {
            return method;
        }
    }
    return null;
}

// A struct's declared 'hash', or null when the FNV fold stands in.
declaredHashOf(Type structType) -> Method? {
    let methods = types.methodsOf(structType);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (!method.isConstructor() && method.name() == "hash") {
            return method;
        }
    }
    return null;
}

loadAt(EirFunctionBuilder builder, long address, Type type) -> long {
    long value = builder.newTemp(type);
    builder.append(new EirLoadPtr(value, type, address));
    return value;
}

// Spills a value into a scratch slot so it can go through the address-taking helpers. Only ever
// asked for a leaf type.
addressOfValue(EirFunctionBuilder builder, long value, Type type) -> long {
    long slot = builder.addSlot("scratch", type, false, false);
    builder.append(new EirStoreSlot(slot, value));
    long address = builder.newTemp(type);
    builder.append(new EirSlotAddress(address, type, slot));
    return address;
}

absentTest(EirFunctionBuilder builder, Type booleanType, long value, Type type) -> long {
    long absent = builder.newTemp(type);
    builder.append(new EirConstNull(absent, type));
    return boolTemp(builder, booleanType, EirBinaryOp.CmpEq, value, absent);
}

arrayLength(EirFunctionBuilder builder, Type longType, long array) -> long {
    long length = builder.newTemp(longType);
    builder.append(new EirArrayLength(length, longType, array));
    return length;
}

elementAddress(EirFunctionBuilder builder, Type elementType, long array, long index) -> long {
    long address = builder.newTemp(elementType);
    builder.append(new EirElementAddress(address, elementType, array, index));
    return address;
}

boolTemp(EirFunctionBuilder builder, Type booleanType, EirBinaryOp op, long left, long right) -> long {
    Type resultType = builder.tempType(left);
    if (op == EirBinaryOp.CmpEq || op == EirBinaryOp.CmpNe || op == EirBinaryOp.CmpLtSigned
            || op == EirBinaryOp.FloatCmpEq || op == EirBinaryOp.Or || op == EirBinaryOp.And) {
        resultType = booleanType;
    }
    long result = builder.newTemp(resultType);
    builder.append(new EirBinary(result, resultType, op, left, right));
    return result;
}

constInt(EirFunctionBuilder builder, Type type, long value) -> long {
    long temp = builder.newTemp(type);
    builder.append(new EirConstInt(temp, type, value));
    return temp;
}

constBool(EirFunctionBuilder builder, Type type, bool value) -> long {
    long temp = builder.newTemp(type);
    builder.append(new EirConstBool(temp, type, value));
    return temp;
}

literal(EirFunctionBuilder builder, Type stringType, string text) -> long {
    long temp = builder.newTemp(stringType);
    builder.append(new EirConstString(temp, stringType, text.toBytes()));
    return temp;
}

// A literal with its own reference, safe to return from a function whose result is owned.
ownedLiteral(EirFunctionBuilder builder, Type stringType, string text) -> long {
    long temp = literal(builder, stringType, text);
    builder.append(new EirRetain(temp));
    return temp;
}

storeConst(EirFunctionBuilder builder, long slot, long value) {
    builder.append(new EirStoreSlot(slot, value));
}

loadSlot(EirFunctionBuilder builder, Type type, long slot) -> long {
    long temp = builder.newTemp(type);
    builder.append(new EirLoadSlot(temp, type, slot));
    return temp;
}

// Moves the +1 a merge slot owns into the result. A plain load only borrows, so the last read of
// a slot about to be handed on as owned takes it instead.
takeSlot(EirFunctionBuilder builder, Type type, long slot) -> long {
    long temp = builder.newTemp(type);
    builder.append(new EirTakeSlot(temp, type, slot));
    return temp;
}

// Concatenates a piece into a text slot, releasing the slot's old value and the piece when it
// owned one.
appendOwnedInto(EirFunctionBuilder builder, Type stringType, long slot, long piece, bool pieceOwned) {
    long current = loadSlot(builder, stringType, slot);
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, current, piece));
    if (pieceOwned) {
        builder.append(new EirRelease(piece));
    }
    // The slot owns the reference being replaced, not the borrowed value just read from it, so
    // the release goes through the slot's address.
    long slotAddress = builder.newTemp(stringType);
    builder.append(new EirSlotAddress(slotAddress, stringType, slot));
    builder.append(new EirReleasePtr(slotAddress));
    storeConst(builder, slot, joined);
}

// Joins two strings, giving up the left operand's reference and the right one's when it owned
// one. The result owns the only reference to the joined text.
concatOwned(EirFunctionBuilder builder, Type stringType, long left, long right, bool rightOwned)
        -> long {
    long joined = builder.newTemp(stringType);
    builder.append(new EirStringConcat(joined, stringType, left, right));
    builder.append(new EirRelease(left));
    if (rightOwned) {
        builder.append(new EirRelease(right));
    }
    return joined;
}
