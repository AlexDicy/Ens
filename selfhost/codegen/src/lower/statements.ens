// Statement lowering: local declarations, control flow, and the block structure branches and
// loops need. Every construct that can leave the current block unterminated terminates it before
// moving on, so a block always ends in exactly one terminator.
import Statement from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import VariableDeclarationNode from @ens.frontend.syntax.generated.nodes;
import IfStatementNode from @ens.frontend.syntax.generated.nodes;
import WhileStatementNode from @ens.frontend.syntax.generated.nodes;
import ForStatementNode from @ens.frontend.syntax.generated.nodes;
import ForEachStatementNode from @ens.frontend.syntax.generated.nodes;
import BreakStatementNode from @ens.frontend.syntax.generated.nodes;
import ContinueStatementNode from @ens.frontend.syntax.generated.nodes;
import ReturnStatementNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import ThrowStatementNode from @ens.frontend.syntax.generated.nodes;
import RethrowStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchStatementNode from @ens.frontend.syntax.generated.nodes;
import Type from @ens.sema.model.types;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirUnreachable from eir.model;
import Expression from @ens.frontend.syntax.generated.nodes;
import LoweringContext from lower.context;
import lower.arrays;
import lower.defaults;
import lower.exceptions;
import lower.expressions;
import lower.ownership;
import lower.stores;
import lower.switches;
import @ens.sema.model.flow;

// A block is a scope: the locals it declares own their contents, and reaching its end releases
// them. A path that leaves early through 'break', 'continue', or 'return' releases them itself.
public lowerBlock(LoweringContext lowering, BlockNode block) {
    lowering.pushScope();
    long depth = lowering.scopeDepth();
    for (long i = 0; i < block.statementsCount(); i++) {
        if (lowering.failed() || lowering.builder().terminated()) {
            lowering.popScope();
            return;
        }
        lower(lowering, block.statements(i));
    }
    if (!lowering.failed() && !lowering.builder().terminated()) {
        ownership.releaseScopesAbove(lowering, depth - 1);
    }
    lowering.popScope();
}

public lower(LoweringContext lowering, Statement statement) {
    switch (statement) {
        is BlockNode block -> {
            lowerBlock(lowering, block);
        },
        is VariableDeclarationNode declaration -> {
            lowerVariableDeclaration(lowering, declaration);
        },
        is IfStatementNode conditional -> {
            lowerIf(lowering, conditional);
        },
        is WhileStatementNode loop -> {
            lowerWhile(lowering, loop);
        },
        is ForStatementNode loop -> {
            lowerFor(lowering, loop);
        },
        is ForEachStatementNode loop -> {
            arrays.lowerForEach(lowering, loop);
        },
        is BreakStatementNode broken -> {
            if (!lowering.inLoop()) {
                lowering.internalError("'break' outside a loop", broken.span());
                return;
            }
            ownership.releaseScopesAbove(lowering, lowering.loopScopeDepth());
            lowering.builder().terminate(new EirJump(lowering.breakBlock()));
        },
        is ContinueStatementNode continued -> {
            if (!lowering.inLoop()) {
                lowering.internalError("'continue' outside a loop", continued.span());
                return;
            }
            ownership.releaseScopesAbove(lowering, lowering.loopScopeDepth());
            lowering.builder().terminate(new EirJump(lowering.continueBlock()));
        },
        is ReturnStatementNode returned -> {
            lowerReturn(lowering, returned);
        },
        is ExpressionStatementNode expression -> {
            lowerDiscarded(lowering, expression.expression());
        },
        is ThrowStatementNode thrown -> {
            exceptions.lowerThrow(lowering, thrown);
        },
        is RethrowStatementNode rethrown -> {
            exceptions.lowerRethrow(lowering, rethrown);
        },
        is SwitchStatementNode switched -> {
            switches.lowerStatement(lowering, switched);
        },
        default -> {
            lowering.internalError("this kind of statement has no lowering", statement.span());
        },
    }
}

lowerVariableDeclaration(LoweringContext lowering, VariableDeclarationNode declaration) {
    let binding = lowering.result().bindingOf(declaration.green());
    if (binding == null) {
        lowering.internalError("variable '{declaration.name().text()}' has no binding",
            declaration.name().span());
        return;
    }
    let declaredType = lowering.substituted(binding.type());
    if (!lowering.supportsValueType(declaredType)) {
        lowering.unsupported("a local variable of type {lowering.names().quoted(declaredType)}",
            declaration.name().span());
        return;
    }
    long slot = lowering.defineSlot(binding, binding.name(), declaredType);
    ownership.trackSlot(lowering, slot, declaredType);
    let initializer = declaration.initializer();
    if (initializer == null) {
        let ignored = defaults.applyToSlot(lowering, slot, declaredType,
            declaration.name().span());
        return;
    }
    let operand = stores.lowerOperand(lowering, initializer.value(), declaredType);
    if (operand == null) {
        return;
    }
    if (!stores.initializeSlot(lowering, slot, declaredType, operand)) {
        lowering.internalError("the initializer of '{binding.name()}' borrows a value with no "
            + "storage to retain", declaration.name().span());
    }
}

lowerIf(LoweringContext lowering, IfStatementNode conditional) {
    let builder = lowering.builder();
    long condition = expressions.lower(lowering, conditional.condition());
    if (condition < 0) {
        return;
    }
    long thenBlock = builder.newBlock("if.then");
    let elseClause = conditional.elseClause();
    long elseBlock = -1;
    if (elseClause != null) {
        elseBlock = builder.newBlock("if.else");
    }
    long merge = builder.newBlock("if.end");
    long elseTarget = merge;
    if (elseBlock >= 0) {
        elseTarget = elseBlock;
    }
    builder.terminate(new EirBranch(condition, thenBlock, elseTarget));
    builder.moveTo(thenBlock);
    lowerBlock(lowering, conditional.thenBranch());
    if (!lowering.failed() && !builder.terminated()) {
        builder.terminate(new EirJump(merge));
    }
    if (elseClause != null && !lowering.failed()) {
        builder.moveTo(elseBlock);
        switch (elseClause.body()) {
            is BlockNode block -> {
                lowerBlock(lowering, block);
            },
            is IfStatementNode chained -> {
                lowerIf(lowering, chained);
            },
            default -> {
                lowering.internalError("an 'else' is followed by neither a block nor an 'if'",
                    conditional.span());
            },
        }
        if (!lowering.failed() && !builder.terminated()) {
            builder.terminate(new EirJump(merge));
        }
    }
    if (!lowering.failed()) {
        builder.moveTo(merge);
    }
}

lowerWhile(LoweringContext lowering, WhileStatementNode loop) {
    let builder = lowering.builder();
    long conditionBlock = builder.newBlock("while.cond");
    builder.terminate(new EirJump(conditionBlock));
    builder.moveTo(conditionBlock);
    long condition = -1;
    if (!flow.loopConditionAlwaysHolds(loop.condition())) {
        condition = expressions.lower(lowering, loop.condition());
        if (condition < 0) {
            return;
        }
    }
    long body = builder.newBlock("while.body");
    long exit = builder.newBlock("while.end");
    enterBody(lowering, condition, body, exit);
    lowering.pushLoop(exit, conditionBlock);
    builder.moveTo(body);
    lowerBlock(lowering, loop.body());
    if (!lowering.failed() && !builder.terminated()) {
        builder.terminate(new EirJump(conditionBlock));
    }
    lowering.popLoop();
    if (!lowering.failed()) {
        builder.moveTo(exit);
    }
}

lowerFor(LoweringContext lowering, ForStatementNode loop) {
    let builder = lowering.builder();
    let initializer = loop.initializer();
    if (initializer != null) {
        switch (initializer) {
            is VariableDeclarationNode declaration -> {
                lowerVariableDeclaration(lowering, declaration);
            },
            is ExpressionStatementNode expression -> {
                lowerDiscarded(lowering, expression.expression());
            },
            default -> {
                lowering.unsupported("this loop initializer", loop.span());
            },
        }
    }
    if (lowering.failed() || builder.terminated()) {
        return;
    }
    long conditionBlock = builder.newBlock("for.cond");
    builder.terminate(new EirJump(conditionBlock));
    builder.moveTo(conditionBlock);
    let condition = loop.condition();
    long conditionValue = -1;
    if (condition != null && !flow.loopConditionAlwaysHolds(condition)) {
        conditionValue = expressions.lower(lowering, condition);
        if (conditionValue < 0) {
            return;
        }
    }
    long body = builder.newBlock("for.body");
    let update = loop.update();
    long updateBlock = -1;
    if (update != null) {
        updateBlock = builder.newBlock("for.update");
    }
    long exit = builder.newBlock("for.end");
    enterBody(lowering, conditionValue, body, exit);
    long continueTarget = conditionBlock;
    if (updateBlock >= 0) {
        continueTarget = updateBlock;
    }
    lowering.pushLoop(exit, continueTarget);
    builder.moveTo(body);
    lowerBlock(lowering, loop.body());
    if (!lowering.failed() && !builder.terminated()) {
        builder.terminate(new EirJump(continueTarget));
    }
    lowering.popLoop();
    if (update != null && !lowering.failed()) {
        builder.moveTo(updateBlock);
        lowerDiscarded(lowering, update);
        if (!lowering.failed() && !builder.terminated()) {
            builder.terminate(new EirJump(conditionBlock));
        }
    }
    if (!lowering.failed()) {
        builder.moveTo(exit);
    }
}

// Ends a loop's condition block with a branch on the condition's value, or with a jump into the
// body when the condition is -1 because it always holds, which leaves 'break' the only way out.
enterBody(LoweringContext lowering, long condition, long body, long exit) {
    if (condition < 0) {
        lowering.builder().terminate(new EirJump(body));
    } else {
        lowering.builder().terminate(new EirBranch(condition, body, exit));
    }
}

// A return hands its value's +1 to the caller, so a borrowed value is retained before the
// function's own scopes are released; otherwise releasing a local could free what is on its way
// out.
lowerReturn(LoweringContext lowering, ReturnStatementNode returned) {
    let value = returned.value();
    if (value == null) {
        ownership.releaseAllScopes(lowering);
        lowering.builder().terminate(new EirReturn(-1));
        return;
    }
    let returnType = lowering.substituted(lowering.info().signature().returnType());
    let ignored = returnValue(lowering, value, returnType);
}

// Hands one expression's value to the caller as the function's result. The one home for the
// transfer, shared by a written 'return' and by the expression body of a lambda.
public returnValue(LoweringContext lowering, Expression value, Type returnType) -> bool {
    long returned = stores.lowerOwned(lowering, value, returnType);
    if (returned < 0) {
        return false;
    }
    ownership.releaseAllScopes(lowering);
    lowering.builder().terminate(new EirReturn(returned));
    return true;
}

// Lowers an expression whose value nothing reads and releases what that value owns right away.
// The path ends after it when sema recorded it as a call that never returns.
public lowerDiscarded(LoweringContext lowering, Expression expression) {
    long value = expressions.lower(lowering, expression);
    if (lowering.failed() || lowering.builder().terminated()) {
        return;
    }
    if (value >= 0) {
        expressions.releaseTemporary(lowering, expression, value);
    }
    if (lowering.result().neverReturns(expression.green())) {
        lowering.builder().terminate(new EirUnreachable());
    }
}
