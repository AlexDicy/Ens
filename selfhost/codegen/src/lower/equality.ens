// Comparing two references. Identity decides it by default, and a value whose runtime type
// declares 'equals' asks for content instead, through the runtime helper unless the static type
// admits exactly one runtime type. An operand's own reference is given up once the answer is in.
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import Method from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirBranch from eir.model;
import EirConstBool from eir.model;
import EirConstNull from eir.model;
import EirDynamicEquals from eir.model;
import EirJump from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPresence from eir.model;
import EirStoreSlot from eir.model;
import EirStringEqual from eir.model;
import EirUnary from eir.model;
import EirUnaryOp from eir.model;
import LoweringContext from lower.context;
import layout.behaviors;
import lower.arraycontent;
import lower.calls;
import lower.conversions;
import lower.expressions;
import lower.optionals;
import lower.places;
import lower.records;
import lower.structs;
import support.primitives;

// True when '==' over these two operand types compares references rather than values. Two foreign
// handles compare by identity like references, at either nullable spelling.
public comparesReferences(Type left, Type right) -> bool {
    if (!primitives.sameReferent(left, right)) {
        return false;
    }
    if (isPresenceCheck(left, right) || primitives.externalOf(left) != null) {
        return true;
    }
    let referent = primitives.referenceOf(left);
    return referent != null && !primitives.isStringType(referent);
}

// True when one side is the null literal, which makes the comparison ask whether the other side is
// there at all rather than what it holds.
public isPresenceCheck(Type left, Type right) -> bool {
    return primitives.isNullType(left) || primitives.isNullType(right);
}

public lower(LoweringContext lowering, BinaryExpressionNode binary, bool negated, Type resultType)
        -> long {
    let leftType = lowering.typeOf(binary.left());
    let rightType = lowering.typeOf(binary.right());
    if (leftType == null || rightType == null) {
        return -1;
    }
    let common = comparisonType(leftType, rightType);
    if (!lowering.supportsValueType(common)) {
        lowering.unsupported("comparing '{types.display(leftType)}' with "
            + "'{types.display(rightType)}'", binary.span());
        return -1;
    }
    long left = expressions.lowerConverted(lowering, binary.left(), common);
    if (left < 0) {
        return -1;
    }
    bool leftOwned = places.producesOwnedValue(lowering, binary.left());
    if (leftOwned && primitives.isReferenceType(common)) {
        lowering.protectValue(left);
    }
    long right = expressions.lowerConverted(lowering, binary.right(), common);
    if (leftOwned && primitives.isReferenceType(common)) {
        lowering.unprotectValue(left);
    }
    if (right < 0) {
        return -1;
    }
    long answer = -1;
    if (isPresenceCheck(leftType, rightType)) {
        answer = compareIdentity(lowering, left, right, negated, resultType);
    } else {
        answer = compareReferences(lowering, left, right, common, negated, resultType,
            binary.span());
    }
    // A reference an operand produced was only compared, so it ends here; a weak read's upgraded
    // reference in particular must not outlive the comparison, or it would keep the watched
    // object alive past the answer.
    expressions.releaseTemporary(lowering, binary.left(), left);
    expressions.releaseTemporary(lowering, binary.right(), right);
    return answer;
}

// The type both operands compare at. A null literal takes the other side's type, and where the two
// spellings differ the optional one wins, because it is the one that can hold either value.
comparisonType(Type left, Type right) -> Type {
    if (primitives.isNullType(left)) {
        return right;
    }
    if (primitives.isNullType(right) || left == right || primitives.isOptionalType(left)) {
        return left;
    }
    return right;
}

// '==' over two references of one static type. When only one runtime type is possible, both
// operands carry the same descriptor by construction; otherwise the runtime types must match for
// a declared 'equals' to run at all.
compareReferences(LoweringContext lowering, long left, long right, Type type, bool negated,
                  Type resultType, Span span) -> long {
    if (primitives.arrayOf(type) != null) {
        return arraycontent.lowerEqual(lowering, left, right, type, negated, resultType, span);
    }
    if (!behaviors.subtreeDeclares(lowering.index(), type, "equals")) {
        return compareIdentity(lowering, left, right, negated, resultType);
    }
    if (!behaviors.isOnlyRuntimeType(type)) {
        return compareRuntimeTypes(lowering, left, right, negated, resultType);
    }
    let declared = behaviors.declaredBehavior(type, "equals");
    if (declared == null) {
        return compareIdentity(lowering, left, right, negated, resultType);
    }
    return compareContents(lowering, left, right, declared, negated, resultType, span);
}

compareRuntimeTypes(LoweringContext lowering, long left, long right, bool negated, Type resultType) -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long equal = builder.newTemp(boolType);
    builder.append(new EirDynamicEquals(equal, boolType, left, right));
    if (!negated) {
        return equal;
    }
    return negate(lowering, equal, resultType);
}

compareIdentity(LoweringContext lowering, long left, long right, bool negated, Type resultType)
        -> long {
    let builder = lowering.builder();
    long temp = builder.newTemp(resultType);
    let op = negated ? EirBinaryOp.CmpNe : EirBinaryOp.CmpEq;
    builder.append(new EirBinary(temp, resultType, op, left, right));
    return temp;
}

compareContents(LoweringContext lowering, long left, long right, Method declared, bool negated,
                Type resultType, Span span) -> long {
    let info = lowering.index().infoFor(declared.signature());
    if (info == null) {
        lowering.internalError("the 'equals' of this class resolves to no indexed function",
            span);
        return -1;
    }
    if (!calls.supportedCallee(lowering, info, "method 'equals'", span)) {
        return -1;
    }
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long answer = builder.addSlot("equal", boolType, false, false);
    long identical = compareIdentity(lowering, left, right, false, boolType);
    long sameBlock = builder.newBlock("equals.same");
    long testBlock = builder.newBlock("equals.test");
    long absentBlock = builder.newBlock("equals.absent");
    long callBlock = builder.newBlock("equals.call");
    long endBlock = builder.newBlock("equals.end");
    builder.terminate(new EirBranch(identical, sameBlock, testBlock));

    builder.moveTo(sameBlock);
    storeConstant(lowering, answer, boolType, true);
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(testBlock);
    long absent = eitherAbsent(lowering, left, right, boolType);
    builder.terminate(new EirBranch(absent, absentBlock, callBlock));

    builder.moveTo(absentBlock);
    storeConstant(lowering, answer, boolType, false);
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(callBlock);
    let parameterType = declared.signature().parameters()[0].type();
    long argument = conversions.convert(lowering, right, parameterType, span);
    if (argument < 0) {
        return -1;
    }
    long produced = calls.emitCall(lowering, info, primitives.classOf(parameterType), left,
        [argument], lowering.tables().vtableSlotOf(declared.signature()), null, span);
    builder.append(new EirStoreSlot(answer, produced));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    long merged = builder.newTemp(boolType);
    builder.append(new EirLoadSlot(merged, boolType, answer));
    if (!negated) {
        return merged;
    }
    return negate(lowering, merged, resultType);
}

eitherAbsent(LoweringContext lowering, long left, long right, Type boolType) -> long {
    let builder = lowering.builder();
    long leftAbsent = absentTest(lowering, left, boolType);
    long rightAbsent = absentTest(lowering, right, boolType);
    long either = builder.newTemp(boolType);
    builder.append(new EirBinary(either, boolType, EirBinaryOp.Or, leftAbsent, rightAbsent));
    return either;
}

absentTest(LoweringContext lowering, long value, Type boolType) -> long {
    let builder = lowering.builder();
    let valueType = builder.tempType(value);
    long absent = builder.newTemp(valueType);
    builder.append(new EirConstNull(absent, valueType));
    long test = builder.newTemp(boolType);
    builder.append(new EirBinary(test, boolType, EirBinaryOp.CmpEq, value, absent));
    return test;
}

storeConstant(LoweringContext lowering, long slot, Type boolType, bool value) {
    let builder = lowering.builder();
    long constant = builder.newTemp(boolType);
    builder.append(new EirConstBool(constant, boolType, value));
    builder.append(new EirStoreSlot(slot, constant));
}

// The '!=' spelling of an equality bit already computed.
negate(LoweringContext lowering, long equal, Type resultType) -> long {
    let builder = lowering.builder();
    long inverted = builder.newTemp(resultType);
    builder.append(new EirUnary(inverted, resultType, EirUnaryOp.Not, equal));
    return inverted;
}

// True when '==' over these two operand types compares struct values.
public comparesStructValues(Type left, Type right) -> bool {
    return left == right && primitives.structOf(left) != null;
}

// The 'equals' a struct declares for itself: one parameter of the struct's own type, answering
// bool. A struct has no base type, so only its own methods are consulted, and a declaration of
// any other shape is an ordinary method that '==' does not consult.
public declaredStructEquals(Type type) -> Method? {
    let structType = primitives.structOf(type);
    if (structType == null) {
        return null;
    }
    let methods = types.methodsOf(structType);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (method.isConstructor() || method.name() != "equals") {
            continue;
        }
        let signature = method.signature();
        if (signature.parameters().length != 1 || signature.declaresThrows()) {
            continue;
        }
        if (primitives.structOf(signature.parameters()[0].type()) != structType) {
            continue;
        }
        if (primitives.isBoolType(signature.returnType())) {
            return method;
        }
    }
    return null;
}

// '==' over two same-type struct values: the struct's own 'equals' when it declares one, and
// otherwise memberwise, fields comparing in declaration order by their own '==' semantics and
// short-circuiting to unequal at the first difference. Both operands are reached through their
// addresses, so a declaration runs in place and nested structs compare where they sit.
public lowerStructValues(LoweringContext lowering, BinaryExpressionNode binary, bool negated,
                         Type resultType) -> long {
    let type = lowering.typeOf(binary.left());
    if (type == null) {
        return -1;
    }
    long leftBase = structs.addressOf(lowering, binary.left(), type);
    if (leftBase < 0) {
        return -1;
    }
    long rightBase = structs.addressOf(lowering, binary.right(), type);
    if (rightBase < 0) {
        return -1;
    }
    long equal = structsEqualAt(lowering, leftBase, rightBase, type, binary.span());
    if (equal < 0 || !negated) {
        return equal;
    }
    return negate(lowering, equal, resultType);
}

// '==' over the structs two addresses name: the struct's own 'equals' when it declares one,
// otherwise the memberwise walk merged through a slot.
structsEqualAt(LoweringContext lowering, long leftBase, long rightBase, Type type, Span span)
        -> long {
    let declared = declaredStructEquals(type);
    if (declared != null) {
        return structs.lowerDeclaredEquals(lowering, type, declared, leftBase, rightBase, span);
    }
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long answer = builder.addSlot("structeq", boolType, false, false);
    long differBlock = builder.newBlock("struct.eq.differ");
    long endBlock = builder.newBlock("struct.eq.end");
    if (!compareFieldsAt(lowering, leftBase, rightBase, type, differBlock, span)) {
        return -1;
    }
    storeConstant(lowering, answer, boolType, true);
    builder.terminate(new EirJump(endBlock));
    builder.moveTo(differBlock);
    storeConstant(lowering, answer, boolType, false);
    builder.terminate(new EirJump(endBlock));
    builder.moveTo(endBlock);
    long merged = builder.newTemp(boolType);
    builder.append(new EirLoadSlot(merged, boolType, answer));
    return merged;
}

// Compares every field of the structs two addresses name, continuing on the equal path and
// jumping to 'differBlock' at the first difference. A nested struct that folds memberwise
// recurses into the same exit; one that declared 'equals' answers with a single bit.
compareFieldsAt(LoweringContext lowering, long leftBase, long rightBase, Type type,
                long differBlock, Span span) -> bool {
    let fields = records.fieldsOf(type);
    if (fields == null) {
        return true;
    }
    let builder = lowering.builder();
    for (long i = 0; i < fields.length(); i++) {
        let fieldType = fields.get(i).type();
        long leftAddress = structs.fieldAddressAt(lowering, leftBase, fieldType, i);
        long rightAddress = structs.fieldAddressAt(lowering, rightBase, fieldType, i);
        if (primitives.structOf(fieldType) != null && declaredStructEquals(fieldType) == null) {
            if (!compareFieldsAt(lowering, leftAddress, rightAddress, fieldType, differBlock,
                    span)) {
                return false;
            }
            continue;
        }
        long equal = fieldEqual(lowering, leftAddress, rightAddress, fieldType, span);
        if (equal < 0) {
            return false;
        }
        long next = builder.newBlock("struct.eq.next");
        builder.terminate(new EirBranch(equal, next, differBlock));
        builder.moveTo(next);
    }
    return true;
}

// One field's own '=='. A nullable reference field compares as its non-optional spelling does,
// since the content comparisons already answer for an absent reference.
fieldEqual(LoweringContext lowering, long leftAddress, long rightAddress, Type fieldType, Span span) -> long {
    let declaredStruct = declaredStructEquals(fieldType);
    if (declaredStruct != null) {
        return structs.lowerDeclaredEquals(lowering, fieldType, declaredStruct, leftAddress,
            rightAddress, span);
    }
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long left = places.loadFrom(lowering, leftAddress, fieldType);
    long right = places.loadFrom(lowering, rightAddress, fieldType);
    if (primitives.taggedPayloadOf(fieldType) != null) {
        return taggedPairEqual(lowering, left, right, fieldType, span);
    }
    if (primitives.stringOf(fieldType) != null) {
        long equal = builder.newTemp(boolType);
        builder.append(new EirStringEqual(equal, boolType, left, right));
        return equal;
    }
    if (primitives.arrayOf(fieldType) != null) {
        return arraycontent.lowerEqual(lowering, left, right, fieldType, false, boolType, span);
    }
    if (primitives.isClassLike(fieldType)) {
        return compareReferences(lowering, left, right, fieldType, false, boolType, span);
    }
    if (primitives.isReferenceType(fieldType)) {
        return compareIdentity(lowering, left, right, false, boolType);
    }
    let op = primitives.isFloatType(fieldType) ? EirBinaryOp.FloatCmpEq : EirBinaryOp.CmpEq;
    long equal = builder.newTemp(boolType);
    builder.append(new EirBinary(equal, boolType, op, left, right));
    return equal;
}

// True when '==' over these two operand types involves a tagged optional, which the identity
// and value comparisons cannot see through.
public comparesTaggedOptionals(Type left, Type right) -> bool {
    return primitives.taggedPayloadOf(left) != null
        || primitives.taggedPayloadOf(right) != null;
}

// '==' with a tagged optional on either side: against null it is the inverted tag, and otherwise
// both sides answer at the deeper of the two spellings, the shallower one wrapping into it. That
// is what makes a comparison across levels ask about every level instead of only the innermost:
// a present 'int??' never equals an absent one, whatever their payloads hold.
public lowerTagged(LoweringContext lowering, BinaryExpressionNode binary, bool negated,
                   Type resultType) -> long {
    let leftType = lowering.typeOf(binary.left());
    let rightType = lowering.typeOf(binary.right());
    if (leftType == null || rightType == null) {
        return -1;
    }
    long left = expressions.lowerConverted(lowering, binary.left(), leftType);
    if (left < 0) {
        return -1;
    }
    long right = expressions.lowerConverted(lowering, binary.right(), rightType);
    if (right < 0) {
        return -1;
    }
    long equal = -1;
    if (primitives.isNullType(rightType)) {
        equal = presenceBit(lowering, left, false);
    } else if (primitives.isNullType(leftType)) {
        equal = presenceBit(lowering, right, false);
    } else {
        Type common = leftType;
        if (primitives.optionalDepth(rightType) > primitives.optionalDepth(leftType)) {
            common = rightType;
        }
        long leftValue = conversions.convert(lowering, left, common, binary.span());
        long rightValue = conversions.convert(lowering, right, common, binary.span());
        if (leftValue >= 0 && rightValue >= 0) {
            equal = taggedPairEqualValues(lowering, leftValue, rightValue, common,
                binary.span());
        }
    }
    if (equal < 0) {
        if (!lowering.failed()) {
            lowering.unsupported("comparing '{types.display(leftType)}' with "
                + "'{types.display(rightType)}'", binary.span());
        }
        return -1;
    }
    if (!negated) {
        return equal;
    }
    return negate(lowering, equal, resultType);
}

// The presence tag, or its inverse for a null comparison.
presenceBit(LoweringContext lowering, long value, bool wantPresent) -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long present = builder.newTemp(boolType);
    builder.append(new EirOptionalPresence(present, boolType, value));
    if (wantPresent) {
        return present;
    }
    long absent = builder.newTemp(boolType);
    builder.append(new EirUnary(absent, boolType, EirUnaryOp.Not, present));
    return absent;
}

// Two loaded pairs of one tagged type: equal when both are absent, or both present with equal
// payloads.
taggedPairEqualValues(LoweringContext lowering, long left, long right, Type optionalType, Span span) -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    let payloadType = primitives.taggedPayloadOf(optionalType);
    if (payloadType == null) {
        return -1;
    }
    long leftPresent = presenceBit(lowering, left, true);
    long rightPresent = presenceBit(lowering, right, true);
    if (primitives.structOf(payloadType) != null) {
        return guardedStructPayloads(lowering, left, right, leftPresent, rightPresent,
            payloadType, span);
    }
    long leftPayload = builder.newTemp(payloadType);
    builder.append(new EirOptionalPayload(leftPayload, payloadType, left));
    long rightPayload = builder.newTemp(payloadType);
    builder.append(new EirOptionalPayload(rightPayload, payloadType, right));
    long payloadEqual = payloadEquality(lowering, leftPayload, rightPayload, payloadType, span);
    if (payloadEqual < 0) {
        return -1;
    }
    long samePresence = builder.newTemp(boolType);
    builder.append(new EirBinary(samePresence, boolType, EirBinaryOp.CmpEq, leftPresent,
        rightPresent));
    long leftAbsent = builder.newTemp(boolType);
    builder.append(new EirUnary(leftAbsent, boolType, EirUnaryOp.Not, leftPresent));
    long absentOrEqual = builder.newTemp(boolType);
    builder.append(new EirBinary(absentOrEqual, boolType, EirBinaryOp.Or, leftAbsent,
        payloadEqual));
    long equal = builder.newTemp(boolType);
    builder.append(new EirBinary(equal, boolType, EirBinaryOp.And, samePresence,
        absentOrEqual));
    return equal;
}

// The same comparison over the storage two addresses name, for a struct's optional field.
taggedPairEqual(LoweringContext lowering, long left, long right, Type optionalType, Span span)
        -> long {
    return taggedPairEqualValues(lowering, left, right, optionalType, span);
}

// '==' over two optionals holding a struct, presence first: differing presence settles it, two
// absent values are equal without either payload being read, and only two present payloads
// compare. The branch is what keeps a struct payload out of the comparison, which matters because
// comparing one reads its reference fields and may run a declared 'equals' over storage holding
// nothing. The two paths merge through a slot, the phi-free form every branching value uses.
guardedStructPayloads(LoweringContext lowering, long left, long right, long leftPresent,
                      long rightPresent, Type payloadType, Span span) -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    long samePresence = builder.newTemp(boolType);
    builder.append(new EirBinary(samePresence, boolType, EirBinaryOp.CmpEq, leftPresent,
        rightPresent));
    long bothPresent = builder.newTemp(boolType);
    builder.append(new EirBinary(bothPresent, boolType, EirBinaryOp.And, samePresence,
        leftPresent));
    long answer = builder.addSlot("optstructeq", boolType, false, false);
    builder.append(new EirStoreSlot(answer, samePresence));
    long payloadBlock = builder.newBlock("optstructeq.payload");
    long endBlock = builder.newBlock("optstructeq.end");
    builder.terminate(new EirBranch(bothPresent, payloadBlock, endBlock));

    builder.moveTo(payloadBlock);
    long leftBase = optionals.taggedScratchAddress(lowering, left, payloadType);
    long rightBase = optionals.taggedScratchAddress(lowering, right, payloadType);
    if (leftBase < 0 || rightBase < 0) {
        lowering.internalError("a compared payload borrows a value with no storage to retain",
            span);
        return -1;
    }
    long payloadEqual = structsEqualAt(lowering, leftBase, rightBase, payloadType, span);
    if (payloadEqual < 0) {
        return -1;
    }
    builder.append(new EirStoreSlot(answer, payloadEqual));
    builder.terminate(new EirJump(endBlock));

    builder.moveTo(endBlock);
    long merged = builder.newTemp(boolType);
    builder.append(new EirLoadSlot(merged, boolType, answer));
    return merged;
}

// Payload '==': each payload shape by its own equality, over a value of exactly that shape. A
// payload that is itself optional recurses first: a nested pair through the pair comparison, and
// a nullable reference by stripping to its referent, which it already is at the machine level.
// That strip is what keeps the leaves below exact - a nullable string shares the string's shape
// but is not one, and the string comparison takes a string.
payloadEquality(LoweringContext lowering, long left, long right, Type payloadType, Span span)
        -> long {
    let builder = lowering.builder();
    let boolType = lowering.store().primitive(PrimitiveKind.Bool);
    if (primitives.taggedPayloadOf(payloadType) != null) {
        return taggedPairEqualValues(lowering, left, right, payloadType, span);
    }
    if (payloadType is OptionalType) {
        let referent = primitives.referenceOf(payloadType);
        if (referent == null) {
            lowering.unsupported("comparing optionals whose payload is "
                + "'{types.display(payloadType)}'", span);
            return -1;
        }
        long leftReferent = conversions.convert(lowering, left, referent, span);
        long rightReferent = conversions.convert(lowering, right, referent, span);
        if (leftReferent < 0 || rightReferent < 0) {
            return -1;
        }
        return payloadEquality(lowering, leftReferent, rightReferent, referent, span);
    }
    if (primitives.isStringType(payloadType)) {
        long equal = builder.newTemp(boolType);
        builder.append(new EirStringEqual(equal, boolType, left, right));
        return equal;
    }
    if (primitives.arrayOf(payloadType) != null) {
        return arraycontent.lowerEqual(lowering, left, right, payloadType, false, boolType, span);
    }
    if (primitives.isClassLike(payloadType)) {
        return compareReferences(lowering, left, right, payloadType, false, boolType, span);
    }
    if (primitives.isReferenceType(payloadType)) {
        return compareIdentity(lowering, left, right, false, boolType);
    }
    if (!primitives.isNumericType(payloadType) && !primitives.isBoolType(payloadType)
            && !primitives.isEnumType(payloadType)) {
        lowering.unsupported("comparing optionals whose payload is "
            + "'{types.display(payloadType)}'", span);
        return -1;
    }
    let op = primitives.isFloatType(payloadType) ? EirBinaryOp.FloatCmpEq : EirBinaryOp.CmpEq;
    long equal = builder.newTemp(boolType);
    builder.append(new EirBinary(equal, boolType, op, left, right));
    return equal;
}
