// Reading a member: an enum member's constant, the length a string or an array carries in its
// payload header, a struct field, and the bare receiver a method reads through 'this'. A field is
// storage, so it is read through its address; the rest are values sema recognized structurally.
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import EnumType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import EirConstInt from eir.model;
import EirStringLength from eir.model;
import EirArrayLength from eir.model;
import LoweringContext from lower.context;
import lower.expressions;
import lower.places;
import lower.structs;
import support.primitives;

public lower(LoweringContext lowering, MemberExpressionNode member) -> long {
    let type = lowering.typeOf(member);
    if (type == null) {
        return -1;
    }
    let constant = lowering.result().enumConstantOf(member.green());
    if (constant != null) {
        return lowerEnumConstant(lowering, member, type, constant);
    }
    string name = member.member().text();
    let objectType = lowering.typeOf(member.object());
    if (objectType == null) {
        return -1;
    }
    let builder = lowering.builder();
    if (name == "length" && primitives.isStringType(objectType)) {
        long value = expressions.lower(lowering, member.object());
        if (value < 0) {
            return -1;
        }
        long temp = builder.newTemp(type);
        builder.append(new EirStringLength(temp, type, value));
        expressions.releaseTemporary(lowering, member.object(), value);
        return temp;
    }
    if (name == "length" && primitives.isArrayType(objectType)) {
        long value = expressions.lower(lowering, member.object());
        if (value < 0) {
            return -1;
        }
        long temp = builder.newTemp(type);
        builder.append(new EirArrayLength(temp, type, value));
        expressions.releaseTemporary(lowering, member.object(), value);
        return temp;
    }
    if (objectType is StructType && structs.fieldIndexOf(objectType, name) >= 0) {
        long address = places.lowerAddress(lowering, member);
        if (address < 0) {
            if (!lowering.failed()) {
                lowering.unsupported("reading the field '{name}' of this expression",
                    member.span());
            }
            return -1;
        }
        return places.loadFrom(lowering, address, type);
    }
    lowering.unsupported("reading the member '{name}'", member.span());
    return -1;
}

lowerEnumConstant(LoweringContext lowering, MemberExpressionNode member, Type type, long constant)
        -> long {
    if (!(type is EnumType)) {
        lowering.internalError("an enum member access has type '{types.display(type)}'",
            member.span());
        return -1;
    }
    long[] values = type.memberValues();
    if (constant < 0 || constant >= values.length) {
        lowering.internalError("enum member {constant} is outside '{types.display(type)}'",
            member.span());
        return -1;
    }
    let builder = lowering.builder();
    long temp = builder.newTemp(type);
    builder.append(new EirConstInt(temp, type, values[constant]));
    return temp;
}

// A bare 'this' inside a method: the aggregate the receiver's address names.
public lowerReceiver(LoweringContext lowering, ThisExpressionNode receiver) -> long {
    let type = lowering.info().receiverType();
    if (type == null) {
        lowering.internalError("'this' outside a method", receiver.span());
        return -1;
    }
    return places.loadFrom(lowering, structs.receiverAddress(lowering), type);
}
