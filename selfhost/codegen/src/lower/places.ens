// Reading and addressing the places a program names, an expression denoting storage rather than a
// value. It also supplies the ownership fact the store barriers require: whether an expression
// returns a reference it already owns, or one borrowed from storage that must be retained.
import Expression from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeSubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import NewExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArrayLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import InterpolatedStringExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CheckedCastExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import PostfixExpressionNode from @ens.frontend.syntax.generated.nodes;
import CastExpressionNode from @ens.frontend.syntax.generated.nodes;
import NullCoalesceExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import Type from @ens.sema.model.types;
import EirAccess from eir.model;
import EirLoadPtr from eir.model;
import EirOptionalPayloadAddress from eir.model;
import LoweringContext from lower.context;
import lower.arrays;
import lower.classes;
import lower.conversions;
import lower.defaults;
import lower.expressions;
import lower.ownership;
import lower.structs;
import support.primitives;
import @ens.sema.support.syntax;

// True when the expression returns a reference it owns, so a binding may take it without
// retaining. Everything read out of storage is borrowed, unless a later part of its expression may
// replace it while it is in use; everything freshly built is owned. A value that never returns is
// read out of the slot that stands in for it.
public producesOwnedValue(LoweringContext lowering, Expression node) -> bool {
    if (lowering.ownsRead(node)) {
        return true;
    }
    if (lowering.result().isNeverReturningValue(node.green())) {
        return false;
    }
    switch (node) {
        is ParenthesizedExpressionNode parenthesized -> {
            return producesOwnedValue(lowering, parenthesized.inner());
        },
        is TryExpressionNode tried -> {
            return producesOwnedValue(lowering, tried.operand());
        },
        // A conversion passes the value on as it is, so it owns what its operand owns.
        is CastExpressionNode cast -> {
            return producesOwnedValue(lowering, cast.value());
        },
        // A call's result is owned by its caller, and a safe access, '??', '?:' or switch moves
        // its merged value out of the slot its paths meet in.
        is CallExpressionNode ignored -> {
            return true;
        },
        is SafeMemberExpressionNode ignored -> {
            return true;
        },
        is SafeSubscriptExpressionNode ignored -> {
            return true;
        },
        is NullCoalesceExpressionNode ignored -> {
            return true;
        },
        is TernaryExpressionNode ignored -> {
            return true;
        },
        is SwitchExpressionNode ignored -> {
            return true;
        },
        is NewExpressionNode ignored -> {
            return true;
        },
        is LambdaExpressionNode ignored -> {
            return true;
        },
        is ArrayLiteralExpressionNode ignored -> {
            return true;
        },
        is StructLiteralExpressionNode ignored -> {
            return true;
        },
        is InterpolatedStringExpressionNode ignored -> {
            return true;
        },
        is BinaryExpressionNode binary -> {
            if (binary.operator().kind() != SyntaxKind.Plus) {
                return false;
            }
            let type = lowering.result().typeOf(binary.green());
            if (type == null) {
                return false;
            }
            return primitives.isStringType(type);
        },
        // Reading a weak field upgrades to a strong reference the reader owns, unlike every other
        // read out of storage.
        is MemberExpressionNode member -> {
            return classes.readsWeakField(lowering, member);
        },
        // An assignment reads its target back, and reading a weak field upgrades it.
        is AssignmentExpressionNode assignment -> {
            return classes.readsWeakField(lowering, syntax.unwrapParentheses(assignment.target()));
        },
        // 'as?' retains what it returns, so a binding may take the result as its own.
        is CheckedCastExpressionNode ignored -> {
            return true;
        },
        default -> {
            return false;
        },
    }
}

// The address of the storage an expression names, or -1 when the expression is not a place. A
// caller that needs a place and gets -1 has an expression that only produces a value. The address
// is at the type the expression was recorded at: narrowing sharpens a tagged optional to its
// payload while the whole pair is in storage, so the address steps into the payload sema proved
// present. The access is what the caller does with the storage, and an element access reached on
// the way there names it in the panic a broken index raises.
public lowerAddress(LoweringContext lowering, Expression node, EirAccess access) -> long {
    long address = storageAddress(lowering, node, access);
    if (address < 0) {
        return address;
    }
    let recorded = lowering.result().typeOf(node.green());
    if (recorded == null) {
        return address;
    }
    let builder = lowering.builder();
    let narrowed = lowering.substituted(recorded);
    long current = address;
    while (true) {
        let storageType = builder.tempType(current);
        let payloadType = primitives.taggedPayloadOf(storageType);
        if (payloadType == null
                || primitives.optionalDepth(storageType) <= primitives.optionalDepth(narrowed)) {
            return current;
        }
        long payload = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(payload, payloadType, current));
        current = payload;
    }
}

// The address of the expression's storage at that storage's own type.
storageAddress(LoweringContext lowering, Expression node, EirAccess access) -> long {
    switch (node) {
        is ParenthesizedExpressionNode parenthesized -> {
            return lowerAddress(lowering, parenthesized.inner(), access);
        },
        is IdentifierExpressionNode identifier -> {
            let binding = lowering.result().bindingOf(identifier.green());
            if (binding == null) {
                return -1;
            }
            let slot = lowering.slotFor(binding);
            if (slot == null) {
                return defaults.siblingFieldAddress(lowering, binding);
            }
            return ownership.slotAddress(lowering, slot,
                lowering.substituted(binding.type()));
        },
        is SubscriptExpressionNode subscript -> {
            return arrays.lowerElementAddress(lowering, subscript, access);
        },
        is MemberExpressionNode member -> {
            long field = classes.lowerFieldAddress(lowering, member);
            if (field >= 0 || lowering.failed()) {
                return field;
            }
            return structs.lowerFieldAddress(lowering, member, access);
        },
        is ThisExpressionNode ignored -> {
            return structs.receiverAddress(lowering);
        },
        default -> {
            return -1;
        },
    }
}

// Reads the value the storage at an address holds.
public loadFrom(LoweringContext lowering, long address, Type type) -> long {
    let builder = lowering.builder();
    long value = builder.newTemp(type);
    builder.append(new EirLoadPtr(value, type, address));
    return value;
}

// Reads storage as the type the expression naming it was recorded at. Narrowing away an optional
// gives the expression a sharper type than the storage keeps, and both are the same machine value,
// so the read happens at the storage's own type and is renamed afterwards.
public readFrom(LoweringContext lowering, long address, Type recordedType, Span span) -> long {
    long value = loadFrom(lowering, address, lowering.builder().tempType(address));
    return conversions.convert(lowering, value, recordedType, span);
}

// Reads what a read names and retains it, for a read that a later part of its expression may
// replace while the value is in use. A value holding references inside fields or behind a tag is
// retained through the storage it was read from.
public lowerRetained(LoweringContext lowering, Expression node) -> long {
    let type = lowering.typeOf(node);
    if (type == null) {
        return -1;
    }
    if (primitives.isReferenceType(type)) {
        long value = expressions.lowerForm(lowering, node);
        if (value >= 0) {
            ownership.retainValue(lowering, value);
        }
        return value;
    }
    long address = lowerAddress(lowering, node, EirAccess.Read);
    if (address < 0) {
        if (!lowering.failed()) {
            lowering.internalError("a retained read names no storage", node.span());
        }
        return -1;
    }
    long value = readFrom(lowering, address, type, node.span());
    ownership.retainAt(lowering, address, lowering.builder().tempType(address));
    return value;
}

// True when the read an expression evaluates to, under any parentheses, 'try' or conversion,
// retains what it reads.
public retainsRead(LoweringContext lowering, Expression node) -> bool {
    switch (node) {
        is ParenthesizedExpressionNode parenthesized -> {
            return retainsRead(lowering, parenthesized.inner());
        },
        is TryExpressionNode tried -> {
            return retainsRead(lowering, tried.operand());
        },
        is CastExpressionNode cast -> {
            return retainsRead(lowering, cast.value());
        },
        default -> {
            return lowering.ownsRead(node);
        },
    }
}
