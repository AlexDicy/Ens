// The ARC operations lowering emits, in one place so every site that changes who owns a reference
// reads the same way. A producer returns +1 and a binding takes it without retaining again,
// call arguments pass at +0, and no pair that provably cancels is elided here.
import Type from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import EirBranch from eir.model;
import EirJump from eir.model;
import EirLoadPtr from eir.model;
import EirLoadSlot from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirSlotAddress from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirFieldAddress from eir.model;
import EirFunctionBuilder from eir.model;
import LoweringContext from lower.context;
import support.primitives;
import ReferenceWalker from support.references;
import support.references;
import List from @std.collections.list;

// Takes over a +1 on each reference a borrowed value temp holds.
public retainValue(LoweringContext lowering, long value) {
    lowering.builder().append(new EirRetain(value));
}

// Releases the +1 a value temp owns.
public releaseValue(LoweringContext lowering, long value) {
    lowering.builder().append(new EirRelease(value));
}

// Releases what an owned value temp holds. An external handle shares the references' pointer
// shape while owning nothing to release; a value holding references behind a tag or inside fields
// is released through storage of its own, because only an address reaches them.
public releaseOwned(LoweringContext lowering, long value) {
    let builder = lowering.builder();
    let type = builder.tempType(value);
    if (primitives.isReferenceType(type)) {
        releaseValue(lowering, value);
        return;
    }
    if (!primitives.hasArcContent(type)) {
        return;
    }
    long slot = builder.addSlot("released", type, false, false);
    builder.append(new EirStoreSlot(slot, value));
    releaseSlotContents(lowering, slot, type);
}

// Reads a slot whose contents are passed on. A value holding references is taken, so the result
// owns them and the slot is left empty; anything else is loaded.
public moveOutOf(LoweringContext lowering, long slot, Type type) -> long {
    let builder = lowering.builder();
    long moved = builder.newTemp(type);
    if (primitives.hasArcContent(type)) {
        builder.append(new EirTakeSlot(moved, type, slot));
    } else {
        builder.append(new EirLoadSlot(moved, type, slot));
    }
    return moved;
}

// Retains the references the storage at an address holds, so a copy of it may be owned
// independently.
public retainAt(LoweringContext lowering, long address, Type type) {
    references.walk<long>(storageWalker(lowering, true), address, type);
}

// Releases the references the storage at an address holds.
public releaseAt(LoweringContext lowering, long address, Type type) {
    references.walk<long>(storageWalker(lowering, false), address, type);
}

storageWalker(LoweringContext lowering, bool retaining) -> StorageWalker {
    return new StorageWalker(lowering.builder(), lowering.store().primitive(PrimitiveKind.Bool),
        retaining, "opt.arc");
}

// Retains or releases each reference storage holds, through its address. An optional's payload is
// reached in a block of its own, named after `label`, that only runs when the tag marks the payload
// present: an absent pair's zeroed payload owns nothing.
public final class StorageWalker implements ReferenceWalker<long> {
    EirFunctionBuilder builder;
    Type boolType;
    bool retaining;
    string label;
    List<long> doneBlocks;

    public constructor(EirFunctionBuilder builder, Type boolType, bool retaining, string label) {
        this.builder = builder;
        this.boolType = boolType;
        this.retaining = retaining;
        this.label = label;
        this.doneBlocks = new List<long>();
    }

    public override reference(long address) {
        if (this.retaining) {
            this.builder.append(new EirRetainPtr(address));
        } else {
            this.builder.append(new EirReleasePtr(address));
        }
    }

    public override field(long record, Type recordType, long index, Type fieldType) -> long {
        long address = this.builder.newTemp(fieldType);
        this.builder.append(new EirFieldAddress(address, fieldType, record, index));
        return address;
    }

    public override payload(long pair, Type optionalType, Type payloadType) -> long {
        let builder = this.builder;
        long value = builder.newTemp(optionalType);
        builder.append(new EirLoadPtr(value, optionalType, pair));
        long present = builder.newTemp(this.boolType);
        builder.append(new EirOptionalPresence(present, this.boolType, value));
        long walkBlock = builder.newBlock(this.label);
        long doneBlock = builder.newBlock(this.label + ".end");
        builder.terminate(new EirBranch(present, walkBlock, doneBlock));
        builder.moveTo(walkBlock);
        this.doneBlocks.push(doneBlock);
        long payloadAddress = builder.newTemp(payloadType);
        builder.append(new EirOptionalPayloadAddress(payloadAddress, payloadType, pair));
        return payloadAddress;
    }

    public override endPayload() {
        long doneBlock = this.doneBlocks.pop();
        this.builder.terminate(new EirJump(doneBlock));
        this.builder.moveTo(doneBlock);
    }
}

// The address of a slot, for an ARC operation on its contents.
public slotAddress(LoweringContext lowering, long slot, Type type) -> long {
    let builder = lowering.builder();
    long address = builder.newTemp(type);
    builder.append(new EirSlotAddress(address, type, slot));
    return address;
}

// Records that a slot's scope owns its contents, when the type has any to own.
public trackSlot(LoweringContext lowering, long slot, Type type) {
    if (primitives.hasArcContent(type)) {
        lowering.ownSlot(slot);
    }
}

// The slot the paths of a '?:', a switch or an optional operator write their value into, for the
// merge to move it out. Every path writes it once, so it is empty again before any code that could
// leave the scope runs, and the merged value is the expression's own.
public defineJoinSlot(LoweringContext lowering, string name, Type type) -> long {
    return lowering.builder().addSlot(name, type, false, false);
}

// A slot that stands in for a value no path writes, read by code nothing reaches. It starts zeroed
// and its scope releases it, which releases nothing.
public defineStandInSlot(LoweringContext lowering, string name, Type type) -> long {
    long slot = lowering.builder().addSlot(name, type, primitives.hasArcContent(type), false);
    trackSlot(lowering, slot, type);
    return slot;
}

// Releases what a slot holds. Callers that overwrite a location retain the incoming value
// first, so a location assigned from itself never drops to zero in between.
public releaseSlotContents(LoweringContext lowering, long slot, Type type) {
    if (!primitives.hasArcContent(type)) {
        return;
    }
    long address = slotAddress(lowering, slot, type);
    releaseAt(lowering, address, type);
}

// Releases every slot the scopes above depth own, innermost scope first. Used by scope exit and
// by the early exits 'break' and 'continue' take.
public releaseScopesAbove(LoweringContext lowering, long depth) {
    for (long scope = lowering.scopeDepth() - 1; scope >= depth; scope--) {
        long[] slots = lowering.ownedSlotsAt(scope);
        for (long i = slots.length - 1; i >= 0; i--) {
            long slot = slots[i];
            let type = lowering.builder().slotType(slot);
            releaseSlotContents(lowering, slot, type);
        }
    }
}

// Releases every owned slot, which is what a return must do before it leaves.
public releaseAllScopes(LoweringContext lowering) {
    releaseScopesAbove(lowering, 0);
}
