// The program index: one pure pass over the analyzed program that pairs every function signature
// with its defining module, its red declaration node, and its linker symbol, and every struct with
// the declaration its field defaults and methods are read from. Lowering consults it to resolve
// call targets and to reach a callee's defaults, and the driver walks its per-module lists to know
// what to lower and emit.
//
// A struct's methods are not in its module's function table, so they reach the driver only from
// here: each carries the struct as its receiver type, which becomes the receiver address its body
// runs over.
import ProgramAnalysis from @ens.sema.pipeline;
import ModuleContext from @ens.sema.context;
import Method from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import Visibility from @ens.sema.model.types;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import lower.symbols;
import List from @std.collections.list;
import Map from @std.collections.map;

// One function of the program: entry metadata plus the red declaration node lowering walks. The
// declaration is null for built-in and body-less entries. A method carries the type it runs
// over, which reaches its body as the receiver address; a free function carries none.
public final class FunctionInfo {
    ModuleContext owningContext;
    Signature functionSignature;
    Visibility functionVisibility;
    bool externalFunction;
    bool builtinFunction;
    Type? methodReceiverType;
    FunctionDeclarationNode? redDeclaration;
    string linkSymbol;

    public constructor(ModuleContext context, Signature signature, Visibility visibility,
                bool isExternal, bool isBuiltin, Type? receiverType,
                FunctionDeclarationNode? declaration, string symbol) {
        this.owningContext = context;
        this.functionSignature = signature;
        this.functionVisibility = visibility;
        this.externalFunction = isExternal;
        this.builtinFunction = isBuiltin;
        this.methodReceiverType = receiverType;
        this.redDeclaration = declaration;
        this.linkSymbol = symbol;
    }

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public receiverType() -> Type? {
        return this.methodReceiverType;
    }

    public signature() -> Signature {
        return this.functionSignature;
    }

    public visibility() -> Visibility {
        return this.functionVisibility;
    }

    public isExternal() -> bool {
        return this.externalFunction;
    }

    public isBuiltin() -> bool {
        return this.builtinFunction;
    }

    public declaration() -> FunctionDeclarationNode? {
        return this.redDeclaration;
    }

    public symbol() -> string {
        return this.linkSymbol;
    }

    // Internal linkage keeps a private function's bare name from colliding across modules.
    public internalLinkage() -> bool {
        return this.functionVisibility == Visibility.Private && !this.externalFunction
            && !this.builtinFunction;
    }
}

// One struct declaration of the program: the module that declares it and the red node whose
// members carry the field defaults. A field default is checked in its declaring module, so
// lowering one reads that module's side tables.
public final class StructInfo {
    ModuleContext owningContext;
    StructDeclarationNode redDeclaration;

    public constructor(this.owningContext, this.redDeclaration);

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public declaration() -> StructDeclarationNode {
        return this.redDeclaration;
    }
}

// The functions one module defines and must emit.
public final class ModuleFunctions {
    ModuleContext owningContext;
    List<FunctionInfo> lowerableFunctions;

    public constructor(ModuleContext context) {
        this.owningContext = context;
        this.lowerableFunctions = new List<FunctionInfo>();
    }

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public functions() -> List<FunctionInfo> {
        return this.lowerableFunctions;
    }
}

public final class ProgramIndex {
    Map<Signature, FunctionInfo> infoBySignature;
    Map<Type, StructInfo> structByType;
    List<ModuleFunctions> moduleList;
    FunctionInfo? mainInfo;

    public constructor() {
        this.infoBySignature = new Map<Signature, FunctionInfo>();
        this.structByType = new Map<Type, StructInfo>();
        this.moduleList = new List<ModuleFunctions>();
        this.mainInfo = null;
    }

    public infoFor(Signature signature) -> FunctionInfo? {
        return this.infoBySignature.get(signature);
    }

    public structFor(Type structType) -> StructInfo? {
        return this.structByType.get(structType);
    }

    public modules() -> List<ModuleFunctions> {
        return this.moduleList;
    }

    // The program's entry function, when the analyzed program has one.
    public entryFunction() -> FunctionInfo? {
        return this.mainInfo;
    }

    public register(Signature signature, FunctionInfo info) {
        this.infoBySignature.set(signature, info);
    }

    public registerStruct(Type structType, StructInfo info) {
        this.structByType.set(structType, info);
    }

    public addModule(ModuleFunctions moduleFunctions) {
        this.moduleList.push(moduleFunctions);
    }

    public setEntryFunction(FunctionInfo info) {
        this.mainInfo = info;
    }
}

public buildIndex(ProgramAnalysis analysis) -> ProgramIndex {
    let index = new ProgramIndex();
    let contexts = analysis.contexts();
    for (long c = 0; c < contexts.length(); c++) {
        let context = contexts.get(c);
        let declarations = redFunctionDeclarations(context);
        let moduleFunctions = new ModuleFunctions(context);
        let entries = context.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            let signature = entry.signature();
            let named = context.functions().entriesNamed(signature.name());
            bool overloaded = named != null && named.length() > 1;
            FunctionDeclarationNode? declaration = null;
            let declarationGreen = signature.declaration();
            if (declarationGreen != null) {
                declaration = declarations.get(declarationGreen);
            }
            string symbol = symbols.linkName(signature, entry.visibility(), entry.isExternal(),
                context.module().canonicalPath(), overloaded);
            let info = new FunctionInfo(context, signature, entry.visibility(),
                entry.isExternal(), entry.isBuiltin(), null, declaration, symbol);
            index.register(signature, info);
            if (!entry.isExternal() && !entry.isBuiltin() && !signature.isGeneric()
                    && declaration != null) {
                moduleFunctions.functions().push(info);
                if (signature.name() == "main"
                        && context.module().canonicalPath() == "main") {
                    index.setEntryFunction(info);
                }
            }
        }
        indexStructs(analysis, index, context, moduleFunctions);
        index.addModule(moduleFunctions);
    }
    return index;
}

// The structs one module declares, with their methods. A generic struct is skipped: its
// instantiations are the emittable types, and monomorphization does not exist yet.
indexStructs(ProgramAnalysis analysis, ProgramIndex index, ModuleContext context,
             ModuleFunctions moduleFunctions) {
    let root = context.root();
    if (root == null) {
        return;
    }
    string modulePath = context.module().canonicalPath();
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (!(item is StructDeclarationNode)) {
            continue;
        }
        let declared = analysis.store().findDeclared(modulePath, item.name().text());
        if (!(declared is StructType)) {
            continue;
        }
        index.registerStruct(declared, new StructInfo(context, item));
        if (declared.isGeneric()) {
            continue;
        }
        indexMethods(index, context, declared, item, moduleFunctions);
    }
}

indexMethods(ProgramIndex index, ModuleContext context, StructType structType,
             StructDeclarationNode node, ModuleFunctions moduleFunctions) {
    let declarations = redMemberDeclarations(node);
    let methods = structType.methods();
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        let signature = method.signature();
        FunctionDeclarationNode? declaration = null;
        let declarationGreen = signature.declaration();
        if (declarationGreen != null) {
            declaration = declarations.get(declarationGreen);
        }
        string symbol = symbols.methodLinkName(context.module().canonicalPath(),
            structType.name(), signature, overloadedIn(methods, method.name()));
        let info = new FunctionInfo(context, signature, method.visibility(), false, false,
            structType, declaration, symbol);
        index.register(signature, info);
        if (!signature.isGeneric() && declaration != null && declaration.body() != null) {
            moduleFunctions.functions().push(info);
        }
    }
}

// True when the struct declares more than one method under this name, which is what puts the
// parameter-type suffix in the symbol.
overloadedIn(List<Method> methods, string name) -> bool {
    long seen = 0;
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).name() == name) {
            seen++;
        }
    }
    return seen > 1;
}

redMemberDeclarations(StructDeclarationNode node) -> Map<GreenNode, FunctionDeclarationNode> {
    let declarations = new Map<GreenNode, FunctionDeclarationNode>();
    let body = node.body();
    for (long i = 0; i < body.membersCount(); i++) {
        let member = body.members(i);
        if (member is FunctionDeclarationNode) {
            declarations.set(member.green(), member);
        }
    }
    return declarations;
}

redFunctionDeclarations(ModuleContext context) -> Map<GreenNode, FunctionDeclarationNode> {
    let declarations = new Map<GreenNode, FunctionDeclarationNode>();
    let root = context.root();
    if (root == null) {
        return declarations;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is FunctionDeclarationNode) {
            declarations.set(item.green(), item);
        }
    }
    return declarations;
}
