// The program index: one pure pass over the analyzed program that pairs every function signature
// with its defining module, its red declaration node, and its linker symbol, and every struct and
// class with the member list its field defaults are read from. Lowering consults it to resolve call
// targets and to reach a callee's defaults, and the driver walks its per-module lists to know what
// to lower and emit.
//
// A record's methods are not in its module's function table, so they reach the driver only from
// here: each carries its struct or class as its receiver type, which becomes the storage its body
// runs over. A class also reaches the driver as a class, because the destructor its objects carry is
// a function the declaring module has to emit whether or not anything in that module creates one.
import ProgramAnalysis from @ens.sema.pipeline;
import ModuleContext from @ens.sema.context;
import ClassType from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import Method from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import Visibility from @ens.sema.model.types;
import @ens.sema.model.types;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import SyntaxNode from @ens.frontend.syntax.node;
import TypeStore from @ens.sema.model.types;
import Substitution from mono.substitution;
import mono.substitution;
import lower.closures;
import lower.symbols;
import lower.throwing;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// One function of the program: entry metadata plus the red declaration node lowering walks. The
// declaration is null for built-in and body-less entries. A method carries the type it runs
// over, which reaches its body as the receiver address; a free function carries none.
public final class FunctionInfo {
    ModuleContext owningContext;
    Signature functionSignature;
    Visibility functionVisibility;
    bool externalFunction;
    bool builtinFunction;
    Type? methodReceiverType;
    Method? declaringMethod;
    FunctionDeclarationNode? redDeclaration;
    TestDeclarationNode? testRedDeclaration;
    LambdaExpressionNode? lambdaRedDeclaration;
    string linkSymbol;
    Substitution? instanceSubstitution;

    public constructor(ModuleContext context, Signature signature, Visibility visibility,
                bool isExternal, bool isBuiltin, Type? receiverType, Method? method,
                FunctionDeclarationNode? declaration, string symbol,
                Substitution? substitution = null, TestDeclarationNode? test = null,
                LambdaExpressionNode? lambda = null) {
        this.owningContext = context;
        this.functionSignature = signature;
        this.functionVisibility = visibility;
        this.externalFunction = isExternal;
        this.builtinFunction = isBuiltin;
        this.methodReceiverType = receiverType;
        this.declaringMethod = method;
        this.redDeclaration = declaration;
        this.testRedDeclaration = test;
        this.lambdaRedDeclaration = lambda;
        this.linkSymbol = symbol;
        this.instanceSubstitution = substitution;
    }

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public receiverType() -> Type? {
        return this.methodReceiverType;
    }

    // The record member this entry came from, or null for a free function.
    public method() -> Method? {
        return this.declaringMethod;
    }

    // True for a constructor, whose body may be nothing but the fields its parameters assign.
    public isConstructor() -> bool {
        let method = this.declaringMethod;
        return method != null && method.isConstructor();
    }

    public signature() -> Signature {
        return this.functionSignature;
    }

    public visibility() -> Visibility {
        return this.functionVisibility;
    }

    public isExternal() -> bool {
        return this.externalFunction;
    }

    public isBuiltin() -> bool {
        return this.builtinFunction;
    }

    public declaration() -> FunctionDeclarationNode? {
        return this.redDeclaration;
    }

    // The test declaration this entry lowers, or null for an ordinary function. A test has no
    // red function declaration; its body hangs off the test node instead.
    public testDeclaration() -> TestDeclarationNode? {
        return this.testRedDeclaration;
    }

    // The lambda whose body this entry lowers, or null for everything else. Its receiver is the
    // closure object the captures live in.
    public lambdaDeclaration() -> LambdaExpressionNode? {
        return this.lambdaRedDeclaration;
    }

    public symbol() -> string {
        return this.linkSymbol;
    }

    // The type-argument assignment a generic instance lowers its template body under, or null for
    // ordinary code.
    public substitution() -> Substitution? {
        return this.instanceSubstitution;
    }

    // Internal linkage keeps a private function's bare name from colliding across modules. A
    // method is always external: its symbol already carries its module and record, and its
    // address travels in the dispatch tables other modules' descriptors reference. A generic
    // instance is always external: its home module defines it once for the whole program. So is
    // a lambda's body, for the same reason: it is defined in the module that writes the lambda
    // while a closure over it may be built in any module, as a field default is.
    public internalLinkage() -> bool {
        return this.functionVisibility == Visibility.Private && !this.externalFunction
            && !this.builtinFunction && this.methodReceiverType == null
            && this.instanceSubstitution == null;
    }
}

// One struct or class declaration of the program: the module that declares it and the member list
// its field defaults are written in. A field default is checked in its declaring module, so lowering
// one reads that module's side tables.
public final class RecordInfo {
    ModuleContext owningContext;
    MemberListNode declaredMembers;

    public constructor(this.owningContext, this.declaredMembers);

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public members() -> MemberListNode {
        return this.declaredMembers;
    }
}

// The functions one module defines and must emit, the classes whose destructors it owns, and the
// interfaces whose type descriptors it defines.
public final class ModuleFunctions {
    ModuleContext owningContext;
    List<FunctionInfo> lowerableFunctions;
    List<ClassType> declaredClasses;
    List<InterfaceType> declaredInterfaces;
    List<Type> homedInstantiations;

    public constructor(ModuleContext context) {
        this.owningContext = context;
        this.lowerableFunctions = new List<FunctionInfo>();
        this.declaredClasses = new List<ClassType>();
        this.declaredInterfaces = new List<InterfaceType>();
        this.homedInstantiations = new List<Type>();
    }

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public functions() -> List<FunctionInfo> {
        return this.lowerableFunctions;
    }

    public classes() -> List<ClassType> {
        return this.declaredClasses;
    }

    public interfaces() -> List<InterfaceType> {
        return this.declaredInterfaces;
    }

    // The generic instantiations whose one definition this module owns, because it declares their
    // templates: their methods, destructors, and descriptors emit here and nowhere else.
    public instantiations() -> List<Type> {
        return this.homedInstantiations;
    }
}

// Where one lambda sits: the module that writes it and its position among that module's lambdas.
// Together with the substitution it is lowered under, that is its symbol.
public final class LambdaSite {
    string owningModulePath;
    long lambdaIndex;

    public constructor(this.owningModulePath, this.lambdaIndex);

    public modulePath() -> string {
        return this.owningModulePath;
    }

    public index() -> long {
        return this.lambdaIndex;
    }
}

// One generic function instance, identified by its template's signature and its concrete type
// arguments; signatures and types are interned, so identity comparison is enough.
class FunctionInstanceKey {
    Signature keyTemplate;
    Type[] keyArguments;

    protected constructor(Signature template, Type[] arguments) {
        this.keyTemplate = template;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyTemplate.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(FunctionInstanceKey other) -> bool {
        if (this.keyTemplate != other.keyTemplate) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

public final class ProgramIndex {
    Map<Signature, FunctionInfo> infoBySignature;
    Map<FunctionInstanceKey, FunctionInfo> instanceByKey;
    Map<Type, RecordInfo> recordByType;
    List<ModuleFunctions> moduleList;
    Map<GreenNode, LambdaSite> lambdaSites;
    FunctionInfo? mainInfo;

    public constructor() {
        this.infoBySignature = new Map<Signature, FunctionInfo>();
        this.instanceByKey = new Map<FunctionInstanceKey, FunctionInfo>();
        this.recordByType = new Map<Type, RecordInfo>();
        this.moduleList = new List<ModuleFunctions>();
        this.lambdaSites = new Map<GreenNode, LambdaSite>();
        this.mainInfo = null;
    }

    public registerLambdaSite(GreenNode node, LambdaSite site) {
        this.lambdaSites.set(node, site);
    }

    public lambdaSiteOf(GreenNode node) -> LambdaSite? {
        return this.lambdaSites.get(node);
    }

    // The linker symbol of one lambda's body under the substitution it is lowered beneath: the
    // module's numbering alone for ordinary code, and the instance's type arguments appended
    // inside a template body. Null when the lambda is not one this program lowers.
    public lambdaSymbolOf(GreenNode node, Substitution? active) -> string? {
        let site = this.lambdaSites.get(node);
        if (site == null) {
            return null;
        }
        Type[] arguments = [];
        if (active != null) {
            arguments = active.arguments();
        }
        return symbols.lambdaLinkName(site.modulePath(), site.index(), arguments);
    }

    public infoFor(Signature signature) -> FunctionInfo? {
        return this.infoBySignature.get(signature);
    }

    // The planned instance of a generic function at these concrete type arguments, or null when
    // the monomorphization closure never discovered the combination.
    public functionInstance(Signature template, Type[] arguments) -> FunctionInfo? {
        return this.instanceByKey.get(new FunctionInstanceKey(template, arguments));
    }

    public registerFunctionInstance(Signature template, Type[] arguments, FunctionInfo info) {
        this.instanceByKey.set(new FunctionInstanceKey(template, arguments), info);
    }

    public recordFor(Type recordType) -> RecordInfo? {
        return this.recordByType.get(recordType);
    }

    public modules() -> List<ModuleFunctions> {
        return this.moduleList;
    }

    // The program's entry function, when the analyzed program has one.
    public entryFunction() -> FunctionInfo? {
        return this.mainInfo;
    }

    public register(Signature signature, FunctionInfo info) {
        this.infoBySignature.set(signature, info);
    }

    public registerRecord(Type recordType, RecordInfo info) {
        this.recordByType.set(recordType, info);
    }

    public addModule(ModuleFunctions moduleFunctions) {
        this.moduleList.push(moduleFunctions);
    }

    public setEntryFunction(FunctionInfo info) {
        this.mainInfo = info;
    }
}

// Adds one entry per lambda body the program lowers, once per enclosing instance. Called after
// monomorphization has filled the function lists, so an instance discovered there brings its
// lambdas with it; a lambda inside a template that nothing instantiates gets no entry, because
// nothing lowers it.
//
// The module that WRITES a lambda defines its body, whichever module builds a closure over it.
// That matters for the lambdas nothing in this module's function bodies reaches: a field default
// is lowered wherever the record is built, so its lambda is indexed from the record instead.
//
// A lambda's symbol names its module and its position among that module's lambdas rather than the
// function around it, because a lambda in a default has no one enclosing function to be named
// after and the position is the only thing every site that lowers it agrees on.
public indexLambdas(ProgramIndex index, TypeStore store) {
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        let taken = new Set<string>();
        let entries = new List<FunctionInfo>();
        indexBodyLambdas(index, store, moduleFunctions, taken, entries);
        indexFieldDefaultLambdas(index, store, moduleFunctions, taken, entries);
        for (long i = 0; i < entries.length(); i++) {
            moduleFunctions.functions().push(entries.get(i));
        }
    }
}

// The lambdas one module's own callables hold, each under that callable's substitution: a
// declaration covers its parameter defaults, its body and its catch clauses, and a test its body.
indexBodyLambdas(ProgramIndex index, TypeStore store, ModuleFunctions moduleFunctions,
                 Set<string> taken, List<FunctionInfo> entries) {
    let functions = moduleFunctions.functions();
    for (long f = 0; f < functions.length(); f++) {
        let owner = functions.get(f);
        SyntaxNode? node = owner.declaration();
        if (node == null) {
            node = owner.testDeclaration();
        }
        if (node == null) {
            continue;
        }
        addLambdaEntries(index, store, owner.context(), owner.substitution(),
            closures.lambdasIn(node), taken, entries);
    }
}

// The lambdas one module's records hold in their field defaults. A default is lowered wherever the
// record is built, which is why the declaring module indexes it here rather than waiting for a
// construction it may never see: once for the declared record, and once for every instantiation of
// it this module homes, because that is the set of substitutions a default is ever lowered under.
indexFieldDefaultLambdas(ProgramIndex index, TypeStore store, ModuleFunctions moduleFunctions,
                         Set<string> taken, List<FunctionInfo> entries) {
    let context = moduleFunctions.context();
    let root = context.root();
    if (root == null) {
        return;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        MemberListNode? members = null;
        string name = "";
        if (item is StructDeclarationNode) {
            members = item.body();
            name = item.name().text();
        } else if (item is ClassDeclarationNode) {
            members = item.body();
            name = item.name().text();
        }
        if (members == null) {
            continue;
        }
        let lambdas = closures.lambdasInFieldDefaults(members);
        if (lambdas.length() == 0) {
            continue;
        }
        let declared = store.findDeclared(context.module().canonicalPath(), name);
        if (declared == null) {
            continue;
        }
        if (!declared.isGeneric()) {
            addLambdaEntries(index, store, context, null, lambdas, taken, entries);
        }
        for (long n = 0; n < moduleFunctions.instantiations().length(); n++) {
            let instantiation = moduleFunctions.instantiations().get(n);
            if (!(instantiation is InstantiationType)
                    || instantiation.template() != declared) {
                continue;
            }
            addLambdaEntries(index, store, context,
                substitution.forInstantiation(instantiation), lambdas, taken, entries);
        }
    }
}

addLambdaEntries(ProgramIndex index, TypeStore store, ModuleContext context,
                 Substitution? active, List<LambdaExpressionNode> lambdas, Set<string> taken,
                 List<FunctionInfo> entries) {
    for (long i = 0; i < lambdas.length(); i++) {
        let lambda = lambdas.get(i);
        let info = context.result().lambdaOf(lambda.green());
        if (info == null) {
            continue;
        }
        let symbol = index.lambdaSymbolOf(lambda.green(), active);
        if (symbol == null || !taken.add(symbol)) {
            continue;
        }
        Type closureType = substitution.apply(store, active, info.type());
        entries.push(new FunctionInfo(context, info.signature(), Visibility.Private, false,
            false, closureType, null, null, symbol, active, null, lambda));
    }
}

// Numbers every lambda a module writes, in source order over the whole file, so the position a
// symbol carries is the same whichever body the walk reached the lambda from.
numberLambdas(ProgramIndex index, ModuleContext context) {
    let root = context.root();
    if (root == null) {
        return;
    }
    string modulePath = context.module().canonicalPath();
    let lambdas = closures.lambdasIn(root);
    for (long i = 0; i < lambdas.length(); i++) {
        index.registerLambdaSite(lambdas.get(i).green(), new LambdaSite(modulePath, i));
    }
}

public buildIndex(ProgramAnalysis analysis) -> ProgramIndex {
    let index = new ProgramIndex();
    let contexts = analysis.contexts();
    for (long c = 0; c < contexts.length(); c++) {
        let context = contexts.get(c);
        numberLambdas(index, context);
        let declarations = redFunctionDeclarations(context);
        let testDeclarations = redTestDeclarations(context);
        let moduleFunctions = new ModuleFunctions(context);
        let entries = context.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            let signature = entry.signature();
            let named = context.functions().entriesNamed(signature.name());
            bool overloaded = named != null && named.length() > 1;
            FunctionDeclarationNode? declaration = null;
            TestDeclarationNode? test = null;
            let declarationGreen = signature.declaration();
            if (declarationGreen != null) {
                declaration = declarations.get(declarationGreen);
                test = testDeclarations.get(declarationGreen);
            }
            string symbol = symbols.linkName(signature, entry.isExternal(),
                context.module().canonicalPath(), overloaded);
            let info = new FunctionInfo(context, signature, entry.visibility(),
                entry.isExternal(), entry.isBuiltin(), null, null, declaration, symbol, null,
                test);
            index.register(signature, info);
            if (!entry.isExternal() && !entry.isBuiltin() && !signature.isGeneric()
                    && (declaration != null || test != null)) {
                moduleFunctions.functions().push(info);
                if (signature.name() == "main"
                        && mayDefineEntry(context.module().canonicalPath())) {
                    index.setEntryFunction(info);
                }
            }
        }
        indexRecords(analysis, index, context, moduleFunctions);
        index.addModule(moduleFunctions);
    }
    return index;
}

// The structs and classes one module declares, with their methods. A generic record is skipped: its
// instantiations are the emittable types, and monomorphization does not exist yet. A class code
// generation cannot lay out is registered but contributes no methods, so a program that only
// imports the module declaring it still compiles and only a program that reaches into it fails.
indexRecords(ProgramAnalysis analysis, ProgramIndex index, ModuleContext context,
             ModuleFunctions moduleFunctions) {
    let root = context.root();
    if (root == null) {
        return;
    }
    string modulePath = context.module().canonicalPath();
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is StructDeclarationNode) {
            let declared = analysis.store().findDeclared(modulePath, item.name().text());
            if (!(declared is StructType)) {
                continue;
            }
            index.registerRecord(declared, new RecordInfo(context, item.body()));
            if (!declared.isGeneric()) {
                indexMethods(index, context, declared, declared.methods(), item.body(),
                    moduleFunctions, true);
                indexMethods(index, context, declared, declared.staticMethods(), item.body(),
                    moduleFunctions, false);
            }
        } else if (item is ClassDeclarationNode) {
            let declared = analysis.store().findDeclared(modulePath, item.name().text());
            if (!(declared is ClassType)) {
                continue;
            }
            index.registerRecord(declared, new RecordInfo(context, item.body()));
            if (!primitives.isRepresentableClass(declared)) {
                continue;
            }
            moduleFunctions.classes().push(declared);
            indexMethods(index, context, declared, declared.methods(), item.body(),
                moduleFunctions, true);
            indexMethods(index, context, declared, declared.staticMethods(), item.body(),
                moduleFunctions, false);
        } else if (item is InterfaceDeclarationNode) {
            let declared = analysis.store().findDeclared(modulePath, item.name().text());
            if (!(declared is InterfaceType) || declared.isGeneric()) {
                continue;
            }
            moduleFunctions.interfaces().push(declared);
            indexMethods(index, context, declared, declared.methods(), item.body(),
                moduleFunctions, true);
        } else if (item is PrimitiveDeclarationNode) {
            let primitive = types.primitiveNamed(analysis.store(), item.name().text());
            if (primitive == null) {
                continue;
            }
            let binding = types.bindingOf(primitive);
            if (binding == null || binding.declaration() != item.green()) {
                continue;
            }
            // The members belong to the primitive, so they carry it as their receiver and their
            // symbols read under its name; the primitive itself needs no layout of its own.
            indexMethods(index, context, primitive, binding.methods(), item.body(),
                moduleFunctions, true);
            indexMethods(index, context, primitive, binding.staticMethods(), item.body(),
                moduleFunctions, false);
        }
    }
}

// Instance methods run over their record, so their entries carry it as the receiver type; a
// static method takes no receiver and lowers like a free function under its record's symbol.
indexMethods(ProgramIndex index, ModuleContext context, Type recordType, List<Method> methods,
             MemberListNode body, ModuleFunctions moduleFunctions, bool withReceiver) {
    let declarations = redMemberDeclarations(body);
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        let signature = method.signature();
        FunctionDeclarationNode? declaration = null;
        let declarationGreen = signature.declaration();
        if (declarationGreen != null) {
            declaration = declarations.get(declarationGreen);
        }
        Type? receiverType = null;
        if (withReceiver) {
            receiverType = recordType;
        }
        string symbol = symbols.methodLinkName(context.module().canonicalPath(),
            nameOf(recordType), signature, overloadedIn(methods, method.name()));
        let info = new FunctionInfo(context, signature, method.visibility(), false, false,
            receiverType, method, declaration, symbol);
        index.register(signature, info);
        if (signature.isGeneric() || declaration == null) {
            continue;
        }
        if (throwing.isInterceptedTraceMethod(recordType, method)) {
            continue;
        }
        if (declaration.body() != null || method.isConstructor()) {
            moduleFunctions.functions().push(info);
        }
    }
}

nameOf(Type recordType) -> string {
    if (recordType is StructType) {
        return recordType.name();
    }
    if (recordType is ClassType) {
        return recordType.name();
    }
    if (recordType is InterfaceType) {
        return recordType.name();
    }
    return types.display(recordType);
}

// True when the struct declares more than one method under this name, which is what puts the
// parameter-type suffix in the symbol.
overloadedIn(List<Method> methods, string name) -> bool {
    long seen = 0;
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).name() == name) {
            seen++;
        }
    }
    return seen > 1;
}

public redMemberDeclarations(MemberListNode body) -> Map<GreenNode, FunctionDeclarationNode> {
    let declarations = new Map<GreenNode, FunctionDeclarationNode>();
    for (long i = 0; i < body.membersCount(); i++) {
        let member = body.members(i);
        if (member is FunctionDeclarationNode) {
            declarations.set(member.green(), member);
        }
    }
    return declarations;
}

redFunctionDeclarations(ModuleContext context) -> Map<GreenNode, FunctionDeclarationNode> {
    let declarations = new Map<GreenNode, FunctionDeclarationNode>();
    let root = context.root();
    if (root == null) {
        return declarations;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is FunctionDeclarationNode) {
            declarations.set(item.green(), item);
        }
    }
    return declarations;
}

redTestDeclarations(ModuleContext context) -> Map<GreenNode, TestDeclarationNode> {
    let declarations = new Map<GreenNode, TestDeclarationNode>();
    let root = context.root();
    if (root == null) {
        return declarations;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is TestDeclarationNode) {
            declarations.set(item.green(), item);
        }
    }
    return declarations;
}

// The entry point lives in the 'main' module or in a compiler-owned '$' module, the synthesized
// test runner; sema enforces the same placement rule.
mayDefineEntry(string modulePath) -> bool {
    if (modulePath == "main") {
        return true;
    }
    return modulePath.length > 0 && modulePath.substring(0, 1) == "$";
}
