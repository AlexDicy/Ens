// The copy of an inlined function's instructions in the function they are inlined into. Every
// operand is renumbered through an InlineRemap, and nothing else about an instruction changes.
import EirInstruction from eir.model;
import EirTerminator from eir.model;
import EirAbsentOptional from eir.model;
import EirArrayLength from eir.model;
import EirArrayNew from eir.model;
import EirArraySlice from eir.model;
import EirArrayFreeze from eir.model;
import EirAtomicLoad from eir.model;
import EirAtomicStore from eir.model;
import EirAtomicCompareSet from eir.model;
import EirAtomicAdd from eir.model;
import EirBinary from eir.model;
import EirBoolToString from eir.model;
import EirBoundsCheck from eir.model;
import EirBranch from eir.model;
import EirCStringLift from eir.model;
import EirCall from eir.model;
import EirCaptureTrace from eir.model;
import EirCast from eir.model;
import EirCharToString from eir.model;
import EirCheckedCast from eir.model;
import EirAbandonConstruction from eir.model;
import EirClassNew from eir.model;
import EirClosureCall from eir.model;
import EirClosureCapture from eir.model;
import EirClosureNew from eir.model;
import EirConstBool from eir.model;
import EirConstFloat from eir.model;
import EirConstInt from eir.model;
import EirConstNull from eir.model;
import EirZeroStruct from eir.model;
import EirConstString from eir.model;
import EirDoubleToString from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirElementAddress from eir.model;
import EirEnumToString from eir.model;
import EirErrorTrace from eir.model;
import EirFieldAddress from eir.model;
import EirForeignCall from eir.model;
import EirGlobalAddress from eir.model;
import EirHashValue from eir.model;
import EirIntToString from eir.model;
import EirJsonEscape from eir.model;
import EirJump from eir.model;
import EirLoadPtr from eir.model;
import EirLoadSlot from eir.model;
import EirObjectFieldAddress from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirPanic from eir.model;
import EirRangeCheck from eir.model;
import EirRelease from eir.model;
import EirReleasePtr from eir.model;
import EirRetain from eir.model;
import EirRetainPtr from eir.model;
import EirRuntimeTypeName from eir.model;
import EirSlotAddress from eir.model;
import EirStorePtr from eir.model;
import EirTakePtr from eir.model;
import EirStoreSlot from eir.model;
import EirStringByteAt from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirStringFromBytes from eir.model;
import EirStringLength from eir.model;
import EirStringSubstring from eir.model;
import EirStringToBytes from eir.model;
import EirSwitch from eir.model;
import EirTakeSlot from eir.model;
import EirTraceSite from eir.model;
import EirTryCall from eir.model;
import EirTryClosureCall from eir.model;
import EirTypeTest from eir.model;
import EirUnary from eir.model;
import EirUnreachable from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import EirWeakStore from eir.model;
import EirWrapOptional from eir.model;
import InlineRemap from passes.inlineremap;

// The instruction with its temps, slots and trace site renumbered. The switch has no default arm,
// so an instruction kind cannot be added without saying how it is copied.
public copiedInstruction(EirInstruction instruction, InlineRemap remap) -> EirInstruction {
    switch (instruction) {
        is EirConstInt constant -> {
            return new EirConstInt(remap.temp(constant.result), constant.type, constant.bits);
        },
        is EirConstFloat constant -> {
            return new EirConstFloat(remap.temp(constant.result), constant.type, constant.value,
                constant.text);
        },
        is EirConstBool constant -> {
            return new EirConstBool(remap.temp(constant.result), constant.type, constant.value);
        },
        is EirBinary binary -> {
            return new EirBinary(remap.temp(binary.result), binary.type, binary.op,
                remap.temp(binary.left), remap.temp(binary.right));
        },
        is EirUnary unary -> {
            return new EirUnary(remap.temp(unary.result), unary.type, unary.op,
                remap.temp(unary.operand));
        },
        is EirCast cast -> {
            return new EirCast(remap.temp(cast.result), cast.type, cast.op,
                remap.temp(cast.operand));
        },
        is EirLoadSlot load -> {
            return new EirLoadSlot(remap.temp(load.result), load.type, remap.slot(load.slot));
        },
        is EirStoreSlot store -> {
            return new EirStoreSlot(remap.slot(store.slot), remap.temp(store.value));
        },
        is EirTakeSlot taken -> {
            return new EirTakeSlot(remap.temp(taken.result), taken.type, remap.slot(taken.slot));
        },
        is EirCall call -> {
            return new EirCall(remap.temp(call.result), call.type, call.callee,
                remap.temp(call.receiver), remap.temps(call.arguments), call.dispatchSlot,
                call.dispatchInterface, remap.line(call.line, call.inlinedAt),
                remap.frame(call.inlinedAt));
        },
        is EirRetain retain -> {
            return new EirRetain(remap.temp(retain.value));
        },
        is EirRelease release -> {
            return new EirRelease(remap.temp(release.value));
        },
        is EirRetainPtr retain -> {
            return new EirRetainPtr(remap.temp(retain.address));
        },
        is EirReleasePtr release -> {
            return new EirReleasePtr(remap.temp(release.address));
        },
        is EirSlotAddress address -> {
            return new EirSlotAddress(remap.temp(address.result), address.type,
                remap.slot(address.slot));
        },
        is EirGlobalAddress address -> {
            return new EirGlobalAddress(remap.temp(address.result), address.type, address.symbol,
                address.defines);
        },
        is EirFieldAddress address -> {
            return new EirFieldAddress(remap.temp(address.result), address.type,
                remap.temp(address.base), address.fieldIndex);
        },
        is EirElementAddress address -> {
            return new EirElementAddress(remap.temp(address.result), address.type,
                remap.temp(address.array), remap.temp(address.index));
        },
        is EirLoadPtr load -> {
            return new EirLoadPtr(remap.temp(load.result), load.type, remap.temp(load.address));
        },
        is EirTakePtr taken -> {
            return new EirTakePtr(remap.temp(taken.result), taken.type, remap.temp(taken.address));
        },
        is EirStorePtr store -> {
            return new EirStorePtr(remap.temp(store.address), remap.temp(store.value));
        },
        is EirConstNull constant -> {
            return new EirConstNull(remap.temp(constant.result), constant.type);
        },
        is EirZeroStruct zero -> {
            return new EirZeroStruct(remap.temp(zero.result), zero.type);
        },
        is EirClassNew allocation -> {
            return new EirClassNew(remap.temp(allocation.result), allocation.type,
                allocation.destructorSymbol);
        },
        is EirAbandonConstruction abandoned -> {
            return new EirAbandonConstruction(remap.temp(abandoned.object),
                abandoned.finalizerSymbol);
        },
        is EirObjectFieldAddress address -> {
            return new EirObjectFieldAddress(remap.temp(address.result), address.type,
                remap.temp(address.object), address.fieldIndex);
        },
        is EirClosureNew closure -> {
            return new EirClosureNew(remap.temp(closure.result), closure.type, closure.targetSymbol,
                closure.destructorSymbol, closure.captureTypes);
        },
        is EirClosureCapture capture -> {
            return new EirClosureCapture(remap.temp(capture.result), capture.type,
                remap.temp(capture.closure), capture.captureIndex, capture.captureTypes);
        },
        is EirClosureCall call -> {
            return new EirClosureCall(remap.temp(call.result), call.type, remap.temp(call.closure),
                remap.temps(call.arguments), call.parameterTypes,
                remap.line(call.line, call.inlinedAt), remap.frame(call.inlinedAt));
        },
        is EirWeakStore store -> {
            return new EirWeakStore(remap.temp(store.address), remap.temp(store.value));
        },
        is EirWeakLoad load -> {
            return new EirWeakLoad(remap.temp(load.result), load.type, remap.temp(load.address));
        },
        is EirWeakRelease release -> {
            return new EirWeakRelease(remap.temp(release.address));
        },
        is EirTypeTest test -> {
            return new EirTypeTest(remap.temp(test.result), test.type, remap.temp(test.value),
                test.target);
        },
        is EirCheckedCast cast -> {
            return new EirCheckedCast(remap.temp(cast.result), cast.type, remap.temp(cast.value),
                cast.target);
        },
        is EirDynamicEquals equals -> {
            return new EirDynamicEquals(remap.temp(equals.result), equals.type,
                remap.temp(equals.left), remap.temp(equals.right));
        },
        is EirDynamicHash hash -> {
            return new EirDynamicHash(remap.temp(hash.result), hash.type, remap.temp(hash.value));
        },
        is EirDynamicToString text -> {
            return new EirDynamicToString(remap.temp(text.result), text.type,
                remap.temp(text.value));
        },
        is EirRuntimeTypeName name -> {
            return new EirRuntimeTypeName(remap.temp(name.result), name.type,
                remap.temp(name.value));
        },
        is EirBoundsCheck check -> {
            return new EirBoundsCheck(remap.temp(check.array), remap.temp(check.index),
                check.access, remap.line(check.line, check.inlinedAt),
                remap.frame(check.inlinedAt));
        },
        is EirRangeCheck check -> {
            return new EirRangeCheck(remap.temp(check.start), remap.temp(check.end),
                remap.temp(check.length), check.member, check.subject,
                remap.line(check.line, check.inlinedAt), remap.frame(check.inlinedAt));
        },
        is EirConstString constant -> {
            return new EirConstString(remap.temp(constant.result), constant.type, constant.bytes);
        },
        is EirArrayNew allocation -> {
            return new EirArrayNew(remap.temp(allocation.result), allocation.type,
                remap.temp(allocation.size), allocation.stackLength,
                remap.line(allocation.line, allocation.inlinedAt),
                remap.frame(allocation.inlinedAt));
        },
        is EirArrayLength length -> {
            return new EirArrayLength(remap.temp(length.result), length.type,
                remap.temp(length.array));
        },
        is EirArraySlice slice -> {
            return new EirArraySlice(remap.temp(slice.result), slice.type, remap.temp(slice.array),
                remap.temp(slice.start), remap.temp(slice.end));
        },
        is EirAtomicLoad load -> {
            return new EirAtomicLoad(remap.temp(load.result), load.type, remap.temp(load.address));
        },
        is EirAtomicStore store -> {
            return new EirAtomicStore(remap.temp(store.address), remap.temp(store.value), store.type);
        },
        is EirAtomicCompareSet set -> {
            return new EirAtomicCompareSet(remap.temp(set.result), remap.temp(set.address),
                remap.temp(set.expected), remap.temp(set.replacement), set.type);
        },
        is EirAtomicAdd add -> {
            return new EirAtomicAdd(remap.temp(add.result), add.type, remap.temp(add.address),
                remap.temp(add.amount));
        },
        is EirArrayFreeze freeze -> {
            return new EirArrayFreeze(remap.temp(freeze.result), freeze.type,
                remap.temp(freeze.array));
        },
        is EirStringConcat concat -> {
            return new EirStringConcat(remap.temp(concat.result), concat.type,
                remap.temp(concat.left), remap.temp(concat.right));
        },
        is EirStringEqual equals -> {
            return new EirStringEqual(remap.temp(equals.result), equals.type,
                remap.temp(equals.left), remap.temp(equals.right));
        },
        is EirHashValue hash -> {
            return new EirHashValue(remap.temp(hash.result), hash.type, remap.temp(hash.value));
        },
        is EirWrapOptional wrap -> {
            return new EirWrapOptional(remap.temp(wrap.result), wrap.type, remap.temp(wrap.value));
        },
        is EirAbsentOptional absent -> {
            return new EirAbsentOptional(remap.temp(absent.result), absent.type);
        },
        is EirOptionalPresence presence -> {
            return new EirOptionalPresence(remap.temp(presence.result), presence.type,
                remap.temp(presence.value));
        },
        is EirOptionalPayload payload -> {
            return new EirOptionalPayload(remap.temp(payload.result), payload.type,
                remap.temp(payload.value), payload.read);
        },
        is EirOptionalPayloadAddress address -> {
            return new EirOptionalPayloadAddress(remap.temp(address.result), address.type,
                remap.temp(address.base));
        },
        is EirStringSubstring substring -> {
            return new EirStringSubstring(remap.temp(substring.result), substring.type,
                remap.temp(substring.value), remap.temp(substring.start),
                remap.temp(substring.end));
        },
        is EirStringLength length -> {
            return new EirStringLength(remap.temp(length.result), length.type,
                remap.temp(length.value));
        },
        is EirStringByteAt read -> {
            return new EirStringByteAt(remap.temp(read.result), read.type, remap.temp(read.value),
                remap.temp(read.index), remap.line(read.line, read.inlinedAt),
                remap.frame(read.inlinedAt));
        },
        is EirStringToBytes conversion -> {
            return new EirStringToBytes(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value));
        },
        is EirStringFromBytes conversion -> {
            return new EirStringFromBytes(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.bytes));
        },
        is EirIntToString conversion -> {
            return new EirIntToString(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value), conversion.signed);
        },
        is EirCharToString conversion -> {
            return new EirCharToString(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value));
        },
        is EirBoolToString conversion -> {
            return new EirBoolToString(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value));
        },
        is EirEnumToString conversion -> {
            return new EirEnumToString(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value), conversion.enumType);
        },
        is EirDoubleToString conversion -> {
            return new EirDoubleToString(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value), conversion.single);
        },
        is EirJsonEscape conversion -> {
            return new EirJsonEscape(remap.temp(conversion.result), conversion.type,
                remap.temp(conversion.value));
        },
        is EirForeignCall call -> {
            return new EirForeignCall(remap.temp(call.result), call.type, call.symbol,
                remap.temps(call.arguments), call.parameterTypes, call.outFlags);
        },
        is EirCStringLift lift -> {
            return new EirCStringLift(remap.temp(lift.result), lift.type, remap.temp(lift.handle));
        },
        is EirPanic panic -> {
            return new EirPanic(remap.temp(panic.value), remap.line(panic.line, panic.inlinedAt),
                remap.frame(panic.inlinedAt));
        },
        is EirCaptureTrace captured -> {
            return new EirCaptureTrace(remap.temp(captured.error),
                remap.line(captured.line, captured.inlinedAt), remap.frame(captured.inlinedAt));
        },
        is EirTraceSite site -> {
            return new EirTraceSite(remap.line(site.line, site.inlinedAt),
                remap.frame(site.inlinedAt));
        },
        is EirErrorTrace trace -> {
            return new EirErrorTrace(remap.temp(trace.result), trace.type, remap.temp(trace.error),
                trace.structured);
        },
    }
}

// A terminator other than a return or a propagate, renumbered the same way; those two end the
// inlined function and the inliner replaces them. Null for them.
public copiedTerminator(EirTerminator terminator, InlineRemap remap) -> EirTerminator? {
    switch (terminator) {
        is EirJump jump -> {
            return new EirJump(remap.block(jump.target));
        },
        is EirBranch branch -> {
            return new EirBranch(remap.temp(branch.condition), remap.block(branch.thenTarget),
                remap.block(branch.elseTarget));
        },
        is EirSwitch choice -> {
            return new EirSwitch(remap.temp(choice.value), choice.caseValues,
                remap.blocks(choice.caseTargets), remap.block(choice.defaultTarget));
        },
        is EirUnreachable ignored -> {
            return new EirUnreachable();
        },
        is EirTryCall call -> {
            return new EirTryCall(remap.temp(call.result), call.type, call.callee,
                remap.temp(call.receiver), remap.temps(call.arguments), call.dispatchSlot,
                call.dispatchInterface, remap.temp(call.errorResult),
                remap.block(call.normalTarget), remap.block(call.unwindTarget),
                remap.line(call.line, call.inlinedAt), remap.frame(call.inlinedAt));
        },
        is EirTryClosureCall call -> {
            return new EirTryClosureCall(remap.temp(call.result), call.type,
                remap.temp(call.closure), remap.temps(call.arguments), call.parameterTypes,
                remap.temp(call.errorResult), remap.block(call.normalTarget),
                remap.block(call.unwindTarget), remap.line(call.line, call.inlinedAt),
                remap.frame(call.inlinedAt));
        },
        default -> {
            return null;
        },
    }
}
