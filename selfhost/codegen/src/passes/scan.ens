// The per-function tables the rewriting passes share: which instruction defines each temp, which
// instructions read it, and whether a terminator reads it. Computed fresh per function per pass,
// so nothing is shared across functions or passes.
import EirFunction from eir.model;
import EirInstruction from eir.model;
import eir.walk;
import List from @std.collections.list;

public definitionsOf(EirFunction function) -> EirInstruction?[] {
    let defs = new EirInstruction?[function.tempTypes().length()];
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            long result = walk.resultOf(instructions.get(i));
            if (result >= 0 && result < defs.length) {
                defs[result] = instructions.get(i);
            }
        }
    }
    return defs;
}

public usersOf(EirFunction function) -> List<List<EirInstruction>> {
    let users = new List<List<EirInstruction>>();
    for (long i = 0; i < function.tempTypes().length(); i++) {
        users.push(new List<EirInstruction>());
    }
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            for (let used in walk.usesOf(instructions.get(i))) {
                if (used >= 0 && used < users.length()) {
                    users.get(used).push(instructions.get(i));
                }
            }
        }
    }
    return users;
}

public terminatorUses(EirFunction function) -> bool[] {
    bool[] used = new bool[function.tempTypes().length() + 1];
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let terminator = blocks.get(b).terminator();
        if (terminator == null) {
            continue;
        }
        for (let value in walk.terminatorUsesOf(terminator)) {
            if (value >= 0 && value < used.length) {
                used[value] = true;
            }
        }
    }
    return used;
}

public contains(List<EirInstruction> marked, EirInstruction instruction) -> bool {
    for (long i = 0; i < marked.length(); i++) {
        if (marked.get(i) == instruction) {
            return true;
        }
    }
    return false;
}
