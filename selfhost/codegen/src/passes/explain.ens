// The account a build asks for with '--explain-arc': which of a function's incoming references
// may outlive the call, and how many reference-counting operations each pass took out. It is text
// handed back with the function, so explaining a build changes nothing about how it runs.
import EirFunction from eir.model;
import EirInstruction from eir.model;
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import EirWeakRelease from eir.model;
import FunctionFacts from passes.facts;
import List from @std.collections.list;

// How many reference-counting operations a function performs: the retains and releases that move
// the count a value owns, those that move the count storage holds, and the weak releases. The
// difference across a pass is what that pass elided.
public referenceOperations(EirFunction function) -> long {
    long count = 0;
    let blocks = function.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            if (isReferenceOperation(instructions.get(i))) {
                count++;
            }
        }
    }
    return count;
}

isReferenceOperation(EirInstruction instruction) -> bool {
    return instruction is EirRetain || instruction is EirRelease
        || instruction is EirRetainPtr || instruction is EirReleasePtr
        || instruction is EirWeakRelease;
}

// What the whole-program prepass concluded about the references arriving at a function, one line
// per position, or nothing when every one of them is an ordinary borrow. A method's position 0 is
// its receiver.
public incomingLines(EirFunction function, FunctionFacts? facts) -> string[] {
    let lines = new List<string>();
    if (facts == null) {
        return lines.toArray();
    }
    bool hasReceiver = function.receiverType() != null;
    for (long i = 0; i < facts.positionCount(); i++) {
        let position = facts.at(i);
        if (!position.escapes() && !position.mutates()) {
            continue;
        }
        string named = positionName(i, hasReceiver);
        string described = describe(position.escapes(), position.mutates());
        lines.push("  " + named + " " + described);
    }
    return lines.toArray();
}

positionName(long position, bool hasReceiver) -> string {
    if (hasReceiver) {
        if (position == 0) {
            return "the receiver";
        }
        return "parameter {position - 1}";
    }
    return "parameter {position}";
}

describe(bool escapes, bool mutates) -> string {
    if (escapes && mutates) {
        return "may outlive the call and its storage may be written, so it is kept alive";
    }
    if (escapes) {
        return "may outlive the call, so it is kept alive";
    }
    return "has its storage written, so it is passed by address";
}

// What one pass did to a function's reference counting, or "" when it changed nothing.
public elisionLine(string passName, long before, long after) -> string {
    long removed = before - after;
    if (removed <= 0) {
        return "";
    }
    if (removed == 1) {
        return "  {passName} elided 1 reference operation";
    }
    return "  {passName} elided {removed} reference operations";
}
