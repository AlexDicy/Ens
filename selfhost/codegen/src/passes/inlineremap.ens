// How the numbering of an inlined function maps into the function it is inlined into. Each temp,
// slot and block of the inlined function has a number of its own there, and each site a trace can
// stop at keeps its line and frame or takes the call's, depending on whether a trace prints the
// inlined function.
public final class InlineRemap {
    long[] tempMap;
    long slotBase;
    long blockBase;
    long frameBase;
    long ownFrame;
    long callLine;
    bool traced;

    // 'ownFrame' is the frame the inlined function's own sites are in: the frame added for it when a
    // trace prints it, or the call's own frame when it does not. 'callLine' is the line of the call.
    public constructor(this.tempMap, this.slotBase, this.blockBase, this.frameBase, this.ownFrame,
                this.callLine, this.traced);

    public temp(long temp) -> long {
        if (temp < 0) {
            return temp;
        }
        return this.tempMap[temp];
    }

    public temps(long[] temps) -> long[] {
        long[] mapped = new long[temps.length];
        for (long i = 0; i < temps.length; i++) {
            mapped[i] = this.temp(temps[i]);
        }
        return mapped;
    }

    public slot(long slot) -> long {
        return this.slotBase + slot;
    }

    public block(long block) -> long {
        return this.blockBase + block;
    }

    public blocks(long[] blocks) -> long[] {
        long[] mapped = new long[blocks.length];
        for (long i = 0; i < blocks.length; i++) {
            mapped[i] = this.block(blocks[i]);
        }
        return mapped;
    }

    // The line a copied site carries. A site of a function no trace prints shows as the call that
    // reached it, so it takes the call's line, and every other site keeps its own.
    public line(long line, long inlinedAt) -> long {
        if (this.traced || inlinedAt >= 0 || line < 0) {
            return line;
        }
        return this.callLine;
    }

    public frame(long inlinedAt) -> long {
        if (inlinedAt >= 0) {
            return this.frameBase + inlinedAt;
        }
        return this.ownFrame;
    }
}
