// Escape analysis, the read-only prepass of the optimization pipeline. It iterates the
// per-function scans to a fixpoint, so a fact established in a callee sharpens every caller. The
// call graph is complete after monomorphization, so the fixpoint starts optimistic. A scan reads
// only the facts of the functions its direct calls name, so a function is scanned again only when
// one of those changed. Facts only ever turn true, so the order of the scans cannot change them.
import EirFunction from eir.model;
import EirCall from eir.model;
import EirTryCall from eir.model;
import Type from @ens.sema.model.types;
import DescriptorPlans from layout.descriptors;
import FunctionFacts from passes.facts;
import ProgramFacts from passes.facts;
import RootFacts from passes.roots;
import eir.place;
import passes.roots;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;

// The facts of the whole lowered program.
public analyze(List<EirFunction> functions, DescriptorPlans plans) -> ProgramFacts {
    let facts = new ProgramFacts(plans);
    for (long i = 0; i < functions.length(); i++) {
        facts.add(new FunctionFacts(functions.get(i)));
    }
    let callers = directCallers(functions);
    bool[] queued = new bool[functions.length()];
    let pending = new List<long>();
    for (long i = functions.length() - 1; i >= 0; i--) {
        pending.push(i);
        queued[i] = true;
    }
    while (!pending.isEmpty()) {
        long next = pending.pop();
        queued[next] = false;
        let function = functions.get(next);
        if (!analyzeFunction(function, facts)) {
            continue;
        }
        let affected = callers.get(function.symbol());
        if (affected == null) {
            continue;
        }
        for (let caller in affected) {
            if (!queued[caller]) {
                queued[caller] = true;
                pending.push(caller);
            }
        }
    }
    return facts;
}

// The indexes of the functions that call each symbol directly.
directCallers(List<EirFunction> functions) -> Map<string, List<long>> {
    let callers = new Map<string, List<long>>();
    for (long i = 0; i < functions.length(); i++) {
        for (let block in functions.get(i).blocks()) {
            for (let instruction in block.instructions()) {
                if (instruction is EirCall && instruction.dispatchSlot < 0) {
                    addCaller(callers, instruction.callee.symbol(), i);
                }
            }
            let terminator = block.terminator();
            if (terminator is EirTryCall && terminator.dispatchSlot < 0) {
                addCaller(callers, terminator.callee.symbol(), i);
            }
        }
    }
    return callers;
}

addCaller(Map<string, List<long>> callers, string callee, long caller) {
    let known = callers.get(callee);
    if (known == null) {
        let listed = new List<long>();
        listed.push(caller);
        callers.set(callee, listed);
        return;
    }
    if (known.last() != caller) {
        known.push(caller);
    }
}

// Rescans one function's positions; true when a fact changed. Positions whose type carries no
// references are skipped: nothing behind an int can escape or dangle.
analyzeFunction(EirFunction function, ProgramFacts facts) -> bool {
    let own = facts.factsFor(function.symbol());
    if (own == null) {
        return false;
    }
    let places = place.addressPlaces(function);
    bool changed = false;
    for (long position = 0; position < own.positionCount(); position++) {
        if (!primitives.hasArcContent(positionType(function, position))) {
            continue;
        }
        let seen = roots.analyzePosition(function, places, facts, position);
        let recorded = own.at(position);
        if (seen.escapes() && recorded.markEscapes()) {
            changed = true;
        }
        bool mutated = seen.writesStorage() || reassigned(function, facts, position, seen);
        if (mutated && recorded.markMutates()) {
            changed = true;
        }
    }
    return changed;
}

positionType(EirFunction function, long position) -> Type {
    let receiverType = function.receiverType();
    if (receiverType != null) {
        if (position == 0) {
            return receiverType;
        }
        return function.parameters()[position - 1].type();
    }
    return function.parameters()[position].type();
}

// A position bound to a slot counts as mutated when anything beyond the entry binding stores
// that slot whole: replacing a parameter wholesale writes the storage a caller would share just
// as writing one of its fields does.
reassigned(EirFunction function, ProgramFacts facts, long position, RootFacts seen) -> bool {
    let own = facts.factsFor(function.symbol());
    if (own == null || own.slotOf(position) < 0) {
        return false;
    }
    return seen.slotStores() > 1;
}
