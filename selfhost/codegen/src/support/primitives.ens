// Primitive-type predicates over the sema type model, shared by lowering, verification, and
// emission. Signedness here is the machine reading: byte, ushort, uint, ulong, and char are
// unsigned; short, int, and long are signed.
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;

public isIntegerType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Byte, Short, UShort, Int, UInt, Long, ULong, Char -> true,
            default -> false,
        };
    }
    return false;
}

public isFloatType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Float, Double -> true,
            default -> false,
        };
    }
    return false;
}

public isNumericType(Type type) -> bool {
    return isIntegerType(type) || isFloatType(type);
}

public isBoolType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Bool;
    }
    return false;
}

public isSignedType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Short, Int, Long -> true,
            default -> false,
        };
    }
    return false;
}

// The value width in bits, or 0 for non-primitive types.
public bitWidth(Type type) -> long {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Bool -> 1,
            Byte -> 8,
            Short, UShort -> 16,
            Int, UInt, Char, Float -> 32,
            Long, ULong, Double -> 64,
            default -> 0,
        };
    }
    return 0;
}
