// Type-shape predicates over the sema type model, shared by lowering, verification, and
// emission. Signedness here is the machine reading: byte, ushort, uint, ulong, and char are
// unsigned; short, int, and long are signed.
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import StringType from @ens.sema.model.types;
import ArrayType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import EnumType from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import DeclaredType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import NullType from @ens.sema.model.types;
import ExternalType from @ens.sema.model.types;
import FunctionType from @ens.sema.model.types;
import Parameter from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import @ens.sema.model.types;

public isIntegerType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Byte, Short, UShort, Int, UInt, Long, ULong, Char -> true,
            default -> false,
        };
    }
    return false;
}

public isFloatType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Float, Double -> true,
            default -> false,
        };
    }
    return false;
}

public isNumericType(Type type) -> bool {
    return isIntegerType(type) || isFloatType(type);
}

public isBoolType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Bool;
    }
    return false;
}

public isCharType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Char;
    }
    return false;
}

public isSignedType(Type type) -> bool {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Short, Int, Long -> true,
            default -> false,
        };
    }
    // An enum's values are signed integers, negative member values included.
    return type is EnumType;
}

// The value width in bits, or 0 for types without a machine width. A numeric enum is backed by
// 64 bits so wide assigned values survive; a plain one numbers its members in 32.
public bitWidth(Type type) -> long {
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Bool -> 1,
            Byte -> 8,
            Short, UShort -> 16,
            Int, UInt, Char, Float -> 32,
            Long, ULong, Double -> 64,
            default -> 0,
        };
    }
    if (type is EnumType) {
        return type.isNumeric() ? 64 : 32;
    }
    return 0;
}

public isStringType(Type type) -> bool {
    return type is StringType;
}

// The type whose machine shape a value of this type has. One optional level over a non-optional
// type shares that type's shape, because the absence lives in the value itself: a nullable
// reference is the same pointer and a nullable handle the same word. A second level does not,
// because an optional over an optional is a tagged pair whatever it wraps, so the walk stops
// there and every query below answers 'not that shape'.
shapeOf(Type type) -> Type {
    if (type is OptionalType && !(type.inner() is OptionalType)) {
        return type.inner();
    }
    return type;
}

// The string a value of this type holds, or null for anything else.
public stringOf(Type type) -> StringType? {
    let shape = shapeOf(type);
    if (shape is StringType) {
        return shape;
    }
    return null;
}

public isArrayType(Type type) -> bool {
    return type is ArrayType;
}

// The array a value of this type holds, or null for anything else.
public arrayOf(Type type) -> ArrayType? {
    let shape = shapeOf(type);
    if (shape is ArrayType) {
        return shape;
    }
    return null;
}

// The class a value of this type names - a declared class or an instantiation of a generic one -
// or null for anything else. The result is always class-shaped: query it through the sema
// accessors (fieldsOf, methodsOf, baseOf, interfacesOf).
public classOf(Type type) -> Type? {
    let shape = shapeOf(type);
    if (shape is ClassType) {
        return shape;
    }
    if (shape is InstantiationType && shape.template() is ClassType) {
        return shape;
    }
    return null;
}

public isClassType(Type type) -> bool {
    return classOf(type) != null;
}

// The interface a value of this type names - declared or an instantiation of a generic one - or
// null for anything else.
public interfaceOf(Type type) -> Type? {
    let shape = shapeOf(type);
    if (shape is InterfaceType) {
        return shape;
    }
    if (shape is InstantiationType && shape.template() is InterfaceType) {
        return shape;
    }
    return null;
}

// The function a value of this type is, or null for anything else. A function value is one
// pointer at a closure object: its captures sit in that object, and the code to run is the
// pointer the object's first word holds.
public functionOf(Type type) -> FunctionType? {
    let shape = shapeOf(type);
    if (shape is FunctionType) {
        return shape;
    }
    return null;
}

// The struct a value of this type is - a declared struct or an instantiation of a generic one -
// or null for anything else.
public structOf(Type type) -> Type? {
    if (type is StructType) {
        return type;
    }
    if (type is InstantiationType && type.template() is StructType) {
        return type;
    }
    return null;
}

// The name a record-shaped type reads as in a diagnostic or symbol description.
public recordName(Type type) -> string {
    return types.display(type);
}

// True for the types runtime type identity works over: a class or an interface, possibly nullable.
// Both are the same object pointer, so converting between related ones moves no bits.
public isClassLike(Type type) -> bool {
    return classOf(type) != null || interfaceOf(type) != null;
}

public isNullType(Type type) -> bool {
    return type is NullType;
}

// True when a value of this type may be absent, which for a reference means it may be null.
public isOptionalType(Type type) -> bool {
    return type is OptionalType;
}

// How many optional levels wrap the type: 0 for a plain type, 2 for 'string??'.
public optionalDepth(Type type) -> long {
    long depth = 0;
    Type current = type;
    while (current is OptionalType) {
        depth++;
        current = current.inner();
    }
    return depth;
}

public isStructType(Type type) -> bool {
    return structOf(type) != null;
}

public isEnumType(Type type) -> bool {
    return type is EnumType;
}

// The integer forms a switch scrutinee or an integer constant may take: the machine integers
// plus enums, whose values are their members' assigned or ordinal numbers.
public isIntegerLike(Type type) -> bool {
    return isIntegerType(type) || isEnumType(type);
}

// The referent a value of this type points at, or null when the type is not pointer-shaped. The
// null literal's own type answers itself: it is a reference that is always absent, so retaining
// or releasing it is a runtime no-op and lowering needs no special case.
public referenceOf(Type type) -> Type? {
    let shape = shapeOf(type);
    if (shape is StringType || shape is ArrayType || shape is ClassType
            || shape is InterfaceType || shape is NullType || shape is FunctionType) {
        return shape;
    }
    if (shape is InstantiationType && !(shape.template() is StructType)) {
        return shape;
    }
    return null;
}

// True for the refcounted reference types a value temp can own a +1 of.
public isReferenceType(Type type) -> bool {
    return referenceOf(type) != null;
}

// The foreign handle a value of this type carries, or null when the type is not an external one.
// A handle is a raw pointer with null for absent, so it shares the references' machine shape
// while reference counting never touches it.
public externalOf(Type type) -> Type? {
    let shape = shapeOf(type);
    if (shape is ExternalType) {
        return shape;
    }
    return null;
}

// True when a value of the first type reaches the second with no machine operation, because both
// name the same referent: narrowing an optional away, widening into one, the null literal reaching
// a nullable reference or handle, or a class-like value reaching another class-like spelling. An
// object is prefix-compatible with its base and carries the same pointer under an interface, and
// sema admits only the related conversions, so every class-like pair is a rename.
public sameReferent(Type first, Type second) -> bool {
    let left = pointerReferentOf(first);
    let right = pointerReferentOf(second);
    if (left == null || right == null) {
        return false;
    }
    if (left is NullType || right is NullType) {
        return true;
    }
    if (left == right) {
        return true;
    }
    return isClassLike(left) && isClassLike(right);
}

// What a pointer-shaped value points at: a reference's referent or an external handle's type.
pointerReferentOf(Type type) -> Type? {
    let referent = referenceOf(type);
    if (referent != null) {
        return referent;
    }
    return externalOf(type);
}

// The types code generation can represent: the machine primitives, enums, strings, arrays whose
// elements it can represent, structs whose fields it can, class and interface references, and an
// optional of anything it can represent, carried as the same pointer or as a tagged pair.
// Decimal has no machine mapping.
//
// A class stops the walk at its reference: whether its own fields can be laid out is
// isRepresentableClass's question, asked where an object is built or reached into rather than
// wherever a reference to it travels, which is also what keeps a class holding itself from
// recursing forever here. Its base chain and implemented interfaces do have to be plain declared
// types, because a generic ancestor's layout and tables wait for monomorphization, and its type
// arguments have to be shapes it can hold, judged the way representableArgument judges them.
public isRepresentable(Type type) -> bool {
    if (isNumericType(type) || isBoolType(type) || isEnumType(type) || isStringType(type)
            || isNullType(type)) {
        return true;
    }
    if (type is ExternalType) {
        return true;
    }
    if (type is OptionalType) {
        return isRepresentable(type.inner());
    }
    if (type is ClassType) {
        if (type.isGeneric()) {
            return false;
        }
        return representableChain(type);
    }
    if (type is InterfaceType) {
        return !type.isGeneric();
    }
    if (type is ArrayType) {
        return isRepresentable(type.element());
    }
    // A function value carries its parameters and its result across the call, so every one of
    // those shapes has to be representable; 'void' is a legal result there and nowhere else.
    if (type is FunctionType) {
        for (let parameter in type.parameterTypes()) {
            if (!isRepresentable(parameter)) {
                return false;
            }
        }
        Type returned = type.returnType();
        return types.isVoidType(returned) || isRepresentable(returned);
    }
    if (type is StructType) {
        if (type.isGeneric()) {
            return false;
        }
        return representableFields(type);
    }
    if (type is InstantiationType) {
        for (let argument in type.arguments()) {
            if (!representableArgument(argument)) {
                return false;
            }
        }
        let template = type.template();
        if (template is InterfaceType) {
            return true;
        }
        if (template is ClassType) {
            return representableChain(type);
        }
        if (template is StructType) {
            return representableFields(type);
        }
        return false;
    }
    return false;
}

// The shape a type argument has to carry, read off the way the argument is written: its own type
// arguments, an array's element, an optional's inner. The walk stops at a name rather than follow
// what that name was declared to hold, exactly as a reference stops the walk above, and for the
// same reason: a class that conforms at its own type ('class Node implements Eq<Node>') names
// itself among its interface's arguments, so following the name arrives back at that conformance.
representableArgument(Type type) -> bool {
    if (type is OptionalType) {
        return representableArgument(type.inner());
    }
    if (type is ArrayType) {
        return representableArgument(type.element());
    }
    if (type is InstantiationType) {
        for (let argument in type.arguments()) {
            if (!representableArgument(argument)) {
                return false;
            }
        }
        return true;
    }
    if (type is DeclaredType) {
        return !type.isGeneric();
    }
    return isRepresentable(type);
}

// True when the type's own implemented interfaces and base chain are shapes code generation can
// dispatch over. A class stops the walk at its reference; only the chain is examined here.
representableChain(Type type) -> bool {
    for (let implemented in types.interfacesOf(type)) {
        if (interfaceOf(implemented) == null || !isRepresentable(implemented)) {
            return false;
        }
    }
    let base = types.baseOf(type);
    if (base == null) {
        return true;
    }
    return classOf(base) != null && isRepresentable(base);
}

representableFields(Type type) -> bool {
    let fields = types.fieldsOf(type);
    if (fields == null) {
        return false;
    }
    for (long i = 0; i < fields.length(); i++) {
        if (fields.get(i).isWeak() || !isRepresentable(fields.get(i).type())) {
            return false;
        }
    }
    return true;
}

// True when a class's own payload can be laid out: every field is a type code generation
// represents, and every weak field watches a class reference, which is the only thing a side-table
// entry can point at. The class may be declared or an instantiation of a generic one.
public isRepresentableClass(Type classType) -> bool {
    if (classOf(classType) == null || !isRepresentable(classType)) {
        return false;
    }
    let fields = types.fieldsOf(classType);
    if (fields == null) {
        return false;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (!isRepresentable(field.type())) {
            return false;
        }
        if (field.isWeak() && classOf(field.type()) == null) {
            return false;
        }
    }
    return true;
}

// True when two signatures take exactly the same parameter types, which together with the name
// identifies one method along a class chain: an override must repeat its base method's parameter
// list, and overloads differ in it. Types are interned, so equality is reference identity.
public sameParameterTypes(Signature first, Signature second) -> bool {
    let left = first.parameters();
    let right = second.parameters();
    if (left.length != right.length) {
        return false;
    }
    for (long i = 0; i < left.length; i++) {
        if (left[i].type() != right[i].type()) {
            return false;
        }
    }
    return true;
}

// The payload type when the type is a tagged optional - an optional over a value type, carried
// as a {present, payload} pair - or null for everything else. A reference optional and an
// optional handle are the same pointer with null for absent, so neither carries a tag.
public taggedPayloadOf(Type type) -> Type? {
    if (type is OptionalType && !isReferenceType(type) && externalOf(type) == null) {
        return type.inner();
    }
    return null;
}

// True when copying a value of this type moves reference ownership: a reference itself, a
// struct holding one anywhere inside, or a tagged optional whose payload does.
public hasArcContent(Type type) -> bool {
    if (isReferenceType(type)) {
        return true;
    }
    let payload = taggedPayloadOf(type);
    if (payload != null) {
        return hasArcContent(payload);
    }
    let struck = structOf(type);
    if (struck != null) {
        let fields = types.fieldsOf(struck);
        if (fields == null) {
            return false;
        }
        for (long i = 0; i < fields.length(); i++) {
            if (hasArcContent(fields.get(i).type())) {
                return true;
            }
        }
    }
    return false;
}
