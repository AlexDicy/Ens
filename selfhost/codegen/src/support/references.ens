// The one walk over the references a value holds: a reference itself, each field of a struct that
// holds any, and a tagged optional's payload only while its tag marks it present. Lowering walks
// storage by address, emission walks storage or a value, each through its own walker.
import @ens.sema.model.typemembers;
import Type from @ens.sema.model.types;
import support.primitives;

// What a walk does at each step, over the places it names a reference or an aggregate by.
public interface ReferenceWalker<P> {
    // Visits the reference at a place.
    reference(P place);

    // The place of field `index` of the struct at a place.
    field(P record, Type recordType, long index, Type fieldType) -> P;

    // The place of the payload of the optional at a place. What the walk visits from here until
    // endPayload applies only while the optional is present.
    payload(P pair, Type optionalType, Type payloadType) -> P;

    endPayload();
}

// Walks every reference the value at a place holds.
public walk<P>(ReferenceWalker<P> walker, P place, Type type) {
    if (primitives.isReferenceType(type)) {
        walker.reference(place);
        return;
    }
    let payload = primitives.taggedPayloadOf(type);
    if (payload != null) {
        if (!primitives.hasArcContent(payload)) {
            return;
        }
        let inner = walker.payload(place, type, payload);
        walk<P>(walker, inner, payload);
        walker.endPayload();
        return;
    }
    if (primitives.structOf(type) == null) {
        return;
    }
    let fields = typemembers.fieldsOf(type);
    if (fields == null) {
        return;
    }
    for (long i = 0; i < fields.length(); i++) {
        let fieldType = fields.get(i).type();
        if (primitives.hasArcContent(fieldType)) {
            walk<P>(walker, walker.field(place, type, i, fieldType), fieldType);
        }
    }
}
