// The state emission threads through its area modules. A ModuleEmitter belongs to one Ens module:
// it owns the LLVM context, module and builder, the runtime primitives, the type mapping, the
// element finalizers and the type descriptors, and it remembers the value and callable type of
// every function the module declares. An EmissionFrame belongs to one function inside it: the
// LLVM value each temp holds, the alloca each slot lives in, and the basic block each EIR block
// became.
//
// Neither one decides anything - the shape was fixed by lowering and the layout stage - so the
// areas read this state, build instructions from it, and record what they produced.
import EirFunction from eir.model;
import Type from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import Context from @ens.llvm.core;
import Module from @ens.llvm.core;
import Builder from @ens.llvm.core;
import @ens.llvm.core;
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import BasicBlock from @ens.llvm.blocks;
import TargetData from @ens.llvm.target;
import DescriptorPlans from layout.descriptors;
import Runtime from emit.runtime;
import TypeMapper from emit.types;
import Finalizers from emit.finalizers;
import Descriptors from emit.descriptors;
import TraceTables from emit.traces;
import List from @std.collections.list;
import Map from @std.collections.map;

public final class ModuleEmitter {
    string moduleName;

    public Context context;
    public Module module;
    public Builder builder;

    public Runtime runtime;
    TypeMapper mapper;
    public Finalizers finalizers;
    public Descriptors descriptors;
    public TraceTables traces;

    Map<string, Value> functionValues;
    Map<string, TypeRef> functionTypes;
    TargetData? moduleLayout;
    Type? stackFrameClass;
    Type? errorClass;

    public constructor(string moduleName, DescriptorPlans plans) {
        this.moduleName = moduleName;
        this.context = core.createContext();
        this.module = this.context.createModule(moduleName);
        this.builder = this.context.createBuilder();
        this.runtime = new Runtime(this.context, this.module, this.builder);
        this.mapper = new TypeMapper(this.context);
        this.finalizers = new Finalizers(this.runtime, this.mapper);
        this.descriptors = new Descriptors(this.runtime, plans);
        this.traces = new TraceTables();
        this.functionValues = new Map<string, Value>();
        this.functionTypes = new Map<string, TypeRef>();
        this.moduleLayout = null;
        this.stackFrameClass = null;
        this.errorClass = null;
    }

    public name() -> string {
        return this.moduleName;
    }

    // The standard library's StackFrame class, which the trace runtime builds instances of; only
    // the module defining that runtime needs it.
    public rememberStackFrameType(Type? type) {
        this.stackFrameClass = type;
    }

    public stackFrameType() -> Type? {
        return this.stackFrameClass;
    }

    // The standard library's Error class, whose payload the entry wrapper reads to report an
    // uncaught exception; only the module defining that wrapper needs it.
    public rememberErrorType(Type? type) {
        this.errorClass = type;
    }

    public errorType() -> Type? {
        return this.errorClass;
    }

    public mapType(Type type) -> TypeRef {
        return this.mapper.map(type);
    }

    // The payload layout of a class, declared or instantiated, for a field address or an
    // allocation's size.
    public classLayout(Type classType) -> TypeRef {
        return this.mapper.classLayout(classType);
    }

    // The destructor an allocation stores in its object header. It lives in the module that
    // declares the class, so a module that only creates instances declares it here.
    public objectDestructor(string symbol) -> Value {
        let known = this.functionValues.get(symbol);
        if (known != null) {
            return known;
        }
        let type = this.context.voidType().functionType([this.context.pointerType()]);
        let declared = this.module.addFunction(symbol, type);
        this.defineFunction(symbol, declared, type);
        return declared;
    }

    // A constant diagnostic message, as the string object the runtime guards expect.
    public message(string text) -> Value {
        return this.runtime.stringLiteral(text.toBytes());
    }

    // Records a function this module defines or declares, with the type a call to it needs.
    public defineFunction(string symbol, Value function, TypeRef type) {
        this.functionValues.set(symbol, function);
        this.functionTypes.set(symbol, type);
    }

    public functionValue(string symbol) -> Value? {
        return this.functionValues.get(symbol);
    }

    public calleeType(string symbol) -> TypeRef {
        let found = this.functionTypes.get(symbol);
        if (found == null) {
            panic("Internal: no function type recorded for '{symbol}'");
        }
        return found;
    }

    public rememberDataLayout(TargetData layout) {
        this.moduleLayout = layout;
    }

    public dataLayout() -> TargetData {
        let layout = this.moduleLayout;
        if (layout == null) {
            panic("Internal: the module's data layout was not recorded before emission");
        }
        return layout;
    }

    public dispose() {
        this.builder.dispose();
        this.context.dispose();
    }
}

public final class EmissionFrame {
    EirFunction emittedFunction;
    Value declaredValue;
    Value?[] tempValues;
    Value?[] slotStorage;
    List<BasicBlock> basicBlocks;
    Value? scratchErrorSlot;

    public constructor(EirFunction function, Value declared, List<BasicBlock> blocks) {
        this.emittedFunction = function;
        this.declaredValue = declared;
        this.tempValues = new Value?[function.tempTypes().length()];
        this.slotStorage = new Value?[function.slots().length()];
        this.basicBlocks = blocks;
        this.scratchErrorSlot = null;
    }

    public symbol() -> string {
        return this.emittedFunction.symbol();
    }

    public function() -> EirFunction {
        return this.emittedFunction;
    }

    // The LLVM function the body is being emitted into.
    public declared() -> Value {
        return this.declaredValue;
    }

    // The alloca every throwing call in this function passes as the callee's error slot: null
    // before each call, written by a callee that throws, read and cleared by the check after.
    public defineErrorScratch(Value storage) {
        this.scratchErrorSlot = storage;
    }

    public errorScratch() -> Value? {
        return this.scratchErrorSlot;
    }

    public tempType(long temp) -> Type {
        return this.emittedFunction.tempTypes().get(temp);
    }

    // Emission runs after the verifier proved def-before-use, so a missing temp is a bug.
    public value(long temp) -> Value {
        let held = this.tempValues[temp];
        if (held == null) {
            panic("Internal: temp %{temp} was used before it was emitted");
        }
        return held;
    }

    public define(long temp, Value produced) {
        this.tempValues[temp] = produced;
    }

    // The alloca a slot lives in, or null when the function never allocated one.
    public slotAt(long slot) -> Value? {
        return this.slotStorage[slot];
    }

    public defineSlot(long slot, Value storage) {
        this.slotStorage[slot] = storage;
    }

    public blockAt(long block) -> BasicBlock {
        return this.basicBlocks.get(block);
    }
}
