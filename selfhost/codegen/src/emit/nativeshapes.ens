// Where a target's system structures hold the fields a file bridge reads, and what a target names
// its entry points. Every answer follows from the target triple alone.

// The kind a file bridge answers with. Zero says the enumeration did not report one, which is also
// what an output a failed call left untouched holds.
public final class FileKind {
    public static const long unknown = 0;
    public static const long file = 1;
    public static const long directory = 2;
    public static const long symbolicLink = 3;
    public static const long other = 4;
}

// What a bridge is asked to open a path for.
public final class OpenMode {
    public static const long read = 0;
    public static const long writeTruncated = 1;
    public static const long appended = 2;
    public static const long createdNew = 3;
}

// The mode-word bits naming a file's type, which every POSIX system spells the same way.
public final class FileMode {
    public static const long typeMask = 0xF000;
    public static const long regular = 0x8000;
    public static const long directory = 0x4000;
    public static const long symbolicLink = 0xA000;
}

// The 'struct statx' a Linux metadata answer arrives in, which the kernel lays out identically on
// every architecture. A field the answer's mask does not claim was never filled in.
public final class Statx {
    public static const long currentDirectory = -100;
    public static const long noFollowFlag = 0x100;

    // AT_EMPTY_PATH, which asks about the descriptor itself rather than about a path under it.
    public static const long emptyPathFlag = 0x1000;

    public static const long typeRequest = 0x1;
    public static const long modifiedRequest = 0x40;
    public static const long sizeRequest = 0x200;

    public static const long maskOffset = 0;
    public static const long modeOffset = 28;
    public static const long sizeOffset = 40;
    public static const long secondsOffset = 112;
    public static const long nanosecondsOffset = 120;
    public static const long structBytes = 256;

    // STATX_MODE claims the permission bits, which STATX_TYPE leaves out.
    public static const long permissionsRequest = 0x2;

    // What a caller sees where no statx exists to ask, which is what a kernel too old to carry it
    // reports as well.
    public static const long unsupportedError = 38;

    // What a caller sees where statx answered without a field that was asked for.
    public static const long incompleteError = 5;
}

// The 'struct stat' a Darwin metadata answer arrives in, whose mode is sixteen bits wide.
public final class DarwinStat {
    public static const long modeOffset = 4;
    public static const long sizeOffset = 96;
    public static const long secondsOffset = 48;
    public static const long nanosecondsOffset = 56;
    public static const long structBytes = 144;
}

// The number the statx system call carries on the target's architecture. An architecture with no
// number here has no statx to reach, and asking under another architecture's number would run an
// unrelated call.
public statxSystemCall(string targetTriple) -> long {
    if (targetTriple.contains("x86_64")) {
        return 332;
    }
    if (targetTriple.contains("aarch64") || targetTriple.contains("riscv64")) {
        return 291;
    }
    return 0;
}

// What a copy hands over, and what a creation asks for before the umask reduces it. A file asks for
// no executable bit and a directory asks for every entry bit, which is the convention every C
// library creates under.
public final class FilePermissions {
    // The nine permission bits and nothing above them, so no copy hands over a set-user-id,
    // set-group-id or sticky bit.
    public static const long copied = 0x1FF;

    public static const long createdFile = 0x1B6;
    public static const long createdDirectory = 0x1FF;
}

// The no-replace rename each system offers under its own flag, and the flag Windows needs to
// replace instead.
public final class Rename {
    public static const long linuxNoReplace = 0x1;
    public static const long darwinExclusive = 0x4;
    public static const long windowsReplace = 0x1;

    // What a checked fallback answers where the destination is taken, which is what the no-replace
    // rename reports itself.
    public static const long destinationExists = 17;
}

// What a system reports where its no-replace rename exists but the file system will not carry the
// request out, which is what sends a bridge to its checked fallback.
public final class RenameRefusal {
    public static const long invalidRequest = 22;
    public static const long linuxNoSystemCall = 38;
    public static const long linuxNotSupported = 95;
    public static const long darwinNotSupported = 45;
    public static const long darwinNoSystemCall = 78;
}

public unsupportedRenameErrors(string targetTriple) -> long[] {
    if (onDarwinTriple(targetTriple)) {
        return [RenameRefusal.invalidRequest, RenameRefusal.darwinNotSupported,
            RenameRefusal.darwinNoSystemCall];
    }
    return [RenameRefusal.invalidRequest, RenameRefusal.linuxNoSystemCall,
        RenameRefusal.linuxNotSupported];
}

// The number the renameat2 system call carries on the target's architecture. An architecture with
// no number here has no no-replace rename to reach, and the bridge falls back to reading the
// destination first.
public renameSystemCall(string targetTriple) -> long {
    if (targetTriple.contains("x86_64")) {
        return 316;
    }
    if (targetTriple.contains("aarch64") || targetTriple.contains("riscv64")) {
        return 276;
    }
    return 0;
}

// The flags an open takes, which every system spells with values of its own. Every mode carries
// closeOnExec, so a descriptor this process opens never reaches a child it starts.
public final class OpenFlags {
    public const long readOnly;
    public const long writeOnly;
    public const long create;
    public const long exclusive;
    public const long truncate;
    public const long append;
    public const long closeOnExec;

    public constructor(this.readOnly, this.writeOnly, this.create, this.exclusive,
                       this.truncate, this.append, this.closeOnExec);
}

public openFlags(string targetTriple) -> OpenFlags {
    if (onDarwinTriple(targetTriple)) {
        return new OpenFlags(readOnly: 0, writeOnly: 1, create: 0x200, exclusive: 0x800,
            truncate: 0x400, append: 0x8, closeOnExec: 0x1000000);
    }
    return new OpenFlags(readOnly: 0, writeOnly: 1, create: 0x40, exclusive: 0x80,
        truncate: 0x200, append: 0x400, closeOnExec: 0x80000);
}

// The kinds a POSIX directory entry reports in its d_type, which Linux and Darwin number alike. An
// entry a file system cannot classify reports DT_UNKNOWN.
public final class DirentKind {
    public static const long unknown = 0;
    public static const long directory = 4;
    public static const long regular = 8;
    public static const long symbolicLink = 10;
}

// Where a 'struct dirent' holds the entry's name. Every record is padded to an eight-byte multiple,
// so the three characters a dot-entry test reads stay inside the record even for the shortest name.
public direntNameOffset(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 21;
    }
    return 19;
}

// Where a 'struct dirent' holds the entry's kind, one byte ahead of its name.
public direntKindOffset(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 20;
    }
    return 18;
}

// The name a directory or file entry point links under. On Darwin the form carrying a 64-bit inode
// is the plain name on arm64, and the '$INODE64' name on x86_64 where the plain name still reaches
// the smaller, older record.
public entryPointName(string targetTriple, string name) -> string {
    if (onDarwinTriple(targetTriple) && targetTriple.contains("x86_64")) {
        return name + "$INODE64";
    }
    return name;
}

// What a start is asked to do with one of the child's three standard streams. Inherit is zero, so a
// request left untouched inherits everything.
public final class StdioMode {
    public static const long inherit = 0;
    public static const long pipe = 1;
}

// The output streams a read names, numbered as the descriptors the child writes them to.
public final class ChildStream {
    public static const long output = 1;
    public static const long errors = 2;
}

// The signals the process bridges send and ignore, numbered alike on Linux and Darwin, and the
// disposition that ignores one.
public final class Signal {
    public static const long kill = 9;
    public static const long pipe = 13;
    public static const long ignored = 1;
}

// The code a child this library stops is told to report on Windows, which is what a POSIX child
// killed by SIGKILL reports through a shell.
public final class ChildExit {
    public static const long stopped = 137;
}

// The descriptor flag calls the POSIX halves make, spelled alike on Linux and Darwin.
public final class DescriptorControl {
    public static const long setFlags = 2;
    public static const long closeOnExec = 1;
    public static const long lowestFreeDescriptor = 3;
}

// F_DUPFD_CLOEXEC, which each system numbers on its own.
public duplicateCloseOnExecCommand(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 67;
    }
    return 1030;
}

// The bits of a POSIX wait status, which Linux and Darwin lay out alike.
public final class WaitStatus {
    public static const long signalMask = 0x7F;
    public static const long codeShift = 8;
    public static const long codeMask = 0xFF;
    public static const long noHang = 1;
}

// The clock a monotonic reading comes from, which each system numbers on its own.
public monotonicClock(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 6;
    }
    return 1;
}

// Where a 'struct timespec' holds its two fields on every 64-bit POSIX target.
public final class Timespec {
    public static const long seconds = 0;
    public static const long nanoseconds = 8;
    public static const long structBytes = 16;
}

// The flags and answers of Win32 process creation and waiting.
public final class ProcessCreation {
    public static const long extendedStartupInfo = 0x80000;
    public static const long unicodeEnvironment = 0x400;
    public static const long useStandardHandles = 0x100;
    public static const long handleListAttribute = 0x20002;
    public static const long duplicateSameAccess = 2;
    public static const long inheritFlag = 1;
    public static const long infinite = 0xFFFFFFFF;
    public static const long waitObject = 0;
    public static const long waitFailed = 0xFFFFFFFF;
}

// Where STARTUPINFOEXW holds what a start writes, in 112 bytes on both Windows architectures. The
// plain STARTUPINFOW is the first 104 of them.
public final class StartupInfo {
    public static const long size = 0;
    public static const long flags = 60;
    public static const long standardInput = 80;
    public static const long standardOutput = 88;
    public static const long standardError = 96;
    public static const long attributeList = 104;
    public static const long plainBytes = 104;
    public static const long extendedBytes = 112;
}

// Where PROCESS_INFORMATION holds the two handles a start receives, in 24 bytes.
public final class ProcessInformation {
    public static const long process = 0;
    public static const long thread = 8;
    public static const long structBytes = 24;
}

// Where SECURITY_ATTRIBUTES says a handle may be inherited, in 24 bytes.
public final class SecurityAttributes {
    public static const long length = 0;
    public static const long inheritHandle = 16;
    public static const long structBytes = 24;
}

// Where OVERLAPPED holds the event a pending read signals, in 32 bytes.
public final class Overlapped {
    public static const long event = 24;
    public static const long structBytes = 32;
}

// The named pipe an output stream is read through, whose reading end can be waited on.
public final class NamedPipe {
    public static const long accessInbound = 1;
    public static const long overlappedFlag = 0x40000000;
    public static const long firstInstance = 0x80000;
    public static const long byteStream = 0;
    public static const long rejectRemoteClients = 8;
    public static const long bufferBytes = 65536;
    public static const long attributeNormal = 0x80;
    public static const long nameAttempts = 8;
    public static const long nameBytes = 64;
}

// What a poll answers with, one bit per thing a caller can do without waiting.
public final class PollReady {
    public static const long output = 1;
    public static const long errors = 2;
    public static const long ended = 4;
}

// How long one turn of the poll lasts where the system offers nothing to wait on for a child's
// end, which is a Linux kernel with no pidfd.
public final class PollTurn {
    public static const long millis = 5;
}

// Where a 'struct pollfd' holds its fields, and the one event a poll asks for. Any event the system
// answers with means a read would not wait, so the answer is never taken apart.
public final class Pollfd {
    public static const long descriptor = 0;
    public static const long events = 4;
    public static const long revents = 6;
    public static const long structBytes = 8;
}

public final class PollEvent {
    public static const long input = 1;
}

// The number of the pidfd_open system call, which every Linux architecture shares because it
// postdates the unified table. A target that is not Linux has none.
public pidfdOpenSystemCall(string targetTriple) -> long {
    if (targetTriple.contains("linux")) {
        return 434;
    }
    return 0;
}

// Where a Darwin 'struct kevent' holds its fields in 32 bytes, and the filters, flags and note the
// poll registers.
public final class Kevent {
    public static const long ident = 0;
    public static const long filter = 8;
    public static const long flags = 10;
    public static const long filterFlags = 12;
    public static const long data = 16;
    public static const long userData = 24;
    public static const long structBytes = 32;

    public static const long readFilter = -1;
    public static const long processFilter = -5;
    public static const long add = 0x1;
    public static const long oneShot = 0x10;
    public static const long error = 0x4000;
    public static const long exitNote = 0x80000000;
}

// The numbers GetStdHandle takes for the three standard handles.
public final class StandardHandle {
    public static const long input = -10;
    public static const long output = -11;
    public static const long error = -12;
}

public onWindowsTriple(string targetTriple) -> bool {
    return targetTriple.contains("windows");
}

public onDarwinTriple(string targetTriple) -> bool {
    return targetTriple.contains("darwin") || targetTriple.contains("apple");
}
