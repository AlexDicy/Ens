// Where a target's system structures hold the fields a file bridge reads, and what a target names
// its entry points. Every answer follows from the target triple alone.

// The kind a file bridge answers with. Zero says the enumeration did not report one, which is also
// what an output a failed call left untouched holds.
public final class FileKind {
    public static const long unknown = 0;
    public static const long file = 1;
    public static const long directory = 2;
    public static const long symbolicLink = 3;
    public static const long other = 4;
}

// What a bridge is asked to open a path for.
public final class OpenMode {
    public static const long read = 0;
    public static const long writeTruncated = 1;
    public static const long appended = 2;
    public static const long createdNew = 3;
}

// The mode-word bits naming a file's type, which every POSIX system spells the same way.
public final class FileMode {
    public static const long typeMask = 0xF000;
    public static const long regular = 0x8000;
    public static const long directory = 0x4000;
    public static const long symbolicLink = 0xA000;
}

// The 'struct statx' a Linux metadata answer arrives in, which the kernel lays out identically on
// every architecture. A field the answer's mask does not claim was never filled in.
public final class Statx {
    public static const long currentDirectory = -100;
    public static const long noFollowFlag = 0x100;

    public static const long typeRequest = 0x1;
    public static const long modifiedRequest = 0x40;
    public static const long sizeRequest = 0x200;

    public static const long maskOffset = 0;
    public static const long modeOffset = 28;
    public static const long sizeOffset = 40;
    public static const long secondsOffset = 112;
    public static const long nanosecondsOffset = 120;
    public static const long structBytes = 256;

    // STATX_MODE claims the permission bits, which STATX_TYPE leaves out.
    public static const long permissionsRequest = 0x2;

    // What a caller sees where no statx exists to ask, which is what a kernel too old to carry it
    // reports as well.
    public static const long unsupportedError = 38;

    // What a caller sees where statx answered without a field that was asked for.
    public static const long incompleteError = 5;
}

// The 'struct stat' a Darwin metadata answer arrives in, whose mode is sixteen bits wide.
public final class DarwinStat {
    public static const long modeOffset = 4;
    public static const long sizeOffset = 96;
    public static const long secondsOffset = 48;
    public static const long nanosecondsOffset = 56;
    public static const long structBytes = 144;
}

// The number the statx system call carries on the target's architecture. An architecture with no
// number here has no statx to reach, and asking under another architecture's number would run an
// unrelated call.
public statxSystemCall(string targetTriple) -> long {
    if (targetTriple.contains("x86_64")) {
        return 332;
    }
    if (targetTriple.contains("aarch64") || targetTriple.contains("riscv64")) {
        return 291;
    }
    return 0;
}

// The permission bits a mode word carries below its type, which is all a copy hands over.
public final class FilePermissions {
    public static const long mask = 0xFFF;
    public static const long created = 0x1FF;
}

// The no-replace rename each system offers under its own flag, and the flag Windows needs to
// replace instead.
public final class Rename {
    public static const long linuxNoReplace = 0x1;
    public static const long darwinExclusive = 0x4;
    public static const long windowsReplace = 0x1;

    // What a checked fallback answers where the destination is taken, which is what the no-replace
    // rename reports itself.
    public static const long destinationExists = 17;
}

// What a system reports where its no-replace rename exists but the file system will not carry the
// request out, which is what sends a bridge to its checked fallback.
public final class RenameRefusal {
    public static const long invalidRequest = 22;
    public static const long linuxNoSystemCall = 38;
    public static const long linuxNotSupported = 95;
    public static const long darwinNotSupported = 45;
    public static const long darwinNoSystemCall = 78;
}

public unsupportedRenameErrors(string targetTriple) -> long[] {
    if (onDarwinTriple(targetTriple)) {
        return [RenameRefusal.invalidRequest, RenameRefusal.darwinNotSupported,
            RenameRefusal.darwinNoSystemCall];
    }
    return [RenameRefusal.invalidRequest, RenameRefusal.linuxNoSystemCall,
        RenameRefusal.linuxNotSupported];
}

// The number the renameat2 system call carries on the target's architecture. An architecture with
// no number here has no no-replace rename to reach, and the bridge falls back to reading the
// destination first.
public renameSystemCall(string targetTriple) -> long {
    if (targetTriple.contains("x86_64")) {
        return 316;
    }
    if (targetTriple.contains("aarch64") || targetTriple.contains("riscv64")) {
        return 276;
    }
    return 0;
}

// The flags an open takes, which every system spells with values of its own.
public final class OpenFlags {
    public const long readOnly;
    public const long writeOnly;
    public const long create;
    public const long exclusive;
    public const long truncate;
    public const long append;

    public constructor(this.readOnly, this.writeOnly, this.create, this.exclusive,
                       this.truncate, this.append);
}

public openFlags(string targetTriple) -> OpenFlags {
    if (onDarwinTriple(targetTriple)) {
        return new OpenFlags(readOnly: 0, writeOnly: 1, create: 0x200, exclusive: 0x800,
            truncate: 0x400, append: 0x8);
    }
    return new OpenFlags(readOnly: 0, writeOnly: 1, create: 0x40, exclusive: 0x80,
        truncate: 0x200, append: 0x400);
}

// The kinds a POSIX directory entry reports in its d_type, which Linux and Darwin number alike. An
// entry a file system cannot classify reports DT_UNKNOWN.
public final class DirentKind {
    public static const long unknown = 0;
    public static const long directory = 4;
    public static const long regular = 8;
    public static const long symbolicLink = 10;
}

// Where a 'struct dirent' holds the entry's name. Every record is padded to an eight-byte multiple,
// so the three characters a dot-entry test reads stay inside the record even for the shortest name.
public direntNameOffset(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 21;
    }
    return 19;
}

// Where a 'struct dirent' holds the entry's kind, one byte ahead of its name.
public direntKindOffset(string targetTriple) -> long {
    if (onDarwinTriple(targetTriple)) {
        return 20;
    }
    return 18;
}

// The name a directory or file entry point links under. On Darwin the form carrying a 64-bit inode
// is the plain name on arm64, and the '$INODE64' name on x86_64 where the plain name still reaches
// the smaller, older record.
public entryPointName(string targetTriple, string name) -> string {
    if (onDarwinTriple(targetTriple) && targetTriple.contains("x86_64")) {
        return name + "$INODE64";
    }
    return name;
}

public onWindowsTriple(string targetTriple) -> bool {
    return targetTriple.contains("windows");
}

public onDarwinTriple(string targetTriple) -> bool {
    return targetTriple.contains("darwin") || targetTriple.contains("apple");
}
