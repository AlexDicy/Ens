// The instructions that produce or consume string values. Each is a call to the string primitive
// the runtime carries, except the two that need no runtime help: a bool picks between two
// literals, and an enum member's name is a chain of selects over its values.
import EirConstString from eir.model;
import EirHashValue from eir.model;
import EirStringLength from eir.model;
import EirStringConcat from eir.model;
import EirStringEqual from eir.model;
import EirStringCompare from eir.model;
import EirStringIndexOf from eir.model;
import EirStringHasAffix from eir.model;
import EirStringTrim from eir.model;
import EirStringSubstring from eir.model;
import EirStringToBytes from eir.model;
import EirStringFromBytes from eir.model;
import EirIntToString from eir.model;
import EirCharToString from eir.model;
import EirDoubleToString from eir.model;
import EirBoolToString from eir.model;
import EirEnumToString from eir.model;
import EirJsonEscape from eir.model;
import EnumType from @ens.sema.model.types;
import @ens.sema.model.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import emit.arrays;
import support.primitives;

public emitConstString(ModuleEmitter emitter, EmissionFrame frame, EirConstString constant) {
    frame.define(constant.result, emitter.runtime.stringLiteral(constant.bytes));
}

public emitStringLength(ModuleEmitter emitter, EmissionFrame frame, EirStringLength length) {
    frame.define(length.result, emitter.runtime.payloadLength(frame.value(length.value)));
}

public emitStringConcat(ModuleEmitter emitter, EmissionFrame frame, EirStringConcat joined) {
    frame.define(joined.result, emitter.runtime.call(emitter.runtime.stringConcat(),
        [frame.value(joined.left), frame.value(joined.right)], ""));
}

public emitStringEqual(ModuleEmitter emitter, EmissionFrame frame, EirStringEqual compared) {
    frame.define(compared.result, emitter.runtime.call(emitter.runtime.stringEqual(),
        [frame.value(compared.left), frame.value(compared.right)], ""));
}

public emitStringCompare(ModuleEmitter emitter, EmissionFrame frame, EirStringCompare ordered) {
    frame.define(ordered.result, emitter.runtime.call(emitter.runtime.stringOrder(),
        [frame.value(ordered.left), frame.value(ordered.right)], ""));
}

// The synthesized leaf hash: an integer or enum widened by its signedness, a float's bit
// pattern, a string's byte fold, and a reference's identity. Lowering folds aggregates, so
// nothing else reaches here.
public emitHashValue(ModuleEmitter emitter, EmissionFrame frame, EirHashValue hashed) {
    let valueType = frame.tempType(hashed.value);
    let value = frame.value(hashed.value);
    let longType = emitter.runtime.int64Type;
    if (primitives.isStringType(valueType)) {
        frame.define(hashed.result,
            emitter.runtime.call(emitter.runtime.stringHash(), [value], ""));
        return;
    }
    if (primitives.isReferenceType(valueType)) {
        frame.define(hashed.result,
            instructions.buildPtrToInt(emitter.builder, value, longType, ""));
        return;
    }
    if (primitives.isFloatType(valueType)) {
        if (primitives.bitWidth(valueType) == 32) {
            let bits = instructions.buildBitCast(emitter.builder, value,
                emitter.runtime.int32Type, "");
            frame.define(hashed.result,
                instructions.buildZExt(emitter.builder, bits, longType, ""));
            return;
        }
        frame.define(hashed.result,
            instructions.buildBitCast(emitter.builder, value, longType, ""));
        return;
    }
    long width = primitives.bitWidth(valueType);
    bool signedValue = primitives.isSignedType(valueType);
    if (valueType is EnumType) {
        width = valueType.isNumeric() ? 64 : 32;
        signedValue = true;
    }
    if (width == 64) {
        frame.define(hashed.result, value);
        return;
    }
    if (signedValue) {
        frame.define(hashed.result,
            instructions.buildSExt(emitter.builder, value, longType, ""));
        return;
    }
    frame.define(hashed.result, instructions.buildZExt(emitter.builder, value, longType, ""));
}

public emitStringIndexOf(ModuleEmitter emitter, EmissionFrame frame, EirStringIndexOf search) {
    frame.define(search.result, emitter.runtime.call(emitter.runtime.stringIndexOf(),
        [frame.value(search.haystack), frame.value(search.needle)], ""));
}

public emitStringHasAffix(ModuleEmitter emitter, EmissionFrame frame, EirStringHasAffix affix) {
    let target = emitter.runtime.stringStartsWith();
    if (affix.atEnd) {
        target = emitter.runtime.stringEndsWith();
    }
    frame.define(affix.result, emitter.runtime.call(target,
        [frame.value(affix.value), frame.value(affix.part)], ""));
}

public emitStringTrim(ModuleEmitter emitter, EmissionFrame frame, EirStringTrim trimmed) {
    ulong trailing = 0;
    if (trimmed.trailing) {
        trailing = 1;
    }
    frame.define(trimmed.result, emitter.runtime.call(emitter.runtime.stringTrim(),
        [frame.value(trimmed.value), emitter.context.int1Type().constInt(trailing, false)], ""));
}

public emitStringSubstring(ModuleEmitter emitter, EmissionFrame frame, EirStringSubstring part) {
    frame.define(part.result, emitter.runtime.call(emitter.runtime.stringSubstring(),
        [frame.value(part.value), frame.value(part.start), frame.value(part.end)], ""));
}

public emitStringToBytes(ModuleEmitter emitter, EmissionFrame frame, EirStringToBytes conversion) {
    let text = frame.value(conversion.value);
    let length = emitter.runtime.payloadLength(text);
    // A byte owns nothing, so the bytes of a string need no element finalizer.
    let array = arrays.allocateArray(emitter, conversion.type, length,
        emitter.runtime.nullPointer());
    memory.buildMemCpy(emitter.builder, emitter.runtime.payloadData(array), 1,
        emitter.runtime.payloadData(text), 1, length);
    frame.define(conversion.result, array);
}

public emitStringFromBytes(ModuleEmitter emitter, EmissionFrame frame, EirStringFromBytes conversion) {
    let array = frame.value(conversion.bytes);
    let length = emitter.runtime.payloadLength(array);
    let text = emitter.runtime.call(emitter.runtime.stringAllocate(), [length], "");
    memory.buildMemCpy(emitter.builder, emitter.runtime.payloadData(text), 1,
        emitter.runtime.payloadData(array), 1, length);
    frame.define(conversion.result, text);
}

public emitIntToString(ModuleEmitter emitter, EmissionFrame frame, EirIntToString conversion) {
    ulong signedness = 0;
    if (conversion.signed) {
        signedness = 1;
    }
    frame.define(conversion.result, emitter.runtime.call(emitter.runtime.intToString(),
        [frame.value(conversion.value), emitter.context.int1Type().constInt(signedness, false)],
        ""));
}

public emitCharToString(ModuleEmitter emitter, EmissionFrame frame, EirCharToString conversion) {
    frame.define(conversion.result, emitter.runtime.call(emitter.runtime.charToString(),
        [frame.value(conversion.value)], ""));
}

public emitDoubleToString(ModuleEmitter emitter, EmissionFrame frame, EirDoubleToString conversion) {
    let target = emitter.runtime.doubleToString();
    if (conversion.single) {
        target = emitter.runtime.floatToString();
    }
    frame.define(conversion.result, emitter.runtime.call(target,
        [frame.value(conversion.value)], ""));
}

public emitBoolToString(ModuleEmitter emitter, EmissionFrame frame, EirBoolToString conversion) {
    frame.define(conversion.result, instructions.buildSelect(emitter.builder,
        frame.value(conversion.value), emitter.message("true"), emitter.message("false"), ""));
}

public emitEnumToString(ModuleEmitter emitter, EmissionFrame frame, EirEnumToString conversion)
        -> string {
    let named = conversion.enumType;
    if (!(named is EnumType)) {
        return "Internal: the enum text of '{types.display(named)}' in {frame.symbol()}";
    }
    frame.define(conversion.result, emitEnumName(emitter, named,
        frame.value(conversion.value)));
    return "";
}

public emitJsonEscape(ModuleEmitter emitter, EmissionFrame frame, EirJsonEscape escape) {
    frame.define(escape.result, emitter.runtime.call(emitter.runtime.jsonEscape(),
        [frame.value(escape.value)], ""));
}

// The member name the enum value spells, as selects folded from the last member back to the first
// so the earliest matching member wins. Assigned values may be sparse or negative, so the chain
// matches values rather than indexing a table.
emitEnumName(ModuleEmitter emitter, EnumType named, Value value) -> Value {
    let memberType = emitter.mapType(named);
    string[] names = named.memberNames();
    long[] values = named.memberValues();
    Value chosen = emitter.message("<invalid>");
    for (long i = names.length - 1; i >= 0; i--) {
        let matched = instructions.buildICmpEQ(emitter.builder, value,
            memberType.constInt(values[i] as ulong, true), "");
        chosen = instructions.buildSelect(emitter.builder, matched, emitter.message(names[i]),
            chosen, "");
    }
    return chosen;
}
