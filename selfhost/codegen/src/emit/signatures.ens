// The LLVM function type an EIR signature maps onto, and the declarations that carry it. Every
// function the module defines is declared before any body is emitted, so a call may name a
// function whose body comes later, and a callee defined in another module is declared on first use
// with external linkage.
//
// A method takes the address of the storage it runs over as its first parameter, ahead of the
// declared ones.
import EirFunction from eir.model;
import EirCallee from eir.model;
import EirParameter from eir.model;
import Type from @ens.sema.model.types;
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import @ens.llvm.globals;
import ModuleEmitter from emit.context;
import List from @std.collections.list;

public declareFunction(ModuleEmitter emitter, EirFunction function) {
    let functionType = signatureType(emitter, declaredTypes(function.parameters()),
        function.receiverType() != null, function.returnType(), function.throwing());
    let declared = emitter.module.addFunction(function.symbol(), functionType);
    if (function.internalLinkage()) {
        globals.setLinkage(declared, globals.linkageInternal());
    }
    emitter.defineFunction(function.symbol(), declared, functionType);
}

// The value a call to this callee names, declaring it the first time the module reaches it.
public calleeValue(ModuleEmitter emitter, EirCallee callee) -> Value {
    let existing = emitter.functionValue(callee.symbol());
    if (existing != null) {
        return existing;
    }
    let functionType = calleeType(emitter, callee);
    let declared = emitter.module.addFunction(callee.symbol(), functionType);
    emitter.defineFunction(callee.symbol(), declared, functionType);
    return declared;
}

// The LLVM function type a call to this callee is built with, whether the target is a symbol or
// a pointer a dispatch table produced.
public calleeType(ModuleEmitter emitter, EirCallee callee) -> TypeRef {
    return signatureType(emitter, callee.parameterTypes(), callee.receiverType() != null,
        callee.returnType(), callee.throwing());
}

// A throwing signature carries one more trailing pointer, the caller's error slot.
signatureType(ModuleEmitter emitter, Type[] parameterTypes, bool hasReceiver, Type returnType,
              bool throwing) -> TypeRef {
    let mapped = new List<TypeRef>();
    if (hasReceiver) {
        mapped.push(emitter.context.pointerType());
    }
    for (let parameterType in parameterTypes) {
        mapped.push(emitter.mapType(parameterType));
    }
    if (throwing) {
        mapped.push(emitter.context.pointerType());
    }
    return emitter.mapType(returnType).functionType(mapped.toArray());
}

declaredTypes(EirParameter[] parameters) -> Type[] {
    let declared = new Type[parameters.length];
    for (long i = 0; i < declared.length; i++) {
        declared[i] = parameters[i].type();
    }
    return declared;
}
