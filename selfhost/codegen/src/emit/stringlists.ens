// Gathering an unknown number of owned strings into an Ens string[]. A bridge learns the count
// only by walking to the end, so it collects the strings in a doubling buffer of pointers and
// hands that to one runtime function, which copies it into an array that releases every string.
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;
import RuntimeFunction from emit.runtime;

// ptr ens_string_list(ptr strings, i64 count, ptr finalizer): an owned string[] holding the counted
// strings, or null when it could not be allocated.
public stringListRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.int64Type,
        runtime.pointerType]);
    let known = runtime.existing("ens_string_list", type);
    if (known != null) {
        return known;
    }
    let allocate = runtime.alloc();
    let copy = runtime.memcpy();
    let definition = runtime.beginDefinition("ens_string_list", type);
    let builder = runtime.builder;
    let fillBlock = runtime.block(definition, "list.fill");
    let emptyBlock = runtime.block(definition, "list.empty");
    let strings = runtime.parameter(definition, 0);
    let count = runtime.parameter(definition, 1);
    let slotBytes = instructions.buildMul(builder, count, runtime.int64(8), "");
    let list = runtime.call(allocate, [instructions.buildAdd(builder, runtime.int64(8), slotBytes,
        ""), runtime.parameter(definition, 2), runtime.nullPointer()], "list");
    instructions.buildCondBr(builder, runtime.isNull(list), emptyBlock, fillBlock);

    builder.positionAtEnd(fillBlock);
    memory.buildStore(builder, count, list);
    runtime.call(copy, [runtime.payloadData(list), strings, slotBytes], "");
    instructions.buildRet(builder, list);

    builder.positionAtEnd(emptyBlock);
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

// The doubling buffer itself, held in stack slots so a push inside a loop reads and writes the same
// state the block that opened the collector wrote.
public final class StringCollector {
    static const long initialCapacity = 16;

    Runtime runtime;
    Value slots;
    Value countSlot;
    Value capacitySlot;

    public constructor(Runtime runtime) {
        this.runtime = runtime;
        let builder = runtime.builder;
        this.slots = memory.buildAlloca(builder, runtime.pointerType, "collected");
        this.countSlot = memory.buildAlloca(builder, runtime.int64Type, "collected.count");
        this.capacitySlot = memory.buildAlloca(builder, runtime.int64Type, "collected.capacity");
        memory.buildStore(builder, runtime.call(runtime.malloc(),
            [runtime.int64(StringCollector.initialCapacity * 8)], "slots"), this.slots);
        memory.buildStore(builder, runtime.int64(0), this.countSlot);
        memory.buildStore(builder, runtime.int64(StringCollector.initialCapacity),
            this.capacitySlot);
    }

    // Appends one owned string, doubling the buffer first when it is full.
    public push(RuntimeDefinition definition, Value value) {
        let builder = this.runtime.builder;
        let growBlock = this.runtime.block(definition, "collect.grow");
        let storeBlock = this.runtime.block(definition, "collect.store");
        let count = memory.buildLoad(builder, this.runtime.int64Type, this.countSlot, "count");
        let capacity = memory.buildLoad(builder, this.runtime.int64Type, this.capacitySlot,
            "capacity");
        instructions.buildCondBr(builder,
            instructions.buildICmpEQ(builder, count, capacity, ""), growBlock, storeBlock);

        builder.positionAtEnd(growBlock);
        let grown = instructions.buildMul(builder, capacity, this.runtime.int64(2), "");
        memory.buildStore(builder, grown, this.capacitySlot);
        memory.buildStore(builder, this.runtime.call(this.runtime.realloc(),
            [this.buffer(), instructions.buildMul(builder, grown, this.runtime.int64(8), "")],
            "slots.grown"), this.slots);
        instructions.buildBr(builder, storeBlock);

        builder.positionAtEnd(storeBlock);
        memory.buildStore(builder, value, memory.buildGEP(builder, this.runtime.pointerType,
            this.buffer(), [count], "slot"));
        memory.buildStore(builder, instructions.buildAdd(builder, count, this.runtime.int64(1), ""),
            this.countSlot);
    }

    // The collected strings as an owned string[] with the given element finalizer, freeing the
    // buffer they were gathered in.
    public list(Value finalizer) -> Value {
        let builder = this.runtime.builder;
        let gathered = this.buffer();
        let list = this.runtime.call(stringListRuntime(this.runtime), [gathered,
            memory.buildLoad(builder, this.runtime.int64Type, this.countSlot, "count"), finalizer],
            "list");
        this.runtime.call(this.runtime.free(), [gathered], "");
        return list;
    }

    buffer() -> Value {
        return memory.buildLoad(this.runtime.builder, this.runtime.pointerType, this.slots,
            "slots");
    }
}
