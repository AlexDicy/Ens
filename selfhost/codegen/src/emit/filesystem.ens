// The bridges that read, change and enumerate what is at one path. Windows answers through the wide
// entry points, so a path outside the system code page still reaches the file system.
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import OpenMode from emit.nativeshapes;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import emit.directories;
import emit.filesystem.posix;
import emit.filesystem.windows;
import emit.widetext;

// The mode text the C library takes for a descriptor already opened, which is the same text on
// every platform.
public streamMode(Runtime runtime, Value mode) -> Value {
    let builder = runtime.builder;
    let reading = globals.buildGlobalString(builder, "rb", ".open.read");
    let writing = globals.buildGlobalString(builder, "wb", ".open.write");
    let appending = globals.buildGlobalString(builder, "ab", ".open.append");
    return instructions.buildSelect(builder, isMode(runtime, mode, OpenMode.read), reading,
        instructions.buildSelect(builder, isMode(runtime, mode, OpenMode.appended), appending,
            writing, ""), "mode.text");
}

public isMode(Runtime runtime, Value mode, long wanted) -> Value {
    return instructions.buildICmpEQ(runtime.builder, mode, runtime.int32(wanted), "");
}

// i32 ens_fs_metadata(ptr path, i32 followLinks, ptr kind, ptr length, ptr modifiedMillis): 0 with
// the three answers written, or the platform's own error number with none of them written. The kind
// is 1 for a file, 2 for a directory, 3 for a symbolic link and 4 for anything else, so 0 is never
// an answer. A directory's length is 0 on every platform, and the time is milliseconds since
// 1970-01-01 UTC. A followLinks of 1 answers for what a link points to, and 0 answers for the link
// itself, which is what keeps a walk over a tree of links finite.
public metadataRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.int32Type,
        runtime.pointerType, runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_fs_metadata", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsMetadata(runtime, type);
    }
    if (runtime.onDarwin()) {
        return posix.darwinMetadata(runtime, type);
    }
    return posix.linuxMetadata(runtime, type);
}

// i32 ens_fs_real_path(ptr path, ptr buffer, i64 capacity, ptr needed): 0 when the path was
// resolved, or the platform's own error number. A 0 answer does not by itself mean the text was
// written. `needed` always holds the byte count the answer takes, and the buffer is left untouched
// whenever that count is above `capacity`, so a caller compares the two on every call and asks
// again with the room it was told. The text is the operating system's own and carries no
// terminator.
public realPathRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType]);
    let known = runtime.existing("ens_fs_real_path", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsRealPath(runtime, type);
    }
    return posix.posixRealPath(runtime, type);
}

// i32 ens_path_kind(ptr path): 0 when nothing is there, 1 for a file, 2 for a directory.
public pathKindRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_path_kind", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windowsPathKind(runtime, type);
    }
    return posixPathKind(runtime, type);
}

windowsPathKind(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let attributesOf = runtime.libc("GetFileAttributesW",
        runtime.int32Type.functionType([runtime.pointerType]));
    let widen = widetext.wideFromUtf8(runtime);
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_path_kind", type);
    let builder = runtime.builder;
    let probeBlock = runtime.block(definition, "kind.probe");
    let classifyBlock = runtime.block(definition, "kind.classify");
    let missingBlock = runtime.block(definition, "kind.missing");
    let wide = runtime.call(widen, [runtime.parameter(definition, 0), runtime.int32(-1)],
        "path.wide");
    instructions.buildCondBr(builder, runtime.isNull(wide), missingBlock, probeBlock);

    builder.positionAtEnd(probeBlock);
    let attributes = runtime.call(attributesOf, [wide], "attributes");
    runtime.call(release, [wide], "");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, attributes, runtime.int32(-1), ""),
        missingBlock, classifyBlock);

    // FILE_ATTRIBUTE_DIRECTORY.
    builder.positionAtEnd(classifyBlock);
    let directory = instructions.buildICmpNE(builder,
        instructions.buildAnd(builder, attributes, runtime.int32(0x10), ""), runtime.int32(0), "");
    instructions.buildRet(builder, instructions.buildSelect(builder, directory, runtime.int32(2),
        runtime.int32(1), ""));

    builder.positionAtEnd(missingBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

posixPathKind(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let reachable = runtime.libc("access",
        runtime.int32Type.functionType([runtime.pointerType, runtime.int32Type]));
    let openFolder = directories.openFolderFunction(runtime);
    let closeFolder = directories.closeFolderFunction(runtime);
    let definition = runtime.beginDefinition("ens_path_kind", type);
    let builder = runtime.builder;
    let probeBlock = runtime.block(definition, "kind.probe");
    let folderBlock = runtime.block(definition, "kind.directory");
    let fileBlock = runtime.block(definition, "kind.file");
    let missingBlock = runtime.block(definition, "kind.missing");
    let path = runtime.parameter(definition, 0);
    let status = runtime.call(reachable, [path, runtime.int32(0)], "status");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), probeBlock, missingBlock);

    // Only a directory opens as one, so nothing here has to know how a 'struct stat' is laid out.
    builder.positionAtEnd(probeBlock);
    let stream = runtime.call(openFolder, [path], "folder");
    instructions.buildCondBr(builder, runtime.isNull(stream), fileBlock, folderBlock);

    builder.positionAtEnd(folderBlock);
    runtime.call(closeFolder, [stream], "");
    instructions.buildRet(builder, runtime.int32(2));

    builder.positionAtEnd(fileBlock);
    instructions.buildRet(builder, runtime.int32(1));

    builder.positionAtEnd(missingBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

// i32 ens_create_directory(ptr path): 0 when this call created the one level the path names, 1 when
// something was there already, -1 when it could not be created. Every parent above it is the caller's
// to create first. The three answers are what the operating system itself reports, so a caller can
// tell creating a directory from finding one, which is how a name is claimed by exactly one of two
// programs asking at the same instant.
public createDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_create_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windowsCreateDirectory(runtime, type);
    }
    return posixCreateDirectory(runtime, type);
}

posixCreateDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let makeDirectory = runtime.libc("mkdir",
        runtime.int32Type.functionType([runtime.pointerType, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_create_directory", type);
    let builder = runtime.builder;
    let madeBlock = runtime.block(definition, "create.made");
    let refusedBlock = runtime.block(definition, "create.refused");
    let status = runtime.call(makeDirectory, [runtime.parameter(definition, 0),
        runtime.int32(0x1FF)], "status");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), madeBlock, refusedBlock);

    builder.positionAtEnd(madeBlock);
    instructions.buildRet(builder, runtime.int32(0));

    // EEXIST.
    builder.positionAtEnd(refusedBlock);
    let why = runtime.lastError();
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(17), ""), runtime.int32(1),
        runtime.int32(-1), ""));
    return runtime.endDefinition(definition);
}

windowsCreateDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let createDirectory = runtime.libc("CreateDirectoryW",
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let lastError = runtime.libc("GetLastError", runtime.int32Type.functionType([]));
    let widen = widetext.wideFromUtf8(runtime);
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_create_directory", type);
    let builder = runtime.builder;
    let createBlock = runtime.block(definition, "create.wide");
    let madeBlock = runtime.block(definition, "create.made");
    let refusedBlock = runtime.block(definition, "create.refused");
    let failedBlock = runtime.block(definition, "create.failed");
    let wide = runtime.call(widen, [runtime.parameter(definition, 0), runtime.int32(-1)],
        "path.wide");
    instructions.buildCondBr(builder, runtime.isNull(wide), failedBlock, createBlock);

    // The reason is read before anything else runs, because the next call is free to leave a reason
    // of its own behind.
    builder.positionAtEnd(createBlock);
    let created = runtime.call(createDirectory, [wide, runtime.nullPointer()], "created");
    let why = runtime.call(lastError, [], "why");
    runtime.call(release, [wide], "");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, created, runtime.int32(0), ""), refusedBlock, madeBlock);

    builder.positionAtEnd(madeBlock);
    instructions.buildRet(builder, runtime.int32(0));

    // ERROR_ALREADY_EXISTS.
    builder.positionAtEnd(refusedBlock);
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(183), ""), runtime.int32(1),
        runtime.int32(-1), ""));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, runtime.int32(-1));
    return runtime.endDefinition(definition);
}

// ptr ens_fs_open(ptr path, i32 mode, ptr error): the C library stream the path is open on, or null
// with the platform's own error number written to `error`. The mode is 0 to read, 1 to write from
// empty, 2 to write at the end, and 3 to create and refuse a path that is already there. Modes 1,
// 2 and 3 create what is missing, and the stream is closed with the C library's own fclose.
public openRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.int32Type,
        runtime.pointerType]);
    let known = runtime.existing("ens_fs_open", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsOpen(runtime, type);
    }
    return posix.posixOpen(runtime, type);
}

// i32 ens_fs_create_directory(ptr path): 0 when this call created the one level the path names, or
// the platform's own error number, which names a path that was already there as its own kind of
// failure. Every parent above it is the caller's to create first.
public makeDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_fs_create_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsCreateDirectory(runtime, type);
    }
    return posix.posixCreateDirectory(runtime, type);
}

// i32 ens_fs_remove_file(ptr path): 0 when the path is gone, or the platform's own error number. A
// link naming a folder is removed as the link it is, and a folder itself is refused, which Windows
// reports as a permission it does not have and POSIX as a kind it will not remove.
public removeFileRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_fs_remove_file", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsRemoveFile(runtime, type);
    }
    return posix.posixRemoveFile(runtime, type);
}

// i32 ens_fs_remove_directory(ptr path): 0 when the folder is gone, or the platform's own error
// number, which names a folder still holding something as its own kind of failure. What is inside
// is the caller's to remove first.
public removeDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_fs_remove_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsRemoveDirectory(runtime, type);
    }
    return posix.posixRemoveDirectory(runtime, type);
}

// i32 ens_fs_rename(ptr from, ptr to, i32 replaceExisting): 0 when the move happened, or the
// platform's own error number. A replaceExisting of 0 refuses a destination that is taken and
// reports that as its own kind of failure, and 1 replaces whatever is there in one step. Both paths
// have to be on one volume, since nothing here copies.
public renameRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int32Type]);
    let known = runtime.existing("ens_fs_rename", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsRename(runtime, type);
    }
    return posix.posixRename(runtime, type, metadataRuntime(runtime));
}

// i32 ens_fs_copy_permissions(ptr from, ptr to): 0 when the destination carries the source's
// permission bits, or the platform's own error number. Windows answers 0 without doing anything,
// because it carries no bits a copy could hand over.
public copyPermissionsRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_fs_copy_permissions", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsCopyPermissions(runtime, type);
    }
    if (runtime.onDarwin()) {
        return posix.darwinCopyPermissions(runtime, type);
    }
    return posix.linuxCopyPermissions(runtime, type);
}

// ptr ens_fs_open_directory(ptr path, ptr error): a stream over what the folder holds, or null with
// the platform's own error number written to `error`. The stream is handed to every call below and
// released by exactly one call to the close bridge.
public openDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_fs_open_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsOpenDirectory(runtime, type);
    }
    return posix.posixOpenDirectory(runtime, type);
}

// ptr ens_fs_next_entry(ptr stream, ptr kind, ptr error): the next name inside the folder, or null
// once every name has been handed over and null with the platform's own error number written to
// `error` where the reading failed. The entries naming the folder itself and its parent are never
// answered, and the order is whatever the file system enumerates in. The kind is 1 for a file, 2
// for a directory, 3 for a symbolic link, 4 for anything else, and 0 where the file system
// classified nothing, which leaves the caller to ask about the entry itself. The name is the
// stream's own and lasts until the next call.
public nextEntryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.pointerType,
        runtime.pointerType]);
    let known = runtime.existing("ens_fs_next_entry", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsNextEntry(runtime, type);
    }
    return posix.posixNextEntry(runtime, type);
}

// void ens_fs_close_directory(ptr stream): hands the folder back to the operating system along with
// the stream itself, which no call may touch afterwards.
public closeDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.voidType.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_fs_close_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsCloseDirectory(runtime, type);
    }
    return posix.posixCloseDirectory(runtime, type);
}
