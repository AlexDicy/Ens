// The instructions that reach storage: reading and writing a slot, the address of a slot, of a
// struct field, or of an array element, loading and storing through an address, and the guards a
// checked access is fronted by. Lowering already proved which accesses need a guard, so the guards
// here are plain runtime calls.
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirSlotAddress from eir.model;
import EirFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;

public emitLoadSlot(ModuleEmitter emitter, EmissionFrame frame, EirLoadSlot load) -> string {
    let slot = frame.slotAt(load.slot);
    if (slot == null) {
        return "Internal: load from missing slot ${load.slot} in {frame.symbol()}";
    }
    frame.define(load.result, memory.buildLoad(emitter.builder, emitter.mapType(load.type), slot,
        ""));
    return "";
}

public emitStoreSlot(ModuleEmitter emitter, EmissionFrame frame, EirStoreSlot store) -> string {
    let slot = frame.slotAt(store.slot);
    if (slot == null) {
        return "Internal: store through missing slot in {frame.symbol()}";
    }
    let ignored = memory.buildStore(emitter.builder, frame.value(store.value), slot);
    return "";
}

public emitSlotAddress(ModuleEmitter emitter, EmissionFrame frame, EirSlotAddress address)
        -> string {
    let slot = frame.slotAt(address.slot);
    if (slot == null) {
        return "Internal: the address of missing slot ${address.slot} in {frame.symbol()}";
    }
    frame.define(address.result, slot);
    return "";
}

public emitFieldAddress(ModuleEmitter emitter, EmissionFrame frame, EirFieldAddress address) {
    frame.define(address.result, memory.buildStructGEP(emitter.builder,
        emitter.mapType(frame.tempType(address.base)), frame.value(address.base),
        address.fieldIndex as uint, ""));
}

public emitElementAddress(ModuleEmitter emitter, EmissionFrame frame, EirElementAddress address) {
    let data = emitter.runtime.payloadData(frame.value(address.array));
    frame.define(address.result, memory.buildGEP(emitter.builder, emitter.mapType(address.type),
        data, [frame.value(address.index)], ""));
}

public emitLoadPtr(ModuleEmitter emitter, EmissionFrame frame, EirLoadPtr load) {
    frame.define(load.result, memory.buildLoad(emitter.builder, emitter.mapType(load.type),
        frame.value(load.address), ""));
}

public emitStorePtr(ModuleEmitter emitter, EmissionFrame frame, EirStorePtr store) {
    memory.buildStore(emitter.builder, frame.value(store.value), frame.value(store.address));
}

public emitBoundsCheck(ModuleEmitter emitter, EmissionFrame frame, EirBoundsCheck check) {
    let length = emitter.runtime.payloadLength(frame.value(check.array));
    emitter.runtime.call(emitter.runtime.boundsCheck(), [frame.value(check.index), length,
        emitter.message("array index out of bounds")], "");
}

public emitRangeCheck(ModuleEmitter emitter, EmissionFrame frame, EirRangeCheck check) {
    emitter.runtime.call(emitter.runtime.rangeCheck(), [frame.value(check.start),
        frame.value(check.end), frame.value(check.length),
        emitter.message(check.message)], "");
}
