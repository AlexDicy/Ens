// The instructions that reach storage: slot reads and writes, the address of a slot, field, or
// element, loads and stores through an address, and the guards a checked access is fronted by.
// Lowering already proved which accesses need a guard, so the guards here are plain calls.
import EirLoadSlot from eir.model;
import EirStoreSlot from eir.model;
import EirTakeSlot from eir.model;
import EirSlotAddress from eir.model;
import EirGlobalAddress from eir.model;
import EirFieldAddress from eir.model;
import EirElementAddress from eir.model;
import EirLoadPtr from eir.model;
import EirStorePtr from eir.model;
import EirBoundsCheck from eir.model;
import EirRangeCheck from eir.model;
import Value from @ens.llvm.values;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import emit.exceptions;

public emitLoadSlot(ModuleEmitter emitter, EmissionFrame frame, EirLoadSlot load) -> string {
    let slot = frame.slotAt(load.slot);
    if (slot == null) {
        return "Internal: load from missing slot ${load.slot} in {frame.symbol()}";
    }
    frame.define(load.result, memory.buildLoad(emitter.builder, emitter.mapType(load.type), slot,
        ""));
    return "";
}

public emitStoreSlot(ModuleEmitter emitter, EmissionFrame frame, EirStoreSlot store) -> string {
    let slot = frame.slotAt(store.slot);
    if (slot == null) {
        return "Internal: store through missing slot in {frame.symbol()}";
    }
    let ignored = memory.buildStore(emitter.builder, frame.value(store.value), slot);
    return "";
}

// A take reads the reference and leaves null behind, so the slot's later cleanup releases
// nothing.
public emitTakeSlot(ModuleEmitter emitter, EmissionFrame frame, EirTakeSlot taken) -> string {
    let slot = frame.slotAt(taken.slot);
    if (slot == null) {
        return "Internal: take from missing slot ${taken.slot} in {frame.symbol()}";
    }
    let slotType = emitter.mapType(taken.type);
    frame.define(taken.result, memory.buildLoad(emitter.builder, slotType, slot, ""));
    memory.buildStore(emitter.builder, slotType.constNull(), slot);
    return "";
}

public emitSlotAddress(ModuleEmitter emitter, EmissionFrame frame, EirSlotAddress address)
        -> string {
    let slot = frame.slotAt(address.slot);
    if (slot == null) {
        return "Internal: the address of missing slot ${address.slot} in {frame.symbol()}";
    }
    frame.define(address.result, slot);
    return "";
}

// The global is added on first mention and zeroed where the owning module defines it, so every
// other module references the one storage the linker resolves them all to.
public emitGlobalAddress(ModuleEmitter emitter, EmissionFrame frame, EirGlobalAddress address) {
    let type = emitter.mapType(address.type);
    let global = emitter.globalNamed(type, address.symbol);
    if (address.defines) {
        globals.setInitializer(global, type.constNull());
    }
    frame.define(address.result, global);
}

public emitFieldAddress(ModuleEmitter emitter, EmissionFrame frame, EirFieldAddress address) {
    frame.define(address.result, memory.buildStructGEP(emitter.builder,
        emitter.mapType(frame.tempType(address.base)), frame.value(address.base),
        address.fieldIndex as uint, ""));
}

public emitElementAddress(ModuleEmitter emitter, EmissionFrame frame, EirElementAddress address) {
    let data = emitter.runtime.payloadData(frame.value(address.array));
    frame.define(address.result, memory.buildGEP(emitter.builder, emitter.mapType(address.type),
        data, [frame.value(address.index)], ""));
}

public emitLoadPtr(ModuleEmitter emitter, EmissionFrame frame, EirLoadPtr load) {
    frame.define(load.result, memory.buildLoad(emitter.builder, emitter.mapType(load.type),
        frame.value(load.address), ""));
}

public emitStorePtr(ModuleEmitter emitter, EmissionFrame frame, EirStorePtr store) {
    memory.buildStore(emitter.builder, frame.value(store.value), frame.value(store.address));
}

// The guards run inline at the site rather than in a runtime helper, so the abort's captured
// trace starts at the failing access, not inside a helper frame the symbol table cannot name.
public emitBoundsCheck(ModuleEmitter emitter, EmissionFrame frame, EirBoundsCheck check) {
    let builder = emitter.builder;
    let index = frame.value(check.index);
    let length = emitter.runtime.payloadLength(frame.value(check.array));
    let negative = instructions.buildICmpSLT(builder, index, emitter.runtime.int64(0), "");
    let past = instructions.buildICmpSGE(builder, index, length, "");
    let outside = instructions.buildOr(builder, negative, past, "");
    abortWhen(emitter, frame, outside, "array index out of bounds", check.line, "bounds");
}

public emitRangeCheck(ModuleEmitter emitter, EmissionFrame frame, EirRangeCheck check) {
    let builder = emitter.builder;
    let start = frame.value(check.start);
    let end = frame.value(check.end);
    let negative = instructions.buildICmpSLT(builder, start, emitter.runtime.int64(0), "");
    let inverted = instructions.buildICmpSGT(builder, start, end, "");
    let past = instructions.buildICmpSGT(builder, end, frame.value(check.length), "");
    let outside = instructions.buildOr(builder,
        instructions.buildOr(builder, negative, inverted, ""), past, "");
    abortWhen(emitter, frame, outside, check.message, check.line, "range");
}

// Branches to a fresh abort block when the condition holds, and continues in a fresh block
// otherwise.
abortWhen(ModuleEmitter emitter, EmissionFrame frame, Value outside, string message, long line,
          string label) {
    let failBlock = emitter.context.appendBasicBlock(frame.declared(), "{label}.fail");
    let okBlock = emitter.context.appendBasicBlock(frame.declared(), "{label}.ok");
    instructions.buildCondBr(emitter.builder, outside, failBlock, okBlock);
    emitter.builder.positionAtEnd(failBlock);
    exceptions.abortWith(emitter, frame, emitter.message(message), line);
    instructions.buildUnreachable(emitter.builder);
    emitter.builder.positionAtEnd(okBlock);
}
