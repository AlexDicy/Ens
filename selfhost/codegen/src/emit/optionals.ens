// The tagged-optional instructions as pair operations over the {i1 present, payload} struct. A
// wrap inserts true and the payload into a zeroed pair, and the absent value is the zeroed pair
// itself, so freshly zeroed storage already reads as absent.
import EirAbsentOptional from eir.model;
import EirOptionalPayload from eir.model;
import EirOptionalPayloadAddress from eir.model;
import EirOptionalPresence from eir.model;
import EirWrapOptional from eir.model;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;

public emitWrapOptional(ModuleEmitter emitter, EmissionFrame frame, EirWrapOptional wrapped) {
    let pairType = emitter.mapType(wrapped.type);
    let tagged = instructions.buildInsertValue(emitter.builder, pairType.constNull(),
        emitter.context.int1Type().constInt(1, false), 0 as uint, "");
    frame.define(wrapped.result, instructions.buildInsertValue(emitter.builder, tagged,
        frame.value(wrapped.value), 1 as uint, ""));
}

public emitAbsentOptional(ModuleEmitter emitter, EmissionFrame frame, EirAbsentOptional absent) {
    frame.define(absent.result, emitter.mapType(absent.type).constNull());
}

public emitOptionalPresence(ModuleEmitter emitter, EmissionFrame frame, EirOptionalPresence presence) {
    frame.define(presence.result, instructions.buildExtractValue(emitter.builder,
        frame.value(presence.value), 0 as uint, ""));
}

public emitOptionalPayload(ModuleEmitter emitter, EmissionFrame frame, EirOptionalPayload payload) {
    frame.define(payload.result, instructions.buildExtractValue(emitter.builder,
        frame.value(payload.value), 1 as uint, ""));
}

public emitOptionalPayloadAddress(ModuleEmitter emitter, EmissionFrame frame,
                                  EirOptionalPayloadAddress payloadAddress) {
    let pairType = emitter.mapType(frame.tempType(payloadAddress.base));
    frame.define(payloadAddress.result, memory.buildStructGEP(emitter.builder, pairType,
        frame.value(payloadAddress.base), 1 as uint, ""));
}
