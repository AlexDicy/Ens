// The instructions that compute a value from constants and other values. Signedness, floatness
// and width were all decided by lowering, so each operator names exactly one LLVM instruction.
import EirConstInt from eir.model;
import EirConstFloat from eir.model;
import EirConstBool from eir.model;
import EirConstNull from eir.model;
import EirBinary from eir.model;
import EirBinaryOp from eir.model;
import EirUnary from eir.model;
import EirCast from eir.model;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import support.primitives;

public emitConstInt(ModuleEmitter emitter, EmissionFrame frame, EirConstInt constant) {
    frame.define(constant.result, emitter.mapType(constant.type).constInt(
        constant.bits as ulong, primitives.isSignedType(constant.type)));
}

public emitConstFloat(ModuleEmitter emitter, EmissionFrame frame, EirConstFloat constant) {
    frame.define(constant.result, emitter.mapType(constant.type).constReal(constant.value));
}

public emitConstBool(ModuleEmitter emitter, EmissionFrame frame, EirConstBool constant) {
    ulong bit = 0;
    if (constant.value) {
        bit = 1;
    }
    frame.define(constant.result, emitter.context.int1Type().constInt(bit, false));
}

public emitConstNull(ModuleEmitter emitter, EmissionFrame frame, EirConstNull constant) {
    frame.define(constant.result, emitter.mapType(constant.type).constNull());
}

public emitBinary(ModuleEmitter emitter, EmissionFrame frame, EirBinary binary) {
    let left = frame.value(binary.left);
    let right = frame.value(binary.right);
    frame.define(binary.result, buildBinary(emitter, binary.op, left, right));
}

public emitUnary(ModuleEmitter emitter, EmissionFrame frame, EirUnary unary) {
    let operand = frame.value(unary.operand);
    Value produced = switch (unary.op) {
        Neg -> instructions.buildNeg(emitter.builder, operand, ""),
        FloatNeg -> instructions.buildFNeg(emitter.builder, operand, ""),
        Not -> instructions.buildNot(emitter.builder, operand, ""),
    };
    frame.define(unary.result, produced);
}

public emitCast(ModuleEmitter emitter, EmissionFrame frame, EirCast cast) {
    let operand = frame.value(cast.operand);
    let targetType = emitter.mapType(cast.type);
    Value produced = switch (cast.op) {
        Trunc -> instructions.buildTrunc(emitter.builder, operand, targetType, ""),
        ZeroExtend -> instructions.buildZExt(emitter.builder, operand, targetType, ""),
        SignExtend -> instructions.buildSExt(emitter.builder, operand, targetType, ""),
        FloatTrunc -> instructions.buildFPTrunc(emitter.builder, operand, targetType, ""),
        FloatExtend -> instructions.buildFPExt(emitter.builder, operand, targetType, ""),
        SignedToFloat -> instructions.buildSIToFP(emitter.builder, operand, targetType, ""),
        UnsignedToFloat -> instructions.buildUIToFP(emitter.builder, operand, targetType, ""),
        FloatToSigned -> instructions.buildFPToSI(emitter.builder, operand, targetType, ""),
        FloatToUnsigned -> instructions.buildFPToUI(emitter.builder, operand, targetType, ""),
        Reinterpret -> operand,
    };
    frame.define(cast.result, produced);
}

buildBinary(ModuleEmitter emitter, EirBinaryOp op, Value left, Value right) -> Value {
    return switch (op) {
        Add -> instructions.buildAdd(emitter.builder, left, right, ""),
        Sub -> instructions.buildSub(emitter.builder, left, right, ""),
        Mul -> instructions.buildMul(emitter.builder, left, right, ""),
        DivSigned -> instructions.buildSDiv(emitter.builder, left, right, ""),
        DivUnsigned -> instructions.buildUDiv(emitter.builder, left, right, ""),
        RemSigned -> instructions.buildSRem(emitter.builder, left, right, ""),
        RemUnsigned -> instructions.buildURem(emitter.builder, left, right, ""),
        FloatAdd -> instructions.buildFAdd(emitter.builder, left, right, ""),
        FloatSub -> instructions.buildFSub(emitter.builder, left, right, ""),
        FloatMul -> instructions.buildFMul(emitter.builder, left, right, ""),
        FloatDiv -> instructions.buildFDiv(emitter.builder, left, right, ""),
        FloatRem -> instructions.buildFRem(emitter.builder, left, right, ""),
        And -> instructions.buildAnd(emitter.builder, left, right, ""),
        Or -> instructions.buildOr(emitter.builder, left, right, ""),
        Xor -> instructions.buildXor(emitter.builder, left, right, ""),
        ShiftLeft -> instructions.buildShl(emitter.builder, left, right, ""),
        ShiftRightSigned -> instructions.buildAShr(emitter.builder, left, right, ""),
        ShiftRightUnsigned -> instructions.buildLShr(emitter.builder, left, right, ""),
        CmpEq -> instructions.buildICmpEQ(emitter.builder, left, right, ""),
        CmpNe -> instructions.buildICmpNE(emitter.builder, left, right, ""),
        CmpLtSigned -> instructions.buildICmpSLT(emitter.builder, left, right, ""),
        CmpLeSigned -> instructions.buildICmpSLE(emitter.builder, left, right, ""),
        CmpGtSigned -> instructions.buildICmpSGT(emitter.builder, left, right, ""),
        CmpGeSigned -> instructions.buildICmpSGE(emitter.builder, left, right, ""),
        CmpLtUnsigned -> instructions.buildICmpULT(emitter.builder, left, right, ""),
        CmpLeUnsigned -> instructions.buildICmpULE(emitter.builder, left, right, ""),
        CmpGtUnsigned -> instructions.buildICmpUGT(emitter.builder, left, right, ""),
        CmpGeUnsigned -> instructions.buildICmpUGE(emitter.builder, left, right, ""),
        FloatCmpEq -> instructions.buildFCmpOEQ(emitter.builder, left, right, ""),
        FloatCmpNe -> instructions.buildFCmpONE(emitter.builder, left, right, ""),
        FloatCmpLt -> instructions.buildFCmpOLT(emitter.builder, left, right, ""),
        FloatCmpLe -> instructions.buildFCmpOLE(emitter.builder, left, right, ""),
        FloatCmpGt -> instructions.buildFCmpOGT(emitter.builder, left, right, ""),
        FloatCmpGe -> instructions.buildFCmpOGE(emitter.builder, left, right, ""),
    };
}
