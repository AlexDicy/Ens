// The LLVM type each Ens type is emitted as. Strings and arrays are the payload pointer they are
// held by, an enum is the integer its members number, and a struct is a named LLVM struct whose
// body is its fields in declaration order.
//
// One mapper belongs to one module, because the named struct types it builds belong to that
// module's context.
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import StringType from @ens.sema.model.types;
import ArrayType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import EnumType from @ens.sema.model.types;
import Field from @ens.sema.model.types;
import @ens.sema.model.types;
import Context from @ens.llvm.core;
import TypeRef from @ens.llvm.types;
import List from @std.collections.list;
import Map from @std.collections.map;

public final class TypeMapper {
    Context context;
    Map<Type, TypeRef> structTypes;

    public constructor(Context context) {
        this.context = context;
        this.structTypes = new Map<Type, TypeRef>();
    }

    public map(Type type) -> TypeRef {
        if (types.isVoidType(type)) {
            return this.context.voidType();
        }
        if (type is PrimitiveType) {
            switch (type.kind()) {
                Bool -> {
                    return this.context.int1Type();
                },
                Byte -> {
                    return this.context.int8Type();
                },
                Short, UShort -> {
                    return this.context.int16Type();
                },
                Int, UInt, Char -> {
                    return this.context.int32Type();
                },
                Long, ULong -> {
                    return this.context.int64Type();
                },
                Float -> {
                    return this.context.floatType();
                },
                Double -> {
                    return this.context.doubleType();
                },
                default -> {
                    panic("Internal: no LLVM mapping for type "
                        + "'{types.display(type)}'");
                },
            }
        }
        if (type is StringType || type is ArrayType) {
            return this.context.pointerType();
        }
        if (type is EnumType) {
            if (type.isNumeric()) {
                return this.context.int64Type();
            }
            return this.context.int32Type();
        }
        if (type is StructType) {
            return this.mapStruct(type, type.fields());
        }
        panic("Internal: no LLVM mapping for type '{types.display(type)}'");
    }

    // A struct's named LLVM type, cached by the interned sema type. The name is registered before
    // the body is filled in, so a struct reaching itself through an array field terminates.
    mapStruct(Type type, List<Field> fields) -> TypeRef {
        let cached = this.structTypes.get(type);
        if (cached != null) {
            return cached;
        }
        let named = this.context.namedStructType(types.display(type));
        this.structTypes.set(type, named);
        let fieldTypes = new TypeRef[fields.length()];
        for (long i = 0; i < fieldTypes.length; i++) {
            fieldTypes[i] = this.map(fields.get(i).type());
        }
        named.setBody(fieldTypes, false);
        return named;
    }
}
