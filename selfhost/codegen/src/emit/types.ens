// The LLVM type each Ens type is emitted as. Strings, arrays and class references are the payload
// pointer they are held by, an enum is the integer its members number, and a struct is a named LLVM
// struct whose body is its fields in declaration order. An optional reference is the same pointer,
// absent meaning null, so it needs no tag.
//
// A class's own payload is a second named struct, reached through classLayout rather than map: a
// class-typed value is the pointer, while the fields sit in the object the pointer addresses. A
// weak field occupies one pointer there too, holding its side-table entry instead of the object.
//
// One mapper belongs to one module, because the named struct types it builds belong to that
// module's context.
import Type from @ens.sema.model.types;
import PrimitiveType from @ens.sema.model.types;
import StringType from @ens.sema.model.types;
import ArrayType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import NullType from @ens.sema.model.types;
import EnumType from @ens.sema.model.types;
import Field from @ens.sema.model.types;
import @ens.sema.model.types;
import Context from @ens.llvm.core;
import TypeRef from @ens.llvm.types;
import List from @std.collections.list;
import Map from @std.collections.map;

public final class TypeMapper {
    Context context;
    Map<Type, TypeRef> structTypes;
    Map<Type, TypeRef> classLayouts;

    public constructor(Context context) {
        this.context = context;
        this.structTypes = new Map<Type, TypeRef>();
        this.classLayouts = new Map<Type, TypeRef>();
    }

    // The payload layout of a class: its flattened fields in order, as a named LLVM struct. The
    // 32-byte header sits below the payload pointer and is not part of it.
    public classLayout(ClassType classType) -> TypeRef {
        let cached = this.classLayouts.get(classType);
        if (cached != null) {
            return cached;
        }
        let named = this.context.namedStructType("object." + types.display(classType));
        this.classLayouts.set(classType, named);
        let fields = classType.fields();
        let fieldTypes = new TypeRef[fields.length()];
        for (long i = 0; i < fieldTypes.length; i++) {
            fieldTypes[i] = this.map(fields.get(i).type());
        }
        named.setBody(fieldTypes, false);
        return named;
    }

    public map(Type type) -> TypeRef {
        if (types.isVoidType(type)) {
            return this.context.voidType();
        }
        if (type is PrimitiveType) {
            switch (type.kind()) {
                Bool -> {
                    return this.context.int1Type();
                },
                Byte -> {
                    return this.context.int8Type();
                },
                Short, UShort -> {
                    return this.context.int16Type();
                },
                Int, UInt, Char -> {
                    return this.context.int32Type();
                },
                Long, ULong -> {
                    return this.context.int64Type();
                },
                Float -> {
                    return this.context.floatType();
                },
                Double -> {
                    return this.context.doubleType();
                },
                default -> {
                    panic("Internal: no LLVM mapping for type "
                        + "'{types.display(type)}'");
                },
            }
        }
        if (type is StringType || type is ArrayType || type is ClassType
                || type is InterfaceType || type is NullType) {
            return this.context.pointerType();
        }
        if (type is OptionalType) {
            return this.map(type.inner());
        }
        if (type is EnumType) {
            if (type.isNumeric()) {
                return this.context.int64Type();
            }
            return this.context.int32Type();
        }
        if (type is StructType) {
            return this.mapStruct(type, type.fields());
        }
        panic("Internal: no LLVM mapping for type '{types.display(type)}'");
    }

    // A struct's named LLVM type, cached by the interned sema type. The name is registered before
    // the body is filled in, so a struct reaching itself through an array field terminates.
    mapStruct(Type type, List<Field> fields) -> TypeRef {
        let cached = this.structTypes.get(type);
        if (cached != null) {
            return cached;
        }
        let named = this.context.namedStructType(types.display(type));
        this.structTypes.set(type, named);
        let fieldTypes = new TypeRef[fields.length()];
        for (long i = 0; i < fieldTypes.length; i++) {
            fieldTypes[i] = this.map(fields.get(i).type());
        }
        named.setBody(fieldTypes, false);
        return named;
    }
}
