// Function values as heap objects. A closure object is one pointer wide, its payload the code
// pointer followed by one word per capture under the usual 32-byte header, and its descriptor
// slot stays null. A lambda with nothing to capture is an immortal read-only global instead.
import EirCallee from eir.model;
import EirClosureCall from eir.model;
import EirClosureCapture from eir.model;
import EirClosureNew from eir.model;
import Type from @ens.sema.model.types;
import FunctionType from @ens.sema.model.types;
import @ens.sema.model.types;
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Linkage from @ens.llvm.globals;
import @ens.llvm.globals;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import emit.exceptions;
import emit.signatures;
import support.primitives;
import List from @std.collections.list;

public emitClosureNew(ModuleEmitter emitter, EmissionFrame frame, EirClosureNew closure) -> string {
    let functionType = primitives.functionOf(closure.type);
    if (functionType == null) {
        return "Internal: closure.new produces a non-function type in {frame.symbol()}";
    }
    let target = bodyValue(emitter, closure.targetSymbol, functionType);
    if (closure.captureTypes.length == 0) {
        frame.define(closure.result, immortalObject(emitter, closure.targetSymbol, target));
        return "";
    }
    let layout = closureLayout(emitter, closure.captureTypes);
    let payloadBytes = emitter.context.int64Type().constInt(
        emitter.dataLayout().abiSizeOfType(layout), false);
    // No destructor is named when the captures hold no reference, so the object header carries
    // no finalizer and releasing it only gives the allocation back.
    let finalizer = emitter.runtime.nullPointer();
    if (closure.destructorSymbol.length > 0) {
        finalizer = emitter.objectDestructor(closure.destructorSymbol);
    }
    let object = emitter.runtime.call(emitter.runtime.alloc(),
        [payloadBytes, finalizer, emitter.runtime.nullPointer()], "closure");
    memory.buildStore(emitter.builder, target, object);
    frame.define(closure.result, object);
    return "";
}

public emitClosureCapture(ModuleEmitter emitter, EmissionFrame frame, EirClosureCapture capture) {
    frame.define(capture.result, memory.buildStructGEP(emitter.builder,
        closureLayout(emitter, capture.captureTypes), frame.value(capture.closure),
        (capture.captureIndex + 1) as uint, ""));
}

public emitClosureCall(ModuleEmitter emitter, EmissionFrame frame, EirClosureCall call) -> string {
    let functionType = primitives.functionOf(frame.tempType(call.closure));
    if (functionType == null) {
        return "Internal: closure_call calls a value that is not a function value in "
            + "{frame.symbol()}";
    }
    exceptions.markSite(emitter, frame, call.line);
    let produced = performClosureCall(emitter, frame, functionType, call.closure, call.arguments,
        null);
    if (call.result >= 0) {
        frame.define(call.result, produced);
    }
    return "";
}

// Builds one call through a function value's code pointer: the object ahead of the arguments,
// the error slot behind them when the ABI carries one. Shared by closure_call and try_closure_call.
public performClosureCall(ModuleEmitter emitter, EmissionFrame frame, FunctionType functionType,
                          long closure, long[] arguments, Value? errorSlot) -> Value {
    let closureValue = frame.value(closure);
    let target = memory.buildLoad(emitter.builder, emitter.context.pointerType(), closureValue,
        "closure.code");
    let argumentValues = new List<Value>();
    argumentValues.push(closureValue);
    for (let argument in arguments) {
        argumentValues.push(frame.value(argument));
    }
    if (errorSlot != null) {
        argumentValues.push(errorSlot);
    }
    return instructions.buildCall(emitter.builder,
        signatures.calleeType(emitter, calleeFor("", functionType)), target,
        argumentValues.toArray(), "");
}

// The body's value, declared here when this module only creates the closure. A lambda written in
// a parameter default is lowered wherever that default is filled in, so the module holding a
// creation is not always the one defining the body.
bodyValue(ModuleEmitter emitter, string symbol, FunctionType functionType) -> Value {
    return signatures.calleeValue(emitter, calleeFor(symbol, functionType));
}

// The shape a lambda's body is declared at, with the trailing error-slot parameter when the
// function type declares throws.
calleeFor(string symbol, FunctionType functionType) -> EirCallee {
    return new EirCallee(symbol, functionType, functionType.parameterTypes(),
        functionType.returnType(), functionType.declaresThrows());
}

// The payload layout of a closure object: the code pointer, then one field per capture. The type
// is a literal struct, which LLVM uniques by structure, so the same capture list always maps to
// the same type without a cache.
closureLayout(ModuleEmitter emitter, Type[] captureTypes) -> TypeRef {
    let fields = new List<TypeRef>();
    fields.push(emitter.context.pointerType());
    for (let captureType in captureTypes) {
        fields.push(emitter.mapType(captureType));
    }
    return emitter.context.structType(fields.toArray(), false);
}

// The read-only object a capture-free lambda hands out: a null type descriptor, the immortal
// strong count, no finalizer, no side table, and the code pointer as its whole payload. One global
// per lambda, so evaluating it never allocates.
immortalObject(ModuleEmitter emitter, string symbol, Value target) -> Value {
    let pointerType = emitter.context.pointerType();
    let objectType = emitter.context.structType([pointerType, emitter.context.int64Type(),
        pointerType, pointerType, pointerType], false);
    string name = ".closure." + symbol;
    let existing = globals.getNamedGlobal(emitter.module, name);
    if (existing != null) {
        return payloadOf(emitter, objectType, existing);
    }
    let global = globals.addGlobal(emitter.module, objectType, name);
    globals.setInitializer(global, objectType.constNamedStruct([
        emitter.runtime.nullPointer(),
        emitter.runtime.immortalCountValue(),
        emitter.runtime.nullPointer(),
        emitter.runtime.nullPointer(),
        target,
    ]));
    globals.setGlobalConstant(global, true);
    globals.setLinkage(global, Linkage.privateSymbol);
    globals.setAlignment(global, 8);
    return payloadOf(emitter, objectType, global);
}

payloadOf(ModuleEmitter emitter, TypeRef objectType, Value global) -> Value {
    return objectType.constInBoundsGEP(global,
        [emitter.runtime.int32(0), emitter.runtime.int32(4)]);
}
