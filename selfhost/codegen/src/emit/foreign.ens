// Foreign calls: the declaration under the exact C name, and the marshalling the declared sema
// types imply, where a string or array argument passes its data pointer, an out argument the
// address the C function writes back through, and a string result lifts into an owned Ens string.
import EirForeignCall from eir.model;
import EirCStringLift from eir.model;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import RuntimeFunction from emit.runtime;
import emit.childprocess;
import emit.children;
import emit.clock;
import emit.errorkinds;
import emit.filesystem;
import emit.streams;
import emit.system;
import support.primitives;
import List from @std.collections.list;

public emitForeignCall(ModuleEmitter emitter, EmissionFrame frame, EirForeignCall call)
        -> string {
    let target = resolveTarget(emitter, call);
    let arguments = new List<Value>();
    for (long i = 0; i < call.arguments.length; i++) {
        let value = frame.value(call.arguments[i]);
        if (call.outFlags[i]) {
            arguments.push(value);
        } else {
            arguments.push(marshalled(emitter, value, call.parameterTypes[i]));
        }
    }
    let produced = emitter.runtime.call(target, arguments.toArray(), "");
    if (call.result < 0) {
        return "";
    }
    if (returnsText(call.type)) {
        frame.define(call.result, emitter.runtime.call(emitter.runtime.stringFromCString(),
            [produced], "lifted"));
        return "";
    }
    frame.define(call.result, produced);
    return "";
}

public emitCStringLift(ModuleEmitter emitter, EmissionFrame frame, EirCStringLift lifted) {
    frame.define(lifted.result, emitter.runtime.call(emitter.runtime.stringFromCString(),
        [frame.value(lifted.handle)], "lifted"));
}

// The function a foreign call runs: the std.system bridges are defined by the compiler wherever
// they are referenced, everything else is declared under its C name. Each call site
// keeps its own declared signature, so a user redeclaration of a symbol the runtime also uses -
// strlen, say, at a narrower return type - never perturbs the other's calls.
resolveTarget(ModuleEmitter emitter, EirForeignCall call) -> RuntimeFunction {
    let runtime = emitter.runtime;
    switch (call.symbol) {
        "ens_arguments" -> {
            return system.argumentsRuntime(runtime, stringElementFinalizer(emitter, call.type));
        },
        "ens_environment" -> {
            return system.environmentRuntime(runtime, stringElementFinalizer(emitter, call.type));
        },
        "ens_executable_path" -> {
            return system.executablePathRuntime(runtime);
        },
        "ens_current_directory" -> {
            return system.currentDirectoryRuntime(runtime);
        },
        "ens_platform" -> {
            return system.platformRuntime(runtime);
        },
        "ens_standard_output" -> {
            return system.standardOutputRuntime(runtime);
        },
        "ens_standard_error" -> {
            return system.standardErrorRuntime(runtime);
        },
        "ens_standard_input" -> {
            return system.standardInputRuntime(runtime);
        },
        "ens_start_process" -> {
            return children.startProcessRuntime(runtime);
        },
        "ens_read_child" -> {
            return children.readChildRuntime(runtime);
        },
        "ens_poll_child" -> {
            return children.pollChildRuntime(runtime);
        },
        "ens_kill_child" -> {
            return children.killChildRuntime(runtime);
        },
        "ens_wait_child" -> {
            return children.waitChildRuntime(runtime);
        },
        "ens_release_child" -> {
            return children.releaseChildRuntime(runtime);
        },
        "ens_process_start" -> {
            return childprocess.startRuntime(runtime);
        },
        "ens_process_read" -> {
            return childprocess.readRuntime(runtime);
        },
        "ens_process_write" -> {
            return childprocess.writeRuntime(runtime);
        },
        "ens_process_close_input" -> {
            return childprocess.closeInputRuntime(runtime);
        },
        "ens_process_poll" -> {
            return childprocess.pollRuntime(runtime);
        },
        "ens_process_wait" -> {
            return childprocess.waitRuntime(runtime);
        },
        "ens_process_kill" -> {
            return childprocess.killRuntime(runtime);
        },
        "ens_process_release" -> {
            return childprocess.releaseRuntime(runtime);
        },
        "ens_process_error_kind" -> {
            return errorkinds.processErrorKindRuntime(runtime);
        },
        "ens_monotonic_millis" -> {
            return clock.monotonicMillisRuntime(runtime);
        },
        "ens_sleep_millis" -> {
            return clock.sleepMillisRuntime(runtime);
        },
        "ens_fs_metadata" -> {
            return filesystem.metadataRuntime(runtime);
        },
        "ens_fs_real_path" -> {
            return filesystem.realPathRuntime(runtime);
        },
        "ens_fs_error_kind" -> {
            return errorkinds.errorKindRuntime(runtime);
        },
        "ens_fs_open" -> {
            return filesystem.openRuntime(runtime);
        },
        "ens_fs_create_directory" -> {
            return filesystem.makeDirectoryRuntime(runtime);
        },
        "ens_fs_remove_file" -> {
            return filesystem.removeFileRuntime(runtime);
        },
        "ens_fs_remove_directory" -> {
            return filesystem.removeDirectoryRuntime(runtime);
        },
        "ens_fs_rename" -> {
            return filesystem.renameRuntime(runtime);
        },
        "ens_fs_copy_permissions" -> {
            return filesystem.copyPermissionsRuntime(runtime);
        },
        "ens_fs_open_directory" -> {
            return filesystem.openDirectoryRuntime(runtime);
        },
        "ens_fs_next_entry" -> {
            return filesystem.nextEntryRuntime(runtime);
        },
        "ens_fs_close_directory" -> {
            return filesystem.closeDirectoryRuntime(runtime);
        },
        "ens_stream_write" -> {
            return streams.writeRuntime(runtime);
        },
        "ens_stream_read" -> {
            return streams.readRuntime(runtime);
        },
        "ens_stream_flush" -> {
            return streams.flushRuntime(runtime);
        },
        "ens_stream_close" -> {
            return streams.closeRuntime(runtime);
        },
        "ens_io_error_kind" -> {
            return errorkinds.ioErrorKindRuntime(runtime);
        },
        "ens_fs_errno_kind" -> {
            return errorkinds.fsErrnoKindRuntime(runtime);
        },
        default -> { },
    }
    let type = foreignType(emitter, call);
    let found = globals.getNamedFunction(runtime.module, call.symbol);
    if (found != null) {
        return new RuntimeFunction(found, type);
    }
    return new RuntimeFunction(runtime.module.addFunction(call.symbol, type), type);
}

// The finalizer an owned array of strings stores in its header, read off the declared result type
// so the bridge that builds the array releases exactly what the array's element type owns.
stringElementFinalizer(ModuleEmitter emitter, Type declared) -> Value {
    let array = primitives.arrayOf(declared);
    if (array == null) {
        return emitter.runtime.nullPointer();
    }
    return emitter.finalizers.arrayFinalizer(array.element());
}

// The LLVM type of the C function: pointers where the declaration says string, array, handle, or
// out, and the mapped machine type everywhere else.
foreignType(ModuleEmitter emitter, EirForeignCall call) -> TypeRef {
    let parameters = new List<TypeRef>();
    for (long i = 0; i < call.parameterTypes.length; i++) {
        if (call.outFlags[i] || passesPointer(call.parameterTypes[i])) {
            parameters.push(emitter.context.pointerType());
        } else {
            parameters.push(emitter.mapType(call.parameterTypes[i]));
        }
    }
    TypeRef returned = emitter.context.voidType();
    if (!types.isVoidType(call.type)) {
        if (returnsText(call.type) || primitives.externalOf(call.type) != null) {
            returned = emitter.context.pointerType();
        } else {
            returned = emitter.mapType(call.type);
        }
    }
    return returned.functionType(parameters.toArray());
}

// True when the declared parameter crosses the boundary as a pointer: a string or an array as
// its data, a handle as itself.
passesPointer(Type declared) -> bool {
    return primitives.isStringType(declared) || stringOptional(declared)
        || primitives.isArrayType(declared) || primitives.externalOf(declared) != null;
}

// A string or array argument crosses the boundary as its data pointer; everything else passes
// as its machine value.
marshalled(ModuleEmitter emitter, Value value, Type declared) -> Value {
    if (primitives.isStringType(declared) || stringOptional(declared)) {
        return emitter.runtime.payloadData(value);
    }
    if (primitives.isArrayType(declared)) {
        return emitter.runtime.payloadData(value);
    }
    return value;
}

// True when the declared result is a string or string?, which arrives as a C pointer and lifts
// into an owned Ens string.
returnsText(Type declared) -> bool {
    return primitives.isStringType(declared) || stringOptional(declared);
}

stringOptional(Type declared) -> bool {
    if (!primitives.isOptionalType(declared)) {
        return false;
    }
    let referent = primitives.referenceOf(declared);
    return referent != null && primitives.isStringType(referent);
}
