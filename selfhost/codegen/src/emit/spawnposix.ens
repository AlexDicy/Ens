// The POSIX pieces both child families share: the wait that a signal cannot cut short, the status
// it leaves, and the vectors that point into the NUL separated blocks the caller built.
import Value from @ens.llvm.values;
import BasicBlock from @ens.llvm.blocks;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;

// Waits for the child and leaves its raw wait status in the slot, going on to `lostBlock` when no
// status could be read at all and leaving the builder where the status is known. A signal arriving
// mid-wait says nothing about the child, so the wait is asked again; any other refusal is a failure,
// because a status nobody read stands for no exit code at all.
public awaitChild(Runtime runtime, RuntimeDefinition definition, Value child, Value statusSlot,
                  BasicBlock lostBlock, string label) {
    let builder = runtime.builder;
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let askBlock = runtime.block(definition, label + ".ask");
    let refusedBlock = runtime.block(definition, label + ".refused");
    let knownBlock = runtime.block(definition, label + ".known");
    instructions.buildBr(builder, askBlock);

    builder.positionAtEnd(askBlock);
    memory.buildStore(builder, runtime.int32(0), statusSlot);
    let answer = runtime.call(waitForChild, [child, statusSlot, runtime.int32(0)], label);
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, answer, runtime.int32(0), ""), refusedBlock, knownBlock);

    // EINTR: a signal arrived while waiting, which is no answer about the child, so the wait is asked
    // again rather than reported as a failure.
    builder.positionAtEnd(refusedBlock);
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(4), ""), askBlock, lostBlock);

    builder.positionAtEnd(knownBlock);
}

// The exit code a POSIX wait status stands for: the low seven bits name the signal that ended the
// child, so a child that exited carries its code eight bits up and one that was killed reports 128
// plus its signal, the way a shell reports it.
public normalizedStatus(Runtime runtime, Value status) -> Value {
    let builder = runtime.builder;
    let signal = instructions.buildAnd(builder, status, runtime.int32(127), "signal");
    let exited = instructions.buildICmpEQ(builder, signal, runtime.int32(0), "exited");
    let signaled = instructions.buildAnd(builder,
        instructions.buildICmpNE(builder, signal, runtime.int32(0), ""),
        instructions.buildICmpNE(builder, signal, runtime.int32(127), ""), "signaled");
    let exitCode = instructions.buildAnd(builder,
        instructions.buildLShr(builder, status, runtime.int32(8), ""),
        runtime.int32(255), "exit.code");
    let signalCode = instructions.buildAdd(builder, signal, runtime.int32(128), "signal.code");
    return instructions.buildSelect(builder, exited, exitCode,
        instructions.buildSelect(builder, signaled, signalCode, status, ""), "normalized");
}

// Fills a pointer vector from a NUL separated block: the block holds the values one after another,
// each NUL terminated, so every slot points straight into it and the cursor walks past one
// terminator per value. The slot after the last one is left null, which is where a C vector ends.
public blockVector(Runtime runtime, RuntimeDefinition definition, Value vector, Value offset,
                   Value block, Value count, string label) {
    let builder = runtime.builder;
    let measure = runtime.strlen();
    let testBlock = runtime.block(definition, label + ".test");
    let bodyBlock = runtime.block(definition, label + ".body");
    let doneBlock = runtime.block(definition, label + ".done");
    let indexSlot = memory.buildAlloca(builder, runtime.int64Type, "index");
    let cursorSlot = memory.buildAlloca(builder, runtime.pointerType, "cursor");
    memory.buildStore(builder, runtime.int64(0), indexSlot);
    memory.buildStore(builder, block, cursorSlot);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(testBlock);
    let index = memory.buildLoad(builder, runtime.int64Type, indexSlot, "index.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, index, count, ""), bodyBlock, doneBlock);

    builder.positionAtEnd(bodyBlock);
    let cursor = memory.buildLoad(builder, runtime.pointerType, cursorSlot, "cursor.cur");
    memory.buildStore(builder, cursor, memory.buildGEP(builder, runtime.pointerType, vector,
        [instructions.buildAdd(builder, offset, index, "")], "slot"));
    let used = instructions.buildAdd(builder, runtime.call(measure, [cursor], "value.length"),
        runtime.int64(1), "");
    memory.buildStore(builder, memory.buildGEP(builder, runtime.int8Type, cursor, [used], ""),
        cursorSlot);
    memory.buildStore(builder, instructions.buildAdd(builder, index, runtime.int64(1), ""),
        indexSlot);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(doneBlock);
    memory.buildStore(builder, runtime.nullPointer(), memory.buildGEP(builder,
        runtime.pointerType, vector, [instructions.buildAdd(builder, offset, count, "")],
        "vector.end"));
}
