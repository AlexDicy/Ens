// The calls emission makes: a call to a function the program declares, direct or dispatched, and
// the two runtime primitives that consume a string - the print that writes a line and the panic
// that aborts. A method's receiver is passed as the address of the storage it runs over, ahead
// of the arguments.
//
// A dispatched call reads its target out of the receiver's runtime type: the descriptor sits in
// the object header, a virtual call indexes its vtable, and an interface call looks the
// interface's method table up in its conformances first. The call itself is then built exactly
// like a direct one, at the type the statically resolved callee declares.
import EirCall from eir.model;
import EirPrint from eir.model;
import EirPanic from eir.model;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import emit.signatures;

public emitCall(ModuleEmitter emitter, EmissionFrame frame, EirCall call) {
    long offset = 0;
    if (call.receiver >= 0) {
        offset = 1;
    }
    let argumentValues = new Value[call.arguments.length + offset];
    for (long i = 0; i < argumentValues.length; i++) {
        argumentValues[i] = i < offset ? frame.value(call.receiver)
            : frame.value(call.arguments[i - offset]);
    }
    Value produced;
    if (call.dispatchSlot >= 0) {
        let target = dispatchTarget(emitter, frame, call);
        produced = instructions.buildCall(emitter.builder,
            signatures.calleeType(emitter, call.callee), target, argumentValues, "");
    } else {
        let callee = signatures.calleeValue(emitter, call.callee);
        produced = instructions.buildCall(emitter.builder,
            emitter.calleeType(call.callee.symbol()), callee, argumentValues, "");
    }
    if (call.result >= 0) {
        frame.define(call.result, produced);
    }
}

// The function pointer a dispatched call runs: slot dispatchSlot of the receiver's vtable, or of
// its method table for the named interface.
dispatchTarget(ModuleEmitter emitter, EmissionFrame frame, EirCall call) -> Value {
    let descriptors = emitter.descriptors;
    let builder = emitter.builder;
    let pointerType = emitter.context.pointerType();
    let descriptor = descriptors.loadDescriptor(frame.value(call.receiver));
    Value table;
    let dispatchInterface = call.dispatchInterface;
    if (dispatchInterface != null) {
        table = emitter.runtime.call(descriptors.itableLookup(),
            [descriptor, descriptors.descriptorValue(dispatchInterface)], "itable");
    } else {
        let tableSlot = memory.buildStructGEP(builder, descriptors.descriptorType(), descriptor,
            3, "");
        table = memory.buildLoad(builder, pointerType, tableSlot, "vtable");
    }
    let functionSlot = memory.buildGEP(builder, pointerType, table,
        [emitter.runtime.int64(call.dispatchSlot)], "");
    return memory.buildLoad(builder, pointerType, functionSlot, "target");
}

public emitPrint(ModuleEmitter emitter, EmissionFrame frame, EirPrint printed) {
    emitter.runtime.call(emitter.runtime.print(), [frame.value(printed.value)], "");
}

public emitPanic(ModuleEmitter emitter, EmissionFrame frame, EirPanic aborted) {
    emitter.runtime.call(emitter.runtime.panic(), [frame.value(aborted.value)], "");
}
