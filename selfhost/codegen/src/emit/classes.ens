// Classes as heap objects. A class reference is the payload pointer, so a field is a struct
// getelementptr straight off it and the 32-byte header stays below it. Weak storage holds a
// side-table entry, so it is written by ens_weak_init and read by the upgrading ens_weak_load.
import EirClassNew from eir.model;
import EirObjectFieldAddress from eir.model;
import EirTypeTest from eir.model;
import EirCheckedCast from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import EirRuntimeTypeName from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import Type from @ens.sema.model.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import support.primitives;

public emitClassNew(ModuleEmitter emitter, EmissionFrame frame, EirClassNew allocation) -> string {
    let classType = primitives.classOf(allocation.type);
    if (classType == null) {
        return "Internal: class.new produces a non-class type in {frame.symbol()}";
    }
    let layout = emitter.classLayout(classType);
    let payloadBytes = emitter.context.int64Type().constInt(
        emitter.dataLayout().abiSizeOfType(layout), false);
    let finalizer = emitter.objectDestructor(allocation.destructorSymbol);
    let descriptor = emitter.descriptors.descriptorValue(classType);
    frame.define(allocation.result, emitter.runtime.call(emitter.runtime.alloc(),
        [payloadBytes, finalizer, descriptor], ""));
    return "";
}

// 'value is Type': one call into the null-safe runtime test, a parent-chain walk for a class
// target and a conformance lookup for an interface target.
public emitTypeTest(ModuleEmitter emitter, EmissionFrame frame, EirTypeTest test) {
    frame.define(test.result, matchRuntimeType(emitter, frame.value(test.value), test.target));
}

// 'value as? Type': the same test selecting the value on a match and null otherwise.
public emitCheckedCast(ModuleEmitter emitter, EmissionFrame frame, EirCheckedCast cast) {
    let value = frame.value(cast.value);
    let matches = matchRuntimeType(emitter, value, cast.target);
    frame.define(cast.result, instructions.buildSelect(emitter.builder, matches, value,
        emitter.context.pointerType().constNull(), ""));
}

// '==' decided by the operands' runtime types: one call into the helper that carries the whole
// rule, so nothing about the operands' static type is emitted here.
public emitDynamicEquals(ModuleEmitter emitter, EmissionFrame frame, EirDynamicEquals equal) {
    frame.define(equal.result, emitter.runtime.call(emitter.descriptors.dynamicEquals(),
        [frame.value(equal.left), frame.value(equal.right)], ""));
}

// The hash the value's runtime type answers with, or its identity hash when that type declared
// none: again one call into the helper.
public emitDynamicHash(ModuleEmitter emitter, EmissionFrame frame, EirDynamicHash hashed) {
    frame.define(hashed.result, emitter.runtime.call(emitter.descriptors.dynamicHash(),
        [frame.value(hashed.value)], ""));
}

// The text the value's runtime type answers with, or its type name when that type declared no
// 'toString': again one call into the helper.
public emitDynamicToString(ModuleEmitter emitter, EmissionFrame frame, EirDynamicToString text) {
    frame.define(text.result, emitter.runtime.call(emitter.descriptors.dynamicToString(),
        [frame.value(text.value)], ""));
}

public emitRuntimeTypeName(ModuleEmitter emitter, EmissionFrame frame, EirRuntimeTypeName named) {
    frame.define(named.result, emitter.runtime.call(emitter.descriptors.typeName(),
        [frame.value(named.value)], ""));
}

matchRuntimeType(ModuleEmitter emitter, Value value, Type target) -> Value {
    let descriptors = emitter.descriptors;
    let targetDescriptor = descriptors.descriptorValue(target);
    if (primitives.interfaceOf(target) != null) {
        return emitter.runtime.call(descriptors.conforms(), [value, targetDescriptor], "");
    }
    return emitter.runtime.call(descriptors.typeIs(), [value, targetDescriptor], "");
}

public emitObjectFieldAddress(ModuleEmitter emitter, EmissionFrame frame,
                              EirObjectFieldAddress address) -> string {
    let classType = primitives.classOf(frame.tempType(address.object));
    if (classType == null) {
        return "Internal: a field address reaches into a non-class value in {frame.symbol()}";
    }
    frame.define(address.result, memory.buildStructGEP(emitter.builder,
        emitter.classLayout(classType), frame.value(address.object),
        address.fieldIndex as uint, ""));
    return "";
}

public emitWeakStore(ModuleEmitter emitter, EmissionFrame frame, EirWeakStore store) {
    let entry = emitter.runtime.call(emitter.runtime.weakInitialize(),
        [frame.value(store.value)], "");
    let previous = loadEntry(emitter, frame.value(store.address));
    emitter.runtime.call(emitter.runtime.weakRelease(), [previous], "");
    memory.buildStore(emitter.builder, entry, frame.value(store.address));
}

public emitWeakLoad(ModuleEmitter emitter, EmissionFrame frame, EirWeakLoad load) {
    let entry = loadEntry(emitter, frame.value(load.address));
    frame.define(load.result, emitter.runtime.call(emitter.runtime.weakLoad(), [entry], ""));
}

public emitWeakRelease(ModuleEmitter emitter, EmissionFrame frame, EirWeakRelease release) {
    let entry = loadEntry(emitter, frame.value(release.address));
    emitter.runtime.call(emitter.runtime.weakRelease(), [entry], "");
    memory.buildStore(emitter.builder, emitter.context.pointerType().constNull(),
        frame.value(release.address));
}

// The side-table entry weak storage currently points at.
loadEntry(ModuleEmitter emitter, Value address) -> Value {
    return memory.buildLoad(emitter.builder, emitter.context.pointerType(), address, "");
}
