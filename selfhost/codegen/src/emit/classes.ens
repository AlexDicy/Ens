// Classes as heap objects: the allocation a 'new' becomes, the address of a field inside one, and
// the three weak operations. A class reference is the payload pointer, so a field is a struct
// getelementptr straight off it and the 32-byte header stays below, reached only by the runtime.
//
// Weak storage holds a side-table entry rather than the object, which is why writing it goes
// through ens_weak_init and reading it through the upgrading ens_weak_load instead of the plain
// load and store a strong field uses.
import EirClassNew from eir.model;
import EirObjectFieldAddress from eir.model;
import EirWeakStore from eir.model;
import EirWeakLoad from eir.model;
import EirWeakRelease from eir.model;
import Value from @ens.llvm.values;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import support.primitives;

public emitClassNew(ModuleEmitter emitter, EmissionFrame frame, EirClassNew allocation) -> string {
    let classType = primitives.classOf(allocation.type);
    if (classType == null) {
        return "Internal: class.new produces a non-class type in {frame.symbol()}";
    }
    let layout = emitter.classLayout(classType);
    let payloadBytes = emitter.context.int64Type().constInt(
        emitter.dataLayout().abiSizeOfType(layout), false);
    let finalizer = emitter.objectDestructor(allocation.destructorSymbol);
    frame.define(allocation.result, emitter.runtime.call(emitter.runtime.alloc(),
        [payloadBytes, finalizer, emitter.context.pointerType().constNull()], ""));
    return "";
}

public emitObjectFieldAddress(ModuleEmitter emitter, EmissionFrame frame,
                              EirObjectFieldAddress address) -> string {
    let classType = primitives.classOf(frame.tempType(address.object));
    if (classType == null) {
        return "Internal: a field address reaches into a non-class value in {frame.symbol()}";
    }
    frame.define(address.result, memory.buildStructGEP(emitter.builder,
        emitter.classLayout(classType), frame.value(address.object),
        address.fieldIndex as uint, ""));
    return "";
}

public emitWeakStore(ModuleEmitter emitter, EmissionFrame frame, EirWeakStore store) {
    let entry = emitter.runtime.call(emitter.runtime.weakInitialize(),
        [frame.value(store.value)], "");
    let previous = loadEntry(emitter, frame.value(store.address));
    emitter.runtime.call(emitter.runtime.weakRelease(), [previous], "");
    memory.buildStore(emitter.builder, entry, frame.value(store.address));
}

public emitWeakLoad(ModuleEmitter emitter, EmissionFrame frame, EirWeakLoad load) {
    let entry = loadEntry(emitter, frame.value(load.address));
    frame.define(load.result, emitter.runtime.call(emitter.runtime.weakLoad(), [entry], ""));
}

public emitWeakRelease(ModuleEmitter emitter, EmissionFrame frame, EirWeakRelease release) {
    let entry = loadEntry(emitter, frame.value(release.address));
    emitter.runtime.call(emitter.runtime.weakRelease(), [entry], "");
    memory.buildStore(emitter.builder, emitter.context.pointerType().constNull(),
        frame.value(release.address));
}

// The side-table entry weak storage currently points at.
loadEntry(ModuleEmitter emitter, Value address) -> Value {
    return memory.buildLoad(emitter.builder, emitter.context.pointerType(), address, "");
}
