// The maps from a platform's own error number to a std.fs ErrorKind and to a std.process ErrorKind.
// Each table is a value derived from the target triple, and each bridge is its table turned into
// one switch.
import Value from @ens.llvm.values;
import BasicBlock from @ens.llvm.blocks;
import @ens.llvm.instructions;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import List from @std.collections.list;
import Platform from @std.platform;

// The std.fs ErrorKind ordinals, in the order std.fs declares its members.
public final class ErrorKind {
    public static const long notFound = 0;
    public static const long permissionDenied = 1;
    public static const long alreadyExists = 2;
    public static const long notADirectory = 3;
    public static const long isADirectory = 4;
    public static const long directoryNotEmpty = 5;
    public static const long noSpace = 6;
    public static const long other = 7;

    public static const long count = 8;
}

// The ordinals the std.process start bridge gives an error number. NotFound, PermissionDenied and
// Other are the std.process ErrorKind members of those names. Every other ordinal is a condition
// that ErrorKind reports as Other and that a failed start's message names.
public final class ProcessErrorKind {
    public static const long notFound = 0;
    public static const long permissionDenied = 1;
    public static const long outOfMemory = 2;
    public static const long programFileLimit = 3;
    public static const long systemFileLimit = 4;
    public static const long processLimit = 5;
    public static const long systemResources = 6;
    public static const long other = 7;

    public static const long count = 8;
}

// The std.io.streams ErrorKind ordinals, in the order that module declares its members.
public final class IoErrorKind {
    public static const long closed = 0;
    public static const long interrupted = 1;
    public static const long other = 2;

    public static const long count = 3;
}

// The errno numbers a C library reports and reads. Each number in the first group is one every
// library numbers the same. Each later group is one library's own.
public final class Errno {
    public static const long notOwner = 1;
    public static const long noEntry = 2;
    public static const long noSuchProcess = 3;
    public static const long interrupted = 4;
    public static const long outOfMemory = 12;
    public static const long notExecutable = 8;
    public static const long accessDenied = 13;
    public static const long exists = 17;
    public static const long notADirectory = 20;
    public static const long isADirectory = 21;
    public static const long invalidArgument = 22;
    public static const long systemFileLimit = 23;
    public static const long programFileLimit = 24;
    public static const long noSpace = 28;
    public static const long readOnlyFileSystem = 30;
    public static const long brokenPipe = 32;

    public static const long linuxTryAgain = 11;
    public static const long linuxNotEmpty = 39;
    public static const long linuxQuotaExceeded = 122;

    public static const long darwinTryAgain = 35;
    public static const long darwinNotEmpty = 66;
    public static const long darwinQuotaExceeded = 69;

    // The Microsoft runtime numbers a full directory its own way and defines no quota error at all.
    public static const long windowsNotEmpty = 41;
}

// What part of a failed start the error number is about, carried in the bits above the number so
// the library can name it. A failure before the program was reached carries none.
public final class StartCause {
    // The program, when nothing more particular is known.
    public static const long program = 1;
    public static const long workingDirectory = 2;
    // A program path that names a directory.
    public static const long directory = 3;
    // A program image built for another system.
    public static const long notRunnable = 4;
    // A file that holds no program, such as a document.
    public static const long notProgram = 5;
    // A special file, such as a named pipe or a device.
    public static const long specialFile = 6;
    // A working directory that is a file.
    public static const long workingDirectoryFile = 7;
    // A script whose first line names a program that is not there.
    public static const long missingInterpreter = 8;
    // A file marked runnable that starts neither the way a program image nor a script does.
    public static const long noProgramStart = 9;
    // A refused permission on a file that is runnable, or whose kind cannot be read.
    public static const long refusedOnPath = 10;
    // A script the system would not start, or refused to run, over the program its first line
    // names.
    public static const long refusedScript = 11;

    public static const long shift = 24;
    public static const long numberMask = 0xFFFFFF;
}

// The Win32 error codes the Windows bridges report and read. Nothing here means IsADirectory,
// which Win32 has no code for and reports as ERROR_ACCESS_DENIED instead.
public final class Win32Error {
    public static const long fileNotFound = 2;
    public static const long pathNotFound = 3;
    public static const long accessDenied = 5;
    public static const long invalidHandle = 6;
    public static const long notEnoughMemory = 8;
    public static const long outOfMemory = 14;
    public static const long invalidDrive = 15;
    public static const long writeProtected = 19;
    public static const long sharingViolation = 32;
    public static const long lockViolation = 33;
    public static const long handleDiskFull = 39;
    public static const long badNetworkPath = 53;
    public static const long fileExists = 80;
    public static const long invalidParameter = 87;
    public static const long brokenPipe = 109;
    public static const long diskFull = 112;
    public static const long directoryNotEmpty = 145;
    public static const long badPathName = 161;
    public static const long alreadyExists = 183;
    public static const long pipeBusy = 231;
    public static const long noData = 232;
    public static const long notADirectory = 267;
    public static const long elevationRequired = 740;
    public static const long operationAborted = 995;
    public static const long ioPending = 997;
    public static const long accessDisabledByPolicy = 1260;
    public static const long noSystemResources = 1450;
    public static const long badExecutableFormat = 193;
    public static const long machineMismatch = 216;
}

// One error number and the kind it means.
public final class ErrorMapping {
    public const long code;
    public const long kind;

    public constructor(this.code, this.kind);
}

// Every error number this target's file bridges report that means more than that something failed.
// A number missing from the table is an Other, so nothing has to be listed twice.
public errorMappings(Platform platform) -> ErrorMapping[] {
    return switch (platform) {
        Platform.Windows -> windowsMappings(),
        Platform.Linux -> posixMappings(false),
        Platform.MacOS -> posixMappings(true),
    };
}

windowsMappings() -> ErrorMapping[] {
    let mappings = new List<ErrorMapping>();
    mappings.push(new ErrorMapping(Win32Error.fileNotFound, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Win32Error.pathNotFound, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Win32Error.invalidDrive, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Win32Error.badNetworkPath, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Win32Error.badPathName, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Win32Error.accessDenied, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Win32Error.writeProtected, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Win32Error.sharingViolation, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Win32Error.lockViolation, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Win32Error.fileExists, ErrorKind.alreadyExists));
    mappings.push(new ErrorMapping(Win32Error.alreadyExists, ErrorKind.alreadyExists));
    mappings.push(new ErrorMapping(Win32Error.notADirectory, ErrorKind.notADirectory));
    mappings.push(new ErrorMapping(Win32Error.directoryNotEmpty, ErrorKind.directoryNotEmpty));
    mappings.push(new ErrorMapping(Win32Error.handleDiskFull, ErrorKind.noSpace));
    mappings.push(new ErrorMapping(Win32Error.diskFull, ErrorKind.noSpace));
    return mappings.toArray();
}

// The errno numbers every C library agrees on, and the kind each one means for a file call. What a
// library numbers for itself is added by the caller.
sharedErrnoMappings() -> List<ErrorMapping> {
    let mappings = new List<ErrorMapping>();
    mappings.push(new ErrorMapping(Errno.noEntry, ErrorKind.notFound));
    mappings.push(new ErrorMapping(Errno.notOwner, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Errno.accessDenied, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Errno.readOnlyFileSystem, ErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Errno.exists, ErrorKind.alreadyExists));
    mappings.push(new ErrorMapping(Errno.notADirectory, ErrorKind.notADirectory));
    mappings.push(new ErrorMapping(Errno.isADirectory, ErrorKind.isADirectory));
    mappings.push(new ErrorMapping(Errno.noSpace, ErrorKind.noSpace));
    return mappings;
}

posixMappings(bool onDarwin) -> ErrorMapping[] {
    let mappings = sharedErrnoMappings();
    if (onDarwin) {
        mappings.push(new ErrorMapping(Errno.darwinNotEmpty, ErrorKind.directoryNotEmpty));
        mappings.push(new ErrorMapping(Errno.darwinQuotaExceeded, ErrorKind.noSpace));
    } else {
        mappings.push(new ErrorMapping(Errno.linuxNotEmpty, ErrorKind.directoryNotEmpty));
        mappings.push(new ErrorMapping(Errno.linuxQuotaExceeded, ErrorKind.noSpace));
    }
    return mappings.toArray();
}

// Every errno a file call reports on this target that means more than that it failed. A target
// whose file bridges already return errno reads the same table as 'errorMappings' gives them.
// Windows is the one that differs. Its file bridges return Win32 codes while its stream calls return
// errno. The two numbering spaces need a table each.
public fsErrnoMappings(Platform platform) -> ErrorMapping[] {
    return switch (platform) {
        Platform.Windows -> windowsErrnoMappings(),
        Platform.Linux -> posixMappings(false),
        Platform.MacOS -> posixMappings(true),
    };
}

// The Microsoft runtime's own errno numbers. It agrees on the shared set and numbers a full
// directory for itself. It defines no quota error. A spent quota is therefore reported as whatever
// else it reported.
windowsErrnoMappings() -> ErrorMapping[] {
    let mappings = sharedErrnoMappings();
    mappings.push(new ErrorMapping(Errno.windowsNotEmpty, ErrorKind.directoryNotEmpty));
    return mappings.toArray();
}

// Every error number a stream call reports that means more than that it failed. The stream bridges
// return the C library's own number on every target. One table therefore serves them all.
//
// A number with more than one cause is left out. EBADF covers both a stream this program closed
// and a write to one opened for reading. ENOSPC names no stream condition at all.
public ioErrorMappings() -> ErrorMapping[] {
    let mappings = new List<ErrorMapping>();
    mappings.push(new ErrorMapping(Errno.brokenPipe, IoErrorKind.closed));
    mappings.push(new ErrorMapping(Errno.interrupted, IoErrorKind.interrupted));
    return mappings.toArray();
}

// Every Win32 number a Windows stream read reports that means more than that it failed, which is
// what the console reader reports. A pipe whose writer is gone is closed, and a read the console
// ended, as Ctrl+C does, was interrupted.
public ioWin32Mappings() -> ErrorMapping[] {
    let mappings = new List<ErrorMapping>();
    mappings.push(new ErrorMapping(Win32Error.brokenPipe, IoErrorKind.closed));
    mappings.push(new ErrorMapping(Win32Error.noData, IoErrorKind.closed));
    mappings.push(new ErrorMapping(Win32Error.operationAborted, IoErrorKind.interrupted));
    return mappings.toArray();
}

// Every error number this target's start of a child reports that means more than that it failed.
// A path leading through a file is a program that is not there, and a start Windows refuses for
// lack of elevation or by policy is a permission it does not have. A start that runs out of memory,
// of open files or of processes is told apart by the number each system gives that condition.
public processErrorMappings(Platform platform) -> ErrorMapping[] {
    let mappings = new List<ErrorMapping>();
    if (platform == Platform.Windows) {
        mappings.push(new ErrorMapping(Win32Error.fileNotFound, ProcessErrorKind.notFound));
        mappings.push(new ErrorMapping(Win32Error.pathNotFound, ProcessErrorKind.notFound));
        mappings.push(new ErrorMapping(Win32Error.notADirectory, ProcessErrorKind.notFound));
        mappings.push(new ErrorMapping(Win32Error.accessDenied,
            ProcessErrorKind.permissionDenied));
        mappings.push(new ErrorMapping(Win32Error.elevationRequired,
            ProcessErrorKind.permissionDenied));
        mappings.push(new ErrorMapping(Win32Error.accessDisabledByPolicy,
            ProcessErrorKind.permissionDenied));
        mappings.push(new ErrorMapping(Win32Error.notEnoughMemory, ProcessErrorKind.outOfMemory));
        mappings.push(new ErrorMapping(Win32Error.outOfMemory, ProcessErrorKind.outOfMemory));
        mappings.push(new ErrorMapping(Win32Error.noSystemResources,
            ProcessErrorKind.systemResources));
        return mappings.toArray();
    }
    mappings.push(new ErrorMapping(Errno.noEntry, ProcessErrorKind.notFound));
    mappings.push(new ErrorMapping(Errno.notADirectory, ProcessErrorKind.notFound));
    mappings.push(new ErrorMapping(Errno.notOwner, ProcessErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Errno.accessDenied, ProcessErrorKind.permissionDenied));
    mappings.push(new ErrorMapping(Errno.outOfMemory, ProcessErrorKind.outOfMemory));
    mappings.push(new ErrorMapping(Errno.programFileLimit, ProcessErrorKind.programFileLimit));
    mappings.push(new ErrorMapping(Errno.systemFileLimit, ProcessErrorKind.systemFileLimit));
    long tryAgain = Errno.linuxTryAgain;
    if (platform == Platform.MacOS) {
        tryAgain = Errno.darwinTryAgain;
    }
    mappings.push(new ErrorMapping(tryAgain, ProcessErrorKind.processLimit));
    return mappings.toArray();
}

// i32 ens_fs_error_kind(i32 code): the std.fs ErrorKind the platform's own error number means, from
// 0 for NotFound to 7 for Other. Every number this target's file calls do not report maps to 7.
public errorKindRuntime(Runtime runtime) -> RuntimeFunction {
    return errorKindBridge(runtime, "ens_fs_error_kind",
        errorMappings(runtime.target.platform()),
        ErrorKind.count);
}

// i32 ens_process_error_kind(i32 code): the ordinal a start's error number has, from 0 for NotFound
// to 7 for Other. Every number this target's start of a child does not report maps to 7.
public processErrorKindRuntime(Runtime runtime) -> RuntimeFunction {
    return errorKindBridge(runtime, "ens_process_error_kind",
        processErrorMappings(runtime.target.platform()), ProcessErrorKind.count,
        StartCause.numberMask);
}

// i32 ens_io_error_kind(i32 code): the std.io.streams ErrorKind an errno means, 0 for Closed, 1 for
// Interrupted and 2 for Other. The table is the same on every target, so the bridge is too.
public ioErrorKindRuntime(Runtime runtime) -> RuntimeFunction {
    return errorKindBridge(runtime, "ens_io_error_kind", ioErrorMappings(), IoErrorKind.count);
}

// i32 ens_io_win32_kind(i32 code): the std.io.streams ErrorKind a Win32 number from a stream read
// means, from 0 for Closed to 2 for Other.
public ioWin32KindRuntime(Runtime runtime) -> RuntimeFunction {
    return errorKindBridge(runtime, "ens_io_win32_kind", ioWin32Mappings(), IoErrorKind.count);
}

// i32 ens_fs_errno_kind(i32 code): the std.fs ErrorKind an errno means, from 0 for NotFound to 7
// for Other. It is what classifies a file-system failure that a stream call reported.
public fsErrnoKindRuntime(Runtime runtime) -> RuntimeFunction {
    return errorKindBridge(runtime, "ens_fs_errno_kind",
        fsErrnoMappings(runtime.target.platform()),
        ErrorKind.count);
}

// One table as a switch over the number, where the last kind is the result for every number the
// table leaves out.
errorKindBridge(Runtime runtime, string name, ErrorMapping[] mappings, long kinds,
                long numberMask = -1) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.int32Type]);
    let known = runtime.existing(name, type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition(name, type);
    let builder = runtime.builder;
    let kindBlocks = new BasicBlock[kinds];
    for (long kind = 0; kind < kindBlocks.length; kind++) {
        kindBlocks[kind] = runtime.block(definition, "kind.{kind}");
    }
    Value number = runtime.parameter(definition, 0);
    if (numberMask != -1) {
        number = instructions.buildAnd(builder, number, runtime.int32(numberMask), "number");
    }
    let chosen = instructions.buildSwitch(builder, number, kindBlocks[kinds - 1],
        mappings.length as uint);
    for (let mapping in mappings) {
        instructions.addCase(chosen, runtime.int32(mapping.code), kindBlocks[mapping.kind]);
    }
    for (long kind = 0; kind < kindBlocks.length; kind++) {
        builder.positionAtEnd(kindBlocks[kind]);
        instructions.buildRet(builder, runtime.int32(kind));
    }
    return runtime.endDefinition(definition);
}
