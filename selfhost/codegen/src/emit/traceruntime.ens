// The trace runtime, defined once in the core module - which every program already emits - and
// declared everywhere else: the chunk registry the per-module constructors link into, the two
// resolvers that map a captured return address back to its function and its call line, the
// platform stack capture, and the lazy symbolication into text or StackFrame values.
//
// Resolution is a linear scan for the greatest recorded start at or below the address: function
// starts for the symbol entries, marked call-site block addresses for the lines. Traces are rare
// and short, so no index is built.
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import BasicBlock from @ens.llvm.blocks;
import Builder from @ens.llvm.core;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import lower.symbols;
import support.primitives;

// Defines every trace-runtime function into the module being emitted. Only the core module calls
// this; the bodies attach to the declarations any earlier call in the module already created.
public defineTraceRuntime(ModuleEmitter emitter) {
    defineRegister(emitter.runtime);
    defineResolveAddress(emitter.runtime);
    defineResolveLine(emitter.runtime);
    defineCapture(emitter.runtime);
    defineFormat(emitter.runtime);
    defineSymbolicate(emitter);
}

// The registry head, touched only by the functions defined here.
head(Runtime runtime) -> Value {
    let existing = globals.getNamedGlobal(runtime.module, "_ens_symtab_head");
    if (existing != null) {
        return existing;
    }
    let created = globals.addGlobal(runtime.module, runtime.pointerType, "_ens_symtab_head");
    globals.setInitializer(created, runtime.nullPointer());
    globals.setLinkage(created, globals.linkageInternal());
    return created;
}

// void ens_symtab_register(ptr chunk): links a module's chunk into the registry; the per-module
// constructors run before main, so the list is complete before any trace resolves.
defineRegister(Runtime runtime) {
    let registered = runtime.libc("ens_symtab_register",
        runtime.voidType.functionType([runtime.pointerType]));
    let saved = beginExportedBody(runtime, registered);
    let chunk = globals.getParam(registered.function, 0);
    let registry = head(runtime);
    let previous = memory.buildLoad(runtime.builder, runtime.pointerType, registry, "head");
    memory.buildStore(runtime.builder, previous, chunk);
    memory.buildStore(runtime.builder, chunk, registry);
    instructions.buildRetVoid(runtime.builder);
    finishBody(runtime, saved);
}

// The symbol-entry, line-marker, and chunk shapes, mirroring what emit.traces writes.
symbolEntryType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.pointerType,
        runtime.pointerType, runtime.int32Type, runtime.int32Type], false);
}

markerEntryType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.int32Type], false);
}

chunkType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType, runtime.int64Type], false);
}

// ptr ens_resolve_addr(i64 addr): the symbol entry with the greatest function start at or below
// the address, or null when no registered function covers it.
defineResolveAddress(Runtime runtime) {
    let resolver = runtime.libc("ens_resolve_addr",
        runtime.pointerType.functionType([runtime.int64Type]));
    globals.setLinkage(resolver.function, globals.linkageInternal());
    let saved = beginExportedBody(runtime, resolver);
    let builder = runtime.builder;
    let entryType = symbolEntryType(runtime);
    let chunkShape = chunkType(runtime);
    let address = globals.getParam(resolver.function, 0);

    let best = memory.buildAlloca(builder, runtime.pointerType, "best");
    let bestStart = memory.buildAlloca(builder, runtime.int64Type, "best.start");
    let chunkCursor = memory.buildAlloca(builder, runtime.pointerType, "chunk");
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    memory.buildStore(builder, runtime.nullPointer(), best);
    memory.buildStore(builder, runtime.int64(0), bestStart);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.pointerType, head(runtime),
        "head"), chunkCursor);

    let chunkTest = block(runtime, resolver, "chunk.test");
    let chunkBody = block(runtime, resolver, "chunk.body");
    let entryTest = block(runtime, resolver, "entry.test");
    let entryBody = block(runtime, resolver, "entry.body");
    let keep = block(runtime, resolver, "entry.keep");
    let entryNext = block(runtime, resolver, "entry.next");
    let chunkNext = block(runtime, resolver, "chunk.next");
    let done = block(runtime, resolver, "done");
    instructions.buildBr(builder, chunkTest);

    builder.positionAtEnd(chunkTest);
    let chunk = memory.buildLoad(builder, runtime.pointerType, chunkCursor, "chunk.cur");
    instructions.buildCondBr(builder, runtime.isNull(chunk), done, chunkBody);

    builder.positionAtEnd(chunkBody);
    let entries = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, chunkShape, chunk, 1, ""), "entries");
    let count = memory.buildLoad(builder, runtime.int64Type,
        memory.buildStructGEP(builder, chunkShape, chunk, 2, ""), "count");
    memory.buildStore(builder, runtime.int64(0), index);
    instructions.buildBr(builder, entryTest);

    builder.positionAtEnd(entryTest);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, count, ""), entryBody, chunkNext);

    builder.positionAtEnd(entryBody);
    let entry = memory.buildGEP(builder, entryType, entries, [position], "entry");
    let start = instructions.buildPtrToInt(builder,
        memory.buildLoad(builder, runtime.pointerType,
            memory.buildStructGEP(builder, entryType, entry, 0, ""), "fn"),
        runtime.int64Type, "start");
    let below = instructions.buildICmpULE(builder, start, address, "");
    let above = instructions.buildICmpUGT(builder, start,
        memory.buildLoad(builder, runtime.int64Type, bestStart, ""), "");
    instructions.buildCondBr(builder, instructions.buildAnd(builder, below, above, ""), keep,
        entryNext);

    builder.positionAtEnd(keep);
    memory.buildStore(builder, entry, best);
    memory.buildStore(builder, start, bestStart);
    instructions.buildBr(builder, entryNext);

    builder.positionAtEnd(entryNext);
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, entryTest);

    builder.positionAtEnd(chunkNext);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, chunkShape, chunk, 0, ""), "next"), chunkCursor);
    instructions.buildBr(builder, chunkTest);

    builder.positionAtEnd(done);
    instructions.buildRet(builder, memory.buildLoad(builder, runtime.pointerType, best, ""));
    finishBody(runtime, saved);
}

// ptr ens_resolve_lineentry(i64 addr): the line marker with the greatest marked call-site
// address at or below the captured address, or null; the caller falls back to the function's
// declaration line.
defineResolveLine(Runtime runtime) {
    let resolver = runtime.libc("ens_resolve_lineentry",
        runtime.pointerType.functionType([runtime.int64Type]));
    globals.setLinkage(resolver.function, globals.linkageInternal());
    let saved = beginExportedBody(runtime, resolver);
    let builder = runtime.builder;
    let markerType = markerEntryType(runtime);
    let chunkShape = chunkType(runtime);
    let address = globals.getParam(resolver.function, 0);

    let best = memory.buildAlloca(builder, runtime.pointerType, "best");
    let bestStart = memory.buildAlloca(builder, runtime.int64Type, "best.start");
    let chunkCursor = memory.buildAlloca(builder, runtime.pointerType, "chunk");
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    memory.buildStore(builder, runtime.nullPointer(), best);
    memory.buildStore(builder, runtime.int64(0), bestStart);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.pointerType, head(runtime),
        "head"), chunkCursor);

    let chunkTest = block(runtime, resolver, "chunk.test");
    let chunkBody = block(runtime, resolver, "chunk.body");
    let markTest = block(runtime, resolver, "mark.test");
    let markBody = block(runtime, resolver, "mark.body");
    let keep = block(runtime, resolver, "mark.keep");
    let markNext = block(runtime, resolver, "mark.next");
    let chunkNext = block(runtime, resolver, "chunk.next");
    let done = block(runtime, resolver, "done");
    instructions.buildBr(builder, chunkTest);

    builder.positionAtEnd(chunkTest);
    let chunk = memory.buildLoad(builder, runtime.pointerType, chunkCursor, "chunk.cur");
    instructions.buildCondBr(builder, runtime.isNull(chunk), done, chunkBody);

    builder.positionAtEnd(chunkBody);
    let markers = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, chunkShape, chunk, 3, ""), "markers");
    let count = memory.buildLoad(builder, runtime.int64Type,
        memory.buildStructGEP(builder, chunkShape, chunk, 4, ""), "count");
    memory.buildStore(builder, runtime.int64(0), index);
    instructions.buildBr(builder, markTest);

    builder.positionAtEnd(markTest);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, count, ""), markBody, chunkNext);

    builder.positionAtEnd(markBody);
    let marker = memory.buildGEP(builder, markerType, markers, [position], "marker");
    let start = instructions.buildPtrToInt(builder,
        memory.buildLoad(builder, runtime.pointerType,
            memory.buildStructGEP(builder, markerType, marker, 0, ""), "site"),
        runtime.int64Type, "start");
    let below = instructions.buildICmpULE(builder, start, address, "");
    let above = instructions.buildICmpUGT(builder, start,
        memory.buildLoad(builder, runtime.int64Type, bestStart, ""), "");
    instructions.buildCondBr(builder, instructions.buildAnd(builder, below, above, ""), keep,
        markNext);

    builder.positionAtEnd(keep);
    memory.buildStore(builder, marker, best);
    memory.buildStore(builder, start, bestStart);
    instructions.buildBr(builder, markNext);

    builder.positionAtEnd(markNext);
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, markTest);

    builder.positionAtEnd(chunkNext);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, chunkShape, chunk, 0, ""), "next"), chunkCursor);
    instructions.buildBr(builder, chunkTest);

    builder.positionAtEnd(done);
    instructions.buildRet(builder, memory.buildLoad(builder, runtime.pointerType, best, ""));
    finishBody(runtime, saved);
}

// ptr ens_capture_trace(i32 maxDepth): walks the stack, keeps the return addresses the symbol
// table resolves, stops after the program entry's frame, and returns them as an owned long[].
// Windows fills the buffer through RtlCaptureStackBackTrace; everywhere else the unwinder walks
// frame by frame through a callback.
defineCapture(Runtime runtime) {
    let capture = runtime.captureTrace();
    let saved = beginExportedBody(runtime, capture);
    let builder = runtime.builder;
    let entryType = symbolEntryType(runtime);
    let resolveAddress = runtime.libc("ens_resolve_addr",
        runtime.pointerType.functionType([runtime.int64Type]));
    let allocate = runtime.alloc();
    let requested = globals.getParam(capture.function, 0);

    // The walk buffer holds at most 64 addresses, the depth every capture site asks for.
    let buffer = memory.buildAlloca(builder, runtime.int64Type.arrayType(64), "buffer");
    let overCap = instructions.buildICmpSGT(builder, requested,
        runtime.int32Type.constInt(64, true), "");
    let clamped = instructions.buildSelect(builder, overCap,
        runtime.int32Type.constInt(64, true), requested, "depth");

    Value walked;
    long skip = 0;
    if (runtime.onWindows()) {
        // USHORT RtlCaptureStackBackTrace(ULONG skip, ULONG count, PVOID* out, PULONG hash):
        // skipping one frame drops this function's own.
        let rtl = runtime.libc("RtlCaptureStackBackTrace",
            runtime.context.int16Type().functionType([runtime.int32Type, runtime.int32Type,
                runtime.pointerType, runtime.pointerType]));
        let filled = runtime.call(rtl, [runtime.int32(1), clamped, buffer,
            runtime.nullPointer()], "filled");
        walked = instructions.buildZExt(builder, filled, runtime.int64Type, "n");
    } else {
        let callback = defineUnwindCallback(runtime);
        let backtrace = runtime.libc("_Unwind_Backtrace",
            runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
        let stateType = runtime.context.structType([runtime.pointerType, runtime.int32Type,
            runtime.int32Type], false);
        let state = memory.buildAlloca(builder, stateType, "state");
        memory.buildStore(builder, buffer,
            memory.buildStructGEP(builder, stateType, state, 0, ""));
        memory.buildStore(builder, runtime.int32(0),
            memory.buildStructGEP(builder, stateType, state, 1, ""));
        memory.buildStore(builder, clamped,
            memory.buildStructGEP(builder, stateType, state, 2, ""));
        runtime.call(backtrace, [callback, state], "");
        walked = instructions.buildSExt(builder,
            memory.buildLoad(builder, runtime.int32Type,
                memory.buildStructGEP(builder, stateType, state, 1, ""), ""),
            runtime.int64Type, "n");
        // The unwinder reports the capture frame itself first.
        skip = 1;
    }

    // Over-allocate at the walk's capacity; the kept count becomes the length.
    let trace = runtime.call(allocate, [runtime.int64(8 + 64 * 8), runtime.nullPointer(),
        runtime.nullPointer()], "trace");
    let data = runtime.payloadData(trace);
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    let kept = memory.buildAlloca(builder, runtime.int64Type, "kept");
    memory.buildStore(builder, runtime.int64(skip), index);
    memory.buildStore(builder, runtime.int64(0), kept);

    let walkTest = block(runtime, capture, "walk.test");
    let walkBody = block(runtime, capture, "walk.body");
    let keep = block(runtime, capture, "walk.keep");
    let walkNext = block(runtime, capture, "walk.next");
    let done = block(runtime, capture, "done");
    instructions.buildBr(builder, walkTest);

    builder.positionAtEnd(walkTest);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, walked, ""), walkBody, done);

    builder.positionAtEnd(walkBody);
    let address = memory.buildLoad(builder, runtime.int64Type,
        memory.buildGEP(builder, runtime.int64Type, buffer, [position], ""), "address");
    let entry = runtime.call(resolveAddress, [address], "entry");
    instructions.buildCondBr(builder, runtime.isNull(entry), walkNext, keep);

    builder.positionAtEnd(keep);
    let slot = memory.buildLoad(builder, runtime.int64Type, kept, "kept.cur");
    memory.buildStore(builder, address,
        memory.buildGEP(builder, runtime.int64Type, data, [slot], ""));
    memory.buildStore(builder, instructions.buildAdd(builder, slot, runtime.int64(1), ""),
        kept);
    let entryFlag = memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, entryType, entry, 4, ""), "is.entry");
    instructions.buildCondBr(builder,
        instructions.buildICmpNE(builder, entryFlag, runtime.int32(0), ""), done, walkNext);

    builder.positionAtEnd(walkNext);
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, walkTest);

    builder.positionAtEnd(done);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int64Type, kept, ""), trace);
    instructions.buildRet(builder, trace);
    finishBody(runtime, saved);
}

// The _Unwind_Backtrace callback: stores each frame's instruction pointer until the buffer is
// full. Only non-Windows captures walk this way.
defineUnwindCallback(Runtime runtime) -> Value {
    let existing = globals.getNamedFunction(runtime.module, "ens_unwind_cb");
    if (existing != null) {
        return existing;
    }
    let stateType = runtime.context.structType([runtime.pointerType, runtime.int32Type,
        runtime.int32Type], false);
    let getIp = runtime.libc("_Unwind_GetIP",
        runtime.int64Type.functionType([runtime.pointerType]));
    let callbackType = runtime.int32Type.functionType([runtime.pointerType,
        runtime.pointerType]);
    let callback = runtime.module.addFunction("ens_unwind_cb", callbackType);
    globals.setLinkage(callback, globals.linkageInternal());
    globals.addFunctionAttribute(runtime.context, callback, "nounwind");
    let saved = runtime.builder.insertBlock();
    runtime.builder.positionAtEnd(runtime.context.appendBasicBlock(callback, "entry"));
    let builder = runtime.builder;
    let context = globals.getParam(callback, 0);
    let state = globals.getParam(callback, 1);
    let indexSlot = memory.buildStructGEP(builder, stateType, state, 1, "");
    let index = memory.buildLoad(builder, runtime.int32Type, indexSlot, "index");
    let limit = memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, stateType, state, 2, ""), "limit");
    let full = runtime.context.appendBasicBlock(callback, "full");
    let store = runtime.context.appendBasicBlock(callback, "store");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGE(builder, index, limit, ""), full, store);

    builder.positionAtEnd(full);
    // 5 is _URC_END_OF_STACK, which stops the walk.
    instructions.buildRet(builder, runtime.int32(5));

    builder.positionAtEnd(store);
    let ip = runtime.call(getIp, [context], "ip");
    let buffer = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, stateType, state, 0, ""), "buffer");
    let wide = instructions.buildSExt(builder, index, runtime.int64Type, "");
    memory.buildStore(builder, ip,
        memory.buildGEP(builder, runtime.int64Type, buffer, [wide], ""));
    memory.buildStore(builder,
        instructions.buildAdd(builder, index, runtime.int32(1), ""), indexSlot);
    instructions.buildRet(builder, runtime.int32(0));
    if (saved != null) {
        runtime.builder.positionAtEnd(saved);
    }
    return callback;
}

// ptr ens_format_trace(ptr frames): one "  at name (file:line)" line per captured frame, as an
// owned string; a null capture formats as the empty string, and a capture that never reached the
// program entry ends with a truncation note.
defineFormat(Runtime runtime) {
    let format = runtime.formatTrace();
    let saved = beginExportedBody(runtime, format);
    let builder = runtime.builder;
    let entryType = symbolEntryType(runtime);
    let markerType = markerEntryType(runtime);
    let resolveAddress = runtime.libc("ens_resolve_addr",
        runtime.pointerType.functionType([runtime.int64Type]));
    let resolveLine = runtime.libc("ens_resolve_lineentry",
        runtime.pointerType.functionType([runtime.int64Type]));
    let print = runtime.snprintf();
    let lift = runtime.stringFromCString();
    let release = runtime.free();
    let frames = globals.getParam(format.function, 0);

    let empty = block(runtime, format, "empty");
    let have = block(runtime, format, "have");
    instructions.buildCondBr(builder, runtime.isNull(frames), empty, have);

    builder.positionAtEnd(empty);
    instructions.buildRet(builder, runtime.stringLiteral("".toBytes()));

    builder.positionAtEnd(have);
    let count = runtime.payloadLength(frames);
    let data = runtime.payloadData(frames);
    let buffer = runtime.call(runtime.malloc(), [runtime.int64(8192)], "buffer");
    memory.buildStore(builder, runtime.int8(0), buffer);
    let written = memory.buildAlloca(builder, runtime.int64Type, "written");
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    let sawEntry = memory.buildAlloca(builder, runtime.int1Type, "saw.entry");
    let line = memory.buildAlloca(builder, runtime.int32Type, "line");
    memory.buildStore(builder, runtime.int64(0), written);
    memory.buildStore(builder, runtime.int64(0), index);
    memory.buildStore(builder, runtime.int1Type.constInt(0, false), sawEntry);
    let pattern = globals.buildGlobalString(builder, "  at %s (%s:%d)\n", ".trace.pattern");

    let frameTest = block(runtime, format, "frame.test");
    let frameBody = block(runtime, format, "frame.body");
    let fromMarker = block(runtime, format, "frame.markedline");
    let append = block(runtime, format, "frame.append");
    let frameNext = block(runtime, format, "frame.next");
    let after = block(runtime, format, "after");
    let truncated = block(runtime, format, "truncated");
    let finish = block(runtime, format, "finish");
    instructions.buildBr(builder, frameTest);

    builder.positionAtEnd(frameTest);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, count, ""), frameBody, after);

    builder.positionAtEnd(frameBody);
    let address = memory.buildLoad(builder, runtime.int64Type,
        memory.buildGEP(builder, runtime.int64Type, data, [position], ""), "address");
    let entry = runtime.call(resolveAddress, [address], "entry");
    let setup = appendSetup(runtime, format, builder, entryType, markerType, resolveLine, entry,
        address, sawEntry, line, fromMarker, append);
    instructions.buildCondBr(builder, runtime.isNull(entry), frameNext, setup);

    builder.positionAtEnd(fromMarker);
    let marker = runtime.call(resolveLine, [address], "marker");
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, markerType, marker, 1, ""), ""), line);
    instructions.buildBr(builder, append);

    builder.positionAtEnd(append);
    let used = memory.buildLoad(builder, runtime.int64Type, written, "used");
    let cursor = memory.buildGEP(builder, runtime.int8Type, buffer, [used], "cursor");
    let room = instructions.buildSub(builder, runtime.int64(8192), used, "room");
    let name = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, entry, 1, ""), "name");
    let file = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, entry, 2, ""), "file");
    let added = runtime.call(print, [cursor, room, pattern, name, file,
        memory.buildLoad(builder, runtime.int32Type, line, "")], "added");
    let grown = instructions.buildAdd(builder, used,
        instructions.buildSExt(builder, added, runtime.int64Type, ""), "grown");
    let over = instructions.buildICmpSGT(builder, grown, runtime.int64(8191), "");
    memory.buildStore(builder,
        instructions.buildSelect(builder, over, runtime.int64(8191), grown, ""), written);
    instructions.buildBr(builder, frameNext);

    builder.positionAtEnd(frameNext);
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, frameTest);

    builder.positionAtEnd(after);
    let nonEmpty = instructions.buildICmpSGT(builder, count, runtime.int64(0), "");
    let missedEntry = instructions.buildICmpEQ(builder,
        memory.buildLoad(builder, runtime.int1Type, sawEntry, ""),
        runtime.int1Type.constInt(0, false), "");
    instructions.buildCondBr(builder,
        instructions.buildAnd(builder, nonEmpty, missedEntry, ""), truncated, finish);

    builder.positionAtEnd(truncated);
    let tailUsed = memory.buildLoad(builder, runtime.int64Type, written, "used");
    runtime.call(print, [memory.buildGEP(builder, runtime.int8Type, buffer, [tailUsed], ""),
        instructions.buildSub(builder, runtime.int64(8192), tailUsed, ""),
        globals.buildGlobalString(builder, "  ... (trace truncated)\n", ".trace.cut")], "");
    instructions.buildBr(builder, finish);

    builder.positionAtEnd(finish);
    let text = runtime.call(lift, [buffer], "text");
    runtime.call(release, [buffer], "");
    instructions.buildRet(builder, text);
    finishBody(runtime, saved);
}

// The shared per-frame setup of the format walk: remembers whether the program entry's frame was
// reached and seeds the line from the declaration, then routes to the marker's line when one
// covers the address. Returns the block the resolved-entry branch should take.
appendSetup(Runtime runtime, RuntimeFunction format, Builder builder, TypeRef entryType,
            TypeRef markerType, RuntimeFunction resolveLine, Value entry, Value address,
            Value sawEntry, Value line, BasicBlock fromMarker, BasicBlock append)
        -> BasicBlock {
    let setup = block(runtime, format, "frame.setup");
    let held = builder.insertBlock();
    builder.positionAtEnd(setup);
    let entryFlag = memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, entryType, entry, 4, ""), "is.entry");
    let sawNow = instructions.buildICmpNE(builder, entryFlag, runtime.int32(0), "");
    let sawBefore = memory.buildLoad(builder, runtime.int1Type, sawEntry, "");
    memory.buildStore(builder, instructions.buildOr(builder, sawBefore, sawNow, ""), sawEntry);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, entryType, entry, 3, ""), ""), line);
    let marker = runtime.call(resolveLine, [address], "marker");
    instructions.buildCondBr(builder, runtime.isNull(marker), append, fromMarker);
    if (held != null) {
        builder.positionAtEnd(held);
    }
    return setup;
}

// ptr ens_symbolicate(ptr frames): the captured frames as an owned StackFrame[], each frame's
// function, file, and line filled from the tables the way the formatted text is.
defineSymbolicate(ModuleEmitter emitter) {
    let runtime = emitter.runtime;
    let symbolicate = runtime.symbolicate();
    let saved = beginExportedBody(runtime, symbolicate);
    let builder = runtime.builder;
    let stackFrame = emitter.stackFrameType();
    if (stackFrame == null) {
        instructions.buildRet(builder, runtime.nullPointer());
        finishBody(runtime, saved);
        return;
    }
    let layout = emitter.classLayout(stackFrame);
    let size = emitter.dataLayout().abiSizeOfType(layout);
    let finalizer = emitter.objectDestructor(
        symbols.destructorLinkName("std.core", "StackFrame"));
    let descriptor = emitter.descriptors.descriptorValue(stackFrame);
    let elementFinalizer = emitter.finalizers.arrayFinalizer(stackFrame);
    let entryType = symbolEntryType(runtime);
    let markerType = markerEntryType(runtime);
    let resolveAddress = runtime.libc("ens_resolve_addr",
        runtime.pointerType.functionType([runtime.int64Type]));
    let resolveLine = runtime.libc("ens_resolve_lineentry",
        runtime.pointerType.functionType([runtime.int64Type]));
    let lift = runtime.stringFromCString();
    let allocate = runtime.alloc();
    let frames = globals.getParam(symbolicate.function, 0);

    let counted = memory.buildAlloca(builder, runtime.int64Type, "count");
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    let line = memory.buildAlloca(builder, runtime.int32Type, "line");
    let none = block(runtime, symbolicate, "none");
    let some = block(runtime, symbolicate, "some");
    let alloc = block(runtime, symbolicate, "alloc");
    instructions.buildCondBr(builder, runtime.isNull(frames), none, some);

    builder.positionAtEnd(none);
    memory.buildStore(builder, runtime.int64(0), counted);
    instructions.buildBr(builder, alloc);

    builder.positionAtEnd(some);
    memory.buildStore(builder, runtime.payloadLength(frames), counted);
    instructions.buildBr(builder, alloc);

    builder.positionAtEnd(alloc);
    let count = memory.buildLoad(builder, runtime.int64Type, counted, "n");
    let bytes = instructions.buildAdd(builder, runtime.int64(8),
        instructions.buildMul(builder, count, runtime.int64(8), ""), "bytes");
    let result = runtime.call(allocate, [bytes, elementFinalizer, runtime.nullPointer()],
        "result");
    memory.buildStore(builder, count, result);
    let resultData = runtime.payloadData(result);
    memory.buildStore(builder, runtime.int64(0), index);

    let fillTest = block(runtime, symbolicate, "fill.test");
    let fillBody = block(runtime, symbolicate, "fill.body");
    let fromMarker = block(runtime, symbolicate, "fill.markedline");
    let build = block(runtime, symbolicate, "fill.build");
    let fillNext = block(runtime, symbolicate, "fill.next");
    let done = block(runtime, symbolicate, "done");
    instructions.buildBr(builder, fillTest);

    builder.positionAtEnd(fillTest);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, count, ""), fillBody, done);

    builder.positionAtEnd(fillBody);
    let sourceData = runtime.payloadData(frames);
    let address = memory.buildLoad(builder, runtime.int64Type,
        memory.buildGEP(builder, runtime.int64Type, sourceData, [position], ""), "address");
    let entry = runtime.call(resolveAddress, [address], "entry");
    let setup = symbolicateSetup(runtime, symbolicate, builder, entryType, resolveLine, entry,
        address, line, fromMarker, build);
    instructions.buildCondBr(builder, runtime.isNull(entry), fillNext, setup);

    builder.positionAtEnd(fromMarker);
    let marker = runtime.call(resolveLine, [address], "marker");
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, markerType, marker, 1, ""), ""), line);
    instructions.buildBr(builder, build);

    builder.positionAtEnd(build);
    let name = runtime.call(lift, [memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, entry, 1, ""), "")], "name");
    let file = runtime.call(lift, [memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, entry, 2, ""), "")], "file");
    let frame = runtime.call(allocate, [runtime.int64(size as long), finalizer, descriptor],
        "frame");
    memory.buildStore(builder, name, memory.buildStructGEP(builder, layout, frame, 0, ""));
    memory.buildStore(builder, file, memory.buildStructGEP(builder, layout, frame, 1, ""));
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type, line, ""),
        memory.buildStructGEP(builder, layout, frame, 2, ""));
    memory.buildStore(builder, frame,
        memory.buildGEP(builder, runtime.pointerType, resultData, [position], ""));
    instructions.buildBr(builder, fillNext);

    builder.positionAtEnd(fillNext);
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, fillTest);

    builder.positionAtEnd(done);
    instructions.buildRet(builder, result);
    finishBody(runtime, saved);
}

// The symbolicate walk's per-frame setup: seeds the line from the declaration and routes to the
// marker's line when one covers the address.
symbolicateSetup(Runtime runtime, RuntimeFunction symbolicate, Builder builder,
                 TypeRef entryType, RuntimeFunction resolveLine, Value entry, Value address,
                 Value line, BasicBlock fromMarker, BasicBlock build) -> BasicBlock {
    let setup = block(runtime, symbolicate, "fill.setup");
    let held = builder.insertBlock();
    builder.positionAtEnd(setup);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type,
        memory.buildStructGEP(builder, entryType, entry, 3, ""), ""), line);
    let marker = runtime.call(resolveLine, [address], "marker");
    instructions.buildCondBr(builder, runtime.isNull(marker), build, fromMarker);
    if (held != null) {
        builder.positionAtEnd(held);
    }
    return setup;
}

// Opens the body of a function the module may already have declared, keeping its external
// linkage, and remembering where the caller was building.
beginExportedBody(Runtime runtime, RuntimeFunction opened) -> BasicBlock? {
    globals.addFunctionAttribute(runtime.context, opened.function, "nounwind");
    let saved = runtime.builder.insertBlock();
    runtime.builder.positionAtEnd(runtime.context.appendBasicBlock(opened.function, "entry"));
    return saved;
}

finishBody(Runtime runtime, BasicBlock? saved) {
    if (saved != null) {
        runtime.builder.positionAtEnd(saved);
    }
}

block(Runtime runtime, RuntimeFunction owner, string name) -> BasicBlock {
    return runtime.context.appendBasicBlock(owner.function, name);
}
