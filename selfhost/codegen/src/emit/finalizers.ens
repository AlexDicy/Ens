// The finalizers an object stores in its header. ens_release runs one when the strong count
// reaches zero and frees the allocation afterwards, so a finalizer releases only what the object
// owns and never touches the object itself. An array that owns nothing carries a null finalizer.
import Type from @ens.sema.model.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;
import RuntimeFunction from emit.runtime;
import TypeMapper from emit.types;
import lower.symbols;
import support.primitives;
import ReferenceWalker from support.references;
import support.references;
import BasicBlock from @ens.llvm.blocks;
import List from @std.collections.list;

public final class Finalizers {
    Runtime runtime;
    TypeMapper mapper;

    public constructor(this.runtime, this.mapper);

    // The finalizer pointer an array of this element type stores in its header.
    public arrayFinalizer(Type elementType) -> Value {
        if (!primitives.hasArcContent(elementType)) {
            return this.runtime.nullPointer();
        }
        return this.arrayDestructor(elementType).function;
    }

    // void _dtor_<element>_array(ptr array): releases every element the array's payload holds.
    arrayDestructor(Type elementType) -> RuntimeFunction {
        let type = this.runtime.voidType.functionType([this.runtime.pointerType]);
        string name = "_dtor_" + symbols.mangleTypeForName(elementType) + "_array";
        let known = this.runtime.existing(name, type);
        if (known != null) {
            return known;
        }
        let builder = this.runtime.builder;
        let definition = this.runtime.beginDefinition(name, type);
        let array = this.runtime.parameter(definition, 0);
        let testBlock = this.runtime.block(definition, "dtor.test");
        let bodyBlock = this.runtime.block(definition, "dtor.body");
        let doneBlock = this.runtime.block(definition, "dtor.done");
        let indexSlot = memory.buildAlloca(builder, this.runtime.int64Type, "index");
        let length = this.runtime.payloadLength(array);
        let data = this.runtime.payloadData(array);
        memory.buildStore(builder, this.runtime.int64(0), indexSlot);
        instructions.buildBr(builder, testBlock);

        builder.positionAtEnd(testBlock);
        let index = memory.buildLoad(builder, this.runtime.int64Type, indexSlot, "index");
        let more = instructions.buildICmpSLT(builder, index, length, "");
        instructions.buildCondBr(builder, more, bodyBlock, doneBlock);

        builder.positionAtEnd(bodyBlock);
        let element = memory.buildGEP(builder, this.mapper.map(elementType), data, [index],
            "element");
        this.releaseAt(definition, element, elementType);
        memory.buildStore(builder, instructions.buildAdd(builder, index, this.runtime.int64(1),
            ""), indexSlot);
        instructions.buildBr(builder, testBlock);

        builder.positionAtEnd(doneBlock);
        instructions.buildRetVoid(builder);
        return this.runtime.endDefinition(definition);
    }

    // Releases what the storage at an address owns.
    releaseAt(RuntimeDefinition definition, Value address, Type type) {
        references.walk<Value>(new StorageReleaser(this.runtime, this.mapper, definition), address,
            type);
    }
}

// Releases each reference storage holds, through its address. An optional's payload is reached in
// a block of its own that only runs when the tag marks the payload present.
final class StorageReleaser implements ReferenceWalker<Value> {
    Runtime runtime;
    TypeMapper mapper;
    RuntimeDefinition definition;
    List<BasicBlock> doneBlocks;

    protected constructor(this.runtime, this.mapper, this.definition) {
        this.doneBlocks = new List<BasicBlock>();
    }

    override reference(Value address) {
        let held = memory.buildLoad(this.runtime.builder, this.runtime.pointerType, address, "");
        this.runtime.call(this.runtime.release(), [held], "");
    }

    override field(Value record, Type recordType, long index, Type fieldType) -> Value {
        return memory.buildStructGEP(this.runtime.builder, this.mapper.map(recordType), record,
            index as uint, "");
    }

    override payload(Value pair, Type optionalType, Type payloadType) -> Value {
        let builder = this.runtime.builder;
        let pairType = this.mapper.map(optionalType);
        let tagAddress = memory.buildStructGEP(builder, pairType, pair, 0 as uint, "");
        let present = memory.buildLoad(builder, this.runtime.int1Type, tagAddress, "");
        let walkBlock = this.runtime.block(this.definition, "opt.walk");
        let doneBlock = this.runtime.block(this.definition, "opt.done");
        instructions.buildCondBr(builder, present, walkBlock, doneBlock);
        builder.positionAtEnd(walkBlock);
        this.doneBlocks.push(doneBlock);
        return memory.buildStructGEP(builder, pairType, pair, 1 as uint, "");
    }

    override endPayload() {
        let doneBlock = this.doneBlocks.pop();
        instructions.buildBr(this.runtime.builder, doneBlock);
        this.runtime.builder.positionAtEnd(doneBlock);
    }
}
