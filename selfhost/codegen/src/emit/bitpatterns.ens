// The bits a floating-point value is made of, read out and put back. A value and its bits are the
// same bytes at the same width, so each bridge here is one conversion and nothing else.
import TypeRef from @ens.llvm.types;
import @ens.llvm.instructions;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;

// i64 ens_double_bits(double value): the value's own IEEE bits, with its sign in the top bit. A NaN
// arrives with its payload intact.
public doubleBitsRuntime(Runtime runtime) -> RuntimeFunction {
    return reinterpretation(runtime, "ens_double_bits", runtime.doubleType, runtime.int64Type);
}

// double ens_double_from_bits(i64 bits): the value those bits spell. Every pattern spells one, so
// there is nothing to refuse.
public doubleFromBitsRuntime(Runtime runtime) -> RuntimeFunction {
    return reinterpretation(runtime, "ens_double_from_bits", runtime.int64Type,
        runtime.doubleType);
}

// i32 ens_float_bits(float value): the value's own IEEE bits, with its sign in the top bit. A NaN
// arrives with its payload intact.
public floatBitsRuntime(Runtime runtime) -> RuntimeFunction {
    return reinterpretation(runtime, "ens_float_bits", runtime.floatType, runtime.int32Type);
}

// float ens_float_from_bits(i32 bits): the value those bits spell. Every pattern spells one, so
// there is nothing to refuse.
public floatFromBitsRuntime(Runtime runtime) -> RuntimeFunction {
    return reinterpretation(runtime, "ens_float_from_bits", runtime.int32Type, runtime.floatType);
}

// One bridge reading its argument's bytes as `answered`, defined once per module. The two types are
// the same width, so no rounding and no widening can happen here.
reinterpretation(Runtime runtime, string name, TypeRef given, TypeRef answered)
        -> RuntimeFunction {
    let type = answered.functionType([given]);
    let known = runtime.existing(name, type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition(name, type);
    instructions.buildRet(runtime.builder, instructions.buildBitCast(runtime.builder,
        runtime.parameter(definition, 0), answered, "reinterpreted"));
    return runtime.endDefinition(definition);
}
