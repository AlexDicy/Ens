// Mechanical emission of lowered EIR into a native object file through the LLVM-C binding. One
// LLVM context and module serve one Ens module; temps map one-to-one onto LLVM values, slots onto
// entry-block allocas, and blocks onto basic blocks, so nothing in emission makes decisions - the
// shape was fixed by lowering.
//
// This module holds the entry point and the module-level plumbing: the host target and its data
// layout, the pass that declares every function before any body is emitted, the pass that emits
// the bodies, the C 'main' wrapper the entry module gets, and the verification and object write
// that close an emission. The state lives in emit.context, signatures in emit.signatures, bodies
// and the per-instruction dispatch in emit.bodies, and everything that needs machine code beyond
// one instruction in emit.runtime.
//
// The module that defines the program entry also gets the C 'main' wrapper: it records argc and
// argv in the ens argument globals and forwards the user main's result. A throwing main is
// passed the root error slot; an error that reaches it is reported on standard error, with its
// type, its message, and its trace, and the process exits 1.
import EirFunction from eir.model;
import Type from @ens.sema.model.types;
import CodegenSettings from settings;
import DescriptorPlans from layout.descriptors;
import ModuleEmitter from emit.context;
import emit.bodies;
import emit.exceptions;
import emit.signatures;
import emit.traceruntime;
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import @ens.llvm.globals;
import @ens.llvm.analysis;
import TargetMachine from @ens.llvm.target;
import @ens.llvm.target;
import List from @std.collections.list;

// The entry-point shape the wrapper forwards: the user main's symbol, whether it produces the
// process exit code itself or leaves the wrapper to return 0, and whether it reports through an
// error slot the wrapper owns.
export final class EntryPoint {
    string entrySymbol;
    bool voidResult;
    bool throwsResult;

    public constructor(this.entrySymbol, this.voidResult, this.throwsResult);

    export symbol() -> string {
        return this.entrySymbol;
    }

    export returnsVoid() -> bool {
        return this.voidResult;
    }

    export throwing() -> bool {
        return this.throwsResult;
    }
}

// Emits one module's functions and the descriptors it owns as a native object file for the target
// the settings name. The core module additionally defines the trace runtime every other module
// declares; stackFrameType carries the class its symbolication builds, and errorType the class
// whose payload the entry wrapper reads. Returns "" on success and a description of the failure
// otherwise.
public emitModule(string moduleName, List<EirFunction> functions, EntryPoint? entry,
                  DescriptorPlans plans, Type? stackFrameType, Type? errorType,
                  string objectPath, CodegenSettings settings) -> string {
    string triple = settings.targetTriple();
    let emitter = new ModuleEmitter(moduleName, plans, triple);
    emitter.rememberStackFrameType(stackFrameType);
    emitter.rememberErrorType(errorType);
    target.initializeTargets();
    let resolved = target.targetFromTriple(triple);
    if (resolved == null) {
        emitter.dispose();
        return "could not resolve the target '{triple}'";
    }
    let machine = resolved.createTargetMachine(triple, settings.llvmOptimizationLevel());
    string outcome = emitInto(emitter, machine, functions, entry, objectPath);
    machine.dispose();
    emitter.dispose();
    return outcome;
}

emitInto(ModuleEmitter emitter, TargetMachine machine, List<EirFunction> functions,
         EntryPoint? entry, string objectPath) -> string {
    let layout = machine.createDataLayout();
    emitter.rememberDataLayout(layout);
    target.setModuleDataLayout(emitter.module, layout);
    for (long i = 0; i < functions.length(); i++) {
        signatures.declareFunction(emitter, functions.get(i));
    }
    for (long i = 0; i < functions.length(); i++) {
        string problem = bodies.emitFunction(emitter, functions.get(i));
        if (problem.length > 0) {
            return problem;
        }
    }
    if (entry != null) {
        string problem = emitEntryWrapper(emitter, entry);
        if (problem.length > 0) {
            return problem;
        }
    }
    emitter.descriptors.defineModuleDescriptors(emitter, emitter.name());
    if (emitter.name() == "std.core") {
        traceruntime.defineTraceRuntime(emitter);
    }
    emitter.traces.emitRegistration(emitter.runtime);
    forceUnwindTables(emitter);
    string verdict = analysis.verify(emitter.module);
    if (verdict.length > 0) {
        return "module '{emitter.name()}' failed LLVM verification: {verdict}";
    }
    string written = machine.emitObjectFile(emitter.module, objectPath);
    if (written.length > 0) {
        return "could not write the object file {objectPath}: {written}";
    }
    return "";
}

// The module's global of this name, added on first use: the argument globals may already have
// been declared by an ens_arguments reference in the same module.
namedGlobal(ModuleEmitter emitter, TypeRef type, string name) -> Value {
    let found = globals.getNamedGlobal(emitter.module, name);
    if (found != null) {
        return found;
    }
    return globals.addGlobal(emitter.module, type, name);
}

// Every defined function gets asynchronous unwind tables, so the stack capture can walk through
// every frame - the nounwind runtime included.
forceUnwindTables(ModuleEmitter emitter) {
    let current = globals.firstFunction(emitter.module);
    while (current != null) {
        if (!globals.isDeclaration(current)) {
            globals.addFunctionAttributeValued(emitter.context, current, "uwtable", 2);
        }
        current = globals.nextFunction(current);
    }
}

// The C entry point: record the process arguments in the ens globals and forward the user
// main's result.
emitEntryWrapper(ModuleEmitter emitter, EntryPoint entry) -> string {
    let userMain = emitter.functionValue(entry.symbol());
    if (userMain == null) {
        return "Internal: the entry module never defined {entry.symbol()}";
    }
    let intType = emitter.context.int32Type();
    let pointerType = emitter.context.pointerType();
    let wrapperType = intType.functionType([intType, pointerType]);
    let wrapper = emitter.module.addFunction("main", wrapperType);
    let argcGlobal = namedGlobal(emitter, intType, "ens_argc");
    globals.setInitializer(argcGlobal, intType.constInt(0, false));
    let argvGlobal = namedGlobal(emitter, pointerType, "ens_argv");
    globals.setInitializer(argvGlobal, pointerType.constNull());
    emitter.builder.positionAtEnd(emitter.context.appendBasicBlock(wrapper, "entry"));
    let storeArgc = memory.buildStore(emitter.builder, globals.getParam(wrapper, 0), argcGlobal);
    let storeArgv = memory.buildStore(emitter.builder, globals.getParam(wrapper, 1), argvGlobal);
    if (!entry.throwing()) {
        let called = instructions.buildCall(emitter.builder, emitter.calleeType(entry.symbol()),
            userMain, [], "");
        if (entry.returnsVoid()) {
            let ignored = instructions.buildRet(emitter.builder, intType.constInt(0, false));
        } else {
            let ignored = instructions.buildRet(emitter.builder, called);
        }
        return "";
    }

    let builder = emitter.builder;
    let slot = memory.buildAlloca(builder, pointerType, "err.slot");
    memory.buildStore(builder, pointerType.constNull(), slot);
    let called = instructions.buildCall(builder, emitter.calleeType(entry.symbol()), userMain,
        [slot], "");
    let error = memory.buildLoad(builder, pointerType, slot, "err");
    let thrown = instructions.buildICmpNE(builder, error, pointerType.constNull(), "thrown");
    let uncaught = emitter.context.appendBasicBlock(wrapper, "uncaught");
    let finished = emitter.context.appendBasicBlock(wrapper, "ok");
    instructions.buildCondBr(builder, thrown, uncaught, finished);

    builder.positionAtEnd(finished);
    if (entry.returnsVoid()) {
        let ignored = instructions.buildRet(builder, intType.constInt(0, false));
    } else {
        let ignored = instructions.buildRet(builder, called);
    }

    // "Unhandled exception <Type>: <message>" and the captured trace, on standard error.
    builder.positionAtEnd(uncaught);
    let errorType = emitter.errorType();
    if (errorType == null) {
        return "Internal: the entry wrapper reports uncaught exceptions but the program "
            + "declares no std.core Error class";
    }
    let errorLayout = emitter.classLayout(errorType);
    let runtime = emitter.runtime;
    let write = runtime.fputs();
    let stream = runtime.standardError();
    let descriptor = emitter.descriptors.loadDescriptor(error);
    let typeName = memory.buildLoad(builder, pointerType,
        memory.buildStructGEP(builder, emitter.descriptors.descriptorType(), descriptor, 0, ""),
        "type.name");
    runtime.call(write, [globals.buildGlobalString(builder, "Unhandled exception ",
        ".uncaught.prefix"), stream], "");
    runtime.call(write, [typeName, stream], "");
    runtime.call(write, [globals.buildGlobalString(builder, ": ", ".uncaught.colon"),
        stream], "");
    long messageIndex = exceptions.errorFieldIndex(errorType, "message");
    long framesIndex = exceptions.errorFieldIndex(errorType, "frames");
    if (messageIndex < 0 || framesIndex < 0) {
        return "Internal: the entry wrapper reports uncaught exceptions but the standard "
            + "library's Error declares no 'message' and 'frames' fields";
    }
    let message = memory.buildLoad(builder, pointerType,
        memory.buildStructGEP(builder, errorLayout, error, messageIndex as uint,
            "message.slot"), "message");
    runtime.call(write, [runtime.payloadData(message), stream], "");
    runtime.call(write, [globals.buildGlobalString(builder, "\n", ".uncaught.newline"),
        stream], "");
    let frames = memory.buildLoad(builder, pointerType,
        memory.buildStructGEP(builder, errorLayout, error, framesIndex as uint,
            "frames.slot"), "frames");
    let trace = runtime.call(runtime.formatTrace(), [frames], "trace.text");
    runtime.call(write, [runtime.payloadData(trace), stream], "");
    runtime.call(runtime.release(), [error], "");
    let ignored = instructions.buildRet(builder, intType.constInt(1, false));
    return "";
}
