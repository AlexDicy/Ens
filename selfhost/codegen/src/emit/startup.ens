// The code a Linux program starts at, which hands the arguments and the environment the kernel left
// on the stack to glibc's __libc_start_main, and with them the program's main. It is the job a C
// compiler's Scrt1.o does, written here so a Linux program links with no C compiler on the machine.
// The outermost frame marks its return address as undefined, so a stack walk ends there.
import @ens.llvm.core;
import @ens.llvm.target;
import Architecture from @ens.target.triple;
import TargetTriple from @ens.target.triple;

// Writes the startup object for `program` to `objectPath`. Returns "" when it was written, or why
// it was not.
export writeStartupObject(TargetTriple program, string objectPath) -> string {
    target.initializeTargets();
    string triple = program.text();
    let resolved = target.targetFromTriple(triple);
    if (resolved == null) {
        return "Internal: could not resolve the target '{triple}' for its startup object";
    }
    let context = core.createContext();
    let module = context.createModule("ens.startup");
    module.setTarget(triple);
    module.setModuleInlineAsm(assemblyFor(program.architecture()));
    let machine = resolved.createTargetMachine(triple, 0);
    string written = machine.emitObjectFile(module, objectPath);
    machine.dispose();
    module.dispose();
    context.dispose();
    return written;
}

// The entry point, and '_IO_stdin_used', which glibc reads to tell which stdio a program was built
// against.
export assemblyFor(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "\t.text\n"
            + "\t.globl _start\n"
            + "\t.type _start, @function\n"
            + "_start:\n"
            + "\t.cfi_startproc\n"
            + "\t.cfi_undefined %rip\n"
            + "\txorl %ebp, %ebp\n"
            + "\tmovq %rdx, %r9\n"
            + "\tpopq %rsi\n"
            + "\tmovq %rsp, %rdx\n"
            + "\tandq $-16, %rsp\n"
            + "\tpushq %rax\n"
            + "\tpushq %rsp\n"
            + "\txorl %r8d, %r8d\n"
            + "\txorl %ecx, %ecx\n"
            + "\tmovq main@GOTPCREL(%rip), %rdi\n"
            + "\tcallq *__libc_start_main@GOTPCREL(%rip)\n"
            + "\thlt\n"
            + "\t.cfi_endproc\n"
            + "\t.size _start, .-_start\n"
            + stdinUsed("@")
            + "\t.section .note.GNU-stack,\"\",@progbits\n",
        Architecture.Arm64 -> "\t.text\n"
            + "\t.globl _start\n"
            + "\t.type _start, %function\n"
            + "_start:\n"
            + "\t.cfi_startproc\n"
            + "\t.cfi_undefined x30\n"
            + "\tmov x29, #0\n"
            + "\tmov x30, #0\n"
            + "\tmov x5, x0\n"
            + "\tldr x1, [sp]\n"
            + "\tadd x2, sp, #8\n"
            + "\tmov x6, sp\n"
            + "\tmov x3, #0\n"
            + "\tmov x4, #0\n"
            + "\tadrp x0, :got:main\n"
            + "\tldr x0, [x0, :got_lo12:main]\n"
            + "\tbl __libc_start_main\n"
            + "\tbl abort\n"
            + "\t.cfi_endproc\n"
            + "\t.size _start, .-_start\n"
            + stdinUsed("%")
            + "\t.section .note.GNU-stack,\"\",%progbits\n",
    };
}

// `marker` is how the architecture's assembler writes a symbol type, '@' or '%'.
stdinUsed(string marker) -> string {
    return "\t.section .rodata\n"
        + "\t.globl _IO_stdin_used\n"
        + "\t.type _IO_stdin_used, {marker}object\n"
        + "\t.p2align 2\n"
        + "_IO_stdin_used:\n"
        + "\t.long 0x20001\n"
        + "\t.size _IO_stdin_used, 4\n";
}
