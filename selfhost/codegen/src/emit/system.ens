// The std.system bridges that answer with the running process's own facts. The argc and argv
// globals they read are defined by the entry module's wrapper and declared everywhere else, and
// `environ` is the C library's own.
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import StringCollector from emit.stringlists;
import emit.filesystem.posix;
import emit.filesystem.windows;
import emit.widetext;

// ptr ens_arguments(): the process arguments as an owned string[], one lifted copy per argv entry.
// The finalizer is the string array's, which releases the copies.
public argumentsRuntime(Runtime runtime, Value finalizer) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([]);
    let known = runtime.existing("ens_arguments", type);
    if (known != null) {
        return known;
    }
    let allocate = runtime.alloc();
    let lift = runtime.stringFromCString();
    let definition = runtime.beginDefinition("ens_arguments", type);
    let builder = runtime.builder;
    let count = instructions.buildSExt(builder,
        memory.buildLoad(builder, runtime.int32Type, argcGlobal(runtime), "argc"),
        runtime.int64Type, "count");
    let vector = memory.buildLoad(builder, runtime.pointerType, argvGlobal(runtime), "argv");
    let bytes = instructions.buildAdd(builder, runtime.int64(8),
        instructions.buildMul(builder, count, runtime.int64(8), ""), "bytes");
    let result = runtime.call(allocate, [bytes, finalizer, runtime.nullPointer()], "arguments");
    memory.buildStore(builder, count, result);
    let data = runtime.payloadData(result);
    let index = memory.buildAlloca(builder, runtime.int64Type, "i");
    memory.buildStore(builder, runtime.int64(0), index);

    let test = runtime.block(definition, "fill.test");
    let body = runtime.block(definition, "fill.body");
    let done = runtime.block(definition, "done");
    instructions.buildBr(builder, test);

    builder.positionAtEnd(test);
    let position = memory.buildLoad(builder, runtime.int64Type, index, "i.cur");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, position, count, ""), body, done);

    builder.positionAtEnd(body);
    let raw = memory.buildLoad(builder, runtime.pointerType,
        memory.buildGEP(builder, runtime.pointerType, vector, [position], ""), "argv.i");
    let lifted = runtime.call(lift, [raw], "argument");
    memory.buildStore(builder, lifted,
        memory.buildGEP(builder, runtime.pointerType, data, [position], ""));
    memory.buildStore(builder, instructions.buildAdd(builder, position, runtime.int64(1), ""),
        index);
    instructions.buildBr(builder, test);

    builder.positionAtEnd(done);
    instructions.buildRet(builder, result);
    return runtime.endDefinition(definition);
}

// i32 ens_platform(): 0 for Windows, 2 for macOS, 1 for everything else, which behaves as Linux
// does. The code is decided while the module is emitted, so the Ens wrapper turns it into a name
// without asking the operating system anything.
public platformRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([]);
    let known = runtime.existing("ens_platform", type);
    if (known != null) {
        return known;
    }
    long code = 1;
    if (runtime.onWindows()) {
        code = 0;
    } else if (runtime.onDarwin()) {
        code = 2;
    }
    let definition = runtime.beginDefinition("ens_platform", type);
    instructions.buildRet(runtime.builder, runtime.int32(code));
    return runtime.endDefinition(definition);
}

// ptr ens_standard_output/error/input(): the handle the C library keeps for one standard stream.
// Each is a macro there, so a foreign declaration cannot name one and these hand them over.
public standardOutputRuntime(Runtime runtime) -> RuntimeFunction {
    return standardHandle(runtime, "ens_standard_output", 1);
}

public standardErrorRuntime(Runtime runtime) -> RuntimeFunction {
    return standardHandle(runtime, "ens_standard_error", 2);
}

public standardInputRuntime(Runtime runtime) -> RuntimeFunction {
    return standardHandle(runtime, "ens_standard_input", 0);
}

standardHandle(Runtime runtime, string symbol, long descriptor) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([]);
    let known = runtime.existing(symbol, type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition(symbol, type);
    instructions.buildRet(runtime.builder, runtime.standardStream(descriptor));
    return runtime.endDefinition(definition);
}

// ptr ens_environment(): the variables this process inherited as an owned string[] of 'NAME=VALUE'
// entries, in the order the operating system holds them.
public environmentRuntime(Runtime runtime, Value finalizer) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([]);
    let known = runtime.existing("ens_environment", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windowsEnvironment(runtime, type, finalizer);
    }
    return posixEnvironment(runtime, type, finalizer);
}

windowsEnvironment(Runtime runtime, TypeRef type, Value finalizer) -> RuntimeFunction {
    let environmentStrings = runtime.libc("GetEnvironmentStringsW",
        runtime.pointerType.functionType([]));
    let releaseStrings = runtime.libc("FreeEnvironmentStringsW",
        runtime.int32Type.functionType([runtime.pointerType]));
    let wideLength = runtime.libc("lstrlenW",
        runtime.int32Type.functionType([runtime.pointerType]));
    let narrow = widetext.utf8FromWide(runtime);
    let lift = runtime.stringFromCString();
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_environment", type);
    let builder = runtime.builder;
    let testBlock = runtime.block(definition, "environment.test");
    let bodyBlock = runtime.block(definition, "environment.body");
    let keptBlock = runtime.block(definition, "environment.kept");
    let nextBlock = runtime.block(definition, "environment.next");
    let releaseBlock = runtime.block(definition, "environment.release");
    let listBlock = runtime.block(definition, "environment.list");
    let collected = new StringCollector(runtime);
    let block = runtime.call(environmentStrings, [], "environment");
    let cursorSlot = memory.buildAlloca(builder, runtime.pointerType, "cursor");
    memory.buildStore(builder, block, cursorSlot);
    instructions.buildCondBr(builder, runtime.isNull(block), listBlock, testBlock);

    // The block holds the entries one after another, each NUL terminated, and one more terminator
    // closes it.
    builder.positionAtEnd(testBlock);
    let cursor = memory.buildLoad(builder, runtime.pointerType, cursorSlot, "cursor.cur");
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder,
        memory.buildLoad(builder, runtime.int16Type, cursor, "cursor.first"),
        runtime.int16Type.constInt(0, false), ""), releaseBlock, bodyBlock);

    builder.positionAtEnd(bodyBlock);
    let text = runtime.call(narrow, [cursor], "entry.text");
    instructions.buildCondBr(builder, runtime.isNull(text), nextBlock, keptBlock);

    builder.positionAtEnd(keptBlock);
    collected.push(definition, runtime.call(lift, [text], "entry.string"));
    runtime.call(release, [text], "");
    instructions.buildBr(builder, nextBlock);

    builder.positionAtEnd(nextBlock);
    let characters = instructions.buildAdd(builder, instructions.buildSExt(builder,
        runtime.call(wideLength, [cursor], "entry.length"), runtime.int64Type, ""),
        runtime.int64(1), "");
    memory.buildStore(builder, memory.buildGEP(builder, runtime.int16Type, cursor, [characters],
        "cursor.next"), cursorSlot);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(releaseBlock);
    runtime.call(releaseStrings, [block], "");
    instructions.buildBr(builder, listBlock);

    builder.positionAtEnd(listBlock);
    instructions.buildRet(builder, collected.list(finalizer));
    return runtime.endDefinition(definition);
}

posixEnvironment(Runtime runtime, TypeRef type, Value finalizer) -> RuntimeFunction {
    let lift = runtime.stringFromCString();
    let definition = runtime.beginDefinition("ens_environment", type);
    let builder = runtime.builder;
    let testBlock = runtime.block(definition, "environment.test");
    let bodyBlock = runtime.block(definition, "environment.body");
    let listBlock = runtime.block(definition, "environment.list");
    let collected = new StringCollector(runtime);
    let base = memory.buildLoad(builder, runtime.pointerType, environGlobal(runtime), "environ");
    let indexSlot = memory.buildAlloca(builder, runtime.int64Type, "index");
    memory.buildStore(builder, runtime.int64(0), indexSlot);
    instructions.buildCondBr(builder, runtime.isNull(base), listBlock, testBlock);

    builder.positionAtEnd(testBlock);
    let index = memory.buildLoad(builder, runtime.int64Type, indexSlot, "index.cur");
    let text = memory.buildLoad(builder, runtime.pointerType,
        memory.buildGEP(builder, runtime.pointerType, base, [index], ""), "entry.text");
    instructions.buildCondBr(builder, runtime.isNull(text), listBlock, bodyBlock);

    builder.positionAtEnd(bodyBlock);
    collected.push(definition, runtime.call(lift, [text], "entry.string"));
    memory.buildStore(builder, instructions.buildAdd(builder, index, runtime.int64(1), ""),
        indexSlot);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(listBlock);
    instructions.buildRet(builder, collected.list(finalizer));
    return runtime.endDefinition(definition);
}

// i64 ens_current_directory(ptr buffer, i64 capacity): how many bytes of the directory the program
// was started in were written into the buffer, or -1 when the operating system would not report it
// or the buffer is too small to hold it. The text is the operating system's own, with no
// terminator, so a Windows answer carries backslashes.
public currentDirectoryRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int64Type.functionType([runtime.pointerType, runtime.int64Type]);
    let known = runtime.existing("ens_current_directory", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windows.windowsCurrentDirectory(runtime, type);
    }
    return posix.posixCurrentDirectory(runtime, type);
}

// i64 ens_executable_path(ptr buffer, i64 capacity): how many bytes of the running program's own
// path were written into the buffer, or -1 when the operating system would not report it or the
// buffer is too small to hold it.
public executablePathRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int64Type.functionType([runtime.pointerType, runtime.int64Type]);
    let known = runtime.existing("ens_executable_path", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windowsExecutablePath(runtime, type);
    }
    if (runtime.onDarwin()) {
        return darwinExecutablePath(runtime, type);
    }
    return linuxExecutablePath(runtime, type);
}

windowsExecutablePath(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let moduleFileName = runtime.libc("GetModuleFileNameW", runtime.int32Type.functionType(
        [runtime.pointerType, runtime.pointerType, runtime.int32Type]));
    let narrow = widetext.narrowFunction(runtime);
    let allocate = runtime.malloc();
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_executable_path", type);
    let builder = runtime.builder;
    let namedBlock = runtime.block(definition, "path.named");
    let narrowedBlock = runtime.block(definition, "path.narrowed");
    let tooLongBlock = runtime.block(definition, "path.too.long");
    let unknownBlock = runtime.block(definition, "path.unknown");
    // The longest path Windows reports is 32767 characters and a terminator.
    let room = runtime.int32(32768);
    let wide = runtime.call(allocate, [runtime.int64(65536)], "wide");
    instructions.buildCondBr(builder, runtime.isNull(wide), unknownBlock, namedBlock);

    builder.positionAtEnd(namedBlock);
    let characters = runtime.call(moduleFileName, [runtime.nullPointer(), wide, room],
        "characters");
    let reported = instructions.buildAnd(builder,
        instructions.buildICmpSGT(builder, characters, runtime.int32(0), ""),
        instructions.buildICmpSLT(builder, characters, room, ""), "reported");
    instructions.buildCondBr(builder, reported, narrowedBlock, tooLongBlock);

    builder.positionAtEnd(tooLongBlock);
    runtime.call(release, [wide], "");
    instructions.buildBr(builder, unknownBlock);

    builder.positionAtEnd(narrowedBlock);
    let bytes = runtime.call(narrow, [widetext.utf8CodePage(runtime), runtime.int32(0), wide,
        runtime.int32(-1), runtime.parameter(definition, 0),
        instructions.buildTrunc(builder, runtime.parameter(definition, 1), runtime.int32Type,
            "capacity"), runtime.nullPointer(), runtime.nullPointer()], "bytes");
    runtime.call(release, [wide], "");
    // The count includes the terminator, which an Ens string does not carry.
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpSLE(builder, bytes, runtime.int32(1), ""), runtime.int64(-1),
        instructions.buildSub(builder,
            instructions.buildSExt(builder, bytes, runtime.int64Type, ""), runtime.int64(1), ""),
        ""));

    builder.positionAtEnd(unknownBlock);
    instructions.buildRet(builder, runtime.int64(-1));
    return runtime.endDefinition(definition);
}

darwinExecutablePath(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let executablePath = runtime.libc("_NSGetExecutablePath",
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let measure = runtime.strlen();
    let definition = runtime.beginDefinition("ens_executable_path", type);
    let builder = runtime.builder;
    let namedBlock = runtime.block(definition, "path.named");
    let unknownBlock = runtime.block(definition, "path.unknown");
    let roomSlot = memory.buildAlloca(builder, runtime.int32Type, "room");
    memory.buildStore(builder, instructions.buildTrunc(builder, runtime.parameter(definition, 1),
        runtime.int32Type, "capacity"), roomSlot);
    let status = runtime.call(executablePath, [runtime.parameter(definition, 0), roomSlot],
        "status");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), namedBlock, unknownBlock);

    builder.positionAtEnd(namedBlock);
    instructions.buildRet(builder,
        runtime.call(measure, [runtime.parameter(definition, 0)], "length"));

    builder.positionAtEnd(unknownBlock);
    instructions.buildRet(builder, runtime.int64(-1));
    return runtime.endDefinition(definition);
}

linuxExecutablePath(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let readLink = runtime.libc("readlink", runtime.int64Type.functionType([runtime.pointerType,
        runtime.pointerType, runtime.int64Type]));
    let definition = runtime.beginDefinition("ens_executable_path", type);
    let builder = runtime.builder;
    let capacity = runtime.parameter(definition, 1);
    let written = runtime.call(readLink, [globals.buildGlobalString(builder, "/proc/self/exe",
        ".self.exe"), runtime.parameter(definition, 0), capacity], "written");
    let fits = instructions.buildAnd(builder,
        instructions.buildICmpSGT(builder, written, runtime.int64(0), ""),
        instructions.buildICmpSLT(builder, written, capacity, ""), "fits");
    instructions.buildRet(builder, instructions.buildSelect(builder, fits, written,
        runtime.int64(-1), ""));
    return runtime.endDefinition(definition);
}

// The `environ` the C library keeps its environment in: read to answer for this process, and
// written in a forked child to hand it a different one.
public environGlobal(Runtime runtime) -> Value {
    let found = globals.getNamedGlobal(runtime.module, "environ");
    if (found != null) {
        return found;
    }
    return globals.addGlobal(runtime.module, runtime.pointerType, "environ");
}

// The argument globals the entry wrapper writes: defined there, declared here.
argcGlobal(Runtime runtime) -> Value {
    let found = globals.getNamedGlobal(runtime.module, "ens_argc");
    if (found != null) {
        return found;
    }
    return globals.addGlobal(runtime.module, runtime.int32Type, "ens_argc");
}

argvGlobal(Runtime runtime) -> Value {
    let found = globals.getNamedGlobal(runtime.module, "ens_argv");
    if (found != null) {
        return found;
    }
    return globals.addGlobal(runtime.module, runtime.pointerType, "ens_argv");
}
