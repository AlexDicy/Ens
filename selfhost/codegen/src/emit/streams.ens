// The bridges over the C library's own streams. Each one makes its call and reads the library's
// error number inside the same function, because a number read any later is a number some other
// call is free to have written first. The number is the library's errno on every target, including
// Windows, since a C stream call is what reports it and the Microsoft runtime sets it too.
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import DarwinStat from emit.nativeshapes;
import FileMode from emit.nativeshapes;
import emit.nativeshapes;
import Win32Error from emit.errorkinds;
import WatchState from emit.pollers;
import emit.pollers;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import emit.filesystem.windows;

// What a stream call returns when it failed and the library named no reason. Every target this
// compiler builds for numbers EIO the same, which is what lets one number serve all of them.
public final class Unnamed {
    public static const long failure = 5;
}

// i32 ens_stream_write(ptr handle, ptr data, i64 count, ptr written): 0 once all `count` bytes are
// the stream's, or the library's own number for why they are not. `written` always holds how many
// bytes went, so a caller can report how far it got.
public writeRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType]);
    let known = runtime.existing("ens_stream_write", type);
    if (known != null) {
        return known;
    }
    let write = runtime.libc("fwrite", runtime.int64Type.functionType([runtime.pointerType,
        runtime.int64Type, runtime.int64Type, runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_stream_write", type);
    let builder = runtime.builder;
    let handle = runtime.parameter(definition, 0);
    let count = runtime.parameter(definition, 2);
    let taken = runtime.call(write, [runtime.parameter(definition, 1), runtime.int64(1), count,
        handle], "taken");
    memory.buildStore(builder, taken, runtime.parameter(definition, 3));
    let whole = runtime.block(definition, "write.whole");
    let partial = runtime.block(definition, "write.partial");
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder, taken, count, "whole"),
        whole, partial);

    builder.positionAtEnd(whole);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(partial);
    instructions.buildRet(builder, reason(runtime));
    return runtime.endDefinition(definition);
}

// i32 ens_stream_read(ptr handle, ptr buffer, i64 capacity, ptr count): 0 with `count` holding what
// arrived, which is 0 once the stream has ended, or the library's own number where nothing arrived
// because the stream failed. The stream's descriptor is read once, so a pipe or a terminal returns
// what it holds rather than waiting for `capacity` bytes, and the stream is read again for more. A
// read a signal interrupted is made again. The C library's buffer is never read through, which
// holds because a stream is opened to be read or to be written, never both.
public readRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType]);
    let known = runtime.existing("ens_stream_read", type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition("ens_stream_read", type);
    let builder = runtime.builder;
    let handle = runtime.parameter(definition, 0);
    let buffer = runtime.parameter(definition, 1);
    let capacity = runtime.parameter(definition, 2);
    let countSlot = runtime.parameter(definition, 3);
    let attempt = runtime.block(definition, "read.attempt");
    let some = runtime.block(definition, "read.some");
    let failed = runtime.block(definition, "read.failed");
    let again = runtime.block(definition, "read.again");
    let broken = runtime.block(definition, "read.broken");
    let descriptor = runtime.call(descriptorFunction(runtime), [handle], "descriptor");
    instructions.buildBr(builder, attempt);

    builder.positionAtEnd(attempt);
    let arrived = readOnce(runtime, descriptor, buffer, capacity);
    instructions.buildCondBr(builder, instructions.buildICmpSLT(builder, arrived,
        runtime.int64(0), "failed"), failed, some);

    builder.positionAtEnd(some);
    memory.buildStore(builder, arrived, countSlot);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(failed);
    let why = runtime.errnoValue();
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder, why,
        runtime.int32(Interrupted.number as int), "interrupted"), again, broken);

    builder.positionAtEnd(again);
    instructions.buildBr(builder, attempt);

    builder.positionAtEnd(broken);
    memory.buildStore(builder, runtime.int64(0), countSlot);
    instructions.buildRet(builder, reason(runtime));
    return runtime.endDefinition(definition);
}

// The C library's descriptor under a stream.
descriptorFunction(Runtime runtime) -> RuntimeFunction {
    let name = runtime.onWindows() ? "_fileno" : "fileno";
    return runtime.libc(name, runtime.int32Type.functionType([runtime.pointerType]));
}

// One read of the descriptor into the buffer: the bytes that arrived, 0 at the end, or a negative
// count where the read failed. Windows reads at most the largest count its 'unsigned int' holds.
readOnce(Runtime runtime, Value descriptor, Value buffer, Value capacity) -> Value {
    let builder = runtime.builder;
    if (runtime.onWindows()) {
        let read = runtime.libc("_read", runtime.int32Type.functionType([runtime.int32Type,
            runtime.pointerType, runtime.int32Type]));
        let bounded = instructions.buildSelect(builder, instructions.buildICmpSGT(builder,
            capacity, runtime.int64(0x7FFFFFFF), ""), runtime.int64(0x7FFFFFFF), capacity,
            "bounded");
        let arrived = runtime.call(read, [descriptor, buffer,
            instructions.buildTrunc(builder, bounded, runtime.int32Type, "")], "arrived");
        return instructions.buildSExt(builder, arrived, runtime.int64Type, "arrived.wide");
    }
    let read = runtime.libc("read", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    return runtime.call(read, [descriptor, buffer, capacity], "arrived");
}

// The number a read a signal interrupted fails with, which every POSIX target this compiler builds
// for numbers the same. The Windows library never reports it from a read.
final class Interrupted {
    static const long number = 4;
}

// i32 ens_stream_watch(ptr handle, ptr poller, i64 token, ptr error): one wake under 'token' once
// the stream has bytes to read or has reached its end, as ens_poller_watch_descriptor reports it. A
// regular file is ready, since its reads never wait and macOS would never report one at its end.
// On Windows a disk file or a device other than a console is ready, a pipe is watched through a
// read of zero bytes, which waits for bytes without taking any, and a console is unwatchable,
// since a line-mode read waits for Enter whatever the console holds, so it is read in a call of
// its own.
public watchRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType]);
    let known = runtime.existing("ens_stream_watch", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return windowsWatch(runtime, type);
    }
    let watch = pollers.watchDescriptorRuntime(runtime);
    let definition = runtime.beginDefinition("ens_stream_watch", type);
    let builder = runtime.builder;
    let descriptor = runtime.call(descriptorFunction(runtime), [runtime.parameter(definition, 0)],
        "descriptor");
    if (runtime.onDarwin()) {
        let describe = runtime.libc(nativeshapes.entryPointName(runtime.target, "fstat"),
            runtime.int32Type.functionType([runtime.int32Type, runtime.pointerType]));
        let result = memory.buildAlloca(builder,
            runtime.int8Type.arrayType(DarwinStat.structBytes as ulong), "stat");
        let regular = runtime.block(definition, "watch.regular");
        let other = runtime.block(definition, "watch.other");
        let described = runtime.call(describe, [descriptor, result], "described");
        let mode = memory.buildLoad(builder, runtime.int16Type,
            runtime.offsetPointer(result, DarwinStat.modeOffset, ""), "mode");
        instructions.buildCondBr(builder, instructions.buildAnd(builder,
            instructions.buildICmpEQ(builder, described, runtime.int32(0), ""),
            instructions.buildICmpEQ(builder, instructions.buildAnd(builder, mode,
                runtime.int16Type.constInt(FileMode.typeMask as ulong, false), ""),
                runtime.int16Type.constInt(FileMode.regular as ulong, false), ""), "regular"),
            regular, other);

        builder.positionAtEnd(regular);
        instructions.buildRet(builder, runtime.int32(WatchState.ready as int));

        builder.positionAtEnd(other);
    }
    instructions.buildRet(builder, runtime.call(watch, [runtime.parameter(definition, 1),
        descriptor, runtime.parameter(definition, 2), runtime.parameter(definition, 3)],
        "state"));
    return runtime.endDefinition(definition);
}

// What GetFileType reports for a handle.
final class FileType {
    static const long disk = 1;
    static const long character = 2;
    static const long pipe = 3;
}

// Where a Windows pipe watch keeps what its work item needs: the pipe, the port and the token.
final class PipeWatch {
    static const long pipe = 0;
    static const long port = 8;
    static const long token = 16;
    static const long bytes = 24;
}

windowsWatch(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let fileType = runtime.libc("GetFileType",
        runtime.int32Type.functionType([runtime.pointerType]));
    let consoleMode = runtime.libc("GetConsoleMode",
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let peek = runtime.libc("PeekNamedPipe", runtime.int32Type.functionType([runtime.pointerType,
        runtime.pointerType, runtime.int32Type, runtime.pointerType, runtime.pointerType,
        runtime.pointerType]));
    let submit = runtime.libc("TrySubmitThreadpoolCallback", runtime.int32Type.functionType([
        runtime.pointerType, runtime.pointerType, runtime.pointerType]));
    let allocate = runtime.calloc();
    let deallocate = runtime.free();
    let ready = pipeReadyRuntime(runtime);
    let definition = runtime.beginDefinition("ens_stream_watch", type);
    let builder = runtime.builder;
    let poller = runtime.parameter(definition, 1);
    let error = runtime.parameter(definition, 3);
    let characterBlock = runtime.block(definition, "watch.character");
    let otherBlock = runtime.block(definition, "watch.other");
    let pipeBlock = runtime.block(definition, "watch.pipe");
    let emptyBlock = runtime.block(definition, "watch.empty");
    let recordBlock = runtime.block(definition, "watch.record");
    let submittedBlock = runtime.block(definition, "watch.submitted");
    let unsubmittedBlock = runtime.block(definition, "watch.unsubmitted");
    let noMemoryBlock = runtime.block(definition, "watch.no.memory");
    let consoleBlock = runtime.block(definition, "watch.console");
    let readyBlock = runtime.block(definition, "watch.ready");
    let handle = windows.streamHandle(runtime, runtime.parameter(definition, 0));
    let kind = runtime.call(fileType, [handle], "kind");
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder, kind,
        runtime.int32(FileType.character), ""), characterBlock, otherBlock);

    builder.positionAtEnd(characterBlock);
    let mode = memory.buildAlloca(builder, runtime.int32Type, "mode");
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder,
        runtime.call(consoleMode, [handle, mode], "console"), runtime.int32(0), ""),
        consoleBlock, readyBlock);

    builder.positionAtEnd(otherBlock);
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder, kind,
        runtime.int32(FileType.pipe), ""), pipeBlock, readyBlock);

    // A pipe holding bytes, or one whose writer is gone, needs no wait.
    builder.positionAtEnd(pipeBlock);
    let available = memory.buildAlloca(builder, runtime.int32Type, "available");
    memory.buildStore(builder, runtime.int32(0), available);
    let peeked = runtime.call(peek, [handle, runtime.nullPointer(), runtime.int32(0),
        runtime.nullPointer(), available, runtime.nullPointer()], "peeked");
    instructions.buildCondBr(builder, instructions.buildAnd(builder,
        instructions.buildICmpNE(builder, peeked, runtime.int32(0), ""),
        instructions.buildICmpEQ(builder, memory.buildLoad(builder, runtime.int32Type, available,
            ""), runtime.int32(0), ""), "empty"), emptyBlock, readyBlock);

    builder.positionAtEnd(emptyBlock);
    let record = runtime.call(allocate, [runtime.int64(1), runtime.int64(PipeWatch.bytes)],
        "record");
    instructions.buildCondBr(builder, runtime.isNull(record), noMemoryBlock, recordBlock);

    builder.positionAtEnd(recordBlock);
    memory.buildStore(builder, handle, runtime.offsetPointer(record, PipeWatch.pipe, ""));
    memory.buildStore(builder, pollers.portOf(runtime, poller),
        runtime.offsetPointer(record, PipeWatch.port, ""));
    memory.buildStore(builder, runtime.parameter(definition, 2),
        runtime.offsetPointer(record, PipeWatch.token, ""));
    let submitted = runtime.call(submit, [ready.function, record, runtime.nullPointer()],
        "submitted");
    let why = runtime.lastError();
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder, submitted,
        runtime.int32(0), ""), submittedBlock, unsubmittedBlock);

    builder.positionAtEnd(submittedBlock);
    instructions.buildRet(builder, runtime.int32(WatchState.watching as int));

    builder.positionAtEnd(unsubmittedBlock);
    runtime.call(deallocate, [record], "");
    memory.buildStore(builder, why, error);
    instructions.buildRet(builder, runtime.int32(WatchState.failed as int));

    builder.positionAtEnd(noMemoryBlock);
    memory.buildStore(builder, runtime.int32(Win32Error.notEnoughMemory), error);
    instructions.buildRet(builder, runtime.int32(WatchState.failed as int));

    builder.positionAtEnd(consoleBlock);
    instructions.buildRet(builder, runtime.int32(WatchState.unwatchable as int));

    builder.positionAtEnd(readyBlock);
    instructions.buildRet(builder, runtime.int32(WatchState.ready as int));
    return runtime.endDefinition(definition);
}

// The thread-pool work item a pipe watch submits: a read of zero bytes, which returns once the
// pipe holds bytes or its writer is gone and takes none of them, then the token posted to the
// poller's port. The record is the work item's own and is freed here.
pipeReadyRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.voidType.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_stream_pipe_ready", type);
    if (known != null) {
        return known;
    }
    let readFile = runtime.libc("ReadFile", runtime.int32Type.functionType([runtime.pointerType,
        runtime.pointerType, runtime.int32Type, runtime.pointerType, runtime.pointerType]));
    let post = pollers.postFunction(runtime);
    let deallocate = runtime.free();
    let definition = runtime.beginDefinition("ens_stream_pipe_ready", type);
    let builder = runtime.builder;
    let record = runtime.parameter(definition, 1);
    let none = memory.buildAlloca(builder, runtime.int8Type, "none");
    let count = memory.buildAlloca(builder, runtime.int32Type, "count");
    runtime.call(readFile, [memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(record, PipeWatch.pipe, ""), "pipe"), none, runtime.int32(0), count,
        runtime.nullPointer()], "");
    runtime.call(post, [memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(record, PipeWatch.port, ""), "port"), runtime.int32(0),
        memory.buildLoad(builder, runtime.int64Type,
            runtime.offsetPointer(record, PipeWatch.token, ""), "token"), runtime.nullPointer()],
        "");
    runtime.call(deallocate, [record], "");
    instructions.buildRetVoid(builder);
    return runtime.endDefinition(definition);
}

// i32 ens_stream_flush(ptr handle): 0 once everything written has reached the operating system, or
// the library's own number for why it has not.
public flushRuntime(Runtime runtime) -> RuntimeFunction {
    return oneCall(runtime, "ens_stream_flush", runtime.fflush());
}

// i32 ens_stream_close(ptr handle): 0 once the stream is the library's again and everything written
// reached the operating system, or the library's own number for why it did not. The handle must not
// be touched afterwards either way, since a close releases it whether or not it could finish. On
// Windows the close first gives back the lock 'ens_fs_lock' takes.
public closeRuntime(Runtime runtime) -> RuntimeFunction {
    if (runtime.onWindows()) {
        return oneCall(runtime, "ens_stream_close", windows.unlockedClose(runtime));
    }
    return oneCall(runtime, "ens_stream_close",
        runtime.libc("fclose", runtime.int32Type.functionType([runtime.pointerType])));
}

// A bridge over one C call that returns 0 or a number of its own, which is the shape both a flush
// and a close have.
oneCall(Runtime runtime, string name, RuntimeFunction call) -> RuntimeFunction {
    let type = runtime.int32Type.functionType([runtime.pointerType]);
    let known = runtime.existing(name, type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition(name, type);
    let builder = runtime.builder;
    let outcome = runtime.call(call, [runtime.parameter(definition, 0)], "outcome");
    let done = runtime.block(definition, "call.done");
    let refused = runtime.block(definition, "call.refused");
    instructions.buildCondBr(builder, instructions.buildICmpEQ(builder, outcome, runtime.int32(0),
        "done"), done, refused);

    builder.positionAtEnd(done);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(refused);
    instructions.buildRet(builder, reason(runtime));
    return runtime.endDefinition(definition);
}

// The number a failure returns, which is the library's own wherever it left one. A library that
// named none still has to return nonzero, because a caller given 0 would take the call for done.
reason(Runtime runtime) -> Value {
    let why = runtime.errnoValue();
    return instructions.buildSelect(runtime.builder,
        instructions.buildICmpEQ(runtime.builder, why, runtime.int32(0), "unnamed"),
        runtime.int32(Unnamed.failure as int), why, "reason");
}
