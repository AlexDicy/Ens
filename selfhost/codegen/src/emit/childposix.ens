// The POSIX half of the child bridges. The pipe is made before the fork, the child aims both of
// its output descriptors at the writing end, and the parent closes its own copy straight after
// forking, because a reading end still open for writing here would never report the end. Every
// end of both pipes is close-on-exec, and the second pipe carries the errno of an exec that failed
// back to the parent.
import TypeRef from @ens.llvm.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;
import RuntimeFunction from emit.runtime;
import emit.children;
import emit.spawnposix;
import emit.system;

public posixStart(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let makePipe = runtime.libc("pipe", runtime.int32Type.functionType([runtime.pointerType]));
    let control = runtime.libc("fcntl",
        runtime.int32Type.variadicFunctionType([runtime.int32Type, runtime.int32Type]));
    let forkProcess = runtime.libc("fork", runtime.int32Type.functionType([]));
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let execProgram = runtime.libc("execvp",
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let writeDescriptor = runtime.libc("write", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let readDescriptor = runtime.libc("read", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let exitChild = runtime.libc("_exit", runtime.voidType.functionType([runtime.int32Type]));
    let allocate = runtime.malloc();
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_start_process", type);
    let builder = runtime.builder;
    let pipeBlock = runtime.block(definition, "start.pipe");
    let reportBlock = runtime.block(definition, "start.report");
    let flagBlock = runtime.block(definition, "start.flags");
    let forkBlock = runtime.block(definition, "start.fork");
    let childBlock = runtime.block(definition, "start.child");
    let liftedBlock = runtime.block(definition, "start.child.lifted");
    let aimErrorsBlock = runtime.block(definition, "start.child.aim.errors");
    let aimedBlock = runtime.block(definition, "start.child.aimed");
    let takeBlock = runtime.block(definition, "start.child.environment");
    let execBlock = runtime.block(definition, "start.child.exec");
    let childFailedBlock = runtime.block(definition, "start.child.failed");
    let parentBlock = runtime.block(definition, "start.parent");
    let awaitBlock = runtime.block(definition, "start.report.await");
    let execFailedBlock = runtime.block(definition, "start.exec.failed");
    let recordBlock = runtime.block(definition, "start.record");
    let closeReportBlock = runtime.block(definition, "start.close.report");
    let closePipeBlock = runtime.block(definition, "start.close.pipe");
    let unforkedBlock = runtime.block(definition, "start.unforked");
    let closeReadBlock = runtime.block(definition, "start.close.read");
    let releaseBlock = runtime.block(definition, "start.release");
    let failedBlock = runtime.block(definition, "start.failed");

    // The child inherits a copy of whatever is still buffered in this process's streams, which it
    // would write out a second time; flushing the buffers first keeps a printed line ahead of the
    // child's output and unduplicated.
    runtime.flushBuffered();
    let descriptors = memory.buildAlloca(builder, runtime.int32Type.arrayType(2 as ulong), "pipe");
    let report = memory.buildAlloca(builder, runtime.int32Type.arrayType(2 as ulong), "report");
    let reportedSlot = memory.buildAlloca(builder, runtime.int32Type, "reported");
    let statusSlot = memory.buildAlloca(builder, runtime.int32Type, "collect.status");
    // Allocated before the fork, so no failure after it can leave a child running.
    let block = runtime.call(allocate, [runtime.int64(16)], "child.block");
    instructions.buildCondBr(builder, runtime.isNull(block), failedBlock, pipeBlock);

    builder.positionAtEnd(pipeBlock);
    let piped = runtime.call(makePipe, [descriptors], "piped");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, piped, runtime.int32(0), ""), reportBlock, releaseBlock);

    builder.positionAtEnd(reportBlock);
    let writeSlot = runtime.offsetPointer(descriptors, 4, "write.slot");
    let readEnd = memory.buildLoad(builder, runtime.int32Type,
        runtime.offsetPointer(descriptors, 0, ""), "read.end");
    let writeEnd = memory.buildLoad(builder, runtime.int32Type, writeSlot, "write.end");
    let reportPiped = runtime.call(makePipe, [report], "report.piped");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, reportPiped, runtime.int32(0), ""), flagBlock,
        closePipeBlock);

    builder.positionAtEnd(flagBlock);
    let reportRead = memory.buildLoad(builder, runtime.int32Type,
        runtime.offsetPointer(report, 0, ""), "report.read");
    let reportWrite = memory.buildLoad(builder, runtime.int32Type,
        runtime.offsetPointer(report, 4, ""), "report.write");
    let marks = [spawnposix.markCloseOnExec(runtime, control, readEnd, "flagged.read"),
        spawnposix.markCloseOnExec(runtime, control, writeEnd, "flagged.write"),
        spawnposix.markCloseOnExec(runtime, control, reportRead, "flagged.report.read"),
        spawnposix.markCloseOnExec(runtime, control, reportWrite, "flagged.report.write")];
    Value flagged = instructions.buildICmpSGE(builder, marks[0], runtime.int32(0), "");
    for (long index = 1; index < marks.length; index++) {
        flagged = instructions.buildAnd(builder, flagged,
            instructions.buildICmpSGE(builder, marks[index], runtime.int32(0), ""), "");
    }
    instructions.buildCondBr(builder, flagged, forkBlock, closeReportBlock);

    builder.positionAtEnd(forkBlock);
    let program = runtime.parameter(definition, 0);
    let argumentCount = runtime.parameter(definition, 2);
    let environmentCount = runtime.parameter(definition, 5);
    let argumentVector = memory.buildArrayAlloca(builder, runtime.pointerType,
        instructions.buildAdd(builder, argumentCount, runtime.int64(2), ""), "argv");
    memory.buildStore(builder, program, argumentVector);
    spawnposix.blockVector(runtime, definition, argumentVector, runtime.int64(1),
        runtime.parameter(definition, 1), argumentCount, "argv");
    let environmentVector = memory.buildArrayAlloca(builder, runtime.pointerType,
        instructions.buildAdd(builder, environmentCount, runtime.int64(1), ""), "envp");
    spawnposix.blockVector(runtime, definition, environmentVector, runtime.int64(0),
        runtime.parameter(definition, 4), environmentCount, "envp");
    let child = runtime.call(forkProcess, [], "child");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, child, runtime.int32(0), ""), childBlock, parentBlock);

    // The output pipe took the lowest free descriptors, so the report write end is always above 2
    // and only the output end can need lifting. Every end closes itself at exec, and dup2 leaves 1
    // and 2 open across it.
    builder.positionAtEnd(childBlock);
    spawnposix.liftLowEnd(runtime, definition, control, writeSlot, reportedSlot, liftedBlock,
        childFailedBlock, "start.child.output");

    builder.positionAtEnd(liftedBlock);
    let output = memory.buildLoad(builder, runtime.int32Type, writeSlot, "output");
    spawnposix.aimDescriptor(runtime, output, 1, reportedSlot, aimErrorsBlock, childFailedBlock,
        "aimed.output");

    builder.positionAtEnd(aimErrorsBlock);
    spawnposix.aimDescriptor(runtime, output, 2, reportedSlot, aimedBlock, childFailedBlock,
        "aimed.errors");

    builder.positionAtEnd(aimedBlock);
    instructions.buildCondBr(builder, instructions.buildICmpSGT(builder, environmentCount,
        runtime.int64(0), ""), takeBlock, execBlock);

    builder.positionAtEnd(takeBlock);
    memory.buildStore(builder, environmentVector, system.environGlobal(runtime));
    instructions.buildBr(builder, execBlock);

    // execvp returns only when the program could not be started.
    builder.positionAtEnd(execBlock);
    runtime.call(execProgram, [program, argumentVector], "");
    memory.buildStore(builder, runtime.lastError(), reportedSlot);
    instructions.buildBr(builder, childFailedBlock);

    builder.positionAtEnd(childFailedBlock);
    runtime.call(writeDescriptor, [reportWrite, reportedSlot, runtime.int64(4)], "");
    runtime.call(exitChild, [runtime.int32(127)], "");
    instructions.buildUnreachable(builder);

    builder.positionAtEnd(parentBlock);
    runtime.call(closeDescriptor, [writeEnd], "");
    runtime.call(closeDescriptor, [reportWrite], "");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, child, runtime.int32(0), ""), unforkedBlock,
        awaitBlock);

    // A successful exec closes the report pipe with nothing written, so no bytes means started.
    builder.positionAtEnd(awaitBlock);
    let reportLength = spawnposix.retryingRead(runtime, definition, readDescriptor, reportRead,
        reportedSlot, "report");
    runtime.call(closeDescriptor, [reportRead], "");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGT(builder, reportLength, runtime.int64(0), ""), execFailedBlock,
        recordBlock);

    builder.positionAtEnd(execFailedBlock);
    spawnposix.awaitChild(runtime, definition, child, statusSlot, closeReadBlock, "collect");
    instructions.buildBr(builder, closeReadBlock);

    builder.positionAtEnd(recordBlock);
    memory.buildStore(builder, instructions.buildSExt(builder, child, runtime.int64Type, ""),
        children.childField(runtime, block, 0));
    memory.buildStore(builder, instructions.buildSExt(builder, readEnd, runtime.int64Type, ""),
        children.childField(runtime, block, 8));
    instructions.buildRet(builder, block);

    builder.positionAtEnd(closeReportBlock);
    runtime.call(closeDescriptor, [reportRead], "");
    runtime.call(closeDescriptor, [reportWrite], "");
    instructions.buildBr(builder, closePipeBlock);

    builder.positionAtEnd(closePipeBlock);
    runtime.call(closeDescriptor, [writeEnd], "");
    instructions.buildBr(builder, closeReadBlock);

    builder.positionAtEnd(unforkedBlock);
    runtime.call(closeDescriptor, [reportRead], "");
    instructions.buildBr(builder, closeReadBlock);

    builder.positionAtEnd(closeReadBlock);
    runtime.call(closeDescriptor, [readEnd], "");
    instructions.buildBr(builder, releaseBlock);

    builder.positionAtEnd(releaseBlock);
    runtime.call(release, [block], "");
    instructions.buildRet(builder, runtime.nullPointer());

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

public posixRead(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let readDescriptor = runtime.libc("read", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let definition = runtime.beginDefinition("ens_read_child", type);
    let builder = runtime.builder;
    let count = runtime.call(readDescriptor, [descriptorAt(runtime, definition, 8),
        runtime.parameter(definition, 1), runtime.parameter(definition, 2)], "count");
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpSLT(builder, count, runtime.int64(0), ""), runtime.int64(-1), count,
        ""));
    return runtime.endDefinition(definition);
}

// poll takes the bound as it is given, so nothing here sleeps or spins. A child that has closed its
// end of the pipe wakes the wait too, which is the right result for a reader: reading would return at once
// and report the end of the output.
public posixPoll(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let pollDescriptors = runtime.libc("poll", runtime.int32Type.functionType([runtime.pointerType,
        runtime.int64Type, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_poll_child", type);
    let builder = runtime.builder;
    let callBlock = runtime.block(definition, "poll.call");
    let quietBlock = runtime.block(definition, "poll.quiet");
    let interruptedBlock = runtime.block(definition, "poll.interrupted");
    let readyBlock = runtime.block(definition, "poll.ready");
    let spentBlock = runtime.block(definition, "poll.spent");
    let failedBlock = runtime.block(definition, "poll.failed");

    // One 'struct pollfd': the descriptor, the events requested, and the events that happened.
    let watched = memory.buildAlloca(builder, runtime.int8Type.arrayType(8 as ulong), "watched");
    let descriptor = descriptorAt(runtime, definition, 8);
    let bound = instructions.buildTrunc(builder, runtime.parameter(definition, 1),
        runtime.int32Type, "bound");
    instructions.buildBr(builder, callBlock);

    builder.positionAtEnd(callBlock);
    memory.buildStore(builder, descriptor, runtime.offsetPointer(watched, 0, ""));
    // POLLIN, and no event reported yet.
    memory.buildStore(builder, runtime.int16Type.constInt(1, false),
        runtime.offsetPointer(watched, 4, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(0, false),
        runtime.offsetPointer(watched, 6, ""));
    let woken = runtime.call(pollDescriptors, [watched, runtime.int64(1), bound], "woken");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGT(builder, woken, runtime.int32(0), ""), readyBlock, quietBlock);

    builder.positionAtEnd(quietBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, woken, runtime.int32(0), ""), spentBlock,
        interruptedBlock);

    // EINTR: a signal interrupted the wait, which reports nothing about the child, so the wait is called
    // again rather than reported as a failure.
    builder.positionAtEnd(interruptedBlock);
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(4), ""), callBlock, failedBlock);

    builder.positionAtEnd(readyBlock);
    instructions.buildRet(builder, runtime.int32(1));

    builder.positionAtEnd(spentBlock);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, runtime.int32(-1));
    return runtime.endDefinition(definition);
}

// Ending a child that has already ended is nothing to do, which the system reports as ESRCH; every
// other refusal is a failure. The signal is the one no program can decline, and a child ended by it
// reports 128 and the signal's number, which is the code a stopped child reports everywhere.
public posixKill(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let killProcess = runtime.libc("kill",
        runtime.int32Type.functionType([runtime.int32Type, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_kill_child", type);
    let builder = runtime.builder;
    let refusedBlock = runtime.block(definition, "kill.refused");
    let stoppedBlock = runtime.block(definition, "kill.stopped");
    let status = runtime.call(killProcess, [descriptorAt(runtime, definition, 0),
        runtime.int32(9)], "status");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), stoppedBlock,
        refusedBlock);

    builder.positionAtEnd(refusedBlock);
    let why = runtime.lastError();
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(3), ""), runtime.int32(0),
        runtime.int32(-1), ""));

    builder.positionAtEnd(stoppedBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

// A wait that failed reports -1 rather than the exit code of a child that never reported
// one, because the caller has to distinguish the two.
public posixWait(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let definition = runtime.beginDefinition("ens_wait_child", type);
    let builder = runtime.builder;
    let statusSlot = memory.buildAlloca(builder, runtime.int32Type, "wait.status");
    let lostBlock = runtime.block(definition, "wait.lost");
    spawnposix.awaitChild(runtime, definition, descriptorAt(runtime, definition, 0), statusSlot,
        lostBlock, "wait");
    let status = memory.buildLoad(builder, runtime.int32Type, statusSlot, "wait.cur");
    instructions.buildRet(builder, instructions.buildSExt(builder,
        spawnposix.normalizedStatus(runtime, status), runtime.int64Type, ""));

    builder.positionAtEnd(lostBlock);
    instructions.buildRet(builder, runtime.int64(-1));
    return runtime.endDefinition(definition);
}

public posixRelease(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_release_child", type);
    let builder = runtime.builder;
    runtime.call(closeDescriptor, [descriptorAt(runtime, definition, 8)], "");
    // WNOHANG: a child that has already ended is collected here, and one still running is left to
    // the system, because nothing in a release may wait for a program to finish.
    runtime.call(waitForChild, [descriptorAt(runtime, definition, 0), runtime.nullPointer(),
        runtime.int32(1)], "");
    runtime.call(release, [runtime.parameter(definition, 0)], "");
    instructions.buildRetVoid(builder);
    return runtime.endDefinition(definition);
}

// A descriptor the child's block holds, narrowed to the width the system's calls take.
descriptorAt(Runtime runtime, RuntimeDefinition definition, long offset) -> Value {
    let builder = runtime.builder;
    return instructions.buildTrunc(builder, memory.buildLoad(builder, runtime.int64Type,
        children.childField(runtime, runtime.parameter(definition, 0), offset), "held"),
        runtime.int32Type, "descriptor");
}
