// The reference counting lowering made explicit: a retain or release of the +1 a value temp holds,
// and the pair that moves the +1 a location holds. These four instructions are the only place
// emission touches a count; every decision about where they belong was taken by lowering.
import EirRetain from eir.model;
import EirRelease from eir.model;
import EirRetainPtr from eir.model;
import EirReleasePtr from eir.model;
import Type from @ens.sema.model.types;
import Value from @ens.llvm.values;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;
import ReferenceWalker from support.references;
import support.references;
import List from @std.collections.list;

public emitRetain(ModuleEmitter emitter, EmissionFrame frame, EirRetain retain) {
    references.walk<Value>(new ValueRetainer(emitter), frame.value(retain.value),
        frame.tempType(retain.value));
}

// Retains each reference a value holds. Inside an optional's payload the reference retained is
// null while the tag reads absent, and retaining null does nothing.
final class ValueRetainer implements ReferenceWalker<Value> {
    ModuleEmitter emitter;
    List<Value> presence;

    protected constructor(ModuleEmitter emitter) {
        this.emitter = emitter;
        this.presence = new List<Value>();
    }

    override reference(Value reference) {
        Value retained = reference;
        if (this.presence.length() > 0) {
            retained = instructions.buildSelect(this.emitter.builder,
                this.presence.get(this.presence.length() - 1), reference,
                this.emitter.context.pointerType().constNull(), "");
        }
        this.emitter.runtime.call(this.emitter.runtime.retain(), [retained], "");
    }

    override field(Value record, Type recordType, long index, Type fieldType) -> Value {
        return instructions.buildExtractValue(this.emitter.builder, record, index as uint, "");
    }

    override payload(Value pair, Type optionalType, Type payloadType) -> Value {
        let builder = this.emitter.builder;
        Value present = instructions.buildExtractValue(builder, pair, 0 as uint, "");
        if (this.presence.length() > 0) {
            present = instructions.buildAnd(builder, this.presence.get(this.presence.length() - 1),
                present, "");
        }
        this.presence.push(present);
        return instructions.buildExtractValue(builder, pair, 1 as uint, "");
    }

    override endPayload() {
        let ignored = this.presence.pop();
    }
}

public emitRelease(ModuleEmitter emitter, EmissionFrame frame, EirRelease released) {
    emitter.runtime.call(emitter.runtime.release(), [frame.value(released.value)], "");
}

public emitRetainPtr(ModuleEmitter emitter, EmissionFrame frame, EirRetainPtr retain) {
    emitter.runtime.call(emitter.runtime.retain(),
        [loadReference(emitter, frame.value(retain.address))], "");
}

public emitReleasePtr(ModuleEmitter emitter, EmissionFrame frame, EirReleasePtr released) {
    releaseStorage(emitter, frame.value(released.address));
}

// The reference the storage an address names currently holds.
loadReference(ModuleEmitter emitter, Value address) -> Value {
    return memory.buildLoad(emitter.builder, emitter.context.pointerType(), address, "");
}

// Releases the +1 the storage at an address holds and leaves the storage empty, which is what
// keeps the "null or one live reference" invariant a zeroed slot starts with: storage released
// when its scope ends is written again the next time around a loop, and that write releases
// whatever it finds there.
releaseStorage(ModuleEmitter emitter, Value address) {
    emitter.runtime.call(emitter.runtime.release(), [loadReference(emitter, address)], "");
    memory.buildStore(emitter.builder, emitter.context.pointerType().constNull(), address);
}
