// The runtime type-identity helpers: the parent-chain walk behind a class test, the conformance
// scan behind an interface test, the method-table lookup interface dispatch reads, and the three
// that read a value's own 'hash', 'equals', and 'toString' off its runtime type. Each one is a
// function the Runtime toolkit defines once per module with internal linkage, like the rest of
// the runtime.
//
// They read the descriptor layout the descriptors module emits: the name sits in field 0, the
// parent link in field 1, the conformance table in field 4, and the declared 'hash', 'equals',
// and 'toString' in fields 5 through 7 of a descriptor, and a conformance table is a sequence of
// { interface, methods } entries ending in a null interface.
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import TypeRef from @ens.llvm.types;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import emit.strings;

// i1 ens_type_is(ptr object, ptr target): true when the object is there and its type descriptor
// is the target or descends from it.
public typeIs(Runtime runtime, TypeRef descriptorType) -> RuntimeFunction {
    let type = runtime.int1Type.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_type_is", type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition("ens_type_is", type);
    let builder = runtime.builder;
    let object = runtime.parameter(definition, 0);
    let target = runtime.parameter(definition, 1);
    let walkBlock = runtime.block(definition, "typeis.walk");
    let testBlock = runtime.block(definition, "typeis.test");
    let compareBlock = runtime.block(definition, "typeis.compare");
    let stepBlock = runtime.block(definition, "typeis.step");
    let yesBlock = runtime.block(definition, "typeis.yes");
    let noBlock = runtime.block(definition, "typeis.no");
    let cursor = memory.buildAlloca(builder, runtime.pointerType, "cursor");
    instructions.buildCondBr(builder, runtime.isNull(object), noBlock, walkBlock);

    builder.positionAtEnd(walkBlock);
    let descriptor = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(object, -32, ""), "descriptor");
    memory.buildStore(builder, descriptor, cursor);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(testBlock);
    let current = memory.buildLoad(builder, runtime.pointerType, cursor, "current");
    instructions.buildCondBr(builder, runtime.isNull(current), noBlock, compareBlock);

    builder.positionAtEnd(compareBlock);
    let matches = instructions.buildICmpEQ(builder, current, target, "");
    instructions.buildCondBr(builder, matches, yesBlock, stepBlock);

    builder.positionAtEnd(stepBlock);
    let parentSlot = memory.buildStructGEP(builder, descriptorType, current, 1, "");
    let parent = memory.buildLoad(builder, runtime.pointerType, parentSlot, "parent");
    memory.buildStore(builder, parent, cursor);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(yesBlock);
    instructions.buildRet(builder, runtime.int1Type.constInt(1, false));

    builder.positionAtEnd(noBlock);
    instructions.buildRet(builder, runtime.int1Type.constInt(0, false));
    return runtime.endDefinition(definition);
}

// ptr ens_itable_lookup(ptr descriptor, ptr interface): the descriptor's method table for the
// interface, or null when the type does not conform. Conformance tables are flattened per class,
// so no parent walk is needed.
public itableLookup(Runtime runtime, TypeRef descriptorType, TypeRef entryType)
        -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_itable_lookup", type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition("ens_itable_lookup", type);
    let builder = runtime.builder;
    let descriptor = runtime.parameter(definition, 0);
    let target = runtime.parameter(definition, 1);
    let testBlock = runtime.block(definition, "itable.test");
    let compareBlock = runtime.block(definition, "itable.compare");
    let stepBlock = runtime.block(definition, "itable.step");
    let yesBlock = runtime.block(definition, "itable.yes");
    let noBlock = runtime.block(definition, "itable.no");
    let cursor = memory.buildAlloca(builder, runtime.pointerType, "cursor");
    let tableSlot = memory.buildStructGEP(builder, descriptorType, descriptor, 4, "");
    let table = memory.buildLoad(builder, runtime.pointerType, tableSlot, "conformances");
    memory.buildStore(builder, table, cursor);
    instructions.buildCondBr(builder, runtime.isNull(table), noBlock, testBlock);

    builder.positionAtEnd(testBlock);
    let entry = memory.buildLoad(builder, runtime.pointerType, cursor, "entry");
    let declared = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, entry, 0, ""), "interface");
    instructions.buildCondBr(builder, runtime.isNull(declared), noBlock, compareBlock);

    builder.positionAtEnd(compareBlock);
    let matches = instructions.buildICmpEQ(builder, declared, target, "");
    instructions.buildCondBr(builder, matches, yesBlock, stepBlock);

    builder.positionAtEnd(stepBlock);
    let next = memory.buildGEP(builder, entryType, entry, [runtime.int64(1)], "next");
    memory.buildStore(builder, next, cursor);
    instructions.buildBr(builder, testBlock);

    builder.positionAtEnd(yesBlock);
    let heldEntry = memory.buildLoad(builder, runtime.pointerType, cursor, "found");
    let methods = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, entryType, heldEntry, 1, ""), "methods");
    instructions.buildRet(builder, methods);

    builder.positionAtEnd(noBlock);
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

// i1 ens_dynamic_equals(ptr left, ptr right): '==' decided by the two values' runtime types.
// Identity settles it first and a reference that is not there is equal to nothing but itself; then
// the two descriptors have to name the same type, because a class's 'equals' takes its own class,
// and that type's declaration answers. A runtime type that declared none compares by identity,
// which has already failed.
public dynamicEquals(Runtime runtime, TypeRef descriptorType) -> RuntimeFunction {
    let type = runtime.int1Type.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_dynamic_equals", type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition("ens_dynamic_equals", type);
    let builder = runtime.builder;
    let left = runtime.parameter(definition, 0);
    let right = runtime.parameter(definition, 1);
    let presentBlock = runtime.block(definition, "dyneq.present");
    let sameTypeBlock = runtime.block(definition, "dyneq.sametype");
    let lookBlock = runtime.block(definition, "dyneq.look");
    let callBlock = runtime.block(definition, "dyneq.call");
    let yesBlock = runtime.block(definition, "dyneq.yes");
    let noBlock = runtime.block(definition, "dyneq.no");
    let identical = instructions.buildICmpEQ(builder, left, right, "");
    instructions.buildCondBr(builder, identical, yesBlock, presentBlock);

    builder.positionAtEnd(presentBlock);
    let absent = instructions.buildOr(builder, runtime.isNull(left), runtime.isNull(right), "");
    instructions.buildCondBr(builder, absent, noBlock, sameTypeBlock);

    builder.positionAtEnd(sameTypeBlock);
    let leftType = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(left, -32, ""), "left.type");
    let rightType = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(right, -32, ""), "right.type");
    let sameType = instructions.buildICmpEQ(builder, leftType, rightType, "");
    instructions.buildCondBr(builder, sameType, lookBlock, noBlock);

    builder.positionAtEnd(lookBlock);
    let declared = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, descriptorType, leftType, 6, ""), "declared");
    instructions.buildCondBr(builder, runtime.isNull(declared), noBlock, callBlock);

    builder.positionAtEnd(callBlock);
    instructions.buildRet(builder,
        instructions.buildCall(builder, type, declared, [left, right], "equal"));

    builder.positionAtEnd(yesBlock);
    instructions.buildRet(builder, runtime.int1Type.constInt(1, false));

    builder.positionAtEnd(noBlock);
    instructions.buildRet(builder, runtime.int1Type.constInt(0, false));
    return runtime.endDefinition(definition);
}

// i64 ens_dynamic_hash(ptr object): the hash the value's runtime type declared for itself, or the
// identity hash when it declared none. A reference that is not there hashes as its own null
// pointer, which is what the identity hash of an absent reference already was.
public dynamicHash(Runtime runtime, TypeRef descriptorType) -> RuntimeFunction {
    let type = runtime.int64Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_dynamic_hash", type);
    if (known != null) {
        return known;
    }
    let definition = runtime.beginDefinition("ens_dynamic_hash", type);
    let builder = runtime.builder;
    let object = runtime.parameter(definition, 0);
    let lookBlock = runtime.block(definition, "dynhash.look");
    let callBlock = runtime.block(definition, "dynhash.call");
    let identityBlock = runtime.block(definition, "dynhash.identity");
    instructions.buildCondBr(builder, runtime.isNull(object), identityBlock, lookBlock);

    builder.positionAtEnd(lookBlock);
    let descriptor = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(object, -32, ""), "descriptor");
    let declared = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, descriptorType, descriptor, 5, ""), "declared");
    instructions.buildCondBr(builder, runtime.isNull(declared), identityBlock, callBlock);

    builder.positionAtEnd(callBlock);
    instructions.buildRet(builder,
        instructions.buildCall(builder, type, declared, [object], "hashed"));

    builder.positionAtEnd(identityBlock);
    instructions.buildRet(builder,
        instructions.buildPtrToInt(builder, object, runtime.int64Type, "identity"));
    return runtime.endDefinition(definition);
}

// ptr ens_dynamic_tostring(ptr object): the text the value's runtime type declared for itself, or
// an owned copy of that type's name when it declared none. A reference that is not there answers
// "null" instead of reading a header nothing holds, like the other two runtime-type helpers.
public dynamicToString(Runtime runtime, TypeRef descriptorType) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_dynamic_tostring", type);
    if (known != null) {
        return known;
    }
    let lift = strings.liftCString(runtime);
    let definition = runtime.beginDefinition("ens_dynamic_tostring", type);
    let builder = runtime.builder;
    let object = runtime.parameter(definition, 0);
    let lookBlock = runtime.block(definition, "dyntostr.look");
    let callBlock = runtime.block(definition, "dyntostr.call");
    let nameBlock = runtime.block(definition, "dyntostr.name");
    let absentBlock = runtime.block(definition, "dyntostr.absent");
    instructions.buildCondBr(builder, runtime.isNull(object), absentBlock, lookBlock);

    builder.positionAtEnd(lookBlock);
    let descriptor = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(object, -32, ""), "descriptor");
    let declared = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, descriptorType, descriptor, 7, ""), "declared");
    instructions.buildCondBr(builder, runtime.isNull(declared), nameBlock, callBlock);

    builder.positionAtEnd(callBlock);
    instructions.buildRet(builder,
        instructions.buildCall(builder, type, declared, [object], "text"));

    builder.positionAtEnd(nameBlock);
    let name = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, descriptorType, descriptor, 0, ""), "name");
    instructions.buildRet(builder, runtime.call(lift, [name], "lifted"));

    builder.positionAtEnd(absentBlock);
    instructions.buildRet(builder, runtime.stringLiteral("null".toBytes()));
    return runtime.endDefinition(definition);
}

// ptr ens_type_name(ptr object): the object's runtime type's name. A 'toString' the type declared
// is not consulted, so a type that prints itself as something else is still named here.
public typeName(Runtime runtime, TypeRef descriptorType) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_type_name", type);
    if (known != null) {
        return known;
    }
    let lift = strings.liftCString(runtime);
    let definition = runtime.beginDefinition("ens_type_name", type);
    let builder = runtime.builder;
    let object = runtime.parameter(definition, 0);
    let lookBlock = runtime.block(definition, "typename.look");
    let absentBlock = runtime.block(definition, "typename.absent");
    instructions.buildCondBr(builder, runtime.isNull(object), absentBlock, lookBlock);

    builder.positionAtEnd(lookBlock);
    let descriptor = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(object, -32, ""), "descriptor");
    let name = memory.buildLoad(builder, runtime.pointerType,
        memory.buildStructGEP(builder, descriptorType, descriptor, 0, ""), "name");
    instructions.buildRet(builder, runtime.call(lift, [name], "lifted"));

    builder.positionAtEnd(absentBlock);
    instructions.buildRet(builder, runtime.stringLiteral("null".toBytes()));
    return runtime.endDefinition(definition);
}

// i1 ens_conforms(ptr object, ptr interface): true when the object is there and its type
// implements the interface.
public conforms(Runtime runtime, TypeRef descriptorType, TypeRef entryType) -> RuntimeFunction {
    let type = runtime.int1Type.functionType([runtime.pointerType, runtime.pointerType]);
    let known = runtime.existing("ens_conforms", type);
    if (known != null) {
        return known;
    }
    let lookup = itableLookup(runtime, descriptorType, entryType);
    let definition = runtime.beginDefinition("ens_conforms", type);
    let builder = runtime.builder;
    let object = runtime.parameter(definition, 0);
    let target = runtime.parameter(definition, 1);
    let lookBlock = runtime.block(definition, "conforms.look");
    let noBlock = runtime.block(definition, "conforms.no");
    instructions.buildCondBr(builder, runtime.isNull(object), noBlock, lookBlock);

    builder.positionAtEnd(lookBlock);
    let descriptor = memory.buildLoad(builder, runtime.pointerType,
        runtime.offsetPointer(object, -32, ""), "descriptor");
    let methods = runtime.call(lookup, [descriptor, target], "methods");
    let found = instructions.buildICmpNE(builder, methods, runtime.nullPointer(), "");
    instructions.buildRet(builder, found);

    builder.positionAtEnd(noBlock);
    instructions.buildRet(builder, runtime.int1Type.constInt(0, false));
    return runtime.endDefinition(definition);
}
