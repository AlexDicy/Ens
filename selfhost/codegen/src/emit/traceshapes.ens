// The struct shapes of the trace side tables: the contract between the tables every module
// writes (emit.traces) and the runtime that reads them back (emit.traceruntime). Both sides
// build the shapes from here, so they cannot drift apart.
import TypeRef from @ens.llvm.types;
import Runtime from emit.runtime;

// One symbol entry: function start, name, file, declaration line, and the entry flag where a
// captured trace stops walking.
public symbolEntryType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.pointerType,
        runtime.pointerType, runtime.int32Type, runtime.int32Type], false);
}

// One line marker: the marker block's address, the call's source line, and the index in its
// module's inline-frame table of the frame the call was written in, or -1 when it was written in
// the function the marker is in.
public markerEntryType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.int32Type,
        runtime.int32Type], false);
}

// One inline frame: the inlined function's name and file, the line of the call it was inlined at,
// and the index of the frame that call was written in, or -1 when it is in the function the marker
// is in.
public inlineFrameType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.pointerType,
        runtime.int32Type, runtime.int32Type], false);
}

// The chunk one module registers: the next link, its symbol entries, its line markers, the start of
// every function it defines that is not a frame of the program, such as a runtime routine, and its
// inline frames.
public chunkType(Runtime runtime) -> TypeRef {
    return runtime.context.structType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType, runtime.int64Type, runtime.pointerType,
        runtime.int64Type, runtime.pointerType, runtime.int64Type], false);
}
