// The POSIX halves of the file bridges std.fs reads, changes and enumerates a path through. Every
// failure answers the errno read before anything else runs, since a later call is free to leave a
// reason of its own behind.
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import BasicBlock from @ens.llvm.blocks;
import @ens.llvm.globals;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import Errno from emit.errorkinds;
import DarwinStat from emit.nativeshapes;
import DirentKind from emit.nativeshapes;
import FileKind from emit.nativeshapes;
import FileMode from emit.nativeshapes;
import FilePermissions from emit.nativeshapes;
import OpenMode from emit.nativeshapes;
import Rename from emit.nativeshapes;
import Statx from emit.nativeshapes;
import emit.nativeshapes;
import emit.directories;
import emit.filesystem;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;
import RuntimeFunction from emit.runtime;

// A Linux target asks the kernel directly, so one structure layout serves every architecture and no
// libc has to carry a matching one.
public linuxMetadata(Runtime runtime, TypeRef type) -> RuntimeFunction {
    long number = nativeshapes.statxSystemCall(runtime.targetTriple);
    if (number == 0) {
        return unsupportedMetadata(runtime, type);
    }
    let definition = runtime.beginDefinition("ens_fs_metadata", type);
    let builder = runtime.builder;
    let checkBlock = runtime.block(definition, "meta.check");
    let answerBlock = runtime.block(definition, "meta.answer");
    let incompleteBlock = runtime.block(definition, "meta.incomplete");
    let failedBlock = runtime.block(definition, "meta.failed");

    long requested = Statx.typeRequest | Statx.modifiedRequest | Statx.sizeRequest;
    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(Statx.structBytes as ulong), "statx");
    let flags = instructions.buildSelect(builder,
        instructions.buildICmpNE(builder, runtime.parameter(definition, 1), runtime.int32(0), ""),
        runtime.int64(0), runtime.int64(Statx.noFollowFlag), "flags");
    let status = statxCall(runtime, number, runtime.int64(Statx.currentDirectory),
        runtime.parameter(definition, 0), flags, requested, answer);
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int64(0), ""), checkBlock, failedBlock);

    builder.positionAtEnd(checkBlock);
    instructions.buildCondBr(builder, statxClaimed(runtime, answer, requested),
        answerBlock, incompleteBlock);

    builder.positionAtEnd(answerBlock);
    let mode = instructions.buildZExt(builder, memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(answer, Statx.modeOffset, ""), ""), runtime.int64Type, "mode");
    let nanoseconds = instructions.buildZExt(builder, memory.buildLoad(builder, runtime.int32Type,
        runtime.offsetPointer(answer, Statx.nanosecondsOffset, ""), ""), runtime.int64Type, "");
    answerMetadata(runtime, definition, mode,
        loadWord(runtime, answer, Statx.sizeOffset),
        millisecondsOf(runtime, loadWord(runtime, answer, Statx.secondsOffset), nanoseconds));

    builder.positionAtEnd(incompleteBlock);
    instructions.buildRet(builder, runtime.int32(Statx.incompleteError));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
    return runtime.endDefinition(definition);
}

public darwinMetadata(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let statType = runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]);
    let followed = runtime.libc(nativeshapes.entryPointName(runtime.targetTriple, "stat"),
        statType);
    let unfollowed = runtime.libc(nativeshapes.entryPointName(runtime.targetTriple, "lstat"),
        statType);
    let definition = runtime.beginDefinition("ens_fs_metadata", type);
    let builder = runtime.builder;
    let answerBlock = runtime.block(definition, "meta.answer");
    let failedBlock = runtime.block(definition, "meta.failed");

    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(DarwinStat.structBytes as ulong), "stat");
    let chosen = instructions.buildSelect(builder,
        instructions.buildICmpNE(builder, runtime.parameter(definition, 1), runtime.int32(0), ""),
        followed.function, unfollowed.function, "ask");
    let status = instructions.buildCall(builder, statType, chosen,
        [runtime.parameter(definition, 0), answer], "status");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), answerBlock, failedBlock);

    builder.positionAtEnd(answerBlock);
    let mode = instructions.buildZExt(builder, memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(answer, DarwinStat.modeOffset, ""), ""), runtime.int64Type, "mode");
    answerMetadata(runtime, definition, mode,
        loadWord(runtime, answer, DarwinStat.sizeOffset),
        millisecondsOf(runtime, loadWord(runtime, answer, DarwinStat.secondsOffset),
            loadWord(runtime, answer, DarwinStat.nanosecondsOffset)));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
    return runtime.endDefinition(definition);
}

// An architecture with no statx number has no metadata call this bridge can reach, which a caller
// sees exactly as it sees a kernel too old to carry one.
unsupportedMetadata(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let definition = runtime.beginDefinition("ens_fs_metadata", type);
    instructions.buildRet(runtime.builder, runtime.int32(Statx.unsupportedError));
    return runtime.endDefinition(definition);
}

public posixRealPath(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let resolve = runtime.libc("realpath",
        runtime.pointerType.functionType([runtime.pointerType, runtime.pointerType]));
    let measure = runtime.strlen();
    let copy = runtime.memcpy();
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_fs_real_path", type);
    let builder = runtime.builder;
    let measuredBlock = runtime.block(definition, "real.measured");
    let copyBlock = runtime.block(definition, "real.copy");
    let doneBlock = runtime.block(definition, "real.done");
    let failedBlock = runtime.block(definition, "real.failed");

    // Resolving into a buffer of the caller's cannot be done safely, because a resolved path may
    // outgrow every fixed bound a system publishes.
    let resolved = runtime.call(resolve, [runtime.parameter(definition, 0),
        runtime.nullPointer()], "resolved");
    let why = runtime.lastError();
    instructions.buildCondBr(builder, runtime.isNull(resolved), failedBlock, measuredBlock);

    builder.positionAtEnd(measuredBlock);
    let bytes = runtime.call(measure, [resolved], "bytes");
    memory.buildStore(builder, bytes, runtime.parameter(definition, 3));
    instructions.buildCondBr(builder,
        instructions.buildICmpSLE(builder, bytes, runtime.parameter(definition, 2), "fits"),
        copyBlock, doneBlock);

    builder.positionAtEnd(copyBlock);
    runtime.call(copy, [runtime.parameter(definition, 1), resolved, bytes], "");
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(doneBlock);
    runtime.call(release, [resolved], "");
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
    return runtime.endDefinition(definition);
}

public posixCurrentDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let workingDirectory = runtime.libc("getcwd",
        runtime.pointerType.functionType([runtime.pointerType, runtime.int64Type]));
    let measure = runtime.strlen();
    let definition = runtime.beginDefinition("ens_current_directory", type);
    let builder = runtime.builder;
    let measuredBlock = runtime.block(definition, "cwd.measured");
    let unknownBlock = runtime.block(definition, "cwd.unknown");
    let buffer = runtime.parameter(definition, 0);
    let answer = runtime.call(workingDirectory, [buffer, runtime.parameter(definition, 1)],
        "answer");
    instructions.buildCondBr(builder, runtime.isNull(answer), unknownBlock, measuredBlock);

    builder.positionAtEnd(measuredBlock);
    instructions.buildRet(builder, runtime.call(measure, [buffer], "bytes"));

    builder.positionAtEnd(unknownBlock);
    instructions.buildRet(builder, runtime.int64(-1));
    return runtime.endDefinition(definition);
}

loadWord(Runtime runtime, Value base, long offset) -> Value {
    let builder = runtime.builder;
    return memory.buildLoad(builder, runtime.int64Type,
        runtime.offsetPointer(base, offset, ""), "");
}

// A negative second still floors correctly, because a nanosecond count is never negative.
millisecondsOf(Runtime runtime, Value seconds, Value nanoseconds) -> Value {
    let builder = runtime.builder;
    return instructions.buildAdd(builder,
        instructions.buildMul(builder, seconds, runtime.int64(1000), ""),
        instructions.buildUDiv(builder, nanoseconds, runtime.int64(1000000), ""), "millis");
}

// The kind a mode word names, which every POSIX system spells with the same bits.
fileKindOf(Runtime runtime, Value mode) -> Value {
    let builder = runtime.builder;
    let named = instructions.buildAnd(builder, mode, runtime.int64(FileMode.typeMask), "");
    return instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, named, runtime.int64(FileMode.directory), ""),
        runtime.int64(FileKind.directory),
        instructions.buildSelect(builder,
            instructions.buildICmpEQ(builder, named, runtime.int64(FileMode.symbolicLink), ""),
            runtime.int64(FileKind.symbolicLink),
            instructions.buildSelect(builder,
                instructions.buildICmpEQ(builder, named, runtime.int64(FileMode.regular), ""),
                runtime.int64(FileKind.file), runtime.int64(FileKind.other), ""), ""), "kind");
}

// The three answers a metadata bridge writes back, and the 0 saying it answered. A directory's own
// length is what the file system happens to hold for it, so nothing reports it.
answerMetadata(Runtime runtime, RuntimeDefinition definition, Value mode, Value size,
               Value millis) {
    let builder = runtime.builder;
    let kind = fileKindOf(runtime, mode);
    memory.buildStore(builder, kind, runtime.parameter(definition, 2));
    memory.buildStore(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, kind, runtime.int64(FileKind.directory), ""),
        runtime.int64(0), size, "length"), runtime.parameter(definition, 3));
    memory.buildStore(builder, millis, runtime.parameter(definition, 4));
    instructions.buildRet(builder, runtime.int32(0));
}

public posixOpen(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let openDescriptor = runtime.libc("open",
        runtime.int32Type.variadicFunctionType([runtime.pointerType, runtime.int32Type]));
    let openStream = runtime.libc("fdopen",
        runtime.pointerType.functionType([runtime.int32Type, runtime.pointerType]));
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_fs_open", type);
    let builder = runtime.builder;
    let readingBlock = runtime.block(definition, "open.reading");
    let checkBlock = runtime.block(definition, "open.check");
    let refusedBlock = runtime.block(definition, "open.refused");
    let streamBlock = runtime.block(definition, "open.stream");
    let closeBlock = runtime.block(definition, "open.close");
    let doneBlock = runtime.block(definition, "open.done");
    let failedBlock = runtime.block(definition, "open.failed");
    let mode = runtime.parameter(definition, 1);
    let errorSlot = runtime.parameter(definition, 2);
    let descriptor = runtime.call(openDescriptor, [runtime.parameter(definition, 0),
        descriptorFlags(runtime, mode), runtime.int32(FilePermissions.createdFile)],
        "descriptor");
    let openError = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, descriptor, runtime.int32(0), ""),
        failedBlock, readingBlock);

    // Every mode that writes is refused a directory by the open itself, and reading is not, so only
    // reading asks. The descriptor is asked rather than the path, since a second lookup is both a
    // syscall and a window in which the path can become something else.
    builder.positionAtEnd(readingBlock);
    instructions.buildCondBr(builder, filesystem.isMode(runtime, mode, OpenMode.read), checkBlock,
        streamBlock);

    builder.positionAtEnd(checkBlock);
    instructions.buildCondBr(builder, descriptorIsDirectory(runtime, descriptor), refusedBlock,
        streamBlock);

    builder.positionAtEnd(refusedBlock);
    runtime.call(closeDescriptor, [descriptor], "");
    memory.buildStore(builder, runtime.int32(Errno.isADirectory), errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());

    builder.positionAtEnd(streamBlock);
    let stream = runtime.call(openStream, [descriptor, filesystem.streamMode(runtime, mode)],
        "stream");
    let streamError = runtime.lastError();
    instructions.buildCondBr(builder, runtime.isNull(stream), closeBlock, doneBlock);

    builder.positionAtEnd(closeBlock);
    runtime.call(closeDescriptor, [descriptor], "");
    memory.buildStore(builder, streamError, errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());

    builder.positionAtEnd(doneBlock);
    memory.buildStore(builder, runtime.int32(0), errorSlot);
    instructions.buildRet(builder, stream);

    builder.positionAtEnd(failedBlock);
    memory.buildStore(builder, openError, errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

public posixCreateDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let makeDirectory = runtime.libc("mkdir",
        runtime.int32Type.functionType([runtime.pointerType, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_fs_create_directory", type);
    let status = runtime.call(makeDirectory, [runtime.parameter(definition, 0),
        runtime.int32(FilePermissions.createdDirectory)], "status");
    answerStatus(runtime, status, runtime.lastError());
    return runtime.endDefinition(definition);
}

public posixRemoveFile(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let removeFile = runtime.libc("unlink",
        runtime.int32Type.functionType([runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_fs_remove_file", type);
    let status = runtime.call(removeFile, [runtime.parameter(definition, 0)], "status");
    answerStatus(runtime, status, runtime.lastError());
    return runtime.endDefinition(definition);
}

public posixRemoveDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let removeDirectory = runtime.libc("rmdir",
        runtime.int32Type.functionType([runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_fs_remove_directory", type);
    let status = runtime.call(removeDirectory, [runtime.parameter(definition, 0)], "status");
    answerStatus(runtime, status, runtime.lastError());
    return runtime.endDefinition(definition);
}

// Renaming without replacing is a call of its own, and a file system that will not carry it out
// sends this bridge to reading the destination and renaming after, which two programs racing for
// the same name can both come through.
public posixRename(Runtime runtime, TypeRef type, RuntimeFunction metadata) -> RuntimeFunction {
    let rename = runtime.libc("rename",
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_fs_rename", type);
    let builder = runtime.builder;
    let replaceBlock = runtime.block(definition, "rename.replace");
    let exclusiveBlock = runtime.block(definition, "rename.exclusive");
    let fallbackBlock = runtime.block(definition, "rename.fallback");
    let takenBlock = runtime.block(definition, "rename.taken");
    let retryBlock = runtime.block(definition, "rename.retry");
    let from = runtime.parameter(definition, 0);
    let to = runtime.parameter(definition, 1);
    let kind = memory.buildAlloca(builder, runtime.int64Type, "kind");
    let length = memory.buildAlloca(builder, runtime.int64Type, "length");
    let millis = memory.buildAlloca(builder, runtime.int64Type, "millis");
    instructions.buildCondBr(builder,
        instructions.buildICmpNE(builder, runtime.parameter(definition, 2), runtime.int32(0), ""),
        replaceBlock, exclusiveBlock);

    builder.positionAtEnd(replaceBlock);
    let replaced = runtime.call(rename, [from, to], "replaced");
    answerStatus(runtime, replaced, runtime.lastError());

    builder.positionAtEnd(exclusiveBlock);
    emitExclusiveRename(runtime, definition, from, to, fallbackBlock);

    builder.positionAtEnd(fallbackBlock);
    let present = runtime.call(metadata, [to, runtime.int32(0), kind, length, millis], "present");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, present, runtime.int32(0), ""), takenBlock, retryBlock);

    builder.positionAtEnd(takenBlock);
    instructions.buildRet(builder, runtime.int32(Rename.destinationExists));

    builder.positionAtEnd(retryBlock);
    let renamed = runtime.call(rename, [from, to], "renamed");
    answerStatus(runtime, renamed, runtime.lastError());
    return runtime.endDefinition(definition);
}

public linuxCopyPermissions(Runtime runtime, TypeRef type) -> RuntimeFunction {
    long number = nativeshapes.statxSystemCall(runtime.targetTriple);
    if (number == 0) {
        return unsupportedPermissions(runtime, type);
    }
    let definition = runtime.beginDefinition("ens_fs_copy_permissions", type);
    let builder = runtime.builder;
    let claimedBlock = runtime.block(definition, "mode.claimed");
    let copyBlock = runtime.block(definition, "mode.copy");
    let incompleteBlock = runtime.block(definition, "mode.incomplete");
    let failedBlock = runtime.block(definition, "mode.failed");
    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(Statx.structBytes as ulong), "statx");
    let status = statxCall(runtime, number, runtime.int64(Statx.currentDirectory),
        runtime.parameter(definition, 0), runtime.int64(0), Statx.permissionsRequest, answer);
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int64(0), ""), claimedBlock,
        failedBlock);

    builder.positionAtEnd(claimedBlock);
    instructions.buildCondBr(builder,
        statxClaimed(runtime, answer, Statx.permissionsRequest), copyBlock, incompleteBlock);

    builder.positionAtEnd(copyBlock);
    emitModeCopy(runtime, definition, memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(answer, Statx.modeOffset, ""), "mode"));

    builder.positionAtEnd(incompleteBlock);
    instructions.buildRet(builder, runtime.int32(Statx.incompleteError));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
    return runtime.endDefinition(definition);
}

public darwinCopyPermissions(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let describe = runtime.libc(nativeshapes.entryPointName(runtime.targetTriple, "stat"),
        runtime.int32Type.functionType([runtime.pointerType, runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_fs_copy_permissions", type);
    let builder = runtime.builder;
    let copyBlock = runtime.block(definition, "mode.copy");
    let failedBlock = runtime.block(definition, "mode.failed");
    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(DarwinStat.structBytes as ulong), "stat");
    let status = runtime.call(describe, [runtime.parameter(definition, 0), answer], "status");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), copyBlock, failedBlock);

    builder.positionAtEnd(copyBlock);
    emitModeCopy(runtime, definition, memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(answer, DarwinStat.modeOffset, ""), "mode"));

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
    return runtime.endDefinition(definition);
}

public posixOpenDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let openFolder = directories.openFolderFunction(runtime);
    let definition = runtime.beginDefinition("ens_fs_open_directory", type);
    let builder = runtime.builder;
    let openedBlock = runtime.block(definition, "dir.opened");
    let failedBlock = runtime.block(definition, "dir.failed");
    let stream = runtime.call(openFolder, [runtime.parameter(definition, 0)], "stream");
    let why = runtime.lastError();
    instructions.buildCondBr(builder, runtime.isNull(stream), failedBlock, openedBlock);

    builder.positionAtEnd(openedBlock);
    memory.buildStore(builder, runtime.int32(0), runtime.parameter(definition, 1));
    instructions.buildRet(builder, stream);

    builder.positionAtEnd(failedBlock);
    memory.buildStore(builder, why, runtime.parameter(definition, 1));
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

public posixNextEntry(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let readFolder = runtime.libc(nativeshapes.entryPointName(runtime.targetTriple, "readdir"),
        runtime.pointerType.functionType([runtime.pointerType]));
    let definition = runtime.beginDefinition("ens_fs_next_entry", type);
    let builder = runtime.builder;
    let testBlock = runtime.block(definition, "entry.test");
    let bodyBlock = runtime.block(definition, "entry.body");
    let keptBlock = runtime.block(definition, "entry.kept");
    let endBlock = runtime.block(definition, "entry.end");
    let kindSlot = runtime.parameter(definition, 1);
    let errorSlot = runtime.parameter(definition, 2);
    memory.buildStore(builder, runtime.int64(FileKind.unknown), kindSlot);
    memory.buildStore(builder, runtime.int32(0), errorSlot);
    let errnoSlot = runtime.call(runtime.errnoLocation(), [], "errno.slot");
    instructions.buildBr(builder, testBlock);

    // Reading answers null both at the end of the folder and on a failure, and leaves errno alone
    // at the end, so the cell is cleared before each read to tell the two apart.
    builder.positionAtEnd(testBlock);
    memory.buildStore(builder, runtime.int32(0), errnoSlot);
    let entry = runtime.call(readFolder, [runtime.parameter(definition, 0)], "entry");
    let why = memory.buildLoad(builder, runtime.int32Type, errnoSlot, "why");
    instructions.buildCondBr(builder, runtime.isNull(entry), endBlock, bodyBlock);

    builder.positionAtEnd(endBlock);
    memory.buildStore(builder, why, errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());

    builder.positionAtEnd(bodyBlock);
    let name = memory.buildGEP(builder, runtime.int8Type, entry,
        [runtime.int64(nativeshapes.direntNameOffset(runtime.targetTriple))], "entry.name");
    instructions.buildCondBr(builder, directories.dotEntry(runtime, name, runtime.int8Type),
        testBlock, keptBlock);

    builder.positionAtEnd(keptBlock);
    let reported = memory.buildLoad(builder, runtime.int8Type, memory.buildGEP(builder,
        runtime.int8Type, entry,
        [runtime.int64(nativeshapes.direntKindOffset(runtime.targetTriple))], ""), "entry.type");
    memory.buildStore(builder, direntFileKind(runtime, reported), kindSlot);
    instructions.buildRet(builder, name);
    return runtime.endDefinition(definition);
}

public posixCloseDirectory(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let closeFolder = directories.closeFolderFunction(runtime);
    let definition = runtime.beginDefinition("ens_fs_close_directory", type);
    runtime.call(closeFolder, [runtime.parameter(definition, 0)], "");
    instructions.buildRetVoid(runtime.builder);
    return runtime.endDefinition(definition);
}

// An architecture with no statx number has no permission bits this bridge can read, which a caller
// sees exactly as it sees a kernel too old to carry one.
unsupportedPermissions(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let definition = runtime.beginDefinition("ens_fs_copy_permissions", type);
    instructions.buildRet(runtime.builder, runtime.int32(Statx.unsupportedError));
    return runtime.endDefinition(definition);
}

// The no-replace rename this target reaches, branching to the fallback where the file system
// refuses the request or the architecture has no such call at all.
emitExclusiveRename(Runtime runtime, RuntimeDefinition definition, Value from, Value to,
                    BasicBlock fallbackBlock) {
    let builder = runtime.builder;
    long number = nativeshapes.renameSystemCall(runtime.targetTriple);
    if (!runtime.onDarwin() && number == 0) {
        instructions.buildBr(builder, fallbackBlock);
        return;
    }
    let movedBlock = runtime.block(definition, "rename.moved");
    let refusedBlock = runtime.block(definition, "rename.refused");
    let failedBlock = runtime.block(definition, "rename.failed");
    Value status = runtime.int32(0);
    if (runtime.onDarwin()) {
        let renameExclusive = runtime.libc("renamex_np", runtime.int32Type.functionType(
            [runtime.pointerType, runtime.pointerType, runtime.int32Type]));
        status = runtime.call(renameExclusive, [from, to,
            runtime.int32(Rename.darwinExclusive)], "status");
    } else {
        let systemCall = runtime.libc("syscall",
            runtime.int64Type.variadicFunctionType([runtime.int64Type]));
        status = instructions.buildTrunc(builder, runtime.call(systemCall,
            [runtime.int64(number), runtime.int64(Statx.currentDirectory), from,
            runtime.int64(Statx.currentDirectory), to, runtime.int64(Rename.linuxNoReplace)],
            "status"), runtime.int32Type, "");
    }
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), movedBlock, refusedBlock);

    builder.positionAtEnd(movedBlock);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder, refusedRequest(runtime, why), fallbackBlock, failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);
}

// True when the number names a file system that will not carry out a no-replace rename, rather
// than anything about the two paths.
refusedRequest(Runtime runtime, Value why) -> Value {
    let builder = runtime.builder;
    Value refused = runtime.int1Type.constInt(0, false);
    for (let code in nativeshapes.unsupportedRenameErrors(runtime.targetTriple)) {
        refused = instructions.buildOr(builder, refused,
            instructions.buildICmpEQ(builder, why, runtime.int32(code), ""), "");
    }
    return refused;
}

// Gives the destination the permission bits the source carries, which is all a copy hands over.
emitModeCopy(Runtime runtime, RuntimeDefinition definition, Value mode) {
    let builder = runtime.builder;
    let changeMode = runtime.libc("chmod",
        runtime.int32Type.functionType([runtime.pointerType, runtime.int32Type]));
    let permissions = instructions.buildAnd(builder,
        instructions.buildZExt(builder, mode, runtime.int32Type, ""),
        runtime.int32(FilePermissions.mask), "permissions");
    let status = runtime.call(changeMode, [runtime.parameter(definition, 1), permissions],
        "status");
    answerStatus(runtime, status, runtime.lastError());
}

// One statx call, answering the status the kernel reported. `base` is what a relative path is read
// against, and is the subject itself where the flags carry AT_EMPTY_PATH.
statxCall(Runtime runtime, long number, Value base, Value path, Value flags, long requested,
          Value answer) -> Value {
    let systemCall = runtime.libc("syscall",
        runtime.int64Type.variadicFunctionType([runtime.int64Type]));
    return runtime.call(systemCall, [runtime.int64(number), base, path, flags,
        runtime.int64(requested), answer], "status");
}

// True when the descriptor is known to hold a directory. A system that would not say answers
// false, which leaves the open to succeed as it did before.
descriptorIsDirectory(Runtime runtime, Value descriptor) -> Value {
    if (runtime.onDarwin()) {
        return darwinDescriptorIsDirectory(runtime, descriptor);
    }
    return linuxDescriptorIsDirectory(runtime, descriptor);
}

linuxDescriptorIsDirectory(Runtime runtime, Value descriptor) -> Value {
    let builder = runtime.builder;
    long number = nativeshapes.statxSystemCall(runtime.targetTriple);
    if (number == 0) {
        return runtime.int1Type.constInt(0, false);
    }
    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(Statx.structBytes as ulong), "statx");

    // The mask and the mode are zeroed first, so a call that answered nothing cannot read as a
    // directory. A null path is not accepted with this flag, and an empty string is what asks
    // about the descriptor itself.
    memory.buildStore(builder, runtime.int32(0),
        runtime.offsetPointer(answer, Statx.maskOffset, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(0, false),
        runtime.offsetPointer(answer, Statx.modeOffset, ""));
    let status = statxCall(runtime, number,
        instructions.buildSExt(builder, descriptor, runtime.int64Type, ""),
        globals.buildGlobalString(builder, "", ".statx.descriptor"),
        runtime.int64(Statx.emptyPathFlag), Statx.typeRequest, answer);
    return instructions.buildAnd(builder,
        instructions.buildICmpEQ(builder, status, runtime.int64(0), ""),
        instructions.buildAnd(builder, statxClaimed(runtime, answer, Statx.typeRequest),
            modeIsDirectory(runtime, answer, Statx.modeOffset), ""), "descriptor.directory");
}

darwinDescriptorIsDirectory(Runtime runtime, Value descriptor) -> Value {
    let builder = runtime.builder;
    let describe = runtime.libc(nativeshapes.entryPointName(runtime.targetTriple, "fstat"),
        runtime.int32Type.functionType([runtime.int32Type, runtime.pointerType]));
    let answer = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(DarwinStat.structBytes as ulong), "stat");

    // The mode is zeroed first, so a call that answered nothing cannot read as a directory.
    memory.buildStore(builder, runtime.int16Type.constInt(0, false),
        runtime.offsetPointer(answer, DarwinStat.modeOffset, ""));
    let status = runtime.call(describe, [descriptor, answer], "status");
    return instructions.buildAnd(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""),
        modeIsDirectory(runtime, answer, DarwinStat.modeOffset), "descriptor.directory");
}

modeIsDirectory(Runtime runtime, Value answer, long modeOffset) -> Value {
    let builder = runtime.builder;
    let mode = instructions.buildZExt(builder, memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(answer, modeOffset, ""), "mode"), runtime.int64Type, "");
    return instructions.buildICmpEQ(builder,
        instructions.buildAnd(builder, mode, runtime.int64(FileMode.typeMask), ""),
        runtime.int64(FileMode.directory), "");
}

// True when the answer's mask claims every field that was asked for.
statxClaimed(Runtime runtime, Value answer, long requested) -> Value {
    let builder = runtime.builder;
    return instructions.buildICmpEQ(builder, instructions.buildAnd(builder,
        memory.buildLoad(builder, runtime.int32Type,
            runtime.offsetPointer(answer, Statx.maskOffset, ""), "mask"),
        runtime.int32(requested), "claimed"), runtime.int32(requested), "claimed.all");
}

// The flags an open of this mode asks for, where every mode but reading creates what is missing.
descriptorFlags(Runtime runtime, Value mode) -> Value {
    let builder = runtime.builder;
    let flags = nativeshapes.openFlags(runtime.targetTriple);
    long truncated = flags.writeOnly | flags.create | flags.truncate;
    long appended = flags.writeOnly | flags.create | flags.append;
    long created = flags.writeOnly | flags.create | flags.exclusive;
    return instructions.buildSelect(builder, filesystem.isMode(runtime, mode, OpenMode.read),
        runtime.int32(flags.readOnly),
        instructions.buildSelect(builder, filesystem.isMode(runtime, mode, OpenMode.writeTruncated),
            runtime.int32(truncated),
            instructions.buildSelect(builder, filesystem.isMode(runtime, mode, OpenMode.appended),
                runtime.int32(appended), runtime.int32(created), ""), ""), "flags");
}

// The kind a directory entry reported, where a file system that classified nothing leaves the
// caller to ask about the entry itself.
direntFileKind(Runtime runtime, Value reported) -> Value {
    let builder = runtime.builder;
    let value = instructions.buildZExt(builder, reported, runtime.int64Type, "");
    return instructions.buildSelect(builder,
        isKind(runtime, value, DirentKind.regular), runtime.int64(FileKind.file),
        instructions.buildSelect(builder, isKind(runtime, value, DirentKind.directory),
            runtime.int64(FileKind.directory),
            instructions.buildSelect(builder, isKind(runtime, value, DirentKind.symbolicLink),
                runtime.int64(FileKind.symbolicLink),
                instructions.buildSelect(builder, isKind(runtime, value, DirentKind.unknown),
                    runtime.int64(FileKind.unknown), runtime.int64(FileKind.other), ""),
                ""), ""), "kind");
}

isKind(Runtime runtime, Value reported, long wanted) -> Value {
    return instructions.buildICmpEQ(runtime.builder, reported, runtime.int64(wanted), "");
}

// Answers 0 for a call that reported success, and the number it left behind otherwise.
answerStatus(Runtime runtime, Value status, Value why) {
    let builder = runtime.builder;
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), runtime.int32(0), why,
        ""));
}
