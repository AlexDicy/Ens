// The std.system bridges behind a child this process reads as it runs: starting one, reading the next
// bytes of its output, waiting for the code it ended with, and handing back what it held.
//
// The child's standard output and standard error are one pipe, so what it writes arrives merged in
// the order it wrote it and no read can be held up by the other stream filling first. The parent
// closes its own copy of the writing end as soon as the child holds it, which is what lets a read
// see the end of the output once the child is gone.
//
// A started child is a 16-byte block: the child itself at +0 and the reading end of its pipe at +8.
// That block is the handle Ens holds on to; nothing else about a child crosses the boundary.
import Value from @ens.llvm.values;
import Runtime from emit.runtime;
import RuntimeFunction from emit.runtime;
import emit.childposix;
import emit.childwindows;

// ptr ens_start_process(ptr program, ptr argumentBlock, i64 argumentCount, ptr commandLine,
// ptr environmentBlock, i64 environmentCount, i64 environmentBytes): the started child, or null when
// it could not be started. An empty environment block hands this process's environment on unchanged.
// A POSIX target execs an argument vector built from the NUL separated block; a Windows target hands
// the joined command line to CreateProcessW, the only shape Win32 accepts.
public startProcessRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.pointerType.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type, runtime.pointerType, runtime.pointerType, runtime.int64Type,
        runtime.int64Type]);
    let known = runtime.existing("ens_start_process", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return childwindows.windowsStart(runtime, type);
    }
    return childposix.posixStart(runtime, type);
}

// i64 ens_read_child(ptr child, ptr buffer, i64 capacity): how many bytes of the child's output were
// written into the buffer, 0 once the output has ended, or -1 when it could not be read.
public readChildRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int64Type.functionType([runtime.pointerType, runtime.pointerType,
        runtime.int64Type]);
    let known = runtime.existing("ens_read_child", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return childwindows.windowsRead(runtime, type);
    }
    return childposix.posixRead(runtime, type);
}

// i64 ens_wait_child(ptr child): the code the child ended with, waiting for it to end first.
public waitChildRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.int64Type.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_wait_child", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return childwindows.windowsWait(runtime, type);
    }
    return childposix.posixWait(runtime, type);
}

// void ens_release_child(ptr child): the pipe and this process's hold on the child handed back, and
// the block freed. The child itself is left to run: nothing here waits for one.
public releaseChildRuntime(Runtime runtime) -> RuntimeFunction {
    let type = runtime.voidType.functionType([runtime.pointerType]);
    let known = runtime.existing("ens_release_child", type);
    if (known != null) {
        return known;
    }
    if (runtime.onWindows()) {
        return childwindows.windowsRelease(runtime, type);
    }
    return childposix.posixRelease(runtime, type);
}

// The address inside a child's block: the child itself at 0, the reading end of its pipe at 8.
public childField(Runtime runtime, Value block, long offset) -> Value {
    return runtime.offsetPointer(block, offset, "child.field");
}
