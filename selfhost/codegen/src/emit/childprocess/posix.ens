// The POSIX halves of the child bridges. Every pipe end is close-on-exec and nothing between fork
// and exec allocates or locks, so a second thread starting a child at the same moment sees none of
// this one's descriptors and a child that could not exec reports why through a pipe of its own.
import Value from @ens.llvm.values;
import TypeRef from @ens.llvm.types;
import BasicBlock from @ens.llvm.blocks;
import @ens.llvm.instructions;
import @ens.llvm.memory;
import ChildStream from emit.nativeshapes;
import DescriptorControl from emit.nativeshapes;
import Kevent from emit.nativeshapes;
import PollEvent from emit.nativeshapes;
import PollReady from emit.nativeshapes;
import PollTurn from emit.nativeshapes;
import Pollfd from emit.nativeshapes;
import Signal from emit.nativeshapes;
import StdioMode from emit.nativeshapes;
import Timespec from emit.nativeshapes;
import WaitStatus from emit.nativeshapes;
import emit.nativeshapes;
import Errno from emit.errorkinds;
import PosixChild from emit.childprocess;
import emit.childprocess;
import emit.clock;
import Runtime from emit.runtime;
import RuntimeDefinition from emit.runtime;
import RuntimeFunction from emit.runtime;
import emit.spawnposix;
import emit.system;

// The slots of the descriptor table a start fills, two per pipe, in the order pipe writes them.
final class PipeEnds {
    protected static const long inputRead = 0;
    protected static const long inputWrite = 1;
    protected static const long outputRead = 2;
    protected static const long outputWrite = 3;
    protected static const long errorsRead = 4;
    protected static const long errorsWrite = 5;
    protected static const long reportRead = 6;
    protected static const long reportWrite = 7;
    protected static const long count = 8;
}

public posixStart(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let makePipe = runtime.libc("pipe", runtime.int32Type.functionType([runtime.pointerType]));
    let control = runtime.libc("fcntl",
        runtime.int32Type.variadicFunctionType([runtime.int32Type, runtime.int32Type]));
    let forkProcess = runtime.libc("fork", runtime.int32Type.functionType([]));
    let changeDirectory = runtime.libc("chdir",
        runtime.int32Type.functionType([runtime.pointerType]));
    let execProgram = runtime.libc("execve", runtime.int32Type.functionType([runtime.pointerType,
        runtime.pointerType, runtime.pointerType]));
    let exitChild = runtime.libc("_exit", runtime.voidType.functionType([runtime.int32Type]));
    let writeDescriptor = runtime.libc("write", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let readDescriptor = runtime.libc("read", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let allocate = runtime.malloc();
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_process_start", type);
    let builder = runtime.builder;
    let allocateBlock = runtime.block(definition, "start.allocate");
    let invalidBlock = runtime.block(definition, "start.invalid");
    let noMemoryBlock = runtime.block(definition, "start.no.memory");
    let pipesBlock = runtime.block(definition, "start.pipes");
    let forkBlock = runtime.block(definition, "start.fork");
    let childBlock = runtime.block(definition, "start.child");
    let reportBlock = runtime.block(definition, "start.child.report");
    let parentBlock = runtime.block(definition, "start.parent");
    let heldBlock = runtime.block(definition, "start.held");
    let execFailedBlock = runtime.block(definition, "start.exec.failed");
    let startedBlock = runtime.block(definition, "start.started");
    let failedBlock = runtime.block(definition, "start.failed");

    let program = runtime.parameter(definition, 0);
    let argumentCount = runtime.parameter(definition, 2);
    let environmentCount = runtime.parameter(definition, 5);
    let environmentGiven = runtime.parameter(definition, 7);
    let workingDirectory = runtime.parameter(definition, 8);
    let modes = [runtime.parameter(definition, 9), runtime.parameter(definition, 10),
        runtime.parameter(definition, 11)];
    let errorSlot = runtime.parameter(definition, 12);

    // The child inherits a copy of whatever is still buffered in this process's streams, which it
    // would write out a second time.
    runtime.flushBuffered();
    let ends = memory.buildAlloca(builder,
        runtime.int32Type.arrayType(PipeEnds.count as ulong), "ends");
    for (long slot = 0; slot < PipeEnds.count; slot++) {
        memory.buildStore(builder, runtime.int32(-1), endSlot(runtime, ends, slot));
    }
    let reasonSlot = memory.buildAlloca(builder, runtime.int32Type, "reason");
    let reportedSlot = memory.buildAlloca(builder, runtime.int32Type, "reported");
    memory.buildStore(builder, runtime.int32(0), reasonSlot);
    memory.buildStore(builder, runtime.int32(0), reportedSlot);
    let argumentVector = memory.buildArrayAlloca(builder, runtime.pointerType,
        instructions.buildAdd(builder, argumentCount, runtime.int64(1), ""), "argv");
    let environmentVector = memory.buildArrayAlloca(builder, runtime.pointerType,
        instructions.buildAdd(builder, environmentCount, runtime.int64(1), ""), "envp");
    instructions.buildCondBr(builder, childprocess.validModes(runtime, modes), allocateBlock, invalidBlock);

    builder.positionAtEnd(invalidBlock);
    memory.buildStore(builder, runtime.int32(Errno.invalidArgument), errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());

    builder.positionAtEnd(allocateBlock);
    let block = runtime.call(allocate, [runtime.int64(PosixChild.structBytes)], "child.block");
    instructions.buildCondBr(builder, runtime.isNull(block), noMemoryBlock, pipesBlock);

    builder.positionAtEnd(noMemoryBlock);
    memory.buildStore(builder, runtime.int32(Errno.outOfMemory), errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());

    // Everything the child will need is built before the fork, so nothing after it allocates.
    builder.positionAtEnd(pipesBlock);
    for (long offset = 0; offset < PosixChild.structBytes; offset = offset + 4) {
        memory.buildStore(builder, runtime.int32(0), childprocess.childField(runtime, block, offset));
    }
    memory.buildStore(builder, runtime.int32(-1),
        childprocess.childField(runtime, block, PosixChild.pidDescriptor));
    spawnposix.blockVector(runtime, definition, argumentVector, runtime.int64(0),
        runtime.parameter(definition, 1), argumentCount, "argv");
    spawnposix.blockVector(runtime, definition, environmentVector, runtime.int64(0),
        runtime.parameter(definition, 4), environmentCount, "envp");
    openPipe(runtime, definition, makePipe, control, ends, PipeEnds.inputRead, modes[0],
        reasonSlot, failedBlock, "input");
    openPipe(runtime, definition, makePipe, control, ends, PipeEnds.outputRead, modes[1],
        reasonSlot, failedBlock, "output");
    openPipe(runtime, definition, makePipe, control, ends, PipeEnds.errorsRead, modes[2],
        reasonSlot, failedBlock, "errors");
    openPipe(runtime, definition, makePipe, control, ends, PipeEnds.reportRead, runtime.int32(1),
        reasonSlot, failedBlock, "report");
    instructions.buildBr(builder, forkBlock);

    builder.positionAtEnd(forkBlock);
    let child = runtime.call(forkProcess, [], "child");
    memory.buildStore(builder, runtime.lastError(), reasonSlot);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, child, runtime.int32(0), ""), childBlock, parentBlock);

    // Only calls that are safe after a fork run in the child, and any refusal goes back through the
    // report pipe before the child ends.
    builder.positionAtEnd(childBlock);
    changeWorkingDirectory(runtime, definition, changeDirectory, workingDirectory, reasonSlot,
        reportBlock);
    let dupCommand = nativeshapes.duplicateCloseOnExecCommand(runtime.targetTriple);
    liftLowEnd(runtime, definition, control, dupCommand, ends, PipeEnds.inputRead, modes[0],
        reasonSlot, reportBlock, "input");
    liftLowEnd(runtime, definition, control, dupCommand, ends, PipeEnds.outputWrite, modes[1],
        reasonSlot, reportBlock, "output");
    liftLowEnd(runtime, definition, control, dupCommand, ends, PipeEnds.errorsWrite, modes[2],
        reasonSlot, reportBlock, "errors");
    attachEnd(runtime, definition, ends, PipeEnds.inputRead, 0, modes[0], reasonSlot,
        reportBlock, "input");
    attachEnd(runtime, definition, ends, PipeEnds.outputWrite, 1, modes[1], reasonSlot,
        reportBlock, "output");
    attachEnd(runtime, definition, ends, PipeEnds.errorsWrite, 2, modes[2], reasonSlot,
        reportBlock, "errors");
    let inherited = memory.buildLoad(builder, runtime.pointerType, system.environGlobal(runtime),
        "environ");
    let environment = instructions.buildSelect(builder,
        instructions.buildICmpNE(builder, environmentGiven, runtime.int32(0), ""),
        environmentVector, inherited, "environment");
    runtime.call(execProgram, [program, argumentVector, environment], "");
    memory.buildStore(builder, runtime.lastError(), reasonSlot);
    instructions.buildBr(builder, reportBlock);

    builder.positionAtEnd(reportBlock);
    runtime.call(writeDescriptor, [loadEnd(runtime, ends, PipeEnds.reportWrite), reasonSlot,
        runtime.int64(4)], "");
    runtime.call(exitChild, [runtime.int32(127)], "");
    instructions.buildUnreachable(builder);

    // The parent hands back every end the child holds and reads the report pipe. Nothing arrives
    // when the exec replaced the child, and an errno arrives when it did not.
    builder.positionAtEnd(parentBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, child, runtime.int32(0), ""), failedBlock, heldBlock);

    builder.positionAtEnd(heldBlock);
    closeEnd(runtime, definition, ends, PipeEnds.inputRead, "held.input");
    closeEnd(runtime, definition, ends, PipeEnds.outputWrite, "held.output");
    closeEnd(runtime, definition, ends, PipeEnds.errorsWrite, "held.errors");
    closeEnd(runtime, definition, ends, PipeEnds.reportWrite, "held.report");
    let reportLength = retryingRead(runtime, definition, readDescriptor,
        loadEnd(runtime, ends, PipeEnds.reportRead), reportedSlot, "report");
    closeEnd(runtime, definition, ends, PipeEnds.reportRead, "read.report");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGT(builder, reportLength, runtime.int64(0), ""), execFailedBlock,
        startedBlock);

    builder.positionAtEnd(execFailedBlock);
    let discarded = memory.buildAlloca(builder, runtime.int32Type, "discarded");
    let unreachedBlock = runtime.block(definition, "start.exec.failed.lost");
    spawnposix.awaitChild(runtime, definition, child, discarded, unreachedBlock, "collect");
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type, reportedSlot, ""),
        reasonSlot);
    instructions.buildBr(builder, failedBlock);

    builder.positionAtEnd(unreachedBlock);
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type, reportedSlot, ""),
        reasonSlot);
    instructions.buildBr(builder, failedBlock);

    builder.positionAtEnd(startedBlock);
    memory.buildStore(builder, child, childprocess.childField(runtime, block, PosixChild.pid));
    openPidDescriptor(runtime, block, child);
    memory.buildStore(builder, loadEnd(runtime, ends, PipeEnds.inputWrite),
        childprocess.childField(runtime, block, PosixChild.input));
    memory.buildStore(builder, loadEnd(runtime, ends, PipeEnds.outputRead),
        childprocess.childField(runtime, block, PosixChild.output));
    memory.buildStore(builder, loadEnd(runtime, ends, PipeEnds.errorsRead),
        childprocess.childField(runtime, block, PosixChild.errors));
    memory.buildStore(builder, runtime.int32(0), errorSlot);
    instructions.buildRet(builder, block);

    builder.positionAtEnd(failedBlock);
    for (long slot = 0; slot < PipeEnds.count; slot++) {
        closeEnd(runtime, definition, ends, slot, "failed.{slot}");
    }
    runtime.call(release, [block], "");
    memory.buildStore(builder, memory.buildLoad(builder, runtime.int32Type, reasonSlot, ""),
        errorSlot);
    instructions.buildRet(builder, runtime.nullPointer());
    return runtime.endDefinition(definition);
}

public posixRead(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let readDescriptor = runtime.libc("read", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let definition = runtime.beginDefinition("ens_process_read", type);
    let builder = runtime.builder;
    let readBlock = runtime.block(definition, "read.ask");
    let refusedBlock = runtime.block(definition, "read.refused");
    let doneBlock = runtime.block(definition, "read.done");
    let invalidBlock = runtime.block(definition, "read.invalid");
    let failedBlock = runtime.block(definition, "read.failed");
    let block = runtime.parameter(definition, 0);
    let stream = runtime.parameter(definition, 1);
    let descriptor = streamDescriptor(runtime, block, stream);
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, descriptor, runtime.int32(0), ""), invalidBlock,
        readBlock);

    builder.positionAtEnd(invalidBlock);
    instructions.buildRet(builder, runtime.int32(Errno.invalidArgument));

    builder.positionAtEnd(readBlock);
    let count = runtime.call(readDescriptor, [descriptor, runtime.parameter(definition, 2),
        runtime.parameter(definition, 3)], "count");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, count, runtime.int64(0), ""), refusedBlock, doneBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), readBlock,
        failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);

    builder.positionAtEnd(doneBlock);
    let endedSlot = streamEndedSlot(runtime, block, stream);
    memory.buildStore(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, count, runtime.int64(0), ""), runtime.int32(1),
        memory.buildLoad(builder, runtime.int32Type, endedSlot, ""), "ended"), endedSlot);
    memory.buildStore(builder, count, runtime.parameter(definition, 4));
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

public posixWrite(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let writeDescriptor = runtime.libc("write", runtime.int64Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int64Type]));
    let definition = runtime.beginDefinition("ens_process_write", type);
    let builder = runtime.builder;
    let writeBlock = runtime.block(definition, "write.ask");
    let refusedBlock = runtime.block(definition, "write.refused");
    let doneBlock = runtime.block(definition, "write.done");
    let closedBlock = runtime.block(definition, "write.closed");
    let failedBlock = runtime.block(definition, "write.failed");
    let descriptor = childprocess.loadField(runtime, runtime.parameter(definition, 0), PosixChild.input);
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, descriptor, runtime.int32(0), ""), closedBlock,
        writeBlock);

    builder.positionAtEnd(closedBlock);
    instructions.buildRet(builder, runtime.int32(Errno.brokenPipe));

    builder.positionAtEnd(writeBlock);
    let written = runtime.call(writeDescriptor, [descriptor, runtime.parameter(definition, 1),
        runtime.parameter(definition, 2)], "written");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, written, runtime.int64(0), ""), refusedBlock,
        doneBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), writeBlock,
        failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);

    builder.positionAtEnd(doneBlock);
    memory.buildStore(builder, written, runtime.parameter(definition, 3));
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

public posixCloseInput(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_process_close_input", type);
    let builder = runtime.builder;
    let closeBlock = runtime.block(definition, "close.ask");
    let closedBlock = runtime.block(definition, "close.done");
    let slot = childprocess.childField(runtime, runtime.parameter(definition, 0),
        PosixChild.input);
    let descriptor = memory.buildLoad(builder, runtime.int32Type, slot, "input");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, descriptor, runtime.int32(0), ""), closedBlock,
        closeBlock);

    builder.positionAtEnd(closeBlock);
    let status = runtime.call(closeDescriptor, [descriptor], "status");
    let why = runtime.lastError();
    memory.buildStore(builder, runtime.int32(-1), slot);
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), runtime.int32(0), why,
        ""));

    builder.positionAtEnd(closedBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

public posixWait(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_process_wait", type);
    let builder = runtime.builder;
    let rememberedBlock = runtime.block(definition, "wait.remembered");
    let askBlock = runtime.block(definition, "wait.ask");
    let refusedBlock = runtime.block(definition, "wait.refused");
    let decodeBlock = runtime.block(definition, "wait.decode");
    let failedBlock = runtime.block(definition, "wait.failed");
    let block = runtime.parameter(definition, 0);
    let codeSlot = runtime.parameter(definition, 1);
    let signalSlot = runtime.parameter(definition, 2);
    let statusSlot = memory.buildAlloca(builder, runtime.int32Type, "status");
    memory.buildStore(builder, runtime.int32(0), statusSlot);
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), ""), rememberedBlock,
        askBlock);

    builder.positionAtEnd(rememberedBlock);
    memory.buildStore(builder, childprocess.loadField(runtime, block, PosixChild.code), codeSlot);
    memory.buildStore(builder, childprocess.loadField(runtime, block, PosixChild.signal), signalSlot);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(askBlock);
    let answer = runtime.call(waitForChild, [childprocess.loadField(runtime, block, PosixChild.pid),
        statusSlot, runtime.int32(0)], "answer");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, answer, runtime.int32(0), ""), refusedBlock,
        decodeBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), askBlock,
        failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);

    builder.positionAtEnd(decodeBlock);
    cacheStatus(runtime, block, memory.buildLoad(builder, runtime.int32Type, statusSlot, "raw"));
    memory.buildStore(builder, childprocess.loadField(runtime, block, PosixChild.code), codeSlot);
    memory.buildStore(builder, childprocess.loadField(runtime, block, PosixChild.signal),
        signalSlot);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

public posixPoll(Runtime runtime, TypeRef type) -> RuntimeFunction {
    if (runtime.onDarwin()) {
        return darwinPoll(runtime, type);
    }
    return linuxPoll(runtime, type);
}

// One poll over the two pipes and the pidfd, whose readiness is the child's end. Without a pidfd
// the child's end has nothing to wait on, so the poll turns every few milliseconds and asks
// waitpid between turns, and that is the only place this bridge turns.
linuxPoll(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let pollDescriptors = runtime.libc("poll", runtime.int32Type.functionType([runtime.pointerType,
        runtime.int64Type, runtime.int32Type]));
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let now = clock.monotonicMillisRuntime(runtime);
    let definition = runtime.beginDefinition("ens_process_poll", type);
    let builder = runtime.builder;
    let turnBlock = runtime.block(definition, "poll.turn");
    let idleBlock = runtime.block(definition, "poll.idle");
    let pollBlock = runtime.block(definition, "poll.ask");
    let refusedBlock = runtime.block(definition, "poll.refused");
    let collectBlock = runtime.block(definition, "poll.collect");
    let askBlock = runtime.block(definition, "poll.ask.child");
    let collectedBlock = runtime.block(definition, "poll.collected");
    let decideBlock = runtime.block(definition, "poll.decide");
    let doneBlock = runtime.block(definition, "poll.done");
    let failedBlock = runtime.block(definition, "poll.failed");
    let block = runtime.parameter(definition, 0);
    let millis = runtime.parameter(definition, 1);
    let readySlot = runtime.parameter(definition, 2);
    let watched = memory.buildAlloca(builder,
        runtime.int8Type.arrayType((Pollfd.structBytes * 3) as ulong), "watched");
    let statusSlot = memory.buildAlloca(builder, runtime.int32Type, "status");
    let bounded = instructions.buildICmpSGE(builder, millis, runtime.int64(0), "bounded");
    let deadline = instructions.buildAdd(builder, runtime.call(now, [], "started"), millis,
        "deadline");
    memory.buildStore(builder, runtime.int32(0), readySlot);
    instructions.buildBr(builder, turnBlock);

    builder.positionAtEnd(turnBlock);
    let remaining = remainingMillis(runtime, now, bounded, deadline);
    let reaped = instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), "reaped");
    let pidDescriptor = childprocess.loadField(runtime, block, PosixChild.pidDescriptor);
    let turning = instructions.buildAnd(builder,
        instructions.buildICmpSLT(builder, pidDescriptor, runtime.int32(0), ""),
        instructions.buildNot(builder, reaped, ""), "turning");
    let turn = instructions.buildSelect(builder, turning, boundedTurn(runtime, bounded, remaining),
        remaining, "turn");
    let outputLive = watchDescriptor(runtime, watched, 0, streamDescriptor(runtime, block,
        runtime.int32(ChildStream.output)), block, PosixChild.outputEnded);
    let errorsLive = watchDescriptor(runtime, watched, 1, streamDescriptor(runtime, block,
        runtime.int32(ChildStream.errors)), block, PosixChild.errorsEnded);
    memory.buildStore(builder, instructions.buildSelect(builder, reaped, runtime.int32(-1),
        pidDescriptor, ""), runtime.offsetPointer(watched, Pollfd.structBytes * 2, ""));
    let idle = instructions.buildAnd(builder, reaped, instructions.buildNot(builder,
        instructions.buildOr(builder, outputLive, errorsLive, ""), ""), "idle");
    instructions.buildCondBr(builder, idle, idleBlock, pollBlock);

    // A collected child whose streams have both ended leaves nothing to ask the system about.
    builder.positionAtEnd(idleBlock);
    memory.buildStore(builder, runtime.int32(PollReady.ended), readySlot);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(pollBlock);
    memory.buildStore(builder, runtime.int16Type.constInt(PollEvent.input as ulong, false),
        runtime.offsetPointer(watched, Pollfd.structBytes * 2 + Pollfd.events, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(0, false),
        runtime.offsetPointer(watched, Pollfd.structBytes * 2 + Pollfd.revents, ""));
    let woken = runtime.call(pollDescriptors, [watched, runtime.int64(3),
        instructions.buildTrunc(builder, turn, runtime.int32Type, "")], "woken");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, woken, runtime.int32(0), ""), refusedBlock,
        collectBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), turnBlock,
        failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);

    builder.positionAtEnd(collectBlock);
    Value mask = instructions.buildSelect(builder, reaped, runtime.int32(PollReady.ended),
        runtime.int32(0), "");
    mask = instructions.buildOr(builder, mask, reportedBit(runtime, watched, 0, PollReady.output),
        "");
    mask = instructions.buildOr(builder, mask, reportedBit(runtime, watched, 1, PollReady.errors),
        "");
    mask = instructions.buildOr(builder, mask, reportedBit(runtime, watched, 2, PollReady.ended),
        "mask");
    memory.buildStore(builder, mask, readySlot);
    instructions.buildCondBr(builder, turning, askBlock, decideBlock);

    builder.positionAtEnd(askBlock);
    let answer = runtime.call(waitForChild, [childprocess.loadField(runtime, block,
        PosixChild.pid), statusSlot, runtime.int32(WaitStatus.noHang)], "answer");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGT(builder, answer, runtime.int32(0), ""), collectedBlock,
        decideBlock);

    builder.positionAtEnd(collectedBlock);
    cacheStatus(runtime, block, memory.buildLoad(builder, runtime.int32Type, statusSlot, "raw"));
    memory.buildStore(builder, instructions.buildOr(builder, mask,
        runtime.int32(PollReady.ended), ""), readySlot);
    instructions.buildBr(builder, decideBlock);

    builder.positionAtEnd(decideBlock);
    instructions.buildCondBr(builder, finished(runtime, now, readySlot, bounded, deadline),
        doneBlock, turnBlock);

    builder.positionAtEnd(doneBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

// One kqueue per call over the two pipes and the child's exit note. A child that has already ended
// is collected first, so a zombie is reported without depending on how the note treats one, and a
// note the system refuses because the child is gone counts as its end too.
darwinPoll(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let makeQueue = runtime.libc("kqueue", runtime.int32Type.functionType([]));
    let queueEvents = runtime.libc("kevent", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type, runtime.pointerType, runtime.int32Type,
        runtime.pointerType]));
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let now = clock.monotonicMillisRuntime(runtime);
    let definition = runtime.beginDefinition("ens_process_poll", type);
    let builder = runtime.builder;
    let turnBlock = runtime.block(definition, "poll.turn");
    let askBlock = runtime.block(definition, "poll.ask.child");
    let collectedBlock = runtime.block(definition, "poll.collected");
    let registerBlock = runtime.block(definition, "poll.register");
    let idleBlock = runtime.block(definition, "poll.idle");
    let queueBlock = runtime.block(definition, "poll.queue");
    let queueFailedBlock = runtime.block(definition, "poll.queue.failed");
    let refusedBlock = runtime.block(definition, "poll.refused");
    let collectBlock = runtime.block(definition, "poll.collect");
    let decideBlock = runtime.block(definition, "poll.decide");
    let doneBlock = runtime.block(definition, "poll.done");
    let failedBlock = runtime.block(definition, "poll.failed");
    let block = runtime.parameter(definition, 0);
    let millis = runtime.parameter(definition, 1);
    let readySlot = runtime.parameter(definition, 2);
    let changes = memory.buildAlloca(builder,
        runtime.int8Type.arrayType((Kevent.structBytes * 3) as ulong), "changes");
    let events = memory.buildAlloca(builder,
        runtime.int8Type.arrayType((Kevent.structBytes * 3) as ulong), "events");
    let timeout = memory.buildAlloca(builder,
        runtime.int8Type.arrayType(Timespec.structBytes as ulong), "timeout");
    let statusSlot = memory.buildAlloca(builder, runtime.int32Type, "status");
    let countSlot = memory.buildAlloca(builder, runtime.int32Type, "count");
    let failureSlot = memory.buildAlloca(builder, runtime.int32Type, "failure");
    let bounded = instructions.buildICmpSGE(builder, millis, runtime.int64(0), "bounded");
    let deadline = instructions.buildAdd(builder, runtime.call(now, [], "started"), millis,
        "deadline");
    memory.buildStore(builder, runtime.int32(0), readySlot);
    memory.buildStore(builder, runtime.int32(0), failureSlot);
    instructions.buildBr(builder, turnBlock);

    builder.positionAtEnd(turnBlock);
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), ""),
        registerBlock, askBlock);

    builder.positionAtEnd(askBlock);
    let answer = runtime.call(waitForChild, [childprocess.loadField(runtime, block,
        PosixChild.pid), statusSlot, runtime.int32(WaitStatus.noHang)], "answer");
    instructions.buildCondBr(builder,
        instructions.buildICmpSGT(builder, answer, runtime.int32(0), ""), collectedBlock,
        registerBlock);

    builder.positionAtEnd(collectedBlock);
    cacheStatus(runtime, block, memory.buildLoad(builder, runtime.int32Type, statusSlot, "raw"));
    instructions.buildBr(builder, registerBlock);

    builder.positionAtEnd(registerBlock);
    let reaped = instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), "reaped");
    memory.buildStore(builder, instructions.buildSelect(builder, reaped,
        runtime.int32(PollReady.ended), runtime.int32(0), ""), readySlot);
    memory.buildStore(builder, runtime.int32(0), countSlot);
    registerStream(runtime, definition, changes, countSlot, streamDescriptor(runtime, block,
        runtime.int32(ChildStream.output)), block, PosixChild.outputEnded, PollReady.output,
        "output");
    registerStream(runtime, definition, changes, countSlot, streamDescriptor(runtime, block,
        runtime.int32(ChildStream.errors)), block, PosixChild.errorsEnded, PollReady.errors,
        "errors");
    registerExit(runtime, definition, changes, countSlot, block, reaped);
    let count = memory.buildLoad(builder, runtime.int32Type, countSlot, "count");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, count, runtime.int32(0), ""), idleBlock, queueBlock);

    builder.positionAtEnd(idleBlock);
    instructions.buildRet(builder, runtime.int32(0));

    builder.positionAtEnd(queueBlock);
    let remaining = remainingMillis(runtime, now, bounded, deadline);
    memory.buildStore(builder, instructions.buildSDiv(builder, remaining, runtime.int64(1000), ""),
        runtime.offsetPointer(timeout, Timespec.seconds, ""));
    memory.buildStore(builder, instructions.buildMul(builder,
        instructions.buildSRem(builder, remaining, runtime.int64(1000), ""),
        runtime.int64(1000000), ""), runtime.offsetPointer(timeout, Timespec.nanoseconds, ""));
    let timeoutPointer = instructions.buildSelect(builder, bounded, timeout,
        runtime.nullPointer(), "timeout.pointer");
    let queue = runtime.call(makeQueue, [], "queue");
    let queueError = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, queue, runtime.int32(0), ""), queueFailedBlock,
        collectBlock);

    builder.positionAtEnd(queueFailedBlock);
    instructions.buildRet(builder, queueError);

    builder.positionAtEnd(collectBlock);
    let woken = runtime.call(queueEvents, [queue, changes, count, events, runtime.int32(3),
        timeoutPointer], "woken");
    let why = runtime.lastError();
    runtime.call(closeDescriptor, [queue], "");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, woken, runtime.int32(0), ""), refusedBlock,
        decideBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), turnBlock,
        failedBlock);

    builder.positionAtEnd(failedBlock);
    instructions.buildRet(builder, why);

    builder.positionAtEnd(decideBlock);
    for (long index = 0; index < 3; index++) {
        collectEvent(runtime, definition, events, index, woken, readySlot, failureSlot,
            failedBlock);
    }
    instructions.buildCondBr(builder, finished(runtime, now, readySlot, bounded, deadline),
        doneBlock, turnBlock);

    builder.positionAtEnd(doneBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

// A child already collected is nothing to stop, and so is one the system no longer knows.
public posixKill(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let killProcess = runtime.libc("kill",
        runtime.int32Type.functionType([runtime.int32Type, runtime.int32Type]));
    let definition = runtime.beginDefinition("ens_process_kill", type);
    let builder = runtime.builder;
    let stopBlock = runtime.block(definition, "kill.stop");
    let refusedBlock = runtime.block(definition, "kill.refused");
    let goneBlock = runtime.block(definition, "kill.gone");
    let block = runtime.parameter(definition, 0);
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), ""), goneBlock, stopBlock);

    builder.positionAtEnd(stopBlock);
    let status = runtime.call(killProcess, [childprocess.loadField(runtime, block, PosixChild.pid),
        runtime.int32(Signal.kill)], "status");
    let why = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), goneBlock, refusedBlock);

    builder.positionAtEnd(refusedBlock);
    instructions.buildRet(builder, instructions.buildSelect(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.noSuchProcess), ""),
        runtime.int32(0), why, ""));

    builder.positionAtEnd(goneBlock);
    instructions.buildRet(builder, runtime.int32(0));
    return runtime.endDefinition(definition);
}

public posixRelease(Runtime runtime, TypeRef type) -> RuntimeFunction {
    let waitForChild = runtime.libc("waitpid", runtime.int32Type.functionType([runtime.int32Type,
        runtime.pointerType, runtime.int32Type]));
    let release = runtime.free();
    let definition = runtime.beginDefinition("ens_process_release", type);
    let builder = runtime.builder;
    let collectBlock = runtime.block(definition, "release.collect");
    let freeBlock = runtime.block(definition, "release.free");
    let block = runtime.parameter(definition, 0);
    closeField(runtime, definition, block, PosixChild.input, "release.input");
    closeField(runtime, definition, block, PosixChild.output, "release.output");
    closeField(runtime, definition, block, PosixChild.errors, "release.errors");
    closeField(runtime, definition, block, PosixChild.pidDescriptor, "release.pidfd");
    instructions.buildCondBr(builder, instructions.buildICmpNE(builder,
        childprocess.loadField(runtime, block, PosixChild.reaped), runtime.int32(0), ""), freeBlock,
        collectBlock);

    // A child that has ended is collected here, and one still running is left to the system.
    builder.positionAtEnd(collectBlock);
    runtime.call(waitForChild, [childprocess.loadField(runtime, block, PosixChild.pid), runtime.nullPointer(),
        runtime.int32(WaitStatus.noHang)], "");
    instructions.buildBr(builder, freeBlock);

    builder.positionAtEnd(freeBlock);
    runtime.call(release, [block], "");
    instructions.buildRetVoid(builder);
    return runtime.endDefinition(definition);
}

// Opens the pipe the slot pair begins at when the mode asks for one, marking both ends
// close-on-exec, and goes to `failedBlock` with the reason kept when either call refuses.
openPipe(Runtime runtime, RuntimeDefinition definition, RuntimeFunction makePipe,
         RuntimeFunction control, Value ends, long firstSlot, Value mode, Value reasonSlot,
         BasicBlock failedBlock, string label) {
    let builder = runtime.builder;
    let openBlock = runtime.block(definition, "pipe.{label}.open");
    let flagBlock = runtime.block(definition, "pipe.{label}.flags");
    let refusedBlock = runtime.block(definition, "pipe.{label}.refused");
    let doneBlock = runtime.block(definition, "pipe.{label}.done");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, mode, runtime.int32(StdioMode.inherit), ""), doneBlock,
        openBlock);

    builder.positionAtEnd(openBlock);
    let piped = runtime.call(makePipe, [endSlot(runtime, ends, firstSlot)], "piped");
    let pipeError = runtime.lastError();
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, piped, runtime.int32(0), ""), flagBlock, refusedBlock);

    builder.positionAtEnd(flagBlock);
    let first = runtime.call(control, [loadEnd(runtime, ends, firstSlot),
        runtime.int32(DescriptorControl.setFlags), runtime.int32(DescriptorControl.closeOnExec)],
        "flagged.read");
    let second = runtime.call(control, [loadEnd(runtime, ends, firstSlot + 1),
        runtime.int32(DescriptorControl.setFlags), runtime.int32(DescriptorControl.closeOnExec)],
        "flagged.write");
    let flagError = runtime.lastError();
    let flagged = instructions.buildAnd(builder,
        instructions.buildICmpSGE(builder, first, runtime.int32(0), ""),
        instructions.buildICmpSGE(builder, second, runtime.int32(0), ""), "flagged");
    memory.buildStore(builder, flagError, reasonSlot);
    instructions.buildCondBr(builder, flagged, doneBlock, failedBlock);

    builder.positionAtEnd(refusedBlock);
    memory.buildStore(builder, pipeError, reasonSlot);
    instructions.buildBr(builder, failedBlock);

    builder.positionAtEnd(doneBlock);
}

// Changes to the working directory when one was given, reporting a refusal through the pipe.
changeWorkingDirectory(Runtime runtime, RuntimeDefinition definition,
                       RuntimeFunction changeDirectory, Value directory, Value reasonSlot,
                       BasicBlock reportBlock) {
    let builder = runtime.builder;
    let changeBlock = runtime.block(definition, "child.directory.change");
    let doneBlock = runtime.block(definition, "child.directory.done");
    let first = memory.buildLoad(builder, runtime.int8Type, directory, "directory.first");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, first, runtime.int8(0), ""), doneBlock, changeBlock);

    builder.positionAtEnd(changeBlock);
    let status = runtime.call(changeDirectory, [directory], "changed");
    memory.buildStore(builder, runtime.lastError(), reasonSlot);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, status, runtime.int32(0), ""), doneBlock, reportBlock);

    builder.positionAtEnd(doneBlock);
}

// Moves a child's end that sits at one of the three standard descriptors up above them, so that
// aiming another end at that descriptor cannot close it first. The copy is close-on-exec like the
// original, and the original closes itself at exec.
liftLowEnd(Runtime runtime, RuntimeDefinition definition, RuntimeFunction control,
           long dupCommand, Value ends, long slot, Value mode, Value reasonSlot,
           BasicBlock reportBlock, string label) {
    let builder = runtime.builder;
    let checkBlock = runtime.block(definition, "child.lift.{label}.check");
    let liftBlock = runtime.block(definition, "child.lift.{label}.lift");
    let doneBlock = runtime.block(definition, "child.lift.{label}.done");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, mode, runtime.int32(StdioMode.inherit), ""), doneBlock,
        checkBlock);

    builder.positionAtEnd(checkBlock);
    let end = loadEnd(runtime, ends, slot);
    instructions.buildCondBr(builder, instructions.buildICmpSLT(builder, end,
        runtime.int32(DescriptorControl.lowestFreeDescriptor), ""), liftBlock, doneBlock);

    builder.positionAtEnd(liftBlock);
    let lifted = runtime.call(control, [end, runtime.int32(dupCommand),
        runtime.int32(DescriptorControl.lowestFreeDescriptor)], "lifted");
    memory.buildStore(builder, runtime.lastError(), reasonSlot);
    memory.buildStore(builder, lifted, endSlot(runtime, ends, slot));
    instructions.buildCondBr(builder,
        instructions.buildICmpSGE(builder, lifted, runtime.int32(0), ""), doneBlock, reportBlock);

    builder.positionAtEnd(doneBlock);
}

// Aims the child's standard descriptor at its end of the pipe. dup2 clears close-on-exec on the
// target, so the child keeps exactly the three it is meant to.
attachEnd(Runtime runtime, RuntimeDefinition definition, Value ends, long slot, long target,
          Value mode, Value reasonSlot, BasicBlock reportBlock, string label) {
    let builder = runtime.builder;
    let duplicate = runtime.libc("dup2",
        runtime.int32Type.functionType([runtime.int32Type, runtime.int32Type]));
    let attachBlock = runtime.block(definition, "child.attach.{label}.aim");
    let doneBlock = runtime.block(definition, "child.attach.{label}.done");
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, mode, runtime.int32(StdioMode.inherit), ""), doneBlock,
        attachBlock);

    builder.positionAtEnd(attachBlock);
    let aimed = runtime.call(duplicate, [loadEnd(runtime, ends, slot), runtime.int32(target)],
        "aimed");
    memory.buildStore(builder, runtime.lastError(), reasonSlot);
    instructions.buildCondBr(builder,
        instructions.buildICmpSGE(builder, aimed, runtime.int32(0), ""), doneBlock, reportBlock);

    builder.positionAtEnd(doneBlock);
}

// Reads up to four bytes into the slot, asking again after a signal interrupts, and answers how
// many arrived. A read the pipe itself refused answers as nothing arriving, since the child has
// either exec'd or ended with 127 and a wait tells the two apart.
retryingRead(Runtime runtime, RuntimeDefinition definition, RuntimeFunction readDescriptor,
             Value descriptor, Value slot, string label) -> Value {
    let builder = runtime.builder;
    let askBlock = runtime.block(definition, "{label}.read.ask");
    let refusedBlock = runtime.block(definition, "{label}.read.refused");
    let doneBlock = runtime.block(definition, "{label}.read.done");
    let lengthSlot = memory.buildAlloca(builder, runtime.int64Type, "{label}.length");
    instructions.buildBr(builder, askBlock);

    builder.positionAtEnd(askBlock);
    let count = runtime.call(readDescriptor, [descriptor, slot, runtime.int64(4)], "count");
    let why = runtime.lastError();
    memory.buildStore(builder, count, lengthSlot);
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, count, runtime.int64(0), ""), refusedBlock, doneBlock);

    builder.positionAtEnd(refusedBlock);
    memory.buildStore(builder, runtime.int64(0), lengthSlot);
    instructions.buildCondBr(builder,
        instructions.buildICmpEQ(builder, why, runtime.int32(Errno.interrupted), ""), askBlock,
        doneBlock);

    builder.positionAtEnd(doneBlock);
    return memory.buildLoad(builder, runtime.int64Type, lengthSlot, "{label}.arrived");
}

// Closes the descriptor the table slot holds when it holds one, and marks the slot empty.
closeEnd(Runtime runtime, RuntimeDefinition definition, Value ends, long slot, string label) {
    closeSlot(runtime, definition, endSlot(runtime, ends, slot), label);
}

// Closes the descriptor the block field holds when it holds one, and marks the field empty.
closeField(Runtime runtime, RuntimeDefinition definition, Value block, long offset,
           string label) {
    closeSlot(runtime, definition, childprocess.childField(runtime, block, offset), label);
}

closeSlot(Runtime runtime, RuntimeDefinition definition, Value slot, string label) {
    let builder = runtime.builder;
    let closeDescriptor = runtime.libc("close",
        runtime.int32Type.functionType([runtime.int32Type]));
    let closeBlock = runtime.block(definition, "{label}.close");
    let doneBlock = runtime.block(definition, "{label}.kept");
    let descriptor = memory.buildLoad(builder, runtime.int32Type, slot, "held");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, descriptor, runtime.int32(0), ""), doneBlock,
        closeBlock);

    builder.positionAtEnd(closeBlock);
    runtime.call(closeDescriptor, [descriptor], "");
    memory.buildStore(builder, runtime.int32(-1), slot);
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(doneBlock);
}

// The descriptor a read of the stream uses, or -1 for a stream that is no pipe.
streamDescriptor(Runtime runtime, Value block, Value stream) -> Value {
    let builder = runtime.builder;
    return instructions.buildSelect(builder, isStream(runtime, stream, ChildStream.output),
        childprocess.loadField(runtime, block, PosixChild.output),
        instructions.buildSelect(builder, isStream(runtime, stream, ChildStream.errors),
            childprocess.loadField(runtime, block, PosixChild.errors), runtime.int32(-1), ""), "descriptor");
}

// The field recording whether the stream has ended.
streamEndedSlot(Runtime runtime, Value block, Value stream) -> Value {
    return instructions.buildSelect(runtime.builder,
        isStream(runtime, stream, ChildStream.output),
        childprocess.childField(runtime, block, PosixChild.outputEnded),
        childprocess.childField(runtime, block, PosixChild.errorsEnded), "ended.slot");
}

isStream(Runtime runtime, Value stream, long wanted) -> Value {
    return instructions.buildICmpEQ(runtime.builder, stream, runtime.int32(wanted), "");
}

endSlot(Runtime runtime, Value ends, long slot) -> Value {
    return memory.buildGEP(runtime.builder, runtime.int32Type, ends, [runtime.int64(slot)],
        "end.slot");
}

loadEnd(Runtime runtime, Value ends, long slot) -> Value {
    return memory.buildLoad(runtime.builder, runtime.int32Type, endSlot(runtime, ends, slot),
        "end");
}

// Records how the child ended from its raw wait status. The low seven bits name the signal that
// ended it, and are zero for a child that exited with the code held eight bits up.
cacheStatus(Runtime runtime, Value block, Value status) {
    let builder = runtime.builder;
    let low = instructions.buildAnd(builder, status, runtime.int32(WaitStatus.signalMask), "low");
    let exited = instructions.buildICmpEQ(builder, low, runtime.int32(0), "exited");
    let code = instructions.buildSelect(builder, exited, instructions.buildAnd(builder,
        instructions.buildLShr(builder, status, runtime.int32(WaitStatus.codeShift), ""),
        runtime.int32(WaitStatus.codeMask), ""), runtime.int32(0), "code");
    let signal = instructions.buildSelect(builder, exited, runtime.int32(0), low, "signal");
    memory.buildStore(builder, runtime.int32(1),
        childprocess.childField(runtime, block, PosixChild.reaped));
    memory.buildStore(builder, code, childprocess.childField(runtime, block, PosixChild.code));
    memory.buildStore(builder, signal,
        childprocess.childField(runtime, block, PosixChild.signal));
}

// Opens a pidfd on the child where the target has the call, keeping -1 where the kernel has not.
// The child is still uncollected here, so the number cannot yet name another process.
openPidDescriptor(Runtime runtime, Value block, Value child) {
    long number = nativeshapes.pidfdOpenSystemCall(runtime.targetTriple);
    if (number == 0) {
        return;
    }
    let builder = runtime.builder;
    let systemCall = runtime.libc("syscall",
        runtime.int64Type.variadicFunctionType([runtime.int64Type]));
    let opened = instructions.buildTrunc(builder, runtime.call(systemCall, [runtime.int64(number),
        instructions.buildSExt(builder, child, runtime.int64Type, ""), runtime.int64(0)],
        "pidfd"), runtime.int32Type, "");
    memory.buildStore(builder, instructions.buildSelect(builder,
        instructions.buildICmpSLT(builder, opened, runtime.int32(0), ""), runtime.int32(-1),
        opened, ""), childprocess.childField(runtime, block, PosixChild.pidDescriptor));
}

// How many milliseconds are left before the deadline, at least 0, or -1 when there is no bound.
remainingMillis(Runtime runtime, RuntimeFunction now, Value bounded, Value deadline) -> Value {
    let builder = runtime.builder;
    let left = instructions.buildSub(builder, deadline, runtime.call(now, [], "now"), "left");
    let clamped = instructions.buildSelect(builder,
        instructions.buildICmpSLT(builder, left, runtime.int64(0), ""), runtime.int64(0),
        instructions.buildSelect(builder,
            instructions.buildICmpSGT(builder, left, runtime.int64(0x7FFFFFFF), ""),
            runtime.int64(0x7FFFFFFF), left, ""), "");
    return instructions.buildSelect(builder, bounded, clamped, runtime.int64(-1), "remaining");
}

// One turn's length where the child's end cannot be waited on, which is the turn bound or what is
// left of the deadline, whichever is shorter.
boundedTurn(Runtime runtime, Value bounded, Value remaining) -> Value {
    let builder = runtime.builder;
    let shorter = instructions.buildICmpSLT(builder, remaining, runtime.int64(PollTurn.millis), "");
    return instructions.buildSelect(builder, instructions.buildAnd(builder, bounded, shorter, ""),
        remaining, runtime.int64(PollTurn.millis), "turn");
}

// True when the mask holds anything or the deadline has passed, which is when a poll answers.
finished(Runtime runtime, RuntimeFunction now, Value readySlot, Value bounded, Value deadline)
        -> Value {
    let builder = runtime.builder;
    let ready = instructions.buildICmpNE(builder,
        memory.buildLoad(builder, runtime.int32Type, readySlot, "ready"), runtime.int32(0), "");
    let passed = instructions.buildAnd(builder, bounded, instructions.buildICmpSLE(builder,
        deadline, runtime.call(now, [], "now"), ""), "passed");
    return instructions.buildOr(builder, ready, passed, "finished");
}

// Fills one 'struct pollfd' with the stream's descriptor, or with -1 where the stream is no pipe or
// has ended, which poll skips, and answers whether the stream is live.
watchDescriptor(Runtime runtime, Value watched, long index, Value descriptor, Value block,
                long endedOffset) -> Value {
    let builder = runtime.builder;
    let entry = runtime.offsetPointer(watched, Pollfd.structBytes * index, "");
    let live = instructions.buildAnd(builder,
        instructions.buildICmpSGE(builder, descriptor, runtime.int32(0), ""),
        instructions.buildICmpEQ(builder, childprocess.loadField(runtime, block, endedOffset),
            runtime.int32(0), ""), "live");
    memory.buildStore(builder, instructions.buildSelect(builder, live, descriptor,
        runtime.int32(-1), ""), runtime.offsetPointer(entry, Pollfd.descriptor, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(PollEvent.input as ulong, false),
        runtime.offsetPointer(entry, Pollfd.events, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(0, false),
        runtime.offsetPointer(entry, Pollfd.revents, ""));
    return live;
}

// The bit for an entry whose returned events say a read would not wait.
reportedBit(Runtime runtime, Value watched, long index, long bit) -> Value {
    let builder = runtime.builder;
    let returned = memory.buildLoad(builder, runtime.int16Type, runtime.offsetPointer(watched,
        Pollfd.structBytes * index + Pollfd.revents, ""), "revents");
    return instructions.buildSelect(builder,
        instructions.buildICmpNE(builder, returned, runtime.int16Type.constInt(0, false), ""),
        runtime.int32(bit), runtime.int32(0), "bit");
}

// Registers a read filter on the stream's descriptor when the stream is a pipe that has not ended,
// naming the bit it answers with in the event's user data.
registerStream(Runtime runtime, RuntimeDefinition definition, Value changes, Value countSlot,
               Value descriptor, Value block, long endedOffset, long bit, string label) {
    let builder = runtime.builder;
    let addBlock = runtime.block(definition, "poll.register.{label}");
    let doneBlock = runtime.block(definition, "poll.registered.{label}");
    let live = instructions.buildAnd(builder,
        instructions.buildICmpSGE(builder, descriptor, runtime.int32(0), ""),
        instructions.buildICmpEQ(builder, childprocess.loadField(runtime, block, endedOffset),
            runtime.int32(0), ""), "live");
    instructions.buildCondBr(builder, live, addBlock, doneBlock);

    builder.positionAtEnd(addBlock);
    writeEvent(runtime, changes, countSlot,
        instructions.buildSExt(builder, descriptor, runtime.int64Type, ""), Kevent.readFilter, 0,
        bit);
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(doneBlock);
}

// Registers the child's exit note when the child has not been collected.
registerExit(Runtime runtime, RuntimeDefinition definition, Value changes, Value countSlot,
             Value block, Value reaped) {
    let builder = runtime.builder;
    let addBlock = runtime.block(definition, "poll.register.exit");
    let doneBlock = runtime.block(definition, "poll.registered.exit");
    instructions.buildCondBr(builder, reaped, doneBlock, addBlock);

    builder.positionAtEnd(addBlock);
    writeEvent(runtime, changes, countSlot, instructions.buildSExt(builder,
        childprocess.loadField(runtime, block, PosixChild.pid), runtime.int64Type, ""),
        Kevent.processFilter, Kevent.exitNote, PollReady.ended);
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(doneBlock);
}

// Writes one one-shot kevent at the next free slot of the change list and counts it.
writeEvent(Runtime runtime, Value changes, Value countSlot, Value ident, long filter,
           long filterFlags, long bit) {
    let builder = runtime.builder;
    let count = memory.buildLoad(builder, runtime.int32Type, countSlot, "count");
    let entry = memory.buildGEP(builder, runtime.int8Type, changes, [instructions.buildMul(builder,
        instructions.buildSExt(builder, count, runtime.int64Type, ""),
        runtime.int64(Kevent.structBytes), "")], "event");
    memory.buildStore(builder, ident, runtime.offsetPointer(entry, Kevent.ident, ""));
    memory.buildStore(builder, runtime.int16Type.constInt(filter as ulong, true),
        runtime.offsetPointer(entry, Kevent.filter, ""));
    memory.buildStore(builder, runtime.int16Type.constInt((Kevent.add | Kevent.oneShot) as ulong,
        false), runtime.offsetPointer(entry, Kevent.flags, ""));
    memory.buildStore(builder, runtime.int32(filterFlags),
        runtime.offsetPointer(entry, Kevent.filterFlags, ""));
    memory.buildStore(builder, runtime.int64(0), runtime.offsetPointer(entry, Kevent.data, ""));
    memory.buildStore(builder, runtime.int64(bit), runtime.offsetPointer(entry, Kevent.userData, ""));
    memory.buildStore(builder, instructions.buildAdd(builder, count, runtime.int32(1), ""),
        countSlot);
}

// Adds the bit a returned event carries to the mask. An error event carries an errno in its data,
// and one saying the child is gone counts as the child's end, since waitpid then answers at once.
collectEvent(Runtime runtime, RuntimeDefinition definition, Value events, long index, Value woken,
             Value readySlot, Value failureSlot, BasicBlock failedBlock) {
    let builder = runtime.builder;
    let readBlock = runtime.block(definition, "poll.event.{index}");
    let errorBlock = runtime.block(definition, "poll.event.{index}.error");
    let goneBlock = runtime.block(definition, "poll.event.{index}.gone");
    let bitBlock = runtime.block(definition, "poll.event.{index}.bit");
    let doneBlock = runtime.block(definition, "poll.event.{index}.done");
    instructions.buildCondBr(builder,
        instructions.buildICmpSLT(builder, runtime.int32(index), woken, ""), readBlock, doneBlock);

    builder.positionAtEnd(readBlock);
    let entry = runtime.offsetPointer(events, Kevent.structBytes * index, "");
    let flags = memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(entry, Kevent.flags, ""), "flags");
    let erred = instructions.buildICmpNE(builder, instructions.buildAnd(builder, flags,
        runtime.int16Type.constInt(Kevent.error as ulong, false), ""),
        runtime.int16Type.constInt(0, false), "erred");
    instructions.buildCondBr(builder, erred, errorBlock, bitBlock);

    builder.positionAtEnd(errorBlock);
    let reason = instructions.buildTrunc(builder, memory.buildLoad(builder, runtime.int64Type,
        runtime.offsetPointer(entry, Kevent.data, ""), "data"), runtime.int32Type, "reason");
    let filter = memory.buildLoad(builder, runtime.int16Type,
        runtime.offsetPointer(entry, Kevent.filter, ""), "filter");
    memory.buildStore(builder, reason, failureSlot);
    instructions.buildCondBr(builder, instructions.buildAnd(builder,
        instructions.buildICmpEQ(builder, filter,
            runtime.int16Type.constInt(Kevent.processFilter as ulong, true), ""),
        instructions.buildICmpEQ(builder, reason, runtime.int32(Errno.noSuchProcess), ""), ""),
        goneBlock, failedBlock);

    builder.positionAtEnd(goneBlock);
    memory.buildStore(builder, instructions.buildOr(builder,
        memory.buildLoad(builder, runtime.int32Type, readySlot, ""),
        runtime.int32(PollReady.ended), ""), readySlot);
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(bitBlock);
    let bit = instructions.buildTrunc(builder, memory.buildLoad(builder, runtime.int64Type,
        runtime.offsetPointer(entry, Kevent.userData, ""), "bit"), runtime.int32Type, "");
    memory.buildStore(builder, instructions.buildOr(builder,
        memory.buildLoad(builder, runtime.int32Type, readySlot, ""), bit, ""), readySlot);
    instructions.buildBr(builder, doneBlock);

    builder.positionAtEnd(doneBlock);
}
