// The edges out of a block: a return, an unconditional jump, a two-way branch, an integer switch,
// and the unreachable that ends a path which cannot fall through. Lowering merged every value
// through a slot, so no terminator here builds a phi.
import EirTerminator from eir.model;
import EirReturn from eir.model;
import EirJump from eir.model;
import EirBranch from eir.model;
import EirSwitch from eir.model;
import EirUnreachable from eir.model;
import @ens.llvm.instructions;
import ModuleEmitter from emit.context;
import EmissionFrame from emit.context;

public emitTerminator(ModuleEmitter emitter, EmissionFrame frame, EirTerminator terminator)
        -> string {
    switch (terminator) {
        is EirReturn returned -> {
            if (returned.value < 0) {
                let ignored = instructions.buildRetVoid(emitter.builder);
            } else {
                let ignored = instructions.buildRet(emitter.builder,
                    frame.value(returned.value));
            }
        },
        is EirJump jump -> {
            let ignored = instructions.buildBr(emitter.builder, frame.blockAt(jump.target));
        },
        is EirBranch branch -> {
            let ignored = instructions.buildCondBr(emitter.builder,
                frame.value(branch.condition), frame.blockAt(branch.thenTarget),
                frame.blockAt(branch.elseTarget));
        },
        is EirSwitch switched -> {
            let scrutineeType = emitter.mapType(frame.tempType(switched.value));
            let instruction = instructions.buildSwitch(emitter.builder,
                frame.value(switched.value), frame.blockAt(switched.defaultTarget),
                switched.caseValues.length as uint);
            for (long i = 0; i < switched.caseValues.length; i++) {
                instructions.addCase(instruction,
                    scrutineeType.constInt(switched.caseValues[i] as ulong, true),
                    frame.blockAt(switched.caseTargets[i]));
            }
        },
        is EirUnreachable ignored -> {
            let unused = instructions.buildUnreachable(emitter.builder);
        },
    }
    return "";
}
