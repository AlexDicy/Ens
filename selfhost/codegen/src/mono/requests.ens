// The instantiation requests one checked subtree makes, read straight from its module's sema side
// tables: every recorded type (which is where generic type references appear), every recorded
// binding's declared type, every resolved method's defining type, and every generic function call
// with its type arguments. The requests are raw - a template body's requests still mention its
// type parameters - so one scan per declaration serves every instance, each applying its own
// substitution.
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import Span from @ens.frontend.support.source;
import SemaResult from @ens.sema.result;
import Signature from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import List from @std.collections.list;

// One generic function call: the template's signature and the written type arguments, which may
// still mention the enclosing template's parameters.
public final class CallRequest {
    Signature calleeSignature;
    Type[] callArguments;
    Span callSpan;

    public constructor(this.calleeSignature, this.callArguments, this.callSpan);

    public callee() -> Signature {
        return this.calleeSignature;
    }

    public arguments() -> Type[] {
        return this.callArguments;
    }

    public span() -> Span {
        return this.callSpan;
    }
}

public final class BodyRequests {
    List<Type> requestedTypes;
    List<CallRequest> requestedCalls;

    public constructor() {
        this.requestedTypes = new List<Type>();
        this.requestedCalls = new List<CallRequest>();
    }

    public types() -> List<Type> {
        return this.requestedTypes;
    }

    public calls() -> List<CallRequest> {
        return this.requestedCalls;
    }
}

// Scans one subtree against its module's side tables. Pure: same tree and tables, same requests.
public collect(SemaResult result, SyntaxNode root) -> BodyRequests {
    let requests = new BodyRequests();
    scan(result, root, requests);
    return requests;
}

scan(SemaResult result, SyntaxNode node, BodyRequests requests) {
    let recorded = result.typeOf(node.green());
    if (recorded != null) {
        requests.types().push(recorded);
    }
    let binding = result.bindingOf(node.green());
    if (binding != null) {
        requests.types().push(binding.type());
    }
    let method = result.methodOf(node.green());
    if (method != null) {
        requests.types().push(method.definingType());
    }
    if (node is CallExpressionNode) {
        collectGenericCall(result, node, requests);
    }
    for (let child in node.childNodes()) {
        scan(result, child, requests);
    }
}

collectGenericCall(SemaResult result, CallExpressionNode call, BodyRequests requests) {
    let arguments = result.callTypeArgumentsOf(call.green());
    if (arguments == null) {
        return;
    }
    let callee = calleeSignatureOf(result, call);
    if (callee == null || !callee.isGeneric()) {
        return;
    }
    requests.calls().push(new CallRequest(callee, arguments, call.span()));
}

calleeSignatureOf(SemaResult result, CallExpressionNode call) -> Signature? {
    switch (call.callee()) {
        is IdentifierExpressionNode identifier -> {
            return result.callableOf(identifier.green());
        },
        is MemberExpressionNode member -> {
            return result.callableOf(member.green());
        },
        default -> {
            return null;
        },
    }
}
