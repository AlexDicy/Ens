// The type-argument assignment one generic instance lowers under. A body is checked once in its
// template, so applying the substitution is what turns every recorded type concrete. A record
// instance also maps the template's self type, which the template type itself never mentions. A
// generic method of a generic type is lowered under its own arguments with the instantiation's
// substitution enclosing them, which applies to everything the method's own does not.
import GreenNode from @ens.frontend.syntax.green;
import ArrayType from @ens.sema.model.types;
import DeclaredType from @ens.sema.model.types;
import FunctionType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeParamType from @ens.sema.model.types;
import ThrownListType from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import List from @std.collections.list;

public final class Substitution {
    GreenNode owningDeclaration;
    Type[] typeArguments;
    Type? selfTemplate;
    Type? selfInstance;
    Substitution? enclosingSubstitution;

    public constructor(this.owningDeclaration, this.typeArguments, this.selfTemplate, this.selfInstance,
                       this.enclosingSubstitution = null);

    public owner() -> GreenNode {
        return this.owningDeclaration;
    }

    public arguments() -> Type[] {
        return this.typeArguments;
    }

    public template() -> Type? {
        return this.selfTemplate;
    }

    public instance() -> Type? {
        return this.selfInstance;
    }

    public enclosing() -> Substitution? {
        return this.enclosingSubstitution;
    }

    // Every type argument the instance is lowered under, the enclosing substitution's first.
    public allArguments() -> Type[] {
        let all = new List<Type>();
        let enclosing = this.enclosingSubstitution;
        if (enclosing != null) {
            all.pushAll(List.of(enclosing.allArguments()));
        }
        all.pushAll(List.of(this.typeArguments));
        return all.toArray();
    }
}

// The substitution a record instantiation's members lower under.
public forInstantiation(InstantiationType instantiation) -> Substitution {
    let template = instantiation.template();
    return new Substitution(template.declaration(), instantiation.arguments(), template,
        instantiation);
}

// The substitution one generic function instance lowers under. The declaration is the green node
// sema interned the function's type parameters by. A generic method of a generic type is enclosed
// by the substitution of the instantiation it is called on.
public forFunction(GreenNode declaration, Type[] arguments, Substitution? enclosing = null)
        -> Substitution {
    return new Substitution(declaration, arguments, null, null, enclosing);
}

// The type with the substitution applied, recursing through optionals, arrays, and instantiation
// arguments. Every produced type is interned by the store, so equality stays identity. A type
// parameter of another owner passes through untouched, which is what a leftover open type looks
// like; the verifiers reject it if it ever reaches lowered code.
public apply(TypeStore store, Substitution? substitution, Type type) -> Type {
    if (substitution == null) {
        return type;
    }
    switch (type) {
        is TypeParamType parameter -> {
            Type[] arguments = substitution.arguments();
            if (parameter.owner() == substitution.owner() && parameter.index() < arguments.length) {
                let argument = arguments[parameter.index()];
                if (argument is ThrownListType) {
                    return argument.base();
                }
                return argument;
            }
            return apply(store, substitution.enclosing(), parameter);
        },
        is OptionalType optional -> {
            return store.optionalOf(apply(store, substitution, optional.inner()));
        },
        is ArrayType array -> {
            if (array.isBytes()) {
                return array;
            }
            return store.arrayOf(apply(store, substitution, array.element()));
        },
        is FunctionType functionType -> {
            return store.functionOf(
                applyAll(store, substitution, functionType.parameterTypes()),
                apply(store, substitution, functionType.returnType()),
                applyThrown(store, substitution, functionType.thrownTypes()),
                functionType.isShared());
        },
        is InstantiationType nested -> {
            Type[] arguments = nested.arguments();
            let substituted = new List<Type>();
            for (long i = 0; i < arguments.length; i++) {
                if (i == 1 && nested.template().isWrittenAsFunction()) {
                    substituted.push(applyList(store, substitution, arguments[i]));
                } else {
                    substituted.push(apply(store, substitution, arguments[i]));
                }
            }
            return store.instantiationOf(nested.template(), substituted.toArray());
        },
        is DeclaredType declared -> {
            let instance = substitution.instance();
            if (instance != null && declared == substitution.template()) {
                return instance;
            }
            return apply(store, substitution.enclosing(), declared);
        },
        default -> {
            return type;
        },
    }
}

// A throws list with the substitution applied, where a type parameter bound to a whole list gives
// every type in it, and each type is listed once.
public applyThrown(TypeStore store, Substitution? substitution, Type[] thrownList) -> Type[] {
    if (substitution == null) {
        return thrownList;
    }
    let substituted = new List<Type>();
    for (let entry in thrownList) {
        Type[] given = [apply(store, substitution, entry)];
        if (entry is TypeParamType) {
            let argument = boundArgument(substitution, entry);
            if (argument is ThrownListType) {
                given = argument.members();
            }
        }
        for (let member in given) {
            if (!substituted.contains(member)) {
                substituted.push(member);
            }
        }
    }
    return substituted.toArray();
}

// A type argument that stands for a throws list, with the substitution applied: a type parameter
// bound to a whole list gives that list, and a list gives each of its types substituted.
applyList(TypeStore store, Substitution substitution, Type listed) -> Type {
    if (listed is TypeParamType) {
        let argument = boundArgument(substitution, listed);
        if (argument != null) {
            return argument;
        }
    }
    if (listed is ThrownListType) {
        return store.thrownListOf(applyThrown(store, substitution, listed.members()), listed.base());
    }
    return apply(store, substitution, listed);
}

// What the substitution, or one enclosing it, binds the type parameter to, or null when none does.
boundArgument(Substitution? substitution, TypeParamType parameter) -> Type? {
    if (substitution == null) {
        return null;
    }
    if (parameter.owner() == substitution.owner()
            && parameter.index() < substitution.arguments().length) {
        return substitution.arguments()[parameter.index()];
    }
    return boundArgument(substitution.enclosing(), parameter);
}

public applyAll(TypeStore store, Substitution? substitution, Type[] typeList) -> Type[] {
    let substituted = new List<Type>();
    for (long i = 0; i < typeList.length; i++) {
        substituted.push(apply(store, substitution, typeList[i]));
    }
    return substituted.toArray();
}

// True when the type still mentions any type parameter, its own or a nested argument's.
public containsTypeParameter(Type type) -> bool {
    switch (type) {
        is TypeParamType parameter -> {
            return true;
        },
        is OptionalType optional -> {
            return containsTypeParameter(optional.inner());
        },
        is ArrayType array -> {
            return containsTypeParameter(array.element());
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                if (containsTypeParameter(parameter)) {
                    return true;
                }
            }
            return containsTypeParameter(functionType.returnType());
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                if (containsTypeParameter(argument)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}
