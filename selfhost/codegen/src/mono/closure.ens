// Monomorphization. Every concrete instantiation and generic function instance gets exactly one
// home module, the one declaring its template, so every other module names its symbols externally
// and emission order can never matter.
//
// What gets planned follows the requests the checked syntax makes, read from sema's side tables.
// A build plans from the bodies it lowers: the declarations' parameter defaults first, because any
// call may lower them, then each body as it is reached, and a type with what its members and field
// defaults name the first time a request names it. A build that lowers every body instead plans
// from the whole of every file and every template body. Each planned function and instantiation
// joins the index the moment it is planned.
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import SyntaxNode from @ens.frontend.syntax.node;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import ModuleContext from @ens.sema.context;
import ProgramAnalysis from @ens.sema.pipeline;
import SemaResult from @ens.sema.result;
import FileDiagnostic from @ens.sema.support.diagnostics;
import @ens.sema.model.hierarchy;
import Method from @ens.sema.model.typemembers;
import Signature from @ens.sema.model.typemembers;
import @ens.sema.model.typemembers;
import @ens.sema.model.typenames;
import ArrayType from @ens.sema.model.types;
import ClassType from @ens.sema.model.types;
import DeclaredType from @ens.sema.model.types;
import FunctionType from @ens.sema.model.types;
import InstantiationType from @ens.sema.model.types;
import InterfaceType from @ens.sema.model.types;
import OptionalType from @ens.sema.model.types;
import StructType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import @ens.sema.model.types;
import BodyRequests from mono.requests;
import CallRequest from mono.requests;
import mono.requests;
import Substitution from mono.substitution;
import mono.substitution;
import FunctionInfo from lower.index;
import ModuleFunctions from lower.index;
import ProgramIndex from lower.index;
import RecordInfo from lower.index;
import lower.index;
import lower.symbols;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// One planned instantiation and the module that owns its definition.
public final class PlannedInstantiation {
    InstantiationType plannedType;
    ModuleContext homeContext;
    RecordInfo? templateRecord;

    public constructor(this.plannedType, this.homeContext, this.templateRecord);

    public type() -> InstantiationType {
        return this.plannedType;
    }

    public home() -> ModuleContext {
        return this.homeContext;
    }

    public record() -> RecordInfo? {
        return this.templateRecord;
    }
}

// One generic function instance: the template it specializes, the concrete arguments, and the
// entry the home module lowers.
public final class PlannedFunctionInstance {
    Signature templateSignature;
    Type[] instanceArguments;
    FunctionInfo instanceInfo;

    public constructor(this.templateSignature, this.instanceArguments, this.instanceInfo);

    public template() -> Signature {
        return this.templateSignature;
    }

    public arguments() -> Type[] {
        return this.instanceArguments;
    }

    public info() -> FunctionInfo {
        return this.instanceInfo;
    }
}

// Everything planned so far, each list in the order it was planned.
public final class MonoPlan {
    List<FileDiagnostic> planProblems;
    List<PlannedInstantiation> plannedInstantiations;
    List<FunctionInfo> plannedMembers;
    List<PlannedFunctionInstance> plannedFunctions;

    public constructor() {
        this.planProblems = new List<FileDiagnostic>();
        this.plannedInstantiations = new List<PlannedInstantiation>();
        this.plannedMembers = new List<FunctionInfo>();
        this.plannedFunctions = new List<PlannedFunctionInstance>();
    }

    public problems() -> List<FileDiagnostic> {
        return this.planProblems;
    }

    public instantiations() -> List<PlannedInstantiation> {
        return this.plannedInstantiations;
    }

    // The methods of every planned instantiation, in planning order.
    public members() -> List<FunctionInfo> {
        return this.plannedMembers;
    }

    public functions() -> List<PlannedFunctionInstance> {
        return this.plannedFunctions;
    }
}

// Plans everything every file and every template body requests, for a build that lowers every
// body, and registers it into the index.
public close(ProgramAnalysis analysis, ProgramIndex index) -> MonoPlan {
    let planner = new Monomorphizer(analysis, index, true);
    planner.planDeclarations();
    return planner.plan();
}

// A generic function instance under construction is identified by template and arguments.
class InstanceKey {
    Signature keyTemplate;
    Type[] keyArguments;

    protected constructor(Signature template, Type[] arguments) {
        this.keyTemplate = template;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyTemplate.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(InstanceKey other) -> bool {
        if (this.keyTemplate != other.keyTemplate) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

// The planner. It keeps what it has planned and the depth each planned body sits at, so asking it
// for a body or a type a second time plans nothing new.
public final class Monomorphizer {
    ProgramAnalysis analysis;
    ProgramIndex index;
    TypeStore store;
    bool harvestsEveryBody;
    MonoPlan record;

    Map<string, ModuleContext> contextsByPath;
    Map<ModuleContext, ModuleFunctions> modulesByContext;

    Set<InstantiationType> seenInstantiations;
    Set<DeclaredType> seenDeclared;
    Set<InstanceKey> seenFunctions;
    Set<GreenNode> reportedOverflows;
    Map<GreenNode, BodyRequests> requestCache;
    Map<string, long> depthBySymbol;
    Set<string> plannedBodies;

    // `harvestsEveryBody` plans from the whole of every file and every template body at once, for
    // a build that lowers every body. Without it, a body is planned when `planBody` is asked for it.
    public constructor(ProgramAnalysis analysis, ProgramIndex index, bool harvestsEveryBody) {
        this.analysis = analysis;
        this.index = index;
        this.store = analysis.store();
        this.harvestsEveryBody = harvestsEveryBody;
        this.record = new MonoPlan();
        this.contextsByPath = new Map<string, ModuleContext>();
        this.modulesByContext = new Map<ModuleContext, ModuleFunctions>();
        this.seenInstantiations = new Set<InstantiationType>();
        this.seenDeclared = new Set<DeclaredType>();
        this.seenFunctions = new Set<InstanceKey>();
        this.reportedOverflows = new Set<GreenNode>();
        this.requestCache = new Map<GreenNode, BodyRequests>();
        this.depthBySymbol = new Map<string, long>();
        this.plannedBodies = new Set<string>();
        let contexts = analysis.contexts();
        for (long i = 0; i < contexts.length(); i++) {
            this.contextsByPath.set(contexts.get(i).module().canonicalPath(), contexts.get(i));
        }
        let modules = index.modules();
        for (long m = 0; m < modules.length(); m++) {
            this.modulesByContext.set(modules.get(m).context(), modules.get(m));
        }
    }

    public plan() -> MonoPlan {
        return this.record;
    }

    // Plans what the declarations request before any body is lowered: every parameter default of a
    // declared function, since a call anywhere that leaves the parameter out lowers it. A build that
    // lowers every body plans the whole of every file here instead.
    public planDeclarations() {
        if (this.harvestsEveryBody) {
            let contexts = this.analysis.contexts();
            for (long i = 0; i < contexts.length(); i++) {
                let root = contexts.get(i).root();
                if (root != null) {
                    this.harvest(this.requestsFor(contexts.get(i).result(), root), null, 0);
                }
            }
            return;
        }
        let modules = this.index.modules();
        for (long m = 0; m < modules.length(); m++) {
            let functions = modules.get(m).functions();
            long declared = functions.length();
            for (long f = 0; f < declared; f++) {
                let info = functions.get(f);
                if (info.substitution() == null) {
                    this.harvestDefaults(info, 0);
                }
            }
        }
    }

    // Plans what one function's own body requests, under the substitution it is lowered beneath.
    public planBody(FunctionInfo info) {
        if (this.harvestsEveryBody || !this.plannedBodies.add(info.symbol())) {
            return;
        }
        let body = bodyNodeOf(info);
        if (body == null) {
            return;
        }
        long depth = this.depthBySymbol.get(info.symbol()) ?? 0;
        this.harvest(this.requestsFor(info.context().result(), body), info.substitution(),
            depth + 1);
    }

    // Plans every concrete instantiation a type mentions, including the arguments of an
    // instantiation that is itself still open.
    public requestType(Type type) {
        this.requestTypeAt(type, 0);
    }

    requestsFor(SemaResult result, SyntaxNode root) -> BodyRequests {
        let cached = this.requestCache.get(root.green());
        if (cached != null) {
            return cached;
        }
        let scanned = requests.collect(result, root);
        this.requestCache.set(root.green(), scanned);
        return scanned;
    }

    // Applies the scan's raw requests under one substitution. With none - concrete code - a
    // request that still mentions a type parameter belongs to a template body and is served per
    // instance instead.
    harvest(BodyRequests found, Substitution? active, long depth) {
        let mentioned = found.types();
        for (long i = 0; i < mentioned.length(); i++) {
            this.requestTypeAt(substitution.apply(this.store, active, mentioned.get(i)), depth);
        }
        let calls = found.calls();
        for (long i = 0; i < calls.length(); i++) {
            let call = calls.get(i);
            Type[] arguments = substitution.applyAll(this.store, active, call.arguments());
            bool open = false;
            for (let argument in arguments) {
                if (substitution.containsTypeParameter(argument)) {
                    open = true;
                }
            }
            if (open) {
                continue;
            }
            let method = call.method();
            if (method != null) {
                this.requestMethodInstance(method, arguments, active, depth);
                continue;
            }
            this.requestFunction(call, arguments, depth);
        }
    }

    // A declared struct, class or interface the first time a request names it: the types its
    // members' signatures and its fields name, its base and interfaces, and the requests of its
    // field defaults, which is what lowering a use of it may read, as an instantiation's members
    // are. A generic declaration is planned per instantiation instead.
    requestDeclared(DeclaredType declared, long depth) {
        if (declared.isGeneric() || !this.seenDeclared.add(declared)) {
            return;
        }
        for (let methodList in [typemembers.methodsOf(declared),
                typemembers.staticMethodsOf(declared)]) {
            if (methodList != null) {
                for (let method in methodList) {
                    this.requestSignature(method.signature(), null, depth + 1);
                }
            }
        }
        let fields = typemembers.fieldsOf(declared);
        if (fields != null) {
            for (let field in fields) {
                this.requestTypeAt(field.type(), depth + 1);
            }
        }
        let base = hierarchy.baseOf(declared);
        if (base != null) {
            this.requestTypeAt(base, depth + 1);
        }
        for (let implemented in hierarchy.interfacesOf(declared)) {
            this.requestTypeAt(implemented, depth + 1);
        }
        let declaredRecord = this.index.recordFor(declared);
        if (declaredRecord != null) {
            this.harvestFields(declaredRecord.context().result(), declaredRecord.members(), null,
                depth + 1);
        }
    }

    // The types a signature names, under the substitution it is lowered beneath, since a call to it
    // lowers with its parameter and result types whatever the calling body itself names.
    requestSignature(Signature signature, Substitution? active, long depth) {
        for (let parameter in signature.parameters()) {
            this.requestTypeAt(substitution.apply(this.store, active, parameter.type()), depth);
        }
        this.requestTypeAt(substitution.apply(this.store, active, signature.returnType()), depth);
    }

    // The parameter defaults of one planned function, which a call leaving a parameter out lowers.
    harvestDefaults(FunctionInfo info, long depth) {
        let declaration = info.declaration();
        if (declaration == null) {
            return;
        }
        this.harvest(this.requestsFor(info.context().result(), declaration.parameters()),
            info.substitution(), depth);
    }

    // The field declarations of one record, whose defaults every construction of it lowers.
    harvestFields(SemaResult result, MemberListNode members, Substitution? active, long depth) {
        for (long i = 0; i < members.membersCount(); i++) {
            let member = members.members(i);
            if (member is FieldDeclarationNode) {
                this.harvest(this.requestsFor(result, member), active, depth);
            }
        }
    }

    requestTypeAt(Type type, long depth) {
        switch (type) {
            is OptionalType optional -> {
                this.requestTypeAt(optional.inner(), depth);
            },
            is ArrayType array -> {
                this.requestTypeAt(array.element(), depth);
            },
            is FunctionType functionType -> {
                for (let parameter in functionType.parameterTypes()) {
                    this.requestTypeAt(parameter, depth);
                }
                this.requestTypeAt(functionType.returnType(), depth);
            },
            is InstantiationType instantiation -> {
                if (!substitution.containsTypeParameter(instantiation)) {
                    this.requestInstantiation(instantiation, depth);
                }
                for (let argument in instantiation.arguments()) {
                    this.requestTypeAt(argument, depth);
                }
            },
            is ClassType declared -> {
                this.requestDeclared(declared, depth);
            },
            is StructType declared -> {
                this.requestDeclared(declared, depth);
            },
            is InterfaceType declared -> {
                this.requestDeclared(declared, depth);
            },
            default -> { },
        }
    }

    requestInstantiation(InstantiationType instantiation, long depth) {
        if (!this.seenInstantiations.add(instantiation)) {
            return;
        }
        let template = instantiation.template();
        if (depth > Limits.cascade) {
            this.reportOverflow(template.declaration(), template.name(), template.filePath(),
                source.makeSpan(0, 0));
            return;
        }
        let home = this.contextsByPath.get(template.modulePath());
        if (home == null) {
            this.record.problems().push(new FileDiagnostic(template.filePath(),
                "Internal: the instantiation '{typenames.display(instantiation)}' has no home "
                + "module: '{template.modulePath()}' is not part of the program.",
                source.makeSpan(0, 0)));
            return;
        }
        RecordInfo? templateRecord = this.index.recordFor(template);
        this.record.instantiations().push(new PlannedInstantiation(instantiation, home,
            templateRecord));
        let homeFunctions = this.modulesByContext.get(home);
        if (homeFunctions != null) {
            homeFunctions.instantiations().push(instantiation);
        }
        if (templateRecord != null) {
            this.index.registerRecord(instantiation, templateRecord);
        }
        if (template is InterfaceType) {
            this.planMemberList(instantiation, template.methods(), instantiation.methods(), home,
                null, depth, true);
            let extended = hierarchy.baseOf(instantiation);
            if (extended != null) {
                this.requestTypeAt(extended, depth + 1);
            }
            return;
        }
        if (template is ClassType) {
            this.planRecordInstantiation(instantiation, template.methods(),
                template.staticMethods(), home, templateRecord, depth);
        } else if (template is StructType) {
            this.planRecordInstantiation(instantiation, template.methods(),
                template.staticMethods(), home, templateRecord, depth);
        }
        let base = hierarchy.baseOf(instantiation);
        if (base != null) {
            this.requestTypeAt(base, depth + 1);
        }
        for (let implemented in hierarchy.interfacesOf(instantiation)) {
            this.requestTypeAt(implemented, depth + 1);
        }
        let fields = typemembers.fieldsOf(instantiation);
        if (fields != null) {
            for (long i = 0; i < fields.length(); i++) {
                this.requestTypeAt(fields.get(i).type(), depth + 1);
            }
        }
    }

    planRecordInstantiation(InstantiationType instantiation, List<Method> templateMethods,
                            List<Method> templateStatics, ModuleContext home,
                            RecordInfo? templateRecord, long depth) {
        if (templateRecord == null) {
            this.record.problems().push(new FileDiagnostic(
                instantiation.template().filePath(),
                "Internal: the template of '{typenames.display(instantiation)}' has no indexed "
                + "member list.", source.makeSpan(0, 0)));
            return;
        }
        this.planMemberList(instantiation, templateMethods, instantiation.methods(), home,
            templateRecord, depth, true);
        this.planMemberList(instantiation, templateStatics, instantiation.staticMethods(),
            home, templateRecord, depth, false);
        let active = substitution.forInstantiation(instantiation);
        let homeFunctions = this.modulesByContext.get(home);
        if (homeFunctions != null) {
            index.indexRecordLambdas(this.index, this.store, homeFunctions,
                templateRecord.members(), instantiation.template().name(), active);
        }
        if (this.harvestsEveryBody) {
            this.harvestRecordBodies(instantiation, templateRecord, depth);
            return;
        }
        this.harvestFields(templateRecord.context().result(), templateRecord.members(), active,
            depth + 1);
    }

    // The template bodies' requests, applied under this instantiation's substitution. A template
    // with conditional members harvests member by member, skipping the bodies of the members
    // this instantiation excludes; everything else harvests the member list in one pass.
    harvestRecordBodies(InstantiationType instantiation, RecordInfo templateRecord, long depth) {
        let active = substitution.forInstantiation(instantiation);
        let result = templateRecord.context().result();
        if (!hierarchy.hasConditionalMembers(instantiation.template())) {
            this.harvest(this.requestsFor(result, templateRecord.members()), active, depth + 1);
            return;
        }
        let membersNode = templateRecord.members();
        for (long i = 0; i < membersNode.membersCount(); i++) {
            switch (membersNode.members(i)) {
                is FunctionDeclarationNode declaration -> {
                    let declared = this.memberDeclaredBy(instantiation, declaration.green());
                    if (declared == null || hierarchy.memberExistsOn(this.store, declared)) {
                        this.harvest(this.requestsFor(result, declaration), active, depth + 1);
                    }
                },
                is FieldDeclarationNode field -> {
                    this.harvest(this.requestsFor(result, field), active, depth + 1);
                },
                default -> { },
            }
        }
    }

    // The instantiation's member declared by this green node, among methods and statics alike.
    memberDeclaredBy(InstantiationType instantiation, GreenNode declaration) -> Method? {
        let methods = instantiation.methods();
        for (long i = 0; i < methods.length(); i++) {
            if (methods.get(i).signature().declaration() == declaration) {
                return methods.get(i);
            }
        }
        let statics = instantiation.staticMethods();
        for (long i = 0; i < statics.length(); i++) {
            if (statics.get(i).signature().declaration() == declaration) {
                return statics.get(i);
            }
        }
        return null;
    }

    // One parallel member list of an instantiation, each taking its body from the matching
    // template declaration. The instance methods run over the instantiation, so their entries carry
    // it as the receiver; the statics take none and lower like the instances of a generic free
    // function. Passing no record plans an interface's methods, which have no bodies and serve call
    // resolution only.
    planMemberList(InstantiationType instantiation, List<Method> templateMethods,
                   List<Method> instanceMethods, ModuleContext home, RecordInfo? templateRecord,
                   long depth, bool withReceiver) {
        Map<GreenNode, FunctionDeclarationNode> declarations = new Map<GreenNode, FunctionDeclarationNode>();
        if (templateRecord != null) {
            declarations = index.redMemberDeclarations(templateRecord.members());
        }
        let active = substitution.forInstantiation(instantiation);
        for (long i = 0; i < instanceMethods.length(); i++) {
            let method = instanceMethods.get(i);
            if (i >= templateMethods.length()) {
                break;
            }
            if (!hierarchy.memberExistsOn(this.store, method)) {
                continue;
            }
            let templateMethod = templateMethods.get(i);
            let signature = method.signature();
            FunctionDeclarationNode? declaration = null;
            let declarationGreen = signature.declaration();
            if (declarationGreen != null) {
                declaration = declarations.get(declarationGreen);
            }
            Type? receiverType = null;
            if (withReceiver) {
                receiverType = instantiation;
            }
            string symbol = symbols.instantiationMethodLinkName(instantiation, method.name(),
                templateMethod.signature(),
                overloadedIn(instanceMethods, method.name()));
            let info = new FunctionInfo(home, signature, method.visibility(), false, null,
                receiverType, method, declaration, symbol, active);
            this.index.register(signature, info);
            if (signature.isGeneric()) {
                continue;
            }
            this.record.members().push(info);
            bool lowerable = method.isConstructor()
                || (declaration != null && declaration.body() != null);
            if (lowerable) {
                this.addPlannedFunction(home, info, depth);
            }
            for (let parameter in signature.parameters()) {
                this.requestTypeAt(parameter.type(), depth + 1);
            }
            this.requestTypeAt(signature.returnType(), depth + 1);
        }
    }

    requestFunction(CallRequest call, Type[] arguments, long depth) {
        if (!this.seenFunctions.add(new InstanceKey(call.callee(), arguments))) {
            return;
        }
        let templateInfo = this.index.infoFor(call.callee());
        if (templateInfo == null || templateInfo.isBuiltin() || templateInfo.isExternal()) {
            return;
        }
        let declaration = templateInfo.declaration();
        let owner = call.callee().declaration();
        if (declaration == null || owner == null) {
            this.record.problems().push(new FileDiagnostic(
                templateInfo.context().module().filePath(),
                "Internal: the generic function '{call.callee().name()}' has no declaration "
                + "to instantiate.", call.callee().nameSpan()));
            return;
        }
        if (depth > Limits.cascade) {
            this.reportOverflow(owner, call.callee().name(),
                templateInfo.context().module().filePath(), call.callee().nameSpan());
            return;
        }
        let home = templateInfo.context();
        string symbol = symbols.genericInstanceLinkName(home.module().canonicalPath(),
            call.callee().name(), arguments);
        let active = substitution.forFunction(owner, arguments);
        let info = new FunctionInfo(home, call.callee(), templateInfo.visibility(), false,
            null, null, null, declaration, symbol, active);
        this.record.functions().push(new PlannedFunctionInstance(call.callee(), arguments,
            info));
        this.index.registerFunctionInstance(call.callee(), arguments, info);
        this.addPlannedFunction(home, info, depth);
        if (this.harvestsEveryBody) {
            this.harvest(this.requestsFor(home.result(), declaration), active, depth + 1);
        }
    }

    // One generic method instance: the method 'recorded' names on its declaring type once the active
    // substitution makes that type concrete, at these concrete type arguments. Its body lowers under
    // its own arguments, enclosed by the substitution of the instantiation that declares it.
    requestMethodInstance(Method recorded, Type[] arguments, Substitution? active, long depth) {
        Type declaring = substitution.apply(this.store, active, recorded.definingType());
        if (substitution.containsTypeParameter(declaring)) {
            return;
        }
        this.requestTypeAt(declaring, depth);
        let method = concreteMethodOn(declaring, recorded);
        let owner = recorded.signature().declaration();
        if (method == null || owner == null) {
            let authority = types.authorityOf(declaring);
            this.record.problems().push(new FileDiagnostic(authority?.filePath() ?? "",
                "Internal: the generic method '{recorded.name()}' has no concrete method on "
                + "'{typenames.display(declaring)}' to instantiate.", recorded.signature().nameSpan()));
            return;
        }
        if (!this.seenFunctions.add(new InstanceKey(method.signature(), arguments))) {
            return;
        }
        let templateInfo = this.index.infoFor(method.signature());
        if (templateInfo == null) {
            return;
        }
        let declaration = templateInfo.declaration();
        if (declaration == null) {
            return;
        }
        if (depth > Limits.cascade) {
            this.reportOverflow(owner, recorded.name(),
                templateInfo.context().module().filePath(), recorded.signature().nameSpan());
            return;
        }
        let home = templateInfo.context();
        let instanceSubstitution = substitution.forFunction(owner, arguments,
            templateInfo.substitution());
        let info = new FunctionInfo(home, method.signature(), templateInfo.visibility(), false,
            null, templateInfo.receiverType(), method, declaration,
            templateInfo.symbol() + symbols.instanceSuffix(arguments), instanceSubstitution);
        this.record.functions().push(new PlannedFunctionInstance(method.signature(), arguments,
            info));
        this.index.registerFunctionInstance(method.signature(), arguments, info);
        this.addPlannedFunction(home, info, depth);
        if (this.harvestsEveryBody) {
            this.harvest(this.requestsFor(home.result(), declaration), instanceSubstitution,
                depth + 1);
        }
    }

    // Adds one planned function to its home module's list with the lambdas its body writes, and
    // plans its parameter defaults, which a call leaving a parameter out lowers wherever it is.
    addPlannedFunction(ModuleContext home, FunctionInfo info, long depth) {
        let homeFunctions = this.modulesByContext.get(home);
        if (homeFunctions == null) {
            return;
        }
        this.index.addFunction(homeFunctions, info);
        this.depthBySymbol.set(info.symbol(), depth);
        index.indexFunctionLambdas(this.index, this.store, homeFunctions, info);
        if (!this.harvestsEveryBody) {
            this.harvestDefaults(info, depth + 1);
        }
    }

    reportOverflow(GreenNode declaration, string name, string filePath, Span span) {
        if (!this.reportedOverflows.add(declaration)) {
            return;
        }
        this.record.problems().push(new FileDiagnostic(filePath,
            "Internal: the instantiations of '{name}' nest past the cascade limit, and sema refuses "
            + "every chain of generic uses that grows without end.", span));
    }
}

// The syntax one function lowers: its declaration, its test, its lambda, or a lazy const's
// initializer. Null for a function with nothing written, such as an implicit constructor.
bodyNodeOf(FunctionInfo info) -> SyntaxNode? {
    let declaration = info.declaration();
    if (declaration != null) {
        return declaration;
    }
    let test = info.testDeclaration();
    if (test != null) {
        return test;
    }
    let lambda = info.lambdaDeclaration();
    if (lambda != null) {
        return lambda;
    }
    let lazyValue = info.lazyValue();
    if (lazyValue != null) {
        return lazyValue.initializer();
    }
    return null;
}


// The method of the concrete type 'declaring' that 'recorded' names. A template's members and
// every instantiation's fill in the same order, so the position carries over.
concreteMethodOn(Type declaring, Method recorded) -> Method? {
    if (declaring == recorded.definingType()) {
        return recorded;
    }
    for (let lists in [[typemembers.methodsOf(recorded.definingType()), typemembers.methodsOf(declaring)],
            [typemembers.staticMethodsOf(recorded.definingType()),
                typemembers.staticMethodsOf(declaring)]]) {
        let recordedList = lists[0];
        let concreteList = lists[1];
        if (recordedList == null || concreteList == null) {
            continue;
        }
        for (long i = 0; i < recordedList.length() && i < concreteList.length(); i++) {
            if (recordedList.get(i) == recorded) {
                return concreteList.get(i);
            }
        }
    }
    return null;
}

overloadedIn(List<Method> methods, string name) -> bool {
    long seen = 0;
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).name() == name) {
            seen++;
        }
    }
    return seen > 1;
}

final class Limits {
    // A chain that only ever deepens is a polymorphically recursive generic, which can never
    // finish instantiating, so planning stops here.
    protected static const long cascade = 200;
}
