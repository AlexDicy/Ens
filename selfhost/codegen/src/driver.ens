// The code-generation driver: from a checked ProgramAnalysis to one native object file per Ens
// module. The optimized output is re-verified before emission whatever the level, so an
// unoptimized build is never an unchecked one, and a program that fails to lower writes no object
// files at all.
import ProgramAnalysis from @ens.sema.pipeline;
import StandardLibrary from @ens.sema.program.implicit;
import FileDiagnostic from @ens.sema.support.diagnostics;
import PrimitiveType from @ens.sema.model.types;
import PrimitiveKind from @ens.sema.model.types;
import Signature from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import @ens.sema.model.types;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import EirFunction from eir.model;
import eir.verify;
import eir.ownership;
import eir.storage;
import eir.takes;
import DispatchTables from layout.vtables;
import DescriptorPlans from layout.descriptors;
import layout.descriptors;
import layout.vtables;
import ProgramIndex from lower.index;
import ModuleFunctions from lower.index;
import FunctionInfo from lower.index;
import MonoPlan from mono.closure;
import mono.closure;
import CodegenSettings from settings;
import PassContext from passes.optimize;
import passes.optimize;
import lower.arraycontent;
import lower.destructors;
import lower.index;
import lower.lower;
import lower.symbols;
import support.primitives;
import EntryPoint from emit.emit;
import emit.emit;
import List from @std.collections.list;
import Map from @std.collections.map;

export final class EmitResult {
    List<string> objectFiles;
    FileDiagnostic[] emitDiagnostics;
    string[] arcAccount;

    public constructor(this.objectFiles, this.emitDiagnostics, string[] explanation = []) {
        this.arcAccount = explanation;
    }

    export objects() -> List<string> {
        return this.objectFiles;
    }

    export diagnostics() -> FileDiagnostic[] {
        return this.emitDiagnostics;
    }

    // What the optimization pipeline elided and why, when the settings asked for it; nothing
    // otherwise.
    export arcExplanation() -> string[] {
        return this.arcAccount;
    }

    export succeeded() -> bool {
        return this.emitDiagnostics.length == 0;
    }
}

// One module's lowered functions, its entry wrapper, and the problems its own stage found,
// waiting for the whole program to lower before anything is written. Every stage produces one of
// these per module without reading any other module's, so the modules of a stage are independent
// work and the stage folds their problems once they are all done.
final class LoweredModule {
    protected ModuleFunctions definitions;
    protected List<EirFunction> functions;
    protected EntryPoint? entry;
    protected List<FileDiagnostic> problems;

    protected constructor(this.definitions, this.functions, this.entry, this.problems);
}

// The objects one emission run wrote, up to the first module that failed to emit.
final class EmittedObjects {
    protected List<string> paths;
    protected List<FileDiagnostic> problems;

    protected constructor(this.paths, this.problems);
}

// Compiles the analyzed program into object files under outputFolder, one per module that
// defines functions, named filePrefix plus the sanitized module path. The analysis must be
// clean; codegen diagnostics after a clean analysis describe unsupported constructs or bugs.
export emitProgram(ProgramAnalysis analysis, string outputFolder, string filePrefix,
                   CodegenSettings settings) -> EmitResult {
    let programIndex = index.buildIndex(analysis);
    let plan = closure.close(analysis, programIndex);
    if (plan.problems().length() > 0) {
        return new EmitResult(new List<string>(), plan.problems().toArray());
    }
    closure.apply(plan, programIndex);
    index.indexLambdas(programIndex, analysis.store());
    let tables = vtables.assignSlots(programIndex);
    let plans = descriptors.planProgram(programIndex, tables);
    let lowered = lowerModules(programIndex, tables, analysis);
    let loweringProblems = gathered(lowered);
    if (loweringProblems.length() > 0) {
        return new EmitResult(new List<string>(), loweringProblems.toArray());
    }
    let collisions = symbolCollisions(lowered);
    if (collisions.length() > 0) {
        return new EmitResult(new List<string>(), collisions.toArray());
    }
    let pipeline = optimizeModules(lowered, plans, settings);
    let optimizationProblems = gathered(pipeline.modules);
    if (optimizationProblems.length() > 0) {
        return new EmitResult(new List<string>(), optimizationProblems.toArray());
    }
    let stackFrame = analysis.store().findDeclared(StandardLibrary.coreModule, "StackFrame");
    let errorClass = analysis.store().findDeclared(StandardLibrary.coreModule, "Error");
    let emitted = emitModules(pipeline.modules, plans, stackFrame, errorClass, outputFolder,
        filePrefix, settings);
    return new EmitResult(emitted.paths, emitted.problems.toArray(), pipeline.account.toArray());
}

// Every defined function must own its linker symbol program-wide: the passes key their
// cross-function facts by symbol, so a shared symbol would merge two functions' facts or
// rewrite one function's ABI from another's plan. Lowering qualifies every symbol by its
// defining module, so a collision here is a compiler bug, not a program error.
symbolCollisions(List<LoweredModule> lowered) -> List<FileDiagnostic> {
    let problems = new List<FileDiagnostic>();
    let owners = new Map<string, string>();
    for (long m = 0; m < lowered.length(); m++) {
        let unit = lowered.get(m);
        string filePath = unit.definitions.context().module().filePath();
        for (long f = 0; f < unit.functions.length(); f++) {
            string symbol = unit.functions.get(f).symbol();
            let existing = owners.get(symbol);
            if (existing == null) {
                owners.set(symbol, filePath);
            } else {
                problems.push(new FileDiagnostic(filePath, "Internal: two lowered functions "
                    + "share the linker symbol '{symbol}' (also defined in {existing}); every "
                    + "defined function must have a unique symbol.", source.makeSpan(0, 0)));
            }
        }
    }
    return problems;
}

// Every module's problems in module order, which is the order the stages ran in.
gathered(List<LoweredModule> modules) -> List<FileDiagnostic> {
    let problems = new List<FileDiagnostic>();
    for (long m = 0; m < modules.length(); m++) {
        for (long p = 0; p < modules.get(m).problems.length(); p++) {
            problems.push(modules.get(m).problems.get(p));
        }
    }
    return problems;
}

// Lowers and verifies every module that defines functions, each on its own, so a program with
// problems in several modules reports all of them.
lowerModules(ProgramIndex programIndex, DispatchTables tables,
             ProgramAnalysis analysis) -> List<LoweredModule> {
    let lowered = new List<LoweredModule>();
    let modules = programIndex.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        if (moduleFunctions.functions().length() == 0
                && moduleFunctions.classes().length() == 0
                && moduleFunctions.interfaces().length() == 0
                && moduleFunctions.instantiations().length() == 0) {
            continue;
        }
        lowered.push(lowerModule(moduleFunctions, programIndex, tables, analysis));
    }
    return lowered;
}

// One module's lowered functions: every function it defines, the destructor of every class and
// class instantiation it owns, and the entry wrapper when the program's entry lives here.
lowerModule(ModuleFunctions moduleFunctions, ProgramIndex programIndex, DispatchTables tables,
            ProgramAnalysis analysis) -> LoweredModule {
    string filePath = moduleFunctions.context().module().filePath();
    let functions = new List<EirFunction>();
    let problems = new List<FileDiagnostic>();
    // One plan per module, so each element type gets exactly one equals, hash, and text
    // function in the object file.
    let contentPlan = new arraycontent.ArrayContentPlan(programIndex, analysis.store(),
        moduleFunctions.context().module().canonicalPath());
    for (long f = 0; f < moduleFunctions.functions().length(); f++) {
        let info = moduleFunctions.functions().get(f);
        let outcome = lower.lowerFunction(info, programIndex, tables, analysis.store(),
            contentPlan);
        appendAll(problems, outcome.diagnostics());
        let function = outcome.function();
        if (function == null) {
            continue;
        }
        appendAll(problems, checkLowered(function, filePath, info.signature().nameSpan()));
        functions.push(function);
        // A closure with captures carries a destructor of its own in every object it makes, so
        // the module that lowers the lambda's body defines it too.
        let released = destructors.synthesizeClosure(info, analysis.store());
        if (released != null) {
            appendAll(problems, checkLowered(released, filePath, info.signature().nameSpan()));
            functions.push(released);
        }
    }
    for (let contentFunction in contentPlan.builtFunctions()) {
        appendAll(problems, checkLowered(contentFunction, filePath, source.makeSpan(0, 0)));
        functions.push(contentFunction);
    }
    for (long c = 0; c < moduleFunctions.classes().length(); c++) {
        let finalizer = destructors.synthesize(moduleFunctions.classes().get(c), programIndex,
            analysis.store());
        if (finalizer == null) {
            continue;
        }
        appendAll(problems, checkLowered(finalizer, filePath, source.makeSpan(0, 0)));
        functions.push(finalizer);
    }
    for (long c = 0; c < moduleFunctions.instantiations().length(); c++) {
        let instantiation = moduleFunctions.instantiations().get(c);
        if (primitives.classOf(instantiation) == null) {
            continue;
        }
        let finalizer = destructors.synthesize(instantiation, programIndex, analysis.store());
        if (finalizer == null) {
            continue;
        }
        appendAll(problems, checkLowered(finalizer, filePath, source.makeSpan(0, 0)));
        functions.push(finalizer);
    }
    EntryPoint? entry = null;
    let candidate = entryFunctionOf(programIndex, moduleFunctions);
    if (candidate != null) {
        let signature = candidate.signature();
        string rejected = unsupportedEntryShape(signature);
        if (rejected.length > 0) {
            problems.push(new FileDiagnostic(filePath,
                "Internal: the program entry 'main' reached code generation although {rejected}; "
                + "the signature phase must reject such an entry point.", signature.nameSpan()));
        } else {
            entry = new EntryPoint(candidate.symbol(), types.isVoidType(signature.returnType()),
                signature.declaresThrows());
        }
    }
    return new LoweredModule(moduleFunctions, functions, entry, problems);
}

// What the optimization stage produced: every module as the pipeline left it, and the account of
// what it elided when the build asked for one.
final class OptimizedProgram {
    protected List<LoweredModule> modules;
    protected List<string> account;

    protected constructor(this.modules, this.account);
}

// Runs every lowered function through the optimization pipeline, with the cross-function facts
// computed once over the whole program. The optimized functions are re-verified - after every pass
// when the settings ask for that, once at the end otherwise - so a broken pass is caught here,
// before emission ever sees its output.
//
// Optimization level None skips the whole stage, prepass included: the naive lowering the
// verifiers already accepted is what gets emitted.
optimizeModules(List<LoweredModule> lowered, DescriptorPlans plans,
                CodegenSettings settings) -> OptimizedProgram {
    if (!settings.optimizesEir()) {
        return new OptimizedProgram(lowered, new List<string>());
    }
    let everything = new List<EirFunction>();
    for (long m = 0; m < lowered.length(); m++) {
        let functions = lowered.get(m).functions;
        for (long f = 0; f < functions.length(); f++) {
            everything.push(functions.get(f));
        }
    }
    let context = optimize.planProgram(everything, plans);
    let optimized = new List<LoweredModule>();
    let account = new List<string>();
    long elided = 0;
    for (long m = 0; m < lowered.length(); m++) {
        let unit = optimizeModule(lowered.get(m), context, settings);
        optimized.push(unit.module);
        for (long i = 0; i < unit.account.length(); i++) {
            account.push(unit.account.get(i));
        }
        elided = elided + unit.elided;
    }
    if (settings.explainsArc()) {
        account.push("{elided} reference operation(s) elided across the program");
    }
    return new OptimizedProgram(optimized, account);
}

// One module after the pipeline: its optimized functions with the problems its own passes and
// verifiers reported, and its share of the account.
final class OptimizedModule {
    protected LoweredModule module;
    protected List<string> account;
    protected long elided;

    protected constructor(this.module, this.account, this.elided);
}

optimizeModule(LoweredModule unit, PassContext context, CodegenSettings settings) -> OptimizedModule {
    string filePath = unit.definitions.context().module().filePath();
    let functions = new List<EirFunction>();
    let problems = new List<FileDiagnostic>();
    let account = new List<string>();
    long elided = 0;
    for (long f = 0; f < unit.functions.length(); f++) {
        let outcome = optimize.runFunction(unit.functions.get(f), context, settings);
        for (let violation in outcome.problems()) {
            problems.push(new FileDiagnostic(filePath,
                "Internal: an optimization pass broke its function: {violation}",
                source.makeSpan(0, 0)));
        }
        if (!settings.verifiesAfterEachPass()) {
            appendAll(problems, checkOptimized(outcome.function(), filePath));
        }
        for (let line in outcome.account()) {
            account.push(line);
        }
        elided = elided + outcome.elidedOperations();
        functions.push(outcome.function());
    }
    return new OptimizedModule(new LoweredModule(unit.definitions, functions, unit.entry,
        problems), account, elided);
}

// Gates one optimized function on the four verifiers, so a pass bug surfaces as a diagnostic
// here rather than as a miscompile.
checkOptimized(EirFunction function, string filePath) -> List<FileDiagnostic> {
    let problems = new List<FileDiagnostic>();
    for (let violation in verify.verifyFunction(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: optimization produced malformed EIR: {violation}", source.makeSpan(0, 0)));
    }
    for (let violation in ownership.verifyOwnership(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: optimization produced unbalanced ownership: {violation}",
            source.makeSpan(0, 0)));
    }
    for (let violation in storage.verifyStorage(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: optimization produced unbalanced storage ownership: {violation}",
            source.makeSpan(0, 0)));
    }
    for (let violation in takes.verifyTakes(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: optimization moved a slot's reference out too early: {violation}",
            source.makeSpan(0, 0)));
    }
    return problems;
}

// Gates one lowered function on the four verifiers: its shape, the ownership its value temps
// carry, the ownership the storage it reaches holds, and the reads any moved-out slot leaves
// behind.
checkLowered(EirFunction function, string filePath, Span span) -> List<FileDiagnostic> {
    let problems = new List<FileDiagnostic>();
    for (let violation in verify.verifyFunction(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: lowering produced malformed EIR: {violation}", span));
    }
    for (let violation in ownership.verifyOwnership(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: lowering produced unbalanced ownership: {violation}", span));
    }
    for (let violation in storage.verifyStorage(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: lowering produced unbalanced storage ownership: {violation}", span));
    }
    for (let violation in takes.verifyTakes(function)) {
        problems.push(new FileDiagnostic(filePath,
            "Internal: lowering moved a slot's reference out too early: {violation}", span));
    }
    return problems;
}

// Writes one object file per module. Only a program that lowered and verified cleanly gets here,
// so a failed compile leaves no objects behind. Emission stops at the first module that fails,
// because a module that cannot be emitted means the compiler is broken, not the program.
emitModules(List<LoweredModule> lowered, DescriptorPlans plans, Type? stackFrame,
            Type? errorClass, string outputFolder, string filePrefix,
            CodegenSettings settings) -> EmittedObjects {
    let objects = new List<string>();
    let problems = new List<FileDiagnostic>();
    for (long m = 0; m < lowered.length(); m++) {
        let unit = lowered.get(m);
        string moduleName = unit.definitions.context().module().canonicalPath();
        string objectPath = outputFolder + "/" + filePrefix
            + symbols.sanitizeModulePath(moduleName) + settings.objectExtension();
        string failure = emit.emitModule(moduleName, unit.functions, unit.entry, plans,
            stackFrame, errorClass, objectPath, settings);
        if (failure.length > 0) {
            problems.push(new FileDiagnostic(unit.definitions.context().module().filePath(),
                "Internal: emission failed: " + failure, source.makeSpan(0, 0)));
            break;
        }
        objects.push(objectPath);
    }
    return new EmittedObjects(objects, problems);
}

appendAll(List<FileDiagnostic> problems, FileDiagnostic[] found) {
    for (let diagnostic in found) {
        problems.push(diagnostic);
    }
}

appendAll(List<FileDiagnostic> problems, List<FileDiagnostic> found) {
    for (long i = 0; i < found.length(); i++) {
        problems.push(found.get(i));
    }
}

// The program's entry function when this module defines it.
entryFunctionOf(ProgramIndex programIndex, ModuleFunctions moduleFunctions) -> FunctionInfo? {
    let entry = programIndex.entryFunction();
    if (entry == null || entry.context() != moduleFunctions.context()) {
        return null;
    }
    return entry;
}

// Describes the first way an entry signature departs from the shape the wrapper can call - no
// type parameters, no parameters, returning 'int' or nothing - or "" when it is emittable.
unsupportedEntryShape(Signature signature) -> string {
    if (signature.isGeneric()) {
        return "it declares type parameters";
    }
    if (signature.parameters().length > 0) {
        return "it declares {signature.parameters().length} parameter(s)";
    }
    Type returned = signature.returnType();
    if (types.isVoidType(returned)) {
        return "";
    }
    if (returned is PrimitiveType && returned.kind() == PrimitiveKind.Int) {
        return "";
    }
    return "it returns '{types.display(returned)}'";
}
