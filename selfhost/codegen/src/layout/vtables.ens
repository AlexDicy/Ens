// Dispatch slot assignment, the first half of the layout stage, run after the monomorphization
// closure and before any function lowers. A class method gets a vtable slot only when it is
// abstract or overridden. An interface method's slot is its declaration-order position.
//
// Which methods get a slot is read off the declarations, generic templates included, so the
// slots of a type are the same whichever other instantiations the program has.
import @ens.sema.model.hierarchy;
import Method from @ens.sema.model.typemembers;
import Signature from @ens.sema.model.typemembers;
import @ens.sema.model.typemembers;
import InstantiationType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import Visibility from @ens.sema.model.types;
import ProgramIndex from lower.index;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// The assigned slots. A signature identifies one method declaration, so both maps key on it;
// a method with no entry dispatches directly.
public final class DispatchTables {
    Set<Signature> forcedSlots;
    Set<Type> assignedTypes;

    Map<Signature, long> methodSlots;
    Map<Type, long> tableSizes;
    Map<Signature, long> interfaceSlots;

    // `forced` holds the declarations that need a slot, keyed the way `slotDeclarationOf` keys
    // them.
    public constructor(Set<Signature> forced) {
        this.forcedSlots = forced;
        this.assignedTypes = new Set<Type>();
        this.methodSlots = new Map<Signature, long>();
        this.tableSizes = new Map<Type, long>();
        this.interfaceSlots = new Map<Signature, long>();
    }

    // The vtable slot of a class method declaration, or -1 when it dispatches directly.
    public vtableSlotOf(Signature signature) -> long {
        let slot = this.methodSlots.get(signature);
        if (slot == null) {
            return -1;
        }
        return slot;
    }

    // The number of vtable slots a class's descriptor carries, its base's included.
    public vtableSizeOf(Type classType) -> long {
        let size = this.tableSizes.get(classType);
        if (size == null) {
            return 0;
        }
        return size;
    }

    // The slot of an interface method in its interface's method table, or -1 for a signature
    // that is not an interface method's.
    public itableSlotOf(Signature signature) -> long {
        let slot = this.interfaceSlots.get(signature);
        if (slot == null) {
            return -1;
        }
        return slot;
    }

    // Gives one class, declared or instantiated, its slots, after its base's. A subclass starts its
    // table where its base's ends and an override takes its base method's slot, which leaves a
    // derived table prefix-compatible with its base's. A type is assigned once.
    public assignClass(Type classType) {
        if (!this.assignedTypes.add(classType)) {
            return;
        }
        long size = 0;
        let base = baseClassOf(classType);
        if (base != null) {
            this.assignClass(base);
            size = this.vtableSizeOf(base);
        }
        let methods = typemembers.methodsOf(classType);
        if (methods == null) {
            return;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.isConstructor() || method.isDestructor()
                    || !this.forcedSlots.contains(slotDeclarationOf(classType, i))) {
                continue;
            }
            long slot = -1;
            let overridden = declaringBaseMethod(classType, method);
            if (overridden != null) {
                slot = this.vtableSlotOf(overridden.signature());
            }
            if (slot < 0) {
                slot = size;
                size++;
            }
            this.methodSlots.set(method.signature(), slot);
        }
        this.tableSizes.set(classType, size);
    }

    // Numbers an interface's method table, declared or instantiated, in declaration order.
    public assignInterface(Type interfaceType) {
        if (!this.assignedTypes.add(interfaceType)) {
            return;
        }
        let methods = typemembers.methodsOf(interfaceType);
        if (methods == null) {
            return;
        }
        for (long i = 0; i < methods.length(); i++) {
            this.interfaceSlots.set(methods.get(i).signature(), i);
        }
    }
}

// Assigns every dispatch slot of the indexed program.
public assignSlots(ProgramIndex index) -> DispatchTables {
    let tables = new DispatchTables(forcedSlots(index));
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let classes = modules.get(m).classes();
        for (long i = 0; i < classes.length(); i++) {
            tables.assignClass(classes.get(i));
        }
        let interfaces = modules.get(m).interfaces();
        for (long i = 0; i < interfaces.length(); i++) {
            tables.assignInterface(interfaces.get(i));
        }
        let instantiations = modules.get(m).instantiations();
        for (long i = 0; i < instantiations.length(); i++) {
            let instantiation = instantiations.get(i);
            if (primitives.classOf(instantiation) != null) {
                tables.assignClass(instantiation);
            } else if (primitives.interfaceOf(instantiation) != null) {
                tables.assignInterface(instantiation);
            }
        }
    }
    return tables;
}

// The declarations that need a slot: every abstract method, and both ends of every override, over
// the classes the program declares and the generic classes it declares.
public forcedSlots(ProgramIndex index) -> Set<Signature> {
    let forced = new Set<Signature>();
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let classes = modules.get(m).classes();
        for (long i = 0; i < classes.length(); i++) {
            markForcedSlots(classes.get(i), forced);
        }
        let templates = modules.get(m).classTemplates();
        for (long i = 0; i < templates.length(); i++) {
            markForcedSlots(templates.get(i), forced);
        }
    }
    return forced;
}

markForcedSlots(Type classType, Set<Signature> forced) {
    let methods = typemembers.methodsOf(classType);
    if (methods == null) {
        return;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (method.isConstructor() || method.isDestructor()) {
            continue;
        }
        if (method.isAbstract()) {
            let ignored = forced.add(slotDeclarationOf(classType, i));
        }
        if (!method.isOverride()) {
            continue;
        }
        let level = declaringBase(classType, method);
        if (level == null) {
            continue;
        }
        let ignoredOwn = forced.add(slotDeclarationOf(classType, i));
        let levelMethods = typemembers.methodsOf(level);
        if (levelMethods == null) {
            continue;
        }
        for (long j = 0; j < levelMethods.length(); j++) {
            if (levelMethods.get(j) == overriddenIn(level, method)) {
                let ignoredBase = forced.add(slotDeclarationOf(level, j));
            }
        }
    }
}

// The declaration whose slot decision the method at this position of a type's method list follows:
// the template's method at the same position for an instantiation, whose list is parallel to its
// template's, and the method's own declaration otherwise.
public slotDeclarationOf(Type owner, long index) -> Signature {
    let methods = typemembers.methodsOf(owner);
    if (methods == null) {
        panic("Internal: a slot was asked of a type with no methods");
    }
    if (owner is InstantiationType) {
        let templateMethods = typemembers.methodsOf(owner.template());
        if (templateMethods != null && index < templateMethods.length()) {
            return templateMethods.get(index).signature();
        }
    }
    return methods.get(index).signature();
}

// The nearest method up the base chain that this method overrides, matched by name and exact
// parameter types, or null when the chain declares none (an interface implementation or a
// replaced built-in behavior carries the marker without a base method). A private base method is
// not inherited, so it is never an override target and never earns a dispatch slot; sema refuses
// the override, and this keeps the table from being built around one it did not.
public declaringBaseMethod(Type classType, Method method) -> Method? {
    let level = declaringBase(classType, method);
    if (level == null) {
        return null;
    }
    return overriddenIn(level, method);
}

// The nearest class up the base chain declaring the method this one overrides, or null.
declaringBase(Type classType, Method method) -> Type? {
    let current = baseClassOf(classType);
    while (current != null) {
        if (typemembers.methodsOf(current) == null) {
            return null;
        }
        if (overriddenIn(current, method) != null) {
            return current;
        }
        current = baseClassOf(current);
    }
    return null;
}

// The method one class declares that `method` would override, or null.
overriddenIn(Type level, Method method) -> Method? {
    let methods = typemembers.methodsOf(level);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let candidate = methods.get(i);
        if (candidate.isConstructor() || candidate.isDestructor()
                || candidate.name() != method.name()
                || candidate.visibility() == Visibility.Private) {
            continue;
        }
        if (primitives.sameParameterTypes(candidate.signature(), method.signature())) {
            return candidate;
        }
    }
    return null;
}

// The base as the class-shaped type it must be here: a declared class or a filled instantiation
// of a generic one.
public baseClassOf(Type classType) -> Type? {
    let base = hierarchy.baseOf(classType);
    if (base == null) {
        return null;
    }
    return primitives.classOf(base);
}
