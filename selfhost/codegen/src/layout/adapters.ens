// Which dispatch-table slots hold a forwarding entry instead of the implementation itself.
//
// A method may narrow what its base class or an interface declared: 'int' where the base promised
// 'int?', 'int' where it promised 'long'. Every call reaching it through the declaring type reads
// the slot at the declared shape while the implementation returns its own, so the two disagree on
// the machine interface. Such a slot holds a small function with the declared shape instead, which
// forwards to the implementation and converts what comes back. The implementation keeps its own
// shape, so a call that names it directly costs nothing.
//
// One implementation can fill several slots that declare different returns - a method answering
// two interfaces, each promising its own - so an entry belongs to the pair of implementation and
// declared return type rather than to the implementation alone.
import ModuleContext from @ens.sema.context;
import @ens.sema.model.types;
import Type from @ens.sema.model.types;
import TypeStore from @ens.sema.model.types;
import FunctionInfo from lower.index;
import lower.symbols;
import mono.substitution;
import support.primitives;
import List from @std.collections.list;
import Map from @std.collections.map;

// One forwarding entry: the function a slot names, and the implementation it calls.
public final class ReturnAdapter {
    FunctionInfo adapterEntry;
    FunctionInfo adapterTarget;

    protected constructor(this.adapterEntry, this.adapterTarget);

    // The function the slot names, whose machine interface is the slot's.
    public entry() -> FunctionInfo {
        return this.adapterEntry;
    }

    // The implementation it forwards to.
    public target() -> FunctionInfo {
        return this.adapterTarget;
    }
}

// Every forwarding entry the program needs, interned so one implementation reached from two slots
// that declare the same return shares one entry, and grouped by the module that defines it.
public final class ReturnAdapters {
    Map<string, ReturnAdapter> bySymbol;
    Map<ModuleContext, List<ReturnAdapter>> byContext;
    List<ReturnAdapter> ordered;

    public constructor() {
        this.bySymbol = new Map<string, ReturnAdapter>();
        this.byContext = new Map<ModuleContext, List<ReturnAdapter>>();
        this.ordered = new List<ReturnAdapter>();
    }

    public all() -> List<ReturnAdapter> {
        return this.ordered;
    }

    // The entries one module defines: the module its implementation is defined in, so the entry
    // travels with the function it forwards to and is defined exactly once program-wide.
    public forContext(ModuleContext context) -> List<ReturnAdapter> {
        let found = this.byContext.get(context);
        if (found == null) {
            return new List<ReturnAdapter>();
        }
        return found;
    }

    // The entry a slot declared at 'declared' holds for this implementation: the implementation
    // itself when the two shapes are one, a forwarding entry otherwise.
    public entryFor(FunctionInfo implementation, Type declared, TypeStore store) -> FunctionInfo {
        Type actual = substitution.apply(store, implementation.substitution(),
            implementation.signature().returnType());
        if (primitives.sameReturnShape(declared, actual)) {
            return implementation;
        }
        return this.intern(implementation, declared).entry();
    }

    intern(FunctionInfo implementation, Type declared) -> ReturnAdapter {
        string symbol = adapterSymbol(implementation, declared);
        let existing = this.bySymbol.get(symbol);
        if (existing != null) {
            return existing;
        }
        let adapter = new ReturnAdapter(entryInfo(implementation, declared, symbol),
            implementation);
        this.bySymbol.set(symbol, adapter);
        this.ordered.push(adapter);
        let context = implementation.context();
        let group = this.byContext.get(context);
        if (group == null) {
            let created = new List<ReturnAdapter>();
            created.push(adapter);
            this.byContext.set(context, created);
        } else {
            group.push(adapter);
        }
        return adapter;
    }
}

// The forwarding entry's own description: the implementation's parameters and receiver under the
// declared return type. It carries the implementation's declaration so it reports through the same
// error slot the implementation does, and no method of its own, which is what keeps its linkage
// external: every module whose descriptor names the entry has to be able to reach it.
entryInfo(FunctionInfo implementation, Type declared, string symbol) -> FunctionInfo {
    let signature = types.signatureReturning(implementation.signature(), declared);
    return new FunctionInfo(implementation.context(), signature, implementation.visibility(),
        false, null, implementation.receiverType(), null, null, symbol,
        implementation.substitution());
}

// The symbol of one entry: the implementation's own with the shape it is called at folded in. The
// leading '_ret$' cannot collide with anything a program declares, for the reason a destructor's
// '_dtor$' cannot.
adapterSymbol(FunctionInfo implementation, Type declared) -> string {
    return "_ret$" + symbols.mangledTypeArgument(declared) + "$" + implementation.symbol();
}
