// How one compilation generates code: which target it is for, how hard it optimizes, and which
// extra checking it runs. Every stage of the pipeline reads the same value, so a build's
// code-generation behavior is decided once, before any module is lowered, and no stage has to
// look at the machine it happens to be running on.

// What '-O' asks for. The numbers are LLVM's own code-generation levels, so a level crosses into
// the target machine unchanged: None keeps every value in memory, Aggressive is the most LLVM
// will do. Level None additionally turns the EIR optimization pipeline off; every other level
// runs it. The verifiers run at every level, so '-O0' means unoptimized, never unchecked.
export enum OptimizationLevel {
    None = 0,
    Less = 1,
    Default = 2,
    Aggressive = 3,
}

// The level named by a '-O' value of 0 through 3, or null when the text names no level.
export levelFromText(string text) -> OptimizationLevel? {
    switch (text) {
        "0" -> {
            return OptimizationLevel.None;
        },
        "1" -> {
            return OptimizationLevel.Less;
        },
        "2" -> {
            return OptimizationLevel.Default;
        },
        "3" -> {
            return OptimizationLevel.Aggressive;
        },
        default -> {
            return null;
        },
    }
}

export final class CodegenSettings {
    OptimizationLevel level;
    string target;
    string[] disabled;

    bool verifyEachPass;
    bool explain;
    bool irPipeline;

    export constructor(OptimizationLevel level, string triple, string[] disabledPasses = [],
                       bool verifyAfterEachPass = false, bool explainArc = false) {
        this.level = level;
        this.target = triple;
        this.disabled = disabledPasses;
        this.verifyEachPass = verifyAfterEachPass;
        this.explain = explainArc;
        this.irPipeline = false;
    }

    export optimizationLevel() -> OptimizationLevel {
        return this.level;
    }

    // The target triple the objects are emitted for, which decides their object format and the
    // system the emitted runtime calls belong to.
    export targetTriple() -> string {
        return this.target;
    }

    // Whether the EIR optimization pipeline runs at all.
    export optimizesEir() -> bool {
        return this.level != OptimizationLevel.None;
    }

    // The level handed to LLVM's target machine.
    export llvmOptimizationLevel() -> int {
        return switch (this.level) {
            OptimizationLevel.None -> 0,
            OptimizationLevel.Less -> 1,
            OptimizationLevel.Default -> 2,
            OptimizationLevel.Aggressive -> 3,
        };
    }

    // Whether the named EIR pass runs. A build bisects a suspected pass bug by naming the pass
    // it wants left out.
    export runsPass(string passName) -> bool {
        for (long i = 0; i < this.disabled.length; i++) {
            if (this.disabled[i] == passName) {
                return false;
            }
        }
        return true;
    }

    export disabledPasses() -> string[] {
        return this.disabled;
    }

    // Whether the three verifiers run after every single pass rather than once after the whole
    // pipeline. The unit tests always ask for this, so a pass that breaks an invariant is named
    // by the pass rather than found at emission.
    export verifiesAfterEachPass() -> bool {
        return this.verifyEachPass;
    }

    // Whether the pipeline gathers the account of what it elided and why.
    export explainsArc() -> bool {
        return this.explain;
    }

    // Whether LLVM's own IR pass pipeline runs over each module before the target machine sees
    // it. Nothing turns this on yet: the EIR pipeline is the one that optimizes, and LLVM runs
    // only the code-generation passes its optimization level selects.
    export runsIrPassPipeline() -> bool {
        return this.irPipeline;
    }

    // The extension an object file carries on this target: COFF names its objects '.obj', and the
    // ELF and Mach-O objects every other system links are named '.o'.
    export objectExtension() -> string {
        if (this.target.contains("windows") || this.target.contains("win32")
                || this.target.contains("msvc")) {
            return ".obj";
        }
        return ".o";
    }
}
