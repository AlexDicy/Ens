// What emission writes once the reachability walk has run. A module keeps the bodies the program
// reaches and drops the rest, and a module with no body left writes no object file, handing the
// descriptors it owns to the core module's object instead.
//
// No object is written without code in it. An object whose text holds no function makes the Mach-O
// linker leave the first function of the object after it without unwind information, which empties
// any stack trace captured there, so a module with nothing to define must write nothing at all.
//
// Lowering and its four verifiers run over every body before any of this applies, so a body
// dropped here is dropped from the optimization pipeline, from LLVM and from the object file alone.
// A descriptor the reached bodies do not name is not written at all.
//
// What is written comes in the order the walk found it, so an object holds the same bodies and
// descriptors in the same order however many others were lowered and planned besides.
import EirFunction from eir.model;
import DescriptorPlan from layout.descriptors;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import StandardLibrary from @ens.sema.program.implicit;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// Every module with the bodies of it the program reaches, in the order the walk reached them.
public reachedBodies(List<ModuleBodies> lowered, ReachedProgram reached) -> List<ModuleBodies> {
    let moduleOf = new Map<string, long>();
    let bodyOf = new Map<string, EirFunction>();
    let kept = new List<List<EirFunction>>();
    for (long m = 0; m < lowered.length(); m++) {
        let bodies = lowered.get(m).bodies();
        for (long b = 0; b < bodies.length(); b++) {
            moduleOf.set(bodies.get(b).symbol(), m);
            bodyOf.set(bodies.get(b).symbol(), bodies.get(b));
        }
        kept.push(new List<EirFunction>());
    }
    for (let symbol in reached.order()) {
        let module = moduleOf.get(symbol);
        let body = bodyOf.get(symbol);
        if (module != null && body != null) {
            kept.get(module).push(body);
        }
    }
    let modules = new List<ModuleBodies>();
    for (long m = 0; m < lowered.length(); m++) {
        modules.push(new ModuleBodies(lowered.get(m).modulePath(), kept.get(m)));
    }
    return modules;
}

// Whether a module writes an object file, given how many bodies it has left to define. The core
// module writes one whatever the program reaches, because its object defines the trace runtime
// every other module declares, so every object this answers yes for holds code.
public writesObject(string modulePath, long bodyCount) -> bool {
    if (bodyCount > 0) {
        return true;
    }
    return modulePath == StandardLibrary.coreModule;
}

// The descriptors one module's object defines, out of the ones the reached bodies name. A module
// writing an object defines the ones it owns, and the core module's object additionally defines the
// ones owned by a module writing no object, so every named descriptor is defined exactly once in
// the program.
public definedDescriptors(string modulePath, ReachedProgram reached,
                          Set<string> writingModules) -> List<DescriptorPlan> {
    let defined = new List<DescriptorPlan>();
    for (let plan in reached.namedPlans().all()) {
        if (plan.modulePath() == modulePath || (modulePath == StandardLibrary.coreModule
                && !writingModules.contains(plan.modulePath()))) {
            defined.push(plan);
        }
    }
    return defined;
}
