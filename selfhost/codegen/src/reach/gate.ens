// What emission writes once the reachability walk has run. A module keeps the bodies the program
// reaches and drops the rest, and a module with no body left writes no object file unless
// something other than a body is defined in it.
//
// Lowering and its four verifiers run over every body before any of this applies, so a body
// dropped here is dropped from the optimization pipeline, from LLVM and from the object file alone.
import EirFunction from eir.model;
import DescriptorPlans from layout.descriptors;
import ReachedProgram from reach.reachable;
import StandardLibrary from @ens.sema.program.implicit;
import List from @std.collections.list;

// The bodies of one module the program reaches, in the order lowering produced them.
public reachedBodies(List<EirFunction> lowered, ReachedProgram reached) -> List<EirFunction> {
    let kept = new List<EirFunction>();
    for (long b = 0; b < lowered.length(); b++) {
        if (reached.reaches(lowered.get(b).symbol())) {
            kept.push(lowered.get(b));
        }
    }
    return kept;
}

// Whether a module writes an object file, given how many bodies it has left to define. Two rules
// hold whatever the program reaches. The core module writes one because its object defines the
// trace runtime every other module declares. A module that owns a descriptor writes one because
// its object is where that descriptor is defined.
public writesObject(string modulePath, long bodyCount, DescriptorPlans plans) -> bool {
    if (bodyCount > 0) {
        return true;
    }
    if (modulePath == StandardLibrary.coreModule) {
        return true;
    }
    return plans.ownedBy(modulePath);
}
