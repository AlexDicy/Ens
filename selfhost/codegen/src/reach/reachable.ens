// The reachability walk over lowered EIR. From the program's roots it follows every linker symbol
// a reached body names and marks the body defined under it, so a body is reached exactly when a
// chain of references leads to it from a root. EIR names every symbol emission references for an
// instruction, the ones lowering introduces included, so the walk reads the bodies rather than the
// declarations they came from.
//
// A call through a descriptor slot names no body. The walk records the type the receiver is known
// as and the slot, and every class a reached body allocates below that type has its
// implementation of the slot reached and the slot kept, which is rapid type analysis run to its
// fixed point. A slot that no reached call reads that way is dropped, and a descriptor is written
// only for a type a reached body names. A library has no entry point, and a program that links it
// may dispatch anywhere, so a library keeps the descriptor of every type it declares and every
// slot.
//
// The result is a set of symbols, descriptors and slots, each kept in the order the walk found
// it, and nothing here changes what a build emits. The walk reads only what the reached bodies
// name, so its result is the same however many other bodies and descriptors were planned.
import EirFunction from eir.model;
import EirInstruction from eir.model;
import EirTerminator from eir.model;
import EirCall from eir.model;
import EirTryCall from eir.model;
import EirClassNew from eir.model;
import EirDynamicEquals from eir.model;
import EirDynamicHash from eir.model;
import EirDynamicToString from eir.model;
import eir.walk;
import DescriptorPlan from layout.descriptors;
import DescriptorPlans from layout.descriptors;
import layout.descriptors;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import Root from reach.roots;
import reach.roots;
import OptionalType from @ens.sema.model.types;
import Type from @ens.sema.model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// One module's lowered function bodies, the way the driver holds them once lowering is done.
public final class ModuleBodies {
    string owningModulePath;
    List<EirFunction> loweredBodies;

    public constructor(this.owningModulePath, this.loweredBodies);

    public modulePath() -> string {
        return this.owningModulePath;
    }

    public bodies() -> List<EirFunction> {
        return this.loweredBodies;
    }
}

// The kinds of descriptor slot a call reads: a class's method slot, a method slot of an interface
// the class conforms to, and the three the language calls.
public enum SlotKind {
    Method = 0,
    Interface = 1,
    Hash = 2,
    Equals = 3,
    ToString = 4,
}

// What one walk found: the bodies its roots reach, the descriptors the reached bodies name, the
// slots a reached call reads with the implementations they hold, and the roots it started from.
public final class ReachedProgram {
    Set<string> reachedSymbols;
    List<string> reachedInOrder;
    Set<Type> namedDescriptors;
    DescriptorPlans namedInOrder;
    Set<string> keptSlots;
    List<string> keptImplementations;
    bool keepsEverySlot;
    List<Root> startingRoots;

    protected constructor(this.reachedSymbols, this.reachedInOrder, this.namedDescriptors,
                this.namedInOrder, this.keptSlots, this.keptImplementations, this.keepsEverySlot,
                this.startingRoots);

    // Whether the roots reach the body defined under this symbol. False for a symbol no lowered
    // body defines, such as a foreign C name.
    public reaches(string symbol) -> bool {
        return this.reachedSymbols.contains(symbol);
    }

    public reachedCount() -> long {
        return this.reachedSymbols.length();
    }

    // The reached symbols in the order the walk reached them.
    public order() -> List<string> {
        return this.reachedInOrder;
    }

    // How many types' descriptors the reached bodies name, counting the parent and the implemented
    // interfaces each named descriptor names in turn.
    public descriptorCount() -> long {
        return this.namedDescriptors.length();
    }

    // Whether the reached bodies name this type's descriptor, parents and interfaces included.
    public namesDescriptor(Type described) -> bool {
        return this.namedDescriptors.contains(described);
    }

    // The plans of the descriptors the reached bodies name, in the order the walk named them.
    public namedPlans() -> DescriptorPlans {
        return this.namedInOrder;
    }

    // Whether a reached call can read this slot of the planned descriptor. `conformed` is the
    // interface whose method table holds an interface slot, and null for every other kind.
    public keepsSlot(DescriptorPlan plan, SlotKind kind, Type? conformed, long index) -> bool {
        return this.keepsEverySlot || this.keptSlots.contains(slotKey(plan, kind, conformed, index));
    }

    public roots() -> List<Root> {
        return this.startingRoots;
    }

    // The implementation every kept slot holds, in the order the walk kept the slots.
    public slotImplementations() -> List<string> {
        return this.keptImplementations;
    }

    // The same descriptors, slots and roots with a different reached set and order.
    protected withReached(Set<string> symbols, List<string> order) -> ReachedProgram {
        return new ReachedProgram(symbols, order, this.namedDescriptors, this.namedInOrder,
            this.keptSlots, this.keptImplementations, this.keepsEverySlot, this.startingRoots);
    }
}

// Where a walk reads the program from: the body defined under a symbol and the descriptor plan of
// a type. The walk asks in the order it meets them, so a source that lowers and plans on the first
// request walks the same as one that holds everything beforehand.
public interface ProgramSource {
    // The body defined under this symbol, or null when the program defines none, as for a foreign
    // C name or a lazy const's storage.
    bodyOf(string symbol) -> EirFunction?;

    // The descriptor plan of this type, or null when it has none.
    planOf(Type described) -> DescriptorPlan?;
}

// A program lowered and planned before the walk.
public final class LoweredSource implements ProgramSource {
    DescriptorPlans plans;
    Map<string, EirFunction> bodyBySymbol;

    public constructor(DescriptorPlans plans, List<ModuleBodies> modules) {
        this.plans = plans;
        this.bodyBySymbol = new Map<string, EirFunction>();
        for (long m = 0; m < modules.length(); m++) {
            let bodies = modules.get(m).bodies();
            for (long b = 0; b < bodies.length(); b++) {
                this.bodyBySymbol.set(bodies.get(b).symbol(), bodies.get(b));
            }
        }
    }

    public override bodyOf(string symbol) -> EirFunction? {
        return this.bodyBySymbol.get(symbol);
    }

    public override planOf(Type described) -> DescriptorPlan? {
        return this.plans.planFor(described);
    }
}

// Walks the lowered program from the roots its index and its descriptors give it. Nothing is
// dropped here; the result is a set the caller reads.
public analyze(ProgramIndex index, DescriptorPlans plans,
               List<ModuleBodies> modules) -> ReachedProgram {
    return analyzeSource(index, new LoweredSource(plans, modules));
}

// Walks the program a source gives from the roots its index gives.
public analyzeSource(ProgramIndex index, ProgramSource source) -> ReachedProgram {
    List<Type>? libraryTypes = null;
    if (index.entryFunction() == null) {
        libraryTypes = declaredTypes(index);
    }
    return walkFrom(source, roots.collect(index), libraryTypes);
}

// Walks the lowered program from a root list a caller chose, which is how a test walks from an
// incomplete one. `libraryTypes` is null for a program. For a library it lists the types the
// library declares, whose descriptors it keeps along with every slot.
public analyzeFrom(DescriptorPlans plans, List<ModuleBodies> modules, List<Root> started,
                   List<Type>? libraryTypes = null) -> ReachedProgram {
    return walkFrom(new LoweredSource(plans, modules), started, libraryTypes);
}

// Walks the bodies an inliner rewrote with everything `decided` kept held fixed: its descriptors,
// its kept slots and its roots. Only direct references are followed, from the roots and from the
// implementation every kept slot holds, because a descriptor still holds that address. A body whose
// every use was inlined is left out, nothing `decided` did not reach is reached, and what is
// reached keeps the order `decided` reached it in.
public retainFrom(ReachedProgram decided, List<ModuleBodies> inlined) -> ReachedProgram {
    let bodies = new Map<string, EirFunction>();
    for (long m = 0; m < inlined.length(); m++) {
        let unit = inlined.get(m).bodies();
        for (long b = 0; b < unit.length(); b++) {
            bodies.set(unit.get(b).symbol(), unit.get(b));
        }
    }
    let retained = new Set<string>();
    let pending = new List<string>();
    for (let root in decided.roots()) {
        retain(root.symbol(), decided, bodies, retained, pending);
    }
    for (let implementation in decided.slotImplementations()) {
        retain(implementation, decided, bodies, retained, pending);
    }
    while (!pending.isEmpty()) {
        let body = bodies.get(pending.pop());
        if (body == null) {
            continue;
        }
        for (let block in body.blocks()) {
            for (let instruction in block.instructions()) {
                for (let named in walk.symbolsOf(instruction)) {
                    retain(named, decided, bodies, retained, pending);
                }
            }
            let terminator = block.terminator();
            if (terminator != null) {
                for (let named in walk.terminatorSymbolsOf(terminator)) {
                    retain(named, decided, bodies, retained, pending);
                }
            }
        }
    }
    let order = new List<string>();
    for (let symbol in decided.order()) {
        if (retained.contains(symbol)) {
            order.push(symbol);
        }
    }
    return decided.withReached(retained, order);
}

// Keeps one symbol the rewritten bodies name when `decided` reached it and a body defines it.
retain(string symbol, ReachedProgram decided, Map<string, EirFunction> bodies,
       Set<string> retained, List<string> pending) {
    if (!decided.reaches(symbol) || bodies.get(symbol) == null || !retained.add(symbol)) {
        return;
    }
    pending.push(symbol);
}

walkFrom(ProgramSource source, List<Root> started, List<Type>? libraryTypes) -> ReachedProgram {
    let walked = new Walk(source, libraryTypes != null);
    return walked.run(started, libraryTypes ?? new List<Type>());
}

// The classes and interfaces the program declares, in index order, leaving out instantiations.
declaredTypes(ProgramIndex index) -> List<Type> {
    let declared = new List<Type>();
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let interfaces = modules.get(m).interfaces();
        for (long i = 0; i < interfaces.length(); i++) {
            declared.push(interfaces.get(i));
        }
        let classes = modules.get(m).classes();
        for (long i = 0; i < classes.length(); i++) {
            declared.push(classes.get(i));
        }
    }
    return declared;
}

// The key a kept slot is recorded under: the descriptor's symbol, the kind, the interface's
// descriptor for an interface slot, and the index.
slotKey(DescriptorPlan plan, SlotKind kind, Type? conformed, long index) -> string {
    string interfaceName = "";
    if (conformed != null) {
        interfaceName = descriptors.descriptorSymbol(conformed);
    }
    return "{plan.symbol()}|{kind as int}|{interfaceName}|{index}";
}

// A call that reads a slot of whatever its receiver's runtime type is: the type the receiver is
// known as, null when it could be any class, the kind of slot and its index.
final class Dispatch {
    protected Type? through;
    protected SlotKind kind;
    protected long index;

    protected constructor(this.through, this.kind, this.index);

    override hash() -> long {
        long combined = (this.kind as long) * 31 + this.index;
        let known = this.through;
        if (known != null) {
            combined = combined * 31 + known.hash();
        }
        return combined;
    }

    override equals(Dispatch other) -> bool {
        return this.through == other.through && this.kind == other.kind
            && this.index == other.index;
    }
}

// One walk in progress: the bodies it has reached keyed by symbol, and the symbols it still has to
// scan. It lives no longer than the analyze call that made it, so two walks share nothing. The
// lists keep the order things were found in, so the walk visits them the same way every run.
final class Walk {
    ProgramSource source;
    Map<string, EirFunction> bodyBySymbol;
    Set<string> reached;
    List<string> reachedInOrder;
    Set<Type> descriptors;
    DescriptorPlans namedPlans;
    List<string> pending;
    Set<Type> instantiated;
    List<Type> instantiatedInOrder;
    Set<Dispatch> dispatched;
    List<Dispatch> dispatchedInOrder;
    Set<string> keptSlots;
    List<string> keptImplementations;
    bool library;

    protected constructor(ProgramSource source, bool library) {
        this.source = source;
        this.bodyBySymbol = new Map<string, EirFunction>();
        this.reached = new Set<string>();
        this.reachedInOrder = new List<string>();
        this.descriptors = new Set<Type>();
        this.namedPlans = new DescriptorPlans();
        this.pending = new List<string>();
        this.instantiated = new Set<Type>();
        this.instantiatedInOrder = new List<Type>();
        this.dispatched = new Set<Dispatch>();
        this.dispatchedInOrder = new List<Dispatch>();
        this.keptSlots = new Set<string>();
        this.keptImplementations = new List<string>();
        this.library = library;
    }

    protected run(List<Root> started, List<Type> libraryTypes) -> ReachedProgram {
        for (long i = 0; i < libraryTypes.length(); i++) {
            this.nameDescriptor(libraryTypes.get(i));
        }
        for (long i = 0; i < started.length(); i++) {
            this.reach(started.get(i).symbol());
        }
        while (!this.pending.isEmpty()) {
            this.scan(this.pending.pop());
        }
        return new ReachedProgram(this.reached, this.reachedInOrder, this.descriptors,
            this.namedPlans, this.keptSlots, this.keptImplementations, this.library, started);
    }

    // Marks the body under one symbol reached and queues it for scanning. A symbol the program
    // defines no body for is left out, which is what a foreign C name and a lazy const's storage
    // symbol are.
    reach(string symbol) {
        if (this.reached.contains(symbol)) {
            return;
        }
        let body = this.source.bodyOf(symbol);
        if (body == null) {
            return;
        }
        let added = this.reached.add(symbol);
        this.bodyBySymbol.set(symbol, body);
        this.reachedInOrder.push(symbol);
        this.pending.push(symbol);
    }

    // Follows everything one reached body names.
    scan(string symbol) {
        let body = this.bodyBySymbol.get(symbol);
        if (body == null) {
            return;
        }
        let blocks = body.blocks();
        for (long b = 0; b < blocks.length(); b++) {
            let block = blocks.get(b);
            let instructions = block.instructions();
            for (long i = 0; i < instructions.length(); i++) {
                let instruction = instructions.get(i);
                for (let named in walk.symbolsOf(instruction)) {
                    this.reach(named);
                }
                for (let described in walk.descriptorTypesOf(instruction)) {
                    this.nameDescriptor(described);
                }
                this.followDispatch(body, instruction);
            }
            let terminator = block.terminator();
            if (terminator == null) {
                continue;
            }
            for (let named in walk.terminatorSymbolsOf(terminator)) {
                this.reach(named);
            }
            for (let described in walk.terminatorDescriptorTypesOf(terminator)) {
                this.nameDescriptor(described);
            }
            if (terminator is EirTryCall && terminator.dispatchSlot >= 0) {
                this.dispatch(slotCall(terminator.callee.receiverType(),
                    terminator.dispatchInterface, terminator.dispatchSlot));
            }
        }
    }

    // What one instruction allocates or reads a descriptor slot of.
    followDispatch(EirFunction body, EirInstruction instruction) {
        switch (instruction) {
            is EirClassNew allocation -> {
                this.instantiate(allocation.type);
            },
            is EirCall call -> {
                if (call.dispatchSlot >= 0) {
                    this.dispatch(slotCall(call.callee.receiverType(), call.dispatchInterface,
                        call.dispatchSlot));
                }
            },
            is EirDynamicEquals equality -> {
                this.dispatch(new Dispatch(knownAs(body, equality.left), SlotKind.Equals, 0));
            },
            is EirDynamicHash hashed -> {
                this.dispatch(new Dispatch(knownAs(body, hashed.value), SlotKind.Hash, 0));
            },
            is EirDynamicToString shown -> {
                this.dispatch(new Dispatch(knownAs(body, shown.value), SlotKind.ToString, 0));
            },
            default -> { },
        }
    }

    // A class some reached body allocates, whose slots every recorded call reaching it keeps.
    instantiate(Type allocated) {
        if (!this.instantiated.add(allocated)) {
            return;
        }
        this.instantiatedInOrder.push(allocated);
        for (long d = 0; d < this.dispatchedInOrder.length(); d++) {
            this.select(allocated, this.dispatchedInOrder.get(d));
        }
    }

    // A call through a slot, which keeps that slot of every allocated class it can reach.
    dispatch(Dispatch call) {
        if (!this.dispatched.add(call)) {
            return;
        }
        this.dispatchedInOrder.push(call);
        for (long t = 0; t < this.instantiatedInOrder.length(); t++) {
            this.select(this.instantiatedInOrder.get(t), call);
        }
    }

    // Keeps the slot `call` reads in the descriptor of `allocated`, and reaches what it holds, when
    // an object of that class can be the receiver.
    select(Type allocated, Dispatch call) {
        let plan = this.source.planOf(allocated);
        if (plan == null || !this.isBelow(plan, call.through, call.kind)) {
            return;
        }
        Type? conformed = null;
        if (call.kind == SlotKind.Interface) {
            conformed = call.through;
        }
        let implementation = slotOf(plan, call.kind, conformed, call.index);
        if (implementation == null) {
            return;
        }
        if (this.keptSlots.add(slotKey(plan, call.kind, conformed, call.index))) {
            this.keptImplementations.push(implementation.symbol());
        }
        this.reach(implementation.symbol());
    }

    // Whether a class with this plan is the type a receiver is known as or below it. An interface
    // slot needs the class to conform to that interface.
    isBelow(DescriptorPlan plan, Type? through, SlotKind kind) -> bool {
        if (through == null) {
            return true;
        }
        for (let conformance in plan.conformances()) {
            if (conformance.interfaceType() == through) {
                return true;
            }
        }
        if (kind == SlotKind.Interface) {
            return false;
        }
        DescriptorPlan? current = plan;
        while (current != null) {
            if (current.type() == through) {
                return true;
            }
            let parent = current.parent();
            if (parent == null) {
                return false;
            }
            current = this.source.planOf(parent);
        }
        return false;
    }

    // Records one descriptor a body names, with the parent and interface descriptors that
    // descriptor's own initializer names.
    nameDescriptor(Type described) {
        if (!this.descriptors.add(described)) {
            return;
        }
        let plan = this.source.planOf(described);
        if (plan == null) {
            return;
        }
        this.namedPlans.add(plan);
        if (this.library) {
            this.keepEverySlot(plan);
        }
        let parent = plan.parent();
        if (parent != null) {
            this.nameDescriptor(parent);
        }
        for (let conformance in plan.conformances()) {
            this.nameDescriptor(conformance.interfaceType());
        }
    }

    // A library's descriptor: every implementation it holds is reached, as every slot was a root
    // before the walk read dispatches.
    keepEverySlot(DescriptorPlan plan) {
        for (let implementation in plan.vtable()) {
            this.reachImplementation(implementation);
        }
        for (let conformance in plan.conformances()) {
            for (let implementation in conformance.implementations()) {
                this.reachImplementation(implementation);
            }
        }
        this.reachImplementation(plan.hashSlot());
        this.reachImplementation(plan.equalsSlot());
        this.reachImplementation(plan.toStringSlot());
    }

    reachImplementation(FunctionInfo? implementation) {
        if (implementation != null) {
            this.keptImplementations.push(implementation.symbol());
            this.reach(implementation.symbol());
        }
    }
}

// The slot a dispatched call reads: an interface's when it names one, and otherwise the method
// slot of the class its receiver is known as.
slotCall(Type? receiverType, Type? dispatchInterface, long slot) -> Dispatch {
    if (dispatchInterface != null) {
        return new Dispatch(dispatchInterface, SlotKind.Interface, slot);
    }
    return new Dispatch(receiverType, SlotKind.Method, slot);
}

// The type a temp is known as, without the optional around it, which is the type a dynamic
// dispatch reads the runtime type below.
knownAs(EirFunction body, long temp) -> Type? {
    let types = body.tempTypes();
    if (temp < 0 || temp >= types.length()) {
        return null;
    }
    let type = types.get(temp);
    while (type is OptionalType) {
        type = type.inner();
    }
    return type;
}

// What the descriptor of this plan holds at one slot, or null where it holds nothing.
slotOf(DescriptorPlan plan, SlotKind kind, Type? conformed, long index) -> FunctionInfo? {
    switch (kind) {
        SlotKind.Method -> {
            let vtable = plan.vtable();
            if (index >= vtable.length) {
                return null;
            }
            return vtable[index];
        },
        SlotKind.Interface -> {
            for (let conformance in plan.conformances()) {
                if (conformance.interfaceType() == conformed) {
                    let implementations = conformance.implementations();
                    if (index >= implementations.length) {
                        return null;
                    }
                    return implementations[index];
                }
            }
            return null;
        },
        SlotKind.Hash -> {
            return plan.hashSlot();
        },
        SlotKind.Equals -> {
            return plan.equalsSlot();
        },
        SlotKind.ToString -> {
            return plan.toStringSlot();
        },
    }
}
