// The account a build requests with '--explain-reachability'. For each module it gives how many of
// that module's lowered function bodies the program's roots reach and the name of every body they
// do not. It is text read back from the walk's result, so explaining a build changes nothing about
// how it runs.
import ProgramIndex from lower.index;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import List from @std.collections.list;

// One header line per module that defines bodies, the unreached names under it, and the program's
// own totals last. A name marked synthesized is one lowering built rather than one the program
// declares, such as a class destructor.
public lines(ProgramIndex index, List<ModuleBodies> modules,
             ReachedProgram reached) -> string[] {
    let account = new List<string>();
    long bodies = 0;
    long reachedBodies = 0;
    for (long m = 0; m < modules.length(); m++) {
        let unit = modules.get(m);
        let defined = unit.bodies();
        if (defined.length() == 0) {
            continue;
        }
        long reachedHere = 0;
        for (long b = 0; b < defined.length(); b++) {
            if (reached.reaches(defined.get(b).symbol())) {
                reachedHere++;
            }
        }
        bodies = bodies + defined.length();
        reachedBodies = reachedBodies + reachedHere;
        account.push(moduleLine(unit.modulePath(), defined.length(), reachedHere));
        for (long b = 0; b < defined.length(); b++) {
            string symbol = defined.get(b).symbol();
            if (reached.reaches(symbol)) {
                continue;
            }
            account.push(unreachedLine(index, symbol));
        }
    }
    account.push(programLine(bodies, reachedBodies, reached.roots().length()));
    return account.toArray();
}

// "main: 4 function bodies, 3 reached, 1 not reached", or the short form when none is left out.
moduleLine(string modulePath, long defined, long reached) -> string {
    if (reached == defined) {
        return "{modulePath}: " + bodyCount(defined) + ", all reached";
    }
    return "{modulePath}: " + bodyCount(defined) + ", {reached} reached, "
        + "{defined - reached} not reached";
}

// One unreached body, marked when lowering synthesized it rather than the program declaring it.
unreachedLine(ProgramIndex index, string symbol) -> string {
    if (index.functionForSymbol(symbol) == null) {
        return "  '{symbol}' (synthesized)";
    }
    return "  '{symbol}'";
}

// The line that closes the account, giving the whole program's totals and how many roots they
// were counted from.
programLine(long bodies, long reached, long roots) -> string {
    if (reached == bodies) {
        return bodyCount(bodies) + ", all reached from " + rootCount(roots)
            + " across the program";
    }
    return bodyCount(bodies) + ", {reached} reached from " + rootCount(roots)
        + ", {bodies - reached} not reached across the program";
}

bodyCount(long count) -> string {
    if (count == 1) {
        return "1 function body";
    }
    return "{count} function bodies";
}

rootCount(long count) -> string {
    if (count == 1) {
        return "1 root";
    }
    return "{count} roots";
}
