// The account a build requests with '--explain-reachability'. For each module it gives how many of
// that module's lowered function bodies the program's roots reach and the name of every body they
// do not. It is text read back from the walk's result, so explaining a build changes nothing about
// how it runs.
import @ens.sema.model.typenames;
import Type from @ens.sema.model.types;
import EirFunction from eir.model;
import ProgramIndex from lower.index;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import support.primitives;
import List from @std.collections.list;

// One header line per module that defines bodies, the unreached names under it, and the program's
// own totals last. A body the program does not declare, such as a class destructor, is one the
// compiler writes, and is described as that.
public lines(ProgramIndex index, List<ModuleBodies> modules,
             ReachedProgram reached) -> string[] {
    let account = new List<string>();
    long bodies = 0;
    long reachedBodies = 0;
    for (long m = 0; m < modules.length(); m++) {
        let unit = modules.get(m);
        let defined = unit.bodies();
        if (defined.length() == 0) {
            continue;
        }
        long reachedHere = 0;
        for (long b = 0; b < defined.length(); b++) {
            if (reached.reaches(defined.get(b).symbol())) {
                reachedHere++;
            }
        }
        bodies = bodies + defined.length();
        reachedBodies = reachedBodies + reachedHere;
        account.push(moduleLine(unit.modulePath(), defined.length(), reachedHere));
        for (long b = 0; b < defined.length(); b++) {
            let body = defined.get(b);
            if (reached.reaches(body.symbol())) {
                continue;
            }
            account.push(unreachedLine(index, body));
        }
    }
    account.push(programLine(bodies, reachedBodies, roots(index, reached)));
    return account.toArray();
}

// "main: 4 functions, 3 used, 1 left out of the program", or the short form when none is left out.
moduleLine(string modulePath, long defined, long reached) -> string {
    if (reached == defined) {
        return "{modulePath}: " + functionCount(defined) + ", all used";
    }
    return "{modulePath}: " + functionCount(defined) + ", {reached} used, "
        + "{defined - reached} left out of the program";
}

// One unused function, by its declared name, or described when the compiler wrote it.
unreachedLine(ProgramIndex index, EirFunction function) -> string {
    string name = nameOf(index, function);
    if (index.functionForSymbol(function.symbol()) == null) {
        return "  {name}, which the compiler writes";
    }
    return "  {name}";
}

// How the accounts name a function: by its declared name, as the destructor of the class it
// destroys, or by its symbol when it is neither.
public nameOf(ProgramIndex index, EirFunction function) -> string {
    let declared = index.accountName(function.symbol());
    if (declared != null) {
        return declared;
    }
    let destroyed = destroyedClass(function);
    if (destroyed != null) {
        return "the destructor of '{typenames.display(destroyed)}'";
    }
    return "'{function.symbol()}'";
}

// The class a synthesized destructor destroys, or null for any other function.
destroyedClass(EirFunction function) -> Type? {
    let parameters = function.parameters();
    if (!function.symbol().startsWith("_dtor$") || parameters.length != 1) {
        return null;
    }
    if (primitives.classOf(parameters[0].type()) == null) {
        return null;
    }
    return parameters[0].type();
}

// How many roots the walk started from, and the declared name of the first one that has one.
roots(ProgramIndex index, ReachedProgram reached) -> string {
    let all = reached.roots();
    string example = "";
    for (long i = 0; i < all.length() && example.length == 0; i++) {
        example = index.accountName(all.get(i).symbol()) ?? "";
    }
    if (all.length() == 1) {
        if (example.length == 0) {
            return "1 entry point";
        }
        return "1 entry point, {example}";
    }
    if (example.length == 0) {
        return "{all.length()} entry points";
    }
    return "{all.length()} entry points such as {example}";
}

// The line that closes the account, giving the whole program's totals and the entry points they
// were counted from.
programLine(long bodies, long reached, string roots) -> string {
    if (reached == bodies) {
        return functionCount(bodies) + ", all used, starting from " + roots;
    }
    return functionCount(bodies) + " in the program: {reached} used, starting from " + roots
        + ", and {bodies - reached} left out";
}

functionCount(long count) -> string {
    if (count == 1) {
        return "1 function";
    }
    return "{count} functions";
}
