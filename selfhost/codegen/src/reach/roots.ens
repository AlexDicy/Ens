// The roots of the reachability walk: the bodies a program needs whatever its own code references.
// There are three kinds. The entry point, which the 'main' shim in the entry module calls. Every
// slot of every emitted descriptor, because a descriptor's initializer holds the address of each
// implementation it names. And every export of a program with no entry point, which is what a
// library build is.
import DescriptorPlans from layout.descriptors;
import FunctionInfo from lower.index;
import ProgramIndex from lower.index;
import Visibility from @ens.sema.model.types;
import @ens.sema.model.types;
import List from @std.collections.list;

// One symbol the walk starts from, with the place in the program it was taken from.
public final class Root {
    string rootSymbol;
    string rootOrigin;

    public constructor(this.rootSymbol, this.rootOrigin);

    public symbol() -> string {
        return this.rootSymbol;
    }

    // Where the root came from, as "the program entry", "a method slot of 'Shape'" or "an export
    // of 'std.text.string'".
    public origin() -> string {
        return this.rootOrigin;
    }
}

// Every root of the indexed program, in one list. A program with an entry point roots at it and
// at its descriptors; a program without one roots at its descriptors and its exports instead.
public collect(ProgramIndex index, DescriptorPlans plans) -> List<Root> {
    let roots = new List<Root>();
    let entry = index.entryFunction();
    if (entry != null) {
        roots.push(new Root(entry.symbol(), "the program entry"));
    }
    collectDescriptorSlots(plans, roots);
    if (entry == null) {
        collectExports(index, roots);
    }
    return roots;
}

// Every implementation a descriptor names: its method slots, the slots of each interface it
// conforms to, and the three slots the language calls. The interface slots are a set of their own,
// because a class implements an interface method at a slot of that interface's table whether or
// not the method has a slot in the class's own.
collectDescriptorSlots(DescriptorPlans plans, List<Root> roots) {
    let all = plans.all();
    for (long i = 0; i < all.length(); i++) {
        let plan = all.get(i);
        string described = plan.name();
        let vtable = plan.vtable();
        for (long slot = 0; slot < vtable.length; slot++) {
            addSlot(roots, vtable[slot], "a method slot of '{described}'");
        }
        for (let conformance in plan.conformances()) {
            string conformed = types.display(conformance.interfaceType());
            let implementations = conformance.implementations();
            for (long slot = 0; slot < implementations.length; slot++) {
                addSlot(roots, implementations[slot],
                    "a '{conformed}' slot of '{described}'");
            }
        }
        addSlot(roots, plan.hashSlot(), "the 'hash' slot of '{described}'");
        addSlot(roots, plan.equalsSlot(), "the 'equals' slot of '{described}'");
        addSlot(roots, plan.toStringSlot(), "the 'toString' slot of '{described}'");
    }
}

// Adds the implementation of one descriptor slot. A slot the plan left empty holds a null pointer
// and names nothing.
addSlot(List<Root> roots, FunctionInfo? implementation, string origin) {
    if (implementation == null) {
        return;
    }
    roots.push(new Root(implementation.symbol(), origin));
}

// Every 'export' the program declares. A consumer of a library reaches these by name and reaches
// everything else through one of them, so they are what a build with no entry point keeps.
collectExports(ProgramIndex index, List<Root> roots) {
    let modules = index.modules();
    for (long m = 0; m < modules.length(); m++) {
        let moduleFunctions = modules.get(m);
        string modulePath = moduleFunctions.context().module().canonicalPath();
        let functions = moduleFunctions.functions();
        for (long f = 0; f < functions.length(); f++) {
            let info = functions.get(f);
            if (info.visibility() != Visibility.Export) {
                continue;
            }
            roots.push(new Root(info.symbol(), "an export of '{modulePath}'"));
        }
    }
}
