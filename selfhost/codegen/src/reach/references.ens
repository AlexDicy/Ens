// The closure check over a reachability walk's result. Every symbol a reached body names, and
// every implementation an emitted descriptor names, must itself be reached or be a symbol the
// program defines no body for at all. A symbol that is neither is one a build drops while
// something it keeps still points at it, which is an unresolved symbol at link time.
//
// A global is data rather than a body, so it is checked against the definitions instead: one a
// reached body names has to be defined by a reached body.
//
// Everything either can name is covered: a call's callee, the destructor a class allocation names,
// a closure's target and its destructor, a lazy const's storage, and for a descriptor its method
// slots, its interface slots, the three the language calls, and the base it names. Only a foreign
// call's C name is left out, because the program defines no body for it.
//
// It reads the bodies as the optimization pipeline left them, because those are the ones emission
// writes, while the walk read the bodies lowering produced.
import EirFunction from eir.model;
import EirGlobalAddress from eir.model;
import EirInstruction from eir.model;
import eir.walk;
import DescriptorPlan from layout.descriptors;
import DescriptorPlans from layout.descriptors;
import layout.descriptors;
import FunctionInfo from lower.index;
import ModuleBodies from reach.reachable;
import ReachedProgram from reach.reachable;
import @ens.sema.model.types;
import List from @std.collections.list;
import Set from @std.collections.set;

// One reference out of the reached set, with both ends and the module the reference is made in.
public final class DanglingReference {
    string unreachedSymbol;
    string referringName;
    string owningModulePath;
    string reportedMessage;

    protected constructor(this.unreachedSymbol, this.referringName, this.owningModulePath,
                this.reportedMessage);

    // The symbol the walk did not reach.
    public symbol() -> string {
        return this.unreachedSymbol;
    }

    // What still names it, either a function's linker symbol or a described type's name.
    public referrer() -> string {
        return this.referringName;
    }

    public modulePath() -> string {
        return this.owningModulePath;
    }

    // The whole internal diagnostic, naming both ends and the module.
    public message() -> string {
        return this.reportedMessage;
    }
}

// Every reference out of the reached set, over the reached bodies and every emitted descriptor.
// An empty list is what a closed root set produces.
//
// The emitted bodies are the ones a build writes, and the lowered bodies are every body lowering
// produced, so a symbol emission dropped is not mistaken for a name no body was lowered under.
public check(List<ModuleBodies> emitted, List<ModuleBodies> lowered, DescriptorPlans plans,
             ReachedProgram reached) -> List<DanglingReference> {
    let found = new List<DanglingReference>();
    let defined = definedSymbols(lowered);
    let globals = definedGlobals(lowered, reached);
    for (long m = 0; m < emitted.length(); m++) {
        let unit = emitted.get(m);
        let bodies = unit.bodies();
        for (long b = 0; b < bodies.length(); b++) {
            let body = bodies.get(b);
            if (!reached.reaches(body.symbol())) {
                continue;
            }
            checkBody(body, unit.modulePath(), defined, globals, reached, found);
        }
    }
    let all = plans.all();
    for (long i = 0; i < all.length(); i++) {
        checkDescriptor(all.get(i), plans, defined, reached, found);
    }
    return found;
}

// Every symbol the lowered program defines a body for, which is what separates a dropped body from
// a foreign name.
definedSymbols(List<ModuleBodies> modules) -> Set<string> {
    let defined = new Set<string>();
    for (long m = 0; m < modules.length(); m++) {
        let bodies = modules.get(m).bodies();
        for (long b = 0; b < bodies.length(); b++) {
            let ignored = defined.add(bodies.get(b).symbol());
        }
    }
    return defined;
}

// One reached body's own references, read through the same walk the reachability walk reads.
checkBody(EirFunction body, string modulePath, Set<string> defined, Set<string> globals,
          ReachedProgram reached, List<DanglingReference> found) {
    let blocks = body.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let block = blocks.get(b);
        let instructions = block.instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            for (let named in walk.symbolsOf(instruction)) {
                record(named, body.symbol(), modulePath, defined, reached, found);
            }
            recordGlobal(instruction, body.symbol(), modulePath, globals, found);
        }
        let terminator = block.terminator();
        if (terminator == null) {
            continue;
        }
        for (let named in walk.terminatorSymbolsOf(terminator)) {
            record(named, body.symbol(), modulePath, defined, reached, found);
        }
    }
}

// One descriptor's slots: its method table, the method table of each interface it conforms to, and
// the three slots the language calls. The descriptor's initializer holds the address of each one,
// so a slot naming an unreached body is a reference the linker would have to resolve. Each report
// names which kind of slot holds the address, and the base is reported apart from the slots.
checkDescriptor(DescriptorPlan plan, DescriptorPlans plans, Set<string> defined,
                ReachedProgram reached, List<DanglingReference> found) {
    let vtable = plan.vtable();
    for (long slot = 0; slot < vtable.length; slot++) {
        recordSlot(vtable[slot], "method slot {slot}", plan, defined, reached, found);
    }
    for (let conformance in plan.conformances()) {
        string conformed = types.display(conformance.interfaceType());
        let implementations = conformance.implementations();
        for (long slot = 0; slot < implementations.length; slot++) {
            recordSlot(implementations[slot], "'{conformed}' slot {slot}", plan, defined,
                reached, found);
        }
    }
    recordSlot(plan.hashSlot(), "the 'hash' slot", plan, defined, reached, found);
    recordSlot(plan.equalsSlot(), "the 'equals' slot", plan, defined, reached, found);
    recordSlot(plan.toStringSlot(), "the 'toString' slot", plan, defined, reached, found);
    recordBase(plan, plans, found);
}

// The base a descriptor's initializer holds the address of, which has to be a descriptor the
// program planned, since a plan is what gives a descriptor its one definition site. A type with no
// plan is one nothing defines a descriptor for anywhere.
recordBase(DescriptorPlan plan, DescriptorPlans plans, List<DanglingReference> found) {
    let base = plan.parent();
    if (base == null || plans.planFor(base) != null) {
        return;
    }
    string symbol = descriptors.descriptorSymbol(base);
    found.push(new DanglingReference(symbol, plan.name(), plan.modulePath(),
        "Internal: no descriptor is planned for '{types.display(base)}', so nothing defines "
        + "'{symbol}', which the descriptor of '{plan.name()}' in module '{plan.modulePath()}' "
        + "names as its base; the root set is not closed."));
}

recordSlot(FunctionInfo? implementation, string slotName, DescriptorPlan plan,
           Set<string> defined, ReachedProgram reached, List<DanglingReference> found) {
    if (implementation == null) {
        return;
    }
    string symbol = implementation.symbol();
    if (!isUnreachedBody(symbol, defined, reached)) {
        return;
    }
    found.push(new DanglingReference(symbol, plan.name(), plan.modulePath(),
        "Internal: the reachability walk did not reach '{symbol}', which the descriptor of "
        + "'{plan.name()}' in module '{plan.modulePath()}' references from {slotName}; the root "
        + "set is not closed."));
}

record(string symbol, string referrer, string modulePath, Set<string> defined,
       ReachedProgram reached, List<DanglingReference> found) {
    if (!isUnreachedBody(symbol, defined, reached)) {
        return;
    }
    found.push(new DanglingReference(symbol, referrer, modulePath,
        "Internal: the reachability walk did not reach '{symbol}', which '{referrer}' in module "
        + "'{modulePath}' references; the root set is not closed."));
}

// Every global a body the walk reached defines, which are the definitions emission writes.
definedGlobals(List<ModuleBodies> modules, ReachedProgram reached) -> Set<string> {
    let defined = new Set<string>();
    for (long m = 0; m < modules.length(); m++) {
        let bodies = modules.get(m).bodies();
        for (long b = 0; b < bodies.length(); b++) {
            let body = bodies.get(b);
            if (!reached.reaches(body.symbol())) {
                continue;
            }
            collectDefinedGlobals(body, defined);
        }
    }
    return defined;
}

collectDefinedGlobals(EirFunction body, Set<string> defined) {
    let blocks = body.blocks();
    for (long b = 0; b < blocks.length(); b++) {
        let instructions = blocks.get(b).instructions();
        for (long i = 0; i < instructions.length(); i++) {
            let instruction = instructions.get(i);
            if (!(instruction is EirGlobalAddress) || !instruction.defines) {
                continue;
            }
            let ignored = defined.add(instruction.symbol);
        }
    }
}

// One global a reached body names, which a reached body has to define or the link has nothing to
// resolve it to. Every global is a lazy const's storage, and a read of one names the initializer
// that defines it in the same body, which is what keeps this quiet.
recordGlobal(EirInstruction instruction, string referrer, string modulePath,
             Set<string> globals, List<DanglingReference> found) {
    if (!(instruction is EirGlobalAddress)) {
        return;
    }
    if (globals.contains(instruction.symbol)) {
        return;
    }
    found.push(new DanglingReference(instruction.symbol, referrer, modulePath,
        "Internal: the reachability walk reached no definition of the global "
        + "'{instruction.symbol}', which '{referrer}' in module '{modulePath}' references; the "
        + "root set is not closed."));
}

// True when the program defines a body under this symbol and the walk did not reach it. A foreign
// C name and a runtime helper emission synthesizes on demand define no body here, so neither is
// one of these. A lazy const's storage defines none either, and recordGlobal is what covers it.
isUnreachedBody(string symbol, Set<string> defined, ReachedProgram reached) -> bool {
    return defined.contains(symbol) && !reached.reaches(symbol);
}
