// The processor and the system a triple names, over every spelling a triple reaches a build in.
import @std.testing;
import Platform from @std.platform;
import Architecture from triple;
import Macos from triple;
import SystemSupport from triple;
import TargetTriple from triple;
import triple;

test "each processor is read from either of its spellings" {
    try expectArchitecture("x86_64-pc-windows-msvc", Architecture.X64);
    try expectArchitecture("amd64-unknown-linux-gnu", Architecture.X64);
    try expectArchitecture("aarch64-unknown-linux-gnu", Architecture.Arm64);
    try expectArchitecture("arm64-unknown-linux-gnu", Architecture.Arm64);
    try expectArchitecture("arm64-apple-macosx14.0", Architecture.Arm64);
    try expectArchitecture("arm64-pc-windows-msvc", Architecture.Arm64);
}

test "a parsed triple keeps its text as written" {
    try testing.assertEqual(parsed("amd64-unknown-linux-gnu").text(), "amd64-unknown-linux-gnu");
}

test "only the whole first part names the processor" {
    for (let text in ["riscv64-x86_64-linux", "x86_64h-apple-darwin23", "arm64e-apple-macosx14.0",
            "arm64_32-apple-watchos"]) {
        try expectNone(text);
        try testing.assertFalse(triple.read(text).supportsProcessor(), "'{text}' was supported");
    }
}

test "a processor this toolchain does not build for is none" {
    for (let text in ["i686-pc-windows-msvc", "i386-unknown-linux-gnu",
            "aarch64_be-unknown-linux-gnu", "riscv64-unknown-linux-gnu", "wasm32-unknown-unknown",
            "", "-unknown-linux-gnu"]) {
        try expectNone(text);
        try testing.assertFalse(triple.read(text).supportsProcessor(), "'{text}' was supported");
    }
}

test "the processor part is the text before the first dash" {
    try testing.assertEqual(triple.read("i686-pc-windows-msvc").processor(), "i686");
    try testing.assertEqual(triple.read("x86_64").processor(), "x86_64");
    try testing.assertEqual(triple.read("-unknown-linux-gnu").processor(), "");
    try testing.assertEqual(triple.read("").processor(), "");
}

test "each system this toolchain builds for is read from the spellings a build reaches" {
    for (let text in ["x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc", "x86_64-pc-win32",
            "x86_64-pc-windows", "x86_64-win32", "x86_64-pc-windows-msvc19.40.0"]) {
        try expectPlatform(text, Platform.Windows);
    }
    for (let text in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
            "x86_64-pc-linux-gnu", "x86_64-linux-gnu", "x86_64-unknown-linux", "x86_64-linux"]) {
        try expectPlatform(text, Platform.Linux);
    }
    for (let text in ["arm64-apple-macosx14.0", "x86_64-apple-macosx", "arm64-apple-macos",
            "arm64-apple-macos14.0", "x86_64-apple-darwin23.6.0", "arm64-apple-darwin",
            "x86_64-macosx10.15.4"]) {
        try expectPlatform(text, Platform.MacOS);
    }
}

test "a system this toolchain does not build and link for is refused by what it is" {
    try expectSupport("x86_64-unknown-linux-musl", SystemSupport.LinuxMusl);
    try expectSupport("aarch64-unknown-linux-gnueabihf", SystemSupport.LinuxGnuForm);
    try expectSupport("x86_64-unknown-linux-gnux32", SystemSupport.LinuxGnuForm);
    try expectSupport("x86_64-pc-windows-gnu", SystemSupport.WindowsMinGW);
    try expectSupport("x86_64-pc-windows-gnullvm", SystemSupport.WindowsMinGW);
    try expectSupport("x86_64-w64-mingw32", SystemSupport.WindowsMinGW);
    try expectSupport("x86_64-pc-cygwin", SystemSupport.WindowsCygwin);
    try expectSupport("x86_64-pc-windows-cygnus", SystemSupport.WindowsCygwin);
    try expectSupport("x86_64", SystemSupport.Missing);
    try expectSupport("x86_64-", SystemSupport.Missing);
    for (let text in ["x86_64-unknown-freebsd", "aarch64-linux-android",
            "aarch64-unknown-linux-android", "x86_64-unknown-linux-musleabi", "arm64-apple-ios17.0",
            "x86_64-apple-macosx14.0-macabi", "x86_64-apple-macosxfoo", "x86_64-apple-darwin.23",
            "x86_64-apple-darwin23.", "x86_64-pc-windows-msvcfoo", "x86_64-pc-windows-itanium",
            "x86_64-unknown-none", "x86_64-uefi"]) {
        try expectSupport(text, SystemSupport.Unsupported);
    }
}

test "the system part is everything after the processor and the vendor" {
    try testing.assertEqual(triple.read("x86_64-pc-windows-msvc").system(), "windows-msvc");
    try testing.assertEqual(triple.read("x86_64-unknown-freebsd").system(), "freebsd");
    try testing.assertEqual(triple.read("x86_64-linux-gnu").system(), "linux-gnu");
    try testing.assertEqual(triple.read("aarch64-linux-android").system(), "linux-android");
    try testing.assertEqual(triple.read("x86_64-uefi").system(), "uefi");
    try testing.assertEqual(triple.read("x86_64").system(), "");
    try testing.assertEqual(triple.read("x86_64-").system(), "");
}

test "a Linux system names its C library after 'linux-'" {
    try testing.assertEqual(triple.read("aarch64-unknown-linux-gnueabihf").linuxLibrary(),
        "gnueabihf");
    try testing.assertEqual(triple.read("x86_64-linux-musl").linuxLibrary(), "musl");
    try testing.assertEqual(triple.read("x86_64-unknown-linux").linuxLibrary(), "");
    try testing.assertEqual(triple.read("x86_64-pc-windows-gnu").linuxLibrary(), "");
}

test "a system this toolchain does not build for is nearest to the one it is a form of" {
    try expectNearest("x86_64-unknown-linux-musl", Platform.Linux);
    try expectNearest("aarch64-linux-android", Platform.Linux);
    try expectNearest("x86_64-unknown-freebsd", Platform.Linux);
    try expectNearest("x86_64", Platform.Linux);
    try expectNearest("x86_64-w64-mingw32", Platform.Windows);
    try expectNearest("x86_64-pc-cygwin", Platform.Windows);
    try expectNearest("x86_64-pc-windows-itanium", Platform.Windows);
    try expectNearest("arm64-apple-ios17.0", Platform.MacOS);
    try expectNearest("arm64_32-apple-watchos", Platform.MacOS);
    try expectNearest("x86_64-apple-macosx14.0-macabi", Platform.MacOS);
    try expectNearest("x86_64-pc-windows-msvc", Platform.Windows);
}

test "a triple is spelled with another processor and system around the vendor it was written with" {
    try testing.assertEqual(triple.read("x86_64-unknown-linux-musl").spelledWith("x86_64",
        "linux-gnu"), "x86_64-unknown-linux-gnu");
    try testing.assertEqual(triple.read("pdp11-dec-unix").spelledWith("x86_64", "linux-gnu"),
        "x86_64-dec-linux-gnu");
    try testing.assertEqual(triple.read("aarch64-linux-android").spelledWith("aarch64",
        "linux-gnu"), "aarch64-linux-gnu");
    try testing.assertEqual(triple.read("x86_64").spelledWith("x86_64", "linux-gnu"),
        "x86_64-unknown-linux-gnu");
    try testing.assertEqual(triple.read("x86_64-").spelledWith("x86_64", "linux-gnu"),
        "x86_64-unknown-linux-gnu");
    try testing.assertEqual(triple.read("-unknown-linux-gnu").spelledWith("x86_64", "linux-gnu"),
        "x86_64-unknown-linux-gnu");
}

// Each version is the 'minos' LLVM writes into the objects of a build for that triple, so the
// link line that reads it deploys to the version its objects were built for.
test "a macOS target runs on the version its system names, the way LLVM reads it" {
    try expectMacosVersion("arm64-apple-macosx14.0", "14.0");
    try expectMacosVersion("arm64-apple-macosx13", "13");
    try expectMacosVersion("x86_64-apple-macosx10.15.4", "10.15.4");
    try expectMacosVersion("arm64-apple-macos14.0", "14.0");
    try expectMacosVersion("x86_64-apple-darwin4", "10.0");
    try expectMacosVersion("x86_64-apple-darwin19.6.0", "10.15");
    try expectMacosVersion("x86_64-apple-darwin20", "11.0");
    try expectMacosVersion("x86_64-apple-darwin23", "14.0");
    try expectMacosVersion("x86_64-apple-darwin23.6.0", "14.0");
    try expectMacosVersion("x86_64-apple-darwin24.1", "15.0");
    try expectMacosVersion("arm64-apple-darwin25.5.0", "26.0");
}

test "a macOS target with no version, or none a macOS has, runs on the oldest one Ens builds for" {
    for (let text in ["arm64-apple-macosx", "x86_64-apple-macos", "x86_64-apple-darwin",
            "x86_64-apple-darwin3", "x86_64-apple-macosx0"]) {
        try expectMacosVersion(text, Macos.oldestVersion);
    }
}

test "a 64-bit ARM macOS target runs on nothing older than macOS 11" {
    try expectMacosVersion("arm64-apple-macosx10.15", "11.0");
    try expectMacosVersion("aarch64-apple-darwin19", "11.0");
    try expectMacosVersion("x86_64-apple-macosx10.15", "10.15");
}

test "a machine naming itself by its kernel is built for the oldest supported system" {
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-darwin25.5.0"),
        "arm64-apple-macosx11.0");
    try testing.assertEqual(triple.defaultTargetFor("x86_64-apple-darwin23.6.0"),
        "x86_64-apple-macosx11.0");
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-darwin"),
        "arm64-apple-macosx11.0");
    try expectMacosVersion(triple.defaultTargetFor("arm64-apple-darwin25.5.0"),
        Macos.oldestVersion);
}

test "the target a machine already names the way a build requires is left alone" {
    try testing.assertEqual(triple.defaultTargetFor("x86_64-pc-windows-msvc"),
        "x86_64-pc-windows-msvc");
    try testing.assertEqual(triple.defaultTargetFor("x86_64-unknown-linux-gnu"),
        "x86_64-unknown-linux-gnu");
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-macosx14.0"),
        "arm64-apple-macosx14.0");
    try testing.assertEqual(triple.defaultTargetFor("x86_64-alpine-linux-musl"),
        "x86_64-alpine-linux-musl");
}

test "a target runs on a machine of the same processor and system, however each is spelled" {
    try expectRunsOn("amd64-unknown-linux-gnu", "x86_64-pc-linux-gnu");
    try expectRunsOn("arm64-unknown-linux-gnu", "aarch64-unknown-linux-gnu");
    try expectRunsOn("arm64-apple-macosx14.0", "arm64-apple-macosx11.0");
    try expectRunsOn("x86_64-pc-windows-msvc", "x86_64-pc-win32");
    try expectRunsOn("x86_64-pc-windows-msvc19.40.0", "x86_64-pc-windows-msvc");
    try testing.assertFalse(parsed("x86_64-unknown-linux-gnu").runsOn(
        parsed("aarch64-unknown-linux-gnu")), "two processors ran alike");
    try testing.assertFalse(parsed("x86_64-unknown-linux-gnu").runsOn(
        parsed("x86_64-pc-windows-msvc")), "two systems ran alike");
}

expectArchitecture(string text, Architecture expected) throws {
    try testing.assertTrue(parsed(text).architecture() == expected,
        "'{text}' did not name {expected}");
    try testing.assertTrue(triple.read(text).supportsProcessor(),
        "'{text}' did not support its processor on its own");
}

expectNone(string text) throws {
    try testing.assertTrue(TargetTriple.parse(text) == null, "'{text}' was parsed");
}

expectPlatform(string text, Platform expected) throws {
    try testing.assertTrue(parsed(text).platform() == expected, "'{text}' did not name {expected}");
    try testing.assertTrue(triple.read(text).systemSupport() == SystemSupport.Supported,
        "'{text}' did not support its system");
    try testing.assertTrue(triple.read(text).nearestPlatform() == expected,
        "'{text}' was nearest to {triple.read(text).nearestPlatform()}");
}

expectSupport(string text, SystemSupport expected) throws {
    let found = triple.read(text).systemSupport();
    try testing.assertTrue(found == expected, "'{text}' was {found}, not {expected}");
    try expectNone(text);
}

expectNearest(string text, Platform expected) throws {
    let found = triple.read(text).nearestPlatform();
    try testing.assertTrue(found == expected, "'{text}' was nearest to {found}, not {expected}");
}

expectMacosVersion(string text, string expected) throws {
    try testing.assertEqual(parsed(text).macosVersion(), expected);
}

expectRunsOn(string target, string machine) throws {
    try testing.assertTrue(parsed(target).runsOn(parsed(machine)),
        "'{target}' did not run on '{machine}'");
}

parsed(string text) -> TargetTriple {
    let read = TargetTriple.parse(text);
    if (read == null) {
        panic("'{text}' was not parsed");
    }
    return read;
}
