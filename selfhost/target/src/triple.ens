// A target triple read once, into the processor it names. Code that depends on the processor
// switches on the value read here and never reads the text again.

// The processors this toolchain builds for.
export enum Architecture {
    // 64-bit Intel and AMD processors, written 'x86_64' or 'amd64'.
    X64,

    // 64-bit ARM processors, written 'aarch64' or 'arm64'.
    Arm64,
}

// A triple this toolchain builds for: the text as written, which is what LLVM and the build's
// folders read, and the processor it names.
export final class TargetTriple {
    string tripleText;
    Architecture tripleArchitecture;

    protected constructor(this.tripleText, this.tripleArchitecture);

    // The target `text` names, or null when its first part names no processor this toolchain
    // builds for.
    export static parse(string text) -> TargetTriple? {
        let named = architectureOf(text);
        if (named == null) {
            return null;
        }
        return new TargetTriple(text, named);
    }

    export text() -> string {
        return this.tripleText;
    }

    export architecture() -> Architecture {
        return this.tripleArchitecture;
    }
}

// The processor the triple's first part names, or null when it names one this toolchain does not
// build for, such as the 32-bit Intel 'i686' or the big-endian ARM 'aarch64_be'.
export architectureOf(string text) -> Architecture? {
    return switch (processorPart(text)) {
        "x86_64", "amd64" -> Architecture.X64,
        "aarch64", "arm64" -> Architecture.Arm64,
        default -> null,
    };
}

// The first part of the triple as written, which names its processor, and empty text when the
// triple starts with '-' or is empty.
export processorPart(string text) -> string {
    long dash = text.indexOf("-");
    if (dash < 0) {
        return text;
    }
    return text.substring(0, dash);
}
