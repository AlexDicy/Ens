// Semantic checks over a parsed grammar. Every error names its offender; the order follows the
// declaration order of the grammar file.
import List from @std.collections.list;
import Map from @std.collections.map;
import model;
import Grammar from model;
import GrammarIndex from model;
import SlotReference from model;
import NodeRuleDeclaration from model;

public validate(Grammar grammar) -> List<string> {
    let errors = new List<string>();
    let index = model.buildIndex(grammar);
    checkDuplicateNames(grammar, errors);
    checkTokens(grammar, errors);
    checkTokenSets(grammar, index, errors);
    checkCategories(grammar, index, errors);
    checkUnions(grammar, index, errors);
    checkRules(grammar, index, errors);
    return errors;
}

checkDuplicateNames(Grammar grammar, List<string> errors) {
    let seen = new Map<string, bool>();
    for (long i = 0; i < grammar.tokens.length(); i++) {
        checkName(grammar.tokens.get(i).name, seen, errors);
    }
    for (long i = 0; i < grammar.tokenSets.length(); i++) {
        checkName(grammar.tokenSets.get(i).name, seen, errors);
    }
    for (long i = 0; i < grammar.categories.length(); i++) {
        checkName(grammar.categories.get(i).name, seen, errors);
    }
    for (long i = 0; i < grammar.unions.length(); i++) {
        checkName(grammar.unions.get(i).name, seen, errors);
    }
    for (long i = 0; i < grammar.rules.length(); i++) {
        checkName(grammar.rules.get(i).name, seen, errors);
    }
}

checkName(string name, Map<string, bool> seen, List<string> errors) {
    if (name == "List") {
        errors.push("the name 'List' is taken by the kind every list slot uses. Rename this "
            + "declaration");
        return;
    }
    if (seen.contains(name)) {
        errors.push("'{name}' is declared more than once. Give each declaration its own name, or "
            + "remove the extra ones");
        return;
    }
    seen.set(name, true);
}

checkTokens(Grammar grammar, List<string> errors) {
    for (long i = 0; i < grammar.tokens.length(); i++) {
        let token = grammar.tokens.get(i);
        if (token.isContextual && token.spelling == null) {
            errors.push("contextual token '{token.name}' has no spelling. Give it one after '=', "
                + "as in '{token.name} = 'word' contextual'");
        }
    }
}

checkTokenSets(Grammar grammar, GrammarIndex index, List<string> errors) {
    for (long i = 0; i < grammar.tokenSets.length(); i++) {
        let tokenSet = grammar.tokenSets.get(i);
        for (long j = 0; j < tokenSet.members.length(); j++) {
            let member = tokenSet.members.get(j);
            let described = describeSpelledTokenReference(member, index,
                "List only tokens that have a spelling");
            if (described != "") {
                errors.push("token set '{tokenSet.name}' {described}");
            }
        }
    }
}

// Empty when the reference resolves to a token with a fixed spelling; otherwise a phrase describing
// what went wrong. spellingFix ends the phrase for a token that has no spelling.
describeSpelledTokenReference(SlotReference reference, GrammarIndex index,
                              string spellingFix) -> string {
    if (reference.isSpelling) {
        if (index.tokensBySpelling.contains(reference.text)) {
            return "";
        }
        return "references unknown spelling '{reference.text}'";
    }
    let token = index.tokensByName.get(reference.text);
    if (token == null) {
        return "references undefined token '{reference.text}'";
    }
    if (token.spelling == null) {
        return "names token '{reference.text}', which has no fixed spelling, so a node cannot "
            + "print it back. {spellingFix}";
    }
    return "";
}

checkCategories(Grammar grammar, GrammarIndex index, List<string> errors) {
    let firstCategory = new Map<string, string>();
    for (long i = 0; i < grammar.categories.length(); i++) {
        let category = grammar.categories.get(i);
        for (long j = 0; j < category.members.length(); j++) {
            let member = category.members.get(j);
            if (!index.rulesByName.contains(member)) {
                if (isDefinedName(member, index)) {
                    errors.push("category '{category.name}' lists '{member}', which is not a node");
                } else {
                    errors.push("category '{category.name}' lists undefined node '{member}'");
                }
            } else {
                let existing = firstCategory.get(member);
                if (existing == null) {
                    firstCategory.set(member, category.name);
                } else {
                    errors.push("node '{member}' is in two categories, '{existing}' and "
                        + "'{category.name}'. Remove it from one of them");
                }
            }
        }
    }
}

checkUnions(Grammar grammar, GrammarIndex index, List<string> errors) {
    for (long i = 0; i < grammar.unions.length(); i++) {
        let union = grammar.unions.get(i);
        for (long j = 0; j < union.members.length(); j++) {
            let member = union.members.get(j);
            if (!index.rulesByName.contains(member) && !index.categoriesByName.contains(member)) {
                if (isDefinedName(member, index)) {
                    errors.push("union '{union.name}' lists '{member}', which is not a node or category");
                } else {
                    errors.push("union '{union.name}' lists undefined name '{member}'");
                }
            }
        }
    }
}

isDefinedName(string name, GrammarIndex index) -> bool {
    if (index.tokensByName.contains(name)) {
        return true;
    }
    if (index.tokenSetsByName.contains(name)) {
        return true;
    }
    if (index.categoriesByName.contains(name)) {
        return true;
    }
    if (index.unionsByName.contains(name)) {
        return true;
    }
    return index.rulesByName.contains(name);
}

checkRules(Grammar grammar, GrammarIndex index, List<string> errors) {
    for (long i = 0; i < grammar.rules.length(); i++) {
        checkRule(grammar.rules.get(i), index, errors);
        checkRecoveryNaming(grammar.rules.get(i), index, errors);
    }
}

// Recovery rules are recognized by their shape, and the front end reads that as "the parser could
// not make sense of this region". Their names have to agree with it, both ways: a rule shaped like
// one and named otherwise would be a recovery node nobody reading the grammar would recognize, and
// a rule named 'Error<category>' without the shape would be a language construct the compiler
// treats as damage.
checkRecoveryNaming(NodeRuleDeclaration rule, GrammarIndex index, List<string> errors) {
    let category = index.categoryByRule.get(rule.name);
    bool shaped = model.isRecoveryRule(rule);
    if (shaped) {
        if (category == null) {
            errors.push("rule '{rule.name}' has the shape of a recovery node ('skipped: token*') "
                + "but belongs to no category. A recovery node replaces a node of one category, "
                + "so add it to one or change its slots");
        } else if (rule.name != model.recoveryRuleName(category)) {
            errors.push("recovery rule '{rule.name}' must be named "
                + "'{model.recoveryRuleName(category)}', after its category '{category}'. Rename it");
        }
        return;
    }
    if (category != null && rule.name == model.recoveryRuleName(category)) {
        errors.push("rule '{rule.name}' has a recovery node's name but not its shape. A recovery "
            + "node has one slot, 'skipped: token*'. Rename the rule or give it that slot");
    }
}

checkRule(NodeRuleDeclaration rule, GrammarIndex index, List<string> errors) {
    let seenNames = new Map<string, bool>();
    for (long i = 0; i < rule.slots.length(); i++) {
        let slot = rule.slots.get(i);
        let slotName = slot.name;
        if (slotName != null) {
            if (seenNames.contains(slotName)) {
                errors.push("rule '{rule.name}' declares slot '{slotName}' more than once. Give "
                    + "each slot its own name");
            } else {
                seenNames.set(slotName, true);
            }
            checkSlotName(slotName, rule.name, index, errors);
        }
        bool hasToken = false;
        bool hasNode = false;
        for (long j = 0; j < slot.references.length(); j++) {
            let reference = slot.references.get(j);
            if (reference.isSpelling) {
                hasToken = true;
                if (!index.tokensBySpelling.contains(reference.text)) {
                    errors.push("rule '{rule.name}' references unknown spelling '{reference.text}'");
                }
            } else if (reference.text == "token"
                    || index.tokensByName.contains(reference.text)
                    || index.tokenSetsByName.contains(reference.text)) {
                hasToken = true;
            } else if (index.rulesByName.contains(reference.text)
                    || index.categoriesByName.contains(reference.text)
                    || index.unionsByName.contains(reference.text)) {
                hasNode = true;
            } else {
                errors.push("rule '{rule.name}' references undefined name '{reference.text}'");
            }
        }
        let slotLabel = describeSlot(slot.name, i);
        if (hasToken && hasNode && slot.isList) {
            errors.push("slot '{slotLabel}' in rule '{rule.name}' lists both tokens and nodes. A "
                + "list slot contains one or the other, so split it into two slots");
        }
        let separator = slot.separator;
        if (separator != null) {
            let described = describeSpelledTokenReference(separator, index,
                "Use a token that has a spelling as the separator");
            if (described != "") {
                errors.push("separator of slot '{slotLabel}' in rule '{rule.name}' {described}");
            }
        }
    }
}

// Accessors become methods on the generated classes, so a slot name must stay a valid method name
// and must not shadow a SyntaxNode member.
checkSlotName(string name, string ruleName, GrammarIndex index, List<string> errors) {
    let token = index.tokensBySpelling.get(name);
    if (token != null && !token.isContextual) {
        errors.push("slot name '{name}' in rule '{ruleName}' is an Ens keyword. Rename the slot");
    }
    if (name == "kind" || name == "green" || name == "parent" || name == "fullText"
            || name == "fullSpan" || name == "span" || name == "firstToken" || name == "lastToken") {
        errors.push("slot name '{name}' in rule '{ruleName}' is already a SyntaxNode member. "
            + "Rename the slot");
    }
}

describeSlot(string? name, long index) -> string {
    if (name != null) {
        return name;
    }
    return "#{index}";
}
