// In-memory form of a parsed syntax.grammar file, plus the name index the validator and emitter
// share. Declaration order is preserved everywhere so emission stays deterministic.
import List from @std.collections.list;
import Map from @std.collections.map;

public class TokenDeclaration {
    public string name;
    public string? spelling;
    public bool isContextual;
    public bool isTrivia;

    public constructor(this.name, this.spelling, this.isContextual, this.isTrivia);
}

// One alternative inside a slot type, a token set, or a separator: either a quoted spelling or a
// bare name to resolve against the declarations.
public class SlotReference {
    public string text;
    public bool isSpelling;

    public constructor(this.text, this.isSpelling);
}

public class TokenSetDeclaration {
    public string name;
    public List<SlotReference> members;

    public constructor(this.name, this.members);
}

public class CategoryDeclaration {
    public string name;
    public List<string> members;

    public constructor(this.name, this.members);
}

public class UnionDeclaration {
    public string name;
    public List<string> members;

    public constructor(this.name, this.members);
}

public class SlotDeclaration {
    public string? name;
    public List<SlotReference> references;
    public bool isOptional;
    public bool isList;
    public SlotReference? separator;

    public constructor(this.name, this.references, this.isOptional, this.isList, this.separator);
}

public class NodeRuleDeclaration {
    public string name;
    public List<SlotDeclaration> slots;

    public constructor(this.name, this.slots);
}

// A recovery rule stands in for a region the parser could not read, and holds nothing but the run
// of tokens it skipped: `skipped: token*` and no other slot. Nothing a language construct could
// need has that shape, so it identifies recovery rules without reading their names, and the
// validator holds the two in step by requiring each to be named 'Error' plus its category.
public isRecoveryRule(NodeRuleDeclaration rule) -> bool {
    if (rule.slots.length() != 1) {
        return false;
    }
    let slot = rule.slots.get(0);
    if (slot.name != "skipped" || !slot.isList || slot.separator != null) {
        return false;
    }
    if (slot.references.length() != 1) {
        return false;
    }
    let reference = slot.references.get(0);
    return !reference.isSpelling && reference.text == "token";
}

public recoveryRuleName(string categoryName) -> string {
    return "Error" + categoryName;
}

public class Grammar {
    public List<TokenDeclaration> tokens;
    public List<TokenSetDeclaration> tokenSets;
    public List<CategoryDeclaration> categories;
    public List<UnionDeclaration> unions;
    public List<NodeRuleDeclaration> rules;

    public constructor() {
        this.tokens = new List<TokenDeclaration>();
        this.tokenSets = new List<TokenSetDeclaration>();
        this.categories = new List<CategoryDeclaration>();
        this.unions = new List<UnionDeclaration>();
        this.rules = new List<NodeRuleDeclaration>();
    }
}

public class GrammarIndex {
    public Map<string, TokenDeclaration> tokensByName;
    public Map<string, TokenDeclaration> tokensBySpelling;
    public Map<string, TokenSetDeclaration> tokenSetsByName;
    public Map<string, CategoryDeclaration> categoriesByName;
    public Map<string, UnionDeclaration> unionsByName;
    public Map<string, NodeRuleDeclaration> rulesByName;

    public Map<string, string> categoryByRule;
    public Map<string, List<string>> unionsByMember;

    protected constructor() {
        this.tokensByName = new Map<string, TokenDeclaration>();
        this.tokensBySpelling = new Map<string, TokenDeclaration>();
        this.tokenSetsByName = new Map<string, TokenSetDeclaration>();
        this.categoriesByName = new Map<string, CategoryDeclaration>();
        this.unionsByName = new Map<string, UnionDeclaration>();
        this.rulesByName = new Map<string, NodeRuleDeclaration>();

        this.categoryByRule = new Map<string, string>();
        this.unionsByMember = new Map<string, List<string>>();
    }
}

public buildIndex(Grammar grammar) -> GrammarIndex {
    let index = new GrammarIndex();
    for (long i = 0; i < grammar.tokens.length(); i++) {
        let token = grammar.tokens.get(i);
        index.tokensByName.set(token.name, token);
        let spelling = token.spelling;
        if (spelling != null) {
            index.tokensBySpelling.set(spelling, token);
        }
    }
    for (long i = 0; i < grammar.tokenSets.length(); i++) {
        let tokenSet = grammar.tokenSets.get(i);
        index.tokenSetsByName.set(tokenSet.name, tokenSet);
    }
    for (long i = 0; i < grammar.categories.length(); i++) {
        let category = grammar.categories.get(i);
        index.categoriesByName.set(category.name, category);
        for (long j = 0; j < category.members.length(); j++) {
            index.categoryByRule.set(category.members.get(j), category.name);
        }
    }
    for (long i = 0; i < grammar.unions.length(); i++) {
        let union = grammar.unions.get(i);
        index.unionsByName.set(union.name, union);
        for (long j = 0; j < union.members.length(); j++) {
            let member = union.members.get(j);
            let existing = index.unionsByMember.get(member);
            if (existing == null) {
                let created = new List<string>();
                created.push(union.name);
                index.unionsByMember.set(member, created);
            } else {
                existing.push(union.name);
            }
        }
    }
    for (long i = 0; i < grammar.rules.length(); i++) {
        let rule = grammar.rules.get(i);
        index.rulesByName.set(rule.name, rule);
    }
    return index;
}
