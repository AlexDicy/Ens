// syntaxgen reads a syntax.grammar file, validates it, and regenerates the syntax tree modules of
// the self-hosted front end. Emission is deterministic, so the same grammar always produces
// byte-identical files.
import FileSystemError from @std.fs.error;
import Path from @std.fs;
import @std.environment;
import @std.system;
import List from @std.collections.list;
import parser;
import validator;
import emitter;

// Build and run from the repository root:
//     ens build selfhost/syntaxgen --output build/syntaxgen.exe
//     build/syntaxgen.exe [grammar-path] [output-folder]
// grammar-path defaults to selfhost/syntax.grammar and output-folder to
// selfhost/frontend/src/syntax/generated.
main() -> int {
    string[] arguments = environment.arguments();
    string grammarPath = "selfhost/syntax.grammar";
    if (arguments.length > 0) {
        grammarPath = arguments[0];
    }
    string outputFolder = "selfhost/frontend/src/syntax/generated";
    if (arguments.length > 1) {
        outputFolder = arguments[1];
    }
    string text = try Path(grammarPath).readText();
    let result = parser.parseGrammar(text);
    if (result.errors.length() > 0) {
        printErrors(grammarPath, result.errors);
        return 1;
    }
    let errors = validator.validate(result.grammar);
    if (errors.length() > 0) {
        printErrors(grammarPath, errors);
        return 1;
    }
    try Path("{outputFolder}/kind.ens").writeText(emitter.emitKindModule(result.grammar));
    try Path("{outputFolder}/nodes.ens").writeText(emitter.emitNodesModule(result.grammar));
    try Path("{outputFolder}/factory.ens").writeText(emitter.emitFactoryModule(result.grammar));
    try Path("{outputFolder}/dump.ens").writeText(emitter.emitDumpModule());
    print("syntaxgen: wrote kind.ens, nodes.ens, factory.ens, and dump.ens to {outputFolder}");
    return 0;
} catch (FileSystemError e) {
    print("syntaxgen: {e.message}");
    return 1;
}

printErrors(string grammarPath, List<string> errors) {
    for (long i = 0; i < errors.length(); i++) {
        let message = errors.get(i);
        print("{grammarPath}: {message}");
    }
}
