// syntaxgen reads a syntax.grammar file, validates it, and regenerates the syntax tree modules
// (kind.ens, nodes.ens, factory.ens, dump.ens) of the self-hosted front end. Emission is
// deterministic: the same grammar always produces byte-identical files.
//
// Build and run from the repository root:
//     xmake build ens
//     build/windows/x64/release/ens.exe build selfhost/syntaxgen --output build/syntaxgen.exe
//     build/syntaxgen.exe [grammar-path] [output-folder]
//
// grammar-path defaults to selfhost/syntax.grammar and output-folder to
// selfhost/frontend/src/syntax/generated.
import @std.system;
import SystemError from @std.system;
import List from @std.collections.list;
import parser;
import validator;
import emitter;

main() -> int {
    string[] arguments = system.arguments();
    string grammarPath = "selfhost/syntax.grammar";
    if (arguments.length > 1) {
        grammarPath = arguments[1];
    }
    string outputFolder = "selfhost/frontend/src/syntax/generated";
    if (arguments.length > 2) {
        outputFolder = arguments[2];
    }
    string text = try system.readAllText(grammarPath);
    let result = parser.parseGrammar(text);
    if (result.errors.length() > 0) {
        printErrors(grammarPath, result.errors);
        return 1;
    }
    let errors = validator.validate(result.grammar);
    if (errors.length() > 0) {
        printErrors(grammarPath, errors);
        return 1;
    }
    try system.writeAllText("{outputFolder}/kind.ens", emitter.emitKindModule(result.grammar));
    try system.writeAllText("{outputFolder}/nodes.ens", emitter.emitNodesModule(result.grammar));
    try system.writeAllText("{outputFolder}/factory.ens", emitter.emitFactoryModule(result.grammar));
    try system.writeAllText("{outputFolder}/dump.ens", emitter.emitDumpModule());
    print("syntaxgen: wrote kind.ens, nodes.ens, factory.ens, and dump.ens to {outputFolder}");
    return 0;
} catch (SystemError e) {
    print("syntaxgen: {e.message}");
    return 1;
}

printErrors(string grammarPath, List<string> errors) {
    for (long i = 0; i < errors.length(); i++) {
        let message = errors.get(i);
        print("{grammarPath}: {message}");
    }
}
