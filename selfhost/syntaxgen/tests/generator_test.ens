import @std.testing;
import parser;
import validator;
import emitter;

// A small grammar exercising every DSL form: trivia and contextual tokens,
// spellings, a token set, a category, a union with a category member, and
// rules with anonymous, optional, list, group, mixed, and any-token slots.
smallGrammar() -> string {
    return "tokens \{\n"
        + "    Whitespace trivia\n"
        + "    EndOfFile\n"
        + "    Identifier\n"
        + "    IntLiteral\n"
        + "    OpenParenthesis = '('\n"
        + "    CloseParenthesis = ')'\n"
        + "    Comma = ','\n"
        + "    Semicolon = ';'\n"
        + "    BreakKeyword = 'break'\n"
        + "    OutKeyword = 'out' contextual\n"
        + "    PublicKeyword = 'public'\n"
        + "\}\n"
        + "tokenset Modifier = 'public'\n"
        + "Expression = LiteralExpression | CallExpression | ErrorExpression\n"
        + "union Item = Expression | ArgumentList\n"
        + "LiteralExpression = value: IntLiteral\n"
        + "CallExpression = callee: Expression arguments: ArgumentList\n"
        + "ArgumentList = '(' arguments: Expression* sep ',' ')'\n"
        + "BreakStatement = modifiers: Modifier* 'break' name: Identifier? ';'\n"
        + "Doubled = '(' ')' '(' ')'\n"
        + "Described = description: (IntLiteral | LiteralExpression) target: ArgumentList? operator: ('(' | ')')\n"
        + "ErrorExpression = skipped: token*\n";
}

test "the DSL parser reads tokens, sets, categories, unions, and rules" {
    let result = parser.parseGrammar(smallGrammar());
    try testing.assertEqual(result.errors.length(), 0L);
    let grammar = result.grammar;

    try testing.assertEqual(grammar.tokens.length(), 11L);
    let whitespace = grammar.tokens.get(0);
    try testing.assertEqual(whitespace.name, "Whitespace");
    try testing.assertTrue(whitespace.isTrivia, "whitespace is trivia");
    try testing.assertTrue(whitespace.spelling == null, "trivia has no spelling");
    let openParenthesis = grammar.tokens.get(4);
    try testing.assertEqual(openParenthesis.spelling ?? "", "(");
    try testing.assertFalse(openParenthesis.isTrivia, "punctuation is not trivia");
    let outKeyword = grammar.tokens.get(9);
    try testing.assertTrue(outKeyword.isContextual, "out is contextual");
    try testing.assertEqual(outKeyword.spelling ?? "", "out");

    try testing.assertEqual(grammar.tokenSets.length(), 1L);
    let modifier = grammar.tokenSets.get(0);
    try testing.assertEqual(modifier.name, "Modifier");
    try testing.assertEqual(modifier.members.length(), 1L);
    try testing.assertTrue(modifier.members.get(0).isSpelling, "set members are spellings");

    try testing.assertEqual(grammar.categories.length(), 1L);
    let category = grammar.categories.get(0);
    try testing.assertEqual(category.name, "Expression");
    try testing.assertEqual(category.members.length(), 3L);
    try testing.assertEqual(category.members.get(2), "ErrorExpression");

    try testing.assertEqual(grammar.unions.length(), 1L);
    let item = grammar.unions.get(0);
    try testing.assertEqual(item.members.length(), 2L);
    try testing.assertEqual(item.members.get(0), "Expression");

    try testing.assertEqual(grammar.rules.length(), 7L);
}

test "the DSL parser shapes every slot form" {
    let result = parser.parseGrammar(smallGrammar());
    try testing.assertEqual(result.errors.length(), 0L);
    let grammar = result.grammar;

    let argumentList = grammar.rules.get(2);
    try testing.assertEqual(argumentList.name, "ArgumentList");
    try testing.assertEqual(argumentList.slots.length(), 3L);
    let anonymous = argumentList.slots.get(0);
    try testing.assertTrue(anonymous.name == null, "quoted slots are anonymous");
    try testing.assertTrue(anonymous.references.get(0).isSpelling, "quoted slots hold spellings");
    let arguments = argumentList.slots.get(1);
    try testing.assertEqual(arguments.name ?? "", "arguments");
    try testing.assertTrue(arguments.isList, "starred slots are lists");
    let separator = arguments.separator;
    if (separator == null) {
        try testing.fail("the arguments list should have a separator");
    } else {
        try testing.assertEqual(separator.text, ",");
    }

    let breakStatement = grammar.rules.get(3);
    try testing.assertEqual(breakStatement.slots.length(), 4L);
    try testing.assertTrue(breakStatement.slots.get(0).isList, "token set slots can be lists");
    try testing.assertTrue(breakStatement.slots.get(0).separator == null, "plain lists have no separator");
    try testing.assertTrue(breakStatement.slots.get(2).isOptional, "question marks optional slots");

    let described = grammar.rules.get(5);
    try testing.assertEqual(described.slots.get(0).references.length(), 2L);
    try testing.assertTrue(described.slots.get(1).isOptional, "optional node slot");
    try testing.assertEqual(described.slots.get(2).references.length(), 2L);
    try testing.assertTrue(described.slots.get(2).references.get(1).isSpelling, "groups accept spellings");

    let errorExpression = grammar.rules.get(6);
    try testing.assertEqual(errorExpression.slots.get(0).references.get(0).text, "token");
    try testing.assertTrue(errorExpression.slots.get(0).isList, "any-token slots are lists");
}

test "emission is deterministic" {
    let first = parser.parseGrammar(smallGrammar());
    let second = parser.parseGrammar(smallGrammar());
    try testing.assertEqual(validator.validate(first.grammar).length(), 0L);
    try testing.assertTrue(emitter.emitKindModule(first.grammar) == emitter.emitKindModule(second.grammar),
        "kind emission is byte-identical");
    try testing.assertTrue(emitter.emitNodesModule(first.grammar) == emitter.emitNodesModule(second.grammar),
        "nodes emission is byte-identical");
    try testing.assertTrue(emitter.emitFactoryModule(first.grammar) == emitter.emitFactoryModule(second.grammar),
        "factory emission is byte-identical");
    try testing.assertTrue(emitter.emitDumpModule() == emitter.emitDumpModule(),
        "dump emission is byte-identical");
}

test "the kind module lists kinds, predicates, and text lookups" {
    let result = parser.parseGrammar(smallGrammar());
    let kindModule = emitter.emitKindModule(result.grammar);
    try testing.assertTrue(kindModule.contains("// Generated by syntaxgen from selfhost/syntax.grammar. Do not edit."),
        "the header marks the file as generated");
    try testing.assertTrue(kindModule.contains("export enum SyntaxKind \{"), "the enum is emitted");
    try testing.assertTrue(kindModule.contains("    BreakStatement,"), "rules become kinds");
    try testing.assertTrue(kindModule.contains("    List,"), "the synthetic list kind is emitted");
    try testing.assertTrue(kindModule.contains("        Whitespace -> true,"), "isTrivia lists trivia");
    try testing.assertTrue(kindModule.contains("export isExpressionKind(SyntaxKind kind) -> bool \{"),
        "category predicates are emitted");
    try testing.assertTrue(kindModule.contains("        \"break\" -> SyntaxKind.BreakKeyword,"),
        "reserved keywords map from text");
    try testing.assertTrue(kindModule.contains("        \"out\" -> SyntaxKind.OutKeyword,"),
        "contextual keywords map from text");
    try testing.assertTrue(kindModule.indexOf("\"out\" -> SyntaxKind.OutKeyword,")
            > kindModule.indexOf("export contextualKeywordFromText(string text) -> SyntaxKind? \{"),
        "out only appears in the contextual lookup");
    try testing.assertTrue(kindModule.contains("        BreakStatement -> \"BreakStatement\","),
        "kindName covers every kind");
}

test "the nodes module shapes classes, accessors, and lists" {
    let result = parser.parseGrammar(smallGrammar());
    let nodesModule = emitter.emitNodesModule(result.grammar);
    try testing.assertTrue(nodesModule.contains("export interface Item \{ \}"), "unions become marker interfaces");
    try testing.assertTrue(nodesModule.contains("export sealed abstract class Expression extends SyntaxNode implements Item \{"),
        "categories become sealed classes carrying their unions");
    try testing.assertTrue(nodesModule.contains("export class LiteralExpressionNode extends Expression \{"),
        "nodes extend their category");
    try testing.assertTrue(nodesModule.contains("export class ArgumentListNode extends SyntaxNode implements Item \{"),
        "uncategorized nodes extend SyntaxNode and carry their unions");
    try testing.assertTrue(nodesModule.contains("export class ListNode extends SyntaxNode \{"),
        "the list node is emitted");
    try testing.assertTrue(nodesModule.contains("    export argumentsCount() -> long \{"), "lists get count accessors");
    try testing.assertTrue(nodesModule.contains("            return (list.childCount() + 1) / 2;"),
        "separated lists halve the child count");
    try testing.assertTrue(nodesModule.contains("            let node = list.childNodeAt(index * 2);"),
        "separated lists read elements at even children");
    try testing.assertTrue(nodesModule.contains("    export breakKeyword() -> SyntaxToken \{"),
        "anonymous tokens take their kind name");
    try testing.assertTrue(nodesModule.contains("    export openParenthesis2() -> SyntaxToken \{"),
        "repeated anonymous kinds get numeric suffixes");
    try testing.assertTrue(nodesModule.contains("    export descriptionToken() -> SyntaxToken? \{"),
        "mixed slots expose a token accessor");
    try testing.assertTrue(nodesModule.contains("    export descriptionNode() -> LiteralExpressionNode? \{"),
        "mixed slots expose a typed node accessor");
    try testing.assertTrue(nodesModule.contains("        return node as? ArgumentListNode;"),
        "optional node slots narrow with as?");
    try testing.assertTrue(nodesModule.contains("    export skipped(long index) -> SyntaxToken \{"),
        "any-token lists read tokens");
}

test "the factory module switches over every node kind" {
    let result = parser.parseGrammar(smallGrammar());
    let factoryModule = emitter.emitFactoryModule(result.grammar);
    try testing.assertTrue(factoryModule.contains("export class SyntaxNodeFactory implements NodeFactory \{"),
        "the factory implements NodeFactory");
    try testing.assertTrue(factoryModule.contains("            LiteralExpression -> \{ return new LiteralExpressionNode(green, fullStart, parent, this); \},"),
        "every rule constructs its typed class");
    try testing.assertTrue(factoryModule.contains("            List -> \{ return new ListNode(green, fullStart, parent, this); \},"),
        "the list kind constructs ListNode");
    try testing.assertTrue(factoryModule.contains("export createRoot(GreenNode green) -> SyntaxNode \{"),
        "createRoot is emitted");
    let dumpModule = emitter.emitDumpModule();
    try testing.assertTrue(dumpModule.contains("public dumpTree(SyntaxNode root) -> string \{"),
        "the dump module exposes dumpTree");
}
