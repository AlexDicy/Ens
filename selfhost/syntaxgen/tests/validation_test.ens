import @std.testing;
import Vector from @std.vector;
import parser;
import validator;

private errorsFor(string source) -> Vector<string> {
    let result = parser.parseGrammar(source);
    if (result.errors.length() > 0) {
        return result.errors;
    }
    return validator.validate(result.grammar);
}

private assertFirstError(string source, string needle) throws {
    let errors = errorsFor(source);
    try testing.assertTrue(errors.length() > 0, "expected an error containing '{needle}'");
    let first = errors.get(0);
    try testing.assertTrue(first.contains(needle), "unexpected error: {first}");
}

test "duplicate and reserved declaration names are rejected" {
    try assertFirstError("tokens \{\n    Foo\n    Foo\n\}\n",
        "duplicate declaration of 'Foo'");
    try assertFirstError("tokens \{\n    A\n\}\nThing = name: A\nThing = value: A\n",
        "duplicate declaration of 'Thing'");
    try assertFirstError("tokens \{\n    List\n\}\n",
        "the name 'List' is reserved for the synthetic list kind");
}

test "undefined references are rejected" {
    try assertFirstError("tokens \{\n    A\n\}\nThing = name: Missing\n",
        "rule 'Thing' references undefined name 'Missing'");
    try assertFirstError("tokens \{\n    A\n\}\nThing = ';'\n",
        "rule 'Thing' references unknown spelling ';'");
    try assertFirstError("Cat = X | Y\n",
        "category 'Cat' lists undefined node 'X'");
    try assertFirstError("union U = X | Y\n",
        "union 'U' lists undefined name 'X'");
}

test "categories accept only nodes, each in one category" {
    try assertFirstError("tokens \{\n    A\n\}\nCat = A | Thing\nThing = name: A\n",
        "category 'Cat' lists 'A', which is not a node");
    try assertFirstError("tokens \{\n    A\n\}\n"
            + "CatA = Thing | Other\nCatB = Thing | Second\n"
            + "Thing = name: A\nOther = value: A\nSecond = value: A\n",
        "node 'Thing' appears in more than one category ('CatA' and 'CatB')");
}

test "unions accept nodes and categories only" {
    try assertFirstError("tokens \{\n    A\n\}\nunion U = A | Thing\nThing = name: A\n",
        "union 'U' lists 'A', which is not a node or category");
}

test "slot names must be unique, unreserved, and free of clashes" {
    try assertFirstError("tokens \{\n    A\n\}\nThing = name: A name: A\n",
        "rule 'Thing' declares slot 'name' more than once");
    try assertFirstError("tokens \{\n    TypeKeyword = 'type'\n\}\nThing = type: TypeKeyword\n",
        "slot name 'type' in rule 'Thing' is a reserved word");
    try assertFirstError("tokens \{\n    A\n\}\nThing = span: A\n",
        "slot name 'span' in rule 'Thing' collides with a SyntaxNode member");
}

test "token sets and separators need fixed spellings" {
    try assertFirstError("tokens \{\n    Identifier\n\}\ntokenset M = Identifier\n",
        "token set 'M' references token 'Identifier', which has no fixed spelling");
    try assertFirstError("tokens \{\n    A\n\}\ntokenset M = 'x'\n",
        "token set 'M' references unknown spelling 'x'");
    try assertFirstError("tokens \{\n    Identifier\n\}\nThing = items: Identifier* sep Identifier\n",
        "separator of slot 'items' in rule 'Thing' references token 'Identifier', which has no fixed spelling");
    try assertFirstError("tokens \{\n    Identifier\n\}\nThing = items: Identifier* sep '+'\n",
        "separator of slot 'items' in rule 'Thing' references unknown spelling '+'");
}

test "list slots cannot mix tokens and nodes" {
    try assertFirstError("tokens \{\n    A\n\}\nThing = xs: (A | Other)*\nOther = name: A\n",
        "slot 'xs' in rule 'Thing' mixes tokens and nodes in a list");
}

test "contextual tokens need spellings" {
    try assertFirstError("tokens \{\n    Foo contextual\n\}\n",
        "contextual token 'Foo' has no spelling");
}

test "parse errors carry the offending line" {
    let unterminated = errorsFor("tokens \{\n    A = 'x\n\}\n");
    try testing.assertTrue(unterminated.length() > 0, "expected a parse error");
    try testing.assertTrue(unterminated.get(0).contains("line 2: unterminated spelling"),
        "unexpected error: {unterminated.get(0)}");
    let missingColon = errorsFor("tokens \{\n    A\n\}\nThing = name A\n");
    try testing.assertTrue(missingColon.length() > 0, "expected a parse error");
    try testing.assertTrue(missingColon.get(0).contains("expected ':' after slot name 'name'"),
        "unexpected error: {missingColon.get(0)}");
}
