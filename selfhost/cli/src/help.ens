// The help text a command line asks for, written out of the declarations themselves so what the
// help promises and what the parser accepts can never drift apart.
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;
import @std.text.strings;
import Application from command;
import Command from command;
import CommandPath from commandpath;
import Option from option;
import Argument from argument;

// The page for the command `path` names, or the application's overview when it names none.
export text(Application application, CommandPath? path) -> string {
    if (path == null || path.atRoot()) {
        return overview(application);
    }
    return page(path);
}

// How the command is written, as a usage line: "ens build [<path>] [options]".
public usageLine(CommandPath path) -> string {
    let command = path.deepest();
    let line = new StringBuilder();
    line.append(path.label());
    if (command.commands().length > 0) {
        line.append(" <command>");
    }
    Argument[] declared = command.arguments();
    for (long i = 0; i < declared.length; i++) {
        line.append(" ");
        line.append(declared[i].spelling());
    }
    if (path.atRoot() || visibleOptions(path).length > 0) {
        line.append(" [options]");
    }
    if (command.passesThrough()) {
        line.append(" [-- <arguments>]");
    }
    return line.toString();
}

overview(Application application) -> string {
    let text = new Page();
    text.paragraph(application.summary());
    text.paragraph("Usage: " + usageLine(new CommandPath(application)));
    text.paragraph(application.details());
    commandSection(text, application);
    argumentSection(text, application);
    optionSection(text, "Options", application.options(), true);
    if (application.commands().length > 0) {
        text.paragraph("Run '" + application.name() + " help <command>' for more about one "
            + "command.");
    }
    return text.toString();
}

page(CommandPath path) -> string {
    let command = path.deepest();
    let text = new Page();
    text.paragraph(command.summary());
    text.paragraph("Usage: " + usageLine(path));
    text.paragraph(command.details());
    commandSection(text, command);
    argumentSection(text, command);
    optionSection(text, "Options", command.options(), false);
    optionSection(text, "Global options", inheritedOptions(path), false);
    if (command.commands().length > 0) {
        text.paragraph("Run '" + path.root().name() + " help " + path.text()
            + " <command>' for more about one command.");
    }
    return text.toString();
}

commandSection(Page text, Command command) {
    Command[] nested = command.commands();
    let table = new Table();
    for (long i = 0; i < nested.length; i++) {
        if (nested[i].hidden()) {
            continue;
        }
        table.row(commandCell(nested[i]), nested[i].summary());
    }
    if (table.empty()) {
        return;
    }
    text.paragraph("Commands:\n" + table.rendered());
}

argumentSection(Page text, Command command) {
    Argument[] declared = command.arguments();
    let table = new Table();
    for (long i = 0; i < declared.length; i++) {
        table.row(declared[i].spelling(), declared[i].description());
    }
    if (table.empty()) {
        return;
    }
    text.paragraph("Arguments:\n" + table.rendered());
}

// The generated '--help' and '--version' belong to the application rather than to any one command,
// so they are written into the overview's option list and nowhere else.
optionSection(Page text, string heading, Option[] options, bool generated) {
    let table = new Table();
    for (long i = 0; i < options.length; i++) {
        if (options[i].hidden()) {
            continue;
        }
        table.row(optionCell(options[i]), options[i].description());
    }
    if (generated) {
        table.row("-h, --help", "Show help for a command");
        table.row("    --version", "Print the version");
    }
    if (table.empty()) {
        return;
    }
    text.paragraph(heading + ":\n" + table.rendered());
}

commandCell(Command command) -> string {
    let cell = new StringBuilder();
    cell.append(command.name());
    if (command.commands().length > 0) {
        cell.append(" <command>");
        return cell.toString();
    }
    Argument[] declared = command.arguments();
    for (long i = 0; i < declared.length; i++) {
        cell.append(" ");
        cell.append(declared[i].spelling());
    }
    return cell.toString();
}

optionCell(Option option) -> string {
    let cell = new StringBuilder();
    string letter = option.shortSpelling();
    if (letter.length == 0) {
        cell.append("    ");
    } else {
        cell.append(letter);
        cell.append(", ");
    }
    cell.append(option.longSpelling());
    if (option.takesValue()) {
        cell.append(" ");
        cell.append(option.valuePlaceholder());
    }
    return cell.toString();
}

// Every option the path accepts, the hidden ones left out.
visibleOptions(CommandPath path) -> Option[] {
    let shown = new List<Option>();
    Command[] selected = path.commands();
    for (long i = 0; i < selected.length; i++) {
        Option[] declared = selected[i].options();
        for (long j = 0; j < declared.length; j++) {
            if (!declared[j].hidden()) {
                shown.push(declared[j]);
            }
        }
    }
    return shown.toArray();
}

// The options the path accepts because a command above it declares them.
inheritedOptions(CommandPath path) -> Option[] {
    let shown = new List<Option>();
    Command[] selected = path.commands();
    for (long i = 0; i < selected.length - 1; i++) {
        Option[] declared = selected[i].options();
        for (long j = 0; j < declared.length; j++) {
            shown.push(declared[j]);
        }
    }
    return shown.toArray();
}

// A page under construction: blocks of text with one blank line between them, and nothing at all
// where a declaration left the text out.
public class Page {
    List<string> blocks;

    public constructor() {
        this.blocks = new List<string>();
    }

    public paragraph(string text) {
        if (text.length == 0) {
            return;
        }
        this.blocks.push(text);
    }

    public toString() -> string {
        return strings.joined(this.blocks.toArray(), "\n\n");
    }
}

// Two columns indented by two spaces, every description starting at the same column.
public class Table {
    List<string> cells;
    List<string> descriptions;

    public constructor() {
        this.cells = new List<string>();
        this.descriptions = new List<string>();
    }

    public row(string cell, string description) {
        this.cells.push(cell);
        this.descriptions.push(description);
    }

    public empty() -> bool {
        return this.cells.length() == 0;
    }

    public rendered() -> string {
        long width = 0;
        for (long i = 0; i < this.cells.length(); i++) {
            if (this.cells.get(i).length > width) {
                width = this.cells.get(i).length;
            }
        }
        let out = new StringBuilder();
        for (long i = 0; i < this.cells.length(); i++) {
            if (i > 0) {
                out.append("\n");
            }
            string cell = this.cells.get(i);
            string description = this.descriptions.get(i);
            out.append("  ");
            out.append(cell);
            if (description.length > 0) {
                out.append(spaces(width - cell.length + 3));
                out.append(description);
            }
        }
        return out.toString();
    }
}

spaces(long count) -> string {
    let padding = new StringBuilder();
    for (long i = 0; i < count; i++) {
        padding.append(" ");
    }
    return padding.toString();
}
