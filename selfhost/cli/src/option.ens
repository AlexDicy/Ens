// A declared option: the long spelling every option has, an optional one-letter spelling, and the
// label standing in for the value it takes. An option with no value label is a flag.
export final class Option {
    string optionName;
    char? optionLetter;
    string optionLabel;
    string optionDescription;
    bool optionRepeatable;
    bool optionHidden;

    public constructor(string name, char? letter, string valueLabel, string description,
                       bool repeatable, bool hidden) {
        this.optionName = name;
        this.optionLetter = letter;
        this.optionLabel = valueLabel;
        this.optionDescription = description;
        this.optionRepeatable = repeatable;
        this.optionHidden = hidden;
    }

    export name() -> string {
        return this.optionName;
    }

    export letter() -> char? {
        return this.optionLetter;
    }

    // What the value is called in help and in diagnostics, empty text for a flag.
    export valueLabel() -> string {
        return this.optionLabel;
    }

    export description() -> string {
        return this.optionDescription;
    }

    // Whether the option may be written more than once, keeping every value in the order given.
    export repeatable() -> bool {
        return this.optionRepeatable;
    }

    // A hidden option is read like any other but is left out of the generated help.
    export hidden() -> bool {
        return this.optionHidden;
    }

    export takesValue() -> bool {
        return this.optionLabel.length > 0;
    }

    // "o", or empty text when the option has no one-letter spelling.
    export letterSpelling() -> string {
        let letter = this.optionLetter;
        if (letter == null) {
            return "";
        }
        return letter.toString();
    }

    // "-o", or empty text when the option has no one-letter spelling.
    export shortSpelling() -> string {
        let letter = this.optionLetter;
        if (letter == null) {
            return "";
        }
        return "-" + letter.toString();
    }

    // "--output".
    export longSpelling() -> string {
        return "--" + this.optionName;
    }

    // "<file>", the value as help and diagnostics ask for it.
    export valuePlaceholder() -> string {
        return "<" + this.optionLabel + ">";
    }
}
