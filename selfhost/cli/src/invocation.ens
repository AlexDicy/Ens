// What one reading of a command line came to: either the usage problem that stopped it, or the
// command it named together with the option values, arguments and program arguments it carried. It
// shares nothing with the declarations it was read against, so a caller may keep it indefinitely.
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import CommandPath from commandpath;

export final class Invocation {
    string? readingProblem;
    string namedCommand;
    bool helpAsked;
    CommandPath? helpTopic;
    bool versionAsked;

    Map<string, List<string>> optionValues;
    Set<string> raisedFlags;
    List<string> givenArguments;
    List<string> passedArguments;

    // The reading that stopped on a usage problem.
    public constructor(string problem) {
        this.readingProblem = problem;
        this.namedCommand = "";
        this.helpAsked = false;
        this.helpTopic = null;
        this.versionAsked = false;
        this.optionValues = new Map<string, List<string>>();
        this.raisedFlags = new Set<string>();
        this.givenArguments = new List<string>();
        this.passedArguments = new List<string>();
    }

    // The reading that worked.
    public constructor(string command, bool helpRequested, CommandPath? helpTarget,
                       bool versionRequested, Map<string, List<string>> values,
                       Set<string> flags, List<string> positionals, List<string> rest) {
        this.readingProblem = null;
        this.namedCommand = command;
        this.helpAsked = helpRequested;
        this.helpTopic = helpTarget;
        this.versionAsked = versionRequested;
        this.optionValues = values;
        this.raisedFlags = flags;
        this.givenArguments = positionals;
        this.passedArguments = rest;
    }

    // The usage problem to report, or null when the command line read cleanly. It names what went
    // wrong and how to write it instead; which exit code it deserves is the caller's to decide.
    export problem() -> string? {
        return this.readingProblem;
    }

    // The command that was named, "override add" for a nested one, and empty text when the
    // command line named none.
    export command() -> string {
        return this.namedCommand;
    }

    // Whether help was asked for, by '--help', '-h', or the 'help' command.
    export helpRequested() -> bool {
        return this.helpAsked;
    }

    // The command whose help was asked for, or null for the application's own overview. Pass it
    // straight to `help.text`.
    export helpTarget() -> CommandPath? {
        return this.helpTopic;
    }

    export versionRequested() -> bool {
        return this.versionAsked;
    }

    // The value written for the named option, or null when it was not written. An option written
    // more than once answers with the last value; `values` gives them all.
    export value(string name) -> string? {
        let written = this.optionValues.get(name);
        if (written == null || written.length() == 0) {
            return null;
        }
        return written.get(written.length() - 1);
    }

    // Every value written for the named option, in the order they were written.
    export values(string name) -> string[] {
        let written = this.optionValues.get(name);
        if (written == null) {
            string[] none = [];
            return none;
        }
        return written.toArray();
    }

    export flag(string name) -> bool {
        return this.raisedFlags.contains(name);
    }

    // The positional arguments of the named command, in the order they were written.
    export positionals() -> string[] {
        return this.givenArguments.toArray();
    }

    // Everything written after '--', for a command that declared a passthrough.
    export rest() -> string[] {
        return this.passedArguments.toArray();
    }
}
