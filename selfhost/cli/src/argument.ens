// A declared positional argument. A required one must be written, and a variadic one takes every
// remaining argument instead of exactly one.
public final class Argument {
    string argumentName;
    string argumentDescription;
    bool argumentRequired;
    bool argumentVariadic;

    public constructor(string name, string description, bool required, bool variadic) {
        this.argumentName = name;
        this.argumentDescription = description;
        this.argumentRequired = required;
        this.argumentVariadic = variadic;
    }

    public name() -> string {
        return this.argumentName;
    }

    public description() -> string {
        return this.argumentDescription;
    }

    public required() -> bool {
        return this.argumentRequired;
    }

    public variadic() -> bool {
        return this.argumentVariadic;
    }

    // "<path>", the argument as help and diagnostics name it.
    public placeholder() -> string {
        return "<" + this.argumentName + ">";
    }

    // How the argument reads in a usage line: "<path>", "[<path>]", "<paths>..." or
    // "[<paths>...]".
    public spelling() -> string {
        string inner = this.placeholder();
        if (this.argumentVariadic) {
            inner = inner + "...";
        }
        if (this.argumentRequired) {
            return inner;
        }
        return "[" + inner + "]";
    }
}
