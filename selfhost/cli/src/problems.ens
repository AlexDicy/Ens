// Every usage problem this package reports, worded in one place so the whole set has one
// voice: what the command line said, what is wrong with it, and how to write it instead.
import List from @std.collections.list;
import Command from command;
import CommandPath from commandpath;
import Option from option;
import Argument from argument;
import help;

public noCommand(CommandPath path) -> string {
    return "no command given. Run '" + helpInvocation(path) + "' to see the commands";
}

public commandNeeded(CommandPath path) -> string {
    return "'" + path.label() + "' needs a command. Write " + listed(path.commandNames())
        + " after it";
}

public unknownCommand(CommandPath path, string written, string? nearest) -> string {
    string opening = "unknown command '" + written + "'" + belongingTo(path);
    if (nearest != null) {
        return opening + ". Did you mean '" + nearest + "'?";
    }
    if (path.atRoot()) {
        return opening + ". Run '" + helpInvocation(path) + "' to see the commands";
    }
    return opening + ". Run '" + helpInvocation(path) + "' to see its commands";
}

public unknownOption(CommandPath path, string written, string? nearest) -> string {
    string opening = "unknown option '" + written + "' for '" + path.label() + "'";
    if (nearest != null) {
        return opening + ". Did you mean '--" + nearest + "'?";
    }
    return opening + ". Run '" + helpInvocation(path) + "' to see its options";
}

// A long name written with one dash, as in '-output' for '--output'.
public oneDashLongOption(CommandPath path, string written, string name) -> string {
    return "unknown option '" + written + "' for '" + path.label() + "'. Write '--" + name
        + "', with two dashes";
}

// A letter that no option in a run of short spellings claims. `letter` is empty text when the
// command line wrote something no one letter can be picked out of.
public unknownShortOption(CommandPath path, string written, string letter) -> string {
    string named = "'" + written + "'";
    if (letter.length > 0 && "-" + letter != written) {
        named = "'-" + letter + "' in '" + written + "'";
    }
    return "unknown option " + named + " for '" + path.label() + "'. Run '" + helpInvocation(path)
        + "' to see its options";
}

public missingValue(Option option, string written) -> string {
    return "option '" + written + "' needs a value. Write " + bothSpellings(option, written);
}

public emptyValue(Option option, string written) -> string {
    return "option '" + written + "' has an empty value. Write " + bothSpellings(option, written);
}

public valueLooksLikeOption(Option option, string written, string next) -> string {
    return "option '" + written + "' needs a value, but '" + next + "' looks like another "
        + "option. Write '" + option.longSpelling() + "=" + next + "' if '" + next
        + "' is the value";
}

public flagTakesNoValue(Option option, string written) -> string {
    return "option '" + written + "' takes no value. Write just '" + written + "'";
}

public repeatedOption(Option option) -> string {
    return "option '" + option.longSpelling() + "' is given twice, and it takes one value. "
        + "Remove one of them";
}

public unexpectedArgument(CommandPath path, string written) -> string {
    return "unexpected argument '" + written + "' for '" + path.label() + "'. Remove it. The "
        + "usage is '" + help.usageLine(path) + "'";
}

public missingArgument(CommandPath path, Argument argument) -> string {
    return "'" + path.label() + "' needs a " + argument.placeholder() + " argument. Write it "
        + "after the command, as in '" + help.usageLine(path) + "'";
}

public passthroughUnsupported(CommandPath path) -> string {
    string opening = "'" + path.label() + "' takes nothing after '--'";
    string remove = "Remove '--' and what follows it";
    string[] passing = passthroughLabels(path.root());
    if (passing.length == 0) {
        return opening + ". " + remove;
    }
    string only = ". Only " + listed(passing) + " passes arguments after '--' to a program. ";
    if (passing.length > 1) {
        only = ". Only " + listed(passing) + " pass arguments after '--' to a program. ";
    }
    string sibling = path.deepest().passthroughSuggestion();
    if (sibling.length == 0) {
        return opening + only + remove;
    }
    return opening + only + remove + ", or use '" + path.root().name() + " " + sibling + "'";
}

// How the help for this path is requested: "ens help", or "ens help override" further down.
helpInvocation(CommandPath path) -> string {
    if (path.atRoot()) {
        return path.label() + " help";
    }
    return path.root().name() + " help " + path.text();
}

// " for 'ens override'", and nothing at all at the application's own level, where naming the
// program back would report nothing.
belongingTo(CommandPath path) -> string {
    if (path.atRoot()) {
        return "";
    }
    return " for '" + path.label() + "'";
}

// Both ways the value could have been written, the spelling the command line used first:
// "'-O <level>' or '--optimization-level <level>'".
bothSpellings(Option option, string written) -> string {
    string placeholder = option.valuePlaceholder();
    string letter = option.shortSpelling();
    string longForm = "'" + option.longSpelling() + " " + placeholder + "'";
    if (letter.length == 0) {
        return longForm + " or '" + option.longSpelling() + "=" + placeholder + "'";
    }
    string shortForm = "'" + letter + " " + placeholder + "'";
    if (written == letter) {
        return shortForm + " or " + longForm;
    }
    return longForm + " or " + shortForm;
}

// The commands that pass arguments on to a program, each as a user writes it.
passthroughLabels(Command root) -> string[] {
    let found = new List<string>();
    collectPassthrough(root, root.name(), found);
    return found.toArray();
}

collectPassthrough(Command command, string label, List<string> found) {
    if (command.passesThrough()) {
        found.push(label);
    }
    Command[] nested = command.commands();
    for (long i = 0; i < nested.length; i++) {
        if (nested[i].hidden()) {
            continue;
        }
        collectPassthrough(nested[i], label + " " + nested[i].name(), found);
    }
}

// "'add'", "'add' or 'remove'", "'add', 'remove' or 'list'".
listed(string[] names) -> string {
    let quoted = new List<string>();
    for (long i = 0; i < names.length; i++) {
        quoted.push("'" + names[i] + "'");
    }
    string[] parts = quoted.toArray();
    if (parts.length == 0) {
        return "";
    }
    if (parts.length == 1) {
        return parts[0];
    }
    if (parts.length == 2) {
        return parts[0] + " or " + parts[1];
    }
    return string.joined(parts.slice(0, parts.length - 1), ", ") + " or "
        + parts[parts.length - 1];
}
