// What a command line may say: one command per verb the program answers to, each declaring the
// options it accepts, the positional arguments it expects, and the commands nested under it.
//
// Declarations are made once, before any argument is read, and nothing reads a command line into
// them: parsing takes them as input and answers with a separate value, so one set of declarations
// can serve any number of readings.
//
// Exported here is what a program writing its own command tree says and asks back; everything the
// generated help and the parser read out of a declaration is package-wide, so the surface a
// consumer sees is the surface a consumer uses.
import List from @std.collections.list;
import Option from option;
import Argument from argument;

export class Command {
    string commandName;
    string commandSummary;
    string commandDetails;
    bool commandHidden;

    List<Option> declaredOptions;
    List<Argument> declaredArguments;
    List<Command> declaredCommands;
    bool commandPassthrough;

    // `details` is the prose the command's own help page opens with, written with '\n' where a
    // line should break. A hidden command is read like any other but left out of the help.
    export constructor(string name, string summary, string details = "", bool hidden = false) {
        this.commandName = name;
        this.commandSummary = summary;
        this.commandDetails = details;
        this.commandHidden = hidden;
        this.declaredOptions = new List<Option>();
        this.declaredArguments = new List<Argument>();
        this.declaredCommands = new List<Command>();
        this.commandPassthrough = false;
    }

    // Declares an option taking a value, written '--name value', '--name=value', '-x value' or
    // '-xvalue'.
    export option(string name, char letter, string valueLabel, string description,
                  bool repeatable = false, bool hidden = false) {
        this.declare(new Option(name, letter, valueLabel, description, repeatable, hidden));
    }

    // The same, for an option with no one-letter spelling.
    export option(string name, string valueLabel, string description, bool repeatable = false,
                  bool hidden = false) {
        this.declare(new Option(name, null, valueLabel, description, repeatable, hidden));
    }

    // Declares an option taking no value, written '--name' or '-x'. Writing it twice says the
    // same thing as writing it once.
    export flag(string name, char letter, string description, bool hidden = false) {
        this.declare(new Option(name, letter, "", description, false, hidden));
    }

    // The same, for a flag with no one-letter spelling.
    export flag(string name, string description, bool hidden = false) {
        this.declare(new Option(name, null, "", description, false, hidden));
    }

    // Declares the next positional argument. Arguments fill in the order they are declared, so
    // the required ones come first and a variadic one comes last.
    export argument(string name, string description, bool required = true, bool variadic = false) {
        this.declaredArguments.push(new Argument(name, description, required, variadic));
    }

    // Nests a command under this one, so the next word of the command line selects it.
    export command(Command child) {
        let refused = reservedCommandProblem(child.name());
        if (refused != null) {
            panic(refused);
        }
        this.declaredCommands.push(child);
    }

    // Declares that '--' ends the options and hands everything after it to the program this
    // command runs.
    export passthrough() {
        this.commandPassthrough = true;
    }

    declare(Option option) {
        let refused = reservedOptionProblem(option.name(), option.letterSpelling());
        if (refused != null) {
            panic(refused);
        }
        this.declaredOptions.push(option);
    }

    export name() -> string {
        return this.commandName;
    }

    public summary() -> string {
        return this.commandSummary;
    }

    public details() -> string {
        return this.commandDetails;
    }

    export hidden() -> bool {
        return this.commandHidden;
    }

    public passesThrough() -> bool {
        return this.commandPassthrough;
    }

    public options() -> Option[] {
        return this.declaredOptions.toArray();
    }

    public arguments() -> Argument[] {
        return this.declaredArguments.toArray();
    }

    export commands() -> Command[] {
        return this.declaredCommands.toArray();
    }

    public optionNamed(string name) -> Option? {
        Option[] declared = this.options();
        for (long i = 0; i < declared.length; i++) {
            if (declared[i].name() == name) {
                return declared[i];
            }
        }
        return null;
    }

    export commandNamed(string name) -> Command? {
        Command[] nested = this.commands();
        for (long i = 0; i < nested.length; i++) {
            if (nested[i].name() == name) {
                return nested[i];
            }
        }
        return null;
    }

    // How many positional arguments the command accepts, or -1 when a variadic argument lets it
    // accept any number.
    public argumentLimit() -> long {
        Argument[] declared = this.arguments();
        for (long i = 0; i < declared.length; i++) {
            if (declared[i].variadic()) {
                return -1;
            }
        }
        return declared.length;
    }
}

// The spellings this package answers on its own, refused where a program declares one of them: a
// declaration that repeated one would shadow an answer no command line could then reach. Reaching
// either of these is a mistake in a program's own declarations rather than anything a user can
// write, which is why the text is marked Internal and names the package - every other message this
// package produces is worded for a user and lives in `problems`.
public reservedOptionProblem(string name, string letter) -> string? {
    if (name == "help" || name == "version") {
        return "Internal: ens.cli answers '--" + name
            + "' itself; declare this option under another name";
    }
    if (letter == "h") {
        return "Internal: ens.cli answers '-h' itself; declare '--" + name
            + "' with another one-letter spelling";
    }
    return null;
}

public reservedCommandProblem(string name) -> string? {
    if (name == "help") {
        return "Internal: ens.cli answers the 'help' command itself; declare this command under "
            + "another name";
    }
    return null;
}

// The program itself: the root of the command tree, named as the command line names it.
//
// A program with commands under it also answers to 'help <command>', which is generated from the
// declarations rather than declared. '--help', '-h' and '--version' are generated the same way and
// are reserved at every level, so declaring any of them is refused where it is written.
export final class Application extends Command {
    Command generatedHelp;

    export constructor(string name, string summary, string details = "") {
        super(name, summary, details);
        this.generatedHelp = new Command("help", "Show help for a command");
        this.generatedHelp.argument("command", "the command to explain", required: false,
            variadic: true);
    }

    // The declared commands, followed by the generated 'help' command when there is anything for
    // it to explain.
    export override commands() -> Command[] {
        Command[] declared = super.commands();
        if (declared.length == 0) {
            return declared;
        }
        let all = new List<Command>();
        for (long i = 0; i < declared.length; i++) {
            all.push(declared[i]);
        }
        all.push(this.generatedHelp);
        return all.toArray();
    }

    public helpCommand() -> Command {
        return this.generatedHelp;
    }
}
