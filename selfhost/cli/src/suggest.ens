// Naming back what was probably meant. A name a command line does not know is compared with the
// declared ones by counting the single-character edits between them, and the closest is named back
// only when it is near enough to be the same name misspelled rather than a different name.

// The candidate closest to `written`, or null when none of them is near enough to name back.
export nearest(string written, string[] candidates) -> string? {
    string? closest = null;
    long shortest = 0;
    for (long i = 0; i < candidates.length; i++) {
        long apart = distance(written, candidates[i]);
        if (closest == null || apart < shortest) {
            closest = candidates[i];
            shortest = apart;
        }
    }
    if (closest == null || shortest > allowance(written)) {
        return null;
    }
    return closest;
}

// How far apart two names may be and still count as one misspelling of the other: a single edit
// for a short name, where one edit already turns most names into most others, and more as there is
// more name to get wrong.
allowance(string written) -> long {
    if (written.length <= 4) {
        return 1;
    }
    if (written.length <= 12) {
        return 2;
    }
    return 3;
}

// The number of single-character insertions, deletions and substitutions that turn `left` into
// `right`, counted over their bytes.
public distance(string left, string right) -> long {
    byte[] from = left.toBytes();
    byte[] to = right.toBytes();
    if (from.length == 0) {
        return to.length;
    }
    if (to.length == 0) {
        return from.length;
    }
    long[] previous = new long[to.length + 1];
    long[] current = new long[to.length + 1];
    for (long i = 0; i <= to.length; i++) {
        previous[i] = i;
    }
    for (long i = 1; i <= from.length; i++) {
        current[0] = i;
        for (long j = 1; j <= to.length; j++) {
            long best = previous[j - 1];
            if (from[i - 1] != to[j - 1]) {
                best = best + 1;
            }
            long deleted = previous[j] + 1;
            if (deleted < best) {
                best = deleted;
            }
            long inserted = current[j - 1] + 1;
            if (inserted < best) {
                best = inserted;
            }
            current[j] = best;
        }
        for (long j = 0; j <= to.length; j++) {
            previous[j] = current[j];
        }
    }
    return previous[to.length];
}
