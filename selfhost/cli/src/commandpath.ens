// The commands a command line has named so far, the application itself first. Options resolve
// through a path from the deepest command outward, so a nested command accepts what its parents
// declare and shadows one by declaring the same name. A path is never edited, only extended.
import List from @std.collections.list;
import Command from command;
import Option from option;

export final class CommandPath {
    List<Command> selected;

    public constructor(Command root) {
        this.selected = new List<Command>();
        this.selected.push(root);
    }

    constructor(List<Command> commands) {
        this.selected = commands;
    }

    public extended(Command child) -> CommandPath {
        let deeper = new List<Command>();
        Command[] current = this.selected.toArray();
        for (long i = 0; i < current.length; i++) {
            deeper.push(current[i]);
        }
        deeper.push(child);
        return new CommandPath(deeper);
    }

    public commands() -> Command[] {
        return this.selected.toArray();
    }

    public root() -> Command {
        return this.selected.get(0);
    }

    public deepest() -> Command {
        return this.selected.get(this.selected.length() - 1);
    }

    // Whether the path names the application and no command under it.
    public atRoot() -> bool {
        return this.selected.length() == 1;
    }

    // "ens build", the whole path as a user writes it.
    public label() -> string {
        return string.joined(this.names(0), " ");
    }

    // "build", or "override add" for a nested command, and empty text when no command was named.
    public text() -> string {
        return string.joined(this.names(1), " ");
    }

    names(long from) -> string[] {
        let parts = new List<string>();
        Command[] current = this.selected.toArray();
        for (long i = from; i < current.length; i++) {
            parts.push(current[i].name());
        }
        return parts.toArray();
    }

    public optionNamed(string name) -> Option? {
        for (long i = this.selected.length() - 1; i >= 0; i--) {
            let found = this.selected.get(i).optionNamed(name);
            if (found != null) {
                return found;
            }
        }
        return null;
    }

    // The option whose one-letter spelling stands at `at` in a run of short spellings, so that
    // '-qv' and '-O2' both find what they name.
    public optionAtLetter(string letters, long at) -> Option? {
        for (long i = this.selected.length() - 1; i >= 0; i--) {
            Option[] declared = this.selected.get(i).options();
            for (long j = 0; j < declared.length; j++) {
                string spelling = declared[j].letterSpelling();
                if (spelling.length == 0 || at + spelling.length > letters.length) {
                    continue;
                }
                if (letters.substring(at, at + spelling.length) == spelling) {
                    return declared[j];
                }
            }
        }
        return null;
    }

    // The names of the options a diagnostic may name back, hidden ones left out so nothing the
    // help omits is revealed by a suggestion.
    public optionNames() -> string[] {
        let names = new List<string>();
        for (long i = this.selected.length() - 1; i >= 0; i--) {
            Option[] declared = this.selected.get(i).options();
            for (long j = 0; j < declared.length; j++) {
                if (!declared[j].hidden()) {
                    names.push(declared[j].name());
                }
            }
        }
        return names.toArray();
    }

    // The names of the commands nested under the deepest command, hidden ones left out.
    public commandNames() -> string[] {
        let names = new List<string>();
        Command[] nested = this.deepest().commands();
        for (long i = 0; i < nested.length; i++) {
            if (!nested[i].hidden()) {
                names.push(nested[i].name());
            }
        }
        return names.toArray();
    }
}
