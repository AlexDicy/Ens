// The generated help, pinned line by line. Help is the first thing anyone reads, so a change in
// its wording or its alignment has to be a change someone meant to make.
import @std.testing;
import expect;
import sample;
import help;
import parse;

test "the overview lists the commands, the options, and where to read more" {
    let ens = sample.application();
    string[] expected = [
        "Ens compiler and build tool",
        "",
        "Usage: ens <command> [options]",
        "",
        "Commands:",
        "  build [<path>]        Compile Ens sources",
        "  check [<path>]        Look for errors without building anything",
        "  run [<path>]          Build an application and run it",
        "  test [<path>]         Build and run the tests",
        "  override <command>    Manage dependency overrides in ens.overrides",
        "  version               Print the toolchain version",
        "  help [<command>...]   Show help for a command",
        "",
        "Options:",
        "  -q, --quiet     Print less",
        "  -v, --verbose   Print more",
        "  -h, --help      Show help for a command",
        "      --version   Print the version",
        "",
        "Run 'ens help <command>' for more about one command.",
    ];
    try expect.lines(help.text(ens, null), expected);
}

test "a command's page opens with its prose and lists what it takes" {
    let ens = sample.application();
    string[] expected = [
        "Compile Ens sources",
        "",
        "Usage: ens build [<path>] [options]",
        "",
        "The path is an .ens file, a package folder, or a workspace root; with no path",
        "the nearest ens.package above the current folder is used. At a workspace root",
        "every member is built in dependency order.",
        "",
        "Arguments:",
        "  [<path>]   File, package, or workspace root",
        "",
        "Options:",
        "  -o, --output <file>                Where to put the executable",
        "      --target <triple>              Cross-compile for this target triple",
        "  -O, --optimization-level <level>   Optimize at this level, 0 to 3",
        "      --stdlib <folder>              Take the standard library from this folder",
        "      --explain-arc                  Report what the ARC optimizer elided and why",
        "      --locked                       Fail if ens.lock would change",
        "",
        "Global options:",
        "  -q, --quiet     Print less",
        "  -v, --verbose   Print more",
    ];
    let target = parse.commandLine(ens, ["help", "build"]).helpTarget();
    try expect.lines(help.text(ens, target), expected);
}

test "a command that passes arguments on says so in its usage line" {
    let ens = sample.application();
    string[] expected = [
        "Build an application and run it",
        "",
        "Usage: ens run [<path>] [options] [-- <arguments>]",
        "",
        "Arguments:",
        "  [<path>]   File, package, or workspace root",
        "",
        "Options:",
        "      --locked   Fail if ens.lock would change",
        "",
        "Global options:",
        "  -q, --quiet     Print less",
        "  -v, --verbose   Print more",
    ];
    let target = parse.commandLine(ens, ["help", "run"]).helpTarget();
    try expect.lines(help.text(ens, target), expected);
}

test "a command with commands under it lists them instead of arguments" {
    let ens = sample.application();
    string[] expected = [
        "Manage dependency overrides in ens.overrides",
        "",
        "Usage: ens override <command> [options]",
        "",
        "Commands:",
        "  add <package> <folder>   Redirect a dependency to a local folder",
        "  remove <package>         Stop redirecting a dependency",
        "  list                     Show every override and whether its target is there",
        "",
        "Global options:",
        "  -q, --quiet     Print less",
        "  -v, --verbose   Print more",
        "",
        "Run 'ens help override <command>' for more about one command.",
    ];
    let target = parse.commandLine(ens, ["help", "override"]).helpTarget();
    try expect.lines(help.text(ens, target), expected);
}

test "a nested command's page names the whole path it is written with" {
    let ens = sample.application();
    string[] expected = [
        "Redirect a dependency to a local folder",
        "",
        "Usage: ens override add <package> <folder> [options]",
        "",
        "Arguments:",
        "  <package>   The dependency to redirect",
        "  <folder>    The folder to redirect it to",
        "",
        "Global options:",
        "  -q, --quiet     Print less",
        "  -v, --verbose   Print more",
    ];
    let target = parse.commandLine(ens, ["help", "override", "add"]).helpTarget();
    try expect.lines(help.text(ens, target), expected);
}

test "a program with no commands documents its own arguments and options" {
    string[] expected = [
        "Wrap text to a width",
        "",
        "Usage: wrap <file> [<extra>...] [options]",
        "",
        "Arguments:",
        "  <file>         The file to wrap",
        "  [<extra>...]   More files to wrap",
        "",
        "Options:",
        "  -w, --width <columns>   Wrap at this column",
        "  -h, --help              Show help for a command",
        "      --version           Print the version",
    ];
    try expect.lines(help.text(sample.plain(), null), expected);
}

test "hidden commands and options are left out of every page" {
    let ens = sample.application();
    string overview = help.text(ens, null);
    try testing.assertFalse(overview.contains("cst-dump"), "a hidden command stays out");
    let target = parse.commandLine(ens, ["help", "build"]).helpTarget();
    string page = help.text(ens, target);
    try testing.assertFalse(page.contains("--objects"), "a hidden option stays out");
    try testing.assertFalse(page.contains("--disable-pass"), "a hidden option stays out");
}

test "the path a command line named reads back as its own page" {
    let ens = sample.application();
    let target = parse.commandLine(ens, ["build", "--help"]).helpTarget();
    string page = help.text(ens, target);
    try testing.assertTrue(page.startsWith("Compile Ens sources"), "the page is build's");
}
