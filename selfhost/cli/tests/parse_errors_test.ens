// One test per usage problem this package reports, pinning the exact wording: a diagnostic is the
// only thing a mistyped command line ever sees, so its text is part of the contract.
import @std.testing;
import expect;
import sample;
import parse;

test "a command line naming no command says so" {
    let ens = sample.application();
    string[] nothing = [];
    try expect.text(parse.commandLine(ens, nothing).problem(),
        "no command given; run 'ens help' to see the available commands");
}

test "a command that needs one of its own says which" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["override"]).problem(),
        "'ens override' needs a command; write one of 'add', 'remove', or 'list'");
}

test "an unknown command names the closest one, or where to look" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["buidl"]).problem(),
        "unknown command 'buidl'; did you mean 'build'?");
    try expect.text(parse.commandLine(ens, ["frobnicate"]).problem(),
        "unknown command 'frobnicate'; run 'ens help' to see the available commands");
    try expect.text(parse.commandLine(ens, ["override", "ad"]).problem(),
        "unknown command 'ad' for 'ens override'; did you mean 'add'?");
    try expect.text(parse.commandLine(ens, ["help", "buidl"]).problem(),
        "unknown command 'buidl'; did you mean 'build'?");
}

test "a hidden command is never named back as a suggestion" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["cst-dumb"]).problem(),
        "unknown command 'cst-dumb'; run 'ens help' to see the available commands");
}

test "an unknown option names the closest one, or where to look" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--ouput", "app.exe"]).problem(),
        "unknown option '--ouput' for 'ens build'; did you mean '--output'?");
    try expect.text(parse.commandLine(ens, ["build", "--frobnicate"]).problem(),
        "unknown option '--frobnicate' for 'ens build'; run 'ens help build' to see the "
            + "options it takes");
    try expect.text(parse.commandLine(ens, ["--verbse"]).problem(),
        "unknown option '--verbse' for 'ens'; did you mean '--verbose'?");
}

test "an option of one command is unknown to another" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["check", "--output", "app.exe"]).problem(),
        "unknown option '--output' for 'ens check'; run 'ens help check' to see the options "
            + "it takes");
}

test "an unknown one-letter option names the run it was written in" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "-z"]).problem(),
        "unknown option '-z' for 'ens build'; run 'ens help build' to see the options it takes");
    try expect.text(parse.commandLine(ens, ["build", "-qz"]).problem(),
        "unknown option '-z' in '-qz' for 'ens build'; run 'ens help build' to see the "
            + "options it takes");
}

test "a long name written with one dash is told to write two" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "-output", "app.exe"]).problem(),
        "unknown option '-output' for 'ens build'; write '--output' with two dashes");
    try expect.text(parse.commandLine(ens, ["build", "-lockd"]).problem(),
        "unknown option '-lockd' for 'ens build'; did you mean '--locked'?");
}

test "an option with no value names both ways it could have been written" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "-O"]).problem(),
        "option '-O' needs a value; write '-O<level>' or '--optimization-level <level>'");
    try expect.text(parse.commandLine(ens, ["build", "--optimization-level"]).problem(),
        "option '--optimization-level' needs a value; write '--optimization-level <level>' "
            + "or '-O<level>'");
    try expect.text(parse.commandLine(ens, ["build", "--target"]).problem(),
        "option '--target' needs a value; write '--target <triple>' or '--target=<triple>'");
}

test "an option given an empty value is refused the same way" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--output="]).problem(),
        "option '--output' was given an empty value; write '--output <file>' or '-o<file>'");
    try expect.text(parse.commandLine(ens, ["build", "-o="]).problem(),
        "option '-o' was given an empty value; write '-o<file>' or '--output <file>'");
    try expect.text(parse.commandLine(ens, ["build", "--output", ""]).problem(),
        "option '--output' was given an empty value; write '--output <file>' or '-o<file>'");
}

test "a value written like an option is not taken for one by mistake" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--output", "--target"]).problem(),
        "option '--output' needs a value, but '--target' is written like another option; "
            + "write '--output=--target' if that is the value you meant");
}

test "a flag given a value says it takes none" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--locked=true"]).problem(),
        "option '--locked' takes no value; write just '--locked'");
}

test "an option that takes one value refuses a second" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "-o", "a.exe", "--output", "b.exe"])
            .problem(),
        "option '--output' was given twice; it takes a single value, so remove one of them");
}

test "an argument too many is named alongside the usage" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "a.ens", "b.ens"]).problem(),
        "unexpected argument 'b.ens' for 'ens build'; usage: ens build [<path>] [options]");
    try expect.text(parse.commandLine(ens, ["version", "extra"]).problem(),
        "unexpected argument 'extra' for 'ens version'; usage: ens version [options]");
}

test "a missing argument is named alongside the usage" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["override", "add", "ens.frontend"]).problem(),
        "'ens override add' needs the <folder> argument; usage: ens override add <package> "
            + "<folder> [options]");
    try expect.text(parse.commandLine(sample.plain(), ["-w", "80"]).problem(),
        "'wrap' needs the <file> argument; usage: wrap <file> [<extra>...] [options]");
}

test "'--' on a command that passes nothing on names the command that does" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--", "x"]).problem(),
        "'ens build' takes nothing after '--'; only 'ens run' takes arguments after '--'");
}

test "the first problem is the one reported" {
    let ens = sample.application();
    try expect.text(parse.commandLine(ens, ["build", "--ouput", "a", "--frobnicate"]).problem(),
        "unknown option '--ouput' for 'ens build'; did you mean '--output'?");
}
