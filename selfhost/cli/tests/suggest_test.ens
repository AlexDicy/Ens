// Naming back what was probably meant: the edit count itself, and how near a name has to be before
// a diagnostic offers it.
import @std.testing;
import expect;
import suggest;

test "the distance counts single-character edits" {
    try testing.assertEqual(suggest.distance("output", "output"), 0L);
    try testing.assertEqual(suggest.distance("ouput", "output"), 1L);
    try testing.assertEqual(suggest.distance("outupt", "output"), 2L);
    try testing.assertEqual(suggest.distance("kitten", "sitting"), 3L);
    try testing.assertEqual(suggest.distance("", "add"), 3L);
    try testing.assertEqual(suggest.distance("add", ""), 3L);
    try testing.assertEqual(suggest.distance("", ""), 0L);
}

test "the closest name is offered when it is near enough" {
    string[] options = ["output", "target", "optimization-level", "locked", "quiet"];
    try expect.text(suggest.nearest("ouput", options), "output");
    try expect.text(suggest.nearest("lockd", options), "locked");
    try expect.text(suggest.nearest("optimization-levl", options), "optimization-level");
    try expect.text(suggest.nearest("Quiet", options), "quiet");
}

test "a name that resembles nothing declared is left alone" {
    string[] options = ["output", "target", "locked"];
    try expect.nothing(suggest.nearest("frobnicate", options));
    try expect.nothing(suggest.nearest("x", options));
    string[] nothing = [];
    try expect.nothing(suggest.nearest("output", nothing));
}

test "a short name allows one edit, a longer one allows more" {
    string[] commands = ["add", "list"];
    try expect.text(suggest.nearest("ad", commands), "add");
    try expect.nothing(suggest.nearest("a", commands));
    string[] longer = ["optimization-level"];
    try expect.text(suggest.nearest("optimizaton-leve", longer), "optimization-level");
}
