// Assertions the tests here need often: generated text compared line by line, so a wording change
// fails naming the line that moved rather than printing two pages, and text that may not be there
// compared with what it should read.
import @std.testing;
import @std.text.strings;

public lines(string actual, string[] expected) throws {
    string[] written = strings.lines(actual);
    long shared = written.length;
    if (expected.length < shared) {
        shared = expected.length;
    }
    for (long i = 0; i < shared; i++) {
        string got = written[i];
        string wanted = expected[i];
        if (got != wanted) {
            long number = i + 1;
            try testing.fail("line {number} reads '{got}', expected '{wanted}'");
        }
    }
    long count = written.length;
    long expectedCount = expected.length;
    if (count != expectedCount) {
        try testing.fail("the text has {count} line(s), expected {expectedCount}");
    }
}

public text(string? actual, string expected) throws {
    if (actual == null) {
        try testing.fail("expected '{expected}', got nothing");
    }
    try testing.assertEqual(actual, expected);
}

public nothing(string? actual) throws {
    if (actual != null) {
        try testing.fail("expected nothing, got '{actual}'");
    }
}
