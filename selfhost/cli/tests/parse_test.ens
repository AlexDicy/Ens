// One test per rule of the grammar a command line is read with.
import @std.testing;
import CommandPath from commandpath;
import expect;
import sample;
import parse;

test "a long option takes the next argument as its value, or the text after '='" {
    let ens = sample.application();
    let separate = parse.commandLine(ens, ["build", "--output", "app.exe"]);
    try expect.nothing(separate.problem());
    try testing.assertEqual(separate.command(), "build");
    try expect.text(separate.value("output"), "app.exe");

    let attached = parse.commandLine(ens, ["build", "--output=app.exe"]);
    try expect.nothing(attached.problem());
    try expect.text(attached.value("output"), "app.exe");
}

test "a short option takes its value as the next argument, attached, or after '='" {
    let ens = sample.application();
    string[][] written = [
        ["build", "-o", "app.exe"],
        ["build", "-oapp.exe"],
        ["build", "-o=app.exe"],
    ];
    for (long i = 0; i < written.length; i++) {
        let read = parse.commandLine(ens, written[i]);
        try expect.nothing(read.problem());
        try expect.text(read.value("output"), "app.exe");
    }
}

test "an attached short value reads a level as '-O2'" {
    let ens = sample.application();
    let attached = parse.commandLine(ens, ["build", "-O2"]);
    try expect.nothing(attached.problem());
    try expect.text(attached.value("optimization-level"), "2");

    let separate = parse.commandLine(ens, ["build", "-O", "2"]);
    try expect.nothing(separate.problem());
    try expect.text(separate.value("optimization-level"), "2");
}

test "short flags cluster, and a value-taking option may end the cluster" {
    let ens = sample.application();
    let flags = parse.commandLine(ens, ["build", "-qv"]);
    try expect.nothing(flags.problem());
    try testing.assertTrue(flags.flag("quiet"), "-qv raises quiet");
    try testing.assertTrue(flags.flag("verbose"), "-qv raises verbose");

    let ending = parse.commandLine(ens, ["build", "-qvO0"]);
    try expect.nothing(ending.problem());
    try testing.assertTrue(ending.flag("quiet"), "-qvO0 raises quiet");
    try testing.assertTrue(ending.flag("verbose"), "-qvO0 raises verbose");
    try expect.text(ending.value("optimization-level"), "0");
}

test "a repeatable option keeps every value in the order it was written" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["build", "--disable-pass", "sink",
        "--disable-pass=hoist"]);
    try expect.nothing(read.problem());
    string[] passes = read.values("disable-pass");
    try testing.assertEqual(passes.length, 2L);
    try testing.assertEqual(passes[0], "sink");
    try testing.assertEqual(passes[1], "hoist");
    try expect.text(read.value("disable-pass"), "hoist");
}

test "a flag written twice says what it said once" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["build", "--locked", "--locked"]);
    try expect.nothing(read.problem());
    try testing.assertTrue(read.flag("locked"), "--locked stays raised");
}

test "an option that was not written has no value" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["build"]);
    try expect.nothing(read.problem());
    try expect.nothing(read.value("output"));
    try testing.assertEqual(read.values("output").length, 0L);
    try testing.assertFalse(read.flag("locked"), "--locked was not written");
}

test "'--' ends the options and hands the rest to the program" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["run", "app.ens", "--", "-x", "--verbose", "--"]);
    try expect.nothing(read.problem());
    try testing.assertEqual(read.command(), "run");
    string[] rest = read.rest();
    try testing.assertEqual(rest.length, 3L);
    try testing.assertEqual(rest[0], "-x");
    try testing.assertEqual(rest[1], "--verbose");
    try testing.assertEqual(rest[2], "--");
    try testing.assertFalse(read.flag("verbose"), "'--verbose' after '--' is the program's");
    try testing.assertEqual(read.positionals().length, 1L);
}

test "a lone '-' is an argument, not an option" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["build", "-"]);
    try expect.nothing(read.problem());
    string[] given = read.positionals();
    try testing.assertEqual(given.length, 1L);
    try testing.assertEqual(given[0], "-");
}

test "an option declared on the application is read before and after the command" {
    let ens = sample.application();
    let after = parse.commandLine(ens, ["build", "--verbose"]);
    try expect.nothing(after.problem());
    try testing.assertTrue(after.flag("verbose"), "--verbose after the command");

    let before = parse.commandLine(ens, ["--verbose", "build"]);
    try expect.nothing(before.problem());
    try testing.assertEqual(before.command(), "build");
    try testing.assertTrue(before.flag("verbose"), "--verbose before the command");
}

test "nested commands read as one command path" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["override", "add", "ens.frontend", "../frontend"]);
    try expect.nothing(read.problem());
    try testing.assertEqual(read.command(), "override add");
    string[] given = read.positionals();
    try testing.assertEqual(given.length, 2L);
    try testing.assertEqual(given[0], "ens.frontend");
    try testing.assertEqual(given[1], "../frontend");
}

test "hidden commands and hidden options are read like any other" {
    let ens = sample.application();
    let command = parse.commandLine(ens, ["cst-dump"]);
    try expect.nothing(command.problem());
    try testing.assertEqual(command.command(), "cst-dump");

    let option = parse.commandLine(ens, ["build", "--objects", "build/objects"]);
    try expect.nothing(option.problem());
    try expect.text(option.value("objects"), "build/objects");
}

test "arguments fill in the order they are declared, and a variadic one takes the rest" {
    let wrap = sample.plain();
    let one = parse.commandLine(wrap, ["notes.txt"]);
    try expect.nothing(one.problem());
    try testing.assertEqual(one.command(), "");
    try testing.assertEqual(one.positionals().length, 1L);

    let many = parse.commandLine(wrap, ["a.txt", "b.txt", "c.txt", "-w", "80"]);
    try expect.nothing(many.problem());
    string[] given = many.positionals();
    try testing.assertEqual(given.length, 3L);
    try testing.assertEqual(given[2], "c.txt");
    try expect.text(many.value("width"), "80");
}

test "help is answered for the application, a command, and a nested command" {
    let ens = sample.application();
    string[][] overview = [["--help"], ["-h"], ["help"]];
    for (long i = 0; i < overview.length; i++) {
        let read = parse.commandLine(ens, overview[i]);
        try expect.nothing(read.problem());
        try testing.assertTrue(read.helpRequested(), "help was asked for");
        try testing.assertTrue(read.helpTarget() == null, "the overview has no command");
    }

    string[][] aboutBuild = [["build", "--help"], ["build", "-h"], ["help", "build"]];
    for (long i = 0; i < aboutBuild.length; i++) {
        let read = parse.commandLine(ens, aboutBuild[i]);
        try expect.nothing(read.problem());
        try testing.assertTrue(read.helpRequested(), "help was asked for");
        try expect.text(pathText(read.helpTarget()), "build");
    }

    let nested = parse.commandLine(ens, ["help", "override", "add"]);
    try expect.nothing(nested.problem());
    try expect.text(pathText(nested.helpTarget()), "override add");
}

test "asking for help asks nothing of the arguments that follow it" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["build", "--help", "--frobnicate"]);
    try expect.nothing(read.problem());
    try testing.assertTrue(read.helpRequested(), "help was asked for");

    let missing = parse.commandLine(ens, ["override", "--help"]);
    try expect.nothing(missing.problem());
    try testing.assertTrue(missing.helpRequested(), "no command under 'override' is needed");
}

test "the version is answered wherever it is asked for" {
    let ens = sample.application();
    let read = parse.commandLine(ens, ["--version"]);
    try expect.nothing(read.problem());
    try testing.assertTrue(read.versionRequested(), "the version was asked for");
    try testing.assertFalse(read.helpRequested(), "help was not asked for");
}

test "one set of declarations serves many readings" {
    let ens = sample.application();
    let first = parse.commandLine(ens, ["build", "-o", "one.exe", "--verbose"]);
    let second = parse.commandLine(ens, ["check", "src"]);
    try expect.text(first.value("output"), "one.exe");
    try testing.assertTrue(first.flag("verbose"), "the first reading raised --verbose");
    try expect.nothing(second.value("output"));
    try testing.assertFalse(second.flag("verbose"), "the second reading raised nothing");
    try testing.assertEqual(second.command(), "check");
    try testing.assertEqual(second.positionals().length, 1L);
}

pathText(CommandPath? path) -> string? {
    if (path == null) {
        return null;
    }
    return path.text();
}
