// The applications the parse and help tests read command lines against. The first one is the
// surface the compiler's own driver declares, so what these tests pin is the shape a real program
// asks of this package; the second is a program with no commands at all.
import Application from command;
import Command from command;

public application() -> Application {
    let ens = new Application("ens", "Ens compiler and build tool");
    ens.flag("quiet", 'q', "Print less");
    ens.flag("verbose", 'v', "Print more");
    ens.command(buildCommand());
    ens.command(checkCommand());
    ens.command(runCommand());
    ens.command(testCommand());
    ens.command(overrideCommand());
    ens.command(new Command("version", "Print the toolchain version"));
    ens.command(new Command("cst-dump", "Write out a file's syntax tree", hidden: true));
    return ens;
}

// A program whose options and arguments hang off the application itself.
public plain() -> Application {
    let wrap = new Application("wrap", "Wrap text to a width");
    wrap.argument("file", "The file to wrap");
    wrap.argument("extra", "More files to wrap", required: false, variadic: true);
    wrap.option("width", 'w', "columns", "Wrap at this column");
    return wrap;
}

buildCommand() -> Command {
    let build = new Command("build", "Compile Ens sources",
        details: "The path is an .ens file, a package folder, or a workspace root; with no path\n"
            + "the nearest ens.package above the current folder is used. At a workspace root\n"
            + "every member is built in dependency order.");
    build.argument("path", "File, package, or workspace root", required: false);
    build.option("output", 'o', "file", "Where to put the executable");
    build.option("target", "triple", "Cross-compile for this target triple");
    build.option("optimization-level", 'O', "level", "Optimize at this level, 0 to 3");
    build.option("stdlib", "folder", "Take the standard library from this folder");
    build.flag("explain-arc", "Report what the ARC optimizer elided and why");
    build.flag("locked", "Fail if ens.lock would change");
    build.option("objects", "folder", "Keep the object files in this folder", hidden: true);
    build.option("disable-pass", "name", "Skip one optimizer pass", repeatable: true,
        hidden: true);
    return build;
}

checkCommand() -> Command {
    let check = new Command("check", "Look for errors without building anything");
    check.argument("path", "File, package, or workspace root", required: false);
    check.flag("offline", "Fail instead of fetching anything over the network");
    return check;
}

runCommand() -> Command {
    let run = new Command("run", "Build an application and run it");
    run.argument("path", "File, package, or workspace root", required: false);
    run.flag("locked", "Fail if ens.lock would change");
    run.passthrough();
    return run;
}

testCommand() -> Command {
    let suite = new Command("test", "Build and run the tests");
    suite.argument("path", "Package or folder whose tests to run", required: false);
    suite.option("filter", "text", "Run only the tests whose description contains it");
    suite.option("tests", "folder", "Look for test files in this folder");
    return suite;
}

overrideCommand() -> Command {
    let overrides = new Command("override", "Manage dependency overrides in ens.overrides");
    let add = new Command("add", "Redirect a dependency to a local folder");
    add.argument("package", "The dependency to redirect");
    add.argument("folder", "The folder to redirect it to");
    let remove = new Command("remove", "Stop redirecting a dependency");
    remove.argument("package", "The dependency to stop redirecting");
    overrides.command(add);
    overrides.command(remove);
    overrides.command(new Command("list", "Show every override and whether its target is there"));
    return overrides;
}
