// A fixture's stream pins as one build checks them: an unscoped pin at every level, a pin scoped
// with '-at' only at its own, in the order the fixture writes them, and a pin scoped to a level no
// build checks refused.
import @std.testing;
import directives;

test "a pin scoped to a level is checked at that level and left out at the other" {
    string fixture = "// @exit 134\n"
        + "// @stderr panic: boom\n"
        + "// @stderr-at O0   at helper (main.ens:4)\n"
        + "// @stderr-at O2   at helper (main.ens:4, inlined)\n"
        + "// @stderr   at main (main.ens:9)\n"
        + "// @stdout-contains-at O2 inlined\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let unoptimized = directives.readDirectives(fixture, "O0");
    try testing.assertEqual(unoptimized.problem, "");
    try testing.assertEqual(string.joined(unoptimized.stderrLines.toArray(), "|"),
        "panic: boom|  at helper (main.ens:4)|  at main (main.ens:9)");
    try testing.assertEqual(unoptimized.stdoutContains.length(), 0L);
    let optimized = directives.readDirectives(fixture, "O2");
    try testing.assertEqual(string.joined(optimized.stderrLines.toArray(), "|"),
        "panic: boom|  at helper (main.ens:4, inlined)|  at main (main.ens:9)");
    try testing.assertEqual(optimized.stdoutContains.length(), 1L);
    try testing.assertEqual(optimized.stdoutContains.get(0), "inlined");
}

test "a stream with only scoped exact pins is exact at their level alone" {
    string fixture = "// @stdout-at O2 two\n";
    try testing.assertTrue(directives.readDirectives(fixture, "O2").expectsStdout,
        "the pin makes the stream exact at O2");
    try testing.assertFalse(directives.readDirectives(fixture, "O0").expectsStdout,
        "nothing pins the stream at O0");
}

test "a pin scoped to a level no fixture is built at is refused" {
    let read = directives.readDirectives("// @stderr-at O3 slow\n", "O2");
    try testing.assertEqual(read.problem, "a pin is scoped to 'O3', and fixtures are built only at "
        + "'O0' and 'O2'. Write '-at O0' or '-at O2' instead");
}

test "a scoped pin with no line, and '-at' on a directive no level scopes, are refused" {
    try testing.assertEqual(directives.readDirectives("// @stdout-at O2\n", "O2").problem,
        "'@stdout-at' needs a level and then the line it pins, as in '// @stdout-at O2 <line>'");
    try testing.assertEqual(directives.readDirectives("// @exit-at O2 3\n", "O2").problem,
        "'@exit-at' scopes a directive no level can scope. Only '@stdout', '@stderr', "
        + "'@stdout-contains' and '@stderr-contains' take '-at'");
    try testing.assertEqual(directives.readDirectives("// @expect-error-at codegen\n", "O2")
        .problem, "");
}
