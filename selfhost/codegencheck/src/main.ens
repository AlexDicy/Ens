// The codegen differential harness. It gates the self-hosted code generator against the runnable
// test fixtures: every runnable fixture that is not on the checked-in skip list is compiled by
// the self-hosted pipeline (module graph, sema, codegen), linked through the hidden
// 'ens link-objects' bridge, run, and compared against its own '@exit', '@stdout' and '@stderr'
// directives, which the C++ suite already validates. A fixture whose directives carry
// '@ens-test' is verified through the synthesized test runner instead, reproducing the driver's
// test subcommand over the self-hosted pipeline. The harness also drives the spike (a small Ens
// program that builds an LLVM module returning 42 and emits an object file) through linking and
// execution, keeping the emit-link-run plumbing proven independently of the code generator.
//
// The skip list may only shrink: every runnable fixture must be either codegen-verified or
// listed, and every listed name must still be a runnable fixture. A runnable fixture that fails
// verification and is missing from the list, or a listed name that is no longer a runnable
// fixture, fails the gate. As codegen learns a fixture its entry is removed, never added; an
// empty list means every runnable fixture is codegen-verified.
//
// Exit codes: 0 the gate passed, 1 the spike path, a fixture verification, or the anti-rot rule
// failed, 2 a usage or manifest problem.
import @std.system;
import SystemError from @std.system;
import List from @std.collections.list;
import SystemFileLoader from @ens.sema.support.loader;
import GraphResult from @ens.sema.program.graph;
import @ens.sema.program.graph;
import Manifest from manifest;
import Fixture from manifest;
import manifest;
import directives;
import build;
import enstest;
import text;

main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length < 2) {
        print("codegencheck: usage: codegencheck <manifest-path>");
        return 2;
    }
    let parsed = manifest.parseManifest(try system.readAllText(arguments[1]));
    if (parsed.problems.length() > 0) {
        for (long i = 0; i < parsed.problems.length(); i++) {
            print("codegencheck: manifest: {parsed.problems.get(i)}");
        }
        return 2;
    }

    let failures = new List<string>();

    let spikeReport = runSpikePath(parsed);
    if (spikeReport.length > 0) {
        failures.push(spikeReport);
    } else {
        print("codegencheck: spike path ok: emitted, linked, and ran returning 42");
    }

    let runnable = new List<string>();
    for (long i = 0; i < parsed.fixtures.length(); i++) {
        let fixture = parsed.fixtures.get(i);
        if (directives.isRunnableFixture(build.readOrEmpty(fixture.path()))) {
            runnable.push(fixture.label());
        }
    }

    let skipped = loadSkipList(build.readOrEmpty(parsed.skiplist));

    long verifiedCount = 0;
    for (long i = 0; i < parsed.fixtures.length(); i++) {
        let fixture = parsed.fixtures.get(i);
        if (!text.contains(runnable, fixture.label())
                || text.contains(skipped, fixture.label())) {
            continue;
        }
        string report = verifyFixture(parsed, fixture);
        if (report.length == 0) {
            verifiedCount++;
        } else {
            failures.push("fixture {fixture.label()}: " + report);
        }
    }

    let stale = new List<string>();
    for (long i = 0; i < skipped.length(); i++) {
        if (!text.contains(runnable, skipped.get(i))) {
            stale.push(skipped.get(i));
        }
    }

    print("codegencheck: {runnable.length()} runnable fixture(s), {skipped.length()} skipped, "
        + "{verifiedCount} codegen-verified");
    if (verifiedCount + skipped.length() < runnable.length()) {
        failures.push("{runnable.length() - verifiedCount - skipped.length()} runnable "
            + "fixture(s) are neither codegen-verified nor skipped");
    }
    if (stale.length() > 0) {
        failures.push("{stale.length()} skip-list entr(y/ies) name no runnable fixture; remove "
            + "them (the skip list may only shrink): " + text.joined(stale));
    }

    if (failures.length() > 0) {
        for (long i = 0; i < failures.length(); i++) {
            print("codegencheck: gate FAILED: " + failures.get(i));
        }
        return 1;
    }
    print("codegencheck: gate passed");
    return 0;
} catch (SystemError e) {
    print("codegencheck: {e.message}");
    return 2;
}

// Drives the spike from object emission through linking and execution. Returns "" on success, or
// a description of the first step that failed.
runSpikePath(Manifest parsed) -> string {
    string objectPath = parsed.scratch + "/spike_main.obj";
    string programPath = parsed.scratch + "/spike_program.exe";

    long emit = try build.shellExit(parsed.windowsShell,
        "\"{parsed.spikeExecutable}\" \"{objectPath}\"");
    if (emit != 0) {
        return "the spike exited {emit} instead of emitting an object file";
    }
    if (!system.exists(objectPath)) {
        return "the spike did not write the object file {objectPath}";
    }

    long link = try build.shellExit(parsed.windowsShell, "\"{parsed.ensDriver}\" link-objects "
        + "\"{objectPath}\" --output \"{programPath}\"");
    if (link != 0) {
        return "ens link-objects exited {link} instead of linking the object file";
    }
    if (!system.exists(programPath)) {
        return "ens link-objects did not write {programPath}";
    }

    long ran = try build.shellExit(parsed.windowsShell, "\"{programPath}\"");
    if (ran != 42) {
        return "the linked program exited {ran} instead of 42";
    }
    return "";
} catch (SystemError e) {
    return "the spike path could not run: {e.message}";
}

// Compiles, links, and runs one fixture, comparing the outcome against its directives. An
// '@ens-test' fixture runs through the synthesized test runner instead. Returns "" when the
// fixture verifies, or a description of the first failing step.
verifyFixture(Manifest parsed, Fixture fixture) -> string {
    let read = directives.readDirectives(build.readOrEmpty(fixture.path()));
    if (read.runsEnsTest) {
        return enstest.verify(parsed, fixture, read);
    }
    let loader = new SystemFileLoader();
    string path = text.slashed(fixture.path());
    string sourceRoot = text.parentFolderOf(path);
    GraphResult graphResult;
    if (text.endsWith(fixture.label(), ".ens")) {
        graphResult = graph.buildFileProgram(loader, sourceRoot, "", parsed.stdlibRoot,
            text.fileNameOf(path));
    } else {
        graphResult = graph.buildGraph(loader, sourceRoot, "", parsed.stdlibRoot,
            ["main.ens"]);
    }

    string prefix = text.sanitizedLabel(fixture.label());
    string buildProblem = try build.compileAndLink(parsed, graphResult, prefix);
    if (buildProblem.length > 0) {
        return buildProblem;
    }
    let ran = try build.runCaptured(parsed, prefix);
    return directives.compareRun(read, ran.exitCode, ran.stdoutText, ran.stderrText);
} catch (SystemError e) {
    return "could not run: {e.message}";
}

loadSkipList(string content) -> List<string> {
    let entries = new List<string>();
    string[] lines = text.splitLines(content);
    for (let raw in lines) {
        string line = text.trim(raw);
        if (line.length == 0 || text.startsWith(line, "#")) {
            continue;
        }
        entries.push(line);
    }
    return entries;
}
