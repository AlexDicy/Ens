// The fixture's ground-truth directives, the same lines the test runner asserts, and the
// stream comparison they drive. A fixture with an '@ens-test' line is verified through the
// synthesized test runner instead of being compiled and run as a program.
import List from @std.collections.list;
import @std.text.strings;
import text;

public class Directives {
    public long expectedExit;

    public bool expectsStdout;
    public List<string> stdoutLines;
    public List<string> stdoutContains;

    public bool expectsStderr;
    public List<string> stderrLines;
    public List<string> stderrContains;

    public bool runsEnsTest;
    public string[] ensTestArguments;

    // A std/ package the fixture is compiled against instead of the manifest's, relative to the
    // fixture's own folder; "" when the fixture uses the tree's standard library.
    public string stdlibRoot;

    public constructor() {
        this.expectedExit = 0;
        this.expectsStdout = false;
        this.stdoutLines = new List<string>();
        this.stdoutContains = new List<string>();
        this.expectsStderr = false;
        this.stderrLines = new List<string>();
        this.stderrContains = new List<string>();
        this.runsEnsTest = false;
        this.ensTestArguments = [];
        this.stdlibRoot = "";
    }
}

public readDirectives(string content) -> Directives {
    let directives = new Directives();
    string[] lines = content.lines();
    for (let line in lines) {
        string comment = text.commentBody(line);
        if (comment.startsWith("@exit ")) {
            let value = strings.parseInteger(
                comment.substring("@exit ".length, comment.length).trim());
            if (value != null) {
                directives.expectedExit = value;
            }
        } else if (comment.startsWith("@stdout-contains ")) {
            directives.stdoutContains.push(
                comment.substring("@stdout-contains ".length, comment.length));
        } else if (comment.startsWith("@stdout ")) {
            directives.expectsStdout = true;
            directives.stdoutLines.push(comment.substring("@stdout ".length, comment.length));
        } else if (comment.startsWith("@stderr-contains ")) {
            directives.stderrContains.push(
                comment.substring("@stderr-contains ".length, comment.length));
        } else if (comment.startsWith("@stderr ")) {
            directives.expectsStderr = true;
            directives.stderrLines.push(comment.substring("@stderr ".length, comment.length));
        } else if (comment == "@ens-test" || comment.startsWith("@ens-test ")) {
            directives.runsEnsTest = true;
            directives.ensTestArguments = tokensOf(
                comment.substring("@ens-test".length, comment.length));
        } else if (comment.startsWith("@stdlib ")) {
            directives.stdlibRoot =
                comment.substring("@stdlib ".length, comment.length).trim();
        }
    }
    return directives;
}

tokensOf(string rest) -> string[] {
    let tokens = new List<string>();
    byte[] raw = rest.toBytes();
    long start = 0;
    for (long i = 0; i <= raw.length; i++) {
        bool boundary = i == raw.length || raw[i] == ' ' || raw[i] == '\t';
        if (boundary) {
            if (i > start) {
                tokens.push(rest.substring(start, i));
            }
            start = i + 1;
        }
    }
    return tokens.toArray();
}

// True when a fixture is a runnable program: it asserts an exit code or a stream's contents and
// is not an expect-error case (which the compiler must reject rather than run).
public isRunnableFixture(string content) -> bool {
    bool asserts = false;
    string[] lines = content.lines();
    for (let line in lines) {
        string comment = text.commentBody(line);
        if (comment.startsWith("@expect-error")) {
            return false;
        }
        if (comment.startsWith("@exit") || comment.startsWith("@stdout")
                || comment.startsWith("@stderr")) {
            asserts = true;
        }
    }
    return asserts;
}

// Compares one run against the directives: the exit code, then each stream's exact-line and
// substring expectations. Returns "" on a match, or a description of the first mismatch.
public compareRun(Directives directives, long exitCode, string stdoutText, string stderrText)
        -> string {
    if (exitCode != directives.expectedExit) {
        return "the program exited {exitCode}, expected {directives.expectedExit}";
    }
    string report = streamProblem("stdout", text.normalizedOutput(stdoutText),
        directives.expectsStdout, directives.stdoutLines, directives.stdoutContains);
    if (report.length > 0) {
        return report;
    }
    return streamProblem("stderr", text.normalizedOutput(stderrText),
        directives.expectsStderr, directives.stderrLines, directives.stderrContains);
}

// Compares one captured stream against its exact-line and substring directives. Returns "" when
// the stream matches, or a description of the first mismatch.
streamProblem(string label, string actual, bool exact, List<string> lines, List<string> contains) -> string {
    if (exact) {
        string expected = string.joined(lines.toArray(), "\n");
        if (actual != expected) {
            return "{label} was '{actual}', expected '{expected}'";
        }
    }
    for (long i = 0; i < contains.length(); i++) {
        if (actual.indexOf(contains.get(i)) < 0) {
            return "{label} is missing '{contains.get(i)}'";
        }
    }
    return "";
}
