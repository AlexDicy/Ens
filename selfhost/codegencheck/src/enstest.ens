// Verifies an '@ens-test' fixture by playing a test run over the self-hosted pipeline. It discovers
// the fixture's tests and synthesizes its runner the way the command does, both out of
// '@ens.build.testing', so there is one description of what a test run is.
import ProcessError from @std.process;
import @std.process;
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;
import Path from @std.fs;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import @ens.sema.program.graph;
import @ens.host.paths;
import DiscoveredTest from @ens.build.testing.discovery;
import TestPlan from @ens.build.testing.discovery;
import @ens.build.testing.discovery;
import Runner from @ens.build.testing.runner;
import RunnerOverlay from @ens.build.testing.runner;
import RunnerOutput from @ens.build.testing.runner;
import @ens.build.testing.runner;
import @ens.build.sources;
import @ens.host.childexit;
import @std.environment;
import @std.text.parse;
import Manifest from manifest;
import Fixture from manifest;
import Directives from directives;
import directives;
import Environment from build;
import build;
import text;

// Runs the fixture's test suite the way 'ens test <folder> <arguments>' runs it and compares the
// outcome against the fixture's directives. Returns "" when the fixture verifies, or a description
// of the first failing step.
public verify(Manifest manifest, Environment environment, Fixture fixture, Directives parsed) -> string {
    Path sourceRoot = paths.native(fixture.path()).parent() ?? Path("");
    let asked = readArguments(parsed.ensTestArguments, sourceRoot);
    if (asked.problem.length > 0) {
        return asked.problem;
    }
    Path discoveryRoot = sourceRoot;
    if (!asked.testsRoot.isEmpty()) {
        discoveryRoot = asked.testsRoot;
    }

    FileLoader tree = new SystemFileLoader();
    let plan = discovery.plan(tree, discoveryRoot, asked.filter);
    if (plan.usageProblem().length > 0) {
        return directives.compareRun(parsed, 2, "", reported(plan.usageProblem()));
    }
    if (plan.nothingToRun().length > 0) {
        return directives.compareRun(parsed, 0, plan.nothingToRun(), "");
    }

    string stdlibRoot = manifest.stdlibRoot;
    if (parsed.stdlibRoot.length > 0) {
        stdlibRoot = sourceRoot.join(parsed.stdlibRoot).toString();
    }
    let sourceFiles = sources.scan(sourceRoot);
    if (sourceFiles.failure().length > 0) {
        return sourceFiles.failure();
    }
    let graphResult = graph.buildGraphWithTests(overlayOver(tree, discoveryRoot, plan), sourceRoot,
        asked.testsRoot, Path(stdlibRoot), sourceFiles.files(), seedsOf(plan));
    string prefix = text.sanitizedLabel(fixture.label());
    Environment building = environment;
    if (asked.explainArc) {
        building = environment.explainingArc();
    }
    let built = build.compileAndLink(manifest, building, graphResult, prefix);
    if (built.problem.length > 0) {
        return "the test build failed: " + built.problem;
    }

    let played = try play(build.executablePath(manifest, prefix), plan.tests(), asked.jobs);
    let outcome = runner.outcomeOf(played.code, plan.tests(), played.output);
    return directives.compareRun(parsed, outcome.exitCode(),
        accounted(built.explanation) + played.text, reported(outcome.failure()));
} catch (ProcessError e) {
    return e.message;
}

// The account the command prints before the run it explains, one line each.
accounted(string[] explanation) -> string {
    let gathered = new StringBuilder();
    for (let line in explanation) {
        gathered.append(line);
        gathered.append("\n");
    }
    return gathered.toString();
}

// What playing a test run came to: what the command would show, its results before what the
// suite wrote to the error stream, and the runner's output as the command read it.
class PlayedRun {
    protected string text;
    protected RunnerOutput output;
    protected int code;

    protected constructor(this.text, this.output, this.code);
}

// Runs the built suite on `jobs` tasks and gathers what the command would show: the runner's
// results in order, then what a test wrote to the error stream, which is the order the command
// passes the two streams on in. The output is read the way the command reads it, so a run that
// ended early names the same tests.
play(string suite, DiscoveredTest[] tests, long jobs) -> PlayedRun throws {
    let ran = try process.run(paths.native(suite), ["{jobs}"], captureOutput: true);
    let gathered = new StringBuilder();
    let output = new RunnerOutput(tests);
    for (let line in linesOf(ran.stdout)) {
        for (let shown in output.accept(line)) {
            gathered.append(shown);
            gathered.append("\n");
        }
    }
    for (let shown in output.remaining()) {
        gathered.append(shown);
        gathered.append("\n");
    }
    for (let line in linesOf(ran.stderr)) {
        gathered.append(line);
        gathered.append("\n");
    }
    return new PlayedRun(gathered.toString(), output, childexit.exitCodeOf(ran.status));
}

// The lines one stream held, with no line at all for a stream that held nothing.
linesOf(string stream) -> string[] {
    string written = text.normalizedOutput(stream);
    if (written.isEmpty()) {
        return [];
    }
    return written.lines();
}

// The runner over the tree the tests were read from, exactly as the command injects it.
overlayOver(FileLoader tree, Path discoveryRoot, TestPlan plan) -> FileLoader {
    return new RunnerOverlay(tree, discoveryRoot.join(Runner.fileName),
        runner.source(plan.tests()));
}

// The files the graph starts from: every test file, then the runner that calls into them.
seedsOf(TestPlan plan) -> string[] {
    let seeds = new List<string>();
    for (let file in plan.testFiles()) {
        seeds.push(file);
    }
    seeds.push(Runner.fileName);
    return seeds.toArray();
}

// What the command line requested: a filter, a tests folder, the account of what the optimizer
// elided, how many tests run at the same time, or a token none of those.
class Arguments {
    protected string filter;
    protected Path testsRoot;
    protected bool explainArc;
    protected long jobs;
    protected string problem;

    protected constructor(this.filter, this.testsRoot, this.explainArc, this.jobs, this.problem);
}

readArguments(string[] arguments, Path sourceRoot) -> Arguments {
    string filter = "";
    Path testsRoot = Path("");
    bool explainArc = false;
    long jobs = environment.processorCount();
    long next = 0;
    while (next < arguments.length) {
        string argument = arguments[next];
        if (argument == "--filter" && next + 1 < arguments.length) {
            filter = expandDir(arguments[next + 1], sourceRoot);
            next = next + 2;
        } else if (argument == "--tests" && next + 1 < arguments.length) {
            testsRoot = paths.native(expandDir(arguments[next + 1], sourceRoot));
            next = next + 2;
        } else if (argument == "--explain-arc") {
            explainArc = true;
            next = next + 1;
        } else if (argument == "--jobs" && next + 1 < arguments.length
                && (parse.parseLong(arguments[next + 1]) ?? 0) >= 1) {
            jobs = parse.parseLong(arguments[next + 1]) ?? 1;
            next = next + 2;
        } else {
            return new Arguments("", Path(""), false, 1,
                "unsupported '@ens-test' argument '{argument}'");
        }
    }
    return new Arguments(filter, testsRoot, explainArc, jobs, "");
}

// A line the command writes on its error stream.
reported(string problem) -> string {
    if (problem.length == 0) {
        return "";
    }
    return problem + "\n";
}

// Every '\{dir\}' in an @ens-test argument expands to the fixture's source folder.
expandDir(string token, Path folder) -> string {
    string marker = "\{dir\}";
    long at = token.indexOf(marker);
    if (at < 0) {
        return token;
    }
    return token.substring(0, at) + folder.toString()
        + expandDir(token.substring(at + marker.length, token.length), folder);
}
