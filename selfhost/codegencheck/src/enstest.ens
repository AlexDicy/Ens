// Verifies an '@ens-test' fixture: the harness plays a test run over the self-hosted pipeline. It
// discovers the fixture's tests and synthesizes its runner the way the command does - both come
// from '@ens.build.testing', so there is one description of what a test run is - then compiles and
// runs the result and maps the run to the driver's observable contract: the runner's stdout echoed
// verbatim, its stderr passed through, and an exit code outside {0, 1} reported as an aborted run
// naming the test that was running.
import @std.system;
import SystemError from @std.system;
import List from @std.collections.list;
import @std.text.strings;
import @std.path;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import @ens.sema.program.graph;
import @ens.build.paths;
import DiscoveredTest from @ens.build.testing.discovery;
import TestPlan from @ens.build.testing.discovery;
import @ens.build.testing.discovery;
import RunnerOverlay from @ens.build.testing.runner;
import @ens.build.testing.runner;
import Manifest from manifest;
import Fixture from manifest;
import Directives from directives;
import directives;
import CapturedRun from build;
import Environment from build;
import build;
import text;

// What the driver's test subcommand would have shown: its exit code and its two streams.
class DriverOutcome {
    protected long exitCode;
    protected string stdoutText;
    protected string stderrText;

    protected constructor(this.exitCode, this.stdoutText, this.stderrText);
}

// Runs the fixture's test suite the way 'ens test <folder> <arguments>' runs it and compares the
// outcome against the fixture's directives. Returns "" when the fixture verifies, or a description
// of the first failing step.
public verify(Manifest manifest, Environment environment, Fixture fixture,
              Directives parsed) -> string {
    string sourceRoot = path.parentFolder(paths.native(fixture.path()));
    let asked = readArguments(parsed.ensTestArguments, sourceRoot);
    if (asked.problem.length > 0) {
        return asked.problem;
    }
    string discoveryRoot = sourceRoot;
    if (asked.testsRoot.length > 0) {
        discoveryRoot = asked.testsRoot;
    }

    FileLoader tree = new SystemFileLoader();
    let plan = discovery.plan(tree, discoveryRoot, asked.filter);
    if (plan.usageProblem().length > 0) {
        return compare(parsed, new DriverOutcome(2, "", plan.usageProblem() + "\n"));
    }
    if (plan.nothingToRun().length > 0) {
        return compare(parsed, new DriverOutcome(0, plan.nothingToRun(), ""));
    }

    let graphResult = graph.buildGraph(overlayOver(tree, discoveryRoot, plan), sourceRoot,
        asked.testsRoot, manifest.stdlibRoot, seedsOf(plan));
    string prefix = text.sanitizedLabel(fixture.label());
    string buildProblem = build.compileAndLink(manifest, environment, graphResult, prefix);
    if (buildProblem.length > 0) {
        return "the test build failed: " + buildProblem;
    }

    let ran = try build.runCaptured(manifest, prefix);
    return compare(parsed, driverOutcomeOf(ran, plan.tests()));
} catch (SystemError e) {
    return "could not run: {e.message}";
}

compare(Directives parsed, DriverOutcome outcome) -> string {
    return directives.compareRun(parsed, outcome.exitCode, outcome.stdoutText,
        outcome.stderrText);
}

// The runner over the tree the tests were read from, exactly as the command injects it.
overlayOver(FileLoader tree, string discoveryRoot, TestPlan plan) -> FileLoader {
    return new RunnerOverlay(tree, path.join(discoveryRoot, runner.fileName()),
        runner.source(plan.tests()));
}

// The files the graph starts from: every test file, then the runner that calls into them.
seedsOf(TestPlan plan) -> string[] {
    let seeds = new List<string>();
    for (let file in plan.testFiles()) {
        seeds.push(file);
    }
    seeds.push(runner.fileName());
    return seeds.toArray();
}

// The driver echoes the runner's captured stdout verbatim and lets its stderr through; an exit
// code other than 0 (all passed) and 1 (some failed) means the run aborted partway, so the
// driver reports the test that was running on stderr and maps a negative code (a hard crash) to
// 2 and any other abnormal code to 1.
driverOutcomeOf(CapturedRun ran, DiscoveredTest[] tests) -> DriverOutcome {
    if (ran.exitCode == 0 || ran.exitCode == 1) {
        return new DriverOutcome(ran.exitCode, ran.stdoutText, ran.stderrText);
    }
    string report = abortReport(tests, ran.stdoutText, ran.exitCode);
    long mapped = 1;
    if (ran.exitCode < 0) {
        mapped = 2;
    }
    return new DriverOutcome(mapped, ran.stdoutText, ran.stderrText + report);
}

// Names the test that was running when the runner died: each completed test printed exactly one
// line beginning "PASS " or "FAIL ", so the crasher is the next test after those.
abortReport(DiscoveredTest[] tests, string runnerStdout, long exitCode) -> string {
    long reported = 0;
    for (let line in strings.lines(runnerStdout)) {
        if (line.startsWith("PASS ") || line.startsWith("FAIL ")) {
            reported++;
        }
    }
    string report = "The test run ended unexpectedly (exit code {exitCode})";
    if (reported < tests.length) {
        report = report + " while running test '{tests[reported].description()}' "
            + "({tests[reported].file()})";
    }
    return report + ". {reported} of {tests.length} tests had reported a result.\n";
}

// What the command line asked for: a filter, a tests folder, or a token neither of those.
class Arguments {
    protected string filter;
    protected string testsRoot;
    protected string problem;

    protected constructor(this.filter, this.testsRoot, this.problem);
}

readArguments(string[] arguments, string sourceRoot) -> Arguments {
    string filter = "";
    string testsRoot = "";
    long next = 0;
    while (next < arguments.length) {
        string argument = arguments[next];
        if (argument == "--filter" && next + 1 < arguments.length) {
            filter = expandDir(arguments[next + 1], sourceRoot);
            next = next + 2;
        } else if (argument == "--tests" && next + 1 < arguments.length) {
            testsRoot = paths.native(expandDir(arguments[next + 1], sourceRoot));
            next = next + 2;
        } else {
            return new Arguments("", "", "unsupported @ens-test argument '{argument}'");
        }
    }
    return new Arguments(filter, testsRoot, "");
}

// Every '\{dir\}' in an @ens-test argument expands to the fixture's source folder.
expandDir(string token, string folder) -> string {
    string marker = "\{dir\}";
    long at = token.indexOf(marker);
    if (at < 0) {
        return token;
    }
    return token.substring(0, at) + folder
        + expandDir(token.substring(at + marker.length, token.length), folder);
}
