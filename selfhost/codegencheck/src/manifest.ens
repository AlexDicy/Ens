// The harness manifest: which spike, standard library, scratch folder, and skip list to use, plus
// one line per candidate fixture and one line per test file inside a fixture folder.
// The test-file lines exist because the standard library has no directory enumeration yet; the
// test task enumerates each fixture folder's '*_test.ens' files when it writes the manifest, and
// the '@ens-test' verification narrows them by the fixture's own arguments.
//
// Format, one keyword per line, values separated by one space:
//   spike <path to the prebuilt spike executable>
//   stdlib <folder containing std/>
//   scratch <a writable scratch folder>
//   skiplist <path to the checked-in skip-list file>
//   fixture <label> <path to the fixture's directive-bearing source file>
//   testfile <label> <path of a test file, relative to the fixture's source folder>
import List from @std.collections.list;
import @std.text.strings;
import Map from @std.collections.map;

public class Fixture {
    string fixtureLabel;
    string fixturePath;

    public constructor(this.fixtureLabel, this.fixturePath);

    public label() -> string {
        return this.fixtureLabel;
    }

    public path() -> string {
        return this.fixturePath;
    }
}

public class Manifest {
    public string spikeExecutable;
    public string stdlibRoot;
    public string scratch;
    public string skiplist;
    public List<Fixture> fixtures;
    public List<string> problems;
    Map<string, List<string>> testFilesByLabel;

    public constructor() {
        this.spikeExecutable = "";
        this.stdlibRoot = "";
        this.scratch = "";
        this.skiplist = "";
        this.fixtures = new List<Fixture>();
        this.problems = new List<string>();
        this.testFilesByLabel = new Map<string, List<string>>();
    }

    // The fixture's test files as the manifest lists them, relative to its source folder.
    public testFilesFor(string label) -> List<string> {
        let listed = this.testFilesByLabel.get(label);
        if (listed == null) {
            return new List<string>();
        }
        return listed;
    }

    protected addTestFile(string label, string relativePath) {
        let listed = this.testFilesByLabel.get(label);
        if (listed == null) {
            let created = new List<string>();
            created.push(relativePath);
            this.testFilesByLabel.set(label, created);
        } else {
            listed.push(relativePath);
        }
    }
}

public parseManifest(string content) -> Manifest {
    let manifest = new Manifest();
    string[] lines = strings.lines(content);
    for (long i = 0; i < lines.length; i++) {
        string line = lines[i].trim();
        if (line.length == 0) {
            continue;
        }
        long space = line.indexOf(" ");
        if (space < 0) {
            manifest.problems.push("line {i + 1}: expected '<keyword> <value>', got '{line}'");
            continue;
        }
        string keyword = line.substring(0, space);
        string value = line.substring(space + 1, line.length).trim();
        switch (keyword) {
            "spike" -> {
                manifest.spikeExecutable = value;
            },
            "stdlib" -> {
                manifest.stdlibRoot = value;
            },
            "scratch" -> {
                manifest.scratch = value;
            },
            "skiplist" -> {
                manifest.skiplist = value;
            },
            "fixture" -> {
                long gap = value.indexOf(" ");
                if (gap < 0) {
                    manifest.problems.push("line {i + 1}: 'fixture' needs a label and a path");
                } else {
                    manifest.fixtures.push(new Fixture(value.substring(0, gap),
                        value.substring(gap + 1, value.length).trim()));
                }
            },
            "testfile" -> {
                long gap = value.indexOf(" ");
                if (gap < 0) {
                    manifest.problems.push("line {i + 1}: 'testfile' needs a label and a path");
                } else {
                    manifest.addTestFile(value.substring(0, gap),
                        value.substring(gap + 1, value.length).trim());
                }
            },
            default -> {
                manifest.problems.push("line {i + 1}: unknown keyword '{keyword}'");
            },
        }
    }
    if (manifest.spikeExecutable.length == 0) {
        manifest.problems.push("missing a 'spike' line");
    }
    if (manifest.stdlibRoot.length == 0) {
        manifest.problems.push("missing a 'stdlib' line");
    }
    if (manifest.scratch.length == 0) {
        manifest.problems.push("missing a 'scratch' line");
    }
    if (manifest.skiplist.length == 0) {
        manifest.problems.push("missing a 'skiplist' line");
    }
    return manifest;
}
