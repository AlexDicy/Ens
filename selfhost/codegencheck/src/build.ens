// The compile-link-run machinery every verification shares: an analyzed module graph goes through
// the self-hosted pipeline into object files, those are linked, and the program runs with each
// stream captured. The settings and the toolchain are settled once per run, since they never vary.
import @std.process;
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import List from @std.collections.list;
import FileDiagnostic from @ens.sema.support.diagnostics;
import GraphResult from @ens.sema.program.graph;
import SystemFileLoader from @ens.sema.support.loader;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.sema.pipeline;
import CodegenSettings from @ens.codegen.settings;
import OptimizationLevel from @ens.codegen.settings;
import @ens.codegen.settings;
import @ens.codegen.driver;
import LinkRequest from @ens.link.request;
import Toolchain from @ens.link.toolchain;
import @ens.link.discovery;
import @ens.link.flavor;
import @ens.link.linker;
import @ens.build.diagnostics;
import SourceCatalog from @ens.build.diagnostics;
import @ens.build.natives;
import @ens.build.platform;
import @ens.host.childexit;
import @ens.host.paths;
import Manifest from manifest;

// Everything one harness run shares: the settings its fixtures are compiled with, the target they
// are compiled for, and the toolchain their links go through.
public class Environment {
    CodegenSettings buildSettings;
    Toolchain linkToolchain;
    string targetPlatform;

    protected constructor(this.buildSettings, this.linkToolchain, this.targetPlatform);

    public settings() -> CodegenSettings {
        return this.buildSettings;
    }

    public toolchain() -> Toolchain {
        return this.linkToolchain;
    }

    // The platform name a manifest's native bindings use for the target.
    public platform() -> string {
        return this.targetPlatform;
    }

    public level() -> string {
        return "{this.buildSettings.llvmOptimizationLevel()}";
    }

    // The same environment with the account of what the optimizer elided gathered, for a fixture
    // whose test run asks for it with '--explain-arc'.
    public explainingArc() -> Environment {
        let current = this.buildSettings;
        return new Environment(new CodegenSettings(current.optimizationLevel(),
            current.target(), current.disabledPasses(), false, true, false, true),
            this.linkToolchain, this.targetPlatform);
    }
}

// What compiling and linking one fixture came to: a description of the first failing step, or ""
// beside the account the build gathered when its settings asked for one.
public class BuildOutcome {
    public string problem;
    public string[] explanation;

    public constructor(this.problem, this.explanation);
}

// The environment the manifest requires: this machine's target at the level the manifest names, and
// the toolchain looked up once for every link that follows. Every body is lowered and verified,
// the ones a fixture's entry point never reaches included, since a fixture often exists for one of
// those.
public environmentFor(Manifest manifest) -> Environment {
    let host = platform.hostTarget();
    let level = settings.levelFromText(manifest.optimization) ?? OptimizationLevel.Default;
    string[] everyPass = [];
    return new Environment(new CodegenSettings(level, host, everyPass, false, false, false,
        true), discovery.discover(flavor.flavorOf(host.text()), host),
        platform.platformName(host.text()));
}

// Compiles the graph through sema and the self-hosted code generator and links the result to
// '<scratch>/<prefix>.exe'.
public compileAndLink(Manifest manifest, Environment environment, GraphResult graphResult,
                      string prefix) -> BuildOutcome {
    string upstream = upstreamProblems(graphResult);
    if (upstream.length > 0) {
        return failed(upstream);
    }
    let analysis = pipeline.analyzeProgram(graphResult);
    string semaProblems = analysisProblems(analysis);
    if (semaProblems.length > 0) {
        return failed(semaProblems);
    }

    let emitted = driver.emitProgram(analysis, manifest.scratch, prefix + ".",
        environment.settings());
    if (!emitted.succeeded()) {
        return failed("codegen failed: " + firstDiagnostics(emitted.diagnostics(), graphResult));
    }
    if (emitted.objects().length() == 0) {
        return failed("codegen produced no object files");
    }

    let plan = natives.librariesFor(graphResult.natives(), environment.platform());
    if (plan.failure().length > 0) {
        return failed("the fixture's native libraries cannot be linked: " + plan.failure());
    }
    if (plan.artifacts().length > 0) {
        return failed("the fixture binds the prebuilt native library "
            + "'{plan.artifacts()[0].library()}', which this harness does not fetch");
    }
    return new BuildOutcome(linkObjects(environment, emitted.objects(),
        executablePath(manifest, prefix), plan.libraries()), emitted.explanation());
}

failed(string problem) -> BuildOutcome {
    return new BuildOutcome(problem, []);
}

// Links emitted objects into a program. Returns "" on success, or the linker's own words.
public linkObjects(Environment environment, List<string> objects, string programPath,
                   string[] libraries) -> string {
    string[] libraryFiles = [];
    let linked = linker.link(new LinkRequest(objects.toArray(), libraries, libraryFiles,
        programPath, environment.settings().target()), environment.toolchain());
    if (linked.linked()) {
        return "";
    }
    return "linking '{programPath}' failed: " + linked.output();
}

public executablePath(Manifest manifest, string prefix) -> string {
    return manifest.scratch + "/" + prefix + ".exe";
}

// One program run with each stream captured, so stdout and stderr are asserted independently the
// way the reference runner asserts them.
public class CapturedRun {
    public long exitCode;
    public string stdoutText;
    public string stderrText;

    public constructor(this.exitCode, this.stdoutText, this.stderrText);
}

public runCaptured(Manifest manifest, string prefix) -> CapturedRun throws {
    return try run(executablePath(manifest, prefix), []);
}

// Runs a program with its arguments and both streams captured. No shell takes part, so an argument
// holding spaces needs no quoting. The program is named the way the machine writes a path, since
// it comes from the manifest a harness wrote.
public run(string program, string[] arguments) -> CapturedRun throws {
    let ran = try process.run(paths.native(program), arguments, captureOutput: true);
    return new CapturedRun(childexit.exitCodeOf(ran.status), ran.stdout, ran.stderr);
}

// Graph or parse diagnostics mean the fixture never reached sema; both are semacheck-level
// regressions for a fixture the suite expects to compile.
upstreamProblems(GraphResult graphResult) -> string {
    FileDiagnostic[] graphDiagnostics = graphResult.diagnostics();
    if (graphDiagnostics.length > 0) {
        return "the module graph reported " + counted(graphDiagnostics.length, "problem")
            + firstOf(graphDiagnostics.length) + graphDiagnostics[0].message();
    }
    for (let loaded in graphResult.modules()) {
        let parseDiagnostics = loaded.parseResult().diagnostics();
        if (parseDiagnostics.length > 0) {
            return "{loaded.filePath()} has " + counted(parseDiagnostics.length, "parse problem")
                + firstOf(parseDiagnostics.length) + parseDiagnostics[0].message();
        }
    }
    return "";
}

// A runnable fixture must be clean through every sema stage; a diagnostic here is a
// semacheck-level bug, not a codegen failure.
analysisProblems(ProgramAnalysis analysis) -> string {
    let merged = new List<FileDiagnostic>();
    appendAll(merged, analysis.declareDiagnostics());
    appendAll(merged, analysis.linkDiagnostics());
    appendAll(merged, analysis.signatureDiagnostics());
    appendAll(merged, analysis.layoutDiagnostics());
    appendAll(merged, analysis.checkDiagnostics());
    appendAll(merged, analysis.bodyDiagnostics());
    appendAll(merged, analysis.exceptionDiagnostics());
    if (merged.length() > 0) {
        string first = ", the first: ";
        if (merged.length() == 1) {
            first = ": ";
        }
        return "sema reported " + counted(merged.length(), "diagnostic") + " on an accepted "
            + "fixture, which semacheck should have caught" + first + merged.get(0).message();
    }
    return "";
}

// "1 problem" or "3 problems".
counted(long count, string noun) -> string {
    if (count == 1) {
        return "1 {noun}";
    }
    return "{count} {noun}s";
}

// What joins a count to the message of its first item.
firstOf(long count) -> string {
    if (count == 1) {
        return ": ";
    }
    return ", the first: ";
}

appendAll(List<FileDiagnostic> sink, FileDiagnostic[] diagnostics) {
    for (let diagnostic in diagnostics) {
        sink.push(diagnostic);
    }
}

// The first few problems, each written the way a build prints it, with its file, line and column.
firstDiagnostics(FileDiagnostic[] problems, GraphResult graphResult) -> string {
    let catalog = new SourceCatalog(new SystemFileLoader());
    catalog.addGraph(graphResult);
    string described = "";
    long shown = problems.length;
    if (shown > 3) {
        shown = 3;
    }
    for (long i = 0; i < shown; i++) {
        if (i > 0) {
            described = described + "; ";
        }
        described = described + diagnostics.format(problems[i], catalog);
    }
    if (problems.length > shown) {
        described = described + "; and {problems.length - shown} more";
    }
    return described;
}

// A file's text, or empty when it could not be read. Bytes that spell no character are replaced
// rather than refused: a fixture may hold malformed bytes on purpose, and the directives this
// reads are ASCII.
public readOrEmpty(string path) -> string {
    return string.fromBytesLossy(try Path(path).readBytes());
} catch (FileSystemError refused) {
    return "";
}
