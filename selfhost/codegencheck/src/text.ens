// The text rewriting the harness needs beyond what '@std.text.strings' already answers: the label
// and separator forms the scratch folder wants, and the output normalization the stream comparisons
// rely on. Nothing here touches the file system.
import List from @std.collections.list;

public contains(List<string> values, string needle) -> bool {
    for (long i = 0; i < values.length(); i++) {
        if (values.get(i) == needle) {
            return true;
        }
    }
    return false;
}

public sanitizedLabel(string label) -> string {
    byte[] raw = label.toBytes();
    byte[] out = new byte[raw.length];
    for (long i = 0; i < raw.length; i++) {
        byte value = raw[i];
        bool kept = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
            || (value >= '0' && value <= '9') || value == '_' || value == '.';
        if (kept) {
            out[i] = value;
        } else {
            out[i] = '_';
        }
    }
    return string.fromBytes(out);
}

// The body of a '//' comment line with its leading whitespace dropped, or "" for other lines.
public commentBody(string line) -> string {
    string trimmed = line.trimStart();
    if (!trimmed.startsWith("//")) {
        return "";
    }
    return trimmed.substring(2, trimmed.length).trimStart();
}

// The captured output with carriage returns dropped and trailing newlines trimmed, matching
// how the C++ test runner compares '@stdout' lines.
public normalizedOutput(string text) -> string {
    byte[] raw = text.toBytes();
    let kept = new List<byte>();
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] != '\r') {
            kept.push(raw[i]);
        }
    }
    long end = kept.length();
    while (end > 0 && kept.get(end - 1) == '\n') {
        end--;
    }
    byte[] bytes = new byte[end];
    for (long i = 0; i < end; i++) {
        bytes[i] = kept.get(i);
    }
    return string.fromBytes(bytes);
}
