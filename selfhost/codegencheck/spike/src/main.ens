import @std.system;
import @ens.llvm.capi;

// The codegen spike: builds an LLVM module whose main() returns the constant 42, then emits it as
// a native object file at the path given on the command line. It exercises the ens.llvm binding
// end to end - context, types, constants, functions, basic blocks, verification, and object
// emission through a target machine for the host - so the differential harness can link and run
// the result and assert it exits 42.
main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length < 2) {
        print("usage: spike <output-object>");
        return 2;
    }
    string outputPath = arguments[1];

    let context = capi.createContext();
    let module = context.createModule("spike");
    let intType = context.int32Type();
    let functionType = intType.functionType([]);
    let function = module.addFunction("main", functionType);
    let block = context.appendBasicBlock(function, "entry");
    let builder = context.createBuilder();
    builder.positionAtEnd(block);
    let constant = intType.constInt(42);
    let returned = builder.buildReturn(constant);

    if (!module.verify()) {
        print("the module did not verify");
        return 5;
    }

    capi.initializeHostTarget();
    string triple = capi.hostTargetTriple();
    let target = capi.targetFromTriple(triple);
    if (target == null) {
        print("could not resolve the host target");
        return 3;
    }
    let machine = target.createTargetMachine(triple);
    if (!machine.emitObjectFile(module, outputPath)) {
        print("could not emit the object file");
        return 4;
    }
    return 0;
}
