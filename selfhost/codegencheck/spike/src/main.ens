import @std.system;
import @ens.llvm.core;
import @ens.llvm.instructions;
import @ens.llvm.analysis;
import @ens.llvm.target;

// The codegen spike: builds an LLVM module whose main() returns the constant 42, then emits it as
// a native object file at the path given on the command line. It exercises the restructured
// ens.llvm binding end to end - context, types, constants, functions, basic blocks, the builder
// instruction surface, verification through the real message channel, and object emission through
// a target machine for the host - so the differential harness can link and run the result and
// assert it exits 42.
main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length < 2) {
        print("usage: spike <output-object>");
        return 2;
    }
    string outputPath = arguments[1];

    let context = core.createContext();
    let module = context.createModule("spike");
    let intType = context.int32Type();
    let functionType = intType.functionType([]);
    let function = module.addFunction("main", functionType);
    let block = context.appendBasicBlock(function, "entry");
    let builder = context.createBuilder();
    builder.positionAtEnd(block);
    let constant = intType.constInt(42, false);
    let returned = instructions.buildRet(builder, constant);

    let error = analysis.verify(module);
    if (error.length > 0) {
        print("the module did not verify: {error}");
        return 5;
    }

    target.initializeHostTarget();
    string triple = target.hostTargetTriple();
    let resolved = target.targetFromTriple(triple);
    if (resolved == null) {
        print("could not resolve the host target");
        return 3;
    }
    let machine = resolved.createTargetMachine(triple);
    if (!machine.emitObjectFile(module, outputPath)) {
        print("could not emit the object file");
        return 4;
    }
    return 0;
}
