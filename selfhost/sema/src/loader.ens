// All file access in the sema layer goes through the FileLoader interface, so tests can supply an
// in-memory tree and the batch driver can supply the real file system.
import @std.system;
import SystemError from @std.system;

public class FileError extends Error {
    constructor(string message) {
        super(message);
    }
}

public interface FileLoader {
    exists(string path) -> bool;
    readText(string path) -> string throws FileError;
}

public class SystemFileLoader implements FileLoader {
    constructor();

    override exists(string path) -> bool {
        let file = try system.openFile(path, "rb");
        let closed = file.close();
        return true;
    } catch (SystemError error) {
        return false;
    }

    override readText(string path) -> string throws FileError {
        return try system.readAllText(path);
    } catch (SystemError error) {
        throw new FileError("Could not read '{path}': {error.message}");
    }
}
