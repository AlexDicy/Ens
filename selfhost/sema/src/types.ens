// The sema type model. Every type object is created and interned by the TypeStore, so equal types
// are the same object and type equality is reference identity everywhere. Declared types carry
// the metadata published at name registration; members and bases are filled by later phases.
import GreenNode from @ens.frontend.syntax.green;
import List from @std.collections.list;
import Map from @std.collections.map;

public enum PrimitiveKind {
    Bool,
    Byte,
    Short,
    UShort,
    Int,
    UInt,
    Long,
    ULong,
    Float,
    Double,
    Decimal,
    Char,
    Void,
}

public enum Visibility {
    Public,
    Private,
}

public sealed abstract class Type {
}

public class PrimitiveType extends Type {
    private PrimitiveKind primitiveKind;

    constructor(PrimitiveKind kind) {
        this.primitiveKind = kind;
    }

    kind() -> PrimitiveKind {
        return this.primitiveKind;
    }
}

public class StringType extends Type {
    constructor();
}

public class NullType extends Type {
    constructor();
}

// Cascade suppression sentinel: the type of anything that already produced a diagnostic.
public class ErrorType extends Type {
    constructor();
}

public class OptionalType extends Type {
    private Type innerType;

    constructor(Type inner) {
        this.innerType = inner;
    }

    inner() -> Type {
        return this.innerType;
    }
}

public class ArrayType extends Type {
    private Type elementType;

    constructor(Type element) {
        this.elementType = element;
    }

    element() -> Type {
        return this.elementType;
    }
}

// A type introduced by a declaration. The declaration green node is the stable identity of the
// declaration site; red views are rebuilt over it on demand.
public sealed abstract class DeclaredType extends Type {
    private string declaredName;
    private string declaredModulePath;
    private string declaredFilePath;
    private GreenNode declarationNode;
    private Visibility declaredVisibility;
    private string[] declaredTypeParameters;

    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility, string[] typeParameters) {
        this.declaredName = name;
        this.declaredModulePath = modulePath;
        this.declaredFilePath = filePath;
        this.declarationNode = declaration;
        this.declaredVisibility = visibility;
        this.declaredTypeParameters = typeParameters;
    }

    name() -> string {
        return this.declaredName;
    }

    modulePath() -> string {
        return this.declaredModulePath;
    }

    filePath() -> string {
        return this.declaredFilePath;
    }

    declaration() -> GreenNode {
        return this.declarationNode;
    }

    visibility() -> Visibility {
        return this.declaredVisibility;
    }

    typeParameters() -> string[] {
        return this.declaredTypeParameters;
    }

    isGeneric() -> bool {
        return this.declaredTypeParameters.length > 0;
    }

    // The declaration's kind as it reads in a diagnostic: "class", "enum", ...
    abstract kindWord() -> string;
}

public class ClassType extends DeclaredType {
    private bool classIsAbstract;
    private bool classIsFinal;
    private bool classIsSealed;

    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility, string[] typeParameters, bool isAbstract, bool isFinal,
                bool isSealed) {
        super(name, modulePath, filePath, declaration, visibility, typeParameters);
        this.classIsAbstract = isAbstract;
        this.classIsFinal = isFinal;
        this.classIsSealed = isSealed;
    }

    isAbstract() -> bool {
        return this.classIsAbstract;
    }

    isFinal() -> bool {
        return this.classIsFinal;
    }

    isSealed() -> bool {
        return this.classIsSealed;
    }

    override kindWord() -> string {
        return "class";
    }
}

public class InterfaceType extends DeclaredType {
    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility, string[] typeParameters) {
        super(name, modulePath, filePath, declaration, visibility, typeParameters);
    }

    override kindWord() -> string {
        return "interface";
    }
}

public class StructType extends DeclaredType {
    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility, string[] typeParameters) {
        super(name, modulePath, filePath, declaration, visibility, typeParameters);
    }

    override kindWord() -> string {
        return "struct";
    }
}

public class EnumType extends DeclaredType {
    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility) {
        super(name, modulePath, filePath, declaration, visibility, []);
    }

    override kindWord() -> string {
        return "enum";
    }
}

public class ExternalType extends DeclaredType {
    constructor(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility) {
        super(name, modulePath, filePath, declaration, visibility, []);
    }

    override kindWord() -> string {
        return "external type";
    }
}

private class DeclaredTypeKey {
    private string keyModulePath;
    private string keyName;

    constructor(string modulePath, string name) {
        this.keyModulePath = modulePath;
        this.keyName = name;
    }

    override hash() -> long {
        return this.keyModulePath.hash() * 31 + this.keyName.hash();
    }

    override equals(DeclaredTypeKey other) -> bool {
        return this.keyModulePath == other.keyModulePath && this.keyName == other.keyName;
    }
}

// The single owner of every type object. All construction goes through it: primitives are interned
// by kind, optionals and arrays by their inner type's identity, declared types by (module path,
// name). Keep every mutation behind this API.
public class TypeStore {
    private Map<PrimitiveKind, PrimitiveType> primitives;
    private StringType internedString;
    private NullType internedNull;
    private ErrorType internedError;
    private Map<Type, OptionalType> optionals;
    private Map<Type, ArrayType> arrays;
    private Map<DeclaredTypeKey, DeclaredType> declaredTypes;

    constructor() {
        this.primitives = new Map<PrimitiveKind, PrimitiveType>();
        this.internedString = new StringType();
        this.internedNull = new NullType();
        this.internedError = new ErrorType();
        this.optionals = new Map<Type, OptionalType>();
        this.arrays = new Map<Type, ArrayType>();
        this.declaredTypes = new Map<DeclaredTypeKey, DeclaredType>();
    }

    primitive(PrimitiveKind kind) -> PrimitiveType {
        let existing = this.primitives.get(kind);
        if (existing != null) {
            return existing;
        }
        let created = new PrimitiveType(kind);
        this.primitives.set(kind, created);
        return created;
    }

    stringType() -> StringType {
        return this.internedString;
    }

    nullType() -> NullType {
        return this.internedNull;
    }

    errorType() -> ErrorType {
        return this.internedError;
    }

    // T?? collapses to T?, and an error stays an error so one diagnosis does not cascade.
    optionalOf(Type inner) -> Type {
        if (inner is OptionalType) {
            return inner;
        }
        if (inner is ErrorType) {
            return inner;
        }
        let existing = this.optionals.get(inner);
        if (existing != null) {
            return existing;
        }
        let created = new OptionalType(inner);
        this.optionals.set(inner, created);
        return created;
    }

    arrayOf(Type element) -> Type {
        if (element is ErrorType) {
            return element;
        }
        let existing = this.arrays.get(element);
        if (existing != null) {
            return existing;
        }
        let created = new ArrayType(element);
        this.arrays.set(element, created);
        return created;
    }

    findDeclared(string modulePath, string name) -> DeclaredType? {
        return this.declaredTypes.get(new DeclaredTypeKey(modulePath, name));
    }

    hasDeclared(string modulePath, string name) -> bool {
        return this.declaredTypes.contains(new DeclaredTypeKey(modulePath, name));
    }

    addClass(string name, string modulePath, string filePath, GreenNode declaration,
             Visibility visibility, string[] typeParameters, bool isAbstract, bool isFinal,
             bool isSealed) -> ClassType {
        let created = new ClassType(name, modulePath, filePath, declaration, visibility,
            typeParameters, isAbstract, isFinal, isSealed);
        this.add(created);
        return created;
    }

    addInterface(string name, string modulePath, string filePath, GreenNode declaration,
                 Visibility visibility, string[] typeParameters) -> InterfaceType {
        let created = new InterfaceType(name, modulePath, filePath, declaration, visibility,
            typeParameters);
        this.add(created);
        return created;
    }

    addStruct(string name, string modulePath, string filePath, GreenNode declaration,
              Visibility visibility, string[] typeParameters) -> StructType {
        let created = new StructType(name, modulePath, filePath, declaration, visibility,
            typeParameters);
        this.add(created);
        return created;
    }

    addEnum(string name, string modulePath, string filePath, GreenNode declaration,
            Visibility visibility) -> EnumType {
        let created = new EnumType(name, modulePath, filePath, declaration, visibility);
        this.add(created);
        return created;
    }

    addExternal(string name, string modulePath, string filePath, GreenNode declaration,
                Visibility visibility) -> ExternalType {
        let created = new ExternalType(name, modulePath, filePath, declaration, visibility);
        this.add(created);
        return created;
    }

    private add(DeclaredType created) {
        let key = new DeclaredTypeKey(created.modulePath(), created.name());
        if (this.declaredTypes.contains(key)) {
            panic("Internal: type '{created.name()}' is already declared in module "
                + "'{created.modulePath()}'");
        }
        this.declaredTypes.set(key, created);
    }
}
