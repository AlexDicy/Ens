// The whole-program sema pipeline over a built module graph: declare each module, link, resolve
// signatures, lay out classes, run the declaration checks, check every body's statements and
// expressions, and validate the checked-exception rules over the converged throw sets.
// Generic instantiations fill from their templates as the templates complete: after the
// signature stage for structs and interfaces, and after layout for classes, so the checks
// always walk complete member sets.
// Each stage completes for every module before the next starts, and each stage's diagnostics
// stay separate so callers can report them per stage.
import @ens.frontend.syntax.generated.factory;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import GraphResult from program.graph;
import Module from program.graph;
import program.implicit;
import FileDeclarations from phases.declare;
import DeclareResult from phases.declare;
import phases.declare;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import LinkResult from phases.link;
import phases.link;
import ModuleContext from context;
import ClassItem from context;
import TypeResolver from phases.resolve;
import SemaResult from result;
import phases.signatures;
import phases.layout;
import phases.checks;
import phases.bodies;
import ObligationRegistry from phases.obligations;
import phases.obligations;
import phases.exceptions;
import TypeStore from model.types;
import ClassType from model.types;
import List from @std.collections.list;

export final class ProgramAnalysis {
    List<ModuleContext> analysisContexts;
    TypeStore analysisStore;
    ClassType? analysisErrorClass;
    FileDiagnostic[] declareStage;
    FileDiagnostic[] linkStage;
    FileDiagnostic[] signatureStage;
    FileDiagnostic[] layoutStage;
    FileDiagnostic[] checkStage;
    FileDiagnostic[] bodyStage;
    FileDiagnostic[] exceptionStage;

    protected constructor(List<ModuleContext> contexts, TypeStore store, ClassType? errorClass,
                FileDiagnostic[] declareDiagnostics, FileDiagnostic[] linkDiagnostics,
                FileDiagnostic[] signatureDiagnostics, FileDiagnostic[] layoutDiagnostics,
                FileDiagnostic[] checkDiagnostics, FileDiagnostic[] bodyDiagnostics,
                FileDiagnostic[] exceptionDiagnostics) {
        this.analysisContexts = contexts;
        this.analysisStore = store;
        this.analysisErrorClass = errorClass;
        this.declareStage = declareDiagnostics;
        this.linkStage = linkDiagnostics;
        this.signatureStage = signatureDiagnostics;
        this.layoutStage = layoutDiagnostics;
        this.checkStage = checkDiagnostics;
        this.bodyStage = bodyDiagnostics;
        this.exceptionStage = exceptionDiagnostics;
    }

    // One context per analyzed module, the implicitly imported ones first.
    export contexts() -> List<ModuleContext> {
        return this.analysisContexts;
    }

    export store() -> TypeStore {
        return this.analysisStore;
    }

    export errorClass() -> ClassType? {
        return this.analysisErrorClass;
    }

    export declareDiagnostics() -> FileDiagnostic[] {
        return this.declareStage;
    }

    export linkDiagnostics() -> FileDiagnostic[] {
        return this.linkStage;
    }

    export signatureDiagnostics() -> FileDiagnostic[] {
        return this.signatureStage;
    }

    export layoutDiagnostics() -> FileDiagnostic[] {
        return this.layoutStage;
    }

    export checkDiagnostics() -> FileDiagnostic[] {
        return this.checkStage;
    }

    export bodyDiagnostics() -> FileDiagnostic[] {
        return this.bodyStage;
    }

    export exceptionDiagnostics() -> FileDiagnostic[] {
        return this.exceptionStage;
    }
}

export analyzeProgram(GraphResult graphResult) -> ProgramAnalysis {
    let modules = new List<Module>();
    for (let loaded in graphResult.modules()) {
        modules.push(loaded);
    }

    let roots = new List<SourceFileNode?>();
    let declarations = new List<FileDeclarations>();
    let declareDiagnostics = new List<FileDiagnostic>();
    for (long i = 0; i < modules.length(); i++) {
        let module = modules.get(i);
        let root = factory.createRoot(module.parseResult().root());
        if (root is SourceFileNode) {
            roots.push(root);
            let declared = declare.declareFile(root, module.filePath());
            declarations.push(declared.declarations());
            for (let diagnostic in declared.diagnostics()) {
                declareDiagnostics.push(diagnostic);
            }
        } else {
            roots.push(null);
            declarations.push(new FileDeclarations(module.filePath(), [], [], [], [], [], []));
        }
    }

    let store = new TypeStore();
    let linked = link.linkProgram(modules.toArray(), declarations.toArray(), store);

    ClassType? errorClass = null;
    let declaredError = store.findDeclared(implicit.coreModulePath(), "Error");
    if (declaredError is ClassType) {
        errorClass = declaredError;
    }

    let contexts = new List<ModuleContext>();
    for (long i = 0; i < modules.length(); i++) {
        let module = modules.get(i);
        let table = linked.tableFor(module.canonicalPath());
        if (table == null) {
            panic("Internal: the link phase produced no table for "
                + "'{module.canonicalPath()}'");
        }
        let semaResult = new SemaResult();
        let resolver = new TypeResolver(store, module.canonicalPath(), module.packagePrefix(),
            module.filePath(), table, errorClass, semaResult);
        contexts.push(new ModuleContext(module, declarations.get(i), roots.get(i), table,
            resolver, semaResult));
    }

    let classItems = new List<ClassItem>();
    let signatureDiagnostics = new List<FileDiagnostic>();
    for (long i = 0; i < contexts.length(); i++) {
        signatures.resolveTypeParameterLists(contexts.get(i));
    }
    for (long i = 0; i < contexts.length(); i++) {
        for (let diagnostic in signatures.resolveModule(contexts.get(i), classItems)) {
            signatureDiagnostics.push(diagnostic);
        }
    }
    for (long i = 0; i < contexts.length(); i++) {
        let resolver = contexts.get(i).resolver();
        resolver.checkDeferredBounds();
        for (let diagnostic in resolver.takeDiagnostics()) {
            signatureDiagnostics.push(diagnostic);
        }
    }
    store.materializeFills();

    FileDiagnostic[] layoutDiagnostics = layout.layoutProgram(classItems);
    store.materializeFills();
    FileDiagnostic[] checkDiagnostics = checks.checkProgram(contexts);
    let deferred = new ObligationRegistry();
    FileDiagnostic[] bodyDiagnostics = bodies.checkBodies(contexts, deferred);
    FileDiagnostic[] obligationDiagnostics = obligations.check(store, deferred);
    if (obligationDiagnostics.length > 0) {
        let mergedBodies = new List<FileDiagnostic>();
        for (let diagnostic in bodyDiagnostics) {
            mergedBodies.push(diagnostic);
        }
        for (let diagnostic in obligationDiagnostics) {
            mergedBodies.push(diagnostic);
        }
        bodyDiagnostics = diagnostics.sorted(mergedBodies);
    }
    FileDiagnostic[] exceptionDiagnostics = exceptions.check(contexts);

    let overflow = store.takeInstantiationOverflows();
    if (overflow.length > 0) {
        let mergedLayout = new List<FileDiagnostic>();
        for (let diagnostic in layoutDiagnostics) {
            mergedLayout.push(diagnostic);
        }
        for (let diagnostic in overflow) {
            mergedLayout.push(diagnostic);
        }
        layoutDiagnostics = diagnostics.sorted(mergedLayout);
    }

    return new ProgramAnalysis(contexts, store, errorClass,
        diagnostics.sorted(declareDiagnostics), linked.diagnostics(),
        diagnostics.sorted(signatureDiagnostics), layoutDiagnostics, checkDiagnostics,
        bodyDiagnostics, exceptionDiagnostics);
}
