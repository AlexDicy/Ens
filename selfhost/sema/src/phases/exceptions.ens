// Checked exceptions. Every callable's outward throw set converges to a cross-module fixpoint. A
// callable's contract is its declared throws list when it names types and its computed outward
// set otherwise, so a call is judged by its static target and an override enlarges no obligation.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import CatchClauseNode from @ens.frontend.syntax.generated.nodes;
import ParameterListNode from @ens.frontend.syntax.generated.nodes;
import ParameterNode from @ens.frontend.syntax.generated.nodes;
import InitializerNode from @ens.frontend.syntax.generated.nodes;
import ThrowsClauseNode from @ens.frontend.syntax.generated.nodes;
import NamedTypeNode from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import SyntaxToken from @ens.frontend.syntax.node;
import Expression from @ens.frontend.syntax.generated.nodes;
import ThrowStatementNode from @ens.frontend.syntax.generated.nodes;
import RethrowStatementNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import ModuleContext from context;
import SemaResult from result;
import ThrowValidation from phases.exceptions.validation;
import phases.members;
import model.types;
import FunctionType from model.types;
import TypeParamType from model.types;
import MemberConstraint from model.types;
import Type from model.types;
import ErrorType from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import StructType from model.types;
import PrimitiveBinding from model.types;
import TypeStore from model.types;
import TypeNames from model.types;
import Method from model.types;
import Signature from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

public check(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let registry = new ThrowsRegistry();
    let slots = new ErrorSlotPlan();
    let workers = new List<ModuleExceptions>();
    for (long i = 0; i < contexts.length(); i++) {
        let worker = new ModuleExceptions(contexts.get(i), registry, collected);
        worker.collect();
        worker.contributeConformances(slots);
        workers.push(worker);
    }
    slots.resolve();
    bool changed = true;
    while (changed) {
        changed = false;
        for (long i = 0; i < workers.length(); i++) {
            if (workers.get(i).computeOnce()) {
                changed = true;
            }
        }
    }
    for (long i = 0; i < workers.length(); i++) {
        workers.get(i).judgeOutward();
    }
    for (long i = 0; i < workers.length(); i++) {
        new ThrowValidation(workers.get(i)).validate();
        workers.get(i).record(slots);
    }
    return diagnostics.sorted(collected);
}

// A set of exception class types. Members dedup by identity only, so a base and one of its
// subclasses can coexist; covers() is the subsumption-aware query. A set can also hold an
// unresolved type. Its full extent is then unknown. An unresolved type raised by a call to a
// function marked 'throws' is certain to be raised.
public class ThrowSet {
    List<Type> memberTypes;
    bool holdsUnresolved;
    bool holdsCertainUnresolved;

    public constructor() {
        this.memberTypes = new List<Type>();
        this.holdsUnresolved = false;
        this.holdsCertainUnresolved = false;
    }

    // A type parameter stays in the set until substitution replaces it with what the
    // instantiation named. The error type marks the set as holding an unresolved type.
    public add(Type candidate) -> bool {
        if (candidate is ErrorType) {
            return this.addUnresolved();
        }
        if (!types.isClassLike(candidate) && !(candidate is TypeParamType)) {
            return false;
        }
        for (long i = 0; i < this.memberTypes.length(); i++) {
            if (this.memberTypes.get(i) == candidate) {
                return false;
            }
        }
        this.memberTypes.push(candidate);
        return true;
    }

    // Adds a thrown or declared type. A class that is neither 'Error' nor a subclass of it is held
    // as an unresolved type, because its own refusal is the one report about it. A type parameter
    // is added as it is, and so is every type when no 'Error' class is known.
    public addThrown(Type candidate, ClassType? errorBase) -> bool {
        if (errorBase == null || candidate is TypeParamType) {
            return this.add(candidate);
        }
        if (types.isClassLike(candidate) && types.isSubclassOf(candidate, errorBase)) {
            return this.add(candidate);
        }
        return this.addUnresolved();
    }

    // Marks the set as holding an unresolved type. False when it already held one.
    protected addUnresolved() -> bool {
        if (this.holdsUnresolved) {
            return false;
        }
        this.holdsUnresolved = true;
        return true;
    }

    // Marks the set as holding an unresolved type that is certain to be raised. False when it
    // already held one.
    protected addCertainUnresolved() -> bool {
        bool grew = this.addUnresolved();
        if (this.holdsCertainUnresolved) {
            return grew;
        }
        this.holdsCertainUnresolved = true;
        return true;
    }

    // Adds the unresolved type the other set holds, with its certainty. False when nothing was new.
    protected addUnresolvedOf(ThrowSet other) -> bool {
        if (other.holdsCertainUnresolved) {
            return this.addCertainUnresolved();
        }
        return other.holdsUnresolved && this.addUnresolved();
    }

    // Adds every type the other set holds, an unresolved one included. False when nothing was new.
    public addAll(ThrowSet other) -> bool {
        bool grew = this.addUnresolvedOf(other);
        for (long i = 0; i < other.memberTypes.length(); i++) {
            if (this.add(other.memberTypes.get(i))) {
                grew = true;
            }
        }
        return grew;
    }

    // True when some member is the thrown type or a superclass of it, in every instantiation. A
    // set holding an unresolved type covers every type.
    public covers(Type thrown) -> bool {
        if (this.holdsUnresolved) {
            return true;
        }
        for (long i = 0; i < this.memberTypes.length(); i++) {
            if (types.isAlwaysSubclassOf(thrown, this.memberTypes.get(i))) {
                return true;
            }
        }
        return false;
    }

    // True when the set has no member type. It can still hold an unresolved type.
    public isEmpty() -> bool {
        return this.memberTypes.length() == 0;
    }

    // True when some raised type did not resolve.
    public hasUnresolved() -> bool {
        return this.holdsUnresolved;
    }

    // True when the set holds no member type and no unresolved type.
    public raisesNothing() -> bool {
        return this.isEmpty() && !this.holdsUnresolved;
    }

    // True when the set holds a member type or an unresolved type that is certain to be raised.
    public raisesForCertain() -> bool {
        return !this.isEmpty() || this.holdsCertainUnresolved;
    }

    public members() -> List<Type> {
        return this.memberTypes;
    }
}

// The outward throw sets, keyed by declaration node. Template methods and their generic
// instantiations share one declaration, so one set speaks for all of them.
public class ThrowsRegistry {
    Map<GreenNode, ThrowSet> outwardSets;
    Map<GreenNode, ThrowSet> judgedSets;

    protected constructor() {
        this.outwardSets = new Map<GreenNode, ThrowSet>();
        this.judgedSets = new Map<GreenNode, ThrowSet>();
    }

    protected outwardFor(GreenNode declaration) -> ThrowSet {
        let existing = this.outwardSets.get(declaration);
        if (existing != null) {
            return existing;
        }
        let created = new ThrowSet();
        this.outwardSets.set(declaration, created);
        return created;
    }

    // What the callable is judged on against its own contract and the contracts it answers to: its
    // outward set, less the calls reported for a missing 'try' unless it is marked 'throws'.
    public judgedFor(GreenNode declaration) -> ThrowSet? {
        return this.judgedSets.get(declaration);
    }

    protected setJudged(GreenNode declaration, ThrowSet judged) {
        this.judgedSets.set(declaration, judged);
    }
}

// The declared types as a set. An entry that is not a type an exception can have is held as an
// unresolved type, because the entry's own refusal is the one report about it.
public throwSetOf(Type[] declared, ClassType? errorBase) -> ThrowSet {
    let members = new ThrowSet();
    for (let thrown in declared) {
        members.addThrown(thrown, errorBase);
    }
    return members;
}

// What a call to the signature may raise at the caller: the declared throws list when it names
// types, the computed outward set otherwise.
public contractOf(Signature signature, ThrowsRegistry registry, ClassType? errorBase) -> ThrowSet {
    if (signature.declaresThrows() && signature.throwsTypes().length > 0) {
        return throwSetOf(signature.throwsTypes(), errorBase);
    }
    let declaration = signature.declaration();
    if (declaration == null) {
        return new ThrowSet();
    }
    return registry.outwardFor(declaration);
}

// Which callables carry the trailing error-slot parameter in their machine interface. One dispatch
// table entry has one interface, so the fact belongs to an override family and is decided over the
// whole program. A class that satisfies a throwing interface method with a method it only inherits
// puts the slot on the base's declaration too, which is invisible from that base's own file.
class ErrorSlotPlan {
    List<ClassType> conformingClasses;
    Map<GreenNode, bool> carryingFamilies;

    protected constructor() {
        this.conformingClasses = new List<ClassType>();
        this.carryingFamilies = new Map<GreenNode, bool>();
    }

    // Every class the program declares, whose interface conformances the resolution reads.
    protected add(ClassType classType) {
        this.conformingClasses.push(classType);
    }

    // Marks the family of every method that implements a throwing interface method, wherever that
    // method is declared. Runs once, after all modules have contributed.
    protected resolve() {
        for (long i = 0; i < this.conformingClasses.length(); i++) {
            let classType = this.conformingClasses.get(i);
            Type? level = classType;
            while (level != null) {
                for (let implemented in types.interfacesOf(level)) {
                    for (let ladderLevel in types.interfaceLadderOf(implemented)) {
                        this.markConformance(classType, ladderLevel);
                    }
                }
                level = types.baseOf(level);
            }
        }
    }

    markConformance(ClassType classType, Type implemented) {
        let required = types.methodsOf(implemented);
        if (required == null) {
            return;
        }
        for (long i = 0; i < required.length(); i++) {
            let candidate = required.get(i);
            if (!candidate.signature().declaresThrows()) {
                continue;
            }
            let provided = findDeclaring(classType, candidate);
            if (provided == null) {
                continue;
            }
            let owner = types.authorityOf(provided.definingType());
            if (owner == null) {
                continue;
            }
            let root = rootDeclarationOf(owner, provided).signature().declaration();
            if (root != null) {
                this.carryingFamilies.set(root, true);
            }
        }
    }

    // True when the callable's machine interface carries the trailing error-slot parameter. A
    // method follows its family: the root declaration's own 'throws' marker, or the program-wide
    // conformance the resolution recorded. Everything else follows its own marker.
    protected carries(Signature signature, Method? method, DeclaredType? owner) -> bool {
        if (method == null || owner == null || !(owner is ClassType)) {
            return signature.declaresThrows();
        }
        if (method.isConstructor() || method.isDestructor()) {
            return signature.declaresThrows();
        }
        let root = rootDeclarationOf(owner, method);
        if (root.signature().declaresThrows()) {
            return true;
        }
        let declaration = root.signature().declaration();
        if (declaration == null) {
            return signature.declaresThrows();
        }
        return this.carryingFamilies.get(declaration) ?? false;
    }
}

public final class FunctionItem {
    public FunctionDeclarationNode declaration;
    public Signature signature;
    public Method? method;
    public DeclaredType? owner;

    protected constructor(this.declaration, this.signature, this.method, this.owner);
}

// A struct, class or primitive binding the module declares.
public final class TypeItem {
    public DeclaredType declared;
    public MemberListNode body;
    public Span nameSpan;

    protected constructor(this.declared, this.body, this.nameSpan);
}

// One module's callables and their throw sets, which 'check' recomputes until no module's sets grow.
public final class ModuleExceptions {
    ModuleContext context;
    ThrowsRegistry throwsRegistry;
    SemaResult moduleResult;
    Reporter fileReporter;
    TypeNames typeNames;
    TypeStore store;
    string modulePath;
    ClassType? errorBaseClass;

    // The constraint scope of the conditional member being processed, set per item. Inside it
    // the restated parameter carries the member's extra bounds.
    GreenNode? scopeOwner;
    MemberConstraint[] scopeConstraints;

    List<FunctionItem> functionItems;
    List<TestDeclarationNode> testItems;
    List<TypeItem> typeItems;
    // Every lambda the module writes, wherever it appears. A lambda's body is a callable of its
    // own, so it converges under its own key instead of feeding the function around it.
    List<LambdaExpressionNode> lambdaItems;

    protected constructor(ModuleContext context, ThrowsRegistry registry, List<FileDiagnostic> collected) {
        this.context = context;
        this.throwsRegistry = registry;
        this.moduleResult = context.result();
        this.fileReporter = new Reporter(context.module().filePath(), collected);
        this.typeNames = context.names();
        this.store = context.resolver().typeStore();
        this.modulePath = context.module().canonicalPath();
        this.errorBaseClass = context.resolver().errorClass();
        this.scopeOwner = null;
        this.scopeConstraints = [];
        this.functionItems = new List<FunctionItem>();
        this.testItems = new List<TestDeclarationNode>();
        this.typeItems = new List<TypeItem>();
        this.lambdaItems = new List<LambdaExpressionNode>();
    }

    // The outward and judged throw sets of every module.
    public registry() -> ThrowsRegistry {
        return this.throwsRegistry;
    }

    public result() -> SemaResult {
        return this.moduleResult;
    }

    public reporter() -> Reporter {
        return this.fileReporter;
    }

    // The names this module's file has for the program's types.
    public names() -> TypeNames {
        return this.typeNames;
    }

    // The program's 'Error' class, or null when no 'Error' class is known.
    public errorClass() -> ClassType? {
        return this.errorBaseClass;
    }

    // The functions and methods this module declares.
    public collectedFunctions() -> List<FunctionItem> {
        return this.functionItems;
    }

    public collectedTests() -> List<TestDeclarationNode> {
        return this.testItems;
    }

    // The structs, classes and primitive bindings this module declares.
    public collectedTypes() -> List<TypeItem> {
        return this.typeItems;
    }

    public collectedLambdas() -> List<LambdaExpressionNode> {
        return this.lambdaItems;
    }

    // isAlwaysSubclassOf under the active item's constraint scope.
    public alwaysSubclass(Type derived, Type ancestor) -> bool {
        return types.isAlwaysSubclassOfUnder(derived, ancestor, this.scopeOwner,
            this.scopeConstraints);
    }

    caughtBefore(Type thrown, List<Type?> clauseTypes, long limit) -> bool {
        for (long i = 0; i < limit; i++) {
            let clauseType = clauseTypes.get(i);
            if (clauseType != null && this.alwaysSubclass(thrown, clauseType)) {
                return true;
            }
        }
        return false;
    }

    // Whether some instantiation could relate the two, judging a type parameter by its class bound.
    public mightOverlap(Type left, Type right) -> bool {
        Type leftClass = types.boundClassOfUnder(left, this.scopeOwner, this.scopeConstraints);
        Type rightClass = types.boundClassOfUnder(right, this.scopeOwner,
            this.scopeConstraints);
        return types.isSubclassOf(leftClass, rightClass) || types.isSubclassOf(rightClass, leftClass);
    }

    // Activates the constraint scope of the item, which only a conditional member has.
    public enterItemScope(FunctionItem item) {
        this.scopeOwner = null;
        this.scopeConstraints = [];
        let method = item.method;
        if (method != null && method.isConditional()) {
            let authority = types.authorityOf(method.definingType());
            if (authority != null) {
                this.scopeOwner = authority.declaration();
                this.scopeConstraints = method.constraints();
            }
        }
    }

    public leaveItemScope() {
        this.scopeOwner = null;
        this.scopeConstraints = [];
    }

    protected collect() {
        let root = this.context.root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    this.collectTopLevelFunction(declaration);
                },
                is StructDeclarationNode declaration -> {
                    let found = this.store.findDeclared(this.modulePath,
                        declaration.name().text());
                    if (found is StructType && found.declaration() == declaration.green()) {
                        this.collectMembers(found, found.methods(), found.staticMethods(),
                            declaration.body(), declaration.name().span());
                    }
                },
                is ClassDeclarationNode declaration -> {
                    let found = this.store.findDeclared(this.modulePath,
                        declaration.name().text());
                    if (found is ClassType && found.declaration() == declaration.green()) {
                        this.collectMembers(found, found.methods(), found.staticMethods(),
                            declaration.body(), declaration.name().span());
                    }
                },
                is PrimitiveDeclarationNode declaration -> {
                    let binding = this.bindingFor(declaration);
                    if (binding != null) {
                        this.collectMembers(binding, binding.methods(),
                            binding.staticMethods(), declaration.body(),
                            declaration.name().span());
                    }
                },
                is TestDeclarationNode declaration -> {
                    this.testItems.push(declaration);
                },
                default -> { },
            }
        }
        this.collectLambdas(root);
    }

    bindingFor(PrimitiveDeclarationNode node) -> PrimitiveBinding? {
        let primitive = types.primitiveNamed(this.store, node.name().text());
        if (primitive == null) {
            return null;
        }
        let binding = types.bindingOf(primitive);
        if (binding != null && binding.declaration() == node.green()) {
            return binding;
        }
        return null;
    }

    collectLambdas(SyntaxNode node) {
        if (node is LambdaExpressionNode) {
            this.lambdaItems.push(node);
        }
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.collectLambdas(children.get(i));
        }
    }

    // Hands this module's classes to the program-wide error-slot plan, which reads their
    // conformances after every module has collected.
    protected contributeConformances(ErrorSlotPlan slots) {
        for (long i = 0; i < this.typeItems.length(); i++) {
            let declared = this.typeItems.get(i).declared;
            if (declared is ClassType) {
                slots.add(declared);
            }
        }
    }

    collectTopLevelFunction(FunctionDeclarationNode node) {
        let entries = this.context.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isExternal() || entry.isBuiltin()) {
                continue;
            }
            if (entry.signature().declaration() == node.green()) {
                this.functionItems.push(new FunctionItem(node, entry.signature(), null, null));
                return;
            }
        }
    }

    collectMembers(DeclaredType owner, List<Method> methods, List<Method> staticMethods,
                           MemberListNode body, Span nameSpan) {
        this.typeItems.push(new TypeItem(owner, body, nameSpan));
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                let method = members.methodDeclaredBy(methods, member.green());
                if (method == null) {
                    method = members.methodDeclaredBy(staticMethods, member.green());
                }
                if (method != null) {
                    this.functionItems.push(new FunctionItem(member, method.signature(),
                        method, owner));
                }
            }
        }
    }

    // ---- Outward sets ----

    protected computeOnce() -> bool {
        bool changed = false;
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.enterItemScope(item);
            let outward = this.computeOutward(item.declaration, ThrowCount.Contract);
            this.leaveItemScope();
            if (this.throwsRegistry.outwardFor(item.declaration.green()).addAll(outward)) {
                changed = true;
            }
        }
        for (long i = 0; i < this.testItems.length(); i++) {
            let test = this.testItems.get(i);
            let outward = new ThrowSet();
            this.collectThrows(test.body(), outward, ThrowCount.Contract);
            if (this.throwsRegistry.outwardFor(test.green()).addAll(outward)) {
                changed = true;
            }
        }
        for (long i = 0; i < this.lambdaItems.length(); i++) {
            let lambda = this.lambdaItems.get(i);
            let outward = new ThrowSet();
            this.collectLambdaThrows(lambda, outward, ThrowCount.Contract);
            if (this.throwsRegistry.outwardFor(lambda.green()).addAll(outward)) {
                changed = true;
            }
        }
        return changed;
    }

    // Records what each function is judged on, as its throws marker decides.
    protected judgeOutward() {
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.enterItemScope(item);
            ThrowCount count = ThrowCount.UnmarkedJudgment;
            if (item.signature.declaresThrows()) {
                count = ThrowCount.MarkedJudgment;
            }
            let judged = this.computeOutward(item.declaration, count);
            this.leaveItemScope();
            this.throwsRegistry.setJudged(item.declaration.green(), judged);
        }
    }

    // A lambda has no catch clauses, so what its body raises is its whole outward set. Walking
    // the lambda's own children rather than its body slot keeps one code path for the two shapes
    // a body can take.
    public collectLambdaThrows(LambdaExpressionNode lambda, ThrowSet into, ThrowCount count) {
        this.collectChildThrows(lambda, into, count);
    }

    // What the function lets escape, counted as 'count' says.
    computeOutward(FunctionDeclarationNode declaration, ThrowCount count) -> ThrowSet {
        let bodySet = this.bodyThrows(declaration, count);
        let clauseTypes = this.caughtClauseTypes(declaration);
        let outward = new ThrowSet();
        for (long m = 0; m < bodySet.members().length(); m++) {
            let thrown = bodySet.members().get(m);
            if (!this.caughtBefore(thrown, clauseTypes, clauseTypes.length())) {
                outward.add(thrown);
            }
        }
        // Any catch clause could catch an unresolved type, so only a body without one keeps it certain.
        if (clauseTypes.length() == 0) {
            outward.addUnresolvedOf(bodySet);
        } else if (bodySet.hasUnresolved() && !this.catchesEveryError(clauseTypes)) {
            outward.addUnresolved();
        }
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            let clause = declaration.catchClauses(i);
            let clauseType = clauseTypes.get(i);
            if (clauseType != null && hasRethrow(clause.body())) {
                this.addRethrown(bodySet, clauseTypes, i, clauseType, outward);
            }
            this.collectThrows(clause.body(), outward, count);
        }
        return outward;
    }

    // True when a clause catches 'Error' itself. Such a clause also catches an unresolved type.
    catchesEveryError(List<Type?> clauseTypes) -> bool {
        let errorBase = this.errorBaseClass;
        return errorBase != null && this.caughtBefore(errorBase, clauseTypes, clauseTypes.length());
    }

    // What a 'rethrow' in clause i re-raises: every body type the clause fully catches, and the
    // clause's own type when the body only throws a broader base, since instances of the base
    // that are not the clause's type pass the clause by. A rethrow over an unresolved body type
    // re-raises the clause's own type.
    addRethrown(ThrowSet bodySet, List<Type?> clauseTypes, long index, Type clauseType, ThrowSet outward) {
        bool partial = bodySet.hasUnresolved();
        for (long m = 0; m < bodySet.members().length(); m++) {
            let thrown = bodySet.members().get(m);
            if (this.caughtBefore(thrown, clauseTypes, index)) {
                continue;
            }
            if (types.isAlwaysSubclassOf(thrown, clauseType)) {
                outward.add(thrown);
            } else if (this.mightOverlap(clauseType, thrown)) {
                partial = true;
            }
        }
        if (partial) {
            outward.add(clauseType);
        }
    }

    // What the function's body raises before its catch clauses, counted as 'count' says.
    public bodyThrows(FunctionDeclarationNode declaration, ThrowCount count) -> ThrowSet {
        let bodySet = new ThrowSet();
        let body = declaration.body();
        if (body != null) {
            this.collectThrows(body, bodySet, count);
        }
        return bodySet;
    }

    // Each catch clause's caught type in order, null for a clause with no valid exception type.
    public caughtClauseTypes(FunctionDeclarationNode declaration) -> List<Type?> {
        let clauseTypes = new List<Type?>();
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            clauseTypes.push(this.caughtTypeOf(declaration.catchClauses(i)));
        }
        return clauseTypes;
    }

    // The clause's caught type, or null when it is not a valid exception type. An invalid clause
    // is diagnosed separately and handles nothing.
    caughtTypeOf(CatchClauseNode clause) -> Type? {
        let binding = this.moduleResult.bindingOf(clause.green());
        if (binding == null) {
            return null;
        }
        Type caught = binding.type();
        let errorBase = this.errorBaseClass;
        if (errorBase == null || !this.alwaysSubclass(caught, errorBase)) {
            return null;
        }
        if (!types.isClassLike(caught) && !(caught is TypeParamType)) {
            return null;
        }
        return caught;
    }

    // Adds what the node raises, counted as 'count' says.
    collectThrows(SyntaxNode node, ThrowSet into, ThrowCount count) {
        switch (node) {
            is ThrowStatementNode thrown -> {
                let operand = this.moduleResult.typeOf(thrown.value().green());
                if (operand != null) {
                    this.addRaised(into, operand);
                }
            },
            is TryExpressionNode tried -> {
                let operand = tried.operand();
                if (operand is CallExpressionNode) {
                    this.addCallThrows(operand, true, into, count);
                    this.collectChildThrows(operand, into, count);
                    return;
                }
            },
            is CallExpressionNode call -> {
                this.addCallThrows(call, false, into, count);
            },
            // A lambda is a callable of its own: what its body raises belongs to the lambda's
            // set, never to the function the lambda is written inside.
            is LambdaExpressionNode ignored -> {
                return;
            },
            default -> { },
        }
        this.collectChildThrows(node, into, count);
    }

    collectChildThrows(SyntaxNode node, ThrowSet into, ThrowCount count) {
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.collectThrows(children.get(i), into, count);
        }
    }

    // Adds what a call raises. A judgment counts a call that needs no 'try' as an unresolved type,
    // because its unmarked callee answers for what it throws. A call that needs a 'try' it does not
    // have is left out of an unmarked judgment, since the report of its missing 'try' names both fixes.
    addCallThrows(CallExpressionNode call, bool tried, ThrowSet into, ThrowCount count) {
        let contract = this.callContract(call);
        if (count == ThrowCount.Contract) {
            into.addAll(contract);
        } else if (this.requiresTry(call, contract)) {
            if (tried || count == ThrowCount.MarkedJudgment) {
                into.addAll(contract);
            }
        } else if (!contract.raisesNothing()) {
            into.addUnresolved();
        }
    }

    // The static target of a call, or null for calls that can never propagate: constructor
    // chains and unresolved callees.
    calleeSignatureOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.moduleResult.callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.moduleResult.methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.moduleResult.callableOf(member.green());
            },
            is SafeMemberExpressionNode member -> {
                let method = this.moduleResult.methodOf(member.green());
                if (method != null && !method.isConstructor()) {
                    return method.signature();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // True when the call needs 'try': its static target is marked 'throws', or it calls through a
    // function value whose type lists an exception. An unmarked function never throws once it is
    // valid, so what its body raises is reported on it alone.
    public requiresTry(CallExpressionNode call, ThrowSet contract) -> bool {
        let target = this.calleeSignatureOf(call);
        if (target != null) {
            return target.declaresThrows();
        }
        return !contract.isEmpty();
    }

    // Adds a raised type. A class outside 'Error' and a type parameter with no bound under 'Error'
    // are held as an unresolved type, because the refusal of each is the one report about it.
    addRaised(ThrowSet into, Type candidate) -> bool {
        let errorBase = this.errorBaseClass;
        if (candidate is TypeParamType && errorBase != null && !this.alwaysSubclass(candidate, errorBase)) {
            return into.addUnresolved();
        }
        return into.addThrown(candidate, errorBase);
    }

    // What a call to the signature may raise at the caller. An unresolved type raised by a
    // function marked 'throws' is certain to be raised. A function marked 'throws' that raises
    // nothing counts as raising an unresolved type, because its marker is what its callers follow.
    public contractFor(Signature signature) -> ThrowSet {
        let contract = contractOf(signature, this.throwsRegistry, this.errorBaseClass);
        if (signature.declaresThrows() && contract.raisesNothing()) {
            let marked = new ThrowSet();
            marked.addUnresolved();
            return marked;
        }
        if (!signature.declaresThrows() || !contract.hasUnresolved()) {
            return contract;
        }
        let certain = new ThrowSet();
        certain.addAll(contract);
        certain.addCertainUnresolved();
        return certain;
    }

    // What this call may raise at its caller. A generic callee's contract is read with the
    // call's type arguments substituted, so 'throws E' becomes what the caller wrote.
    public callContract(CallExpressionNode call) -> ThrowSet {
        let target = this.calleeSignatureOf(call);
        if (target == null) {
            return throwSetOf(this.calleeFunctionThrownTypes(call), this.errorBaseClass);
        }
        let contract = this.contractFor(target);
        let arguments = this.moduleResult.callTypeArgumentsOf(call.green());
        let owner = target.declaration();
        if (arguments == null || owner == null) {
            return contract;
        }
        let substituted = new ThrowSet();
        substituted.addUnresolvedOf(contract);
        for (long i = 0; i < contract.members().length(); i++) {
            this.addRaised(substituted, this.store.substitute(contract.members().get(i), owner, arguments));
        }
        return substituted;
    }

    // The types a call with no static target raises. A call through a function value raises
    // what the value's type lists. A call that did not resolve raises an unresolved type.
    calleeFunctionThrownTypes(CallExpressionNode call) -> Type[] {
        let calleeType = this.moduleResult.typeOf(call.callee().green());
        if (calleeType != null && calleeType is FunctionType) {
            return calleeType.thrownTypes();
        }
        if (calleeType is ErrorType || this.moduleResult.typeOf(call.green()) is ErrorType) {
            return [this.store.errorType()];
        }
        return [];
    }

    // ---- Recording ----

    protected record(ErrorSlotPlan slots) {
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.moduleResult.setThrowsSet(item.declaration.green(),
                this.throwsRegistry.outwardFor(item.declaration.green()).members().toArray());
            this.moduleResult.setAbiThrows(item.declaration.green(),
                slots.carries(item.signature, item.method, item.owner));
        }
        for (long i = 0; i < this.testItems.length(); i++) {
            let test = this.testItems.get(i);
            this.moduleResult.setThrowsSet(test.green(),
                this.throwsRegistry.outwardFor(test.green()).members().toArray());
            this.moduleResult.setAbiThrows(test.green(), true);
        }
    }
}

// The topmost base-chain declaration the method overrides, or the method itself: the declaration
// a dispatch-table slot is assigned at, which is why the whole family shares its ABI.
rootDeclarationOf(DeclaredType owner, Method method) -> Method {
    Method root = method;
    Type? current = types.baseOf(owner);
    while (current != null) {
        let found = findOwnMethod(current, method.name(), method.signature());
        if (found != null) {
            root = found;
        }
        current = types.baseOf(current);
    }
    return root;
}


hasRethrow(SyntaxNode node) -> bool {
    if (node is RethrowStatementNode) {
        return true;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (hasRethrow(children.get(i))) {
            return true;
        }
    }
    return false;
}

// Which throws a collection counts. A contract is what callers see, every call included. A judgment
// is what the declaration itself answers for, and a function marked 'throws' answers for every call
// it makes.
public enum ThrowCount {
    Contract,
    MarkedJudgment,
    UnmarkedJudgment,
}

// The nearest base-chain method with the same name and parameter types.
public findBaseMethod(DeclaredType owner, Method method) -> Method? {
    if (method.isConstructor() || method.isDestructor()) {
        return null;
    }
    Type? current = types.baseOf(owner);
    while (current != null) {
        let found = findOwnMethod(current, method.name(), method.signature());
        if (found != null) {
            return found;
        }
        current = types.baseOf(current);
    }
    return null;
}

// The most derived declaration with the name and parameter types: the owner's own methods
// first, then its base chain, which a primitive binding does not have.
public findDeclaring(DeclaredType owner, Method required) -> Method? {
    let own = findOwnMethod(owner, required.name(), required.signature());
    if (own != null) {
        return own;
    }
    return findBaseMethod(owner, required);
}

findOwnMethod(Type owner, string methodName, Signature signature) -> Method? {
    let methods = types.methodsOf(owner);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let candidate = methods.get(i);
        if (candidate.name() == methodName && !candidate.isConstructor()
                && types.sameParameterTypes(candidate.signature(), signature)) {
            return candidate;
        }
    }
    return null;
}
