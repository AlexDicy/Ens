// Checked exceptions. Every callable's outward throw set converges to a cross-module fixpoint. A
// callable's contract is its declared throws list when it names types and its computed outward
// set otherwise, so a call is judged by its static target and an override enlarges no obligation.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import CatchClauseNode from @ens.frontend.syntax.generated.nodes;
import ParameterListNode from @ens.frontend.syntax.generated.nodes;
import ParameterNode from @ens.frontend.syntax.generated.nodes;
import InitializerNode from @ens.frontend.syntax.generated.nodes;
import ThrowsClauseNode from @ens.frontend.syntax.generated.nodes;
import NamedTypeNode from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import SyntaxToken from @ens.frontend.syntax.node;
import Expression from @ens.frontend.syntax.generated.nodes;
import ThrowStatementNode from @ens.frontend.syntax.generated.nodes;
import RethrowStatementNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import ModuleContext from context;
import SemaResult from result;
import phases.members;
import model.types;
import FunctionType from model.types;
import TypeParamType from model.types;
import MemberConstraint from model.types;
import Type from model.types;
import ErrorType from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import StructType from model.types;
import PrimitiveBinding from model.types;
import TypeStore from model.types;
import TypeNames from model.types;
import Method from model.types;
import Signature from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

public check(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let registry = new ThrowsRegistry();
    let slots = new ErrorSlotPlan();
    let workers = new List<ModuleExceptions>();
    for (long i = 0; i < contexts.length(); i++) {
        let worker = new ModuleExceptions(contexts.get(i), registry, collected);
        worker.collect();
        worker.contributeConformances(slots);
        workers.push(worker);
    }
    slots.resolve();
    bool changed = true;
    while (changed) {
        changed = false;
        for (long i = 0; i < workers.length(); i++) {
            if (workers.get(i).computeOnce()) {
                changed = true;
            }
        }
    }
    for (long i = 0; i < workers.length(); i++) {
        workers.get(i).judgeOutward();
    }
    for (long i = 0; i < workers.length(); i++) {
        workers.get(i).validate();
        workers.get(i).record(slots);
    }
    return diagnostics.sorted(collected);
}

// A set of exception class types. Members dedup by identity only, so a base and one of its
// subclasses can coexist; covers() is the subsumption-aware query. A set can also hold an
// unresolved type. Its full extent is then unknown. An unresolved type raised by a call to a
// function marked 'throws' is certain to be raised.
public class ThrowSet {
    List<Type> memberTypes;
    bool holdsUnresolved;
    bool holdsCertainUnresolved;

    public constructor() {
        this.memberTypes = new List<Type>();
        this.holdsUnresolved = false;
        this.holdsCertainUnresolved = false;
    }

    // A type parameter stays in the set until substitution replaces it with what the
    // instantiation named. The error type marks the set as holding an unresolved type.
    public add(Type candidate) -> bool {
        if (candidate is ErrorType) {
            return this.addUnresolved();
        }
        if (!types.isClassLike(candidate) && !(candidate is TypeParamType)) {
            return false;
        }
        for (long i = 0; i < this.memberTypes.length(); i++) {
            if (this.memberTypes.get(i) == candidate) {
                return false;
            }
        }
        this.memberTypes.push(candidate);
        return true;
    }

    // Adds a thrown or declared type. A class that is neither 'Error' nor a subclass of it is held
    // as an unresolved type, because its own refusal is the one report about it. A type parameter
    // is added as it is, and so is every type when no 'Error' class is known.
    public addThrown(Type candidate, ClassType? errorBase) -> bool {
        if (errorBase == null || candidate is TypeParamType) {
            return this.add(candidate);
        }
        if (types.isClassLike(candidate) && types.isSubclassOf(candidate, errorBase)) {
            return this.add(candidate);
        }
        return this.addUnresolved();
    }

    // Marks the set as holding an unresolved type. False when it already held one.
    protected addUnresolved() -> bool {
        if (this.holdsUnresolved) {
            return false;
        }
        this.holdsUnresolved = true;
        return true;
    }

    // Marks the set as holding an unresolved type that is certain to be raised. False when it
    // already held one.
    protected addCertainUnresolved() -> bool {
        bool grew = this.addUnresolved();
        if (this.holdsCertainUnresolved) {
            return grew;
        }
        this.holdsCertainUnresolved = true;
        return true;
    }

    // Adds the unresolved type the other set holds, with its certainty. False when nothing was new.
    protected addUnresolvedOf(ThrowSet other) -> bool {
        if (other.holdsCertainUnresolved) {
            return this.addCertainUnresolved();
        }
        return other.holdsUnresolved && this.addUnresolved();
    }

    // Adds every type the other set holds, an unresolved one included. False when nothing was new.
    public addAll(ThrowSet other) -> bool {
        bool grew = this.addUnresolvedOf(other);
        for (long i = 0; i < other.memberTypes.length(); i++) {
            if (this.add(other.memberTypes.get(i))) {
                grew = true;
            }
        }
        return grew;
    }

    // True when some member is the thrown type or a superclass of it, in every instantiation. A
    // set holding an unresolved type covers every type.
    public covers(Type thrown) -> bool {
        if (this.holdsUnresolved) {
            return true;
        }
        for (long i = 0; i < this.memberTypes.length(); i++) {
            if (types.isAlwaysSubclassOf(thrown, this.memberTypes.get(i))) {
                return true;
            }
        }
        return false;
    }

    // True when the set has no member type. It can still hold an unresolved type.
    public isEmpty() -> bool {
        return this.memberTypes.length() == 0;
    }

    // True when some raised type did not resolve.
    public hasUnresolved() -> bool {
        return this.holdsUnresolved;
    }

    // True when the set holds no member type and no unresolved type.
    public raisesNothing() -> bool {
        return this.isEmpty() && !this.holdsUnresolved;
    }

    // True when the set holds a member type or an unresolved type that is certain to be raised.
    public raisesForCertain() -> bool {
        return !this.isEmpty() || this.holdsCertainUnresolved;
    }

    public members() -> List<Type> {
        return this.memberTypes;
    }
}

// The outward throw sets, keyed by declaration node. Template methods and their generic
// instantiations share one declaration, so one set speaks for all of them.
public class ThrowsRegistry {
    Map<GreenNode, ThrowSet> outwardSets;
    Map<GreenNode, ThrowSet> judgedSets;

    protected constructor() {
        this.outwardSets = new Map<GreenNode, ThrowSet>();
        this.judgedSets = new Map<GreenNode, ThrowSet>();
    }

    protected outwardFor(GreenNode declaration) -> ThrowSet {
        let existing = this.outwardSets.get(declaration);
        if (existing != null) {
            return existing;
        }
        let created = new ThrowSet();
        this.outwardSets.set(declaration, created);
        return created;
    }

    // What the callable is judged on against its own contract and the contracts it answers to: its
    // outward set, less the calls reported for a missing 'try' unless it is marked 'throws'.
    protected judgedFor(GreenNode declaration) -> ThrowSet? {
        return this.judgedSets.get(declaration);
    }

    protected setJudged(GreenNode declaration, ThrowSet judged) {
        this.judgedSets.set(declaration, judged);
    }
}

// The declared types as a set. An entry that is not a type an exception can have is held as an
// unresolved type, because the entry's own refusal is the one report about it.
public throwSetOf(Type[] declared, ClassType? errorBase) -> ThrowSet {
    let members = new ThrowSet();
    for (let thrown in declared) {
        members.addThrown(thrown, errorBase);
    }
    return members;
}

// What a call to the signature may raise at the caller: the declared throws list when it names
// types, the computed outward set otherwise.
public contractOf(Signature signature, ThrowsRegistry registry, ClassType? errorBase) -> ThrowSet {
    if (signature.declaresThrows() && signature.throwsTypes().length > 0) {
        return throwSetOf(signature.throwsTypes(), errorBase);
    }
    let declaration = signature.declaration();
    if (declaration == null) {
        return new ThrowSet();
    }
    return registry.outwardFor(declaration);
}

// Which callables carry the trailing error-slot parameter in their machine interface. One dispatch
// table entry has one interface, so the fact belongs to an override family and is decided over the
// whole program. A class that satisfies a throwing interface method with a method it only inherits
// puts the slot on the base's declaration too, which is invisible from that base's own file.
class ErrorSlotPlan {
    List<ClassType> conformingClasses;
    Map<GreenNode, bool> carryingFamilies;

    protected constructor() {
        this.conformingClasses = new List<ClassType>();
        this.carryingFamilies = new Map<GreenNode, bool>();
    }

    // Every class the program declares, whose interface conformances the resolution reads.
    protected add(ClassType classType) {
        this.conformingClasses.push(classType);
    }

    // Marks the family of every method that implements a throwing interface method, wherever that
    // method is declared. Runs once, after all modules have contributed.
    protected resolve() {
        for (long i = 0; i < this.conformingClasses.length(); i++) {
            let classType = this.conformingClasses.get(i);
            Type? level = classType;
            while (level != null) {
                for (let implemented in types.interfacesOf(level)) {
                    for (let ladderLevel in types.interfaceLadderOf(implemented)) {
                        this.markConformance(classType, ladderLevel);
                    }
                }
                level = types.baseOf(level);
            }
        }
    }

    markConformance(ClassType classType, Type implemented) {
        let required = types.methodsOf(implemented);
        if (required == null) {
            return;
        }
        for (long i = 0; i < required.length(); i++) {
            let candidate = required.get(i);
            if (!candidate.signature().declaresThrows()) {
                continue;
            }
            let provided = findDeclaring(classType, candidate);
            if (provided == null) {
                continue;
            }
            let owner = types.authorityOf(provided.definingType());
            if (owner == null) {
                continue;
            }
            let root = rootDeclarationOf(owner, provided).signature().declaration();
            if (root != null) {
                this.carryingFamilies.set(root, true);
            }
        }
    }

    // True when the callable's machine interface carries the trailing error-slot parameter. A
    // method follows its family: the root declaration's own 'throws' marker, or the program-wide
    // conformance the resolution recorded. Everything else follows its own marker.
    protected carries(Signature signature, Method? method, DeclaredType? owner) -> bool {
        if (method == null || owner == null || !(owner is ClassType)) {
            return signature.declaresThrows();
        }
        if (method.isConstructor() || method.isDestructor()) {
            return signature.declaresThrows();
        }
        let root = rootDeclarationOf(owner, method);
        if (root.signature().declaresThrows()) {
            return true;
        }
        let declaration = root.signature().declaration();
        if (declaration == null) {
            return signature.declaresThrows();
        }
        return this.carryingFamilies.get(declaration) ?? false;
    }
}

class FunctionItem {
    protected FunctionDeclarationNode declaration;
    protected Signature signature;
    protected Method? method;
    protected DeclaredType? owner;

    protected constructor(this.declaration, this.signature, this.method, this.owner);
}

class TypeItem {
    protected DeclaredType declared;
    protected MemberListNode body;
    protected Span nameSpan;

    protected constructor(this.declared, this.body, this.nameSpan);
}

class ModuleExceptions {
    ModuleContext context;
    ThrowsRegistry registry;
    SemaResult result;
    Reporter reporter;
    TypeNames names;
    TypeStore store;
    string modulePath;
    ClassType? errorClass;

    // The constraint scope of the conditional member being processed, set per item. Inside it
    // the restated parameter carries the member's extra bounds.
    GreenNode? scopeOwner;
    MemberConstraint[] scopeConstraints;
    // The methods the function being validated overrides or implements, which decide whether
    // marking it 'throws' is a fix that compiles.
    List<Signature> answeredScope;

    List<FunctionItem> functionItems;
    List<TestDeclarationNode> testItems;
    List<TypeItem> typeItems;
    // Every lambda the module writes, wherever it appears. A lambda's body is a callable of its
    // own, so it converges under its own key instead of feeding the function around it.
    List<LambdaExpressionNode> lambdaItems;

    protected constructor(ModuleContext context, ThrowsRegistry registry, List<FileDiagnostic> collected) {
        this.context = context;
        this.registry = registry;
        this.result = context.result();
        this.reporter = new Reporter(context.module().filePath(), collected);
        this.names = context.names();
        this.store = context.resolver().typeStore();
        this.modulePath = context.module().canonicalPath();
        this.errorClass = context.resolver().errorClass();
        this.scopeOwner = null;
        this.scopeConstraints = [];
        this.answeredScope = new List<Signature>();
        this.functionItems = new List<FunctionItem>();
        this.testItems = new List<TestDeclarationNode>();
        this.typeItems = new List<TypeItem>();
        this.lambdaItems = new List<LambdaExpressionNode>();
    }

    // isAlwaysSubclassOf under the active item's constraint scope.
    alwaysSubclass(Type derived, Type ancestor) -> bool {
        return types.isAlwaysSubclassOfUnder(derived, ancestor, this.scopeOwner,
            this.scopeConstraints);
    }

    caughtBefore(Type thrown, List<Type?> clauseTypes, long limit) -> bool {
        for (long i = 0; i < limit; i++) {
            let clauseType = clauseTypes.get(i);
            if (clauseType != null && this.alwaysSubclass(thrown, clauseType)) {
                return true;
            }
        }
        return false;
    }

    shadowedByEarlier(Type clauseType, List<Type?> clauseTypes, long index) -> bool {
        for (long i = 0; i < index; i++) {
            let earlier = clauseTypes.get(i);
            if (earlier != null && this.alwaysSubclass(clauseType, earlier)) {
                return true;
            }
        }
        return false;
    }

    // Whether some instantiation could relate the two, judging a type parameter by its class bound.
    mightOverlap(Type left, Type right) -> bool {
        Type leftClass = types.boundClassOfUnder(left, this.scopeOwner, this.scopeConstraints);
        Type rightClass = types.boundClassOfUnder(right, this.scopeOwner,
            this.scopeConstraints);
        return types.isSubclassOf(leftClass, rightClass) || types.isSubclassOf(rightClass, leftClass);
    }

    relatedToAny(Type clauseType, ThrowSet bodySet) -> bool {
        if (bodySet.hasUnresolved()) {
            return true;
        }
        for (long i = 0; i < bodySet.members().length(); i++) {
            if (this.mightOverlap(clauseType, bodySet.members().get(i))) {
                return true;
            }
        }
        return false;
    }

    // The thrown members the allowed set does not cover in every instantiation. An allowed set
    // holding an unresolved type covers them all.
    strayUnderScope(ThrowSet thrown, ThrowSet allowed) -> ThrowSet {
        let strays = new ThrowSet();
        if (allowed.hasUnresolved()) {
            return strays;
        }
        for (long i = 0; i < thrown.members().length(); i++) {
            let member = thrown.members().get(i);
            bool covered = false;
            for (long a = 0; a < allowed.members().length(); a++) {
                if (this.alwaysSubclass(member, allowed.members().get(a))) {
                    covered = true;
                }
            }
            if (!covered) {
                strays.add(member);
            }
        }
        return strays;
    }

    enterItemScope(FunctionItem item) {
        this.scopeOwner = null;
        this.scopeConstraints = [];
        let method = item.method;
        if (method != null && method.isConditional()) {
            let authority = types.authorityOf(method.definingType());
            if (authority != null) {
                this.scopeOwner = authority.declaration();
                this.scopeConstraints = method.constraints();
            }
        }
    }

    leaveItemScope() {
        this.scopeOwner = null;
        this.scopeConstraints = [];
    }

    protected collect() {
        let root = this.context.root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    this.collectTopLevelFunction(declaration);
                },
                is StructDeclarationNode declaration -> {
                    let found = this.store.findDeclared(this.modulePath,
                        declaration.name().text());
                    if (found is StructType && found.declaration() == declaration.green()) {
                        this.collectMembers(found, found.methods(), found.staticMethods(),
                            declaration.body(), declaration.name().span());
                    }
                },
                is ClassDeclarationNode declaration -> {
                    let found = this.store.findDeclared(this.modulePath,
                        declaration.name().text());
                    if (found is ClassType && found.declaration() == declaration.green()) {
                        this.collectMembers(found, found.methods(), found.staticMethods(),
                            declaration.body(), declaration.name().span());
                    }
                },
                is PrimitiveDeclarationNode declaration -> {
                    let binding = this.bindingFor(declaration);
                    if (binding != null) {
                        this.collectMembers(binding, binding.methods(),
                            binding.staticMethods(), declaration.body(),
                            declaration.name().span());
                    }
                },
                is TestDeclarationNode declaration -> {
                    this.testItems.push(declaration);
                },
                default -> { },
            }
        }
        this.collectLambdas(root);
    }

    bindingFor(PrimitiveDeclarationNode node) -> PrimitiveBinding? {
        let primitive = types.primitiveNamed(this.store, node.name().text());
        if (primitive == null) {
            return null;
        }
        let binding = types.bindingOf(primitive);
        if (binding != null && binding.declaration() == node.green()) {
            return binding;
        }
        return null;
    }

    collectLambdas(SyntaxNode node) {
        if (node is LambdaExpressionNode) {
            this.lambdaItems.push(node);
        }
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.collectLambdas(children.get(i));
        }
    }

    // Hands this module's classes to the program-wide error-slot plan, which reads their
    // conformances after every module has collected.
    protected contributeConformances(ErrorSlotPlan slots) {
        for (long i = 0; i < this.typeItems.length(); i++) {
            let declared = this.typeItems.get(i).declared;
            if (declared is ClassType) {
                slots.add(declared);
            }
        }
    }

    collectTopLevelFunction(FunctionDeclarationNode node) {
        let entries = this.context.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isExternal() || entry.isBuiltin()) {
                continue;
            }
            if (entry.signature().declaration() == node.green()) {
                this.functionItems.push(new FunctionItem(node, entry.signature(), null, null));
                return;
            }
        }
    }

    collectMembers(DeclaredType owner, List<Method> methods, List<Method> staticMethods,
                           MemberListNode body, Span nameSpan) {
        this.typeItems.push(new TypeItem(owner, body, nameSpan));
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                let method = members.methodDeclaredBy(methods, member.green());
                if (method == null) {
                    method = members.methodDeclaredBy(staticMethods, member.green());
                }
                if (method != null) {
                    this.functionItems.push(new FunctionItem(member, method.signature(),
                        method, owner));
                }
            }
        }
    }

    // ---- Outward sets ----

    protected computeOnce() -> bool {
        bool changed = false;
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.enterItemScope(item);
            let outward = this.computeOutward(item.declaration, ThrowCount.Contract);
            this.leaveItemScope();
            if (this.registry.outwardFor(item.declaration.green()).addAll(outward)) {
                changed = true;
            }
        }
        for (long i = 0; i < this.testItems.length(); i++) {
            let test = this.testItems.get(i);
            let outward = new ThrowSet();
            this.collectThrows(test.body(), outward, ThrowCount.Contract);
            if (this.registry.outwardFor(test.green()).addAll(outward)) {
                changed = true;
            }
        }
        for (long i = 0; i < this.lambdaItems.length(); i++) {
            let lambda = this.lambdaItems.get(i);
            let outward = new ThrowSet();
            this.collectLambdaThrows(lambda, outward, ThrowCount.Contract);
            if (this.registry.outwardFor(lambda.green()).addAll(outward)) {
                changed = true;
            }
        }
        return changed;
    }

    // Records what each function is judged on, as its throws marker decides.
    protected judgeOutward() {
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.enterItemScope(item);
            ThrowCount count = ThrowCount.UnmarkedJudgment;
            if (item.signature.declaresThrows()) {
                count = ThrowCount.MarkedJudgment;
            }
            let judged = this.computeOutward(item.declaration, count);
            this.leaveItemScope();
            this.registry.setJudged(item.declaration.green(), judged);
        }
    }

    // A lambda has no catch clauses, so what its body raises is its whole outward set. Walking
    // the lambda's own children rather than its body slot keeps one code path for the two shapes
    // a body can take.
    collectLambdaThrows(LambdaExpressionNode lambda, ThrowSet into, ThrowCount count) {
        this.collectChildThrows(lambda, into, count);
    }

    // What the function lets escape, counted as 'count' says.
    computeOutward(FunctionDeclarationNode declaration, ThrowCount count) -> ThrowSet {
        let bodySet = this.bodyThrows(declaration, count);
        let clauseTypes = this.caughtClauseTypes(declaration);
        let outward = new ThrowSet();
        for (long m = 0; m < bodySet.members().length(); m++) {
            let thrown = bodySet.members().get(m);
            if (!this.caughtBefore(thrown, clauseTypes, clauseTypes.length())) {
                outward.add(thrown);
            }
        }
        // Any catch clause could catch an unresolved type, so only a body without one keeps it certain.
        if (clauseTypes.length() == 0) {
            outward.addUnresolvedOf(bodySet);
        } else if (bodySet.hasUnresolved() && !this.catchesEveryError(clauseTypes)) {
            outward.addUnresolved();
        }
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            let clause = declaration.catchClauses(i);
            let clauseType = clauseTypes.get(i);
            if (clauseType != null && hasRethrow(clause.body())) {
                this.addRethrown(bodySet, clauseTypes, i, clauseType, outward);
            }
            this.collectThrows(clause.body(), outward, count);
        }
        return outward;
    }

    // True when a clause catches 'Error' itself. Such a clause also catches an unresolved type.
    catchesEveryError(List<Type?> clauseTypes) -> bool {
        let errorBase = this.errorClass;
        return errorBase != null && this.caughtBefore(errorBase, clauseTypes, clauseTypes.length());
    }

    // What a 'rethrow' in clause i re-raises: every body type the clause fully catches, and the
    // clause's own type when the body only throws a broader base, since instances of the base
    // that are not the clause's type pass the clause by. A rethrow over an unresolved body type
    // re-raises the clause's own type.
    addRethrown(ThrowSet bodySet, List<Type?> clauseTypes, long index, Type clauseType, ThrowSet outward) {
        bool partial = bodySet.hasUnresolved();
        for (long m = 0; m < bodySet.members().length(); m++) {
            let thrown = bodySet.members().get(m);
            if (this.caughtBefore(thrown, clauseTypes, index)) {
                continue;
            }
            if (types.isAlwaysSubclassOf(thrown, clauseType)) {
                outward.add(thrown);
            } else if (this.mightOverlap(clauseType, thrown)) {
                partial = true;
            }
        }
        if (partial) {
            outward.add(clauseType);
        }
    }

    bodyThrows(FunctionDeclarationNode declaration, ThrowCount count) -> ThrowSet {
        let bodySet = new ThrowSet();
        let body = declaration.body();
        if (body != null) {
            this.collectThrows(body, bodySet, count);
        }
        return bodySet;
    }

    caughtClauseTypes(FunctionDeclarationNode declaration) -> List<Type?> {
        let clauseTypes = new List<Type?>();
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            clauseTypes.push(this.caughtTypeOf(declaration.catchClauses(i)));
        }
        return clauseTypes;
    }

    // The clause's caught type, or null when it is not a valid exception type. An invalid clause
    // is diagnosed separately and handles nothing.
    caughtTypeOf(CatchClauseNode clause) -> Type? {
        let binding = this.result.bindingOf(clause.green());
        if (binding == null) {
            return null;
        }
        Type caught = binding.type();
        let errorBase = this.errorClass;
        if (errorBase == null || !this.alwaysSubclass(caught, errorBase)) {
            return null;
        }
        if (!types.isClassLike(caught) && !(caught is TypeParamType)) {
            return null;
        }
        return caught;
    }

    // Adds what the node raises, counted as 'count' says.
    collectThrows(SyntaxNode node, ThrowSet into, ThrowCount count) {
        switch (node) {
            is ThrowStatementNode thrown -> {
                let operand = this.result.typeOf(thrown.value().green());
                if (operand != null) {
                    this.addRaised(into, operand);
                }
            },
            is TryExpressionNode tried -> {
                let operand = tried.operand();
                if (operand is CallExpressionNode) {
                    this.addCallThrows(operand, true, into, count);
                    this.collectChildThrows(operand, into, count);
                    return;
                }
            },
            is CallExpressionNode call -> {
                this.addCallThrows(call, false, into, count);
            },
            // A lambda is a callable of its own: what its body raises belongs to the lambda's
            // set, never to the function the lambda is written inside.
            is LambdaExpressionNode ignored -> {
                return;
            },
            default -> { },
        }
        this.collectChildThrows(node, into, count);
    }

    collectChildThrows(SyntaxNode node, ThrowSet into, ThrowCount count) {
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.collectThrows(children.get(i), into, count);
        }
    }

    // Adds what a call raises. A judgment counts a call that needs no 'try' as an unresolved type,
    // because its unmarked callee answers for what it throws. A call that needs a 'try' it does not
    // have is left out of an unmarked judgment, since the report of its missing 'try' names both fixes.
    addCallThrows(CallExpressionNode call, bool tried, ThrowSet into, ThrowCount count) {
        let contract = this.callContract(call);
        if (count == ThrowCount.Contract) {
            into.addAll(contract);
        } else if (this.requiresTry(call, contract)) {
            if (tried || count == ThrowCount.MarkedJudgment) {
                into.addAll(contract);
            }
        } else if (!contract.raisesNothing()) {
            into.addUnresolved();
        }
    }

    // The static target of a call, or null for calls that can never propagate: constructor
    // chains and unresolved callees.
    calleeSignatureOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.result.callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.result.methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.result.callableOf(member.green());
            },
            is SafeMemberExpressionNode member -> {
                let method = this.result.methodOf(member.green());
                if (method != null && !method.isConstructor()) {
                    return method.signature();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // ---- Validation ----

    protected validate() {
        for (long i = 0; i < this.functionItems.length(); i++) {
            this.validateFunction(this.functionItems.get(i));
        }
        for (long i = 0; i < this.testItems.length(); i++) {
            this.validateExpressions(this.testItems.get(i).body(), CallSite.Test, null);
        }
        for (long i = 0; i < this.typeItems.length(); i++) {
            this.validateTypeItem(this.typeItems.get(i));
        }
        for (long i = 0; i < this.lambdaItems.length(); i++) {
            this.validateLambda(this.lambdaItems.get(i));
        }
    }

    // A lambda's body is held to its target's throws list. It has no catch clauses of its own,
    // so the fix for an unlisted failure is in a named function. A call reported for its missing
    // 'try' is left out, since that report already names both fixes.
    validateLambda(LambdaExpressionNode lambda) {
        let outward = new ThrowSet();
        this.collectLambdaThrows(lambda, outward, ThrowCount.UnmarkedJudgment);
        if (!outward.raisesForCertain()) {
            return;
        }
        Type[] allowed = this.lambdaTargetThrownTypes(lambda);
        if (allowed.length == 0) {
            string thrown = "";
            string added = "what it throws";
            if (!outward.isEmpty()) {
                thrown = " {nameList(outward, this.names)}";
                added = "the type";
            }
            this.reporter.report("This lambda's body can throw{thrown}, and its target function type "
                + "declares no 'throws' list. Add {added} to the target's list, written after its "
                + "return type as in '(() -> void throws IOError)', or "
                + namedFunctionFix("throwing code"), lambda.arrow().span());
            return;
        }
        let strays = this.strayUnderScope(outward, throwSetOf(allowed, this.errorClass));
        if (!strays.isEmpty()) {
            this.reporter.report("This lambda's body can throw {nameList(strays, this.names)}, which its "
                + "target function type does not list. Add it to the target's list, or "
                + namedFunctionFix("throwing code"), lambda.arrow().span());
        }
    }

    lambdaTargetThrownTypes(LambdaExpressionNode lambda) -> Type[] {
        let info = this.result.lambdaOf(lambda.green());
        if (info == null) {
            return [];
        }
        let target = info.type();
        if (target is FunctionType) {
            return target.thrownTypes();
        }
        return [];
    }

    validateFunction(FunctionItem item) {
        this.enterItemScope(item);
        this.answeredScope = this.answeredSignatures(item);
        let declaration = item.declaration;
        let site = callSiteOf(item.signature, item.method);
        let body = declaration.body();
        if (body != null) {
            this.validateExpressions(body, site, null);
        }
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            this.validateExpressions(declaration.catchClauses(i).body(), catchBodySiteOf(site), null);
        }
        this.validateCaughtTypes(declaration);
        this.validateParameterDefaults(declaration);
        let outward = this.registry.judgedFor(declaration.green()) ?? new ThrowSet();
        let method = item.method;
        if (method != null && (method.isConstructor() || method.isDestructor())) {
            this.validateNoEscape(item, method, outward);
        } else {
            this.validateContract(item, outward);
            this.validateOverride(item);
        }
        this.validateCatchClauses(item);
        this.leaveItemScope();
        this.answeredScope = new List<Signature>();
    }

    // Checks the calls under the node. 'lambda' is the innermost lambda holding the node, and null
    // outside every lambda, where 'site' is the kind of declaration holding it.
    validateExpressions(SyntaxNode node, CallSite site, LambdaExpressionNode? lambda) {
        switch (node) {
            is TryExpressionNode tried -> {
                let operand = tried.operand();
                if (operand is CallExpressionNode) {
                    this.validateCall(operand, true, tried.tryKeyword().span(), site, lambda);
                    this.validateChildren(operand, site, lambda);
                } else {
                    this.validateExpressions(operand, site, lambda);
                }
            },
            is CallExpressionNode call -> {
                this.validateCall(call, false, call.span(), site, lambda);
                this.validateChildren(call, site, lambda);
            },
            is LambdaExpressionNode inner -> {
                this.validateChildren(inner, site, inner);
            },
            default -> {
                this.validateChildren(node, site, lambda);
            },
        }
    }

    validateChildren(SyntaxNode node, CallSite site, LambdaExpressionNode? lambda) {
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.validateExpressions(children.get(i), site, lambda);
        }
    }

    validateCall(CallExpressionNode call, bool tried, Span triedAt, CallSite site,
                 LambdaExpressionNode? lambda) {
        let contract = this.callContract(call);
        bool required = this.requiresTry(call, contract);
        if (required && !tried) {
            string raised = "can throw, because it is marked 'throws'.";
            if (!contract.isEmpty()) {
                raised = "can throw {nameList(contract, this.names)}.";
            }
            string fix = this.missingTryFix(contract, site, lambda);
            this.reporter.report("Call to {calleePhrase(call)} {raised} {fix}", call.span());
        }
        if (!required && contract.raisesNothing() && tried) {
            this.reporter.report("'try' is not needed here: {calleePhrase(call)} cannot throw. Remove 'try'.",
                triedAt);
        }
    }

    // The fix for a call that can throw and has no 'try', as its position allows. A test may throw
    // anything, a function marked 'throws' is held to its own list separately, and a lambda may
    // throw what its target function type lists. An override or implementation is offered the
    // marker only when marking it compiles.
    missingTryFix(ThrowSet contract, CallSite site, LambdaExpressionNode? lambda) -> string {
        if (lambda != null) {
            return this.lambdaTryFix(contract, lambda);
        }
        if (!this.marksCompile(contract)) {
            if (site == CallSite.Unmarked) {
                return "Prefix it with 'try', and catch it with a 'catch' clause after the body.";
            }
            if (site == CallSite.UnmarkedCatch) {
                return "A 'catch' clause does not catch what its own body throws, and marking this method "
                    + "'throws' would throw more than the method it answers to allows. Move the call into a "
                    + "function that catches it with a 'catch' clause.";
            }
        }
        return switch (site) {
            CallSite.Unmarked -> "Prefix it with 'try', and either catch it with a 'catch' clause or mark "
                + "this function 'throws'.",
            CallSite.Marked -> "Prefix it with 'try'.",
            CallSite.Constructor -> "Prefix it with 'try', and catch it with a 'catch' clause after the "
                + "constructor body.",
            CallSite.Destructor -> "Prefix it with 'try', and catch it with a 'catch' clause after the "
                + "destructor body.",
            CallSite.UnmarkedCatch -> "A 'catch' clause does not catch what its own body throws. Prefix it "
                + "with 'try' and mark this function 'throws', or move the call into a function that "
                + "catches it with a 'catch' clause.",
            CallSite.ConstructorCatch -> "A 'catch' clause does not catch what its own body throws, and a "
                + "constructor cannot be marked 'throws'. Move the call into a function that catches it "
                + "with a 'catch' clause.",
            CallSite.DestructorCatch -> "A 'catch' clause does not catch what its own body throws, and a "
                + "destructor cannot be marked 'throws'. Move the call into a function that catches it "
                + "with a 'catch' clause.",
            CallSite.Test -> "Prefix it with 'try'.",
        };
    }

    // The fix for a call in a lambda. The 'try' alone is enough when the target function type
    // lists what the call can throw, or when the target's list has an entry that did not resolve.
    lambdaTryFix(ThrowSet contract, LambdaExpressionNode lambda) -> string {
        Type[] allowed = this.lambdaTargetThrownTypes(lambda);
        let strays = this.strayUnderScope(contract, throwSetOf(allowed, this.errorClass));
        string added = "";
        if (!strays.isEmpty()) {
            added = nameList(strays, this.names);
        } else if (contract.isEmpty() && allowed.length == 0) {
            added = "what it throws";
        }
        if (added.length == 0) {
            return "Prefix it with 'try'.";
        }
        return "Prefix it with 'try', and add {added} to the 'throws' list of the lambda's target "
            + "function type, or " + namedFunctionFix("call");
    }

    // True when the call needs 'try': its static target is marked 'throws', or it calls through a
    // function value whose type lists an exception. An unmarked function never throws once it is
    // valid, so what its body raises is reported on it alone.
    requiresTry(CallExpressionNode call, ThrowSet contract) -> bool {
        let target = this.calleeSignatureOf(call);
        if (target != null) {
            return target.declaresThrows();
        }
        return !contract.isEmpty();
    }

    // Adds a raised type. A class outside 'Error' and a type parameter with no bound under 'Error'
    // are held as an unresolved type, because the refusal of each is the one report about it.
    addRaised(ThrowSet into, Type candidate) -> bool {
        let errorBase = this.errorClass;
        if (candidate is TypeParamType && errorBase != null && !this.alwaysSubclass(candidate, errorBase)) {
            return into.addUnresolved();
        }
        return into.addThrown(candidate, errorBase);
    }

    // What the callable is judged on: its declared list when it names types, and otherwise what
    // the judged sets hold for it. Without a judged set it is judged on its contract.
    judgedContractOf(Signature signature) -> ThrowSet {
        let declaration = signature.declaration();
        if (signature.throwsTypes().length > 0 || declaration == null) {
            return this.contractFor(signature);
        }
        return this.registry.judgedFor(declaration) ?? this.contractFor(signature);
    }

    // What a call to the signature may raise at the caller. An unresolved type raised by a
    // function marked 'throws' is certain to be raised. A function marked 'throws' that raises
    // nothing counts as raising an unresolved type, because its marker is what its callers follow.
    contractFor(Signature signature) -> ThrowSet {
        let contract = contractOf(signature, this.registry, this.errorClass);
        if (signature.declaresThrows() && contract.raisesNothing()) {
            let marked = new ThrowSet();
            marked.addUnresolved();
            return marked;
        }
        if (!signature.declaresThrows() || !contract.hasUnresolved()) {
            return contract;
        }
        let certain = new ThrowSet();
        certain.addAll(contract);
        certain.addCertainUnresolved();
        return certain;
    }

    // What this call may raise at its caller. A generic callee's contract is read with the
    // call's type arguments substituted, so 'throws E' becomes what the caller wrote.
    callContract(CallExpressionNode call) -> ThrowSet {
        let target = this.calleeSignatureOf(call);
        if (target == null) {
            return throwSetOf(this.calleeFunctionThrownTypes(call), this.errorClass);
        }
        let contract = this.contractFor(target);
        let arguments = this.result.callTypeArgumentsOf(call.green());
        let owner = target.declaration();
        if (arguments == null || owner == null) {
            return contract;
        }
        let substituted = new ThrowSet();
        substituted.addUnresolvedOf(contract);
        for (long i = 0; i < contract.members().length(); i++) {
            this.addRaised(substituted, this.store.substitute(contract.members().get(i), owner, arguments));
        }
        return substituted;
    }

    // The types a call with no static target raises. A call through a function value raises
    // what the value's type lists. A call that did not resolve raises an unresolved type.
    calleeFunctionThrownTypes(CallExpressionNode call) -> Type[] {
        let calleeType = this.result.typeOf(call.callee().green());
        if (calleeType != null && calleeType is FunctionType) {
            return calleeType.thrownTypes();
        }
        if (calleeType is ErrorType || this.result.typeOf(call.green()) is ErrorType) {
            return [this.store.errorType()];
        }
        return [];
    }

    // A constructor or destructor must handle everything its body can raise.
    validateNoEscape(FunctionItem item, Method method, ThrowSet outward) {
        if (!outward.raisesForCertain()) {
            return;
        }
        string kind = "Constructor";
        string word = "constructor";
        if (method.isDestructor()) {
            kind = "Destructor";
            word = "destructor";
        }
        string ownerName = "";
        let owner = item.owner;
        if (owner != null) {
            ownerName = " of '{this.names.nameOf(owner)}'";
        }
        string thrown = "";
        if (!outward.isEmpty()) {
            thrown = " {nameList(outward, this.names)}";
        }
        this.reporter.report("{kind}{ownerName} cannot let exceptions escape, but it can throw{thrown}. "
            + "Catch the exceptions with 'catch' clauses after the {word} body.", item.signature.nameSpan());
    }

    validateContract(FunctionItem item, ThrowSet outward) {
        let signature = item.signature;
        if (signature.declaresThrows() && signature.throwsTypes().length > 0) {
            let strays = this.strayUnderScope(outward, this.contractFor(signature));
            if (!strays.isEmpty()) {
                this.reporter.report("'{signature.name()}' can throw {nameList(strays, this.names)}, "
                    + "which its 'throws' list does not name. Add it to the list, or catch it "
                    + "with a 'catch' clause.", signature.nameSpan());
            }
            return;
        }
        if (signature.declaresThrows()) {
            if (outward.raisesNothing() && item.declaration.body() != null) {
                Span at = signature.nameSpan();
                let throwsClause = item.declaration.throwsClause();
                if (throwsClause != null) {
                    at = throwsClause.throwsKeyword().span();
                }
                this.reporter.report("'{signature.name()}' is marked 'throws' but cannot "
                    + "throw; remove 'throws'.", at);
            }
            return;
        }
        let markable = this.markable(outward, this.answeredSignatures(item));
        if (!markable.isEmpty()) {
            this.reporter.report("'{signature.name()}' can throw {nameList(markable, this.names)} but is "
                + "not marked 'throws'. Add "
                + "'throws {throwsClauseList(markable, this.names)}' after the signature, or "
                + "catch it with a 'catch' clause after the body.", signature.nameSpan());
        } else if (outward.isEmpty() && outward.raisesForCertain()) {
            this.reporter.report("'{signature.name()}' can throw but is not marked 'throws'. Add 'throws' "
                + "after the signature, or catch it with a 'catch' clause after the body.",
                signature.nameSpan());
        }
    }

    // The methods an override or an implementing method answers to: the method it overrides and
    // every interface method it implements.
    answeredSignatures(FunctionItem item) -> List<Signature> {
        let answered = new List<Signature>();
        let method = item.method;
        let owner = item.owner;
        if (method == null || owner == null) {
            return answered;
        }
        let baseMethod = findBaseMethod(owner, method);
        if (baseMethod != null) {
            answered.push(baseMethod.signature());
        }
        for (let implemented in types.interfacesOf(owner)) {
            for (let level in types.interfaceLadderOf(implemented)) {
                let required = types.methodsOf(level);
                if (required == null) {
                    continue;
                }
                for (long i = 0; i < required.length(); i++) {
                    let provided = findDeclaring(owner, required.get(i));
                    if (provided != null && provided.signature().declaration() == item.declaration.green()) {
                        answered.push(required.get(i).signature());
                    }
                }
            }
        }
        return answered;
    }

    // The thrown members every answered method allows, so that marking the function 'throws' makes
    // them legal. An answered method that is not marked 'throws' allows none, because a marked
    // override of it is refused. A member one of them does not allow is reported as widening it.
    markable(ThrowSet outward, List<Signature> answered) -> ThrowSet {
        let kept = new ThrowSet();
        for (long m = 0; m < outward.members().length(); m++) {
            let member = outward.members().get(m);
            if (this.allowedByAll(member, answered)) {
                kept.add(member);
            }
        }
        return kept;
    }

    // True when every answered method is marked 'throws' and allows the thrown type.
    allowedByAll(Type thrown, List<Signature> answered) -> bool {
        for (long a = 0; a < answered.length(); a++) {
            let signature = answered.get(a);
            if (!signature.declaresThrows()) {
                return false;
            }
            let contract = this.contractFor(signature);
            if (!contract.hasUnresolved() && !this.coveredBy(thrown, contract)) {
                return false;
            }
        }
        return true;
    }

    // True when marking the function being validated 'throws' would let the contract's types
    // through every method it overrides or implements.
    marksCompile(ThrowSet contract) -> bool {
        if (this.answeredScope.length() == 0) {
            return true;
        }
        for (long i = 0; i < this.answeredScope.length(); i++) {
            if (!this.answeredScope.get(i).declaresThrows()) {
                return false;
            }
        }
        for (long m = 0; m < contract.members().length(); m++) {
            if (!this.allowedByAll(contract.members().get(m), this.answeredScope)) {
                return false;
            }
        }
        return true;
    }

    // True when some member of the set is the thrown type or a superclass of it, in the active scope.
    coveredBy(Type thrown, ThrowSet allowed) -> bool {
        for (long a = 0; a < allowed.members().length(); a++) {
            if (this.alwaysSubclass(thrown, allowed.members().get(a))) {
                return true;
            }
        }
        return false;
    }

    validateOverride(FunctionItem item) {
        let method = item.method;
        let owner = item.owner;
        if (method == null || owner == null) {
            return;
        }
        let baseMethod = findBaseMethod(owner, method);
        if (baseMethod == null) {
            return;
        }
        // An unmarked override of an unmarked base may throw nothing. A marked one is refused by layout.
        let allowed = new ThrowSet();
        if (baseMethod.signature().declaresThrows() || item.signature.declaresThrows()) {
            allowed = this.contractFor(baseMethod.signature());
        }
        let strays = this.strayUnderScope(this.judgedContractOf(item.signature), allowed);
        if (!strays.isEmpty()) {
            this.reporter.report("Override '{method.name()}' can throw {nameList(strays, this.names)}, "
                + "which the '{method.name()}' it overrides in "
                + "'{this.names.of(baseMethod.definingType())}' does not list. An override "
                + "throws only what the method it overrides allows.{catchFix(item.signature)}",
                item.signature.nameSpan());
        }
    }

    validateCaughtTypes(FunctionDeclarationNode declaration) {
        for (long i = 0; i < declaration.catchClausesCount(); i++) {
            let clause = declaration.catchClauses(i);
            let binding = this.result.bindingOf(clause.green());
            if (binding == null) {
                continue;
            }
            Type caught = binding.type();
            if (caught is ErrorType) {
                continue;
            }
            let errorBase = this.errorClass;
            if (errorBase == null) {
                continue;
            }
            if (caught is TypeParamType) {
                if (!this.alwaysSubclass(caught, errorBase)) {
                    this.reporter.report("Cannot catch '{this.names.of(caught)}': a type "
                        + "parameter is caught through its class bound, and "
                        + "'{this.names.of(caught)}' has no bound under 'Error'. Bound it as "
                        + "'{this.names.of(caught)}: Error', or by a subclass of 'Error'.",
                        clause.caughtType().span());
                }
                continue;
            }
            if (!types.isClassLike(caught) || !types.isSubclassOf(caught, errorBase)) {
                this.reporter.report("Cannot catch '{this.names.of(caught)}'; only 'Error' "
                    + "or a subclass of it can be caught.", clause.caughtType().span());
            }
        }
    }

    validateCatchClauses(FunctionItem item) {
        let declaration = item.declaration;
        long clauseCount = declaration.catchClausesCount();
        if (clauseCount == 0) {
            return;
        }
        let bodySet = this.bodyThrows(declaration, ThrowCount.Contract);
        if (bodySet.raisesNothing()) {
            this.reporter.report("'{item.signature.name()}' has 'catch' clauses but its body "
                + "cannot throw; remove them.",
                declaration.catchClauses(0).catchKeyword().span());
            return;
        }
        let clauseTypes = this.caughtClauseTypes(declaration);
        for (long i = 0; i < clauseCount; i++) {
            let clause = declaration.catchClauses(i);
            let clauseType = clauseTypes.get(i);
            if (clauseType == null) {
                continue;
            }
            string shown = this.names.of(clauseType);
            if (this.shadowedByEarlier(clauseType, clauseTypes, i)) {
                this.reporter.report("This 'catch ({shown} ...)' is unreachable: an earlier "
                    + "'catch' clause already handles it. Move it above that clause, or "
                    + "remove it.", clause.caughtType().span());
                continue;
            }
            if (!this.relatedToAny(clauseType, bodySet)) {
                this.reporter.report("This 'catch ({shown} ...)' never runs: the body of "
                    + "'{item.signature.name()}' cannot throw '{shown}' or a subclass of it. "
                    + "Remove the clause.", clause.caughtType().span());
            }
        }
    }

    validateParameterDefaults(FunctionDeclarationNode declaration) {
        let parameterList = declaration.parameters();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let defaultValue = parameterList.parameters(i).defaultValue();
            if (defaultValue != null) {
                this.validateDefaultExpression(defaultValue.value(), "A default value");
            }
        }
    }

    validateDefaultExpression(SyntaxNode node, string label) {
        if (node is CallExpressionNode) {
            let contract = this.callContract(node);
            if (this.requiresTry(node, contract)) {
                string reason = "it is marked 'throws'";
                if (!contract.isEmpty()) {
                    reason = "it can throw {nameList(contract, this.names)}";
                }
                this.reporter.report("{label} cannot call {calleePhrase(node)} because {reason}; it must not "
                    + "throw.", node.span());
            }
        }
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.validateDefaultExpression(children.get(i), label);
        }
    }

    validateTypeItem(TypeItem item) {
        for (long i = 0; i < item.body.membersCount(); i++) {
            let member = item.body.members(i);
            if (member is FieldDeclarationNode) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    this.validateDefaultExpression(defaultValue.value(),
                        initializerLabel(item, member, this.names));
                }
            }
        }
        switch (item.declared) {
            is ClassType classType -> {
                this.validateInterfaceThrows(classType, item);
            },
            is StructType structType -> {
                this.validateInterfaceThrows(structType, item);
            },
            is PrimitiveBinding binding -> {
                this.validateInterfaceThrows(binding, item);
            },
            default -> { },
        }
    }

    // Every conformance an owner declares holds its implementations to the interface's throws
    // contract. A class is searched through its chain, while a struct and a primitive binding
    // resolve to their own members.
    validateInterfaceThrows(DeclaredType owner, TypeItem item) {
        let checked = new Set<Type>();
        for (let implemented in types.interfacesOf(owner)) {
            for (let level in types.interfaceLadderOf(implemented)) {
                if (!checked.add(level)) {
                    continue;
                }
                this.validateLevelThrows(owner, item, level);
            }
        }
    }

    validateLevelThrows(DeclaredType owner, TypeItem item, Type level) {
        let methods = types.methodsOf(level);
        if (methods == null) {
            return;
        }
        for (long i = 0; i < methods.length(); i++) {
            let required = methods.get(i);
            let provided = findDeclaring(owner, required);
            // A conditional member never satisfies an interface requirement; the layout phase
            // already rejected the conformance, so there is no implementation to hold to the
            // interface's contract here.
            if (provided == null || provided.isConditional()) {
                continue;
            }
            let allowed = this.contractFor(required.signature());
            let strays = this.strayUnderScope(this.judgedContractOf(provided.signature()), allowed);
            if (strays.isEmpty()) {
                continue;
            }
            Span at = item.nameSpan;
            string fix = "";
            if (types.authorityOf(provided.definingType()) == owner) {
                at = provided.signature().nameSpan();
                fix = catchFix(provided.signature());
            }
            this.reporter.report("Method '{required.name()}' of '{this.names.nameOf(owner)}' can "
                + "throw {nameList(strays, this.names)}, which the '{required.name()}' "
                + "declared by interface '{this.names.of(level)}' does not list. An "
                + "implementing method throws only what the interface lists.{fix}", at);
        }
    }

    // ---- Recording ----

    protected record(ErrorSlotPlan slots) {
        for (long i = 0; i < this.functionItems.length(); i++) {
            let item = this.functionItems.get(i);
            this.result.setThrowsSet(item.declaration.green(),
                this.registry.outwardFor(item.declaration.green()).members().toArray());
            this.result.setAbiThrows(item.declaration.green(),
                slots.carries(item.signature, item.method, item.owner));
        }
        for (long i = 0; i < this.testItems.length(); i++) {
            let test = this.testItems.get(i);
            this.result.setThrowsSet(test.green(),
                this.registry.outwardFor(test.green()).members().toArray());
            this.result.setAbiThrows(test.green(), true);
        }
    }
}

// How a diagnostic names the initializer it refuses. A lazy const is named outright, because a
// read of one must never have to be a 'try'.
initializerLabel(TypeItem item, FieldDeclarationNode member, TypeNames names) -> string {
    if (members.fieldModifiers(member).declaresLazy) {
        return "The initializer of lazy const "
            + "'{names.nameOf(item.declared)}.{member.name().text()}'";
    }
    return "A field default";
}

// The topmost base-chain declaration the method overrides, or the method itself: the declaration
// a dispatch-table slot is assigned at, which is why the whole family shares its ABI.
rootDeclarationOf(DeclaredType owner, Method method) -> Method {
    Method root = method;
    Type? current = types.baseOf(owner);
    while (current != null) {
        let found = findOwnMethod(current, method.name(), method.signature());
        if (found != null) {
            root = found;
        }
        current = types.baseOf(current);
    }
    return root;
}


hasRethrow(SyntaxNode node) -> bool {
    if (node is RethrowStatementNode) {
        return true;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (hasRethrow(children.get(i))) {
            return true;
        }
    }
    return false;
}

// How a diagnostic names what a call calls. A function, method or variable holding a function
// value is named by its quoted name. Any other callee is the function value its expression
// produces, quoted when that expression is written on one line without a comment.
calleePhrase(CallExpressionNode call) -> string {
    switch (call.callee()) {
        is IdentifierExpressionNode identifier -> {
            return "'{identifier.name().text()}'";
        },
        is MemberExpressionNode member -> {
            return "'{member.member().text()}'";
        },
        is SafeMemberExpressionNode member -> {
            return "'{member.member().text()}'";
        },
        is SuperExpressionNode ignored -> {
            return "'super'";
        },
        default -> {
            let written = writtenOnOneLine(call.callee().green());
            if (written == null) {
                return "the function value";
            }
            return "the function value '{written}'";
        },
    }
}

// The node's text from its first token to its last, or null when a comment or a line break
// sits between them. Whitespace, line breaks and comments are trivia on the tokens, so a comment
// marker inside a string literal is text and never trivia.
writtenOnOneLine(GreenNode node) -> string? {
    let tokens = new List<GreenToken>();
    collectTokens(node, tokens);
    let builder = new StringBuilder();
    string pending = "";
    for (long i = 0; i < tokens.length(); i++) {
        let token = tokens.get(i);
        string full = token.fullText();
        long contentStart = token.leadingLength();
        long contentEnd = contentStart + token.contentLength();
        if (i > 0) {
            string between = pending + full.substring(0, contentStart);
            if (between.contains("//") || between.contains("/*")) {
                return null;
            }
            builder.append(between);
        }
        builder.append(token.text());
        pending = full.substring(contentEnd);
    }
    string written = builder.toString();
    if (written.contains("\n") || written.contains("\r")) {
        return null;
    }
    return written;
}

// Every token under the node, in source order.
collectTokens(GreenNode node, List<GreenToken> into) {
    for (long i = 0; i < node.slotCount(); i++) {
        switch (node.slot(i)) {
            is GreenToken token -> {
                into.push(token);
            },
            is GreenNode child -> {
                collectTokens(child, into);
            },
            default -> { },
        }
    }
}

// The fix a widening refusal offers a method that is not marked 'throws': catching what it throws.
// A method with a marker is held to its own list by its own reports, so it gets none here.
catchFix(Signature signature) -> string {
    if (signature.declaresThrows()) {
        return "";
    }
    return " Catch it with a 'catch' clause after the body.";
}

// The fix that moves the throwing 'part' of a lambda into a named function.
namedFunctionFix(string part) -> string {
    return "move the {part} into a named function that catches it with a 'catch' clause.";
}

// Which throws a collection counts. A contract is what callers see, every call included. A judgment
// is what the declaration itself answers for, and a function marked 'throws' answers for every call
// it makes.
enum ThrowCount {
    Contract,
    MarkedJudgment,
    UnmarkedJudgment,
}

// Where a call is written. A missing 'try' is fixed differently in each place, and a call in a
// 'catch' clause's body cannot be caught by that clause or its neighbors.
enum CallSite {
    Unmarked,
    Marked,
    Constructor,
    Destructor,
    Test,
    UnmarkedCatch,
    ConstructorCatch,
    DestructorCatch,
}

callSiteOf(Signature signature, Method? method) -> CallSite {
    if (method != null && method.isConstructor()) {
        return CallSite.Constructor;
    }
    if (method != null && method.isDestructor()) {
        return CallSite.Destructor;
    }
    if (signature.declaresThrows()) {
        return CallSite.Marked;
    }
    return CallSite.Unmarked;
}

// The same site inside one of its 'catch' clauses. A marked function stays marked there.
catchBodySiteOf(CallSite site) -> CallSite {
    return switch (site) {
        CallSite.Unmarked -> CallSite.UnmarkedCatch,
        CallSite.Constructor -> CallSite.ConstructorCatch,
        CallSite.Destructor -> CallSite.DestructorCatch,
        default -> site,
    };
}

// The set's types as a diagnostic reads them: each quoted, alphabetical, comma-separated.
nameList(ThrowSet set, TypeNames names) -> string {
    string[] sorted = sortedSpellings(set, names);
    let builder = new StringBuilder();
    for (long i = 0; i < sorted.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append("'");
        builder.append(sorted[i]);
        builder.append("'");
    }
    return builder.toString();
}

// The same types unquoted, so a message can quote a whole 'throws IOError, ParseError' clause
// for a reader to paste.
throwsClauseList(ThrowSet set, TypeNames names) -> string {
    return string.joined(sortedSpellings(set, names), ", ");
}

// The thrown types spelled and ordered, so two runs name them the same way.
sortedSpellings(ThrowSet set, TypeNames names) -> string[] {
    let spellings = new List<string>();
    for (long i = 0; i < set.members().length(); i++) {
        spellings.push(names.of(set.members().get(i)));
    }
    string[] sorted = spellings.toArray();
    for (long i = 1; i < sorted.length; i++) {
        string current = sorted[i];
        long j = i - 1;
        while (j >= 0 && isTextAfter(sorted[j], current)) {
            sorted[j + 1] = sorted[j];
            j--;
        }
        sorted[j + 1] = current;
    }
    return sorted;
}

isTextAfter(string left, string right) -> bool {
    byte[] leftBytes = left.toBytes();
    byte[] rightBytes = right.toBytes();
    long limit = leftBytes.length;
    if (rightBytes.length < limit) {
        limit = rightBytes.length;
    }
    for (long i = 0; i < limit; i++) {
        if (leftBytes[i] != rightBytes[i]) {
            return leftBytes[i] > rightBytes[i];
        }
    }
    return leftBytes.length > rightBytes.length;
}

// The nearest base-chain method with the same name and parameter types.
findBaseMethod(DeclaredType owner, Method method) -> Method? {
    if (method.isConstructor() || method.isDestructor()) {
        return null;
    }
    Type? current = types.baseOf(owner);
    while (current != null) {
        let found = findOwnMethod(current, method.name(), method.signature());
        if (found != null) {
            return found;
        }
        current = types.baseOf(current);
    }
    return null;
}

// The most derived declaration with the name and parameter types: the owner's own methods
// first, then its base chain, which a primitive binding does not have.
findDeclaring(DeclaredType owner, Method required) -> Method? {
    let own = findOwnMethod(owner, required.name(), required.signature());
    if (own != null) {
        return own;
    }
    return findBaseMethod(owner, required);
}

findOwnMethod(Type owner, string methodName, Signature signature) -> Method? {
    let methods = types.methodsOf(owner);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let candidate = methods.get(i);
        if (candidate.name() == methodName && !candidate.isConstructor()
                && types.sameParameterTypes(candidate.signature(), signature)) {
            return candidate;
        }
    }
    return null;
}
