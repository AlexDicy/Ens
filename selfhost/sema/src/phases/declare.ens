// The declare phase: a pure per-file pass that records what a file declares and publishes each
// type's metadata before any cross-file resolution happens. It reads one parsed tree and nothing
// else: no type store, no other modules, no file system.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import EnumDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ExternalTypeDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ExternalBlockNode from @ens.frontend.syntax.generated.nodes;
import ExternalFunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ImportDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ImportPathNode from @ens.frontend.syntax.generated.nodes;
import TypeParameterListNode from @ens.frontend.syntax.generated.nodes;
import TopLevelItem from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import SyntaxToken from @ens.frontend.syntax.node;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

public enum DeclaredKind {
    Class,
    Interface,
    Struct,
    Enum,
    External,
}

// The declaration's kind as it reads in a diagnostic.
public kindWord(DeclaredKind kind) -> string {
    return switch (kind) {
        Class -> "class",
        Interface -> "interface",
        Struct -> "struct",
        Enum -> "enum",
        External -> "external type",
    };
}

// One declared type name with the metadata it publishes. The green node is the stable identity of
// the declaration site.
public class TypeDeclaration {
    string declaredName;
    DeclaredKind declaredKind;
    Visibility declaredVisibility;
    string[] declaredTypeParameters;
    bool declaredAbstract;
    bool declaredFinal;
    bool declaredSealed;
    GreenNode declarationNode;
    Span declaredNameSpan;

    protected constructor(string name, DeclaredKind kind, Visibility visibility, string[] typeParameters,
                bool isAbstract, bool isFinal, bool isSealed, GreenNode node, Span nameSpan) {
        this.declaredName = name;
        this.declaredKind = kind;
        this.declaredVisibility = visibility;
        this.declaredTypeParameters = typeParameters;
        this.declaredAbstract = isAbstract;
        this.declaredFinal = isFinal;
        this.declaredSealed = isSealed;
        this.declarationNode = node;
        this.declaredNameSpan = nameSpan;
    }

    public name() -> string {
        return this.declaredName;
    }

    public kind() -> DeclaredKind {
        return this.declaredKind;
    }

    public visibility() -> Visibility {
        return this.declaredVisibility;
    }

    public typeParameters() -> string[] {
        return this.declaredTypeParameters;
    }

    public isAbstract() -> bool {
        return this.declaredAbstract;
    }

    public isFinal() -> bool {
        return this.declaredFinal;
    }

    public isSealed() -> bool {
        return this.declaredSealed;
    }

    public node() -> GreenNode {
        return this.declarationNode;
    }

    protected nameSpan() -> Span {
        return this.declaredNameSpan;
    }
}

public class FunctionDeclaration {
    string functionName;
    Visibility functionVisibility;
    GreenNode declarationNode;
    Span functionNameSpan;

    protected constructor(string name, Visibility visibility, GreenNode node, Span nameSpan) {
        this.functionName = name;
        this.functionVisibility = visibility;
        this.declarationNode = node;
        this.functionNameSpan = nameSpan;
    }

    public name() -> string {
        return this.functionName;
    }

    public visibility() -> Visibility {
        return this.functionVisibility;
    }

    node() -> GreenNode {
        return this.declarationNode;
    }

    nameSpan() -> Span {
        return this.functionNameSpan;
    }
}

public class ExternalFunctionDeclaration {
    string functionName;
    string libraryName;
    GreenNode declarationNode;
    Span functionNameSpan;

    protected constructor(string name, string library, GreenNode node, Span nameSpan) {
        this.functionName = name;
        this.libraryName = library;
        this.declarationNode = node;
        this.functionNameSpan = nameSpan;
    }

    public name() -> string {
        return this.functionName;
    }

    public library() -> string {
        return this.libraryName;
    }

    node() -> GreenNode {
        return this.declarationNode;
    }

    nameSpan() -> Span {
        return this.functionNameSpan;
    }
}

// One primitive binding as written: the primitive its name position spells, whether or not that
// name is a primitive's, plus the spans the legality checks report at.
public class PrimitiveBindingDeclaration {
    string boundName;
    Span boundNameSpan;
    Span keywordSpan;
    GreenNode declarationNode;

    protected constructor(string name, Span nameSpan, Span keyword, GreenNode node) {
        this.boundName = name;
        this.boundNameSpan = nameSpan;
        this.keywordSpan = keyword;
        this.declarationNode = node;
    }

    // The name as written, which the link phase resolves against the primitives.
    public name() -> string {
        return this.boundName;
    }

    public nameSpan() -> Span {
        return this.boundNameSpan;
    }

    // The 'primitive' keyword, where a binding outside the standard library is reported.
    public declarationSpan() -> Span {
        return this.keywordSpan;
    }

    public node() -> GreenNode {
        return this.declarationNode;
    }
}

public class TestDeclaration {
    GreenNode declarationNode;
    Span declarationSpan;

    protected constructor(GreenNode node, Span span) {
        this.declarationNode = node;
        this.declarationSpan = span;
    }

    node() -> GreenNode {
        return this.declarationNode;
    }

    span() -> Span {
        return this.declarationSpan;
    }
}

// One import declaration as written. Records align one to one with the module graph's
// per-declaration import targets, so the link phase joins the two by index.
public class ImportRecord {
    bool namedImport;
    string importedName;
    string lastSegment;
    bool packageImport;
    string writtenPath;
    Span importSpan;
    GreenNode declarationNode;

    protected constructor(bool named, string name, string namespaceName, bool isPackage, string pathText,
                Span span, GreenNode node) {
        this.namedImport = named;
        this.importedName = name;
        this.lastSegment = namespaceName;
        this.packageImport = isPackage;
        this.writtenPath = pathText;
        this.importSpan = span;
        this.declarationNode = node;
    }

    // True for 'import Name from path;', false for a namespace import 'import path;'.
    public isNamed() -> bool {
        return this.namedImport;
    }

    // The imported name of a named import; "" for a namespace import.
    public name() -> string {
        return this.importedName;
    }

    // The last path segment, which a namespace import binds.
    public namespaceName() -> string {
        return this.lastSegment;
    }

    public isPackage() -> bool {
        return this.packageImport;
    }

    // The dotted path as written, without the leading '@'.
    public pathText() -> string {
        return this.writtenPath;
    }

    public span() -> Span {
        return this.importSpan;
    }

    node() -> GreenNode {
        return this.declarationNode;
    }
}

// Everything one file declares, captured syntactically. Type metadata is published here, before
// any cross-file resolution; signatures stay unresolved.
public class FileDeclarations {
    string declaredFilePath;
    TypeDeclaration[] fileTypes;
    FunctionDeclaration[] fileFunctions;
    ExternalFunctionDeclaration[] fileExternalFunctions;
    string[] fileExternalLibraries;
    PrimitiveBindingDeclaration[] filePrimitiveBindings;
    TestDeclaration[] fileTests;
    ImportRecord[] fileImports;
    Map<string, TypeDeclaration> typesByName;
    Set<string> functionNames;

    public constructor(string filePath, TypeDeclaration[] types, FunctionDeclaration[] functions,
                ExternalFunctionDeclaration[] externalFunctions, string[] externalLibraries,
                PrimitiveBindingDeclaration[] primitiveBindings, TestDeclaration[] tests,
                ImportRecord[] imports) {
        this.declaredFilePath = filePath;
        this.fileTypes = types;
        this.fileFunctions = functions;
        this.fileExternalFunctions = externalFunctions;
        this.fileExternalLibraries = externalLibraries;
        this.filePrimitiveBindings = primitiveBindings;
        this.fileTests = tests;
        this.fileImports = imports;
        this.typesByName = new Map<string, TypeDeclaration>();
        for (let declared in types) {
            if (!this.typesByName.contains(declared.name())) {
                this.typesByName.set(declared.name(), declared);
            }
        }
        this.functionNames = new Set<string>();
        for (let declared in functions) {
            this.functionNames.add(declared.name());
        }
        for (let declared in externalFunctions) {
            this.functionNames.add(declared.name());
        }
    }

    public filePath() -> string {
        return this.declaredFilePath;
    }

    public types() -> TypeDeclaration[] {
        return this.fileTypes;
    }

    public functions() -> FunctionDeclaration[] {
        return this.fileFunctions;
    }

    public externalFunctions() -> ExternalFunctionDeclaration[] {
        return this.fileExternalFunctions;
    }

    public externalLibraries() -> string[] {
        return this.fileExternalLibraries;
    }

    public primitiveBindings() -> PrimitiveBindingDeclaration[] {
        return this.filePrimitiveBindings;
    }

    public tests() -> TestDeclaration[] {
        return this.fileTests;
    }

    public imports() -> ImportRecord[] {
        return this.fileImports;
    }

    // The first declaration of the name; later duplicates were diagnosed and do not resolve.
    public typeNamed(string name) -> TypeDeclaration? {
        return this.typesByName.get(name);
    }

    // True when the file declares a free or external function with the name, at any visibility.
    public hasFunctionNamed(string name) -> bool {
        return this.functionNames.contains(name);
    }
}

public class DeclareResult {
    FileDeclarations declareDeclarations;
    FileDiagnostic[] declareDiagnostics;

    protected constructor(FileDeclarations declarations, FileDiagnostic[] diagnostics) {
        this.declareDeclarations = declarations;
        this.declareDiagnostics = diagnostics;
    }

    public declarations() -> FileDeclarations {
        return this.declareDeclarations;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.declareDiagnostics;
    }
}

public declareFile(SourceFileNode file, string filePath) -> DeclareResult {
    let collector = new FileCollector(filePath);
    for (long i = 0; i < file.itemsCount(); i++) {
        collector.collect(file.items(i));
    }
    return collector.finish();
}

class FileCollector {
    string filePath;
    List<TypeDeclaration> types;
    List<FunctionDeclaration> functions;
    List<ExternalFunctionDeclaration> externalFunctions;
    List<string> externalLibraries;
    List<PrimitiveBindingDeclaration> primitiveBindings;
    List<TestDeclaration> tests;
    List<ImportRecord> imports;
    Map<string, TypeDeclaration> typesByName;
    List<FileDiagnostic> collected;

    protected constructor(string filePath) {
        this.filePath = filePath;
        this.types = new List<TypeDeclaration>();
        this.functions = new List<FunctionDeclaration>();
        this.externalFunctions = new List<ExternalFunctionDeclaration>();
        this.externalLibraries = new List<string>();
        this.primitiveBindings = new List<PrimitiveBindingDeclaration>();
        this.tests = new List<TestDeclaration>();
        this.imports = new List<ImportRecord>();
        this.typesByName = new Map<string, TypeDeclaration>();
        this.collected = new List<FileDiagnostic>();
    }

    protected collect(TopLevelItem item) {
        switch (item) {
            is ClassDeclarationNode declaration -> {
                this.collectClass(declaration);
            },
            is InterfaceDeclarationNode declaration -> {
                this.collectInterface(declaration);
            },
            is StructDeclarationNode declaration -> {
                this.collectStruct(declaration);
            },
            is EnumDeclarationNode declaration -> {
                this.collectEnum(declaration);
            },
            is ExternalTypeDeclarationNode declaration -> {
                this.collectExternalType(declaration);
            },
            is ExternalBlockNode declaration -> {
                this.collectExternalBlock(declaration);
            },
            is FunctionDeclarationNode declaration -> {
                this.collectFunction(declaration);
            },
            is PrimitiveDeclarationNode declaration -> {
                this.collectPrimitiveBinding(declaration);
            },
            is TestDeclarationNode declaration -> {
                this.collectTest(declaration);
            },
            is ImportDeclarationNode declaration -> {
                this.collectImport(declaration);
            },
            default -> { },
        }
    }

    protected finish() -> DeclareResult {
        let declarations = new FileDeclarations(this.filePath, this.types.toArray(),
            this.functions.toArray(), this.externalFunctions.toArray(),
            this.externalLibraries.toArray(), this.primitiveBindings.toArray(),
            this.tests.toArray(), this.imports.toArray());
        return new DeclareResult(declarations, this.collected.toArray());
    }

    collectClass(ClassDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            let modifier = declaration.modifiers(i);
            this.checkTypeModifier("Class '{name.text()}'", DeclaredKind.Class, modifier);
            modifiers.add(modifier.kind(), modifier.span());
        }
        this.registerType(new TypeDeclaration(name.text(), DeclaredKind.Class,
            this.resolveVisibility(modifiers, name.text()),
            typeParameterNames(declaration.typeParameters()),
            modifiers.declaresAbstract, modifiers.declaresFinal, modifiers.declaresSealed,
            declaration.green(), name.span()));
    }

    collectInterface(InterfaceDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            let modifier = declaration.modifiers(i);
            this.checkTypeModifier("Interface '{name.text()}'", DeclaredKind.Interface,
                modifier);
            modifiers.add(modifier.kind(), modifier.span());
        }
        this.registerType(new TypeDeclaration(name.text(), DeclaredKind.Interface,
            this.resolveVisibility(modifiers, name.text()),
            typeParameterNames(declaration.typeParameters()),
            false, false, false, declaration.green(), name.span()));
    }

    collectStruct(StructDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            let modifier = declaration.modifiers(i);
            this.checkTypeModifier("Struct '{name.text()}'", DeclaredKind.Struct, modifier);
            modifiers.add(modifier.kind(), modifier.span());
        }
        this.registerType(new TypeDeclaration(name.text(), DeclaredKind.Struct,
            this.resolveVisibility(modifiers, name.text()),
            typeParameterNames(declaration.typeParameters()),
            false, false, false, declaration.green(), name.span()));
    }

    collectEnum(EnumDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            let modifier = declaration.modifiers(i);
            this.checkTypeModifier("Enum '{name.text()}'", DeclaredKind.Enum, modifier);
            modifiers.add(modifier.kind(), modifier.span());
        }
        this.registerType(new TypeDeclaration(name.text(), DeclaredKind.Enum,
            this.resolveVisibility(modifiers, name.text()), [], false, false, false,
            declaration.green(), name.span()));
    }

    collectExternalType(ExternalTypeDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            let modifier = declaration.modifiers(i);
            this.checkTypeModifier("External type '{name.text()}'", DeclaredKind.External,
                modifier);
            modifiers.add(modifier.kind(), modifier.span());
        }
        this.registerType(new TypeDeclaration(name.text(), DeclaredKind.External,
            this.resolveExternalTypeVisibility(modifiers, name.text()), [], false, false, false,
            declaration.green(), name.span()));
    }

    collectExternalBlock(ExternalBlockNode declaration) {
        string library = declaration.library().text();
        this.externalLibraries.push(library);
        for (long i = 0; i < declaration.functionsCount(); i++) {
            let item = declaration.functions(i);
            if (item is ExternalFunctionDeclarationNode) {
                let name = item.name();
                if (name.text().length == 0) {
                    continue;
                }
                this.externalFunctions.push(new ExternalFunctionDeclaration(name.text(),
                    library, item.green(), name.span()));
            }
        }
    }

    collectFunction(FunctionDeclarationNode declaration) {
        let name = declaration.name();
        if (name == null || name.text().length == 0) {
            return;
        }
        let modifiers = new ModifierSet();
        for (long i = 0; i < declaration.modifiersCount(); i++) {
            modifiers.add(declaration.modifiers(i).kind(), declaration.modifiers(i).span());
        }
        this.functions.push(new FunctionDeclaration(name.text(),
            this.resolveVisibility(modifiers, name.text()), declaration.green(), name.span()));
    }

    collectPrimitiveBinding(PrimitiveDeclarationNode declaration) {
        let name = declaration.name();
        if (name.text().length == 0) {
            return;
        }
        this.primitiveBindings.push(new PrimitiveBindingDeclaration(name.text(), name.span(),
            declaration.primitiveKeyword().span(), declaration.green()));
    }

    collectTest(TestDeclarationNode declaration) {
        this.tests.push(new TestDeclaration(declaration.green(), declaration.span()));
    }

    collectImport(ImportDeclarationNode declaration) {
        let path = declaration.path();
        string namespaceName = "";
        if (path.segmentsCount() > 0) {
            namespaceName = path.segments(path.segmentsCount() - 1).text();
        }
        let binding = declaration.binding();
        string importedName = "";
        Span span = path.span();
        if (binding != null) {
            importedName = binding.name().text();
            span = binding.name().span();
        }
        this.imports.push(new ImportRecord(binding != null, importedName, namespaceName,
            path.at() != null, pathText(path), span, declaration.green()));
    }

    registerType(TypeDeclaration declaration) {
        let existing = this.typesByName.get(declaration.name());
        if (existing == null) {
            this.typesByName.set(declaration.name(), declaration);
        } else {
            this.collected.push(new FileDiagnostic(this.filePath,
                "Duplicate type '{declaration.name()}'; this file already declares a "
                + "{kindWord(existing.kind())} with this name.", declaration.nameSpan()));
        }
        this.types.push(declaration);
    }

    // The declaration's visibility from its modifier list: private when unmarked, 'protected'
    // rejected (it only means something on members), and any second visibility mark rejected.
    checkTypeModifier(string subject, DeclaredKind kind, SyntaxToken modifier) {
        let problem = typeModifierProblem(modifier.kind(), kind);
        if (problem == null) {
            return;
        }
        string word = modifier.text();
        this.collected.push(new FileDiagnostic(this.filePath,
            "{subject} cannot be '{word}'; {problem}. Remove '{word}'.", modifier.span()));
    }

    resolveVisibility(ModifierSet modifiers, string name) -> Visibility {
        Visibility resolved = Visibility.Private;
        bool seen = false;
        let marks = modifiers.visibilityMarks;
        for (long i = 0; i < marks.length(); i++) {
            let mark = marks.get(i);
            if (seen) {
                this.collected.push(new FileDiagnostic(this.filePath,
                    "'{name}' already has a visibility modifier; remove "
                    + "'{types.visibilityWord(mark.marked)}'.", mark.markSpan));
                continue;
            }
            seen = true;
            if (mark.marked == Visibility.Protected) {
                this.collected.push(new FileDiagnostic(this.filePath,
                    "'protected' is not allowed on a top-level declaration; it is only "
                    + "meaningful for class and struct members. Use 'public' to share "
                    + "'{name}' with the rest of the package, or leave it unmarked to keep it "
                    + "private to this file.", mark.markSpan));
            } else if (mark.marked == Visibility.Private) {
                this.collected.push(new FileDiagnostic(this.filePath,
                    "A top-level declaration is private to its file unless it is marked, so "
                    + "'private' is never written. Remove it from '{name}'.", mark.markSpan));
            } else {
                resolved = mark.marked;
            }
        }
        return resolved;
    }

    // An external type may be private (the default) or public; it can never be exported, and
    // 'protected' means nothing at the top level. A second visibility mark is redundant.
    resolveExternalTypeVisibility(ModifierSet modifiers, string name) -> Visibility {
        Visibility resolved = Visibility.Private;
        bool seen = false;
        let marks = modifiers.visibilityMarks;
        for (long i = 0; i < marks.length(); i++) {
            let mark = marks.get(i);
            if (seen) {
                this.collected.push(new FileDiagnostic(this.filePath,
                    "'{name}' already has a visibility modifier; remove "
                    + "'{types.visibilityWord(mark.marked)}'.", mark.markSpan));
                continue;
            }
            seen = true;
            switch (mark.marked) {
                Public -> {
                    resolved = Visibility.Public;
                },
                Private -> {
                    this.collected.push(new FileDiagnostic(this.filePath,
                        "An external type is private to its file unless it is marked, so "
                        + "'private' is never written. Remove it from '{name}'.", mark.markSpan));
                },
                Protected -> {
                    this.collected.push(new FileDiagnostic(this.filePath,
                        "An external type may be left unmarked or made 'public'; 'protected' is only "
                        + "meaningful for class and struct members. Mark '{name}' 'public' to "
                        + "share it across the package, or leave it unmarked.", mark.markSpan));
                },
                Export -> {
                    this.collected.push(new FileDiagnostic(this.filePath,
                        "An external type may be left unmarked or made 'public'; it can never be "
                        + "exported. Wrap '{name}' in an Ens type to share it beyond the package.",
                        mark.markSpan));
                },
            }
        }
        return resolved;
    }
}

class VisibilityMark {
    protected Visibility marked;
    protected Span markSpan;

    protected constructor(this.marked, this.markSpan);
}

// The modifiers of one top-level declaration, with each visibility keyword's span kept so the
// collector can diagnose 'protected' and conflicting marks at the keyword itself.
class ModifierSet {
    protected List<VisibilityMark> visibilityMarks;
    protected bool declaresAbstract;
    protected bool declaresFinal;
    protected bool declaresSealed;

    protected constructor() {
        this.visibilityMarks = new List<VisibilityMark>();
    }

    protected add(SyntaxKind kind, Span span) {
        switch (kind) {
            PrivateKeyword -> {
                this.visibilityMarks.push(new VisibilityMark(Visibility.Private, span));
            },
            ProtectedKeyword -> {
                this.visibilityMarks.push(new VisibilityMark(Visibility.Protected, span));
            },
            PublicKeyword -> {
                this.visibilityMarks.push(new VisibilityMark(Visibility.Public, span));
            },
            ExportKeyword -> {
                this.visibilityMarks.push(new VisibilityMark(Visibility.Export, span));
            },
            AbstractKeyword -> {
                this.declaresAbstract = true;
            },
            FinalKeyword -> {
                this.declaresFinal = true;
            },
            SealedKeyword -> {
                this.declaresSealed = true;
            },
            default -> { },
        }
    }
}

// Why a type declaration cannot carry a modifier, or null when it may. Every type takes
// visibility; a class adds 'abstract', 'final', and 'sealed'; everything else belongs to a
// member, a function, or a local declaration and is refused here by name.
typeModifierProblem(SyntaxKind kind, DeclaredKind declared) -> string? {
    switch (kind) {
        PublicKeyword, PrivateKeyword, ProtectedKeyword, ExportKeyword -> {
            return null;
        },
        AbstractKeyword -> {
            if (declared == DeclaredKind.Class) {
                return null;
            }
            return "'abstract' goes on a class or a method, where a subclass supplies what "
                + "is missing";
        },
        FinalKeyword -> {
            if (declared == DeclaredKind.Class) {
                return null;
            }
            return "'final' stops a method from being overridden or a class from being "
                + "extended";
        },
        SealedKeyword -> {
            if (declared == DeclaredKind.Class) {
                return null;
            }
            return "'sealed' goes on a class, where it means only the same module can "
                + "extend it";
        },
        WeakKeyword -> {
            return "'weak' goes on a class field that refers to an object without keeping it "
                + "alive, as in 'weak Parent? parent'";
        },
        ConstKeyword -> {
            return "'const' goes on a field or a variable inside a function, as in "
                + "'const string name;' or 'const limit = 10'";
        },
        StaticKeyword -> {
            return "'static' goes on a method or a 'const' field of a class or a struct, "
                + "where it makes the member belong to the type itself";
        },
        NoreturnKeyword -> {
            return "'noreturn' goes on a function or method that never finishes normally, "
                + "because it always throws or calls 'panic'";
        },
        OverrideKeyword -> {
            return "'override' is for a method that replaces one the type inherits";
        },
        default -> {
            return "no type declaration takes it";
        },
    }
}

typeParameterNames(TypeParameterListNode? list) -> string[] {
    if (list == null) {
        return [];
    }
    string[] names = new string[list.parametersCount()];
    for (long i = 0; i < names.length; i++) {
        names[i] = list.parameters(i).name().text();
    }
    return names;
}

pathText(ImportPathNode path) -> string {
    let builder = new StringBuilder();
    for (long i = 0; i < path.segmentsCount(); i++) {
        if (i > 0) {
            builder.append(".");
        }
        builder.append(path.segments(i).text());
    }
    return builder.toString();
}

