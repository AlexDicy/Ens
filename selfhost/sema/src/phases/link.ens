// The link phase registers every declared type in the store, then binds each module's imports
// into a per-module name table. Each stage completes for all modules before the next starts, so
// circular imports link cleanly.
import Module from program.graph;
import GraphResult from program.graph;
import UnloadedType from program.unloaded;
import UnloadedTypes from program.unloaded;
import program.unloaded;
import FileDeclarations from phases.declare;
import ImportRecord from phases.declare;
import phases.declare;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import program.implicit;
import model.typenames;
import TypeNames from model.typenames;
import TypeNameDirectory from model.typenames;
import TypeOffer from model.typenames;
import TypeCandidates from model.typenames;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import DeclaredType from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

public sealed abstract class NameBinding {
}

// A named import: the name refers to one public type of another module.
public class ImportedType extends NameBinding {
    DeclaredType boundType;

    protected constructor(DeclaredType target) {
        this.boundType = target;
    }

    public target() -> DeclaredType {
        return this.boundType;
    }
}

// A namespace import: the name qualifies accesses into another module.
public class ImportedNamespace extends NameBinding {
    string boundModulePath;
    string boundImportPath;

    protected constructor(string modulePath, string importPath) {
        this.boundModulePath = modulePath;
        this.boundImportPath = importPath;
    }

    public modulePath() -> string {
        return this.boundModulePath;
    }

    // The module as the import that binds this name writes it, which is how a diagnostic in
    // the file names the module.
    public importPath() -> string {
        return this.boundImportPath;
    }
}

// A named import the link phase refused, for a name the file does not declare itself. A use of
// the name that no implicitly imported module provides resolves to the error type, with no report
// of its own.
public class RefusedImport extends NameBinding {
    protected constructor();
}

public final class ModuleLinkTable {
    Module tableModule;
    Map<string, NameBinding> nameBindings;
    TypeNames tableNames;
    UnloadedScan unloadedScan;

    protected constructor(Module module, Map<string, NameBinding> bindings, TypeNames names,
                UnloadedScan unloadedScan) {
        this.tableModule = module;
        this.nameBindings = bindings;
        this.tableNames = names;
        this.unloadedScan = unloadedScan;
    }

    protected modulePath() -> string {
        return this.tableModule.canonicalPath();
    }

    public binding(string name) -> NameBinding? {
        return this.nameBindings.get(name);
    }

    // This table read backwards: the name this file has for each type it can name, which is how
    // every diagnostic reported in the file spells the types it names.
    public names() -> TypeNames {
        return this.tableNames;
    }

    // The types other modules declare under the name, loaded or not, that this file could import
    // or that their modules keep out of its reach, for a fix that names one of them.
    public typeCandidates(string name) -> TypeCandidates {
        return typeCandidates(name, this.tableModule, this.tableNames, this.unloadedScan);
    }

    bindingCount() -> long {
        return this.nameBindings.length();
    }
}

public class LinkResult {
    ModuleLinkTable[] linkTables;
    FileDiagnostic[] linkDiagnostics;
    Map<string, ModuleLinkTable> tablesByPath;
    TypeNameDirectory nameDirectory;

    protected constructor(ModuleLinkTable[] tables, FileDiagnostic[] diagnostics,
                TypeStore store) {
        this.linkTables = tables;
        this.linkDiagnostics = diagnostics;
        this.tablesByPath = new Map<string, ModuleLinkTable>();
        let names = new List<TypeNames>();
        for (let table in tables) {
            this.tablesByPath.set(table.modulePath(), table);
            names.push(table.names());
        }
        this.nameDirectory = new TypeNameDirectory(names.toArray(), store);
    }

    // One table per module, in the graph's module order.
    tables() -> ModuleLinkTable[] {
        return this.linkTables;
    }

    public tableFor(string modulePath) -> ModuleLinkTable? {
        return this.tablesByPath.get(modulePath);
    }

    // The names every linked file has for the program's types, for a diagnostic built where
    // the file it lands in is one of several.
    public namesByFile() -> TypeNameDirectory {
        return this.nameDirectory;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.linkDiagnostics;
    }
}

// The types of the modules the graph did not load, read when the first fix that offers an import
// needs them and kept for the rest of the analysis, because the scan parses every such file.
class UnloadedScan {
    GraphResult graph;
    UnloadedTypes? scanned;

    protected constructor(GraphResult graph) {
        this.graph = graph;
        this.scanned = null;
    }

    protected types() -> UnloadedTypes {
        let ready = this.scanned;
        if (ready == null) {
            ready = unloaded.scan(this.graph);
            this.scanned = ready;
        }
        return ready;
    }
}

// declarations aligns with the graph's modules by index.
public linkProgram(GraphResult graph, FileDeclarations[] declarations, TypeStore store)
        -> LinkResult {
    Module[] modules = graph.modules();
    if (modules.length != declarations.length) {
        panic("Internal: link needs one FileDeclarations per module, got {declarations.length} "
            + "for {modules.length} modules");
    }
    let declarationsByPath = new Map<string, FileDeclarations>();
    for (long i = 0; i < modules.length; i++) {
        declarationsByPath.set(modules[i].canonicalPath(), declarations[i]);
    }
    for (long i = 0; i < modules.length; i++) {
        registerModuleTypes(store, modules[i], declarations[i]);
    }
    let tables = new List<ModuleLinkTable>();
    let collected = new List<FileDiagnostic>();
    // One file can be loaded twice under two names while the standard library is itself the program
    // being built, so where a binding was declared is what distinguishes a second name for one declaration
    // apart from a second declaration.
    let boundPlaces = new Set<string>();
    for (long i = 0; i < modules.length; i++) {
        registerPrimitiveBindings(store, modules[i], declarations[i], collected, boundPlaces);
    }
    let unloadedScan = new UnloadedScan(graph);
    for (long i = 0; i < modules.length; i++) {
        tables.push(bindModuleImports(store, modules[i], declarations[i], declarationsByPath,
            collected, unloadedScan));
    }
    return new LinkResult(tables.toArray(), diagnostics.sorted(collected), store);
}

// Links each primitive binding to the primitive it names. A binding is a statement about a type
// the language owns, so only the standard library may write one, the name has to be a primitive
// that can carry members, and one primitive takes one binding program-wide.
registerPrimitiveBindings(TypeStore store, Module module, FileDeclarations declarations,
                                  List<FileDiagnostic> collected, Set<string> boundPlaces) {
    for (let declared in declarations.primitiveBindings()) {
        if (!implicit.isStandardLibrary(module.packageName())) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'primitive' declares the members of a built-in type, which only the standard "
                + "library may do; elsewhere it is an ordinary name. To add operations "
                + "to '{declared.name()}', write functions that take it, or a class or a "
                + "struct of your own.", declared.declarationSpan()));
            continue;
        }
        let primitive = types.primitiveNamed(store, declared.name());
        if (primitive == null) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' is not a primitive type, so it cannot carry a primitive "
                + "binding. A binding names one of 'bool', 'byte', 'short', 'ushort', 'int', "
                + "'uint', 'long', 'ulong', 'float', 'double', 'char' and 'string'. Declare "
                + "the members of '{declared.name()}' in '{declared.name()}' itself.",
                declared.nameSpan()));
            continue;
        }
        if (!isBindable(primitive)) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' cannot carry a primitive binding: "
                + unbindableReason(primitive), declared.nameSpan()));
            continue;
        }
        if (!boundPlaces.add("{module.filePath()}:{declared.declarationSpan().start}")) {
            continue;
        }
        let existing = types.bindingOf(primitive);
        if (existing != null) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' already has a primitive binding, declared "
                + "{bindingPlace(existing, module)}. One primitive takes one binding, so add the "
                + "members there instead.", declared.nameSpan()));
            continue;
        }
        let ignored = store.bindPrimitive(primitive, declared.name(), module.canonicalPath(),
            module.packagePrefix(), module.filePath(), declared.node());
    }
}

// 'void' is the absence of a value and 'decimal' has no usable type yet, so neither can carry
// members; every other primitive can.
isBindable(Type primitive) -> bool {
    return !types.isVoidType(primitive) && !types.isDecimalType(primitive);
}

unbindableReason(Type primitive) -> string {
    if (types.isVoidType(primitive)) {
        return "'void' is the absence of a value, so there is nothing for a member to run on.";
    }
    return "'decimal' is reserved for a decimal type the language does not have yet, so there "
        + "is nothing to declare members on.";
}

// Where the binding a second one collides with is declared, as the file 'module' reads it.
bindingPlace(DeclaredType existing, Module module) -> string {
    if (existing.modulePath() == module.canonicalPath()) {
        return "earlier in this file";
    }
    string path = types.importPathFrom(existing.modulePath(), existing.packagePrefix(),
        module.packagePrefix());
    return "in module '{diagnostics.sourceText(path)}'";
}

// Publishes each declared type's identity and metadata. The first declaration of a name wins;
// later duplicates were already diagnosed by the declare phase.
registerModuleTypes(TypeStore store, Module module, FileDeclarations declarations) {
    for (let declared in declarations.types()) {
        if (store.hasDeclared(module.canonicalPath(), declared.name())) {
            continue;
        }
        switch (declared.kind()) {
            Class -> {
                let added = store.addClass(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters(), declared.isAbstract(),
                    declared.isFinal(), declared.isSealed());
                if (declared.isShared()) {
                    added.markShared();
                }
            },
            Interface -> {
                let added = store.addInterface(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
                if (declared.isShared()) {
                    added.markShared();
                }
            },
            Struct -> {
                store.addStruct(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
            },
            Enum -> {
                store.addEnum(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
            },
            External -> {
                let added = store.addExternal(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
                if (declared.isShared()) {
                    added.markShared();
                }
            },
        }
    }
}

// Binds one module's imports. Named imports that do not resolve to a type are held back and
// diagnosed in a second sweep, so a name bound as a type by any import of the file silences the
// failures of its other imports, exactly as signature resolution will read it.
bindModuleImports(TypeStore store, Module module, FileDeclarations declarations,
                          Map<string, FileDeclarations> declarationsByPath,
                          List<FileDiagnostic> collected, UnloadedScan unloadedScan)
        -> ModuleLinkTable {
    ImportRecord[] records = declarations.imports();
    string?[] targets = module.importTargets();
    if (records.length != targets.length) {
        panic("Internal: module '{module.canonicalPath()}' has {targets.length} import targets "
            + "for {records.length} import records");
    }
    let bindings = new Map<string, NameBinding>();
    let refused = new List<string>();
    bool[] held = new bool[records.length];
    for (long i = 0; i < records.length; i++) {
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (!record.isNamed()) {
            bindNamespace(module, record, target, declarations, bindings, collected);
            continue;
        }
        let found = store.findDeclared(target, record.name());
        if (found == null) {
            held[i] = true;
            continue;
        }
        if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
                module.canonicalPath(), module.packagePrefix())) {
            report(collected, module, record, types.notVisibleMessage("Type", record.name(),
                found.visibility(), found.modulePath(), found.packagePrefix(),
                module.packagePrefix(), found.isEditable()));
            refused.push(record.boundName());
            continue;
        }
        if (reportShadowedImport(module, record, declarations, collected)) {
            continue;
        }
        if (bindings.contains(record.boundName())) {
            reportAt(collected, module, record.boundNameSpan(), repeatedImportMessage(record));
            continue;
        }
        bindings.set(record.boundName(), new ImportedType(found));
    }
    let names = moduleNames(store, module, records, bindings);
    for (long i = 0; i < records.length; i++) {
        if (!held[i]) {
            continue;
        }
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (bindings.get(record.boundName()) is ImportedType) {
            continue;
        }
        let targetDeclarations = declarationsByPath.get(target);
        if (targetDeclarations == null) {
            continue;
        }
        if (targetDeclarations.hasFunctionNamed(record.name())) {
            report(collected, module, record, "Only a type can be imported by name, and "
                + "'{record.name()}' is a function. Write 'import {record.importPath()};' and call "
                + "it as '{record.namespaceName()}.{record.name()}(...)'.");
        } else {
            report(collected, module, record, missingTypeMessage(record, module, names,
                unloadedScan));
        }
        refused.push(record.boundName());
    }
    for (let name in refused) {
        if (!bindings.contains(name) && declarations.typeNamed(name) == null
                && !declarations.hasFunctionNamed(name)) {
            bindings.set(name, new RefusedImport());
        }
    }
    return new ModuleLinkTable(module, bindings, names, unloadedScan);
}

// One module's imports read backwards: the name its file has for each type an import binds, and
// the names its imports take. Import order decides, so a file that binds one type twice reads
// with the first of those imports.
moduleNames(TypeStore store, Module module, ImportRecord[] records,
            Map<string, NameBinding> bindings) -> TypeNames {
    let importedNames = new Map<DeclaredType, string>();
    let importedTypeNames = new Set<string>();
    let importedModuleNames = new Set<string>();
    for (let record in records) {
        string name = record.boundName();
        let binding = bindings.get(name);
        if (binding is ImportedType) {
            let ignored = importedTypeNames.add(name);
            if (!importedNames.contains(binding.target())) {
                importedNames.set(binding.target(), name);
            }
        } else if (binding is ImportedNamespace) {
            let ignored = importedModuleNames.add(name);
        }
    }
    return new TypeNames(module.filePath(), module.canonicalPath(), module.packagePrefix(), store,
        implicit.implicitImportPaths(), importedNames, importedTypeNames, importedModuleNames);
}

bindNamespace(Module module, ImportRecord record, string target, FileDeclarations declarations,
                      Map<string, NameBinding> bindings, List<FileDiagnostic> collected) {
    string name = record.boundName();
    if (name.length == 0) {
        return;
    }
    if (reportShadowedImport(module, record, declarations, collected)) {
        return;
    }
    if (bindings.contains(name)) {
        reportAt(collected, module, record.boundNameSpan(), repeatedImportMessage(record));
        return;
    }
    bindings.set(name, new ImportedNamespace(target, record.importPath()));
}

// A name the file declares as a type is not shadowed by an import of the same name. The import
// binds nothing then, so the declaration keeps the name and only the import can move. Returns
// whether the name was reported as shadowed.
reportShadowedImport(Module module, ImportRecord record, FileDeclarations declarations,
                     List<FileDiagnostic> collected) -> bool {
    let shadowed = declarations.typeNamed(record.boundName());
    if (shadowed == null) {
        return false;
    }
    reportAt(collected, module, record.boundNameSpan(), "'{record.boundName()}' is imported, and "
        + "this file also declares {declare.kindPhrase(shadowed.kind())} named "
        + "'{record.boundName()}'. Bind the import to another name, as in "
        + "'{aliasedImport(record)}'.");
    return true;
}

// The refusal of an import whose name an earlier import of the file already binds.
repeatedImportMessage(ImportRecord record) -> string {
    string path = record.importPath();
    string renamed = "import {path} as {record.boundName()}Module;";
    if (record.isNamed()) {
        renamed = "import {record.name()} as Other{record.boundName()} from {path};";
    }
    return "'{record.boundName()}' is already imported earlier in this file. Remove this import, "
        + "or give it another name with 'as', as in '{renamed}'.";
}

// The refusal of a named import whose module declares no type under the name: the import to
// write where another module this file may name declares one, loaded or not, the import to
// remove where the name needs none, or why the modules that do declare one keep it out of this
// file's reach.
missingTypeMessage(ImportRecord record, Module module, TypeNames names,
                   UnloadedScan unloadedScan) -> string {
    string name = record.name();
    string refusal = "Module '{diagnostics.sourceText(record.importPath())}' has no type named "
        + "'{name}'.";
    if (record.boundName() == name && names.implicitlyImportedType(name) != null) {
        return "{refusal} '{name}' is available in every file without an import, so remove this "
            + "import.";
    }
    let candidates = typeCandidates(name, module, names, unloadedScan);
    if (candidates.importable().length > 0) {
        let imports = new List<string>();
        for (let offer in candidates.importable()) {
            imports.push("'{namedImport(record, offer.path())}'");
        }
        return "{refusal} Write {diagnostics.andJoined(imports.toArray(), "or")} instead.";
    }
    if (candidates.hidden().length == 0) {
        return "{refusal} Check the spelling, or import '{name}' from the module that declares it.";
    }
    string explained = typenames.hiddenTypesMessage(candidates.hidden(),
        (offer) -> namedImport(record, offer.path()), (offer) -> null);
    return "{refusal} {explained}";
}

// The types the modules other than 'module' declare under 'name', loaded or not, that a file of
// 'module' could import or that their modules keep out of its reach. Only the packages 'module'
// may import from are read.
typeCandidates(string name, Module module, TypeNames names, UnloadedScan unloadedScan)
        -> TypeCandidates {
    let scanned = unloadedScan.types();
    let importable = new List<TypeOffer>();
    for (let declared in names.importableTypesNamed(name)) {
        if (scanned.mayImport(module, declared.packagePrefix())) {
            importable.push(typenames.offerOf(declared, names));
        }
    }
    for (let found in scanned.importableNamed(name, module)) {
        importable.push(unloadedOffer(found, names));
    }
    let hidden = new List<TypeOffer>();
    for (let declared in names.unreachableTypesNamed(name)) {
        if (scanned.mayImport(module, declared.packagePrefix())) {
            hidden.push(typenames.offerOf(declared, names));
        }
    }
    for (let found in scanned.hiddenNamed(name, module)) {
        hidden.push(unloadedOffer(found, names));
    }
    importable.sort((a, b) -> a.path().compareTo(b.path()));
    hidden.sort((a, b) -> a.path().compareTo(b.path()));
    return new TypeCandidates(importable.toArray(), hidden.toArray());
}

unloadedOffer(UnloadedType found, TypeNames names) -> TypeOffer {
    return new TypeOffer(names.importPathTo(found.modulePath, found.packagePrefix), found.name,
        found.modulePath, found.packagePrefix, found.visibility, found.editable,
        names.isOwnPackage(found.packagePrefix), null);
}

// This named import written against another module path, keeping the name it binds.
namedImport(ImportRecord record, string path) -> string {
    if (record.boundName() == record.name()) {
        return "import {record.name()} from {path};";
    }
    return "import {record.name()} as {record.boundName()} from {path};";
}

// The same import written under another name. For a type the new name is the colliding one with
// 'Lib' in front. For a module it is the colliding one with 'Module' after.
aliasedImport(ImportRecord record) -> string {
    string path = record.importPath();
    if (record.isNamed()) {
        return "import {record.name()} as Lib{record.boundName()} from {path};";
    }
    return "import {path} as {record.boundName()}Module;";
}

report(List<FileDiagnostic> collected, Module module, ImportRecord record, string message) {
    reportAt(collected, module, record.span(), message);
}

reportAt(List<FileDiagnostic> collected, Module module, Span span, string message) {
    collected.push(new FileDiagnostic(module.filePath(), message, span));
}
