// The link phase: registers every declared type in the store, then binds each module's imports
// into a per-module name table. Each stage completes for all modules before the next starts, so
// circular imports link cleanly. The output table is what signature resolution needs to see the
// names a file imported.
import Module from program.graph;
import FileDeclarations from phases.declare;
import ImportRecord from phases.declare;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import model.types;
import TypeStore from model.types;
import DeclaredType from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

public sealed abstract class NameBinding {
}

// A named import: the name refers to one public type of another module.
public class ImportedType extends NameBinding {
    DeclaredType boundType;

    protected constructor(DeclaredType target) {
        this.boundType = target;
    }

    public target() -> DeclaredType {
        return this.boundType;
    }
}

// A namespace import: the name qualifies accesses into another module.
public class ImportedNamespace extends NameBinding {
    string boundModulePath;

    protected constructor(string modulePath) {
        this.boundModulePath = modulePath;
    }

    public modulePath() -> string {
        return this.boundModulePath;
    }
}

public class ModuleLinkTable {
    string tableModulePath;
    Map<string, NameBinding> nameBindings;

    protected constructor(string modulePath, Map<string, NameBinding> bindings) {
        this.tableModulePath = modulePath;
        this.nameBindings = bindings;
    }

    protected modulePath() -> string {
        return this.tableModulePath;
    }

    public binding(string name) -> NameBinding? {
        return this.nameBindings.get(name);
    }

    bindingCount() -> long {
        return this.nameBindings.length();
    }
}

public class LinkResult {
    ModuleLinkTable[] linkTables;
    FileDiagnostic[] linkDiagnostics;
    Map<string, ModuleLinkTable> tablesByPath;

    protected constructor(ModuleLinkTable[] tables, FileDiagnostic[] diagnostics) {
        this.linkTables = tables;
        this.linkDiagnostics = diagnostics;
        this.tablesByPath = new Map<string, ModuleLinkTable>();
        for (let table in tables) {
            this.tablesByPath.set(table.modulePath(), table);
        }
    }

    // One table per module, in the graph's module order.
    tables() -> ModuleLinkTable[] {
        return this.linkTables;
    }

    public tableFor(string modulePath) -> ModuleLinkTable? {
        return this.tablesByPath.get(modulePath);
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.linkDiagnostics;
    }
}

// Links the whole program. declarations aligns with modules by index.
public linkProgram(Module[] modules, FileDeclarations[] declarations, TypeStore store)
        -> LinkResult {
    if (modules.length != declarations.length) {
        panic("Internal: link needs one FileDeclarations per module, got {declarations.length} "
            + "for {modules.length} modules");
    }
    let declarationsByPath = new Map<string, FileDeclarations>();
    for (long i = 0; i < modules.length; i++) {
        declarationsByPath.set(modules[i].canonicalPath(), declarations[i]);
    }
    for (long i = 0; i < modules.length; i++) {
        registerModuleTypes(store, modules[i], declarations[i]);
    }
    let tables = new List<ModuleLinkTable>();
    let collected = new List<FileDiagnostic>();
    for (long i = 0; i < modules.length; i++) {
        tables.push(bindModuleImports(store, modules[i], declarations[i], declarationsByPath,
            collected));
    }
    return new LinkResult(tables.toArray(), diagnostics.sorted(collected));
}

// Publishes each declared type's identity and metadata. The first declaration of a name wins;
// later duplicates were already diagnosed by the declare phase.
registerModuleTypes(TypeStore store, Module module, FileDeclarations declarations) {
    for (let declared in declarations.types()) {
        if (store.hasDeclared(module.canonicalPath(), declared.name())) {
            continue;
        }
        switch (declared.kind()) {
            Class -> {
                store.addClass(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters(), declared.isAbstract(),
                    declared.isFinal(), declared.isSealed());
            },
            Interface -> {
                store.addInterface(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
            },
            Struct -> {
                store.addStruct(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
            },
            Enum -> {
                store.addEnum(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
            },
            External -> {
                store.addExternal(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
            },
        }
    }
}

// Binds one module's imports. Named imports that do not resolve to a type are held back and
// diagnosed in a second sweep, so a name bound as a type by any import of the file silences the
// failures of its other imports, exactly as signature resolution will see it.
bindModuleImports(TypeStore store, Module module, FileDeclarations declarations,
                          Map<string, FileDeclarations> declarationsByPath,
                          List<FileDiagnostic> collected) -> ModuleLinkTable {
    ImportRecord[] records = declarations.imports();
    string?[] targets = module.importTargets();
    if (records.length != targets.length) {
        panic("Internal: module '{module.canonicalPath()}' has {targets.length} import targets "
            + "for {records.length} import records");
    }
    let bindings = new Map<string, NameBinding>();
    bool[] held = new bool[records.length];
    for (long i = 0; i < records.length; i++) {
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (!record.isNamed()) {
            bindNamespace(module, record, target, bindings, collected);
            continue;
        }
        let found = store.findDeclared(target, record.name());
        if (found == null) {
            held[i] = true;
            continue;
        }
        if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
                module.canonicalPath(), module.packagePrefix())) {
            report(collected, module, record, types.notVisibleMessage("Type", record.name(),
                found.visibility(), found.modulePath(), found.packagePrefix(),
                module.packagePrefix()));
            continue;
        }
        if (bindings.contains(record.name())) {
            report(collected, module, record, "Imported name '{record.name()}' conflicts with "
                + "an earlier import in this file.");
            continue;
        }
        bindings.set(record.name(), new ImportedType(found));
    }
    for (long i = 0; i < records.length; i++) {
        if (!held[i]) {
            continue;
        }
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (bindings.get(record.name()) is ImportedType) {
            continue;
        }
        let targetDeclarations = declarationsByPath.get(target);
        if (targetDeclarations == null) {
            continue;
        }
        if (targetDeclarations.hasFunctionNamed(record.name())) {
            string moduleImport = record.pathText();
            if (record.isPackage()) {
                moduleImport = "@" + moduleImport;
            }
            report(collected, module, record, "Function '{record.name()}' cannot be imported by "
                + "name. Import the module instead: 'import {moduleImport};' then call it as "
                + "'{record.namespaceName()}.{record.name()}'.");
        } else {
            report(collected, module, record,
                "Module '{target}' has no type named '{record.name()}'.");
        }
    }
    return new ModuleLinkTable(module.canonicalPath(), bindings);
}

bindNamespace(Module module, ImportRecord record, string target,
                      Map<string, NameBinding> bindings, List<FileDiagnostic> collected) {
    string name = record.namespaceName();
    if (name.length == 0) {
        return;
    }
    if (bindings.contains(name)) {
        report(collected, module, record,
            "Namespace alias '{name}' conflicts with an earlier import in this file.");
        return;
    }
    bindings.set(name, new ImportedNamespace(target));
}

report(List<FileDiagnostic> collected, Module module, ImportRecord record,
               string message) {
    collected.push(new FileDiagnostic(module.filePath(), message, record.span()));
}
