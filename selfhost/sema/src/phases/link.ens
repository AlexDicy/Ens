// The link phase registers every declared type in the store, then binds each module's imports
// into a per-module name table. Each stage completes for all modules before the next starts, so
// circular imports link cleanly.
import Module from program.graph;
import FileDeclarations from phases.declare;
import ImportRecord from phases.declare;
import phases.declare;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import program.implicit;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import TypeNames from model.types;
import TypeNameDirectory from model.types;
import DeclaredType from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

public sealed abstract class NameBinding {
}

// A named import: the name refers to one public type of another module.
public class ImportedType extends NameBinding {
    DeclaredType boundType;

    protected constructor(DeclaredType target) {
        this.boundType = target;
    }

    public target() -> DeclaredType {
        return this.boundType;
    }
}

// A namespace import: the name qualifies accesses into another module.
public class ImportedNamespace extends NameBinding {
    string boundModulePath;

    protected constructor(string modulePath) {
        this.boundModulePath = modulePath;
    }

    public modulePath() -> string {
        return this.boundModulePath;
    }
}

public class ModuleLinkTable {
    string tableModulePath;
    Map<string, NameBinding> nameBindings;
    TypeNames tableNames;

    protected constructor(string modulePath, Map<string, NameBinding> bindings, TypeNames names) {
        this.tableModulePath = modulePath;
        this.nameBindings = bindings;
        this.tableNames = names;
    }

    protected modulePath() -> string {
        return this.tableModulePath;
    }

    public binding(string name) -> NameBinding? {
        return this.nameBindings.get(name);
    }

    // This table read backwards: the name this file has for each type it can name, which is how
    // every diagnostic reported in the file spells the types it names.
    public names() -> TypeNames {
        return this.tableNames;
    }

    bindingCount() -> long {
        return this.nameBindings.length();
    }
}

public class LinkResult {
    ModuleLinkTable[] linkTables;
    FileDiagnostic[] linkDiagnostics;
    Map<string, ModuleLinkTable> tablesByPath;
    TypeNameDirectory nameDirectory;

    protected constructor(ModuleLinkTable[] tables, FileDiagnostic[] diagnostics,
                TypeStore store) {
        this.linkTables = tables;
        this.linkDiagnostics = diagnostics;
        this.tablesByPath = new Map<string, ModuleLinkTable>();
        let names = new List<TypeNames>();
        for (let table in tables) {
            this.tablesByPath.set(table.modulePath(), table);
            names.push(table.names());
        }
        this.nameDirectory = new TypeNameDirectory(names.toArray(), store);
    }

    // One table per module, in the graph's module order.
    tables() -> ModuleLinkTable[] {
        return this.linkTables;
    }

    public tableFor(string modulePath) -> ModuleLinkTable? {
        return this.tablesByPath.get(modulePath);
    }

    // The names every linked file has for the program's types, for a diagnostic built where
    // the file it lands in is one of several.
    public namesByFile() -> TypeNameDirectory {
        return this.nameDirectory;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.linkDiagnostics;
    }
}

// declarations aligns with modules by index.
public linkProgram(Module[] modules, FileDeclarations[] declarations, TypeStore store)
        -> LinkResult {
    if (modules.length != declarations.length) {
        panic("Internal: link needs one FileDeclarations per module, got {declarations.length} "
            + "for {modules.length} modules");
    }
    let declarationsByPath = new Map<string, FileDeclarations>();
    for (long i = 0; i < modules.length; i++) {
        declarationsByPath.set(modules[i].canonicalPath(), declarations[i]);
    }
    for (long i = 0; i < modules.length; i++) {
        registerModuleTypes(store, modules[i], declarations[i]);
    }
    let tables = new List<ModuleLinkTable>();
    let collected = new List<FileDiagnostic>();
    // One file can arrive twice under two names while the standard library is itself the program
    // being built, so where a binding was declared is what tells a second name for one declaration
    // apart from a second declaration.
    let boundPlaces = new Set<string>();
    for (long i = 0; i < modules.length; i++) {
        registerPrimitiveBindings(store, modules[i], declarations[i], collected, boundPlaces);
    }
    for (long i = 0; i < modules.length; i++) {
        tables.push(bindModuleImports(store, modules[i], declarations[i], declarationsByPath,
            collected));
    }
    return new LinkResult(tables.toArray(), diagnostics.sorted(collected), store);
}

// Links each primitive binding to the primitive it names. A binding is a statement about a type
// the language owns, so only the standard library may write one, the name has to be a primitive
// that can carry members, and one primitive takes one binding program-wide.
registerPrimitiveBindings(TypeStore store, Module module, FileDeclarations declarations,
                                  List<FileDiagnostic> collected, Set<string> boundPlaces) {
    for (let declared in declarations.primitiveBindings()) {
        if (!implicit.isStandardLibrary(module.packageName())) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'primitive' declares what the members of a built-in type are, which only the "
                + "standard library may do. Elsewhere 'primitive' is an ordinary identifier. To "
                + "add operations to '{declared.name()}', write functions that take it, or a "
                + "class or struct of your own.", declared.declarationSpan()));
            continue;
        }
        let primitive = types.primitiveNamed(store, declared.name());
        if (primitive == null) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' is not a primitive type, so it cannot carry a primitive "
                + "binding. A binding names one of 'bool', 'byte', 'short', 'ushort', 'int', "
                + "'uint', 'long', 'ulong', 'float', 'double', 'char', and 'string'; a type "
                + "declared in Ens carries its members in its own declaration.",
                declared.nameSpan()));
            continue;
        }
        if (!isBindable(primitive)) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' cannot carry a primitive binding: "
                + unbindableReason(primitive), declared.nameSpan()));
            continue;
        }
        if (!boundPlaces.add("{module.filePath()}:{declared.declarationSpan().start}")) {
            continue;
        }
        let existing = types.bindingOf(primitive);
        if (existing != null) {
            collected.push(new FileDiagnostic(module.filePath(),
                "'{declared.name()}' already has a primitive binding, declared in module "
                + "'{existing.modulePath()}'. One primitive takes one binding, so its members "
                + "read in one place; add the members there instead.", declared.nameSpan()));
            continue;
        }
        let ignored = store.bindPrimitive(primitive, declared.name(), module.canonicalPath(),
            module.packagePrefix(), module.filePath(), declared.node());
    }
}

// 'void' is the absence of a value and 'decimal' has no usable type yet, so neither can carry
// members; every other primitive can.
isBindable(Type primitive) -> bool {
    return !types.isVoidType(primitive) && !types.isDecimalType(primitive);
}

unbindableReason(Type primitive) -> string {
    if (types.isVoidType(primitive)) {
        return "'void' is the absence of a value, so there is nothing for a member to run on.";
    }
    return "'decimal' is reserved for a decimal type the language does not have yet, so there "
        + "is nothing to declare members on.";
}

// Publishes each declared type's identity and metadata. The first declaration of a name wins;
// later duplicates were already diagnosed by the declare phase.
registerModuleTypes(TypeStore store, Module module, FileDeclarations declarations) {
    for (let declared in declarations.types()) {
        if (store.hasDeclared(module.canonicalPath(), declared.name())) {
            continue;
        }
        switch (declared.kind()) {
            Class -> {
                store.addClass(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters(), declared.isAbstract(),
                    declared.isFinal(), declared.isSealed());
            },
            Interface -> {
                store.addInterface(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
            },
            Struct -> {
                store.addStruct(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility(), declared.typeParameters());
            },
            Enum -> {
                store.addEnum(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
            },
            External -> {
                store.addExternal(declared.name(), module.canonicalPath(),
                    module.packagePrefix(), module.filePath(), declared.node(),
                    declared.visibility());
            },
        }
    }
}

// Binds one module's imports. Named imports that do not resolve to a type are held back and
// diagnosed in a second sweep, so a name bound as a type by any import of the file silences the
// failures of its other imports, exactly as signature resolution will see it.
bindModuleImports(TypeStore store, Module module, FileDeclarations declarations,
                          Map<string, FileDeclarations> declarationsByPath,
                          List<FileDiagnostic> collected) -> ModuleLinkTable {
    ImportRecord[] records = declarations.imports();
    string?[] targets = module.importTargets();
    if (records.length != targets.length) {
        panic("Internal: module '{module.canonicalPath()}' has {targets.length} import targets "
            + "for {records.length} import records");
    }
    let bindings = new Map<string, NameBinding>();
    bool[] held = new bool[records.length];
    for (long i = 0; i < records.length; i++) {
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (!record.isNamed()) {
            bindNamespace(module, record, target, declarations, bindings, collected);
            continue;
        }
        let found = store.findDeclared(target, record.name());
        if (found == null) {
            held[i] = true;
            continue;
        }
        if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
                module.canonicalPath(), module.packagePrefix())) {
            report(collected, module, record, types.notVisibleMessage("Type", record.name(),
                found.visibility(), found.modulePath(), found.packagePrefix(),
                module.packagePrefix()));
            continue;
        }
        if (refuseShadowedImport(module, record, declarations, "Imported name", collected)) {
            continue;
        }
        if (bindings.contains(record.boundName())) {
            reportAt(collected, module, record.boundNameSpan(), "Imported name "
                + "'{record.boundName()}' conflicts with an earlier import in this file.");
            continue;
        }
        bindings.set(record.boundName(), new ImportedType(found));
    }
    for (long i = 0; i < records.length; i++) {
        if (!held[i]) {
            continue;
        }
        let target = targets[i];
        if (target == null) {
            continue;
        }
        let record = records[i];
        if (bindings.get(record.boundName()) is ImportedType) {
            continue;
        }
        let targetDeclarations = declarationsByPath.get(target);
        if (targetDeclarations == null) {
            continue;
        }
        if (targetDeclarations.hasFunctionNamed(record.name())) {
            string moduleImport = record.pathText();
            if (record.isPackage()) {
                moduleImport = "@" + moduleImport;
            }
            report(collected, module, record, "Function '{record.name()}' cannot be imported by "
                + "name. Import the module instead: 'import {moduleImport};' then call it as "
                + "'{record.namespaceName()}.{record.name()}'.");
        } else {
            report(collected, module, record,
                "Module '{target}' has no type named '{record.name()}'.");
        }
    }
    return new ModuleLinkTable(module.canonicalPath(), bindings,
        moduleNames(store, module, records, bindings));
}

// One module's imports read backwards: the name its file has for each type an import binds, and
// the alias each imported module is qualified with. Import order decides, so a file that binds one
// type or one module twice reads with the first of those imports.
moduleNames(TypeStore store, Module module, ImportRecord[] records,
            Map<string, NameBinding> bindings) -> TypeNames {
    let importedNames = new Map<DeclaredType, string>();
    let namespaceAliases = new Map<string, string>();
    let importedTypeNames = new Set<string>();
    for (let record in records) {
        string name = record.boundName();
        let binding = bindings.get(name);
        if (binding is ImportedType) {
            let ignored = importedTypeNames.add(name);
            if (!importedNames.contains(binding.target())) {
                importedNames.set(binding.target(), name);
            }
        } else if (binding is ImportedNamespace) {
            if (!namespaceAliases.contains(binding.modulePath())) {
                namespaceAliases.set(binding.modulePath(), name);
            }
        }
    }
    return new TypeNames(module.filePath(), module.canonicalPath(), module.packagePrefix(), store,
        implicit.implicitImportPaths(), importedNames, namespaceAliases, importedTypeNames);
}

bindNamespace(Module module, ImportRecord record, string target, FileDeclarations declarations,
                      Map<string, NameBinding> bindings, List<FileDiagnostic> collected) {
    string name = record.boundName();
    if (name.length == 0) {
        return;
    }
    if (refuseShadowedImport(module, record, declarations, "Imported module name", collected)) {
        return;
    }
    if (bindings.contains(name)) {
        reportAt(collected, module, record.boundNameSpan(),
            "Namespace alias '{name}' conflicts with an earlier import in this file.");
        return;
    }
    bindings.set(name, new ImportedNamespace(target));
}

// A name the file declares as a type is not shadowed by an import of the same name. The import
// binds nothing then, so the declaration keeps the name and only the import can move. Answers
// whether it refused, and 'nameKind' is what the import's own name is called in the sentence.
refuseShadowedImport(Module module, ImportRecord record, FileDeclarations declarations,
                     string nameKind, List<FileDiagnostic> collected) -> bool {
    let shadowed = declarations.typeNamed(record.boundName());
    if (shadowed == null) {
        return false;
    }
    reportAt(collected, module, record.boundNameSpan(), "{nameKind} '{record.boundName()}' is "
        + "already declared as {declare.kindPhrase(shadowed.kind())} in this file; bind the "
        + "import to another name, as in '{aliasedImport(record)}'.");
    return true;
}

// The same import written under another name. For a type the new name is the colliding one with
// 'Lib' in front. For a module it is the colliding one with 'Module' after.
aliasedImport(ImportRecord record) -> string {
    string path = record.pathText();
    if (record.isPackage()) {
        path = "@" + path;
    }
    if (record.isNamed()) {
        return "import {record.name()} as Lib{record.boundName()} from {path};";
    }
    return "import {path} as {record.boundName()}Module;";
}

report(List<FileDiagnostic> collected, Module module, ImportRecord record, string message) {
    reportAt(collected, module, record.span(), message);
}

reportAt(List<FileDiagnostic> collected, Module module, Span span, string message) {
    collected.push(new FileDiagnostic(module.filePath(), message, span));
}
