// Whole-program class layout. Inheritance cycles are broken first, then every class lays out in
// base-before-derived order: inherited fields flatten in, own fields and methods resolve, and
// the override, interface, abstract, and hash/equals rules are checked. A generic base fills on
// demand - its template lays out earlier by depth order - so every base chain the checks walk
// is complete.
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import ClassItem from context;
import phases.members;
import MemberModifiers from phases.members;
import TypeResolver from phases.resolve;
import model.convert;
import model.types;
import Type from model.types;
import ClassType from model.types;
import InstantiationType from model.types;
import OptionalType from model.types;
import Field from model.types;
import Method from model.types;
import MemberConstraint from model.types;
import Signature from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Lays out every class in the program. items arrive in (module, source) order.
public layoutProgram(List<ClassItem> items) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    breakInheritanceCycles(items, collected);
    let ordered = sortedByBaseDepth(items);
    for (long i = 0; i < ordered.length(); i++) {
        let worker = new ClassLayout(ordered.get(i), collected);
        worker.run();
    }
    return diagnostics.sorted(collected);
}

// A class whose base chain reaches back to itself cannot be laid out; the first class found on
// a cycle is diagnosed and its base link cleared, which dissolves the cycle for the rest.
breakInheritanceCycles(List<ClassItem> items, List<FileDiagnostic> collected) {
    for (long i = 0; i < items.length(); i++) {
        let item = items.get(i);
        let classType = item.classType();
        let seen = new Set<ClassType>();
        ClassType? current = classType;
        bool cycle = false;
        while (current != null) {
            if (!seen.add(current)) {
                cycle = true;
                break;
            }
            current = baseAuthority(current);
        }
        if (!cycle) {
            continue;
        }
        collected.push(new FileDiagnostic(item.context().module().filePath(),
            "Class '{classType.name()}' eventually extends itself through its base classes. "
            + "A class cannot inherit from itself, directly or indirectly.",
            item.declaration().name().span()));
        let base = classType.base();
        if (base != null) {
            let authority = types.authorityOf(base);
            if (authority is ClassType) {
                authority.removeDirectSubclass(classType);
            }
        }
        classType.clearBase();
    }
}

// The class the base link continues through: a generic base defers to its template.
baseAuthority(ClassType classType) -> ClassType? {
    let base = classType.base();
    if (base == null) {
        return null;
    }
    let authority = types.authorityOf(base);
    if (authority is ClassType) {
        return authority;
    }
    return null;
}

baseDepth(ClassType classType) -> long {
    long depth = 0;
    let seen = new Set<ClassType>();
    ClassType? current = baseAuthority(classType);
    while (current != null && seen.add(current)) {
        depth++;
        current = baseAuthority(current);
    }
    return depth;
}

// Stable insertion sort: equal depths keep (module, source) order.
sortedByBaseDepth(List<ClassItem> items) -> List<ClassItem> {
    let ordered = new List<ClassItem>();
    let depths = new List<long>();
    for (long i = 0; i < items.length(); i++) {
        ordered.push(items.get(i));
        depths.push(baseDepth(items.get(i).classType()));
        long at = ordered.length() - 1;
        while (at > 0 && depths.get(at - 1) > depths.get(at)) {
            let movedItem = ordered.get(at - 1);
            ordered.set(at - 1, ordered.get(at));
            ordered.set(at, movedItem);
            long movedDepth = depths.get(at - 1);
            depths.set(at - 1, depths.get(at));
            depths.set(at, movedDepth);
            at--;
        }
    }
    return ordered;
}

class ClassLayout {
    ClassItem item;
    ClassType classType;
    ClassDeclarationNode node;
    TypeResolver resolver;
    Reporter reporter;

    protected constructor(ClassItem item, List<FileDiagnostic> collected) {
        this.item = item;
        this.classType = item.classType();
        this.node = item.declaration();
        this.resolver = item.context().resolver();
        this.reporter = new Reporter(item.context().module().filePath(), collected);
    }

    protected run() {
        let parameters = this.classType.typeParameterTypes();
        this.resolver.pushTypeParameters(parameters);
        this.flattenInheritedFields();
        this.collectOwnFields();
        this.collectMethods();
        this.classType.setMembersComplete();
        members.checkHashEqualsPairing(this.reporter, this.classType, this.node.name().span());
        this.checkInterfaceSatisfaction();
        this.checkAbstractSatisfied();
        this.resolver.popTypeParameters(parameters.length);
        for (let diagnostic in this.resolver.takeDiagnostics()) {
            this.reporter.report(diagnostic.message(), diagnostic.span());
        }
    }

    flattenInheritedFields() {
        let base = this.classType.base();
        if (base == null) {
            return;
        }
        if (base is InstantiationType) {
            this.resolver.typeStore().ensureFilled(base);
        }
        let inherited = types.fieldsOf(base);
        if (inherited == null) {
            return;
        }
        for (long i = 0; i < inherited.length(); i++) {
            this.classType.fields().push(inherited.get(i));
        }
        this.classType.setBaseFieldCount(inherited.length());
    }

    collectOwnFields() {
        let body = this.node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode) {
                this.collectOwnField(member);
            }
        }
    }

    collectOwnField(FieldDeclarationNode declaration) {
        let field = members.readField(this.resolver, this.reporter, declaration, this.classType,
            Visibility.Private);
        if (field.isStatic()) {
            this.collectStaticField(declaration, field);
            return;
        }
        if (field.isWeak() && field.isConst()) {
            this.reporter.report("Field '{field.name()}' cannot be both 'weak' and 'const': a "
                + "'const' field keeps one value for the object's whole life, while a 'weak' "
                + "field becomes null when the object it refers to is destroyed. Remove one of "
                + "the two.", field.nameSpan());
        } else if (field.isWeak()) {
            this.checkWeakField(field);
        }
        if (field.name().length > 0) {
            let existing = this.inheritedOrOwnField(field.name());
            if (existing != null) {
                if (existing.definingType() != this.classType) {
                    this.reporter.report("Field '{field.name()}' is already declared in base "
                        + "class '{types.display(existing.definingType())}'.", field.nameSpan());
                } else {
                    this.reporter.report("Field '{field.name()}' is already declared in "
                        + "'{this.classType.name()}'.", field.nameSpan());
                }
                return;
            }
            members.checkStaticInstanceCollision(this.reporter, this.classType, field.name(),
                false, field.nameSpan());
        }
        this.classType.fields().push(field);
    }

    // The field this class's own declaration of the name would collide with. A private base
    // field is not inherited, so its name is free for a subclass to declare a field of its own
    // under, and the two occupy slots of their own in the flattened layout.
    inheritedOrOwnField(string name) -> Field? {
        let found = members.findField(this.classType.fields(), name);
        if (found == null) {
            return null;
        }
        if (found.definingType() != this.classType && found.visibility() == Visibility.Private) {
            return null;
        }
        return found;
    }

    // One static const field of a class; the struct twin lives in the signature phase. The
    // shape checks and the shared-namespace collision rules are one home in phases.members.
    collectStaticField(FieldDeclarationNode declaration, Field field) {
        members.checkStaticFieldShape(this.reporter, declaration, field);
        if (field.name().length > 0) {
            if (members.findField(this.classType.staticFields(), field.name()) != null) {
                this.reporter.report("Static const '{field.name()}' is already declared in "
                    + "'{this.classType.name()}'.", field.nameSpan());
                return;
            }
            members.checkStaticInstanceCollision(this.reporter, this.classType, field.name(),
                true, field.nameSpan());
        }
        this.classType.staticFields().push(field);
    }

    checkWeakField(Field field) {
        let fieldType = field.type();
        if (fieldType is OptionalType) {
            let inner = fieldType.inner();
            if (types.isClassLike(inner)) {
                if (types.isInterfaceLike(inner)) {
                    this.reporter.report("'weak' fields must reference a class; "
                        + "interface-typed weak fields are not supported. Use the "
                        + "implementing class's type instead.", field.nameSpan());
                }
                return;
            }
        }
        this.reporter.report("'weak' fields must be nullable class types "
            + "(e.g. 'weak Foo? f').", field.nameSpan());
    }

    collectMethods() {
        let body = this.node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                this.collectMethod(member);
            }
        }
    }

    collectMethod(FunctionDeclarationNode member) {
        let introducer = member.introducer();
        bool isConstructor = false;
        bool isDestructor = false;
        Span nameSpan = member.span();
        if (introducer != null) {
            isConstructor = introducer.kind() == SyntaxKind.ConstructorKeyword;
            isDestructor = introducer.kind() == SyntaxKind.DestructorKeyword;
            nameSpan = introducer.span();
        }
        string rawName = "";
        let nameToken = member.name();
        if (nameToken != null) {
            rawName = nameToken.text();
            nameSpan = nameToken.span();
        }
        if (!isConstructor && !isDestructor) {
            if (rawName.length == 0) {
                return;
            }
            if (rawName == this.classType.name()) {
                this.reporter.report("To declare a constructor, use the 'constructor' "
                    + "keyword. A method cannot be named after its class "
                    + "'{this.classType.name()}'.", nameSpan);
                return;
            }
        }
        if (isDestructor && this.findDestructor() != null) {
            this.reporter.report("A class can declare at most one destructor.", nameSpan);
            return;
        }
        string methodName = rawName;
        if (isConstructor) {
            methodName = "constructor";
        }
        if (isDestructor) {
            methodName = "destructor";
        }
        let modifiers = members.functionModifiers(member);
        if (modifiers.declaresStatic && !isConstructor && !isDestructor) {
            members.checkMemberModifiers(this.reporter, member);
            members.collectStaticMethod(this.resolver, this.reporter, this.classType,
                this.classType.staticMethods(), member, methodName, nameSpan, modifiers);
            return;
        }
        members.checkStaticMethodMarkers(this.reporter, modifiers, methodName, isConstructor,
            isDestructor, nameSpan);
        MemberConstraint[] constraints = [];
        if (isDestructor) {
            let constraintList = member.typeParameters();
            if (constraintList != null) {
                this.reporter.report("A destructor cannot have a type-parameter list; it takes "
                    + "no parameters of any kind. Remove the '<...>' list.",
                    constraintList.span());
            }
        } else {
            string constraintSubject = "Method '{methodName}' of '{this.classType.name()}'";
            if (isConstructor) {
                constraintSubject = "A constructor of '{this.classType.name()}'";
            }
            constraints = members.readMemberConstraints(this.resolver, this.reporter,
                this.classType, member, constraintSubject);
        }
        if (constraints.length > 0) {
            this.resolver.pushMemberConstraints(this.classType.declaration(), constraints);
        }
        let signature = members.buildSignature(this.resolver, this.reporter, member,
            methodName, nameSpan, isConstructor, false,
            isConstructor || modifiers.declaresAbstract, modifiers.declaresNoreturn,
            this.classType.fields(), this.classType.name(), []);
        if (constraints.length > 0) {
            this.resolver.popMemberConstraints();
        }
        Visibility visibility = Visibility.Private;
        if (!isDestructor) {
            string memberKindWord = "Method";
            if (isConstructor) {
                memberKindWord = "Constructor";
            }
            let behavior = members.builtinBehaviorReplaced(this.classType, methodName, signature,
                modifiers.declaresOverride);
            let overridden = this.overriddenClassMethod(modifiers, isConstructor, methodName,
                signature);
            if (behavior != null) {
                visibility = members.builtinReplacementVisibility(modifiers, this.classType,
                    methodName, behavior, this.reporter);
            } else if (overridden != null) {
                visibility = members.overrideVisibility(modifiers, this.classType, overridden,
                    methodName, nameSpan, this.reporter);
            } else {
                visibility = members.memberVisibility(modifiers, Visibility.Private,
                    this.classType, memberKindWord, methodName, this.reporter);
            }
        }
        if (members.findSameSignature(this.classType.methods(), methodName, signature)
                != null) {
            this.reporter.report("Method '{methodName}' of '{this.classType.name()}' is "
                + "already declared with the same parameter types; overloads must differ in "
                + "parameter count or types.", nameSpan);
            return;
        }
        let method = new Method(signature, visibility, isConstructor,
            isDestructor, modifiers.declaresOverride, modifiers.declaresFinal,
            modifiers.declaresAbstract, false, member.body() != null, constraints,
            this.classType);
        this.classType.methods().push(method);

        members.checkNoreturnPlacement(this.reporter, member, isConstructor, isDestructor,
            modifiers.declaresNoreturn);
        members.checkMemberModifiers(this.reporter, member);

        if (isDestructor) {
            if (modifiers.hasVisibilityModifier() || modifiers.declaresOverride
                    || modifiers.declaresFinal || modifiers.declaresAbstract) {
                this.reporter.report("A destructor cannot have modifiers such as visibility, "
                    + "'override', 'final', or 'abstract'.", nameSpan);
            }
            if (member.parameters().parametersCount() > 0) {
                this.reporter.report("A destructor cannot declare parameters.", nameSpan);
            }
            if (member.returnType() != null) {
                this.reporter.report("A destructor cannot declare a return type.", nameSpan);
            }
            let throwsClause = member.throwsClause();
            if (throwsClause != null) {
                this.reporter.report("A destructor cannot be marked 'throws'.",
                    throwsClause.throwsKeyword().span());
            }
            return;
        }

        if (modifiers.declaresFinal && visibility == Visibility.Private) {
            this.reporter.report("Method '{methodName}' cannot be 'final': it is private to "
                + "'{this.classType.name()}', so it is not inherited and there is no override to "
                + "forbid. Remove 'final'.", nameSpan);
        }
        members.checkFieldMethodCollision(this.reporter, this.classType.fields(), methodName,
            isConstructor, nameSpan);
        if (!isConstructor) {
            members.checkStaticInstanceCollision(this.reporter, this.classType, methodName,
                false, nameSpan);
        }
        members.checkThrowsPlacement(this.reporter, member, isConstructor,
            modifiers.declaresAbstract);
        members.checkHashSignature(this.reporter, member, signature, isConstructor);
        members.checkEqualsSignature(this.reporter, member, signature, this.classType,
            isConstructor);
        if (modifiers.declaresOverride) {
            members.checkToStringSignature(this.reporter, member, signature, isConstructor);
        }
        if (isConstructor) {
            if (modifiers.declaresOverride || modifiers.declaresAbstract) {
                this.reporter.report("A constructor cannot be 'override' or 'abstract'.",
                    nameSpan);
            }
            return;
        }
        if (modifiers.declaresAbstract) {
            if (!this.classType.isAbstract()) {
                this.reporter.report("Abstract method '{methodName}' requires class "
                    + "'{this.classType.name()}' to be declared 'abstract'.", nameSpan);
            }
            if (member.body() != null) {
                this.reporter.report("Abstract method '{methodName}' cannot have a body.",
                    nameSpan);
            }
            // A subclass has to implement an abstract method, and an unmarked member is private
            // to its own type, so the two ask for opposite things.
            if (visibility == Visibility.Private) {
                this.reporter.report("Abstract method '{methodName}' must be at least "
                    + "'protected': a subclass has to implement it, and an unmarked member is "
                    + "private to '{this.classType.name()}'. Mark it 'protected'.", nameSpan);
            }
            if (modifiers.declaresOverride && methodName == "toString") {
                this.reporter.report("Method 'toString' of '{this.classType.name()}' cannot be "
                    + "'abstract': every class already answers with its type name, so a "
                    + "'toString' override needs a body that replaces that default. Write the "
                    + "body, or remove the method.", nameSpan);
            }
        }
        members.checkConditionalMarkers(this.reporter, constraints, modifiers, methodName,
            this.classType, nameSpan);
        if (constraints.length > 0 && modifiers.declaresOverride) {
            return;
        }
        this.checkOverrideRules(member, method, methodName, nameSpan, modifiers);
    }

    findDestructor() -> Method? {
        let methods = this.classType.methods();
        for (long i = 0; i < methods.length(); i++) {
            if (methods.get(i).isDestructor()) {
                return methods.get(i);
            }
        }
        return null;
    }

    // Validates the override marker against the concrete base chain and the implemented
    // interfaces. 'hash' and 'equals' override built-in behavior, so their conforming shapes
    // require the marker even with no base declaration; a marked 'toString' replaces the type-name
    // text form the same way, while an unmarked one stays an ordinary method.
    checkOverrideRules(FunctionDeclarationNode member, Method method,
                               string methodName, Span nameSpan, MemberModifiers modifiers) {
        let signature = method.signature();
        let baseBySignature = this.findInBase(methodName, signature, true);
        bool reservedIntent = methodName == "hash" || methodName == "toString"
            || (methodName == "equals" && members.equalsIntent(signature, this.classType));
        bool reservedConforming =
            (methodName == "hash" && members.hashSignatureConforms(signature))
            || (methodName == "equals"
                && members.equalsSignatureConforms(signature, this.classType));
        if (modifiers.declaresOverride) {
            if (baseBySignature != null && baseBySignature.isConditional()) {
                this.reporter.report("Cannot override '{methodName}': "
                    + "'{types.display(baseBySignature.definingType())}' declares it "
                    + "conditionally, so it does not exist on every instantiation and cannot "
                    + "be replaced. Rename the method.", nameSpan);
                return;
            }
            if (baseBySignature != null) {
                string ownerName = types.display(baseBySignature.definingType());
                if (baseBySignature.isFinal()) {
                    this.reporter.report("Cannot override '{methodName}' because it is "
                        + "declared 'final' in '{ownerName}'.", nameSpan);
                }
                if (narrowsReturnShape(baseBySignature.signature(), signature)) {
                    string declared = types.display(
                        baseBySignature.signature().returnType());
                    this.reporter.report("Override of '{methodName}' returns "
                        + "'{types.display(signature.returnType())}', but the '{methodName}' "
                        + "declared in '{ownerName}' returns '{declared}', "
                        + narrowedReturnAdvice(baseBySignature.signature().returnType())
                        + ".", nameSpan);
                } else if (!overrideCompatible(baseBySignature.signature(), signature)) {
                    this.reporter.report("Override of '{methodName}' does not match the "
                        + "signature declared in '{ownerName}'; expected "
                        + "'{methodDisplay(baseBySignature)}'.", nameSpan);
                }
                let throwsClause = member.throwsClause();
                if (throwsClause != null && !baseBySignature.signature().declaresThrows()) {
                    this.reporter.report("Method '{methodName}' is marked 'throws' but "
                        + "overrides a method of '{ownerName}' that is not. Mark the base "
                        + "method 'throws' too, or handle the exceptions inside the "
                        + "override.", throwsClause.throwsKeyword().span());
                }
                if (baseBySignature.isNoreturn() && !method.isNoreturn()) {
                    this.reporter.report("Override of '{methodName}' must be marked 'noreturn' "
                        + "because the method it overrides in '{ownerName}' is 'noreturn'; "
                        + "callers rely on it never returning. Add 'noreturn' before the "
                        + "method name.", nameSpan);
                }
                return;
            }
            if (this.findInInterfaces(methodName, signature, true) != null) {
                return;
            }
            let baseByName = this.findInBase(methodName, signature, false);
            if (baseByName != null) {
                this.reporter.report("Override of '{methodName}' does not match the "
                    + "signature declared in "
                    + "'{types.display(baseByName.definingType())}'; expected "
                    + "'{methodDisplay(baseByName)}'.", nameSpan);
                return;
            }
            let interfaceByName = this.findInInterfaces(methodName, signature, false);
            if (interfaceByName != null) {
                this.reporter.report("Override of '{methodName}' does not match the "
                    + "signature declared in interface "
                    + "'{types.display(interfaceByName.definingType())}'; expected "
                    + "'{methodDisplay(interfaceByName)}'.", nameSpan);
                return;
            }
            if (reservedIntent) {
                return;
            }
            let privateBase = this.findPrivateInBase(methodName);
            if (privateBase != null) {
                string owner = types.display(privateBase.definingType());
                this.reporter.report("Cannot override '{methodName}': '{owner}' declares it "
                    + "privately, so it is not inherited and nothing here can call it. Mark it "
                    + "'protected' in '{owner}' to allow overriding, or drop 'override' to "
                    + "declare a method of this class's own.", nameSpan);
                return;
            }
            this.reporter.report("Method '{methodName}' is marked 'override' but no base "
                + "class or implemented interface declares it.", nameSpan);
            return;
        }
        if (baseBySignature != null) {
            string ownerName = types.display(baseBySignature.definingType());
            if (baseBySignature.isConditional()) {
                this.reporter.report("Method '{methodName}' has the same signature as a "
                    + "conditional method of '{ownerName}', which exists only for "
                    + "instantiations satisfying its constraints; a conditional member cannot "
                    + "be overridden or hidden. Rename one of the two.", nameSpan);
                return;
            }
            if (method.isConditional()) {
                this.reporter.report("Method '{methodName}' is conditional but has the same "
                    + "signature as a method inherited from '{ownerName}'; a conditional "
                    + "member cannot replace an inherited one. Rename it.", nameSpan);
                return;
            }
            this.reporter.report("Method '{methodName}' hides a method inherited from "
                + "'{ownerName}'; mark it 'override' to replace it, or rename it.", nameSpan);
            return;
        }
        let interfaceBySignature = this.findInInterfaces(methodName, signature, true);
        if (interfaceBySignature != null && !method.isConditional()) {
            string interfaceName = types.display(interfaceBySignature.definingType());
            this.reporter.report("Method '{methodName}' of '{this.classType.name()}' "
                + "implements a method declared in interface '{interfaceName}'; mark it "
                + "'override'.", nameSpan);
            return;
        }
        if (reservedConforming) {
            string builtin = "identity equality";
            if (methodName == "hash") {
                builtin = "identity hash";
            }
            this.reporter.report("Method '{methodName}' overrides the built-in {builtin}; "
                + "mark it 'override'.", nameSpan);
        }
    }

    // The visible base class method an 'override' replaces by signature, whose visibility the
    // override carries; null for every other member, which keeps the ordinary member rule. A
    // conditional base method cannot be overridden at all, and that refusal says so on its own.
    overriddenClassMethod(MemberModifiers modifiers, bool isConstructor, string methodName,
                          Signature signature) -> Method? {
        if (!modifiers.declaresOverride || isConstructor) {
            return null;
        }
        let overridden = this.findInBase(methodName, signature, true);
        if (overridden == null || overridden.isConditional()) {
            return null;
        }
        return overridden;
    }

    // The nearest base-chain method with the name (and, when bySignature, the same parameter
    // types).
    // The base declaration a member of this class would replace. A private one is skipped: only
    // the class that declared it can name it, so it is not inherited, and this class's own member
    // of that name is an unrelated one of its own. A visible declaration further up the chain is
    // still what an override replaces.
    findInBase(string methodName, Signature signature, bool bySignature) -> Method? {
        Type? current = types.baseOf(this.classType);
        while (current != null) {
            let found = this.findOwn(current, methodName, signature, bySignature);
            if (found != null && found.visibility() != Visibility.Private) {
                return found;
            }
            current = types.baseOf(current);
        }
        return null;
    }

    // A base class's private method of this name, which is what a mistaken 'override' was aiming
    // at when nothing visible declares the name.
    findPrivateInBase(string methodName) -> Method? {
        Type? current = types.baseOf(this.classType);
        while (current != null) {
            let methods = types.methodsOf(current);
            if (methods != null) {
                for (long i = 0; i < methods.length(); i++) {
                    let candidate = methods.get(i);
                    if (candidate.name() == methodName
                            && candidate.visibility() == Visibility.Private) {
                        return candidate;
                    }
                }
            }
            current = types.baseOf(current);
        }
        return null;
    }

    findOwn(Type owner, string methodName, Signature signature,
                    bool bySignature) -> Method? {
        let methods = types.methodsOf(owner);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let candidate = methods.get(i);
            if (candidate.name() != methodName) {
                continue;
            }
            if (!bySignature
                    || types.sameParameterTypes(candidate.signature(), signature)) {
                return candidate;
            }
        }
        return null;
    }

    // A method of an interface named in this class's own implements clause, or of an interface
    // one of them extends.
    findInInterfaces(string methodName, Signature signature, bool bySignature)
            -> Method? {
        for (let implemented in this.classType.interfaces()) {
            for (let level in types.interfaceLadderOf(implemented)) {
                let found = this.findOwn(level, methodName, signature, bySignature);
                if (found != null) {
                    return found;
                }
            }
        }
        return null;
    }

    // The class must provide every method of every interface it implements - the interfaces
    // those extend included - either declared here (abstract counts) or inherited from a base
    // class.
    checkInterfaceSatisfaction() {
        Span at = this.node.name().span();
        let checked = new Set<Type>();
        for (let implemented in this.classType.interfaces()) {
            for (let level in types.interfaceLadderOf(implemented)) {
                if (!checked.add(level)) {
                    continue;
                }
                this.checkInterfaceLevelSatisfied(implemented, level, at);
            }
        }
    }

    // One rung of an implemented interface's ladder: every method 'level' declares must be
    // provided. A missing inherited requirement names the interface in the ladder declaring it.
    checkInterfaceLevelSatisfied(Type implemented, Type level, Span at) {
        let methods = types.methodsOf(level);
        if (methods == null) {
            return;
        }
        string interfaceName = types.display(implemented);
        string levelName = types.display(level);
        for (long i = 0; i < methods.length(); i++) {
            let required = methods.get(i);
            let provided = this.findDeclaring(required.name(), required.signature());
            if (provided == null) {
                if (level == implemented) {
                    this.reporter.report("Class '{this.classType.name()}' implements "
                        + "'{interfaceName}' but does not provide "
                        + "'{methodDisplay(required)}'. Declare the method, or inherit "
                        + "it from a base class.", at);
                } else {
                    this.reporter.report("Class '{this.classType.name()}' implements "
                        + "'{interfaceName}' but does not provide "
                        + "'{methodDisplay(required)}', required by '{levelName}', which "
                        + "'{interfaceName}' extends. Declare the method, or inherit it from "
                        + "a base class.", at);
                }
                continue;
            }
            if (provided.isConditional()) {
                string requiredBy = "'{interfaceName}'";
                if (level != implemented) {
                    requiredBy = "'{levelName}', which '{interfaceName}' extends";
                }
                this.reporter.report("Class '{this.classType.name()}' implements "
                    + "'{interfaceName}' but provides '{methodDisplay(required)}', required by "
                    + "{requiredBy}, only conditionally; an interface requirement must exist "
                    + "on every instantiation, so a conditional member cannot satisfy it. "
                    + "Remove the '<...>' constraint list from '{required.name()}', or stop "
                    + "implementing '{interfaceName}'.", at);
                continue;
            }
            if (narrowsReturnShape(required.signature(), provided.signature())) {
                string wanted = types.display(required.signature().returnType());
                this.reporter.report("Method '{required.name()}' of "
                    + "'{this.classType.name()}' returns "
                    + "'{types.display(provided.signature().returnType())}', but interface "
                    + "'{levelName}' requires '{wanted}', "
                    + narrowedReturnAdvice(required.signature().returnType()) + ".", at);
            } else if (!overrideCompatible(required.signature(), provided.signature())) {
                this.reporter.report("Method '{required.name()}' of "
                    + "'{this.classType.name()}' does not match "
                    + "'{methodDisplay(required)}' declared in interface "
                    + "'{levelName}'.", at);
            }
            if (required.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{required.name()}' of "
                    + "'{this.classType.name()}' must be marked 'noreturn' because "
                    + "interface '{levelName}' declares it 'noreturn'; callers rely on "
                    + "it never returning.", at);
            }
            // Anyone who can name the class, or hold one of its values as the interface, can call
            // the method through the interface. So it has to reach as far as the class does, the
            // same rule 'toString', 'hash', and 'equals' already follow. 'protected' and private
            // share one tier, so the narrowest case is named on its own.
            Visibility wantedReach =
                types.followedMemberVisibility(this.classType.visibility());
            if (provided.visibility() == Visibility.Private
                    || types.visibilityTier(provided.visibility())
                        < types.visibilityTier(wantedReach)) {
                this.reporter.report("Method '{required.name()}' of "
                    + "'{this.classType.name()}' is "
                    + "{types.visibilityWord(provided.visibility())}, but it provides "
                    + "'{methodDisplay(required)}' required by '{interfaceName}', and a call "
                    + "through '{interfaceName}' reaches it wherever "
                    + "'{this.classType.name()}' itself reaches. Mark it "
                    + "'{types.visibilityWord(wantedReach)}'.", at);
            }
        }
    }

    // The most derived declaration with the name and parameter types, searching this class and
    // then its concrete base chain.
    findDeclaring(string methodName, Signature signature) -> Method? {
        let own = this.findOwn(this.classType, methodName, signature, true);
        if (own != null) {
            return own;
        }
        return this.findInBase(methodName, signature, true);
    }

    // A concrete class must implement every abstract method it inherits or declares.
    checkAbstractSatisfied() {
        if (this.classType.isAbstract()) {
            return;
        }
        Span at = this.node.name().span();
        let checked = new List<Method>();
        Type? current = this.classType;
        while (current != null) {
            let methods = types.methodsOf(current);
            if (methods == null) {
                break;
            }
            for (long i = 0; i < methods.length(); i++) {
                let method = methods.get(i);
                if (method.isConstructor() || method.isDestructor()) {
                    continue;
                }
                if (members.findSameSignature(checked, method.name(),
                        method.signature()) != null) {
                    continue;
                }
                checked.push(method);
                let declaring = this.findDeclaring(method.name(), method.signature());
                if (declaring != null && declaring.isAbstract()) {
                    this.reporter.report("Class '{this.classType.name()}' must override "
                        + "abstract method '{method.name()}', or be declared 'abstract'.", at);
                }
            }
            current = types.baseOf(current);
        }
    }
}

// Params must match exactly, and the return type may be covariant only where narrowing it leaves
// what a caller reads unchanged. A dispatch slot has one calling convention, and a caller holding a
// base reference reads the result at the type the base declared, so two spellings of one pointer
// are interchangeable while a narrower number or a nullable value type is not.
overrideCompatible(Signature base, Signature derived) -> bool {
    if (!types.sameParameterTypes(base, derived)) {
        return false;
    }
    Type declared = base.returnType();
    Type actual = derived.returnType();
    if (!convert.isAssignableStrict(declared, actual)) {
        return false;
    }
    return declared == actual || sameReturnShape(declared, actual);
}

// True when a value of the override's return type and one of the declared type are held the same
// way, so a caller reading the declared type reads what the override produced.
sameReturnShape(Type declared, Type actual) -> bool {
    return types.isPointerShaped(declared) && types.isPointerShaped(actual);
}

// True when the only thing wrong with the override is that its return type is held differently
// from the declared one. Such a signature is nearly right, so it earns a message about the return
// type rather than one about the whole signature.
narrowsReturnShape(Signature base, Signature derived) -> bool {
    if (!types.sameParameterTypes(base, derived)) {
        return false;
    }
    Type declared = base.returnType();
    Type actual = derived.returnType();
    if (declared == actual || !convert.isAssignableStrict(declared, actual)) {
        return false;
    }
    return !sameReturnShape(declared, actual);
}

// Why a return type held differently from the declared one is refused, and the fix. The caller
// names the two methods first, because a class override and an interface requirement name
// themselves differently; this is the part they share.
narrowedReturnAdvice(Type declared) -> string {
    return "and the two are held differently at run time. An override may narrow a class, "
        + "interface, array, string, function or handle reference, where both spellings are one "
        + "pointer, but not a number and not a nullable value type. Return "
        + "'{types.display(declared)}'";
}

// The signature as an interface requirement reads: 'speak(int) -> string'.
public methodDisplay(Method method) -> string {
    let builder = new StringBuilder();
    builder.append(method.name());
    builder.append("(");
    let parameters = method.signature().parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(types.display(parameters[i].type()));
    }
    builder.append(")");
    let returned = method.signature().returnType();
    if (!types.isVoidType(returned)) {
        builder.append(" -> ");
        builder.append(types.display(returned));
    }
    return builder.toString();
}
