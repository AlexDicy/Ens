// Whole-program class layout. Inheritance cycles are broken first, then every class lays out in
// base-before-derived order, flattening inherited fields in and resolving its own members. A
// generic base fills on demand, so every base chain the checks walk is complete.
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import @ens.frontend.syntax.generated.factory;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import ClassItem from context;
import phases.members;
import MemberModifiers from phases.members;
import phases.bodies.wording;
import TypeResolver from phases.resolve;
import model.convert;
import model.hierarchy;
import model.typemembers;
import Field from model.typemembers;
import Method from model.typemembers;
import MemberConstraint from model.typemembers;
import Signature from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import QuotedCode from model.typenames;
import model.types;
import Type from model.types;
import ClassType from model.types;
import InterfaceType from model.types;
import InstantiationType from model.types;
import OptionalType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Lays out every class in the program. items are in (module, source) order.
public layoutProgram(List<ClassItem> items) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    breakInheritanceCycles(items, collected);
    let ordered = sortedByBaseDepth(items);
    for (long i = 0; i < ordered.length(); i++) {
        let worker = new ClassLayout(ordered.get(i), collected);
        worker.run();
    }
    return diagnostics.sorted(collected);
}

// A class whose base chain comes back to itself cannot be laid out; the first class found on
// a cycle is diagnosed and its base link cleared, which dissolves the cycle for the rest. A class
// whose chain runs into a cycle it is not part of is left to the classes on that cycle.
breakInheritanceCycles(List<ClassItem> items, List<FileDiagnostic> collected) {
    for (long i = 0; i < items.length(); i++) {
        let item = items.get(i);
        let classType = item.classType();
        let names = item.context().names().withParametersOf(classType);
        let seen = new Set<ClassType>();
        let chain = new List<string>();
        ClassType? current = classType;
        bool cycle = false;
        while (current != null) {
            if (!seen.add(current)) {
                cycle = current == classType;
                break;
            }
            chain.push(names.quotedName(current));
            current = baseAuthority(current);
        }
        if (!cycle) {
            continue;
        }
        string className = names.quotedName(classType);
        let steps = new StringBuilder();
        steps.append("Class {className} extends ");
        for (long c = 1; c < chain.length(); c++) {
            steps.append("{chain.get(c)}, which extends ");
        }
        steps.append("{className}, so {className} would be its own base class. Remove one of the "
            + "'extends' clauses in that chain.");
        collected.push(new FileDiagnostic(item.context().module().filePath(), steps.toString(),
            item.declaration().name().span()));
        let base = classType.base();
        if (base != null) {
            let authority = types.authorityOf(base);
            if (authority is ClassType) {
                authority.removeDirectSubclass(classType);
            }
        }
        classType.clearBase();
    }
}

// The class the base link continues through: a generic base defers to its template.
baseAuthority(ClassType classType) -> ClassType? {
    let base = classType.base();
    if (base == null) {
        return null;
    }
    let authority = types.authorityOf(base);
    if (authority is ClassType) {
        return authority;
    }
    return null;
}

baseDepth(ClassType classType) -> long {
    long depth = 0;
    let seen = new Set<ClassType>();
    ClassType? current = baseAuthority(classType);
    while (current != null && seen.add(current)) {
        depth++;
        current = baseAuthority(current);
    }
    return depth;
}

// Stable insertion sort: equal depths keep (module, source) order.
sortedByBaseDepth(List<ClassItem> items) -> List<ClassItem> {
    let ordered = new List<ClassItem>();
    let depths = new List<long>();
    for (long i = 0; i < items.length(); i++) {
        ordered.push(items.get(i));
        depths.push(baseDepth(items.get(i).classType()));
        long at = ordered.length() - 1;
        while (at > 0 && depths.get(at - 1) > depths.get(at)) {
            let movedItem = ordered.get(at - 1);
            ordered.set(at - 1, ordered.get(at));
            ordered.set(at, movedItem);
            long movedDepth = depths.get(at - 1);
            depths.set(at - 1, depths.get(at));
            depths.set(at, movedDepth);
            at--;
        }
    }
    return ordered;
}

// An 'override' that matches no method of a base class or interface, with where it is named and
// whether its name and shape make it one of the built-in behaviors 'hash', 'equals' or 'toString'.
final class UnmatchedOverride {
    protected Method method;
    protected Span nameSpan;
    protected bool reservedIntent;

    protected constructor(this.method, this.nameSpan, this.reservedIntent);
}

class ClassLayout {
    ClassItem item;
    ClassType classType;
    ClassDeclarationNode node;
    TypeResolver resolver;
    Reporter reporter;
    TypeNames names;
    List<UnmatchedOverride> unmatchedOverrides;

    protected constructor(ClassItem item, List<FileDiagnostic> collected) {
        this.item = item;
        this.classType = item.classType();
        this.node = item.declaration();
        this.resolver = item.context().resolver();
        this.reporter = new Reporter(item.context().module().filePath(), collected);
        this.names = item.context().names().withParametersOf(this.classType);
        this.unmatchedOverrides = new List<UnmatchedOverride>();
    }

    protected run() {
        let parameters = this.classType.typeParameterTypes();
        this.resolver.pushTypeParameters(parameters);
        this.flattenInheritedFields();
        this.collectOwnFields();
        this.collectMethods();
        this.classType.setMembersComplete();
        for (let pending in this.unmatchedOverrides) {
            this.reportUnmatchedOverride(pending);
        }
        members.checkHashEqualsPairing(this.reporter, this.classType, this.node.name().span(),
            this.names);
        this.checkInterfaceSatisfaction();
        this.checkAbstractSatisfied();
        this.resolver.popTypeParameters(parameters.length);
        for (let diagnostic in this.resolver.takeDiagnostics()) {
            this.reporter.report(diagnostic.message(), diagnostic.span());
        }
    }

    flattenInheritedFields() {
        let base = this.classType.base();
        if (base == null) {
            return;
        }
        if (base is InstantiationType) {
            this.resolver.typeStore().ensureFilled(base);
        }
        let inherited = typemembers.fieldsOf(base);
        if (inherited == null) {
            return;
        }
        for (long i = 0; i < inherited.length(); i++) {
            this.classType.fields().push(inherited.get(i));
        }
        this.classType.setBaseFieldCount(inherited.length());
    }

    collectOwnFields() {
        let body = this.node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode) {
                this.collectOwnField(member);
            }
        }
    }

    collectOwnField(FieldDeclarationNode declaration) {
        let field = members.readField(this.resolver, this.reporter, declaration, this.classType, this.names);
        if (field.isStatic() || field.isLazy()) {
            this.collectTypeLevelField(declaration, field);
            return;
        }
        if (field.isWeak() && field.isConst()) {
            this.reporter.report("Field '{field.name()}' cannot be both 'weak' and 'const': a "
                + "'const' field keeps one value for the object's whole life, while a 'weak' "
                + "field becomes null when the object it refers to is destroyed. Remove one of "
                + "the two.", field.nameSpan());
        } else if (field.isWeak()) {
            this.checkWeakField(field);
        }
        if (field.name().length > 0) {
            let existing = typemembers.inheritedOrOwnField(this.classType, field.name());
            if (existing != null) {
                if (existing.definingType() != this.classType) {
                    this.reporter.report("Field '{field.name()}' is already declared in base "
                        + "class {this.names.quoted(existing.definingType())} and inherited by "
                        + "{this.names.quotedName(this.classType)}. Remove this declaration and use the "
                        + "inherited field, or give this one another name.", field.nameSpan());
                } else {
                    this.reporter.report("Field '{field.name()}' is already declared in "
                        + "{this.names.quotedName(this.classType)}. Remove this second "
                        + "'{field.name()}', or rename it.", field.nameSpan());
                }
                return;
            }
            members.checkStaticInstanceCollision(this.reporter, this.classType, field.name(),
                false, field.nameSpan(), this.names);
        }
        this.classType.fields().push(field);
    }

    // One static const or lazy const field of a class; the struct twin is in the signature phase.
    // The shape checks and the shared-namespace collision rules are one home in phases.members.
    collectTypeLevelField(FieldDeclarationNode declaration, Field field) {
        if (field.isLazy()) {
            members.checkLazyFieldShape(this.reporter, declaration, field, this.names);
        } else {
            members.checkStaticFieldShape(this.reporter, declaration, field, this.names);
        }
        if (field.name().length > 0) {
            if (members.findField(this.classType.staticFields(), field.name()) != null) {
                this.reporter.report("{members.typeLevelFieldNoun(field)} '{field.name()}' is "
                    + "already declared in {this.names.quotedName(this.classType)}. Remove this second "
                    + "'{field.name()}', or rename it.", field.nameSpan());
                return;
            }
            members.checkStaticInstanceCollision(this.reporter, this.classType, field.name(),
                true, field.nameSpan(), this.names, field);
        }
        this.classType.staticFields().push(field);
    }

    checkWeakField(Field field) {
        let fieldType = field.type();
        Type core = fieldType;
        long nullableLevels = 0;
        while (true) {
            if (!(core is OptionalType)) {
                break;
            }
            core = core.inner();
            nullableLevels++;
        }
        string name = field.name();
        string subject = "Field '{name}' of class {this.names.quotedName(this.classType)} is 'weak'";
        string coreName = this.names.quoted(core);
        string declaration = this.names.quotedCode(["weak ", "? {name}"], [core]);
        if (types.isInterfaceLike(core)) {
            string fix = "Replace {coreName} with a class that implements {coreName}.";
            if (nullableLevels == 0) {
                fix = "Replace {coreName} with a class that implements {coreName}, and add '?' after it.";
            }
            this.reporter.report("{subject}, so its type must be a class. {coreName} is an "
                + "interface. {fix}", field.nameSpan());
            return;
        }
        if (!types.isClassLike(core)) {
            this.reporter.report("{subject}, so its type must be a class. "
                + "{this.names.quoted(fieldType)} is not a class. Remove 'weak'.", field.nameSpan());
            return;
        }
        if (nullableLevels == 0) {
            this.reporter.report("{subject}, so its type must be nullable. A weak field becomes "
                + "'null' when its object is destroyed. Write {declaration}.", field.nameSpan());
        } else if (nullableLevels > 1) {
            this.reporter.report("{subject}, so its type needs exactly one '?'. "
                + "{this.names.quoted(fieldType)} has {diagnostics.countWord(nullableLevels)}. Write "
                + "{declaration}.", field.nameSpan());
        }
    }

    collectMethods() {
        let body = this.node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                this.collectMethod(member);
            }
        }
    }

    collectMethod(FunctionDeclarationNode member) {
        let introducer = member.introducer();
        bool isConstructor = false;
        bool isDestructor = false;
        Span nameSpan = member.span();
        if (introducer != null) {
            isConstructor = introducer.kind() == SyntaxKind.ConstructorKeyword;
            isDestructor = introducer.kind() == SyntaxKind.DestructorKeyword;
            nameSpan = introducer.span();
        }
        string rawName = "";
        let nameToken = member.name();
        if (nameToken != null) {
            rawName = nameToken.text();
            nameSpan = nameToken.span();
        }
        if (!isConstructor && !isDestructor) {
            if (rawName.length == 0) {
                return;
            }
            if (rawName == this.classType.name()) {
                this.reporter.report("Method '{rawName}' has the name of its class, and a method "
                    + "cannot be named after its class. To declare a constructor, write "
                    + "'constructor(...)' instead of '{rawName}(...)'.", nameSpan);
                return;
            }
        }
        string className = this.names.quotedName(this.classType);
        string destructorSubject = members.specialMemberSubject(false, className);
        if (isDestructor && this.findDestructor() != null) {
            this.reporter.report("Class {className} already declares a destructor. A class has "
                + "at most one destructor. Remove this second 'destructor', or move its body into "
                + "the first.", nameSpan);
            return;
        }
        string methodName = rawName;
        if (isConstructor) {
            methodName = "constructor";
        }
        if (isDestructor) {
            methodName = "destructor";
        }
        let modifiers = members.functionModifiers(member);
        if (modifiers.declaresStatic && !isConstructor && !isDestructor) {
            members.checkMemberModifiers(this.reporter, member, className);
            members.collectStaticMethod(this.resolver, this.reporter, this.classType,
                this.classType.staticMethods(), member, methodName, nameSpan, modifiers,
                this.names);
            return;
        }
        members.checkStaticMethodMarkers(this.reporter, modifiers, methodName, isConstructor,
            isDestructor, nameSpan, className);
        string mutatingSubject = "Method '{methodName}' of class {className}";
        string mutatingReason = "a class method changes its object through a reference, so it needs no "
            + "marker";
        if (isConstructor) {
            mutatingSubject = members.specialMemberSubject(true, className);
            mutatingReason = "a constructor builds a new value rather than changing one";
        } else if (isDestructor) {
            mutatingSubject = destructorSubject;
            mutatingReason = "a destructor runs when an object is destroyed";
        }
        members.refuseMutating(this.reporter, modifiers, mutatingSubject, mutatingReason,
            "Remove 'mutating'.", nameSpan);
        MemberConstraint[] constraints = [];
        if (isDestructor) {
            let constraintList = member.typeParameters();
            if (constraintList != null) {
                this.reporter.report("{destructorSubject} cannot have a type-parameter list. A "
                    + "destructor takes no parameters of any kind. Remove the '<...>' list.",
                    constraintList.span());
            }
        } else {
            string constraintSubject = "Method '{methodName}' of {this.names.quotedName(this.classType)}";
            if (isConstructor) {
                constraintSubject = members.specialMemberSubject(true, className);
            }
            constraints = members.readMemberConstraints(this.resolver, this.reporter,
                this.classType, member, constraintSubject, this.names);
        }
        if (constraints.length > 0) {
            this.resolver.pushMemberConstraints(this.classType.declaration(), constraints);
        }
        bool refusedNoreturn = isConstructor || isDestructor;
        Signature signature = members.buildSignature(this.resolver, this.reporter, member,
            methodName, nameSpan, isConstructor, false, isConstructor || modifiers.declaresAbstract,
            modifiers.declaresNoreturn && !refusedNoreturn, this.classType, this.names, []);
        Type writtenReturn = signature.returnType();
        if (isDestructor && member.returnType() != null) {
            // A refused return type becomes the error type, so the body raises no second report.
            signature = new Signature(signature.name(), signature.parameters(),
                this.resolver.typeStore().errorType(), signature.declaresThrows(),
                false, signature.throwsTypes(), signature.throwsTypeSpans(), [], member.green(), nameSpan);
        }
        if (constraints.length > 0) {
            this.resolver.popMemberConstraints();
        }
        Visibility visibility = Visibility.Private;
        if (!isDestructor) {
            string memberKindWord = "Method";
            if (isConstructor) {
                memberKindWord = "Constructor";
            }
            let behavior = members.builtinBehaviorReplaced(this.classType, methodName, signature);
            let overridden = this.overriddenClassMethod(modifiers, isConstructor, methodName,
                signature);
            if (behavior != null) {
                visibility = members.builtinReplacementVisibility(modifiers, this.classType,
                    methodName, behavior, this.reporter, this.names);
            } else if (overridden != null) {
                visibility = members.overrideVisibility(modifiers, this.classType, overridden,
                    methodName, nameSpan, this.reporter, this.names);
            } else {
                visibility = members.memberVisibility(modifiers, this.classType, memberKindWord,
                    methodName, this.reporter, this.names);
            }
        }
        if (members.findSameSignature(this.classType.methods(), methodName, signature)
                != null) {
            this.reporter.report(members.repeatedOverloadMessage(
                "Method '{methodName}' of {className}", "methods"), nameSpan);
            return;
        }
        let method = new Method(signature, visibility, isConstructor,
            isDestructor, modifiers.declaresOverride, modifiers.declaresFinal,
            modifiers.declaresAbstract, false, false, member.body() != null, constraints,
            this.classType);
        this.classType.methods().push(method);

        members.checkNoreturnPlacement(this.reporter, member, isConstructor, isDestructor,
            modifiers.declaresNoreturn, className);
        members.checkMemberModifiers(this.reporter, member, className);

        if (isDestructor) {
            this.checkDestructorShape(member, modifiers, destructorSubject, nameSpan, writtenReturn);
            return;
        }

        if (modifiers.declaresFinal && visibility == Visibility.Private && !isConstructor) {
            this.reporter.report("Method '{methodName}' cannot be 'final': it is private to "
                + "{this.names.quotedName(this.classType)}, so no subclass can override it anyway. Remove "
                + "'final'.", nameSpan);
        }
        members.checkFieldMethodCollision(this.reporter, this.classType, methodName,
            isConstructor, nameSpan, this.names);
        if (!isConstructor) {
            members.checkStaticInstanceCollision(this.reporter, this.classType, methodName,
                false, nameSpan, this.names);
        }
        members.checkThrowsPlacement(this.reporter, member, isConstructor,
            modifiers.declaresAbstract, this.classType, this.names);
        members.checkHashSignature(this.reporter, member, signature, isConstructor, this.classType,
            this.names, modifiers.declaresOverride, this.node.body());
        members.checkEqualsSignature(this.reporter, member, signature, this.classType,
            isConstructor, this.names, modifiers.declaresOverride, this.node.body());
        members.checkToStringSignature(this.reporter, member, signature, isConstructor,
            modifiers.declaresOverride);
        if (isConstructor) {
            members.checkConstructorMarkers(this.reporter, modifiers, className, nameSpan);
            return;
        }
        if (modifiers.declaresAbstract) {
            if (!this.classType.isAbstract()) {
                string className = this.names.quotedName(this.classType);
                string message = "Abstract method '{methodName}' has no body, so class "
                    + "{className} must be 'abstract' too. Mark {className} 'abstract', or give "
                    + "'{methodName}' a body and remove 'abstract'.";
                if (member.body() != null) {
                    message = "Abstract method '{methodName}' is declared in class {className}, "
                        + "which is not 'abstract'. Mark {className} 'abstract', or remove "
                        + "'abstract' from '{methodName}'.";
                }
                this.reporter.report(message, nameSpan);
            }
            if (member.body() != null) {
                this.reporter.report("Abstract method '{methodName}' has a body, but an abstract "
                    + "method leaves its body to each subclass. Replace the body with ';', or "
                    + "remove 'abstract'.", nameSpan);
            }
            // A subclass has to implement an abstract method. A member private to its own type is
            // out of every subclass's reach.
            if (visibility == Visibility.Private) {
                this.reporter.report("Abstract method '{methodName}' is private to "
                    + "{this.names.quotedName(this.classType)}, so no subclass can implement it. Mark it "
                    + "'protected'.", nameSpan);
            }
            if (modifiers.declaresOverride && methodName == "toString"
                    && signature.parameters().length == 0) {
                this.reporter.report("Method 'toString' of {this.names.quotedName(this.classType)} cannot be "
                    + "'abstract': every class already has a text form, so an override of it "
                    + "needs a body. Write the body, or remove the method.", nameSpan);
            }
        }
        members.checkConditionalMarkers(this.reporter, constraints, modifiers, methodName,
            this.classType, nameSpan, this.names);
        if (constraints.length > 0 && modifiers.declaresOverride) {
            return;
        }
        this.checkOverrideRules(member, method, methodName, nameSpan, modifiers);
    }

    // Reports an 'override' that matches no method of a base class or interface. It runs once the
    // class has all of its methods, since the overload it was most likely written for depends on
    // the ones the class declares after it as well.
    reportUnmatchedOverride(UnmatchedOverride pending) {
        let method = pending.method;
        Span nameSpan = pending.nameSpan;
        string methodName = method.name();
        let signature = method.signature();
        let intended = this.overrideTarget(method);
        if (intended != null) {
            string owner = this.names.quoted(intended.definingType());
            if (intended.definingType() is InterfaceType) {
                owner = "interface {owner}";
            }
            this.reporter.report(mismatchedOverrideMessage(method, intended, owner, this.names),
                nameSpan);
            return;
        }
        if (this.findInBase(methodName, signature, false) != null
                || this.findInInterfaces(methodName, signature, false) != null) {
            string className = this.names.quotedName(this.classType);
            this.reporter.report("Method '{methodName}' of {className} is marked 'override', "
                + "but every '{methodName}' its base classes and interfaces declare already "
                + "has a matching method in {className}, so this one overrides nothing. "
                + "Remove 'override'.", nameSpan);
            return;
        }
        if (pending.reservedIntent) {
            return;
        }
        let privateBase = this.findPrivateInBase(methodName);
        if (privateBase != null) {
            // A private abstract method is already refused where it is declared.
            if (privateBase.isAbstract()) {
                return;
            }
            string owner = this.names.quoted(privateBase.definingType());
            string className = this.names.quotedName(this.classType);
            string fix = "Mark it 'protected' in {owner}, or remove 'override' to declare a separate "
                + "method of {className}.";
            if (!editableDeclaration(privateBase.definingType())) {
                fix = "Remove 'override' to declare a separate method of {className}.";
            }
            this.reporter.report("Cannot override '{methodName}': {owner} declares it "
                + "privately, so {className} does not inherit it. {fix}", nameSpan);
            return;
        }
        if (methodName == "toString" && signature.parameters().length > 0) {
            this.reporter.report("Method 'toString' of {this.names.quotedName(this.classType)} is marked "
                + "'override' but takes parameters, which makes it an ordinary method "
                + "rather than the text form every class has. Remove 'override'.",
                nameSpan);
            return;
        }
        string className = this.names.quotedName(this.classType);
        string undeclared = "Method '{methodName}' of {className} is marked 'override', but no "
            + "base class or interface of {className} declares '{methodName}'";
        if (methodName == "equals") {
            this.reporter.report("{undeclared}. An 'equals' that does not take exactly one "
                + "{this.names.quoted(this.classType)} is an ordinary method, not the class's "
                + "equality. Remove 'override'.", nameSpan);
            return;
        }
        this.reporter.report("{undeclared}. Remove 'override', or check the spelling of "
            + "'{methodName}'.", nameSpan);
    }

    findDestructor() -> Method? {
        let methods = this.classType.methods();
        for (long i = 0; i < methods.length(); i++) {
            if (methods.get(i).isDestructor()) {
                return methods.get(i);
            }
        }
        return null;
    }

    // A destructor is never called. It takes no visibility, no dispatch marker, no parameters,
    // no result and no 'throws'.
    checkDestructorShape(FunctionDeclarationNode member, MemberModifiers modifiers, string subject,
                         Span nameSpan, Type returned) {
        let visibilityWord = modifiers.visibilityModifierWord();
        if (visibilityWord != null) {
            this.reporter.report("{subject} cannot be '{visibilityWord}'. No code calls a "
                + "destructor; it runs when the object is destroyed. Remove '{visibilityWord}'.",
                modifiers.visibilityModifierSpan(nameSpan));
        }
        string? dispatchWord = null;
        Span dispatchSpan = nameSpan;
        if (modifiers.declaresOverride) {
            dispatchWord = "override";
            dispatchSpan = modifiers.overrideModifierSpan(nameSpan);
        } else if (modifiers.declaresFinal) {
            dispatchWord = "final";
            dispatchSpan = modifiers.finalModifierSpan(nameSpan);
        } else if (modifiers.declaresAbstract) {
            dispatchWord = "abstract";
            dispatchSpan = modifiers.abstractModifierSpan(nameSpan);
        }
        if (dispatchWord != null) {
            this.reporter.report("{subject} cannot be '{dispatchWord}'. No destructor replaces "
                + "another: when an object is destroyed, its own class's destructor and every base "
                + "class's destructor run. Remove '{dispatchWord}'.", dispatchSpan);
        }
        if (member.parameters().parametersCount() > 0) {
            this.reporter.report("{subject} cannot take parameters. No code calls a destructor, so "
                + "nothing could pass them. Write it as 'destructor()'.", nameSpan);
        }
        if (member.returnType() != null) {
            this.reporter.report("{subject} cannot declare a return type. No code calls a "
                + "destructor, so nothing could use the result. "
                + "Remove {this.names.quotedCode(["-> ", ""], [returned])}.", nameSpan);
        }
        let throwsClause = member.throwsClause();
        if (throwsClause != null) {
            this.reporter.report("{subject} cannot be marked 'throws'. It runs when the object is "
                + "destroyed, where no code can catch an exception. Remove 'throws', and catch the "
                + "exceptions with 'catch' clauses after the destructor body.",
                throwsClause.throwsKeyword().span());
        }
    }

    // Validates the override marker against the concrete base chain and the implemented
    // interfaces. 'hash' and 'equals' override built-in behavior. Their conforming shapes
    // require the marker even with no base declaration. A 'toString' taking no parameters
    // replaces the type-name text form the same way. It requires the marker too, while one
    // taking parameters follows the ordinary rules.
    checkOverrideRules(FunctionDeclarationNode member, Method method,
                               string methodName, Span nameSpan, MemberModifiers modifiers) {
        let signature = method.signature();
        let baseBySignature = this.findInBase(methodName, signature, true);
        bool reservedIntent = methodName == "hash"
            || (methodName == "toString" && signature.parameters().length == 0)
            || (methodName == "equals" && members.equalsIntent(signature, this.classType));
        bool reservedConforming =
            (methodName == "hash" && members.hashSignatureConforms(signature))
            || (methodName == "toString" && members.toStringSignatureConforms(signature))
            || (methodName == "equals"
                && members.equalsSignatureConforms(signature, this.classType));
        if (modifiers.declaresOverride) {
            if (this.unresolvedCouldOverride(methodName, signature)) {
                return;
            }
            if (baseBySignature != null && baseBySignature.isConditional()) {
                this.reporter.report("Cannot override '{methodName}': "
                    + "{this.names.quoted(baseBySignature.definingType())} declares it "
                    + "conditionally, so it does not exist for every type argument. Rename the "
                    + "method.", nameSpan);
                return;
            }
            if (baseBySignature != null) {
                string ownerName = this.names.quoted(baseBySignature.definingType());
                if (baseBySignature.isFinal()) {
                    string fix = "Rename this '{methodName}' and remove 'override'";
                    let declaring = types.authorityOf(baseBySignature.definingType());
                    if (declaring != null && declaring.packagePrefix() == this.classType.packagePrefix()) {
                        fix = "{fix}, or remove 'final' from '{methodName}' in "
                            + "{this.names.quotedName(declaring)}";
                    }
                    this.reporter.report("Cannot override '{methodName}', because it is "
                        + "declared 'final' in {ownerName}. {fix}.", nameSpan);
                }
                if (narrowsReturnShape(baseBySignature.signature(), signature)) {
                    string declared = quotedReturnType(baseBySignature.signature(), this.names);
                    this.reporter.report("Override of '{methodName}' returns "
                        + "{quotedReturnType(signature, this.names)}, but the '{methodName}' "
                        + "declared in {ownerName} returns {declared}, "
                        + narrowedReturnAdvice(baseBySignature.signature().returnType(),
                            signature.returnType(), this.names)
                        + ".", nameSpan);
                } else if (!overrideCompatible(baseBySignature.signature(), signature)) {
                    this.reporter.report(mismatchedOverrideMessage(method, baseBySignature,
                        "{ownerName}", this.names), nameSpan);
                }
                let throwsClause = member.throwsClause();
                // A 'toString' that takes no parameters is refused for its 'throws' by its own rule.
                if (throwsClause != null && !baseBySignature.signature().declaresThrows()
                    && !members.isTextFormMethod(signature)) {
                    string fix = "Mark the base method 'throws' too, or catch the exceptions inside the "
                        + "override.";
                    if (!editableDeclaration(baseBySignature.definingType())) {
                        fix = "Catch the exceptions inside the override, and remove 'throws' from it.";
                    }
                    this.reporter.report("Method '{methodName}' is marked 'throws', but the method it "
                        + "overrides in {ownerName} is not. {fix}", throwsClause.throwsKeyword().span());
                }
                if (baseBySignature.isNoreturn() && !method.isNoreturn()) {
                    this.reporter.report("Override of '{methodName}' must be marked 'noreturn', "
                        + "because the '{methodName}' it overrides in {ownerName} is. Add "
                        + "'noreturn' before the method name.", nameSpan);
                }
                return;
            }
            if (this.findInInterfaces(methodName, signature, true) != null) {
                return;
            }
            this.unmatchedOverrides.push(new UnmatchedOverride(method, nameSpan, reservedIntent));
            return;
        }
        if (baseBySignature != null) {
            string ownerName = this.names.quoted(baseBySignature.definingType());
            if (baseBySignature.isConditional()) {
                this.reporter.report("Method '{methodName}' has the same signature as a "
                    + "conditional method of {ownerName}, and a conditional member cannot "
                    + "be overridden or hidden. Rename one of the two.", nameSpan);
                return;
            }
            if (method.isConditional()) {
                this.reporter.report("Method '{methodName}' is conditional but has the same "
                    + "signature as a method inherited from {ownerName}; a conditional "
                    + "member cannot replace an inherited one. Rename it.", nameSpan);
                return;
            }
            this.reporter.report("Method '{methodName}' hides a method inherited from "
                + "{ownerName}, so a call through {ownerName} and one through "
                + "{this.names.quotedName(this.classType)} would run different code. Mark it "
                + "'override' to replace it, or give it another name.", nameSpan);
            return;
        }
        let interfaceBySignature = this.findInInterfaces(methodName, signature, true);
        if (interfaceBySignature != null && !method.isConditional()) {
            string interfaceName = this.names.quoted(interfaceBySignature.definingType());
            this.reporter.report("Method '{methodName}' of {this.names.quotedName(this.classType)} "
                + "implements a method declared in interface {interfaceName} but is not marked "
                + "'override'. Write 'override' before '{methodName}'.", nameSpan);
            return;
        }
        if (reservedConforming) {
            string replaced = "the text form every class already has";
            if (methodName == "hash") {
                replaced = "the built-in identity hash";
            } else if (methodName == "equals") {
                replaced = "the built-in identity equality";
            }
            this.reporter.report("Method '{methodName}' of {this.names.quotedName(this.classType)} "
                + "replaces {replaced} but is not marked 'override'. Write 'override' before "
                + "'{methodName}'.", nameSpan);
        }
    }

    // The visible base class method an 'override' replaces by signature, whose visibility the
    // override carries; null for every other member, which keeps the ordinary member rule. A
    // conditional base method cannot be overridden at all, and that refusal says so on its own.
    overriddenClassMethod(MemberModifiers modifiers, bool isConstructor, string methodName,
                          Signature signature) -> Method? {
        if (!modifiers.declaresOverride || isConstructor) {
            return null;
        }
        let overridden = this.findInBase(methodName, signature, true);
        if (overridden == null || overridden.isConditional()) {
            return null;
        }
        return overridden;
    }

    // The base declaration a member of this class would replace, matched by name and, when
    // bySignature, by parameter types. A private one is skipped, because only the class that
    // declared it can name it, so this class's own member of that name is an unrelated one. A
    // visible declaration further up the chain is still what an override replaces.
    findInBase(string methodName, Signature signature, bool bySignature) -> Method? {
        Type? current = hierarchy.baseOf(this.classType);
        while (current != null) {
            let found = this.findOwn(current, methodName, signature, bySignature);
            if (found != null && found.visibility() != Visibility.Private) {
                return found;
            }
            current = hierarchy.baseOf(current);
        }
        return null;
    }

    // The methods named `methodName` that the base classes declare and this class can see.
    visibleBaseMethods(string methodName) -> List<Method> {
        let found = new List<Method>();
        Type? current = hierarchy.baseOf(this.classType);
        while (current != null) {
            let methods = typemembers.methodsOf(current);
            if (methods != null) {
                for (let method in methods) {
                    if (method.name() == methodName && method.visibility() != Visibility.Private) {
                        found.push(method);
                    }
                }
            }
            current = hierarchy.baseOf(current);
        }
        return found;
    }

    // The method an 'override' that matches nothing was most likely written for: a visible base
    // class method this class does not override yet, or failing one an interface method nothing
    // provides yet, with the closest parameter count. Null when there is none.
    overrideTarget(Method method) -> Method? {
        let fromBase = intendedOverride(method, this.visibleBaseMethods(method.name()),
            this.classType.methods());
        if (fromBase != null) {
            return fromBase;
        }
        let providers = new List<Method>();
        for (let own in this.classType.methods()) {
            providers.push(own);
        }
        Type? current = hierarchy.baseOf(this.classType);
        while (current != null) {
            let methods = typemembers.methodsOf(current);
            if (methods != null) {
                for (let inherited in methods) {
                    if (inherited.visibility() != Visibility.Private) {
                        providers.push(inherited);
                    }
                }
            }
            current = hierarchy.baseOf(current);
        }
        return intendedOverride(method, this.interfaceMethodsNamed(method.name()), providers);
    }

    // The methods named `methodName` that the interfaces this class implements declare, the ones
    // they extend included.
    interfaceMethodsNamed(string methodName) -> List<Method> {
        let found = new List<Method>();
        for (let implemented in this.classType.interfaces()) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                let methods = typemembers.methodsOf(level);
                if (methods == null) {
                    continue;
                }
                for (let method in methods) {
                    if (method.name() == methodName) {
                        found.push(method);
                    }
                }
            }
        }
        return found;
    }

    // Whether an 'override' of this class that matches nothing is reported against `required`,
    // which then needs no report of its own for being missing.
    isOverrideTarget(Method required) -> bool {
        for (let method in this.classType.methods()) {
            if (!method.isOverride() || method.name() != required.name()
                    || this.findInBase(method.name(), method.signature(), true) != null
                    || this.findInInterfaces(method.name(), method.signature(), true) != null
                    || this.unresolvedCouldOverride(method.name(), method.signature())) {
                continue;
            }
            if (this.overrideTarget(method) == required) {
                return true;
            }
        }
        return false;
    }

    // Whether a visible base class method or an interface method named `methodName` differs from
    // `signature` only where a type did not resolve.
    unresolvedCouldOverride(string methodName, Signature signature) -> bool {
        if (unresolvedCouldReplace(this.visibleBaseMethods(methodName), methodName, signature)) {
            return true;
        }
        for (let implemented in this.classType.interfaces()) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                if (unresolvedCouldReplace(typemembers.methodsOf(level), methodName, signature)) {
                    return true;
                }
            }
        }
        return false;
    }

    // A base class's private method of this name, which is what a mistaken 'override' was aiming
    // at when nothing visible declares the name.
    findPrivateInBase(string methodName) -> Method? {
        Type? current = hierarchy.baseOf(this.classType);
        while (current != null) {
            let methods = typemembers.methodsOf(current);
            if (methods != null) {
                for (long i = 0; i < methods.length(); i++) {
                    let candidate = methods.get(i);
                    if (candidate.name() == methodName && candidate.visibility() == Visibility.Private) {
                        return candidate;
                    }
                }
            }
            current = hierarchy.baseOf(current);
        }
        return null;
    }

    findOwn(Type owner, string methodName, Signature signature, bool bySignature) -> Method? {
        let methods = typemembers.methodsOf(owner);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let candidate = methods.get(i);
            if (candidate.name() != methodName) {
                continue;
            }
            if (!bySignature || typemembers.sameParameterTypes(candidate.signature(), signature)) {
                return candidate;
            }
        }
        return null;
    }

    // A method of an interface named in this class's own implements clause, or of an interface
    // one of them extends.
    findInInterfaces(string methodName, Signature signature, bool bySignature)
            -> Method? {
        for (let implemented in this.classType.interfaces()) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                let found = this.findOwn(level, methodName, signature, bySignature);
                if (found != null) {
                    return found;
                }
            }
        }
        return null;
    }

    // The class must provide every method of every interface it implements - the interfaces those
    // extend included - either declared here (abstract counts) or inherited from a base class.
    checkInterfaceSatisfaction() {
        Span at = this.node.name().span();
        let checked = new Set<Type>();
        for (let implemented in this.classType.interfaces()) {
            let checkedRequirements = new Set<string>();
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                if (!checked.add(level)) {
                    continue;
                }
                this.checkInterfaceLevelSatisfied(implemented, level, at, checkedRequirements);
            }
        }
    }

    // One rung of an implemented interface's ladder: every method 'level' declares must be
    // provided. A missing inherited requirement names the interface in the ladder declaring it.
    // A requirement an earlier rung redeclares was checked there, so it is skipped here.
    checkInterfaceLevelSatisfied(Type implemented, Type level, Span at, Set<string> checkedRequirements) {
        let methods = typemembers.methodsOf(level);
        if (methods == null) {
            return;
        }
        string interfaceName = this.names.quoted(implemented);
        string levelName = this.names.quoted(level);
        for (long i = 0; i < methods.length(); i++) {
            let required = methods.get(i);
            if (!checkedRequirements.add(quotedMethod(required, this.names))) {
                continue;
            }
            let provided = this.findDeclaring(required.name(), required.signature());
            if (provided == null && (unresolvedCouldProvide(this.classType.methods(), required)
                    || unresolvedCouldProvide(this.visibleBaseMethods(required.name()), required)
                    || this.isOverrideTarget(required))) {
                continue;
            }
            if (provided == null) {
                if (level == implemented) {
                    this.reporter.report("Class {this.names.quotedName(this.classType)} implements "
                        + "{interfaceName} but does not provide "
                        + "{quotedMethod(required, this.names)}. Declare the method, or inherit "
                        + "it from a base class.", at);
                } else {
                    this.reporter.report("Class {this.names.quotedName(this.classType)} implements "
                        + "{interfaceName} but does not provide "
                        + "{quotedMethod(required, this.names)}, required by {levelName}, which "
                        + "{interfaceName} extends. Declare the method, or inherit it from "
                        + "a base class.", at);
                }
                continue;
            }
            if (provided.isConditional()) {
                this.reporter.report("Class {this.names.quotedName(this.classType)} provides "
                    + "{quotedMethod(required, this.names)} only for some type arguments, but "
                    + "{interfaceName} needs it for every type argument. Remove the '<...>' list "
                    + "from '{required.name()}', or stop implementing {interfaceName}.", at);
                continue;
            }
            bool comparable = !unresolvedCouldMatch(required.signature(), provided.signature());
            if (comparable && narrowsReturnShape(required.signature(), provided.signature())) {
                string requiredReturn = quotedReturnType(required.signature(), this.names);
                this.reporter.report("Method '{required.name()}' of "
                    + "{this.names.quotedName(this.classType)} returns "
                    + "{quotedReturnType(provided.signature(), this.names)}, but interface "
                    + "{levelName} requires {requiredReturn}, "
                    + narrowedReturnAdvice(required.signature().returnType(),
                        provided.signature().returnType(), this.names) + ".", at);
            } else if (comparable && !overrideCompatible(required.signature(), provided.signature())) {
                Type requiredType = required.signature().returnType();
                let imported = typenames.importsFor([requiredType], this.names);
                this.reporter.report("Method '{required.name()}' of "
                    + "{this.names.quotedName(this.classType)} returns "
                    + "{quotedReturnType(provided.signature(), this.names)}, but interface "
                    + "{levelName} requires {quotedReturnType(required.signature(), this.names)}. "
                    + typenames.withImportsFirst(imported, "Change the return type of "
                        + "'{required.name()}' to "
                        + "{quotedReturnType(required.signature(), imported.names())}."), at);
            }
            if (required.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{required.name()}' of "
                    + "{this.names.quotedName(this.classType)} must be marked 'noreturn', "
                    + "because interface {levelName} declares it 'noreturn'.", at);
            }
            // Anyone who can name the class, or store one of its values as the interface, can call
            // the method through the interface. So it must be as visible as the class, the same
            // rule 'toString', 'hash', and 'equals' already follow. 'protected' and private share
            // one tier, so the narrowest case is named on its own.
            Visibility requiredReach = types.followedMemberVisibility(this.classType.visibility());
            if (provided.visibility() == Visibility.Private || types.visibilityTier(provided.visibility())
                        < types.visibilityTier(requiredReach)) {
                this.reporter.report("Method '{required.name()}' of "
                    + "{this.names.quotedName(this.classType)} is "
                    + "{types.visibilityWord(provided.visibility())}, but it provides "
                    + "{quotedMethod(required, this.names)} for interface {interfaceName}, so it "
                    + "must be usable everywhere {this.names.quotedName(this.classType)} is. Mark "
                    + "it '{types.visibilityWord(requiredReach)}'.", at);
            }
        }
    }

    // The most derived declaration with the name and parameter types, searching this class and
    // then its concrete base chain.
    findDeclaring(string methodName, Signature signature) -> Method? {
        let own = this.findOwn(this.classType, methodName, signature, true);
        if (own != null) {
            return own;
        }
        return this.findInBase(methodName, signature, true);
    }

    // A concrete class must implement every abstract method it inherits or declares.
    checkAbstractSatisfied() {
        if (this.classType.isAbstract()) {
            return;
        }
        Span at = this.node.name().span();
        let checked = new List<Method>();
        Type? current = this.classType;
        while (current != null) {
            let methods = typemembers.methodsOf(current);
            if (methods == null) {
                break;
            }
            for (long i = 0; i < methods.length(); i++) {
                let method = methods.get(i);
                if (method.isConstructor() || method.isDestructor()) {
                    continue;
                }
                if (members.findSameSignature(checked, method.name(),
                        method.signature()) != null) {
                    continue;
                }
                checked.push(method);
                let declaring = this.findDeclaring(method.name(), method.signature());
                // An abstract method this class declares itself is refused where it is declared.
                if (declaring != null && declaring.isAbstract()
                        && declaring.definingType() != this.classType) {
                    string className = this.names.quotedName(this.classType);
                    this.reporter.report("Class {className} does not override '{method.name()}', "
                        + "an abstract method of {this.names.quoted(declaring.definingType())}. "
                        + "Declare '{method.name()}' in {className} with a body and 'override', "
                        + "or mark {className} 'abstract'.", at);
                }
            }
            current = hierarchy.baseOf(current);
        }
    }
}

// Whether the user can edit the declaration of 'type', which a fix that changes it needs.
editableDeclaration(Type type) -> bool {
    let authority = types.authorityOf(type);
    return authority == null || authority.isEditable();
}

// Params must match exactly, and the return type may be covariant only where narrowing it leaves
// what a caller reads unchanged. A dispatch slot has one calling convention, and a caller holding a
// base reference reads the result at the type the base declared, so two spellings of one pointer
// are interchangeable while a narrower number or a nullable value type is not.
// Whether a type that did not resolve could be the whole difference between the two signatures,
// because they agree wherever both resolved. `base` is the one `derived` replaces, so its return
// type may be wider.
public unresolvedCouldMatch(Signature base, Signature derived) -> bool {
    if (!typemembers.mentionsUnresolved(base) && !typemembers.mentionsUnresolved(derived)) {
        return false;
    }
    let baseParameters = base.parameters();
    let derivedParameters = derived.parameters();
    if (baseParameters.length != derivedParameters.length) {
        return false;
    }
    for (long i = 0; i < baseParameters.length; i++) {
        if (!types.couldBeSame(baseParameters[i].type(), derivedParameters[i].type())) {
            return false;
        }
    }
    Type declared = base.returnType();
    Type actual = derived.returnType();
    if (types.mentionsError(declared) || types.mentionsError(actual)) {
        return types.couldBeSame(declared, actual);
    }
    return convert.isAssignableStrict(declared, actual)
        && (declared == actual || sameReturnShape(declared, actual));
}

// Whether a method named `name` among `replaced` differs from `signature`, the signature of the
// method that replaces it, only where a type did not resolve.
public unresolvedCouldReplace(List<Method>? replaced, string name, Signature signature) -> bool {
    if (replaced == null) {
        return false;
    }
    for (let method in replaced) {
        if (method.name() == name && unresolvedCouldMatch(method.signature(), signature)) {
            return true;
        }
    }
    return false;
}

// The method among `candidates` that an 'override' of `method` matching none of them was most
// likely written for: one of its name that no method among `providers` matches yet, with the
// parameter count closest to its own, the first of those on a tie. Null when there is none.
public intendedOverride(Method method, List<Method> candidates, List<Method> providers)
        -> Method? {
    Method? closest = null;
    long closestDistance = 0;
    long count = method.signature().parameters().length;
    for (let candidate in candidates) {
        if (candidate.name() != method.name() || members.findSameSignature(providers,
                candidate.name(), candidate.signature()) != null) {
            continue;
        }
        long distance = candidate.signature().parameters().length - count;
        if (distance < 0) {
            distance = -distance;
        }
        if (closest == null || distance < closestDistance) {
            closest = candidate;
            closestDistance = distance;
        }
    }
    return closest;
}

// Whether a method among `candidates` named after `requirement` differs from it only where a type
// did not resolve.
public unresolvedCouldProvide(List<Method> candidates, Method requirement) -> bool {
    for (let candidate in candidates) {
        if (candidate.name() == requirement.name()
                && unresolvedCouldMatch(requirement.signature(), candidate.signature())) {
            return true;
        }
    }
    return false;
}

public overrideCompatible(Signature base, Signature derived) -> bool {
    if (!typemembers.sameParameterTypes(base, derived)) {
        return false;
    }
    Type declared = base.returnType();
    Type actual = derived.returnType();
    if (!convert.isAssignableStrict(declared, actual)) {
        return false;
    }
    return declared == actual || sameReturnShape(declared, actual);
}

// True when a value of the override's return type and one of the declared type are held the same
// way, so a caller reading the declared type reads what the override produced.
sameReturnShape(Type declared, Type actual) -> bool {
    return types.isPointerShaped(declared) && types.isPointerShaped(actual);
}

// True when the only thing wrong with the override is that its return type is held differently
// from the declared one. Such a signature is nearly right, so it earns a message about the return
// type rather than one about the whole signature.
public narrowsReturnShape(Signature base, Signature derived) -> bool {
    if (!typemembers.sameParameterTypes(base, derived)) {
        return false;
    }
    Type declared = base.returnType();
    Type actual = derived.returnType();
    if (declared == actual || !convert.isAssignableStrict(declared, actual)) {
        return false;
    }
    return !sameReturnShape(declared, actual);
}

// Why a return type held differently from the declared one is refused, and the fix. The caller
// names the two methods first, because a class override and an interface requirement name
// themselves differently; this is the part they share.
public narrowedReturnAdvice(Type declared, Type actual, TypeNames names) -> string {
    let imported = typenames.importsFor([declared], names);
    string fix = typenames.withImportsFirst(imported, "Return {imported.names().quoted(declared)}");
    if (declared is OptionalType) {
        if (declared.inner() is OptionalType) {
            return "and an override cannot remove one '?' from a type that has two. {fix}";
        }
        return "and an override can remove the '?' only from a class, interface, array, string, "
            + "function or external type, not from a number or a struct. {fix}";
    }
    if (convert.isNumericType(declared) && convert.isNumericType(actual)) {
        return "and an override must return exactly the same number type. {fix}";
    }
    return "and an override must return exactly {names.quoted(declared)}. {fix}";
}

// The refusal of an override whose parameters or return type differ from the method it names,
// with 'owner' naming where that method is declared.
// Removing 'override' is offered only when the parameters differ, which makes the method a
// separate overload; with the same parameters it would hide the declared one.
public mismatchedOverrideMessage(Method method, Method declared, string owner, TypeNames names)
        -> string {
    string name = method.name();
    string fix = "Change this '{name}' to match it.";
    if (!typemembers.sameParameterTypes(method.signature(), declared.signature())) {
        fix = "Change this '{name}' to match it, or remove 'override'.";
    }
    return "Override of '{name}' is {quotedMethod(method, names)}, but the '{name}' "
        + "declared in {owner} is {quotedMethod(declared, names)}. {fix}";
}

// The signature in quotes as an interface requirement reads: 'speak(int) -> string'. A type that
// did not resolve is spelled the way its declaration writes it.
public quotedMethod(Method method, TypeNames names) -> string {
    let signature = method.signature();
    let code = new QuotedCode();
    code.write("{method.name()}(");
    let parameters = signature.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            code.write(", ");
        }
        let type = parameters[i].type();
        string? written = null;
        if (types.mentionsError(type)) {
            written = writtenParameterType(signature, i);
        }
        if (written != null) {
            code.write(written);
        } else {
            code.writeType(type);
        }
    }
    code.write(")");
    let returned = signature.returnType();
    if (!types.isVoidType(returned)) {
        code.write(" -> ");
        string? written = null;
        if (types.mentionsError(returned)) {
            written = writtenReturnType(signature);
        }
        if (written != null) {
            code.write(written);
        } else {
            code.writeType(returned);
        }
    }
    return code.quotedFor(names);
}

// The return type of the signature in quotes. A type that did not resolve is spelled the way its
// declaration writes it.
public quotedReturnType(Signature signature, TypeNames names) -> string {
    let returned = signature.returnType();
    if (types.mentionsError(returned)) {
        let written = writtenReturnType(signature);
        if (written != null) {
            return "'{written}'";
        }
    }
    return names.quoted(returned);
}

// The type of parameter `index` as the signature's declaration writes it, or null when no
// declaration writes one.
writtenParameterType(Signature signature, long index) -> string? {
    let declaration = declarationOf(signature);
    if (declaration == null) {
        return null;
    }
    let parameters = declaration.parameters();
    if (index >= parameters.parametersCount()) {
        return null;
    }
    let written = parameters.parameters(index).declaredType();
    if (written == null) {
        return null;
    }
    return wording.greenSpelling(written.green());
}

// The return type as the signature's declaration writes it, or null when no declaration writes
// one.
writtenReturnType(Signature signature) -> string? {
    let declaration = declarationOf(signature);
    if (declaration == null) {
        return null;
    }
    let clause = declaration.returnType();
    if (clause == null) {
        return null;
    }
    return wording.greenSpelling(clause.returnedType().green());
}

declarationOf(Signature signature) -> FunctionDeclarationNode? {
    let green = signature.declaration();
    if (green == null) {
        return null;
    }
    return factory.createRoot(green) as? FunctionDeclarationNode;
}
