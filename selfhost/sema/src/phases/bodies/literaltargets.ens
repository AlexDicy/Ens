// The type each literal is checked against while the code around it is analyzed, and the records
// that state keeps for joins, literal ranges, origins and fixes.
import SyntaxNode from @ens.frontend.syntax.node;
import Expression from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import model.convert;
import Parameter from model.typemembers;
import Type from model.types;
import FunctionType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;
import phases.bodies.literalfixes;
import ChosenParameter from phases.bodies.functioncalls;

// What sets the type a literal adapts to: a declaration, a return type, the parameter a value is
// passed to, or the left side of '??'.
public enum OriginKind {
    Declared,
    Returned,
    Parameter,
    Fallback,
}

// Where the type a literal adapts to is set, for the fix after a literal that does not fit it. The
// fields name the declaration, callee, struct or constructed type, and the statement an example shows.
public final class LiteralOrigin {
    protected OriginKind originKind;
    protected string originName;
    protected string ownerName;
    protected Type declaredType;
    protected string constructedQuoted = "";
    protected string fieldOwnerQuoted = "";
    protected SyntaxNode? exampleStatement = null;
    protected Expression? wholeValue = null;
    protected bool isElement = false;

    public constructor(this.originKind, this.originName, this.ownerName, this.declaredType);

    public kind() -> OriginKind {
        return this.originKind;
    }

    public name() -> string {
        return this.originName;
    }

    public owner() -> string {
        return this.ownerName;
    }

    public declared() -> Type {
        return this.declaredType;
    }

    public quotedConstructed() -> string {
        return this.constructedQuoted;
    }

    public quotedFieldOwner() -> string {
        return this.fieldOwnerQuoted;
    }

    public statement() -> SyntaxNode? {
        return this.exampleStatement;
    }

    public whole() -> Expression? {
        return this.wholeValue;
    }

    public forElement() -> bool {
        return this.isElement;
    }

    public setQuotedFieldOwner(string value) {
        this.fieldOwnerQuoted = value;
    }

    public setQuotedConstructed(string value) {
        this.constructedQuoted = value;
    }

    public setStatement(SyntaxNode? value) {
        this.exampleStatement = value;
    }

    public setWhole(Expression? value) {
        this.wholeValue = value;
    }

    public setForElement(bool value) {
        this.isElement = value;
    }
}

// A numeric literal whose value its own default type cannot hold, reported once the module's bodies
// are checked, because a target-typed position retypes a literal and judges it there. 'fix' is the
// advice the report ends with when the code around the literal gives one.
public final class PendingLiteralRange {
    protected GreenNode literalGreen;
    protected Span literalSpan;
    protected PrimitiveType ownType;
    protected string literalText;
    protected bool isNegative;
    protected bool isParsed;
    protected ulong literalMagnitude;
    protected string fixText = "";

    public constructor(this.literalGreen, this.literalSpan, this.ownType, this.literalText, this.isNegative,
                this.isParsed, this.literalMagnitude);

    public moveTo(GreenNode green, Span span, bool negative) {
        this.literalGreen = green;
        this.literalSpan = span;
        this.isNegative = negative;
    }

    public green() -> GreenNode {
        return this.literalGreen;
    }

    public span() -> Span {
        return this.literalSpan;
    }

    public defaultType() -> PrimitiveType {
        return this.ownType;
    }

    public text() -> string {
        return this.literalText;
    }

    public negative() -> bool {
        return this.isNegative;
    }

    public parsed() -> bool {
        return this.isParsed;
    }

    public magnitude() -> ulong {
        return this.literalMagnitude;
    }

    public fix() -> string {
        return this.fixText;
    }

    public setFix(string value) {
        this.fixText = value;
    }
}

// A number literal too large for the type 'narrow', spelled 'narrowName', and the type 'wider' that
// takes it, which is empty when no type does. 'negative' and 'magnitude' give an integer's value.
// 'joined' marks a literal beside a value of type 'narrow', whose every value 'wider' has as well.
public final class Widening {
    protected PrimitiveKind narrowKind;
    protected string narrowSpelling;
    protected string widerName;
    protected bool isNegative;
    protected ulong literalMagnitude;
    protected bool isJoined = false;
    // The most negative and the largest literal of the join it stands in, which the wider type takes
    // too; 'beyond' marks a literal no integer type takes.
    protected bool isLowNegative = false;
    protected ulong lowMagnitude = 0;
    protected ulong highMagnitude = 0;
    protected bool isBeyond = false;
    protected List<Expression>? joinLiterals = null;

    public constructor(this.narrowKind, this.narrowSpelling, this.widerName, this.isNegative,
                       this.literalMagnitude);

    public narrow() -> PrimitiveKind {
        return this.narrowKind;
    }

    public narrowName() -> string {
        return this.narrowSpelling;
    }

    public wider() -> string {
        return this.widerName;
    }

    public negative() -> bool {
        return this.isNegative;
    }

    public magnitude() -> ulong {
        return this.literalMagnitude;
    }

    public joined() -> bool {
        return this.isJoined;
    }

    public lowNegative() -> bool {
        return this.isLowNegative;
    }

    public low() -> ulong {
        return this.lowMagnitude;
    }

    public high() -> ulong {
        return this.highMagnitude;
    }

    public beyond() -> bool {
        return this.isBeyond;
    }

    public literals() -> List<Expression>? {
        return this.joinLiterals;
    }

    public setWider(string value) {
        this.widerName = value;
    }

    public setJoined(bool value) {
        this.isJoined = value;
    }

    public setLowNegative(bool value) {
        this.isLowNegative = value;
    }

    public setLow(ulong value) {
        this.lowMagnitude = value;
    }

    public setHigh(ulong value) {
        this.highMagnitude = value;
    }

    public setBeyond(bool value) {
        this.isBeyond = value;
    }

    public setLiterals(List<Expression>? value) {
        this.joinLiterals = value;
    }
}

// A literal of a join that does not fit the type it was given, kept until the whole join is analyzed
// so that every literal of the join is judged together.
public final class JoinFailure {
    protected Span literalSpan;
    protected string writtenText;
    protected string literalText;
    protected bool isNegative;
    protected ulong literalMagnitude;
    protected PrimitiveType targetType;
    protected LiteralOrigin? targetOrigin;
    // Set when the literal takes its type from another untyped literal beside it, or from nothing.
    protected bool isBesideLiteral = false;
    // For a literal that takes its type 'toward' from the value 'beside' in an array literal: the
    // literal, and the target and origin the array is checked against.
    protected Expression? literalNode = null;
    protected Expression? besideValue = null;
    protected Type? towardType = null;
    protected Type? fixTargetType = null;
    protected LiteralOrigin? fixTargetOrigin = null;

    public constructor(this.literalSpan, this.writtenText, this.literalText, this.isNegative,
                       this.literalMagnitude, this.targetType, this.targetOrigin);

    // A literal that takes its type from the value beside it in an array literal, as 'fix' names it.
    public constructor(this.literalSpan, this.writtenText, this.literalText, this.isNegative,
                       this.literalMagnitude, this.targetType, Expression literal, JoinText fix) {
        this.targetOrigin = null;
        this.literalNode = literal;
        this.besideValue = fix.besideValue;
        this.towardType = fix.towardType;
        this.fixTargetType = fix.fixTargetType;
        this.fixTargetOrigin = fix.fixTargetOrigin;
    }

    public span() -> Span {
        return this.literalSpan;
    }

    public written() -> string {
        return this.writtenText;
    }

    public text() -> string {
        return this.literalText;
    }

    public negative() -> bool {
        return this.isNegative;
    }

    public magnitude() -> ulong {
        return this.literalMagnitude;
    }

    public target() -> PrimitiveType {
        return this.targetType;
    }

    public origin() -> LiteralOrigin? {
        return this.targetOrigin;
    }

    public besideLiteral() -> bool {
        return this.isBesideLiteral;
    }

    public literal() -> Expression? {
        return this.literalNode;
    }

    public beside() -> Expression? {
        return this.besideValue;
    }

    public toward() -> Type? {
        return this.towardType;
    }

    public fixTarget() -> Type? {
        return this.fixTargetType;
    }

    public fixOrigin() -> LiteralOrigin? {
        return this.fixTargetOrigin;
    }

    public setBesideLiteral(bool value) {
        this.isBesideLiteral = value;
    }
}

// An element of an array literal that does not fit the element type, kept until the whole join is
// analyzed, because the refusal of a literal of the join covers it.
public final class HeldMismatch {
    protected string heldMessage;
    protected Span heldSpan;

    public constructor(this.heldMessage, this.heldSpan);

    public message() -> string {
        return this.heldMessage;
    }

    public span() -> Span {
        return this.heldSpan;
    }
}

// The join analysis was in before a join began: its outermost join, and the literals and elements it
// kept.
public final class JoinScope {
    protected Expression? root;
    protected List<JoinFailure> failures;
    protected List<HeldMismatch> mismatches;
    protected bool wasCreated;

    protected constructor(this.root, this.failures, this.mismatches, this.wasCreated);

    public created() -> bool {
        return this.wasCreated;
    }
}

// The text after a literal that takes its type from the value beside it in a join or an operator:
// the fix, and the sentence that says where the type comes from.
public final class JoinText {
    protected string fixText;
    protected string whyText;
    protected string clauseText = "";
    // The literals of the join the fix covers, which get no report of their own.
    protected List<Expression>? coveredLiterals = null;
    // Set for a literal of an array literal, whose refusal waits for the whole array: the value the
    // literal takes its type 'toward' from, and the target and origin the array is checked against.
    protected Expression? besideValue = null;
    protected Type? towardType = null;
    protected Type? fixTargetType = null;
    protected LiteralOrigin? fixTargetOrigin = null;

    public constructor(this.fixText, this.whyText);

    public fix() -> string {
        return this.fixText;
    }

    public why() -> string {
        return this.whyText;
    }

    public clause() -> string {
        return this.clauseText;
    }

    public covered() -> List<Expression>? {
        return this.coveredLiterals;
    }

    public toward() -> Type? {
        return this.towardType;
    }

    public setClause(string value) {
        this.clauseText = value;
    }

    public setCovered(List<Expression>? value) {
        this.coveredLiterals = value;
    }

    public setBeside(Expression? value) {
        this.besideValue = value;
    }

    public setToward(Type? value) {
        this.towardType = value;
    }

    public setFixTarget(Type? value) {
        this.fixTargetType = value;
    }

    public setFixOrigin(LiteralOrigin? value) {
        this.fixTargetOrigin = value;
    }
}

// A refusal of a literal in a '?:' branch or a switch arm, held until the join knows its other
// branches. Beside a nullable 'float' branch it ends after the why, or names the branch for a
// 'float' literal beside 'beside'.
public final class DeferredLiteralFix {
    protected Span fixSpan;
    protected string fixMessage;
    protected string plainMessage;
    protected PendingLiteralRange? suffixedRange;
    protected string suffixText;
    protected string besideSpelling = "";
    protected string besideTypeQuoted = "";
    protected bool isSettled = false;
    // Set for an argument of a call with several candidates, whose parameter settles the fix.
    // 'refusal' and 'clause' build the sentence that names a parameter of the literal's type.
    protected bool isAwaitingParameter = false;
    protected string refusalText = "";
    protected string clauseText = "";
    protected Widening? heldWidening = null;

    public constructor(this.fixSpan, this.fixMessage, this.plainMessage, this.suffixedRange, this.suffixText);

    public span() -> Span {
        return this.fixSpan;
    }

    public message() -> string {
        return this.fixMessage;
    }

    public plain() -> string {
        return this.plainMessage;
    }

    public suffixed() -> PendingLiteralRange? {
        return this.suffixedRange;
    }

    public suffix() -> string {
        return this.suffixText;
    }

    public beside() -> string {
        return this.besideSpelling;
    }

    public quotedBesideType() -> string {
        return this.besideTypeQuoted;
    }

    public settled() -> bool {
        return this.isSettled;
    }

    public awaitingParameter() -> bool {
        return this.isAwaitingParameter;
    }

    public refusal() -> string {
        return this.refusalText;
    }

    public clause() -> string {
        return this.clauseText;
    }

    public widening() -> Widening? {
        return this.heldWidening;
    }

    public setMessage(string value) {
        this.fixMessage = value;
    }

    public setBeside(string value) {
        this.besideSpelling = value;
    }

    public setQuotedBesideType(string value) {
        this.besideTypeQuoted = value;
    }

    public setSettled(bool value) {
        this.isSettled = value;
    }

    public setAwaitingParameter(bool value) {
        this.isAwaitingParameter = value;
    }

    public setRefusal(string value) {
        this.refusalText = value;
    }

    public setClause(string value) {
        this.clauseText = value;
    }

    public setWidening(Widening? value) {
        this.heldWidening = value;
    }
}

// The targets a literal is judged against while the code around it is analyzed: the expression
// about to be analyzed without its target, the join its values are in, and the refusals held until
// a join or a call settles them.
public final class LiteralTargets {
    // Where the type of the lambda being analyzed is declared, while it is analyzed toward a target.
    LiteralOrigin? lambdaOrigin;
    // The untyped local whose initializer is the array literal about to be analyzed.
    string? arrayHolder;
    // The arithmetic expression or the join about to be analyzed without the target its value is
    // checked against, with that target and the origin where it is set.
    GreenNode? stashedBinary;
    Type? stashedBinaryTarget;
    LiteralOrigin? stashedBinaryOrigin;
    GreenNode? stashedJoin;
    Type? stashedJoinTarget;
    LiteralOrigin? stashedJoinOrigin;
    // The member read or name about to be analyzed where a function type is expected, and that type.
    GreenNode? stashedNamed;
    FunctionType? stashedFunction;
    // The outermost '?:' or switch expression whose values are being analyzed, and the nested one
    // about to be analyzed as one of its values.
    Expression? outermostJoin;
    GreenNode? nestedJoin;
    List<JoinFailure> heldFailures;
    List<HeldMismatch> heldMismatches;
    // Set while a literal adapts to the type of an untyped literal beside it.
    bool isBesideLiteral;
    // The arithmetic expression whose operands are being adapted, with its target and origin.
    BinaryExpressionNode? adaptingBinary;
    Type? adaptingTarget;
    LiteralOrigin? adaptingOrigin;
    // The refusals held for the '?:' branch or switch arm being analyzed, or null outside one.
    List<DeferredLiteralFix>? heldFixes;
    // The arguments of the call being analyzed whose type reaches the call's result.
    List<Span> flowingSpans;
    // True while an argument of a call with several candidates is analyzed before one is chosen,
    // and the parameters the chosen candidate gave the call's arguments.
    bool isAwaitingParameter;
    List<ChosenParameter> chosen;

    List<PendingLiteralRange> pendingRanges;
    // Literals whose join was refused with a fix that covers them, so they get no report of their own.
    List<GreenNode> covered;

    public constructor() {
        this.arrayHolder = null;
        this.lambdaOrigin = null;
        this.stashedBinary = null;
        this.stashedBinaryTarget = null;
        this.stashedBinaryOrigin = null;
        this.stashedJoin = null;
        this.stashedJoinTarget = null;
        this.stashedJoinOrigin = null;
        this.stashedNamed = null;
        this.stashedFunction = null;
        this.outermostJoin = null;
        this.nestedJoin = null;
        this.heldFailures = new List<JoinFailure>();
        this.heldMismatches = new List<HeldMismatch>();
        this.isBesideLiteral = false;
        this.adaptingBinary = null;
        this.adaptingTarget = null;
        this.adaptingOrigin = null;
        this.heldFixes = null;
        this.flowingSpans = new List<Span>();
        this.isAwaitingParameter = false;
        this.chosen = new List<ChosenParameter>();
        this.pendingRanges = new List<PendingLiteralRange>();
        this.covered = new List<GreenNode>();
    }

    // Records 'target' and 'origin' for the arithmetic expression or the join under 'value', which
    // is analyzed without a target. Parentheses and a sign pass them on. A member read or a name
    // keeps a target that is a function type.
    public stash(Expression value, Type? target, LiteralOrigin? origin) {
        if (target == null) {
            return;
        }
        let wanted = convert.coreOf(target);
        if ((value is MemberExpressionNode || value is IdentifierExpressionNode) && wanted is FunctionType) {
            this.stashedNamed = value.green();
            this.stashedFunction = wanted;
            return;
        }
        Expression core = literalfixes.operandCore(value);
        if (core is BinaryExpressionNode) {
            this.stashedBinary = core.green();
            this.stashedBinaryTarget = target;
            this.stashedBinaryOrigin = origin;
        } else if (core is TernaryExpressionNode || core is SwitchExpressionNode) {
            this.stashedJoin = core.green();
            this.stashedJoinTarget = target;
            this.stashedJoinOrigin = origin;
        }
    }

    public clearStash() {
        this.stashedBinary = null;
        this.stashedBinaryTarget = null;
        this.stashedBinaryOrigin = null;
        this.stashedJoin = null;
        this.stashedJoinTarget = null;
        this.stashedJoinOrigin = null;
        this.stashedNamed = null;
        this.stashedFunction = null;
    }

    public clearBinaryStash() {
        this.stashedBinary = null;
        this.stashedBinaryTarget = null;
        this.stashedBinaryOrigin = null;
    }

    public enterOperands(BinaryExpressionNode node, Type? target, LiteralOrigin? origin) {
        this.adaptingBinary = node;
        this.adaptingTarget = target;
        this.adaptingOrigin = origin;
    }

    public leaveOperands() {
        this.adaptingBinary = null;
        this.adaptingTarget = null;
        this.adaptingOrigin = null;
    }

    // Makes 'join' the join its values are analyzed in, unless it is a value of the current one and
    // not 'alone', and returns what to restore afterwards.
    public beginJoin(Expression join, bool alone) -> JoinScope {
        let scope = new JoinScope(this.outermostJoin, this.heldFailures, this.heldMismatches, false);
        if (alone || this.outermostJoin == null || this.nestedJoin != join.green()) {
            this.outermostJoin = join;
            this.heldFailures = new List<JoinFailure>();
            this.heldMismatches = new List<HeldMismatch>();
            scope.wasCreated = true;
        }
        this.nestedJoin = null;
        return scope;
    }

    // Restores the join that was current before 'scope' began.
    public endJoin(JoinScope scope) {
        this.outermostJoin = scope.root;
        this.heldFailures = scope.failures;
        this.heldMismatches = scope.mismatches;
    }

    public setJoinChild(GreenNode child) {
        this.nestedJoin = child;
    }

    public resetPendingLiteralRanges() {
        this.pendingRanges = new List<PendingLiteralRange>();
    }

    public lambdaHolder() -> LiteralOrigin? {
        return this.lambdaOrigin;
    }

    public setLambdaHolder(LiteralOrigin? value) {
        this.lambdaOrigin = value;
    }

    public arrayHolderName() -> string? {
        return this.arrayHolder;
    }

    public setArrayHolderName(string? value) {
        this.arrayHolder = value;
    }

    public binaryNode() -> GreenNode? {
        return this.stashedBinary;
    }

    public binaryTarget() -> Type? {
        return this.stashedBinaryTarget;
    }

    public binaryOrigin() -> LiteralOrigin? {
        return this.stashedBinaryOrigin;
    }

    public joinNode() -> GreenNode? {
        return this.stashedJoin;
    }

    // The function type the member read or name 'node' is expected to have, or null where none is.
    public functionTargetOf(GreenNode node) -> FunctionType? {
        if (this.stashedNamed != node) {
            return null;
        }
        return this.stashedFunction;
    }

    public joinTarget() -> Type? {
        return this.stashedJoinTarget;
    }

    public joinOrigin() -> LiteralOrigin? {
        return this.stashedJoinOrigin;
    }

    public joinRoot() -> Expression? {
        return this.outermostJoin;
    }

    public joinFailures() -> List<JoinFailure> {
        return this.heldFailures;
    }

    public setJoinFailures(List<JoinFailure> failures) {
        this.heldFailures = failures;
    }

    public joinMismatches() -> List<HeldMismatch> {
        return this.heldMismatches;
    }

    public besideLiteral() -> bool {
        return this.isBesideLiteral;
    }

    public setBesideLiteral(bool value) {
        this.isBesideLiteral = value;
    }

    public operandJoin() -> BinaryExpressionNode? {
        return this.adaptingBinary;
    }

    public operandTarget() -> Type? {
        return this.adaptingTarget;
    }

    public operandOrigin() -> LiteralOrigin? {
        return this.adaptingOrigin;
    }

    public deferredFixes() -> List<DeferredLiteralFix>? {
        return this.heldFixes;
    }

    public setDeferredFixes(List<DeferredLiteralFix>? value) {
        this.heldFixes = value;
    }

    public flowingArguments() -> List<Span> {
        return this.flowingSpans;
    }

    public setFlowingArguments(List<Span> value) {
        this.flowingSpans = value;
    }

    public awaitingParameter() -> bool {
        return this.isAwaitingParameter;
    }

    public setAwaitingParameter(bool value) {
        this.isAwaitingParameter = value;
    }

    public chosenParameters() -> List<ChosenParameter> {
        return this.chosen;
    }

    public setChosenParameters(List<ChosenParameter> parameters) {
        this.chosen = parameters;
    }

    public pendingLiteralRanges() -> List<PendingLiteralRange> {
        return this.pendingRanges;
    }

    public coveredLiterals() -> List<GreenNode> {
        return this.covered;
    }
}
