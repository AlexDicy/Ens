// Which locals and fields are definitely assigned on each path, and in a constructor the places
// the body can throw from with the fields assigned there.
import Span from @ens.frontend.support.source;
import SyntaxNode from @ens.frontend.syntax.node;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import Reporter from support.diagnostics;
import LocalBinding from model.scopes;
import model.convert;
import model.typemembers;
import Field from model.typemembers;
import TypeNames from model.typenames;
import Type from model.types;
import model.types;
import ErrorType from model.types;
import ConstructorCatch from result;
import ThisUse from result;
import ThisUseKind from result;
import CatchThisUse from result;
import EscapeGap from result;
import CatchFinish from result;
import phases.bodies.unassigneduses;
import BaseContext from phases.bodies.unassigneduses;
import LateSuper from phases.bodies.unassigneduses;
import LateWrite from phases.bodies.unassigneduses;
import LateCall from phases.bodies.unassigneduses;
import FeedingWrite from phases.bodies.unassigneduses;
import BaseArgument from phases.bodies.unassigneduses;
import BaseRun from phases.bodies.unassigneduses;
import Reordering from phases.bodies.reordering;
import model.hierarchy;
import phases.bodies.wording;
import List from @std.collections.list;

// An assignment to one field of 'this', kept with the place that wrote it, so a second
// assignment to a 'const' field can point back at an earlier one.
public final class FieldWrite {
    protected Field field;
    protected Span writeSpan;

    protected constructor(this.field, this.writeSpan);

    public span() -> Span {
        return this.writeSpan;
    }
}

// A place the constructor body can throw from, a call or a 'throw' statement, with the fields
// definitely assigned there and whether the base class is built there on every path.
final class EscapePoint {
    SyntaxNode escape;
    List<Field> assigned;
    bool baseBuilt;

    constructor(this.escape, this.assigned, this.baseBuilt);
}

// A snapshot of definite-assignment state at one program point: the locals and this-fields
// assigned so far, the this-field assignments that may have run on some path reaching it, whether
// the base class is built on every path, the 'super(...)' that may have built it on one and every
// such call, the held refusals that no 'super(...)' has followed on a path reaching it, and
// whether the path has already left through a return, throw, break, continue, or panic.
public final class AssignmentFlow {
    protected List<LocalBinding> assigned;
    protected List<Field> assignedFields;
    protected List<FieldWrite> maybeAssignedWrites;
    protected bool baseBuilt;
    protected Span? baseCall;
    protected List<LateCall> superCalls;
    protected List<HeldRefusal> pendingRefusals;
    protected bool isTerminated;

    protected constructor(this.assigned, this.assignedFields, this.maybeAssignedWrites,
        this.baseBuilt, this.baseCall, this.superCalls, this.pendingRefusals, this.isTerminated);

    public terminated() -> bool {
        return this.isTerminated;
    }
}

// Which locals and own fields are definitely assigned on the path being checked, which own
// fields may already be assigned, and the states that leave the loops around it through 'break'.
public final class AssignmentState {
    Reporter reporter;
    TypeNames names;

    List<LocalBinding> assignedLocals;
    List<LocalBinding> trackedLocals;
    List<List<AssignmentFlow>> breakFlows;
    bool flowTerminated;
    bool isUnconditional;
    LocalBinding? targetBinding;

    // The class whose constructor body is being analyzed, or null outside a constructor, with the
    // fields definitely assigned on the current flow, every inherited one once the base class is
    // built, and the assignments made before the body runs.
    Type? fieldOwner;
    List<Field> assignedThisFields;
    List<FieldWrite> ctorSeededThisWrites;

    // The assignments that may have run on a path reaching here, which hold a 'const' field to one
    // write, and that set wherever an exception can leave the body, for the catch clauses.
    List<FieldWrite> maybeAssignedThisWrites;
    List<FieldWrite> ctorEscapedMaybeWrites;

    // The own fields with a use already refused, which the end of a path does not report again,
    // and the fields reported missing on the current path.
    List<Field> refusedThisFields;
    List<Field> reportedFields;

    // How the paths checked since the body or the current catch clause began finish the
    // constructor: by reaching its end, through these returns, and the 'super(...)' calls in it.
    bool endReached;
    List<Span> finishingReturnSpans;
    List<Span> catchSuperCallSpans;

    // Each place the body can throw from with the fields assigned there, and the calls the
    // innermost 'try' being checked covers.
    List<EscapePoint> escapePoints;
    List<CallExpressionNode> triedCalls;

    // Whether a catch clause is being checked, with what it does that the exceptions phase judges
    // against what it catches: its uses of 'this' and its finishes without a field.
    bool onCatchPath;
    List<CatchThisUse> catchThisUses;
    List<CatchFinish> catchFinishes;

    // Whether the base class is built on every path reaching here, and the 'super(...)' that may
    // have built it on one. 'buildsBaseAtExit' says the body writes no 'super(...)', and
    // 'baseUnbuildable' that its base class then has no constructor to be built with.
    bool baseBuilt;
    Span? baseCall;
    bool buildsBaseAtExit;
    bool baseUnbuildable;

    // Whether the arguments of 'super(...)' are being checked, whether a use of 'this' before the
    // base class is built is refused already, and whether a 'super(...)' is refused for its place.
    bool inSuperArguments;
    bool baseUseReported;
    bool superCallRefused;

    // Every 'super(...)' that may have run on a path reaching here, and the ones before which own
    // fields had no value, with the assignments after them.
    List<LateCall> superCalls;
    LateSuper lateSuper;

    // The refusals reported once the body is checked, because their fixes name the 'super(...)'
    // calls after them, and the ones no 'super(...)' has followed yet on the path being checked.
    List<HeldRefusal> heldRefusals;
    List<HeldRefusal> pendingRefusals;

    // The statements refused for reading a base field, a group for each field, and the base fields
    // a 'this.field' parameter of the constructor assigns once the base class is built.
    List<FeedingGroup> feedingGroups;
    List<string> boundBaseFields;

    // What judges where a fix can move the code of the constructor being checked.
    Reordering? reorder;

    public constructor(Reporter reporter, TypeNames names) {
        this.reporter = reporter;
        this.names = names;
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.isUnconditional = true;
        this.targetBinding = null;
        this.fieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisWrites = new List<FieldWrite>();
        this.maybeAssignedThisWrites = new List<FieldWrite>();
        this.ctorEscapedMaybeWrites = new List<FieldWrite>();
        this.refusedThisFields = new List<Field>();
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.escapePoints = new List<EscapePoint>();
        this.onCatchPath = false;
        this.catchThisUses = new List<CatchThisUse>();
        this.reportedFields = new List<Field>();
        this.triedCalls = new List<CallExpressionNode>();
        this.catchFinishes = new List<CatchFinish>();
        this.baseBuilt = true;
        this.baseCall = null;
        this.buildsBaseAtExit = false;
        this.baseUnbuildable = false;
        this.inSuperArguments = false;
        this.baseUseReported = false;
        this.superCallRefused = false;
        this.superCalls = new List<LateCall>();
        this.lateSuper = new LateSuper();
        this.heldRefusals = new List<HeldRefusal>();
        this.pendingRefusals = new List<HeldRefusal>();
        this.feedingGroups = new List<FeedingGroup>();
        this.boundBaseFields = new List<string>();
        this.reorder = null;
    }

    public reset() {
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.isUnconditional = true;
        this.targetBinding = null;
        this.fieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisWrites = new List<FieldWrite>();
        this.maybeAssignedThisWrites = new List<FieldWrite>();
        this.ctorEscapedMaybeWrites = new List<FieldWrite>();
        this.refusedThisFields = new List<Field>();
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.escapePoints = new List<EscapePoint>();
        this.onCatchPath = false;
        this.catchThisUses = new List<CatchThisUse>();
        this.reportedFields = new List<Field>();
        this.triedCalls = new List<CallExpressionNode>();
        this.catchFinishes = new List<CatchFinish>();
        this.baseBuilt = true;
        this.baseCall = null;
        this.buildsBaseAtExit = false;
        this.baseUnbuildable = false;
        this.inSuperArguments = false;
        this.baseUseReported = false;
        this.superCallRefused = false;
        this.superCalls = new List<LateCall>();
        this.lateSuper = new LateSuper();
        this.heldRefusals = new List<HeldRefusal>();
        this.pendingRefusals = new List<HeldRefusal>();
        this.feedingGroups = new List<FeedingGroup>();
        this.boundBaseFields = new List<string>();
        this.reorder = null;
    }

    // The state inside a lambda's body: the enclosing locals' assignments carry in, and it is
    // outside any loop and any constructor.
    public forLambda() -> AssignmentState {
        let derived = new AssignmentState(this.reporter, this.names);
        derived.assignedLocals = this.copyBindings(this.assignedLocals);
        derived.trackedLocals = this.copyBindings(this.trackedLocals);
        derived.assignedThisFields = this.assignedThisFields;
        derived.ctorSeededThisWrites = this.ctorSeededThisWrites;
        derived.maybeAssignedThisWrites = this.maybeAssignedThisWrites;
        derived.ctorEscapedMaybeWrites = this.ctorEscapedMaybeWrites;
        derived.refusedThisFields = this.refusedThisFields;
        return derived;
    }

    public constructorFieldOwner() -> Type? {
        return this.fieldOwner;
    }

    // What judges where a fix can move the code of the constructor being checked, or null outside
    // one.
    public reordering() -> Reordering? {
        return this.reorder;
    }

    public unconditionalPosition() -> bool {
        return this.isUnconditional;
    }

    public setUnconditionalPosition(bool unconditional) {
        this.isUnconditional = unconditional;
    }

    public assignmentTarget() -> LocalBinding? {
        return this.targetBinding;
    }

    public setAssignmentTarget(LocalBinding? target) {
        this.targetBinding = target;
    }

    // Whether the path being checked has already left through a return, a throw, a 'break', a 'continue'
    // or a call that never returns.
    public terminated() -> bool {
        return this.flowTerminated;
    }

    public terminate() {
        this.flowTerminated = true;
    }

    public beginLoop() {
        this.breakFlows.push(new List<AssignmentFlow>());
    }

    public endLoop() -> List<AssignmentFlow> {
        return this.breakFlows.pop();
    }

    public noteBreak() {
        if (!this.flowTerminated && this.breakFlows.length() > 0) {
            this.breakFlows.get(this.breakFlows.length() - 1).push(this.snapshot());
        }
        this.flowTerminated = true;
    }

    // Starts the constructor of receiver, whose base class is built by a 'super(...)' in the body,
    // or where it finishes when 'buildsBaseAtExit' says the body writes none outside lambdas. A
    // base class such a body cannot build is refused with each use of it where 'writesNoSuper' says
    // it writes none at all, and otherwise the body is checked as if built.
    public enterConstructor(Type receiver, bool buildsBaseAtExit, bool writesNoSuper,
            Reordering reorder) {
        this.fieldOwner = receiver;
        this.reorder = reorder;
        let chain = typemembers.implicitBaseConstructor(receiver);
        this.baseBuilt = hierarchy.baseOf(receiver) == null;
        this.baseCall = null;
        this.buildsBaseAtExit = buildsBaseAtExit;
        this.baseUseReported = false;
        this.superCallRefused = false;
        this.superCalls = new List<LateCall>();
        this.lateSuper = new LateSuper();
        this.heldRefusals = new List<HeldRefusal>();
        this.pendingRefusals = new List<HeldRefusal>();
        this.feedingGroups = new List<FeedingGroup>();
        this.boundBaseFields = new List<string>();
        bool unchosen = buildsBaseAtExit && chain.owner() != null && chain.chosen() == null;
        this.baseUnbuildable = unchosen && writesNoSuper;
        if (unchosen && !writesNoSuper) {
            this.markBaseConstructed();
        }
    }

    public enterSuperArguments() -> bool {
        bool outer = this.inSuperArguments;
        this.inSuperArguments = true;
        return outer;
    }

    public leaveSuperArguments(bool outer) {
        this.inSuperArguments = outer;
    }

    // The 'super(...)' 'call', spelled 'spelled', builds the base class here, from 'arguments', and
    // runs what 'run' describes. One that may already have run on a path reaching it is refused, and
    // so is one before which an own field that needs a value has none.
    public noteSuperCall(CallExpressionNode call, string spelled, List<BaseArgument> arguments,
            BaseRun run) {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let earlier = this.baseCall;
        if (earlier != null) {
            this.reporter.report(unassigneduses.repeatedSuperCallRefusal(owner, this.baseBuilt,
                this.names), call.span());
            this.markBaseConstructed();
            return;
        }
        let missing = this.unassignedOwnFields(owner, true);
        let noted = new LateCall(call, spelled, missing, arguments, run);
        if (missing.length() > 0) {
            this.lateSuper.calls.push(noted);
        }
        for (let held in this.pendingRefusals) {
            if (!held.calls.contains(noted)) {
                held.calls.push(noted);
            }
        }
        this.pendingRefusals = new List<HeldRefusal>();
        this.superCalls = new List<LateCall>();
        this.superCalls.push(noted);
        this.baseCall = call.span();
        this.markBaseConstructed();
    }

    // The 'super(...)' calls on paths reaching here before which 'field' had no value and after
    // which no assignment to it is kept yet. Empty where an assignment to 'field' here is no late
    // one.
    public lateCallsAwaiting(Field field) -> List<LateCall> {
        let calls = new List<LateCall>();
        if (this.onCatchPath) {
            return calls;
        }
        for (let call in this.superCalls) {
            if (call.fields.contains(field) && !this.lateSuper.covers(field, call)) {
                calls.push(call);
            }
        }
        return calls;
    }

    // Whether a 'super(...)' on a path reaching here ran with 'field' assigned.
    public assignedAtSuperCall(Field field) -> bool {
        for (let call in this.superCalls) {
            if (!call.fields.contains(field)) {
                return true;
            }
        }
        return false;
    }

    // Keeps 'write', an assignment to an own field after 'super(...)', for the refusal of the calls.
    public noteLateWrite(LateWrite write) {
        if (!this.onCatchPath) {
            this.lateSuper.writes.push(write);
        }
    }

    // Refuses the 'super(...)' calls of the constructor checked before which own fields that need a
    // value had none, once the assignments after them are known, and reports each held refusal for
    // the calls that followed it.
    public reportLateFields() {
        for (let held in this.heldRefusals) {
            this.reporter.report(held.text(held.calls), held.span);
        }
        this.heldRefusals = new List<HeldRefusal>();
        this.pendingRefusals = new List<HeldRefusal>();
        let owner = this.fieldOwner;
        let late = this.lateSuper;
        if (owner != null && late.calls.length() > 0) {
            this.reporter.report(unassigneduses.lateFieldsRefusal(owner, late, this.names),
                late.span());
        }
        this.lateSuper = new LateSuper();
    }

    // Holds the refusal at 'span' that 'text' writes for the 'super(...)' calls that build the base
    // class on the paths after it.
    hold(Span span, (List<LateCall>) -> string text) {
        let held = new HeldRefusal(span, new List<LateCall>(), text);
        this.heldRefusals.push(held);
        this.pendingRefusals.push(held);
    }

    // Keeps that a 'this.field' parameter of the constructor checked assigns 'field', which the base
    // class declares, once the base class is built.
    public noteBaseFieldBinding(Field field) {
        if (!this.boundBaseFields.contains(field.name())) {
            this.boundBaseFields.push(field.name());
        }
    }

    // Whether a 'this.field' parameter of the constructor checked assigns the base field 'name' once
    // the base class is built.
    public bindsBaseField(string name) -> bool {
        return this.boundBaseFields.contains(name);
    }

    // Whether 'field' has a value on the path reaching here.
    public hasValue(Field field) -> bool {
        return this.fieldsContain(this.assignedThisFields, field);
    }

    // The 'super(...)' at 'span', refused for where it is written, is taken to build the base class
    // here, and no path of the constructor is refused for building none.
    public noteMisplacedSuperCall(Span span) {
        if (this.baseCall == null) {
            this.baseCall = span;
        }
        this.superCallRefused = true;
        this.markBaseConstructed();
    }

    // The base class is constructed here, so every field it declares has its value.
    markBaseConstructed() {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        this.baseBuilt = true;
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return;
        }
        for (long i = 0; i < typemembers.baseFieldCount(owner); i++) {
            if (!this.fieldsContain(this.assignedThisFields, fields.get(i))) {
                this.assignedThisFields.push(fields.get(i));
            }
        }
    }

    public seedField(Field field, Span span) {
        if (!this.fieldsContain(this.assignedThisFields, field)) {
            this.assignedThisFields.push(field);
            this.ctorSeededThisWrites.push(new FieldWrite(field, span));
        }
    }

    public finishSeeding() {
        this.maybeAssignedThisWrites = this.copyWrites(this.ctorSeededThisWrites);
    }

    // The catch body runs on the exception path, where the body may have thrown from any place it
    // can throw from, so only the caught variable and the fields assigned at every one of those
    // places carry in as definitely assigned. What may be assigned is the opposite union:
    // everything written before any place the body could have thrown from.
    public enterCatchPath() {
        this.assignedLocals = new List<LocalBinding>();
        let owner = this.fieldOwner;
        this.baseBuilt = owner == null || hierarchy.baseOf(owner) == null;
        if (this.escapePoints.length() == 0) {
            this.assignedThisFields = this.writtenFields(this.ctorSeededThisWrites);
        } else {
            this.assignedThisFields = this.copyFields(this.escapePoints.get(0).assigned);
            this.baseBuilt = true;
            for (let point in this.escapePoints) {
                this.assignedThisFields = this.commonFields(this.assignedThisFields, point.assigned);
                this.baseBuilt = this.baseBuilt && point.baseBuilt;
            }
        }
        this.baseCall = null;
        this.superCalls = new List<LateCall>();
        this.pendingRefusals = new List<HeldRefusal>();
        this.maybeAssignedThisWrites = this.copyWrites(this.ctorSeededThisWrites);
        for (long i = 0; i < this.ctorEscapedMaybeWrites.length(); i++) {
            let escaped = this.ctorEscapedMaybeWrites.get(i);
            if (!this.writesContain(this.maybeAssignedThisWrites, escaped.field)) {
                this.maybeAssignedThisWrites.push(escaped);
            }
        }
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.onCatchPath = true;
        this.catchThisUses = new List<CatchThisUse>();
        this.catchFinishes = new List<CatchFinish>();
        this.reportedFields = new List<Field>();
    }

    // The places the body can throw from once the base class is built where 'built' says so, and
    // before it otherwise.
    public escapes(bool built) -> SyntaxNode[] {
        let escapes = new List<SyntaxNode>();
        for (let point in this.escapePoints) {
            if (point.baseBuilt == built) {
                escapes.push(point.escape);
            }
        }
        return escapes.toArray();
    }

    // What the catch clause being checked does that depends on how far the body ran before it threw.
    public constructorCatch() -> ConstructorCatch {
        return new ConstructorCatch(this.endReached, this.finishingReturnSpans.toArray(),
            this.catchSuperCallSpans.toArray(), this.catchThisUses.toArray(),
            this.catchFinishes.toArray());
    }

    public noteSuperCallInCatch(Span span) {
        this.catchSuperCallSpans.push(span);
    }

    // The assignment to this field that may already have run on a path reaching here, or null.
    public possibleWriteOf(Field field) -> FieldWrite? {
        return this.writeTo(this.maybeAssignedThisWrites, field);
    }

    public trackLocal(LocalBinding binding, bool assigned) {
        if (!bindingsContain(this.trackedLocals, binding)) {
            this.trackedLocals.push(binding);
        }
        if (assigned && !bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    public markAssigned(LocalBinding binding) {
        if (this.flowTerminated) {
            return;
        }
        if (bindingsContain(this.trackedLocals, binding) && !bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    fieldsContain(List<Field> set, Field field) -> bool {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i) == field) {
                return true;
            }
        }
        return false;
    }

    copyFields(List<Field> set) -> List<Field> {
        let copy = new List<Field>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    // The fields both sets hold, in the order of 'first'.
    commonFields(List<Field> first, List<Field> second) -> List<Field> {
        let both = new List<Field>();
        for (let field in first) {
            if (this.fieldsContain(second, field)) {
                both.push(field);
            }
        }
        return both;
    }

    // The fields either set holds, those of 'first' first.
    unitedFields(List<Field> first, List<Field> second) -> List<Field> {
        let united = this.copyFields(first);
        for (let field in second) {
            if (!this.fieldsContain(united, field)) {
                united.push(field);
            }
        }
        return united;
    }

    copyWrites(List<FieldWrite> set) -> List<FieldWrite> {
        let copy = new List<FieldWrite>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    writesContain(List<FieldWrite> set, Field field) -> bool {
        return this.writeTo(set, field) != null;
    }

    // The recorded assignment to this field, or null where the set holds none.
    writeTo(List<FieldWrite> set, Field field) -> FieldWrite? {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i).field == field) {
                return set.get(i);
            }
        }
        return null;
    }

    // The fields a set of assignments names, in the order they were recorded.
    writtenFields(List<FieldWrite> set) -> List<Field> {
        let fields = new List<Field>();
        for (long i = 0; i < set.length(); i++) {
            fields.push(set.get(i).field);
        }
        return fields;
    }

    public markThisFieldAssigned(Field field) {
        if (this.flowTerminated || this.fieldOwner == null) {
            return;
        }
        if (!this.fieldsContain(this.assignedThisFields, field)) {
            this.assignedThisFields.push(field);
        }
    }

    public markThisFieldRefused(Field field) {
        if (this.fieldOwner != null && !this.fieldsContain(this.refusedThisFields, field)) {
            this.refusedThisFields.push(field);
        }
    }

    public markThisFieldMaybeAssigned(Field field, Span at) {
        if (this.flowTerminated || this.fieldOwner == null) {
            return;
        }
        if (!this.writesContain(this.maybeAssignedThisWrites, field)) {
            this.maybeAssignedThisWrites.push(new FieldWrite(field, at));
        }
    }

    // Starts the calls a 'try' covers and returns the ones an enclosing 'try' covers, which
    // leaveTry restores.
    public enterTry(List<CallExpressionNode> chain) -> List<CallExpressionNode> {
        let outer = this.triedCalls;
        this.triedCalls = chain;
        return outer;
    }

    public leaveTry(List<CallExpressionNode> outer) {
        this.triedCalls = outer;
    }

    // A call whose receiver and arguments are evaluated, which can throw from here when a 'try'
    // covers it.
    public noteCallFinished(CallExpressionNode call, bool inCatchClause) {
        for (let tried in this.triedCalls) {
            if (tried.span().start == call.span().start && tried.span().end() == call.span().end()) {
                this.noteThrowEscapePoint(call, inCatchClause);
                return;
            }
        }
    }

    // Called where an exception can leave the constructor body, at the call or 'throw' statement
    // 'escape': whatever may be assigned here may be assigned when a catch clause starts, and what
    // is assigned here is kept with the place. A throw inside a catch clause leaves the constructor
    // altogether, so it feeds no other clause's entry state.
    public noteThrowEscapePoint(SyntaxNode escape, bool inCatchClause) {
        if (this.flowTerminated || this.fieldOwner == null || inCatchClause) {
            return;
        }
        for (long i = 0; i < this.maybeAssignedThisWrites.length(); i++) {
            let write = this.maybeAssignedThisWrites.get(i);
            if (!this.writesContain(this.ctorEscapedMaybeWrites, write.field)) {
                this.ctorEscapedMaybeWrites.push(write);
            }
        }
        this.escapePoints.push(new EscapePoint(escape, this.copyFields(this.assignedThisFields),
            this.baseBuilt));
    }

    // Refuses a use of 'this' at a field with no value yet on the path reaching it, or keeps it for
    // the exceptions phase in a catch clause. A read of an inherited field in 'feeding' is refused
    // together with the other statements before 'super(...)' that read the same field.
    public checkThisFieldUse(ThisUse use, FeedingWrite? feeding = null) {
        let owner = this.fieldOwner;
        let field = use.field();
        if (owner == null || field == null || this.flowTerminated
                || this.fieldsContain(this.assignedThisFields, field)) {
            return;
        }
        FeedingWrite? fed = null;
        if (feeding != null && !this.onCatchPath && this.baseContext() != BaseContext.SuperArguments
                && typemembers.isInheritedField(owner, field) && this.feeds(owner, feeding)) {
            if (this.joinFeedingGroup(field, feeding)) {
                return;
            }
            fed = feeding;
        }
        if (!this.needsValue(owner, field) || this.fieldsContain(this.reportedFields, field)) {
            return;
        }
        bool inherited = typemembers.isInheritedField(owner, field);
        this.reportedFields.push(field);
        if (!this.onCatchPath) {
            BaseContext context = this.baseContext();
            if (fed != null) {
                this.refuseFeedingRead(field, fed, context, use.span());
            } else {
                this.reporter.report(unassigneduses.refusal(use, owner, field, inherited, context,
                    this.names), use.span());
            }
            this.markThisFieldRefused(field);
            return;
        }
        this.keepCatchFieldUse(use, field, inherited);
    }

    // Keeps 'use' of 'field' in a catch clause for the exceptions phase, with each place the body
    // can throw from without the field.
    keepCatchFieldUse(ThisUse use, Field field, bool inherited) {
        let gaps = new List<EscapeGap>();
        for (let point in this.escapePoints) {
            if (!this.fieldsContain(point.assigned, field)) {
                gaps.push(new EscapeGap(point.escape, field, inherited));
            }
        }
        if (gaps.length() > 0) {
            this.catchThisUses.push(new CatchThisUse(use, gaps.toArray()));
        }
    }

    // Refuses a use of 'this' other than reading or writing one of its fields, such as a method
    // call, while a field has no value yet on the path reaching it, naming the first such field.
    // In a catch clause the use is kept for the exceptions phase, with each place the body can
    // throw from and the first field with no value there.
    public checkThisUse(ThisUse use) {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        if (!this.baseBuilt && !this.onCatchPath) {
            if (!this.baseUseReported) {
                this.baseUseReported = true;
                this.reporter.report(unassigneduses.beforeBaseRefusal(use, owner,
                    this.baseContext(), this.names), use.span());
            }
            return;
        }
        let missing = this.missingFieldFor(use, owner, this.assignedThisFields);
        if (missing == null || this.fieldsContain(this.reportedFields, missing)) {
            return;
        }
        this.reportedFields.push(missing);
        if (!this.onCatchPath) {
            bool inherited = typemembers.isInheritedField(owner, missing);
            this.reporter.report(unassigneduses.refusal(use, owner, missing, inherited,
                this.baseContext(), this.names), use.span());
            this.markThisFieldRefused(missing);
            return;
        }
        let gaps = new List<EscapeGap>();
        for (let point in this.escapePoints) {
            let missingThere = this.missingFieldFor(use, owner,
                this.unitedFields(this.assignedThisFields, point.assigned));
            if (missingThere != null) {
                gaps.push(new EscapeGap(point.escape, missingThere,
                    typemembers.isInheritedField(owner, missingThere)));
            }
        }
        if (gaps.length() > 0) {
            this.catchThisUses.push(new CatchThisUse(use, gaps.toArray()));
        }
    }

    // The field 'use' is refused for where 'assigned' is what is assigned: the first field of
    // 'owner' with no value, or null. A lambda stored in a field is refused for another field
    // before that one, since the field it is stored in has no value until the lambda exists.
    missingFieldFor(ThisUse use, Type owner, List<Field> assigned) -> Field? {
        let first = this.firstMissingField(owner, assigned, "");
        if (first == null || use.kind() != ThisUseKind.LambdaCapture || first.name() != use.detail()) {
            return first;
        }
        return this.firstMissingField(owner, assigned, use.detail()) ?? first;
    }

    // The first field of 'owner' other than the one named 'skipped' that has no value where
    // 'assigned' is what is assigned, or null. A field a 'super(...)' ran without is left to the
    // refusal of that call.
    firstMissingField(Type owner, List<Field> assigned, string skipped) -> Field? {
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return null;
        }
        let lacking = this.lateSuper.lacking();
        for (let field in fields) {
            if (field.name() != skipped && this.needsValue(owner, field)
                    && !this.fieldsContain(assigned, field) && !lacking.contains(field)) {
                return field;
            }
        }
        return null;
    }

    // Whether a field of 'owner' has no value until something gives it one: an inherited field
    // until the base class is constructed, and an own field that needs an assignment until it is
    // assigned. A field whose use or write is already refused is left out.
    needsValue(Type owner, Field field) -> bool {
        if (field.type() is ErrorType || this.fieldsContain(this.refusedThisFields, field)) {
            return false;
        }
        return typemembers.isInheritedField(owner, field) || needsAssignment(field);
    }

    // A path finishes the constructor at the end of its body or of a catch clause, at span.
    public finishConstructorAtEnd(Span span) {
        if (this.fieldOwner != null && !this.flowTerminated) {
            this.endReached = true;
            this.checkBaseBuilt(span, false);
            this.notePartialLateFields();
        }
        this.checkConstructorFieldsAssigned(span);
    }

    public finishConstructorAtReturn(Span returnSpan) {
        if (this.fieldOwner != null && !this.flowTerminated) {
            this.finishingReturnSpans.push(returnSpan);
            this.checkBaseBuilt(returnSpan, true);
            this.notePartialLateFields();
        }
        this.checkConstructorFieldsAssigned(returnSpan);
    }

    // Keeps each own field that had no value before a 'super(...)' on a path finishing the
    // constructor here and is not assigned on it.
    notePartialLateFields() {
        if (this.onCatchPath) {
            return;
        }
        for (let call in this.superCalls) {
            for (let field in call.fields) {
                if (!this.fieldsContain(this.assignedThisFields, field)
                        && !this.lateSuper.partial.contains(field)) {
                    this.lateSuper.partial.push(field);
                }
            }
        }
    }

    // Refuses a path that finishes a constructor writing 'super(...)' at 'span', the end of its body
    // or a 'return', before the base class is built on it. A catch clause is judged by the
    // exceptions phase, which knows what it catches.
    checkBaseBuilt(Span span, bool isReturn) {
        let owner = this.fieldOwner;
        if (owner == null || this.baseBuilt || this.buildsBaseAtExit || this.onCatchPath
                || this.superCallRefused) {
            return;
        }
        this.reporter.report(unassigneduses.unbuiltBaseRefusal(owner, isReturn,
            this.baseCall != null, this.names), span);
        this.markBaseConstructed();
    }

    // Whether 'feeding' gives a value that is needed before the base class is built: to an own
    // field of 'owner' that has none yet, or to a local that later statements use.
    feeds(Type owner, FeedingWrite feeding) -> bool {
        let target = feeding.target;
        if (target == null) {
            return feeding.local != null;
        }
        return this.needsValue(owner, target) && !this.fieldsContain(this.assignedThisFields, target);
    }

    // Adds 'feeding' to the statements refused for reading the inherited field 'read', where some
    // are, and returns whether they are. A statement is refused once, for the first field it reads.
    joinFeedingGroup(Field read, FeedingWrite feeding) -> bool {
        for (let group in this.feedingGroups) {
            if (group.read == read) {
                if (!this.feedingRefused(feeding)) {
                    group.writes.push(feeding);
                }
                return true;
            }
        }
        return false;
    }

    // Whether the statement of 'feeding' is refused for reading a field of the base class already.
    feedingRefused(FeedingWrite feeding) -> bool {
        for (let group in this.feedingGroups) {
            for (let write in group.writes) {
                if (write.place.start == feeding.place.start) {
                    return true;
                }
            }
        }
        return false;
    }

    // Refuses the read of the inherited field 'read' at 'span' in the value of 'feeding'. The fix
    // names the 'super(...)' calls after it, so the refusal is held until the body is checked.
    refuseFeedingRead(Field read, FeedingWrite feeding, BaseContext context, Span span) {
        if (this.feedingRefused(feeding)) {
            return;
        }
        let held = this.reorder;
        if (held == null) {
            return;
        }
        Reordering reorder = held;
        let group = new FeedingGroup(read, new List<FeedingWrite>());
        group.writes.push(feeding);
        this.feedingGroups.push(group);
        let names = this.names;
        this.hold(span, (List<LateCall> calls) ->
            unassigneduses.feedingReadRefusal(read, group.writes, context, calls, names, reorder));
    }

    // Where a use of 'this' before the base class is built is written.
    baseContext() -> BaseContext {
        if (this.inSuperArguments) {
            return BaseContext.SuperArguments;
        }
        if (this.buildsBaseAtExit && !this.baseUnbuildable) {
            return BaseContext.BuiltAtExit;
        }
        return BaseContext.BeforeSuper;
    }

    // Refuses a write of 'value', of type 'valueType', through 'this' to 'field' at 'span' before
    // the base class is built, where 'field' is one the base class declares. Before a 'super(...)'
    // the fix may pass the value to that call, so the refusal is held until it.
    public checkInheritedFieldWrite(Field field, Expression value, Type? valueType, Span span) {
        let owner = this.fieldOwner;
        let held = this.reorder;
        if (owner == null || held == null || this.flowTerminated || this.baseBuilt
                || !typemembers.isInheritedField(owner, field)) {
            return;
        }
        if (this.onCatchPath) {
            this.keepCatchFieldUse(new ThisUse(ThisUseKind.Write, field, "", span), field, true);
            return;
        }
        Reordering reorder = held;
        BaseContext context = this.baseContext();
        let names = this.names;
        if (context != BaseContext.BeforeSuper) {
            this.reporter.report(unassigneduses.inheritedWriteRefusal(field, context,
                new List<LateCall>(), value, valueType, names, reorder), span);
            return;
        }
        this.hold(span, (List<LateCall> calls) ->
            unassigneduses.inheritedWriteRefusal(field, context, calls, value, valueType, names,
                reorder));
    }

    // The own fields of 'owner' that need a value and have none on the path reaching here, without
    // those already refused. Where 'beforeSuper' says they are the ones a 'super(...)' runs without,
    // that includes the fields another 'super(...)' ran without, which are otherwise left out.
    unassignedOwnFields(Type owner, bool beforeSuper = false) -> List<Field> {
        let missing = new List<Field>();
        let lacking = this.lateSuper.lacking();
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return missing;
        }
        for (long i = typemembers.baseFieldCount(owner); i < fields.length(); i++) {
            let field = fields.get(i);
            bool leftOut = lacking.contains(field) ? !beforeSuper
                : this.fieldsContain(this.refusedThisFields, field);
            if (!(field.type() is ErrorType) && needsAssignment(field) && !leftOut
                    && !this.fieldsContain(this.assignedThisFields, field)) {
                missing.push(field);
            }
        }
        return missing;
    }

    // Reports every own field left unassigned on the path reaching span when the field needed an
    // assignment, meaning a non-defaultable one or a 'const' one without a default, and credits
    // them so the same field is not reported twice. In a catch clause a field can be missing only
    // because the body threw before assigning it, so the fields are kept for the exceptions phase
    // with each place the body can throw from without them.
    checkConstructorFieldsAssigned(Span span) {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let missing = this.unassignedOwnFields(owner);
        if (missing.length() == 0) {
            return;
        }
        if (this.onCatchPath) {
            let gaps = new List<EscapeGap>();
            for (let field in missing) {
                for (let point in this.escapePoints) {
                    if (!this.fieldsContain(point.assigned, field)) {
                        gaps.push(new EscapeGap(point.escape, field, false));
                    }
                }
            }
            if (gaps.length() > 0) {
                this.catchFinishes.push(new CatchFinish(span, gaps.toArray()));
            }
        } else {
            for (let text in unassigneduses.unassignedFieldRefusals(owner, missing, this.names)) {
                this.reporter.report(text, span);
            }
        }
        for (let field in missing) {
            this.assignedThisFields.push(field);
        }
    }

    // Whether a read of 'binding' here reads it before it is assigned, which is reported once.
    public readsUnassigned(LocalBinding binding) -> bool {
        if (this.flowTerminated) {
            return false;
        }
        let target = this.targetBinding;
        if (target != null && target == binding) {
            return false;
        }
        return bindingsContain(this.trackedLocals, binding) && !bindingsContain(this.assignedLocals, binding);
    }

    // Reports the read of 'binding' at 'span' before it is assigned. Where the read is in a lambda that
    // copies 'binding' before 'later', an assignment later in the call the lambda is passed to, the
    // fix assigns it before that call.
    public reportUnassignedRead(LocalBinding binding, Span span, AssignmentExpressionNode? later) {
        string name = binding.name();
        string refusal = "Variable '{name}' is used before it is assigned a value.";
        if (later == null) {
            this.reporter.report("{refusal} Assign it on every path that leads to this line, for example "
                + "'{name} = ...;'.", span);
        } else {
            string assignment = wording.shortSpelling(later) ?? "{name} = ...";
            this.reporter.report("{refusal} The lambda copies '{name}' when it is created. The assignment "
                + "'{assignment}' comes later in the same call. Assign '{name}' before the call, for "
                + "example '{assignment};'.", span);
        }
        this.assignedLocals.push(binding);
    }

    copyBindings(List<LocalBinding> set) -> List<LocalBinding> {
        let copy = new List<LocalBinding>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    public snapshot() -> AssignmentFlow {
        return new AssignmentFlow(this.copyBindings(this.assignedLocals),
            this.copyFields(this.assignedThisFields),
            this.copyWrites(this.maybeAssignedThisWrites), this.baseBuilt, this.baseCall,
            this.copyCalls(this.superCalls), this.copyHeld(this.pendingRefusals),
            this.flowTerminated);
    }

    copyHeld(List<HeldRefusal> held) -> List<HeldRefusal> {
        let copy = new List<HeldRefusal>();
        this.unionHeldInto(copy, held);
        return copy;
    }

    unionHeldInto(List<HeldRefusal> target, List<HeldRefusal> source) {
        for (let held in source) {
            if (!target.contains(held)) {
                target.push(held);
            }
        }
    }

    copyCalls(List<LateCall> calls) -> List<LateCall> {
        let copy = new List<LateCall>();
        for (let call in calls) {
            copy.push(call);
        }
        return copy;
    }

    public restore(AssignmentFlow flow) {
        this.assignedLocals = this.copyBindings(flow.assigned);
        this.assignedThisFields = this.copyFields(flow.assignedFields);
        this.maybeAssignedThisWrites = this.copyWrites(flow.maybeAssignedWrites);
        this.baseBuilt = flow.baseBuilt;
        this.baseCall = flow.baseCall;
        this.superCalls = this.copyCalls(flow.superCalls);
        this.pendingRefusals = this.copyHeld(flow.pendingRefusals);
        this.flowTerminated = flow.isTerminated;
    }

    unionCallsInto(List<LateCall> target, List<LateCall> source) {
        for (let call in source) {
            if (!target.contains(call)) {
                target.push(call);
            }
        }
    }

    unionWritesInto(List<FieldWrite> target, List<FieldWrite> source) {
        for (long i = 0; i < source.length(); i++) {
            if (!this.writesContain(target, source.get(i).field)) {
                target.push(source.get(i));
            }
        }
    }

    // The join of several branch out-states: a local or field is definitely assigned after the
    // join only when it is assigned on every branch that can fall through, and may be assigned
    // when any falling-through branch may have assigned it. A terminated branch cannot reach the
    // join, so it drops out. When every branch terminates the join is unreachable, so it stays
    // terminated and credits every branch's writes to avoid reports in the dead code that follows.
    public join(List<AssignmentFlow> flows) -> AssignmentFlow {
        let result = new List<LocalBinding>();
        let resultFields = new List<Field>();
        let resultMaybeWrites = new List<FieldWrite>();
        bool resultBaseBuilt = true;
        Span? resultBaseCall = null;
        let resultCalls = new List<LateCall>();
        let resultHeld = new List<HeldRefusal>();
        bool anySurvivor = false;
        for (long i = 0; i < flows.length(); i++) {
            let flow = flows.get(i);
            if (flow.isTerminated) {
                continue;
            }
            this.unionWritesInto(resultMaybeWrites, flow.maybeAssignedWrites);
            resultBaseBuilt = resultBaseBuilt && flow.baseBuilt;
            resultBaseCall = resultBaseCall ?? flow.baseCall;
            this.unionCallsInto(resultCalls, flow.superCalls);
            this.unionHeldInto(resultHeld, flow.pendingRefusals);
            if (!anySurvivor) {
                result = this.copyBindings(flow.assigned);
                resultFields = this.copyFields(flow.assignedFields);
                anySurvivor = true;
            } else {
                let both = new List<LocalBinding>();
                for (long j = 0; j < result.length(); j++) {
                    if (bindingsContain(flow.assigned, result.get(j))) {
                        both.push(result.get(j));
                    }
                }
                result = both;
                let bothFields = new List<Field>();
                for (long j = 0; j < resultFields.length(); j++) {
                    if (this.fieldsContain(flow.assignedFields, resultFields.get(j))) {
                        bothFields.push(resultFields.get(j));
                    }
                }
                resultFields = bothFields;
            }
        }
        if (!anySurvivor) {
            for (long i = 0; i < flows.length(); i++) {
                let flow = flows.get(i);
                for (long j = 0; j < flow.assigned.length(); j++) {
                    if (!bindingsContain(result, flow.assigned.get(j))) {
                        result.push(flow.assigned.get(j));
                    }
                }
                for (long j = 0; j < flow.assignedFields.length(); j++) {
                    if (!this.fieldsContain(resultFields, flow.assignedFields.get(j))) {
                        resultFields.push(flow.assignedFields.get(j));
                    }
                }
                this.unionWritesInto(resultMaybeWrites, flow.maybeAssignedWrites);
                resultBaseCall = resultBaseCall ?? flow.baseCall;
                this.unionCallsInto(resultCalls, flow.superCalls);
                this.unionHeldInto(resultHeld, flow.pendingRefusals);
            }
        }
        return new AssignmentFlow(result, resultFields, resultMaybeWrites, resultBaseBuilt,
            resultBaseCall, resultCalls, resultHeld, !anySurvivor);
    }

    // Sets the assignment state after branches that each started from 'entry' to the join of the
    // flows that reach the code after them: the ones 'branches' end with, and 'entry' too where
    // that code can be reached with no branch run, as after a switch with no arms or one on the
    // right of '&&'.
    public finishBranches(List<AssignmentFlow> branches, AssignmentFlow entry) {
        let reaching = new List<AssignmentFlow>();
        for (let flow in branches) {
            reaching.push(flow);
        }
        if (!this.isUnconditional || reaching.length() == 0) {
            reaching.push(entry);
        }
        this.restore(this.join(reaching));
    }

    // Sets the assignment state after a loop to the join of every way it can exit normally. When
    // nothing can exit, the loop runs forever and the code after it is unreachable.
    public finishLoop(List<AssignmentFlow> exits) {
        if (exits.length() == 0) {
            this.flowTerminated = true;
        } else {
            this.restore(this.join(exits));
        }
    }
}

// A refusal reported at 'span' once the body is checked, with the text 'text' writes for 'calls',
// the 'super(...)' calls that build the base class on the paths after it.
final class HeldRefusal {
    Span span;
    List<LateCall> calls;
    (List<LateCall>) -> string text;

    constructor(this.span, this.calls, this.text);
}

// The statements whose values are refused for reading 'read', a field of the base class, before
// the base class is built.
final class FeedingGroup {
    Field read;
    List<FeedingWrite> writes;

    constructor(this.read, this.writes);
}

public bindingsContain(List<LocalBinding> set, LocalBinding binding) -> bool {
    for (long i = 0; i < set.length(); i++) {
        if (set.get(i) == binding) {
            return true;
        }
    }
    return false;
}

// Whether an own field has no value until something assigns it: one without a default whose type
// has no default value, or a 'const' one without a default.
public needsAssignment(Field field) -> bool {
    return !field.hasDefault() && (field.isConst() || !convert.isDefaultable(field.type()));
}

// Whether the defaults of 'owner' are computed before any of its fields is assigned: a class
// computes them before its constructor runs, and so does a struct that declares a constructor. A
// struct literal assigns the fields it lists first.
public computesDefaultsFirst(Type owner) -> bool {
    return !types.isStructLike(owner) || typemembers.constructorsOf(owner).length() > 0;
}

// Whether a default of a field of 'owner' can read 'field', declared above it: the field has a value
// whenever the default is computed.
public defaultCanRead(Type owner, Field field) -> bool {
    return !needsAssignment(field) || !computesDefaultsFirst(owner);
}
