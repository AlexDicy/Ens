// Which locals and fields are definitely assigned on each path, and in a constructor the places
// the body can throw from with the fields assigned there.
import Span from @ens.frontend.support.source;
import SyntaxNode from @ens.frontend.syntax.node;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import Reporter from support.diagnostics;
import LocalBinding from model.scopes;
import model.convert;
import model.typemembers;
import Field from model.typemembers;
import TypeNames from model.typenames;
import Type from model.types;
import model.types;
import ErrorType from model.types;
import ConstructorCatch from result;
import ThisUse from result;
import ThisUseKind from result;
import CatchThisUse from result;
import EscapeGap from result;
import CatchFinish from result;
import phases.bodies.unassigneduses;
import List from @std.collections.list;

// An assignment to one field of 'this', kept with the place that wrote it, so a second
// assignment to a 'const' field can point back at an earlier one.
public final class FieldWrite {
    protected Field field;
    protected Span writeSpan;

    protected constructor(this.field, this.writeSpan);

    public span() -> Span {
        return this.writeSpan;
    }
}

// A place the constructor body can throw from, a call or a 'throw' statement, with the fields
// definitely assigned there.
final class EscapePoint {
    SyntaxNode escape;
    List<Field> assigned;

    constructor(this.escape, this.assigned);
}

// A snapshot of definite-assignment state at one program point: the locals and this-fields
// assigned so far, the this-field assignments that may have run on some path reaching it, and
// whether the path has already left through a return, throw, break, continue, or panic.
public final class AssignmentFlow {
    protected List<LocalBinding> assigned;
    protected List<Field> assignedFields;
    protected List<FieldWrite> maybeAssignedWrites;
    protected bool isTerminated;

    protected constructor(this.assigned, this.assignedFields, this.maybeAssignedWrites, this.isTerminated);

    public terminated() -> bool {
        return this.isTerminated;
    }
}

// Which locals and own fields are definitely assigned on the path being checked, which own
// fields may already be assigned, and the states that leave the loops around it through 'break'.
public final class AssignmentState {
    Reporter reporter;
    TypeNames names;

    List<LocalBinding> assignedLocals;
    List<LocalBinding> trackedLocals;
    List<List<AssignmentFlow>> breakFlows;
    bool flowTerminated;
    bool isUnconditional;
    LocalBinding? targetBinding;

    // The class whose constructor body is being analyzed, or null outside a constructor.
    // assignedThisFields is the current flow's set of fields definitely assigned, which holds every
    // inherited field once the base class is constructed, and ctorSeededThisWrites is the
    // assignments made before the body runs.
    // maybeAssignedThisWrites is the assignments that may have run on some path reaching here,
    // which is what holds a 'const' field to one write and names the earlier place a second
    // assignment is reported against. ctorEscapedMaybeWrites accumulates that set wherever an
    // exception can leave the body, so a catch clause has what may already be written.
    // refusedThisFields is the own fields with a write or a read already refused in the body,
    // which the end of a path does not report as unassigned. endReached and
    // finishingReturnSpans are how the paths checked since the body or the current catch clause
    // began finish the constructor normally: by reaching its end, and through each of those
    // returns, and catchSuperCallSpans is the 'super(...)' calls in the current catch clause.
    // escapePoints is each place the body can throw from, with the fields assigned there.
    // onCatchPath is whether a catch clause is being checked. There a field is missing only where
    // the body threw before assigning it, which the exceptions phase judges against what the clause
    // catches: catchThisUses is the uses of 'this' that need a field the body may not have
    // assigned, and catchFinishes the places a path finishes the constructor without one.
    // reportedFields is the fields whose missing value is already reported on the current path, so
    // a field is reported once. triedCalls is the calls the innermost 'try' being checked covers.
    Type? fieldOwner;
    List<Field> assignedThisFields;
    List<FieldWrite> ctorSeededThisWrites;
    List<FieldWrite> maybeAssignedThisWrites;
    List<FieldWrite> ctorEscapedMaybeWrites;
    List<Field> refusedThisFields;
    bool endReached;
    List<Span> finishingReturnSpans;
    List<Span> catchSuperCallSpans;
    List<EscapePoint> escapePoints;
    bool onCatchPath;
    List<CatchThisUse> catchThisUses;
    List<Field> reportedFields;
    List<CallExpressionNode> triedCalls;
    List<CatchFinish> catchFinishes;

    public constructor(Reporter reporter, TypeNames names) {
        this.reporter = reporter;
        this.names = names;
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.isUnconditional = true;
        this.targetBinding = null;
        this.fieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisWrites = new List<FieldWrite>();
        this.maybeAssignedThisWrites = new List<FieldWrite>();
        this.ctorEscapedMaybeWrites = new List<FieldWrite>();
        this.refusedThisFields = new List<Field>();
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.escapePoints = new List<EscapePoint>();
        this.onCatchPath = false;
        this.catchThisUses = new List<CatchThisUse>();
        this.reportedFields = new List<Field>();
        this.triedCalls = new List<CallExpressionNode>();
        this.catchFinishes = new List<CatchFinish>();
    }

    public reset() {
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.isUnconditional = true;
        this.targetBinding = null;
        this.fieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisWrites = new List<FieldWrite>();
        this.maybeAssignedThisWrites = new List<FieldWrite>();
        this.ctorEscapedMaybeWrites = new List<FieldWrite>();
        this.refusedThisFields = new List<Field>();
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.escapePoints = new List<EscapePoint>();
        this.onCatchPath = false;
        this.catchThisUses = new List<CatchThisUse>();
        this.reportedFields = new List<Field>();
        this.triedCalls = new List<CallExpressionNode>();
        this.catchFinishes = new List<CatchFinish>();
    }

    // The state inside a lambda's body: the enclosing locals' assignments carry in, and it is
    // outside any loop and any constructor.
    public forLambda() -> AssignmentState {
        let derived = new AssignmentState(this.reporter, this.names);
        derived.assignedLocals = this.copyBindings(this.assignedLocals);
        derived.trackedLocals = this.copyBindings(this.trackedLocals);
        derived.assignedThisFields = this.assignedThisFields;
        derived.ctorSeededThisWrites = this.ctorSeededThisWrites;
        derived.maybeAssignedThisWrites = this.maybeAssignedThisWrites;
        derived.ctorEscapedMaybeWrites = this.ctorEscapedMaybeWrites;
        derived.refusedThisFields = this.refusedThisFields;
        return derived;
    }

    public constructorFieldOwner() -> Type? {
        return this.fieldOwner;
    }

    public unconditionalPosition() -> bool {
        return this.isUnconditional;
    }

    public setUnconditionalPosition(bool unconditional) {
        this.isUnconditional = unconditional;
    }

    public assignmentTarget() -> LocalBinding? {
        return this.targetBinding;
    }

    public setAssignmentTarget(LocalBinding? target) {
        this.targetBinding = target;
    }

    public terminate() {
        this.flowTerminated = true;
    }

    public beginLoop() {
        this.breakFlows.push(new List<AssignmentFlow>());
    }

    public endLoop() -> List<AssignmentFlow> {
        return this.breakFlows.pop();
    }

    public noteBreak() {
        if (!this.flowTerminated && this.breakFlows.length() > 0) {
            this.breakFlows.get(this.breakFlows.length() - 1).push(this.snapshot());
        }
        this.flowTerminated = true;
    }

    // Starts the constructor of receiver. One that does not start with 'super(...)' has its base
    // class constructed before its body runs.
    public enterConstructor(Type receiver, bool chainsToBase) {
        this.fieldOwner = receiver;
        if (!chainsToBase) {
            this.markBaseConstructed();
        }
    }

    // The base class is constructed here, so every field it declares has its value.
    public markBaseConstructed() {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return;
        }
        for (long i = 0; i < typemembers.baseFieldCount(owner); i++) {
            if (!this.fieldsContain(this.assignedThisFields, fields.get(i))) {
                this.assignedThisFields.push(fields.get(i));
            }
        }
    }

    public seedField(Field field, Span span) {
        if (!this.fieldsContain(this.assignedThisFields, field)) {
            this.assignedThisFields.push(field);
            this.ctorSeededThisWrites.push(new FieldWrite(field, span));
        }
    }

    public finishSeeding() {
        this.maybeAssignedThisWrites = this.copyWrites(this.ctorSeededThisWrites);
    }

    // The catch body runs on the exception path, where the body may have thrown from any place it
    // can throw from, so only the caught variable and the fields assigned at every one of those
    // places carry in as definitely assigned. What may be assigned is the opposite union:
    // everything written before any place the body could have thrown from.
    public enterCatchPath() {
        this.assignedLocals = new List<LocalBinding>();
        if (this.escapePoints.length() == 0) {
            this.assignedThisFields = this.writtenFields(this.ctorSeededThisWrites);
        } else {
            this.assignedThisFields = this.copyFields(this.escapePoints.get(0).assigned);
            for (let point in this.escapePoints) {
                this.assignedThisFields = this.commonFields(this.assignedThisFields, point.assigned);
            }
        }
        this.maybeAssignedThisWrites = this.copyWrites(this.ctorSeededThisWrites);
        for (long i = 0; i < this.ctorEscapedMaybeWrites.length(); i++) {
            let escaped = this.ctorEscapedMaybeWrites.get(i);
            if (!this.writesContain(this.maybeAssignedThisWrites, escaped.field)) {
                this.maybeAssignedThisWrites.push(escaped);
            }
        }
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.endReached = false;
        this.finishingReturnSpans = new List<Span>();
        this.catchSuperCallSpans = new List<Span>();
        this.onCatchPath = true;
        this.catchThisUses = new List<CatchThisUse>();
        this.catchFinishes = new List<CatchFinish>();
        this.reportedFields = new List<Field>();
    }

    // What the catch clause being checked does that depends on how far the body ran before it threw.
    public constructorCatch() -> ConstructorCatch {
        return new ConstructorCatch(this.endReached, this.finishingReturnSpans.toArray(),
            this.catchSuperCallSpans.toArray(), this.catchThisUses.toArray(),
            this.catchFinishes.toArray());
    }

    public noteSuperCallInCatch(Span span) {
        this.catchSuperCallSpans.push(span);
    }

    // The assignment to this field that may already have run on a path reaching here, or null.
    public possibleWriteOf(Field field) -> FieldWrite? {
        return this.writeTo(this.maybeAssignedThisWrites, field);
    }

    public trackLocal(LocalBinding binding, bool assigned) {
        if (!bindingsContain(this.trackedLocals, binding)) {
            this.trackedLocals.push(binding);
        }
        if (assigned && !bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    public markAssigned(LocalBinding binding) {
        if (this.flowTerminated) {
            return;
        }
        if (bindingsContain(this.trackedLocals, binding) && !bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    fieldsContain(List<Field> set, Field field) -> bool {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i) == field) {
                return true;
            }
        }
        return false;
    }

    copyFields(List<Field> set) -> List<Field> {
        let copy = new List<Field>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    // The fields both sets hold, in the order of 'first'.
    commonFields(List<Field> first, List<Field> second) -> List<Field> {
        let both = new List<Field>();
        for (let field in first) {
            if (this.fieldsContain(second, field)) {
                both.push(field);
            }
        }
        return both;
    }

    // The fields either set holds, those of 'first' first.
    unitedFields(List<Field> first, List<Field> second) -> List<Field> {
        let united = this.copyFields(first);
        for (let field in second) {
            if (!this.fieldsContain(united, field)) {
                united.push(field);
            }
        }
        return united;
    }

    copyWrites(List<FieldWrite> set) -> List<FieldWrite> {
        let copy = new List<FieldWrite>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    writesContain(List<FieldWrite> set, Field field) -> bool {
        return this.writeTo(set, field) != null;
    }

    // The recorded assignment to this field, or null where the set holds none.
    writeTo(List<FieldWrite> set, Field field) -> FieldWrite? {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i).field == field) {
                return set.get(i);
            }
        }
        return null;
    }

    // The fields a set of assignments names, in the order they were recorded.
    writtenFields(List<FieldWrite> set) -> List<Field> {
        let fields = new List<Field>();
        for (long i = 0; i < set.length(); i++) {
            fields.push(set.get(i).field);
        }
        return fields;
    }

    public markThisFieldAssigned(Field field) {
        if (this.flowTerminated || this.fieldOwner == null) {
            return;
        }
        if (!this.fieldsContain(this.assignedThisFields, field)) {
            this.assignedThisFields.push(field);
        }
    }

    public markThisFieldRefused(Field field) {
        if (this.fieldOwner != null && !this.fieldsContain(this.refusedThisFields, field)) {
            this.refusedThisFields.push(field);
        }
    }

    public markThisFieldMaybeAssigned(Field field, Span at) {
        if (this.flowTerminated || this.fieldOwner == null) {
            return;
        }
        if (!this.writesContain(this.maybeAssignedThisWrites, field)) {
            this.maybeAssignedThisWrites.push(new FieldWrite(field, at));
        }
    }

    // Starts the calls a 'try' covers and returns the ones an enclosing 'try' covers, which
    // leaveTry restores.
    public enterTry(List<CallExpressionNode> chain) -> List<CallExpressionNode> {
        let outer = this.triedCalls;
        this.triedCalls = chain;
        return outer;
    }

    public leaveTry(List<CallExpressionNode> outer) {
        this.triedCalls = outer;
    }

    // A call whose receiver and arguments are evaluated, which can throw from here when a 'try'
    // covers it.
    public noteCallFinished(CallExpressionNode call, bool inCatchClause) {
        for (let tried in this.triedCalls) {
            if (tried.span().start == call.span().start && tried.span().end() == call.span().end()) {
                this.noteThrowEscapePoint(call, inCatchClause);
                return;
            }
        }
    }

    // Called where an exception can leave the constructor body, at the call or 'throw' statement
    // 'escape': whatever may be assigned here may be assigned when a catch clause starts, and what
    // is assigned here is kept with the place. A throw inside a catch clause leaves the constructor
    // altogether, so it feeds no other clause's entry state.
    public noteThrowEscapePoint(SyntaxNode escape, bool inCatchClause) {
        if (this.flowTerminated || this.fieldOwner == null || inCatchClause) {
            return;
        }
        for (long i = 0; i < this.maybeAssignedThisWrites.length(); i++) {
            let write = this.maybeAssignedThisWrites.get(i);
            if (!this.writesContain(this.ctorEscapedMaybeWrites, write.field)) {
                this.ctorEscapedMaybeWrites.push(write);
            }
        }
        this.escapePoints.push(new EscapePoint(escape, this.copyFields(this.assignedThisFields)));
    }

    // Refuses a use of 'this' at a field that has no value yet on the path reaching it. An inherited
    // field has its value once the base class is constructed, and an own field that needs one once
    // it is assigned. A refused field is not reported again as unassigned at the end of a path. In
    // a catch clause the use is kept for the exceptions phase, with each place the body can throw
    // from without the field.
    public checkThisFieldUse(ThisUse use) {
        let owner = this.fieldOwner;
        let field = use.field();
        if (owner == null || field == null || this.flowTerminated || !this.needsValue(owner, field)
                || this.fieldsContain(this.assignedThisFields, field)
                || this.fieldsContain(this.reportedFields, field)) {
            return;
        }
        bool inherited = typemembers.isInheritedField(owner, field);
        this.reportedFields.push(field);
        if (!this.onCatchPath) {
            this.reporter.report(unassigneduses.refusal(use, owner, field, inherited, this.names),
                use.span());
            this.markThisFieldRefused(field);
            return;
        }
        let gaps = new List<EscapeGap>();
        for (let point in this.escapePoints) {
            if (!this.fieldsContain(point.assigned, field)) {
                gaps.push(new EscapeGap(point.escape, field, inherited));
            }
        }
        if (gaps.length() > 0) {
            this.catchThisUses.push(new CatchThisUse(use, gaps.toArray()));
        }
    }

    // Refuses a use of 'this' other than reading or writing one of its fields, such as a method
    // call, while a field has no value yet on the path reaching it, naming the first such field.
    // In a catch clause the use is kept for the exceptions phase, with each place the body can
    // throw from and the first field with no value there.
    public checkThisUse(ThisUse use) {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let missing = this.missingFieldFor(use, owner, this.assignedThisFields);
        if (missing == null || this.fieldsContain(this.reportedFields, missing)) {
            return;
        }
        this.reportedFields.push(missing);
        if (!this.onCatchPath) {
            bool inherited = typemembers.isInheritedField(owner, missing);
            this.reporter.report(unassigneduses.refusal(use, owner, missing, inherited, this.names),
                use.span());
            this.markThisFieldRefused(missing);
            return;
        }
        let gaps = new List<EscapeGap>();
        for (let point in this.escapePoints) {
            let missingThere = this.missingFieldFor(use, owner,
                this.unitedFields(this.assignedThisFields, point.assigned));
            if (missingThere != null) {
                gaps.push(new EscapeGap(point.escape, missingThere,
                    typemembers.isInheritedField(owner, missingThere)));
            }
        }
        if (gaps.length() > 0) {
            this.catchThisUses.push(new CatchThisUse(use, gaps.toArray()));
        }
    }

    // The field 'use' is refused for where 'assigned' is what is assigned: the first field of
    // 'owner' with no value, or null. A lambda stored in a field is refused for another field
    // before that one, since the field it is stored in has no value until the lambda exists.
    missingFieldFor(ThisUse use, Type owner, List<Field> assigned) -> Field? {
        let first = this.firstMissingField(owner, assigned, "");
        if (first == null || use.kind() != ThisUseKind.LambdaCapture || first.name() != use.detail()) {
            return first;
        }
        return this.firstMissingField(owner, assigned, use.detail()) ?? first;
    }

    // The first field of 'owner' other than the one named 'skipped' that has no value where
    // 'assigned' is what is assigned, or null.
    firstMissingField(Type owner, List<Field> assigned, string skipped) -> Field? {
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return null;
        }
        for (let field in fields) {
            if (field.name() != skipped && this.needsValue(owner, field)
                    && !this.fieldsContain(assigned, field)) {
                return field;
            }
        }
        return null;
    }

    // Whether a field of 'owner' has no value until something gives it one: an inherited field
    // until the base class is constructed, and an own field that needs an assignment until it is
    // assigned. A field whose use or write is already refused is left out.
    needsValue(Type owner, Field field) -> bool {
        if (field.type() is ErrorType || this.fieldsContain(this.refusedThisFields, field)) {
            return false;
        }
        return typemembers.isInheritedField(owner, field) || needsAssignment(field);
    }

    // A path finishes the constructor at the end of its body or of a catch clause, at span.
    public finishConstructorAtEnd(Span span) {
        if (this.fieldOwner != null && !this.flowTerminated) {
            this.endReached = true;
        }
        this.checkConstructorFieldsAssigned(span);
    }

    public finishConstructorAtReturn(Span returnSpan) {
        if (this.fieldOwner != null && !this.flowTerminated) {
            this.finishingReturnSpans.push(returnSpan);
        }
        this.checkConstructorFieldsAssigned(returnSpan);
    }

    // Reports every own field left unassigned on the path reaching span when the field needed an
    // assignment, meaning a non-defaultable one or a 'const' one without a default, and credits
    // them so the same field is not reported twice. In a catch clause a field can be missing only
    // because the body threw before assigning it, so the fields are kept for the exceptions phase
    // with each place the body can throw from without them.
    checkConstructorFieldsAssigned(Span span) {
        let owner = this.fieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let fields = typemembers.fieldsOf(owner);
        if (fields == null) {
            return;
        }
        let missing = new List<Field>();
        for (long i = typemembers.baseFieldCount(owner); i < fields.length(); i++) {
            let field = fields.get(i);
            if (!(field.type() is ErrorType) && needsAssignment(field)
                    && !this.fieldsContain(this.assignedThisFields, field)
                    && !this.fieldsContain(this.refusedThisFields, field)) {
                missing.push(field);
            }
        }
        if (missing.length() == 0) {
            return;
        }
        if (this.onCatchPath) {
            let gaps = new List<EscapeGap>();
            for (let field in missing) {
                for (let point in this.escapePoints) {
                    if (!this.fieldsContain(point.assigned, field)) {
                        gaps.push(new EscapeGap(point.escape, field, false));
                    }
                }
            }
            if (gaps.length() > 0) {
                this.catchFinishes.push(new CatchFinish(span, gaps.toArray()));
            }
        } else {
            for (let text in unassigneduses.unassignedFieldRefusals(owner, missing, this.names)) {
                this.reporter.report(text, span);
            }
        }
        for (let field in missing) {
            this.assignedThisFields.push(field);
        }
    }

    public checkDefiniteAssignment(LocalBinding binding, Span span) {
        if (this.flowTerminated) {
            return;
        }
        let target = this.targetBinding;
        if (target != null && target == binding) {
            return;
        }
        if (!bindingsContain(this.trackedLocals, binding) || bindingsContain(this.assignedLocals, binding)) {
            return;
        }
        this.reporter.report("Variable '{binding.name()}' is used before it is assigned a "
            + "value. Assign it on every path that leads to this line, for example "
            + "'{binding.name()} = ...;'.", span);
        this.assignedLocals.push(binding);
    }

    copyBindings(List<LocalBinding> set) -> List<LocalBinding> {
        let copy = new List<LocalBinding>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    public snapshot() -> AssignmentFlow {
        return new AssignmentFlow(this.copyBindings(this.assignedLocals),
            this.copyFields(this.assignedThisFields),
            this.copyWrites(this.maybeAssignedThisWrites), this.flowTerminated);
    }

    public restore(AssignmentFlow flow) {
        this.assignedLocals = this.copyBindings(flow.assigned);
        this.assignedThisFields = this.copyFields(flow.assignedFields);
        this.maybeAssignedThisWrites = this.copyWrites(flow.maybeAssignedWrites);
        this.flowTerminated = flow.isTerminated;
    }

    unionWritesInto(List<FieldWrite> target, List<FieldWrite> source) {
        for (long i = 0; i < source.length(); i++) {
            if (!this.writesContain(target, source.get(i).field)) {
                target.push(source.get(i));
            }
        }
    }

    // The join of several branch out-states: a local or field is definitely assigned after the
    // join only when it is assigned on every branch that can fall through, and may be assigned
    // when any falling-through branch may have assigned it. A terminated branch cannot reach the
    // join, so it drops out. When every branch terminates the join is unreachable, so it stays
    // terminated and credits every branch's writes to avoid reports in the dead code that follows.
    public join(List<AssignmentFlow> flows) -> AssignmentFlow {
        let result = new List<LocalBinding>();
        let resultFields = new List<Field>();
        let resultMaybeWrites = new List<FieldWrite>();
        bool anySurvivor = false;
        for (long i = 0; i < flows.length(); i++) {
            let flow = flows.get(i);
            if (flow.isTerminated) {
                continue;
            }
            this.unionWritesInto(resultMaybeWrites, flow.maybeAssignedWrites);
            if (!anySurvivor) {
                result = this.copyBindings(flow.assigned);
                resultFields = this.copyFields(flow.assignedFields);
                anySurvivor = true;
            } else {
                let both = new List<LocalBinding>();
                for (long j = 0; j < result.length(); j++) {
                    if (bindingsContain(flow.assigned, result.get(j))) {
                        both.push(result.get(j));
                    }
                }
                result = both;
                let bothFields = new List<Field>();
                for (long j = 0; j < resultFields.length(); j++) {
                    if (this.fieldsContain(flow.assignedFields, resultFields.get(j))) {
                        bothFields.push(resultFields.get(j));
                    }
                }
                resultFields = bothFields;
            }
        }
        if (!anySurvivor) {
            for (long i = 0; i < flows.length(); i++) {
                let flow = flows.get(i);
                for (long j = 0; j < flow.assigned.length(); j++) {
                    if (!bindingsContain(result, flow.assigned.get(j))) {
                        result.push(flow.assigned.get(j));
                    }
                }
                for (long j = 0; j < flow.assignedFields.length(); j++) {
                    if (!this.fieldsContain(resultFields, flow.assignedFields.get(j))) {
                        resultFields.push(flow.assignedFields.get(j));
                    }
                }
                this.unionWritesInto(resultMaybeWrites, flow.maybeAssignedWrites);
            }
        }
        return new AssignmentFlow(result, resultFields, resultMaybeWrites, !anySurvivor);
    }

    // Sets the assignment state after branches that each started from 'entry' to the join of the
    // flows that reach the code after them: the ones 'branches' end with, and 'entry' too where
    // that code can be reached with no branch run, as after a switch with no arms or one on the
    // right of '&&'.
    public finishBranches(List<AssignmentFlow> branches, AssignmentFlow entry) {
        let reaching = new List<AssignmentFlow>();
        for (let flow in branches) {
            reaching.push(flow);
        }
        if (!this.isUnconditional || reaching.length() == 0) {
            reaching.push(entry);
        }
        this.restore(this.join(reaching));
    }

    // Sets the assignment state after a loop to the join of every way it can exit normally. When
    // nothing can exit, the loop runs forever and the code after it is unreachable.
    public finishLoop(List<AssignmentFlow> exits) {
        if (exits.length() == 0) {
            this.flowTerminated = true;
        } else {
            this.restore(this.join(exits));
        }
    }
}

public bindingsContain(List<LocalBinding> set, LocalBinding binding) -> bool {
    for (long i = 0; i < set.length(); i++) {
        if (set.get(i) == binding) {
            return true;
        }
    }
    return false;
}

// Whether an own field has no value until something assigns it: one without a default whose type
// has no default value, or a 'const' one without a default.
public needsAssignment(Field field) -> bool {
    return !field.hasDefault() && (field.isConst() || !convert.isDefaultable(field.type()));
}

// Whether the defaults of 'owner' are computed before any of its fields is assigned: a class
// computes them before its constructor runs, and so does a struct that declares a constructor. A
// struct literal assigns the fields it lists first.
public computesDefaultsFirst(Type owner) -> bool {
    return !types.isStructLike(owner) || typemembers.constructorsOf(owner).length() > 0;
}

// Whether a default of a field of 'owner' can read 'field', declared above it: the field has a value
// whenever the default is computed.
public defaultCanRead(Type owner, Field field) -> bool {
    return !needsAssignment(field) || !computesDefaultsFirst(owner);
}
