// What a refusal about a value that may be null or that can change says to do instead: the null
// checks, the locals to copy into, and the operand and assignment texts that name them.
import CatchClauseNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import Expression from @ens.frontend.syntax.generated.nodes;
import InitializerNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import VariableDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ForEachStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import TypeArmNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParameterNode from @ens.frontend.syntax.generated.nodes;
import LambdaParameterNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeSubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import NullCoalesceExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import Statement from @ens.frontend.syntax.generated.nodes;
import WhileStatementNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import GreenElement from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import support.diagnostics;
import phases.calls;
import model.convert;
import phases.bodies.literalfixes;
import phases.bodies.literaltyping;
import LiteralOrigin from phases.bodies.literaltargets;
import OriginKind from phases.bodies.literaltargets;
import phases.bodies.wording;
import phases.bodies.narrowing;
import phases.bodies.lambdas;
import NarrowingEndKind from model.narrow;
import NarrowingEnd from model.narrow;
import NarrowingPath from model.narrow;
import model.hierarchy;
import model.typemembers;
import Field from model.typemembers;
import Method from model.typemembers;
import Parameter from model.typemembers;
import Signature from model.typemembers;
import RelatedLocation from support.diagnostics;
import ModuleContext from context;
import Span from @ens.frontend.support.source;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import model.literalvalues;
import Type from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import ErrorType from model.types;
import NullType from model.types;
import StringType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import List from @std.collections.list;
import phases.bodies.assignments;
import phases.bodies.memberaccess;
import BodyChecker from phases.bodies;
import WriteTarget from phases.bodies.assignments;
import MissingMember from phases.bodies.memberaccess;
import support.syntax;

// How a refusal describes a field or element that can change, as in "'t.count' is a field".
class UnstableStepWords {
    protected string kind;
    protected string noun;
    protected string change;
    protected string place;

    protected constructor(this.kind, this.noun, this.change, this.place);
}

// The kind of fix a nullable operand takes.
public enum OperandForm {
    Present,
    Stable,
    Copied,
    Stored,
    Guarded,
    NoFix,
}

// One operand of a refused operator and the fix it takes. 'held' spells the value once the fix is
// written, or is empty.
public final class NullableOperand {
    protected OperandForm operandForm;
    protected long levels;
    protected string spelling;
    protected string heldSpelling;
    protected string localName;
    protected string declarationText;
    protected UnstableStepWords? words;
    protected string callee;
    protected string writeBack;
    protected string stores;
    protected string guard;
    protected bool wholeCall;
    protected bool calls;
    protected bool everyLevel = true;
    protected bool writes = false;
    // Whether a null check on a value written the same way comes before this one in its callable.
    protected bool checkedEarlier = false;
    // Whether a fallback written after the value needs it in parentheses.
    protected bool fallbackParenthesized = false;
    // Where a proof made where the lambda being checked is created covers the value but does not hold
    // inside the lambda: the part of the value the lambda reads from an object, the whole place to copy
    // into a local before the lambda, and the name of the local with the name to take where another
    // operand takes it, each with the changes to the tests that then have to test the local.
    // Where no statement can go before the lambda, the type test to write inside it where the proof is
    // a type test. Empty anywhere else.
    protected string objectRead = "";
    protected string copyPlace = "";
    protected string copyName = "";
    protected string otherCopyName = "";
    protected string[] copyRetests = [];
    protected string[] otherCopyRetests = [];
    protected string objectTest = "";
    // The assignment to the local the value is that comes later in the call the lambda being checked is
    // passed to, after the lambda copies the local, or empty where there is none.
    protected string laterAssignment = "";
    // Where a write ended a proof that covered the value: why the value may be null here, carrying
    // the note at the write, and where the check to write goes, as in "after the call", which is
    // empty where no check helps. Empty anywhere else.
    protected string endedReason = "";
    protected string endedWhere = "";

    protected constructor(this.operandForm, this.levels, this.spelling, this.heldSpelling, this.localName,
                          this.declarationText, this.words, this.callee, this.writeBack, this.stores,
                          this.guard, this.wholeCall, this.calls);

    public form() -> OperandForm {
        return this.operandForm;
    }

    public held() -> string {
        return this.heldSpelling;
    }

    public local() -> string {
        return this.localName;
    }

    public declaration() -> string {
        return this.declarationText;
    }
}

// A field or element access through '.', '?.', '[' or '?['. 'safe' marks '?.' and '?['.
public final class AccessStep {
    protected Expression stepReceiver;
    protected string? stepMember;
    protected Expression? stepIndex;
    protected bool isSafe;

    protected constructor(this.stepReceiver, this.stepMember, this.stepIndex, this.isSafe);

    // The access on one line, with '?.' spelled '.' and '?[' spelled '['.
    protected plainSpelling() -> string {
        string object = wording.oneLineSpelling(this.stepReceiver);
        let index = this.stepIndex;
        if (index != null) {
            return "{object}[{wording.oneLineSpelling(index)}]";
        }
        return "{object}.{this.stepMember ?? ""}";
    }

    public receiver() -> Expression {
        return this.stepReceiver;
    }

    public member() -> string? {
        return this.stepMember;
    }

    public index() -> Expression? {
        return this.stepIndex;
    }

    public safe() -> bool {
        return this.isSafe;
    }
}

// The outermost step that keeps a value from being a stable place, which is an array element
// or an instance field that is not 'const'. Null when the value reads neither. A field read
// through its type name is never the step. Its declaration is refused without 'const'.
unstableStep(BodyChecker checker, Expression expression) -> Expression? {
    Expression core = syntax.unwrapParentheses(expression);
    switch (core) {
        is MemberExpressionNode member -> {
            if (checker.result().staticConstFieldOf(member.green()) != null) {
                return null;
            }
            if (!readsConstField(checker, member)) {
                return member;
            }
            return unstableStep(checker, member.object());
        },
        is SubscriptExpressionNode subscript -> {
            return subscript;
        },
        default -> {
            return null;
        },
    }
}

// Whether the member access reads a 'const' field, either an instance field or a static or
// lazy one reached through its type. False when the object has no analyzed type.
public readsConstField(BodyChecker checker, MemberExpressionNode member) -> bool {
    let typeLevel = checker.result().staticConstFieldOf(member.green());
    if (typeLevel != null) {
        return typeLevel.isConst();
    }
    let field = accessedField(checker, member);
    return field != null && field.isConst();
}

// The field a member access reads through '.' or '?.'. Null when it reads none, or when the
// object has no analyzed type.
public accessedField(BodyChecker checker, Expression expression) -> Field? {
    let access = accessStep(expression);
    if (access == null) {
        return null;
    }
    let name = access.member();
    let objectType = checker.result().typeOf(access.receiver().green());
    if (name == null || objectType == null) {
        return null;
    }
    return typemembers.inheritedOrOwnField(convert.coreOf(objectType), name);
}

// Why a type test on the value proves nothing for a later read, and the local copy that does.
// Null when the value reads no array element and no field that is not 'const'.
public unstableTestGuidance(BodyChecker checker, Expression value) -> string? {
    return copiedGuidance(checker, value, "type test", "test");
}

// The copy advice for a value read from a field or an element, for a check named 'check'.
copiedGuidance(BodyChecker checker, Expression value, string check, string verb) -> string? {
    let operand = classifyOperand(checker, value, 1, "", false);
    if (operand.form() != OperandForm.Copied) {
        return null;
    }
    return copiedAdvice([operand], check, verb);
}

// The null guidance for a binary operator, or null unless it takes both sides without their '?'.
// A write target's fix writes the result back to it.
public binaryGuidance(BodyChecker checker, Expression leftNode, Expression rightNode, Type left, Type right,
                      bool accepted, WriteTarget? written, string operatorText) -> string? {
    if (!accepted) {
        return null;
    }
    return operandsAdvice(classifyOperands(checker, leftNode, rightNode, left, right, written), operatorText);
}

// The null guidance for a unary operator, or null unless it takes the operand without its '?'.
// A write target's fix writes the result back to it.
public unaryGuidance(BodyChecker checker, Expression operand, Type type, bool accepted,
                     WriteTarget? written) -> string? {
    long levels = wording.optionalLevels(type);
    if (written != null) {
        levels = written.nullLevels();
    }
    if (!accepted || levels == 0) {
        return null;
    }
    return operandsAdvice([classifyOperand(checker, operand, levels, "", written != null)]);
}

// The null guidance for 'value' of type 'type' in a use that takes one '?', or an empty string
// unless the type has more.
public oneLevelGuidance(BodyChecker checker, Expression value, Type type) -> string {
    if (!(type is OptionalType) || !(type.inner() is OptionalType)) {
        return "";
    }
    return nullGuidance(checker, value, type, wording.optionalLevels(type) - 1) ?? "";
}

// The null guidance for 'value' of type 'type' where a use takes it with 'levels' fewer '?'.
public nullGuidance(BodyChecker checker, Expression value, Type type, long levels) -> string? {
    let branches = new List<Expression>();
    for (let branch in syntax.joinValues(value)) {
        if (checker.recordedType(branch) is OptionalType) {
            branches.push(branch);
        }
    }
    if (branches.length() == 0 || !isJoin(syntax.unwrapParentheses(value))) {
        let operand = classifyOperand(checker, value, levels, "", false);
        operand.everyLevel = levels == wording.optionalLevels(type);
        return operandsAdvice([operand]);
    }
    let operands = new List<NullableOperand>();
    for (let branch in branches) {
        long own = wording.optionalLevels(checker.recordedType(branch));
        long used = own;
        if (levels < own) {
            used = levels;
        }
        let operand = classifyOperand(checker, branch, used, "", false);
        operand.everyLevel = used == own;
        operands.push(operand);
    }
    NullableOperand[] classified = operands.toArray();
    for (let operand in classified) {
        if (operand.wholeCall) {
            return joinAdvice(checker, value, levels, levels == wording.optionalLevels(type));
        }
    }
    let advice = operandsAdvice(classified);
    if (advice == null || advice.endsWith("'??'.") || advice.endsWith("once for each '?'.")) {
        return advice;
    }
    string clause = fallbackAdvice(classified, true) ?? "";
    if (clause.length == 0) {
        return advice;
    }
    return "{advice.substring(0, advice.length - 1)}, or s{clause.substring(1)}";
}

// The advice for the '?:' or the switch 'join', one of whose values is a call that can return null,
// where 'levels' of its '?' are taken away, or 'everyLevel' all of them: its whole value stored in one
// local, or one fallback after it where nothing is read from it, so that it still makes only the calls
// it makes now.
joinAdvice(BodyChecker checker, Expression join, long levels, bool everyLevel) -> string {
    string named = wording.joinName(join);
    string times = "";
    if (levels > 1 && everyLevel) {
        times = " {timesWord(levels)}, once for each '?'";
    } else if (levels > 1) {
        times = " {timesWord(levels)}";
    }
    string fallback = fallbackClause(join, times);
    if (!checker.frame().statementsAllowed() || checker.frame().inLoopCondition()) {
        return "S{fallback.substring(1)}.";
    }
    string local = freeLocalName(checker, "", sharedResultName(join) ?? "value");
    string checked = "check the local{repeatedCheck("{local} != null", levels, everyLevel)}";
    string stored = "Store the value of the {named} in a local first";
    let spelled = wording.shortSpelling(join);
    if (spelled != null) {
        stored = "{stored} ('let {local} = {spelled};')";
    }
    if (readFrom(join)) {
        return "{stored} and {checked}.";
    }
    return "{stored} and {checked}, or {fallback}.";
}

// Whether a member of 'value', an element or its call is read from it, so that a fallback written
// after it would belong to that read.
readFrom(Expression value) -> bool {
    SyntaxNode outer = value;
    SyntaxNode? holder = value.parent();
    while (holder is ParenthesizedExpressionNode) {
        outer = holder;
        holder = holder.parent();
    }
    long start = outer.span().start;
    return switch (holder) {
        is MemberExpressionNode member -> member.object().span().start == start,
        is SafeMemberExpressionNode member -> member.object().span().start == start,
        is SubscriptExpressionNode element -> element.object().span().start == start,
        is SafeSubscriptExpressionNode element -> element.object().span().start == start,
        is CallExpressionNode call -> call.callee().span().start == start,
        default -> false,
    };
}

// Whether a value of the '?:' or the switch 'join' is a call.
joinCalls(Expression join) -> bool {
    for (let value in syntax.joinValues(join)) {
        if (value is CallExpressionNode) {
            return true;
        }
    }
    return false;
}

// The base name of a local for the value of the '?:' or the switch 'join' where every value of it that
// is a call calls the same function, as in 'pickResult' for 'up ? pick() : pick()', or null otherwise.
sharedResultName(Expression join) -> string? {
    string? shared = null;
    for (let value in syntax.joinValues(join)) {
        if (!(value is CallExpressionNode)) {
            continue;
        }
        let callee = calleeName(value);
        if (callee == null) {
            return null;
        }
        string name = storedResultName(value, callee);
        if (shared != null && shared != name) {
            return null;
        }
        shared = name;
    }
    return shared;
}

// The calls that make 'value' null where it is, each quoted once, as in "'pick()' and 'other()'": the
// value itself, or the values of a '?:' or a switch that may be null. Null where a part of the value
// that may be null is not a call.
nullableCalls(BodyChecker checker, Expression value) -> string? {
    let calls = new List<string>();
    for (let branch in syntax.joinValues(value)) {
        Type type = checker.recordedType(branch);
        if (!(type is OptionalType) && !(type is NullType)) {
            continue;
        }
        if (!(branch is CallExpressionNode) || calleeName(branch) == null) {
            return null;
        }
        string quoted = "'{wording.oneLineSpelling(branch)}'";
        if (!calls.contains(quoted)) {
            calls.push(quoted);
        }
    }
    if (calls.length() == 0) {
        return null;
    }
    return diagnostics.andJoined(calls.toArray());
}

// The fix for 'value', a call or a '?:' or a switch that makes one, where it is the initial value of the
// variable or field 'origin' declares, of type 'target', or is assigned to it: declare it so that it
// allows null, or give the value a fallback. Null for any other value, where 'origin' declares no such
// variable or field, where 'target' already allows null, and where a null check on an earlier call
// written the same way shows the result was meant to be checked.
declarationFix(BodyChecker checker, Type target, Expression value, LiteralOrigin? origin) -> string? {
    if (origin == null || origin.kind() != OriginKind.Declared || origin.name().length == 0
            || origin.forElement() || target is OptionalType || target is ErrorType) {
        return null;
    }
    Expression core = syntax.unwrapParentheses(value);
    bool joined = isJoin(core);
    if (!joined && (!(core is CallExpressionNode) || checkedBefore(checker, core))) {
        return null;
    }
    if (joined && !joinCalls(core)) {
        return null;
    }
    string declared = "Declare '{origin.name()}'";
    if (origin.quotedFieldOwner().length > 0) {
        declared = "Declare field '{origin.name()}' of {origin.quotedFieldOwner()}";
    }
    string fallback = fallbackClause(value, "");
    string fix = "S{fallback.substring(1)}";
    if (convert.isAssignableStrict(checker.store().optionalOf(target), checker.recordedType(value))) {
        fix = "{declared} as {checker.names().quotedNullable(target)} and check it for null, or {fallback}";
    }
    let example = fallbackExample(checker, value);
    if (example == null) {
        return "{fix}.";
    }
    return "{fix}, as in '{example}'.";
}

// How to supply a fallback after 'value' with '??', 'times' over: after the closing '}' of a switch,
// and after a '?:' in parentheses, because '??' would take only the last branch of a '?:' without them.
fallbackClause(Expression value, string times) -> string {
    Expression core = syntax.unwrapParentheses(value);
    if (core is SwitchExpressionNode) {
        return "supply a fallback after the switch's closing '\}' with '??'{times}";
    }
    if (!(core is TernaryExpressionNode)) {
        return "supply a fallback with '??'{times}";
    }
    if (value is ParenthesizedExpressionNode || value.parent() is ParenthesizedExpressionNode) {
        return "supply a fallback after the '?:' with '??'{times}";
    }
    return "put the '?:' in parentheses and supply a fallback after them with '??'{times}";
}

// The declaration or the assignment that gives 'value' a fallback after '??' where it is the initial
// value of a variable, a field or a parameter that writes its type, or is assigned to one, as in 'string name = pick() ?? "";', or the value with its
// fallback elsewhere. Where a '?:' or a switch is too long to repeat, the end of it with the fallback,
// as in '} ?? "";'. Null where the type of 'value' has no value plain enough to show as the fallback, or
// where any other value is too long to repeat.
fallbackExample(BodyChecker checker, Expression value) -> string? {
    Type type = checker.recordedType(value);
    if (type is OptionalType) {
        type = type.inner();
    }
    string? fallback = calls.zeroText(type, checker.names());
    if (type is StringType) {
        fallback = "\"\"";
    }
    if (fallback == null) {
        return null;
    }
    SyntaxNode? holder = value.parent();
    while (holder is ParenthesizedExpressionNode) {
        holder = holder.parent();
    }
    if (holder is InitializerNode) {
        holder = holder.parent();
    }
    string start = "";
    string end = "";
    if (holder is VariableDeclarationNode) {
        let written = holder.declaredType();
        if (written != null) {
            start = "{wording.greenSpelling(written.green())} {holder.name().text()} = ";
            end = ";";
        }
    } else if (holder is FieldDeclarationNode) {
        start = "{wording.greenSpelling(holder.declaredType().green())} {holder.name().text()} = ";
        end = ";";
    } else if (holder is ParameterNode) {
        let written = holder.declaredType();
        if (written != null) {
            start = "{wording.greenSpelling(written.green())} {holder.name().text()} = ";
        }
    } else if (holder is AssignmentExpressionNode) {
        start = "{wording.oneLineSpelling(syntax.unwrapParentheses(holder.target()))} = ";
        end = ";";
    }
    Expression core = syntax.unwrapParentheses(value);
    let spelled = wording.shortSpelling(core);
    if (spelled == null && core is SwitchExpressionNode) {
        return "\} ?? {fallback}{end}";
    }
    if (spelled == null && core is TernaryExpressionNode) {
        return ") ?? {fallback}{end}";
    }
    if (spelled == null) {
        return null;
    }
    if (wording.bindsLooserThanFallback(core)) {
        return "{start}({spelled}) ?? {fallback}{end}";
    }
    return "{start}{spelled} ?? {fallback}{end}";
}

// The advice for 'value' where it is a chain of '??' whose last value can be null, so that one level of
// null is left: that value named, and the chain ended with a value that is not null. Null for any other
// value.
chainAdvice(BodyChecker checker, Expression value, long levels) -> string? {
    Expression core = syntax.unwrapParentheses(value);
    if (!(core is NullCoalesceExpressionNode) || levels != 1) {
        return null;
    }
    Expression last = syntax.unwrapParentheses(core.right());
    while (last is NullCoalesceExpressionNode) {
        last = syntax.unwrapParentheses(last.right());
    }
    if (wording.isNullLiteral(last)) {
        return "The value after the last '??' is 'null'. Replace it with a value that is not null.";
    }
    string why = "The value after the last '??' can be null too.";
    let spelled = wording.shortSpelling(last);
    if (spelled != null && last is CallExpressionNode) {
        why = "'{spelled}' after '??' can return null too.";
    } else if (spelled != null) {
        why = "'{spelled}' after '??' can be null too.";
    }
    let example = fallbackExample(checker, value);
    if (example == null) {
        return "{why} End the chain with a value that is not null.";
    }
    return "{why} End the chain with a value that is not null, as in '{example}'.";
}

// Whether a null check on a value written the same way as 'read', which reads the result of a call,
// comes before it in the callable that holds it.
checkedBefore(BodyChecker checker, Expression read) -> bool {
    let callable = checker.frame().callableSyntax();
    if (callable == null) {
        return false;
    }
    return holdsNullCheckBefore(callable, wording.oneLineSpelling(read), read.span().start);
}

// Whether 'node' holds a comparison of the expression spelled 'spelled' with 'null' that ends before
// the offset 'before'.
holdsNullCheckBefore(SyntaxNode node, string spelled, long before) -> bool {
    if (node.span().start >= before) {
        return false;
    }
    if (node is BinaryExpressionNode && node.span().end() <= before
            && (node.operator().text() == "==" || node.operator().text() == "!=")) {
        Expression left = syntax.unwrapParentheses(node.left());
        Expression right = syntax.unwrapParentheses(node.right());
        if ((wording.isNullLiteral(right) && wording.oneLineSpelling(left) == spelled)
                || (wording.isNullLiteral(left) && wording.oneLineSpelling(right) == spelled)) {
            return true;
        }
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (holdsNullCheckBefore(children.get(i), spelled, before)) {
            return true;
        }
    }
    return false;
}

// 'opening', which the words 'may be null' continue, with the null guidance for 'value' of type
// 'type' in a use that takes none of its '?'.
public maybeNullRefusal(BodyChecker checker, string opening, Expression value, Type type) -> string {
    long levels = wording.optionalLevels(type);
    string why = "{opening} may be null here.";
    if (levels > 1) {
        why = "{opening} may be null at more than one level.";
    }
    return withGuidance(checker, why, nullGuidance(checker, value, type, levels));
}

// Both operands of a binary operator and their fixes. Two locals that would share a name get
// 'left' and 'right' in front of it.
classifyOperands(BodyChecker checker, Expression leftNode, Expression rightNode, Type left, Type right,
                 WriteTarget? written) -> NullableOperand[] {
    long leftLevels = wording.optionalLevels(left);
    if (written != null) {
        leftLevels = written.nullLevels();
    }
    bool writesBack = written != null;
    let first = classifyOperand(checker, leftNode, leftLevels, "", writesBack);
    let second = classifyOperand(checker, rightNode, wording.optionalLevels(right), "", false);
    if (first.local().length > 0 && first.local() == second.local() && !samePlace(first, second)) {
        first = classifyOperand(checker, leftNode, leftLevels, "left", writesBack);
        second = classifyOperand(checker, rightNode, second.levels, "right", false);
    }
    return [first, second];
}

// The operand and its fix for the 'levels' of null that a refusal names. An operand gets no fix
// where no statement can go.
public classifyOperand(BodyChecker checker, Expression operand, long levels, string prefix,
                       bool writesBack) -> NullableOperand {
    string spelling = wording.oneLineSpelling(syntax.unwrapParentheses(operand));
    OperandForm form = OperandForm.NoFix;
    string held = "";
    string local = "";
    string declaration = "";
    UnstableStepWords? words = null;
    string callee = "";
    string writeBack = "";
    string stores = "";
    string guard = "";
    let step = unstableStep(checker, operand);
    if (step == null && writesBack) {
        step = safeStep(checker, operand);
    }
    let call = storedCall(checker, operand);
    let read = accessStep(syntax.unwrapParentheses(operand));
    if (levels == 0) {
        form = OperandForm.Present;
        held = wording.oneLineSpelling(operand);
    } else if (!checker.frame().statementsAllowed()) {
        form = OperandForm.NoFix;
    } else if (narrowing.buildNarrowingPath(checker, operand) != null) {
        form = OperandForm.Stable;
        held = wording.simpleSpelling(operand) ?? spelling;
    } else if (read != null && read.safe() && !writesBack) {
        if (levels == 1) {
            form = OperandForm.Guarded;
            guard = wording.oneLineSpelling(syntax.unwrapParentheses(read.receiver()));
            let slot = assignments.safeSlotType(checker, syntax.unwrapParentheses(operand));
            if (narrowing.buildNarrowingPath(checker, read.receiver()) != null && slot != null
                    && !(slot is OptionalType)) {
                held = read.plainSpelling();
            }
        }
    } else if (checker.frame().inLoopCondition() && (step != null || call != null)) {
        form = OperandForm.NoFix;
    } else if (step != null || call != null) {
        Expression source = syntax.unwrapParentheses(operand);
        string base = "value";
        if (step != null) {
            form = OperandForm.Copied;
            source = step;
        } else if (call != null) {
            form = OperandForm.Stored;
            callee = calleeName(call) ?? "";
            base = storedResultName(call, callee);
        }
        let access = accessStep(source);
        string copied = wording.oneLineSpelling(source);
        string copyRead = copied;
        if (access != null) {
            base = access.member() ?? base;
            if (access.safe()) {
                copied = access.plainSpelling();
            }
        }
        local = freeLocalName(checker, prefix, base);
        declaration = "let {local} = {copyRead};";
        if (step != null) {
            words = unstableWords(checker, step, copied);
        }
        if (access != null && step != null && writesBack) {
            Expression receiver = syntax.unwrapParentheses(access.receiver());
            let index = access.index();
            bool receiverCalls = containsCall(receiver.green());
            bool indexCalls = index != null && containsCall(index.green());
            if (receiverCalls && !holdsReference(checker, receiver)) {
                form = OperandForm.NoFix;
            } else if (receiverCalls || indexCalls) {
                string stored = "";
                string place = wording.oneLineSpelling(receiver);
                string holder = "";
                string what = "the field";
                if (index != null) {
                    what = "the element";
                }
                if (indexCalls) {
                    what = "the index and {what}";
                }
                if (receiverCalls) {
                    holder = freeLocalName(checker, prefix, receiverName(checker, receiver));
                    stored = "let {holder} = {place}; ";
                    string named = "'{place}'";
                    if (receiver is CallExpressionNode) {
                        named = "the result of {named}";
                    }
                    what = indexCalls ? "{named}, {what}" : "{named} and {what}";
                    place = holder;
                    local = freeLocalName(checker, prefix, base, holder);
                }
                string accessor = ".{base}";
                if (index != null && indexCalls) {
                    string at = freeLocalName(checker, "", "at", holder);
                    stored = "{stored}let {at} = {wording.oneLineSpelling(index)}; ";
                    accessor = "[{at}]";
                } else if (index != null) {
                    accessor = "[{wording.oneLineSpelling(index)}]";
                }
                string safe = "";
                if (access.safe()) {
                    safe = "?";
                }
                declaration = "{stored}let {local} = {place}{safe}{accessor};";
                writeBack = "'{place}{accessor}'";
                stores = what;
            } else if (namesStorage(checker, receiver)) {
                writeBack = "'{copied}'";
            }
        }
        string rest = memberSteps(operand, source);
        held = local + rest;
        spelling = copied + rest;
    }
    let classified = new NullableOperand(form, levels, spelling, held, local, declaration, words,
        callee, writeBack, stores, guard, syntax.unwrapParentheses(operand) is CallExpressionNode,
        containsCall(operand.green()));
    classified.writes = writesBack;
    classified.fallbackParenthesized = wording.bindsLooserThanFallback(operand);
    if (form == OperandForm.Stored) {
        classified.checkedEarlier = checkedBefore(checker, syntax.unwrapParentheses(operand));
    }
    if (!writesBack && levels > 0 && (form == OperandForm.Stable || form == OperandForm.NoFix)) {
        noteObjectRead(checker, operand, levels, classified);
    }
    if (!writesBack && levels > 0) {
        noteLaterAssignment(checker, operand, classified);
    }
    if (!writesBack && levels > 0 && (form == OperandForm.Stable || form == OperandForm.NoFix)
            && classified.objectRead.length == 0) {
        noteEndedNarrowing(checker, operand, classified);
    }
    return classified;
}

// Records on 'classified' the assignment to 'operand', a local the lambda being checked copies, that comes
// later in the call the lambda is passed to and stores a value that is not null.
noteLaterAssignment(BodyChecker checker, Expression operand, NullableOperand classified) {
    Expression read = syntax.unwrapParentheses(operand);
    if (!(read is IdentifierExpressionNode)) {
        return;
    }
    let binding = checker.result().bindingOf(read.green());
    if (binding == null) {
        return;
    }
    let later = lambdas.laterAssignmentInCall(checker, binding);
    if (later == null) {
        return;
    }
    let stored = laterStoredType(checker, later);
    if (!(stored is OptionalType) && !(stored is NullType) && !(stored is ErrorType)) {
        classified.laterAssignment = wording.shortSpelling(later) ?? "{binding.name()} = ...";
    }
}

// The type the assignment later, written after the lambda being checked in the call it is passed to,
// stores. The call analyzes its arguments in written order, so where it has not reached later yet,
// a trial analyzes the value.
laterStoredType(BodyChecker checker, AssignmentExpressionNode later) -> Type {
    let recorded = checker.result().typeOf(later.value().green());
    if (recorded != null) {
        return recorded;
    }
    let trial = checker.trialOutsideLambda();
    Type stored = trial.analyzeExpression(later.value());
    checker.endTrial();
    return stored;
}

// Records on 'classified' why 'operand' may be null here where a write ended a proof that covered
// it: an assignment, an 'out' argument, or either of them in a loop, which can run it before a later
// pass reaches the read, and before a read after the loop.
noteEndedNarrowing(BodyChecker checker, Expression operand, NullableOperand classified) {
    let path = narrowing.buildNarrowingPath(checker, operand);
    if (path == null) {
        return;
    }
    let end = checker.narrowing().endOf(path) ?? nullableWrite(checker, path);
    if (end == null) {
        return;
    }
    string place = wording.simpleSpelling(operand) ?? classified.spelling;
    string callee = end.calleeName();
    string note = "'{place}' is assigned here";
    string write = "assigns it";
    string outcome = "it may be null";
    if (end.kind() == NarrowingEndKind.PassedOut) {
        note = "'{callee}' can write '{place}' here";
        write = "passes it as 'out' to '{callee}'";
    } else if (end.place() != place) {
        note = "'{end.place()}' is assigned here";
        write = "assigns '{end.place()}'";
        outcome = "'{place}' may be null";
    }
    string carried = diagnostics.carriedNote(end.at(), note);
    let loop = end.loop();
    let stored = end.stored();
    if (loop != null && narrowing.within(operand.span(), loop)) {
        string reason = "'{place}' is not null when the loop starts, but the loop {write}, so {outcome} "
            + "on a later pass.{carried}";
        if (checker.frame().inLoopCondition()) {
            classified.endedReason = reason + loopConditionCheck(operand, place);
        } else {
            classified.endedReason = reason;
            classified.endedWhere = "inside the loop";
        }
        return;
    }
    Span statement = enclosingStatement(operand).span();
    bool sameStatement = loop == null && narrowing.within(end.at(), statement);
    if (end.kind() == NarrowingEndKind.PassedOut) {
        classified.endedReason = "Passing 'out {place}' lets '{callee}' write any value to "
            + "'{place}'.{carried}";
        classified.endedWhere = checkPlace(end, sameStatement, "after the call");
    } else if (end.place() != place) {
        return;
    } else if (stored is NullType && end.inJoin()) {
        classified.endedReason = "'{place}' is assigned 'null' {end.joinedIn()}.{carried}";
        classified.endedWhere = checkPlace(end, sameStatement, "");
    } else if (stored is NullType) {
        classified.endedReason = "'{place}' is assigned 'null'.{carried}";
    } else if (stored is OptionalType) {
        classified.endedReason = "'{place}' is assigned a value of type {checker.names().quoted(stored)}, "
            + "which can be null.{carried}";
        classified.endedWhere = checkPlace(end, sameStatement, "after the assignment");
    }
}

// The write that left the proof of 'path' that holds here, where that proof can be null because of it: the
// write stored a value that can be null, or it is a write in a loop that leaves a proof that can be null
// where the loop starts, which could not be null where the loop is entered. Null anywhere else.
nullableWrite(BodyChecker checker, NarrowingPath path) -> NarrowingEnd? {
    let write = checker.narrowing().writeOf(path);
    let proven = checker.narrowing().provenType(path);
    if (write == null || proven == null) {
        return null;
    }
    if (write.loop() != null) {
        let narrower = write.narrower();
        if (narrower == null || wording.optionalLevels(narrower) >= wording.optionalLevels(proven)) {
            return null;
        }
        return write;
    }
    return write.stored() is OptionalType ? write : null;
}

// Where to check a value whose narrowing the write 'end' ended: after the statement whose branches meet
// where the write is in one of them or in a loop the read comes after, and otherwise 'after', as in
// "after the call". Empty where the write is in the statement that reads the value, since no check fits
// between them.
checkPlace(NarrowingEnd end, bool sameStatement, string after) -> string {
    if (sameStatement) {
        return "";
    }
    if (end.inJoin()) {
        return "after the {end.joinedStatement()}";
    }
    return after;
}

// The statement 'node' is in.
enclosingStatement(SyntaxNode node) -> SyntaxNode {
    SyntaxNode current = node;
    while (!(current is Statement)) {
        let holder = current.parent();
        if (holder == null) {
            return current;
        }
        current = holder;
    }
    return current;
}

// The check to add to the condition of the 'while' loop that reads 'operand' in its condition, where
// the loop can make 'place' null before a later pass reads it. Empty for another loop and where the
// condition is too long to repeat.
loopConditionCheck(Expression operand, string place) -> string {
    let loop = enclosingStatement(operand);
    if (!(loop is WhileStatementNode)) {
        return "";
    }
    Expression condition = syntax.unwrapParentheses(loop.condition());
    string spelled = wording.oneLineSpelling(condition);
    if (spelled.length > wording.quotedCodeLimit()) {
        return "";
    }
    if (condition is TernaryExpressionNode || condition is AssignmentExpressionNode
            || (condition is BinaryExpressionNode && condition.operator().text() == "||")) {
        spelled = "({spelled})";
    }
    return " Check '{place}' for null at the start of the condition, as in "
        + "'while ({place} != null && {spelled})'.";
}


// Records on 'classified' the part of 'operand' that the lambda being checked reads from an object,
// where a proof made where the lambda is created takes off the 'levels' of null the use needs but
// does not hold inside the lambda.
noteObjectRead(BodyChecker checker, Expression operand, long levels, NullableOperand classified) {
    let path = narrowing.buildNarrowingPath(checker, operand);
    if (path == null) {
        return;
    }
    let frame = lambdas.uncarriedFrame(checker, path);
    if (frame == null) {
        return;
    }
    let proven = frame.uncarriedProof(path);
    let declared = narrowing.declaredSlotType(checker, operand);
    long read = wording.optionalLevels(checker.recordedType(operand));
    if (proven == null || declared == null || wording.optionalLevels(proven) + levels > read) {
        return;
    }
    classified.objectRead = narrowing.objectReadSpelling(operand, path);
    if (frame.allowsStatementsBefore()) {
        let place = narrowing.copiedPlace(checker, operand, frame);
        string name = narrowing.copyName(checker, place, "");
        string other = narrowing.copyName(checker, place, name);
        let retests = narrowing.copyRetests(checker, place, frame, name);
        let otherRetests = narrowing.copyRetests(checker, place, frame, other);
        if (retests != null && otherRetests != null) {
            classified.copyPlace = wording.oneLineSpelling(place);
            classified.copyName = name;
            classified.otherCopyName = other;
            classified.copyRetests = retests;
            classified.otherCopyRetests = otherRetests;
            return;
        }
    }
    if (convert.coreOf(proven) != convert.coreOf(declared)) {
        classified.objectTest = narrowing.typeTestExample(checker, operand, convert.coreOf(proven));
    }
}

// A write through '?.' or '?[' as the step that the same write without its '?' lands in.
// Null when a null check cannot narrow the value in front of the '?'.
safeStep(BodyChecker checker, Expression operand) -> Expression? {
    Expression core = syntax.unwrapParentheses(operand);
    let access = accessStep(core);
    if (access != null && access.safe() && narrowing.buildNarrowingPath(checker, access.receiver()) != null) {
        return core;
    }
    return null;
}

// The base name of the local a receiver that makes a call is stored in. That is the member's
// name for a field, the callee's for a call, and 'element' for an array element.
receiverName(BodyChecker checker, Expression receiver) -> string {
    let access = accessStep(receiver);
    if (access != null) {
        return access.member() ?? "element";
    }
    if (receiver is CallExpressionNode) {
        let callee = calleeName(receiver);
        if (callee != null) {
            return storedResultName(receiver, callee);
        }
    }
    return "value";
}

// The call a value is read from, directly or through 'const' fields of its result.
// Null when the value reads no call that way, or the called function has no name.
storedCall(BodyChecker checker, Expression operand) -> CallExpressionNode? {
    Expression core = syntax.unwrapParentheses(operand);
    while (core is MemberExpressionNode && readsConstField(checker, core)) {
        core = syntax.unwrapParentheses(core.object());
    }
    if (core is CallExpressionNode && calleeName(core) != null) {
        return core;
    }
    return null;
}

// The base name, joined to the prefix when there is one, and numbered from 2 when the name is
// taken where the fix would declare it or is the name of another local the same fix declares.
public freeLocalName(BodyChecker checker, string prefix, string base, string declared = "") -> string {
    string name = base;
    if (prefix.length > 0) {
        name = joinedName(prefix, base);
    }
    string candidate = name;
    for (long number = 2; nameTaken(checker, candidate) || candidate == declared; number++) {
        candidate = "{name}{number}";
    }
    return candidate;
}

// Whether the expression's value is a reference, so a local copy of it points at the same object.
holdsReference(BodyChecker checker, Expression expression) -> bool {
    let type = checker.result().typeOf(expression.green());
    return type != null && (types.isClassLike(type) || type is ArrayType);
}

// Whether the name already means something where a fix would declare a local of that name.
nameTaken(BodyChecker checker, string name) -> bool {
    let current = checker.currentScope();
    if (current != null && current.lookup(name) != null) {
        return true;
    }
    if (checker.resolver().typeParameterNamed(name) != null
            || checker.resolveNameOutsideTypeParameters(name) != null) {
        return true;
    }
    let callable = checker.frame().callableSyntax();
    return callable != null && declaresName(callable, name);
}

// The sentence that points two strings at 'compareTo', spelled with the operands' own names.
// An operand with no spelling gets a description of the result instead.
public orderingAdvice(BodyChecker checker, string operatorText, Expression leftNode, Expression rightNode,
                      Type left, Type right) -> string {
    let operands = classifyOperands(checker, leftNode, rightNode, left, right, null);
    let first = operands[0];
    let second = operands[1];
    if (first.held().length == 0 || second.held().length == 0) {
        return "Order strings with 'compareTo'. Its result is below zero when the string it is "
            + "called on sorts before the argument.";
    }
    string receiver = first.held();
    if (first.form() == OperandForm.Present && !wording.isSingleTerm(leftNode)) {
        receiver = "({first.held()})";
    }
    return "Order strings with 'compareTo', as in '{receiver}.compareTo({second.held()}) {operatorText} 0'.";
}

// How a refusal describes the step that keeps a value from being stable, a field or an element,
// spelled as 'spelled'.
unstableWords(BodyChecker checker, Expression step, string spelled) -> UnstableStepWords {
    string place = "'{spelled}'";
    let access = accessStep(step);
    if (access == null || access.member() == null) {
        return new UnstableStepWords("an array element", "element", "change", place);
    }
    let field = accessedField(checker, step);
    if (field != null && field.isWeak()) {
        return new UnstableStepWords("a 'weak' field", "field", "become null", place);
    }
    return new UnstableStepWords("a field", "field", "change", place);
}

// Whether the expression reads storage a write can reach, which a call's result is not.
namesStorage(BodyChecker checker, Expression expression) -> bool {
    Expression core = syntax.unwrapParentheses(expression);
    switch (core) {
        is IdentifierExpressionNode ignored -> {
            return true;
        },
        is ThisExpressionNode ignored -> {
            return true;
        },
        is SuperExpressionNode ignored -> {
            return true;
        },
        is MemberExpressionNode member -> {
            return namesStorage(checker, member.object());
        },
        is SubscriptExpressionNode element -> {
            return namesStorage(checker, element.object());
        },
        default -> {
            return false;
        },
    }
}

// The refusal followed by the guidance, or the refusal alone when there is no guidance.
public withGuidance(BodyChecker checker, string refusal, string? guidance) -> string {
    if (guidance == null) {
        return refusal;
    }
    return refusal + " " + guidance;
}

// Whether a class extending the type, however far down, has a member of this name, which a
// type test on the value would have let a use reach.
public subclassHasMember(BodyChecker checker, Type type, string name) -> bool {
    if (!(type is ClassType)) {
        return false;
    }
    let subclasses = type.directSubclasses();
    for (long i = 0; i < subclasses.length(); i++) {
        let subclass = subclasses.get(i);
        if (!(memberaccess.lookupMember(checker, subclass, name) is MissingMember)) {
            return true;
        }
        if (subclassHasMember(checker, subclass, name)) {
            return true;
        }
    }
    return false;
}

// Why a 'char' value does not reach the integer type 'target', which has room for only some code
// points, and the cast that converts one known to fit. Empty for any other pair.
charNarrowingHint(BodyChecker checker, Type target, Type source, Expression? value) -> string {
    Type core = convert.coreOf(target);
    if (!(source is PrimitiveType) || source.kind() != PrimitiveKind.Char || !(core is PrimitiveType)) {
        return "";
    }
    let kind = core.kind();
    if (kind != PrimitiveKind.Byte && kind != PrimitiveKind.Short && kind != PrimitiveKind.UShort) {
        return "";
    }
    string name = checker.names().of(core);
    string limit = literalvalues.integerLimit(kind);
    string why = " A 'char' is a character's number in Unicode, its code point, which can be as large "
        + "as 1114111, and the largest value of '{name}' is {limit}.";
    if (value == null) {
        return "{why} Convert it with 'as {name}' if its code point is at most {limit}.";
    }
    string converted = wording.converted(syntax.unwrapParentheses(value), name);
    return "{why} Write '{converted}' if the character's code point is at most {limit}.";
}

// assignabilityHint with the mismatched value in hand, which a value that fits once its null is
// gone extends with the null guidance for the place it is read from, unless 'target' allows as many
// levels of null as the value has. A value that does not fit for another reason gets the conversion
// that keeps it, or the change of the declaration at 'origin' that takes it, where either applies.
public valueAssignabilityHint(BodyChecker checker, Type target, Type source, Expression? value,
                              LiteralOrigin? origin = null, ElsewhereDeclaration? elsewhere = null)
                              -> string {
    string narrowing = charNarrowingHint(checker, target, source, value);
    if (narrowing.length > 0) {
        return narrowing;
    }
    string hint = assignabilityHint(target, source, checker.names(), elsewhere);
    long levels = nullLevelsAbove(target, source);
    if (target is ErrorType || hint.length > 0) {
        return hint;
    }
    if (levels > 0 && wording.optionalLevels(source) <= wording.optionalLevels(target)) {
        return "";
    }
    if (levels > 0 && value != null) {
        let chain = chainAdvice(checker, value, levels);
        if (chain != null) {
            return " {chain}";
        }
        let calls = nullableCalls(checker, value);
        string why = " The value may be null here.";
        if (calls != null) {
            why = " {calls} can return null.";
        }
        let declaration = declarationFix(checker, target, value, origin);
        if (declaration != null) {
            return "{why} {declaration}";
        }
        return withGuidance(checker, why, nullGuidance(checker, value, source, levels));
    }
    if (levels > 0) {
        return "";
    }
    return mismatchFix(checker, target, source, value, origin);
}

// The fix for a value of type 'source' where 'target' is expected: the conversion that keeps the value,
// under the condition it needs, and the change that declares the place at 'origin' with the value's own
// type. Empty where neither applies.
mismatchFix(BodyChecker checker, Type target, Type source, Expression? value,
            LiteralOrigin? origin) -> string {
    if (source is ErrorType || source is NullType || types.isVoidType(source)) {
        return "";
    }
    string conversion = valueConversion(checker, target, source, value);
    string declaration = "";
    Type wanted = source;
    for (long i = 0; i < wording.optionalLevels(target); i++) {
        wanted = checker.store().optionalOf(wanted);
    }
    if (origin != null && checker.names().canSpell(wanted) && !convert.containsTypeParam(wanted)
            && !convert.containsTypeParam(target)) {
        declaration = literalfixes.declarationChange(origin, checker.names().of(wanted));
    }
    if (conversion.length > 0 && declaration.length > 0) {
        return " {conversion}, or {declaration}.";
    }
    if (conversion.length > 0) {
        return " {conversion}.";
    }
    if (declaration.length > 0) {
        return " {declaration.substring(0, 1).toUpperAscii()}{declaration.substring(1)} instead.";
    }
    return "";
}

// The conversion 'converted' of the integer literal 'value' to the integer kind 'kind', which keeps it
// exactly where its value is one of the kind's, and empty where it is not.
literalConversion(string converted, Expression value, PrimitiveKind kind) -> string {
    let literal = literaltyping.integerLiteralOf(value, true);
    if (literal == null) {
        return "";
    }
    let magnitude = literalvalues.integerMagnitude(literal.value().text());
    if (magnitude == null
            || !literalvalues.magnitudeFits(literaltyping.isNegativeLiteral(value), magnitude, kind)) {
        return "";
    }
    return converted;
}

// The conversion of a number of type 'source' to the number type 'target' has without its '?', under
// the condition that keeps the value: an integer inside the target's range, or any number where the
// nearest floating-point value is close enough. Between two signed types the condition names the whole
// range, because a negative value is kept as well. Empty for a floating-point number that would lose its
// fraction, for a 'char', and for anything that is not a number.
valueConversion(BodyChecker checker, Type target, Type source, Expression? value) -> string {
    Type core = convert.coreOf(target);
    if (!(source is PrimitiveType) || !(core is PrimitiveType) || !convert.isNumericType(source)
            || !convert.isNumericType(core) || source.kind() == PrimitiveKind.Char
            || core.kind() == PrimitiveKind.Char) {
        return "";
    }
    string name = checker.names().of(core);
    string? spelled = null;
    string converted = "Convert the value with 'as {name}'";
    if (value != null) {
        spelled = wording.shortSpelling(value);
        if (spelled != null) {
            converted = "Write '{wording.converted(syntax.unwrapParentheses(value), name)}'";
        } else if (!wording.isSingleTerm(syntax.unwrapParentheses(value))) {
            converted = "Put the value in parentheses and write 'as {name}' after them";
        }
    }
    if (convert.isIntegerType(source) && convert.isIntegerType(core) && value != null
            && literaltyping.integerLiteralOf(value, true) != null) {
        return literalConversion(converted, value, core.kind());
    }
    if (convert.isIntegerType(source) && convert.isIntegerType(core)) {
        bool signed = !literalfixes.isUnsignedKind(source.kind())
            && !literalfixes.isUnsignedKind(core.kind());
        if (signed) {
            string subject = "the value";
            if (spelled != null) {
                subject = "'{spelled}'";
            }
            return "{converted} if {subject} is {literalvalues.integerRange(core.kind())}";
        }
        return converted + literalfixes.keepsValueCondition(spelled, source.kind(), core.kind(), "the value");
    }
    if (convert.isFloatType(core)) {
        return "{converted} if the '{name}' nearest to its value is close enough";
    }
    return "";
}

// The advice for the operands, said once when both take the same fix. Null when none has advice.
operandsAdvice(NullableOperand[] operands, string operatorText = "") -> string? {
    if (operands.length == 2 && operands[0].form() == operands[1].form()
            && operands[0].levels == operands[1].levels && !samePlace(operands[0], operands[1])
            && (operands[0].objectRead.length == 0) == (operands[1].objectRead.length == 0)
            && (operands[0].copyName.length == 0) == (operands[1].copyName.length == 0)
            && operands[0].objectTest.length == 0 && operands[1].objectTest.length == 0
            && operands[0].laterAssignment.length == 0 && operands[1].laterAssignment.length == 0
            && operands[0].endedReason.length == 0 && operands[1].endedReason.length == 0) {
        let paired = formAdvice(operands, operatorText);
        if (paired != null) {
            return paired;
        }
    }
    string advice = "";
    string first = "";
    for (long i = 0; i < operands.length; i++) {
        let one = formAdvice([operands[i]], operatorText);
        if (one != null && (i == 0 || (!samePlace(operands[0], operands[i]) && one != first))) {
            advice = "{advice} {one}";
        }
        if (i == 0 && one != null) {
            first = one;
        }
    }
    if (advice.length == 0) {
        return null;
    }
    return advice.substring(1);
}

// The advice for one operand, or for two of the same form, which then share each sentence. Two
// operands are joined by 'operatorText'.
formAdvice(NullableOperand[] operands, string operatorText) -> string? {
    let first = operands[0];
    if (first.laterAssignment.length > 0) {
        string name = first.spelling;
        string assignment = first.laterAssignment;
        return "The lambda copies '{name}' when it is created. The assignment '{assignment}' comes later in "
            + "the same call. Assign '{name}' before the call, for example '{assignment};'.";
    }
    if (first.objectRead.length > 0) {
        return "{narrowing.objectReadReason(objectReads(operands))} {objectReadAdvice(operands)}";
    }
    if (first.endedReason.length > 0) {
        return endedAdvice(first);
    }
    switch (first.form()) {
        Stable -> {
            string names = joinedValues(operands, false, "'", "'", " and ");
            string condition = joinedValues(operands, false, "", " != null", " && ");
            if (first.levels == 1) {
                return "Check {names} for null first ('if ({condition})').";
            }
            return "Check {names} for null{repeatedCheck(condition, first.levels, first.everyLevel)}.";
        },
        Copied -> {
            return copiedAdvice(operands, "null check", "check");
        },
        Stored -> {
            return storedAdvice(operands);
        },
        Guarded -> {
            return guardedAdvice(operands, operatorText);
        },
        NoFix -> {
            return fallbackAdvice(operands, false);
        },
        default -> {
            return null;
        },
    }
}

// Why an operand whose proof a write ended may be null here, and the check to write where it helps, or
// the fallback to supply where no statement can go.
endedAdvice(NullableOperand operand) -> string {
    if (operand.form() == OperandForm.NoFix) {
        let fallback = fallbackAdvice([operand], false);
        return fallback == null ? operand.endedReason : "{operand.endedReason} {fallback}";
    }
    if (operand.endedWhere.length == 0) {
        return operand.endedReason;
    }
    string condition = "{operand.held()} != null";
    string check = "Check '{operand.held()}' for null {operand.endedWhere}";
    if (operand.levels == 1) {
        return "{operand.endedReason} {check} ('if ({condition})').";
    }
    return "{operand.endedReason} {check}{repeatedCheck(condition, operand.levels, operand.everyLevel)}.";
}

// The parts of the operands that the lambda being checked reads from objects, each once.
objectReads(NullableOperand[] operands) -> string[] {
    let reads = new List<string>();
    for (let operand in operands) {
        if (!reads.contains(operand.objectRead)) {
            reads.push(operand.objectRead);
        }
    }
    return reads.toArray();
}

// The copy to make before the lambda being checked, or the check or the type test to write inside it
// where no statement can go before it, for one operand, or for two of the same form, where a proof
// made outside the lambda covers them.
objectReadAdvice(NullableOperand[] operands) -> string {
    let first = operands[0];
    if (first.copyName.length > 0) {
        return objectCopyAdvice(operands);
    }
    if (first.objectTest.length > 0) {
        return "Test '{first.spelling}' inside the lambda, as in {first.objectTest}.";
    }
    if (first.form() == OperandForm.NoFix) {
        return fallbackAdvice(operands, false) ?? "";
    }
    string names = joinedValues(operands, false, "'", "'", " and ");
    string condition = joinedValues(operands, false, "", " != null", " && ");
    if (first.levels == 1) {
        return "Check {names} for null inside the lambda ('if ({condition})').";
    }
    return "Check {names} for null inside the lambda"
        + "{repeatedCheck(condition, first.levels, first.everyLevel)}.";
}

// The copy of each operand into a local before the lambda being checked, which the lambda then reads.
// Where two operands would copy into locals of one name, the second takes another.
objectCopyAdvice(NullableOperand[] operands) -> string {
    bool clash = operands.length == 2 && operands[0].copyName == operands[1].copyName;
    let places = new List<string>();
    let copies = new List<string>();
    let retests = new List<string>();
    bool named = true;
    for (long i = 0; i < operands.length; i++) {
        let operand = operands[i];
        string name = operand.copyName;
        string[] changes = operand.copyRetests;
        if (clash && i == 1) {
            name = operand.otherCopyName;
            changes = operand.otherCopyRetests;
        }
        places.push(operand.copyPlace);
        copies.push("let {name} = {operand.copyPlace};");
        for (let change in changes) {
            if (!retests.contains(change)) {
                retests.push(change);
            }
        }
        named = named && operand.copyPlace == operand.objectRead;
    }
    return narrowing.objectCopyAdvice(places.toArray(), copies.toArray(), named, retests.toArray());
}

// The advice for the values read where no statement can go, which only a '??' fallback can give a
// value, or with 'any' for values of any form. A write gets none, because '??' makes no place.
fallbackAdvice(NullableOperand[] operands, bool any) -> string? {
    let first = operands[0];
    let named = new List<string>();
    for (let operand in operands) {
        if (operand.writes || operand.levels == 0 || (!any && operand.form() != OperandForm.NoFix)) {
            return null;
        }
        named.push(operand.fallbackParenthesized ? "'({operand.spelling})'" : "'{operand.spelling}'");
    }
    string fallbacks = "a fallback for {named.get(0)}";
    if (operands.length > 1) {
        fallbacks = "fallbacks for {diagnostics.andJoined(named.toArray())}";
    }
    if (first.levels < 2) {
        return "Supply {fallbacks} with '??'.";
    }
    string times = timesWord(first.levels);
    if (!first.everyLevel) {
        return "Supply {fallbacks} with '??' {times}.";
    }
    return "Supply {fallbacks} with '??' {times}, once for each '?'.";
}

// Whether the value is a '?:' or a switch expression.
public isJoin(Expression value) -> bool {
    return value is TernaryExpressionNode || value is SwitchExpressionNode;
}

// "twice", "three times" or "N times".
timesWord(long levels) -> string {
    if (levels == 2) {
        return "twice";
    }
    if (levels == 3) {
        return "three times";
    }
    return "{levels} times";
}

// The advice for one or two call results, or fields read from them, stored in locals to check.
storedAdvice(NullableOperand[] operands) -> string? {
    let first = operands[0];
    let second = operands[operands.length - 1];
    if (first.wholeCall != second.wholeCall) {
        return null;
    }
    string callees = "'{first.callee}'";
    if (second.callee != first.callee) {
        callees = "{callees} and to '{second.callee}'";
    }
    string fix = localsFix(operands, "check", true, "");
    bool checked = first.checkedEarlier || second.checkedEarlier;
    if (first.wholeCall) {
        if (!checked && operands.length == 2) {
            return "Store both results in {fix}";
        }
        if (!checked) {
            return "Store the result in {fix}";
        }
        if (operands.length == 2) {
            return "Each call to {callees} returns its own result, so a null check on an earlier call does "
                + "not cover a later one. Store both results in {fix}";
        }
        return "Each call to {callees} returns its own result, so the null check on an earlier call does "
            + "not cover this one. Store the result in a local before that check "
            + "('{first.declaration()}'), and check and use the local instead of calling '{first.callee}' "
            + "again.";
    }
    string fields = "'{first.spelling}' is a field of the result of a call";
    string read = "'{first.spelling}'";
    string stored = read;
    if (operands.length == 2 && second.spelling == first.spelling) {
        fields = "Both sides read '{first.spelling}', a field of the result of a call";
        stored = "'{first.spelling}' from both calls";
    } else if (operands.length == 2) {
        fields = "'{first.spelling}' and '{second.spelling}' are fields of the results of calls";
        read = "them";
        stored = "'{first.spelling}' and '{second.spelling}'";
    }
    if (!checked) {
        return "Store {stored} in {fix}";
    }
    return "{fields}. Each call to {callees} returns its own result, so a later read of {read} can be "
        + "null even after a null check. Store {stored} in {fix}";
}

// The advice for one or two values read through '?.' or '?[', which is null whenever the value in
// front of the '?' is null. Two operands are joined by 'operatorText'.
guardedAdvice(NullableOperand[] operands, string operatorText) -> string? {
    let first = operands[0];
    let second = operands[operands.length - 1];
    if (second.guard != first.guard && first.held().length > 0 && second.held().length > 0) {
        return "'{first.spelling}' is null whenever '{first.guard}' is null, and '{second.spelling}' "
            + "whenever '{second.guard}' is null. Check both for null first ('if ({first.guard} != null "
            + "&& {second.guard} != null)') and write '{first.held()} {operatorText} {second.held()}', or "
            + "supply fallbacks with '??'.";
    }
    if (second.guard != first.guard || (first.held().length == 0) != (second.held().length == 0)) {
        return null;
    }
    string reads = "'{first.spelling}' is";
    string plain = "'{first.held()}'";
    if (operands.length == 2) {
        reads = "'{first.spelling}' and '{second.spelling}' are";
        plain = "'{first.held()}' and '{second.held()}'";
    }
    string refusal = "{reads} null whenever '{first.guard}' is null.";
    if (first.held().length == 0) {
        return "{refusal} Supply a fallback with '??'.";
    }
    return "{refusal} Check '{first.guard}' for null first ('if ({first.guard} != null)') and write "
        + "{plain}, or supply a fallback with '??'.";
}

// The advice for one or two operands that read a field or an element, for a check named 'check'.
// A compound assignment writes its result back to the first.
copiedAdvice(NullableOperand[] operands, string check, string verb) -> string? {
    let first = operands[0].words;
    let second = operands[operands.length - 1].words;
    if (first == null || second == null) {
        return null;
    }
    string stores = operands[0].stores;
    if (operands.length == 2 && (stores.length > 0 || operands[1].stores.length > 0)) {
        return null;
    }
    string described = "{first.place} is {first.kind}, so it can {first.change}";
    string copied = "it";
    string checked = copied;
    bool eachRead = operands.length == 2 && operands[0].spelling == operands[1].spelling;
    if (eachRead) {
        described = "Both sides read {first.place}, {first.kind}, so it can {first.change}";
        copied = "them";
        if (holdsMore(operands)) {
            checked = "'{operands[0].spelling}'";
        }
    } else if (operands.length == 2) {
        string change = "change";
        if (first.change == second.change) {
            change = first.change;
        }
        described = "{first.place} is {first.kind} and {second.place} is {second.kind}, so they can "
            + change;
        if (first.kind == second.kind) {
            string kind = first.kind.substring(first.kind.startsWith("an ") ? 3 : 2);
            described = "{first.place} and {second.place} are {kind}s, so they can {change}";
        }
        copied = "them";
        checked = copied;
        if (holdsMore(operands)) {
            checked = joinedValues(operands, true, "'", "'", " and ");
        }
    } else if (holdsMore(operands)) {
        checked = joinedValues(operands, true, "'", "'", " and ");
    }
    string outcome = "null";
    if (check != "null check") {
        outcome = "another type";
    }
    string action = "Copy {copied} into";
    string fix = localsFix(operands, verb, check == "null check", operands[0].writeBack);
    if (eachRead && fix.startsWith("locals ")) {
        action = "Copy each read into";
        fix = "a local " + fix.substring(7);
    }
    if (stores.length > 0) {
        action = "Store {stores} in";
    }
    return "{described} at any time. A later read of {checked} can be {outcome} even after a {check}. "
        + "{action} {fix}";
}

// The part of a fix that declares the locals and checks them, ending with the write-back to 'place'
// when there is one.
localsFix(NullableOperand[] operands, string verb, bool forNull, string place) -> string {
    string where = "a local";
    string checked = "{verb} the local";
    string declarations = operands[0].declaration();
    let words = operands[0].words;
    if (operands[0].stores.length > 0 && words != null) {
        where = "locals";
        checked = "{verb} '{operands[0].local()}'";
    }
    if (operands.length == 2) {
        where = "locals";
        checked = "{verb} the locals";
        declarations = "{declarations} {operands[1].declaration()}";
    }
    if (holdsMore(operands)) {
        checked = "{verb} {joinedValues(operands, false, "'", "'", " and ")}";
        if (forNull) {
            checked = "{checked} for null";
        }
    }
    string condition = joinedValues(operands, false, "", " != null", " && ");
    checked = checked + repeatedCheck(condition, operands[0].levels, operands[0].everyLevel);
    if (place.length == 0) {
        return "{where} first ('{declarations}') and {checked}.";
    }
    return "{where} first ('{declarations}'), {checked}, and write the result back to {place}.";
}

// The operands' values, each as the fix leaves it or, when 'written', as the code spells it.
// Each goes between 'before' and 'after', joined by 'between', as in "'a' and 'b'".
joinedValues(NullableOperand[] operands, bool written, string before, string after,
             string between) -> string {
    string text = "";
    for (let operand in operands) {
        string value = operand.held();
        if (written) {
            value = operand.spelling;
        }
        if (text.length > 0) {
            text = text + between;
        }
        text = text + before + value + after;
    }
    return text;
}

// Whether the local of one of the operands contains more than its value.
holdsMore(NullableOperand[] operands) -> bool {
    for (let operand in operands) {
        if (operand.held() != operand.local()) {
            return true;
        }
    }
    return false;
}

// Whether both operands read the same place, which one fix covers.
samePlace(NullableOperand first, NullableOperand second) -> bool {
    return (first.form() == OperandForm.Stable || first.form() == OperandForm.Copied
            || first.form() == OperandForm.Guarded)
        && first.form() == second.form() && first.spelling == second.spelling && !first.calls;
}

// Whether a local or a parameter of that name is declared anywhere under the node.
declaresName(SyntaxNode node, string name) -> bool {
    string declared = "";
    switch (node) {
        is VariableDeclarationNode variable -> {
            declared = variable.name().text();
        },
        is ParameterNode parameter -> {
            declared = parameter.name().text();
        },
        is LambdaParameterNode parameter -> {
            declared = parameter.name().text();
        },
        is ForEachStatementNode loop -> {
            declared = loop.name().text();
        },
        is CatchClauseNode clause -> {
            declared = clause.name().text();
        },
        is TypeArmNode arm -> {
            let binding = arm.binding();
            if (binding != null) {
                declared = binding.text();
            }
        },
        default -> {},
    }
    if (declared == name) {
        return true;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (declaresName(children.get(i), name)) {
            return true;
        }
    }
    return false;
}

// The member names from 'step' out to the value, as in '.count' for 'h.inner.count' after 'h.inner'.
// Parentheses on the way are left out.
memberSteps(Expression value, Expression step) -> string {
    string steps = "";
    Expression core = syntax.unwrapParentheses(value);
    while (core is MemberExpressionNode
            && (core.span().start != step.span().start || core.span().end() != step.span().end())) {
        steps = ".{core.member().text()}{steps}";
        core = syntax.unwrapParentheses(core.object());
    }
    return steps;
}

// The field or element access the expression is, or null for any other expression.
public accessStep(Expression expression) -> AccessStep? {
    switch (expression) {
        is MemberExpressionNode member -> {
            return new AccessStep(member.object(), member.member().text(), null, false);
        },
        is SafeMemberExpressionNode member -> {
            return new AccessStep(member.object(), member.member().text(), null, true);
        },
        is SubscriptExpressionNode element -> {
            return new AccessStep(element.object(), null, element.index(), false);
        },
        is SafeSubscriptExpressionNode element -> {
            return new AccessStep(element.object(), null, element.index(), true);
        },
        default -> {
            return null;
        },
    }
}

// Whether a call is made anywhere in the element.
containsCall(GreenElement element) -> bool {
    if (element.kind() == SyntaxKind.CallExpression) {
        return true;
    }
    if (element is GreenNode) {
        for (long i = 0; i < element.slotCount(); i++) {
            let slot = element.slot(i);
            if (slot != null && containsCall(slot)) {
                return true;
            }
        }
    }
    return false;
}

// The name of the function or method a call invokes, or null when the callee has none.
calleeName(CallExpressionNode call) -> string? {
    Expression callee = syntax.unwrapParentheses(call.callee());
    switch (callee) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text();
        },
        is MemberExpressionNode member -> {
            return member.member().text();
        },
        default -> {
            return null;
        },
    }
}

// The base name of the local a call's result is stored in, as in 'boxLookup' for 'box.lookup()' or
// 'findResult' for 'find()'.
storedResultName(CallExpressionNode call, string callee) -> string {
    Expression reached = syntax.unwrapParentheses(call.callee());
    if (reached is MemberExpressionNode) {
        let receiver = syntax.unwrapParentheses(reached.object());
        if (receiver is IdentifierExpressionNode) {
            string owner = receiver.name().text();
            return joinedName(owner.substring(0, 1).toLowerAscii() + owner.substring(1), callee);
        }
    }
    return "{callee}Result";
}

// Two names joined into one, the second starting with a capital letter.
joinedName(string first, string second) -> string {
    return first + second.substring(0, 1).toUpperAscii() + second.substring(1);
}

// The words that spell out 'levels' nested null checks of 'condition', or nothing for one level.
// 'everyLevel' is true when the checks remove every '?' of the type.
repeatedCheck(string condition, long levels, bool everyLevel) -> string {
    if (levels < 2) {
        return "";
    }
    string times = timesWord(levels);
    string opened = "";
    string closed = "";
    for (long i = 0; i < levels; i++) {
        opened = opened + "if ({condition}) \{ ";
        closed = closed + " \}";
    }
    if (!everyLevel) {
        return " {times} ('{opened}...{closed}')";
    }
    return " {times}, once for each '?' ('{opened}...{closed}')";
}

// A value type flowing into an interface-typed slot it conforms to. The conformance is a
// compile-time judgment: it lets a generic bound take the value, and nothing more, because a
// struct and a primitive are both held as their own bits and so have no interface value.
public valueConformanceHint(Type target, Type source, TypeNames names,
                            ElsewhereDeclaration? elsewhere = null) -> string {
    string kind = types.valueKindWord(source);
    if (kind.length == 0) {
        return "";
    }
    Type slot = target;
    while (slot is OptionalType) {
        slot = slot.inner();
    }
    if (!types.isInterfaceLike(slot) || !hierarchy.conformsTo(source, slot)) {
        return "";
    }
    string shown = names.quoted(source);
    string quotedSlot = names.quoted(slot);
    string bounded = names.quotedCode(["<T: ", ">"], [slot]);
    string fix = "Declare the type as {shown}, or declare {bounded} and use 'T'.";
    if (elsewhere != null) {
        let there = elsewhere.names();
        fix = "Declare {elsewhere.described()} as {there.quoted(source)}, or declare "
            + "{there.quotedCode(["<T: ", ">"], [slot])} after {elsewhere.typeParameterHost()} and declare "
            + "the {elsewhere.noun()} as 'T'.";
    }
    return " {shown} implements {quotedSlot}, but {typenames.typeArticle(kind)} {kind} can only be passed "
        + "where a type parameter such as {bounded} is declared. A value of type {quotedSlot} must be "
        + "an object of a class, and {typenames.typeArticle(kind)} {kind} value is not one. {fix}";
}

// Whether the hint for a value of type 'source' where 'target' is expected tells the reader to change
// the declaration that has type 'target'.
public hintRetypesDeclaration(BodyChecker checker, Type target, Type source, Expression? value) -> bool {
    return charNarrowingHint(checker, target, source, value).length == 0
        && assignabilityHint(target, source, checker.names(), null).length > 0;
}

// A declaration in another file whose type a fix tells the reader to change. The fix names it, spells
// its types with the names of that file, and points a note at it.
public final class ElsewhereDeclaration {
    string declarationNoun;
    string declarationName;
    string declarationOwner;
    string declarationHost;
    TypeNames declaringNames;
    string declaringFile;
    Span declarationSpan;

    public constructor(this.declarationNoun, this.declarationName, this.declarationOwner,
                       this.declarationHost, this.declaringNames, this.declaringFile,
                       this.declarationSpan);

    // What the declaration is: "parameter" or "field".
    public noun() -> string {
        return this.declarationNoun;
    }

    // The declaration as a fix names it: "parameter 'kind' of 'use'".
    public described() -> string {
        return "{this.declarationNoun} '{this.declarationName}' of {this.declarationOwner}";
    }

    // Where a type parameter for the declaration is written after: "'use'" or "'Holder'".
    public typeParameterHost() -> string {
        return this.declarationHost;
    }

    // The names of the file that declares it.
    public names() -> TypeNames {
        return this.declaringNames;
    }

    // The notes a problem whose fix changes this declaration points at.
    public notes() -> RelatedLocation[] {
        return [new RelatedLocation(this.declaringFile, this.declarationSpan,
            "{this.described()} is declared here")];
    }
}

// Parameter 'parameter' of 'signature', the signature of 'method' or of a function, as a declaration in
// another file, or null where the file being checked declares it. 'callable' names what declares it, as
// in "'use'" or "the constructor of 'Box'".
public parameterElsewhere(BodyChecker checker, Signature signature, Method? method, string callable,
                          Parameter parameter) -> ElsewhereDeclaration? {
    DeclaredType? owner = null;
    ModuleContext? declaring = null;
    string host = "'{signature.name()}'";
    if (method == null) {
        declaring = functionContextOf(checker, signature);
    } else {
        owner = types.authorityOf(method.definingType());
        if (owner != null) {
            declaring = checker.contextsByPath().get(owner.modulePath());
            if (method.isConstructor()) {
                host = checker.names().quotedName(owner);
            }
        }
    }
    if (declaring == null) {
        return null;
    }
    string filePath = declaring.module().filePath();
    if (filePath == checker.context().module().filePath()) {
        return null;
    }
    let names = declaring.names().withParametersOf(owner, signature.typeParameters());
    return new ElsewhereDeclaration("parameter", parameter.name(), callable, host, names, filePath,
        parameter.span());
}

// Field 'field' as a declaration in another file, or null where the file being checked declares it.
public fieldElsewhere(BodyChecker checker, Field field) -> ElsewhereDeclaration? {
    let owner = types.authorityOf(field.definingType());
    if (owner == null) {
        return null;
    }
    let declaring = checker.contextsByPath().get(owner.modulePath());
    if (declaring == null || owner.filePath() == checker.context().module().filePath()) {
        return null;
    }
    string ownerName = checker.names().quotedName(owner);
    return new ElsewhereDeclaration("field", field.name(), ownerName, ownerName,
        declaring.names().withParametersOf(owner), owner.filePath(), field.nameSpan());
}

// The module that declares the function whose signature is 'signature', or null where no module
// declares that signature, as for an instantiation of a generic function.
functionContextOf(BodyChecker checker, Signature signature) -> ModuleContext? {
    for (let context in checker.contextsByPath().values()) {
        for (let entry in context.functions().all()) {
            if (entry.signature() == signature) {
                return context;
            }
        }
    }
    return null;
}

// Guidance appended to an assignability failure: a value type flowing into an interface it
// conforms to, or 'null' flowing into a type without '?'. It opens with a space, because the
// sentence before it ends with a full stop.
assignabilityHint(Type target, Type source, TypeNames names, ElsewhereDeclaration? elsewhere)
        -> string {
    if (target is ErrorType) {
        return "";
    }
    string conformance = valueConformanceHint(target, source, names, elsewhere);
    if (conformance.length > 0) {
        return conformance;
    }
    if (source is NullType && !(target is OptionalType)) {
        string fix = "Write the type as {names.quotedNullable(target)}";
        if (elsewhere != null) {
            fix = "Write the type of {elsewhere.described()} as {elsewhere.names().quotedNullable(target)}";
        }
        return calls.neverNullHint(names.quoted(target), fix);
    }
    return "";
}

// valueAssignabilityHint for the element 'value' of type 'source' of an array literal whose elements
// have the type 'element', where the array's type is set at 'origin': a 'null' element gets the
// declaration that would take null elements. 'elementTypeWritten' is false where the array takes its
// element type from its first element, so no element type is written to change.
public elementAssignabilityHint(BodyChecker checker, Type element, Type source, Expression value,
                                LiteralOrigin? origin, bool elementTypeWritten = true) -> string {
    if (!(source is NullType) || element is OptionalType || element is ErrorType) {
        return valueAssignabilityHint(checker, element, source, value);
    }
    let names = checker.names();
    string quoted = names.quoted(element);
    if (origin != null) {
        let declared = convert.withNullableElements(origin.placeType(), element, checker.store());
        if (declared != null) {
            string change = elementDeclarationChange(origin, names.quoted(declared));
            if (change.length > 0) {
                return calls.neverNullElementsHint(quoted, change);
            }
        }
    }
    if (!elementTypeWritten) {
        return " {quoted} can never be null.";
    }
    return calls.neverNullHint(quoted, "Write the element type as {names.quotedNullable(element)}");
}

// The change that declares the place at 'origin' with the type 'quoted', or empty where no declaration
// there writes the type.
elementDeclarationChange(LiteralOrigin origin, string quoted) -> string {
    switch (origin.kind()) {
        Declared -> {
            if (origin.quotedFieldOwner().length > 0) {
                return "Declare field '{origin.name()}' of {origin.quotedFieldOwner()} as {quoted}";
            }
            return origin.name().length > 0 ? "Declare '{origin.name()}' as {quoted}" : "";
        },
        Parameter -> {
            if (origin.name().length == 0) {
                return "";
            }
            return "Declare {literalfixes.parameterNoun(origin)} as {quoted}";
        },
        Returned -> {
            return "Change the return type of '{origin.name()}' to {quoted}";
        },
        default -> {
            return "";
        },
    }
}

// How many '?' levels 'source' loses before a value of it fits 'target', or 0 when none does.
nullLevelsAbove(Type target, Type source) -> long {
    long levels = 0;
    Type remaining = source;
    while (remaining is OptionalType) {
        remaining = remaining.inner();
        levels++;
        if (convert.isAssignableStrict(target, remaining)) {
            return levels;
        }
    }
    return 0;
}
