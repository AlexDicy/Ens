import model.types;
import Type from model.types;
import ErrorType from model.types;
import NullType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import PrimitiveKind from model.types;
import PrimitiveType from model.types;
import EnumType from model.types;
import TypeParamType from model.types;
import TypeTestObligation from phases.obligations;
import List from @std.collections.list;
import Map from @std.collections.map;
import PriorityQueue from @std.collections.priorityqueue;
import Set from @std.collections.set;
import BodyChecker from phases.bodies;
import LiteralOrigin from phases.bodies.literaltargets;
import support.syntax;
import support.diagnostics;

// One fact a condition can prove: the storage path, the type the check proves for it, and
// whether the proof holds where the condition is true or where it is false.
public final class NarrowingFact {
    protected NarrowingPath path;
    protected Type proven;
    protected bool narrowsWhenTrue;
    // For a comparison of an 'as?' cast with null, which narrows nothing, the fix that writes the
    // 'is' test that would narrow; empty for every fact that narrows.
    protected string castHint = "";
    // The write on the right of a '&&' or '||' that leaves 'proven', or with 'ended' no proof, and whether
    // the fact is what that write leaves rather than what a test proves.
    protected NarrowingEnd? write = null;
    protected bool ended = false;
    protected bool fromWrite = false;

    protected constructor(this.path, this.proven, this.narrowsWhenTrue);

    // The same fact, with 'write' as the write that leaves what it proves.
    protected writtenBy(NarrowingEnd write) -> NarrowingFact {
        let copied = new NarrowingFact(this.path, this.proven, this.narrowsWhenTrue);
        copied.castHint = this.castHint;
        copied.ended = this.ended;
        copied.fromWrite = this.fromWrite;
        copied.write = write;
        return copied;
    }
}

// The path of a stable place, or null when the expression names none. A stable place is a
// local, a parameter, 'this', a static or lazy const read through its type, or a 'const' field
// reached through a stable place.
public buildNarrowingPath(BodyChecker checker, Expression expression) -> NarrowingPath? {
    Expression core = syntax.unwrapParentheses(expression);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            let binding = checker.result().bindingOf(identifier.green());
            if (binding == null) {
                return null;
            }
            return narrow.bindingPath(binding);
        },
        is ThisExpressionNode ignored -> {
            let receiver = checker.frame().thisBinding();
            if (receiver == null) {
                return null;
            }
            return narrow.bindingPath(receiver);
        },
        is MemberExpressionNode member -> {
            if (!nullguidance.readsConstField(checker, member)) {
                return null;
            }
            let typeLevel = checker.result().staticConstFieldOf(member.green());
            if (typeLevel != null) {
                return narrow.typeLevelPath(typeLevel);
            }
            let object = buildNarrowingPath(checker, member.object());
            if (object == null) {
                return null;
            }
            return object.extended(narrow.fieldSegment(member.member().text()));
        },
        default -> {
            return null;
        },
    }
}

// The type narrowing proved for a field read here, or the field's declared type when it proved none.
public narrowedFieldType(BodyChecker checker, MemberExpressionNode read, Type declared) -> Type {
    if (!(declared is OptionalType) && !types.isClassLike(declared)) {
        return declared;
    }
    let path = buildNarrowingPath(checker, read);
    if (path == null) {
        return declared;
    }
    return readType(checker, path, declared);
}

// The type a read of 'path' has: the type narrowing proved for it, or 'declared' where it proved
// none or where the type test that would prove one names a refused type.
public readType(BodyChecker checker, NarrowingPath path, Type declared) -> Type {
    let proven = checker.narrowing().provenType(path);
    if (proven == null || proven is ErrorType) {
        return declared;
    }
    return proven;
}

// Whether 'value' is a place where a type test on a refused type holds. Its type there is a type
// the program does not name, so a member its declared type lacks may belong to that type.
public refinementRefused(BodyChecker checker, Expression value) -> bool {
    let path = buildNarrowingPath(checker, value);
    return path != null && checker.narrowing().provenType(path) is ErrorType;
}

// Recognizes 'x == null' and 'x != null' over a narrowable path whose analyzed type is
// still optional. The equality analysis resets a fully-proven operand back to its declared
// storage type, so a redundant re-check re-proves the same fact rather than widening it.
detectNullCheck(BodyChecker checker, Expression condition) -> NarrowingFact? {
    if (!(condition is BinaryExpressionNode)) {
        return null;
    }
    SyntaxKind operator = condition.operator().kind();
    if (operator != SyntaxKind.EqualsEquals && operator != SyntaxKind.NotEquals) {
        return null;
    }
    Expression left = syntax.unwrapParentheses(condition.left());
    Expression right = syntax.unwrapParentheses(condition.right());
    Expression? checked = null;
    if (wording.isNullLiteral(right) && !wording.isNullLiteral(left)) {
        checked = left;
    } else if (wording.isNullLiteral(left) && !wording.isNullLiteral(right)) {
        checked = right;
    }
    if (checked == null) {
        return null;
    }
    let checkedType = checker.result().typeOf(checked.green());
    if (!(checkedType is OptionalType)) {
        return null;
    }
    let path = buildNarrowingPath(checker, checked);
    if (path == null) {
        return null;
    }
    touchLoopRoot(checker, path.root(), null);
    // One check strips one level, off the sharpest type proven for the path so far: a
    // re-check of a value already proven present at every level proves nothing new.
    Type presence = checker.narrowing().provenType(path) ?? checkedType;
    if (!(presence is OptionalType)) {
        return null;
    }
    return new NarrowingFact(path, presence.inner(), operator == SyntaxKind.NotEquals);
}

// A type test proves its operand is the target exactly when the test succeeds, so the
// fact carries only positive polarity: failing a bare 'is' proves nothing. A '!' around
// the test flips the polarity in collectNarrowings. A test whose type was refused proves that the
// operand's type is not known where the test holds, which readType and refinementRefused read.
detectTypeTest(BodyChecker checker, TypeTestExpressionNode test) -> NarrowingFact? {
    let path = buildNarrowingPath(checker, test.value());
    if (path == null) {
        return null;
    }
    touchLoopRoot(checker, path.root(), null);
    let refused = checker.result().typeOf(test.target().green());
    if (refused is ErrorType) {
        return new NarrowingFact(path, refused, true);
    }
    let testType = checker.result().typeOf(test.green());
    if (testType == null || !convert.isBoolType(testType)) {
        return null;
    }
    let target = checker.result().typeOf(test.target().green());
    if (target == null || target is OptionalType || !types.isClassLike(target)) {
        return null;
    }
    return new NarrowingFact(path, target, true);
}

// Adds to 'sink' the facts 'condition' proves where it evaluates to 'conditionHolds'. A write after a test
// in it is marked with the value the condition has only where the written place is null, if there is one.
public collectNarrowings(BodyChecker checker, Expression condition, bool conditionHolds,
                         List<NarrowingFact> sink, ConditionSite? site = null) {
    long first = sink.length();
    collectFacts(checker, condition, conditionHolds, sink, site);
    for (long i = first; i < sink.length(); i++) {
        let fact = sink.get(i);
        let write = fact.write;
        if (write != null && write.afterTestInCondition()
                && endsInNullCheck(checker, condition, conditionHolds, fact.path)) {
            sink.set(i, fact.writtenBy(write.inCondition(conditionHolds)));
        }
    }
}

// Adds to 'sink' the facts collectNarrowings collects for 'condition'.
collectFacts(BodyChecker checker, Expression condition, bool conditionHolds, List<NarrowingFact> sink,
             ConditionSite? site) {
    Expression core = syntax.unwrapParentheses(condition);
    if (core is PrefixExpressionNode && core.operator().kind() == SyntaxKind.Exclamation) {
        collectFacts(checker, core.operand(), !conditionHolds, sink, site);
        return;
    }
    if (core is TypeTestExpressionNode) {
        let fact = detectTypeTest(checker, core);
        if (fact != null && conditionHolds) {
            sink.push(fact);
        }
        return;
    }
    if (core is BinaryExpressionNode) {
        if (runsRight(core.operator().kind(), conditionHolds)) {
            long left = sink.length();
            collectFacts(checker, core.left(), conditionHolds, sink, site);
            if (!writeNamesOf(checker, core).isEmpty()) {
                afterRightOperand(sink, left, checker.rightOperandWrites(core));
            }
            collectFacts(checker, core.right(), conditionHolds, sink, site);
            return;
        }
    }
    let fact = detectNullCheck(checker, core);
    if (fact != null && fact.narrowsWhenTrue == conditionHolds) {
        sink.push(fact);
    }
    let hint = detectCastComparison(checker, core, site);
    if (hint != null && hint.narrowsWhenTrue == conditionHolds) {
        sink.push(hint);
    }
}

// Whether the right operand of the '&&' or '||' written 'operator' runs where the whole of it evaluates to
// 'conditionHolds'.
runsRight(SyntaxKind operator, bool conditionHolds) -> bool {
    return (conditionHolds && operator == SyntaxKind.AmpersandAmpersand)
        || (!conditionHolds && operator == SyntaxKind.PipePipe);
}

// Replaces the facts in 'sink' from 'left' on, which the left operand of a '&&' or '||' proves, with
// what they prove after its right operand, and adds the facts in 'written' for the other places it writes.
afterRightOperand(List<NarrowingFact> sink, long left, Map<NarrowingPath, NarrowingFact> written) {
    long end = sink.length();
    for (long i = left; i < end; i++) {
        sink.set(i, leftFactAfter(sink.get(i), written));
    }
    for (let path in written.keys()) {
        let changed = written.get(path);
        if (changed != null && !provesPlace(sink, left, end, path)) {
            sink.push(changed);
        }
    }
}

// What 'fact', which the left operand of a '&&' or '||' proves, proves after its right operand, from
// 'written', as afterRightOperand reads it. Where a test proved 'fact', a write in the right operand is named
// as a write in the condition after that test.
leftFactAfter(NarrowingFact fact, Map<NarrowingPath, NarrowingFact> written) -> NarrowingFact {
    let changed = written.get(fact.path);
    let write = changed?.write;
    if (changed == null || write == null || fact.fromWrite) {
        return changed ?? fact;
    }
    let after = new NarrowingFact(fact.path, changed.proven, fact.narrowsWhenTrue);
    after.ended = changed.ended;
    after.write = write.inCondition(null).narrowedFrom(fact.proven);
    return after;
}

// Whether one of the facts in 'facts' from 'first' up to 'end' is about the place 'path'.
provesPlace(List<NarrowingFact> facts, long first, long end, NarrowingPath path) -> bool {
    for (long i = first; i < end; i++) {
        if (facts.get(i).path == path) {
            return true;
        }
    }
    return false;
}

// The facts 'ran' holds where the right operand 'right' of a '&&' or '||' ends, for each place a write in
// 'right' changes.
factsAfterWrites(BranchChanges ran, Expression right) -> Map<NarrowingPath, NarrowingFact> {
    let written = new Map<NarrowingPath, NarrowingFact>();
    for (let path in ran.places) {
        let held = ran.held.proofs.get(path);
        let write = held == null ? ran.held.ends.get(path) : ran.held.writes.get(path);
        if (write != null && within(write.at(), right.span())) {
            let changed = new NarrowingFact(path, held ?? path.rootType(), true);
            changed.write = write;
            changed.ended = held == null;
            changed.fromWrite = true;
            written.set(path, changed);
        }
    }
    return written;
}

// Whether 'condition', where it evaluates to 'conditionHolds', holds only where the place 'path' is null,
// because it is a null check of that place or a '&&' or '||' whose right operand ends in one.
endsInNullCheck(BodyChecker checker, Expression condition, bool conditionHolds, NarrowingPath path) -> bool {
    Expression core = syntax.unwrapParentheses(condition);
    if (core is PrefixExpressionNode && core.operator().kind() == SyntaxKind.Exclamation) {
        return endsInNullCheck(checker, core.operand(), !conditionHolds, path);
    }
    if (core is BinaryExpressionNode && runsRight(core.operator().kind(), conditionHolds)) {
        return endsInNullCheck(checker, core.right(), conditionHolds, path);
    }
    let check = detectNullCheck(checker, core);
    return check != null && check.narrowsWhenTrue != conditionHolds && check.path == path;
}

public applyFacts(BodyChecker checker, List<NarrowingFact> facts) {
    for (long i = 0; i < facts.length(); i++) {
        let fact = facts.get(i);
        let write = fact.write;
        if (fact.ended) {
            if (write != null) {
                checker.narrowing().endProof(fact.path, write);
            }
            continue;
        }
        if (write != null) {
            checker.narrowing().narrow(fact.path, fact.proven);
            checker.narrowing().noteWrite(fact.path, write);
            continue;
        }
        checker.narrowing().narrow(fact.path, fact.proven);
        if (fact.castHint.length > 0) {
            checker.recordCastHint(fact.path, fact.castHint);
        }
    }
}

// Where a condition is written, which a fix that rewrites it writes around it: 'if (' and ')'
// around the condition of an 'if', and nothing around a '?:' or '&&' written whole.
public final class ConditionSite {
    string opening;
    Expression whole;
    string closing;

    public constructor(this.opening, this.whole, this.closing);

    // The condition as written with its part 'replaced' written as 'replacement', or null where
    // that is too long to quote or 'replaced' is not written exactly once in it.
    public rewritten(Expression replaced, string replacement) -> string? {
        string written = wording.oneLineSpelling(this.whole);
        string part = wording.oneLineSpelling(replaced);
        long at = written.indexOf(part);
        if (at < 0 || written.indexOf(part, at + 1) >= 0) {
            return null;
        }
        string result = this.opening + written.substring(0, at) + replacement
            + written.substring(at + part.length) + this.closing;
        if (result.length > wording.quotedCodeLimit()) {
            return null;
        }
        return result;
    }
}

// The hop a cast hint adds after the path of the value it is about. It reads no field.
final class CastHintHop {
    static const string name = "as?";
}

// The path an 'as?' cast compared with null would narrow if it were an 'is' test, which holds the
// cast's type where that comparison holds, for a read through the operand to name the test to write.
castHintPath(NarrowingPath path) -> NarrowingPath {
    return path.extended(narrow.fieldSegment(CastHintHop.name));
}

// The advice to test 'place' for 'tested' again right after the write at 'write', for the read 'read' after
// it in the same condition, or empty where the read is not after the write in one condition.
conditionRetest(BodyChecker checker, Expression read, Span write, string place, Type tested) -> string {
    let site = recheckSite(checker, read, write, tested);
    if (site == null) {
        return "";
    }
    string[] pieces = ["{site.operand} && {place} is ", ""];
    if (!site.whenTrue) {
        pieces = ["{site.operand} || !({place} is ", ")"];
    }
    long length = pieces[0].length + checker.names().of(tested).length + pieces[1].length;
    if (length > wording.quotedCodeLimit()) {
        return " Test '{place}' again after the assignment, in the same condition.";
    }
    string example = checker.names().quotedCode(pieces, [tested]);
    return " Test '{place}' again after the assignment, as in {example}.";
}

// Where a read after a write in the same condition can test the written place again: the operand of a '&&'
// or '||' that holds the write, spelled so that a test can follow it, and whether the read runs where that
// operand is true.
public final class RecheckSite {
    public string operand;
    public bool whenTrue;

    protected constructor(this.operand, this.whenTrue);
}

// Where the read 'read' can test its place again after the write at 'write', where the read runs only after
// the write in one condition. Null anywhere else, and where a part of the condition after the write proves
// the place null, or with 'tested' proves it is not a 'tested', so that no test after the write can pass.
public recheckSite(BodyChecker checker, Expression read, Span write, Type? tested) -> RecheckSite? {
    SyntaxNode? holder = read.parent();
    while (holder != null && !within(write, holder.span())) {
        holder = holder.parent();
    }
    Expression? held = null;
    bool whenTrue = true;
    if (holder is BinaryExpressionNode && within(write, holder.left().span())) {
        SyntaxKind operator = holder.operator().kind();
        if (operator == SyntaxKind.AmpersandAmpersand || operator == SyntaxKind.PipePipe) {
            held = holder.left();
            whenTrue = operator == SyntaxKind.AmpersandAmpersand;
        }
    } else if (holder is TernaryExpressionNode && within(write, holder.condition().span())) {
        held = holder.condition();
        whenTrue = within(read.span(), holder.thenValue().span());
    }
    if (held == null) {
        return null;
    }
    SyntaxKind chain = whenTrue ? SyntaxKind.AmpersandAmpersand : SyntaxKind.PipePipe;
    let path = buildNarrowingPath(checker, read);
    if (path == null) {
        return null;
    }
    let parts = new List<Expression>();
    chainParts(held, chain, parts);
    for (let part in parts) {
        if (part.span().end() >= write.end() && refutes(checker, part, whenTrue, path, tested)) {
            return null;
        }
    }
    Expression operand = held;
    while (operand is BinaryExpressionNode && operand.operator().kind() == chain
            && within(write, operand.right().span())) {
        operand = operand.right();
    }
    string spelled = wording.oneLineSpelling(operand);
    if (whenTrue && operand is BinaryExpressionNode && operand.operator().kind() == SyntaxKind.PipePipe) {
        spelled = "({spelled})";
    }
    return new RecheckSite(spelled, whenTrue);
}

// Adds to 'parts' the operands of the chain of 'operator' that 'expression' is, or 'expression' itself.
chainParts(Expression expression, SyntaxKind operator, List<Expression> parts) {
    if (expression is BinaryExpressionNode && expression.operator().kind() == operator) {
        chainParts(expression.left(), operator, parts);
        chainParts(expression.right(), operator, parts);
        return;
    }
    parts.push(expression);
}

// Whether 'part', which has the value 'holds' where a read runs, proves that 'path' is null, or with
// 'tested' that it is not a 'tested'.
refutes(BodyChecker checker, Expression part, bool holds, NarrowingPath path, Type? tested) -> bool {
    Expression core = syntax.unwrapParentheses(part);
    if (core is PrefixExpressionNode && core.operator().kind() == SyntaxKind.Exclamation) {
        return refutes(checker, core.operand(), !holds, path, tested);
    }
    if (tested != null) {
        if (holds || !(core is TypeTestExpressionNode)
                || buildNarrowingPath(checker, core.value()) != path) {
            return false;
        }
        let target = checker.result().typeOf(core.target().green());
        return target != null && !(target is ErrorType) && hierarchy.isSubclassOrConforms(tested, target);
    }
    if (!(core is BinaryExpressionNode)) {
        return false;
    }
    SyntaxKind operator = core.operator().kind();
    Expression left = syntax.unwrapParentheses(core.left());
    Expression right = syntax.unwrapParentheses(core.right());
    Expression checked = wording.isNullLiteral(right) ? left : right;
    if ((!wording.isNullLiteral(left) && !wording.isNullLiteral(right))
            || buildNarrowingPath(checker, checked) != path) {
        return false;
    }
    return (operator == SyntaxKind.EqualsEquals && holds) || (operator == SyntaxKind.NotEquals && !holds);
}

// The type test that narrows 'value' to 'tested', written the way the code being checked can hold
// it: an 'if' where a statement can go, and a '?:' anywhere else.
public typeTestExample(BodyChecker checker, Expression value, Type tested) -> string {
    string spelled = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    if (checker.frame().statementsAllowed()) {
        return checker.names().quotedCode(["if ({spelled} is ", ")"], [tested]);
    }
    return checker.names().quotedCode(["{spelled} is ", " ? ... : ..."], [tested]);
}

// The sentences that follow the refusal of the member 'member' read through 'object', where 'object' has
// a type with the member where a loop starts, before a branch of a statement whose branches meet or where a
// test in a condition holds, but a write in the loop, the branch or the condition after the test leaves a
// wider proof of it, or none, with that write as a note. Inside the loop that holds on a later pass, and
// after the statement, in a 'for' update or after the condition it holds here. Null anywhere else.
public widenedReadHint(BodyChecker checker, Expression object, string member) -> string? {
    let path = buildNarrowingPath(checker, object);
    if (path == null) {
        return null;
    }
    let widening = checker.narrowing().writeOf(path) ?? checker.narrowing().endOf(path);
    if (widening == null) {
        return null;
    }
    let narrower = widening.narrower();
    let loop = widening.loop();
    bool inLoop = loop != null && within(object.span(), loop);
    if (narrower == null || (!inLoop && !widening.inJoin() && !widening.afterTestInCondition())
            || memberaccess.lookupMember(checker, narrower, member) is MissingMember) {
        return null;
    }
    string place = wording.oneLineSpelling(syntax.unwrapParentheses(object));
    Type tested = convert.coreOf(narrower);
    string wider = checker.names().quoted(convert.coreOf(checker.recordedType(object)));
    string stored = storedClause(checker, widening, place);
    string example = typeTestExample(checker, object, tested);
    string note = diagnostics.carriedNote(widening.at(), "'{widening.place()}' is assigned here");
    if (widening.afterTestInCondition()) {
        string reason = "'{widening.place()}' is assigned{stored} in the condition after the test, so "
            + "'{place}' may be any {wider} here.{note}";
        if (within(widening.at(), nullguidance.enclosingStatement(object).span())) {
            return "{reason}{conditionRetest(checker, object, widening.at(), place, tested)}";
        }
        return "{reason} Test '{place}' again after the assignment, as in {example}.";
    }
    if (inLoop) {
        string held = "{typenames.typeArticle(checker.names().of(tested))} {checker.names().quoted(tested)}";
        string assigned = widening.place() != place ? "'{widening.place()}'" : "it{stored}";
        string outcome = widening.place() != place ? "'{place}' may be" : "it may be";
        return "'{place}' is {held} when the loop starts, but the loop assigns {assigned}, so {outcome} any "
            + "{wider} on a later pass.{note} Test '{place}' inside the loop, as in {example}.";
    }
    string reason = "'{widening.place()}' is assigned{stored} {widening.joinedIn()}, so '{place}' may be any "
        + "{wider} here.{note}";
    let update = enclosingUpdate(object, widening.at());
    if (update != null) {
        return "{reason} {updateTestAdvice(checker, object, member, update, tested)}";
    }
    return "{reason} Test '{place}' after the {widening.joinedStatement()}, as in {example}.";
}

// The type the write 'end' stores, as in " a 'Square'", where it writes the place spelled 'place' and the
// type is known, or empty.
storedClause(BodyChecker checker, NarrowingEnd end, string place) -> string {
    let stored = end.stored();
    if (end.place() != place || stored == null || stored is ErrorType) {
        return "";
    }
    Type core = convert.coreOf(stored);
    return " {typenames.typeArticle(checker.names().of(core))} {checker.names().quoted(core)}";
}

// The update of the 'for' loop whose update reads 'read' and whose body makes the write at 'write', or
// null where no such loop holds the read.
enclosingUpdate(Expression read, Span write) -> Expression? {
    SyntaxNode? holder = read.parent();
    while (holder != null && !(holder is Statement)) {
        holder = holder.parent();
    }
    if (!(holder is ForStatementNode)) {
        return null;
    }
    let update = holder.update();
    if (update == null || !within(read.span(), update.span()) || !within(write, holder.body().span())) {
        return null;
    }
    return update;
}

// The advice to test 'object' for the class 'tested' in the 'for' update 'update', which reads the member
// 'member' through it: the update written to read the member only where the test holds, with a placeholder
// value where it does not, or where that is too long to quote, the read to replace and what replaces it.
// The test alone is named where no placeholder has the type the read gives.
updateTestAdvice(BodyChecker checker, Expression object, string member, Expression update, Type tested)
                 -> string {
    string place = wording.oneLineSpelling(syntax.unwrapParentheses(object));
    let read = memberRead(object);
    let placeholder = read == null ? null : readPlaceholder(checker, read, member, tested);
    if (read != null && placeholder != null) {
        string readText = wording.oneLineSpelling(read);
        string written = wording.oneLineSpelling(update);
        string before = "({place} is ";
        string after = " ? {readText} : {placeholder})";
        long at = written.indexOf(readText);
        bool once = at >= 0 && written.indexOf(readText, at + 1) < 0;
        long length = checker.names().of(tested).length;
        if (once && written.length - readText.length + before.length + length + after.length
                <= wording.quotedCodeLimit()) {
            string guarded = checker.names().quotedCode(["{written.substring(0, at)}{before}",
                "{after}{written.substring(at + readText.length)}"], [tested]);
            return "Test '{place}' in the update, as in {guarded}.";
        }
        if (before.length + length + after.length <= wording.quotedCodeLimit()) {
            string each = once || at < 0 ? "" : "each ";
            return "Test '{place}' in the update by replacing {each}'{readText}' with "
                + "{checker.names().quotedCode([before, after], [tested])}.";
        }
    }
    return "Test '{place}' with {checker.names().quotedCode(["{place} is ", ""], [tested])} in the update.";
}

// The read of a member through 'object': the member read, or the call of it where the member is a method
// called there. Null where 'object' is not read through.
memberRead(Expression object) -> Expression? {
    SyntaxNode? read = object.parent();
    while (read is ParenthesizedExpressionNode) {
        read = read.parent();
    }
    if (!(read is MemberExpressionNode)) {
        return null;
    }
    let call = read.parent();
    if (call is CallExpressionNode && call.callee().green() == read.green()) {
        return call;
    }
    return read;
}

// A value of the type the read 'read' of the member 'member' of a 'tested' gives, to write where the read
// cannot be made: of the field's type, or of the type every method of that name returns. Null where no
// such value can be written.
readPlaceholder(BodyChecker checker, Expression read, string member, Type tested) -> string? {
    if (!(read is CallExpressionNode)) {
        let field = typemembers.inheritedOrOwnField(tested, member);
        return field == null ? null : wording.placeholderLiteral(field.type());
    }
    Type? returned = null;
    for (let method in memberaccess.methodsRead(checker, tested, member)) {
        Type type = method.signature().returnType();
        if (returned != null && returned != type) {
            return null;
        }
        returned = type;
    }
    return returned == null ? null : wording.placeholderLiteral(returned);
}

// Recognizes '(x as? T) != null' and '(x as? T) == null' over a narrowable 'x' and a class or
// interface 'T'. The comparison narrows nothing; the fact it gives records the 'is' test that would,
// written into the condition at 'site'.
detectCastComparison(BodyChecker checker, Expression condition, ConditionSite? site) -> NarrowingFact? {
    if (!(condition is BinaryExpressionNode)) {
        return null;
    }
    SyntaxKind operator = condition.operator().kind();
    if (operator != SyntaxKind.EqualsEquals && operator != SyntaxKind.NotEquals) {
        return null;
    }
    Expression compared = condition.left();
    if (wording.isNullLiteral(syntax.unwrapParentheses(condition.left()))) {
        compared = condition.right();
    } else if (!wording.isNullLiteral(syntax.unwrapParentheses(condition.right()))) {
        return null;
    }
    Expression cast = syntax.unwrapParentheses(compared);
    if (!(cast is CheckedCastExpressionNode)) {
        return null;
    }
    let castType = checker.result().typeOf(cast.green());
    if (!(castType is OptionalType) || !types.isClassLike(castType.inner())) {
        return null;
    }
    let path = buildNarrowingPath(checker, cast.value());
    if (path == null) {
        return null;
    }
    string tested = "{wording.oneLineSpelling(syntax.unwrapParentheses(cast.value()))} is "
        + wording.greenSpelling(cast.target().green());
    bool narrowsWhenTrue = operator == SyntaxKind.NotEquals;
    string replacement = narrowsWhenTrue ? tested : "!({tested})";
    string? rewritten = site == null ? null : site.rewritten(condition, replacement);
    let fact = new NarrowingFact(castHintPath(path), castType.inner(), narrowsWhenTrue);
    if (rewritten != null) {
        fact.castHint = "Write '{rewritten}' to narrow it.";
    } else {
        fact.castHint = "Replace {wording.sideNamed(condition, "the comparison")} with '{replacement}' "
            + "to narrow it.";
    }
    return fact;
}

// The refusal of the member 'member' read through 'object', a value of type 'core' that has no such
// member, where a comparison of an 'as?' cast with null would have narrowed 'object' to a type that
// has it. Null anywhere else.
public castComparisonHint(BodyChecker checker, Expression object, Type core, string member) -> string? {
    let path = buildNarrowingPath(checker, object);
    if (path == null) {
        return null;
    }
    let hinted = castHintPath(path);
    let proven = checker.narrowing().provenType(hinted);
    let fix = checker.castHintAt(hinted);
    if (proven == null || fix == null
            || memberaccess.lookupMember(checker, proven, member) is MissingMember) {
        return null;
    }
    string spelled = wording.oneLineSpelling(syntax.unwrapParentheses(object));
    return "'{spelled}' is still {typenames.typeArticle(checker.names().of(core))} "
        + "{checker.names().quoted(core)} here, because comparing an 'as?' cast with null does not "
        + "narrow '{spelled}'. {fix}";
}

// Narrows 'scrutinee' to 'armType' inside a type arm that binds no name, where the switched value
// is a place that narrows.
public narrowArmValue(BodyChecker checker, Expression scrutinee, Type armType) {
    let path = buildNarrowingPath(checker, scrutinee);
    if (path != null) {
        checker.narrowing().narrow(path, armType);
    }
}

// What holds where a branch ends: the narrowings proven there, the writes that left those a write left,
// and the writes there that ended the narrowings made before it.
public final class BranchNarrowings {
    protected Map<NarrowingPath, Type> proofs;
    protected Map<NarrowingPath, NarrowingEnd> writes;
    protected Map<NarrowingPath, NarrowingEnd> ends;

    public constructor(this.proofs, this.writes, this.ends);
}

// What holds where the branch being checked ends.
public branchNarrowings(BodyChecker checker) -> BranchNarrowings {
    return new BranchNarrowings(checker.narrowing().flatten(), checker.narrowing().writes(),
        checker.narrowing().ends());
}

// What holds where nothing is proven, written or ended.
emptyNarrowings() -> BranchNarrowings {
    return new BranchNarrowings(new Map<NarrowingPath, Type>(), new Map<NarrowingPath, NarrowingEnd>(),
        new Map<NarrowingPath, NarrowingEnd>());
}

// What holds where a branch of an 'if' statement or a '?:' ends, for the places 'places' the branch changed
// since the branches started, which hold what they held there in a branch that did not change them.
public final class BranchChanges {
    protected Set<NarrowingPath> places;
    protected BranchNarrowings held;

    protected constructor(this.places, this.held);
}

// What holds where the branch being checked ends, for the places it changed since the branches of the
// innermost statement being analyzed started.
public branchChanges(BodyChecker checker) -> BranchChanges {
    let places = checker.narrowing().changedPlaces();
    let held = emptyNarrowings();
    for (let path in places) {
        copyPlace(checker, path, held);
    }
    return new BranchChanges(places, held);
}

// Copies into 'into' what holds here for the place 'path': its proof, the write that left it and the write
// that ended the last proof.
copyPlace(BodyChecker checker, NarrowingPath path, BranchNarrowings into) {
    let proven = checker.narrowing().provenType(path);
    if (proven != null) {
        into.proofs.set(path, proven);
    }
    let write = checker.narrowing().writeOf(path);
    if (write != null) {
        into.writes.set(path, write);
    }
    let ended = checker.narrowing().endOf(path);
    if (ended != null) {
        into.ends.set(path, ended);
    }
}

// Walks a branch under the facts its condition proves and returns what holds at its end,
// captured before the branch scope is discarded.
public walkBranchCapture(BodyChecker checker, BlockNode block, List<NarrowingFact> facts) -> BranchChanges {
    checker.enterScope();
    applyFacts(checker, facts);
    checker.walkBlock(block);
    let captured = branchChanges(checker);
    checker.leaveScope();
    return captured;
}

// What holds on the implicit path where a condition failed and no statements run: the else side
// of an 'if' without an 'else'.
public captureConditionBranch(BodyChecker checker, List<NarrowingFact> facts) -> BranchChanges {
    checker.enterScope();
    applyFacts(checker, facts);
    let captured = branchChanges(checker);
    checker.leaveScope();
    return captured;
}

// Ends the branches of the innermost statement being analyzed, written at 'at', and installs what holds
// after it, as applyNarrowingJoin does, where 'survivors' are the ends of those of its branches that fall
// through. A place a branch did not change holds at its end what it held where the branches started.
public joinBranchChanges(BodyChecker checker, List<BranchChanges> survivors, Span at, string statement,
                         string branch) {
    checker.narrowing().endBranches();
    let places = new Set<NarrowingPath>();
    for (let survivor in survivors) {
        for (let path in survivor.places) {
            places.add(path);
        }
    }
    let entry = emptyNarrowings();
    let held = new List<BranchNarrowings>();
    for (let path in places) {
        copyPlace(checker, path, entry);
        for (let survivor in survivors) {
            if (!survivor.places.contains(path)) {
                copyPlace(checker, path, survivor.held);
            }
        }
    }
    for (let survivor in survivors) {
        held.push(survivor.held);
    }
    applyNarrowingJoin(checker, entry, held, at, statement, branch);
    if (survivors.length() == 1) {
        keepEnds(checker, entry, held.get(0));
    }
}

// Records what ended each place that 'only', the one branch that falls through, ends and that held no proof
// where the branches start, since a read after them comes after that end.
keepEnds(BodyChecker checker, BranchNarrowings entry, BranchNarrowings only) {
    for (let path in only.ends.keys()) {
        let ended = only.ends.get(path);
        if (ended != null && entry.proofs.get(path) == null && pathRootInScope(checker, path)) {
            checker.narrowing().endProof(path, ended);
        }
    }
}

// Adds to 'proofs' the type that the start of a loop around 'at' ended for each place 'reached' holds.
addFirstPassProofs(Map<NarrowingPath, Type> proofs, BranchNarrowings reached, Span at) {
    for (let path in reached.writes.keys()) {
        let first = firstPassProof(reached.writes.get(path), at);
        if (first != null) {
            proofs.set(path, first);
        }
    }
    for (let path in reached.ends.keys()) {
        let first = firstPassProof(reached.ends.get(path), at);
        if (first != null && reached.proofs.get(path) == null) {
            proofs.set(path, first);
        }
    }
}

// The type 'end' ended where the start of a loop around 'at' recorded it, or null where no such start did.
firstPassProof(NarrowingEnd? end, Span at) -> Type? {
    let loop = end?.loop();
    if (end == null || loop == null || !within(at, loop)) {
        return null;
    }
    return end.narrower();
}

// The narrowest type that holds both 'left' and 'right', two proofs for 'path': the wider of the two
// where one holds the other, and otherwise the nearest class both extend, or else the declared type of
// the path, at the levels of null either may have. Null where that is the declared type itself.
joinedProof(BodyChecker checker, NarrowingPath path, Type left, Type right) -> Type? {
    if (left == right || convert.isAssignableStrict(left, right)) {
        return left;
    }
    if (convert.isAssignableStrict(right, left)) {
        return right;
    }
    let declared = declaredPathType(path);
    if (declared == null) {
        return null;
    }
    Type present = declared;
    while (present is OptionalType && convert.isAssignableStrict(present.inner(), left)
            && convert.isAssignableStrict(present.inner(), right)) {
        present = present.inner();
    }
    let shared = convert.nearestCommonBase(convert.coreOf(left), convert.coreOf(right));
    if (shared != null) {
        Type candidate = withLevels(checker, shared, wording.optionalLevels(present));
        if (convert.isAssignableStrict(present, candidate) && convert.isAssignableStrict(candidate, left)
                && convert.isAssignableStrict(candidate, right)) {
            return candidate;
        }
    }
    return present == declared ? null : present;
}

// The declared type of the place 'path' names, or null where a hop along it reads no field.
declaredPathType(NarrowingPath path) -> Type? {
    Type held = path.rootType();
    for (let name in path.fieldNames()) {
        let read = typemembers.inheritedOrOwnField(convert.coreOf(held), name);
        if (read == null) {
            return null;
        }
        held = read.type();
    }
    return held;
}

// 'core' inside 'levels' levels of null.
withLevels(BodyChecker checker, Type core, long levels) -> Type {
    Type wrapped = core;
    for (long level = 0; level < levels; level++) {
        wrapped = checker.store().optionalOf(wrapped);
    }
    return wrapped;
}

// The intersection of the surviving branch end-states: a path keeps a proof only where every
// survivor proves it, unified to the type they share.
intersectNarrowings(BodyChecker checker, List<BranchNarrowings> survivors) -> Map<NarrowingPath, Type> {
    let result = new Map<NarrowingPath, Type>();
    let first = survivors.get(0).proofs;
    for (let key in first.keys()) {
        let value = first.get(key);
        if (value != null) {
            result.set(key, value);
        }
    }
    for (long i = 1; i < survivors.length(); i++) {
        let other = survivors.get(i).proofs;
        let merged = new Map<NarrowingPath, Type>();
        for (let key in result.keys()) {
            let mine = result.get(key);
            let theirs = other.get(key);
            if (mine != null && theirs != null) {
                let unified = joinedProof(checker, key, mine, theirs);
                if (unified != null) {
                    merged.set(key, unified);
                }
            }
        }
        result = merged;
    }
    return result;
}

// Whether a path's root is still nameable after the merge, so a proof on a binding local to
// one branch does not leak out when that branch is the only survivor. A type-level field is
// nameable everywhere, and a lambda names what it captures.
pathRootInScope(BodyChecker checker, NarrowingPath path) -> bool {
    let root = path.root();
    if (root == null) {
        return true;
    }
    if (checker.frame().thisBinding() != null && root == checker.frame().thisBinding()) {
        return true;
    }
    return checker.visibleBinding(root.name()) == root;
}

// Installs what holds where 'survivors', the branches that fall through of the statement written at 'at',
// meet, after they start from 'entry'. 'statement' and 'branch' name where a write that drops a proof is,
// as in "'if' statement" and "in one branch of the 'if' statement".
public applyNarrowingJoin(BodyChecker checker, BranchNarrowings entry, List<BranchNarrowings> survivors,
                          Span at, string statement, string branch) {
    let proven = new Map<NarrowingPath, Type>();
    addProofs(proven, entry.proofs);
    addFirstPassProofs(proven, entry, at);
    joinNarrowings(checker, proven, entry.proofs, survivors, at, statement, branch);
}

// Installs the intersection of the surviving branches as applyNarrowingJoin does, where 'proven' holds each
// proof a branch can drop, with the type it held, and 'held' holds here. For the branches of a statement
// those are the proofs that held where they start, and for the ways out of a loop also those made since.
// The branches meet after 'at'.
joinNarrowings(BodyChecker checker, Map<NarrowingPath, Type> proven, Map<NarrowingPath, Type> held,
               List<BranchNarrowings> survivors, Span at, string statement, string branch) {
    if (survivors.length() == 0) {
        return;
    }
    let joined = intersectNarrowings(checker, survivors);
    for (let key in proven.keys()) {
        let provenType = proven.get(key);
        if (provenType == null || joined.get(key) != null || !pathRootInScope(checker, key)) {
            continue;
        }
        let ended = droppedEnd(survivors, key, provenType, at);
        if (ended != null) {
            checker.narrowing().endProof(key, ended.throughJoin(statement, branch).narrowedFrom(provenType));
        } else {
            checker.narrowing().clearPath(key);
        }
    }
    for (let key in joined.keys()) {
        let joinedType = joined.get(key);
        let before = proven.get(key);
        bool kept = held.get(key) == joinedType;
        if (joinedType == null || (kept && (before == null || before == joinedType))
                || !pathRootInScope(checker, key)) {
            continue;
        }
        if (!kept) {
            checker.narrowing().clearPath(key);
            checker.narrowing().narrow(key, joinedType);
        }
        let write = joinedWrite(survivors, key, joinedType, before, at);
        if (write == null) {
            continue;
        }
        let joinedEnd = write.throughJoin(statement, branch);
        if (before != null && before != joinedType
                && convert.isAssignableStrict(joinedType, before)) {
            joinedEnd = joinedEnd.narrowedFrom(before);
        }
        checker.narrowing().noteWrite(key, joinedEnd);
    }
}

// The write that dropped the proof 'dropped' of 'path', which held before the branches end and holds where
// they meet no more: the write that ended it in the first branch that holds no proof of it, before one that
// the start of a loop around 'at' recorded, or else the write in the first branch that left a proof of a type
// 'dropped' does not hold. Null where no write did.
droppedEnd(List<BranchNarrowings> survivors, NarrowingPath path, Type dropped, Span at) -> NarrowingEnd? {
    NarrowingEnd? started = null;
    for (let survivor in survivors) {
        let ended = survivor.ends.get(path);
        if (ended == null || survivor.proofs.get(path) != null) {
            continue;
        }
        if (firstPassProof(ended, at) == null) {
            return ended;
        }
        started = started ?? ended;
    }
    if (started != null) {
        return started;
    }
    for (let survivor in survivors) {
        let proven = survivor.proofs.get(path);
        let write = survivor.writes.get(path);
        if (proven != null && write != null && !convert.isAssignableStrict(dropped, proven)) {
            return write;
        }
    }
    return null;
}

// The write that left the proof 'joined' of 'path' where branches meet, after the proof 'before' held: the
// first branch's write that left that proof itself, or else the first that left a proof wider than
// 'before' or not related to it, or else the first that left a proof at all, each before one that the start
// of a loop around 'at' recorded. Null where no write left one.
joinedWrite(List<BranchNarrowings> survivors, NarrowingPath path, Type joined, Type? before, Span at)
            -> NarrowingEnd? {
    NarrowingEnd? widening = null;
    NarrowingEnd? first = null;
    NarrowingEnd? started = null;
    for (let survivor in survivors) {
        let write = survivor.writes.get(path);
        let proven = survivor.proofs.get(path);
        if (write == null || proven == null) {
            continue;
        }
        if (firstPassProof(write, at) != null) {
            started = started ?? write;
            continue;
        }
        if (proven == joined) {
            return write;
        }
        if (before == null || !convert.isAssignableStrict(before, proven)) {
            widening = widening ?? write;
        }
        first = first ?? write;
    }
    return widening ?? first ?? started;
}

// The branches of a '?:' analyzed so far, each from what holds where they start: their values, and what
// holds at the end of each.
public final class TernaryBranches {
    protected Span at;
    protected List<Expression> values;
    protected List<BranchChanges> ends;

    protected constructor(this.at) {
        this.values = new List<Expression>();
        this.ends = new List<BranchChanges>();
    }
}

// Starts the branches of the '?:' 'ternary', whose condition has been analyzed, or returns null where it
// writes no local or parameter, so that each branch starts from what holds before it and leaves it as
// it is.
public enterBranches(BodyChecker checker, TernaryExpressionNode ternary) -> TernaryBranches? {
    if (writeNamesOf(checker, ternary).isEmpty()) {
        return null;
    }
    checker.narrowing().startBranches();
    return new TernaryBranches(ternary.span());
}

// Installs what holds after the '?:' whose branches are 'branches': where the branches that give a value
// meet, a narrowing holds where it holds at the end of both. Null 'branches' leave what holds as it is.
public joinBranches(BodyChecker checker, TernaryBranches? branches) {
    if (branches == null) {
        return;
    }
    let survivors = new List<BranchChanges>();
    for (long i = 0; i < branches.values.length(); i++) {
        if (!checker.neverReturns(branches.values.get(i))) {
            survivors.push(branches.ends.get(i));
        }
    }
    joinBranchChanges(checker, survivors, branches.at, "'?:'", "in one branch of the '?:'");
}

// Analyzes a '?:' branch under the facts the condition proves there. 'target' is the type the branch is
// checked against, set at 'origin', or null. A branch of 'branches' starts from what holds where they start,
// and what holds at its end is kept there.
public analyzeGuardedBranch(BodyChecker checker, Expression condition, Expression branch, bool conditionHolds,
                            Type? target, LiteralOrigin? origin = null, ConditionSite? site = null,
                            TernaryBranches? branches = null) -> Type {
    if (branches != null && !branches.values.isEmpty()) {
        checker.narrowing().restartBranches();
    }
    let facts = new List<NarrowingFact>();
    collectNarrowings(checker, condition, conditionHolds, facts, site);
    checker.narrowing().push();
    applyFacts(checker, facts);
    Type analyzed = checker.store().errorType();
    if (target != null) {
        analyzed = checker.analyzeExpressionAdapt(branch, target, origin);
    } else {
        analyzed = checker.analyzeExpression(branch);
    }
    if (branches != null) {
        branches.values.push(branch);
        branches.ends.push(branchChanges(checker));
    }
    checker.narrowing().pop();
    return analyzed;
}

// Analyzes the right operand of the '&&' or '||' 'node' under what the left one proves where it evaluates
// to 'runsWhen'. After 'node', what the right operand leaves joins what held where it did not run.
public analyzeRightOperand(BodyChecker checker, BinaryExpressionNode node, bool runsWhen) -> Type {
    let facts = new List<NarrowingFact>();
    collectNarrowings(checker, node.left(), runsWhen, facts, new ConditionSite("", node, ""));
    let state = checker.narrowing();
    bool writes = !writeNamesOf(checker, node).isEmpty();
    if (writes) {
        state.startBranches();
    }
    state.push();
    applyFacts(checker, facts);
    Type analyzed = checker.analyzeExpression(node.right());
    if (!writes) {
        state.pop();
        return analyzed;
    }
    let ran = branchChanges(checker);
    checker.noteRightOperand(node, factsAfterWrites(ran, node.right()));
    state.pop();
    if (!state.changedOutside()) {
        state.endBranches();
        return analyzed;
    }
    let survivors = new List<BranchChanges>();
    survivors.push(ran);
    survivors.push(new BranchChanges(new Set<NarrowingPath>(), emptyNarrowings()));
    string operator = "'{node.operator().text()}'";
    joinBranchChanges(checker, survivors, node.span(), operator, "on the right of {operator}");
    return analyzed;
}

// The declared type of the storage an expression reads, or null when it reads no single
// declared slot: the binding's, 'this's, field's, or array element's own type.
public declaredSlotType(BodyChecker checker, Expression expression) -> Type? {
    Expression core = syntax.unwrapParentheses(expression);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            let binding = checker.result().bindingOf(identifier.green());
            if (binding == null) {
                return null;
            }
            return binding.type();
        },
        is ThisExpressionNode ignored -> {
            return checker.frame().thisType();
        },
        is MemberExpressionNode member -> {
            let typeLevel = checker.result().staticConstFieldOf(member.green());
            if (typeLevel != null) {
                return typeLevel.type();
            }
            let objectType = checker.result().typeOf(member.object().green());
            if (objectType == null) {
                return null;
            }
            let field = typemembers.inheritedOrOwnField(objectType, member.member().text());
            if (field == null) {
                return null;
            }
            return field.type();
        },
        is SubscriptExpressionNode subscript -> {
            let objectType = checker.result().typeOf(subscript.object().green());
            if (objectType is ArrayType) {
                return objectType.element();
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

// A presence operator ('== null', '!= null', '??', '?.', '?[') consults the declared storage
// type, so a re-check of a proven-non-null declared-optional stays legal. The operand is
// retyped back to the declared type, and a declared non-optional keeps its analyzed type and
// is rejected by the operator's own rule. A value still nullable after narrowing needs nothing
// restored, since the operator tests the level it has now.
public presenceOperandType(BodyChecker checker, Expression operand, Type analyzed) -> Type {
    if (analyzed is OptionalType) {
        return analyzed;
    }
    let declared = declaredSlotType(checker, operand);
    if (declared == null || !(declared is OptionalType) || declared == analyzed) {
        return analyzed;
    }
    retypeOperand(checker, operand, declared);
    return declared;
}

// The operand of '?.' tests the declared levels of null like any presence operator, and keeps what a
// type test proved under them, since '?.' reads a member of the value: where 'shape is Circle'
// holds, the 'Shape?' named 'shape' is a 'Circle?' before '?.'.
public safeAccessOperandType(BodyChecker checker, Expression operand, Type analyzed) -> Type {
    Type presence = presenceOperandType(checker, operand, analyzed);
    if (presence == analyzed) {
        return analyzed;
    }
    Type kept = analyzed;
    for (long level = 0; level < wording.optionalLevels(presence); level++) {
        kept = checker.store().optionalOf(kept);
    }
    if (kept != presence) {
        retypeOperand(checker, operand, kept);
    }
    return kept;
}

retypeOperand(BodyChecker checker, Expression operand, Type type) {
    Expression current = operand;
    checker.result().setType(current.green(), type);
    while (current is ParenthesizedExpressionNode) {
        current = current.inner();
        checker.result().setType(current.green(), type);
    }
}

// What a write that stores a 'stored' into storage of type 'declared' proves for that storage, or null
// where it proves nothing narrower than 'declared'. With 'typed', as for a local or a parameter an
// assignment writes, the storage holds the type of the stored value, and otherwise only the levels of
// null that value proves present.
provenByStore(BodyChecker checker, Type declared, Type stored, bool typed) -> Type? {
    Type proven = declared;
    if (typed) {
        proven = heldAfterStore(checker, declared, stored);
    } else if (!(stored is ErrorType) && !(stored is NullType)) {
        proven = presentLevels(declared, stored);
    }
    return proven == declared ? null : proven;
}

// The type storage of type 'declared' holds after a write stores a 'stored' into it: 'declared' without the
// levels of null the stored value proves present, holding the class or interface of the stored value where
// that is narrower. A bare value proves every level, and a 'T?' stored into a 'T??' proves the outer one.
public heldAfterStore(BodyChecker checker, Type declared, Type stored) -> Type {
    if (stored is ErrorType || stored is NullType) {
        return declared;
    }
    Type held = presentLevels(declared, stored);
    Type storedCore = convert.coreOf(stored);
    Type heldCore = convert.coreOf(held);
    if (storedCore == heldCore || !types.isClassLike(storedCore) || !types.isClassLike(heldCore)
            || !hierarchy.isSubclassOrConforms(storedCore, heldCore)) {
        return held;
    }
    return withLevels(checker, storedCore, wording.optionalLevels(held));
}

// 'declared' without the levels of null that a stored 'stored' proves present.
presentLevels(Type declared, Type stored) -> Type {
    Type held = declared;
    while (held is OptionalType && convert.isAssignableStrict(held.inner(), stored)) {
        held = held.inner();
    }
    return held;
}

// Narrows a binding to what its initializer proves, for a declaration, whose name is bound here rather
// than written as an expression. The binding keeps the type it is declared with, and drops the levels of
// null the initializer proves present.
public establishAssignmentNarrowing(BodyChecker checker, LocalBinding binding, Type value) {
    let proven = provenByStore(checker, binding.type(), value, false);
    if (proven == null) {
        return;
    }
    checker.narrowing().narrow(narrow.bindingPath(binding), proven);
}

// The write at 'at' that stores a 'stored' into 'target': it drops the narrowings of the storage it
// replaces and is recorded as what ended them, it narrows the place to what the stored value proves,
// and a copy it makes among the loops being settled is kept. 'assignment' is the plain '=' that makes the
// write, if one does.
public recordWrite(BodyChecker checker, Expression target, Span at, Type stored,
                   AssignmentExpressionNode? assignment = null) {
    let end = new NarrowingEnd(NarrowingEndKind.Assigned, at, stored, "",
        wording.oneLineSpelling(syntax.unwrapParentheses(target)), null);
    invalidateForWrite(checker, target, end);
    establishWriteNarrowing(checker, target, stored, end);
    renewEndsForWrite(checker, target, end);
    let root = writtenRoot(checker, target);
    touchLoopRoot(checker, root, loopCopy(checker, target, assignment, stored, end));
}

// 'out' lets the function 'callee' write the caller's variable directly, so the argument at 'at'
// drops even the binding's own narrowing.
public recordOutWrite(BodyChecker checker, LocalBinding binding, Span at, string callee) {
    let end = new NarrowingEnd(NarrowingEndKind.PassedOut, at, null, callee, binding.name(), null);
    checker.narrowing().clearForRoot(binding, end);
    checker.narrowing().renewForRoot(binding, end);
    touchLoopRoot(checker, binding, null);
}

// Narrows the place a write stored into, after invalidateForWrite has dropped what the place held before,
// with the write 'end' as what left the proof. Only a stable place has a path, so a write to any other
// place narrows nothing.
establishWriteNarrowing(BodyChecker checker, Expression target, Type stored, NarrowingEnd end) {
    let declared = declaredSlotType(checker, target);
    let path = buildNarrowingPath(checker, target);
    if (declared == null || path == null) {
        return;
    }
    let proven = provenByStore(checker, declared, stored, path.fieldNames().length == 0);
    if (proven == null) {
        return;
    }
    checker.narrowing().narrow(path, proven);
    checker.narrowing().noteWrite(path, end);
}

// A write drops the narrowings of the storage it replaces, and 'end' is recorded as what ended them.
// A binding write drops every path from that binding, and a member write drops every path that
// starts with the written one.
invalidateForWrite(BodyChecker checker, Expression target, NarrowingEnd end) {
    if (target is IdentifierExpressionNode) {
        let binding = checker.result().bindingOf(target.green());
        if (binding != null) {
            checker.narrowing().clearForRoot(binding, end);
            return;
        }
    }
    if (target is MemberExpressionNode) {
        let path = buildNarrowingPath(checker, target);
        if (path != null) {
            checker.narrowing().clearPrefixedBy(path, end);
        }
    }
}

// After a write to 'target', records 'end' as what ended each narrowing of the storage it replaces that
// holds no proof after it, where an earlier write ended that narrowing, so a read after it names it.
renewEndsForWrite(BodyChecker checker, Expression target, NarrowingEnd end) {
    if (target is IdentifierExpressionNode) {
        let binding = checker.result().bindingOf(target.green());
        if (binding != null) {
            checker.narrowing().renewForRoot(binding, end);
            return;
        }
    }
    if (target is MemberExpressionNode) {
        let path = buildNarrowingPath(checker, target);
        if (path != null) {
            checker.narrowing().renewPrefixedBy(path, end);
        }
    }
}

// What a pass over a loop follows, from what holds where the loop is entered and where it starts, to its back
// edges, for the locals and parameters the loop may write.
public final class LoopWatch {
    protected GreenNode loop;
    protected Span span;
    protected Map<NarrowingPath, Type> entry;
    protected Map<NarrowingPath, Type> starts;
    // The narrowings followed from where the loop starts, and from where it is entered for those it starts
    // weaker.
    protected NarrowingTrace trace;
    protected NarrowingTrace entryTrace;
    protected bool changed;
    protected Map<NarrowingPath, List<LoopCopy>> startReaders;
    // The lambdas the loop is in.
    protected long lambdaDepth;
    // Whether a loop around this one starts a place it may write weaker than its first pass does.
    protected bool outerWeakened;

    protected constructor(this.loop, this.span, this.entry, Map<NarrowingPath, Type> starts,
                          Map<NarrowingPath, Type> weakened, this.lambdaDepth) {
        this.starts = starts;
        this.trace = new NarrowingTrace(starts);
        this.entryTrace = new NarrowingTrace(weakened);
        this.changed = false;
        this.startReaders = new Map<NarrowingPath, List<LoopCopy>>();
        this.outerWeakened = false;
    }

    // Whether the loop can write a narrowing that holds where it is entered, or on the first pass of a loop
    // around it.
    protected watchesAny() -> bool {
        return !this.trace.held.isEmpty() || !this.entryTrace.held.isEmpty() || this.outerWeakened;
    }
}

// Narrowings on locals and parameters followed to the back edges of a pass: the type each holds over the
// back edges seen so far, the ones a back edge reaches without a proof, the write that first broke each,
// and the write that widened each to the type it holds, which a read that type has no member for can name.
final class NarrowingTrace {
    protected Map<NarrowingPath, Type> held;
    protected Map<NarrowingPath, NarrowingEnd> widened;
    protected Map<NarrowingPath, NarrowingEnd> broken;

    protected constructor(Map<NarrowingPath, Type> starts) {
        this.held = new Map<NarrowingPath, Type>();
        for (let path in starts.keys()) {
            let start = starts.get(path);
            if (start != null && path.root() != null) {
                this.held.set(path, start);
            }
        }
        this.widened = new Map<NarrowingPath, NarrowingEnd>();
        this.broken = new Map<NarrowingPath, NarrowingEnd>();
    }

    // Whether the narrowing of 'path' is followed and no back edge has broken it.
    protected holds(NarrowingPath path) -> bool {
        return this.held.get(path) != null && this.broken.get(path) == null;
    }

    // Widens each narrowing it follows to the proof 'reached' holds for it at a back edge where that proof
    // is wider, and marks it broken where 'reached' holds no proof of a related type, each with the write
    // that left that proof or ended it. A write the start of the loop written at 'loop' names is not one of
    // the pass, so what it explains changes nothing. Returns whether any changed.
    protected follow(BodyChecker checker, BranchNarrowings reached, Span loop) -> bool {
        bool changed = false;
        for (let path in this.held.keys()) {
            let held = this.held.get(path);
            if (held == null || this.broken.get(path) != null) {
                continue;
            }
            let proven = reached.proofs.get(path);
            Type? kept = null;
            if (proven != null) {
                kept = joinedProof(checker, path, held, proven);
            }
            if (kept == held) {
                continue;
            }
            let write = proven == null ? reached.ends.get(path) : reached.writes.get(path);
            if (write != null && write.loop() == loop) {
                continue;
            }
            changed = true;
            if (kept == null) {
                this.broken.set(path, write ?? new NarrowingEnd(NarrowingEndKind.Assigned, loop, null, "",
                    rootName(path), null));
                continue;
            }
            this.held.set(path, kept);
            if (write != null) {
                this.widened.set(path, write);
            } else {
                this.widened.remove(path);
            }
        }
        return changed;
    }
}

// What reaches the ends of one pass through the loop being walked. Where what holds after the loop can
// differ from where it starts, 'exits' gathers the ways out of the loop and its back edges, and is null
// anywhere else. A 'for' loop's update runs from what holds at the end of the body and at each 'continue',
// and 'updateReached' says a pass reaches it. What holds at a 'continue' is kept where 'keepsContinues'
// says an update or a back edge reads it.
public final class LoopFlow {
    protected LoopExits? exits;
    protected bool keepsContinues;
    protected List<BranchNarrowings>? continues;
    protected bool updateReached;

    protected constructor(this.exits, this.keepsContinues) {
        this.continues = null;
        this.updateReached = false;
    }
}

// The ways out of one pass through the loop 'watch' watches and its back edges: the names of the locals and
// parameters its condition writes, what holds where its condition is tested false, null where it never is, at
// each back edge to its start and at each 'break'.
final class LoopExits {
    protected LoopWatch watch;
    protected Set<string> conditionWrites;
    protected BranchNarrowings? exit;
    protected List<BranchNarrowings> backEdges;
    protected List<BranchNarrowings> breaks;

    protected constructor(this.watch, this.conditionWrites) {
        this.exit = null;
        this.backEdges = new List<BranchNarrowings>();
        this.breaks = new List<BranchNarrowings>();
    }
}

// The flow of the innermost loop being walked in the function or the lambda being checked, or null
// outside one.
currentFlow(BodyChecker checker) -> LoopFlow? {
    let flows = checker.loopFlows();
    if (flows.isEmpty() || checker.frame().loopDepth() == 0) {
        return null;
    }
    return flows.get(flows.length() - 1);
}

// Records what holds where the condition of the loop being walked is tested false, which leaves the loop,
// unless 'alwaysHolds' says it never is. A for-in loop has no condition, and it leaves where a pass starts.
public noteLoopCondition(BodyChecker checker, bool alwaysHolds) {
    let flows = checker.loopFlows();
    if (flows.isEmpty()) {
        return;
    }
    let exits = flows.get(flows.length() - 1).exits;
    if (exits != null && !alwaysHolds) {
        exits.exit = branchNarrowings(checker);
    }
}

// Records what holds at a 'continue', or with 'leaves' at a 'break', in the loop whose pass it ends. A
// path that has already ended reaches neither.
public noteLoopExit(BodyChecker checker, bool leaves) {
    let flow = currentFlow(checker);
    if (flow == null || checker.assignment().terminated()) {
        return;
    }
    let exits = flow.exits;
    if (leaves) {
        if (exits != null) {
            exits.breaks.push(branchNarrowings(checker));
        }
    } else if (flow.keepsContinues) {
        let continues = flow.continues ?? new List<BranchNarrowings>();
        continues.push(branchNarrowings(checker));
        flow.continues = continues;
    }
}

// Walks the body of a 'while' or a for-in loop under the facts its condition proves, and records what
// holds where the pass ends as its back edges.
public walkLoopBody(BodyChecker checker, BlockNode body, List<NarrowingFact> facts) {
    checker.enterScope();
    applyFacts(checker, facts);
    checker.walkBlock(body);
    endPass(checker);
    checker.leaveScope();
}

// Records what holds at the end of the body of the loop being walked and at each 'continue' as the back
// edges of the pass.
public endPass(BodyChecker checker) {
    let flow = currentFlow(checker);
    let exits = flow?.exits;
    if (flow != null && exits != null) {
        exits.backEdges = passEnds(checker, flow);
    }
}

// Joins what holds at the end of the body of the 'for' loop being walked and at each 'continue', which is
// where its update, written at 'update', runs from. Without a 'continue', what holds at the end of the body
// holds there.
public joinPassEnds(BodyChecker checker, Span update) {
    let flow = currentFlow(checker);
    if (flow == null) {
        return;
    }
    if (flow.continues == null) {
        flow.updateReached = !checker.assignment().terminated();
        return;
    }
    let ends = passEnds(checker, flow);
    flow.updateReached = !ends.isEmpty();
    let held = checker.narrowing().flatten();
    let proven = new Map<NarrowingPath, Type>();
    addProofs(proven, held);
    for (let reached in ends) {
        addFirstPassProofs(proven, reached, update);
    }
    joinNarrowings(checker, proven, held, ends, update, "'for' loop's body",
        "before 'continue', and the update runs after each 'continue'");
}

// Records what holds after the update of the 'for' loop being walked as the back edge of the pass, where
// a pass reaches the update and, as 'neverReturns' says, the update returns.
public endUpdate(BodyChecker checker, bool neverReturns) {
    let flow = currentFlow(checker);
    let exits = flow?.exits;
    if (flow != null && exits != null && flow.updateReached && !neverReturns) {
        exits.backEdges.push(branchNarrowings(checker));
    }
}

// What holds at the end of the body of the loop of 'flow', where a pass reaches it, and at each 'continue'.
passEnds(BodyChecker checker, LoopFlow flow) -> List<BranchNarrowings> {
    let ends = new List<BranchNarrowings>();
    if (!checker.assignment().terminated()) {
        ends.push(branchNarrowings(checker));
    }
    let continues = flow.continues;
    if (continues != null) {
        ends.pushAll(continues);
    }
    return ends;
}

// Walks one pass through 'loop' with 'walk' and returns what reached its ends, where 'watch' says what the
// pass watches. Where the loop can write no narrowing that holds where it is entered, and the condition
// writes nothing and can be false, what holds after the loop is what holds where it starts, so nothing is
// kept for a join, and what holds at a 'continue' is kept only for a 'for' update.
walkPass(BodyChecker checker, SyntaxNode loop, (BodyChecker) -> void walk, LoopWatch watch) -> LoopFlow {
    let condition = loopCondition(loop);
    let conditionWrites = condition == null ? null : conditionWriteNames(checker, loop, condition);
    bool writes = conditionWrites != null && !conditionWrites.isEmpty();
    LoopExits? exits = null;
    if (watch.watchesAny() || writes || !leavesAtCondition(loop, condition)) {
        exits = new LoopExits(watch, conditionWrites ?? new Set<string>());
    }
    bool updated = loop is ForStatementNode && loop.update() != null;
    let flow = new LoopFlow(exits, exits != null || updated);
    checker.loopFlows().push(flow);
    walk(checker);
    checker.loopFlows().pop();
    return flow;
}

// The condition of the 'while' or 'for' loop 'loop', or null where it has none.
loopCondition(SyntaxNode loop) -> Expression? {
    switch (loop) {
        is WhileStatementNode node -> {
            return node.condition();
        },
        is ForStatementNode node -> {
            return node.condition();
        },
        default -> {
            return null;
        },
    }
}

// Whether a pass through 'loop', whose condition is 'condition', can leave it where the condition is tested
// false, or for a for-in loop where the pass starts.
leavesAtCondition(SyntaxNode loop, Expression? condition) -> bool {
    return loop is ForEachStatementNode || !flow.loopConditionAlwaysHolds(condition);
}

// What holds where the condition of a loop is tested false after the back edge 'reached': what 'reached'
// holds, but for the places under the locals and parameters 'written' names, which the condition writes,
// what 'exit', where the condition was tested false on the pass, holds.
conditionRun(BranchNarrowings reached, BranchNarrowings exit, Set<string> written) -> BranchNarrowings {
    if (written.isEmpty()) {
        return reached;
    }
    let run = emptyNarrowings();
    copyPlaces(reached, written, false, run);
    copyPlaces(exit, written, true, run);
    return run;
}

// Copies into 'into' what 'from' holds for the places under the locals and parameters 'written' names, or
// with 'under' false for every other place.
copyPlaces(BranchNarrowings from, Set<string> written, bool under, BranchNarrowings into) {
    for (let path in from.proofs.keys()) {
        let proven = from.proofs.get(path);
        if (proven != null && written.contains(rootName(path)) == under) {
            into.proofs.set(path, proven);
        }
    }
    for (let path in from.writes.keys()) {
        let write = from.writes.get(path);
        if (write != null && written.contains(rootName(path)) == under) {
            into.writes.set(path, write);
        }
    }
    for (let path in from.ends.keys()) {
        let end = from.ends.get(path);
        if (end != null && written.contains(rootName(path)) == under) {
            into.ends.set(path, end);
        }
    }
}

// A plain '=' in a pass over the loops being settled that stores a local or a parameter into another
// one, where what the source holds is what a loop starts it with or what an earlier such copy stored.
// It is kept with the type it stores, the watches of the loops whose back edges the value it stores
// reaches with a narrowing of its target, and the copies that read what it stored, so the passes learn at
// once what a change to the source does along the copies. 'statement' is the statement it makes up the
// whole of, directly in a block.
final class LoopCopy {
    protected NarrowingPath target;
    protected Type declared;
    protected Type stored;
    protected NarrowingEnd end;
    protected long order;
    protected LoopWatch? startSource;
    protected NarrowingPath source;
    protected LoopCopy? copySource;
    protected List<LoopWatch> watches;
    protected List<LoopCopy> readers;
    protected SyntaxNode? statement;

    protected constructor(this.target, this.declared, this.stored, this.end, this.order, this.source) {
        this.startSource = null;
        this.copySource = null;
        this.watches = new List<LoopWatch>();
        this.readers = new List<LoopCopy>();
        this.statement = null;
    }
}

// What last changed the proofs of a local or a parameter in a pass over the loops being settled: the
// start of the loop of 'started', the copy 'copied', or, where both are null, any other write or a test.
final class LoopTouch {
    protected LoopWatch? started;
    protected LoopCopy? copied;
    protected long lambdaDepth;

    protected constructor(this.started, this.copied, this.lambdaDepth);
}

// A copy to bring up to date, as the pass 'pass' after the one made would store it.
final class CopyUpdate {
    protected long pass;
    protected LoopCopy copy;

    protected constructor(this.pass, this.copy);
}

// What the passes over one loop have learned about where it starts: the type each narrowing it watches
// keeps there and the ones it drops, with the write that first widens or breaks each. Each pass over an
// enclosing loop declares the locals inside that loop again, so a narrowing is found by where its path
// is declared, and what is learned is kept under the first path learned for that declaration.
final class LoopStart {
    protected Map<NarrowingPath, Type> kept;
    protected Map<NarrowingPath, NarrowingEnd> widened;
    protected Map<NarrowingPath, NarrowingEnd> dropped;
    // The first path learned for each declaration, by the name of the local or parameter it starts at.
    Map<string, List<NarrowingPath>> learnedPaths;

    protected constructor() {
        this.kept = new Map<NarrowingPath, Type>();
        this.widened = new Map<NarrowingPath, NarrowingEnd>();
        this.dropped = new Map<NarrowingPath, NarrowingEnd>();
        this.learnedPaths = new Map<string, List<NarrowingPath>>();
    }

    protected keptType(NarrowingPath path) -> Type? {
        let learned = this.learnedPath(path);
        return learned == null ? null : this.kept.get(learned);
    }

    protected wideningOf(NarrowingPath path) -> NarrowingEnd? {
        let learned = this.learnedPath(path);
        return learned == null ? null : this.widened.get(learned);
    }

    protected dropOf(NarrowingPath path) -> NarrowingEnd? {
        let learned = this.learnedPath(path);
        return learned == null ? null : this.dropped.get(learned);
    }

    protected keep(NarrowingPath path, Type type) {
        this.kept.set(this.learning(path), type);
    }

    protected widen(NarrowingPath path, NarrowingEnd end) {
        let learned = this.learning(path);
        if (this.widened.get(learned) == null) {
            this.widened.set(learned, end);
        }
    }

    protected drop(NarrowingPath path, NarrowingEnd end) {
        let learned = this.learning(path);
        this.kept.remove(learned);
        if (this.dropped.get(learned) == null) {
            this.dropped.set(learned, end);
        }
    }

    // Names 'end' as the write that widened the narrowing of 'path', where a widening is learned for it.
    protected nameWidening(NarrowingPath path, NarrowingEnd end) {
        let learned = this.learnedPath(path);
        if (learned != null && this.widened.get(learned) != null) {
            this.widened.set(learned, end);
        }
    }

    // Names 'end' as the write that broke the narrowing of 'path', where it is learned to be dropped.
    protected nameDrop(NarrowingPath path, NarrowingEnd end) {
        let learned = this.learnedPath(path);
        if (learned != null && this.dropped.get(learned) != null) {
            this.dropped.set(learned, end);
        }
    }

    // The path learned first for the declaration of 'path', or null where none is.
    learnedPath(NarrowingPath path) -> NarrowingPath? {
        let paths = this.learnedPaths.get(rootName(path));
        if (paths == null) {
            return null;
        }
        for (let learned in paths) {
            if (learned.sameDeclaration(path)) {
                return learned;
            }
        }
        return null;
    }

    // The path to learn something for the declaration of 'path' under: the one learned first, or 'path'.
    learning(NarrowingPath path) -> NarrowingPath {
        let learned = this.learnedPath(path);
        if (learned != null) {
            return learned;
        }
        string name = rootName(path);
        let paths = this.learnedPaths.get(name) ?? new List<NarrowingPath>();
        paths.push(path);
        this.learnedPaths.set(name, paths);
        return path;
    }
}

// The name of the local or parameter 'path' starts at, or empty where it starts at a field.
rootName(NarrowingPath path) -> string {
    let root = path.root();
    return root == null ? "" : root.name();
}

// What the passes over a loop and the loops inside it have learned about where each loop a pass reaches
// starts, which is final once 'settled', and what the pass being made has seen: what last changed the
// proofs of each local and parameter, and the copies, in the order it made them and by where each is
// written.
public final class LoopSettlement {
    protected Map<GreenNode, LoopStart> starts;
    protected bool changed;
    protected bool settled;
    protected Map<NarrowingPath, LoopTouch> touches;
    protected List<LoopCopy> copies;
    protected Map<long, LoopCopy> copiesAt;

    protected constructor() {
        this.starts = new Map<GreenNode, LoopStart>();
        this.changed = false;
        this.settled = false;
        this.touches = new Map<NarrowingPath, LoopTouch>();
        this.copies = new List<LoopCopy>();
        this.copiesAt = new Map<long, LoopCopy>();
    }
}

// The parts of the loop 'loop' that each pass through it runs: the condition, the body and a 'for'
// loop's update.
public loopParts(SyntaxNode loop) -> List<SyntaxNode> {
    let parts = new List<SyntaxNode>();
    switch (loop) {
        is WhileStatementNode node -> {
            parts.push(node.condition());
            parts.push(node.body());
        },
        is ForStatementNode node -> {
            let condition = node.condition();
            if (condition != null) {
                parts.push(condition);
            }
            parts.push(node.body());
            let update = node.update();
            if (update != null) {
                parts.push(update);
            }
        },
        is ForEachStatementNode node -> {
            parts.push(node.body());
        },
        default -> { },
    }
    return parts;
}

// Analyzes 'loop' with 'walk', starting it with the narrowings that every back edge to its start proves
// again, which trial passes find by following what reaches the back edges until a pass changes nothing.
// The loops inside it are settled by the same passes, so a pass analyzes each of them once. A loop those
// passes never reach, such as one in a lambda that a trial does not check, is settled on its own. Returns
// what reached the ends of the pass that analyzed it, which leaveLoop installs after the loop.
public settleLoop(BodyChecker checker, SyntaxNode loop, (BodyChecker) -> void walk) -> LoopFlow {
    let enclosing = checker.loopSettlement();
    if (enclosing != null && (!enclosing.settled || enclosing.starts.get(loop.green()) != null)) {
        return passLoop(checker, enclosing, loop, walk);
    }
    let settlement = new LoopSettlement();
    let unsettled = startLoop(checker, settlement, loop);
    if (unsettled.starts.isEmpty()) {
        return walkPass(checker, loop, walk, unsettled);
    }
    while (true) {
        settlement.changed = false;
        settlement.touches = new Map<NarrowingPath, LoopTouch>();
        settlement.copies = new List<LoopCopy>();
        settlement.copiesAt = new Map<long, LoopCopy>();
        let trial = checker.trial();
        trial.setLoopSettlement(settlement);
        passLoop(trial, settlement, loop, walk);
        checker.endTrial();
        if (!settlement.changed) {
            break;
        }
        followCopies(checker, settlement);
    }
    settlement.settled = true;
    checker.setLoopSettlement(settlement);
    let flow = passLoop(checker, settlement, loop, walk);
    checker.setLoopSettlement(enclosing);
    return flow;
}

// Installs what holds after 'loop', from 'flow', what reached the ends of the pass that analyzed it: what
// holds where its condition is tested false, at each 'break', and where each back edge leads, since the
// next pass can leave there, with a place the condition writes holding what the condition stores. A proof
// that held where the loop is entered or that its condition made is dropped where a way out does not keep
// it. A write in the loop that ended a proof is then recorded as one in the loop, for a read after it.
public leaveLoop(BodyChecker checker, SyntaxNode loop, LoopFlow flow) {
    string statement = loopStatement(loop);
    let exits = flow.exits;
    if (exits != null) {
        let leaving = new List<BranchNarrowings>();
        let held = checker.narrowing().flatten();
        let proven = new Map<NarrowingPath, Type>();
        let exit = exits.exit;
        if (exit != null) {
            leaving.push(exit);
            for (let reached in exits.backEdges) {
                leaving.push(conditionRun(reached, exit, exits.conditionWrites));
            }
            addProofs(proven, exit.proofs);
        }
        leaving.pushAll(exits.breaks);
        addProofs(proven, held);
        addProofs(proven, exits.watch.entry);
        for (let reached in leaving) {
            addFirstPassProofs(proven, reached, loop.span());
        }
        joinNarrowings(checker, proven, held, leaving, loop.span(), statement, "in the {statement}");
    }
    markLoopEnds(checker, loop);
}

// Adds to 'into' each proof 'added' holds, replacing the one 'into' holds for the same place.
addProofs(Map<NarrowingPath, Type> into, Map<NarrowingPath, Type> added) {
    for (let path in added.keys()) {
        let proof = added.get(path);
        if (proof != null) {
            into.set(path, proof);
        }
    }
}

// Records each write in the parts of 'loop' each pass runs that is what ended a proof where the loop
// ends as a write in the loop, which a read after the loop can be reached without.
markLoopEnds(BodyChecker checker, SyntaxNode loop) {
    string statement = loopStatement(loop);
    let parts = loopParts(loop);
    let ends = checker.narrowing().ends();
    for (let path in ends.keys()) {
        let end = ends.get(path);
        if (end == null) {
            continue;
        }
        for (let part in parts) {
            if (within(end.at(), part.span())) {
                checker.narrowing().endProof(path, end.throughJoin(statement, "in the {statement}"));
                break;
            }
        }
    }
}

// The kind of statement 'loop' is, as in "'while' loop".
loopStatement(SyntaxNode loop) -> string {
    return loop is WhileStatementNode ? "'while' loop" : "'for' loop";
}

// Whether 'inner' lies within 'outer'.
public within(Span inner, Span outer) -> bool {
    return inner.start >= outer.start && inner.end() <= outer.end();
}

// One pass over 'loop', which starts with what 'settlement' has learned for it, and returns what reached its
// ends. Until the passes are settled, what reaches the back edges of the pass is learned.
passLoop(BodyChecker checker, LoopSettlement settlement, SyntaxNode loop, (BodyChecker) -> void walk)
         -> LoopFlow {
    let watch = startLoop(checker, settlement, loop);
    if (settlement.settled) {
        return walkPass(checker, loop, walk, watch);
    }
    checker.loopWatches().push(watch);
    for (let path in watch.starts.keys()) {
        if (path.fieldNames().length == 0) {
            settlement.touches.set(path, new LoopTouch(watch, null, watch.lambdaDepth));
        }
    }
    let flow = walkPass(checker, loop, walk, watch);
    checker.loopWatches().pop();
    let exits = flow.exits;
    if (exits != null) {
        for (let reached in exits.backEdges) {
            noteCopiesReached(settlement, watch, reached);
            if (watch.trace.follow(checker, reached, watch.span)) {
                watch.changed = true;
            }
            watch.entryTrace.follow(checker, reached, watch.span);
        }
    }
    learnLoop(settlement, loop.green(), watch);
    return flow;
}

// Records for each copy whose write left a proof that the back edge 'reached' of the loop of 'watch'
// holds for a narrowing the watch still holds that the copy reaches that back edge, so a change to what
// the copy stores changes where the loop starts.
noteCopiesReached(LoopSettlement settlement, LoopWatch watch, BranchNarrowings reached) {
    for (let path in watch.starts.keys()) {
        let write = reached.writes.get(path);
        if (write == null || !watch.trace.holds(path)) {
            continue;
        }
        let copy = settlement.copiesAt.get(write.at().start);
        if (copy != null && copy.target == path && !copy.watches.contains(watch)) {
            copy.watches.push(watch);
        }
    }
}

// Starts 'loop' with what 'settlement' has learned for it, which widens or drops a narrowing it watches
// with the write that did as what ended it, recorded as a write in the loop for a read after the loop,
// and returns the watch for a pass over it.
startLoop(BodyChecker checker, LoopSettlement settlement, SyntaxNode loop) -> LoopWatch {
    let written = new Set<LocalBinding>();
    for (let name in loopWriteNames(checker, loop)) {
        addWrittenName(checker, name, written);
    }
    let learned = settlement.starts.get(loop.green());
    let held = new Map<NarrowingPath, Type>();
    let weakened = new Map<NarrowingPath, Type>();
    let entry = checker.narrowing().flatten();
    for (let path in entry.keys()) {
        let proven = entry.get(path);
        let root = path.root();
        if (proven == null || root == null || !written.contains(root)) {
            continue;
        }
        let broken = learned?.dropOf(path);
        if (broken != null) {
            checker.narrowing().endProof(path, broken.inLoop(loop.span()).narrowedFrom(proven));
            weakened.set(path, proven);
            continue;
        }
        Type? start = proven;
        let kept = learned?.keptType(path);
        if (kept != null) {
            start = joinedProof(checker, path, proven, kept);
        }
        let widening = learned?.wideningOf(path);
        if (start == null) {
            if (widening != null) {
                checker.narrowing().endProof(path, widening.inLoop(loop.span()).narrowedFrom(proven));
            } else {
                checker.narrowing().clearPath(path);
            }
            weakened.set(path, proven);
            continue;
        }
        if (start != proven) {
            checker.narrowing().clearPath(path);
            checker.narrowing().narrow(path, start);
            if (widening != null) {
                string statement = loopStatement(loop);
                checker.narrowing().noteWrite(path, widening.inLoop(loop.span()).narrowedFrom(proven)
                    .throughJoin(statement, "in the {statement}"));
            }
            weakened.set(path, proven);
        }
        held.set(path, start);
    }
    let watch = new LoopWatch(loop.green(), loop.span(), entry, held, weakened,
        checker.lambdaFrames().length());
    for (let root in written) {
        let path = narrow.bindingPath(root);
        if (entry.get(path) == null
                && firstPassProof(checker.narrowing().endOf(path), loop.span()) != null) {
            watch.outerWeakened = true;
            break;
        }
    }
    return watch;
}

// Records in 'settlement' that a pass reached the loop 'loop', and what 'watch' saw at its back edges: the
// type each narrowing it watches keeps with the write that first widened it, and the ones it drops with the
// write that first broke them. A narrowing the pass started weaker than the proof where the loop is entered
// is named as ended by the write of the pass that widened or broke it at a back edge, so the last pass, which
// starts the loop as it is analyzed, names those writes.
learnLoop(LoopSettlement settlement, GreenNode loop, LoopWatch watch) {
    let learned = settlement.starts.get(loop) ?? new LoopStart();
    settlement.starts.set(loop, learned);
    for (let path in watch.entryTrace.widened.keys()) {
        let end = watch.entryTrace.widened.get(path);
        if (end != null) {
            learned.nameWidening(path, end);
        }
    }
    for (let path in watch.entryTrace.broken.keys()) {
        let end = watch.entryTrace.broken.get(path);
        if (end != null) {
            learned.nameDrop(path, end);
        }
    }
    if (!watch.changed) {
        return;
    }
    settlement.changed = true;
    for (let path in watch.trace.held.keys()) {
        let type = watch.trace.held.get(path);
        let widening = watch.trace.widened.get(path);
        if (type != null) {
            learned.keep(path, type);
        }
        if (widening != null) {
            learned.widen(path, widening);
        }
    }
    for (let path in watch.trace.broken.keys()) {
        let end = watch.trace.broken.get(path);
        if (end != null) {
            learned.drop(path, end);
        }
    }
}

// Records in the pass being made over the loops being settled that 'copy', or with 'copy' null any other
// write or a test, last changed the proofs of the local or parameter 'root', null for a place under neither.
touchLoopRoot(BodyChecker checker, LocalBinding? root, LoopCopy? copy) {
    let settlement = checker.loopSettlement();
    if (root == null || settlement == null || checker.loopWatches().isEmpty()) {
        return;
    }
    long lambdaDepth = checker.lambdaFrames().length();
    settlement.touches.set(narrow.bindingPath(root), new LoopTouch(null, copy, lambdaDepth));
}

// Records that the pass being made over the loops being settled tests the place 'tested'.
public noteLoopTest(BodyChecker checker, Expression tested) {
    if (checker.loopWatches().isEmpty()) {
        return;
    }
    let path = buildNarrowingPath(checker, tested);
    if (path != null) {
        touchLoopRoot(checker, path.root(), null);
    }
}

// The copy the plain '=' 'assignment' makes, whose write is 'end' and stores a 'stored' into 'target',
// where it stores a local or a parameter into another one and the source holds what a loop being settled
// starts it with, or what an earlier copy stored that 'assignment' runs after on every path to it. Null
// for any other write, and outside the passes over the loops being settled. Every value the source can
// hold can be stored, so a later pass makes the same write.
loopCopy(BodyChecker checker, Expression target, AssignmentExpressionNode? assignment, Type stored,
         NarrowingEnd end) -> LoopCopy? {
    let settlement = checker.loopSettlement();
    if (assignment == null || settlement == null || checker.loopWatches().isEmpty()) {
        return null;
    }
    Expression written = syntax.unwrapParentheses(target);
    Expression value = syntax.unwrapParentheses(assignment.value());
    if (!(written is IdentifierExpressionNode) || !(value is IdentifierExpressionNode)) {
        return null;
    }
    let binding = checker.result().bindingOf(written.green());
    let read = checker.result().bindingOf(value.green());
    if (binding == null || read == null || binding == read
            || !convert.isAssignableStrict(binding.type(), read.type())) {
        return null;
    }
    let source = narrow.bindingPath(read);
    let proven = checker.narrowing().provenType(source);
    let touch = settlement.touches.get(source);
    long lambdaDepth = checker.lambdaFrames().length();
    if (proven == null || proven != stored || touch == null || touch.lambdaDepth != lambdaDepth) {
        return null;
    }
    let copy = new LoopCopy(narrow.bindingPath(binding), binding.type(), stored, end,
        settlement.copies.length(), source);
    let started = touch.started;
    let copied = touch.copied;
    if (started != null && checker.loopWatches().contains(started) && started.starts.get(source) == proven) {
        copy.startSource = started;
        let readers = started.startReaders.get(source) ?? new List<LoopCopy>();
        readers.push(copy);
        started.startReaders.set(source, readers);
    } else if (copied != null && runsAfter(assignment, copied) && copyRead(checker, copied) == proven) {
        copy.copySource = copied;
        copied.readers.push(copy);
    } else {
        return null;
    }
    let statement = assignment.parent();
    let statements = statement?.parent();
    if (statement is ExpressionStatementNode && statements is ListNode && statements.parent() is BlockNode) {
        copy.statement = statement;
    }
    settlement.copies.push(copy);
    settlement.copiesAt.set(end.at().start, copy);
    return copy;
}

// Whether 'assignment' runs after the copy 'copied' on every path to it in a pass: 'copied' makes up a
// statement of a block, and 'assignment' is in a later statement of that block.
runsAfter(AssignmentExpressionNode assignment, LoopCopy copied) -> bool {
    let statement = copied.statement;
    if (statement == null) {
        return false;
    }
    let statements = statement.parent();
    return statements != null && within(assignment.span(), statements.span())
        && assignment.span().start >= statement.span().end();
}

// What a read of the target of 'copy' after it gets.
copyRead(BodyChecker checker, LoopCopy copy) -> Type {
    return heldAfterStore(checker, copy.declared, copy.stored);
}

// Learns at once what the next passes over the loops being settled would learn from the copies the pass
// made. Where what a copy reads changes, it stores the new value, and each loop that watches its target
// learns what that does. The copies that read what it stored follow on the same pass, and those that read
// where such a loop starts follow on the next one, in the order a pass makes them.
followCopies(BodyChecker checker, LoopSettlement settlement) {
    let updates = new PriorityQueue<CopyUpdate>((first, second) -> updateOrder(first, second));
    for (let copy in settlement.copies) {
        if (copy.startSource != null) {
            updates.push(new CopyUpdate(1, copy));
        }
    }
    while (!updates.isEmpty()) {
        let update = updates.pop();
        let copy = update.copy;
        Type read = sourceRead(checker, settlement, copy);
        if (read == copy.stored) {
            continue;
        }
        copy.stored = read;
        let end = new NarrowingEnd(NarrowingEndKind.Assigned, copy.end.at(), read, "", copy.end.place(),
            null);
        for (let watch in copy.watches) {
            if (!learnCopy(checker, settlement, watch, copy, end)) {
                continue;
            }
            let readers = watch.startReaders.get(copy.target);
            if (readers != null) {
                for (let reader in readers) {
                    updates.push(new CopyUpdate(update.pass + 1, reader));
                }
            }
        }
        for (let reader in copy.readers) {
            updates.push(new CopyUpdate(update.pass, reader));
        }
    }
}

// Whether 'first' comes before 'second': by pass, then in the order a pass makes the copies.
updateOrder(CopyUpdate first, CopyUpdate second) -> int {
    if (first.pass != second.pass) {
        return first.pass < second.pass ? -1 : 1;
    }
    if (first.copy.order != second.copy.order) {
        return first.copy.order < second.copy.order ? -1 : 1;
    }
    return 0;
}

// What the copy 'copy' reads from its source on the pass the updates have reached.
sourceRead(BodyChecker checker, LoopSettlement settlement, LoopCopy copy) -> Type {
    let started = copy.startSource;
    if (started != null) {
        return startOf(checker, settlement, started, copy.source) ?? copy.source.rootType();
    }
    let copied = copy.copySource;
    if (copied != null) {
        return copyRead(checker, copied);
    }
    return copy.stored;
}

// The type the next pass starts the loop of 'watch' with for 'path', from what the passes have learned
// so far and what this pass started it with, or null where it starts with no proof of 'path'.
startOf(BodyChecker checker, LoopSettlement settlement, LoopWatch watch, NarrowingPath path) -> Type? {
    let start = watch.starts.get(path);
    let learned = settlement.starts.get(watch.loop);
    if (start == null || learned == null) {
        return start;
    }
    if (learned.dropOf(path) != null) {
        return null;
    }
    let kept = learned.keptType(path);
    if (kept == null) {
        return start;
    }
    return joinedProof(checker, path, start, kept);
}

// Learns for the loop of 'watch' what the copy 'copy', now the write 'end', does to the narrowing of its
// target there, and returns whether the type the loop starts with for it changes.
learnCopy(BodyChecker checker, LoopSettlement settlement, LoopWatch watch, LoopCopy copy,
          NarrowingEnd end) -> bool {
    let held = startOf(checker, settlement, watch, copy.target);
    let learned = settlement.starts.get(watch.loop);
    if (held == null || learned == null) {
        return false;
    }
    let proven = provenByStore(checker, copy.declared, copy.stored, true);
    Type? kept = null;
    if (proven != null) {
        kept = joinedProof(checker, copy.target, held, proven);
    }
    if (kept == null) {
        learned.drop(copy.target, end);
        return true;
    }
    if (kept == held) {
        return false;
    }
    learned.keep(copy.target, kept);
    learned.widen(copy.target, end);
    return true;
}

// The local or parameter a write to 'target' stores into or under, or null where it has none.
public writtenRoot(BodyChecker checker, Expression target) -> LocalBinding? {
    if (target is IdentifierExpressionNode) {
        return checker.result().bindingOf(target.green());
    }
    if (target is MemberExpressionNode) {
        let path = buildNarrowingPath(checker, target);
        if (path != null) {
            return path.root();
        }
    }
    return null;
}

// The names of the locals and the parameters 'loop' may write, which one walk over the parts each pass
// through it runs records for it and for each loop inside it.
loopWriteNames(BodyChecker checker, SyntaxNode loop) -> Set<string> {
    return checker.writeNames().get(loop.green()) ?? collectLoopNames(loop, checker.writeNames());
}

// The names of the locals and the parameters the condition 'condition' of 'loop' may write, or null where
// it writes none, which the walk that records what 'loop' may write records.
conditionWriteNames(BodyChecker checker, SyntaxNode loop, Expression condition) -> Set<string>? {
    loopWriteNames(checker, loop);
    return checker.writeNames().get(condition.green());
}

// Records in 'recorded', for 'loop' and for each loop inside it, the names of the locals and the
// parameters it may write, and for its condition where that writes any, and returns the names 'loop' may
// write.
collectLoopNames(SyntaxNode loop, Map<GreenNode, Set<string>> recorded) -> Set<string> {
    let names = new Set<string>();
    let condition = loopCondition(loop);
    for (let part in loopParts(loop)) {
        if (condition == null || part.green() != condition.green()) {
            collectWrittenNames(part, recorded, names);
            continue;
        }
        let written = new Set<string>();
        collectWrittenNames(part, recorded, written);
        if (!written.isEmpty()) {
            recorded.set(condition.green(), written);
            addNames(names, written);
        }
    }
    recorded.set(loop.green(), names);
    return names;
}

// Adds to 'names' each local and parameter 'node' may write by an assignment, '++', '--' or 'out'. A loop, a
// '?:', a '&&' or a '||' inside records its own names, and a loop's initializer or iterable is written once,
// outside it.
collectWrittenNames(SyntaxNode node, Map<GreenNode, Set<string>> recorded, Set<string> names) {
    switch (node) {
        is WhileStatementNode ignored -> {
            addNames(names, collectLoopNames(node, recorded));
            return;
        },
        is ForStatementNode loop -> {
            switch (loop.initializer()) {
                is VariableDeclarationNode declaration -> {
                    collectWrittenNames(declaration, recorded, names);
                },
                is ExpressionStatementNode statement -> {
                    collectWrittenNames(statement, recorded, names);
                },
                default -> { },
            }
            addNames(names, collectLoopNames(node, recorded));
            return;
        },
        is ForEachStatementNode loop -> {
            collectWrittenNames(loop.iterable(), recorded, names);
            addNames(names, collectLoopNames(node, recorded));
            return;
        },
        is TernaryExpressionNode ignored -> {
            addNames(names, recorded.get(node.green()) ?? collectNodeNames(node, recorded));
            return;
        },
        is BinaryExpressionNode binary -> {
            let operator = binary.operator().kind();
            if (operator == SyntaxKind.AmpersandAmpersand || operator == SyntaxKind.PipePipe) {
                addNames(names, recorded.get(node.green()) ?? collectNodeNames(node, recorded));
                return;
            }
        },
        is AssignmentExpressionNode assignment -> {
            addTargetName(assignment.target(), names);
        },
        is PrefixExpressionNode prefix -> {
            let operator = prefix.operator().kind();
            if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
                addTargetName(prefix.operand(), names);
            }
        },
        is PostfixExpressionNode postfix -> {
            let operator = postfix.operator().kind();
            if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
                addTargetName(postfix.operand(), names);
            }
        },
        is OutArgumentNode outArgument -> {
            names.add(outArgument.name().text());
        },
        default -> { },
    }
    for (let child in node.childNodes()) {
        collectWrittenNames(child, recorded, names);
    }
}

// The names of the locals and the parameters the '?:', '&&' or '||' 'node' may write, which one walk over it
// records for it and for each loop, '?:', '&&' and '||' inside it.
writeNamesOf(BodyChecker checker, SyntaxNode node) -> Set<string> {
    return checker.writeNames().get(node.green()) ?? collectNodeNames(node, checker.writeNames());
}

// Records in 'recorded', for the '?:', '&&' or '||' 'node' and for each loop, '?:', '&&' and '||' inside it,
// the names of the locals and the parameters it may write, and returns the names 'node' may write.
collectNodeNames(SyntaxNode node, Map<GreenNode, Set<string>> recorded) -> Set<string> {
    let names = new Set<string>();
    for (let child in node.childNodes()) {
        collectWrittenNames(child, recorded, names);
    }
    recorded.set(node.green(), names);
    return names;
}

// Only a local or a parameter can be written in a loop and hold a narrowing, since a 'const'
// field takes no write there and nothing else narrows. Parentheses name the place they hold.
addTargetName(Expression target, Set<string> names) {
    Expression place = syntax.unwrapParentheses(target);
    if (place is IdentifierExpressionNode) {
        names.add(place.name().text());
    }
}

addNames(Set<string> names, Set<string> added) {
    for (let name in added) {
        names.add(name);
    }
}

// Adds to 'written' the local or parameter 'name' names here. Names resolve against the current
// scope, since the loop is not analyzed yet, and resolving one is not a read, so no lambda captures
// it. A 'const' local never changes, and neither does a name the scopes of the lambda being checked do
// not declare, since that is a capture.
addWrittenName(BodyChecker checker, string name, Set<LocalBinding> written) {
    let current = checker.currentScope();
    if (current == null) {
        return;
    }
    let binding = current.lookup(name);
    if (binding != null && !binding.isConst()) {
        written.add(binding);
    }
}

public analyzeCast(BodyChecker checker, CastExpressionNode node) -> Type {
    Type source = checker.analyzeExpression(node.value());
    Type target = checker.resolver().resolveType(node.target());
    if (source is ErrorType || target is ErrorType) {
        return checker.store().errorType();
    }
    literaltyping.adaptLiteralToCastTarget(checker, node.value(), target);
    let retyped = checker.result().typeOf(node.value().green());
    if (retyped != null) {
        source = retyped;
    }
    if (source is EnumType) {
        if (!source.isNumeric()) {
            checker.reporter().report(enumNeedsValuesMessage(checker, source), node.span());
            return checker.store().errorType();
        }
        if (!convert.isIntegerType(target)) {
            checker.reporter().report("Cannot convert enum {checker.names().quoted(source)} to "
                + "{checker.names().quoted(target)} with 'as'. An enum whose members have values converts "
                + "only to an integer type, such as 'int' or 'long'.", node.span());
            return checker.store().errorType();
        }
        return target;
    }
    if (target is EnumType) {
        if (target.isNumeric()) {
            checker.reporter().report("Converting {checker.names().quoted(source)} to enum "
                + "{checker.names().quoted(target)} fails when no member has that value. Use "
                + "'as?', which gives {checker.names().quotedNullable(target)} and is null when no "
                + "member matches.", node.span());
        } else {
            checker.reporter().report(enumNeedsValuesMessage(checker, target), node.span());
        }
        return checker.store().errorType();
    }
    let noValue = voidcalls.missingValueRefusal(checker, node.value(), source, "convert with 'as'");
    if (noValue != null) {
        checker.reporter().report(noValue, node.span());
        return checker.store().errorType();
    }
    if (!convert.isNumericType(source) || !convert.isNumericType(target)) {
        checker.reporter().report("Cannot convert {checker.names().quoted(source)} to "
            + "{checker.names().quoted(target)} with 'as'. 'as' converts only between numbers, and between "
            + "an enum and an integer.", node.span());
        return checker.store().errorType();
    }
    return target;
}

// Guidance when a plain enum is used in a numeric conversion: it names the enum and shows how
// to make it numeric using its own first member.
enumNeedsValuesMessage(BodyChecker checker, EnumType enumType) -> string {
    string member = "First";
    let names = enumType.memberNames();
    if (names.length > 0) {
        member = names[0];
    }
    return "Enum {checker.names().quotedName(enumType)} assigns no values to its members, so it "
        + "does not convert to or from an integer. Give the members values, for example "
        + "'{member} = 0'.";
}

public analyzeTypeTest(BodyChecker checker, TypeTestExpressionNode node) -> Type {
    Type source = checker.analyzeExpression(node.value());
    Type target = checker.resolver().resolveType(node.target());
    checker.result().setType(node.target().green(), target);
    if (source is ErrorType || target is ErrorType) {
        return checker.store().errorType();
    }
    if (!checkClassTypeTest(checker, node, node.value(), source, target, false)) {
        return checker.store().errorType();
    }
    return checker.store().primitive(PrimitiveKind.Bool);
}

public analyzeCheckedCast(BodyChecker checker, CheckedCastExpressionNode node) -> Type {
    Type source = checker.analyzeExpression(node.value());
    Type target = checker.resolver().resolveType(node.target());
    if (source is ErrorType || target is ErrorType) {
        return checker.store().errorType();
    }
    if (target is PrimitiveType && target.kind() == PrimitiveKind.Char) {
        return checkedCharCast(checker, node, source, target);
    }
    if (target is EnumType && reportTwoLevelCast(checker, node, source)) {
        return checker.store().errorType();
    }
    if (target is EnumType) {
        if (!target.isNumeric()) {
            checker.reporter().report(enumNeedsValuesMessage(checker, target), node.span());
            return checker.store().errorType();
        }
        if (!convert.isIntegerType(source)) {
            checker.reporter().report("Cannot convert {checker.names().quoted(source)} to enum "
                + "{checker.names().quoted(target)} with 'as?'. Only an integer can be matched against the "
                + "values of an enum's members.", node.span());
            return checker.store().errorType();
        }
        return checker.store().optionalOf(target);
    }
    if (source is EnumType && source.isNumeric() && convert.isIntegerType(target)) {
        checker.reporter().report("Converting enum {checker.names().quoted(source)} to "
            + "{checker.names().quoted(target)} always succeeds. Write 'as' instead of 'as?'.", node.span());
        return checker.store().errorType();
    }
    if (!checkClassTypeTest(checker, node, node.value(), source, target, true)) {
        return checker.store().errorType();
    }
    return checker.store().optionalOf(target);
}

// Refuses 'as?' on a value with two levels of null, which the cast checks only one of, the way
// 'is' and the class form of 'as?' refuse it. True when it reported.
reportTwoLevelCast(BodyChecker checker, CheckedCastExpressionNode node, Type source) -> bool {
    let issue = capabilities.twoLevelTestIssue(source, true, checker.names(),
        nullguidance.oneLevelGuidance(checker, node.value(), source));
    if (issue == null) {
        return false;
    }
    checker.reporter().report(issue, node.span());
    return true;
}

// 'value as? char': the character whose code point the integer is, or null for a surrogate or a
// value past 0x10FFFF. A 'byte' is always a code point, so it converts with 'as'.
checkedCharCast(BodyChecker checker, CheckedCastExpressionNode node, Type source, Type target) -> Type {
    string quoted = checker.names().quoted(source);
    if (reportTwoLevelCast(checker, node, source)) {
        return checker.store().errorType();
    }
    if (source is PrimitiveType && source.kind() == PrimitiveKind.Char) {
        string spelled = wording.oneLineSpelling(syntax.unwrapParentheses(node.value()));
        checker.reporter().report("'{spelled}' is already a 'char', so 'as? char' does not change it. "
            + "Remove 'as? char'.", node.span());
        return checker.store().errorType();
    }
    if (!convert.isIntegerType(source)) {
        checker.reporter().report("Cannot convert {quoted} to 'char' with 'as?'. Only an integer can be "
            + "checked against the code points of Unicode.", node.span());
        return checker.store().errorType();
    }
    if (source is PrimitiveType && source.kind() == PrimitiveKind.Byte) {
        checker.reporter().report("Converting {quoted} to 'char' always succeeds, because every {quoted} "
            + "value is a code point. Write 'as' instead of 'as?'.", node.span());
        return checker.store().errorType();
    }
    return checker.store().optionalOf(target);
}

// The refusal of the 'is' test 'test' of 'value' against 'target' inside a lambda, where a proof made
// where the lambda is created makes the test always true and the declared type of 'value' does not,
// or null anywhere else.
carriedTestRefusal(BodyChecker checker, Expression test, Expression value, Type target) -> string? {
    let path = buildNarrowingPath(checker, value);
    let declared = declaredSlotType(checker, value);
    if (path == null || declared == null) {
        return null;
    }
    let carried = lambdas.carriedProof(checker, path);
    if (carried == null || !hierarchy.isSubclassOrConforms(convert.coreOf(carried), target)
            || hierarchy.isSubclassOrConforms(convert.coreOf(declared), target)) {
        return null;
    }
    string place = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    string holds = checker.names().quotedCode(["{place} is ", ""], [target]);
    string article = typenames.typeArticle(checker.names().of(target));
    string tested = checker.names().quoted(target);
    string refusal = "This test is always true: '{place}' is already {article} {tested} here, because "
        + "{holds} holds where the lambda is created.";
    let fix = alwaysTrueTestFix(test);
    if (fix == null) {
        return refusal;
    }
    return "{refusal} {fix}";
}

// The refusal of the 'is' test 'test' of 'value' against 'target', where the class a write proved for
// 'value' makes the test always true or always false and the declared type of 'value' does not, with that
// write as a note, or null anywhere else. The class is the one the write stored, or where branches met
// after writes of different classes, the class every way through them leaves.
writtenTestRefusal(BodyChecker checker, Expression test, Expression value, Type target) -> string? {
    let path = buildNarrowingPath(checker, value);
    let declared = declaredSlotType(checker, value);
    if (path == null || declared == null) {
        return null;
    }
    let write = checker.narrowing().writeOf(path);
    let proven = checker.narrowing().provenType(path);
    if (write == null || write.loop() != null || proven == null || proven is OptionalType) {
        return null;
    }
    Type core = convert.coreOf(proven);
    Type declaredCore = convert.coreOf(declared);
    let stored = write.stored();
    bool storedProof = stored != null && convert.coreOf(stored) == core;
    if (!types.isClassLike(core) || !types.isClassLike(declaredCore)
            || hierarchy.isSubclassOrConforms(declaredCore, target) || (!storedProof && !write.inJoin())) {
        return null;
    }
    string place = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    string held = "{typenames.typeArticle(checker.names().of(core))} {checker.names().quoted(core)}";
    string reason = "the value assigned to '{place}' is {held}";
    if (!storedProof) {
        reason = "'{place}' is {held} after the {write.joinedStatement()}, whichever way it runs";
    }
    string tested = "{typenames.typeArticle(checker.names().of(target))} {checker.names().quoted(target)}";
    string note = diagnostics.carriedNote(write.at(), "'{place}' is assigned here");
    if (hierarchy.isSubclassOrConforms(core, target)) {
        string refusal = "This test is always true: {reason}, so '{place}' is always {tested} here.{note}";
        let fix = alwaysTrueTestFix(test);
        return fix == null ? refusal : "{refusal} {fix}";
    }
    if (types.isInterfaceLike(core) || types.isInterfaceLike(target) || hierarchy.isSubclassOf(target, core)
            || !hierarchy.isSubclassOf(target, declaredCore)) {
        return null;
    }
    return "This test is always false: {reason}, and {checker.names().quoted(target)} does not extend "
        + "{checker.names().quoted(core)}, so '{place}' is never {tested} here.{note}";
}

// The fix for an 'is' test that is always true where it is the whole condition of an 'if': removing
// the test and keeping the body it guards, with its 'else' branch removed too. Null anywhere else.
alwaysTrueTestFix(Expression test) -> string? {
    SyntaxNode? holder = test.parent();
    while (holder is ParenthesizedExpressionNode) {
        holder = holder.parent();
    }
    if (!(holder is IfStatementNode)) {
        return null;
    }
    if (holder.elseClause() != null) {
        return "Remove this test and its 'else' branch, and keep its body.";
    }
    return "Remove this test and keep its body.";
}

// The 'is' and 'as?' rule set for 'test' on 'value': the target must be a plain class or interface,
// and the pair must be able to succeed without always succeeding. Open-typed operands defer to each
// instantiation.
checkClassTypeTest(BodyChecker checker, Expression test, Expression value, Type source, Type target,
                   bool isCast) -> bool {
    Span span = test.span();
    string operator = "is";
    if (isCast) {
        operator = "as?";
    }
    if (target is OptionalType) {
        Type core = convert.coreOf(target);
        if (isCast) {
            string cast = checker.names().quotedCode(["as? ", ""], [core]);
            checker.reporter().report("The type after 'as?' cannot be nullable, because {cast} already "
                + "produces {checker.names().quotedNullable(core)}. Write {cast}.", span);
        } else {
            string test = checker.names().quotedCode(["is ", ""], [core]);
            checker.reporter().report("The type after 'is' cannot be nullable, because 'is' never matches "
                + "null. Write {test}.", span);
        }
        return false;
    }
    if (!(target is TypeParamType) && !types.isClassLike(target)) {
        checker.reporter().report("The type after '{operator}' must be a class or an interface, and "
            + "{checker.names().quoted(target)} is neither.", span);
        return false;
    }
    if (convert.containsTypeParam(source) || convert.containsTypeParam(target)) {
        checker.recordObligation(new TypeTestObligation(source, target, isCast, span));
        return true;
    }
    if (!isCast) {
        let carried = carriedTestRefusal(checker, test, value, target)
            ?? writtenTestRefusal(checker, test, value, target);
        if (carried != null) {
            checker.reporter().report(carried, span);
            return false;
        }
    }
    let issue = capabilities.typeTestIssue(source, target, isCast, checker.names(),
        nullguidance.oneLevelGuidance(checker, value, source));
    if (issue != null) {
        checker.reporter().report(issue, span);
        return false;
    }
    return true;
}
