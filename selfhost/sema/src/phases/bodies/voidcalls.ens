// How a refusal of a value opens and ends when the value is a call that returns no value.
import Expression from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import model.types;
import Type from model.types;
import phases.bodies.wording;
import support.syntax;
import BodyChecker from phases.bodies;

// Why 'value', of type 'analyzed', has no value, as the opening of a sentence: "'nothing' returns
// no value". Null for any value but a call that returns nothing. A call that never returns keeps
// the refusal of the place it is written in.
public noValueOpening(BodyChecker checker, Expression value, Type analyzed) -> string? {
    if (!types.isVoidType(analyzed)) {
        return null;
    }
    let call = calledThrough(value);
    if (call == null || checker.callNeverReturns(value)) {
        return null;
    }
    let name = calledName(call);
    if (name == null) {
        return "This call returns no value";
    }
    return "'{name}' returns no value";
}

// The opening of a refusal of 'value', of type 'analyzed', ending with the call as the subject of
// what follows: "'nothing' returns no value, so a call to it". Null for any value but a call that
// returns nothing.
public refusedCall(BodyChecker checker, Expression value, Type analyzed) -> string? {
    let opening = noValueOpening(checker, value, analyzed);
    if (opening == null) {
        return null;
    }
    if (!callsNamed(value)) {
        return "{opening}, so it";
    }
    return "{opening}, so a call to it";
}

// The advice to call 'value' as a statement of its own, quoting it when it is short enough.
public asStatement(Expression value) -> string {
    string advice = "{callIt(value)} as a statement of its own";
    string statement = wording.oneLineSpelling(syntax.unwrapParentheses(value)) + ";";
    if (statement.length > wording.quotedCodeLimit()) {
        return advice;
    }
    return "{advice}, as in '{statement}'";
}

// The words that open the advice to move the call 'value': "Call it" for a call of a function or
// method by name, and "Write it" for a call of any other value.
callIt(Expression value) -> string {
    if (callsNamed(value)) {
        return "Call it";
    }
    return "Write it";
}

// True when 'value' is a call, through parentheses and a 'try', of a function or method by name.
callsNamed(Expression value) -> bool {
    let call = calledThrough(value);
    return call != null && calledName(call) != null;
}

// The call 'value' is, through parentheses and a 'try', or null for any other value.
calledThrough(Expression value) -> CallExpressionNode? {
    Expression core = syntax.unwrapParentheses(value);
    if (core is TryExpressionNode) {
        core = syntax.unwrapParentheses(core.operand());
    }
    if (core is CallExpressionNode) {
        return core;
    }
    return null;
}

// The name of the function or method a call runs, or null for a call of any other value.
calledName(CallExpressionNode call) -> string? {
    switch (syntax.unwrapParentheses(call.callee())) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text();
        },
        is MemberExpressionNode member -> {
            return member.member().text();
        },
        is SafeMemberExpressionNode member -> {
            return member.member().text();
        },
        default -> {
            return null;
        },
    }
}
