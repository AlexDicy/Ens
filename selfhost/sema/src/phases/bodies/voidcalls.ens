// How a refusal of a value opens and ends when the value is a call that returns no value.
import Expression from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import model.convert;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import phases.bodies.wording;
import support.syntax;
import List from @std.collections.list;
import BodyChecker from phases.bodies;

// Why 'value', of type 'analyzed', has no value, as the opening of a sentence: "'nothing' returns
// no value". Null for any value but a call that returns nothing. A call that never returns keeps
// the refusal of the place it is written in.
public noValueOpening(BodyChecker checker, Expression value, Type analyzed) -> string? {
    if (!types.isVoidType(analyzed)) {
        return null;
    }
    let call = calledThrough(value);
    if (call == null || checker.callNeverReturns(value)) {
        return null;
    }
    let name = calledName(call);
    if (name == null) {
        return "This call returns no value";
    }
    return "'{name}' returns no value";
}

// Why the calls 'values' have no value, as the opening of a sentence: "'nothing' and 'other'
// return no value", or 'unnamed' when one of them calls a value that has no name. Each value is a
// call that returns nothing.
public noValuesOpening(List<Expression> values, string unnamed) -> string {
    let names = new List<string>();
    for (let value in values) {
        let call = calledThrough(value);
        if (call == null) {
            return unnamed;
        }
        let name = calledName(call);
        if (name == null) {
            return unnamed;
        }
        if (!names.contains(name)) {
            names.push(name);
        }
    }
    if (names.length() == 1) {
        return "'{names.get(0)}' returns no value";
    }
    if (names.length() > 3) {
        return "'{names.get(0)}', '{names.get(1)}' and {names.length() - 2} others return no value";
    }
    return "{wording.quotedList(names)} return no value";
}

// The opening of a refusal of 'value', of type 'analyzed', ending with the call as the subject of
// what follows: "'nothing' returns no value, so a call to it". Null for any value but a call that
// returns nothing.
public refusedCall(BodyChecker checker, Expression value, Type analyzed) -> string? {
    let opening = noValueOpening(checker, value, analyzed);
    if (opening == null) {
        return null;
    }
    if (!callsNamed(value)) {
        return "{opening}, so it";
    }
    return "{opening}, so a call to it";
}

// The advice to call 'value' as a statement of its own, quoting it when it is short enough, or
// null where no statement can be written, as in a field's default value.
public asStatement(BodyChecker checker, Expression value) -> string? {
    string spelled = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    if (!checker.frame().statementsAllowed()) {
        let lambda = checker.frame().innermostLambda();
        if (lambda == null || lambda.body() is BlockNode) {
            return null;
        }
        if (spelled.length > wording.quotedCodeLimit()) {
            return "Give the lambda a block body with the call as a statement of its own";
        }
        return "Give the lambda a block body that calls '{spelled}' as a statement of its own";
    }
    string advice = "{callIt(value)} as a statement of its own";
    string statement = spelled + ";";
    if (statement.length > wording.quotedCodeLimit()) {
        return advice;
    }
    return "{advice}, as in '{statement}'";
}

// The words that open the advice to move the call 'value': "Call it" for a call of a function or
// method by name, and "Write it" for a call of any other value.
callIt(Expression value) -> string {
    if (callsNamed(value)) {
        return "Call it";
    }
    return "Write it";
}

// True when 'value' is a call, through parentheses and a 'try', of a function or method by name.
callsNamed(Expression value) -> bool {
    let call = calledThrough(value);
    return call != null && calledName(call) != null;
}

// The advice to call 'value' as a statement of its own where a sentence names something else
// first, so the call is quoted rather than named 'it'.
public callAsStatement(Expression value) -> string {
    string spelled = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    if (spelled.length > wording.quotedCodeLimit()) {
        return "Write the call as a statement of its own";
    }
    return "Call '{spelled}' as a statement of its own";
}

// The refusal of 'value', of type 'analyzed', where a call to it would 'place'. The fix calls it
// as a statement of its own and then does 'then', as in "give 'kept' an 'int' value", when one is
// given. Null for any value but a call that returns nothing.
public receiverRefusal(BodyChecker checker, Expression value, Type analyzed, string place,
                       string? then) -> string? {
    let refused = refusedCall(checker, value, analyzed);
    if (refused == null) {
        return null;
    }
    string refusal = "{refused} cannot {place}.";
    let statement = asStatement(checker, value);
    if (statement == null) {
        return refusal;
    }
    if (then == null) {
        return "{refusal} {statement}.";
    }
    return "{refusal} {statement}, and {then}.";
}

// The refusal of 'value', of type 'analyzed', where a call to it would 'place' and a value of
// 'wanted' is needed, which the fix asks for after 'verb', as in "give 'kept' an 'int' value".
// Null for any value but a call that returns nothing.
public typedRefusal(BodyChecker checker, Expression value, Type analyzed, string place,
                    string verb, Type wanted) -> string? {
    if (noValueOpening(checker, value, analyzed) == null) {
        return null;
    }
    return receiverRefusal(checker, value, analyzed, place, asked(verb, wanted, checker.names()));
}

// The refusal of 'value', of type 'analyzed', where a call to it would 'place' and nothing names
// the value needed there. Null for any value but a call that returns nothing.
public useRefusal(BodyChecker checker, Expression value, Type analyzed, string place) -> string? {
    return receiverRefusal(checker, value, analyzed, place, null);
}

// The refusal of 'value', of type 'analyzed', as an argument 'callee' takes as a value of type
// 'wanted', as in "'take'". Null for any value but a call that returns nothing.
public argumentRefusal(BodyChecker checker, Expression value, Type analyzed, string callee,
                       Type wanted) -> string? {
    if (noValueOpening(checker, value, analyzed) == null) {
        return null;
    }
    let needed = valueOf(wanted, checker.names());
    string? then = null;
    if (needed != null) {
        then = "pass {needed} to {callee}";
    }
    return receiverRefusal(checker, value, analyzed, "be passed to {callee}", then);
}

// The words that ask for a value of 'wanted' after 'verb', as in "give 'kept' an 'int' value", or
// null for a type a fix cannot name.
asked(string verb, Type wanted, TypeNames names) -> string? {
    let needed = valueOf(wanted, names);
    if (needed == null) {
        return null;
    }
    return "{verb} {needed}";
}

// The refusal of 'value', of type 'analyzed', as the right side of the '&&', '||' or '??'
// 'operatorText' over 'left', which runs only when 'left' does not decide the result, so its fix
// keeps the call under that condition. Null for any value but a call that returns nothing.
public conditionalRefusal(BodyChecker checker, Expression value, Type analyzed,
                          string operatorText, Expression left) -> string? {
    let refused = refusedCall(checker, value, analyzed);
    if (refused == null) {
        return null;
    }
    string refusal = "{refused} cannot be used with '{operatorText}'.";
    string tested = wording.oneLineSpelling(syntax.unwrapParentheses(left));
    if (operatorText != "&&" && !wording.isSingleTerm(left)) {
        tested = "({tested})";
    }
    string condition = tested;
    if (operatorText == "||") {
        condition = "!{tested}";
    } else if (operatorText == "??") {
        condition = "{tested} == null";
    }
    string call = wording.oneLineSpelling(syntax.unwrapParentheses(value));
    string statement = "if ({condition}) \{ {call}; \}";
    if (!checker.frame().statementsAllowed() || statement.length > wording.quotedCodeLimit()) {
        return refusal;
    }
    return "{refusal} {callIt(value)} in an 'if' statement, as in '{statement}'.";
}

// The refusal of 'hole', of type 'analyzed', as an interpolation hole. Null for any value but a
// call that returns nothing.
public holeRefusal(BodyChecker checker, Expression hole, Type analyzed) -> string? {
    if (noValueOpening(checker, hole, analyzed) == null) {
        return null;
    }
    string spelled = "\{" + wording.oneLineSpelling(hole) + "\}";
    string removal = "remove its hole from the string";
    if (spelled.length <= wording.quotedCodeLimit()) {
        removal = "remove '{spelled}' from the string";
    }
    return receiverRefusal(checker, hole, analyzed, "fill an interpolation hole", removal);
}

// The refusal of 'value', of type 'analyzed', where the code around it needs a value to 'act', as
// in "call 'hash' on". Null for any value but a call that returns nothing.
public missingValueRefusal(BodyChecker checker, Expression value, Type analyzed, string act)
        -> string? {
    let opening = noValueOpening(checker, value, analyzed);
    if (opening == null) {
        return null;
    }
    return "{opening}, so there is no value to {act}.";
}

// The refusal of 'value', of type 'analyzed', as the default value of the 'kind' 'name', as in
// "parameter 'limit'", whose type is 'wanted'. Null for any value but a call that returns nothing.
public defaultRefusal(BodyChecker checker, Expression value, Type analyzed, string kind,
                      string name, Type wanted) -> string? {
    let refused = refusedCall(checker, value, analyzed);
    if (refused == null) {
        return null;
    }
    string removal = "Remove the default value";
    string spelled = "= " + wording.oneLineSpelling(syntax.unwrapParentheses(value));
    if (spelled.length <= wording.quotedCodeLimit()) {
        removal = "Remove '{spelled}'";
    }
    string given = "a default value";
    if (valueOf(wanted, checker.names()) != null) {
        given = "a default {checker.names().quoted(wanted)} value";
    }
    return "{refused} cannot be the default value of {kind} '{name}'. {removal}, or give "
        + "'{name}' {given}.";
}

// A value of 'type' as a fix asks for it, as in "an 'int' value", or null for a type a fix
// cannot name.
public valueOf(Type type, TypeNames names) -> string? {
    if (type is ErrorType || types.isVoidType(type) || convert.containsTypeParam(type)) {
        return null;
    }
    return "{typenames.typeArticle(names.of(type))} {names.quoted(type)} value";
}

// The call 'value' is, through parentheses and a 'try', or null for any other value.
calledThrough(Expression value) -> CallExpressionNode? {
    Expression core = syntax.unwrapParentheses(value);
    if (core is TryExpressionNode) {
        core = syntax.unwrapParentheses(core.operand());
    }
    if (core is CallExpressionNode) {
        return core;
    }
    return null;
}

// The name of the function or method a call runs, or null for a call of any other value.
calledName(CallExpressionNode call) -> string? {
    switch (syntax.unwrapParentheses(call.callee())) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text();
        },
        is MemberExpressionNode member -> {
            return member.member().text();
        },
        is SafeMemberExpressionNode member -> {
            return member.member().text();
        },
        default -> {
            return null;
        },
    }
}
