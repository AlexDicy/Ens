// Member access with '.', '?.' and '[...]', and names qualified by a module: the lookup of a member
// by name, its visibility checks, and the members a receiver's type arguments exclude.
import Expression from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeSubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import Span from @ens.frontend.support.source;
import ModuleContext from context;
import FunctionEntry from context;
import phases.calls;
import model.convert;
import phases.members;
import phases.bodies.operators;
import phases.bodies.nullguidance;
import phases.bodies.wording;
import phases.bodies.narrowing;
import model.hierarchy;
import FailedConstraint from model.hierarchy;
import model.typemembers;
import Field from model.typemembers;
import Method from model.typemembers;
import Signature from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import StringType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import PrimitiveKind from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import StructType from model.types;
import InterfaceType from model.types;
import EnumType from model.types;
import ExternalType from model.types;
import InstantiationType from model.types;
import TypeParamType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import phases.bodies.staticmembers;
import phases.bodies.functioncalls;
import phases.bodies.methodcalls;
import phases.bodies;
import phases.bodies.functionvalues;
import LambdaFit from phases.bodies.functionvalues;
import BodyChecker from phases.bodies;
import NameResolution from phases.bodies;
import TypeName from phases.bodies;
import NamespaceName from phases.bodies;

// What a member name means on a receiver type.
public sealed abstract class MemberLookup {
}

public final class FieldMember extends MemberLookup {
    protected Field field;

    protected constructor(this.field);
}

class MethodMember extends MemberLookup {
    protected List<Method> candidates;

    protected constructor(this.candidates);
}

public final class MissingMember extends MemberLookup {
    protected constructor();
}

// Where a member access appears, which decides what a method under its name is reported as. The
// expression around a covered access reports that method itself.
public enum MemberPosition {
    Read,
    Write,
    Covered,
}

// Where a refused name stands in the expression it was written in, which decides what route to a
// static of the enclosing type the refusal can offer.
public enum NamePosition {
    Value,
    Call,
    MemberHead,
}

// The message a method's name written where a value belongs is refused with. A read cannot hold
// it and a write cannot assign it. 'subject' names the method and its owner, and 'call' is how
// the file writes a call to it.
public methodAsValueMessage(string subject, string call, MemberPosition position) -> string {
    if (position == MemberPosition.Write) {
        return subject + ", so it cannot be assigned.";
    }
    return subject + ", and a method's name is not a value. Call it as '{call}'.";
}

// The fix for an open type parameter 'parameter' that a member needs bounded by 'bound': add the bound to
// the declaration 'memberWord' names, or where 'parameter' is declared.
public addBoundAdvice(string memberWord, string parameter, string bound) -> string {
    if (memberWord.length == 0) {
        return "Add the bound where '{parameter}' is declared, as in '<{parameter}: {bound}>'.";
    }
    return "Add the bound to this {memberWord}, as in '<{parameter}: {bound}>', or to '{parameter}' where "
        + "it is declared.";
}

// The head a static method of 'declaring' reached as 'reached' is written behind: the instantiation
// with the type arguments the subclass gives it, or the declaring type's name where they name a type
// parameter.
public staticMethodHead(Type reached, DeclaredType declaring) -> Type {
    if (reached is InstantiationType && !convert.containsTypeParam(reached)) {
        return reached;
    }
    return declaring;
}

// A call to one of the static methods 'candidates' as the text written before and after its head:
// 'try ' before it when every one of them throws, and '()' or '(...)' after it.
public final class StaticCallText {
    protected string callPrefix;
    protected string callSuffix;

    public constructor(List<Method> candidates) {
        this.callPrefix = "";
        this.callSuffix = methodCallText("", candidates);
        if (this.callSuffix.startsWith("try ")) {
            this.callPrefix = "try ";
            this.callSuffix = this.callSuffix.substring(4);
        }
    }

    public prefix() -> string {
        return this.callPrefix;
    }

    public suffix() -> string {
        return this.callSuffix;
    }
}

// A call to one of 'candidates' written after 'head': '()' when none of them takes a parameter and
// '(...)' otherwise, after a 'try' when every one of them throws.
public methodCallText(string head, List<Method> candidates) -> string {
    bool bare = true;
    bool throwing = candidates.length() > 0;
    for (long i = 0; i < candidates.length(); i++) {
        let signature = candidates.get(i).signature();
        if (signature.parameters().length > 0) {
            bare = false;
        }
        if (!signature.declaresThrows()) {
            throwing = false;
        }
    }
    string call = "{head}(...)";
    if (bare) {
        call = "{head}()";
    }
    if (throwing) {
        return "try " + call;
    }
    return call;
}

public analyzeSubscript(BodyChecker checker, SubscriptExpressionNode node) -> Type {
    Type objectType = checker.analyzeExpression(node.object());
    let outerDeferred = checker.targets().deferredFixes();
    checker.targets().setDeferredFixes(null);
    Type indexType = checker.analyzeExpression(node.index());
    checker.targets().setDeferredFixes(outerDeferred);
    if (objectType is ErrorType) {
        return checker.store().errorType();
    }
    if (objectType is OptionalType && convert.coreOf(objectType) is ArrayType) {
        checker.reporter().report(nullguidance.maybeNullRefusal(checker, "Cannot index "
            + "'{checker.names().of(objectType)}' because it", node.object(), objectType), node.span());
        return checker.store().errorType();
    }
    if (objectType is ArrayType) {
        checkIndexIsInteger(checker, indexType, node.index());
        return objectType.element();
    }
    checker.reporter().report(notArrayRefusal(checker, node.object(), objectType), node.span());
    return checker.store().errorType();
}

// The refusal of '[...]' after 'object', whose type is not an array.
notArrayRefusal(BodyChecker checker, Expression object, Type objectType) -> string {
    string shown = checker.names().of(objectType);
    return "Cannot index {wording.sideNamed(object, "this value")}, because its type '{shown}' is not an "
        + "array. Only an array can be indexed with '[...]'.";
}

public analyzeSafeSubscript(BodyChecker checker, SafeSubscriptExpressionNode node) -> Type {
    Type objectType = checker.analyzeExpression(node.object());
    let outerDeferred = checker.targets().deferredFixes();
    checker.targets().setDeferredFixes(null);
    Type indexType = checker.analyzeExpression(node.index());
    checker.targets().setDeferredFixes(outerDeferred);
    if (objectType is ErrorType) {
        return checker.store().errorType();
    }
    objectType = narrowing.presenceOperandType(checker, node.object(), objectType);
    if (!(objectType is OptionalType)) {
        if (!(objectType is ArrayType)) {
            checker.reporter().report(notArrayRefusal(checker, node.object(), objectType), node.span());
            return checker.store().errorType();
        }
        let spelled = wording.shortSpelling(node.object());
        if (spelled == null) {
            checker.reporter().report("The value before '?[' has type '{checker.names().of(objectType)}', "
                + "which can never be null, so it needs no '?['. Write '[' instead.", node.span());
        } else {
            checker.reporter().report("'{spelled}' has type '{checker.names().of(objectType)}', which can "
                + "never be null, so it needs no '?['. Write "
                + "'{spelled}[{wording.oneLineSpelling(node.index())}]'.", node.span());
        }
        return checker.store().errorType();
    }
    Type inner = objectType.inner();
    if (inner is OptionalType) {
        checker.reporter().report(nullguidance.withGuidance(checker, "'?[' checks for one level of null, but "
            + "the value on its left has type '{checker.names().of(objectType)}', which can be null at more "
            + "than one level.", nullguidance.nullGuidance(checker, node.object(), objectType,
            wording.optionalLevels(objectType) - 1)), node.span());
        return checker.store().errorType();
    }
    if (inner is ArrayType) {
        checkIndexIsInteger(checker, indexType, node.index());
        return methodcalls.safeResultOf(checker, inner.element());
    }
    checker.reporter().report(notArrayRefusal(checker, node.object(), objectType), node.span());
    return checker.store().errorType();
}

// Refuses the index 'node' of an array unless it is an integer.
checkIndexIsInteger(BodyChecker checker, Type indexType, Expression node) {
    if (!(indexType is ErrorType) && !convert.isIntegerType(indexType)) {
        checker.reporter().report("The index of an array must be an integer, but "
            + "{wording.sideNamed(node, "the index")} has type '{checker.names().of(indexType)}'.",
            node.span());
    }
}

// The type whose members a receiver exposes: a bounded type parameter exposes the members
// of its bounds, the first bound declaring the member winning; inside a conditional member
// the constraint's extra bounds count. Optional receivers are rejected before this point.
public memberReceiverCore(BodyChecker checker, Type analyzed, string memberName) -> Type {
    Type core = analyzed;
    if (core is TypeParamType) {
        Type[] bounds = effectiveBoundsOf(checker, core);
        for (let bound in bounds) {
            if (!(lookupMember(checker, bound, memberName) is MissingMember)) {
                return bound;
            }
        }
        if (bounds.length > 0) {
            return bounds[0];
        }
    }
    return core;
}

// The parameter's declared bounds plus whatever the active conditional member's constraint
// adds to it.
public effectiveBoundsOf(BodyChecker checker, TypeParamType parameter) -> Type[] {
    Type[] extra = hierarchy.extraBoundsFor(parameter, checker.resolver().activeConstraintOwner(),
        checker.resolver().activeConstraints());
    if (extra.length == 0) {
        return parameter.bounds();
    }
    let combined = new List<Type>();
    for (let bound in parameter.bounds()) {
        combined.push(bound);
    }
    for (let bound in extra) {
        combined.push(bound);
    }
    return combined.toArray();
}

// What the name means on a receiver of this type. A private base field is not inherited, so a
// method this type declares takes the name instead. That field is still what the name means
// when the type declares no other member of it, so the refusal names it as a private field
// rather than as one that does not exist.
public lookupMember(BodyChecker checker, Type record, string name) -> MemberLookup {
    let field = typemembers.inheritedOrOwnField(record, name);
    if (field != null) {
        return new FieldMember(field);
    }
    let candidates = availableMethods(checker, record, name);
    if (candidates.length() > 0) {
        return new MethodMember(candidates);
    }
    let uninherited = members.findField(typemembers.fieldsOf(record), name);
    if (uninherited != null) {
        return new FieldMember(uninherited);
    }
    return new MissingMember();
}

// The name's method candidates that exist on their defining types, judged under the active
// constraint scope; a conditional member excluded here surfaces through the
// unmet-constraint reporting instead.
public availableMethods(BodyChecker checker, Type record, string name) -> List<Method> {
    return existingOnly(checker, methodCandidates(record, name));
}

public availableStatics(BodyChecker checker, Type owner, string name) -> List<Method> {
    return existingOnly(checker, staticsNamed(owner, name));
}

public existingOnly(BodyChecker checker, List<Method> candidates) -> List<Method> {
    bool anyConditional = false;
    for (long i = 0; i < candidates.length(); i++) {
        if (candidates.get(i).isConditional()) {
            anyConditional = true;
        }
    }
    if (!anyConditional) {
        return candidates;
    }
    let kept = new List<Method>();
    for (long i = 0; i < candidates.length(); i++) {
        if (checker.resolver().memberExists(candidates.get(i))) {
            kept.push(candidates.get(i));
        }
    }
    return kept;
}

// The conditional candidates the receiver's type arguments exclude.
public missingConditional(BodyChecker checker, List<Method> candidates) -> List<Method> {
    let missing = new List<Method>();
    for (long i = 0; i < candidates.length(); i++) {
        let candidate = candidates.get(i);
        if (candidate.isConditional() && !checker.resolver().memberExists(candidate)) {
            missing.push(candidate);
        }
    }
    return missing;
}

// Reports why a member access missed when the receiver's type arguments exclude a
// conditional member with the name. True when it reported.
reportUnmetConstraintMember(BodyChecker checker, Type receiver, string name, Span span) -> bool {
    return reportFirstUnmet(checker, missingConditional(checker, methodCandidates(receiver, name)), span);
}

public reportFirstUnmet(BodyChecker checker, List<Method> missing, Span span) -> bool {
    for (long i = 0; i < missing.length(); i++) {
        let member = missing.get(i);
        let failed = checker.resolver().firstUnmetConstraint(member);
        if (failed != null) {
            let template = types.authorityOf(member.definingType());
            if (template != null) {
                checker.reporter().report(unmetConstraintMessage(checker, member, template,
                    hierarchy.typeArgumentsOf(member.definingType()), failed), span);
                return true;
            }
        }
    }
    return false;
}

// A call that reaches no available overload but fits an excluded conditional one reports
// the unmet constraint instead of a mismatched-overload error. True when it reported.
public reportUnmetConstraintCall(BodyChecker checker, List<Method> allCandidates, List<Method> available,
                                 ArgumentListNode? arguments, Span span) -> bool {
    long count = 0;
    if (arguments != null) {
        if (functioncalls.usesNamedArguments(arguments)) {
            return false;
        }
        count = arguments.argumentsCount();
    }
    let missing = missingConditional(checker, allCandidates);
    if (missing.length() == 0) {
        return false;
    }
    if (available.length() == 0) {
        return reportFirstUnmet(checker, missing, span);
    }
    for (long i = 0; i < available.length(); i++) {
        if (fitsArgumentCount(available.get(i).signature(), count)) {
            return false;
        }
    }
    let fitting = new List<Method>();
    for (long i = 0; i < missing.length(); i++) {
        if (fitsArgumentCount(missing.get(i).signature(), count)) {
            fitting.push(missing.get(i));
        }
    }
    return reportFirstUnmet(checker, fitting, span);
}

// "'sort' exists on 'List<T>' only when 'T' satisfies 'Comparable<T>'; in 'List<Widget>',
// 'T' is 'Widget', which does not implement 'Comparable<Widget>'."
public unmetConstraintMessage(BodyChecker checker, Method member, DeclaredType template, Type[] arguments,
                              FailedConstraint failed) -> string {
    string templateShown = "{checker.names().nameOf(template)}<{typeParameterExample(template)}>";
    string what = "'{member.name()}' exists on '{templateShown}'";
    if (member.isConstructor()) {
        what = "This constructor of '{templateShown}' exists";
    }
    string parameterName = template.typeParameters()[failed.parameterIndex()];
    string declaredBound = checker.names().of(failed.bound());
    Type argument = arguments[failed.parameterIndex()];
    string shownArgument = checker.names().of(argument);
    if (argument is TypeParamType) {
        return "{what} only when '{parameterName}' satisfies '{declaredBound}', and nothing here "
            + "requires that of '{shownArgument}'. "
            + addBoundAdvice(checker.currentMemberWord(), shownArgument,
                checker.names().of(failed.boundHere()));
    }
    string ownerShown = "{checker.names().nameOf(template)}<{typeArgumentsText(arguments, checker.names())}>";
    string boundShown = checker.names().of(failed.boundHere());
    if (!types.isInterfaceLike(failed.bound())) {
        return "{what} only when '{parameterName}' satisfies '{declaredBound}', and in '{ownerShown}', "
            + "'{parameterName}' is '{shownArgument}', which is not '{boundShown}' or a subclass of it. "
            + "Use a type argument that is '{boundShown}' or a subclass of it.";
    }
    string change = "";
    let declared = types.authorityOf(argument);
    if (declared != null && declared.packagePrefix() == checker.packagePrefix()) {
        change = ", or make '{shownArgument}' implement it";
    }
    return "{what} only when '{parameterName}' satisfies '{declaredBound}', and in '{ownerShown}', "
        + "'{parameterName}' is '{shownArgument}', which does not implement '{boundShown}'. Use a type "
        + "argument that implements '{boundShown}'{change}.";
}

// Export members are visible everywhere and public ones package-wide; private members are
// visible inside the declaring type, and protected ones in a subclass method or anywhere
// in the module that declares the type.
public isAccessAllowed(BodyChecker checker, Visibility visibility, Type definingType) -> bool {
    let defining = types.authorityOf(definingType);
    if (defining == null) {
        return true;
    }
    DeclaredType? current = null;
    let site = checker.frame().enclosingOwner();
    if (site != null) {
        current = types.authorityOf(site);
    }
    return types.memberAccessAllowed(visibility, defining, current, checker.modulePath(),
        checker.packagePrefix());
}

// Reports a denied access and returns whether it was allowed, so a caller layering its own
// diagnostic on the same node can stay quiet after a denial.
public checkMemberAccess(BodyChecker checker, string memberName, Visibility visibility, Type definingType,
                         Span span, string followUp = "") -> bool {
    if (isAccessAllowed(checker, visibility, definingType)) {
        return true;
    }
    string after = "";
    if (followUp.length > 0) {
        after = " {followUp}";
    }
    string owner = checker.names().of(definingType);
    string kind = "type";
    let authority = types.authorityOf(definingType);
    if (authority != null) {
        owner = authority.name();
        kind = typenames.kindWordOf(authority);
    }
    string fix = "export";
    if (authority != null && authority.packagePrefix() == checker.packagePrefix()) {
        fix = "public";
    }
    if (visibility == Visibility.Private) {
        checker.reporter().report("'{memberName}' is private to {kind} '{owner}', so only code inside "
            + "'{owner}' can use it. Mark it '{fix}' to use it here.{after}", span);
    } else if (visibility == Visibility.Public) {
        string packageName = "its own package";
        string inModule = "";
        if (authority != null) {
            if (authority.packagePrefix().length > 0) {
                packageName = "package '{authority.packagePrefix()}'";
            }
            inModule = " in module '{authority.modulePath()}'";
        }
        checker.reporter().report("'{memberName}' of '{owner}' is public inside {packageName} "
            + "but not exported. Mark it 'export'{inModule} to use it from another "
            + "package.{after}", span);
    } else if (authority != null && authority.visibility() == Visibility.Private) {
        checker.reporter().report("'{memberName}' belongs to {kind} '{owner}', which is private to "
            + "module '{authority.modulePath()}', so only that file can use it. Mark '{owner}' and "
            + "'{memberName}' '{fix}' to use it here.{after}", span);
    } else {
        checker.reporter().report("'{memberName}' is 'protected' in {kind} '{owner}', so only "
            + "{types.protectedReach(authority, owner)} can use it. Mark it '{fix}' to use it here."
            + after, span);
    }
    return false;
}

// Constructor calls run through the same accessibility rules as any other member; only the
// wording is constructor-specific. 'fromSubclass' marks a 'super(...)' call, which a
// 'protected' constructor serves.
public checkConstructorAccess(BodyChecker checker, Type ownerType, Method chosenConstructor, Span span,
                              bool fromSubclass = false) {
    if (isAccessAllowed(checker, chosenConstructor.visibility(), chosenConstructor.definingType())) {
        return;
    }
    string name = checker.names().of(ownerType);
    let ownerAuthority = types.authorityOf(ownerType);
    if (ownerAuthority != null) {
        name = ownerAuthority.name();
    }
    let authority = types.authorityOf(chosenConstructor.definingType());
    if (chosenConstructor.visibility() == Visibility.Private) {
        string fix = "Mark it 'export' to construct '{name}' here.";
        if (fromSubclass) {
            fix = "Mark it 'protected' to call it from a subclass.";
        } else if (authority != null && authority.packagePrefix() == checker.packagePrefix()) {
            fix = "Mark it 'public' to construct '{name}' here.";
        }
        checker.reporter().report("The constructor of '{name}' is private, so only code inside '{name}' can "
            + "call it. {fix}", span);
    } else if (chosenConstructor.visibility() == Visibility.Public) {
        string packageName = "its own package";
        string inModule = "";
        if (authority != null) {
            if (authority.packagePrefix().length > 0) {
                packageName = "package '{authority.packagePrefix()}'";
            }
            inModule = " in module '{authority.modulePath()}'";
        }
        checker.reporter().report("The constructor of '{name}' is public inside {packageName} "
            + "but not exported. Mark it 'export'{inModule} to construct '{name}' from "
            + "another package.", span);
    } else {
        string fix = "export";
        if (authority != null && authority.packagePrefix() == checker.packagePrefix()) {
            fix = "public";
        }
        checker.reporter().report("The constructor of '{name}' is 'protected', so only "
            + "{types.protectedReach(ownerAuthority, name)} can call it. Mark it '{fix}' to construct "
            + "'{name}' here.", span);
    }
}

// A covered access reports no method here. A call is covered because it takes the method
// this resolves to from the side table this sets.
public analyzeMemberValue(BodyChecker checker, MemberExpressionNode node,
                          MemberPosition position = MemberPosition.Read) -> Type {
    let object = node.object();
    string name = node.member().text();
    let wanted = checker.targets().functionTargetOf(node.green());
    if (object is IdentifierExpressionNode) {
        string objectName = object.name().text();
        let resolution = checker.resolveName(objectName);
        if (resolution is NamespaceName) {
            return analyzeNamespaceMemberValue(checker, node, resolution.targetModulePath(), objectName,
                wanted);
        }
        let enumType = enumTypeNamed(checker, resolution);
        if (enumType != null) {
            checker.result().setType(object.green(), enumType);
            long ordinal = bodies.enumOrdinal(enumType, name);
            if (ordinal >= 0) {
                if (position == MemberPosition.Write) {
                    checker.reporter().report("'{name}' is a member of enum "
                        + "'{checker.names().nameOf(enumType)}', so it cannot be assigned.",
                        node.member().span());
                    return checker.store().errorType();
                }
                checker.result().setEnumConstant(node.green(), ordinal);
                return enumType;
            }
            checker.reporter().report("'{name}' is not a member of enum "
                + "'{checker.names().nameOf(enumType)}'.{wording.membersListed(enumType)}",
                node.member().span());
            return checker.store().errorType();
        }
    }
    let staticHead = staticmembers.resolveStaticHead(checker, object);
    if (staticHead != null) {
        return staticmembers.analyzeStaticMemberValue(checker, node, object, staticHead, position, wanted);
    }
    Type objectType = checker.analyzeExpression(object);
    if (objectType is ErrorType) {
        return checker.store().errorType();
    }
    if (objectType is OptionalType) {
        checker.reporter().report(nullguidance.maybeNullRefusal(checker, "Cannot read a member of "
            + "'{checker.names().of(objectType)}' because it", object, objectType), node.span());
        return checker.store().errorType();
    }
    Type core = memberReceiverCore(checker, objectType, name);
    if (core is ArrayType) {
        if (name == "length") {
            if (position == MemberPosition.Write) {
                reportLengthAssignment(checker, core, node.object(), node.member().span());
                return checker.store().errorType();
            }
            return checker.store().primitive(PrimitiveKind.Long);
        }
        checker.reporter().report("Type '{checker.names().of(core)}' has no member '{name}'. An array has "
            + "'length' and the methods 'slice', 'toString' and 'hash'.", node.member().span());
        return checker.store().errorType();
    }
    if (core is StringType) {
        if (name == "length") {
            if (position == MemberPosition.Write) {
                reportLengthAssignment(checker, core, node.object(), node.member().span());
                return checker.store().errorType();
            }
            return checker.store().primitive(PrimitiveKind.Long);
        }
        if (types.bindingOf(core) == null) {
            checker.reporter().report("Type 'string' has no member '{name}'.", node.member().span());
            return checker.store().errorType();
        }
    }
    if (core is FunctionType) {
        return operators.reportFunctionMember(checker, name, core, node.member().span());
    }
    if (core is ExternalType) {
        string held = wording.sideNamed(node.object(), "the value");
        checker.reporter().report(typenames.externalMemberMessage(core, held, checker.names()), node.span());
        return checker.store().errorType();
    }
    if (!isRecordLike(core)) {
        checker.reporter().report("Cannot read a member of '{checker.names().of(core)}' because it "
            + "has no members.", node.span());
        return checker.store().errorType();
    }
    switch (lookupMember(checker, core, name)) {
        is FieldMember found -> {
            if (!checkMemberAccess(checker, name, found.field.visibility(),
                    found.field.definingType(), node.member().span())) {
                checker.result().markMemberAccessDenied(node.green());
            }
            return narrowing.narrowedFieldType(checker, node, found.field.type());
        },
        is MethodMember found -> {
            if (found.candidates.length() <= 1) {
                let single = found.candidates.get(0);
                checkMemberAccess(checker, name, single.visibility(), single.definingType(),
                    node.member().span());
            }
            checker.result().setMethod(node.green(), found.candidates.get(0));
            if (position != MemberPosition.Covered) {
                reportMethodAsValue(checker, name, core, found.candidates, node.object(), ".", position,
                    node.member().span(), wanted);
            }
            return checker.store().errorType();
        },
        is MissingMember ignored -> {
            if (reportStaticThroughInstance(checker, core, name, node.object(), node.member().span(),
                    wanted)) {
                return checker.store().errorType();
            }
            if (reportUnmetConstraintMember(checker, core, name, node.member().span())) {
                return checker.store().errorType();
            }
            string refusal = "Type '{checker.names().of(core)}' has no field or method named '{name}'.";
            if (nullguidance.subclassHasMember(checker, core, name)) {
                let guidance = nullguidance.unstableTestGuidance(checker, node.object());
                if (guidance != null) {
                    refusal = refusal + " " + guidance;
                }
            }
            checker.reporter().report(refusal, node.member().span());
            return checker.store().errorType();
        },
    }
}

// Refuses the method 'name' of 'owner' written after 'receiver' and 'access' where a value belongs,
// and where 'wanted' is not null, where a value of that function type is expected.
reportMethodAsValue(BodyChecker checker, string name, Type owner, List<Method> candidates,
                    Expression receiver, string access, MemberPosition position, Span at,
                    FunctionType? wanted = null) {
    string head = name;
    let spelled = wording.shortSpelling(receiver);
    if (spelled != null) {
        head = spelled + access + name;
    }
    string subject = "'{name}' is a method of '{checker.names().of(owner)}'";
    if (wanted != null && position == MemberPosition.Read) {
        let thisType = checker.frame().thisType();
        let fix = functionvalues.lambdaFix(checker, "method", name, functionvalues.signaturesOf(candidates),
            wanted, functionvalues.pathRoot(receiver));
        bool writesLambda = fix.fit() == LambdaFit.Fits || fix.fit() == LambdaFit.Unwritten;
        if (writesLambda && thisType != null && functionvalues.rootsAtStructThis(receiver, thisType)) {
            fix = functionvalues.structThisLambda(checker.names().of(thisType));
            if (checker.lambdaRefusedThis()) {
                fix = functionvalues.refusedLambda();
            }
        } else if (fix.fit() == LambdaFit.Fits
                && (spelled == null || !functionvalues.isRepeatablePath(receiver, thisType))) {
            fix = functionvalues.unwrittenLambda("method");
        }
        checker.reporter().report(functionvalues.functionValueRefusal(subject, fix, head), at);
        return;
    }
    checker.reporter().report(methodAsValueMessage(subject, methodCallText(head, candidates), position), at);
}

// Refuses a write to 'length' on an array or a string. An array keeps the length it was
// created with and a string never changes, so neither holds storage under that name.
reportLengthAssignment(BodyChecker checker, Type holder, Expression array, Span at) {
    if (holder is ArrayType) {
        string example = resizedArrayExample(checker, holder, array);
        let spelled = wording.shortSpelling(array);
        string opening = "'length' is the number of elements in this array";
        if (spelled != null) {
            opening = "'{spelled}.length' is the number of elements in '{spelled}'";
        }
        checker.reporter().report("{opening}, so it cannot be assigned. An array keeps the length it was "
            + "created with. Create a new array of the size you need, {example}.", at);
        return;
    }
    checker.reporter().report("'length' is the number of bytes in the string, so it cannot be assigned. A "
        + "string never changes once it is created, so build the text you need and assign that.", at);
}

// How to create an array of the holder's type at a new size. 'new T[size]' stands alone
// only where a new slot's zero value is a valid element on every level it allocates.
resizedArrayExample(BodyChecker checker, ArrayType holder, Expression array) -> string {
    Type innermost = holder.element();
    string sizes = "[...]";
    while (innermost is ArrayType) {
        innermost = innermost.element();
        sizes = sizes + "[...]";
    }
    if (convert.isDefaultable(innermost)) {
        return "as in 'new {newElementSpelling(checker, innermost)}{sizes}'";
    }
    string shown = checker.names().of(holder);
    string element = newElementSpelling(checker, holder.element());
    string name = resizedName(array);
    return "either by listing every element, as in '[a, b]', or with '{shown} {name} = new "
        + "{element}[size];' followed by 'for (long i = 0; i < {name}.length; i++) \{ "
        + "{name}[i] = ...; \}'";
}

// How a 'new' expression writes an element type before its size. A function type takes parentheses there.
newElementSpelling(BodyChecker checker, Type element) -> string {
    if (element is FunctionType) {
        return "({checker.names().of(element)})";
    }
    return checker.names().of(element);
}

// A static is reachable only through the declaring type's name, so reaching it through an instance
// is an error that names the spelling to use, wherever in the chain the static is declared. 'wanted'
// is the function type expected where it is written. True when it reported.
reportStaticThroughInstance(BodyChecker checker, Type receiver, string name, Expression object, Span at,
                            FunctionType? wanted = null) -> bool {
    Type? current = receiver;
    while (current != null) {
        let statics = staticsNamed(current, name);
        let field = members.findField(typemembers.staticFieldsOf(current), name);
        let authority = types.authorityOf(current);
        if ((statics.length() > 0 || field != null) && authority != null) {
            string ownerName = checker.names().nameOf(authority);
            string value = "this value";
            let spelledObject = wording.shortSpelling(object);
            if (spelledObject != null) {
                value = "the value '{spelledObject}'";
            }
            if (field != null) {
                checker.reporter().report("'{name}' is a {members.typeLevelFieldWord(field)} of "
                    + "'{ownerName}', so it belongs to the type, not to {value}. Write "
                    + "{typenames.qualifiedMemberSpelling(authority, name, checker.names())}.", at);
                return true;
            }
            Type head = staticMethodHead(current, authority);
            string refusal = "'{name}' is a static method of '{ownerName}', so it is called on the type, "
                + "not on {value}.";
            if (wanted != null) {
                let fix = functionvalues.lambdaFix(checker, "method", name,
                    staticmembers.reachedSignatures(checker, statics, wanted), wanted,
                    checker.names().plainNameOf(authority));
                if (fix.fit() != LambdaFit.Called) {
                    string spelling = typenames.qualifiedMemberSpelling(head, name, checker.names(),
                        fix.before(), fix.after());
                    string fixText = functionvalues.nameNotValueText(fix, spelling);
                    checker.reporter().report("{refusal} {fixText}", at);
                    return true;
                }
            }
            let call = new StaticCallText(statics);
            string spelling = typenames.qualifiedMemberSpelling(head, name, checker.names(), call.prefix(),
                call.suffix());
            checker.reporter().report("{refusal} Write {spelling}.", at);
            return true;
        }
        current = hierarchy.baseOf(current);
    }
    return false;
}

public analyzeSafeMemberValue(BodyChecker checker, SafeMemberExpressionNode node,
                              MemberPosition position = MemberPosition.Read) -> Type {
    Type objectType = checker.analyzeExpression(node.object());
    if (objectType is ErrorType) {
        return checker.store().errorType();
    }
    objectType = narrowing.presenceOperandType(checker, node.object(), objectType);
    if (!(objectType is OptionalType)) {
        let spelled = wording.shortSpelling(node.object());
        if (spelled == null) {
            checker.reporter().report("The value before '?.' has type '{checker.names().of(objectType)}', "
                + "which can never be null, so it needs no '?.'. Write '.' instead.", node.span());
        } else {
            checker.reporter().report("'{spelled}' has type '{checker.names().of(objectType)}', which can "
                + "never be null, so it needs no '?.'. Write '{spelled}.{node.member().text()}'.",
                node.span());
        }
        return checker.store().errorType();
    }
    Type inner = objectType.inner();
    if (inner is OptionalType) {
        checker.reporter().report(nullguidance.withGuidance(checker, "'?.' checks for one level of null, but "
            + "the value on its left has type '{checker.names().of(objectType)}', which can be null at more "
            + "than one level.", nullguidance.nullGuidance(checker, node.object(), objectType,
            wording.optionalLevels(objectType) - 1)), node.span());
        return checker.store().errorType();
    }
    string name = node.member().text();
    if ((inner is StringType || inner is ArrayType) && name == "length") {
        if (position == MemberPosition.Write) {
            reportLengthAssignment(checker, inner, node.object(), node.member().span());
            return checker.store().errorType();
        }
        return methodcalls.safeResultOf(checker, checker.store().primitive(PrimitiveKind.Long));
    }
    if (!isRecordLike(inner)) {
        string shownInner = checker.names().of(inner);
        checker.reporter().report("{wording.sideNamed(node.object(), "The value before '?.'")} has type "
            + "'{checker.names().of(objectType)}', and {typenames.typeArticle(shownInner)} '{shownInner}' "
            + "has no members to read with '?.'.", node.span());
        return checker.store().errorType();
    }
    switch (lookupMember(checker, inner, name)) {
        is FieldMember found -> {
            if (!checkMemberAccess(checker, name, found.field.visibility(),
                    found.field.definingType(), node.member().span())) {
                checker.result().markMemberAccessDenied(node.green());
            }
            return methodcalls.safeResultOf(checker, found.field.type());
        },
        is MethodMember found -> {
            if (found.candidates.length() <= 1) {
                let single = found.candidates.get(0);
                checkMemberAccess(checker, name, single.visibility(), single.definingType(),
                    node.member().span());
            }
            checker.result().setMethod(node.green(), found.candidates.get(0));
            if (position != MemberPosition.Covered) {
                reportMethodAsValue(checker, name, inner, found.candidates, node.object(), "?.", position,
                    node.member().span());
            }
            return checker.store().errorType();
        },
        is MissingMember ignored -> {
            if (reportStaticThroughInstance(checker, inner, name, node.object(), node.member().span())) {
                return checker.store().errorType();
            }
            if (reportUnmetConstraintMember(checker, inner, name, node.member().span())) {
                return checker.store().errorType();
            }
            checker.reporter().report("Type '{checker.names().of(inner)}' has no field or method named "
                + "'{name}'.", node.member().span());
            return checker.store().errorType();
        },
    }
}

// A module-qualified name written where a value, a call or a member head belongs, with 'head'
// the module as this file writes it. A module name reaches only that module's functions, so a
// type of that module is refused here whatever follows it.
analyzeNamespaceMemberValue(BodyChecker checker, MemberExpressionNode node, string targetPath, string head,
                            FunctionType? wanted) -> Type {
    string name = node.member().text();
    Span memberSpan = node.member().span();
    let found = checker.store().findDeclared(targetPath, name);
    if (found == null) {
        reportNamespaceMember(checker, targetPath, head, name, memberSpan, wanted);
        return checker.store().errorType();
    }
    if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
            checker.modulePath(), checker.packagePrefix())) {
        checker.reporter().report(types.notVisibleMessage("Type", name, found.visibility(),
            found.modulePath(), found.packagePrefix(), checker.packagePrefix()), memberSpan);
        return checker.store().errorType();
    }
    checker.reporter().report(typenames.moduleQualifiedTypeMessage("{head}.{name}", found, checker.names()),
        node.span());
    return checker.store().errorType();
}

// A module-qualified name in a value position that names no type of that module. 'head' is
// the module as this file writes it, which a call in the message has to keep, and 'wanted' is
// the function type expected where the name is written.
reportNamespaceMember(BodyChecker checker, string targetPath, string head, string name, Span at,
                      FunctionType? wanted) {
    let target = checker.contextsByPath().get(targetPath);
    if (target != null && reportNamespaceFunction(checker, target, head, name, at, wanted)) {
        return;
    }
    checker.reporter().report("'{name}' is not declared in module '{targetPath}'.", at);
}

// Reports a module's function written where a value belongs, or refuses the ones this file
// cannot reach. True when it reported, false when the module declares no function under the
// name.
reportNamespaceFunction(BodyChecker checker, ModuleContext target, string head, string name, Span at,
                        FunctionType? wanted) -> bool {
    let entries = target.functions().entriesNamed(name);
    if (entries == null || entries.length() == 0) {
        return false;
    }
    string targetPath = target.module().canonicalPath();
    string targetPackagePrefix = target.module().packagePrefix();
    let reachable = new List<FunctionEntry>();
    for (let entry in entries) {
        if (types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                checker.modulePath(), checker.packagePrefix())) {
            reachable.push(entry);
        }
    }
    if (reachable.length() == 0) {
        checker.reporter().report(types.notVisibleMessage("Function", name,
            entries.get(0).visibility(), targetPath, targetPackagePrefix,
            checker.packagePrefix()), at);
        return true;
    }
    checker.reportFunctionAsValue("{head}.{name}", reachable, at, head, wanted);
    return true;
}

// The enum a member access's head names, or null where the head names anything else.
enumTypeNamed(BodyChecker checker, NameResolution? resolution) -> EnumType? {
    if (resolution is TypeName) {
        let target = resolution.target();
        if (target is EnumType) {
            return target;
        }
    }
    return null;
}

// Every method the receiver's chain declares under the name, nearest first; a base method whose
// parameter types a derived one repeats is shadowed. Constructors and destructors are not members.
public methodCandidates(Type record, string name) -> List<Method> {
    let found = new List<Method>();
    Type? current = record;
    let seen = new Set<Type>();
    while (current != null && seen.add(current)) {
        let methods = typemembers.methodsOf(current);
        if (methods == null) {
            break;
        }
        long derivedCount = found.length();
        for (long i = 0; i < methods.length(); i++) {
            let candidate = methods.get(i);
            if (candidate.name() != name || candidate.isConstructor() || candidate.isDestructor()) {
                continue;
            }
            bool shadowed = false;
            for (long j = 0; j < derivedCount; j++) {
                if (typemembers.sameParameterTypes(found.get(j).signature(), candidate.signature())) {
                    shadowed = true;
                    break;
                }
            }
            if (!shadowed) {
                found.push(candidate);
            }
        }
        current = hierarchy.baseOf(current);
    }
    return found;
}

// True when a call with this many positional arguments could reach the signature.
fitsArgumentCount(Signature signature, long count) -> bool {
    return count >= calls.requiredArgumentCount(signature) && count <= signature.parameters().length;
}

// "int, string", the way a type-argument vector reads inside angle brackets.
typeArgumentsText(Type[] arguments, TypeNames names) -> string {
    string text = "";
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + names.of(arguments[i]);
    }
    return text;
}

// The type-argument list an example spelling shows: the declaration's own parameter names, so
// 'Pair<A, B>.of(...)' reads against 'Pair<A, B>'.
public typeParameterExample(DeclaredType owner) -> string {
    string[] names = owner.typeParameters();
    string example = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            example = example + ", ";
        }
        example = example + names[i];
    }
    return example;
}

// The statics a type declares under the name. No chain walk: statics are not inherited, so only
// the named type's own list is used.
public staticsNamed(Type owner, string name) -> List<Method> {
    let found = new List<Method>();
    let statics = typemembers.staticMethodsOf(owner);
    if (statics != null) {
        for (long i = 0; i < statics.length(); i++) {
            if (statics.get(i).name() == name) {
                found.push(statics.get(i));
            }
        }
    }
    return found;
}

// The receivers member lookup walks: a declaration's own members, or the members the standard
// library declares for a primitive.
public isRecordLike(Type type) -> bool {
    return type is ClassType || type is InterfaceType || type is StructType
        || type is InstantiationType || types.bindingOf(type) != null;
}

// A name for a replacement array that differs from the array's own name. An array reached
// through no name, such as an element or a call's result, is named 'resized'.
resizedName(Expression array) -> string {
    Expression core = wording.unwrapParentheses(array);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text() + "Resized";
        },
        is MemberExpressionNode member -> {
            return member.member().text() + "Resized";
        },
        default -> {
            return "resized";
        },
    }
}
