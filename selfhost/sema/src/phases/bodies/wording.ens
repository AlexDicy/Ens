// How body diagnostics spell the code they quote, list names, and phrase what a type is.
import Expression from @ens.frontend.syntax.generated.nodes;
import SwitchArm from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SubscriptExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import InterpolatedStringExpressionNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import GreenElement from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import model.typenames;
import TypeNames from model.typenames;
import Type from model.types;
import OptionalType from model.types;
import StringType from model.types;
import model.types;
import model.convert;
import EnumType from model.types;
import List from @std.collections.list;
import support.syntax;
import support.diagnostics;

public isNullLiteral(Expression expression) -> bool {
    return expression is LiteralExpressionNode && expression.value().kind() == SyntaxKind.NullKeyword;
}

// The source spelling of an expression simple enough to quote in an example: a name, 'this',
// a literal, or field and subscript hops over those. Null for anything longer.
public simpleSpelling(Expression expression) -> string? {
    Expression core = syntax.unwrapParentheses(expression);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text();
        },
        is ThisExpressionNode ignored -> {
            return "this";
        },
        is LiteralExpressionNode literal -> {
            return diagnostics.sourceText(literal.value().text());
        },
        is MemberExpressionNode member -> {
            let object = simpleSpelling(member.object());
            if (object == null) {
                return null;
            }
            return "{object}.{member.member().text()}";
        },
        is SubscriptExpressionNode subscript -> {
            let object = simpleSpelling(subscript.object());
            let index = simpleSpelling(subscript.index());
            if (object == null || index == null) {
                return null;
            }
            return "{object}[{index}]";
        },
        default -> {
            return null;
        },
    }
}

// Whether the expression can stand before a '.' in an example without parentheses.
public isSingleTerm(Expression expression) -> bool {
    return simpleSpelling(expression) != null || expression is MemberExpressionNode
        || expression is SubscriptExpressionNode || expression is CallExpressionNode
        || expression is ParenthesizedExpressionNode || expression is InterpolatedStringExpressionNode;
}

// Whether the expression binds less tightly than '??', as an assignment and a '?:' do, so a fallback
// written after it needs it in parentheses.
public bindsLooserThanFallback(Expression expression) -> bool {
    Expression core = syntax.unwrapParentheses(expression);
    return core is AssignmentExpressionNode || core is TernaryExpressionNode;
}

// The source text of 'element' on one line.
public greenSpelling(GreenElement element) -> string {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(element, tokens);
    return spelledTokens(tokens);
}

// The expression's source text on one line, with each gap between tokens turned into one space and
// none next to a bracket.
public oneLineSpelling(Expression expression) -> string {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(expression.green(), tokens);
    return spelledTokens(tokens);
}

// The source text of a switch arm before its '->', on one line.
public armHead(SwitchArm arm) -> string {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(arm.green(), tokens);
    let head = new List<GreenToken>();
    for (long i = 0; i < tokens.length() && tokens.get(i).text() != "->"; i++) {
        head.push(tokens.get(i));
    }
    return spelledTokens(head);
}

// What a refusal calls the '?:' or the switch 'join': "'?:'" or "switch".
public joinName(Expression join) -> string {
    if (syntax.unwrapParentheses(join) is TernaryExpressionNode) {
        return "'?:'";
    }
    return "switch";
}

// The expression's spelling as 'oneLineSpelling' writes it, with 'replacement' written for each use
// of the name 'renamed'. A member or a named argument spelled the same is not a use of it.
public spellingWithName(Expression expression, string renamed, string replacement) -> string {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(expression.green(), tokens);
    return spelledTokens(tokens, renamed, replacement);
}

// The spelling of 'element' as 'greenSpelling' writes it, with the text of the same place in
// 'replacements' written for each node of 'replaced' under it.
public spellingWithNodes(GreenElement element, List<GreenNode> replaced, List<string> replacements)
        -> string {
    let tokens = new List<GreenToken>();
    let written = new List<string>();
    collectReplacedTokens(element, replaced, replacements, tokens, written);
    return spelledTokens(tokens, written: written);
}

// Appends the tokens under 'element' to 'tokens' as collectTokens does, and to 'written' the text
// each one is spelled with: a node of 'replaced' spells its replacement at its first token and
// nothing at the others.
collectReplacedTokens(GreenElement element, List<GreenNode> replaced, List<string> replacements,
        List<GreenToken> tokens, List<string> written) {
    switch (element) {
        is GreenToken token -> {
            tokens.push(token);
            written.push(diagnostics.sourceText(token.text()));
        },
        is GreenNode node -> {
            let index = replaced.indexOf(node);
            if (index >= 0) {
                long first = tokens.length();
                syntax.collectTokens(node, tokens);
                for (long i = first; i < tokens.length(); i++) {
                    written.push(i == first ? replacements.get(index) : "");
                }
                return;
            }
            for (long i = 0; i < node.slotCount(); i++) {
                let slot = node.slot(i);
                if (slot != null) {
                    collectReplacedTokens(slot, replaced, replacements, tokens, written);
                }
            }
        },
        default -> { },
    }
}

// Whether the tokens of 'node' use the name 'name', as 'spellingWithName' finds its uses.
public usesName(GreenElement node, string name) -> bool {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(node, tokens);
    for (long i = 0; i < tokens.length(); i++) {
        if (isNameUse(tokens, i, name)) {
            return true;
        }
    }
    return false;
}

// Whether every use of the name 'name' in 'node' is the object of a member access, as in 'shape.x'.
public usesNameOnlyAsObject(GreenElement node, string name) -> bool {
    let tokens = new List<GreenToken>();
    syntax.collectTokens(node, tokens);
    for (long i = 0; i < tokens.length(); i++) {
        if (!isNameUse(tokens, i, name)) {
            continue;
        }
        string after = i + 1 < tokens.length() ? tokens.get(i + 1).text() : "";
        if (after != "." && after != "?.") {
            return false;
        }
    }
    return true;
}

// Whether token 'index' is a use of the name 'name': that identifier, and neither a member after '.'
// or '?.' nor the label of a named argument.
isNameUse(List<GreenToken> tokens, long index, string name) -> bool {
    let token = tokens.get(index);
    if (token.kind() != SyntaxKind.Identifier || token.text() != name) {
        return false;
    }
    string before = index > 0 ? tokens.get(index - 1).text() : "";
    string after = index + 1 < tokens.length() ? tokens.get(index + 1).text() : "";
    if (before == "." || before == "?.") {
        return false;
    }
    return !(after == ":" && (before == "(" || before == ","));
}

// The tokens' text on one line, spaced as 'oneLineSpelling' spaces them, with 'replacement' written
// for each use of the name 'renamed' when one is given, and each token spelled as 'written' says
// where it is given. An empty token, which the parser inserts for a missing one, spells nothing, and
// so does one written as "", whose spacing still counts.
spelledTokens(List<GreenToken> tokens, string renamed = "", string replacement = "",
        List<string>? written = null) -> string {
    string text = "";
    bool spaced = false;
    string previous = "";
    for (long i = 0; i < tokens.length(); i++) {
        let token = tokens.get(i);
        if (token.contentLength() == 0) {
            continue;
        }
        string current = diagnostics.sourceText(token.text());
        if (written != null) {
            current = written.get(i);
            if (current.length == 0) {
                spaced = spaced || token.fullLength() > token.leadingLength() + token.contentLength();
                continue;
            }
        }
        if (renamed.length > 0 && isNameUse(tokens, i, renamed)) {
            current = replacement;
        }
        bool bracketed = previous == "(" || previous == "[" || current == ")" || current == "]";
        if (text.length > 0 && (spaced || token.leadingLength() > 0) && !bracketed) {
            text = text + " ";
        }
        text = text + current;
        spaced = token.fullLength() > token.leadingLength() + token.contentLength();
        previous = current;
    }
    return text;
}

// The spelling of the value on one line when it is short enough to name in a sentence, or null.
public shortSpelling(Expression node) -> string? {
    string spelled = oneLineSpelling(syntax.unwrapParentheses(node));
    if (spelled.length > namedValueLimit()) {
        return null;
    }
    return spelled;
}

// The value 'node' quoted when its spelling is short, or 'place' otherwise.
public sideNamed(Expression node, string place) -> string {
    let spelled = shortSpelling(node);
    if (spelled == null) {
        return place;
    }
    return "'{spelled}'";
}

// The longest spelling a refusal quotes to name a value in the middle of a sentence.
namedValueLimit() -> long {
    return 30;
}

// The longest code a refusal quotes whole as an example to write.
public quotedCodeLimit() -> long {
    return 40;
}

// The expression converted with 'as' to the type spelled 'type', in parentheses unless it is a
// single term.
public converted(Expression expression, string type) -> string {
    if (isSingleTerm(expression)) {
        return "{oneLineSpelling(expression)} as {type}";
    }
    return "({oneLineSpelling(expression)}) as {type}";
}

// The expression converted to 'double', in parentheses unless it is a single term.
public asDouble(Expression expression) -> string {
    return converted(expression, "double");
}

// The quoted names 'names' as a list: "'a'", "'a' and 'b'", "'a', 'b' and 'c'".
public quotedList(List<string> names) -> string {
    string text = "";
    for (long i = 0; i < names.length(); i++) {
        if (i > 0 && i == names.length() - 1) {
            text = text + " and ";
        } else if (i > 0) {
            text = text + ", ";
        }
        text = text + "'{names.get(i)}'";
    }
    return text;
}

// The sentence, opening with a space, that lists the members of 'enumType', or empty when it has none.
public membersListed(EnumType enumType) -> string {
    let listed = new List<string>();
    for (let name in enumType.memberNames()) {
        listed.push(name);
    }
    if (listed.length() == 0) {
        return "";
    }
    if (listed.length() == 1) {
        return " Its only member is '{listed.get(0)}'.";
    }
    return " Its members are {quotedList(listed)}.";
}

// How many '?' levels the type has. Each level takes its own null check.
public optionalLevels(Type type) -> long {
    long levels = 0;
    Type current = type;
    while (current is OptionalType) {
        current = current.inner();
        levels++;
    }
    return levels;
}

// The sentence that says a literal takes its type from 'from', whose type is 'type'.
public takesTypeFrom(string from, Type type, TypeNames names) -> string {
    return "{takesTypeClause(from, type, names)}.";
}

// The sentence of 'takesTypeFrom' without its full stop, for a clause to follow it.
public takesTypeClause(string from, Type type, TypeNames names) -> string {
    return "The literal takes its type from {from}, {typenames.typeArticle(names.of(type))} "
        + "{names.quoted(type)}";
}

// The literal a fix writes for a value of 'type' where no particular value is meant, or null where
// no literal has the type: null, "", false, 0 and 0.0.
public placeholderLiteral(Type type) -> string? {
    if (type is OptionalType) {
        return "null";
    }
    if (type is StringType) {
        return "\"\"";
    }
    if (convert.isBoolType(type)) {
        return "false";
    }
    if (convert.isIntegerType(type) && !types.isCharType(type)) {
        return "0";
    }
    if (convert.isTextualFloat(type)) {
        return "0.0";
    }
    return null;
}
