import TypeArgumentInference from phases.inference;
import phases.prelude;
import model.convert;
import model.literalvalues;
import OriginKind from phases.bodies.literaltargets;
import LiteralOrigin from phases.bodies.literaltargets;
import DeferredLiteralFix from phases.bodies.literaltargets;
import phases.bodies.staticmembers;
import NamePosition from phases.bodies.memberaccess;
import phases.bodies.assignments;
import phases.bodies.lambdas;
import phases.bodies.interfacebounds;
import phases.bodies.literalfixes;
import phases.bodies.valuejoins;
import phases.bodies.literaltyping;
