// Calls of a function, a generic or external function, a function value or a module's function, and
// 'try': the shape of a call's arguments, the check of each argument against the parameter chosen for
// it, and the texts that spell arguments in a refusal.
import Expression from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import Argument from @ens.frontend.syntax.generated.nodes;
import OutArgumentNode from @ens.frontend.syntax.generated.nodes;
import NamedArgumentNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArrayLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import TryExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import support.diagnostics;
import FunctionEntry from context;
import phases.calls;
import ArgumentValue from phases.calls;
import CallShape from phases.calls;
import CallCandidate from phases.calls;
import CallResolution from phases.calls;
import TypeArgumentInference from phases.inference;
import phases.prelude;
import model.convert;
import model.literalvalues;
import OriginKind from phases.bodies.literaltargets;
import LiteralOrigin from phases.bodies.literaltargets;
import DeferredLiteralFix from phases.bodies.literaltargets;
import phases.bodies.staticmembers;
import NamePosition from phases.bodies.memberaccess;
import phases.bodies.assignments;
import phases.bodies.literalfixes;
import phases.bodies.valuejoins;
import phases.bodies.literaltyping;
import phases.bodies.nullguidance;
import phases.bodies.wording;
import phases.bodies.argumentshapes;
import ArgumentShape from phases.calls;
import model.typemembers;
import Parameter from model.typemembers;
import Signature from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import FunctionType from model.types;
import PrimitiveKind from model.types;
import ExternalType from model.types;
import InstantiationType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import phases.bodies.methodcalls;
import phases.bodies.identifiers;
import phases.bodies.construction;
import BodyChecker from phases.bodies;
import LocalName from phases.bodies;
import TypeParameterName from phases.bodies;
import FunctionName from phases.bodies;
import TypeName from phases.bodies;
import NamespaceName from phases.bodies;

// The parameter a call's resolution chose for the argument at 'span'.
public final class ChosenParameter {
    protected Span span;
    protected LiteralOrigin origin;

    protected constructor(this.span, this.origin);
}

// The call shape paired with each argument's written expression, positional first and named
// after, so resolved calls can adapt literals in place. An 'out' misuse leaves a null hole.
public final class BuiltShape {
    protected CallShape callShape;
    protected List<Expression?> values;

    public constructor(this.callShape, this.values);

    public shape() -> CallShape {
        return this.callShape;
    }
}

public analyzeTry(BodyChecker checker, TryExpressionNode node) -> Type {
    if (!(node.operand() is CallExpressionNode)) {
        checker.reporter().report(misplacedTryRefusal(node.operand()), node.span());
    }
    Type analyzed = checker.analyzeExpression(node.operand());
    checker.assignment().noteThrowEscapePoint(checker.frame().inCatchClause());
    return analyzed;
}

// With a 'single' candidate, an argument holding a literal too large for 'float' waits for its
// parameter, so its refusal can name it.
public buildCallShape(BodyChecker checker, ArgumentListNode arguments, bool single) -> BuiltShape {
    let shape = new CallShape();
    shape.setLocalNamer((base) -> nullguidance.freeLocalName(checker, "", base));
    let positionalValues = new List<Expression?>();
    let namedValues = new List<Expression?>();
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                string name = named.name().text();
                for (long j = 0; j < shape.named().length(); j++) {
                    if (shape.named().get(j).name() == name) {
                        checker.reporter().report("Argument '{name}' is named twice in this call. Remove "
                            + "one of the two.", named.name().span());
                        shape.markMalformed();
                        break;
                    }
                }
                let shaped = shapedArgumentOf(checker, name, named.value(), single);
                if (shaped != null) {
                    if (shaped.holdsError()) {
                        shape.markErrorArgument();
                    }
                    shape.named().push(shaped);
                } else if (single && carriesOverflowingFloat(named.value())) {
                    shape.named().push(targetTypedArgument(checker, name, named.value()));
                } else {
                    bool outerAwaiting = checker.targets().awaitingParameter();
                    checker.targets().setAwaitingParameter(!single);
                    Type analyzed = checker.analyzeExpression(named.value());
                    checker.targets().setAwaitingParameter(outerAwaiting);
                    checker.result().setType(named.green(), analyzed);
                    if (analyzed is ErrorType) {
                        shape.markErrorArgument();
                    }
                    shape.named().push(argumentValueOf(checker, name, named.value(), analyzed));
                }
                namedValues.push(named.value());
            },
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
                shape.markErrorArgument();
                shape.positional().push(new ArgumentValue("", checker.store().errorType(),
                    false, false, 0, false, outArgument.span()));
                positionalValues.push(null);
            },
            is Expression value -> {
                if (shape.named().length() > 0 && !shape.isMalformed()) {
                    string move = "";
                    let firstNamed = arguments.arguments(0);
                    for (long j = 0; j < i; j++) {
                        if (arguments.arguments(j) is NamedArgumentNode) {
                            firstNamed = arguments.arguments(j);
                            break;
                        }
                    }
                    let spelledValue = wording.shortSpelling(value);
                    string spelledNamed = argumentSpelling(firstNamed);
                    if (spelledValue != null && spelledNamed.length <= 30) {
                        move = " Move '{spelledValue}' before '{spelledNamed}'.";
                    }
                    checker.reporter().report("Positional arguments must come before named ones.{move}",
                        value.span());
                    shape.markMalformed();
                }
                let shaped = shapedArgumentOf(checker, "", value, single);
                if (shaped != null) {
                    if (shaped.holdsError()) {
                        shape.markErrorArgument();
                    }
                    shape.positional().push(shaped);
                } else if (single && carriesOverflowingFloat(value)) {
                    shape.positional().push(targetTypedArgument(checker, "", value));
                } else {
                    bool outerAwaiting = checker.targets().awaitingParameter();
                    checker.targets().setAwaitingParameter(!single);
                    Type analyzed = checker.analyzeExpression(value);
                    checker.targets().setAwaitingParameter(outerAwaiting);
                    if (analyzed is ErrorType) {
                        shape.markErrorArgument();
                    }
                    shape.positional().push(argumentValueOf(checker, "", value, analyzed));
                }
                positionalValues.push(value);
            },
            default -> { },
        }
    }
    let values = new List<Expression?>();
    for (long i = 0; i < positionalValues.length(); i++) {
        values.push(positionalValues.get(i));
    }
    for (long i = 0; i < namedValues.length(); i++) {
        values.push(namedValues.get(i));
    }
    return new BuiltShape(shape, values);
}

// The argument 'value' shaped by what is written, with its parts analyzed as the call's other arguments
// are, or null where it has a type of its own.
shapedArgumentOf(BodyChecker checker, string name, Expression value, bool single) -> ArgumentValue? {
    bool outerAwaiting = checker.targets().awaitingParameter();
    checker.targets().setAwaitingParameter(!single);
    let shaped = argumentshapes.shapedArgument(checker, name, value);
    checker.targets().setAwaitingParameter(outerAwaiting);
    return shaped;
}

// Resolves the call over 'candidates'. Where none is chosen, a method or function name among the
// arguments is refused on its own, because resolution reports nothing for a call that passes one.
public resolveBuiltCall(BodyChecker checker, List<CallCandidate> candidates, BuiltShape built, Span span,
                        string displayName, string kindWord) -> CallResolution {
    let resolution = calls.resolveCall(candidates, built.shape(), checker.reporter(), span, displayName,
        kindWord, checker.names());
    if (resolution.failed()) {
        for (long i = 0; i < built.values.length(); i++) {
            let value = built.values.get(i);
            if (value != null) {
                refuseHeldNames(checker, built.shape().argumentAt(i), value);
            }
        }
    }
    return resolution;
}

// Analyzes each method or function name 'argument' holds with no function type to fit, which refuses it.
refuseHeldNames(BodyChecker checker, ArgumentValue argument, Expression value) {
    if (argument.shape() == ArgumentShape.Name) {
        checker.analyzeExpression(value);
        return;
    }
    let array = wording.unwrapParentheses(value);
    if (argument.shape() == ArgumentShape.ArrayLiteral && array is ArrayLiteralExpressionNode) {
        for (long i = 0; i < array.elementsCount(); i++) {
            refuseHeldNames(checker, argument.elements()[i], array.elements(i));
        }
    }
}

// An argument whose type only the parameter it is passed to determines, left unanalyzed until the
// candidate is chosen.
targetTypedArgument(BodyChecker checker, string name, Expression value) -> ArgumentValue {
    let argument = new ArgumentValue(name, checker.store().errorType(), false, false, 0, false, value.span());
    argument.markNeedsTarget();
    return argument;
}

public argumentValueOf(BodyChecker checker, string name, Expression value, Type analyzed) -> ArgumentValue {
    let literal = literaltyping.intLiteralOf(value);
    if (literal != null) {
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        if (magnitude != null) {
            return new ArgumentValue(name, analyzed, true, literaltyping.isNegativeLiteral(value),
                magnitude, false, value.span());
        }
    }
    if (value is LiteralExpressionNode && value.value().kind() == SyntaxKind.CharLiteral) {
        return new ArgumentValue(name, analyzed, false, false,
            literalvalues.charCodepoint(value.value().text()), true, value.span());
    }
    let plain = new ArgumentValue(name, analyzed, false, false, 0, false, value.span());
    let floatLiteral = literaltyping.floatLiteralOf(value);
    if (floatLiteral != null) {
        plain.markFloatLiteral(literalvalues.floatMagnitude(floatLiteral.value().text()));
    }
    return plain;
}

// Final argument checking against the chosen candidate: adapt untyped literals to the
// parameter types and verify assignability, mirroring the single-candidate path.
public checkResolvedArguments(BodyChecker checker, BuiltShape built, CallResolution resolution,
                              GreenNode callNode) -> Type {
    let chosen = resolution.chosen();
    if (chosen == null) {
        return checker.store().errorType();
    }
    Parameter[] parameters = chosen.signature().parameters();
    long[] mapping = resolution.mapping();
    let shape = built.shape();
    string constructed = "";
    let method = chosen.method();
    if (method != null && method.isConstructor()) {
        constructed = checker.names().quoted(method.definingType());
    }
    for (long i = 0; i < shape.argumentCount() && i < mapping.length; i++) {
        let argument = shape.argumentAt(i);
        Type parameterType = parameters[mapping[i]].type();
        Type finalType = argument.type();
        let value = built.values.get(i);
        if (value != null) {
            let chosenOrigin = new LiteralOrigin(OriginKind.Parameter, parameters[mapping[i]].name(),
                chosen.signature().name(), parameterType);
            chosenOrigin.setQuotedConstructed(constructed);
            checker.targets().chosenParameters().push(new ChosenParameter(value.span(), chosenOrigin));
        }
        if (value != null && argument.needsTarget()) {
            finalType = checker.analyzeExpressionAdapt(value, parameterType,
                literalfixes.argumentOrigin(checker, value, chosen.signature(), mapping[i], parameterType,
                    constructed));
        } else if (value != null) {
            let origin = literalfixes.argumentOrigin(checker, value, chosen.signature(), mapping[i],
                parameterType, constructed);
            literaltyping.adaptIntegerLiteral(checker, value, parameterType, origin);
            literaltyping.adaptCharLiteral(checker, value, parameterType, origin);
            literaltyping.adaptFloatLiteral(checker, value, parameterType, origin);
            let updated = checker.result().typeOf(value.green());
            if (updated != null) {
                finalType = updated;
            }
        }
        if (parameterType is ErrorType || finalType is ErrorType) {
            continue;
        }
        if (!convert.isAssignableStrict(parameterType, finalType)) {
            string label = "{i + 1}";
            if (argument.name().length > 0) {
                label = "'{argument.name()}'";
            }
            string callee = "'{chosen.signature().name()}'";
            if (constructed.length > 0) {
                callee = "the constructor of {constructed}";
            }
            checker.reporter().report(argumentMismatch(label, callee, parameters[mapping[i]].name(),
                parameterType, finalType, checker.names())
                + "{nullguidance.valueAssignabilityHint(checker, parameterType, finalType, value)}",
                argument.span());
        }
    }
    if (shape.named().length() > 0) {
        checker.result().setArgumentOrder(callNode, mapping);
    }
    return chosen.signature().returnType();
}

// Argument count and type checking against a single known signature. 'constructed' quotes the
// type a constructor builds, with its type arguments.
public checkDirectArguments(BodyChecker checker, string kindWord, string displayName, Signature signature,
                            ArgumentListNode arguments, Span callSpan,
                            string constructed = "") -> Type {
    Parameter[] parameters = signature.parameters();
    long count = arguments.argumentsCount();
    long required = calls.requiredArgumentCount(signature);
    if (count < required || count > parameters.length) {
        checker.reporter().report(calls.arityRefusal(calls.calleeSubject(kindWord, displayName), signature,
            count), callSpan);
    }
    for (long i = 0; i < count; i++) {
        switch (arguments.arguments(i)) {
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                if (i < parameters.length) {
                    Type parameterType = parameters[i].type();
                    Type actual = checker.analyzeExpressionAdapt(value, parameterType,
                        literalfixes.argumentOrigin(checker, value, signature, i, parameterType,
                            constructed));
                    if (!(parameterType is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(parameterType, actual)) {
                        checker.reporter().report(argumentMismatch("{i + 1}",
                            calleeObject(kindWord, displayName), parameters[i].name(), parameterType,
                            actual, checker.names())
                            + "{nullguidance.valueAssignabilityHint(checker, parameterType, actual, value)}",
                            value.span());
                    }
                } else {
                    checker.analyzeExpression(value);
                }
            },
            default -> { },
        }
    }
    return signature.returnType();
}

public analyzeArgumentsOnly(BodyChecker checker, ArgumentListNode arguments) {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                checker.analyzeExpression(named.value());
            },
            is Expression value -> {
                checker.analyzeExpression(value);
            },
            default -> { },
        }
    }
}

// The refusals held inside a call's arguments stay held only for an argument whose type reaches
// the call's result. The others are reported, since no enclosing join changes their fix.
public analyzeCall(BodyChecker checker, CallExpressionNode node, Type? expected) -> Type {
    let outerDeferred = checker.targets().deferredFixes();
    let held = new List<DeferredLiteralFix>();
    checker.targets().setDeferredFixes(held);
    let outerFlowing = checker.targets().flowingArguments();
    checker.targets().setFlowingArguments(new List<Span>());
    bool outerAwaiting = checker.targets().awaitingParameter();
    checker.targets().setAwaitingParameter(false);
    let outerChosen = checker.targets().chosenParameters();
    checker.targets().setChosenParameters(new List<ChosenParameter>());
    Type called = analyzeCallOf(checker, node, expected);
    noteFlowingMethodArguments(checker, node);
    settleParameters(checker, held);
    let flowing = checker.targets().flowingArguments();
    checker.targets().setFlowingArguments(outerFlowing);
    checker.targets().setAwaitingParameter(outerAwaiting);
    checker.targets().setChosenParameters(outerChosen);
    checker.targets().setDeferredFixes(outerDeferred);
    settleArguments(checker, held, outerDeferred, flowing, false);
    return called;
}

// Settles the refusals held for arguments of a call with several candidates against the
// parameter the chosen candidate gave them. Beside a parameter of the literal's type the fix names the
// parameter, and with no candidate chosen the refusal ends after the why.
public settleParameters(BodyChecker checker, List<DeferredLiteralFix> held) {
    for (let fix in held) {
        if (!fix.awaitingParameter()) {
            continue;
        }
        fix.setAwaitingParameter(false);
        LiteralOrigin? origin = null;
        for (let chosen in checker.targets().chosenParameters()) {
            if (fix.span().start >= chosen.span.start && fix.span().end() <= chosen.span.end()) {
                origin = chosen.origin;
            }
        }
        let suffixed = fix.suffixed();
        if (origin == null) {
            fix.setMessage(fix.plain());
            continue;
        }
        let widening = fix.widening() ?? valuejoins.floatWidening();
        string declared = literalfixes.originType(checker, origin);
        string quotedDeclared = literalfixes.quotedOriginType(checker, origin);
        if (literalfixes.isFloatCore(origin.declared()) && suffixed != null) {
            string noun = literalfixes.parameterNoun(origin);
            suffixed.setFix("The '{fix.suffix()}' makes the literal a 'float', and {noun} is a "
                + "{quotedDeclared} too.");
        } else if (literalfixes.sameCore(origin.declared(), widening) && !fix.settled()
                && fix.clause().length > 0 && fix.message() != fix.plain()) {
            fix.setMessage("{fix.refusal()} {fix.clause()}, and {literalfixes.parameterNoun(origin)} is "
                + "{typenames.typeArticle(declared)} {quotedDeclared} too.");
        } else if (!literalfixes.takesLiteral(origin.declared(), widening)) {
            fix.setMessage(fix.plain());
        }
    }
}

// Records the arguments of a method call that reach its result: those whose declared parameter
// type has a type parameter while the declared return type has one too. A generic instance's
// methods are judged as its template declares them.
noteFlowingMethodArguments(BodyChecker checker, CallExpressionNode node) {
    let access = nullguidance.accessStep(wording.unwrapParentheses(node.callee()));
    if (access == null) {
        return;
    }
    let name = access.member();
    Type receiver = convert.coreOf(checker.recordedType(access.receiver()));
    if (receiver is InstantiationType) {
        receiver = receiver.template();
    }
    let methods = typemembers.methodsOf(receiver);
    if (name == null || methods == null) {
        return;
    }
    let arguments = node.arguments();
    for (let method in methods) {
        Signature signature = method.signature();
        if (method.name() != name || !convert.containsTypeParam(signature.returnType())) {
            continue;
        }
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    for (let parameter in parameters) {
                        if (parameter.name() == named.name().text()
                                && convert.containsTypeParam(parameter.type())) {
                            checker.targets().flowingArguments().push(named.span());
                        }
                    }
                },
                is Expression value -> {
                    if (i < parameters.length && convert.containsTypeParam(parameters[i].type())) {
                        checker.targets().flowingArguments().push(value.span());
                    }
                },
                default -> { },
            }
        }
    }
}

// Passes the refusals held inside a call to 'outer' when they lie in one of the 'flowing'
// arguments, or in any argument when 'all' is true, and reports the others.
public settleArguments(BodyChecker checker, List<DeferredLiteralFix> held, List<DeferredLiteralFix>? outer,
                       List<Span> flowing, bool all) {
    for (let fix in held) {
        if (outer == null) {
            if (fix.suffixed() == null) {
                checker.reporter().report(fix.message(), fix.span());
            }
            continue;
        }
        bool flows = all;
        for (let argument in flowing) {
            if (fix.span().start >= argument.start && fix.span().end() <= argument.end()) {
                flows = true;
            }
        }
        if (flows) {
            outer.push(fix);
        } else if (fix.suffixed() == null) {
            checker.reporter().report(fix.message(), fix.span());
        }
    }
}

analyzeCallOf(BodyChecker checker, CallExpressionNode node, Type? expected) -> Type {
    switch (node.callee()) {
        is MemberExpressionNode member -> {
            return methodcalls.analyzeMemberCall(checker, node, member, expected);
        },
        is SafeMemberExpressionNode member -> {
            return methodcalls.analyzeSafeMemberCall(checker, node, member);
        },
        is SuperExpressionNode chained -> {
            return methodcalls.analyzeSuperCall(checker, node, chained);
        },
        is IdentifierExpressionNode identifier -> {
            return analyzeFunctionCall(checker, node, identifier);
        },
        default -> {
            Type calleeType = checker.analyzeExpression(node.callee());
            if (convert.coreOf(calleeType) is FunctionType) {
                return analyzeFunctionValueCall(checker, node, calleeType, "", node.callee().span());
            }
            if (!(calleeType is ErrorType)) {
                checker.reporter().report("{wording.sideNamed(node.callee(), "This value")} has type "
                    + "{checker.names().quoted(calleeType)}, which is not a function type, so it cannot "
                    + "be called.", node.span());
            }
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
    }
}

// A call on a function value: ordinary call syntax on the value itself. A function type has
// no parameter names, so the arguments are positional and the call takes exactly as many as
// the type declares.
public analyzeFunctionValueCall(BodyChecker checker, CallExpressionNode node, Type calleeType,
                                string calleeName, Span calleeSpan) -> Type {
    string subject = "This function value";
    if (calleeName.length > 0) {
        subject = "'{calleeName}'";
    }
    let typeArguments = node.typeArguments();
    if (typeArguments != null) {
        checker.reporter().report("A function value takes no type arguments; its type "
            + "{checker.names().quoted(calleeType)} is already fixed. Remove the '<...>' list.",
            typeArguments.span());
    }
    if (calleeType is OptionalType) {
        checker.reporter().report(nullguidance.maybeNullRefusal(checker, "{subject} has type "
            + "{checker.names().quoted(calleeType)}, which", node.callee(), calleeType), calleeSpan);
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    if (!(calleeType is FunctionType)) {
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    Type[] parameters = calleeType.parameterTypes();
    let arguments = node.arguments();
    long count = arguments.argumentsCount();
    if (count != parameters.length) {
        string[] unnamed = [];
        string quotedCallee = checker.names().quoted(calleeType);
        checker.reporter().report(calls.countRefusal("{subject} has type {quotedCallee}, "
            + "so it takes", parameters.length, parameters.length, count, "argument", unnamed),
            node.span());
    }
    for (long i = 0; i < count; i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                checker.reporter().report("A function type has no parameter names, so a function "
                    + "value takes its arguments by position. Write the values in order, "
                    + "without '{named.name().text()}:'.", named.span());
                checker.analyzeExpression(named.value());
            },
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                if (i < parameters.length) {
                    Type parameterType = parameters[i];
                    LiteralOrigin? origin = null;
                    if (valuejoins.mayAdaptLiteral(value)) {
                        origin = new LiteralOrigin(OriginKind.Parameter, "", calleeName, parameterType);
                    }
                    Type actual = checker.analyzeExpressionAdapt(value, parameterType, origin);
                    if (!(parameterType is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(parameterType, actual)) {
                        checker.reporter().report(argumentMismatch("{i + 1}",
                            identifiers.functionValueName(checker, calleeName), "", parameterType, actual,
                            checker.names())
                            + "{nullguidance.valueAssignabilityHint(checker, parameterType, actual, value)}",
                            value.span());
                    }
                } else {
                    checker.analyzeExpression(value);
                }
            },
            default -> { },
        }
    }
    return calleeType.returnType();
}

analyzeFunctionCall(BodyChecker checker, CallExpressionNode node, IdentifierExpressionNode identifier)
                    -> Type {
    string name = identifier.name().text();
    let primitive = types.primitiveNamed(checker.store(), name);
    if (primitive != null) {
        identifiers.reportTypeAsCall(checker, name, primitive, identifier.span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    let resolution = checker.resolveName(name);
    if (resolution == null) {
        if (identifiers.isRefusedImport(checker, name)) {
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        let ownerName = identifiers.staticSuggestionOwner(checker, name);
        if (ownerName != null) {
            checker.reporter().report(identifiers.staticWithoutType(checker, name, ownerName, true),
                identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        let kept = checker.preludeScope().hidden(name, checker.modulePath(), checker.packagePrefix());
        if (kept != null) {
            checker.reporter().report(types.notVisibleMessage("Function", name, kept.visibility(),
                kept.modulePath(), kept.packagePrefix(), checker.packagePrefix()),
                identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        checker.reporter().report("Undefined function '{name}'. Check the spelling, or import "
            + "the module that declares it.", identifier.span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    switch (resolution) {
        is FunctionName functions -> {
            let offered = functions.fromPrelude();
            if (offered != null && offered.isAmbiguous()) {
                checker.reporter().report(prelude.ambiguousMessage(name, offered.modulePaths()),
                    identifier.span());
                analyzeArgumentsOnly(checker, node.arguments());
                return checker.store().errorType();
            }
            return dispatchFunctionCall(checker, node, identifier, name, functions.entries());
        },
        is TypeName named -> {
            if (types.isStructLike(named.target())) {
                return construction.analyzeStructConstructorCall(checker, node, named.target(), name);
            }
            identifiers.reportTypeAsCall(checker, name, named.target(), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is TypeParameterName held -> {
            identifiers.reportTypeParameterRefusal(checker, "'{name}' is a type parameter, not a function.",
                held.parameter(), identifier.span(), NamePosition.Call);
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is LocalName ignored -> {
            Type calleeType = checker.analyzeExpression(identifier);
            if (convert.coreOf(calleeType) is FunctionType) {
                return analyzeFunctionValueCall(checker, node, calleeType, name, identifier.span());
            }
            if (!(calleeType is ErrorType)) {
                checker.reporter().report("'{name}' has type {checker.names().quoted(calleeType)}, "
                    + "which is not a function type, so it cannot be called.",
                    identifier.span());
            }
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is NamespaceName module -> {
            identifiers.reportModuleAsCall(checker, name, module.targetModulePath(), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
    }
}

dispatchFunctionCall(BodyChecker checker, CallExpressionNode node, IdentifierExpressionNode identifier,
                     string name, List<FunctionEntry> entries) -> Type {
    let first = entries.get(0);
    if (first.isExternal()) {
        checker.result().setCallable(identifier.green(), first.signature());
        return analyzeExternalCall(checker, node, first, name);
    }
    if (first.signature().isGeneric()) {
        checker.result().setCallable(identifier.green(), first.signature());
        return analyzeGenericCall(checker, node, first, name);
    }
    if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
        let built = buildCallShape(checker, node.arguments(), entries.length() == 1);
        let candidates = new List<CallCandidate>();
        for (long i = 0; i < entries.length(); i++) {
            candidates.push(new CallCandidate(entries.get(i).signature(), null, true));
        }
        let resolved = resolveBuiltCall(checker, candidates, built, node.span(), name, "Function");
        if (resolved.failed()) {
            return checker.store().errorType();
        }
        let chosen = resolved.chosen();
        if (chosen != null) {
            checker.result().setCallable(identifier.green(), chosen.signature());
        }
        return checkResolvedArguments(checker, built, resolved, node.green());
    }
    checker.result().setCallable(identifier.green(), first.signature());
    return checkDirectArguments(checker, "Function", name, first.signature(), node.arguments(), node.span());
}

// A namespace-qualified free-function call, or null when the member is not a function of
// the target module (the member then resolves as a type reference).
public analyzeNamespaceFunctionCall(BodyChecker checker, CallExpressionNode node, MemberExpressionNode member,
                                    string targetPath, string memberName) -> Type? {
    let target = checker.contextsByPath().get(targetPath);
    if (target == null) {
        return null;
    }
    let entries = target.functions().entriesNamed(memberName);
    if (entries == null || entries.length() == 0) {
        return null;
    }
    string targetPackagePrefix = target.module().packagePrefix();
    if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
        let built = buildCallShape(checker, node.arguments(), entries.length() == 1);
        let candidates = new List<CallCandidate>();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            candidates.push(new CallCandidate(entry.signature(), null,
                types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                    checker.modulePath(), checker.packagePrefix())));
        }
        let resolved = resolveBuiltCall(checker, candidates, built,
            node.span(), memberName, "Function");
        if (resolved.failed()) {
            return checker.store().errorType();
        }
        let chosen = resolved.chosen();
        if (chosen == null) {
            return checker.store().errorType();
        }
        checker.result().setCallable(member.green(), chosen.signature());
        if (!chosen.isAccessible()) {
            Visibility chosenVisibility = Visibility.Private;
            for (long i = 0; i < entries.length(); i++) {
                if (entries.get(i).signature() == chosen.signature()) {
                    chosenVisibility = entries.get(i).visibility();
                }
            }
            checker.reporter().report(types.notVisibleMessage("Function", memberName,
                chosenVisibility, targetPath, targetPackagePrefix, checker.packagePrefix()),
                member.member().span());
            return checker.store().errorType();
        }
        return checkResolvedArguments(checker, built, resolved, node.green());
    }
    let entry = entries.get(0);
    if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
            checker.modulePath(), checker.packagePrefix())) {
        checker.reporter().report(types.notVisibleMessage("Function", memberName,
            entry.visibility(), targetPath, targetPackagePrefix, checker.packagePrefix()),
            member.member().span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    checker.result().setCallable(member.green(), entry.signature());
    if (entry.isExternal()) {
        return analyzeExternalCall(checker, node, entry, memberName);
    }
    if (targetPath == "std.ffi" && memberName == "fromCString") {
        return checkFromCStringCall(checker, node.arguments(), node.span());
    }
    if (entry.signature().isGeneric()) {
        return analyzeGenericCall(checker, node, entry, memberName);
    }
    return checkDirectArguments(checker, "Function", memberName, entry.signature(),
        node.arguments(), node.span());
}

// std.ffi.fromCString accepts a value of any external type - there is no common supertype to
// write in its signature, hence the intercepted type parameter - and returns a string?. A null
// handle yields a null string, so an unset value stays distinct from an empty one. Because the
// call is checked here it is never routed through generic instantiation.
checkFromCStringCall(BodyChecker checker, ArgumentListNode arguments, Span callSpan) -> Type {
    Type result = checker.store().optionalOf(checker.store().stringType());
    long count = arguments.argumentsCount();
    if (count != 1) {
        checker.reporter().report(fromCStringCountRefusal(count), callSpan);
        analyzeArgumentsOnly(checker, arguments);
        return result;
    }
    switch (arguments.arguments(0)) {
        is OutArgumentNode outArgument -> {
            checker.reporter().report("'out' can only be used when calling an external "
                + "function. Remove 'out' from the argument.", outArgument.span());
        },
        is Expression value -> {
            Type actual = checker.analyzeExpression(value);
            Type base = actual;
            if (base is OptionalType) {
                base = base.inner();
            }
            if (!(actual is ErrorType) && !(base is ExternalType)) {
                checker.reporter().report("'fromCString' takes a value of an external type, but "
                    + "{wording.sideNamed(value, "this value")} has type {checker.names().quoted(actual)}. "
                    + "Pass it the value a C function returned.", value.span());
            }
        },
        default -> { },
    }
    return result;
}

analyzeGenericCall(BodyChecker checker, CallExpressionNode node, FunctionEntry entry, string name) -> Type {
    let signature = entry.signature();
    let arguments = node.arguments();
    Parameter[] declared = signature.parameters();
    bool genericResult = convert.containsTypeParam(signature.returnType());
    for (long i = 0; i < arguments.argumentsCount() && i < declared.length; i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression && genericResult && convert.containsTypeParam(declared[i].type())) {
            checker.targets().flowingArguments().push(argument.span());
        }
    }
    if (usesNamedArguments(arguments)) {
        checker.reporter().report("'{name}' is generic, and a call to a generic function cannot name its "
            + "arguments. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
            node.span());
        analyzeArgumentsOnly(checker, arguments);
        return checker.store().errorType();
    }
    let owner = signature.declaration();
    if (owner == null) {
        return signature.returnType();
    }
    let typeParameters = signature.typeParameters();
    long arity = typeParameters.length;
    let typeArguments = new List<Type?>();
    for (long i = 0; i < arity; i++) {
        typeArguments.push(null);
    }
    let explicitList = node.typeArguments();
    if (explicitList != null) {
        long given = explicitList.argumentsCount();
        if (given != arity) {
            let names = new List<string>();
            for (let parameter in typeParameters) {
                names.push(parameter.name());
            }
            checker.reporter().report(calls.countRefusal("Generic function '{name}' takes", arity, arity,
                given, "type argument", names.toArray()), node.span());
            analyzeArgumentsOnly(checker, arguments);
            return checker.store().errorType();
        }
        for (long i = 0; i < arity; i++) {
            typeArguments.set(i, checker.resolver().resolveType(explicitList.arguments(i)));
        }
    }

    // A value with no type of its own, a lambda or an aggregate literal, waits for the
    // parameter it fills, which is known once the type arguments are resolved. It offers
    // nothing to infer them from either.
    let argumentTypes = new List<Type>();
    bool refusedArgument = false;
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression && !waitsForParameter(argument, explicitList != null)) {
            Type analyzed = checker.analyzeExpression(argument);
            refusedArgument = refusedArgument || analyzed is ErrorType;
            argumentTypes.push(analyzed);
        } else {
            argumentTypes.push(checker.store().errorType());
        }
    }

    Parameter[] parameters = signature.parameters();
    let inference = new TypeArgumentInference(checker.store(), owner, arity);
    if (explicitList == null) {
        for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
            inference.unifyArgument(i, parameters[i].type(), argumentTypes.get(i));
        }
        for (long i = 0; i < arity; i++) {
            typeArguments.set(i, inference.binding(i));
        }
    }

    let resolved = new List<Type>();
    for (long i = 0; i < arity; i++) {
        let argument = typeArguments.get(i);
        if (argument == null && refusedArgument) {
            return checker.store().errorType();
        }
        if (argument == null) {
            let written = new List<string>();
            for (long j = 0; j < arity; j++) {
                let known = typeArguments.get(j);
                if (known != null && checker.names().canSpell(known)) {
                    written.push(checker.names().of(known));
                } else {
                    written.push(staticmembers.exampleTypeArgument(node.arguments()));
                }
            }
            string listed = "";
            for (long j = 0; j < written.length(); j++) {
                if (j > 0) {
                    listed = listed + ", ";
                }
                listed = listed + written.get(j);
            }
            string write = "Write it";
            if (arity > 1) {
                write = "Write its type arguments";
            }
            checker.reporter().report("'{name}' is generic, and this call does not show what its type "
                + "argument '{typeParameters[i].name()}' is. {write}, as in "
                + "'{name}<{listed}>{argumentsSpelling(node.arguments())}'.", node.span());
            return checker.store().errorType();
        }
        resolved.push(argument);
    }
    Type[] resolvedArguments = resolved.toArray();

    bool bounded = true;
    for (long i = 0; i < arity; i++) {
        Span at = node.span();
        if (explicitList != null && i < explicitList.argumentsCount()) {
            at = explicitList.arguments(i).span();
        }
        if (!checker.resolver().checkArgumentBounds(typeParameters[i], resolvedArguments, at)) {
            bounded = false;
        }
    }

    long count = arguments.argumentsCount();
    long required = calls.requiredArgumentCount(signature);
    if (count < required || count > parameters.length) {
        checker.reporter().report(calls.arityRefusal("Function '{name}'", signature, count), node.span());
        bounded = false;
    }
    for (long i = 0; i < count && i < parameters.length; i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression) {
            Type parameterType = checker.store().substitute(parameters[i].type(), owner, resolvedArguments);
            Type actual = argumentTypes.get(i);
            let origin = literalfixes.argumentOrigin(checker, argument, signature, i, parameterType);
            if (waitsForParameter(argument, explicitList != null)) {
                actual = checker.analyzeExpressionAdapt(argument, parameterType, origin);
            } else {
                literaltyping.adaptIntegerLiteral(checker, argument, parameterType, origin);
                literaltyping.adaptCharLiteral(checker, argument, parameterType, origin);
                literaltyping.adaptFloatLiteral(checker, argument, parameterType, origin);
                let updated = checker.result().typeOf(argument.green());
                if (updated != null) {
                    actual = updated;
                }
            }
            if (!(parameterType is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(parameterType, actual)) {
                string provenance = "";
                if (explicitList == null) {
                    provenance = inference.provenance(parameters[i].type(), name, "(...)", checker.names());
                }
                string hint = nullguidance.valueAssignabilityHint(checker, parameterType, actual, argument);
                checker.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameters[i].name(),
                    parameterType, actual, checker.names()) + "{hint}{provenance}", argument.span());
            }
        }
    }

    if (bounded) {
        checker.result().setCallTypeArguments(node.green(), resolvedArguments);
        checker.recordGenericCall(signature, resolvedArguments, node.span());
    }
    return checker.store().substitute(signature.returnType(), owner, resolvedArguments);
}

// An external call: exact arity, no named arguments, and 'out' parameters take an
// initialized non-constant local of exactly the parameter's type.
analyzeExternalCall(BodyChecker checker, CallExpressionNode node, FunctionEntry entry, string name) -> Type {
    let signature = entry.signature();
    let arguments = node.arguments();
    if (usesNamedArguments(arguments)) {
        checker.reporter().report("External function '{name}' takes its arguments by position, so a call "
            + "cannot name them. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
            node.span());
        analyzeArgumentsOnly(checker, arguments);
        return signature.returnType();
    }
    Parameter[] parameters = signature.parameters();
    long count = arguments.argumentsCount();
    if (count != parameters.length) {
        checker.reporter().report(calls.arityRefusal("External function '{name}'", signature, count),
            node.span());
    }
    for (long i = 0; i < count; i++) {
        let argument = arguments.arguments(i);
        if (i >= parameters.length) {
            analyzeExtraExternalArgument(checker, argument);
            continue;
        }
        let parameter = parameters[i];
        if (parameter.isOut()) {
            if (argument is OutArgumentNode) {
                checkOutArgument(checker, argument, parameter, name, i);
            } else if (argument is Expression) {
                string example = "out result";
                if (parameter.name().length > 0) {
                    example = "out {parameter.name()}";
                }
                string fix = "Declare a local variable and write 'out' before it, as in '{example}'.";
                if (wording.unwrapParentheses(argument) is IdentifierExpressionNode) {
                    fix = "Write 'out {wording.oneLineSpelling(wording.unwrapParentheses(argument))}'.";
                }
                checker.reporter().report("{parameterSubject(parameter, i)} of '{name}' is an 'out' "
                    + "parameter, so it needs a variable to store into. {fix}", argument.span());
                checker.analyzeExpression(argument);
            }
            continue;
        }
        if (argument is OutArgumentNode) {
            checker.reporter().report("{parameterSubject(parameter, i)} of '{name}' is not an 'out' "
                + "parameter. Remove 'out' from '{wording.greenSpelling(argument.green())}'.",
                argument.span());
            continue;
        }
        if (argument is Expression) {
            Type actual = checker.analyzeExpressionAdapt(argument, parameter.type(),
                literalfixes.argumentOrigin(checker, argument, signature, i, parameter.type()));
            if (!(parameter.type() is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(parameter.type(), actual)) {
                checker.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameter.name(),
                    parameter.type(), actual, checker.names())
                    + "{nullguidance.valueAssignabilityHint(checker, parameter.type(), actual, argument)}",
                    argument.span());
            }
        }
    }
    return signature.returnType();
}

checkOutArgument(BodyChecker checker, OutArgumentNode argument, Parameter parameter, string name,
                 long index) {
    string outName = argument.name().text();
    let binding = checker.lookupBinding(outName);
    if (binding == null) {
        string quotedType = checker.names().quoted(parameter.type());
        string declare = "Declare it first as a local variable of type {quotedType}.";
        if (convert.isNumericType(parameter.type())) {
            string example = checker.names().quotedCode(["", " {outName} = 0;"], [parameter.type()]);
            declare = "Declare it first, as in {example}.";
        }
        checker.reporter().report("'{outName}' in 'out {outName}' is not a local variable or a parameter. "
            + declare, argument.span());
        return;
    }
    if (binding.isConst()) {
        checker.reporter().report(assignments.constantRefusal(checker, "Cannot pass '{outName}' as 'out'",
            binding), argument.span());
    }
    checker.result().setBinding(argument.green(), binding);
    if (binding.type() != parameter.type()) {
        string wanted = checker.names().quotedCode(["out ", ""], [parameter.type()]);
        checker.reporter().report("{parameterSubject(parameter, index)} of '{name}' is {wanted}, but "
            + "'{outName}' has type {checker.names().quoted(binding.type())}. Pass a variable of "
            + "type {checker.names().quoted(parameter.type())}.", argument.span());
        return;
    }
    // 'out' lets the callee write the caller's variable directly, so it drops even the
    // binding's own narrowing.
    checker.narrowing().clearForRoot(binding);
}

analyzeExtraExternalArgument(BodyChecker checker, Argument argument) {
    switch (argument) {
        is OutArgumentNode outArgument -> {
            let binding = checker.lookupBinding(outArgument.name().text());
            if (binding != null) {
                checker.result().setBinding(outArgument.green(), binding);
            }
        },
        is Expression value -> {
            checker.analyzeExpression(value);
        },
        default -> { },
    }
}

// The refusal of a 'fromCString' call that passes 'count' arguments.
fromCStringCountRefusal(long count) -> string {
    string refusal = "'fromCString' takes one argument, a handle a C function returned, but this call "
        + "passes {diagnostics.countWord(count)}.";
    if (count == 0) {
        return "{refusal} Pass the handle.";
    }
    if (count == 2) {
        return "{refusal} Remove the extra argument.";
    }
    return "{refusal} Remove the extra arguments.";
}

public usesNamedArguments(ArgumentListNode arguments) -> bool {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (arguments.arguments(i) is NamedArgumentNode) {
            return true;
        }
    }
    return false;
}

// True for a value with no type of its own to offer overload resolution, which is checked once the
// parameter it fills is known: an empty array literal, a '{...}' literal, and a lambda, whose
// parameter and return types come from the function type it fills.
// Whether the argument is an operator or a join holding a floating-point literal too large for
// 'float', whose fix names the parameter the argument is passed to.
carriesOverflowingFloat(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    if (core is BinaryExpressionNode) {
        return overflowsFloatWithin(core.left()) || overflowsFloatWithin(core.right());
    }
    if (core is TernaryExpressionNode) {
        return overflowsFloatWithin(core.thenValue()) || overflowsFloatWithin(core.elseValue());
    }
    return false;
}

// Whether the value is, or holds as an operand or a branch, a floating-point literal too large for
// 'float'.
overflowsFloatWithin(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    let literal = literaltyping.floatLiteralOf(core);
    if (literal != null) {
        return literalfixes.literalOverflows(literal, PrimitiveKind.Float);
    }
    return carriesOverflowingFloat(core);
}

// Whether an argument of a generic call is analyzed once its parameter type is known. With the type
// arguments 'written', an array literal is too, so that its literals take the element type.
waitsForParameter(Expression value, bool written) -> bool {
    return needsTargetType(value) || (written && value is ArrayLiteralExpressionNode);
}

needsTargetType(Expression value) -> bool {
    if (value is ArrayLiteralExpressionNode) {
        return value.elementsCount() == 0;
    }
    return value is StructLiteralExpressionNode || value is LambdaExpressionNode;
}

// "Parameter 'result'", or "Parameter 2" for the parameter at 'index' when it has no name.
parameterSubject(Parameter parameter, long index) -> string {
    if (parameter.name().length > 0) {
        return "Parameter '{parameter.name()}'";
    }
    return "Parameter {index + 1}";
}

// The source text of one argument on one line.
argumentSpelling(Argument argument) -> string {
    switch (argument) {
        is NamedArgumentNode named -> {
            return wording.greenSpelling(named.green());
        },
        is OutArgumentNode written -> {
            return wording.greenSpelling(written.green());
        },
        is Expression value -> {
            return wording.oneLineSpelling(value);
        },
        default -> {
            return "";
        },
    }
}

// The argument list of a call with the names of its named arguments removed, when it is short, or '(...)'.
positionalSpelling(ArgumentListNode arguments) -> string {
    string listed = "";
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                listed = listed + wording.oneLineSpelling(named.value());
            },
            default -> {
                listed = listed + argumentSpelling(arguments.arguments(i));
            },
        }
    }
    if (listed.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return "({listed})";
}

// The argument list of a call as written when it is short, or '(...)'.
public argumentsSpelling(ArgumentListNode? arguments) -> string {
    if (arguments == null) {
        return "()";
    }
    string spelled = wording.greenSpelling(arguments.green());
    if (spelled.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return spelled;
}

// The refusal of a 'try' before 'operand', which is not a call. The fix moves the 'try' to a call on
// one side of an operator.
misplacedTryRefusal(Expression operand) -> string {
    let spelled = wording.shortSpelling(operand);
    if (spelled == null) {
        return "'try' must be written directly before a call. Move 'try' to the call that can throw.";
    }
    string opening = "'try' must be written directly before a call, and '{spelled}' is not a call.";
    let inner = wording.unwrapParentheses(operand);
    if (inner is BinaryExpressionNode) {
        string left = wording.oneLineSpelling(inner.left());
        string right = wording.oneLineSpelling(inner.right());
        string operator = inner.operator().text();
        if (inner.right() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in '{left} {operator} try {right}'.";
        }
        if (inner.left() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in 'try {left} {operator} {right}'.";
        }
    }
    return "{opening} Move 'try' to the call that can throw.";
}

// The refusal of argument 'label' of 'callee', whose type 'actual' is not the type 'expected' of the
// parameter it is passed to, named 'parameter' when the parameter has a name.
public argumentMismatch(string label, string callee, string parameter, Type expected, Type actual,
                        TypeNames names) -> string {
    string given = "Argument {label} of {callee} has type {names.quoted(actual)}";
    if (parameter.length == 0) {
        string wanted = names.of(expected);
        return "{given}, but {callee} takes {typenames.typeArticle(wanted)} {names.quoted(expected)} there.";
    }
    return "{given}, but parameter '{parameter}' has type {names.quoted(expected)}.";
}

// How a refusal names the callee of 'kindWord' spelled 'displayName' after the word "of".
calleeObject(string kindWord, string displayName) -> string {
    if (kindWord == "Constructor" || kindWord == "Base constructor") {
        return "the constructor of '{displayName}'";
    }
    return "'{displayName}'";
}
