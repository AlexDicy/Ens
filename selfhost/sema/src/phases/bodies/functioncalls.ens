// The parameter a call's resolution chose for the argument at 'span'.
public final class ChosenParameter {
    protected Span span;
    protected LiteralOrigin origin;

    protected constructor(this.span, this.origin);
}

// The candidate a trial chose for a call, with the narrowing that held where the call starts there.
public final class TrialChoice {
    protected Map<NarrowingPath, Type> entry;
    protected Signature chosen;

    protected constructor(this.entry, this.chosen);
}

// The call shape paired with each argument's written expression, positional first and named
// after, so resolved calls can adapt literals in place. An 'out' misuse leaves a null hole. The
// arguments from 'pendingFrom' on were ranked from a trial and are analyzed once a candidate is chosen,
// and in a trial, 'entry' is the narrowing where the call starts.
public final class BuiltShape {
    protected CallShape callShape;
    protected List<Expression?> values;
    protected List<NamedArgumentNode?> named;
    protected long pendingFrom;
    protected bool single;
    protected GreenNode? call;
    protected Map<NarrowingPath, Type>? entry;

    // A shape over positional arguments, of which the ones from 'pendingFrom' on were analyzed only in a
    // trial.
    public constructor(this.callShape, this.values, this.pendingFrom) {
        this.named = new List<NamedArgumentNode?>();
        for (long i = 0; i < this.values.length(); i++) {
            this.named.push(null);
        }
        this.single = false;
        this.call = null;
        this.entry = null;
    }

    protected constructor(this.callShape, this.values, this.named, this.pendingFrom, this.single, this.call,
                          this.entry);

    public shape() -> CallShape {
        return this.callShape;
    }
}

// Each call of the chain a 'try' covers can throw once its receiver and arguments are evaluated,
// so each is a place the constructor body can throw from.
public analyzeTry(BodyChecker checker, TryExpressionNode node) -> Type {
    let operand = node.operand();
    if (!(operand is CallExpressionNode)) {
        checker.reporter().report(misplacedTryRefusal(operand), node.span());
        return checker.analyzeExpression(operand);
    }
    let outer = checker.assignment().enterTry(syntax.triedChain(operand));
    Type analyzed = checker.analyzeExpression(operand);
    checker.assignment().leaveTry(outer);
    return analyzed;
}

// The shape of the arguments of 'call' for 'candidates', analyzed in written order as ArgumentOrder
// describes. With a single candidate, an argument holding a literal too large for 'float' waits for its
// parameter, so its refusal can name it.
public buildCallShape(BodyChecker checker, Expression call, ArgumentListNode arguments,
                      List<CallCandidate> candidates) -> BuiltShape {
    bool single = candidates.length() == 1;
    let shape = new CallShape();
    shape.setLocalNamer((base) -> nullguidance.freeLocalName(checker, "", base));
    let positionalValues = new List<Expression?>();
    let namedValues = new List<Expression?>();
    let namedArguments = new List<NamedArgumentNode?>();
    Map<NarrowingPath, Type>? entry = null;
    if (checker.inTrial()) {
        entry = checker.narrowing().flatten();
    }
    let targets = parameterTargets(checker, chosenInTrial(checker, call, candidates), arguments);
    let order = new ArgumentOrder(checker, targets == null || positionalAfterNamed(arguments));
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        order.reach(i);
        ArgumentValue? added = null;
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                string name = named.name().text();
                for (long j = 0; j < shape.named().length(); j++) {
                    if (shape.named().get(j).name() == name) {
                        checker.reporter().report("Argument '{name}' is named twice in this call. Remove "
                            + "one of the two.", named.name().span());
                        shape.markMalformed();
                        break;
                    }
                }
                let shaped = shapeArgument(order, name, named.value(), named, single, targets, i);
                shape.named().push(shaped);
                namedValues.push(named.value());
                namedArguments.push(named);
                added = shaped;
            },
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
                shape.markErrorArgument();
                shape.positional().push(new ArgumentValue("", checker.store().errorType(),
                    false, false, 0, false, outArgument.span()));
                positionalValues.push(null);
            },
            is Expression value -> {
                if (shape.named().length() > 0 && !shape.isMalformed()) {
                    string move = "";
                    let firstNamed = arguments.arguments(0);
                    for (long j = 0; j < i; j++) {
                        if (arguments.arguments(j) is NamedArgumentNode) {
                            firstNamed = arguments.arguments(j);
                            break;
                        }
                    }
                    let spelledValue = wording.shortSpelling(value);
                    string spelledNamed = argumentSpelling(firstNamed);
                    if (spelledValue != null && spelledNamed.length <= 30) {
                        move = " Move '{spelledValue}' before '{spelledNamed}'.";
                    }
                    checker.reporter().report("Positional arguments must come before named ones.{move}",
                        value.span());
                    shape.markMalformed();
                }
                let shaped = shapeArgument(order, "", value, null, single, targets, i);
                shape.positional().push(shaped);
                positionalValues.push(value);
                added = shaped;
            },
            default -> { },
        }
        if (added != null && added.holdsError()) {
            shape.markErrorArgument();
        }
    }
    let values = new List<Expression?>();
    let named = new List<NamedArgumentNode?>();
    for (long i = 0; i < positionalValues.length(); i++) {
        values.push(positionalValues.get(i));
        named.push(null);
    }
    for (long i = 0; i < namedValues.length(); i++) {
        values.push(namedValues.get(i));
        named.push(namedArguments.get(i));
    }
    markEndingCallPlace(order.analyzer(), call, shape, values);
    long pendingFrom = order.finish(values.length());
    return new BuiltShape(shape, values, named, pendingFrom, single, call.green(), entry);
}

// The candidates of 'call' that can take its arguments: the one a trial chose for it where the narrowing
// the trial started from holds here, and otherwise every one of 'candidates'.
chosenInTrial(BodyChecker checker, Expression call, List<CallCandidate> candidates)
        -> List<CallCandidate> {
    if (checker.inTrial()) {
        return candidates;
    }
    let choice = checker.takeTrialChoice(call.green());
    if (choice == null || !narrow.sameProofs(choice.entry, checker.narrowing().flatten())) {
        return candidates;
    }
    let chosen = new List<CallCandidate>();
    for (let candidate in candidates) {
        if (candidate.signature() == choice.chosen) {
            chosen.push(candidate);
        }
    }
    if (chosen.isEmpty()) {
        return candidates;
    }
    return chosen;
}

// The parameter each argument of a call fills where every one of 'candidates' that takes the
// arguments gives it the same type, before any argument is analyzed, or null where no candidate takes
// them.
public final class ParameterTargets {
    // The type of each parameter, or null where two candidates give the argument different types.
    protected List<Type?> types;
    // The parameter of the only candidate that takes the arguments, which a fix can name, or null where
    // more than one does.
    protected List<LiteralOrigin?> origins;

    protected constructor(this.types, this.origins);
}

// The parameters the arguments of a call to 'candidates' fill, read from the names and the count of
// the arguments, or null where no candidate takes them.
parameterTargets(BodyChecker checker, List<CallCandidate> candidates, ArgumentListNode arguments)
        -> ParameterTargets? {
    let written = new CallShape();
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        let argument = arguments.arguments(i);
        if (argument is NamedArgumentNode) {
            written.named().push(new ArgumentValue(argument.name().text(), checker.store().errorType(),
                false, false, 0, false, argument.span()));
        } else {
            written.positional().push(new ArgumentValue("", checker.store().errorType(), false, false, 0,
                false, arguments.span()));
        }
    }
    let takers = calls.takingCandidates(candidates, written);
    if (takers.isEmpty()) {
        return null;
    }
    let types = new List<Type?>();
    let origins = new List<LiteralOrigin?>();
    for (long i = 0; i < written.argumentCount(); i++) {
        Type? agreed = takers.get(0).parameterType(i);
        for (let taker in takers) {
            if (taker.parameterType(i) != agreed) {
                agreed = null;
            }
        }
        types.push(agreed);
        LiteralOrigin? origin = null;
        let value = argumentValue(arguments.arguments(i));
        if (takers.length() == 1 && agreed != null && value != null) {
            let sole = takers.get(0);
            origin = literalfixes.argumentOrigin(checker, value, sole.candidate().signature(),
                sole.parameterIndex(i), agreed, constructedName(checker, sole.candidate()));
        }
        origins.push(origin);
    }
    return new ParameterTargets(types, origins);
}

// The expression an argument passes, or null for an 'out' argument.
argumentValue(Argument argument) -> Expression? {
    switch (argument) {
        is NamedArgumentNode named -> {
            return named.value();
        },
        is Expression value -> {
            return value;
        },
        default -> {
            return null;
        },
    }
}

// The quoted type 'candidate' constructs, with its type arguments, or empty where it is no
// constructor.
constructedName(BodyChecker checker, CallCandidate candidate) -> string {
    let method = candidate.method();
    if (method != null && method.isConstructor()) {
        return checker.names().quoted(method.definingType());
    }
    return "";
}

// The argument 'value' at 'index', named 'name' or positional with an empty name, as resolution reads
// it: by what is written, where that decides the parameters it fits, and otherwise by its type, which
// it is analyzed for now. 'written' is the named argument it is written in, or null for a positional
// one, and 'targets' the parameters the arguments fill, where they are known.
shapeArgument(ArgumentOrder order, string name, Expression value, NamedArgumentNode? written, bool single,
              ParameterTargets? targets, long index) -> ArgumentValue {
    Type? target = null;
    LiteralOrigin? origin = null;
    if (targets != null && index < targets.types.length()) {
        target = targets.types.get(index);
        origin = targets.origins.get(index);
    }
    let checker = order.analyzer();
    let shaped = shapedArgumentOf(order, name, value, single, target);
    if (shaped != null) {
        return shaped;
    }
    if (single && carriesOverflowingFloat(value)) {
        let argument = targetTypedArgument(checker, name, value);
        order.place(value, target, origin);
        return argument;
    }
    return argumentValueOf(checker, name, value, analyzeRankedArgument(checker, value, written, single));
}

// Analyzes 'value', an argument with a type of its own of a call whose candidates are ranked, written
// in the named argument 'written', or positional where that is null.
analyzeRankedArgument(BodyChecker checker, Expression value, NamedArgumentNode? written, bool single)
        -> Type {
    bool outerAwaiting = checker.targets().awaitingParameter();
    checker.targets().setAwaitingParameter(!single);
    Type analyzed = checker.analyzeExpression(value);
    checker.targets().setAwaitingParameter(outerAwaiting);
    if (written != null) {
        checker.result().setType(written.green(), analyzed);
    }
    return analyzed;
}

// Whether a positional argument is written after a named one.
positionalAfterNamed(ArgumentListNode arguments) -> bool {
    bool named = false;
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        let argument = arguments.arguments(i);
        if (argument is NamedArgumentNode) {
            named = true;
        } else if (named) {
            return true;
        }
    }
    return false;
}

// Marks on 'shape', when one of the arguments of 'call' never returns, what the refusal of the call
// as ambiguous reads: which of the arguments 'values' have no effects, whether nothing reads the
// value of the call, and whether one of its arguments could replace the whole call.
markEndingCallPlace(BodyChecker checker, Expression call, CallShape shape, List<Expression?> values) {
    bool ends = false;
    for (long i = 0; i < shape.argumentCount(); i++) {
        ends = ends || shape.argumentAt(i).shape() == ArgumentShape.NeverReturning;
    }
    if (!ends) {
        return;
    }
    for (long i = 0; i < values.length(); i++) {
        let value = values.get(i);
        if (value != null && isEffectFree(checker, value)) {
            shape.argumentAt(i).markEffectFree();
        }
    }
    if (checker.isDiscarded(call)) {
        shape.markResultDiscarded();
    }
    if (checker.isWholeValue(call) && hasPlainReceiver(checker, call)) {
        shape.markReplaceable();
    }
}

// Whether the call 'call' has no receiver, or one that does nothing but produce its value and is not
// read through '?.'. A call of 'super(...)' has no receiver, but it cannot be replaced.
hasPlainReceiver(BodyChecker checker, Expression call) -> bool {
    if (!(call is CallExpressionNode)) {
        return true;
    }
    switch (syntax.unwrapParentheses(call.callee())) {
        is MemberExpressionNode member -> {
            return isEffectFree(checker, member.object());
        },
        is SafeMemberExpressionNode ignored -> {
            return false;
        },
        is SuperExpressionNode ignored -> {
            return false;
        },
        default -> {
            return true;
        },
    }
}

// Whether evaluating 'value' does nothing but produce it: a literal, 'this', a local, a type or a
// module named on its own, or a field read through one of those.
isEffectFree(BodyChecker checker, Expression value) -> bool {
    switch (syntax.unwrapParentheses(value)) {
        is LiteralExpressionNode ignored -> {
            return true;
        },
        is ThisExpressionNode ignored -> {
            return true;
        },
        is IdentifierExpressionNode identifier -> {
            let meaning = checker.resolveName(identifier.name().text());
            return meaning is LocalName || meaning is TypeName || meaning is NamespaceName
                || meaning is TypeParameterName;
        },
        is MemberExpressionNode member -> {
            return isEffectFree(checker, member.object()) && memberaccess.fieldRead(checker, member) != null;
        },
        default -> {
            return false;
        },
    }
}

// The argument 'value' shaped by what is written, with its parts analyzed as the call's other arguments
// are, or null where it has a type of its own. 'target' is the type of the parameter it fills, where
// it is known before a candidate is chosen.
shapedArgumentOf(ArgumentOrder order, string name, Expression value, bool single, Type? target)
        -> ArgumentValue? {
    let checker = order.analyzer();
    bool outerAwaiting = checker.targets().awaitingParameter();
    checker.targets().setAwaitingParameter(!single);
    let shaped = argumentshapes.shapedArgument(order, name, value, target);
    checker.targets().setAwaitingParameter(outerAwaiting);
    return shaped;
}

// Resolves the call over 'candidates'. Where none is chosen, a method or function name among the
// arguments is refused on its own, because resolution reports nothing for a call that passes one, and
// so is a '?:' or a switch whose values have no common type. The arguments analyzed only in a trial are
// then analyzed, and the lambdas checked without types, since no candidate types them.
public resolveBuiltCall(BodyChecker checker, List<CallCandidate> candidates, BuiltShape built, Span span,
                        string displayName, string kindWord) -> CallResolution {
    for (long i = built.pendingFrom; i < built.values.length(); i++) {
        if (built.shape().argumentAt(i).lacksCommonType()) {
            built.shape().markArgumentRefusedAlone();
        }
    }
    let resolution = calls.resolveCall(candidates, built.shape(), checker.reporter(), span, displayName,
        kindWord, checker.names(), checker.store());
    let chosen = resolution.chosen();
    let call = built.call;
    let entry = built.entry;
    if (chosen != null && call != null && entry != null) {
        checker.recordTrialChoice(call, new TrialChoice(entry, chosen.signature()));
    }
    if (resolution.failed()) {
        string takers = "'{displayName}'";
        if (kindWord == "Constructor" || kindWord == "Base constructor") {
            takers = "constructor of '{displayName}'";
        }
        for (long i = 0; i < built.values.length(); i++) {
            let value = built.values.get(i);
            if (value != null) {
                if (i >= built.pendingFrom) {
                    analyzeUnchosenArgument(checker, built, built.shape().argumentAt(i), value, i);
                }
                checkUnchosenLambdas(checker, built.shape().argumentAt(i), value);
                refuseHeldNames(checker, built.shape().argumentAt(i), value,
                    parametersAt(candidates, built.shape(), i), takers);
            }
        }
    }
    return resolution;
}

// Analyzes, where no candidate is chosen, the arguments from the one a trial started in, which were
// analyzed only in that trial, and checks the lambdas without types.
public analyzeUnchosenArguments(BodyChecker checker, BuiltShape built) {
    for (long i = 0; i < built.values.length(); i++) {
        let value = built.values.get(i);
        if (value != null && i >= built.pendingFrom) {
            analyzeUnchosenArgument(checker, built, built.shape().argumentAt(i), value, i);
        }
        if (value != null) {
            checkUnchosenLambdas(checker, built.shape().argumentAt(i), value);
        }
    }
}

// Checks without types the body of each lambda that 'value', shaped as 'argument', is or holds as an
// element of an array literal, where no candidate is chosen to type it.
checkUnchosenLambdas(BodyChecker checker, ArgumentValue argument, Expression value) {
    Expression written = syntax.unwrapParentheses(value);
    switch (argument.shape()) {
        Lambda -> {
            if (written is LambdaExpressionNode) {
                lambdas.checkBodyWithoutTypes(checker, written);
            }
        },
        ArrayLiteral -> {
            if (written is ArrayLiteralExpressionNode) {
                for (long i = 0; i < written.elementsCount() && i < argument.elements().length; i++) {
                    checkUnchosenLambdas(checker, argument.elements()[i], written.elements(i));
                }
            }
        },
        default -> { },
    }
}

// Analyzes the parts of 'value', the argument at 'index' or -1 for an array element, that were analyzed
// only in a trial and that no candidate is chosen to type. A '{...}' literal is analyzed against no type,
// and a '?:' or a switch whose values have no common type with no context type, which refuses it.
analyzeUnchosenArgument(BodyChecker checker, BuiltShape built, ArgumentValue argument, Expression value,
                        long index) {
    Expression written = syntax.unwrapParentheses(value);
    if (checker.takePlaced(written)) {
        return;
    }
    switch (argument.shape()) {
        ArrayLiteral -> {
            if (written is ArrayLiteralExpressionNode) {
                for (long i = 0; i < written.elementsCount() && i < argument.elements().length; i++) {
                    analyzeUnchosenArgument(checker, built, argument.elements()[i], written.elements(i), -1);
                }
            }
        },
        StructLiteral -> {
            let ignored = checker.analyzeExpressionAdapt(value, checker.store().errorType());
        },
        Lambda, Name -> { },
        default -> {
            if (checker.takeRanked(value)) {
                return;
            }
            NamedArgumentNode? named = null;
            if (index >= 0) {
                named = built.named.get(index);
            }
            if (argument.lacksCommonType()) {
                let ignored = checker.analyzeExpression(value);
            } else if (argument.needsTarget()) {
                let ignored = checker.analyzeExpressionAdapt(value, checker.store().errorType());
            } else {
                let ignored = analyzeRankedArgument(checker, value, named, built.single);
            }
        },
    }
}

// The parameters the candidates declare for the argument at 'index', positional or named.
parametersAt(List<CallCandidate> candidates, CallShape shape, long index) -> List<Parameter> {
    let found = new List<Parameter>();
    let argument = shape.argumentAt(index);
    for (let candidate in candidates) {
        Parameter[] parameters = candidate.signature().parameters();
        if (argument.name().length == 0) {
            if (index < parameters.length) {
                found.push(parameters[index]);
            }
            continue;
        }
        for (let parameter in parameters) {
            if (parameter.name() == argument.name()) {
                found.push(parameter);
            }
        }
    }
    return found;
}

// Analyzes each method or function name 'argument' holds with no function type to fit, which refuses it.
// 'parameters' are what the candidates declare for the argument, which decide the fix the refusal gives.
refuseHeldNames(BodyChecker checker, ArgumentValue argument, Expression value, List<Parameter> parameters,
                string takers) {
    let types = new List<Type>();
    for (let parameter in parameters) {
        types.push(parameter.type());
    }
    refuseHeldNamesOf(checker, argument, value, types, parameters, takers);
}

// refuseHeldNames over 'types', the types the candidates take there, with the 'parameters' that declare
// them where the argument is passed straight to one.
refuseHeldNamesOf(BodyChecker checker, ArgumentValue argument, Expression value, List<Type> types,
                  List<Parameter> parameters, string takers) {
    if (argument.shape() == ArgumentShape.Name) {
        let counts = new List<long>();
        bool all = types.length() > 0;
        string named = "";
        for (long i = 0; i < types.length(); i++) {
            Type core = convert.coreOf(types.get(i));
            if (!(core is FunctionType)) {
                all = false;
                continue;
            }
            counts.push(core.parameterTypes().length);
            if (named.length == 0 && i < parameters.length()) {
                named = parameters.get(i).name();
            }
        }
        checker.targets().setHeldNameTarget(new HeldNameTarget(counts.toArray(), all, counts.length() > 0,
            named, types.toArray(), "no {takers} takes null"));
        checker.analyzeExpression(value);
        checker.targets().setHeldNameTarget(null);
        return;
    }
    let array = syntax.unwrapParentheses(value);
    if (argument.shape() == ArgumentShape.ArrayLiteral && array is ArrayLiteralExpressionNode) {
        let elementTypes = new List<Type>();
        for (let type in types) {
            Type core = convert.coreOf(type);
            if (core is ArrayType) {
                elementTypes.push(core.element());
            }
        }
        for (long i = 0; i < array.elementsCount(); i++) {
            refuseHeldNamesOf(checker, argument.elements()[i], array.elements(i), elementTypes,
                new List<Parameter>(), takers);
        }
    }
}

// An argument whose type only the parameter it is passed to determines, left unanalyzed until the
// candidate is chosen.
targetTypedArgument(BodyChecker checker, string name, Expression value) -> ArgumentValue {
    let argument = new ArgumentValue(name, checker.store().errorType(), false, false, 0, false, value.span());
    argument.markNeedsTarget();
    argument.setSpelling(wording.shortSpelling(value));
    return argument;
}

public argumentValueOf(BodyChecker checker, string name, Expression value, Type analyzed) -> ArgumentValue {
    let argument = literalArgumentOf(name, value, analyzed);
    if (checker.neverReturns(value)) {
        argument.markNeverReturning();
    }
    argument.setSpelling(wording.shortSpelling(value));
    return argument;
}

// The type the argument 'value', of type 'analyzed', offers the inference of type arguments: none,
// as an error type, for a value that never returns, which fits every parameter.
public offeredType(BodyChecker checker, Expression value, Type analyzed) -> Type {
    if (checker.neverReturns(value)) {
        return checker.store().errorType();
    }
    return analyzed;
}

literalArgumentOf(string name, Expression value, Type analyzed) -> ArgumentValue {
    let literal = literaltyping.intLiteralOf(value);
    if (literal != null) {
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        if (magnitude != null) {
            return new ArgumentValue(name, analyzed, true, literaltyping.isNegativeLiteral(value),
                magnitude, false, value.span());
        }
    }
    if (value is LiteralExpressionNode && value.value().kind() == SyntaxKind.CharLiteral) {
        return new ArgumentValue(name, analyzed, false, false,
            literalvalues.charCodepoint(value.value().text()), true, value.span());
    }
    let plain = new ArgumentValue(name, analyzed, false, false, 0, false, value.span());
    let floatLiteral = literaltyping.floatLiteralOf(value);
    if (floatLiteral != null) {
        plain.markFloatLiteral(literalvalues.floatMagnitude(floatLiteral.value().text()));
    }
    return plain;
}

// Final argument checking against the chosen candidate: adapt untyped literals to the
// parameter types and verify assignability, mirroring the single-candidate path. The arguments ranked
// from a trial are analyzed here in written order, and a trial checks no argument that waits.
public checkResolvedArguments(BodyChecker checker, BuiltShape built, CallResolution resolution,
                              GreenNode callNode) -> Type {
    let chosen = resolution.chosen();
    if (chosen == null) {
        return checker.store().errorType();
    }
    Parameter[] parameters = chosen.signature().parameters();
    long[] mapping = resolution.mapping();
    let shape = built.shape();
    string constructed = "";
    let method = chosen.method();
    if (method != null && method.isConstructor()) {
        constructed = checker.names().quoted(method.definingType());
    }
    for (long i = 0; i < shape.argumentCount() && i < mapping.length; i++) {
        let argument = shape.argumentAt(i);
        Type parameterType = parameters[mapping[i]].type();
        Type finalType = argument.type();
        let value = built.values.get(i);
        if (value != null) {
            let chosenOrigin = new LiteralOrigin(OriginKind.Parameter, parameters[mapping[i]].name(),
                chosen.signature().name(), parameterType);
            chosenOrigin.setQuotedConstructed(constructed);
            checker.targets().chosenParameters().push(new ChosenParameter(value.span(), chosenOrigin));
        }
        if (value != null && i >= built.pendingFrom && !argument.needsTarget()) {
            let ignored = analyzeRankedArgument(checker, value, built.named.get(i), built.single);
        }
        if (value != null && argument.needsTarget() && checker.inTrial()) {
            continue;
        }
        if (value != null && argument.needsTarget()) {
            finalType = checker.analyzeExpressionAdapt(value, parameterType,
                literalfixes.argumentOrigin(checker, value, chosen.signature(), mapping[i], parameterType,
                    constructed));
        } else if (value != null) {
            let origin = literalfixes.argumentOrigin(checker, value, chosen.signature(), mapping[i],
                parameterType, constructed);
            literaltyping.adaptIntegerLiteral(checker, value, parameterType, origin);
            literaltyping.adaptCharLiteral(checker, value, parameterType, origin);
            literaltyping.adaptFloatLiteral(checker, value, parameterType, origin);
            let updated = checker.result().typeOf(value.green());
            if (updated != null) {
                finalType = checker.readAs(value, updated, parameterType);
            }
        }
        if (parameterType is ErrorType || finalType is ErrorType) {
            continue;
        }
        string callee = "'{chosen.signature().name()}'";
        if (constructed.length > 0) {
            callee = "the constructor of {constructed}";
        }
        if (value != null) {
            let noValue = voidcalls.argumentRefusal(checker, value, finalType, callee, parameterType);
            if (noValue != null) {
                checker.reporter().report(noValue, argument.span());
                continue;
            }
        }
        if (!convert.isAssignableStrict(parameterType, finalType)) {
            string label = "{i + 1}";
            if (argument.name().length > 0) {
                label = "'{argument.name()}'";
            }
            let parameter = parameters[mapping[i]];
            let elsewhere = argumentElsewhere(checker, chosen.signature(), method, callee, parameter,
                finalType, value);
            reportArgumentMismatch(checker, argumentMismatch(label, callee, parameter.name(),
                parameterType, finalType, checker.names())
                + argumentHint(checker, parameterType, finalType, value, chosen.signature(), method,
                    parameter, elsewhere), argument.span(), elsewhere);
        }
    }
    if (shape.named().length() > 0) {
        checker.result().setArgumentOrder(callNode, mapping);
    }
    return chosen.signature().returnType();
}

// Argument count and type checking against a single known signature, of 'method' or of a function.
// 'constructed' quotes the type a constructor builds, with its type arguments. A call refused for its
// count leaves the parameter of each argument unknown, so each argument is analyzed against none.
public checkDirectArguments(BodyChecker checker, string kindWord, string displayName, Signature signature,
                            ArgumentListNode arguments, Span callSpan, Method? method,
                            string constructed = "") -> Type {
    Parameter[] parameters = signature.parameters();
    long count = arguments.argumentsCount();
    long required = calls.requiredArgumentCount(signature);
    bool counted = count >= required && count <= parameters.length;
    if (!counted) {
        checker.reporter().report(calls.arityRefusal(calls.calleeSubject(kindWord, displayName), signature,
            count), callSpan);
    }
    for (long i = 0; i < count; i++) {
        switch (arguments.arguments(i)) {
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                if (counted) {
                    Type parameterType = parameters[i].type();
                    Type actual = checker.analyzeExpressionAdapt(value, parameterType,
                        literalfixes.argumentOrigin(checker, value, signature, i, parameterType,
                            constructed));
                    let noValue = voidcalls.argumentRefusal(checker, value, actual,
                        calleeObject(kindWord, displayName), parameterType);
                    if (!(parameterType is ErrorType) && noValue != null) {
                        checker.reporter().report(noValue, value.span());
                    } else if (!(parameterType is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(parameterType, actual)) {
                        string callee = calleeObject(kindWord, displayName);
                        let elsewhere = argumentElsewhere(checker, signature, method, callee,
                            parameters[i], actual, value);
                        reportArgumentMismatch(checker, argumentMismatch("{i + 1}", callee,
                            parameters[i].name(), parameterType, actual, checker.names())
                            + argumentHint(checker, parameterType, actual, value, signature, method,
                                parameters[i], elsewhere), value.span(), elsewhere);
                    }
                } else {
                    let ignored = analyzeWithoutParameter(checker, value, false);
                }
            },
            default -> { },
        }
    }
    return signature.returnType();
}

// Parameter 'parameter' of 'signature' as a declaration in another file, where the hint for an argument
// of type 'actual' tells the reader to change that parameter, and null otherwise.
argumentElsewhere(BodyChecker checker, Signature signature, Method? method, string callee,
                  Parameter parameter, Type actual, Expression? value) -> ElsewhereDeclaration? {
    if (!nullguidance.hintRetypesDeclaration(checker, parameter.type(), actual, value)) {
        return null;
    }
    return nullguidance.parameterElsewhere(checker, signature, method, callee, parameter);
}

// The hint after the refusal of the argument 'value', of type 'actual', passed as 'parameter' of
// 'signature', the signature of 'method' or of a function.
argumentHint(BodyChecker checker, Type parameterType, Type actual, Expression? value, Signature signature,
             Method? method, Parameter parameter, ElsewhereDeclaration? elsewhere) -> string {
    string bounded = interfacebounds.argumentHint(checker, parameterType, actual, value, signature, method,
        parameter);
    if (bounded.length > 0) {
        return bounded;
    }
    return nullguidance.valueAssignabilityHint(checker, parameterType, actual, value, null, elsewhere);
}

// Reports an argument that does not fit its parameter, with a note at the parameter where the fix
// changes a parameter declared in another file.
reportArgumentMismatch(BodyChecker checker, string message, Span at, ElsewhereDeclaration? elsewhere) {
    if (elsewhere == null) {
        checker.reporter().report(message, at);
        return;
    }
    checker.reporter().report(message, at, elsewhere.notes());
}

// Analyzes the arguments of a call that is refused before its parameters are known, each one against no
// parameter, so an argument with no type of its own, such as a lambda, reports nothing about itself.
public analyzeArgumentsOnly(BodyChecker checker, ArgumentListNode arguments) {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        let value = argumentValue(arguments.arguments(i));
        if (value != null) {
            let ignored = analyzeWithoutParameter(checker, value, false);
        }
    }
}

// The refusals held inside a call's arguments stay held only for an argument whose type reaches
// the call's result. The others are reported, since no enclosing join changes their fix.
public analyzeCall(BodyChecker checker, CallExpressionNode node, Type? expected) -> Type {
    let outerJoin = checker.targets().beginArguments();
    let outerDeferred = checker.targets().deferredFixes();
    let held = new List<DeferredLiteralFix>();
    checker.targets().setDeferredFixes(held);
    let outerFlowing = checker.targets().flowingArguments();
    checker.targets().setFlowingArguments(new List<Span>());
    bool outerAwaiting = checker.targets().awaitingParameter();
    checker.targets().setAwaitingParameter(false);
    let outerChosen = checker.targets().chosenParameters();
    checker.targets().setChosenParameters(new List<ChosenParameter>());
    Type called = analyzeCallOf(checker, node, expected);
    checker.assignment().noteCallFinished(node, checker.frame().inCatchClause());
    noteFlowingMethodArguments(checker, node);
    settleParameters(checker, held);
    checker.targets().endJoin(outerJoin);
    let flowing = checker.targets().flowingArguments();
    checker.targets().setFlowingArguments(outerFlowing);
    checker.targets().setAwaitingParameter(outerAwaiting);
    checker.targets().setChosenParameters(outerChosen);
    checker.targets().setDeferredFixes(outerDeferred);
    settleArguments(checker, held, outerDeferred, flowing, false);
    return called;
}

// Settles the refusals held for arguments of a call with several candidates against the
// parameter the chosen candidate gave them. Beside a parameter of the literal's type the fix names the
// parameter, and with no candidate chosen the refusal ends after the why.
public settleParameters(BodyChecker checker, List<DeferredLiteralFix> held) {
    for (let fix in held) {
        if (!fix.awaitingParameter()) {
            continue;
        }
        fix.setAwaitingParameter(false);
        LiteralOrigin? origin = null;
        for (let chosen in checker.targets().chosenParameters()) {
            if (fix.span().start >= chosen.span.start && fix.span().end() <= chosen.span.end()) {
                origin = chosen.origin;
            }
        }
        let suffixed = fix.suffixed();
        if (origin == null) {
            fix.setMessage(fix.plain());
            continue;
        }
        let widening = fix.widening() ?? valuejoins.floatWidening();
        string declared = literalfixes.originType(checker, origin);
        string quotedDeclared = literalfixes.quotedOriginType(checker, origin);
        if (literalfixes.isFloatCore(origin.declared()) && suffixed != null) {
            string noun = literalfixes.parameterNoun(origin);
            suffixed.setFix("The '{fix.suffix()}' makes the literal a 'float', and {noun} is a "
                + "{quotedDeclared} too.");
        } else if (literalfixes.sameCore(origin.declared(), widening) && !fix.settled()
                && fix.clause().length > 0 && fix.message() != fix.plain()) {
            fix.setMessage("{fix.refusal()} {fix.clause()}, and {literalfixes.parameterNoun(origin)} is "
                + "{typenames.typeArticle(declared)} {quotedDeclared} too.");
        } else if (!literalfixes.takesLiteral(origin.declared(), widening)) {
            fix.setMessage(fix.plain());
        }
    }
}

// Records the arguments of a method call that reach its result: those whose declared parameter
// type has a type parameter while the declared return type has one too. A generic instance's
// methods are judged as its template declares them.
noteFlowingMethodArguments(BodyChecker checker, CallExpressionNode node) {
    let access = nullguidance.accessStep(syntax.unwrapParentheses(node.callee()));
    if (access == null) {
        return;
    }
    let name = access.member();
    Type receiver = convert.coreOf(checker.recordedType(access.receiver()));
    if (receiver is InstantiationType) {
        receiver = receiver.template();
    }
    let methods = typemembers.methodsOf(receiver);
    if (name == null || methods == null) {
        return;
    }
    let arguments = node.arguments();
    for (let method in methods) {
        Signature signature = method.signature();
        if (method.name() != name || !convert.containsTypeParam(signature.returnType())) {
            continue;
        }
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    for (let parameter in parameters) {
                        if (parameter.name() == named.name().text()
                                && convert.containsTypeParam(parameter.type())) {
                            checker.targets().flowingArguments().push(named.span());
                        }
                    }
                },
                is Expression value -> {
                    if (i < parameters.length && convert.containsTypeParam(parameters[i].type())) {
                        checker.targets().flowingArguments().push(value.span());
                    }
                },
                default -> { },
            }
        }
    }
}

// Passes the refusals held inside a call to 'outer' when they lie in one of the 'flowing'
// arguments, or in any argument when 'all' is true, and reports the others.
public settleArguments(BodyChecker checker, List<DeferredLiteralFix> held, List<DeferredLiteralFix>? outer,
                       List<Span> flowing, bool all) {
    for (let fix in held) {
        if (outer == null) {
            if (fix.suffixed() == null) {
                checker.reporter().report(fix.message(), fix.span());
            }
            continue;
        }
        bool flows = all;
        for (let argument in flowing) {
            if (fix.span().start >= argument.start && fix.span().end() <= argument.end()) {
                flows = true;
            }
        }
        if (flows) {
            outer.push(fix);
        } else if (fix.suffixed() == null) {
            checker.reporter().report(fix.message(), fix.span());
        }
    }
}

analyzeCallOf(BodyChecker checker, CallExpressionNode node, Type? expected) -> Type {
    switch (node.callee()) {
        is MemberExpressionNode member -> {
            return methodcalls.analyzeMemberCall(checker, node, member, expected);
        },
        is SafeMemberExpressionNode member -> {
            return methodcalls.analyzeSafeMemberCall(checker, node, member);
        },
        is SuperExpressionNode chained -> {
            return methodcalls.analyzeSuperCall(checker, node, chained);
        },
        is IdentifierExpressionNode identifier -> {
            return analyzeFunctionCall(checker, node, identifier, expected);
        },
        default -> {
            Type calleeType = checker.analyzeExpression(node.callee());
            if (convert.coreOf(calleeType) is FunctionType) {
                return analyzeFunctionValueCall(checker, node, calleeType, "", node.callee().span());
            }
            let noValue = voidcalls.missingValueRefusal(checker, node.callee(), calleeType, "call");
            if (noValue != null) {
                checker.reporter().report(noValue, node.span());
            } else if (!(calleeType is ErrorType)) {
                checker.reporter().report("{wording.sideNamed(node.callee(), "This value")} has type "
                    + "{checker.names().quoted(calleeType)}, which is not a function type, so it cannot "
                    + "be called.", node.span());
            }
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
    }
}

// A call on a function value: ordinary call syntax on the value itself. A function type has
// no parameter names, so the arguments are positional and the call takes exactly as many as
// the type declares.
public analyzeFunctionValueCall(BodyChecker checker, CallExpressionNode node, Type calleeType,
                                string calleeName, Span calleeSpan) -> Type {
    string subject = "This function value";
    if (calleeName.length > 0) {
        subject = "'{calleeName}'";
    }
    let typeArguments = node.typeArguments();
    if (typeArguments != null) {
        checker.reporter().report("A function value takes no type arguments; its type "
            + "{checker.names().quoted(calleeType)} is already fixed. Remove the '<...>' list.",
            typeArguments.span());
    }
    if (calleeType is OptionalType) {
        checker.reporter().report(nullguidance.maybeNullRefusal(checker, "{subject} has type "
            + "{checker.names().quoted(calleeType)}, which", node.callee(), calleeType), calleeSpan);
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    if (!(calleeType is FunctionType)) {
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    Type[] parameters = calleeType.parameterTypes();
    let arguments = node.arguments();
    long count = arguments.argumentsCount();
    bool counted = count == parameters.length;
    if (!counted) {
        string[] unnamed = [];
        string quotedCallee = checker.names().quoted(calleeType);
        checker.reporter().report(calls.countRefusal("{subject} has type {quotedCallee}, "
            + "so it takes", parameters.length, parameters.length, count, "argument", unnamed),
            node.span());
    }
    for (long i = 0; i < count; i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                checker.reporter().report("A function type has no parameter names, so a function "
                    + "value takes its arguments by position. Write the values in order, "
                    + "without '{named.name().text()}:'.", named.span());
                let ignored = analyzeWithoutParameter(checker, named.value(), false);
            },
            is OutArgumentNode outArgument -> {
                checker.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                if (counted) {
                    Type parameterType = parameters[i];
                    LiteralOrigin? origin = null;
                    if (valuejoins.mayAdaptLiteral(value)) {
                        origin = new LiteralOrigin(OriginKind.Parameter, "", calleeName, parameterType);
                    }
                    Type actual = checker.analyzeExpressionAdapt(value, parameterType, origin);
                    let noValue = voidcalls.argumentRefusal(checker, value, actual,
                        identifiers.functionValueName(checker, calleeName), parameterType);
                    if (!(parameterType is ErrorType) && noValue != null) {
                        checker.reporter().report(noValue, value.span());
                    } else if (!(parameterType is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(parameterType, actual)) {
                        checker.reporter().report(argumentMismatch("{i + 1}",
                            identifiers.functionValueName(checker, calleeName), "", parameterType, actual,
                            checker.names())
                            + "{nullguidance.valueAssignabilityHint(checker, parameterType, actual, value)}",
                            value.span());
                    }
                } else {
                    let ignored = analyzeWithoutParameter(checker, value, false);
                }
            },
            default -> { },
        }
    }
    return calleeType.returnType();
}

analyzeFunctionCall(BodyChecker checker, CallExpressionNode node, IdentifierExpressionNode identifier,
                    Type? expected) -> Type {
    string name = identifier.name().text();
    let primitive = types.primitiveNamed(checker.store(), name);
    if (primitive != null) {
        identifiers.reportTypeAsCall(checker, name, primitive, identifier.span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    let resolution = checker.resolveName(name);
    if (resolution == null) {
        if (identifiers.isRefusedImport(checker, name)) {
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        let declaring = identifiers.staticSuggestionOwner(checker, name);
        if (declaring != null) {
            checker.reporter().report(identifiers.staticWithoutType(checker, name, declaring,
                argumentsSpelling(node.arguments())), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        let member = identifiers.instanceMemberWithoutObject(checker, name,
            argumentsSpelling(node.arguments()), null);
        if (member != null) {
            checker.reporter().report(member, identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        let kept = checker.preludeScope().hidden(name, checker.modulePath(), checker.packagePrefix());
        if (kept != null) {
            checker.reporter().report(types.notVisibleMessage("Function", name, kept.visibility(),
                kept.modulePath(), kept.packagePrefix(), checker.packagePrefix(),
                checker.isEditableModule(kept.modulePath())), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        }
        checker.reporter().report("Undefined function '{name}'. Check the spelling, or import "
            + "the module that declares it.", identifier.span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    switch (resolution) {
        is FunctionName functions -> {
            let offered = functions.fromPrelude();
            if (offered != null && offered.isAmbiguous()) {
                checker.reporter().report(
                    prelude.ambiguousMessage(name, offered.importPaths(checker.names())),
                    identifier.span());
                analyzeArgumentsOnly(checker, node.arguments());
                return checker.store().errorType();
            }
            string declaringFile = checker.context().module().filePath();
            if (offered != null) {
                let declaring = checker.contextsByPath().get(offered.modulePaths()[0]);
                if (declaring != null) {
                    declaringFile = declaring.module().filePath();
                }
            }
            checker.result().setCallableFile(identifier.green(), declaringFile);
            return dispatchFunctionCall(checker, node, identifier, name, functions.entries(), expected);
        },
        is TypeName named -> {
            if (types.isStructLike(named.target())) {
                return construction.analyzeStructConstructorCall(checker, node, named.target(), name);
            }
            identifiers.reportTypeAsCall(checker, name, named.target(), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is TypeParameterName held -> {
            identifiers.reportTypeParameterRefusal(checker, "'{name}' is a type parameter, not a function.",
                held.parameter(), identifier.span(), NamePosition.Call);
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is LocalName ignored -> {
            Type calleeType = checker.analyzeExpression(identifier);
            if (convert.coreOf(calleeType) is FunctionType) {
                return analyzeFunctionValueCall(checker, node, calleeType, name, identifier.span());
            }
            if (!(calleeType is ErrorType)) {
                checker.reporter().report("'{name}' has type {checker.names().quoted(calleeType)}, "
                    + "which is not a function type, so it cannot be called.",
                    identifier.span());
            }
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
        is NamespaceName module -> {
            identifiers.reportModuleAsCall(checker, name, module.targetModulePath(), identifier.span());
            analyzeArgumentsOnly(checker, node.arguments());
            return checker.store().errorType();
        },
    }
}

dispatchFunctionCall(BodyChecker checker, CallExpressionNode node, IdentifierExpressionNode identifier,
                     string name, List<FunctionEntry> entries, Type? expected) -> Type {
    let first = entries.get(0);
    if (first.isExternal()) {
        checker.result().setCallable(identifier.green(), first.signature());
        return analyzeExternalCall(checker, node, first, name);
    }
    if (first.signature().isGeneric()) {
        checker.result().setCallable(identifier.green(), first.signature());
        return analyzeGenericCall(checker, node, first, name, expected);
    }
    if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
        let candidates = new List<CallCandidate>();
        for (long i = 0; i < entries.length(); i++) {
            candidates.push(new CallCandidate(entries.get(i).signature(), null, true));
        }
        let built = buildCallShape(checker, node, node.arguments(), candidates);
        let resolved = resolveBuiltCall(checker, candidates, built, node.span(), name, "Function");
        if (resolved.failed()) {
            return checker.store().errorType();
        }
        let chosen = resolved.chosen();
        if (chosen != null) {
            checker.result().setCallable(identifier.green(), chosen.signature());
        }
        return checkResolvedArguments(checker, built, resolved, node.green());
    }
    checker.result().setCallable(identifier.green(), first.signature());
    return checkDirectArguments(checker, "Function", name, first.signature(), node.arguments(),
        node.span(), null);
}

// A namespace-qualified free-function call, or null when the member is not a function of
// the target module (the member then resolves as a type reference).
public analyzeNamespaceFunctionCall(BodyChecker checker, CallExpressionNode node, MemberExpressionNode member,
                                    string targetPath, string memberName, Type? expected) -> Type? {
    let target = checker.contextsByPath().get(targetPath);
    if (target == null) {
        return null;
    }
    let entries = target.functions().entriesNamed(memberName);
    if (entries == null || entries.length() == 0) {
        return null;
    }
    string targetPackagePrefix = target.module().packagePrefix();
    checker.result().setCallableFile(member.green(), target.module().filePath());
    if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
        let candidates = new List<CallCandidate>();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            candidates.push(new CallCandidate(entry.signature(), null,
                types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                    checker.modulePath(), checker.packagePrefix())));
        }
        let built = buildCallShape(checker, node, node.arguments(), candidates);
        let resolved = resolveBuiltCall(checker, candidates, built,
            node.span(), memberName, "Function");
        if (resolved.failed()) {
            return checker.store().errorType();
        }
        let chosen = resolved.chosen();
        if (chosen == null) {
            return checker.store().errorType();
        }
        checker.result().setCallable(member.green(), chosen.signature());
        if (!chosen.isAccessible()) {
            Visibility chosenVisibility = Visibility.Private;
            for (long i = 0; i < entries.length(); i++) {
                if (entries.get(i).signature() == chosen.signature()) {
                    chosenVisibility = entries.get(i).visibility();
                }
            }
            checker.reporter().report(types.notVisibleMessage("Function", memberName,
                chosenVisibility, targetPath, targetPackagePrefix, checker.packagePrefix(),
                target.module().isEditable()), member.member().span());
            analyzeUnchosenArguments(checker, built);
            return checker.store().errorType();
        }
        return checkResolvedArguments(checker, built, resolved, node.green());
    }
    let entry = entries.get(0);
    if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
            checker.modulePath(), checker.packagePrefix())) {
        checker.reporter().report(types.notVisibleMessage("Function", memberName,
            entry.visibility(), targetPath, targetPackagePrefix, checker.packagePrefix(),
            target.module().isEditable()), member.member().span());
        analyzeArgumentsOnly(checker, node.arguments());
        return checker.store().errorType();
    }
    checker.result().setCallable(member.green(), entry.signature());
    if (entry.isExternal()) {
        return analyzeExternalCall(checker, node, entry, memberName);
    }
    if (targetPath == "std.ffi" && memberName == "fromCString") {
        return checkFromCStringCall(checker, node.arguments(), node.span());
    }
    if (entry.signature().isGeneric()) {
        return analyzeGenericCall(checker, node, entry, memberName, expected);
    }
    return checkDirectArguments(checker, "Function", memberName, entry.signature(),
        node.arguments(), node.span(), null);
}

// std.ffi.fromCString accepts a value of any external type - there is no common supertype to
// write in its signature, hence the intercepted type parameter - and returns a string?. A null
// handle yields a null string, so an unset value stays distinct from an empty one. Because the
// call is checked here it is never routed through generic instantiation.
checkFromCStringCall(BodyChecker checker, ArgumentListNode arguments, Span callSpan) -> Type {
    Type result = checker.store().optionalOf(checker.store().stringType());
    long count = arguments.argumentsCount();
    if (count != 1) {
        checker.reporter().report(fromCStringCountRefusal(count), callSpan);
        analyzeArgumentsOnly(checker, arguments);
        return result;
    }
    switch (arguments.arguments(0)) {
        is OutArgumentNode outArgument -> {
            checker.reporter().report("'out' can only be used when calling an external "
                + "function. Remove 'out' from the argument.", outArgument.span());
        },
        is Expression value -> {
            Type actual = checker.analyzeExpression(value);
            Type base = actual;
            if (base is OptionalType) {
                base = base.inner();
            }
            if (!(actual is ErrorType) && !(base is ExternalType)) {
                checker.reporter().report("'fromCString' takes a value of an external type, but "
                    + "{wording.sideNamed(value, "this value")} has type {checker.names().quoted(actual)}. "
                    + "Pass it the value a C function returned.", value.span());
            }
        },
        default -> { },
    }
    return result;
}

// A call to a generic function, whose pending arguments are settled once whatever path the call takes.
analyzeGenericCall(BodyChecker checker, CallExpressionNode node, FunctionEntry entry, string name,
                   Type? expected) -> Type {
    let pending = new PendingArguments(node.arguments());
    Type result = checkGenericCall(checker, node, entry, name, expected, pending);
    pending.settle(checker);
    return result;
}

checkGenericCall(BodyChecker checker, CallExpressionNode node, FunctionEntry entry, string name,
                 Type? expected, PendingArguments pending) -> Type {
    let signature = entry.signature();
    let arguments = node.arguments();
    Parameter[] declared = signature.parameters();
    bool genericResult = convert.containsTypeParam(signature.returnType());
    for (long i = 0; i < arguments.argumentsCount() && i < declared.length; i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression && genericResult && convert.containsTypeParam(declared[i].type())) {
            checker.targets().flowingArguments().push(argument.span());
        }
    }
    if (usesNamedArguments(arguments)) {
        checker.reporter().report("'{name}' is generic, and a call to a generic function cannot name its "
            + "arguments. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
            node.span());
        analyzeArgumentsOnly(checker, arguments);
        return checker.store().errorType();
    }
    let owner = signature.declaration();
    if (owner == null) {
        return signature.returnType();
    }
    let typeParameters = signature.typeParameters();
    long arity = typeParameters.length;
    let typeArguments = new List<Type?>();
    for (long i = 0; i < arity; i++) {
        typeArguments.push(null);
    }
    let explicitList = node.typeArguments();
    if (explicitList != null) {
        long given = explicitList.argumentsCount();
        if (given != arity) {
            let names = new List<string>();
            for (let parameter in typeParameters) {
                names.push(parameter.name());
            }
            checker.reporter().report(calls.countRefusal("Generic function '{name}' takes", arity, arity,
                given, "type argument", names.toArray()), node.span());
            analyzeArgumentsOnly(checker, arguments);
            return checker.store().errorType();
        }
        for (long i = 0; i < arity; i++) {
            typeArguments.set(i, checker.resolver().resolveTypeArgument(explicitList.arguments(i),
                typeParameters[i].name(), name));
        }
    }

    bool typesWritten = explicitList != null;
    long reportedBefore = checker.reporter().reportedCount();
    let offered = offeredTypes(checker, arguments, List.of([signature]), typesWritten, pending);
    let argumentTypes = offered.types;
    bool refusedArgument = offered.refused;
    long waiting = offered.pendingFrom;

    Parameter[] parameters = signature.parameters();
    let inference = new TypeArgumentInference(checker.store(), owner, arity);
    if (explicitList == null) {
        for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
            inference.unifyArgument(i, parameters[i].type(), argumentTypes.get(i));
        }
        for (long i = 0; i < arity; i++) {
            typeArguments.set(i, inference.binding(i));
        }
    }

    let resolved = new List<Type>();
    for (long i = 0; i < arity; i++) {
        let argument = typeArguments.get(i);
        // A call with the wrong number of arguments is refused for the count first: an argument it leaves out
        // may be what gives the type argument its type, and an extra one has no parameter to bind. The count
        // does not depend on the type of any argument, so it is refused even where one is.
        if (argument == null && !calls.acceptsArgumentCount(signature, arguments.argumentsCount())) {
            checker.reporter().report(calls.arityRefusal("Function '{name}'", signature,
                arguments.argumentsCount()), node.span());
            return checker.store().errorType();
        }
        if (argument == null && refusedArgument) {
            return checker.store().errorType();
        }
        if (argument == null) {
            bool untyped = voidtypearguments.inferFromLambdas(checker, arguments, parameters, inference);
            pending.checkLambdasWith(parameters, inference);
            pending.settle(checker);
            bool refusedVoid = voidtypearguments.reportVoidTypeArgument(checker, arguments, parameters,
                argumentTypes, inference, typeParameters, "'{name}'");
            if (refusedVoid) {
                return checker.store().errorType();
            }
            string unshown = "'{name}' is generic, and this call does not show what its type "
                + "argument '{typeParameters[i].name()}' is.";
            if (untyped) {
                checker.reporter().report(unshown, node.span());
                return checker.store().errorType();
            }
            let listed = staticmembers.writtenTypeArguments(checker, inference,
                contextInference(checker, owner, arity, signature.returnType(), expected), arity,
                node.arguments(), parameters, typeParameters);
            if (listed == null) {
                checker.reporter().report(unshown, node.span());
                return checker.store().errorType();
            }
            string write = "Write it";
            if (arity > 1) {
                write = "Write its type arguments";
            }
            string spelled = exampleArguments(checker, node.arguments(), reportedBefore);
            checker.reporter().report("{unshown} {write}, as in '{name}<{listed}>{spelled}'.", node.span());
            return checker.store().errorType();
        }
        resolved.push(argument);
    }
    Type[] resolvedArguments = resolved.toArray();

    bool bounded = true;
    for (long i = 0; i < arity; i++) {
        Span at = node.span();
        if (explicitList != null && i < explicitList.argumentsCount()) {
            at = explicitList.arguments(i).span();
        }
        if (!checker.resolver().checkArgumentBounds(typeParameters[i], resolvedArguments, at)) {
            bounded = false;
        }
    }

    long count = arguments.argumentsCount();
    long required = calls.requiredArgumentCount(signature);
    if (count < required || count > parameters.length) {
        checker.reporter().report(calls.arityRefusal("Function '{name}'", signature, count), node.span());
        return checker.store().substitute(signature.returnType(), owner, resolvedArguments);
    }
    for (long i = 0; i < count && i < parameters.length; i++) {
        let argument = arguments.arguments(i);
        if (argument is Expression) {
            Type parameterType = checker.store().substitute(parameters[i].type(), owner, resolvedArguments);
            Type actual = argumentTypes.get(i);
            let origin = literalfixes.argumentOrigin(checker, argument, signature, i, parameterType);
            if (argument is LambdaExpressionNode && checker.inTrial()) {
                continue;
            }
            if (waitsForParameter(argument, typesWritten)) {
                actual = checker.analyzeExpressionAdapt(argument, parameterType, origin);
            } else {
                if (i >= waiting) {
                    actual = checker.analyzeExpression(argument);
                }
                literaltyping.adaptIntegerLiteral(checker, argument, parameterType, origin);
                literaltyping.adaptCharLiteral(checker, argument, parameterType, origin);
                literaltyping.adaptFloatLiteral(checker, argument, parameterType, origin);
                let updated = checker.result().typeOf(argument.green());
                if (updated != null) {
                    actual = checker.readAs(argument, updated, parameterType);
                }
            }
            let noValue = voidcalls.argumentRefusal(checker, argument, actual, "'{name}'",
                parameterType);
            if (!(parameterType is ErrorType) && noValue != null) {
                checker.reporter().report(noValue, argument.span());
            } else if (!(parameterType is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(parameterType, actual)) {
                string provenance = "";
                if (explicitList == null) {
                    provenance = inference.provenance(parameters[i].type(), name, "(...)", checker.names());
                }
                string hint = nullguidance.valueAssignabilityHint(checker, parameterType, actual, argument);
                checker.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameters[i].name(),
                    parameterType, actual, checker.names()) + "{hint}{provenance}", argument.span());
            }
        }
    }
    pending.analyzedBefore(parameters.length);

    if (bounded) {
        checker.result().setCallTypeArguments(node.green(), resolvedArguments);
        checker.recordGenericCall(signature, resolvedArguments, node.span());
    }
    return checker.store().substitute(signature.returnType(), owner, resolvedArguments);
}

// An external call: exact arity, no named arguments, and 'out' parameters take an
// initialized non-constant local of exactly the parameter's type.
analyzeExternalCall(BodyChecker checker, CallExpressionNode node, FunctionEntry entry, string name) -> Type {
    let signature = entry.signature();
    let arguments = node.arguments();
    if (usesNamedArguments(arguments)) {
        checker.reporter().report("External function '{name}' takes its arguments by position, so a call "
            + "cannot name them. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
            node.span());
        analyzeArgumentsOnly(checker, arguments);
        return signature.returnType();
    }
    Parameter[] parameters = signature.parameters();
    long count = arguments.argumentsCount();
    if (count != parameters.length) {
        checker.reporter().report(calls.arityRefusal("External function '{name}'", signature, count),
            node.span());
        for (long i = 0; i < count; i++) {
            analyzeUncountedExternalArgument(checker, arguments.arguments(i));
        }
        return signature.returnType();
    }
    for (long i = 0; i < count; i++) {
        let argument = arguments.arguments(i);
        let parameter = parameters[i];
        if (parameter.isOut()) {
            if (argument is OutArgumentNode) {
                checkOutArgument(checker, argument, parameter, name, i);
            } else if (argument is Expression) {
                string example = "out result";
                if (parameter.name().length > 0) {
                    example = "out {parameter.name()}";
                }
                string fix = "Declare a local variable and write 'out' before it, as in '{example}'.";
                if (syntax.unwrapParentheses(argument) is IdentifierExpressionNode) {
                    fix = "Write 'out {wording.oneLineSpelling(syntax.unwrapParentheses(argument))}'.";
                }
                checker.reporter().report("{parameterSubject(parameter, i)} of '{name}' is an 'out' "
                    + "parameter, so it needs a variable to store into. {fix}", argument.span());
                checker.analyzeExpression(argument);
            }
            continue;
        }
        if (argument is OutArgumentNode) {
            checker.reporter().report("{parameterSubject(parameter, i)} of '{name}' is not an 'out' "
                + "parameter. Remove 'out' from '{wording.greenSpelling(argument.green())}'.",
                argument.span());
            continue;
        }
        if (argument is Expression) {
            Type actual = checker.analyzeExpressionAdapt(argument, parameter.type(),
                literalfixes.argumentOrigin(checker, argument, signature, i, parameter.type()));
            let noValue = voidcalls.argumentRefusal(checker, argument, actual, "'{name}'",
                parameter.type());
            if (!(parameter.type() is ErrorType) && noValue != null) {
                checker.reporter().report(noValue, argument.span());
            } else if (!(parameter.type() is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(parameter.type(), actual)) {
                checker.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameter.name(),
                    parameter.type(), actual, checker.names())
                    + "{nullguidance.valueAssignabilityHint(checker, parameter.type(), actual, argument)}",
                    argument.span());
            }
        }
    }
    return signature.returnType();
}

checkOutArgument(BodyChecker checker, OutArgumentNode argument, Parameter parameter, string name,
                 long index) {
    string outName = argument.name().text();
    let binding = checker.lookupBinding(outName);
    if (binding == null) {
        string quotedType = checker.names().quoted(parameter.type());
        string declare = "Declare it first as a local variable of type {quotedType}.";
        if (convert.isNumericType(parameter.type())) {
            string example = checker.names().quotedCode(["", " {outName} = 0;"], [parameter.type()]);
            declare = "Declare it first, as in {example}.";
        }
        checker.reporter().report("'{outName}' in 'out {outName}' is not a local variable or a parameter. "
            + declare, argument.span());
        return;
    }
    bool refused = lambdas.reportCapturedOut(checker, binding, argument.span());
    if (!refused && binding.isConst()) {
        checker.reporter().report(assignments.constantRefusal(checker, "Cannot pass '{outName}' as 'out'",
            binding), argument.span());
        refused = true;
    }
    checker.result().setBinding(argument.green(), binding);
    if (binding.type() != parameter.type()) {
        string wanted = checker.names().quotedCode(["out ", ""], [parameter.type()]);
        checker.reporter().report("{parameterSubject(parameter, index)} of '{name}' is {wanted}, but "
            + "'{outName}' has type {checker.names().quoted(binding.type())}. Pass a variable of "
            + "type {checker.names().quoted(parameter.type())}.", argument.span());
        return;
    }
    // A refused write never runs, so it changes no narrowing.
    if (!refused) {
        narrowing.recordOutWrite(checker, binding, argument.span(), name);
    }
}

// Analyzes an argument of an external call refused for its count, against no parameter.
analyzeUncountedExternalArgument(BodyChecker checker, Argument argument) {
    switch (argument) {
        is OutArgumentNode outArgument -> {
            let binding = checker.lookupBinding(outArgument.name().text());
            if (binding != null) {
                checker.result().setBinding(outArgument.green(), binding);
            }
        },
        is Expression value -> {
            let ignored = analyzeWithoutParameter(checker, value, false);
        },
        default -> { },
    }
}

// The refusal of a 'fromCString' call that passes 'count' arguments.
fromCStringCountRefusal(long count) -> string {
    string refusal = "'fromCString' takes one argument, a handle a C function returned, but this call "
        + "passes {diagnostics.countWord(count)}.";
    if (count == 0) {
        return "{refusal} Pass the handle.";
    }
    if (count == 2) {
        return "{refusal} Remove the extra argument.";
    }
    return "{refusal} Remove the extra arguments.";
}

public usesNamedArguments(ArgumentListNode arguments) -> bool {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (arguments.arguments(i) is NamedArgumentNode) {
            return true;
        }
    }
    return false;
}

// Whether the argument is an operator or a join holding a floating-point literal too large for
// 'float', whose fix names the parameter the argument is passed to.
carriesOverflowingFloat(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    if (core is BinaryExpressionNode) {
        return overflowsFloatWithin(core.left()) || overflowsFloatWithin(core.right());
    }
    if (core is TernaryExpressionNode) {
        return overflowsFloatWithin(core.thenValue()) || overflowsFloatWithin(core.elseValue());
    }
    return false;
}

// Whether the value is, or holds as an operand or a branch, a floating-point literal too large for
// 'float'.
overflowsFloatWithin(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    let literal = literaltyping.floatLiteralOf(core);
    if (literal != null) {
        return literalfixes.literalOverflows(literal, PrimitiveKind.Float);
    }
    return carriesOverflowingFloat(core);
}

// The types the arguments of a generic call offer the inference of its type arguments, the error type
// for each one that offers none, whether one of them is refused, and the index of the argument from
// which on they are analyzed again once the type arguments are known.
public final class OfferedTypes {
    protected List<Type> types;
    protected bool refused;
    protected long pendingFrom;

    protected constructor(this.types, this.refused, this.pendingFrom);

    public argumentTypes() -> List<Type> {
        return this.types;
    }

    public anyRefused() -> bool {
        return this.refused;
    }

    public pending() -> long {
        return this.pendingFrom;
    }
}

// Analyzes the arguments of a generic call to one of 'signatures' in written order, as ArgumentOrder
// does, and returns the types they offer. With the type arguments 'written', the arguments from the
// first that waits and is no lambda on are analyzed once those types are resolved.
public offeredTypes(BodyChecker checker, ArgumentListNode arguments, List<Signature> signatures,
                    bool written, PendingArguments pending) -> OfferedTypes {
    let types = new List<Type>();
    bool refused = false;
    long count = arguments.argumentsCount();
    let order = new ArgumentOrder(checker, false);
    for (long i = 0; i < count; i++) {
        order.reach(i);
        let argument = arguments.arguments(i);
        let analyzer = order.analyzer();
        Type offered = checker.store().errorType();
        if (argument is LambdaExpressionNode) {
            analyzer.noteLambdaStart(argument);
        } else if (argument is Expression && waitsForParameter(argument, written)) {
            if (written) {
                pending.start(i, written);
                return new OfferedTypes(paddedTypes(checker, types, count), refused, i);
            }
            let target = knownParameterType(signatures, i);
            if (!takesArgumentAt(signatures, i)) {
                let ignored = analyzer.placeArgument(argument, checker.store().errorType());
            } else if (target != null && signatures.length() == 1) {
                order.place(argument, target,
                    literalfixes.argumentOrigin(analyzer, argument, signatures.get(0), i, target));
            } else {
                order.place(argument, target);
            }
            let given = argumentshapes.valuesType(order.analyzer(), argument);
            if (given != null) {
                refused = refused || given is ErrorType;
                offered = given;
            }
        } else if (argument is Expression) {
            Type analyzed = analyzer.analyzeExpression(argument);
            refused = refused || analyzed is ErrorType;
            offered = offeredType(analyzer, argument, analyzed);
        }
        types.push(offered);
    }
    long pendingFrom = order.finish(count);
    pending.start(pendingFrom, written);
    return new OfferedTypes(types, refused, pendingFrom);
}

// 'types' with the error type added for each argument up to 'count' it has no type for.
paddedTypes(BodyChecker checker, List<Type> types, long count) -> List<Type> {
    while (types.length() < count) {
        types.push(checker.store().errorType());
    }
    return types;
}

// The type every one of 'signatures' that has a parameter at 'index' gives it, where none of them puts
// a type parameter in it, or null where two give different types or one puts a type parameter in it.
knownParameterType(List<Signature> signatures, long index) -> Type? {
    Type? known = null;
    for (let signature in signatures) {
        Parameter[] parameters = signature.parameters();
        if (index >= parameters.length) {
            continue;
        }
        Type type = parameters[index].type();
        if (convert.containsTypeParam(type) || (known != null && known != type)) {
            return null;
        }
        known = type;
    }
    return known;
}

// Whether one of 'signatures' has a parameter at 'index'.
takesArgumentAt(List<Signature> signatures, long index) -> bool {
    for (let signature in signatures) {
        if (index < signature.parameters().length) {
            return true;
        }
    }
    return false;
}

// The arguments of a generic call that the call has not analyzed yet, from the first that waits for
// its parameter on. The call settles them once whatever path it takes: where it chose a candidate, the
// ones beyond the parameters it analyzed them against, and where it is refused, each one against no
// parameter, so their problems are reported with the refusal. A refusal that settles the type parameters
// of a lambda's parameters has the lambda checked against them too, and any other lambda the call did
// not analyze has its body checked without types.
public final class PendingArguments {
    protected ArgumentListNode arguments;
    protected long from;
    protected long lambdasFrom = 0;
    protected bool written = false;
    protected Parameter[] parameters = [];
    protected TypeArgumentInference? inference = null;
    protected bool settled = false;

    public constructor(this.arguments) {
        this.from = arguments.argumentsCount();
    }

    // Starts with the arguments from 'from' on pending, where 'written' says whether the call writes its
    // type arguments.
    protected start(long from, bool written) {
        this.from = from;
        this.written = written;
    }

    // Has each lambda checked against the parameter types 'inference' settles from 'parameters'.
    public checkLambdasWith(Parameter[] parameters, TypeArgumentInference inference) {
        this.parameters = parameters;
        this.inference = inference;
    }

    // Leaves to the call the arguments before 'count', which it analyzed against the parameters of the
    // candidate it chose.
    public analyzedBefore(long count) {
        if (count > this.from) {
            this.from = count;
        }
        this.lambdasFrom = count;
    }

    // Leaves every argument to the call, which hands them to a resolution that analyzes them.
    public handedOver() {
        this.from = this.arguments.argumentsCount();
        this.lambdasFrom = this.from;
    }

    // Analyzes each argument still pending, once: outside a trial, each lambda from 'lambdasFrom' on
    // against the parameter types the inference settles, or without types where it settles none, and each
    // other one from 'from' on that is not analyzed yet.
    public settle(BodyChecker checker) {
        if (this.settled) {
            return;
        }
        this.settled = true;
        for (long i = 0; i < this.arguments.argumentsCount(); i++) {
            let argument = this.arguments.arguments(i);
            let inference = this.inference;
            if (argument is LambdaExpressionNode) {
                if (checker.inTrial() || i < this.lambdasFrom) {
                    continue;
                }
                if (inference != null && i < this.parameters.length) {
                    voidtypearguments.checkRefusedLambda(checker, argument, this.parameters[i], inference);
                } else {
                    lambdas.checkBodyWithoutTypes(checker, argument);
                }
            } else if (argument is Expression && i >= this.from && !checker.takePlaced(argument)) {
                let ignored = analyzeWithoutParameter(checker, argument, this.written);
            }
        }
    }
}

// Analyzes the argument 'value' of a generic call where it is checked against no parameter: one with a
// type of its own for that type, and one that waits for its parameter against no type, which checks
// what is inside it and reports nothing about the value itself.
analyzeWithoutParameter(BodyChecker checker, Expression value, bool written) -> Type {
    if (waitsForParameter(value, written)) {
        return checker.analyzeExpressionAdapt(value, checker.store().errorType());
    }
    return checker.analyzeExpression(value);
}

// Whether an argument of a generic call is analyzed once its parameter type is known. With the type
// arguments 'written', an array literal is too, so that its literals take the element type.
public waitsForParameter(Expression value, bool written) -> bool {
    return syntax.needsTargetType(value)
        || (written && syntax.unwrapParentheses(value) is ArrayLiteralExpressionNode);
}

// The type arguments that 'expected', the type the call's value is given to, gives through 'returned',
// the type the call returns, or null where there is no such type.
contextInference(BodyChecker checker, GreenNode owner, long arity, Type returned, Type? expected)
        -> TypeArgumentInference? {
    if (expected == null) {
        return null;
    }
    let context = new TypeArgumentInference(checker.store(), owner, arity);
    context.unifyArgument(0, returned, expected);
    return context;
}

// "Parameter 'result'", or "Parameter 2" for the parameter at 'index' when it has no name.
parameterSubject(Parameter parameter, long index) -> string {
    if (parameter.name().length > 0) {
        return "Parameter '{parameter.name()}'";
    }
    return "Parameter {index + 1}";
}

// The source text of one argument on one line.
argumentSpelling(Argument argument) -> string {
    switch (argument) {
        is NamedArgumentNode named -> {
            return wording.greenSpelling(named.green());
        },
        is OutArgumentNode written -> {
            return wording.greenSpelling(written.green());
        },
        is Expression value -> {
            return wording.oneLineSpelling(value);
        },
        default -> {
            return "";
        },
    }
}

// The argument list of a call with the names of its named arguments removed, when it is short, or '(...)'.
positionalSpelling(ArgumentListNode arguments) -> string {
    string listed = "";
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                listed = listed + wording.oneLineSpelling(named.value());
            },
            default -> {
                listed = listed + argumentSpelling(arguments.arguments(i));
            },
        }
    }
    if (listed.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return "({listed})";
}

// The arguments an example of a call writes: as the call writes them, or '(...)' where analyzing them
// reported a problem since 'reportedBefore' problems were reported, which the example would repeat.
public exampleArguments(BodyChecker checker, ArgumentListNode arguments, long reportedBefore) -> string {
    if (checker.reporter().reportedCount() > reportedBefore) {
        return "(...)";
    }
    return argumentsSpelling(arguments);
}

// The argument list of a call as written when it is short, or '(...)'.
public argumentsSpelling(ArgumentListNode? arguments) -> string {
    if (arguments == null) {
        return "()";
    }
    string spelled = wording.greenSpelling(arguments.green());
    if (spelled.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return spelled;
}

// The refusal of a 'try' before 'operand', which is not a call. The fix moves the 'try' to a call on
// one side of an operator.
misplacedTryRefusal(Expression operand) -> string {
    let spelled = wording.shortSpelling(operand);
    if (spelled == null) {
        return "'try' must be written directly before a call. Move 'try' to the call that can throw.";
    }
    string opening = "'try' must be written directly before a call, and '{spelled}' is not a call.";
    let inner = syntax.unwrapParentheses(operand);
    if (inner is BinaryExpressionNode) {
        string left = wording.oneLineSpelling(inner.left());
        string right = wording.oneLineSpelling(inner.right());
        string operator = inner.operator().text();
        if (inner.right() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in '{left} {operator} try {right}'.";
        }
        if (inner.left() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in 'try {left} {operator} {right}'.";
        }
    }
    return "{opening} Move 'try' to the call that can throw.";
}

// The refusal of argument 'label' of 'callee', whose type 'actual' is not the type 'expected' of the
// parameter it is passed to, named 'parameter' when the parameter has a name.
public argumentMismatch(string label, string callee, string parameter, Type expected, Type actual,
                        TypeNames names) -> string {
    string given = "Argument {label} of {callee} has type {names.quoted(actual)}";
    if (parameter.length == 0) {
        string wanted = names.of(expected);
        return "{given}, but {callee} takes {typenames.typeArticle(wanted)} {names.quoted(expected)} there.";
    }
    return "{given}, but parameter '{parameter}' has type {names.quoted(expected)}.";
}

// How a refusal names the callee of 'kindWord' spelled 'displayName' after the word "of".
calleeObject(string kindWord, string displayName) -> string {
    if (kindWord == "Constructor" || kindWord == "Base constructor") {
        return "the constructor of '{displayName}'";
    }
    return "'{displayName}'";
}
