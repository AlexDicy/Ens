// Lambdas: the shape a lambda takes from the function type it is written for, its body checked in a
// frame of its own, and the locals and 'this' it captures. A write that lands on a lambda's copy, or
// on a sibling field inside a field default, is refused here too.
import BlockNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArrayLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralFieldNode from @ens.frontend.syntax.generated.nodes;
import NamedArgumentNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import ListNode from @ens.frontend.syntax.generated.nodes;
import AssignmentExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import Scope from model.scopes;
import LocalBinding from model.scopes;
import BindingKind from model.scopes;
import LambdaCapture from model.lambdas;
import LambdaInfo from model.lambdas;
import NarrowingPath from model.narrow;
import NarrowingState from model.narrow;
import model.convert;
import model.flow;
import ExitScope from model.flow;
import OriginKind from phases.bodies.literaltargets;
import phases.bodies.functionvalues;
import phases.bodies.thisuses;
import ThisUse from result;
import ThisUseKind from result;
import phases.bodies.literalfixes;
import phases.bodies.narrowing;
import phases.bodies.nullguidance;
import phases.bodies.wording;
import phases.bodies.voidcalls;
import Parameter from model.typemembers;
import Signature from model.typemembers;
import model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import FunctionType from model.types;
import OptionalType from model.types;
import PrimitiveType from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import StringBuilder from @std.text.stringbuilder;
import BodyChecker from phases.bodies;
import AssignmentFlow from phases.bodies.definiteassignment;
import support.syntax;

// What holds where a lambda is created, which its body starts from: the locals and the fields assigned
// there, the narrowings proven there, and the 'is' tests to write for comparisons of 'as?' casts with null.
public final class LambdaStart {
    protected AssignmentFlow assigned;
    protected Map<NarrowingPath, Type> proofs;
    protected Map<NarrowingPath, string> castHints;

    public constructor(this.assigned, this.proofs, this.castHints);
}

// One lambda whose body is being checked: the lambda, the scope and the receiver outside it, the
// proofs made outside it that hold inside it and the ones that do not, whether a statement can go
// right before it, and what its body has read from the scope or the receiver so far. The captures
// accumulate in first-read order, which is the order the closure copies them in.
public final class LambdaFrame {
    protected LambdaExpressionNode lambdaNode;
    protected Scope? enclosingScope;
    protected Type? enclosingReceiver;
    protected Map<NarrowingPath, Type> carriedNarrowings;
    protected Map<NarrowingPath, Type> uncarriedNarrowings;
    protected bool statementsBefore;
    protected List<LambdaCapture> captures;
    protected List<LocalBinding> capturedBindings;
    protected bool readsReceiver;

    protected constructor(LambdaExpressionNode lambdaNode, Scope? enclosingScope, Type? enclosingReceiver,
                          Map<NarrowingPath, Type> carriedNarrowings,
                          Map<NarrowingPath, Type> uncarriedNarrowings, bool statementsBefore) {
        this.lambdaNode = lambdaNode;
        this.enclosingScope = enclosingScope;
        this.enclosingReceiver = enclosingReceiver;
        this.carriedNarrowings = carriedNarrowings;
        this.uncarriedNarrowings = uncarriedNarrowings;
        this.statementsBefore = statementsBefore;
        this.captures = new List<LambdaCapture>();
        this.capturedBindings = new List<LocalBinding>();
        this.readsReceiver = false;
    }

    // The type a proof made where the lambda is created gives 'path', where the proof does not hold
    // inside it, or null.
    public uncarriedProof(NarrowingPath path) -> Type? {
        return this.uncarriedNarrowings.get(path);
    }

    public lambda() -> LambdaExpressionNode {
        return this.lambdaNode;
    }

    // Whether a statement can go right before the lambda, where a local can be declared for it.
    public allowsStatementsBefore() -> bool {
        return this.statementsBefore;
    }

    // The binding this name has outside the lambda, or null when the enclosing scope has none.
    protected lookupOuter(string name) -> LocalBinding? {
        let outer = this.enclosingScope;
        if (outer == null) {
            return null;
        }
        return outer.lookup(name);
    }

    protected captureBinding(LocalBinding binding) {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return;
            }
        }
        this.capturedBindings.push(binding);
        this.captures.push(new LambdaCapture(binding, binding.type()));
    }

    // Records that the lambda copies the enclosing receiver; true the first time, so a rejection
    // reports once however many times the body reads 'this'.
    protected captureReceiver(Type receiver) -> bool {
        if (this.readsReceiver) {
            return false;
        }
        this.readsReceiver = true;
        this.captures.push(new LambdaCapture(null, receiver));
        return true;
    }

    protected holds(LocalBinding binding) -> bool {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return true;
            }
        }
        return false;
    }

    protected capturesReceiver() -> bool {
        return this.readsReceiver;
    }

    protected result() -> LambdaCapture[] {
        return this.captures.toArray();
    }

    // A frame for the same lambda that holds what this one has captured so far and records later
    // captures in its own lists.
    public copy() -> LambdaFrame {
        let copied = new LambdaFrame(this.lambdaNode, this.enclosingScope, this.enclosingReceiver,
            this.carriedNarrowings, this.uncarriedNarrowings, this.statementsBefore);
        copied.captures.pushAll(this.captures);
        copied.capturedBindings.pushAll(this.capturedBindings);
        copied.readsReceiver = this.readsReceiver;
        return copied;
    }
}

// The fix for the lambda 'node' written where a type that is not a function type is declared, with
// a function type example taking the lambda's parameters.
lambdaTypeAdvice(BodyChecker checker, LambdaExpressionNode node) -> string {
    let parts = new StringBuilder();
    for (long i = 0; i < node.parametersCount(); i++) {
        if (i > 0) {
            parts.append(", ");
        }
        let written = node.parameters(i).declaredType();
        if (written != null) {
            parts.append(wording.greenSpelling(written.green()));
        } else {
            parts.append("int");
        }
    }
    string example = "({parts.toString()}) -> int";
    let holder = checker.targets().lambdaHolder();
    if (holder != null && holder.kind() == OriginKind.Declared && holder.name().length > 0) {
        return "Declare '{holder.name()}' with a function type instead, such as '{example}'.";
    }
    return "Write it where a function type such as '{example}' is declared.";
}

// Checks a lambda against the function type its surroundings expect. The target supplies the
// parameter types the lambda leaves out and the return type its body is checked against. The body is
// checked as a callable of its own: its own scope, its own narrowing, its own loops, and a
// return type of its own, so nothing about the enclosing control flow reaches into it. What
// it reads from outside is a capture, recorded for the phases that lower it.
public analyzeLambda(BodyChecker checker, LambdaExpressionNode node, Type target) -> Type {
    Type core = convert.coreOf(target);
    if (core is ErrorType) {
        return checker.store().errorType();
    }
    if (!(core is FunctionType)) {
        checker.reporter().report("A lambda is a function value, so it cannot be "
            + "{typenames.typeArticle(checker.names().of(target))} {checker.names().quoted(target)}. "
            + lambdaTypeAdvice(checker, node), node.span());
        return checker.store().errorType();
    }
    Type[] expected = core.parameterTypes();
    if (!checkLambdaShape(checker, node, core, expected)) {
        return checker.store().errorType();
    }
    let signature = lambdaSignature(node, expected, core.returnType());
    let captures = checkLambdaBody(checker, node, signature);
    checker.result().setLambda(node.green(), new LambdaInfo(signature, core, captures));
    return core;
}

// Checks the body of 'node', a lambda passed to a call refused before its type arguments are known,
// with the parameter types 'expected' and a result any value fits, so that what the body does wrong
// is reported. A lambda whose parameters do not match 'expected' is left to the call's refusal, and
// the lambda records no function type, since the call gives it none.
public checkBodyOfRefusedCall(BodyChecker checker, LambdaExpressionNode node, Type[] expected) {
    if (node.parametersCount() != expected.length) {
        return;
    }
    for (long i = 0; i < expected.length; i++) {
        let written = node.parameters(i).declaredType();
        if (written != null && checker.resolver().resolveType(written) != expected[i]) {
            return;
        }
    }
    let ignored = checkLambdaBody(checker, node, lambdaSignature(node, expected,
        checker.store().errorType()));
}

lambdaSignature(LambdaExpressionNode node, Type[] parameterTypes, Type returnType) -> Signature {
    let parameters = new List<Parameter>();
    for (long i = 0; i < node.parametersCount(); i++) {
        let declared = node.parameters(i);
        parameters.push(new Parameter(declared.name().text(), parameterTypes[i], false, false,
            false, declared.name().span()));
    }
    return new Signature("lambda", parameters.toArray(), returnType, false, false, [], [], [],
        node.green(), node.span());
}

// The lambda's parameter list against the target's: the same count, all types written or
// none, and every written type exactly the one the target passes. Invariant, so a written
// type that merely accepts the target's is still a mismatch.
checkLambdaShape(BodyChecker checker, LambdaExpressionNode node, FunctionType target,
                 Type[] expected) -> bool {
    long given = node.parametersCount();
    if (given != expected.length) {
        string mine = parameterCountText(given);
        string theirs = parameterCountText(expected.length);
        checker.reporter().report("This lambda takes {mine}, but {checker.names().quoted(target)} "
            + "takes {theirs}. Write it as '{lambdaShapeExample(expected.length)}'.",
            node.span());
        return false;
    }
    long typed = 0;
    for (long i = 0; i < given; i++) {
        if (node.parameters(i).declaredType() != null) {
            typed++;
        }
    }
    if (typed > 0 && typed < given) {
        checker.reporter().report("This lambda gives a type to some parameters and not to others. Write a "
            + "type for every parameter or for none, as in '(int a, int b) -> a + b' or "
            + "'(a, b) -> a + b'.", node.span());
        return false;
    }
    bool matched = true;
    for (long i = 0; i < given; i++) {
        let reference = node.parameters(i).declaredType();
        if (reference == null) {
            continue;
        }
        Type written = checker.resolver().resolveType(reference);
        if (written is ErrorType) {
            matched = false;
            continue;
        }
        if (written != expected[i]) {
            string parameterName = node.parameters(i).name().text();
            let imported = typenames.importsFor([expected[i]], checker.names());
            string declaration = imported.names().quotedCode(["", " {parameterName}"], [expected[i]]);
            checker.reporter().report("Parameter '{parameterName}' is declared "
                + "{checker.names().quoted(written)}, but the function type "
                + "{checker.names().quoted(target)} gives it "
                + "{typenames.typeArticle(checker.names().of(expected[i]))} "
                + "{checker.names().quoted(expected[i])}. "
                + typenames.withImportsFirst(imported, "Write {declaration}, or leave the type out."),
                reference.span());
            matched = false;
        }
    }
    return matched;
}

// Walks the lambda's body under its own checker state and returns what it captured. The body starts
// from what holds where the lambda is created, which is what holds here unless the call the lambda is
// passed to checks it after the arguments written after it.
checkLambdaBody(BodyChecker checker, LambdaExpressionNode node, Signature signature) -> LambdaCapture[] {
    let recorded = checker.takeLambdaStart(node);
    if (recorded == null) {
        return checkLambdaBodyFrom(checker, node, signature, checker.lambdaStartHere());
    }
    let here = checker.assignment().snapshot();
    checker.assignment().restore(recorded.assigned);
    let captures = checkLambdaBodyFrom(checker, node, signature, recorded);
    checker.assignment().restore(here);
    return captures;
}

// Walks the lambda's body from 'start', with the proofs made there that hold inside the body, and
// returns what it captured.
checkLambdaBodyFrom(BodyChecker checker, LambdaExpressionNode node, Signature signature, LambdaStart start)
        -> LambdaCapture[] {
    let carried = narrowing.lambdaNarrowings(start.proofs, true);
    let outerFrame = checker.frame();
    let lambdaFrame = new LambdaFrame(node, checker.currentScope(), outerFrame.thisType(), carried,
        narrowing.lambdaNarrowings(start.proofs, false), outerFrame.statementsAllowed());
    let outerDeferred = checker.targets().deferredFixes();
    bool outerAwaiting = checker.targets().awaitingParameter();

    let innerFrame = outerFrame.forLambda(node, signature.returnType(),
        literalfixes.returnOriginThrough(checker, checker.targets().lambdaHolder(), signature.returnType()));
    let outer = checker.enterLambda(lambdaFrame, innerFrame, new NarrowingState(carried), start.castHints);
    checker.targets().setLambdaHolder(null);
    checker.targets().setDeferredFixes(null);
    checker.targets().setAwaitingParameter(false);

    Parameter[] parameters = signature.parameters();
    let lambdaScope = checker.currentScope();
    for (long i = 0; i < parameters.length; i++) {
        let parameter = parameters[i];
        let binding = new LocalBinding(parameter.name(), parameter.type(),
            BindingKind.Parameter, false, parameter.span());
        checker.frame().addParameterInReach(binding);
        if (lambdaScope != null && !lambdaScope.define(binding)) {
            checker.reporter().report("Parameter '{parameter.name()}' is declared twice in this lambda. "
                + "Rename one of the two.", parameter.span());
        }
        checker.result().setBinding(node.parameters(i).green(), binding);
    }

    checker.enterScope();
    walkLambdaBody(checker, node, signature.returnType());
    checker.leaveScope();

    checker.leaveLambda(outer);
    let receiver = outerFrame.thisType();
    if (lambdaFrame.capturesReceiver() && receiver != null
            && !functionvalues.refusesThisCapture(receiver)) {
        checker.assignment().checkThisUse(new ThisUse(ThisUseKind.LambdaCapture, null,
            thisuses.assignedFieldOf(node), node.span()));
    }
    checker.targets().setDeferredFixes(outerDeferred);
    checker.targets().setAwaitingParameter(outerAwaiting);
    return lambdaFrame.result();
}

// A block body is a function body: every path must return a value when the target returns
// one. An expression body is the value itself, unless the target returns nothing, in which
// case it is evaluated and discarded like an expression statement.
walkLambdaBody(BodyChecker checker, LambdaExpressionNode node, Type returned) {
    let body = node.body();
    if (body is BlockNode) {
        checker.walkBlock(body);
        if (!types.isVoidType(returned) && !(returned is ErrorType)
                && !flow.blockTerminates(body, ExitScope.Function, checker)) {
            checker.reporter().report("This lambda returns {checker.names().quoted(returned)}, but a path "
                + "through its body ends without a 'return'. Add a 'return' at the end of every path.",
                node.arrow().span());
        }
        return;
    }
    if (body is Expression) {
        if (types.isVoidType(returned)) {
            checker.analyzeDiscarded(body);
            checker.endPathIfNeverReturns(body);
            return;
        }
        Type actual = checker.analyzeExpressionAdapt(body, returned, checker.frame().currentReturnOrigin());
        let noValue = voidcalls.typedRefusal(checker, body, actual, "be returned from this lambda",
            "return", returned);
        if (!(returned is ErrorType) && noValue != null) {
            checker.reporter().report(noValue, body.span());
        } else if (!(returned is ErrorType) && !(actual is ErrorType)
                && !convert.isAssignableStrict(returned, actual)) {
            string returnedShown = checker.names().quoted(returned);
            checker.reporter().report("This lambda must return {returnedShown}, but its body "
                + "has type {checker.names().quoted(actual)}."
                + "{nullguidance.valueAssignabilityHint(checker, returned, actual, body)}", body.span());
        }
    }
}

// True when 'name' is a local outside one of the lambdas being checked.
public isOuterName(BodyChecker checker, string name) -> bool {
    return outerBinding(checker, name) != null;
}

// The binding 'name' has outside the lambda being checked, as 'lookupCapture' finds it, without
// recording a capture.
public outerBinding(BodyChecker checker, string name) -> LocalBinding? {
    for (long i = checker.lambdaFrames().length() - 1; i >= 0; i--) {
        let found = checker.lambdaFrames().get(i).lookupOuter(name);
        if (found != null) {
            return found;
        }
    }
    return null;
}

// The assignment to 'binding' that an argument of the call the lambda being checked is passed to makes
// after the lambda, which the lambda's copy of 'binding' does not see, or null where no argument does or
// 'binding' is no capture of it.
public laterAssignmentInCall(BodyChecker checker, LocalBinding binding) -> AssignmentExpressionNode? {
    let lambda = checker.frame().innermostLambda();
    let scope = checker.currentScope();
    if (lambda == null || scope == null || scope.lookup(binding.name()) == binding) {
        return null;
    }
    SyntaxNode? holder = lambda.parent();
    while (holder != null && holdsArgumentPart(holder)) {
        holder = holder.parent();
    }
    if (!(holder is ArgumentListNode)) {
        return null;
    }
    return assignmentAfter(holder, binding.name(), lambda.span().end());
}

// Whether 'node' is a part of an argument that holds another: parentheses, an array or a '{...}'
// literal, a field of one, a named argument, or the list of them a node holds.
holdsArgumentPart(SyntaxNode node) -> bool {
    return node is ListNode || node is ParenthesizedExpressionNode || node is ArrayLiteralExpressionNode
        || node is StructLiteralFieldNode || node is StructLiteralExpressionNode || node is NamedArgumentNode;
}

// The first '=' assignment to the local 'name' inside 'node' that starts at 'after' or later,
// outside any lambda, or null where there is none.
assignmentAfter(SyntaxNode node, string name, long after) -> AssignmentExpressionNode? {
    if (node is LambdaExpressionNode || node.span().end() <= after) {
        return null;
    }
    if (node is AssignmentExpressionNode && node.span().start >= after
            && node.operator().kind() == SyntaxKind.Equals) {
        Expression target = syntax.unwrapParentheses(node.target());
        if (target is IdentifierExpressionNode && target.name().text() == name) {
            return node;
        }
    }
    for (let child in node.childNodes()) {
        let found = assignmentAfter(child, name, after);
        if (found != null) {
            return found;
        }
    }
    return null;
}

// The innermost of the lambdas being checked where a proof of 'path' is made where it is created but
// does not hold inside it, or null where no such proof is made.
public uncarriedFrame(BodyChecker checker, NarrowingPath path) -> LambdaFrame? {
    for (long i = checker.lambdaFrames().length() - 1; i >= 0; i--) {
        let frame = checker.lambdaFrames().get(i);
        let proven = frame.uncarriedNarrowings.get(path);
        if (proven != null && !(proven is ErrorType)) {
            return frame;
        }
    }
    return null;
}

// The type a proof made where the innermost lambda being checked is created gives 'path' inside it,
// or null where no such proof is made.
public carriedProof(BodyChecker checker, NarrowingPath path) -> Type? {
    long count = checker.lambdaFrames().length();
    if (count == 0) {
        return null;
    }
    return checker.lambdaFrames().get(count - 1).carriedNarrowings.get(path);
}

// A name the lambda being checked does not declare itself: the enclosing lambdas' scopes,
// outermost last, then the enclosing callable's. Finding one there is a capture, and every
// lambda between the declaration and the use copies it.
public lookupCapture(BodyChecker checker, string name) -> LocalBinding? {
    for (long i = checker.lambdaFrames().length() - 1; i >= 0; i--) {
        let found = checker.lambdaFrames().get(i).lookupOuter(name);
        if (found == null) {
            continue;
        }
        for (long j = i; j < checker.lambdaFrames().length(); j++) {
            checker.lambdaFrames().get(j).captureBinding(found);
        }
        return found;
    }
    return null;
}

// Records that every lambda being checked copies the enclosing receiver, which is what makes
// 'this' readable, its fields writable, and its methods callable inside a lambda. A struct
// receiver is refused: copying it would give the lambda its own struct, so a write through
// the copy would not be a write to the one the method runs over. A primitive receiver is a
// value nothing can write through, so copying it changes nothing and it is allowed.
public captureReceiver(BodyChecker checker, Type receiver, Span at) {
    long depth = checker.lambdaFrames().length();
    if (depth == 0) {
        return;
    }
    if (functionvalues.refusesThisCapture(receiver)) {
        if (checker.lambdaFrames().get(depth - 1).captureReceiver(receiver)) {
            checker.reporter().report("A lambda cannot capture 'this' here: "
                + functionvalues.structThisAdvice(checker.names().quoted(receiver)), at);
        }
        return;
    }
    for (long i = 0; i < depth; i++) {
        let ignored = checker.lambdaFrames().get(i).captureReceiver(receiver);
    }
}

// Whether the binding is declared outside the lambda being checked, so a write to it would land on
// the lambda's own copy.
public isCapturedBinding(BodyChecker checker, LocalBinding binding) -> bool {
    if (checker.lambdaFrames().length() == 0) {
        return false;
    }
    return checker.lambdaFrames().get(checker.lambdaFrames().length() - 1).holds(binding);
}

// Whether the lambda being checked read 'this' of a struct, which reported that it cannot capture it.
public lambdaRefusedThis(BodyChecker checker) -> bool {
    long depth = checker.lambdaFrames().length();
    let receiver = checker.frame().thisType();
    return depth > 0 && receiver != null && functionvalues.refusesThisCapture(receiver)
        && checker.lambdaFrames().get(depth - 1).readsReceiver;
}

// Reports a write to a captured local; true when it reported. 'action' names what the write
// would do, so '=' and '++' read naturally.
reportCapturedWrite(BodyChecker checker, LocalBinding binding, string action, Span at) -> bool {
    if (!isCapturedBinding(checker, binding)) {
        return false;
    }
    checker.reporter().report("Cannot {action} '{binding.name()}' inside a lambda: "
        + "{copiedCaptureReason(binding)} Return the value the lambda computes and store it where the "
        + "lambda is called, or keep the value in a field of an object the lambda uses.", at);
    return true;
}

// Reports a captured local passed as 'out', which lets the callee write the lambda's copy; true
// when it reported.
public reportCapturedOut(BodyChecker checker, LocalBinding binding, Span at) -> bool {
    if (!isCapturedBinding(checker, binding)) {
        return false;
    }
    checker.reporter().report("Cannot pass '{binding.name()}' as 'out' inside a lambda: "
        + "{copiedCaptureReason(binding)} Pass a local the lambda declares instead"
        + "{ownLocalExample(checker, binding)}, and return the value the lambda computes or keep it "
        + "in a field of an object the lambda uses.", at);
    return true;
}

// A local the lambda could pass as 'out' in place of the capture 'binding', as in ", as in
// 'long ownSize = 0;'", or empty where its type has no plain starting value or the name is taken.
ownLocalExample(BodyChecker checker, LocalBinding binding) -> string {
    string name = "own{typenames.capitalizedAscii(binding.name())}";
    let initial = startingValueText(binding.type());
    if (initial == null || !checker.isFreeName(name)) {
        return "";
    }
    return ", as in {checker.names().quotedCode(["", " {name} = {initial};"], [binding.type()])}";
}

// A literal a local of 'type' can start with, or null where none is plain enough to suggest.
startingValueText(Type type) -> string? {
    if (type is OptionalType) {
        return "null";
    }
    if (!(type is PrimitiveType)) {
        return null;
    }
    return switch (type.kind()) {
        Bool -> "false",
        Byte, Short, UShort, Int, UInt, Long, ULong -> "0",
        Float, Double -> "0.0",
        default -> null,
    };
}

copiedCaptureReason(LocalBinding binding) -> string {
    return "a lambda works on copies of what it captures, so the '{binding.name()}' outside it would "
        + "not change.";
}

// Reports a write refused for where it stands rather than for what it names; true when it
// reported. 'action' names what the write would do, so '=' and '++' read naturally.
public reportRefusedWrite(BodyChecker checker, LocalBinding binding, string action, Span at) -> bool {
    if (reportCapturedWrite(checker, binding, action, at)) {
        return true;
    }
    return reportSiblingFieldWrite(checker, binding, at);
}

// The binding a write to a member chain changes, or null where the chain changes another
// object instead. A struct field lives in the value that holds it, so a chain of them
// changes what stands at its root, while a class reference or an array element anywhere
// along it leads to storage of its own.
public writtenChainRoot(BodyChecker checker, Expression target) -> LocalBinding? {
    Expression root = syntax.unwrapParentheses(target);
    while (root is MemberExpressionNode) {
        let objectType = checker.result().typeOf(root.object().green());
        if (objectType == null || !types.isStructLike(objectType)) {
            return null;
        }
        root = syntax.unwrapParentheses(root.object());
    }
    if (root is IdentifierExpressionNode) {
        return checker.result().bindingOf(root.green());
    }
    return null;
}

// Reports a write to a sibling field inside a field default; true when it reported. A
// default is the value of the field it belongs to, so it reads its siblings and writes none
// of them. A default naming its own field is refused by the checks phase instead.
reportSiblingFieldWrite(BodyChecker checker, LocalBinding binding, Span at) -> bool {
    if (binding.kind() != BindingKind.SiblingField) {
        return false;
    }
    let defaulted = checker.frame().fieldDefaultName();
    if (defaulted == null || defaulted == binding.name()) {
        return false;
    }
    checker.reporter().report("Field '{binding.name()}' cannot be assigned inside the default of "
        + "'{defaulted}'. A default gives its own field a value and reads earlier ones, so "
        + "give '{binding.name()}' its value in its own default, or assign both fields in a "
        + "constructor.", at);
    return true;
}

parameterCountText(long count) -> string {
    if (count == 1) {
        return "1 parameter";
    }
    return "{count} parameters";
}

// A lambda of the right arity, as a diagnostic shows the shape to write: '(a, b) -> ...'.
lambdaShapeExample(long count) -> string {
    let builder = new StringBuilder();
    builder.append("(");
    for (long i = 0; i < count; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameterExampleName(i));
    }
    builder.append(") -> ...");
    return builder.toString();
}

parameterExampleName(long index) -> string {
    return switch (index) {
        0 -> "a",
        1 -> "b",
        2 -> "c",
        default -> "p{index + 1}",
    };
}
