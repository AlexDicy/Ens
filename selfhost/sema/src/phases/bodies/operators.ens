// The binary and prefix operators, and '++' and '--' written after a value: the operand types each
// operator accepts, the conversion of one side to the type of the other, and the refusals for
// operands that do not fit.
import Expression from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import PostfixExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import model.capabilities;
import model.convert;
import LiteralOrigin from phases.bodies.literaltargets;
import JoinText from phases.bodies.literaltargets;
import Widening from phases.bodies.literaltargets;
import model.literalvalues;
import phases.bodies.assignments;
import WriteTarget from phases.bodies.assignments;
import WriteRefusal from phases.bodies.assignments;
import phases.bodies.literalfixes;
import phases.bodies.valuejoins;
import phases.bodies.literaltyping;
import phases.bodies.nullguidance;
import phases.bodies.wording;
import phases.bodies.narrowing;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import NullType from model.types;
import StringType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import EqualityObligation from phases.obligations;
import BodyChecker from phases.bodies;

public analyzeBinary(BodyChecker checker, BinaryExpressionNode node) -> Type {
    SyntaxKind operator = node.operator().kind();
    // '&&' and '||' evaluate the right side only when the left did not already decide
    // the result, so a check on the left narrows the right: 'x != null && x.ready()'.
    if (operator == SyntaxKind.AmpersandAmpersand || operator == SyntaxKind.PipePipe) {
        Type shortLeft = checker.analyzeExpression(node.left());
        Type shortRight = narrowing.analyzeGuardedBranch(checker, node.left(), node.right(),
            operator == SyntaxKind.AmpersandAmpersand, null);
        if (shortLeft is ErrorType || shortRight is ErrorType) {
            return checker.store().errorType();
        }
        if (!convert.isBoolType(shortLeft) || !convert.isBoolType(shortRight)) {
            bool accepted = convert.isBoolType(convert.coreOf(shortLeft))
                && convert.isBoolType(convert.coreOf(shortRight));
            let guidance = nullguidance.binaryGuidance(checker, node.left(), node.right(), shortLeft,
                shortRight, accepted, null, node.operator().text());
            string sides = sidesClause(node.left(), node.right(), shortLeft, shortRight,
                !convert.isBoolType(shortLeft), !convert.isBoolType(shortRight), checker.names());
            checker.reporter().report(nullguidance.withGuidance(checker, "'{node.operator().text()}' needs a "
                + "'bool' on both sides, {sides}.", guidance), node.span());
        }
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    Type? target = null;
    LiteralOrigin? origin = null;
    if (checker.targets().binaryNode() == node.green()) {
        if (literalfixes.isArithmeticOperator(operator) || operator == SyntaxKind.Ampersand
                || operator == SyntaxKind.Pipe || operator == SyntaxKind.Caret) {
            target = checker.targets().binaryTarget();
            origin = checker.targets().binaryOrigin();
        }
        checker.targets().clearBinaryStash();
    }
    checker.targets().stash(node.left(), target, origin);
    Type left = checker.analyzeExpression(node.left());
    checker.targets().clearStash();
    checker.targets().stash(node.right(), target, origin);
    Type right = checker.analyzeExpression(node.right());
    checker.targets().clearStash();
    if (left is ErrorType || right is ErrorType) {
        return checker.store().errorType();
    }
    checker.targets().enterOperands(node, target, origin);
    Type result = analyzeBinaryOperands(checker, node.span(), operator, node.operator().text(),
        node.left(), node.right(), left, right, null);
    checker.targets().leaveOperands();
    return result;
}

// The result of 'left OP right' under the operator's own rules. A compound assignment passes its
// target as 'written', which is checked without its '?'.
public analyzeBinaryOperands(BodyChecker checker, Span span, SyntaxKind operator, string operatorText,
                             Expression leftNode, Expression rightNode, Type left,
                             Type right, WriteTarget? written) -> Type {
    switch (operator) {
        Plus, Minus, Star, Slash, Percent -> {
            return analyzeArithmetic(checker, span, operator, operatorText, leftNode, rightNode,
                left, right, written);
        },
        EqualsEquals, NotEquals -> {
            return analyzeEquality(checker, span, operatorText, leftNode, rightNode, left, right);
        },
        Less, Greater, LessEquals, GreaterEquals -> {
            return analyzeComparison(checker, span, operator, operatorText, leftNode, rightNode, left, right);
        },
        Ampersand, Pipe, Caret -> {
            return analyzeBitwise(checker, span, operator, operatorText, leftNode, rightNode, left,
                right, written);
        },
        LessLess, GreaterGreater, GreaterGreaterGreater -> {
            return analyzeShift(checker, span, operator, operatorText, leftNode, rightNode, left,
                right, written);
        },
        default -> {
            checker.reporter().report("Internal: unsupported binary operator '{operatorText}'.", span);
            return checker.store().errorType();
        },
    }
}

// Both sides after an untyped literal on either side adapts to the other side's type.
adaptOperands(BodyChecker checker, Expression leftNode, Expression rightNode, Type left, Type right,
              string operatorText) -> Type[] {
    return [adaptedOperand(checker, leftNode, left, right, rightNode, operatorText, false),
        adaptedOperand(checker, rightNode, right, left, leftNode, operatorText, true)];
}

// The operand's type once an untyped literal in it adapts toward 'toward', the type of 'other'.
// Any other operand keeps its type.
adaptedOperand(BodyChecker checker, Expression node, Type type, Type toward, Expression other,
               string operatorText, bool onRight) -> Type {
    let fix = literalfixes.operandLiteralFix(checker, node, other, toward, operatorText, onRight);
    literalfixes.noteSuffixedOperand(checker, node, other, toward, operatorText, onRight);
    return literaltyping.adaptIntegerLiteral(checker, node, toward, null, fix)
        ?? literaltyping.adaptFloatLiteral(checker, node, toward, null, fix)
        ?? charOperand(checker, node, toward, other, fix) ?? type;
}

// Refuses a comparison of a value with a literal its type cannot hold, or, for an integer type, one
// it can never equal, whose outcome is then the same for every value. True when it reported one.
reportFixedComparison(BodyChecker checker, Span span, string operatorText, Expression leftNode,
                      Expression rightNode, Type left, Type right) -> bool {
    return reportFixedSide(checker, span, operatorText, rightNode, leftNode, left)
        || reportFixedSide(checker, span, operatorText, leftNode, rightNode, right);
}

// A literal operand of a comparison: its token, and whether a '-' is written before it.
final class ComparedLiteral {
    LiteralExpressionNode literalToken;
    bool literalNegative;

    constructor(this.literalToken, this.literalNegative);

    token() -> LiteralExpressionNode {
        return this.literalToken;
    }

    negative() -> bool {
        return this.literalNegative;
    }

    kind() -> SyntaxKind {
        return this.literalToken.value().kind();
    }
}

// The number or char literal 'operand' writes, under parentheses and one sign, which may be
// written outside parentheses of its own, as in '300', '-1.5', '(2.5)' or '-(1.5)'. Null for anything else.
comparedLiteralOf(Expression operand) -> ComparedLiteral? {
    Expression core = wording.unwrapParentheses(operand);
    bool negative = false;
    if (core is PrefixExpressionNode) {
        SyntaxKind operator = core.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            return null;
        }
        negative = operator == SyntaxKind.Minus;
        core = wording.unwrapParentheses(core.operand());
    }
    if (!(core is LiteralExpressionNode)) {
        return null;
    }
    return switch (core.value().kind()) {
        IntLiteral, DoubleLiteral, FloatLiteral -> new ComparedLiteral(core, negative),
        CharLiteral -> negative ? null : new ComparedLiteral(core, false),
        default -> null,
    };
}

// reportFixedComparison for the literal 'literal' compared with 'other' of type 'otherType'.
reportFixedSide(BodyChecker checker, Span span, string operatorText, Expression literal, Expression other,
                Type otherType) -> bool {
    let constant = comparedLiteralOf(literal);
    Type core = convert.coreOf(otherType);
    if (constant == null || comparedLiteralOf(other) != null || !(core is PrimitiveType)) {
        return false;
    }
    SyntaxKind kind = constant.kind();
    bool floating = kind == SyntaxKind.DoubleLiteral || kind == SyntaxKind.FloatLiteral;
    string? text = null;
    if (core.kind() == PrimitiveKind.Float && literaltyping.floatLiteralOf(constant.token()) != null) {
        text = floatComparison(checker, operatorText, literal, constant, other, otherType);
    } else if (convert.isIntegerType(core) && floating) {
        PrimitiveKind literalKind = PrimitiveKind.Double;
        if (kind == SyntaxKind.FloatLiteral) {
            literalKind = PrimitiveKind.Float;
        }
        if (convert.numericCommonType(core, checker.store().primitive(literalKind)) != null) {
            text = wholeNumberComparison(checker, operatorText, literal, constant, literalKind, other,
                core.kind(), otherType);
        }
    } else if (convert.isIntegerType(core) && !floating) {
        text = integerComparison(checker, operatorText, literal, constant, other, core, otherType);
    }
    if (text == null) {
        return false;
    }
    checker.reporter().report(text, span);
    checker.result().setType(literal.green(), checker.store().errorType());
    return true;
}

// The refusal of comparing 'other' with the integer or char literal 'constant', past the range of
// the integer type 'core', or null when it fits or is past every integer type.
integerComparison(BodyChecker checker, string operatorText, Expression literal, ComparedLiteral constant,
                  Expression other, PrimitiveType core, Type otherType) -> string? {
    PrimitiveKind kind = core.kind();
    string written = constant.token().value().text();
    if (constant.kind() == SyntaxKind.CharLiteral) {
        ulong codepoint = literalvalues.charCodepoint(written);
        if (kind == PrimitiveKind.Char || literalvalues.magnitudeFits(false, codepoint, kind)) {
            return null;
        }
        return fixedComparison(checker, operatorText, literal, other, otherType,
            literalfixes.charWidening(checker, codepoint, core));
    }
    let magnitude = literalvalues.integerMagnitude(written);
    bool negative = constant.negative();
    if (magnitude == null || literalvalues.magnitudeFits(negative, magnitude, kind)
            || literaltyping.widerIntegerHolding(negative, magnitude, kind).length == 0) {
        return null;
    }
    let widening = new Widening(kind, checker.names().of(core),
        literalfixes.comparedIntegerHolding(kind, negative, magnitude), negative, magnitude);
    return fixedComparison(checker, operatorText, literal, other, otherType, widening);
}

// The refusal of comparing 'other' with the floating-point literal 'constant' past the range of
// 'float', or null when it fits 'float' or is past 'double' too. An ordering has no single outcome,
// since the value may be an infinity or a NaN, so it states the range instead.
floatComparison(BodyChecker checker, string operatorText, Expression literal, ComparedLiteral constant,
                Expression other, Type otherType) -> string? {
    let written = constant.token();
    if (!literalfixes.literalOverflows(written, PrimitiveKind.Float)
            || !literalvalues.floatMagnitudeFits(literalvalues.floatMagnitude(written.value().text()),
                PrimitiveKind.Double)) {
        return null;
    }
    string value = wording.oneLineSpelling(wording.unwrapParentheses(literal));
    Expression compared = wording.unwrapParentheses(other);
    string named = wording.oneLineSpelling(compared);
    string fix = "";
    let declarable = declarableName(checker, compared);
    if (declarable != null) {
        fix = " Declare {declarable} as 'double' if it should hold that value.";
    }
    if (operatorText != "==" && operatorText != "!=") {
        return "{literaltyping.floatPastRange(value, PrimitiveKind.Float)} "
            + "{wording.takesTypeFrom("'{named}'", convert.coreOf(otherType), checker.names())}{fix}";
    }
    string bound = "whose largest value is {literalvalues.floatLimit(PrimitiveKind.Float)}";
    if (constant.negative()) {
        bound = "whose smallest value is {literalvalues.floatLimit(PrimitiveKind.Float, true)}";
    }
    string outcome = "never equal to";
    if (operatorText == "!=") {
        outcome = "always different from";
    }
    return "'{named}' is {typenames.typeArticle(checker.names().of(otherType))} "
        + "{checker.names().quoted(otherType)}, {bound}, so it is {outcome} {value}.{fix}";
}

// The refusal of comparing 'other' with the floating-point literal 'constant' that no value of the
// integer kind 'kind' equals, or null. Every value of the kind is exact in 'literalKind'.
wholeNumberComparison(BodyChecker checker, string operatorText, Expression literal, ComparedLiteral constant,
                      PrimitiveKind literalKind, Expression other, PrimitiveKind kind, Type otherType)
                      -> string? {
    double magnitude = literalvalues.floatMagnitude(constant.token().value().text());
    if (!literalvalues.floatMagnitudeFits(magnitude, literalKind)) {
        return null;
    }
    if (literalKind == PrimitiveKind.Float) {
        magnitude = (magnitude as float) as double;
    }
    bool negative = constant.negative();
    double value = magnitude;
    if (negative) {
        value = -magnitude;
    }
    bool equality = operatorText == "==" || operatorText == "!=";
    bool whole = literalvalues.isWholeNumber(magnitude);
    bool fractional = false;
    string why = "whose largest value is {literalvalues.integerLimit(kind)}";
    string outcome = "always less than";
    if (value < literalvalues.integerLimitAsDouble(kind, true)) {
        why = "whose smallest value is {literalvalues.integerLimit(kind, true)}";
        outcome = "always greater than";
    } else if (value <= literalvalues.integerLimitAsDouble(kind)) {
        if (!equality || whole) {
            return null;
        }
        why = "whose values are all whole numbers";
        fractional = true;
    }
    if (operatorText == "==") {
        outcome = "never equal to";
    } else if (operatorText == "!=") {
        outcome = "always different from";
    }
    Expression compared = wording.unwrapParentheses(other);
    string fix = "";
    let declarable = declarableName(checker, compared);
    string wider = "";
    if (whole && magnitude < 18446744073709551616.0) {
        wider = literalfixes.comparedIntegerHolding(kind, negative, magnitude as ulong);
    }
    if (wider.length > 0 && !comparesWith(checker, wider, literalKind)) {
        wider = "";
    }
    if (declarable != null && fractional) {
        fix = " Declare {declarable} as 'double' if it should hold that value, or compare with a whole "
            + "number.";
    } else if (declarable != null && wider.length > 0) {
        fix = integerTypeFix(declarable, wider, negative && literalfixes.isUnsignedKind(kind));
    } else if (declarable != null) {
        fix = " Declare {declarable} as 'double' if it should hold that value.";
    }
    return "'{wording.oneLineSpelling(compared)}' is {typenames.typeArticle(checker.names().of(otherType))} "
        + "{checker.names().quoted(otherType)}, {why}, so it is {outcome} "
        + "{wording.oneLineSpelling(wording.unwrapParentheses(literal))}.{fix}";
}

// Whether a value of the integer type named 'name' compares with a value of 'literalKind', so a fix
// that declares it still compiles.
comparesWith(BodyChecker checker, string name, PrimitiveKind literalKind) -> bool {
    PrimitiveKind? kind = switch (name) {
        "short" -> PrimitiveKind.Short,
        "ushort" -> PrimitiveKind.UShort,
        "int" -> PrimitiveKind.Int,
        "uint" -> PrimitiveKind.UInt,
        "long" -> PrimitiveKind.Long,
        "ulong" -> PrimitiveKind.ULong,
        default -> null,
    };
    if (kind == null) {
        return false;
    }
    return convert.numericCommonType(checker.store().primitive(kind),
        checker.store().primitive(literalKind)) != null;
}

// The fix that declares 'declarable' as the integer type 'wider', a signed one where 'signed'.
integerTypeFix(string declarable, string wider, bool signed) -> string {
    if (signed) {
        return " Declare {declarable} as a signed type, such as '{wider}', if it should hold that value.";
    }
    return " Declare {declarable} as a wider type, such as '{wider}', if it should hold that value.";
}

// How a fix names what 'compared' writes when a declaration in this package can change its type: a
// local, a parameter, or a field of a type this package declares. Null for anything else.
declarableName(BodyChecker checker, Expression compared) -> string? {
    if (compared is IdentifierExpressionNode) {
        if (checker.result().bindingOf(compared.green()) != null) {
            return "'{wording.oneLineSpelling(compared)}'";
        }
        return null;
    }
    let field = nullguidance.accessedField(checker, compared);
    if (field == null) {
        return null;
    }
    let authority = types.authorityOf(field.definingType());
    if (authority == null || authority.packagePrefix() != checker.packagePrefix()) {
        return null;
    }
    return "field '{field.name()}' of {checker.names().quotedName(authority)}";
}

// The refusal of comparing 'other' of type 'otherType' with 'literal', which lies past the end of
// that type that 'widening' names, so the comparison has one outcome.
fixedComparison(BodyChecker checker, string operatorText, Expression literal, Expression other,
                Type otherType, Widening widening) -> string {
    Expression compared = wording.unwrapParentheses(other);
    string named = wording.oneLineSpelling(compared);
    string type = checker.names().quoted(otherType);
    string article = typenames.typeArticle(checker.names().of(otherType));
    bool character = literaltyping.charLiteralOf(wording.unwrapParentheses(literal)) != null;
    string value = wording.oneLineSpelling(wording.unwrapParentheses(literal));
    if (character) {
        value = "{value}, whose code point, its number in Unicode, is {widening.magnitude()}";
    }
    let kind = widening.narrow();
    string bound = "whose largest value is {literalvalues.integerLimit(kind)}";
    string outcome = "always less than";
    if (widening.negative()) {
        bound = "whose smallest value is {literalvalues.integerLimit(kind, true)}";
        outcome = "always greater than";
    }
    if (operatorText == "==") {
        outcome = "never equal to";
    } else if (operatorText == "!=") {
        outcome = "always different from";
    }
    string fix = "";
    let declarable = declarableName(checker, compared);
    if (declarable != null && character) {
        fix = " If {declarable} should hold characters, declare it as 'char'.";
    } else if (declarable != null && widening.wider().length > 0) {
        fix = integerTypeFix(declarable, widening.wider(),
            widening.negative() && literalfixes.isUnsignedKind(kind));
    }
    return "'{named}' is {article} {type}, {bound}, so it is {outcome} {value}.{fix}";
}

// A char literal operand takes the integer type of the value beside it, as a number literal does,
// but not the 'int' an untyped number literal beside it falls back to.
charOperand(BodyChecker checker, Expression node, Type toward, Expression other, JoinText? fix) -> Type? {
    if (valuejoins.isUntypedNumberLiteral(other)) {
        return null;
    }
    return literaltyping.adaptCharLiteral(checker, node, toward, null, fix);
}

analyzeArithmetic(BodyChecker checker, Span span, SyntaxKind operator, string operatorText,
                  Expression leftNode, Expression rightNode, Type left, Type right, WriteTarget? written)
                  -> Type {
    Type[] adapted = adaptOperands(checker, leftNode, rightNode, checkedSide(left, written), right,
        operatorText);
    if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
        return checker.store().errorType();
    }
    Type checkedLeft = adapted[0];
    Type shownLeft = shownSide(checkedLeft, left, written);
    Type checkedRight = adapted[1];
    bool joins = operator == SyntaxKind.Plus
        && (convert.coreOf(checkedLeft) is StringType || convert.coreOf(checkedRight) is StringType);
    bool accepted = acceptsCores(operator, checkedLeft, checkedRight);
    let guidance = nullguidance.binaryGuidance(checker, leftNode, rightNode, shownLeft, checkedRight,
        accepted, written, operatorText);
    if (joins) {
        if (isStringable(checkedLeft) && isStringable(checkedRight)) {
            return checker.store().stringType();
        }
        string refusal = sidesRefusal(operator, operatorText, leftNode, rightNode, shownLeft,
            checkedRight, checker.names());
        if (!accepted) {
            refusal = "Cannot add a value of type {checker.names().quoted(checkedRight)} to a string.";
            if (isStringable(convert.coreOf(checkedRight))) {
                refusal = "Cannot add a string to a value of type {checker.names().quoted(shownLeft)}.";
            }
            refusal = refusal + " Only a string, a number or a 'bool' can be added to one.";
        }
        checker.reporter().report(nullguidance.withGuidance(checker, refusal, guidance), span);
        return checker.store().errorType();
    }
    if (!convert.isNumericType(checkedLeft) || !convert.isNumericType(checkedRight)) {
        checker.reporter().report(nullguidance.withGuidance(checker, sidesRefusal(operator, operatorText,
            leftNode, rightNode, shownLeft, checkedRight, checker.names()), guidance), span);
        return checker.store().errorType();
    }
    let common = convert.numericCommonType(checkedLeft, checkedRight);
    if (common == null) {
        checker.reporter().report("'{operatorText}' needs the same number type on both sides, "
            + "{sidesClause(leftNode, rightNode, shownLeft, checkedRight, true, true, checker.names())}."
            + bothSidesConversion(operatorText, leftNode, rightNode, checkedLeft, checkedRight), span);
        return checker.store().errorType();
    }
    return common;
}

// A comparison against 'null' is a presence test on the declared storage type, so it stays
// legal on a binding declared optional even where narrowing already proved the value non-null.
analyzeEquality(BodyChecker checker, Span span, string operatorText, Expression leftNode,
                Expression rightNode, Type left, Type right) -> Type {
    if (reportFixedComparison(checker, span, operatorText, leftNode, rightNode, left, right)) {
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    Type[] adapted = adaptOperands(checker, leftNode, rightNode, left, right, operatorText);
    Type leftSide = adapted[0];
    Type rightSide = adapted[1];
    if (rightSide is NullType) {
        leftSide = narrowing.presenceOperandType(checker, leftNode, leftSide);
    } else if (leftSide is NullType) {
        rightSide = narrowing.presenceOperandType(checker, rightNode, rightSide);
    }
    if (reportFunctionComparison(checker, span, leftSide, rightSide)) {
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    if (!convert.isAssignableStrict(leftSide, rightSide)
            && !convert.isAssignableStrict(rightSide, leftSide)) {
        checker.reporter().report(comparisonRefusal(checker, operatorText, leftNode, rightNode, leftSide,
            rightSide), span);
    } else {
        checkStructEquatable(checker, leftSide, rightSide, span);
    }
    return checker.store().primitive(PrimitiveKind.Bool);
}

// The refusal of 'operatorText' between two sides whose types are never equal. Against 'null',
// the side that can never be null is named with the result the comparison always has.
comparisonRefusal(BodyChecker checker, string operatorText, Expression leftNode, Expression rightNode,
                  Type left, Type right) -> string {
    if (!(left is NullType) && !(right is NullType)) {
        return "Cannot compare {checker.names().quoted(left)} with {checker.names().quoted(right)}, because "
            + "a value of one of these types is never equal to a value of the other.";
    }
    Type other = left;
    Expression valueNode = leftNode;
    if (left is NullType) {
        other = right;
        valueNode = rightNode;
    }
    string result = "false";
    if (operatorText == "!=") {
        result = "true";
    }
    string nullable = checker.names().quotedNullable(other);
    let spelled = wording.shortSpelling(valueNode);
    if (spelled == null) {
        return "This value has type {checker.names().quoted(other)}, which can never be null, so this "
            + "comparison is always {result}. Remove the comparison, or give the value a nullable type "
            + "such as {nullable} if it should allow null.";
    }
    string comparison = "{spelled} {operatorText} null";
    if (left is NullType) {
        comparison = "null {operatorText} {spelled}";
    }
    string change = "give '{spelled}' a nullable type such as {nullable}";
    if (wording.unwrapParentheses(valueNode) is IdentifierExpressionNode) {
        change = "declare '{spelled}' as {nullable}";
    }
    return "'{spelled}' has type {checker.names().quoted(other)}, which can never be null, so '{comparison}' "
        + "is always {result}. Remove the comparison, or {change} if it should allow null.";
}

// A function value has nothing to reach into: no fields, no methods, no identity and no text
// form. The one home for reporting it, whether the name was read or called.
public reportFunctionMember(BodyChecker checker, string name, Type functionType, Span at) -> Type {
    checker.reporter().report(capabilities.functionMemberIssue(name, functionType, checker.names()), at);
    return checker.store().errorType();
}

// Refuses comparing two function values, which have no identity, and returns whether it did.
// Comparing a nullable one with 'null' tests presence and stays allowed.
reportFunctionComparison(BodyChecker checker, Span span, Type left, Type right) -> bool {
    if (left is NullType || right is NullType) {
        return false;
    }
    if (!(convert.coreOf(left) is FunctionType) && !(convert.coreOf(right) is FunctionType)) {
        return false;
    }
    checker.reporter().report("A function value has no identity, so {checker.names().quoted(left)} and "
        + "{checker.names().quoted(right)} cannot be compared. Compare what the functions produce, "
        + "or keep a name or tag beside each one and compare that.", span);
    return true;
}

// Struct and array '==' compare memberwise, so every field or element needs its own '=='.
// A type mentioning a type parameter is judged per instantiation.
checkStructEquatable(BodyChecker checker, Type leftSide, Type rightSide, Span span) {
    Type judged = leftSide;
    if (convert.coreOf(leftSide) is ArrayType && convert.coreOf(rightSide) is ArrayType) {
        judged = convert.coreOf(leftSide);
    } else if (!types.isStructLike(leftSide) || leftSide != rightSide) {
        return;
    }
    if (convert.containsTypeParam(judged)) {
        checker.recordObligation(new EqualityObligation(judged, span));
        return;
    }
    let issue = capabilities.equalityComparabilityIssue(judged, checker.names());
    if (issue != null) {
        checker.reporter().report(issue, span);
    }
}

analyzeComparison(BodyChecker checker, Span span, SyntaxKind operator, string operatorText,
                  Expression leftNode, Expression rightNode, Type left, Type right) -> Type {
    if (reportFixedComparison(checker, span, operatorText, leftNode, rightNode, left, right)) {
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    Type[] adapted = adaptOperands(checker, leftNode, rightNode, left, right, operatorText);
    if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    Type first = adapted[0];
    Type second = adapted[1];
    if (!convert.isNumericType(first) || !convert.isNumericType(second)) {
        bool ordersStrings = convert.coreOf(first) is StringType && convert.coreOf(second) is StringType;
        bool accepted = acceptsCores(operator, first, second);
        let guidance = nullguidance.binaryGuidance(checker, leftNode, rightNode, first, second, accepted,
            null, operatorText);
        string sides = sidesClause(leftNode, rightNode, first, second, !convert.isNumericType(first),
            !convert.isNumericType(second), checker.names());
        string refusal = nullguidance.withGuidance(checker, "'{operatorText}' compares numbers, {sides}.",
            guidance);
        if (ordersStrings) {
            refusal = refusal + " "
                + nullguidance.orderingAdvice(checker, operatorText, leftNode, rightNode, first, second);
        }
        checker.reporter().report(refusal, span);
        return checker.store().primitive(PrimitiveKind.Bool);
    }
    if (convert.numericCommonType(first, second) == null) {
        checker.reporter().report("'{operatorText}' needs the same number type on both sides, "
            + "{sidesClause(leftNode, rightNode, first, second, true, true, checker.names())}."
            + bothSidesConversion(operatorText, leftNode, rightNode, first, second), span);
    }
    return checker.store().primitive(PrimitiveKind.Bool);
}

analyzeBitwise(BodyChecker checker, Span span, SyntaxKind operator, string operatorText, Expression leftNode,
               Expression rightNode, Type left, Type right, WriteTarget? written) -> Type {
    // A bitwise operator takes integers, so only an integer or char literal adapts to the other side.
    let leftFix = literalfixes.operandLiteralFix(checker, leftNode, rightNode, right, operatorText, false);
    Type checkedLeft = literaltyping.adaptIntegerLiteral(checker, leftNode, right, null, leftFix)
        ?? charOperand(checker, leftNode, right, rightNode, leftFix) ?? checkedSide(left, written);
    let rightFix = literalfixes.operandLiteralFix(checker, rightNode, leftNode, left, operatorText, true);
    Type checkedRight = literaltyping.adaptIntegerLiteral(checker, rightNode, left, null, rightFix)
        ?? charOperand(checker, rightNode, left, leftNode, rightFix) ?? right;
    if (checkedLeft is ErrorType || checkedRight is ErrorType) {
        return checker.store().errorType();
    }
    Type shownLeft = shownSide(checkedLeft, left, written);
    if (!convert.isIntegerType(checkedLeft) || !convert.isIntegerType(checkedRight)) {
        bool accepted = acceptsCores(operator, checkedLeft, checkedRight);
        let guidance = nullguidance.binaryGuidance(checker, leftNode, rightNode, shownLeft, checkedRight,
            accepted, written, operatorText);
        checker.reporter().report(nullguidance.withGuidance(checker, sidesRefusal(operator, operatorText,
            leftNode, rightNode, shownLeft, checkedRight, checker.names()), guidance), span);
        return checker.store().errorType();
    }
    if (checkedLeft != checkedRight) {
        checker.reporter().report("'{operatorText}' needs the same integer type on both sides, "
            + "{sidesClause(leftNode, rightNode, shownLeft, checkedRight, true, true, checker.names())}."
            + bothSidesConversion(operatorText, leftNode, rightNode, checkedLeft, checkedRight), span);
        return checker.store().errorType();
    }
    return checkedLeft;
}

// The shifted value alone decides the result type, so only the distance adapts.
analyzeShift(BodyChecker checker, Span span, SyntaxKind operator, string operatorText, Expression leftNode,
             Expression rightNode, Type left, Type right, WriteTarget? written) -> Type {
    Type checkedLeft = checkedSide(left, written);
    JoinText? why = null;
    if (literalfixes.overflowWidening(checker, rightNode, checkedLeft) != null) {
        string text = wording.takesTypeFrom("'{wording.oneLineSpelling(leftNode)}'",
            convert.coreOf(checkedLeft), checker.names());
        why = new JoinText(text, text);
    }
    Type distance = literaltyping.adaptIntegerLiteral(checker, rightNode, checkedLeft, null, why)
        ?? literaltyping.adaptCharLiteral(checker, rightNode, checkedLeft, null, why) ?? right;
    if (distance is ErrorType) {
        return checker.store().errorType();
    }
    bool accepted = acceptsCores(operator, left, distance);
    let guidance = nullguidance.binaryGuidance(checker, leftNode, rightNode, left, distance, accepted,
        written, operatorText);
    bool shiftedNull = left is OptionalType;
    if (written != null) {
        shiftedNull = written.nullLevels() > 0;
    }
    if (accepted && shiftedNull && distance is OptionalType) {
        checker.reporter().report(nullguidance.withGuidance(checker,
            "'{operatorText}' needs an integer to shift and an "
            + "integer shift distance, {sidesClause(leftNode, rightNode, left, distance, true, true,
            checker.names())}.", guidance), span);
        return checker.store().errorType();
    }
    if (!convert.isIntegerType(checkedLeft)) {
        checker.reporter().report(nullguidance.withGuidance(checker, sidesRefusal(operator, operatorText,
            leftNode, rightNode, left, distance, checker.names()), guidance), span);
        return checker.store().errorType();
    }
    if (!convert.isIntegerType(distance)) {
        checker.reporter().report(nullguidance.withGuidance(checker,
            "'{operatorText}' needs an integer shift distance, but "
            + "{wording.sideNamed(rightNode, "the distance")} has type {checker.names().quoted(distance)}.",
            guidance), span);
        return checker.store().errorType();
    }
    if (checkedLeft != distance) {
        string shifted = checker.names().of(shownSide(checkedLeft, left, written));
        string wanted = checker.names().of(checkedLeft);
        string fix = "Convert the distance with 'as'.";
        if (wording.shortSpelling(rightNode) != null) {
            fix = "Write '{wording.converted(wording.unwrapParentheses(rightNode), wanted)}'.";
        }
        string quotedShifted = checker.names().quoted(shownSide(checkedLeft, left, written));
        string quotedWanted = checker.names().quoted(checkedLeft);
        checker.reporter().report("'{operatorText}' shifts {typenames.typeArticle(shifted)} {quotedShifted} "
            + "here, so the shift distance must be {typenames.typeArticle(wanted)} {quotedWanted} too, but "
            + "{wording.sideNamed(rightNode, "the distance")} has type {checker.names().quoted(distance)}. "
            + "{fix}",
            span);
        return checker.store().errorType();
    }
    return checkedLeft;
}

public analyzePrefix(BodyChecker checker, PrefixExpressionNode node) -> Type {
    SyntaxKind prefixOperator = node.operator().kind();
    Type operand = analyzePrefixOperand(checker, prefixOperator, node.operand());
    if (prefixOperator == SyntaxKind.Minus || prefixOperator == SyntaxKind.Plus) {
        valuejoins.retargetLiteralRange(checker, node, node.operand(), prefixOperator == SyntaxKind.Minus);
    }
    if (operand is ErrorType) {
        return checker.store().errorType();
    }
    Type core = operand;
    switch (node.operator().kind()) {
        Minus, Plus -> {
            if (!convert.isNumericType(core)) {
                let guidance = nullguidance.unaryGuidance(checker, node.operand(), operand,
                    convert.isNumericType(convert.coreOf(operand)), null);
                checker.reporter().report(nullguidance.withGuidance(checker,
                    "Unary '{node.operator().text()}' needs a number, but "
                    + "{wording.sideNamed(node.operand(), "the operand")} has type "
                    + "{checker.names().quoted(operand)}.", guidance), node.span());
                return checker.store().errorType();
            }
            return core;
        },
        Exclamation -> {
            if (!convert.isBoolType(core)) {
                let guidance = nullguidance.unaryGuidance(checker, node.operand(), operand,
                    convert.isBoolType(convert.coreOf(operand)), null);
                checker.reporter().report(nullguidance.withGuidance(checker, "'!' negates a 'bool', but "
                    + "{wording.sideNamed(node.operand(), "the operand")} has type "
                    + "{checker.names().quoted(operand)}.",
                    guidance), node.span());
                return checker.store().errorType();
            }
            return core;
        },
        Tilde -> {
            if (!convert.isIntegerType(core)) {
                let guidance = nullguidance.unaryGuidance(checker, node.operand(), operand,
                    convert.isIntegerType(convert.coreOf(operand)), null);
                checker.reporter().report(nullguidance.withGuidance(checker, "'~' flips the bits of an "
                    + "integer, but {wording.sideNamed(node.operand(), "the operand")} has type "
                    + "{checker.names().quoted(operand)}.",
                    guidance), node.span());
                return checker.store().errorType();
            }
            return core;
        },
        PlusPlus, MinusMinus -> {
            return analyzeIncrement(checker, node.span(), node.operand(), core,
                node.operator().kind() == SyntaxKind.PlusPlus, true);
        },
        default -> {
            checker.reporter().report("Internal: unsupported unary operator "
                + "'{node.operator().text()}'.", node.operator().span());
            return checker.store().errorType();
        },
    }
}

// The operand of a prefix operator. '++' and '--' store back what they read, so their
// operand takes the write position; the other prefix operators only read theirs.
analyzePrefixOperand(BodyChecker checker, SyntaxKind operator, Expression operand) -> Type {
    if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
        return assignments.analyzeWriteTarget(checker, operand);
    }
    return checker.analyzeExpression(operand);
}

public analyzePostfix(BodyChecker checker, PostfixExpressionNode node) -> Type {
    Type operand = assignments.analyzeWriteTarget(checker, node.operand());
    if (operand is ErrorType) {
        return checker.store().errorType();
    }
    return analyzeIncrement(checker, node.span(), node.operand(), operand,
        node.operator().kind() == SyntaxKind.PlusPlus, false);
}

analyzeIncrement(BodyChecker checker, Span span, Expression operand, Type operandType, bool isIncrement,
                 bool isPrefix) -> Type {
    string operator = "--";
    if (isIncrement) {
        operator = "++";
    }
    string before = "";
    string after = operator;
    if (isPrefix) {
        before = operator;
        after = "";
    }
    // Parentheses around the operand name the same storage, so every rule below reads through them.
    Expression changed = wording.unwrapParentheses(operand);
    // A write through '?.' or '?[' is judged by the slot it lands in, as the same write without
    // the '?' is.
    Type changedType = operandType;
    bool safe = assignments.reportSafeTarget(checker, operand, operandType, operator, before, after, span);
    if (safe) {
        changedType = assignments.safeSlotType(checker, changed) ?? operandType;
    }
    long nullLevels = wording.optionalLevels(changedType);
    let refusal = assignments.reportUnchangeable(checker, changed, changedType, safe, operator, before, after,
        span);
    if (refusal == WriteRefusal.Unwritable) {
        nullLevels = 0;
    }
    if (changed is ThisExpressionNode || changed is SuperExpressionNode) {
        return operandType;
    }
    if (!convert.isNumericType(changedType)) {
        string refusalText = "'{operator}' works only on numbers, and "
            + "'{wording.oneLineSpelling(changed)}' has type {checker.names().quoted(changedType)}.";
        if (acceptsCores(SyntaxKind.PlusPlus, changedType, changedType)) {
            // A slot reached through '?.' or '?[' is refused for its null only once the '?' is gone.
            if (nullLevels > 0 && !safe) {
                let guidance = nullguidance.unaryGuidance(checker, operand, changedType, true,
                    new WriteTarget(nullLevels));
                checker.reporter().report(nullguidance.withGuidance(checker, refusalText, guidance), span);
            }
            return changedType;
        }
        checker.reporter().report(refusalText + " Use it on an integer or a floating-point variable, for "
            + "example '{before}count{after}'.", span);
        return changedType;
    }
    if (safe || refusal != WriteRefusal.None) {
        return changedType;
    }
    narrowing.invalidateForWrite(checker, changed);
    narrowing.establishWriteNarrowing(checker, changed, operandType);
    return changedType;
}

isStringable(Type core) -> bool {
    return core is StringType || convert.isIntegerType(core) || convert.isBoolType(core)
        || convert.isTextualFloat(core);
}

// Whether the operator takes both sides once every '?' is removed from them.
public acceptsCores(SyntaxKind operator, Type left, Type right) -> bool {
    Type first = convert.coreOf(left);
    Type second = convert.coreOf(right);
    switch (operator) {
        Plus -> {
            if (first is StringType || second is StringType) {
                return isStringable(first) && isStringable(second);
            }
            return convert.isNumericType(first) && convert.isNumericType(second);
        },
        Minus, Star, Slash, Percent, PlusPlus, MinusMinus -> {
            return convert.isNumericType(first) && convert.isNumericType(second);
        },
        Ampersand, Pipe, Caret, LessLess, GreaterGreater, GreaterGreaterGreater -> {
            return convert.isIntegerType(first) && convert.isIntegerType(second);
        },
        // Two strings are ordered with 'compareTo' instead of an ordering operator.
        Less, Greater, LessEquals, GreaterEquals -> {
            return (first is StringType && second is StringType)
                || (convert.isNumericType(first) && convert.isNumericType(second));
        },
        default -> {
            return false;
        },
    }
}

// The type an operator checks its left side as. A write target is checked without its '?'.
checkedSide(Type left, WriteTarget? written) -> Type {
    if (written != null) {
        return convert.coreOf(left);
    }
    return left;
}

// The type a text names for the left side of an operator, as 'adapted' toward the other side.
// A write target is named with its own type instead.
shownSide(Type adapted, Type left, WriteTarget? written) -> Type {
    if (written != null) {
        return left;
    }
    return adapted;
}

// The refusal of an operator's sides 'leftNode' and 'rightNode', naming the ones the operator does
// not take. A shift names only the shifted value.
public sidesRefusal(SyntaxKind operator, string operatorText, Expression leftNode, Expression rightNode,
                    Type left, Type right, TypeNames names) -> string {
    bool joins = convert.coreOf(left) is StringType || convert.coreOf(right) is StringType;
    if (operator == SyntaxKind.Plus && joins) {
        string sides = sidesClause(leftNode, rightNode, left, right, left is OptionalType,
            right is OptionalType, names);
        return "'{operatorText}' joins a string only when neither side can be null, {sides}.";
    }
    switch (operator) {
        Ampersand, Pipe, Caret -> {
            string sides = sidesClause(leftNode, rightNode, left, right, !convert.isIntegerType(left),
                !convert.isIntegerType(right), names);
            return "'{operatorText}' needs integers on both sides, {sides}.";
        },
        LessLess, GreaterGreater, GreaterGreaterGreater -> {
            return "'{operatorText}' shifts an integer, but "
                + "{wording.sideNamed(leftNode, "the value it shifts")} has type {names.quoted(left)}.";
        },
        default -> {
            string sides = sidesClause(leftNode, rightNode, left, right, !convert.isNumericType(left),
                !convert.isNumericType(right), names);
            return "'{operatorText}' needs numbers on both sides, {sides}.";
        },
    }
}

// The clause "but ... has type 'T'" naming the sides of an operator it does not take, the ones
// 'leftFails' and 'rightFails' mark. A side with no short spelling is named by its place.
sidesClause(Expression leftNode, Expression rightNode, Type left, Type right, bool leftFails, bool rightFails,
            TypeNames names) -> string {
    if (leftFails && !rightFails) {
        return "but {wording.sideNamed(leftNode, "the left side")} has type {names.quoted(left)}";
    }
    if (rightFails && !leftFails) {
        return "but {wording.sideNamed(rightNode, "the right side")} has type {names.quoted(right)}";
    }
    let first = wording.shortSpelling(leftNode);
    let second = wording.shortSpelling(rightNode);
    bool same = left == right;
    if (first != null && second != null && first != second) {
        if (same) {
            return "but '{first}' and '{second}' both have type {names.quoted(left)}";
        }
        return "but '{first}' has type {names.quoted(left)} and '{second}' has type {names.quoted(right)}";
    }
    if (same) {
        return "but both sides have type {names.quoted(left)}";
    }
    return "but the sides are {names.quoted(left)} and {names.quoted(right)}";
}

// The sentence, opening with a space, that converts two sides of different number types to the
// narrowest type with every value of each, so no value changes. Empty when no type has them all, and
// for a compound assignment, whose result goes back into its left side.
bothSidesConversion(string operatorText, Expression leftNode, Expression rightNode, Type left, Type right)
        -> string {
    Type leftCore = convert.coreOf(left);
    Type rightCore = convert.coreOf(right);
    if (isCompoundOperator(operatorText) || !(leftCore is PrimitiveType) || !(rightCore is PrimitiveType)) {
        return "";
    }
    string target = holdingNumberType(leftCore.kind(), rightCore.kind());
    if (target.length == 0) {
        return "";
    }
    let leftSpelled = wording.shortSpelling(leftNode);
    let rightSpelled = wording.shortSpelling(rightNode);
    Expression leftValue = wording.unwrapParentheses(leftNode);
    Expression rightValue = wording.unwrapParentheses(rightNode);
    bool convertsLeft = primitiveName(leftCore.kind()) != target;
    bool convertsRight = primitiveName(rightCore.kind()) != target;
    if (leftSpelled == null || rightSpelled == null) {
        return " Convert both sides to '{target}' with 'as'.";
    }
    string leftText = wording.oneLineSpelling(leftValue);
    string rightText = wording.oneLineSpelling(rightValue);
    if (convertsLeft) {
        leftText = wording.converted(leftValue, target);
    }
    if (convertsRight) {
        rightText = wording.converted(rightValue, target);
    }
    string example = "{leftText} {operatorText} {rightText}";
    if (convertsLeft && convertsRight) {
        return " Convert both sides to '{target}', as in '{example}'.";
    }
    string side = leftSpelled;
    if (convertsRight) {
        side = rightSpelled;
    }
    return " Convert '{side}' to '{target}', as in '{example}'.";
}

// Whether 'operatorText' writes its result back into its left side, as '+=' does.
isCompoundOperator(string operatorText) -> bool {
    return operatorText.endsWith("=") && operatorText != "<=" && operatorText != ">="
        && operatorText != "==" && operatorText != "!=";
}

// The narrowest number type with every value of 'first' and of 'second', or empty when none has them
// all. An integer type comes first at each width, and a 'float' or a 'double' side needs a
// floating-point type.
holdingNumberType(PrimitiveKind first, PrimitiveKind second) -> string {
    if (isFloatingKind(first) || isFloatingKind(second)) {
        for (let kind in [PrimitiveKind.Float, PrimitiveKind.Double]) {
            if (floatHoldsEveryValue(kind, first) && floatHoldsEveryValue(kind, second)) {
                return primitiveName(kind);
            }
        }
        return "";
    }
    PrimitiveKind[] ordered = [PrimitiveKind.Short, PrimitiveKind.UShort, PrimitiveKind.Int,
        PrimitiveKind.UInt, PrimitiveKind.Long, PrimitiveKind.ULong];
    for (let kind in ordered) {
        if (valuejoins.holdsEveryValue(kind, first) && valuejoins.holdsEveryValue(kind, second)) {
            return primitiveName(kind);
        }
    }
    return "";
}

// Whether the kind is 'float' or 'double'.
isFloatingKind(PrimitiveKind kind) -> bool {
    return kind == PrimitiveKind.Float || kind == PrimitiveKind.Double;
}

// Whether the floating-point kind 'outer' has every value of 'inner' exactly: a 'float' has integers of
// up to 24 bits and a 'double' of up to 53.
floatHoldsEveryValue(PrimitiveKind outer, PrimitiveKind inner) -> bool {
    if (inner == PrimitiveKind.Double) {
        return outer == PrimitiveKind.Double;
    }
    if (inner == PrimitiveKind.Float) {
        return true;
    }
    if (inner == PrimitiveKind.Bool) {
        return false;
    }
    long width = literaltyping.integerWidth(inner);
    if (inner == PrimitiveKind.Char) {
        width = 21;
    }
    if (outer == PrimitiveKind.Float) {
        return width <= 24;
    }
    return width < 64;
}

// The name a number kind is written with.
primitiveName(PrimitiveKind kind) -> string {
    if (kind == PrimitiveKind.Float) {
        return "float";
    }
    if (kind == PrimitiveKind.Double) {
        return "double";
    }
    if (kind == PrimitiveKind.Byte) {
        return "byte";
    }
    if (kind == PrimitiveKind.Char) {
        return "char";
    }
    return literaltyping.primitiveKindName(kind);
}
