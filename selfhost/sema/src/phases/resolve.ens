// Type reference resolution for one module, over its own declared types, its import table, the
// implicitly imported modules, and the type parameters the current declaration pushed. Every
// resolved reference lands in the module's SemaResult, and a failure resolves to the error type.
import model.sharing;
import model.lending;
import Unshareable from model.sharing;
import phases.sharedtypes;
import Type as TypeNode from @ens.frontend.syntax.generated.nodes;
import NamedTypeNode from @ens.frontend.syntax.generated.nodes;
import TypeArgumentListNode from @ens.frontend.syntax.generated.nodes;
import ArrayTypeNode from @ens.frontend.syntax.generated.nodes;
import OptionalTypeNode from @ens.frontend.syntax.generated.nodes;
import FunctionTypeNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedTypeNode from @ens.frontend.syntax.generated.nodes;
import ErrorTypeNode from @ens.frontend.syntax.generated.nodes;
import TypeQualifierNode from @ens.frontend.syntax.generated.nodes;
import TypeParameterListNode from @ens.frontend.syntax.generated.nodes;
import BoundsClauseNode from @ens.frontend.syntax.generated.nodes;
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import ModuleLinkTable from phases.link;
import ImportedType from phases.link;
import ImportedNamespace from phases.link;
import RefusedImport from phases.link;
import InstantiationMention from phases.obligations;
import FunctionThrowsMention from phases.obligations;
import ObligationRegistry from phases.obligations;
import KeyTypeObligation from phases.obligations;
import AtomicValueObligation from phases.obligations;
import Origin from phases.obligations;
import phases.obligations;
import phases.declare;
import phases.bodies.wording;
import program.implicit;
import SemaResult from result;
import model.capabilities;
import model.convert;
import model.hierarchy;
import FailedConstraint from model.hierarchy;
import Method from model.typemembers;
import MemberConstraint from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import QuotedCode from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import TypeStore from model.types;
import DeclaredType from model.types;
import FunctionType from model.types;
import ClassType from model.types;
import StructType from model.types;
import InstantiationType from model.types;
import TypeParamType from model.types;
import ThrownListType from model.types;
import PendingThrowsType from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

public class TypeResolver {
    TypeStore store;
    string resolverModulePath;
    string resolverPackagePrefix;
    string resolverFilePath;
    ModuleLinkTable moduleImports;
    ClassType? implicitErrorClass;
    SemaResult semaResult;
    ObligationRegistry deferredObligations;
    List<TypeParamType> parameterScope;
    TypeNames scopedNames;
    string scopedNamesKey;
    string? parameterRefusal;
    GreenNode? constraintScopeOwner;
    MemberConstraint[] constraintScope;
    MemberConstraint[] noConstraints;
    List<FileDiagnostic> collected;
    List<DeferredBoundCheck> deferredBoundChecks;
    List<InstantiationMention> instantiationMentions;
    List<FunctionThrowsMention> functionThrowsMentions;
    Map<InstantiationType, List<MemberConstraint[]>> mentionScopes;
    bool checkBoundsImmediately;
    bool inReturnPosition;
    long openTrials;

    public constructor(TypeStore store, string modulePath, string packagePrefix, string filePath,
                ModuleLinkTable imports, ClassType? errorClass, SemaResult result,
                ObligationRegistry deferred) {
        this.store = store;
        this.resolverModulePath = modulePath;
        this.resolverPackagePrefix = packagePrefix;
        this.resolverFilePath = filePath;
        this.moduleImports = imports;
        this.implicitErrorClass = errorClass;
        this.semaResult = result;
        this.deferredObligations = deferred;
        this.parameterScope = new List<TypeParamType>();
        this.scopedNames = this.moduleImports.names();
        this.scopedNamesKey = "";
        this.parameterRefusal = null;
        this.constraintScopeOwner = null;
        this.noConstraints = [];
        this.constraintScope = this.noConstraints;
        this.collected = new List<FileDiagnostic>();
        this.deferredBoundChecks = new List<DeferredBoundCheck>();
        this.instantiationMentions = new List<InstantiationMention>();
        this.functionThrowsMentions = new List<FunctionThrowsMention>();
        this.mentionScopes = new Map<InstantiationType, List<MemberConstraint[]>>();
        this.checkBoundsImmediately = false;
        this.inReturnPosition = false;
        this.openTrials = 0;
    }

    // Drops what resolving reports or records for later phases until the matching endTrial(), so
    // code can be checked for what it gives without reporting its problems.
    public beginTrial() {
        this.openTrials++;
    }

    public endTrial() {
        this.openTrials--;
    }

    // A trailing 'throws' on a bare function type here could also belong to the declaration, so
    // the parenthesization report names both spellings.
    public resolveReturnType(TypeNode reference) -> Type {
        this.inReturnPosition = true;
        Type resolved = this.resolveType(reference);
        this.inReturnPosition = false;
        let lent = lending.escapingLent(resolved, false);
        if (lent != null && lending.isLent(convert.coreOf(resolved))) {
            this.reportLentResult(lent, reference.span());
            return this.store.errorType();
        }
        return resolved;
    }

    // Refuses a function that returns a value of the lent type `lent`.
    reportLentResult(Type lent, Span span) {
        this.report("A function cannot return {lending.lentArticle(lent, this.names())}, because "
            + "{lending.lentReason(lent, this.names(), "it")}. Return what it holds instead, or "
            + "pass it on as an argument.", span);
    }

    // Resolves the written type of the parameter 'name', which cannot be 'void'.
    public resolveParameterType(TypeNode reference, string name) -> Type {
        Type resolved = this.resolveType(reference);
        if (types.isVoidType(resolved)) {
            this.report("Parameter '{name}' cannot have type 'void', because 'void' means no "
                + "value. Give '{name}' the type of the value passed to it, or remove the "
                + "parameter.", reference.span());
            return this.store.errorType();
        }
        return resolved;
    }

    modulePath() -> string {
        return this.resolverModulePath;
    }

    filePath() -> string {
        return this.resolverFilePath;
    }

    public typeStore() -> TypeStore {
        return this.store;
    }

    // The names this module's file has for the program's types, for every diagnostic reported
    // here and for the phases that report beside this resolver, with the type parameters in scope
    // hiding a type of the same name.
    public names() -> TypeNames {
        if (this.parameterScope.isEmpty()) {
            return this.moduleImports.names();
        }
        string[] parameters = this.typeParameterNamesInScope();
        string key = string.joined(parameters, ",");
        if (key != this.scopedNamesKey) {
            this.scopedNames = this.moduleImports.names().withTypeParameters(parameters);
            this.scopedNamesKey = key;
        }
        return this.scopedNames;
    }

    public errorClass() -> ClassType? {
        return this.implicitErrorClass;
    }

    result() -> SemaResult {
        return this.semaResult;
    }

    public report(string message, Span span) {
        if (this.openTrials > 0) {
            return;
        }
        this.collected.push(new FileDiagnostic(this.resolverFilePath, message, span));
    }

    // Drains the diagnostics reported since the last call.
    public takeDiagnostics() -> FileDiagnostic[] {
        FileDiagnostic[] taken = this.collected.toArray();
        this.collected = new List<FileDiagnostic>();
        return taken;
    }

    public pushTypeParameters(TypeParamType[] parameters) {
        for (let parameter in parameters) {
            this.parameterScope.push(parameter);
        }
    }

    public popTypeParameters(long count) {
        for (long i = 0; i < count; i++) {
            this.parameterScope.pop();
        }
    }

    // The names of the type parameters in scope, innermost last.
    public typeParameterNamesInScope() -> string[] {
        let names = new List<string>();
        for (let parameter in this.parameterScope) {
            names.push(parameter.name());
        }
        return names.toArray();
    }

    // The refusal a type parameter reads inside a position that has the parameters in scope
    // but can use none, such as a type-level const's initializer. One position is refused at
    // a time, so the refusal is a single slot rather than a stack.
    public pushTypeParameterRefusal(string refusal) {
        this.parameterRefusal = refusal;
    }

    public popTypeParameterRefusal() {
        this.parameterRefusal = null;
    }

    // The refusal a type parameter written here reads, or null where this position may use one.
    public typeParameterRefusal() -> string? {
        return this.parameterRefusal;
    }

    // The constraint scope of the conditional member being resolved or checked: inside it, the
    // constrained parameters carry the member's extra bounds. At most one member is in scope at
    // a time, so the scope is a single slot rather than a stack.
    public pushMemberConstraints(GreenNode owner, MemberConstraint[] constraints) {
        this.constraintScopeOwner = owner;
        this.constraintScope = constraints;
    }

    public popMemberConstraints() {
        this.constraintScopeOwner = null;
        this.constraintScope = this.noConstraints;
    }

    public activeConstraintOwner() -> GreenNode? {
        return this.constraintScopeOwner;
    }

    public activeConstraints() -> MemberConstraint[] {
        return this.constraintScope;
    }

    // Whether this member exists on the type that defines it, judged under the active
    // constraint scope; see types.memberExistsOn.
    public memberExists(Method method) -> bool {
        return !method.isConditional() || this.firstUnmetConstraint(method) == null;
    }

    // The first constraint the member's defining type fails under the active scope, or null
    // when the member exists there.
    public firstUnmetConstraint(Method method) -> FailedConstraint? {
        let template = types.authorityOf(method.definingType());
        if (template == null) {
            return null;
        }
        return hierarchy.firstFailedConstraint(this.store, method, template,
            hierarchy.typeArgumentsOf(method.definingType()), this.constraintScopeOwner,
            this.constraintScope);
    }

    // The type parameter in scope under this name, innermost first, or null when none is. A list
    // that declares the name twice is refused, and the name stays the first of the two.
    public typeParameterNamed(string name) -> TypeParamType? {
        for (long i = this.parameterScope.length() - 1; i >= 0; i--) {
            let parameter = this.parameterScope.get(i);
            if (parameter.name() != name) {
                continue;
            }
            TypeParamType found = parameter;
            for (long j = i - 1; j >= 0; j--) {
                let earlier = this.parameterScope.get(j);
                if (earlier.owner() == found.owner() && earlier.name() == name) {
                    found = earlier;
                }
            }
            return found;
        }
        return null;
    }

    // Resolves a written type reference to its interned type, recording the result for the
    // reference node and every nested reference.
    public resolveType(TypeNode reference) -> Type {
        Type resolved = this.resolveTypeInner(reference);
        this.semaResult.setType(reference.green(), resolved);
        return resolved;
    }

    resolveTypeInner(TypeNode reference) -> Type {
        switch (reference) {
            is NamedTypeNode named -> {
                return this.resolveNamed(named);
            },
            is ArrayTypeNode array -> {
                Type element = this.resolveType(array.element());
                if (types.isVoidType(element)) {
                    this.report("'void' means no value, so it cannot be an array element "
                        + "type.", array.span());
                    return this.store.errorType();
                }
                let lent = lending.escapingLent(element, false);
                if (lent != null && lending.isLent(convert.coreOf(element))) {
                    this.report("An array cannot hold {lending.lentArticle(lent, this.names())}, "
                        + "because {lending.lentReason(lent, this.names(), "it")}. "
                        + lending.parameterFix(lent, this.names()), array.span());
                    return this.store.errorType();
                }
                return this.store.arrayOf(element);
            },
            is OptionalTypeNode optional -> {
                Type inner = this.resolveType(optional.inner());
                if (types.isVoidType(inner)) {
                    this.report("'void' means no value, so it cannot be marked nullable "
                        + "with '?'.", optional.span());
                    return this.store.errorType();
                }
                return this.store.optionalOf(inner);
            },
            is FunctionTypeNode functionType -> {
                return this.resolveFunctionType(functionType, false);
            },
            // Parentheses exist in a type so a '?' or '[]' suffix can apply to a function type,
            // which is why they are allowed around nothing else: every other type already has
            // exactly one written form, and a second one would let the same type be spelled two
            // ways. The inner type still resolves, so one rejected pair of parentheses does not
            // cost the declaration its meaning.
            is ParenthesizedTypeNode grouped -> {
                let innerNode = grouped.inner();
                if (innerNode is FunctionTypeNode) {
                    return this.resolveFunctionType(innerNode, true);
                }
                Type inner = this.resolveType(innerNode);
                if (!(inner is ErrorType)) {
                    this.report("In a type, only a function type can be written in parentheses, "
                        + "as in '((int) -> bool)?'. Remove the parentheses around "
                        + "{this.names().quoted(inner)}.", grouped.span());
                }
                return inner;
            },
            is ErrorTypeNode ignored -> {
                return this.store.errorType();
            },
        }
    }

    resolveFunctionType(FunctionTypeNode reference, bool parenthesized) -> Type {
        let parameters = new List<Type>();
        bool failed = false;
        for (long i = 0; i < reference.parameterTypesCount(); i++) {
            let parameterReference = reference.parameterTypes(i);
            Type parameter = this.resolveType(parameterReference);
            if (parameter is ErrorType) {
                failed = true;
            } else if (types.isVoidType(parameter)) {
                this.report("'void' means no value, so it cannot be a parameter type. Write "
                    + "'() -> ...' for a function value that takes nothing.",
                    parameterReference.span());
                failed = true;
            }
            parameters.push(parameter);
        }
        Type returned = this.resolveType(reference.returnedType());
        let thrown = this.resolveFunctionThrows(reference);
        if (failed || returned is ErrorType) {
            return this.store.errorType();
        }
        let lentResult = lending.escapingLent(returned, false);
        if (lentResult != null && lending.isLent(convert.coreOf(returned))) {
            this.reportLentResult(lentResult, reference.returnedType().span());
            return this.store.errorType();
        }
        bool shared = reference.sharedKeyword() != null;
        Type resolved = this.store.functionOf(parameters.toArray(), returned, thrown, shared);
        // Requiring parentheses keeps the two readings of a trailing 'throws' visibly distinct.
        if (thrown.length > 0 && !parenthesized && !(resolved is ErrorType)) {
            string wrapped = this.names().quotedCode(["(", ")"], [resolved]);
            if (this.inReturnPosition) {
                let declared = new QuotedCode();
                declared.write("(");
                declared.writeType(this.store.functionOf(parameters.toArray(), returned, [], shared));
                declared.write(") throws ");
                for (long i = 0; i < thrown.length; i++) {
                    if (i > 0) {
                        declared.write(", ");
                    }
                    declared.writeType(thrown[i]);
                }
                this.report("A function type's 'throws' list needs the function type in "
                    + "parentheses. Write {wrapped} to have the returned function throw those types, "
                    + "or {declared.quotedFor(this.names())} to have the declaration itself throw "
                    + "them.", reference.span());
            } else {
                this.report("A function type's 'throws' list needs the function type in "
                    + "parentheses. Write {wrapped}.", reference.span());
            }
        }
        return resolved;
    }

    // A function type has no body to infer a throws list from, so a bare 'throws' is refused,
    // as on an abstract method.
    resolveFunctionThrows(FunctionTypeNode reference) -> Type[] {
        let clause = reference.throwsClause();
        if (clause == null) {
            return [];
        }
        if (clause.typesCount() == 0) {
            this.report("This function type is marked 'throws' but lists no exception types. "
                + "Without a body, the types it throws must be written out. List them after "
                + "'throws', as in '({wording.greenSpelling(reference.green())} Error)', or remove "
                + "'throws'.", clause.throwsKeyword().span());
            return [];
        }
        let resolved = new List<Type>();
        let spans = new List<Span>();
        for (long i = 0; i < clause.typesCount(); i++) {
            let listed = clause.types(i);
            resolved.push(this.resolveType(listed));
            spans.push(listed.span());
        }
        if (this.openTrials == 0) {
            this.functionThrowsMentions.push(new FunctionThrowsMention(resolved.toArray(),
                spans.toArray(), this.constraintScopeOwner, this.constraintScope));
        }
        return resolved.toArray();
    }

    resolveNamed(NamedTypeNode named) -> Type {
        string name = named.name().text();
        if (name.length == 0) {
            return this.store.errorType();
        }
        Span nameSpan = named.name().span();
        Type base = this.store.errorType();
        let qualifier = named.qualifier();
        if (qualifier == null) {
            let found = this.lookupUnqualified(name);
            if (found == null) {
                this.report("Unknown type '{name}'. Check the spelling, or import the "
                    + "module that declares it.", nameSpan);
                return this.store.errorType();
            }
            base = found;
        } else {
            base = this.lookupQualified(qualifier, name, nameSpan);
        }
        if (base is ErrorType) {
            return base;
        }
        if (base is TypeParamType) {
            let refusal = this.parameterRefusal;
            if (refusal != null) {
                this.report(refusal, nameSpan);
                return this.store.errorType();
            }
        }
        if (types.isDecimalType(base)) {
            this.report("'decimal' is a reserved word and not a usable type yet. Use 'double' "
                + "for fractional values, or an integer scaled by hand (a 'long' count of "
                + "cents, say) where the value has to be exact.", nameSpan);
            return this.store.errorType();
        }
        let argumentList = named.typeArguments();
        if (base is DeclaredType && base.isGeneric()) {
            if (argumentList == null) {
                this.report("Generic type '{name}' needs type arguments. Write them in '<...>' "
                    + "after the name, as in '{name}<int>'.", nameSpan);
                return this.store.errorType();
            }
            return this.instantiateGeneric(base, name, argumentList, nameSpan);
        }
        if (argumentList != null) {
            this.report("Type {this.names().quoted(base)} is not generic and takes no type "
                + "arguments. Remove the '<...>' after {this.names().quoted(base)}.", nameSpan);
            return this.store.errorType();
        }
        return base;
    }

    // Instantiates a generic type from an explicit type-argument list. Shared by named
    // type references and generic struct constructor calls; the caller has already
    // established that `base` is generic and `argumentList` is present.
    public instantiateGeneric(DeclaredType base, string name, TypeArgumentListNode argumentList,
            Span nameSpan) -> Type {
        if (base.isWrittenAsFunction()) {
            return this.instantiateFromFunction(base, name, argumentList, nameSpan);
        }
        string[] parameterNames = base.typeParameters();
        long arity = parameterNames.length;
        long given = argumentList.argumentsCount();
        if (given != arity) {
            string expected = countOf(arity, "type argument");
            string written = "{given} are written here";
            if (given == 1) {
                written = "1 is written here";
            }
            string fix = "Write exactly one, for '{parameterNames[0]}'.";
            if (arity > 1) {
                let quoted = new List<string>();
                for (let parameter in parameterNames) {
                    quoted.push("'{parameter}'");
                }
                fix = "Write one for each of {diagnostics.andJoined(quoted.toArray())}.";
            }
            this.report("Generic type '{name}' takes {expected}, but {written}. {fix}", nameSpan);
            return this.store.errorType();
        }
        let arguments = new List<Type>();
        bool failed = false;
        for (long i = 0; i < given; i++) {
            Type argument = this.resolveType(argumentList.arguments(i));
            if (argument is ErrorType) {
                failed = true;
            }
            arguments.push(argument);
        }
        if (failed) {
            return this.store.errorType();
        }
        let spans = new List<Span>();
        for (long i = 0; i < given; i++) {
            spans.push(argumentList.arguments(i).span());
        }
        return this.instantiateChecked(base, arguments.toArray(), spans.toArray(),
            writtenSpan(nameSpan, argumentList.span()));
    }

    // A type whose list matches a function type, written with the one function type its two type
    // parameters are read from: 'Task<() -> Module throws ParseError>' is 'Task' at 'Module' and the
    // throws list of 'ParseError'.
    instantiateFromFunction(DeclaredType base, string name, TypeArgumentListNode argumentList,
            Span nameSpan) -> Type {
        string example = "'{name}<() -> int>'";
        if (argumentList.argumentsCount() != 1) {
            this.report("'{name}' takes one type argument, the function type it runs, as in "
                + "{example}, but {diagnostics.countWord(argumentList.argumentsCount())} are written "
                + "here.", nameSpan);
            return this.store.errorType();
        }
        Type written = this.resolveType(argumentList.arguments(0));
        if (written is ErrorType) {
            return written;
        }
        Type core = written;
        if (!(core is FunctionType) || core.parameterTypes().length > 0) {
            this.report("'{name}' takes one type argument, the function type it runs, which takes no "
                + "parameters, as in {example}, but {this.names().quoted(written)} is written here.",
                argumentList.arguments(0).span());
            return this.store.errorType();
        }
        Type fallback = this.store.errorType();
        let errorClass = this.implicitBinding("Error");
        if (errorClass != null) {
            fallback = errorClass;
        }
        Type[] arguments = [core.returnType(),
            convert.thrownListBinding(this.store, core.thrownTypes(), fallback)];
        Span at = argumentList.arguments(0).span();
        return this.instantiateChecked(base, arguments, [at, at],
            writtenSpan(nameSpan, argumentList.span()));
    }

    // The instantiation at these resolved type arguments, once their bounds and what the template
    // requires of them hold. 'spans' says where each argument is written.
    instantiateChecked(DeclaredType base, Type[] argumentTypes, Span[] spans, Span writtenAt) -> Type {
        long given = argumentTypes.length;
        if (this.checkBoundsImmediately) {
            TypeParamType[] parameters = base.typeParameterTypes();
            bool bounded = true;
            for (long i = 0; i < parameters.length && i < given; i++) {
                if (!this.checkArgumentBounds(parameters[i], argumentTypes, spans[i])) {
                    bounded = false;
                }
            }
            if (!bounded) {
                return this.store.errorType();
            }
            let keyed = capabilities.keyedContainerOf(base);
            if (keyed != null && !this.acceptsKeyType(base, argumentTypes,
                    spans[keyed.keyIndex()])) {
                return this.store.errorType();
            }
            if (capabilities.isAtomicCell(base) && given > 0
                    && !this.acceptsAtomicValue(base, argumentTypes[0], spans[0])) {
                return this.store.errorType();
            }
        } else if (this.openTrials == 0) {
            this.deferredBoundChecks.push(new DeferredBoundCheck(base, argumentTypes,
                spans, this.constraintScopeOwner, this.constraintScope));
        }
        let instantiation = this.store.instantiationOf(base, argumentTypes);
        this.recordInstantiationMention(instantiation, writtenAt);
        return instantiation;
    }

    // Logs one instantiation mention, once per (instantiation, scope) pair, for the obligation
    // pass: a concrete mention seeds its template's judgments, and an open one replays per
    // owner assignment under the constraint scope active here. A concrete mention seeds
    // unconditionally, so it records no scope. 'writtenAt' spans what a reader wrote to reach
    // this instantiation, and a refusal its arguments earn inside the template is reported
    // there, naming the instantiation as it reads here.
    public recordInstantiationMention(InstantiationType instantiation, Span writtenAt) {
        if (this.openTrials > 0) {
            return;
        }
        bool open = false;
        for (let argument in instantiation.arguments()) {
            if (convert.containsTypeParam(argument)) {
                open = true;
            }
        }
        GreenNode? guardOwner = this.constraintScopeOwner;
        MemberConstraint[] guards = this.constraintScope;
        if (!open) {
            guardOwner = null;
            guards = this.noConstraints;
        }
        let scopes = this.mentionScopesFor(instantiation);
        for (long i = 0; i < scopes.length(); i++) {
            if (scopes.get(i) == guards) {
                return;
            }
        }
        scopes.push(guards);
        let origin = new Origin(this.resolverFilePath, writtenAt, this.names().quoted(instantiation));
        this.instantiationMentions.push(new InstantiationMention(instantiation, origin,
            guardOwner, guards));
    }

    // The key argument of a keyed standard container, judged where its instantiation forms: a
    // concrete key is judged here, and one naming a type parameter is judged per instantiation.
    // True when the instantiation may form.
    public acceptsKeyType(DeclaredType template, Type[] arguments, Span keySpan) -> bool {
        let keyed = capabilities.keyedContainerOf(template);
        if (keyed == null || keyed.keyIndex() >= arguments.length) {
            return true;
        }
        Type key = arguments[keyed.keyIndex()];
        if (convert.containsTypeParam(key)) {
            this.recordKeyTypeObligation(template, key, keySpan);
            return true;
        }
        let issue = capabilities.keyTypeIssue(template, key, this.names());
        if (issue == null) {
            return true;
        }
        this.report(issue, keySpan);
        return false;
    }

    // Whether 'value' is a type an 'Atomic' can hold, reporting why not at 'valueSpan'. A value that
    // still names a type parameter is judged once per instantiation instead.
    public acceptsAtomicValue(DeclaredType template, Type value, Span valueSpan) -> bool {
        if (convert.containsTypeParam(value)) {
            if (this.openTrials == 0) {
                let owners = new Set<GreenNode>();
                obligations.collectOwners(value, owners);
                for (let owner in owners) {
                    let obligation = new AtomicValueObligation(template, value, valueSpan);
                    if (owner == this.constraintScopeOwner) {
                        obligation.setGuards(this.constraintScope);
                    }
                    this.deferredObligations.recordObligation(owner, this.resolverFilePath, obligation);
                }
            }
            return true;
        }
        let issue = capabilities.atomicValueIssue("", template, value, this.names());
        if (issue == null) {
            return true;
        }
        this.report(issue, valueSpan);
        return false;
    }

    // Records the judgment against every generic owner the key names, guarded by the active
    // member constraints where they speak about that owner, as a body records its own.
    recordKeyTypeObligation(DeclaredType template, Type key, Span keySpan) {
        if (this.openTrials > 0) {
            return;
        }
        let owners = new Set<GreenNode>();
        obligations.collectOwners(key, owners);
        for (let owner in owners) {
            let obligation = new KeyTypeObligation(template, key, keySpan);
            if (owner == this.constraintScopeOwner) {
                obligation.setGuards(this.constraintScope);
            }
            this.deferredObligations.recordObligation(owner, this.resolverFilePath, obligation);
        }
    }

    mentionScopesFor(InstantiationType instantiation) -> List<MemberConstraint[]> {
        let existing = this.mentionScopes.get(instantiation);
        if (existing != null) {
            return existing;
        }
        let created = new List<MemberConstraint[]>();
        this.mentionScopes.set(instantiation, created);
        return created;
    }

    // Drains the function-type throws lists recorded so far. The checks phase validates them,
    // since judging an 'Error' subclass needs base chains that are still being resolved here.
    public takeFunctionThrowsMentions() -> FunctionThrowsMention[] {
        FunctionThrowsMention[] taken = this.functionThrowsMentions.toArray();
        this.functionThrowsMentions = new List<FunctionThrowsMention>();
        return taken;
    }

    // Drains the instantiation mentions recorded so far.
    public takeInstantiationMentions() -> InstantiationMention[] {
        InstantiationMention[] taken = this.instantiationMentions.toArray();
        this.instantiationMentions = new List<InstantiationMention>();
        this.mentionScopes = new Map<InstantiationType, List<MemberConstraint[]>>();
        return taken;
    }

    // Unqualified lookup order: primitives, type parameters in scope (innermost first), the
    // module's own types, imported types, then the implicit exception base class. A refused import
    // that no implicitly imported module covers resolves to the error type.
    lookupUnqualified(string name) -> Type? {
        let primitive = this.primitiveNamed(name);
        if (primitive != null) {
            return primitive;
        }
        let parameter = this.typeParameterNamed(name);
        if (parameter != null) {
            return parameter;
        }
        let declared = this.store.findDeclared(this.resolverModulePath, name);
        if (declared != null) {
            return declared;
        }
        let binding = this.moduleImports.binding(name);
        if (binding is ImportedType) {
            return binding.target();
        }
        let provided = this.implicitBinding(name);
        if (provided == null && binding is RefusedImport) {
            return this.store.errorType();
        }
        if (provided == null) {
            return types.builtinNamed(this.store, name);
        }
        return provided;
    }

    // The type an implicitly imported module contributes under this name, or null when none
    // of them exports it. Weaker than the module's own declarations and its written imports.
    public implicitBinding(string name) -> DeclaredType? {
        for (let modulePath in implicit.implicitImportPaths()) {
            let declared = this.store.findDeclared(modulePath, name);
            if (declared == null) {
                continue;
            }
            if (types.isVisibleFrom(declared.visibility(), declared.modulePath(),
                    declared.packagePrefix(), this.resolverModulePath,
                    this.resolverPackagePrefix)) {
                return declared;
            }
        }
        return null;
    }

    // A bound naming a parameter of the same list is judged with the arguments substituted in,
    // so '<T: Comparable<T>>' requires 'Comparable<Item>' of 'Item'.
    // Whether the type argument for 'parameter' meets its bounds and its 'shared' marker, reporting
    // each one it fails. A generic method's bounds may also name the type parameters of the type
    // that declares it, which 'receiver', the instantiation it is called on, gives.
    public checkArgumentBounds(TypeParamType parameter, Type[] arguments, Span span,
                               Type? receiver = null) -> bool {
        Type argument = arguments[parameter.index()];
        if (argument is PendingThrowsType) {
            return true;
        }
        if (argument is ThrownListType) {
            bool everyMember = true;
            for (let member in argument.members()) {
                Type[] single = arguments.slice(0, arguments.length);
                single[parameter.index()] = member;
                if (!this.checkArgumentBounds(parameter, single, span, receiver)) {
                    everyMember = false;
                }
            }
            return everyMember;
        }
        bool satisfied = true;
        for (let bound in this.substitutedBounds(parameter, arguments, receiver)) {
            if (hierarchy.satisfiesBound(argument, bound, this.extraBoundsOf(argument))) {
                continue;
            }
            this.report(this.unmetBoundMessage(parameter, argument, bound), span);
            satisfied = false;
        }
        if (parameter.isShared()) {
            let reason = sharing.whyUnshareable(argument);
            if (reason != null) {
                this.report(this.unsharedArgumentMessage(parameter, reason), span);
                satisfied = false;
            }
        }
        let lent = lending.escapingLent(argument, false);
        if (lent != null) {
            this.report("{lending.capitalized(lending.lentArticle(lent, this.names()))} cannot be "
                + "a type argument, because {lending.lentReason(lent, this.names(), "it")}. "
                + lending.parameterFix(lent, this.names()), span);
            satisfied = false;
        }
        return satisfied;
    }

    // The refusal of a type argument another task may not hold, for a parameter declared
    // '<shared T>'.
    unsharedArgumentMessage(TypeParamType parameter, Unshareable reason) -> string {
        string owner = "This generic";
        if (parameter.ownerName().length > 0) {
            owner = "'{parameter.ownerName()}'";
        }
        return "{owner} declares '<shared {parameter.name()}>', so its type argument for "
            + "'{parameter.name()}' must be a type another task may hold, but "
            + sharedtypes.stated(reason, this.names()) + "."
            + sharedtypes.fixFor(reason.innermost(), this.names());
    }

    // The refusal of a type argument that fails one bound of its parameter. A type parameter
    // gains the bound. A class or struct of this package can take on the interface.
    unmetBoundMessage(TypeParamType parameter, Type argument, Type bound) -> string {
        string quotedArgument = this.names().quoted(argument);
        string quotedBound = this.names().quoted(bound);
        string subject = "Type argument {quotedArgument} for type parameter '{parameter.name()}'";
        if (parameter.ownerName().length > 0) {
            subject = "{subject} of '{parameter.ownerName()}'";
        }
        bool isInterface = types.isInterfaceLike(bound);
        string problem = "{subject} must be {quotedBound} or a subclass of it.";
        string fix = "Replace {quotedArgument} with {quotedBound} or a class that extends it.";
        if (isInterface) {
            problem = "{subject} must implement interface {quotedBound}.";
            fix = "Replace {quotedArgument} with a type that implements {quotedBound}";
            let declared = this.writableConformer(argument);
            if (declared == null) {
                fix = "{fix}.";
            } else if (declared.length == 0) {
                string clause = this.names().quotedCode(["implements ", ""], [bound]);
                fix = "{fix}, or add {clause} to the declaration of {quotedArgument}.";
            } else {
                fix = "{fix}, or add {quotedBound} to the 'implements' list of {quotedArgument}.";
            }
        }
        if (argument is TypeParamType) {
            if (!isInterface) {
                for (let existing in argument.bounds()) {
                    if (types.isInterfaceLike(existing)) {
                        continue;
                    }
                    string existingName = this.names().quoted(existing);
                    return "{problem} {quotedArgument} already has the class bound "
                        + "{existingName}, and a type parameter takes one class bound. Replace "
                        + "{existingName} with {quotedBound} or a class that extends {quotedBound}.";
                }
            }
            let written = new List<Type>();
            if (!isInterface) {
                written.push(bound);
            }
            for (let existing in argument.bounds()) {
                written.push(existing);
            }
            if (isInterface) {
                written.push(bound);
            }
            let declaration = new QuotedCode();
            declaration.writeType(argument);
            declaration.write(": ");
            for (long i = 0; i < written.length(); i++) {
                if (i > 0) {
                    declaration.write(" + ");
                }
                declaration.writeType(written.get(i));
            }
            fix = "Add the bound where {quotedArgument} is declared, as in "
                + "{declaration.quotedFor(this.names())}.";
        }
        return "{problem} {fix}";
    }

    // The interfaces a class or struct of this package implements, or null for any other type.
    writableConformer(Type argument) -> Type[]? {
        switch (argument) {
            is ClassType declared -> {
                if (declared.packagePrefix() == this.resolverPackagePrefix) {
                    return declared.interfaces();
                }
            },
            is StructType declared -> {
                if (declared.packagePrefix() == this.resolverPackagePrefix) {
                    return declared.interfaces();
                }
            },
            default -> { },
        }
        return null;
    }

    // The quiet twin of checkArgumentBounds, for callers that filter candidates before selecting
    // which failure to report.
    public boundsSatisfied(TypeParamType parameter, Type[] arguments) -> bool {
        Type argument = arguments[parameter.index()];
        if (parameter.isShared() && !sharing.isShareable(argument)) {
            return false;
        }
        if (lending.escapingLent(argument, false) != null) {
            return false;
        }
        for (let bound in this.substitutedBounds(parameter, arguments)) {
            if (!hierarchy.satisfiesBound(argument, bound, this.extraBoundsOf(argument))) {
                return false;
            }
        }
        return true;
    }

    substitutedBounds(TypeParamType parameter, Type[] arguments, Type? receiver = null) -> Type[] {
        let substituted = new List<Type>();
        for (let bound in parameter.bounds()) {
            Type concrete = this.store.substitute(bound, parameter.owner(), arguments);
            if (receiver is InstantiationType) {
                concrete = this.store.substitute(concrete, receiver.template().declaration(),
                    receiver.arguments());
            }
            substituted.push(concrete);
        }
        return substituted.toArray();
    }

    extraBoundsOf(Type argument) -> Type[] {
        return hierarchy.extraBoundsFor(argument, this.constraintScopeOwner, this.constraintScope);
    }

    // Bound checks wait until every template's members are complete and the instantiation fills
    // have run, because a reference can name a declaration that resolves later and a conformance
    // walk reads an instantiation's substituted base and interfaces. Each check replays under the
    // constraint scope it was recorded in, so a conditional member keeps its extra bounds.
    public checkDeferredBounds() {
        this.checkBoundsImmediately = true;
        let deferred = this.deferredBoundChecks;
        this.deferredBoundChecks = new List<DeferredBoundCheck>();
        for (long i = 0; i < deferred.length(); i++) {
            let check = deferred.get(i);
            let recordedOwner = check.scopeOwner();
            if (recordedOwner != null) {
                this.pushMemberConstraints(recordedOwner, check.scopeConstraints());
            }
            TypeParamType[] parameters = check.template().typeParameterTypes();
            Type[] arguments = check.arguments();
            Span[] spans = check.spans();
            bool bounded = true;
            for (long a = 0; a < parameters.length && a < arguments.length; a++) {
                if (!this.checkArgumentBounds(parameters[a], arguments, spans[a])) {
                    bounded = false;
                }
            }
            let keyed = capabilities.keyedContainerOf(check.template());
            if (bounded && keyed != null && keyed.keyIndex() < spans.length) {
                this.acceptsKeyType(check.template(), arguments, spans[keyed.keyIndex()]);
            }
            if (bounded && capabilities.isAtomicCell(check.template()) && arguments.length > 0
                    && spans.length > 0) {
                this.acceptsAtomicValue(check.template(), arguments[0], spans[0]);
            }
            if (recordedOwner != null) {
                this.popMemberConstraints();
            }
        }
    }

    // Every qualified type name is refused here. A module name reaches only that module's
    // functions, whatever the module declares, and a type parameter takes the head for the whole
    // of the declaration that introduces it. The refusal covers the head and the name, which
    // together have to change.
    lookupQualified(TypeQualifierNode qualifier, string name, Span nameSpan) -> Type {
        string head = qualifier.module().text();
        Span written = source.makeSpan(qualifier.span().start, nameSpan.end() - qualifier.span().start);
        let parameter = this.typeParameterNamed(head);
        if (parameter != null) {
            this.report(this.headTookByParameterMessage(parameter, head, name), written);
            return this.store.errorType();
        }
        let binding = this.moduleImports.binding(head);
        if (binding is ImportedNamespace) {
            let found = this.store.findDeclared(binding.modulePath(), name);
            if (found == null) {
                this.report(typenames.moduleQualifiedMissingTypeMessage("{head}.{name}",
                    binding.importPath(), name, this.moduleImports.typeCandidates(name),
                    this.names()), written);
                return this.store.errorType();
            }
            this.report(typenames.moduleQualifiedTypeMessage("{head}.{name}", found, this.names()), written);
            return this.store.errorType();
        }
        this.report("'{head}' is not an imported module, so '{head}.{name}' names no type. "
            + "Import '{name}' from the module that declares it, then write '{name}'.", written);
        return this.store.errorType();
    }

    // The refusal a qualified type name reads where a type parameter took its head. It names
    // both meanings where the file gives the name another one, and what a type parameter
    // qualifies where it does not.
    headTookByParameterMessage(TypeParamType parameter, string head, string name) -> string {
        let taken = this.shadowedHeadMeaning(head);
        if (taken != null && parameter.ownerName().length > 0) {
            return typenames.typeParameterTookNameMessage(head, parameter.ownerName(), taken);
        }
        return "'{head}.{name}' names a type through the type parameter '{head}', and '{head}' is a "
            + "different type each time it is used, so '{head}.{name}' does not name one type. Write the "
            + "type's own name instead.";
    }

    // The meaning a type parameter took the head name from, as the refusal names it, or null
    // where the name means nothing else in this file.
    shadowedHeadMeaning(string head) -> string? {
        let declared = this.store.findDeclared(this.resolverModulePath, head);
        if (declared != null) {
            return this.declaringPhrase(declared);
        }
        let binding = this.moduleImports.binding(head);
        if (binding is ImportedNamespace) {
            return typenames.importedModulePhrase(binding.importPath());
        }
        if (binding is ImportedType) {
            return this.declaringPhrase(binding.target());
        }
        let offered = this.implicitBinding(head);
        if (offered != null) {
            return this.declaringPhrase(offered);
        }
        return null;
    }

    declaringPhrase(DeclaredType declared) -> string {
        return typenames.declaringPhrase(typenames.kindWordOf(declared), declared.modulePath(),
            declared.packagePrefix(), this.names());
    }

    primitiveNamed(string name) -> Type? {
        return switch (name) {
            "bool" -> this.store.primitive(PrimitiveKind.Bool),
            "byte" -> this.store.primitive(PrimitiveKind.Byte),
            "short" -> this.store.primitive(PrimitiveKind.Short),
            "ushort" -> this.store.primitive(PrimitiveKind.UShort),
            "int" -> this.store.primitive(PrimitiveKind.Int),
            "uint" -> this.store.primitive(PrimitiveKind.UInt),
            "long" -> this.store.primitive(PrimitiveKind.Long),
            "ulong" -> this.store.primitive(PrimitiveKind.ULong),
            "float" -> this.store.primitive(PrimitiveKind.Float),
            "double" -> this.store.primitive(PrimitiveKind.Double),
            "decimal" -> this.store.primitive(PrimitiveKind.Decimal),
            "char" -> this.store.primitive(PrimitiveKind.Char),
            "void" -> this.store.primitive(PrimitiveKind.Void),
            "string" -> this.store.stringType(),
            default -> null,
        };
    }

    // The whole list is in scope while its bounds resolve, so a bound may name the parameter it
    // constrains or a sibling. 'ownerName' is the declaration the list belongs to, which a
    // refusal names the parameter by. Call once per declaration; the interned parameters keep
    // their bounds.
    public resolveTypeParameters(GreenNode owner, string ownerName, TypeParameterListNode? list)
            -> TypeParamType[] {
        if (list == null) {
            return [];
        }
        let pattern = list.pattern();
        if (pattern != null) {
            return this.resolvePatternParameters(owner, ownerName, pattern);
        }
        let interned = new List<TypeParamType>();
        for (long i = 0; i < list.parametersCount(); i++) {
            let parameter = this.store.typeParameter(owner, i, list.parameters(i).name().text());
            parameter.setOwnerName(ownerName);
            if (list.parameters(i).sharedKeyword() != null) {
                parameter.markShared();
            }
            interned.push(parameter);
        }
        TypeParamType[] parameters = interned.toArray();
        this.pushTypeParameters(parameters);
        for (long i = 0; i < parameters.length; i++) {
            let boundsClause = list.parameters(i).bounds();
            if (boundsClause != null) {
                parameters[i].setBounds(this.resolveBoundList(parameters[i].name(), boundsClause));
            }
        }
        this.popTypeParameters(parameters.length);
        return parameters;
    }

    // The type parameters a function-type pattern names: the result and the throws list, the second
    // bounded by 'Error' as every type parameter a throws list names is.
    resolvePatternParameters(GreenNode owner, string ownerName, FunctionTypeNode pattern)
            -> TypeParamType[] {
        string[] names = declare.patternNames(pattern);
        let interned = new List<TypeParamType>();
        for (long i = 0; i < names.length; i++) {
            let parameter = this.store.typeParameter(owner, i, names[i]);
            parameter.setOwnerName(ownerName);
            interned.push(parameter);
        }
        TypeParamType[] parameters = interned.toArray();
        let errorClass = this.implicitBinding("Error");
        if (parameters.length == 2 && errorClass != null) {
            parameters[1].setBounds([errorClass]);
        }
        return parameters;
    }

    // Resolves and validates one bound list under the shared bound rules: interfaces
    // (instantiated forms included), at most one class, no generic-class instantiations, no
    // 'final' classes, each bound listed once. Type-parameter declarations and conditional-member
    // constraints both read their bounds through here.
    public resolveBoundList(string parameterName, BoundsClauseNode boundsClause) -> Type[] {
        let accepted = new List<Type>();
        Type? classBound = null;
        for (long b = 0; b < boundsClause.boundsCount(); b++) {
            let reference = boundsClause.bounds(b);
            Type bound = this.resolveType(reference);
            if (bound is ErrorType) {
                continue;
            }
            bool isInterface = types.isInterfaceLike(bound);
            if (!isInterface && !types.isClassLike(bound)) {
                this.report("A type-parameter bound must be a class that is not generic, or an "
                    + "interface, and {this.names().quoted(bound)} is neither. Name a class or "
                    + "an interface, or remove the bound.", reference.span());
                continue;
            }
            if (!isInterface && bound is InstantiationType) {
                this.report("A type-parameter bound must be a class that is not generic, or an "
                    + "interface, and {this.names().quoted(bound)} is a generic class with type "
                    + "arguments. Bound the parameter by an interface it implements, or use "
                    + "{this.names().quoted(bound)} as the type itself.", reference.span());
                continue;
            }
            bool duplicate = false;
            for (long a = 0; a < accepted.length(); a++) {
                if (accepted.get(a) == bound) {
                    duplicate = true;
                    break;
                }
            }
            if (duplicate) {
                this.report("Type parameter '{parameterName}' already has the bound "
                    + "{this.names().quoted(bound)}. Remove this second "
                    + "{this.names().quoted(bound)}.", reference.span());
                continue;
            }
            if (!isInterface) {
                if (bound is ClassType && bound.isFinal()) {
                    string fix = "Use {this.names().quoted(bound)} directly, or remove 'final' from the "
                        + "class.";
                    if (!bound.isEditable()) {
                        fix = "Use {this.names().quoted(bound)} directly.";
                    }
                    this.report("Bound {this.names().quoted(bound)} is a 'final' class, so only "
                        + "{this.names().quoted(bound)} itself satisfies it. {fix}", reference.span());
                    continue;
                }
                if (classBound != null) {
                    this.report("Type parameter '{parameterName}' already has the class bound "
                        + "{this.names().quoted(classBound)}, and only one bound can be a class. "
                        + "Remove {this.names().quoted(bound)}, or replace it with an interface.",
                        reference.span());
                    continue;
                }
                classBound = bound;
            }
            accepted.push(bound);
        }
        return accepted.toArray();
    }
}

// One instantiation whose type arguments still await their bound checks: the template, the
// resolved arguments, each argument's source span for diagnostics, and the constraint scope the
// reference was resolved in, so the deferred check judges it as its enclosing member would.
class DeferredBoundCheck {
    DeclaredType checkTemplate;
    Type[] checkArguments;
    Span[] checkSpans;
    GreenNode? checkScopeOwner;
    MemberConstraint[] checkScopeConstraints;

    protected constructor(DeclaredType template, Type[] arguments, Span[] spans,
                GreenNode? scopeOwner, MemberConstraint[] scopeConstraints) {
        this.checkTemplate = template;
        this.checkArguments = arguments;
        this.checkSpans = spans;
        this.checkScopeOwner = scopeOwner;
        this.checkScopeConstraints = scopeConstraints;
    }

    protected template() -> DeclaredType {
        return this.checkTemplate;
    }

    protected arguments() -> Type[] {
        return this.checkArguments;
    }

    protected spans() -> Span[] {
        return this.checkSpans;
    }

    protected scopeOwner() -> GreenNode? {
        return this.checkScopeOwner;
    }

    protected scopeConstraints() -> MemberConstraint[] {
        return this.checkScopeConstraints;
    }
}

// The span of a whole generic type reference, 'Slots<Path>', from its name through its type
// arguments. The name comes first in every form that reaches the instantiation.
writtenSpan(Span nameSpan, Span argumentsSpan) -> Span {
    if (argumentsSpan.end() <= nameSpan.start) {
        return nameSpan;
    }
    return {start: nameSpan.start, length: argumentsSpan.end() - nameSpan.start};
}

countOf(long count, string noun) -> string {
    if (count == 1) {
        return "1 {noun}";
    }
    return "{count} {noun}s";
}
