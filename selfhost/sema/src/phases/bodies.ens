// Checks every body of every module. Modules reach each other only through the type store, the
// link tables, and the other modules' function tables (for namespace-qualified calls and for the
// prelude).
public checkBodies(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let contextsByPath = new Map<string, ModuleContext>();
    for (long i = 0; i < contexts.length(); i++) {
        contextsByPath.set(contexts.get(i).module().canonicalPath(), contexts.get(i));
    }
    let preludeScope = prelude.scopeOver(implicit.implicitImportPaths(), contextsByPath);
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new BodyChecker(contexts.get(i), contextsByPath, preludeScope, collected);
        checker.run();
        for (let diagnostic in contexts.get(i).resolver().takeDiagnostics()) {
            collected.push(diagnostic);
        }
    }
    return diagnostics.sorted(collected);
}

// What an unqualified name means at a use site, innermost scope first.
public sealed abstract class NameResolution {
}

class LocalName extends NameResolution {
    protected LocalBinding binding;

    protected constructor(this.binding);
}

// The type parameter in scope under the name, which takes that name for the whole of the
// declaration introducing it, ahead of everything the file declares or imports under it.
class TypeParameterName extends NameResolution {
    protected TypeParamType parameter;

    protected constructor(this.parameter);
}

// The entries a call to this name could reach, and the prelude match they came from when they
// came from there rather than from the module's own function table.
class FunctionName extends NameResolution {
    protected List<FunctionEntry> entries;
    protected PreludeMatch? fromPrelude;

    protected constructor(this.entries, this.fromPrelude);
}

class TypeName extends NameResolution {
    protected DeclaredType target;

    protected constructor(this.target);
}

class NamespaceName extends NameResolution {
    protected string targetModulePath;

    protected constructor(this.targetModulePath);
}

// The target of a compound assignment, or of '++' or '--'. 'nullLevels' counts the '?' levels of
// its own null that a refusal names.
public class WriteTarget {
    protected long levelCount;

    protected constructor(this.levelCount);

    public nullLevels() -> long {
        return this.levelCount;
    }
}

// Why '++' or '--' refuses to change its operand. A misplaced change is refused only where it is
// written, such as inside a lambda.
enum WriteRefusal {
    None,
    Misplaced,
    Unwritable,
}

// The parameter a call's resolution chose for the argument at 'span'.
public final class ChosenParameter {
    protected Span span;
    protected LiteralOrigin origin;

    protected constructor(this.span, this.origin);
}

// One lambda whose body is being checked: the scope outside it, the receiver outside it, and
// what its body has read from either so far. The captures accumulate in first-read order, which
// is the order the closure copies them in.
class LambdaFrame {
    protected Scope? enclosingScope;
    protected Type? enclosingReceiver;
    protected List<LambdaCapture> captures;
    protected List<LocalBinding> capturedBindings;
    protected bool readsReceiver;

    protected constructor(Scope? enclosingScope, Type? enclosingReceiver) {
        this.enclosingScope = enclosingScope;
        this.enclosingReceiver = enclosingReceiver;
        this.captures = new List<LambdaCapture>();
        this.capturedBindings = new List<LocalBinding>();
        this.readsReceiver = false;
    }

    // The binding this name has outside the lambda, or null when the enclosing scope has none.
    protected lookupOuter(string name) -> LocalBinding? {
        let outer = this.enclosingScope;
        if (outer == null) {
            return null;
        }
        return outer.lookup(name);
    }

    protected captureBinding(LocalBinding binding) {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return;
            }
        }
        this.capturedBindings.push(binding);
        this.captures.push(new LambdaCapture(binding, binding.type()));
    }

    // Records that the lambda copies the enclosing receiver; true the first time, so a rejection
    // reports once however many times the body reads 'this'.
    protected captureReceiver(Type receiver) -> bool {
        if (this.readsReceiver) {
            return false;
        }
        this.readsReceiver = true;
        this.captures.push(new LambdaCapture(null, receiver));
        return true;
    }

    protected holds(LocalBinding binding) -> bool {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return true;
            }
        }
        return false;
    }

    protected result() -> LambdaCapture[] {
        return this.captures.toArray();
    }
}

// What a member name means on a receiver type.
public sealed abstract class MemberLookup {
}

class FieldMember extends MemberLookup {
    protected Field field;

    protected constructor(this.field);
}

class MethodMember extends MemberLookup {
    protected List<Method> candidates;

    protected constructor(this.candidates);
}

public class MissingMember extends MemberLookup {
    protected constructor();
}

// Where a member access appears, which decides what a method under its name is reported as. The
// expression around a covered access reports that method itself.
enum MemberPosition {
    Read,
    Write,
    Covered,
}

// Where a refused name stands in the expression it was written in, which decides what route to a
// static of the enclosing type the refusal can offer.
enum NamePosition {
    Value,
    Call,
    MemberHead,
}

// The message a method's name written where a value belongs is refused with. A read cannot hold
// it and a write cannot assign it. 'subject' names the method and its owner, and 'call' is how
// the file writes a call to it.
methodAsValueMessage(string subject, string call, MemberPosition position) -> string {
    if (position == MemberPosition.Write) {
        return subject + ", so it cannot be assigned.";
    }
    return subject + ", and a method's name is not a value. Call it as '{call}'.";
}

// How a lambda makes a method or function a value of the function type expected where its name is
// written: a candidate fits it, the lambda has no text to suggest, no candidate takes what the
// function type passes and returns what it returns, a call returns a value of the function type
// itself, the lambda would call it on a struct's 'this', which a lambda cannot capture, or the lambda
// it is written in was refused that 'this' already.
enum LambdaFit {
    Fits,
    Unwritten,
    Mismatched,
    Called,
    StructThis,
    Refused,
}

// The lambda that makes a method or function a value of the function type expected where its name is
// written. 'kind' is "method" or "function", as the refusal names what was written.
final class LambdaFix {
    string kind;
    LambdaFit fit;
    // The text written before and after the head of the call, as '(a) -> ' and '(a)' for a lambda.
    string before;
    string after;
    // The sentence, opening with a space, that lists what the call throws in the function type, or
    // empty.
    string throwsNote;
    // The sentence after the refusal where no lambda is written: what the function type takes and
    // returns, or why a lambda cannot capture a struct's 'this'.
    string detail;

    constructor(this.kind, this.fit, this.before, this.after, this.throwsNote, this.detail);
}

// The lambda that makes the method or function 'name' a value of the function type 'target', calling
// the first of 'candidates' that takes what 'target' passes and returns what it returns. A parameter of
// the lambda is named after the candidate's, and never after a name of 'taken'.
lambdaFixFor(string kind, string name, Signature[] candidates, FunctionType target, Set<string> taken,
             TypeNames names, TypeStore store, Type? errorClass) -> LambdaFix {
    Type[] passed = target.parameterTypes();
    // A candidate with a type parameter in its types has types that only a call to it decides.
    bool generic = false;
    for (let signature in candidates) {
        if (signature.isGeneric() || mentionsTypeParameter(signature)) {
            generic = true;
            continue;
        }
        if (!fitsFunctionType(signature, passed, target.returnType())) {
            continue;
        }
        let used = taken.copy();
        let parameterNames = new List<string>();
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < passed.length; i++) {
            string chosen = typemembers.freeParameterName(parameters[i].name(), used);
            used.add(chosen);
            parameterNames.push(chosen);
        }
        string listed = "({string.joined(parameterNames.toArray(), ", ")})";
        string before = "{listed} -> ";
        if (signature.declaresThrows()) {
            before = before + "try ";
        }
        string throwsNote = unlistedThrowsNote(name, signature, target, names, store, errorClass);
        return new LambdaFix(kind, LambdaFit.Fits, before, listed, throwsNote, "");
    }
    for (let signature in candidates) {
        if (!signature.isGeneric() && !mentionsTypeParameter(signature)
                && typemembers.requiredParameterCount(signature) == 0
                && !types.isVoidType(signature.returnType())
                && convert.isAssignableStrict(target, signature.returnType())) {
            string before = "";
            if (signature.declaresThrows()) {
                before = "try ";
            }
            return new LambdaFix(kind, LambdaFit.Called, before, "()", "", "");
        }
    }
    if (generic) {
        return unwrittenLambda(kind);
    }
    return new LambdaFix(kind, LambdaFit.Mismatched, "", "", "", "A function of type "
        + "'{functionTypeText(target, names)}' takes {passedText(passed, names)} and returns "
        + "{returnedText(target.returnType(), names)}, and no '{name}' {kind} does.");
}

// Whether a parameter or the return of the signature has a type parameter in its type.
mentionsTypeParameter(Signature signature) -> bool {
    for (let parameter in signature.parameters()) {
        if (convert.containsTypeParam(parameter.type())) {
            return true;
        }
    }
    return convert.containsTypeParam(signature.returnType());
}

// The fix that says a lambda is a value without the text of one.
unwrittenLambda(string kind) -> LambdaFix {
    return new LambdaFix(kind, LambdaFit.Unwritten, "", "", "", "");
}

// The refusal of a lambda calling a method of the struct 'shown' on 'this'.
structThisLambda(string shown) -> LambdaFix {
    return new LambdaFix("method", LambdaFit.StructThis, "", "", "", structThisAdvice(shown));
}

// The refusal of a method named inside a lambda that was refused the struct's 'this' it is read on.
refusedLambda() -> LambdaFix {
    return new LambdaFix("method", LambdaFit.Refused, "", "", "", "");
}

// Why a lambda cannot capture 'this' of the struct 'shown', and what to write instead.
structThisAdvice(string shown) -> string {
    return "'{shown}' is a struct, so the lambda would work on a copy of it. Copy the fields the lambda "
        + "needs into locals, or make '{shown}' a class.";
}

// Whether a lambda refuses to capture a receiver of this type as 'this': a struct, which a lambda
// would copy.
refusesThisCapture(Type receiver) -> bool {
    return !types.isClassLike(receiver) && types.bindingOf(receiver) == null;
}

// Whether a lambda given the parameter types 'passed' can call a method or function of the signature
// with them and return its result where 'returned' is expected.
fitsFunctionType(Signature signature, Type[] passed, Type returned) -> bool {
    Parameter[] parameters = signature.parameters();
    if (passed.length < typemembers.requiredParameterCount(signature)
            || passed.length > parameters.length) {
        return false;
    }
    for (long i = 0; i < passed.length; i++) {
        if (parameters[i].isOut() || !convert.isAssignableStrict(parameters[i].type(), passed[i])) {
            return false;
        }
    }
    if (types.isVoidType(returned)) {
        return true;
    }
    return !types.isVoidType(signature.returnType())
        && convert.isAssignableStrict(returned, signature.returnType());
}

// The sentence, opening with a space, that lists what the call to 'name' throws in the function type
// 'target', which does not list it yet. Empty where 'target' lists it, and where 'target' has a list
// that only the body of 'name' can be judged against.
unlistedThrowsNote(string name, Signature signature, FunctionType target, TypeNames names,
                   TypeStore store, Type? errorClass) -> string {
    if (!signature.declaresThrows()) {
        return "";
    }
    Type[] listed = target.thrownTypes();
    Type[] thrown = signature.throwsTypes();
    let missing = new List<Type>();
    if (thrown.length == 0 && listed.length == 0 && errorClass != null) {
        missing.push(errorClass);
    }
    for (let raised in thrown) {
        bool covered = false;
        for (let allowed in listed) {
            if (hierarchy.isSubclassOf(raised, allowed)) {
                covered = true;
            }
        }
        if (!covered) {
            missing.push(raised);
        }
    }
    if (missing.length() == 0) {
        return "";
    }
    let widenedThrown = new List<Type>();
    for (let allowed in listed) {
        widenedThrown.push(allowed);
    }
    for (let raised in missing) {
        widenedThrown.push(raised);
    }
    Type widened = store.functionOf(target.parameterTypes(), target.returnType(),
        widenedThrown.toArray());
    string note = " The function type it is given to, '{functionTypeText(target, names)}', must also list "
        + "what '{name}' throws";
    if (!names.canSpell(widened)) {
        return note + ".";
    }
    return "{note}, as in '{functionTypeText(widened, names)}'.";
}

// A function type as code writes it, in parentheses where it carries a 'throws' list.
functionTypeText(Type type, TypeNames names) -> string {
    if (type is FunctionType && type.thrownTypes().length > 0) {
        return "({names.of(type)})";
    }
    return names.of(type);
}

// What a function taking the parameter types 'passed' takes, as in "an 'int' and a 'string'".
passedText(Type[] passed, TypeNames names) -> string {
    if (passed.length == 0) {
        return "nothing";
    }
    let items = new List<string>();
    for (let type in passed) {
        items.push(articledTypeText(type, names));
    }
    return diagnostics.andJoined(items.toArray());
}

// What a function returning 'returned' returns, as in "an 'int'".
returnedText(Type returned, TypeNames names) -> string {
    if (types.isVoidType(returned)) {
        return "nothing";
    }
    return articledTypeText(returned, names);
}

articledTypeText(Type type, TypeNames names) -> string {
    string spelled = functionTypeText(type, names);
    return "{typenames.typeArticle(spelled)} '{spelled}'";
}

// The sentences that refuse the name of a method or function written where the function type of 'fix'
// is expected, as the sentence after the one that names the method or the function. 'spelling' is the
// quoted code that writes the lambda.
nameNotValueText(LambdaFix fix, string spelling) -> string {
    string refusal = "A {fix.kind}'s name is not a value";
    return switch (fix.fit) {
        Fits -> "{refusal}, so write a lambda that calls it: {spelling}.{fix.throwsNote}",
        Unwritten -> "{refusal}, so write a lambda that calls it.",
        Called -> "{refusal}, so call it: {spelling}.",
        StructThis -> "{refusal}. A lambda cannot capture 'this' here either: {fix.detail}",
        Refused -> "{refusal}.",
        Mismatched -> "{refusal}. {fix.detail}",
    };
}

// The refusal of a method or function named where the function type of 'fix' is expected, after
// 'subject', which names it. The call is written behind 'head'.
functionValueRefusal(string subject, LambdaFix fix, string head) -> string {
    string spelling = "'{fix.before}{head}{fix.after}'";
    string refusal = "{subject}, and a {fix.kind}'s name is not a value";
    return switch (fix.fit) {
        Fits -> "{refusal}. Write a lambda that calls it instead: {spelling}.{fix.throwsNote}",
        Unwritten -> "{refusal}. Write a lambda that calls it instead.",
        Called -> "{refusal}. Call it as {spelling}.",
        StructThis -> "{refusal}. A lambda cannot capture 'this' here either: {fix.detail}",
        Refused -> "{refusal}.",
        Mismatched -> "{refusal}. {fix.detail}",
    };
}

// Whether a lambda can write 'receiver' again in the call it makes: a name, 'this' of a class, or a
// field of one, none of which runs code when it is read again.
isRepeatablePath(Expression receiver, Type? thisType) -> bool {
    Expression core = wording.unwrapParentheses(receiver);
    if (core is IdentifierExpressionNode) {
        return true;
    }
    if (core is ThisExpressionNode) {
        return thisType != null && !refusesThisCapture(thisType);
    }
    if (core is MemberExpressionNode) {
        return isRepeatablePath(core.object(), thisType);
    }
    return false;
}

// Whether 'receiver' is 'this' of a struct, or a field read from it, which a lambda cannot capture.
rootsAtStructThis(Expression receiver, Type? thisType) -> bool {
    Expression core = wording.unwrapParentheses(receiver);
    if (core is ThisExpressionNode) {
        return thisType != null && refusesThisCapture(thisType);
    }
    if (core is MemberExpressionNode) {
        return rootsAtStructThis(core.object(), thisType);
    }
    return false;
}

// The name a lambda repeating 'receiver' reads first, or empty where that is 'this'.
pathRoot(Expression receiver) -> string {
    Expression core = wording.unwrapParentheses(receiver);
    if (core is IdentifierExpressionNode) {
        return core.name().text();
    }
    if (core is MemberExpressionNode) {
        return pathRoot(core.object());
    }
    return "";
}

// The signatures of 'methods', in their order.
signaturesOf(List<Method> methods) -> Signature[] {
    let found = new List<Signature>();
    for (let method in methods) {
        found.push(method.signature());
    }
    return found.toArray();
}

// The fix for an open type parameter 'parameter' that a member needs bounded by 'bound': add the bound to
// the declaration 'memberWord' names, or where 'parameter' is declared.
addBoundAdvice(string memberWord, string parameter, string bound) -> string {
    if (memberWord.length == 0) {
        return "Add the bound where '{parameter}' is declared, as in '<{parameter}: {bound}>'.";
    }
    return "Add the bound to this {memberWord}, as in '<{parameter}: {bound}>', or to '{parameter}' where "
        + "it is declared.";
}

// What a type argument must be to satisfy the bound 'bound', spelled 'shown' where it is used.
boundKindText(Type bound, Type shown, TypeNames names) -> string {
    if (types.isInterfaceLike(bound)) {
        return "implements '{names.of(shown)}'";
    }
    return "is '{names.of(shown)}' or a subclass of it";
}

// The end of the refusal of an 'is' arm that matches every value of the switch, from the comma or
// full stop after that clause. A first arm makes the switch unnecessary, and a later one can be a
// 'default' arm, since an earlier 'is' arm stays.
everyValueFix(Type scrutineeType, Expression scrutinee, ArmBody body, bool first) -> string {
    if (!first) {
        return ". Use a 'default' arm instead.";
    }
    if (scrutineeType is OptionalType) {
        return " that is not null. Check {wording.sideNamed(scrutinee, "the value")} for null with 'if' "
            + "instead of switching on it.";
    }
    switch (body) {
        is Expression value -> {
            string spelled = wording.oneLineSpelling(value);
            if (spelled.length <= wording.quotedCodeLimit()) {
                return ", so the switch always takes this arm. Write '{spelled}' instead of the switch.";
            }
            return ", so the switch always takes this arm. Write the value of this arm instead of the "
                + "switch.";
        },
        default -> {
            return ", so the switch always takes this arm. Write the statements of this arm instead of the "
                + "switch.";
        },
    }
}

// Whether an 'is' arm for 'armType' matches every value of a switch over 'inner'.
matchesEveryValue(Type inner, Type armType) -> bool {
    return !(armType is OptionalType) && !(armType is TypeParamType) && types.isClassLike(armType)
        && (armType == inner || hierarchy.isSubclassOrConforms(inner, armType));
}

// The head a static method of 'declaring' reached as 'reached' is written behind: the instantiation
// with the type arguments the subclass gives it, or the declaring type's name where they name a type
// parameter.
staticMethodHead(Type reached, DeclaredType declaring) -> Type {
    if (reached is InstantiationType && !convert.containsTypeParam(reached)) {
        return reached;
    }
    return declaring;
}

// A call to one of the static methods 'candidates' as the text written before and after its head:
// 'try ' before it when every one of them throws, and '()' or '(...)' after it.
final class StaticCallText {
    string prefix;
    string suffix;

    constructor(List<Method> candidates) {
        this.prefix = "";
        this.suffix = methodCallText("", candidates);
        if (this.suffix.startsWith("try ")) {
            this.prefix = "try ";
            this.suffix = this.suffix.substring(4);
        }
    }
}

// A call to one of 'candidates' written after 'head': '()' when none of them takes a parameter and
// '(...)' otherwise, after a 'try' when every one of them throws.
methodCallText(string head, List<Method> candidates) -> string {
    bool bare = true;
    bool throwing = candidates.length() > 0;
    for (long i = 0; i < candidates.length(); i++) {
        let signature = candidates.get(i).signature();
        if (signature.parameters().length > 0) {
            bare = false;
        }
        if (!signature.declaresThrows()) {
            throwing = false;
        }
    }
    string call = "{head}(...)";
    if (bare) {
        call = "{head}()";
    }
    if (throwing) {
        return "try " + call;
    }
    return call;
}

// A call an example can write to the signature, carrying the 'try' the call needs. Null where the
// signature is generic, and where it throws what only its body decides.
callExample(string spelling, Signature signature) -> string? {
    Type[] thrown = signature.throwsTypes();
    if (signature.isGeneric() || (signature.declaresThrows() && thrown.length == 0)) {
        return null;
    }
    string arguments = "(...)";
    if (signature.parameters().length == 0) {
        arguments = "()";
    }
    if (thrown.length > 0) {
        return "try {spelling}{arguments}";
    }
    return "{spelling}{arguments}";
}

// The callable whose body is being checked: its parameters and receiver, what a 'return' in it
// is held to, and the loops and catch clause the checked code is in.
public final class CallableFrame {
    Scope? parameterBindings;
    LocalBinding? receiverBinding;
    Type? receiverType;
    // The class or struct whose member body is being checked, statics included; the access
    // rules judge private and protected members from here. Null outside member bodies.
    Type? owningType;
    bool isStatic;
    // True while a callable's body is being checked, and false in a field default, a parameter
    // default, or a lazy const's initializer, none of which declares a parameter.
    bool inBody;
    // The name of the field whose default is being checked, and null outside a field default.
    string? defaultedField;
    // The callable whose body is being checked, and null outside a callable body.
    SyntaxNode? callableNode;
    // True in a callable body and in a lambda body written as a block. A statement can go there.
    bool allowsStatements;
    // The parameters in reach of the expression being checked, in declaration order, with an
    // enclosing callable's ahead of a lambda's own, for a diagnostic that names a value of a
    // type. Empty where the position has none.
    List<LocalBinding> reachableParameters;

    Type? returnType;
    // Where the return type of the callable being checked is declared, for a returned literal that
    // does not fit it. Null where no code can change it in one edit.
    LiteralOrigin? returnOrigin;
    // What a 'return' refusal names as returning, as in "Function 'first'", and the name and parameters
    // a void one offers to declare a return type after, empty where none can be declared.
    string returnSubject;
    string returnHeader;
    bool isNoreturnBody;
    bool inConstructorBody;
    bool hasSuperCall;

    bool inCatch;
    long loopNesting;
    // True while a loop condition is analyzed. A copy made before the loop never changes there.
    bool withinLoopCondition;

    // The frame of code outside any callable body, such as a field default, inside 'owner' or
    // inside no type.
    public constructor(Type? owner) {
        this.parameterBindings = null;
        this.receiverBinding = null;
        this.receiverType = null;
        this.owningType = owner;
        this.isStatic = false;
        this.inBody = false;
        this.defaultedField = null;
        this.callableNode = null;
        this.allowsStatements = false;
        this.reachableParameters = new List<LocalBinding>();
        this.returnType = null;
        this.returnOrigin = null;
        this.returnSubject = "This function";
        this.returnHeader = "";
        this.isNoreturnBody = false;
        this.inConstructorBody = false;
        this.hasSuperCall = false;
        this.inCatch = false;
        this.loopNesting = 0;
        this.withinLoopCondition = false;
    }

    // The frame of a callable's body, before any of its parameters is bound.
    public constructor(Scope parameterScope, LocalBinding? thisBinding, Type? thisType, Type? owner,
                SyntaxNode callable, Type returnType, LiteralOrigin? returnOrigin, string returnSubject,
                string returnHeader, bool isStatic, bool isNoreturn, bool isConstructor) {
        this.parameterBindings = parameterScope;
        this.receiverBinding = thisBinding;
        this.receiverType = thisType;
        this.owningType = owner;
        this.isStatic = isStatic;
        this.inBody = true;
        this.defaultedField = null;
        this.callableNode = callable;
        this.allowsStatements = true;
        this.reachableParameters = new List<LocalBinding>();
        this.returnType = returnType;
        this.returnOrigin = returnOrigin;
        this.returnSubject = returnSubject;
        this.returnHeader = returnHeader;
        this.isNoreturnBody = isNoreturn;
        this.inConstructorBody = isConstructor;
        this.hasSuperCall = false;
        this.inCatch = false;
        this.loopNesting = 0;
        this.withinLoopCondition = false;
    }

    // A lambda body's frame: the return, constructor, loop and catch state start over, a block body
    // allows statements and is the callable when none encloses it, and the rest carries in.
    public forLambda(LambdaExpressionNode lambda, Type returnType, LiteralOrigin? returnOrigin)
            -> CallableFrame {
        let derived = new CallableFrame(this.owningType);
        derived.parameterBindings = this.parameterBindings;
        derived.receiverBinding = this.receiverBinding;
        derived.receiverType = this.receiverType;
        derived.isStatic = this.isStatic;
        derived.inBody = this.inBody;
        derived.defaultedField = this.defaultedField;
        derived.allowsStatements = lambda.body() is BlockNode;
        derived.callableNode = this.callableNode;
        if (derived.allowsStatements && this.callableNode == null) {
            derived.callableNode = lambda;
        }
        for (long i = 0; i < this.reachableParameters.length(); i++) {
            derived.reachableParameters.push(this.reachableParameters.get(i));
        }
        derived.returnType = returnType;
        derived.returnOrigin = returnOrigin;
        derived.returnSubject = "This lambda";
        derived.returnHeader = "";
        derived.hasSuperCall = this.hasSuperCall;
        return derived;
    }

    public parameterScope() -> Scope? {
        return this.parameterBindings;
    }

    public thisBinding() -> LocalBinding? {
        return this.receiverBinding;
    }

    public thisType() -> Type? {
        return this.receiverType;
    }

    public enclosingOwner() -> Type? {
        return this.owningType;
    }

    public inStaticMethod() -> bool {
        return this.isStatic;
    }

    public inCallableBody() -> bool {
        return this.inBody;
    }

    public fieldDefaultName() -> string? {
        return this.defaultedField;
    }

    public callableSyntax() -> SyntaxNode? {
        return this.callableNode;
    }

    public statementsAllowed() -> bool {
        return this.allowsStatements;
    }

    public parametersInReach() -> List<LocalBinding> {
        return this.reachableParameters;
    }

    public currentReturnType() -> Type? {
        return this.returnType;
    }

    public currentReturnOrigin() -> LiteralOrigin? {
        return this.returnOrigin;
    }

    public currentReturnSubject() -> string {
        return this.returnSubject;
    }

    public currentReturnHeader() -> string {
        return this.returnHeader;
    }

    public currentNoreturn() -> bool {
        return this.isNoreturnBody;
    }

    public inConstructor() -> bool {
        return this.inConstructorBody;
    }

    public sawSuperCall() -> bool {
        return this.hasSuperCall;
    }

    public inCatchClause() -> bool {
        return this.inCatch;
    }

    public loopDepth() -> long {
        return this.loopNesting;
    }

    public inLoopCondition() -> bool {
        return this.withinLoopCondition;
    }

    public setFieldDefaultName(string name) {
        this.defaultedField = name;
    }

    public setStatementsAllowed(bool allowed) {
        this.allowsStatements = allowed;
    }

    public noteSuperCall() {
        this.hasSuperCall = true;
    }

    public enterLoop() {
        this.loopNesting++;
    }

    public leaveLoop() {
        this.loopNesting--;
    }

    public enterLoopCondition() {
        this.withinLoopCondition = true;
    }

    public leaveLoopCondition() {
        this.withinLoopCondition = false;
    }

    public enterCatchClause() {
        this.inCatch = true;
    }

    public leaveCatchClause() {
        this.inCatch = false;
    }
}

public final class BodyChecker implements NoreturnCalls {
    ModuleContext moduleContext;
    Map<string, ModuleContext> contextsByModulePath;
    PreludeScope programPrelude;
    TypeResolver typeResolver;
    TypeStore typeStore;
    SemaResult semaResult;
    Reporter bodyReporter;
    TypeNames typeNames;
    string canonicalModulePath;
    string modulePackagePrefix;

    Scope? scope;
    CallableFrame callableFrame;
    // The lambdas whose bodies are being checked, outermost first. Empty in ordinary code; a
    // name the innermost one does not declare itself is a capture.
    List<LambdaFrame> lambdaFrames;
    NarrowingState narrowingState;
    // The 'const' locals declared without a type, and the values 'is' arms matched. A refused write to
    // a constant local gives each its own fix.
    List<LocalBinding> untypedConstants;
    List<LocalBinding> armBindings;
    LiteralTargets literalTargets;

    AssignmentState assignmentState;

    Set<GreenNode> fillProvenNews;
    Map<GreenNode, string> arrayNewNames;

    ObligationRegistry deferredObligations;
    GreenNode? obligationOwner;
    string obligationOwnerName;
    string obligationOwnerDisplay;

    protected constructor(ModuleContext context, Map<string, ModuleContext> contextsByPath,
                PreludeScope preludeScope, List<FileDiagnostic> collected) {
        this.moduleContext = context;
        this.contextsByModulePath = contextsByPath;
        this.programPrelude = preludeScope;
        this.typeResolver = context.resolver();
        this.typeStore = context.resolver().typeStore();
        this.semaResult = context.result();
        this.bodyReporter = new Reporter(context.module().filePath(), collected);
        this.typeNames = context.names();
        this.canonicalModulePath = context.module().canonicalPath();
        this.modulePackagePrefix = context.module().packagePrefix();
        this.lambdaFrames = new List<LambdaFrame>();
        this.narrowingState = new NarrowingState();
        this.callableFrame = new CallableFrame(null);
        this.untypedConstants = new List<LocalBinding>();
        this.literalTargets = new LiteralTargets();
        this.armBindings = new List<LocalBinding>();
        this.assignmentState = new AssignmentState(this.bodyReporter, this.typeNames);
        this.fillProvenNews = new Set<GreenNode>();
        this.arrayNewNames = new Map<GreenNode, string>();
        this.deferredObligations = context.obligations();
        this.obligationOwner = null;
        this.obligationOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    public context() -> ModuleContext {
        return this.moduleContext;
    }

    public contextsByPath() -> Map<string, ModuleContext> {
        return this.contextsByModulePath;
    }

    public preludeScope() -> PreludeScope {
        return this.programPrelude;
    }

    public resolver() -> TypeResolver {
        return this.typeResolver;
    }

    public store() -> TypeStore {
        return this.typeStore;
    }

    public result() -> SemaResult {
        return this.semaResult;
    }

    public reporter() -> Reporter {
        return this.bodyReporter;
    }

    public names() -> TypeNames {
        return this.typeNames;
    }

    public modulePath() -> string {
        return this.canonicalModulePath;
    }

    public packagePrefix() -> string {
        return this.modulePackagePrefix;
    }

    public narrowing() -> NarrowingState {
        return this.narrowingState;
    }

    // The innermost scope of the body being checked, or null outside one.
    public currentScope() -> Scope? {
        return this.scope;
    }

    public frame() -> CallableFrame {
        return this.callableFrame;
    }

    public assignment() -> AssignmentState {
        return this.assignmentState;
    }

    public targets() -> LiteralTargets {
        return this.literalTargets;
    }

    protected run() {
        let root = this.context().root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    this.checkTopLevelFunction(declaration);
                },
                is StructDeclarationNode declaration -> {
                    this.checkStructBodies(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.checkClassBodies(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.checkPrimitiveBindingBodies(declaration);
                },
                is TestDeclarationNode declaration -> {
                    this.checkTestBody(declaration);
                },
                default -> { },
            }
        }
        this.reportPendingLiteralRanges();
    }

    // ---- Declaration walking ----

    checkTopLevelFunction(FunctionDeclarationNode node) {
        let entries = this.context().functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isExternal() || entry.isBuiltin()) {
                continue;
            }
            if (entry.signature().declaration() == node.green()) {
                this.checkParameterDefaults(entry.signature(), null, node);
                this.checkCallableBody(entry.signature(), null, null, null, node);
                return;
            }
        }
    }

    checkStructBodies(StructDeclarationNode node) {
        let found = this.store().findDeclared(this.modulePath(), node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkLazyInitializers(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    checkClassBodies(ClassDeclarationNode node) {
        let found = this.store().findDeclared(this.modulePath(), node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkLazyInitializers(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    // A binding's members belong to the primitive, so 'this' inside one is the primitive value
    // and the members reachable without a receiver are the binding's own.
    checkPrimitiveBindingBodies(PrimitiveDeclarationNode node) {
        let primitive = types.primitiveNamed(this.store(), node.name().text());
        if (primitive == null) {
            return;
        }
        let binding = types.bindingOf(primitive);
        if (binding == null || binding.declaration() != node.green()) {
            return;
        }
        this.checkMemberBodies(primitive, binding.methods(), binding.staticMethods(),
            node.body());
    }

    // Deferred judgments and open generic calls found while checking a generic template's or
    // generic function's bodies record against that owner, keyed by its declaration node.
    enterObligationOwner(DeclaredType found) {
        if (found.isGeneric()) {
            this.obligationOwner = found.declaration();
            this.obligationOwnerName = found.name();
            this.obligationOwnerDisplay = this.names().of(found);
        }
    }

    leaveObligationOwner() {
        this.obligationOwner = null;
        this.obligationOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    public recordObligation(Obligation obligation) {
        let owner = this.obligationOwner;
        if (owner != null) {
            obligation.setGuards(this.activeGuardsFor(owner));
            obligation.setOwnerDisplay(this.obligationOwnerDisplay);
            this.deferredObligations.recordObligation(owner, this.context().module().filePath(),
                obligation);
        }
    }

    recordGenericCall(Signature signature, Type[] arguments, Span at) {
        bool open = false;
        for (let argument in arguments) {
            if (convert.containsTypeParam(argument)) {
                open = true;
            }
        }
        if (!open) {
            this.deferredObligations.recordConcreteCall(signature, arguments,
                new Origin(this.context().module().filePath(), at,
                    obligations.displayFor(signature.name(), arguments, this.names())));
            return;
        }
        let owner = this.obligationOwner;
        if (owner != null) {
            this.deferredObligations.recordOpenCall(owner, this.context().module().filePath(),
                signature, arguments, this.activeGuardsFor(owner));
        }
    }

    // The active conditional member's constraints, as guards for a deferred judgment, when the
    // constrained declaration is the obligation's owner itself.
    activeGuardsFor(GreenNode owner) -> MemberConstraint[] {
        if (this.resolver().activeConstraintOwner() == owner) {
            return this.resolver().activeConstraints();
        }
        return [];
    }

    checkMemberBodies(Type owner, List<Method> methods, List<Method> staticMethods, MemberListNode body) {
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                let method = members.methodDeclaredBy(methods, member.green());
                if (method != null) {
                    this.checkParameterDefaults(method.signature(), owner, member);
                    this.checkCallableBody(method.signature(), owner, owner, method, member);
                    continue;
                }
                let staticMethod = members.methodDeclaredBy(staticMethods, member.green());
                if (staticMethod != null) {
                    this.checkParameterDefaults(staticMethod.signature(), owner, member);
                    this.checkCallableBody(staticMethod.signature(), null, owner, staticMethod,
                        member);
                }
            }
        }
    }

    checkTestBody(TestDeclarationNode node) {
        let parameterScope = new Scope(null);
        this.scope = parameterScope;
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(parameterScope, null, null, null, node,
            this.store().primitive(PrimitiveKind.Void), null, "A test", "", isStatic: false,
            isNoreturn: false, isConstructor: false);
        this.assignment().reset();
        this.enterScope();
        this.walkBlock(node.body());
        this.leaveScope();
        this.scope = null;
        this.callableFrame = outerFrame;
    }

    // Checks one callable's body: the parameter scope (with 'this' for instance methods), a
    // child scope for the body's locals, and the catch clauses as siblings that cannot read those
    // locals. A static method takes its owner but no receiver: the owner's type parameters are
    // in scope and its members are reachable, while 'this' does not exist.
    checkCallableBody(Signature signature, Type? receiver, Type? owner, Method? method,
                              FunctionDeclarationNode node) {
        bool ownsObligations = false;
        if (owner == null && signature.isGeneric()) {
            let declaration = signature.declaration();
            if (declaration != null) {
                ownsObligations = true;
                this.obligationOwner = declaration;
                this.obligationOwnerName = signature.name();
                this.obligationOwnerDisplay = "{signature.name()}<{typeParameterNamesText(signature)}>";
            }
        }
        long pushed = this.pushCallableTypeParameters(signature, owner);
        // Inside a conditional member, the constrained parameters carry the member's extra
        // bounds: lookups, bound checks, and existence checks all read the scope.
        bool pushedConstraints = false;
        if (method != null && method.isConditional() && owner is DeclaredType) {
            this.resolver().pushMemberConstraints(owner.declaration(), method.constraints());
            pushedConstraints = true;
        }
        let parameterScope = new Scope(null);
        this.scope = parameterScope;
        this.narrowingState = new NarrowingState();
        LocalBinding? thisBinding = null;
        if (receiver != null) {
            thisBinding = new LocalBinding("this", receiver, BindingKind.Parameter, true,
                signature.nameSpan());
        }
        string returnSubject = "Function '{signature.name()}'";
        string headerArguments = wording.greenSpelling(node.parameters().green());
        if (headerArguments.length > wording.quotedCodeLimit()) {
            headerArguments = "(...)";
        }
        string returnHeader = "{signature.name()}{headerArguments}";
        if (method != null && method.isConstructor() && owner != null) {
            returnSubject = "The constructor of '{this.names().of(owner)}'";
            returnHeader = "";
        } else if (method != null) {
            returnSubject = "Method '{signature.name()}'";
        }
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(parameterScope, thisBinding, receiver, owner, node,
            signature.returnType(),
            new LiteralOrigin(OriginKind.Returned, signature.name(), "", signature.returnType()),
            returnSubject, returnHeader, isStatic: method != null && method.isStatic(),
            isNoreturn: signature.isNoreturn(), isConstructor: method != null && method.isConstructor());
        if (receiver != null) {
            this.result().setReceiver(node.green(), receiver);
        }

        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            this.frame().parametersInReach().push(binding);
            let scope = this.frame().parameterScope();
            if (scope != null && !scope.define(binding)) {
                string declaredIn = "'{signature.name()}'";
                if (method != null && method.isConstructor() && owner != null) {
                    declaredIn = "the constructor of '{this.names().of(owner)}'";
                }
                this.reporter().report("Parameter '{parameter.name()}' is declared twice in {declaredIn}. "
                    + "Rename one of the two.", parameter.span());
            }
            if (i < parameterList.parametersCount()) {
                this.result().setBinding(parameterList.parameters(i).green(), binding);
            }
        }

        this.assignment().reset();
        // A constructor also tracks its own fields: a this-field shorthand parameter assigns
        // the field before the body runs, and every own non-defaultable field must be assigned
        // on every path that leaves the body normally.
        if (this.frame().inConstructor() && receiver != null) {
            this.seedConstructorFields(signature, receiver);
        }
        let body = node.body();
        if (body != null) {
            this.enterScope();
            this.walkBlock(body);
            this.leaveScope();
        }
        if (this.assignment().constructorFieldOwner() != null) {
            this.assignment().checkConstructorFieldsAssigned(signature.nameSpan());
        }

        this.checkConstructorChainsToBase(signature, node);

        for (long i = 0; i < node.catchClausesCount(); i++) {
            this.checkCatchClause(node.catchClauses(i));
        }

        this.checkReturnPaths(signature, node);

        this.scope = null;
        this.callableFrame = outerFrame;
        if (pushedConstraints) {
            this.resolver().popMemberConstraints();
        }
        this.resolver().popTypeParameters(pushed);
        if (ownsObligations) {
            this.leaveObligationOwner();
        }
    }

    pushCallableTypeParameters(Signature signature, Type? owner) -> long {
        long pushed = 0;
        if (signature.isGeneric()) {
            this.resolver().pushTypeParameters(signature.typeParameters());
            pushed = pushed + signature.typeParameters().length;
        }
        if (owner is DeclaredType) {
            pushed = pushed + this.pushOwnerTypeParameters(owner);
        }
        return pushed;
    }

    // How many of the declaration's own type parameters went into scope, for the caller to
    // pop on its way back out.
    pushOwnerTypeParameters(DeclaredType owner) -> long {
        if (!owner.isGeneric()) {
            return 0;
        }
        TypeParamType[] parameters = owner.typeParameterTypes();
        this.resolver().pushTypeParameters(parameters);
        return parameters.length;
    }

    // A constructor that does not call 'super(...)' runs the base constructor its class's implicit
    // chain chooses, so that chain must choose one that exists here.
    checkConstructorChainsToBase(Signature signature, FunctionDeclarationNode node) {
        if (!this.frame().inConstructor() || this.frame().sawSuperCall()) {
            return;
        }
        let receiver = this.frame().thisType();
        if (receiver != null) {
            this.checkImplicitBaseChain(receiver, signature, node.body() != null, signature.nameSpan());
        }
    }

    // The implicit chain of the receiver's class runs the base constructor it chooses. A chosen
    // constructor that the receiver's type arguments exclude is refused here. A chain that chooses
    // none is refused here only when the receiver's class makes the choice. Otherwise a base class
    // with no constructor makes it, and that class is refused where it is declared.
    checkImplicitBaseChain(Type receiver, Signature? declared, bool declaredHasBody, Span at) {
        let current = types.authorityOf(receiver);
        if (!(current is ClassType)) {
            return;
        }
        let chain = typemembers.implicitBaseConstructor(receiver);
        let owner = chain.owner();
        if (owner == null) {
            return;
        }
        let chosen = chain.chosen();
        if (chosen != null) {
            if (this.resolver().memberExists(chosen)) {
                return;
            }
            string clause = this.excludedConstructorClause(chosen, "constructor");
            if (clause.length > 0) {
                string shownOwner = this.names().of(owner);
                string baseText = "its base class '{shownOwner}' with the zero-argument constructor of "
                    + "'{shownOwner}'.";
                let direct = hierarchy.baseOf(receiver);
                if (direct != null && direct != owner) {
                    string shownDirect = this.names().of(direct);
                    baseText = "its base class '{shownDirect}'. '{shownDirect}' declares no constructor, so "
                        + "it runs the zero-argument constructor of '{shownOwner}'.";
                }
                this.reporter().report("The constructor of '{this.names().nameOf(current)}' cannot "
                    + "initialize " + baseText + " " + clause, at);
            }
            return;
        }
        if (declared == null || chain.chooser() != receiver) {
            return;
        }
        string opening = "The constructor of '{this.names().nameOf(current)}' does not call 'super(...)'";
        this.reporter().report(typemembers.implicitBaseRefusal(opening, chain, declared, declaredHasBody, "",
            this.names()), at);
    }

    // Why an excluded conditional base constructor does not exist here, and the fix. 'memberWord'
    // names the declaration an open type parameter's bound can be added to, empty when none can take it.
    excludedConstructorClause(Method excluded, string memberWord) -> string {
        let template = types.authorityOf(excluded.definingType());
        let failed = this.resolver().firstUnmetConstraint(excluded);
        if (template == null || failed == null) {
            return "";
        }
        string templateShown = "{this.names().nameOf(template)}<{typeParameterExample(template)}>";
        string parameterName = template.typeParameters()[failed.parameterIndex()];
        string declaredBound = this.names().of(failed.bound());
        Type argument = hierarchy.typeArgumentsOf(excluded.definingType())[failed.parameterIndex()];
        string shownArgument = this.names().of(argument);
        if (argument is TypeParamType) {
            return "That constructor exists only when '{parameterName}' satisfies '{declaredBound}', and "
                + "nothing here requires that of '{shownArgument}'. "
                + addBoundAdvice(memberWord, shownArgument, this.names().of(failed.boundHere()));
        }
        string failurePhrase = "which does not implement "
            + "'{this.names().of(failed.boundHere())}'";
        if (!types.isInterfaceLike(failed.bound())) {
            failurePhrase = "which is not '{this.names().of(failed.boundHere())}' or a subclass "
                + "of it";
        }
        return "That constructor exists only when '{parameterName}' satisfies '{declaredBound}', and in "
            + "'{this.names().of(excluded.definingType())}', '{parameterName}' is "
            + "'{shownArgument}', {failurePhrase}. Give '{this.names().nameOf(template)}' a zero-argument "
            + "constructor without that condition, or use a type argument that "
            + boundKindText(failed.bound(), failed.boundHere(), this.names()) + ".";
    }

    // The declaration the bound of an open type parameter used here can be added to: "method",
    // "constructor" or "function", or empty in a test or outside a callable.
    currentMemberWord() -> string {
        if (!this.frame().inCallableBody() || this.frame().currentReturnSubject() == "A test") {
            return "";
        }
        if (this.frame().inConstructor()) {
            return "constructor";
        }
        if (this.frame().thisType() != null || this.frame().inStaticMethod()) {
            return "method";
        }
        return "function";
    }

    // The base constructor a class with no constructor of its own runs, when this instantiation
    // excludes it. It is null when that constructor exists or the chain runs none.
    excludedImplicitBaseConstructor(Type classType) -> Method? {
        let chosen = typemembers.implicitBaseConstructor(classType).chosen();
        if (chosen == null || this.resolver().memberExists(chosen)) {
            return null;
        }
        return chosen;
    }

    // A non-void callable must exit on every path: through its body and through each catch
    // clause it declares. A 'noreturn' callable carries the stronger obligation that no path
    // completes at all.
    checkReturnPaths(Signature signature, FunctionDeclarationNode node) {
        if (signature.isNoreturn()) {
            this.checkNoreturnBody(signature, node);
            return;
        }
        Type returned = signature.returnType();
        if (types.isVoidType(returned) || returned is ErrorType) {
            return;
        }
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter().report("{this.frame().currentReturnSubject()} returns "
                + "'{this.names().of(returned)}', but a path through its body ends without a 'return'. "
                + "Add a 'return' at the end of every path.", signature.nameSpan());
            return;
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter().report("{this.frame().currentReturnSubject()} returns "
                    + "'{this.names().of(returned)}', but a path through its 'catch' clause ends without a "
                    + "'return'. Add a 'return' at the end of every path.", clause.span());
            }
        }
    }

    // A 'noreturn' body must be unable to complete normally: every path ends by throwing,
    // calling 'panic' or another 'noreturn' function, or looping forever. A bodiless form
    // (abstract or interface method) carries the contract without a body to check.
    checkNoreturnBody(Signature signature, FunctionDeclarationNode node) {
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter().report("{this.frame().currentReturnSubject()} is declared 'noreturn', but a path "
                + "through its body ends normally. End every path by throwing, calling 'panic' or calling "
                + "another 'noreturn' function.", signature.nameSpan());
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter().report("{this.frame().currentReturnSubject()} is declared 'noreturn', but a "
                    + "path through its 'catch' clause ends normally. End every path by throwing, calling "
                    + "'panic' or calling another 'noreturn' function.", clause.span());
            }
        }
    }

    // A call ends the path when its target is declared 'noreturn' (the builtin 'panic' among
    // them). 'try noreturnCall()' also ends it: the call either throws or never returns.
    public override callNeverReturns(Expression expression) -> bool {
        Expression core = wording.unwrapParentheses(expression);
        if (core is TryExpressionNode) {
            core = wording.unwrapParentheses(core.operand());
        }
        if (!(core is CallExpressionNode)) {
            return false;
        }
        let target = this.calleeSignatureOf(core);
        return target != null && target.isNoreturn();
    }

    // The static target of a call, or null for a constructor chain or an unresolved callee.
    calleeSignatureOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.result().callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.result().methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.result().callableOf(member.green());
            },
            is SafeMemberExpressionNode member -> {
                let method = this.result().methodOf(member.green());
                if (method != null && !method.isConstructor()) {
                    return method.signature();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // Catch clauses scope against the parameter scope, so body locals stay invisible. The
    // caught-type rules belong to the exception milestone; here the binding resolves and the
    // body walks like any other.
    checkCatchClause(CatchClauseNode clause) {
        this.scope = new Scope(this.frame().parameterScope());
        Type caught = this.resolver().resolveType(clause.caughtType());
        let binding = new LocalBinding(clause.name().text(), caught, BindingKind.Variable,
            false, clause.name().span());
        let owner = this.scope;
        if (owner != null) {
            owner.define(binding);
        }
        this.result().setBinding(clause.green(), binding);
        this.frame().enterCatchClause();
        this.assignment().enterCatchPath();
        this.assignment().trackLocal(binding, assigned: true);
        this.enterScope();
        this.walkBlock(clause.body());
        this.leaveScope();
        // A catch that falls through without rethrowing returns the object normally, so its
        // fields must be assigned there too.
        if (this.assignment().constructorFieldOwner() != null) {
            this.assignment().checkConstructorFieldsAssigned(clause.catchKeyword().span());
        }
        this.frame().leaveCatchClause();
        this.scope = this.frame().parameterScope();
    }

    // Field defaults type against the declared field type. Every sibling field is in scope, not only
    // the ones declared earlier: which of them a default may name is one rule with one precise
    // message, and the checks phase owns it, so a default that names itself or a later field is typed
    // here without being reported a second time as an undefined name.
    // The owner's type parameters are in scope too, because a default is built once per
    // instantiation, where each of them stands for one written type argument.
    checkFieldDefaults(DeclaredType owner, MemberListNode body) {
        let fields = typemembers.fieldsOf(owner);
        long pushed = this.pushOwnerTypeParameters(owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        // Type-level fields stay out on both sides. A static const's initializer is the
        // compile-time constant the constants phase evaluates, and a lazy const's runs on the
        // first read with no instance in reach, so neither is an expression over sibling fields.
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let sink = this.scope;
                if (sink != null) {
                    sink.define(new LocalBinding(member.name().text(),
                        this.fieldTypeOrError(fields, member.name().text()),
                        BindingKind.SiblingField, false, member.name().span()));
                }
            }
        }
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    Type expected = this.fieldTypeOrError(fields, member.name().text());
                    let value = defaultValue.value();
                    this.frame().setFieldDefaultName(member.name().text());
                    Type actual = this.analyzeExpressionAdapt(value, expected,
                        this.valueOrigin(OriginKind.Declared, member.name().text(), expected, value, member));
                    if (!(expected is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(expected, actual)) {
                        this.reporter().report("Field '{member.name().text()}' has type "
                            + "'{this.names().of(expected)}', but its default value has type "
                            + "'{this.names().of(actual)}'."
                            + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}",
                            value.span());
                    }
                }
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // A lazy const's initializer types against the declared type at module scope. It runs on the
    // first read with no instance in reach, so neither 'this' nor a sibling field is visible.
    // The owner's type parameters are in scope so that a use of one is refused as the type
    // parameter it is rather than as an unknown name.
    checkLazyInitializers(DeclaredType owner, MemberListNode body) {
        long pushed = this.pushOwnerTypeParameters(owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FieldDeclarationNode) || !members.fieldModifiers(member).declaresLazy) {
                continue;
            }
            let field = members.findField(typemembers.staticFieldsOf(owner), member.name().text());
            let initializer = member.defaultValue();
            if (field == null || initializer == null) {
                continue;
            }
            // A type the shape check already refused stands for nothing the value could match,
            // so the read below judges the initializer on its own.
            Type expected = field.type();
            if (convert.containsTypeParam(expected) || types.isVoidType(expected)) {
                expected = this.store().errorType();
            }
            let value = initializer.value();
            this.resolver().pushTypeParameterRefusal(this.lazyTypeParameterRefusal(owner, field));
            Type actual = this.analyzeExpressionAdapt(value, expected,
                this.valueOrigin(OriginKind.Declared, field.name(), expected, value, member));
            this.resolver().popTypeParameterRefusal();
            if (!(expected is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(expected, actual)) {
                this.reporter().report("Lazy const '{this.names().nameOf(owner)}.{field.name()}' has type "
                    + "'{this.names().of(expected)}', but its initializer has type "
                    + "'{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // The refusal a type parameter written anywhere inside a lazy const's initializer reads.
    lazyTypeParameterRefusal(DeclaredType owner, Field field) -> string {
        string ownerName = this.names().nameOf(owner);
        return "The initializer of lazy const '{ownerName}.{field.name()}' cannot use a type parameter, "
            + "because one lazy const value is shared by every type argument of '{ownerName}'. Remove "
            + "'lazy const' to give each instance its own '{field.name()}'.";
    }

    fieldTypeOrError(List<Field>? fields, string name) -> Type {
        let field = members.findField(fields, name);
        if (field != null) {
            return field.type();
        }
        return this.store().errorType();
    }

    // Parameter defaults type against the declared parameter type, at module scope: neither
    // the other parameters nor 'this' are visible inside a default.
    // The type parameters of the callable and of its owner are in scope, because a default is
    // built in the instantiation the call reaches.
    checkParameterDefaults(Signature signature, Type? owner, FunctionDeclarationNode node) {
        long pushed = this.pushCallableTypeParameters(signature, owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let parameterNode = parameterList.parameters(i);
            let defaultValue = parameterNode.defaultValue();
            if (defaultValue == null) {
                continue;
            }
            Type expected = this.store().errorType();
            if (i < parameters.length) {
                expected = parameters[i].type();
            }
            let value = defaultValue.value();
            Type actual = this.analyzeExpressionAdapt(value, expected,
                this.valueOrigin(OriginKind.Declared, parameterNode.name().text(), expected, value));
            if (!(expected is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(expected, actual)) {
                this.reporter().report("Parameter '{parameterNode.name().text()}' has type "
                    + "'{this.names().of(expected)}', but its default value has type "
                    + "'{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // ---- Scopes and names ----

    public enterScope() {
        this.scope = new Scope(this.scope);
        this.narrowingState.push();
    }

    public leaveScope() {
        let current = this.scope;
        if (current != null) {
            this.scope = current.parent();
        }
        this.narrowingState.pop();
    }

    public lookupBinding(string name) -> LocalBinding? {
        let current = this.scope;
        if (current == null) {
            return null;
        }
        let own = current.lookup(name);
        if (own != null) {
            return own;
        }
        return this.lookupCapture(name);
    }

    // Unqualified name resolution, innermost declaration first: local scopes, then a type
    // parameter in scope, then the module's functions, then a type this file declares, then the
    // file's imports, then the prelude's functions, then the implicit exception base class.
    resolveName(string name) -> NameResolution? {
        let binding = this.lookupBinding(name);
        if (binding != null) {
            return new LocalName(binding);
        }
        let parameter = this.resolver().typeParameterNamed(name);
        if (parameter != null) {
            return new TypeParameterName(parameter);
        }
        return this.resolveNameOutsideTypeParameters(name);
    }

    // What the name means to the file, with the type parameters in scope left out. A refused
    // type parameter reads this to name the meaning it took the name from.
    public resolveNameOutsideTypeParameters(string name) -> NameResolution? {
        let entries = this.context().functions().entriesNamed(name);
        if (entries != null && entries.length() > 0) {
            return new FunctionName(entries, null);
        }
        let declared = this.store().findDeclared(this.modulePath(), name);
        if (declared != null) {
            return new TypeName(declared);
        }
        let imported = this.context().linkTable().binding(name);
        if (imported is ImportedType) {
            return new TypeName(imported.target());
        }
        if (imported is ImportedNamespace) {
            return new NamespaceName(imported.modulePath());
        }
        let offered = this.preludeScope().match(name, this.modulePath(), this.packagePrefix());
        if (offered != null) {
            return new FunctionName(offered.entries(), offered);
        }
        if (name == "Error") {
            let errorClass = this.resolver().errorClass();
            if (errorClass != null) {
                return new TypeName(errorClass);
            }
        }
        return null;
    }

    // ---- Narrowing ----

    // ---- Definite assignment ----

    // Records the this-field shorthand parameters as assigned before the body runs, so a
    // constructor whose only initialization is 'constructor(this.field)' starts complete.
    // A shorthand parameter is a write, so it meets the same const rule and the same
    // member-access check an ordinary write to the field meets.
    // A const base field reports that refusal alone, since const holds inside the declaring
    // package too.
    seedConstructorFields(Signature signature, Type receiver) {
        this.assignment().enterConstructor(receiver);
        if (typemembers.fieldsOf(receiver) == null) {
            return;
        }
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            if (!parameter.bindsField()) {
                continue;
            }
            let field = typemembers.inheritedOrOwnField(receiver, parameter.name());
            if (field == null) {
                continue;
            }
            if (field.isConst() && field.definingType() != receiver) {
                string baseName = this.constFieldOwnerName(field);
                this.reporter().report("Parameter 'this.{field.name()}' assigns field '{field.name()}', "
                    + "which is 'const' in base class '{baseName}'. Only a constructor of '{baseName}' can "
                    + "assign it. Declare an ordinary parameter, as in '{this.names().of(field.type())} "
                    + "{field.name()}', and pass it to 'super(...)'.", parameter.span());
            } else {
                this.checkMemberAccess(field.name(), field.visibility(), field.definingType(),
                    parameter.span());
            }
            this.assignment().seedField(field, parameter.span());
        }
        this.assignment().finishSeeding();
    }

    // The name a diagnostic about a field's declaring type should use.
    constFieldOwnerName(Field field) -> string {
        let authority = types.authorityOf(field.definingType());
        if (authority != null) {
            return authority.name();
        }
        return this.names().of(field.definingType());
    }

    conditionIsAlwaysTrue(Expression condition) -> bool {
        if (condition is LiteralExpressionNode) {
            return condition.value().kind() == SyntaxKind.TrueKeyword;
        }
        return false;
    }

    // ---- Statements ----

    public walkBlock(BlockNode block) {
        for (long i = 0; i < block.statementsCount(); i++) {
            this.noteArrayFillLoop(block, i);
            this.walkStatement(block.statements(i));
        }
    }

    walkScopedBlock(BlockNode block) {
        this.enterScope();
        this.walkBlock(block);
        this.leaveScope();
    }

    walkStatement(Statement statement) {
        switch (statement) {
            is BlockNode block -> {
                this.walkScopedBlock(block);
            },
            is VariableDeclarationNode declaration -> {
                this.checkVariableDeclaration(declaration);
            },
            is IfStatementNode conditional -> {
                this.checkIfStatement(conditional);
            },
            is WhileStatementNode loop -> {
                this.checkWhileStatement(loop);
            },
            is ForStatementNode loop -> {
                this.checkForStatement(loop);
            },
            is ForEachStatementNode loop -> {
                this.checkForEachStatement(loop);
            },
            is BreakStatementNode broken -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'break' can only be used inside a loop.",
                        broken.span());
                }
                this.assignment().noteBreak();
            },
            is ContinueStatementNode continued -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'continue' can only be used inside a loop.",
                        continued.span());
                }
                this.assignment().terminate();
            },
            is ReturnStatementNode returned -> {
                if (this.assignment().constructorFieldOwner() != null) {
                    this.assignment().checkConstructorFieldsAssigned(returned.returnKeyword().span());
                }
                this.checkReturnStatement(returned);
                this.assignment().terminate();
            },
            is ExpressionStatementNode expression -> {
                this.assignment().setUnconditionalPosition(true);
                this.analyzeExpression(expression.expression());
                if (this.callNeverReturns(expression.expression())) {
                    this.assignment().terminate();
                }
            },
            is ThrowStatementNode thrown -> {
                this.checkThrowStatement(thrown);
                this.assignment().noteThrowEscapePoint(this.frame().inCatchClause());
                this.assignment().terminate();
            },
            is RethrowStatementNode rethrown -> {
                if (!this.frame().inCatchClause()) {
                    this.reporter().report("'rethrow' can only be used inside a 'catch' clause.",
                        rethrown.span());
                }
                this.assignment().terminate();
            },
            is SwitchStatementNode switched -> {
                this.checkSwitchArms(switched.scrutinee(), armsOfStatement(switched),
                    switched.switchKeyword().span(), false, null);
            },
            default -> { },
        }
    }

    checkVariableDeclaration(VariableDeclarationNode node) {
        string name = node.name().text();
        bool isConst = false;
        let modifier = node.modifier();
        if (modifier != null && modifier.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let declaredType = node.declaredType();
        Type bindingType = this.store().errorType();
        if (declaredType == null) {
            bindingType = this.checkInferredDeclaration(node, name);
        } else {
            bindingType = this.checkTypedDeclaration(node, name, declaredType, isConst);
        }
        let binding = new LocalBinding(name, bindingType, BindingKind.Variable, isConst,
            node.name().span());
        if (isConst && declaredType == null) {
            this.untypedConstants.push(binding);
        }
        this.defineLocal(binding, node.name().span());
        this.result().setBinding(node.green(), binding);
        let initializer = node.initializer();
        this.assignment().trackLocal(binding, initializer != null);
        if (initializer != null) {
            let initType = this.result().typeOf(initializer.value().green());
            if (initType != null) {
                narrowing.establishAssignmentNarrowing(this, binding, initType);
            }
        }
    }

    checkInferredDeclaration(VariableDeclarationNode node, string name) -> Type {
        let initializer = node.initializer();
        if (initializer == null) {
            this.reporter().report("Variable '{name}' has no declared type, so its type has to "
                + "come from an initializer. Write 'let {name} = ...;', or declare the type.",
                node.name().span());
            return this.store().errorType();
        }
        Type initType = this.analyzeInitializerOf(name, initializer.value());
        if (initType is NullType) {
            this.reporter().report("'null' alone gives '{name}' no type. Declare its type, as in "
                + "'string? {name} = null;'.", node.name().span());
            return this.store().errorType();
        }
        return initType;
    }

    checkTypedDeclaration(VariableDeclarationNode node, string name,
                                  TypeNode declaredType, bool isConst) -> Type {
        Type declared = this.resolver().resolveType(declaredType);
        if (types.isVoidType(declared)) {
            this.reporter().report("Variable '{name}' cannot have type 'void', because 'void' means no "
                + "value. Give '{name}' the type of the value it stores.", declaredType.span());
            declared = this.store().errorType();
        }
        let initializer = node.initializer();
        if (initializer != null) {
            Type initType = this.analyzeExpressionAdapt(initializer.value(), declared,
                this.valueOrigin(OriginKind.Declared, name, declared, initializer.value(), node));
            if (!(declared is ErrorType) && !(initType is ErrorType)
                    && !convert.isAssignableStrict(declared, initType)) {
                this.reporter().report("Variable '{name}' has type '{this.names().of(declared)}', but its "
                    + "value has type '{this.names().of(initType)}'."
                    + "{nullguidance.valueAssignabilityHint(this, declared, initType, initializer.value())}",
                    initializer.value().span());
            }
            return declared;
        }
        if (isConst && !(declared is ErrorType)) {
            this.reporter().report("Constant '{name}' must be given its value where it is declared. Write it "
                + "after the name, as in 'const {this.names().of(declared)} {name} = ...;'.",
                node.name().span());
            return declared;
        }
        return declared;
    }

    // A local may shadow anything except a sibling local or, at the body's top level, a
    // parameter of the enclosing callable.
    defineLocal(LocalBinding binding, Span span) {
        let current = this.scope;
        if (current == null) {
            return;
        }
        bool collides = !current.define(binding);
        let parameters = this.frame().parameterScope();
        if (!collides && parameters != null && current.parent() == parameters
                && parameters.lookupLocal(binding.name()) != null) {
            this.reporter().report("Variable '{binding.name()}' has the same name as a parameter. "
                + "Rename one of the two.", span);
            return;
        }
        if (collides) {
            this.reporter().report("Variable '{binding.name()}' is already declared earlier in this block. "
                + "Rename one of the two.", span);
        }
    }

    // The narrowing after an 'if' is the intersection of the facts holding at the end of each
    // branch that can fall through; a terminated branch contributes nothing, so the surviving
    // branch's facts pass through unchanged. This subsumes the single-terminating-branch carry:
    // 'if (x == null) { return; }' leaves the else facts, and 'if (x == null) { x = f(); }'
    // narrows x below because the reassigned then-branch and the failed-check else both prove it.
    checkIfStatement(IfStatementNode node) {
        Type condition = this.analyzeExpression(node.condition());
        this.checkConditionIsBool(condition, "if", node.condition());
        let whenTrue = new List<NarrowingFact>();
        let whenFalse = new List<NarrowingFact>();
        narrowing.collectNarrowings(this, node.condition(), true, whenTrue);
        narrowing.collectNarrowings(this, node.condition(), false, whenFalse);

        let entryAssign = this.assignment().snapshot();
        let entryLayers = this.narrowingState.snapshotLayers();
        let entryFacts = this.narrowingState.flatten();

        let thenFacts = narrowing.walkBranchCapture(this, node.thenBranch(), whenTrue);
        let afterThen = this.assignment().snapshot();
        this.assignment().restore(entryAssign);
        this.narrowingState.restoreLayers(entryLayers);

        Map<NarrowingPath, Type> elseFacts;
        let afterElse = entryAssign;
        let elseClause = node.elseClause();
        if (elseClause == null) {
            elseFacts = narrowing.captureConditionBranch(this, whenFalse);
        } else {
            switch (elseClause.body()) {
                is BlockNode block -> {
                    elseFacts = narrowing.walkBranchCapture(this, block, whenFalse);
                    afterElse = this.assignment().snapshot();
                },
                is IfStatementNode chained -> {
                    // An 'else if' is reached only when this condition failed, so the chained
                    // 'if' is checked under the negated facts exactly as an else block is.
                    this.enterScope();
                    narrowing.applyFacts(this, whenFalse);
                    this.checkIfStatement(chained);
                    elseFacts = this.narrowingState.flatten();
                    afterElse = this.assignment().snapshot();
                    this.leaveScope();
                },
                default -> {
                    elseFacts = narrowing.captureConditionBranch(this, whenFalse);
                },
            }
        }
        this.assignment().restore(entryAssign);
        this.narrowingState.restoreLayers(entryLayers);

        let flows = new List<AssignmentFlow>();
        flows.push(afterThen);
        flows.push(afterElse);
        this.assignment().restore(this.assignment().join(flows));

        let survivors = new List<Map<NarrowingPath, Type>>();
        if (!afterThen.terminated()) {
            survivors.push(thenFacts);
        }
        if (!afterElse.terminated()) {
            survivors.push(elseFacts);
        }
        narrowing.applyNarrowingJoin(this, entryFacts, survivors);
    }

    // The condition is rechecked every iteration and body writes drop narrowing at their own
    // point, so condition narrowing is safe in the body.
    checkWhileStatement(WhileStatementNode node) {
        narrowing.preClearLoopBodyWrites(this, node.body());
        // The condition re-evaluates every iteration, so writes in it count as loop writes.
        this.frame().enterLoop();
        this.frame().enterLoopCondition();
        Type condition = this.analyzeExpression(node.condition());
        this.frame().leaveLoopCondition();
        this.frame().leaveLoop();
        this.checkConditionIsBool(condition, "while", node.condition());
        let facts = new List<NarrowingFact>();
        narrowing.collectNarrowings(this, node.condition(), true, facts);
        bool alwaysTrue = this.conditionIsAlwaysTrue(node.condition());
        let postCondition = this.assignment().snapshot();
        this.assignment().beginLoop();
        this.frame().enterLoop();
        narrowing.walkBranch(this, node.body(), facts);
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        if (!alwaysTrue) {
            exits.push(postCondition);
        }
        this.assignment().finishLoop(exits);
    }

    checkForStatement(ForStatementNode node) {
        this.enterScope();
        let initializer = node.initializer();
        if (initializer != null) {
            switch (initializer) {
                is VariableDeclarationNode declaration -> {
                    this.checkVariableDeclaration(declaration);
                },
                is ExpressionStatementNode expression -> {
                    this.analyzeExpression(expression.expression());
                },
                default -> { },
            }
        }
        narrowing.preClearLoopBodyWrites(this, node.body());
        let update = node.update();
        if (update != null) {
            narrowing.preClearLoopBodyWrites(this, update);
        }
        let facts = new List<NarrowingFact>();
        let condition = node.condition();
        bool alwaysTrue = false;
        if (condition != null) {
            // The condition re-evaluates every iteration, so writes in it count as loop writes.
            this.frame().enterLoop();
            this.frame().enterLoopCondition();
            Type conditionType = this.analyzeExpression(condition);
            this.frame().leaveLoopCondition();
            this.frame().leaveLoop();
            this.checkConditionIsBool(conditionType, "for", condition);
            narrowing.collectNarrowings(this, condition, true, facts);
            alwaysTrue = this.conditionIsAlwaysTrue(condition);
        }
        let postCondition = this.assignment().snapshot();
        this.assignment().beginLoop();
        this.frame().enterLoop();
        this.enterScope();
        narrowing.applyFacts(this, facts);
        this.walkBlock(node.body());
        if (update != null) {
            this.assignment().setUnconditionalPosition(true);
            bool outerStatements = this.frame().statementsAllowed();
            this.frame().setStatementsAllowed(false);
            this.analyzeExpression(update);
            this.frame().setStatementsAllowed(outerStatements);
        }
        this.leaveScope();
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        if (condition != null && !alwaysTrue) {
            exits.push(postCondition);
        }
        this.assignment().finishLoop(exits);
        this.leaveScope();
    }

    // The loop needs an array or a value whose type implements 'Iterable<T>', proven non-null; the
    // element binding takes its annotated type when one is written and the element type otherwise.
    checkForEachStatement(ForEachStatementNode node) {
        this.enterScope();
        Type iterable = this.analyzeExpression(node.iterable());
        Type element = this.store().errorType();
        if (!(iterable is ErrorType)) {
            if (iterable is OptionalType) {
                this.reporter().report(nullguidance.maybeNullRefusal(this, "'for (... in ...)' cannot "
                    + "iterate '{this.names().of(iterable)}' because it", node.iterable(), iterable),
                    node.iterable().span());
            } else if (iterable is ArrayType) {
                element = iterable.element();
            } else if (types.isClassLike(iterable) || types.isStructLike(iterable)) {
                element = this.iterableElementType(iterable, node.declaredType(), node.iterable().span());
            } else if (iterable is StringType) {
                this.reporter().report("A 'string' cannot be iterated directly. "
                    + stringWalkAdvice(node.iterable()), node.iterable().span());
            } else {
                this.reporter().report("'for (... in ...)' needs an array or an iterable value, but "
                    + "{wording.sideNamed(node.iterable(), "the value it walks")} has type "
                    + "'{this.names().of(iterable)}'. A class or a struct is iterable when it implements "
                    + "'Iterable<T>' from '@std.collections.iterator'.", node.iterable().span());
            }
        }
        Type bindingType = element;
        let declaredType = node.declaredType();
        if (declaredType != null) {
            Type declared = this.resolver().resolveType(declaredType);
            if (!(declared is ErrorType) && !(element is ErrorType)
                    && !convert.isAssignableStrict(declared, element)) {
                string conformance = nullguidance.valueConformanceHint(declared, element, this.names());
                // The conformance explanation ends with its own suggestion, which names the
                // same type the general one would.
                string fix = "";
                if (conformance.length == 0) {
                    fix = " Declare it as '{this.names().of(element)} {node.name().text()}', or with a wider "
                        + "type.";
                }
                this.reporter().report("Loop variable '{node.name().text()}' has type "
                    + "'{this.names().of(declared)}', but this loop gives it '{this.names().of(element)}' "
                    + "values.{conformance}{fix}", declaredType.span());
            }
            bindingType = declared;
        }
        bool isConst = false;
        let keyword = node.letKeyword();
        if (keyword != null && keyword.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let binding = new LocalBinding(node.name().text(), bindingType, BindingKind.Variable,
            isConst, node.name().span());
        if (isConst && declaredType == null) {
            this.untypedConstants.push(binding);
        }
        let current = this.scope;
        if (current != null) {
            current.define(binding);
        }
        this.result().setBinding(node.green(), binding);
        let entry = this.assignment().snapshot();
        this.assignment().trackLocal(binding, assigned: true);
        this.assignment().beginLoop();
        this.frame().enterLoop();
        narrowing.preClearLoopBodyWrites(this, node.body());
        this.walkScopedBlock(node.body());
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        exits.push(entry);
        this.assignment().finishLoop(exits);
        this.leaveScope();
    }

    // The element type a value yields in a for-in loop. Iteration is nominal: the type must
    // implement 'Iterable<T>' from '@std.collections.iterator', directly or through an
    // interface extending it, and for a class a base class's conformance counts. A value whose
    // own type is 'Iterable<T>' or a sub-interface of it iterates too, and so does a struct that
    // declares the conformance, whose 'makeIterator' is then a direct call.
    iterableElementType(Type core, TypeNode? declaredElement, Span span) -> Type {
        for (let level in hierarchy.conformanceLadderOf(core)) {
            let found = iterableArgument(level);
            if (found != null) {
                return found;
            }
        }
        string element = "E";
        string gloss = ", where 'E' is the type of its elements";
        if (declaredElement != null) {
            element = wording.greenSpelling(declaredElement.green());
            gloss = "";
        }
        string shown = this.names().of(core);
        string kind = "class";
        if (types.isStructLike(core)) {
            kind = "struct";
        }
        let declared = types.authorityOf(core);
        if (declared != null) {
            shown = declared.name();
        }
        this.reporter().report("'{this.names().of(core)}' cannot be used in 'for (... in ...)', because it "
            + "does not implement 'Iterable' from '@std.collections.iterator'. Declare '{kind} {shown} "
            + "implements Iterable<{element}>' and give it the method 'override makeIterator() -> "
            + "Iterator<{element}>'{gloss}.",
            span);
        return this.store().errorType();
    }

    checkReturnStatement(ReturnStatementNode node) {
        if (this.frame().currentNoreturn()) {
            this.reporter().report("{this.frame().currentReturnSubject()} is 'noreturn', so it never "
                + "returns and cannot contain 'return'. Throw, call 'panic' or call another 'noreturn' "
                + "function instead.", node.returnKeyword().span());
            let returned = node.value();
            if (returned != null) {
                this.analyzeExpression(returned);
            }
            return;
        }
        let expected = this.frame().currentReturnType();
        if (expected == null) {
            string place = "outside any of them";
            let field = this.frame().fieldDefaultName();
            if (field != null) {
                place = "in the default value of field '{field}'";
            }
            this.reporter().report("'return' can only be used inside the body of a function, a method or a "
                + "lambda, and this one is {place}. Remove it.", node.returnKeyword().span());
            let ignored = node.value();
            if (ignored != null) {
                this.analyzeExpression(ignored);
            }
            return;
        }
        let value = node.value();
        if (value == null) {
            if (!types.isVoidType(expected)) {
                this.reporter().report("{this.frame().currentReturnSubject()} returns "
                    + "'{this.names().of(expected)}', but this 'return' has no value. "
                    + "Write the value after 'return', as in 'return ...;'.", node.returnKeyword().span());
            }
            return;
        }
        LiteralOrigin? origin = null;
        let returnOrigin = this.frame().currentReturnOrigin();
        if (returnOrigin != null) {
            origin = this.valueOrigin(OriginKind.Returned, returnOrigin.name(), expected, value, node);
        }
        Type actual = this.analyzeExpressionAdapt(value, expected, origin);
        if (types.isVoidType(expected)) {
            string refusal = "{this.frame().currentReturnSubject()} returns nothing, so this 'return' cannot "
                + "have a value.";
            bool spelled = !(actual is ErrorType) && !(actual is NullType) && !types.isVoidType(actual)
                && this.names().canSpell(actual);
            if (this.frame().currentReturnHeader().length > 0 && spelled) {
                refusal = "{refusal} Write 'return;', or declare a return type, as in "
                    + "'{this.frame().currentReturnHeader()} -> {this.names().of(actual)}'.";
            } else if (this.frame().currentReturnHeader().length > 0) {
                refusal = "{refusal} Write 'return;', or declare a return type.";
            } else {
                refusal = "{refusal} Write 'return;'.";
            }
            this.reporter().report(refusal, value.span());
            return;
        }
        if (!convert.isAssignableStrict(expected, actual)) {
            this.reporter().report("{this.frame().currentReturnSubject()} returns "
                + "'{this.names().of(expected)}', but this value has type '{this.names().of(actual)}'."
                + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
        }
    }

    // A type parameter qualifies as a thrown type through a class bound under 'Error', the active
    // constraint scope included.
    checkThrowStatement(ThrowStatementNode node) {
        Type thrown = this.analyzeExpression(node.value());
        if (thrown is ErrorType) {
            return;
        }
        let errorClass = this.resolver().errorClass();
        if (thrown is TypeParamType) {
            if (errorClass == null || !hierarchy.isAlwaysSubclassOfUnder(thrown, errorClass,
                    this.resolver().activeConstraintOwner(), this.resolver().activeConstraints())) {
                string parameter = this.names().of(thrown);
                string where = "where '{parameter}' is declared";
                if (thrown.ownerName().length > 0) {
                    where = "in '{thrown.ownerName()}'";
                }
                this.reporter().report("Cannot throw {wording.sideNamed(node.value(), "this value")}, "
                    + "because its type '{parameter}' is a type parameter without the bound 'Error'. Declare "
                    + "it as '<{parameter}: Error>' {where}.", node.value().span());
            }
            return;
        }
        bool allowed = errorClass != null && types.isClassLike(thrown)
            && hierarchy.isSubclassOf(thrown, errorClass);
        if (!allowed) {
            this.reporter().report("Cannot throw a value of type '{this.names().of(thrown)}'. Only an "
                + "'Error', or an object of a subclass of 'Error', can be thrown.", node.value().span());
        }
    }

    // Refuses the condition 'node' of the statement or operator 'what' unless it is a 'bool'.
    checkConditionIsBool(Type condition, string what, Expression node) {
        if (!(condition is ErrorType) && !convert.isBoolType(condition)) {
            this.reporter().report("The condition of this '{what}' must be a 'bool', but "
                + "{wording.sideNamed(node, "the condition")} has type '{this.names().of(condition)}'.",
                node.span());
        }
    }

    // ---- Expressions ----

    public analyzeExpression(Expression node) -> Type {
        Type analyzed = this.analyzeExpressionInner(node);
        this.result().setType(node.green(), analyzed);
        return analyzed;
    }

    analyzeExpressionInner(Expression node) -> Type {
        switch (node) {
            is LiteralExpressionNode literal -> {
                return literaltyping.analyzeLiteral(this, literal);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeIdentifier(identifier);
            },
            is ThisExpressionNode keyword -> {
                return this.analyzeThis(keyword);
            },
            is SuperExpressionNode keyword -> {
                return this.analyzeSuper(keyword);
            },
            is BinaryExpressionNode binary -> {
                return this.analyzeBinary(binary);
            },
            is PrefixExpressionNode prefix -> {
                return this.analyzePrefix(prefix);
            },
            is PostfixExpressionNode postfix -> {
                return this.analyzePostfix(postfix);
            },
            is CallExpressionNode call -> {
                return this.analyzeCall(call, null);
            },
            is GenericNameExpressionNode generic -> {
                return this.analyzeGenericNameValue(generic);
            },
            is MemberExpressionNode member -> {
                return this.analyzeMemberValue(member);
            },
            is SafeMemberExpressionNode member -> {
                return this.analyzeSafeMemberValue(member);
            },
            is SubscriptExpressionNode subscript -> {
                return this.analyzeSubscript(subscript);
            },
            is SafeSubscriptExpressionNode subscript -> {
                return this.analyzeSafeSubscript(subscript);
            },
            is CastExpressionNode cast -> {
                return narrowing.analyzeCast(this, cast);
            },
            is CheckedCastExpressionNode cast -> {
                return narrowing.analyzeCheckedCast(this, cast);
            },
            is TypeTestExpressionNode test -> {
                return narrowing.analyzeTypeTest(this, test);
            },
            is AssignmentExpressionNode assignment -> {
                return this.analyzeAssignment(assignment);
            },
            is TernaryExpressionNode ternary -> {
                return this.analyzeTernary(ternary, null);
            },
            is NullCoalesceExpressionNode coalesce -> {
                return this.analyzeNullCoalesce(coalesce);
            },
            is NewExpressionNode created -> {
                return this.analyzeNew(created);
            },
            is ParenthesizedExpressionNode parenthesized -> {
                return this.analyzeExpression(parenthesized.inner());
            },
            is ArrayLiteralExpressionNode literal -> {
                return this.analyzeArrayLiteral(literal);
            },
            is StructLiteralExpressionNode literal -> {
                return literaltyping.analyzeStructLiteral(this, literal);
            },
            is InterpolatedStringExpressionNode interpolated -> {
                return literaltyping.analyzeInterpolatedString(this, interpolated);
            },
            is TryExpressionNode tried -> {
                return this.analyzeTry(tried);
            },
            is SwitchExpressionNode switched -> {
                return this.analyzeSwitchExpression(switched, null);
            },
            is LambdaExpressionNode lambda -> {
                this.reporter().report("This lambda has no function type to give its parameters and its "
                    + "result their types. Write it where a function type is declared, as in "
                    + "'(int, int) -> int compare = (a, b) -> a - b;'.", lambda.span());
                return this.store().errorType();
            },
            is ErrorExpressionNode ignored -> {
                return this.store().errorType();
            },
        }
    }

    // Analyzes toward a target type, which gives a lambda, an array or struct literal, an untyped
    // literal and a generic call the type they lack. A '?:', a switch and parentheses pass the target
    // on, and 'origin' is where it is set.
    public analyzeExpressionAdapt(Expression node, Type target, LiteralOrigin? origin = null) -> Type {
        if (node is ParenthesizedExpressionNode) {
            Type adapted = this.analyzeExpressionAdapt(node.inner(), target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is LambdaExpressionNode) {
            let outerHolder = this.targets().lambdaHolder();
            this.targets().setLambdaHolder(origin);
            Type adapted = this.analyzeLambda(node, target);
            this.targets().setLambdaHolder(outerHolder);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is ArrayLiteralExpressionNode) {
            Type adapted = this.analyzeArrayLiteralAdapt(node, target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is StructLiteralExpressionNode) {
            Type adapted = this.analyzeStructLiteralAdapt(node, target);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        Type analyzed = this.store().errorType();
        if (node is CallExpressionNode) {
            analyzed = this.analyzeCall(node, target);
            this.result().setType(node.green(), analyzed);
        } else if (node is TernaryExpressionNode) {
            analyzed = this.analyzeTernary(node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else if (node is SwitchExpressionNode) {
            analyzed = this.analyzeSwitchExpression(node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else {
            this.targets().stash(node, target, origin);
            analyzed = this.analyzeExpression(node);
            this.targets().clearStash();
        }
        if (target is ErrorType || analyzed is ErrorType) {
            return analyzed;
        }
        // A 'char' is a code point rather than a quantity. Arithmetic on it in integers is
        // meaningful, but as a floating-point number it has no use, so the refusal says why
        // instead of leaving the reader to wonder which conversion was missing.
        Type held = convert.coreOf(target);
        if (types.isCharType(analyzed) && isTextualFloat(held)) {
            string name = this.names().of(held);
            string spelled = wording.oneLineSpelling(node);
            if (!wording.isSingleTerm(node)) {
                spelled = "({spelled})";
            }
            string fix = "Write '{spelled} as {name}' to use that number as a '{name}'.";
            if (wording.unwrapParentheses(node) is LiteralExpressionNode) {
                fix = "Add 'as {name}' after the literal to use that number as a '{name}'.";
            }
            this.reporter().report("A 'char' is a character's number in Unicode, its code point, and it "
                + "never converts to '{name}' on its own. " + fix, node.span());
            this.result().setType(node.green(), this.store().errorType());
            return this.store().errorType();
        }
        this.noteSuffixedTarget(node, target, origin);
        return this.adaptIntegerLiteral(node, target, origin)
            ?? literaltyping.adaptCharLiteral(this, node, target)
            ?? this.adaptFloatLiteral(node, target, origin) ?? analyzed;
    }

    // ---- Lambdas ----

    // The fix for the lambda 'node' written where a type that is not a function type is declared, with
    // a function type example taking the lambda's parameters.
    lambdaTypeAdvice(LambdaExpressionNode node) -> string {
        let parts = new StringBuilder();
        for (long i = 0; i < node.parametersCount(); i++) {
            if (i > 0) {
                parts.append(", ");
            }
            let written = node.parameters(i).declaredType();
            if (written != null) {
                parts.append(wording.greenSpelling(written.green()));
            } else {
                parts.append("int");
            }
        }
        string example = "({parts.toString()}) -> int";
        let holder = this.targets().lambdaHolder();
        if (holder != null && holder.kind() == OriginKind.Declared && holder.name().length > 0) {
            return "Declare '{holder.name()}' with a function type instead, such as '{example}'.";
        }
        return "Write it where a function type such as '{example}' is declared.";
    }

    // Checks a lambda against the function type its surroundings expect. The target supplies the
    // parameter types the lambda leaves out and the return type its body is checked against. The body is
    // checked as a callable of its own: its own scope, its own narrowing, its own loops, and a
    // return type of its own, so nothing about the enclosing control flow reaches into it. What
    // it reads from outside is a capture, recorded for the phases that lower it.
    analyzeLambda(LambdaExpressionNode node, Type target) -> Type {
        Type core = convert.coreOf(target);
        if (core is ErrorType) {
            return this.store().errorType();
        }
        if (!(core is FunctionType)) {
            this.reporter().report("A lambda is a function value, so it cannot be "
                + "{typenames.typeArticle(this.names().of(target))} '{this.names().of(target)}'. "
                + this.lambdaTypeAdvice(node), node.span());
            return this.store().errorType();
        }
        Type[] expected = core.parameterTypes();
        if (!this.checkLambdaShape(node, core, expected)) {
            return this.store().errorType();
        }
        let parameters = new List<Parameter>();
        for (long i = 0; i < node.parametersCount(); i++) {
            let declared = node.parameters(i);
            parameters.push(new Parameter(declared.name().text(), expected[i], false, false,
                false, declared.name().span()));
        }
        let signature = new Signature("lambda", parameters.toArray(),
            core.returnType(), false, false, [], [], [], node.green(), node.span());
        let captures = this.checkLambdaBody(node, signature);
        this.result().setLambda(node.green(),
            new LambdaInfo(signature, core, captures));
        return core;
    }

    // The lambda's parameter list against the target's: the same count, all types written or
    // none, and every written type exactly the one the target passes. Invariant, so a written
    // type that merely accepts the target's is still a mismatch.
    checkLambdaShape(LambdaExpressionNode node, FunctionType target, Type[] expected) -> bool {
        long given = node.parametersCount();
        if (given != expected.length) {
            string mine = parameterCountText(given);
            string theirs = parameterCountText(expected.length);
            this.reporter().report("This lambda takes {mine}, but '{this.names().of(target)}' "
                + "takes {theirs}. Write it as '{lambdaShapeExample(expected.length)}'.",
                node.span());
            return false;
        }
        long typed = 0;
        for (long i = 0; i < given; i++) {
            if (node.parameters(i).declaredType() != null) {
                typed++;
            }
        }
        if (typed > 0 && typed < given) {
            this.reporter().report("This lambda gives a type to some parameters and not to others. Write a "
                + "type for every parameter or for none, as in '(int a, int b) -> a + b' or "
                + "'(a, b) -> a + b'.", node.span());
            return false;
        }
        bool matched = true;
        for (long i = 0; i < given; i++) {
            let reference = node.parameters(i).declaredType();
            if (reference == null) {
                continue;
            }
            Type written = this.resolver().resolveType(reference);
            if (written is ErrorType) {
                matched = false;
                continue;
            }
            if (written != expected[i]) {
                this.reporter().report("Parameter '{node.parameters(i).name().text()}' is declared "
                    + "'{this.names().of(written)}', but the function type '{this.names().of(target)}' gives "
                    + "it {typenames.typeArticle(this.names().of(expected[i]))} "
                    + "'{this.names().of(expected[i])}'. Write '{this.names().of(expected[i])} "
                    + "{node.parameters(i).name().text()}', or leave the type out.", reference.span());
                matched = false;
            }
        }
        return matched;
    }

    // Walks the lambda's body under its own checker state and returns what it captured.
    checkLambdaBody(LambdaExpressionNode node, Signature signature) -> LambdaCapture[] {
        let lambdaFrame = new LambdaFrame(this.scope, this.frame().thisType());
        let outerScope = this.scope;
        let outerNarrowing = this.narrowingState;
        let outerFrame = this.callableFrame;
        let outerDeferred = this.targets().deferredFixes();
        bool outerAwaiting = this.targets().awaitingParameter();
        let outerAssignment = this.assignmentState;

        this.lambdaFrames.push(lambdaFrame);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let innerFrame = outerFrame.forLambda(node, signature.returnType(),
            this.returnOriginThrough(this.targets().lambdaHolder(), signature.returnType()));
        this.callableFrame = innerFrame;
        this.targets().setLambdaHolder(null);
        this.targets().setDeferredFixes(null);
        this.targets().setAwaitingParameter(false);
        this.assignmentState = outerAssignment.forLambda();

        Parameter[] parameters = signature.parameters();
        let lambdaScope = this.scope;
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            this.frame().parametersInReach().push(binding);
            if (lambdaScope != null && !lambdaScope.define(binding)) {
                this.reporter().report("Parameter '{parameter.name()}' is declared twice in this lambda. "
                    + "Rename one of the two.", parameter.span());
            }
            this.result().setBinding(node.parameters(i).green(), binding);
        }

        this.enterScope();
        this.walkLambdaBody(node, signature.returnType());
        this.leaveScope();

        this.lambdaFrames.pop();
        this.scope = outerScope;
        this.narrowingState = outerNarrowing;
        this.callableFrame = outerFrame;
        // A 'super(...)' in the lambda counts as the enclosing constructor's own.
        if (innerFrame.sawSuperCall()) {
            outerFrame.noteSuperCall();
        }
        this.targets().setDeferredFixes(outerDeferred);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.assignmentState = outerAssignment;
        return lambdaFrame.result();
    }

    // A block body is a function body: every path must return a value when the target returns
    // one. An expression body is the value itself, unless the target returns nothing, in which
    // case it is evaluated and discarded like an expression statement.
    walkLambdaBody(LambdaExpressionNode node, Type returned) {
        let body = node.body();
        if (body is BlockNode) {
            this.walkBlock(body);
            if (!types.isVoidType(returned) && !(returned is ErrorType)
                    && !flow.blockTerminates(body, ExitScope.Function, this)) {
                this.reporter().report("This lambda returns '{this.names().of(returned)}', but a path "
                    + "through its body ends without a 'return'. Add a 'return' at the end of every path.",
                    node.arrow().span());
            }
            return;
        }
        if (body is Expression) {
            if (types.isVoidType(returned)) {
                this.analyzeExpression(body);
                return;
            }
            Type actual = this.analyzeExpressionAdapt(body, returned, this.frame().currentReturnOrigin());
            if (!(returned is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(returned, actual)) {
                this.reporter().report("This lambda must return '{this.names().of(returned)}', but its body "
                    + "has type '{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, returned, actual, body)}", body.span());
            }
        }
    }

    // A name the lambda being checked does not declare itself: the enclosing lambdas' scopes,
    // outermost last, then the enclosing callable's. Finding one there is a capture, and every
    // lambda between the declaration and the use copies it.
    lookupCapture(string name) -> LocalBinding? {
        for (long i = this.lambdaFrames.length() - 1; i >= 0; i--) {
            let found = this.lambdaFrames.get(i).lookupOuter(name);
            if (found == null) {
                continue;
            }
            for (long j = i; j < this.lambdaFrames.length(); j++) {
                this.lambdaFrames.get(j).captureBinding(found);
            }
            return found;
        }
        return null;
    }

    // Records that every lambda being checked copies the enclosing receiver, which is what makes
    // 'this' readable, its fields writable, and its methods callable inside a lambda. A struct
    // receiver is refused: copying it would give the lambda its own struct, so a write through
    // the copy would not be a write to the one the method runs over. A primitive receiver is a
    // value nothing can write through, so copying it changes nothing and it is allowed.
    captureReceiver(Type receiver, Span at) {
        long depth = this.lambdaFrames.length();
        if (depth == 0) {
            return;
        }
        if (refusesThisCapture(receiver)) {
            if (this.lambdaFrames.get(depth - 1).captureReceiver(receiver)) {
                this.reporter().report("A lambda cannot capture 'this' here: "
                    + structThisAdvice(this.names().of(receiver)), at);
            }
            return;
        }
        for (long i = 0; i < depth; i++) {
            let ignored = this.lambdaFrames.get(i).captureReceiver(receiver);
        }
    }

    // Whether the binding is declared outside the lambda being checked, so a write to it would land on
    // the lambda's own copy.
    isCapturedBinding(LocalBinding binding) -> bool {
        if (this.lambdaFrames.length() == 0) {
            return false;
        }
        return this.lambdaFrames.get(this.lambdaFrames.length() - 1).holds(binding);
    }

    // Reports a write to a captured local; true when it reported. 'action' names what the write
    // would do, so '=' and '++' read naturally.
    reportCapturedWrite(LocalBinding binding, string action, Span at) -> bool {
        if (!this.isCapturedBinding(binding)) {
            return false;
        }
        this.reporter().report("Cannot {action} '{binding.name()}' inside a lambda: a lambda works "
            + "on copies of what it captures, so the '{binding.name()}' outside it would not "
            + "change. Return the value the lambda computes and store it where the lambda is called, or "
            + "keep the value in a field of an object the lambda uses.", at);
        return true;
    }

    // Reports a write refused for where it stands rather than for what it names; true when it
    // reported. 'action' names what the write would do, so '=' and '++' read naturally.
    reportRefusedWrite(LocalBinding binding, string action, Span at) -> bool {
        if (this.reportCapturedWrite(binding, action, at)) {
            return true;
        }
        return this.reportSiblingFieldWrite(binding, at);
    }

    // The binding a write to a member chain changes, or null where the chain changes another
    // object instead. A struct field lives in the value that holds it, so a chain of them
    // changes what stands at its root, while a class reference or an array element anywhere
    // along it leads to storage of its own.
    writtenChainRoot(Expression target) -> LocalBinding? {
        Expression root = wording.unwrapParentheses(target);
        while (root is MemberExpressionNode) {
            let objectType = this.result().typeOf(root.object().green());
            if (objectType == null || !types.isStructLike(objectType)) {
                return null;
            }
            root = wording.unwrapParentheses(root.object());
        }
        if (root is IdentifierExpressionNode) {
            return this.result().bindingOf(root.green());
        }
        return null;
    }

    // Reports a write to a sibling field inside a field default; true when it reported. A
    // default is the value of the field it belongs to, so it reads its siblings and writes none
    // of them. A default naming its own field is refused by the checks phase instead.
    reportSiblingFieldWrite(LocalBinding binding, Span at) -> bool {
        if (binding.kind() != BindingKind.SiblingField) {
            return false;
        }
        let defaulted = this.frame().fieldDefaultName();
        if (defaulted == null || defaulted == binding.name()) {
            return false;
        }
        this.reporter().report("Field '{binding.name()}' cannot be assigned inside the default of "
            + "'{defaulted}'. A default gives its own field a value and reads earlier ones, so "
            + "give '{binding.name()}' its value in its own default, or assign both fields in a "
            + "constructor.", at);
        return true;
    }

    // Retypes an untyped integer literal to the integer type the target has without its '?', and
    // returns the new type, the error type when it does not fit, or null. A literal that does not fit
    // gets 'fix', or else the change at 'origin'.
    adaptIntegerLiteral(Expression node, Type target, LiteralOrigin? origin = null,
                        JoinText? fix = null) -> Type? {
        if (node is ParenthesizedExpressionNode) {
            return literaltyping.adaptedInParentheses(this, node,
                this.adaptIntegerLiteral(node.inner(), target, origin, fix));
        }
        Type core = convert.coreOf(target);
        if (core is PrimitiveType) {
            return this.adaptIntegerLiteralTo(node, core, origin, fix);
        }
        return null;
    }

    // adaptIntegerLiteral for a target that is a primitive type.
    adaptIntegerLiteralTo(Expression node, PrimitiveType target, LiteralOrigin? origin,
                          JoinText? fix) -> Type? {
        if (!convert.isIntegerType(target)) {
            return null;
        }
        let literal = literaltyping.intLiteralOf(node);
        if (literal == null) {
            return null;
        }
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        if (magnitude == null) {
            return null;
        }
        bool negative = literaltyping.isNegativeLiteral(node);
        if (!literalvalues.magnitudeFits(negative, magnitude, target.kind())) {
            string sign = "";
            if (negative) {
                sign = "-";
            }
            string written = "{sign}{literal.value().text()}";
            let widening = this.integerWidening(negative, magnitude, target);
            let root = this.targets().joinRoot();
            if (this.isCoveredLiteral(wording.unwrapParentheses(node).green())) {
                this.result().setType(node.green(), this.store().errorType());
                return this.store().errorType();
            }
            if (fix == null && root != null && isJoinLiteral(root, node)) {
                let failure = new JoinFailure(node.span(), written, literal.value().text(), negative,
                    magnitude, target, origin);
                failure.setBesideLiteral(this.targets().besideLiteral());
                this.targets().joinFailures().push(failure);
            } else if (fix == null) {
                this.reporter().report(integerTooLarge(written, widening, this.literalFix(origin, widening)),
                    node.span());
            } else if (fix.toward() != null && root != null) {
                let failure = new JoinFailure(node.span(), written, literal.value().text(), negative,
                    magnitude, target, node, fix);
                this.targets().joinFailures().push(failure);
            } else {
                this.holdOrReport(node.span(), integerTooLarge(written, widening, fix.fix()),
                    integerTooLarge(written, widening, fix.why()), integerTooLarge(written, widening, ""),
                    fix.clause(), widening);
                this.coverJoinLiterals(fix, node);
            }
            this.result().setType(node.green(), this.store().errorType());
            return this.store().errorType();
        }
        this.result().setType(node.green(), target);
        this.result().setType(literal.green(), target);
        return target;
    }

    // Retypes a literal to the floating-point core of 'target' and returns the new type, the error
    // type when it does not fit, or null. A literal that does not fit gets 'fix', or else the change
    // at 'origin'.
    adaptFloatLiteral(Expression node, Type target, LiteralOrigin? origin = null,
                      JoinText? fix = null) -> Type? {
        if (node is ParenthesizedExpressionNode) {
            return literaltyping.adaptedInParentheses(this, node,
                this.adaptFloatLiteral(node.inner(), target, origin, fix));
        }
        Type core = convert.coreOf(target);
        if (core is PrimitiveType) {
            return this.adaptFloatLiteralTo(node, core, origin, fix);
        }
        return null;
    }

    // adaptFloatLiteral for a target that is a primitive type.
    adaptFloatLiteralTo(Expression node, PrimitiveType target, LiteralOrigin? origin,
                        JoinText? fix) -> Type? {
        if (target.kind() != PrimitiveKind.Float && target.kind() != PrimitiveKind.Double) {
            return null;
        }
        let literal = literaltyping.floatLiteralOf(node);
        if (literal == null) {
            // An untyped integer literal names a floating-point value just as well, so it takes
            // a floating-point target under the same rule. No 64-bit magnitude reaches either
            // type's limit, so these always fit and only the precision rounds.
            let integer = literaltyping.intLiteralOf(node);
            if (integer == null || literalvalues.integerMagnitude(integer.value().text()) == null) {
                return null;
            }
            this.result().setType(node.green(), target);
            this.result().setType(integer.green(), target);
            return target;
        }
        if (literalOverflows(literal, target.kind())) {
            double magnitude = literalvalues.floatMagnitude(literal.value().text());
            string sign = "";
            if (literaltyping.isNegativeLiteral(node)) {
                sign = "-";
            }
            string written = "{sign}{literal.value().text()}";
            if (fix == null) {
                string text = this.literalFix(origin, floatWidening());
                this.reporter().report(literaltyping.floatTooLarge(written, magnitude, target.kind(), text),
                    node.span());
            } else if (fix.toward() != null && this.targets().joinRoot() != null) {
                let failure = new JoinFailure(node.span(), written, literal.value().text(), false, 0, target,
                    node, fix);
                this.targets().joinFailures().push(failure);
            } else {
                this.holdOrReport(node.span(),
                    literaltyping.floatTooLarge(written, magnitude, target.kind(), fix.fix()),
                    literaltyping.floatTooLarge(written, magnitude, target.kind(), fix.why()),
                    literaltyping.floatTooLarge(written, magnitude, target.kind(), ""), fix.clause(),
                    floatWidening());
            }
            this.result().setType(node.green(), this.store().errorType());
            return this.store().errorType();
        }
        this.result().setType(node.green(), target);
        this.result().setType(literal.green(), target);
        return target;
    }

    public recordLiteralRange(LiteralExpressionNode node, PrimitiveType defaultType) {
        string text = node.value().text();
        if (convert.isIntegerType(defaultType)) {
            let magnitude = literalvalues.integerMagnitude(text);
            if (magnitude != null && literalvalues.magnitudeFits(false, magnitude, defaultType.kind())) {
                return;
            }
            ulong value = 0;
            bool parsed = magnitude != null;
            if (magnitude != null) {
                value = magnitude;
            }
            this.targets().pendingLiteralRanges().push(new PendingLiteralRange(node.green(), node.span(),
                defaultType, text, false, parsed, value));
            return;
        }
        if (literalvalues.floatMagnitudeFits(literalvalues.floatMagnitude(text),
                defaultType.kind())) {
            return;
        }
        this.targets().pendingLiteralRanges().push(new PendingLiteralRange(node.green(), node.span(),
            defaultType, text, false, false, 0));
    }

    // A sign is a prefix outside the literal, and it moves the integer boundary: the
    // magnitude 2147483648 is not an 'int' on its own but -2147483648 is. The pending entry
    // moves up to the prefix so adaptation and the diagnostic both cover the whole value.
    retargetLiteralRange(PrefixExpressionNode outer, Expression operand, bool negative) {
        let ranges = this.targets().pendingLiteralRanges();
        if (ranges.length() == 0) {
            return;
        }
        let pending = ranges.get(ranges.length() - 1);
        if (pending.green() != operand.green()) {
            return;
        }
        if (negative && pending.parsed() && literalvalues.magnitudeFits(true, pending.magnitude(),
                pending.defaultType().kind())) {
            ranges.pop();
            return;
        }
        pending.moveTo(outer.green(), outer.span(), negative);
    }

    reportPendingLiteralRanges() {
        for (let pending in this.targets().pendingLiteralRanges()) {
            // Retyped by a target-typed position, which already judged the value there.
            let finalType = this.result().typeOf(pending.green());
            if ((finalType != null && finalType != pending.defaultType())
                    || this.isCoveredLiteral(pending.green())) {
                continue;
            }
            string sign = "";
            if (pending.negative()) {
                sign = "-";
            }
            string typeName = this.names().of(pending.defaultType());
            if (convert.isIntegerType(pending.defaultType())) {
                string written = "{sign}{pending.text()}";
                string wider = literaltyping.widerIntegerHolding(pending.negative(), pending.magnitude(),
                    pending.defaultType().kind());
                if (!pending.parsed() || wider.length == 0) {
                    this.reporter().report(literaltyping.beyondEveryInteger(written, pending.negative()),
                        pending.span());
                } else {
                    string refusal = literaltyping.integerPastRange(written, pending.negative(),
                        pending.defaultType().kind(), typeName);
                    this.reporter().report(
                        "{refusal} {literaltyping.typedLiteralFix(written, pending.text(), wider)}",
                        pending.span());
                }
            } else {
                double magnitude = literalvalues.floatMagnitude(pending.text());
                string suffix = pending.text().substring(pending.text().length - 1);
                string fix = pending.fix();
                if (fix.length == 0) {
                    fix = "Remove the '{suffix}' from '{sign}{pending.text()}'.";
                }
                this.reporter().report(literaltyping.floatTooLarge("{sign}{pending.text()}", magnitude,
                    pending.defaultType().kind(), fix), pending.span());
            }
        }
        this.targets().resetPendingLiteralRanges();
    }

    // Reports the literals of the join 'root' that did not fit the type they were given, once, at the
    // first of them: with the type that takes every literal and every integer value of the join.
    reportJoinFailures(Expression root) {
        let failures = this.targets().joinFailures();
        if (failures.length() == 0) {
            return;
        }
        JoinFailure? uncovered = null;
        for (let failure in failures) {
            if (uncovered == null && !this.coversSpan(root, failure.span())) {
                uncovered = failure;
            }
        }
        if (uncovered == null) {
            return;
        }
        let first = uncovered;
        let literal = first.literal();
        let beside = first.beside();
        let toward = first.toward();
        if (literal != null && beside != null && toward != null) {
            this.reportArrayJoinLiteral(root, first, literal, beside, toward);
            return;
        }
        PrimitiveKind kind = first.target().kind();
        let widening = this.joinFailureWidening(root, first);
        let literals = widening.literals() ?? new List<Expression>();
        let values = new List<Expression>();
        collectJoinValues(root, values, true);
        Expression? source = null;
        for (let value in values) {
            Type core = convert.coreOf(this.recordedType(value));
            if (source == null && core is PrimitiveType && core.kind() == kind) {
                source = value;
            }
        }
        let origin = first.origin();
        bool negativeUnsigned = (widening.negative() || widening.lowNegative()) && isUnsignedKind(kind);
        string fix = "";
        if (origin != null && !negativeUnsigned) {
            fix = this.literalFix(origin, widening);
        } else if (origin == null && source != null && !first.besideLiteral()) {
            Expression typed = wording.unwrapParentheses(source);
            string named = wording.oneLineSpelling(typed);
            string why = wording.takesTypeFrom("'{named}'", this.names().of(first.target()));
            fix = why;
            if (widening.wider().length > 0) {
                string converted = wording.converted(typed, widening.wider());
                string? example = null;
                if (!(root is ArrayLiteralExpressionNode)) {
                    example = armExample(root, typed.green(), converted);
                }
                if (example == null) {
                    let changed = new List<GreenNode>();
                    for (let value in values) {
                        Type core = convert.coreOf(this.recordedType(value));
                        if (core is PrimitiveType && core.kind() == kind) {
                            changed.push(wording.unwrapParentheses(value).green());
                        }
                    }
                    example = spelledConverting(root, changed, widening.wider());
                }
                fix = "{why} Convert '{named}' first ('{example}').";
            }
        } else if (origin == null && widening.wider().length > 0) {
            fix = literaltyping.typedLiteralFix(first.written(), first.text(), widening.wider());
        }
        string refusal = literaltyping.integerPastRange(first.written(), first.negative(), kind,
            this.names().of(first.target()));
        if (fix.length > 0) {
            refusal = "{refusal} {fix}";
        }
        this.reporter().report(refusal, first.span());
        for (let literal in literals) {
            if (literal.span().start != first.span().start
                    || isPendingLiteral(this.targets().pendingLiteralRanges(), literal)) {
                this.targets().coveredLiterals().push(literal.green());
            }
        }
    }

    // Reports the literal 'first' of the array literal 'root', which takes its type 'toward' from
    // 'beside', with the fix that converts every value of that type in the array.
    reportArrayJoinLiteral(Expression root, JoinFailure first, Expression literal, Expression beside,
                           Type toward) {
        if (first.target().kind() == PrimitiveKind.Float) {
            this.reportArrayJoinFloat(root, first, literal, beside, toward);
            return;
        }
        let widening = this.joinWidening(literal, toward, root);
        if (widening == null) {
            return;
        }
        string into = this.conversionType(first.fixTarget(), widening);
        string written = this.arrayConverted(root, toward, into);
        let text = this.joinFix(beside, toward, written, "", first.fixTarget(), first.fixOrigin(), root,
            widening);
        this.reporter().report(integerTooLarge(first.written(), widening, text.fix()), first.span());
        let literals = widening.literals() ?? new List<Expression>();
        for (let other in literals) {
            if (other.span().start != first.span().start) {
                this.targets().coveredLiterals().push(other.green());
            }
        }
    }

    // reportArrayJoinLiteral for a literal too large for 'float', which the fix converts every 'float'
    // value of the array for. The other literals of the array are covered by the same fix.
    reportArrayJoinFloat(Expression root, JoinFailure first, Expression literal, Expression beside,
                         Type toward) {
        let widening = floatWidening();
        string into = this.conversionType(first.fixTarget(), widening);
        string written = this.arrayConverted(root, toward, into);
        let text = this.joinFix(beside, toward, written, "", first.fixTarget(), first.fixOrigin(), root,
            widening);
        double magnitude = 0.0;
        let parsed = literaltyping.floatLiteralOf(literal);
        if (parsed != null) {
            magnitude = literalvalues.floatMagnitude(parsed.value().text());
        }
        this.reporter().report(literaltyping.floatTooLarge(first.written(), magnitude, PrimitiveKind.Float,
            text.fix()), first.span());
    }

    // The widening of the first kept literal 'first' of the join 'root': every literal of the join and
    // the type that takes them and every integer value of the join.
    joinFailureWidening(Expression root, JoinFailure first) -> Widening {
        PrimitiveKind kind = first.target().kind();
        let literals = new List<Expression>();
        collectJoinLiterals(root, literals, true);
        let values = new List<Expression>();
        collectJoinValues(root, values, true);
        let widening = new Widening(kind, this.names().of(first.target()), "", first.negative(),
            first.magnitude());
        widening.setJoined(true);
        spanJoinLiterals(widening, literals);
        let kinds = new List<PrimitiveKind>();
        for (let value in values) {
            Type core = convert.coreOf(this.recordedType(value));
            if (core is PrimitiveType && convert.isIntegerType(core)) {
                kinds.push(core.kind());
            }
        }
        widening.setWider(commonIntegerHolding(kind, kinds.toArray(), widening));
        return widening;
    }

    // Keeps with the literals of the join 'root' each literal of it that nothing gave a type to and
    // that is too large for the type it falls back to, in source order.
    keepPendingJoinLiterals(Expression root) {
        let literals = new List<Expression>();
        collectJoinLiterals(root, literals, true);
        for (let pending in this.targets().pendingLiteralRanges()) {
            let finalType = this.result().typeOf(pending.green());
            if (!pending.parsed() || !convert.isIntegerType(pending.defaultType())
                    || (finalType != null && finalType != pending.defaultType())) {
                continue;
            }
            for (let literal in literals) {
                if (literal.green() == pending.green()) {
                    let failure = new JoinFailure(pending.span(),
                        "{pending.negative() ? "-" : ""}{pending.text()}", pending.text(), pending.negative(),
                        pending.magnitude(), pending.defaultType(), null);
                    failure.setBesideLiteral(true);
                    this.insertJoinFailure(failure);
                }
            }
        }
    }

    // Adds 'failure' to the literals the current join kept, in source order.
    insertJoinFailure(JoinFailure failure) {
        let ordered = new List<JoinFailure>();
        bool placed = false;
        for (let kept in this.targets().joinFailures()) {
            if (!placed && failure.span().start < kept.span().start) {
                ordered.push(failure);
                placed = true;
            }
            ordered.push(kept);
        }
        if (!placed) {
            ordered.push(failure);
        }
        this.targets().setJoinFailures(ordered);
    }

    // Whether a literal of the join 'root' that starts where 'span' does is already covered by a fix.
    coversSpan(Expression root, Span span) -> bool {
        let literals = new List<Expression>();
        collectJoinLiterals(root, literals, true);
        for (let literal in literals) {
            if (literal.span().start == span.start && this.isCoveredLiteral(literal.green())) {
                return true;
            }
        }
        return false;
    }

    // Whether the literal belongs to a join already refused with a fix that covers it.
    isCoveredLiteral(GreenNode green) -> bool {
        for (let covered in this.targets().coveredLiterals()) {
            if (covered == green) {
                return true;
            }
        }
        return false;
    }

    // Records the literals 'fix' covers besides 'reported', the one its refusal is reported at.
    coverJoinLiterals(JoinText fix, Expression reported) {
        let covered = fix.covered();
        if (covered == null) {
            return;
        }
        for (let literal in covered) {
            if (literal.green() != wording.unwrapParentheses(reported).green()) {
                this.targets().coveredLiterals().push(literal.green());
            }
        }
    }

    // True when the name belongs to an import that the link phase refused and reported.
    isRefusedImport(string name) -> bool {
        return this.context().linkTable().binding(name) is RefusedImport;
    }

    analyzeIdentifier(IdentifierExpressionNode node) -> Type {
        string name = node.name().text();
        if (name.length == 0) {
            return this.store().errorType();
        }
        let wanted = this.targets().functionTargetOf(node.green());
        let primitive = types.primitiveNamed(this.store(), name);
        if (primitive != null) {
            this.reportTypeAsValue(name, primitive, node.name().span());
            return this.store().errorType();
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            if (this.isRefusedImport(name)) {
                return this.store().errorType();
            }
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter().report(this.staticWithoutType(name, ownerName, false, wanted),
                    node.name().span());
                return this.store().errorType();
            }
            this.reporter().report("Undefined name '{name}'. Check the spelling, or declare it "
                + "before it is used.", node.name().span());
            return this.store().errorType();
        }
        switch (resolution) {
            is LocalName local -> {
                this.result().setBinding(node.green(), local.binding);
                this.assignment().checkDefiniteAssignment(local.binding, node.name().span());
                let proven = this.narrowingState.provenType(narrow.bindingPath(local.binding));
                if (proven != null) {
                    return proven;
                }
                return local.binding.type();
            },
            is FunctionName functions -> {
                this.reportFunctionAsValue(name, functions.entries, node.name().span(), name, wanted);
                return this.store().errorType();
            },
            is TypeName named -> {
                this.reportTypeAsValue(name, named.target, node.name().span());
                return this.store().errorType();
            },
            is TypeParameterName held -> {
                this.reportTypeParameterRefusal("'{name}' is a type parameter, not a value.",
                    held.parameter, node.name().span(), NamePosition.Value);
                return this.store().errorType();
            },
            is NamespaceName module -> {
                this.reportModuleAsValue(name, module.targetModulePath, node.name().span());
                return this.store().errorType();
            },
        }
    }

    // 'named' is the type the refused name stands for, and 'spelling' is how this file writes
    // that name.
    reportTypeAsValue(string spelling, Type named, Span at) {
        this.reporter().report(this.typeAsValueMessage(spelling, named), at);
    }

    // The message a type name written where a value belongs is refused with.
    typeAsValueMessage(string spelling, Type named) -> string {
        return this.typeRefusalMessage("'{spelling}' is a type, not a value.", spelling, named);
    }

    // A type name written as the callee of a call. The routes are the ones a value position
    // offers, since a type name reaches no call of its own.
    reportTypeAsCall(string spelling, Type named, Span at) {
        this.reporter().report(this.typeRefusalMessage("'{spelling}' is a type, not a function.",
            spelling, named), at);
    }

    // The refusal sentence the position writes, then the routes to a value of the type this
    // file can spell.
    typeRefusalMessage(string refusal, string spelling, Type named) -> string {
        string fix = this.typeAsValueFix(spelling, named);
        if (fix.length == 0) {
            return refusal;
        }
        return "{refusal} {fix}.";
    }

    // 'refusal' is the sentence the position writes, followed by how this position reaches a
    // value of the parameter's type. Only a parameter holds one, so the route names one in
    // reach, else the one a callable's body can declare, and a default reaches neither.
    reportTypeParameterRefusal(string refusal, TypeParamType parameter, Span at, NamePosition position) {
        string name = parameter.name();
        string written = refusal;
        let inReach = this.parameterOfType(parameter);
        if (inReach != null) {
            written = "{refusal} Use a value of type '{name}', such as '{inReach.name()}'.";
        } else if (this.frame().inCallableBody()) {
            written = "{refusal} Use a value of type '{name}', such as a parameter declared '{name} value'.";
        }
        this.reporter().report(this.typeParameterMessage(parameter, written, position), at);
    }

    // The parameter in reach whose type is this one, innermost first, or null where none is. A
    // local is left out, because naming one would need it to be assigned where it is named.
    parameterOfType(Type type) -> LocalBinding? {
        for (long i = this.frame().parametersInReach().length() - 1; i >= 0; i--) {
            let binding = this.frame().parametersInReach().get(i);
            if (binding.type() == type) {
                return binding;
            }
        }
        return null;
    }

    // What a refused type parameter reads: the collision where it took the name from another
    // meaning of the file, the refusal of a position that can use no type parameter at all, and
    // 'plain' where the name means nothing else there.
    typeParameterMessage(TypeParamType parameter, string plain, NamePosition position) -> string {
        let asStatic = this.shadowedStaticMessage(parameter, position);
        if (asStatic != null) {
            return asStatic;
        }
        string name = parameter.name();
        // 'obligationOwnerName' is the generic declaration whose body is being checked, which
        // is the one whose header introduced the parameter.
        string genericOwner = this.obligationOwnerName;
        let taken = this.shadowedMeaning(name);
        if (taken == null || genericOwner.length == 0) {
            return this.resolver().typeParameterRefusal() ?? plain;
        }
        return typenames.typeParameterTookNameMessage(name, genericOwner, taken);
    }

    // A static of the enclosing type under the refused name, or null where it declares none. A
    // static const is read through the plain type name, while a static method of a generic type
    // needs the type arguments that only such a call itself could otherwise determine. Where the
    // name was written as a call, reading the static const also means dropping the arguments.
    shadowedStaticMessage(TypeParamType parameter, NamePosition position) -> string? {
        let owner = this.frame().enclosingOwner();
        if (owner == null) {
            return null;
        }
        let authority = types.authorityOf(owner);
        if (authority == null) {
            return null;
        }
        string name = parameter.name();
        string ownerName = authority.name();
        string kind = "";
        if (members.findField(typemembers.staticFieldsOf(owner), name) != null) {
            kind = "static const";
        } else if (members.findMethodNamed(typemembers.staticMethodsOf(owner), name) != null) {
            kind = "static method";
        } else {
            return null;
        }
        string refusal = "'{name}' means the type parameter of '{ownerName}' here, not the {kind} "
            + "'{ownerName}' declares, because inside '{ownerName}' the name '{name}' always means the "
            + "type parameter.";
        if (kind == "static method") {
            return "{refusal} Rename one of the two.";
        }
        if (position == NamePosition.Call) {
            return "{refusal} A static const is not called. Write '{ownerName}.{name}' to read it, or rename "
                + "one of the two and remove the arguments.";
        }
        return "{refusal} Write '{ownerName}.{name}' to read the static const, or rename one of the two.";
    }

    // The meaning a type parameter took its name from, as the refusal names it, or null where
    // the name means nothing else in the file.
    shadowedMeaning(string name) -> string? {
        let outside = this.resolveNameOutsideTypeParameters(name);
        if (outside == null) {
            return null;
        }
        switch (outside) {
            is TypeName named -> {
                return this.declaringPhrase(typenames.kindWordOf(named.target),
                    named.target.modulePath());
            },
            is FunctionName functions -> {
                let offered = functions.fromPrelude;
                if (offered == null) {
                    return this.declaringPhrase("function", this.modulePath());
                }
                string[] paths = offered.modulePaths();
                if (paths.length != 1) {
                    return null;
                }
                return this.declaringPhrase("function", paths[0]);
            },
            is NamespaceName module -> {
                return typenames.importedModulePhrase(module.targetModulePath);
            },
            default -> {
                return null;
            },
        }
    }

    // Where a shadowed meaning is declared, as the refusal names it.
    declaringPhrase(string kindWord, string modulePath) -> string {
        return typenames.declaringPhrase(kindWord, modulePath, this.modulePath());
    }

    // How this file writes a value of the type, then how it reaches a static member of it. A
    // route this file cannot spell is left out, and the fix is empty where it can spell neither.
    typeAsValueFix(string spelling, Type named) -> string {
        string value = this.valueRoute(spelling, named);
        let staticMember = this.staticMemberExample(spelling, named);
        if (staticMember == null) {
            return value;
        }
        string purpose = "to read one of its static consts";
        if (staticMember.endsWith(")")) {
            purpose = "to call one of its static methods";
        }
        if (value.length == 0) {
            return "Write '{staticMember}' {purpose}";
        }
        return "{value}, or write '{staticMember}' {purpose}";
    }

    // The way a value of the type is written where the refused name stands, or empty where this
    // file can spell none. A primitive's values are its literals, which the refusal leaves to
    // the reader.
    valueRoute(string spelling, Type named) -> string {
        let authority = types.authorityOf(named);
        if (authority == null) {
            return "";
        }
        switch (authority) {
            is InterfaceType ignored -> {
                return "Use a value of a class that implements it";
            },
            is EnumType enumType -> {
                string[] constants = enumType.memberNames();
                if (constants.length == 0) {
                    return "";
                }
                return "Write '{spelling}.{constants[0]}' to use one of its members";
            },
            is ClassType classType -> {
                if (classType.isAbstract()) {
                    return "Use a value of a subclass that is not abstract";
                }
                // Constructing a generic class needs type arguments, and an example cannot put
                // one there that the use site has a name for.
                if (classType.isGeneric()) {
                    return "";
                }
                let arguments = this.classConstructionArguments(classType);
                if (arguments == null) {
                    return "";
                }
                return "Write 'new {spelling}{arguments}' to construct one";
            },
            is StructType structType -> {
                // A generic struct needs type arguments in its constructor call and in the
                // literal alike, and an example cannot name one.
                if (structType.isGeneric()) {
                    return "";
                }
                return this.structValueRoute(spelling, structType);
            },
            default -> {
                return "";
            },
        }
    }

    // How a struct value is written: a constructor call, or an aggregate literal where this file
    // can reach no constructor.
    structValueRoute(string spelling, Type structType) -> string {
        let arguments = this.reachableConstructorArguments(structType);
        if (arguments != null) {
            return "Write '{spelling}{arguments}' to construct one";
        }
        let literal = this.structLiteralExample(spelling, structType);
        if (literal == null) {
            return "";
        }
        return "Write '{literal}' to build one";
    }

    // A declaration that builds the struct from an aggregate literal, naming every field the
    // literal has to set. Null where a field it has to set cannot be set from this file.
    structLiteralExample(string spelling, Type structType) -> string? {
        let fields = typemembers.fieldsOf(structType);
        if (fields == null) {
            return null;
        }
        let listed = new StringBuilder();
        for (long i = 0; i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.hasDefault()) {
                continue;
            }
            if (!this.isAccessAllowed(field.visibility(), field.definingType())) {
                return null;
            }
            if (!listed.isEmpty()) {
                listed.append(", ");
            }
            listed.append("{field.name()}: ...");
        }
        return "{spelling} value = \{{listed.toString()}\};";
    }

    // The argument list a 'new' of the class writes, or null where this file can reach no
    // constructor of it.
    classConstructionArguments(Type classType) -> string? {
        if (typemembers.constructorsOf(classType).length() > 0) {
            return this.reachableConstructorArguments(classType);
        }
        if (this.reachesImplicitConstruction(classType)) {
            return "()";
        }
        return null;
    }

    // '()' where a constructor this file can reach takes no argument, '(...)' where the ones it
    // can reach take arguments, and null where it can reach none.
    reachableConstructorArguments(Type record) -> string? {
        let constructors = typemembers.constructorsOf(record);
        bool anyReachable = false;
        for (long i = 0; i < constructors.length(); i++) {
            let candidate = constructors.get(i);
            if (!this.resolver().memberExists(candidate)
                    || !this.isAccessAllowed(candidate.visibility(), candidate.definingType())) {
                continue;
            }
            if (calls.requiredArgumentCount(candidate.signature()) == 0) {
                return "()";
            }
            anyReachable = true;
        }
        if (anyReachable) {
            return "(...)";
        }
        return null;
    }

    // Whether a class that declares no constructor of its own is constructed with no arguments.
    // Its implicit chain must run a base constructor that exists here, or none at all.
    reachesImplicitConstruction(Type classType) -> bool {
        let chain = typemembers.implicitBaseConstructor(classType);
        if (chain.owner() == null) {
            return true;
        }
        let chosen = chain.chosen();
        return chosen != null && this.resolver().memberExists(chosen);
    }

    // One static member of the type this file can reach, written after 'spelling'. A type-level
    // const reads as a value on its own and a static method reads as a call.
    staticMemberExample(string spelling, Type named) -> string? {
        let fields = typemembers.staticFieldsOf(named);
        if (fields != null) {
            for (long i = 0; i < fields.length(); i++) {
                let field = fields.get(i);
                if (this.isAccessAllowed(field.visibility(), field.definingType())) {
                    return "{spelling}.{field.name()}";
                }
            }
        }
        let authority = types.authorityOf(named);
        // A static method of a generic type may need type arguments that only the arguments of
        // the call itself determine.
        if (authority != null && authority.isGeneric()) {
            return null;
        }
        let methods = typemembers.staticMethodsOf(named);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (!this.isAccessAllowed(method.visibility(), method.definingType())) {
                continue;
            }
            let call = callExample("{spelling}.{method.name()}", method.signature());
            if (call != null) {
                return call;
            }
        }
        return null;
    }

    // 'spelling' is how this file writes the function's name, which is 'module.name' where a
    // module qualifies it, and 'head' is the name it starts with. 'wanted' is the function type
    // expected where it is written.
    reportFunctionAsValue(string spelling, List<FunctionEntry> entries, Span at, string head,
                          FunctionType? wanted) {
        if (wanted != null) {
            let signatures = new List<Signature>();
            for (let entry in entries) {
                signatures.push(entry.signature());
            }
            let fix = this.lambdaFix("function", spelling, signatures.toArray(), wanted, head);
            this.reporter().report(functionValueRefusal("'{spelling}' is a function", fix, spelling), at);
            return;
        }
        bool bare = true;
        bool throwing = entries.length() > 0;
        for (let entry in entries) {
            if (entry.signature().parameters().length > 0) {
                bare = false;
            }
            if (!entry.signature().declaresThrows()) {
                throwing = false;
            }
        }
        string call = "{spelling}(...)";
        if (bare) {
            call = "{spelling}()";
        }
        if (throwing) {
            call = "try " + call;
        }
        string message = "'{spelling}' is a function, and a function's name is not a value. "
            + "Call it as '{call}', or wrap it in a lambda";
        let example = this.lambdaDeclarationFor(spelling, entries);
        if (example == null) {
            this.reporter().report(message + ".", at);
            return;
        }
        this.reporter().report(message + ", as in '{example}'.", at);
    }

    reportModuleAsValue(string name, string targetPath, Span at) {
        this.reportModuleRefusal("'{name}' names a module, not a value.", name, targetPath, at);
    }

    reportModuleAsCall(string name, string targetPath, Span at) {
        this.reportModuleRefusal("'{name}' names a module, not a function.", name, targetPath,
            at);
    }

    // 'refusal' is the sentence the position writes, and 'name' is how this file writes the
    // module. The example calls a function the module declares, because a type it declares is
    // refused in a value position too.
    reportModuleRefusal(string refusal, string name, string targetPath, Span at) {
        let called = this.moduleFunctionExample(name, targetPath);
        if (called == null) {
            this.reporter().report(refusal, at);
            return;
        }
        this.reporter().report(refusal + " Write one of its functions after the module name, as in "
            + "'{called}'.", at);
    }

    // A call this file can write to a function the module declares, or null where it can write
    // none. The module's declaration order decides which function that is, and the functions the
    // language provides in every module are not among them.
    moduleFunctionExample(string name, string targetPath) -> string? {
        let target = this.contextsByPath().get(targetPath);
        if (target == null) {
            return null;
        }
        string targetPackagePrefix = target.module().packagePrefix();
        let entries = target.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isBuiltin()) {
                continue;
            }
            if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                    this.modulePath(), this.packagePrefix())) {
                continue;
            }
            let signature = entry.signature();
            let call = callExample("{name}.{signature.name()}", signature);
            if (call != null) {
                return call;
            }
        }
        return null;
    }

    // A declaration holding a lambda that calls the named function, or null when the name has no
    // one function type this file can write. Several overloads, a generic, an 'out' parameter, a
    // 'throws' whose types the body decides, and a type this file cannot name each leave none.
    lambdaDeclarationFor(string spelling, List<FunctionEntry> entries) -> string? {
        if (entries.length() != 1) {
            return null;
        }
        let signature = entries.get(0).signature();
        Type[] thrown = signature.throwsTypes();
        if (signature.isGeneric() || (signature.declaresThrows() && thrown.length == 0)) {
            return null;
        }
        let parameterTypes = new List<Type>();
        let passed = new StringBuilder();
        for (let parameter in signature.parameters()) {
            if (parameter.isOut()) {
                return null;
            }
            if (parameterTypes.length() > 0) {
                passed.append(", ");
            }
            parameterTypes.push(parameter.type());
            passed.append(parameter.name());
        }
        Type held = this.store().functionOf(parameterTypes.toArray(), signature.returnType(),
            thrown);
        if (!this.names().canSpell(held)) {
            return null;
        }
        string typeText = this.names().of(held);
        string arguments = passed.toString();
        if (thrown.length > 0) {
            return "({typeText}) callback = ({arguments}) -> try {spelling}({arguments});";
        }
        return "{typeText} callback = ({arguments}) -> {spelling}({arguments});";
    }

    // The enclosing type's name when it declares a static under the given name, for the
    // uniform-access suggestion; null otherwise.
    staticSuggestionOwner(string name) -> string? {
        let owner = this.frame().enclosingOwner();
        if (owner == null) {
            return null;
        }
        if (members.findField(typemembers.staticFieldsOf(owner), name) == null
                && members.findMethodNamed(typemembers.staticMethodsOf(owner), name) == null) {
            return null;
        }
        let authority = types.authorityOf(owner);
        if (authority == null) {
            return null;
        }
        return authority.name();
    }

    // How a refusal names a function value called by 'calleeName', which is empty for one with no name.
    functionValueName(string calleeName) -> string {
        if (calleeName.length == 0) {
            return "this function value";
        }
        return "'{calleeName}'";
    }

    // The refusal of the static 'name' of the enclosing type 'ownerName', written without the type
    // name in front. 'called' is true when the code calls it, and 'wanted' is the function type
    // expected where it is written.
    staticWithoutType(string name, string ownerName, bool called, FunctionType? wanted = null) -> string {
        let owner = this.frame().enclosingOwner();
        string kind = "static method";
        if (owner != null) {
            let field = members.findField(typemembers.staticFieldsOf(owner), name);
            if (field != null && field.isLazy()) {
                kind = "lazy const";
            } else if (field != null) {
                kind = "static const";
            }
        }
        if (kind == "static method") {
            string refusal = "'{name}' is a static method of '{ownerName}', and a static method is always "
                + "called through its type name, even inside '{ownerName}'.";
            if (wanted != null && owner != null) {
                let statics = staticsNamed(owner, name);
                let fix = this.lambdaFix("method", name, this.reachedSignatures(statics, wanted), wanted,
                    ownerName);
                if (fix.fit != LambdaFit.Called) {
                    string spelling = "'{fix.before}{ownerName}.{name}{fix.after}'";
                    return "{refusal} {nameNotValueText(fix, spelling)}";
                }
            }
            return "{refusal} Write '{ownerName}.{name}(...)'.";
        }
        string refusal = "'{name}' is a {kind} of '{ownerName}', and a {kind} is always read through its "
            + "type name, even inside '{ownerName}'. Write '{ownerName}.{name}'.";
        if (called) {
            return "{refusal} A {kind} is not called, so remove the arguments as well.";
        }
        return refusal;
    }

    analyzeThis(ThisExpressionNode node) -> Type {
        let receiver = this.frame().thisType();
        if (receiver == null) {
            if (this.frame().inStaticMethod()) {
                this.reporter().report("'this' is the object a method was called on, and a static method "
                    + "is not called on an object. Take the object as a parameter, or remove 'static'.",
                    node.thisKeyword().span());
            } else {
                this.reporter().report("'this' is the object a method was called on, so it is only "
                    + "available inside a method. Pass the object as a parameter, or move this code into a "
                    + "method.", node.thisKeyword().span());
            }
            return this.store().errorType();
        }
        this.captureReceiver(receiver, node.thisKeyword().span());
        return receiver;
    }

    analyzeSuper(SuperExpressionNode node) -> Type {
        let receiver = this.frame().thisType();
        if (receiver == null) {
            if (this.frame().inStaticMethod()) {
                this.reporter().report("'super' is the part of the object a method was called on that its "
                    + "base class declares, and a static method is not called on an object. Remove 'static' "
                    + "to make it an instance method.", node.superKeyword().span());
            } else {
                this.reporter().report("'super' is the part of the object a method was called on that its "
                    + "base class declares, so it is only available inside a method. Move this code into a "
                    + "method of the subclass.", node.superKeyword().span());
            }
            return this.store().errorType();
        }
        let base = hierarchy.baseOf(receiver);
        if (base == null) {
            let authority = types.authorityOf(receiver);
            string shown = this.names().of(receiver);
            if (authority != null) {
                shown = authority.name();
            }
            this.reporter().report("'super' cannot be used in '{shown}', because '{shown}' has no base "
                + "class. Remove 'super', or give '{shown}' a base class with 'extends'.",
                node.superKeyword().span());
            return this.store().errorType();
        }
        this.captureReceiver(receiver, node.superKeyword().span());
        return base;
    }

    analyzeBinary(BinaryExpressionNode node) -> Type {
        SyntaxKind operator = node.operator().kind();
        // '&&' and '||' evaluate the right side only when the left did not already decide
        // the result, so a check on the left narrows the right: 'x != null && x.ready()'.
        if (operator == SyntaxKind.AmpersandAmpersand || operator == SyntaxKind.PipePipe) {
            Type shortLeft = this.analyzeExpression(node.left());
            Type shortRight = narrowing.analyzeGuardedBranch(this, node.left(), node.right(),
                operator == SyntaxKind.AmpersandAmpersand, null);
            if (shortLeft is ErrorType || shortRight is ErrorType) {
                return this.store().errorType();
            }
            if (!convert.isBoolType(shortLeft) || !convert.isBoolType(shortRight)) {
                bool accepted = convert.isBoolType(convert.coreOf(shortLeft))
                    && convert.isBoolType(convert.coreOf(shortRight));
                let guidance = nullguidance.binaryGuidance(this, node.left(), node.right(), shortLeft,
                    shortRight, accepted, null, node.operator().text());
                string sides = sidesClause(node.left(), node.right(), shortLeft, shortRight,
                    !convert.isBoolType(shortLeft), !convert.isBoolType(shortRight), this.names());
                this.reporter().report(nullguidance.withGuidance(this, "'{node.operator().text()}' needs a "
                    + "'bool' on both sides, {sides}.", guidance), node.span());
            }
            return this.store().primitive(PrimitiveKind.Bool);
        }
        Type? target = null;
        LiteralOrigin? origin = null;
        if (this.targets().binaryNode() == node.green()) {
            if (isArithmeticOperator(operator) || operator == SyntaxKind.Ampersand
                    || operator == SyntaxKind.Pipe || operator == SyntaxKind.Caret) {
                target = this.targets().binaryTarget();
                origin = this.targets().binaryOrigin();
            }
            this.targets().clearBinaryStash();
        }
        this.targets().stash(node.left(), target, origin);
        Type left = this.analyzeExpression(node.left());
        this.targets().clearStash();
        this.targets().stash(node.right(), target, origin);
        Type right = this.analyzeExpression(node.right());
        this.targets().clearStash();
        if (left is ErrorType || right is ErrorType) {
            return this.store().errorType();
        }
        this.targets().enterOperands(node, target, origin);
        Type result = this.analyzeBinaryOperands(node.span(), operator, node.operator().text(),
            node.left(), node.right(), left, right, null);
        this.targets().leaveOperands();
        return result;
    }

    // The result of 'left OP right' under the operator's own rules. A compound assignment passes its
    // target as 'written', which is checked without its '?'.
    analyzeBinaryOperands(Span span, SyntaxKind operator, string operatorText,
                                  Expression leftNode, Expression rightNode, Type left,
                                  Type right, WriteTarget? written) -> Type {
        switch (operator) {
            Plus, Minus, Star, Slash, Percent -> {
                return this.analyzeArithmetic(span, operator, operatorText, leftNode, rightNode,
                    left, right, written);
            },
            EqualsEquals, NotEquals -> {
                return this.analyzeEquality(span, operatorText, leftNode, rightNode, left, right);
            },
            Less, Greater, LessEquals, GreaterEquals -> {
                return this.analyzeComparison(span, operator, operatorText, leftNode, rightNode, left, right);
            },
            Ampersand, Pipe, Caret -> {
                return this.analyzeBitwise(span, operator, operatorText, leftNode, rightNode, left,
                    right, written);
            },
            LessLess, GreaterGreater, GreaterGreaterGreater -> {
                return this.analyzeShift(span, operator, operatorText, leftNode, rightNode, left,
                    right, written);
            },
            default -> {
                this.reporter().report("Internal: unsupported binary operator "
                    + "'{operatorText}'.", span);
                return this.store().errorType();
            },
        }
    }

    // Both sides after an untyped literal on either side adapts to the other side's type.
    adaptOperands(Expression leftNode, Expression rightNode, Type left, Type right,
                  string operatorText) -> Type[] {
        return [this.adaptedOperand(leftNode, left, right, rightNode, operatorText, false),
            this.adaptedOperand(rightNode, right, left, leftNode, operatorText, true)];
    }

    // The operand's type once an untyped literal in it adapts toward 'toward', the type of 'other'.
    // Any other operand keeps its type.
    adaptedOperand(Expression node, Type type, Type toward, Expression other, string operatorText,
                   bool onRight) -> Type {
        let fix = this.operandLiteralFix(node, other, toward, operatorText, onRight);
        this.noteSuffixedOperand(node, other, toward, operatorText, onRight);
        return this.adaptIntegerLiteral(node, toward, null, fix)
            ?? this.adaptFloatLiteral(node, toward, null, fix) ?? type;
    }

    // Holds the refusal 'message' for the join or call being analyzed, with 'plain' ending after the
    // why, or reports it outside both. 'refusal' and 'clause' are its first sentence and its why.
    holdOrReport(Span span, string message, string plain, string refusal, string clause, Widening widening) {
        let held = this.targets().deferredFixes();
        if (held == null) {
            this.reporter().report(message, span);
            return;
        }
        let fix = new DeferredLiteralFix(span, message, plain, null, "");
        fix.setAwaitingParameter(this.targets().awaitingParameter());
        fix.setRefusal(refusal);
        fix.setClause(clause);
        fix.setWidening(widening);
        held.push(fix);
    }

    // Holds the fix of the pending 'float' literal report for the join being analyzed, with the
    // value 'other' of type 'otherType' the literal stands beside.
    holdSuffixed(PendingLiteralRange pending, Expression value, Expression other, Type otherType) {
        let held = this.targets().deferredFixes();
        if (held != null) {
            let fix = new DeferredLiteralFix(pending.span(), "", "", pending, floatSuffixOf(value));
            fix.setBeside(wording.oneLineSpelling(wording.unwrapParentheses(other)));
            fix.setBesideType(this.names().of(otherType));
            fix.setAwaitingParameter(this.targets().awaitingParameter());
            held.push(fix);
        }
    }

    // Settles the refusals held for one branch or arm beside 'neighbour', which 'where' names. Each
    // then passes to an enclosing join, or is reported when there is none.
    settleDeferred(List<DeferredLiteralFix> fixes, Expression? neighbour, Type neighbourType, string where) {
        for (let held in fixes) {
            let widening = held.widening() ?? floatWidening();
            if (!held.settled() && neighbour != null && neighbourType is OptionalType
                    && sameCore(neighbourType, widening)) {
                held.setSettled(true);
                held.setMessage(held.plain());
                let suffixed = held.suffixed();
                if (suffixed != null) {
                    string named = wording.oneLineSpelling(wording.unwrapParentheses(neighbour));
                    string type = this.names().of(neighbourType);
                    suffixed.setFix("The '{held.suffix()}' makes the literal a 'float'. Without it the "
                        + "literal takes its type from '{held.beside()}', a '{held.besideType()}', and "
                        + "{where} '{named}' is a '{type}'.");
                }
            }
            let outer = this.targets().deferredFixes();
            if (outer != null) {
                outer.push(held);
            } else if (held.suffixed() == null) {
                this.reporter().report(held.message(), held.span());
            }
        }
    }

    // The pending report of the 'float' literal 'value' when it is too large for 'float', or null.
    pendingSuffixed(Expression value) -> PendingLiteralRange? {
        GreenNode green = wording.unwrapParentheses(value).green();
        for (let pending in this.targets().pendingLiteralRanges()) {
            if (pending.green() == green && pending.defaultType().kind() == PrimitiveKind.Float) {
                return pending;
            }
        }
        return null;
    }

    // Gives a 'float' literal too large for 'float' the fix for the target it is checked against,
    // set at 'origin'. Under a 'double' target, removing the suffix is the whole fix.
    noteSuffixedTarget(Expression value, Type target, LiteralOrigin? origin) {
        let pending = this.pendingSuffixed(value);
        if (pending == null || origin == null || isDoubleCore(target)) {
            return;
        }
        string spelled = wording.oneLineSpelling(wording.unwrapParentheses(value));
        string removal = "remove the '{floatSuffixOf(value)}' from '{spelled}'";
        string change = this.originChange(origin, floatWidening());
        if (change.length > 0) {
            pending.setFix("{change} and {removal}.");
            return;
        }
        pending.setFix(this.suffixedWhere(value, origin));
    }

    // Gives a 'float' literal too large for 'float' beside the 'float' value 'other' the fix that
    // removes the suffix and converts 'other', under the target of the operator it is an operand of.
    noteSuffixedOperand(Expression value, Expression other, Type toward, string operatorText, bool onRight) {
        let pending = this.pendingSuffixed(value);
        if (pending == null || !isFloatCore(toward)) {
            return;
        }
        string plainLiteral = unsuffixedSpelling(value);
        string written = "{wording.asDouble(other)} {operatorText} {plainLiteral}";
        string plain = "{wording.oneLineSpelling(other)} {operatorText} {plainLiteral}";
        string both = "{unsuffixedSpelling(other)} {operatorText} {plainLiteral}";
        if (!onRight) {
            written = "{plainLiteral} {operatorText} {wording.asDouble(other)}";
            plain = "{plainLiteral} {operatorText} {wording.oneLineSpelling(other)}";
            both = "{plainLiteral} {operatorText} {unsuffixedSpelling(other)}";
        }
        pending.setFix(this.suffixedBesideFix(value, other, toward, written, plain, both,
            this.targets().operandTarget(), this.targets().operandOrigin(), this.targets().operandJoin()));
        this.holdSuffixed(pending, value, other, toward);
    }

    // Gives a 'float' literal branch of a '?:', too large for 'float', the fix that removes its suffix
    // and converts the other branch, whose type is 'toward', under the target set at 'origin'.
    noteSuffixedBranch(TernaryExpressionNode node, bool literalThen, Type toward, Type? target,
                       LiteralOrigin? origin) {
        Expression literal = node.elseValue();
        Expression other = node.thenValue();
        if (literalThen) {
            literal = node.thenValue();
            other = node.elseValue();
        }
        let pending = this.pendingSuffixed(literal);
        if (pending == null || !isFloatCore(toward) || this.pendingSuffixed(other) != null) {
            return;
        }
        string condition = wording.oneLineSpelling(node.condition());
        string plainLiteral = unsuffixedSpelling(literal);
        string written = "{condition} ? {wording.asDouble(other)} : {plainLiteral}";
        string plain = "{condition} ? {wording.oneLineSpelling(other)} : {plainLiteral}";
        string both = "{condition} ? {unsuffixedSpelling(other)} : {plainLiteral}";
        if (literalThen) {
            written = "{condition} ? {plainLiteral} : {wording.asDouble(other)}";
            plain = "{condition} ? {plainLiteral} : {wording.oneLineSpelling(other)}";
            both = "{condition} ? {plainLiteral} : {unsuffixedSpelling(other)}";
        }
        pending.setFix(this.suffixedBesideFix(literal, other, toward, written, plain, both, target, origin,
            node));
        this.holdSuffixed(pending, literal, other, toward);
    }

    // Gives each 'float' literal arm too large for 'float' the fix that removes its suffix and converts
    // an arm with a 'float' value of its own, under the target set at 'origin'.
    noteSuffixedArms(List<Expression> values, List<SwitchArm> arms, Type? target, LiteralOrigin? origin) {
        for (long i = 0; i < values.length(); i++) {
            let pending = this.pendingSuffixed(values.get(i));
            if (pending == null) {
                continue;
            }
            long chosen = -1;
            long typed = 0;
            for (long j = 0; j < values.length(); j++) {
                let other = values.get(j);
                if (j == i || isUntypedNumberLiteral(other) || this.pendingSuffixed(other) != null
                        || !isFloatCore(this.recordedType(other))) {
                    continue;
                }
                typed++;
                bool plainer = chosen >= 0 && floatSuffixOf(values.get(chosen)).length > 0
                    && floatSuffixOf(other).length == 0;
                if (chosen < 0 || plainer) {
                    chosen = j;
                }
            }
            if (chosen < 0) {
                continue;
            }
            let other = values.get(chosen);
            string head = wording.armHead(arms.get(chosen));
            string bothRemoved = "";
            if (typed == 1) {
                bothRemoved = "{head} -> {unsuffixedSpelling(other)}";
            }
            pending.setFix(this.suffixedBesideFix(values.get(i), other, this.recordedType(other),
                "{head} -> {wording.asDouble(other)}", "", bothRemoved, target, origin, null));
            this.holdSuffixed(pending, values.get(i), other, this.recordedType(other));
        }
    }

    // The fix for the 'float' literal 'value', too large for 'float', beside 'other' of type
    // 'otherType' in 'join'. An empty 'bothRemoved' means removing the suffix of 'other' is no fix.
    suffixedBesideFix(Expression value, Expression other, Type otherType, string converted,
                      string suffixRemoved, string bothRemoved, Type? target, LiteralOrigin? origin,
                      Expression? join) -> string {
        string spelled = wording.oneLineSpelling(wording.unwrapParentheses(value));
        string suffix = floatSuffixOf(value);
        string named = wording.oneLineSpelling(wording.unwrapParentheses(other));
        string removal = "remove the '{suffix}' from '{spelled}'";
        if (otherType is OptionalType) {
            return "The '{suffix}' makes the literal a 'float'. Without it the literal takes its type from "
                + "'{named}', a '{this.names().of(otherType)}'.";
        }
        string otherSuffix = floatSuffixOf(other);
        if (otherSuffix.length > 0 && bothRemoved.length > 0) {
            string also = " and from '{named}'";
            if (otherSuffix != suffix) {
                also = " and the '{otherSuffix}' from '{named}'";
            }
            if (target == null || isDoubleCore(target)) {
                return "Remove the '{suffix}' from '{spelled}'{also} ('{bothRemoved}').";
            }
            if (origin == null) {
                return "";
            }
            string change = this.originChange(origin, floatWidening());
            if (change.length > 0) {
                return "{change} and {removal}{also} ('{this.originExample(origin, join, bothRemoved,
                    floatWidening())}').";
            }
            return this.suffixedWhere(value, origin);
        }
        if (target == null || isDoubleCore(target)) {
            return "Remove the '{suffix}' from '{spelled}' and convert '{named}' ('{converted}').";
        }
        if (origin == null) {
            return "";
        }
        string change = this.originChange(origin, floatWidening());
        if (change.length > 0 && readsPlace(other, originPlace(origin))) {
            string statement = this.originStatement(origin, join, suffixRemoved, floatWidening());
            if (statement.length > 0) {
                return "{change} and {removal} ('{statement}').";
            }
            return "{change} and {removal}.";
        }
        if (change.length > 0) {
            string example = this.originExample(origin, join, converted, floatWidening());
            return "{change}, {removal} and convert '{named}' ('{example}').";
        }
        return this.suffixedWhere(value, origin);
    }

    // The sentence for a 'float' literal under the parameter or the '??' value at 'origin', whose
    // suffix gives it the type the target has too. Empty for any other origin.
    suffixedWhere(Expression value, LiteralOrigin origin) -> string {
        string noun = originNoun(origin);
        if (noun.length == 0) {
            return "";
        }
        string type = this.originType(origin);
        return "The '{floatSuffixOf(value)}' makes the literal a 'float', and {noun} is "
            + "{typenames.typeArticle(type)} '{type}' too.";
    }

    // The text after a literal operand that takes its type from the other side of 'operatorText'.
    // The expression is checked against the target set at the operand origin, when it has one.
    operandFix(Expression literal, Expression other, Type toward, string operatorText,
               bool onRight, Widening widening) -> JoinText {
        string into = this.conversionType(this.targets().operandTarget(), widening);
        string written = "{wording.converted(other, into)} {operatorText} {wording.oneLineSpelling(literal)}";
        if (!onRight) {
            written = "{wording.oneLineSpelling(literal)} {operatorText} {wording.converted(other, into)}";
        }
        return this.joinFix(other, toward, written, "both sides", this.targets().operandTarget(),
            this.targets().operandOrigin(), this.targets().operandJoin(), widening);
    }

    // operandFix for the operand 'node' when it is a literal too large for 'toward', or null.
    operandLiteralFix(Expression node, Expression other, Type toward, string operatorText,
                      bool onRight) -> JoinText? {
        let widening = this.joinWidening(node, toward);
        if (widening == null) {
            return null;
        }
        return this.operandFix(node, other, toward, operatorText, onRight, widening);
    }

    // The type a value beside a literal converts to so that the literal takes it: the type of
    // 'target' when it takes the literal and every value beside it, and otherwise the wider type.
    conversionType(Type? target, Widening widening) -> string {
        if (target != null && takesLiteral(target, widening)) {
            return this.names().of(convert.coreOf(target));
        }
        return widening.wider();
    }

    // The text after a literal that takes its type 'toward' from 'other' in 'join', whose code with
    // 'other' converted is 'written'. 'target' and 'origin' say what the join is checked against,
    // and 'both' names the values a removed suffix makes 'double'.
    joinFix(Expression other, Type toward, string written, string both, Type? target,
            LiteralOrigin? origin, Expression? join, Widening widening) -> JoinText {
        let text = this.joinFixText(other, toward, written, both, target, origin, join, widening);
        text.setCovered(widening.literals());
        return text;
    }

    // joinFix before it records the literals its fix covers.
    joinFixText(Expression other, Type toward, string written, string both, Type? target,
                LiteralOrigin? origin, Expression? join, Widening widening) -> JoinText {
        string named = wording.oneLineSpelling(other);
        if (toward is OptionalType) {
            string why = wording.takesTypeFrom("'{named}'", this.names().of(toward));
            return new JoinText(why, why);
        }
        string type = this.names().of(convert.coreOf(toward));
        string text = wording.takesTypeFrom("'{named}'", type);
        if (widening.wider().length == 0) {
            return new JoinText(text, text);
        }
        string advice = this.joinAdvice(other, type, text, written, both, target, origin, join, widening);
        let joined = new JoinText(advice, text);
        joined.setClause(wording.takesTypeClause("'{named}'", type));
        return joined;
    }

    // joinFix once the type 'toward' is known to have no '?': 'text' says where the type comes from.
    joinAdvice(Expression other, string type, string text, string written, string both, Type? target,
               LiteralOrigin? origin, Expression? join, Widening widening) -> string {
        string named = wording.oneLineSpelling(other);
        string suffix = "";
        if (both.length > 0) {
            suffix = floatSuffixOf(other);
        }
        if (target == null || takesLiteral(target, widening)) {
            if (suffix.length > 0) {
                return "{text} Remove the '{suffix}' from '{named}' so that {both} are 'double'.";
            }
            return "{text} Convert '{named}' first ('{written}').";
        }
        if (origin == null || (widening.joined() && (widening.negative() || widening.lowNegative())
                && isUnsignedCore(origin.declared()))) {
            return text;
        }
        let declaring = this.declarationWidening(origin, widening);
        string change = this.originChange(origin, declaring);
        if (change.length > 0 && suffix.length > 0) {
            return "{text} {change} and remove the '{suffix}' from '{named}'.";
        }
        if (change.length > 0 && readsPlace(other, originPlace(origin))) {
            string statement = "";
            if (join != null) {
                statement = this.originStatement(origin, join, wording.oneLineSpelling(join), declaring);
            }
            if (statement.length > 0) {
                return "{text} {change} ('{statement}').";
            }
            return "{text} {change}.";
        }
        if (change.length > 0) {
            string example = this.originExample(origin, join, written, declaring);
            return "{text} {change} and convert '{named}' ('{example}').";
        }
        string noun = originNoun(origin);
        if (noun.length > 0) {
            string declared = this.originType(origin);
            return "{wording.takesTypeClause("'{named}'", type)}, and {noun} is "
                + "{typenames.typeArticle(declared)} '{declared}' too.";
        }
        return text;
    }

    // The text after a literal that does not fit the type set at 'origin'.
    literalFix(LiteralOrigin? origin, Widening widening) -> string {
        if (origin == null || widening.wider().length == 0) {
            return "";
        }
        string change = this.originChange(origin, widening);
        if (change.length > 0 && origin.kind() == OriginKind.Returned) {
            return "{change}.";
        }
        if (change.length > 0) {
            return "{change} instead.";
        }
        return this.originWhere(origin);
    }

    // The change that makes the declaration at 'origin' take the wider type, or an empty string where
    // no code can change the type in one edit.
    originChange(LiteralOrigin origin, Widening widening) -> string {
        string wider = this.widerSpelling(origin.declared(), widening);
        if (wider.length == 0) {
            return "";
        }
        switch (origin.kind()) {
            Declared -> {
                if (origin.owner().length > 0) {
                    return "Declare field '{origin.name()}' of '{origin.owner()}' as '{wider}'";
                }
                return "Declare '{origin.name()}' as '{wider}'";
            },
            Returned -> {
                return "Change the return type of '{origin.name()}' to '{wider}'";
            },
            default -> {
                return "";
            },
        }
    }

    // The sentence that names the parameter or the '??' value that sets the type at 'origin'. No
    // code changes that type in one edit.
    originWhere(LiteralOrigin origin) -> string {
        string noun = originNoun(origin);
        if (noun.length == 0) {
            return "";
        }
        return wording.takesTypeFrom(noun, this.originType(origin));
    }

    // The type set at 'origin' without its '?'.
    originType(LiteralOrigin origin) -> string {
        return this.names().of(convert.coreOf(origin.declared()));
    }

    // The fixed code an example shows: the statement at 'origin' around 'written' when 'join' is its
    // whole value, and 'written' alone otherwise.
    originExample(LiteralOrigin origin, Expression? join, string written, Widening widening) -> string {
        string statement = this.originStatement(origin, join, written, widening);
        if (statement.length == 0) {
            return written;
        }
        return statement;
    }

    // The statement at 'origin' with 'written' as its value when 'join' is its whole value, or an
    // empty string.
    originStatement(LiteralOrigin origin, Expression? join, string written, Widening widening) -> string {
        let whole = origin.whole();
        if (join == null || whole == null || wording.unwrapParentheses(whole).green() != join.green()) {
            return "";
        }
        string wider = this.widerSpelling(origin.declared(), widening);
        switch (origin.statement()) {
            is VariableDeclarationNode declaration -> {
                string modifier = "";
                let token = declaration.modifier();
                if (token != null) {
                    modifier = "{token.text()} ";
                }
                return "{modifier}{wider} {declaration.name().text()} = {written};";
            },
            is FieldDeclarationNode field -> {
                string modifiers = "";
                for (long i = 0; i < field.modifiersCount(); i++) {
                    modifiers = "{modifiers}{field.modifiers(i).text()} ";
                }
                return "{modifiers}{wider} {field.name().text()} = {written};";
            },
            is ReturnStatementNode ignored -> {
                return "return {written};";
            },
            is AssignmentExpressionNode assignment -> {
                return "{wording.oneLineSpelling(assignment.target())} {assignment.operator().text()} "
                    + "{written};";
            },
            default -> {
                return "";
            },
        }
    }

    // The type spelled with the narrow type of 'widening' changed to its wider one, or an empty string
    // when the narrow type is not under its '?' and '[]' levels.
    widerSpelling(Type type, Widening widening) -> string {
        if (type is OptionalType) {
            string inner = this.widerSpelling(type.inner(), widening);
            if (inner.length == 0) {
                return "";
            }
            return "{inner}?";
        }
        if (type is ArrayType) {
            string element = this.widerSpelling(type.element(), widening);
            if (element.length == 0) {
                return "";
            }
            return "{element}[]";
        }
        if (type is PrimitiveType && type.kind() == widening.narrow()) {
            return widening.wider();
        }
        return "";
    }

    // The widening of an integer literal with 'magnitude' too large for 'target'.
    integerWidening(bool negative, ulong magnitude, PrimitiveType target) -> Widening {
        return new Widening(target.kind(), this.names().of(target),
            literaltyping.widerIntegerHolding(negative, magnitude, target.kind()), negative, magnitude);
    }

    // The widening of the number literal 'value' when it is too large for the type 'target' has
    // without its '?', or null.
    overflowWidening(Expression value, Type target) -> Widening? {
        Type core = convert.coreOf(target);
        if (floatLiteralOverflows(value, target) && core is PrimitiveType
                && core.kind() == PrimitiveKind.Float) {
            return floatWidening();
        }
        if (floatLiteralOverflows(value, target)) {
            return new Widening(PrimitiveKind.Double, "double", "", false, 0);
        }
        let literal = literaltyping.intLiteralOf(wording.unwrapParentheses(value));
        if (literal == null || !(core is PrimitiveType) || !convert.isIntegerType(core)) {
            return null;
        }
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        bool negative = literaltyping.isNegativeLiteral(wording.unwrapParentheses(value));
        if (magnitude == null || literalvalues.magnitudeFits(negative, magnitude, core.kind())) {
            return null;
        }
        return this.integerWidening(negative, magnitude, core);
    }

    // overflowWidening for a literal beside a value of type 'target', whose wider type has every
    // value of 'target' as well as every literal of the join 'root', or of the literal alone.
    joinWidening(Expression value, Type target, Expression? root = null) -> Widening? {
        let widening = this.overflowWidening(value, target);
        if (widening == null || !convert.isIntegerType(convert.coreOf(target))) {
            return widening;
        }
        let joined = new Widening(widening.narrow(), widening.narrowName(), "", widening.negative(),
            widening.magnitude());
        joined.setJoined(true);
        let literals = new List<Expression>();
        collectJoinLiterals(root ?? value, literals, true);
        spanJoinLiterals(joined, literals);
        joined.setWider(joinedIntegerHolding(joined));
        joined.setLiterals(literals);
        return joined;
    }

    // The widening that changes the declaration at 'origin' to the wider type of 'widening'. A joined
    // literal changes the declared type, which need not be the type beside it.
    declarationWidening(LiteralOrigin origin, Widening widening) -> Widening {
        Type core = convert.coreOf(origin.declared());
        while (core is ArrayType) {
            core = convert.coreOf(core.element());
        }
        if (!widening.joined() || !(core is PrimitiveType) || !convert.isIntegerType(core)) {
            return widening;
        }
        return new Widening(core.kind(), this.names().of(core), widening.wider(), widening.negative(),
            widening.magnitude());
    }

    // The origin of the value a lambda returns, when the lambda's type is declared at 'holder'.
    returnOriginThrough(LiteralOrigin? holder, Type returned) -> LiteralOrigin? {
        if (holder == null || holder.kind() != OriginKind.Declared
                || !(convert.coreOf(holder.declared()) is FunctionType)) {
            return null;
        }
        return new LiteralOrigin(OriginKind.Returned, holder.name(), "", returned);
    }

    // The origin of 'value', set by 'kind' at 'name' with type 'declared' in 'statement', or null
    // when no number literal in 'value' can need it.
    valueOrigin(OriginKind kind, string name, Type declared, Expression value,
                SyntaxNode? statement = null) -> LiteralOrigin? {
        if (!mayAdaptLiteral(value)) {
            return null;
        }
        let origin = new LiteralOrigin(kind, name, "", declared);
        origin.setStatement(statement);
        origin.setWhole(value);
        return origin;
    }

    // The origin of the value 'node' assigns: the declaration of the variable, field or array it
    // writes, or null when no declaration names what it writes.
    assignmentOrigin(AssignmentExpressionNode node, Expression target, Type declared) -> LiteralOrigin? {
        Expression core = wording.unwrapParentheses(target);
        if (core is IdentifierExpressionNode) {
            return this.valueOrigin(OriginKind.Declared, core.name().text(), declared, node.value(), node);
        }
        let access = nullguidance.accessStep(core);
        if (access == null) {
            return null;
        }
        let member = access.member();
        if (member != null) {
            return this.valueOrigin(OriginKind.Declared, member, declared, node.value(), node);
        }
        Expression receiver = wording.unwrapParentheses(access.receiver());
        string? array = nullguidance.accessStep(receiver)?.member();
        if (receiver is IdentifierExpressionNode) {
            array = receiver.name().text();
        }
        if (array == null) {
            return null;
        }
        Type arrayType = narrowing.declaredSlotType(this, receiver) ?? this.recordedType(receiver);
        return this.valueOrigin(OriginKind.Declared, array, arrayType, node.value(), node);
    }

    // The origin of an argument passed as parameter 'index' of 'signature', or null when no
    // number literal in 'value' can need it. 'constructed' names the type of a constructor.
    argumentOrigin(Expression value, Signature signature, long index, Type parameterType,
                   string constructed = "") -> LiteralOrigin? {
        if (!mayAdaptLiteral(value)) {
            return null;
        }
        Parameter[] parameters = signature.parameters();
        if (index < 0 || index >= parameters.length) {
            return new LiteralOrigin(OriginKind.Parameter, "", "", parameterType);
        }
        let origin = new LiteralOrigin(OriginKind.Parameter, parameters[index].name(), signature.name(),
            parameterType);
        origin.setConstructed(constructed);
        return origin;
    }

    // The text after a literal branch of a '?:' that takes its type from the other branch, whose
    // type is 'toward', or null unless the branch is a literal too large for it. 'target' is
    // the type the '?:' is checked against, set at 'origin'.
    ternaryFix(TernaryExpressionNode node, bool literalThen, Type toward, Type? target,
               LiteralOrigin? origin) -> JoinText? {
        Expression literal = node.elseValue();
        Expression other = node.thenValue();
        if (literalThen) {
            literal = node.thenValue();
            other = node.elseValue();
        }
        let widening = this.joinWidening(literal, toward, this.targets().joinRoot());
        if (widening == null || isUntypedNumberLiteral(other)) {
            return null;
        }
        string condition = wording.oneLineSpelling(node.condition());
        string into = this.conversionType(target, widening);
        string written = "{condition} ? {wording.converted(other, into)} : "
            + "{wording.oneLineSpelling(literal)}";
        if (literalThen) {
            written = "{condition} ? {wording.oneLineSpelling(literal)} : {wording.converted(other, into)}";
        }
        bool floatJoin = widening.narrow() == PrimitiveKind.Float && floatSuffixOf(literal).length == 0;
        if (this.arrayJoinRoot() != null && (widening.joined() || floatJoin)) {
            return this.arrayJoinFix(other, toward, target, origin, widening);
        }
        return this.joinFix(other, toward, written, "both branches", target, origin, node, widening);
    }

    // The text after a literal element of the array literal 'node' that takes its type 'toward' from
    // the first element.
    elementFix(ArrayLiteralExpressionNode node, Type toward, Widening widening) -> JoinText {
        let array = this.arrayJoinRoot();
        if (array != null && array.green() != node.green() && widening.joined()) {
            return this.arrayJoinFix(node.elements(0), toward, null, null, widening);
        }
        string written = "[{wording.converted(node.elements(0), widening.wider())}";
        for (long i = 1; i < node.elementsCount(); i++) {
            written = "{written}, {wording.oneLineSpelling(node.elements(i))}";
        }
        string both = "";
        if (node.elementsCount() == 2) {
            both = "both elements";
        }
        return this.joinFix(node.elements(0), toward, "{written}]", both, null, null, node, widening);
    }

    // The fix of a literal of an array literal that takes its type 'toward' from 'beside', whose
    // refusal waits until every value of the array is analyzed.
    arrayJoinFix(Expression beside, Type toward, Type? target, LiteralOrigin? origin, Widening widening)
            -> JoinText {
        let text = new JoinText("", "");
        text.setBeside(beside);
        text.setToward(toward);
        text.setFixTarget(target);
        text.setFixOrigin(origin);
        text.setCovered(widening.literals());
        return text;
    }

    // The array literal the current join is, when it is one.
    arrayJoinRoot() -> Expression? {
        let root = this.targets().joinRoot();
        if (root is ArrayLiteralExpressionNode) {
            return root;
        }
        return null;
    }

    // The array literal 'array' spelled with each of its values of the type 'toward' converted to the
    // type spelled 'into'.
    arrayConverted(Expression array, Type toward, string into) -> string {
        let values = new List<Expression>();
        collectJoinValues(array, values, true);
        let changed = new List<GreenNode>();
        for (let value in values) {
            if (convert.coreOf(this.recordedType(value)) == convert.coreOf(toward)) {
                changed.push(value.green());
            }
        }
        return spelledConverting(array, changed, into);
    }

    // The text after a literal arm that takes its type from the first arm before 'limit' that is
    // not an untyped number literal and has the core type of 'toward'. 'target' is the type the
    // switch is checked against, set at 'origin'.
    switchArmFix(List<Expression> values, List<SwitchArm> arms, long limit, Type toward,
                 Type? target, LiteralOrigin? origin, Widening widening) -> JoinText? {
        Type core = convert.coreOf(toward);
        for (long i = 0; i < limit; i++) {
            let value = values.get(i);
            Type analyzed = this.recordedType(value);
            if (!isUntypedNumberLiteral(value) && convert.coreOf(analyzed) == core) {
                string into = this.conversionType(target, widening);
                string written = "{wording.armHead(arms.get(i))} -> {wording.converted(value, into)}";
                if (this.arrayJoinRoot() != null && widening.joined()) {
                    return this.arrayJoinFix(value, analyzed, target, origin, widening);
                }
                return this.joinFix(value, analyzed, written, onlyTypedArm(values, i), target, origin, null,
                    widening);
            }
        }
        return null;
    }

    analyzeArithmetic(Span span, SyntaxKind operator, string operatorText, Expression leftNode,
                              Expression rightNode, Type left, Type right, WriteTarget? written) -> Type {
        Type[] adapted = this.adaptOperands(leftNode, rightNode, checkedSide(left, written), right,
            operatorText);
        if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
            return this.store().errorType();
        }
        Type checkedLeft = adapted[0];
        Type shownLeft = shownSide(checkedLeft, left, written);
        Type checkedRight = adapted[1];
        bool joins = operator == SyntaxKind.Plus
            && (convert.coreOf(checkedLeft) is StringType || convert.coreOf(checkedRight) is StringType);
        bool accepted = acceptsCores(operator, checkedLeft, checkedRight);
        let guidance = nullguidance.binaryGuidance(this, leftNode, rightNode, shownLeft, checkedRight,
            accepted, written, operatorText);
        if (joins) {
            if (isStringable(checkedLeft) && isStringable(checkedRight)) {
                return this.store().stringType();
            }
            string refusal = sidesRefusal(operator, operatorText, leftNode, rightNode, shownLeft,
                checkedRight, this.names());
            if (!accepted) {
                refusal = "Cannot add a value of type '{this.names().of(checkedRight)}' to a string.";
                if (isStringable(convert.coreOf(checkedRight))) {
                    refusal = "Cannot add a string to a value of type '{this.names().of(shownLeft)}'.";
                }
                refusal = refusal + " Only a string, a number or a 'bool' can be added to one.";
            }
            this.reporter().report(nullguidance.withGuidance(this, refusal, guidance), span);
            return this.store().errorType();
        }
        if (!convert.isNumericType(checkedLeft) || !convert.isNumericType(checkedRight)) {
            this.reporter().report(nullguidance.withGuidance(this, sidesRefusal(operator, operatorText,
                leftNode, rightNode, shownLeft, checkedRight, this.names()), guidance), span);
            return this.store().errorType();
        }
        let common = convert.numericCommonType(checkedLeft, checkedRight);
        if (common == null) {
            this.reporter().report("'{operatorText}' needs the same number type on both sides, "
                + "{sidesClause(leftNode, rightNode, shownLeft, checkedRight, true, true, this.names())}."
                + bothSidesConversion(operatorText, leftNode, rightNode, checkedLeft, checkedRight), span);
            return this.store().errorType();
        }
        return common;
    }

    // A comparison against 'null' is a presence test on the declared storage type, so it stays
    // legal on a binding declared optional even where narrowing already proved the value non-null.
    analyzeEquality(Span span, string operatorText, Expression leftNode, Expression rightNode, Type left,
                    Type right) -> Type {
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right, operatorText);
        Type leftSide = adapted[0];
        Type rightSide = adapted[1];
        if (rightSide is NullType) {
            leftSide = narrowing.presenceOperandType(this, leftNode, leftSide);
        } else if (leftSide is NullType) {
            rightSide = narrowing.presenceOperandType(this, rightNode, rightSide);
        }
        if (this.reportFunctionComparison(span, leftSide, rightSide)) {
            return this.store().primitive(PrimitiveKind.Bool);
        }
        if (!convert.isAssignableStrict(leftSide, rightSide)
                && !convert.isAssignableStrict(rightSide, leftSide)) {
            this.reporter().report(this.comparisonRefusal(operatorText, leftNode, rightNode, leftSide,
                rightSide), span);
        } else {
            this.checkStructEquatable(leftSide, rightSide, span);
        }
        return this.store().primitive(PrimitiveKind.Bool);
    }

    // The refusal of 'operatorText' between two sides whose types are never equal. Against 'null',
    // the side that can never be null is named with the result the comparison always has.
    comparisonRefusal(string operatorText, Expression leftNode, Expression rightNode, Type left, Type right)
            -> string {
        if (!(left is NullType) && !(right is NullType)) {
            return "Cannot compare '{this.names().of(left)}' with '{this.names().of(right)}', because a "
                + "value of one of these types is never equal to a value of the other.";
        }
        Type other = left;
        Expression valueNode = leftNode;
        if (left is NullType) {
            other = right;
            valueNode = rightNode;
        }
        string result = "false";
        if (operatorText == "!=") {
            result = "true";
        }
        string nullable = this.names().nullableOf(other);
        let spelled = wording.shortSpelling(valueNode);
        if (spelled == null) {
            return "This value has type '{this.names().of(other)}', which can never be null, so this "
                + "comparison is always {result}. Remove the comparison, or give the value a nullable type "
                + "such as '{nullable}' if it should allow null.";
        }
        string comparison = "{spelled} {operatorText} null";
        if (left is NullType) {
            comparison = "null {operatorText} {spelled}";
        }
        string change = "give '{spelled}' a nullable type such as '{nullable}'";
        if (wording.unwrapParentheses(valueNode) is IdentifierExpressionNode) {
            change = "declare '{spelled}' as '{nullable}'";
        }
        return "'{spelled}' has type '{this.names().of(other)}', which can never be null, so '{comparison}' "
            + "is always {result}. Remove the comparison, or {change} if it should allow null.";
    }

    // A function value has nothing to reach into: no fields, no methods, no identity and no text
    // form. The one home for reporting it, whether the name was read or called.
    reportFunctionMember(string name, Type functionType, Span at) -> Type {
        this.reporter().report(capabilities.functionMemberIssue(name, functionType, this.names()), at);
        return this.store().errorType();
    }

    // Refuses comparing two function values, which have no identity, and returns whether it did.
    // Comparing a nullable one with 'null' tests presence and stays allowed.
    reportFunctionComparison(Span span, Type left, Type right) -> bool {
        if (left is NullType || right is NullType) {
            return false;
        }
        if (!(convert.coreOf(left) is FunctionType) && !(convert.coreOf(right) is FunctionType)) {
            return false;
        }
        this.reporter().report("A function value has no identity, so '{this.names().of(left)}' and "
            + "'{this.names().of(right)}' cannot be compared. Compare what the functions produce, "
            + "or keep a name or tag beside each one and compare that.", span);
        return true;
    }

    // Struct and array '==' compare memberwise, so every field or element needs its own '=='.
    // A type mentioning a type parameter is judged per instantiation.
    checkStructEquatable(Type leftSide, Type rightSide, Span span) {
        Type judged = leftSide;
        if (convert.coreOf(leftSide) is ArrayType && convert.coreOf(rightSide) is ArrayType) {
            judged = convert.coreOf(leftSide);
        } else if (!types.isStructLike(leftSide) || leftSide != rightSide) {
            return;
        }
        if (convert.containsTypeParam(judged)) {
            this.recordObligation(new EqualityObligation(judged, span));
            return;
        }
        let issue = capabilities.equalityComparabilityIssue(judged, this.names());
        if (issue != null) {
            this.reporter().report(issue, span);
        }
    }

    analyzeComparison(Span span, SyntaxKind operator, string operatorText, Expression leftNode,
                              Expression rightNode, Type left, Type right) -> Type {
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right, operatorText);
        if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
            return this.store().primitive(PrimitiveKind.Bool);
        }
        Type first = adapted[0];
        Type second = adapted[1];
        if (!convert.isNumericType(first) || !convert.isNumericType(second)) {
            bool ordersStrings = convert.coreOf(first) is StringType && convert.coreOf(second) is StringType;
            bool accepted = acceptsCores(operator, first, second);
            let guidance = nullguidance.binaryGuidance(this, leftNode, rightNode, first, second, accepted,
                null, operatorText);
            string sides = sidesClause(leftNode, rightNode, first, second, !convert.isNumericType(first),
                !convert.isNumericType(second), this.names());
            string refusal = nullguidance.withGuidance(this, "'{operatorText}' compares numbers, {sides}.",
                guidance);
            if (ordersStrings) {
                refusal = refusal + " "
                    + nullguidance.orderingAdvice(this, operatorText, leftNode, rightNode, first, second);
            }
            this.reporter().report(refusal, span);
            return this.store().primitive(PrimitiveKind.Bool);
        }
        if (convert.numericCommonType(first, second) == null) {
            this.reporter().report("'{operatorText}' needs the same number type on both sides, "
                + "{sidesClause(leftNode, rightNode, first, second, true, true, this.names())}."
                + bothSidesConversion(operatorText, leftNode, rightNode, first, second), span);
        }
        return this.store().primitive(PrimitiveKind.Bool);
    }

    analyzeBitwise(Span span, SyntaxKind operator, string operatorText, Expression leftNode,
                           Expression rightNode, Type left, Type right, WriteTarget? written) -> Type {
        // A bitwise operator takes integers, so only an integer literal adapts to the other side.
        Type checkedLeft = this.adaptIntegerLiteral(leftNode, right, null,
            this.operandLiteralFix(leftNode, rightNode, right, operatorText, false))
            ?? checkedSide(left, written);
        Type checkedRight = this.adaptIntegerLiteral(rightNode, left, null,
            this.operandLiteralFix(rightNode, leftNode, left, operatorText, true)) ?? right;
        if (checkedLeft is ErrorType || checkedRight is ErrorType) {
            return this.store().errorType();
        }
        Type shownLeft = shownSide(checkedLeft, left, written);
        if (!convert.isIntegerType(checkedLeft) || !convert.isIntegerType(checkedRight)) {
            bool accepted = acceptsCores(operator, checkedLeft, checkedRight);
            let guidance = nullguidance.binaryGuidance(this, leftNode, rightNode, shownLeft, checkedRight,
                accepted, written, operatorText);
            this.reporter().report(nullguidance.withGuidance(this, sidesRefusal(operator, operatorText,
                leftNode, rightNode, shownLeft, checkedRight, this.names()), guidance), span);
            return this.store().errorType();
        }
        if (checkedLeft != checkedRight) {
            this.reporter().report("'{operatorText}' needs the same integer type on both sides, "
                + "{sidesClause(leftNode, rightNode, shownLeft, checkedRight, true, true, this.names())}."
                + bothSidesConversion(operatorText, leftNode, rightNode, checkedLeft, checkedRight), span);
            return this.store().errorType();
        }
        return checkedLeft;
    }

    // The shifted value alone decides the result type, so only the distance adapts.
    analyzeShift(Span span, SyntaxKind operator, string operatorText, Expression leftNode,
                 Expression rightNode, Type left, Type right, WriteTarget? written) -> Type {
        Type checkedLeft = checkedSide(left, written);
        JoinText? why = null;
        if (this.overflowWidening(rightNode, checkedLeft) != null) {
            string text = wording.takesTypeFrom("'{wording.oneLineSpelling(leftNode)}'",
                this.names().of(convert.coreOf(checkedLeft)));
            why = new JoinText(text, text);
        }
        Type distance = this.adaptIntegerLiteral(rightNode, checkedLeft, null, why) ?? right;
        if (distance is ErrorType) {
            return this.store().errorType();
        }
        bool accepted = acceptsCores(operator, left, distance);
        let guidance = nullguidance.binaryGuidance(this, leftNode, rightNode, left, distance, accepted,
            written, operatorText);
        bool shiftedNull = left is OptionalType;
        if (written != null) {
            shiftedNull = written.nullLevels() > 0;
        }
        if (accepted && shiftedNull && distance is OptionalType) {
            this.reporter().report(nullguidance.withGuidance(this,
                "'{operatorText}' needs an integer to shift and an "
                + "integer shift distance, {sidesClause(leftNode, rightNode, left, distance, true, true,
                this.names())}.", guidance), span);
            return this.store().errorType();
        }
        if (!convert.isIntegerType(checkedLeft)) {
            this.reporter().report(nullguidance.withGuidance(this, sidesRefusal(operator, operatorText,
                leftNode, rightNode, left, distance, this.names()), guidance), span);
            return this.store().errorType();
        }
        if (!convert.isIntegerType(distance)) {
            this.reporter().report(nullguidance.withGuidance(this,
                "'{operatorText}' needs an integer shift distance, but "
                + "{wording.sideNamed(rightNode, "the distance")} has type '{this.names().of(distance)}'.",
                guidance), span);
            return this.store().errorType();
        }
        if (checkedLeft != distance) {
            string shifted = this.names().of(shownSide(checkedLeft, left, written));
            string wanted = this.names().of(checkedLeft);
            string fix = "Convert the distance with 'as'.";
            if (wording.shortSpelling(rightNode) != null) {
                fix = "Write '{wording.converted(wording.unwrapParentheses(rightNode), wanted)}'.";
            }
            this.reporter().report("'{operatorText}' shifts {typenames.typeArticle(shifted)} '{shifted}' "
                + "here, so the shift distance must be {typenames.typeArticle(wanted)} '{wanted}' too, but "
                + "{wording.sideNamed(rightNode, "the distance")} has type '{this.names().of(distance)}'. "
                + "{fix}",
                span);
            return this.store().errorType();
        }
        return checkedLeft;
    }

    analyzePrefix(PrefixExpressionNode node) -> Type {
        SyntaxKind prefixOperator = node.operator().kind();
        Type operand = this.analyzePrefixOperand(prefixOperator, node.operand());
        if (prefixOperator == SyntaxKind.Minus || prefixOperator == SyntaxKind.Plus) {
            this.retargetLiteralRange(node, node.operand(),
                prefixOperator == SyntaxKind.Minus);
        }
        if (operand is ErrorType) {
            return this.store().errorType();
        }
        Type core = operand;
        switch (node.operator().kind()) {
            Minus, Plus -> {
                if (!convert.isNumericType(core)) {
                    let guidance = nullguidance.unaryGuidance(this, node.operand(), operand,
                        convert.isNumericType(convert.coreOf(operand)), null);
                    this.reporter().report(nullguidance.withGuidance(this, "Unary '{node.operator().text()}' "
                        + "needs a number, but {wording.sideNamed(node.operand(), "the operand")} has type "
                        + "'{this.names().of(operand)}'.", guidance), node.span());
                    return this.store().errorType();
                }
                return core;
            },
            Exclamation -> {
                if (!convert.isBoolType(core)) {
                    let guidance = nullguidance.unaryGuidance(this, node.operand(), operand,
                        convert.isBoolType(convert.coreOf(operand)), null);
                    this.reporter().report(nullguidance.withGuidance(this, "'!' negates a 'bool', but "
                        + "{wording.sideNamed(node.operand(), "the operand")} has type "
                        + "'{this.names().of(operand)}'.",
                        guidance), node.span());
                    return this.store().errorType();
                }
                return core;
            },
            Tilde -> {
                if (!convert.isIntegerType(core)) {
                    let guidance = nullguidance.unaryGuidance(this, node.operand(), operand,
                        convert.isIntegerType(convert.coreOf(operand)), null);
                    this.reporter().report(nullguidance.withGuidance(this, "'~' flips the bits of an "
                        + "integer, but {wording.sideNamed(node.operand(), "the operand")} has type "
                        + "'{this.names().of(operand)}'.",
                        guidance), node.span());
                    return this.store().errorType();
                }
                return core;
            },
            PlusPlus, MinusMinus -> {
                return this.analyzeIncrement(node.span(), node.operand(), core,
                    node.operator().kind() == SyntaxKind.PlusPlus, true);
            },
            default -> {
                this.reporter().report("Internal: unsupported unary operator "
                    + "'{node.operator().text()}'.", node.operator().span());
                return this.store().errorType();
            },
        }
    }

    // The operand of a prefix operator. '++' and '--' store back what they read, so their
    // operand takes the write position; the other prefix operators only read theirs.
    analyzePrefixOperand(SyntaxKind operator, Expression operand) -> Type {
        if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
            return this.analyzeWriteTarget(operand);
        }
        return this.analyzeExpression(operand);
    }

    analyzePostfix(PostfixExpressionNode node) -> Type {
        Type operand = this.analyzeWriteTarget(node.operand());
        if (operand is ErrorType) {
            return this.store().errorType();
        }
        return this.analyzeIncrement(node.span(), node.operand(), operand,
            node.operator().kind() == SyntaxKind.PlusPlus, false);
    }

    analyzeIncrement(Span span, Expression operand, Type operandType, bool isIncrement,
                             bool isPrefix) -> Type {
        string operator = "--";
        if (isIncrement) {
            operator = "++";
        }
        string before = "";
        string after = operator;
        if (isPrefix) {
            before = operator;
            after = "";
        }
        // Parentheses around the operand name the same storage, so every rule below reads through them.
        Expression changed = wording.unwrapParentheses(operand);
        // A write through '?.' or '?[' is judged by the slot it lands in, as the same write without
        // the '?' is.
        Type changedType = operandType;
        bool safe = this.reportSafeTarget(operand, operandType, operator, before, after, span);
        if (safe) {
            changedType = this.safeSlotType(changed) ?? operandType;
        }
        long nullLevels = wording.optionalLevels(changedType);
        let refusal = this.reportUnchangeable(changed, changedType, safe, operator, before, after, span);
        if (refusal == WriteRefusal.Unwritable) {
            nullLevels = 0;
        }
        if (changed is ThisExpressionNode || changed is SuperExpressionNode) {
            return operandType;
        }
        if (!convert.isNumericType(changedType)) {
            string refusalText = "'{operator}' works only on numbers, and "
                + "'{wording.oneLineSpelling(changed)}' has type '{this.names().of(changedType)}'.";
            if (acceptsCores(SyntaxKind.PlusPlus, changedType, changedType)) {
                // A slot reached through '?.' or '?[' is refused for its null only once the '?' is gone.
                if (nullLevels > 0 && !safe) {
                    let guidance = nullguidance.unaryGuidance(this, operand, changedType, true,
                        new WriteTarget(nullLevels));
                    this.reporter().report(nullguidance.withGuidance(this, refusalText, guidance), span);
                }
                return changedType;
            }
            this.reporter().report(refusalText + " Use it on an integer or a floating-point variable, for "
                + "example '{before}count{after}'.", span);
            return changedType;
        }
        if (safe || refusal != WriteRefusal.None) {
            return changedType;
        }
        narrowing.invalidateForWrite(this, changed);
        narrowing.establishWriteNarrowing(this, changed, operandType);
        return changedType;
    }

    // Reports why '++' or '--' cannot change the operand at this place in the code, when it cannot.
    // 'before' and 'after' place the operator as the code writes it.
    reportUnchangeable(Expression changed, Type changedType, bool safe, string operator,
                       string before, string after, Span span) -> WriteRefusal {
        if (changed is ThisExpressionNode || changed is SuperExpressionNode) {
            string keyword = "this";
            if (changed is SuperExpressionNode) {
                keyword = "super";
            }
            string refusal = "'{keyword}' is not a variable, so '{operator}' cannot change it.";
            let field = this.receiverExampleField(changedType, true);
            if (field != null) {
                refusal = refusal + " Change a field instead, as in '{before}{keyword}.{field}{after}'.";
            }
            this.reporter().report(refusal, span);
            return WriteRefusal.Unwritable;
        }
        if (!safe && !this.isLValue(changed)) {
            this.reporter().report("{wording.sideNamed(changed, "This value")} is not a variable, a field or "
                + "an array element, so '{operator}' cannot change it.", span);
            return WriteRefusal.Unwritable;
        }
        if (changed is IdentifierExpressionNode) {
            let binding = this.result().bindingOf(changed.green());
            if (binding != null && this.reportRefusedWrite(binding, "change", span)) {
                return WriteRefusal.Misplaced;
            }
            if (binding != null && binding.isConst()) {
                this.reporter().report(this.constantRefusal("'{operator}' cannot change '{binding.name()}'",
                    binding), span);
                return WriteRefusal.Unwritable;
            }
        }
        if (changed is MemberExpressionNode) {
            let staticField = this.result().staticConstFieldOf(changed.green());
            if (staticField != null) {
                this.reporter().report("The '{operator}' operator cannot change "
                    + "'{staticConstDisplay(staticField, this.names())}': a "
                    + "{members.typeLevelFieldWord(staticField)} keeps the value its "
                    + "initializer gives it. Change the initializer, or use an instance field.", span);
                return WriteRefusal.Unwritable;
            }
            let root = this.writtenChainRoot(changed);
            if (root != null && this.reportRefusedWrite(root, "change", span)) {
                return WriteRefusal.Misplaced;
            }
        }
        let field = nullguidance.accessedField(this, changed);
        if (field != null && field.isConst()) {
            this.reporter().report("The '{operator}' operator cannot change field "
                + "'{field.name()}': a 'const' field is assigned once when the object "
                + "is constructed and never again. Remove 'const' from the field if it "
                + "needs to change.", span);
            return WriteRefusal.Unwritable;
        }
        return WriteRefusal.None;
    }

    // Refuses assigning to 'this' or to 'super', neither of which is a variable, and names a
    // field of the type the keyword reaches. Reports nothing where it reaches none, since
    // reading the keyword there reports that instead.
    reportReceiverAssignment(string keyword, Type reached, string operator, Span at) {
        if (reached is ErrorType) {
            return;
        }
        string refusal = "'{keyword}' is not a variable, so it cannot be assigned.";
        let field = this.receiverExampleField(reached, operator != "=");
        if (field == null) {
            this.reporter().report(refusal, at);
            return;
        }
        this.reporter().report(refusal + " Assign the fields that should change, as in "
            + "'{keyword}.{field} {operator} ...'.", at);
    }

    // Refuses a write through '?.' or '?[', which has nowhere to store when the value in front of
    // the '?' is null. The example spells the same write without its '?' inside a null check, and
    // there is none where no statement can go.
    reportSafeWrite(Expression target, AccessStep access, Type reached, string operator,
                    string before, string after, Span at) {
        string reader = "?.";
        let index = access.index();
        if (index != null) {
            reader = "?[";
        }
        string subject = "'{wording.oneLineSpelling(wording.unwrapParentheses(access.receiver()))}'";
        string refusal = "'{reader}' cannot appear on the left side of '{operator}', because "
            + "there is nothing to write to when {subject} is null.";
        if (operator == "++" || operator == "--") {
            refusal = "'{operator}' cannot change '{wording.oneLineSpelling(target)}' through '{reader}', "
                + "because there is nothing to write to when {subject} is null.";
        }
        if (reached is ErrorType) {
            this.reporter().report(refusal, at);
            return;
        }
        let front = nullguidance.classifyOperand(this, access.receiver(), 1, "", false);
        if (front.form() == OperandForm.NoFix) {
            this.reporter().report(refusal, at);
            return;
        }
        string accessor = ".{access.member() ?? ""}";
        if (index != null) {
            accessor = "[{wording.simpleSpelling(index) ?? ""}]";
        }
        bool spelled = index == null || wording.simpleSpelling(index) != null;
        string write = "{before}{front.held()}{accessor}{after}";
        if (spelled && front.form() == OperandForm.Stable) {
            this.reporter().report(refusal + " Check for null first, as in 'if ({front.held()} != null) "
                + "\{ {write}; \}'.", at);
            return;
        }
        string spelledFront = wording.oneLineSpelling(wording.unwrapParentheses(access.receiver()));
        string local = front.local();
        string declaration = front.declaration();
        bool whole = front.held() == front.local();
        string copy = "";
        if (front.form() == OperandForm.Copied) {
            copy = "Copy '{spelledFront}' into a local first";
        } else if (front.form() == OperandForm.Stored) {
            copy = "Store the result of '{spelledFront}' in a local first";
        } else if (front.form() == OperandForm.Guarded) {
            string base = nullguidance.accessStep(wording.unwrapParentheses(access.receiver()))?.member()
                ?? "value";
            local = nullguidance.freeLocalName(this, "", base);
            declaration = "let {local} = {spelledFront};";
            whole = true;
            copy = "Copy '{spelledFront}' into a local first";
        }
        if (!spelled || !whole || copy.length == 0) {
            this.reporter().report(refusal + " Check for null first, then write the same line "
                + "without the '?'.", at);
            return;
        }
        this.reporter().report(refusal + " {copy} ('{declaration}') and check the local, as in "
            + "'if ({local} != null) \{ {before}{local}{accessor}{after}; \}'.", at);
    }

    // reportSafeWrite for a target read through '?.' or '?[', and true when the target is one.
    reportSafeTarget(Expression target, Type reached, string operator, string before, string after,
                     Span at) -> bool {
        Expression written = wording.unwrapParentheses(target);
        let access = nullguidance.accessStep(written);
        if (access == null || !access.safe()) {
            return false;
        }
        this.reportSafeWrite(written, access, reached, operator, before, after, at);
        return true;
    }

    // The name of a field that a write through 'this' or 'super' can land in, or null when there is
    // none. With 'numeric', the field is a number.
    receiverExampleField(Type reached, bool numeric = false) -> string? {
        let fields = typemembers.fieldsOf(reached);
        if (fields == null) {
            return null;
        }
        for (long i = 0; i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.isConst() || field.isStatic() || (numeric && !convert.isNumericType(field.type()))) {
                continue;
            }
            if (!this.isAccessAllowed(field.visibility(), field.definingType())) {
                continue;
            }
            if (typemembers.inheritedOrOwnField(reached, field.name()) == field) {
                return field.name();
            }
        }
        return null;
    }

    // The declared type of the slot a write through '?.' or '?[' lands in, the field's or the
    // element's own type. Null when the write lands in no field or element.
    public safeSlotType(Expression target) -> Type? {
        let field = nullguidance.accessedField(this, target);
        if (field != null) {
            return field.type();
        }
        let access = nullguidance.accessStep(target);
        if (access != null && access.safe() && access.index() != null) {
            let objectType = this.result().typeOf(access.receiver().green());
            if (objectType != null) {
                Type array = convert.coreOf(objectType);
                if (array is ArrayType) {
                    return array.element();
                }
            }
        }
        return null;
    }

    // A member write through a class reference mutates the heap object, so any object works; a
    // struct member write needs an addressable struct, so the object must itself be an lvalue.
    // Parentheses name the place they hold, so the test reads through them wherever they stand.
    isLValue(Expression node) -> bool {
        switch (wording.unwrapParentheses(node)) {
            is IdentifierExpressionNode ignored -> {
                return true;
            },
            is SubscriptExpressionNode ignored -> {
                return true;
            },
            is ThisExpressionNode ignored -> {
                return true;
            },
            is MemberExpressionNode member -> {
                let objectType = this.result().typeOf(member.object().green());
                if (objectType != null && types.isStructLike(objectType)) {
                    return this.isLValue(member.object());
                }
                return true;
            },
            default -> {
                return false;
            },
        }
    }

    // Analyzes the left side of a write. A member access takes the write position wherever it
    // stands, as the left side itself, under a '?.', or inside parentheses, which name the place
    // they hold.
    analyzeWriteTarget(Expression target, MemberPosition position = MemberPosition.Write)
            -> Type {
        switch (target) {
            is MemberExpressionNode member -> {
                Type analyzed = this.analyzeMemberValue(member, position);
                this.result().setType(member.green(), analyzed);
                return analyzed;
            },
            is SafeMemberExpressionNode member -> {
                Type analyzed = this.analyzeSafeMemberValue(member, position);
                this.result().setType(member.green(), analyzed);
                return analyzed;
            },
            is ParenthesizedExpressionNode parenthesized -> {
                Type analyzed = this.analyzeWriteTarget(parenthesized.inner(), position);
                this.result().setType(parenthesized.green(), analyzed);
                return analyzed;
            },
            default -> {
                return this.analyzeExpression(target);
            },
        }
    }

    analyzeAssignment(AssignmentExpressionNode node) -> Type {
        // A plain `x = ...` is a definite assignment of x, so its own identifier on the left is
        // a write, not a read to check. A compound `x += ...` reads x first, and a member or
        // subscript target reads its base, which must already be assigned.
        bool simpleAssign = node.operator().kind() == SyntaxKind.Equals;
        let target = node.target();
        // Parentheses around a target name the same storage, so every rule below reads through
        // them.
        let writtenTarget = wording.unwrapParentheses(target);
        let previousTarget = this.assignment().assignmentTarget();
        if (simpleAssign && writtenTarget is IdentifierExpressionNode) {
            let resolved = this.resolveName(writtenTarget.name().text());
            if (resolved is LocalName) {
                this.assignment().setAssignmentTarget(resolved.binding);
            }
        }
        Type targetType = this.analyzeWriteTarget(target);
        this.assignment().setAssignmentTarget(previousTarget);
        string operator = node.operator().text();
        // The levels of the target's own null that a refusal of a compound operator names. None are
        // named where no write can change the target.
        long nullLevels = wording.optionalLevels(targetType);
        // A refused write proves nothing about the target, so it narrows nothing.
        bool refused = false;
        switch (writtenTarget) {
            is ThisExpressionNode ignored -> {
                this.reportReceiverAssignment("this", targetType, operator, node.span());
                nullLevels = 0;
                refused = true;
            },
            is SuperExpressionNode ignored -> {
                this.reportReceiverAssignment("super", targetType, operator, node.span());
                nullLevels = 0;
                refused = true;
            },
            is SafeMemberExpressionNode ignored -> {},
            is SafeSubscriptExpressionNode ignored -> {},
            default -> {
                if (!this.isLValue(target)) {
                    string outcome = "so '{operator}' cannot store its result there";
                    if (operator == "=") {
                        outcome = "so it cannot be assigned";
                    }
                    this.reporter().report("{wording.sideNamed(target, "This value")} is not a variable, a "
                        + "field or an array element, {outcome}.", node.span());
                    nullLevels = 0;
                    refused = true;
                }
            },
        }
        let staticTarget = this.result().staticConstFieldOf(writtenTarget.green());
        if (staticTarget != null) {
            this.reporter().report("Cannot assign to '{staticConstDisplay(staticTarget, this.names())}': "
                + "a {members.typeLevelFieldWord(staticTarget)} keeps the value its initializer "
                + "gives it. Change the initializer, or use an instance field.", node.span());
            nullLevels = 0;
            refused = true;
        }
        if (writtenTarget is IdentifierExpressionNode) {
            let refusal = this.reportBindingWrite(writtenTarget);
            if (refusal == WriteRefusal.Unwritable) {
                nullLevels = 0;
            }
            refused = refused || refusal != WriteRefusal.None;
        } else if (writtenTarget is MemberExpressionNode) {
            let root = this.writtenChainRoot(writtenTarget);
            if (root != null && this.reportRefusedWrite(root, "change", writtenTarget.span())) {
                refused = true;
            }
        }
        Type assignTarget = this.declaredTargetType(writtenTarget, targetType);
        Type valueType = this.analyzeExpressionAdapt(node.value(), assignTarget,
            this.assignmentOrigin(node, writtenTarget, assignTarget));
        // A write through '?.' or '?[' is judged by the slot it lands in, as the same write without
        // the '?' is.
        Type writtenType = targetType;
        bool safe = this.reportSafeTarget(target, targetType, operator, "", " {operator} ...", node.span());
        if (safe) {
            writtenType = assignTarget;
            nullLevels = wording.optionalLevels(assignTarget);
            refused = true;
        }
        let field = nullguidance.accessedField(this, writtenTarget);
        bool throughThis = writtenTarget is MemberExpressionNode
            && wording.unwrapParentheses(writtenTarget.object()) is ThisExpressionNode;
        if (field != null && field.isConst()) {
            if (this.checkConstFieldWrite(node, field, throughThis, simpleAssign)) {
                refused = true;
            }
            nullLevels = 0;
        }
        // What the store actually lands: the right side for '=', the operator's result for 'OP='.
        Type storedType = valueType;
        // A slot reached through '?.' or '?[' is refused for its null only once the '?' is gone, so its
        // compound write is checked as a write to its core type.
        Type compoundTarget = writtenType;
        long compoundLevels = nullLevels;
        if (safe && writtenType is OptionalType) {
            compoundTarget = convert.coreOf(writtenType);
            compoundLevels = 0;
        }
        if (!(assignTarget is ErrorType) && !(valueType is ErrorType)) {
            if (simpleAssign) {
                if (!convert.isAssignableStrict(assignTarget, valueType)) {
                    string hint = nullguidance.valueAssignabilityHint(this, assignTarget, valueType,
                        node.value());
                    this.reporter().report(
                        "'{wording.oneLineSpelling(wording.unwrapParentheses(node.target()))}' has type "
                        + "'{this.names().of(assignTarget)}', but the value assigned to it has type "
                        + "'{this.names().of(valueType)}'.{hint}", node.span());
                    refused = true;
                }
            } else if (!(targetType is ErrorType) && !(writtenTarget is ThisExpressionNode)
                    && !(writtenTarget is SuperExpressionNode)) {
                let result = this.checkCompoundAssignment(node, assignTarget, compoundTarget, valueType,
                    new WriteTarget(compoundLevels), this.namesDeclaredPlace(writtenTarget));
                if (result == null) {
                    refused = true;
                } else {
                    storedType = result;
                }
            }
        }
        if (assignTarget != targetType && !safe) {
            this.result().setType(node.target().green(), assignTarget);
        }
        // A refused write to a static or lazy const changes no narrowing.
        if (staticTarget == null) {
            narrowing.invalidateForWrite(this, writtenTarget);
            if (!refused) {
                narrowing.establishWriteNarrowing(this, writtenTarget, storedType);
            }
        }
        if (writtenTarget is IdentifierExpressionNode) {
            let binding = this.result().bindingOf(writtenTarget.green());
            if (binding != null && this.assignment().unconditionalPosition()) {
                this.assignment().markAssigned(binding);
            }
        } else if (field != null && simpleAssign && throughThis) {
            this.assignment().markThisFieldMaybeAssigned(field, node.span());
            if (this.assignment().unconditionalPosition()) {
                this.assignment().markThisFieldAssigned(field);
            }
        }
        return assignTarget;
    }

    // Enforces the write-once contract of a 'const' field at an assignment naming it, and returns
    // true when it refuses the write. The one legal write is a plain '=' through 'this' inside a
    // constructor of the field's own type, outside any loop, on a path that cannot have assigned it.
    checkConstFieldWrite(AssignmentExpressionNode node, Field field, bool throughThis, bool simpleAssign)
            -> bool {
        string name = field.name();
        string ownerName = this.constFieldOwnerName(field);
        if (!simpleAssign) {
            string operatorText = node.operator().text();
            this.reporter().report("Cannot use '{operatorText}' on field '{name}': a 'const' "
                + "field is assigned once when the object is constructed and never again. "
                + "Remove 'const' from the field if it needs to change.", node.span());
            return true;
        }
        if (!this.frame().inConstructor() || !throughThis) {
            string sites = "inside a constructor of '{ownerName}' as 'this.{name} = ...'";
            if (types.authorityOf(field.definingType()) is StructType) {
                sites = sites + " or by a struct literal like '\{{name}: ...\}'";
            }
            this.reporter().report("Cannot assign a new value to field '{name}': it is 'const', "
                + "so it is assigned exactly once, " + sites + ". Remove 'const' from the "
                + "field if it needs to change.", node.span());
            return true;
        }
        if (field.definingType() != this.assignment().constructorFieldOwner()) {
            this.reporter().report("Field '{name}' is 'const' and declared in base class "
                + "'{ownerName}', so only a constructor of '{ownerName}' can assign it. Pass "
                + "the value to 'super(...)' instead.", node.span());
            return true;
        }
        if (this.frame().loopDepth() > 0) {
            this.reporter().report("Field '{name}' is 'const' and cannot be assigned inside a "
                + "loop, which can run more than once. Assign it once, outside the loop.",
                node.span());
            return true;
        }
        let earlier = this.assignment().possibleWriteOf(field);
        if (earlier != null) {
            this.reporter().report("Field '{name}' is 'const' and may already be assigned when "
                + "this line runs. Remove one of the assignments.", node.span(), earlier.span(),
                "'{name}' is assigned here");
            return true;
        }
        return false;
    }

    // 'a OP= b' means 'a = a OP b', so the operator's result has to fit the target. Returns that
    // result, or null when the write is refused.
    checkCompoundAssignment(AssignmentExpressionNode node, Type assignTarget, Type targetType,
                                    Type valueType, WriteTarget written, bool declared) -> Type? {
        SyntaxKind operator = compoundOperator(node.operator().kind());
        string operatorText = node.operator().text();
        if (operator == SyntaxKind.Invalid) {
            this.reporter().report("Internal: unsupported compound assignment operator "
                + "'{operatorText}'.", node.operator().span());
            return valueType;
        }
        Type result = this.analyzeBinaryOperands(node.span(), operator, operatorText,
            node.target(), node.value(), targetType, valueType, written);
        bool storable = result is ErrorType || convert.isAssignableStrict(assignTarget, result);
        if (!storable) {
            Type core = convert.coreOf(targetType);
            string declaredType = this.names().of(result);
            if (assignTarget is OptionalType) {
                declaredType = this.names().nullableOf(result);
            }
            string target = wording.oneLineSpelling(wording.unwrapParentheses(node.target()));
            string cast = wording.converted(wording.unwrapParentheses(node.value()), this.names().of(core));
            string place = this.declaredPlaceAs(node.target(), declaredType);
            string fix = "";
            if (convert.isNumericType(valueType) && convert.isNumericType(core)) {
                fix = " Write '{cast}'.";
                if (declared && place.length > 0) {
                    fix = " Write '{cast}', or declare {place}.";
                }
            } else if (declared && place.length > 0) {
                fix = " Declare {place}.";
            }
            this.reporter().report("Cannot store the result of '{operatorText}' back into '{target}', "
                + "whose type is '{this.names().of(assignTarget)}': "
                + "{combinedWords(operator, core, valueType, this.names())} produces "
                + "'{this.names().of(result)}'.{fix}", node.span());
        }
        bool nullRefused = written.nullLevels() > 0 && !(valueType is OptionalType)
            && acceptsCores(operator, targetType, valueType);
        if (nullRefused) {
            let guidance = nullguidance.binaryGuidance(this, node.target(), node.value(), targetType,
                valueType, true, written, operatorText);
            this.reporter().report(nullguidance.withGuidance(this, sidesRefusal(operator, operatorText,
                node.target(), node.value(), targetType, valueType, this.names()), guidance), node.span());
        }
        if (result is ErrorType || !storable || nullRefused) {
            return null;
        }
        return result;
    }

    // The variable, field or array a compound write lands in, declared so that it takes 'slotType',
    // as in "'count' as 'long'". Empty when no declaration names it.
    declaredPlaceAs(Expression target, string slotType) -> string {
        Expression core = wording.unwrapParentheses(target);
        if (core is IdentifierExpressionNode) {
            return "'{core.name().text()}' as '{slotType}'";
        }
        let access = nullguidance.accessStep(core);
        if (access == null) {
            return "";
        }
        let member = access.member();
        if (member != null) {
            return "field '{member}' as '{slotType}'";
        }
        Expression receiver = wording.unwrapParentheses(access.receiver());
        string? array = nullguidance.accessStep(receiver)?.member();
        if (receiver is IdentifierExpressionNode) {
            array = receiver.name().text();
        }
        let arrayType = narrowing.declaredSlotType(this, receiver);
        if (array == null || arrayType == null) {
            return "";
        }
        string levels = "";
        Type layer = arrayType;
        while (layer is OptionalType) {
            levels = "{levels}?";
            layer = layer.inner();
        }
        return "'{array}' as '{slotType}[]{levels}'";
    }

    // Reports a write the binding refuses, and returns why it refuses it.
    reportBindingWrite(IdentifierExpressionNode identifier) -> WriteRefusal {
        let binding = this.result().bindingOf(identifier.green());
        if (binding == null) {
            return WriteRefusal.None;
        }
        if (this.reportRefusedWrite(binding, "assign a new value to", identifier.span())) {
            return WriteRefusal.Misplaced;
        }
        if (!binding.isConst()) {
            return WriteRefusal.None;
        }
        this.reporter().report(
            this.constantRefusal("Cannot assign a new value to '{binding.name()}'", binding),
            identifier.span());
        return WriteRefusal.Unwritable;
    }

    // The refusal 'opening' of a write to the constant local 'binding', with the change to its
    // declaration that lets it change. The value an 'is' arm matched has no declaration to change.
    constantRefusal(string opening, LocalBinding binding) -> string {
        string name = binding.name();
        if (definiteassignment.bindingsContain(this.armBindings, binding)) {
            return "{opening}, because '{name}' is the value this 'is' arm matched, and it cannot change. "
                + "Copy it into a variable if it needs to change, as in 'let changed = {name};'.";
        }
        string fix = "Remove 'const' from its declaration";
        if (definiteassignment.bindingsContain(this.untypedConstants, binding)) {
            fix = "Replace 'const' with 'let' in its declaration";
        }
        return "{opening}, because '{name}' is declared 'const'. {fix} if it needs to change.";
    }

    // Whether the target names a variable, a field or an element, whose declaration could take another type.
    namesDeclaredPlace(Expression target) -> bool {
        switch (target) {
            is IdentifierExpressionNode identifier -> {
                return this.result().bindingOf(identifier.green()) != null;
            },
            is MemberExpressionNode ignored -> {
                return narrowing.declaredSlotType(this, target) != null;
            },
            is SubscriptExpressionNode ignored -> {
                return narrowing.declaredSlotType(this, target) != null;
            },
            default -> {
                return this.safeSlotType(target) != null;
            },
        }
    }

    // The declared type of the written slot: the binding's, field's, or element's own type.
    declaredTargetType(Expression target, Type analyzed) -> Type {
        switch (target) {
            is IdentifierExpressionNode identifier -> {
                let binding = this.result().bindingOf(identifier.green());
                if (binding == null) {
                    return analyzed;
                }
                return binding.type();
            },
            is MemberExpressionNode member -> {
                return narrowing.declaredSlotType(this, member) ?? analyzed;
            },
            is SubscriptExpressionNode subscript -> {
                let objectType = this.result().typeOf(subscript.object().green());
                if (objectType is ArrayType) {
                    return objectType.element();
                }
                return analyzed;
            },
            default -> {
                if (nullguidance.accessStep(target)?.safe() ?? false) {
                    return this.safeSlotType(target) ?? analyzed;
                }
                return analyzed;
            },
        }
    }

    analyzeTernary(TernaryExpressionNode node, Type? target, LiteralOrigin? origin = null) -> Type {
        let scope = this.targets().beginJoin(node, false);
        Type analyzed = this.analyzeTernaryValues(node, target, origin);
        this.endJoin(node, scope);
        return analyzed;
    }

    // Keeps the refusal 'message' of a value of the current join until the join ends, when the
    // refusal of a literal of the join covers it, or reports it outside every join.
    holdMismatch(string message, Span span) {
        if (this.targets().joinRoot() == null) {
            this.reporter().report(message, span);
            return;
        }
        this.targets().joinMismatches().push(new HeldMismatch(message, span));
    }

    // Ends the join 'join' began with 'scope', reporting the literals it kept when it is outermost.
    endJoin(Expression join, JoinScope scope) {
        if (scope.created()) {
            this.keepPendingJoinLiterals(join);
            this.reportJoinFailures(join);
            if (this.targets().joinFailures().length() == 0) {
                for (let mismatch in this.targets().joinMismatches()) {
                    this.reporter().report(mismatch.message(), mismatch.span());
                }
            }
        }
        this.targets().endJoin(scope);
    }

    // Marks 'value' as the next value of the current join, when it is a join itself, or with 'arrays'
    // an array literal, which the elements of an array literal share their join with.
    noteJoinValue(Expression value, bool arrays = false) {
        Expression core = wording.unwrapParentheses(value);
        if (nullguidance.isJoin(core) || (arrays && core is ArrayLiteralExpressionNode)) {
            this.targets().setJoinChild(core.green());
        }
    }

    analyzeTernaryValues(TernaryExpressionNode node, Type? target, LiteralOrigin? origin) -> Type {
        Type? fixTarget = target;
        LiteralOrigin? fixOrigin = origin;
        if (target == null && this.targets().joinNode() == node.green()) {
            fixTarget = this.targets().joinTarget();
            fixOrigin = this.targets().joinOrigin();
        }
        this.targets().clearStash();
        Type condition = this.analyzeExpression(node.condition());
        Expression thenValue = node.thenValue();
        Expression elseValue = node.elseValue();
        // A number literal beside a branch with a type of its own takes that branch's type when it
        // is one of the literal's family, so it is analyzed without the target first.
        bool thenJoins = isUntypedNumberLiteral(thenValue) && !isUntypedNumberLiteral(elseValue);
        bool elseJoins = isUntypedNumberLiteral(elseValue) && !isUntypedNumberLiteral(thenValue);
        Type? thenTarget = target;
        if (thenJoins) {
            thenTarget = null;
        }
        Type? elseTarget = target;
        if (elseJoins) {
            elseTarget = null;
        }
        if (thenTarget == null) {
            this.targets().stash(thenValue, fixTarget, fixOrigin);
        }
        let outerDeferred = this.targets().deferredFixes();
        let thenDeferred = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(thenDeferred);
        this.noteJoinValue(thenValue);
        Type thenType = narrowing.analyzeGuardedBranch(this, node.condition(), thenValue, true, thenTarget,
            origin);
        this.targets().clearStash();
        if (elseTarget == null) {
            this.targets().stash(elseValue, fixTarget, fixOrigin);
        }
        let elseDeferred = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(elseDeferred);
        this.noteJoinValue(elseValue);
        Type elseType = narrowing.analyzeGuardedBranch(this, node.condition(), elseValue, false, elseTarget,
            origin);
        this.targets().clearStash();
        this.targets().setDeferredFixes(outerDeferred);
        this.settleDeferred(thenDeferred, elseValue, elseType, "the other branch");
        this.settleDeferred(elseDeferred, thenValue, thenType, "the other branch");
        this.checkConditionIsBool(condition, "?:", node.condition());
        if (thenType is ErrorType || elseType is ErrorType) {
            return this.store().errorType();
        }
        this.noteSuffixedBranch(node, true, elseType, fixTarget, fixOrigin);
        this.noteSuffixedBranch(node, false, thenType, fixTarget, fixOrigin);
        if (target != null && thenJoins && !joinsLiteral(thenValue, elseType)) {
            thenType = this.adaptIntegerLiteral(thenValue, target, origin)
                ?? this.adaptFloatLiteral(thenValue, target, origin) ?? thenType;
        }
        if (target != null && elseJoins && !joinsLiteral(elseValue, thenType)) {
            elseType = this.adaptIntegerLiteral(elseValue, target, origin)
                ?? this.adaptFloatLiteral(elseValue, target, origin) ?? elseType;
        }
        JoinText? thenFix = this.ternaryFix(node, true, elseType, fixTarget, fixOrigin);
        JoinText? elseFix = this.ternaryFix(node, false, thenType, fixTarget, fixOrigin);
        this.targets().setBesideLiteral(isUntypedNumberLiteral(elseValue));
        Type adaptedThen = this.adaptIntegerLiteral(thenValue, elseType, null, thenFix)
            ?? this.adaptFloatLiteral(thenValue, elseType, null, thenFix) ?? thenType;
        this.targets().setBesideLiteral(isUntypedNumberLiteral(thenValue));
        Type adaptedElse = this.adaptIntegerLiteral(elseValue, thenType, null, elseFix)
            ?? this.adaptFloatLiteral(elseValue, thenType, null, elseFix) ?? elseType;
        this.targets().setBesideLiteral(false);
        thenType = adaptedThen;
        elseType = adaptedElse;
        if (thenType is ErrorType || elseType is ErrorType) {
            return this.store().errorType();
        }
        let unified = convert.unifyValueTypes(thenType, elseType, this.store());
        if (unified != null) {
            return unified;
        }
        this.holdMismatch("The two results of this '?:' are '{this.names().of(thenType)}' and "
            + "'{this.names().of(elseType)}', which have no common type. Give both branches the "
            + "same type.", node.span());
        return this.store().errorType();
    }

    // '??' is a presence test on the left's declared storage type, so a binding declared
    // optional keeps it legal even after narrowing proved the value non-null; the check is
    // then constant and yields the value.
    analyzeNullCoalesce(NullCoalesceExpressionNode node) -> Type {
        Type left = this.analyzeExpression(node.left());
        if (!(left is ErrorType)) {
            left = narrowing.presenceOperandType(this, node.left(), left);
        }
        bool previous = this.assignment().unconditionalPosition();
        this.assignment().setUnconditionalPosition(false);
        // The fallback takes the type the left side has without its '?', as an assigned value takes
        // the type of the place it is assigned to.
        Type right;
        if (left is OptionalType) {
            LiteralOrigin? origin = null;
            if (mayAdaptLiteral(node.right())) {
                origin = new LiteralOrigin(OriginKind.Fallback, wording.oneLineSpelling(node.left()), "",
                    left.inner());
            }
            let outerDeferred = this.targets().deferredFixes();
            this.targets().setDeferredFixes(null);
            right = this.analyzeExpressionAdapt(node.right(), left.inner(), origin);
            this.targets().setDeferredFixes(outerDeferred);
        } else {
            right = this.analyzeExpression(node.right());
        }
        this.assignment().setUnconditionalPosition(previous);
        if (left is ErrorType || right is ErrorType) {
            return this.store().errorType();
        }
        if (!(left is OptionalType)) {
            string shown = this.names().of(left);
            let spelledLeft = wording.shortSpelling(node.left());
            let spelledRight = wording.shortSpelling(node.right());
            string removal = "Remove the '??' and the fallback after it";
            if (spelledRight != null) {
                removal = "Remove '?? {spelledRight}'";
            }
            Expression leftValue = wording.unwrapParentheses(node.left());
            bool declared = leftValue is IdentifierExpressionNode || leftValue is MemberExpressionNode;
            if (spelledLeft != null && declared) {
                this.reporter().report("'{spelledLeft}' has type '{shown}', which can never be null, so the "
                    + "fallback after '??' is never used. {removal}, or give '{spelledLeft}' a nullable type "
                    + "such as '{this.names().nullableOf(left)}'.", node.span());
            } else if (spelledLeft != null) {
                this.reporter().report("'{spelledLeft}' has type '{shown}', which can never be null, so the "
                    + "fallback after '??' is never used. {removal}.", node.span());
            } else {
                this.reporter().report("The left side of '??' has type '{shown}', which can never be null, "
                    + "so the fallback after '??' is never used. {removal}.", node.span());
            }
            return this.store().errorType();
        }
        Type unwrapped = left.inner();
        if (convert.isAssignableStrict(unwrapped, right)) {
            return unwrapped;
        }
        if (convert.isAssignableStrict(left, right)) {
            return left;
        }
        string hint = nullguidance.valueAssignabilityHint(this, unwrapped, right, node.right());
        string replaced = wording.sideNamed(node.left(), "the left side");
        string wanted = this.names().of(unwrapped);
        this.reporter().report("The fallback after '??' has type '{this.names().of(right)}', but it replaces "
            + "{replaced} when {replaced} is null, so it must have type '{wanted}'.{hint}", node.span());
        return this.store().errorType();
    }

    analyzeSubscript(SubscriptExpressionNode node) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        let outerDeferred = this.targets().deferredFixes();
        this.targets().setDeferredFixes(null);
        Type indexType = this.analyzeExpression(node.index());
        this.targets().setDeferredFixes(outerDeferred);
        if (objectType is ErrorType) {
            return this.store().errorType();
        }
        if (objectType is OptionalType && convert.coreOf(objectType) is ArrayType) {
            this.reporter().report(nullguidance.maybeNullRefusal(this, "Cannot index "
                + "'{this.names().of(objectType)}' because it", node.object(), objectType), node.span());
            return this.store().errorType();
        }
        if (objectType is ArrayType) {
            this.checkIndexIsInteger(indexType, node.index());
            return objectType.element();
        }
        this.reporter().report(this.notArrayRefusal(node.object(), objectType), node.span());
        return this.store().errorType();
    }

    // The refusal of '[...]' after 'object', whose type is not an array.
    notArrayRefusal(Expression object, Type objectType) -> string {
        string shown = this.names().of(objectType);
        return "Cannot index {wording.sideNamed(object, "this value")}, because its type '{shown}' is not an "
            + "array. Only an array can be indexed with '[...]'.";
    }

    analyzeSafeSubscript(SafeSubscriptExpressionNode node) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        let outerDeferred = this.targets().deferredFixes();
        this.targets().setDeferredFixes(null);
        Type indexType = this.analyzeExpression(node.index());
        this.targets().setDeferredFixes(outerDeferred);
        if (objectType is ErrorType) {
            return this.store().errorType();
        }
        objectType = narrowing.presenceOperandType(this, node.object(), objectType);
        if (!(objectType is OptionalType)) {
            if (!(objectType is ArrayType)) {
                this.reporter().report(this.notArrayRefusal(node.object(), objectType), node.span());
                return this.store().errorType();
            }
            let spelled = wording.shortSpelling(node.object());
            if (spelled == null) {
                this.reporter().report("The value before '?[' has type '{this.names().of(objectType)}', "
                    + "which can never be null, so it needs no '?['. Write '[' instead.", node.span());
            } else {
                this.reporter().report("'{spelled}' has type '{this.names().of(objectType)}', which can "
                    + "never be null, so it needs no '?['. Write "
                    + "'{spelled}[{wording.oneLineSpelling(node.index())}]'.", node.span());
            }
            return this.store().errorType();
        }
        Type inner = objectType.inner();
        if (inner is OptionalType) {
            this.reporter().report(nullguidance.withGuidance(this, "'?[' checks for one level of null, but "
                + "the value on its left has type '{this.names().of(objectType)}', which can be null at more "
                + "than one level.", nullguidance.nullGuidance(this, node.object(), objectType,
                wording.optionalLevels(objectType) - 1)), node.span());
            return this.store().errorType();
        }
        if (inner is ArrayType) {
            this.checkIndexIsInteger(indexType, node.index());
            return this.safeResultOf(inner.element());
        }
        this.reporter().report(this.notArrayRefusal(node.object(), objectType), node.span());
        return this.store().errorType();
    }

    // Refuses the index 'node' of an array unless it is an integer.
    checkIndexIsInteger(Type indexType, Expression node) {
        if (!(indexType is ErrorType) && !convert.isIntegerType(indexType)) {
            this.reporter().report("The index of an array must be an integer, but "
                + "{wording.sideNamed(node, "the index")} has type '{this.names().of(indexType)}'.",
                node.span());
        }
    }

    analyzeTry(TryExpressionNode node) -> Type {
        if (!(node.operand() is CallExpressionNode)) {
            this.reporter().report(misplacedTryRefusal(node.operand()), node.span());
        }
        Type analyzed = this.analyzeExpression(node.operand());
        this.assignment().noteThrowEscapePoint(this.frame().inCatchClause());
        return analyzed;
    }

    // Array literal with no target type: the first element's type drives the rest.
    analyzeArrayLiteral(ArrayLiteralExpressionNode node) -> Type {
        let scope = this.targets().beginJoin(node, false);
        Type analyzed = this.analyzeArrayElements(node);
        this.endJoin(node, scope);
        return analyzed;
    }

    // The initializer of the untyped local 'name': an array literal there names it when its
    // elements give it no type.
    analyzeInitializerOf(string name, Expression value) -> Type {
        if (!(wording.unwrapParentheses(value) is ArrayLiteralExpressionNode)) {
            return this.analyzeExpression(value);
        }
        this.targets().setArrayHolderName(name);
        Type analyzed = this.analyzeExpression(value);
        this.targets().setArrayHolderName(null);
        return analyzed;
    }

    // analyzeArrayLiteral once the array is the join its elements are analyzed in.
    analyzeArrayElements(ArrayLiteralExpressionNode node) -> Type {
        let holder = this.targets().arrayHolderName();
        this.targets().setArrayHolderName(null);
        if (node.elementsCount() == 0) {
            string example = "int[] values = [];";
            if (holder != null) {
                this.reporter().report("An empty '[]' has no element type to give '{holder}'. Declare its "
                    + "type, as in 'int[] {holder} = [];'.", node.span());
                return this.store().errorType();
            }
            this.reporter().report("An empty '[]' has no element type here. Write it where an array type is "
                + "declared, as in '{example}'.", node.span());
            return this.store().errorType();
        }
        this.noteJoinValue(node.elements(0), true);
        Type elementType = this.analyzeExpression(node.elements(0));
        if (elementType is ErrorType) {
            for (long i = 1; i < node.elementsCount(); i++) {
                this.noteJoinValue(node.elements(i), true);
                this.analyzeExpression(node.elements(i));
            }
            return this.store().errorType();
        }
        if (elementType is NullType) {
            if (holder != null) {
                this.reporter().report("'null' alone gives the elements of '{holder}' no type. Declare its "
                    + "type, as in 'string?[] {holder} = [null];'.", node.elements(0).span());
            } else {
                this.reporter().report("'null' alone gives the elements of this array no type. Write it "
                    + "where an array type is declared, as in 'string?[] values = [null];'.",
                    node.elements(0).span());
            }
            for (long i = 1; i < node.elementsCount(); i++) {
                this.noteJoinValue(node.elements(i), true);
                this.analyzeExpression(node.elements(i));
            }
            return this.store().errorType();
        }
        for (long i = 1; i < node.elementsCount(); i++) {
            Type actual = this.store().errorType();
            this.noteJoinValue(node.elements(i), true);
            let widening = this.joinWidening(node.elements(i), elementType, this.targets().joinRoot());
            if (widening != null
                    && this.isCoveredLiteral(wording.unwrapParentheses(node.elements(i)).green())) {
                this.analyzeExpression(node.elements(i));
                this.result().setType(wording.unwrapParentheses(node.elements(i)).green(),
                    this.store().errorType());
                continue;
            }
            if (widening != null) {
                let fix = this.elementFix(node, elementType, widening);
                this.analyzeExpression(node.elements(i));
                actual = this.adaptIntegerLiteral(node.elements(i), elementType, null, fix)
                    ?? this.adaptFloatLiteral(node.elements(i), elementType, null, fix) ?? actual;
            } else {
                actual = this.analyzeExpressionAdapt(node.elements(i), elementType);
            }
            if (actual is ErrorType) {
                continue;
            }
            if (!convert.isAssignableStrict(elementType, actual)) {
                this.holdMismatch(elementMismatch(i, elementType, actual, this.names())
                    + "{nullguidance.valueAssignabilityHint(this, elementType, actual, node.elements(i))}",
                    node.elements(i).span());
            }
        }
        return this.store().arrayOf(elementType);
    }

    // Array literal with a target type: each element adapts to the target's element type. The
    // target may be an array or an array under any number of optional levels; the wrapping
    // applies at the use site.
    analyzeArrayLiteralAdapt(ArrayLiteralExpressionNode node, Type target, LiteralOrigin? origin) -> Type {
        // Under a type already refused, an array literal whose elements give it no type reports nothing
        // more.
        if (target is ErrorType && (node.elementsCount() == 0 || wording.isNullLiteral(node.elements(0)))) {
            for (long i = 0; i < node.elementsCount(); i++) {
                this.analyzeExpression(node.elements(i));
            }
            return this.store().errorType();
        }
        if (target is ErrorType) {
            return this.analyzeArrayLiteral(node);
        }
        let scope = this.targets().beginJoin(node, false);
        Type analyzed = this.analyzeArrayElementsAdapt(node, target, origin);
        this.endJoin(node, scope);
        return analyzed;
    }

    // analyzeArrayLiteralAdapt once the array is the join its elements are analyzed in.
    analyzeArrayElementsAdapt(ArrayLiteralExpressionNode node, Type target, LiteralOrigin? origin) -> Type {
        Type arrayType = convert.coreOf(target);
        if (arrayType is ArrayType) {
            Type elementType = arrayType.element();
            LiteralOrigin? elementOrigin = null;
            bool element = origin != null
                && (origin.kind() == OriginKind.Parameter || origin.kind() == OriginKind.Fallback);
            if (origin != null && element) {
                elementOrigin = new LiteralOrigin(origin.kind(), origin.name(), origin.owner(), elementType);
                elementOrigin.setConstructed(origin.constructed());
                elementOrigin.setForElement(true);
            } else if (origin != null) {
                elementOrigin = new LiteralOrigin(origin.kind(), origin.name(), "", origin.declared());
            }
            let mismatched = new List<long>();
            let mismatchedTypes = new List<Type>();
            for (long i = 0; i < node.elementsCount(); i++) {
                this.noteJoinValue(node.elements(i), true);
                Type actual = this.analyzeExpressionAdapt(node.elements(i), elementType, elementOrigin);
                if (!(actual is ErrorType) && !convert.isAssignableStrict(elementType, actual)) {
                    mismatched.push(i);
                    mismatchedTypes.push(actual);
                }
            }
            // The refusal of a literal of the array reports the array once, as it does for a '?:',
            // so an element that does not fit waits for the array and gets no report beside one.
            for (long j = 0; j < mismatched.length(); j++) {
                long i = mismatched.get(j);
                Type actual = mismatchedTypes.get(j);
                this.targets().joinMismatches().push(new HeldMismatch(
                    elementMismatch(i, elementType, actual, this.names())
                    + "{nullguidance.valueAssignabilityHint(this, elementType, actual, node.elements(i))}",
                    node.elements(i).span()));
            }
            return arrayType;
        }
        this.reporter().report("Cannot assign an array literal to '{this.names().of(target)}', "
            + "which is not an array type.", node.span());
        for (long i = 0; i < node.elementsCount(); i++) {
            this.analyzeExpression(node.elements(i));
        }
        return this.store().errorType();
    }

    // A struct literal with a target type: every field is set by name against the target struct's
    // declared fields, with the same visibility, adaptation, and assignability rules as a direct
    // field write.
    analyzeStructLiteralAdapt(StructLiteralExpressionNode node, Type target) -> Type {
        if (target is ErrorType) {
            return literaltyping.analyzeStructLiteral(this, node);
        }
        Type structType = convert.coreOf(target);
        if (!types.isStructLike(structType)) {
            this.reporter().report(this.notStructRefusal(target), node.span());
            for (long i = 0; i < node.fieldsCount(); i++) {
                this.analyzeExpression(node.fields(i).value());
            }
            return this.store().errorType();
        }
        this.result().setType(node.green(), structType);
        let fields = typemembers.fieldsOf(structType);
        if (fields == null) {
            return structType;
        }
        string structShown = structDisplayName(structType, this.names());
        let provided = new List<bool>();
        for (long i = 0; i < fields.length(); i++) {
            provided.push(false);
        }
        for (long i = 0; i < node.fieldsCount(); i++) {
            let entry = node.fields(i);
            string fieldName = entry.name().text();
            long index = fieldIndexNamed(fields, fieldName);
            if (index < 0) {
                this.reporter().report("Struct '{structShown}' has no field named '{fieldName}'."
                    + fieldsListed(fields), entry.name().span());
                this.analyzeExpression(entry.value());
                continue;
            }
            if (provided.get(index)) {
                this.reporter().report("Field '{fieldName}' is set twice in this struct literal. Remove the "
                    + "second '{fieldName}: ...'.", entry.name().span());
                this.analyzeExpression(entry.value());
                continue;
            }
            provided.set(index, true);
            let field = fields.get(index);
            this.checkMemberAccess(fieldName, field.visibility(), field.definingType(),
                entry.name().span());
            Type fieldType = field.type();
            let origin = this.valueOrigin(OriginKind.Declared, fieldName, fieldType, entry.value());
            if (origin != null) {
                origin.setOwner(structShown);
            }
            Type valueType = this.analyzeExpressionAdapt(entry.value(), fieldType, origin);
            if (!(valueType is ErrorType) && !(fieldType is ErrorType)
                    && !convert.isAssignableStrict(fieldType, valueType)) {
                this.reporter().report("Field '{fieldName}' has type '{this.names().of(fieldType)}', but its "
                    + "value here has type '{this.names().of(valueType)}'."
                    + "{nullguidance.valueAssignabilityHint(this, fieldType, valueType, entry.value())}",
                    entry.value().span());
            }
        }
        for (long i = 0; i < fields.length(); i++) {
            if (provided.get(i)) {
                continue;
            }
            let field = fields.get(i);
            if (field.hasDefault()) {
                continue;
            }
            this.reporter().report("Struct literal for '{structShown}' does not set the field "
                + "'{field.name()}'. Add '{field.name()}: ...', or give the field a default "
                + "value.", node.span());
        }
        return structType;
    }

    // The refusal of a '{...}' literal toward 'target', which is not a struct, with the 'new' that
    // creates an object of a class this file can construct.
    notStructRefusal(Type target) -> string {
        string shown = this.names().of(target);
        Type core = convert.coreOf(target);
        let authority = types.authorityOf(core);
        if (authority is ClassType && !authority.isAbstract()) {
            string opening = "'{shown}' is a class, and a '\{...\}' literal builds only a struct.";
            let arguments = this.classConstructionArguments(core);
            if (arguments != null && this.names().canSpell(core)) {
                return "{opening} Write 'new {this.names().of(core)}{arguments}' to create one.";
            }
            return opening;
        }
        return "'{shown}' is not a struct, and a '\{...\}' literal builds only a struct.";
    }

    // The head this file writes for a struct a diagnostic offers to build, or null where it has
    // no spelling for it. An instantiation keeps its type arguments, which its literal and its
    // constructor call both need.
    structHead(Type structType, string written) -> string? {
        if (!(structType is InstantiationType)) {
            return written;
        }
        if (!this.names().canSpell(structType)) {
            return null;
        }
        return this.names().of(structType);
    }

    // A struct built by a call it has no constructor for. The literal is left out where this
    // file cannot set every field the literal has to set.
    reportStructWithoutConstructor(CallExpressionNode node, Type structType, string name) {
        string refusal = "Struct '{name}' has no constructor to call.";
        let head = this.structHead(structType, name);
        string? literal = null;
        if (head != null) {
            literal = this.structLiteralExample(head, structType);
        }
        if (literal == null) {
            this.reporter().report(refusal + " Add a 'constructor(...)' to it.", node.span());
            return;
        }
        this.reporter().report(refusal + " Build it with a literal, for example '{literal}', or "
            + "add a 'constructor(...)'.", node.span());
    }

    // 'new' written on a struct, which a constructor call or an aggregate literal builds instead.
    // 'written' is the head the 'new' carries.
    reportNewOnStruct(NewExpressionNode node, Type structType, string written) {
        string refusal = "'new' builds a class, and '{written}' is a struct.";
        let head = this.structHead(structType, written);
        string route = "";
        if (head != null) {
            route = this.structValueRoute(head, structType);
        }
        if (route.length == 0) {
            this.reporter().report(refusal + " Remove 'new', and add a 'constructor(...)' to '{written}' to "
                + "call.", node.span());
            return;
        }
        this.reporter().report("{refusal} {route}.", node.span());
    }

    // 'StructName(args)': a by-value struct built through its constructor. Resolution mirrors
    // class-constructor resolution (overloads, named and optional arguments) with no allocation.
    analyzeStructConstructorCall(CallExpressionNode node, Type structType, string name)
            -> Type {
        let arguments = node.arguments();
        Type target = structType;
        if (target is StructType && target.isGeneric()) {
            let typeArguments = node.typeArguments();
            if (typeArguments == null) {
                this.reporter().report(unshownTypeArguments("'{name}'", target.typeParameters(), "{name}<",
                    ">{argumentsSpelling(arguments)}", exampleTypeArgument(arguments)), node.span());
                this.analyzeArgumentsOnly(arguments);
                return structType;
            }
            target = this.resolver().instantiateGeneric(target, name, typeArguments, node.span());
            if (target is ErrorType) {
                this.analyzeArgumentsOnly(arguments);
                return target;
            }
        }
        this.result().setType(node.green(), target);
        let allConstructors = typemembers.constructorsOf(target);
        let constructors = this.existingOnly(allConstructors);
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return target;
        }
        if (constructors.length() == 0) {
            this.reportStructWithoutConstructor(node, target, name);
            this.analyzeArgumentsOnly(arguments);
            return target;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, constructors.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter(),
                node.span(), name, "Constructor", this.names());
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible()) {
                            this.checkConstructorAccess(target, chosenMethod, node.span());
                        }
                        this.result().setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
            return target;
        }
        let structConstructor = constructors.get(0);
        this.checkConstructorAccess(target, structConstructor, node.span());
        this.result().setMethod(node.green(), structConstructor);
        this.checkDirectArguments("Constructor", name, structConstructor.signature(),
            arguments, node.span(), this.names().of(target));
        return target;
    }

    // ---- Member access ----

    // The type whose members a receiver exposes: a bounded type parameter exposes the members
    // of its bounds, the first bound declaring the member winning; inside a conditional member
    // the constraint's extra bounds count. Optional receivers are rejected before this point.
    memberReceiverCore(Type analyzed, string memberName) -> Type {
        Type core = analyzed;
        if (core is TypeParamType) {
            Type[] bounds = this.effectiveBoundsOf(core);
            for (let bound in bounds) {
                if (!(this.lookupMember(bound, memberName) is MissingMember)) {
                    return bound;
                }
            }
            if (bounds.length > 0) {
                return bounds[0];
            }
        }
        return core;
    }

    // The parameter's declared bounds plus whatever the active conditional member's constraint
    // adds to it.
    effectiveBoundsOf(TypeParamType parameter) -> Type[] {
        Type[] extra = hierarchy.extraBoundsFor(parameter, this.resolver().activeConstraintOwner(),
            this.resolver().activeConstraints());
        if (extra.length == 0) {
            return parameter.bounds();
        }
        let combined = new List<Type>();
        for (let bound in parameter.bounds()) {
            combined.push(bound);
        }
        for (let bound in extra) {
            combined.push(bound);
        }
        return combined.toArray();
    }

    // What the name means on a receiver of this type. A private base field is not inherited, so a
    // method this type declares takes the name instead. That field is still what the name means
    // when the type declares no other member of it, so the refusal names it as a private field
    // rather than as one that does not exist.
    public lookupMember(Type record, string name) -> MemberLookup {
        let field = typemembers.inheritedOrOwnField(record, name);
        if (field != null) {
            return new FieldMember(field);
        }
        let candidates = this.availableMethods(record, name);
        if (candidates.length() > 0) {
            return new MethodMember(candidates);
        }
        let uninherited = members.findField(typemembers.fieldsOf(record), name);
        if (uninherited != null) {
            return new FieldMember(uninherited);
        }
        return new MissingMember();
    }

    // ---- Conditional members ----

    // The name's method candidates that exist on their defining types, judged under the active
    // constraint scope; a conditional member excluded here surfaces through the
    // unmet-constraint reporting instead.
    availableMethods(Type record, string name) -> List<Method> {
        return this.existingOnly(methodCandidates(record, name));
    }

    availableStatics(Type owner, string name) -> List<Method> {
        return this.existingOnly(staticsNamed(owner, name));
    }

    existingOnly(List<Method> candidates) -> List<Method> {
        bool anyConditional = false;
        for (long i = 0; i < candidates.length(); i++) {
            if (candidates.get(i).isConditional()) {
                anyConditional = true;
            }
        }
        if (!anyConditional) {
            return candidates;
        }
        let kept = new List<Method>();
        for (long i = 0; i < candidates.length(); i++) {
            if (this.resolver().memberExists(candidates.get(i))) {
                kept.push(candidates.get(i));
            }
        }
        return kept;
    }

    // The conditional candidates the receiver's type arguments exclude.
    missingConditional(List<Method> candidates) -> List<Method> {
        let missing = new List<Method>();
        for (long i = 0; i < candidates.length(); i++) {
            let candidate = candidates.get(i);
            if (candidate.isConditional() && !this.resolver().memberExists(candidate)) {
                missing.push(candidate);
            }
        }
        return missing;
    }

    // Reports why a member access missed when the receiver's type arguments exclude a
    // conditional member with the name. True when it reported.
    reportUnmetConstraintMember(Type receiver, string name, Span span) -> bool {
        return this.reportFirstUnmet(this.missingConditional(methodCandidates(receiver, name)),
            span);
    }

    reportFirstUnmet(List<Method> missing, Span span) -> bool {
        for (long i = 0; i < missing.length(); i++) {
            let member = missing.get(i);
            let failed = this.resolver().firstUnmetConstraint(member);
            if (failed != null) {
                let template = types.authorityOf(member.definingType());
                if (template != null) {
                    this.reporter().report(this.unmetConstraintMessage(member, template,
                        hierarchy.typeArgumentsOf(member.definingType()), failed), span);
                    return true;
                }
            }
        }
        return false;
    }

    // A call that reaches no available overload but fits an excluded conditional one reports
    // the unmet constraint instead of a mismatched-overload error. True when it reported.
    reportUnmetConstraintCall(List<Method> allCandidates, List<Method> available,
                              ArgumentListNode? arguments, Span span) -> bool {
        long count = 0;
        if (arguments != null) {
            if (usesNamedArguments(arguments)) {
                return false;
            }
            count = arguments.argumentsCount();
        }
        let missing = this.missingConditional(allCandidates);
        if (missing.length() == 0) {
            return false;
        }
        if (available.length() == 0) {
            return this.reportFirstUnmet(missing, span);
        }
        for (long i = 0; i < available.length(); i++) {
            if (fitsArgumentCount(available.get(i).signature(), count)) {
                return false;
            }
        }
        let fitting = new List<Method>();
        for (long i = 0; i < missing.length(); i++) {
            if (fitsArgumentCount(missing.get(i).signature(), count)) {
                fitting.push(missing.get(i));
            }
        }
        return this.reportFirstUnmet(fitting, span);
    }

    // "'sort' exists on 'List<T>' only when 'T' satisfies 'Comparable<T>'; in 'List<Widget>',
    // 'T' is 'Widget', which does not implement 'Comparable<Widget>'."
    unmetConstraintMessage(Method member, DeclaredType template, Type[] arguments,
                           FailedConstraint failed) -> string {
        string templateShown = "{this.names().nameOf(template)}<{typeParameterExample(template)}>";
        string what = "'{member.name()}' exists on '{templateShown}'";
        if (member.isConstructor()) {
            what = "This constructor of '{templateShown}' exists";
        }
        string parameterName = template.typeParameters()[failed.parameterIndex()];
        string declaredBound = this.names().of(failed.bound());
        Type argument = arguments[failed.parameterIndex()];
        string shownArgument = this.names().of(argument);
        if (argument is TypeParamType) {
            return "{what} only when '{parameterName}' satisfies '{declaredBound}', and nothing here "
                + "requires that of '{shownArgument}'. "
                + addBoundAdvice(this.currentMemberWord(), shownArgument,
                    this.names().of(failed.boundHere()));
        }
        string ownerShown = "{this.names().nameOf(template)}<{typeArgumentsText(arguments, this.names())}>";
        string boundShown = this.names().of(failed.boundHere());
        if (!types.isInterfaceLike(failed.bound())) {
            return "{what} only when '{parameterName}' satisfies '{declaredBound}', and in '{ownerShown}', "
                + "'{parameterName}' is '{shownArgument}', which is not '{boundShown}' or a subclass of it. "
                + "Use a type argument that is '{boundShown}' or a subclass of it.";
        }
        string change = "";
        let declared = types.authorityOf(argument);
        if (declared != null && declared.packagePrefix() == this.packagePrefix()) {
            change = ", or make '{shownArgument}' implement it";
        }
        return "{what} only when '{parameterName}' satisfies '{declaredBound}', and in '{ownerShown}', "
            + "'{parameterName}' is '{shownArgument}', which does not implement '{boundShown}'. Use a type "
            + "argument that implements '{boundShown}'{change}.";
    }

    // Export members are visible everywhere and public ones package-wide; private members are
    // visible inside the declaring type, and protected ones in a subclass method or anywhere
    // in the module that declares the type.
    isAccessAllowed(Visibility visibility, Type definingType) -> bool {
        let defining = types.authorityOf(definingType);
        if (defining == null) {
            return true;
        }
        DeclaredType? current = null;
        let site = this.frame().enclosingOwner();
        if (site != null) {
            current = types.authorityOf(site);
        }
        return types.memberAccessAllowed(visibility, defining, current, this.modulePath(),
            this.packagePrefix());
    }

    // Reports a denied access and returns whether it was allowed, so a caller layering its own
    // diagnostic on the same node can stay quiet after a denial.
    checkMemberAccess(string memberName, Visibility visibility, Type definingType, Span span,
                      string followUp = "") -> bool {
        if (this.isAccessAllowed(visibility, definingType)) {
            return true;
        }
        string after = "";
        if (followUp.length > 0) {
            after = " {followUp}";
        }
        string owner = this.names().of(definingType);
        string kind = "type";
        let authority = types.authorityOf(definingType);
        if (authority != null) {
            owner = authority.name();
            kind = typenames.kindWordOf(authority);
        }
        string fix = "export";
        if (authority != null && authority.packagePrefix() == this.packagePrefix()) {
            fix = "public";
        }
        if (visibility == Visibility.Private) {
            this.reporter().report("'{memberName}' is private to {kind} '{owner}', so only code inside "
                + "'{owner}' can use it. Mark it '{fix}' to use it here.{after}", span);
        } else if (visibility == Visibility.Public) {
            string packageName = "its own package";
            string inModule = "";
            if (authority != null) {
                if (authority.packagePrefix().length > 0) {
                    packageName = "package '{authority.packagePrefix()}'";
                }
                inModule = " in module '{authority.modulePath()}'";
            }
            this.reporter().report("'{memberName}' of '{owner}' is public inside {packageName} "
                + "but not exported. Mark it 'export'{inModule} to use it from another "
                + "package.{after}", span);
        } else if (authority != null && authority.visibility() == Visibility.Private) {
            this.reporter().report("'{memberName}' belongs to {kind} '{owner}', which is private to "
                + "module '{authority.modulePath()}', so only that file can use it. Mark '{owner}' and "
                + "'{memberName}' '{fix}' to use it here.{after}", span);
        } else {
            this.reporter().report("'{memberName}' is 'protected' in {kind} '{owner}', so only "
                + "{types.protectedReach(authority, owner)} can use it. Mark it '{fix}' to use it here."
                + after, span);
        }
        return false;
    }

    // Constructor calls run through the same accessibility rules as any other member; only the
    // wording is constructor-specific. 'fromSubclass' marks a 'super(...)' call, which a
    // 'protected' constructor serves.
    checkConstructorAccess(Type ownerType, Method chosenConstructor, Span span, bool fromSubclass = false) {
        if (this.isAccessAllowed(chosenConstructor.visibility(),
                chosenConstructor.definingType())) {
            return;
        }
        string name = this.names().of(ownerType);
        let ownerAuthority = types.authorityOf(ownerType);
        if (ownerAuthority != null) {
            name = ownerAuthority.name();
        }
        let authority = types.authorityOf(chosenConstructor.definingType());
        if (chosenConstructor.visibility() == Visibility.Private) {
            string fix = "Mark it 'export' to construct '{name}' here.";
            if (fromSubclass) {
                fix = "Mark it 'protected' to call it from a subclass.";
            } else if (authority != null && authority.packagePrefix() == this.packagePrefix()) {
                fix = "Mark it 'public' to construct '{name}' here.";
            }
            this.reporter().report("The constructor of '{name}' is private, so only code inside '{name}' can "
                + "call it. {fix}", span);
        } else if (chosenConstructor.visibility() == Visibility.Public) {
            string packageName = "its own package";
            string inModule = "";
            if (authority != null) {
                if (authority.packagePrefix().length > 0) {
                    packageName = "package '{authority.packagePrefix()}'";
                }
                inModule = " in module '{authority.modulePath()}'";
            }
            this.reporter().report("The constructor of '{name}' is public inside {packageName} "
                + "but not exported. Mark it 'export'{inModule} to construct '{name}' from "
                + "another package.", span);
        } else {
            string fix = "export";
            if (authority != null && authority.packagePrefix() == this.packagePrefix()) {
                fix = "public";
            }
            this.reporter().report("The constructor of '{name}' is 'protected', so only "
                + "{types.protectedReach(ownerAuthority, name)} can call it. Mark it '{fix}' to construct "
                + "'{name}' here.", span);
        }
    }

    // A covered access reports no method here. A call is covered because it takes the method
    // this resolves to from the side table this sets.
    analyzeMemberValue(MemberExpressionNode node, MemberPosition position = MemberPosition.Read)
            -> Type {
        let object = node.object();
        string name = node.member().text();
        let wanted = this.targets().functionTargetOf(node.green());
        if (object is IdentifierExpressionNode) {
            string objectName = object.name().text();
            let resolution = this.resolveName(objectName);
            if (resolution is NamespaceName) {
                return this.analyzeNamespaceMemberValue(node, resolution.targetModulePath, objectName,
                    wanted);
            }
            let enumType = this.enumTypeNamed(resolution);
            if (enumType != null) {
                this.result().setType(object.green(), enumType);
                long ordinal = enumOrdinal(enumType, name);
                if (ordinal >= 0) {
                    if (position == MemberPosition.Write) {
                        this.reporter().report("'{name}' is a member of enum "
                            + "'{this.names().nameOf(enumType)}', so it cannot be assigned.",
                            node.member().span());
                        return this.store().errorType();
                    }
                    this.result().setEnumConstant(node.green(), ordinal);
                    return enumType;
                }
                this.reporter().report("'{name}' is not a member of enum "
                    + "'{this.names().nameOf(enumType)}'.{wording.membersListed(enumType)}",
                    node.member().span());
                return this.store().errorType();
            }
        }
        let staticHead = this.resolveStaticHead(object);
        if (staticHead != null) {
            return this.analyzeStaticMemberValue(node, object, staticHead, position, wanted);
        }
        Type objectType = this.analyzeExpression(object);
        if (objectType is ErrorType) {
            return this.store().errorType();
        }
        if (objectType is OptionalType) {
            this.reporter().report(nullguidance.maybeNullRefusal(this, "Cannot read a member of "
                + "'{this.names().of(objectType)}' because it", object, objectType), node.span());
            return this.store().errorType();
        }
        Type core = this.memberReceiverCore(objectType, name);
        if (core is ArrayType) {
            if (name == "length") {
                if (position == MemberPosition.Write) {
                    this.reportLengthAssignment(core, node.object(), node.member().span());
                    return this.store().errorType();
                }
                return this.store().primitive(PrimitiveKind.Long);
            }
            this.reporter().report("Type '{this.names().of(core)}' has no member '{name}'. An array has "
                + "'length' and the methods 'slice', 'toString' and 'hash'.", node.member().span());
            return this.store().errorType();
        }
        if (core is StringType) {
            if (name == "length") {
                if (position == MemberPosition.Write) {
                    this.reportLengthAssignment(core, node.object(), node.member().span());
                    return this.store().errorType();
                }
                return this.store().primitive(PrimitiveKind.Long);
            }
            if (types.bindingOf(core) == null) {
                this.reporter().report("Type 'string' has no member '{name}'.",
                    node.member().span());
                return this.store().errorType();
            }
        }
        if (core is FunctionType) {
            return this.reportFunctionMember(name, core, node.member().span());
        }
        if (core is ExternalType) {
            string held = wording.sideNamed(node.object(), "the value");
            this.reporter().report(typenames.externalMemberMessage(core, held, this.names()), node.span());
            return this.store().errorType();
        }
        if (!isRecordLike(core)) {
            this.reporter().report("Cannot read a member of '{this.names().of(core)}' because it "
                + "has no members.", node.span());
            return this.store().errorType();
        }
        switch (this.lookupMember(core, name)) {
            is FieldMember found -> {
                if (!this.checkMemberAccess(name, found.field.visibility(),
                        found.field.definingType(), node.member().span())) {
                    this.result().markMemberAccessDenied(node.green());
                }
                return narrowing.narrowedFieldType(this, node, found.field.type());
            },
            is MethodMember found -> {
                if (found.candidates.length() <= 1) {
                    let single = found.candidates.get(0);
                    this.checkMemberAccess(name, single.visibility(), single.definingType(),
                        node.member().span());
                }
                this.result().setMethod(node.green(), found.candidates.get(0));
                if (position != MemberPosition.Covered) {
                    this.reportMethodAsValue(name, core, found.candidates, node.object(), ".", position,
                        node.member().span(), wanted);
                }
                return this.store().errorType();
            },
            is MissingMember ignored -> {
                if (this.reportStaticThroughInstance(core, name, node.object(), node.member().span(),
                        wanted)) {
                    return this.store().errorType();
                }
                if (this.reportUnmetConstraintMember(core, name, node.member().span())) {
                    return this.store().errorType();
                }
                string refusal = "Type '{this.names().of(core)}' has no field or method named '{name}'.";
                if (nullguidance.subclassHasMember(this, core, name)) {
                    let guidance = nullguidance.unstableTestGuidance(this, node.object());
                    if (guidance != null) {
                        refusal = refusal + " " + guidance;
                    }
                }
                this.reporter().report(refusal, node.member().span());
                return this.store().errorType();
            },
        }
    }

    // Refuses the method 'name' of 'owner' written after 'receiver' and 'access' where a value belongs,
    // and where 'wanted' is not null, where a value of that function type is expected.
    reportMethodAsValue(string name, Type owner, List<Method> candidates, Expression receiver, string access,
                        MemberPosition position, Span at, FunctionType? wanted = null) {
        string head = name;
        let spelled = wording.shortSpelling(receiver);
        if (spelled != null) {
            head = spelled + access + name;
        }
        string subject = "'{name}' is a method of '{this.names().of(owner)}'";
        if (wanted != null && position == MemberPosition.Read) {
            let thisType = this.frame().thisType();
            let fix = this.lambdaFix("method", name, signaturesOf(candidates), wanted, pathRoot(receiver));
            bool writesLambda = fix.fit == LambdaFit.Fits || fix.fit == LambdaFit.Unwritten;
            if (writesLambda && thisType != null && rootsAtStructThis(receiver, thisType)) {
                fix = structThisLambda(this.names().of(thisType));
                if (this.lambdaRefusedThis()) {
                    fix = refusedLambda();
                }
            } else if (fix.fit == LambdaFit.Fits
                    && (spelled == null || !isRepeatablePath(receiver, thisType))) {
                fix = unwrittenLambda("method");
            }
            this.reporter().report(functionValueRefusal(subject, fix, head), at);
            return;
        }
        this.reporter().report(methodAsValueMessage(subject, methodCallText(head, candidates), position), at);
    }

    // Whether the lambda being checked read 'this' of a struct, which reported that it cannot capture it.
    lambdaRefusedThis() -> bool {
        long depth = this.lambdaFrames.length();
        let receiver = this.frame().thisType();
        return depth > 0 && receiver != null && refusesThisCapture(receiver)
            && this.lambdaFrames.get(depth - 1).readsReceiver;
    }

    // The lambda that makes the method or function 'name' a value of the function type 'wanted'. The
    // lambda's call is written behind a head that starts with the name 'head', which no parameter of the
    // lambda may hide.
    lambdaFix(string kind, string name, Signature[] candidates, FunctionType wanted, string head)
            -> LambdaFix {
        let taken = new Set<string>();
        taken.add(head);
        return lambdaFixFor(kind, name, candidates, wanted, taken, this.names(), this.store(),
            this.resolver().errorClass());
    }

    // Refuses a write to 'length' on an array or a string. An array keeps the length it was
    // created with and a string never changes, so neither holds storage under that name.
    reportLengthAssignment(Type holder, Expression array, Span at) {
        if (holder is ArrayType) {
            string example = this.resizedArrayExample(holder, array);
            let spelled = wording.shortSpelling(array);
            string opening = "'length' is the number of elements in this array";
            if (spelled != null) {
                opening = "'{spelled}.length' is the number of elements in '{spelled}'";
            }
            this.reporter().report("{opening}, so it cannot be assigned. An array keeps the length it was "
                + "created with. Create a new array of the size you need, {example}.", at);
            return;
        }
        this.reporter().report("'length' is the number of bytes in the string, so it cannot be assigned. A "
            + "string never changes once it is created, so build the text you need and assign that.", at);
    }

    // How to create an array of the holder's type at a new size. 'new T[size]' stands alone
    // only where a new slot's zero value is a valid element on every level it allocates.
    resizedArrayExample(ArrayType holder, Expression array) -> string {
        Type innermost = holder.element();
        string sizes = "[...]";
        while (innermost is ArrayType) {
            innermost = innermost.element();
            sizes = sizes + "[...]";
        }
        if (convert.isDefaultable(innermost)) {
            return "as in 'new {this.newElementSpelling(innermost)}{sizes}'";
        }
        string shown = this.names().of(holder);
        string element = this.newElementSpelling(holder.element());
        string name = resizedName(array);
        return "either by listing every element, as in '[a, b]', or with '{shown} {name} = new "
            + "{element}[size];' followed by 'for (long i = 0; i < {name}.length; i++) \{ "
            + "{name}[i] = ...; \}'";
    }

    // How a 'new' expression writes an element type before its size. A function type takes parentheses there.
    newElementSpelling(Type element) -> string {
        if (element is FunctionType) {
            return "({this.names().of(element)})";
        }
        return this.names().of(element);
    }

    // The C# rule: a static is reachable only through the declaring type's name, so reaching it
    // through an instance is an error that names the spelling to use, wherever in the chain the
    // static is declared. 'wanted' is the function type expected where it is written. True when it
    // reported.
    reportStaticThroughInstance(Type receiver, string name, Expression object, Span at,
                                FunctionType? wanted = null) -> bool {
        Type? current = receiver;
        while (current != null) {
            let statics = staticsNamed(current, name);
            let field = members.findField(typemembers.staticFieldsOf(current), name);
            let authority = types.authorityOf(current);
            if ((statics.length() > 0 || field != null) && authority != null) {
                string ownerName = this.names().nameOf(authority);
                string value = "this value";
                let spelledObject = wording.shortSpelling(object);
                if (spelledObject != null) {
                    value = "the value '{spelledObject}'";
                }
                if (field != null) {
                    this.reporter().report("'{name}' is a {members.typeLevelFieldWord(field)} of "
                        + "'{ownerName}', so it belongs to the type, not to {value}. Write "
                        + "{typenames.qualifiedMemberSpelling(authority, name, this.names())}.", at);
                    return true;
                }
                Type head = staticMethodHead(current, authority);
                string refusal = "'{name}' is a static method of '{ownerName}', so it is called on the type, "
                    + "not on {value}.";
                if (wanted != null) {
                    let fix = this.lambdaFix("method", name, this.reachedSignatures(statics, wanted), wanted,
                        this.names().plainNameOf(authority));
                    if (fix.fit != LambdaFit.Called) {
                        string spelling = typenames.qualifiedMemberSpelling(head, name, this.names(),
                            fix.before, fix.after);
                        this.reporter().report("{refusal} {nameNotValueText(fix, spelling)}", at);
                        return true;
                    }
                }
                let call = new StaticCallText(statics);
                string spelling = typenames.qualifiedMemberSpelling(head, name, this.names(), call.prefix,
                    call.suffix);
                this.reporter().report("{refusal} Write {spelling}.", at);
                return true;
            }
            current = hierarchy.baseOf(current);
        }
        return false;
    }

    analyzeSafeMemberValue(SafeMemberExpressionNode node,
                                   MemberPosition position = MemberPosition.Read) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        if (objectType is ErrorType) {
            return this.store().errorType();
        }
        objectType = narrowing.presenceOperandType(this, node.object(), objectType);
        if (!(objectType is OptionalType)) {
            let spelled = wording.shortSpelling(node.object());
            if (spelled == null) {
                this.reporter().report("The value before '?.' has type '{this.names().of(objectType)}', "
                    + "which can never be null, so it needs no '?.'. Write '.' instead.", node.span());
            } else {
                this.reporter().report("'{spelled}' has type '{this.names().of(objectType)}', which can "
                    + "never be null, so it needs no '?.'. Write '{spelled}.{node.member().text()}'.",
                    node.span());
            }
            return this.store().errorType();
        }
        Type inner = objectType.inner();
        if (inner is OptionalType) {
            this.reporter().report(nullguidance.withGuidance(this, "'?.' checks for one level of null, but "
                + "the value on its left has type '{this.names().of(objectType)}', which can be null at more "
                + "than one level.", nullguidance.nullGuidance(this, node.object(), objectType,
                wording.optionalLevels(objectType) - 1)), node.span());
            return this.store().errorType();
        }
        string name = node.member().text();
        if ((inner is StringType || inner is ArrayType) && name == "length") {
            if (position == MemberPosition.Write) {
                this.reportLengthAssignment(inner, node.object(), node.member().span());
                return this.store().errorType();
            }
            return this.safeResultOf(this.store().primitive(PrimitiveKind.Long));
        }
        if (!isRecordLike(inner)) {
            string shownInner = this.names().of(inner);
            this.reporter().report("{wording.sideNamed(node.object(), "The value before '?.'")} has type "
                + "'{this.names().of(objectType)}', and {typenames.typeArticle(shownInner)} '{shownInner}' "
                + "has no members to read with '?.'.", node.span());
            return this.store().errorType();
        }
        switch (this.lookupMember(inner, name)) {
            is FieldMember found -> {
                if (!this.checkMemberAccess(name, found.field.visibility(),
                        found.field.definingType(), node.member().span())) {
                    this.result().markMemberAccessDenied(node.green());
                }
                return this.safeResultOf(found.field.type());
            },
            is MethodMember found -> {
                if (found.candidates.length() <= 1) {
                    let single = found.candidates.get(0);
                    this.checkMemberAccess(name, single.visibility(), single.definingType(),
                        node.member().span());
                }
                this.result().setMethod(node.green(), found.candidates.get(0));
                if (position != MemberPosition.Covered) {
                    this.reportMethodAsValue(name, inner, found.candidates, node.object(), "?.", position,
                        node.member().span());
                }
                return this.store().errorType();
            },
            is MissingMember ignored -> {
                if (this.reportStaticThroughInstance(inner, name, node.object(), node.member().span())) {
                    return this.store().errorType();
                }
                if (this.reportUnmetConstraintMember(inner, name, node.member().span())) {
                    return this.store().errorType();
                }
                this.reporter().report("Type '{this.names().of(inner)}' has no field or method named "
                    + "'{name}'.", node.member().span());
                return this.store().errorType();
            },
        }
    }

    // A module-qualified name written where a value, a call or a member head belongs, with 'head'
    // the module as this file writes it. A module name reaches only that module's functions, so a
    // type of that module is refused here whatever follows it.
    analyzeNamespaceMemberValue(MemberExpressionNode node, string targetPath, string head,
                                FunctionType? wanted) -> Type {
        string name = node.member().text();
        Span memberSpan = node.member().span();
        let found = this.store().findDeclared(targetPath, name);
        if (found == null) {
            this.reportNamespaceMember(targetPath, head, name, memberSpan, wanted);
            return this.store().errorType();
        }
        if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
                this.modulePath(), this.packagePrefix())) {
            this.reporter().report(types.notVisibleMessage("Type", name, found.visibility(),
                found.modulePath(), found.packagePrefix(), this.packagePrefix()), memberSpan);
            return this.store().errorType();
        }
        this.reporter().report(typenames.moduleQualifiedTypeMessage("{head}.{name}", found, this.names()),
            node.span());
        return this.store().errorType();
    }

    // A module-qualified name in a value position that names no type of that module. 'head' is
    // the module as this file writes it, which a call in the message has to keep, and 'wanted' is
    // the function type expected where the name is written.
    reportNamespaceMember(string targetPath, string head, string name, Span at, FunctionType? wanted) {
        let target = this.contextsByPath().get(targetPath);
        if (target != null && this.reportNamespaceFunction(target, head, name, at, wanted)) {
            return;
        }
        this.reporter().report("'{name}' is not declared in module '{targetPath}'.", at);
    }

    // Reports a module's function written where a value belongs, or refuses the ones this file
    // cannot reach. True when it reported, false when the module declares no function under the
    // name.
    reportNamespaceFunction(ModuleContext target, string head, string name, Span at,
                            FunctionType? wanted) -> bool {
        let entries = target.functions().entriesNamed(name);
        if (entries == null || entries.length() == 0) {
            return false;
        }
        string targetPath = target.module().canonicalPath();
        string targetPackagePrefix = target.module().packagePrefix();
        let reachable = new List<FunctionEntry>();
        for (let entry in entries) {
            if (types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                    this.modulePath(), this.packagePrefix())) {
                reachable.push(entry);
            }
        }
        if (reachable.length() == 0) {
            this.reporter().report(types.notVisibleMessage("Function", name,
                entries.get(0).visibility(), targetPath, targetPackagePrefix,
                this.packagePrefix()), at);
            return true;
        }
        this.reportFunctionAsValue("{head}.{name}", reachable, at, head, wanted);
        return true;
    }

    // The enum a member access's head names, or null where the head names anything else.
    enumTypeNamed(NameResolution? resolution) -> EnumType? {
        if (resolution is TypeName) {
            let target = resolution.target;
            if (target is EnumType) {
                return target;
            }
        }
        return null;
    }

    // ---- Static members ----

    // What a member access's written head names when it is a type rather than a value: the
    // declared type of a bare name, the instantiation of a 'Name<Args>' head, or a type
    // parameter, which the static paths then reject by name. Null when the head is a value (or
    // a namespace or enum, which the callers handled first); the error type when the head named
    // a type but its arguments did not resolve, after a diagnostic.
    resolveStaticHead(Expression object) -> Type? {
        switch (object) {
            is IdentifierExpressionNode identifier -> {
                return this.staticHeadNamed(identifier.name().text());
            },
            is GenericNameExpressionNode generic -> {
                return this.resolveGenericHead(generic);
            },
            default -> {
                return null;
            },
        }
    }

    // The type a bare head name stands for: a primitive's own keyword names the primitive, and
    // unqualified resolution decides the rest, so a local or a module function of that name
    // leaves no type head. A type parameter in scope stands for itself. Enums stay with the
    // enum-member path.
    staticHeadNamed(string name) -> Type? {
        if (name.length == 0) {
            return null;
        }
        let primitive = types.primitiveNamed(this.store(), name);
        if (primitive != null) {
            return primitive;
        }
        let resolution = this.resolveName(name);
        if (resolution is TypeParameterName) {
            return resolution.parameter;
        }
        if (resolution is TypeName && !(resolution.target is EnumType)) {
            return resolution.target;
        }
        return null;
    }

    // A 'Name<Args>' head: the name must be a generic type visible in this file, and the written
    // arguments instantiate it, bounds checked by the resolver.
    resolveGenericHead(GenericNameExpressionNode generic) -> Type? {
        let head = generic.head();
        if (!(head is IdentifierExpressionNode)) {
            this.reporter().report("Type arguments go after a type's name, and "
                + "{wording.sideNamed(head, "this expression")} is not one.", generic.typeArguments().span());
            return this.store().errorType();
        }
        string name = head.name().text();
        let named = this.staticHeadNamed(name);
        string written = wording.greenSpelling(generic.typeArguments().green());
        if (named == null) {
            let resolution = this.resolveName(name);
            if (resolution == null) {
                string importFix = "Check the spelling, or import it.";
                let module = this.standardModuleExporting(name);
                if (module != null) {
                    importFix = "Check the spelling, or import it, as in 'import {name} from @{module};'.";
                }
                this.reporter().report("Undefined name '{name}'. {importFix}", head.span());
            } else if (resolution is TypeName) {
                this.reporter().report("Type '{name}' is not generic, so it takes no type arguments. Remove "
                    + "'{written}'.", generic.typeArguments().span());
            } else if (resolution is LocalName) {
                this.reporter().report("'{name}' is a value, not a type, so it cannot take type arguments.",
                    head.span());
            } else if (resolution is FunctionName) {
                this.reporter().report("'{name}' is a function, not a type, so it cannot take type "
                    + "arguments.", head.span());
            } else {
                this.reporter().report("'{name}' is not a type, so it cannot take type arguments.",
                    head.span());
            }
            return this.store().errorType();
        }
        if (named is TypeParamType) {
            return named;
        }
        if (named is DeclaredType) {
            if (!named.isGeneric()) {
                this.reporter().report("Type '{name}' is not generic, so it takes no type arguments. Remove "
                    + "'{written}'.", generic.typeArguments().span());
                return this.store().errorType();
            }
            Type instantiated = this.resolver().instantiateGeneric(named, name,
                generic.typeArguments(), generic.span());
            if (!(instantiated is ErrorType)) {
                this.result().setType(generic.green(), instantiated);
            }
            return instantiated;
        }
        return this.store().errorType();
    }

    // The module of the standard library that exports a type named 'name', or null when none or more
    // than one of the modules in this program does.
    standardModuleExporting(string name) -> string? {
        string? found = null;
        for (let context in this.contextsByPath().values()) {
            string path = context.module().canonicalPath();
            if (!path.startsWith("std.")) {
                continue;
            }
            let declared = context.declarations().typeNamed(name);
            if (declared == null || declared.visibility() != Visibility.Export) {
                continue;
            }
            if (found != null) {
                return null;
            }
            found = path;
        }
        return found;
    }

    // Refuses 'written', a static named after the type parameter 'parameter'.
    reportTypeParameterHead(TypeParamType parameter, string written, Span at) {
        string name = parameter.name();
        this.reporter().report(this.typeParameterMessage(parameter, "'{written}' names a static member "
            + "through the type parameter '{name}', and '{name}' is a different type each time it is used, "
            + "so '{written}' does not name one static member. Write the type's own name instead.",
            NamePosition.MemberHead), at);
    }

    // A member read whose head is a type name: a static const resolves to its constant value, a
    // static method is refused as a name that is not a value, and everything else explains where
    // the member actually is declared.
    analyzeStaticMemberValue(MemberExpressionNode node, Expression object, Type head,
                             MemberPosition position = MemberPosition.Read,
                             FunctionType? wanted = null) -> Type {
        if (head is ErrorType) {
            return this.store().errorType();
        }
        if (head is TypeParamType) {
            this.reportTypeParameterHead(head, wording.oneLineSpelling(node), node.span());
            return this.store().errorType();
        }
        this.result().setType(object.green(), head);
        string name = node.member().text();
        let owner = types.authorityOf(head);
        if (owner == null || typemembers.staticFieldsOf(head) == null) {
            this.reportStaticsUnsupported(head, name, node.span());
            return this.store().errorType();
        }
        let field = members.findField(typemembers.staticFieldsOf(head), name);
        if (field != null) {
            this.checkMemberAccess(name, field.visibility(), field.definingType(),
                node.member().span());
            this.result().setStaticConstField(node.green(), field);
            return narrowing.narrowedFieldType(this, node, field.type());
        }
        let statics = this.availableStatics(head, name);
        if (statics.length() > 0) {
            // A head written with type arguments keeps them, so the call this names resolves
            // the way the written head did.
            string ownerName = this.names().nameOf(owner);
            if (head is InstantiationType) {
                ownerName = this.names().of(head);
            }
            string subject = "'{name}' is a static method of '{ownerName}'";
            if (wanted != null && position == MemberPosition.Read) {
                let fix = this.lambdaFix("method", name, this.reachedSignatures(statics, wanted), wanted,
                    this.names().plainNameOf(owner));
                this.reporter().report(functionValueRefusal(subject, fix, "{ownerName}.{name}"),
                    node.member().span());
                return this.store().errorType();
            }
            string call = methodCallText("{ownerName}.{name}", statics);
            this.reporter().report(methodAsValueMessage(subject, call, position), node.member().span());
            return this.store().errorType();
        }
        this.reportMissingStatic(head, owner, name, node.member().span(), -1, wanted);
        return this.store().errorType();
    }

    // Interfaces and external types carry no statics, and neither does a primitive the standard
    // library declares no members for. An enum never reaches here, because its own member lookup
    // resolves first.
    reportStaticsUnsupported(Type head, string name, Span at) {
        string shown = this.names().of(head);
        if (types.isDecimalType(head)) {
            this.reporter().report("'decimal' is a reserved word and not a usable type yet. Use 'double' for "
                + "fractional values, or an integer scaled by hand (a 'long' count of cents, say) where the "
                + "value has to be exact.", at);
            return;
        }
        if (head is StringType || head is PrimitiveType) {
            this.reporter().report("'{shown}' has no static members. Call '{name}' on a value of "
                + "type '{shown}' instead.", at);
            return;
        }
        this.reporter().report(typenames.noStaticMembersMessage(head, name, this.names()), at);
    }

    // The member is not a static of the named type: an instance member is reached through a
    // value, a base class's static through the base's own name, and anything else is unknown.
    // 'argumentCount' is -1 for a read, and 'wanted' is the function type a read is expected to have.
    reportMissingStatic(Type head, DeclaredType owner, string name, Span at, long argumentCount = -1,
                        FunctionType? wanted = null) {
        let member = this.lookupMember(head, name);
        if (!(member is MissingMember)) {
            string ownerShown = this.names().nameOf(owner);
            string use = "Call '{name}' on";
            if (member is FieldMember) {
                use = "Read '{name}' from";
            }
            this.reporter().report("'{name}' belongs to each '{ownerShown}' value, not to the type "
                + "'{ownerShown}', so it is used through a value. {use} a value of type '{ownerShown}'.", at);
            return;
        }
        Type? current = hierarchy.baseOf(head);
        while (current != null) {
            let field = members.findField(typemembers.staticFieldsOf(current), name);
            let statics = staticsNamed(current, name);
            if (field != null || statics.length() > 0) {
                let declaring = types.authorityOf(current);
                if (declaring == null) {
                    return;
                }
                Type spelledHead = declaring;
                if (field == null) {
                    spelledHead = staticMethodHead(current, declaring);
                }
                string followUp = "";
                string message = "";
                LambdaFix? fix = null;
                if (field == null && argumentCount < 0 && wanted != null) {
                    fix = this.lambdaFix("method", name, this.reachedSignatures(statics, wanted), wanted,
                        this.names().plainNameOf(declaring));
                }
                if (fix != null && fix.fit != LambdaFit.Called) {
                    string spelling = typenames.qualifiedMemberSpelling(spelledHead, name, this.names(),
                        fix.before, fix.after);
                    string fixText = nameNotValueText(fix, spelling);
                    followUp = "{typenames.staticNotInheritedLead(declaring, this.names())}. {fixText}";
                    message = "{typenames.staticNotInheritedReason(name, declaring, this.names())} {fixText}";
                } else {
                    // A method's name is not a value, so a read of static methods is spelled as a call.
                    string prefix = "";
                    string suffix = "";
                    if (field == null && argumentCount < 0) {
                        let call = new StaticCallText(statics);
                        prefix = call.prefix;
                        suffix = call.suffix;
                    }
                    followUp = typenames.staticNotInheritedFollowUp(name, declaring, spelledHead,
                        this.names(), prefix, suffix);
                    message = typenames.staticNotInheritedMessage(name, declaring, spelledHead, this.names(),
                        prefix, suffix);
                }
                if (field != null && !this.checkMemberAccess(name, field.visibility(),
                        field.definingType(), at, followUp)) {
                    return;
                }
                if (field == null
                        && !this.checkStaticsAccess(name, statics, argumentCount, at, followUp, wanted)) {
                    return;
                }
                if (field == null) {
                    message = message + this.usableOverloadsNote(name, statics, argumentCount, wanted);
                }
                this.reporter().report(message, at);
                return;
            }
            current = hierarchy.baseOf(current);
        }
        if (this.reportFirstUnmet(this.missingConditional(staticsNamed(head, name)), at)) {
            return;
        }
        this.reporter().report("Type '{this.names().nameOf(owner)}' has no static member '{name}'.", at);
    }

    // The static methods of 'statics' that a call with 'argumentCount' arguments can reach, -1 for a
    // read, or all of them when it reaches none. A read expected to have the function type 'wanted'
    // reaches the ones a lambda of that type can call.
    reachedOverloads(List<Method> statics, long argumentCount, FunctionType? wanted = null) -> List<Method> {
        let reached = new List<Method>();
        for (let method in statics) {
            bool reaches = argumentCount < 0 || takesArgumentCount(method, argumentCount);
            if (wanted != null) {
                reaches = fitsFunctionType(method.signature(), wanted.parameterTypes(), wanted.returnType());
            }
            if (reaches) {
                reached.push(method);
            }
        }
        if (reached.length() == 0) {
            return statics;
        }
        return reached;
    }

    // Whether code here can use one of the static methods 'statics' named 'name' that the call can
    // reach, reporting the refusal when it can use none. A single reached method is named by its
    // parameter types when the others have another visibility.
    checkStaticsAccess(string name, List<Method> statics, long argumentCount, Span at,
                       string followUp, FunctionType? wanted = null) -> bool {
        let reached = this.reachedOverloads(statics, argumentCount, wanted);
        for (let method in reached) {
            if (this.isAccessAllowed(method.visibility(), method.definingType())) {
                return true;
            }
        }
        let first = reached.get(0);
        for (let method in reached) {
            if (method.visibility() != first.visibility()) {
                this.reportUnusableOverloads(name, reached, argumentCount, at, followUp);
                return false;
            }
        }
        string shown = name;
        for (let method in statics) {
            if (method.visibility() != first.visibility()) {
                shown = this.overloadSpelling(name, first);
            }
        }
        this.checkMemberAccess(shown, first.visibility(), first.definingType(), at, followUp);
        return false;
    }

    // The sentence, opening with a space, that names the reached overloads of 'name' code here can
    // use when the call can also mean one it cannot, or empty when it can use every reached one.
    usableOverloadsNote(string name, List<Method> statics, long argumentCount,
                        FunctionType? wanted = null) -> string {
        let usable = new List<string>();
        let reached = this.reachedOverloads(statics, argumentCount, wanted);
        for (let method in reached) {
            if (this.isAccessAllowed(method.visibility(), method.definingType())) {
                usable.push(this.overloadSpelling(name, method));
            }
        }
        if (usable.length() == reached.length()) {
            return "";
        }
        string taking = this.takingPhrase(reached, argumentCount);
        return " Of the '{name}' methods{taking}, code here can use only {wording.quotedList(usable)}.";
    }

    // The signatures of the static methods of 'statics' a lambda given 'wanted' can call, the ones code
    // here can use first.
    reachedSignatures(List<Method> statics, FunctionType wanted) -> Signature[] {
        let usable = new List<Signature>();
        let others = new List<Signature>();
        for (let method in this.reachedOverloads(statics, -1, wanted)) {
            if (this.isAccessAllowed(method.visibility(), method.definingType())) {
                usable.push(method.signature());
            } else {
                others.push(method.signature());
            }
        }
        for (let signature in others) {
            usable.push(signature);
        }
        return usable.toArray();
    }

    // ' that take 1 argument' where every method of 'reached' takes the call's 'argumentCount'
    // arguments, and empty for a read and where the call reaches none of them.
    takingPhrase(List<Method> reached, long argumentCount) -> string {
        if (argumentCount < 0) {
            return "";
        }
        for (let method in reached) {
            if (!takesArgumentCount(method, argumentCount)) {
                return "";
            }
        }
        if (argumentCount == 1) {
            return " that take 1 argument";
        }
        return " that take {argumentCount} arguments";
    }

    // One overload of the static method 'name', by its parameter types: 'name(int, string)'.
    overloadSpelling(string name, Method method) -> string {
        let parameterTypes = new List<string>();
        for (let parameter in method.signature().parameters()) {
            parameterTypes.push(this.names().of(parameter.type()));
        }
        return "{name}({string.joined(parameterTypes.toArray(), ", ")})";
    }

    // The refusal of the static methods 'reached' named 'name' when a call can mean any of them, code
    // here can use none, and their visibilities differ. Each is named with what keeps it out of reach.
    reportUnusableOverloads(string name, List<Method> reached, long argumentCount, Span at,
                            string followUp) {
        let defining = reached.get(0).definingType();
        string owner = this.names().of(defining);
        string kind = "type";
        let authority = types.authorityOf(defining);
        if (authority != null) {
            owner = authority.name();
            kind = typenames.kindWordOf(authority);
        }
        string fix = "export";
        string packageName = "its own package";
        if (authority != null) {
            if (authority.packagePrefix() == this.packagePrefix()) {
                fix = "public";
            }
            if (authority.packagePrefix().length > 0) {
                packageName = "package '{authority.packagePrefix()}'";
            }
        }
        string listed = "";
        for (long i = 0; i < reached.length(); i++) {
            let method = reached.get(i);
            string reason = "is private to '{owner}'";
            if (method.visibility() == Visibility.Protected) {
                reason = "is 'protected' in '{owner}'";
            } else if (method.visibility() == Visibility.Public) {
                reason = "is public inside {packageName} but not exported";
            }
            if (i > 0 && i == reached.length() - 1) {
                listed = listed + " and ";
            } else if (i > 0) {
                listed = listed + ", ";
            }
            listed = listed + "'{this.overloadSpelling(name, method)}' {reason}";
        }
        string taking = this.takingPhrase(reached, argumentCount);
        this.reporter().report("None of the '{name}' methods of {kind} '{owner}'{taking} can be used here: "
            + "{listed}. Mark the one you want to use '{fix}'. {followUp}", at);
    }

    // A call whose head is a type name: 'List<int>.withCapacity(8)', 'List.of(items)', or
    // 'Path.parse(text)'. A concrete head resolves like any single-receiver call; a bare
    // generic head first determines the type arguments from the call's own arguments and the
    // expected type, the same two sources a generic function call and an aggregate literal use.
    analyzeStaticCall(CallExpressionNode node, MemberExpressionNode member, Type head,
                      Type? expected) -> Type {
        let arguments = node.arguments();
        if (head is ErrorType) {
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (head is TypeParamType) {
            this.reportTypeParameterHead(head, wording.oneLineSpelling(member), node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        this.result().setType(member.object().green(), head);
        string name = member.member().text();
        let owner = types.authorityOf(head);
        if (owner == null || typemembers.staticFieldsOf(head) == null) {
            this.reportStaticsUnsupported(head, name, node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let writtenOnMethod = node.typeArguments();
        if (writtenOnMethod != null) {
            string written = wording.greenSpelling(writtenOnMethod.green());
            if (owner.isGeneric()) {
                string listed = concreteTypeArguments(owner.typeParameters().length);
                if (writtenOnMethod.argumentsCount() == owner.typeParameters().length) {
                    listed = written.substring(1, written.length - 1);
                }
                this.reporter().report("Type arguments are never written after a method name. Write them "
                    + "after the type name, as in '{this.names().nameOf(owner)}<{listed}>.{name}"
                    + "{argumentsSpelling(arguments)}'.", writtenOnMethod.span());
            } else {
                this.reporter().report("Type arguments are never written after a method name, and "
                    + "'{this.names().nameOf(owner)}' is not generic. Remove '{written}'.",
                    writtenOnMethod.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let constField = members.findField(typemembers.staticFieldsOf(head), name);
        if (constField != null) {
            this.reporter().report("'{this.names().nameOf(owner)}.{name}' is a "
                + "{members.typeLevelFieldWord(constField)}, not a method. Remove the "
                + "parentheses.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (head is DeclaredType && head.isGeneric()) {
            return this.analyzeInferredStaticCall(node, member, head, name, expected);
        }
        let allCandidates = staticsNamed(head, name);
        let candidates = this.existingOnly(allCandidates);
        if (candidates.length() < allCandidates.length()
                && this.reportUnmetConstraintCall(allCandidates, candidates, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (candidates.length() == 0) {
            this.reportMissingStatic(head, owner, name, member.member().span(),
                arguments.argumentsCount());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        return this.finishStaticCall(node, member, name, candidates);
    }

    // Resolves a static call against a concrete owner, mirroring finishMethodCall: overloads
    // and named arguments through full resolution, the single candidate checked directly.
    finishStaticCall(CallExpressionNode node, MemberExpressionNode member, string name,
                     List<Method> candidates) -> Type {
        let arguments = node.arguments();
        if (candidates.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, candidates.length() == 1);
            let callCandidates = new List<CallCandidate>();
            for (long i = 0; i < candidates.length(); i++) {
                let candidate = candidates.get(i);
                callCandidates.push(new CallCandidate(candidate.signature(), candidate,
                    this.isAccessAllowed(candidate.visibility(), candidate.definingType())));
            }
            let resolved = calls.resolveCall(callCandidates, built.shape, this.reporter(),
                node.span(), name, "Method", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store().errorType();
            }
            let chosenMethod = chosen.method();
            if (chosenMethod != null) {
                if (!chosen.isAccessible()) {
                    this.checkMemberAccess(name, chosenMethod.visibility(),
                        chosenMethod.definingType(), member.member().span());
                }
                this.result().setMethod(member.green(), chosenMethod);
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        let single = candidates.get(0);
        this.checkMemberAccess(name, single.visibility(), single.definingType(),
            member.member().span());
        this.result().setMethod(member.green(), single);
        return this.checkDirectArguments("Method", name, single.signature(), arguments,
            node.span());
    }

    // A static call on a generic type written without its type arguments. Each candidate infers
    // them independently: from the arguments whose parameter is exactly one of the type's own
    // parameters (the generic-function rule), then from the expected type when it is an
    // instantiation of the same template. Explicit arguments never reach here; they resolve on
    // the type name.
    analyzeInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                              DeclaredType template, string name, Type? expected) -> Type {
        let arguments = node.arguments();
        let templateStatics = typemembers.staticMethodsOf(template);
        if (templateStatics == null) {
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let indexes = new List<long>();
        for (long i = 0; i < templateStatics.length(); i++) {
            if (templateStatics.get(i).name() == name) {
                indexes.push(i);
            }
        }
        if (indexes.length() == 0) {
            this.reportMissingStatic(template, template, name, member.member().span(),
                arguments.argumentsCount());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (usesNamedArguments(arguments)) {
            string templateName = this.names().nameOf(template);
            string listed = concreteTypeArguments(template.typeParameters().length);
            string example = "'{templateName}<{listed}>.{name}{argumentsSpelling(arguments)}'";
            let open = openTypeParameter(template, templateStatics, indexes);
            if (open.length > 0) {
                this.reporter().report("When the type arguments of '{templateName}' come from the arguments, "
                    + "the call cannot name its arguments, and no argument gives '{open}' a type. Write the "
                    + "type arguments after '{templateName}', as in {example}.", node.span());
            } else {
                this.reporter().report("When the type arguments of '{templateName}' come from the arguments, "
                    + "the call cannot name its arguments. Pass the arguments in order, or write the type "
                    + "arguments after '{templateName}', as in {example}.", node.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let argumentTypes = new List<Type>();
        bool refusedArgument = false;
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type analyzed = this.analyzeExpression(argument);
                refusedArgument = refusedArgument || analyzed is ErrorType;
                argumentTypes.push(analyzed);
            } else {
                argumentTypes.push(this.store().errorType());
            }
        }
        let owner = template.declaration();
        TypeParamType[] typeParameters = template.typeParameterTypes();
        long arity = typeParameters.length;
        Type[] contextArguments = [];
        if (expected != null) {
            Type core = convert.coreOf(expected);
            if (core is InstantiationType && core.template() == template) {
                contextArguments = core.arguments();
            }
        }
        let completedIndexes = new List<long>();
        let completedArguments = new List<Type[]>();
        let completedInferences = new List<TypeArgumentInference>();
        for (long c = 0; c < indexes.length(); c++) {
            let inference = this.inferTypeArguments(templateStatics.get(indexes.get(c)), owner,
                arity, argumentTypes, contextArguments);
            let inferred = inference.bindings();
            if (inferred != null) {
                completedIndexes.push(indexes.get(c));
                completedArguments.push(inferred);
                completedInferences.push(inference);
            }
        }
        if (completedIndexes.length() == 0 && refusedArgument) {
            return this.store().errorType();
        }
        if (completedIndexes.length() == 0) {
            string templateName = this.names().nameOf(template);
            this.reporter().report(unshownTypeArguments("'{templateName}'", template.typeParameters(),
                "{templateName}<", ">.{name}{argumentsSpelling(arguments)}", exampleTypeArgument(arguments)),
                node.span());
            return this.store().errorType();
        }
        let boundedIndexes = new List<long>();
        let boundedArguments = new List<Type[]>();
        let boundedInferences = new List<TypeArgumentInference>();
        for (long c = 0; c < completedIndexes.length(); c++) {
            Type[] vector = completedArguments.get(c);
            bool satisfied = true;
            for (long k = 0; k < arity; k++) {
                if (!this.resolver().boundsSatisfied(typeParameters[k], vector)) {
                    satisfied = false;
                }
            }
            if (satisfied && this.unmetStaticConstraint(
                    templateStatics.get(completedIndexes.get(c)), template, vector) != null) {
                satisfied = false;
            }
            if (satisfied) {
                boundedIndexes.push(completedIndexes.get(c));
                boundedArguments.push(vector);
                boundedInferences.push(completedInferences.get(c));
            }
        }
        if (boundedIndexes.length() == 0) {
            Type[] vector = completedArguments.get(0);
            bool declaredHold = true;
            for (long k = 0; k < arity; k++) {
                if (!this.resolver().checkArgumentBounds(typeParameters[k], vector,
                        node.span())) {
                    declaredHold = false;
                }
            }
            if (declaredHold) {
                let candidate = templateStatics.get(completedIndexes.get(0));
                let failed = this.unmetStaticConstraint(candidate, template, vector);
                if (failed != null) {
                    this.reporter().report(this.unmetConstraintMessage(candidate, template,
                        vector, failed), node.span());
                }
            }
            return this.store().errorType();
        }
        if (boundedIndexes.length() == 1) {
            return this.checkInferredStaticCall(node, member, template,
                boundedIndexes.get(0), boundedArguments.get(0), argumentTypes,
                templateStatics.get(boundedIndexes.get(0)), boundedInferences.get(0));
        }
        return this.selectInferredStaticCall(node, member, template, name, boundedIndexes,
            boundedArguments, argumentTypes);
    }

    // The first constraint a conditional static fails at this inferred type-argument vector, or
    // null for an unconditional or satisfied candidate; the candidate is only a candidate where
    // it exists.
    unmetStaticConstraint(Method candidate, DeclaredType template, Type[] vector)
            -> FailedConstraint? {
        if (!candidate.isConditional()) {
            return null;
        }
        return hierarchy.firstFailedConstraint(this.store(), candidate, template, vector,
            this.resolver().activeConstraintOwner(), this.resolver().activeConstraints());
    }

    // The arguments fill what they can and the expected type fills the rest. A slot neither
    // fills leaves the inference incomplete and fails the candidate.
    inferTypeArguments(Method candidate, GreenNode owner, long arity, List<Type> argumentTypes,
                       Type[] contextArguments) -> TypeArgumentInference {
        let inference = new TypeArgumentInference(this.store(), owner, arity);
        Parameter[] parameters = candidate.signature().parameters();
        for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
            inference.unifyArgument(i, parameters[i].type(), argumentTypes.get(i));
        }
        for (long i = 0; i < arity && i < contextArguments.length; i++) {
            inference.fillFromContext(i, contextArguments[i]);
        }
        return inference;
    }

    // The single inferred candidate: instantiate, then check the arguments against the
    // substituted signature the way a generic function call does, without re-analyzing them.
    checkInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                            DeclaredType template, long staticIndex, Type[] typeArguments,
                            List<Type> argumentTypes, Method templateCandidate,
                            TypeArgumentInference inference) -> Type {
        if (!this.resolver().acceptsKeyType(template, typeArguments, node.span())) {
            return this.store().errorType();
        }
        let instantiation = this.store().instantiationOf(template, typeArguments);
        this.resolver().recordInstantiationMention(instantiation, node.span());
        let resolved = this.staticAtIndex(instantiation, staticIndex);
        if (resolved == null) {
            return this.store().errorType();
        }
        this.result().setType(member.object().green(), instantiation);
        this.checkMemberAccess(resolved.name(), resolved.visibility(),
            resolved.definingType(), member.member().span());
        this.result().setMethod(member.green(), resolved);
        let signature = resolved.signature();
        Parameter[] parameters = signature.parameters();
        let arguments = node.arguments();
        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter().report(calls.arityRefusal("Method '{resolved.name()}'", signature, count),
                node.span());
        }
        for (long i = 0; i < count && i < parameters.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type parameterType = parameters[i].type();
                let origin = this.argumentOrigin(argument, signature, i, parameterType);
                this.adaptIntegerLiteral(argument, parameterType, origin);
                literaltyping.adaptCharLiteral(this, argument, parameterType);
                this.adaptFloatLiteral(argument, parameterType, origin);
                Type actual = argumentTypes.get(i);
                let updated = this.result().typeOf(argument.green());
                if (updated != null) {
                    actual = updated;
                }
                if (!(parameterType is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameterType, actual)) {
                    Parameter[] templateParameters = templateCandidate.signature().parameters();
                    string provenance = "";
                    if (i < templateParameters.length) {
                        provenance = inference.provenance(templateParameters[i].type(),
                            this.names().nameOf(template), ".{resolved.name()}(...)", this.names());
                    }
                    string hint = nullguidance.valueAssignabilityHint(this, parameterType, actual, argument);
                    this.reporter().report(argumentMismatch("{i + 1}", "'{resolved.name()}'",
                        parameters[i].name(), parameterType, actual, this.names()) + "{hint}{provenance}",
                        argument.span());
                }
            }
        }
        return signature.returnType();
    }

    // Several candidates inferred complete vectors: rank their substituted signatures over the
    // already-analyzed arguments and let overload resolution pick.
    selectInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                             DeclaredType template, string name, List<long> staticIndexes,
                             List<Type[]> vectors, List<Type> argumentTypes) -> Type {
        let arguments = node.arguments();
        let shape = new CallShape();
        let values = new List<Expression?>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is Expression value -> {
                    Type analyzed = argumentTypes.get(i);
                    let updated = this.result().typeOf(value.green());
                    if (updated != null) {
                        analyzed = updated;
                    }
                    shape.positional().push(this.argumentValueOf("", value, analyzed));
                    values.push(value);
                },
                default -> {
                    shape.markErrorArgument();
                    shape.positional().push(new ArgumentValue("", this.store().errorType(),
                        false, false, 0, false, node.span()));
                    values.push(null);
                },
            }
        }
        let built = new BuiltShape(shape, values);
        let callCandidates = new List<CallCandidate>();
        let resolvedMethods = new List<Method>();
        let resolvedOwners = new List<Type>();
        for (long c = 0; c < staticIndexes.length(); c++) {
            if (!this.resolver().acceptsKeyType(template, vectors.get(c), node.span())) {
                return this.store().errorType();
            }
            let instantiation = this.store().instantiationOf(template, vectors.get(c));
            this.resolver().recordInstantiationMention(instantiation, node.span());
            let resolved = this.staticAtIndex(instantiation, staticIndexes.get(c));
            if (resolved == null) {
                continue;
            }
            resolvedMethods.push(resolved);
            resolvedOwners.push(instantiation);
            callCandidates.push(new CallCandidate(resolved.signature(), resolved,
                this.isAccessAllowed(resolved.visibility(), resolved.definingType())));
        }
        if (callCandidates.length() == 0) {
            return this.store().errorType();
        }
        let resolution = calls.resolveCall(callCandidates, built.shape, this.reporter(),
            node.span(), name, "Method", this.names());
        if (resolution.failed()) {
            return this.store().errorType();
        }
        let chosen = resolution.chosen();
        if (chosen == null) {
            return this.store().errorType();
        }
        let chosenMethod = chosen.method();
        if (chosenMethod != null) {
            for (long c = 0; c < resolvedMethods.length(); c++) {
                if (resolvedMethods.get(c) == chosenMethod) {
                    this.result().setType(member.object().green(), resolvedOwners.get(c));
                }
            }
            if (!chosen.isAccessible()) {
                this.checkMemberAccess(name, chosenMethod.visibility(),
                    chosenMethod.definingType(), member.member().span());
            }
            this.result().setMethod(member.green(), chosenMethod);
        }
        return this.checkResolvedArguments(built, resolution, node.green());
    }

    // The instantiation's static at a template list position; the lists fill in parallel, so
    // a miss is a compiler bug rather than a user error.
    staticAtIndex(InstantiationType instantiation, long index) -> Method? {
        this.store().ensureFilled(instantiation);
        let statics = typemembers.staticMethodsOf(instantiation);
        if (statics == null || index >= statics.length()) {
            panic("Internal: instantiation '{this.names().of(instantiation)}' has no static at "
                + "position {index}");
        }
        return statics.get(index);
    }

    // A 'Name<Args>' head reached as a value: the parser only builds it before a '.', so this
    // is a recovery path, but it still explains itself.
    analyzeGenericNameValue(GenericNameExpressionNode generic) -> Type {
        this.reporter().report("'{wording.oneLineSpelling(generic)}' is a type, not a value. Write one of "
            + "its static members after it.", generic.span());
        return this.store().errorType();
    }

    // ---- Call shapes and argument checking ----

    // With a 'single' candidate, an argument holding a literal too large for 'float' waits for its
    // parameter, so its refusal can name it.
    buildCallShape(ArgumentListNode arguments, bool single) -> BuiltShape {
        let shape = new CallShape();
        let positionalValues = new List<Expression?>();
        let namedValues = new List<Expression?>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    string name = named.name().text();
                    for (long j = 0; j < shape.named().length(); j++) {
                        if (shape.named().get(j).name() == name) {
                            this.reporter().report("Argument '{name}' is named twice in this call. Remove "
                                + "one of the two.", named.name().span());
                            shape.markMalformed();
                            break;
                        }
                    }
                    bool waits = single && carriesOverflowingFloat(named.value());
                    if (needsTargetType(named.value()) || waits) {
                        shape.named().push(this.targetTypedArgument(name, named.value()));
                    } else {
                        bool outerAwaiting = this.targets().awaitingParameter();
                        this.targets().setAwaitingParameter(!single);
                        Type analyzed = this.analyzeExpression(named.value());
                        this.targets().setAwaitingParameter(outerAwaiting);
                        this.result().setType(named.green(), analyzed);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.named().push(this.argumentValueOf(name, named.value(), analyzed));
                    }
                    namedValues.push(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                    shape.markErrorArgument();
                    shape.positional().push(new ArgumentValue("", this.store().errorType(),
                        false, false, 0, false, outArgument.span()));
                    positionalValues.push(null);
                },
                is Expression value -> {
                    if (shape.named().length() > 0 && !shape.isMalformed()) {
                        string move = "";
                        let firstNamed = arguments.arguments(0);
                        for (long j = 0; j < i; j++) {
                            if (arguments.arguments(j) is NamedArgumentNode) {
                                firstNamed = arguments.arguments(j);
                                break;
                            }
                        }
                        let spelledValue = wording.shortSpelling(value);
                        string spelledNamed = argumentSpelling(firstNamed);
                        if (spelledValue != null && spelledNamed.length <= 30) {
                            move = " Move '{spelledValue}' before '{spelledNamed}'.";
                        }
                        this.reporter().report("Positional arguments must come before named ones.{move}",
                            value.span());
                        shape.markMalformed();
                    }
                    if (needsTargetType(value) || (single && carriesOverflowingFloat(value))) {
                        shape.positional().push(this.targetTypedArgument("", value));
                    } else {
                        bool outerAwaiting = this.targets().awaitingParameter();
                        this.targets().setAwaitingParameter(!single);
                        Type analyzed = this.analyzeExpression(value);
                        this.targets().setAwaitingParameter(outerAwaiting);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.positional().push(this.argumentValueOf("", value, analyzed));
                    }
                    positionalValues.push(value);
                },
                default -> { },
            }
        }
        let values = new List<Expression?>();
        for (long i = 0; i < positionalValues.length(); i++) {
            values.push(positionalValues.get(i));
        }
        for (long i = 0; i < namedValues.length(); i++) {
            values.push(namedValues.get(i));
        }
        return new BuiltShape(shape, values);
    }

    // An argument whose type only the parameter it is passed to determines, left unanalyzed until the
    // candidate is chosen.
    targetTypedArgument(string name, Expression value) -> ArgumentValue {
        let argument = new ArgumentValue(name, this.store().errorType(), false, false, 0, false,
            value.span());
        argument.markNeedsTarget();
        return argument;
    }

    argumentValueOf(string name, Expression value, Type analyzed) -> ArgumentValue {
        let literal = literaltyping.intLiteralOf(value);
        if (literal != null) {
            let magnitude = literalvalues.integerMagnitude(literal.value().text());
            if (magnitude != null) {
                return new ArgumentValue(name, analyzed, true, literaltyping.isNegativeLiteral(value),
                    magnitude, false, value.span());
            }
        }
        if (value is LiteralExpressionNode && value.value().kind() == SyntaxKind.CharLiteral) {
            return new ArgumentValue(name, analyzed, false, false,
                literalvalues.charCodepoint(value.value().text()), true, value.span());
        }
        let plain = new ArgumentValue(name, analyzed, false, false, 0, false, value.span());
        let floatLiteral = literaltyping.floatLiteralOf(value);
        if (floatLiteral != null) {
            plain.markFloatLiteral(literalvalues.floatMagnitude(floatLiteral.value().text()));
        }
        return plain;
    }

    // Final argument checking against the chosen candidate: adapt untyped literals to the
    // parameter types and verify assignability, mirroring the single-candidate path.
    checkResolvedArguments(BuiltShape built, CallResolution resolution, GreenNode callNode) -> Type {
        let chosen = resolution.chosen();
        if (chosen == null) {
            return this.store().errorType();
        }
        Parameter[] parameters = chosen.signature().parameters();
        long[] mapping = resolution.mapping();
        let shape = built.shape;
        string constructed = "";
        let method = chosen.method();
        if (method != null && method.isConstructor()) {
            constructed = this.names().of(method.definingType());
        }
        for (long i = 0; i < shape.argumentCount() && i < mapping.length; i++) {
            let argument = shape.argumentAt(i);
            Type parameterType = parameters[mapping[i]].type();
            Type finalType = argument.type();
            let value = built.values.get(i);
            if (value != null) {
                let chosenOrigin = new LiteralOrigin(OriginKind.Parameter, parameters[mapping[i]].name(),
                    chosen.signature().name(), parameterType);
                chosenOrigin.setConstructed(constructed);
                this.targets().chosenParameters().push(new ChosenParameter(value.span(), chosenOrigin));
            }
            if (value != null && argument.needsTarget()) {
                finalType = this.analyzeExpressionAdapt(value, parameterType,
                    this.argumentOrigin(value, chosen.signature(), mapping[i], parameterType, constructed));
            } else if (value != null) {
                let origin = this.argumentOrigin(value, chosen.signature(), mapping[i], parameterType,
                    constructed);
                this.adaptIntegerLiteral(value, parameterType, origin);
                literaltyping.adaptCharLiteral(this, value, parameterType);
                this.adaptFloatLiteral(value, parameterType, origin);
                let updated = this.result().typeOf(value.green());
                if (updated != null) {
                    finalType = updated;
                }
            }
            if (parameterType is ErrorType || finalType is ErrorType) {
                continue;
            }
            if (!convert.isAssignableStrict(parameterType, finalType)) {
                string label = "{i + 1}";
                if (argument.name().length > 0) {
                    label = "'{argument.name()}'";
                }
                string callee = "'{chosen.signature().name()}'";
                if (constructed.length > 0) {
                    callee = "the constructor of '{constructed}'";
                }
                this.reporter().report(argumentMismatch(label, callee, parameters[mapping[i]].name(),
                    parameterType, finalType, this.names())
                    + "{nullguidance.valueAssignabilityHint(this, parameterType, finalType, value)}",
                    argument.span());
            }
        }
        if (shape.named().length() > 0) {
            this.result().setArgumentOrder(callNode, mapping);
        }
        return chosen.signature().returnType();
    }

    // Argument count and type checking against a single known signature. 'constructed' spells the
    // type a constructor builds, with its type arguments.
    checkDirectArguments(string kindWord, string displayName, Signature signature,
                                 ArgumentListNode arguments, Span callSpan,
                                 string constructed = "") -> Type {
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter().report(calls.arityRefusal(calls.calleeSubject(kindWord, displayName), signature,
                count), callSpan);
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i].type();
                        Type actual = this.analyzeExpressionAdapt(value, parameterType,
                            this.argumentOrigin(value, signature, i, parameterType, constructed));
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter().report(argumentMismatch("{i + 1}",
                                calleeObject(kindWord, displayName), parameters[i].name(), parameterType,
                                actual, this.names())
                                + "{nullguidance.valueAssignabilityHint(this, parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return signature.returnType();
    }

    analyzeArgumentsOnly(ArgumentListNode arguments) {
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.analyzeExpression(named.value());
                },
                is Expression value -> {
                    this.analyzeExpression(value);
                },
                default -> { },
            }
        }
    }

    // ---- Calls ----

    // The refusals held inside a call's arguments stay held only for an argument whose type reaches
    // the call's result. The others are reported, since no enclosing join changes their fix.
    analyzeCall(CallExpressionNode node, Type? expected) -> Type {
        let outerDeferred = this.targets().deferredFixes();
        let held = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(held);
        let outerFlowing = this.targets().flowingArguments();
        this.targets().setFlowingArguments(new List<Span>());
        bool outerAwaiting = this.targets().awaitingParameter();
        this.targets().setAwaitingParameter(false);
        let outerChosen = this.targets().chosenParameters();
        this.targets().setChosenParameters(new List<ChosenParameter>());
        Type called = this.analyzeCallOf(node, expected);
        this.noteFlowingMethodArguments(node);
        this.settleParameters(held);
        let flowing = this.targets().flowingArguments();
        this.targets().setFlowingArguments(outerFlowing);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.targets().setChosenParameters(outerChosen);
        this.targets().setDeferredFixes(outerDeferred);
        this.settleArguments(held, outerDeferred, flowing, false);
        return called;
    }

    // Settles the refusals held for arguments of a call with several candidates against the
    // parameter the chosen candidate gave them. Beside a parameter of the literal's type the fix names the
    // parameter, and with no candidate chosen the refusal ends after the why.
    settleParameters(List<DeferredLiteralFix> held) {
        for (let fix in held) {
            if (!fix.awaitingParameter()) {
                continue;
            }
            fix.setAwaitingParameter(false);
            LiteralOrigin? origin = null;
            for (let chosen in this.targets().chosenParameters()) {
                if (fix.span().start >= chosen.span.start && fix.span().end() <= chosen.span.end()) {
                    origin = chosen.origin;
                }
            }
            let suffixed = fix.suffixed();
            if (origin == null) {
                fix.setMessage(fix.plain());
                continue;
            }
            let widening = fix.widening() ?? floatWidening();
            string declared = this.originType(origin);
            if (isFloatCore(origin.declared()) && suffixed != null) {
                string noun = parameterNoun(origin);
                suffixed.setFix("The '{fix.suffix()}' makes the literal a 'float', and {noun} is a "
                    + "'{declared}' too.");
            } else if (sameCore(origin.declared(), widening) && !fix.settled() && fix.clause().length > 0
                    && fix.message() != fix.plain()) {
                fix.setMessage("{fix.refusal()} {fix.clause()}, and {parameterNoun(origin)} is "
                    + "{typenames.typeArticle(declared)} '{declared}' too.");
            } else if (!takesLiteral(origin.declared(), widening)) {
                fix.setMessage(fix.plain());
            }
        }
    }

    // Records the arguments of a method call that reach its result: those whose declared parameter
    // type has a type parameter while the declared return type has one too. A generic instance's
    // methods are judged as its template declares them.
    noteFlowingMethodArguments(CallExpressionNode node) {
        let access = nullguidance.accessStep(wording.unwrapParentheses(node.callee()));
        if (access == null) {
            return;
        }
        let name = access.member();
        Type receiver = convert.coreOf(this.recordedType(access.receiver()));
        if (receiver is InstantiationType) {
            receiver = receiver.template();
        }
        let methods = typemembers.methodsOf(receiver);
        if (name == null || methods == null) {
            return;
        }
        let arguments = node.arguments();
        for (let method in methods) {
            Signature signature = method.signature();
            if (method.name() != name || !convert.containsTypeParam(signature.returnType())) {
                continue;
            }
            Parameter[] parameters = signature.parameters();
            for (long i = 0; i < arguments.argumentsCount(); i++) {
                switch (arguments.arguments(i)) {
                    is NamedArgumentNode named -> {
                        for (let parameter in parameters) {
                            if (parameter.name() == named.name().text()
                                    && convert.containsTypeParam(parameter.type())) {
                                this.targets().flowingArguments().push(named.span());
                            }
                        }
                    },
                    is Expression value -> {
                        if (i < parameters.length && convert.containsTypeParam(parameters[i].type())) {
                            this.targets().flowingArguments().push(value.span());
                        }
                    },
                    default -> { },
                }
            }
        }
    }

    // Passes the refusals held inside a call to 'outer' when they lie in one of the 'flowing'
    // arguments, or in any argument when 'all' is true, and reports the others.
    settleArguments(List<DeferredLiteralFix> held, List<DeferredLiteralFix>? outer, List<Span> flowing,
                    bool all) {
        for (let fix in held) {
            if (outer == null) {
                if (fix.suffixed() == null) {
                    this.reporter().report(fix.message(), fix.span());
                }
                continue;
            }
            bool flows = all;
            for (let argument in flowing) {
                if (fix.span().start >= argument.start && fix.span().end() <= argument.end()) {
                    flows = true;
                }
            }
            if (flows) {
                outer.push(fix);
            } else if (fix.suffixed() == null) {
                this.reporter().report(fix.message(), fix.span());
            }
        }
    }

    analyzeCallOf(CallExpressionNode node, Type? expected) -> Type {
        switch (node.callee()) {
            is MemberExpressionNode member -> {
                return this.analyzeMemberCall(node, member, expected);
            },
            is SafeMemberExpressionNode member -> {
                return this.analyzeSafeMemberCall(node, member);
            },
            is SuperExpressionNode chained -> {
                return this.analyzeSuperCall(node, chained);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeFunctionCall(node, identifier);
            },
            default -> {
                Type calleeType = this.analyzeExpression(node.callee());
                if (convert.coreOf(calleeType) is FunctionType) {
                    return this.analyzeFunctionValueCall(node, calleeType, "",
                        node.callee().span());
                }
                if (!(calleeType is ErrorType)) {
                    this.reporter().report("{wording.sideNamed(node.callee(), "This value")} has type "
                        + "'{this.names().of(calleeType)}', which is not a function type, so it cannot "
                        + "be called.", node.span());
                }
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
        }
    }

    // A call on a function value: ordinary call syntax on the value itself. A function type has
    // no parameter names, so the arguments are positional and the call takes exactly as many as
    // the type declares.
    analyzeFunctionValueCall(CallExpressionNode node, Type calleeType, string calleeName,
                                     Span calleeSpan) -> Type {
        string subject = "This function value";
        if (calleeName.length > 0) {
            subject = "'{calleeName}'";
        }
        let typeArguments = node.typeArguments();
        if (typeArguments != null) {
            this.reporter().report("A function value takes no type arguments; its type "
                + "'{this.names().of(calleeType)}' is already fixed. Remove the '<...>' list.",
                typeArguments.span());
        }
        if (calleeType is OptionalType) {
            this.reporter().report(nullguidance.maybeNullRefusal(this, "{subject} has type "
                + "'{this.names().of(calleeType)}', which", node.callee(), calleeType), calleeSpan);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        if (!(calleeType is FunctionType)) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        Type[] parameters = calleeType.parameterTypes();
        let arguments = node.arguments();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            string[] unnamed = [];
            this.reporter().report(calls.countRefusal("{subject} has type '{this.names().of(calleeType)}', "
                + "so it takes", parameters.length, parameters.length, count, "argument", unnamed),
                node.span());
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.reporter().report("A function type has no parameter names, so a function "
                        + "value takes its arguments by position. Write the values in order, "
                        + "without '{named.name().text()}:'.", named.span());
                    this.analyzeExpression(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i];
                        LiteralOrigin? origin = null;
                        if (mayAdaptLiteral(value)) {
                            origin = new LiteralOrigin(OriginKind.Parameter, "", calleeName, parameterType);
                        }
                        Type actual = this.analyzeExpressionAdapt(value, parameterType, origin);
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter().report(argumentMismatch("{i + 1}",
                                this.functionValueName(calleeName), "", parameterType, actual, this.names())
                                + "{nullguidance.valueAssignabilityHint(this, parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return calleeType.returnType();
    }

    analyzeFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier)
            -> Type {
        string name = identifier.name().text();
        let primitive = types.primitiveNamed(this.store(), name);
        if (primitive != null) {
            this.reportTypeAsCall(name, primitive, identifier.span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            if (this.isRefusedImport(name)) {
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter().report(this.staticWithoutType(name, ownerName, true), identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            let kept = this.preludeScope().hidden(name, this.modulePath(), this.packagePrefix());
            if (kept != null) {
                this.reporter().report(types.notVisibleMessage("Function", name, kept.visibility(),
                    kept.modulePath(), kept.packagePrefix(), this.packagePrefix()),
                    identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            this.reporter().report("Undefined function '{name}'. Check the spelling, or import "
                + "the module that declares it.", identifier.span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        switch (resolution) {
            is FunctionName functions -> {
                let offered = functions.fromPrelude;
                if (offered != null && offered.isAmbiguous()) {
                    this.reporter().report(prelude.ambiguousMessage(name, offered.modulePaths()),
                        identifier.span());
                    this.analyzeArgumentsOnly(node.arguments());
                    return this.store().errorType();
                }
                return this.dispatchFunctionCall(node, identifier, name, functions.entries);
            },
            is TypeName named -> {
                if (types.isStructLike(named.target)) {
                    return this.analyzeStructConstructorCall(node, named.target, name);
                }
                this.reportTypeAsCall(name, named.target, identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is TypeParameterName held -> {
                this.reportTypeParameterRefusal("'{name}' is a type parameter, not a function.",
                    held.parameter, identifier.span(), NamePosition.Call);
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is LocalName ignored -> {
                Type calleeType = this.analyzeExpression(identifier);
                if (convert.coreOf(calleeType) is FunctionType) {
                    return this.analyzeFunctionValueCall(node, calleeType, name,
                        identifier.span());
                }
                if (!(calleeType is ErrorType)) {
                    this.reporter().report("'{name}' has type '{this.names().of(calleeType)}', "
                        + "which is not a function type, so it cannot be called.",
                        identifier.span());
                }
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is NamespaceName module -> {
                this.reportModuleAsCall(name, module.targetModulePath, identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
        }
    }

    dispatchFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier,
                                 string name, List<FunctionEntry> entries) -> Type {
        let first = entries.get(0);
        if (first.isExternal()) {
            this.result().setCallable(identifier.green(), first.signature());
            return this.analyzeExternalCall(node, first, name);
        }
        if (first.signature().isGeneric()) {
            this.result().setCallable(identifier.green(), first.signature());
            return this.analyzeGenericCall(node, first, name);
        }
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments(), entries.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                candidates.push(new CallCandidate(entries.get(i).signature(), null, true));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter(),
                node.span(), name, "Function", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                this.result().setCallable(identifier.green(), chosen.signature());
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        this.result().setCallable(identifier.green(), first.signature());
        return this.checkDirectArguments("Function", name, first.signature(),
            node.arguments(), node.span());
    }

    analyzeMemberCall(CallExpressionNode node, MemberExpressionNode member, Type? expected)
            -> Type {
        let object = member.object();
        string memberName = member.member().text();
        if (object is IdentifierExpressionNode) {
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                let handled = this.analyzeNamespaceFunctionCall(node, member,
                    resolution.targetModulePath, memberName);
                if (handled != null) {
                    return handled;
                }
            }
        }
        let staticHead = this.resolveStaticHead(object);
        if (staticHead != null) {
            return this.analyzeStaticCall(node, member, staticHead, expected);
        }
        let intercepted = this.interceptBuiltinCall(node, object, memberName);
        if (intercepted != null) {
            return intercepted;
        }
        Type memberType = this.analyzeMemberValue(member, MemberPosition.Covered);
        this.result().setType(member.green(), memberType);
        let method = this.result().methodOf(member.green());
        if (method == null) {
            if (convert.coreOf(memberType) is FunctionType) {
                return this.analyzeFunctionValueCall(node, memberType, memberName,
                    member.member().span());
            }
            this.reportUncallableMember(member.green(), member.member().span(), memberName,
                memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(), memberName,
            object, method, false);
    }

    // The member resolved to a value rather than a method: an enum member or a field. The value
    // path reported nothing, because reading the member is fine; only calling it is not.
    reportUncallableMember(GreenNode member, Span span, string name, Type memberType) {
        if (memberType is ErrorType) {
            return;
        }
        if (this.result().memberAccessDeniedAt(member)) {
            return;
        }
        if (memberType is EnumType && this.result().enumConstantOf(member) != null) {
            this.reporter().report("'{name}' is a member of enum '{this.names().nameOf(memberType)}', not a "
                + "method. Remove the parentheses, as in '{this.names().nameOf(memberType)}.{name}'.", span);
            return;
        }
        this.reporter().report("'{name}' is a field of type '{this.names().of(memberType)}', not "
            + "a method. Read it without parentheses.", span);
    }

    analyzeSafeMemberCall(CallExpressionNode node, SafeMemberExpressionNode member)
            -> Type {
        let object = member.object();
        if (object is IdentifierExpressionNode) {
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                this.reporter().report("'{object.name().text()}' is a module name, which is never null, so "
                    + "'?.' cannot follow it. Replace '?.' with '.'.", node.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
        }
        Type memberType = this.analyzeSafeMemberValue(member, MemberPosition.Covered);
        this.result().setType(member.green(), memberType);
        let method = this.result().methodOf(member.green());
        if (method == null) {
            this.reportUncallableMember(member.green(), member.member().span(),
                member.member().text(), memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(),
            member.member().text(), object, method, true);
    }

    // Resolves the method a receiver's call picks: overloads and named arguments go through
    // full resolution; the single-candidate path checks directly. A safe call wraps a
    // non-void result optional.
    finishMethodCall(CallExpressionNode node, GreenNode memberGreen, Span memberSpan,
                             string name, Expression object, Method primary, bool isSafe)
            -> Type {
        Type receiverCore = this.store().errorType();
        let objectType = this.result().typeOf(object.green());
        if (objectType != null) {
            Type receiverType = objectType;
            if (isSafe && receiverType is OptionalType) {
                receiverType = receiverType.inner();
            }
            receiverCore = this.memberReceiverCore(receiverType, name);
        }
        let allCandidates = methodCandidates(receiverCore, name);
        let candidates = this.existingOnly(allCandidates);
        let arguments = node.arguments();
        if (candidates.length() < allCandidates.length()
                && this.reportUnmetConstraintCall(allCandidates, candidates, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (candidates.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, candidates.length() == 1);
            let callCandidates = new List<CallCandidate>();
            for (long i = 0; i < candidates.length(); i++) {
                let candidate = candidates.get(i);
                callCandidates.push(new CallCandidate(candidate.signature(), candidate,
                    this.isAccessAllowed(candidate.visibility(), candidate.definingType())));
            }
            if (callCandidates.length() == 0) {
                callCandidates.push(new CallCandidate(primary.signature(), primary, true));
            }
            let resolved = calls.resolveCall(callCandidates, built.shape, this.reporter(),
                node.span(), name, "Method", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store().errorType();
            }
            let chosenMethod = chosen.method();
            if (chosenMethod != null) {
                if (!chosen.isAccessible()) {
                    this.checkMemberAccess(name, chosenMethod.visibility(),
                        chosenMethod.definingType(), memberSpan);
                }
                this.result().setMethod(memberGreen, chosenMethod);
            }
            Type returned = this.checkResolvedArguments(built, resolved, node.green());
            if (isSafe) {
                return this.wrapSafeResult(returned);
            }
            return returned;
        }
        Type returned = this.checkDirectArguments("Method", name, primary.signature(),
            arguments, node.span());
        if (isSafe) {
            return this.wrapSafeResult(returned);
        }
        return returned;
    }

    // A void safe call is a statement: it runs only when the receiver is non-null and
    // produces no value.
    wrapSafeResult(Type returned) -> Type {
        if (returned is ErrorType || types.isVoidType(returned)) {
            return returned;
        }
        return this.safeResultOf(returned);
    }

    // The type '?.' and '?[' produce. Both produce 'null' when the receiver is absent, and a
    // value that is already nullable carries that result in the level it has: its own null means
    // "nothing here" just as well, so the operator adds no second level and a chain through a
    // nullable member keeps working. This is only about the level these operators add; a value
    // that is doubly nullable is still rejected by the operators themselves.
    safeResultOf(Type value) -> Type {
        if (value is OptionalType) {
            return value;
        }
        return this.store().optionalOf(value);
    }

    // A namespace-qualified free-function call, or null when the member is not a function of
    // the target module (the member then resolves as a type reference).
    analyzeNamespaceFunctionCall(CallExpressionNode node, MemberExpressionNode member,
                                         string targetPath, string memberName) -> Type? {
        let target = this.contextsByPath().get(targetPath);
        if (target == null) {
            return null;
        }
        let entries = target.functions().entriesNamed(memberName);
        if (entries == null || entries.length() == 0) {
            return null;
        }
        string targetPackagePrefix = target.module().packagePrefix();
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments(), entries.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                let entry = entries.get(i);
                candidates.push(new CallCandidate(entry.signature(), null,
                    types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                        this.modulePath(), this.packagePrefix())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter(),
                node.span(), memberName, "Function", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store().errorType();
            }
            this.result().setCallable(member.green(), chosen.signature());
            if (!chosen.isAccessible()) {
                Visibility chosenVisibility = Visibility.Private;
                for (long i = 0; i < entries.length(); i++) {
                    if (entries.get(i).signature() == chosen.signature()) {
                        chosenVisibility = entries.get(i).visibility();
                    }
                }
                this.reporter().report(types.notVisibleMessage("Function", memberName,
                    chosenVisibility, targetPath, targetPackagePrefix, this.packagePrefix()),
                    member.member().span());
                return this.store().errorType();
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        let entry = entries.get(0);
        if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                this.modulePath(), this.packagePrefix())) {
            this.reporter().report(types.notVisibleMessage("Function", memberName,
                entry.visibility(), targetPath, targetPackagePrefix, this.packagePrefix()),
                member.member().span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        this.result().setCallable(member.green(), entry.signature());
        if (entry.isExternal()) {
            return this.analyzeExternalCall(node, entry, memberName);
        }
        if (targetPath == "std.ffi" && memberName == "fromCString") {
            return this.checkFromCStringCall(node.arguments(), node.span());
        }
        if (entry.signature().isGeneric()) {
            return this.analyzeGenericCall(node, entry, memberName);
        }
        return this.checkDirectArguments("Function", memberName, entry.signature(),
            node.arguments(), node.span());
    }

    // std.ffi.fromCString accepts a value of any external type - there is no common supertype to
    // write in its signature, hence the intercepted type parameter - and returns a string?. A null
    // handle yields a null string, so an unset value stays distinct from an empty one. Because the
    // call is checked here it is never routed through generic instantiation.
    checkFromCStringCall(ArgumentListNode arguments, Span callSpan) -> Type {
        Type result = this.store().optionalOf(this.store().stringType());
        long count = arguments.argumentsCount();
        if (count != 1) {
            this.reporter().report(fromCStringCountRefusal(count), callSpan);
            this.analyzeArgumentsOnly(arguments);
            return result;
        }
        switch (arguments.arguments(0)) {
            is OutArgumentNode outArgument -> {
                this.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                Type actual = this.analyzeExpression(value);
                Type base = actual;
                if (base is OptionalType) {
                    base = base.inner();
                }
                if (!(actual is ErrorType) && !(base is ExternalType)) {
                    this.reporter().report("'fromCString' takes a value of an external type, but "
                        + "{wording.sideNamed(value, "this value")} has type '{this.names().of(actual)}'. "
                        + "Pass it the value a C function returned.", value.span());
                }
            },
            default -> { },
        }
        return result;
    }

    analyzeSuperCall(CallExpressionNode node, SuperExpressionNode chained) -> Type {
        this.analyzeExpression(chained);
        this.frame().noteSuperCall();
        Type voidType = this.store().primitive(PrimitiveKind.Void);
        if (!this.frame().inConstructor() && this.frame().thisType() != null) {
            this.reporter().report("'super(...)' can only be called from a constructor.",
                node.span());
        }
        Type? base = null;
        let receiver = this.frame().thisType();
        if (receiver != null) {
            base = hierarchy.baseOf(receiver);
        }
        if (base == null) {
            this.analyzeArgumentsOnly(node.arguments());
            return voidType;
        }
        string baseName = this.names().of(base);
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null) {
            baseName = baseAuthority.name();
        }
        let allConstructors = typemembers.constructorsOf(base);
        let constructors = this.existingOnly(allConstructors);
        let arguments = node.arguments();
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() == 0) {
            if (arguments.argumentsCount() > 0) {
                this.reporter().report("Base class '{baseName}' declares no constructor, so 'super(...)' "
                    + "takes no arguments. Write 'super()', or remove the call.", node.span());
            } else if (this.frame().inConstructor() && receiver != null && allConstructors.length() == 0) {
                this.checkImplicitBaseChain(receiver, null, false, node.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, constructors.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter(),
                node.span(), baseName, "Base constructor", this.names());
            if (resolved.failed()) {
                return voidType;
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                let chosenMethod = chosen.method();
                if (chosenMethod != null) {
                    if (!chosen.isAccessible()) {
                        this.checkConstructorAccess(base, chosenMethod, node.span(), true);
                    }
                    this.result().setMethod(chained.green(), chosenMethod);
                }
                this.checkResolvedArguments(built, resolved, node.green());
            }
            return voidType;
        }
        let baseConstructor = constructors.get(0);
        this.checkConstructorAccess(base, baseConstructor, node.span(), true);
        this.result().setMethod(chained.green(), baseConstructor);
        this.checkDirectArguments("Base constructor", baseName, baseConstructor.signature(),
            arguments, node.span());
        return voidType;
    }

    // The built-in members of strings, arrays, and primitives, intercepted before general
    // member resolution; a record declaring its own member of the same name falls through
    // (null result) to normal resolution, and so does a primitive whose binding declares one.
    interceptBuiltinCall(CallExpressionNode node, Expression object, string name)
            -> Type? {
        if (name != "toString" && name != "slice" && name != "hash") {
            return null;
        }
        Type objectType = this.analyzeExpression(object);
        if (objectType is ErrorType) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        Type core = objectType;
        let arguments = node.arguments();
        if (convert.coreOf(core) is FunctionType) {
            this.analyzeArgumentsOnly(arguments);
            return this.reportFunctionMember(name, core, node.span());
        }
        // The standard library's binding handles a call it declares a member for, so the
        // compiler's own member of that name steps aside there.
        if (this.bindingDeclares(core, name, arguments.argumentsCount(), false)) {
            return null;
        }
        // An optional hashes as its payload does while present, whatever its inner type, so only
        // 'hash' reads through the wrapper here.
        if (core is OptionalType) {
            if (name == "slice" && core.inner() is ArrayType) {
                this.reporter().report(nullguidance.maybeNullRefusal(this, "Cannot call 'slice' on "
                    + "'{this.names().of(core)}' because it", object, core), node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            if (name != "hash") {
                return null;
            }
        }
        if (name == "toString") {
            if (convert.isIntegerType(core) || convert.isBoolType(core) || core is StringType
                    || convert.isEnumLike(core) || isTextualFloat(core)) {
                this.checkNoArguments(node, "toString");
                return this.store().stringType();
            }
            if (types.isDecimalType(core)) {
                this.reporter().report("Internal: 'toString' on 'decimal'.", node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            // A struct whose own toString cannot take this call serializes to its JSON form; one
            // whose toString matches it falls through to normal resolution.
            if (types.isStructLike(core) && !this.declaresToStringFor(core, arguments.argumentsCount())) {
                this.checkNoArguments(node, "toString");
                if (convert.containsTypeParam(core)) {
                    this.recordObligation(new InterpolationObligation(core, node.span()));
                } else {
                    let issue = capabilities.structJsonabilityIssue(core, this.names());
                    if (issue != null) {
                        this.reporter().report(issue, node.span());
                    }
                }
                return this.store().stringType();
            }
            // The call is legal exactly where interpolating the array is.
            if (core is ArrayType) {
                this.checkNoArguments(node, "toString");
                if (convert.containsTypeParam(core)) {
                    this.recordObligation(new InterpolationObligation(core, node.span()));
                } else {
                    let issue = capabilities.interpolationIssue(core, this.names());
                    if (issue != null) {
                        this.reporter().report(issue, node.span());
                    }
                }
                return this.store().stringType();
            }
            // A class or interface value whose chain has no toString for this call produces
            // its runtime type's text form; a chain whose toString matches it falls through to
            // normal resolution.
            if (types.isClassLike(core) && !this.declaresToStringFor(core, arguments.argumentsCount())) {
                this.checkNoArguments(node, "toString");
                return this.store().stringType();
            }
            // A bare type parameter defers the judgment to each instantiation, exactly like a
            // hole; a bound that declares toString resolves the call against the contract.
            if (core is TypeParamType) {
                bool declaresToString = false;
                for (let bound in this.effectiveBoundsOf(core)) {
                    if (anyAcceptsArgumentCount(methodCandidates(bound, "toString"),
                            arguments.argumentsCount())) {
                        declaresToString = true;
                    }
                }
                if (declaresToString) {
                    return null;
                }
                this.checkNoArguments(node, "toString");
                this.recordObligation(new InterpolationObligation(core, node.span()));
                return this.store().stringType();
            }
            return null;
        }
        if (name == "slice") {
            if (core is ArrayType) {
                this.checkRangeArguments(node, "slice");
                return core;
            }
            return null;
        }
        if (types.isVoidType(core)) {
            this.reporter().report("{wording.sideNamed(object, "This call")} returns no value, so there is "
                + "nothing to call 'hash' on.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (!(core is OptionalType) && this.declaresHash(core)) {
            return null;
        }
        this.checkNoArguments(node, "hash");
        this.checkHashable(core, node.span());
        return this.store().primitive(PrimitiveKind.Long);
    }

    // Whether a 'toString' the receiver's chain declares takes a call of this argument count.
    // Only a 'toString' taking no parameters is a type's text form, so a call with no arguments
    // reaches the built-in form past one that takes parameters, and a call carrying arguments
    // reaches that method.
    declaresToStringFor(Type receiver, long argumentCount) -> bool {
        return anyAcceptsArgumentCount(this.availableMethods(receiver, "toString"), argumentCount);
    }

    // Whether the standard library's binding declares a member for a call of this name and argument count
    // itself. A declaration whose parameter list matches the compiler's own member replaces it,
    // and one that differs is an overload the compiler never provided, so both read the same way
    // here: what the binding declares wins, and what it does not the compiler still provides.
    bindingDeclares(Type receiver, string name, long argumentCount, bool isStatic) -> bool {
        let binding = types.bindingOf(receiver);
        if (binding == null) {
            return false;
        }
        let declared = isStatic ? binding.staticMethods() : binding.methods();
        for (long i = 0; i < declared.length(); i++) {
            let signature = declared.get(i).signature();
            if (signature.name() == name && calls.acceptsArgumentCount(signature, argumentCount)) {
                return true;
            }
        }
        return false;
    }

    // Whether a written 'hash' exists on this receiver: a bound of a type parameter, or a member
    // of a record; anything else gets the synthesized content hash.
    declaresHash(Type core) -> bool {
        if (core is TypeParamType) {
            for (let bound in this.effectiveBoundsOf(core)) {
                if (methodCandidates(bound, "hash").length() > 0) {
                    return true;
                }
            }
            return false;
        }
        return isRecordLike(core) && this.availableMethods(core, "hash").length() > 0;
    }

    // The synthesized content hash needs every leaf the receiver folds to have a hash. A receiver
    // mentioning a type parameter is judged per instantiation.
    checkHashable(Type receiver, Span span) {
        if (convert.containsTypeParam(receiver)) {
            this.recordObligation(new HashObligation(receiver, span));
            return;
        }
        let issue = capabilities.hashabilityIssue(receiver, this.names());
        if (issue != null) {
            this.reporter().report(issue, span);
        }
    }

    checkNoArguments(CallExpressionNode node, string name) {
        if (node.arguments().argumentsCount() > 0) {
            string[] unnamed = [];
            this.reporter().report(calls.countRefusal("'{name}' takes", 0, 0,
                node.arguments().argumentsCount(), "argument", unnamed), node.span());
            this.analyzeArgumentsOnly(node.arguments());
        }
    }

    // Array slicing takes a start and an end index.
    checkRangeArguments(CallExpressionNode node, string name) {
        let arguments = node.arguments();
        if (arguments.argumentsCount() != 2) {
            this.reporter().report(calls.countRefusal("'{name}' takes", 2, 2, arguments.argumentsCount(),
                "argument", ["start", "end"]), node.span());
            this.analyzeArgumentsOnly(arguments);
            return;
        }
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type actual = this.analyzeExpression(argument);
                if (!(actual is ErrorType) && !convert.isIntegerType(actual)) {
                    this.reporter().report("'{name}' takes integer indexes, but "
                        + "{wording.sideNamed(argument, "this index")} has type '{this.names().of(actual)}'.",
                        argument.span());
                }
            }
        }
    }

    analyzeGenericCall(CallExpressionNode node, FunctionEntry entry, string name) -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        Parameter[] declared = signature.parameters();
        bool genericResult = convert.containsTypeParam(signature.returnType());
        for (long i = 0; i < arguments.argumentsCount() && i < declared.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression && genericResult && convert.containsTypeParam(declared[i].type())) {
                this.targets().flowingArguments().push(argument.span());
            }
        }
        if (usesNamedArguments(arguments)) {
            this.reporter().report("'{name}' is generic, and a call to a generic function cannot name its "
                + "arguments. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
                node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let owner = signature.declaration();
        if (owner == null) {
            return signature.returnType();
        }
        let typeParameters = signature.typeParameters();
        long arity = typeParameters.length;
        let typeArguments = new List<Type?>();
        for (long i = 0; i < arity; i++) {
            typeArguments.push(null);
        }
        let explicitList = node.typeArguments();
        if (explicitList != null) {
            long given = explicitList.argumentsCount();
            if (given != arity) {
                let names = new List<string>();
                for (let parameter in typeParameters) {
                    names.push(parameter.name());
                }
                this.reporter().report(calls.countRefusal("Generic function '{name}' takes", arity, arity,
                    given, "type argument", names.toArray()), node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            for (long i = 0; i < arity; i++) {
                typeArguments.set(i, this.resolver().resolveType(explicitList.arguments(i)));
            }
        }

        // A value with no type of its own, a lambda or an aggregate literal, waits for the
        // parameter it fills, which is known once the type arguments are resolved. It offers
        // nothing to infer them from either.
        let argumentTypes = new List<Type>();
        bool refusedArgument = false;
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression && !waitsForParameter(argument, explicitList != null)) {
                Type analyzed = this.analyzeExpression(argument);
                refusedArgument = refusedArgument || analyzed is ErrorType;
                argumentTypes.push(analyzed);
            } else {
                argumentTypes.push(this.store().errorType());
            }
        }

        Parameter[] parameters = signature.parameters();
        let inference = new TypeArgumentInference(this.store(), owner, arity);
        if (explicitList == null) {
            for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
                inference.unifyArgument(i, parameters[i].type(), argumentTypes.get(i));
            }
            for (long i = 0; i < arity; i++) {
                typeArguments.set(i, inference.binding(i));
            }
        }

        let resolved = new List<Type>();
        for (long i = 0; i < arity; i++) {
            let argument = typeArguments.get(i);
            if (argument == null && refusedArgument) {
                return this.store().errorType();
            }
            if (argument == null) {
                let written = new List<string>();
                for (long j = 0; j < arity; j++) {
                    let known = typeArguments.get(j);
                    if (known != null && this.names().canSpell(known)) {
                        written.push(this.names().of(known));
                    } else {
                        written.push(exampleTypeArgument(node.arguments()));
                    }
                }
                string listed = "";
                for (long j = 0; j < written.length(); j++) {
                    if (j > 0) {
                        listed = listed + ", ";
                    }
                    listed = listed + written.get(j);
                }
                string write = "Write it";
                if (arity > 1) {
                    write = "Write its type arguments";
                }
                this.reporter().report("'{name}' is generic, and this call does not show what its type "
                    + "argument '{typeParameters[i].name()}' is. {write}, as in "
                    + "'{name}<{listed}>{argumentsSpelling(node.arguments())}'.", node.span());
                return this.store().errorType();
            }
            resolved.push(argument);
        }
        Type[] resolvedArguments = resolved.toArray();

        bool bounded = true;
        for (long i = 0; i < arity; i++) {
            Span at = node.span();
            if (explicitList != null && i < explicitList.argumentsCount()) {
                at = explicitList.arguments(i).span();
            }
            if (!this.resolver().checkArgumentBounds(typeParameters[i], resolvedArguments, at)) {
                bounded = false;
            }
        }

        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter().report(calls.arityRefusal("Function '{name}'", signature, count), node.span());
            bounded = false;
        }
        for (long i = 0; i < count && i < parameters.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type parameterType = this.store().substitute(parameters[i].type(), owner,
                    resolvedArguments);
                Type actual = argumentTypes.get(i);
                let origin = this.argumentOrigin(argument, signature, i, parameterType);
                if (waitsForParameter(argument, explicitList != null)) {
                    actual = this.analyzeExpressionAdapt(argument, parameterType, origin);
                } else {
                    this.adaptIntegerLiteral(argument, parameterType, origin);
                    this.adaptFloatLiteral(argument, parameterType, origin);
                    let updated = this.result().typeOf(argument.green());
                    if (updated != null) {
                        actual = updated;
                    }
                }
                if (!(parameterType is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameterType, actual)) {
                    string provenance = "";
                    if (explicitList == null) {
                        provenance = inference.provenance(parameters[i].type(), name, "(...)", this.names());
                    }
                    string hint = nullguidance.valueAssignabilityHint(this, parameterType, actual, argument);
                    this.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameters[i].name(),
                        parameterType, actual, this.names()) + "{hint}{provenance}", argument.span());
                }
            }
        }

        if (bounded) {
            this.result().setCallTypeArguments(node.green(), resolvedArguments);
            this.recordGenericCall(signature, resolvedArguments, node.span());
        }
        return this.store().substitute(signature.returnType(), owner, resolvedArguments);
    }

    // An external call: exact arity, no named arguments, and 'out' parameters take an
    // initialized non-constant local of exactly the parameter's type.
    analyzeExternalCall(CallExpressionNode node, FunctionEntry entry, string name)
            -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        if (usesNamedArguments(arguments)) {
            this.reporter().report("External function '{name}' takes its arguments by position, so a call "
                + "cannot name them. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
                node.span());
            this.analyzeArgumentsOnly(arguments);
            return signature.returnType();
        }
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            this.reporter().report(calls.arityRefusal("External function '{name}'", signature, count),
                node.span());
        }
        for (long i = 0; i < count; i++) {
            let argument = arguments.arguments(i);
            if (i >= parameters.length) {
                this.analyzeExtraExternalArgument(argument);
                continue;
            }
            let parameter = parameters[i];
            if (parameter.isOut()) {
                if (argument is OutArgumentNode) {
                    this.checkOutArgument(argument, parameter, name, i);
                } else if (argument is Expression) {
                    string example = "out result";
                    if (parameter.name().length > 0) {
                        example = "out {parameter.name()}";
                    }
                    string fix = "Declare a local variable and write 'out' before it, as in '{example}'.";
                    if (wording.unwrapParentheses(argument) is IdentifierExpressionNode) {
                        fix = "Write 'out {wording.oneLineSpelling(wording.unwrapParentheses(argument))}'.";
                    }
                    this.reporter().report("{parameterSubject(parameter, i)} of '{name}' is an 'out' "
                        + "parameter, so it needs a variable to store into. {fix}", argument.span());
                    this.analyzeExpression(argument);
                }
                continue;
            }
            if (argument is OutArgumentNode) {
                this.reporter().report("{parameterSubject(parameter, i)} of '{name}' is not an 'out' "
                    + "parameter. Remove 'out' from '{wording.greenSpelling(argument.green())}'.",
                    argument.span());
                continue;
            }
            if (argument is Expression) {
                Type actual = this.analyzeExpressionAdapt(argument, parameter.type(),
                    this.argumentOrigin(argument, signature, i, parameter.type()));
                if (!(parameter.type() is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameter.type(), actual)) {
                    this.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameter.name(),
                        parameter.type(), actual, this.names())
                        + "{nullguidance.valueAssignabilityHint(this, parameter.type(), actual, argument)}",
                        argument.span());
                }
            }
        }
        return signature.returnType();
    }

    checkOutArgument(OutArgumentNode argument, Parameter parameter, string name, long index) {
        string outName = argument.name().text();
        let binding = this.lookupBinding(outName);
        if (binding == null) {
            string shownType = this.names().of(parameter.type());
            string declare = "Declare it first as a local variable of type '{shownType}'.";
            if (convert.isNumericType(parameter.type())) {
                declare = "Declare it first, as in '{shownType} {outName} = 0;'.";
            }
            this.reporter().report("'{outName}' in 'out {outName}' is not a local variable or a parameter. "
                + declare, argument.span());
            return;
        }
        if (binding.isConst()) {
            this.reporter().report(this.constantRefusal("Cannot pass '{outName}' as 'out'", binding),
                argument.span());
        }
        this.result().setBinding(argument.green(), binding);
        if (binding.type() != parameter.type()) {
            string wanted = this.names().of(parameter.type());
            this.reporter().report("{parameterSubject(parameter, index)} of '{name}' is 'out {wanted}', but "
                + "'{outName}' has type '{this.names().of(binding.type())}'. Pass a variable of "
                + "type '{wanted}'.", argument.span());
            return;
        }
        // 'out' lets the callee write the caller's variable directly, so it drops even the
        // binding's own narrowing.
        this.narrowingState.clearForRoot(binding);
    }

    analyzeExtraExternalArgument(Argument argument) {
        switch (argument) {
            is OutArgumentNode outArgument -> {
                let binding = this.lookupBinding(outArgument.name().text());
                if (binding != null) {
                    this.result().setBinding(outArgument.green(), binding);
                }
            },
            is Expression value -> {
                this.analyzeExpression(value);
            },
            default -> { },
        }
    }

    // ---- 'new' expressions ----

    // analyzeCall for a 'new' expression. The arguments of a generic type's constructor reach the
    // object it builds.
    analyzeNew(NewExpressionNode node) -> Type {
        let outerDeferred = this.targets().deferredFixes();
        let held = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(held);
        bool outerAwaiting = this.targets().awaitingParameter();
        this.targets().setAwaitingParameter(false);
        let outerChosen = this.targets().chosenParameters();
        this.targets().setChosenParameters(new List<ChosenParameter>());
        Type created = this.analyzeNewOf(node);
        this.settleParameters(held);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.targets().setChosenParameters(outerChosen);
        this.targets().setDeferredFixes(outerDeferred);
        bool generic = convert.coreOf(created) is InstantiationType;
        this.settleArguments(held, outerDeferred, new List<Span>(), generic);
        return created;
    }

    analyzeNewOf(NewExpressionNode node) -> Type {
        let created = node.createdType();
        if (node.dimensionsCount() > 0) {
            return this.analyzeArrayNew(node, created);
        }
        if (created is OptionalTypeNode) {
            this.reporter().report("'new' always produces a value, so its type cannot be nullable. Remove "
                + "the '?'.", created.span());
        }
        Type t = this.resolver().resolveType(created);
        if (t is OptionalType) {
            t = t.inner();
        }
        let arguments = node.arguments();
        if (t is ErrorType) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store().errorType();
        }
        string shownName = writtenTypeName(created, t, this.names());
        if (!types.isClassLike(t)) {
            if (types.isStructLike(t)) {
                this.reportNewOnStruct(node, t, shownName);
            } else {
                this.reporter().report("'new' creates an object of a class, and '{this.names().of(t)}' is "
                    + "not a class.", node.span());
            }
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store().errorType();
        }
        let authority = types.authorityOf(t);
        // A type nothing can instantiate has already been reported as such, so the constructor's
        // own visibility is not checked: widening it would not make the type instantiable.
        bool uninstantiable = false;
        if (authority is InterfaceType) {
            this.reporter().report("Cannot create an instance of interface '{shownName}'. Create "
                + "one of a class that implements it.", node.span());
            uninstantiable = true;
        } else if (authority is ClassType && authority.isAbstract()) {
            this.reporter().report("Cannot create an instance of abstract class '{shownName}'. "
                + "Create one of a subclass that is not abstract.", node.span());
            uninstantiable = true;
        }
        let allConstructors = typemembers.constructorsOf(t);
        let constructors = this.existingOnly(allConstructors);
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return t;
        }
        if (allConstructors.length() == 0) {
            let blocked = this.excludedImplicitBaseConstructor(t);
            if (blocked != null) {
                string clause = this.excludedConstructorClause(blocked, this.currentMemberWord());
                if (clause.length > 0) {
                    string owner = this.names().of(blocked.definingType());
                    string needs = "so it needs the zero-argument constructor of its base class '{owner}'";
                    let direct = hierarchy.baseOf(t);
                    if (direct != null && direct != blocked.definingType()) {
                        needs = "and neither does its base class '{this.names().of(direct)}', so it needs "
                            + "the zero-argument constructor of '{owner}'";
                    }
                    this.reporter().report("Cannot construct '{shownName}'. It declares no constructor, "
                        + "{needs}. " + clause, node.span());
                    if (arguments != null) {
                        this.analyzeArgumentsOnly(arguments);
                    }
                    return t;
                }
            }
        }
        long argumentCount = 0;
        if (arguments != null) {
            argumentCount = arguments.argumentsCount();
        }
        bool named = arguments != null && usesNamedArguments(arguments);
        if (constructors.length() > 1 || (constructors.length() > 0 && named)) {
            let built = this.buildShapeOrEmpty(arguments);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter(),
                node.span(), shownName, "Constructor", this.names());
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible() && !uninstantiable) {
                            this.checkConstructorAccess(t, chosenMethod, node.span());
                        }
                        this.result().setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
        } else if (constructors.length() > 0) {
            let classConstructor = constructors.get(0);
            if (!uninstantiable) {
                this.checkConstructorAccess(t, classConstructor, node.span());
            }
            this.result().setMethod(node.green(), classConstructor);
            if (arguments != null) {
                this.checkDirectArguments("Constructor", shownName,
                    classConstructor.signature(), arguments, node.span(), this.names().of(t));
            }
        } else if (argumentCount > 0) {
            this.reporter().report("Class '{shownName}' declares no constructor, so 'new {shownName}(...)' "
                + "takes no arguments. Write 'new {shownName}()'.", node.span());
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
        }
        return t;
    }

    buildShapeOrEmpty(ArgumentListNode? arguments) -> BuiltShape {
        if (arguments != null) {
            return this.buildCallShape(arguments, false);
        }
        return new BuiltShape(new CallShape(), new List<Expression?>());
    }

    // 'new T[n]': every allocated slot starts as T's zero value, so T must be defaultable -
    // unless a fill loop right after the declaration proves every slot is written first, or
    // the trailing dimensions are unsized and the slots hold nullable inner arrays.
    analyzeArrayNew(NewExpressionNode node, TypeNode created) -> Type {
        Type element = this.resolver().resolveType(created);
        let sizes = new List<Expression>();
        long unsized = 0;
        for (long i = 0; i < node.dimensionsCount(); i++) {
            let size = node.dimensions(i).size();
            if (size != null && unsized == 0) {
                sizes.push(size);
            } else {
                unsized++;
            }
        }
        if (element is ErrorType) {
            this.analyzeSizes(sizes);
            return this.store().errorType();
        }
        if (types.isVoidType(element)) {
            this.reporter().report("Cannot create an array of 'void', because 'void' means no value.",
                created.span());
            this.analyzeSizes(sizes);
            return this.store().errorType();
        }
        if (sizes.length() == 0) {
            string shown = this.names().of(element);
            this.reporter().report("'new {shown}[...]' needs at least one size. Write "
                + "'new {shown}[size]' for one row, or 'new {shown}[size][]' for a grid whose "
                + "rows are filled later.", node.span());
            return this.store().arrayOf(element);
        }
        Type slotElement = element;
        if (unsized == 0) {
            // A canonical fill loop assigns every slot whatever the element type turns out to be,
            // so the proof holds for a type parameter as much as for a reference.
            bool singleDimension = sizes.length() == 1;
            bool proven = singleDimension && this.fillProvenNews.contains(node.green());
            string fillName = "items";
            let declared = this.arrayNewNames.get(node.green());
            if (declared != null) {
                fillName = declared;
            }
            if (!proven && !this.validateArrayElement(element, created.span(),
                    singleDimension, fillName)) {
                this.analyzeSizes(sizes);
                return this.store().errorType();
            }
        } else {
            Type innerArray = element;
            for (long i = 0; i < unsized; i++) {
                innerArray = this.store().arrayOf(innerArray);
            }
            slotElement = this.store().optionalOf(innerArray);
        }
        this.analyzeSizes(sizes);
        Type arrayType = slotElement;
        for (long i = 0; i < sizes.length(); i++) {
            arrayType = this.store().arrayOf(arrayType);
        }
        return arrayType;
    }

    analyzeSizes(List<Expression> sizes) {
        for (long i = 0; i < sizes.length(); i++) {
            Type sizeType = this.analyzeExpression(sizes.get(i));
            if (!(sizeType is ErrorType) && !convert.isIntegerType(sizeType)) {
                this.reporter().report("The size of an array must be an integer, but "
                    + "{wording.sideNamed(sizes.get(i), "the size")} has type '{this.names().of(sizeType)}'.",
                    sizes.get(i).span());
            }
        }
    }

    // An element type that mentions a type parameter settles nothing here about whether a freshly
    // allocated slot is a valid value, so the judgment waits for the concrete arguments of every
    // instantiation that occurs. The raw store is the one type where slots holding no value is
    // the point; see @std.collections.rawarray.
    validateArrayElement(Type element, Span span, bool hasFillName, string fillName)
            -> bool {
        if (element is ErrorType) {
            return false;
        }
        if (convert.containsTypeParam(element)) {
            if (!this.inRawStorageAllocator()) {
                this.recordObligation(new ArrayElementObligation(element, span));
            }
            return true;
        }
        let issue = capabilities.arrayElementIssue(element, hasFillName, fillName, this.names());
        if (issue == null) {
            return true;
        }
        this.reporter().report(issue, span);
        return false;
    }

    inRawStorageAllocator() -> bool {
        return this.modulePath() == "std.collections.rawarray" && this.obligationOwnerName == "RawArray";
    }

    // Records single-dimension array-new declaration initializers (for diagnostic wording)
    // and proves the ones immediately followed by their canonical fill loop.
    noteArrayFillLoop(BlockNode block, long index) {
        let statement = block.statements(index);
        if (statement is VariableDeclarationNode) {
            let initializer = statement.initializer();
            if (initializer == null) {
                return;
            }
            let value = initializer.value();
            if (value is NewExpressionNode) {
                if (value.dimensionsCount() != 1 || value.dimensions(0).size() == null) {
                    return;
                }
                string name = statement.name().text();
                if (name.length == 0) {
                    return;
                }
                this.arrayNewNames.set(value.green(), name);
                if (index + 1 >= block.statementsCount()) {
                    return;
                }
                let next = block.statements(index + 1);
                if (next is ForStatementNode && isArrayFillLoop(next, name)) {
                    this.fillProvenNews.add(value.green());
                }
            }
        }
    }

    // ---- Switch arms ----

    // A switch used as a value. The target is the type its arms are checked against, and is null where the
    // surroundings offer none.
    analyzeSwitchExpression(SwitchExpressionNode node, Type? target, LiteralOrigin? origin = null) -> Type {
        let scope = this.targets().beginJoin(node, false);
        Type analyzed = this.analyzeSwitchValues(node, target, origin);
        this.endJoin(node, scope);
        return analyzed;
    }

    analyzeSwitchValues(SwitchExpressionNode node, Type? target, LiteralOrigin? origin) -> Type {
        Type? fixTarget = target;
        LiteralOrigin? fixOrigin = origin;
        if (target == null && this.targets().joinNode() == node.green()) {
            fixTarget = this.targets().joinTarget();
            fixOrigin = this.targets().joinOrigin();
        }
        this.targets().clearStash();
        return this.checkSwitchArms(node.scrutinee(), armsOfExpression(node),
            node.switchKeyword().span(), true, target, fixOrigin, fixTarget);
    }

    // Checks a switch in either form: the scrutinee kind, the labels or 'is' arm targets, arm
    // reachability, exhaustiveness, and the unified value type of the expression form.
    // Exhaustiveness reasons over the unwrapped scrutinee type; a scrutinee whose
    // narrowing-aware type is still nullable additionally needs a 'null' arm or a default.
    checkSwitchArms(Expression scrutinee, List<SwitchArm> arms, Span span,
                            bool requireValue, Type? armTargetType, LiteralOrigin? origin = null,
                            Type? fixTarget = null) -> Type {
        Type scrutineeType = this.analyzeExpression(scrutinee);
        Type inner = convert.bareOf(scrutineeType);
        bool doublyNullable = !(scrutineeType is ErrorType) && inner is OptionalType;
        if (doublyNullable) {
            this.reporter().report(nullguidance.withGuidance(this, "Cannot switch on a value of type "
                + "'{this.names().of(scrutineeType)}': a 'null ->' arm covers one level of null, "
                + "and this value may be null at more than one.", nullguidance.nullGuidance(this, scrutinee,
                scrutineeType, wording.optionalLevels(scrutineeType) - 1)), scrutinee.span());
        }
        bool known = !(scrutineeType is ErrorType) && !doublyNullable;
        bool classScrutinee = known && types.isClassLike(inner);
        bool valueScrutinee = known && (inner is EnumType || convert.isIntegerType(inner)
            || inner is StringType);
        bool typeSwitch = classScrutinee && hasTypeArm(arms);
        if (known) {
            if (classScrutinee && !typeSwitch) {
                this.reporter().report("A switch over a class value needs at least one "
                    + "'is Type ->' arm.", scrutinee.span());
            } else if (!classScrutinee && !valueScrutinee) {
                this.reporter().report("Cannot switch on {wording.sideNamed(scrutinee, "this value")}, "
                    + "because its type '{this.names().of(scrutineeType)}' is not an enum, an integer, a "
                    + "string or a class. Compare it with 'if' and 'else' instead.", scrutinee.span());
            }
        }

        bool hasDefault = false;
        bool nullCovered = false;
        let coveredEnumOrdinals = new Set<long>();
        let seenIntegerLabels = new Set<long>();
        let seenStringLabels = new Set<string>();
        let armTargets = new List<Type>();
        bool everyValueArm = false;
        let valueExpressions = new List<Expression>();
        bool sawValueBlock = false;
        let switchEntry = this.assignment().snapshot();
        let entryLayers = this.narrowingState.snapshotLayers();
        let entryFacts = this.narrowingState.flatten();
        let armFlows = new List<AssignmentFlow>();
        let armNarrowings = new List<Map<NarrowingPath, Type>>();
        let valueArms = new List<SwitchArm>();
        bool deferLiterals = requireValue && armTargetType != null && hasTypedArm(arms);
        let outerDeferred = this.targets().deferredFixes();
        let armDeferred = new List<List<DeferredLiteralFix>>();
        let armValues = new List<Expression?>();
        for (long a = 0; a < arms.length(); a++) {
            long sunk = valueExpressions.length();
            if (requireValue) {
                let held = new List<DeferredLiteralFix>();
                armDeferred.push(held);
                this.targets().setDeferredFixes(held);
            }
            this.assignment().restore(switchEntry);
            this.narrowingState.restoreLayers(entryLayers);
            this.assignment().setUnconditionalPosition(true);
            switch (arms.get(a)) {
                is DefaultArmNode arm -> {
                    if (hasDefault) {
                        this.reporter().report("A switch can have only one 'default' arm.",
                            arm.span());
                    }
                    hasDefault = true;
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                },
                is TypeArmNode arm -> {
                    Type armType = this.resolver().resolveType(arm.target());
                    this.result().setType(arm.target().green(), armType);
                    Type? armTarget = null;
                    if (!classScrutinee) {
                        if (valueScrutinee) {
                            this.reporter().report("An 'is' arm needs a class switch value, but "
                                + "this switch is over '{this.names().of(scrutineeType)}'.",
                                arm.target().span());
                        }
                    } else if (!(armType is ErrorType)) {
                        armTarget = this.checkTypeArmTarget(scrutineeType, inner, armType,
                            arm.target().span(), scrutinee, arm.body(), armTargets.length() == 0);
                        if (armTarget == null && matchesEveryValue(inner, armType)) {
                            everyValueArm = true;
                        }
                    }
                    if (armTarget != null) {
                        this.checkTypeArmReachable(armTarget, armTargets, arm.target().span());
                        armTargets.push(armTarget);
                    }
                    this.enterScope();
                    let bindingToken = arm.binding();
                    if (bindingToken != null) {
                        Type bindingType = this.store().errorType();
                        if (armTarget != null) {
                            bindingType = armTarget;
                        }
                        let binding = new LocalBinding(bindingToken.text(), bindingType,
                            BindingKind.Variable, true, bindingToken.span());
                        this.armBindings.push(binding);
                        let current = this.scope;
                        if (current != null) {
                            current.define(binding);
                        }
                        this.result().setBinding(arm.green(), binding);
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                    this.leaveScope();
                },
                is ValueArmNode arm -> {
                    bool mixReported = false;
                    for (long i = 0; i < arm.labelsCount(); i++) {
                        let label = arm.labels(i);
                        if (isNullLabel(label)) {
                            this.result().setType(label.green(), this.store().nullType());
                            if (!(scrutineeType is OptionalType)) {
                                string removal = "Remove this arm.";
                                if (arm.labelsCount() > 1) {
                                    removal = "Remove the 'null' label.";
                                }
                                this.reporter().report(
                                    "{wording.sideNamed(scrutinee, "The value of this switch")} "
                                    + "has type '{this.names().of(scrutineeType)}', which can never be null, "
                                    + "so a 'null' arm never runs. {removal}", label.span());
                            } else if (nullCovered) {
                                this.reporter().report("This switch already has a 'null' arm. Remove this "
                                    + "second one.", label.span());
                            } else {
                                nullCovered = true;
                            }
                            continue;
                        }
                        if (typeSwitch) {
                            if (!mixReported) {
                                this.reporter().report("Cannot mix value labels with 'is' arms "
                                    + "in the same switch.", label.span());
                                mixReported = true;
                            }
                            continue;
                        }
                        if (!valueScrutinee) {
                            continue;
                        }
                        if (inner is EnumType) {
                            this.checkEnumLabel(label, inner, coveredEnumOrdinals);
                        } else if (convert.isIntegerType(inner)) {
                            this.checkIntegerLabel(label, inner, seenIntegerLabels);
                        } else {
                            this.checkStringLabel(label, seenStringLabels);
                        }
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                },
                // Dropped before the walk begins; the case is here because the arm kinds are
                // checked for exhaustiveness.
                is ErrorSwitchArmNode ignored -> { },
            }
            Expression? armValue = null;
            if (valueExpressions.length() > sunk) {
                valueArms.push(arms.get(a));
                armValue = valueExpressions.get(valueExpressions.length() - 1);
            }
            armValues.push(armValue);
        }
        this.targets().setDeferredFixes(outerDeferred);
        for (long a = 0; a < armDeferred.length(); a++) {
            Expression? neighbour = null;
            Type neighbourType = this.store().errorType();
            for (long b = 0; b < armValues.length(); b++) {
                let value = armValues.get(b);
                bool nullable = value != null && isNullableNumber(this.recordedType(value));
                if (b != a && value != null && neighbour == null && nullable) {
                    neighbour = value;
                    neighbourType = this.recordedType(value);
                }
            }
            this.settleDeferred(armDeferred.get(a), neighbour, neighbourType, "the arm");
        }
        if (armFlows.length() > 0) {
            this.assignment().restore(this.assignment().join(armFlows));
        } else {
            this.assignment().restore(switchEntry);
        }

        this.narrowingState.restoreLayers(entryLayers);
        let survivors = new List<Map<NarrowingPath, Type>>();
        for (long i = 0; i < armFlows.length(); i++) {
            if (!armFlows.get(i).terminated()) {
                survivors.push(armNarrowings.get(i));
            }
        }
        narrowing.applyNarrowingJoin(this, entryFacts, survivors);

        // A switch used as a value with no arm, a type switch whose every arm is refused and one with an
        // arm refused for matching every value get no refusal of a missing arm.
        if (valueScrutinee && !hasDefault && (arms.length() > 0 || !requireValue)) {
            this.checkValueExhaustiveness(inner, coveredEnumOrdinals, span);
        }
        if (typeSwitch && !hasDefault && armTargets.length() > 0 && !everyValueArm) {
            this.checkTypeExhaustiveness(inner, armTargets, span);
        }
        if ((valueScrutinee || typeSwitch) && scrutineeType is OptionalType && !nullCovered && !hasDefault) {
            this.reporter().report("{wording.sideNamed(scrutinee, "The value of this switch")} can be null, "
                + "and no arm of this switch matches null. Add a 'null ->' arm or a 'default' arm.", span);
        }
        if (!requireValue) {
            return this.store().primitive(PrimitiveKind.Void);
        }
        if (sawValueBlock) {
            return this.store().errorType();
        }
        if (valueExpressions.length() == 0) {
            this.reporter().report("A switch used as a value needs at least one arm.", span);
            return this.store().errorType();
        }
        this.noteSuffixedArms(valueExpressions, valueArms, armTargetType ?? fixTarget, origin);
        if (deferLiterals && armTargetType != null
                && !this.adaptLiteralArms(valueExpressions, valueArms, armTargetType, origin)) {
            return this.store().errorType();
        }
        Type unified = this.store().errorType();
        for (long i = 0; i < valueExpressions.length(); i++) {
            let expression = valueExpressions.get(i);
            Type analyzed = this.recordedType(expression);
            if (analyzed is ErrorType) {
                return this.store().errorType();
            }
            if (i == 0) {
                unified = analyzed;
                continue;
            }
            JoinText? fix = null;
            let widening = this.joinWidening(expression, unified, this.targets().joinRoot());
            if (widening != null) {
                LiteralOrigin? fixOrigin = null;
                if (fixTarget != null) {
                    fixOrigin = origin;
                }
                fix = this.switchArmFix(valueExpressions, valueArms, i, unified, fixTarget, fixOrigin,
                    widening);
            }
            this.targets().setBesideLiteral(fix == null);
            bool refused = this.adaptIntegerLiteral(expression, unified, null, fix) is ErrorType
                || this.adaptFloatLiteral(expression, unified, null, fix) is ErrorType;
            this.targets().setBesideLiteral(false);
            if (refused) {
                return this.store().errorType();
            }
            Type adapted = this.recordedType(expression);
            if (!(adapted is ErrorType)) {
                analyzed = adapted;
            }
            let joined = convert.unifyValueTypes(unified, analyzed, this.store());
            if (joined == null) {
                this.holdMismatch("Switch arms produce '{this.names().of(unified)}' and "
                    + "'{this.names().of(analyzed)}', which have no common type. Give every arm "
                    + "the same type.", span);
                return this.store().errorType();
            }
            unified = joined;
        }
        if (types.isVoidType(unified)) {
            string arm = "{wording.armHead(valueArms.get(0))} -> "
                + "{wording.oneLineSpelling(valueExpressions.get(0))}";
            string named = "an arm";
            if (arm.length <= wording.quotedCodeLimit()) {
                named = "the arm '{arm}'";
            }
            this.reporter().report("This switch is used as a value, but {named} gives no value. Give every "
                + "arm a value.", span);
            return this.store().errorType();
        }
        for (long i = 0; i < valueExpressions.length(); i++) {
            this.adaptIntegerLiteral(valueExpressions.get(i), unified);
            this.adaptFloatLiteral(valueExpressions.get(i), unified);
        }
        return unified;
    }

    // Adapts the literal arms analyzed without the target, or returns false when a literal does not
    // fit. A floating-point literal takes the type of the other arms when it is a floating-point one,
    // and an integer literal after an arm with a type of its own the type the arms before it join to
    // when it is an integer one; either takes the target otherwise.
    adaptLiteralArms(List<Expression> values, List<SwitchArm> arms, Type target,
                     LiteralOrigin? origin) -> bool {
        Type? typed = this.typedArmsJoin(values);
        if (typed is ErrorType) {
            return true;
        }
        Type? before = null;
        bool typedBefore = false;
        for (long i = 0; i < values.length(); i++) {
            let value = values.get(i);
            if (!isUntypedNumberLiteral(value)) {
                before = this.joinedBefore(before, this.recordedType(value));
                typedBefore = true;
                continue;
            }
            if (literaltyping.floatLiteralOf(wording.unwrapParentheses(value)) == null) {
                Type? adaptedInteger = null;
                if (typedBefore && before != null && joinsLiteral(value, before)) {
                    JoinText? fix = null;
                    let widening = this.joinWidening(value, before, this.targets().joinRoot());
                    if (widening != null) {
                        fix = this.switchArmFix(values, arms, i, before, target, origin, widening);
                    }
                    // With no arm of the joined type before it, that type is the target's, and so is
                    // the literal's refusal.
                    LiteralOrigin? through = null;
                    if (fix == null) {
                        through = origin;
                    }
                    adaptedInteger = this.adaptIntegerLiteral(value, before, through, fix);
                } else {
                    adaptedInteger = this.adaptIntegerLiteral(value, target, origin)
                        ?? this.adaptFloatLiteral(value, target, origin);
                }
                if (adaptedInteger is ErrorType) {
                    return false;
                }
                before = this.joinedBefore(before, this.recordedType(value));
                continue;
            }
            Type? adapted = null;
            if (typed != null && joinsLiteral(value, typed)) {
                JoinText? fix = null;
                let widening = this.joinWidening(value, typed, this.targets().joinRoot());
                if (widening != null) {
                    fix = this.switchArmFix(values, arms, values.length(), typed, target, origin, widening);
                }
                adapted = this.adaptIntegerLiteral(value, typed, null, fix)
                    ?? this.adaptFloatLiteral(value, typed, null, fix);
            } else {
                adapted = this.adaptIntegerLiteral(value, target, origin)
                    ?? this.adaptFloatLiteral(value, target, origin);
            }
            if (adapted is ErrorType) {
                return false;
            }
            before = this.joinedBefore(before, this.recordedType(value));
        }
        return true;
    }

    // The type the arm values so far join to once 'next' joins them, or null when they have none.
    joinedBefore(Type? before, Type next) -> Type? {
        if (next is ErrorType) {
            return before;
        }
        if (before == null) {
            return next;
        }
        return convert.unifyValueTypes(before, next, this.store());
    }

    // The type the arm values that are not untyped number literals join to, or null when they have
    // no common type.
    typedArmsJoin(List<Expression> values) -> Type? {
        Type? joined = null;
        for (long i = 0; i < values.length(); i++) {
            let value = values.get(i);
            if (isUntypedNumberLiteral(value)) {
                continue;
            }
            Type analyzed = this.recordedType(value);
            if (joined == null) {
                joined = analyzed;
                continue;
            }
            joined = convert.unifyValueTypes(joined, analyzed, this.store());
            if (joined == null) {
                return null;
            }
        }
        return joined;
    }

    // An identifier label over an enum scrutinee names a member; any other label must be an
    // expression of the enum's own type that resolved to a member constant.
    checkEnumLabel(Expression label, EnumType inner, Set<long> covered) {
        long ordinal = -1;
        if (label is IdentifierExpressionNode) {
            ordinal = enumOrdinal(inner, label.name().text());
            if (ordinal >= 0) {
                this.result().setType(label.green(), inner);
                this.result().setEnumConstant(label.green(), ordinal);
            } else {
                this.reporter().report("'{label.name().text()}' is not a member of enum "
                    + "'{this.names().of(inner)}'.{wording.membersListed(inner)}", label.span());
            }
        } else {
            Type labelType = this.analyzeExpression(label);
            if (!(labelType is ErrorType) && labelType != inner) {
                string valueShown = this.names().of(inner);
                this.reporter().report("Switch label of type "
                    + "'{this.names().of(labelType)}' does not match the switch value "
                    + "of type '{valueShown}'. Write a label of type '{valueShown}'.",
                    label.span());
            }
            let constant = this.result().enumConstantOf(label.green());
            if (constant != null) {
                ordinal = constant;
            }
        }
        if (ordinal >= 0 && !covered.add(ordinal)) {
            this.reporter().report("This switch already has an arm for '{wording.oneLineSpelling(label)}'. "
                + "Remove this second one.", label.span());
        }
    }

    // Integer labels are integer constants written in any integer-literal form: an int or long
    // literal by its value, a char literal by its codepoint, so 'A', 65, and 65L name the same
    // label. A literal label adapts to the scrutinee, its value fit-checked against the type.
    checkIntegerLabel(Expression label, Type inner, Set<long> seen) {
        Type labelType = this.analyzeExpression(label);
        let value = integerLabelValue(label);
        if (value == null) {
            if (!(labelType is ErrorType)) {
                if (!convert.isAssignableStrict(inner, labelType)
                        && !convert.isAssignableStrict(labelType, inner)) {
                    string valueShown = this.names().of(inner);
                    this.reporter().report("Switch label of type "
                        + "'{this.names().of(labelType)}' does not match the switch "
                        + "value of type '{valueShown}'. Write a label of type '{valueShown}'.",
                        label.span());
                } else {
                    string spelled = wording.oneLineSpelling(label);
                    this.reporter().report("Label '{spelled}' is not an integer constant, and every label of "
                        + "a switch on an integer must be one, such as '1'. Compare with '{spelled}' in an "
                        + "'if' instead.", label.span());
                }
            }
            return;
        }
        if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
            literaltyping.adaptCharLiteral(this, label, inner);
        } else {
            literaltyping.adaptIntegerLiteralLabel(this, label, inner);
        }
        let adapted = this.result().typeOf(label.green());
        if (adapted != null && adapted is ErrorType) {
            return;
        }
        if (!seen.add(value)) {
            this.reporter().report("This switch already has an arm for '{value}'. Remove this second one.",
                label.span());
        }
    }

    checkStringLabel(Expression label, Set<string> seen) {
        Type labelType = this.analyzeExpression(label);
        if (!(labelType is ErrorType) && !(labelType is StringType)) {
            this.reporter().report("Switch label of type '{this.names().of(labelType)}' does not "
                + "match the switch value of type 'string'. Write a string literal label.",
                label.span());
            return;
        }
        let text = stringLabelText(label);
        if (text != null) {
            if (!seen.add(text)) {
                this.reporter().report("This switch already has an arm for "
                    + "'{wording.oneLineSpelling(label)}'. Remove this second one.", label.span());
            }
        } else if (!(labelType is ErrorType)) {
            string spelled = wording.oneLineSpelling(label);
            this.reporter().report("Label '{spelled}' is not a string literal, and every label of a switch "
                + "on a string must be one, such as '\"a\"'. Compare with '{spelled}' in an 'if' instead.",
                label.span());
        }
    }

    // The class or interface an 'is' arm matches, or null when the arm is rejected: the
    // target must be able to match some values of the scrutinee without matching all of them.
    // 'first' marks an arm with no accepted 'is' arm before it, which the refusal of an arm that
    // matches every value writes the switch without.
    checkTypeArmTarget(Type scrutineeType, Type inner, Type armType, Span span, Expression scrutinee,
                       ArmBody body, bool first) -> Type? {
        if (armType is OptionalType) {
            this.reporter().report("The type of an 'is' arm cannot be nullable, because 'is' never matches "
                + "null. Write 'is {this.names().of(convert.coreOf(armType))}', and add a 'null ->' arm "
                + "for null.", span);
            return null;
        }
        // A type parameter arm is judged per instantiation; here it still matches and binds as
        // the parameter.
        if (armType is TypeParamType) {
            this.recordObligation(new TypeTestObligation(inner, armType, false, span));
            return armType;
        }
        if (!types.isClassLike(armType)) {
            this.reporter().report("The type of an 'is' arm must be a class or an interface, and "
                + "'{this.names().of(armType)}' is neither.", span);
            return null;
        }
        if (armType == inner) {
            this.reporter().report("'is {this.names().of(armType)}' matches every value of this "
                + "switch over '{this.names().of(scrutineeType)}'"
                + everyValueFix(scrutineeType, scrutinee, body, first), span);
            return null;
        }
        if (hierarchy.isSubclassOrConforms(inner, armType)) {
            this.reporter().report("A value of type '{this.names().of(inner)}' is always a "
                + "'{this.names().of(armType)}', so this arm matches every value"
                + everyValueFix(scrutineeType, scrutinee, body, first), span);
            return null;
        }
        if (types.isInterfaceLike(inner)) {
            return armType;
        }
        if (types.isInterfaceLike(armType)) {
            if (isFinalClass(inner)) {
                this.reporter().report("A value of type '{this.names().of(inner)}' "
                    + "can never be a '{this.names().of(armType)}': "
                    + "'{this.names().of(inner)}' is 'final' and does not implement "
                    + "it. Remove this arm.", span);
                return null;
            }
            return armType;
        }
        if (!hierarchy.isSubclassOf(armType, inner)) {
            this.reporter().report("A value of type '{this.names().of(inner)}' can never be a "
                + "'{this.names().of(armType)}', because '{this.names().of(armType)}' is not a subclass of "
                + "'{this.names().of(inner)}'. Remove this arm.", span);
            return null;
        }
        return armType;
    }

    // An arm is unreachable when an earlier arm already matches every value of its type.
    checkTypeArmReachable(Type armTarget, List<Type> earlier, Span span) {
        for (long i = 0; i < earlier.length(); i++) {
            if (hierarchy.isSubclassOrConforms(armTarget, earlier.get(i))) {
                this.reporter().report("This 'is {shortTypeName(armTarget, this.names())}' arm never runs, "
                    + "because the earlier 'is {shortTypeName(earlier.get(i), this.names())}' arm "
                    + "already matches every '{shortTypeName(armTarget, this.names())}'. Move it above "
                    + "that arm, or remove it.", span);
                return;
            }
        }
    }

    // An enum switch without a default must cover every member; integer and string switches
    // always need one.
    checkValueExhaustiveness(Type inner, Set<long> coveredEnumOrdinals, Span span) {
        if (inner is EnumType) {
            string[] names = inner.memberNames();
            let missing = new List<string>();
            for (long i = 0; i < names.length; i++) {
                if (!coveredEnumOrdinals.contains(i)) {
                    missing.push(names[i]);
                }
            }
            if (missing.length() > 0) {
                let qualified = new List<string>();
                for (let member in missing) {
                    qualified.push("{this.names().of(inner)}.{member}");
                }
                string add = "Add an arm for each, or a 'default' arm.";
                if (missing.length() == 1) {
                    add = "Add an arm for it, or a 'default' arm.";
                }
                this.reporter().report("This switch has no arm for {wording.quotedList(qualified)}. {add}",
                    span);
            }
            return;
        }
        string shown = this.names().of(inner);
        this.reporter().report("A switch on '{shown}' must have a 'default' arm, because its arms cannot "
            + "list every '{shown}' value.", span);
    }

    // A type switch without a default: an interface or an unsealed or concrete root always
    // needs one; a sealed abstract root instead needs every direct subclass covered, an arm
    // for a subclass covering its descendants.
    checkTypeExhaustiveness(Type inner, List<Type> armTargets, Span span) {
        string rootName = this.names().of(inner);
        let authority = types.authorityOf(inner);
        if (authority is InterfaceType) {
            this.reporter().report("A switch over '{rootName}' must have a 'default' arm: "
                + "interfaces are open, so any class anywhere may implement '{rootName}'.",
                span);
            return;
        }
        if (authority is ClassType) {
            if (authority.isFinal()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because an arm "
                    + "for a type parameter may not match every '{rootName}'.", span);
                return;
            }
            if (!authority.isSealed()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because "
                    + "'{rootName}' is not 'sealed', so it can have subclasses that no arm matches.", span);
                return;
            }
            if (!authority.isAbstract()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because "
                    + "'{rootName}' is not abstract, so a value can be a '{rootName}' itself, which no "
                    + "subclass arm matches.", span);
                return;
            }
            let missing = new List<string>();
            let subclasses = authority.directSubclasses();
            for (long i = 0; i < subclasses.length(); i++) {
                let subclass = subclasses.get(i);
                bool covered = false;
                for (long j = 0; j < armTargets.length(); j++) {
                    if (hierarchy.isSubclassOrConforms(subclass, armTargets.get(j))) {
                        covered = true;
                        break;
                    }
                }
                if (!covered) {
                    missing.push(subclass.name());
                }
            }
            if (missing.length() > 0) {
                string noun = "subclasses";
                string add = "Add an arm for each, or a 'default' arm.";
                if (missing.length() == 1) {
                    noun = "a subclass";
                    add = "Add an arm for it, or a 'default' arm.";
                }
                this.reporter().report("This switch has no arm for {wording.quotedList(missing)}, {noun} of "
                    + "sealed class '{rootName}'. {add}", span);
            }
        }
    }

    public recordedType(Expression expression) -> Type {
        let recorded = this.result().typeOf(expression.green());
        if (recorded != null) {
            return recorded;
        }
        return this.store().errorType();
    }

    // Walks one switch arm from the state after the scrutinee and records both its assignment
    // out-state and the narrowings holding at its end, so the arms can be joined: a local
    // assigned in every arm of an exhaustive switch is assigned after, and a path narrowed by
    // every arm stays narrowed after.
    walkArmBodyFlow(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                            List<AssignmentFlow> armFlows,
                            List<Map<NarrowingPath, Type>> armNarrowings,
                            bool deferLiterals, LiteralOrigin? origin, Type? fixTarget) -> bool {
        let sawBlock = this.walkArmBody(body, requireValue, target, sink, armNarrowings,
            deferLiterals, origin, fixTarget);
        armFlows.push(this.assignment().snapshot());
        return sawBlock;
    }

    // With 'deferLiterals', a number literal arm is analyzed without the target, so it can take the
    // type of the arms that have one. 'origin' is where the target is set, and 'fixTarget'
    // is the target the arm values of a switch analyzed without one are judged against.
    walkArmBody(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                        List<Map<NarrowingPath, Type>> armNarrowings,
                        bool deferLiterals, LiteralOrigin? origin, Type? fixTarget) -> bool {
        switch (body) {
            is BlockNode block -> {
                bool sawBlock = false;
                if (requireValue) {
                    this.reporter().report("Each arm of a switch used as a value must give a value, as in "
                        + "'1 -> 0,', not run a '\{ \}' block.", block.span());
                    sawBlock = true;
                }
                this.enterScope();
                this.walkBlock(block);
                armNarrowings.push(this.narrowingState.flatten());
                this.leaveScope();
                return sawBlock;
            },
            is Expression expression -> {
                if (requireValue) {
                    this.noteJoinValue(expression);
                }
                bool deferred = deferLiterals && isUntypedNumberLiteral(expression);
                if (target != null && !deferred) {
                    this.analyzeExpressionAdapt(expression, target, origin);
                } else {
                    this.targets().stash(expression, target ?? fixTarget, origin);
                    this.analyzeExpression(expression);
                    this.targets().clearStash();
                }
                armNarrowings.push(this.narrowingState.flatten());
                if (requireValue) {
                    sink.push(expression);
                }
                return false;
            },
            default -> {
                armNarrowings.push(this.narrowingState.flatten());
                return false;
            },
        }
    }
}

// The call shape paired with each argument's written expression, positional first and named
// after, so resolved calls can adapt literals in place. An 'out' misuse leaves a null hole.
class BuiltShape {
    protected CallShape shape;
    protected List<Expression?> values;

    protected constructor(this.shape, this.values);
}

// Whether one of these declarations takes a call of this argument count.
anyAcceptsArgumentCount(List<Method> candidates, long argumentCount) -> bool {
    for (long i = 0; i < candidates.length(); i++) {
        if (calls.acceptsArgumentCount(candidates.get(i).signature(), argumentCount)) {
            return true;
        }
    }
    return false;
}

// Every method the receiver's chain declares under the name, nearest first; a base method whose
// parameter types a derived one repeats is shadowed. Constructors and destructors are not members.
methodCandidates(Type record, string name) -> List<Method> {
    let found = new List<Method>();
    Type? current = record;
    let seen = new Set<Type>();
    while (current != null && seen.add(current)) {
        let methods = typemembers.methodsOf(current);
        if (methods == null) {
            break;
        }
        long derivedCount = found.length();
        for (long i = 0; i < methods.length(); i++) {
            let candidate = methods.get(i);
            if (candidate.name() != name || candidate.isConstructor() || candidate.isDestructor()) {
                continue;
            }
            bool shadowed = false;
            for (long j = 0; j < derivedCount; j++) {
                if (typemembers.sameParameterTypes(found.get(j).signature(),
                        candidate.signature())) {
                    shadowed = true;
                    break;
                }
            }
            if (!shadowed) {
                found.push(candidate);
            }
        }
        current = hierarchy.baseOf(current);
    }
    return found;
}

// True when a call with this many positional arguments could reach the signature.
fitsArgumentCount(Signature signature, long count) -> bool {
    return count >= calls.requiredArgumentCount(signature) && count <= signature.parameters().length;
}

// "int, string", the way a type-argument vector reads inside angle brackets.
typeArgumentsText(Type[] arguments, TypeNames names) -> string {
    string text = "";
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + names.of(arguments[i]);
    }
    return text;
}

// The type-argument list an example spelling shows: the declaration's own parameter names, so
// 'Pair<A, B>.of(...)' reads against 'Pair<A, B>'.
typeParameterExample(DeclaredType owner) -> string {
    string[] names = owner.typeParameters();
    string example = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            example = example + ", ";
        }
        example = example + names[i];
    }
    return example;
}

// "Path.separator", the way a static const reads in a diagnostic.
staticConstDisplay(Field field, TypeNames names) -> string {
    let owner = types.authorityOf(field.definingType());
    if (owner == null) {
        return field.name();
    }
    return "{names.nameOf(owner)}.{field.name()}";
}

// The statics a type declares under the name. No chain walk: statics are not inherited, so only
// the named type's own list is used.
staticsNamed(Type owner, string name) -> List<Method> {
    let found = new List<Method>();
    let statics = typemembers.staticMethodsOf(owner);
    if (statics != null) {
        for (long i = 0; i < statics.length(); i++) {
            if (statics.get(i).name() == name) {
                found.push(statics.get(i));
            }
        }
    }
    return found;
}

fieldIndexNamed(List<Field> fields, string name) -> long {
    for (long i = 0; i < fields.length(); i++) {
        if (fields.get(i).name() == name) {
            return i;
        }
    }
    return -1;
}

structDisplayName(Type structType, TypeNames names) -> string {
    let authority = types.authorityOf(structType);
    if (authority != null) {
        return authority.name();
    }
    return names.of(structType);
}

// The receivers member lookup walks: a declaration's own members, or the members the standard
// library declares for a primitive.
isRecordLike(Type type) -> bool {
    return type is ClassType || type is InterfaceType || type is StructType
        || type is InstantiationType || types.bindingOf(type) != null;
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

// A floating-point type converts to text, but `decimal` is reserved rather than
// implemented, so it has none even though it counts as floating-point elsewhere.
isTextualFloat(Type core) -> bool {
    return convert.isFloatType(core) && !types.isDecimalType(core);
}

isStringable(Type core) -> bool {
    return core is StringType || convert.isIntegerType(core) || convert.isBoolType(core)
        || isTextualFloat(core);
}

parameterCountText(long count) -> string {
    if (count == 1) {
        return "1 parameter";
    }
    return "{count} parameters";
}

// The refusal of a 'fromCString' call that passes 'count' arguments.
fromCStringCountRefusal(long count) -> string {
    string refusal = "'fromCString' takes one argument, a handle a C function returned, but this call "
        + "passes {diagnostics.countWord(count)}.";
    if (count == 0) {
        return "{refusal} Pass the handle.";
    }
    if (count == 2) {
        return "{refusal} Remove the extra argument.";
    }
    return "{refusal} Remove the extra arguments.";
}

// A lambda of the right arity, as a diagnostic shows the shape to write: '(a, b) -> ...'.
lambdaShapeExample(long count) -> string {
    let builder = new StringBuilder();
    builder.append("(");
    for (long i = 0; i < count; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameterExampleName(i));
    }
    builder.append(") -> ...");
    return builder.toString();
}

parameterExampleName(long index) -> string {
    return switch (index) {
        0 -> "a",
        1 -> "b",
        2 -> "c",
        default -> "p{index + 1}",
    };
}

usesNamedArguments(ArgumentListNode arguments) -> bool {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (arguments.arguments(i) is NamedArgumentNode) {
            return true;
        }
    }
    return false;
}

// True for a value with no type of its own to offer overload resolution, which is checked once the
// parameter it fills is known: an empty array literal, a '{...}' literal, and a lambda, whose
// parameter and return types come from the function type it fills.
// Whether the argument is an operator or a join holding a floating-point literal too large for
// 'float', whose fix names the parameter the argument is passed to.
carriesOverflowingFloat(Expression value) -> bool {
    Expression core = operandCore(value);
    if (core is BinaryExpressionNode) {
        return overflowsFloatWithin(core.left()) || overflowsFloatWithin(core.right());
    }
    if (core is TernaryExpressionNode) {
        return overflowsFloatWithin(core.thenValue()) || overflowsFloatWithin(core.elseValue());
    }
    return false;
}

// Whether the value is, or holds as an operand or a branch, a floating-point literal too large for
// 'float'.
overflowsFloatWithin(Expression value) -> bool {
    Expression core = operandCore(value);
    let literal = literaltyping.floatLiteralOf(core);
    if (literal != null) {
        return literalOverflows(literal, PrimitiveKind.Float);
    }
    return carriesOverflowingFloat(core);
}

// Whether an argument of a generic call is analyzed once its parameter type is known. With the type
// arguments 'written', an array literal is too, so that its literals take the element type.
waitsForParameter(Expression value, bool written) -> bool {
    return needsTargetType(value) || (written && value is ArrayLiteralExpressionNode);
}

needsTargetType(Expression value) -> bool {
    if (value is ArrayLiteralExpressionNode) {
        return value.elementsCount() == 0;
    }
    return value is StructLiteralExpressionNode || value is LambdaExpressionNode;
}

enumOrdinal(EnumType enumType, string memberName) -> long {
    string[] names = enumType.memberNames();
    for (long i = 0; i < names.length; i++) {
        if (names[i] == memberName) {
            return i;
        }
    }
    return -1;
}

hasTypeArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        if (arms.get(i) is TypeArmNode) {
            return true;
        }
    }
    return false;
}

isNullLabel(Expression label) -> bool {
    return label is LiteralExpressionNode && label.value().kind() == SyntaxKind.NullKeyword;
}

// The two walks over a string, spelled against the expression the loop was given when that
// expression is simple enough to quote and against the string itself when it is not.
stringWalkAdvice(Expression iterated) -> string {
    let spelling = wording.simpleSpelling(iterated);
    if (spelling == null) {
        return "Iterate its 'chars()' to visit its characters, or its 'bytes()' to visit its "
            + "bytes.";
    }
    return "Iterate '{spelling}.chars()' to visit its characters, or '{spelling}.bytes()' to "
        + "visit its bytes.";
}

// A name for a replacement array that differs from the array's own name. An array reached
// through no name, such as an element or a call's result, is named 'resized'.
resizedName(Expression array) -> string {
    Expression core = wording.unwrapParentheses(array);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text() + "Resized";
        },
        is MemberExpressionNode member -> {
            return member.member().text() + "Resized";
        },
        default -> {
            return "resized";
        },
    }
}

// The sentence, opening with a space, that lists the names of 'fields', or empty when there are none.
fieldsListed(List<Field> fields) -> string {
    if (fields.length() == 0) {
        return "";
    }
    let listed = new List<string>();
    for (long i = 0; i < fields.length(); i++) {
        listed.push(fields.get(i).name());
    }
    if (listed.length() == 1) {
        return " Its only field is '{listed.get(0)}'.";
    }
    return " Its fields are {wording.quotedList(listed)}.";
}

// The first type parameter of 'template' that no parameter of any of the statics at 'indexes'
// mentions, so no argument can give it a type, or empty when each one mentions them all.
openTypeParameter(DeclaredType template, List<Method> statics, List<long> indexes) -> string {
    string[] names = template.typeParameters();
    for (long p = 0; p < names.length; p++) {
        for (let index in indexes) {
            bool mentioned = false;
            for (let parameter in statics.get(index).signature().parameters()) {
                if (mentionsTypeParameter(parameter.type(), template.declaration(), p)) {
                    mentioned = true;
                }
            }
            if (!mentioned) {
                return names[p];
            }
        }
    }
    return "";
}

// Whether 'type' mentions the type parameter at 'index' of the declaration 'owner'.
mentionsTypeParameter(Type type, GreenNode owner, long index) -> bool {
    switch (type) {
        is TypeParamType parameter -> {
            return parameter.owner() == owner && parameter.index() == index;
        },
        is ArrayType array -> {
            return mentionsTypeParameter(array.element(), owner, index);
        },
        is OptionalType optional -> {
            return mentionsTypeParameter(optional.inner(), owner, index);
        },
        is FunctionType function -> {
            for (let parameter in function.parameterTypes()) {
                if (mentionsTypeParameter(parameter, owner, index)) {
                    return true;
                }
            }
            return mentionsTypeParameter(function.returnType(), owner, index);
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                if (mentionsTypeParameter(argument, owner, index)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}

// The type an example writes for a type argument the call leaves open: 'int', or 'int?' when an
// argument is 'null', which only a nullable type takes.
exampleTypeArgument(ArgumentListNode? arguments) -> string {
    if (arguments == null) {
        return "int";
    }
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                if (wording.isNullLiteral(wording.unwrapParentheses(named.value()))) {
                    return "int?";
                }
            },
            is Expression value -> {
                if (wording.isNullLiteral(wording.unwrapParentheses(value))) {
                    return "int?";
                }
            },
            default -> {},
        }
    }
    return "int";
}

// One 'int' for each of 'count' type parameters, as an example writes them: "int, int".
concreteTypeArguments(long count) -> string {
    string listed = "";
    for (long i = 0; i < count; i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        listed = listed + "int";
    }
    return listed;
}

// The refusal of a call to the generic 'subject' that shows none of its type arguments 'parameters'.
// The example writes 'example' for each, between 'head' and 'tail'.
unshownTypeArguments(string subject, string[] parameters, string head, string tail, string example)
        -> string {
    string listed = "";
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        listed = listed + example;
    }
    if (parameters.length == 1) {
        return "{subject} is generic, and this call does not show what its type argument '{parameters[0]}' "
            + "is. Write it, as in '{head}{listed}{tail}'.";
    }
    let quoted = new List<string>();
    for (let parameter in parameters) {
        quoted.push(parameter);
    }
    return "{subject} is generic, and this call does not show what its type arguments "
        + "{wording.quotedList(quoted)} are. Write them, as in '{head}{listed}{tail}'.";
}

// "Parameter 'result'", or "Parameter 2" for the parameter at 'index' when it has no name.
parameterSubject(Parameter parameter, long index) -> string {
    if (parameter.name().length > 0) {
        return "Parameter '{parameter.name()}'";
    }
    return "Parameter {index + 1}";
}

// The source text of one argument on one line.
argumentSpelling(Argument argument) -> string {
    switch (argument) {
        is NamedArgumentNode named -> {
            return wording.greenSpelling(named.green());
        },
        is OutArgumentNode written -> {
            return wording.greenSpelling(written.green());
        },
        is Expression value -> {
            return wording.oneLineSpelling(value);
        },
        default -> {
            return "";
        },
    }
}

// The argument list of a call with the names of its named arguments removed, when it is short, or '(...)'.
positionalSpelling(ArgumentListNode arguments) -> string {
    string listed = "";
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                listed = listed + wording.oneLineSpelling(named.value());
            },
            default -> {
                listed = listed + argumentSpelling(arguments.arguments(i));
            },
        }
    }
    if (listed.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return "({listed})";
}

// The argument list of a call as written when it is short, or '(...)'.
argumentsSpelling(ArgumentListNode? arguments) -> string {
    if (arguments == null) {
        return "()";
    }
    string spelled = wording.greenSpelling(arguments.green());
    if (spelled.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return spelled;
}

// The refusal of a 'try' before 'operand', which is not a call. The fix moves the 'try' to a call on
// one side of an operator.
misplacedTryRefusal(Expression operand) -> string {
    let spelled = wording.shortSpelling(operand);
    if (spelled == null) {
        return "'try' must be written directly before a call. Move 'try' to the call that can throw.";
    }
    string opening = "'try' must be written directly before a call, and '{spelled}' is not a call.";
    let inner = wording.unwrapParentheses(operand);
    if (inner is BinaryExpressionNode) {
        string left = wording.oneLineSpelling(inner.left());
        string right = wording.oneLineSpelling(inner.right());
        string operator = inner.operator().text();
        if (inner.right() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in '{left} {operator} try {right}'.";
        }
        if (inner.left() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in 'try {left} {operator} {right}'.";
        }
    }
    return "{opening} Move 'try' to the call that can throw.";
}

// Whether the operator takes both sides once every '?' is removed from them.
acceptsCores(SyntaxKind operator, Type left, Type right) -> bool {
    Type first = convert.coreOf(left);
    Type second = convert.coreOf(right);
    switch (operator) {
        Plus -> {
            if (first is StringType || second is StringType) {
                return isStringable(first) && isStringable(second);
            }
            return convert.isNumericType(first) && convert.isNumericType(second);
        },
        Minus, Star, Slash, Percent, PlusPlus, MinusMinus -> {
            return convert.isNumericType(first) && convert.isNumericType(second);
        },
        Ampersand, Pipe, Caret, LessLess, GreaterGreater, GreaterGreaterGreater -> {
            return convert.isIntegerType(first) && convert.isIntegerType(second);
        },
        // Two strings are ordered with 'compareTo' instead of an ordering operator.
        Less, Greater, LessEquals, GreaterEquals -> {
            return (first is StringType && second is StringType)
                || (convert.isNumericType(first) && convert.isNumericType(second));
        },
        default -> {
            return false;
        },
    }
}

// The type an operator checks its left side as. A write target is checked without its '?'.
checkedSide(Type left, WriteTarget? written) -> Type {
    if (written != null) {
        return convert.coreOf(left);
    }
    return left;
}

// The type a text names for the left side of an operator, as 'adapted' toward the other side.
// A write target is named with its own type instead.
shownSide(Type adapted, Type left, WriteTarget? written) -> Type {
    if (written != null) {
        return left;
    }
    return adapted;
}

// The refusal of an operator's sides 'leftNode' and 'rightNode', naming the ones the operator does
// not take. A shift names only the shifted value.
sidesRefusal(SyntaxKind operator, string operatorText, Expression leftNode, Expression rightNode, Type left,
             Type right, TypeNames names) -> string {
    bool joins = convert.coreOf(left) is StringType || convert.coreOf(right) is StringType;
    if (operator == SyntaxKind.Plus && joins) {
        string sides = sidesClause(leftNode, rightNode, left, right, left is OptionalType,
            right is OptionalType, names);
        return "'{operatorText}' joins a string only when neither side can be null, {sides}.";
    }
    switch (operator) {
        Ampersand, Pipe, Caret -> {
            string sides = sidesClause(leftNode, rightNode, left, right, !convert.isIntegerType(left),
                !convert.isIntegerType(right), names);
            return "'{operatorText}' needs integers on both sides, {sides}.";
        },
        LessLess, GreaterGreater, GreaterGreaterGreater -> {
            return "'{operatorText}' shifts an integer, but "
                + "{wording.sideNamed(leftNode, "the value it shifts")} has type '{names.of(left)}'.";
        },
        default -> {
            string sides = sidesClause(leftNode, rightNode, left, right, !convert.isNumericType(left),
                !convert.isNumericType(right), names);
            return "'{operatorText}' needs numbers on both sides, {sides}.";
        },
    }
}

// The clause "but ... has type 'T'" naming the sides of an operator it does not take, the ones
// 'leftFails' and 'rightFails' mark. A side with no short spelling is named by its place.
sidesClause(Expression leftNode, Expression rightNode, Type left, Type right, bool leftFails, bool rightFails,
            TypeNames names) -> string {
    if (leftFails && !rightFails) {
        return "but {wording.sideNamed(leftNode, "the left side")} has type '{names.of(left)}'";
    }
    if (rightFails && !leftFails) {
        return "but {wording.sideNamed(rightNode, "the right side")} has type '{names.of(right)}'";
    }
    let first = wording.shortSpelling(leftNode);
    let second = wording.shortSpelling(rightNode);
    bool same = names.of(left) == names.of(right);
    if (first != null && second != null && first != second) {
        if (same) {
            return "but '{first}' and '{second}' both have type '{names.of(left)}'";
        }
        return "but '{first}' has type '{names.of(left)}' and '{second}' has type '{names.of(right)}'";
    }
    if (same) {
        return "but both sides have type '{names.of(left)}'";
    }
    return "but the sides are '{names.of(left)}' and '{names.of(right)}'";
}

// The sentence, opening with a space, that converts two sides of different number types to the
// narrowest type with every value of each, so no value changes. Empty when no type has them all, and
// for a compound assignment, whose result goes back into its left side.
bothSidesConversion(string operatorText, Expression leftNode, Expression rightNode, Type left, Type right)
        -> string {
    Type leftCore = convert.coreOf(left);
    Type rightCore = convert.coreOf(right);
    if (isCompoundOperator(operatorText) || !(leftCore is PrimitiveType) || !(rightCore is PrimitiveType)) {
        return "";
    }
    string target = holdingNumberType(leftCore.kind(), rightCore.kind());
    if (target.length == 0) {
        return "";
    }
    let leftSpelled = wording.shortSpelling(leftNode);
    let rightSpelled = wording.shortSpelling(rightNode);
    Expression leftValue = wording.unwrapParentheses(leftNode);
    Expression rightValue = wording.unwrapParentheses(rightNode);
    bool convertsLeft = primitiveName(leftCore.kind()) != target;
    bool convertsRight = primitiveName(rightCore.kind()) != target;
    if (leftSpelled == null || rightSpelled == null) {
        return " Convert both sides to '{target}' with 'as'.";
    }
    string leftText = wording.oneLineSpelling(leftValue);
    string rightText = wording.oneLineSpelling(rightValue);
    if (convertsLeft) {
        leftText = wording.converted(leftValue, target);
    }
    if (convertsRight) {
        rightText = wording.converted(rightValue, target);
    }
    string example = "{leftText} {operatorText} {rightText}";
    if (convertsLeft && convertsRight) {
        return " Convert both sides to '{target}', as in '{example}'.";
    }
    string side = leftSpelled;
    if (convertsRight) {
        side = rightSpelled;
    }
    return " Convert '{side}' to '{target}', as in '{example}'.";
}

// Whether 'operatorText' writes its result back into its left side, as '+=' does.
isCompoundOperator(string operatorText) -> bool {
    return operatorText.endsWith("=") && operatorText != "<=" && operatorText != ">="
        && operatorText != "==" && operatorText != "!=";
}

// The narrowest number type with every value of 'first' and of 'second', or empty when none has them
// all. An integer type comes first at each width, and a 'float' or a 'double' side needs a
// floating-point type.
holdingNumberType(PrimitiveKind first, PrimitiveKind second) -> string {
    if (isFloatingKind(first) || isFloatingKind(second)) {
        for (let kind in [PrimitiveKind.Float, PrimitiveKind.Double]) {
            if (floatHoldsEveryValue(kind, first) && floatHoldsEveryValue(kind, second)) {
                return primitiveName(kind);
            }
        }
        return "";
    }
    PrimitiveKind[] ordered = [PrimitiveKind.Short, PrimitiveKind.UShort, PrimitiveKind.Int,
        PrimitiveKind.UInt, PrimitiveKind.Long, PrimitiveKind.ULong];
    for (let kind in ordered) {
        if (holdsEveryValue(kind, first) && holdsEveryValue(kind, second)) {
            return primitiveName(kind);
        }
    }
    return "";
}

// Whether the kind is 'float' or 'double'.
isFloatingKind(PrimitiveKind kind) -> bool {
    return kind == PrimitiveKind.Float || kind == PrimitiveKind.Double;
}

// Whether the floating-point kind 'outer' has every value of 'inner' exactly: a 'float' has integers of
// up to 24 bits and a 'double' of up to 53.
floatHoldsEveryValue(PrimitiveKind outer, PrimitiveKind inner) -> bool {
    if (inner == PrimitiveKind.Double) {
        return outer == PrimitiveKind.Double;
    }
    if (inner == PrimitiveKind.Float) {
        return true;
    }
    if (inner == PrimitiveKind.Bool) {
        return false;
    }
    long width = literaltyping.integerWidth(inner);
    if (inner == PrimitiveKind.Char) {
        width = 21;
    }
    if (outer == PrimitiveKind.Float) {
        return width <= 24;
    }
    return width < 64;
}

// The name a number kind is written with.
primitiveName(PrimitiveKind kind) -> string {
    if (kind == PrimitiveKind.Float) {
        return "float";
    }
    if (kind == PrimitiveKind.Double) {
        return "double";
    }
    if (kind == PrimitiveKind.Byte) {
        return "byte";
    }
    if (kind == PrimitiveKind.Char) {
        return "char";
    }
    return literaltyping.primitiveKindName(kind);
}

// How an arithmetic operator combines a value with a target, as in "adding 'long' to 'int'".
combinedWords(SyntaxKind operator, Type target, Type value, TypeNames names) -> string {
    string first = "'{names.of(target)}'";
    string second = "'{names.of(value)}'";
    switch (operator) {
        Plus -> {
            return "adding {second} to {first}";
        },
        Minus -> {
            return "subtracting {second} from {first}";
        },
        Star -> {
            return "multiplying {first} by {second}";
        },
        Slash -> {
            return "dividing {first} by {second}";
        },
        Percent -> {
            return "the remainder of dividing {first} by {second}";
        },
        default -> {
            return "combining {first} with {second}";
        },
    }
}

typeParameterNamesText(Signature signature) -> string {
    string text = "";
    let parameters = signature.typeParameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + parameters[i].name();
    }
    return text;
}


// The refusal of argument 'label' of 'callee', whose type 'actual' is not the type 'expected' of the
// parameter it is passed to, named 'parameter' when the parameter has a name.
argumentMismatch(string label, string callee, string parameter, Type expected, Type actual, TypeNames names)
        -> string {
    string given = "Argument {label} of {callee} has type '{names.of(actual)}'";
    if (parameter.length == 0) {
        string wanted = names.of(expected);
        return "{given}, but {callee} takes {typenames.typeArticle(wanted)} '{wanted}' there.";
    }
    return "{given}, but parameter '{parameter}' has type '{names.of(expected)}'.";
}

// The refusal of element 'index' of an array literal, whose type 'actual' is not the element type.
elementMismatch(long index, Type elementType, Type actual, TypeNames names) -> string {
    return "Element {index + 1} has type '{names.of(actual)}', but the elements of this array have type "
        + "'{names.of(elementType)}'.";
}

// How a refusal names the callee of 'kindWord' spelled 'displayName' after the word "of".
calleeObject(string kindWord, string displayName) -> string {
    if (kindWord == "Constructor" || kindWord == "Base constructor") {
        return "the constructor of '{displayName}'";
    }
    return "'{displayName}'";
}

// The 'f' or 'F' that makes a floating-point literal a 'float', behind an optional sign, or an
// empty string when the expression is not such a literal.
floatSuffixOf(Expression expression) -> string {
    Expression core = wording.unwrapParentheses(expression);
    if (core is PrefixExpressionNode) {
        SyntaxKind operator = core.operator().kind();
        if (operator == SyntaxKind.Plus || operator == SyntaxKind.Minus) {
            core = core.operand();
        }
    }
    if (core is LiteralExpressionNode) {
        if (core.value().kind() == SyntaxKind.FloatLiteral) {
            if (core.value().text().endsWith("F")) {
                return "F";
            }
            return "f";
        }
    }
    return "";
}

// The parameter or the '??' value that sets the type at 'origin', or an empty string for any other
// origin. An element origin names the element type of either.
originNoun(LiteralOrigin origin) -> string {
    switch (origin.kind()) {
        Parameter -> {
            if (origin.forElement()) {
                return "the element type of {parameterNoun(origin)}";
            }
            return parameterNoun(origin);
        },
        Fallback -> {
            if (origin.forElement()) {
                return "the element type of '{origin.name()}'";
            }
            return "the value of '{origin.name()}'";
        },
        default -> {
            return "";
        },
    }
}

// The parameter at 'origin' as the sentence after 'from' names it.
parameterNoun(LiteralOrigin origin) -> string {
    if (origin.name().length > 0 && origin.constructed().length > 0) {
        return "parameter '{origin.name()}' of the constructor of '{origin.constructed()}'";
    }
    if (origin.name().length > 0) {
        return "parameter '{origin.name()}' of '{origin.owner()}'";
    }
    if (origin.owner().length > 0) {
        return "the parameter of '{origin.owner()}'";
    }
    return "the parameter it is passed to";
}

// Whether the operator combines two numbers into a number of their type.
isArithmeticOperator(SyntaxKind operator) -> bool {
    return operator == SyntaxKind.Plus || operator == SyntaxKind.Minus || operator == SyntaxKind.Star
        || operator == SyntaxKind.Slash || operator == SyntaxKind.Percent;
}

// Whether the value is a floating-point literal too large for the floating-point type 'target' has
// without its '?'.
floatLiteralOverflows(Expression value, Type target) -> bool {
    let literal = literaltyping.floatLiteralOf(wording.unwrapParentheses(value));
    Type core = convert.coreOf(target);
    if (literal == null || !(core is PrimitiveType)) {
        return false;
    }
    if (core.kind() != PrimitiveKind.Float && core.kind() != PrimitiveKind.Double) {
        return false;
    }
    return literalOverflows(literal, core.kind());
}

// Whether the value of the floating-point literal is past the range of 'kind'.
literalOverflows(LiteralExpressionNode literal, PrimitiveKind kind) -> bool {
    return !literalvalues.floatMagnitudeFits(literalvalues.floatMagnitude(literal.value().text()), kind);
}

// The expression under its parentheses and a leading '+' or '-'.
public operandCore(Expression value) -> Expression {
    Expression core = wording.unwrapParentheses(value);
    while (core is PrefixExpressionNode) {
        SyntaxKind operator = core.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            return core;
        }
        core = wording.unwrapParentheses(core.operand());
    }
    return core;
}

// The place the assignment at 'origin' writes, on one line, or an empty string.
originPlace(LiteralOrigin origin) -> string {
    let statement = origin.statement();
    if (statement is AssignmentExpressionNode) {
        return wording.oneLineSpelling(wording.unwrapParentheses(statement.target()));
    }
    return "";
}

// Whether 'value' is 'place', or a sign or arithmetic expression that reads it, so that declaring
// the place 'double' makes the whole value 'double'.
readsPlace(Expression value, string place) -> bool {
    if (place.length == 0) {
        return false;
    }
    Expression core = wording.unwrapParentheses(value);
    if (wording.oneLineSpelling(core) == place) {
        return true;
    }
    if (core is PrefixExpressionNode) {
        SyntaxKind operator = core.operator().kind();
        bool sign = operator == SyntaxKind.Plus || operator == SyntaxKind.Minus;
        return sign && readsPlace(core.operand(), place);
    }
    if (core is BinaryExpressionNode && isArithmeticOperator(core.operator().kind())) {
        return readsPlace(core.left(), place) || readsPlace(core.right(), place);
    }
    return false;
}

// Whether the type is a number type under at least one '?'.
isNullableNumber(Type type) -> bool {
    return type is OptionalType && convert.isNumericType(convert.coreOf(type));
}

// The widening of a 'float' literal too large for 'float'.
floatWidening() -> Widening {
    return new Widening(PrimitiveKind.Float, "float", "double", false, 0);
}

// Whether the type has the narrow type of 'widening' under its '?' levels.
sameCore(Type type, Widening widening) -> bool {
    Type core = convert.coreOf(type);
    return core is PrimitiveType && core.kind() == widening.narrow();
}

// Whether the type under its '?' levels takes the literal of 'widening', and every value beside a
// joined one.
takesLiteral(Type type, Widening widening) -> bool {
    Type core = convert.coreOf(type);
    if (!(core is PrimitiveType)) {
        return false;
    }
    if (widening.narrow() == PrimitiveKind.Float || widening.narrow() == PrimitiveKind.Double) {
        return core.kind() == PrimitiveKind.Double;
    }
    if (!convert.isIntegerType(core)
            || (widening.joined() && !holdsEveryValue(core.kind(), widening.narrow()))) {
        return false;
    }
    return fitsJoinLiterals(widening, core.kind());
}

// Whether the integer kind takes the literal of 'widening' and, for a joined one, every literal of
// its join.
fitsJoinLiterals(Widening widening, PrimitiveKind kind) -> bool {
    if (!literalvalues.magnitudeFits(widening.negative(), widening.magnitude(), kind)) {
        return false;
    }
    if (!widening.joined()) {
        return true;
    }
    if (widening.beyond() || !literalvalues.magnitudeFits(false, widening.high(), kind)) {
        return false;
    }
    return !widening.lowNegative() || literalvalues.magnitudeFits(true, widening.low(), kind);
}

// Adds to 'found' each untyped integer literal that is a value of the join 'value', through nested
// '?:' and switch values and, at the 'top', the elements of an array literal.
collectJoinLiterals(Expression value, List<Expression> found, bool top) {
    let leaves = new List<Expression>();
    joinLeaves(value, leaves, top);
    for (let leaf in leaves) {
        if (literaltyping.intLiteralOf(leaf) != null) {
            found.push(leaf);
        }
    }
}

// collectJoinLiterals for the values of the join that are no untyped integer literal.
collectJoinValues(Expression value, List<Expression> found, bool top) {
    let leaves = new List<Expression>();
    joinLeaves(value, leaves, top);
    for (let leaf in leaves) {
        if (literaltyping.intLiteralOf(leaf) == null) {
            found.push(leaf);
        }
    }
}

// Adds to 'found' each value of the join 'value' that is no join itself, through nested '?:' and
// switch values and, at the 'top' or inside an array literal, the elements of an array literal.
joinLeaves(Expression value, List<Expression> found, bool top) {
    Expression core = wording.unwrapParentheses(value);
    switch (core) {
        is ArrayLiteralExpressionNode array -> {
            if (!top) {
                found.push(core);
                return;
            }
            for (long i = 0; i < array.elementsCount(); i++) {
                let element = array.elements(i);
                joinLeaves(element, found, wording.unwrapParentheses(element) is ArrayLiteralExpressionNode);
            }
        },
        is TernaryExpressionNode ternary -> {
            joinLeaves(ternary.thenValue(), found, false);
            joinLeaves(ternary.elseValue(), found, false);
        },
        is SwitchExpressionNode join -> {
            for (let arm in armsOfExpression(join)) {
                let body = nullguidance.armValue(arm);
                if (body != null) {
                    joinLeaves(body, found, false);
                }
            }
        },
        default -> {
            found.push(core);
        },
    }
}

// Whether a report of 'literal' waits among 'pending', the literals nothing gave a type to.
isPendingLiteral(List<PendingLiteralRange> pending, Expression literal) -> bool {
    for (let range in pending) {
        if (range.green() == literal.green()) {
            return true;
        }
    }
    return false;
}

// Whether 'node' is an untyped integer literal among the values of the join 'root'.
isJoinLiteral(Expression root, Expression node) -> bool {
    let literals = new List<Expression>();
    collectJoinLiterals(root, literals, true);
    for (let literal in literals) {
        if (literal.green() == wording.unwrapParentheses(node).green()) {
            return true;
        }
    }
    return false;
}

// Records on 'widening' the most negative and the largest of the literals.
spanJoinLiterals(Widening widening, List<Expression> literals) {
    for (let literal in literals) {
        let token = literaltyping.intLiteralOf(literal);
        let magnitude = token == null ? null : literalvalues.integerMagnitude(token.value().text());
        if (magnitude == null) {
            widening.setBeyond(true);
        } else if (literaltyping.isNegativeLiteral(literal)
                && (!widening.lowNegative() || magnitude > widening.low())) {
            widening.setLowNegative(true);
            widening.setLow(magnitude);
        } else if (!literaltyping.isNegativeLiteral(literal) && magnitude > widening.high()) {
            widening.setHigh(magnitude);
        }
    }
    widening.setLiterals(literals);
}

// The integer type a suggestion names for the literals of a join given the type 'from': the
// narrowest wider one of the same signedness that takes every literal and every value of each kind
// in 'kinds', or else the narrowest of the other signedness at least as wide. Empty when none does.
commonIntegerHolding(PrimitiveKind from, PrimitiveKind[] kinds, Widening widening) -> string {
    if (from == PrimitiveKind.Char) {
        return "";
    }
    PrimitiveKind[] signed = [PrimitiveKind.Short, PrimitiveKind.Int, PrimitiveKind.Long];
    PrimitiveKind[] unsigned = [PrimitiveKind.UShort, PrimitiveKind.UInt, PrimitiveKind.ULong];
    PrimitiveKind[] same = signed;
    PrimitiveKind[] other = unsigned;
    if (isUnsignedKind(from)) {
        same = unsigned;
        other = signed;
    }
    long width = literaltyping.integerWidth(from);
    for (let kind in same) {
        if (literaltyping.integerWidth(kind) > width && takesJoin(kind, kinds, widening)) {
            return literaltyping.primitiveKindName(kind);
        }
    }
    for (let kind in other) {
        if (literaltyping.integerWidth(kind) >= width && takesJoin(kind, kinds, widening)) {
            return literaltyping.primitiveKindName(kind);
        }
    }
    return "";
}

// Whether the integer kind takes every literal of 'widening' and every value of each kind in 'kinds'.
takesJoin(PrimitiveKind kind, PrimitiveKind[] kinds, Widening widening) -> bool {
    for (let inner in kinds) {
        if (inner != kind && !holdsEveryValue(kind, inner)) {
            return false;
        }
    }
    return fitsJoinLiterals(widening, kind);
}

// The arm of a switch in the join 'value' whose value is 'leaf', written with 'replacement' as its
// value, or null when no switch arm has that value.
armExample(Expression value, GreenNode leaf, string replacement) -> string? {
    Expression core = wording.unwrapParentheses(value);
    switch (core) {
        is SwitchExpressionNode join -> {
            for (let arm in armsOfExpression(join)) {
                let body = nullguidance.armValue(arm);
                if (body != null && wording.unwrapParentheses(body).green() == leaf) {
                    return "{wording.armHead(arm)} -> {replacement}";
                }
                if (body != null) {
                    let inner = armExample(body, leaf, replacement);
                    if (inner != null) {
                        return inner;
                    }
                }
            }
        },
        is TernaryExpressionNode ternary -> {
            return armExample(ternary.thenValue(), leaf, replacement)
                ?? armExample(ternary.elseValue(), leaf, replacement);
        },
        default -> { },
    }
    return null;
}

// The value spelled on one line with each of its parts in 'changed' converted to the type 'into'.
spelledConverting(Expression value, List<GreenNode> changed, string into) -> string {
    for (let part in changed) {
        if (wording.unwrapParentheses(value).green() == part) {
            return wording.converted(wording.unwrapParentheses(value), into);
        }
    }
    switch (value) {
        is ParenthesizedExpressionNode inner -> {
            return "({spelledConverting(inner.inner(), changed, into)})";
        },
        is TernaryExpressionNode ternary -> {
            string then = spelledConverting(ternary.thenValue(), changed, into);
            return "{wording.oneLineSpelling(ternary.condition())} ? {then} : "
                + spelledConverting(ternary.elseValue(), changed, into);
        },
        is ArrayLiteralExpressionNode array -> {
            string elements = "";
            for (long i = 0; i < array.elementsCount(); i++) {
                if (i > 0) {
                    elements = "{elements}, ";
                }
                elements = elements + spelledConverting(array.elements(i), changed, into);
            }
            return "[{elements}]";
        },
        is SwitchExpressionNode join -> {
            string arms = "";
            for (let arm in armsOfExpression(join)) {
                let body = nullguidance.armValue(arm);
                string spelled = "...";
                if (body != null) {
                    spelled = spelledConverting(body, changed, into);
                }
                arms = "{arms} {wording.armHead(arm)} -> {spelled},";
            }
            return "switch ({wording.oneLineSpelling(join.scrutinee())}) \{{arms} \}";
        },
        default -> {
            return wording.oneLineSpelling(value);
        },
    }
}

// Whether the type is an unsigned integer type under its '?' levels.
isUnsignedCore(Type type) -> bool {
    Type core = convert.coreOf(type);
    return core is PrimitiveType && isUnsignedKind(core.kind());
}

// Whether the integer kind has no negative values.
isUnsignedKind(PrimitiveKind kind) -> bool {
    return kind == PrimitiveKind.Byte || kind == PrimitiveKind.UShort || kind == PrimitiveKind.UInt
        || kind == PrimitiveKind.ULong || kind == PrimitiveKind.Char;
}

// Whether every value of the integer kind 'inner' is a value of the integer kind 'outer'.
holdsEveryValue(PrimitiveKind outer, PrimitiveKind inner) -> bool {
    if (outer == PrimitiveKind.Char) {
        return inner == PrimitiveKind.Char;
    }
    long innerWidth = literaltyping.integerWidth(inner);
    if (inner == PrimitiveKind.Char) {
        innerWidth = 21;
    }
    if (isUnsignedKind(inner) && !isUnsignedKind(outer)) {
        return literaltyping.integerWidth(outer) > innerWidth;
    }
    if (!isUnsignedKind(inner) && isUnsignedKind(outer)) {
        return false;
    }
    return literaltyping.integerWidth(outer) >= innerWidth;
}

// The narrowest integer type with every value of the type beside a joined literal and every literal
// of its join among its values, preferring the signedness of the type beside it at each width. Empty
// when no integer type has them all.
joinedIntegerHolding(Widening widening) -> string {
    PrimitiveKind beside = widening.narrow();
    PrimitiveKind[] signed = [PrimitiveKind.Short, PrimitiveKind.Int, PrimitiveKind.Long];
    PrimitiveKind[] unsigned = [PrimitiveKind.UShort, PrimitiveKind.UInt, PrimitiveKind.ULong];
    for (long i = 0; i < 3; i++) {
        PrimitiveKind first = signed[i];
        PrimitiveKind second = unsigned[i];
        if (isUnsignedKind(beside)) {
            first = unsigned[i];
            second = signed[i];
        }
        for (let kind in [first, second]) {
            if (kind != beside && holdsEveryValue(kind, beside) && fitsJoinLiterals(widening, kind)) {
                return literaltyping.primitiveKindName(kind);
            }
        }
    }
    return "";
}

// Whether the type is 'float' under its '?' levels.
isFloatCore(Type type) -> bool {
    Type core = convert.coreOf(type);
    return core is PrimitiveType && core.kind() == PrimitiveKind.Float;
}

// The literal without its suffix, as in '3.5e38' for '3.5e38f'.
unsuffixedSpelling(Expression literal) -> string {
    string spelled = wording.oneLineSpelling(wording.unwrapParentheses(literal));
    return spelled.substring(0, spelled.length - 1);
}

// Whether the value is a number literal, or a '?:', switch, lambda, array literal or operator that
// can contain one, under its parentheses and sign.
mayAdaptLiteral(Expression value) -> bool {
    Expression core = operandCore(value);
    if (core is LiteralExpressionNode) {
        SyntaxKind kind = core.value().kind();
        return kind == SyntaxKind.FloatLiteral || kind == SyntaxKind.DoubleLiteral
            || kind == SyntaxKind.IntLiteral;
    }
    return core is TernaryExpressionNode || core is SwitchExpressionNode || core is LambdaExpressionNode
        || core is ArrayLiteralExpressionNode || core is BinaryExpressionNode;
}

// Whether the type is 'double' under its '?' levels.
isDoubleCore(Type type) -> bool {
    Type core = convert.coreOf(type);
    return core is PrimitiveType && core.kind() == PrimitiveKind.Double;
}

// The values that removing the suffix of arm 'index' makes 'double', when that arm is the only one
// that is not an untyped number literal, or an empty string otherwise.
onlyTypedArm(List<Expression> values, long index) -> string {
    for (long i = 0; i < values.length(); i++) {
        if (i != index && !isUntypedNumberLiteral(values.get(i))) {
            return "";
        }
    }
    if (values.length() == 2) {
        return "both arms";
    }
    return "all arms";
}

// Whether the untyped number literal 'literal' takes the type 'beside' has, as a floating-point
// literal takes a floating-point type and an integer literal an integer type.
joinsLiteral(Expression literal, Type beside) -> bool {
    Type core = convert.coreOf(beside);
    if (literaltyping.floatLiteralOf(wording.unwrapParentheses(literal)) != null) {
        return isTextualFloat(core);
    }
    return convert.isIntegerType(core);
}

// Whether the expression is a number literal with no suffix, which takes its type from where it
// is used.
isUntypedNumberLiteral(Expression expression) -> bool {
    Expression core = wording.unwrapParentheses(expression);
    return literaltyping.floatLiteralOf(core) != null || literaltyping.intLiteralOf(core) != null;
}

// Whether a switch has an expression arm that is not an untyped number literal.
hasTypedArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        switch (arms.get(i)) {
            is ValueArmNode arm -> {
                if (isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is TypeArmNode arm -> {
                if (isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is DefaultArmNode arm -> {
                if (isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is ErrorSwitchArmNode ignored -> { },
        }
    }
    return false;
}

// Whether an arm body is an expression that is not an untyped number literal.
isTypedArmBody(ArmBody body) -> bool {
    if (body is Expression) {
        return !isUntypedNumberLiteral(body);
    }
    return false;
}

// The binary operator a compound-assignment token stands for ('+=' gives '+'), or Invalid when
// the token is not a compound assignment.
compoundOperator(SyntaxKind token) -> SyntaxKind {
    switch (token) {
        PlusEquals -> {
            return SyntaxKind.Plus;
        },
        MinusEquals -> {
            return SyntaxKind.Minus;
        },
        StarEquals -> {
            return SyntaxKind.Star;
        },
        SlashEquals -> {
            return SyntaxKind.Slash;
        },
        PercentEquals -> {
            return SyntaxKind.Percent;
        },
        AmpersandEquals -> {
            return SyntaxKind.Ampersand;
        },
        PipeEquals -> {
            return SyntaxKind.Pipe;
        },
        CaretEquals -> {
            return SyntaxKind.Caret;
        },
        LessLessEquals -> {
            return SyntaxKind.LessLess;
        },
        GreaterGreaterEquals -> {
            return SyntaxKind.GreaterGreater;
        },
        GreaterGreaterGreaterEquals -> {
            return SyntaxKind.GreaterGreaterGreater;
        },
        default -> {
            return SyntaxKind.Invalid;
        },
    }
}

// The constant an integer switch label names: a char literal's codepoint, or an int or long
// literal's value behind an optional sign.
integerLabelValue(Expression label) -> long? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
        return literalvalues.charCodepoint(label.value().text()) as long;
    }
    let literal = literaltyping.integerLiteralOf(label, true);
    if (literal == null) {
        return null;
    }
    let magnitude = literalvalues.integerMagnitude(literal.value().text());
    if (magnitude == null) {
        return null;
    }
    long value = magnitude as long;
    if (literaltyping.isNegativeLiteral(label)) {
        return 0 - value;
    }
    return value;
}

// A string label's decoded value, so two spellings of the same string (for example "\t" and a
// literal tab) collide as a duplicate.
stringLabelText(Expression label) -> string? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.StringLiteral) {
        return literalvalues.decodeString(label.value().text());
    }
    return null;
}

shortTypeName(Type type, TypeNames names) -> string {
    let authority = types.authorityOf(type);
    if (authority != null) {
        return authority.name();
    }
    return names.of(type);
}

// The head a 'new' writes for its type.
writtenTypeName(TypeNode created, Type resolved, TypeNames names) -> string {
    if (created is NamedTypeNode) {
        return created.name().text();
    }
    return names.of(resolved);
}

// The refusal of an integer literal, spelled 'written', past the range of the narrow type of
// 'widening'. A literal a wider type takes gets 'fix'.
integerTooLarge(string written, Widening widening, string fix) -> string {
    string refusal = literaltyping.integerPastRange(written, widening.negative(), widening.narrow(),
        widening.narrowName());
    if (widening.wider().length > 0 && fix.length > 0) {
        return "{refusal} {fix}";
    }
    if (widening.wider().length == 0 && widening.negative() && widening.narrow() != PrimitiveKind.Long
            && widening.narrow() != PrimitiveKind.Char) {
        return "{refusal} It is below the smallest value of 'long' too, which is -9223372036854775808.";
    }
    return refusal;
}

// ---- The canonical fill loop ----

identName(Expression node) -> string {
    if (node is IdentifierExpressionNode) {
        return node.name().text();
    }
    return "";
}

isIntegerLiteralText(Expression node, string text) -> bool {
    if (node is LiteralExpressionNode) {
        SyntaxKind kind = node.value().kind();
        if (kind == SyntaxKind.IntLiteral || kind == SyntaxKind.LongLiteral) {
            return node.value().text() == text;
        }
    }
    return false;
}

isPlainIndexType(TypeNode reference) -> bool {
    if (reference is NamedTypeNode) {
        string name = reference.name().text();
        if (name != "long" && name != "int") {
            return false;
        }
        return reference.qualifier() == null && reference.typeArguments() == null;
    }
    return false;
}

// A step-by-one update on the index: 'i = i + 1', 'i++', or '++i'.
isUnitIncrement(Expression update, string indexName) -> bool {
    if (update is AssignmentExpressionNode) {
        if (update.operator().kind() != SyntaxKind.Equals) {
            return false;
        }
        if (identName(update.target()) != indexName) {
            return false;
        }
        return isPlusOne(update.value(), indexName);
    }
    if (update is PostfixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus && identName(update.operand()) == indexName;
    }
    if (update is PrefixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus && identName(update.operand()) == indexName;
    }
    return false;
}

isPlusOne(Expression value, string indexName) -> bool {
    if (value is BinaryExpressionNode) {
        return value.operator().kind() == SyntaxKind.Plus
            && identName(value.left()) == indexName
            && isIntegerLiteralText(value.right(), "1");
    }
    return false;
}

// Any identifier token spelling the name counts as a mention; the fill expression must
// provably never read the array.
mentionsIdentifier(GreenNode node, string name) -> bool {
    for (long i = 0; i < node.slotCount(); i++) {
        let child = node.slot(i);
        if (child == null) {
            continue;
        }
        if (child is GreenToken) {
            if (child.kind() == SyntaxKind.Identifier && child.text() == name) {
                return true;
            }
        } else if (child is GreenNode) {
            if (mentionsIdentifier(child, name)) {
                return true;
            }
        }
    }
    return false;
}

// Matches 'for (long i = 0; i < name.length; i = i + 1) { name[i] = expr; }' (the update also
// accepts 'i++' and '++i') with a fresh 'long'/'int' index and 'expr' never mentioning 'name'.
isArrayFillLoop(ForStatementNode loop, string arrayName) -> bool {
    let indexName = fillLoopIndexName(loop, arrayName);
    if (indexName == null) {
        return false;
    }
    if (!fillLoopConditionMatches(loop.condition(), arrayName, indexName)) {
        return false;
    }
    let update = loop.update();
    if (update == null || !isUnitIncrement(update, indexName)) {
        return false;
    }
    return fillLoopBodyMatches(loop.body(), arrayName, indexName);
}

// The fresh 'long'/'int' index the loop declares starting at 0, or null when the initializer
// does not match.
fillLoopIndexName(ForStatementNode loop, string arrayName) -> string? {
    let initializer = loop.initializer();
    if (initializer is VariableDeclarationNode) {
        let declaredType = initializer.declaredType();
        if (declaredType != null && !isPlainIndexType(declaredType)) {
            return null;
        }
        let initialValue = initializer.initializer();
        if (initialValue == null || !isIntegerLiteralText(initialValue.value(), "0")) {
            return null;
        }
        string indexName = initializer.name().text();
        if (indexName.length == 0 || indexName == arrayName) {
            return null;
        }
        return indexName;
    }
    return null;
}

fillLoopConditionMatches(Expression? condition, string arrayName, string indexName)
        -> bool {
    if (condition is BinaryExpressionNode) {
        if (condition.operator().kind() != SyntaxKind.Less) {
            return false;
        }
        if (identName(condition.left()) != indexName) {
            return false;
        }
        let lengthAccess = condition.right();
        if (lengthAccess is MemberExpressionNode) {
            return identName(lengthAccess.object()) == arrayName && lengthAccess.member().text() == "length";
        }
    }
    return false;
}

fillLoopBodyMatches(BlockNode body, string arrayName, string indexName) -> bool {
    if (body.statementsCount() != 1) {
        return false;
    }
    let statement = body.statements(0);
    if (statement is ExpressionStatementNode) {
        let assignment = statement.expression();
        if (assignment is AssignmentExpressionNode) {
            if (assignment.operator().kind() != SyntaxKind.Equals) {
                return false;
            }
            let slot = assignment.target();
            if (slot is SubscriptExpressionNode) {
                if (identName(slot.object()) != arrayName || identName(slot.index()) != indexName) {
                    return false;
                }
                return !mentionsIdentifier(assignment.value().green(), arrayName);
            }
        }
    }
    return false;
}

// The element type argument when the type is an 'Iterable<T>' instantiation from
// '@std.collections.iterator'.
iterableArgument(Type candidate) -> Type? {
    if (candidate is InstantiationType) {
        let template = candidate.template();
        if (template is InterfaceType && template.name() == "Iterable"
                && template.modulePath() == "std.collections.iterator"
                && candidate.arguments().length > 0) {
            return candidate.arguments()[0];
        }
    }
    return null;
}

// A recovery arm is dropped: the parser could not read what was written there, so there is nothing
// for the checker to reason about, and the syntax error already says so.
armsOfStatement(SwitchStatementNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        if (!(node.arms(i) is ErrorSwitchArmNode)) {
            arms.push(node.arms(i));
        }
    }
    return arms;
}

public armsOfExpression(SwitchExpressionNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        if (!(node.arms(i) is ErrorSwitchArmNode)) {
            arms.push(node.arms(i));
        }
    }
    return arms;
}

// Whether a call with 'count' arguments can reach 'method', counting its optional parameters.
takesArgumentCount(Method method, long count) -> bool {
    return count >= typemembers.requiredParameterCount(method.signature())
        && count <= method.signature().parameters().length;
}
