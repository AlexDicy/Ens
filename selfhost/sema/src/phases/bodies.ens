// Checks every body of every module. Modules reach each other only through the type store, the
// link tables, and the other modules' function tables (for namespace-qualified calls and for the
// prelude).
public checkBodies(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let contextsByPath = new Map<string, ModuleContext>();
    for (long i = 0; i < contexts.length(); i++) {
        contextsByPath.set(contexts.get(i).module().canonicalPath(), contexts.get(i));
    }
    let preludeScope = prelude.scopeOver(implicit.implicitImportPaths(), contextsByPath);
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new BodyChecker(contexts.get(i), contextsByPath, preludeScope, collected);
        checker.run();
        for (let diagnostic in contexts.get(i).resolver().takeDiagnostics()) {
            collected.push(diagnostic);
        }
    }
    return diagnostics.sorted(collected);
}

// What an unqualified name means at a use site, innermost scope first.
public sealed abstract class NameResolution {
}

public final class LocalName extends NameResolution {
    protected LocalBinding localBinding;

    protected constructor(this.localBinding);

    public binding() -> LocalBinding {
        return this.localBinding;
    }
}

// The type parameter in scope under the name, which takes that name for the whole of the
// declaration introducing it, ahead of everything the file declares or imports under it.
public final class TypeParameterName extends NameResolution {
    protected TypeParamType typeParameter;

    protected constructor(this.typeParameter);

    public parameter() -> TypeParamType {
        return this.typeParameter;
    }
}

// The entries a call to this name could reach, and the prelude match they came from when they
// came from there rather than from the module's own function table.
public final class FunctionName extends NameResolution {
    protected List<FunctionEntry> functionEntries;
    protected PreludeMatch? preludeMatch;

    protected constructor(this.functionEntries, this.preludeMatch);

    public entries() -> List<FunctionEntry> {
        return this.functionEntries;
    }

    public fromPrelude() -> PreludeMatch? {
        return this.preludeMatch;
    }
}

public final class TypeName extends NameResolution {
    protected DeclaredType declaredTarget;

    protected constructor(this.declaredTarget);

    public target() -> DeclaredType {
        return this.declaredTarget;
    }
}

// The module an imported name stands for, and the path the import that binds it wrote, which is
// how a diagnostic in the file names the module.
public final class NamespaceName extends NameResolution {
    protected string namespacePath;
    protected string namespaceImportPath;

    protected constructor(this.namespacePath, this.namespaceImportPath);

    public targetModulePath() -> string {
        return this.namespacePath;
    }

    public importPath() -> string {
        return this.namespaceImportPath;
    }
}

// What a frame holds, as one value, so that a copy of the frame copies all of it. A field refers only
// to an object nothing changes once the field holds it.
struct FrameState {
    Scope? parameterBindings = null;
    LocalBinding? receiverBinding = null;
    Type? receiverType = null;
    // The class or struct whose member body is being checked, statics included; the access
    // rules judge private and protected members from here. Null outside member bodies.
    Type? owningType = null;
    bool isStatic = false;
    // True while a callable's body is being checked, and false in a field default, a parameter
    // default, or a lazy const's initializer, none of which declares a parameter.
    bool inBody = false;
    // The name of the field whose default is being checked, and null outside a field default.
    string? defaultedField = null;
    // The name of the lazy const whose initializer is being checked, and null outside one.
    string? initializedLazyConstant = null;
    // The name of the parameter whose default is being checked, and null outside a parameter default.
    string? defaultedParameter = null;
    // The callable whose body is being checked, and null outside a callable body.
    SyntaxNode? callableNode = null;
    // The innermost lambda this frame is the body of, or null outside every lambda.
    LambdaExpressionNode? lambdaNode = null;
    // True in a callable body and in a lambda body written as a block. A statement can go there.
    bool allowsStatements = false;
    // The parameters in reach of the expression being checked, in declaration order, with an
    // enclosing callable's ahead of a lambda's own, for a diagnostic that names a value of a
    // type. Empty where the position has none.
    List<LocalBinding> reachableParameters = new List<LocalBinding>();

    Type? returnType = null;
    // Where the return type of the callable being checked is declared, for a returned literal that
    // does not fit it. Null where no code can change it in one edit.
    LiteralOrigin? returnOrigin = null;
    // What a 'return' refusal names as returning, as in "Function 'first'", and the name and parameters
    // a void one offers to declare a return type after, empty where none can be declared.
    string returnSubject = "This function";
    string returnHeader = "";
    bool isNoreturnBody = false;
    bool inConstructorBody = false;
    // True in a constructor body and in every lambda written inside one.
    bool withinConstructor = false;
    // The struct method whose body is checked when it is not 'mutating', so it may not change
    // 'this', and null in every other body. Its first change to 'this' is reported once.
    Method? unmarkedStructMethod = null;
    bool reportedUnmarkedChange = false;

    bool inCatch = false;
    long loopNesting = 0;
    // True while a loop condition is analyzed. A copy made before the loop never changes there.
    bool withinLoopCondition = false;
}

// The callable whose body is being checked: its parameters and receiver, what a 'return' in it
// is held to, and the loops and catch clause the checked code is in.
public final class CallableFrame {
    FrameState state;

    // The frame of code outside any callable body, such as a field default, inside 'owner' or
    // inside no type.
    public constructor(Type? owner) {
        this.state = { owningType: owner };
    }

    // The frame of a callable's body, before any of its parameters is bound.
    public constructor(Scope parameterScope, LocalBinding? thisBinding, Type? thisType, Type? owner,
                SyntaxNode callable, Type returnType, LiteralOrigin? returnOrigin, string returnSubject,
                string returnHeader, bool isStatic, bool isNoreturn, bool isConstructor) {
        this.state = {
            parameterBindings: parameterScope,
            receiverBinding: thisBinding,
            receiverType: thisType,
            owningType: owner,
            isStatic: isStatic,
            inBody: true,
            callableNode: callable,
            allowsStatements: true,
            returnType: returnType,
            returnOrigin: returnOrigin,
            returnSubject: returnSubject,
            returnHeader: returnHeader,
            isNoreturnBody: isNoreturn,
            inConstructorBody: isConstructor,
            withinConstructor: isConstructor,
        };
    }

    constructor(FrameState state) {
        this.state = state;
    }

    // A lambda body's frame: the return, constructor, loop and catch state start over, a block body
    // allows statements and is the callable when none encloses it, and the rest carries in.
    public forLambda(LambdaExpressionNode lambda, Type returnType, LiteralOrigin? returnOrigin)
            -> CallableFrame {
        bool statements = lambda.body() is BlockNode;
        SyntaxNode? callable = this.state.callableNode;
        if (statements && callable == null) {
            callable = lambda;
        }
        FrameState derived = {
            parameterBindings: this.state.parameterBindings,
            receiverBinding: this.state.receiverBinding,
            receiverType: this.state.receiverType,
            owningType: this.state.owningType,
            isStatic: this.state.isStatic,
            inBody: this.state.inBody,
            defaultedField: this.state.defaultedField,
            initializedLazyConstant: this.state.initializedLazyConstant,
            defaultedParameter: this.state.defaultedParameter,
            callableNode: callable,
            lambdaNode: lambda,
            allowsStatements: statements,
            reachableParameters: this.state.reachableParameters,
            returnType: returnType,
            returnOrigin: returnOrigin,
            returnSubject: "This lambda",
            withinConstructor: this.state.withinConstructor,
        };
        return new CallableFrame(derived);
    }

    // A frame equal to this one, which code a trial analyzes can change without changing this one.
    public copy() -> CallableFrame {
        return new CallableFrame(this.state);
    }

    public parameterScope() -> Scope? {
        return this.state.parameterBindings;
    }

    public thisBinding() -> LocalBinding? {
        return this.state.receiverBinding;
    }

    public thisType() -> Type? {
        return this.state.receiverType;
    }

    public enclosingOwner() -> Type? {
        return this.state.owningType;
    }

    public inStaticMethod() -> bool {
        return this.state.isStatic;
    }

    // The struct method whose body may not change 'this', or null where the body may.
    public unmarkedMethod() -> Method? {
        return this.state.unmarkedStructMethod;
    }

    public refuseChangesToThis(Method method) {
        this.state.unmarkedStructMethod = method;
    }

    // True for the first change to 'this' that the body reports, and false after it.
    public firstUnmarkedChange() -> bool {
        if (this.state.reportedUnmarkedChange) {
            return false;
        }
        this.state.reportedUnmarkedChange = true;
        return true;
    }

    public inCallableBody() -> bool {
        return this.state.inBody;
    }

    public fieldDefaultName() -> string? {
        return this.state.defaultedField;
    }

    public lazyConstantName() -> string? {
        return this.state.initializedLazyConstant;
    }

    public parameterDefaultName() -> string? {
        return this.state.defaultedParameter;
    }

    public callableSyntax() -> SyntaxNode? {
        return this.state.callableNode;
    }

    public innermostLambda() -> LambdaExpressionNode? {
        return this.state.lambdaNode;
    }

    public statementsAllowed() -> bool {
        return this.state.allowsStatements;
    }

    public parametersInReach() -> List<LocalBinding> {
        return this.state.reachableParameters;
    }

    // Puts 'binding' in reach after the parameters already in reach. The list grows as a new list,
    // since a copy of this frame may hold the one it replaces.
    public addParameterInReach(LocalBinding binding) {
        let added = this.state.reachableParameters.copy();
        added.push(binding);
        this.state.reachableParameters = added;
    }

    public currentReturnType() -> Type? {
        return this.state.returnType;
    }

    public currentReturnOrigin() -> LiteralOrigin? {
        return this.state.returnOrigin;
    }

    public currentReturnSubject() -> string {
        return this.state.returnSubject;
    }

    public currentReturnHeader() -> string {
        return this.state.returnHeader;
    }

    public currentNoreturn() -> bool {
        return this.state.isNoreturnBody;
    }

    public inConstructor() -> bool {
        return this.state.inConstructorBody;
    }

    public enclosedByConstructor() -> bool {
        return this.state.withinConstructor;
    }

    public inCatchClause() -> bool {
        return this.state.inCatch;
    }

    public loopDepth() -> long {
        return this.state.loopNesting;
    }

    public inLoopCondition() -> bool {
        return this.state.withinLoopCondition;
    }

    public setFieldDefaultName(string name) {
        this.state.defaultedField = name;
    }

    public setLazyConstantName(string name) {
        this.state.initializedLazyConstant = name;
    }

    public setParameterDefaultName(string name) {
        this.state.defaultedParameter = name;
    }

    public setStatementsAllowed(bool allowed) {
        this.state.allowsStatements = allowed;
    }

    public enterLoop() {
        this.state.loopNesting++;
    }

    public leaveLoop() {
        this.state.loopNesting--;
    }

    public enterLoopCondition() {
        this.state.withinLoopCondition = true;
    }

    public leaveLoopCondition() {
        this.state.withinLoopCondition = false;
    }

    public enterCatchClause() {
        this.state.inCatch = true;
    }

    public leaveCatchClause() {
        this.state.inCatch = false;
    }
}

// The scope, narrowing, 'is' test hints, frame and definite-assignment state outside a lambda, kept
// while its body is checked.
public final class OuterLambdaState {
    protected Scope? outerScope;
    protected NarrowingState outerNarrowing;
    protected Map<NarrowingPath, string> outerCastHints;
    protected CallableFrame outerFrame;
    protected AssignmentState outerAssignment;

    protected constructor(this.outerScope, this.outerNarrowing, this.outerCastHints, this.outerFrame,
                          this.outerAssignment);
}

public final class BodyChecker implements NoreturnCalls {
    ModuleContext moduleContext;
    Map<string, ModuleContext> contextsByModulePath;
    PreludeScope programPrelude;
    TypeResolver typeResolver;
    TypeStore typeStore;
    SemaResult semaResult;
    Reporter bodyReporter;
    TypeNames typeNames;
    TypeNames scopedNames;
    string scopedNamesKey;
    string canonicalModulePath;
    string modulePackagePrefix;

    Scope? scope;
    CallableFrame callableFrame;
    // The lambdas whose bodies are being checked, outermost first. Empty in ordinary code; a
    // name the innermost one does not declare itself is a capture.
    List<LambdaFrame> lambdaFrameStack;
    NarrowingState narrowingState;
    // The 'const' locals declared without a type, and the values 'is' arms matched. A refused write to
    // a constant local gives each its own fix.
    List<LocalBinding> untypedConstantLocals;
    List<LocalBinding> matchedArmBindings;
    // The for-each loops, whose variables are copies of the elements they walk.
    List<ForEachStatementNode> walkedLoops;
    LiteralTargets literalTargets;

    AssignmentState assignmentState;

    Set<GreenNode> fillProvenNews;
    Map<GreenNode, string> arrayNewNames;
    // The parts of overloaded calls' arguments analyzed while their candidates are ranked, which are not
    // analyzed again once the chosen candidate types the argument.
    Set<GreenNode> rankedValues;
    // The parts of calls' arguments analyzed against their parameters where they are written, before
    // the candidate or the type arguments are known, which are not analyzed again once they are.
    Set<GreenNode> placedValues;
    // The lambdas passed to calls that check them once the candidate or the type arguments are known,
    // with what holds where each one is created, which its body starts from.
    Map<GreenNode, LambdaStart> lambdaStarts;
    // Whether this checker runs a trial, which analyzes each part of the code it is given once.
    bool trialChecker;
    // The candidates trials chose for calls, which a call takes without a trial of its own where the
    // narrowing its trial started from holds again. The trials this checker starts share them.
    Map<GreenNode, TrialChoice> trialChoices;
    // The expression being analyzed whose value nothing reads, such as an expression statement.
    GreenNode? discardedValue;
    // The whole value of the initializer, the assignment or the return being analyzed.
    GreenNode? wholeValue;
    // The 'is' tests to write for comparisons of 'as?' casts with null, by the path a test narrows.
    Map<NarrowingPath, string> castHints;

    ObligationRegistry deferredObligations;
    GreenNode? obligationOwner;
    string genericOwnerName;
    string obligationOwnerDisplay;

    protected constructor(ModuleContext context, Map<string, ModuleContext> contextsByPath,
                PreludeScope preludeScope, List<FileDiagnostic> collected) {
        this.moduleContext = context;
        this.contextsByModulePath = contextsByPath;
        this.programPrelude = preludeScope;
        this.typeResolver = context.resolver();
        this.typeStore = context.resolver().typeStore();
        this.semaResult = context.result();
        this.bodyReporter = new Reporter(context.module().filePath(), collected);
        this.typeNames = context.names();
        this.scopedNames = this.typeNames;
        this.scopedNamesKey = "";
        this.canonicalModulePath = context.module().canonicalPath();
        this.modulePackagePrefix = context.module().packagePrefix();
        this.lambdaFrameStack = new List<LambdaFrame>();
        this.narrowingState = new NarrowingState();
        this.callableFrame = new CallableFrame(null);
        this.untypedConstantLocals = new List<LocalBinding>();
        this.literalTargets = new LiteralTargets();
        this.matchedArmBindings = new List<LocalBinding>();
        this.walkedLoops = new List<ForEachStatementNode>();
        this.assignmentState = new AssignmentState(this.bodyReporter, this.typeNames);
        this.fillProvenNews = new Set<GreenNode>();
        this.arrayNewNames = new Map<GreenNode, string>();
        this.rankedValues = new Set<GreenNode>();
        this.placedValues = new Set<GreenNode>();
        this.lambdaStarts = new Map<GreenNode, LambdaStart>();
        this.trialChecker = false;
        this.trialChoices = new Map<GreenNode, TrialChoice>();
        this.discardedValue = null;
        this.wholeValue = null;
        this.castHints = new Map<NarrowingPath, string>();
        this.deferredObligations = context.obligations();
        this.obligationOwner = null;
        this.genericOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    // Starts a trial: a checker for code written where this one checks, which finds the types that code
    // gives, while endTrial() undoes what it records. It shares the scope and the trial choices, copies
    // the frame, the lambdas, the narrowing and the lambda starts, and starts the rest over.
    public trial() -> BodyChecker {
        let trial = new BodyChecker(this.moduleContext, this.contextsByModulePath, this.programPrelude,
            new List<FileDiagnostic>());
        trial.trialChecker = true;
        trial.deferredObligations = new ObligationRegistry();
        trial.scope = this.scope;
        trial.callableFrame = this.callableFrame.copy();
        for (let frame in this.lambdaFrameStack) {
            trial.lambdaFrameStack.push(frame.copy());
        }
        trial.narrowingState = this.narrowingState.copy();
        trial.lambdaStarts = this.lambdaStarts.copy();
        trial.trialChoices = this.trialChoices;
        trial.discardedValue = this.discardedValue;
        trial.wholeValue = this.wholeValue;
        trial.obligationOwner = this.obligationOwner;
        trial.genericOwnerName = this.genericOwnerName;
        trial.obligationOwnerDisplay = this.obligationOwnerDisplay;
        this.typeResolver.beginTrial();
        this.semaResult.beginTrial();
        return trial;
    }

    // Ends the trial the latest trial() started.
    public endTrial() {
        this.typeResolver.endTrial();
        this.semaResult.endTrial();
    }

    // Whether this checker runs a trial, which needs only the types code gives and what it changes. A
    // call in a trial analyzes each argument once, where it is written, and checks no lambda it passes.
    public inTrial() -> bool {
        return this.trialChecker;
    }

    // Records what holds here as the start of 'lambda', an argument that its call checks once the
    // candidate or the type arguments are known, after the arguments written after it.
    public noteLambdaStart(LambdaExpressionNode lambda) {
        this.lambdaStarts.set(lambda.green(), new LambdaStart(this.assignmentState.snapshot()));
    }

    // The start recorded for 'lambda', which is then no longer recorded, or null where none is.
    public takeLambdaStart(LambdaExpressionNode lambda) -> LambdaStart? {
        if (this.lambdaStarts.isEmpty()) {
            return null;
        }
        let start = this.lambdaStarts.get(lambda.green());
        if (start != null) {
            this.lambdaStarts.remove(lambda.green());
        }
        return start;
    }

    // Records 'choice', the candidate a trial chose for 'call'.
    public recordTrialChoice(GreenNode call, TrialChoice choice) {
        this.trialChoices.set(call, choice);
    }

    // The candidate a trial chose for 'call', which is then no longer recorded, or null where none did.
    public takeTrialChoice(GreenNode call) -> TrialChoice? {
        if (this.trialChoices.isEmpty()) {
            return null;
        }
        let choice = this.trialChoices.get(call);
        if (choice != null) {
            this.trialChoices.remove(call);
        }
        return choice;
    }

    // Analyzes 'part', a part of an argument, against 'target', its parameter's type, where it is written.
    // Typing the argument once the call is resolved uses the type found here.
    public placeArgument(Expression part, Type target, LiteralOrigin? origin = null) -> Type {
        Type placed = this.analyzeExpressionAdapt(part, target, origin);
        this.placedValues.add(part.green());
        return placed;
    }

    public context() -> ModuleContext {
        return this.moduleContext;
    }

    public contextsByPath() -> Map<string, ModuleContext> {
        return this.contextsByModulePath;
    }

    public preludeScope() -> PreludeScope {
        return this.programPrelude;
    }

    public resolver() -> TypeResolver {
        return this.typeResolver;
    }

    public store() -> TypeStore {
        return this.typeStore;
    }

    public result() -> SemaResult {
        return this.semaResult;
    }

    public reporter() -> Reporter {
        return this.bodyReporter;
    }

    // The file's names for types, with the type parameters in scope here hiding a type of the same
    // name.
    public names() -> TypeNames {
        string[] parameters = this.typeResolver.typeParameterNamesInScope();
        if (parameters.length == 0) {
            return this.typeNames;
        }
        string key = string.joined(parameters, ",");
        if (key != this.scopedNamesKey) {
            this.scopedNames = this.typeNames.withTypeParameters(parameters);
            this.scopedNamesKey = key;
        }
        return this.scopedNames;
    }

    public modulePath() -> string {
        return this.canonicalModulePath;
    }

    public packagePrefix() -> string {
        return this.modulePackagePrefix;
    }

    public narrowing() -> NarrowingState {
        return this.narrowingState;
    }

    // The innermost scope of the body being checked, or null outside one.
    public currentScope() -> Scope? {
        return this.scope;
    }

    public frame() -> CallableFrame {
        return this.callableFrame;
    }

    public assignment() -> AssignmentState {
        return this.assignmentState;
    }

    public targets() -> LiteralTargets {
        return this.literalTargets;
    }

    public untypedConstants() -> List<LocalBinding> {
        return this.untypedConstantLocals;
    }

    public armBindings() -> List<LocalBinding> {
        return this.matchedArmBindings;
    }

    public forEachLoops() -> List<ForEachStatementNode> {
        return this.walkedLoops;
    }

    public lambdaFrames() -> List<LambdaFrame> {
        return this.lambdaFrameStack;
    }

    // Saves the state outside a lambda and starts the lambda's own: 'lambdaFrame' on the frame stack, an
    // empty scope, narrowing and set of 'is' test hints, the frame 'inner', and the assignment state the
    // lambda derives.
    public enterLambda(LambdaFrame lambdaFrame, CallableFrame inner) -> OuterLambdaState {
        let outer = new OuterLambdaState(this.scope, this.narrowingState, this.castHints,
            this.callableFrame, this.assignmentState);
        this.lambdaFrameStack.push(lambdaFrame);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        this.castHints = new Map<NarrowingPath, string>();
        this.callableFrame = inner;
        this.assignmentState = outer.outerAssignment.forLambda();
        return outer;
    }

    // Ends a lambda's body: drops its frame and restores the state 'enterLambda' saved.
    public leaveLambda(OuterLambdaState outer) {
        this.lambdaFrameStack.pop();
        this.scope = outer.outerScope;
        this.narrowingState = outer.outerNarrowing;
        this.castHints = outer.outerCastHints;
        this.callableFrame = outer.outerFrame;
        this.assignmentState = outer.outerAssignment;
    }

    // Starts checking a body under 'scope', a fresh narrowing and the frame 'frame', and returns the frame
    // it replaces, for 'leaveBody'.
    public enterBody(Scope? scope, CallableFrame frame) -> CallableFrame {
        this.scope = scope;
        this.narrowingState = new NarrowingState();
        let outer = this.callableFrame;
        this.callableFrame = frame;
        return outer;
    }

    // Ends a body 'enterBody' started: no scope, and 'outer' as the frame again.
    public leaveBody(CallableFrame outer) {
        this.scope = null;
        this.callableFrame = outer;
    }

    // Opens a catch clause's scope inside the parameter scope, so the body's locals stay out of it.
    public enterCatchScope() {
        this.scope = new Scope(this.frame().parameterScope());
    }

    // Closes a catch clause's scope, back to the parameter scope.
    public leaveCatchScope() {
        this.scope = this.frame().parameterScope();
    }

    // Records 'name' as the local the array 'new' expression 'node' initializes, for refusal wording.
    public noteArrayNewName(GreenNode node, string name) {
        this.arrayNewNames.set(node, name);
    }

    // The local the array 'new' expression 'node' initializes, or null where it initializes none.
    public arrayNewName(GreenNode node) -> string? {
        return this.arrayNewNames.get(node);
    }

    // Records that the canonical fill loop following the array 'new' expression 'node' assigns every element.
    public noteFillProven(GreenNode node) {
        this.fillProvenNews.add(node);
    }

    // Whether a canonical fill loop assigns every element of the array 'new' expression 'node'.
    public isFillProven(GreenNode node) -> bool {
        return this.fillProvenNews.contains(node);
    }

    protected run() {
        let root = this.context().root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    declarations.checkTopLevelFunction(this, declaration);
                },
                is StructDeclarationNode declaration -> {
                    declarations.checkStructBodies(this, declaration);
                },
                is ClassDeclarationNode declaration -> {
                    declarations.checkClassBodies(this, declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    declarations.checkPrimitiveBindingBodies(this, declaration);
                },
                is TestDeclarationNode declaration -> {
                    declarations.checkTestBody(this, declaration);
                },
                default -> { },
            }
        }
        valuejoins.reportPendingLiteralRanges(this);
    }

    // Deferred judgments and open generic calls found while checking a generic template's or
    // generic function's bodies record against that owner, keyed by its declaration node.
    public enterObligationOwner(DeclaredType found) {
        if (found.isGeneric()) {
            this.obligationOwner = found.declaration();
            this.genericOwnerName = found.name();
            this.obligationOwnerDisplay = this.names().quoted(found);
        }
    }

    // Records the deferred judgments and open generic calls of the generic function 'declaration' against
    // it while its body is checked. 'name' and 'display' are its name and its quoted spelling with type
    // parameters.
    public enterFunctionObligationOwner(GreenNode declaration, string name, string display) {
        this.obligationOwner = declaration;
        this.genericOwnerName = name;
        this.obligationOwnerDisplay = display;
    }

    public leaveObligationOwner() {
        this.obligationOwner = null;
        this.genericOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    public obligationOwnerName() -> string {
        return this.genericOwnerName;
    }

    public recordObligation(Obligation obligation) {
        let owner = this.obligationOwner;
        if (owner != null) {
            obligation.setGuards(this.activeGuardsFor(owner));
            obligation.setOwnerDisplay(this.obligationOwnerDisplay);
            this.deferredObligations.recordObligation(owner, this.context().module().filePath(),
                obligation);
        }
    }

    public recordGenericCall(Signature signature, Type[] arguments, Span at) {
        bool open = false;
        for (let argument in arguments) {
            if (convert.containsTypeParam(argument)) {
                open = true;
            }
        }
        if (!open) {
            this.deferredObligations.recordConcreteCall(signature, arguments,
                new Origin(this.context().module().filePath(), at,
                    obligations.quotedCall(signature.name(), arguments, this.names())));
            return;
        }
        let owner = this.obligationOwner;
        if (owner != null) {
            this.deferredObligations.recordOpenCall(owner, this.context().module().filePath(),
                signature, arguments, this.activeGuardsFor(owner),
                new Origin(this.context().module().filePath(), at,
                    obligations.quotedCall(signature.name(), arguments, this.names())));
        }
    }

    // The active conditional member's constraints, as guards for a deferred judgment, when the
    // constrained declaration is the obligation's owner itself.
    activeGuardsFor(GreenNode owner) -> MemberConstraint[] {
        if (this.resolver().activeConstraintOwner() == owner) {
            return this.resolver().activeConstraints();
        }
        return [];
    }

    // A call ends the path when its target is declared 'noreturn' (the builtin 'panic' among
    // them). 'try noreturnCall()' also ends it: the call either throws or never returns.
    public override callNeverReturns(Expression expression) -> bool {
        Expression core = syntax.unwrapParentheses(expression);
        if (core is TryExpressionNode) {
            core = syntax.unwrapParentheses(core.operand());
        }
        if (!(core is CallExpressionNode)) {
            return false;
        }
        let target = this.unconditionalCalleeOf(core);
        return target != null && target.isNoreturn();
    }

    // True when 'expression' never returns: a call that never returns, or a '?:' or a switch whose
    // every value never returns.
    public neverReturns(Expression expression) -> bool {
        return flow.neverReturns(expression, this);
    }

    // Ends the path after 'value' when it never returns, so no value of it is ever read, and
    // records that so code generation ends the path there too.
    public endPathIfNeverReturns(Expression value) {
        if (this.neverReturns(value)) {
            this.result().setNeverReturns(value.green());
            this.assignment().terminate();
        }
    }

    // The static target a call always runs, or null for a constructor chain, an unresolved callee,
    // or a safe call 'object?.method()', which runs nothing when the object is null.
    unconditionalCalleeOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.result().callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.result().methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.result().callableOf(member.green());
            },
            default -> {
                return null;
            },
        }
    }

    // ---- Scopes and names ----

    public enterScope() {
        this.scope = new Scope(this.scope);
        this.narrowingState.push();
    }

    public leaveScope() {
        let current = this.scope;
        if (current != null) {
            this.scope = current.parent();
        }
        this.narrowingState.pop();
    }

    public lookupBinding(string name) -> LocalBinding? {
        let current = this.scope;
        if (current == null) {
            return null;
        }
        let own = current.lookup(name);
        if (own != null) {
            return own;
        }
        return lambdas.lookupCapture(this, name);
    }

    // The binding 'lookupBinding' finds for 'name', without recording a lambda capture.
    public visibleBinding(string name) -> LocalBinding? {
        let current = this.scope;
        if (current == null) {
            return null;
        }
        return current.lookup(name) ?? lambdas.outerBinding(this, name);
    }

    // Unqualified name resolution, innermost declaration first: local scopes, then a type
    // parameter in scope, then the module's functions, then a type this file declares, then the
    // file's imports, then the prelude's functions, then the implicit exception base class.
    public resolveName(string name) -> NameResolution? {
        let binding = this.lookupBinding(name);
        if (binding != null) {
            return new LocalName(binding);
        }
        let parameter = this.resolver().typeParameterNamed(name);
        if (parameter != null) {
            return new TypeParameterName(parameter);
        }
        return this.resolveNameOutsideTypeParameters(name);
    }

    // What the name means to the file, with the type parameters in scope left out. A refused
    // type parameter reads this to name the meaning it took the name from.
    public resolveNameOutsideTypeParameters(string name) -> NameResolution? {
        let entries = this.context().functions().entriesNamed(name);
        if (entries != null && entries.length() > 0) {
            return new FunctionName(entries, null);
        }
        let declared = this.store().findDeclared(this.modulePath(), name);
        if (declared != null) {
            return new TypeName(declared);
        }
        let imported = this.context().linkTable().binding(name);
        if (imported is ImportedType) {
            return new TypeName(imported.target());
        }
        if (imported is ImportedNamespace) {
            return new NamespaceName(imported.modulePath(), imported.importPath());
        }
        let offered = this.preludeScope().match(name, this.modulePath(), this.packagePrefix());
        if (offered != null) {
            return new FunctionName(offered.entries(), offered);
        }
        if (name == "Error") {
            let errorClass = this.resolver().errorClass();
            if (errorClass != null) {
                return new TypeName(errorClass);
            }
        }
        return null;
    }

    // True when a local declared here as 'name' would hide nothing: the name is no keyword and
    // means nothing in scope. Unlike 'resolveName', it records no lambda capture.
    public isFreeName(string name) -> bool {
        let current = this.scope;
        if (current != null && current.lookup(name) != null) {
            return false;
        }
        return kind.keywordFromText(name) == null && !lambdas.isOuterName(this, name)
            && this.resolver().typeParameterNamed(name) == null
            && this.resolveNameOutsideTypeParameters(name) == null;
    }

    // ---- Statements ----

    public walkBlock(BlockNode block) {
        for (long i = 0; i < block.statementsCount(); i++) {
            construction.noteArrayFillLoop(this, block, i);
            this.walkStatement(block.statements(i));
        }
    }

    public walkScopedBlock(BlockNode block) {
        this.enterScope();
        this.walkBlock(block);
        this.leaveScope();
    }

    walkStatement(Statement statement) {
        let outer = this.wholeValue;
        this.wholeValue = wholeValueOf(statement);
        this.walkStatementKind(statement);
        this.wholeValue = outer;
    }

    walkStatementKind(Statement statement) {
        switch (statement) {
            is BlockNode block -> {
                this.walkScopedBlock(block);
            },
            is VariableDeclarationNode declaration -> {
                statements.checkVariableDeclaration(this, declaration);
            },
            is IfStatementNode conditional -> {
                statements.checkIfStatement(this, conditional);
            },
            is WhileStatementNode loop -> {
                statements.checkWhileStatement(this, loop);
            },
            is ForStatementNode loop -> {
                statements.checkForStatement(this, loop);
            },
            is ForEachStatementNode loop -> {
                statements.checkForEachStatement(this, loop);
            },
            is BreakStatementNode broken -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'break' can only be used inside a loop. Remove 'break', or "
                        + "{statements.leaveAdvice(this)}.", broken.span());
                }
                this.assignment().noteBreak();
            },
            is ContinueStatementNode continued -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'continue' can only be used inside a loop. Remove 'continue', "
                        + "or {statements.leaveAdvice(this)}.", continued.span());
                }
                this.assignment().terminate();
            },
            is ReturnStatementNode returned -> {
                if (this.assignment().constructorFieldOwner() != null) {
                    this.assignment().finishConstructorAtReturn(returned.returnKeyword().span());
                }
                statements.checkReturnStatement(this, returned);
                this.assignment().terminate();
            },
            is ExpressionStatementNode expression -> {
                this.assignment().setUnconditionalPosition(true);
                this.analyzeDiscarded(expression.expression());
                this.endPathIfNeverReturns(expression.expression());
            },
            is ThrowStatementNode thrown -> {
                statements.checkThrowStatement(this, thrown);
                this.assignment().noteThrowEscapePoint(thrown, this.frame().inCatchClause());
                this.assignment().terminate();
            },
            is RethrowStatementNode rethrown -> {
                if (!this.frame().inCatchClause()) {
                    this.reporter().report("'rethrow' can only be used inside a 'catch' clause, where it "
                        + "throws the error that clause caught. Remove 'rethrow', or write 'throw' with the "
                        + "error to throw instead.", rethrown.span());
                    let lambda = this.frame().innermostLambda();
                    let callable = this.frame().callableSyntax();
                    if (lambda != null) {
                        this.result().setRefusedRethrow(lambda.green());
                    } else if (callable != null) {
                        this.result().setRefusedRethrow(callable.green());
                    }
                }
                this.assignment().terminate();
            },
            is SwitchStatementNode switched -> {
                switches.checkSwitchArms(this, switched.scrutinee(), switches.armsOfStatement(switched),
                    switched.switchKeyword().span(), false, null);
            },
            default -> { },
        }
    }

    // ---- Expressions ----

    public analyzeExpression(Expression node) -> Type {
        if (this.takeRanked(node)) {
            return this.recordedType(node);
        }
        Type analyzed = this.analyzeExpressionInner(node);
        this.result().setType(node.green(), analyzed);
        return analyzed;
    }

    analyzeExpressionInner(Expression node) -> Type {
        switch (node) {
            is LiteralExpressionNode literal -> {
                return literaltyping.analyzeLiteral(this, literal);
            },
            is IdentifierExpressionNode identifier -> {
                return identifiers.analyzeIdentifier(this, identifier);
            },
            is ThisExpressionNode keyword -> {
                return identifiers.analyzeThis(this, keyword);
            },
            is SuperExpressionNode keyword -> {
                return identifiers.analyzeSuper(this, keyword);
            },
            is BinaryExpressionNode binary -> {
                return operators.analyzeBinary(this, binary);
            },
            is PrefixExpressionNode prefix -> {
                return operators.analyzePrefix(this, prefix);
            },
            is PostfixExpressionNode postfix -> {
                return operators.analyzePostfix(this, postfix);
            },
            is CallExpressionNode call -> {
                return functioncalls.analyzeCall(this, call, null);
            },
            is GenericNameExpressionNode generic -> {
                return staticmembers.analyzeGenericNameValue(this, generic);
            },
            is MemberExpressionNode member -> {
                return memberaccess.analyzeMemberValue(this, member);
            },
            is SafeMemberExpressionNode member -> {
                return memberaccess.analyzeSafeMemberValue(this, member);
            },
            is SubscriptExpressionNode subscript -> {
                return memberaccess.analyzeSubscript(this, subscript);
            },
            is SafeSubscriptExpressionNode subscript -> {
                return memberaccess.analyzeSafeSubscript(this, subscript);
            },
            is CastExpressionNode cast -> {
                return narrowing.analyzeCast(this, cast);
            },
            is CheckedCastExpressionNode cast -> {
                return narrowing.analyzeCheckedCast(this, cast);
            },
            is TypeTestExpressionNode test -> {
                return narrowing.analyzeTypeTest(this, test);
            },
            is AssignmentExpressionNode assignment -> {
                return assignments.analyzeAssignment(this, assignment);
            },
            is TernaryExpressionNode ternary -> {
                return valuejoins.analyzeTernary(this, ternary, null);
            },
            is NullCoalesceExpressionNode coalesce -> {
                return valuejoins.analyzeNullCoalesce(this, coalesce);
            },
            is NewExpressionNode created -> {
                return construction.analyzeNew(this, created);
            },
            is ParenthesizedExpressionNode parenthesized -> {
                return this.analyzeExpression(parenthesized.inner());
            },
            is ArrayLiteralExpressionNode literal -> {
                return literaltyping.analyzeArrayLiteral(this, literal);
            },
            is StructLiteralExpressionNode literal -> {
                return literaltyping.analyzeStructLiteral(this, literal);
            },
            is InterpolatedStringExpressionNode interpolated -> {
                return literaltyping.analyzeInterpolatedString(this, interpolated);
            },
            is TryExpressionNode tried -> {
                return functioncalls.analyzeTry(this, tried);
            },
            is SwitchExpressionNode switched -> {
                return switches.analyzeSwitchExpression(this, switched, null);
            },
            is EmbedExpressionNode embedded -> {
                return this.analyzeEmbed(embedded);
            },
            is LambdaExpressionNode lambda -> {
                this.reporter().report("This lambda has no function type to give its parameters and its "
                    + "result their types. Write it where a function type is declared, as in "
                    + "'(int, int) -> int compare = (a, b) -> a - b;'.", lambda.span());
                return this.store().errorType();
            },
            is ErrorExpressionNode ignored -> {
                return this.store().errorType();
            },
        }
    }

    // The graph read what the embed names, so here its bytes only get their type. One it could
    // not read is reported at its path already, and so is a standard library without the module
    // that declares 'EmbeddedFile'.
    analyzeEmbed(EmbedExpressionNode node) -> Type {
        let content = this.context().module().embedded(node.span().start);
        if (content == null) {
            return this.store().errorType();
        }
        if (!content.folderForm) {
            return this.store().arrayOf(this.store().primitive(PrimitiveKind.Byte));
        }
        let file = this.store().findDeclared(StandardLibrary.embedModule, "EmbeddedFile");
        if (file == null) {
            return this.store().errorType();
        }
        return this.store().arrayOf(file);
    }

    // Analyzes toward a target type, which gives a lambda, an array or struct literal, an untyped
    // literal and a generic call the type they lack. A '?:', a switch and parentheses pass the target
    // on, and 'origin' is where it is set.
    public analyzeExpressionAdapt(Expression node, Type target, LiteralOrigin? origin = null) -> Type {
        return this.readAs(node, this.adaptedExpression(node, target, origin), target);
    }

    // The type of 'node', of type 'analyzed', where a value of 'target' is read: 'target' itself
    // for a value that never returns, since nothing ever reads it, and 'analyzed' otherwise.
    public readAs(Expression node, Type analyzed, Type target) -> Type {
        if (!types.isVoidType(analyzed) || types.isVoidType(target) || target is ErrorType
                || !this.neverReturns(node)) {
            return analyzed;
        }
        this.result().setNeverReturningValue(node.green());
        this.result().setType(node.green(), target);
        return target;
    }

    adaptedExpression(Expression node, Type target, LiteralOrigin? origin) -> Type {
        if (this.takePlaced(node)) {
            return this.recordedType(node);
        }
        if (this.takeRanked(node)) {
            return this.adaptAnalyzed(node, this.recordedType(node), target, origin);
        }
        if (node is ParenthesizedExpressionNode) {
            Type adapted = this.analyzeExpressionAdapt(node.inner(), target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is LambdaExpressionNode) {
            let outerHolder = this.targets().lambdaHolder();
            this.targets().setLambdaHolder(origin);
            Type adapted = lambdas.analyzeLambda(this, node, target);
            this.targets().setLambdaHolder(outerHolder);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is ArrayLiteralExpressionNode) {
            Type adapted = literaltyping.analyzeArrayLiteralAdapt(this, node, target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is StructLiteralExpressionNode) {
            Type adapted = literaltyping.analyzeStructLiteralAdapt(this, node, target);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        Type analyzed = this.store().errorType();
        if (node is CallExpressionNode) {
            analyzed = functioncalls.analyzeCall(this, node, target);
            this.result().setType(node.green(), analyzed);
        } else if (node is TernaryExpressionNode) {
            analyzed = valuejoins.analyzeTernary(this, node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else if (node is SwitchExpressionNode) {
            analyzed = switches.analyzeSwitchExpression(this, node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else {
            this.targets().stash(node, target, origin);
            analyzed = this.analyzeExpression(node);
            this.targets().clearStash();
        }
        return this.adaptAnalyzed(node, analyzed, target, origin);
    }

    // Adapts the analyzed 'node' of type 'analyzed' to 'target': an untyped literal takes the type, and a
    // 'char' is refused where a floating-point number is expected.
    public adaptAnalyzed(Expression node, Type analyzed, Type target, LiteralOrigin? origin) -> Type {
        if (target is ErrorType || analyzed is ErrorType) {
            return analyzed;
        }
        // A 'char' is a code point rather than a quantity. Arithmetic on it in integers is
        // meaningful, but as a floating-point number it has no use, so the refusal says why
        // instead of leaving the reader to wonder which conversion was missing.
        Type held = convert.coreOf(target);
        if (types.isCharType(analyzed) && convert.isTextualFloat(held)) {
            string quotedName = this.names().quoted(held);
            string spelled = wording.oneLineSpelling(node);
            if (!wording.isSingleTerm(node)) {
                spelled = "({spelled})";
            }
            string converted = this.names().quotedCode(["{spelled} as ", ""], [held]);
            string fix = "Write {converted} to use that number as a {quotedName}.";
            if (syntax.unwrapParentheses(node) is LiteralExpressionNode) {
                string cast = this.names().quotedCode(["as ", ""], [held]);
                fix = "Add {cast} after the literal to use that number as a {quotedName}.";
            }
            this.reporter().report("A 'char' is a character's number in Unicode, its code point, and it "
                + "never converts to {quotedName} on its own. " + fix, node.span());
            this.result().setType(node.green(), this.store().errorType());
            return this.store().errorType();
        }
        literalfixes.noteSuffixedTarget(this, node, target, origin);
        return literaltyping.adaptIntegerLiteral(this, node, target, origin)
            ?? literaltyping.adaptCharLiteral(this, node, target, origin)
            ?? literaltyping.adaptFloatLiteral(this, node, target, origin) ?? analyzed;
    }

    // Analyzes 'node', an expression whose value nothing reads, such as an expression statement.
    public analyzeDiscarded(Expression node) -> Type {
        let outer = this.discardedValue;
        this.discardedValue = syntax.unwrapParentheses(node).green();
        Type analyzed = this.analyzeExpression(node);
        this.discardedValue = outer;
        return analyzed;
    }

    // True when nothing reads the value of 'node', as for an expression statement.
    public isDiscarded(Expression node) -> bool {
        return this.discardedValue == node.green();
    }

    // True when nothing reads the value of 'node', or when it is the whole value of the
    // initializer, the assignment or the return being analyzed.
    public isWholeValue(Expression node) -> bool {
        return this.isDiscarded(node) || this.wholeValue == node.green();
    }

    // Analyzes a part of an argument while a call's candidates are ranked. Typing the argument from the
    // chosen candidate then uses the type found here instead of analyzing the part again.
    public analyzeBeforeChoosing(Expression node) -> Type {
        Type analyzed = this.analyzeExpression(node);
        this.rankedValues.add(node.green());
        return analyzed;
    }

    // Whether 'node' was analyzed while a call's candidates were ranked, which it is then no longer
    // recorded as.
    public takeRanked(Expression node) -> bool {
        return !this.rankedValues.isEmpty() && this.rankedValues.remove(node.green());
    }

    // Whether 'node' was analyzed against its parameter where it is written, which it is then no longer
    // recorded as.
    public takePlaced(Expression node) -> bool {
        return !this.placedValues.isEmpty() && this.placedValues.remove(node.green());
    }

    // Records 'fix', the 'is' test to write for a comparison of an 'as?' cast with null, at 'path'.
    public recordCastHint(NarrowingPath path, string fix) {
        this.castHints.set(path, fix);
    }

    // The 'is' test to write for a comparison of an 'as?' cast with null recorded at 'path', or null.
    public castHintAt(NarrowingPath path) -> string? {
        return this.castHints.get(path);
    }

    // Whether the user can edit the module at 'modulePath', which a module of the standard library or
    // or a fetched dependency is not.
    public isEditableModule(string modulePath) -> bool {
        let context = this.contextsByModulePath.get(modulePath);
        return context == null || context.module().isEditable();
    }

    public recordedType(Expression expression) -> Type {
        let recorded = this.result().typeOf(expression.green());
        if (recorded != null) {
            return recorded;
        }
        return this.store().errorType();
    }
}

// The whole value 'statement' initializes, assigns or returns, without its parentheses, or null for a
// statement that has none.
wholeValueOf(Statement statement) -> GreenNode? {
    Expression? value = null;
    switch (statement) {
        is VariableDeclarationNode declaration -> {
            let initializer = declaration.initializer();
            if (initializer != null) {
                value = initializer.value();
            }
        },
        is ReturnStatementNode returned -> {
            value = returned.value();
        },
        is ExpressionStatementNode expression -> {
            let written = syntax.unwrapParentheses(expression.expression());
            if (written is AssignmentExpressionNode) {
                value = written.value();
            }
        },
        default -> { },
    }
    if (value == null) {
        return null;
    }
    return syntax.unwrapParentheses(value).green();
}
