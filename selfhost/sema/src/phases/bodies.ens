// Checks every body of every module. Modules reach each other only through the type store, the
// link tables, and the other modules' function tables (for namespace-qualified calls and for the
// prelude).
public checkBodies(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let contextsByPath = new Map<string, ModuleContext>();
    for (long i = 0; i < contexts.length(); i++) {
        contextsByPath.set(contexts.get(i).module().canonicalPath(), contexts.get(i));
    }
    let preludeScope = prelude.scopeOver(implicit.implicitImportPaths(), contextsByPath);
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new BodyChecker(contexts.get(i), contextsByPath, preludeScope, collected);
        checker.run();
        for (let diagnostic in contexts.get(i).resolver().takeDiagnostics()) {
            collected.push(diagnostic);
        }
    }
    return diagnostics.sorted(collected);
}

// What an unqualified name means at a use site, innermost scope first.
public sealed abstract class NameResolution {
}

public final class LocalName extends NameResolution {
    protected LocalBinding localBinding;

    protected constructor(this.localBinding);

    public binding() -> LocalBinding {
        return this.localBinding;
    }
}

// The type parameter in scope under the name, which takes that name for the whole of the
// declaration introducing it, ahead of everything the file declares or imports under it.
public final class TypeParameterName extends NameResolution {
    protected TypeParamType typeParameter;

    protected constructor(this.typeParameter);

    public parameter() -> TypeParamType {
        return this.typeParameter;
    }
}

// The entries a call to this name could reach, and the prelude match they came from when they
// came from there rather than from the module's own function table.
public final class FunctionName extends NameResolution {
    protected List<FunctionEntry> entries;
    protected PreludeMatch? fromPrelude;

    protected constructor(this.entries, this.fromPrelude);
}

public final class TypeName extends NameResolution {
    protected DeclaredType declaredTarget;

    protected constructor(this.declaredTarget);

    public target() -> DeclaredType {
        return this.declaredTarget;
    }
}

public final class NamespaceName extends NameResolution {
    protected string namespacePath;

    protected constructor(this.namespacePath);

    public targetModulePath() -> string {
        return this.namespacePath;
    }
}

// The parameter a call's resolution chose for the argument at 'span'.
public final class ChosenParameter {
    protected Span span;
    protected LiteralOrigin origin;

    protected constructor(this.span, this.origin);
}

// One lambda whose body is being checked: the scope outside it, the receiver outside it, and
// what its body has read from either so far. The captures accumulate in first-read order, which
// is the order the closure copies them in.
class LambdaFrame {
    protected Scope? enclosingScope;
    protected Type? enclosingReceiver;
    protected List<LambdaCapture> captures;
    protected List<LocalBinding> capturedBindings;
    protected bool readsReceiver;

    protected constructor(Scope? enclosingScope, Type? enclosingReceiver) {
        this.enclosingScope = enclosingScope;
        this.enclosingReceiver = enclosingReceiver;
        this.captures = new List<LambdaCapture>();
        this.capturedBindings = new List<LocalBinding>();
        this.readsReceiver = false;
    }

    // The binding this name has outside the lambda, or null when the enclosing scope has none.
    protected lookupOuter(string name) -> LocalBinding? {
        let outer = this.enclosingScope;
        if (outer == null) {
            return null;
        }
        return outer.lookup(name);
    }

    protected captureBinding(LocalBinding binding) {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return;
            }
        }
        this.capturedBindings.push(binding);
        this.captures.push(new LambdaCapture(binding, binding.type()));
    }

    // Records that the lambda copies the enclosing receiver; true the first time, so a rejection
    // reports once however many times the body reads 'this'.
    protected captureReceiver(Type receiver) -> bool {
        if (this.readsReceiver) {
            return false;
        }
        this.readsReceiver = true;
        this.captures.push(new LambdaCapture(null, receiver));
        return true;
    }

    protected holds(LocalBinding binding) -> bool {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return true;
            }
        }
        return false;
    }

    protected result() -> LambdaCapture[] {
        return this.captures.toArray();
    }
}

// What a type argument must be to satisfy the bound 'bound', spelled 'shown' where it is used.
boundKindText(Type bound, Type shown, TypeNames names) -> string {
    if (types.isInterfaceLike(bound)) {
        return "implements '{names.of(shown)}'";
    }
    return "is '{names.of(shown)}' or a subclass of it";
}

// The end of the refusal of an 'is' arm that matches every value of the switch, from the comma or
// full stop after that clause. A first arm makes the switch unnecessary, and a later one can be a
// 'default' arm, since an earlier 'is' arm stays.
everyValueFix(Type scrutineeType, Expression scrutinee, ArmBody body, bool first) -> string {
    if (!first) {
        return ". Use a 'default' arm instead.";
    }
    if (scrutineeType is OptionalType) {
        return " that is not null. Check {wording.sideNamed(scrutinee, "the value")} for null with 'if' "
            + "instead of switching on it.";
    }
    switch (body) {
        is Expression value -> {
            string spelled = wording.oneLineSpelling(value);
            if (spelled.length <= wording.quotedCodeLimit()) {
                return ", so the switch always takes this arm. Write '{spelled}' instead of the switch.";
            }
            return ", so the switch always takes this arm. Write the value of this arm instead of the "
                + "switch.";
        },
        default -> {
            return ", so the switch always takes this arm. Write the statements of this arm instead of the "
                + "switch.";
        },
    }
}

// Whether an 'is' arm for 'armType' matches every value of a switch over 'inner'.
matchesEveryValue(Type inner, Type armType) -> bool {
    return !(armType is OptionalType) && !(armType is TypeParamType) && types.isClassLike(armType)
        && (armType == inner || hierarchy.isSubclassOrConforms(inner, armType));
}

// A call an example can write to the signature, carrying the 'try' the call needs. Null where the
// signature is generic, and where it throws what only its body decides.
callExample(string spelling, Signature signature) -> string? {
    Type[] thrown = signature.throwsTypes();
    if (signature.isGeneric() || (signature.declaresThrows() && thrown.length == 0)) {
        return null;
    }
    string arguments = "(...)";
    if (signature.parameters().length == 0) {
        arguments = "()";
    }
    if (thrown.length > 0) {
        return "try {spelling}{arguments}";
    }
    return "{spelling}{arguments}";
}

// The callable whose body is being checked: its parameters and receiver, what a 'return' in it
// is held to, and the loops and catch clause the checked code is in.
public final class CallableFrame {
    Scope? parameterBindings;
    LocalBinding? receiverBinding;
    Type? receiverType;
    // The class or struct whose member body is being checked, statics included; the access
    // rules judge private and protected members from here. Null outside member bodies.
    Type? owningType;
    bool isStatic;
    // True while a callable's body is being checked, and false in a field default, a parameter
    // default, or a lazy const's initializer, none of which declares a parameter.
    bool inBody;
    // The name of the field whose default is being checked, and null outside a field default.
    string? defaultedField;
    // The callable whose body is being checked, and null outside a callable body.
    SyntaxNode? callableNode;
    // True in a callable body and in a lambda body written as a block. A statement can go there.
    bool allowsStatements;
    // The parameters in reach of the expression being checked, in declaration order, with an
    // enclosing callable's ahead of a lambda's own, for a diagnostic that names a value of a
    // type. Empty where the position has none.
    List<LocalBinding> reachableParameters;

    Type? returnType;
    // Where the return type of the callable being checked is declared, for a returned literal that
    // does not fit it. Null where no code can change it in one edit.
    LiteralOrigin? returnOrigin;
    // What a 'return' refusal names as returning, as in "Function 'first'", and the name and parameters
    // a void one offers to declare a return type after, empty where none can be declared.
    string returnSubject;
    string returnHeader;
    bool isNoreturnBody;
    bool inConstructorBody;
    bool hasSuperCall;

    bool inCatch;
    long loopNesting;
    // True while a loop condition is analyzed. A copy made before the loop never changes there.
    bool withinLoopCondition;

    // The frame of code outside any callable body, such as a field default, inside 'owner' or
    // inside no type.
    public constructor(Type? owner) {
        this.parameterBindings = null;
        this.receiverBinding = null;
        this.receiverType = null;
        this.owningType = owner;
        this.isStatic = false;
        this.inBody = false;
        this.defaultedField = null;
        this.callableNode = null;
        this.allowsStatements = false;
        this.reachableParameters = new List<LocalBinding>();
        this.returnType = null;
        this.returnOrigin = null;
        this.returnSubject = "This function";
        this.returnHeader = "";
        this.isNoreturnBody = false;
        this.inConstructorBody = false;
        this.hasSuperCall = false;
        this.inCatch = false;
        this.loopNesting = 0;
        this.withinLoopCondition = false;
    }

    // The frame of a callable's body, before any of its parameters is bound.
    public constructor(Scope parameterScope, LocalBinding? thisBinding, Type? thisType, Type? owner,
                SyntaxNode callable, Type returnType, LiteralOrigin? returnOrigin, string returnSubject,
                string returnHeader, bool isStatic, bool isNoreturn, bool isConstructor) {
        this.parameterBindings = parameterScope;
        this.receiverBinding = thisBinding;
        this.receiverType = thisType;
        this.owningType = owner;
        this.isStatic = isStatic;
        this.inBody = true;
        this.defaultedField = null;
        this.callableNode = callable;
        this.allowsStatements = true;
        this.reachableParameters = new List<LocalBinding>();
        this.returnType = returnType;
        this.returnOrigin = returnOrigin;
        this.returnSubject = returnSubject;
        this.returnHeader = returnHeader;
        this.isNoreturnBody = isNoreturn;
        this.inConstructorBody = isConstructor;
        this.hasSuperCall = false;
        this.inCatch = false;
        this.loopNesting = 0;
        this.withinLoopCondition = false;
    }

    // A lambda body's frame: the return, constructor, loop and catch state start over, a block body
    // allows statements and is the callable when none encloses it, and the rest carries in.
    public forLambda(LambdaExpressionNode lambda, Type returnType, LiteralOrigin? returnOrigin)
            -> CallableFrame {
        let derived = new CallableFrame(this.owningType);
        derived.parameterBindings = this.parameterBindings;
        derived.receiverBinding = this.receiverBinding;
        derived.receiverType = this.receiverType;
        derived.isStatic = this.isStatic;
        derived.inBody = this.inBody;
        derived.defaultedField = this.defaultedField;
        derived.allowsStatements = lambda.body() is BlockNode;
        derived.callableNode = this.callableNode;
        if (derived.allowsStatements && this.callableNode == null) {
            derived.callableNode = lambda;
        }
        for (long i = 0; i < this.reachableParameters.length(); i++) {
            derived.reachableParameters.push(this.reachableParameters.get(i));
        }
        derived.returnType = returnType;
        derived.returnOrigin = returnOrigin;
        derived.returnSubject = "This lambda";
        derived.returnHeader = "";
        derived.hasSuperCall = this.hasSuperCall;
        return derived;
    }

    public parameterScope() -> Scope? {
        return this.parameterBindings;
    }

    public thisBinding() -> LocalBinding? {
        return this.receiverBinding;
    }

    public thisType() -> Type? {
        return this.receiverType;
    }

    public enclosingOwner() -> Type? {
        return this.owningType;
    }

    public inStaticMethod() -> bool {
        return this.isStatic;
    }

    public inCallableBody() -> bool {
        return this.inBody;
    }

    public fieldDefaultName() -> string? {
        return this.defaultedField;
    }

    public callableSyntax() -> SyntaxNode? {
        return this.callableNode;
    }

    public statementsAllowed() -> bool {
        return this.allowsStatements;
    }

    public parametersInReach() -> List<LocalBinding> {
        return this.reachableParameters;
    }

    public currentReturnType() -> Type? {
        return this.returnType;
    }

    public currentReturnOrigin() -> LiteralOrigin? {
        return this.returnOrigin;
    }

    public currentReturnSubject() -> string {
        return this.returnSubject;
    }

    public currentReturnHeader() -> string {
        return this.returnHeader;
    }

    public currentNoreturn() -> bool {
        return this.isNoreturnBody;
    }

    public inConstructor() -> bool {
        return this.inConstructorBody;
    }

    public sawSuperCall() -> bool {
        return this.hasSuperCall;
    }

    public inCatchClause() -> bool {
        return this.inCatch;
    }

    public loopDepth() -> long {
        return this.loopNesting;
    }

    public inLoopCondition() -> bool {
        return this.withinLoopCondition;
    }

    public setFieldDefaultName(string name) {
        this.defaultedField = name;
    }

    public setStatementsAllowed(bool allowed) {
        this.allowsStatements = allowed;
    }

    public noteSuperCall() {
        this.hasSuperCall = true;
    }

    public enterLoop() {
        this.loopNesting++;
    }

    public leaveLoop() {
        this.loopNesting--;
    }

    public enterLoopCondition() {
        this.withinLoopCondition = true;
    }

    public leaveLoopCondition() {
        this.withinLoopCondition = false;
    }

    public enterCatchClause() {
        this.inCatch = true;
    }

    public leaveCatchClause() {
        this.inCatch = false;
    }
}

public final class BodyChecker implements NoreturnCalls {
    ModuleContext moduleContext;
    Map<string, ModuleContext> contextsByModulePath;
    PreludeScope programPrelude;
    TypeResolver typeResolver;
    TypeStore typeStore;
    SemaResult semaResult;
    Reporter bodyReporter;
    TypeNames typeNames;
    string canonicalModulePath;
    string modulePackagePrefix;

    Scope? scope;
    CallableFrame callableFrame;
    // The lambdas whose bodies are being checked, outermost first. Empty in ordinary code; a
    // name the innermost one does not declare itself is a capture.
    List<LambdaFrame> lambdaFrames;
    NarrowingState narrowingState;
    // The 'const' locals declared without a type, and the values 'is' arms matched. A refused write to
    // a constant local gives each its own fix.
    List<LocalBinding> untypedConstantLocals;
    List<LocalBinding> matchedArmBindings;
    LiteralTargets literalTargets;

    AssignmentState assignmentState;

    Set<GreenNode> fillProvenNews;
    Map<GreenNode, string> arrayNewNames;

    ObligationRegistry deferredObligations;
    GreenNode? obligationOwner;
    string obligationOwnerName;
    string obligationOwnerDisplay;

    protected constructor(ModuleContext context, Map<string, ModuleContext> contextsByPath,
                PreludeScope preludeScope, List<FileDiagnostic> collected) {
        this.moduleContext = context;
        this.contextsByModulePath = contextsByPath;
        this.programPrelude = preludeScope;
        this.typeResolver = context.resolver();
        this.typeStore = context.resolver().typeStore();
        this.semaResult = context.result();
        this.bodyReporter = new Reporter(context.module().filePath(), collected);
        this.typeNames = context.names();
        this.canonicalModulePath = context.module().canonicalPath();
        this.modulePackagePrefix = context.module().packagePrefix();
        this.lambdaFrames = new List<LambdaFrame>();
        this.narrowingState = new NarrowingState();
        this.callableFrame = new CallableFrame(null);
        this.untypedConstantLocals = new List<LocalBinding>();
        this.literalTargets = new LiteralTargets();
        this.matchedArmBindings = new List<LocalBinding>();
        this.assignmentState = new AssignmentState(this.bodyReporter, this.typeNames);
        this.fillProvenNews = new Set<GreenNode>();
        this.arrayNewNames = new Map<GreenNode, string>();
        this.deferredObligations = context.obligations();
        this.obligationOwner = null;
        this.obligationOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    public context() -> ModuleContext {
        return this.moduleContext;
    }

    public contextsByPath() -> Map<string, ModuleContext> {
        return this.contextsByModulePath;
    }

    public preludeScope() -> PreludeScope {
        return this.programPrelude;
    }

    public resolver() -> TypeResolver {
        return this.typeResolver;
    }

    public store() -> TypeStore {
        return this.typeStore;
    }

    public result() -> SemaResult {
        return this.semaResult;
    }

    public reporter() -> Reporter {
        return this.bodyReporter;
    }

    public names() -> TypeNames {
        return this.typeNames;
    }

    public modulePath() -> string {
        return this.canonicalModulePath;
    }

    public packagePrefix() -> string {
        return this.modulePackagePrefix;
    }

    public narrowing() -> NarrowingState {
        return this.narrowingState;
    }

    // The innermost scope of the body being checked, or null outside one.
    public currentScope() -> Scope? {
        return this.scope;
    }

    public frame() -> CallableFrame {
        return this.callableFrame;
    }

    public assignment() -> AssignmentState {
        return this.assignmentState;
    }

    public targets() -> LiteralTargets {
        return this.literalTargets;
    }

    public untypedConstants() -> List<LocalBinding> {
        return this.untypedConstantLocals;
    }

    public armBindings() -> List<LocalBinding> {
        return this.matchedArmBindings;
    }

    protected run() {
        let root = this.context().root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    this.checkTopLevelFunction(declaration);
                },
                is StructDeclarationNode declaration -> {
                    this.checkStructBodies(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.checkClassBodies(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.checkPrimitiveBindingBodies(declaration);
                },
                is TestDeclarationNode declaration -> {
                    this.checkTestBody(declaration);
                },
                default -> { },
            }
        }
        valuejoins.reportPendingLiteralRanges(this);
    }

    // ---- Declaration walking ----

    checkTopLevelFunction(FunctionDeclarationNode node) {
        let entries = this.context().functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isExternal() || entry.isBuiltin()) {
                continue;
            }
            if (entry.signature().declaration() == node.green()) {
                this.checkParameterDefaults(entry.signature(), null, node);
                this.checkCallableBody(entry.signature(), null, null, null, node);
                return;
            }
        }
    }

    checkStructBodies(StructDeclarationNode node) {
        let found = this.store().findDeclared(this.modulePath(), node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkLazyInitializers(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    checkClassBodies(ClassDeclarationNode node) {
        let found = this.store().findDeclared(this.modulePath(), node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkLazyInitializers(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    // A binding's members belong to the primitive, so 'this' inside one is the primitive value
    // and the members reachable without a receiver are the binding's own.
    checkPrimitiveBindingBodies(PrimitiveDeclarationNode node) {
        let primitive = types.primitiveNamed(this.store(), node.name().text());
        if (primitive == null) {
            return;
        }
        let binding = types.bindingOf(primitive);
        if (binding == null || binding.declaration() != node.green()) {
            return;
        }
        this.checkMemberBodies(primitive, binding.methods(), binding.staticMethods(),
            node.body());
    }

    // Deferred judgments and open generic calls found while checking a generic template's or
    // generic function's bodies record against that owner, keyed by its declaration node.
    enterObligationOwner(DeclaredType found) {
        if (found.isGeneric()) {
            this.obligationOwner = found.declaration();
            this.obligationOwnerName = found.name();
            this.obligationOwnerDisplay = this.names().of(found);
        }
    }

    leaveObligationOwner() {
        this.obligationOwner = null;
        this.obligationOwnerName = "";
        this.obligationOwnerDisplay = "";
    }

    public recordObligation(Obligation obligation) {
        let owner = this.obligationOwner;
        if (owner != null) {
            obligation.setGuards(this.activeGuardsFor(owner));
            obligation.setOwnerDisplay(this.obligationOwnerDisplay);
            this.deferredObligations.recordObligation(owner, this.context().module().filePath(),
                obligation);
        }
    }

    recordGenericCall(Signature signature, Type[] arguments, Span at) {
        bool open = false;
        for (let argument in arguments) {
            if (convert.containsTypeParam(argument)) {
                open = true;
            }
        }
        if (!open) {
            this.deferredObligations.recordConcreteCall(signature, arguments,
                new Origin(this.context().module().filePath(), at,
                    obligations.displayFor(signature.name(), arguments, this.names())));
            return;
        }
        let owner = this.obligationOwner;
        if (owner != null) {
            this.deferredObligations.recordOpenCall(owner, this.context().module().filePath(),
                signature, arguments, this.activeGuardsFor(owner));
        }
    }

    // The active conditional member's constraints, as guards for a deferred judgment, when the
    // constrained declaration is the obligation's owner itself.
    activeGuardsFor(GreenNode owner) -> MemberConstraint[] {
        if (this.resolver().activeConstraintOwner() == owner) {
            return this.resolver().activeConstraints();
        }
        return [];
    }

    checkMemberBodies(Type owner, List<Method> methods, List<Method> staticMethods, MemberListNode body) {
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                let method = members.methodDeclaredBy(methods, member.green());
                if (method != null) {
                    this.checkParameterDefaults(method.signature(), owner, member);
                    this.checkCallableBody(method.signature(), owner, owner, method, member);
                    continue;
                }
                let staticMethod = members.methodDeclaredBy(staticMethods, member.green());
                if (staticMethod != null) {
                    this.checkParameterDefaults(staticMethod.signature(), owner, member);
                    this.checkCallableBody(staticMethod.signature(), null, owner, staticMethod,
                        member);
                }
            }
        }
    }

    checkTestBody(TestDeclarationNode node) {
        let parameterScope = new Scope(null);
        this.scope = parameterScope;
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(parameterScope, null, null, null, node,
            this.store().primitive(PrimitiveKind.Void), null, "A test", "", isStatic: false,
            isNoreturn: false, isConstructor: false);
        this.assignment().reset();
        this.enterScope();
        this.walkBlock(node.body());
        this.leaveScope();
        this.scope = null;
        this.callableFrame = outerFrame;
    }

    // Checks one callable's body: the parameter scope (with 'this' for instance methods), a
    // child scope for the body's locals, and the catch clauses as siblings that cannot read those
    // locals. A static method takes its owner but no receiver: the owner's type parameters are
    // in scope and its members are reachable, while 'this' does not exist.
    checkCallableBody(Signature signature, Type? receiver, Type? owner, Method? method,
                              FunctionDeclarationNode node) {
        bool ownsObligations = false;
        if (owner == null && signature.isGeneric()) {
            let declaration = signature.declaration();
            if (declaration != null) {
                ownsObligations = true;
                this.obligationOwner = declaration;
                this.obligationOwnerName = signature.name();
                this.obligationOwnerDisplay = "{signature.name()}<{typeParameterNamesText(signature)}>";
            }
        }
        long pushed = this.pushCallableTypeParameters(signature, owner);
        // Inside a conditional member, the constrained parameters carry the member's extra
        // bounds: lookups, bound checks, and existence checks all read the scope.
        bool pushedConstraints = false;
        if (method != null && method.isConditional() && owner is DeclaredType) {
            this.resolver().pushMemberConstraints(owner.declaration(), method.constraints());
            pushedConstraints = true;
        }
        let parameterScope = new Scope(null);
        this.scope = parameterScope;
        this.narrowingState = new NarrowingState();
        LocalBinding? thisBinding = null;
        if (receiver != null) {
            thisBinding = new LocalBinding("this", receiver, BindingKind.Parameter, true,
                signature.nameSpan());
        }
        string returnSubject = "Function '{signature.name()}'";
        string headerArguments = wording.greenSpelling(node.parameters().green());
        if (headerArguments.length > wording.quotedCodeLimit()) {
            headerArguments = "(...)";
        }
        string returnHeader = "{signature.name()}{headerArguments}";
        if (method != null && method.isConstructor() && owner != null) {
            returnSubject = "The constructor of '{this.names().of(owner)}'";
            returnHeader = "";
        } else if (method != null) {
            returnSubject = "Method '{signature.name()}'";
        }
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(parameterScope, thisBinding, receiver, owner, node,
            signature.returnType(),
            new LiteralOrigin(OriginKind.Returned, signature.name(), "", signature.returnType()),
            returnSubject, returnHeader, isStatic: method != null && method.isStatic(),
            isNoreturn: signature.isNoreturn(), isConstructor: method != null && method.isConstructor());
        if (receiver != null) {
            this.result().setReceiver(node.green(), receiver);
        }

        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            this.frame().parametersInReach().push(binding);
            let scope = this.frame().parameterScope();
            if (scope != null && !scope.define(binding)) {
                string declaredIn = "'{signature.name()}'";
                if (method != null && method.isConstructor() && owner != null) {
                    declaredIn = "the constructor of '{this.names().of(owner)}'";
                }
                this.reporter().report("Parameter '{parameter.name()}' is declared twice in {declaredIn}. "
                    + "Rename one of the two.", parameter.span());
            }
            if (i < parameterList.parametersCount()) {
                this.result().setBinding(parameterList.parameters(i).green(), binding);
            }
        }

        this.assignment().reset();
        // A constructor also tracks its own fields: a this-field shorthand parameter assigns
        // the field before the body runs, and every own non-defaultable field must be assigned
        // on every path that leaves the body normally.
        if (this.frame().inConstructor() && receiver != null) {
            this.seedConstructorFields(signature, receiver);
        }
        let body = node.body();
        if (body != null) {
            this.enterScope();
            this.walkBlock(body);
            this.leaveScope();
        }
        if (this.assignment().constructorFieldOwner() != null) {
            this.assignment().checkConstructorFieldsAssigned(signature.nameSpan());
        }

        this.checkConstructorChainsToBase(signature, node);

        for (long i = 0; i < node.catchClausesCount(); i++) {
            this.checkCatchClause(node.catchClauses(i));
        }

        this.checkReturnPaths(signature, node);

        this.scope = null;
        this.callableFrame = outerFrame;
        if (pushedConstraints) {
            this.resolver().popMemberConstraints();
        }
        this.resolver().popTypeParameters(pushed);
        if (ownsObligations) {
            this.leaveObligationOwner();
        }
    }

    pushCallableTypeParameters(Signature signature, Type? owner) -> long {
        long pushed = 0;
        if (signature.isGeneric()) {
            this.resolver().pushTypeParameters(signature.typeParameters());
            pushed = pushed + signature.typeParameters().length;
        }
        if (owner is DeclaredType) {
            pushed = pushed + this.pushOwnerTypeParameters(owner);
        }
        return pushed;
    }

    // How many of the declaration's own type parameters went into scope, for the caller to
    // pop on its way back out.
    pushOwnerTypeParameters(DeclaredType owner) -> long {
        if (!owner.isGeneric()) {
            return 0;
        }
        TypeParamType[] parameters = owner.typeParameterTypes();
        this.resolver().pushTypeParameters(parameters);
        return parameters.length;
    }

    // A constructor that does not call 'super(...)' runs the base constructor its class's implicit
    // chain chooses, so that chain must choose one that exists here.
    checkConstructorChainsToBase(Signature signature, FunctionDeclarationNode node) {
        if (!this.frame().inConstructor() || this.frame().sawSuperCall()) {
            return;
        }
        let receiver = this.frame().thisType();
        if (receiver != null) {
            this.checkImplicitBaseChain(receiver, signature, node.body() != null, signature.nameSpan());
        }
    }

    // The implicit chain of the receiver's class runs the base constructor it chooses. A chosen
    // constructor that the receiver's type arguments exclude is refused here. A chain that chooses
    // none is refused here only when the receiver's class makes the choice. Otherwise a base class
    // with no constructor makes it, and that class is refused where it is declared.
    checkImplicitBaseChain(Type receiver, Signature? declared, bool declaredHasBody, Span at) {
        let current = types.authorityOf(receiver);
        if (!(current is ClassType)) {
            return;
        }
        let chain = typemembers.implicitBaseConstructor(receiver);
        let owner = chain.owner();
        if (owner == null) {
            return;
        }
        let chosen = chain.chosen();
        if (chosen != null) {
            if (this.resolver().memberExists(chosen)) {
                return;
            }
            string clause = this.excludedConstructorClause(chosen, "constructor");
            if (clause.length > 0) {
                string shownOwner = this.names().of(owner);
                string baseText = "its base class '{shownOwner}' with the zero-argument constructor of "
                    + "'{shownOwner}'.";
                let direct = hierarchy.baseOf(receiver);
                if (direct != null && direct != owner) {
                    string shownDirect = this.names().of(direct);
                    baseText = "its base class '{shownDirect}'. '{shownDirect}' declares no constructor, so "
                        + "it runs the zero-argument constructor of '{shownOwner}'.";
                }
                this.reporter().report("The constructor of '{this.names().nameOf(current)}' cannot "
                    + "initialize " + baseText + " " + clause, at);
            }
            return;
        }
        if (declared == null || chain.chooser() != receiver) {
            return;
        }
        string opening = "The constructor of '{this.names().nameOf(current)}' does not call 'super(...)'";
        this.reporter().report(typemembers.implicitBaseRefusal(opening, chain, declared, declaredHasBody, "",
            this.names()), at);
    }

    // Why an excluded conditional base constructor does not exist here, and the fix. 'memberWord'
    // names the declaration an open type parameter's bound can be added to, empty when none can take it.
    excludedConstructorClause(Method excluded, string memberWord) -> string {
        let template = types.authorityOf(excluded.definingType());
        let failed = this.resolver().firstUnmetConstraint(excluded);
        if (template == null || failed == null) {
            return "";
        }
        string example = memberaccess.typeParameterExample(template);
        string templateShown = "{this.names().nameOf(template)}<{example}>";
        string parameterName = template.typeParameters()[failed.parameterIndex()];
        string declaredBound = this.names().of(failed.bound());
        Type argument = hierarchy.typeArgumentsOf(excluded.definingType())[failed.parameterIndex()];
        string shownArgument = this.names().of(argument);
        if (argument is TypeParamType) {
            return "That constructor exists only when '{parameterName}' satisfies '{declaredBound}', and "
                + "nothing here requires that of '{shownArgument}'. "
                + memberaccess.addBoundAdvice(memberWord, shownArgument, this.names().of(failed.boundHere()));
        }
        string failurePhrase = "which does not implement "
            + "'{this.names().of(failed.boundHere())}'";
        if (!types.isInterfaceLike(failed.bound())) {
            failurePhrase = "which is not '{this.names().of(failed.boundHere())}' or a subclass "
                + "of it";
        }
        return "That constructor exists only when '{parameterName}' satisfies '{declaredBound}', and in "
            + "'{this.names().of(excluded.definingType())}', '{parameterName}' is "
            + "'{shownArgument}', {failurePhrase}. Give '{this.names().nameOf(template)}' a zero-argument "
            + "constructor without that condition, or use a type argument that "
            + boundKindText(failed.bound(), failed.boundHere(), this.names()) + ".";
    }

    // The declaration the bound of an open type parameter used here can be added to: "method",
    // "constructor" or "function", or empty in a test or outside a callable.
    public currentMemberWord() -> string {
        if (!this.frame().inCallableBody() || this.frame().currentReturnSubject() == "A test") {
            return "";
        }
        if (this.frame().inConstructor()) {
            return "constructor";
        }
        if (this.frame().thisType() != null || this.frame().inStaticMethod()) {
            return "method";
        }
        return "function";
    }

    // The base constructor a class with no constructor of its own runs, when this instantiation
    // excludes it. It is null when that constructor exists or the chain runs none.
    excludedImplicitBaseConstructor(Type classType) -> Method? {
        let chosen = typemembers.implicitBaseConstructor(classType).chosen();
        if (chosen == null || this.resolver().memberExists(chosen)) {
            return null;
        }
        return chosen;
    }

    // A non-void callable must exit on every path: through its body and through each catch
    // clause it declares. A 'noreturn' callable carries the stronger obligation that no path
    // completes at all.
    checkReturnPaths(Signature signature, FunctionDeclarationNode node) {
        if (signature.isNoreturn()) {
            this.checkNoreturnBody(signature, node);
            return;
        }
        Type returned = signature.returnType();
        if (types.isVoidType(returned) || returned is ErrorType) {
            return;
        }
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter().report("{this.frame().currentReturnSubject()} returns "
                + "'{this.names().of(returned)}', but a path through its body ends without a 'return'. "
                + "Add a 'return' at the end of every path.", signature.nameSpan());
            return;
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter().report("{this.frame().currentReturnSubject()} returns "
                    + "'{this.names().of(returned)}', but a path through its 'catch' clause ends without a "
                    + "'return'. Add a 'return' at the end of every path.", clause.span());
            }
        }
    }

    // A 'noreturn' body must be unable to complete normally: every path ends by throwing,
    // calling 'panic' or another 'noreturn' function, or looping forever. A bodiless form
    // (abstract or interface method) carries the contract without a body to check.
    checkNoreturnBody(Signature signature, FunctionDeclarationNode node) {
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter().report("{this.frame().currentReturnSubject()} is declared 'noreturn', but a path "
                + "through its body ends normally. End every path by throwing, calling 'panic' or calling "
                + "another 'noreturn' function.", signature.nameSpan());
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter().report("{this.frame().currentReturnSubject()} is declared 'noreturn', but a "
                    + "path through its 'catch' clause ends normally. End every path by throwing, calling "
                    + "'panic' or calling another 'noreturn' function.", clause.span());
            }
        }
    }

    // A call ends the path when its target is declared 'noreturn' (the builtin 'panic' among
    // them). 'try noreturnCall()' also ends it: the call either throws or never returns.
    public override callNeverReturns(Expression expression) -> bool {
        Expression core = wording.unwrapParentheses(expression);
        if (core is TryExpressionNode) {
            core = wording.unwrapParentheses(core.operand());
        }
        if (!(core is CallExpressionNode)) {
            return false;
        }
        let target = this.calleeSignatureOf(core);
        return target != null && target.isNoreturn();
    }

    // The static target of a call, or null for a constructor chain or an unresolved callee.
    calleeSignatureOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.result().callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.result().methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.result().callableOf(member.green());
            },
            is SafeMemberExpressionNode member -> {
                let method = this.result().methodOf(member.green());
                if (method != null && !method.isConstructor()) {
                    return method.signature();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // Catch clauses scope against the parameter scope, so body locals stay invisible. The
    // caught-type rules belong to the exception milestone; here the binding resolves and the
    // body walks like any other.
    checkCatchClause(CatchClauseNode clause) {
        this.scope = new Scope(this.frame().parameterScope());
        Type caught = this.resolver().resolveType(clause.caughtType());
        let binding = new LocalBinding(clause.name().text(), caught, BindingKind.Variable,
            false, clause.name().span());
        let owner = this.scope;
        if (owner != null) {
            owner.define(binding);
        }
        this.result().setBinding(clause.green(), binding);
        this.frame().enterCatchClause();
        this.assignment().enterCatchPath();
        this.assignment().trackLocal(binding, assigned: true);
        this.enterScope();
        this.walkBlock(clause.body());
        this.leaveScope();
        // A catch that falls through without rethrowing returns the object normally, so its
        // fields must be assigned there too.
        if (this.assignment().constructorFieldOwner() != null) {
            this.assignment().checkConstructorFieldsAssigned(clause.catchKeyword().span());
        }
        this.frame().leaveCatchClause();
        this.scope = this.frame().parameterScope();
    }

    // Field defaults type against the declared field type. Every sibling field is in scope, not only
    // the ones declared earlier: which of them a default may name is one rule with one precise
    // message, and the checks phase owns it, so a default that names itself or a later field is typed
    // here without being reported a second time as an undefined name.
    // The owner's type parameters are in scope too, because a default is built once per
    // instantiation, where each of them stands for one written type argument.
    checkFieldDefaults(DeclaredType owner, MemberListNode body) {
        let fields = typemembers.fieldsOf(owner);
        long pushed = this.pushOwnerTypeParameters(owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        // Type-level fields stay out on both sides. A static const's initializer is the
        // compile-time constant the constants phase evaluates, and a lazy const's runs on the
        // first read with no instance in reach, so neither is an expression over sibling fields.
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let sink = this.scope;
                if (sink != null) {
                    sink.define(new LocalBinding(member.name().text(),
                        this.fieldTypeOrError(fields, member.name().text()),
                        BindingKind.SiblingField, false, member.name().span()));
                }
            }
        }
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    Type expected = this.fieldTypeOrError(fields, member.name().text());
                    let value = defaultValue.value();
                    this.frame().setFieldDefaultName(member.name().text());
                    Type actual = this.analyzeExpressionAdapt(value, expected,
                        literalfixes.valueOrigin(this, OriginKind.Declared, member.name().text(), expected,
                            value, member));
                    if (!(expected is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(expected, actual)) {
                        this.reporter().report("Field '{member.name().text()}' has type "
                            + "'{this.names().of(expected)}', but its default value has type "
                            + "'{this.names().of(actual)}'."
                            + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}",
                            value.span());
                    }
                }
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // A lazy const's initializer types against the declared type at module scope. It runs on the
    // first read with no instance in reach, so neither 'this' nor a sibling field is visible.
    // The owner's type parameters are in scope so that a use of one is refused as the type
    // parameter it is rather than as an unknown name.
    checkLazyInitializers(DeclaredType owner, MemberListNode body) {
        long pushed = this.pushOwnerTypeParameters(owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FieldDeclarationNode) || !members.fieldModifiers(member).declaresLazy) {
                continue;
            }
            let field = members.findField(typemembers.staticFieldsOf(owner), member.name().text());
            let initializer = member.defaultValue();
            if (field == null || initializer == null) {
                continue;
            }
            // A type the shape check already refused stands for nothing the value could match,
            // so the read below judges the initializer on its own.
            Type expected = field.type();
            if (convert.containsTypeParam(expected) || types.isVoidType(expected)) {
                expected = this.store().errorType();
            }
            let value = initializer.value();
            this.resolver().pushTypeParameterRefusal(this.lazyTypeParameterRefusal(owner, field));
            Type actual = this.analyzeExpressionAdapt(value, expected,
                literalfixes.valueOrigin(this, OriginKind.Declared, field.name(), expected, value, member));
            this.resolver().popTypeParameterRefusal();
            if (!(expected is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(expected, actual)) {
                this.reporter().report("Lazy const '{this.names().nameOf(owner)}.{field.name()}' has type "
                    + "'{this.names().of(expected)}', but its initializer has type "
                    + "'{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // The refusal a type parameter written anywhere inside a lazy const's initializer reads.
    lazyTypeParameterRefusal(DeclaredType owner, Field field) -> string {
        string ownerName = this.names().nameOf(owner);
        return "The initializer of lazy const '{ownerName}.{field.name()}' cannot use a type parameter, "
            + "because one lazy const value is shared by every type argument of '{ownerName}'. Remove "
            + "'lazy const' to give each instance its own '{field.name()}'.";
    }

    fieldTypeOrError(List<Field>? fields, string name) -> Type {
        let field = members.findField(fields, name);
        if (field != null) {
            return field.type();
        }
        return this.store().errorType();
    }

    // Parameter defaults type against the declared parameter type, at module scope: neither
    // the other parameters nor 'this' are visible inside a default.
    // The type parameters of the callable and of its owner are in scope, because a default is
    // built in the instantiation the call reaches.
    checkParameterDefaults(Signature signature, Type? owner, FunctionDeclarationNode node) {
        long pushed = this.pushCallableTypeParameters(signature, owner);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let outerFrame = this.callableFrame;
        this.callableFrame = new CallableFrame(owner);
        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let parameterNode = parameterList.parameters(i);
            let defaultValue = parameterNode.defaultValue();
            if (defaultValue == null) {
                continue;
            }
            Type expected = this.store().errorType();
            if (i < parameters.length) {
                expected = parameters[i].type();
            }
            let value = defaultValue.value();
            Type actual = this.analyzeExpressionAdapt(value, expected,
                literalfixes.valueOrigin(this, OriginKind.Declared, parameterNode.name().text(), expected,
                    value));
            if (!(expected is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(expected, actual)) {
                this.reporter().report("Parameter '{parameterNode.name().text()}' has type "
                    + "'{this.names().of(expected)}', but its default value has type "
                    + "'{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
            }
        }
        this.callableFrame = outerFrame;
        this.scope = null;
        this.resolver().popTypeParameters(pushed);
    }

    // ---- Scopes and names ----

    public enterScope() {
        this.scope = new Scope(this.scope);
        this.narrowingState.push();
    }

    public leaveScope() {
        let current = this.scope;
        if (current != null) {
            this.scope = current.parent();
        }
        this.narrowingState.pop();
    }

    public lookupBinding(string name) -> LocalBinding? {
        let current = this.scope;
        if (current == null) {
            return null;
        }
        let own = current.lookup(name);
        if (own != null) {
            return own;
        }
        return this.lookupCapture(name);
    }

    // Unqualified name resolution, innermost declaration first: local scopes, then a type
    // parameter in scope, then the module's functions, then a type this file declares, then the
    // file's imports, then the prelude's functions, then the implicit exception base class.
    public resolveName(string name) -> NameResolution? {
        let binding = this.lookupBinding(name);
        if (binding != null) {
            return new LocalName(binding);
        }
        let parameter = this.resolver().typeParameterNamed(name);
        if (parameter != null) {
            return new TypeParameterName(parameter);
        }
        return this.resolveNameOutsideTypeParameters(name);
    }

    // What the name means to the file, with the type parameters in scope left out. A refused
    // type parameter reads this to name the meaning it took the name from.
    public resolveNameOutsideTypeParameters(string name) -> NameResolution? {
        let entries = this.context().functions().entriesNamed(name);
        if (entries != null && entries.length() > 0) {
            return new FunctionName(entries, null);
        }
        let declared = this.store().findDeclared(this.modulePath(), name);
        if (declared != null) {
            return new TypeName(declared);
        }
        let imported = this.context().linkTable().binding(name);
        if (imported is ImportedType) {
            return new TypeName(imported.target());
        }
        if (imported is ImportedNamespace) {
            return new NamespaceName(imported.modulePath());
        }
        let offered = this.preludeScope().match(name, this.modulePath(), this.packagePrefix());
        if (offered != null) {
            return new FunctionName(offered.entries(), offered);
        }
        if (name == "Error") {
            let errorClass = this.resolver().errorClass();
            if (errorClass != null) {
                return new TypeName(errorClass);
            }
        }
        return null;
    }

    // ---- Definite assignment ----

    // Records the this-field shorthand parameters as assigned before the body runs, so a
    // constructor whose only initialization is 'constructor(this.field)' starts complete.
    // A shorthand parameter is a write, so it meets the same const rule and the same
    // member-access check an ordinary write to the field meets.
    // A const base field reports that refusal alone, since const holds inside the declaring
    // package too.
    seedConstructorFields(Signature signature, Type receiver) {
        this.assignment().enterConstructor(receiver);
        if (typemembers.fieldsOf(receiver) == null) {
            return;
        }
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            if (!parameter.bindsField()) {
                continue;
            }
            let field = typemembers.inheritedOrOwnField(receiver, parameter.name());
            if (field == null) {
                continue;
            }
            if (field.isConst() && field.definingType() != receiver) {
                string baseName = this.constFieldOwnerName(field);
                this.reporter().report("Parameter 'this.{field.name()}' assigns field '{field.name()}', "
                    + "which is 'const' in base class '{baseName}'. Only a constructor of '{baseName}' can "
                    + "assign it. Declare an ordinary parameter, as in '{this.names().of(field.type())} "
                    + "{field.name()}', and pass it to 'super(...)'.", parameter.span());
            } else {
                memberaccess.checkMemberAccess(this, field.name(), field.visibility(), field.definingType(),
                    parameter.span());
            }
            this.assignment().seedField(field, parameter.span());
        }
        this.assignment().finishSeeding();
    }

    // The name a diagnostic about a field's declaring type should use.
    public constFieldOwnerName(Field field) -> string {
        let authority = types.authorityOf(field.definingType());
        if (authority != null) {
            return authority.name();
        }
        return this.names().of(field.definingType());
    }

    conditionIsAlwaysTrue(Expression condition) -> bool {
        if (condition is LiteralExpressionNode) {
            return condition.value().kind() == SyntaxKind.TrueKeyword;
        }
        return false;
    }

    // ---- Statements ----

    public walkBlock(BlockNode block) {
        for (long i = 0; i < block.statementsCount(); i++) {
            this.noteArrayFillLoop(block, i);
            this.walkStatement(block.statements(i));
        }
    }

    walkScopedBlock(BlockNode block) {
        this.enterScope();
        this.walkBlock(block);
        this.leaveScope();
    }

    walkStatement(Statement statement) {
        switch (statement) {
            is BlockNode block -> {
                this.walkScopedBlock(block);
            },
            is VariableDeclarationNode declaration -> {
                this.checkVariableDeclaration(declaration);
            },
            is IfStatementNode conditional -> {
                this.checkIfStatement(conditional);
            },
            is WhileStatementNode loop -> {
                this.checkWhileStatement(loop);
            },
            is ForStatementNode loop -> {
                this.checkForStatement(loop);
            },
            is ForEachStatementNode loop -> {
                this.checkForEachStatement(loop);
            },
            is BreakStatementNode broken -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'break' can only be used inside a loop.",
                        broken.span());
                }
                this.assignment().noteBreak();
            },
            is ContinueStatementNode continued -> {
                if (this.frame().loopDepth() == 0) {
                    this.reporter().report("'continue' can only be used inside a loop.",
                        continued.span());
                }
                this.assignment().terminate();
            },
            is ReturnStatementNode returned -> {
                if (this.assignment().constructorFieldOwner() != null) {
                    this.assignment().checkConstructorFieldsAssigned(returned.returnKeyword().span());
                }
                this.checkReturnStatement(returned);
                this.assignment().terminate();
            },
            is ExpressionStatementNode expression -> {
                this.assignment().setUnconditionalPosition(true);
                this.analyzeExpression(expression.expression());
                if (this.callNeverReturns(expression.expression())) {
                    this.assignment().terminate();
                }
            },
            is ThrowStatementNode thrown -> {
                this.checkThrowStatement(thrown);
                this.assignment().noteThrowEscapePoint(this.frame().inCatchClause());
                this.assignment().terminate();
            },
            is RethrowStatementNode rethrown -> {
                if (!this.frame().inCatchClause()) {
                    this.reporter().report("'rethrow' can only be used inside a 'catch' clause.",
                        rethrown.span());
                }
                this.assignment().terminate();
            },
            is SwitchStatementNode switched -> {
                this.checkSwitchArms(switched.scrutinee(), armsOfStatement(switched),
                    switched.switchKeyword().span(), false, null);
            },
            default -> { },
        }
    }

    checkVariableDeclaration(VariableDeclarationNode node) {
        string name = node.name().text();
        bool isConst = false;
        let modifier = node.modifier();
        if (modifier != null && modifier.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let declaredType = node.declaredType();
        Type bindingType = this.store().errorType();
        if (declaredType == null) {
            bindingType = this.checkInferredDeclaration(node, name);
        } else {
            bindingType = this.checkTypedDeclaration(node, name, declaredType, isConst);
        }
        let binding = new LocalBinding(name, bindingType, BindingKind.Variable, isConst,
            node.name().span());
        if (isConst && declaredType == null) {
            this.untypedConstantLocals.push(binding);
        }
        this.defineLocal(binding, node.name().span());
        this.result().setBinding(node.green(), binding);
        let initializer = node.initializer();
        this.assignment().trackLocal(binding, initializer != null);
        if (initializer != null) {
            let initType = this.result().typeOf(initializer.value().green());
            if (initType != null) {
                narrowing.establishAssignmentNarrowing(this, binding, initType);
            }
        }
    }

    checkInferredDeclaration(VariableDeclarationNode node, string name) -> Type {
        let initializer = node.initializer();
        if (initializer == null) {
            this.reporter().report("Variable '{name}' has no declared type, so its type has to "
                + "come from an initializer. Write 'let {name} = ...;', or declare the type.",
                node.name().span());
            return this.store().errorType();
        }
        Type initType = literaltyping.analyzeInitializerOf(this, name, initializer.value());
        if (initType is NullType) {
            this.reporter().report("'null' alone gives '{name}' no type. Declare its type, as in "
                + "'string? {name} = null;'.", node.name().span());
            return this.store().errorType();
        }
        return initType;
    }

    checkTypedDeclaration(VariableDeclarationNode node, string name,
                                  TypeNode declaredType, bool isConst) -> Type {
        Type declared = this.resolver().resolveType(declaredType);
        if (types.isVoidType(declared)) {
            this.reporter().report("Variable '{name}' cannot have type 'void', because 'void' means no "
                + "value. Give '{name}' the type of the value it stores.", declaredType.span());
            declared = this.store().errorType();
        }
        let initializer = node.initializer();
        if (initializer != null) {
            Type initType = this.analyzeExpressionAdapt(initializer.value(), declared,
                literalfixes.valueOrigin(this, OriginKind.Declared, name, declared, initializer.value(),
                    node));
            if (!(declared is ErrorType) && !(initType is ErrorType)
                    && !convert.isAssignableStrict(declared, initType)) {
                this.reporter().report("Variable '{name}' has type '{this.names().of(declared)}', but its "
                    + "value has type '{this.names().of(initType)}'."
                    + "{nullguidance.valueAssignabilityHint(this, declared, initType, initializer.value())}",
                    initializer.value().span());
            }
            return declared;
        }
        if (isConst && !(declared is ErrorType)) {
            this.reporter().report("Constant '{name}' must be given its value where it is declared. Write it "
                + "after the name, as in 'const {this.names().of(declared)} {name} = ...;'.",
                node.name().span());
            return declared;
        }
        return declared;
    }

    // A local may shadow anything except a sibling local or, at the body's top level, a
    // parameter of the enclosing callable.
    defineLocal(LocalBinding binding, Span span) {
        let current = this.scope;
        if (current == null) {
            return;
        }
        bool collides = !current.define(binding);
        let parameters = this.frame().parameterScope();
        if (!collides && parameters != null && current.parent() == parameters
                && parameters.lookupLocal(binding.name()) != null) {
            this.reporter().report("Variable '{binding.name()}' has the same name as a parameter. "
                + "Rename one of the two.", span);
            return;
        }
        if (collides) {
            this.reporter().report("Variable '{binding.name()}' is already declared earlier in this block. "
                + "Rename one of the two.", span);
        }
    }

    // The narrowing after an 'if' is the intersection of the facts holding at the end of each
    // branch that can fall through; a terminated branch contributes nothing, so the surviving
    // branch's facts pass through unchanged. This subsumes the single-terminating-branch carry:
    // 'if (x == null) { return; }' leaves the else facts, and 'if (x == null) { x = f(); }'
    // narrows x below because the reassigned then-branch and the failed-check else both prove it.
    checkIfStatement(IfStatementNode node) {
        Type condition = this.analyzeExpression(node.condition());
        this.checkConditionIsBool(condition, "if", node.condition());
        let whenTrue = new List<NarrowingFact>();
        let whenFalse = new List<NarrowingFact>();
        narrowing.collectNarrowings(this, node.condition(), true, whenTrue);
        narrowing.collectNarrowings(this, node.condition(), false, whenFalse);

        let entryAssign = this.assignment().snapshot();
        let entryLayers = this.narrowingState.snapshotLayers();
        let entryFacts = this.narrowingState.flatten();

        let thenFacts = narrowing.walkBranchCapture(this, node.thenBranch(), whenTrue);
        let afterThen = this.assignment().snapshot();
        this.assignment().restore(entryAssign);
        this.narrowingState.restoreLayers(entryLayers);

        Map<NarrowingPath, Type> elseFacts;
        let afterElse = entryAssign;
        let elseClause = node.elseClause();
        if (elseClause == null) {
            elseFacts = narrowing.captureConditionBranch(this, whenFalse);
        } else {
            switch (elseClause.body()) {
                is BlockNode block -> {
                    elseFacts = narrowing.walkBranchCapture(this, block, whenFalse);
                    afterElse = this.assignment().snapshot();
                },
                is IfStatementNode chained -> {
                    // An 'else if' is reached only when this condition failed, so the chained
                    // 'if' is checked under the negated facts exactly as an else block is.
                    this.enterScope();
                    narrowing.applyFacts(this, whenFalse);
                    this.checkIfStatement(chained);
                    elseFacts = this.narrowingState.flatten();
                    afterElse = this.assignment().snapshot();
                    this.leaveScope();
                },
                default -> {
                    elseFacts = narrowing.captureConditionBranch(this, whenFalse);
                },
            }
        }
        this.assignment().restore(entryAssign);
        this.narrowingState.restoreLayers(entryLayers);

        let flows = new List<AssignmentFlow>();
        flows.push(afterThen);
        flows.push(afterElse);
        this.assignment().restore(this.assignment().join(flows));

        let survivors = new List<Map<NarrowingPath, Type>>();
        if (!afterThen.terminated()) {
            survivors.push(thenFacts);
        }
        if (!afterElse.terminated()) {
            survivors.push(elseFacts);
        }
        narrowing.applyNarrowingJoin(this, entryFacts, survivors);
    }

    // The condition is rechecked every iteration and body writes drop narrowing at their own
    // point, so condition narrowing is safe in the body.
    checkWhileStatement(WhileStatementNode node) {
        narrowing.preClearLoopBodyWrites(this, node.body());
        // The condition re-evaluates every iteration, so writes in it count as loop writes.
        this.frame().enterLoop();
        this.frame().enterLoopCondition();
        Type condition = this.analyzeExpression(node.condition());
        this.frame().leaveLoopCondition();
        this.frame().leaveLoop();
        this.checkConditionIsBool(condition, "while", node.condition());
        let facts = new List<NarrowingFact>();
        narrowing.collectNarrowings(this, node.condition(), true, facts);
        bool alwaysTrue = this.conditionIsAlwaysTrue(node.condition());
        let postCondition = this.assignment().snapshot();
        this.assignment().beginLoop();
        this.frame().enterLoop();
        narrowing.walkBranch(this, node.body(), facts);
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        if (!alwaysTrue) {
            exits.push(postCondition);
        }
        this.assignment().finishLoop(exits);
    }

    checkForStatement(ForStatementNode node) {
        this.enterScope();
        let initializer = node.initializer();
        if (initializer != null) {
            switch (initializer) {
                is VariableDeclarationNode declaration -> {
                    this.checkVariableDeclaration(declaration);
                },
                is ExpressionStatementNode expression -> {
                    this.analyzeExpression(expression.expression());
                },
                default -> { },
            }
        }
        narrowing.preClearLoopBodyWrites(this, node.body());
        let update = node.update();
        if (update != null) {
            narrowing.preClearLoopBodyWrites(this, update);
        }
        let facts = new List<NarrowingFact>();
        let condition = node.condition();
        bool alwaysTrue = false;
        if (condition != null) {
            // The condition re-evaluates every iteration, so writes in it count as loop writes.
            this.frame().enterLoop();
            this.frame().enterLoopCondition();
            Type conditionType = this.analyzeExpression(condition);
            this.frame().leaveLoopCondition();
            this.frame().leaveLoop();
            this.checkConditionIsBool(conditionType, "for", condition);
            narrowing.collectNarrowings(this, condition, true, facts);
            alwaysTrue = this.conditionIsAlwaysTrue(condition);
        }
        let postCondition = this.assignment().snapshot();
        this.assignment().beginLoop();
        this.frame().enterLoop();
        this.enterScope();
        narrowing.applyFacts(this, facts);
        this.walkBlock(node.body());
        if (update != null) {
            this.assignment().setUnconditionalPosition(true);
            bool outerStatements = this.frame().statementsAllowed();
            this.frame().setStatementsAllowed(false);
            this.analyzeExpression(update);
            this.frame().setStatementsAllowed(outerStatements);
        }
        this.leaveScope();
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        if (condition != null && !alwaysTrue) {
            exits.push(postCondition);
        }
        this.assignment().finishLoop(exits);
        this.leaveScope();
    }

    // The loop needs an array or a value whose type implements 'Iterable<T>', proven non-null; the
    // element binding takes its annotated type when one is written and the element type otherwise.
    checkForEachStatement(ForEachStatementNode node) {
        this.enterScope();
        Type iterable = this.analyzeExpression(node.iterable());
        Type element = this.store().errorType();
        if (!(iterable is ErrorType)) {
            if (iterable is OptionalType) {
                this.reporter().report(nullguidance.maybeNullRefusal(this, "'for (... in ...)' cannot "
                    + "iterate '{this.names().of(iterable)}' because it", node.iterable(), iterable),
                    node.iterable().span());
            } else if (iterable is ArrayType) {
                element = iterable.element();
            } else if (types.isClassLike(iterable) || types.isStructLike(iterable)) {
                element = this.iterableElementType(iterable, node.declaredType(), node.iterable().span());
            } else if (iterable is StringType) {
                this.reporter().report("A 'string' cannot be iterated directly. "
                    + stringWalkAdvice(node.iterable()), node.iterable().span());
            } else {
                this.reporter().report("'for (... in ...)' needs an array or an iterable value, but "
                    + "{wording.sideNamed(node.iterable(), "the value it walks")} has type "
                    + "'{this.names().of(iterable)}'. A class or a struct is iterable when it implements "
                    + "'Iterable<T>' from '@std.collections.iterator'.", node.iterable().span());
            }
        }
        Type bindingType = element;
        let declaredType = node.declaredType();
        if (declaredType != null) {
            Type declared = this.resolver().resolveType(declaredType);
            if (!(declared is ErrorType) && !(element is ErrorType)
                    && !convert.isAssignableStrict(declared, element)) {
                string conformance = nullguidance.valueConformanceHint(declared, element, this.names());
                // The conformance explanation ends with its own suggestion, which names the
                // same type the general one would.
                string fix = "";
                if (conformance.length == 0) {
                    fix = " Declare it as '{this.names().of(element)} {node.name().text()}', or with a wider "
                        + "type.";
                }
                this.reporter().report("Loop variable '{node.name().text()}' has type "
                    + "'{this.names().of(declared)}', but this loop gives it '{this.names().of(element)}' "
                    + "values.{conformance}{fix}", declaredType.span());
            }
            bindingType = declared;
        }
        bool isConst = false;
        let keyword = node.letKeyword();
        if (keyword != null && keyword.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let binding = new LocalBinding(node.name().text(), bindingType, BindingKind.Variable,
            isConst, node.name().span());
        if (isConst && declaredType == null) {
            this.untypedConstantLocals.push(binding);
        }
        let current = this.scope;
        if (current != null) {
            current.define(binding);
        }
        this.result().setBinding(node.green(), binding);
        let entry = this.assignment().snapshot();
        this.assignment().trackLocal(binding, assigned: true);
        this.assignment().beginLoop();
        this.frame().enterLoop();
        narrowing.preClearLoopBodyWrites(this, node.body());
        this.walkScopedBlock(node.body());
        this.frame().leaveLoop();
        let exits = this.assignment().endLoop();
        exits.push(entry);
        this.assignment().finishLoop(exits);
        this.leaveScope();
    }

    // The element type a value yields in a for-in loop. Iteration is nominal: the type must
    // implement 'Iterable<T>' from '@std.collections.iterator', directly or through an
    // interface extending it, and for a class a base class's conformance counts. A value whose
    // own type is 'Iterable<T>' or a sub-interface of it iterates too, and so does a struct that
    // declares the conformance, whose 'makeIterator' is then a direct call.
    iterableElementType(Type core, TypeNode? declaredElement, Span span) -> Type {
        for (let level in hierarchy.conformanceLadderOf(core)) {
            let found = iterableArgument(level);
            if (found != null) {
                return found;
            }
        }
        string element = "E";
        string gloss = ", where 'E' is the type of its elements";
        if (declaredElement != null) {
            element = wording.greenSpelling(declaredElement.green());
            gloss = "";
        }
        string shown = this.names().of(core);
        string kind = "class";
        if (types.isStructLike(core)) {
            kind = "struct";
        }
        let declared = types.authorityOf(core);
        if (declared != null) {
            shown = declared.name();
        }
        this.reporter().report("'{this.names().of(core)}' cannot be used in 'for (... in ...)', because it "
            + "does not implement 'Iterable' from '@std.collections.iterator'. Declare '{kind} {shown} "
            + "implements Iterable<{element}>' and give it the method 'override makeIterator() -> "
            + "Iterator<{element}>'{gloss}.",
            span);
        return this.store().errorType();
    }

    checkReturnStatement(ReturnStatementNode node) {
        if (this.frame().currentNoreturn()) {
            this.reporter().report("{this.frame().currentReturnSubject()} is 'noreturn', so it never "
                + "returns and cannot contain 'return'. Throw, call 'panic' or call another 'noreturn' "
                + "function instead.", node.returnKeyword().span());
            let returned = node.value();
            if (returned != null) {
                this.analyzeExpression(returned);
            }
            return;
        }
        let expected = this.frame().currentReturnType();
        if (expected == null) {
            string place = "outside any of them";
            let field = this.frame().fieldDefaultName();
            if (field != null) {
                place = "in the default value of field '{field}'";
            }
            this.reporter().report("'return' can only be used inside the body of a function, a method or a "
                + "lambda, and this one is {place}. Remove it.", node.returnKeyword().span());
            let ignored = node.value();
            if (ignored != null) {
                this.analyzeExpression(ignored);
            }
            return;
        }
        let value = node.value();
        if (value == null) {
            if (!types.isVoidType(expected)) {
                this.reporter().report("{this.frame().currentReturnSubject()} returns "
                    + "'{this.names().of(expected)}', but this 'return' has no value. "
                    + "Write the value after 'return', as in 'return ...;'.", node.returnKeyword().span());
            }
            return;
        }
        LiteralOrigin? origin = null;
        let returnOrigin = this.frame().currentReturnOrigin();
        if (returnOrigin != null) {
            origin = literalfixes.valueOrigin(this, OriginKind.Returned, returnOrigin.name(), expected, value,
                node);
        }
        Type actual = this.analyzeExpressionAdapt(value, expected, origin);
        if (types.isVoidType(expected)) {
            string refusal = "{this.frame().currentReturnSubject()} returns nothing, so this 'return' cannot "
                + "have a value.";
            bool spelled = !(actual is ErrorType) && !(actual is NullType) && !types.isVoidType(actual)
                && this.names().canSpell(actual);
            if (this.frame().currentReturnHeader().length > 0 && spelled) {
                refusal = "{refusal} Write 'return;', or declare a return type, as in "
                    + "'{this.frame().currentReturnHeader()} -> {this.names().of(actual)}'.";
            } else if (this.frame().currentReturnHeader().length > 0) {
                refusal = "{refusal} Write 'return;', or declare a return type.";
            } else {
                refusal = "{refusal} Write 'return;'.";
            }
            this.reporter().report(refusal, value.span());
            return;
        }
        if (!convert.isAssignableStrict(expected, actual)) {
            this.reporter().report("{this.frame().currentReturnSubject()} returns "
                + "'{this.names().of(expected)}', but this value has type '{this.names().of(actual)}'."
                + "{nullguidance.valueAssignabilityHint(this, expected, actual, value)}", value.span());
        }
    }

    // A type parameter qualifies as a thrown type through a class bound under 'Error', the active
    // constraint scope included.
    checkThrowStatement(ThrowStatementNode node) {
        Type thrown = this.analyzeExpression(node.value());
        if (thrown is ErrorType) {
            return;
        }
        let errorClass = this.resolver().errorClass();
        if (thrown is TypeParamType) {
            if (errorClass == null || !hierarchy.isAlwaysSubclassOfUnder(thrown, errorClass,
                    this.resolver().activeConstraintOwner(), this.resolver().activeConstraints())) {
                string parameter = this.names().of(thrown);
                string where = "where '{parameter}' is declared";
                if (thrown.ownerName().length > 0) {
                    where = "in '{thrown.ownerName()}'";
                }
                this.reporter().report("Cannot throw {wording.sideNamed(node.value(), "this value")}, "
                    + "because its type '{parameter}' is a type parameter without the bound 'Error'. Declare "
                    + "it as '<{parameter}: Error>' {where}.", node.value().span());
            }
            return;
        }
        bool allowed = errorClass != null && types.isClassLike(thrown)
            && hierarchy.isSubclassOf(thrown, errorClass);
        if (!allowed) {
            this.reporter().report("Cannot throw a value of type '{this.names().of(thrown)}'. Only an "
                + "'Error', or an object of a subclass of 'Error', can be thrown.", node.value().span());
        }
    }

    // Refuses the condition 'node' of the statement or operator 'what' unless it is a 'bool'.
    public checkConditionIsBool(Type condition, string what, Expression node) {
        if (!(condition is ErrorType) && !convert.isBoolType(condition)) {
            this.reporter().report("The condition of this '{what}' must be a 'bool', but "
                + "{wording.sideNamed(node, "the condition")} has type '{this.names().of(condition)}'.",
                node.span());
        }
    }

    // ---- Expressions ----

    public analyzeExpression(Expression node) -> Type {
        Type analyzed = this.analyzeExpressionInner(node);
        this.result().setType(node.green(), analyzed);
        return analyzed;
    }

    analyzeExpressionInner(Expression node) -> Type {
        switch (node) {
            is LiteralExpressionNode literal -> {
                return literaltyping.analyzeLiteral(this, literal);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeIdentifier(identifier);
            },
            is ThisExpressionNode keyword -> {
                return this.analyzeThis(keyword);
            },
            is SuperExpressionNode keyword -> {
                return this.analyzeSuper(keyword);
            },
            is BinaryExpressionNode binary -> {
                return operators.analyzeBinary(this, binary);
            },
            is PrefixExpressionNode prefix -> {
                return operators.analyzePrefix(this, prefix);
            },
            is PostfixExpressionNode postfix -> {
                return operators.analyzePostfix(this, postfix);
            },
            is CallExpressionNode call -> {
                return this.analyzeCall(call, null);
            },
            is GenericNameExpressionNode generic -> {
                return staticmembers.analyzeGenericNameValue(this, generic);
            },
            is MemberExpressionNode member -> {
                return memberaccess.analyzeMemberValue(this, member);
            },
            is SafeMemberExpressionNode member -> {
                return memberaccess.analyzeSafeMemberValue(this, member);
            },
            is SubscriptExpressionNode subscript -> {
                return memberaccess.analyzeSubscript(this, subscript);
            },
            is SafeSubscriptExpressionNode subscript -> {
                return memberaccess.analyzeSafeSubscript(this, subscript);
            },
            is CastExpressionNode cast -> {
                return narrowing.analyzeCast(this, cast);
            },
            is CheckedCastExpressionNode cast -> {
                return narrowing.analyzeCheckedCast(this, cast);
            },
            is TypeTestExpressionNode test -> {
                return narrowing.analyzeTypeTest(this, test);
            },
            is AssignmentExpressionNode assignment -> {
                return assignments.analyzeAssignment(this, assignment);
            },
            is TernaryExpressionNode ternary -> {
                return valuejoins.analyzeTernary(this, ternary, null);
            },
            is NullCoalesceExpressionNode coalesce -> {
                return valuejoins.analyzeNullCoalesce(this, coalesce);
            },
            is NewExpressionNode created -> {
                return this.analyzeNew(created);
            },
            is ParenthesizedExpressionNode parenthesized -> {
                return this.analyzeExpression(parenthesized.inner());
            },
            is ArrayLiteralExpressionNode literal -> {
                return literaltyping.analyzeArrayLiteral(this, literal);
            },
            is StructLiteralExpressionNode literal -> {
                return literaltyping.analyzeStructLiteral(this, literal);
            },
            is InterpolatedStringExpressionNode interpolated -> {
                return literaltyping.analyzeInterpolatedString(this, interpolated);
            },
            is TryExpressionNode tried -> {
                return this.analyzeTry(tried);
            },
            is SwitchExpressionNode switched -> {
                return this.analyzeSwitchExpression(switched, null);
            },
            is LambdaExpressionNode lambda -> {
                this.reporter().report("This lambda has no function type to give its parameters and its "
                    + "result their types. Write it where a function type is declared, as in "
                    + "'(int, int) -> int compare = (a, b) -> a - b;'.", lambda.span());
                return this.store().errorType();
            },
            is ErrorExpressionNode ignored -> {
                return this.store().errorType();
            },
        }
    }

    // Analyzes toward a target type, which gives a lambda, an array or struct literal, an untyped
    // literal and a generic call the type they lack. A '?:', a switch and parentheses pass the target
    // on, and 'origin' is where it is set.
    public analyzeExpressionAdapt(Expression node, Type target, LiteralOrigin? origin = null) -> Type {
        if (node is ParenthesizedExpressionNode) {
            Type adapted = this.analyzeExpressionAdapt(node.inner(), target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is LambdaExpressionNode) {
            let outerHolder = this.targets().lambdaHolder();
            this.targets().setLambdaHolder(origin);
            Type adapted = this.analyzeLambda(node, target);
            this.targets().setLambdaHolder(outerHolder);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is ArrayLiteralExpressionNode) {
            Type adapted = literaltyping.analyzeArrayLiteralAdapt(this, node, target, origin);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        if (node is StructLiteralExpressionNode) {
            Type adapted = literaltyping.analyzeStructLiteralAdapt(this, node, target);
            this.result().setType(node.green(), adapted);
            return adapted;
        }
        Type analyzed = this.store().errorType();
        if (node is CallExpressionNode) {
            analyzed = this.analyzeCall(node, target);
            this.result().setType(node.green(), analyzed);
        } else if (node is TernaryExpressionNode) {
            analyzed = valuejoins.analyzeTernary(this, node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else if (node is SwitchExpressionNode) {
            analyzed = this.analyzeSwitchExpression(node, target, origin);
            this.result().setType(node.green(), analyzed);
        } else {
            this.targets().stash(node, target, origin);
            analyzed = this.analyzeExpression(node);
            this.targets().clearStash();
        }
        if (target is ErrorType || analyzed is ErrorType) {
            return analyzed;
        }
        // A 'char' is a code point rather than a quantity. Arithmetic on it in integers is
        // meaningful, but as a floating-point number it has no use, so the refusal says why
        // instead of leaving the reader to wonder which conversion was missing.
        Type held = convert.coreOf(target);
        if (types.isCharType(analyzed) && isTextualFloat(held)) {
            string name = this.names().of(held);
            string spelled = wording.oneLineSpelling(node);
            if (!wording.isSingleTerm(node)) {
                spelled = "({spelled})";
            }
            string fix = "Write '{spelled} as {name}' to use that number as a '{name}'.";
            if (wording.unwrapParentheses(node) is LiteralExpressionNode) {
                fix = "Add 'as {name}' after the literal to use that number as a '{name}'.";
            }
            this.reporter().report("A 'char' is a character's number in Unicode, its code point, and it "
                + "never converts to '{name}' on its own. " + fix, node.span());
            this.result().setType(node.green(), this.store().errorType());
            return this.store().errorType();
        }
        literalfixes.noteSuffixedTarget(this, node, target, origin);
        return literaltyping.adaptIntegerLiteral(this, node, target, origin)
            ?? literaltyping.adaptCharLiteral(this, node, target)
            ?? literaltyping.adaptFloatLiteral(this, node, target, origin) ?? analyzed;
    }

    // ---- Lambdas ----

    // The fix for the lambda 'node' written where a type that is not a function type is declared, with
    // a function type example taking the lambda's parameters.
    lambdaTypeAdvice(LambdaExpressionNode node) -> string {
        let parts = new StringBuilder();
        for (long i = 0; i < node.parametersCount(); i++) {
            if (i > 0) {
                parts.append(", ");
            }
            let written = node.parameters(i).declaredType();
            if (written != null) {
                parts.append(wording.greenSpelling(written.green()));
            } else {
                parts.append("int");
            }
        }
        string example = "({parts.toString()}) -> int";
        let holder = this.targets().lambdaHolder();
        if (holder != null && holder.kind() == OriginKind.Declared && holder.name().length > 0) {
            return "Declare '{holder.name()}' with a function type instead, such as '{example}'.";
        }
        return "Write it where a function type such as '{example}' is declared.";
    }

    // Checks a lambda against the function type its surroundings expect. The target supplies the
    // parameter types the lambda leaves out and the return type its body is checked against. The body is
    // checked as a callable of its own: its own scope, its own narrowing, its own loops, and a
    // return type of its own, so nothing about the enclosing control flow reaches into it. What
    // it reads from outside is a capture, recorded for the phases that lower it.
    analyzeLambda(LambdaExpressionNode node, Type target) -> Type {
        Type core = convert.coreOf(target);
        if (core is ErrorType) {
            return this.store().errorType();
        }
        if (!(core is FunctionType)) {
            this.reporter().report("A lambda is a function value, so it cannot be "
                + "{typenames.typeArticle(this.names().of(target))} '{this.names().of(target)}'. "
                + this.lambdaTypeAdvice(node), node.span());
            return this.store().errorType();
        }
        Type[] expected = core.parameterTypes();
        if (!this.checkLambdaShape(node, core, expected)) {
            return this.store().errorType();
        }
        let parameters = new List<Parameter>();
        for (long i = 0; i < node.parametersCount(); i++) {
            let declared = node.parameters(i);
            parameters.push(new Parameter(declared.name().text(), expected[i], false, false,
                false, declared.name().span()));
        }
        let signature = new Signature("lambda", parameters.toArray(),
            core.returnType(), false, false, [], [], [], node.green(), node.span());
        let captures = this.checkLambdaBody(node, signature);
        this.result().setLambda(node.green(),
            new LambdaInfo(signature, core, captures));
        return core;
    }

    // The lambda's parameter list against the target's: the same count, all types written or
    // none, and every written type exactly the one the target passes. Invariant, so a written
    // type that merely accepts the target's is still a mismatch.
    checkLambdaShape(LambdaExpressionNode node, FunctionType target, Type[] expected) -> bool {
        long given = node.parametersCount();
        if (given != expected.length) {
            string mine = parameterCountText(given);
            string theirs = parameterCountText(expected.length);
            this.reporter().report("This lambda takes {mine}, but '{this.names().of(target)}' "
                + "takes {theirs}. Write it as '{lambdaShapeExample(expected.length)}'.",
                node.span());
            return false;
        }
        long typed = 0;
        for (long i = 0; i < given; i++) {
            if (node.parameters(i).declaredType() != null) {
                typed++;
            }
        }
        if (typed > 0 && typed < given) {
            this.reporter().report("This lambda gives a type to some parameters and not to others. Write a "
                + "type for every parameter or for none, as in '(int a, int b) -> a + b' or "
                + "'(a, b) -> a + b'.", node.span());
            return false;
        }
        bool matched = true;
        for (long i = 0; i < given; i++) {
            let reference = node.parameters(i).declaredType();
            if (reference == null) {
                continue;
            }
            Type written = this.resolver().resolveType(reference);
            if (written is ErrorType) {
                matched = false;
                continue;
            }
            if (written != expected[i]) {
                this.reporter().report("Parameter '{node.parameters(i).name().text()}' is declared "
                    + "'{this.names().of(written)}', but the function type '{this.names().of(target)}' gives "
                    + "it {typenames.typeArticle(this.names().of(expected[i]))} "
                    + "'{this.names().of(expected[i])}'. Write '{this.names().of(expected[i])} "
                    + "{node.parameters(i).name().text()}', or leave the type out.", reference.span());
                matched = false;
            }
        }
        return matched;
    }

    // Walks the lambda's body under its own checker state and returns what it captured.
    checkLambdaBody(LambdaExpressionNode node, Signature signature) -> LambdaCapture[] {
        let lambdaFrame = new LambdaFrame(this.scope, this.frame().thisType());
        let outerScope = this.scope;
        let outerNarrowing = this.narrowingState;
        let outerFrame = this.callableFrame;
        let outerDeferred = this.targets().deferredFixes();
        bool outerAwaiting = this.targets().awaitingParameter();
        let outerAssignment = this.assignmentState;

        this.lambdaFrames.push(lambdaFrame);
        this.scope = new Scope(null);
        this.narrowingState = new NarrowingState();
        let innerFrame = outerFrame.forLambda(node, signature.returnType(),
            literalfixes.returnOriginThrough(this, this.targets().lambdaHolder(), signature.returnType()));
        this.callableFrame = innerFrame;
        this.targets().setLambdaHolder(null);
        this.targets().setDeferredFixes(null);
        this.targets().setAwaitingParameter(false);
        this.assignmentState = outerAssignment.forLambda();

        Parameter[] parameters = signature.parameters();
        let lambdaScope = this.scope;
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            this.frame().parametersInReach().push(binding);
            if (lambdaScope != null && !lambdaScope.define(binding)) {
                this.reporter().report("Parameter '{parameter.name()}' is declared twice in this lambda. "
                    + "Rename one of the two.", parameter.span());
            }
            this.result().setBinding(node.parameters(i).green(), binding);
        }

        this.enterScope();
        this.walkLambdaBody(node, signature.returnType());
        this.leaveScope();

        this.lambdaFrames.pop();
        this.scope = outerScope;
        this.narrowingState = outerNarrowing;
        this.callableFrame = outerFrame;
        // A 'super(...)' in the lambda counts as the enclosing constructor's own.
        if (innerFrame.sawSuperCall()) {
            outerFrame.noteSuperCall();
        }
        this.targets().setDeferredFixes(outerDeferred);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.assignmentState = outerAssignment;
        return lambdaFrame.result();
    }

    // A block body is a function body: every path must return a value when the target returns
    // one. An expression body is the value itself, unless the target returns nothing, in which
    // case it is evaluated and discarded like an expression statement.
    walkLambdaBody(LambdaExpressionNode node, Type returned) {
        let body = node.body();
        if (body is BlockNode) {
            this.walkBlock(body);
            if (!types.isVoidType(returned) && !(returned is ErrorType)
                    && !flow.blockTerminates(body, ExitScope.Function, this)) {
                this.reporter().report("This lambda returns '{this.names().of(returned)}', but a path "
                    + "through its body ends without a 'return'. Add a 'return' at the end of every path.",
                    node.arrow().span());
            }
            return;
        }
        if (body is Expression) {
            if (types.isVoidType(returned)) {
                this.analyzeExpression(body);
                return;
            }
            Type actual = this.analyzeExpressionAdapt(body, returned, this.frame().currentReturnOrigin());
            if (!(returned is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(returned, actual)) {
                this.reporter().report("This lambda must return '{this.names().of(returned)}', but its body "
                    + "has type '{this.names().of(actual)}'."
                    + "{nullguidance.valueAssignabilityHint(this, returned, actual, body)}", body.span());
            }
        }
    }

    // A name the lambda being checked does not declare itself: the enclosing lambdas' scopes,
    // outermost last, then the enclosing callable's. Finding one there is a capture, and every
    // lambda between the declaration and the use copies it.
    lookupCapture(string name) -> LocalBinding? {
        for (long i = this.lambdaFrames.length() - 1; i >= 0; i--) {
            let found = this.lambdaFrames.get(i).lookupOuter(name);
            if (found == null) {
                continue;
            }
            for (long j = i; j < this.lambdaFrames.length(); j++) {
                this.lambdaFrames.get(j).captureBinding(found);
            }
            return found;
        }
        return null;
    }

    // Records that every lambda being checked copies the enclosing receiver, which is what makes
    // 'this' readable, its fields writable, and its methods callable inside a lambda. A struct
    // receiver is refused: copying it would give the lambda its own struct, so a write through
    // the copy would not be a write to the one the method runs over. A primitive receiver is a
    // value nothing can write through, so copying it changes nothing and it is allowed.
    captureReceiver(Type receiver, Span at) {
        long depth = this.lambdaFrames.length();
        if (depth == 0) {
            return;
        }
        if (functionvalues.refusesThisCapture(receiver)) {
            if (this.lambdaFrames.get(depth - 1).captureReceiver(receiver)) {
                this.reporter().report("A lambda cannot capture 'this' here: "
                    + functionvalues.structThisAdvice(this.names().of(receiver)), at);
            }
            return;
        }
        for (long i = 0; i < depth; i++) {
            let ignored = this.lambdaFrames.get(i).captureReceiver(receiver);
        }
    }

    // Whether the binding is declared outside the lambda being checked, so a write to it would land on
    // the lambda's own copy.
    isCapturedBinding(LocalBinding binding) -> bool {
        if (this.lambdaFrames.length() == 0) {
            return false;
        }
        return this.lambdaFrames.get(this.lambdaFrames.length() - 1).holds(binding);
    }

    // Whether the lambda being checked read 'this' of a struct, which reported that it cannot capture it.
    public lambdaRefusedThis() -> bool {
        long depth = this.lambdaFrames.length();
        let receiver = this.frame().thisType();
        return depth > 0 && receiver != null && functionvalues.refusesThisCapture(receiver)
            && this.lambdaFrames.get(depth - 1).readsReceiver;
    }

    // Reports a write to a captured local; true when it reported. 'action' names what the write
    // would do, so '=' and '++' read naturally.
    reportCapturedWrite(LocalBinding binding, string action, Span at) -> bool {
        if (!this.isCapturedBinding(binding)) {
            return false;
        }
        this.reporter().report("Cannot {action} '{binding.name()}' inside a lambda: a lambda works "
            + "on copies of what it captures, so the '{binding.name()}' outside it would not "
            + "change. Return the value the lambda computes and store it where the lambda is called, or "
            + "keep the value in a field of an object the lambda uses.", at);
        return true;
    }

    // Reports a write refused for where it stands rather than for what it names; true when it
    // reported. 'action' names what the write would do, so '=' and '++' read naturally.
    public reportRefusedWrite(LocalBinding binding, string action, Span at) -> bool {
        if (this.reportCapturedWrite(binding, action, at)) {
            return true;
        }
        return this.reportSiblingFieldWrite(binding, at);
    }

    // The binding a write to a member chain changes, or null where the chain changes another
    // object instead. A struct field lives in the value that holds it, so a chain of them
    // changes what stands at its root, while a class reference or an array element anywhere
    // along it leads to storage of its own.
    public writtenChainRoot(Expression target) -> LocalBinding? {
        Expression root = wording.unwrapParentheses(target);
        while (root is MemberExpressionNode) {
            let objectType = this.result().typeOf(root.object().green());
            if (objectType == null || !types.isStructLike(objectType)) {
                return null;
            }
            root = wording.unwrapParentheses(root.object());
        }
        if (root is IdentifierExpressionNode) {
            return this.result().bindingOf(root.green());
        }
        return null;
    }

    // Reports a write to a sibling field inside a field default; true when it reported. A
    // default is the value of the field it belongs to, so it reads its siblings and writes none
    // of them. A default naming its own field is refused by the checks phase instead.
    reportSiblingFieldWrite(LocalBinding binding, Span at) -> bool {
        if (binding.kind() != BindingKind.SiblingField) {
            return false;
        }
        let defaulted = this.frame().fieldDefaultName();
        if (defaulted == null || defaulted == binding.name()) {
            return false;
        }
        this.reporter().report("Field '{binding.name()}' cannot be assigned inside the default of "
            + "'{defaulted}'. A default gives its own field a value and reads earlier ones, so "
            + "give '{binding.name()}' its value in its own default, or assign both fields in a "
            + "constructor.", at);
        return true;
    }

    // True when the name belongs to an import that the link phase refused and reported.
    isRefusedImport(string name) -> bool {
        return this.context().linkTable().binding(name) is RefusedImport;
    }

    analyzeIdentifier(IdentifierExpressionNode node) -> Type {
        string name = node.name().text();
        if (name.length == 0) {
            return this.store().errorType();
        }
        let wanted = this.targets().functionTargetOf(node.green());
        let primitive = types.primitiveNamed(this.store(), name);
        if (primitive != null) {
            this.reportTypeAsValue(name, primitive, node.name().span());
            return this.store().errorType();
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            if (this.isRefusedImport(name)) {
                return this.store().errorType();
            }
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter().report(this.staticWithoutType(name, ownerName, false, wanted),
                    node.name().span());
                return this.store().errorType();
            }
            this.reporter().report("Undefined name '{name}'. Check the spelling, or declare it "
                + "before it is used.", node.name().span());
            return this.store().errorType();
        }
        switch (resolution) {
            is LocalName local -> {
                this.result().setBinding(node.green(), local.binding());
                this.assignment().checkDefiniteAssignment(local.binding(), node.name().span());
                let proven = this.narrowingState.provenType(narrow.bindingPath(local.binding()));
                if (proven != null) {
                    return proven;
                }
                return local.binding().type();
            },
            is FunctionName functions -> {
                this.reportFunctionAsValue(name, functions.entries, node.name().span(), name, wanted);
                return this.store().errorType();
            },
            is TypeName named -> {
                this.reportTypeAsValue(name, named.target(), node.name().span());
                return this.store().errorType();
            },
            is TypeParameterName held -> {
                this.reportTypeParameterRefusal("'{name}' is a type parameter, not a value.",
                    held.parameter(), node.name().span(), NamePosition.Value);
                return this.store().errorType();
            },
            is NamespaceName module -> {
                this.reportModuleAsValue(name, module.targetModulePath(), node.name().span());
                return this.store().errorType();
            },
        }
    }

    // 'named' is the type the refused name stands for, and 'spelling' is how this file writes
    // that name.
    reportTypeAsValue(string spelling, Type named, Span at) {
        this.reporter().report(this.typeAsValueMessage(spelling, named), at);
    }

    // The message a type name written where a value belongs is refused with.
    typeAsValueMessage(string spelling, Type named) -> string {
        return this.typeRefusalMessage("'{spelling}' is a type, not a value.", spelling, named);
    }

    // A type name written as the callee of a call. The routes are the ones a value position
    // offers, since a type name reaches no call of its own.
    reportTypeAsCall(string spelling, Type named, Span at) {
        this.reporter().report(this.typeRefusalMessage("'{spelling}' is a type, not a function.",
            spelling, named), at);
    }

    // The refusal sentence the position writes, then the routes to a value of the type this
    // file can spell.
    typeRefusalMessage(string refusal, string spelling, Type named) -> string {
        string fix = this.typeAsValueFix(spelling, named);
        if (fix.length == 0) {
            return refusal;
        }
        return "{refusal} {fix}.";
    }

    // 'refusal' is the sentence the position writes, followed by how this position reaches a
    // value of the parameter's type. Only a parameter holds one, so the route names one in
    // reach, else the one a callable's body can declare, and a default reaches neither.
    reportTypeParameterRefusal(string refusal, TypeParamType parameter, Span at, NamePosition position) {
        string name = parameter.name();
        string written = refusal;
        let inReach = this.parameterOfType(parameter);
        if (inReach != null) {
            written = "{refusal} Use a value of type '{name}', such as '{inReach.name()}'.";
        } else if (this.frame().inCallableBody()) {
            written = "{refusal} Use a value of type '{name}', such as a parameter declared '{name} value'.";
        }
        this.reporter().report(this.typeParameterMessage(parameter, written, position), at);
    }

    // The parameter in reach whose type is this one, innermost first, or null where none is. A
    // local is left out, because naming one would need it to be assigned where it is named.
    parameterOfType(Type type) -> LocalBinding? {
        for (long i = this.frame().parametersInReach().length() - 1; i >= 0; i--) {
            let binding = this.frame().parametersInReach().get(i);
            if (binding.type() == type) {
                return binding;
            }
        }
        return null;
    }

    // What a refused type parameter reads: the collision where it took the name from another
    // meaning of the file, the refusal of a position that can use no type parameter at all, and
    // 'plain' where the name means nothing else there.
    public typeParameterMessage(TypeParamType parameter, string plain, NamePosition position) -> string {
        let asStatic = this.shadowedStaticMessage(parameter, position);
        if (asStatic != null) {
            return asStatic;
        }
        string name = parameter.name();
        // 'obligationOwnerName' is the generic declaration whose body is being checked, which
        // is the one whose header introduced the parameter.
        string genericOwner = this.obligationOwnerName;
        let taken = this.shadowedMeaning(name);
        if (taken == null || genericOwner.length == 0) {
            return this.resolver().typeParameterRefusal() ?? plain;
        }
        return typenames.typeParameterTookNameMessage(name, genericOwner, taken);
    }

    // A static of the enclosing type under the refused name, or null where it declares none. A
    // static const is read through the plain type name, while a static method of a generic type
    // needs the type arguments that only such a call itself could otherwise determine. Where the
    // name was written as a call, reading the static const also means dropping the arguments.
    shadowedStaticMessage(TypeParamType parameter, NamePosition position) -> string? {
        let owner = this.frame().enclosingOwner();
        if (owner == null) {
            return null;
        }
        let authority = types.authorityOf(owner);
        if (authority == null) {
            return null;
        }
        string name = parameter.name();
        string ownerName = authority.name();
        string kind = "";
        if (members.findField(typemembers.staticFieldsOf(owner), name) != null) {
            kind = "static const";
        } else if (members.findMethodNamed(typemembers.staticMethodsOf(owner), name) != null) {
            kind = "static method";
        } else {
            return null;
        }
        string refusal = "'{name}' means the type parameter of '{ownerName}' here, not the {kind} "
            + "'{ownerName}' declares, because inside '{ownerName}' the name '{name}' always means the "
            + "type parameter.";
        if (kind == "static method") {
            return "{refusal} Rename one of the two.";
        }
        if (position == NamePosition.Call) {
            return "{refusal} A static const is not called. Write '{ownerName}.{name}' to read it, or rename "
                + "one of the two and remove the arguments.";
        }
        return "{refusal} Write '{ownerName}.{name}' to read the static const, or rename one of the two.";
    }

    // The meaning a type parameter took its name from, as the refusal names it, or null where
    // the name means nothing else in the file.
    shadowedMeaning(string name) -> string? {
        let outside = this.resolveNameOutsideTypeParameters(name);
        if (outside == null) {
            return null;
        }
        switch (outside) {
            is TypeName named -> {
                return this.declaringPhrase(typenames.kindWordOf(named.target()),
                    named.target().modulePath());
            },
            is FunctionName functions -> {
                let offered = functions.fromPrelude;
                if (offered == null) {
                    return this.declaringPhrase("function", this.modulePath());
                }
                string[] paths = offered.modulePaths();
                if (paths.length != 1) {
                    return null;
                }
                return this.declaringPhrase("function", paths[0]);
            },
            is NamespaceName module -> {
                return typenames.importedModulePhrase(module.targetModulePath());
            },
            default -> {
                return null;
            },
        }
    }

    // Where a shadowed meaning is declared, as the refusal names it.
    declaringPhrase(string kindWord, string modulePath) -> string {
        return typenames.declaringPhrase(kindWord, modulePath, this.modulePath());
    }

    // How this file writes a value of the type, then how it reaches a static member of it. A
    // route this file cannot spell is left out, and the fix is empty where it can spell neither.
    typeAsValueFix(string spelling, Type named) -> string {
        string value = this.valueRoute(spelling, named);
        let staticMember = this.staticMemberExample(spelling, named);
        if (staticMember == null) {
            return value;
        }
        string purpose = "to read one of its static consts";
        if (staticMember.endsWith(")")) {
            purpose = "to call one of its static methods";
        }
        if (value.length == 0) {
            return "Write '{staticMember}' {purpose}";
        }
        return "{value}, or write '{staticMember}' {purpose}";
    }

    // The way a value of the type is written where the refused name stands, or empty where this
    // file can spell none. A primitive's values are its literals, which the refusal leaves to
    // the reader.
    valueRoute(string spelling, Type named) -> string {
        let authority = types.authorityOf(named);
        if (authority == null) {
            return "";
        }
        switch (authority) {
            is InterfaceType ignored -> {
                return "Use a value of a class that implements it";
            },
            is EnumType enumType -> {
                string[] constants = enumType.memberNames();
                if (constants.length == 0) {
                    return "";
                }
                return "Write '{spelling}.{constants[0]}' to use one of its members";
            },
            is ClassType classType -> {
                if (classType.isAbstract()) {
                    return "Use a value of a subclass that is not abstract";
                }
                // Constructing a generic class needs type arguments, and an example cannot put
                // one there that the use site has a name for.
                if (classType.isGeneric()) {
                    return "";
                }
                let arguments = this.classConstructionArguments(classType);
                if (arguments == null) {
                    return "";
                }
                return "Write 'new {spelling}{arguments}' to construct one";
            },
            is StructType structType -> {
                // A generic struct needs type arguments in its constructor call and in the
                // literal alike, and an example cannot name one.
                if (structType.isGeneric()) {
                    return "";
                }
                return this.structValueRoute(spelling, structType);
            },
            default -> {
                return "";
            },
        }
    }

    // How a struct value is written: a constructor call, or an aggregate literal where this file
    // can reach no constructor.
    structValueRoute(string spelling, Type structType) -> string {
        let arguments = this.reachableConstructorArguments(structType);
        if (arguments != null) {
            return "Write '{spelling}{arguments}' to construct one";
        }
        let literal = this.structLiteralExample(spelling, structType);
        if (literal == null) {
            return "";
        }
        return "Write '{literal}' to build one";
    }

    // A declaration that builds the struct from an aggregate literal, naming every field the
    // literal has to set. Null where a field it has to set cannot be set from this file.
    structLiteralExample(string spelling, Type structType) -> string? {
        let fields = typemembers.fieldsOf(structType);
        if (fields == null) {
            return null;
        }
        let listed = new StringBuilder();
        for (long i = 0; i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.hasDefault()) {
                continue;
            }
            if (!memberaccess.isAccessAllowed(this, field.visibility(), field.definingType())) {
                return null;
            }
            if (!listed.isEmpty()) {
                listed.append(", ");
            }
            listed.append("{field.name()}: ...");
        }
        return "{spelling} value = \{{listed.toString()}\};";
    }

    // The argument list a 'new' of the class writes, or null where this file can reach no
    // constructor of it.
    public classConstructionArguments(Type classType) -> string? {
        if (typemembers.constructorsOf(classType).length() > 0) {
            return this.reachableConstructorArguments(classType);
        }
        if (this.reachesImplicitConstruction(classType)) {
            return "()";
        }
        return null;
    }

    // '()' where a constructor this file can reach takes no argument, '(...)' where the ones it
    // can reach take arguments, and null where it can reach none.
    reachableConstructorArguments(Type record) -> string? {
        let constructors = typemembers.constructorsOf(record);
        bool anyReachable = false;
        for (long i = 0; i < constructors.length(); i++) {
            let candidate = constructors.get(i);
            if (!this.resolver().memberExists(candidate)
                    || !memberaccess.isAccessAllowed(this, candidate.visibility(),
                        candidate.definingType())) {
                continue;
            }
            if (calls.requiredArgumentCount(candidate.signature()) == 0) {
                return "()";
            }
            anyReachable = true;
        }
        if (anyReachable) {
            return "(...)";
        }
        return null;
    }

    // Whether a class that declares no constructor of its own is constructed with no arguments.
    // Its implicit chain must run a base constructor that exists here, or none at all.
    reachesImplicitConstruction(Type classType) -> bool {
        let chain = typemembers.implicitBaseConstructor(classType);
        if (chain.owner() == null) {
            return true;
        }
        let chosen = chain.chosen();
        return chosen != null && this.resolver().memberExists(chosen);
    }

    // One static member of the type this file can reach, written after 'spelling'. A type-level
    // const reads as a value on its own and a static method reads as a call.
    staticMemberExample(string spelling, Type named) -> string? {
        let fields = typemembers.staticFieldsOf(named);
        if (fields != null) {
            for (long i = 0; i < fields.length(); i++) {
                let field = fields.get(i);
                if (memberaccess.isAccessAllowed(this, field.visibility(), field.definingType())) {
                    return "{spelling}.{field.name()}";
                }
            }
        }
        let authority = types.authorityOf(named);
        // A static method of a generic type may need type arguments that only the arguments of
        // the call itself determine.
        if (authority != null && authority.isGeneric()) {
            return null;
        }
        let methods = typemembers.staticMethodsOf(named);
        if (methods == null) {
            return null;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (!memberaccess.isAccessAllowed(this, method.visibility(), method.definingType())) {
                continue;
            }
            let call = callExample("{spelling}.{method.name()}", method.signature());
            if (call != null) {
                return call;
            }
        }
        return null;
    }

    // 'spelling' is how this file writes the function's name, which is 'module.name' where a
    // module qualifies it, and 'head' is the name it starts with. 'wanted' is the function type
    // expected where it is written.
    public reportFunctionAsValue(string spelling, List<FunctionEntry> entries, Span at, string head,
                          FunctionType? wanted) {
        if (wanted != null) {
            let signatures = new List<Signature>();
            for (let entry in entries) {
                signatures.push(entry.signature());
            }
            let fix = functionvalues.lambdaFix(this, "function", spelling, signatures.toArray(), wanted,
                head);
            this.reporter().report(functionvalues.functionValueRefusal("'{spelling}' is a function", fix,
                spelling), at);
            return;
        }
        bool bare = true;
        bool throwing = entries.length() > 0;
        for (let entry in entries) {
            if (entry.signature().parameters().length > 0) {
                bare = false;
            }
            if (!entry.signature().declaresThrows()) {
                throwing = false;
            }
        }
        string call = "{spelling}(...)";
        if (bare) {
            call = "{spelling}()";
        }
        if (throwing) {
            call = "try " + call;
        }
        string message = "'{spelling}' is a function, and a function's name is not a value. "
            + "Call it as '{call}', or wrap it in a lambda";
        let example = this.lambdaDeclarationFor(spelling, entries);
        if (example == null) {
            this.reporter().report(message + ".", at);
            return;
        }
        this.reporter().report(message + ", as in '{example}'.", at);
    }

    reportModuleAsValue(string name, string targetPath, Span at) {
        this.reportModuleRefusal("'{name}' names a module, not a value.", name, targetPath, at);
    }

    reportModuleAsCall(string name, string targetPath, Span at) {
        this.reportModuleRefusal("'{name}' names a module, not a function.", name, targetPath,
            at);
    }

    // 'refusal' is the sentence the position writes, and 'name' is how this file writes the
    // module. The example calls a function the module declares, because a type it declares is
    // refused in a value position too.
    reportModuleRefusal(string refusal, string name, string targetPath, Span at) {
        let called = this.moduleFunctionExample(name, targetPath);
        if (called == null) {
            this.reporter().report(refusal, at);
            return;
        }
        this.reporter().report(refusal + " Write one of its functions after the module name, as in "
            + "'{called}'.", at);
    }

    // A call this file can write to a function the module declares, or null where it can write
    // none. The module's declaration order decides which function that is, and the functions the
    // language provides in every module are not among them.
    moduleFunctionExample(string name, string targetPath) -> string? {
        let target = this.contextsByPath().get(targetPath);
        if (target == null) {
            return null;
        }
        string targetPackagePrefix = target.module().packagePrefix();
        let entries = target.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isBuiltin()) {
                continue;
            }
            if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                    this.modulePath(), this.packagePrefix())) {
                continue;
            }
            let signature = entry.signature();
            let call = callExample("{name}.{signature.name()}", signature);
            if (call != null) {
                return call;
            }
        }
        return null;
    }

    // A declaration holding a lambda that calls the named function, or null when the name has no
    // one function type this file can write. Several overloads, a generic, an 'out' parameter, a
    // 'throws' whose types the body decides, and a type this file cannot name each leave none.
    lambdaDeclarationFor(string spelling, List<FunctionEntry> entries) -> string? {
        if (entries.length() != 1) {
            return null;
        }
        let signature = entries.get(0).signature();
        Type[] thrown = signature.throwsTypes();
        if (signature.isGeneric() || (signature.declaresThrows() && thrown.length == 0)) {
            return null;
        }
        let parameterTypes = new List<Type>();
        let passed = new StringBuilder();
        for (let parameter in signature.parameters()) {
            if (parameter.isOut()) {
                return null;
            }
            if (parameterTypes.length() > 0) {
                passed.append(", ");
            }
            parameterTypes.push(parameter.type());
            passed.append(parameter.name());
        }
        Type held = this.store().functionOf(parameterTypes.toArray(), signature.returnType(),
            thrown);
        if (!this.names().canSpell(held)) {
            return null;
        }
        string typeText = this.names().of(held);
        string arguments = passed.toString();
        if (thrown.length > 0) {
            return "({typeText}) callback = ({arguments}) -> try {spelling}({arguments});";
        }
        return "{typeText} callback = ({arguments}) -> {spelling}({arguments});";
    }

    // The enclosing type's name when it declares a static under the given name, for the
    // uniform-access suggestion; null otherwise.
    staticSuggestionOwner(string name) -> string? {
        let owner = this.frame().enclosingOwner();
        if (owner == null) {
            return null;
        }
        if (members.findField(typemembers.staticFieldsOf(owner), name) == null
                && members.findMethodNamed(typemembers.staticMethodsOf(owner), name) == null) {
            return null;
        }
        let authority = types.authorityOf(owner);
        if (authority == null) {
            return null;
        }
        return authority.name();
    }

    // How a refusal names a function value called by 'calleeName', which is empty for one with no name.
    functionValueName(string calleeName) -> string {
        if (calleeName.length == 0) {
            return "this function value";
        }
        return "'{calleeName}'";
    }

    // The refusal of the static 'name' of the enclosing type 'ownerName', written without the type
    // name in front. 'called' is true when the code calls it, and 'wanted' is the function type
    // expected where it is written.
    staticWithoutType(string name, string ownerName, bool called, FunctionType? wanted = null) -> string {
        let owner = this.frame().enclosingOwner();
        string kind = "static method";
        if (owner != null) {
            let field = members.findField(typemembers.staticFieldsOf(owner), name);
            if (field != null && field.isLazy()) {
                kind = "lazy const";
            } else if (field != null) {
                kind = "static const";
            }
        }
        if (kind == "static method") {
            string refusal = "'{name}' is a static method of '{ownerName}', and a static method is always "
                + "called through its type name, even inside '{ownerName}'.";
            if (wanted != null && owner != null) {
                let statics = memberaccess.staticsNamed(owner, name);
                let fix = functionvalues.lambdaFix(this, "method", name,
                    staticmembers.reachedSignatures(this, statics, wanted), wanted, ownerName);
                if (fix.fit() != LambdaFit.Called) {
                    string spelling = "'{fix.before()}{ownerName}.{name}{fix.after()}'";
                    return "{refusal} {functionvalues.nameNotValueText(fix, spelling)}";
                }
            }
            return "{refusal} Write '{ownerName}.{name}(...)'.";
        }
        string refusal = "'{name}' is a {kind} of '{ownerName}', and a {kind} is always read through its "
            + "type name, even inside '{ownerName}'. Write '{ownerName}.{name}'.";
        if (called) {
            return "{refusal} A {kind} is not called, so remove the arguments as well.";
        }
        return refusal;
    }

    analyzeThis(ThisExpressionNode node) -> Type {
        let receiver = this.frame().thisType();
        if (receiver == null) {
            if (this.frame().inStaticMethod()) {
                this.reporter().report("'this' is the object a method was called on, and a static method "
                    + "is not called on an object. Take the object as a parameter, or remove 'static'.",
                    node.thisKeyword().span());
            } else {
                this.reporter().report("'this' is the object a method was called on, so it is only "
                    + "available inside a method. Pass the object as a parameter, or move this code into a "
                    + "method.", node.thisKeyword().span());
            }
            return this.store().errorType();
        }
        this.captureReceiver(receiver, node.thisKeyword().span());
        return receiver;
    }

    analyzeSuper(SuperExpressionNode node) -> Type {
        let receiver = this.frame().thisType();
        if (receiver == null) {
            if (this.frame().inStaticMethod()) {
                this.reporter().report("'super' is the part of the object a method was called on that its "
                    + "base class declares, and a static method is not called on an object. Remove 'static' "
                    + "to make it an instance method.", node.superKeyword().span());
            } else {
                this.reporter().report("'super' is the part of the object a method was called on that its "
                    + "base class declares, so it is only available inside a method. Move this code into a "
                    + "method of the subclass.", node.superKeyword().span());
            }
            return this.store().errorType();
        }
        let base = hierarchy.baseOf(receiver);
        if (base == null) {
            let authority = types.authorityOf(receiver);
            string shown = this.names().of(receiver);
            if (authority != null) {
                shown = authority.name();
            }
            this.reporter().report("'super' cannot be used in '{shown}', because '{shown}' has no base "
                + "class. Remove 'super', or give '{shown}' a base class with 'extends'.",
                node.superKeyword().span());
            return this.store().errorType();
        }
        this.captureReceiver(receiver, node.superKeyword().span());
        return base;
    }

    analyzeTry(TryExpressionNode node) -> Type {
        if (!(node.operand() is CallExpressionNode)) {
            this.reporter().report(misplacedTryRefusal(node.operand()), node.span());
        }
        Type analyzed = this.analyzeExpression(node.operand());
        this.assignment().noteThrowEscapePoint(this.frame().inCatchClause());
        return analyzed;
    }

    // The head this file writes for a struct a diagnostic offers to build, or null where it has
    // no spelling for it. An instantiation keeps its type arguments, which its literal and its
    // constructor call both need.
    structHead(Type structType, string written) -> string? {
        if (!(structType is InstantiationType)) {
            return written;
        }
        if (!this.names().canSpell(structType)) {
            return null;
        }
        return this.names().of(structType);
    }

    // A struct built by a call it has no constructor for. The literal is left out where this
    // file cannot set every field the literal has to set.
    reportStructWithoutConstructor(CallExpressionNode node, Type structType, string name) {
        string refusal = "Struct '{name}' has no constructor to call.";
        let head = this.structHead(structType, name);
        string? literal = null;
        if (head != null) {
            literal = this.structLiteralExample(head, structType);
        }
        if (literal == null) {
            this.reporter().report(refusal + " Add a 'constructor(...)' to it.", node.span());
            return;
        }
        this.reporter().report(refusal + " Build it with a literal, for example '{literal}', or "
            + "add a 'constructor(...)'.", node.span());
    }

    // 'new' written on a struct, which a constructor call or an aggregate literal builds instead.
    // 'written' is the head the 'new' carries.
    reportNewOnStruct(NewExpressionNode node, Type structType, string written) {
        string refusal = "'new' builds a class, and '{written}' is a struct.";
        let head = this.structHead(structType, written);
        string route = "";
        if (head != null) {
            route = this.structValueRoute(head, structType);
        }
        if (route.length == 0) {
            this.reporter().report(refusal + " Remove 'new', and add a 'constructor(...)' to '{written}' to "
                + "call.", node.span());
            return;
        }
        this.reporter().report("{refusal} {route}.", node.span());
    }

    // 'StructName(args)': a by-value struct built through its constructor. Resolution mirrors
    // class-constructor resolution (overloads, named and optional arguments) with no allocation.
    analyzeStructConstructorCall(CallExpressionNode node, Type structType, string name)
            -> Type {
        let arguments = node.arguments();
        Type target = structType;
        if (target is StructType && target.isGeneric()) {
            let typeArguments = node.typeArguments();
            if (typeArguments == null) {
                this.reporter().report(staticmembers.unshownTypeArguments("'{name}'", target.typeParameters(),
                    "{name}<", ">{argumentsSpelling(arguments)}",
                    staticmembers.exampleTypeArgument(arguments)), node.span());
                this.analyzeArgumentsOnly(arguments);
                return structType;
            }
            target = this.resolver().instantiateGeneric(target, name, typeArguments, node.span());
            if (target is ErrorType) {
                this.analyzeArgumentsOnly(arguments);
                return target;
            }
        }
        this.result().setType(node.green(), target);
        let allConstructors = typemembers.constructorsOf(target);
        let constructors = memberaccess.existingOnly(this, allConstructors);
        if (constructors.length() < allConstructors.length()
                && memberaccess.reportUnmetConstraintCall(this, allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return target;
        }
        if (constructors.length() == 0) {
            this.reportStructWithoutConstructor(node, target, name);
            this.analyzeArgumentsOnly(arguments);
            return target;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, constructors.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), memberaccess.isAccessAllowed(this, constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape(), this.reporter(),
                node.span(), name, "Constructor", this.names());
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible()) {
                            memberaccess.checkConstructorAccess(this, target, chosenMethod, node.span());
                        }
                        this.result().setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
            return target;
        }
        let structConstructor = constructors.get(0);
        memberaccess.checkConstructorAccess(this, target, structConstructor, node.span());
        this.result().setMethod(node.green(), structConstructor);
        this.checkDirectArguments("Constructor", name, structConstructor.signature(),
            arguments, node.span(), this.names().of(target));
        return target;
    }

    // ---- Call shapes and argument checking ----

    // With a 'single' candidate, an argument holding a literal too large for 'float' waits for its
    // parameter, so its refusal can name it.
    public buildCallShape(ArgumentListNode arguments, bool single) -> BuiltShape {
        let shape = new CallShape();
        let positionalValues = new List<Expression?>();
        let namedValues = new List<Expression?>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    string name = named.name().text();
                    for (long j = 0; j < shape.named().length(); j++) {
                        if (shape.named().get(j).name() == name) {
                            this.reporter().report("Argument '{name}' is named twice in this call. Remove "
                                + "one of the two.", named.name().span());
                            shape.markMalformed();
                            break;
                        }
                    }
                    bool waits = single && carriesOverflowingFloat(named.value());
                    if (needsTargetType(named.value()) || waits) {
                        shape.named().push(this.targetTypedArgument(name, named.value()));
                    } else {
                        bool outerAwaiting = this.targets().awaitingParameter();
                        this.targets().setAwaitingParameter(!single);
                        Type analyzed = this.analyzeExpression(named.value());
                        this.targets().setAwaitingParameter(outerAwaiting);
                        this.result().setType(named.green(), analyzed);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.named().push(this.argumentValueOf(name, named.value(), analyzed));
                    }
                    namedValues.push(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                    shape.markErrorArgument();
                    shape.positional().push(new ArgumentValue("", this.store().errorType(),
                        false, false, 0, false, outArgument.span()));
                    positionalValues.push(null);
                },
                is Expression value -> {
                    if (shape.named().length() > 0 && !shape.isMalformed()) {
                        string move = "";
                        let firstNamed = arguments.arguments(0);
                        for (long j = 0; j < i; j++) {
                            if (arguments.arguments(j) is NamedArgumentNode) {
                                firstNamed = arguments.arguments(j);
                                break;
                            }
                        }
                        let spelledValue = wording.shortSpelling(value);
                        string spelledNamed = argumentSpelling(firstNamed);
                        if (spelledValue != null && spelledNamed.length <= 30) {
                            move = " Move '{spelledValue}' before '{spelledNamed}'.";
                        }
                        this.reporter().report("Positional arguments must come before named ones.{move}",
                            value.span());
                        shape.markMalformed();
                    }
                    if (needsTargetType(value) || (single && carriesOverflowingFloat(value))) {
                        shape.positional().push(this.targetTypedArgument("", value));
                    } else {
                        bool outerAwaiting = this.targets().awaitingParameter();
                        this.targets().setAwaitingParameter(!single);
                        Type analyzed = this.analyzeExpression(value);
                        this.targets().setAwaitingParameter(outerAwaiting);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.positional().push(this.argumentValueOf("", value, analyzed));
                    }
                    positionalValues.push(value);
                },
                default -> { },
            }
        }
        let values = new List<Expression?>();
        for (long i = 0; i < positionalValues.length(); i++) {
            values.push(positionalValues.get(i));
        }
        for (long i = 0; i < namedValues.length(); i++) {
            values.push(namedValues.get(i));
        }
        return new BuiltShape(shape, values);
    }

    // An argument whose type only the parameter it is passed to determines, left unanalyzed until the
    // candidate is chosen.
    targetTypedArgument(string name, Expression value) -> ArgumentValue {
        let argument = new ArgumentValue(name, this.store().errorType(), false, false, 0, false,
            value.span());
        argument.markNeedsTarget();
        return argument;
    }

    public argumentValueOf(string name, Expression value, Type analyzed) -> ArgumentValue {
        let literal = literaltyping.intLiteralOf(value);
        if (literal != null) {
            let magnitude = literalvalues.integerMagnitude(literal.value().text());
            if (magnitude != null) {
                return new ArgumentValue(name, analyzed, true, literaltyping.isNegativeLiteral(value),
                    magnitude, false, value.span());
            }
        }
        if (value is LiteralExpressionNode && value.value().kind() == SyntaxKind.CharLiteral) {
            return new ArgumentValue(name, analyzed, false, false,
                literalvalues.charCodepoint(value.value().text()), true, value.span());
        }
        let plain = new ArgumentValue(name, analyzed, false, false, 0, false, value.span());
        let floatLiteral = literaltyping.floatLiteralOf(value);
        if (floatLiteral != null) {
            plain.markFloatLiteral(literalvalues.floatMagnitude(floatLiteral.value().text()));
        }
        return plain;
    }

    // Final argument checking against the chosen candidate: adapt untyped literals to the
    // parameter types and verify assignability, mirroring the single-candidate path.
    public checkResolvedArguments(BuiltShape built, CallResolution resolution, GreenNode callNode) -> Type {
        let chosen = resolution.chosen();
        if (chosen == null) {
            return this.store().errorType();
        }
        Parameter[] parameters = chosen.signature().parameters();
        long[] mapping = resolution.mapping();
        let shape = built.shape();
        string constructed = "";
        let method = chosen.method();
        if (method != null && method.isConstructor()) {
            constructed = this.names().of(method.definingType());
        }
        for (long i = 0; i < shape.argumentCount() && i < mapping.length; i++) {
            let argument = shape.argumentAt(i);
            Type parameterType = parameters[mapping[i]].type();
            Type finalType = argument.type();
            let value = built.values.get(i);
            if (value != null) {
                let chosenOrigin = new LiteralOrigin(OriginKind.Parameter, parameters[mapping[i]].name(),
                    chosen.signature().name(), parameterType);
                chosenOrigin.setConstructed(constructed);
                this.targets().chosenParameters().push(new ChosenParameter(value.span(), chosenOrigin));
            }
            if (value != null && argument.needsTarget()) {
                finalType = this.analyzeExpressionAdapt(value, parameterType,
                    literalfixes.argumentOrigin(this, value, chosen.signature(), mapping[i], parameterType,
                        constructed));
            } else if (value != null) {
                let origin = literalfixes.argumentOrigin(this, value, chosen.signature(), mapping[i],
                    parameterType, constructed);
                literaltyping.adaptIntegerLiteral(this, value, parameterType, origin);
                literaltyping.adaptCharLiteral(this, value, parameterType);
                literaltyping.adaptFloatLiteral(this, value, parameterType, origin);
                let updated = this.result().typeOf(value.green());
                if (updated != null) {
                    finalType = updated;
                }
            }
            if (parameterType is ErrorType || finalType is ErrorType) {
                continue;
            }
            if (!convert.isAssignableStrict(parameterType, finalType)) {
                string label = "{i + 1}";
                if (argument.name().length > 0) {
                    label = "'{argument.name()}'";
                }
                string callee = "'{chosen.signature().name()}'";
                if (constructed.length > 0) {
                    callee = "the constructor of '{constructed}'";
                }
                this.reporter().report(argumentMismatch(label, callee, parameters[mapping[i]].name(),
                    parameterType, finalType, this.names())
                    + "{nullguidance.valueAssignabilityHint(this, parameterType, finalType, value)}",
                    argument.span());
            }
        }
        if (shape.named().length() > 0) {
            this.result().setArgumentOrder(callNode, mapping);
        }
        return chosen.signature().returnType();
    }

    // Argument count and type checking against a single known signature. 'constructed' spells the
    // type a constructor builds, with its type arguments.
    public checkDirectArguments(string kindWord, string displayName, Signature signature,
                                 ArgumentListNode arguments, Span callSpan,
                                 string constructed = "") -> Type {
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter().report(calls.arityRefusal(calls.calleeSubject(kindWord, displayName), signature,
                count), callSpan);
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i].type();
                        Type actual = this.analyzeExpressionAdapt(value, parameterType,
                            literalfixes.argumentOrigin(this, value, signature, i, parameterType,
                                constructed));
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter().report(argumentMismatch("{i + 1}",
                                calleeObject(kindWord, displayName), parameters[i].name(), parameterType,
                                actual, this.names())
                                + "{nullguidance.valueAssignabilityHint(this, parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return signature.returnType();
    }

    public analyzeArgumentsOnly(ArgumentListNode arguments) {
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.analyzeExpression(named.value());
                },
                is Expression value -> {
                    this.analyzeExpression(value);
                },
                default -> { },
            }
        }
    }

    // ---- Calls ----

    // The refusals held inside a call's arguments stay held only for an argument whose type reaches
    // the call's result. The others are reported, since no enclosing join changes their fix.
    analyzeCall(CallExpressionNode node, Type? expected) -> Type {
        let outerDeferred = this.targets().deferredFixes();
        let held = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(held);
        let outerFlowing = this.targets().flowingArguments();
        this.targets().setFlowingArguments(new List<Span>());
        bool outerAwaiting = this.targets().awaitingParameter();
        this.targets().setAwaitingParameter(false);
        let outerChosen = this.targets().chosenParameters();
        this.targets().setChosenParameters(new List<ChosenParameter>());
        Type called = this.analyzeCallOf(node, expected);
        this.noteFlowingMethodArguments(node);
        this.settleParameters(held);
        let flowing = this.targets().flowingArguments();
        this.targets().setFlowingArguments(outerFlowing);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.targets().setChosenParameters(outerChosen);
        this.targets().setDeferredFixes(outerDeferred);
        this.settleArguments(held, outerDeferred, flowing, false);
        return called;
    }

    // Settles the refusals held for arguments of a call with several candidates against the
    // parameter the chosen candidate gave them. Beside a parameter of the literal's type the fix names the
    // parameter, and with no candidate chosen the refusal ends after the why.
    settleParameters(List<DeferredLiteralFix> held) {
        for (let fix in held) {
            if (!fix.awaitingParameter()) {
                continue;
            }
            fix.setAwaitingParameter(false);
            LiteralOrigin? origin = null;
            for (let chosen in this.targets().chosenParameters()) {
                if (fix.span().start >= chosen.span.start && fix.span().end() <= chosen.span.end()) {
                    origin = chosen.origin;
                }
            }
            let suffixed = fix.suffixed();
            if (origin == null) {
                fix.setMessage(fix.plain());
                continue;
            }
            let widening = fix.widening() ?? valuejoins.floatWidening();
            string declared = literalfixes.originType(this, origin);
            if (literalfixes.isFloatCore(origin.declared()) && suffixed != null) {
                string noun = literalfixes.parameterNoun(origin);
                suffixed.setFix("The '{fix.suffix()}' makes the literal a 'float', and {noun} is a "
                    + "'{declared}' too.");
            } else if (literalfixes.sameCore(origin.declared(), widening) && !fix.settled()
                    && fix.clause().length > 0 && fix.message() != fix.plain()) {
                fix.setMessage("{fix.refusal()} {fix.clause()}, and {literalfixes.parameterNoun(origin)} is "
                    + "{typenames.typeArticle(declared)} '{declared}' too.");
            } else if (!literalfixes.takesLiteral(origin.declared(), widening)) {
                fix.setMessage(fix.plain());
            }
        }
    }

    // Records the arguments of a method call that reach its result: those whose declared parameter
    // type has a type parameter while the declared return type has one too. A generic instance's
    // methods are judged as its template declares them.
    noteFlowingMethodArguments(CallExpressionNode node) {
        let access = nullguidance.accessStep(wording.unwrapParentheses(node.callee()));
        if (access == null) {
            return;
        }
        let name = access.member();
        Type receiver = convert.coreOf(this.recordedType(access.receiver()));
        if (receiver is InstantiationType) {
            receiver = receiver.template();
        }
        let methods = typemembers.methodsOf(receiver);
        if (name == null || methods == null) {
            return;
        }
        let arguments = node.arguments();
        for (let method in methods) {
            Signature signature = method.signature();
            if (method.name() != name || !convert.containsTypeParam(signature.returnType())) {
                continue;
            }
            Parameter[] parameters = signature.parameters();
            for (long i = 0; i < arguments.argumentsCount(); i++) {
                switch (arguments.arguments(i)) {
                    is NamedArgumentNode named -> {
                        for (let parameter in parameters) {
                            if (parameter.name() == named.name().text()
                                    && convert.containsTypeParam(parameter.type())) {
                                this.targets().flowingArguments().push(named.span());
                            }
                        }
                    },
                    is Expression value -> {
                        if (i < parameters.length && convert.containsTypeParam(parameters[i].type())) {
                            this.targets().flowingArguments().push(value.span());
                        }
                    },
                    default -> { },
                }
            }
        }
    }

    // Passes the refusals held inside a call to 'outer' when they lie in one of the 'flowing'
    // arguments, or in any argument when 'all' is true, and reports the others.
    settleArguments(List<DeferredLiteralFix> held, List<DeferredLiteralFix>? outer, List<Span> flowing,
                    bool all) {
        for (let fix in held) {
            if (outer == null) {
                if (fix.suffixed() == null) {
                    this.reporter().report(fix.message(), fix.span());
                }
                continue;
            }
            bool flows = all;
            for (let argument in flowing) {
                if (fix.span().start >= argument.start && fix.span().end() <= argument.end()) {
                    flows = true;
                }
            }
            if (flows) {
                outer.push(fix);
            } else if (fix.suffixed() == null) {
                this.reporter().report(fix.message(), fix.span());
            }
        }
    }

    analyzeCallOf(CallExpressionNode node, Type? expected) -> Type {
        switch (node.callee()) {
            is MemberExpressionNode member -> {
                return this.analyzeMemberCall(node, member, expected);
            },
            is SafeMemberExpressionNode member -> {
                return this.analyzeSafeMemberCall(node, member);
            },
            is SuperExpressionNode chained -> {
                return this.analyzeSuperCall(node, chained);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeFunctionCall(node, identifier);
            },
            default -> {
                Type calleeType = this.analyzeExpression(node.callee());
                if (convert.coreOf(calleeType) is FunctionType) {
                    return this.analyzeFunctionValueCall(node, calleeType, "",
                        node.callee().span());
                }
                if (!(calleeType is ErrorType)) {
                    this.reporter().report("{wording.sideNamed(node.callee(), "This value")} has type "
                        + "'{this.names().of(calleeType)}', which is not a function type, so it cannot "
                        + "be called.", node.span());
                }
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
        }
    }

    // A call on a function value: ordinary call syntax on the value itself. A function type has
    // no parameter names, so the arguments are positional and the call takes exactly as many as
    // the type declares.
    analyzeFunctionValueCall(CallExpressionNode node, Type calleeType, string calleeName,
                                     Span calleeSpan) -> Type {
        string subject = "This function value";
        if (calleeName.length > 0) {
            subject = "'{calleeName}'";
        }
        let typeArguments = node.typeArguments();
        if (typeArguments != null) {
            this.reporter().report("A function value takes no type arguments; its type "
                + "'{this.names().of(calleeType)}' is already fixed. Remove the '<...>' list.",
                typeArguments.span());
        }
        if (calleeType is OptionalType) {
            this.reporter().report(nullguidance.maybeNullRefusal(this, "{subject} has type "
                + "'{this.names().of(calleeType)}', which", node.callee(), calleeType), calleeSpan);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        if (!(calleeType is FunctionType)) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        Type[] parameters = calleeType.parameterTypes();
        let arguments = node.arguments();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            string[] unnamed = [];
            this.reporter().report(calls.countRefusal("{subject} has type '{this.names().of(calleeType)}', "
                + "so it takes", parameters.length, parameters.length, count, "argument", unnamed),
                node.span());
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.reporter().report("A function type has no parameter names, so a function "
                        + "value takes its arguments by position. Write the values in order, "
                        + "without '{named.name().text()}:'.", named.span());
                    this.analyzeExpression(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter().report("'out' can only be used when calling an external "
                        + "function. Remove 'out' from the argument.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i];
                        LiteralOrigin? origin = null;
                        if (valuejoins.mayAdaptLiteral(value)) {
                            origin = new LiteralOrigin(OriginKind.Parameter, "", calleeName, parameterType);
                        }
                        Type actual = this.analyzeExpressionAdapt(value, parameterType, origin);
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter().report(argumentMismatch("{i + 1}",
                                this.functionValueName(calleeName), "", parameterType, actual, this.names())
                                + "{nullguidance.valueAssignabilityHint(this, parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return calleeType.returnType();
    }

    analyzeFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier)
            -> Type {
        string name = identifier.name().text();
        let primitive = types.primitiveNamed(this.store(), name);
        if (primitive != null) {
            this.reportTypeAsCall(name, primitive, identifier.span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            if (this.isRefusedImport(name)) {
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter().report(this.staticWithoutType(name, ownerName, true), identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            let kept = this.preludeScope().hidden(name, this.modulePath(), this.packagePrefix());
            if (kept != null) {
                this.reporter().report(types.notVisibleMessage("Function", name, kept.visibility(),
                    kept.modulePath(), kept.packagePrefix(), this.packagePrefix()),
                    identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
            this.reporter().report("Undefined function '{name}'. Check the spelling, or import "
                + "the module that declares it.", identifier.span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        switch (resolution) {
            is FunctionName functions -> {
                let offered = functions.fromPrelude;
                if (offered != null && offered.isAmbiguous()) {
                    this.reporter().report(prelude.ambiguousMessage(name, offered.modulePaths()),
                        identifier.span());
                    this.analyzeArgumentsOnly(node.arguments());
                    return this.store().errorType();
                }
                return this.dispatchFunctionCall(node, identifier, name, functions.entries);
            },
            is TypeName named -> {
                if (types.isStructLike(named.target())) {
                    return this.analyzeStructConstructorCall(node, named.target(), name);
                }
                this.reportTypeAsCall(name, named.target(), identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is TypeParameterName held -> {
                this.reportTypeParameterRefusal("'{name}' is a type parameter, not a function.",
                    held.parameter(), identifier.span(), NamePosition.Call);
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is LocalName ignored -> {
                Type calleeType = this.analyzeExpression(identifier);
                if (convert.coreOf(calleeType) is FunctionType) {
                    return this.analyzeFunctionValueCall(node, calleeType, name,
                        identifier.span());
                }
                if (!(calleeType is ErrorType)) {
                    this.reporter().report("'{name}' has type '{this.names().of(calleeType)}', "
                        + "which is not a function type, so it cannot be called.",
                        identifier.span());
                }
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
            is NamespaceName module -> {
                this.reportModuleAsCall(name, module.targetModulePath(), identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            },
        }
    }

    dispatchFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier,
                                 string name, List<FunctionEntry> entries) -> Type {
        let first = entries.get(0);
        if (first.isExternal()) {
            this.result().setCallable(identifier.green(), first.signature());
            return this.analyzeExternalCall(node, first, name);
        }
        if (first.signature().isGeneric()) {
            this.result().setCallable(identifier.green(), first.signature());
            return this.analyzeGenericCall(node, first, name);
        }
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments(), entries.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                candidates.push(new CallCandidate(entries.get(i).signature(), null, true));
            }
            let resolved = calls.resolveCall(candidates, built.shape(), this.reporter(),
                node.span(), name, "Function", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                this.result().setCallable(identifier.green(), chosen.signature());
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        this.result().setCallable(identifier.green(), first.signature());
        return this.checkDirectArguments("Function", name, first.signature(),
            node.arguments(), node.span());
    }

    analyzeMemberCall(CallExpressionNode node, MemberExpressionNode member, Type? expected)
            -> Type {
        let object = member.object();
        string memberName = member.member().text();
        if (object is IdentifierExpressionNode) {
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                let handled = this.analyzeNamespaceFunctionCall(node, member,
                    resolution.targetModulePath(), memberName);
                if (handled != null) {
                    return handled;
                }
            }
        }
        let staticHead = staticmembers.resolveStaticHead(this, object);
        if (staticHead != null) {
            return staticmembers.analyzeStaticCall(this, node, member, staticHead, expected);
        }
        let intercepted = this.interceptBuiltinCall(node, object, memberName);
        if (intercepted != null) {
            return intercepted;
        }
        Type memberType = memberaccess.analyzeMemberValue(this, member, MemberPosition.Covered);
        this.result().setType(member.green(), memberType);
        let method = this.result().methodOf(member.green());
        if (method == null) {
            if (convert.coreOf(memberType) is FunctionType) {
                return this.analyzeFunctionValueCall(node, memberType, memberName,
                    member.member().span());
            }
            this.reportUncallableMember(member.green(), member.member().span(), memberName,
                memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(), memberName,
            object, method, false);
    }

    // The member resolved to a value rather than a method: an enum member or a field. The value
    // path reported nothing, because reading the member is fine; only calling it is not.
    reportUncallableMember(GreenNode member, Span span, string name, Type memberType) {
        if (memberType is ErrorType) {
            return;
        }
        if (this.result().memberAccessDeniedAt(member)) {
            return;
        }
        if (memberType is EnumType && this.result().enumConstantOf(member) != null) {
            this.reporter().report("'{name}' is a member of enum '{this.names().nameOf(memberType)}', not a "
                + "method. Remove the parentheses, as in '{this.names().nameOf(memberType)}.{name}'.", span);
            return;
        }
        this.reporter().report("'{name}' is a field of type '{this.names().of(memberType)}', not "
            + "a method. Read it without parentheses.", span);
    }

    analyzeSafeMemberCall(CallExpressionNode node, SafeMemberExpressionNode member)
            -> Type {
        let object = member.object();
        if (object is IdentifierExpressionNode) {
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                this.reporter().report("'{object.name().text()}' is a module name, which is never null, so "
                    + "'?.' cannot follow it. Replace '?.' with '.'.", node.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store().errorType();
            }
        }
        Type memberType = memberaccess.analyzeSafeMemberValue(this, member, MemberPosition.Covered);
        this.result().setType(member.green(), memberType);
        let method = this.result().methodOf(member.green());
        if (method == null) {
            this.reportUncallableMember(member.green(), member.member().span(),
                member.member().text(), memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(),
            member.member().text(), object, method, true);
    }

    // Resolves the method a receiver's call picks: overloads and named arguments go through
    // full resolution; the single-candidate path checks directly. A safe call wraps a
    // non-void result optional.
    finishMethodCall(CallExpressionNode node, GreenNode memberGreen, Span memberSpan,
                             string name, Expression object, Method primary, bool isSafe)
            -> Type {
        Type receiverCore = this.store().errorType();
        let objectType = this.result().typeOf(object.green());
        if (objectType != null) {
            Type receiverType = objectType;
            if (isSafe && receiverType is OptionalType) {
                receiverType = receiverType.inner();
            }
            receiverCore = memberaccess.memberReceiverCore(this, receiverType, name);
        }
        let allCandidates = memberaccess.methodCandidates(receiverCore, name);
        let candidates = memberaccess.existingOnly(this, allCandidates);
        let arguments = node.arguments();
        if (candidates.length() < allCandidates.length()
                && memberaccess.reportUnmetConstraintCall(this, allCandidates, candidates, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (candidates.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, candidates.length() == 1);
            let callCandidates = new List<CallCandidate>();
            for (long i = 0; i < candidates.length(); i++) {
                let candidate = candidates.get(i);
                callCandidates.push(new CallCandidate(candidate.signature(), candidate,
                    memberaccess.isAccessAllowed(this, candidate.visibility(), candidate.definingType())));
            }
            if (callCandidates.length() == 0) {
                callCandidates.push(new CallCandidate(primary.signature(), primary, true));
            }
            let resolved = calls.resolveCall(callCandidates, built.shape(), this.reporter(),
                node.span(), name, "Method", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store().errorType();
            }
            let chosenMethod = chosen.method();
            if (chosenMethod != null) {
                if (!chosen.isAccessible()) {
                    memberaccess.checkMemberAccess(this, name, chosenMethod.visibility(),
                        chosenMethod.definingType(), memberSpan);
                }
                this.result().setMethod(memberGreen, chosenMethod);
            }
            Type returned = this.checkResolvedArguments(built, resolved, node.green());
            if (isSafe) {
                return this.wrapSafeResult(returned);
            }
            return returned;
        }
        Type returned = this.checkDirectArguments("Method", name, primary.signature(),
            arguments, node.span());
        if (isSafe) {
            return this.wrapSafeResult(returned);
        }
        return returned;
    }

    // A void safe call is a statement: it runs only when the receiver is non-null and
    // produces no value.
    wrapSafeResult(Type returned) -> Type {
        if (returned is ErrorType || types.isVoidType(returned)) {
            return returned;
        }
        return this.safeResultOf(returned);
    }

    // The type '?.' and '?[' produce. Both produce 'null' when the receiver is absent, and a
    // value that is already nullable carries that result in the level it has: its own null means
    // "nothing here" just as well, so the operator adds no second level and a chain through a
    // nullable member keeps working. This is only about the level these operators add; a value
    // that is doubly nullable is still rejected by the operators themselves.
    public safeResultOf(Type value) -> Type {
        if (value is OptionalType) {
            return value;
        }
        return this.store().optionalOf(value);
    }

    // A namespace-qualified free-function call, or null when the member is not a function of
    // the target module (the member then resolves as a type reference).
    analyzeNamespaceFunctionCall(CallExpressionNode node, MemberExpressionNode member,
                                         string targetPath, string memberName) -> Type? {
        let target = this.contextsByPath().get(targetPath);
        if (target == null) {
            return null;
        }
        let entries = target.functions().entriesNamed(memberName);
        if (entries == null || entries.length() == 0) {
            return null;
        }
        string targetPackagePrefix = target.module().packagePrefix();
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments(), entries.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                let entry = entries.get(i);
                candidates.push(new CallCandidate(entry.signature(), null,
                    types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                        this.modulePath(), this.packagePrefix())));
            }
            let resolved = calls.resolveCall(candidates, built.shape(), this.reporter(),
                node.span(), memberName, "Function", this.names());
            if (resolved.failed()) {
                return this.store().errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store().errorType();
            }
            this.result().setCallable(member.green(), chosen.signature());
            if (!chosen.isAccessible()) {
                Visibility chosenVisibility = Visibility.Private;
                for (long i = 0; i < entries.length(); i++) {
                    if (entries.get(i).signature() == chosen.signature()) {
                        chosenVisibility = entries.get(i).visibility();
                    }
                }
                this.reporter().report(types.notVisibleMessage("Function", memberName,
                    chosenVisibility, targetPath, targetPackagePrefix, this.packagePrefix()),
                    member.member().span());
                return this.store().errorType();
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        let entry = entries.get(0);
        if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                this.modulePath(), this.packagePrefix())) {
            this.reporter().report(types.notVisibleMessage("Function", memberName,
                entry.visibility(), targetPath, targetPackagePrefix, this.packagePrefix()),
                member.member().span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        this.result().setCallable(member.green(), entry.signature());
        if (entry.isExternal()) {
            return this.analyzeExternalCall(node, entry, memberName);
        }
        if (targetPath == "std.ffi" && memberName == "fromCString") {
            return this.checkFromCStringCall(node.arguments(), node.span());
        }
        if (entry.signature().isGeneric()) {
            return this.analyzeGenericCall(node, entry, memberName);
        }
        return this.checkDirectArguments("Function", memberName, entry.signature(),
            node.arguments(), node.span());
    }

    // std.ffi.fromCString accepts a value of any external type - there is no common supertype to
    // write in its signature, hence the intercepted type parameter - and returns a string?. A null
    // handle yields a null string, so an unset value stays distinct from an empty one. Because the
    // call is checked here it is never routed through generic instantiation.
    checkFromCStringCall(ArgumentListNode arguments, Span callSpan) -> Type {
        Type result = this.store().optionalOf(this.store().stringType());
        long count = arguments.argumentsCount();
        if (count != 1) {
            this.reporter().report(fromCStringCountRefusal(count), callSpan);
            this.analyzeArgumentsOnly(arguments);
            return result;
        }
        switch (arguments.arguments(0)) {
            is OutArgumentNode outArgument -> {
                this.reporter().report("'out' can only be used when calling an external "
                    + "function. Remove 'out' from the argument.", outArgument.span());
            },
            is Expression value -> {
                Type actual = this.analyzeExpression(value);
                Type base = actual;
                if (base is OptionalType) {
                    base = base.inner();
                }
                if (!(actual is ErrorType) && !(base is ExternalType)) {
                    this.reporter().report("'fromCString' takes a value of an external type, but "
                        + "{wording.sideNamed(value, "this value")} has type '{this.names().of(actual)}'. "
                        + "Pass it the value a C function returned.", value.span());
                }
            },
            default -> { },
        }
        return result;
    }

    analyzeSuperCall(CallExpressionNode node, SuperExpressionNode chained) -> Type {
        this.analyzeExpression(chained);
        this.frame().noteSuperCall();
        Type voidType = this.store().primitive(PrimitiveKind.Void);
        if (!this.frame().inConstructor() && this.frame().thisType() != null) {
            this.reporter().report("'super(...)' can only be called from a constructor.",
                node.span());
        }
        Type? base = null;
        let receiver = this.frame().thisType();
        if (receiver != null) {
            base = hierarchy.baseOf(receiver);
        }
        if (base == null) {
            this.analyzeArgumentsOnly(node.arguments());
            return voidType;
        }
        string baseName = this.names().of(base);
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null) {
            baseName = baseAuthority.name();
        }
        let allConstructors = typemembers.constructorsOf(base);
        let constructors = memberaccess.existingOnly(this, allConstructors);
        let arguments = node.arguments();
        if (constructors.length() < allConstructors.length()
                && memberaccess.reportUnmetConstraintCall(this, allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() == 0) {
            if (arguments.argumentsCount() > 0) {
                this.reporter().report("Base class '{baseName}' declares no constructor, so 'super(...)' "
                    + "takes no arguments. Write 'super()', or remove the call.", node.span());
            } else if (this.frame().inConstructor() && receiver != null && allConstructors.length() == 0) {
                this.checkImplicitBaseChain(receiver, null, false, node.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments, constructors.length() == 1);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), memberaccess.isAccessAllowed(this, constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape(), this.reporter(),
                node.span(), baseName, "Base constructor", this.names());
            if (resolved.failed()) {
                return voidType;
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                let chosenMethod = chosen.method();
                if (chosenMethod != null) {
                    if (!chosen.isAccessible()) {
                        memberaccess.checkConstructorAccess(this, base, chosenMethod, node.span(), true);
                    }
                    this.result().setMethod(chained.green(), chosenMethod);
                }
                this.checkResolvedArguments(built, resolved, node.green());
            }
            return voidType;
        }
        let baseConstructor = constructors.get(0);
        memberaccess.checkConstructorAccess(this, base, baseConstructor, node.span(), true);
        this.result().setMethod(chained.green(), baseConstructor);
        this.checkDirectArguments("Base constructor", baseName, baseConstructor.signature(),
            arguments, node.span());
        return voidType;
    }

    // The built-in members of strings, arrays, and primitives, intercepted before general
    // member resolution; a record declaring its own member of the same name falls through
    // (null result) to normal resolution, and so does a primitive whose binding declares one.
    interceptBuiltinCall(CallExpressionNode node, Expression object, string name)
            -> Type? {
        if (name != "toString" && name != "slice" && name != "hash") {
            return null;
        }
        Type objectType = this.analyzeExpression(object);
        if (objectType is ErrorType) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store().errorType();
        }
        Type core = objectType;
        let arguments = node.arguments();
        if (convert.coreOf(core) is FunctionType) {
            this.analyzeArgumentsOnly(arguments);
            return operators.reportFunctionMember(this, name, core, node.span());
        }
        // The standard library's binding handles a call it declares a member for, so the
        // compiler's own member of that name steps aside there.
        if (this.bindingDeclares(core, name, arguments.argumentsCount(), false)) {
            return null;
        }
        // An optional hashes as its payload does while present, whatever its inner type, so only
        // 'hash' reads through the wrapper here.
        if (core is OptionalType) {
            if (name == "slice" && core.inner() is ArrayType) {
                this.reporter().report(nullguidance.maybeNullRefusal(this, "Cannot call 'slice' on "
                    + "'{this.names().of(core)}' because it", object, core), node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            if (name != "hash") {
                return null;
            }
        }
        if (name == "toString") {
            if (convert.isIntegerType(core) || convert.isBoolType(core) || core is StringType
                    || convert.isEnumLike(core) || isTextualFloat(core)) {
                this.checkNoArguments(node, "toString");
                return this.store().stringType();
            }
            if (types.isDecimalType(core)) {
                this.reporter().report("Internal: 'toString' on 'decimal'.", node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            // A struct whose own toString cannot take this call serializes to its JSON form; one
            // whose toString matches it falls through to normal resolution.
            if (types.isStructLike(core) && !this.declaresToStringFor(core, arguments.argumentsCount())) {
                this.checkNoArguments(node, "toString");
                if (convert.containsTypeParam(core)) {
                    this.recordObligation(new InterpolationObligation(core, node.span()));
                } else {
                    let issue = capabilities.structJsonabilityIssue(core, this.names());
                    if (issue != null) {
                        this.reporter().report(issue, node.span());
                    }
                }
                return this.store().stringType();
            }
            // The call is legal exactly where interpolating the array is.
            if (core is ArrayType) {
                this.checkNoArguments(node, "toString");
                if (convert.containsTypeParam(core)) {
                    this.recordObligation(new InterpolationObligation(core, node.span()));
                } else {
                    let issue = capabilities.interpolationIssue(core, this.names());
                    if (issue != null) {
                        this.reporter().report(issue, node.span());
                    }
                }
                return this.store().stringType();
            }
            // A class or interface value whose chain has no toString for this call produces
            // its runtime type's text form; a chain whose toString matches it falls through to
            // normal resolution.
            if (types.isClassLike(core) && !this.declaresToStringFor(core, arguments.argumentsCount())) {
                this.checkNoArguments(node, "toString");
                return this.store().stringType();
            }
            // A bare type parameter defers the judgment to each instantiation, exactly like a
            // hole; a bound that declares toString resolves the call against the contract.
            if (core is TypeParamType) {
                bool declaresToString = false;
                for (let bound in memberaccess.effectiveBoundsOf(this, core)) {
                    if (anyAcceptsArgumentCount(memberaccess.methodCandidates(bound, "toString"),
                            arguments.argumentsCount())) {
                        declaresToString = true;
                    }
                }
                if (declaresToString) {
                    return null;
                }
                this.checkNoArguments(node, "toString");
                this.recordObligation(new InterpolationObligation(core, node.span()));
                return this.store().stringType();
            }
            return null;
        }
        if (name == "slice") {
            if (core is ArrayType) {
                this.checkRangeArguments(node, "slice");
                return core;
            }
            return null;
        }
        if (types.isVoidType(core)) {
            this.reporter().report("{wording.sideNamed(object, "This call")} returns no value, so there is "
                + "nothing to call 'hash' on.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        if (!(core is OptionalType) && this.declaresHash(core)) {
            return null;
        }
        this.checkNoArguments(node, "hash");
        this.checkHashable(core, node.span());
        return this.store().primitive(PrimitiveKind.Long);
    }

    // Whether a 'toString' the receiver's chain declares takes a call of this argument count.
    // Only a 'toString' taking no parameters is a type's text form, so a call with no arguments
    // reaches the built-in form past one that takes parameters, and a call carrying arguments
    // reaches that method.
    declaresToStringFor(Type receiver, long argumentCount) -> bool {
        return anyAcceptsArgumentCount(memberaccess.availableMethods(this, receiver, "toString"),
            argumentCount);
    }

    // Whether the standard library's binding declares a member for a call of this name and argument count
    // itself. A declaration whose parameter list matches the compiler's own member replaces it,
    // and one that differs is an overload the compiler never provided, so both read the same way
    // here: what the binding declares wins, and what it does not the compiler still provides.
    bindingDeclares(Type receiver, string name, long argumentCount, bool isStatic) -> bool {
        let binding = types.bindingOf(receiver);
        if (binding == null) {
            return false;
        }
        let declared = isStatic ? binding.staticMethods() : binding.methods();
        for (long i = 0; i < declared.length(); i++) {
            let signature = declared.get(i).signature();
            if (signature.name() == name && calls.acceptsArgumentCount(signature, argumentCount)) {
                return true;
            }
        }
        return false;
    }

    // Whether a written 'hash' exists on this receiver: a bound of a type parameter, or a member
    // of a record; anything else gets the synthesized content hash.
    declaresHash(Type core) -> bool {
        if (core is TypeParamType) {
            for (let bound in memberaccess.effectiveBoundsOf(this, core)) {
                if (memberaccess.methodCandidates(bound, "hash").length() > 0) {
                    return true;
                }
            }
            return false;
        }
        return memberaccess.isRecordLike(core)
            && memberaccess.availableMethods(this, core, "hash").length() > 0;
    }

    // The synthesized content hash needs every leaf the receiver folds to have a hash. A receiver
    // mentioning a type parameter is judged per instantiation.
    checkHashable(Type receiver, Span span) {
        if (convert.containsTypeParam(receiver)) {
            this.recordObligation(new HashObligation(receiver, span));
            return;
        }
        let issue = capabilities.hashabilityIssue(receiver, this.names());
        if (issue != null) {
            this.reporter().report(issue, span);
        }
    }

    checkNoArguments(CallExpressionNode node, string name) {
        if (node.arguments().argumentsCount() > 0) {
            string[] unnamed = [];
            this.reporter().report(calls.countRefusal("'{name}' takes", 0, 0,
                node.arguments().argumentsCount(), "argument", unnamed), node.span());
            this.analyzeArgumentsOnly(node.arguments());
        }
    }

    // Array slicing takes a start and an end index.
    checkRangeArguments(CallExpressionNode node, string name) {
        let arguments = node.arguments();
        if (arguments.argumentsCount() != 2) {
            this.reporter().report(calls.countRefusal("'{name}' takes", 2, 2, arguments.argumentsCount(),
                "argument", ["start", "end"]), node.span());
            this.analyzeArgumentsOnly(arguments);
            return;
        }
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type actual = this.analyzeExpression(argument);
                if (!(actual is ErrorType) && !convert.isIntegerType(actual)) {
                    this.reporter().report("'{name}' takes integer indexes, but "
                        + "{wording.sideNamed(argument, "this index")} has type '{this.names().of(actual)}'.",
                        argument.span());
                }
            }
        }
    }

    analyzeGenericCall(CallExpressionNode node, FunctionEntry entry, string name) -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        Parameter[] declared = signature.parameters();
        bool genericResult = convert.containsTypeParam(signature.returnType());
        for (long i = 0; i < arguments.argumentsCount() && i < declared.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression && genericResult && convert.containsTypeParam(declared[i].type())) {
                this.targets().flowingArguments().push(argument.span());
            }
        }
        if (usesNamedArguments(arguments)) {
            this.reporter().report("'{name}' is generic, and a call to a generic function cannot name its "
                + "arguments. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
                node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store().errorType();
        }
        let owner = signature.declaration();
        if (owner == null) {
            return signature.returnType();
        }
        let typeParameters = signature.typeParameters();
        long arity = typeParameters.length;
        let typeArguments = new List<Type?>();
        for (long i = 0; i < arity; i++) {
            typeArguments.push(null);
        }
        let explicitList = node.typeArguments();
        if (explicitList != null) {
            long given = explicitList.argumentsCount();
            if (given != arity) {
                let names = new List<string>();
                for (let parameter in typeParameters) {
                    names.push(parameter.name());
                }
                this.reporter().report(calls.countRefusal("Generic function '{name}' takes", arity, arity,
                    given, "type argument", names.toArray()), node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store().errorType();
            }
            for (long i = 0; i < arity; i++) {
                typeArguments.set(i, this.resolver().resolveType(explicitList.arguments(i)));
            }
        }

        // A value with no type of its own, a lambda or an aggregate literal, waits for the
        // parameter it fills, which is known once the type arguments are resolved. It offers
        // nothing to infer them from either.
        let argumentTypes = new List<Type>();
        bool refusedArgument = false;
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression && !waitsForParameter(argument, explicitList != null)) {
                Type analyzed = this.analyzeExpression(argument);
                refusedArgument = refusedArgument || analyzed is ErrorType;
                argumentTypes.push(analyzed);
            } else {
                argumentTypes.push(this.store().errorType());
            }
        }

        Parameter[] parameters = signature.parameters();
        let inference = new TypeArgumentInference(this.store(), owner, arity);
        if (explicitList == null) {
            for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
                inference.unifyArgument(i, parameters[i].type(), argumentTypes.get(i));
            }
            for (long i = 0; i < arity; i++) {
                typeArguments.set(i, inference.binding(i));
            }
        }

        let resolved = new List<Type>();
        for (long i = 0; i < arity; i++) {
            let argument = typeArguments.get(i);
            if (argument == null && refusedArgument) {
                return this.store().errorType();
            }
            if (argument == null) {
                let written = new List<string>();
                for (long j = 0; j < arity; j++) {
                    let known = typeArguments.get(j);
                    if (known != null && this.names().canSpell(known)) {
                        written.push(this.names().of(known));
                    } else {
                        written.push(staticmembers.exampleTypeArgument(node.arguments()));
                    }
                }
                string listed = "";
                for (long j = 0; j < written.length(); j++) {
                    if (j > 0) {
                        listed = listed + ", ";
                    }
                    listed = listed + written.get(j);
                }
                string write = "Write it";
                if (arity > 1) {
                    write = "Write its type arguments";
                }
                this.reporter().report("'{name}' is generic, and this call does not show what its type "
                    + "argument '{typeParameters[i].name()}' is. {write}, as in "
                    + "'{name}<{listed}>{argumentsSpelling(node.arguments())}'.", node.span());
                return this.store().errorType();
            }
            resolved.push(argument);
        }
        Type[] resolvedArguments = resolved.toArray();

        bool bounded = true;
        for (long i = 0; i < arity; i++) {
            Span at = node.span();
            if (explicitList != null && i < explicitList.argumentsCount()) {
                at = explicitList.arguments(i).span();
            }
            if (!this.resolver().checkArgumentBounds(typeParameters[i], resolvedArguments, at)) {
                bounded = false;
            }
        }

        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter().report(calls.arityRefusal("Function '{name}'", signature, count), node.span());
            bounded = false;
        }
        for (long i = 0; i < count && i < parameters.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type parameterType = this.store().substitute(parameters[i].type(), owner,
                    resolvedArguments);
                Type actual = argumentTypes.get(i);
                let origin = literalfixes.argumentOrigin(this, argument, signature, i, parameterType);
                if (waitsForParameter(argument, explicitList != null)) {
                    actual = this.analyzeExpressionAdapt(argument, parameterType, origin);
                } else {
                    literaltyping.adaptIntegerLiteral(this, argument, parameterType, origin);
                    literaltyping.adaptFloatLiteral(this, argument, parameterType, origin);
                    let updated = this.result().typeOf(argument.green());
                    if (updated != null) {
                        actual = updated;
                    }
                }
                if (!(parameterType is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameterType, actual)) {
                    string provenance = "";
                    if (explicitList == null) {
                        provenance = inference.provenance(parameters[i].type(), name, "(...)", this.names());
                    }
                    string hint = nullguidance.valueAssignabilityHint(this, parameterType, actual, argument);
                    this.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameters[i].name(),
                        parameterType, actual, this.names()) + "{hint}{provenance}", argument.span());
                }
            }
        }

        if (bounded) {
            this.result().setCallTypeArguments(node.green(), resolvedArguments);
            this.recordGenericCall(signature, resolvedArguments, node.span());
        }
        return this.store().substitute(signature.returnType(), owner, resolvedArguments);
    }

    // An external call: exact arity, no named arguments, and 'out' parameters take an
    // initialized non-constant local of exactly the parameter's type.
    analyzeExternalCall(CallExpressionNode node, FunctionEntry entry, string name)
            -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        if (usesNamedArguments(arguments)) {
            this.reporter().report("External function '{name}' takes its arguments by position, so a call "
                + "cannot name them. Pass them in order, as in '{name}{positionalSpelling(arguments)}'.",
                node.span());
            this.analyzeArgumentsOnly(arguments);
            return signature.returnType();
        }
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            this.reporter().report(calls.arityRefusal("External function '{name}'", signature, count),
                node.span());
        }
        for (long i = 0; i < count; i++) {
            let argument = arguments.arguments(i);
            if (i >= parameters.length) {
                this.analyzeExtraExternalArgument(argument);
                continue;
            }
            let parameter = parameters[i];
            if (parameter.isOut()) {
                if (argument is OutArgumentNode) {
                    this.checkOutArgument(argument, parameter, name, i);
                } else if (argument is Expression) {
                    string example = "out result";
                    if (parameter.name().length > 0) {
                        example = "out {parameter.name()}";
                    }
                    string fix = "Declare a local variable and write 'out' before it, as in '{example}'.";
                    if (wording.unwrapParentheses(argument) is IdentifierExpressionNode) {
                        fix = "Write 'out {wording.oneLineSpelling(wording.unwrapParentheses(argument))}'.";
                    }
                    this.reporter().report("{parameterSubject(parameter, i)} of '{name}' is an 'out' "
                        + "parameter, so it needs a variable to store into. {fix}", argument.span());
                    this.analyzeExpression(argument);
                }
                continue;
            }
            if (argument is OutArgumentNode) {
                this.reporter().report("{parameterSubject(parameter, i)} of '{name}' is not an 'out' "
                    + "parameter. Remove 'out' from '{wording.greenSpelling(argument.green())}'.",
                    argument.span());
                continue;
            }
            if (argument is Expression) {
                Type actual = this.analyzeExpressionAdapt(argument, parameter.type(),
                    literalfixes.argumentOrigin(this, argument, signature, i, parameter.type()));
                if (!(parameter.type() is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameter.type(), actual)) {
                    this.reporter().report(argumentMismatch("{i + 1}", "'{name}'", parameter.name(),
                        parameter.type(), actual, this.names())
                        + "{nullguidance.valueAssignabilityHint(this, parameter.type(), actual, argument)}",
                        argument.span());
                }
            }
        }
        return signature.returnType();
    }

    checkOutArgument(OutArgumentNode argument, Parameter parameter, string name, long index) {
        string outName = argument.name().text();
        let binding = this.lookupBinding(outName);
        if (binding == null) {
            string shownType = this.names().of(parameter.type());
            string declare = "Declare it first as a local variable of type '{shownType}'.";
            if (convert.isNumericType(parameter.type())) {
                declare = "Declare it first, as in '{shownType} {outName} = 0;'.";
            }
            this.reporter().report("'{outName}' in 'out {outName}' is not a local variable or a parameter. "
                + declare, argument.span());
            return;
        }
        if (binding.isConst()) {
            this.reporter().report(assignments.constantRefusal(this, "Cannot pass '{outName}' as 'out'",
                binding), argument.span());
        }
        this.result().setBinding(argument.green(), binding);
        if (binding.type() != parameter.type()) {
            string wanted = this.names().of(parameter.type());
            this.reporter().report("{parameterSubject(parameter, index)} of '{name}' is 'out {wanted}', but "
                + "'{outName}' has type '{this.names().of(binding.type())}'. Pass a variable of "
                + "type '{wanted}'.", argument.span());
            return;
        }
        // 'out' lets the callee write the caller's variable directly, so it drops even the
        // binding's own narrowing.
        this.narrowingState.clearForRoot(binding);
    }

    analyzeExtraExternalArgument(Argument argument) {
        switch (argument) {
            is OutArgumentNode outArgument -> {
                let binding = this.lookupBinding(outArgument.name().text());
                if (binding != null) {
                    this.result().setBinding(outArgument.green(), binding);
                }
            },
            is Expression value -> {
                this.analyzeExpression(value);
            },
            default -> { },
        }
    }

    // ---- 'new' expressions ----

    // analyzeCall for a 'new' expression. The arguments of a generic type's constructor reach the
    // object it builds.
    analyzeNew(NewExpressionNode node) -> Type {
        let outerDeferred = this.targets().deferredFixes();
        let held = new List<DeferredLiteralFix>();
        this.targets().setDeferredFixes(held);
        bool outerAwaiting = this.targets().awaitingParameter();
        this.targets().setAwaitingParameter(false);
        let outerChosen = this.targets().chosenParameters();
        this.targets().setChosenParameters(new List<ChosenParameter>());
        Type created = this.analyzeNewOf(node);
        this.settleParameters(held);
        this.targets().setAwaitingParameter(outerAwaiting);
        this.targets().setChosenParameters(outerChosen);
        this.targets().setDeferredFixes(outerDeferred);
        bool generic = convert.coreOf(created) is InstantiationType;
        this.settleArguments(held, outerDeferred, new List<Span>(), generic);
        return created;
    }

    analyzeNewOf(NewExpressionNode node) -> Type {
        let created = node.createdType();
        if (node.dimensionsCount() > 0) {
            return this.analyzeArrayNew(node, created);
        }
        if (created is OptionalTypeNode) {
            this.reporter().report("'new' always produces a value, so its type cannot be nullable. Remove "
                + "the '?'.", created.span());
        }
        Type t = this.resolver().resolveType(created);
        if (t is OptionalType) {
            t = t.inner();
        }
        let arguments = node.arguments();
        if (t is ErrorType) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store().errorType();
        }
        string shownName = writtenTypeName(created, t, this.names());
        if (!types.isClassLike(t)) {
            if (types.isStructLike(t)) {
                this.reportNewOnStruct(node, t, shownName);
            } else {
                this.reporter().report("'new' creates an object of a class, and '{this.names().of(t)}' is "
                    + "not a class.", node.span());
            }
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store().errorType();
        }
        let authority = types.authorityOf(t);
        // A type nothing can instantiate has already been reported as such, so the constructor's
        // own visibility is not checked: widening it would not make the type instantiable.
        bool uninstantiable = false;
        if (authority is InterfaceType) {
            this.reporter().report("Cannot create an instance of interface '{shownName}'. Create "
                + "one of a class that implements it.", node.span());
            uninstantiable = true;
        } else if (authority is ClassType && authority.isAbstract()) {
            this.reporter().report("Cannot create an instance of abstract class '{shownName}'. "
                + "Create one of a subclass that is not abstract.", node.span());
            uninstantiable = true;
        }
        let allConstructors = typemembers.constructorsOf(t);
        let constructors = memberaccess.existingOnly(this, allConstructors);
        if (constructors.length() < allConstructors.length()
                && memberaccess.reportUnmetConstraintCall(this, allConstructors, constructors, arguments,
                    node.span())) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return t;
        }
        if (allConstructors.length() == 0) {
            let blocked = this.excludedImplicitBaseConstructor(t);
            if (blocked != null) {
                string clause = this.excludedConstructorClause(blocked, this.currentMemberWord());
                if (clause.length > 0) {
                    string owner = this.names().of(blocked.definingType());
                    string needs = "so it needs the zero-argument constructor of its base class '{owner}'";
                    let direct = hierarchy.baseOf(t);
                    if (direct != null && direct != blocked.definingType()) {
                        needs = "and neither does its base class '{this.names().of(direct)}', so it needs "
                            + "the zero-argument constructor of '{owner}'";
                    }
                    this.reporter().report("Cannot construct '{shownName}'. It declares no constructor, "
                        + "{needs}. " + clause, node.span());
                    if (arguments != null) {
                        this.analyzeArgumentsOnly(arguments);
                    }
                    return t;
                }
            }
        }
        long argumentCount = 0;
        if (arguments != null) {
            argumentCount = arguments.argumentsCount();
        }
        bool named = arguments != null && usesNamedArguments(arguments);
        if (constructors.length() > 1 || (constructors.length() > 0 && named)) {
            let built = this.buildShapeOrEmpty(arguments);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), memberaccess.isAccessAllowed(this, constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape(), this.reporter(),
                node.span(), shownName, "Constructor", this.names());
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible() && !uninstantiable) {
                            memberaccess.checkConstructorAccess(this, t, chosenMethod, node.span());
                        }
                        this.result().setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
        } else if (constructors.length() > 0) {
            let classConstructor = constructors.get(0);
            if (!uninstantiable) {
                memberaccess.checkConstructorAccess(this, t, classConstructor, node.span());
            }
            this.result().setMethod(node.green(), classConstructor);
            if (arguments != null) {
                this.checkDirectArguments("Constructor", shownName,
                    classConstructor.signature(), arguments, node.span(), this.names().of(t));
            }
        } else if (argumentCount > 0) {
            this.reporter().report("Class '{shownName}' declares no constructor, so 'new {shownName}(...)' "
                + "takes no arguments. Write 'new {shownName}()'.", node.span());
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
        }
        return t;
    }

    buildShapeOrEmpty(ArgumentListNode? arguments) -> BuiltShape {
        if (arguments != null) {
            return this.buildCallShape(arguments, false);
        }
        return new BuiltShape(new CallShape(), new List<Expression?>());
    }

    // 'new T[n]': every allocated slot starts as T's zero value, so T must be defaultable -
    // unless a fill loop right after the declaration proves every slot is written first, or
    // the trailing dimensions are unsized and the slots hold nullable inner arrays.
    analyzeArrayNew(NewExpressionNode node, TypeNode created) -> Type {
        Type element = this.resolver().resolveType(created);
        let sizes = new List<Expression>();
        long unsized = 0;
        for (long i = 0; i < node.dimensionsCount(); i++) {
            let size = node.dimensions(i).size();
            if (size != null && unsized == 0) {
                sizes.push(size);
            } else {
                unsized++;
            }
        }
        if (element is ErrorType) {
            this.analyzeSizes(sizes);
            return this.store().errorType();
        }
        if (types.isVoidType(element)) {
            this.reporter().report("Cannot create an array of 'void', because 'void' means no value.",
                created.span());
            this.analyzeSizes(sizes);
            return this.store().errorType();
        }
        if (sizes.length() == 0) {
            string shown = this.names().of(element);
            this.reporter().report("'new {shown}[...]' needs at least one size. Write "
                + "'new {shown}[size]' for one row, or 'new {shown}[size][]' for a grid whose "
                + "rows are filled later.", node.span());
            return this.store().arrayOf(element);
        }
        Type slotElement = element;
        if (unsized == 0) {
            // A canonical fill loop assigns every slot whatever the element type turns out to be,
            // so the proof holds for a type parameter as much as for a reference.
            bool singleDimension = sizes.length() == 1;
            bool proven = singleDimension && this.fillProvenNews.contains(node.green());
            string fillName = "items";
            let declared = this.arrayNewNames.get(node.green());
            if (declared != null) {
                fillName = declared;
            }
            if (!proven && !this.validateArrayElement(element, created.span(),
                    singleDimension, fillName)) {
                this.analyzeSizes(sizes);
                return this.store().errorType();
            }
        } else {
            Type innerArray = element;
            for (long i = 0; i < unsized; i++) {
                innerArray = this.store().arrayOf(innerArray);
            }
            slotElement = this.store().optionalOf(innerArray);
        }
        this.analyzeSizes(sizes);
        Type arrayType = slotElement;
        for (long i = 0; i < sizes.length(); i++) {
            arrayType = this.store().arrayOf(arrayType);
        }
        return arrayType;
    }

    analyzeSizes(List<Expression> sizes) {
        for (long i = 0; i < sizes.length(); i++) {
            Type sizeType = this.analyzeExpression(sizes.get(i));
            if (!(sizeType is ErrorType) && !convert.isIntegerType(sizeType)) {
                this.reporter().report("The size of an array must be an integer, but "
                    + "{wording.sideNamed(sizes.get(i), "the size")} has type '{this.names().of(sizeType)}'.",
                    sizes.get(i).span());
            }
        }
    }

    // An element type that mentions a type parameter settles nothing here about whether a freshly
    // allocated slot is a valid value, so the judgment waits for the concrete arguments of every
    // instantiation that occurs. The raw store is the one type where slots holding no value is
    // the point; see @std.collections.rawarray.
    validateArrayElement(Type element, Span span, bool hasFillName, string fillName)
            -> bool {
        if (element is ErrorType) {
            return false;
        }
        if (convert.containsTypeParam(element)) {
            if (!this.inRawStorageAllocator()) {
                this.recordObligation(new ArrayElementObligation(element, span));
            }
            return true;
        }
        let issue = capabilities.arrayElementIssue(element, hasFillName, fillName, this.names());
        if (issue == null) {
            return true;
        }
        this.reporter().report(issue, span);
        return false;
    }

    inRawStorageAllocator() -> bool {
        return this.modulePath() == "std.collections.rawarray" && this.obligationOwnerName == "RawArray";
    }

    // Records single-dimension array-new declaration initializers (for diagnostic wording)
    // and proves the ones immediately followed by their canonical fill loop.
    noteArrayFillLoop(BlockNode block, long index) {
        let statement = block.statements(index);
        if (statement is VariableDeclarationNode) {
            let initializer = statement.initializer();
            if (initializer == null) {
                return;
            }
            let value = initializer.value();
            if (value is NewExpressionNode) {
                if (value.dimensionsCount() != 1 || value.dimensions(0).size() == null) {
                    return;
                }
                string name = statement.name().text();
                if (name.length == 0) {
                    return;
                }
                this.arrayNewNames.set(value.green(), name);
                if (index + 1 >= block.statementsCount()) {
                    return;
                }
                let next = block.statements(index + 1);
                if (next is ForStatementNode && isArrayFillLoop(next, name)) {
                    this.fillProvenNews.add(value.green());
                }
            }
        }
    }

    // ---- Switch arms ----

    // A switch used as a value. The target is the type its arms are checked against, and is null where the
    // surroundings offer none.
    analyzeSwitchExpression(SwitchExpressionNode node, Type? target, LiteralOrigin? origin = null) -> Type {
        let scope = this.targets().beginJoin(node, false);
        Type analyzed = this.analyzeSwitchValues(node, target, origin);
        valuejoins.endJoin(this, node, scope);
        return analyzed;
    }

    analyzeSwitchValues(SwitchExpressionNode node, Type? target, LiteralOrigin? origin) -> Type {
        Type? fixTarget = target;
        LiteralOrigin? fixOrigin = origin;
        if (target == null && this.targets().joinNode() == node.green()) {
            fixTarget = this.targets().joinTarget();
            fixOrigin = this.targets().joinOrigin();
        }
        this.targets().clearStash();
        return this.checkSwitchArms(node.scrutinee(), armsOfExpression(node),
            node.switchKeyword().span(), true, target, fixOrigin, fixTarget);
    }

    // Checks a switch in either form: the scrutinee kind, the labels or 'is' arm targets, arm
    // reachability, exhaustiveness, and the unified value type of the expression form.
    // Exhaustiveness reasons over the unwrapped scrutinee type; a scrutinee whose
    // narrowing-aware type is still nullable additionally needs a 'null' arm or a default.
    checkSwitchArms(Expression scrutinee, List<SwitchArm> arms, Span span,
                            bool requireValue, Type? armTargetType, LiteralOrigin? origin = null,
                            Type? fixTarget = null) -> Type {
        Type scrutineeType = this.analyzeExpression(scrutinee);
        Type inner = convert.bareOf(scrutineeType);
        bool doublyNullable = !(scrutineeType is ErrorType) && inner is OptionalType;
        if (doublyNullable) {
            this.reporter().report(nullguidance.withGuidance(this, "Cannot switch on a value of type "
                + "'{this.names().of(scrutineeType)}': a 'null ->' arm covers one level of null, "
                + "and this value may be null at more than one.", nullguidance.nullGuidance(this, scrutinee,
                scrutineeType, wording.optionalLevels(scrutineeType) - 1)), scrutinee.span());
        }
        bool known = !(scrutineeType is ErrorType) && !doublyNullable;
        bool classScrutinee = known && types.isClassLike(inner);
        bool valueScrutinee = known && (inner is EnumType || convert.isIntegerType(inner)
            || inner is StringType);
        bool typeSwitch = classScrutinee && hasTypeArm(arms);
        if (known) {
            if (classScrutinee && !typeSwitch) {
                this.reporter().report("A switch over a class value needs at least one "
                    + "'is Type ->' arm.", scrutinee.span());
            } else if (!classScrutinee && !valueScrutinee) {
                this.reporter().report("Cannot switch on {wording.sideNamed(scrutinee, "this value")}, "
                    + "because its type '{this.names().of(scrutineeType)}' is not an enum, an integer, a "
                    + "string or a class. Compare it with 'if' and 'else' instead.", scrutinee.span());
            }
        }

        bool hasDefault = false;
        bool nullCovered = false;
        let coveredEnumOrdinals = new Set<long>();
        let seenIntegerLabels = new Set<long>();
        let seenStringLabels = new Set<string>();
        let armTargets = new List<Type>();
        bool everyValueArm = false;
        let valueExpressions = new List<Expression>();
        bool sawValueBlock = false;
        let switchEntry = this.assignment().snapshot();
        let entryLayers = this.narrowingState.snapshotLayers();
        let entryFacts = this.narrowingState.flatten();
        let armFlows = new List<AssignmentFlow>();
        let armNarrowings = new List<Map<NarrowingPath, Type>>();
        let valueArms = new List<SwitchArm>();
        bool deferLiterals = requireValue && armTargetType != null && hasTypedArm(arms);
        let outerDeferred = this.targets().deferredFixes();
        let armDeferred = new List<List<DeferredLiteralFix>>();
        let armValues = new List<Expression?>();
        for (long a = 0; a < arms.length(); a++) {
            long sunk = valueExpressions.length();
            if (requireValue) {
                let held = new List<DeferredLiteralFix>();
                armDeferred.push(held);
                this.targets().setDeferredFixes(held);
            }
            this.assignment().restore(switchEntry);
            this.narrowingState.restoreLayers(entryLayers);
            this.assignment().setUnconditionalPosition(true);
            switch (arms.get(a)) {
                is DefaultArmNode arm -> {
                    if (hasDefault) {
                        this.reporter().report("A switch can have only one 'default' arm.",
                            arm.span());
                    }
                    hasDefault = true;
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                },
                is TypeArmNode arm -> {
                    Type armType = this.resolver().resolveType(arm.target());
                    this.result().setType(arm.target().green(), armType);
                    Type? armTarget = null;
                    if (!classScrutinee) {
                        if (valueScrutinee) {
                            this.reporter().report("An 'is' arm needs a class switch value, but "
                                + "this switch is over '{this.names().of(scrutineeType)}'.",
                                arm.target().span());
                        }
                    } else if (!(armType is ErrorType)) {
                        armTarget = this.checkTypeArmTarget(scrutineeType, inner, armType,
                            arm.target().span(), scrutinee, arm.body(), armTargets.length() == 0);
                        if (armTarget == null && matchesEveryValue(inner, armType)) {
                            everyValueArm = true;
                        }
                    }
                    if (armTarget != null) {
                        this.checkTypeArmReachable(armTarget, armTargets, arm.target().span());
                        armTargets.push(armTarget);
                    }
                    this.enterScope();
                    let bindingToken = arm.binding();
                    if (bindingToken != null) {
                        Type bindingType = this.store().errorType();
                        if (armTarget != null) {
                            bindingType = armTarget;
                        }
                        let binding = new LocalBinding(bindingToken.text(), bindingType,
                            BindingKind.Variable, true, bindingToken.span());
                        this.matchedArmBindings.push(binding);
                        let current = this.scope;
                        if (current != null) {
                            current.define(binding);
                        }
                        this.result().setBinding(arm.green(), binding);
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                    this.leaveScope();
                },
                is ValueArmNode arm -> {
                    bool mixReported = false;
                    for (long i = 0; i < arm.labelsCount(); i++) {
                        let label = arm.labels(i);
                        if (isNullLabel(label)) {
                            this.result().setType(label.green(), this.store().nullType());
                            if (!(scrutineeType is OptionalType)) {
                                string removal = "Remove this arm.";
                                if (arm.labelsCount() > 1) {
                                    removal = "Remove the 'null' label.";
                                }
                                this.reporter().report(
                                    "{wording.sideNamed(scrutinee, "The value of this switch")} "
                                    + "has type '{this.names().of(scrutineeType)}', which can never be null, "
                                    + "so a 'null' arm never runs. {removal}", label.span());
                            } else if (nullCovered) {
                                this.reporter().report("This switch already has a 'null' arm. Remove this "
                                    + "second one.", label.span());
                            } else {
                                nullCovered = true;
                            }
                            continue;
                        }
                        if (typeSwitch) {
                            if (!mixReported) {
                                this.reporter().report("Cannot mix value labels with 'is' arms "
                                    + "in the same switch.", label.span());
                                mixReported = true;
                            }
                            continue;
                        }
                        if (!valueScrutinee) {
                            continue;
                        }
                        if (inner is EnumType) {
                            this.checkEnumLabel(label, inner, coveredEnumOrdinals);
                        } else if (convert.isIntegerType(inner)) {
                            this.checkIntegerLabel(label, inner, seenIntegerLabels);
                        } else {
                            this.checkStringLabel(label, seenStringLabels);
                        }
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings, deferLiterals, origin, fixTarget)) {
                        sawValueBlock = true;
                    }
                },
                // Dropped before the walk begins; the case is here because the arm kinds are
                // checked for exhaustiveness.
                is ErrorSwitchArmNode ignored -> { },
            }
            Expression? armValue = null;
            if (valueExpressions.length() > sunk) {
                valueArms.push(arms.get(a));
                armValue = valueExpressions.get(valueExpressions.length() - 1);
            }
            armValues.push(armValue);
        }
        this.targets().setDeferredFixes(outerDeferred);
        for (long a = 0; a < armDeferred.length(); a++) {
            Expression? neighbour = null;
            Type neighbourType = this.store().errorType();
            for (long b = 0; b < armValues.length(); b++) {
                let value = armValues.get(b);
                bool nullable = value != null && literalfixes.isNullableNumber(this.recordedType(value));
                if (b != a && value != null && neighbour == null && nullable) {
                    neighbour = value;
                    neighbourType = this.recordedType(value);
                }
            }
            literalfixes.settleDeferred(this, armDeferred.get(a), neighbour, neighbourType, "the arm");
        }
        if (armFlows.length() > 0) {
            this.assignment().restore(this.assignment().join(armFlows));
        } else {
            this.assignment().restore(switchEntry);
        }

        this.narrowingState.restoreLayers(entryLayers);
        let survivors = new List<Map<NarrowingPath, Type>>();
        for (long i = 0; i < armFlows.length(); i++) {
            if (!armFlows.get(i).terminated()) {
                survivors.push(armNarrowings.get(i));
            }
        }
        narrowing.applyNarrowingJoin(this, entryFacts, survivors);

        // A switch used as a value with no arm, a type switch whose every arm is refused and one with an
        // arm refused for matching every value get no refusal of a missing arm.
        if (valueScrutinee && !hasDefault && (arms.length() > 0 || !requireValue)) {
            this.checkValueExhaustiveness(inner, coveredEnumOrdinals, span);
        }
        if (typeSwitch && !hasDefault && armTargets.length() > 0 && !everyValueArm) {
            this.checkTypeExhaustiveness(inner, armTargets, span);
        }
        if ((valueScrutinee || typeSwitch) && scrutineeType is OptionalType && !nullCovered && !hasDefault) {
            this.reporter().report("{wording.sideNamed(scrutinee, "The value of this switch")} can be null, "
                + "and no arm of this switch matches null. Add a 'null ->' arm or a 'default' arm.", span);
        }
        if (!requireValue) {
            return this.store().primitive(PrimitiveKind.Void);
        }
        if (sawValueBlock) {
            return this.store().errorType();
        }
        if (valueExpressions.length() == 0) {
            this.reporter().report("A switch used as a value needs at least one arm.", span);
            return this.store().errorType();
        }
        literalfixes.noteSuffixedArms(this, valueExpressions, valueArms, armTargetType ?? fixTarget, origin);
        if (deferLiterals && armTargetType != null
                && !this.adaptLiteralArms(valueExpressions, valueArms, armTargetType, origin)) {
            return this.store().errorType();
        }
        Type unified = this.store().errorType();
        for (long i = 0; i < valueExpressions.length(); i++) {
            let expression = valueExpressions.get(i);
            Type analyzed = this.recordedType(expression);
            if (analyzed is ErrorType) {
                return this.store().errorType();
            }
            if (i == 0) {
                unified = analyzed;
                continue;
            }
            JoinText? fix = null;
            let widening = literalfixes.joinWidening(this, expression, unified, this.targets().joinRoot());
            if (widening != null) {
                LiteralOrigin? fixOrigin = null;
                if (fixTarget != null) {
                    fixOrigin = origin;
                }
                fix = literalfixes.switchArmFix(this, valueExpressions, valueArms, i, unified, fixTarget,
                    fixOrigin, widening);
            }
            this.targets().setBesideLiteral(fix == null);
            bool refused =
                literaltyping.adaptIntegerLiteral(this, expression, unified, null, fix) is ErrorType
                || literaltyping.adaptFloatLiteral(this, expression, unified, null, fix) is ErrorType;
            this.targets().setBesideLiteral(false);
            if (refused) {
                return this.store().errorType();
            }
            Type adapted = this.recordedType(expression);
            if (!(adapted is ErrorType)) {
                analyzed = adapted;
            }
            let joined = convert.unifyValueTypes(unified, analyzed, this.store());
            if (joined == null) {
                valuejoins.holdMismatch(this, "Switch arms produce '{this.names().of(unified)}' and "
                    + "'{this.names().of(analyzed)}', which have no common type. Give every arm "
                    + "the same type.", span);
                return this.store().errorType();
            }
            unified = joined;
        }
        if (types.isVoidType(unified)) {
            string arm = "{wording.armHead(valueArms.get(0))} -> "
                + "{wording.oneLineSpelling(valueExpressions.get(0))}";
            string named = "an arm";
            if (arm.length <= wording.quotedCodeLimit()) {
                named = "the arm '{arm}'";
            }
            this.reporter().report("This switch is used as a value, but {named} gives no value. Give every "
                + "arm a value.", span);
            return this.store().errorType();
        }
        for (long i = 0; i < valueExpressions.length(); i++) {
            literaltyping.adaptIntegerLiteral(this, valueExpressions.get(i), unified);
            literaltyping.adaptFloatLiteral(this, valueExpressions.get(i), unified);
        }
        return unified;
    }

    // Adapts the literal arms analyzed without the target, or returns false when a literal does not
    // fit. A floating-point literal takes the type of the other arms when it is a floating-point one,
    // and an integer literal after an arm with a type of its own the type the arms before it join to
    // when it is an integer one; either takes the target otherwise.
    adaptLiteralArms(List<Expression> values, List<SwitchArm> arms, Type target,
                     LiteralOrigin? origin) -> bool {
        Type? typed = this.typedArmsJoin(values);
        if (typed is ErrorType) {
            return true;
        }
        Type? before = null;
        bool typedBefore = false;
        for (long i = 0; i < values.length(); i++) {
            let value = values.get(i);
            if (!valuejoins.isUntypedNumberLiteral(value)) {
                before = this.joinedBefore(before, this.recordedType(value));
                typedBefore = true;
                continue;
            }
            if (literaltyping.floatLiteralOf(wording.unwrapParentheses(value)) == null) {
                Type? adaptedInteger = null;
                if (typedBefore && before != null && valuejoins.joinsLiteral(value, before)) {
                    JoinText? fix = null;
                    let widening = literalfixes.joinWidening(this, value, before, this.targets().joinRoot());
                    if (widening != null) {
                        fix = literalfixes.switchArmFix(this, values, arms, i, before, target, origin,
                            widening);
                    }
                    // With no arm of the joined type before it, that type is the target's, and so is
                    // the literal's refusal.
                    LiteralOrigin? through = null;
                    if (fix == null) {
                        through = origin;
                    }
                    adaptedInteger = literaltyping.adaptIntegerLiteral(this, value, before, through, fix);
                } else {
                    adaptedInteger = literaltyping.adaptIntegerLiteral(this, value, target, origin)
                        ?? literaltyping.adaptFloatLiteral(this, value, target, origin);
                }
                if (adaptedInteger is ErrorType) {
                    return false;
                }
                before = this.joinedBefore(before, this.recordedType(value));
                continue;
            }
            Type? adapted = null;
            if (typed != null && valuejoins.joinsLiteral(value, typed)) {
                JoinText? fix = null;
                let widening = literalfixes.joinWidening(this, value, typed, this.targets().joinRoot());
                if (widening != null) {
                    fix = literalfixes.switchArmFix(this, values, arms, values.length(), typed, target,
                        origin, widening);
                }
                adapted = literaltyping.adaptIntegerLiteral(this, value, typed, null, fix)
                    ?? literaltyping.adaptFloatLiteral(this, value, typed, null, fix);
            } else {
                adapted = literaltyping.adaptIntegerLiteral(this, value, target, origin)
                    ?? literaltyping.adaptFloatLiteral(this, value, target, origin);
            }
            if (adapted is ErrorType) {
                return false;
            }
            before = this.joinedBefore(before, this.recordedType(value));
        }
        return true;
    }

    // The type the arm values so far join to once 'next' joins them, or null when they have none.
    joinedBefore(Type? before, Type next) -> Type? {
        if (next is ErrorType) {
            return before;
        }
        if (before == null) {
            return next;
        }
        return convert.unifyValueTypes(before, next, this.store());
    }

    // The type the arm values that are not untyped number literals join to, or null when they have
    // no common type.
    typedArmsJoin(List<Expression> values) -> Type? {
        Type? joined = null;
        for (long i = 0; i < values.length(); i++) {
            let value = values.get(i);
            if (valuejoins.isUntypedNumberLiteral(value)) {
                continue;
            }
            Type analyzed = this.recordedType(value);
            if (joined == null) {
                joined = analyzed;
                continue;
            }
            joined = convert.unifyValueTypes(joined, analyzed, this.store());
            if (joined == null) {
                return null;
            }
        }
        return joined;
    }

    // An identifier label over an enum scrutinee names a member; any other label must be an
    // expression of the enum's own type that resolved to a member constant.
    checkEnumLabel(Expression label, EnumType inner, Set<long> covered) {
        long ordinal = -1;
        if (label is IdentifierExpressionNode) {
            ordinal = enumOrdinal(inner, label.name().text());
            if (ordinal >= 0) {
                this.result().setType(label.green(), inner);
                this.result().setEnumConstant(label.green(), ordinal);
            } else {
                this.reporter().report("'{label.name().text()}' is not a member of enum "
                    + "'{this.names().of(inner)}'.{wording.membersListed(inner)}", label.span());
            }
        } else {
            Type labelType = this.analyzeExpression(label);
            if (!(labelType is ErrorType) && labelType != inner) {
                string valueShown = this.names().of(inner);
                this.reporter().report("Switch label of type "
                    + "'{this.names().of(labelType)}' does not match the switch value "
                    + "of type '{valueShown}'. Write a label of type '{valueShown}'.",
                    label.span());
            }
            let constant = this.result().enumConstantOf(label.green());
            if (constant != null) {
                ordinal = constant;
            }
        }
        if (ordinal >= 0 && !covered.add(ordinal)) {
            this.reporter().report("This switch already has an arm for '{wording.oneLineSpelling(label)}'. "
                + "Remove this second one.", label.span());
        }
    }

    // Integer labels are integer constants written in any integer-literal form: an int or long
    // literal by its value, a char literal by its codepoint, so 'A', 65, and 65L name the same
    // label. A literal label adapts to the scrutinee, its value fit-checked against the type.
    checkIntegerLabel(Expression label, Type inner, Set<long> seen) {
        Type labelType = this.analyzeExpression(label);
        let value = integerLabelValue(label);
        if (value == null) {
            if (!(labelType is ErrorType)) {
                if (!convert.isAssignableStrict(inner, labelType)
                        && !convert.isAssignableStrict(labelType, inner)) {
                    string valueShown = this.names().of(inner);
                    this.reporter().report("Switch label of type "
                        + "'{this.names().of(labelType)}' does not match the switch "
                        + "value of type '{valueShown}'. Write a label of type '{valueShown}'.",
                        label.span());
                } else {
                    string spelled = wording.oneLineSpelling(label);
                    this.reporter().report("Label '{spelled}' is not an integer constant, and every label of "
                        + "a switch on an integer must be one, such as '1'. Compare with '{spelled}' in an "
                        + "'if' instead.", label.span());
                }
            }
            return;
        }
        if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
            literaltyping.adaptCharLiteral(this, label, inner);
        } else {
            literaltyping.adaptIntegerLiteralLabel(this, label, inner);
        }
        let adapted = this.result().typeOf(label.green());
        if (adapted != null && adapted is ErrorType) {
            return;
        }
        if (!seen.add(value)) {
            this.reporter().report("This switch already has an arm for '{value}'. Remove this second one.",
                label.span());
        }
    }

    checkStringLabel(Expression label, Set<string> seen) {
        Type labelType = this.analyzeExpression(label);
        if (!(labelType is ErrorType) && !(labelType is StringType)) {
            this.reporter().report("Switch label of type '{this.names().of(labelType)}' does not "
                + "match the switch value of type 'string'. Write a string literal label.",
                label.span());
            return;
        }
        let text = stringLabelText(label);
        if (text != null) {
            if (!seen.add(text)) {
                this.reporter().report("This switch already has an arm for "
                    + "'{wording.oneLineSpelling(label)}'. Remove this second one.", label.span());
            }
        } else if (!(labelType is ErrorType)) {
            string spelled = wording.oneLineSpelling(label);
            this.reporter().report("Label '{spelled}' is not a string literal, and every label of a switch "
                + "on a string must be one, such as '\"a\"'. Compare with '{spelled}' in an 'if' instead.",
                label.span());
        }
    }

    // The class or interface an 'is' arm matches, or null when the arm is rejected: the
    // target must be able to match some values of the scrutinee without matching all of them.
    // 'first' marks an arm with no accepted 'is' arm before it, which the refusal of an arm that
    // matches every value writes the switch without.
    checkTypeArmTarget(Type scrutineeType, Type inner, Type armType, Span span, Expression scrutinee,
                       ArmBody body, bool first) -> Type? {
        if (armType is OptionalType) {
            this.reporter().report("The type of an 'is' arm cannot be nullable, because 'is' never matches "
                + "null. Write 'is {this.names().of(convert.coreOf(armType))}', and add a 'null ->' arm "
                + "for null.", span);
            return null;
        }
        // A type parameter arm is judged per instantiation; here it still matches and binds as
        // the parameter.
        if (armType is TypeParamType) {
            this.recordObligation(new TypeTestObligation(inner, armType, false, span));
            return armType;
        }
        if (!types.isClassLike(armType)) {
            this.reporter().report("The type of an 'is' arm must be a class or an interface, and "
                + "'{this.names().of(armType)}' is neither.", span);
            return null;
        }
        if (armType == inner) {
            this.reporter().report("'is {this.names().of(armType)}' matches every value of this "
                + "switch over '{this.names().of(scrutineeType)}'"
                + everyValueFix(scrutineeType, scrutinee, body, first), span);
            return null;
        }
        if (hierarchy.isSubclassOrConforms(inner, armType)) {
            this.reporter().report("A value of type '{this.names().of(inner)}' is always a "
                + "'{this.names().of(armType)}', so this arm matches every value"
                + everyValueFix(scrutineeType, scrutinee, body, first), span);
            return null;
        }
        if (types.isInterfaceLike(inner)) {
            return armType;
        }
        if (types.isInterfaceLike(armType)) {
            if (isFinalClass(inner)) {
                this.reporter().report("A value of type '{this.names().of(inner)}' "
                    + "can never be a '{this.names().of(armType)}': "
                    + "'{this.names().of(inner)}' is 'final' and does not implement "
                    + "it. Remove this arm.", span);
                return null;
            }
            return armType;
        }
        if (!hierarchy.isSubclassOf(armType, inner)) {
            this.reporter().report("A value of type '{this.names().of(inner)}' can never be a "
                + "'{this.names().of(armType)}', because '{this.names().of(armType)}' is not a subclass of "
                + "'{this.names().of(inner)}'. Remove this arm.", span);
            return null;
        }
        return armType;
    }

    // An arm is unreachable when an earlier arm already matches every value of its type.
    checkTypeArmReachable(Type armTarget, List<Type> earlier, Span span) {
        for (long i = 0; i < earlier.length(); i++) {
            if (hierarchy.isSubclassOrConforms(armTarget, earlier.get(i))) {
                this.reporter().report("This 'is {shortTypeName(armTarget, this.names())}' arm never runs, "
                    + "because the earlier 'is {shortTypeName(earlier.get(i), this.names())}' arm "
                    + "already matches every '{shortTypeName(armTarget, this.names())}'. Move it above "
                    + "that arm, or remove it.", span);
                return;
            }
        }
    }

    // An enum switch without a default must cover every member; integer and string switches
    // always need one.
    checkValueExhaustiveness(Type inner, Set<long> coveredEnumOrdinals, Span span) {
        if (inner is EnumType) {
            string[] names = inner.memberNames();
            let missing = new List<string>();
            for (long i = 0; i < names.length; i++) {
                if (!coveredEnumOrdinals.contains(i)) {
                    missing.push(names[i]);
                }
            }
            if (missing.length() > 0) {
                let qualified = new List<string>();
                for (let member in missing) {
                    qualified.push("{this.names().of(inner)}.{member}");
                }
                string add = "Add an arm for each, or a 'default' arm.";
                if (missing.length() == 1) {
                    add = "Add an arm for it, or a 'default' arm.";
                }
                this.reporter().report("This switch has no arm for {wording.quotedList(qualified)}. {add}",
                    span);
            }
            return;
        }
        string shown = this.names().of(inner);
        this.reporter().report("A switch on '{shown}' must have a 'default' arm, because its arms cannot "
            + "list every '{shown}' value.", span);
    }

    // A type switch without a default: an interface or an unsealed or concrete root always
    // needs one; a sealed abstract root instead needs every direct subclass covered, an arm
    // for a subclass covering its descendants.
    checkTypeExhaustiveness(Type inner, List<Type> armTargets, Span span) {
        string rootName = this.names().of(inner);
        let authority = types.authorityOf(inner);
        if (authority is InterfaceType) {
            this.reporter().report("A switch over '{rootName}' must have a 'default' arm: "
                + "interfaces are open, so any class anywhere may implement '{rootName}'.",
                span);
            return;
        }
        if (authority is ClassType) {
            if (authority.isFinal()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because an arm "
                    + "for a type parameter may not match every '{rootName}'.", span);
                return;
            }
            if (!authority.isSealed()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because "
                    + "'{rootName}' is not 'sealed', so it can have subclasses that no arm matches.", span);
                return;
            }
            if (!authority.isAbstract()) {
                this.reporter().report("A switch over '{rootName}' must have a 'default' arm, because "
                    + "'{rootName}' is not abstract, so a value can be a '{rootName}' itself, which no "
                    + "subclass arm matches.", span);
                return;
            }
            let missing = new List<string>();
            let subclasses = authority.directSubclasses();
            for (long i = 0; i < subclasses.length(); i++) {
                let subclass = subclasses.get(i);
                bool covered = false;
                for (long j = 0; j < armTargets.length(); j++) {
                    if (hierarchy.isSubclassOrConforms(subclass, armTargets.get(j))) {
                        covered = true;
                        break;
                    }
                }
                if (!covered) {
                    missing.push(subclass.name());
                }
            }
            if (missing.length() > 0) {
                string noun = "subclasses";
                string add = "Add an arm for each, or a 'default' arm.";
                if (missing.length() == 1) {
                    noun = "a subclass";
                    add = "Add an arm for it, or a 'default' arm.";
                }
                this.reporter().report("This switch has no arm for {wording.quotedList(missing)}, {noun} of "
                    + "sealed class '{rootName}'. {add}", span);
            }
        }
    }

    public recordedType(Expression expression) -> Type {
        let recorded = this.result().typeOf(expression.green());
        if (recorded != null) {
            return recorded;
        }
        return this.store().errorType();
    }

    // Walks one switch arm from the state after the scrutinee and records both its assignment
    // out-state and the narrowings holding at its end, so the arms can be joined: a local
    // assigned in every arm of an exhaustive switch is assigned after, and a path narrowed by
    // every arm stays narrowed after.
    walkArmBodyFlow(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                            List<AssignmentFlow> armFlows,
                            List<Map<NarrowingPath, Type>> armNarrowings,
                            bool deferLiterals, LiteralOrigin? origin, Type? fixTarget) -> bool {
        let sawBlock = this.walkArmBody(body, requireValue, target, sink, armNarrowings,
            deferLiterals, origin, fixTarget);
        armFlows.push(this.assignment().snapshot());
        return sawBlock;
    }

    // With 'deferLiterals', a number literal arm is analyzed without the target, so it can take the
    // type of the arms that have one. 'origin' is where the target is set, and 'fixTarget'
    // is the target the arm values of a switch analyzed without one are judged against.
    walkArmBody(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                        List<Map<NarrowingPath, Type>> armNarrowings,
                        bool deferLiterals, LiteralOrigin? origin, Type? fixTarget) -> bool {
        switch (body) {
            is BlockNode block -> {
                bool sawBlock = false;
                if (requireValue) {
                    this.reporter().report("Each arm of a switch used as a value must give a value, as in "
                        + "'1 -> 0,', not run a '\{ \}' block.", block.span());
                    sawBlock = true;
                }
                this.enterScope();
                this.walkBlock(block);
                armNarrowings.push(this.narrowingState.flatten());
                this.leaveScope();
                return sawBlock;
            },
            is Expression expression -> {
                if (requireValue) {
                    valuejoins.noteJoinValue(this, expression);
                }
                bool deferred = deferLiterals && valuejoins.isUntypedNumberLiteral(expression);
                if (target != null && !deferred) {
                    this.analyzeExpressionAdapt(expression, target, origin);
                } else {
                    this.targets().stash(expression, target ?? fixTarget, origin);
                    this.analyzeExpression(expression);
                    this.targets().clearStash();
                }
                armNarrowings.push(this.narrowingState.flatten());
                if (requireValue) {
                    sink.push(expression);
                }
                return false;
            },
            default -> {
                armNarrowings.push(this.narrowingState.flatten());
                return false;
            },
        }
    }
}

// The call shape paired with each argument's written expression, positional first and named
// after, so resolved calls can adapt literals in place. An 'out' misuse leaves a null hole.
public final class BuiltShape {
    protected CallShape callShape;
    protected List<Expression?> values;

    public constructor(this.callShape, this.values);

    public shape() -> CallShape {
        return this.callShape;
    }
}

// Whether one of these declarations takes a call of this argument count.
anyAcceptsArgumentCount(List<Method> candidates, long argumentCount) -> bool {
    for (long i = 0; i < candidates.length(); i++) {
        if (calls.acceptsArgumentCount(candidates.get(i).signature(), argumentCount)) {
            return true;
        }
    }
    return false;
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

// A floating-point type converts to text, but `decimal` is reserved rather than
// implemented, so it has none even though it counts as floating-point elsewhere.
public isTextualFloat(Type core) -> bool {
    return convert.isFloatType(core) && !types.isDecimalType(core);
}

parameterCountText(long count) -> string {
    if (count == 1) {
        return "1 parameter";
    }
    return "{count} parameters";
}

// The refusal of a 'fromCString' call that passes 'count' arguments.
fromCStringCountRefusal(long count) -> string {
    string refusal = "'fromCString' takes one argument, a handle a C function returned, but this call "
        + "passes {diagnostics.countWord(count)}.";
    if (count == 0) {
        return "{refusal} Pass the handle.";
    }
    if (count == 2) {
        return "{refusal} Remove the extra argument.";
    }
    return "{refusal} Remove the extra arguments.";
}

// A lambda of the right arity, as a diagnostic shows the shape to write: '(a, b) -> ...'.
lambdaShapeExample(long count) -> string {
    let builder = new StringBuilder();
    builder.append("(");
    for (long i = 0; i < count; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameterExampleName(i));
    }
    builder.append(") -> ...");
    return builder.toString();
}

parameterExampleName(long index) -> string {
    return switch (index) {
        0 -> "a",
        1 -> "b",
        2 -> "c",
        default -> "p{index + 1}",
    };
}

public usesNamedArguments(ArgumentListNode arguments) -> bool {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (arguments.arguments(i) is NamedArgumentNode) {
            return true;
        }
    }
    return false;
}

// True for a value with no type of its own to offer overload resolution, which is checked once the
// parameter it fills is known: an empty array literal, a '{...}' literal, and a lambda, whose
// parameter and return types come from the function type it fills.
// Whether the argument is an operator or a join holding a floating-point literal too large for
// 'float', whose fix names the parameter the argument is passed to.
carriesOverflowingFloat(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    if (core is BinaryExpressionNode) {
        return overflowsFloatWithin(core.left()) || overflowsFloatWithin(core.right());
    }
    if (core is TernaryExpressionNode) {
        return overflowsFloatWithin(core.thenValue()) || overflowsFloatWithin(core.elseValue());
    }
    return false;
}

// Whether the value is, or holds as an operand or a branch, a floating-point literal too large for
// 'float'.
overflowsFloatWithin(Expression value) -> bool {
    Expression core = literalfixes.operandCore(value);
    let literal = literaltyping.floatLiteralOf(core);
    if (literal != null) {
        return literalfixes.literalOverflows(literal, PrimitiveKind.Float);
    }
    return carriesOverflowingFloat(core);
}

// Whether an argument of a generic call is analyzed once its parameter type is known. With the type
// arguments 'written', an array literal is too, so that its literals take the element type.
waitsForParameter(Expression value, bool written) -> bool {
    return needsTargetType(value) || (written && value is ArrayLiteralExpressionNode);
}

needsTargetType(Expression value) -> bool {
    if (value is ArrayLiteralExpressionNode) {
        return value.elementsCount() == 0;
    }
    return value is StructLiteralExpressionNode || value is LambdaExpressionNode;
}

public enumOrdinal(EnumType enumType, string memberName) -> long {
    string[] names = enumType.memberNames();
    for (long i = 0; i < names.length; i++) {
        if (names[i] == memberName) {
            return i;
        }
    }
    return -1;
}

hasTypeArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        if (arms.get(i) is TypeArmNode) {
            return true;
        }
    }
    return false;
}

isNullLabel(Expression label) -> bool {
    return label is LiteralExpressionNode && label.value().kind() == SyntaxKind.NullKeyword;
}

// The two walks over a string, spelled against the expression the loop was given when that
// expression is simple enough to quote and against the string itself when it is not.
stringWalkAdvice(Expression iterated) -> string {
    let spelling = wording.simpleSpelling(iterated);
    if (spelling == null) {
        return "Iterate its 'chars()' to visit its characters, or its 'bytes()' to visit its "
            + "bytes.";
    }
    return "Iterate '{spelling}.chars()' to visit its characters, or '{spelling}.bytes()' to "
        + "visit its bytes.";
}

// "Parameter 'result'", or "Parameter 2" for the parameter at 'index' when it has no name.
parameterSubject(Parameter parameter, long index) -> string {
    if (parameter.name().length > 0) {
        return "Parameter '{parameter.name()}'";
    }
    return "Parameter {index + 1}";
}

// The source text of one argument on one line.
argumentSpelling(Argument argument) -> string {
    switch (argument) {
        is NamedArgumentNode named -> {
            return wording.greenSpelling(named.green());
        },
        is OutArgumentNode written -> {
            return wording.greenSpelling(written.green());
        },
        is Expression value -> {
            return wording.oneLineSpelling(value);
        },
        default -> {
            return "";
        },
    }
}

// The argument list of a call with the names of its named arguments removed, when it is short, or '(...)'.
positionalSpelling(ArgumentListNode arguments) -> string {
    string listed = "";
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (i > 0) {
            listed = listed + ", ";
        }
        switch (arguments.arguments(i)) {
            is NamedArgumentNode named -> {
                listed = listed + wording.oneLineSpelling(named.value());
            },
            default -> {
                listed = listed + argumentSpelling(arguments.arguments(i));
            },
        }
    }
    if (listed.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return "({listed})";
}

// The argument list of a call as written when it is short, or '(...)'.
public argumentsSpelling(ArgumentListNode? arguments) -> string {
    if (arguments == null) {
        return "()";
    }
    string spelled = wording.greenSpelling(arguments.green());
    if (spelled.length > wording.quotedCodeLimit()) {
        return "(...)";
    }
    return spelled;
}

// The refusal of a 'try' before 'operand', which is not a call. The fix moves the 'try' to a call on
// one side of an operator.
misplacedTryRefusal(Expression operand) -> string {
    let spelled = wording.shortSpelling(operand);
    if (spelled == null) {
        return "'try' must be written directly before a call. Move 'try' to the call that can throw.";
    }
    string opening = "'try' must be written directly before a call, and '{spelled}' is not a call.";
    let inner = wording.unwrapParentheses(operand);
    if (inner is BinaryExpressionNode) {
        string left = wording.oneLineSpelling(inner.left());
        string right = wording.oneLineSpelling(inner.right());
        string operator = inner.operator().text();
        if (inner.right() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in '{left} {operator} try {right}'.";
        }
        if (inner.left() is CallExpressionNode) {
            return "{opening} Move 'try' to the call, as in 'try {left} {operator} {right}'.";
        }
    }
    return "{opening} Move 'try' to the call that can throw.";
}

typeParameterNamesText(Signature signature) -> string {
    string text = "";
    let parameters = signature.typeParameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + parameters[i].name();
    }
    return text;
}


// The refusal of argument 'label' of 'callee', whose type 'actual' is not the type 'expected' of the
// parameter it is passed to, named 'parameter' when the parameter has a name.
public argumentMismatch(string label, string callee, string parameter, Type expected, Type actual,
                        TypeNames names) -> string {
    string given = "Argument {label} of {callee} has type '{names.of(actual)}'";
    if (parameter.length == 0) {
        string wanted = names.of(expected);
        return "{given}, but {callee} takes {typenames.typeArticle(wanted)} '{wanted}' there.";
    }
    return "{given}, but parameter '{parameter}' has type '{names.of(expected)}'.";
}

// How a refusal names the callee of 'kindWord' spelled 'displayName' after the word "of".
calleeObject(string kindWord, string displayName) -> string {
    if (kindWord == "Constructor" || kindWord == "Base constructor") {
        return "the constructor of '{displayName}'";
    }
    return "'{displayName}'";
}

// Whether a switch has an expression arm that is not an untyped number literal.
hasTypedArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        switch (arms.get(i)) {
            is ValueArmNode arm -> {
                if (valuejoins.isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is TypeArmNode arm -> {
                if (valuejoins.isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is DefaultArmNode arm -> {
                if (valuejoins.isTypedArmBody(arm.body())) {
                    return true;
                }
            },
            is ErrorSwitchArmNode ignored -> { },
        }
    }
    return false;
}

// The constant an integer switch label names: a char literal's codepoint, or an int or long
// literal's value behind an optional sign.
integerLabelValue(Expression label) -> long? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
        return literalvalues.charCodepoint(label.value().text()) as long;
    }
    let literal = literaltyping.integerLiteralOf(label, true);
    if (literal == null) {
        return null;
    }
    let magnitude = literalvalues.integerMagnitude(literal.value().text());
    if (magnitude == null) {
        return null;
    }
    long value = magnitude as long;
    if (literaltyping.isNegativeLiteral(label)) {
        return 0 - value;
    }
    return value;
}

// A string label's decoded value, so two spellings of the same string (for example "\t" and a
// literal tab) collide as a duplicate.
stringLabelText(Expression label) -> string? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.StringLiteral) {
        return literalvalues.decodeString(label.value().text());
    }
    return null;
}

shortTypeName(Type type, TypeNames names) -> string {
    let authority = types.authorityOf(type);
    if (authority != null) {
        return authority.name();
    }
    return names.of(type);
}

// The head a 'new' writes for its type.
writtenTypeName(TypeNode created, Type resolved, TypeNames names) -> string {
    if (created is NamedTypeNode) {
        return created.name().text();
    }
    return names.of(resolved);
}

// ---- The canonical fill loop ----

identName(Expression node) -> string {
    if (node is IdentifierExpressionNode) {
        return node.name().text();
    }
    return "";
}

isIntegerLiteralText(Expression node, string text) -> bool {
    if (node is LiteralExpressionNode) {
        SyntaxKind kind = node.value().kind();
        if (kind == SyntaxKind.IntLiteral || kind == SyntaxKind.LongLiteral) {
            return node.value().text() == text;
        }
    }
    return false;
}

isPlainIndexType(TypeNode reference) -> bool {
    if (reference is NamedTypeNode) {
        string name = reference.name().text();
        if (name != "long" && name != "int") {
            return false;
        }
        return reference.qualifier() == null && reference.typeArguments() == null;
    }
    return false;
}

// A step-by-one update on the index: 'i = i + 1', 'i++', or '++i'.
isUnitIncrement(Expression update, string indexName) -> bool {
    if (update is AssignmentExpressionNode) {
        if (update.operator().kind() != SyntaxKind.Equals) {
            return false;
        }
        if (identName(update.target()) != indexName) {
            return false;
        }
        return isPlusOne(update.value(), indexName);
    }
    if (update is PostfixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus && identName(update.operand()) == indexName;
    }
    if (update is PrefixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus && identName(update.operand()) == indexName;
    }
    return false;
}

isPlusOne(Expression value, string indexName) -> bool {
    if (value is BinaryExpressionNode) {
        return value.operator().kind() == SyntaxKind.Plus
            && identName(value.left()) == indexName
            && isIntegerLiteralText(value.right(), "1");
    }
    return false;
}

// Any identifier token spelling the name counts as a mention; the fill expression must
// provably never read the array.
mentionsIdentifier(GreenNode node, string name) -> bool {
    for (long i = 0; i < node.slotCount(); i++) {
        let child = node.slot(i);
        if (child == null) {
            continue;
        }
        if (child is GreenToken) {
            if (child.kind() == SyntaxKind.Identifier && child.text() == name) {
                return true;
            }
        } else if (child is GreenNode) {
            if (mentionsIdentifier(child, name)) {
                return true;
            }
        }
    }
    return false;
}

// Matches 'for (long i = 0; i < name.length; i = i + 1) { name[i] = expr; }' (the update also
// accepts 'i++' and '++i') with a fresh 'long'/'int' index and 'expr' never mentioning 'name'.
isArrayFillLoop(ForStatementNode loop, string arrayName) -> bool {
    let indexName = fillLoopIndexName(loop, arrayName);
    if (indexName == null) {
        return false;
    }
    if (!fillLoopConditionMatches(loop.condition(), arrayName, indexName)) {
        return false;
    }
    let update = loop.update();
    if (update == null || !isUnitIncrement(update, indexName)) {
        return false;
    }
    return fillLoopBodyMatches(loop.body(), arrayName, indexName);
}

// The fresh 'long'/'int' index the loop declares starting at 0, or null when the initializer
// does not match.
fillLoopIndexName(ForStatementNode loop, string arrayName) -> string? {
    let initializer = loop.initializer();
    if (initializer is VariableDeclarationNode) {
        let declaredType = initializer.declaredType();
        if (declaredType != null && !isPlainIndexType(declaredType)) {
            return null;
        }
        let initialValue = initializer.initializer();
        if (initialValue == null || !isIntegerLiteralText(initialValue.value(), "0")) {
            return null;
        }
        string indexName = initializer.name().text();
        if (indexName.length == 0 || indexName == arrayName) {
            return null;
        }
        return indexName;
    }
    return null;
}

fillLoopConditionMatches(Expression? condition, string arrayName, string indexName)
        -> bool {
    if (condition is BinaryExpressionNode) {
        if (condition.operator().kind() != SyntaxKind.Less) {
            return false;
        }
        if (identName(condition.left()) != indexName) {
            return false;
        }
        let lengthAccess = condition.right();
        if (lengthAccess is MemberExpressionNode) {
            return identName(lengthAccess.object()) == arrayName && lengthAccess.member().text() == "length";
        }
    }
    return false;
}

fillLoopBodyMatches(BlockNode body, string arrayName, string indexName) -> bool {
    if (body.statementsCount() != 1) {
        return false;
    }
    let statement = body.statements(0);
    if (statement is ExpressionStatementNode) {
        let assignment = statement.expression();
        if (assignment is AssignmentExpressionNode) {
            if (assignment.operator().kind() != SyntaxKind.Equals) {
                return false;
            }
            let slot = assignment.target();
            if (slot is SubscriptExpressionNode) {
                if (identName(slot.object()) != arrayName || identName(slot.index()) != indexName) {
                    return false;
                }
                return !mentionsIdentifier(assignment.value().green(), arrayName);
            }
        }
    }
    return false;
}

// The element type argument when the type is an 'Iterable<T>' instantiation from
// '@std.collections.iterator'.
iterableArgument(Type candidate) -> Type? {
    if (candidate is InstantiationType) {
        let template = candidate.template();
        if (template is InterfaceType && template.name() == "Iterable"
                && template.modulePath() == "std.collections.iterator"
                && candidate.arguments().length > 0) {
            return candidate.arguments()[0];
        }
    }
    return null;
}

// A recovery arm is dropped: the parser could not read what was written there, so there is nothing
// for the checker to reason about, and the syntax error already says so.
armsOfStatement(SwitchStatementNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        if (!(node.arms(i) is ErrorSwitchArmNode)) {
            arms.push(node.arms(i));
        }
    }
    return arms;
}

public armsOfExpression(SwitchExpressionNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        if (!(node.arms(i) is ErrorSwitchArmNode)) {
            arms.push(node.arms(i));
        }
    }
    return arms;
}
