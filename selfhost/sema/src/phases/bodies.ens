import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Checks every body of every module. Modules see each other only through the type store, the
// link tables, and the other modules' function tables (for namespace-qualified calls).
public checkBodies(List<ModuleContext> contexts, ObligationRegistry deferred)
        -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let contextsByPath = new Map<string, ModuleContext>();
    for (long i = 0; i < contexts.length(); i++) {
        contextsByPath.set(contexts.get(i).module().canonicalPath(), contexts.get(i));
    }
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new BodyChecker(contexts.get(i), contextsByPath, collected, deferred);
        checker.run();
        for (let diagnostic in contexts.get(i).resolver().takeDiagnostics()) {
            collected.push(diagnostic);
        }
    }
    return diagnostics.sorted(collected);
}

// What an unqualified name means at a use site, innermost scope first.
sealed abstract class NameResolution {
}

class LocalName extends NameResolution {
    protected LocalBinding binding;

    protected constructor(this.binding);
}

class FunctionName extends NameResolution {
    protected List<FunctionEntry> entries;

    protected constructor(this.entries);
}

class TypeName extends NameResolution {
    protected DeclaredType target;

    protected constructor(this.target);
}

class NamespaceName extends NameResolution {
    protected string targetModulePath;

    protected constructor(this.targetModulePath);
}

// One fact a condition can prove: the storage path, the type the check proves for it, and
// whether the proof holds where the condition is true or where it is false.
class NarrowingFact {
    protected NarrowingPath path;
    protected Type proven;
    protected bool narrowsWhenTrue;

    protected constructor(this.path, this.proven, this.narrowsWhenTrue);
}

// A snapshot of definite-assignment state at one program point: the locals and this-fields
// assigned so far, the this-fields that may have been assigned on some path reaching it, and
// whether the path has already left through a return, throw, break, continue, or panic.
class AssignmentFlow {
    protected List<LocalBinding> assigned;
    protected List<Field> assignedFields;
    protected List<Field> maybeAssignedFields;
    protected bool terminated;

    protected constructor(this.assigned, this.assignedFields, this.maybeAssignedFields,
                this.terminated);
}

// A numeric literal whose value its own default type cannot hold. The report waits until the
// module's bodies are checked, because a literal in a target-typed position is retyped first
// and diagnosed against that target instead; what is left over is a literal that kept its
// default and would otherwise be truncated in silence.
class PendingLiteralRange {
    protected GreenNode green;
    protected Span span;
    protected PrimitiveType defaultType;
    protected string text;
    protected bool negative;
    protected bool parsed;
    protected ulong magnitude;

    protected constructor(this.green, this.span, this.defaultType, this.text, this.negative,
                this.parsed, this.magnitude);

    protected moveTo(GreenNode green, Span span, bool negative) {
        this.green = green;
        this.span = span;
        this.negative = negative;
    }
}

// One lambda whose body is being checked: the scope outside it, the receiver outside it, and
// what its body has read from either so far. The captures accumulate in first-read order, which
// is the order the closure copies them in.
class LambdaFrame {
    protected Scope? enclosingScope;
    protected Type? enclosingReceiver;
    protected List<LambdaCapture> captures;
    protected List<LocalBinding> capturedBindings;
    protected bool readsReceiver;

    protected constructor(Scope? enclosingScope, Type? enclosingReceiver) {
        this.enclosingScope = enclosingScope;
        this.enclosingReceiver = enclosingReceiver;
        this.captures = new List<LambdaCapture>();
        this.capturedBindings = new List<LocalBinding>();
        this.readsReceiver = false;
    }

    // The binding this name has outside the lambda, or null when the enclosing scope has none.
    protected lookupOuter(string name) -> LocalBinding? {
        let outer = this.enclosingScope;
        if (outer == null) {
            return null;
        }
        return outer.lookup(name);
    }

    protected captureBinding(LocalBinding binding) {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return;
            }
        }
        this.capturedBindings.push(binding);
        this.captures.push(new LambdaCapture(binding, binding.type()));
    }

    // Records that the lambda copies the enclosing receiver; true the first time, so a rejection
    // reports once however many times the body reads 'this'.
    protected captureReceiver(Type receiver) -> bool {
        if (this.readsReceiver) {
            return false;
        }
        this.readsReceiver = true;
        this.captures.push(new LambdaCapture(null, receiver));
        return true;
    }

    protected holds(LocalBinding binding) -> bool {
        for (long i = 0; i < this.capturedBindings.length(); i++) {
            if (this.capturedBindings.get(i) == binding) {
                return true;
            }
        }
        return false;
    }

    protected result() -> LambdaCapture[] {
        return this.captures.toArray();
    }
}

// What a member name means on a receiver type.
sealed abstract class MemberLookup {
}

class FieldMember extends MemberLookup {
    protected Field field;

    protected constructor(this.field);
}

class MethodMember extends MemberLookup {
    protected List<Method> candidates;

    protected constructor(this.candidates);
}

class MissingMember extends MemberLookup {
    protected constructor();
}

class BodyChecker implements NoreturnCalls {
    ModuleContext context;
    Map<string, ModuleContext> contextsByPath;
    TypeResolver resolver;
    TypeStore store;
    SemaResult result;
    Reporter reporter;
    string modulePath;
    string packagePrefix;

    Scope? scope;
    Scope? parameterScope;
    // The lambdas whose bodies are being checked, outermost first. Empty in ordinary code; a
    // name the innermost one does not declare itself is a capture.
    List<LambdaFrame> lambdaFrames;
    NarrowingState narrowing;
    LocalBinding? thisBinding;
    Type? thisType;
    // The class or struct whose member body is being checked, statics included; the access
    // rules judge private and protected members from here. Null outside member bodies.
    Type? enclosingOwner;
    bool inStaticMethod;
    Type? currentReturnType;
    bool currentNoreturn;
    bool inConstructor;
    bool sawSuperCall;
    bool inCatchClause;
    long loopDepth;

    List<LocalBinding> assignedLocals;
    List<LocalBinding> trackedLocals;
    List<List<AssignmentFlow>> breakFlows;
    bool flowTerminated;
    bool unconditionalPosition;
    LocalBinding? assignmentTarget;

    // The class whose constructor body is being analyzed, or null outside a constructor.
    // assignedThisFields is the current flow's set of own fields definitely assigned;
    // ctorSeededThisFields is the entry state (this-field parameters), which each catch
    // clause resets to on the exception path. maybeAssignedThisFields is the fields assigned
    // on at least one path reaching this point, which is what holds a 'const' field to one
    // write; ctorEscapedMaybeFields accumulates that set at every point an exception can
    // leave the body, so a catch clause knows what may already be written when it runs.
    Type? ctorFieldOwner;
    List<Field> assignedThisFields;
    List<Field> ctorSeededThisFields;
    List<Field> maybeAssignedThisFields;
    List<Field> ctorEscapedMaybeFields;

    Set<GreenNode> fillProvenNews;
    Map<GreenNode, string> arrayNewNames;

    ObligationRegistry deferredObligations;
    GreenNode? obligationOwner;
    string obligationOwnerName;

    List<PendingLiteralRange> pendingLiteralRanges;

    protected constructor(ModuleContext context, Map<string, ModuleContext> contextsByPath,
                List<FileDiagnostic> collected, ObligationRegistry deferred) {
        this.context = context;
        this.contextsByPath = contextsByPath;
        this.resolver = context.resolver();
        this.store = context.resolver().typeStore();
        this.result = context.result();
        this.reporter = new Reporter(context.module().filePath(), collected);
        this.modulePath = context.module().canonicalPath();
        this.packagePrefix = context.module().packagePrefix();
        this.lambdaFrames = new List<LambdaFrame>();
        this.narrowing = new NarrowingState();
        this.thisBinding = null;
        this.enclosingOwner = null;
        this.inStaticMethod = false;
        this.currentNoreturn = false;
        this.inConstructor = false;
        this.sawSuperCall = false;
        this.inCatchClause = false;
        this.loopDepth = 0;
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.unconditionalPosition = true;
        this.assignmentTarget = null;
        this.ctorFieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisFields = new List<Field>();
        this.maybeAssignedThisFields = new List<Field>();
        this.ctorEscapedMaybeFields = new List<Field>();
        this.fillProvenNews = new Set<GreenNode>();
        this.arrayNewNames = new Map<GreenNode, string>();
        this.deferredObligations = deferred;
        this.obligationOwner = null;
        this.obligationOwnerName = "";
        this.pendingLiteralRanges = new List<PendingLiteralRange>();
    }

    protected run() {
        let root = this.context.root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is FunctionDeclarationNode declaration -> {
                    this.checkTopLevelFunction(declaration);
                },
                is StructDeclarationNode declaration -> {
                    this.checkStructBodies(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.checkClassBodies(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.checkPrimitiveBindingBodies(declaration);
                },
                is TestDeclarationNode declaration -> {
                    this.checkTestBody(declaration);
                },
                default -> { },
            }
        }
        this.reportPendingLiteralRanges();
    }

    // ---- Declaration walking ----

    checkTopLevelFunction(FunctionDeclarationNode node) {
        let entries = this.context.functions().all();
        for (long i = 0; i < entries.length(); i++) {
            let entry = entries.get(i);
            if (entry.isExternal() || entry.isBuiltin()) {
                continue;
            }
            if (entry.signature().declaration() == node.green()) {
                this.enclosingOwner = null;
                this.checkParameterDefaults(entry.signature(), node);
                this.checkCallableBody(entry.signature(), null, null, null, node);
                return;
            }
        }
    }

    checkStructBodies(StructDeclarationNode node) {
        let found = this.store.findDeclared(this.modulePath, node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    checkClassBodies(ClassDeclarationNode node) {
        let found = this.store.findDeclared(this.modulePath, node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            this.enterObligationOwner(found);
            this.checkFieldDefaults(found, node.body());
            this.checkMemberBodies(found, found.methods(), found.staticMethods(), node.body());
            this.leaveObligationOwner();
        }
    }

    // A binding's members belong to the primitive, so 'this' inside one is the primitive value
    // and the members reachable without a receiver are the binding's own.
    checkPrimitiveBindingBodies(PrimitiveDeclarationNode node) {
        let primitive = types.primitiveNamed(this.store, node.name().text());
        if (primitive == null) {
            return;
        }
        let binding = types.bindingOf(primitive);
        if (binding == null || binding.declaration() != node.green()) {
            return;
        }
        this.checkMemberBodies(primitive, binding.methods(), binding.staticMethods(),
            node.body());
    }

    // Deferred judgments and open generic calls found while checking a generic template's or
    // generic function's bodies record against that owner, keyed by its declaration node.
    enterObligationOwner(DeclaredType found) {
        if (found.isGeneric()) {
            this.obligationOwner = found.declaration();
            this.obligationOwnerName = found.name();
        }
    }

    leaveObligationOwner() {
        this.obligationOwner = null;
        this.obligationOwnerName = "";
    }

    recordObligation(Obligation obligation) {
        let owner = this.obligationOwner;
        if (owner != null) {
            obligation.setGuards(this.activeGuardsFor(owner));
            this.deferredObligations.recordObligation(owner, this.obligationOwnerName,
                this.context.module().filePath(), obligation);
        }
    }

    recordGenericCall(Signature signature, Type[] arguments) {
        bool open = false;
        for (let argument in arguments) {
            if (convert.containsTypeParam(argument)) {
                open = true;
            }
        }
        if (!open) {
            this.deferredObligations.recordConcreteCall(signature, arguments);
            return;
        }
        let owner = this.obligationOwner;
        if (owner != null) {
            this.deferredObligations.recordOpenCall(owner, this.obligationOwnerName,
                this.context.module().filePath(), signature, arguments,
                this.activeGuardsFor(owner));
        }
    }

    // The active conditional member's constraints, as guards for a deferred judgment, when the
    // constrained declaration is the obligation's owner itself.
    activeGuardsFor(GreenNode owner) -> MemberConstraint[] {
        if (this.resolver.activeConstraintOwner() == owner) {
            return this.resolver.activeConstraints();
        }
        return [];
    }

    checkMemberBodies(Type owner, List<Method> methods, List<Method> staticMethods,
                      MemberListNode body) {
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FunctionDeclarationNode) {
                let method = members.methodDeclaredBy(methods, member.green());
                if (method != null) {
                    this.enclosingOwner = owner;
                    this.checkParameterDefaults(method.signature(), member);
                    this.checkCallableBody(method.signature(), owner, owner, method, member);
                    continue;
                }
                let staticMethod = members.methodDeclaredBy(staticMethods, member.green());
                if (staticMethod != null) {
                    this.enclosingOwner = owner;
                    this.checkParameterDefaults(staticMethod.signature(), member);
                    this.checkCallableBody(staticMethod.signature(), null, owner, staticMethod,
                        member);
                }
            }
        }
    }

    checkTestBody(TestDeclarationNode node) {
        this.parameterScope = new Scope(null);
        this.scope = this.parameterScope;
        this.narrowing = new NarrowingState();
        this.thisBinding = null;
        this.thisType = null;
        this.enclosingOwner = null;
        this.inStaticMethod = false;
        this.currentReturnType = this.store.primitive(PrimitiveKind.Void);
        this.currentNoreturn = false;
        this.inConstructor = false;
        this.sawSuperCall = false;
        this.loopDepth = 0;
        this.resetAssignmentFlow();
        this.enterScope();
        this.walkBlock(node.body());
        this.leaveScope();
        this.scope = null;
        this.parameterScope = null;
        this.currentReturnType = null;
    }

    // Checks one callable's body: the parameter scope (with 'this' for instance methods), a
    // child scope for the body's locals, and the catch clauses as siblings that cannot see those
    // locals. A static method takes its owner but no receiver: the owner's type parameters are
    // in scope and its members are reachable, while 'this' does not exist.
    checkCallableBody(Signature signature, Type? receiver, Type? owner, Method? method,
                              FunctionDeclarationNode node) {
        bool ownsObligations = false;
        if (owner == null && signature.isGeneric()) {
            let declaration = signature.declaration();
            if (declaration != null) {
                ownsObligations = true;
                this.obligationOwner = declaration;
                this.obligationOwnerName = signature.name();
            }
        }
        long pushed = this.pushCallableTypeParameters(signature, owner);
        // Inside a conditional member, the constrained parameters carry the member's extra
        // bounds: lookups, bound checks, and existence checks all read the scope.
        bool pushedConstraints = false;
        if (method != null && method.isConditional() && owner is DeclaredType) {
            this.resolver.pushMemberConstraints(owner.declaration(), method.constraints());
            pushedConstraints = true;
        }
        this.parameterScope = new Scope(null);
        this.scope = this.parameterScope;
        this.narrowing = new NarrowingState();
        this.thisBinding = null;
        if (receiver != null) {
            this.thisBinding = new LocalBinding("this", receiver, BindingKind.Parameter, true,
                signature.nameSpan());
        }
        this.thisType = receiver;
        this.enclosingOwner = owner;
        this.inStaticMethod = method != null && method.isStatic();
        this.currentReturnType = signature.returnType();
        this.currentNoreturn = signature.isNoreturn();
        this.inConstructor = method != null && method.isConstructor();
        this.sawSuperCall = false;
        this.loopDepth = 0;
        if (receiver != null) {
            this.result.setReceiver(node.green(), receiver);
        }

        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            let owner = this.parameterScope;
            if (owner != null && !owner.define(binding)) {
                this.reporter.report("Duplicate parameter name '{parameter.name()}'; rename "
                    + "one of the parameters.", parameter.span());
            }
            if (i < parameterList.parametersCount()) {
                this.result.setBinding(parameterList.parameters(i).green(), binding);
            }
        }

        this.resetAssignmentFlow();
        // A constructor also tracks its own fields: a this-field shorthand parameter assigns
        // the field before the body runs, and every own non-defaultable field must be assigned
        // on every path that leaves the body normally.
        if (this.inConstructor && receiver != null) {
            this.seedConstructorFields(signature, receiver);
        }
        let body = node.body();
        if (body != null) {
            this.enterScope();
            this.walkBlock(body);
            this.leaveScope();
        }
        if (this.ctorFieldOwner != null) {
            this.checkConstructorFieldsAssigned(signature.nameSpan());
        }

        this.checkConstructorChainsToBase(signature, node);

        for (long i = 0; i < node.catchClausesCount(); i++) {
            this.checkCatchClause(node.catchClauses(i));
        }

        this.checkReturnPaths(signature, node);

        this.scope = null;
        this.parameterScope = null;
        this.thisBinding = null;
        this.thisType = null;
        this.enclosingOwner = null;
        this.inStaticMethod = false;
        this.currentReturnType = null;
        this.currentNoreturn = false;
        this.inConstructor = false;
        if (pushedConstraints) {
            this.resolver.popMemberConstraints();
        }
        this.resolver.popTypeParameters(pushed);
        if (ownsObligations) {
            this.leaveObligationOwner();
        }
    }

    pushCallableTypeParameters(Signature signature, Type? owner) -> long {
        long pushed = 0;
        if (signature.isGeneric()) {
            this.resolver.pushTypeParameters(signature.typeParameters());
            pushed = pushed + signature.typeParameters().length;
        }
        if (owner is DeclaredType && owner.isGeneric()) {
            this.resolver.pushTypeParameters(owner.typeParameterTypes());
            pushed = pushed + owner.typeParameterTypes().length;
        }
        return pushed;
    }

    // A constructor must chain to its base when the base has constructors but none that is
    // callable with zero arguments.
    checkConstructorChainsToBase(Signature signature, FunctionDeclarationNode node) {
        if (!this.inConstructor || this.sawSuperCall) {
            return;
        }
        let receiver = this.thisType;
        if (receiver == null) {
            return;
        }
        let current = types.authorityOf(receiver);
        if (current is ClassType) {
            let base = current.base();
            if (base == null) {
                return;
            }
            let baseAuthority = types.authorityOf(base);
            if (baseAuthority == null) {
                return;
            }
            bool anyConstructor = false;
            bool anyZeroArgument = false;
            let baseMethods = types.methodsOf(base);
            if (baseMethods == null) {
                return;
            }
            for (long i = 0; i < baseMethods.length(); i++) {
                let candidate = baseMethods.get(i);
                if (!candidate.isConstructor()) {
                    continue;
                }
                anyConstructor = true;
                if (!this.resolver.memberExists(candidate)) {
                    continue;
                }
                if (calls.requiredArgumentCount(candidate.signature()) == 0
                        && this.isAccessAllowed(candidate.visibility(),
                            candidate.definingType())) {
                    anyZeroArgument = true;
                }
            }
            if (!anyConstructor) {
                return;
            }
            // The implicit chain runs one specific constructor, chosen over the declared list
            // in declaration order; when this receiver's arguments exclude that winner, no
            // implicit chain can run, whatever else the base declares.
            let winner = types.implicitConstructorChoice(base);
            if (winner != null && !this.resolver.memberExists(winner)) {
                string clause = this.excludedConstructorClause(winner,
                    "Constrain this constructor the same way");
                if (clause.length > 0) {
                    this.reporter.report("Constructor of '{current.name()}' cannot initialize "
                        + "base class '{types.display(base)}': " + clause,
                        signature.nameSpan());
                    return;
                }
            }
            if (!anyZeroArgument) {
                this.reporter.report("Constructor of '{current.name()}' must call 'super(...)' "
                    + "because base class '{baseAuthority.name()}' has no zero-argument "
                    + "constructor callable from here.", signature.nameSpan());
            }
        }
    }

    // How an excluded conditional base constructor explains itself: the constraint, then either
    // the concrete failing argument or the unconstrained parameter with the fix that would
    // constrain the enclosing declaration the same way.
    excludedConstructorClause(Method excluded, string constrainAdvice) -> string {
        let template = types.authorityOf(excluded.definingType());
        let failed = this.resolver.firstUnmetConstraint(excluded);
        if (template == null || failed == null) {
            return "";
        }
        string templateShown = "{template.name()}<{typeParameterExample(template)}>";
        string parameterName = template.typeParameters()[failed.parameterIndex()];
        string declaredBound = types.display(failed.bound());
        Type argument = types.typeArgumentsOf(excluded.definingType())[failed.parameterIndex()];
        string shownArgument = types.display(argument);
        if (argument is TypeParamType) {
            return "the constructor of '{templateShown}' exists only when '{parameterName}' "
                + "satisfies '{declaredBound}', and here nothing constrains '{shownArgument}' "
                + "to satisfy it. {constrainAdvice}, as in '<{shownArgument}: "
                + "{types.display(failed.boundHere())}>', or add the bound where "
                + "'{shownArgument}' is declared.";
        }
        string failurePhrase = "which does not implement "
            + "'{types.display(failed.boundHere())}'";
        if (!types.isInterfaceLike(failed.bound())) {
            failurePhrase = "which is not '{types.display(failed.boundHere())}' or a subclass "
                + "of it";
        }
        return "the constructor of '{templateShown}' exists only when '{parameterName}' "
            + "satisfies '{declaredBound}', and in "
            + "'{types.display(excluded.definingType())}', '{parameterName}' is "
            + "'{shownArgument}', {failurePhrase}. Give '{template.name()}' a constructor that "
            + "exists for every instantiation, or use a type argument that satisfies the "
            + "bound.";
    }

    // The implicit chain a class with no constructor of its own runs at construction: the
    // nearest base with an implicit-constructor choice, exactly as code generation walks it.
    // When this instantiation excludes that winner, construction cannot run it, whatever else
    // the base declares, because the choice never consults existence.
    excludedImplicitBaseConstructor(Type classType) -> Method? {
        let seen = new Set<Type>();
        Type? current = types.baseOf(classType);
        while (current != null && seen.add(current)) {
            let winner = types.implicitConstructorChoice(current);
            if (winner != null) {
                if (this.resolver.memberExists(winner)) {
                    return null;
                }
                return winner;
            }
            current = types.baseOf(current);
        }
        return null;
    }

    // A non-void callable must exit on every path: through its body and through each catch
    // clause it declares. A 'noreturn' callable carries the stronger obligation that no path
    // completes at all.
    checkReturnPaths(Signature signature, FunctionDeclarationNode node) {
        if (signature.isNoreturn()) {
            this.checkNoreturnBody(signature, node);
            return;
        }
        Type returned = signature.returnType();
        if (types.isVoidType(returned) || returned is ErrorType) {
            return;
        }
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter.report("Function '{signature.name()}' can reach the end of its body "
                + "without returning a value; add a 'return' on every path.",
                signature.nameSpan());
            return;
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter.report("Function '{signature.name()}' can reach the end of its "
                    + "body without returning a value; add a 'return' on every path.",
                    clause.span());
            }
        }
    }

    // A 'noreturn' body must be unable to complete normally: every path ends by throwing,
    // calling 'panic' or another 'noreturn' function, or looping forever. A bodiless form
    // (abstract or interface method) carries the contract without a body to check.
    checkNoreturnBody(Signature signature, FunctionDeclarationNode node) {
        let body = node.body();
        if (body == null) {
            return;
        }
        if (!flow.blockTerminates(body, ExitScope.Function, this)) {
            this.reporter.report("Function '{signature.name()}' is declared 'noreturn' but can "
                + "reach the end of its body. Every path must end by throwing, calling 'panic', "
                + "or calling another 'noreturn' function.", signature.nameSpan());
        }
        for (long i = 0; i < node.catchClausesCount(); i++) {
            let clause = node.catchClauses(i);
            if (!flow.blockTerminates(clause.body(), ExitScope.Function, this)) {
                this.reporter.report("Function '{signature.name()}' is declared 'noreturn' but "
                    + "its 'catch' clause can complete normally. End it by throwing, calling "
                    + "'panic', or calling another 'noreturn' function.", clause.span());
            }
        }
    }

    // A call ends the path when its target is declared 'noreturn' (the builtin 'panic' among
    // them). 'try noreturnCall()' also ends it: the call either throws or never returns.
    override callNeverReturns(Expression expression) -> bool {
        Expression core = unwrapParentheses(expression);
        if (core is TryExpressionNode) {
            core = unwrapParentheses(core.operand());
        }
        if (!(core is CallExpressionNode)) {
            return false;
        }
        let target = this.calleeSignatureOf(core);
        return target != null && target.isNoreturn();
    }

    // The static target of a call, or null for a constructor chain or an unresolved callee.
    calleeSignatureOf(CallExpressionNode call) -> Signature? {
        switch (call.callee()) {
            is IdentifierExpressionNode identifier -> {
                return this.result.callableOf(identifier.green());
            },
            is MemberExpressionNode member -> {
                let method = this.result.methodOf(member.green());
                if (method != null) {
                    if (method.isConstructor()) {
                        return null;
                    }
                    return method.signature();
                }
                return this.result.callableOf(member.green());
            },
            is SafeMemberExpressionNode member -> {
                let method = this.result.methodOf(member.green());
                if (method != null && !method.isConstructor()) {
                    return method.signature();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // Catch clauses scope against the parameter scope, so body locals stay invisible. The
    // caught-type rules belong to the exception milestone; here the binding resolves and the
    // body walks like any other.
    checkCatchClause(CatchClauseNode clause) {
        this.scope = new Scope(this.parameterScope);
        Type caught = this.resolver.resolveType(clause.caughtType());
        let binding = new LocalBinding(clause.name().text(), caught, BindingKind.Variable,
            false, clause.name().span());
        let owner = this.scope;
        if (owner != null) {
            owner.define(binding);
        }
        this.result.setBinding(clause.green(), binding);
        this.inCatchClause = true;
        // The catch body runs on the exception path, where the try body may have thrown before
        // assigning any local or field, so only the caught variable and the fields assigned
        // before the body (the this-field parameters) carry in as definitely assigned. What may
        // be assigned is the opposite union: everything written before any point the body could
        // have thrown from.
        this.assignedLocals = new List<LocalBinding>();
        this.assignedThisFields = this.copyFields(this.ctorSeededThisFields);
        this.maybeAssignedThisFields = this.copyFields(this.ctorSeededThisFields);
        for (long i = 0; i < this.ctorEscapedMaybeFields.length(); i++) {
            let escaped = this.ctorEscapedMaybeFields.get(i);
            if (!this.fieldsContain(this.maybeAssignedThisFields, escaped)) {
                this.maybeAssignedThisFields.push(escaped);
            }
        }
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.trackLocal(binding, true);
        this.enterScope();
        this.walkBlock(clause.body());
        this.leaveScope();
        // A catch that falls through without rethrowing returns the object normally, so its
        // fields must be assigned there too.
        if (this.ctorFieldOwner != null) {
            this.checkConstructorFieldsAssigned(clause.catchKeyword().span());
        }
        this.inCatchClause = false;
        this.scope = this.parameterScope;
    }

    // Field defaults type against the declared field type. Every sibling field is in scope, not only
    // the ones declared earlier: which of them a default may name is one rule with one precise
    // message, and the checks phase owns it, so a default that names itself or a later field is typed
    // here without being reported a second time as an undefined name.
    checkFieldDefaults(DeclaredType owner, MemberListNode body) {
        let fields = types.fieldsOf(owner);
        this.parameterScope = null;
        this.scope = new Scope(null);
        this.narrowing = new NarrowingState();
        this.thisBinding = null;
        this.thisType = null;
        this.enclosingOwner = owner;
        this.inStaticMethod = false;
        this.currentReturnType = null;
        // Static const fields stay out on both sides: their initializers are compile-time
        // constants the constants phase evaluates, never expressions over sibling fields.
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode
                    && !members.fieldModifiers(member).declaresStatic) {
                let sink = this.scope;
                if (sink != null) {
                    sink.define(new LocalBinding(member.name().text(),
                        this.fieldTypeOrError(fields, member.name().text()), BindingKind.Variable,
                        false, member.name().span()));
                }
            }
        }
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode
                    && !members.fieldModifiers(member).declaresStatic) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    Type expected = this.fieldTypeOrError(fields, member.name().text());
                    let value = defaultValue.value();
                    Type actual = this.analyzeExpressionAdapt(value, expected);
                    if (!(expected is ErrorType) && !(actual is ErrorType)
                            && !convert.isAssignableStrict(expected, actual)) {
                        this.reporter.report("Default value for field '{member.name().text()}': "
                            + "expected '{types.display(expected)}', got "
                            + "'{types.display(actual)}'"
                            + "{this.valueAssignabilityHint(expected, actual, value)}",
                            value.span());
                    }
                }
            }
        }
        this.scope = null;
    }

    fieldTypeOrError(List<Field>? fields, string name) -> Type {
        let field = members.findField(fields, name);
        if (field != null) {
            return field.type();
        }
        return this.store.errorType();
    }

    // Parameter defaults type against the declared parameter type, at module scope: neither
    // the other parameters nor 'this' are visible inside a default.
    checkParameterDefaults(Signature signature, FunctionDeclarationNode node) {
        this.parameterScope = null;
        this.scope = new Scope(null);
        this.narrowing = new NarrowingState();
        this.thisBinding = null;
        this.thisType = null;
        this.currentReturnType = null;
        Parameter[] parameters = signature.parameters();
        let parameterList = node.parameters();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let parameterNode = parameterList.parameters(i);
            let defaultValue = parameterNode.defaultValue();
            if (defaultValue == null) {
                continue;
            }
            Type expected = this.store.errorType();
            if (i < parameters.length) {
                expected = parameters[i].type();
            }
            let value = defaultValue.value();
            Type actual = this.analyzeExpressionAdapt(value, expected);
            if (!(expected is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(expected, actual)) {
                this.reporter.report("Default value for parameter "
                    + "'{parameterNode.name().text()}': expected '{types.display(expected)}', "
                    + "got '{types.display(actual)}'"
                    + "{this.valueAssignabilityHint(expected, actual, value)}", value.span());
            }
        }
        this.scope = null;
    }

    // ---- Scopes and names ----

    enterScope() {
        this.scope = new Scope(this.scope);
        this.narrowing.push();
    }

    leaveScope() {
        let current = this.scope;
        if (current != null) {
            this.scope = current.parent();
        }
        this.narrowing.pop();
    }

    lookupBinding(string name) -> LocalBinding? {
        let current = this.scope;
        if (current == null) {
            return null;
        }
        let own = current.lookup(name);
        if (own != null) {
            return own;
        }
        return this.lookupCapture(name);
    }

    // Unqualified name resolution: local scopes innermost-first, then the module's functions,
    // then the file's imports, then the implicit exception base class.
    resolveName(string name) -> NameResolution? {
        let binding = this.lookupBinding(name);
        if (binding != null) {
            return new LocalName(binding);
        }
        let entries = this.context.functions().entriesNamed(name);
        if (entries != null && entries.length() > 0) {
            return new FunctionName(entries);
        }
        let imported = this.context.linkTable().binding(name);
        if (imported is ImportedType) {
            return new TypeName(imported.target());
        }
        if (imported is ImportedNamespace) {
            return new NamespaceName(imported.modulePath());
        }
        if (name == "Error") {
            let errorClass = this.resolver.errorClass();
            if (errorClass != null) {
                return new TypeName(errorClass);
            }
        }
        return null;
    }

    // ---- Narrowing ----

    // The storage path an expression names, or null when the expression is not a narrowable
    // location: a local or parameter, 'this', or such a root followed by field hops and
    // subscript hops with literal or plain-identifier indices. 'allowAnyIndex' admits every
    // other index form as an AnyIndex hop, for write-invalidation queries only.
    // A 'weak' field never joins a path: its value can become null whenever the referent
    // loses its last strong reference, so refusing it here keeps fact collection, proven-type
    // lookup, and invalidation agreeing that nothing is ever proven through one.
    buildNarrowingPath(Expression expression, bool allowAnyIndex,
                               bool byName = false) -> NarrowingPath? {
        let segments = new List<PathSegment>();
        let root = this.collectPathSegments(expression, allowAnyIndex, byName, segments);
        if (root == null) {
            return null;
        }
        return new NarrowingPath(root, segments);
    }

    // 'byName' resolves each root and identifier index by name against the current scope rather
    // than by the analyzed side table, for the loop-entry pre-clear whose body nodes are not yet
    // analyzed.
    collectPathSegments(Expression expression, bool allowAnyIndex, bool byName,
                                List<PathSegment> segments) -> LocalBinding? {
        Expression core = unwrapParentheses(expression);
        switch (core) {
            is IdentifierExpressionNode identifier -> {
                if (byName) {
                    return this.lookupBinding(identifier.name().text());
                }
                return this.result.bindingOf(identifier.green());
            },
            is ThisExpressionNode ignored -> {
                return this.thisBinding;
            },
            is MemberExpressionNode member -> {
                let root = this.collectPathSegments(member.object(), allowAnyIndex, byName,
                    segments);
                if (root == null) {
                    return null;
                }
                if (this.readsWeakField(member)) {
                    return null;
                }
                segments.push(narrow.fieldSegment(member.member().text()));
                return root;
            },
            is SubscriptExpressionNode subscript -> {
                let root = this.collectPathSegments(subscript.object(), allowAnyIndex, byName,
                    segments);
                if (root == null) {
                    return null;
                }
                if (!this.collectIndexSegment(subscript.index(), allowAnyIndex, byName, segments)) {
                    return null;
                }
                return root;
            },
            default -> {
                return null;
            },
        }
    }

    // Appends the subscript hop for an index expression; false rejects the whole path.
    collectIndexSegment(Expression index, bool allowAnyIndex, bool byName,
                                List<PathSegment> segments) -> bool {
        Expression core = unwrapParentheses(index);
        let literal = integerLiteralOf(core, true);
        if (literal != null) {
            let magnitude = literalvalues.integerMagnitude(literal.value().text());
            if (magnitude != null) {
                long value = magnitude as long;
                if (isNegativeLiteral(core)) {
                    value = 0 - value;
                }
                segments.push(narrow.literalIndexSegment(value));
                return true;
            }
        } else if (core is IdentifierExpressionNode) {
            LocalBinding? binding = null;
            if (byName) {
                binding = this.lookupBinding(core.name().text());
            } else {
                binding = this.result.bindingOf(core.green());
            }
            if (binding != null) {
                segments.push(narrow.bindingIndexSegment(binding));
                return true;
            }
        }
        if (allowAnyIndex) {
            segments.push(narrow.anyIndexSegment());
            return true;
        }
        return false;
    }

    // Whether the member access reads a 'weak' field. In by-name mode the object carries no
    // analyzed type yet, so this reads false there; that is harmless, because a weak path is
    // never stored and a pre-clear query over one has nothing to erase.
    readsWeakField(MemberExpressionNode member) -> bool {
        let objectType = this.result.typeOf(member.object().green());
        if (objectType == null) {
            return false;
        }
        let field = members.findField(types.fieldsOf(objectType), member.member().text());
        return field != null && field.isWeak();
    }

    // The weak-field explanation for a value that may be null, or null when the value does
    // not read a 'weak' field: why a null check on it cannot carry to the use, and the
    // strong-local copy that does.
    weakFieldGuidance(Expression value) -> string? {
        Expression core = unwrapParentheses(value);
        if (!(core is MemberExpressionNode)) {
            return null;
        }
        if (!this.readsWeakField(core)) {
            return null;
        }
        string name = core.member().text();
        string example = "let {name} = ...;";
        let receiver = simpleSpelling(core.object());
        if (receiver != null) {
            example = "let {name} = {receiver}.{name};";
        }
        return "'{name}' is a 'weak' field, so it can become null whenever the object it "
            + "refers to loses its last strong reference; a null check does not carry past "
            + "it. Copy it into a local first ('{example}') and check the local.";
    }

    // assignabilityHint with the mismatched value in hand: a possibly-null value read from a
    // 'weak' field gets the weak explanation instead of the plain check suggestion.
    valueAssignabilityHint(Type target, Type source, Expression? value) -> string {
        if (value != null && !(target is ErrorType) && !(target is OptionalType)
                && source is OptionalType
                && convert.isAssignableStrict(target, source.inner())) {
            let guidance = this.weakFieldGuidance(value);
            if (guidance != null) {
                return ". The value may be null here. {guidance}";
            }
        }
        return assignabilityHint(target, source);
    }

    // Recognizes 'x == null' and 'x != null' over a narrowable path whose analyzed type is
    // still optional. The equality analysis resets a fully-proven operand back to its declared
    // storage type, so a redundant re-check re-proves the same fact rather than widening it.
    detectNullCheck(Expression condition) -> NarrowingFact? {
        if (!(condition is BinaryExpressionNode)) {
            return null;
        }
        SyntaxKind operator = condition.operator().kind();
        if (operator != SyntaxKind.EqualsEquals && operator != SyntaxKind.NotEquals) {
            return null;
        }
        Expression left = unwrapParentheses(condition.left());
        Expression right = unwrapParentheses(condition.right());
        Expression? checked = null;
        if (isNullLiteral(right) && !isNullLiteral(left)) {
            checked = left;
        } else if (isNullLiteral(left) && !isNullLiteral(right)) {
            checked = right;
        }
        if (checked == null) {
            return null;
        }
        let checkedType = this.result.typeOf(checked.green());
        if (!(checkedType is OptionalType)) {
            return null;
        }
        let path = this.buildNarrowingPath(checked, false);
        if (path == null) {
            return null;
        }
        // One check strips one level, off the sharpest type proven for the path so far: a
        // re-check of a value already proven present at every level proves nothing new.
        Type presence = this.narrowing.provenType(path) ?? checkedType;
        if (!(presence is OptionalType)) {
            return null;
        }
        return new NarrowingFact(path, presence.inner(), operator == SyntaxKind.NotEquals);
    }

    // A type test proves its operand is the target exactly when the test succeeds, so the
    // fact carries only positive polarity: failing a bare 'is' proves nothing. A '!' around
    // the test flips the polarity in collectNarrowings.
    detectTypeTest(TypeTestExpressionNode test) -> NarrowingFact? {
        let testType = this.result.typeOf(test.green());
        if (testType == null || !convert.isBoolType(testType)) {
            return null;
        }
        let target = this.result.typeOf(test.target().green());
        if (target == null || target is OptionalType || !types.isClassLike(target)) {
            return null;
        }
        let path = this.buildNarrowingPath(test.value(), false);
        if (path == null) {
            return null;
        }
        return new NarrowingFact(path, target, true);
    }

    // The facts a condition proves on the side where it evaluated to 'conditionHolds':
    // negation flips the polarity, '&&' facts hold where the conjunction held, '||' facts
    // hold where the disjunction failed, and both descend into their operands.
    collectNarrowings(Expression condition, bool conditionHolds,
                              List<NarrowingFact> sink) {
        Expression core = unwrapParentheses(condition);
        if (core is PrefixExpressionNode
                && core.operator().kind() == SyntaxKind.Exclamation) {
            this.collectNarrowings(core.operand(), !conditionHolds, sink);
            return;
        }
        if (core is TypeTestExpressionNode) {
            let fact = this.detectTypeTest(core);
            if (fact != null && conditionHolds) {
                sink.push(fact);
            }
            return;
        }
        if (core is BinaryExpressionNode) {
            SyntaxKind operator = core.operator().kind();
            bool descend = (conditionHolds && operator == SyntaxKind.AmpersandAmpersand)
                || (!conditionHolds && operator == SyntaxKind.PipePipe);
            if (descend) {
                this.collectNarrowings(core.left(), conditionHolds, sink);
                this.collectNarrowings(core.right(), conditionHolds, sink);
                return;
            }
        }
        let fact = this.detectNullCheck(core);
        if (fact != null && fact.narrowsWhenTrue == conditionHolds) {
            sink.push(fact);
        }
    }

    applyFacts(List<NarrowingFact> facts) {
        for (long i = 0; i < facts.length(); i++) {
            this.narrowing.narrow(facts.get(i).path, facts.get(i).proven);
        }
    }

    walkBranch(BlockNode block, List<NarrowingFact> facts) {
        this.enterScope();
        this.applyFacts(facts);
        this.walkBlock(block);
        this.leaveScope();
    }

    // Walks a branch under the facts its condition proves and returns the narrowings that hold
    // at its end, captured before the branch scope is discarded.
    walkBranchCapture(BlockNode block, List<NarrowingFact> facts)
            -> Map<NarrowingPath, Type> {
        this.enterScope();
        this.applyFacts(facts);
        this.walkBlock(block);
        let captured = this.narrowing.flatten();
        this.leaveScope();
        return captured;
    }

    // The narrowings on the implicit path where a condition failed and no statements run: the
    // else side of an 'if' without an 'else', and the fall-through of a switch scrutinee.
    captureConditionBranch(List<NarrowingFact> facts) -> Map<NarrowingPath, Type> {
        this.enterScope();
        this.applyFacts(facts);
        let captured = this.narrowing.flatten();
        this.leaveScope();
        return captured;
    }

    // The proven type common to two branch end-states for one path: identity, or the wider of
    // two types related by assignability, or null when neither contains the other.
    unifyNarrowed(Type left, Type right) -> Type? {
        if (left == right) {
            return left;
        }
        if (convert.isAssignableStrict(left, right)) {
            return left;
        }
        if (convert.isAssignableStrict(right, left)) {
            return right;
        }
        return null;
    }

    // The intersection of the surviving branch end-states: a path keeps a proof only where every
    // survivor proves it, unified to the type they share.
    intersectNarrowings(List<Map<NarrowingPath, Type>> survivors)
            -> Map<NarrowingPath, Type> {
        let result = new Map<NarrowingPath, Type>();
        let first = survivors.get(0);
        for (let key in first.keys()) {
            let value = first.get(key);
            if (value != null) {
                result.set(key, value);
            }
        }
        for (long i = 1; i < survivors.length(); i++) {
            let other = survivors.get(i);
            let merged = new Map<NarrowingPath, Type>();
            for (let key in result.keys()) {
                let mine = result.get(key);
                let theirs = other.get(key);
                if (mine != null && theirs != null) {
                    let unified = this.unifyNarrowed(mine, theirs);
                    if (unified != null) {
                        merged.set(key, unified);
                    }
                }
            }
            result = merged;
        }
        return result;
    }

    // Whether a path's root binding is still nameable after the merge, so a proof on a binding
    // local to one branch does not leak out when that branch is the only survivor.
    pathRootInScope(NarrowingPath path) -> bool {
        let root = path.root();
        if (this.thisBinding != null && root == this.thisBinding) {
            return true;
        }
        let current = this.scope;
        if (current == null) {
            return false;
        }
        return current.lookup(root.name()) == root;
    }

    // Installs the intersection of the surviving branches as the narrowing after a merge: a path
    // stays narrowed only where every falling-through branch proves it, an entry proof a branch
    // dropped is dropped, and a proof a branch newly established is added.
    applyNarrowingJoin(Map<NarrowingPath, Type> entryFacts,
                               List<Map<NarrowingPath, Type>> survivors) {
        if (survivors.length() == 0) {
            return;
        }
        let joined = this.intersectNarrowings(survivors);
        for (let key in entryFacts.keys()) {
            if (joined.get(key) == null) {
                this.narrowing.clearPath(key);
            }
        }
        for (let key in joined.keys()) {
            let joinedType = joined.get(key);
            if (joinedType == null) {
                continue;
            }
            let entryType = entryFacts.get(key);
            if (entryType != null && entryType == joinedType) {
                continue;
            }
            if (!this.pathRootInScope(key)) {
                continue;
            }
            this.narrowing.clearPath(key);
            this.narrowing.narrow(key, joinedType);
        }
    }

    // ---- Definite assignment ----

    resetAssignmentFlow() {
        this.assignedLocals = new List<LocalBinding>();
        this.trackedLocals = new List<LocalBinding>();
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.flowTerminated = false;
        this.unconditionalPosition = true;
        this.assignmentTarget = null;
        this.ctorFieldOwner = null;
        this.assignedThisFields = new List<Field>();
        this.ctorSeededThisFields = new List<Field>();
        this.maybeAssignedThisFields = new List<Field>();
        this.ctorEscapedMaybeFields = new List<Field>();
    }

    bindingsContain(List<LocalBinding> set, LocalBinding binding) -> bool {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i) == binding) {
                return true;
            }
        }
        return false;
    }

    trackLocal(LocalBinding binding, bool assigned) {
        if (!this.bindingsContain(this.trackedLocals, binding)) {
            this.trackedLocals.push(binding);
        }
        if (assigned && !this.bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    markAssigned(LocalBinding binding) {
        if (this.flowTerminated) {
            return;
        }
        if (this.bindingsContain(this.trackedLocals, binding)
                && !this.bindingsContain(this.assignedLocals, binding)) {
            this.assignedLocals.push(binding);
        }
    }

    fieldsContain(List<Field> set, Field field) -> bool {
        for (long i = 0; i < set.length(); i++) {
            if (set.get(i) == field) {
                return true;
            }
        }
        return false;
    }

    copyFields(List<Field> set) -> List<Field> {
        let copy = new List<Field>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    // Records the this-field shorthand parameters as assigned before the body runs, so a
    // constructor whose only initialization is 'constructor(this.field)' starts complete. A
    // shorthand parameter is a write, so it also counts against a 'const' field's one
    // assignment, and it may not reach into a base class's const field at all.
    seedConstructorFields(Signature signature, Type receiver) {
        this.ctorFieldOwner = receiver;
        let fields = types.fieldsOf(receiver);
        if (fields == null) {
            return;
        }
        Parameter[] parameters = signature.parameters();
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            if (!parameter.bindsField()) {
                continue;
            }
            let field = members.findField(fields, parameter.name());
            if (field == null) {
                continue;
            }
            if (field.isConst() && field.definingType() != receiver) {
                this.reporter.report("Parameter 'this.{field.name()}' assigns field "
                    + "'{field.name()}', but '{field.name()}' is 'const' and declared in base "
                    + "class '{this.constFieldOwnerName(field)}', so only a constructor of "
                    + "'{this.constFieldOwnerName(field)}' can assign it. Take an ordinary "
                    + "parameter and pass it along in the 'super(...)' call instead.",
                    parameter.span());
            }
            if (!this.fieldsContain(this.assignedThisFields, field)) {
                this.assignedThisFields.push(field);
            }
        }
        this.ctorSeededThisFields = this.copyFields(this.assignedThisFields);
        this.maybeAssignedThisFields = this.copyFields(this.assignedThisFields);
    }

    markThisFieldAssigned(Field field) {
        if (this.flowTerminated || this.ctorFieldOwner == null) {
            return;
        }
        if (!this.fieldsContain(this.assignedThisFields, field)) {
            this.assignedThisFields.push(field);
        }
    }

    markThisFieldMaybeAssigned(Field field) {
        if (this.flowTerminated || this.ctorFieldOwner == null) {
            return;
        }
        if (!this.fieldsContain(this.maybeAssignedThisFields, field)) {
            this.maybeAssignedThisFields.push(field);
        }
    }

    // Called where an exception can leave the constructor body: whatever may be assigned here
    // may be assigned when a catch clause starts. A throw inside a catch clause leaves the
    // constructor altogether, so it feeds no other clause's entry state.
    noteThrowEscapePoint() {
        if (this.flowTerminated || this.ctorFieldOwner == null || this.inCatchClause) {
            return;
        }
        for (long i = 0; i < this.maybeAssignedThisFields.length(); i++) {
            let field = this.maybeAssignedThisFields.get(i);
            if (!this.fieldsContain(this.ctorEscapedMaybeFields, field)) {
                this.ctorEscapedMaybeFields.push(field);
            }
        }
    }

    // The name a diagnostic about a field's declaring type should use.
    constFieldOwnerName(Field field) -> string {
        let authority = types.authorityOf(field.definingType());
        if (authority != null) {
            return authority.name();
        }
        return types.display(field.definingType());
    }

    // Reports every own field left unassigned on the path reaching span when the field needed
    // an assignment - a non-defaultable one, or a 'const' one without a default - and credits
    // them so the same field is not reported twice.
    checkConstructorFieldsAssigned(Span span) {
        let owner = this.ctorFieldOwner;
        if (owner == null || this.flowTerminated) {
            return;
        }
        let fields = types.fieldsOf(owner);
        if (fields == null) {
            return;
        }
        let missing = new List<Field>();
        let missingConst = new List<Field>();
        for (long i = types.baseFieldCount(owner); i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.type() is ErrorType) {
                continue;
            }
            if (field.hasDefault()) {
                continue;
            }
            if (this.fieldsContain(this.assignedThisFields, field)) {
                continue;
            }
            if (field.isConst()) {
                missingConst.push(field);
            } else if (!convert.isDefaultable(field.type())) {
                missing.push(field);
            }
        }
        string owningName = types.display(owner);
        string kindWord = "class";
        let authority = types.authorityOf(owner);
        if (authority != null) {
            owningName = authority.name();
            kindWord = types.kindWordOf(authority);
        }
        if (missing.length() > 0) {
            this.reporter.report(fieldListSubject(missing) + " of {kindWord} '{owningName}' "
                + fieldListVerb(missing) + " not assigned on every path through this "
                + "constructor. A non-nullable field must be assigned before the constructor "
                + "returns; assign it on every path, for example "
                + "'this.{missing.get(0).name()} = ...;'.", span);
        }
        if (missingConst.length() > 0) {
            this.reporter.report(fieldListSubject(missingConst) + " of {kindWord} "
                + "'{owningName}' " + fieldListVerb(missingConst) + " not assigned on every "
                + "path through this constructor. A 'const' field without a default value must "
                + "be assigned exactly once before the constructor returns; assign it on every "
                + "path, for example 'this.{missingConst.get(0).name()} = ...;'.", span);
        }
        for (long i = 0; i < missing.length(); i++) {
            this.assignedThisFields.push(missing.get(i));
        }
        for (long i = 0; i < missingConst.length(); i++) {
            this.assignedThisFields.push(missingConst.get(i));
        }
    }

    checkDefiniteAssignment(LocalBinding binding, Span span) {
        if (this.flowTerminated) {
            return;
        }
        let target = this.assignmentTarget;
        if (target != null && target == binding) {
            return;
        }
        if (!this.bindingsContain(this.trackedLocals, binding)
                || this.bindingsContain(this.assignedLocals, binding)) {
            return;
        }
        this.reporter.report("Variable '{binding.name()}' is used before it is assigned a "
            + "value. Assign it on every path that reaches this point first, for example "
            + "'{binding.name()} = ...;'.", span);
        this.assignedLocals.push(binding);
    }

    copyBindings(List<LocalBinding> set) -> List<LocalBinding> {
        let copy = new List<LocalBinding>();
        for (long i = 0; i < set.length(); i++) {
            copy.push(set.get(i));
        }
        return copy;
    }

    snapshotAssignment() -> AssignmentFlow {
        return new AssignmentFlow(this.copyBindings(this.assignedLocals),
            this.copyFields(this.assignedThisFields),
            this.copyFields(this.maybeAssignedThisFields), this.flowTerminated);
    }

    restoreAssignment(AssignmentFlow flow) {
        this.assignedLocals = this.copyBindings(flow.assigned);
        this.assignedThisFields = this.copyFields(flow.assignedFields);
        this.maybeAssignedThisFields = this.copyFields(flow.maybeAssignedFields);
        this.flowTerminated = flow.terminated;
    }

    unionFieldsInto(List<Field> target, List<Field> source) {
        for (long i = 0; i < source.length(); i++) {
            if (!this.fieldsContain(target, source.get(i))) {
                target.push(source.get(i));
            }
        }
    }

    // The join of several branch out-states: a local or field is definitely assigned after the
    // join only when it is assigned on every branch that can fall through, and may be assigned
    // when any falling-through branch may have assigned it. A terminated branch cannot reach the
    // join, so it drops out. When every branch terminates the join is unreachable, so it stays
    // terminated and credits every branch's writes to avoid reports in the dead code that follows.
    joinAssignment(List<AssignmentFlow> flows) -> AssignmentFlow {
        let result = new List<LocalBinding>();
        let resultFields = new List<Field>();
        let resultMaybeFields = new List<Field>();
        bool anySurvivor = false;
        for (long i = 0; i < flows.length(); i++) {
            let flow = flows.get(i);
            if (flow.terminated) {
                continue;
            }
            this.unionFieldsInto(resultMaybeFields, flow.maybeAssignedFields);
            if (!anySurvivor) {
                result = this.copyBindings(flow.assigned);
                resultFields = this.copyFields(flow.assignedFields);
                anySurvivor = true;
            } else {
                let both = new List<LocalBinding>();
                for (long j = 0; j < result.length(); j++) {
                    if (this.bindingsContain(flow.assigned, result.get(j))) {
                        both.push(result.get(j));
                    }
                }
                result = both;
                let bothFields = new List<Field>();
                for (long j = 0; j < resultFields.length(); j++) {
                    if (this.fieldsContain(flow.assignedFields, resultFields.get(j))) {
                        bothFields.push(resultFields.get(j));
                    }
                }
                resultFields = bothFields;
            }
        }
        if (!anySurvivor) {
            for (long i = 0; i < flows.length(); i++) {
                let flow = flows.get(i);
                for (long j = 0; j < flow.assigned.length(); j++) {
                    if (!this.bindingsContain(result, flow.assigned.get(j))) {
                        result.push(flow.assigned.get(j));
                    }
                }
                for (long j = 0; j < flow.assignedFields.length(); j++) {
                    if (!this.fieldsContain(resultFields, flow.assignedFields.get(j))) {
                        resultFields.push(flow.assignedFields.get(j));
                    }
                }
                this.unionFieldsInto(resultMaybeFields, flow.maybeAssignedFields);
            }
        }
        return new AssignmentFlow(result, resultFields, resultMaybeFields, !anySurvivor);
    }

    conditionIsAlwaysTrue(Expression condition) -> bool {
        if (condition is LiteralExpressionNode) {
            return condition.value().kind() == SyntaxKind.TrueKeyword;
        }
        return false;
    }

    // Sets the assignment state after a loop to the join of every way it can exit normally. When
    // nothing can exit, the loop runs forever and the code after it is unreachable.
    finishLoop(List<AssignmentFlow> exits) {
        if (exits.length() == 0) {
            this.flowTerminated = true;
        } else {
            this.restoreAssignment(this.joinAssignment(exits));
        }
    }

    // Analyzes a branch expression under the facts the condition proves on its side: a
    // ternary branch, or the right operand of a short-circuit operator. A target is the type the
    // branch's value has to answer to, and is null where the branch answers to nothing.
    analyzeGuardedBranch(Expression condition, Expression branch, bool conditionHolds,
                                 Type? target) -> Type {
        let facts = new List<NarrowingFact>();
        this.collectNarrowings(condition, conditionHolds, facts);
        this.narrowing.push();
        this.applyFacts(facts);
        bool previous = this.unconditionalPosition;
        this.unconditionalPosition = false;
        Type analyzed = this.store.errorType();
        if (target != null) {
            analyzed = this.analyzeExpressionAdapt(branch, target);
        } else {
            analyzed = this.analyzeExpression(branch);
        }
        this.unconditionalPosition = previous;
        this.narrowing.pop();
        return analyzed;
    }

    // The declared type of the storage an expression reads, or null when it reads no single
    // declared slot: the binding's, 'this's, field's, or array element's own type.
    declaredSlotType(Expression expression) -> Type? {
        Expression core = unwrapParentheses(expression);
        switch (core) {
            is IdentifierExpressionNode identifier -> {
                let binding = this.result.bindingOf(identifier.green());
                if (binding == null) {
                    return null;
                }
                return binding.type();
            },
            is ThisExpressionNode ignored -> {
                return this.thisType;
            },
            is MemberExpressionNode member -> {
                let objectType = this.result.typeOf(member.object().green());
                if (objectType == null) {
                    return null;
                }
                let field = members.findField(types.fieldsOf(objectType),
                    member.member().text());
                if (field == null) {
                    return null;
                }
                return field.type();
            },
            is SubscriptExpressionNode subscript -> {
                let objectType = this.result.typeOf(subscript.object().green());
                if (objectType is ArrayType) {
                    return objectType.element();
                }
                return null;
            },
            default -> {
                return null;
            },
        }
    }

    // A presence operator ('== null', '!= null', '??', '?.', '?[') consults the declared
    // storage type, so a re-check of a proven-non-null declared-optional stays legal; the
    // operand is retyped back to the declared type, and a declared non-optional keeps its
    // analyzed type and is rejected by the operator's own rule.
    //
    // A value still nullable after narrowing needs nothing restored: the operator asks about
    // the level it has now, which for a doubly-nullable path already proven present at its
    // outer level is the inner one.
    presenceOperandType(Expression operand, Type analyzed) -> Type {
        if (analyzed is OptionalType) {
            return analyzed;
        }
        let declared = this.declaredSlotType(operand);
        if (declared == null || !(declared is OptionalType) || declared == analyzed) {
            return analyzed;
        }
        Expression current = operand;
        this.result.setType(current.green(), declared);
        while (current is ParenthesizedExpressionNode) {
            current = current.inner();
            this.result.setType(current.green(), declared);
        }
        return declared;
    }

    // Assigning a value to a binding of optional declared type narrows the binding to the
    // deepest level the value's own static type proves present: a bare value proves every
    // wrapped level, a 'T?' assigned to a 'T??' proves the outer one. Declaration initializers
    // come through here too.
    establishAssignmentNarrowing(LocalBinding binding, Type value) {
        let declared = binding.type();
        if (!(declared is OptionalType)) {
            return;
        }
        if (value is ErrorType || value is NullType) {
            return;
        }
        Type proven = declared;
        while (proven is OptionalType && convert.isAssignableStrict(proven.inner(), value)) {
            proven = proven.inner();
        }
        if (proven == declared) {
            return;
        }
        this.narrowing.narrow(narrow.bindingPath(binding), proven);
    }

    // A write into the storage an expression names drops every narrowing the write could
    // reach: the whole root for a binding write (and every path indexed through it), and the
    // may-alias cone for a member or subscript write.
    invalidateForWrite(Expression target) {
        if (target is IdentifierExpressionNode) {
            let binding = this.result.bindingOf(target.green());
            if (binding != null) {
                this.narrowing.clearForRoot(binding);
                this.narrowing.clearForIndexBinding(binding);
                return;
            }
        }
        if (target is MemberExpressionNode || target is SubscriptExpressionNode) {
            let path = this.buildNarrowingPath(target, true);
            if (path != null) {
                this.narrowing.clearMayAlias(path);
            }
        }
    }

    // A call drops every member-path narrowing rooted at a value it touches - the receiver
    // and each class or array argument - since the callee may mutate the state reachable from
    // them. A plain binding's own narrowing survives: no callee can reassign the caller's
    // binding, and the binding's reference keeps the narrowed object alive.
    clearNarrowingsForCall(CallExpressionNode node) {
        switch (node.callee()) {
            is MemberExpressionNode member -> {
                this.dropTouchedByCall(member.object());
            },
            is SafeMemberExpressionNode member -> {
                this.dropTouchedByCall(member.object());
            },
            default -> { },
        }
        this.clearNarrowingsForArguments(node.arguments());
    }

    // Only class or array references expose mutable state; struct and primitive arguments are
    // passed by value, so the call cannot mutate through them. A constructor call ('new T(...)')
    // reaches its arguments the same way, so both a call and a 'new' route through here.
    clearNarrowingsForArguments(ArgumentListNode? arguments) {
        if (arguments == null) {
            return;
        }
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            Expression? value = null;
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    value = named.value();
                },
                is OutArgumentNode ignored -> { },
                is Expression plain -> {
                    value = plain;
                },
                default -> { },
            }
            if (value == null) {
                continue;
            }
            let argumentType = this.result.typeOf(value.green());
            if (argumentType == null) {
                continue;
            }
            Type core = convert.coreOf(argumentType);
            if (types.isClassLike(core) || core is ArrayType) {
                this.dropTouchedByCall(value);
            }
        }
    }

    dropTouchedByCall(Expression touched) {
        let path = this.buildNarrowingPath(touched, false);
        if (path == null) {
            return;
        }
        this.narrowing.clearForRootMembers(path.root());
    }

    // Loop-entry pre-clearing: before the loop body is analyzed, drop every narrowing whose
    // storage the body may write, so a fact a later body write kills cannot be read stale on a
    // following iteration. The condition re-establishes its own narrowing each iteration, so a
    // condition-derived fact is not pre-cleared. Roots resolve by name against the current scope,
    // since the body nodes are not analyzed yet.
    preClearLoopBodyWrites(SyntaxNode node) {
        switch (node) {
            is AssignmentExpressionNode assignment -> {
                this.preClearWrite(assignment.target());
            },
            is PrefixExpressionNode prefix -> {
                let operator = prefix.operator().kind();
                if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
                    this.preClearWrite(prefix.operand());
                }
            },
            is PostfixExpressionNode postfix -> {
                let operator = postfix.operator().kind();
                if (operator == SyntaxKind.PlusPlus || operator == SyntaxKind.MinusMinus) {
                    this.preClearWrite(postfix.operand());
                }
            },
            is OutArgumentNode outArgument -> {
                let binding = this.lookupBinding(outArgument.name().text());
                if (binding != null) {
                    this.narrowing.clearForRoot(binding);
                    this.narrowing.clearForIndexBinding(binding);
                }
            },
            is CallExpressionNode call -> {
                switch (call.callee()) {
                    is MemberExpressionNode member -> {
                        this.preClearTouch(member.object());
                    },
                    is SafeMemberExpressionNode member -> {
                        this.preClearTouch(member.object());
                    },
                    default -> { },
                }
                this.preClearTouchedArguments(call.arguments());
            },
            is NewExpressionNode created -> {
                this.preClearTouchedArguments(created.arguments());
            },
            default -> { },
        }
        for (let child in node.childNodes()) {
            this.preClearLoopBodyWrites(child);
        }
    }

    preClearTouchedArguments(ArgumentListNode? arguments) {
        if (arguments == null) {
            return;
        }
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.preClearTouch(named.value());
                },
                is OutArgumentNode ignored -> { },
                is Expression plain -> {
                    this.preClearTouch(plain);
                },
                default -> { },
            }
        }
    }

    preClearWrite(Expression target) {
        if (target is IdentifierExpressionNode) {
            let binding = this.lookupBinding(target.name().text());
            if (binding != null) {
                this.narrowing.clearForRoot(binding);
                this.narrowing.clearForIndexBinding(binding);
            }
            return;
        }
        if (target is MemberExpressionNode || target is SubscriptExpressionNode) {
            let path = this.buildNarrowingPath(target, true, true);
            if (path != null) {
                this.narrowing.clearMayAlias(path);
            }
        }
    }

    preClearTouch(Expression value) {
        let path = this.buildNarrowingPath(value, false, true);
        if (path != null) {
            this.narrowing.clearForRootMembers(path.root());
        }
    }

    // ---- Statements ----

    walkBlock(BlockNode block) {
        for (long i = 0; i < block.statementsCount(); i++) {
            this.noteArrayFillLoop(block, i);
            this.walkStatement(block.statements(i));
        }
    }

    walkScopedBlock(BlockNode block) {
        this.enterScope();
        this.walkBlock(block);
        this.leaveScope();
    }

    walkStatement(Statement statement) {
        switch (statement) {
            is BlockNode block -> {
                this.walkScopedBlock(block);
            },
            is VariableDeclarationNode declaration -> {
                this.checkVariableDeclaration(declaration);
            },
            is IfStatementNode conditional -> {
                this.checkIfStatement(conditional);
            },
            is WhileStatementNode loop -> {
                this.checkWhileStatement(loop);
            },
            is ForStatementNode loop -> {
                this.checkForStatement(loop);
            },
            is ForEachStatementNode loop -> {
                this.checkForEachStatement(loop);
            },
            is BreakStatementNode broken -> {
                if (this.loopDepth == 0) {
                    this.reporter.report("'break' can only be used inside a loop.",
                        broken.span());
                }
                if (!this.flowTerminated && this.breakFlows.length() > 0) {
                    this.breakFlows.get(this.breakFlows.length() - 1)
                        .push(this.snapshotAssignment());
                }
                this.flowTerminated = true;
            },
            is ContinueStatementNode continued -> {
                if (this.loopDepth == 0) {
                    this.reporter.report("'continue' can only be used inside a loop.",
                        continued.span());
                }
                this.flowTerminated = true;
            },
            is ReturnStatementNode returned -> {
                if (this.ctorFieldOwner != null) {
                    this.checkConstructorFieldsAssigned(returned.returnKeyword().span());
                }
                this.checkReturnStatement(returned);
                this.flowTerminated = true;
            },
            is ExpressionStatementNode expression -> {
                this.unconditionalPosition = true;
                this.analyzeExpression(expression.expression());
                if (this.callNeverReturns(expression.expression())) {
                    this.flowTerminated = true;
                }
            },
            is ThrowStatementNode thrown -> {
                this.checkThrowStatement(thrown);
                this.noteThrowEscapePoint();
                this.flowTerminated = true;
            },
            is RethrowStatementNode rethrown -> {
                if (!this.inCatchClause) {
                    this.reporter.report("'rethrow' can only be used inside a 'catch' block.",
                        rethrown.span());
                }
                this.flowTerminated = true;
            },
            is SwitchStatementNode switched -> {
                this.checkSwitchArms(switched.scrutinee(), armsOfStatement(switched),
                    switched.switchKeyword().span(), false, null);
            },
            default -> { },
        }
    }

    checkVariableDeclaration(VariableDeclarationNode node) {
        string name = node.name().text();
        bool isConst = false;
        let modifier = node.modifier();
        if (modifier != null && modifier.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let declaredType = node.declaredType();
        Type bindingType = this.store.errorType();
        if (declaredType == null) {
            bindingType = this.checkInferredDeclaration(node, name);
        } else {
            bindingType = this.checkTypedDeclaration(node, name, declaredType, isConst);
        }
        let binding = new LocalBinding(name, bindingType, BindingKind.Variable, isConst,
            node.name().span());
        this.defineLocal(binding, node.name().span());
        this.result.setBinding(node.green(), binding);
        let initializer = node.initializer();
        this.trackLocal(binding, initializer != null);
        if (initializer != null) {
            let initType = this.result.typeOf(initializer.value().green());
            if (initType != null) {
                this.establishAssignmentNarrowing(binding, initType);
            }
        }
    }

    checkInferredDeclaration(VariableDeclarationNode node, string name) -> Type {
        let initializer = node.initializer();
        if (initializer == null) {
            this.reporter.report("Variable '{name}' has no declared type, so it needs an "
                + "initializer to infer it from; write 'let {name} = ...;' or declare an "
                + "explicit type.", node.name().span());
            return this.store.errorType();
        }
        Type initType = this.analyzeExpression(initializer.value());
        if (initType is NullType) {
            this.reporter.report("Cannot infer type from 'null' alone - declare the variable "
                + "with an explicit type, e.g. 'T? {name} = null;'", node.name().span());
            return this.store.errorType();
        }
        return initType;
    }

    checkTypedDeclaration(VariableDeclarationNode node, string name,
                                  nodes.Type declaredType, bool isConst) -> Type {
        Type declared = this.resolver.resolveType(declaredType);
        if (types.isVoidType(declared)) {
            this.reporter.report("A variable cannot have type 'void'; 'void' means no value.",
                declaredType.span());
            declared = this.store.errorType();
        }
        let initializer = node.initializer();
        if (initializer != null) {
            Type initType = this.analyzeExpressionAdapt(initializer.value(), declared);
            if (!(declared is ErrorType) && !(initType is ErrorType)
                    && !convert.isAssignableStrict(declared, initType)) {
                this.reporter.report("Cannot assign value of type '{types.display(initType)}' "
                    + "to variable of type '{types.display(declared)}'"
                    + "{this.valueAssignabilityHint(declared, initType, initializer.value())}",
                    initializer.value().span());
            }
            return declared;
        }
        if (isConst && !(declared is ErrorType)) {
            this.reporter.report("Constant '{name}' must be given its value where it is "
                + "declared; write '= ...' after the name.", node.name().span());
            return declared;
        }
        return declared;
    }

    // A local may shadow anything except a sibling local or, at the body's top level, a
    // parameter of the enclosing callable.
    defineLocal(LocalBinding binding, Span span) {
        let current = this.scope;
        if (current == null) {
            return;
        }
        bool collides = !current.define(binding);
        let parameters = this.parameterScope;
        if (!collides && parameters != null && current.parent() == parameters
                && parameters.lookupLocal(binding.name()) != null) {
            collides = true;
        }
        if (collides) {
            this.reporter.report("Variable '{binding.name()}' is already defined in this "
                + "scope; rename one of them.", span);
        }
    }

    // The narrowing after an 'if' is the intersection of the facts holding at the end of each
    // branch that can fall through; a terminated branch contributes nothing, so the surviving
    // branch's facts pass through unchanged. This subsumes the single-terminating-branch carry:
    // 'if (x == null) { return; }' leaves the else facts, and 'if (x == null) { x = f(); }'
    // narrows x below because the reassigned then-branch and the failed-check else both prove it.
    checkIfStatement(IfStatementNode node) {
        Type condition = this.analyzeExpression(node.condition());
        this.checkConditionIsBool(condition, "If condition", node.condition().span());
        let whenTrue = new List<NarrowingFact>();
        let whenFalse = new List<NarrowingFact>();
        this.collectNarrowings(node.condition(), true, whenTrue);
        this.collectNarrowings(node.condition(), false, whenFalse);

        let entryAssign = this.snapshotAssignment();
        let entryLayers = this.narrowing.snapshotLayers();
        let entryFacts = this.narrowing.flatten();

        let thenFacts = this.walkBranchCapture(node.thenBranch(), whenTrue);
        let afterThen = this.snapshotAssignment();
        this.restoreAssignment(entryAssign);
        this.narrowing.restoreLayers(entryLayers);

        Map<NarrowingPath, Type> elseFacts;
        let afterElse = entryAssign;
        let elseClause = node.elseClause();
        if (elseClause == null) {
            elseFacts = this.captureConditionBranch(whenFalse);
        } else {
            switch (elseClause.body()) {
                is BlockNode block -> {
                    elseFacts = this.walkBranchCapture(block, whenFalse);
                    afterElse = this.snapshotAssignment();
                },
                is IfStatementNode chained -> {
                    // An 'else if' is reached only when this condition failed, so the chained
                    // 'if' is checked under the negated facts exactly as an else block is.
                    this.enterScope();
                    this.applyFacts(whenFalse);
                    this.checkIfStatement(chained);
                    elseFacts = this.narrowing.flatten();
                    afterElse = this.snapshotAssignment();
                    this.leaveScope();
                },
                default -> {
                    elseFacts = this.captureConditionBranch(whenFalse);
                },
            }
        }
        this.restoreAssignment(entryAssign);
        this.narrowing.restoreLayers(entryLayers);

        let flows = new List<AssignmentFlow>();
        flows.push(afterThen);
        flows.push(afterElse);
        this.restoreAssignment(this.joinAssignment(flows));

        let survivors = new List<Map<NarrowingPath, Type>>();
        if (!afterThen.terminated) {
            survivors.push(thenFacts);
        }
        if (!afterElse.terminated) {
            survivors.push(elseFacts);
        }
        this.applyNarrowingJoin(entryFacts, survivors);
    }

    // The condition is rechecked every iteration and body writes drop narrowing at their own
    // point, so condition narrowing is safe in the body.
    checkWhileStatement(WhileStatementNode node) {
        this.preClearLoopBodyWrites(node.body());
        // The condition re-evaluates every iteration, so writes in it count as loop writes.
        this.loopDepth++;
        Type condition = this.analyzeExpression(node.condition());
        this.loopDepth--;
        this.checkConditionIsBool(condition, "While condition", node.condition().span());
        let facts = new List<NarrowingFact>();
        this.collectNarrowings(node.condition(), true, facts);
        bool alwaysTrue = this.conditionIsAlwaysTrue(node.condition());
        let postCondition = this.snapshotAssignment();
        this.breakFlows.push(new List<AssignmentFlow>());
        this.loopDepth++;
        this.walkBranch(node.body(), facts);
        this.loopDepth--;
        let exits = this.breakFlows.pop();
        if (!alwaysTrue) {
            exits.push(postCondition);
        }
        this.finishLoop(exits);
    }

    checkForStatement(ForStatementNode node) {
        this.enterScope();
        let initializer = node.initializer();
        if (initializer != null) {
            switch (initializer) {
                is VariableDeclarationNode declaration -> {
                    this.checkVariableDeclaration(declaration);
                },
                is ExpressionStatementNode expression -> {
                    this.analyzeExpression(expression.expression());
                },
                default -> { },
            }
        }
        this.preClearLoopBodyWrites(node.body());
        let update = node.update();
        if (update != null) {
            this.preClearLoopBodyWrites(update);
        }
        let facts = new List<NarrowingFact>();
        let condition = node.condition();
        bool alwaysTrue = false;
        if (condition != null) {
            // The condition re-evaluates every iteration, so writes in it count as loop writes.
            this.loopDepth++;
            Type conditionType = this.analyzeExpression(condition);
            this.loopDepth--;
            this.checkConditionIsBool(conditionType, "For condition", condition.span());
            this.collectNarrowings(condition, true, facts);
            alwaysTrue = this.conditionIsAlwaysTrue(condition);
        }
        let postCondition = this.snapshotAssignment();
        this.breakFlows.push(new List<AssignmentFlow>());
        this.loopDepth++;
        this.enterScope();
        this.applyFacts(facts);
        this.walkBlock(node.body());
        if (update != null) {
            this.unconditionalPosition = true;
            this.analyzeExpression(update);
        }
        this.leaveScope();
        this.loopDepth--;
        let exits = this.breakFlows.pop();
        if (condition != null && !alwaysTrue) {
            exits.push(postCondition);
        }
        this.finishLoop(exits);
        this.leaveScope();
    }

    // The loop needs an array or a value whose class implements 'Iterable<T>', proven
    // non-null; the element binding takes its annotated type when one is written and the
    // element type otherwise.
    checkForEachStatement(ForEachStatementNode node) {
        this.enterScope();
        Type iterable = this.analyzeExpression(node.iterable());
        Type element = this.store.errorType();
        if (!(iterable is ErrorType)) {
            if (iterable is OptionalType && iterable.inner() is OptionalType) {
                this.reporter.report("'for (... in ...)' cannot iterate "
                    + "'{types.display(iterable)}' because it may be null at more than one "
                    + "level. Unwrap one level at a time, with a null check "
                    + "('if (value != null)') or a fallback ('value ?? null'), until what "
                    + "remains is '{types.display(convert.coreOf(iterable))}'.",
                    node.iterable().span());
            } else if (iterable is OptionalType) {
                this.reporter.report("'for (... in ...)' cannot iterate "
                    + "'{types.display(iterable)}' because it may be null. Check it for null "
                    + "first ('if (value != null)'), or supply a fallback with '??'.",
                    node.iterable().span());
            } else if (iterable is ArrayType) {
                element = iterable.element();
            } else if (types.isClassLike(iterable)) {
                element = this.iterableElementType(iterable, node.iterable().span());
            } else if (iterable is StringType) {
                this.reporter.report("'for (... in ...)' cannot iterate a 'string': text is not "
                    + "a sequence of its own, so a walk over it says which view it reads. "
                    + "Iterate 'text.toBytes()' to visit the bytes.", node.iterable().span());
            } else {
                this.reporter.report("'for (... in ...)' requires an array or an iterable "
                    + "object, got '{types.display(iterable)}'. A class is iterable when it "
                    + "implements 'Iterable<T>' from '@std.collections.iterator'.",
                    node.iterable().span());
            }
        }
        Type bindingType = element;
        let declaredType = node.declaredType();
        if (declaredType != null) {
            Type declared = this.resolver.resolveType(declaredType);
            if (!(declared is ErrorType) && !(element is ErrorType)
                    && !convert.isAssignableStrict(declared, element)) {
                this.reporter.report("Loop variable of type '{types.display(declared)}' cannot "
                    + "hold the '{types.display(element)}' values this sequence yields. Declare "
                    + "it as '{types.display(element)}' or a type '{types.display(element)}' fits "
                    + "into.", declaredType.span());
            }
            bindingType = declared;
        }
        bool isConst = false;
        let keyword = node.letKeyword();
        if (keyword != null && keyword.kind() == SyntaxKind.ConstKeyword) {
            isConst = true;
        }
        let binding = new LocalBinding(node.name().text(), bindingType, BindingKind.Variable,
            isConst, node.name().span());
        let current = this.scope;
        if (current != null) {
            current.define(binding);
        }
        this.result.setBinding(node.green(), binding);
        let entry = this.snapshotAssignment();
        this.trackLocal(binding, true);
        this.breakFlows.push(new List<AssignmentFlow>());
        this.loopDepth++;
        this.preClearLoopBodyWrites(node.body());
        this.walkScopedBlock(node.body());
        this.loopDepth--;
        let exits = this.breakFlows.pop();
        exits.push(entry);
        this.finishLoop(exits);
        this.leaveScope();
    }

    // The element type a class value yields in a for-in loop. Iteration is nominal: the class
    // (or a base class) must implement 'Iterable<T>' from '@std.collections.iterator', directly
    // or through an interface extending it, and a value whose own type is 'Iterable<T>' or a
    // sub-interface of it iterates too.
    iterableElementType(Type core, Span span) -> Type {
        Type? current = core;
        let seen = new Set<Type>();
        while (current != null && seen.add(current)) {
            let direct = iterableArgument(current);
            if (direct != null) {
                return direct;
            }
            for (let implemented in types.interfacesOf(current)) {
                for (let level in types.interfaceLadderOf(implemented)) {
                    let found = iterableArgument(level);
                    if (found != null) {
                        return found;
                    }
                }
            }
            current = types.baseOf(current);
        }
        this.reporter.report("'{types.display(core)}' is not iterable: it does not implement "
            + "'Iterable' from '@std.collections.iterator'. Declare 'implements Iterable<T>' "
            + "and provide 'makeIterator() -> Iterator<T>' to use it in a for-in loop.", span);
        return this.store.errorType();
    }

    checkReturnStatement(ReturnStatementNode node) {
        if (this.currentNoreturn) {
            this.reporter.report("A 'noreturn' function cannot use 'return'; it never returns "
                + "normally. Throw, call 'panic', or call another 'noreturn' function instead.",
                node.returnKeyword().span());
            let returned = node.value();
            if (returned != null) {
                this.analyzeExpression(returned);
            }
            return;
        }
        let expected = this.currentReturnType;
        if (expected == null) {
            this.reporter.report("'return' can only be used inside a function body.",
                node.returnKeyword().span());
            let ignored = node.value();
            if (ignored != null) {
                this.analyzeExpression(ignored);
            }
            return;
        }
        let value = node.value();
        if (value == null) {
            if (!types.isVoidType(expected)) {
                this.reporter.report("Function returns '{types.display(expected)}', but this "
                    + "'return' has no value; write 'return <value>;'.",
                    node.returnKeyword().span());
            }
            return;
        }
        Type actual = this.analyzeExpressionAdapt(value, expected);
        if (types.isVoidType(expected)) {
            this.reporter.report("Function returns 'void', so 'return' cannot carry a value; "
                + "write 'return;' or give the function a return type with '-> ...'.",
                value.span());
            return;
        }
        if (!convert.isAssignableStrict(expected, actual)) {
            this.reporter.report("Cannot return value of type '{types.display(actual)}' from "
                + "function returning '{types.display(expected)}'"
                + "{this.valueAssignabilityHint(expected, actual, value)}", value.span());
        }
    }

    // A thrown value must be an 'Error' or a subclass of it, proven non-null.
    checkThrowStatement(ThrowStatementNode node) {
        Type thrown = this.analyzeExpression(node.value());
        if (thrown is ErrorType) {
            return;
        }
        let errorClass = this.resolver.errorClass();
        bool allowed = errorClass != null && types.isClassLike(thrown)
            && types.isSubclassOf(thrown, errorClass);
        if (!allowed) {
            this.reporter.report("Cannot throw a value of type '{types.display(thrown)}'; "
                + "only 'Error' or a subclass of it can be thrown.", node.value().span());
        }
    }

    checkConditionIsBool(Type condition, string what, Span span) {
        if (!(condition is ErrorType) && !convert.isBoolType(condition)) {
            this.reporter.report("{what} must be 'bool', got '{types.display(condition)}'",
                span);
        }
    }

    // ---- Expressions ----

    analyzeExpression(Expression node) -> Type {
        Type analyzed = this.analyzeExpressionInner(node);
        this.result.setType(node.green(), analyzed);
        return analyzed;
    }

    analyzeExpressionInner(Expression node) -> Type {
        switch (node) {
            is LiteralExpressionNode literal -> {
                return this.analyzeLiteral(literal);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeIdentifier(identifier);
            },
            is ThisExpressionNode keyword -> {
                return this.analyzeThis(keyword);
            },
            is SuperExpressionNode keyword -> {
                return this.analyzeSuper(keyword);
            },
            is BinaryExpressionNode binary -> {
                return this.analyzeBinary(binary);
            },
            is PrefixExpressionNode prefix -> {
                return this.analyzePrefix(prefix);
            },
            is PostfixExpressionNode postfix -> {
                return this.analyzePostfix(postfix);
            },
            is CallExpressionNode call -> {
                return this.analyzeCall(call, null);
            },
            is GenericNameExpressionNode generic -> {
                return this.analyzeGenericNameValue(generic);
            },
            is MemberExpressionNode member -> {
                return this.analyzeMemberValue(member);
            },
            is SafeMemberExpressionNode member -> {
                return this.analyzeSafeMemberValue(member);
            },
            is SubscriptExpressionNode subscript -> {
                return this.analyzeSubscript(subscript);
            },
            is SafeSubscriptExpressionNode subscript -> {
                return this.analyzeSafeSubscript(subscript);
            },
            is CastExpressionNode cast -> {
                return this.analyzeCast(cast);
            },
            is CheckedCastExpressionNode cast -> {
                return this.analyzeCheckedCast(cast);
            },
            is TypeTestExpressionNode test -> {
                return this.analyzeTypeTest(test);
            },
            is AssignmentExpressionNode assignment -> {
                return this.analyzeAssignment(assignment);
            },
            is TernaryExpressionNode ternary -> {
                return this.analyzeTernary(ternary, null);
            },
            is NullCoalesceExpressionNode coalesce -> {
                return this.analyzeNullCoalesce(coalesce);
            },
            is NewExpressionNode created -> {
                return this.analyzeNew(created);
            },
            is ParenthesizedExpressionNode parenthesized -> {
                return this.analyzeExpression(parenthesized.inner());
            },
            is ArrayLiteralExpressionNode literal -> {
                return this.analyzeArrayLiteral(literal);
            },
            is StructLiteralExpressionNode literal -> {
                return this.analyzeStructLiteral(literal);
            },
            is InterpolatedStringExpressionNode interpolated -> {
                return this.analyzeInterpolatedString(interpolated);
            },
            is TryExpressionNode tried -> {
                return this.analyzeTry(tried);
            },
            is SwitchExpressionNode switched -> {
                return this.analyzeSwitchExpression(switched, null);
            },
            is LambdaExpressionNode lambda -> {
                this.reporter.report("This lambda has nothing to take its parameter and return "
                    + "types from. Declare what holds it with a function type, for example "
                    + "'(int, int) -> int compare = (a, b) -> a - b;', or pass it to a "
                    + "parameter declared with one.", lambda.span());
                return this.store.errorType();
            },
            is ErrorExpressionNode ignored -> {
                return this.store.errorType();
            },
        }
    }

    // Analyzes toward a target type. The forms with no type of their own take theirs from it: a
    // lambda its parameter and return types, an array literal its element type, an aggregate
    // literal its struct. An untyped integer or char literal adapts to it. A call sees it as the
    // expected type, which is what lets a static call on a generic type take its type arguments
    // from the surrounding context. A '?:' and a switch expression produce one value out of
    // several branches, so the target reaches each branch: whichever of these forms a branch is,
    // it is written against the same type the whole expression answers to. Parentheses group an
    // expression without changing what it is written against, so the target passes through them.
    analyzeExpressionAdapt(Expression node, Type target) -> Type {
        if (node is ParenthesizedExpressionNode) {
            Type adapted = this.analyzeExpressionAdapt(node.inner(), target);
            this.result.setType(node.green(), adapted);
            return adapted;
        }
        if (node is LambdaExpressionNode) {
            Type adapted = this.analyzeLambda(node, target);
            this.result.setType(node.green(), adapted);
            return adapted;
        }
        if (node is ArrayLiteralExpressionNode) {
            Type adapted = this.analyzeArrayLiteralAdapt(node, target);
            this.result.setType(node.green(), adapted);
            return adapted;
        }
        if (node is StructLiteralExpressionNode) {
            Type adapted = this.analyzeStructLiteralAdapt(node, target);
            this.result.setType(node.green(), adapted);
            return adapted;
        }
        Type analyzed = this.store.errorType();
        if (node is CallExpressionNode) {
            analyzed = this.analyzeCall(node, target);
            this.result.setType(node.green(), analyzed);
        } else if (node is TernaryExpressionNode) {
            analyzed = this.analyzeTernary(node, target);
            this.result.setType(node.green(), analyzed);
        } else if (node is SwitchExpressionNode) {
            analyzed = this.analyzeSwitchExpression(node, target);
            this.result.setType(node.green(), analyzed);
        } else {
            analyzed = this.analyzeExpression(node);
        }
        if (target is ErrorType || analyzed is ErrorType) {
            return analyzed;
        }
        // A 'char' is a code point rather than a quantity. Arithmetic on it in integers is
        // meaningful, but as a floating-point number it has no use, so the refusal says why
        // instead of leaving the reader to wonder which conversion was missing.
        if (types.isCharType(analyzed) && isTextualFloat(target)) {
            this.reporter.report("A 'char' is a code point rather than a quantity, so it has no "
                + "'{types.display(target)}' form of its own. Write 'as "
                + "{types.display(target)}' where the code point's number is what you mean.",
                node.span());
            this.result.setType(node.green(), this.store.errorType());
            return this.store.errorType();
        }
        this.adaptIntegerLiteral(node, target);
        this.adaptCharLiteral(node, target);
        this.adaptFloatLiteral(node, target);
        let updated = this.result.typeOf(node.green());
        if (updated != null) {
            return updated;
        }
        return analyzed;
    }

    // ---- Lambdas ----

    // Checks a lambda against the function type its surroundings expect. The target supplies the
    // parameter types the lambda leaves out and the return type its body answers to. The body is
    // checked as a callable of its own: its own scope, its own narrowing, its own loops, and a
    // return type of its own, so nothing about the enclosing control flow reaches into it. What
    // it reads from outside is a capture, recorded for the phases that lower it.
    analyzeLambda(LambdaExpressionNode node, Type target) -> Type {
        Type core = convert.coreOf(target);
        if (core is ErrorType) {
            return this.store.errorType();
        }
        if (!(core is FunctionType)) {
            this.reporter.report("A lambda is a function value, and '{types.display(target)}' "
                + "is not a function type, so it cannot hold one. Declare the target as a "
                + "function type such as '(int, int) -> int'.", node.span());
            return this.store.errorType();
        }
        Type[] expected = core.parameterTypes();
        if (!this.checkLambdaShape(node, core, expected)) {
            return this.store.errorType();
        }
        let parameters = new List<Parameter>();
        for (long i = 0; i < node.parametersCount(); i++) {
            let declared = node.parameters(i);
            parameters.push(new Parameter(declared.name().text(), expected[i], false, false,
                false, declared.name().span()));
        }
        let signature = new Signature("lambda", parameters.toArray(),
            core.returnType(), false, false, [], [], [], node.green(), node.span());
        let captures = this.checkLambdaBody(node, signature);
        this.result.setLambda(node.green(),
            new LambdaInfo(signature, core, captures));
        return core;
    }

    // The lambda's parameter list against the target's: the same count, all types written or
    // none, and every written type exactly the one the target passes. Invariant, so a written
    // type that merely accepts the target's is still a mismatch.
    checkLambdaShape(LambdaExpressionNode node, FunctionType target, Type[] expected) -> bool {
        long given = node.parametersCount();
        if (given != expected.length) {
            string mine = parameterCountText(given);
            string theirs = parameterCountText(expected.length);
            this.reporter.report("This lambda takes {mine}, but '{types.display(target)}' "
                + "takes {theirs}. Write it as '{lambdaShapeExample(expected.length)}'.",
                node.span());
            return false;
        }
        long typed = 0;
        for (long i = 0; i < given; i++) {
            if (node.parameters(i).declaredType() != null) {
                typed++;
            }
        }
        if (typed > 0 && typed < given) {
            this.reporter.report("This lambda writes the type of some parameters and not "
                + "others. Write every parameter's type or none of them, for example "
                + "'(int a, int b) -> a - b' or '(a, b) -> a - b'.", node.span());
            return false;
        }
        bool matched = true;
        for (long i = 0; i < given; i++) {
            let reference = node.parameters(i).declaredType();
            if (reference == null) {
                continue;
            }
            Type written = this.resolver.resolveType(reference);
            if (written is ErrorType) {
                matched = false;
                continue;
            }
            if (written != expected[i]) {
                this.reporter.report("Parameter '{node.parameters(i).name().text()}' is "
                    + "declared '{types.display(written)}', but '{types.display(target)}' "
                    + "passes '{types.display(expected[i])}' there. Write "
                    + "'{types.display(expected[i])} {node.parameters(i).name().text()}', or "
                    + "leave the type out and let the target supply it.", reference.span());
                matched = false;
            }
        }
        return matched;
    }

    // Walks the lambda's body under its own checker state and answers with what it captured.
    checkLambdaBody(LambdaExpressionNode node, Signature signature) -> LambdaCapture[] {
        let frame = new LambdaFrame(this.scope, this.thisType);
        let outerScope = this.scope;
        let outerNarrowing = this.narrowing;
        let outerReturnType = this.currentReturnType;
        bool outerNoreturn = this.currentNoreturn;
        bool outerConstructor = this.inConstructor;
        bool outerInCatch = this.inCatchClause;
        long outerLoopDepth = this.loopDepth;
        let outerBreakFlows = this.breakFlows;
        let outerCtorFieldOwner = this.ctorFieldOwner;
        let outerAssigned = this.copyBindings(this.assignedLocals);
        let outerTracked = this.copyBindings(this.trackedLocals);
        bool outerTerminated = this.flowTerminated;
        bool outerUnconditional = this.unconditionalPosition;
        let outerAssignmentTarget = this.assignmentTarget;

        this.lambdaFrames.push(frame);
        this.scope = new Scope(null);
        this.narrowing = new NarrowingState();
        this.currentReturnType = signature.returnType();
        this.currentNoreturn = false;
        this.inConstructor = false;
        this.inCatchClause = false;
        this.loopDepth = 0;
        this.breakFlows = new List<List<AssignmentFlow>>();
        this.ctorFieldOwner = null;
        this.flowTerminated = false;
        this.unconditionalPosition = true;
        this.assignmentTarget = null;

        Parameter[] parameters = signature.parameters();
        let lambdaScope = this.scope;
        for (long i = 0; i < parameters.length; i++) {
            let parameter = parameters[i];
            let binding = new LocalBinding(parameter.name(), parameter.type(),
                BindingKind.Parameter, false, parameter.span());
            if (lambdaScope != null && !lambdaScope.define(binding)) {
                this.reporter.report("Duplicate parameter name '{parameter.name()}' in this "
                    + "lambda; rename one of the parameters.", parameter.span());
            }
            this.result.setBinding(node.parameters(i).green(), binding);
        }

        this.enterScope();
        this.walkLambdaBody(node, signature.returnType());
        this.leaveScope();

        this.lambdaFrames.pop();
        this.scope = outerScope;
        this.narrowing = outerNarrowing;
        this.currentReturnType = outerReturnType;
        this.currentNoreturn = outerNoreturn;
        this.inConstructor = outerConstructor;
        this.inCatchClause = outerInCatch;
        this.loopDepth = outerLoopDepth;
        this.breakFlows = outerBreakFlows;
        this.ctorFieldOwner = outerCtorFieldOwner;
        this.assignedLocals = outerAssigned;
        this.trackedLocals = outerTracked;
        this.flowTerminated = outerTerminated;
        this.unconditionalPosition = outerUnconditional;
        this.assignmentTarget = outerAssignmentTarget;
        return frame.result();
    }

    // A block body is a function body: every path must return a value when the target returns
    // one. An expression body is the value itself, unless the target returns nothing, in which
    // case it is evaluated and discarded like an expression statement.
    walkLambdaBody(LambdaExpressionNode node, Type returned) {
        let body = node.body();
        if (body is BlockNode) {
            this.walkBlock(body);
            if (!types.isVoidType(returned) && !(returned is ErrorType)
                    && !flow.blockTerminates(body, ExitScope.Function, this)) {
                this.reporter.report("This lambda returns "
                    + "'{types.display(returned)}', so every path through its body needs a "
                    + "'return'; this one can reach the end without one.", node.arrow().span());
            }
            return;
        }
        if (body is Expression) {
            if (types.isVoidType(returned)) {
                this.analyzeExpression(body);
                return;
            }
            Type actual = this.analyzeExpressionAdapt(body, returned);
            if (!(returned is ErrorType) && !(actual is ErrorType)
                    && !convert.isAssignableStrict(returned, actual)) {
                this.reporter.report("This lambda's body produces "
                    + "'{types.display(actual)}', but its type returns "
                    + "'{types.display(returned)}'"
                    + "{this.valueAssignabilityHint(returned, actual, body)}", body.span());
            }
        }
    }

    // A name the lambda being checked does not declare itself: the enclosing lambdas' scopes,
    // outermost last, then the enclosing callable's. Finding one there is a capture, and every
    // lambda between the declaration and the use copies it.
    lookupCapture(string name) -> LocalBinding? {
        for (long i = this.lambdaFrames.length() - 1; i >= 0; i--) {
            let found = this.lambdaFrames.get(i).lookupOuter(name);
            if (found == null) {
                continue;
            }
            for (long j = i; j < this.lambdaFrames.length(); j++) {
                this.lambdaFrames.get(j).captureBinding(found);
            }
            return found;
        }
        return null;
    }

    // Records that every lambda being checked copies the enclosing receiver, which is what makes
    // 'this' readable, its fields writable, and its methods callable inside a lambda. A struct
    // receiver is refused: copying it would give the lambda its own struct, so a write through
    // the copy would not be a write to the one the method runs over. A primitive receiver is a
    // value nothing can write through, so copying it changes nothing and it is allowed.
    captureReceiver(Type receiver, Span at) {
        long depth = this.lambdaFrames.length();
        if (depth == 0) {
            return;
        }
        if (!types.isClassLike(receiver) && types.bindingOf(receiver) == null) {
            if (this.lambdaFrames.get(depth - 1).captureReceiver(receiver)) {
                this.reporter.report("A lambda cannot capture 'this' here: "
                    + "'{types.display(receiver)}' is a struct, so the lambda would copy it and "
                    + "a write through the copy would leave the struct this method runs over "
                    + "unchanged. Capture the fields the lambda needs as locals, or make "
                    + "'{types.display(receiver)}' a class.", at);
            }
            return;
        }
        for (long i = 0; i < depth; i++) {
            let ignored = this.lambdaFrames.get(i).captureReceiver(receiver);
        }
    }

    // Whether the binding lives outside the lambda being checked, so a write to it would land on
    // the lambda's own copy.
    isCapturedBinding(LocalBinding binding) -> bool {
        if (this.lambdaFrames.length() == 0) {
            return false;
        }
        return this.lambdaFrames.get(this.lambdaFrames.length() - 1).holds(binding);
    }

    // Reports a write to a captured local; true when it reported. 'action' names what the write
    // would do, so '=' and '++' read naturally.
    reportCapturedWrite(LocalBinding binding, string action, Span at) -> bool {
        if (!this.isCapturedBinding(binding)) {
            return false;
        }
        this.reporter.report("Cannot {action} '{binding.name()}' inside a lambda: a lambda "
            + "copies the values it captures, so the write would change that copy and leave the "
            + "'{binding.name()}' outside it unchanged. Return the value the lambda computes and "
            + "store it at the call site, or keep the value in an object the lambda can reach.",
            at);
        return true;
    }

    // Retypes an untyped integer literal to the integer target its value fits, and rejects the
    // literal outright when the value does not fit.
    adaptIntegerLiteral(Expression node, Type target) {
        if (target is PrimitiveType) {
            this.adaptIntegerLiteralTo(node, target);
        }
    }

    adaptIntegerLiteralTo(Expression node, PrimitiveType target) {
        if (!convert.isIntegerType(target)) {
            return;
        }
        let literal = intLiteralOf(node);
        if (literal == null) {
            return;
        }
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        if (magnitude == null) {
            return;
        }
        bool negative = isNegativeLiteral(node);
        if (!literalvalues.magnitudeFits(negative, magnitude, target.kind())) {
            string sign = "";
            if (negative) {
                sign = "-";
            }
            this.reporter.report("Literal {sign}{literal.value().text()} does not fit in "
                + "'{types.display(target)}' (range "
                + "{literalvalues.integerRange(target.kind())})", node.span());
            this.result.setType(node.green(), this.store.errorType());
            return;
        }
        this.result.setType(node.green(), target);
        this.result.setType(literal.green(), target);
    }

    // Retypes an unsuffixed floating-point literal to the floating-point target its magnitude
    // fits, and rejects the literal outright when the magnitude is one the target cannot hold.
    adaptFloatLiteral(Expression node, Type target) {
        if (target is PrimitiveType) {
            this.adaptFloatLiteralTo(node, target);
        }
    }

    adaptFloatLiteralTo(Expression node, PrimitiveType target) {
        if (target.kind() != PrimitiveKind.Float && target.kind() != PrimitiveKind.Double) {
            return;
        }
        let literal = floatLiteralOf(node);
        if (literal == null) {
            // An untyped integer literal names a floating-point value just as well, so it takes
            // a floating-point target under the same rule. No 64-bit magnitude reaches either
            // type's limit, so these always fit and only the precision rounds.
            let integer = intLiteralOf(node);
            if (integer == null
                    || literalvalues.integerMagnitude(integer.value().text()) == null) {
                return;
            }
            this.result.setType(node.green(), target);
            this.result.setType(integer.green(), target);
            return;
        }
        double magnitude = literalvalues.floatMagnitude(literal.value().text());
        if (!literalvalues.floatMagnitudeFits(magnitude, target.kind())) {
            string sign = "";
            if (isNegativeLiteral(node)) {
                sign = "-";
            }
            string hint = ".";
            if (target.kind() == PrimitiveKind.Float) {
                hint = "; 'double' reaches further.";
            }
            this.reporter.report("Literal {sign}{literal.value().text()} is too large for "
                + "'{types.display(target)}', which holds "
                + "{literalvalues.floatLimit(target.kind())} at most{hint}", node.span());
            this.result.setType(node.green(), this.store.errorType());
            return;
        }
        this.result.setType(node.green(), target);
        this.result.setType(literal.green(), target);
    }

    // A switch integer label adapts to the scrutinee like an int literal does, but also accepts a
    // typed long literal like '65L', which otherwise keeps its 'long' type. The value must fit and
    // the node is retyped so codegen emits it at the scrutinee's width.
    adaptIntegerLiteralLabel(Expression node, Type target) {
        if (target is PrimitiveType) {
            this.adaptIntegerLiteralLabelTo(node, target);
        }
    }

    adaptIntegerLiteralLabelTo(Expression node, PrimitiveType target) {
        if (!convert.isIntegerType(target)) {
            return;
        }
        let literal = integerLiteralOf(node, true);
        if (literal == null) {
            return;
        }
        let magnitude = literalvalues.integerMagnitude(literal.value().text());
        if (magnitude == null) {
            return;
        }
        bool negative = isNegativeLiteral(node);
        if (!literalvalues.magnitudeFits(negative, magnitude, target.kind())) {
            string sign = "";
            if (negative) {
                sign = "-";
            }
            this.reporter.report("Literal {sign}{literal.value().text()} does not fit in "
                + "'{types.display(target)}' (range "
                + "{literalvalues.integerRange(target.kind())})", node.span());
            this.result.setType(node.green(), this.store.errorType());
            return;
        }
        this.result.setType(node.green(), target);
        this.result.setType(literal.green(), target);
    }

    adaptCharLiteral(Expression node, Type target) {
        if (target is PrimitiveType) {
            this.adaptCharLiteralTo(node, target);
        }
    }

    adaptCharLiteralTo(Expression node, PrimitiveType target) {
        if (!convert.isIntegerType(target) || target.kind() == PrimitiveKind.Char) {
            return;
        }
        if (node is LiteralExpressionNode) {
            if (node.value().kind() != SyntaxKind.CharLiteral) {
                return;
            }
            ulong codepoint = literalvalues.charCodepoint(node.value().text());
            if (!literalvalues.magnitudeFits(false, codepoint, target.kind())) {
                this.reporter.report("Character literal does not fit in "
                    + "'{types.display(target)}' (range "
                    + "{literalvalues.integerRange(target.kind())})", node.span());
                this.result.setType(node.green(), this.store.errorType());
                return;
            }
            this.result.setType(node.green(), target);
        }
    }

    analyzeLiteral(LiteralExpressionNode node) -> Type {
        return switch (node.value().kind()) {
            IntLiteral -> this.numericLiteral(node, PrimitiveKind.Int),
            LongLiteral -> this.numericLiteral(node, PrimitiveKind.Long),
            FloatLiteral -> this.numericLiteral(node, PrimitiveKind.Float),
            DoubleLiteral -> this.numericLiteral(node, PrimitiveKind.Double),
            StringLiteral -> this.store.stringType(),
            CharLiteral -> this.store.primitive(PrimitiveKind.Char),
            TrueKeyword, FalseKeyword -> this.store.primitive(PrimitiveKind.Bool),
            NullKeyword -> this.store.nullType(),
            default -> this.store.errorType(),
        };
    }

    // A numeric literal starts at its own default type. Where nothing adapts it, that default
    // has to hold the value, so the ones that do not are recorded and reported at the end.
    numericLiteral(LiteralExpressionNode node, PrimitiveKind kind) -> Type {
        let defaultType = this.store.primitive(kind);
        this.recordLiteralRange(node, defaultType);
        return defaultType;
    }

    // A cast names the width the value should take, so a literal whose value the target holds
    // adapts to it and stays exact. One the target cannot hold keeps its default type, because
    // a narrowing cast is how the language spells a deliberate truncation.
    adaptLiteralToCastTarget(Expression node, Type target) {
        if (!(target is PrimitiveType)) {
            return;
        }
        if (convert.isIntegerType(target)) {
            let literal = intLiteralOf(node);
            if (literal == null) {
                return;
            }
            let magnitude = literalvalues.integerMagnitude(literal.value().text());
            if (magnitude == null || !literalvalues.magnitudeFits(isNegativeLiteral(node),
                    magnitude, target.kind())) {
                return;
            }
            this.result.setType(node.green(), target);
            this.result.setType(literal.green(), target);
            return;
        }
        if (target.kind() != PrimitiveKind.Float && target.kind() != PrimitiveKind.Double) {
            return;
        }
        let literal = floatLiteralOf(node);
        if (literal == null) {
            return;
        }
        if (!literalvalues.floatMagnitudeFits(
                literalvalues.floatMagnitude(literal.value().text()), target.kind())) {
            return;
        }
        this.result.setType(node.green(), target);
        this.result.setType(literal.green(), target);
    }

    recordLiteralRange(LiteralExpressionNode node, PrimitiveType defaultType) {
        string text = node.value().text();
        if (convert.isIntegerType(defaultType)) {
            let magnitude = literalvalues.integerMagnitude(text);
            if (magnitude != null
                    && literalvalues.magnitudeFits(false, magnitude, defaultType.kind())) {
                return;
            }
            ulong value = 0;
            bool parsed = magnitude != null;
            if (magnitude != null) {
                value = magnitude;
            }
            this.pendingLiteralRanges.push(new PendingLiteralRange(node.green(), node.span(),
                defaultType, text, false, parsed, value));
            return;
        }
        if (literalvalues.floatMagnitudeFits(literalvalues.floatMagnitude(text),
                defaultType.kind())) {
            return;
        }
        this.pendingLiteralRanges.push(new PendingLiteralRange(node.green(), node.span(),
            defaultType, text, false, false, 0));
    }

    // A sign sits outside the literal as a prefix, and it moves the integer boundary: the
    // magnitude 2147483648 is not an 'int' on its own but -2147483648 is. The pending entry
    // moves up to the prefix so adaptation and the diagnostic both see the whole value.
    retargetLiteralRange(PrefixExpressionNode outer, Expression operand, bool negative) {
        if (this.pendingLiteralRanges.length() == 0) {
            return;
        }
        let pending = this.pendingLiteralRanges.get(this.pendingLiteralRanges.length() - 1);
        if (pending.green != operand.green()) {
            return;
        }
        if (negative && pending.parsed && literalvalues.magnitudeFits(true, pending.magnitude,
                pending.defaultType.kind())) {
            this.pendingLiteralRanges.pop();
            return;
        }
        pending.moveTo(outer.green(), outer.span(), negative);
    }

    reportPendingLiteralRanges() {
        for (let pending in this.pendingLiteralRanges) {
            // Retyped by a target-typed position, which already judged the value there.
            let finalType = this.result.typeOf(pending.green);
            if (finalType != null && finalType != pending.defaultType) {
                continue;
            }
            string sign = "";
            if (pending.negative) {
                sign = "-";
            }
            string typeName = types.display(pending.defaultType);
            if (convert.isIntegerType(pending.defaultType)) {
                string wider = widerIntegerHolding(pending.negative, pending.magnitude,
                    pending.defaultType.kind());
                if (!pending.parsed || wider.length == 0) {
                    this.reporter.report("Literal {sign}{pending.text} does not fit in any "
                        + "integer type; the widest, 'ulong', holds up to "
                        + "18446744073709551615.", pending.span);
                } else {
                    this.reporter.report("Literal {sign}{pending.text} does not fit in "
                        + "'{typeName}' (range "
                        + "{literalvalues.integerRange(pending.defaultType.kind())}); declare "
                        + "'{wider}' to hold it.", pending.span);
                }
            } else {
                string hint = ".";
                if (pending.defaultType.kind() == PrimitiveKind.Float) {
                    hint = "; 'double' reaches further.";
                }
                this.reporter.report("Literal {sign}{pending.text} is too large for "
                    + "'{typeName}', which holds "
                    + "{literalvalues.floatLimit(pending.defaultType.kind())} at most{hint}",
                    pending.span);
            }
        }
        this.pendingLiteralRanges = new List<PendingLiteralRange>();
    }

    analyzeIdentifier(IdentifierExpressionNode node) -> Type {
        string name = node.name().text();
        if (name.length == 0) {
            return this.store.errorType();
        }
        if (types.primitiveNamed(this.store, name) != null) {
            this.reportTypeAsValue(name, node.name().span());
            return this.store.errorType();
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter.report("Statics are reached through the type name, even inside "
                    + "'{ownerName}'; write '{ownerName}.{name}'.", node.name().span());
                return this.store.errorType();
            }
            this.reporter.report("Undefined name '{name}'. Check the spelling, or declare it "
                + "before it is used.", node.name().span());
            return this.store.errorType();
        }
        switch (resolution) {
            is LocalName local -> {
                this.result.setBinding(node.green(), local.binding);
                this.checkDefiniteAssignment(local.binding, node.name().span());
                let proven = this.narrowing.provenType(narrow.bindingPath(local.binding));
                if (proven != null) {
                    return proven;
                }
                return local.binding.type();
            },
            is FunctionName ignored -> {
                return this.store.errorType();
            },
            is TypeName named -> {
                this.reportTypeAsValue(name, node.name().span());
                return this.store.errorType();
            },
            is NamespaceName ignored -> {
                return this.store.errorType();
            },
        }
    }

    reportTypeAsValue(string name, Span at) {
        this.reporter.report("'{name}' is a type, not a value. A type name starts a static "
            + "member access such as '{name}.member(...)'; to work with an instance, construct "
            + "or reference one.", at);
    }

    // The enclosing type's name when it declares a static under the given name, for the
    // uniform-access suggestion; null otherwise.
    staticSuggestionOwner(string name) -> string? {
        let owner = this.enclosingOwner;
        if (owner == null) {
            return null;
        }
        if (members.findField(types.staticFieldsOf(owner), name) == null
                && members.findMethodNamed(types.staticMethodsOf(owner), name) == null) {
            return null;
        }
        let authority = types.authorityOf(owner);
        if (authority == null) {
            return null;
        }
        return authority.name();
    }

    analyzeThis(ThisExpressionNode node) -> Type {
        let receiver = this.thisType;
        if (receiver == null) {
            if (this.inStaticMethod) {
                this.reporter.report("'this' cannot be used in a static method; a static "
                    + "belongs to the type itself and has no instance. Take the instance as a "
                    + "parameter, or drop 'static'.", node.thisKeyword().span());
            } else {
                this.reporter.report("'this' is only valid inside a method",
                    node.thisKeyword().span());
            }
            return this.store.errorType();
        }
        this.captureReceiver(receiver, node.thisKeyword().span());
        return receiver;
    }

    analyzeSuper(SuperExpressionNode node) -> Type {
        let receiver = this.thisType;
        if (receiver == null) {
            if (this.inStaticMethod) {
                this.reporter.report("'super' cannot be used in a static method; a static "
                    + "belongs to the type itself and has no instance.",
                    node.superKeyword().span());
            } else {
                this.reporter.report("'super' is only valid inside a method",
                    node.superKeyword().span());
            }
            return this.store.errorType();
        }
        let base = types.baseOf(receiver);
        if (base == null) {
            let authority = types.authorityOf(receiver);
            string shown = types.display(receiver);
            if (authority != null) {
                shown = authority.name();
            }
            this.reporter.report("'super' cannot be used in '{shown}' because it has no base "
                + "class", node.superKeyword().span());
            return this.store.errorType();
        }
        this.captureReceiver(receiver, node.superKeyword().span());
        return base;
    }

    analyzeBinary(BinaryExpressionNode node) -> Type {
        SyntaxKind operator = node.operator().kind();
        // '&&' and '||' evaluate the right side only when the left did not already decide
        // the result, so a check on the left narrows the right: 'x != null && x.ready()'.
        if (operator == SyntaxKind.AmpersandAmpersand || operator == SyntaxKind.PipePipe) {
            Type shortLeft = this.analyzeExpression(node.left());
            Type shortRight = this.analyzeGuardedBranch(node.left(), node.right(),
                operator == SyntaxKind.AmpersandAmpersand, null);
            if (shortLeft is ErrorType || shortRight is ErrorType) {
                return this.store.errorType();
            }
            if (!convert.isBoolType(shortLeft) || !convert.isBoolType(shortRight)) {
                this.reporter.report("'{node.operator().text()}' needs 'bool' on both sides, "
                    + "got '{types.display(shortLeft)}' and '{types.display(shortRight)}'.",
                    node.span());
            }
            return this.store.primitive(PrimitiveKind.Bool);
        }
        Type left = this.analyzeExpression(node.left());
        Type right = this.analyzeExpression(node.right());
        if (left is ErrorType || right is ErrorType) {
            return this.store.errorType();
        }
        return this.analyzeBinaryOperands(node.span(), operator, node.operator().text(),
            node.left(), node.right(), left, right);
    }

    // The result of 'left OP right' under the operator's own rules. Shared by a binary
    // expression and by a compound assignment, whose target and value are the two operands.
    analyzeBinaryOperands(Span span, SyntaxKind operator, string operatorText,
                                  Expression leftNode, Expression rightNode, Type left,
                                  Type right) -> Type {
        switch (operator) {
            Plus, Minus, Star, Slash, Percent -> {
                return this.analyzeArithmetic(span, operator, operatorText, leftNode, rightNode,
                    left, right);
            },
            EqualsEquals, NotEquals -> {
                return this.analyzeEquality(span, leftNode, rightNode, left, right);
            },
            Less, Greater, LessEquals, GreaterEquals -> {
                return this.analyzeComparison(span, operatorText, leftNode, rightNode, left,
                    right);
            },
            Ampersand, Pipe, Caret -> {
                return this.analyzeBitwise(span, operatorText, leftNode, rightNode, left, right);
            },
            LessLess, GreaterGreater, GreaterGreaterGreater -> {
                return this.analyzeShift(span, operatorText, rightNode, left, right);
            },
            default -> {
                this.reporter.report("Internal: unsupported binary operator "
                    + "'{operatorText}'.", span);
                return this.store.errorType();
            },
        }
    }

    // Adapts an untyped literal on either side toward the other operand's type, then re-reads
    // both sides.
    adaptOperands(Expression leftNode, Expression rightNode, Type left, Type right) -> Type[] {
        this.adaptIntegerLiteral(leftNode, right);
        this.adaptIntegerLiteral(rightNode, left);
        this.adaptFloatLiteral(leftNode, right);
        this.adaptFloatLiteral(rightNode, left);
        Type adaptedLeft = left;
        Type adaptedRight = right;
        let updatedLeft = this.result.typeOf(leftNode.green());
        if (updatedLeft != null) {
            adaptedLeft = updatedLeft;
        }
        let updatedRight = this.result.typeOf(rightNode.green());
        if (updatedRight != null) {
            adaptedRight = updatedRight;
        }
        return [adaptedLeft, adaptedRight];
    }

    analyzeArithmetic(Span span, SyntaxKind operator, string operatorText, Expression leftNode,
                              Expression rightNode, Type left, Type right) -> Type {
        if (operator == SyntaxKind.Plus && (left is StringType || right is StringType)) {
            if (isStringable(left) && isStringable(right)) {
                return this.store.stringType();
            }
            Type other = left;
            if (left is StringType) {
                other = right;
            }
            this.reporter.report("Cannot concatenate a value of type '{types.display(other)}' "
                + "onto a string; only string, number, and bool values are supported.", span);
            return this.store.errorType();
        }
        if (!convert.isNumericType(left) || !convert.isNumericType(right)) {
            this.reporter.report("'{operatorText}' needs numbers on both sides, "
                + "got '{types.display(left)}' and '{types.display(right)}'.", span);
            return this.store.errorType();
        }
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right);
        if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
            return this.store.errorType();
        }
        let common = convert.numericCommonType(adapted[0], adapted[1]);
        if (common == null) {
            this.reporter.report("'{operatorText}' needs the same numeric type on "
                + "both sides, got '{types.display(adapted[0])}' and "
                + "'{types.display(adapted[1])}'; convert one side with 'as'.", span);
            return this.store.errorType();
        }
        return common;
    }

    // A comparison against 'null' is a presence test on the declared storage type, so it
    // stays legal on a binding declared optional even where narrowing already proved the
    // value non-null.
    analyzeEquality(Span span, Expression leftNode, Expression rightNode, Type left,
                            Type right) -> Type {
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right);
        Type leftSide = adapted[0];
        Type rightSide = adapted[1];
        if (rightSide is NullType) {
            leftSide = this.presenceOperandType(leftNode, leftSide);
        } else if (leftSide is NullType) {
            rightSide = this.presenceOperandType(rightNode, rightSide);
        }
        if (this.reportFunctionComparison(span, leftSide, rightSide)) {
            return this.store.primitive(PrimitiveKind.Bool);
        }
        if (!convert.isAssignableStrict(leftSide, rightSide)
                && !convert.isAssignableStrict(rightSide, leftSide)) {
            this.reporter.report("Cannot compare '{types.display(leftSide)}' and "
                + "'{types.display(rightSide)}'{nullComparisonHint(leftSide, rightSide)}", span);
        } else {
            this.checkStructEquatable(leftSide, rightSide, span);
        }
        return this.store.primitive(PrimitiveKind.Bool);
    }

    // A function value has nothing to reach into: no fields, no methods, no identity and no text
    // form. The one home for saying so, whether the name was read or called.
    reportFunctionMember(string name, Type functionType, Span at) -> Type {
        this.reporter.report("A function value has no members, so '{name}' cannot be used on "
            + "'{types.display(functionType)}': it has no identity and no text form. Call the "
            + "value with '(...)', or keep the data you need beside it.", at);
        return this.store.errorType();
    }

    // A function value has no identity: two lambdas with the same body are different values, and
    // the same lambda written once may answer with a different value every time it is evaluated.
    // Testing a nullable one against 'null' asks about presence instead and stays allowed. True
    // when it reported.
    reportFunctionComparison(Span span, Type left, Type right) -> bool {
        if (left is NullType || right is NullType) {
            return false;
        }
        if (!(convert.coreOf(left) is FunctionType) && !(convert.coreOf(right) is FunctionType)) {
            return false;
        }
        this.reporter.report("A function value has no identity, so '{types.display(left)}' and "
            + "'{types.display(right)}' cannot be compared. Compare what the functions produce, "
            + "or keep a name or tag beside each one and compare that.", span);
        return true;
    }

    // Same-type struct '==' lowers to a memberwise compare, so every field's type must have its
    // own '=='. A struct type that mentions a type parameter is judged per instantiation.
    checkStructEquatable(Type leftSide, Type rightSide, Span span) {
        if (!isStructValue(leftSide) || leftSide != rightSide) {
            return;
        }
        if (convert.containsTypeParam(leftSide)) {
            this.recordObligation(new EqualityObligation(leftSide, span));
            return;
        }
        let issue = obligations.equalityComparabilityIssue(leftSide);
        if (issue != null) {
            this.reporter.report(issue, span);
        }
    }

    analyzeComparison(Span span, string operatorText, Expression leftNode, Expression rightNode,
                              Type left, Type right) -> Type {
        if (left is StringType && right is StringType) {
            this.reporter.report("Operator '{operatorText}' cannot be applied to 'string' and "
                + "'string'; it compares numbers. Order strings with 'compareTo', as in "
                + "'left.compareTo(right) {operatorText} 0'.", span);
            return this.store.primitive(PrimitiveKind.Bool);
        }
        if (!convert.isNumericType(left) || !convert.isNumericType(right)) {
            this.reporter.report("'{operatorText}' compares numbers, got "
                + "'{types.display(left)}' and '{types.display(right)}'.", span);
            return this.store.primitive(PrimitiveKind.Bool);
        }
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right);
        if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
            return this.store.primitive(PrimitiveKind.Bool);
        }
        if (convert.numericCommonType(adapted[0], adapted[1]) == null) {
            this.reporter.report("'{operatorText}' needs the same numeric type on "
                + "both sides, got '{types.display(adapted[0])}' and "
                + "'{types.display(adapted[1])}'; convert one side with 'as'.", span);
        }
        return this.store.primitive(PrimitiveKind.Bool);
    }

    analyzeBitwise(Span span, string operatorText, Expression leftNode, Expression rightNode,
                           Type left, Type right) -> Type {
        if (!convert.isIntegerType(left) || !convert.isIntegerType(right)) {
            this.reporter.report("'{operatorText}' needs integers on both sides, got "
                + "'{types.display(left)}' and '{types.display(right)}'.", span);
            return this.store.errorType();
        }
        Type[] adapted = this.adaptOperands(leftNode, rightNode, left, right);
        if (adapted[0] is ErrorType || adapted[1] is ErrorType) {
            return this.store.errorType();
        }
        if (adapted[0] != adapted[1]) {
            this.reporter.report("'{operatorText}' needs the same integer type on both sides, "
                + "got '{types.display(adapted[0])}' and '{types.display(adapted[1])}'; "
                + "convert one side with 'as'.", span);
            return this.store.errorType();
        }
        return adapted[0];
    }

    // The shifted value alone decides the result type, so only the distance adapts.
    analyzeShift(Span span, string operatorText, Expression rightNode, Type left,
                         Type right) -> Type {
        if (!convert.isIntegerType(left)) {
            this.reporter.report("'{operatorText}' shifts an integer, got "
                + "'{types.display(left)}'.", span);
            return this.store.errorType();
        }
        if (!convert.isIntegerType(right)) {
            this.reporter.report("'{operatorText}' needs an integer shift distance, got "
                + "'{types.display(right)}'.", span);
            return this.store.errorType();
        }
        this.adaptIntegerLiteral(rightNode, left);
        Type distance = right;
        let updated = this.result.typeOf(rightNode.green());
        if (updated != null) {
            distance = updated;
        }
        if (distance is ErrorType) {
            return this.store.errorType();
        }
        if (left != distance) {
            this.reporter.report("'{operatorText}' shifts a value of type "
                + "'{types.display(left)}', so the shift distance must be "
                + "'{types.display(left)}' too, got '{types.display(distance)}'; convert the "
                + "distance with 'as'.", span);
            return this.store.errorType();
        }
        return left;
    }

    analyzePrefix(PrefixExpressionNode node) -> Type {
        Type operand = this.analyzeExpression(node.operand());
        SyntaxKind prefixOperator = node.operator().kind();
        if (prefixOperator == SyntaxKind.Minus || prefixOperator == SyntaxKind.Plus) {
            this.retargetLiteralRange(node, node.operand(),
                prefixOperator == SyntaxKind.Minus);
        }
        if (operand is ErrorType) {
            return this.store.errorType();
        }
        Type core = operand;
        switch (node.operator().kind()) {
            Minus, Plus -> {
                if (!convert.isNumericType(core)) {
                    this.reporter.report("Unary '{node.operator().text()}' needs a number, "
                        + "got '{types.display(operand)}'.", node.span());
                    return this.store.errorType();
                }
                return core;
            },
            Exclamation -> {
                if (!convert.isBoolType(core)) {
                    this.reporter.report("'!' negates a 'bool', got "
                        + "'{types.display(operand)}'.", node.span());
                    return this.store.errorType();
                }
                return core;
            },
            Tilde -> {
                if (!convert.isIntegerType(core)) {
                    this.reporter.report("'~' flips the bits of an integer, got "
                        + "'{types.display(operand)}'.", node.span());
                    return this.store.errorType();
                }
                return core;
            },
            PlusPlus, MinusMinus -> {
                return this.analyzeIncrement(node.span(), node.operand(), core,
                    node.operator().kind() == SyntaxKind.PlusPlus, true);
            },
            default -> {
                this.reporter.report("Internal: unsupported unary operator "
                    + "'{node.operator().text()}'.", node.operator().span());
                return this.store.errorType();
            },
        }
    }

    analyzePostfix(PostfixExpressionNode node) -> Type {
        Type operand = this.analyzeExpression(node.operand());
        if (operand is ErrorType) {
            return this.store.errorType();
        }
        return this.analyzeIncrement(node.span(), node.operand(), operand,
            node.operator().kind() == SyntaxKind.PlusPlus, false);
    }

    analyzeIncrement(Span span, Expression operand, Type operandType, bool isIncrement,
                             bool isPrefix) -> Type {
        string operator = "--";
        if (isIncrement) {
            operator = "++";
        }
        string example = "count{operator}";
        if (isPrefix) {
            example = "{operator}count";
        }
        if (!convert.isNumericType(operandType)) {
            this.reporter.report("The '{operator}' operator works only on numbers, so it "
                + "cannot be applied to a value of type '{types.display(operandType)}'; use "
                + "it on an integer or floating-point variable, for example '{example}'.",
                span);
            return operandType;
        }
        if (!this.isLValue(operand)) {
            this.reporter.report("The '{operator}' operator needs a variable to change, for "
                + "example '{example}'; it cannot be applied to something that is not a "
                + "variable, field, or array element.", span);
            return operandType;
        }
        if (operand is IdentifierExpressionNode) {
            let binding = this.result.bindingOf(operand.green());
            if (binding != null && this.reportCapturedWrite(binding, "change", span)) {
                return operandType;
            }
            if (binding != null && binding.isConst()) {
                this.reporter.report("The '{operator}' operator cannot change "
                    + "'{binding.name()}' because it is declared as constant; use 'let' "
                    + "instead of 'const' if it needs to change.", span);
                return operandType;
            }
        }
        if (operand is MemberExpressionNode) {
            let staticField = this.result.staticConstFieldOf(operand.green());
            if (staticField != null) {
                this.reporter.report("The '{operator}' operator cannot change "
                    + "'{staticConstDisplay(staticField)}': a static const takes its one "
                    + "value from its initializer and never changes.", span);
                return operandType;
            }
            let objectType = this.result.typeOf(operand.object().green());
            if (objectType != null) {
                let field = members.findField(types.fieldsOf(objectType),
                    operand.member().text());
                if (field != null && field.isConst()) {
                    this.reporter.report("The '{operator}' operator cannot change field "
                        + "'{field.name()}' because it is declared 'const'; a 'const' field is "
                        + "assigned exactly once when the object is constructed. Remove 'const' "
                        + "from the field if it needs to change.", span);
                    return operandType;
                }
            }
        }
        this.invalidateForWrite(operand);
        return operandType;
    }

    // A member write through a class reference mutates the heap object, so any object works; a
    // struct member write needs an addressable struct, so the object must itself be an lvalue.
    isLValue(Expression node) -> bool {
        switch (node) {
            is IdentifierExpressionNode ignored -> {
                return true;
            },
            is SubscriptExpressionNode ignored -> {
                return true;
            },
            is ThisExpressionNode ignored -> {
                return true;
            },
            is MemberExpressionNode member -> {
                let objectType = this.result.typeOf(member.object().green());
                if (objectType != null && isStructValue(objectType)) {
                    return this.isLValue(member.object());
                }
                return true;
            },
            default -> {
                return false;
            },
        }
    }

    analyzeAssignment(AssignmentExpressionNode node) -> Type {
        // A plain `x = ...` is a definite assignment of x, so its own identifier on the left is
        // a write, not a read to check. A compound `x += ...` reads x first, and a member or
        // subscript target reads its base, which must already be assigned.
        bool simpleAssign = node.operator().kind() == SyntaxKind.Equals;
        let target = node.target();
        let previousTarget = this.assignmentTarget;
        if (simpleAssign && target is IdentifierExpressionNode) {
            let resolved = this.resolveName(target.name().text());
            if (resolved is LocalName) {
                this.assignmentTarget = resolved.binding;
            }
        }
        Type targetType = this.analyzeExpression(target);
        this.assignmentTarget = previousTarget;
        if (!this.isLValue(node.target())) {
            this.reporter.report("The left side of '=' must be a variable, field, or array "
                + "element.", node.span());
        }
        if (target is MemberExpressionNode) {
            let staticTarget = this.result.staticConstFieldOf(target.green());
            if (staticTarget != null) {
                this.reporter.report("Cannot assign to "
                    + "'{staticConstDisplay(staticTarget)}': a static const takes its one "
                    + "value from its initializer and never changes. Change the initializer, "
                    + "or use an instance field.", node.span());
            }
        }
        Type assignTarget = this.declaredTargetType(node.target(), targetType);
        Type valueType = this.analyzeExpressionAdapt(node.value(), assignTarget);
        // What the store actually lands: the right side for '=', the operator's result for 'OP='.
        Type storedType = valueType;
        if (!(assignTarget is ErrorType) && !(valueType is ErrorType)) {
            if (simpleAssign) {
                if (!convert.isAssignableStrict(assignTarget, valueType)) {
                    this.reporter.report("Cannot assign '{types.display(valueType)}' to "
                        + "'{types.display(assignTarget)}'"
                        + "{this.valueAssignabilityHint(assignTarget, valueType, node.value())}",
                        node.span());
                }
            } else if (!(targetType is ErrorType)) {
                storedType = this.checkCompoundAssignment(node, assignTarget, targetType,
                    valueType);
            }
        }
        if (assignTarget != targetType) {
            this.result.setType(node.target().green(), assignTarget);
        }
        this.invalidateForWrite(node.target());
        let assignTargetNode = node.target();
        if (assignTargetNode is IdentifierExpressionNode) {
            let binding = this.result.bindingOf(assignTargetNode.green());
            if (binding != null) {
                this.establishAssignmentNarrowing(binding, storedType);
                if (this.unconditionalPosition) {
                    this.markAssigned(binding);
                }
            }
        } else if (assignTargetNode is MemberExpressionNode) {
            let objectType = this.result.typeOf(assignTargetNode.object().green());
            if (objectType != null) {
                let field = members.findField(types.fieldsOf(objectType),
                    assignTargetNode.member().text());
                if (field != null) {
                    bool throughThis = assignTargetNode.object() is ThisExpressionNode;
                    if (field.isConst()) {
                        this.checkConstFieldWrite(node, field, throughThis, simpleAssign);
                    }
                    if (simpleAssign && throughThis) {
                        this.markThisFieldMaybeAssigned(field);
                        if (this.unconditionalPosition) {
                            this.markThisFieldAssigned(field);
                        }
                    }
                }
            }
        }
        return assignTarget;
    }

    // Enforces the write-once contract of a 'const' field at an assignment naming it. The one
    // legal write is a plain '=' through 'this' inside a constructor of the field's own type,
    // outside any loop, on a path that cannot have assigned the field already; everything else
    // is rejected here.
    checkConstFieldWrite(AssignmentExpressionNode node, Field field, bool throughThis,
                                 bool simpleAssign) {
        string name = field.name();
        string ownerName = this.constFieldOwnerName(field);
        if (!simpleAssign) {
            string operatorText = node.operator().text();
            this.reporter.report("Cannot use '{operatorText}' on field '{name}' because "
                + "'{name}' is declared 'const': '{operatorText}' stores a new value into the "
                + "field, and a 'const' field is assigned exactly once when the object is "
                + "constructed. Remove 'const' from the field if it needs to change.",
                node.span());
            return;
        }
        if (!this.inConstructor || !throughThis) {
            string sites = "inside a constructor of '{ownerName}' as 'this.{name} = ...'";
            if (types.authorityOf(field.definingType()) is StructType) {
                sites = sites + " or by a struct literal like '\{{name}: ...\}'";
            }
            this.reporter.report("Cannot assign a new value to field '{name}' because it is "
                + "declared 'const'; a 'const' field is assigned exactly once, " + sites
                + ", and never changes afterwards. Remove 'const' from the field if it needs "
                + "to change.", node.span());
            return;
        }
        if (field.definingType() != this.ctorFieldOwner) {
            this.reporter.report("Field '{name}' is 'const' and declared in base class "
                + "'{ownerName}', so only a constructor of '{ownerName}' can assign it; a "
                + "subclass constructor cannot. Pass the value along in the 'super(...)' call "
                + "instead.", node.span());
            return;
        }
        if (this.loopDepth > 0) {
            this.reporter.report("Field '{name}' is 'const', so it cannot be assigned inside "
                + "a loop: the loop can run more than once, but a 'const' field is "
                + "assigned exactly once. Assign it once, outside the loop.", node.span());
            return;
        }
        if (this.fieldsContain(this.maybeAssignedThisFields, field)) {
            this.reporter.report("Field '{name}' is 'const' and may already be assigned when "
                + "this line runs; a 'const' field is assigned exactly once. Remove one of the "
                + "assignments.", node.span());
        }
    }

    // 'a OP= b' means 'a = a OP b', so the right side is the operator's operand and it is the
    // operator's RESULT that has to fit the target. Returns that result, which is what the
    // store lands.
    checkCompoundAssignment(AssignmentExpressionNode node, Type assignTarget, Type targetType,
                                    Type valueType) -> Type {
        SyntaxKind operator = compoundOperator(node.operator().kind());
        if (operator == SyntaxKind.Invalid) {
            this.reporter.report("Internal: unsupported compound assignment operator "
                + "'{node.operator().text()}'.", node.operator().span());
            return valueType;
        }
        string operatorText = node.operator().text();
        Type result = this.analyzeBinaryOperands(node.span(), operator, operatorText,
            node.target(), node.value(), targetType, valueType);
        if (result is ErrorType) {
            return valueType;
        }
        if (!convert.isAssignableStrict(assignTarget, result)) {
            this.reporter.report("Cannot store the result of '{operatorText}' back into "
                + "'{types.display(assignTarget)}': '{types.display(targetType)}' and "
                + "'{types.display(valueType)}' produce '{types.display(result)}'. Convert the "
                + "right side with 'as', or declare the target as '{types.display(result)}'.",
                node.span());
        }
        return result;
    }

    // The declared type of the written slot: the binding's, field's, or element's own type.
    declaredTargetType(Expression target, Type analyzed) -> Type {
        switch (target) {
            is IdentifierExpressionNode identifier -> {
                let binding = this.result.bindingOf(identifier.green());
                if (binding == null) {
                    return analyzed;
                }
                if (this.reportCapturedWrite(binding, "assign a new value to",
                        identifier.span())) {
                    return binding.type();
                }
                if (binding.isConst()) {
                    this.reporter.report("Cannot assign a new value to '{binding.name()}' "
                        + "because it is declared as constant; use 'let' instead of 'const' "
                        + "if it needs to change.", identifier.span());
                }
                return binding.type();
            },
            is MemberExpressionNode member -> {
                let objectType = this.result.typeOf(member.object().green());
                if (objectType != null) {
                    let field = members.findField(types.fieldsOf(objectType),
                        member.member().text());
                    if (field != null) {
                        return field.type();
                    }
                }
                return analyzed;
            },
            is SubscriptExpressionNode subscript -> {
                let objectType = this.result.typeOf(subscript.object().green());
                if (objectType is ArrayType) {
                    return objectType.element();
                }
                return analyzed;
            },
            default -> {
                return analyzed;
            },
        }
    }

    analyzeTernary(TernaryExpressionNode node, Type? target) -> Type {
        Type condition = this.analyzeExpression(node.condition());
        Type thenType = this.analyzeGuardedBranch(node.condition(), node.thenValue(), true,
            target);
        Type elseType = this.analyzeGuardedBranch(node.condition(), node.elseValue(), false,
            target);
        this.checkConditionIsBool(condition, "Ternary condition", node.condition().span());
        if (thenType is ErrorType || elseType is ErrorType) {
            return this.store.errorType();
        }
        this.adaptIntegerLiteral(node.thenValue(), elseType);
        this.adaptIntegerLiteral(node.elseValue(), thenType);
        this.adaptFloatLiteral(node.thenValue(), elseType);
        this.adaptFloatLiteral(node.elseValue(), thenType);
        let updatedThen = this.result.typeOf(node.thenValue().green());
        if (updatedThen != null) {
            thenType = updatedThen;
        }
        let updatedElse = this.result.typeOf(node.elseValue().green());
        if (updatedElse != null) {
            elseType = updatedElse;
        }
        let unified = convert.unifyValueTypes(thenType, elseType, this.store);
        if (unified != null) {
            return unified;
        }
        this.reporter.report("The two results of this '?:' have incompatible types "
            + "'{types.display(thenType)}' and '{types.display(elseType)}'; both branches "
            + "must produce one common type.", node.span());
        return this.store.errorType();
    }

    // '??' is a presence test on the left's declared storage type, so a binding declared
    // optional keeps it legal even after narrowing proved the value non-null; the check is
    // then constant and yields the value.
    analyzeNullCoalesce(NullCoalesceExpressionNode node) -> Type {
        Type left = this.analyzeExpression(node.left());
        bool previous = this.unconditionalPosition;
        this.unconditionalPosition = false;
        Type right = this.analyzeExpression(node.right());
        this.unconditionalPosition = previous;
        if (left is ErrorType || right is ErrorType) {
            return this.store.errorType();
        }
        left = this.presenceOperandType(node.left(), left);
        if (!(left is OptionalType)) {
            this.reporter.report("Left of '??' must be a nullable value, got "
                + "'{types.display(left)}'. '??' supplies a fallback for null, so remove it "
                + "here, or make the left side nullable.", node.span());
            return this.store.errorType();
        }
        Type unwrapped = left.inner();
        if (convert.isAssignableStrict(unwrapped, right)) {
            return unwrapped;
        }
        if (convert.isAssignableStrict(left, right)) {
            return left;
        }
        this.reporter.report("Right of '??' has type '{types.display(right)}' which is "
            + "not compatible with '{types.display(unwrapped)}'", node.span());
        return this.store.errorType();
    }

    analyzeCast(CastExpressionNode node) -> Type {
        Type source = this.analyzeExpression(node.value());
        Type target = this.resolver.resolveType(node.target());
        if (source is ErrorType || target is ErrorType) {
            return this.store.errorType();
        }
        this.adaptLiteralToCastTarget(node.value(), target);
        let retyped = this.result.typeOf(node.value().green());
        if (retyped != null) {
            source = retyped;
        }
        if (source is EnumType) {
            if (!source.isNumeric()) {
                this.reporter.report(this.enumNeedsValuesMessage(source), node.span());
                return this.store.errorType();
            }
            if (!convert.isIntegerType(target)) {
                this.reporter.report("Cannot convert enum '{types.display(source)}' to "
                    + "'{types.display(target)}' with 'as'; a numeric enum converts to an "
                    + "integer type such as 'int' or 'long'.", node.span());
                return this.store.errorType();
            }
            return target;
        }
        if (target is EnumType) {
            if (target.isNumeric()) {
                this.reporter.report("Converting '{types.display(source)}' to enum "
                    + "'{types.display(target)}' can fail when no member has that value; use "
                    + "'as?', which yields '{types.display(target)}?' (null when no member "
                    + "matches).", node.span());
            } else {
                this.reporter.report(this.enumNeedsValuesMessage(target), node.span());
            }
            return this.store.errorType();
        }
        if (!convert.isNumericType(source) || !convert.isNumericType(target)) {
            this.reporter.report("Cannot cast '{types.display(source)}' to "
                + "'{types.display(target)}'; 'as' only supports numeric conversions.",
                node.span());
            return this.store.errorType();
        }
        return target;
    }

    // Guidance when a plain enum is used in a numeric conversion: it names the enum and shows how
    // to make it numeric using its own first member.
    enumNeedsValuesMessage(EnumType enumType) -> string {
        string member = "First";
        let names = enumType.memberNames();
        if (names.length > 0) {
            member = names[0];
        }
        return "Enum '{enumType.name()}' has no assigned values; give its members explicit "
            + "values (for example '{member} = 0') to convert it to and from integers.";
    }

    analyzeTypeTest(TypeTestExpressionNode node) -> Type {
        Type source = this.analyzeExpression(node.value());
        Type target = this.resolver.resolveType(node.target());
        this.result.setType(node.target().green(), target);
        if (source is ErrorType || target is ErrorType) {
            return this.store.errorType();
        }
        if (!this.checkClassTypeTest(source, target, false, node.span())) {
            return this.store.errorType();
        }
        return this.store.primitive(PrimitiveKind.Bool);
    }

    analyzeCheckedCast(CheckedCastExpressionNode node) -> Type {
        Type source = this.analyzeExpression(node.value());
        Type target = this.resolver.resolveType(node.target());
        if (source is ErrorType || target is ErrorType) {
            return this.store.errorType();
        }
        if (target is EnumType) {
            if (!target.isNumeric()) {
                this.reporter.report(this.enumNeedsValuesMessage(target), node.span());
                return this.store.errorType();
            }
            if (!convert.isIntegerType(source)) {
                this.reporter.report("Cannot convert '{types.display(source)}' to enum "
                    + "'{types.display(target)}' with 'as?'; the value being matched must be an "
                    + "integer.", node.span());
                return this.store.errorType();
            }
            return this.store.optionalOf(target);
        }
        if (source is EnumType && source.isNumeric() && convert.isIntegerType(target)) {
            this.reporter.report("Converting enum '{types.display(source)}' to "
                + "'{types.display(target)}' always succeeds; use 'as', not 'as?'.", node.span());
            return this.store.errorType();
        }
        if (!this.checkClassTypeTest(source, target, true, node.span())) {
            return this.store.errorType();
        }
        return this.store.optionalOf(target);
    }

    // The 'is' and 'as?' rule set: the target must be a plain class or interface, and the pair
    // must be able to succeed without always succeeding. Open-typed operands defer to each
    // instantiation.
    checkClassTypeTest(Type source, Type target, bool isCast, Span span) -> bool {
        string operator = "is";
        if (isCast) {
            operator = "as?";
        }
        if (target is OptionalType) {
            string core = types.display(convert.coreOf(target));
            if (isCast) {
                this.reporter.report("The target of 'as?' cannot be nullable; 'as? {core}' "
                    + "already produces '{core}?'. Write the target without its '?', as "
                    + "'as? {core}'.", span);
            } else {
                this.reporter.report("The target of 'is' cannot be nullable; 'is' is never "
                    + "true for null. Test against '{core}' instead.", span);
            }
            return false;
        }
        if (target is TypeParamType) {
            this.reporter.report("The target of '{operator}' must be a concrete class; "
                + "'{types.display(target)}' is a type parameter.", span);
            return false;
        }
        if (!types.isClassLike(target)) {
            this.reporter.report("The target of '{operator}' must be a class or an interface, "
                + "got '{types.display(target)}'.", span);
            return false;
        }
        if (convert.containsTypeParam(source) || convert.containsTypeParam(target)) {
            this.recordObligation(new TypeTestObligation(source, target, isCast, span));
            return true;
        }
        let issue = obligations.typeTestIssue(source, target, isCast);
        if (issue != null) {
            this.reporter.report(issue, span);
            return false;
        }
        return true;
    }

    analyzeSubscript(SubscriptExpressionNode node) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        Type indexType = this.analyzeExpression(node.index());
        if (objectType is ErrorType) {
            return this.store.errorType();
        }
        if (objectType is OptionalType && convert.coreOf(objectType) is ArrayType) {
            if (objectType.inner() is OptionalType) {
                this.reporter.report("Cannot index '{types.display(objectType)}' because it "
                    + "may be null at more than one level. Unwrap one level first: check it for "
                    + "null ('if (value != null)') or supply a fallback ('value ?? null'), then "
                    + "index the '{types.display(objectType.inner())}' that remains.",
                    node.span());
            } else {
                this.reporter.report("Cannot index '{types.display(objectType)}' because it may "
                    + "be null. Check it for null first ('if (value != null)'), or use '?[' to "
                    + "index it only when it is present.", node.span());
            }
            return this.store.errorType();
        }
        if (objectType is ArrayType) {
            this.checkIndexIsInteger(indexType, node.index().span());
            Type element = objectType.element();
            if (element is OptionalType || types.isClassLike(element)) {
                let path = this.buildNarrowingPath(node, false);
                if (path != null) {
                    let proven = this.narrowing.provenType(path);
                    if (proven != null) {
                        return proven;
                    }
                }
            }
            return element;
        }
        this.reporter.report("Cannot index '{types.display(objectType)}'; only arrays "
            + "support [] indexing.", node.span());
        return this.store.errorType();
    }

    analyzeSafeSubscript(SafeSubscriptExpressionNode node) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        Type indexType = this.analyzeExpression(node.index());
        if (objectType is ErrorType) {
            return this.store.errorType();
        }
        objectType = this.presenceOperandType(node.object(), objectType);
        if (!(objectType is OptionalType)) {
            this.reporter.report("The value on the left of '?[' has type "
                + "'{types.display(objectType)}', which can never be null. Use '[' to index "
                + "it.", node.span());
            return this.store.errorType();
        }
        Type inner = objectType.inner();
        if (inner is OptionalType) {
            this.reporter.report("The value on the left of '?[' has type "
                + "'{types.display(objectType)}', which is nullable at more than one level, "
                + "and '?[' looks through only one. Unwrap one level first: check the value "
                + "for null ('if (value != null)') or supply a fallback ('value ?? null'), "
                + "then index the '{types.display(inner)}' that remains.", node.span());
            return this.store.errorType();
        }
        if (inner is ArrayType) {
            this.checkIndexIsInteger(indexType, node.index().span());
            return this.safeResultOf(inner.element());
        }
        this.reporter.report("The value on the left of '?[' has type "
            + "'{types.display(objectType)}', which is not a nullable array.", node.span());
        return this.store.errorType();
    }

    checkIndexIsInteger(Type indexType, Span span) {
        if (!(indexType is ErrorType) && !convert.isIntegerType(indexType)) {
            this.reporter.report("Array index must be an integer, got "
                + "'{types.display(indexType)}'", span);
        }
    }

    analyzeInterpolatedString(InterpolatedStringExpressionNode node) -> Type {
        this.checkInterpolationHole(node.firstHole());
        for (long i = 0; i < node.continuationsCount(); i++) {
            this.checkInterpolationHole(node.continuations(i).hole());
        }
        return this.store.stringType();
    }

    // A hole must be a string, integer, bool, enum, class, interface, or JSON-serializable
    // struct value; a hole mentioning a type parameter is checked per instantiation.
    checkInterpolationHole(Expression hole) {
        Type analyzed = this.analyzeExpression(hole);
        if (analyzed is ErrorType) {
            return;
        }
        if (analyzed is OptionalType) {
            let guidance = this.weakFieldGuidance(hole);
            if (guidance != null) {
                this.reporter.report("Cannot interpolate a value of type "
                    + "'{types.display(analyzed)}' because it may be null. {guidance}",
                    hole.span());
                return;
            }
        }
        if (convert.containsTypeParam(analyzed)) {
            this.recordObligation(new InterpolationObligation(analyzed, hole.span()));
            return;
        }
        let issue = obligations.interpolationIssue(analyzed);
        if (issue != null) {
            this.reporter.report(issue, hole.span());
        }
    }

    analyzeTry(TryExpressionNode node) -> Type {
        if (!(node.operand() is CallExpressionNode)) {
            this.reporter.report("'try' must directly prefix a single call, e.g. 'try f(x)' "
                + "or 'try obj.m()'.", node.span());
        }
        Type analyzed = this.analyzeExpression(node.operand());
        this.noteThrowEscapePoint();
        return analyzed;
    }

    // Array literal with no target type: the first element's type drives the rest.
    analyzeArrayLiteral(ArrayLiteralExpressionNode node) -> Type {
        if (node.elementsCount() == 0) {
            this.reporter.report("Cannot infer element type from an empty array literal; "
                + "annotate the type, e.g. 'int[] xs = [];'.", node.span());
            return this.store.errorType();
        }
        Type elementType = this.analyzeExpression(node.elements(0));
        if (elementType is ErrorType) {
            for (long i = 1; i < node.elementsCount(); i++) {
                this.analyzeExpression(node.elements(i));
            }
            return this.store.errorType();
        }
        if (elementType is NullType) {
            this.reporter.report("Cannot infer element type from 'null' alone; annotate the "
                + "array's element type, e.g. 'T?[] xs = [null, ...];'.",
                node.elements(0).span());
            for (long i = 1; i < node.elementsCount(); i++) {
                this.analyzeExpression(node.elements(i));
            }
            return this.store.errorType();
        }
        for (long i = 1; i < node.elementsCount(); i++) {
            Type actual = this.analyzeExpressionAdapt(node.elements(i), elementType);
            if (actual is ErrorType) {
                continue;
            }
            if (!convert.isAssignableStrict(elementType, actual)) {
                this.reporter.report("Element {i + 1}: expected "
                    + "'{types.display(elementType)}', got '{types.display(actual)}'"
                    + "{this.valueAssignabilityHint(elementType, actual, node.elements(i))}",
                    node.elements(i).span());
            }
        }
        return this.store.arrayOf(elementType);
    }

    // Array literal with a target type: each element adapts to the target's element type. The
    // target may be an array or an array under any number of optional levels; the wrapping
    // applies at the use site.
    analyzeArrayLiteralAdapt(ArrayLiteralExpressionNode node, Type target) -> Type {
        if (target is ErrorType) {
            return this.analyzeArrayLiteral(node);
        }
        Type arrayType = convert.coreOf(target);
        if (arrayType is ArrayType) {
            Type elementType = arrayType.element();
            for (long i = 0; i < node.elementsCount(); i++) {
                Type actual = this.analyzeExpressionAdapt(node.elements(i), elementType);
                if (actual is ErrorType) {
                    continue;
                }
                if (!convert.isAssignableStrict(elementType, actual)) {
                    this.reporter.report("Element {i + 1}: expected "
                        + "'{types.display(elementType)}', got '{types.display(actual)}'"
                        + "{this.valueAssignabilityHint(elementType, actual, node.elements(i))}",
                        node.elements(i).span());
                }
            }
            return arrayType;
        }
        this.reporter.report("Cannot assign array literal to non-array type "
            + "'{types.display(target)}'.", node.span());
        for (long i = 0; i < node.elementsCount(); i++) {
            this.analyzeExpression(node.elements(i));
        }
        return this.store.errorType();
    }

    // A '\{...\}' literal with no target type: nothing to infer against.
    analyzeStructLiteral(StructLiteralExpressionNode node) -> Type {
        for (long i = 0; i < node.fieldsCount(); i++) {
            this.analyzeExpression(node.fields(i).value());
        }
        this.reporter.report("Cannot tell which struct this '\{...\}' literal builds. Annotate "
            + "the target with a struct type or use a constructor, e.g. "
            + "'Point p = \{x: 1, y: 2\};'.", node.span());
        return this.store.errorType();
    }

    // A struct literal with a target type: every field is set by name against the target struct's
    // declared fields, with the same visibility, adaptation, and assignability rules as a direct
    // field write.
    analyzeStructLiteralAdapt(StructLiteralExpressionNode node, Type target) -> Type {
        if (target is ErrorType) {
            return this.analyzeStructLiteral(node);
        }
        Type structType = convert.coreOf(target);
        if (!isStructValue(structType)) {
            this.reporter.report("Cannot build '{types.display(target)}' from a '\{...\}' "
                + "literal; that type is not a struct.", node.span());
            for (long i = 0; i < node.fieldsCount(); i++) {
                this.analyzeExpression(node.fields(i).value());
            }
            return this.store.errorType();
        }
        this.result.setType(node.green(), structType);
        let fields = types.fieldsOf(structType);
        if (fields == null) {
            return structType;
        }
        string structShown = structDisplayName(structType);
        let provided = new List<bool>();
        for (long i = 0; i < fields.length(); i++) {
            provided.push(false);
        }
        for (long i = 0; i < node.fieldsCount(); i++) {
            let entry = node.fields(i);
            string fieldName = entry.name().text();
            long index = fieldIndexNamed(fields, fieldName);
            if (index < 0) {
                this.reporter.report("Struct '{structShown}' has no field named "
                    + "'{fieldName}'.", entry.name().span());
                this.analyzeExpression(entry.value());
                continue;
            }
            if (provided.get(index)) {
                this.reporter.report("Field '{fieldName}' is set more than once in this struct "
                    + "literal.", entry.name().span());
                this.analyzeExpression(entry.value());
                continue;
            }
            provided.set(index, true);
            let field = fields.get(index);
            this.checkMemberAccess(fieldName, field.visibility(), field.definingType(),
                entry.name().span());
            Type fieldType = field.type();
            Type valueType = this.analyzeExpressionAdapt(entry.value(), fieldType);
            if (!(valueType is ErrorType) && !(fieldType is ErrorType)
                    && !convert.isAssignableStrict(fieldType, valueType)) {
                this.reporter.report("Field '{fieldName}': expected "
                    + "'{types.display(fieldType)}', got '{types.display(valueType)}'"
                    + "{this.valueAssignabilityHint(fieldType, valueType, entry.value())}",
                    entry.value().span());
            }
        }
        for (long i = 0; i < fields.length(); i++) {
            if (provided.get(i)) {
                continue;
            }
            let field = fields.get(i);
            if (field.hasDefault()) {
                continue;
            }
            this.reporter.report("Struct literal for '{structShown}' is missing the required "
                + "field '{field.name()}'. Add '{field.name()}: ...' or give the field a "
                + "default value.", node.span());
        }
        return structType;
    }

    // 'StructName(args)': a by-value struct built through its constructor. Resolution mirrors
    // class-constructor resolution (overloads, named and optional arguments) with no allocation.
    analyzeStructConstructorCall(CallExpressionNode node, Type structType, string name)
            -> Type {
        let arguments = node.arguments();
        Type target = structType;
        if (target is StructType && target.isGeneric()) {
            let typeArguments = node.typeArguments();
            if (typeArguments == null) {
                this.reporter.report("Cannot tell which instantiation of the generic struct "
                    + "'{name}' to build; write the type arguments explicitly, e.g. "
                    + "'{name}<int, string>(...)'.", node.span());
                this.analyzeArgumentsOnly(arguments);
                return structType;
            }
            target = this.resolver.instantiateGeneric(target, name, typeArguments, node.span());
            if (target is ErrorType) {
                this.analyzeArgumentsOnly(arguments);
                return target;
            }
        }
        this.result.setType(node.green(), target);
        let allConstructors = constructorsOf(target);
        let constructors = this.existingOnly(allConstructors);
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            this.clearNarrowingsForArguments(arguments);
            return target;
        }
        if (constructors.length() == 0) {
            this.reporter.report("Struct '{name}' has no constructor to call; build it with an "
                + "aggregate literal, e.g. '{name} value = \{...\};', or add a "
                + "'constructor(...)'.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return target;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter,
                node.span(), name, "Constructor");
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible()) {
                            this.checkConstructorAccess(target, chosenMethod, node.span());
                        }
                        this.result.setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
            this.clearNarrowingsForArguments(arguments);
            return target;
        }
        let structConstructor = constructors.get(0);
        this.checkConstructorAccess(target, structConstructor, node.span());
        this.result.setMethod(node.green(), structConstructor);
        this.checkDirectArguments("Constructor", name, structConstructor.signature(),
            arguments, node.span());
        this.clearNarrowingsForArguments(arguments);
        return target;
    }

    // ---- Member access ----

    // The type whose members a receiver exposes: a bounded type parameter exposes the members
    // of its bounds, the first bound declaring the member winning; inside a conditional member
    // the constraint's extra bounds count. Optional receivers are rejected before this point.
    memberReceiverCore(Type analyzed, string memberName) -> Type {
        Type core = analyzed;
        if (core is TypeParamType) {
            Type[] bounds = this.effectiveBoundsOf(core);
            for (let bound in bounds) {
                if (!(this.lookupMember(bound, memberName) is MissingMember)) {
                    return bound;
                }
            }
            if (bounds.length > 0) {
                return bounds[0];
            }
        }
        return core;
    }

    // The parameter's declared bounds plus whatever the active conditional member's constraint
    // adds to it.
    effectiveBoundsOf(TypeParamType parameter) -> Type[] {
        Type[] extra = types.extraBoundsFor(parameter, this.resolver.activeConstraintOwner(),
            this.resolver.activeConstraints());
        if (extra.length == 0) {
            return parameter.bounds();
        }
        let combined = new List<Type>();
        for (let bound in parameter.bounds()) {
            combined.push(bound);
        }
        for (let bound in extra) {
            combined.push(bound);
        }
        return combined.toArray();
    }

    lookupMember(Type record, string name) -> MemberLookup {
        let field = members.findField(types.fieldsOf(record), name);
        if (field != null) {
            return new FieldMember(field);
        }
        let candidates = this.availableMethods(record, name);
        if (candidates.length() > 0) {
            return new MethodMember(candidates);
        }
        return new MissingMember();
    }

    // ---- Conditional members ----

    // The name's method candidates that exist on their defining types, judged under the active
    // constraint scope; a conditional member excluded here surfaces through the
    // unmet-constraint reporting instead.
    availableMethods(Type record, string name) -> List<Method> {
        return this.existingOnly(methodCandidates(record, name));
    }

    availableStatics(Type owner, string name) -> List<Method> {
        return this.existingOnly(staticsNamed(owner, name));
    }

    existingOnly(List<Method> candidates) -> List<Method> {
        bool anyConditional = false;
        for (long i = 0; i < candidates.length(); i++) {
            if (candidates.get(i).isConditional()) {
                anyConditional = true;
            }
        }
        if (!anyConditional) {
            return candidates;
        }
        let kept = new List<Method>();
        for (long i = 0; i < candidates.length(); i++) {
            if (this.resolver.memberExists(candidates.get(i))) {
                kept.push(candidates.get(i));
            }
        }
        return kept;
    }

    // The conditional candidates the receiver's type arguments exclude.
    missingConditional(List<Method> candidates) -> List<Method> {
        let missing = new List<Method>();
        for (long i = 0; i < candidates.length(); i++) {
            let candidate = candidates.get(i);
            if (candidate.isConditional() && !this.resolver.memberExists(candidate)) {
                missing.push(candidate);
            }
        }
        return missing;
    }

    // Reports why a member access missed when the receiver's type arguments exclude a
    // conditional member with the name. True when it reported.
    reportUnmetConstraintMember(Type receiver, string name, Span span) -> bool {
        return this.reportFirstUnmet(this.missingConditional(methodCandidates(receiver, name)),
            span);
    }

    reportFirstUnmet(List<Method> missing, Span span) -> bool {
        for (long i = 0; i < missing.length(); i++) {
            let member = missing.get(i);
            let failed = this.resolver.firstUnmetConstraint(member);
            if (failed != null) {
                let template = types.authorityOf(member.definingType());
                if (template != null) {
                    this.reporter.report(this.unmetConstraintMessage(member, template,
                        types.typeArgumentsOf(member.definingType()), failed), span);
                    return true;
                }
            }
        }
        return false;
    }

    // A call that reaches no available overload but fits an excluded conditional one reports
    // the unmet constraint instead of a mismatched-overload error. True when it reported.
    reportUnmetConstraintCall(List<Method> allCandidates, List<Method> available,
                              ArgumentListNode? arguments, Span span) -> bool {
        long count = 0;
        if (arguments != null) {
            if (usesNamedArguments(arguments)) {
                return false;
            }
            count = arguments.argumentsCount();
        }
        let missing = this.missingConditional(allCandidates);
        if (missing.length() == 0) {
            return false;
        }
        if (available.length() == 0) {
            return this.reportFirstUnmet(missing, span);
        }
        for (long i = 0; i < available.length(); i++) {
            if (fitsArgumentCount(available.get(i).signature(), count)) {
                return false;
            }
        }
        let fitting = new List<Method>();
        for (long i = 0; i < missing.length(); i++) {
            if (fitsArgumentCount(missing.get(i).signature(), count)) {
                fitting.push(missing.get(i));
            }
        }
        return this.reportFirstUnmet(fitting, span);
    }

    // "'sort' exists on 'List<T>' only when 'T' satisfies 'Comparable<T>'; in 'List<Widget>',
    // 'T' is 'Widget', which does not implement 'Comparable<Widget>'."
    unmetConstraintMessage(Method member, DeclaredType template, Type[] arguments,
                           FailedConstraint failed) -> string {
        string templateShown = "{template.name()}<{typeParameterExample(template)}>";
        string what = "'{member.name()}' exists on '{templateShown}'";
        if (member.isConstructor()) {
            what = "This constructor of '{templateShown}' exists";
        }
        string parameterName = template.typeParameters()[failed.parameterIndex()];
        string declaredBound = types.display(failed.bound());
        Type argument = arguments[failed.parameterIndex()];
        string shownArgument = types.display(argument);
        if (argument is TypeParamType) {
            return "{what} only when '{parameterName}' satisfies '{declaredBound}'; here "
                + "nothing constrains '{shownArgument}' to satisfy it. Constrain the enclosing "
                + "member the same way, as in '<{shownArgument}: "
                + "{types.display(failed.boundHere())}>', or add the bound where "
                + "'{shownArgument}' is declared.";
        }
        string ownerShown = "{template.name()}<{typeArgumentsText(arguments)}>";
        string failurePhrase = "which does not implement "
            + "'{types.display(failed.boundHere())}'";
        if (!types.isInterfaceLike(failed.bound())) {
            failurePhrase = "which is not '{types.display(failed.boundHere())}' or a subclass "
                + "of it";
        }
        return "{what} only when '{parameterName}' satisfies '{declaredBound}'; in "
            + "'{ownerShown}', '{parameterName}' is '{shownArgument}', {failurePhrase}.";
    }

    // Export members are visible everywhere and public ones package-wide; private members are
    // visible inside the declaring type, and protected ones in a subclass method or anywhere
    // in the module that declares the type.
    isAccessAllowed(Visibility visibility, Type definingType) -> bool {
        let defining = types.authorityOf(definingType);
        if (defining == null) {
            return true;
        }
        DeclaredType? current = null;
        let site = this.enclosingOwner;
        if (site != null) {
            current = types.authorityOf(site);
        }
        return types.memberAccessAllowed(visibility, defining, current, this.modulePath,
            this.packagePrefix);
    }

    // Reports a denied access and answers whether it was allowed, so a caller layering its own
    // diagnostic on the same node can stay quiet after a denial.
    checkMemberAccess(string memberName, Visibility visibility, Type definingType,
                              Span span) -> bool {
        if (this.isAccessAllowed(visibility, definingType)) {
            return true;
        }
        string owner = types.display(definingType);
        string kind = "type";
        let authority = types.authorityOf(definingType);
        if (authority != null) {
            owner = authority.name();
            kind = types.kindWordOf(authority);
        }
        if (visibility == Visibility.Private) {
            this.reporter.report("'{memberName}' is private to {kind} '{owner}' and can only "
                + "be accessed from inside '{owner}'", span);
        } else if (visibility == Visibility.Public) {
            string packageName = "its own package";
            if (authority != null && authority.packagePrefix().length > 0) {
                packageName = "package '{authority.packagePrefix()}'";
            }
            this.reporter.report("'{memberName}' of '{owner}' is public inside {packageName} "
                + "but not exported. Mark it 'export' to use it from another package.", span);
        } else {
            this.reporter.report("'{memberName}' is protected to {kind} '{owner}' and can only "
                + "be accessed from inside '{owner}', a subclass of it, or the file where "
                + "'{owner}' is declared", span);
        }
        return false;
    }

    // Constructor calls run through the same accessibility rules as any other member; only the
    // wording is constructor-specific.
    checkConstructorAccess(Type ownerType, Method chosenConstructor, Span span) {
        if (this.isAccessAllowed(chosenConstructor.visibility(),
                chosenConstructor.definingType())) {
            return;
        }
        string name = types.display(ownerType);
        let ownerAuthority = types.authorityOf(ownerType);
        if (ownerAuthority != null) {
            name = ownerAuthority.name();
        }
        let authority = types.authorityOf(chosenConstructor.definingType());
        if (chosenConstructor.visibility() == Visibility.Private) {
            string fix = "export";
            if (authority != null && authority.packagePrefix() == this.packagePrefix) {
                fix = "public";
            }
            this.reporter.report("The constructor of '{name}' is private and can only be "
                + "called from inside '{name}'. Mark it '{fix}' to construct '{name}' here.",
                span);
        } else if (chosenConstructor.visibility() == Visibility.Public) {
            string packageName = "its own package";
            if (authority != null && authority.packagePrefix().length > 0) {
                packageName = "package '{authority.packagePrefix()}'";
            }
            this.reporter.report("The constructor of '{name}' is public inside {packageName} "
                + "but not exported. Mark it 'export' to construct '{name}' from another "
                + "package.", span);
        } else {
            this.reporter.report("The constructor of '{name}' is protected; only '{name}', "
                + "its subclasses, and the file that declares '{name}' can call it.", span);
        }
    }

    analyzeMemberValue(MemberExpressionNode node) -> Type {
        let object = node.object();
        string name = node.member().text();
        if (object is IdentifierExpressionNode) {
            string objectName = object.name().text();
            let resolution = this.resolveName(objectName);
            if (resolution is NamespaceName) {
                return this.analyzeNamespaceMemberType(resolution.targetModulePath, name,
                    node.member().span());
            }
            let enumType = this.enumTypeNamed(objectName, resolution);
            if (enumType != null) {
                this.result.setType(object.green(), enumType);
                long ordinal = enumOrdinal(enumType, name);
                if (ordinal >= 0) {
                    this.result.setEnumConstant(node.green(), ordinal);
                    return enumType;
                }
                this.reporter.report("'{name}' is not a member of enum '{enumType.name()}'",
                    node.member().span());
                return this.store.errorType();
            }
        }
        let staticHead = this.resolveStaticHead(object);
        if (staticHead != null) {
            return this.analyzeStaticMemberValue(node, object, staticHead);
        }
        Type objectType = this.analyzeExpression(object);
        if (objectType is ErrorType) {
            return this.store.errorType();
        }
        if (objectType is OptionalType) {
            let guidance = this.weakFieldGuidance(object);
            if (guidance != null) {
                this.reporter.report("Cannot read a member of '{types.display(objectType)}' "
                    + "because it may be null here. {guidance}", node.span());
            } else if (objectType.inner() is OptionalType) {
                this.reporter.report("Cannot read a member of '{types.display(objectType)}' "
                    + "because it may be null at more than one level. Unwrap one level at a "
                    + "time, with a null check ('if (value != null)') or a fallback "
                    + "('value ?? null'), until what remains is "
                    + "'{types.display(convert.coreOf(objectType))}'.", node.span());
            } else {
                this.reporter.report("Cannot read a member of '{types.display(objectType)}' "
                    + "because it may be null here. Check it for null first "
                    + "('if (value != null)'), read it with '?.' to get a nullable result, or "
                    + "supply a fallback with '??'.", node.span());
            }
            return this.store.errorType();
        }
        Type core = this.memberReceiverCore(objectType, name);
        if (core is ArrayType) {
            if (name == "length") {
                return this.store.primitive(PrimitiveKind.Long);
            }
            this.reporter.report("Type '{types.display(core)}' has no member '{name}'; "
                + "arrays only have 'length'.", node.member().span());
            return this.store.errorType();
        }
        if (core is StringType) {
            if (name == "length") {
                return this.store.primitive(PrimitiveKind.Long);
            }
            if (types.bindingOf(core) == null) {
                this.reporter.report("Type 'string' has no member '{name}'.",
                    node.member().span());
                return this.store.errorType();
            }
        }
        if (core is FunctionType) {
            return this.reportFunctionMember(name, core, node.member().span());
        }
        if (!isRecordLike(core)) {
            this.reporter.report("Cannot read a member of '{types.display(core)}' because it "
                + "has no members.", node.span());
            return this.store.errorType();
        }
        switch (this.lookupMember(core, name)) {
            is FieldMember found -> {
                if (!this.checkMemberAccess(name, found.field.visibility(),
                        found.field.definingType(), node.member().span())) {
                    this.result.markMemberAccessDenied(node.green());
                }
                Type fieldType = found.field.type();
                if (fieldType is OptionalType || types.isClassLike(fieldType)) {
                    let path = this.buildNarrowingPath(node, false);
                    if (path != null) {
                        let proven = this.narrowing.provenType(path);
                        if (proven != null) {
                            return proven;
                        }
                    }
                }
                return fieldType;
            },
            is MethodMember found -> {
                if (found.candidates.length() <= 1) {
                    let single = found.candidates.get(0);
                    this.checkMemberAccess(name, single.visibility(), single.definingType(),
                        node.member().span());
                }
                this.result.setMethod(node.green(), found.candidates.get(0));
                return this.store.errorType();
            },
            is MissingMember ignored -> {
                if (this.reportStaticThroughInstance(core, name, node.member().span())) {
                    return this.store.errorType();
                }
                if (this.reportUnmetConstraintMember(core, name, node.member().span())) {
                    return this.store.errorType();
                }
                this.reporter.report("No field or method '{name}' on type "
                    + "'{types.display(core)}'", node.member().span());
                return this.store.errorType();
            },
        }
    }

    // The C# rule: a static is reachable only through the declaring type's name, so reaching it
    // through an instance is an error that names the spelling to use, wherever in the chain the
    // static lives. True when it reported.
    reportStaticThroughInstance(Type receiver, string name, Span at) -> bool {
        Type? current = receiver;
        while (current != null) {
            bool isMethod = staticsNamed(current, name).length() > 0;
            if (isMethod || members.findField(types.staticFieldsOf(current), name) != null) {
                let authority = types.authorityOf(current);
                string ownerName = types.display(current);
                if (authority != null) {
                    ownerName = authority.name();
                }
                string spelled = "'{ownerName}.{name}'";
                if (isMethod) {
                    spelled = "'{ownerName}.{name}(...)'";
                }
                this.reporter.report("Use {spelled}; a static belongs to the type, not to an "
                    + "instance.", at);
                return true;
            }
            current = types.baseOf(current);
        }
        return false;
    }

    analyzeSafeMemberValue(SafeMemberExpressionNode node) -> Type {
        Type objectType = this.analyzeExpression(node.object());
        if (objectType is ErrorType) {
            return this.store.errorType();
        }
        objectType = this.presenceOperandType(node.object(), objectType);
        if (!(objectType is OptionalType)) {
            this.reporter.report("The value on the left of '?.' has type "
                + "'{types.display(objectType)}', which can never be null. Use '.' to access "
                + "its members.", node.span());
            return this.store.errorType();
        }
        Type inner = objectType.inner();
        if (inner is OptionalType) {
            this.reporter.report("The value on the left of '?.' has type "
                + "'{types.display(objectType)}', which is nullable at more than one level, "
                + "and '?.' looks through only one. Unwrap one level first: check the value "
                + "for null ('if (value != null)') or supply a fallback ('value ?? null'), "
                + "then use '?.' on the '{types.display(inner)}' that remains.", node.span());
            return this.store.errorType();
        }
        string name = node.member().text();
        if ((inner is StringType || inner is ArrayType) && name == "length") {
            return this.safeResultOf(this.store.primitive(PrimitiveKind.Long));
        }
        if (!isRecordLike(inner)) {
            this.reporter.report("The value on the left of '?.' has type "
                + "'{types.display(objectType)}', which has no members to access.", node.span());
            return this.store.errorType();
        }
        switch (this.lookupMember(inner, name)) {
            is FieldMember found -> {
                if (!this.checkMemberAccess(name, found.field.visibility(),
                        found.field.definingType(), node.member().span())) {
                    this.result.markMemberAccessDenied(node.green());
                }
                return this.safeResultOf(found.field.type());
            },
            is MethodMember found -> {
                if (found.candidates.length() <= 1) {
                    let single = found.candidates.get(0);
                    this.checkMemberAccess(name, single.visibility(), single.definingType(),
                        node.member().span());
                }
                this.result.setMethod(node.green(), found.candidates.get(0));
                return this.store.errorType();
            },
            is MissingMember ignored -> {
                if (this.reportStaticThroughInstance(inner, name, node.member().span())) {
                    return this.store.errorType();
                }
                if (this.reportUnmetConstraintMember(inner, name, node.member().span())) {
                    return this.store.errorType();
                }
                this.reporter.report("No field or method named '{name}' on "
                    + "'{types.display(inner)}'.", node.member().span());
                return this.store.errorType();
            },
        }
    }

    analyzeNamespaceMemberType(string targetPath, string name, Span span) -> Type {
        let found = this.store.findDeclared(targetPath, name);
        if (found == null) {
            this.reporter.report("Module '{targetPath}' has no type named '{name}'.", span);
            return this.store.errorType();
        }
        if (!types.isVisibleFrom(found.visibility(), found.modulePath(), found.packagePrefix(),
                this.modulePath, this.packagePrefix)) {
            this.reporter.report(types.notVisibleMessage("Type", name, found.visibility(),
                found.modulePath(), found.packagePrefix(), this.packagePrefix), span);
            return this.store.errorType();
        }
        return found;
    }

    enumTypeNamed(string objectName, NameResolution? resolution) -> EnumType? {
        if (resolution == null) {
            let found = this.store.findDeclared(this.modulePath, objectName);
            if (found is EnumType) {
                return found;
            }
            return null;
        }
        if (resolution is TypeName) {
            let target = resolution.target;
            if (target is EnumType) {
                return target;
            }
        }
        return null;
    }

    // ---- Static members ----

    // What a member access's written head names when it is a type rather than a value: the
    // declared type of a bare name, the instantiation of a 'Name<Args>' head, or a type
    // parameter, which the static paths then reject by name. Null when the head is a value (or
    // a namespace or enum, which the callers handled first); the error type when the head named
    // a type but its arguments did not resolve, after a diagnostic.
    resolveStaticHead(Expression object) -> Type? {
        switch (object) {
            is IdentifierExpressionNode identifier -> {
                return this.staticHeadNamed(identifier.name().text());
            },
            is GenericNameExpressionNode generic -> {
                return this.resolveGenericHead(generic);
            },
            default -> {
                return null;
            },
        }
    }

    // The type a bare head name stands for: a primitive's own keyword names the primitive, then
    // locals shadow types, a type parameter wins over an imported name exactly as it does in a
    // type position, and the module's own declarations answer last. Enums stay with the
    // enum-member path.
    staticHeadNamed(string name) -> Type? {
        if (name.length == 0) {
            return null;
        }
        let primitive = types.primitiveNamed(this.store, name);
        if (primitive != null) {
            return primitive;
        }
        let resolution = this.resolveName(name);
        if (resolution == null) {
            let parameter = this.resolver.typeParameterNamed(name);
            if (parameter != null) {
                return parameter;
            }
            let declared = this.store.findDeclared(this.modulePath, name);
            if (declared != null && !(declared is EnumType)) {
                return declared;
            }
            return null;
        }
        if (resolution is TypeName && !(resolution.target is EnumType)) {
            return resolution.target;
        }
        return null;
    }

    // A 'Name<Args>' head: the name must be a generic type this file can see, and the written
    // arguments instantiate it, bounds checked by the resolver.
    resolveGenericHead(GenericNameExpressionNode generic) -> Type? {
        let head = generic.head();
        if (!(head is IdentifierExpressionNode)) {
            this.reporter.report("Type arguments follow a plain type name here, as in "
                + "'List<int>.withCapacity(8)'; this expression cannot take them.",
                generic.typeArguments().span());
            return this.store.errorType();
        }
        string name = head.name().text();
        let named = this.staticHeadNamed(name);
        if (named == null) {
            this.reporter.report("'{name}' is not a type, so it cannot take type arguments "
                + "here; only a generic type's name does, as in 'List<int>.withCapacity(8)'.",
                head.span());
            return this.store.errorType();
        }
        if (named is TypeParamType) {
            this.reportTypeParameterHead(named, generic.span());
            return this.store.errorType();
        }
        if (named is DeclaredType) {
            if (!named.isGeneric()) {
                this.reporter.report("Type '{name}' is not generic and takes no type "
                    + "arguments.", generic.typeArguments().span());
                return this.store.errorType();
            }
            Type instantiated = this.resolver.instantiateGeneric(named, name,
                generic.typeArguments(), generic.span());
            if (!(instantiated is ErrorType)) {
                this.result.setType(generic.green(), instantiated);
            }
            return instantiated;
        }
        return this.store.errorType();
    }

    reportTypeParameterHead(TypeParamType parameter, Span at) {
        this.reporter.report("Statics cannot be reached through a type parameter: "
            + "'{parameter.name()}' stands for a different type in every instantiation, so "
            + "'{parameter.name()}.member' names nothing the compiler can resolve. Name the "
            + "type itself.", at);
    }

    // A member read whose head is a type name: a static const resolves to its constant value, a
    // static method must be called, and everything else explains where the member actually
    // lives.
    analyzeStaticMemberValue(MemberExpressionNode node, Expression object, Type head) -> Type {
        if (head is ErrorType) {
            return this.store.errorType();
        }
        if (head is TypeParamType) {
            this.reportTypeParameterHead(head, node.span());
            return this.store.errorType();
        }
        this.result.setType(object.green(), head);
        string name = node.member().text();
        let owner = types.authorityOf(head);
        if (owner == null || types.staticFieldsOf(head) == null) {
            this.reportStaticsUnsupported(head, node.span());
            return this.store.errorType();
        }
        let field = members.findField(types.staticFieldsOf(head), name);
        if (field != null) {
            this.checkMemberAccess(name, field.visibility(), field.definingType(),
                node.member().span());
            this.result.setStaticConstField(node.green(), field);
            return field.type();
        }
        if (this.availableStatics(head, name).length() > 0) {
            this.reporter.report("Static method '{name}' of '{owner.name()}' must be called; "
                + "write '{owner.name()}.{name}(...)'.", node.member().span());
            return this.store.errorType();
        }
        this.reportMissingStatic(head, owner, name, node.member().span());
        return this.store.errorType();
    }

    // Interfaces, enums, and external types carry no statics, and neither does a primitive the
    // standard library declares no members for; the error names where they live.
    reportStaticsUnsupported(Type head, Span at) {
        string shown = types.display(head);
        if (head is StringType || head is PrimitiveType) {
            this.reporter.report("'{shown}' has no static members; what the members of a "
                + "primitive are is declared by the standard library.", at);
            return;
        }
        string kind = "type";
        let authority = types.authorityOf(head);
        if (authority != null) {
            kind = types.kindWordOf(authority);
            shown = authority.name();
        }
        this.reporter.report("The {kind} '{shown}' has no static members; statics belong on "
            + "classes and structs.", at);
    }

    // The member is not a static of the named type: an instance member is reached through a
    // value, a base class's static through the base's own name, and anything else is unknown.
    reportMissingStatic(Type head, DeclaredType owner, string name, Span at) {
        if (!(this.lookupMember(head, name) is MissingMember)) {
            this.reporter.report("'{name}' is an instance member of '{owner.name()}', so it "
                + "is reached through an instance, not the type name; a static belongs to the "
                + "type itself. Call '{name}' on a value of type '{owner.name()}'.", at);
            return;
        }
        Type? current = types.baseOf(head);
        while (current != null) {
            if (members.findField(types.staticFieldsOf(current), name) != null
                    || staticsNamed(current, name).length() > 0) {
                let declaring = types.authorityOf(current);
                string declaringName = types.display(current);
                if (declaring != null) {
                    declaringName = declaring.name();
                }
                this.reporter.report("Statics are not inherited: '{name}' is declared by "
                    + "'{declaringName}', so it is reached only through that name. Write "
                    + "'{declaringName}.{name}'.", at);
                return;
            }
            current = types.baseOf(current);
        }
        if (this.reportFirstUnmet(this.missingConditional(staticsNamed(head, name)), at)) {
            return;
        }
        this.reporter.report("Type '{owner.name()}' has no static member '{name}'.", at);
    }

    // A call whose head is a type name: 'List<int>.withCapacity(8)', 'List.of(items)', or
    // 'Path.parse(text)'. A concrete head resolves like any single-receiver call; a bare
    // generic head first determines the type arguments from the call's own arguments and the
    // expected type, the same two sources a generic function call and an aggregate literal use.
    analyzeStaticCall(CallExpressionNode node, MemberExpressionNode member, Type head,
                      Type? expected) -> Type {
        let arguments = node.arguments();
        if (head is ErrorType) {
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        if (head is TypeParamType) {
            this.reportTypeParameterHead(head, node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        this.result.setType(member.object().green(), head);
        string name = member.member().text();
        let owner = types.authorityOf(head);
        if (owner == null || types.staticFieldsOf(head) == null) {
            this.reportStaticsUnsupported(head, node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        let writtenOnMethod = node.typeArguments();
        if (writtenOnMethod != null) {
            if (owner.isGeneric()) {
                this.reporter.report("Type arguments are never written on the method name; "
                    + "write them on the type name instead: "
                    + "'{owner.name()}<{typeParameterExample(owner)}>.{name}(...)'.",
                    writtenOnMethod.span());
            } else {
                this.reporter.report("Type arguments are never written on the method name, "
                    + "and '{owner.name()}' is not generic; remove them.",
                    writtenOnMethod.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        let constField = members.findField(types.staticFieldsOf(head), name);
        if (constField != null) {
            this.reporter.report("'{owner.name()}.{name}' is a static const, not a method, so "
                + "it cannot be called. Remove the parentheses.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        if (head is DeclaredType && head.isGeneric()) {
            return this.analyzeInferredStaticCall(node, member, head, name, expected);
        }
        let allCandidates = staticsNamed(head, name);
        let candidates = this.existingOnly(allCandidates);
        if (candidates.length() < allCandidates.length()
                && this.reportUnmetConstraintCall(allCandidates, candidates, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        if (candidates.length() == 0) {
            this.reportMissingStatic(head, owner, name, member.member().span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        return this.finishStaticCall(node, member, name, candidates);
    }

    // Resolves a static call against a concrete owner, mirroring finishMethodCall: overloads
    // and named arguments through full resolution, the single candidate checked directly.
    finishStaticCall(CallExpressionNode node, MemberExpressionNode member, string name,
                     List<Method> candidates) -> Type {
        let arguments = node.arguments();
        if (candidates.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments);
            let callCandidates = new List<CallCandidate>();
            for (long i = 0; i < candidates.length(); i++) {
                let candidate = candidates.get(i);
                callCandidates.push(new CallCandidate(candidate.signature(), candidate,
                    this.isAccessAllowed(candidate.visibility(), candidate.definingType())));
            }
            let resolved = calls.resolveCall(callCandidates, built.shape, this.reporter,
                node.span(), name, "Method");
            if (resolved.failed()) {
                return this.store.errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store.errorType();
            }
            let chosenMethod = chosen.method();
            if (chosenMethod != null) {
                if (!chosen.isAccessible()) {
                    this.checkMemberAccess(name, chosenMethod.visibility(),
                        chosenMethod.definingType(), member.member().span());
                }
                this.result.setMethod(member.green(), chosenMethod);
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        let single = candidates.get(0);
        this.checkMemberAccess(name, single.visibility(), single.definingType(),
            member.member().span());
        this.result.setMethod(member.green(), single);
        return this.checkDirectArguments("Method", name, single.signature(), arguments,
            node.span());
    }

    // A static call on a generic type written without its type arguments. Each candidate infers
    // them independently: from the arguments whose parameter is exactly one of the type's own
    // parameters (the generic-function rule), then from the expected type when it is an
    // instantiation of the same template. Explicit arguments never reach here; they resolve on
    // the type name.
    analyzeInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                              DeclaredType template, string name, Type? expected) -> Type {
        let arguments = node.arguments();
        let templateStatics = types.staticMethodsOf(template);
        if (templateStatics == null) {
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        let indexes = new List<long>();
        for (long i = 0; i < templateStatics.length(); i++) {
            if (templateStatics.get(i).name() == name) {
                indexes.push(i);
            }
        }
        if (indexes.length() == 0) {
            this.reportMissingStatic(template, template, name, member.member().span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        if (usesNamedArguments(arguments)) {
            this.reporter.report("A call that infers the type arguments of "
                + "'{template.name()}' does not support named arguments; pass the arguments "
                + "in order, or write the type arguments on the type name, as in "
                + "'{template.name()}<{typeParameterExample(template)}>.{name}(...)'.",
                node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        let argumentTypes = new List<Type>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                argumentTypes.push(this.analyzeExpression(argument));
            } else {
                argumentTypes.push(this.store.errorType());
            }
        }
        let owner = template.declaration();
        TypeParamType[] typeParameters = template.typeParameterTypes();
        long arity = typeParameters.length;
        Type[] contextArguments = [];
        if (expected != null) {
            Type core = convert.coreOf(expected);
            if (core is InstantiationType && core.template() == template) {
                contextArguments = core.arguments();
            }
        }
        let completedIndexes = new List<long>();
        let completedArguments = new List<Type[]>();
        let completedSources = new List<long[]>();
        for (long c = 0; c < indexes.length(); c++) {
            let candidate = templateStatics.get(indexes.get(c));
            let sources = new List<long>();
            let inferred = this.inferTypeArgumentVector(candidate, owner, arity, argumentTypes,
                contextArguments, sources);
            if (inferred != null) {
                completedIndexes.push(indexes.get(c));
                completedArguments.push(inferred);
                completedSources.push(sources.toArray());
            }
        }
        if (completedIndexes.length() == 0) {
            this.reporter.report("Cannot tell the type arguments for "
                + "'{template.name()}.{name}': neither the call's arguments nor the "
                + "surrounding context supplies them. Write them on the type name, as in "
                + "'{template.name()}<{typeParameterExample(template)}>.{name}(...)'.",
                node.span());
            return this.store.errorType();
        }
        let boundedIndexes = new List<long>();
        let boundedArguments = new List<Type[]>();
        let boundedSources = new List<long[]>();
        for (long c = 0; c < completedIndexes.length(); c++) {
            Type[] vector = completedArguments.get(c);
            bool satisfied = true;
            for (long k = 0; k < arity; k++) {
                if (!this.resolver.boundsSatisfied(vector[k], typeParameters[k])) {
                    satisfied = false;
                }
            }
            if (satisfied && this.unmetStaticConstraint(
                    templateStatics.get(completedIndexes.get(c)), template, vector) != null) {
                satisfied = false;
            }
            if (satisfied) {
                boundedIndexes.push(completedIndexes.get(c));
                boundedArguments.push(vector);
                boundedSources.push(completedSources.get(c));
            }
        }
        if (boundedIndexes.length() == 0) {
            Type[] vector = completedArguments.get(0);
            bool declaredHold = true;
            for (long k = 0; k < arity; k++) {
                if (!this.resolver.checkArgumentBounds(vector[k], typeParameters[k],
                        node.span())) {
                    declaredHold = false;
                }
            }
            if (declaredHold) {
                let candidate = templateStatics.get(completedIndexes.get(0));
                let failed = this.unmetStaticConstraint(candidate, template, vector);
                if (failed != null) {
                    this.reporter.report(this.unmetConstraintMessage(candidate, template,
                        vector, failed), node.span());
                }
            }
            return this.store.errorType();
        }
        if (boundedIndexes.length() == 1) {
            return this.checkInferredStaticCall(node, member, template,
                boundedIndexes.get(0), boundedArguments.get(0), argumentTypes,
                templateStatics.get(boundedIndexes.get(0)), owner, boundedSources.get(0));
        }
        return this.selectInferredStaticCall(node, member, template, name, boundedIndexes,
            boundedArguments, argumentTypes);
    }

    // The first constraint a conditional static fails at this inferred type-argument vector, or
    // null for an unconditional or satisfied candidate; the candidate is only a candidate where
    // it exists.
    unmetStaticConstraint(Method candidate, DeclaredType template, Type[] vector)
            -> FailedConstraint? {
        if (!candidate.isConditional()) {
            return null;
        }
        return types.firstFailedConstraint(this.store, candidate, template, vector,
            this.resolver.activeConstraintOwner(), this.resolver.activeConstraints());
    }

    // Per-candidate type-argument determination: the arguments fill what they can, the expected
    // type fills what is left, and a slot no source fills fails the candidate. An argument
    // matches its parameter structurally, through arrays, optionals, and instantiations of the
    // same template, so 'of(T[] values)' infers T from an 'int[]' argument.
    inferTypeArgumentVector(Method candidate, GreenNode owner, long arity,
                            List<Type> argumentTypes, Type[] contextArguments,
                            List<long> sources) -> Type[]? {
        // sources holds, per slot, the argument index that bound it, -1 for a fill from the
        // surrounding context, and -2 while unbound.
        let slots = new List<Type?>();
        for (long i = 0; i < arity; i++) {
            slots.push(null);
            sources.push(-2);
        }
        Parameter[] parameters = candidate.signature().parameters();
        for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
            if (!(argumentTypes.get(i) is ErrorType)) {
                this.unifyTypeArgument(parameters[i].type(), argumentTypes.get(i), owner,
                    arity, slots, sources, i);
            }
        }
        for (long i = 0; i < arity && i < contextArguments.length; i++) {
            if (slots.get(i) == null) {
                slots.set(i, contextArguments[i]);
                sources.set(i, -1);
            }
        }
        let resolved = new List<Type>();
        for (long i = 0; i < arity; i++) {
            let slot = slots.get(i);
            if (slot == null) {
                return null;
            }
            resolved.push(slot);
        }
        return resolved.toArray();
    }

    // One-way structural matching of a parameter type against an argument type, binding each of
    // the owner's still-open type parameters at the position it first appears. A mismatch binds
    // nothing and stays quiet: the ordinary argument checking reports it against whatever the
    // other sources determined.
    unifyTypeArgument(Type parameterType, Type argumentType, GreenNode owner, long arity,
                      List<Type?> slots, List<long> sources, long argumentIndex) {
        switch (parameterType) {
            is TypeParamType parameter -> {
                if (parameter.owner() == owner && parameter.index() < arity
                        && slots.get(parameter.index()) == null
                        && !(argumentType is NullType)) {
                    slots.set(parameter.index(), argumentType);
                    sources.set(parameter.index(), argumentIndex);
                }
            },
            is ArrayType array -> {
                if (argumentType is ArrayType) {
                    this.unifyTypeArgument(array.element(), argumentType.element(), owner,
                        arity, slots, sources, argumentIndex);
                }
            },
            is OptionalType optional -> {
                Type inner = argumentType;
                if (inner is OptionalType) {
                    inner = inner.inner();
                }
                this.unifyTypeArgument(optional.inner(), inner, owner, arity, slots, sources,
                    argumentIndex);
            },
            is InstantiationType parameterInstantiation -> {
                if (argumentType is InstantiationType
                        && argumentType.template() == parameterInstantiation.template()) {
                    Type[] parameterArguments = parameterInstantiation.arguments();
                    Type[] argumentArguments = argumentType.arguments();
                    for (long i = 0; i < parameterArguments.length
                            && i < argumentArguments.length; i++) {
                        this.unifyTypeArgument(parameterArguments[i], argumentArguments[i],
                            owner, arity, slots, sources, argumentIndex);
                    }
                }
            },
            default -> { },
        }
    }

    // The single inferred candidate: instantiate, then check the arguments against the
    // substituted signature the way a generic function call does, without re-analyzing them.
    checkInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                            DeclaredType template, long staticIndex, Type[] typeArguments,
                            List<Type> argumentTypes, Method templateCandidate,
                            GreenNode owner, long[] inferenceSources) -> Type {
        let instantiation = this.store.instantiationOf(template, typeArguments);
        this.resolver.recordInstantiationMention(instantiation);
        let resolved = this.staticAtIndex(instantiation, staticIndex);
        if (resolved == null) {
            return this.store.errorType();
        }
        this.result.setType(member.object().green(), instantiation);
        this.checkMemberAccess(resolved.name(), resolved.visibility(),
            resolved.definingType(), member.member().span());
        this.result.setMethod(member.green(), resolved);
        let signature = resolved.signature();
        Parameter[] parameters = signature.parameters();
        let arguments = node.arguments();
        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter.report("Method '{resolved.name()}' expects "
                + "{calls.expectedCountText(signature)} argument(s), got {count}",
                node.span());
        }
        for (long i = 0; i < count && i < parameters.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type parameterType = parameters[i].type();
                this.adaptIntegerLiteral(argument, parameterType);
                this.adaptCharLiteral(argument, parameterType);
                this.adaptFloatLiteral(argument, parameterType);
                Type actual = argumentTypes.get(i);
                let updated = this.result.typeOf(argument.green());
                if (updated != null) {
                    actual = updated;
                }
                if (!(parameterType is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameterType, actual)) {
                    Parameter[] templateParameters =
                        templateCandidate.signature().parameters();
                    string provenance = "";
                    if (i < templateParameters.length) {
                        provenance = inferenceProvenance(templateParameters[i].type(), owner,
                            typeArguments, inferenceSources, "write the type arguments on "
                            + "the type name, as in '{template.name()}"
                            + "<{typeParameterExample(template)}>.{resolved.name()}(...)'");
                    }
                    string hint = this.valueAssignabilityHint(parameterType, actual, argument);
                    this.reporter.report("Argument {i + 1}: expected "
                        + "'{types.display(parameterType)}', got '{types.display(actual)}'"
                        + "{hint}{sentenceSeparator(hint, provenance)}{provenance}",
                        argument.span());
                }
            }
        }
        return signature.returnType();
    }

    // Several candidates inferred complete vectors: rank their substituted signatures over the
    // already-analyzed arguments and let overload resolution pick.
    selectInferredStaticCall(CallExpressionNode node, MemberExpressionNode member,
                             DeclaredType template, string name, List<long> staticIndexes,
                             List<Type[]> vectors, List<Type> argumentTypes) -> Type {
        let arguments = node.arguments();
        let shape = new CallShape();
        let values = new List<Expression?>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is Expression value -> {
                    Type analyzed = argumentTypes.get(i);
                    let updated = this.result.typeOf(value.green());
                    if (updated != null) {
                        analyzed = updated;
                    }
                    shape.positional().push(this.argumentValueOf("", value, analyzed));
                    values.push(value);
                },
                default -> {
                    shape.markErrorArgument();
                    shape.positional().push(new ArgumentValue("", this.store.errorType(),
                        false, false, 0, false, node.span()));
                    values.push(null);
                },
            }
        }
        let built = new BuiltShape(shape, values);
        let callCandidates = new List<CallCandidate>();
        let resolvedMethods = new List<Method>();
        let resolvedOwners = new List<Type>();
        for (long c = 0; c < staticIndexes.length(); c++) {
            let instantiation = this.store.instantiationOf(template, vectors.get(c));
            this.resolver.recordInstantiationMention(instantiation);
            let resolved = this.staticAtIndex(instantiation, staticIndexes.get(c));
            if (resolved == null) {
                continue;
            }
            resolvedMethods.push(resolved);
            resolvedOwners.push(instantiation);
            callCandidates.push(new CallCandidate(resolved.signature(), resolved,
                this.isAccessAllowed(resolved.visibility(), resolved.definingType())));
        }
        if (callCandidates.length() == 0) {
            return this.store.errorType();
        }
        let resolution = calls.resolveCall(callCandidates, built.shape, this.reporter,
            node.span(), name, "Method");
        if (resolution.failed()) {
            return this.store.errorType();
        }
        let chosen = resolution.chosen();
        if (chosen == null) {
            return this.store.errorType();
        }
        let chosenMethod = chosen.method();
        if (chosenMethod != null) {
            for (long c = 0; c < resolvedMethods.length(); c++) {
                if (resolvedMethods.get(c) == chosenMethod) {
                    this.result.setType(member.object().green(), resolvedOwners.get(c));
                }
            }
            if (!chosen.isAccessible()) {
                this.checkMemberAccess(name, chosenMethod.visibility(),
                    chosenMethod.definingType(), member.member().span());
            }
            this.result.setMethod(member.green(), chosenMethod);
        }
        return this.checkResolvedArguments(built, resolution, node.green());
    }

    // The instantiation's static at a template list position; the lists fill in parallel, so
    // a miss is a compiler bug rather than a user error.
    staticAtIndex(InstantiationType instantiation, long index) -> Method? {
        this.store.ensureFilled(instantiation);
        let statics = types.staticMethodsOf(instantiation);
        if (statics == null || index >= statics.length()) {
            panic("Internal: instantiation '{types.display(instantiation)}' has no static at "
                + "position {index}");
        }
        return statics.get(index);
    }

    // A 'Name<Args>' head reached as a value: the parser only builds it before a '.', so this
    // is a recovery path, but it still explains itself.
    analyzeGenericNameValue(GenericNameExpressionNode generic) -> Type {
        this.reporter.report("A type name with type arguments is not a value; it can only "
            + "start a static member access, as in 'List<int>.withCapacity(8)'.",
            generic.span());
        return this.store.errorType();
    }

    // ---- Call shapes and argument checking ----

    buildCallShape(ArgumentListNode arguments) -> BuiltShape {
        let shape = new CallShape();
        let positionalValues = new List<Expression?>();
        let namedValues = new List<Expression?>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    string name = named.name().text();
                    for (long j = 0; j < shape.named().length(); j++) {
                        if (shape.named().get(j).name() == name) {
                            this.reporter.report("Duplicate named argument '{name}'.",
                                named.name().span());
                            shape.markMalformed();
                            break;
                        }
                    }
                    if (needsTargetType(named.value())) {
                        shape.named().push(this.targetTypedArgument(name, named.value()));
                    } else {
                        Type analyzed = this.analyzeExpression(named.value());
                        this.result.setType(named.green(), analyzed);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.named().push(this.argumentValueOf(name, named.value(), analyzed));
                    }
                    namedValues.push(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter.report("'out' can only be used when calling an external "
                        + "function.", outArgument.span());
                    shape.markErrorArgument();
                    shape.positional().push(new ArgumentValue("", this.store.errorType(),
                        false, false, 0, false, outArgument.span()));
                    positionalValues.push(null);
                },
                is Expression value -> {
                    if (shape.named().length() > 0 && !shape.isMalformed()) {
                        this.reporter.report("Positional arguments must come before named "
                            + "arguments.", value.span());
                        shape.markMalformed();
                    }
                    if (needsTargetType(value)) {
                        shape.positional().push(this.targetTypedArgument("", value));
                    } else {
                        Type analyzed = this.analyzeExpression(value);
                        if (analyzed is ErrorType) {
                            shape.markErrorArgument();
                        }
                        shape.positional().push(this.argumentValueOf("", value, analyzed));
                    }
                    positionalValues.push(value);
                },
                default -> { },
            }
        }
        let values = new List<Expression?>();
        for (long i = 0; i < positionalValues.length(); i++) {
            values.push(positionalValues.get(i));
        }
        for (long i = 0; i < namedValues.length(); i++) {
            values.push(namedValues.get(i));
        }
        return new BuiltShape(shape, values);
    }

    // An argument whose type only the parameter it reaches decides, left unanalyzed until the
    // candidate is chosen.
    targetTypedArgument(string name, Expression value) -> ArgumentValue {
        let argument = new ArgumentValue(name, this.store.errorType(), false, false, 0, false,
            value.span());
        argument.markNeedsTarget();
        return argument;
    }

    argumentValueOf(string name, Expression value, Type analyzed) -> ArgumentValue {
        let literal = intLiteralOf(value);
        if (literal != null) {
            let magnitude = literalvalues.integerMagnitude(literal.value().text());
            if (magnitude != null) {
                return new ArgumentValue(name, analyzed, true, isNegativeLiteral(value),
                    magnitude, false, value.span());
            }
        }
        if (value is LiteralExpressionNode && value.value().kind() == SyntaxKind.CharLiteral) {
            return new ArgumentValue(name, analyzed, false, false,
                literalvalues.charCodepoint(value.value().text()), true, value.span());
        }
        let plain = new ArgumentValue(name, analyzed, false, false, 0, false, value.span());
        let floatLiteral = floatLiteralOf(value);
        if (floatLiteral != null) {
            plain.markFloatLiteral(literalvalues.floatMagnitude(floatLiteral.value().text()));
        }
        return plain;
    }

    // Final argument checking against the chosen candidate: adapt untyped literals to the
    // parameter types and verify assignability, mirroring the single-candidate path.
    checkResolvedArguments(BuiltShape built, CallResolution resolution,
                                   GreenNode callNode) -> Type {
        let chosen = resolution.chosen();
        if (chosen == null) {
            return this.store.errorType();
        }
        Parameter[] parameters = chosen.signature().parameters();
        long[] mapping = resolution.mapping();
        let shape = built.shape;
        for (long i = 0; i < shape.argumentCount() && i < mapping.length; i++) {
            let argument = shape.argumentAt(i);
            Type parameterType = parameters[mapping[i]].type();
            Type finalType = argument.type();
            let value = built.values.get(i);
            if (value != null && argument.needsTarget()) {
                finalType = this.analyzeExpressionAdapt(value, parameterType);
            } else if (value != null) {
                this.adaptIntegerLiteral(value, parameterType);
                this.adaptCharLiteral(value, parameterType);
                this.adaptFloatLiteral(value, parameterType);
                let updated = this.result.typeOf(value.green());
                if (updated != null) {
                    finalType = updated;
                }
            }
            if (parameterType is ErrorType || finalType is ErrorType) {
                continue;
            }
            if (!convert.isAssignableStrict(parameterType, finalType)) {
                string label = "{i + 1}";
                if (argument.name().length > 0) {
                    label = "'{argument.name()}'";
                }
                this.reporter.report("Argument {label}: expected "
                    + "'{types.display(parameterType)}', got '{types.display(finalType)}'"
                    + "{this.valueAssignabilityHint(parameterType, finalType, value)}",
                    argument.span());
            }
        }
        if (shape.named().length() > 0) {
            this.result.setArgumentOrder(callNode, mapping);
        }
        return chosen.signature().returnType();
    }

    // Argument count and type checking against a single known signature.
    checkDirectArguments(string kindWord, string displayName, Signature signature,
                                 ArgumentListNode arguments, Span callSpan) -> Type {
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter.report("{kindWord} '{displayName}' expects "
                + "{calls.expectedCountText(signature)} argument(s), got {count}", callSpan);
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is OutArgumentNode outArgument -> {
                    this.reporter.report("'out' can only be used when calling an external "
                        + "function.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i].type();
                        Type actual = this.analyzeExpressionAdapt(value, parameterType);
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter.report("Argument {i + 1}: expected "
                                + "'{types.display(parameterType)}', got "
                                + "'{types.display(actual)}'"
                                + "{this.valueAssignabilityHint(parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return signature.returnType();
    }

    analyzeArgumentsOnly(ArgumentListNode arguments) {
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.analyzeExpression(named.value());
                },
                is Expression value -> {
                    this.analyzeExpression(value);
                },
                default -> { },
            }
        }
    }

    // ---- Calls ----

    analyzeCall(CallExpressionNode node, Type? expected) -> Type {
        Type analyzed = this.analyzeCallInner(node, expected);
        this.clearNarrowingsForCall(node);
        return analyzed;
    }

    analyzeCallInner(CallExpressionNode node, Type? expected) -> Type {
        switch (node.callee()) {
            is MemberExpressionNode member -> {
                return this.analyzeMemberCall(node, member, expected);
            },
            is SafeMemberExpressionNode member -> {
                return this.analyzeSafeMemberCall(node, member);
            },
            is SuperExpressionNode chained -> {
                return this.analyzeSuperCall(node, chained);
            },
            is IdentifierExpressionNode identifier -> {
                return this.analyzeFunctionCall(node, identifier);
            },
            default -> {
                Type calleeType = this.analyzeExpression(node.callee());
                if (convert.coreOf(calleeType) is FunctionType) {
                    return this.analyzeFunctionValueCall(node, calleeType, "",
                        node.callee().span());
                }
                if (!(calleeType is ErrorType)) {
                    this.reporter.report("This expression cannot be called; call a function or "
                        + "method by name, e.g. 'f(x)' or 'value.method(x)'.", node.span());
                }
                this.analyzeArgumentsOnly(node.arguments());
                return this.store.errorType();
            },
        }
    }

    // A call on a function value: ordinary call syntax on the value itself. A function type has
    // no parameter names, so the arguments are positional and the call takes exactly as many as
    // the type declares.
    analyzeFunctionValueCall(CallExpressionNode node, Type calleeType, string calleeName,
                                     Span calleeSpan) -> Type {
        string subject = "This function value";
        if (calleeName.length > 0) {
            subject = "'{calleeName}'";
        }
        let typeArguments = node.typeArguments();
        if (typeArguments != null) {
            this.reporter.report("A function value takes no type arguments: its type "
                + "'{types.display(calleeType)}' is already fixed.", typeArguments.span());
        }
        if (calleeType is OptionalType) {
            string check = "if (value != null)";
            if (calleeName.length > 0) {
                check = "if ({calleeName} != null)";
            }
            this.reporter.report("{subject} has type '{types.display(calleeType)}', which may be "
                + "null here, so it cannot be called. Check it for null first ('{check}'), or "
                + "supply a fallback with '??'.", calleeSpan);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        if (!(calleeType is FunctionType)) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        Type[] parameters = calleeType.parameterTypes();
        let arguments = node.arguments();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            string wanted = argumentCountText(parameters.length);
            this.reporter.report("{subject} has type '{types.display(calleeType)}', so the call "
                + "takes {wanted}, got {count}.", node.span());
        }
        for (long i = 0; i < count; i++) {
            switch (arguments.arguments(i)) {
                is NamedArgumentNode named -> {
                    this.reporter.report("A function type has no parameter names, so a function "
                        + "value's arguments are given by position; write the values in order "
                        + "without '{named.name().text()}:'.", named.span());
                    this.analyzeExpression(named.value());
                },
                is OutArgumentNode outArgument -> {
                    this.reporter.report("'out' can only be used when calling an external "
                        + "function.", outArgument.span());
                },
                is Expression value -> {
                    if (i < parameters.length) {
                        Type parameterType = parameters[i];
                        Type actual = this.analyzeExpressionAdapt(value, parameterType);
                        if (!(parameterType is ErrorType) && !(actual is ErrorType)
                                && !convert.isAssignableStrict(parameterType, actual)) {
                            this.reporter.report("Argument {i + 1}: expected "
                                + "'{types.display(parameterType)}', got "
                                + "'{types.display(actual)}'"
                                + "{this.valueAssignabilityHint(parameterType, actual, value)}",
                                value.span());
                        }
                    } else {
                        this.analyzeExpression(value);
                    }
                },
                default -> { },
            }
        }
        return calleeType.returnType();
    }

    analyzeFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier)
            -> Type {
        string name = identifier.name().text();
        let resolution = this.resolveName(name);
        if (resolution == null) {
            let declared = this.store.findDeclared(this.modulePath, name);
            if (declared != null && isStructValue(declared)) {
                return this.analyzeStructConstructorCall(node, declared, name);
            }
            let ownerName = this.staticSuggestionOwner(name);
            if (ownerName != null) {
                this.reporter.report("Statics are called through the type name, even inside "
                    + "'{ownerName}'; write '{ownerName}.{name}(...)'.", identifier.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store.errorType();
            }
            this.reporter.report("Undefined function '{name}'. Check the spelling, or import "
                + "the module that declares it.", identifier.span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        if (resolution is FunctionName) {
            return this.dispatchFunctionCall(node, identifier, name, resolution.entries);
        }
        if (resolution is TypeName && isStructValue(resolution.target)) {
            return this.analyzeStructConstructorCall(node, resolution.target, name);
        }
        if (resolution is LocalName) {
            Type calleeType = this.analyzeExpression(identifier);
            if (convert.coreOf(calleeType) is FunctionType) {
                return this.analyzeFunctionValueCall(node, calleeType, name, identifier.span());
            }
            if (!(calleeType is ErrorType)) {
                this.reporter.report("'{name}' has type '{types.display(calleeType)}', which is "
                    + "not a function type, so it cannot be called.", identifier.span());
            }
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        this.reporter.report("'{name}' is not a function and cannot be called.",
            identifier.span());
        this.analyzeArgumentsOnly(node.arguments());
        return this.store.errorType();
    }

    dispatchFunctionCall(CallExpressionNode node, IdentifierExpressionNode identifier,
                                 string name, List<FunctionEntry> entries) -> Type {
        let first = entries.get(0);
        if (first.isExternal()) {
            this.result.setCallable(identifier.green(), first.signature());
            return this.analyzeExternalCall(node, first, name);
        }
        if (first.signature().isGeneric()) {
            this.result.setCallable(identifier.green(), first.signature());
            return this.analyzeGenericCall(node, first, name);
        }
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments());
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                candidates.push(new CallCandidate(entries.get(i).signature(), null, true));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter,
                node.span(), name, "Function");
            if (resolved.failed()) {
                return this.store.errorType();
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                this.result.setCallable(identifier.green(), chosen.signature());
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        this.result.setCallable(identifier.green(), first.signature());
        return this.checkDirectArguments("Function", name, first.signature(),
            node.arguments(), node.span());
    }

    analyzeMemberCall(CallExpressionNode node, MemberExpressionNode member, Type? expected)
            -> Type {
        let object = member.object();
        string memberName = member.member().text();
        if (object is IdentifierExpressionNode) {
            if (object.name().kind() == SyntaxKind.StringKeyword) {
                let owned = this.analyzeStringStatic(node, memberName);
                if (owned != null) {
                    return owned;
                }
            }
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                let handled = this.analyzeNamespaceFunctionCall(node, member,
                    resolution.targetModulePath, memberName);
                if (handled != null) {
                    return handled;
                }
            }
        }
        let staticHead = this.resolveStaticHead(object);
        if (staticHead != null) {
            return this.analyzeStaticCall(node, member, staticHead, expected);
        }
        let intercepted = this.interceptBuiltinCall(node, object, memberName);
        if (intercepted != null) {
            return intercepted;
        }
        Type memberType = this.analyzeMemberValue(member);
        this.result.setType(member.green(), memberType);
        let method = this.result.methodOf(member.green());
        if (method == null) {
            if (convert.coreOf(memberType) is FunctionType) {
                return this.analyzeFunctionValueCall(node, memberType, memberName,
                    member.member().span());
            }
            this.reportUncallableMember(member.green(), member.member().span(), memberName,
                memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(), memberName,
            object, method, false);
    }

    // The member resolved to a value rather than a method: an enum member or a field. The value
    // path reported nothing, because reading the member is fine; only calling it is not.
    reportUncallableMember(GreenNode member, Span span, string name, Type memberType) {
        if (memberType is ErrorType) {
            return;
        }
        if (this.result.memberAccessDeniedAt(member)) {
            return;
        }
        if (memberType is EnumType && this.result.enumConstantOf(member) != null) {
            this.reporter.report("'{name}' is a member of enum '{memberType.name()}', not a "
                + "method; write '{memberType.name()}.{name}' without parentheses.", span);
            return;
        }
        this.reporter.report("'{name}' is a field of type '{types.display(memberType)}', not "
            + "a method, so it cannot be called. Read it without parentheses.", span);
    }

    analyzeSafeMemberCall(CallExpressionNode node, SafeMemberExpressionNode member)
            -> Type {
        let object = member.object();
        if (object is IdentifierExpressionNode) {
            let resolution = this.resolveName(object.name().text());
            if (resolution is NamespaceName) {
                this.reporter.report("'?.' cannot be used on the module namespace "
                    + "'{object.name().text()}'; call it directly with '.'.", node.span());
                this.analyzeArgumentsOnly(node.arguments());
                return this.store.errorType();
            }
        }
        Type memberType = this.analyzeSafeMemberValue(member);
        this.result.setType(member.green(), memberType);
        let method = this.result.methodOf(member.green());
        if (method == null) {
            this.reportUncallableMember(member.green(), member.member().span(),
                member.member().text(), memberType);
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        return this.finishMethodCall(node, member.green(), member.member().span(),
            member.member().text(), object, method, true);
    }

    // Resolves the method a receiver's call picks: overloads and named arguments go through
    // full resolution; the single-candidate path checks directly. A safe call wraps a
    // non-void result optional.
    finishMethodCall(CallExpressionNode node, GreenNode memberGreen, Span memberSpan,
                             string name, Expression object, Method primary, bool isSafe)
            -> Type {
        Type receiverCore = this.store.errorType();
        let objectType = this.result.typeOf(object.green());
        if (objectType != null) {
            Type receiverType = objectType;
            if (isSafe && receiverType is OptionalType) {
                receiverType = receiverType.inner();
            }
            receiverCore = this.memberReceiverCore(receiverType, name);
        }
        let allCandidates = methodCandidates(receiverCore, name);
        let candidates = this.existingOnly(allCandidates);
        let arguments = node.arguments();
        if (candidates.length() < allCandidates.length()
                && this.reportUnmetConstraintCall(allCandidates, candidates, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        if (candidates.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments);
            let callCandidates = new List<CallCandidate>();
            for (long i = 0; i < candidates.length(); i++) {
                let candidate = candidates.get(i);
                callCandidates.push(new CallCandidate(candidate.signature(), candidate,
                    this.isAccessAllowed(candidate.visibility(), candidate.definingType())));
            }
            if (callCandidates.length() == 0) {
                callCandidates.push(new CallCandidate(primary.signature(), primary, true));
            }
            let resolved = calls.resolveCall(callCandidates, built.shape, this.reporter,
                node.span(), name, "Method");
            if (resolved.failed()) {
                return this.store.errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store.errorType();
            }
            let chosenMethod = chosen.method();
            if (chosenMethod != null) {
                if (!chosen.isAccessible()) {
                    this.checkMemberAccess(name, chosenMethod.visibility(),
                        chosenMethod.definingType(), memberSpan);
                }
                this.result.setMethod(memberGreen, chosenMethod);
            }
            Type returned = this.checkResolvedArguments(built, resolved, node.green());
            if (isSafe) {
                return this.wrapSafeResult(returned);
            }
            return returned;
        }
        Type returned = this.checkDirectArguments("Method", name, primary.signature(),
            arguments, node.span());
        if (isSafe) {
            return this.wrapSafeResult(returned);
        }
        return returned;
    }

    // A void safe call is a statement: it runs only when the receiver is non-null and
    // produces no value.
    wrapSafeResult(Type returned) -> Type {
        if (returned is ErrorType || types.isVoidType(returned)) {
            return returned;
        }
        return this.safeResultOf(returned);
    }

    // The type '?.' and '?[' answer with. Both say 'null' when the receiver is absent, and a
    // value that is already nullable carries that answer in the level it has: its own null says
    // "nothing here" just as well, so the operator adds no second level and a chain through a
    // nullable member keeps working. This is only about the level these operators add; a value
    // that arrived doubly nullable is still rejected by the operators themselves.
    safeResultOf(Type value) -> Type {
        if (value is OptionalType) {
            return value;
        }
        return this.store.optionalOf(value);
    }

    // A namespace-qualified free-function call, or null when the member is not a function of
    // the target module (the member then resolves as a type reference).
    analyzeNamespaceFunctionCall(CallExpressionNode node, MemberExpressionNode member,
                                         string targetPath, string memberName) -> Type? {
        let target = this.contextsByPath.get(targetPath);
        if (target == null) {
            return null;
        }
        let entries = target.functions().entriesNamed(memberName);
        if (entries == null || entries.length() == 0) {
            return null;
        }
        string targetPackagePrefix = target.module().packagePrefix();
        if (entries.length() > 1 || usesNamedArguments(node.arguments())) {
            let built = this.buildCallShape(node.arguments());
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < entries.length(); i++) {
                let entry = entries.get(i);
                candidates.push(new CallCandidate(entry.signature(), null,
                    types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                        this.modulePath, this.packagePrefix)));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter,
                node.span(), memberName, "Function");
            if (resolved.failed()) {
                return this.store.errorType();
            }
            let chosen = resolved.chosen();
            if (chosen == null) {
                return this.store.errorType();
            }
            this.result.setCallable(member.green(), chosen.signature());
            if (!chosen.isAccessible()) {
                Visibility chosenVisibility = Visibility.Private;
                for (long i = 0; i < entries.length(); i++) {
                    if (entries.get(i).signature() == chosen.signature()) {
                        chosenVisibility = entries.get(i).visibility();
                    }
                }
                this.reporter.report(types.notVisibleMessage("Function", memberName,
                    chosenVisibility, targetPath, targetPackagePrefix, this.packagePrefix),
                    member.member().span());
                return this.store.errorType();
            }
            return this.checkResolvedArguments(built, resolved, node.green());
        }
        let entry = entries.get(0);
        if (!types.isVisibleFrom(entry.visibility(), targetPath, targetPackagePrefix,
                this.modulePath, this.packagePrefix)) {
            this.reporter.report(types.notVisibleMessage("Function", memberName,
                entry.visibility(), targetPath, targetPackagePrefix, this.packagePrefix),
                member.member().span());
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        this.result.setCallable(member.green(), entry.signature());
        if (entry.isExternal()) {
            return this.analyzeExternalCall(node, entry, memberName);
        }
        if (targetPath == "std.ffi" && memberName == "fromCString") {
            return this.checkFromCStringCall(node.arguments(), node.span());
        }
        if (entry.signature().isGeneric()) {
            return this.analyzeGenericCall(node, entry, memberName);
        }
        return this.checkDirectArguments("Function", memberName, entry.signature(),
            node.arguments(), node.span());
    }

    // std.ffi.fromCString accepts a value of any external type - there is no common supertype to
    // write in its signature, hence the intercepted type parameter - and returns a string?. A null
    // handle yields a null string, so an unset value stays distinct from an empty one. Because the
    // call is checked here it is never routed through generic instantiation.
    checkFromCStringCall(ArgumentListNode arguments, Span callSpan) -> Type {
        Type result = this.store.optionalOf(this.store.stringType());
        long count = arguments.argumentsCount();
        if (count != 1) {
            this.reporter.report("'fromCString' expects exactly 1 argument (a foreign handle), "
                + "got {count}", callSpan);
            this.analyzeArgumentsOnly(arguments);
            return result;
        }
        switch (arguments.arguments(0)) {
            is OutArgumentNode outArgument -> {
                this.reporter.report("'out' can only be used when calling an external "
                    + "function.", outArgument.span());
            },
            is Expression value -> {
                Type actual = this.analyzeExpression(value);
                Type base = actual;
                if (base is OptionalType) {
                    base = base.inner();
                }
                if (!(actual is ErrorType) && !(base is ExternalType)) {
                    this.reporter.report("'fromCString' takes a value of an external type (a "
                        + "foreign handle), got '{types.display(actual)}'. Pass a handle "
                        + "returned by a C function.", value.span());
                }
            },
            default -> { },
        }
        return result;
    }

    analyzeSuperCall(CallExpressionNode node, SuperExpressionNode chained) -> Type {
        this.analyzeExpression(chained);
        this.sawSuperCall = true;
        Type voidType = this.store.primitive(PrimitiveKind.Void);
        if (!this.inConstructor) {
            this.reporter.report("'super(...)' can only be called from a constructor",
                node.span());
        }
        Type? base = null;
        let receiver = this.thisType;
        if (receiver != null) {
            base = types.baseOf(receiver);
        }
        if (base == null) {
            this.analyzeArgumentsOnly(node.arguments());
            return voidType;
        }
        string baseName = types.display(base);
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null) {
            baseName = baseAuthority.name();
        }
        let allConstructors = constructorsOf(base);
        let constructors = this.existingOnly(allConstructors);
        let arguments = node.arguments();
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() == 0) {
            if (arguments.argumentsCount() > 0) {
                this.reporter.report("Base class '{baseName}' has no constructor, so "
                    + "'super(...)' takes no arguments", node.span());
            }
            this.analyzeArgumentsOnly(arguments);
            return voidType;
        }
        if (constructors.length() > 1 || usesNamedArguments(arguments)) {
            let built = this.buildCallShape(arguments);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter,
                node.span(), baseName, "Base constructor");
            if (resolved.failed()) {
                return voidType;
            }
            let chosen = resolved.chosen();
            if (chosen != null) {
                let chosenMethod = chosen.method();
                if (chosenMethod != null) {
                    if (!chosen.isAccessible()) {
                        this.checkConstructorAccess(base, chosenMethod, node.span());
                    }
                    this.result.setMethod(chained.green(), chosenMethod);
                }
                this.checkResolvedArguments(built, resolved, node.green());
            }
            return voidType;
        }
        let baseConstructor = constructors.get(0);
        this.checkConstructorAccess(base, baseConstructor, node.span());
        this.result.setMethod(chained.green(), baseConstructor);
        this.checkDirectArguments("Base constructor", baseName, baseConstructor.signature(),
            arguments, node.span());
        return voidType;
    }

    // Static builtins on the 'string' type keyword: string.fromBytes(byte[]).
    // 'string.fromBytes(bytes)', the one static the compiler answers for on a primitive. Null
    // for every other name, so the general static path answers it, whether through the standard
    // library's binding or with the diagnostic for a name nothing declares.
    analyzeStringStatic(CallExpressionNode node, string memberName) -> Type? {
        let arguments = node.arguments();
        if (memberName == "fromBytes") {
            Type byteArray = this.store.arrayOf(this.store.primitive(PrimitiveKind.Byte));
            if (arguments.argumentsCount() != 1) {
                this.reporter.report("'string.fromBytes' expects 1 argument (a byte[]), got "
                    + "{arguments.argumentsCount()}.", node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store.stringType();
            }
            let argument = arguments.arguments(0);
            if (argument is Expression) {
                Type actual = this.analyzeExpression(argument);
                if (!(actual is ErrorType) && !convert.isAssignableStrict(byteArray, actual)) {
                    this.reporter.report("'string.fromBytes' expects a byte[], got "
                        + "'{types.display(actual)}'.", argument.span());
                }
            }
            return this.store.stringType();
        }
        return null;
    }

    // The built-in members of strings, arrays, and primitives, intercepted before general
    // member resolution; a record declaring its own member of the same name falls through
    // (null result) to normal resolution. What this owns on a primitive is also what a primitive
    // binding may not declare, so the two lists move together: see members.compilerOwnedMember.
    interceptBuiltinCall(CallExpressionNode node, Expression object, string name)
            -> Type? {
        if (name != "toString" && name != "toBytes" && name != "indexOf" && name != "contains"
                && name != "compareTo" && name != "startsWith" && name != "endsWith"
                && name != "trim" && name != "trimStart" && name != "substring"
                && name != "slice" && name != "hash") {
            return null;
        }
        Type objectType = this.analyzeExpression(object);
        if (objectType is ErrorType) {
            this.analyzeArgumentsOnly(node.arguments());
            return this.store.errorType();
        }
        Type core = objectType;
        let arguments = node.arguments();
        if (convert.coreOf(core) is FunctionType) {
            this.analyzeArgumentsOnly(arguments);
            return this.reportFunctionMember(name, core, node.span());
        }
        if (core is OptionalType) {
            if (name == "slice" && core.inner() is ArrayType) {
                this.reporter.report("Cannot call 'slice' on '{types.display(core)}' because "
                    + "it may be null. Check it for null first ('if (value != null)').",
                    node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store.errorType();
            }
            if (name == "hash") {
                this.checkNoArguments(node, "hash");
                return this.store.primitive(PrimitiveKind.Long);
            }
            return null;
        }
        if (name == "toString") {
            if (convert.isIntegerType(core) || convert.isBoolType(core) || core is StringType
                    || convert.isEnumLike(core) || isTextualFloat(core)) {
                this.checkNoArguments(node, "toString");
                return this.store.stringType();
            }
            if (types.isDecimalType(core)) {
                this.reporter.report("'.toString()' is not yet available for type "
                    + "'{types.display(core)}'.", node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store.errorType();
            }
            // A struct without its own toString serializes to its JSON form; one that declares
            // toString falls through to normal resolution.
            if (isStructValue(core) && types.declaredToString(core) == null) {
                this.checkNoArguments(node, "toString");
                if (convert.containsTypeParam(core)) {
                    this.recordObligation(new InterpolationObligation(core, node.span()));
                } else {
                    let issue = obligations.structJsonabilityIssue(core);
                    if (issue != null) {
                        this.reporter.report(issue, node.span());
                    }
                }
                return this.store.stringType();
            }
            // A class or interface value whose chain declares no toString answers with its
            // runtime type's text form; a chain that declares one falls through to normal
            // resolution.
            if (types.isClassLike(core) && this.availableMethods(core, "toString").length() == 0) {
                this.checkNoArguments(node, "toString");
                return this.store.stringType();
            }
            // A bare type parameter defers the judgment to each instantiation, exactly like a
            // hole; a bound that declares toString resolves the call against the contract.
            if (core is TypeParamType) {
                bool declaresToString = false;
                for (let bound in this.effectiveBoundsOf(core)) {
                    if (methodCandidates(bound, "toString").length() > 0) {
                        declaresToString = true;
                    }
                }
                if (declaresToString) {
                    return null;
                }
                this.checkNoArguments(node, "toString");
                this.recordObligation(new InterpolationObligation(core, node.span()));
                return this.store.stringType();
            }
            return null;
        }
        if (name == "toBytes") {
            if (core is StringType) {
                this.checkNoArguments(node, "toBytes");
                return this.store.arrayOf(this.store.primitive(PrimitiveKind.Byte));
            }
            return null;
        }
        if (name == "indexOf" || name == "contains") {
            if (core is StringType) {
                this.checkStringArgument(node, name);
                if (name == "indexOf") {
                    return this.store.primitive(PrimitiveKind.Long);
                }
                return this.store.primitive(PrimitiveKind.Bool);
            }
            return null;
        }
        if (name == "compareTo") {
            if (core is StringType) {
                this.checkStringArgument(node, name);
                return this.store.primitive(PrimitiveKind.Int);
            }
            return null;
        }
        if (name == "startsWith" || name == "endsWith") {
            if (core is StringType) {
                this.checkStringArgument(node, name);
                return this.store.primitive(PrimitiveKind.Bool);
            }
            return null;
        }
        if (name == "trim" || name == "trimStart") {
            if (core is StringType) {
                this.checkNoArguments(node, name);
                return this.store.stringType();
            }
            return null;
        }
        if (name == "substring") {
            if (core is StringType) {
                this.checkRangeArguments(node, "substring");
                return this.store.stringType();
            }
            return null;
        }
        if (name == "slice") {
            if (core is ArrayType) {
                this.checkRangeArguments(node, "slice");
                return core;
            }
            return null;
        }
        if (types.isVoidType(core)) {
            this.reporter.report("Cannot call 'hash' here because the expression produces no "
                + "value.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        bool declaresHash = false;
        if (core is TypeParamType) {
            for (let bound in this.effectiveBoundsOf(core)) {
                if (methodCandidates(bound, "hash").length() > 0) {
                    declaresHash = true;
                }
            }
        } else if (isRecordLike(core)) {
            declaresHash = this.availableMethods(core, "hash").length() > 0;
        }
        if (declaresHash) {
            return null;
        }
        this.checkNoArguments(node, "hash");
        return this.store.primitive(PrimitiveKind.Long);
    }

    checkNoArguments(CallExpressionNode node, string name) {
        if (node.arguments().argumentsCount() > 0) {
            this.reporter.report("'{name}' takes no arguments.", node.span());
            this.analyzeArgumentsOnly(node.arguments());
        }
    }

    // The string builtins that take one other string to work against.
    checkStringArgument(CallExpressionNode node, string name) {
        let arguments = node.arguments();
        if (arguments.argumentsCount() != 1) {
            this.reporter.report("'{name}' expects 1 argument (a string), got "
                + "{arguments.argumentsCount()}.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return;
        }
        let argument = arguments.arguments(0);
        if (argument is Expression) {
            Type actual = this.analyzeExpression(argument);
            if (!(actual is ErrorType) && !(actual is StringType)) {
                this.reporter.report("'{name}' expects a string argument, got "
                    + "'{types.display(actual)}'.", argument.span());
            }
        }
    }

    // Half-open range builtins take a start and an end index.
    checkRangeArguments(CallExpressionNode node, string name) {
        let arguments = node.arguments();
        if (arguments.argumentsCount() != 2) {
            this.reporter.report("'{name}' expects 2 arguments (start and end), got "
                + "{arguments.argumentsCount()}.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return;
        }
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type actual = this.analyzeExpression(argument);
                if (!(actual is ErrorType) && !convert.isIntegerType(actual)) {
                    this.reporter.report("'{name}' expects an integer index, got "
                        + "'{types.display(actual)}'.", argument.span());
                }
            }
        }
    }

    // A generic function call: explicit type arguments, or single-level inference from the
    // arguments whose parameter is exactly a type-parameter placeholder of the function.
    analyzeGenericCall(CallExpressionNode node, FunctionEntry entry, string name)
            -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        if (usesNamedArguments(arguments)) {
            this.reporter.report("Generic function '{name}' does not support named arguments; "
                + "pass the arguments in order.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return this.store.errorType();
        }
        let owner = signature.declaration();
        if (owner == null) {
            return signature.returnType();
        }
        let typeParameters = signature.typeParameters();
        long arity = typeParameters.length;
        let typeArguments = new List<Type?>();
        for (long i = 0; i < arity; i++) {
            typeArguments.push(null);
        }
        let explicitList = node.typeArguments();
        if (explicitList != null) {
            long given = explicitList.argumentsCount();
            if (given != arity) {
                string expected = "{arity} type arguments";
                if (arity == 1) {
                    expected = "1 type argument";
                }
                string wasWere = "were";
                if (given == 1) {
                    wasWere = "was";
                }
                this.reporter.report("Generic function '{name}' expects {expected}, but "
                    + "{given} {wasWere} given", node.span());
                this.analyzeArgumentsOnly(arguments);
                return this.store.errorType();
            }
            for (long i = 0; i < arity; i++) {
                typeArguments.set(i, this.resolver.resolveType(explicitList.arguments(i)));
            }
        }

        // A value with no type of its own - a lambda, an aggregate literal - waits for the
        // parameter it fills, which is known once the type arguments are resolved; it offers
        // nothing to infer them from either.
        let argumentTypes = new List<Type>();
        for (long i = 0; i < arguments.argumentsCount(); i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression && !needsTargetType(argument)) {
                argumentTypes.push(this.analyzeExpression(argument));
            } else {
                argumentTypes.push(this.store.errorType());
            }
        }

        Parameter[] parameters = signature.parameters();
        // Per slot: the argument index that bound it, or -2 while unbound (functions have no
        // context fills).
        let inferenceSources = new List<long>();
        for (long i = 0; i < arity; i++) {
            inferenceSources.push(-2);
        }
        if (explicitList == null) {
            for (long i = 0; i < argumentTypes.length() && i < parameters.length; i++) {
                let parameterType = parameters[i].type();
                if (parameterType is TypeParamType && parameterType.owner() == owner
                        && parameterType.index() < arity
                        && typeArguments.get(parameterType.index()) == null
                        && !(argumentTypes.get(i) is ErrorType)
                        && !(argumentTypes.get(i) is NullType)) {
                    typeArguments.set(parameterType.index(), argumentTypes.get(i));
                    inferenceSources.set(parameterType.index(), i);
                }
            }
        }

        let resolved = new List<Type>();
        for (long i = 0; i < arity; i++) {
            let argument = typeArguments.get(i);
            if (argument == null) {
                this.reporter.report("Cannot infer type argument '{typeParameters[i].name()}' "
                    + "for '{name}'; pass it explicitly, e.g. '{name}<int>(...)'",
                    node.span());
                return this.store.errorType();
            }
            resolved.push(argument);
        }
        Type[] resolvedArguments = resolved.toArray();

        bool bounded = true;
        for (long i = 0; i < arity; i++) {
            Span at = node.span();
            if (explicitList != null && i < explicitList.argumentsCount()) {
                at = explicitList.arguments(i).span();
            }
            if (!this.resolver.checkArgumentBounds(resolvedArguments[i], typeParameters[i],
                    at)) {
                bounded = false;
            }
        }

        long count = arguments.argumentsCount();
        long required = calls.requiredArgumentCount(signature);
        if (count < required || count > parameters.length) {
            this.reporter.report("Function '{name}' expects "
                + "{calls.expectedCountText(signature)} argument(s), got {count}",
                node.span());
            bounded = false;
        }
        for (long i = 0; i < count && i < parameters.length; i++) {
            let argument = arguments.arguments(i);
            if (argument is Expression) {
                Type parameterType = this.store.substitute(parameters[i].type(), owner,
                    resolvedArguments);
                Type actual = argumentTypes.get(i);
                if (needsTargetType(argument)) {
                    actual = this.analyzeExpressionAdapt(argument, parameterType);
                } else {
                    this.adaptIntegerLiteral(argument, parameterType);
                    this.adaptFloatLiteral(argument, parameterType);
                    let updated = this.result.typeOf(argument.green());
                    if (updated != null) {
                        actual = updated;
                    }
                }
                if (!(parameterType is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameterType, actual)) {
                    string provenance = "";
                    if (explicitList == null) {
                        provenance = inferenceProvenance(parameters[i].type(), owner,
                            resolvedArguments, inferenceSources.toArray(), "pass the type "
                            + "arguments explicitly, as in "
                            + "'{name}<{typeParameterNamesText(signature)}>(...)'");
                    }
                    string hint = this.valueAssignabilityHint(parameterType, actual, argument);
                    this.reporter.report("Argument {i + 1}: expected "
                        + "'{types.display(parameterType)}', got '{types.display(actual)}'"
                        + "{hint}{sentenceSeparator(hint, provenance)}{provenance}",
                        argument.span());
                }
            }
        }

        if (bounded) {
            this.result.setCallTypeArguments(node.green(), resolvedArguments);
            this.recordGenericCall(signature, resolvedArguments);
        }
        return this.store.substitute(signature.returnType(), owner, resolvedArguments);
    }

    // An external call: exact arity, no named arguments, and 'out' parameters take an
    // initialized non-constant local of exactly the parameter's type.
    analyzeExternalCall(CallExpressionNode node, FunctionEntry entry, string name)
            -> Type {
        let signature = entry.signature();
        let arguments = node.arguments();
        if (usesNamedArguments(arguments)) {
            this.reporter.report("External function '{name}' does not support named "
                + "arguments; pass the arguments in order.", node.span());
            this.analyzeArgumentsOnly(arguments);
            return signature.returnType();
        }
        Parameter[] parameters = signature.parameters();
        long count = arguments.argumentsCount();
        if (count != parameters.length) {
            this.reporter.report("External function '{name}' expects {parameters.length} "
                + "argument(s), got {count}", node.span());
        }
        for (long i = 0; i < count; i++) {
            let argument = arguments.arguments(i);
            if (i >= parameters.length) {
                this.analyzeExtraExternalArgument(argument);
                continue;
            }
            let parameter = parameters[i];
            if (parameter.isOut()) {
                if (argument is OutArgumentNode) {
                    this.checkOutArgument(argument, parameter, name, i);
                } else if (argument is Expression) {
                    this.reporter.report("Argument {i + 1} of '{name}' is an 'out' "
                        + "parameter; pass a local variable as 'out <name>'.",
                        argument.span());
                    this.analyzeExpression(argument);
                }
                continue;
            }
            if (argument is OutArgumentNode) {
                this.reporter.report("Argument {i + 1} of '{name}' is not an 'out' "
                    + "parameter; remove 'out'.", argument.span());
                continue;
            }
            if (argument is Expression) {
                Type actual = this.analyzeExpressionAdapt(argument, parameter.type());
                if (!(parameter.type() is ErrorType) && !(actual is ErrorType)
                        && !convert.isAssignableStrict(parameter.type(), actual)) {
                    this.reporter.report("Argument {i + 1}: expected "
                        + "'{types.display(parameter.type())}', got "
                        + "'{types.display(actual)}'"
                        + "{this.valueAssignabilityHint(parameter.type(), actual, argument)}",
                        argument.span());
                }
            }
        }
        return signature.returnType();
    }

    checkOutArgument(OutArgumentNode argument, Parameter parameter, string name,
                             long index) {
        string outName = argument.name().text();
        let binding = this.lookupBinding(outName);
        if (binding == null) {
            this.reporter.report("'out {outName}' must refer to a local variable or "
                + "parameter.", argument.span());
            return;
        }
        if (binding.isConst()) {
            this.reporter.report("Cannot pass '{outName}' as 'out' because it is declared "
                + "as constant; use 'let' instead of 'const' if it needs to change.",
                argument.span());
        }
        this.result.setBinding(argument.green(), binding);
        if (binding.type() != parameter.type()) {
            this.reporter.report("Argument {index + 1} of '{name}' expects "
                + "'out {types.display(parameter.type())}', got "
                + "'out {types.display(binding.type())}'.", argument.span());
            return;
        }
        // 'out' lets the callee write the caller's variable directly, so it drops even the
        // binding's own narrowing.
        this.narrowing.clearForRoot(binding);
        this.narrowing.clearForIndexBinding(binding);
    }

    analyzeExtraExternalArgument(Argument argument) {
        switch (argument) {
            is OutArgumentNode outArgument -> {
                let binding = this.lookupBinding(outArgument.name().text());
                if (binding != null) {
                    this.result.setBinding(outArgument.green(), binding);
                }
            },
            is Expression value -> {
                this.analyzeExpression(value);
            },
            default -> { },
        }
    }

    // ---- 'new' expressions ----

    analyzeNew(NewExpressionNode node) -> Type {
        let created = node.createdType();
        if (node.dimensionsCount() > 0) {
            return this.analyzeArrayNew(node, created);
        }
        if (created is OptionalTypeNode) {
            this.reporter.report("'new' always produces a value, so its type cannot be "
                + "nullable; drop the '?'.", created.span());
        }
        Type t = this.resolver.resolveType(created);
        let arguments = node.arguments();
        if (t is ErrorType) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store.errorType();
        }
        string shownName = writtenTypeName(created, t);
        if (!types.isClassLike(t)) {
            if (isStructValue(t)) {
                this.reporter.report("'new' is only for classes; '{shownName}' is a struct, "
                    + "so declare it directly ('{shownName} value;').", node.span());
            } else {
                this.reporter.report("'new' requires a class type, got '{types.display(t)}'",
                    node.span());
            }
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            return this.store.errorType();
        }
        let authority = types.authorityOf(t);
        if (authority is InterfaceType) {
            this.reporter.report("Cannot create an instance of interface '{shownName}'; "
                + "instantiate a class that implements it instead", node.span());
        } else if (authority is ClassType && authority.isAbstract()) {
            this.reporter.report("Cannot create an instance of abstract class '{shownName}'; "
                + "instantiate a concrete subclass instead", node.span());
        }
        let allConstructors = constructorsOf(t);
        let constructors = this.existingOnly(allConstructors);
        if (constructors.length() < allConstructors.length()
                && this.reportUnmetConstraintCall(allConstructors, constructors, arguments,
                    node.span())) {
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
            this.clearNarrowingsForArguments(arguments);
            return t;
        }
        if (allConstructors.length() == 0) {
            let blocked = this.excludedImplicitBaseConstructor(t);
            if (blocked != null) {
                string clause = this.excludedConstructorClause(blocked,
                    "Constrain the enclosing member the same way");
                if (clause.length > 0) {
                    this.reporter.report("Cannot construct '{shownName}': it declares no "
                        + "constructor of its own, so it needs the zero-argument constructor "
                        + "of its base class '{types.display(blocked.definingType())}', but "
                        + clause, node.span());
                    if (arguments != null) {
                        this.analyzeArgumentsOnly(arguments);
                    }
                    this.clearNarrowingsForArguments(arguments);
                    return t;
                }
            }
        }
        long argumentCount = 0;
        if (arguments != null) {
            argumentCount = arguments.argumentsCount();
        }
        bool named = arguments != null && usesNamedArguments(arguments);
        if (constructors.length() > 1 || (constructors.length() > 0 && named)) {
            let built = this.buildShapeOrEmpty(arguments);
            let candidates = new List<CallCandidate>();
            for (long i = 0; i < constructors.length(); i++) {
                candidates.push(new CallCandidate(constructors.get(i).signature(),
                    constructors.get(i), this.isAccessAllowed(
                        constructors.get(i).visibility(),
                        constructors.get(i).definingType())));
            }
            let resolved = calls.resolveCall(candidates, built.shape, this.reporter,
                node.span(), shownName, "Constructor");
            if (!resolved.failed()) {
                let chosen = resolved.chosen();
                if (chosen != null) {
                    let chosenMethod = chosen.method();
                    if (chosenMethod != null) {
                        if (!chosen.isAccessible()) {
                            this.checkConstructorAccess(t, chosenMethod, node.span());
                        }
                        this.result.setMethod(node.green(), chosenMethod);
                    }
                    this.checkResolvedArguments(built, resolved, node.green());
                }
            }
        } else if (constructors.length() > 0) {
            let classConstructor = constructors.get(0);
            this.checkConstructorAccess(t, classConstructor, node.span());
            this.result.setMethod(node.green(), classConstructor);
            if (arguments != null) {
                this.checkDirectArguments("Constructor", shownName,
                    classConstructor.signature(), arguments, node.span());
            } else if (calls.requiredArgumentCount(classConstructor.signature()) > 0) {
                this.reporter.report("Constructor '{shownName}' expects "
                    + "{calls.expectedCountText(classConstructor.signature())} argument(s), "
                    + "got 0", node.span());
            }
        } else if (argumentCount > 0) {
            this.reporter.report("Class '{shownName}' has no constructor; use "
                + "'new {shownName}()'", node.span());
            if (arguments != null) {
                this.analyzeArgumentsOnly(arguments);
            }
        }
        this.clearNarrowingsForArguments(arguments);
        return t;
    }

    buildShapeOrEmpty(ArgumentListNode? arguments) -> BuiltShape {
        if (arguments != null) {
            return this.buildCallShape(arguments);
        }
        return new BuiltShape(new CallShape(), new List<Expression?>());
    }

    // 'new T[n]': every allocated slot starts as T's zero value, so T must be defaultable -
    // unless a fill loop right after the declaration proves every slot is written first, or
    // the trailing dimensions are unsized and the slots hold nullable inner arrays.
    analyzeArrayNew(NewExpressionNode node, nodes.Type created) -> Type {
        Type element = this.resolver.resolveType(created);
        let sizes = new List<Expression>();
        long unsized = 0;
        for (long i = 0; i < node.dimensionsCount(); i++) {
            let size = node.dimensions(i).size();
            if (size != null && unsized == 0) {
                sizes.push(size);
            } else {
                unsized++;
            }
        }
        if (element is ErrorType) {
            this.analyzeSizes(sizes);
            return this.store.errorType();
        }
        if (types.isVoidType(element)) {
            this.reporter.report("Cannot create an array of void", created.span());
            this.analyzeSizes(sizes);
            return this.store.errorType();
        }
        if (sizes.length() == 0) {
            string shown = types.display(element);
            this.reporter.report("'new {shown}[...]' requires at least one sized dimension. "
                + "Use 'new {shown}[size]' for a 1-D array, or 'new {shown}[size][]' for a "
                + "partially-allocated grid.", node.span());
            return this.store.arrayOf(element);
        }
        Type slotElement = element;
        if (unsized == 0) {
            bool singleDimension = sizes.length() == 1;
            bool referenceElement = isReferenceElement(element);
            bool proven = singleDimension && referenceElement
                && this.fillProvenNews.contains(node.green());
            string fillName = "items";
            let declared = this.arrayNewNames.get(node.green());
            if (declared != null) {
                fillName = declared;
            }
            if (!proven && !this.validateArrayElement(element, created.span(),
                    singleDimension, fillName)) {
                this.analyzeSizes(sizes);
                return this.store.errorType();
            }
        } else {
            Type innerArray = element;
            for (long i = 0; i < unsized; i++) {
                innerArray = this.store.arrayOf(innerArray);
            }
            slotElement = this.store.optionalOf(innerArray);
        }
        this.analyzeSizes(sizes);
        Type arrayType = slotElement;
        for (long i = 0; i < sizes.length(); i++) {
            arrayType = this.store.arrayOf(arrayType);
        }
        return arrayType;
    }

    analyzeSizes(List<Expression> sizes) {
        for (long i = 0; i < sizes.length(); i++) {
            Type sizeType = this.analyzeExpression(sizes.get(i));
            if (!(sizeType is ErrorType) && !convert.isIntegerType(sizeType)) {
                this.reporter.report("Array size must be an integer, got "
                    + "'{types.display(sizeType)}'", sizes.get(i).span());
            }
        }
    }

    validateArrayElement(Type element, Span span, bool hasFillName, string fillName)
            -> bool {
        if (element is ErrorType) {
            return false;
        }
        if (convert.isDefaultable(element)) {
            return true;
        }
        if (element is TypeParamType) {
            return true;
        }
        string shown = types.display(element);
        string hint = "";
        if (isReferenceElement(element)) {
            if (hasFillName) {
                this.reporter.report("An array of non-nullable '{shown}' must be filled as "
                    + "it is created: assign it to a new variable and follow the declaration "
                    + "with `for (long i = 0; i < {fillName}.length; i++) \{ {fillName}[i] = "
                    + "...; \}` (the update may be written 'i++', '++i', or 'i = i + 1'). "
                    + "Alternatively use '{shown}?[]' so slots can start as null.", span);
                return false;
            }
            hint = " Use '{shown}?[]' so freshly-allocated slots can start as null.";
        } else if (isStructValue(element)) {
            let fields = types.fieldsOf(element);
            if (fields != null) {
                for (long i = 0; i < fields.length(); i++) {
                    let field = fields.get(i);
                    if (field.hasDefault()) {
                        continue;
                    }
                    if (field.isConst()) {
                        hint = " Field '{field.name()}' of '{shown}' is 'const' with no "
                            + "default value, so a freshly-allocated slot would hold a zero "
                            + "it was never assigned. Give the field a default value.";
                        break;
                    }
                    if (!convert.isDefaultable(field.type())) {
                        hint = " Field '{field.name()}' of '{shown}' has type "
                            + "'{types.display(field.type())}' which cannot start as a "
                            + "default zero value. Make that field nullable.";
                        break;
                    }
                }
            }
        }
        this.reporter.report("Cannot use '{shown}' as an array element type because "
            + "freshly-allocated slots would not be valid values of '{shown}'.{hint}", span);
        return false;
    }

    // Records single-dimension array-new declaration initializers (for diagnostic wording)
    // and proves the ones immediately followed by their canonical fill loop.
    noteArrayFillLoop(BlockNode block, long index) {
        let statement = block.statements(index);
        if (statement is VariableDeclarationNode) {
            let initializer = statement.initializer();
            if (initializer == null) {
                return;
            }
            let value = initializer.value();
            if (value is NewExpressionNode) {
                if (value.dimensionsCount() != 1 || value.dimensions(0).size() == null) {
                    return;
                }
                string name = statement.name().text();
                if (name.length == 0) {
                    return;
                }
                this.arrayNewNames.set(value.green(), name);
                if (index + 1 >= block.statementsCount()) {
                    return;
                }
                let next = block.statements(index + 1);
                if (next is ForStatementNode && isArrayFillLoop(next, name)) {
                    this.fillProvenNews.add(value.green());
                }
            }
        }
    }

    // ---- Switch arms ----

    // A switch used as a value. The target is the type its arms answer to, and is null where the
    // surroundings offer none.
    analyzeSwitchExpression(SwitchExpressionNode node, Type? target) -> Type {
        return this.checkSwitchArms(node.scrutinee(), armsOfExpression(node),
            node.switchKeyword().span(), true, target);
    }

    // Checks a switch in either form: the scrutinee kind, the labels or 'is' arm targets, arm
    // reachability, exhaustiveness, and the unified value type of the expression form.
    // Exhaustiveness reasons over the unwrapped scrutinee type; a scrutinee whose
    // narrowing-aware type is still nullable additionally needs a 'null' arm or a default.
    checkSwitchArms(Expression scrutinee, List<SwitchArm> arms, Span span,
                            bool requireValue, Type? armTargetType) -> Type {
        Type scrutineeType = this.analyzeExpression(scrutinee);
        Type inner = convert.bareOf(scrutineeType);
        bool doublyNullable = !(scrutineeType is ErrorType) && inner is OptionalType;
        if (doublyNullable) {
            this.reporter.report("Cannot switch on a value of type "
                + "'{types.display(scrutineeType)}' because it may be null at more than one "
                + "level, and a 'null ->' arm covers only the outer one. Unwrap one level "
                + "first: check the value for null ('if (value != null)') or supply a fallback "
                + "('value ?? null'), then switch on the '{types.display(inner)}' that "
                + "remains.", scrutinee.span());
        }
        bool known = !(scrutineeType is ErrorType) && !doublyNullable;
        bool classScrutinee = known && types.isClassLike(inner);
        bool valueScrutinee = known && (inner is EnumType || convert.isIntegerType(inner)
            || inner is StringType);
        bool typeSwitch = classScrutinee && hasTypeArm(arms);
        if (known) {
            if (classScrutinee && !typeSwitch) {
                this.reporter.report("A switch over a class value needs at least one "
                    + "'is Type ->' arm.", scrutinee.span());
            } else if (!classScrutinee && !valueScrutinee) {
                this.reporter.report("Cannot switch on a value of type "
                    + "'{types.display(scrutineeType)}'; switch supports enum, integer, "
                    + "string, and class values.", scrutinee.span());
            }
        }

        bool hasDefault = false;
        bool nullCovered = false;
        let coveredEnumOrdinals = new Set<long>();
        let seenIntegerLabels = new Set<long>();
        let seenStringLabels = new Set<string>();
        let armTargets = new List<Type>();
        let valueExpressions = new List<Expression>();
        bool sawValueBlock = false;
        let switchEntry = this.snapshotAssignment();
        let entryLayers = this.narrowing.snapshotLayers();
        let entryFacts = this.narrowing.flatten();
        let armFlows = new List<AssignmentFlow>();
        let armNarrowings = new List<Map<NarrowingPath, Type>>();
        for (long a = 0; a < arms.length(); a++) {
            this.restoreAssignment(switchEntry);
            this.narrowing.restoreLayers(entryLayers);
            this.unconditionalPosition = true;
            switch (arms.get(a)) {
                is DefaultArmNode arm -> {
                    if (hasDefault) {
                        this.reporter.report("A switch can have only one 'default' arm.",
                            arm.span());
                    }
                    hasDefault = true;
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings)) {
                        sawValueBlock = true;
                    }
                },
                is TypeArmNode arm -> {
                    Type armType = this.resolver.resolveType(arm.target());
                    this.result.setType(arm.target().green(), armType);
                    Type? armTarget = null;
                    if (!classScrutinee) {
                        if (valueScrutinee) {
                            this.reporter.report("An 'is' arm needs a class switch value, but "
                                + "this switch is over '{types.display(scrutineeType)}'.",
                                arm.target().span());
                        }
                    } else if (!(armType is ErrorType)) {
                        armTarget = this.checkTypeArmTarget(scrutineeType, inner, armType,
                            arm.target().span());
                    }
                    if (armTarget != null) {
                        this.checkTypeArmReachable(armTarget, armTargets, arm.target().span());
                        armTargets.push(armTarget);
                    }
                    this.enterScope();
                    let bindingToken = arm.binding();
                    if (bindingToken != null) {
                        Type bindingType = this.store.errorType();
                        if (armTarget != null) {
                            bindingType = armTarget;
                        }
                        let binding = new LocalBinding(bindingToken.text(), bindingType,
                            BindingKind.Variable, true, bindingToken.span());
                        let current = this.scope;
                        if (current != null) {
                            current.define(binding);
                        }
                        this.result.setBinding(arm.green(), binding);
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings)) {
                        sawValueBlock = true;
                    }
                    this.leaveScope();
                },
                is ValueArmNode arm -> {
                    bool mixReported = false;
                    for (long i = 0; i < arm.labelsCount(); i++) {
                        let label = arm.labels(i);
                        if (isNullLabel(label)) {
                            this.result.setType(label.green(), this.store.nullType());
                            if (!(scrutineeType is OptionalType)) {
                                this.reporter.report("'null' is only a valid label when the "
                                    + "switch value is nullable.", label.span());
                            } else if (nullCovered) {
                                this.reporter.report("Duplicate 'null' label.", label.span());
                            } else {
                                nullCovered = true;
                            }
                            continue;
                        }
                        if (typeSwitch) {
                            if (!mixReported) {
                                this.reporter.report("Cannot mix value labels with 'is' arms "
                                    + "in the same switch.", label.span());
                                mixReported = true;
                            }
                            continue;
                        }
                        if (!valueScrutinee) {
                            continue;
                        }
                        if (inner is EnumType) {
                            this.checkEnumLabel(label, inner, coveredEnumOrdinals);
                        } else if (convert.isIntegerType(inner)) {
                            this.checkIntegerLabel(label, inner, seenIntegerLabels);
                        } else {
                            this.checkStringLabel(label, seenStringLabels);
                        }
                    }
                    if (this.walkArmBodyFlow(arm.body(), requireValue, armTargetType,
                            valueExpressions, armFlows, armNarrowings)) {
                        sawValueBlock = true;
                    }
                },
            }
        }
        if (armFlows.length() > 0) {
            this.restoreAssignment(this.joinAssignment(armFlows));
        } else {
            this.restoreAssignment(switchEntry);
        }

        this.narrowing.restoreLayers(entryLayers);
        let survivors = new List<Map<NarrowingPath, Type>>();
        for (long i = 0; i < armFlows.length(); i++) {
            if (!armFlows.get(i).terminated) {
                survivors.push(armNarrowings.get(i));
            }
        }
        this.applyNarrowingJoin(entryFacts, survivors);

        if (valueScrutinee && !hasDefault) {
            this.checkValueExhaustiveness(inner, coveredEnumOrdinals, span);
        }
        if (typeSwitch && !hasDefault) {
            this.checkTypeExhaustiveness(inner, armTargets, span);
        }
        if ((valueScrutinee || typeSwitch) && scrutineeType is OptionalType && !nullCovered
                && !hasDefault) {
            this.reporter.report("This switch value can be null but no arm handles it. Add a "
                + "'null ->' arm or a 'default' arm.", span);
        }
        if (!requireValue) {
            return this.store.primitive(PrimitiveKind.Void);
        }
        if (sawValueBlock) {
            return this.store.errorType();
        }
        if (valueExpressions.length() == 0) {
            this.reporter.report("A switch used as a value needs at least one arm.", span);
            return this.store.errorType();
        }
        Type unified = this.store.errorType();
        for (long i = 0; i < valueExpressions.length(); i++) {
            let expression = valueExpressions.get(i);
            Type analyzed = this.recordedType(expression);
            if (analyzed is ErrorType) {
                return this.store.errorType();
            }
            if (i == 0) {
                unified = analyzed;
                continue;
            }
            this.adaptIntegerLiteral(expression, unified);
            this.adaptFloatLiteral(expression, unified);
            Type adapted = this.recordedType(expression);
            if (!(adapted is ErrorType)) {
                analyzed = adapted;
            }
            let joined = convert.unifyValueTypes(unified, analyzed, this.store);
            if (joined == null) {
                this.reporter.report("Switch arms produce incompatible types "
                    + "'{types.display(unified)}' and '{types.display(analyzed)}'.", span);
                return this.store.errorType();
            }
            unified = joined;
        }
        if (types.isVoidType(unified)) {
            this.reporter.report("A switch used as a value must produce a value in every "
                + "arm.", span);
            return this.store.errorType();
        }
        for (long i = 0; i < valueExpressions.length(); i++) {
            this.adaptIntegerLiteral(valueExpressions.get(i), unified);
            this.adaptFloatLiteral(valueExpressions.get(i), unified);
        }
        return unified;
    }

    // An identifier label over an enum scrutinee names a member; any other label must be an
    // expression of the enum's own type that resolved to a member constant.
    checkEnumLabel(Expression label, EnumType inner, Set<long> covered) {
        long ordinal = -1;
        if (label is IdentifierExpressionNode) {
            ordinal = enumOrdinal(inner, label.name().text());
            if (ordinal >= 0) {
                this.result.setType(label.green(), inner);
                this.result.setEnumConstant(label.green(), ordinal);
            } else {
                this.reporter.report("'{label.name().text()}' is not a member of enum "
                    + "'{types.display(inner)}'.", label.span());
            }
        } else {
            Type labelType = this.analyzeExpression(label);
            if (!(labelType is ErrorType) && labelType != inner) {
                this.reporter.report("Switch label of type '{types.display(labelType)}' does "
                    + "not match the switch value of type '{types.display(inner)}'.",
                    label.span());
            }
            let constant = this.result.enumConstantOf(label.green());
            if (constant != null) {
                ordinal = constant;
            }
        }
        if (ordinal >= 0 && !covered.add(ordinal)) {
            string memberName = inner.memberNames()[ordinal];
            this.reporter.report("Duplicate switch label '{memberName}'; remove the extra "
                + "arm.", label.span());
        }
    }

    // Integer labels are integer constants written in any integer-literal form: an int or long
    // literal by its value, a char literal by its codepoint, so 'A', 65, and 65L name the same
    // label. A literal label adapts to the scrutinee, its value fit-checked against the type.
    checkIntegerLabel(Expression label, Type inner, Set<long> seen) {
        Type labelType = this.analyzeExpression(label);
        let value = integerLabelValue(label);
        if (value == null) {
            if (!(labelType is ErrorType)) {
                if (!convert.isAssignableStrict(inner, labelType)
                        && !convert.isAssignableStrict(labelType, inner)) {
                    this.reporter.report("Switch label of type '{types.display(labelType)}' does "
                        + "not match the switch value of type '{types.display(inner)}'.",
                        label.span());
                } else {
                    this.reporter.report("Switch labels for an integer switch must be integer "
                        + "constants.", label.span());
                }
            }
            return;
        }
        if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
            this.adaptCharLiteral(label, inner);
        } else {
            this.adaptIntegerLiteralLabel(label, inner);
        }
        let adapted = this.result.typeOf(label.green());
        if (adapted != null && adapted is ErrorType) {
            return;
        }
        if (!seen.add(value)) {
            this.reporter.report("Duplicate switch label '{value}'; remove the extra arm.",
                label.span());
        }
    }

    checkStringLabel(Expression label, Set<string> seen) {
        Type labelType = this.analyzeExpression(label);
        if (!(labelType is ErrorType) && !(labelType is StringType)) {
            this.reporter.report("Switch label of type '{types.display(labelType)}' does not "
                + "match the switch value of type 'string'.", label.span());
            return;
        }
        let text = stringLabelText(label);
        if (text != null) {
            if (!seen.add(text)) {
                this.reporter.report("Duplicate switch label '{text}'; remove the extra "
                    + "arm.", label.span());
            }
        } else if (!(labelType is ErrorType)) {
            this.reporter.report("Switch labels for a string switch must be string literals.",
                label.span());
        }
    }

    // The class or interface an 'is' arm matches, or null when the arm is rejected: the
    // target must be able to match some values of the scrutinee without matching all of them.
    checkTypeArmTarget(Type scrutineeType, Type inner, Type armType, Span span)
            -> Type? {
        if (armType is OptionalType) {
            this.reporter.report("The type of an 'is' arm cannot be nullable; 'is' never "
                + "matches null. Test against '{types.display(convert.coreOf(armType))}' and "
                + "handle null with a 'null ->' arm.", span);
            return null;
        }
        if (armType is TypeParamType) {
            this.reporter.report("The type of an 'is' arm must be a concrete class; "
                + "'{types.display(armType)}' is a type parameter.", span);
            return null;
        }
        if (!types.isClassLike(armType)) {
            this.reporter.report("The type of an 'is' arm must be a class or an interface, "
                + "got '{types.display(armType)}'.", span);
            return null;
        }
        if (armType == inner) {
            this.reporter.report("'is {types.display(armType)}' matches every value of this "
                + "switch over '{types.display(scrutineeType)}'; use a 'default' arm "
                + "instead.", span);
            return null;
        }
        if (types.isSubclassOrConforms(inner, armType)) {
            this.reporter.report("A value of type '{types.display(inner)}' is always a "
                + "'{types.display(armType)}'; this arm would match every value. Use a "
                + "'default' arm instead.", span);
            return null;
        }
        if (types.isInterfaceLike(inner)) {
            return armType;
        }
        if (types.isInterfaceLike(armType)) {
            if (isFinalClass(inner)) {
                this.reporter.report("A value of type '{types.display(inner)}' can never be "
                    + "a '{types.display(armType)}': '{types.display(inner)}' is 'final' and "
                    + "does not implement it. This arm would never match. Remove it.", span);
                return null;
            }
            return armType;
        }
        if (!types.isSubclassOf(armType, inner)) {
            this.reporter.report("A value of type '{types.display(inner)}' can never be a "
                + "'{types.display(armType)}'; this arm would never match. Remove it.", span);
            return null;
        }
        return armType;
    }

    // An arm is unreachable when an earlier arm already matches every value of its type.
    checkTypeArmReachable(Type armTarget, List<Type> earlier, Span span) {
        for (long i = 0; i < earlier.length(); i++) {
            if (types.isSubclassOrConforms(armTarget, earlier.get(i))) {
                this.reporter.report("This 'is {shortTypeName(armTarget)}' arm is "
                    + "unreachable: the earlier 'is {shortTypeName(earlier.get(i))}' arm "
                    + "already matches every '{shortTypeName(armTarget)}'. Move it before "
                    + "the broader arm, or remove it.", span);
                return;
            }
        }
    }

    // An enum switch without a default must cover every member; integer and string switches
    // always need one.
    checkValueExhaustiveness(Type inner, Set<long> coveredEnumOrdinals, Span span) {
        if (inner is EnumType) {
            string[] names = inner.memberNames();
            let missing = new List<string>();
            for (long i = 0; i < names.length; i++) {
                if (!coveredEnumOrdinals.contains(i)) {
                    missing.push(names[i]);
                }
            }
            if (missing.length() > 0) {
                this.reporter.report("This switch does not handle enum "
                    + "'{types.display(inner)}' member(s) {quotedList(missing)}. Add them or "
                    + "a 'default' arm.", span);
            }
            return;
        }
        this.reporter.report("A switch on '{types.display(inner)}' must have a 'default' "
            + "arm.", span);
    }

    // A type switch without a default: an interface or an unsealed or concrete root always
    // needs one; a sealed abstract root instead needs every direct subclass covered, an arm
    // for a subclass covering its descendants.
    checkTypeExhaustiveness(Type inner, List<Type> armTargets, Span span) {
        string rootName = types.display(inner);
        let authority = types.authorityOf(inner);
        if (authority is InterfaceType) {
            this.reporter.report("A switch over '{rootName}' must have a 'default' arm: "
                + "interfaces are open, so any class anywhere may implement '{rootName}'.",
                span);
            return;
        }
        if (authority is ClassType) {
            if (!authority.isSealed()) {
                this.reporter.report("A switch over '{rootName}' must have a 'default' arm "
                    + "because '{rootName}' is not sealed.", span);
                return;
            }
            if (!authority.isAbstract()) {
                this.reporter.report("A switch over '{rootName}' must have a 'default' arm: "
                    + "'{rootName}' is concrete, so a value may be a plain '{rootName}' that "
                    + "no subclass arm matches.", span);
                return;
            }
            let missing = new List<string>();
            let subclasses = authority.directSubclasses();
            for (long i = 0; i < subclasses.length(); i++) {
                let subclass = subclasses.get(i);
                bool covered = false;
                for (long j = 0; j < armTargets.length(); j++) {
                    if (types.isSubclassOrConforms(subclass, armTargets.get(j))) {
                        covered = true;
                        break;
                    }
                }
                if (!covered) {
                    missing.push(subclass.name());
                }
            }
            if (missing.length() > 0) {
                this.reporter.report("This switch does not handle subclass(es) "
                    + "{quotedList(missing)} of sealed class '{rootName}'. Add arms for them "
                    + "or a 'default' arm.", span);
            }
        }
    }

    // The recorded type of an already-analyzed expression node.
    recordedType(Expression expression) -> Type {
        let recorded = this.result.typeOf(expression.green());
        if (recorded != null) {
            return recorded;
        }
        return this.store.errorType();
    }

    // Walks one switch arm from the state after the scrutinee and records both its assignment
    // out-state and the narrowings holding at its end, so the arms can be joined: a local
    // assigned in every arm of an exhaustive switch is assigned after, and a path narrowed by
    // every arm stays narrowed after.
    walkArmBodyFlow(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                            List<AssignmentFlow> armFlows,
                            List<Map<NarrowingPath, Type>> armNarrowings) -> bool {
        let sawBlock = this.walkArmBody(body, requireValue, target, sink, armNarrowings);
        armFlows.push(this.snapshotAssignment());
        return sawBlock;
    }

    walkArmBody(ArmBody body, bool requireValue, Type? target, List<Expression> sink,
                        List<Map<NarrowingPath, Type>> armNarrowings) -> bool {
        switch (body) {
            is BlockNode block -> {
                bool sawBlock = false;
                if (requireValue) {
                    this.reporter.report("A switch used as a value must use expression arms, "
                        + "not '\{ \}' blocks.", block.span());
                    sawBlock = true;
                }
                this.enterScope();
                this.walkBlock(block);
                armNarrowings.push(this.narrowing.flatten());
                this.leaveScope();
                return sawBlock;
            },
            is Expression expression -> {
                if (target != null) {
                    this.analyzeExpressionAdapt(expression, target);
                } else {
                    this.analyzeExpression(expression);
                }
                armNarrowings.push(this.narrowing.flatten());
                if (requireValue) {
                    sink.push(expression);
                }
                return false;
            },
            default -> {
                armNarrowings.push(this.narrowing.flatten());
                return false;
            },
        }
    }
}

// The call shape paired with each argument's written expression, positional first and named
// after, so resolved calls can adapt literals in place. An 'out' misuse leaves a null hole.
class BuiltShape {
    protected CallShape shape;
    protected List<Expression?> values;

    protected constructor(this.shape, this.values);
}

// Every method the receiver's chain declares under the name, nearest first; a base method
// whose parameter types a derived one repeats is shadowed. Constructors and destructors are
// not members.
methodCandidates(Type record, string name) -> List<Method> {
    let found = new List<Method>();
    Type? current = record;
    let seen = new Set<Type>();
    while (current != null && seen.add(current)) {
        let methods = types.methodsOf(current);
        if (methods == null) {
            break;
        }
        long derivedCount = found.length();
        for (long i = 0; i < methods.length(); i++) {
            let candidate = methods.get(i);
            if (candidate.name() != name || candidate.isConstructor()
                    || candidate.isDestructor()) {
                continue;
            }
            bool shadowed = false;
            for (long j = 0; j < derivedCount; j++) {
                if (types.sameParameterTypes(found.get(j).signature(),
                        candidate.signature())) {
                    shadowed = true;
                    break;
                }
            }
            if (!shadowed) {
                found.push(candidate);
            }
        }
        current = types.baseOf(current);
    }
    return found;
}

// True when a call with this many positional arguments could reach the signature.
fitsArgumentCount(Signature signature, long count) -> bool {
    return count >= calls.requiredArgumentCount(signature)
        && count <= signature.parameters().length;
}

// "int, string", the way a type-argument vector reads inside angle brackets.
typeArgumentsText(Type[] arguments) -> string {
    string text = "";
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + types.display(arguments[i]);
    }
    return text;
}

// The type-argument list an example spelling shows: the declaration's own parameter names, so
// 'Pair<A, B>.of(...)' reads against 'Pair<A, B>'.
typeParameterExample(DeclaredType owner) -> string {
    string[] names = owner.typeParameters();
    string example = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            example = example + ", ";
        }
        example = example + names[i];
    }
    return example;
}

// "Path.separator", the way a static const reads in a diagnostic.
staticConstDisplay(Field field) -> string {
    let owner = types.authorityOf(field.definingType());
    if (owner == null) {
        return field.name();
    }
    return "{owner.name()}.{field.name()}";
}

// The statics a type declares under the name. No chain walk: statics are not inherited, so only
// the named type's own list answers.
staticsNamed(Type owner, string name) -> List<Method> {
    let found = new List<Method>();
    let statics = types.staticMethodsOf(owner);
    if (statics != null) {
        for (long i = 0; i < statics.length(); i++) {
            if (statics.get(i).name() == name) {
                found.push(statics.get(i));
            }
        }
    }
    return found;
}

fieldIndexNamed(List<Field> fields, string name) -> long {
    for (long i = 0; i < fields.length(); i++) {
        if (fields.get(i).name() == name) {
            return i;
        }
    }
    return -1;
}

// "Field 'a'" or "Fields 'a', 'b' and 'c'", for a diagnostic naming several fields at once.
fieldListSubject(List<Field> fields) -> string {
    string subject = "Fields ";
    if (fields.length() == 1) {
        subject = "Field ";
    }
    for (long i = 0; i < fields.length(); i++) {
        if (i > 0) {
            if (i + 1 == fields.length()) {
                subject = subject + " and ";
            } else {
                subject = subject + ", ";
            }
        }
        subject = subject + "'{fields.get(i).name()}'";
    }
    return subject;
}

fieldListVerb(List<Field> fields) -> string {
    if (fields.length() == 1) {
        return "is";
    }
    return "are";
}

structDisplayName(Type structType) -> string {
    let authority = types.authorityOf(structType);
    if (authority != null) {
        return authority.name();
    }
    return types.display(structType);
}

constructorsOf(Type record) -> List<Method> {
    let found = new List<Method>();
    let methods = types.methodsOf(record);
    if (methods != null) {
        for (long i = 0; i < methods.length(); i++) {
            if (methods.get(i).isConstructor()) {
                found.push(methods.get(i));
            }
        }
    }
    return found;
}

// The receivers member lookup walks: a declaration's own members, or the members the standard
// library declares for a primitive.
isRecordLike(Type type) -> bool {
    return type is ClassType || type is InterfaceType || type is StructType
        || type is InstantiationType || types.bindingOf(type) != null;
}

isStructValue(Type type) -> bool {
    if (type is StructType) {
        return true;
    }
    if (type is InstantiationType) {
        return type.template() is StructType;
    }
    return false;
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

isReferenceElement(Type element) -> bool {
    return types.isClassLike(element) || element is ArrayType || element is StringType
        || element is ExternalType;
}

// A floating-point type converts to text, but `decimal` is reserved rather than
// implemented, so it has none even though it counts as floating-point elsewhere.
isTextualFloat(Type core) -> bool {
    return convert.isFloatType(core) && !types.isDecimalType(core);
}

isStringable(Type core) -> bool {
    return core is StringType || convert.isIntegerType(core) || convert.isBoolType(core)
        || isTextualFloat(core);
}

parameterCountText(long count) -> string {
    if (count == 1) {
        return "1 parameter";
    }
    return "{count} parameters";
}

argumentCountText(long count) -> string {
    if (count == 1) {
        return "1 argument";
    }
    return "{count} arguments";
}

// A lambda of the right arity, as a diagnostic shows the shape to write: '(a, b) -> ...'.
lambdaShapeExample(long count) -> string {
    let builder = new StringBuilder();
    builder.append("(");
    for (long i = 0; i < count; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameterExampleName(i));
    }
    builder.append(") -> ...");
    return builder.toString();
}

parameterExampleName(long index) -> string {
    return switch (index) {
        0 -> "a",
        1 -> "b",
        2 -> "c",
        default -> "p{index + 1}",
    };
}

usesNamedArguments(ArgumentListNode arguments) -> bool {
    for (long i = 0; i < arguments.argumentsCount(); i++) {
        if (arguments.arguments(i) is NamedArgumentNode) {
            return true;
        }
    }
    return false;
}

// True for a written argument that names no type of its own: an empty array literal, whose element
// type has to come from somewhere, and a '\{...\}' literal, which never names its struct. An
// overloaded call analyzes such an argument only once it has chosen the parameter it reaches.
// True for the values that have no type of their own to offer overload resolution, and are
// checked once the parameter they fill is known: an empty array literal, an aggregate literal,
// and a lambda, whose parameter and return types come from the function type it fills.
needsTargetType(Expression value) -> bool {
    if (value is ArrayLiteralExpressionNode) {
        return value.elementsCount() == 0;
    }
    return value is StructLiteralExpressionNode || value is LambdaExpressionNode;
}

enumOrdinal(EnumType enumType, string memberName) -> long {
    string[] names = enumType.memberNames();
    for (long i = 0; i < names.length; i++) {
        if (names[i] == memberName) {
            return i;
        }
    }
    return -1;
}

hasTypeArm(List<SwitchArm> arms) -> bool {
    for (long i = 0; i < arms.length(); i++) {
        if (arms.get(i) is TypeArmNode) {
            return true;
        }
    }
    return false;
}

isNullLabel(Expression label) -> bool {
    return label is LiteralExpressionNode && label.value().kind() == SyntaxKind.NullKeyword;
}

// The source spelling of an expression simple enough to quote in an example: a name, 'this',
// a literal, or field and subscript hops over those. Null for anything longer.
simpleSpelling(Expression expression) -> string? {
    Expression core = unwrapParentheses(expression);
    switch (core) {
        is IdentifierExpressionNode identifier -> {
            return identifier.name().text();
        },
        is ThisExpressionNode ignored -> {
            return "this";
        },
        is LiteralExpressionNode literal -> {
            return literal.value().text();
        },
        is MemberExpressionNode member -> {
            let object = simpleSpelling(member.object());
            if (object == null) {
                return null;
            }
            return "{object}.{member.member().text()}";
        },
        is SubscriptExpressionNode subscript -> {
            let object = simpleSpelling(subscript.object());
            let index = simpleSpelling(subscript.index());
            if (object == null || index == null) {
                return null;
            }
            return "{object}[{index}]";
        },
        default -> {
            return null;
        },
    }
}

// A primitive flowing into an interface-typed slot it conforms to. The conformance its binding
// declares is a compile-time judgment: it lets a generic bound take the primitive, and nothing
// more, because a primitive is never wrapped in an object and so has no interface value.
primitiveConformanceHint(Type target, Type source) -> string {
    if (types.bindingOf(source) == null) {
        return "";
    }
    Type slot = target;
    while (slot is OptionalType) {
        slot = slot.inner();
    }
    if (!types.isInterfaceLike(slot) || !types.conformsTo(source, slot)) {
        return "";
    }
    string shown = types.display(source);
    string named = types.display(slot);
    return ". '{shown}' does implement '{named}', but only as a generic bound: a "
        + "'<T: {named}>' parameter accepts '{shown}', while an interface-typed slot needs a "
        + "value that carries the interface, and a primitive is never wrapped in one. Write the "
        + "slot as '{shown}', or make it a type parameter bounded by '{named}'.";
}

// Guidance appended to an assignability failure: a primitive flowing into an interface it
// conforms to, or a source nullable at more levels than the slot it flows into, each of which has
// to be unwrapped.
assignabilityHint(Type target, Type source) -> string {
    if (target is ErrorType) {
        return "";
    }
    string conformance = primitiveConformanceHint(target, source);
    if (conformance.length > 0) {
        return conformance;
    }
    if (source is OptionalType) {
        long levels = 0;
        Type remaining = source;
        while (remaining is OptionalType) {
            remaining = remaining.inner();
            levels++;
            if (!convert.isAssignableStrict(target, remaining)) {
                continue;
            }
            if (levels == 1) {
                return ". The value may be null here; check it first "
                    + "('if (value != null)'), or supply a fallback with '??'.";
            }
            return ". The value may be null at {levels} separate levels, and each one has to "
                + "be unwrapped: check it for null ('if (value != null)') or supply a fallback "
                + "('value ?? null'), once per level.";
        }
        return "";
    }
    if (source is NullType && !(target is OptionalType)) {
        return ". '{types.display(target)}' can never be null; write the type as "
            + "'{types.displayNullable(target)}' if it should allow null.";
    }
    return "";
}

// The provenance sentence for an argument mismatch whose expected type contains an inferred
// type argument: which parameter, what it was bound to, where the binding came from, and the
// explicit form that overrides inference. Empty when the expected type mentions no inferred
// parameter; the caller joins it with sentenceSeparator.
inferenceProvenance(Type templateParameterType, GreenNode owner, Type[] bindings,
                    long[] sources, string explicitForm) -> string {
    let parameter = firstBoundParameter(templateParameterType, owner, sources);
    if (parameter == null) {
        return "";
    }
    long slot = parameter.index();
    if (slot >= bindings.length) {
        return "";
    }
    string origin = "from the surrounding context";
    if (sources[slot] >= 0) {
        origin = "from argument {sources[slot] + 1}";
    }
    return "'{parameter.name()}' was inferred as '{types.display(bindings[slot])}' "
        + "{origin}; {explicitForm}.";
}

// Joins a follow-on sentence to a diagnostic whose optional preceding hint already ends with
// a period, so the two never produce a doubled one.
sentenceSeparator(string before, string sentence) -> string {
    if (sentence.length == 0) {
        return "";
    }
    if (before.length > 0) {
        return " ";
    }
    return ". ";
}

// The first type parameter of 'owner' inside the type that inference actually bound, walking
// the same shapes unification walks.
firstBoundParameter(Type templateType, GreenNode owner, long[] sources) -> TypeParamType? {
    switch (templateType) {
        is TypeParamType parameter -> {
            if (parameter.owner() == owner && parameter.index() < sources.length
                    && sources[parameter.index()] != -2) {
                return parameter;
            }
            return null;
        },
        is ArrayType array -> {
            return firstBoundParameter(array.element(), owner, sources);
        },
        is OptionalType optional -> {
            return firstBoundParameter(optional.inner(), owner, sources);
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                let found = firstBoundParameter(argument, owner, sources);
                if (found != null) {
                    return found;
                }
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

typeParameterNamesText(Signature signature) -> string {
    string text = "";
    let parameters = signature.typeParameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            text = text + ", ";
        }
        text = text + parameters[i].name();
    }
    return text;
}

// Guidance for a comparison against 'null' over a value that can never be null.
nullComparisonHint(Type left, Type right) -> string {
    Type other = left;
    if (left is NullType) {
        other = right;
    } else if (!(right is NullType)) {
        return "";
    }
    return ". A value of type '{types.display(other)}' can never be null; make its type "
        + "nullable ('{types.displayNullable(other)}') if it should allow null.";
}

isNullLiteral(Expression expression) -> bool {
    return expression is LiteralExpressionNode
        && expression.value().kind() == SyntaxKind.NullKeyword;
}

// The binary operator a compound-assignment token stands for ('+=' gives '+'), or Invalid when
// the token is not a compound assignment.
compoundOperator(SyntaxKind token) -> SyntaxKind {
    switch (token) {
        PlusEquals -> {
            return SyntaxKind.Plus;
        },
        MinusEquals -> {
            return SyntaxKind.Minus;
        },
        StarEquals -> {
            return SyntaxKind.Star;
        },
        SlashEquals -> {
            return SyntaxKind.Slash;
        },
        PercentEquals -> {
            return SyntaxKind.Percent;
        },
        AmpersandEquals -> {
            return SyntaxKind.Ampersand;
        },
        PipeEquals -> {
            return SyntaxKind.Pipe;
        },
        CaretEquals -> {
            return SyntaxKind.Caret;
        },
        LessLessEquals -> {
            return SyntaxKind.LessLess;
        },
        GreaterGreaterEquals -> {
            return SyntaxKind.GreaterGreater;
        },
        GreaterGreaterGreaterEquals -> {
            return SyntaxKind.GreaterGreaterGreater;
        },
        default -> {
            return SyntaxKind.Invalid;
        },
    }
}

unwrapParentheses(Expression expression) -> Expression {
    Expression current = expression;
    while (current is ParenthesizedExpressionNode) {
        current = current.inner();
    }
    return current;
}

// The constant an integer switch label names: a char literal's codepoint, or an int or long
// literal's value behind an optional sign.
integerLabelValue(Expression label) -> long? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.CharLiteral) {
        return literalvalues.charCodepoint(label.value().text()) as long;
    }
    let literal = integerLiteralOf(label, true);
    if (literal == null) {
        return null;
    }
    let magnitude = literalvalues.integerMagnitude(literal.value().text());
    if (magnitude == null) {
        return null;
    }
    long value = magnitude as long;
    if (isNegativeLiteral(label)) {
        return 0 - value;
    }
    return value;
}

// A string label's decoded value, so two spellings of the same string (for example "\t" and a
// literal tab) collide as a duplicate.
stringLabelText(Expression label) -> string? {
    if (label is LiteralExpressionNode && label.value().kind() == SyntaxKind.StringLiteral) {
        return literalvalues.decodeString(label.value().text());
    }
    return null;
}

shortTypeName(Type type) -> string {
    let authority = types.authorityOf(type);
    if (authority != null) {
        return authority.name();
    }
    return types.display(type);
}

quotedList(List<string> names) -> string {
    string joined = "";
    for (long i = 0; i < names.length(); i++) {
        if (i > 0) {
            joined = joined + ", ";
        }
        joined = joined + "'" + names.get(i) + "'";
    }
    return joined;
}

// The written name of a created type, for constructor diagnostics.
writtenTypeName(nodes.Type created, Type resolved) -> string {
    if (created is NamedTypeNode) {
        return created.name().text();
    }
    return types.display(resolved);
}

// The literal an untyped integer adaptation applies to: the literal itself, or one behind a
// single '+' or '-' prefix. 'allowLong' also accepts a typed long literal, as switch labels do.
integerLiteralOf(Expression node, bool allowLong) -> LiteralExpressionNode? {
    if (node is LiteralExpressionNode) {
        if (isIntegerLiteralKind(node.value().kind(), allowLong)) {
            return node;
        }
        return null;
    }
    if (node is PrefixExpressionNode) {
        SyntaxKind operator = node.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            return null;
        }
        let operand = node.operand();
        if (operand is LiteralExpressionNode
                && isIntegerLiteralKind(operand.value().kind(), allowLong)) {
            return operand;
        }
    }
    return null;
}

intLiteralOf(Expression node) -> LiteralExpressionNode? {
    return integerLiteralOf(node, false);
}

isIntegerLiteralKind(SyntaxKind kind, bool allowLong) -> bool {
    if (kind == SyntaxKind.IntLiteral) {
        return true;
    }
    return allowLong && kind == SyntaxKind.LongLiteral;
}

isNegativeLiteral(Expression node) -> bool {
    if (node is PrefixExpressionNode) {
        return node.operator().kind() == SyntaxKind.Minus;
    }
    return false;
}

// The narrowest integer kind past `from` that holds the value, for a suggestion. Empty when no
// integer kind does, which is the only case with nothing to reach for.
widerIntegerHolding(bool negative, ulong magnitude, PrimitiveKind from) -> string {
    bool fromIsLong = from == PrimitiveKind.Long;
    if (negative) {
        if (!fromIsLong && magnitude <= 9223372036854775808) {
            return "long";
        }
        return "";
    }
    if (!fromIsLong && magnitude <= 9223372036854775807) {
        return "long";
    }
    return "ulong";
}

// The unsuffixed floating-point literal a value is written as, behind an optional sign. A
// suffix names the type, so '1.0f' is a float and '1.0d' a double the way '5L' is a long, and
// neither adapts.
floatLiteralOf(Expression node) -> LiteralExpressionNode? {
    if (node is LiteralExpressionNode) {
        if (isUnsuffixedFloatLiteral(node)) {
            return node;
        }
        return null;
    }
    if (node is PrefixExpressionNode) {
        SyntaxKind operator = node.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            return null;
        }
        let operand = node.operand();
        if (operand is LiteralExpressionNode && isUnsuffixedFloatLiteral(operand)) {
            return operand;
        }
    }
    return null;
}

isUnsuffixedFloatLiteral(LiteralExpressionNode literal) -> bool {
    if (literal.value().kind() != SyntaxKind.DoubleLiteral) {
        return false;
    }
    byte[] raw = literal.value().text().toBytes();
    if (raw.length == 0) {
        return false;
    }
    byte last = raw[raw.length - 1];
    return last != 'f' && last != 'F' && last != 'd' && last != 'D';
}

// ---- The canonical fill loop ----

identName(Expression node) -> string {
    if (node is IdentifierExpressionNode) {
        return node.name().text();
    }
    return "";
}

isIntegerLiteralText(Expression node, string text) -> bool {
    if (node is LiteralExpressionNode) {
        SyntaxKind kind = node.value().kind();
        if (kind == SyntaxKind.IntLiteral || kind == SyntaxKind.LongLiteral) {
            return node.value().text() == text;
        }
    }
    return false;
}

isPlainIndexType(nodes.Type reference) -> bool {
    if (reference is NamedTypeNode) {
        string name = reference.name().text();
        if (name != "long" && name != "int") {
            return false;
        }
        return reference.qualifier() == null && reference.typeArguments() == null;
    }
    return false;
}

// A step-by-one update on the index: 'i = i + 1', 'i++', or '++i'.
isUnitIncrement(Expression update, string indexName) -> bool {
    if (update is AssignmentExpressionNode) {
        if (update.operator().kind() != SyntaxKind.Equals) {
            return false;
        }
        if (identName(update.target()) != indexName) {
            return false;
        }
        return isPlusOne(update.value(), indexName);
    }
    if (update is PostfixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus
            && identName(update.operand()) == indexName;
    }
    if (update is PrefixExpressionNode) {
        return update.operator().kind() == SyntaxKind.PlusPlus
            && identName(update.operand()) == indexName;
    }
    return false;
}

isPlusOne(Expression value, string indexName) -> bool {
    if (value is BinaryExpressionNode) {
        return value.operator().kind() == SyntaxKind.Plus
            && identName(value.left()) == indexName
            && isIntegerLiteralText(value.right(), "1");
    }
    return false;
}

// Any identifier token spelling the name counts as a mention; the fill expression must
// provably never read the array.
mentionsIdentifier(GreenNode node, string name) -> bool {
    for (long i = 0; i < node.slotCount(); i++) {
        let child = node.slot(i);
        if (child == null) {
            continue;
        }
        if (child is GreenToken) {
            if (child.kind() == SyntaxKind.Identifier && child.text() == name) {
                return true;
            }
        } else if (child is GreenNode) {
            if (mentionsIdentifier(child, name)) {
                return true;
            }
        }
    }
    return false;
}

// Matches 'for (long i = 0; i < name.length; i = i + 1) { name[i] = expr; }' (the update also
// accepts 'i++' and '++i') with a fresh 'long'/'int' index and 'expr' never mentioning 'name'.
isArrayFillLoop(ForStatementNode loop, string arrayName) -> bool {
    let indexName = fillLoopIndexName(loop, arrayName);
    if (indexName == null) {
        return false;
    }
    if (!fillLoopConditionMatches(loop.condition(), arrayName, indexName)) {
        return false;
    }
    let update = loop.update();
    if (update == null || !isUnitIncrement(update, indexName)) {
        return false;
    }
    return fillLoopBodyMatches(loop.body(), arrayName, indexName);
}

// The fresh 'long'/'int' index the loop declares starting at 0, or null when the initializer
// does not match.
fillLoopIndexName(ForStatementNode loop, string arrayName) -> string? {
    let initializer = loop.initializer();
    if (initializer is VariableDeclarationNode) {
        let declaredType = initializer.declaredType();
        if (declaredType != null && !isPlainIndexType(declaredType)) {
            return null;
        }
        let initialValue = initializer.initializer();
        if (initialValue == null || !isIntegerLiteralText(initialValue.value(), "0")) {
            return null;
        }
        string indexName = initializer.name().text();
        if (indexName.length == 0 || indexName == arrayName) {
            return null;
        }
        return indexName;
    }
    return null;
}

fillLoopConditionMatches(Expression? condition, string arrayName, string indexName)
        -> bool {
    if (condition is BinaryExpressionNode) {
        if (condition.operator().kind() != SyntaxKind.Less) {
            return false;
        }
        if (identName(condition.left()) != indexName) {
            return false;
        }
        let lengthAccess = condition.right();
        if (lengthAccess is MemberExpressionNode) {
            return identName(lengthAccess.object()) == arrayName
                && lengthAccess.member().text() == "length";
        }
    }
    return false;
}

fillLoopBodyMatches(BlockNode body, string arrayName, string indexName) -> bool {
    if (body.statementsCount() != 1) {
        return false;
    }
    let statement = body.statements(0);
    if (statement is ExpressionStatementNode) {
        let assignment = statement.expression();
        if (assignment is AssignmentExpressionNode) {
            if (assignment.operator().kind() != SyntaxKind.Equals) {
                return false;
            }
            let slot = assignment.target();
            if (slot is SubscriptExpressionNode) {
                if (identName(slot.object()) != arrayName
                        || identName(slot.index()) != indexName) {
                    return false;
                }
                return !mentionsIdentifier(assignment.value().green(), arrayName);
            }
        }
    }
    return false;
}

// The element type argument when the type is an 'Iterable<T>' instantiation from
// '@std.collections.iterator'.
iterableArgument(Type candidate) -> Type? {
    if (candidate is InstantiationType) {
        let template = candidate.template();
        if (template is InterfaceType && template.name() == "Iterable"
                && template.modulePath() == "std.collections.iterator"
                && candidate.arguments().length > 0) {
            return candidate.arguments()[0];
        }
    }
    return null;
}

armsOfStatement(SwitchStatementNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        arms.push(node.arms(i));
    }
    return arms;
}

armsOfExpression(SwitchExpressionNode node) -> List<SwitchArm> {
    let arms = new List<SwitchArm>();
    for (long i = 0; i < node.armsCount(); i++) {
        arms.push(node.arms(i));
    }
    return arms;
}
