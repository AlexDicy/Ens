// The body phase: every function, method, constructor, destructor, and test body is walked with
// lexical scopes, and every expression is typed and checked. Cross-module reads are lookups into
// the frozen declaration universe; the type store is the only shared-mutable point. Conditions,
// guards, and straight-line assignments narrow the storage paths they prove, and every read
// consults those proofs, so nullability and downcast checking see flow-refined types.
import @ens.frontend.syntax.generated.nodes;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import ParameterListNode from @ens.frontend.syntax.generated.nodes;
import CatchClauseNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import Statement from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import VariableDeclarationNode from @ens.frontend.syntax.generated.nodes;
import IfStatementNode from @ens.frontend.syntax.generated.nodes;
import WhileStatementNode from @ens.frontend.syntax.generated.nodes;
import ForStatementNode from @ens.frontend.syntax.generated.nodes;
import ForEachStatementNode from @ens.frontend.syntax.generated.nodes;
import BreakStatementNode from @ens.frontend.syntax.generated.nodes;
import ContinueStatementNode from @ens.frontend.syntax.generated.nodes;
import ReturnStatementNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import ThrowStatementNode from @ens.frontend.syntax.generated.nodes;
import RethrowStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchArm from @ens.frontend.syntax.generated.nodes;
import ValueArmNode from @ens.frontend.syntax.generated.nodes;
import TypeArmNode from @ens.frontend.syntax.generated.nodes;
import DefaultArmNode from @ens.frontend.syntax.generated.nodes;
import ArmBody from @ens.frontend.syntax.generated.nodes;
