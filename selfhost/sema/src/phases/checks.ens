// Declaration-level checks that run after layout: struct by-value containment cycles, the
// field-default ordering rule, field initialization, the declared-throws contracts, and the
// signature-leakage rule. All of them read resolved members; none of them type expressions.
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import RelatedLocation from support.diagnostics;
import support.diagnostics;
import ModuleContext from context;
import phases.layout;
import phases.valuecycles;
import ValueComponent from phases.valuecycles;
import phases.members;
import model.convert;
import model.hierarchy;
import model.typemembers;
import MemberConstraint from model.typemembers;
import Field from model.typemembers;
import Method from model.typemembers;
import phases.declare;
import Signature from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import InstantiationType from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import StructType from model.types;
import InterfaceType from model.types;
import PrimitiveBinding from model.types;
import TypeParamType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

public checkProgram(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let references = new ProgramReferences(contexts);
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new ModuleChecks(contexts.get(i), collected, references);
        checker.run();
    }
    return diagnostics.sorted(collected);
}

// What the declarations of a program reach from other modules and from other types, which a fix that
// lowers a declaration's visibility would break: by module path, the names other modules import from
// it, whether another module imports it whole, which reaches its functions, and whether another module
// imports from it at all; and by type, the types that extend or implement it.
final class ProgramReferences {
    Map<string, Set<string>> namedImports;
    Set<string> wholeImports;
    Map<DeclaredType, List<DeclaredType>> derivedTypes;

    protected constructor(List<ModuleContext> contexts) {
        this.namedImports = new Map<string, Set<string>>();
        this.wholeImports = new Set<string>();
        this.derivedTypes = new Map<DeclaredType, List<DeclaredType>>();
        for (let context in contexts) {
            this.noteDerivedTypes(context);
            let records = context.declarations().imports();
            let targets = context.module().importTargets();
            for (long i = 0; i < records.length && i < targets.length; i++) {
                let target = targets[i];
                if (target == null || target == context.module().canonicalPath()) {
                    continue;
                }
                if (!records[i].isNamed()) {
                    this.wholeImports.add(target);
                    continue;
                }
                let names = this.namedImports.get(target);
                if (names == null) {
                    names = new Set<string>();
                    this.namedImports.set(target, names);
                }
                names.add(records[i].name());
            }
        }
    }

    // Records each type the module declares under the types it extends or implements.
    noteDerivedTypes(ModuleContext context) {
        let store = context.resolver().typeStore();
        string modulePath = context.module().canonicalPath();
        for (let declaration in context.declarations().types()) {
            let declared = store.findDeclared(modulePath, declaration.name());
            switch (declared) {
                is ClassType classType -> {
                    this.noteDerived(classType.base(), classType);
                    for (let implemented in classType.interfaces()) {
                        this.noteDerived(implemented, classType);
                    }
                },
                is InterfaceType interfaceType -> {
                    this.noteDerived(interfaceType.base(), interfaceType);
                },
                is StructType structType -> {
                    for (let implemented in structType.interfaces()) {
                        this.noteDerived(implemented, structType);
                    }
                },
                default -> { },
            }
        }
    }

    noteDerived(Type? base, DeclaredType derived) {
        if (base == null) {
            return;
        }
        let authority = types.authorityOf(base);
        if (authority == null) {
            return;
        }
        let found = this.derivedTypes.get(authority);
        if (found == null) {
            found = new List<DeclaredType>();
            this.derivedTypes.set(authority, found);
        }
        found.push(derived);
    }

    // Whether a module other than the one at 'modulePath' imports its type 'name' by name, the only way
    // another module names a type.
    protected typeImportedElsewhere(string modulePath, string name) -> bool {
        let names = this.namedImports.get(modulePath);
        return names != null && names.contains(name);
    }

    // Whether a module other than the one at 'modulePath' imports it whole, the only way another module
    // reaches its functions.
    protected importedWholeElsewhere(string modulePath) -> bool {
        return this.wholeImports.contains(modulePath);
    }

    // Whether a module other than the one at 'modulePath' imports anything from it.
    protected importedElsewhere(string modulePath) -> bool {
        return this.wholeImports.contains(modulePath) || this.namedImports.get(modulePath) != null;
    }

    // The types that extend or implement 'declared' directly.
    protected derivedFrom(DeclaredType declared) -> List<DeclaredType> {
        return this.derivedTypes.get(declared) ?? new List<DeclaredType>();
    }
}

// What a fix that lowers a declaration's visibility changes: the type 'declared' itself, a member of
// the type 'owner', which is 'overriding' where it overrides or provides a method of a base or an
// interface, or the function 'function' of the module being checked.
final class Lowering {
    protected DeclaredType? declared;
    protected DeclaredType? owner;
    protected bool overriding;
    protected string function;

    protected constructor(this.declared, this.owner, this.overriding, this.function);
}

typeLowering(DeclaredType declared) -> Lowering {
    return new Lowering(declared, null, false, "");
}

memberLowering(DeclaredType owner, bool overriding = false) -> Lowering {
    return new Lowering(null, owner, overriding, "");
}

functionLowering(string name) -> Lowering {
    return new Lowering(null, null, false, name);
}

class FoundIdentifier {
    protected string name;
    protected Span span;

    protected constructor(this.name, this.span);
}

class CycleStep {
    protected Type owner;
    protected Field field;

    protected constructor(this.owner, this.field);
}

class ModuleChecks {
    ModuleContext context;
    ProgramReferences references;
    Reporter reporter;
    // The file's names, and the names inside the declaration being checked, which its type
    // parameters hide some of.
    TypeNames fileNames;
    TypeNames names;
    string modulePath;
    MemberConstraint[] noConstraints;

    List<StructDeclarationNode> structNodes;
    List<ClassDeclarationNode> classNodes;
    List<InterfaceDeclarationNode> interfaceNodes;
    List<PrimitiveDeclarationNode> primitiveNodes;

    protected constructor(ModuleContext context, List<FileDiagnostic> collected,
                          ProgramReferences references) {
        this.context = context;
        this.references = references;
        this.reporter = new Reporter(context.module().filePath(), collected);
        this.fileNames = context.names();
        this.names = this.fileNames;
        this.modulePath = context.module().canonicalPath();
        this.noConstraints = [];
        this.structNodes = new List<StructDeclarationNode>();
        this.classNodes = new List<ClassDeclarationNode>();
        this.interfaceNodes = new List<InterfaceDeclarationNode>();
        this.primitiveNodes = new List<PrimitiveDeclarationNode>();
    }

    protected run() {
        let root = this.context.root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is StructDeclarationNode declaration -> {
                    this.structNodes.push(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.classNodes.push(declaration);
                },
                is InterfaceDeclarationNode declaration -> {
                    this.interfaceNodes.push(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.primitiveNodes.push(declaration);
                },
                default -> { },
            }
        }
        this.checkStructCycles();
        this.checkFieldDefaultOrder();
        this.checkFieldInitialization();
        this.checkImplicitBaseConstruction();
        this.checkInterfaceRedeclarations();
        this.names = this.fileNames;
        this.checkPrimitiveConformances();
        this.checkStructConformances();
        this.checkDeclaredThrows();
        this.checkVisibilityLeaks();
        this.names = this.fileNames;
    }

    // Names types the way code inside the declaration of 'owner', or of a function declaring
    // 'declared', writes them.
    within(DeclaredType? owner, TypeParamType[] declared = []) {
        this.names = this.fileNames.withParametersOf(owner, declared);
    }

    bindingFor(PrimitiveDeclarationNode node) -> PrimitiveBinding? {
        let store = this.context.resolver().typeStore();
        let primitive = types.primitiveNamed(store, node.name().text());
        if (primitive == null) {
            return null;
        }
        let binding = types.bindingOf(primitive);
        if (binding != null && binding.declaration() == node.green()) {
            return binding;
        }
        return null;
    }

    // A conformance a binding declares has to hold: every method the interface and the
    // interfaces it extends require must be a member of the binding, with a matching signature
    // and the 'override' marker, exactly as a class implementing the same interface would.
    // Whole-program, because the interface may be declared in another module.
    checkPrimitiveConformances() {
        for (long n = 0; n < this.primitiveNodes.length(); n++) {
            let node = this.primitiveNodes.get(n);
            let binding = this.bindingFor(node);
            if (binding == null) {
                continue;
            }
            Span at = node.name().span();
            let checked = new Set<Type>();
            for (let implemented in binding.interfaces()) {
                let checkedRequirements = new Set<string>();
                for (let level in hierarchy.interfaceLadderOf(implemented)) {
                    if (!checked.add(level)) {
                        continue;
                    }
                    this.checkBindingLevelSatisfied(binding, implemented, level, at,
                        checkedRequirements);
                }
            }
            this.checkBindingOverrideMarkers(binding, node);
        }
    }

    // A requirement an earlier rung of the ladder redeclares was checked there, so it is skipped.
    checkBindingLevelSatisfied(PrimitiveBinding binding, Type implemented, Type level, Span at,
                               Set<string> checkedRequirements) {
        let required = typemembers.methodsOf(level);
        if (required == null) {
            return;
        }
        string interfaceName = this.names.quoted(implemented);
        string levelName = this.names.quoted(level);
        for (long i = 0; i < required.length(); i++) {
            let requirement = required.get(i);
            if (!checkedRequirements.add(layout.quotedMethod(requirement, this.names))) {
                continue;
            }
            let provided = members.findSameSignature(binding.methods(), requirement.name(),
                requirement.signature());
            if (provided == null && (layout.unresolvedCouldProvide(binding.methods(), requirement)
                    || this.isOverrideTarget(binding.methods(), binding.interfaces(), requirement,
                        null))) {
                continue;
            }
            if (provided == null) {
                string requiredBy = "";
                if (level != implemented) {
                    requiredBy = ", required by {levelName}, which {interfaceName} extends";
                }
                if (members.unreplaceableMember(binding.primitive(), requirement.name(),
                        requirement.signature(), this.names) != null) {
                    this.reporter.report("The binding for '{binding.name()}' implements "
                        + "{interfaceName} but cannot provide "
                        + "{layout.quotedMethod(requirement, this.names)}{requiredBy}, because the "
                        + "compiler implements '{requirement.name()}' on a value of type "
                        + "'{binding.name()}' itself. Stop implementing {interfaceName} "
                        + "here.", at);
                    continue;
                }
                this.reporter.report("The binding for '{binding.name()}' implements "
                    + "{interfaceName} but does not provide "
                    + "{layout.quotedMethod(requirement, this.names)}{requiredBy}. Declare the method "
                    + "here, or stop implementing {interfaceName}.", at);
                continue;
            }
            if (!layout.unresolvedCouldMatch(requirement.signature(), provided.signature())
                    && !convert.isAssignableStrict(requirement.signature().returnType(),
                        provided.signature().returnType())) {
                string requiredReturn = layout.quotedReturnType(requirement.signature(), this.names);
                string providedReturn = layout.quotedReturnType(provided.signature(), this.names);
                this.reporter.report("Method '{requirement.name()}' of the '{binding.name()}' "
                    + "binding returns {providedReturn}, but interface {levelName} requires "
                    + "{requiredReturn}. Change the return type of '{requirement.name()}' to "
                    + "{requiredReturn}.", at);
            }
            if (requirement.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{requirement.name()}' of the '{binding.name()}' "
                    + "binding must be marked 'noreturn', because interface {levelName} "
                    + "declares it 'noreturn'.", at);
            }
        }
    }

    // The marker rules, with no base chain to consult: a member marked 'override' has to implement
    // a declared conformance, and one that implements a conformance has to carry the marker.
    checkBindingOverrideMarkers(PrimitiveBinding binding, PrimitiveDeclarationNode node) {
        let body = node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FunctionDeclarationNode)) {
                continue;
            }
            let declared = members.methodDeclaredBy(binding.methods(), member.green());
            if (declared == null) {
                continue;
            }
            let nameToken = member.name();
            if (nameToken == null) {
                continue;
            }
            let requiringInterface = this.quotedRequiringInterface(binding.interfaces(), declared);
            if (this.unresolvedCouldImplement(binding.interfaces(), declared)) {
                continue;
            }
            if (declared.isOverride()) {
                if (requiringInterface == null) {
                    string subject = "Method '{declared.name()}' of the '{binding.name()}' binding";
                    this.reportUnmatchedOverride(declared, binding.interfaces(), binding.methods(),
                        "{subject} is marked 'override' but no interface it implements declares "
                        + "it. Remove 'override'.", "{subject} is marked 'override', but every "
                        + "'{declared.name()}' its interfaces declare already has a matching method "
                        + "in the binding, so this one overrides nothing. Remove 'override'.",
                        nameToken.span());
                }
                continue;
            }
            if (requiringInterface != null) {
                this.reporter.report("Method '{declared.name()}' of the '{binding.name()}' binding "
                    + "implements a method declared in interface {requiringInterface} but is not "
                    + "marked 'override'. Write 'override' before '{declared.name()}'.", nameToken.span());
            }
        }
    }

    // Every method an interface a struct implements requires must be a method of that struct,
    // with a matching signature and the 'override' marker. The interfaces the implemented one
    // extends require their methods too. Whole-program, because the interface may be declared in
    // another module.
    checkStructConformances() {
        for (long n = 0; n < this.structNodes.length(); n++) {
            let node = this.structNodes.get(n);
            let structType = this.structFor(node);
            if (structType == null) {
                continue;
            }
            this.within(structType);
            Span at = node.name().span();
            let checked = new Set<Type>();
            for (let implemented in structType.interfaces()) {
                let checkedRequirements = new Set<string>();
                for (let level in hierarchy.interfaceLadderOf(implemented)) {
                    if (!checked.add(level)) {
                        continue;
                    }
                    this.checkStructLevelSatisfied(structType, implemented, level, at,
                        checkedRequirements);
                }
            }
            this.checkStructOverrideMarkers(structType, node);
        }
    }

    // One rung of an implemented interface's ladder. A struct's own members are its whole
    // implement, because a struct has no base to inherit a requirement from. A requirement an
    // earlier rung redeclares was checked there, so it is skipped here.
    checkStructLevelSatisfied(StructType structType, Type implemented, Type level, Span at,
                              Set<string> checkedRequirements) {
        let required = typemembers.methodsOf(level);
        if (required == null) {
            return;
        }
        string structName = this.names.quotedName(structType);
        string interfaceName = this.names.quoted(implemented);
        string levelName = this.names.quoted(level);
        for (long i = 0; i < required.length(); i++) {
            let requirement = required.get(i);
            string requirementShown = layout.quotedMethod(requirement, this.names);
            if (!checkedRequirements.add(requirementShown)) {
                continue;
            }
            string requiredBy = "";
            if (level != implemented) {
                requiredBy = ", required by {levelName}, which {interfaceName} extends";
            }
            let provided = members.findSameSignature(structType.methods(), requirement.name(),
                requirement.signature());
            if (provided == null && (layout.unresolvedCouldProvide(structType.methods(), requirement)
                    || this.isOverrideTarget(structType.methods(), structType.interfaces(),
                        requirement, structType))) {
                continue;
            }
            if (provided == null) {
                this.reporter.report("Struct {structName} implements {interfaceName} but does not provide "
                    + "{requirementShown}{requiredBy}. Declare the method here, "
                    + "or stop implementing {interfaceName}.", at);
                continue;
            }
            if (provided.isConditional()) {
                this.reporter.report("Struct {structName} provides {requirementShown} only "
                    + "for some type arguments, but {interfaceName} needs it for every type "
                    + "argument. Remove the '<...>' list from '{requirement.name()}', or stop "
                    + "implementing {interfaceName}.", at);
                continue;
            }
            bool comparable = !layout.unresolvedCouldMatch(requirement.signature(),
                provided.signature());
            if (comparable
                    && layout.narrowsReturnShape(requirement.signature(), provided.signature())) {
                this.reporter.report("Method '{requirement.name()}' of struct {structName} returns "
                    + "{layout.quotedReturnType(provided.signature(), this.names)}, but interface "
                    + "{levelName} requires "
                    + "{layout.quotedReturnType(requirement.signature(), this.names)}, "
                    + layout.narrowedReturnAdvice(requirement.signature().returnType(),
                        provided.signature().returnType(), this.names)
                    + ".", at);
            } else if (comparable
                    && !layout.overrideCompatible(requirement.signature(), provided.signature())) {
                let noting = this.names.noting();
                Type required = requirement.signature().returnType();
                string providedReturn = layout.quotedReturnType(provided.signature(), noting);
                string requiredReturn = layout.quotedReturnType(requirement.signature(), noting);
                let imported = typenames.importsFor([required], noting);
                this.reporter.report("Method '{requirement.name()}' of struct {structName} returns "
                    + "{providedReturn}, but interface {levelName} requires {requiredReturn}. "
                    + typenames.withImportsFirst(imported, "Change the return type of "
                        + "'{requirement.name()}' to "
                        + "{layout.quotedReturnType(requirement.signature(), imported.names())}."),
                    at);
            }
            if (requirement.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{requirement.name()}' of struct "
                    + "{structName} must be marked 'noreturn', because interface "
                    + "{levelName} declares it 'noreturn'.", at);
            }
            this.checkMutatingMatches(requirement, provided, structName, levelName);
            // A bound the struct satisfies is written wherever the struct is nameable, and the
            // generic body behind that bound calls the requirement, so the implementation must be
            // as visible as the struct.
            Visibility requiredReach = types.followedMemberVisibility(structType.visibility());
            if (provided.visibility() == Visibility.Private || types.visibilityTier(provided.visibility())
                        < types.visibilityTier(requiredReach)) {
                this.reporter.report("Method '{requirement.name()}' of struct {structName} is "
                    + "{types.visibilityWord(provided.visibility())}, but it provides "
                    + "{requirementShown} for interface {interfaceName}, so it must be usable "
                    + "everywhere {structName} is. Mark it "
                    + "'{types.visibilityWord(requiredReach)}'.", at);
            }
        }
    }

    // A struct method that implements a requirement carries the same 'mutating' marker: a call
    // through the interface is allowed or refused on a value by the requirement's marker alone.
    checkMutatingMatches(Method requirement, Method provided, string structName, string levelName) {
        string name = requirement.name();
        Span at = provided.signature().nameSpan();
        if (requirement.isMutating() && !provided.isMutating()) {
            this.reporter.report("Method '{name}' of struct {structName} must be marked 'mutating', "
                + "because interface {levelName} declares it 'mutating'. {declare.mutatingGloss()}. "
                + "Write 'mutating' before '{name}'.", at);
        } else if (provided.isMutating() && !requirement.isMutating()) {
            this.reporter.report("Method '{name}' of struct {structName} is marked 'mutating', but "
                + "interface {levelName} does not declare it 'mutating'. Code that calls '{name}' "
                + "through {levelName} may call it on a value that must not change, such as a "
                + "'const' local. Remove 'mutating' from '{name}', or declare it 'mutating' in "
                + "{levelName}.", at);
        }
    }

    // A struct member marked 'override' has to implement something, either a built-in behavior of
    // the struct or a method an implemented interface declares, and one that implements a
    // requirement has to carry the marker.
    checkStructOverrideMarkers(StructType structType, StructDeclarationNode node) {
        let body = node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FunctionDeclarationNode)) {
                continue;
            }
            let declared = members.methodDeclaredBy(structType.methods(), member.green());
            if (declared == null || declared.isConstructor()) {
                continue;
            }
            let nameToken = member.name();
            if (nameToken == null) {
                continue;
            }
            let behavior = members.builtinBehaviorReplaced(structType, declared.name(), declared.signature());
            let requiringInterface = this.quotedRequiringInterface(structType.interfaces(), declared);
            if (this.unresolvedCouldImplement(structType.interfaces(), declared)) {
                continue;
            }
            if (declared.isOverride()) {
                if (behavior == null && requiringInterface == null) {
                    string structName = this.names.quotedName(structType);
                    this.reportUnmatchedOverride(declared, structType.interfaces(),
                        structType.methods(), nothingToOverrideMessage(structType, declared,
                            this.names), "Method '{declared.name()}' of {structName} is marked "
                        + "'override', but every '{declared.name()}' its interfaces declare "
                        + "already has a matching method in {structName}, so this one overrides "
                        + "nothing. Remove 'override'.", nameToken.span());
                }
                continue;
            }
            if (behavior == null && requiringInterface != null && !declared.isConditional()) {
                this.reporter.report("Method '{declared.name()}' of struct "
                    + "{this.names.quotedName(structType)} implements a method declared in "
                    + "interface {requiringInterface} but is not marked 'override'. Write "
                    + "'override' before '{declared.name()}'.", nameToken.span());
            }
        }
    }

    // Whether an interface among `interfaces` declares a method named after `declared` that
    // differs from it only where a type did not resolve.
    unresolvedCouldImplement(Type[] interfaces, Method declared) -> bool {
        for (let implemented in interfaces) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                if (layout.unresolvedCouldReplace(typemembers.methodsOf(level), declared.name(),
                        declared.signature())) {
                    return true;
                }
            }
        }
        return false;
    }

    // Refuses a method marked 'override' that implements no requirement. The requirement of its
    // name that it was most likely written for is named beside it. `undeclared` is reported when
    // no interface declares the name, and `provided` when `methods` already provide each method of
    // that name.
    reportUnmatchedOverride(Method declared, Type[] interfaces, List<Method> methods,
                            string undeclared, string provided, Span at) {
        let named = this.interfaceMethodsNamed(interfaces, declared.name());
        if (named.length() == 0) {
            this.reporter.report(undeclared, at);
            return;
        }
        let intended = layout.intendedOverride(declared, named, methods);
        if (intended == null) {
            this.reporter.report(provided, at);
            return;
        }
        this.reporter.report(layout.mismatchedOverrideMessage(declared, intended,
            "interface {this.names.quoted(intended.definingType())}", this.names), at);
    }

    // Whether an 'override' among `methods` that matches no requirement is reported against
    // `requirement`, which then needs no report of its own for being missing. A struct's method
    // that replaces a built-in behavior is reported as that instead.
    isOverrideTarget(List<Method> methods, Type[] interfaces, Method requirement,
                     StructType? structType) -> bool {
        for (let method in methods) {
            if (!method.isOverride() || method.name() != requirement.name()
                    || this.quotedRequiringInterface(interfaces, method) != null
                    || this.unresolvedCouldImplement(interfaces, method)) {
                continue;
            }
            if (structType != null && members.builtinBehaviorReplaced(structType, method.name(),
                    method.signature()) != null) {
                continue;
            }
            let named = this.interfaceMethodsNamed(interfaces, method.name());
            if (layout.intendedOverride(method, named, methods) == requirement) {
                return true;
            }
        }
        return false;
    }

    // The methods named `name` that the interfaces among `interfaces` declare, the ones they
    // extend included.
    interfaceMethodsNamed(Type[] interfaces, string name) -> List<Method> {
        let found = new List<Method>();
        for (let implemented in interfaces) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                let methods = typemembers.methodsOf(level);
                if (methods == null) {
                    continue;
                }
                for (let method in methods) {
                    if (method.name() == name) {
                        found.push(method);
                    }
                }
            }
        }
        return found;
    }

    // The interface whose requirement this member implements, in quotes as it reads in a diagnostic,
    // or null.
    quotedRequiringInterface(Type[] interfaces, Method declared) -> string? {
        for (let implemented in interfaces) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                let methods = typemembers.methodsOf(level);
                if (methods == null) {
                    continue;
                }
                if (members.findSameSignature(methods, declared.name(),
                        declared.signature()) != null) {
                    return this.names.quoted(level);
                }
            }
        }
        return null;
    }

    structFor(StructDeclarationNode node) -> StructType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    classFor(ClassDeclarationNode node) -> ClassType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    interfaceFor(InterfaceDeclarationNode node) -> InterfaceType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is InterfaceType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    // ---- Struct by-value containment cycles ----

    // Every struct a by-value field path leads back to is in one component with the structs on
    // those paths, and the component is reported once, from its first struct.
    checkStructCycles() {
        for (long i = 0; i < this.structNodes.length(); i++) {
            let found = this.structFor(this.structNodes.get(i));
            if (found == null) {
                continue;
            }
            this.within(found);
            let component = valuecycles.componentOf(found);
            if (component == null || !component.startsAt(found)) {
                continue;
            }
            if (component.isSimpleCycle()) {
                this.reportStructCycle(found);
            } else {
                this.reportStructComponent(component);
            }
        }
    }

    reportStructCycle(StructType found) {
        let path = new List<CycleStep>();
        let explored = new Set<Type>();
        if (!findPathBackTo(found, found, path, explored)) {
            return;
        }
        string quotedFound = this.names.quotedName(found);
        let steps = new List<string>();
        for (long s = 0; s < path.length(); s++) {
            let step = path.get(s);
            steps.push("field '{step.field.name()}' of {this.names.quoted(step.owner)} has type "
                + "{this.names.quoted(step.field.type())}");
        }
        let builder = new StringBuilder();
        builder.append("Struct {quotedFound} contains itself: {diagnostics.andJoined(steps.toArray())}");
        string exampleName = found.name();
        string quotedExample = quotedFound;
        string located = "";
        let example = valuecycles.byValueStruct(path.get(0).field.type());
        if (example != null) {
            let authority = types.authorityOf(example);
            if (authority != null) {
                exampleName = authority.name();
                quotedExample = this.names.quotedName(authority);
                if (authority.modulePath() != this.modulePath) {
                    located = " where module '{this.names.importPathOf(authority)}' declares it";
                }
            }
        }
        builder.append(". A struct keeps its fields inside itself, so every {quotedFound} would "
            + "contain another {quotedFound} without end. Make {quotedExample} a class, as in "
            + "'class {exampleName} \{ ... \}'{located}, because a class field only refers to "
            + "another object.");
        this.reporter.report(builder.toString(), path.get(0).field.nameSpan());
    }

    // A component with more than one cycle through its structs names every struct and every
    // field between them, and the structs whose change to a class breaks all the cycles at once.
    reportStructComponent(ValueComponent component) {
        let structs = component.structs();
        let quotedStructs = new List<string>();
        for (let member in structs) {
            quotedStructs.push(this.names.quotedName(member));
        }
        string lead = "Structs {diagnostics.andJoined(quotedStructs.toArray())} contain each other";
        string endless = "each of these structs would contain another of them without end";
        if (structs.length() == 1) {
            lead = "Struct {quotedStructs.get(0)} contains itself";
            endless = "every {quotedStructs.get(0)} would contain another {quotedStructs.get(0)} without end";
        }
        let steps = new List<string>();
        let notes = new List<RelatedLocation>();
        for (let edge in component.edges()) {
            string step = "field '{edge.field().name()}' of {this.names.quoted(edge.owner())} has type "
                + "{this.names.quoted(edge.field().type())}";
            steps.push(step);
            notes.push(new RelatedLocation(edge.from().filePath(), edge.field().nameSpan(), step));
        }
        let breaking = component.breakingStructs();
        let quotedBreaking = new List<string>();
        for (let member in breaking) {
            quotedBreaking.push(this.names.quotedName(member));
        }
        let example = breaking.get(0);
        string located = "";
        if (example.modulePath() != this.modulePath) {
            located = " where module '{this.names.importPathOf(example)}' declares it";
        }
        string classes = "a class";
        if (breaking.length() > 1) {
            classes = "classes";
        }
        string fix = "Make {diagnostics.andJoined(quotedBreaking.toArray())} {classes}, as in 'class "
            + "{example.name()} \{ ... \}'{located}, because a class field only refers to another object.";
        string why = "A struct keeps its fields inside itself, so {endless}.";
        Span at = component.edges().get(0).field().nameSpan();
        if (steps.length() <= 3) {
            this.reporter.report("{lead}: {diagnostics.andJoined(steps.toArray())}. {why} {fix}", at);
            return;
        }
        this.reporter.report("{lead} through the fields listed below. {why} {fix}", at, notes.toArray());
    }

    // ---- Field default ordering ----

    // A field default may only reference fields declared before it. The rule is syntactic:
    // an identifier in a default that names this type's own field at the same or a later
    // position, and nothing else visible at module scope, cannot resolve.
    checkFieldDefaultOrder() {
        for (long i = 0; i < this.structNodes.length(); i++) {
            let node = this.structNodes.get(i);
            let structType = this.structFor(node);
            if (structType != null) {
                this.within(structType);
                this.checkDefaultOrderIn(node.body());
            }
        }
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType != null) {
                this.within(classType);
                this.checkDefaultOrderIn(node.body());
            }
        }
    }

    // Type-level fields stay out on both sides. A static const's initializer is a compile-time
    // constant the constants phase owns, and a lazy const's runs on the first read, so neither
    // is part of an instance's initialization order.
    checkDefaultOrderIn(MemberListNode body) {
        let fieldNames = new List<string>();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                fieldNames.push(member.name().text());
            }
        }
        long fieldIndex = 0;
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    this.checkDefaultReferences(member.name().text(), fieldIndex,
                        defaultValue.value(), fieldNames);
                }
                fieldIndex++;
            }
        }
    }

    checkDefaultReferences(string fieldName, long fieldIndex, Expression value, List<string> fieldNames) {
        let found = new List<FoundIdentifier>();
        collectIdentifiers(value.green(), value.fullSpan().start, found);
        for (long i = 0; i < found.length(); i++) {
            let identifier = found.get(i);
            long named = firstIndexOf(fieldNames, identifier.name);
            if (named < fieldIndex) {
                continue;
            }
            if (this.visibleAtModuleScope(identifier.name)) {
                continue;
            }
            if (named == fieldIndex && identifier.name == fieldName) {
                this.reporter.report("The default value of field '{fieldName}' uses '{fieldName}' "
                    + "itself, and '{fieldName}' has no value until this default is computed. "
                    + "Remove '{fieldName}' from its own default, or use a field declared above "
                    + "'{fieldName}'.", identifier.span);
            } else {
                this.reporter.report("The default value of field '{fieldName}' uses "
                    + "'{identifier.name}', which is declared below '{fieldName}', so "
                    + "'{identifier.name}' has no value yet. Move '{identifier.name}' above "
                    + "'{fieldName}', or remove '{identifier.name}' from the default.",
                    identifier.span);
            }
        }
    }

    // Names a default-value identifier could still resolve to when it is not an earlier
    // sibling field: module functions, the ones the language provides, module types, imported
    // names, and the implicit exception base class.
    visibleAtModuleScope(string name) -> bool {
        if (name == "Error") {
            return true;
        }
        let functions = this.context.functions().entriesNamed(name);
        if (functions != null && functions.length() > 0) {
            return true;
        }
        if (this.context.declarations().hasFunctionNamed(name)) {
            return true;
        }
        let store = this.context.resolver().typeStore();
        if (store.findDeclared(this.modulePath, name) != null) {
            return true;
        }
        return this.context.linkTable().binding(name) != null;
    }

    // ---- Field initialization ----

    // A struct field may have any type, including a non-defaultable one; such a struct becomes
    // non-defaultable itself and must be constructed rather than zero-initialized. Only class
    // fields are checked here, since a class always has a constructor path.
    checkFieldInitialization() {
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType != null) {
                this.within(classType);
                this.checkClassFieldInitialization(classType, node);
            }
        }
    }

    // A class that declares any constructor is checked by the definite-assignment pass over each
    // constructor body. Only a class with no constructor at all is caught here: it has no path on
    // which a non-defaultable field could be assigned.
    checkClassFieldInitialization(ClassType classType, ClassDeclarationNode node) {
        if (declaresConstructor(node)) {
            return;
        }
        let fields = classType.fields();
        for (long i = classType.baseFieldCount(); i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.type() is ErrorType) {
                continue;
            }
            if (field.hasDefault()) {
                continue;
            }
            if (field.isConst()) {
                this.reporter.report("Field '{field.name()}' of class {this.names.quotedName(classType)} is "
                    + "'const' with no default value, and {this.names.quotedName(classType)} has no "
                    + "constructor to assign it. Add one, for example "
                    + "'constructor(this.{field.name()});', or give the field a default value.",
                    field.nameSpan());
                continue;
            }
            if (convert.isDefaultable(field.type())) {
                continue;
            }
            string quotedType = this.names.quoted(field.type());
            string defaulted = this.names.quotedCode(["", " {field.name()} = ...;"], [field.type()]);
            string nullable = this.names.quotedCode(["", "? {field.name()};"], [field.type()]);
            this.reporter.report("Field '{field.name()}' of class {this.names.quotedName(classType)} has "
                + "type {quotedType}, which cannot be null, and nothing ever assigns it. Give "
                + "it a default ({defaulted}), make it nullable "
                + "({nullable}) or add a constructor that assigns it "
                + "('constructor(this.{field.name()});').", field.nameSpan());
        }
    }

    // ---- Implicit base construction ----

    // A class that declares no constructor is built by the zero-argument constructor of its base
    // class. A base that declares constructors must have one the class can reach.
    checkImplicitBaseConstruction() {
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType == null || declaresConstructor(node)) {
                continue;
            }
            this.within(classType);
            let chain = typemembers.implicitBaseConstructor(classType);
            if (chain.owner() == null || chain.chosen() != null || chain.chooser() != classType) {
                continue;
            }
            // An unmarked constructor of a file-private class already reaches its whole file.
            string marker = "";
            if (classType.visibility() != Visibility.Private) {
                marker = types.visibilityWord(classType.visibility());
            }
            string opening = "Class {this.names.quotedName(classType)} declares no constructor";
            this.reporter.report(typemembers.implicitBaseRefusal(opening, chain, null, false, marker,
                this.names), node.name().span());
        }
    }

    // ---- Interface requirement redeclarations ----

    // A sub-interface inherits every requirement of the interface it extends, so redeclaring one
    // (same name and parameter types) is an error naming the ancestor that declares it. Genuine
    // overloads with different parameters stay legal, like overloads within one interface.
    checkInterfaceRedeclarations() {
        for (long i = 0; i < this.interfaceNodes.length(); i++) {
            let node = this.interfaceNodes.get(i);
            let interfaceType = this.interfaceFor(node);
            if (interfaceType == null) {
                continue;
            }
            this.within(interfaceType);
            let methods = interfaceType.methods();
            for (long m = 0; m < methods.length(); m++) {
                let method = methods.get(m);
                let inherited = this.inheritedRequirement(interfaceType, method);
                if (inherited == null) {
                    continue;
                }
                this.reporter.report("Interface {this.names.quotedName(interfaceType)} already requires "
                    + "{layout.quotedMethod(inherited, this.names)}, because it extends "
                    + "{this.names.quoted(inherited.definingType())}, which declares it. Remove this "
                    + "second declaration of '{method.name()}'.", method.signature().nameSpan());
            }
        }
    }

    // The nearest requirement up the extends chain that the method redeclares: the same name
    // and parameter types on an interface the declaring one extends.
    inheritedRequirement(InterfaceType interfaceType, Method method) -> Method? {
        let seen = new Set<Type>();
        Type? current = hierarchy.baseOf(interfaceType);
        while (current != null && seen.add(current)) {
            let candidates = typemembers.methodsOf(current);
            if (candidates != null) {
                for (long i = 0; i < candidates.length(); i++) {
                    let candidate = candidates.get(i);
                    if (candidate.name() == method.name()
                            && typemembers.sameParameterTypes(candidate.signature(), method.signature())) {
                        return candidate;
                    }
                }
            }
            current = hierarchy.baseOf(current);
        }
        return null;
    }

    // ---- Declared throws ----

    checkDeclaredThrows() {
        let functions = this.context.functions().all();
        for (long i = 0; i < functions.length(); i++) {
            let entry = functions.get(i);
            this.within(null, entry.signature().typeParameters());
            if (!entry.isBuiltin() && !entry.isExternal()) {
                this.validateThrows(entry.signature());
            }
        }
        let store = this.context.resolver().typeStore();
        for (let declared in this.context.declarations().types()) {
            let owned = store.findDeclared(this.modulePath, declared.name());
            if (owned == null || owned.declaration() != declared.node()) {
                continue;
            }
            this.within(owned);
            switch (owned) {
                is StructType structType -> {
                    this.validateMethodThrows(structType.methods(), owned.declaration());
                    this.validateMethodThrows(structType.staticMethods(),
                        owned.declaration());
                },
                is ClassType classType -> {
                    this.validateMethodThrows(classType.methods(), owned.declaration());
                    this.validateMethodThrows(classType.staticMethods(), owned.declaration());
                },
                is InterfaceType interfaceType -> {
                    this.validateMethodThrows(interfaceType.methods(), owned.declaration());
                },
                default -> { },
            }
        }
        this.names = this.fileNames;
        this.validateFunctionTypeThrows();
    }

    // A conditional member's list is judged under its constraints, where the restated parameter
    // carries extra bounds.
    validateMethodThrows(List<Method> methods, GreenNode owner) {
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.isConditional()) {
                this.validateThrowsList(method.signature().throwsTypes(),
                    method.signature().throwsTypeSpans(), owner, method.constraints());
            } else {
                this.validateThrows(method.signature());
            }
        }
    }

    validateThrows(Signature signature) {
        this.validateThrowsList(signature.throwsTypes(), signature.throwsTypeSpans(),
            null, this.noConstraints);
    }

    validateFunctionTypeThrows() {
        for (let mention in this.context.resolver().takeFunctionThrowsMentions()) {
            this.validateThrowsList(mention.thrownTypes(), mention.spans(),
                mention.scopeOwner(), mention.scopeConstraints());
        }
    }

    validateThrowsList(Type[] declared, Span[] spans, GreenNode? scopeOwner,
                       MemberConstraint[] scopeConstraints) {
        if (declared.length == 0) {
            return;
        }
        let errorClass = this.context.resolver().errorClass();
        let accepted = new List<Type>();
        let acceptedSpans = new List<Span>();
        for (long i = 0; i < declared.length; i++) {
            Type thrown = declared[i];
            if (thrown is ErrorType) {
                continue;
            }
            if (errorClass == null || !hierarchy.isAlwaysSubclassOfUnder(thrown, errorClass, scopeOwner,
                    scopeConstraints)) {
                if (thrown is TypeParamType) {
                    string bounded = this.names.quotedCode(["", ": Error"], [thrown]);
                    this.reporter.report("A declared throws type must be 'Error' or a subclass "
                        + "of it, and the type parameter {this.names.quoted(thrown)} has no "
                        + "bound under 'Error'. Bound it as {bounded}, or by a subclass of 'Error'.",
                        spans[i]);
                    continue;
                }
                string shown = this.names.quoted(thrown);
                this.reporter.report("A declared throws type must be 'Error' or a subclass of "
                    + "it, and {shown} is neither. Remove {shown} from the 'throws' list, or "
                    + "replace it with a class that extends 'Error'.", spans[i]);
                continue;
            }
            bool overlaps = false;
            for (long a = 0; a < accepted.length(); a++) {
                let previous = accepted.get(a);
                if (thrown == previous) {
                    this.reporter.report("The 'throws' list names {this.names.quoted(thrown)} twice. "
                        + "Remove this second {this.names.quoted(thrown)}.", spans[i]);
                    overlaps = true;
                    break;
                }
                if (hierarchy.isAlwaysSubclassOfUnder(thrown, previous, scopeOwner, scopeConstraints)) {
                    this.reporter.report(overlappingThrowsMessage(previous, thrown, this.names), spans[i]);
                    overlaps = true;
                    break;
                }
                if (hierarchy.isAlwaysSubclassOfUnder(previous, thrown, scopeOwner, scopeConstraints)) {
                    this.reporter.report(overlappingThrowsMessage(thrown, previous, this.names),
                        acceptedSpans.get(a));
                    overlaps = true;
                    break;
                }
            }
            if (!overlaps) {
                accepted.push(thrown);
                acceptedSpans.push(spans[i]);
            }
        }
    }

    // ---- Signature leakage ----

    // A declaration's signature may not mention a type less visible than the declaration
    // itself; a caller who can name the declaration could otherwise be handed a type it
    // cannot name. Protected members are exempt: their guaranteed reach is the declaring
    // file, which can name everything the file can. Every place a signature names a type is
    // collected first, so a fix that lowers a type can be checked against every signature that
    // names it before anything is reported.
    checkVisibilityLeaks() {
        let sites = this.leakSites();
        let mentions = mentionsIn(sites);
        for (let site in sites) {
            switch (site) {
                is MentionSite mention -> {
                    this.checkMentionedType(mention, mentions);
                },
                is BaseSite base -> {
                    this.checkBaseLeak(base, mentions);
                },
            }
        }
    }

    // Every place a signature in this module names a type, in declaration order.
    leakSites() -> List<LeakSite> {
        let sites = new List<LeakSite>();
        let functions = this.context.functions().all();
        for (long i = 0; i < functions.length(); i++) {
            let entry = functions.get(i);
            this.within(null, entry.signature().typeParameters());
            if (entry.isBuiltin() || entry.isExternal()) {
                continue;
            }
            this.collectCallableSites(sites, entry.signature(), entry.visibility(),
                "Function '{entry.signature().name()}'", "'{entry.signature().name()}'",
                functionLowering(entry.signature().name()));
        }
        for (long i = 0; i < this.structNodes.length(); i++) {
            let node = this.structNodes.get(i);
            let structType = this.structFor(node);
            if (structType == null) {
                continue;
            }
            this.within(structType);
            string declPhrase = "Struct {this.names.quotedName(structType)}";
            this.collectBoundSites(sites, structType.typeParameterTypes(), structType.visibility(),
                declPhrase, "{this.names.quotedName(structType)}", node.name().span(),
                typeLowering(structType));
            this.collectMemberSites(sites, "struct", structType, structType.fields(), 0,
                structType.methods(), fileReach());
            this.collectMemberSites(sites, "struct", structType, structType.staticFields(), 0,
                structType.staticMethods(), fileReach());
        }
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType == null) {
                continue;
            }
            this.within(classType);
            string declPhrase = "Class {this.names.quotedName(classType)}";
            this.collectClassBaseSites(sites, classType, node, declPhrase);
            this.collectImplementedInterfaceSites(sites, classType, node, declPhrase);
            this.collectBoundSites(sites, classType.typeParameterTypes(), classType.visibility(),
                declPhrase, "{this.names.quotedName(classType)}", node.name().span(),
                typeLowering(classType));
            let reach = subclassReach(classType);
            this.collectMemberSites(sites, "class", classType, classType.fields(),
                classType.baseFieldCount(), classType.methods(), reach);
            this.collectMemberSites(sites, "class", classType, classType.staticFields(), 0,
                classType.staticMethods(), reach);
        }
        for (long i = 0; i < this.primitiveNodes.length(); i++) {
            let binding = this.bindingFor(this.primitiveNodes.get(i));
            if (binding == null) {
                continue;
            }
            // A binding is nameable everywhere the primitive is, so an exported member of one
            // is checked for the types it mentions exactly as an exported class member does.
            this.collectMemberSites(sites, "primitive", binding, binding.staticFields(), 0,
                binding.methods(), fileReach());
            this.collectMemberSites(sites, "primitive", binding, binding.staticFields(), 0,
                binding.staticMethods(), fileReach());
        }
        for (long i = 0; i < this.interfaceNodes.length(); i++) {
            let node = this.interfaceNodes.get(i);
            let interfaceType = this.interfaceFor(node);
            if (interfaceType == null) {
                continue;
            }
            this.within(interfaceType);
            string interfaceName = this.names.quotedName(interfaceType);
            string declPhrase = "Interface {interfaceName}";
            this.collectInterfaceBaseSites(sites, interfaceType, node, declPhrase);
            this.collectBoundSites(sites, interfaceType.typeParameterTypes(),
                interfaceType.visibility(), declPhrase, "{interfaceName}", node.name().span(),
                typeLowering(interfaceType));
            let methods = interfaceType.methods();
            for (long m = 0; m < methods.length(); m++) {
                let method = methods.get(m);
                this.collectCallableSites(sites, method.signature(), method.visibility(),
                    "Method '{method.name()}' of interface {interfaceName}", "{interfaceName}",
                    typeLowering(interfaceType));
            }
        }
        return sites;
    }

    collectClassBaseSites(List<LeakSite> sites, ClassType classType, ClassDeclarationNode node,
                          string declPhrase) {
        if (types.visibilityTier(classType.visibility()) == 0) {
            return;
        }
        let base = classType.base();
        if (base == null) {
            return;
        }
        Span at = node.name().span();
        let extendsClause = node.extendsClause();
        if (extendsClause != null) {
            at = extendsClause.base().span();
        }
        string target = "{this.names.quotedName(classType)}";
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null) {
            sites.push(new BaseSite(classType, baseAuthority, false, declPhrase, at));
        }
        if (base is InstantiationType) {
            for (let argument in base.arguments()) {
                sites.push(new MentionSite(argument, classType.visibility(), declPhrase, target,
                    "base class type argument", at, typeLowering(classType), null));
            }
        }
    }

    collectInterfaceBaseSites(List<LeakSite> sites, InterfaceType interfaceType,
                              InterfaceDeclarationNode node, string declPhrase) {
        if (types.visibilityTier(interfaceType.visibility()) == 0) {
            return;
        }
        let base = interfaceType.base();
        if (base == null) {
            return;
        }
        Span at = node.name().span();
        let extendsClause = node.extendsClause();
        if (extendsClause != null) {
            at = extendsClause.base().span();
        }
        string target = "{this.names.quotedName(interfaceType)}";
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null) {
            sites.push(new BaseSite(interfaceType, baseAuthority, true, declPhrase, at));
        }
        if (base is InstantiationType) {
            for (let argument in base.arguments()) {
                sites.push(new MentionSite(argument, interfaceType.visibility(), declPhrase,
                    target, "extended interface type argument", at, typeLowering(interfaceType),
                    null));
            }
        }
    }

    collectImplementedInterfaceSites(List<LeakSite> sites, ClassType classType,
                                     ClassDeclarationNode node, string declPhrase) {
        if (types.visibilityTier(classType.visibility()) == 0) {
            return;
        }
        let implementsClause = node.implementsClause();
        if (implementsClause == null) {
            return;
        }
        for (long i = 0; i < implementsClause.interfacesCount(); i++) {
            let reference = implementsClause.interfaces(i);
            let resolved = this.context.result().typeOf(reference.green());
            if (resolved != null) {
                sites.push(new MentionSite(resolved, classType.visibility(), declPhrase,
                    "{this.names.quotedName(classType)}", "implemented interface", reference.span(),
                    typeLowering(classType), null));
            }
        }
    }

    // A protected member checks against its class's subclass reach instead of its own tier;
    // protectedOwner carries the class into the protected message shape.
    collectMemberSites(List<LeakSite> sites, string ownerKindWord, DeclaredType ownerType,
                       List<Field> fields, long firstOwnField, List<Method> methods,
                       SubclassReach reach) {
        string owner = "{ownerKindWord} {this.names.quotedName(ownerType)}";
        ProtectedOwner? reached = null;
        if (types.visibilityTier(reach.scope) > 0) {
            reached = new ProtectedOwner(ownerType, reach.wideners);
        }
        for (long i = firstOwnField; i < fields.length(); i++) {
            let field = fields.get(i);
            Visibility effective = field.visibility();
            ProtectedOwner? protectedOwner = null;
            if (effective == Visibility.Protected) {
                effective = reach.scope;
                protectedOwner = reached;
            }
            if (types.visibilityTier(effective) == 0) {
                continue;
            }
            sites.push(new MentionSite(field.type(), effective,
                "Field '{field.name()}' of {owner}", "'{field.name()}'", "type", field.nameSpan(),
                memberLowering(ownerType), protectedOwner));
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            Visibility effective = method.visibility();
            ProtectedOwner? protectedOwner = null;
            if (effective == Visibility.Protected) {
                effective = reach.scope;
                protectedOwner = reached;
            }
            string memberWord = "Method '{method.name()}'";
            string target = "'{method.name()}'";
            if (method.isConstructor()) {
                memberWord = "Constructor";
                target = "the constructor";
            }
            this.collectCallableSites(sites, method.signature(), effective,
                memberWord + " of " + owner, target, memberLowering(ownerType, method.isOverride()),
                protectedOwner);
            for (let constraint in method.constraints()) {
                for (let bound in constraint.bounds()) {
                    sites.push(new MentionSite(bound, effective, memberWord + " of " + owner,
                        target, "type-parameter bound", method.signature().nameSpan(),
                        memberLowering(ownerType, method.isOverride()), protectedOwner));
                }
            }
        }
    }

    // 'target' names the declaration whose visibility mark a fix changes.
    // 'lowering' is what a fix that lowers the declaration 'target' names changes.
    collectCallableSites(List<LeakSite> sites, Signature signature, Visibility declVisibility,
                         string declPhrase, string target, Lowering lowering,
                         ProtectedOwner? protectedOwner = null) {
        if (types.visibilityTier(declVisibility) == 0) {
            return;
        }
        for (let parameter in signature.parameters()) {
            sites.push(new MentionSite(parameter.type(), declVisibility, declPhrase, target,
                "parameter type", parameter.span(), lowering, protectedOwner));
        }
        sites.push(new MentionSite(signature.returnType(), declVisibility, declPhrase, target,
            "return type", signature.nameSpan(), lowering, protectedOwner));
        Type[] thrown = signature.throwsTypes();
        Span[] thrownSpans = signature.throwsTypeSpans();
        for (long i = 0; i < thrown.length; i++) {
            sites.push(new MentionSite(thrown[i], declVisibility, declPhrase, target,
                "thrown type", thrownSpans[i], lowering, protectedOwner));
        }
        this.collectBoundSites(sites, signature.typeParameters(), declVisibility, declPhrase,
            target, signature.nameSpan(), lowering, protectedOwner);
    }

    collectBoundSites(List<LeakSite> sites, TypeParamType[] parameters, Visibility declVisibility,
                      string declPhrase, string target, Span at, Lowering lowering,
                      ProtectedOwner? protectedOwner = null) {
        if (types.visibilityTier(declVisibility) == 0) {
            return;
        }
        for (let parameter in parameters) {
            for (let bound in parameter.bounds()) {
                sites.push(new MentionSite(bound, declVisibility, declPhrase, target,
                    "type-parameter bound", at, lowering, protectedOwner));
            }
        }
    }

    // A class or interface more visible than the type it extends.
    checkBaseLeak(BaseSite site, SignatureMentions mentions) {
        let declared = site.declared;
        let base = site.base;
        if (types.visibilityTier(base.visibility()) >= types.visibilityTier(declared.visibility())) {
            return;
        }
        string needed = types.visibilityWord(declared.visibility());
        string baseName = this.names.quotedName(base);
        string lowering = this.loweringClause("{this.names.quotedName(declared)}",
            declared.visibility(), base, typeLowering(declared), mentions);
        string extended = "its base class {baseName} is";
        if (site.extendsInterface) {
            extended = "the interface it extends, {baseName}, is";
        }
        this.reporter.report("{site.declPhrase} is '{needed}', but {extended} "
            + "{notNameablePhrase(base)}. Mark {baseName} '{needed}'{lowering}.", site.at);
    }

    checkMentionedType(MentionSite site, SignatureMentions mentions) {
        Type mentioned = site.mentioned;
        Visibility declVisibility = site.reach;
        string declPhrase = site.declPhrase;
        string target = site.target;
        string role = site.role;
        Span at = site.at;
        Lowering lowering = site.lowering;
        ProtectedOwner? protectedOwner = site.protectedOwner;
        let worst = leastVisibleMention(mentioned);
        if (worst == null || types.visibilityTier(worst.visibility())
                >= types.visibilityTier(declVisibility)) {
            return;
        }
        string needed = types.visibilityWord(declVisibility);
        string worstName = this.names.quotedName(worst);
        string uses = "{mentionPhrase(role, mentioned, worst, worstName)} "
            + "{notNameablePhrase(worst)}";
        if (protectedOwner != null) {
            let ownerType = protectedOwner.owner;
            string ownerName = this.names.quotedName(ownerType);
            string subclass = "a subclass anywhere in the package";
            if (declVisibility == Visibility.Export) {
                subclass = "a subclass in another package";
            }
            string verb = "call";
            if (role == "type") {
                verb = "use";
            }
            if (protectedOwner.wideners.length() > 0) {
                this.reportSealedLeak(declPhrase, protectedOwner, declVisibility, verb, uses, worst, target,
                    at);
                return;
            }
            string lowered = "";
            string closing = "";
            if (this.lowerable(typeLowering(ownerType), ownerType.visibility(), worst, mentions)) {
                lowered = " Or {loweringFix("{ownerName}", declVisibility, worst, ownerType)}.";
            }
            if (ownerType is ClassType && closable(ownerType)) {
                closing = " Or mark {ownerName} 'final'.";
            }
            this.reporter.report("{declPhrase} is protected, and {ownerName} is '{needed}', "
                + "so {subclass} can {verb} it, but {uses}. Mark {worstName} '{needed}'."
                + "{lowered}{closing}", at);
            return;
        }
        this.reporter.report("{declPhrase} is '{needed}', but {uses}. Mark {worstName} "
            + "'{needed}'{this.loweringClause(target, declVisibility, worst, lowering, mentions)}.",
            at);
    }

    // The fix after the first that lowers 'target' to the visibility of 'worst', opening with ", or",
    // or empty where lowering it breaks other code.
    loweringClause(string target, Visibility declared, DeclaredType worst, Lowering lowering,
                   SignatureMentions mentions) -> string {
        if (!this.lowerable(lowering, declared, worst, mentions)) {
            return "";
        }
        return ", or {loweringFix(target, declared, worst, lowering.declared)}";
    }

    // Whether lowering a declaration of visibility 'declared' to the visibility of 'worst' leaves every
    // other declaration valid. An 'export' declaration may be named outside the build. A type must not
    // be imported by name into another module, be extended or implemented by a more visible type, or
    // be mentioned in the signature of a more visible declaration other than its own members; a
    // member must override nothing and belong to a type nothing extends, in a module no other module
    // imports from; and a function must be in a module no other module imports whole.
    lowerable(Lowering lowering, Visibility declared, DeclaredType worst,
              SignatureMentions mentions) -> bool {
        if (declared == Visibility.Export) {
            return false;
        }
        Visibility lowered = loweredVisibility(worst);
        let declaredType = lowering.declared;
        let owner = lowering.owner;
        if (declaredType != null) {
            if (this.references.typeImportedElsewhere(declaredType.modulePath(), declaredType.name())) {
                return false;
            }
            for (let derived in this.references.derivedFrom(declaredType)) {
                if (types.visibilityTier(derived.visibility()) > types.visibilityTier(lowered)) {
                    return false;
                }
            }
            return !mentions.reachesAbove(declaredType, lowered);
        }
        if (owner != null) {
            return !lowering.overriding && !this.references.importedElsewhere(owner.modulePath())
                && this.references.derivedFrom(owner).length() == 0;
        }
        return !this.references.importedWholeElsewhere(this.modulePath);
    }

    // The leak of a protected member of a sealed class, which mentions 'worst', through the open
    // descendants that let a class 'worst' is out of reach of extend the hierarchy, with a note at each.
    // 'scope' is the widest scope they give it, and 'target' names the member as the refusal does.
    reportSealedLeak(string declPhrase, ProtectedOwner protectedOwner, Visibility scope, string verb,
                     string uses, DeclaredType worst, string target, Span at) {
        let owner = protectedOwner.owner;
        string ownerName = this.names.quotedName(owner);
        long ownerTier = types.visibilityTier(owner.visibility());
        let wideners = new List<ClassType>();
        let named = new List<string>();
        let notes = new List<RelatedLocation>();
        bool direct = true;
        Visibility? shared = null;
        bool uniform = true;
        for (let widener in protectedOwner.wideners) {
            Visibility reach = widener.visibility();
            if (types.visibilityTier(reach) > ownerTier) {
                reach = owner.visibility();
            }
            if (types.visibilityTier(reach) <= types.visibilityTier(worst.visibility())) {
                continue;
            }
            uniform = uniform && (shared == null || shared == reach);
            shared = reach;
            wideners.push(widener);
            string widenerName = this.names.quotedName(widener);
            named.push("{widenerName}");
            let base = widener.base();
            if (base == null || types.authorityOf(base) != owner) {
                direct = false;
            }
            let declared = this.classDeclarationOf(widener);
            if (declared != null) {
                notes.push(this.reporter.noteAt(declared.name().span(), "{widenerName} is declared here."));
            }
        }
        string listed = diagnostics.andJoined(named.toArray());
        bool several = wideners.length() > 1;
        string relation = "its subclass";
        if (!direct) {
            relation = "its descendant";
        }
        if (several && direct) {
            relation = "its subclasses";
        } else if (several) {
            relation = "its descendants";
        }
        string verbForm = "is";
        string extended = listed;
        if (several) {
            verbForm = "are";
            extended = "them";
        }
        string marked = "";
        string where = "in another file";
        if (uniform && shared != null) {
            marked = "'{types.visibilityWord(shared)}' and ";
            where = "anywhere in the package";
            if (shared == Visibility.Export) {
                where = "in another package";
            }
        }
        string member = target;
        if (target == "the constructor") {
            member = "the constructor of {ownerName}";
        }
        string worstName = this.names.quotedName(worst);
        string message = "{declPhrase} is protected, and {uses}. {ownerName} is sealed, but "
            + "{relation} {listed} {verbForm} {marked}neither 'final' nor 'sealed', so a class {where} can "
            + "extend {extended} and {verb} {member}. Mark {worstName} '{types.visibilityWord(scope)}'.";
        if (allClosable(wideners)) {
            message = message + " Or mark {listed} 'final' or 'sealed'.";
        }
        if (notes.length() == 0) {
            this.reporter.report(message, at);
            return;
        }
        this.reporter.report(message, at, notes.toArray());
    }

    // The declaration of a class this module declares, or null for a class it does not.
    classDeclarationOf(ClassType classType) -> ClassDeclarationNode? {
        for (let node in this.classNodes) {
            if (node.green() == classType.declaration()) {
                return node;
            }
        }
        return null;
    }
}

// A class whose protected members a leak refusal names, and for a sealed class the open subclasses that
// let other files extend the hierarchy.
final class ProtectedOwner {
    DeclaredType owner;
    List<ClassType> wideners;

    constructor(this.owner, this.wideners);
}

// The widest scope a class can be subclassed from, which is the leakage floor of its protected
// members, and for a sealed class every open descendant that other files can extend.
final class SubclassReach {
    Visibility scope;
    List<ClassType> wideners;

    constructor(this.scope, this.wideners);
}

// The reach of a type no code outside its file can subclass.
fileReach() -> SubclassReach {
    return new SubclassReach(Visibility.Protected, new List<ClassType>());
}

// Whether marking 'declared' 'final' or 'sealed' refuses no class: nothing extends it, and as a class
// no other package can name, nothing outside this build can.
closable(ClassType declared) -> bool {
    return declared.visibility() != Visibility.Export && declared.directSubclasses().length() == 0;
}

// The visibility a lowering fix gives a declaration that uses 'worst': none, which is private, where
// 'worst' is private, and 'public' otherwise.
loweredVisibility(DeclaredType worst) -> Visibility {
    if (worst.visibility() == Visibility.Private) {
        return Visibility.Private;
    }
    return Visibility.Public;
}

// Whether every class of 'classes' is closable.
allClosable(List<ClassType> classes) -> bool {
    for (let declared in classes) {
        if (!closable(declared)) {
            return false;
        }
    }
    return true;
}

// Why a struct member marked 'override' replaces and implements nothing. A 'toString' or an 'equals'
// gets the reason its own name is not enough, since that name is otherwise one of the three a struct
// does replace. A struct that declares conformances gets a note that they were searched too.
nothingToOverrideMessage(StructType structType, Method declared, TypeNames names) -> string {
    string name = declared.name();
    string owner = names.quotedName(structType);
    string refusal = "Method '{name}' of {owner} is marked 'override', and a struct inherits nothing to "
        + "override";
    if (structType.interfaces().length > 0) {
        refusal = "Method '{name}' of {owner} is marked 'override' but no interface {owner} implements "
            + "declares '{name}', and a struct inherits nothing";
    }
    switch (name) {
        "toString" -> {
            return "{refusal}. A 'toString' that takes parameters is an ordinary method, not the struct's "
                + "text form. Remove 'override'.";
        },
        "equals" -> {
            return "{refusal}. An 'equals' that does not take exactly one {names.quoted(structType)} is an "
                + "ordinary method, not the struct's equality. Remove 'override'.";
        },
        default -> {
            if (structType.interfaces().length > 0) {
                return "{refusal}. Remove 'override'.";
            }
            return "{refusal}; only 'toString', 'hash', and 'equals' replace a built-in behavior of a "
                + "struct. Remove 'override'.";
        },
    }
}

// The refusal of a 'throws' list that names a type beside a subclass of it.
overlappingThrowsMessage(Type wider, Type narrower, TypeNames names) -> string {
    string widerName = names.quoted(wider);
    string narrowerName = names.quoted(narrower);
    string relation = "{narrowerName} is a subclass of {widerName}";
    if (narrower is TypeParamType) {
        relation = "{narrowerName} can only be {widerName} or a subclass of it";
    }
    return "The 'throws' list names both {widerName} and {narrowerName}. {relation}, so "
        + "{widerName} alone covers both. Remove {narrowerName}.";
}

// Whether the class declaration has a constructor in its body.
declaresConstructor(ClassDeclarationNode node) -> bool {
    let body = node.body();
    for (long i = 0; i < body.membersCount(); i++) {
        let member = body.members(i);
        if (member is FunctionDeclarationNode) {
            let introducer = member.introducer();
            if (introducer != null && introducer.kind() == SyntaxKind.ConstructorKeyword) {
                return true;
            }
        }
    }
    return false;
}

// The widest scope from which a class can be subclassed: its file for a 'final' class, its own
// visibility for an open one, and for a sealed class the widest reach of its direct subclasses, which
// its own module declares, within its own visibility. A sealed class also lists the open descendants
// that other files can extend.
subclassReach(ClassType classType) -> SubclassReach {
    if (classType.isFinal()) {
        return fileReach();
    }
    if (!classType.isSealed()) {
        return new SubclassReach(classType.visibility(), new List<ClassType>());
    }
    Visibility widest = Visibility.Protected;
    let wideners = new List<ClassType>();
    long ceiling = types.visibilityTier(classType.visibility());
    for (let subclass in classType.directSubclasses()) {
        let reach = subclassReach(subclass);
        Visibility scope = reach.scope;
        if (types.visibilityTier(scope) > ceiling) {
            scope = classType.visibility();
        }
        if (types.visibilityTier(scope) > types.visibilityTier(widest)) {
            widest = scope;
        }
        if (!subclass.isSealed() && types.visibilityTier(reach.scope) > 0) {
            wideners.push(subclass);
        }
        for (let widener in reach.wideners) {
            wideners.push(widener);
        }
    }
    return new SubclassReach(widest, wideners);
}

// The least-visible declared type mentioned anywhere inside the type, the first one met where
// several are equally visible.
leastVisibleMention(Type type) -> DeclaredType? {
    let mentioned = new List<DeclaredType>();
    mentionedTypes(type, mentioned);
    DeclaredType? worst = null;
    for (let declared in mentioned) {
        worst = lessVisibleOf(worst, declared);
    }
    return worst;
}

// Every declared type mentioned inside the type, in the order a reader meets them: arrays and
// optionals look through to their element, a function type covers its return and parameter types,
// an instantiation covers its template and every type argument, and type parameters mention nothing
// themselves.
mentionedTypes(Type type, List<DeclaredType> into) {
    switch (type) {
        is OptionalType optional -> {
            mentionedTypes(optional.inner(), into);
        },
        is ArrayType array -> {
            mentionedTypes(array.element(), into);
        },
        is FunctionType functionType -> {
            mentionedTypes(functionType.returnType(), into);
            for (let parameter in functionType.parameterTypes()) {
                mentionedTypes(parameter, into);
            }
        },
        is InstantiationType instantiation -> {
            into.push(instantiation.template());
            for (let argument in instantiation.arguments()) {
                mentionedTypes(argument, into);
            }
        },
        is DeclaredType declared -> {
            into.push(declared);
        },
        default -> { },
    }
}

// One place a signature names a type, as the visibility check reads it.
sealed abstract class LeakSite {
    protected constructor();
}

// A type named in a signature: the declaration reaching as far as 'reach', described by
// 'declPhrase', names 'mentioned' as its 'role' at 'at'. 'target' and 'lowering' are what a fix that
// lowers the declaration names and changes, and 'protectedOwner' is the class of a protected member.
final class MentionSite extends LeakSite {
    protected Type mentioned;
    protected Visibility reach;
    protected string declPhrase;
    protected string target;
    protected string role;
    protected Span at;
    protected Lowering lowering;
    protected ProtectedOwner? protectedOwner;

    protected constructor(this.mentioned, this.reach, this.declPhrase, this.target, this.role,
                          this.at, this.lowering, this.protectedOwner);
}

// The type 'declared' extends: 'base', a class unless 'extendsInterface', named at 'at'.
final class BaseSite extends LeakSite {
    protected DeclaredType declared;
    protected DeclaredType base;
    protected bool extendsInterface;
    protected string declPhrase;
    protected Span at;

    protected constructor(this.declared, this.base, this.extendsInterface, this.declPhrase,
                          this.at);
}

// The signatures among `sites` that mention each declared type. A base a type extends is not a
// mention, since lowering the type does not lower its base.
mentionsIn(List<LeakSite> sites) -> SignatureMentions {
    let mentions = new SignatureMentions();
    for (let site in sites) {
        if (site is MentionSite) {
            mentions.note(site.mentioned, site.reach, site.lowering.owner ?? site.lowering.declared);
        }
    }
    return mentions;
}

// The signatures of one module that mention each declared type, by how far each reaches, so a fix
// that lowers a type is withheld where a declaration that stays more visible names it. A type's own
// members are left out, because the fix lowers them with the type.
final class SignatureMentions {
    Map<DeclaredType, List<Mention>> byType;

    protected constructor() {
        this.byType = new Map<DeclaredType, List<Mention>>();
    }

    // Records that a declaration reaching as far as 'reach', a member of 'owner' or a function where
    // 'owner' is null, mentions 'mentioned' in its signature.
    protected note(Type mentioned, Visibility reach, DeclaredType? owner) {
        let found = new List<DeclaredType>();
        mentionedTypes(mentioned, found);
        for (let declared in found) {
            let recorded = this.byType.get(declared);
            if (recorded == null) {
                recorded = new List<Mention>();
                this.byType.set(declared, recorded);
            }
            recorded.push(new Mention(owner, types.visibilityTier(reach)));
        }
    }

    // Whether a declaration other than a member of 'declared' mentions it and reaches further than
    // 'lowered'.
    protected reachesAbove(DeclaredType declared, Visibility lowered) -> bool {
        let recorded = this.byType.get(declared);
        if (recorded == null) {
            return false;
        }
        for (let mention in recorded) {
            if (mention.owner != declared && mention.tier > types.visibilityTier(lowered)) {
                return true;
            }
        }
        return false;
    }
}

// One signature's mention of a type: the type the mentioning member belongs to, null for a
// function, and how far the member reaches.
final class Mention {
    protected DeclaredType? owner;
    protected long tier;

    protected constructor(this.owner, this.tier);
}

lessVisibleOf(DeclaredType? left, DeclaredType? right) -> DeclaredType? {
    if (left == null) {
        return right;
    }
    if (right == null) {
        return left;
    }
    if (types.visibilityTier(right.visibility()) < types.visibilityTier(left.visibility())) {
        return right;
    }
    return left;
}

// The fix that lowers a declaration to the visibility of the type it uses: remove its mark when
// that type is private, else mark it 'public'. When the declaration is the class or struct
// 'lowered', its members marked above the new visibility are lowered with it.
loweringFix(string target, Visibility declared, DeclaredType worst, DeclaredType? lowered) -> string {
    string word = types.visibilityWord(declared);
    if (worst.visibility() == Visibility.Private) {
        string fix = "remove '{word}' from "
            + markedPhrase(target, markedMembers(lowered, declared), word);
        if (declared == Visibility.Export) {
            let marked = markedMembers(lowered, Visibility.Public);
            if (marked.length() > 0) {
                fix = "{fix}, and 'public' from {markedPhrase("", marked, "public")}";
            }
        }
        return fix;
    }
    return "mark {markedPhrase(target, markedMembers(lowered, declared), word)} 'public'";
}

// The target and the members that lower with it, as a fix names them: every one of up to three,
// or "its 'export' members" for more. An empty target names the members alone.
markedPhrase(string target, List<string> members, string word) -> string {
    if (members.length() == 0) {
        return target;
    }
    if (members.length() > 3) {
        if (target.length == 0) {
            return "its '{word}' members";
        }
        return "{target} and its '{word}' members";
    }
    let named = new List<string>();
    if (target.length > 0) {
        named.push(target);
    }
    for (let member in members) {
        named.push(member);
    }
    return diagnostics.andJoined(named.toArray());
}

// The members the type declares itself with exactly this visibility, as a fix names them: "its
// constructor" (or "its constructors"), then the fields and methods by name.
markedMembers(DeclaredType? owner, Visibility visibility) -> List<string> {
    let found = new List<string>();
    if (owner == null || owner is InterfaceType) {
        return found;
    }
    long constructors = 0;
    let named = new List<string>();
    for (let fields in [typemembers.fieldsOf(owner), typemembers.staticFieldsOf(owner)]) {
        if (fields != null) {
            for (let field in fields) {
                if (field.definingType() == owner && field.visibility() == visibility) {
                    named.push("'{field.name()}'");
                }
            }
        }
    }
    for (let methods in [typemembers.methodsOf(owner), typemembers.staticMethodsOf(owner)]) {
        if (methods != null) {
            for (let method in methods) {
                if (method.definingType() != owner || method.visibility() != visibility) {
                    continue;
                }
                if (method.isConstructor()) {
                    constructors++;
                } else {
                    named.push("'{method.name()}'");
                }
            }
        }
    }
    if (constructors == 1) {
        found.push("its constructor");
    } else if (constructors > 1) {
        found.push("its constructors");
    }
    for (let name in named) {
        found.push(name);
    }
    return found;
}

// How a leak refusal names the less visible type it found, up to the phrase that says how far that
// type can be used: "its parameter type uses 'Hidden', which is".
mentionPhrase(string role, Type mentioned, DeclaredType worst, string quotedWorst) -> string {
    if (role == "implemented interface") {
        if (types.authorityOf(mentioned) == worst) {
            return "the interface it implements, {quotedWorst}, is";
        }
        return "{quotedWorst}, a type argument of the interface it implements, is";
    }
    if (role == "extended interface type argument") {
        return "{quotedWorst}, a type argument of the interface it extends, is";
    }
    if (role == "base class type argument") {
        return "{quotedWorst}, a type argument of its base class, is";
    }
    return "its {role} uses {quotedWorst}, which is";
}

notNameablePhrase(DeclaredType worst) -> string {
    if (worst.visibility() == Visibility.Private) {
        return "private to module '{worst.modulePath()}'";
    }
    return "only public inside {types.packagePhrase(worst)}";
}

// The struct a field stores inline: a plain struct, or an instantiation of a generic struct
// with its own substituted fields.
// Depth-first search for a by-value field path from origin back to itself. An instantiation
// counts as its template, so 'Wrap<T>' inside 'struct Wrap<T>' closes the cycle. explored
// bounds the walk on graphs with shared members.
findPathBackTo(StructType origin, Type current, List<CycleStep> path, Set<Type> explored) -> bool {
    let fields = typemembers.fieldsOf(current);
    if (fields == null) {
        return false;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let next = valuecycles.byValueStruct(field.type());
        if (next == null) {
            continue;
        }
        path.push(new CycleStep(current, field));
        if (types.authorityOf(next) == origin) {
            return true;
        }
        if (explored.add(next) && findPathBackTo(origin, next, path, explored)) {
            return true;
        }
        path.pop();
    }
    return false;
}

firstIndexOf(List<string> names, string name) -> long {
    for (long i = 0; i < names.length(); i++) {
        if (names.get(i) == name) {
            return i;
        }
    }
    return -1;
}

// Every bare identifier expression under the node, with its content span.
collectIdentifiers(GreenNode node, long fullStart, List<FoundIdentifier> out) {
    if (node.kind() == SyntaxKind.IdentifierExpression && node.slotCount() > 0) {
        let token = node.slot(0);
        if (token is GreenToken) {
            out.push(new FoundIdentifier(token.text(),
                source.makeSpan(fullStart + token.leadingLength(), token.contentLength())));
        }
        return;
    }
    long offset = fullStart;
    for (long i = 0; i < node.slotCount(); i++) {
        let child = node.slot(i);
        if (child != null) {
            if (child is GreenNode) {
                collectIdentifiers(child, offset, out);
            }
            offset = offset + child.fullLength();
        }
    }
}
