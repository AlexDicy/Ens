// Declaration-level checks that run after layout: struct by-value containment cycles, the
// field-default ordering rule, field initialization, the declared-throws contracts, and the
// signature-leakage rule. All of them read resolved members; none of them type expressions.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import RelatedLocation from support.diagnostics;
import support.diagnostics;
import ModuleContext from context;
import phases.layout;
import phases.members;
import model.convert;
import model.hierarchy;
import model.typemembers;
import MemberConstraint from model.typemembers;
import Field from model.typemembers;
import Method from model.typemembers;
import Signature from model.typemembers;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import InstantiationType from model.types;
import DeclaredType from model.types;
import ClassType from model.types;
import StructType from model.types;
import InterfaceType from model.types;
import PrimitiveBinding from model.types;
import TypeParamType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

public checkProgram(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    for (long i = 0; i < contexts.length(); i++) {
        let checker = new ModuleChecks(contexts.get(i), collected);
        checker.run();
    }
    return diagnostics.sorted(collected);
}

class FoundIdentifier {
    protected string name;
    protected Span span;

    protected constructor(this.name, this.span);
}

class CycleStep {
    protected Type owner;
    protected Field field;

    protected constructor(this.owner, this.field);
}

class ModuleChecks {
    ModuleContext context;
    Reporter reporter;
    TypeNames names;
    string modulePath;
    MemberConstraint[] noConstraints;

    List<StructDeclarationNode> structNodes;
    List<ClassDeclarationNode> classNodes;
    List<InterfaceDeclarationNode> interfaceNodes;
    List<PrimitiveDeclarationNode> primitiveNodes;

    protected constructor(ModuleContext context, List<FileDiagnostic> collected) {
        this.context = context;
        this.reporter = new Reporter(context.module().filePath(), collected);
        this.names = context.names();
        this.modulePath = context.module().canonicalPath();
        this.noConstraints = [];
        this.structNodes = new List<StructDeclarationNode>();
        this.classNodes = new List<ClassDeclarationNode>();
        this.interfaceNodes = new List<InterfaceDeclarationNode>();
        this.primitiveNodes = new List<PrimitiveDeclarationNode>();
    }

    protected run() {
        let root = this.context.root();
        if (root == null) {
            return;
        }
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is StructDeclarationNode declaration -> {
                    this.structNodes.push(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.classNodes.push(declaration);
                },
                is InterfaceDeclarationNode declaration -> {
                    this.interfaceNodes.push(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.primitiveNodes.push(declaration);
                },
                default -> { },
            }
        }
        this.checkStructCycles();
        this.checkFieldDefaultOrder();
        this.checkFieldInitialization();
        this.checkImplicitBaseConstruction();
        this.checkInterfaceRedeclarations();
        this.checkPrimitiveConformances();
        this.checkStructConformances();
        this.checkDeclaredThrows();
        this.checkVisibilityLeaks();
    }

    bindingFor(PrimitiveDeclarationNode node) -> PrimitiveBinding? {
        let store = this.context.resolver().typeStore();
        let primitive = types.primitiveNamed(store, node.name().text());
        if (primitive == null) {
            return null;
        }
        let binding = types.bindingOf(primitive);
        if (binding != null && binding.declaration() == node.green()) {
            return binding;
        }
        return null;
    }

    // A conformance a binding declares has to hold: every method the interface and the
    // interfaces it extends require must be a member of the binding, with a matching signature
    // and the 'override' marker, exactly as a class implementing the same interface would.
    // Whole-program, because the interface may be declared in another module.
    checkPrimitiveConformances() {
        for (long n = 0; n < this.primitiveNodes.length(); n++) {
            let node = this.primitiveNodes.get(n);
            let binding = this.bindingFor(node);
            if (binding == null) {
                continue;
            }
            Span at = node.name().span();
            let checked = new Set<Type>();
            for (let implemented in binding.interfaces()) {
                for (let level in hierarchy.interfaceLadderOf(implemented)) {
                    if (!checked.add(level)) {
                        continue;
                    }
                    this.checkBindingLevelSatisfied(binding, implemented, level, at);
                }
            }
            this.checkBindingOverrideMarkers(binding, node);
        }
    }

    checkBindingLevelSatisfied(PrimitiveBinding binding, Type implemented, Type level, Span at) {
        let required = typemembers.methodsOf(level);
        if (required == null) {
            return;
        }
        string interfaceName = this.names.of(implemented);
        string levelName = this.names.of(level);
        for (long i = 0; i < required.length(); i++) {
            let requirement = required.get(i);
            let provided = members.findSameSignature(binding.methods(), requirement.name(),
                requirement.signature());
            if (provided == null) {
                string requiredBy = "";
                if (level != implemented) {
                    requiredBy = ", required by '{levelName}', which '{interfaceName}' extends";
                }
                if (members.unreplaceableMember(binding.primitive(), requirement.name(),
                        requirement.signature(), this.names) != null) {
                    this.reporter.report("The binding for '{binding.name()}' implements "
                        + "'{interfaceName}' but cannot provide "
                        + "'{layout.methodDisplay(requirement, this.names)}'{requiredBy}, because the "
                        + "compiler implements '{requirement.name()}' on a value of type "
                        + "'{binding.name()}' itself. Stop implementing '{interfaceName}' "
                        + "here.", at);
                    continue;
                }
                this.reporter.report("The binding for '{binding.name()}' implements "
                    + "'{interfaceName}' but does not provide "
                    + "'{layout.methodDisplay(requirement, this.names)}'{requiredBy}. Declare the method "
                    + "here, or stop implementing '{interfaceName}'.", at);
                continue;
            }
            if (!convert.isAssignableStrict(requirement.signature().returnType(),
                    provided.signature().returnType())) {
                string requiredReturn = this.names.of(requirement.signature().returnType());
                this.reporter.report("Method '{requirement.name()}' of the '{binding.name()}' "
                    + "binding returns '{this.names.of(provided.signature().returnType())}', but "
                    + "interface '{levelName}' requires '{requiredReturn}'. Change the return type "
                    + "of '{requirement.name()}' to '{requiredReturn}'.", at);
            }
            if (requirement.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{requirement.name()}' of the '{binding.name()}' "
                    + "binding must be marked 'noreturn', because interface '{levelName}' "
                    + "declares it 'noreturn'.", at);
            }
        }
    }

    // The marker rules, with no base chain to consult: a member marked 'override' has to implement
    // a declared conformance, and one that implements a conformance has to carry the marker.
    checkBindingOverrideMarkers(PrimitiveBinding binding, PrimitiveDeclarationNode node) {
        let body = node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FunctionDeclarationNode)) {
                continue;
            }
            let declared = members.methodDeclaredBy(binding.methods(), member.green());
            if (declared == null) {
                continue;
            }
            let nameToken = member.name();
            if (nameToken == null) {
                continue;
            }
            let requiringInterface = this.requiringInterfaceName(binding.interfaces(), declared);
            if (declared.isOverride()) {
                if (requiringInterface == null) {
                    this.reporter.report("Method '{declared.name()}' of the '{binding.name()}' "
                        + "binding is marked 'override' but no interface it implements "
                        + "declares it. Remove 'override'.", nameToken.span());
                }
                continue;
            }
            if (requiringInterface != null) {
                this.reporter.report("Method '{declared.name()}' of the '{binding.name()}' binding "
                    + "implements a method declared in interface '{requiringInterface}' but is not "
                    + "marked 'override'. Write 'override' before '{declared.name()}'.", nameToken.span());
            }
        }
    }

    // Every method an interface a struct implements requires must be a method of that struct,
    // with a matching signature and the 'override' marker. The interfaces the implemented one
    // extends require their methods too. Whole-program, because the interface may be declared in
    // another module.
    checkStructConformances() {
        for (long n = 0; n < this.structNodes.length(); n++) {
            let node = this.structNodes.get(n);
            let structType = this.structFor(node);
            if (structType == null) {
                continue;
            }
            Span at = node.name().span();
            let checked = new Set<Type>();
            for (let implemented in structType.interfaces()) {
                for (let level in hierarchy.interfaceLadderOf(implemented)) {
                    if (!checked.add(level)) {
                        continue;
                    }
                    this.checkStructLevelSatisfied(structType, implemented, level, at);
                }
            }
            this.checkStructOverrideMarkers(structType, node);
        }
    }

    // One rung of an implemented interface's ladder. A struct's own members are its whole
    // implement, because a struct has no base to inherit a requirement from.
    checkStructLevelSatisfied(StructType structType, Type implemented, Type level, Span at) {
        let required = typemembers.methodsOf(level);
        if (required == null) {
            return;
        }
        string structName = this.names.nameOf(structType);
        string interfaceName = this.names.of(implemented);
        string levelName = this.names.of(level);
        for (long i = 0; i < required.length(); i++) {
            let requirement = required.get(i);
            string requirementShown = layout.methodDisplay(requirement, this.names);
            string requiredBy = "";
            if (level != implemented) {
                requiredBy = ", required by '{levelName}', which '{interfaceName}' extends";
            }
            let provided = members.findSameSignature(structType.methods(), requirement.name(),
                requirement.signature());
            if (provided == null) {
                this.reporter.report("Struct '{structName}' implements "
                    + "'{interfaceName}' but does not provide "
                    + "'{requirementShown}'{requiredBy}. Declare the method here, "
                    + "or stop implementing '{interfaceName}'.", at);
                continue;
            }
            if (provided.isConditional()) {
                this.reporter.report("Struct '{structName}' provides '{requirementShown}' only "
                    + "for some type arguments, but '{interfaceName}' needs it for every type "
                    + "argument. Remove the '<...>' list from '{requirement.name()}', or stop "
                    + "implementing '{interfaceName}'.", at);
                continue;
            }
            if (layout.narrowsReturnShape(requirement.signature(), provided.signature())) {
                this.reporter.report("Method '{requirement.name()}' of struct "
                    + "'{structName}' returns "
                    + "'{this.names.of(provided.signature().returnType())}', but interface "
                    + "'{levelName}' requires "
                    + "'{this.names.of(requirement.signature().returnType())}', "
                    + layout.narrowedReturnAdvice(requirement.signature().returnType(),
                        provided.signature().returnType(), this.names)
                    + ".", at);
            } else if (!layout.overrideCompatible(requirement.signature(), provided.signature())) {
                string requiredReturn = this.names.of(requirement.signature().returnType());
                this.reporter.report("Method '{requirement.name()}' of struct "
                    + "'{structName}' returns "
                    + "'{this.names.of(provided.signature().returnType())}', but interface "
                    + "'{levelName}' requires '{requiredReturn}'. Change the return type of "
                    + "'{requirement.name()}' to '{requiredReturn}'.", at);
            }
            if (requirement.isNoreturn() && !provided.isNoreturn()) {
                this.reporter.report("Method '{requirement.name()}' of struct "
                    + "'{structName}' must be marked 'noreturn', because interface "
                    + "'{levelName}' declares it 'noreturn'.", at);
            }
            // A bound the struct satisfies is written wherever the struct is nameable, and the
            // generic body behind that bound calls the requirement, so the implementation must be
            // as visible as the struct.
            Visibility requiredReach = types.followedMemberVisibility(structType.visibility());
            if (provided.visibility() == Visibility.Private || types.visibilityTier(provided.visibility())
                        < types.visibilityTier(requiredReach)) {
                this.reporter.report("Method '{requirement.name()}' of struct "
                    + "'{structName}' is "
                    + "{types.visibilityWord(provided.visibility())}, but it provides "
                    + "'{requirementShown}' for interface '{interfaceName}', so it must be usable "
                    + "everywhere '{structName}' is. Mark it "
                    + "'{types.visibilityWord(requiredReach)}'.", at);
            }
        }
    }

    // A struct member marked 'override' has to implement something, either a built-in behavior of
    // the struct or a method an implemented interface declares, and one that implements a
    // requirement has to carry the marker.
    checkStructOverrideMarkers(StructType structType, StructDeclarationNode node) {
        let body = node.body();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FunctionDeclarationNode)) {
                continue;
            }
            let declared = members.methodDeclaredBy(structType.methods(), member.green());
            if (declared == null || declared.isConstructor()) {
                continue;
            }
            let nameToken = member.name();
            if (nameToken == null) {
                continue;
            }
            let behavior = members.builtinBehaviorReplaced(structType, declared.name(), declared.signature());
            let requiringInterface = this.requiringInterfaceName(structType.interfaces(), declared);
            if (declared.isOverride()) {
                if (behavior == null && requiringInterface == null) {
                    this.reporter.report(nothingToOverrideMessage(structType, declared, this.names),
                        nameToken.span());
                }
                continue;
            }
            if (behavior == null && requiringInterface != null) {
                this.reporter.report("Method '{declared.name()}' of struct "
                    + "'{this.names.nameOf(structType)}' implements a method declared in "
                    + "interface '{requiringInterface}' but is not marked 'override'. Write "
                    + "'override' before '{declared.name()}'.", nameToken.span());
            }
        }
    }

    // The interface whose requirement this member implements, as it reads in a diagnostic, or null.
    requiringInterfaceName(Type[] interfaces, Method declared) -> string? {
        for (let implemented in interfaces) {
            for (let level in hierarchy.interfaceLadderOf(implemented)) {
                let methods = typemembers.methodsOf(level);
                if (methods == null) {
                    continue;
                }
                if (members.findSameSignature(methods, declared.name(),
                        declared.signature()) != null) {
                    return this.names.of(level);
                }
            }
        }
        return null;
    }

    structFor(StructDeclarationNode node) -> StructType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    classFor(ClassDeclarationNode node) -> ClassType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    interfaceFor(InterfaceDeclarationNode node) -> InterfaceType? {
        let store = this.context.resolver().typeStore();
        let found = store.findDeclared(this.modulePath, node.name().text());
        if (found is InterfaceType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    // ---- Struct by-value containment cycles ----

    checkStructCycles() {
        for (long i = 0; i < this.structNodes.length(); i++) {
            let found = this.structFor(this.structNodes.get(i));
            if (found == null) {
                continue;
            }
            let path = new List<CycleStep>();
            let explored = new Set<Type>();
            if (!findPathBackTo(found, found, path, explored)) {
                continue;
            }
            string foundName = this.names.nameOf(found);
            let steps = new List<string>();
            for (long s = 0; s < path.length(); s++) {
                let step = path.get(s);
                steps.push("field '{step.field.name()}' of '{this.names.of(step.owner)}' has type "
                    + "'{this.names.of(step.field.type())}'");
            }
            let builder = new StringBuilder();
            builder.append("Struct '{foundName}' contains itself: "
                + "{diagnostics.andJoined(steps.toArray())}");
            string exampleName = foundName;
            string quotedExample = this.names.quotedName(found);
            string located = "";
            let example = byValueStruct(path.get(0).field.type());
            if (example != null) {
                let authority = types.authorityOf(example);
                if (authority != null) {
                    exampleName = authority.name();
                    quotedExample = this.names.quotedName(authority);
                    if (authority.modulePath() != this.modulePath) {
                        located = " where module '{this.names.importPathOf(authority)}' declares it";
                    }
                }
            }
            builder.append(". A struct keeps its fields inside itself, so every '{foundName}' would "
                + "contain another '{foundName}' without end. Make {quotedExample} a class, as in "
                + "'class {exampleName} \{ ... \}'{located}, because a class field only refers to "
                + "another object.");
            this.reporter.report(builder.toString(), path.get(0).field.nameSpan());
        }
    }

    // ---- Field default ordering ----

    // A field default may only reference fields declared before it. The rule is syntactic:
    // an identifier in a default that names this type's own field at the same or a later
    // position, and nothing else visible at module scope, cannot resolve.
    checkFieldDefaultOrder() {
        for (long i = 0; i < this.structNodes.length(); i++) {
            let node = this.structNodes.get(i);
            if (this.structFor(node) != null) {
                this.checkDefaultOrderIn(node.body());
            }
        }
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            if (this.classFor(node) != null) {
                this.checkDefaultOrderIn(node.body());
            }
        }
    }

    // Type-level fields stay out on both sides. A static const's initializer is a compile-time
    // constant the constants phase owns, and a lazy const's runs on the first read, so neither
    // is part of an instance's initialization order.
    checkDefaultOrderIn(MemberListNode body) {
        let fieldNames = new List<string>();
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                fieldNames.push(member.name().text());
            }
        }
        long fieldIndex = 0;
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (member is FieldDeclarationNode && !members.isTypeLevelField(member)) {
                let defaultValue = member.defaultValue();
                if (defaultValue != null) {
                    this.checkDefaultReferences(member.name().text(), fieldIndex,
                        defaultValue.value(), fieldNames);
                }
                fieldIndex++;
            }
        }
    }

    checkDefaultReferences(string fieldName, long fieldIndex, Expression value, List<string> fieldNames) {
        let found = new List<FoundIdentifier>();
        collectIdentifiers(value.green(), value.fullSpan().start, found);
        for (long i = 0; i < found.length(); i++) {
            let identifier = found.get(i);
            long named = firstIndexOf(fieldNames, identifier.name);
            if (named < fieldIndex) {
                continue;
            }
            if (this.visibleAtModuleScope(identifier.name)) {
                continue;
            }
            if (named == fieldIndex && identifier.name == fieldName) {
                this.reporter.report("The default value of field '{fieldName}' uses '{fieldName}' "
                    + "itself, and '{fieldName}' has no value until this default is computed. "
                    + "Remove '{fieldName}' from its own default, or use a field declared above "
                    + "'{fieldName}'.", identifier.span);
            } else {
                this.reporter.report("The default value of field '{fieldName}' uses "
                    + "'{identifier.name}', which is declared below '{fieldName}', so "
                    + "'{identifier.name}' has no value yet. Move '{identifier.name}' above "
                    + "'{fieldName}', or remove '{identifier.name}' from the default.",
                    identifier.span);
            }
        }
    }

    // Names a default-value identifier could still resolve to when it is not an earlier
    // sibling field: module functions, the ones the language provides, module types, imported
    // names, and the implicit exception base class.
    visibleAtModuleScope(string name) -> bool {
        if (name == "Error") {
            return true;
        }
        let functions = this.context.functions().entriesNamed(name);
        if (functions != null && functions.length() > 0) {
            return true;
        }
        if (this.context.declarations().hasFunctionNamed(name)) {
            return true;
        }
        let store = this.context.resolver().typeStore();
        if (store.findDeclared(this.modulePath, name) != null) {
            return true;
        }
        return this.context.linkTable().binding(name) != null;
    }

    // ---- Field initialization ----

    // A struct field may have any type, including a non-defaultable one; such a struct becomes
    // non-defaultable itself and must be constructed rather than zero-initialized. Only class
    // fields are checked here, since a class always has a constructor path.
    checkFieldInitialization() {
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType != null) {
                this.checkClassFieldInitialization(classType, node);
            }
        }
    }

    // A class that declares any constructor is checked by the definite-assignment pass over each
    // constructor body. Only a class with no constructor at all is caught here: it has no path on
    // which a non-defaultable field could be assigned.
    checkClassFieldInitialization(ClassType classType, ClassDeclarationNode node) {
        if (declaresConstructor(node)) {
            return;
        }
        let fields = classType.fields();
        for (long i = classType.baseFieldCount(); i < fields.length(); i++) {
            let field = fields.get(i);
            if (field.type() is ErrorType) {
                continue;
            }
            if (field.hasDefault()) {
                continue;
            }
            if (field.isConst()) {
                this.reporter.report("Field '{field.name()}' of class '{this.names.nameOf(classType)}' is "
                    + "'const' with no default value, and '{this.names.nameOf(classType)}' has no "
                    + "constructor to assign it. Add one, for example "
                    + "'constructor(this.{field.name()});', or give the field a default value.",
                    field.nameSpan());
                continue;
            }
            if (convert.isDefaultable(field.type())) {
                continue;
            }
            string shown = this.names.of(field.type());
            this.reporter.report("Field '{field.name()}' of class '{this.names.nameOf(classType)}' has "
                + "type '{shown}', which cannot be null, and nothing ever assigns it. Give "
                + "it a default ('{shown} {field.name()} = ...;'), make it nullable "
                + "('{shown}? {field.name()};') or add a constructor that assigns it "
                + "('constructor(this.{field.name()});').", field.nameSpan());
        }
    }

    // ---- Implicit base construction ----

    // A class that declares no constructor is built by the zero-argument constructor of its base
    // class. A base that declares constructors must have one the class can reach.
    checkImplicitBaseConstruction() {
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType == null || declaresConstructor(node)) {
                continue;
            }
            let chain = typemembers.implicitBaseConstructor(classType);
            if (chain.owner() == null || chain.chosen() != null || chain.chooser() != classType) {
                continue;
            }
            // An unmarked constructor of a file-private class already reaches its whole file.
            string marker = "";
            if (classType.visibility() != Visibility.Private) {
                marker = types.visibilityWord(classType.visibility());
            }
            string opening = "Class '{this.names.nameOf(classType)}' declares no constructor";
            this.reporter.report(typemembers.implicitBaseRefusal(opening, chain, null, false, marker,
                this.names), node.name().span());
        }
    }

    // ---- Interface requirement redeclarations ----

    // A sub-interface inherits every requirement of the interface it extends, so redeclaring one
    // (same name and parameter types) is an error naming the ancestor that declares it. Genuine
    // overloads with different parameters stay legal, like overloads within one interface.
    checkInterfaceRedeclarations() {
        for (long i = 0; i < this.interfaceNodes.length(); i++) {
            let node = this.interfaceNodes.get(i);
            let interfaceType = this.interfaceFor(node);
            if (interfaceType == null) {
                continue;
            }
            let methods = interfaceType.methods();
            for (long m = 0; m < methods.length(); m++) {
                let method = methods.get(m);
                let inherited = this.inheritedRequirement(interfaceType, method);
                if (inherited == null) {
                    continue;
                }
                this.reporter.report("Interface '{this.names.nameOf(interfaceType)}' already requires "
                    + "'{layout.methodDisplay(inherited, this.names)}', because it extends "
                    + "'{this.names.of(inherited.definingType())}', which declares it. Remove this "
                    + "second declaration of '{method.name()}'.", method.signature().nameSpan());
            }
        }
    }

    // The nearest requirement up the extends chain that the method redeclares: the same name
    // and parameter types on an interface the declaring one extends.
    inheritedRequirement(InterfaceType interfaceType, Method method) -> Method? {
        let seen = new Set<Type>();
        Type? current = hierarchy.baseOf(interfaceType);
        while (current != null && seen.add(current)) {
            let candidates = typemembers.methodsOf(current);
            if (candidates != null) {
                for (long i = 0; i < candidates.length(); i++) {
                    let candidate = candidates.get(i);
                    if (candidate.name() == method.name()
                            && typemembers.sameParameterTypes(candidate.signature(), method.signature())) {
                        return candidate;
                    }
                }
            }
            current = hierarchy.baseOf(current);
        }
        return null;
    }

    // ---- Declared throws ----

    checkDeclaredThrows() {
        let functions = this.context.functions().all();
        for (long i = 0; i < functions.length(); i++) {
            let entry = functions.get(i);
            if (!entry.isBuiltin() && !entry.isExternal()) {
                this.validateThrows(entry.signature());
            }
        }
        let store = this.context.resolver().typeStore();
        for (let declared in this.context.declarations().types()) {
            let owned = store.findDeclared(this.modulePath, declared.name());
            if (owned == null || owned.declaration() != declared.node()) {
                continue;
            }
            switch (owned) {
                is StructType structType -> {
                    this.validateMethodThrows(structType.methods(), owned.declaration());
                    this.validateMethodThrows(structType.staticMethods(),
                        owned.declaration());
                },
                is ClassType classType -> {
                    this.validateMethodThrows(classType.methods(), owned.declaration());
                    this.validateMethodThrows(classType.staticMethods(), owned.declaration());
                },
                is InterfaceType interfaceType -> {
                    this.validateMethodThrows(interfaceType.methods(), owned.declaration());
                },
                default -> { },
            }
        }
        this.validateFunctionTypeThrows();
    }

    // A conditional member's list is judged under its constraints, where the restated parameter
    // carries extra bounds.
    validateMethodThrows(List<Method> methods, GreenNode owner) {
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.isConditional()) {
                this.validateThrowsList(method.signature().throwsTypes(),
                    method.signature().throwsTypeSpans(), owner, method.constraints());
            } else {
                this.validateThrows(method.signature());
            }
        }
    }

    validateThrows(Signature signature) {
        this.validateThrowsList(signature.throwsTypes(), signature.throwsTypeSpans(),
            null, this.noConstraints);
    }

    validateFunctionTypeThrows() {
        for (let mention in this.context.resolver().takeFunctionThrowsMentions()) {
            this.validateThrowsList(mention.thrownTypes(), mention.spans(),
                mention.scopeOwner(), mention.scopeConstraints());
        }
    }

    validateThrowsList(Type[] declared, Span[] spans, GreenNode? scopeOwner,
                       MemberConstraint[] scopeConstraints) {
        if (declared.length == 0) {
            return;
        }
        let errorClass = this.context.resolver().errorClass();
        let accepted = new List<Type>();
        let acceptedSpans = new List<Span>();
        for (long i = 0; i < declared.length; i++) {
            Type thrown = declared[i];
            if (thrown is ErrorType) {
                continue;
            }
            if (errorClass == null || !hierarchy.isAlwaysSubclassOfUnder(thrown, errorClass, scopeOwner,
                    scopeConstraints)) {
                if (thrown is TypeParamType) {
                    this.reporter.report("A declared throws type must be 'Error' or a subclass "
                        + "of it, and the type parameter '{this.names.of(thrown)}' has no "
                        + "bound under 'Error'. Bound it as '{this.names.of(thrown)}: Error', "
                        + "or by a subclass of 'Error'.", spans[i]);
                    continue;
                }
                string shown = this.names.of(thrown);
                this.reporter.report("A declared throws type must be 'Error' or a subclass of "
                    + "it, and '{shown}' is neither. Remove '{shown}' from the 'throws' list, or "
                    + "replace it with a class that extends 'Error'.", spans[i]);
                continue;
            }
            bool overlaps = false;
            for (long a = 0; a < accepted.length(); a++) {
                let previous = accepted.get(a);
                if (thrown == previous) {
                    this.reporter.report("The 'throws' list names '{this.names.of(thrown)}' twice. "
                        + "Remove this second '{this.names.of(thrown)}'.", spans[i]);
                    overlaps = true;
                    break;
                }
                if (hierarchy.isAlwaysSubclassOfUnder(thrown, previous, scopeOwner, scopeConstraints)) {
                    this.reporter.report(overlappingThrowsMessage(previous, thrown, this.names), spans[i]);
                    overlaps = true;
                    break;
                }
                if (hierarchy.isAlwaysSubclassOfUnder(previous, thrown, scopeOwner, scopeConstraints)) {
                    this.reporter.report(overlappingThrowsMessage(thrown, previous, this.names),
                        acceptedSpans.get(a));
                    overlaps = true;
                    break;
                }
            }
            if (!overlaps) {
                accepted.push(thrown);
                acceptedSpans.push(spans[i]);
            }
        }
    }

    // ---- Signature leakage ----

    // A declaration's signature may not mention a type less visible than the declaration
    // itself; a caller who can name the declaration could otherwise be handed a type it
    // cannot name. Protected members are exempt: their guaranteed reach is the declaring
    // file, which can name everything the file can.
    checkVisibilityLeaks() {
        let functions = this.context.functions().all();
        for (long i = 0; i < functions.length(); i++) {
            let entry = functions.get(i);
            if (entry.isBuiltin() || entry.isExternal()) {
                continue;
            }
            this.checkCallableLeaks(entry.signature(), entry.visibility(),
                "Function '{entry.signature().name()}'", "'{entry.signature().name()}'");
        }
        for (long i = 0; i < this.structNodes.length(); i++) {
            let node = this.structNodes.get(i);
            let structType = this.structFor(node);
            if (structType == null) {
                continue;
            }
            string declPhrase = "Struct '{this.names.nameOf(structType)}'";
            this.checkBoundLeaks(structType.typeParameterTypes(), structType.visibility(),
                declPhrase, "'{this.names.nameOf(structType)}'", node.name().span(), null,
                structType);
            this.checkMemberLeaks("struct", structType, structType.fields(), 0,
                structType.methods(), fileReach());
            this.checkMemberLeaks("struct", structType, structType.staticFields(), 0,
                structType.staticMethods(), fileReach());
        }
        for (long i = 0; i < this.classNodes.length(); i++) {
            let node = this.classNodes.get(i);
            let classType = this.classFor(node);
            if (classType == null) {
                continue;
            }
            string declPhrase = "Class '{this.names.nameOf(classType)}'";
            this.checkClassBaseLeaks(classType, node, declPhrase);
            this.checkImplementedInterfaceLeaks(classType, node, declPhrase);
            this.checkBoundLeaks(classType.typeParameterTypes(), classType.visibility(),
                declPhrase, "'{this.names.nameOf(classType)}'", node.name().span(), null,
                classType);
            let reach = subclassReach(classType);
            this.checkMemberLeaks("class", classType, classType.fields(),
                classType.baseFieldCount(), classType.methods(), reach);
            this.checkMemberLeaks("class", classType, classType.staticFields(), 0,
                classType.staticMethods(), reach);
        }
        for (long i = 0; i < this.primitiveNodes.length(); i++) {
            let binding = this.bindingFor(this.primitiveNodes.get(i));
            if (binding == null) {
                continue;
            }
            // A binding is nameable everywhere the primitive is, so an exported member of one
            // is checked for the types it mentions exactly as an exported class member does.
            this.checkMemberLeaks("primitive", binding, binding.staticFields(), 0,
                binding.methods(), fileReach());
            this.checkMemberLeaks("primitive", binding, binding.staticFields(), 0,
                binding.staticMethods(), fileReach());
        }
        for (long i = 0; i < this.interfaceNodes.length(); i++) {
            let node = this.interfaceNodes.get(i);
            let interfaceType = this.interfaceFor(node);
            if (interfaceType == null) {
                continue;
            }
            string interfaceName = this.names.nameOf(interfaceType);
            string declPhrase = "Interface '{interfaceName}'";
            this.checkInterfaceBaseLeaks(interfaceType, node, declPhrase);
            this.checkBoundLeaks(interfaceType.typeParameterTypes(),
                interfaceType.visibility(), declPhrase, "'{interfaceName}'", node.name().span());
            let methods = interfaceType.methods();
            for (long m = 0; m < methods.length(); m++) {
                let method = methods.get(m);
                this.checkCallableLeaks(method.signature(), method.visibility(),
                    "Method '{method.name()}' of interface '{interfaceName}'", "'{interfaceName}'");
            }
        }
    }

    checkClassBaseLeaks(ClassType classType, ClassDeclarationNode node, string declPhrase) {
        if (types.visibilityTier(classType.visibility()) == 0) {
            return;
        }
        let base = classType.base();
        if (base == null) {
            return;
        }
        Span at = node.name().span();
        let extendsClause = node.extendsClause();
        if (extendsClause != null) {
            at = extendsClause.base().span();
        }
        string target = "'{this.names.nameOf(classType)}'";
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null && types.visibilityTier(baseAuthority.visibility())
                    < types.visibilityTier(classType.visibility())) {
            string needed = types.visibilityWord(classType.visibility());
            this.reporter.report("{declPhrase} is '{needed}', but its base class "
                + "'{this.names.nameOf(baseAuthority)}' is {notNameablePhrase(baseAuthority)}. Mark "
                + "'{this.names.nameOf(baseAuthority)}' '{needed}', or "
                + "{loweringFix(target, classType.visibility(), baseAuthority, classType)}.", at);
        }
        if (base is InstantiationType) {
            for (let argument in base.arguments()) {
                this.checkMentionedType(argument, classType.visibility(), declPhrase, target,
                    "base class type argument", at, null, classType);
            }
        }
    }

    checkInterfaceBaseLeaks(InterfaceType interfaceType, InterfaceDeclarationNode node, string declPhrase) {
        if (types.visibilityTier(interfaceType.visibility()) == 0) {
            return;
        }
        let base = interfaceType.base();
        if (base == null) {
            return;
        }
        Span at = node.name().span();
        let extendsClause = node.extendsClause();
        if (extendsClause != null) {
            at = extendsClause.base().span();
        }
        string target = "'{this.names.nameOf(interfaceType)}'";
        let baseAuthority = types.authorityOf(base);
        if (baseAuthority != null && types.visibilityTier(baseAuthority.visibility())
                    < types.visibilityTier(interfaceType.visibility())) {
            string needed = types.visibilityWord(interfaceType.visibility());
            this.reporter.report("{declPhrase} is '{needed}', but the interface it extends, "
                + "'{this.names.nameOf(baseAuthority)}', is {notNameablePhrase(baseAuthority)}. "
                + "Mark '{this.names.nameOf(baseAuthority)}' '{needed}', or "
                + "{loweringFix(target, interfaceType.visibility(), baseAuthority, null)}.", at);
        }
        if (base is InstantiationType) {
            for (let argument in base.arguments()) {
                this.checkMentionedType(argument, interfaceType.visibility(), declPhrase, target,
                    "extended interface type argument", at);
            }
        }
    }

    checkImplementedInterfaceLeaks(ClassType classType, ClassDeclarationNode node, string declPhrase) {
        if (types.visibilityTier(classType.visibility()) == 0) {
            return;
        }
        let implementsClause = node.implementsClause();
        if (implementsClause == null) {
            return;
        }
        for (long i = 0; i < implementsClause.interfacesCount(); i++) {
            let reference = implementsClause.interfaces(i);
            let resolved = this.context.result().typeOf(reference.green());
            if (resolved != null) {
                this.checkMentionedType(resolved, classType.visibility(), declPhrase,
                    "'{this.names.nameOf(classType)}'", "implemented interface", reference.span(),
                    null, classType);
            }
        }
    }

    // A protected member checks against its class's subclass reach instead of its own tier;
    // protectedOwner carries the class into the protected message shape.
    checkMemberLeaks(string ownerKindWord, DeclaredType ownerType, List<Field> fields,
                     long firstOwnField, List<Method> methods, SubclassReach reach) {
        string owner = "{ownerKindWord} '{this.names.nameOf(ownerType)}'";
        ProtectedOwner? reached = null;
        if (types.visibilityTier(reach.scope) > 0) {
            reached = new ProtectedOwner(ownerType, reach.wideners);
        }
        for (long i = firstOwnField; i < fields.length(); i++) {
            let field = fields.get(i);
            Visibility effective = field.visibility();
            ProtectedOwner? protectedOwner = null;
            if (effective == Visibility.Protected) {
                effective = reach.scope;
                protectedOwner = reached;
            }
            if (types.visibilityTier(effective) == 0) {
                continue;
            }
            this.checkMentionedType(field.type(), effective,
                "Field '{field.name()}' of {owner}", "'{field.name()}'", "type", field.nameSpan(),
                protectedOwner);
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            Visibility effective = method.visibility();
            ProtectedOwner? protectedOwner = null;
            if (effective == Visibility.Protected) {
                effective = reach.scope;
                protectedOwner = reached;
            }
            string memberWord = "Method '{method.name()}'";
            string target = "'{method.name()}'";
            if (method.isConstructor()) {
                memberWord = "Constructor";
                target = "the constructor";
            }
            this.checkCallableLeaks(method.signature(), effective,
                memberWord + " of " + owner, target, protectedOwner);
            for (let constraint in method.constraints()) {
                for (let bound in constraint.bounds()) {
                    this.checkMentionedType(bound, effective, memberWord + " of " + owner, target,
                        "type-parameter bound", method.signature().nameSpan(), protectedOwner);
                }
            }
        }
    }

    // 'target' names the declaration whose visibility mark a fix changes.
    checkCallableLeaks(Signature signature, Visibility declVisibility, string declPhrase,
                       string target, ProtectedOwner? protectedOwner = null) {
        if (types.visibilityTier(declVisibility) == 0) {
            return;
        }
        for (let parameter in signature.parameters()) {
            this.checkMentionedType(parameter.type(), declVisibility, declPhrase, target,
                "parameter type", parameter.span(), protectedOwner);
        }
        this.checkMentionedType(signature.returnType(), declVisibility, declPhrase, target,
            "return type", signature.nameSpan(), protectedOwner);
        Type[] thrown = signature.throwsTypes();
        Span[] thrownSpans = signature.throwsTypeSpans();
        for (long i = 0; i < thrown.length; i++) {
            this.checkMentionedType(thrown[i], declVisibility, declPhrase, target, "thrown type",
                thrownSpans[i], protectedOwner);
        }
        this.checkBoundLeaks(signature.typeParameters(), declVisibility, declPhrase, target,
            signature.nameSpan(), protectedOwner);
    }

    // 'lowered' is the type 'target' names, when it names a class or a struct.
    checkBoundLeaks(TypeParamType[] parameters, Visibility declVisibility, string declPhrase,
                    string target, Span at, ProtectedOwner? protectedOwner = null,
                    DeclaredType? lowered = null) {
        if (types.visibilityTier(declVisibility) == 0) {
            return;
        }
        for (let parameter in parameters) {
            for (let bound in parameter.bounds()) {
                this.checkMentionedType(bound, declVisibility, declPhrase, target,
                    "type-parameter bound", at, protectedOwner, lowered);
            }
        }
    }

    checkMentionedType(Type mentioned, Visibility declVisibility, string declPhrase,
                       string target, string role, Span at, ProtectedOwner? protectedOwner = null,
                       DeclaredType? lowered = null) {
        let worst = leastVisibleMention(mentioned);
        if (worst == null || types.visibilityTier(worst.visibility())
                >= types.visibilityTier(declVisibility)) {
            return;
        }
        string needed = types.visibilityWord(declVisibility);
        string worstName = this.names.nameOf(worst);
        string uses = "{mentionPhrase(role, mentioned, worst, worstName)} "
            + "{notNameablePhrase(worst)}";
        if (protectedOwner != null) {
            let ownerType = protectedOwner.owner;
            string ownerName = this.names.nameOf(ownerType);
            string subclass = "a subclass anywhere in the package";
            if (declVisibility == Visibility.Export) {
                subclass = "a subclass in another package";
            }
            string verb = "call";
            if (role == "type") {
                verb = "use";
            }
            if (protectedOwner.wideners.length() > 0) {
                this.reportSealedLeak(declPhrase, protectedOwner, declVisibility, verb, uses, worst, target,
                    at);
                return;
            }
            string closing = "";
            if (ownerType is ClassType && closable(ownerType)) {
                closing = " Or mark '{ownerName}' 'final'.";
            }
            this.reporter.report("{declPhrase} is protected, and '{ownerName}' is '{needed}', "
                + "so {subclass} can {verb} it, but {uses}. Mark '{worstName}' '{needed}'. Or "
                + "{loweringFix("'{ownerName}'", declVisibility, worst, ownerType)}.{closing}", at);
            return;
        }
        this.reporter.report("{declPhrase} is '{needed}', but {uses}. Mark '{worstName}' "
            + "'{needed}', or {loweringFix(target, declVisibility, worst, lowered)}.", at);
    }

    // The leak of a protected member of a sealed class, which mentions 'worst', through the open
    // descendants that let a class 'worst' is out of reach of extend the hierarchy, with a note at each.
    // 'scope' is the widest scope they give it, and 'target' names the member as the refusal does.
    reportSealedLeak(string declPhrase, ProtectedOwner protectedOwner, Visibility scope, string verb,
                     string uses, DeclaredType worst, string target, Span at) {
        let owner = protectedOwner.owner;
        string ownerName = this.names.nameOf(owner);
        long ownerTier = types.visibilityTier(owner.visibility());
        let wideners = new List<ClassType>();
        let named = new List<string>();
        let notes = new List<RelatedLocation>();
        bool direct = true;
        Visibility? shared = null;
        bool uniform = true;
        for (let widener in protectedOwner.wideners) {
            Visibility reach = widener.visibility();
            if (types.visibilityTier(reach) > ownerTier) {
                reach = owner.visibility();
            }
            if (types.visibilityTier(reach) <= types.visibilityTier(worst.visibility())) {
                continue;
            }
            uniform = uniform && (shared == null || shared == reach);
            shared = reach;
            wideners.push(widener);
            string widenerName = this.names.nameOf(widener);
            named.push("'{widenerName}'");
            let base = widener.base();
            if (base == null || types.authorityOf(base) != owner) {
                direct = false;
            }
            let declared = this.classDeclarationOf(widener);
            if (declared != null) {
                notes.push(this.reporter.noteAt(declared.name().span(), "'{widenerName}' is declared here."));
            }
        }
        string listed = diagnostics.andJoined(named.toArray());
        bool several = wideners.length() > 1;
        string relation = "its subclass";
        if (!direct) {
            relation = "its descendant";
        }
        if (several && direct) {
            relation = "its subclasses";
        } else if (several) {
            relation = "its descendants";
        }
        string verbForm = "is";
        string extended = listed;
        if (several) {
            verbForm = "are";
            extended = "them";
        }
        string marked = "";
        string where = "in another file";
        if (uniform && shared != null) {
            marked = "'{types.visibilityWord(shared)}' and ";
            where = "anywhere in the package";
            if (shared == Visibility.Export) {
                where = "in another package";
            }
        }
        string member = target;
        if (target == "the constructor") {
            member = "the constructor of '{ownerName}'";
        }
        string worstName = this.names.nameOf(worst);
        string message = "{declPhrase} is protected, and {uses}. '{ownerName}' is sealed, but "
            + "{relation} {listed} {verbForm} {marked}neither 'final' nor 'sealed', so a class {where} can "
            + "extend {extended} and {verb} {member}. Mark '{worstName}' '{types.visibilityWord(scope)}'.";
        if (allClosable(wideners)) {
            message = message + " Or mark {listed} 'final' or 'sealed'.";
        }
        if (notes.length() == 0) {
            this.reporter.report(message, at);
            return;
        }
        this.reporter.report(message, at, notes.toArray());
    }

    // The declaration of a class this module declares, or null for a class it does not.
    classDeclarationOf(ClassType classType) -> ClassDeclarationNode? {
        for (let node in this.classNodes) {
            if (node.green() == classType.declaration()) {
                return node;
            }
        }
        return null;
    }
}

// A class whose protected members a leak refusal names, and for a sealed class the open subclasses that
// let other files extend the hierarchy.
final class ProtectedOwner {
    DeclaredType owner;
    List<ClassType> wideners;

    constructor(this.owner, this.wideners);
}

// The widest scope a class can be subclassed from, which is the leakage floor of its protected
// members, and for a sealed class every open descendant that other files can extend.
final class SubclassReach {
    Visibility scope;
    List<ClassType> wideners;

    constructor(this.scope, this.wideners);
}

// The reach of a type no code outside its file can subclass.
fileReach() -> SubclassReach {
    return new SubclassReach(Visibility.Protected, new List<ClassType>());
}

// Whether marking 'declared' 'final' or 'sealed' refuses no class: nothing extends it, and as a class
// no other package can name, nothing outside this build can.
closable(ClassType declared) -> bool {
    return declared.visibility() != Visibility.Export && declared.directSubclasses().length() == 0;
}

// Whether every class of 'classes' is closable.
allClosable(List<ClassType> classes) -> bool {
    for (let declared in classes) {
        if (!closable(declared)) {
            return false;
        }
    }
    return true;
}

// Why a struct member marked 'override' replaces and implements nothing. A 'toString' that takes
// parameters gets the reason its own name is not enough, since that name is otherwise one of the three
// a struct does replace. A struct that declares conformances gets a note that they were searched too.
nothingToOverrideMessage(StructType structType, Method declared, TypeNames names) -> string {
    string textForm = "a 'toString' that takes parameters is an ordinary method rather than the "
        + "struct's text form";
    bool claimsTextForm = declared.name() == "toString" && declared.signature().parameters().length > 0;
    if (structType.interfaces().length == 0) {
        string replaceable = "only 'toString', 'hash', and 'equals' replace a built-in behavior "
            + "of a struct";
        if (claimsTextForm) {
            replaceable = textForm;
        }
        return "Method '{declared.name()}' of '{names.nameOf(structType)}' is marked 'override', and a "
            + "struct inherits nothing to override; {replaceable}. Remove 'override'.";
    }
    string why = "";
    if (claimsTextForm) {
        why = "; {textForm}";
    }
    return "Method '{declared.name()}' of '{names.nameOf(structType)}' is marked 'override' but no "
        + "interface '{names.nameOf(structType)}' implements declares '{declared.name()}', and a struct "
        + "inherits nothing{why}. Remove 'override'.";
}

// The refusal of a 'throws' list that names a type beside a subclass of it.
overlappingThrowsMessage(Type wider, Type narrower, TypeNames names) -> string {
    string widerName = names.of(wider);
    string narrowerName = names.of(narrower);
    string relation = "'{narrowerName}' is a subclass of '{widerName}'";
    if (narrower is TypeParamType) {
        relation = "'{narrowerName}' can only be '{widerName}' or a subclass of it";
    }
    return "The 'throws' list names both '{widerName}' and '{narrowerName}'. {relation}, so "
        + "'{widerName}' alone covers both. Remove '{narrowerName}'.";
}

// Whether the class declaration has a constructor in its body.
declaresConstructor(ClassDeclarationNode node) -> bool {
    let body = node.body();
    for (long i = 0; i < body.membersCount(); i++) {
        let member = body.members(i);
        if (member is FunctionDeclarationNode) {
            let introducer = member.introducer();
            if (introducer != null && introducer.kind() == SyntaxKind.ConstructorKeyword) {
                return true;
            }
        }
    }
    return false;
}

// The widest scope from which a class can be subclassed: its file for a 'final' class, its own
// visibility for an open one, and for a sealed class the widest reach of its direct subclasses, which
// its own module declares, within its own visibility. A sealed class also lists the open descendants
// that other files can extend.
subclassReach(ClassType classType) -> SubclassReach {
    if (classType.isFinal()) {
        return fileReach();
    }
    if (!classType.isSealed()) {
        return new SubclassReach(classType.visibility(), new List<ClassType>());
    }
    Visibility widest = Visibility.Protected;
    let wideners = new List<ClassType>();
    long ceiling = types.visibilityTier(classType.visibility());
    for (let subclass in classType.directSubclasses()) {
        let reach = subclassReach(subclass);
        Visibility scope = reach.scope;
        if (types.visibilityTier(scope) > ceiling) {
            scope = classType.visibility();
        }
        if (types.visibilityTier(scope) > types.visibilityTier(widest)) {
            widest = scope;
        }
        if (!subclass.isSealed() && types.visibilityTier(reach.scope) > 0) {
            wideners.push(subclass);
        }
        for (let widener in reach.wideners) {
            wideners.push(widener);
        }
    }
    return new SubclassReach(widest, wideners);
}

// The least-visible declared type mentioned anywhere inside the type: arrays and optionals look
// through to their element, a function type covers its parameter and return types, an instantiation
// covers its template and every type argument, and type parameters mention nothing themselves.
leastVisibleMention(Type type) -> DeclaredType? {
    switch (type) {
        is OptionalType optional -> {
            return leastVisibleMention(optional.inner());
        },
        is ArrayType array -> {
            return leastVisibleMention(array.element());
        },
        is FunctionType functionType -> {
            DeclaredType? worst = leastVisibleMention(functionType.returnType());
            for (let parameter in functionType.parameterTypes()) {
                worst = lessVisibleOf(worst, leastVisibleMention(parameter));
            }
            return worst;
        },
        is InstantiationType instantiation -> {
            DeclaredType? worst = instantiation.template();
            for (let argument in instantiation.arguments()) {
                worst = lessVisibleOf(worst, leastVisibleMention(argument));
            }
            return worst;
        },
        is DeclaredType declared -> {
            return declared;
        },
        default -> {
            return null;
        },
    }
}

lessVisibleOf(DeclaredType? left, DeclaredType? right) -> DeclaredType? {
    if (left == null) {
        return right;
    }
    if (right == null) {
        return left;
    }
    if (types.visibilityTier(right.visibility()) < types.visibilityTier(left.visibility())) {
        return right;
    }
    return left;
}

// The fix that lowers a declaration to the visibility of the type it uses: remove its mark when
// that type is private, else mark it 'public'. When the declaration is the class or struct
// 'lowered', its members marked above the new visibility are lowered with it.
loweringFix(string target, Visibility declared, DeclaredType worst, DeclaredType? lowered) -> string {
    string word = types.visibilityWord(declared);
    if (worst.visibility() == Visibility.Private) {
        string fix = "remove '{word}' from "
            + markedPhrase(target, markedMembers(lowered, declared), word);
        if (declared == Visibility.Export) {
            let marked = markedMembers(lowered, Visibility.Public);
            if (marked.length() > 0) {
                fix = "{fix}, and 'public' from {markedPhrase("", marked, "public")}";
            }
        }
        return fix;
    }
    return "mark {markedPhrase(target, markedMembers(lowered, declared), word)} 'public'";
}

// The target and the members that lower with it, as a fix names them: every one of up to three,
// or "its 'export' members" for more. An empty target names the members alone.
markedPhrase(string target, List<string> members, string word) -> string {
    if (members.length() == 0) {
        return target;
    }
    if (members.length() > 3) {
        if (target.length == 0) {
            return "its '{word}' members";
        }
        return "{target} and its '{word}' members";
    }
    let named = new List<string>();
    if (target.length > 0) {
        named.push(target);
    }
    for (let member in members) {
        named.push(member);
    }
    return diagnostics.andJoined(named.toArray());
}

// The members the type declares itself with exactly this visibility, as a fix names them: "its
// constructor" (or "its constructors"), then the fields and methods by name.
markedMembers(DeclaredType? owner, Visibility visibility) -> List<string> {
    let found = new List<string>();
    if (owner == null || owner is InterfaceType) {
        return found;
    }
    long constructors = 0;
    let named = new List<string>();
    for (let fields in [typemembers.fieldsOf(owner), typemembers.staticFieldsOf(owner)]) {
        if (fields != null) {
            for (let field in fields) {
                if (field.definingType() == owner && field.visibility() == visibility) {
                    named.push("'{field.name()}'");
                }
            }
        }
    }
    for (let methods in [typemembers.methodsOf(owner), typemembers.staticMethodsOf(owner)]) {
        if (methods != null) {
            for (let method in methods) {
                if (method.definingType() != owner || method.visibility() != visibility) {
                    continue;
                }
                if (method.isConstructor()) {
                    constructors++;
                } else {
                    named.push("'{method.name()}'");
                }
            }
        }
    }
    if (constructors == 1) {
        found.push("its constructor");
    } else if (constructors > 1) {
        found.push("its constructors");
    }
    for (let name in named) {
        found.push(name);
    }
    return found;
}

// How a leak refusal names the less visible type it found, up to the phrase that says how far that
// type can be used: "its parameter type uses 'Hidden', which is".
mentionPhrase(string role, Type mentioned, DeclaredType worst, string worstName) -> string {
    if (role == "implemented interface") {
        if (types.authorityOf(mentioned) == worst) {
            return "the interface it implements, '{worstName}', is";
        }
        return "'{worstName}', a type argument of the interface it implements, is";
    }
    if (role == "extended interface type argument") {
        return "'{worstName}', a type argument of the interface it extends, is";
    }
    if (role == "base class type argument") {
        return "'{worstName}', a type argument of its base class, is";
    }
    return "its {role} uses '{worstName}', which is";
}

notNameablePhrase(DeclaredType worst) -> string {
    if (worst.visibility() == Visibility.Private) {
        return "private to module '{worst.modulePath()}'";
    }
    string packageName = "its own package";
    if (worst.packagePrefix().length > 0) {
        packageName = "package '{worst.packagePrefix()}'";
    }
    return "only public inside {packageName}";
}

// The struct a field stores inline: a plain struct, or an instantiation of a generic struct
// with its own substituted fields.
byValueStruct(Type fieldType) -> Type? {
    Type core = fieldType;
    while (core is OptionalType) {
        core = core.inner();
    }
    if (core is StructType) {
        return core;
    }
    if (core is InstantiationType && core.template() is StructType) {
        return core;
    }
    return null;
}

// Depth-first search for a by-value field path from origin back to itself. An instantiation
// counts as its template, so 'Wrap<T>' inside 'struct Wrap<T>' closes the cycle. explored
// bounds the walk on graphs with shared members.
findPathBackTo(StructType origin, Type current, List<CycleStep> path, Set<Type> explored) -> bool {
    let fields = typemembers.fieldsOf(current);
    if (fields == null) {
        return false;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let next = byValueStruct(field.type());
        if (next == null) {
            continue;
        }
        path.push(new CycleStep(current, field));
        if (types.authorityOf(next) == origin) {
            return true;
        }
        if (explored.add(next) && findPathBackTo(origin, next, path, explored)) {
            return true;
        }
        path.pop();
    }
    return false;
}

firstIndexOf(List<string> names, string name) -> long {
    for (long i = 0; i < names.length(); i++) {
        if (names.get(i) == name) {
            return i;
        }
    }
    return -1;
}

// Every bare identifier expression under the node, with its content span.
collectIdentifiers(GreenNode node, long fullStart, List<FoundIdentifier> out) {
    if (node.kind() == SyntaxKind.IdentifierExpression && node.slotCount() > 0) {
        let token = node.slot(0);
        if (token is GreenToken) {
            out.push(new FoundIdentifier(token.text(),
                source.makeSpan(fullStart + token.leadingLength(), token.contentLength())));
        }
        return;
    }
    long offset = fullStart;
    for (long i = 0; i < node.slotCount(); i++) {
        let child = node.slot(i);
        if (child != null) {
            if (child is GreenNode) {
                collectIdentifiers(child, offset, out);
            }
            offset = offset + child.fullLength();
        }
    }
}
