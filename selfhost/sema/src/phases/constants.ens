// Evaluation of static const initializers, program-wide. It is demand-driven with an in-progress
// mark, so a chain of references evaluates in dependency order whatever the module order, and a
// cycle is reported at the reference that closes it. The values land on the Field objects.
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import BinaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import GenericNameExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import NewExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArrayLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import StructLiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import InterpolatedStringExpressionNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import SyntaxNode from @ens.frontend.syntax.node;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import ModuleContext from context;
import ImportedType from phases.link;
import ImportedNamespace from phases.link;
import phases.members;
import model.hierarchy;
import model.literalvalues;
import ConstantValue from model.literalvalues;
import ConstantKind from model.literalvalues;
import model.typemembers;
import Field from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import StringType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import DeclaredType from model.types;
import EnumType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

public evaluateProgram(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    let evaluator = new ConstantEvaluator(collected);
    for (long i = 0; i < contexts.length(); i++) {
        evaluator.gather(contexts.get(i));
    }
    evaluator.evaluateAll();
    return diagnostics.sorted(collected);
}

// One static const with an initializer to evaluate, in the module that declares it.
class ConstantItem {
    protected static const long pending = 0;
    protected static const long evaluating = 1;
    protected static const long finished = 2;

    protected Field field;
    protected Expression initializer;
    protected ModuleContext context;
    protected DeclaredType owner;
    protected long state;

    protected constructor(this.field, this.initializer, this.context, this.owner) {
        this.state = ConstantItem.pending;
    }
}

class ConstantEvaluator {
    List<FileDiagnostic> collected;
    List<ConstantItem> items;
    Map<Field, ConstantItem> itemsByField;

    protected constructor(List<FileDiagnostic> collected) {
        this.collected = collected;
        this.items = new List<ConstantItem>();
        this.itemsByField = new Map<Field, ConstantItem>();
    }

    protected gather(ModuleContext context) {
        let root = context.root();
        if (root == null) {
            return;
        }
        let store = context.resolver().typeStore();
        string modulePath = context.module().canonicalPath();
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is StructDeclarationNode declaration -> {
                    let found = store.findDeclared(modulePath, declaration.name().text());
                    if (found != null && found.declaration() == declaration.green()) {
                        this.gatherMembers(context, found, declaration.body());
                    }
                },
                is ClassDeclarationNode declaration -> {
                    let found = store.findDeclared(modulePath, declaration.name().text());
                    if (found != null && found.declaration() == declaration.green()) {
                        this.gatherMembers(context, found, declaration.body());
                    }
                },
                default -> { },
            }
        }
    }

    gatherMembers(ModuleContext context, DeclaredType owner, MemberListNode body) {
        for (long i = 0; i < body.membersCount(); i++) {
            let member = body.members(i);
            if (!(member is FieldDeclarationNode)) {
                continue;
            }
            let modifiers = members.fieldModifiers(member);
            if (!modifiers.declaresStatic && !modifiers.declaresLazy) {
                continue;
            }
            let field = members.findField(typemembers.staticFieldsOf(owner), member.name().text());
            if (field == null || field.nameSpan() != member.name().span()) {
                continue;
            }
            let initializer = member.defaultValue();
            if (initializer == null) {
                continue;
            }
            let item = new ConstantItem(field, initializer.value(), context, owner);
            this.items.push(item);
            this.itemsByField.set(field, item);
        }
    }

    protected evaluateAll() {
        for (long i = 0; i < this.items.length(); i++) {
            let item = this.items.get(i);
            if (item.field.isLazy()) {
                this.walkLazyItem(item);
            } else {
                this.evaluateItem(item);
            }
        }
    }

    evaluateItem(ConstantItem item) {
        if (item.state != ConstantItem.pending) {
            return;
        }
        item.state = ConstantItem.evaluating;
        let value = this.evaluate(item, item.initializer);
        if (value != null) {
            let fitted = this.fitDeclaredType(item, value);
            if (fitted != null) {
                item.field.setConstantValue(fitted);
            }
        }
        item.state = ConstantItem.finished;
    }

    // A lazy const builds its value at run time, so nothing here evaluates one. What this phase
    // does judge is a cycle its initializers close between themselves, which no read can break.
    walkLazyItem(ConstantItem item) {
        if (item.state != ConstantItem.pending) {
            return;
        }
        item.state = ConstantItem.evaluating;
        this.walkLazyReferences(item, item.initializer);
        item.state = ConstantItem.finished;
    }

    // Every read the initializer performs on its way to a value. A lambda's body is left out
    // because it runs when something calls it, not while the value is being built.
    walkLazyReferences(ConstantItem item, SyntaxNode node) {
        if (node is LambdaExpressionNode) {
            return;
        }
        if (node is MemberExpressionNode) {
            this.followLazyReference(item, node);
        }
        let children = node.childNodes();
        for (long i = 0; i < children.length(); i++) {
            this.walkLazyReferences(item, children.get(i));
        }
    }

    followLazyReference(ConstantItem item, MemberExpressionNode member) {
        let object = member.object();
        if (!(object is IdentifierExpressionNode)) {
            return;
        }
        let named = this.resolveTypeName(item, object.name().text());
        if (named == null) {
            return;
        }
        string memberName = member.member().text();
        let field = members.findField(typemembers.staticFieldsOf(named), memberName);
        if (field == null || !field.isLazy()) {
            return;
        }
        let target = this.itemsByField.get(field);
        if (target == null) {
            return;
        }
        if (target.state == ConstantItem.evaluating) {
            string read = this.memberPath(item, named, memberName);
            this.report(item, "'{this.itemName(item)}' cannot take its value from '{read}': "
                + "the lazy consts between them form a cycle. Build one of the two without "
                + "reading the other.", member.span());
            return;
        }
        this.walkLazyItem(target);
    }

    // The names the file declaring this constant has for the program's types.
    namesOf(ConstantItem item) -> TypeNames {
        return item.context.names();
    }

    // 'Path.separator', the constant this item declares, named as its own file names the type.
    itemName(ConstantItem item) -> string {
        return "{this.ownerName(item)}.{item.field.name()}";
    }

    // The type declaring this constant, named as its own file names it.
    ownerName(ConstantItem item) -> string {
        return this.namesOf(item).nameOf(item.owner);
    }

    // 'Path.separator', a static const this initializer reads through another type.
    memberPath(ConstantItem item, DeclaredType named, string memberName) -> string {
        return "{this.namesOf(item).nameOf(named)}.{memberName}";
    }

    report(ConstantItem item, string message, Span span) {
        this.collected.push(new FileDiagnostic(item.context.module().filePath(), message, span));
    }

    // The standard refusal: what the initializer did, then what a constant may be built from,
    // or the given fix instead of that last sentence.
    reportNotConstant(ConstantItem item, Span span, string what, string fix = "") {
        string closing = "A constant is built from literals, '+', '-', '*', '/', '%', string "
            + "concatenation and other static consts read through their type name.";
        if (fix.length > 0) {
            closing = fix;
        }
        this.report(item, "The initializer of static const '{this.itemName(item)}' must "
            + "be a compile-time constant, but {what}. {closing}", span);
    }

    evaluate(ConstantItem item, Expression node) -> ConstantValue? {
        switch (node) {
            is LiteralExpressionNode literal -> {
                return this.evaluateLiteral(item, literal);
            },
            is ParenthesizedExpressionNode parenthesized -> {
                return this.evaluate(item, parenthesized.inner());
            },
            is PrefixExpressionNode prefix -> {
                return this.evaluatePrefix(item, prefix);
            },
            is BinaryExpressionNode binary -> {
                return this.evaluateBinary(item, binary);
            },
            is MemberExpressionNode member -> {
                return this.evaluateReference(item, member);
            },
            is IdentifierExpressionNode identifier -> {
                this.evaluateIdentifier(item, identifier);
                return null;
            },
            is CallExpressionNode ignored -> {
                this.reportNotConstant(item, node.span(), "it calls a function, which only "
                    + "runs at run time");
                return null;
            },
            is NewExpressionNode ignored -> {
                this.reportNotConstant(item, node.span(), "it creates an object with 'new', "
                    + "which only happens at run time");
                return null;
            },
            is ArrayLiteralExpressionNode ignored -> {
                this.reportNotConstant(item, node.span(), "it builds an array, and a static "
                    + "const can only have a number type, 'char', 'bool' or 'string'");
                return null;
            },
            is StructLiteralExpressionNode ignored -> {
                this.reportNotConstant(item, node.span(), "it builds a struct, and a static "
                    + "const can only have a number type, 'char', 'bool' or 'string'");
                return null;
            },
            is InterpolatedStringExpressionNode ignored -> {
                this.reportNotConstant(item, node.span(), "it uses string interpolation, which "
                    + "builds its text at run time", "Join the pieces with '+' instead.");
                return null;
            },
            default -> {
                this.reportNotConstant(item, node.span(),
                    "this expression is only computed at run time");
                return null;
            },
        }
    }

    evaluateLiteral(ConstantItem item, LiteralExpressionNode literal) -> ConstantValue? {
        let token = literal.value();
        switch (token.kind()) {
            IntLiteral, LongLiteral -> {
                let magnitude = literalvalues.integerMagnitude(token.text());
                if (magnitude == null) {
                    this.report(item, "Integer literal '{token.text()}' is too large for any "
                        + "integer type. The largest, 'ulong', goes up to "
                        + "{Integers.ceiling}.", literal.span());
                    return null;
                }
                return literalvalues.integerConstant(false, magnitude);
            },
            FloatLiteral, DoubleLiteral -> {
                return literalvalues.floatConstant(false,
                    literalvalues.floatMagnitude(token.text()));
            },
            StringLiteral -> {
                return literalvalues.stringConstant(literalvalues.decodeString(token.text()));
            },
            CharLiteral -> {
                return literalvalues.charConstant(literalvalues.charCodepoint(token.text()));
            },
            TrueKeyword -> {
                return literalvalues.boolConstant(true);
            },
            FalseKeyword -> {
                return literalvalues.boolConstant(false);
            },
            NullKeyword -> {
                this.reportNotConstant(item, literal.span(), "a static const has a number type, "
                    + "'char', 'bool' or 'string', and none of those can be null");
                return null;
            },
            default -> {
                this.reportNotConstant(item, literal.span(),
                    "this expression is only computed at run time");
                return null;
            },
        }
    }

    evaluatePrefix(ConstantItem item, PrefixExpressionNode prefix) -> ConstantValue? {
        SyntaxKind operator = prefix.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            this.reportNotConstant(item, prefix.span(), "'{prefix.operator().text()}' is not "
                + "part of a constant expression");
            return null;
        }
        let operand = this.evaluate(item, prefix.operand());
        if (operand == null) {
            return null;
        }
        if (operand.kind() == ConstantKind.Integer) {
            if (operator == SyntaxKind.Minus) {
                return literalvalues.integerConstant(!operand.isNegative(),
                    operand.magnitude());
            }
            return operand;
        }
        if (operand.kind() == ConstantKind.Float) {
            if (operator == SyntaxKind.Minus) {
                return literalvalues.floatConstant(true, operand.floatValue());
            }
            return operand;
        }
        this.report(item, "'{prefix.operator().text()}' in a constant expression applies to a "
            + "number, not to {constantKindText(operand)}.", prefix.span());
        return null;
    }

    evaluateBinary(ConstantItem item, BinaryExpressionNode binary) -> ConstantValue? {
        SyntaxKind operator = binary.operator().kind();
        if (!isConstantOperator(operator)) {
            this.reportNotConstant(item, binary.span(), "'{binary.operator().text()}' is not "
                + "part of a constant expression");
            return null;
        }
        let left = this.evaluate(item, binary.left());
        let right = this.evaluate(item, binary.right());
        if (left == null || right == null) {
            return null;
        }
        if (left.kind() == ConstantKind.String || right.kind() == ConstantKind.String) {
            if (operator != SyntaxKind.Plus || left.kind() != right.kind()) {
                string works = "works on two numbers";
                if (operator == SyntaxKind.Plus) {
                    works = "works on two numbers or two strings";
                }
                this.report(item, "'{binary.operator().text()}' in a constant expression "
                    + "{works}, but this one is used on {constantKindText(left)} and "
                    + "{constantKindText(right)}.", binary.span());
                return null;
            }
            return literalvalues.stringConstant(left.text() + right.text());
        }
        if (left.kind() == ConstantKind.Bool || right.kind() == ConstantKind.Bool) {
            this.report(item, "'{binary.operator().text()}' in a constant expression combines "
                + "numbers or strings, and a 'bool' is neither.", binary.span());
            return null;
        }
        if (left.kind() == ConstantKind.Float || right.kind() == ConstantKind.Float) {
            if (operator == SyntaxKind.Percent) {
                this.report(item, "'%' in a constant expression works on integers only, and this "
                    + "one is used on {fractionalOperands(left, right)}.", binary.span());
                return null;
            }
            return this.combineFloats(item, binary, operator, asFloat(left), asFloat(right));
        }
        return this.combineIntegers(item, binary, operator, left, right);
    }

    // Combines two numbers of which one is fractional, for every operator but '%'.
    combineFloats(ConstantItem item, BinaryExpressionNode binary, SyntaxKind operator,
                  double left, double right) -> ConstantValue? {
        switch (operator) {
            Plus -> {
                return literalvalues.floatConstant(false, left + right);
            },
            Minus -> {
                return literalvalues.floatConstant(false, left - right);
            },
            Star -> {
                return literalvalues.floatConstant(false, left * right);
            },
            Slash -> {
                if (right == 0.0) {
                    this.report(item, "The initializer of static const "
                        + "'{this.itemName(item)}' divides by zero.", binary.span());
                    return null;
                }
                return literalvalues.floatConstant(false, left / right);
            },
            default -> {
                this.report(item, "Internal: the fractional constant arithmetic was given '%'.",
                    binary.span());
                return null;
            },
        }
    }

    combineIntegers(ConstantItem item, BinaryExpressionNode binary, SyntaxKind operator,
                    ConstantValue left, ConstantValue right) -> ConstantValue? {
        bool leftNegative = left.isNegative();
        ulong leftMagnitude = left.magnitude();
        bool rightNegative = right.isNegative();
        ulong rightMagnitude = right.magnitude();
        switch (operator) {
            Plus -> {
                return this.addSigned(item, binary, leftNegative, leftMagnitude, rightNegative,
                    rightMagnitude);
            },
            Minus -> {
                return this.addSigned(item, binary, leftNegative, leftMagnitude,
                    !rightNegative && rightMagnitude != 0, rightMagnitude);
            },
            Star -> {
                if (leftMagnitude != 0 && rightMagnitude > Integers.ceiling / leftMagnitude) {
                    this.reportOverflow(item, binary);
                    return null;
                }
                return literalvalues.integerConstant(leftNegative != rightNegative,
                    leftMagnitude * rightMagnitude);
            },
            Slash -> {
                if (rightMagnitude == 0) {
                    this.report(item, "The initializer of static const "
                        + "'{this.itemName(item)}' divides by zero.", binary.span());
                    return null;
                }
                return literalvalues.integerConstant(leftNegative != rightNegative,
                    leftMagnitude / rightMagnitude);
            },
            default -> {
                if (rightMagnitude == 0) {
                    this.report(item, "The initializer of static const "
                        + "'{this.itemName(item)}' divides by zero.", binary.span());
                    return null;
                }
                return literalvalues.integerConstant(leftNegative,
                    leftMagnitude % rightMagnitude);
            },
        }
    }

    // Signed addition in sign-and-magnitude form: equal signs add the magnitudes, opposite
    // signs subtract the smaller from the larger and keep the larger's sign. The subtraction
    // above passes the right operand's sign flipped ('a - b' is 'a + (-b)'), normalizing a
    // zero so it stays positive.
    addSigned(ConstantItem item, BinaryExpressionNode binary, bool leftNegative,
              ulong leftMagnitude, bool rightNegative, ulong rightMagnitude) -> ConstantValue? {
        if (leftNegative == rightNegative || rightMagnitude == 0) {
            if (leftMagnitude > Integers.ceiling - rightMagnitude) {
                this.reportOverflow(item, binary);
                return null;
            }
            return literalvalues.integerConstant(leftNegative,
                leftMagnitude + rightMagnitude);
        }
        if (leftMagnitude >= rightMagnitude) {
            return literalvalues.integerConstant(leftNegative,
                leftMagnitude - rightMagnitude);
        }
        return literalvalues.integerConstant(rightNegative, rightMagnitude - leftMagnitude);
    }

    reportOverflow(ConstantItem item, BinaryExpressionNode binary) {
        this.report(item, "The initializer of static const '{this.itemName(item)}' computes a "
            + "number outside the range of every integer type.", binary.span());
    }

    // A read of another static const, written through its type name: 'Path.separator'.
    evaluateReference(ConstantItem item, MemberExpressionNode member) -> ConstantValue? {
        string memberName = member.member().text();
        let object = member.object();
        DeclaredType? named = null;
        switch (object) {
            is IdentifierExpressionNode identifier -> {
                named = this.resolveTypeName(item, identifier.name().text());
                if (named == null) {
                    this.reportUnknownHead(item, identifier.name().text(), memberName, member.span());
                    return null;
                }
            },
            is GenericNameExpressionNode generic -> {
                let head = generic.head();
                string headName = "";
                if (head is IdentifierExpressionNode) {
                    headName = head.name().text();
                    named = this.resolveTypeName(item, headName);
                }
                if (named == null) {
                    this.reportUnknownHead(item, headName, memberName, member.span());
                    return null;
                }
                if (members.findField(typemembers.staticFieldsOf(named), memberName) == null) {
                    this.reportMissingStaticConst(item, member, named);
                    return null;
                }
                this.report(item, "A static const never depends on type arguments. Read it "
                    + "through the plain type name, as "
                    + "'{this.memberPath(item, named, memberName)}'.",
                    generic.typeArguments().span());
                return null;
            },
            default -> {
                this.reportQualifiedHead(item, member, memberName);
                return null;
            },
        }
        let field = members.findField(typemembers.staticFieldsOf(named), memberName);
        if (field == null) {
            this.reportMissingStaticConst(item, member, named);
            return null;
        }
        if (field.isLazy()) {
            this.reportNotConstant(item, member.span(),
                "'{this.memberPath(item, named, memberName)}' is a "
                + "lazy const, whose value is built on its first read at run time");
            return null;
        }
        if (!this.referenceVisible(item, field, member.member().span())) {
            return null;
        }
        let target = this.itemsByField.get(field);
        if (target == null) {
            return null;
        }
        if (target.state == ConstantItem.evaluating) {
            this.report(item, "'{this.itemName(item)}' cannot take its value from "
                + "'{this.memberPath(item, named, memberName)}': the static consts between "
                + "them form a cycle. Give one of them a literal value.", member.span());
            return null;
        }
        this.evaluateItem(target);
        return field.constantValue();
    }

    // The member names no static const of 'named': a base class's static is refused as written
    // through a subclass, and any other name as no static const.
    reportMissingStaticConst(ConstantItem item, MemberExpressionNode member, DeclaredType named) {
        string memberName = member.member().text();
        let inherited = this.baseStaticField(named, memberName);
        if (inherited != null) {
            this.reportBaseStatic(item, member, inherited);
            return;
        }
        this.reportNotConstant(item, member.span(),
            "'{this.memberPath(item, named, memberName)}' is not a static const");
    }

    // The static field a base class of 'named' declares under this name, or null when none does.
    baseStaticField(DeclaredType named, string memberName) -> Field? {
        Type? current = hierarchy.baseOf(named);
        while (current != null) {
            let field = members.findField(typemembers.staticFieldsOf(current), memberName);
            if (field != null) {
                return field;
            }
            current = hierarchy.baseOf(current);
        }
        return null;
    }

    // A base class's static written through a subclass. A lazy const gets the lazy refusal instead,
    // because it is no constant through any type name.
    reportBaseStatic(ConstantItem item, MemberExpressionNode member, Field inherited) {
        string memberName = member.member().text();
        let names = this.namesOf(item);
        let declaring = types.authorityOf(inherited.definingType());
        if (declaring == null) {
            return;
        }
        string followUp = typenames.staticNotInheritedFollowUp(memberName, declaring, declaring, names);
        if (!this.referenceVisible(item, inherited, member.member().span(), followUp)) {
            return;
        }
        if (inherited.isLazy()) {
            this.reportNotConstant(item, member.span(), "'{names.nameOf(declaring)}.{memberName}' is a "
                + "lazy const, whose value is built on its first read at run time");
            return;
        }
        this.report(item, typenames.staticNotInheritedMessage(memberName, declaring, declaring, names),
            member.member().span());
    }

    // The class or struct an initializer's type-name head resolves to: the file's imported
    // names, then the module's own declarations, matching how a body resolves the same head.
    resolveTypeName(ConstantItem item, string name) -> DeclaredType? {
        let declared = this.resolveDeclared(item, name);
        if (declared == null) {
            return null;
        }
        return this.asStaticOwner(declared);
    }

    // The declared type a head names, whether or not it can carry statics.
    resolveDeclared(ConstantItem item, string name) -> DeclaredType? {
        if (name.length == 0) {
            return null;
        }
        let imported = item.context.linkTable().binding(name);
        if (imported is ImportedType) {
            return imported.target();
        }
        if (imported is ImportedNamespace) {
            return null;
        }
        let store = item.context.resolver().typeStore();
        return store.findDeclared(item.context.module().canonicalPath(), name);
    }

    asStaticOwner(DeclaredType declared) -> DeclaredType? {
        if (typemembers.staticFieldsOf(declared) == null) {
            return null;
        }
        return declared;
    }

    // A head that names no class or struct: a type parameter, a type that declares no statics, or
    // nothing this file can name.
    reportUnknownHead(ConstantItem item, string headName, string memberName, Span span) {
        if (this.namesOwnerTypeParameter(item, headName)) {
            this.reportNotConstant(item, span, typeParameterClause(headName, this.ownerName(item)));
            return;
        }
        let declared = this.resolveDeclared(item, headName);
        if (declared is EnumType) {
            string enumName = this.namesOf(item).nameOf(declared);
            bool known = false;
            for (let each in declared.memberNames()) {
                if (each == memberName) {
                    known = true;
                }
            }
            if (!known) {
                this.reportNotConstant(item, span, "'{memberName}' is not a member of enum '{enumName}'");
                return;
            }
            this.reportNotConstant(item, span, "'{enumName}.{memberName}' is a member of enum '{enumName}', "
                + "and a static const can only have a number type, 'char', 'bool' or 'string'");
            return;
        }
        if (declared != null) {
            this.report(item, typenames.noStaticMembersMessage(declared, memberName, this.namesOf(item)),
                span);
            return;
        }
        this.reportNotConstant(item, span, "'{headName}' is not a class or struct this file "
            + "can name");
    }

    // Whether the type declaring this constant introduced a type parameter of this name,
    // which takes the name for the whole of the declaration.
    namesOwnerTypeParameter(ConstantItem item, string name) -> bool {
        if (!item.owner.isGeneric()) {
            return false;
        }
        for (let parameter in item.owner.typeParameterTypes()) {
            if (parameter.name() == name) {
                return true;
            }
        }
        return false;
    }

    reportQualifiedHead(ConstantItem item, MemberExpressionNode member, string memberName) {
        let object = member.object();
        if (object is MemberExpressionNode) {
            let inner = object.object();
            if (inner is IdentifierExpressionNode) {
                let binding = item.context.linkTable().binding(inner.name().text());
                if (binding is ImportedNamespace) {
                    string typeName = object.member().text();
                    this.reportNotConstant(item, member.span(), "it reads "
                        + "'{typeName}.{memberName}' through the module name "
                        + "'{inner.name().text()}'",
                        this.importFix(item, binding.modulePath(), typeName, memberName));
                    return;
                }
            }
        }
        this.reportNotConstant(item, member.span(),
            "it reads a member of a value, which only exists at run time");
    }

    // The fix for a static const read through a module name: the name this file already has for
    // the type, or the import that gives it one.
    importFix(ConstantItem item, string modulePath, string typeName, string memberName) -> string {
        let declared = item.context.resolver().typeStore().findDeclared(modulePath, typeName);
        if (declared == null) {
            return "Module '{modulePath}' has no type named '{typeName}'. Check the spelling, or "
                + "import '{typeName}' from the module that declares it.";
        }
        return typenames.qualifiedMemberFix(declared, memberName, this.namesOf(item));
    }

    evaluateIdentifier(ConstantItem item, IdentifierExpressionNode identifier) {
        string name = identifier.name().text();
        let sibling = members.findField(typemembers.staticFieldsOf(item.owner), name);
        if (sibling != null) {
            string owner = this.ownerName(item);
            this.report(item, "'{name}' is a static const of '{owner}', and a static const is "
                + "always read through its type name, even inside '{owner}'. Write "
                + "'{owner}.{name}'.", identifier.span());
            return;
        }
        if (this.namesOwnerTypeParameter(item, name)) {
            this.reportNotConstant(item, identifier.span(),
                typeParameterClause(name, this.ownerName(item)));
            return;
        }
        this.reportNotConstant(item, identifier.span(), "'{name}' is not a constant; only "
            + "another static const can be named, through its type name");
    }

    // Whether the referring initializer may read the target field, under the ordinary member
    // access rules with the referring type standing for the access site.
    referenceVisible(ConstantItem item, Field field, Span at, string followUp = "") -> bool {
        let defining = types.authorityOf(field.definingType());
        if (defining == null) {
            return true;
        }
        bool allowed = types.memberAccessAllowed(field.visibility(), defining, item.owner,
            item.context.module().canonicalPath(), item.context.module().packagePrefix());
        if (!allowed) {
            string modulePath = item.context.module().canonicalPath();
            string needed = "export";
            if (defining.modulePath() == modulePath) {
                needed = "protected";
            } else if (defining.packagePrefix() == item.context.module().packagePrefix()) {
                needed = "public";
            }
            string definingName = this.namesOf(item).nameOf(defining);
            string owner = "{typenames.kindWordOf(defining)} '{definingName}'";
            string problem = "'{field.name()}' is private to {owner}, so only code inside "
                + "'{definingName}' can read it.";
            if (field.visibility() == Visibility.Protected) {
                problem = "'{field.name()}' is 'protected' in {owner}, so only "
                    + "{types.protectedReach(defining, definingName)} can read it.";
            } else if (field.visibility() == Visibility.Public) {
                string packageName = "its own package";
                if (defining.packagePrefix().length > 0) {
                    packageName = "package '{defining.packagePrefix()}'";
                }
                problem = "'{field.name()}' is public inside {packageName}, so another package "
                    + "cannot read it.";
            }
            string after = "";
            if (followUp.length > 0) {
                after = " {followUp}";
            }
            this.report(item, "{problem} Mark it '{needed}' to read it here.{after}", at);
        }
        return allowed;
    }

    // The evaluated value adapted to the field's declared type, or null after a diagnostic. The
    // adaptation follows the untyped-literal rules: an integer fits any integer type that holds
    // its value and converts to a floating-point type, a char's codepoint fits the integer types
    // the same way a char literal does, and everything else must match its own family. A type
    // outside the constant family was already rejected when the field was collected.
    fitDeclaredType(ConstantItem item, ConstantValue value) -> ConstantValue? {
        Type declared = item.field.type();
        string name = this.itemName(item);
        Span at = item.initializer.span();
        if (declared is ErrorType) {
            return null;
        }
        if (declared is StringType) {
            if (value.kind() == ConstantKind.String) {
                return value;
            }
            this.report(item, mismatchMessage(name, "string", value), at);
            return null;
        }
        if (!(declared is PrimitiveType)) {
            return null;
        }
        PrimitiveKind kind = declared.kind();
        if (kind == PrimitiveKind.Bool) {
            if (value.kind() == ConstantKind.Bool) {
                return value;
            }
            this.report(item, mismatchMessage(name, "bool", value), at);
            return null;
        }
        if (kind == PrimitiveKind.Char) {
            if (value.kind() == ConstantKind.Char) {
                return value;
            }
            this.report(item, "Static const '{name}' has type 'char', but its initializer is "
                + "{constantKindText(value)}. Write a char literal such as '/'.", at);
            return null;
        }
        if (kind == PrimitiveKind.Float || kind == PrimitiveKind.Double) {
            double magnitude = 0.0;
            bool negative = false;
            switch (value.kind()) {
                Float -> {
                    magnitude = value.floatValue();
                    if (magnitude < 0.0) {
                        negative = true;
                        magnitude = 0.0 - magnitude;
                    }
                },
                Integer -> {
                    magnitude = value.magnitude() as double;
                    negative = value.isNegative();
                },
                default -> {
                    this.report(item, mismatchMessage(name, this.namesOf(item).of(declared), value),
                        at);
                    return null;
                },
            }
            if (!literalvalues.floatMagnitudeFits(magnitude, kind)) {
                string limit = "largest";
                string beyond = "larger";
                string within = "a smaller value";
                if (negative) {
                    limit = "smallest";
                    beyond = "smaller";
                    within = "a value inside the range";
                }
                string fix = "Use {within}.";
                if (kind == PrimitiveKind.Float) {
                    fix = "Use 'double', or {within}.";
                }
                this.report(item, "Static const '{name}' has type "
                    + "'{this.namesOf(item).of(declared)}', whose {limit} value is "
                    + "{literalvalues.floatLimit(kind, negative)}, and this value is {beyond}. {fix}",
                    at);
                return null;
            }
            return literalvalues.floatConstant(negative, magnitude);
        }
        bool negativeValue = false;
        ulong magnitudeValue = 0;
        switch (value.kind()) {
            Integer -> {
                negativeValue = value.isNegative();
                magnitudeValue = value.magnitude();
            },
            Char -> {
                magnitudeValue = value.magnitude();
            },
            default -> {
                this.report(item, mismatchMessage(name, this.namesOf(item).of(declared), value),
                    at);
                return null;
            },
        }
        if (!literalvalues.magnitudeFits(negativeValue, magnitudeValue, kind)) {
            string shown = literalvalues.constantText(value);
            this.report(item, "Static const '{name}' has type '{this.namesOf(item).of(declared)}', "
                + "which goes {literalvalues.integerRange(kind)}, and '{shown}' is outside that "
                + "range. Use a type that fits '{shown}', or a value inside that range.", at);
            return null;
        }
        return literalvalues.integerConstant(negativeValue, magnitudeValue);
    }
}

// Why a type parameter is never part of a compile-time constant, as the middle clause of the
// standard refusal. The constant has one value for every type argument.
typeParameterClause(string name, string ownerName) -> string {
    return "'{name}' is a type parameter, and a static const of '{ownerName}' has one value for "
        + "every choice of '{name}'";
}

// The refusal of an initializer whose value is of another kind than the declared type.
mismatchMessage(string name, string declared, ConstantValue value) -> string {
    return "Static const '{name}' has type '{declared}', but its initializer is "
        + "{constantKindText(value)}. Write a value of type '{declared}', or change the type to "
        + "'{valueTypeName(value)}'.";
}

// The type a constant value has when nothing else decides it, as the fix of a mismatch names it.
valueTypeName(ConstantValue value) -> string {
    if (value.kind() == ConstantKind.Integer) {
        if (literalvalues.magnitudeFits(value.isNegative(), value.magnitude(), PrimitiveKind.Int)) {
            return "int";
        }
        if (literalvalues.magnitudeFits(value.isNegative(), value.magnitude(), PrimitiveKind.Long)) {
            return "long";
        }
        return "ulong";
    }
    return switch (value.kind()) {
        Integer -> "int",
        Float -> "double",
        Bool -> "bool",
        Char -> "char",
        String -> "string",
    };
}

// The fractional operands of a '%', as its refusal names them.
fractionalOperands(ConstantValue left, ConstantValue right) -> string {
    if (left.kind() == ConstantKind.Float && right.kind() == ConstantKind.Float) {
        return "the fractional numbers '{literalvalues.constantText(left)}' and "
            + "'{literalvalues.constantText(right)}'";
    }
    if (left.kind() == ConstantKind.Float) {
        return constantKindText(left);
    }
    return constantKindText(right);
}

isConstantOperator(SyntaxKind operator) -> bool {
    return switch (operator) {
        Plus, Minus, Star, Slash, Percent -> true,
        default -> false,
    };
}

asFloat(ConstantValue value) -> double {
    if (value.kind() == ConstantKind.Float) {
        return value.floatValue();
    }
    double magnitude = value.magnitude() as double;
    if (value.isNegative()) {
        return 0.0 - magnitude;
    }
    return magnitude;
}

// How a constant value's kind reads in a diagnostic.
constantKindText(ConstantValue value) -> string {
    return switch (value.kind()) {
        Integer -> "the number '{literalvalues.constantText(value)}'",
        Float -> "the fractional number '{literalvalues.constantText(value)}'",
        Bool -> "the bool '{literalvalues.constantText(value)}'",
        Char -> "a char",
        String -> "the string '{literalvalues.constantText(value)}'",
    };
}

final class Integers {
    protected static const ulong ceiling = 18446744073709551615;
}
