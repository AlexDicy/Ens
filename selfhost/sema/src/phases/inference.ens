// Type-argument inference for one call of a generic function or of a static of a generic type.
// The first argument to mention a parameter binds it, and the surrounding context fills what is
// left. Each slot records its source, so a mismatch is reported against the deciding argument.
import GreenNode from @ens.frontend.syntax.green;
import model.convert;
import model.hierarchy;
import TypeNames from model.typenames;
import QuotedCode from model.typenames;
import Type from model.types;
import ErrorType from model.types;
import NullType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import DeclaredType from model.types;
import FunctionType from model.types;
import TypeParamType from model.types;
import InstantiationType from model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import model.types;
import List from @std.collections.list;

public class TypeArgumentInference {
    static const long unbound = -2;
    static const long fromContext = -1;

    TypeStore store;
    GreenNode owner;
    List<Type?> slotBindings;
    List<long> slotSources;
    List<long> voidSources;
    List<long> voidResults;

    public constructor(TypeStore store, GreenNode owner, long arity) {
        this.store = store;
        this.owner = owner;
        this.slotBindings = new List<Type?>();
        this.slotSources = new List<long>();
        this.voidSources = new List<long>();
        this.voidResults = new List<long>();
        for (long i = 0; i < arity; i++) {
            this.slotBindings.push(null);
            this.slotSources.push(TypeArgumentInference.unbound);
            this.voidSources.push(TypeArgumentInference.unbound);
            this.voidResults.push(TypeArgumentInference.unbound);
        }
    }

    // Binds each open type parameter the parameter type mentions, matching the argument
    // structurally and through what it conforms to. A mismatch binds nothing; the argument check
    // reports it. An argument that is itself no value leaves the slot it would fill open and keeps
    // the first argument that offered it, since a call refuses that argument. A 'void' inside the
    // argument's type, such as the result of a function that returns nothing, binds the slot only
    // when no other argument gives it a type, so a mismatch is reported against the argument whose
    // type is a value.
    public unifyArgument(long argumentIndex, Type parameterType, Type argumentType) {
        this.unifyAt(argumentIndex, parameterType, argumentType, true);
    }

    unifyAt(long argumentIndex, Type parameterType, Type argumentType, bool whole) {
        switch (parameterType) {
            is TypeParamType parameter -> {
                if (parameter.owner() != this.owner
                        || parameter.index() >= this.slotBindings.length()
                        || this.slotBindings.get(parameter.index()) != null
                        || argumentType is NullType || argumentType is ErrorType) {
                    return;
                }
                if (types.isVoidType(argumentType)) {
                    let sources = whole ? this.voidSources : this.voidResults;
                    if (sources.get(parameter.index()) == TypeArgumentInference.unbound) {
                        sources.set(parameter.index(), argumentIndex);
                    }
                    return;
                }
                this.slotBindings.set(parameter.index(), argumentType);
                this.slotSources.set(parameter.index(), argumentIndex);
            },
            is OptionalType optional -> {
                Type inner = argumentType;
                if (inner is OptionalType) {
                    inner = inner.inner();
                }
                this.unifyAt(argumentIndex, optional.inner(), inner, whole);
            },
            is ArrayType array -> {
                let core = convert.coreOf(argumentType);
                if (core is ArrayType) {
                    this.unifyAt(argumentIndex, array.element(), core.element(), false);
                }
            },
            is FunctionType functionType -> {
                let core = convert.coreOf(argumentType);
                if (core is FunctionType) {
                    this.unifyEach(argumentIndex, functionType.parameterTypes(),
                        core.parameterTypes());
                    this.unifyAt(argumentIndex, functionType.returnType(), core.returnType(), false);
                    this.unifyThrown(argumentIndex, functionType.thrownTypes(), core.thrownTypes());
                }
            },
            is InstantiationType instantiation -> {
                let core = convert.coreOf(argumentType);
                let conforming = hierarchy.conformingInstantiationOf(core, instantiation.template());
                if (conforming != null) {
                    this.unifyEach(argumentIndex, instantiation.arguments(),
                        conforming.arguments());
                }
            },
            default -> { },
        }
    }

    // Binds the first open slot the template's throws list names to every type the argument's list
    // gives that the template's other entries do not, so it stands for the rest of the list, however
    // many types that is.
    unifyThrown(long argumentIndex, Type[] templateThrown, Type[] argumentThrown) {
        TypeParamType? open = null;
        let fixed = new List<Type>();
        for (let entry in templateThrown) {
            if (open == null && entry is TypeParamType && this.isOpen(entry)) {
                open = entry;
            } else {
                fixed.push(entry);
            }
        }
        if (open == null) {
            this.unifyEach(argumentIndex, templateThrown, argumentThrown);
            return;
        }
        let rest = new List<Type>();
        for (let thrown in argumentThrown) {
            if (thrown is ErrorType) {
                return;
            }
            if (!fixed.contains(thrown)) {
                rest.push(thrown);
            }
        }
        Type fallback = hierarchy.classBoundOf(open) ?? this.store.errorType();
        this.slotBindings.set(open.index(), convert.thrownListBinding(this.store, rest.toArray(), fallback));
        this.slotSources.set(open.index(), argumentIndex);
    }

    // Binds each open slot the throws list of the lambda at 'argumentIndex' names, among those
    // 'throwsOnly' admits, to what that lambda throws, which the exceptions phase settles once it
    // knows the lambda's body.
    public pendThrows(long argumentIndex, Type[] templateThrown, GreenNode lambda, bool[] throwsOnly) {
        for (let entry in templateThrown) {
            if (entry is TypeParamType && this.isOpen(entry) && throwsOnly[entry.index()]) {
                this.slotBindings.set(entry.index(), this.store.pendingThrowsOf(lambda));
                this.slotSources.set(entry.index(), argumentIndex);
            }
        }
    }

    isOpen(TypeParamType parameter) -> bool {
        return parameter.owner() == this.owner && parameter.index() < this.slotBindings.length()
            && this.slotBindings.get(parameter.index()) == null;
    }

    unifyEach(long argumentIndex, Type[] parameterTypes, Type[] argumentTypes) {
        for (long i = 0; i < parameterTypes.length && i < argumentTypes.length; i++) {
            this.unifyAt(argumentIndex, parameterTypes[i], argumentTypes[i], false);
        }
    }

    // Fills the slot from the surrounding context when no argument determined it.
    public fillFromContext(long index, Type type) {
        if (this.slotBindings.get(index) == null) {
            this.slotBindings.set(index, type);
            this.slotSources.set(index, TypeArgumentInference.fromContext);
        }
    }

    // Joins 'given', the result of the lambda at 'argumentIndex', into the slot of 'parameter', the result
    // its parameter declares, to the type both it and what the slot holds fit, as the branches of '?:'
    // join. False where no type fits both.
    public joinResult(long argumentIndex, TypeParamType parameter, Type given) -> bool {
        let bound = this.binding(parameter.index());
        if (bound != null && (types.isVoidType(given) || types.isVoidType(bound))) {
            return types.isVoidType(given) && types.isVoidType(bound);
        }
        if (bound == null || given is NullType || given is ErrorType) {
            this.unifyAt(argumentIndex, parameter, given, false);
            return true;
        }
        let joined = convert.unifyValueTypes(bound, given, this.store);
        if (joined == null) {
            return false;
        }
        this.slotBindings.set(parameter.index(), joined);
        return true;
    }

    // The index of the argument that bound the slot 'index', or a negative number when none did.
    public sourceOf(long index) -> long {
        return this.slotSources.get(index);
    }

    public arity() -> long {
        return this.slotBindings.length();
    }

    // True when 'type' mentions the slot 'index' outside every throws list, where a value of its
    // type could be.
    public mentionsSlotAsValue(Type type, long index) -> bool {
        return convert.mentionsAsValue(type, this.owner, index);
    }

    // The declaration whose type parameters the slots are.
    public declaration() -> GreenNode {
        return this.owner;
    }

    // What the slot 'index' holds: the type an argument or the context gave it, else 'void' where only
    // the result of a function that returns nothing offered one, else null.
    public binding(long index) -> Type? {
        let bound = this.slotBindings.get(index);
        if (bound != null || this.voidResults.get(index) == TypeArgumentInference.unbound) {
            return bound;
        }
        return this.store.primitive(PrimitiveKind.Void);
    }

    // The index of the first argument that would have made the open slot 'index' 'void', or null
    // when the slot is bound or no argument offered 'void' for it.
    public voidArgument(long index) -> long? {
        long source = this.voidSources.get(index);
        if (this.binding(index) != null || source == TypeArgumentInference.unbound) {
            return null;
        }
        return source;
    }

    // The template type with every bound slot replaced by its binding, or null while it mentions
    // a slot still open.
    public settled(Type templateType) -> Type? {
        if (this.mentionsOpenSlot(templateType)) {
            return null;
        }
        let arguments = new List<Type>();
        for (long i = 0; i < this.slotBindings.length(); i++) {
            arguments.push(this.binding(i) ?? this.store.errorType());
        }
        return this.store.substitute(templateType, this.owner, arguments.toArray());
    }

    // The template's throws list with every bound slot replaced by what it stands for, or null while
    // it mentions a slot still open.
    public settledThrown(Type[] templateThrown) -> Type[]? {
        if (this.anyMentionsOpenSlot(templateThrown)) {
            return null;
        }
        let arguments = new List<Type>();
        for (long i = 0; i < this.slotBindings.length(); i++) {
            arguments.push(this.binding(i) ?? this.store.errorType());
        }
        return this.store.substituteThrown(templateThrown, this.owner, arguments.toArray());
    }

    mentionsOpenSlot(Type templateType) -> bool {
        switch (templateType) {
            is TypeParamType parameter -> {
                return parameter.owner() == this.owner
                    && parameter.index() < this.slotBindings.length()
                    && this.binding(parameter.index()) == null;
            },
            is OptionalType optional -> {
                return this.mentionsOpenSlot(optional.inner());
            },
            is ArrayType array -> {
                return this.mentionsOpenSlot(array.element());
            },
            is FunctionType functionType -> {
                return this.anyMentionsOpenSlot(functionType.parameterTypes())
                    || this.mentionsOpenSlot(functionType.returnType())
                    || this.anyMentionsOpenSlot(functionType.thrownTypes());
            },
            is InstantiationType instantiation -> {
                return this.anyMentionsOpenSlot(instantiation.arguments());
            },
            default -> {
                return false;
            },
        }
    }

    anyMentionsOpenSlot(Type[] templateTypes) -> bool {
        for (let templateType in templateTypes) {
            if (this.mentionsOpenSlot(templateType)) {
                return true;
            }
        }
        return false;
    }

    // Every slot's binding in order, or null while any slot is still open.
    public bindings() -> Type[]? {
        let resolved = new List<Type>();
        for (long i = 0; i < this.slotBindings.length(); i++) {
            let bound = this.binding(i);
            if (bound == null) {
                return null;
            }
            resolved.push(bound);
        }
        return resolved.toArray();
    }

    // The sentences, opening with a space, that give where the mismatched parameter's type argument
    // came from and how to write it, or empty when the expected type mentions no bound parameter.
    // The call written with its type arguments is 'head', then the type arguments, then 'tail'; for
    // a static call on a generic 'template', it is the instantiation, then 'tail'.
    public provenance(Type templateParameterType, string head, string tail, TypeNames names,
                      DeclaredType? template = null) -> string {
        let parameter = this.firstBoundParameter(templateParameterType);
        if (parameter == null) {
            return "";
        }
        let bound = this.slotBindings.get(parameter.index());
        if (bound == null) {
            return "";
        }
        long source = this.slotSources.get(parameter.index());
        string origin = "the type the result has to have";
        if (source >= 0) {
            origin = "argument {source + 1}";
        }
        string found = " '{parameter.name()}' is {names.quoted(bound)} in this call, taken from {origin}.";
        let written = new List<Type>();
        for (let binding in this.slotBindings) {
            if (binding == null) {
                return found;
            }
            written.push(binding);
        }
        string change = "change {names.quoted(bound)} to the type you want";
        if (written.length() > 1) {
            change = "change the types to the ones you want";
        }
        let call = new QuotedCode();
        if (template != null) {
            call.writeType(this.store.instantiationOf(template, written.toArray()));
        } else {
            call.write("{head}<");
            for (long i = 0; i < written.length(); i++) {
                if (i > 0) {
                    call.write(", ");
                }
                call.writeType(written.get(i));
            }
            call.write(">");
        }
        call.write(tail);
        return "{found} To choose it yourself, write {call.quotedFor(names)} and {change}.";
    }

    // The first type parameter of the owner inside the type that inference bound, walking the
    // same shapes unifyArgument walks.
    firstBoundParameter(Type templateType) -> TypeParamType? {
        switch (templateType) {
            is TypeParamType parameter -> {
                if (parameter.owner() == this.owner
                        && parameter.index() < this.slotSources.length()
                        && this.slotSources.get(parameter.index())
                            != TypeArgumentInference.unbound) {
                    return parameter;
                }
                return null;
            },
            is ArrayType array -> {
                return this.firstBoundParameter(array.element());
            },
            is OptionalType optional -> {
                return this.firstBoundParameter(optional.inner());
            },
            is FunctionType functionType -> {
                let inParameters = this.firstBoundParameterIn(functionType.parameterTypes());
                if (inParameters != null) {
                    return inParameters;
                }
                let inReturn = this.firstBoundParameter(functionType.returnType());
                if (inReturn != null) {
                    return inReturn;
                }
                return this.firstBoundParameterIn(functionType.thrownTypes());
            },
            is InstantiationType instantiation -> {
                return this.firstBoundParameterIn(instantiation.arguments());
            },
            default -> {
                return null;
            },
        }
    }

    firstBoundParameterIn(Type[] templateTypes) -> TypeParamType? {
        for (let templateType in templateTypes) {
            let found = this.firstBoundParameter(templateType);
            if (found != null) {
                return found;
            }
        }
        return null;
    }
}
