// Overload resolution over pre-analyzed arguments. The body checker turns each written argument
// into an ArgumentValue - its analyzed type plus the literal facts untyped literals adapt with -
// so this module ranks and picks candidates without touching the syntax tree.
import Span from @ens.frontend.support.source;
import Reporter from support.diagnostics;
import support.diagnostics;
import model.convert;
import model.hierarchy;
import model.literalvalues;
import model.typemembers;
import Method from model.typemembers;
import Parameter from model.typemembers;
import Signature from model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import QuotedCode from model.typenames;
import Type from model.types;
import ErrorType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;

// What an argument fits a parameter by: its type, or for an argument that names no type of its own,
// what is written. A struct literal fits every parameter until a candidate is chosen.
public enum ArgumentShape {
    Typed,
    Lambda,
    Name,
    ArrayLiteral,
    StructLiteral,
}

// One analyzed call argument. The literal facts carry what conversionRank reads about
// untyped integer and char literals: their value, so fitting a narrower parameter still counts.
public class ArgumentValue {
    string argumentName;
    Type argumentType;
    bool integerLiteral;
    bool negativeLiteral;
    ulong literalMagnitude;
    bool characterLiteral;
    bool targetTyped;
    Span argumentSpan;

    bool floatLiteral;
    double floatLiteralMagnitude;

    ArgumentShape argumentShape;
    // The parameter counts a lambda or a name fits, and the elements of an array literal with the type
    // the literal has when it is written alone.
    long[] parameterCounts;
    ArgumentValue[] elementValues;
    Type? typeAlone;
    string? writtenSpelling;

    public constructor(string name, Type type, bool isIntegerLiteral, bool isNegative,
                ulong magnitude, bool isCharacterLiteral, Span span) {
        this.argumentName = name;
        this.argumentType = type;
        this.integerLiteral = isIntegerLiteral;
        this.negativeLiteral = isNegative;
        this.literalMagnitude = magnitude;
        this.characterLiteral = isCharacterLiteral;
        this.targetTyped = false;
        this.argumentSpan = span;
        this.floatLiteral = false;
        this.floatLiteralMagnitude = 0.0;
        this.argumentShape = ArgumentShape.Typed;
        this.parameterCounts = [];
        this.elementValues = [];
        this.typeAlone = null;
        this.writtenSpelling = null;
    }

    // True for an argument typed once a candidate is chosen: one that names no type of its own, and
    // with a single candidate, one holding a literal too large for 'float'.
    public needsTarget() -> bool {
        return this.targetTyped;
    }

    public markNeedsTarget() {
        this.targetTyped = true;
    }

    public shape() -> ArgumentShape {
        return this.argumentShape;
    }

    // A lambda that declares 'count' parameters.
    public markLambda(long count) {
        this.markShape(ArgumentShape.Lambda);
        this.parameterCounts = [count];
    }

    // The name of methods or functions, one of which takes each of 'counts' arguments.
    public markName(long[] counts) {
        this.markShape(ArgumentShape.Name);
        this.parameterCounts = counts;
    }

    // An array literal of 'elements', with the type 'alone' it has when it is written alone, or null
    // where its elements give it none.
    public markArrayLiteral(ArgumentValue[] elements, Type? alone) {
        this.markShape(ArgumentShape.ArrayLiteral);
        this.elementValues = elements;
        this.typeAlone = alone;
    }

    public markStructLiteral() {
        this.markShape(ArgumentShape.StructLiteral);
    }

    markShape(ArgumentShape shape) {
        this.targetTyped = true;
        this.argumentShape = shape;
    }

    public elements() -> ArgumentValue[] {
        return this.elementValues;
    }

    public aloneType() -> Type? {
        return this.typeAlone;
    }

    protected takesParameterCount(long count) -> bool {
        for (let taken in this.parameterCounts) {
            if (taken == count) {
                return true;
            }
        }
        return false;
    }

    protected declaredParameterCount() -> long {
        return this.parameterCounts[0];
    }

    // The argument as the call writes it, or null where it is too long to repeat in a message.
    public spelling() -> string? {
        return this.writtenSpelling;
    }

    public setSpelling(string? spelled) {
        this.writtenSpelling = spelled;
    }

    // Whether this is the name of a method or function, or an array literal holding one.
    public holdsName() -> bool {
        if (this.argumentShape == ArgumentShape.Name) {
            return true;
        }
        for (let element in this.elementValues) {
            if (element.holdsName()) {
                return true;
            }
        }
        return false;
    }

    // Whether this, or an element of this array literal, has a type that a refusal took away.
    public holdsError() -> bool {
        if (!this.targetTyped) {
            return this.argumentType is ErrorType;
        }
        for (let element in this.elementValues) {
            if (element.holdsError()) {
                return true;
            }
        }
        return false;
    }

    // The named-argument name, or "" for a positional argument.
    public name() -> string {
        return this.argumentName;
    }

    public type() -> Type {
        return this.argumentType;
    }

    protected isIntegerLiteral() -> bool {
        return this.integerLiteral;
    }

    protected isNegative() -> bool {
        return this.negativeLiteral;
    }

    protected magnitude() -> ulong {
        return this.literalMagnitude;
    }

    protected isCharacterLiteral() -> bool {
        return this.characterLiteral;
    }

    // An unsuffixed floating-point literal, which ranks against a floating-point parameter the
    // way an untyped integer literal ranks against an integer one.
    public markFloatLiteral(double magnitude) {
        this.floatLiteral = true;
        this.floatLiteralMagnitude = magnitude;
    }

    protected isFloatLiteral() -> bool {
        return this.floatLiteral;
    }

    protected floatMagnitude() -> double {
        return this.floatLiteralMagnitude;
    }

    public span() -> Span {
        return this.argumentSpan;
    }
}

// The analyzed shape of one call: positional arguments, named arguments, and whether the shape
// already failed (duplicate or misplaced names) or carries an errored argument.
public class CallShape {
    List<ArgumentValue> positionalArguments;
    List<ArgumentValue> namedArguments;
    bool shapeMalformed;
    bool erroredArgument;
    // How a fix names a local it declares: the name it would use, numbered where that is taken.
    (string) -> string localNamer;

    public constructor() {
        this.positionalArguments = new List<ArgumentValue>();
        this.namedArguments = new List<ArgumentValue>();
        this.shapeMalformed = false;
        this.erroredArgument = false;
        this.localNamer = (base) -> base;
    }

    public setLocalNamer((string) -> string namer) {
        this.localNamer = namer;
    }

    protected localName(string base) -> string {
        return this.localNamer(base);
    }

    // Whether an argument is the name of a method or function, which is refused on its own where no
    // candidate is chosen.
    protected holdsName() -> bool {
        for (long i = 0; i < this.argumentCount(); i++) {
            if (this.argumentAt(i).holdsName()) {
                return true;
            }
        }
        return false;
    }

    // Whether an argument is an array literal with a type of its own, which fits by its elements only
    // where no candidate takes that type.
    protected holdsTypedArrayLiteral() -> bool {
        for (long i = 0; i < this.argumentCount(); i++) {
            if (this.argumentAt(i).aloneType() != null) {
                return true;
            }
        }
        return false;
    }

    public positional() -> List<ArgumentValue> {
        return this.positionalArguments;
    }

    public named() -> List<ArgumentValue> {
        return this.namedArguments;
    }

    // Every argument in source order: positional first, then named.
    public argumentAt(long index) -> ArgumentValue {
        if (index < this.positionalArguments.length()) {
            return this.positionalArguments.get(index);
        }
        return this.namedArguments.get(index - this.positionalArguments.length());
    }

    public argumentCount() -> long {
        return this.positionalArguments.length() + this.namedArguments.length();
    }

    public isMalformed() -> bool {
        return this.shapeMalformed;
    }

    public markMalformed() {
        this.shapeMalformed = true;
    }

    protected hasErrorArgument() -> bool {
        return this.erroredArgument;
    }

    public markErrorArgument() {
        this.erroredArgument = true;
    }
}

// One callable a call could resolve to. method is present for method and constructor
// candidates and null for free functions.
public class CallCandidate {
    Signature candidateSignature;
    Method? candidateMethod;
    bool candidateAccessible;

    public constructor(Signature signature, Method? method, bool accessible) {
        this.candidateSignature = signature;
        this.candidateMethod = method;
        this.candidateAccessible = accessible;
    }

    public signature() -> Signature {
        return this.candidateSignature;
    }

    public method() -> Method? {
        return this.candidateMethod;
    }

    public isAccessible() -> bool {
        return this.candidateAccessible;
    }
}

public class CallResolution {
    bool resolutionFailed;
    CallCandidate? chosenCandidate;
    long[] argumentMapping;

    protected constructor(bool failed, CallCandidate? chosen, long[] mapping) {
        this.resolutionFailed = failed;
        this.chosenCandidate = chosen;
        this.argumentMapping = mapping;
    }

    public failed() -> bool {
        return this.resolutionFailed;
    }

    public chosen() -> CallCandidate? {
        return this.chosenCandidate;
    }

    // Source-order argument index to parameter index.
    public mapping() -> long[] {
        return this.argumentMapping;
    }
}

// The number of leading parameters without defaults: the least a call must supply.
public requiredArgumentCount(Signature signature) -> long {
    return typemembers.requiredParameterCount(signature);
}

// Whether this many positional arguments can reach the signature at all, which is what determines
// between the overloads of one name before any argument type is read.
public acceptsArgumentCount(Signature signature, long count) -> bool {
    return count >= requiredArgumentCount(signature) && count <= signature.parameters().length;
}

// How many of 'noun' a callee takes, from 'required' to 'total', in words: "no arguments", "one
// argument", "one or two arguments", "up to three arguments".
takenCount(long required, long total, string noun) -> string {
    string plural = "{noun}s";
    if (total == 1) {
        plural = noun;
    }
    if (required == total && total == 0) {
        return "no {noun}s";
    }
    if (required == total) {
        return "{diagnostics.countWord(total)} {plural}";
    }
    if (required == 0) {
        return "up to {diagnostics.countWord(total)} {plural}";
    }
    if (total == required + 1) {
        return "{diagnostics.countWord(required)} or {diagnostics.countWord(total)} {plural}";
    }
    return "{diagnostics.countWord(required)} to {diagnostics.countWord(total)} {plural}";
}

// The refusal of a call that passes 'count' of 'noun' where 'opening', which ends in 'takes', takes
// 'required' to 'total', with the fix that removes the extra ones or adds the missing ones. 'names'
// gives each parameter's name, and a missing one without a name is added by count.
public countRefusal(string opening, long required, long total, long count, string noun,
                    string[] names) -> string {
    string refusal = "{opening} {takenCount(required, total, noun)}, but this call passes "
        + "{diagnostics.countWord(count)}.";
    if (count > total && count - total == 1) {
        return "{refusal} Remove the extra {noun}.";
    }
    if (count > total) {
        return "{refusal} Remove the extra {noun}s.";
    }
    let missing = new List<string>();
    for (long i = count; i < required && i < names.length && names[i].length > 0; i++) {
        missing.push("'{names[i]}'");
    }
    long lacking = required - count;
    if (missing.length() == lacking && lacking == 1) {
        string article = "a";
        if (noun.startsWith("a")) {
            article = "an";
        }
        return "{refusal} Add {article} {noun} for {missing.get(0)}.";
    }
    if (missing.length() == lacking) {
        return "{refusal} Add {noun}s for {diagnostics.andJoined(missing.toArray())}.";
    }
    if (lacking == 1) {
        return "{refusal} Add one more {noun}.";
    }
    return "{refusal} Add {diagnostics.countWord(lacking)} more {noun}s.";
}

// countRefusal for a call to 'subject' that passes 'count' arguments, which 'signature' does not
// take.
public arityRefusal(string subject, Signature signature, long count) -> string {
    Parameter[] parameters = signature.parameters();
    let names = new List<string>();
    for (let parameter in parameters) {
        names.push(parameter.name());
    }
    return countRefusal("{subject} takes", requiredArgumentCount(signature), parameters.length, count,
        "argument", names.toArray());
}

class MapOutcome {
    protected bool ok;
    protected long[] mapping;
    protected long defaulted;
    protected string failure;

    protected constructor() {
        this.ok = false;
        this.mapping = [];
        this.defaulted = 0;
        this.failure = "";
    }
}

// Binds every source-order argument to a parameter index. On failure the outcome's text
// explains why for single-candidate reporting.
mapArguments(Signature signature, CallShape shape, string kindWord, string displayName) -> MapOutcome {
    let outcome = new MapOutcome();
    string subject = calleeSubject(kindWord, displayName);
    Parameter[] parameters = signature.parameters();
    long parameterCount = parameters.length;
    long positionalCount = shape.positional().length();
    long total = shape.argumentCount();
    long required = requiredArgumentCount(signature);
    if (positionalCount > parameterCount) {
        outcome.failure = arityRefusal(subject, signature, total);
        return outcome;
    }
    bool[] bound = new bool[parameterCount];
    let mapping = new List<long>();
    for (long i = 0; i < positionalCount; i++) {
        bound[i] = true;
        mapping.push(i);
    }
    for (long n = 0; n < shape.named().length(); n++) {
        let argument = shape.named().get(n);
        long index = -1;
        for (long j = 0; j < parameterCount; j++) {
            if (parameters[j].name() == argument.name()) {
                index = j;
                break;
            }
        }
        if (index < 0) {
            outcome.failure = unknownParameterMessage(parameters, shape, argument.name(), subject);
            return outcome;
        }
        if (bound[index]) {
            outcome.failure = "{subject} gets two arguments for parameter '{argument.name()}'. Remove "
                + "the named argument for '{argument.name()}', or remove the positional one.";
            return outcome;
        }
        bound[index] = true;
        mapping.push(index);
    }
    for (long j = 0; j < parameterCount; j++) {
        if (bound[j]) {
            continue;
        }
        if (parameters[j].hasDefault()) {
            outcome.defaulted++;
            continue;
        }
        string name = parameters[j].name();
        if (name.length == 0) {
            outcome.failure = "{subject} is missing an argument for parameter {j + 1}. Add one.";
            return outcome;
        }
        outcome.failure = "{subject} is missing an argument for parameter '{name}'. Add one, as in "
            + "'{name}: ...'.";
        return outcome;
    }
    outcome.ok = true;
    outcome.mapping = mapping.toArray();
    return outcome;
}

// How a call diagnostic names what is called. A constructor is named by the type it builds.
public calleeSubject(string kindWord, string displayName) -> string {
    if (kindWord == "Constructor" || kindWord == "Base constructor") {
        return "The constructor of '{displayName}'";
    }
    return "{kindWord} '{displayName}'";
}

// The refusal of a named argument that matches no parameter of the callee. The fix offers only
// the parameters no other argument of the call has taken.
unknownParameterMessage(Parameter[] parameters, CallShape shape, string written, string subject) -> string {
    string problem = "{subject} has no parameter named '{written}'.";
    string removal = "Remove the argument '{written}: ...'.";
    if (parameters.length == 0) {
        return "{problem} It takes no parameters. {removal}";
    }
    let names = new List<string>();
    let open = new List<string>();
    for (long j = 0; j < parameters.length; j++) {
        string name = parameters[j].name();
        names.push("'{name}'");
        if (j >= shape.positional().length() && !namedInCall(shape, name)) {
            open.push("'{name}:'");
        }
    }
    string listing = "Its parameters are {diagnostics.andJoined(names.toArray())}.";
    if (parameters.length == 1) {
        listing = "Its only parameter is {names.get(0)}.";
    }
    if (open.length() == 0) {
        string taken = "Each of them already has an argument.";
        if (parameters.length == 1) {
            taken = "It already has an argument.";
        }
        return "{problem} {listing} {taken} {removal}";
    }
    if (open.length() == 1) {
        return "{problem} {listing} Change '{written}:' to {open.get(0)}.";
    }
    string choices = diagnostics.andJoined(open.toArray(), "or");
    return "{problem} {listing} Change '{written}:' to one of {choices}.";
}

// True when a named argument of the call names this parameter.
namedInCall(CallShape shape, string name) -> bool {
    let named = shape.named();
    for (long i = 0; i < named.length(); i++) {
        if (named.get(i).name() == name) {
            return true;
        }
    }
    return false;
}

// How well an argument fits a parameter: 3 exact, 2 implicit conversion, 1 viable only because
// an untyped literal's value fits the parameter's own numeric family, 0 not at all. With 'byElements',
// an array literal fits by its elements even where it has a type of its own.
public conversionRank(ArgumentValue argument, Type parameterType, bool byElements = false) -> long {
    switch (argument.shape()) {
        Lambda, Name, ArrayLiteral -> {
            return shapeRank(argument, parameterType, byElements);
        },
        default -> { },
    }
    Type argumentType = argument.type();
    if (argumentType is ErrorType || parameterType is ErrorType) {
        return 3;
    }
    if (argumentType == parameterType) {
        return 3;
    }
    if (parameterType is PrimitiveType && convert.isIntegerType(parameterType)) {
        if (argument.isIntegerLiteral() && literalvalues.magnitudeFits(argument.isNegative(),
                argument.magnitude(), parameterType.kind())) {
            if (hierarchy.widensTo(argumentType, parameterType)) {
                return 2;
            }
            return 1;
        }
        if (argument.isCharacterLiteral() && literalvalues.magnitudeFits(false,
                argument.magnitude(), parameterType.kind())) {
            if (hierarchy.widensTo(argumentType, parameterType)) {
                return 2;
            }
            return 1;
        }
    }
    if (parameterType is PrimitiveType && argument.isFloatLiteral()
            && literalvalues.floatMagnitudeFits(argument.floatMagnitude(),
                parameterType.kind())) {
        if (hierarchy.widensTo(argumentType, parameterType)) {
            return 2;
        }
        return 1;
    }
    // An untyped integer literal reaches a floating-point parameter, but the integers are its own
    // family, so an integer parameter outranks one: 'append(42)' is the integer overload wherever
    // both exist, and a lone floating-point one still takes it.
    if (parameterType is PrimitiveType && convert.isFloatType(parameterType)
            && (argument.isIntegerLiteral() || argument.isCharacterLiteral())) {
        return 1;
    }
    if (convert.isAssignableStrict(parameterType, argumentType)) {
        return 2;
    }
    return 0;
}

// How well a lambda, a name or an array literal fits a parameter by what is written. A nullable
// parameter fits it as a conversion, as it fits a value. An array literal with a type of its own fits
// by that type, and by its elements only with 'byElements', at the rank of its least fitting element.
shapeRank(ArgumentValue argument, Type parameterType, bool byElements) -> long {
    if (parameterType is ErrorType) {
        return 3;
    }
    Type core = convert.coreOf(parameterType);
    long fit = 3;
    if (core != parameterType) {
        fit = 2;
    }
    if (argument.shape() != ArgumentShape.ArrayLiteral) {
        if (core is FunctionType && argument.takesParameterCount(core.parameterTypes().length)) {
            return fit;
        }
        return 0;
    }
    if (!(core is ArrayType)) {
        return 0;
    }
    let alone = argument.aloneType();
    if (alone != null && !byElements) {
        if (alone == core) {
            return fit;
        }
        return 0;
    }
    for (let element in argument.elements()) {
        long rank = conversionRank(element, core.element(), true);
        if (rank < fit) {
            fit = rank;
        }
    }
    return fit;
}

class ViableCandidate {
    protected CallCandidate candidate;
    protected long[] mapping;
    protected long[] ranks;
    protected long defaulted;

    protected constructor(this.candidate, this.mapping, this.ranks, this.defaulted);
}

// Picks the best candidate: filter by argument shape and viability, rank argument matches
// (exact beats conversion beats literal fitting), prefer accessible candidates, keep the
// Pareto-undominated set with fewer defaulted parameters as the tiebreak, and report the
// no-match and ambiguity diagnostics here. A call passing the name of a method or function reports
// neither, because that name is refused on its own.
public resolveCall(List<CallCandidate> candidates, CallShape shape, Reporter reporter,
                   Span span, string displayName, string kindWord,
                   TypeNames names) -> CallResolution {
    if (shape.isMalformed()) {
        return new CallResolution(true, null, []);
    }
    let viable = viableCandidates(candidates, shape, kindWord, displayName, false);
    if (viable.length() == 0 && shape.holdsTypedArrayLiteral()) {
        viable = viableCandidates(candidates, shape, kindWord, displayName, true);
    }

    if (viable.length() == 0) {
        if (shape.holdsName()) {
            return new CallResolution(true, null, []);
        }
        string singleFailure = "";
        if (candidates.length() == 1) {
            singleFailure = mapArguments(candidates.get(0).signature(), shape, kindWord, displayName).failure;
        }
        let sole = soleCountRefusal(candidates, shape, displayName, kindWord, names);
        if (singleFailure.length > 0) {
            reporter.report(singleFailure, span);
        } else if (sole != null) {
            reporter.report(sole, span);
        } else {
            reporter.report(noMatchMessage(candidates, shape, displayName, kindWord, names), span);
        }
        return new CallResolution(true, null, []);
    }

    bool anyAccessible = false;
    for (long i = 0; i < viable.length(); i++) {
        if (viable.get(i).candidate.isAccessible()) {
            anyAccessible = true;
        }
    }
    let pool = new List<ViableCandidate>();
    for (long i = 0; i < viable.length(); i++) {
        if (viable.get(i).candidate.isAccessible() == anyAccessible) {
            pool.push(viable.get(i));
        }
    }

    let best = new List<ViableCandidate>();
    for (long i = 0; i < pool.length(); i++) {
        bool dominated = false;
        for (long j = 0; j < pool.length(); j++) {
            if (j != i && betterThan(pool.get(j), pool.get(i))) {
                dominated = true;
                break;
            }
        }
        if (!dominated) {
            best.push(pool.get(i));
        }
    }
    if (best.length() == 0) {
        best.push(pool.get(0));
    }
    if (best.length() > 1 && !shape.hasErrorArgument()) {
        if (!shape.holdsName()) {
            reporter.report(ambiguityMessage(best, shape, displayName, kindWord, names), span);
        }
        return new CallResolution(true, null, []);
    }

    let winner = best.get(0);
    return new CallResolution(false, winner.candidate, winner.mapping);
}

// The candidates the call's arguments can be passed to, each with how well every argument fits.
// With 'byElements', an array literal fits by its elements even where it has a type of its own.
viableCandidates(List<CallCandidate> candidates, CallShape shape, string kindWord, string displayName,
                 bool byElements) -> List<ViableCandidate> {
    let viable = new List<ViableCandidate>();
    for (let candidate in candidates) {
        let outcome = mapArguments(candidate.signature(), shape, kindWord, displayName);
        if (!outcome.ok) {
            continue;
        }
        let ranks = new List<long>();
        bool usable = true;
        for (long i = 0; i < shape.argumentCount(); i++) {
            Type parameterType = candidate.signature().parameters()[outcome.mapping[i]].type();
            long rank = conversionRank(shape.argumentAt(i), parameterType, byElements);
            if (rank == 0 && candidates.length() > 1 && !shape.hasErrorArgument()) {
                usable = false;
                break;
            }
            ranks.push(rank);
        }
        if (usable) {
            viable.push(new ViableCandidate(candidate, outcome.mapping, ranks.toArray(), outcome.defaulted));
        }
    }
    return viable;
}

betterThan(ViableCandidate left, ViableCandidate right) -> bool {
    bool atLeastAsGood = true;
    bool strictlyBetter = false;
    for (long i = 0; i < left.ranks.length; i++) {
        if (left.ranks[i] < right.ranks[i]) {
            atLeastAsGood = false;
        }
        if (left.ranks[i] > right.ranks[i]) {
            strictlyBetter = true;
        }
    }
    if (!atLeastAsGood) {
        return false;
    }
    if (strictlyBetter) {
        return true;
    }
    return left.defaulted < right.defaulted;
}

// The refusal of a call no declaration of the name accepts, naming the argument types it passes.
noMatchMessage(List<CallCandidate> candidates, CallShape shape, string displayName,
               string kindWord, TypeNames names) -> string {
    string declared = "None of the declared '{displayName}' functions";
    if (kindWord == "Method") {
        declared = "None of the declared '{displayName}' methods";
    } else if (kindWord == "Constructor" || kindWord == "Base constructor") {
        declared = "None of the declared constructors of '{displayName}'";
    }
    string listing = "They are {candidateList(candidates, names)}.";
    long count = shape.argumentCount();
    if (count == 0) {
        return "{declared} can be called with no arguments. {listing} Add the arguments of one "
            + "of them.";
    }
    let typed = new List<string>();
    let described = new List<string>();
    bool untyped = false;
    for (long i = 0; i < count; i++) {
        let argument = shape.argumentAt(i);
        string text = argumentText(argument, names);
        typed.push(text);
        if (argument.shape() == ArgumentShape.Typed) {
            text = "a value of type {text}";
        } else {
            untyped = true;
        }
        described.push(text);
    }
    if (count == 1) {
        return "{declared} takes {described.get(0)}. {listing} Change the argument to match one of them.";
    }
    if (untyped) {
        return "{declared} takes {diagnostics.andJoined(described.toArray())}. {listing} Change the "
            + "arguments to match one of them.";
    }
    return "{declared} takes the arguments {diagnostics.andJoined(typed.toArray())}. {listing} Change "
        + "the arguments to match one of them.";
}

// The refusal of a call that only one of several candidates takes as many arguments as, against that
// candidate: the first argument it does not take, and what it takes there. Null where no candidate or
// several take that many.
soleCountRefusal(List<CallCandidate> candidates, CallShape shape, string displayName, string kindWord,
                 TypeNames names) -> string? {
    long count = shape.argumentCount();
    CallCandidate? sole = null;
    for (let candidate in candidates) {
        if (acceptsArgumentCount(candidate.signature(), count)) {
            if (sole != null) {
                return null;
            }
            sole = candidate;
        }
    }
    if (sole == null || candidates.length() < 2) {
        return null;
    }
    let outcome = mapArguments(sole.signature(), shape, kindWord, displayName);
    if (!outcome.ok) {
        return null;
    }
    for (long i = 0; i < count; i++) {
        let argument = shape.argumentAt(i);
        Type wanted = sole.signature().parameters()[outcome.mapping[i]].type();
        if (conversionRank(argument, wanted, true) > 0) {
            continue;
        }
        string label = "{i + 1}";
        if (argument.name().length > 0) {
            label = "'{argument.name()}'";
        }
        string callee = "'{displayName}'";
        string noun = "'{displayName}'";
        if (kindWord == "Constructor" || kindWord == "Base constructor") {
            callee = "the constructor of '{displayName}'";
            noun = "constructor of '{displayName}'";
        }
        string passed = "has type {argumentText(argument, names)}";
        if (argument.shape() != ArgumentShape.Typed && argument.aloneType() == null) {
            passed = "is {argumentText(argument, names)}";
        }
        string taken = "{typenames.typeArticle(names.of(wanted))} {names.quoted(wanted)}";
        string signature = quotedSignature(sole.signature(), names);
        return "Argument {label} of {callee} {passed}, but {signature}, the only "
            + "{noun} that takes {takenCount(count, count, "argument")}, takes {taken} there"
            + "{shapeMismatch(argument, wanted)}.";
    }
    return null;
}

// Why a lambda or an array literal does not fit the parameter type 'wanted', opening with a comma, or
// empty for any other argument.
shapeMismatch(ArgumentValue argument, Type wanted) -> string {
    Type core = convert.coreOf(wanted);
    switch (argument.shape()) {
        Lambda -> {
            if (core is FunctionType) {
                long taken = core.parameterTypes().length;
                return ", which takes {takenCount(taken, taken, "parameter")}";
            }
            return ", which is not a function type";
        },
        ArrayLiteral -> {
            if (!(core is ArrayType)) {
                return ", which is not an array type";
            }
            return "";
        },
        default -> {
            return "";
        },
    }
}

// An argument as a refusal lists what a call passes: its type, or what is written where it names no
// type of its own.
argumentText(ArgumentValue argument, TypeNames names) -> string {
    switch (argument.shape()) {
        Lambda -> {
            long count = argument.declaredParameterCount();
            return "a lambda with {takenCount(count, count, "parameter")}";
        },
        Name -> {
            return "the name of a method or function";
        },
        ArrayLiteral -> {
            let alone = argument.aloneType();
            if (alone != null) {
                return names.quoted(alone);
            }
            if (argument.elements().length == 0) {
                return "an empty '[]'";
            }
            return "an array literal";
        },
        StructLiteral -> {
            return "a struct literal";
        },
        Typed -> {
            return names.quoted(argument.type());
        },
    }
}

// The refusal of a call that several declarations accept equally well. The fix converts every
// argument whose parameter type differs among them to the type the first of them takes, which
// makes that one match best, or declares them as locals of that type where one of them names no type
// of its own. When the passed arguments agree, the fix passes the first defaulted argument whose type
// differs among them.
ambiguityMessage(List<ViableCandidate> best, CallShape shape, string displayName, string kindWord,
                 TypeNames names) -> string {
    let shown = new List<CallCandidate>();
    for (long i = 0; i < best.length(); i++) {
        shown.push(best.get(i).candidate);
    }
    string problem = "This call matches {candidateList(shown, names)} equally well, so it is not "
        + "clear which one to call.";
    let first = best.get(0);
    Parameter[] wanted = first.candidate.signature().parameters();
    let differing = new List<long>();
    bool untyped = false;
    for (long i = 0; i < shape.argumentCount(); i++) {
        Type target = wanted[first.mapping[i]].type();
        bool differs = false;
        for (long c = 1; c < best.length(); c++) {
            let other = best.get(c);
            if (other.candidate.signature().parameters()[other.mapping[i]].type() != target) {
                differs = true;
            }
        }
        let argument = shape.argumentAt(i);
        if (differs && argument.type() != target) {
            differing.push(i);
            untyped = untyped || argument.needsTarget();
        }
    }
    if (untyped) {
        return "{problem} {localsFix(differing, first, shape, names)}";
    }
    let written = new List<string>();
    let described = new List<string>();
    bool renderable = true;
    for (let i in differing) {
        let argument = shape.argumentAt(i);
        Type target = wanted[first.mapping[i]].type();
        string? text = literalText(argument);
        if (text == null) {
            renderable = false;
        } else {
            written.push(names.quotedCode(["{text} as ", ""], [target]));
        }
        described.push("argument {i + 1} to {names.quoted(target)}");
    }
    if (described.length() > 0) {
        if (!renderable) {
            return "{problem} Convert {diagnostics.andJoined(described.toArray())} with 'as', so "
                + "the call matches one of them exactly.";
        }
        if (written.length() == 1) {
            return "{problem} Convert an argument with 'as', such as {written.get(0)}, so the call "
                + "matches one of them exactly.";
        }
        return "{problem} Convert the arguments with 'as', as in "
            + "{diagnostics.andJoined(written.toArray())}, so the call matches one of them exactly.";
    }
    return "{problem} {defaultedArgumentFix(best, shape, displayName, kindWord, names)}";
}

// The fix for a call whose arguments that differ among the candidates include one that names no type
// of its own, which 'as' cannot convert: declare each of them as a local of the type the first
// candidate takes, and pass the locals.
localsFix(List<long> differing, ViableCandidate first, CallShape shape, TypeNames names) -> string {
    Parameter[] wanted = first.candidate.signature().parameters();
    if (differing.length() > 1) {
        let declared = new List<string>();
        for (let i in differing) {
            Type type = wanted[first.mapping[i]].type();
            declared.push("argument {i + 1} as a local of type {names.quoted(type)}");
        }
        return "Declare {diagnostics.andJoined(declared.toArray())} first, and pass the locals.";
    }
    long index = differing.get(0);
    let argument = shape.argumentAt(index);
    let parameter = wanted[first.mapping[index]];
    Type type = parameter.type();
    string noun = switch (argument.shape()) {
        Lambda -> "the lambda",
        ArrayLiteral -> "the array",
        StructLiteral -> "the struct",
        default -> "argument {index + 1}",
    };
    string? spelled = argument.spelling();
    if (spelled == null) {
        return "Declare {noun} as a local of type {names.quoted(type)} first, and pass the local.";
    }
    string base = parameter.name();
    if (base.length == 0) {
        base = "value";
    }
    string local = shape.localName(base);
    string tail = " {local} = {spelled};";
    string declaration = names.quotedCode(["", tail], [type]);
    if (type is FunctionType && type.thrownTypes().length > 0) {
        declaration = names.quotedCode(["(", "){tail}"], [type]);
    }
    return "Declare {noun} as a local first, as in {declaration}, and pass '{local}'.";
}

// The fix for candidates that differ only in a parameter the call leaves to its default: pass
// that argument with the type the first candidate takes.
defaultedArgumentFix(List<ViableCandidate> best, CallShape shape, string displayName,
                     string kindWord, TypeNames names) -> string {
    Parameter[] wanted = best.get(0).candidate.signature().parameters();
    long passed = shape.argumentCount();
    long apart = -1;
    for (long j = passed; j < wanted.length && apart < 0; j++) {
        for (long c = 1; c < best.length(); c++) {
            Parameter[] other = best.get(c).candidate.signature().parameters();
            if (j >= other.length || other[j].type() != wanted[j].type()) {
                apart = j;
            }
        }
    }
    if (apart < 0) {
        return "Remove one of the declarations, or give them different parameter types.";
    }
    Type target = wanted[apart].type();
    string matched = quotedSignature(best.get(0).candidate.signature(), names);
    string fallback = "Pass a value of type {names.quoted(target)} as argument {apart + 1}, so the "
        + "call matches {matched}.";
    string? value = zeroText(target, names);
    if (apart != passed || kindWord != "Function" || shape.named().length() > 0 || value == null) {
        return fallback;
    }
    let arguments = new List<string>();
    for (long i = 0; i < passed; i++) {
        string? text = literalText(shape.argumentAt(i));
        if (text == null) {
            return fallback;
        }
        arguments.push(text);
    }
    arguments.push(value);
    return "Pass argument {apart + 1} as well, as in "
        + "'{displayName}({string.joined(arguments.toArray(), ", ")})', so the call matches {matched}.";
}

// A numeric literal argument as it can be written again, or null for any other argument.
literalText(ArgumentValue argument) -> string? {
    string sign = "";
    if (argument.isNegative()) {
        sign = "-";
    }
    if (argument.isIntegerLiteral() && !argument.isCharacterLiteral()) {
        return "{sign}{argument.magnitude()}";
    }
    if (argument.isFloatLiteral()) {
        return "{sign}{argument.floatMagnitude()}";
    }
    return null;
}

// A zero of a number type, written so it has exactly that type, or null for any other type.
zeroText(Type type, TypeNames names) -> string? {
    if (!(type is PrimitiveType)) {
        return null;
    }
    if (convert.isIntegerType(type)) {
        if (type.kind() == PrimitiveKind.Int) {
            return "0";
        }
        return "0 as {typenames.primitiveName(type.kind())}";
    }
    if (convert.isFloatType(type)) {
        if (type.kind() == PrimitiveKind.Double) {
            return "0.0";
        }
        return "0.0 as {typenames.primitiveName(type.kind())}";
    }
    return null;
}

candidateList(List<CallCandidate> candidates, TypeNames names) -> string {
    let displays = new List<string>();
    for (long i = 0; i < candidates.length(); i++) {
        displays.push(quotedSignature(candidates.get(i).signature(), names));
    }
    return diagnostics.andJoined(displays.toArray());
}

// The signature in quotes as it reads in an overload diagnostic: 'name(int, string)'.
quotedSignature(Signature signature, TypeNames names) -> string {
    let code = new QuotedCode();
    code.write("{signature.name()}(");
    Parameter[] parameters = signature.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            code.write(", ");
        }
        code.writeType(parameters[i].type());
    }
    code.write(")");
    return code.quotedFor(names);
}
