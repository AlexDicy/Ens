// Per-instantiation validation of the judgments a generic body defers because a type mentions a
// type parameter: interpolation holes and 'is'/'as?' tests. Body checking records each deferred
// judgment on its enclosing template or generic function; once every body is checked, the pass
// replays each obligation against the concrete type arguments of every instantiation that
// actually occurs, cascading through generic calls and through instantiations that only become
// concrete inside another instantiation.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import model.convert;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import Signature from model.types;
import InstantiationType from model.types;
import TypeParamType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import ClassType from model.types;
import StructType from model.types;
import ExternalType from model.types;
import ErrorType from model.types;
import StringType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import Field from model.types;
import MemberConstraint from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// One deferred judgment: where it sits in its template's file, and the open types to re-judge
// once concrete type arguments arrive. One recorded inside a conditional member carries that
// member's constraints as guards, so it is only judged for instantiations the member exists on.
public sealed abstract class Obligation {
    Span obligationSpan;
    MemberConstraint[] obligationGuards;

    protected constructor(Span span) {
        this.obligationSpan = span;
        this.obligationGuards = [];
    }

    protected span() -> Span {
        return this.obligationSpan;
    }

    public setGuards(MemberConstraint[] guards) {
        this.obligationGuards = guards;
    }

    protected guards() -> MemberConstraint[] {
        return this.obligationGuards;
    }
}

public class InterpolationObligation extends Obligation {
    Type holeType;

    public constructor(Type hole, Span span) {
        super(span);
        this.holeType = hole;
    }

    protected hole() -> Type {
        return this.holeType;
    }
}

public class TypeTestObligation extends Obligation {
    Type testSource;
    Type testTarget;
    bool castForm;

    public constructor(Type source, Type target, bool isCast, Span span) {
        super(span);
        this.testSource = source;
        this.testTarget = target;
        this.castForm = isCast;
    }

    protected source() -> Type {
        return this.testSource;
    }

    protected target() -> Type {
        return this.testTarget;
    }

    protected isCast() -> bool {
        return this.castForm;
    }
}

public class EqualityObligation extends Obligation {
    Type comparedStruct;

    public constructor(Type structType, Span span) {
        super(span);
        this.comparedStruct = structType;
    }

    protected structType() -> Type {
        return this.comparedStruct;
    }
}

// 'new T[n]', whose element type only says whether a freshly allocated slot is a valid value once
// the argument arrives. The name the allocation was declared into travels with it, because the
// wording offers a fill loop over that name.
public class ArrayElementObligation extends Obligation {
    Type elementType;
    bool namedFill;
    string fillName;

    public constructor(Type element, bool hasFillName, string name, Span span) {
        super(span);
        this.elementType = element;
        this.namedFill = hasFillName;
        this.fillName = name;
    }

    protected element() -> Type {
        return this.elementType;
    }

    protected hasFillName() -> bool {
        return this.namedFill;
    }

    protected name() -> string {
        return this.fillName;
    }
}

// One generic instantiation a declaration mentions, as written or inferred, plus the constraint
// scope active when it was resolved. A concrete mention seeds its template's obligations
// directly; an open one, its arguments still naming the enclosing owner's parameters, replays
// per owner assignment, and one recorded inside a conditional member replays only for
// assignments that satisfy the member's constraints. The resolvers record these; the pass reads
// them, and nothing else decides which instantiations are judged, so an instantiation whose only
// provenance is an excluded member's substituted signature is never judged at all.
public final class InstantiationMention {
    InstantiationType mentionedInstantiation;
    GreenNode? mentionGuardOwner;
    MemberConstraint[] mentionGuards;

    public constructor(this.mentionedInstantiation, this.mentionGuardOwner, this.mentionGuards);

    public instantiation() -> InstantiationType {
        return this.mentionedInstantiation;
    }

    public guardOwner() -> GreenNode? {
        return this.mentionGuardOwner;
    }

    public guards() -> MemberConstraint[] {
        return this.mentionGuards;
    }
}

// A throws list written on a function type, recorded by the resolver for the checks phase to
// validate under the constraint scope it was resolved in.
public final class FunctionThrowsMention {
    Type[] mentionedTypes;
    Span[] mentionedSpans;
    GreenNode? mentionScopeOwner;
    MemberConstraint[] mentionScopeConstraints;

    public constructor(this.mentionedTypes, this.mentionedSpans, this.mentionScopeOwner,
        this.mentionScopeConstraints);

    public thrownTypes() -> Type[] {
        return this.mentionedTypes;
    }

    public spans() -> Span[] {
        return this.mentionedSpans;
    }

    public scopeOwner() -> GreenNode? {
        return this.mentionScopeOwner;
    }

    public scopeConstraints() -> MemberConstraint[] {
        return this.mentionScopeConstraints;
    }
}

// A generic call whose type arguments still mention a type parameter of the enclosing owner;
// it names a concrete callee instantiation only once the owner's own arguments arrive. A call
// written inside a conditional member carries the member's constraints as guards.
class OpenCall {
    protected Signature callee;
    protected Type[] arguments;
    protected MemberConstraint[] guards;

    protected constructor(this.callee, this.arguments, this.guards);
}

class ConcreteCall {
    protected Signature callee;
    protected Type[] arguments;

    protected constructor(this.callee, this.arguments);
}

// Everything recorded against one generic owner: a class or struct template, or a generic
// function, identified by its declaration node.
class OwnerEntry {
    string entryName;
    string entryFile;
    List<Obligation> entryObligations;
    List<OpenCall> entryOpenCalls;

    protected constructor(string name, string filePath) {
        this.entryName = name;
        this.entryFile = filePath;
        this.entryObligations = new List<Obligation>();
        this.entryOpenCalls = new List<OpenCall>();
    }

    name() -> string {
        return this.entryName;
    }

    protected file() -> string {
        return this.entryFile;
    }

    protected obligations() -> List<Obligation> {
        return this.entryObligations;
    }

    protected openCalls() -> List<OpenCall> {
        return this.entryOpenCalls;
    }
}

// Collects deferred judgments and generic calls while bodies are checked; the pass reads it.
public final class ObligationRegistry {
    Map<GreenNode, OwnerEntry> owners;
    List<ConcreteCall> concreteCalls;

    public constructor() {
        this.owners = new Map<GreenNode, OwnerEntry>();
        this.concreteCalls = new List<ConcreteCall>();
    }

    public recordObligation(GreenNode owner, string name, string filePath, Obligation obligation) {
        this.entryFor(owner, name, filePath).obligations().push(obligation);
    }

    public recordOpenCall(GreenNode owner, string name, string filePath, Signature callee,
                   Type[] arguments, MemberConstraint[] guards) {
        this.entryFor(owner, name, filePath).openCalls().push(
            new OpenCall(callee, arguments, guards));
    }

    public recordConcreteCall(Signature callee, Type[] arguments) {
        this.concreteCalls.push(new ConcreteCall(callee, arguments));
    }

    protected entryOf(GreenNode owner) -> OwnerEntry? {
        return this.owners.get(owner);
    }

    protected allOwners() -> GreenNode[] {
        return this.owners.keys();
    }

    protected allConcreteCalls() -> List<ConcreteCall> {
        return this.concreteCalls;
    }

    entryFor(GreenNode owner, string name, string filePath) -> OwnerEntry {
        let existing = this.owners.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new OwnerEntry(name, filePath);
        this.owners.set(owner, created);
        return created;
    }
}

// Runs every recorded obligation against every concrete type-argument assignment its owner
// receives, and returns the diagnostics, each anchored in the owner's file and naming the
// instantiation it was judged for. The mentions carry every instantiation the program's
// declarations reference, with the constraint scope each was resolved under.
public check(TypeStore store, ObligationRegistry registry, List<InstantiationMention> mentions)
        -> FileDiagnostic[] {
    let pass = new ObligationPass(store, registry, mentions);
    return pass.run();
}

// One concrete type-argument assignment for one owner, plus how it reads in a diagnostic and
// how many cascade steps produced it.
class Assignment {
    protected GreenNode owner;
    protected Type[] arguments;
    protected string display;
    protected long depth;

    protected constructor(this.owner, this.arguments, this.display, this.depth);
}

class AssignmentKey {
    GreenNode keyOwner;
    Type[] keyArguments;

    protected constructor(GreenNode owner, Type[] arguments) {
        this.keyOwner = owner;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyOwner.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(AssignmentKey other) -> bool {
        if (this.keyOwner != other.keyOwner) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

class ObligationPass {
    TypeStore store;
    ObligationRegistry registry;
    List<InstantiationMention> mentions;
    List<FileDiagnostic> collected;
    Set<AssignmentKey> seen;
    List<Assignment> worklist;
    Map<GreenNode, List<InstantiationMention>> openMentionsByOwner;
    Set<GreenNode> productive;

    protected constructor(TypeStore store, ObligationRegistry registry,
                List<InstantiationMention> mentions) {
        this.store = store;
        this.registry = registry;
        this.mentions = mentions;
        this.collected = new List<FileDiagnostic>();
        this.seen = new Set<AssignmentKey>();
        this.worklist = new List<Assignment>();
        this.openMentionsByOwner = new Map<GreenNode, List<InstantiationMention>>();
        this.productive = new Set<GreenNode>();
    }

    // A concrete mention seeds its template's assignment directly; an open one becomes an edge
    // per owner its arguments name, replayed under its guards. Fill-derived instantiations are
    // reached transitively - the mention of the owner that fills them plus the filled template's
    // own mentions - so the store's instantiation list is never consulted: it also holds the
    // substituted signatures of excluded conditional members, which must not be judged.
    protected run() -> FileDiagnostic[] {
        let concreteInstantiations = new List<InstantiationType>();
        for (long i = 0; i < this.mentions.length(); i++) {
            let mention = this.mentions.get(i);
            let owners = new Set<GreenNode>();
            for (let argument in mention.instantiation().arguments()) {
                collectOwners(argument, owners);
            }
            if (owners.length() == 0) {
                concreteInstantiations.push(mention.instantiation());
            }
            for (let owner in owners.items()) {
                this.openMentionsFor(owner).push(mention);
            }
        }
        this.computeProductive();
        for (long i = 0; i < concreteInstantiations.length(); i++) {
            let instantiation = concreteInstantiations.get(i);
            this.push(instantiation.template().declaration(),
                instantiation.template().name(), instantiation.arguments(), 0);
        }
        for (let call in this.registry.allConcreteCalls().toArray()) {
            let declaration = call.callee.declaration();
            if (declaration != null) {
                this.push(declaration, call.callee.name(), call.arguments, 0);
            }
        }
        while (this.worklist.length() > 0) {
            this.process(this.worklist.pop());
        }
        return diagnostics.sorted(this.collected);
    }

    openMentionsFor(GreenNode owner) -> List<InstantiationMention> {
        let existing = this.openMentionsByOwner.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new List<InstantiationMention>();
        this.openMentionsByOwner.set(owner, created);
        return created;
    }

    // An owner is productive when one of its assignments can surface a diagnostic: it has
    // obligations of its own, or an open call or open instantiation in its bodies leads to a
    // productive owner. Everything else is pruned so an obligation-free program costs nothing.
    computeProductive() {
        for (let owner in this.registry.allOwners()) {
            let entry = this.registry.entryOf(owner);
            if (entry != null && entry.obligations().length() > 0) {
                this.productive.add(owner);
            }
        }
        bool progress = true;
        while (progress) {
            progress = false;
            for (let owner in this.registry.allOwners()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
            for (let owner in this.openMentionsByOwner.keys()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
        }
    }

    reachesProductive(GreenNode owner) -> bool {
        let entry = this.registry.entryOf(owner);
        if (entry != null) {
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let declaration = entry.openCalls().get(i).callee.declaration();
                if (declaration != null && this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let declaration = openMentions.get(i).instantiation().template().declaration();
                if (this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        return false;
    }

    // Queues one concrete assignment, once, for productive owners only. Cascades past the
    // depth limit come from a polymorphically recursive generic call chain that would never
    // close; the judged prefix is deep enough for any real code.
    push(GreenNode owner, string name, Type[] arguments, long depth) {
        if (depth > maxCascadeDepth()) {
            return;
        }
        if (!this.productive.contains(owner)) {
            return;
        }
        if (!this.seen.add(new AssignmentKey(owner, arguments))) {
            return;
        }
        this.worklist.push(new Assignment(owner, arguments, displayFor(name, arguments),
            depth));
    }

    process(Assignment assignment) {
        let entry = this.registry.entryOf(assignment.owner);
        if (entry != null) {
            for (long i = 0; i < entry.obligations().length(); i++) {
                this.judge(entry, assignment, entry.obligations().get(i));
            }
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let call = entry.openCalls().get(i);
                let declaration = call.callee.declaration();
                if (declaration == null || !this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.guardsHold(call.guards, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(call.arguments, assignment);
                if (substituted != null) {
                    this.push(declaration, call.callee.name(), substituted,
                        assignment.depth + 1);
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(assignment.owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let mention = openMentions.get(i);
                let instantiation = mention.instantiation();
                let declaration = instantiation.template().declaration();
                if (!this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.mentionGuardsHold(mention, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(instantiation.arguments(), assignment);
                if (substituted != null) {
                    this.push(declaration, instantiation.template().name(), substituted,
                        assignment.depth + 1);
                }
            }
        }
    }

    // A guarded mention replays only where the conditional member that wrote it exists; the
    // guards speak about the guard owner's parameters, so they only apply to that owner's own
    // assignments.
    mentionGuardsHold(InstantiationMention mention, Assignment assignment) -> bool {
        let owner = mention.guardOwner();
        if (owner == null || owner != assignment.owner) {
            return true;
        }
        return this.guardsHold(mention.guards(), assignment);
    }

    // The arguments with the assignment's substitution applied, or null when one still
    // mentions a type parameter of some other owner.
    substituteAll(Type[] arguments, Assignment assignment) -> Type[]? {
        let substituted = new List<Type>();
        for (let argument in arguments) {
            let concrete = this.store.substitute(argument, assignment.owner,
                assignment.arguments);
            if (convert.containsTypeParam(concrete)) {
                return null;
            }
            substituted.push(concrete);
        }
        return substituted.toArray();
    }

    // True when the assignment satisfies every guard, meaning the conditional member the
    // obligation was recorded in exists for it; an unguarded obligation always holds.
    guardsHold(MemberConstraint[] guards, Assignment assignment) -> bool {
        for (let guard in guards) {
            long index = guard.parameterIndex();
            if (index >= assignment.arguments.length) {
                continue;
            }
            Type argument = assignment.arguments[index];
            for (let bound in guard.bounds()) {
                Type here = this.store.substitute(bound, assignment.owner,
                    assignment.arguments);
                if (!types.satisfiesBound(argument, here, [])) {
                    return false;
                }
            }
        }
        return true;
    }

    judge(OwnerEntry entry, Assignment assignment, Obligation obligation) {
        if (!this.guardsHold(obligation.guards(), assignment)) {
            return;
        }
        switch (obligation) {
            is InterpolationObligation hole -> {
                let concrete = this.substituteOne(hole.hole(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, interpolationIssue(concrete),
                        obligation.span());
                }
            },
            is TypeTestObligation test -> {
                let source = this.substituteOne(test.source(), assignment);
                let target = this.substituteOne(test.target(), assignment);
                if (source != null && target != null) {
                    this.report(entry, assignment,
                        typeTestIssue(source, target, test.isCast()), obligation.span());
                }
            },
            is EqualityObligation equality -> {
                let concrete = this.substituteOne(equality.structType(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, equalityComparabilityIssue(concrete),
                        obligation.span());
                }
            },
            is ArrayElementObligation created -> {
                let concrete = this.substituteOne(created.element(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, arrayElementIssue(concrete,
                        created.hasFillName(), created.name()), obligation.span());
                }
            },
        }
    }

    substituteOne(Type open, Assignment assignment) -> Type? {
        let concrete = this.store.substitute(open, assignment.owner, assignment.arguments);
        if (concrete is ErrorType || convert.containsTypeParam(concrete)) {
            return null;
        }
        return concrete;
    }

    report(OwnerEntry entry, Assignment assignment, string? issue, Span span) {
        if (issue != null) {
            this.collected.push(new FileDiagnostic(entry.file(),
                "In '{assignment.display}': " + issue, span));
        }
    }
}

maxCascadeDepth() -> long {
    return 200;
}

collectOwners(Type type, Set<GreenNode> owners) {
    switch (type) {
        is TypeParamType parameter -> {
            owners.add(parameter.owner());
        },
        is OptionalType optional -> {
            collectOwners(optional.inner(), owners);
        },
        is ArrayType array -> {
            collectOwners(array.element(), owners);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                collectOwners(parameter, owners);
            }
            collectOwners(functionType.returnType(), owners);
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                collectOwners(argument, owners);
            }
        },
        default -> { },
    }
}

displayFor(string name, Type[] arguments) -> string {
    let builder = new StringBuilder();
    builder.append(name);
    builder.append("<");
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(types.display(arguments[i]));
    }
    builder.append(">");
    return builder.toString();
}

// Why a value of this type cannot fill an interpolation hole, or null when it can. A struct that
// declares its own 'toString' fills the hole through that method and is never serialized; one
// without interpolates as its JSON form, which needs every field to be JSON-able. A class or
// interface value always fills a hole: its runtime type's 'toString' override answers, or that
// type's name when no class in the chain declares one.
public interpolationIssue(Type analyzed) -> string? {
    if (isJsonableLeaf(analyzed)) {
        return null;
    }
    if (isStructValue(analyzed)) {
        if (types.declaredToString(analyzed) != null) {
            return null;
        }
        return structJsonabilityIssue(analyzed);
    }
    if (types.isClassLike(analyzed)) {
        return null;
    }
    if (analyzed is ArrayType) {
        return arrayTextIssue(analyzed);
    }
    if (analyzed is FunctionType) {
        return "Cannot interpolate a value of type '{types.display(analyzed)}': a function "
            + "value has no text form. Interpolate what the function returns, or a name you "
            + "keep beside it.";
    }
    if (analyzed is OptionalType) {
        if (analyzed.inner() is OptionalType) {
            return "Cannot interpolate a value of type '{types.display(analyzed)}' because it "
                + "may be null at more than one level. Unwrap one level at a time, with a null "
                + "check ('if (value != null)') or a fallback ('value ?? null'), until what "
                + "remains is '{types.display(convert.coreOf(analyzed))}'.";
        }
        return "Cannot interpolate a value of type '{types.display(analyzed)}' because it "
            + "may be null. Check it for null first ('if (value != null)'), or supply a "
            + "fallback with '??'.";
    }
    return "Cannot interpolate a value of type '{types.display(analyzed)}'; only string, "
        + "integer, bool, enum, class, and JSON-serializable struct values are supported here. "
        + "Convert it with '.toString()' first.";
}

// The innermost element type an array bottoms out at, through nested arrays and the elements'
// nullable wrappers.
innermostElementOf(ArrayType array) -> Type {
    Type element = convert.coreOf(array.element());
    while (element is ArrayType) {
        element = convert.coreOf(element.element());
    }
    return element;
}

// Why a value of this array type has no text form, or null when it does. Elements format as
// struct serialization writes them, so a struct element is its JSON form even with its own
// 'toString'.
arrayTextIssue(ArrayType array) -> string? {
    Type element = innermostElementOf(array);
    if (convert.containsTypeParam(element)) {
        return null;
    }
    if (isJsonableLeaf(element) || types.isClassLike(element)) {
        return null;
    }
    if (isStructValue(element)) {
        return structJsonabilityIssue(element);
    }
    if (element is FunctionType) {
        return "Cannot interpolate a value of type '{types.display(array)}': its elements are "
            + "function values, which have no text form.";
    }
    return "Cannot interpolate a value of type '{types.display(array)}'; its element type "
        + "'{types.display(element)}' has no text form.";
}

// A value type, string, or enum that has a direct JSON form.
isJsonableLeaf(Type type) -> bool {
    if (convert.isIntegerType(type) || convert.isBoolType(type) || convert.isEnumLike(type)) {
        return true;
    }
    if (type is StringType) {
        return true;
    }
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Float || type.kind() == PrimitiveKind.Double;
    }
    return false;
}

// Why 'is' or 'as?' between these concrete types is malformed, always true, or never true, or
// null when the test is meaningful. The target is already known to be a plain class or
// interface shape.
public typeTestIssue(Type source, Type target, bool isCast) -> string? {
    string operator = "is";
    if (isCast) {
        operator = "as?";
    }
    // A written target is always a class or an interface, so these two arise only through a
    // type parameter's instantiation.
    if (target is OptionalType) {
        return "The target of '{operator}' resolves to '{types.display(target)}', which is "
            + "nullable, and '{operator}' never answers for null. Test against "
            + "'{types.display(convert.coreOf(target))}' instead.";
    }
    if (!types.isClassLike(target)) {
        return "The target of '{operator}' resolves to '{types.display(target)}', and only a "
            + "class or an interface can be tested at run time.";
    }
    if (source is OptionalType && source.inner() is OptionalType) {
        return "Cannot use '{operator}' on a value of type '{types.display(source)}', which is "
            + "nullable at more than one level, and '{operator}' looks through only one. Unwrap "
            + "one level first: check the value for null ('if (value != null)') or supply a "
            + "fallback ('value ?? null'), then test the '{types.display(source.inner())}' that "
            + "remains.";
    }
    Type sourceCore = convert.bareOf(source);
    if (!types.isClassLike(sourceCore)) {
        string action = "tested.";
        if (isCast) {
            action = "cast.";
        }
        string refused = "Cannot use '{operator}' on a value of type "
            + "'{types.display(source)}'; only class values can be {action}";
        if (types.bindingOf(sourceCore) != null && types.isInterfaceLike(target)
                && types.conformsTo(sourceCore, target)) {
            return refused + " '{types.display(sourceCore)}' does implement "
                + "'{types.display(target)}', but only as a generic bound: '{operator}' works "
                + "over a value that carries the interface, and a primitive is never wrapped in "
                + "one.";
        }
        return refused;
    }
    if (types.isSubclassOrConforms(sourceCore, target)) {
        if (!isCast && source is OptionalType) {
            return null;
        }
        if (isCast) {
            return "'as? {types.display(target)}' is not needed here: a value of type "
                + "'{types.display(source)}' always converts to '{types.display(target)}?'. "
                + "Use the value directly.";
        }
        return "A value of type '{types.display(source)}' is always a "
            + "'{types.display(target)}'; this 'is' test would always be true. Remove it.";
    }
    if (types.isInterfaceLike(sourceCore)) {
        return null;
    }
    if (types.isInterfaceLike(target)) {
        if (isFinalClass(sourceCore)) {
            string outcome = "This 'is' test would always be false.";
            if (isCast) {
                outcome = "This 'as?' cast would always be null.";
            }
            return "A value of type '{types.display(source)}' can never be a "
                + "'{types.display(target)}': '{types.display(sourceCore)}' is 'final' and "
                + "does not implement it. {outcome} Remove it.";
        }
        return null;
    }
    if (!types.isSubclassOf(target, sourceCore)) {
        string outcome = "this 'is' test would always be false.";
        if (isCast) {
            outcome = "this 'as?' cast would always be null.";
        }
        return "A value of type '{types.display(source)}' can never be a "
            + "'{types.display(target)}'; {outcome} Remove it.";
    }
    return null;
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

// Why values of this struct or array type cannot be compared with '==', or null when they can.
// Names the offending field's dotted path and its type.
public equalityComparabilityIssue(Type structType) -> string? {
    if (structType is ArrayType) {
        Type leaf = innermostElementOf(structType);
        if (convert.containsTypeParam(leaf)) {
            return null;
        }
        if (leaf is ExternalType || leaf is FunctionType) {
            return "'{types.display(structType)}' cannot be compared with '==': an array "
                + "compares element by element, and its element type '{types.display(leaf)}' "
                + "has no '=='; {noEqualityReason(leaf)}. Compare the elements you need "
                + "directly instead.";
        }
        if (isStructValue(leaf)) {
            let inElement = firstNonComparableField(leaf, new Set<Type>());
            if (inElement != null) {
                return "'{types.display(structType)}' cannot be compared with '==': an array "
                    + "compares element by element, and element field '{inElement.path()}' has "
                    + "type '{types.display(inElement.leaf())}', which has no '=='; "
                    + "{noEqualityReason(inElement.leaf())}. Compare the elements you need "
                    + "directly instead.";
            }
        }
        return null;
    }
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstNonComparableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    return "Struct '{authority.name()}' cannot be compared with '=='. Field '{found.path()}' "
        + "has type '{types.display(found.leaf())}', which has no '=='; "
        + "{noEqualityReason(found.leaf())}. Compare the fields you need directly instead.";
}

// Why two values of struct type 'structType' cannot serialize to JSON, or null when every field
// is JSON-able. Names the offending field's dotted path and its type.
public structJsonabilityIssue(Type structType) -> string? {
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstNonJsonableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    return "Struct '{authority.name()}' cannot be converted to a string. Field '{found.path()}' "
        + "has type '{types.display(found.leaf())}', which has no string form; only value types, "
        + "strings, enums, their nullable forms, and nested such structs serialize to JSON. "
        + "Convert or drop the field.";
}

// A struct field with no operator of its own: the dotted path from the compared struct down to
// it, and the offending leaf type it bottoms out at.
class OffendingField {
    string fieldPath;
    Type fieldLeaf;

    protected constructor(string path, Type leaf) {
        this.fieldPath = path;
        this.fieldLeaf = leaf;
    }

    protected path() -> string {
        return this.fieldPath;
    }

    protected leaf() -> Type {
        return this.fieldLeaf;
    }
}

// Why a leaf type has no '=='.
noEqualityReason(Type leaf) -> string {
    if (leaf is FunctionType) {
        return "a function value has no identity";
    }
    if (leaf is ArrayType) {
        return "an array compares element by element, and its elements have no '==' of "
            + "their own";
    }
    return "external types have no value equality";
}

// The first field, at any depth, whose type has no '=='. A field mentioning a type parameter is
// left for the per-instantiation replay.
firstNonComparableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (!visiting.add(structType)) {
        return null;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (element is ExternalType || element is FunctionType) {
                return new OffendingField(field.name(), core);
            }
            if (isStructValue(element)) {
                let inElement = firstNonComparableField(element, visiting);
                if (inElement != null) {
                    return new OffendingField(field.name(), core);
                }
            }
            continue;
        }
        if (core is ExternalType || core is FunctionType) {
            return new OffendingField(field.name(), core);
        }
        if (isStructValue(core)) {
            let nested = firstNonComparableField(core, visiting);
            if (nested != null) {
                return new OffendingField(field.name() + "." + nested.path(), nested.leaf());
            }
        }
    }
    return null;
}

// The first field, at any depth, with no JSON form. A field mentioning a type parameter is left
// for the per-instantiation replay.
firstNonJsonableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (!visiting.add(structType)) {
        return null;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (isJsonableLeaf(core)) {
            continue;
        }
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (isJsonableLeaf(element)) {
                continue;
            }
            if (isStructValue(element)) {
                let inElement = firstNonJsonableField(element, visiting);
                if (inElement == null) {
                    continue;
                }
                return new OffendingField(field.name() + "." + inElement.path(),
                    inElement.leaf());
            }
            return new OffendingField(field.name(), element);
        }
        if (isStructValue(core)) {
            let nested = firstNonJsonableField(core, visiting);
            if (nested != null) {
                return new OffendingField(field.name() + "." + nested.path(), nested.leaf());
            }
            continue;
        }
        return new OffendingField(field.name(), core);
    }
    return null;
}

// Why a freshly allocated array of this element type would not hold valid values, or null when it
// would. A reference element is offered the fill loop the wording names, because filling as the
// array is created is what makes it sound; a struct's own field says which one is at fault.
public arrayElementIssue(Type element, bool hasFillName, string fillName) -> string? {
    if (element is ErrorType || convert.isDefaultable(element)) {
        return null;
    }
    string shown = types.display(element);
    string hint = "";
    if (isReferenceElement(element)) {
        if (hasFillName) {
            return "An array of non-nullable '{shown}' must be filled as it is created: assign "
                + "it to a new variable and follow the declaration with `for (long i = 0; i < "
                + "{fillName}.length; i++) \{ {fillName}[i] = ...; \}` (the update may be "
                + "written 'i++', '++i', or 'i = i + 1'). Alternatively use '{shown}?[]' so "
                + "slots can start as null.";
        }
        hint = " Use '{shown}?[]' so freshly-allocated slots can start as null.";
    } else if (isStructValue(element)) {
        hint = offendingFieldHint(element, shown);
    }
    return "Cannot use '{shown}' as an array element type because freshly-allocated slots would "
        + "not be valid values of '{shown}'.{hint}";
}

offendingFieldHint(Type element, string shown) -> string {
    let fields = types.fieldsOf(element);
    if (fields == null) {
        return "";
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (field.hasDefault()) {
            continue;
        }
        if (field.isConst()) {
            return " Field '{field.name()}' of '{shown}' is 'const' with no default value, so a "
                + "freshly-allocated slot would hold a zero it was never assigned. Give the "
                + "field a default value.";
        }
        if (!convert.isDefaultable(field.type())) {
            return " Field '{field.name()}' of '{shown}' has type "
                + "'{types.display(field.type())}' which cannot start as a default zero value. "
                + "Make that field nullable.";
        }
    }
    return "";
}

isReferenceElement(Type element) -> bool {
    return types.isClassLike(element) || element is ArrayType || element is StringType
        || element is ExternalType;
}

isStructValue(Type type) -> bool {
    if (type is StructType) {
        return true;
    }
    if (type is InstantiationType) {
        return type.template() is StructType;
    }
    return false;
}
