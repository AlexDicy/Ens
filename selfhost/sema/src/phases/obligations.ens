// Per-instantiation validation of the judgments a generic declaration defers because a type
// mentions a type parameter. Once every body is checked, each deferred judgment replays against
// the concrete arguments of every instantiation that occurs, cascading through generic calls.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import RelatedLocation from support.diagnostics;
import support.diagnostics;
import model.capabilities;
import model.convert;
import model.hierarchy;
import Signature from model.typemembers;
import MemberConstraint from model.typemembers;
import TypeNames from model.typenames;
import QuotedCode from model.typenames;
import TypeNameDirectory from model.typenames;
import Type from model.types;
import TypeStore from model.types;
import DeclaredType from model.types;
import InstantiationType from model.types;
import TypeParamType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import ErrorType from model.types;
import Iterable from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// One deferred judgment: its position in its template's file, and the open types to re-judge
// once concrete type arguments are supplied. One recorded inside a conditional member carries that
// member's constraints as guards, so it is only judged for instantiations the member exists on.
public sealed abstract class Obligation {
    Span obligationSpan;
    MemberConstraint[] obligationGuards;
    string obligationOwnerDisplay;

    protected constructor(Span span) {
        this.obligationSpan = span;
        this.obligationGuards = [];
        this.obligationOwnerDisplay = "";
    }

    protected span() -> Span {
        return this.obligationSpan;
    }

    public setGuards(MemberConstraint[] guards) {
        this.obligationGuards = guards;
    }

    protected guards() -> MemberConstraint[] {
        return this.obligationGuards;
    }

    // The generic this judgment is in, at its own type parameters, as 'Slots<T>'. The note
    // beside a refusal names it, so a reader sees which generic the line belongs to.
    public setOwnerDisplay(string display) {
        this.obligationOwnerDisplay = display;
    }

    protected ownerDisplay() -> string {
        return this.obligationOwnerDisplay;
    }
}

public class InterpolationObligation extends Obligation {
    Type holeType;

    public constructor(Type hole, Span span) {
        super(span);
        this.holeType = hole;
    }

    protected hole() -> Type {
        return this.holeType;
    }
}

public class TypeTestObligation extends Obligation {
    Type testSource;
    Type testTarget;
    bool castForm;

    public constructor(Type source, Type target, bool isCast, Span span) {
        super(span);
        this.testSource = source;
        this.testTarget = target;
        this.castForm = isCast;
    }

    protected source() -> Type {
        return this.testSource;
    }

    protected target() -> Type {
        return this.testTarget;
    }

    protected isCast() -> bool {
        return this.castForm;
    }
}

public class EqualityObligation extends Obligation {
    Type comparedStruct;

    public constructor(Type structType, Span span) {
        super(span);
        this.comparedStruct = structType;
    }

    protected structType() -> Type {
        return this.comparedStruct;
    }
}

// 'value.hash()' on a receiver whose type still names a type parameter and whose bounds declare
// no 'hash'; each instantiation settles whether the concrete receiver has one.
public class HashObligation extends Obligation {
    Type hashedReceiver;

    public constructor(Type receiver, Span span) {
        super(span);
        this.hashedReceiver = receiver;
    }

    protected receiver() -> Type {
        return this.hashedReceiver;
    }
}

// A keyed standard container instantiated at a key that still names a type parameter.
public class KeyTypeObligation extends Obligation {
    DeclaredType keyedContainer;
    Type openKey;

    public constructor(DeclaredType container, Type key, Span span) {
        super(span);
        this.keyedContainer = container;
        this.openKey = key;
    }

    protected container() -> DeclaredType {
        return this.keyedContainer;
    }

    protected key() -> Type {
        return this.openKey;
    }
}

// 'new T[n]', whose element type only determines whether a freshly allocated slot is a valid value once
// the argument is supplied.
public class ArrayElementObligation extends Obligation {
    Type elementType;

    public constructor(Type element, Span span) {
        super(span);
        this.elementType = element;
    }

    protected element() -> Type {
        return this.elementType;
    }
}

// The mention or the call that supplied a generic's type arguments: its file, its span, and how
// the instantiation written there reads. A refusal those arguments earn is reported at that
// line and names that instantiation, however many generics it passed through, because that is
// what its author wrote and can change.
public final class Origin {
    string originFile;
    Span originSpan;
    string originDisplay;

    public constructor(this.originFile, this.originSpan, this.originDisplay);

    public file() -> string {
        return this.originFile;
    }

    public span() -> Span {
        return this.originSpan;
    }

    // The instantiation in quotes as it was written, 'Outer<Path>', which every refusal reported here
    // names.
    public display() -> string {
        return this.originDisplay;
    }
}

// One generic instantiation a declaration mentions, as written or inferred, plus the constraint
// scope active when it was resolved. A concrete mention seeds its template's obligations directly.
// An open one, its arguments still naming the enclosing owner's parameters, replays per owner
// assignment, and one recorded inside a conditional member replays only for assignments that
// satisfy the member's constraints. Nothing else decides which instantiations are judged.
public final class InstantiationMention {
    InstantiationType mentionedInstantiation;
    Origin mentionOrigin;
    GreenNode? mentionGuardOwner;
    MemberConstraint[] mentionGuards;

    public constructor(this.mentionedInstantiation, this.mentionOrigin, this.mentionGuardOwner,
        this.mentionGuards);

    public instantiation() -> InstantiationType {
        return this.mentionedInstantiation;
    }

    // Where this mention was written and how it reads there, which a refusal its arguments earn
    // is reported at and names.
    public origin() -> Origin {
        return this.mentionOrigin;
    }

    public guardOwner() -> GreenNode? {
        return this.mentionGuardOwner;
    }

    public guards() -> MemberConstraint[] {
        return this.mentionGuards;
    }
}

// A throws list written on a function type, recorded by the resolver for the checks phase to
// validate under the constraint scope it was resolved in.
public final class FunctionThrowsMention {
    Type[] mentionedTypes;
    Span[] mentionedSpans;
    GreenNode? mentionScopeOwner;
    MemberConstraint[] mentionScopeConstraints;

    public constructor(this.mentionedTypes, this.mentionedSpans, this.mentionScopeOwner,
        this.mentionScopeConstraints);

    public thrownTypes() -> Type[] {
        return this.mentionedTypes;
    }

    public spans() -> Span[] {
        return this.mentionedSpans;
    }

    public scopeOwner() -> GreenNode? {
        return this.mentionScopeOwner;
    }

    public scopeConstraints() -> MemberConstraint[] {
        return this.mentionScopeConstraints;
    }
}

// A generic call whose type arguments still mention a type parameter of the enclosing owner;
// it names a concrete callee instantiation only once the owner's own arguments are supplied. A call
// written inside a conditional member carries the member's constraints as guards.
class OpenCall {
    protected Signature callee;
    protected Type[] arguments;
    protected MemberConstraint[] guards;

    protected constructor(this.callee, this.arguments, this.guards);
}

class ConcreteCall {
    protected Signature callee;
    protected Type[] arguments;
    protected Origin origin;

    protected constructor(this.callee, this.arguments, this.origin);
}

// Everything recorded against one generic owner: a class or struct template, or a generic
// function, identified by its declaration node.
class OwnerEntry {
    string entryFile;
    List<Obligation> entryObligations;
    List<OpenCall> entryOpenCalls;

    protected constructor(string filePath) {
        this.entryFile = filePath;
        this.entryObligations = new List<Obligation>();
        this.entryOpenCalls = new List<OpenCall>();
    }

    protected file() -> string {
        return this.entryFile;
    }

    protected obligations() -> List<Obligation> {
        return this.entryObligations;
    }

    protected openCalls() -> List<OpenCall> {
        return this.entryOpenCalls;
    }

    protected append(OwnerEntry other) {
        this.entryObligations.pushAll(other.entryObligations);
        this.entryOpenCalls.pushAll(other.entryOpenCalls);
    }
}

// Collects deferred judgments and generic calls while one module's types are resolved and bodies
// are checked; the pass reads the modules' registries appended into one. An owner's file is where
// its declaration is, which is also where every mention of its type parameters is.
public final class ObligationRegistry {
    Map<GreenNode, OwnerEntry> owners;
    List<ConcreteCall> concreteCalls;

    public constructor() {
        this.owners = new Map<GreenNode, OwnerEntry>();
        this.concreteCalls = new List<ConcreteCall>();
    }

    public recordObligation(GreenNode owner, string filePath, Obligation obligation) {
        this.entryFor(owner, filePath).obligations().push(obligation);
    }

    public recordOpenCall(GreenNode owner, string filePath, Signature callee, Type[] arguments,
                   MemberConstraint[] guards) {
        this.entryFor(owner, filePath).openCalls().push(new OpenCall(callee, arguments, guards));
    }

    public recordConcreteCall(Signature callee, Type[] arguments, Origin origin) {
        this.concreteCalls.push(new ConcreteCall(callee, arguments, origin));
    }

    // Appends another registry's records after this one's; an owner both hold keeps one entry.
    public append(ObligationRegistry other) {
        for (let entry in other.owners) {
            this.entryFor(entry.key, entry.value.file()).append(entry.value);
        }
        this.concreteCalls.pushAll(other.concreteCalls);
    }

    protected entryOf(GreenNode owner) -> OwnerEntry? {
        return this.owners.get(owner);
    }

    protected allOwners() -> Iterable<GreenNode> {
        return this.owners.keys();
    }

    protected allConcreteCalls() -> List<ConcreteCall> {
        return this.concreteCalls;
    }

    entryFor(GreenNode owner, string filePath) -> OwnerEntry {
        let existing = this.owners.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new OwnerEntry(filePath);
        this.owners.set(owner, created);
        return created;
    }
}

// Runs every recorded obligation against every concrete type-argument assignment its owner
// receives, and returns the diagnostics, each anchored where the type arguments were written,
// naming the instantiation written there, and carrying the generic's own line as a note. The
// mentions carry every instantiation the program's declarations reference, with the constraint
// scope each was resolved under. A refusal reads with the names of the file it lands in, so the
// message uses the consumer's and the note inside the generic uses the generic file's own.
public check(TypeStore store, TypeNameDirectory names, ObligationRegistry registry,
             List<InstantiationMention> mentions) -> FileDiagnostic[] {
    let pass = new ObligationPass(store, names, registry, mentions);
    return pass.run();
}

// One concrete type-argument assignment for one owner, plus the mention or call that supplied
// the arguments and how many cascade steps produced it.
class Assignment {
    protected GreenNode owner;
    protected Type[] arguments;
    protected Origin origin;
    protected long depth;

    protected constructor(this.owner, this.arguments, this.origin, this.depth);
}

class AssignmentKey {
    GreenNode keyOwner;
    Type[] keyArguments;

    protected constructor(GreenNode owner, Type[] arguments) {
        this.keyOwner = owner;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyOwner.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(AssignmentKey other) -> bool {
        if (this.keyOwner != other.keyOwner) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

class ObligationPass {
    TypeStore store;
    TypeNameDirectory names;
    ObligationRegistry registry;
    List<InstantiationMention> mentions;
    List<FileDiagnostic> collected;
    Set<AssignmentKey> seen;
    List<Assignment> worklist;
    Map<GreenNode, List<InstantiationMention>> openMentionsByOwner;
    Set<GreenNode> productive;

    protected constructor(TypeStore store, TypeNameDirectory names, ObligationRegistry registry,
                List<InstantiationMention> mentions) {
        this.store = store;
        this.names = names;
        this.registry = registry;
        this.mentions = mentions;
        this.collected = new List<FileDiagnostic>();
        this.seen = new Set<AssignmentKey>();
        this.worklist = new List<Assignment>();
        this.openMentionsByOwner = new Map<GreenNode, List<InstantiationMention>>();
        this.productive = new Set<GreenNode>();
    }

    // A concrete mention seeds its template's assignment directly; an open one becomes an edge
    // per owner its arguments name, replayed under its guards. Fill-derived instantiations are
    // reached transitively - the mention of the owner that fills them plus the filled template's
    // own mentions - so the store's instantiation list is never consulted: it also holds the
    // substituted signatures of excluded conditional members, which must not be judged.
    protected run() -> FileDiagnostic[] {
        let concreteMentions = new List<InstantiationMention>();
        for (long i = 0; i < this.mentions.length(); i++) {
            let mention = this.mentions.get(i);
            let owners = new Set<GreenNode>();
            for (let argument in mention.instantiation().arguments()) {
                collectOwners(argument, owners);
            }
            if (owners.length() == 0) {
                concreteMentions.push(mention);
            }
            for (let owner in owners) {
                this.openMentionsFor(owner).push(mention);
            }
        }
        this.computeProductive();
        for (long i = 0; i < concreteMentions.length(); i++) {
            let mention = concreteMentions.get(i);
            let instantiation = mention.instantiation();
            if (capabilities.hasRefusedKey(instantiation.template(), instantiation.arguments(),
                    this.namesAt(mention.origin()))) {
                continue;
            }
            this.push(instantiation.template().declaration(), instantiation.arguments(),
                mention.origin(), 0);
        }
        for (let call in this.registry.allConcreteCalls().toArray()) {
            let declaration = call.callee.declaration();
            if (declaration != null) {
                this.push(declaration, call.arguments, call.origin, 0);
            }
        }
        while (this.worklist.length() > 0) {
            this.process(this.worklist.pop());
        }
        return diagnostics.sorted(this.collected);
    }

    openMentionsFor(GreenNode owner) -> List<InstantiationMention> {
        let existing = this.openMentionsByOwner.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new List<InstantiationMention>();
        this.openMentionsByOwner.set(owner, created);
        return created;
    }

    // An owner is productive when one of its assignments can surface a diagnostic: it has
    // obligations of its own, or an open call or open instantiation in its bodies leads to a
    // productive owner. Everything else is pruned so an obligation-free program costs nothing.
    computeProductive() {
        for (let owner in this.registry.allOwners()) {
            let entry = this.registry.entryOf(owner);
            if (entry != null && entry.obligations().length() > 0) {
                this.productive.add(owner);
            }
        }
        bool progress = true;
        while (progress) {
            progress = false;
            for (let owner in this.registry.allOwners()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
            for (let owner in this.openMentionsByOwner.keys()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
        }
    }

    reachesProductive(GreenNode owner) -> bool {
        let entry = this.registry.entryOf(owner);
        if (entry != null) {
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let declaration = entry.openCalls().get(i).callee.declaration();
                if (declaration != null && this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let declaration = openMentions.get(i).instantiation().template().declaration();
                if (this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        return false;
    }

    // Queues one concrete assignment, once, for productive owners only. A cascade hands the
    // origin down as it stands, so a judgment reached through any depth of generics is reported
    // at the line a reader wrote and names the instantiation they wrote there. Cascades past the
    // depth limit come from a polymorphically recursive generic call chain that would never
    // close; the judged prefix is deep enough for any real code.
    push(GreenNode owner, Type[] arguments, Origin origin, long depth) {
        if (depth > Limits.cascadeDepth) {
            return;
        }
        if (!this.productive.contains(owner)) {
            return;
        }
        if (!this.seen.add(new AssignmentKey(owner, arguments))) {
            return;
        }
        this.worklist.push(new Assignment(owner, arguments, origin, depth));
    }

    process(Assignment assignment) {
        let entry = this.registry.entryOf(assignment.owner);
        if (entry != null) {
            for (long i = 0; i < entry.obligations().length(); i++) {
                this.judge(entry, assignment, entry.obligations().get(i));
            }
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let call = entry.openCalls().get(i);
                let declaration = call.callee.declaration();
                if (declaration == null || !this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.guardsHold(call.guards, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(call.arguments, assignment);
                if (substituted != null) {
                    this.push(declaration, substituted, assignment.origin,
                        assignment.depth + 1);
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(assignment.owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let mention = openMentions.get(i);
                let instantiation = mention.instantiation();
                let declaration = instantiation.template().declaration();
                if (!this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.mentionGuardsHold(mention, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(instantiation.arguments(), assignment);
                if (substituted != null && !capabilities.hasRefusedKey(instantiation.template(), substituted,
                            this.namesAt(assignment.origin))) {
                    this.push(declaration, substituted, assignment.origin,
                        assignment.depth + 1);
                }
            }
        }
    }

    // A guarded mention replays only where the conditional member that wrote it exists; the guards
    // speak about the guard owner's parameters, so they only apply to that owner's own assignments.
    mentionGuardsHold(InstantiationMention mention, Assignment assignment) -> bool {
        let owner = mention.guardOwner();
        if (owner == null || owner != assignment.owner) {
            return true;
        }
        return this.guardsHold(mention.guards(), assignment);
    }

    // The arguments with the assignment's substitution applied, or null when one still
    // mentions a type parameter of some other owner.
    substituteAll(Type[] arguments, Assignment assignment) -> Type[]? {
        let substituted = new List<Type>();
        for (let argument in arguments) {
            let concrete = this.store.substitute(argument, assignment.owner,
                assignment.arguments);
            if (convert.containsTypeParam(concrete)) {
                return null;
            }
            substituted.push(concrete);
        }
        return substituted.toArray();
    }

    // True when the assignment satisfies every guard, meaning the conditional member the
    // obligation was recorded in exists for it; an unguarded obligation always holds.
    guardsHold(MemberConstraint[] guards, Assignment assignment) -> bool {
        for (let guard in guards) {
            long index = guard.parameterIndex();
            if (index >= assignment.arguments.length) {
                continue;
            }
            Type argument = assignment.arguments[index];
            for (let bound in guard.bounds()) {
                Type here = this.store.substitute(bound, assignment.owner,
                    assignment.arguments);
                if (!hierarchy.satisfiesBound(argument, here, [])) {
                    return false;
                }
            }
        }
        return true;
    }

    judge(OwnerEntry entry, Assignment assignment, Obligation obligation) {
        if (!this.guardsHold(obligation.guards(), assignment)) {
            return;
        }
        // The refusal lands where the type arguments were written and the note lands inside the
        // generic, so each of the two reads with the names of its own file.
        let whereWritten = this.namesAt(assignment.origin);
        let insideGeneric = this.names.namesFor(entry.file());
        switch (obligation) {
            is InterpolationObligation hole -> {
                let concrete = this.substituteOne(hole.hole(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.interpolationIssue(assignment.origin.display(), concrete, whereWritten),
                        "{obligation.ownerDisplay()} interpolates a value of type "
                            + "{insideGeneric.quoted(hole.hole())} here");
                }
            },
            is TypeTestObligation test -> {
                let source = this.substituteOne(test.source(), assignment);
                let target = this.substituteOne(test.target(), assignment);
                if (source != null && target != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.typeTestIssue(assignment.origin.display(), source, target,
                            test.isCast(), whereWritten),
                        typeTestNote(obligation.ownerDisplay(), test.source(), test.target(),
                            test.isCast(), insideGeneric));
                }
            },
            is EqualityObligation equality -> {
                let concrete = this.substituteOne(equality.structType(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.equalityComparabilityIssue(assignment.origin.display(), concrete,
                            whereWritten),
                        "{obligation.ownerDisplay()} compares two values of type "
                            + "{insideGeneric.quoted(equality.structType())} with '==' here");
                }
            },
            is HashObligation hashed -> {
                let concrete = this.substituteOne(hashed.receiver(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.hashabilityIssue(assignment.origin.display(), concrete, whereWritten),
                        "{obligation.ownerDisplay()} calls 'hash()' on a value of type "
                            + "{insideGeneric.quoted(hashed.receiver())} here");
                }
            },
            is KeyTypeObligation keyed -> {
                let concrete = this.substituteOne(keyed.key(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.keyTypeIssue(assignment.origin.display(), keyed.container(), concrete,
                            whereWritten),
                        "{insideGeneric.quotedName(keyed.container())} is keyed by "
                            + "{insideGeneric.quoted(keyed.key())} here");
                }
            },
            is ArrayElementObligation created -> {
                let concrete = this.substituteOne(created.element(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        capabilities.arrayElementIssue(assignment.origin.display(), concrete, whereWritten),
                        "{obligation.ownerDisplay()} creates an array of "
                            + "{insideGeneric.quoted(created.element())} here");
                }
            },
        }
    }

    // The names of the file a refusal these type arguments earn is reported in.
    namesAt(Origin origin) -> TypeNames {
        return this.names.namesFor(origin.file());
    }

    substituteOne(Type open, Assignment assignment) -> Type? {
        let concrete = this.store.substitute(open, assignment.owner, assignment.arguments);
        if (concrete is ErrorType || convert.containsTypeParam(concrete)) {
            return null;
        }
        return concrete;
    }

    // Records a refusal at the line that wrote the type arguments, with the generic's own line
    // as the note beside it.
    report(OwnerEntry entry, Assignment assignment, Span span, string? issue, string note) {
        if (issue != null) {
            this.collected.push(new FileDiagnostic(assignment.origin.file(), issue,
                assignment.origin.span(), new RelatedLocation(entry.file(), span, note)));
        }
    }
}

// The note beside a refused type test, naming the generic and the types its own line was
// written with.
typeTestNote(string owner, Type source, Type target, bool isCast,
             TypeNames names) -> string {
    if (isCast) {
        return "{owner} casts a value of type {names.quoted(source)} to "
            + "{names.quoted(target)} here";
    }
    return "{owner} tests a value of type {names.quoted(source)} against "
        + "{names.quoted(target)} here";
}

final class Limits {
    protected static const long cascadeDepth = 200;
}

// The generic declarations whose type parameters a type names.
public collectOwners(Type type, Set<GreenNode> owners) {
    switch (type) {
        is TypeParamType parameter -> {
            owners.add(parameter.owner());
        },
        is OptionalType optional -> {
            collectOwners(optional.inner(), owners);
        },
        is ArrayType array -> {
            collectOwners(array.element(), owners);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                collectOwners(parameter, owners);
            }
            collectOwners(functionType.returnType(), owners);
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                collectOwners(argument, owners);
            }
        },
        default -> { },
    }
}

// A generic call in quotes as a diagnostic reads it, 'sort<Path>', from the function's name and the
// concrete arguments it was given.
public quotedCall(string name, Type[] arguments, TypeNames names) -> string {
    let code = new QuotedCode();
    code.write("{name}<");
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            code.write(", ");
        }
        code.writeType(arguments[i]);
    }
    code.write(">");
    return code.quotedFor(names);
}
