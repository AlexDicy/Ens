// Per-instantiation validation of the judgments a generic declaration defers because a type
// mentions a type parameter. Once every body is checked, each deferred judgment replays against
// the concrete arguments of every instantiation that occurs, cascading through generic calls.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import RelatedLocation from support.diagnostics;
import support.diagnostics;
import model.convert;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import TypeNames from model.types;
import TypeNameDirectory from model.types;
import Signature from model.types;
import DeclaredType from model.types;
import InstantiationType from model.types;
import TypeParamType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import ClassType from model.types;
import ExternalType from model.types;
import ErrorType from model.types;
import StringType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import Field from model.types;
import MemberConstraint from model.types;
import Iterable from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// One deferred judgment: its position in its template's file, and the open types to re-judge
// once concrete type arguments are supplied. One recorded inside a conditional member carries that
// member's constraints as guards, so it is only judged for instantiations the member exists on.
public sealed abstract class Obligation {
    Span obligationSpan;
    MemberConstraint[] obligationGuards;
    string obligationOwnerDisplay;

    protected constructor(Span span) {
        this.obligationSpan = span;
        this.obligationGuards = [];
        this.obligationOwnerDisplay = "";
    }

    protected span() -> Span {
        return this.obligationSpan;
    }

    public setGuards(MemberConstraint[] guards) {
        this.obligationGuards = guards;
    }

    protected guards() -> MemberConstraint[] {
        return this.obligationGuards;
    }

    // The generic this judgment is in, at its own type parameters, as 'Slots<T>'. The note
    // beside a refusal names it, so a reader sees which generic the line belongs to.
    public setOwnerDisplay(string display) {
        this.obligationOwnerDisplay = display;
    }

    protected ownerDisplay() -> string {
        return this.obligationOwnerDisplay;
    }
}

public class InterpolationObligation extends Obligation {
    Type holeType;

    public constructor(Type hole, Span span) {
        super(span);
        this.holeType = hole;
    }

    protected hole() -> Type {
        return this.holeType;
    }
}

public class TypeTestObligation extends Obligation {
    Type testSource;
    Type testTarget;
    bool castForm;

    public constructor(Type source, Type target, bool isCast, Span span) {
        super(span);
        this.testSource = source;
        this.testTarget = target;
        this.castForm = isCast;
    }

    protected source() -> Type {
        return this.testSource;
    }

    protected target() -> Type {
        return this.testTarget;
    }

    protected isCast() -> bool {
        return this.castForm;
    }
}

public class EqualityObligation extends Obligation {
    Type comparedStruct;

    public constructor(Type structType, Span span) {
        super(span);
        this.comparedStruct = structType;
    }

    protected structType() -> Type {
        return this.comparedStruct;
    }
}

// 'value.hash()' on a receiver whose type still names a type parameter and whose bounds declare
// no 'hash'; each instantiation settles whether the concrete receiver has one.
public class HashObligation extends Obligation {
    Type hashedReceiver;

    public constructor(Type receiver, Span span) {
        super(span);
        this.hashedReceiver = receiver;
    }

    protected receiver() -> Type {
        return this.hashedReceiver;
    }
}

// A keyed standard container instantiated at a key that still names a type parameter.
public class KeyTypeObligation extends Obligation {
    DeclaredType keyedContainer;
    Type openKey;

    public constructor(DeclaredType container, Type key, Span span) {
        super(span);
        this.keyedContainer = container;
        this.openKey = key;
    }

    protected container() -> DeclaredType {
        return this.keyedContainer;
    }

    protected key() -> Type {
        return this.openKey;
    }
}

// 'new T[n]', whose element type only determines whether a freshly allocated slot is a valid value once
// the argument is supplied.
public class ArrayElementObligation extends Obligation {
    Type elementType;

    public constructor(Type element, Span span) {
        super(span);
        this.elementType = element;
    }

    protected element() -> Type {
        return this.elementType;
    }
}

// The mention or the call that supplied a generic's type arguments: its file, its span, and how
// the instantiation written there reads. A refusal those arguments earn is reported at that
// line and names that instantiation, however many generics it passed through, because that is
// what its author wrote and can change.
public final class Origin {
    string originFile;
    Span originSpan;
    string originDisplay;

    public constructor(this.originFile, this.originSpan, this.originDisplay);

    public file() -> string {
        return this.originFile;
    }

    public span() -> Span {
        return this.originSpan;
    }

    // The instantiation as it was written, 'Outer<Path>', which every refusal reported here names.
    public display() -> string {
        return this.originDisplay;
    }
}

// One generic instantiation a declaration mentions, as written or inferred, plus the constraint
// scope active when it was resolved. A concrete mention seeds its template's obligations directly.
// An open one, its arguments still naming the enclosing owner's parameters, replays per owner
// assignment, and one recorded inside a conditional member replays only for assignments that
// satisfy the member's constraints. Nothing else decides which instantiations are judged.
public final class InstantiationMention {
    InstantiationType mentionedInstantiation;
    Origin mentionOrigin;
    GreenNode? mentionGuardOwner;
    MemberConstraint[] mentionGuards;

    public constructor(this.mentionedInstantiation, this.mentionOrigin, this.mentionGuardOwner,
        this.mentionGuards);

    public instantiation() -> InstantiationType {
        return this.mentionedInstantiation;
    }

    // Where this mention was written and how it reads there, which a refusal its arguments earn
    // is reported at and names.
    public origin() -> Origin {
        return this.mentionOrigin;
    }

    public guardOwner() -> GreenNode? {
        return this.mentionGuardOwner;
    }

    public guards() -> MemberConstraint[] {
        return this.mentionGuards;
    }
}

// A throws list written on a function type, recorded by the resolver for the checks phase to
// validate under the constraint scope it was resolved in.
public final class FunctionThrowsMention {
    Type[] mentionedTypes;
    Span[] mentionedSpans;
    GreenNode? mentionScopeOwner;
    MemberConstraint[] mentionScopeConstraints;

    public constructor(this.mentionedTypes, this.mentionedSpans, this.mentionScopeOwner,
        this.mentionScopeConstraints);

    public thrownTypes() -> Type[] {
        return this.mentionedTypes;
    }

    public spans() -> Span[] {
        return this.mentionedSpans;
    }

    public scopeOwner() -> GreenNode? {
        return this.mentionScopeOwner;
    }

    public scopeConstraints() -> MemberConstraint[] {
        return this.mentionScopeConstraints;
    }
}

// A generic call whose type arguments still mention a type parameter of the enclosing owner;
// it names a concrete callee instantiation only once the owner's own arguments are supplied. A call
// written inside a conditional member carries the member's constraints as guards.
class OpenCall {
    protected Signature callee;
    protected Type[] arguments;
    protected MemberConstraint[] guards;

    protected constructor(this.callee, this.arguments, this.guards);
}

class ConcreteCall {
    protected Signature callee;
    protected Type[] arguments;
    protected Origin origin;

    protected constructor(this.callee, this.arguments, this.origin);
}

// Everything recorded against one generic owner: a class or struct template, or a generic
// function, identified by its declaration node.
class OwnerEntry {
    string entryFile;
    List<Obligation> entryObligations;
    List<OpenCall> entryOpenCalls;

    protected constructor(string filePath) {
        this.entryFile = filePath;
        this.entryObligations = new List<Obligation>();
        this.entryOpenCalls = new List<OpenCall>();
    }

    protected file() -> string {
        return this.entryFile;
    }

    protected obligations() -> List<Obligation> {
        return this.entryObligations;
    }

    protected openCalls() -> List<OpenCall> {
        return this.entryOpenCalls;
    }

    protected append(OwnerEntry other) {
        this.entryObligations.pushAll(other.entryObligations);
        this.entryOpenCalls.pushAll(other.entryOpenCalls);
    }
}

// Collects deferred judgments and generic calls while one module's types are resolved and bodies
// are checked; the pass reads the modules' registries appended into one. An owner's file is where
// its declaration is, which is also where every mention of its type parameters is.
public final class ObligationRegistry {
    Map<GreenNode, OwnerEntry> owners;
    List<ConcreteCall> concreteCalls;

    public constructor() {
        this.owners = new Map<GreenNode, OwnerEntry>();
        this.concreteCalls = new List<ConcreteCall>();
    }

    public recordObligation(GreenNode owner, string filePath, Obligation obligation) {
        this.entryFor(owner, filePath).obligations().push(obligation);
    }

    public recordOpenCall(GreenNode owner, string filePath, Signature callee, Type[] arguments,
                   MemberConstraint[] guards) {
        this.entryFor(owner, filePath).openCalls().push(new OpenCall(callee, arguments, guards));
    }

    public recordConcreteCall(Signature callee, Type[] arguments, Origin origin) {
        this.concreteCalls.push(new ConcreteCall(callee, arguments, origin));
    }

    // Appends another registry's records after this one's; an owner both hold keeps one entry.
    public append(ObligationRegistry other) {
        for (let entry in other.owners) {
            this.entryFor(entry.key, entry.value.file()).append(entry.value);
        }
        this.concreteCalls.pushAll(other.concreteCalls);
    }

    protected entryOf(GreenNode owner) -> OwnerEntry? {
        return this.owners.get(owner);
    }

    protected allOwners() -> Iterable<GreenNode> {
        return this.owners.keys();
    }

    protected allConcreteCalls() -> List<ConcreteCall> {
        return this.concreteCalls;
    }

    entryFor(GreenNode owner, string filePath) -> OwnerEntry {
        let existing = this.owners.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new OwnerEntry(filePath);
        this.owners.set(owner, created);
        return created;
    }
}

// Runs every recorded obligation against every concrete type-argument assignment its owner
// receives, and returns the diagnostics, each anchored where the type arguments were written,
// naming the instantiation written there, and carrying the generic's own line as a note. The
// mentions carry every instantiation the program's declarations reference, with the constraint
// scope each was resolved under. A refusal reads with the names of the file it lands in, so the
// message uses the consumer's and the note inside the generic uses the generic file's own.
public check(TypeStore store, TypeNameDirectory names, ObligationRegistry registry,
             List<InstantiationMention> mentions) -> FileDiagnostic[] {
    let pass = new ObligationPass(store, names, registry, mentions);
    return pass.run();
}

// One concrete type-argument assignment for one owner, plus the mention or call that supplied
// the arguments and how many cascade steps produced it.
class Assignment {
    protected GreenNode owner;
    protected Type[] arguments;
    protected Origin origin;
    protected long depth;

    protected constructor(this.owner, this.arguments, this.origin, this.depth);
}

class AssignmentKey {
    GreenNode keyOwner;
    Type[] keyArguments;

    protected constructor(GreenNode owner, Type[] arguments) {
        this.keyOwner = owner;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyOwner.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(AssignmentKey other) -> bool {
        if (this.keyOwner != other.keyOwner) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

class ObligationPass {
    TypeStore store;
    TypeNameDirectory names;
    ObligationRegistry registry;
    List<InstantiationMention> mentions;
    List<FileDiagnostic> collected;
    Set<AssignmentKey> seen;
    List<Assignment> worklist;
    Map<GreenNode, List<InstantiationMention>> openMentionsByOwner;
    Set<GreenNode> productive;

    protected constructor(TypeStore store, TypeNameDirectory names, ObligationRegistry registry,
                List<InstantiationMention> mentions) {
        this.store = store;
        this.names = names;
        this.registry = registry;
        this.mentions = mentions;
        this.collected = new List<FileDiagnostic>();
        this.seen = new Set<AssignmentKey>();
        this.worklist = new List<Assignment>();
        this.openMentionsByOwner = new Map<GreenNode, List<InstantiationMention>>();
        this.productive = new Set<GreenNode>();
    }

    // A concrete mention seeds its template's assignment directly; an open one becomes an edge
    // per owner its arguments name, replayed under its guards. Fill-derived instantiations are
    // reached transitively - the mention of the owner that fills them plus the filled template's
    // own mentions - so the store's instantiation list is never consulted: it also holds the
    // substituted signatures of excluded conditional members, which must not be judged.
    protected run() -> FileDiagnostic[] {
        let concreteMentions = new List<InstantiationMention>();
        for (long i = 0; i < this.mentions.length(); i++) {
            let mention = this.mentions.get(i);
            let owners = new Set<GreenNode>();
            for (let argument in mention.instantiation().arguments()) {
                collectOwners(argument, owners);
            }
            if (owners.length() == 0) {
                concreteMentions.push(mention);
            }
            for (let owner in owners) {
                this.openMentionsFor(owner).push(mention);
            }
        }
        this.computeProductive();
        for (long i = 0; i < concreteMentions.length(); i++) {
            let mention = concreteMentions.get(i);
            let instantiation = mention.instantiation();
            if (hasRefusedKey(instantiation.template(), instantiation.arguments(),
                    this.namesAt(mention.origin()))) {
                continue;
            }
            this.push(instantiation.template().declaration(), instantiation.arguments(),
                mention.origin(), 0);
        }
        for (let call in this.registry.allConcreteCalls().toArray()) {
            let declaration = call.callee.declaration();
            if (declaration != null) {
                this.push(declaration, call.arguments, call.origin, 0);
            }
        }
        while (this.worklist.length() > 0) {
            this.process(this.worklist.pop());
        }
        return diagnostics.sorted(this.collected);
    }

    openMentionsFor(GreenNode owner) -> List<InstantiationMention> {
        let existing = this.openMentionsByOwner.get(owner);
        if (existing != null) {
            return existing;
        }
        let created = new List<InstantiationMention>();
        this.openMentionsByOwner.set(owner, created);
        return created;
    }

    // An owner is productive when one of its assignments can surface a diagnostic: it has
    // obligations of its own, or an open call or open instantiation in its bodies leads to a
    // productive owner. Everything else is pruned so an obligation-free program costs nothing.
    computeProductive() {
        for (let owner in this.registry.allOwners()) {
            let entry = this.registry.entryOf(owner);
            if (entry != null && entry.obligations().length() > 0) {
                this.productive.add(owner);
            }
        }
        bool progress = true;
        while (progress) {
            progress = false;
            for (let owner in this.registry.allOwners()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
            for (let owner in this.openMentionsByOwner.keys()) {
                if (!this.productive.contains(owner) && this.reachesProductive(owner)) {
                    this.productive.add(owner);
                    progress = true;
                }
            }
        }
    }

    reachesProductive(GreenNode owner) -> bool {
        let entry = this.registry.entryOf(owner);
        if (entry != null) {
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let declaration = entry.openCalls().get(i).callee.declaration();
                if (declaration != null && this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let declaration = openMentions.get(i).instantiation().template().declaration();
                if (this.productive.contains(declaration)) {
                    return true;
                }
            }
        }
        return false;
    }

    // Queues one concrete assignment, once, for productive owners only. A cascade hands the
    // origin down as it stands, so a judgment reached through any depth of generics is reported
    // at the line a reader wrote and names the instantiation they wrote there. Cascades past the
    // depth limit come from a polymorphically recursive generic call chain that would never
    // close; the judged prefix is deep enough for any real code.
    push(GreenNode owner, Type[] arguments, Origin origin, long depth) {
        if (depth > Limits.cascadeDepth) {
            return;
        }
        if (!this.productive.contains(owner)) {
            return;
        }
        if (!this.seen.add(new AssignmentKey(owner, arguments))) {
            return;
        }
        this.worklist.push(new Assignment(owner, arguments, origin, depth));
    }

    process(Assignment assignment) {
        let entry = this.registry.entryOf(assignment.owner);
        if (entry != null) {
            for (long i = 0; i < entry.obligations().length(); i++) {
                this.judge(entry, assignment, entry.obligations().get(i));
            }
            for (long i = 0; i < entry.openCalls().length(); i++) {
                let call = entry.openCalls().get(i);
                let declaration = call.callee.declaration();
                if (declaration == null || !this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.guardsHold(call.guards, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(call.arguments, assignment);
                if (substituted != null) {
                    this.push(declaration, substituted, assignment.origin,
                        assignment.depth + 1);
                }
            }
        }
        let openMentions = this.openMentionsByOwner.get(assignment.owner);
        if (openMentions != null) {
            for (long i = 0; i < openMentions.length(); i++) {
                let mention = openMentions.get(i);
                let instantiation = mention.instantiation();
                let declaration = instantiation.template().declaration();
                if (!this.productive.contains(declaration)) {
                    continue;
                }
                if (!this.mentionGuardsHold(mention, assignment)) {
                    continue;
                }
                let substituted = this.substituteAll(instantiation.arguments(), assignment);
                if (substituted != null && !hasRefusedKey(instantiation.template(), substituted,
                            this.namesAt(assignment.origin))) {
                    this.push(declaration, substituted, assignment.origin,
                        assignment.depth + 1);
                }
            }
        }
    }

    // A guarded mention replays only where the conditional member that wrote it exists; the guards
    // speak about the guard owner's parameters, so they only apply to that owner's own assignments.
    mentionGuardsHold(InstantiationMention mention, Assignment assignment) -> bool {
        let owner = mention.guardOwner();
        if (owner == null || owner != assignment.owner) {
            return true;
        }
        return this.guardsHold(mention.guards(), assignment);
    }

    // The arguments with the assignment's substitution applied, or null when one still
    // mentions a type parameter of some other owner.
    substituteAll(Type[] arguments, Assignment assignment) -> Type[]? {
        let substituted = new List<Type>();
        for (let argument in arguments) {
            let concrete = this.store.substitute(argument, assignment.owner,
                assignment.arguments);
            if (convert.containsTypeParam(concrete)) {
                return null;
            }
            substituted.push(concrete);
        }
        return substituted.toArray();
    }

    // True when the assignment satisfies every guard, meaning the conditional member the
    // obligation was recorded in exists for it; an unguarded obligation always holds.
    guardsHold(MemberConstraint[] guards, Assignment assignment) -> bool {
        for (let guard in guards) {
            long index = guard.parameterIndex();
            if (index >= assignment.arguments.length) {
                continue;
            }
            Type argument = assignment.arguments[index];
            for (let bound in guard.bounds()) {
                Type here = this.store.substitute(bound, assignment.owner,
                    assignment.arguments);
                if (!types.satisfiesBound(argument, here, [])) {
                    return false;
                }
            }
        }
        return true;
    }

    judge(OwnerEntry entry, Assignment assignment, Obligation obligation) {
        if (!this.guardsHold(obligation.guards(), assignment)) {
            return;
        }
        // The refusal lands where the type arguments were written and the note lands inside the
        // generic, so each of the two reads with the names of its own file.
        let whereWritten = this.namesAt(assignment.origin);
        let insideGeneric = this.names.namesFor(entry.file());
        switch (obligation) {
            is InterpolationObligation hole -> {
                let concrete = this.substituteOne(hole.hole(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        interpolationIssue(assignment.origin.display(), concrete, whereWritten),
                        "'{obligation.ownerDisplay()}' interpolates a value of type "
                            + "'{insideGeneric.of(hole.hole())}' here");
                }
            },
            is TypeTestObligation test -> {
                let source = this.substituteOne(test.source(), assignment);
                let target = this.substituteOne(test.target(), assignment);
                if (source != null && target != null) {
                    this.report(entry, assignment, obligation.span(),
                        typeTestIssue(assignment.origin.display(), source, target,
                            test.isCast(), whereWritten),
                        typeTestNote(obligation.ownerDisplay(), test.source(), test.target(),
                            test.isCast(), insideGeneric));
                }
            },
            is EqualityObligation equality -> {
                let concrete = this.substituteOne(equality.structType(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        equalityComparabilityIssue(assignment.origin.display(), concrete,
                            whereWritten),
                        "'{obligation.ownerDisplay()}' compares two values of type "
                            + "'{insideGeneric.of(equality.structType())}' with '==' here");
                }
            },
            is HashObligation hashed -> {
                let concrete = this.substituteOne(hashed.receiver(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        hashabilityIssue(assignment.origin.display(), concrete, whereWritten),
                        "'{obligation.ownerDisplay()}' calls 'hash()' on a value of type "
                            + "'{insideGeneric.of(hashed.receiver())}' here");
                }
            },
            is KeyTypeObligation keyed -> {
                let concrete = this.substituteOne(keyed.key(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        keyTypeIssue(assignment.origin.display(), keyed.container(), concrete,
                            whereWritten),
                        "'{insideGeneric.nameOf(keyed.container())}' is keyed by "
                            + "'{insideGeneric.of(keyed.key())}' here");
                }
            },
            is ArrayElementObligation created -> {
                let concrete = this.substituteOne(created.element(), assignment);
                if (concrete != null) {
                    this.report(entry, assignment, obligation.span(),
                        arrayElementIssue(assignment.origin.display(), concrete, whereWritten),
                        "'{obligation.ownerDisplay()}' creates an array of "
                            + "'{insideGeneric.of(created.element())}' here");
                }
            },
        }
    }

    // The names of the file a refusal these type arguments earn is reported in.
    namesAt(Origin origin) -> TypeNames {
        return this.names.namesFor(origin.file());
    }

    substituteOne(Type open, Assignment assignment) -> Type? {
        let concrete = this.store.substitute(open, assignment.owner, assignment.arguments);
        if (concrete is ErrorType || convert.containsTypeParam(concrete)) {
            return null;
        }
        return concrete;
    }

    // Records a refusal at the line that wrote the type arguments, with the generic's own line
    // as the note beside it.
    report(OwnerEntry entry, Assignment assignment, Span span, string? issue, string note) {
        if (issue != null) {
            this.collected.push(new FileDiagnostic(assignment.origin.file(), issue,
                assignment.origin.span(), new RelatedLocation(entry.file(), span, note)));
        }
    }
}

// The note beside a refused type test, naming the generic and the types its own line was
// written with.
typeTestNote(string owner, Type source, Type target, bool isCast,
             TypeNames names) -> string {
    if (isCast) {
        return "'{owner}' casts a value of type '{names.of(source)}' to "
            + "'{names.of(target)}' here";
    }
    return "'{owner}' tests a value of type '{names.of(source)}' against "
        + "'{names.of(target)}' here";
}

final class Limits {
    protected static const long cascadeDepth = 200;
}

// The generic declarations whose type parameters a type names.
public collectOwners(Type type, Set<GreenNode> owners) {
    switch (type) {
        is TypeParamType parameter -> {
            owners.add(parameter.owner());
        },
        is OptionalType optional -> {
            collectOwners(optional.inner(), owners);
        },
        is ArrayType array -> {
            collectOwners(array.element(), owners);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                collectOwners(parameter, owners);
            }
            collectOwners(functionType.returnType(), owners);
        },
        is InstantiationType instantiation -> {
            for (let argument in instantiation.arguments()) {
                collectOwners(argument, owners);
            }
        },
        default -> { },
    }
}

// How an instantiation reads in a diagnostic, 'Slots<Path>', from the name written and the
// concrete arguments it was given.
public displayFor(string name, Type[] arguments, TypeNames names) -> string {
    let builder = new StringBuilder();
    builder.append(name);
    builder.append("<");
    for (long i = 0; i < arguments.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(names.of(arguments[i]));
    }
    builder.append(">");
    return builder.toString();
}

// How a refusal opens. The line that wrote the refused code reads 'Cannot', while a reader who
// only handed a generic a type argument reads the instantiation they wrote. Every refusal below
// takes 'instantiation' as "" for the first reader and as the display for the second.
refusalSubject(string instantiation) -> string {
    if (instantiation.length == 0) {
        return "Cannot";
    }
    return "'{instantiation}' cannot";
}

// The fix a reader can act on. 'written' is for whoever wrote the refused code, and 'supplied'
// for whoever only chose the type argument that made it illegal.
suggestedFix(string instantiation, string written, string supplied) -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return supplied;
}

// What a reader passes instead of a type argument nullable at more than one level, naming the
// shape one level shallower.
oneLevelArgumentFix(OptionalType nested, TypeNames names) -> string {
    return "Pass a type argument nullable at one level at most, such as "
        + "'{names.of(nested.inner())}'.";
}

// What a struct holding a floating-point field declares to get its hash back, and what the pair
// then guarantees. 'opening' leads into the struct's name and differs by reader.
floatPairAdvice(string opening, string owner) -> string {
    return "{opening} '{owner}' its own 'equals' and 'hash', comparing each floating-point field "
        + "with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as long'.";
}

// Why a value of this type cannot fill an interpolation hole, or null when it can. A struct that
// declares its own 'toString' fills the hole through that method and is never serialized; one
// without interpolates as its JSON form, which needs every field to be JSON-able. A class or
// interface value always fills a hole: its runtime type's 'toString' override is called, or that
// type's name when no class in the chain declares one.
public interpolationIssue(Type analyzed, TypeNames names) -> string? {
    return interpolationIssueOf("", analyzed, analyzed, names);
}

// The same judgment for a hole inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public interpolationIssue(string instantiation, Type analyzed, TypeNames names) -> string? {
    return interpolationIssueOf(instantiation, analyzed, analyzed, names);
}

// 'shown' is the type the hole holds, which every refusal names, and 'judged' is what decides
// whether there is any text to print: for a nullable hole that is its payload, since one level
// prints the payload's text or 'null'.
interpolationIssueOf(string instantiation, Type shown, Type judged, TypeNames names)
        -> string? {
    if (isJsonableLeaf(judged)) {
        return null;
    }
    if (types.isStructLike(judged)) {
        if (types.declaredToString(judged) != null) {
            return null;
        }
        return structTextIssue(instantiation, shown, judged, names);
    }
    if (types.isClassLike(judged)) {
        return null;
    }
    if (judged is ArrayType) {
        return arrayTextIssue(instantiation, shown, judged, names);
    }
    if (judged is FunctionType) {
        return refusalSubject(instantiation) + " interpolate a value of type "
            + "'{names.of(shown)}': a function value has no text form. "
            + suggestedFix(instantiation,
                "Interpolate what the function returns, or a name you keep beside it.",
                "Pass a name you keep beside the function, or a type argument whose values have "
                    + "one.");
    }
    // One optional level prints the value's text or 'null', so what it wraps decides. A second
    // level has no text of its own: two absent levels would both read 'null'.
    if (judged is OptionalType) {
        if (judged.inner() is OptionalType) {
            return refusalSubject(instantiation) + " interpolate a value of type "
                + "'{names.of(shown)}' because it may be null at more than one level. "
                + suggestedFix(instantiation,
                    "Unwrap one level at a time with a null check ('if (value != null)') or a "
                        + "fallback ('value ?? null'), until "
                        + "'{names.of(convert.coreOf(shown))}' remains.",
                    oneLevelArgumentFix(judged, names));
        }
        return interpolationIssueOf(instantiation, shown, judged.inner(), names);
    }
    return refusalSubject(instantiation) + " interpolate a value of type "
        + "'{names.of(shown)}'; a '\{...\}' in a string takes a string, an integer, a 'bool', "
        + "an enum, a class, or a struct that serializes to JSON. "
        + suggestedFix(instantiation, "Convert it with '.toString()' first.",
            "Pass the text you want instead, or a type argument of one of those kinds.");
}

// The innermost element type an array bottoms out at, through nested arrays and the elements'
// nullable wrappers.
innermostElementOf(ArrayType array) -> Type {
    Type element = convert.coreOf(array.element());
    while (element is ArrayType) {
        element = convert.coreOf(element.element());
    }
    return element;
}

// Why a value of this array type has no text form, or null when it does. Elements format as struct
// serialization writes them, so a struct element is its JSON form even with its own 'toString'.
arrayTextIssue(string instantiation, Type shown, ArrayType array, TypeNames names)
        -> string? {
    Type element = innermostElementOf(array);
    if (convert.containsTypeParam(element)) {
        return null;
    }
    if (isJsonableLeaf(element) || types.isClassLike(element)) {
        return null;
    }
    if (types.isStructLike(element)) {
        return structTextIssue(instantiation, element, element, names);
    }
    if (element is FunctionType) {
        return refusalSubject(instantiation) + " interpolate a value of type "
            + "'{names.of(shown)}': its elements are function values, which have no text "
            + "form. " + suggestedFix(instantiation,
                "Interpolate names you keep beside the functions instead.",
                "Pass a type argument whose elements have a text form, such as names you keep "
                    + "beside the functions.");
    }
    return refusalSubject(instantiation) + " interpolate a value of type "
        + "'{names.of(shown)}'; its element type '{names.of(element)}' has no text "
        + "form. " + suggestedFix(instantiation,
            "Interpolate a value you keep beside the elements instead.",
            "Pass a type argument whose elements have a text form.");
}

// A value type, string, or enum that has a direct JSON form.
isJsonableLeaf(Type type) -> bool {
    if (convert.isIntegerType(type) || convert.isBoolType(type) || convert.isEnumLike(type)) {
        return true;
    }
    if (type is StringType) {
        return true;
    }
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Float || type.kind() == PrimitiveKind.Double;
    }
    return false;
}

// Why 'is' or 'as?' between these concrete types is malformed, always true, or never true, or null
// when the test is meaningful. The target is already known to be a plain class or interface shape.
public typeTestIssue(Type source, Type target, bool isCast, TypeNames names) -> string? {
    return typeTestIssueOf("", source, target, isCast, names);
}

// The same judgment for a test inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public typeTestIssue(string instantiation, Type source, Type target, bool isCast,
                     TypeNames names) -> string? {
    return typeTestIssueOf(instantiation, source, target, isCast, names);
}

typeTestIssueOf(string instantiation, Type source, Type target, bool isCast,
                TypeNames names) -> string? {
    string operator = "is";
    if (isCast) {
        operator = "as?";
    }
    // A written target is always a class or an interface, so these two arise only through a
    // type parameter's instantiation.
    if (target is OptionalType) {
        if (instantiation.length > 0) {
            return "'{instantiation}' cannot use '{operator}' against "
                + "'{names.of(target)}': it is nullable, and '{operator}' never matches "
                + "null. Pass a type argument that is not nullable, such as "
                + "'{names.of(convert.coreOf(target))}'.";
        }
        return "The target of '{operator}' resolves to '{names.of(target)}', which is "
            + "nullable, and '{operator}' never matches null. Test against "
            + "'{names.of(convert.coreOf(target))}' instead.";
    }
    if (!types.isClassLike(target)) {
        if (instantiation.length > 0) {
            return "'{instantiation}' cannot use '{operator}' against "
                + "'{names.of(target)}': only a class or an interface can be tested at run "
                + "time. Pass a class or an interface as the type argument.";
        }
        return "The target of '{operator}' resolves to '{names.of(target)}', and only a "
            + "class or an interface can be tested at run time.";
    }
    if (source is OptionalType && source.inner() is OptionalType) {
        return refusalSubject(instantiation) + " use '{operator}' on a value of type "
            + "'{names.of(source)}', because '{operator}' looks through one level of null. "
            + suggestedFix(instantiation,
                "Unwrap one level with a null check ('if (value != null)') or a fallback "
                    + "('value ?? null'), then test the '{names.of(source.inner())}' that "
                    + "remains.",
                oneLevelArgumentFix(source, names));
    }
    Type sourceCore = convert.bareOf(source);
    if (!types.isClassLike(sourceCore)) {
        string action = "tested.";
        if (isCast) {
            action = "cast.";
        }
        string refused = refusalSubject(instantiation) + " use '{operator}' on a value of type "
            + "'{names.of(source)}'; only class values can be {action}";
        string kind = types.valueKindWord(sourceCore);
        if (kind.length > 0 && types.isInterfaceLike(target) && types.conformsTo(sourceCore, target)) {
            refused = refused + " '{names.of(sourceCore)}' does implement "
                + "'{names.of(target)}', but only as a generic bound: '{operator}' works on "
                + "class instances, and a {kind} never is one.";
            if (instantiation.length > 0) {
                return refused + " Pass a class that implements "
                    + "'{names.of(target)}' instead.";
            }
            return refused;
        }
        if (instantiation.length > 0) {
            return refused + " Pass a class as the type argument instead.";
        }
        return refused;
    }
    if (types.isSubclassOrConforms(sourceCore, target)) {
        if (!isCast && source is OptionalType) {
            return null;
        }
        if (isCast) {
            if (instantiation.length > 0) {
                return "'{instantiation}' casts a value of type "
                    + "'{names.of(source)}' to "
                    + "'{names.of(target)}', which it always is. Use the value directly, or a "
                    + "type argument for which the cast can fail.";
            }
            return "'as? {names.of(target)}' is not needed here: a value of "
                + "type '{names.of(source)}' always converts to "
                + "'{names.of(target)}?'. Use the value directly.";
        }
        if (instantiation.length > 0) {
            return "'{instantiation}' tests a value of type "
                + "'{names.of(source)}' against "
                + "'{names.of(target)}', which it always is, so the test is always true. Use a "
                + "type argument for which it can be false.";
        }
        return "A value of type '{names.of(source)}' is always of type "
            + "'{names.of(target)}', so this 'is' test is always true. Remove it.";
    }
    if (types.isInterfaceLike(sourceCore)) {
        return null;
    }
    if (types.isInterfaceLike(target)) {
        if (isFinalClass(sourceCore)) {
            if (instantiation.length > 0) {
                return "'{instantiation}' " + testsAgainst(source, target, isCast, names)
                    + ", which it can never be: "
                    + "'{names.of(sourceCore)}' is 'final' and does not "
                    + "implement it, so " + neverOutcome(isCast)
                    + " Use a type argument for which the test can be true or false.";
            }
            string outcome = "This 'is' test is always false.";
            if (isCast) {
                outcome = "This 'as?' cast always gives null.";
            }
            return "A value of type '{names.of(source)}' can never be of type "
                + "'{names.of(target)}', because '{names.of(sourceCore)}' is 'final' and does not "
                + "implement '{names.of(target)}'. {outcome} Remove it.";
        }
        return null;
    }
    if (!types.isSubclassOf(target, sourceCore)) {
        if (instantiation.length > 0) {
            return "'{instantiation}' " + testsAgainst(source, target, isCast, names)
                + ", which it can never be, so " + neverOutcome(isCast)
                + " Use a type argument for which the test can be true or false.";
        }
        string outcome = "this 'is' test is always false.";
        if (isCast) {
            outcome = "this 'as?' cast always gives null.";
        }
        return "A value of type '{names.of(source)}' can never be of type "
            + "'{names.of(target)}', so {outcome} Remove it.";
    }
    return null;
}

// What a generic's own line does with the two types, as a refusal reported elsewhere retells it.
testsAgainst(Type source, Type target, bool isCast, TypeNames names) -> string {
    if (isCast) {
        return "casts a value of type '{names.of(source)}' to "
            + "'{names.of(target)}'";
    }
    return "tests a value of type '{names.of(source)}' against "
        + "'{names.of(target)}'";
}

// What a test that can never pass would produce.
neverOutcome(bool isCast) -> string {
    if (isCast) {
        return "the cast would always be null.";
    }
    return "the test would always be false.";
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

// Why values of this struct or array type cannot be compared with '==', or null when they can.
// Names the offending field's dotted path and its type.
public equalityComparabilityIssue(Type structType, TypeNames names) -> string? {
    return equalityComparabilityIssueOf("", structType, names);
}

// The same judgment for a '==' inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public equalityComparabilityIssue(string instantiation, Type structType, TypeNames names)
        -> string? {
    return equalityComparabilityIssueOf(instantiation, structType, names);
}

equalityComparabilityIssueOf(string instantiation, Type structType, TypeNames names)
        -> string? {
    if (structType is ArrayType) {
        Type leaf = innermostElementOf(structType);
        if (convert.containsTypeParam(leaf)) {
            return null;
        }
        if (leaf is FunctionType) {
            return equalitySubject(instantiation, structType,
                    "'{names.of(structType)}' cannot be compared with '=='", names)
                + ": an array compares element by element, and its element type "
                + "'{names.of(leaf)}' has no '=='; {noEqualityReason(leaf)}. "
                + suggestedFix(instantiation, "Compare the elements you need directly instead.",
                    "Use a type argument whose elements have an '==' of their own.");
        }
        if (types.isStructLike(leaf)) {
            let inElement = firstIncomparableField(leaf, new Set<Type>());
            if (inElement != null) {
                return equalitySubject(instantiation, structType,
                        "'{names.of(structType)}' cannot be compared with '=='", names)
                    + ": an array compares element by element, and element field "
                    + "'{inElement.path()}' has type '{names.of(inElement.leaf())}', which "
                    + "has no '=='; {noEqualityReason(inElement.leaf())}. "
                    + suggestedFix(instantiation,
                        "Compare the elements you need directly instead.",
                        "Use a type argument whose elements have an '==' of their own.");
            }
        }
        return null;
    }
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstIncomparableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    return equalitySubject(instantiation, structType,
            "Struct '{names.nameOf(authority)}' cannot be compared with '=='", names)
        + ". Field '{found.path()}' has type '{names.of(found.leaf())}', which has no "
        + "'=='; {noEqualityReason(found.leaf())}. "
        + suggestedFix(instantiation, "Compare the fields you need directly instead.",
            "Use a type argument with an '==' of its own, or give '{names.nameOf(authority)}' its own "
                + "'equals' and 'hash'.");
}

// The subject of a '==' refusal: 'written' names what cannot be compared where the comparison
// was written, while a reader who only chose the type argument reads their own instantiation.
equalitySubject(string instantiation, Type compared, string written, TypeNames names)
        -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return "'{instantiation}' cannot compare two values of type "
        + "'{names.of(compared)}' with '=='";
}

// Why a value of this type has no 'hash', or null when it has one. An optional hashes as its
// payload does, so the payload's type decides.
public hashabilityIssue(Type receiver, TypeNames names) -> string? {
    return hashabilityIssueOf("", receiver, names);
}

// The same judgment for a 'hash()' call inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public hashabilityIssue(string instantiation, Type receiver, TypeNames names) -> string? {
    return hashabilityIssueOf(instantiation, receiver, names);
}

hashabilityIssueOf(string instantiation, Type receiver, TypeNames names) -> string? {
    Type core = convert.coreOf(receiver);
    if (core is FunctionType) {
        if (instantiation.length > 0) {
            return "'{instantiation}' cannot hash a value of type "
                + "'{names.of(receiver)}': {noHashReason(core)}. Keep a name or tag beside "
                + "the function and pass that instead.";
        }
        return functionMemberIssue("hash", receiver, names);
    }
    if (core is ExternalType) {
        return refusalSubject(instantiation) + " hash a value of type "
            + "'{names.of(receiver)}': {noHashReason(core)}. "
            + suggestedFix(instantiation,
                "Wrap the handle in a class, which hashes by identity, or hash a value you keep "
                    + "beside it.",
                "Wrap the handle in a class, which hashes by identity, and pass that, or pass a "
                    + "value you keep beside it.");
    }
    if (convert.isFloatType(core)) {
        return refusalSubject(instantiation) + " hash a value of type "
            + "'{names.of(receiver)}': {noHashReason(core)}. "
            + suggestedFix(instantiation,
                "Hash the number's 'toCanonicalBits() as long' instead, which gives every NaN "
                    + "the same hash and the two zeros different ones.",
                "Pass the number's 'toCanonicalBits() as long' instead, which gives every NaN "
                    + "the same hash and the two zeros different ones.");
    }
    if (core is ArrayType) {
        Type leaf = innermostElementOf(core);
        if (convert.containsTypeParam(leaf)) {
            return null;
        }
        if (isOpaqueLeaf(leaf, true)) {
            return hashSubject(instantiation, receiver,
                    "'{names.of(receiver)}' cannot be hashed", names)
                + ": an array hashes element by element, and its element type "
                + "'{names.of(leaf)}' has no hash; {noHashReason(leaf)}. "
                + suggestedFix(instantiation,
                    "Hash a value you keep beside the elements instead.",
                    "Use a type argument whose elements have a hash of their own.");
        }
        if (types.isStructLike(leaf)) {
            let inElement = firstUnhashableField(leaf, new Set<Type>());
            if (inElement != null) {
                return hashSubject(instantiation, receiver,
                        "'{names.of(receiver)}' cannot be hashed", names)
                    + ": an array hashes element by element, and element field "
                    + "'{inElement.path()}' has type '{names.of(inElement.leaf())}', which "
                    + "has no hash; {noHashReason(inElement.leaf())}. "
                    + suggestedFix(instantiation,
                        "Hash the fields you need directly instead.",
                        "Use a type argument whose elements have a hash of their own.");
            }
        }
        return null;
    }
    if (!types.isStructLike(core)) {
        return null;
    }
    let authority = types.authorityOf(core);
    let found = firstUnhashableField(core, new Set<Type>());
    if (authority == null || found == null) {
        return null;
    }
    string owner = names.nameOf(authority);
    string fix = suggestedFix(instantiation, "Hash the fields you need directly instead.",
        "Use a type argument with a hash of its own, or give '{owner}' its own 'equals' and "
            + "'hash'.");
    if (convert.isFloatType(found.leaf())) {
        fix = suggestedFix(instantiation, floatPairAdvice("Give", owner),
            floatPairAdvice("Use a type argument with a hash of its own, or give", owner));
    }
    return hashSubject(instantiation, receiver, "Struct '{owner}' cannot be hashed", names)
        + ". Field '{found.path()}' has type '{names.of(found.leaf())}', which has no "
        + "hash; {noHashReason(found.leaf())}. " + fix;
}

// The subject of a hash refusal: 'written' names what has no hash where the call was written,
// while a reader who only chose the type argument reads their own instantiation.
hashSubject(string instantiation, Type receiver, string written, TypeNames names)
        -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return "'{instantiation}' cannot hash a value of type '{names.of(receiver)}'";
}

// Why a member cannot be read or called on a function value, whatever the member.
public functionMemberIssue(string name, Type functionType, TypeNames names) -> string {
    return "A function value has no members, so '{name}' cannot be used on "
        + "'{names.of(functionType)}'. Call the value with '(...)', or keep the data you need "
        + "beside it.";
}

// A standard container that hashes or orders its entries by one type argument, and how a
// diagnostic names that argument's role, the container, and what a changing key would upset.
public final class KeyedContainer {
    long keyArgumentIndex;
    string roleText;
    string nounText;
    string homeText;
    string upsetText;
    bool findsByHash;

    protected constructor(this.keyArgumentIndex, this.roleText, this.nounText, this.homeText,
                          this.upsetText, this.findsByHash);

    public keyIndex() -> long {
        return this.keyArgumentIndex;
    }

    public role() -> string {
        return this.roleText;
    }

    public noun() -> string {
        return this.nounText;
    }

    public home() -> string {
        return this.homeText;
    }

    public upset() -> string {
        return this.upsetText;
    }

    // Whether the container finds a key by hashing it, which is what a type with no hash rules
    // out; one that walks an order needs 'compareTo' instead.
    public keysByHash() -> bool {
        return this.findsByHash;
    }
}

// The keyed standard containers, by template name and declaring module, the way sema picks
// 'Iterable<T>'; 'SortedMap' is named ahead of the library that adds it.
public keyedContainerOf(DeclaredType template) -> KeyedContainer? {
    if (!(template is ClassType)) {
        return null;
    }
    if (isDeclaredAs(template, "Map", "map")) {
        return new KeyedContainer(0, "a Map key", "key", "the table", "its hash", true);
    }
    if (isDeclaredAs(template, "Set", "set")) {
        return new KeyedContainer(0, "a Set element", "element", "the set", "its hash", true);
    }
    if (isDeclaredAs(template, "SortedMap", "sortedmap")) {
        return new KeyedContainer(0, "a SortedMap key", "key", "the map",
            "its place in the order", false);
    }
    return null;
}

// Why a value of this type cannot be the key argument of this container, or null when it can. A
// key that hashes by content must not change while it is in the container, and a key with no
// hash at all is refused here so the error lands on the mention rather than inside the library.
public keyTypeIssue(DeclaredType container, Type key, TypeNames names) -> string? {
    return keyTypeIssueOf("", container, key, names);
}

// The same judgment for a keyed container written inside a generic body, refused for the
// arguments of the 'instantiation' a reader wrote and reported at that reader's own line.
public keyTypeIssue(string instantiation, DeclaredType container, Type key,
                    TypeNames names) -> string? {
    return keyTypeIssueOf(instantiation, container, key, names);
}

keyTypeIssueOf(string instantiation, DeclaredType container, Type key, TypeNames names)
        -> string? {
    let keyed = keyedContainerOf(container);
    if (keyed == null) {
        return null;
    }
    Type core = convert.coreOf(key);
    string refused = refusalSubject(instantiation) + " use '{names.of(key)}' as "
        + "{keyed.role()}: ";
    if (core is ArrayType) {
        return refused + "an array's contents, and so {keyed.upset()}, can change while it "
            + "sits in {keyed.home()}. Key by a value whose contents cannot change, such as a "
            + "string or an integer.";
    }
    if (isStandardCollection(core)) {
        return refused + "a collection's contents, and so {keyed.upset()}, can change while "
            + "it sits in {keyed.home()}. Key by a value whose contents cannot change, such as "
            + "a string or an integer.";
    }
    // A container that finds a key by hashing it is the only one that refuses a type with no
    // hash, or judges what the fields of a struct key hold. One that walks an order requires
    // 'Comparable' of its key instead, which a struct satisfies with a 'compareTo' of its own, whatever
    // its fields hold, and the constructor's bound judges that.
    if (!keyed.keysByHash()) {
        return null;
    }
    if (core is ExternalType) {
        return refused + "{noHashReason(core)}. Wrap the handle in a class, which hashes by "
            + "identity, or key by a value you keep beside it.";
    }
    if (core is FunctionType) {
        return refused + "{noHashReason(core)}. Keep a name or tag beside each function and "
            + "key by that instead.";
    }
    if (convert.isFloatType(core)) {
        return refused + "{noHashReason(core)}. " + suggestedFix(instantiation,
            "Use a SortedMap, which finds a key by its order rather than by its hash, or key "
                + "by a struct of your own whose 'equals' compares the number with "
                + "'compareTo(...) == 0' and whose 'hash' returns 'toCanonicalBits() as "
                + "long'.",
            "Pass a type argument with a hash of its own, such as a struct holding the "
                + "number whose 'equals' compares it with 'compareTo(...) == 0' and whose "
                + "'hash' returns 'toCanonicalBits() as long'.");
    }
    if (!types.isStructLike(core)) {
        return null;
    }
    let changeable = firstChangeableField(core, new Set<Type>());
    if (changeable != null) {
        return refused + "its field '{changeable.path()}' has type "
            + "'{names.of(changeable.leaf())}', whose contents can change while the "
            + "{keyed.noun()} sits in {keyed.home()}. " + suggestedFix(instantiation,
            "Key by the fields whose contents cannot change, give '{names.of(key)}' its own "
                + "'equals' and 'hash' that leave '{changeable.path()}' out, or key by a value "
                + "you keep beside the {keyed.noun()}.",
            "Pass a type argument whose contents cannot change, or give '{names.of(key)}' its "
                + "own 'equals' and 'hash' that leave '{changeable.path()}' out.");
    }
    let opaque = firstUnhashableField(core, new Set<Type>());
    if (opaque != null) {
        string fix = " Give '{names.of(key)}' its own 'equals' and 'hash', or key by the "
            + "fields that have one.";
        if (convert.isFloatType(opaque.leaf())) {
            fix = " " + suggestedFix(instantiation,
                floatPairAdvice("Key by the fields that are exact, or give", names.of(key)),
                floatPairAdvice("Pass a type argument with a hash of its own, or give",
                    names.of(key)));
        }
        return refused + "its field '{opaque.path()}' has type "
            + "'{names.of(opaque.leaf())}', which has no hash; "
            + "{noHashReason(opaque.leaf())}." + fix;
    }
    return null;
}

// True for a keyed container instantiated at a refused key. The mention that formed it was
// reported where it was written, so the container's own bodies are never judged for it.
hasRefusedKey(DeclaredType template, Type[] arguments, TypeNames names) -> bool {
    let keyed = keyedContainerOf(template);
    if (keyed == null || keyed.keyIndex() >= arguments.length) {
        return false;
    }
    return keyTypeIssue(template, arguments[keyed.keyIndex()], names) != null;
}

// The standard collections by template name and declaring module; 'Deque', 'PriorityQueue', and
// 'SortedMap' are named ahead of the library that adds them.
isStandardCollection(Type core) -> bool {
    if (!(core is InstantiationType)) {
        return false;
    }
    let template = core.template();
    if (!(template is ClassType)) {
        return false;
    }
    return isDeclaredAs(template, "List", "list") || isDeclaredAs(template, "Map", "map")
        || isDeclaredAs(template, "Set", "set") || isDeclaredAs(template, "Deque", "deque")
        || isDeclaredAs(template, "PriorityQueue", "priorityqueue")
        || isDeclaredAs(template, "SortedMap", "sortedmap");
}

isDeclaredAs(DeclaredType template, string name, string module) -> bool {
    return template.name() == name && template.modulePath() == "std.collections." + module;
}

// Why a value of struct type 'structType' cannot serialize to JSON, or null when every field
// is JSON-able. Names the offending field's dotted path and its type.
public structJsonabilityIssue(Type structType, TypeNames names) -> string? {
    return structTextIssue("", structType, structType, names);
}

// Why a value of struct type 'structType' cannot serialize to JSON, or null when every field is
// JSON-able. Names the offending field's dotted path and its type. 'shown' is the type the hole was
// written with, which may hold the struct behind a nullable level, so that is what the refusal
// names.
structTextIssue(string instantiation, Type shown, Type structType, TypeNames names)
        -> string? {
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstNonJsonableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    string subject = "Struct '{names.nameOf(authority)}' cannot be converted to a string.";
    if (instantiation.length > 0) {
        subject = "'{instantiation}' cannot interpolate a value of type "
            + "'{names.of(shown)}': struct '{names.nameOf(authority)}' has no text form.";
    } else if (shown != structType) {
        subject = "Cannot interpolate a value of type '{names.of(shown)}': struct "
            + "'{names.nameOf(authority)}' has no text form.";
    }
    return subject + " Field '{found.path()}' has type '{names.of(found.leaf())}', which "
        + "has no text form; a struct's fields must all be primitives, strings, enums, their "
        + "nullable forms, or structs of those. "
        + suggestedFix(instantiation, "Convert or drop the field.",
            "Give '{names.nameOf(authority)}' a 'toString' of its own, or pass a type argument that "
                + "has a text form.");
}

// A struct field with no operator of its own: the dotted path from the compared struct down to
// it, and the offending leaf type it bottoms out at.
class OffendingField {
    string fieldPath;
    Type fieldLeaf;

    protected constructor(string path, Type leaf) {
        this.fieldPath = path;
        this.fieldLeaf = leaf;
    }

    protected path() -> string {
        return this.fieldPath;
    }

    protected leaf() -> Type {
        return this.fieldLeaf;
    }
}

// Why a leaf type has no '=='.
noEqualityReason(Type leaf) -> string {
    if (leaf is ArrayType) {
        return "an array compares element by element, and its elements have no '==' of "
            + "their own";
    }
    return "a function value has no identity";
}

// Why a leaf type has no 'hash'.
noHashReason(Type leaf) -> string {
    if (leaf is FunctionType) {
        return "a function value has no identity, so it has no hash";
    }
    if (leaf is ArrayType) {
        return "an array hashes element by element, and its elements have no hash of their own";
    }
    if (convert.isFloatType(leaf)) {
        return "a NaN is equal to no value, so nothing could find it again, and negative zero is "
            + "equal to zero but hashes differently, so one key would become two entries";
    }
    return "an external type is an address with no value to hash";
}

// The first field, at any depth, whose type has no '==': a function value or an array of them. An
// external handle compares by identity, so it never offends here.
firstIncomparableField(Type structType, Set<Type> visiting) -> OffendingField? {
    return firstOpaqueField(structType, visiting, false);
}

// The first field, at any depth, whose type has no 'hash'. An external handle, a function value
// and a floating-point number are the kinds that offend, as is an array of any of them.
firstUnhashableField(Type structType, Set<Type> visiting) -> OffendingField? {
    return firstOpaqueField(structType, visiting, true);
}

// A struct that declares its own 'equals' and 'hash' is judged by that pair, so the walk never descends
// into one; a field mentioning a type parameter is left for the per-instantiation replay.
firstOpaqueField(Type structType, Set<Type> visiting, bool hashing) -> OffendingField? {
    if (declaresOwnPair(structType) || !visiting.add(structType)) {
        return null;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (isOpaqueLeaf(element, hashing)) {
                return new OffendingField(field.name(), core);
            }
            if (types.isStructLike(element)) {
                let inElement = firstOpaqueField(element, visiting, hashing);
                if (inElement != null) {
                    return new OffendingField(field.name(), core);
                }
            }
            continue;
        }
        if (isOpaqueLeaf(core, hashing)) {
            return new OffendingField(field.name(), core);
        }
        if (types.isStructLike(core)) {
            let nested = firstOpaqueField(core, visiting, hashing);
            if (nested != null) {
                return new OffendingField(field.name() + "." + nested.path(), nested.leaf());
            }
        }
    }
    return null;
}

// A function value has neither operator, so it always offends. An external handle compares by
// identity and a floating-point value compares by IEEE rules, so each of those has an '==' and
// offends the hash walk alone.
isOpaqueLeaf(Type leaf, bool hashing) -> bool {
    if (leaf is FunctionType) {
        return true;
    }
    return hashing && (leaf is ExternalType || convert.isFloatType(leaf));
}

// The first field, at any depth through nullable wrappers and nested structs, whose type is an
// array or a standard collection. A struct that declares its own 'equals' and 'hash' decides
// which fields a match reads, so the walk never descends into one. A field mentioning a
// type parameter is left for the per-instantiation replay.
firstChangeableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (declaresOwnPair(structType) || !visiting.add(structType)) {
        return null;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (core is ArrayType || isStandardCollection(core)) {
            return new OffendingField(field.name(), core);
        }
        if (types.isStructLike(core)) {
            let nested = firstChangeableField(core, visiting);
            if (nested != null) {
                return new OffendingField(field.name() + "." + nested.path(), nested.leaf());
            }
        }
    }
    return null;
}

// Sema holds a struct's 'hash' and 'equals' to a matched pair, so either name proves both.
declaresOwnPair(Type structType) -> bool {
    let methods = types.methodsOf(structType);
    if (methods == null) {
        return false;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (!method.isConstructor() && method.name() == "hash") {
            return true;
        }
    }
    return false;
}

// The first field, at any depth, with no JSON form. A field mentioning a type parameter is left
// for the per-instantiation replay.
firstNonJsonableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (!visiting.add(structType)) {
        return null;
    }
    let fields = types.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (isJsonableLeaf(core)) {
            continue;
        }
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (isJsonableLeaf(element)) {
                continue;
            }
            if (types.isStructLike(element)) {
                let inElement = firstNonJsonableField(element, visiting);
                if (inElement == null) {
                    continue;
                }
                return new OffendingField(field.name() + "." + inElement.path(),
                    inElement.leaf());
            }
            return new OffendingField(field.name(), element);
        }
        if (types.isStructLike(core)) {
            let nested = firstNonJsonableField(core, visiting);
            if (nested != null) {
                return new OffendingField(field.name() + "." + nested.path(), nested.leaf());
            }
            continue;
        }
        return new OffendingField(field.name(), core);
    }
    return null;
}

// Why a freshly allocated array of this element type would not hold valid values, or null when it
// would. A reference element is offered the fill loop the wording names, because filling as the
// array is created is what makes it sound; a struct's own field names which one is at fault.
public arrayElementIssue(Type element, bool hasFillName, string fillName, TypeNames names)
        -> string? {
    return arrayElementIssueOf("", element, hasFillName, fillName, names);
}

// The same judgment for a 'new T[n]' inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line. The fill loop belongs
// to whoever wrote the allocation, so this reader is offered the type argument instead.
public arrayElementIssue(string instantiation, Type element, TypeNames names) -> string? {
    return arrayElementIssueOf(instantiation, element, false, "", names);
}

arrayElementIssueOf(string instantiation, Type element, bool hasFillName, string fillName,
                    TypeNames names) -> string? {
    if (element is ErrorType || convert.isDefaultable(element)) {
        return null;
    }
    string shown = names.of(element);
    string hint = "";
    if (isReferenceElement(element)) {
        if (hasFillName) {
            return "An array of '{shown}', which cannot hold null, must be filled as it is "
                + "created: assign it to a new variable and follow the declaration with "
                + "'for (long i = 0; i < {fillName}.length; i++) \{ {fillName}[i] = ...; \}'. "
                + "Or use '{shown}?[]' so a slot can start as null.";
        }
        hint = suggestedFix(instantiation,
            " Use '{shown}?[]' so a new array's slots can start as null.",
            " Pass a type argument that makes the element type nullable, so a slot can start as "
                + "null.");
    } else if (types.isStructLike(element)) {
        hint = offendingFieldHint(instantiation, element, shown, names);
    }
    return refusalSubject(instantiation) + " use '{shown}' as an array element type: a new "
        + "array's slots start as zero, which is not a valid '{shown}'.{hint}";
}

offendingFieldHint(string instantiation, Type element, string shown, TypeNames names)
        -> string {
    let fields = types.fieldsOf(element);
    if (fields == null) {
        return "";
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (field.hasDefault()) {
            continue;
        }
        if (field.isConst()) {
            return " Field '{field.name()}' of '{shown}' is 'const' with no default value, so "
                + "nothing could assign it in a new array's slot. "
                + suggestedFix(instantiation, "Give the field a default value.",
                    "Give the field a default value, or pass a type argument that makes the "
                        + "element type nullable.");
        }
        if (!convert.isDefaultable(field.type())) {
            return " Field '{field.name()}' of '{shown}' has type "
                + "'{names.of(field.type())}', which cannot start as zero. "
                + suggestedFix(instantiation, "Make that field nullable.",
                    "Make that field nullable, or pass a type argument that makes the element "
                        + "type nullable.");
        }
    }
    return "";
}

isReferenceElement(Type element) -> bool {
    return types.isClassLike(element) || element is ArrayType || element is StringType
        || element is ExternalType;
}
