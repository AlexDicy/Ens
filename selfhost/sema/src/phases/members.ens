// Shared readers for member declarations: modifier sets, fields, and callable signatures. The
// same readers serve structs, classes, interfaces, and free functions; the caller states what
// the surrounding declaration allows.
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import NamedTypeNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import SyntaxToken from @ens.frontend.syntax.node;
import Span from @ens.frontend.support.source;
import GreenNode from @ens.frontend.syntax.green;
import Reporter from support.diagnostics;
import TypeNames from model.types;
import TypeResolver from phases.resolve;
import model.convert;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import Field from model.types;
import Parameter from model.types;
import Signature from model.types;
import Method from model.types;
import MemberConstraint from model.types;
import DeclaredType from model.types;
import StructType from model.types;
import ClassType from model.types;
import TypeParamType from model.types;
import PrimitiveKind from model.types;
import PrimitiveType from model.types;
import StringType from model.types;
import TypeStore from model.types;
import PrimitiveIntrinsic from model.types;
import Visibility from model.types;
import List from @std.collections.list;

class MemberVisibilityMark {
    protected Visibility marked;
    protected Span markSpan;

    protected constructor(this.marked, this.markSpan);
}

public final class MemberModifiers {
    protected List<MemberVisibilityMark> visibilityMarks;
    public bool declaresAbstract;
    public bool declaresFinal;
    public bool declaresOverride;
    bool declaresSealed;
    protected bool declaresWeak;
    protected bool declaresConst;
    public bool declaresNoreturn;
    public bool declaresStatic;
    public bool declaresLazy;
    protected Span? staticMark;
    protected Span? lazyMark;
    protected Span? abstractMark;
    protected Span? finalMark;

    protected constructor() {
        this.visibilityMarks = new List<MemberVisibilityMark>();
    }

    protected add(SyntaxKind kind, Span span) {
        switch (kind) {
            PublicKeyword -> {
                this.visibilityMarks.push(new MemberVisibilityMark(Visibility.Public, span));
            },
            PrivateKeyword -> {
                this.visibilityMarks.push(new MemberVisibilityMark(Visibility.Private, span));
            },
            ProtectedKeyword -> {
                this.visibilityMarks.push(new MemberVisibilityMark(Visibility.Protected, span));
            },
            ExportKeyword -> {
                this.visibilityMarks.push(new MemberVisibilityMark(Visibility.Export, span));
            },
            AbstractKeyword -> {
                this.declaresAbstract = true;
                this.abstractMark = span;
            },
            FinalKeyword -> {
                this.declaresFinal = true;
                this.finalMark = span;
            },
            OverrideKeyword -> {
                this.declaresOverride = true;
            },
            SealedKeyword -> {
                this.declaresSealed = true;
            },
            WeakKeyword -> {
                this.declaresWeak = true;
            },
            ConstKeyword -> {
                this.declaresConst = true;
            },
            NoreturnKeyword -> {
                this.declaresNoreturn = true;
            },
            StaticKeyword -> {
                this.declaresStatic = true;
                this.staticMark = span;
            },
            LazyKeyword -> {
                this.declaresLazy = true;
                this.lazyMark = span;
            },
            default -> { },
        }
    }

    public hasVisibilityModifier() -> bool {
        return this.visibilityMarks.length() > 0;
    }

    // Where a diagnostic about the visibility modifier points: the first mark, or the fallback
    // when the member carries none.
    public visibilityModifierSpan(Span fallback) -> Span {
        if (this.visibilityMarks.length() == 0) {
            return fallback;
        }
        return this.visibilityMarks.get(0).markSpan;
    }

    // Where a diagnostic about the 'static' modifier points.
    public staticModifierSpan(Span fallback) -> Span {
        let mark = this.staticMark;
        if (mark == null) {
            return fallback;
        }
        return mark;
    }

    // Where a diagnostic about the 'lazy' modifier points.
    public lazyModifierSpan(Span fallback) -> Span {
        let mark = this.lazyMark;
        if (mark == null) {
            return fallback;
        }
        return mark;
    }

    public abstractModifierSpan(Span fallback) -> Span {
        let mark = this.abstractMark;
        if (mark == null) {
            return fallback;
        }
        return mark;
    }

    public finalModifierSpan(Span fallback) -> Span {
        let mark = this.finalMark;
        if (mark == null) {
            return fallback;
        }
        return mark;
    }
}

// The resolved method a member declaration produced, or null when the declaration was refused.
public methodDeclaredBy(List<Method> methods, GreenNode declaration) -> Method? {
    for (long i = 0; i < methods.length(); i++) {
        if (methods.get(i).signature().declaration() == declaration) {
            return methods.get(i);
        }
    }
    return null;
}

// Why a binding cannot declare this member, or null when it may. A member the compiler provides
// is otherwise replaceable: a declaration with the same parameter list takes every call to it,
// which is how the library takes a member over. The exceptions are the property that is read
// without a call at all, and the two members a value also reaches through interpolation, struct
// serialization, and the type descriptors, where a replacement would take some of those and
// not others.
public unreplaceableMember(Type primitive, string name, Signature signature, TypeNames names)
        -> string? {
    if (primitive is StringType && name == "length") {
        return "'string.length' is the byte count, read without parentheses, so a method named "
            + "'length' could never be called. Choose another name.";
    }
    if (signature.parameters().length > 0) {
        return null;
    }
    if (name == "toString") {
        return "the text form of a value of type '{names.of(primitive)}' is what interpolation "
            + "reads too, so a binding cannot replace it. Declare an overload that takes "
            + "arguments instead, such as 'toString(int radix)'.";
    }
    if (name == "hash") {
        return "the hash of a value of type '{names.of(primitive)}' is what a map keyed by one "
            + "reads too, so a binding cannot replace it. Choose another name.";
    }
    return null;
}

// The intrinsic a bodiless binding member names, or null when the compiler implements none under
// that name at that exact shape.
public primitiveIntrinsic(TypeStore store, Type primitive, string name, Signature signature,
                          bool isStatic) -> PrimitiveIntrinsic? {
    if (!(primitive is StringType)) {
        return null;
    }
    let byteType = store.primitive(PrimitiveKind.Byte);
    let longType = store.primitive(PrimitiveKind.Long);
    let bytesType = store.arrayOf(byteType);
    let textType = store.stringType();
    if (isStatic) {
        if (name == "fromBytesUnchecked" && hasShape(signature, [bytesType], textType)) {
            return PrimitiveIntrinsic.StringFromBytesUnchecked;
        }
        return null;
    }
    if (name == "byteAt" && hasShape(signature, [longType], byteType)) {
        return PrimitiveIntrinsic.StringByteAt;
    }
    if (name == "toBytes" && hasShape(signature, [], bytesType)) {
        return PrimitiveIntrinsic.StringToBytes;
    }
    if (name == "sliceUnchecked" && hasShape(signature, [longType, longType], textType)) {
        return PrimitiveIntrinsic.StringSliceUnchecked;
    }
    return null;
}

// How the intrinsics of a primitive are written, for the diagnostic a bodiless member that names
// none of them reports.
public primitiveIntrinsicForms(Type primitive) -> string[] {
    if (primitive is StringType) {
        return ["'byteAt(long) -> byte'", "'toBytes() -> byte[]'",
            "'sliceUnchecked(long, long) -> string'",
            "'static fromBytesUnchecked(byte[]) -> string'"];
    }
    return [];
}

// Whether a declaration is exactly the shape an intrinsic is provided at. A default, a 'throws'
// clause, or an 'out' parameter is a shape the compiler does not implement, so each one fails
// here and is reported as the mismatch it is.
hasShape(Signature signature, Type[] parameterTypes, Type returnType) -> bool {
    let parameters = signature.parameters();
    if (parameters.length != parameterTypes.length || signature.returnType() != returnType) {
        return false;
    }
    if (signature.declaresThrows() || signature.isGeneric()) {
        return false;
    }
    for (long i = 0; i < parameters.length; i++) {
        if (parameters[i].type() != parameterTypes[i] || parameters[i].hasDefault()
                || parameters[i].isOut()) {
            return false;
        }
    }
    return true;
}

public functionModifiers(FunctionDeclarationNode declaration) -> MemberModifiers {
    let modifiers = new MemberModifiers();
    for (long i = 0; i < declaration.modifiersCount(); i++) {
        modifiers.add(declaration.modifiers(i).kind(), declaration.modifiers(i).span());
    }
    return modifiers;
}

public fieldModifiers(FieldDeclarationNode declaration) -> MemberModifiers {
    let modifiers = new MemberModifiers();
    for (long i = 0; i < declaration.modifiersCount(); i++) {
        modifiers.add(declaration.modifiers(i).kind(), declaration.modifiers(i).span());
    }
    return modifiers;
}

// True for a field that belongs to the type itself rather than to an instance, so it takes no
// layout slot and its initializer is no part of an instance's initialization.
public isTypeLevelField(FieldDeclarationNode declaration) -> bool {
    let modifiers = fieldModifiers(declaration);
    return modifiers.declaresStatic || modifiers.declaresLazy;
}

// What a declaration is, for the modifiers that suit one kind and not another. A member is a
// method, constructor, or destructor of a class, struct, or interface; a function is declared at
// the top level, where nothing inherits it.
enum DeclarationShape {
    Field,
    Member,
    Function,
}

// Why a declaration cannot carry a modifier, or null when it may. One table for every shape, so a
// modifier's rule and the phrase naming where it does belong are each written once. Each shape
// narrows this further where it is read, and a modifier the grammar gains later reaches the last
// arm and is refused everywhere until someone places it.
modifierProblem(SyntaxKind kind, DeclarationShape shape) -> string? {
    switch (kind) {
        PublicKeyword, PrivateKeyword, ProtectedKeyword, ExportKeyword -> {
            return null;
        },
        WeakKeyword -> {
            if (shape == DeclarationShape.Field) {
                return null;
            }
            return "'weak' goes on a class field that refers to an object without keeping it "
                + "alive, as in 'weak Parent? parent'";
        },
        NoreturnKeyword -> {
            if (shape != DeclarationShape.Field) {
                return null;
            }
            return "'noreturn' goes on a function or method that never finishes normally, because "
                + "it always throws or calls 'panic'";
        },
        AbstractKeyword -> {
            if (shape == DeclarationShape.Member) {
                return null;
            }
            return "'abstract' is for a method with no body, which each subclass then writes for "
                + "itself";
        },
        OverrideKeyword -> {
            if (shape == DeclarationShape.Member) {
                return null;
            }
            return "'override' is for a method that replaces one the type inherits";
        },
        FinalKeyword -> {
            if (shape == DeclarationShape.Member) {
                return null;
            }
            return "'final' stops a method from being overridden or a class from being extended";
        },
        SealedKeyword -> {
            return "'sealed' goes on a class, where it means only the same module can extend it";
        },
        ConstKeyword -> {
            if (shape == DeclarationShape.Field) {
                return null;
            }
            return "'const' goes on a field or a variable inside a function, as in "
                + "'const string name;' or 'const limit = 10'";
        },
        StaticKeyword -> {
            if (shape != DeclarationShape.Function) {
                return null;
            }
            return "'static' goes on a method or a 'const' field of a class or a struct, "
                + "where it makes the member belong to the type itself; a top-level function "
                + "already belongs to no instance";
        },
        LazyKeyword -> {
            if (shape == DeclarationShape.Field) {
                return null;
            }
            return "'lazy' goes on a 'const' field of a class or a struct, where it makes the "
                + "field's value belong to the type itself and be built on its first read, as "
                + "in 'lazy const Reader input = makeInput()'";
        },
        default -> {
            return "no field, method, or function takes it";
        },
    }
}

reportModifierProblem(Reporter reporter, SyntaxToken modifier, string subject, string problem) {
    string word = modifier.text();
    reporter.report("{subject} cannot be '{word}'; {problem}. Remove '{word}'.", modifier.span());
}

checkFieldModifiers(Reporter reporter, FieldDeclarationNode declaration) {
    string subject = "Field '{declaration.name().text()}'";
    for (long i = 0; i < declaration.modifiersCount(); i++) {
        let modifier = declaration.modifiers(i);
        let problem = modifierProblem(modifier.kind(), DeclarationShape.Field);
        if (problem != null) {
            reportModifierProblem(reporter, modifier, subject, problem);
        }
    }
}

checkCallableModifiers(Reporter reporter, FunctionDeclarationNode declaration, string subject,
                       DeclarationShape shape) {
    for (long i = 0; i < declaration.modifiersCount(); i++) {
        let modifier = declaration.modifiers(i);
        let problem = modifierProblem(modifier.kind(), shape);
        if (problem != null) {
            reportModifierProblem(reporter, modifier, subject, problem);
        }
    }
}

// How a declaration is named in a diagnostic about one of its modifiers: by its own name, or by
// what introduces it when it has none of its own.
declarationSubject(string kind, SyntaxToken? name) -> string {
    if (name == null || name.text().length == 0) {
        return "This {kind}";
    }
    return "{kind} '{name.text()}'";
}

public checkMemberModifiers(Reporter reporter, FunctionDeclarationNode declaration) {
    let introducer = declaration.introducer();
    string subject = declarationSubject("Method", declaration.name());
    if (introducer != null) {
        switch (introducer.kind()) {
            ConstructorKeyword -> {
                subject = "A constructor";
            },
            DestructorKeyword -> {
                subject = "A destructor";
            },
            default -> { },
        }
    }
    checkCallableModifiers(reporter, declaration, subject, DeclarationShape.Member);
}

public checkFunctionModifiers(Reporter reporter, FunctionDeclarationNode declaration) {
    checkCallableModifiers(reporter, declaration,
        declarationSubject("Function", declaration.name()), DeclarationShape.Function);
}

// A member's visibility as its modifiers write it. A member with no mark has the visibility
// 'types.unmarkedMemberVisibility' computes for its owner. The kind word, such as 'Field' or
// 'Constructor', names the member in a diagnostic.
public memberVisibility(MemberModifiers modifiers, DeclaredType owner, string memberKindWord,
                        string memberName, Reporter reporter, TypeNames names) -> Visibility {
    Visibility unmarked = types.unmarkedMemberVisibility(owner.visibility());
    return markedVisibility(modifiers, unmarked, owner, memberKindWord, memberName, reporter, names);
}

// A member's visibility with the given default for an unmarked member. A member marked wider than
// its owner is reported and capped at the owner's reach. A 'protected' mark is never refused here.
// It sits beside the ladder, and the leakage checks hold it to its own rule.
markedVisibility(MemberModifiers modifiers, Visibility defaultVisibility, DeclaredType owner,
                 string memberKindWord, string memberName, Reporter reporter, TypeNames names) -> Visibility {
    let mark = writtenVisibilityMark(modifiers, memberName, defaultVisibility, owner, reporter,
        names);
    if (mark == null || mark.marked == Visibility.Private) {
        return defaultVisibility;
    }
    Visibility declared = mark.marked;
    if (declared != Visibility.Protected
            && types.visibilityTier(declared) > types.visibilityTier(owner.visibility())) {
        string subject = "{memberKindWord} '{memberName}'";
        if (memberKindWord == "Constructor") {
            subject = "The constructor of '{names.nameOf(owner)}'";
        }
        reporter.report(overMarkedMessage(subject, declared, owner, names), mark.markSpan);
        return types.followedMemberVisibility(owner.visibility());
    }
    return declared;
}

// The refusal of a member marked more visible than its owner, with the fixes that compile. A member
// of a file-private owner drops its mark. A member of a 'public' owner is marked 'public' instead,
// or the owner is raised to the written mark.
overMarkedMessage(string subject, Visibility declared, DeclaredType owner, TypeNames names) -> string {
    string ownerName = names.nameOf(owner);
    string declaredWord = types.visibilityWord(declared);
    string problem = overMarkedProblem(subject, declared, owner, names);
    if (owner.visibility() == Visibility.Private) {
        return "{problem} Remove '{declaredWord}'. An unmarked member of '{ownerName}' already "
            + "reaches its whole file.";
    }
    string ownerWord = types.visibilityWord(owner.visibility());
    return "{problem} Replace '{declaredWord}' with '{ownerWord}', or mark '{ownerName}' "
        + "'{declaredWord}' too.";
}

// The sentence refusing a member marked more visible than its owner.
overMarkedProblem(string subject, Visibility declared, DeclaredType owner, TypeNames names) -> string {
    return "{subject} cannot be '{types.visibilityWord(declared)}' while '{names.nameOf(owner)}' "
        + "is {ownerReachPhrase(owner)}, because a member is never more visible than the type that holds it.";
}

// The first visibility mark written on a member, or null when it carries none. Every mark after
// the first and a written 'private' are reported here, once for every kind of member. 'unmarked'
// is the visibility the member has with no mark.
writtenVisibilityMark(MemberModifiers modifiers, string memberName, Visibility unmarked,
                      DeclaredType owner, Reporter reporter, TypeNames names) -> MemberVisibilityMark? {
    let marks = modifiers.visibilityMarks;
    if (marks.length() == 0) {
        return null;
    }
    for (long i = 1; i < marks.length(); i++) {
        reporter.report("'{memberName}' already has a visibility modifier; remove "
            + "'{types.visibilityWord(marks.get(i).marked)}'.", marks.get(i).markSpan);
    }
    let mark = marks.get(0);
    if (mark.marked == Visibility.Private) {
        reporter.report(privateMarkMessage(memberName, unmarked, owner, names), mark.markSpan);
    }
    return mark;
}

// The refusal of a written 'private', with how far the member reaches unmarked. A constructor's
// member name is 'constructor', its keyword.
privateMarkMessage(string memberName, Visibility unmarked, DeclaredType owner,
                   TypeNames names) -> string {
    string ownerName = names.nameOf(owner);
    string target = "'{memberName}'";
    if (memberName == "constructor") {
        target = "the constructor of '{ownerName}'";
    }
    if (owner.visibility() == Visibility.Private) {
        return "A member of '{ownerName}' always reaches the whole file '{ownerName}' is declared "
            + "in, so 'private' is never written. Remove it from {target}.";
    }
    if (unmarked != Visibility.Private) {
        return "'{memberName}' takes the visibility of '{ownerName}', so 'private' is never written. "
            + "Remove it.";
    }
    return "A member is private to its type unless it is marked, so 'private' is never written. "
        + "Remove it from {target}.";
}

// How far a type lets its members reach, as a diagnostic names it.
ownerReachPhrase(DeclaredType owner) -> string {
    if (owner.visibility() == Visibility.Private) {
        return "private to its file";
    }
    return "only '{types.visibilityWord(owner.visibility())}'";
}

// An override of a base class method writes the visibility of the method it replaces, capped at
// what its own class can hold. In a file-private class the override may also stay unmarked.
// An unmarked member there already reaches as far as the cap.
public overrideVisibility(MemberModifiers modifiers, DeclaredType owner, Method overridden,
                          string memberName, Span nameSpan, Reporter reporter,
                          TypeNames names) -> Visibility {
    Visibility inherited = overridden.visibility();
    Visibility reach = types.followedMemberVisibility(owner.visibility());
    Visibility required = inherited;
    if (types.visibilityTier(inherited) > types.visibilityTier(reach)) {
        required = reach;
    }
    string requiredWord = types.visibilityWord(required);
    Visibility unmarked = types.unmarkedMemberVisibility(owner.visibility());
    let mark = writtenVisibilityMark(modifiers, memberName, unmarked, owner, reporter, names);
    if (mark == null) {
        if (required == unmarked) {
            return required;
        }
        string problem = overrideRequirement(memberName, overridden, required, owner, names);
        reporter.report("{problem} Mark it '{requiredWord}'.", nameSpan);
        return required;
    }
    if (mark.marked == Visibility.Private || mark.marked == required) {
        return required;
    }
    string written = types.visibilityWord(mark.marked);
    string subject = "Override '{memberName}'";
    if (owner.visibility() == Visibility.Private) {
        reporter.report(overMarkedMessage(subject, mark.marked, owner, names), mark.markSpan);
    } else if (types.visibilityTier(mark.marked) > types.visibilityTier(owner.visibility())) {
        string problem = overMarkedProblem(subject, mark.marked, owner, names);
        if (inherited == mark.marked) {
            reporter.report("{problem} Replace '{written}' with '{requiredWord}', or mark "
                + "'{names.nameOf(owner)}' '{written}' too.", mark.markSpan);
        } else {
            reporter.report("{problem} Replace '{written}' with '{requiredWord}', the visibility of "
                + "the '{memberName}' it overrides in '{names.of(overridden.definingType())}'.",
                mark.markSpan);
        }
    } else {
        string problem = overrideRequirement(memberName, overridden, required, owner, names);
        reporter.report("{problem} Replace '{written}' with '{requiredWord}'.", mark.markSpan);
    }
    return required;
}

// The sentence naming the visibility an override must carry and where that requirement comes
// from. The requirement is the overridden method's visibility, or the owner's cap below it.
overrideRequirement(string memberName, Method overridden, Visibility required, DeclaredType owner,
                    TypeNames names) -> string {
    string requiredWord = types.visibilityWord(required);
    string baseName = names.of(overridden.definingType());
    if (overridden.visibility() == required) {
        return "Override '{memberName}' must be '{requiredWord}', the visibility of the "
            + "'{memberName}' it overrides in '{baseName}'.";
    }
    return "Override '{memberName}' must be '{requiredWord}', because the '{memberName}' it "
        + "overrides in '{baseName}' is '{types.visibilityWord(overridden.visibility())}' and "
        + "'{names.nameOf(owner)}' is {ownerReachPhrase(owner)}.";
}

// The behavior a member takes over from the language, or null for an ordinary member. The three
// are a type's text form and the hash and equality a value is keyed by. What an 'equals' replaces
// differs by kind, a struct's memberwise comparison against a class's identity. The text form is
// claimed by a 'toString' that takes no parameters, on either kind. One that takes parameters is
// an ordinary method the language never calls.
public builtinBehaviorReplaced(DeclaredType owner, string memberName,
                               Signature signature) -> string? {
    bool claimsTextForm = memberName == "toString" && signature.parameters().length == 0;
    if (owner is StructType) {
        if (claimsTextForm) {
            return "text form";
        }
        if (memberName == "hash") {
            return "content hash";
        }
        if (memberName == "equals" && equalsIntent(signature, owner)) {
            return "memberwise equality";
        }
        return null;
    }
    if (owner is ClassType) {
        if (claimsTextForm) {
            return "text form";
        }
        if (memberName == "hash") {
            return "identity hash";
        }
        if (memberName == "equals" && equalsIntent(signature, owner)) {
            return "identity equality";
        }
        return null;
    }
    return null;
}

// A member that replaces a built-in behavior runs wherever its type is used - through '==', a
// keyed collection, an interpolation hole - so it must be reachable wherever the type is nameable.
// Unmarked, it follows its type instead of taking the private member default; a narrower marker is
// rejected here, and a wider one is over-marked and reported by the shared member rule.
public builtinReplacementVisibility(MemberModifiers modifiers, DeclaredType owner,
                                    string memberName, string behavior,
                                    Reporter reporter, TypeNames names) -> Visibility {
    Visibility required = types.followedMemberVisibility(owner.visibility());
    let marks = modifiers.visibilityMarks;
    if (marks.length() == 0) {
        return required;
    }
    let mark = marks.get(0);
    bool overMarked = types.visibilityTier(mark.marked) > types.visibilityTier(owner.visibility());
    Visibility written = markedVisibility(modifiers, required, owner, "Method", memberName, reporter, names);
    if (!overMarked && written != required) {
        reporter.report("Method '{memberName}' replaces the built-in {behavior} of "
            + "{types.kindWordOf(owner)} '{names.nameOf(owner)}', so it must be as visible as "
            + "'{names.nameOf(owner)}' itself; mark it '{types.visibilityWord(required)}'.",
            mark.markSpan);
    }
    return required;
}

// The top-level reading of a member modifier list, for the signature phase's function entries:
// private when unmarked, and 'protected' counted as private because the declare phase already
// rejected it.
public topLevelVisibility(MemberModifiers modifiers) -> Visibility {
    let marks = modifiers.visibilityMarks;
    if (marks.length() == 0) {
        return Visibility.Private;
    }
    if (marks.get(0).marked == Visibility.Protected) {
        return Visibility.Private;
    }
    return marks.get(0).marked;
}

// Reads one field declaration; the owner-specific weak rules stay with the caller.
public readField(TypeResolver resolver, Reporter reporter, FieldDeclarationNode declaration,
                 DeclaredType owner, TypeNames names) -> Field {
    checkFieldModifiers(reporter, declaration);
    let modifiers = fieldModifiers(declaration);
    Type fieldType = resolver.resolveType(declaration.declaredType());
    Visibility visibility = memberVisibility(modifiers, owner, "Field", declaration.name().text(),
        reporter, names);
    return new Field(declaration.name().text(), fieldType, visibility,
        modifiers.declaresWeak, modifiers.declaresConst, modifiers.declaresStatic,
        modifiers.declaresLazy, declaration.defaultValue() != null, declaration.name().span(),
        owner);
}

// The shape of a static const field: 'const' and an initializer are mandatory because nothing
// else ever assigns it, its value is a compile-time constant so its type comes from the constant
// family, and it belongs to the type itself so it can mention no type parameter and hold no weak
// reference. The initializer's own rules are in the constants phase.
public checkStaticFieldShape(Reporter reporter, FieldDeclarationNode declaration, Field field,
                             TypeNames names) {
    let modifiers = fieldModifiers(declaration);
    string name = field.name();
    Span at = field.nameSpan();
    string shownType = names.of(field.type());
    if (!field.isConst()) {
        reporter.report("A 'static' field must also be 'const'. Write "
            + "'static const {shownType} {name} = ...', or make '{name}' an instance field.",
            modifiers.staticModifierSpan(at));
    }
    if (field.isWeak()) {
        reporter.report("A static const field cannot be 'weak': it holds a constant, not a "
            + "reference to an object. Remove 'weak'.", at);
    }
    if (declaration.defaultValue() == null) {
        reporter.report("Static const '{name}' needs its value on the declaration, because "
            + "nothing else ever assigns it: write 'static const {shownType} {name} = ...'.",
            at);
    }
    if (!isConstantFamily(field.type())) {
        reporter.report("Static const '{name}' has type '{shownType}', and a static const "
            + "holds a constant, whose type must be a primitive, 'char', 'bool', or 'string'.",
            at);
    } else if (convert.containsTypeParam(field.type())) {
        reporter.report("Static const '{name}' cannot have type '{shownType}': one "
            + "'static const' value is shared by every type argument, so its type cannot use "
            + "a type parameter.", at);
    }
}

// The shape of a lazy const field. 'const' and an initializer are mandatory because nothing else
// ever assigns it, and the value belongs to the type itself and is kept to the end of the
// program. What the initializer may contain is the body phase's rule, not this one's.
public checkLazyFieldShape(Reporter reporter, FieldDeclarationNode declaration, Field field,
                           TypeNames names) {
    let modifiers = fieldModifiers(declaration);
    string name = field.name();
    Span at = field.nameSpan();
    string shownType = names.of(field.type());
    if (modifiers.declaresStatic) {
        reporter.report("A 'lazy const' field already belongs to the type itself, so it cannot "
            + "also be 'static'. Remove 'static'.", modifiers.staticModifierSpan(at));
    }
    if (!field.isConst()) {
        reporter.report("A 'lazy' field must also be 'const'; its value is built once on the "
            + "first read and never changes. Write 'lazy const {shownType} {name} = ...', or "
            + "make '{name}' an instance field.", modifiers.lazyModifierSpan(at));
    }
    if (field.isWeak()) {
        reporter.report("A lazy const field cannot be 'weak': its value is kept until the "
            + "program ends. Remove 'weak'.", at);
    }
    if (declaration.defaultValue() == null) {
        reporter.report("Lazy const '{name}' needs its value on the declaration, because "
            + "nothing else ever assigns it: write 'lazy const {shownType} {name} = ...'.", at);
    }
    if (types.isVoidType(field.type())) {
        reporter.report("Lazy const '{name}' cannot have type 'void'; 'void' means no value. "
            + "Give '{name}' the type of the value its initializer builds.", at);
    } else if (convert.containsTypeParam(field.type())) {
        reporter.report("Lazy const '{name}' cannot have type '{shownType}': one 'lazy const' "
            + "value is shared by every type argument, so its type cannot use a type "
            + "parameter.", at);
    }
}

// How a diagnostic names a type-level const field, at the start of a sentence and inside one.
public typeLevelFieldNoun(Field field) -> string {
    if (field.isLazy()) {
        return "Lazy const";
    }
    return "Static const";
}

public typeLevelFieldWord(Field field) -> string {
    if (field.isLazy()) {
        return "lazy const";
    }
    return "static const";
}

// The types a compile-time constant can have. 'void' is excluded because it names no value, and
// error types pass so one failed resolution does not cascade.
isConstantFamily(Type type) -> bool {
    if (type is StringType || type is ErrorType || type is TypeParamType) {
        return true;
    }
    if (type is PrimitiveType) {
        return type.kind() != PrimitiveKind.Void;
    }
    return false;
}

// A static member never takes part in dispatch: it is not inherited, so nothing overrides it and
// nothing marks it 'final' or 'abstract'. Constructors and destructors describe instances, so
// they cannot be static either.
public checkStaticMethodMarkers(Reporter reporter, MemberModifiers modifiers, string methodName,
                                bool isConstructor, bool isDestructor, Span nameSpan) {
    if (!modifiers.declaresStatic) {
        return;
    }
    Span at = modifiers.staticModifierSpan(nameSpan);
    if (isConstructor) {
        reporter.report("A constructor cannot be 'static'; it always builds an instance. "
            + "Remove 'static', or make it a static method that returns the new instance.", at);
        return;
    }
    if (isDestructor) {
        reporter.report("A destructor cannot be 'static'; it runs when an instance is "
            + "destroyed. Remove 'static'.", at);
        return;
    }
    if (modifiers.declaresAbstract) {
        reporter.report("Static method '{methodName}' cannot be 'abstract': a static is "
            + "called through the type name, so no subclass could supply its body. Remove one "
            + "of the two.", at);
    }
    if (modifiers.declaresOverride) {
        reporter.report("Static method '{methodName}' cannot be 'override': statics are not "
            + "inherited, so there is nothing to override. Remove one of the two.", at);
    }
    if (modifiers.declaresFinal) {
        reporter.report("Static method '{methodName}' cannot be 'final': statics are not "
            + "inherited, so there is no override to forbid. Remove one of the two.", at);
    }
}

// Type-level members share one namespace with instance members, so the same name on both sides
// is rejected like any other duplicate. A declared static is checked against the inherited
// instance members as well as the owner's own, while a declared instance member is checked
// against the owner's own statics alone, because statics are not inherited.
public checkStaticInstanceCollision(Reporter reporter, DeclaredType owner, string memberName,
                                    bool memberIsStatic, Span span, TypeNames names,
                                    Field? declared = null) {
    if (memberName.length == 0) {
        return;
    }
    if (memberIsStatic) {
        string noun = "Static member";
        string kind = "a static";
        if (declared != null && declared.isLazy()) {
            noun = typeLevelFieldNoun(declared);
            kind = "a {typeLevelFieldWord(declared)}";
        }
        let field = types.inheritedOrOwnField(owner, memberName);
        if (field != null) {
            reporter.report("{noun} '{memberName}' has the same name as a field of "
                + "'{names.of(field.definingType())}'; {kind} and an instance member "
                + "cannot share a name. Rename one of the two.", span);
            return;
        }
        let method = types.inheritedOrOwnMethod(owner, memberName);
        if (method != null) {
            reporter.report("{noun} '{memberName}' has the same name as a method of "
                + "'{names.of(method.definingType())}'; {kind} and an instance member cannot "
                + "share a name. Rename one of the two.", span);
        }
        return;
    }
    let staticField = findField(types.staticFieldsOf(owner), memberName);
    if (staticField != null) {
        reporter.report("'{memberName}' is already declared as a "
            + "{typeLevelFieldWord(staticField)} of '{names.nameOf(owner)}'; a static and an instance "
            + "member cannot share a name. Rename one of the two.", span);
        return;
    }
    let staticMethod = findMethodNamed(types.staticMethodsOf(owner), memberName);
    if (staticMethod != null) {
        reporter.report("'{memberName}' is already declared as a static method of "
            + "'{names.nameOf(owner)}'; a static and an instance member cannot share a name. Rename "
            + "one of the two.", span);
    }
}

// Reads one static method into its owner's static list: the signature, the marker, throws, and
// collision rules, and the duplicate-overload check. Shared by the struct signature phase and
// the class layout phase, which differ only in when they run. Statics may overload each other
// under the ordinary overload rules; explicit throws types stay reserved for overridable
// methods, and a static is never overridable.
public collectStaticMethod(TypeResolver resolver, Reporter reporter, DeclaredType owner,
                           List<Method> staticMethods, FunctionDeclarationNode member,
                           string methodName, Span nameSpan, MemberModifiers modifiers,
                           TypeNames names, bool allowBodiless = false) {
    MemberConstraint[] constraints = readMemberConstraints(resolver, reporter, owner, member,
        "Static method '{methodName}' of '{names.nameOf(owner)}'", names);
    if (constraints.length > 0) {
        resolver.pushMemberConstraints(owner.declaration(), constraints);
    }
    let signature = buildSignature(resolver, reporter, member, methodName, nameSpan, false,
        false, allowBodiless, modifiers.declaresNoreturn, null, names, []);
    if (constraints.length > 0) {
        resolver.popMemberConstraints();
    }
    Visibility visibility = memberVisibility(modifiers, owner, "Method", methodName, reporter, names);
    checkStaticMethodMarkers(reporter, modifiers, methodName, false, false, nameSpan);
    checkThrowsPlacement(reporter, member, false, modifiers.declaresAbstract);
    checkNoreturnPlacement(reporter, member, false, false, modifiers.declaresNoreturn);
    checkStaticInstanceCollision(reporter, owner, methodName, true, nameSpan, names);
    checkStaticFieldMethodCollision(reporter, owner, methodName, nameSpan, names);
    if (findSameSignature(staticMethods, methodName, signature) != null) {
        reporter.report("Static method '{methodName}' of '{names.nameOf(owner)}' is already "
            + "declared with the same parameter types; overloads must differ in parameter count "
            + "or types.", nameSpan);
        return;
    }
    staticMethods.push(new Method(signature, visibility, false, false, false, false, false,
        true, member.body() != null, constraints, owner));
}

// A static method may not share its name with a static const of the same type; the two sides of
// the static namespace collide exactly as a field and a method do.
public checkStaticFieldMethodCollision(Reporter reporter, DeclaredType owner, string methodName,
                                       Span span, TypeNames names) {
    let collided = findField(types.staticFieldsOf(owner), methodName);
    if (collided != null) {
        reporter.report("'{methodName}' is already declared as a "
            + "{typeLevelFieldWord(collided)} of '{names.nameOf(owner)}'; a field and a method cannot "
            + "share a name.", span);
    }
}

// Reads a member's type-parameter list as constraints on the enclosing type's parameters: a name
// matching an enclosing parameter must carry a bound and constrains it, a name matching none is
// rejected because a member cannot introduce type parameters of its own, and a list on a
// non-generic type is rejected whole. The bounds resolve under the shared bound rules.
public readMemberConstraints(TypeResolver resolver, Reporter reporter, DeclaredType owner,
                             FunctionDeclarationNode member, string memberSubject,
                             TypeNames names)
        -> MemberConstraint[] {
    let list = member.typeParameters();
    if (list == null) {
        return [];
    }
    string[] parameterNames = owner.typeParameters();
    if (parameterNames.length == 0) {
        reporter.report("{memberSubject} cannot have a type-parameter list, because "
            + "'{names.nameOf(owner)}' declares no type parameters for it to constrain. Remove "
            + "the '<...>' list.", list.span());
        return [];
    }
    let constraints = new List<MemberConstraint>();
    for (long i = 0; i < list.parametersCount(); i++) {
        let declaration = list.parameters(i);
        string name = declaration.name().text();
        if (name.length == 0) {
            continue;
        }
        long index = parameterIndexNamed(parameterNames, name);
        if (index < 0) {
            reporter.report("'{name}' does not name a type parameter of '{names.nameOf(owner)}', whose "
                + "parameters are {quotedNameList(parameterNames)}. A member can constrain "
                + "those, but cannot introduce type parameters of its own.",
                declaration.name().span());
            continue;
        }
        bool repeated = false;
        for (long c = 0; c < constraints.length(); c++) {
            if (constraints.get(c).parameterIndex() == index) {
                repeated = true;
                break;
            }
        }
        if (repeated) {
            reporter.report("Type parameter '{name}' is already constrained in this list; "
                + "write one entry per parameter and join its bounds with '+'.",
                declaration.name().span());
            continue;
        }
        let boundsClause = declaration.bounds();
        if (boundsClause == null) {
            reporter.report("'{name}' restates type parameter '{name}' of '{names.nameOf(owner)}' but "
                + "adds no bound. Write the bound this member needs, as in "
                + "'<{name}: Comparable<{name}>>'.", declaration.name().span());
            continue;
        }
        Type[] bounds = resolver.resolveBoundList(name, boundsClause);
        if (bounds.length > 0) {
            constraints.push(new MemberConstraint(index, bounds));
        }
    }
    return constraints.toArray();
}

parameterIndexNamed(string[] names, string name) -> long {
    for (long i = 0; i < names.length; i++) {
        if (names[i] == name) {
            return i;
        }
    }
    return -1;
}

// "'T'" or "'K' and 'V'", the way a list of parameter names reads in a diagnostic.
quotedNameList(string[] names) -> string {
    string text = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            if (i + 1 == names.length) {
                text = text + " and ";
            } else {
                text = text + ", ";
            }
        }
        text = text + "'{names[i]}'";
    }
    return text;
}

// A conditional member exists only where its constraints hold, so it can neither replace a
// member that exists everywhere nor leave a hole for a subclass to fill: 'override' and
// 'abstract' are both rejected. Constructors and statics reject those markers on their own, so
// this covers instance methods.
public checkConditionalMarkers(Reporter reporter, MemberConstraint[] constraints,
                               MemberModifiers modifiers, string memberName, DeclaredType owner,
                               Span nameSpan, TypeNames names) {
    if (constraints.length == 0) {
        return;
    }
    if (modifiers.declaresOverride) {
        reporter.report("Method '{memberName}' of '{names.nameOf(owner)}' cannot be both conditional "
            + "and 'override': it exists only for some type arguments, and the method it "
            + "replaces exists for all of them. Remove 'override', or remove the '<...>' "
            + "constraint list.", nameSpan);
    }
    if (modifiers.declaresAbstract) {
        reporter.report("Method '{memberName}' of '{names.nameOf(owner)}' cannot be both conditional "
            + "and 'abstract': a conditional member cannot be overridden, so no subclass could "
            + "supply its body. Remove 'abstract', or remove the '<...>' constraint list.",
            nameSpan);
    }
}

public findMethodNamed(List<Method>? methods, string name) -> Method? {
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (method.isConstructor() || method.isDestructor()) {
            continue;
        }
        if (method.name() == name) {
            return method;
        }
    }
    return null;
}

// Resolves one callable's signature, meaning its parameters, its return type and its declared
// throws list. A 'this.field' parameter binds the field its name reaches on the receiver. A
// private field of a base class is not inherited, so a receiver that did not declare it has no
// field of that name to bind.
public buildSignature(TypeResolver resolver, Reporter reporter,
                      FunctionDeclarationNode declaration, string name, Span nameSpan,
                      bool isConstructor, bool isInterfaceMethod, bool allowBodiless,
                      bool isNoreturn, DeclaredType? receiverType, TypeNames names,
                      TypeParamType[] typeParameters) -> Signature {
    let store = resolver.typeStore();
    if (declaration.body() == null && declaration.semicolon() != null && !allowBodiless) {
        reporter.report("Shorthand declaration ';' is only allowed on a constructor.", nameSpan);
    }

    let parameterList = declaration.parameters();
    let parameters = new List<Parameter>();
    bool seenDefault = false;
    for (long i = 0; i < parameterList.parametersCount(); i++) {
        let parameterNode = parameterList.parameters(i);
        string parameterName = parameterNode.name().text();
        bool bindsField = parameterNode.thisPrefix() != null;
        bool hasDefault = parameterNode.defaultValue() != null;
        Span parameterSpan = parameterNode.span();
        if (isInterfaceMethod && hasDefault) {
            reporter.report("An interface method's parameters cannot have default values; "
                + "each implementing class chooses its own.", parameterSpan);
        }
        Type parameterType = store.errorType();
        if (bindsField) {
            if (!isConstructor) {
                reporter.report("'this.{parameterName}' parameters are only allowed in a "
                    + "constructor.", parameterSpan);
            } else if (receiverType == null) {
                reporter.report("Internal: a constructor with no receiver type has the "
                    + "parameter 'this.{parameterName}'.", parameterSpan);
            } else {
                let bound = types.inheritedOrOwnField(receiverType, parameterName);
                if (bound != null) {
                    parameterType = bound.type();
                } else {
                    reportUnboundShorthand(reporter, receiverType, parameterName, parameterSpan,
                        names);
                }
            }
        } else {
            let declaredType = parameterNode.declaredType();
            if (declaredType != null) {
                parameterType = resolver.resolveType(declaredType);
            }
        }
        if (hasDefault) {
            seenDefault = true;
        } else if (seenDefault) {
            reporter.report("Parameter '{parameterName}' has no default but follows a "
                + "defaulted parameter.", parameterSpan);
        }
        parameters.push(new Parameter(parameterName, parameterType, bindsField,
            parameterNode.outKeyword() != null, hasDefault, parameterSpan));
    }

    Type returnType = store.primitive(PrimitiveKind.Void);
    let returnClause = declaration.returnType();
    if (returnClause != null) {
        returnType = resolver.resolveReturnType(returnClause.returnedType());
    }

    let throwsClause = declaration.throwsClause();
    let throwsTypes = new List<Type>();
    let throwsSpans = new List<Span>();
    if (throwsClause != null) {
        for (long i = 0; i < throwsClause.typesCount(); i++) {
            let reference = throwsClause.types(i);
            throwsTypes.push(resolver.resolveType(reference));
            throwsSpans.push(reference.span());
        }
    }

    return new Signature(name, parameters.toArray(), returnType, throwsClause != null,
        isNoreturn, throwsTypes.toArray(), throwsSpans.toArray(), typeParameters,
        declaration.green(), nameSpan);
}

// Reports a 'this.field' parameter that binds no field of the receiver. The name can still be a
// private field of a base class, which the receiver does not inherit. The refusal names that
// field, rather than reporting a field nothing declares.
reportUnboundShorthand(Reporter reporter, DeclaredType receiverType, string parameterName,
                       Span parameterSpan, TypeNames names) {
    let uninherited = findField(types.fieldsOf(receiverType), parameterName);
    if (uninherited == null) {
        reporter.report("No field '{parameterName}' on type '{names.nameOf(receiverType)}'. "
            + "Drop 'this.' and give the parameter a type, as in 'int {parameterName}'.",
            parameterSpan);
        return;
    }
    // The class that declares the field is where a fix goes, so a generic base reads as its
    // declaration's name rather than as the instantiation the subclass extends.
    string declaringName = names.of(uninherited.definingType());
    let declaring = types.authorityOf(uninherited.definingType());
    if (declaring != null) {
        declaringName = names.nameOf(declaring);
    }
    reporter.report("'{parameterName}' is private to '{declaringName}', so "
        + "'{names.nameOf(receiverType)}' has no field by that name. Declare one in "
        + "'{names.nameOf(receiverType)}', or mark '{parameterName}' 'protected' in "
        + "'{declaringName}'.", parameterSpan);
}

// 'noreturn' is legal on free functions and methods, including abstract and interface methods,
// where it is part of the contract. It is never legal on a constructor or destructor, and a
// 'noreturn' callable declares no return type because it returns nothing at all.
public checkNoreturnPlacement(Reporter reporter, FunctionDeclarationNode declaration,
                              bool isConstructor, bool isDestructor, bool isNoreturn) {
    if (!isNoreturn) {
        return;
    }
    Span at = noreturnModifierSpan(declaration);
    if (isConstructor) {
        reporter.report("A constructor cannot be marked 'noreturn'; a constructor always "
            + "returns the new instance. Remove 'noreturn'.", at);
        return;
    }
    if (isDestructor) {
        reporter.report("A destructor cannot be marked 'noreturn'; it runs during cleanup and "
            + "must return. Remove 'noreturn'.", at);
        return;
    }
    let returnClause = declaration.returnType();
    if (returnClause != null) {
        reporter.report("A 'noreturn' function never returns a value, so it declares no return "
            + "type. Remove the '-> ...' clause after the parameter list.",
            returnClause.arrow().span());
    }
}

noreturnModifierSpan(FunctionDeclarationNode declaration) -> Span {
    for (long i = 0; i < declaration.modifiersCount(); i++) {
        if (declaration.modifiers(i).kind() == SyntaxKind.NoreturnKeyword) {
            return declaration.modifiers(i).span();
        }
    }
    return declaration.parameters().span();
}

// The field a name reaches in a list, searched most derived first, because a class's flattened
// layout holds its inherited fields before its own. A name written on a receiver is resolved by
// types.inheritedOrOwnField instead, which leaves out a private base field the receiver's type
// does not inherit.
public findField(List<Field>? fields, string name) -> Field? {
    if (fields == null) {
        return null;
    }
    for (long i = fields.length() - 1; i >= 0; i--) {
        if (fields.get(i).name() == name) {
            return fields.get(i);
        }
    }
    return null;
}

// A method may not share its name with a field of the same type or an inherited one.
public checkFieldMethodCollision(Reporter reporter, DeclaredType owner, string methodName,
                                 bool isConstructor, Span span, TypeNames names) {
    if (isConstructor) {
        return;
    }
    let collided = types.inheritedOrOwnField(owner, methodName);
    if (collided != null) {
        reporter.report("'{methodName}' is already declared as a field of "
            + "'{names.of(collided.definingType())}'; a field and a method cannot share "
            + "a name.", span);
    }
}

// An abstract method has no body to infer thrown types from, so its clause must list them.
public checkThrowsPlacement(Reporter reporter, FunctionDeclarationNode declaration,
                            bool isConstructor, bool isAbstract) {
    let throwsClause = declaration.throwsClause();
    if (throwsClause == null) {
        return;
    }
    Span at = throwsClause.throwsKeyword().span();
    if (isConstructor) {
        reporter.report("A constructor cannot be marked 'throws'. Handle the exceptions with a "
            + "'catch' clause after the constructor body.", at);
        return;
    }
    if (isAbstract && throwsClause.typesCount() == 0) {
        reporter.report("An abstract method marked 'throws' must list its exception types, "
            + "for example 'throws IOError'.", at);
    }
}

public hashSignatureConforms(Signature signature) -> bool {
    if (signature.parameters().length != 0 || signature.declaresThrows()) {
        return false;
    }
    let returned = signature.returnType();
    if (returned is PrimitiveType) {
        return returned.kind() == PrimitiveKind.Long;
    }
    return false;
}

// 'hash' is a reserved method name: any declaration must match the contract that keyed
// collections rely on, and it may not fail, because the language takes a value's hash where
// no caller could write a 'try'.
public checkHashSignature(Reporter reporter, FunctionDeclarationNode declaration,
                          Signature signature, bool isConstructor) {
    if (isConstructor || signature.name() != "hash") {
        return;
    }
    let throwsClause = declaration.throwsClause();
    if (throwsClause != null) {
        reporter.report("A method named 'hash' cannot be marked 'throws': a hash is taken "
            + "where no 'try' can be written, such as on a Map or Set key. Remove 'throws', or "
            + "rename the method.", throwsClause.throwsKeyword().span());
    }
    bool returnsLong = false;
    let returned = signature.returnType();
    if (returned is PrimitiveType) {
        returnsLong = returned.kind() == PrimitiveKind.Long;
    }
    if (signature.parameters().length != 0 || !returnsLong) {
        reporter.report("A method named 'hash' must have the signature 'hash() -> long'.",
            signature.nameSpan());
    }
}

public toStringSignatureConforms(Signature signature) -> bool {
    if (signature.parameters().length > 0 || signature.declaresThrows()) {
        return false;
    }
    return signature.returnType() is StringType;
}

// A struct or a class renders as text through a 'toString' that takes no parameters, and such a
// declaration has to give a 'string' result with no 'throws', for a caller that has nowhere to
// write 'try'. A 'toString' that takes parameters is an ordinary method on either kind, and this
// does not cover it.
public checkToStringSignature(Reporter reporter, FunctionDeclarationNode declaration,
                              Signature signature, bool isConstructor) {
    if (isConstructor || signature.name() != "toString") {
        return;
    }
    if (signature.parameters().length > 0) {
        return;
    }
    let throwsClause = declaration.throwsClause();
    if (throwsClause != null) {
        reporter.report("A method named 'toString' cannot be marked 'throws': a text form is "
            + "taken where no 'try' can be written, such as inside a '\{...\}' in a string. "
            + "Remove 'throws', or rename the method.", throwsClause.throwsKeyword().span());
    }
    if (!(signature.returnType() is StringType)) {
        reporter.report("A method named 'toString' must have the signature 'toString() -> "
            + "string'. Give it a 'string' result, or a parameter to make it an ordinary "
            + "method.", signature.nameSpan());
    }
}

// The behaviors a struct has of its own, its text form, its content hash and its memberwise
// equality, must carry 'override' exactly as a class's 'hash' and 'equals' do. A near-miss shape
// gets its own signature diagnostic instead. Whether a marked member replaces or implements
// anything at all is a whole-program question the declaration checks settle.
public checkStructOverrideMarker(Reporter reporter, StructType owner, string memberName,
                                 Signature signature, MemberModifiers modifiers,
                                 bool isConstructor, string? behavior, TypeNames names) {
    if (isConstructor) {
        if (modifiers.declaresOverride || modifiers.declaresAbstract) {
            reporter.report("A constructor cannot be 'override' or 'abstract'.",
                signature.nameSpan());
        }
        return;
    }
    if (modifiers.declaresOverride || behavior == null) {
        return;
    }
    bool conforms = toStringSignatureConforms(signature);
    if (memberName == "hash") {
        conforms = hashSignatureConforms(signature);
    }
    if (memberName == "equals") {
        conforms = equalsSignatureConforms(signature, owner);
    }
    if (conforms) {
        reporter.report("Method '{memberName}' overrides the built-in {behavior} of struct "
            + "'{names.nameOf(owner)}'; mark it 'override'.", signature.nameSpan());
    }
}

// 'abstract' leaves a member for a subclass to implement, and a struct is never a base type, so
// the member could never be given a body. A struct constructor is rejected as a pair with
// 'override' above.
public checkStructAbstractMarker(Reporter reporter, StructType owner, string memberName,
                                 Signature signature, MemberModifiers modifiers,
                                 bool isConstructor, TypeNames names) {
    if (isConstructor || !modifiers.declaresAbstract) {
        return;
    }
    reporter.report("Method '{memberName}' of struct '{names.nameOf(owner)}' cannot be 'abstract'; a "
        + "struct has no subclass to give it a body. Give '{memberName}' a body, or move it to "
        + "an abstract class.", signature.nameSpan());
}

// True when the signature is the equality contract for its owner: one parameter of the owner's
// own type returning bool.
public equalsSignatureConforms(Signature signature, Type owner) -> bool {
    if (!equalsIntent(signature, owner)) {
        return false;
    }
    let returned = signature.returnType();
    if (returned is PrimitiveType) {
        return returned.kind() == PrimitiveKind.Bool;
    }
    return false;
}

// A single same-type parameter marks an equality method even when the rest of its shape is
// wrong; the near misses get signature diagnostics instead of pairing ones.
public equalsIntent(Signature signature, Type owner) -> bool {
    if (signature.parameters().length != 1) {
        return false;
    }
    return signature.parameters()[0].type() == owner;
}

public checkEqualsSignature(Reporter reporter, FunctionDeclarationNode declaration,
                            Signature signature, Type owner, bool isConstructor,
                            TypeNames names) {
    if (isConstructor || signature.name() != "equals" || !equalsIntent(signature, owner)) {
        return;
    }
    let throwsClause = declaration.throwsClause();
    if (throwsClause != null) {
        reporter.report("A method named 'equals' cannot be marked 'throws'; equality "
            + "comparison must not fail.", throwsClause.throwsKeyword().span());
    }
    if (!equalsSignatureConforms(signature, owner)) {
        reporter.report("A method named 'equals' that takes a '{names.of(owner)}' must "
            + "return 'bool'; it is what '==' uses to compare two '{names.of(owner)}' values.",
            signature.nameSpan());
    }
}

// 'hash' and 'equals' are a matched pair: equal values must hash equally, or keyed collections
// silently misbehave. A class or a struct that customizes one must customize the other, for a
// class here or in a base class. Reported once, on the type that first supplies a conforming half
// without its counterpart; a struct has no base chain, so the walk stops at itself.
public checkHashEqualsPairing(Reporter reporter, DeclaredType owner, Span at, TypeNames names) {
    let own = types.methodsOf(owner);
    if (own == null) {
        return;
    }
    bool ownHash = false;
    bool ownEquals = false;
    for (long i = 0; i < own.length(); i++) {
        let method = own.get(i);
        if (method.name() == "hash" && hashSignatureConforms(method.signature())) {
            ownHash = true;
        }
        if (method.name() == "equals" && equalsSignatureConforms(method.signature(), owner)) {
            ownEquals = true;
        }
    }
    if (!ownHash && !ownEquals) {
        return;
    }
    bool hashAnywhere = false;
    bool equalsAnywhere = false;
    Type? current = owner;
    while (current != null) {
        let methods = types.methodsOf(current);
        if (methods == null) {
            break;
        }
        for (long i = 0; i < methods.length(); i++) {
            let method = methods.get(i);
            if (method.name() == "hash") {
                hashAnywhere = true;
            }
            if (method.name() == "equals" && equalsIntent(method.signature(), method.definingType())) {
                equalsAnywhere = true;
            }
        }
        current = types.baseOf(current);
    }
    string kind = "Class";
    if (owner is StructType) {
        kind = "Struct";
    }
    if (ownHash && !equalsAnywhere) {
        reporter.report("{kind} '{names.nameOf(owner)}' defines 'hash' but not 'equals', and equal "
            + "values have to hash equally. Add an "
            + "'equals({names.nameOf(owner)} other) -> bool' method.", at);
    }
    if (ownEquals && !hashAnywhere) {
        reporter.report("{kind} '{names.nameOf(owner)}' defines 'equals' but not 'hash', and equal "
            + "values have to hash equally. Add a 'hash() -> long' method.", at);
    }
}

// The first already-recorded method with the same name and parameter types, or null.
public findSameSignature(List<Method> methods, string name, Signature signature)
        -> Method? {
    for (long i = 0; i < methods.length(); i++) {
        let candidate = methods.get(i);
        if (candidate.name() == name && types.sameParameterTypes(candidate.signature(), signature)) {
            return candidate;
        }
    }
    return null;
}
