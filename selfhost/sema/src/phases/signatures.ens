// The per-module signature phase. After linking, every module resolves its declared shapes
// against the type store. Class members are left for the whole-program layout phase, which runs
// bases first.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import EnumDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ExternalBlockNode from @ens.frontend.syntax.generated.nodes;
import ExternalFunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import support.paths;
import BuiltinFunction from context;
import ModuleContext from context;
import ClassItem from context;
import FunctionEntry from context;
import ImportedNamespace from phases.link;
import RefusedImport from phases.link;
import ImportedType from phases.link;
import phases.members;
import phases.signatures.declaredtypes;
import MemberModifiers from phases.members;
import TypeResolver from phases.resolve;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import ExternalType from model.types;
import InterfaceType from model.types;
import Parameter from model.types;
import Signature from model.types;
import Visibility from model.types;
import TypeNames from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Resolves every type declaration's type parameter list, bounds included. Runs for every module
// before any module resolves signatures, so bound checks have the bounds at every reference site
// regardless of module order. Diagnostics stay with the resolver until the signature pass drains
// them.
public resolveTypeParameterLists(ModuleContext context) {
    let root = context.root();
    if (root == null) {
        return;
    }
    let resolver = context.resolver();
    let store = resolver.typeStore();
    string modulePath = context.module().canonicalPath();
    for (long i = 0; i < root.itemsCount(); i++) {
        switch (root.items(i)) {
            is StructDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.name().text(), declaration.typeParameters()));
                }
            },
            is ClassDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.name().text(), declaration.typeParameters()));
                }
            },
            is InterfaceDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.name().text(), declaration.typeParameters()));
                }
            },
            default -> { },
        }
    }
}

// One module's signature results: the classes it declares, paired with their declarations for the
// layout phase, and the diagnostics resolving them produced.
public class SignatureResult {
    List<ClassItem> declaredClasses;
    FileDiagnostic[] signatureDiagnostics;

    protected constructor(List<ClassItem> classes, FileDiagnostic[] diagnostics) {
        this.declaredClasses = classes;
        this.signatureDiagnostics = diagnostics;
    }

    public classItems() -> List<ClassItem> {
        return this.declaredClasses;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.signatureDiagnostics;
    }
}

// Resolves one module's signatures, returning the classes it declares and its diagnostics.
public resolveModule(ModuleContext context) -> SignatureResult {
    let collected = new List<FileDiagnostic>();
    let collector = new SignatureCollector(context, collected);
    collector.run();
    for (let diagnostic in context.resolver().takeDiagnostics()) {
        collected.push(diagnostic);
    }
    return new SignatureResult(collector.classItems(), diagnostics.sorted(collected));
}

// One module's declarations, gathered by kind, and the state the signature steps resolve them with.
public final class SignatureCollector {
    ModuleContext moduleContext;
    TypeResolver typeResolver;
    Reporter fileReporter;
    TypeNames typeNames;
    string canonicalPath;

    List<ClassItem> declaredClasses;

    List<StructDeclarationNode> structNodes;
    List<ClassDeclarationNode> classNodes;
    List<InterfaceDeclarationNode> interfaceNodes;
    List<EnumDeclarationNode> enumNodes;
    List<FunctionDeclarationNode> functionNodes;
    List<TestDeclarationNode> testNodes;
    List<ExternalBlockNode> externalBlockNodes;
    List<PrimitiveDeclarationNode> primitiveNodes;

    protected constructor(ModuleContext context, List<FileDiagnostic> collected) {
        this.moduleContext = context;
        this.typeResolver = context.resolver();
        this.fileReporter = new Reporter(context.module().filePath(), collected);
        this.typeNames = context.names();
        this.canonicalPath = context.module().canonicalPath();
        this.declaredClasses = new List<ClassItem>();
        this.structNodes = new List<StructDeclarationNode>();
        this.classNodes = new List<ClassDeclarationNode>();
        this.interfaceNodes = new List<InterfaceDeclarationNode>();
        this.enumNodes = new List<EnumDeclarationNode>();
        this.functionNodes = new List<FunctionDeclarationNode>();
        this.testNodes = new List<TestDeclarationNode>();
        this.externalBlockNodes = new List<ExternalBlockNode>();
        this.primitiveNodes = new List<PrimitiveDeclarationNode>();
    }

    public context() -> ModuleContext {
        return this.moduleContext;
    }

    public resolver() -> TypeResolver {
        return this.typeResolver;
    }

    public reporter() -> Reporter {
        return this.fileReporter;
    }

    // The names this module's file has for the program's types.
    public names() -> TypeNames {
        return this.typeNames;
    }

    // The module's canonical path, which the type store keys its declared types by.
    public modulePath() -> string {
        return this.canonicalPath;
    }

    // The classes this module declares, each paired with its declaration for the layout phase.
    public classItems() -> List<ClassItem> {
        return this.declaredClasses;
    }

    // The structs this module declares, in source order.
    public structDeclarations() -> List<StructDeclarationNode> {
        return this.structNodes;
    }

    // The classes this module declares, in source order.
    public classDeclarations() -> List<ClassDeclarationNode> {
        return this.classNodes;
    }

    // The interfaces this module declares, in source order.
    public interfaceDeclarations() -> List<InterfaceDeclarationNode> {
        return this.interfaceNodes;
    }

    // The enums this module declares, in source order.
    public enumDeclarations() -> List<EnumDeclarationNode> {
        return this.enumNodes;
    }

    // The primitive bindings this module declares, in source order.
    public primitiveDeclarations() -> List<PrimitiveDeclarationNode> {
        return this.primitiveNodes;
    }

    protected run() {
        this.seedBuiltins();
        let root = this.moduleContext.root();
        if (root == null) {
            return;
        }
        this.gather(root);
        declaredtypes.collectStructFields(this);
        declaredtypes.collectStructMethods(this);
        declaredtypes.collectInterfaces(this);
        declaredtypes.collectEnums(this);
        declaredtypes.resolveClassBases(this);
        declaredtypes.collectPrimitiveBindings(this);
        this.collectFunctions();
        this.collectExternalFunctions();
        this.checkTests();
    }

    gather(SourceFileNode root) {
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is StructDeclarationNode declaration -> {
                    this.structNodes.push(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.classNodes.push(declaration);
                },
                is InterfaceDeclarationNode declaration -> {
                    this.interfaceNodes.push(declaration);
                },
                is EnumDeclarationNode declaration -> {
                    this.enumNodes.push(declaration);
                },
                is FunctionDeclarationNode declaration -> {
                    this.functionNodes.push(declaration);
                },
                is TestDeclarationNode declaration -> {
                    this.testNodes.push(declaration);
                },
                is ExternalBlockNode declaration -> {
                    this.externalBlockNodes.push(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.primitiveNodes.push(declaration);
                },
                default -> { },
            }
        }
    }

    // The functions the language provides in every module. A declaration may overload one with a
    // different parameter list, or take it over by matching its parameter types exactly.
    seedBuiltins() {
        let store = this.typeResolver.typeStore();
        Span nowhere = source.makeSpan(0, 0);
        let message = new Parameter("message", store.stringType(), false, false, false, nowhere);
        Type voidType = store.primitive(PrimitiveKind.Void);
        let panic = new Signature("panic", [message], voidType, false, true, [], [], [], null,
            nowhere);
        this.moduleContext.functions().add(new FunctionEntry(panic, Visibility.Export, false,
            BuiltinFunction.Panic, ""));
    }

    // The declared type a node owns, or null when a duplicate declaration lost its name.

    // The refusal of a 'main' declared outside the program's own main module. A dependency's
    // main module is its package's, so moving the function there fixes nothing.
    misplacedMainMessage() -> string {
        string rule = "Function 'main' starts the program, so only the program's main module, "
            + "'main.ens', can declare it.";
        string packageName = this.moduleContext.module().packagePrefix();
        if (packageName.length > 0 && this.canonicalPath == "{packageName}.main") {
            string fix = "Rename this function.";
            string imported = this.moduleContext.firstImport();
            if (imported.length > 0) {
                fix = "Rename this function, or remove {imported}.";
            }
            return "{rule} This file is the main module of package '{packageName}', a dependency of "
                + "this program. {fix}";
        }
        bool noMainModule = !this.moduleContext.module().hasPackageManifest()
            && !this.moduleContext.programHasMainModule();
        if (this.canonicalPath == "src.main" && noMainModule) {
            return "{rule} The program folder has no 'ens.package' file, so 'src/main.ens' is module "
                + "'src.main' and not the main module. Move this file to 'main.ens' at the root of the "
                + "program folder, or add an 'ens.package' file so that 'src/main.ens' becomes the main "
                + "module.";
        }
        return "{rule} This file is module '{this.canonicalPath}'. Rename this function, or move it "
            + "into 'main.ens'.";
    }

    collectFunctions() {
        // A module whose path starts with '$' is compiler-owned - the synthesized test runner -
        // and is exempt from the entry-point placement rule.
        bool mayDefineMain = this.canonicalPath == "main" || this.canonicalPath.startsWith("$");
        for (long n = 0; n < this.functionNodes.length(); n++) {
            let node = this.functionNodes.get(n);
            let nameToken = node.name();
            if (nameToken == null || nameToken.text().length == 0) {
                continue;
            }
            string name = nameToken.text();
            Span nameSpan = nameToken.span();
            if (name == "main" && !mayDefineMain) {
                this.fileReporter.report(this.misplacedMainMessage(), nameSpan);
            }
            let modifiers = members.functionModifiers(node);
            let typeParameters = this.typeResolver.resolveTypeParameters(node.green(), name,
                node.typeParameters());
            this.typeResolver.pushTypeParameters(typeParameters);
            let signature = members.buildSignature(this.typeResolver, this.fileReporter, node, name,
                nameSpan, false, false, false, modifiers.declaresNoreturn, null, this.typeNames,
                typeParameters);
            members.checkThrowsPlacement(this.fileReporter, node, false, modifiers.declaresAbstract,
                null, this.typeNames);
            members.checkNoreturnPlacement(this.fileReporter, node, false, false,
                modifiers.declaresNoreturn, "");
            members.checkFunctionModifiers(this.fileReporter, node);
            this.typeResolver.popTypeParameters(typeParameters.length);
            if (name == "main" && mayDefineMain) {
                this.checkEntrySignature(node, signature);
            }
            if (this.nameCollidesWithBinding(name)) {
                this.fileReporter.report("Function name '{name}' is already "
                    + this.collidingBinding(name), nameSpan);
                continue;
            }
            FunctionEntry? takenOver = null;
            let existing = this.moduleContext.functions().entriesNamed(name);
            if (existing != null && existing.length() > 0) {
                if (name == "main") {
                    this.fileReporter.report("Function 'main' is declared more than once, and a "
                        + "program starts at one 'main'. Remove this second 'main', or rename it.",
                        nameSpan);
                    continue;
                }
                bool anyGeneric = signature.isGeneric();
                for (long i = 0; i < existing.length(); i++) {
                    if (existing.get(i).signature().isGeneric()) {
                        anyGeneric = true;
                    }
                }
                if (anyGeneric) {
                    this.fileReporter.report(genericOverloadMessage(name, existing, this.typeNames),
                        nameSpan);
                    continue;
                }
                let clashing = this.moduleContext.functions().entryWithSameParameters(signature);
                if (clashing != null && !clashing.isBuiltin()) {
                    this.fileReporter.report(members.repeatedOverloadMessage("Function '{name}'",
                        "functions"), nameSpan);
                    continue;
                }
                // A declaration matching a function the language provides takes it over here and
                // takes every call in this module; every other module keeps the provided one.
                takenOver = clashing;
            }
            let entry = new FunctionEntry(signature, members.topLevelVisibility(modifiers), false,
                null, "");
            if (takenOver == null) {
                this.moduleContext.functions().add(entry);
            } else {
                this.moduleContext.functions().replace(takenOver, entry);
            }
        }
    }

    // The entry point is started by the operating system, which passes no arguments and takes the
    // returned 'int' as the process exit code, so 'main' is a plain function with no type
    // parameters, no parameters, and either 'int' or no return type at all.
    checkEntrySignature(FunctionDeclarationNode node, Signature signature) {
        let typeParameterList = node.typeParameters();
        if (typeParameterList != null && typeParameterList.parametersCount() > 0) {
            let first = typeParameterList.parameters(0);
            this.fileReporter.report("Function 'main' is where the program starts, so no code "
                + "calls it with type arguments, and it cannot declare the type parameter "
                + "'{first.name().text()}'. Write 'main() -> int' or 'main()', and put the "
                + "generic code in a function that 'main' calls.", first.span());
        }
        Parameter[] parameters = signature.parameters();
        if (parameters.length > 0) {
            this.fileReporter.report("Function 'main' is where the program starts, and it takes "
                + "no parameters, so it cannot declare '{parameters[0].name()}'. Write "
                + "'main() -> int' or 'main()', and read the command line with "
                + "'environment.arguments()' after 'import @std.environment;'.",
                parameters[0].span());
        }
        Type returned = signature.returnType();
        if (returned is ErrorType || types.isVoidType(returned)) {
            return;
        }
        if (returned is PrimitiveType && returned.kind() == PrimitiveKind.Int) {
            return;
        }
        Span at = signature.nameSpan();
        let returnClause = node.returnType();
        if (returnClause != null) {
            at = returnClause.returnedType().span();
        }
        this.fileReporter.report("Function 'main' returns '{this.typeNames.of(returned)}', but "
            + "'main' can only return 'int' or nothing, because what it returns becomes the "
            + "program's exit code, the number the program ends with. Write 'main() -> int' to "
            + "choose the exit code, or 'main()' to end with 0.", at);
    }

    collectExternalFunctions() {
        for (long n = 0; n < this.externalBlockNodes.length(); n++) {
            let block = this.externalBlockNodes.get(n);
            string library = block.library().text();
            let module = this.moduleContext.module();
            if (library.length > 0 && module.nativesRestricted() && !module.declaresNative(library)) {
                this.fileReporter.report("Native library '{library}' is not declared in "
                    + "'{module.manifestPath()}', so the build cannot link it. Add "
                    + "'native {library};' to that file, or 'native {library} system;' for a "
                    + "library the system provides.", block.library().span());
            }
            for (long i = 0; i < block.functionsCount(); i++) {
                let item = block.functions(i);
                if (item is ExternalFunctionDeclarationNode) {
                    this.collectExternalFunction(item, library);
                }
            }
        }
    }

    collectExternalFunction(ExternalFunctionDeclarationNode declaration, string library) {
        string name = declaration.name().text();
        if (name.length == 0) {
            return;
        }
        Span nameSpan = declaration.name().span();
        let store = this.typeResolver.typeStore();
        Type returnType = store.primitive(PrimitiveKind.Void);
        let returnClause = declaration.returnType();
        if (returnClause != null) {
            returnType = this.typeResolver.resolveReturnType(returnClause.returnedType());
            let nested = nestedOptionalAcrossC(returnType, this.typeNames);
            if (nested != null) {
                this.fileReporter.report("External function '{name}' returns "
                    + "'{this.typeNames.of(returnType)}', and a C function can return at most one "
                    + "level of null. Write '{nested}'.", returnClause.returnedType().span());
            }
        }
        let parameterList = declaration.parameters();
        let parameters = new List<Parameter>();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let parameterNode = parameterList.parameters(i);
            string parameterName = parameterNode.name().text();
            Span parameterSpan = parameterNode.span();
            Type parameterType = store.errorType();
            let declaredType = parameterNode.declaredType();
            if (declaredType != null) {
                parameterType = this.typeResolver.resolveType(declaredType);
            }
            bool isOut = parameterNode.outKeyword() != null;
            if (isOut && !outParameterAllowed(parameterType) && !isArrayParameter(parameterType)) {
                this.fileReporter.report("Out parameter '{parameterName}' of '{name}' has type "
                    + "'{this.typeNames.of(parameterType)}', but an 'out' parameter must be a "
                    + "primitive such as 'int', or an external type. Change the type of "
                    + "'{parameterName}', or remove 'out'.", parameterSpan);
            }
            if (!(parameterType is ErrorType)) {
                let nested = nestedOptionalAcrossC(parameterType, this.typeNames);
                if (nested != null) {
                    this.fileReporter.report("Parameter '{parameterName}' of external function "
                        + "'{name}' has type '{this.typeNames.of(parameterType)}', and a C "
                        + "function can take at most one level of null. Write '{nested}'.",
                        parameterSpan);
                }
                Type bare = parameterType;
                if (bare is OptionalType) {
                    bare = bare.inner();
                }
                if (bare is ArrayType) {
                    if (isOut) {
                        this.fileReporter.report("Out parameter '{parameterName}' of '{name}' has "
                            + "type '{this.typeNames.of(parameterType)}', and an array cannot be an "
                            + "'out' parameter. Remove 'out': C can already write into the "
                            + "elements of an array parameter.", parameterSpan);
                    }
                    if (!abiScalar(bare.element())) {
                        this.fileReporter.report("Parameter '{parameterName}' of external function "
                            + "'{name}' has type '{this.typeNames.of(parameterType)}', but the "
                            + "elements of an array passed to C must be a primitive such as "
                            + "'byte', or an external type. Change the element type.",
                            parameterSpan);
                    }
                }
            }
            if (parameterNode.defaultValue() != null) {
                this.fileReporter.report("Parameter '{parameterName}' of external function "
                    + "'{name}' has a default value, and a parameter of an external function "
                    + "cannot have one. Remove the default.", parameterSpan);
            }
            if (parameterNode.thisPrefix() != null) {
                this.fileReporter.report("Parameter 'this.{parameterName}' of external function "
                    + "'{name}' sets a field, and only a constructor can do that. Replace 'this.' "
                    + "with the parameter's type.", parameterSpan);
            }
            parameters.push(new Parameter(parameterName, parameterType, false, isOut,
                parameterNode.defaultValue() != null, parameterSpan));
        }
        let signature = new Signature(name, parameters.toArray(), returnType, false, false, [],
            [], [], declaration.green(), nameSpan);
        let existing = this.moduleContext.functions().entriesNamed(name);
        if (existing != null && existing.length() > 0) {
            string other = "function '{name}'";
            string fix = "Remove this declaration, or rename the other '{name}'.";
            for (long i = 0; i < existing.length(); i++) {
                if (existing.get(i).isExternal()) {
                    other = "another external function";
                    fix = "Remove one of the two declarations.";
                    break;
                }
                if (existing.get(i).isBuiltin()) {
                    other = "'{name}', a function the language provides in every module";
                    fix = "Remove this declaration.";
                }
            }
            this.fileReporter.report("External function '{name}' has the same name as {other}. A "
                + "native library function is looked up by its name alone, so two functions cannot "
                + "share one. {fix}", nameSpan);
            return;
        }
        if (this.nameCollidesWithBinding(name)) {
            this.fileReporter.report("Function name '{name}' is already "
                + this.collidingBinding(name), nameSpan);
            return;
        }
        this.moduleContext.functions().add(new FunctionEntry(signature, Visibility.Private, true,
            null, library));
    }

    // A refused import holds no name, so it never collides.
    nameCollidesWithBinding(string name) -> bool {
        let bound = this.moduleContext.linkTable().binding(name);
        if (bound != null && !(bound is RefusedImport)) {
            return true;
        }
        return this.typeResolver.implicitBinding(name) != null;
    }

    // The rest of the refusal, naming what already holds the name and how to free it. Only an
    // import can be rebound. A name the language provides is offered no such fix. The caller
    // has already established that one of the three cases holds.
    collidingBinding(string name) -> string {
        let bound = this.moduleContext.linkTable().binding(name);
        if (bound is ImportedType) {
            let target = bound.target();
            return "used in this file by an import of the type '{target.name()}' from module "
                + "'{target.modulePath()}'. Rename the function, or bind the import to another "
                + "name with 'as'.";
        }
        if (bound is ImportedNamespace) {
            return "used in this file by an import of the module '{bound.modulePath()}'. Rename "
                + "the function, or bind the import to another name with 'as'.";
        }
        return "the name of a type the language provides. Rename the function.";
    }

    checkTests() {
        if (this.testNodes.length() == 0) {
            return;
        }
        string filePath = this.moduleContext.module().filePath();
        bool inTestFile = filePath.endsWith("_test.ens");
        for (long n = 0; n < this.testNodes.length(); n++) {
            let node = this.testNodes.get(n);
            this.registerTest(node, n);
            if (!inTestFile) {
                string fileName = paths.baseName(filePath);
                string stem = fileName;
                if (stem.endsWith(".ens")) {
                    stem = stem.substring(0, stem.length - 4);
                }
                this.fileReporter.report("A 'test' can only be declared in a file whose name ends "
                    + "in '_test.ens', and this file is '{fileName}'. Move the test into a file "
                    + "such as '{stem}_test.ens'.", node.testKeyword().span());
            }
            let interpolated = node.descriptionNode();
            if (interpolated != null) {
                this.fileReporter.report("A test description is the test's fixed name, so it cannot "
                    + "contain '\{...\}'. Write the description as plain text.", interpolated.span());
                continue;
            }
            let token = node.descriptionToken();
            if (token == null || token.kind() != SyntaxKind.StringLiteral) {
                continue;
            }
            string content = unquote(token.text());
            if (content.length == 0) {
                this.fileReporter.report("This test's description is empty. Write what the test "
                    + "checks between the quotes.", token.span());
            } else if (hasLineBreak(content)) {
                this.fileReporter.report("This test's description contains a line break. Write it "
                    + "on one line.", token.span());
            }
        }
    }

    // A test declaration is a callable like any function: public so the synthesized test runner
    // module can call it, zero parameters, void, named '$test<N>' in source order. It carries an
    // implicit declared contract of 'throws Error', letting the body throw anything (or nothing)
    // while the runner handles every failure with a single 'catch (Error)'. The name repeats
    // across modules; the link name qualifies it with the module path like any public function's.
    registerTest(TestDeclarationNode node, long index) {
        let store = this.typeResolver.typeStore();
        Span at = node.testKeyword().span();
        Type[] contract = [];
        Span[] contractSpans = [];
        let errorBase = this.typeResolver.errorClass();
        if (errorBase != null) {
            contract = [errorBase];
            contractSpans = [at];
        }
        let signature = new Signature("$test{index}", [], store.primitive(PrimitiveKind.Void),
            true, false, contract, contractSpans, [], node.green(), at);
        this.moduleContext.functions().add(new FunctionEntry(signature, Visibility.Public, false,
            null, ""));
    }
}

// A cycle of interface 'extends' links has no flattened requirement set; the first interface
// found on a cycle is diagnosed and its extends link cleared, which dissolves the cycle for the
// rest. Runs once, after every module's signatures resolved the links.
public breakInterfaceExtensionCycles(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    for (long i = 0; i < contexts.length(); i++) {
        let context = contexts.get(i);
        let root = context.root();
        if (root == null) {
            continue;
        }
        let store = context.resolver().typeStore();
        string modulePath = context.module().canonicalPath();
        for (long n = 0; n < root.itemsCount(); n++) {
            switch (root.items(n)) {
                is InterfaceDeclarationNode node -> {
                    let found = store.findDeclared(modulePath, node.name().text());
                    if (found is InterfaceType && found.declaration() == node.green()) {
                        breakCycleThrough(found, context.module().filePath(), node.name().span(),
                            context.names(), collected);
                    }
                },
                default -> { },
            }
        }
    }
    return diagnostics.sorted(collected);
}

// A cycle the interface only runs into is left to the interfaces on it.
breakCycleThrough(InterfaceType interfaceType, string filePath, Span nameSpan, TypeNames names,
                  List<FileDiagnostic> collected) {
    let seen = new Set<InterfaceType>();
    let chain = new List<string>();
    InterfaceType? current = interfaceType;
    while (current != null) {
        if (!seen.add(current)) {
            if (current != interfaceType) {
                return;
            }
            string interfaceName = names.nameOf(interfaceType);
            let steps = new StringBuilder();
            steps.append("Interface '{interfaceName}' extends ");
            for (long c = 1; c < chain.length(); c++) {
                steps.append("'{chain.get(c)}', which extends ");
            }
            steps.append("'{interfaceName}', so '{interfaceName}' would extend itself. Remove one "
                + "of the 'extends' clauses in that chain.");
            collected.push(new FileDiagnostic(filePath, steps.toString(), nameSpan));
            interfaceType.clearBase();
            return;
        }
        chain.push(names.nameOf(current));
        current = extendedAuthority(current);
    }
}

// The interface the extends link continues through: a generic target defers to its template.
extendedAuthority(InterfaceType interfaceType) -> InterfaceType? {
    let base = interfaceType.base();
    if (base == null) {
        return null;
    }
    let authority = types.authorityOf(base);
    if (authority is InterfaceType) {
        return authority;
    }
    return null;
}

// The provided function is nowhere in the author's source, so a collision with it names it
// instead of counting the name's declarations.
genericOverloadMessage(string name, List<FunctionEntry> existing, TypeNames names) -> string {
    let provided = providedAmong(existing);
    if (provided == null) {
        return "Function '{name}' cannot be overloaded, because one of its declarations is "
            + "generic, and a generic function cannot share its name. Rename one of them.";
    }
    return "'{name}' is a function the language provides in every module, and a generic function "
        + "cannot be overloaded, so this '{name}' cannot have type parameters. Write "
        + "'{declarationForm(provided.signature(), names)}' to replace the provided one in this "
        + "module, or rename this function.";
}

providedAmong(List<FunctionEntry> existing) -> FunctionEntry? {
    for (long i = 0; i < existing.length(); i++) {
        if (existing.get(i).isBuiltin()) {
            return existing.get(i);
        }
    }
    return null;
}

// A signature written the way a declaration of it is, parameter names included, so a suggested
// fix quoting it can be pasted as it stands.
declarationForm(Signature signature, TypeNames names) -> string {
    let builder = new StringBuilder();
    builder.append(signature.name());
    builder.append("(");
    Parameter[] parameters = signature.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(names.of(parameters[i].type()));
        builder.append(" ");
        builder.append(parameters[i].name());
    }
    builder.append(")");
    return builder.toString();
}

// True for an array or a nullable array, whose 'out' refusal is its own.
isArrayParameter(Type type) -> bool {
    if (type is OptionalType) {
        return type.inner() is ArrayType;
    }
    return type is ArrayType;
}

// The scalar shapes that can cross the C ABI boundary directly.
abiScalar(Type type) -> bool {
    if (type is ExternalType) {
        return true;
    }
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Decimal, Void -> false,
            default -> true,
        };
    }
    return false;
}

// The one-level spelling to write for a type nullable at more than one level, which cannot cross
// the C boundary, or null when the type can. A C parameter or result is one machine value whose
// absence is a null pointer or a zero handle, so exactly one level fits.
nestedOptionalAcrossC(Type type, TypeNames names) -> string? {
    if (!(type is OptionalType) || !(type.inner() is OptionalType)) {
        return null;
    }
    Type core = type;
    while (core is OptionalType) {
        core = core.inner();
    }
    return "{names.of(core)}?";
}

outParameterAllowed(Type type) -> bool {
    Type bare = type;
    if (bare is OptionalType) {
        bare = bare.inner();
    }
    return abiScalar(bare);
}

unquote(string text) -> string {
    if (text.length >= 2 && text.substring(0, 1) == "\""
            && text.substring(text.length - 1, text.length) == "\"") {
        return text.substring(1, text.length - 1);
    }
    return text;
}

// True when the literal's decoded text would contain a line break: a raw one, an \n or \r
// escape, or a \u escape naming one.
hasLineBreak(string content) -> bool {
    byte[] bytes = content.toBytes();
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '\n' || bytes[i] == '\r') {
            return true;
        }
        if (bytes[i] == '\\' && i + 1 < bytes.length) {
            byte next = bytes[i + 1];
            if (next == 'n' || next == 'r') {
                return true;
            }
            if (next == 'u' && i + 5 < bytes.length) {
                long value = 0;
                bool valid = true;
                for (long d = 0; d < 4; d++) {
                    long digit = hexDigit(bytes[i + 2 + d]);
                    if (digit < 0) {
                        valid = false;
                        break;
                    }
                    value = value * 16 + digit;
                }
                if (valid && (value == 10 || value == 13)) {
                    return true;
                }
            }
            i++;
        }
    }
    return false;
}

hexDigit(byte value) -> long {
    if (value >= '0' && value <= '9') {
        return value - '0';
    }
    if (value >= 'a' && value <= 'f') {
        return value - 'a' + 10;
    }
    if (value >= 'A' && value <= 'F') {
        return value - 'A' + 10;
    }
    return -1;
}
