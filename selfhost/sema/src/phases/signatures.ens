// The per-module signature phase. After linking, every module resolves its declared shapes
// against the type store: struct fields and methods, interface methods, enum members, class
// bases and implemented interfaces, free and external functions, and test declarations. Class
// members are left for the whole-program layout phase, which runs bases first.
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import StructDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import InterfaceDeclarationNode from @ens.frontend.syntax.generated.nodes;
import PrimitiveDeclarationNode from @ens.frontend.syntax.generated.nodes;
import EnumDeclarationNode from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import PrefixExpressionNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ExternalBlockNode from @ens.frontend.syntax.generated.nodes;
import ExternalFunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FieldDeclarationNode from @ens.frontend.syntax.generated.nodes;
import MemberListNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import Reporter from support.diagnostics;
import support.diagnostics;
import BuiltinFunction from context;
import ModuleContext from context;
import ClassItem from context;
import FunctionEntry from context;
import phases.members;
import MemberModifiers from phases.members;
import TypeResolver from phases.resolve;
import model.types;
import Type from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import ExternalType from model.types;
import ClassType from model.types;
import StructType from model.types;
import InterfaceType from model.types;
import EnumType from model.types;
import PrimitiveBinding from model.types;
import TypeParamType from model.types;
import DeclaredType from model.types;
import InstantiationType from model.types;
import model.literalvalues;
import Field from model.types;
import Method from model.types;
import Parameter from model.types;
import Signature from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Resolves every type declaration's type parameter list, bounds included. Runs for every module
// before any module resolves signatures, so bound checks see the bounds at every reference site
// regardless of module order. Diagnostics stay with the resolver until the signature pass drains
// them.
public resolveTypeParameterLists(ModuleContext context) {
    let root = context.root();
    if (root == null) {
        return;
    }
    let resolver = context.resolver();
    let store = resolver.typeStore();
    string modulePath = context.module().canonicalPath();
    for (long i = 0; i < root.itemsCount(); i++) {
        switch (root.items(i)) {
            is StructDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.typeParameters()));
                }
            },
            is ClassDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.typeParameters()));
                }
            },
            is InterfaceDeclarationNode declaration -> {
                let found = store.findDeclared(modulePath, declaration.name().text());
                if (found != null && found.declaration() == declaration.green()) {
                    found.setTypeParameterTypes(resolver.resolveTypeParameters(
                        declaration.green(), declaration.typeParameters()));
                }
            },
            default -> { },
        }
    }
}

// One module's signature results: the classes it declares, paired with their declarations for the
// layout phase, and the diagnostics resolving them produced.
public class SignatureResult {
    List<ClassItem> declaredClasses;
    FileDiagnostic[] signatureDiagnostics;

    protected constructor(List<ClassItem> classes, FileDiagnostic[] diagnostics) {
        this.declaredClasses = classes;
        this.signatureDiagnostics = diagnostics;
    }

    public classItems() -> List<ClassItem> {
        return this.declaredClasses;
    }

    public diagnostics() -> FileDiagnostic[] {
        return this.signatureDiagnostics;
    }
}

// Resolves one module's signatures, handing back the classes it declares and its diagnostics.
public resolveModule(ModuleContext context) -> SignatureResult {
    let collected = new List<FileDiagnostic>();
    let collector = new SignatureCollector(context, collected);
    collector.run();
    for (let diagnostic in context.resolver().takeDiagnostics()) {
        collected.push(diagnostic);
    }
    return new SignatureResult(collector.declaredClasses, diagnostics.sorted(collected));
}

class SignatureCollector {
    ModuleContext context;
    TypeResolver resolver;
    Reporter reporter;
    string modulePath;

    protected List<ClassItem> declaredClasses;

    List<StructDeclarationNode> structNodes;
    List<ClassDeclarationNode> classNodes;
    List<InterfaceDeclarationNode> interfaceNodes;
    List<EnumDeclarationNode> enumNodes;
    List<FunctionDeclarationNode> functionNodes;
    List<TestDeclarationNode> testNodes;
    List<ExternalBlockNode> externalBlockNodes;
    List<PrimitiveDeclarationNode> primitiveNodes;

    protected constructor(ModuleContext context, List<FileDiagnostic> collected) {
        this.context = context;
        this.resolver = context.resolver();
        this.reporter = new Reporter(context.module().filePath(), collected);
        this.modulePath = context.module().canonicalPath();
        this.declaredClasses = new List<ClassItem>();
        this.structNodes = new List<StructDeclarationNode>();
        this.classNodes = new List<ClassDeclarationNode>();
        this.interfaceNodes = new List<InterfaceDeclarationNode>();
        this.enumNodes = new List<EnumDeclarationNode>();
        this.functionNodes = new List<FunctionDeclarationNode>();
        this.testNodes = new List<TestDeclarationNode>();
        this.externalBlockNodes = new List<ExternalBlockNode>();
        this.primitiveNodes = new List<PrimitiveDeclarationNode>();
    }

    protected run() {
        this.seedBuiltins();
        let root = this.context.root();
        if (root == null) {
            return;
        }
        this.gather(root);
        this.collectStructFields();
        this.collectStructMethods();
        this.collectInterfaces();
        this.collectEnums();
        this.resolveClassBases();
        this.collectPrimitiveBindings();
        this.collectFunctions();
        this.collectExternalFunctions();
        this.checkTests();
    }

    gather(SourceFileNode root) {
        for (long i = 0; i < root.itemsCount(); i++) {
            switch (root.items(i)) {
                is StructDeclarationNode declaration -> {
                    this.structNodes.push(declaration);
                },
                is ClassDeclarationNode declaration -> {
                    this.classNodes.push(declaration);
                },
                is InterfaceDeclarationNode declaration -> {
                    this.interfaceNodes.push(declaration);
                },
                is EnumDeclarationNode declaration -> {
                    this.enumNodes.push(declaration);
                },
                is FunctionDeclarationNode declaration -> {
                    this.functionNodes.push(declaration);
                },
                is TestDeclarationNode declaration -> {
                    this.testNodes.push(declaration);
                },
                is ExternalBlockNode declaration -> {
                    this.externalBlockNodes.push(declaration);
                },
                is PrimitiveDeclarationNode declaration -> {
                    this.primitiveNodes.push(declaration);
                },
                default -> { },
            }
        }
    }

    // The functions the language provides in every module. A declaration may overload one with a
    // different parameter list, or take it over by matching its parameter types exactly.
    seedBuiltins() {
        let store = this.resolver.typeStore();
        Span nowhere = source.makeSpan(0, 0);
        let message = new Parameter("message", store.stringType(), false, false, false, nowhere);
        Type voidType = store.primitive(PrimitiveKind.Void);
        let print = new Signature("print", [message], voidType, false, false, [], [], [], null,
            nowhere);
        this.context.functions().add(new FunctionEntry(print, Visibility.Export, false,
            BuiltinFunction.Print, ""));
        let panic = new Signature("panic", [message], voidType, false, true, [], [], [], null,
            nowhere);
        this.context.functions().add(new FunctionEntry(panic, Visibility.Export, false,
            BuiltinFunction.Panic, ""));
    }

    // The declared type a node owns, or null when a duplicate declaration lost its name.
    structFor(StructDeclarationNode node) -> StructType? {
        let found = this.resolver.typeStore().findDeclared(this.modulePath, node.name().text());
        if (found is StructType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    classFor(ClassDeclarationNode node) -> ClassType? {
        let found = this.resolver.typeStore().findDeclared(this.modulePath, node.name().text());
        if (found is ClassType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    interfaceFor(InterfaceDeclarationNode node) -> InterfaceType? {
        let found = this.resolver.typeStore().findDeclared(this.modulePath, node.name().text());
        if (found is InterfaceType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    enumFor(EnumDeclarationNode node) -> EnumType? {
        let found = this.resolver.typeStore().findDeclared(this.modulePath, node.name().text());
        if (found is EnumType && found.declaration() == node.green()) {
            return found;
        }
        return null;
    }

    // Struct fields resolve for every struct before any struct method does, so constructor
    // 'this.field' parameters always see the full field list.
    collectStructFields() {
        for (long s = 0; s < this.structNodes.length(); s++) {
            let node = this.structNodes.get(s);
            let found = this.structFor(node);
            if (found == null) {
                continue;
            }
            let extendsClause = node.extendsClause();
            if (extendsClause != null) {
                this.reporter.report("Only classes can use 'extends'; structs do not support "
                    + "inheritance.", extendsClause.extendsKeyword().span());
            }
            let implementsClause = node.implementsClause();
            if (implementsClause != null) {
                this.reporter.report("Structs cannot implement interfaces; only classes can "
                    + "use 'implements'.", implementsClause.implementsKeyword().span());
            }
            let parameters = found.typeParameterTypes();
            this.resolver.pushTypeParameters(parameters);
            let body = node.body();
            for (long i = 0; i < body.membersCount(); i++) {
                let member = body.members(i);
                if (member is FieldDeclarationNode) {
                    let field = members.readField(this.resolver, this.reporter, member, found,
                        Visibility.Private);
                    if (field.isStatic() || field.isLazy()) {
                        this.collectTypeLevelField(found, member, field);
                        continue;
                    }
                    if (field.isWeak()) {
                        this.reporter.report("'weak' fields are not allowed on structs.",
                            field.nameSpan());
                    }
                    if (field.name().length > 0) {
                        if (members.findField(found.fields(), field.name()) != null) {
                            this.reporter.report("Field '{field.name()}' is already declared "
                                + "in '{found.name()}'.", field.nameSpan());
                            continue;
                        }
                        members.checkStaticInstanceCollision(this.reporter, found,
                            field.name(), false, field.nameSpan());
                    }
                    found.fields().push(field);
                }
            }
            this.resolver.popTypeParameters(parameters.length);
        }
    }

    collectStructMethods() {
        for (long s = 0; s < this.structNodes.length(); s++) {
            let node = this.structNodes.get(s);
            let structType = this.structFor(node);
            if (structType == null) {
                continue;
            }
            let parameters = structType.typeParameterTypes();
            this.resolver.pushTypeParameters(parameters);
            let body = node.body();
            for (long i = 0; i < body.membersCount(); i++) {
                let member = body.members(i);
                if (member is FunctionDeclarationNode) {
                    this.collectStructMethod(structType, member);
                }
            }
            this.resolver.popTypeParameters(parameters.length);
            structType.setMembersComplete();
            members.checkHashEqualsPairing(this.reporter, structType, node.name().span());
        }
    }

    // One static const or lazy const field of a struct; the class twin lives in the layout
    // phase. The shape checks and the shared-namespace collision rules are one home in
    // phases.members.
    collectTypeLevelField(StructType structType, FieldDeclarationNode declaration, Field field) {
        if (field.isLazy()) {
            members.checkLazyFieldShape(this.reporter, declaration, field);
        } else {
            members.checkStaticFieldShape(this.reporter, declaration, field);
        }
        if (field.name().length > 0) {
            if (members.findField(structType.staticFields(), field.name()) != null) {
                this.reporter.report("{members.typeLevelFieldNoun(field)} '{field.name()}' is "
                    + "already declared in '{structType.name()}'.", field.nameSpan());
                return;
            }
            members.checkStaticInstanceCollision(this.reporter, structType, field.name(), true,
                field.nameSpan(), field);
        }
        structType.staticFields().push(field);
    }

    collectStructMethod(StructType structType, FunctionDeclarationNode member) {
        let introducer = member.introducer();
        bool isConstructor = false;
        Span nameSpan = member.span();
        if (introducer != null) {
            if (introducer.kind() == SyntaxKind.DestructorKeyword) {
                this.reporter.report("A struct cannot declare a destructor; destructors are "
                    + "only allowed on classes.", introducer.span());
                return;
            }
            isConstructor = true;
            nameSpan = introducer.span();
        }
        string rawName = "";
        let nameToken = member.name();
        if (nameToken != null) {
            rawName = nameToken.text();
            nameSpan = nameToken.span();
        }
        if (!isConstructor) {
            if (rawName.length == 0) {
                return;
            }
            if (rawName == structType.name()) {
                this.reporter.report("To declare a constructor, use the 'constructor' keyword. "
                    + "A method cannot be named after its struct '{structType.name()}'.",
                    nameSpan);
                return;
            }
        }
        string methodName = rawName;
        if (isConstructor) {
            methodName = "constructor";
        }
        let modifiers = members.functionModifiers(member);
        members.checkMemberModifiers(this.reporter, member);
        if (modifiers.declaresStatic && !isConstructor) {
            members.collectStaticMethod(this.resolver, this.reporter, structType,
                structType.staticMethods(), member, methodName, nameSpan, modifiers);
            return;
        }
        members.checkStaticMethodMarkers(this.reporter, modifiers, methodName, isConstructor,
            false, nameSpan);
        string memberKindWord = "Method";
        if (isConstructor) {
            memberKindWord = "Constructor";
        }
        string constraintSubject = "{memberKindWord} '{methodName}' of '{structType.name()}'";
        if (isConstructor) {
            constraintSubject = "A constructor of '{structType.name()}'";
        }
        let constraints = members.readMemberConstraints(this.resolver, this.reporter,
            structType, member, constraintSubject);
        if (constraints.length > 0) {
            this.resolver.pushMemberConstraints(structType.declaration(), constraints);
        }
        let signature = members.buildSignature(this.resolver, this.reporter, member, methodName,
            nameSpan, isConstructor, false, isConstructor || modifiers.declaresAbstract,
            modifiers.declaresNoreturn, structType.fields(), structType.name(), []);
        if (constraints.length > 0) {
            this.resolver.popMemberConstraints();
        }
        let behavior = members.builtinBehaviorReplaced(structType, methodName, signature,
            modifiers.declaresOverride);
        Visibility visibility = Visibility.Private;
        if (behavior != null) {
            visibility = members.builtinReplacementVisibility(modifiers, structType, methodName,
                behavior, this.reporter);
        } else {
            visibility = members.memberVisibility(modifiers, Visibility.Private, structType,
                memberKindWord, methodName, this.reporter);
        }
        members.checkFieldMethodCollision(this.reporter, structType.fields(), methodName,
            isConstructor, nameSpan);
        if (!isConstructor) {
            members.checkStaticInstanceCollision(this.reporter, structType, methodName, false,
                nameSpan);
        }
        members.checkThrowsPlacement(this.reporter, member, isConstructor,
            modifiers.declaresAbstract);
        members.checkNoreturnPlacement(this.reporter, member, isConstructor, false,
            modifiers.declaresNoreturn);
        members.checkHashSignature(this.reporter, member, signature, isConstructor);
        members.checkEqualsSignature(this.reporter, member, signature, structType, isConstructor);
        members.checkToStringSignature(this.reporter, member, signature, isConstructor);
        members.checkStructOverrideMarker(this.reporter, structType, methodName, signature,
            modifiers, isConstructor, behavior);
        members.checkStructAbstractMarker(this.reporter, structType, methodName, signature,
            modifiers, isConstructor);
        if (!isConstructor) {
            members.checkConditionalMarkers(this.reporter, constraints, modifiers, methodName,
                structType, nameSpan);
        }
        if (members.findSameSignature(structType.methods(), methodName, signature) != null) {
            this.reporter.report("Method '{methodName}' of '{structType.name()}' is already "
                + "declared with the same parameter types; overloads must differ in parameter "
                + "count or types.", nameSpan);
            return;
        }
        structType.methods().push(new Method(signature, visibility, isConstructor,
            false, modifiers.declaresOverride, modifiers.declaresFinal,
            modifiers.declaresAbstract, false, member.body() != null, constraints, structType));
    }

    // The binding whose members this declaration writes, or null when the link phase refused it.
    bindingFor(PrimitiveDeclarationNode node) -> PrimitiveBinding? {
        let primitive = types.primitiveNamed(this.resolver.typeStore(), node.name().text());
        if (primitive == null) {
            return null;
        }
        let binding = types.bindingOf(primitive);
        if (binding != null && binding.declaration() == node.green()) {
            return binding;
        }
        return null;
    }

    // A primitive binding's declared conformances and members. The binding owns the member rules,
    // and the primitive is what each member is declared on, so a diagnostic and a stack trace
    // both read 'string'. Whether the conformances are actually satisfied is a whole-program
    // question and waits for the declaration checks.
    collectPrimitiveBindings() {
        for (long n = 0; n < this.primitiveNodes.length(); n++) {
            let node = this.primitiveNodes.get(n);
            let binding = this.bindingFor(node);
            if (binding == null) {
                continue;
            }
            let implementsClause = node.implementsClause();
            if (implementsClause != null) {
                let resolved = new List<Type>();
                for (long i = 0; i < implementsClause.interfacesCount(); i++) {
                    let reference = implementsClause.interfaces(i);
                    Type declared = this.resolver.resolveType(reference);
                    if (this.acceptBindingInterface(binding, declared, reference.span())) {
                        resolved.push(declared);
                    }
                }
                binding.setInterfaces(resolved.toArray());
            }
            let body = node.body();
            for (long i = 0; i < body.membersCount(); i++) {
                switch (body.members(i)) {
                    is FieldDeclarationNode field -> {
                        this.reportBindingField(binding, field);
                    },
                    is FunctionDeclarationNode method -> {
                        this.collectPrimitiveMember(binding, method);
                    },
                    default -> { },
                }
            }
            binding.setMembersComplete();
        }
    }

    acceptBindingInterface(PrimitiveBinding binding, Type declared, Span span) -> bool {
        if (declared is ErrorType) {
            return false;
        }
        if (!types.isInterfaceLike(declared)) {
            this.reporter.report("'{binding.name()}' can only implement an interface, and "
                + "'{types.display(declared)}' is not one. A primitive has no object to inherit "
                + "into, so a binding never extends a class.", span);
            return false;
        }
        return true;
    }

    // A primitive stores nothing of its own, so no member of a binding is a field. A 'static
    // const' would put a constant under a name the language owns, which is a different thing
    // from declaring what a value can do.
    reportBindingField(PrimitiveBinding binding, FieldDeclarationNode declaration) {
        let modifiers = members.fieldModifiers(declaration);
        string name = declaration.name().text();
        if (modifiers.declaresStatic) {
            this.reporter.report("A binding for '{binding.name()}' cannot declare a static "
                + "const: it declares what a '{binding.name()}' value can do, not constants "
                + "under the primitive's name. Declare '{name}' on a class or struct of this "
                + "module instead.", declaration.name().span());
            return;
        }
        if (modifiers.declaresLazy) {
            this.reporter.report("A binding for '{binding.name()}' cannot declare a lazy "
                + "const: it declares what a '{binding.name()}' value can do, not values kept "
                + "under the primitive's name. Declare '{name}' on a class or struct of this "
                + "module instead.", declaration.name().span());
            return;
        }
        this.reporter.report("A binding for '{binding.name()}' cannot declare a field: "
            + "'{name}' would need storage in every '{binding.name()}' value, and a primitive "
            + "carries none. Declare methods here, and put the state in a class or struct that "
            + "holds a '{binding.name()}'.", declaration.name().span());
    }

    collectPrimitiveMember(PrimitiveBinding binding, FunctionDeclarationNode member) {
        let introducer = member.introducer();
        if (introducer != null) {
            if (introducer.kind() == SyntaxKind.DestructorKeyword) {
                this.reporter.report("A binding for '{binding.name()}' cannot declare a "
                    + "destructor: a primitive owns nothing to release, and its values are "
                    + "copied rather than destroyed.", introducer.span());
            } else {
                this.reporter.report("A binding for '{binding.name()}' cannot declare a "
                    + "constructor: a '{binding.name()}' is written as a literal or produced by "
                    + "an expression, never built with 'new'. Declare a static that returns a "
                    + "'{binding.name()}' instead.", introducer.span());
            }
            return;
        }
        let nameToken = member.name();
        if (nameToken == null || nameToken.text().length == 0) {
            return;
        }
        string name = nameToken.text();
        Span nameSpan = nameToken.span();
        let modifiers = members.functionModifiers(member);
        members.checkMemberModifiers(this.reporter, member);
        if (modifiers.declaresStatic) {
            if (this.reportOwnedMember(binding, name, nameSpan, true)) {
                return;
            }
            members.collectStaticMethod(this.resolver, this.reporter, binding,
                binding.staticMethods(), member, name, nameSpan, modifiers);
            return;
        }
        if (this.reportOwnedMember(binding, name, nameSpan, false)) {
            return;
        }
        if (modifiers.declaresAbstract) {
            this.reporter.report("Method '{name}' of the '{binding.name()}' binding cannot be "
                + "'abstract': a primitive has no subclass to supply a body, so every member "
                + "here is written out.", modifiers.abstractModifierSpan(nameSpan));
        } else if (member.body() == null) {
            this.reporter.report("Method '{name}' of the '{binding.name()}' binding needs a "
                + "body: a primitive's members are ordinary Ens code, and nothing else supplies "
                + "one.", nameSpan);
        }
        if (modifiers.declaresFinal) {
            this.reporter.report("Method '{name}' of the '{binding.name()}' binding cannot be "
                + "'final': 'final' forbids an override, and a primitive has nothing that could "
                + "override it.", modifiers.finalModifierSpan(nameSpan));
        }
        let constraints = members.readMemberConstraints(this.resolver, this.reporter, binding,
            member, "Method '{name}' of '{binding.name()}'");
        let signature = members.buildSignature(this.resolver, this.reporter, member, name,
            nameSpan, false, false, true, modifiers.declaresNoreturn, null, binding.name(), []);
        Visibility visibility = members.memberVisibility(modifiers, Visibility.Private, binding,
            "Method", name, this.reporter);
        members.checkThrowsPlacement(this.reporter, member, false, false);
        members.checkNoreturnPlacement(this.reporter, member, false, false,
            modifiers.declaresNoreturn);
        members.checkStaticInstanceCollision(this.reporter, binding, name, false, nameSpan);
        if (members.findSameSignature(binding.methods(), name, signature) != null) {
            this.reporter.report("Method '{name}' of the '{binding.name()}' binding is already "
                + "declared with the same parameter types; overloads must differ in parameter "
                + "count or types.", nameSpan);
            return;
        }
        binding.methods().push(new Method(signature, visibility, false, false,
            modifiers.declaresOverride, false, false, false, member.body() != null, constraints,
            binding.primitive()));
    }

    // A member the compiler answers for on this primitive already. Declaring it in a binding
    // would leave the declaration unreachable, since the compiler's own answer comes first, so
    // it is refused by name until the library takes the member over.
    reportOwnedMember(PrimitiveBinding binding, string name, Span at, bool isStatic) -> bool {
        if (isStatic) {
            if (!members.compilerOwnedStatic(binding.primitive(), name)) {
                return false;
            }
            this.reporter.report("'{binding.name()}.{name}' is provided by the compiler, so a "
                + "binding cannot declare it. Choose another name.", at);
            return true;
        }
        if (!members.compilerOwnedMember(binding.primitive(), name)) {
            return false;
        }
        this.reporter.report("'{name}' is provided by the compiler on every "
            + "'{binding.name()}', so a binding cannot declare it. Choose another name.", at);
        return true;
    }

    collectInterfaces() {
        for (long n = 0; n < this.interfaceNodes.length(); n++) {
            let node = this.interfaceNodes.get(n);
            let interfaceType = this.interfaceFor(node);
            if (interfaceType == null) {
                continue;
            }
            let parameters = interfaceType.typeParameterTypes();
            this.resolver.pushTypeParameters(parameters);
            let extendsClause = node.extendsClause();
            if (extendsClause != null) {
                let reference = extendsClause.base();
                Type base = this.resolver.resolveType(reference);
                this.checkAndSetInterfaceBase(interfaceType, base, reference.span());
            }
            let body = node.body();
            for (long i = 0; i < body.membersCount(); i++) {
                switch (body.members(i)) {
                    is FieldDeclarationNode field -> {
                        this.reporter.report("An interface cannot declare fields; its body "
                            + "lists only method signatures.", field.name().span());
                    },
                    is FunctionDeclarationNode method -> {
                        this.collectInterfaceMethod(interfaceType, method);
                    },
                    default -> { },
                }
            }
            this.resolver.popTypeParameters(parameters.length);
            interfaceType.setMembersComplete();
        }
    }

    collectInterfaceMethod(InterfaceType interfaceType, FunctionDeclarationNode member) {
        let introducer = member.introducer();
        if (introducer != null) {
            if (introducer.kind() == SyntaxKind.DestructorKeyword) {
                this.reporter.report("An interface cannot declare a destructor; "
                    + "'{interfaceType.name()}' has no instances of its own.",
                    introducer.span());
            } else {
                this.reporter.report("An interface cannot declare a constructor; "
                    + "'{interfaceType.name()}' has no instances of its own.",
                    introducer.span());
            }
            return;
        }
        let nameToken = member.name();
        if (nameToken == null || nameToken.text().length == 0) {
            return;
        }
        string name = nameToken.text();
        Span nameSpan = nameToken.span();
        if (name == interfaceType.name()) {
            this.reporter.report("An interface cannot declare a constructor; "
                + "'{interfaceType.name()}' has no instances of its own.", nameSpan);
            return;
        }
        let modifiers = members.functionModifiers(member);
        members.checkMemberModifiers(this.reporter, member);
        if (modifiers.hasVisibilityModifier()) {
            this.reporter.report("The members of an interface always share the interface's "
                + "visibility; remove the modifier from '{name}'.",
                modifiers.visibilityModifierSpan(nameSpan));
        }
        if (modifiers.declaresOverride || modifiers.declaresFinal || modifiers.declaresAbstract) {
            this.reporter.report("Interface methods are plain signatures; 'abstract', "
                + "'override', and 'final' are not allowed on '{name}'.", nameSpan);
        }
        if (modifiers.declaresStatic) {
            this.reporter.report("An interface cannot declare a static member; a static "
                + "belongs on the class or struct itself, so declare '{name}' there. Remove "
                + "'static', or move the member.", modifiers.staticModifierSpan(nameSpan));
        }
        if (member.body() != null) {
            this.reporter.report("Interface method '{name}' cannot have a body; end the "
                + "signature with ';'. Implementing classes provide the body.", nameSpan);
        }
        let constraintList = member.typeParameters();
        if (constraintList != null) {
            this.reporter.report("Interface method '{name}' cannot have a type-parameter list: "
                + "a member's type-parameter list makes it conditional on the enclosing type's "
                + "parameters, and an interface requirement must hold for every instantiation. "
                + "Remove the '<...>' list, or move the member to the implementing classes.",
                constraintList.span());
        }
        let throwsClause = member.throwsClause();
        if (throwsClause != null && throwsClause.typesCount() == 0) {
            this.reporter.report("An interface method marked 'throws' must list its exception "
                + "types, e.g. 'throws IOError'.", throwsClause.throwsKeyword().span());
        }
        let signature = members.buildSignature(this.resolver, this.reporter, member, name,
            nameSpan, false, true, true, modifiers.declaresNoreturn, null, "", []);
        members.checkNoreturnPlacement(this.reporter, member, false, false,
            modifiers.declaresNoreturn);
        members.checkHashSignature(this.reporter, member, signature, false);
        if (members.findSameSignature(interfaceType.methods(), name, signature) != null) {
            this.reporter.report("Method '{name}' of '{interfaceType.name()}' is already "
                + "declared with the same parameter types; overloads must differ in parameter "
                + "count or types.", nameSpan);
            return;
        }
        interfaceType.methods().push(new Method(signature,
            types.followedMemberVisibility(interfaceType.visibility()), false, false,
            false, false, true, false, member.body() != null, [], interfaceType));
    }

    checkAndSetInterfaceBase(InterfaceType interfaceType, Type base, Span span) {
        if (base is ErrorType) {
            return;
        }
        string shown = types.display(base);
        if (!types.isInterfaceLike(base)) {
            if (types.isClassLike(base)) {
                this.reporter.report("Interface '{interfaceType.name()}' cannot extend class "
                    + "'{shown}': interfaces extend interfaces, and classes implement them. "
                    + "Write 'class {shown} implements {interfaceType.name()}' to have "
                    + "'{shown}' implement it.", span);
            } else {
                this.reporter.report("Interface '{interfaceType.name()}' cannot extend "
                    + "{extendTargetKind(base)} '{shown}': interfaces extend interfaces, and "
                    + "classes implement them.", span);
            }
            return;
        }
        let authority = types.authorityOf(base);
        if (base == interfaceType || authority == interfaceType) {
            this.reporter.report("Interface '{interfaceType.name()}' cannot extend itself.",
                span);
            return;
        }
        interfaceType.setBase(base);
    }

    collectEnums() {
        for (long n = 0; n < this.enumNodes.length(); n++) {
            let node = this.enumNodes.get(n);
            let enumType = this.enumFor(node);
            if (enumType == null) {
                continue;
            }

            bool numeric = false;
            for (long i = 0; i < node.membersCount(); i++) {
                if (node.members(i).value() != null) {
                    numeric = true;
                    break;
                }
            }
            enumType.setNumeric(numeric);

            let names = new List<string>();
            let values = new List<long>();
            long next = 0;
            bool isFirst = true;
            for (long i = 0; i < node.membersCount(); i++) {
                let member = node.members(i);
                let memberToken = member.name();
                string name = memberToken.text();
                if (name.length == 0) {
                    continue;
                }
                bool duplicate = false;
                for (long j = 0; j < names.length(); j++) {
                    if (names.get(j) == name) {
                        duplicate = true;
                        break;
                    }
                }
                if (duplicate) {
                    this.reporter.report("Enum '{enumType.name()}' already has a member "
                        + "named '{name}'; remove the duplicate.", memberToken.span());
                    continue;
                }

                long value = next;
                let initializer = member.value();
                if (initializer != null) {
                    let constant = enumMemberConstant(initializer.value());
                    if (constant != null) {
                        value = constant;
                    } else {
                        this.reporter.report("The value of enum member '{name}' must be an "
                            + "integer constant, for example '{name} = 1'.",
                            initializer.value().span());
                    }
                } else if (numeric && isFirst) {
                    this.reporter.report("Enum '{enumType.name()}' assigns values to its "
                        + "members, so its first member '{name}' must have one too; give it a "
                        + "value, for example '{name} = 0'.", memberToken.span());
                }
                next = value + 1;
                isFirst = false;

                if (numeric) {
                    for (long j = 0; j < values.length(); j++) {
                        if (values.get(j) == value) {
                            this.reporter.report("Enum members '{name}' and '{names.get(j)}' "
                                + "both have the value {value}; give each member of enum "
                                + "'{enumType.name()}' a distinct value.", memberToken.span());
                            break;
                        }
                    }
                }

                names.push(name);
                values.push(value);
            }
            if (names.length() == 0) {
                this.reporter.report("Enum '{enumType.name()}' must have at least one member.",
                    node.name().span());
            }
            enumType.setMemberNames(names.toArray());
            enumType.setMemberValues(values.toArray());
        }
    }

    resolveClassBases() {
        for (long n = 0; n < this.classNodes.length(); n++) {
            let node = this.classNodes.get(n);
            let found = this.classFor(node);
            if (found == null) {
                continue;
            }
            this.declaredClasses.push(new ClassItem(this.context, found, node));
            let parameters = found.typeParameterTypes();
            if (found.isSealed() && found.isFinal()) {
                this.reporter.report("Class '{found.name()}' cannot be both 'sealed' and "
                    + "'final'; 'final' already forbids subclasses, so there is nothing to "
                    + "seal.", node.name().span());
            }
            this.resolver.pushTypeParameters(parameters);
            let extendsClause = node.extendsClause();
            if (extendsClause != null) {
                let reference = extendsClause.base();
                Type base = this.resolver.resolveType(reference);
                this.checkAndSetBase(found, base, reference.span());
            }
            let implementsClause = node.implementsClause();
            if (implementsClause != null) {
                let accepted = new List<Type>();
                for (long i = 0; i < implementsClause.interfacesCount(); i++) {
                    let reference = implementsClause.interfaces(i);
                    Type resolved = this.resolver.resolveType(reference);
                    if (this.acceptInterface(accepted, resolved, reference.span())) {
                        accepted.push(resolved);
                    }
                }
                found.setInterfaces(accepted.toArray());
            }
            this.resolver.popTypeParameters(parameters.length);
        }
    }

    checkAndSetBase(ClassType classType, Type base, Span span) {
        if (base is ErrorType) {
            return;
        }
        string shown = types.display(base);
        if (types.isInterfaceLike(base)) {
            this.reporter.report("Cannot extend interface '{shown}'; a class implements an "
                + "interface with 'implements {shown}'.", span);
            return;
        }
        if (!types.isClassLike(base)) {
            this.reporter.report("'{shown}' is not a class; only classes can be extended.",
                span);
            return;
        }
        let authority = types.authorityOf(base);
        if (base == classType || authority == classType) {
            this.reporter.report("Class '{classType.name()}' cannot extend itself.", span);
            return;
        }
        if (authority is ClassType) {
            if (authority.isFinal()) {
                this.reporter.report("Cannot extend '{authority.name()}' because it is "
                    + "declared 'final'.", span);
                return;
            }
            if (authority.isSealed() && authority.modulePath() != this.modulePath) {
                this.reporter.report("Cannot extend '{authority.name()}' because it is "
                    + "declared 'sealed'; every subclass of a sealed class must be declared "
                    + "in the module that declares it.", span);
                return;
            }
            classType.setBase(base);
            authority.directSubclasses().push(classType);
        }
    }

    acceptInterface(List<Type> accepted, Type resolved, Span span) -> bool {
        if (resolved is ErrorType) {
            return false;
        }
        string shown = types.display(resolved);
        if (resolved is OptionalType || resolved is ArrayType) {
            this.reporter.report("'implements' takes plain interface names; '{shown}' is not "
                + "an interface type.", span);
            return false;
        }
        if (!types.isInterfaceLike(resolved)) {
            if (types.isClassLike(resolved)) {
                this.reporter.report("'{shown}' is a class, not an interface; use 'extends "
                    + "{shown}' for a base class.", span);
            } else {
                this.reporter.report("'{shown}' is not an interface; 'implements' takes "
                    + "interfaces only.", span);
            }
            return false;
        }
        for (long i = 0; i < accepted.length(); i++) {
            if (accepted.get(i) == resolved) {
                this.reporter.report("Interface '{shown}' is listed more than once in the "
                    + "'implements' clause.", span);
                return false;
            }
        }
        return true;
    }

    collectFunctions() {
        // A module whose path starts with '$' is compiler-owned - the synthesized test runner -
        // and is exempt from the entry-point placement rule.
        bool mayDefineMain = this.modulePath == "main" || this.modulePath.startsWith("$");
        for (long n = 0; n < this.functionNodes.length(); n++) {
            let node = this.functionNodes.get(n);
            let nameToken = node.name();
            if (nameToken == null || nameToken.text().length == 0) {
                continue;
            }
            string name = nameToken.text();
            Span nameSpan = nameToken.span();
            if (name == "main" && !mayDefineMain) {
                this.reporter.report("Function 'main' is the program entry point and may only "
                    + "be defined in the main module (src/main.ens); module "
                    + "'{this.modulePath}' cannot define it.", nameSpan);
            }
            let modifiers = members.functionModifiers(node);
            let typeParameters = this.resolver.resolveTypeParameters(node.green(),
                node.typeParameters());
            this.resolver.pushTypeParameters(typeParameters);
            let signature = members.buildSignature(this.resolver, this.reporter, node, name,
                nameSpan, false, false, false, modifiers.declaresNoreturn, null, "",
                typeParameters);
            members.checkThrowsPlacement(this.reporter, node, false,
                modifiers.declaresAbstract);
            members.checkNoreturnPlacement(this.reporter, node, false, false,
                modifiers.declaresNoreturn);
            members.checkFunctionModifiers(this.reporter, node);
            this.resolver.popTypeParameters(typeParameters.length);
            if (name == "main" && mayDefineMain) {
                this.checkEntrySignature(node, signature);
            }
            if (this.nameCollidesWithBinding(name)) {
                this.reporter.report("Function name '{name}' is already used by an imported "
                    + "or built-in type in this file; rename the function.", nameSpan);
                continue;
            }
            FunctionEntry? takenOver = null;
            let existing = this.context.functions().entriesNamed(name);
            if (existing != null && existing.length() > 0) {
                if (name == "main") {
                    this.reporter.report("Function 'main' cannot be overloaded; it is the "
                        + "program entry point.", nameSpan);
                    continue;
                }
                bool anyGeneric = signature.isGeneric();
                for (long i = 0; i < existing.length(); i++) {
                    if (existing.get(i).signature().isGeneric()) {
                        anyGeneric = true;
                    }
                }
                if (anyGeneric) {
                    this.reporter.report(genericOverloadMessage(name, existing), nameSpan);
                    continue;
                }
                let clashing = this.context.functions().entryWithSameParameters(signature);
                if (clashing != null && !clashing.isBuiltin()) {
                    this.reporter.report("Function '{name}' is already declared with the same "
                        + "parameter types; overloads must differ in parameter count or types.",
                        nameSpan);
                    continue;
                }
                // A declaration matching a function the language provides takes it over here and
                // answers every call in this module; every other module keeps the provided one.
                takenOver = clashing;
            }
            let entry = new FunctionEntry(signature, members.topLevelVisibility(modifiers), false,
                null, "");
            if (takenOver == null) {
                this.context.functions().add(entry);
            } else {
                this.context.functions().replace(takenOver, entry);
            }
        }
    }

    // The entry point is started by the operating system, which passes no arguments and takes the
    // returned 'int' as the process exit code, so 'main' is a plain function with no type
    // parameters, no parameters, and either 'int' or no return type at all.
    checkEntrySignature(FunctionDeclarationNode node, Signature signature) {
        let typeParameterList = node.typeParameters();
        if (typeParameterList != null && typeParameterList.parametersCount() > 0) {
            let first = typeParameterList.parameters(0);
            this.reporter.report("Function 'main' is the program entry point and cannot be "
                + "generic, so it cannot declare the type parameter '{first.name().text()}'; "
                + "nothing calls it with type arguments. Declare it as 'main() -> int' (or "
                + "'main()') and put the generic work in a function that 'main' calls.",
                first.span());
        }
        Parameter[] parameters = signature.parameters();
        if (parameters.length > 0) {
            this.reporter.report("Function 'main' is the program entry point and takes no "
                + "parameters, so it cannot declare '{parameters[0].name()}'. Declare it as "
                + "'main() -> int' (or 'main()') and read the command line with "
                + "'system.arguments()' after 'import @std.system;'.", parameters[0].span());
        }
        Type returned = signature.returnType();
        if (returned is ErrorType || types.isVoidType(returned)) {
            return;
        }
        if (returned is PrimitiveType && returned.kind() == PrimitiveKind.Int) {
            return;
        }
        Span at = signature.nameSpan();
        let returnClause = node.returnType();
        if (returnClause != null) {
            at = returnClause.returnedType().span();
        }
        this.reporter.report("Function 'main' is the program entry point and must return 'int' "
            + "or nothing, not '{types.display(returned)}'; the value it returns becomes the "
            + "process exit code. Write 'main() -> int' to choose the exit code, or 'main()' to "
            + "leave it 0.", at);
    }

    collectExternalFunctions() {
        for (long n = 0; n < this.externalBlockNodes.length(); n++) {
            let block = this.externalBlockNodes.get(n);
            string library = block.library().text();
            let module = this.context.module();
            if (library.length > 0 && module.nativesRestricted()
                    && !module.declaresNative(library)) {
                this.reporter.report("External library '{library}' is not declared in "
                    + "{module.manifestPath()}. Add 'native {library};' (or a 'system' or "
                    + "per-platform form) to the package manifest.", block.library().span());
            }
            for (long i = 0; i < block.functionsCount(); i++) {
                let item = block.functions(i);
                if (item is ExternalFunctionDeclarationNode) {
                    this.collectExternalFunction(item, library);
                }
            }
        }
    }

    collectExternalFunction(ExternalFunctionDeclarationNode declaration, string library) {
        string name = declaration.name().text();
        if (name.length == 0) {
            return;
        }
        Span nameSpan = declaration.name().span();
        let store = this.resolver.typeStore();
        Type returnType = store.primitive(PrimitiveKind.Void);
        let returnClause = declaration.returnType();
        if (returnClause != null) {
            returnType = this.resolver.resolveReturnType(returnClause.returnedType());
            let nested = nestedOptionalAcrossC(returnType);
            if (nested != null) {
                this.reporter.report("External function '{name}' returns "
                    + "'{types.display(returnType)}'. {nested}",
                    returnClause.returnedType().span());
            }
        }
        let parameterList = declaration.parameters();
        let parameters = new List<Parameter>();
        for (long i = 0; i < parameterList.parametersCount(); i++) {
            let parameterNode = parameterList.parameters(i);
            string parameterName = parameterNode.name().text();
            Span parameterSpan = parameterNode.span();
            Type parameterType = store.errorType();
            let declaredType = parameterNode.declaredType();
            if (declaredType != null) {
                parameterType = this.resolver.resolveType(declaredType);
            }
            bool isOut = parameterNode.outKeyword() != null;
            if (isOut && !outParameterAllowed(parameterType)) {
                this.reporter.report("Out parameter '{parameterName}' of '{name}' has type "
                    + "'{types.display(parameterType)}'. 'out' parameters must be a primitive "
                    + "or an external type.", parameterSpan);
            }
            if (!(parameterType is ErrorType)) {
                let nested = nestedOptionalAcrossC(parameterType);
                if (nested != null) {
                    this.reporter.report("External function parameter '{parameterName}' of "
                        + "'{name}' has type '{types.display(parameterType)}'. {nested}",
                        parameterSpan);
                }
                Type bare = parameterType;
                if (bare is OptionalType) {
                    bare = bare.inner();
                }
                if (bare is ArrayType) {
                    if (isOut) {
                        this.reporter.report("Out parameter '{parameterName}' of '{name}' has "
                            + "type '{types.display(parameterType)}'. Array 'out' parameters "
                            + "are not supported.", parameterSpan);
                    }
                    if (!abiScalar(bare.element())) {
                        this.reporter.report("External function parameter '{parameterName}' "
                            + "of '{name}' has type '{types.display(parameterType)}'. Array "
                            + "elements passed to C must be a primitive or an external type.",
                            parameterSpan);
                    }
                }
            }
            if (parameterNode.defaultValue() != null) {
                this.reporter.report("External function parameters cannot have default "
                    + "values.", parameterSpan);
            }
            if (parameterNode.thisPrefix() != null) {
                this.reporter.report("'this.' parameters are not allowed in external "
                    + "functions.", parameterSpan);
            }
            parameters.push(new Parameter(parameterName, parameterType, false, isOut,
                parameterNode.defaultValue() != null, parameterSpan));
        }
        let signature = new Signature(name, parameters.toArray(), returnType, false, false, [],
            [], [], declaration.green(), nameSpan);
        let existing = this.context.functions().entriesNamed(name);
        if (existing != null && existing.length() > 0) {
            this.reporter.report("External function '{name}' cannot share its name with "
                + "another function; C symbols cannot be overloaded.", nameSpan);
            return;
        }
        if (this.nameCollidesWithBinding(name)) {
            this.reporter.report("Function name '{name}' is already used by an imported "
                + "or built-in type in this file; rename the function.", nameSpan);
            return;
        }
        this.context.functions().add(new FunctionEntry(signature, Visibility.Private, true,
            null, library));
    }

    nameCollidesWithBinding(string name) -> bool {
        if (this.context.linkTable().binding(name) != null) {
            return true;
        }
        return this.resolver.implicitBinding(name) != null;
    }

    checkTests() {
        if (this.testNodes.length() == 0) {
            return;
        }
        bool inTestFile = this.context.module().filePath().endsWith("_test.ens");
        for (long n = 0; n < this.testNodes.length(); n++) {
            let node = this.testNodes.get(n);
            this.registerTest(node, n);
            if (!inTestFile) {
                this.reporter.report("Test declarations are only allowed in files ending "
                    + "'_test.ens'.", node.testKeyword().span());
            }
            let interpolated = node.descriptionNode();
            if (interpolated != null) {
                this.reporter.report("A test description must be a plain string without "
                    + "interpolation.", interpolated.span());
                continue;
            }
            let token = node.descriptionToken();
            if (token == null || token.kind() != SyntaxKind.StringLiteral) {
                continue;
            }
            string content = unquote(token.text());
            if (content.length == 0) {
                this.reporter.report("A test description cannot be empty.", token.span());
            } else if (hasLineBreak(content)) {
                this.reporter.report("A test description cannot contain a line break.",
                    token.span());
            }
        }
    }

    // A test declaration is a callable like any function: public so the synthesized test runner
    // module can call it, zero parameters, void, named '$test<N>' in source order. It carries an
    // implicit declared contract of 'throws Error', letting the body throw anything (or nothing)
    // while the runner handles every failure with a single 'catch (Error)'. The name repeats
    // across modules; the link name qualifies it with the module path like any public function's.
    registerTest(TestDeclarationNode node, long index) {
        let store = this.resolver.typeStore();
        Span at = node.testKeyword().span();
        Type[] contract = [];
        Span[] contractSpans = [];
        let errorBase = this.resolver.errorClass();
        if (errorBase != null) {
            contract = [errorBase];
            contractSpans = [at];
        }
        let signature = new Signature("$test{index}", [], store.primitive(PrimitiveKind.Void),
            true, false, contract, contractSpans, [], node.green(), at);
        this.context.functions().add(new FunctionEntry(signature, Visibility.Public, false,
            null, ""));
    }
}

// A cycle of interface 'extends' links has no flattened requirement set; the first interface
// found on a cycle is diagnosed and its extends link cleared, which dissolves the cycle for the
// rest. Runs once, after every module's signatures resolved the links.
public breakInterfaceExtensionCycles(List<ModuleContext> contexts) -> FileDiagnostic[] {
    let collected = new List<FileDiagnostic>();
    for (long i = 0; i < contexts.length(); i++) {
        let context = contexts.get(i);
        let root = context.root();
        if (root == null) {
            continue;
        }
        let store = context.resolver().typeStore();
        string modulePath = context.module().canonicalPath();
        for (long n = 0; n < root.itemsCount(); n++) {
            switch (root.items(n)) {
                is InterfaceDeclarationNode node -> {
                    let found = store.findDeclared(modulePath, node.name().text());
                    if (found is InterfaceType && found.declaration() == node.green()) {
                        breakCycleThrough(found, context.module().filePath(), node.name().span(),
                            collected);
                    }
                },
                default -> { },
            }
        }
    }
    return diagnostics.sorted(collected);
}

breakCycleThrough(InterfaceType interfaceType, string filePath, Span nameSpan,
                  List<FileDiagnostic> collected) {
    let seen = new Set<InterfaceType>();
    InterfaceType? current = interfaceType;
    while (current != null) {
        if (!seen.add(current)) {
            collected.push(new FileDiagnostic(filePath,
                "Interface '{interfaceType.name()}' eventually extends itself through the "
                + "interfaces it extends. An interface cannot extend itself, directly or "
                + "indirectly.", nameSpan));
            interfaceType.clearBase();
            return;
        }
        current = extendedAuthority(current);
    }
}

// The interface the extends link continues through: a generic target defers to its template.
extendedAuthority(InterfaceType interfaceType) -> InterfaceType? {
    let base = interfaceType.base();
    if (base == null) {
        return null;
    }
    let authority = types.authorityOf(base);
    if (authority is InterfaceType) {
        return authority;
    }
    return null;
}

// The provided function is nowhere in the author's source, so a collision with it names it
// instead of counting the name's declarations.
genericOverloadMessage(string name, List<FunctionEntry> existing) -> string {
    let provided = providedAmong(existing);
    if (provided == null) {
        return "Function '{name}' cannot be overloaded because one of its declarations is "
            + "generic; generic functions do not support overloading.";
    }
    return "'{name}' is a function the language provides in every module, and a generic function "
        + "cannot be overloaded, so a declaration of '{name}' cannot have type parameters. "
        + "Declare it as '{declarationForm(provided.signature())}' to replace the provided "
        + "function in this module, or give this function a different name.";
}

providedAmong(List<FunctionEntry> existing) -> FunctionEntry? {
    for (long i = 0; i < existing.length(); i++) {
        if (existing.get(i).isBuiltin()) {
            return existing.get(i);
        }
    }
    return null;
}

// A signature written the way a declaration of it is, parameter names included, so a suggested
// fix quoting it can be pasted as it stands.
declarationForm(Signature signature) -> string {
    let builder = new StringBuilder();
    builder.append(signature.name());
    builder.append("(");
    Parameter[] parameters = signature.parameters();
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(types.display(parameters[i].type()));
        builder.append(" ");
        builder.append(parameters[i].name());
    }
    builder.append(")");
    return builder.toString();
}

// The kind of a rejected interface 'extends' target, as the diagnostic reads it.
extendTargetKind(Type base) -> string {
    switch (base) {
        is TypeParamType ignored -> {
            return "type parameter";
        },
        is DeclaredType declared -> {
            return types.kindWordOf(declared);
        },
        is InstantiationType instantiation -> {
            return types.kindWordOf(instantiation.template());
        },
        default -> {
            return "primitive type";
        },
    }
}

// The scalar shapes that can cross the C ABI boundary directly.
abiScalar(Type type) -> bool {
    if (type is ExternalType) {
        return true;
    }
    if (type is PrimitiveType) {
        return switch (type.kind()) {
            Decimal, Void -> false,
            default -> true,
        };
    }
    return false;
}

// Why a type nullable at more than one level cannot cross the C boundary, or null when it can.
// A C parameter or result is one machine value whose absence is a null pointer or a zero handle,
// so exactly one level fits; a second one would need a tag C knows nothing about.
nestedOptionalAcrossC(Type type) -> string? {
    if (!(type is OptionalType) || !(type.inner() is OptionalType)) {
        return null;
    }
    Type core = type;
    while (core is OptionalType) {
        core = core.inner();
    }
    return "A C signature carries at most one nullable level, so write it as "
        + "'{types.display(core)}?'.";
}

outParameterAllowed(Type type) -> bool {
    Type bare = type;
    if (bare is OptionalType) {
        bare = bare.inner();
    }
    return abiScalar(bare);
}

unquote(string text) -> string {
    if (text.length >= 2 && text.substring(0, 1) == "\""
            && text.substring(text.length - 1, text.length) == "\"") {
        return text.substring(1, text.length - 1);
    }
    return text;
}

// True when the literal's decoded text would contain a line break: a raw one, an \n or \r
// escape, or a \u escape naming one.
hasLineBreak(string content) -> bool {
    byte[] bytes = content.toBytes();
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '\n' || bytes[i] == '\r') {
            return true;
        }
        if (bytes[i] == '\\' && i + 1 < bytes.length) {
            byte next = bytes[i + 1];
            if (next == 'n' || next == 'r') {
                return true;
            }
            if (next == 'u' && i + 5 < bytes.length) {
                long value = 0;
                bool valid = true;
                for (long d = 0; d < 4; d++) {
                    long digit = hexDigit(bytes[i + 2 + d]);
                    if (digit < 0) {
                        valid = false;
                        break;
                    }
                    value = value * 16 + digit;
                }
                if (valid && (value == 10 || value == 13)) {
                    return true;
                }
            }
            i++;
        }
    }
    return false;
}

hexDigit(byte value) -> long {
    if (value >= '0' && value <= '9') {
        return value - '0';
    }
    if (value >= 'a' && value <= 'f') {
        return value - 'a' + 10;
    }
    if (value >= 'A' && value <= 'F') {
        return value - 'A' + 10;
    }
    return -1;
}

// The 64-bit value an enum member's initializer names: an int or long literal by its value, a
// char literal by its codepoint, behind an optional '+' or '-' sign. Null when the expression is
// not such an integer constant.
enumMemberConstant(Expression expr) -> long? {
    if (expr is LiteralExpressionNode && expr.value().kind() == SyntaxKind.CharLiteral) {
        return literalvalues.charCodepoint(expr.value().text()) as long;
    }
    let literal = signedIntegerLiteral(expr);
    if (literal == null) {
        return null;
    }
    let magnitude = literalvalues.integerMagnitude(literal.value().text());
    if (magnitude == null) {
        return null;
    }
    long value = magnitude as long;
    if (expr is PrefixExpressionNode && expr.operator().kind() == SyntaxKind.Minus) {
        return 0 - value;
    }
    return value;
}

signedIntegerLiteral(Expression expr) -> LiteralExpressionNode? {
    if (expr is LiteralExpressionNode) {
        if (isEnumIntegerLiteralKind(expr.value().kind())) {
            return expr;
        }
        return null;
    }
    if (expr is PrefixExpressionNode) {
        SyntaxKind operator = expr.operator().kind();
        if (operator != SyntaxKind.Plus && operator != SyntaxKind.Minus) {
            return null;
        }
        let operand = expr.operand();
        if (operand is LiteralExpressionNode && isEnumIntegerLiteralKind(operand.value().kind())) {
            return operand;
        }
    }
    return null;
}

isEnumIntegerLiteralKind(SyntaxKind kind) -> bool {
    return kind == SyntaxKind.IntLiteral || kind == SyntaxKind.LongLiteral;
}
