// Side tables keyed by green-node identity. One SemaResult accumulates per module; a green node
// belongs to exactly one parse tree, so per-module tables never collide and can be read together.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import SyntaxNode from @ens.frontend.syntax.node;
import LocalBinding from model.scopes;
import LambdaInfo from model.lambdas;
import Field from model.typemembers;
import Method from model.typemembers;
import Signature from model.typemembers;
import Type from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

export class SemaResult {
    Trials trials;
    NodeTable<Type> resolvedTypes;
    NodeTable<LocalBinding> resolvedBindings;
    NodeTable<Method> resolvedMethods;
    NodeTable<Signature> resolvedCallables;
    NodeTable<string> callableFiles;
    NodeTable<long> enumConstants;
    NodeTable<Field> staticConstFields;
    NodeTable<Type[]> callTypeArguments;
    NodeTable<long[]> argumentOrders;
    NodeTable<Type> methodReceivers;
    NodeTable<Type[]> throwsSets;
    NodeTable<bool> abiThrowsFlags;
    NodeTable<bool> deniedMemberAccesses;
    NodeTable<LambdaInfo> lambdas;
    NodeTable<bool> refusedRethrows;
    NodeTable<bool> neverReturningCalls;
    NodeTable<ConstructorCatch> constructorCatches;
    NodeTable<bool> neverReturningValues;

    public constructor() {
        this.trials = new Trials();
        this.resolvedTypes = new NodeTable<Type>(this.trials);
        this.resolvedBindings = new NodeTable<LocalBinding>(this.trials);
        this.resolvedMethods = new NodeTable<Method>(this.trials);
        this.resolvedCallables = new NodeTable<Signature>(this.trials);
        this.callableFiles = new NodeTable<string>(this.trials);
        this.enumConstants = new NodeTable<long>(this.trials);
        this.staticConstFields = new NodeTable<Field>(this.trials);
        this.callTypeArguments = new NodeTable<Type[]>(this.trials);
        this.argumentOrders = new NodeTable<long[]>(this.trials);
        this.methodReceivers = new NodeTable<Type>(this.trials);
        this.throwsSets = new NodeTable<Type[]>(this.trials);
        this.abiThrowsFlags = new NodeTable<bool>(this.trials);
        this.deniedMemberAccesses = new NodeTable<bool>(this.trials);
        this.lambdas = new NodeTable<LambdaInfo>(this.trials);
        this.refusedRethrows = new NodeTable<bool>(this.trials);
        this.neverReturningCalls = new NodeTable<bool>(this.trials);
        this.constructorCatches = new NodeTable<ConstructorCatch>(this.trials);
        this.neverReturningValues = new NodeTable<bool>(this.trials);
    }

    // Starts a trial: what is recorded until the matching endTrial() is undone there, so code can be
    // checked for what it gives without leaving a record of it.
    public beginTrial() {
        this.trials.begin();
    }

    public endTrial() {
        this.trials.end();
    }

    // Records the resolved type of a type-reference or expression node.
    public setType(GreenNode node, Type resolved) {
        this.resolvedTypes.set(node, resolved);
    }

    export typeOf(GreenNode node) -> Type? {
        return this.resolvedTypes.get(node);
    }

    export resolvedTypeCount() -> long {
        return this.resolvedTypes.length();
    }

    // Records which local binding an identifier or declaration site resolved to.
    public setBinding(GreenNode node, LocalBinding binding) {
        this.resolvedBindings.set(node, binding);
    }

    export bindingOf(GreenNode node) -> LocalBinding? {
        return this.resolvedBindings.get(node);
    }

    // Records the method a member access, call, or 'new' resolved to.
    public setMethod(GreenNode node, Method method) {
        this.resolvedMethods.set(node, method);
    }

    export methodOf(GreenNode node) -> Method? {
        return this.resolvedMethods.get(node);
    }

    // Records the signature a free-function call resolved to.
    public setCallable(GreenNode node, Signature signature) {
        this.resolvedCallables.set(node, signature);
    }

    export callableOf(GreenNode node) -> Signature? {
        return this.resolvedCallables.get(node);
    }

    // Records the file that declares the free function a call resolved to.
    public setCallableFile(GreenNode node, string filePath) {
        this.callableFiles.set(node, filePath);
    }

    public callableFileOf(GreenNode node) -> string? {
        return this.callableFiles.get(node);
    }

    // Records that a member access was denied by visibility, so a later check on the same node
    // does not stack a second diagnostic on the one already reported.
    public markMemberAccessDenied(GreenNode node) {
        this.deniedMemberAccesses.set(node, true);
    }

    export memberAccessDeniedAt(GreenNode node) -> bool {
        return this.deniedMemberAccesses.get(node) != null;
    }

    // Records the ordinal of a resolved enum member reference.
    public setEnumConstant(GreenNode node, long ordinal) {
        this.enumConstants.set(node, ordinal);
    }

    export enumConstantOf(GreenNode node) -> long? {
        return this.enumConstants.get(node);
    }

    // Records which static const field a member read resolved to; code generation folds the
    // read to the field's evaluated constant.
    public setStaticConstField(GreenNode node, Field field) {
        this.staticConstFields.set(node, field);
    }

    export staticConstFieldOf(GreenNode node) -> Field? {
        return this.staticConstFields.get(node);
    }

    // Records the resolved type arguments of a generic function call.
    public setCallTypeArguments(GreenNode node, Type[] arguments) {
        this.callTypeArguments.set(node, arguments);
    }

    export callTypeArgumentsOf(GreenNode node) -> Type[]? {
        return this.callTypeArguments.get(node);
    }

    // Records the source-order argument to parameter-index mapping of a call using named arguments.
    public setArgumentOrder(GreenNode node, long[] order) {
        this.argumentOrders.set(node, order);
    }

    export argumentOrderOf(GreenNode node) -> long[]? {
        return this.argumentOrders.get(node);
    }

    // Records the receiver type a method or constructor body checks against.
    public setReceiver(GreenNode node, Type receiver) {
        this.methodReceivers.set(node, receiver);
    }

    export receiverOf(GreenNode node) -> Type? {
        return this.methodReceivers.get(node);
    }

    // Records what checking a lambda against its target type produced, keyed by the lambda.
    public setLambda(GreenNode node, LambdaInfo info) {
        this.lambdas.set(node, info);
    }

    export lambdaOf(GreenNode node) -> LambdaInfo? {
        return this.lambdas.get(node);
    }

    // Records the converged outward throw set of a callable or test, keyed by its declaration.
    public setThrowsSet(GreenNode node, Type[] thrown) {
        this.throwsSets.set(node, thrown);
    }

    export throwsSetOf(GreenNode node) -> Type[]? {
        return this.throwsSets.get(node);
    }

    // Records whether the callable's machine interface carries the trailing error-slot
    // parameter, keyed by its declaration.
    public setAbiThrows(GreenNode node, bool carriesErrorSlot) {
        this.abiThrowsFlags.set(node, carriesErrorSlot);
    }

    export abiThrowsOf(GreenNode node) -> bool? {
        return this.abiThrowsFlags.get(node);
    }

    // Records that the body of the callable declared at 'node' has a 'rethrow' refused outside any
    // 'catch' clause, so that body is not also reported as throwing nothing.
    public setRefusedRethrow(GreenNode node) {
        this.refusedRethrows.set(node, true);
    }

    public holdsRefusedRethrow(GreenNode node) -> bool {
        return this.refusedRethrows.contains(node);
    }

    // Records that an expression never returns, so the path ends after it and no value of it is
    // read. The key is the expression as written, with its parentheses and 'try'.
    public setNeverReturns(GreenNode node) {
        this.neverReturningCalls.set(node, true);
    }

    export neverReturns(GreenNode node) -> bool {
        return this.neverReturningCalls.contains(node);
    }

    // Records that an expression that never returns is written where a value of its recorded type
    // is read, so code generation gives the code after it, which nothing reaches, a value to read.
    public setNeverReturningValue(GreenNode node) {
        this.neverReturningValues.set(node, true);
    }

    export isNeverReturningValue(GreenNode node) -> bool {
        return this.neverReturningValues.contains(node);
    }

    // Records what a constructor's catch clause does that needs the base class constructed, keyed
    // by the clause.
    public setConstructorCatch(GreenNode clause, ConstructorCatch facts) {
        this.constructorCatches.set(clause, facts);
    }

    export constructorCatchOf(GreenNode clause) -> ConstructorCatch? {
        return this.constructorCatches.get(clause);
    }
}

// What a constructor's catch clause does that depends on how far the body ran before it threw:
// finishing the constructor normally, by reaching the end of the clause or through each 'return' in
// it, calling 'super(...)', each use of 'this' that needs a field the body may not have assigned, and
// each place a path finishes the constructor without such a field.
export final class ConstructorCatch {
    bool endReached;
    Span[] returnSpans;
    Span[] superCallSpans;
    CatchThisUse[] thisUses;
    CatchFinish[] unassignedFinishes;

    public constructor(this.endReached, this.returnSpans, this.superCallSpans, this.thisUses,
        this.unassignedFinishes);

    export reachesEnd() -> bool {
        return this.endReached;
    }

    export returns() -> Span[] {
        return this.returnSpans;
    }

    export superCalls() -> Span[] {
        return this.superCallSpans;
    }

    export uses() -> CatchThisUse[] {
        return this.thisUses;
    }

    export finishes() -> CatchFinish[] {
        return this.unassignedFinishes;
    }

    export isEmpty() -> bool {
        return !this.endReached && this.returnSpans.length == 0 && this.superCallSpans.length == 0
            && this.thisUses.length == 0 && this.unassignedFinishes.length == 0;
    }
}

// What a constructor does with 'this' at one place, for a text that refuses it there.
export enum ThisUseKind {
    Read,
    CompoundAssignment,
    MemberWrite,
}

// A use of 'this' in a constructor: a read of 'field', a compound assignment to it, whose operator
// is 'detail', or a write to its member 'detail'.
export final class ThisUse {
    ThisUseKind useKind;
    Field usedField;
    string useDetail;
    Span useSpan;

    public constructor(this.useKind, this.usedField, this.useDetail, this.useSpan);

    export kind() -> ThisUseKind {
        return this.useKind;
    }

    export field() -> Field {
        return this.usedField;
    }

    export detail() -> string {
        return this.useDetail;
    }

    export span() -> Span {
        return this.useSpan;
    }
}

// A use of 'this' in a constructor's catch clause, with each place the body can throw from where a
// field the use needs has no value yet.
export final class CatchThisUse {
    ThisUse thisUse;
    EscapeGap[] escapeGaps;

    public constructor(this.thisUse, this.escapeGaps);

    export use() -> ThisUse {
        return this.thisUse;
    }

    export gaps() -> EscapeGap[] {
        return this.escapeGaps;
    }
}

// A call or a 'throw' statement the constructor body can throw from, and a field with no value
// there, which the class declares or inherits.
export final class EscapeGap {
    SyntaxNode escapeNode;
    Field missingField;
    bool inheritedField;

    public constructor(this.escapeNode, this.missingField, this.inheritedField);

    export escape() -> SyntaxNode {
        return this.escapeNode;
    }

    export missing() -> Field {
        return this.missingField;
    }

    export missingIsInherited() -> bool {
        return this.inheritedField;
    }
}

// A place a path through a constructor's catch clause finishes the constructor without own fields
// that need a value, with each place the body can throw from without one of them.
export final class CatchFinish {
    Span finishSpan;
    EscapeGap[] escapeGaps;

    public constructor(this.finishSpan, this.escapeGaps);

    export span() -> Span {
        return this.finishSpan;
    }

    export gaps() -> EscapeGap[] {
        return this.escapeGaps;
    }
}

// The open trials of one SemaResult and what undoes each write made while one is open, latest
// last.
final class Trials {
    List<() -> void> undoSteps;
    List<long> starts;

    constructor() {
        this.undoSteps = new List<() -> void>();
        this.starts = new List<long>();
    }

    isOpen() -> bool {
        return !this.starts.isEmpty();
    }

    remember(() -> void undo) {
        this.undoSteps.push(undo);
    }

    begin() {
        this.starts.push(this.undoSteps.length());
    }

    end() {
        long start = this.starts.pop();
        while (this.undoSteps.length() > start) {
            let undo = this.undoSteps.pop();
            undo();
        }
    }
}

// One side table, whose writes made during a trial are undone when the trial ends.
final class NodeTable<V> {
    Map<GreenNode, V> entries;
    Trials trials;

    constructor(Trials trials) {
        this.entries = new Map<GreenNode, V>();
        this.trials = trials;
    }

    get(GreenNode node) -> V? {
        return this.entries.get(node);
    }

    contains(GreenNode node) -> bool {
        return this.entries.contains(node);
    }

    length() -> long {
        return this.entries.length();
    }

    set(GreenNode node, V value) {
        if (this.trials.isOpen()) {
            this.trials.remember(undoing(this.entries, node));
        }
        this.entries.set(node, value);
    }
}

// What puts back the entry 'node' has in 'entries' now, or removes the entry it does not have yet.
undoing<V>(Map<GreenNode, V> entries, GreenNode node) -> () -> void {
    let previous = entries.get(node);
    if (previous == null) {
        return () -> entries.remove(node);
    }
    V kept = previous;
    return () -> entries.set(node, kept);
}
