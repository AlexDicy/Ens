// Side tables keyed by green-node identity. One SemaResult accumulates per module; a green node
// belongs to exactly one parse tree, so per-module tables never collide and can be read together.
import GreenNode from @ens.frontend.syntax.green;
import LocalBinding from model.scopes;
import Type from model.types;
import Method from model.types;
import Signature from model.types;
import Map from @std.collections.map;

public class SemaResult {
    Map<GreenNode, Type> resolvedTypes;
    Map<GreenNode, LocalBinding> resolvedBindings;
    Map<GreenNode, Method> resolvedMethods;
    Map<GreenNode, Signature> resolvedCallables;
    Map<GreenNode, long> enumConstants;
    Map<GreenNode, Type[]> callTypeArguments;
    Map<GreenNode, long[]> argumentOrders;
    Map<GreenNode, Type> methodReceivers;
    Map<GreenNode, Type[]> throwsSets;

    public constructor() {
        this.resolvedTypes = new Map<GreenNode, Type>();
        this.resolvedBindings = new Map<GreenNode, LocalBinding>();
        this.resolvedMethods = new Map<GreenNode, Method>();
        this.resolvedCallables = new Map<GreenNode, Signature>();
        this.enumConstants = new Map<GreenNode, long>();
        this.callTypeArguments = new Map<GreenNode, Type[]>();
        this.argumentOrders = new Map<GreenNode, long[]>();
        this.methodReceivers = new Map<GreenNode, Type>();
        this.throwsSets = new Map<GreenNode, Type[]>();
    }

    // Records the resolved type of a type-reference or expression node.
    public setType(GreenNode node, Type resolved) {
        this.resolvedTypes.set(node, resolved);
    }

    public typeOf(GreenNode node) -> Type? {
        return this.resolvedTypes.get(node);
    }

    public resolvedTypeCount() -> long {
        return this.resolvedTypes.length();
    }

    // Records which local binding an identifier or declaration site resolved to.
    public setBinding(GreenNode node, LocalBinding binding) {
        this.resolvedBindings.set(node, binding);
    }

    public bindingOf(GreenNode node) -> LocalBinding? {
        return this.resolvedBindings.get(node);
    }

    // Records the method a member access, call, or 'new' resolved to.
    public setMethod(GreenNode node, Method method) {
        this.resolvedMethods.set(node, method);
    }

    public methodOf(GreenNode node) -> Method? {
        return this.resolvedMethods.get(node);
    }

    // Records the signature a free-function call resolved to.
    public setCallable(GreenNode node, Signature signature) {
        this.resolvedCallables.set(node, signature);
    }

    public callableOf(GreenNode node) -> Signature? {
        return this.resolvedCallables.get(node);
    }

    // Records the ordinal of a resolved enum member reference.
    public setEnumConstant(GreenNode node, long ordinal) {
        this.enumConstants.set(node, ordinal);
    }

    public enumConstantOf(GreenNode node) -> long? {
        return this.enumConstants.get(node);
    }

    // Records the resolved type arguments of a generic function call.
    public setCallTypeArguments(GreenNode node, Type[] arguments) {
        this.callTypeArguments.set(node, arguments);
    }

    callTypeArgumentsOf(GreenNode node) -> Type[]? {
        return this.callTypeArguments.get(node);
    }

    // Records the source-order argument to parameter-index mapping of a call using named
    // arguments.
    public setArgumentOrder(GreenNode node, long[] order) {
        this.argumentOrders.set(node, order);
    }

    argumentOrderOf(GreenNode node) -> long[]? {
        return this.argumentOrders.get(node);
    }

    // Records the receiver type a method or constructor body checks against.
    public setReceiver(GreenNode node, Type receiver) {
        this.methodReceivers.set(node, receiver);
    }

    receiverOf(GreenNode node) -> Type? {
        return this.methodReceivers.get(node);
    }

    // Records the converged outward throw set of a callable or test, keyed by its declaration.
    public setThrowsSet(GreenNode node, Type[] thrown) {
        this.throwsSets.set(node, thrown);
    }

    public throwsSetOf(GreenNode node) -> Type[]? {
        return this.throwsSets.get(node);
    }
}
