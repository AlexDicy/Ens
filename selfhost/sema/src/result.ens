// Side tables keyed by green-node identity. One SemaResult accumulates per module; a green node
// belongs to exactly one parse tree, so per-module tables never collide and can be read together.
// Later phases add expression types and symbols here without reshaping the callers.
import GreenNode from @ens.frontend.syntax.green;
import Type from types;
import Map from @std.collections.map;

public class SemaResult {
    private Map<GreenNode, Type> resolvedTypes;

    constructor() {
        this.resolvedTypes = new Map<GreenNode, Type>();
    }

    // Records the resolved type of a type-reference node.
    setType(GreenNode reference, Type resolved) {
        this.resolvedTypes.set(reference, resolved);
    }

    typeOf(GreenNode reference) -> Type? {
        return this.resolvedTypes.get(reference);
    }

    resolvedTypeCount() -> long {
        return this.resolvedTypes.length();
    }
}
