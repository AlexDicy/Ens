// Path helpers for the sema layer. Paths are plain strings joined with '/'; nothing here touches
// the file system.
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;

public join(string base, string relative) -> string {
    if (base.length == 0) {
        return relative;
    }
    if (base.substring(base.length - 1, base.length) == "/") {
        return base + relative;
    }
    return base + "/" + relative;
}

// The folder one level up, "/" at the root, or "" when the path has no separator left.
public parentFolder(string path) -> string {
    long index = lastSlashIndex(path);
    if (index < 0) {
        return "";
    }
    if (index == 0) {
        return "/";
    }
    return path.substring(0, index);
}

// Collapses '.' and '..' segments and repeated separators, textually.
public normalize(string path) -> string {
    bool absolute = path.length > 0 && path.substring(0, 1) == "/";
    string[] segments = split(path, "/");
    let kept = new List<string>();
    long keptCount = 0;
    for (long i = 0; i < segments.length; i++) {
        string segment = segments[i];
        if (segment.length == 0 || segment == ".") {
            continue;
        }
        if (segment == "..") {
            if (keptCount > 0 && kept.get(keptCount - 1) != "..") {
                keptCount--;
                continue;
            }
            if (absolute) {
                continue;
            }
        }
        if (keptCount < kept.length()) {
            kept.set(keptCount, segment);
        } else {
            kept.push(segment);
        }
        keptCount++;
    }
    let builder = new StringBuilder();
    if (absolute) {
        builder.append("/");
    }
    for (long i = 0; i < keptCount; i++) {
        if (i > 0) {
            builder.append("/");
        }
        builder.append(kept.get(i));
    }
    if (builder.length() == 0) {
        return ".";
    }
    return builder.toString();
}

// Joins parts[from..to) with the separator.
public joinRange(string[] parts, string separator, long from, long to) -> string {
    let builder = new StringBuilder();
    for (long i = from; i < to; i++) {
        if (i > from) {
            builder.append(separator);
        }
        builder.append(parts[i]);
    }
    return builder.toString();
}

public split(string text, string separator) -> string[] {
    let parts = new List<string>();
    string rest = text;
    while (true) {
        long index = rest.indexOf(separator);
        if (index < 0) {
            parts.push(rest);
            break;
        }
        parts.push(rest.substring(0, index));
        rest = rest.substring(index + separator.length, rest.length);
    }
    return parts.toArray();
}

private lastSlashIndex(string path) -> long {
    byte[] bytes = path.toBytes();
    for (long i = bytes.length - 1; i >= 0; i--) {
        if (bytes[i] == '/') {
            return i;
        }
    }
    return -1;
}
