// The narrowing policy of the body checker. Flow narrowing does not exist yet, so a value the
// flow has proven non-null (or proven to be a subclass) still carries its declared type here.
// Every place a narrowing judgment would be needed routes through this module and answers
// permissively: optionals read as their inner type, optional sources pass where the inner type
// would, null fits any target, and a class value passes where a subclass is expected. The
// narrowing milestone replaces these answers with flow-aware checks and turns each permissive
// path into its deferred diagnostic.
import convert;
import types;
import Type from types;
import NullType from types;
import OptionalType from types;

// The type a value reads as where an operation consumes it: an optional participates as its
// inner type with no "may be null" diagnostic.
public valueOf(Type type) -> Type {
    if (type is OptionalType) {
        return type.inner();
    }
    return type;
}

// The assignability the checker enforces: the strict relation, widened so a source the flow
// could have narrowed passes. The extra acceptances are exactly the deferred narrowing
// diagnostics: a null source, an optional source read as its inner type, and a class value
// where a subclass or conforming class is expected.
public isAssignable(Type target, Type source) -> bool {
    if (convert.isAssignableStrict(target, source)) {
        return true;
    }
    if (source is NullType) {
        return true;
    }
    if (source is OptionalType && convert.isAssignableStrict(target, source.inner())) {
        return true;
    }
    Type targetCore = convert.bareOf(target);
    Type sourceCore = convert.bareOf(source);
    if (types.isClassLike(targetCore) && types.isClassLike(sourceCore)) {
        if (types.isInterfaceLike(targetCore) || types.isInterfaceLike(sourceCore)) {
            return true;
        }
        return types.isSubclassOrConforms(targetCore, sourceCore);
    }
    return false;
}

// The receiver type behind a safe operator ('?.', '?['). A non-optional receiver is accepted
// silently; the "can never be null" diagnostic is deferred.
public safeReceiverInner(Type type) -> Type {
    if (type is OptionalType) {
        return type.inner();
    }
    return type;
}

// The left operand of '??'. A non-nullable left is accepted silently and reads as itself; the
// "must be a nullable value" diagnostic is deferred.
public coalesceOperand(Type type) -> Type {
    if (type is OptionalType) {
        return type.inner();
    }
    return type;
}

// A 'null' switch label. Every scrutinee reads as nullable here, so the label is always
// accepted; the "'null' is only valid when the switch value is nullable" diagnostic and the
// "nullable scrutinee needs a 'null' arm or a default" exhaustiveness rule are both deferred.
public nullLabelPermitted(Type scrutinee) -> bool {
    return true;
}
