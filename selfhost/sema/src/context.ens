// Per-module state shared by the sema phases: the parsed module, its link table, its resolver,
// its side tables, and the free-function table the signature phase fills. Modules stay
// independent; the type store is the only state they share.
import Module from program.graph;
import FileDeclarations from phases.declare;
import ModuleLinkTable from phases.link;
import TypeResolver from phases.resolve;
import SemaResult from result;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import ClassDeclarationNode from @ens.frontend.syntax.generated.nodes;
import Signature from model.types;
import ClassType from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

export class ModuleContext {
    Module contextModule;
    FileDeclarations contextDeclarations;
    SourceFileNode? contextRoot;
    ModuleLinkTable contextLinkTable;
    TypeResolver contextResolver;
    SemaResult contextResult;
    FunctionTable contextFunctions;

    public constructor(Module module, FileDeclarations declarations, SourceFileNode? root,
                ModuleLinkTable linkTable, TypeResolver resolver, SemaResult result) {
        this.contextModule = module;
        this.contextDeclarations = declarations;
        this.contextRoot = root;
        this.contextLinkTable = linkTable;
        this.contextResolver = resolver;
        this.contextResult = result;
        this.contextFunctions = new FunctionTable();
    }

    export module() -> Module {
        return this.contextModule;
    }

    public declarations() -> FileDeclarations {
        return this.contextDeclarations;
    }

    export root() -> SourceFileNode? {
        return this.contextRoot;
    }

    public linkTable() -> ModuleLinkTable {
        return this.contextLinkTable;
    }

    public resolver() -> TypeResolver {
        return this.contextResolver;
    }

    export result() -> SemaResult {
        return this.contextResult;
    }

    export functions() -> FunctionTable {
        return this.contextFunctions;
    }
}

// One class declaration queued for whole-program layout, paired with the module that owns it.
public class ClassItem {
    ModuleContext owningContext;
    ClassType itemType;
    ClassDeclarationNode itemDeclaration;

    public constructor(ModuleContext context, ClassType classType, ClassDeclarationNode declaration) {
        this.owningContext = context;
        this.itemType = classType;
        this.itemDeclaration = declaration;
    }

    public context() -> ModuleContext {
        return this.owningContext;
    }

    public classType() -> ClassType {
        return this.itemType;
    }

    public declaration() -> ClassDeclarationNode {
        return this.itemDeclaration;
    }
}

// One callable a module defines at the top level, including the built-in ones every module sees.
export class FunctionEntry {
    Signature entrySignature;
    Visibility entryVisibility;
    bool externalFunction;
    bool builtinFunction;
    string libraryName;

    public constructor(Signature signature, Visibility visibility, bool isExternal, bool isBuiltin,
                string library) {
        this.entrySignature = signature;
        this.entryVisibility = visibility;
        this.externalFunction = isExternal;
        this.builtinFunction = isBuiltin;
        this.libraryName = library;
    }

    export signature() -> Signature {
        return this.entrySignature;
    }

    protected name() -> string {
        return this.entrySignature.name();
    }

    export visibility() -> Visibility {
        return this.entryVisibility;
    }

    export isExternal() -> bool {
        return this.externalFunction;
    }

    export isBuiltin() -> bool {
        return this.builtinFunction;
    }

    library() -> string {
        return this.libraryName;
    }
}

export class FunctionTable {
    Map<string, List<FunctionEntry>> entriesByName;
    List<FunctionEntry> declarationOrder;

    protected constructor() {
        this.entriesByName = new Map<string, List<FunctionEntry>>();
        this.declarationOrder = new List<FunctionEntry>();
    }

    export entriesNamed(string name) -> List<FunctionEntry>? {
        return this.entriesByName.get(name);
    }

    public add(FunctionEntry entry) {
        let existing = this.entriesByName.get(entry.name());
        if (existing == null) {
            let created = new List<FunctionEntry>();
            created.push(entry);
            this.entriesByName.set(entry.name(), created);
        } else {
            existing.push(entry);
        }
        this.declarationOrder.push(entry);
    }

    export all() -> List<FunctionEntry> {
        return this.declarationOrder;
    }
}
