// Joining part of a list of segments with a separator the caller names. 'Path' joins whole paths
// with '/', and this joins a slice of segments with any separator, which is what lets one segment
// list build both a file path and the dotted module path that reaches it.
import StringBuilder from @std.text.stringbuilder;

// Joins parts[from..to) with the separator.
public joinRange(string[] parts, string separator, long from, long to) -> string {
    let builder = new StringBuilder();
    for (long i = from; i < to; i++) {
        if (i > from) {
            builder.append(separator);
        }
        builder.append(parts[i]);
    }
    return builder.toString();
}
