// Path text helpers: the last segment of a path, and part of a list of segments joined with a
// separator the caller names. 'Path' joins whole paths with '/', and this joins a slice of segments
// with any separator, which lets one segment list build both a file path and the dotted module
// path of that file.
import StringBuilder from @std.text.stringbuilder;

// The last segment of a file path, after its last '/' or '\': 'util.ens' for 'src/util.ens'.
public baseName(string path) -> string {
    long slash = path.lastIndexOf("/");
    long backslash = path.lastIndexOf("\\");
    if (backslash > slash) {
        slash = backslash;
    }
    return path.substring(slash + 1);
}

// Joins parts[from..to) with the separator.
public joinRange(string[] parts, string separator, long from, long to) -> string {
    let builder = new StringBuilder();
    for (long i = from; i < to; i++) {
        if (i > from) {
            builder.append(separator);
        }
        builder.append(parts[i]);
    }
    return builder.toString();
}
