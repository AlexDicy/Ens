// Reading the syntax tree: the expression a pair of parentheses holds, the tokens under a node, and
// the 'super(...)' calls a constructor writes.
import Expression from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import GreenElement from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import List from @std.collections.list;

// What parentheses hold, however many layers deep.
export unwrapParentheses(Expression expression) -> Expression {
    Expression current = expression;
    while (current is ParenthesizedExpressionNode) {
        current = current.inner();
    }
    return current;
}

// Appends every token under the element to the list in source order, the element itself when it
// is a token, and the empty tokens a parser inserted for a missing one among them.
export collectTokens(GreenElement element, List<GreenToken> into) {
    switch (element) {
        is GreenToken token -> {
            into.push(token);
        },
        is GreenNode node -> {
            for (long i = 0; i < node.slotCount(); i++) {
                let slot = node.slot(i);
                if (slot != null) {
                    collectTokens(slot, into);
                }
            }
        },
        default -> { },
    }
}

// The 'super(...)' call a constructor body starts with, or null where it starts with anything
// else, in which case the base class is constructed before the body runs.
export chainingSuperCall(BlockNode? body) -> CallExpressionNode? {
    if (body == null || body.statementsCount() == 0) {
        return null;
    }
    let first = body.statements(0);
    if (!(first is ExpressionStatementNode)) {
        return null;
    }
    let expression = unwrapParentheses(first.expression());
    if (expression is CallExpressionNode && isSuperCall(expression)) {
        return expression;
    }
    return null;
}

// Whether a 'super(...)' call is written anywhere under the node, lambdas included.
export writesSuperCall(SyntaxNode node) -> bool {
    if (node is CallExpressionNode && isSuperCall(node)) {
        return true;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (writesSuperCall(children.get(i))) {
            return true;
        }
    }
    return false;
}

isSuperCall(CallExpressionNode call) -> bool {
    return call.callee() is SuperExpressionNode;
}
