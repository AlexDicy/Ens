// Reading the syntax tree: the expression a pair of parentheses holds, the tokens under a node, the
// 'super(...)' calls a constructor writes and where they are written, and the calls of a chain.
import Expression from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import BlockNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import ArgumentListNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import LambdaExpressionNode from @ens.frontend.syntax.generated.nodes;
import WhileStatementNode from @ens.frontend.syntax.generated.nodes;
import ForStatementNode from @ens.frontend.syntax.generated.nodes;
import ForEachStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchArm from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import GreenElement from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import List from @std.collections.list;

// What parentheses hold, however many layers deep.
export unwrapParentheses(Expression expression) -> Expression {
    Expression current = expression;
    while (current is ParenthesizedExpressionNode) {
        current = current.inner();
    }
    return current;
}

// Appends every token under the element to the list in source order, the element itself when it
// is a token, and the empty tokens a parser inserted for a missing one among them.
export collectTokens(GreenElement element, List<GreenToken> into) {
    switch (element) {
        is GreenToken token -> {
            into.push(token);
        },
        is GreenNode node -> {
            for (long i = 0; i < node.slotCount(); i++) {
                let slot = node.slot(i);
                if (slot != null) {
                    collectTokens(slot, into);
                }
            }
        },
        default -> { },
    }
}

// Whether 'call' is written as a statement of its own, inside any parentheses.
export isStatementCall(CallExpressionNode call) -> bool {
    SyntaxNode? holder = call.parent();
    while (holder is ParenthesizedExpressionNode) {
        holder = holder.parent();
    }
    return holder is ExpressionStatementNode;
}

// Whether 'call' is the initializer of a 'for' loop, as in 'for (super(); ...)'.
export inLoopInitializer(CallExpressionNode call) -> bool {
    SyntaxNode? holder = call.parent();
    while (holder is ParenthesizedExpressionNode) {
        holder = holder.parent();
    }
    return holder is ExpressionStatementNode && holder.parent() is ForStatementNode;
}

// The switch arm whose body is 'call', inside any parentheses, or null.
export armHolding(CallExpressionNode call) -> SwitchArm? {
    SyntaxNode? holder = call.parent();
    while (holder is ParenthesizedExpressionNode) {
        holder = holder.parent();
    }
    if (holder is SwitchArm) {
        return holder;
    }
    return null;
}

// Whether 'node' is inside a loop of the function or the lambda it is written in.
export insideLoop(SyntaxNode node) -> bool {
    SyntaxNode? current = node.parent();
    while (current != null && !(current is FunctionDeclarationNode)
            && !(current is LambdaExpressionNode)) {
        if (current is WhileStatementNode || current is ForStatementNode
                || current is ForEachStatementNode) {
            return true;
        }
        current = current.parent();
    }
    return false;
}

// Whether 'node' is inside the arguments of a 'super(...)' call.
export insideSuperArguments(SyntaxNode node) -> bool {
    SyntaxNode? current = node.parent();
    while (current != null && !(current is FunctionDeclarationNode)) {
        if (current is ArgumentListNode) {
            let call = current.parent();
            if (call is CallExpressionNode && isSuperCall(call)) {
                return true;
            }
        }
        current = current.parent();
    }
    return false;
}

// Whether 'body' writes a 'super(...)' call outside its lambdas, which builds the base class.
export callsSuper(BlockNode? body) -> bool {
    return body != null && writesSuperOutsideLambdas(body);
}

// Whether a 'super(...)' call is written under 'node' outside its lambdas.
export writesSuperOutsideLambdas(SyntaxNode node) -> bool {
    if (node is LambdaExpressionNode) {
        return false;
    }
    if (node is CallExpressionNode && isSuperCall(node)) {
        return true;
    }
    for (let child in node.childNodes()) {
        if (writesSuperOutsideLambdas(child)) {
            return true;
        }
    }
    return false;
}

// Whether a 'super(...)' call is written anywhere under the node, lambdas included.
export writesSuperCall(SyntaxNode node) -> bool {
    if (node is CallExpressionNode && isSuperCall(node)) {
        return true;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        if (writesSuperCall(children.get(i))) {
            return true;
        }
    }
    return false;
}

isSuperCall(CallExpressionNode call) -> bool {
    return call.callee() is SuperExpressionNode;
}

// The call 'call' reads its callee from, as 'settle()' in 'settle().links()', or null where its
// callee is read from anything else.
export receiverCall(CallExpressionNode call) -> CallExpressionNode? {
    Expression? object = null;
    switch (call.callee()) {
        is MemberExpressionNode member -> {
            object = member.object();
        },
        is SafeMemberExpressionNode member -> {
            object = member.object();
        },
        default -> { },
    }
    if (object == null) {
        return null;
    }
    let core = unwrapParentheses(object);
    if (core is CallExpressionNode) {
        return core;
    }
    return null;
}

// The calls a 'try' written before 'call' covers: 'call' and each call of the chain before it, from
// 'call' to the first.
export triedChain(CallExpressionNode call) -> List<CallExpressionNode> {
    let chain = new List<CallExpressionNode>();
    CallExpressionNode? current = call;
    while (current != null) {
        chain.push(current);
        current = receiverCall(current);
    }
    return chain;
}
