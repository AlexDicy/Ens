// Sema diagnostics name the file they belong to alongside the message and span, since one sema
// pass spans many files. Results merge deterministically by (file, offset).
import Span from @ens.frontend.support.source;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// Another place a diagnostic points at, with the sentence that says what is there. A refusal
// reported where a generic's type arguments were written points this way at the line inside the
// generic that could not be judged without them.
export class RelatedLocation {
    string locationFile;
    Span locationSpan;
    string locationNote;

    export constructor(string file, Span span, string note) {
        this.locationFile = file;
        this.locationSpan = span;
        this.locationNote = render(note);
    }

    export file() -> string {
        return this.locationFile;
    }

    export span() -> Span {
        return this.locationSpan;
    }

    export note() -> string {
        return this.locationNote;
    }
}

export class FileDiagnostic {
    string diagnosticFile;
    string diagnosticMessage;
    Span diagnosticSpan;
    RelatedLocation[] diagnosticRelated;

    // A problem at one place in the file, with no notes.
    export constructor(string file, string message, Span span) {
        this.diagnosticFile = file;
        this.diagnosticMessage = render(message);
        this.diagnosticSpan = span;
        this.diagnosticRelated = [];
    }

    // A problem at one place in the file, with a note at one other place.
    export constructor(string file, string message, Span span, RelatedLocation related) {
        this.diagnosticFile = file;
        this.diagnosticMessage = render(message);
        this.diagnosticSpan = span;
        this.diagnosticRelated = [related];
    }

    // A problem at one place in the file, with a note at each other place, in reading order.
    export constructor(string file, string message, Span span, RelatedLocation[] related) {
        this.diagnosticFile = file;
        this.diagnosticMessage = render(message);
        this.diagnosticSpan = span;
        this.diagnosticRelated = related;
    }

    export file() -> string {
        return this.diagnosticFile;
    }

    export message() -> string {
        return this.diagnosticMessage;
    }

    export span() -> Span {
        return this.diagnosticSpan;
    }

    // The other places this diagnostic points at, in the order their notes are read, and empty
    // when it points at one place only.
    export related() -> RelatedLocation[] {
        return this.diagnosticRelated;
    }
}

// Collects diagnostics for one file into a shared per-phase list, so helpers report without
// threading the file path everywhere.
public class Reporter {
    string reporterFile;
    List<FileDiagnostic> sink;

    public constructor(string file, List<FileDiagnostic> sink) {
        this.reporterFile = file;
        this.sink = sink;
    }

    file() -> string {
        return this.reporterFile;
    }

    public report(string message, Span span) {
        this.sink.push(new FileDiagnostic(this.reporterFile, message, span));
    }

    // Reports a problem that points at a second place in the same file, with the sentence that
    // says what is there.
    public report(string message, Span span, Span relatedSpan, string note) {
        this.sink.push(new FileDiagnostic(this.reporterFile, message, span,
            new RelatedLocation(this.reporterFile, relatedSpan, note)));
    }

    // Reports a problem that points at other places, each with the sentence that says what is there.
    public report(string message, Span span, RelatedLocation[] related) {
        this.sink.push(new FileDiagnostic(this.reporterFile, message, span, related));
    }

    // A place in this file that a reported problem points at, with the sentence that says what is there.
    public noteAt(Span span, string note) -> RelatedLocation {
        return new RelatedLocation(this.reporterFile, span, note);
    }
}

// The characters of the marker a quote of types writes right after itself, which render()
// replaces with the quote's module note. They are Unicode noncharacters, which Unicode sets aside
// for a program's internal use.
final class NoteMarker {
    static const string start = "\uFDD0";
    static const string end = "\uFDD1";
    static const string record = "\uFDD2";
    static const string field = "\uFDD3";
}

// Text taken from a program's source, its file and folder names or its manifests, as a message
// quotes it. Each character a marker is made of
// is written as the escape a string literal writes it with, as in '\uFDD0', so the text reads as
// it is written and never as a module note.
export sourceText(string text) -> string {
    return text.replace(NoteMarker.start, "\\uFDD0").replace(NoteMarker.end, "\\uFDD1")
        .replace(NoteMarker.record, "\\uFDD2").replace(NoteMarker.field, "\\uFDD3");
}

// The marker after a quote of types, built from the names the quote writes, in order.
public final class MentionMarker {
    StringBuilder records;

    public constructor() {
        this.records = new StringBuilder();
    }

    // A declared type the quote writes as 'written'. 'key' tells it apart from every other type,
    // 'needsNote' says whether a quote spelled this way names its module, and 'importPath' is
    // the module as an import writes it.
    public writeDeclared(string written, string key, bool needsNote, string importPath) {
        string needed = needsNote ? "1" : "0";
        this.records.append(NoteMarker.record);
        this.records.append(sourceText(written) + NoteMarker.field + sourceText(key) + NoteMarker.field
            + needed + NoteMarker.field + sourceText(importPath));
    }

    // A type parameter the quote writes, which a declared type of the same name can be taken for.
    public writeTypeParameter(string written) {
        this.writeDeclared(written, "", false, "");
    }

    // The marker, empty when the quote writes no names. 'headKey' is the key of the type a quote
    // of one type opens with, which can take the short note ' (from sizes.b)', and empty for any
    // other quote. A quote that 'writesCode' always keeps its own note.
    public marker(string headKey, bool writesCode) -> string {
        if (this.records.isEmpty()) {
            return "";
        }
        string code = writesCode ? "1" : "0";
        return NoteMarker.start + sourceText(headKey) + NoteMarker.field + code + this.records.toString()
            + NoteMarker.end;
    }
}

// A name a quote writes, read back from its marker, with an empty key for a type parameter.
final class MentionedName {
    string written;
    string key;
    bool needsNote;
    string importPath;

    constructor(this.written, this.key, this.needsNote, this.importPath);
}

// The text of a message as it is read, with each quote's marker replaced by its module note. A
// type's module is written after the first quote that needs it, and after a later quote only
// when that quote is code to write or the message also writes that name for another type.
export render(string text) -> string {
    if (text.indexOf(NoteMarker.start) < 0) {
        return text;
    }
    let between = new List<string>();
    let quotes = new List<QuoteMention>();
    long at = 0;
    long searched = 0;
    while (true) {
        long start = text.indexOf(NoteMarker.start, searched);
        long end = start < 0 ? -1 : text.indexOf(NoteMarker.end, start);
        if (end < 0) {
            break;
        }
        searched = start + NoteMarker.start.length;
        let quote = parsedMention(text.substring(searched, end));
        if (quote != null) {
            between.push(text.substring(at, start));
            quotes.push(quote);
            at = end + NoteMarker.end.length;
            searched = at;
        }
    }
    between.push(text.substring(at));
    let shared = sharedNames(quotes);
    let placed = new Set<string>();
    let rendered = new StringBuilder();
    for (long i = 0; i < quotes.length(); i++) {
        rendered.append(between.get(i));
        rendered.append(placedNote(quotes.get(i), placed, shared));
    }
    rendered.append(between.get(quotes.length()));
    return rendered.toString();
}

// The names a quote writes, read back from its marker.
final class QuoteMention {
    string headKey;
    bool writesCode;
    MentionedName[] names;

    constructor(this.headKey, this.writesCode, this.names);
}

// The quote a marker's contents describe, or null when they are not a marker MentionMarker wrote.
parsedMention(string contents) -> QuoteMention? {
    if (contents.indexOf(NoteMarker.start) >= 0) {
        return null;
    }
    string[] records = contents.split(NoteMarker.record);
    string[] header = records[0].split(NoteMarker.field);
    if (header.length != 2) {
        return null;
    }
    let names = new List<MentionedName>();
    for (long i = 1; i < records.length; i++) {
        string[] fields = records[i].split(NoteMarker.field);
        if (fields.length != 4) {
            return null;
        }
        names.push(new MentionedName(fields[0], fields[1], fields[2] == "1", fields[3]));
    }
    if (names.isEmpty()) {
        return null;
    }
    return new QuoteMention(header[0], header[1] == "1", names.toArray());
}

// The names the quotes of one message write for more than one type.
sharedNames(List<QuoteMention> quotes) -> Set<string> {
    let keyByName = new Map<string, string>();
    let shared = new Set<string>();
    for (let quote in quotes) {
        for (let name in quote.names) {
            let known = keyByName.get(name.written);
            if (known == null) {
                keyByName.set(name.written, name.key);
            } else if (known != name.key) {
                shared.add(name.written);
            }
        }
    }
    return shared;
}

// The note after one quote: ' (from sizes.b)' for a quote of one type that writes no other declared
// type, and ' (Kind from sizes.b, Mode from sizes.d)' otherwise. Where the quote writes one name for
// two types, the note says which by position: ' (the second Kind from sizes.b)'. Empty when every
// type the quote writes is clear. 'placed' holds the keys of the types already noted.
placedNote(QuoteMention quote, Set<string> placed, Set<string> shared) -> string {
    let noted = new List<MentionedName>();
    for (let name in quote.names) {
        if (name.needsNote && !hasKey(noted, name.key)
                && (quote.writesCode || !placed.contains(name.key) || shared.contains(name.written))) {
            noted.push(name);
        }
    }
    if (noted.isEmpty()) {
        return "";
    }
    let entries = new StringBuilder();
    bool positioned = false;
    for (let entry in noted) {
        placed.add(entry.key);
        let ordinals = new List<string>();
        bool sharedInQuote = false;
        long seen = 0;
        for (let name in quote.names) {
            if (name.written == entry.written) {
                seen++;
                if (name.key == entry.key) {
                    ordinals.push(ordinalWord(seen));
                } else {
                    sharedInQuote = true;
                }
            }
        }
        if (!entries.isEmpty()) {
            entries.append(", ");
        }
        if (sharedInQuote) {
            positioned = true;
            entries.append("the {andJoined(ordinals.toArray())} ");
        }
        entries.append("{entry.written} from {entry.importPath}");
    }
    if (noted.length() == 1 && !positioned && quote.headKey == noted.first().key
            && writesOneDeclaredType(quote)) {
        return " (from {noted.first().importPath})";
    }
    return " ({entries.toString()})";
}

hasKey(List<MentionedName> names, string key) -> bool {
    for (let name in names) {
        if (name.key == key) {
            return true;
        }
    }
    return false;
}

// Whether every declared type the quote writes is the one it opens with.
writesOneDeclaredType(QuoteMention quote) -> bool {
    for (let name in quote.names) {
        if (name.key.length > 0 && name.key != quote.headKey) {
            return false;
        }
    }
    return true;
}

// A count as a word inside a sentence: "none", "one", "two" and so on up to ten.
public countWord(long count) -> string {
    string[] words = ["none", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
        "ten"];
    if (count >= 0 && count <= 10) {
        return words[count];
    }
    return "{count}";
}

// The word for a position counted from 1: "first" through "tenth", then "11th", "21st", "22nd".
public ordinalWord(long position) -> string {
    string[] words = ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth",
        "ninth", "tenth"];
    if (position >= 1 && position <= 10) {
        return words[position - 1];
    }
    long lastTwo = position % 100;
    if (lastTwo >= 11 && lastTwo <= 13) {
        return "{position}th";
    }
    string suffix = switch (position % 10) {
        1 -> "st",
        2 -> "nd",
        3 -> "rd",
        default -> "th",
    };
    return "{position}{suffix}";
}

// "'a'", "'a' and 'b'", or "'a', 'b' and 'c'", with 'or' as the conjunction when asked.
public andJoined(string[] items, string conjunction = "and") -> string {
    string text = "";
    for (long i = 0; i < items.length; i++) {
        if (i > 0 && i == items.length - 1) {
            text = "{text} {conjunction} ";
        } else if (i > 0) {
            text = "{text}, ";
        }
        text = "{text}{items[i]}";
    }
    return text;
}

// "a", "a, and b", or "a, b, and c": a comma before the last 'and' as well, so that a list of
// items that have their own 'and' still reads as one list.
public serialJoined(string[] items) -> string {
    string text = "";
    for (long i = 0; i < items.length; i++) {
        if (i > 0 && i == items.length - 1) {
            text = "{text}, and ";
        } else if (i > 0) {
            text = "{text}, ";
        }
        text = "{text}{items[i]}";
    }
    return text;
}

// Stable sort by (file, span start): equal positions keep their report order.
public sorted(List<FileDiagnostic> diagnostics) -> FileDiagnostic[] {
    FileDiagnostic[] items = diagnostics.toArray();
    for (long i = 1; i < items.length; i++) {
        let current = items[i];
        long j = i - 1;
        while (j >= 0 && isAfter(items[j], current)) {
            items[j + 1] = items[j];
            j--;
        }
        items[j + 1] = current;
    }
    return items;
}

isAfter(FileDiagnostic left, FileDiagnostic right) -> bool {
    int fileOrder = compareText(left.file(), right.file());
    if (fileOrder != 0) {
        return fileOrder > 0;
    }
    return left.span().start > right.span().start;
}

compareText(string left, string right) -> int {
    byte[] leftBytes = left.toBytes();
    byte[] rightBytes = right.toBytes();
    long limit = leftBytes.length;
    if (rightBytes.length < limit) {
        limit = rightBytes.length;
    }
    for (long i = 0; i < limit; i++) {
        if (leftBytes[i] != rightBytes[i]) {
            if (leftBytes[i] < rightBytes[i]) {
                return -1;
            }
            return 1;
        }
    }
    if (leftBytes.length < rightBytes.length) {
        return -1;
    }
    if (leftBytes.length > rightBytes.length) {
        return 1;
    }
    return 0;
}
