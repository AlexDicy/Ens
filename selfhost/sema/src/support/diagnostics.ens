// Sema diagnostics name the file they belong to alongside the message and span, since one sema
// pass spans many files. Results merge deterministically by (file, offset).
import Span from @ens.frontend.support.source;
import List from @std.collections.list;

// Another place a diagnostic points at, with the sentence that says what is there. A refusal
// reported where a generic's type arguments were written points this way at the line inside the
// generic that could not be judged without them.
export class RelatedLocation {
    string locationFile;
    Span locationSpan;
    string locationNote;

    export constructor(string file, Span span, string note) {
        this.locationFile = file;
        this.locationSpan = span;
        this.locationNote = note;
    }

    export file() -> string {
        return this.locationFile;
    }

    export span() -> Span {
        return this.locationSpan;
    }

    export note() -> string {
        return this.locationNote;
    }
}

export class FileDiagnostic {
    string diagnosticFile;
    string diagnosticMessage;
    Span diagnosticSpan;
    RelatedLocation[] diagnosticRelated;

    // A problem at one place in the file, with no notes.
    export constructor(string file, string message, Span span) {
        this.diagnosticFile = file;
        this.diagnosticMessage = message;
        this.diagnosticSpan = span;
        this.diagnosticRelated = [];
    }

    // A problem at one place in the file, with a note at one other place.
    export constructor(string file, string message, Span span, RelatedLocation related) {
        this.diagnosticFile = file;
        this.diagnosticMessage = message;
        this.diagnosticSpan = span;
        this.diagnosticRelated = [related];
    }

    // A problem at one place in the file, with a note at each other place, in reading order.
    export constructor(string file, string message, Span span, RelatedLocation[] related) {
        this.diagnosticFile = file;
        this.diagnosticMessage = message;
        this.diagnosticSpan = span;
        this.diagnosticRelated = related;
    }

    export file() -> string {
        return this.diagnosticFile;
    }

    export message() -> string {
        return this.diagnosticMessage;
    }

    export span() -> Span {
        return this.diagnosticSpan;
    }

    // The other places this diagnostic points at, in the order their notes are read, and empty
    // when it points at one place only.
    export related() -> RelatedLocation[] {
        return this.diagnosticRelated;
    }
}

// Collects diagnostics for one file into a shared per-phase list, so helpers report without
// threading the file path everywhere.
public class Reporter {
    string reporterFile;
    List<FileDiagnostic> sink;

    public constructor(string file, List<FileDiagnostic> sink) {
        this.reporterFile = file;
        this.sink = sink;
    }

    file() -> string {
        return this.reporterFile;
    }

    public report(string message, Span span) {
        this.sink.push(new FileDiagnostic(this.reporterFile, message, span));
    }

    // Reports a problem that points at a second place in the same file, with the sentence that
    // says what is there.
    public report(string message, Span span, Span relatedSpan, string note) {
        this.sink.push(new FileDiagnostic(this.reporterFile, message, span,
            new RelatedLocation(this.reporterFile, relatedSpan, note)));
    }
}

// "two", "three", and so on, for a count of at least two.
public countWord(long count) -> string {
    string[] words = ["two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
    if (count >= 2 && count <= 10) {
        return words[count - 2];
    }
    return "{count}";
}

// "'a'", "'a' and 'b'", or "'a', 'b' and 'c'", with 'or' as the conjunction when asked.
public andJoined(string[] items, string conjunction = "and") -> string {
    string text = "";
    for (long i = 0; i < items.length; i++) {
        if (i > 0 && i == items.length - 1) {
            text = "{text} {conjunction} ";
        } else if (i > 0) {
            text = "{text}, ";
        }
        text = "{text}{items[i]}";
    }
    return text;
}

// Stable sort by (file, span start): equal positions keep their report order.
public sorted(List<FileDiagnostic> diagnostics) -> FileDiagnostic[] {
    FileDiagnostic[] items = diagnostics.toArray();
    for (long i = 1; i < items.length; i++) {
        let current = items[i];
        long j = i - 1;
        while (j >= 0 && isAfter(items[j], current)) {
            items[j + 1] = items[j];
            j--;
        }
        items[j + 1] = current;
    }
    return items;
}

isAfter(FileDiagnostic left, FileDiagnostic right) -> bool {
    int fileOrder = compareText(left.file(), right.file());
    if (fileOrder != 0) {
        return fileOrder > 0;
    }
    return left.span().start > right.span().start;
}

compareText(string left, string right) -> int {
    byte[] leftBytes = left.toBytes();
    byte[] rightBytes = right.toBytes();
    long limit = leftBytes.length;
    if (rightBytes.length < limit) {
        limit = rightBytes.length;
    }
    for (long i = 0; i < limit; i++) {
        if (leftBytes[i] != rightBytes[i]) {
            if (leftBytes[i] < rightBytes[i]) {
                return -1;
            }
            return 1;
        }
    }
    if (leftBytes.length < rightBytes.length) {
        return -1;
    }
    if (leftBytes.length > rightBytes.length) {
        return 1;
    }
    return 0;
}
