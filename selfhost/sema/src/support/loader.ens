// All file access in the sema layer goes through the FileLoader interface, so tests can supply an
// in-memory tree and the batch driver can supply the real file system.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import EncodingError from @std.text;

export class FileError extends Error {
    export constructor(string message) {
        super(message);
    }
}

export interface FileLoader {
    exists(Path path) -> bool;
    readText(Path path) -> string throws FileError;
}

export class SystemFileLoader implements FileLoader {
    export constructor();

    export override exists(Path path) -> bool {
        return path.exists();
    }

    // The bytes are decoded here rather than by the read itself, so a file that is not UTF-8 is
    // named as that rather than as a file that could not be read.
    export override readText(Path path) -> string throws FileError {
        return try string.fromBytes(try path.readBytes());
    } catch (FileSystemError refused) {
        throw new FileError("Could not read '{path}': {refused.message}");
    } catch (EncodingError problem) {
        throw new FileError("'{path}' is not valid UTF-8 text: the byte at offset "
            + "{problem.offset} begins no character. Ens source is UTF-8, so save the file "
            + "that way.");
    }
}
