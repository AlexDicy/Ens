// All file access in the sema layer goes through the FileLoader interface, so tests can supply an
// in-memory tree and the batch driver can supply the real file system.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import EncodingError from @std.text;

// A file the loader could not read. `reason` is why, without the path, for a caller that names the
// file itself. An empty `reason` means the whole message is the reason.
export class FileError extends Error {
    export const string reason;

    export constructor(string message, string reason = "") {
        super(message);
        if (reason.length == 0) {
            this.reason = message;
        } else {
            this.reason = reason;
        }
    }
}

export interface FileLoader {
    exists(Path path) -> bool;
    readText(Path path) -> string throws FileError;

    // The text every path to one folder shares, as the file system tells folders apart, so two
    // paths name the same folder exactly when their keys are equal.
    folderKey(Path folder) -> string;
}

export class SystemFileLoader implements FileLoader {
    export constructor();

    export override exists(Path path) -> bool {
        return path.exists();
    }

    // The folder's real path, which names each part the way the file system stores it and resolves
    // links. Windows returns the case its directories store, and Darwin's realpath reads each
    // part's stored name through getattrlist, which matters on its case-insensitive volumes. A
    // folder that is not there, or whose real path cannot be read, is keyed by its normalized text.
    export override folderKey(Path folder) -> string {
        if (folder.isDirectory()) {
            return (try folder.realPath()).toString();
        }
        return folder.normalize().toString();
    } catch (FileSystemError unresolved) {
        return folder.normalize().toString();
    }

    // The bytes are decoded here rather than by the read itself, so a file that is not UTF-8 is
    // named as that rather than as a file that could not be read. Both messages open on 'This
    // file', because a failure is reported at the file itself.
    export override readText(Path path) -> string throws FileError {
        return try string.fromBytes(try path.readBytes());
    } catch (FileSystemError refused) {
        throw new FileError("This file could not be read: {refused.reason}.", refused.reason);
    } catch (EncodingError problem) {
        string reason = "it is not valid UTF-8, the way Ens stores text as bytes: the byte at "
            + "offset {problem.offset} does not start a character";
        throw new FileError("This file is not valid UTF-8, the way Ens stores text as bytes: the "
            + "byte at offset {problem.offset} does not start a character. Save the file as UTF-8 "
            + "in your editor.", reason);
    }
}
