// Literal value readers for expression checking: literal magnitudes, character codepoints, and
// the range tables untyped literals adapt against. Also the home of ConstantValue, which static
// const fields hold and code generation folds reads to.
import PrimitiveKind from model.types;
import StringBuilder from @std.text.stringbuilder;

export enum ConstantKind {
    Integer,
    Float,
    Bool,
    Char,
    String,
}

// One evaluated constant. An integer carries a sign and a 64-bit magnitude, the same shape the
// literal adaptation rules read, so the range checks share one home; a char carries its
// codepoint in the magnitude.
export class ConstantValue {
    ConstantKind valueKind;
    bool negativeMagnitude;
    ulong magnitudePayload;
    double floatPayload;
    bool boolPayload;
    string textPayload;

    public constructor(ConstantKind kind, bool negative, ulong magnitude, double floatValue,
                bool boolValue, string text) {
        this.valueKind = kind;
        this.negativeMagnitude = negative;
        this.magnitudePayload = magnitude;
        this.floatPayload = floatValue;
        this.boolPayload = boolValue;
        this.textPayload = text;
    }

    export kind() -> ConstantKind {
        return this.valueKind;
    }

    export isNegative() -> bool {
        return this.negativeMagnitude;
    }

    export magnitude() -> ulong {
        return this.magnitudePayload;
    }

    export floatValue() -> double {
        return this.floatPayload;
    }

    export boolValue() -> bool {
        return this.boolPayload;
    }

    export text() -> string {
        return this.textPayload;
    }

    // The integer or char value as the signed 64-bit pattern a machine constant holds.
    export integerBits() -> long {
        if (this.negativeMagnitude) {
            return 0 - (this.magnitudePayload as long);
        }
        return this.magnitudePayload as long;
    }
}

// A signed zero has no distinct value, so it normalizes away.
public integerConstant(bool negative, ulong magnitude) -> ConstantValue {
    return new ConstantValue(ConstantKind.Integer, negative && magnitude != 0, magnitude,
        0.0, false, "");
}

public floatConstant(bool negative, double magnitude) -> ConstantValue {
    double value = magnitude;
    if (negative) {
        value = 0.0 - magnitude;
    }
    return new ConstantValue(ConstantKind.Float, false, 0, value, false, "");
}

public boolConstant(bool value) -> ConstantValue {
    return new ConstantValue(ConstantKind.Bool, false, 0, 0.0, value, "");
}

public charConstant(ulong codepoint) -> ConstantValue {
    return new ConstantValue(ConstantKind.Char, false, codepoint, 0.0, false, "");
}

public stringConstant(string text) -> ConstantValue {
    return new ConstantValue(ConstantKind.String, false, 0, 0.0, false, text);
}

// The constant as it reads in a diagnostic.
public constantText(ConstantValue value) -> string {
    switch (value.kind()) {
        Integer -> {
            if (value.isNegative()) {
                return "-{value.magnitude()}";
            }
            return "{value.magnitude()}";
        },
        Float -> {
            return "{value.floatValue()}";
        },
        Bool -> {
            return "{value.boolValue()}";
        },
        Char -> {
            return "{value.magnitude()}";
        },
        String -> {
            return "\"{value.text()}\"";
        },
    }
}

// The magnitude of an integer literal token, or null when the text does not parse. Underscore
// separators and the 'l'/'L' suffix are ignored; '0x' and '0b' prefixes select the base.
public integerMagnitude(string text) -> ulong? {
    byte[] raw = text.toBytes();
    let digits = new byte[raw.length];
    long count = 0;
    for (long i = 0; i < raw.length; i++) {
        byte value = raw[i];
        if (value == '_' || value == 'l' || value == 'L') {
            continue;
        }
        digits[count] = value;
        count++;
    }
    long base = 10;
    long start = 0;
    if (count > 2 && digits[0] == '0' && (digits[1] == 'x' || digits[1] == 'X')) {
        base = 16;
        start = 2;
    } else if (count > 2 && digits[0] == '0' && (digits[1] == 'b' || digits[1] == 'B')) {
        base = 2;
        start = 2;
    }
    if (start == count) {
        return null;
    }
    ulong ceiling = 18446744073709551615;
    ulong scale = base as ulong;
    ulong value = 0;
    for (long i = start; i < count; i++) {
        long digit = digitValue(digits[i]);
        if (digit < 0 || digit >= base) {
            return null;
        }
        ulong step = digit as ulong;
        if (value > (ceiling - step) / scale) {
            return null;
        }
        value = value * scale + step;
    }
    return value;
}

digitValue(byte value) -> long {
    if (value >= '0' && value <= '9') {
        return value - '0';
    }
    if (value >= 'a' && value <= 'f') {
        return value - 'a' + 10;
    }
    if (value >= 'A' && value <= 'F') {
        return value - 'A' + 10;
    }
    return -1;
}

// The codepoint a character literal token names, quotes and escapes decoded. A malformed escape
// falls back to the escaped byte itself, matching the tokenizer.
public charCodepoint(string text) -> ulong {
    byte[] raw = text.toBytes();
    long start = 0;
    long end = raw.length;
    if (end >= 2 && raw[0] == '\'' && raw[end - 1] == '\'') {
        start = 1;
        end--;
    }
    if (start >= end) {
        return 0;
    }
    if (raw[start] == '\\' && start + 1 < end) {
        return escapeCodepoint(raw, start, end);
    }
    return decodeUtf8(raw, start, end);
}

escapeCodepoint(byte[] raw, long backslash, long end) -> ulong {
    byte next = raw[backslash + 1];
    switch (next) {
        'n' -> {
            return 10;
        },
        't' -> {
            return 9;
        },
        'r' -> {
            return 13;
        },
        'b' -> {
            return 8;
        },
        'f' -> {
            return 12;
        },
        '0' -> {
            return 0;
        },
        'u' -> {
            if (backslash + 6 <= end) {
                ulong value = 0;
                for (long i = 0; i < 4; i++) {
                    long digit = digitValue(raw[backslash + 2 + i]);
                    if (digit < 0 || digit >= 16) {
                        return next;
                    }
                    value = value * 16 + (digit as ulong);
                }
                return value;
            }
            return next;
        },
        default -> {
            return next;
        },
    }
}

// The decoded value of a string literal token, quotes stripped and escapes resolved, so two
// spellings of the same string compare equal. Escapes follow the char-literal set. Exported for
// tooling that reads literal values off the tree, such as the test-runner synthesis.
export decodeString(string text) -> string {
    byte[] raw = text.toBytes();
    long start = 0;
    long end = raw.length;
    if (end >= 2 && raw[0] == '"' && raw[end - 1] == '"') {
        start = 1;
        end--;
    }
    let builder = new StringBuilder();
    long i = start;
    long plainFrom = start;
    while (i < end) {
        if (raw[i] == '\\' && i + 1 < end) {
            // A backslash never sits inside a character, so the run before it is text of its own.
            builder.append(string.fromBytesLossy(raw.slice(plainFrom, i)));
            builder.append(escapeCodepoint(raw, i, end) as char);
            i = i + escapeLength(raw, i, end);
            plainFrom = i;
        } else {
            i++;
        }
    }
    builder.append(string.fromBytesLossy(raw.slice(plainFrom, end)));
    return builder.toString();
}

// The byte length a backslash escape consumes, matching escapeCodepoint: a well-formed '\uXXXX'
// spans six bytes, every other escape (including a malformed '\u') spans two.
escapeLength(byte[] raw, long backslash, long end) -> long {
    if (raw[backslash + 1] == 'u' && backslash + 6 <= end) {
        for (long k = 0; k < 4; k++) {
            long digit = digitValue(raw[backslash + 2 + k]);
            if (digit < 0 || digit >= 16) {
                return 2;
            }
        }
        return 6;
    }
    return 2;
}

decodeUtf8(byte[] raw, long start, long end) -> ulong {
    ulong first = raw[start];
    if (first < 0x80) {
        return first;
    }
    if (first >= 0xC0 && first < 0xE0 && start + 1 < end) {
        ulong second = raw[start + 1];
        return (first - 0xC0) * 64 + (second - 0x80);
    }
    if (first >= 0xE0 && first < 0xF0 && start + 2 < end) {
        ulong second = raw[start + 1];
        ulong third = raw[start + 2];
        return (first - 0xE0) * 4096 + (second - 0x80) * 64 + (third - 0x80);
    }
    if (first >= 0xF0 && start + 3 < end) {
        ulong second = raw[start + 1];
        ulong third = raw[start + 2];
        ulong fourth = raw[start + 3];
        return (first - 0xF0) * 262144 + (second - 0x80) * 4096 + (third - 0x80) * 64
            + (fourth - 0x80);
    }
    return first;
}

// True when a literal of the given sign and magnitude is a value of the integer kind.
public magnitudeFits(bool negative, ulong magnitude, PrimitiveKind kind) -> bool {
    return switch (kind) {
        Byte -> !negative && magnitude <= 255,
        Short -> fitsSigned(negative, magnitude, 32767),
        Int -> fitsSigned(negative, magnitude, 2147483647),
        Long -> fitsSigned(negative, magnitude, 9223372036854775807),
        UShort -> !negative && magnitude <= 65535,
        UInt -> !negative && magnitude <= 4294967295,
        ULong -> !negative,
        Char -> !negative && magnitude <= 1114111,
        default -> false,
    };
}

fitsSigned(bool negative, ulong magnitude, ulong positiveLimit) -> bool {
    if (negative) {
        return magnitude <= positiveLimit + 1;
    }
    return magnitude <= positiveLimit;
}

// The magnitude of a floating-point literal token, with underscore separators and a trailing
// 'f'/'F'/'d'/'D' type suffix ignored. The sign is never part of the text, since the parser places
// it as a prefix over the literal. Digits that fit a 64-bit integer and a scale within the
// exactly-representable powers of ten convert without rounding drift, while wider values scale
// stepwise and a magnitude beyond what a double holds scales up to infinity, which is how the
// fitting check recognizes it. Both that check and code generation read through here, so a literal
// the checker accepts can never emit as a value it would have refused.
export floatMagnitude(string text) -> double {
    byte[] raw = text.toBytes();
    ulong mantissa = 0;
    long digitCount = 0;
    long fractionDigits = 0;
    bool inFraction = false;
    long exponent = 0;
    bool exponentNegative = false;
    bool inExponent = false;
    for (long i = 0; i < raw.length; i++) {
        byte value = raw[i];
        if (value == '_' || value == 'f' || value == 'F' || value == 'd' || value == 'D'
                || value == '+') {
            continue;
        }
        if (value == '.') {
            inFraction = true;
            continue;
        }
        if (value == 'e' || value == 'E') {
            inExponent = true;
            continue;
        }
        if (value == '-') {
            exponentNegative = true;
            continue;
        }
        if (value < '0' || value > '9') {
            continue;
        }
        long digit = value - '0';
        if (inExponent) {
            if (exponent < 100000) {
                exponent = exponent * 10 + digit;
            }
            continue;
        }
        if (digitCount < 19) {
            mantissa = mantissa * 10 + (digit as ulong);
            digitCount++;
            if (inFraction) {
                fractionDigits++;
            }
        } else if (!inFraction) {
            fractionDigits--;
        }
    }
    if (exponentNegative) {
        exponent = 0 - exponent;
    }
    return scaleByPowersOfTen(mantissa as double, exponent - fractionDigits);
}

scaleByPowersOfTen(double value, long scale) -> double {
    double scaled = value;
    long remaining = scale;
    while (remaining > 0) {
        long step = remaining;
        if (step > 22) {
            step = 22;
        }
        scaled = scaled * powerOfTen(step);
        remaining = remaining - step;
    }
    while (remaining < 0) {
        long step = 0 - remaining;
        if (step > 22) {
            step = 22;
        }
        scaled = scaled / powerOfTen(step);
        remaining = remaining + step;
    }
    return scaled;
}

// Powers of ten up to 10^22 are exactly representable in a double.
powerOfTen(long power) -> double {
    double result = 1.0;
    for (long i = 0; i < power; i++) {
        result = result * 10.0;
    }
    return result;
}

// True when a floating-point literal's magnitude is one the kind holds. Rounding to the nearest
// value the kind has is part of the conversion, so a magnitude like 0.1 fits even though no
// binary floating-point type represents it exactly; only one that would become infinity does not.
public floatMagnitudeFits(double magnitude, PrimitiveKind kind) -> bool {
    if (isInfinite(magnitude)) {
        return false;
    }
    if (kind == PrimitiveKind.Float) {
        // The largest value a 32-bit float holds.
        return magnitude <= 3.4028234663852886e38;
    }
    return kind == PrimitiveKind.Double;
}

// Halving leaves only zero and infinity unchanged, and a magnitude is never negative.
isInfinite(double value) -> bool {
    return value > 0.0 && value * 0.5 == value;
}

// The largest value the kind holds, as it reads in a diagnostic.
public floatLimit(PrimitiveKind kind) -> string {
    return switch (kind) {
        Float -> "about 3.4e38",
        Double -> "about 1.8e308",
        default -> "",
    };
}

// The kind's value range as it reads in a diagnostic.
public integerRange(PrimitiveKind kind) -> string {
    return switch (kind) {
        Byte -> "0..255",
        Short -> "-32768..32767",
        Int -> "-2147483648..2147483647",
        Long -> "-9223372036854775808..9223372036854775807",
        UShort -> "0..65535",
        UInt -> "0..4294967295",
        ULong -> "0..18446744073709551615",
        Char -> "0..1114111",
        default -> "",
    };
}
