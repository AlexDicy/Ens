// Conservative exit analysis over statement syntax: whether every path through a statement
// leaves the surrounding scope. Terminators are 'return', 'throw', 'rethrow', and a call to a
// function or method declared 'noreturn' (the builtin 'panic' among them); a loop is never
// proven infinite except 'while (true)' with no 'break' bound to it. In Branch mode 'break' and
// 'continue' also count as exits, so the same predicate serves both the missing-return check
// (Function mode) and branch-survival reasoning.
import BlockNode from @ens.frontend.syntax.generated.nodes;
import Statement from @ens.frontend.syntax.generated.nodes;
import Expression from @ens.frontend.syntax.generated.nodes;
import IfStatementNode from @ens.frontend.syntax.generated.nodes;
import WhileStatementNode from @ens.frontend.syntax.generated.nodes;
import BreakStatementNode from @ens.frontend.syntax.generated.nodes;
import ContinueStatementNode from @ens.frontend.syntax.generated.nodes;
import ReturnStatementNode from @ens.frontend.syntax.generated.nodes;
import ThrowStatementNode from @ens.frontend.syntax.generated.nodes;
import RethrowStatementNode from @ens.frontend.syntax.generated.nodes;
import ExpressionStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchStatementNode from @ens.frontend.syntax.generated.nodes;
import SwitchArm from @ens.frontend.syntax.generated.nodes;
import ValueArmNode from @ens.frontend.syntax.generated.nodes;
import TypeArmNode from @ens.frontend.syntax.generated.nodes;
import DefaultArmNode from @ens.frontend.syntax.generated.nodes;
import ErrorSwitchArmNode from @ens.frontend.syntax.generated.nodes;
import ArmBody from @ens.frontend.syntax.generated.nodes;
import LiteralExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxKind from @ens.frontend.syntax.generated.kind;

// What an exiting statement must leave: the whole function (return-path analysis), or just the
// enclosing branch, where 'break' and 'continue' also exit.
public enum ExitScope {
    Function,
    Branch,
}

// Recognizes calls that never return: a call to a 'noreturn' function or method. The body
// checker implements this against its own resolution tables, so the predicate stays free of
// scope and symbol-table state.
public interface NoreturnCalls {
    callNeverReturns(Expression expression) -> bool;
}

public blockTerminates(BlockNode block, ExitScope scope, NoreturnCalls calls) -> bool {
    for (long i = 0; i < block.statementsCount(); i++) {
        if (statementTerminates(block.statements(i), scope, calls)) {
            return true;
        }
    }
    return false;
}

public statementTerminates(Statement statement, ExitScope scope, NoreturnCalls calls) -> bool {
    switch (statement) {
        is ReturnStatementNode ignored -> {
            return true;
        },
        is ThrowStatementNode ignored -> {
            return true;
        },
        is RethrowStatementNode ignored -> {
            return true;
        },
        is BreakStatementNode ignored -> {
            return scope == ExitScope.Branch;
        },
        is ContinueStatementNode ignored -> {
            return scope == ExitScope.Branch;
        },
        is BlockNode block -> {
            return blockTerminates(block, scope, calls);
        },
        is IfStatementNode conditional -> {
            return ifTerminates(conditional, scope, calls);
        },
        is SwitchStatementNode switched -> {
            return switchTerminates(switched, scope, calls);
        },
        // A nested loop keeps function semantics: a break or continue inside it binds to that
        // loop, not to the branch, so only a proven-infinite loop exits here.
        is WhileStatementNode loop -> {
            return whileTerminates(loop);
        },
        is ExpressionStatementNode expression -> {
            return calls.callNeverReturns(expression.expression());
        },
        default -> {
            return false;
        },
    }
}

// An 'if' exits only when both branches exist and every one of them exits.
public ifTerminates(IfStatementNode conditional, ExitScope scope, NoreturnCalls calls) -> bool {
    let elseClause = conditional.elseClause();
    if (elseClause == null || !blockTerminates(conditional.thenBranch(), scope, calls)) {
        return false;
    }
    switch (elseClause.body()) {
        is IfStatementNode chained -> {
            return ifTerminates(chained, scope, calls);
        },
        is BlockNode block -> {
            return blockTerminates(block, scope, calls);
        },
        default -> {
            return false;
        },
    }
}

// Exhaustiveness is checked separately, so a switch exits when every arm's body is a block
// that exits. Expression arms cannot contain an exiting statement.
switchTerminates(SwitchStatementNode switched, ExitScope scope, NoreturnCalls calls)
        -> bool {
    if (switched.armsCount() == 0) {
        return false;
    }
    for (long i = 0; i < switched.armsCount(); i++) {
        let body = armBodyOf(switched.arms(i));
        if (!(body is BlockNode)) {
            return false;
        }
        if (!blockTerminates(body, scope, calls)) {
            return false;
        }
    }
    return true;
}

whileTerminates(WhileStatementNode loop) -> bool {
    let condition = unwrapParentheses(loop.condition());
    if (!(condition is LiteralExpressionNode)) {
        return false;
    }
    if (condition.value().kind() != SyntaxKind.TrueKeyword) {
        return false;
    }
    return !blockContainsLoopBreak(loop.body());
}

unwrapParentheses(Expression expression) -> Expression {
    Expression current = expression;
    while (current is ParenthesizedExpressionNode) {
        current = current.inner();
    }
    return current;
}

// Null for an arm the parser could not read, which has no body; both callers treat anything but a
// block as a path they cannot reason about, which is the right answer for one.
armBodyOf(SwitchArm arm) -> ArmBody? {
    switch (arm) {
        is ValueArmNode valued -> {
            return valued.body();
        },
        is TypeArmNode typed -> {
            return typed.body();
        },
        is DefaultArmNode defaulted -> {
            return defaulted.body();
        },
        is ErrorSwitchArmNode ignored -> {
            return null;
        },
    }
}

blockContainsLoopBreak(BlockNode block) -> bool {
    for (long i = 0; i < block.statementsCount(); i++) {
        if (statementContainsLoopBreak(block.statements(i))) {
            return true;
        }
    }
    return false;
}

// True when the statement contains a 'break' that binds to the enclosing loop. Nested loops
// are not entered: a break inside them binds to that inner loop.
statementContainsLoopBreak(Statement statement) -> bool {
    switch (statement) {
        is BreakStatementNode ignored -> {
            return true;
        },
        is BlockNode block -> {
            return blockContainsLoopBreak(block);
        },
        is IfStatementNode conditional -> {
            if (blockContainsLoopBreak(conditional.thenBranch())) {
                return true;
            }
            let elseClause = conditional.elseClause();
            if (elseClause == null) {
                return false;
            }
            switch (elseClause.body()) {
                is IfStatementNode chained -> {
                    return statementContainsLoopBreak(chained);
                },
                is BlockNode block -> {
                    return blockContainsLoopBreak(block);
                },
                default -> {
                    return false;
                },
            }
        },
        is SwitchStatementNode switched -> {
            for (long i = 0; i < switched.armsCount(); i++) {
                let body = armBodyOf(switched.arms(i));
                if (body is BlockNode && blockContainsLoopBreak(body)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}
