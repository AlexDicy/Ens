// The sema type model. Every type object is created and interned by the TypeStore, so equal types
// are the same object and type equality is reference identity everywhere. Declared types carry
// the metadata published at name registration; members and bases are filled by later phases.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import ConstantValue from model.literalvalues;
import FileDiagnostic from support.diagnostics;
import Iterable from @std.collections.iterator;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

export enum PrimitiveKind {
    Bool,
    Byte,
    Short,
    UShort,
    Int,
    UInt,
    Long,
    ULong,
    Float,
    Double,
    Decimal,
    Char,
    Void,
}

export enum Visibility {
    Public,
    Protected,
    Private,
    Export,
}

// The ladder position used by the boundary and leakage checks. Protected shares the private
// floor: its guaranteed reach is the declaring file.
public visibilityTier(Visibility visibility) -> long {
    return switch (visibility) {
        Private, Protected -> 0,
        Public -> 1,
        Export -> 2,
    };
}

public visibilityWord(Visibility visibility) -> string {
    return switch (visibility) {
        Private -> "private",
        Protected -> "protected",
        Public -> "public",
        Export -> "export",
    };
}

// The visibility of a member that follows its containing type: such a member is accessible
// wherever the type is nameable. A private type is nameable throughout its file, which for
// members is exactly the protected floor.
public followedMemberVisibility(Visibility container) -> Visibility {
    if (container == Visibility.Private) {
        return Visibility.Protected;
    }
    return container;
}

// True when a top-level declaration with the given visibility is nameable from the use site:
// the same module sees everything, 'export' crosses packages, and 'public' reaches the rest of
// its own package.
public isVisibleFrom(Visibility visibility, string declModulePath, string declPackagePrefix,
                     string useModulePath, string usePackagePrefix) -> bool {
    if (declModulePath == useModulePath) {
        return true;
    }
    if (visibility == Visibility.Export) {
        return true;
    }
    if (visibility == Visibility.Public) {
        return declPackagePrefix == usePackagePrefix;
    }
    return false;
}

// Whether a member with the given visibility, declared by 'defining', is accessible from a
// site enclosed by 'siteOwner' (null outside any type) in the module at 'modulePath' within
// 'packagePrefix'. The one home for the member-access decision; reporting stays with callers.
public memberAccessAllowed(Visibility visibility, DeclaredType defining, DeclaredType? siteOwner,
                           string modulePath, string packagePrefix) -> bool {
    switch (visibility) {
        Export -> {
            return true;
        },
        Public -> {
            return defining.packagePrefix() == packagePrefix;
        },
        Private -> {
            return siteOwner != null && siteOwner == defining;
        },
        Protected -> {
            if (siteOwner != null && isSubclassOf(siteOwner, defining)) {
                return true;
            }
            return defining.modulePath() == modulePath;
        },
    }
}

// "<kindWord> '<name>' is private to module 'M'; ..." with the modifier that fixes it.
public notVisibleMessage(string kindWord, string name, Visibility visibility,
                         string declModulePath, string declPackagePrefix,
                         string usePackagePrefix) -> string {
    bool samePackage = declPackagePrefix == usePackagePrefix;
    if (visibility == Visibility.Public && !samePackage) {
        string packageName = "its package";
        if (declPackagePrefix.length > 0) {
            packageName = "package '{declPackagePrefix}'";
        }
        return "{kindWord} '{name}' is public inside {packageName} but not exported. Mark it "
            + "'export' in module '{declModulePath}' to use it from another package.";
    }
    string fix = "Mark it 'export' to use it from another package.";
    if (samePackage) {
        fix = "Mark it 'public' to use it from other modules in the package.";
    }
    return "{kindWord} '{name}' is private to module '{declModulePath}'; it can only be used "
        + "inside that file. " + fix;
}

// The declaration keyword a diagnostic should use when it names a declared type's owner.
public kindWordOf(DeclaredType declared) -> string {
    return declared.kindWord();
}

export sealed abstract class Type {
}

export class PrimitiveType extends Type {
    PrimitiveKind primitiveKind;
    PrimitiveBinding? primitiveBinding;

    protected constructor(PrimitiveKind kind) {
        this.primitiveKind = kind;
    }

    export kind() -> PrimitiveKind {
        return this.primitiveKind;
    }

    // The standard library declaration of this primitive's members, or null when nothing
    // declares them.
    export binding() -> PrimitiveBinding? {
        return this.primitiveBinding;
    }

    public setBinding(PrimitiveBinding binding) {
        this.primitiveBinding = binding;
    }
}

export class StringType extends Type {
    PrimitiveBinding? primitiveBinding;

    protected constructor();

    export binding() -> PrimitiveBinding? {
        return this.primitiveBinding;
    }

    public setBinding(PrimitiveBinding binding) {
        this.primitiveBinding = binding;
    }
}

export class NullType extends Type {
    protected constructor();
}

// Cascade suppression sentinel: the type of anything that already produced a diagnostic.
export class ErrorType extends Type {
    protected constructor();
}

export class OptionalType extends Type {
    Type innerType;

    protected constructor(Type inner) {
        this.innerType = inner;
    }

    export inner() -> Type {
        return this.innerType;
    }
}

export class ArrayType extends Type {
    Type elementType;

    protected constructor(Type element) {
        this.elementType = element;
    }

    export element() -> Type {
        return this.elementType;
    }
}

// The type of a function value: '(int, int) -> int', '() -> string'. Interned by its parameter
// types and its return type, so two spellings of the same shape are the same object and
// assignability between function types is identity. A function type never throws.
export class FunctionType extends Type {
    Type[] functionParameterTypes;
    Type functionReturnType;
    Type[] functionThrownTypes;

    protected constructor(Type[] parameterTypes, Type returnType, Type[] thrownTypes) {
        this.functionParameterTypes = parameterTypes;
        this.functionReturnType = returnType;
        this.functionThrownTypes = thrownTypes;
    }

    export parameterTypes() -> Type[] {
        return this.functionParameterTypes;
    }

    export returnType() -> Type {
        return this.functionReturnType;
    }

    // What a call through this type may raise. There is no body to infer a list from, so an
    // absent list means nothing is raised.
    export thrownTypes() -> Type[] {
        return this.functionThrownTypes;
    }

    export declaresThrows() -> bool {
        return this.functionThrownTypes.length > 0;
    }
}

export class Parameter {
    string parameterName;
    Type parameterType;
    bool fieldShorthand;
    bool outParameter;
    bool defaulted;
    Span parameterSpan;

    public constructor(string name, Type type, bool bindsField, bool isOut, bool hasDefault, Span span) {
        this.parameterName = name;
        this.parameterType = type;
        this.fieldShorthand = bindsField;
        this.outParameter = isOut;
        this.defaulted = hasDefault;
        this.parameterSpan = span;
    }

    export name() -> string {
        return this.parameterName;
    }

    export type() -> Type {
        return this.parameterType;
    }

    // True for the 'this.field' constructor shorthand.
    export bindsField() -> bool {
        return this.fieldShorthand;
    }

    export isOut() -> bool {
        return this.outParameter;
    }

    export hasDefault() -> bool {
        return this.defaulted;
    }

    export span() -> Span {
        return this.parameterSpan;
    }
}

// A resolved callable signature. Declared throws types are resolved here; whether they are valid
// exception types is checked by a later pass, so the reference spans are kept alongside.
export class Signature {
    string signatureName;
    Parameter[] signatureParameters;
    Type signatureReturnType;
    bool marksThrows;
    bool marksNoreturn;
    Type[] resolvedThrowsTypes;
    Span[] resolvedThrowsSpans;
    TypeParamType[] signatureTypeParameters;
    GreenNode? declarationNode;
    Span signatureNameSpan;

    public constructor(string name, Parameter[] parameters, Type returnType, bool declaresThrows,
                bool declaresNoreturn, Type[] throwsTypes, Span[] throwsSpans,
                TypeParamType[] typeParameters, GreenNode? declaration, Span nameSpan) {
        this.signatureName = name;
        this.signatureParameters = parameters;
        this.signatureReturnType = returnType;
        this.marksThrows = declaresThrows;
        this.marksNoreturn = declaresNoreturn;
        this.resolvedThrowsTypes = throwsTypes;
        this.resolvedThrowsSpans = throwsSpans;
        this.signatureTypeParameters = typeParameters;
        this.declarationNode = declaration;
        this.signatureNameSpan = nameSpan;
    }

    export name() -> string {
        return this.signatureName;
    }

    export parameters() -> Parameter[] {
        return this.signatureParameters;
    }

    export returnType() -> Type {
        return this.signatureReturnType;
    }

    export declaresThrows() -> bool {
        return this.marksThrows;
    }

    // True when the callable is declared 'noreturn': it never completes normally, so a call to
    // it in statement position ends the path exactly as 'panic' does.
    export isNoreturn() -> bool {
        return this.marksNoreturn;
    }

    export throwsTypes() -> Type[] {
        return this.resolvedThrowsTypes;
    }

    export throwsTypeSpans() -> Span[] {
        return this.resolvedThrowsSpans;
    }

    export typeParameters() -> TypeParamType[] {
        return this.signatureTypeParameters;
    }

    export isGeneric() -> bool {
        return this.signatureTypeParameters.length > 0;
    }

    export declaration() -> GreenNode? {
        return this.declarationNode;
    }

    export nameSpan() -> Span {
        return this.signatureNameSpan;
    }
}

// The signature of a function nothing declares, which code generation synthesizes and calls
// itself. It takes no parameters and never throws, and only a trace and a diagnostic read its
// name.
export synthesizedSignature(string name, Type returnType, Span nameSpan) -> Signature {
    return new Signature(name, [], returnType, false, false, [], [], [], null, nameSpan);
}

// True when the two signatures take exactly the same parameter types. Types are interned, so
// type equality is reference identity.
public sameParameterTypes(Signature first, Signature second) -> bool {
    Parameter[] left = first.parameters();
    Parameter[] right = second.parameters();
    if (left.length != right.length) {
        return false;
    }
    for (long i = 0; i < left.length; i++) {
        if (left[i].type() != right[i].type()) {
            return false;
        }
    }
    return true;
}

// One field of a struct or class. Flattened class layouts share the base class's Field objects, so
// definingType still names the class, or generic instantiation, that declared the field. A static
// const field takes no layout slot, and its value is the evaluated constant the constants phase
// fills in. Instantiations of a generic type share the template's Field object, because neither
// its type nor its initializer may mention a type parameter. A lazy const field builds its value
// on the first read instead.
export class Field {
    string fieldName;
    Type fieldType;
    Visibility fieldVisibility;
    bool weakField;
    bool constField;
    bool staticMarked;
    bool lazyMarked;
    bool defaulted;
    Span fieldNameSpan;
    Type definingDeclaration;
    ConstantValue? evaluatedConstant;

    public constructor(string name, Type type, Visibility visibility, bool isWeak, bool isConst,
                bool isStatic, bool isLazy, bool hasDefault, Span nameSpan, Type definingType) {
        this.fieldName = name;
        this.fieldType = type;
        this.fieldVisibility = visibility;
        this.weakField = isWeak;
        this.constField = isConst;
        this.staticMarked = isStatic;
        this.lazyMarked = isLazy;
        this.defaulted = hasDefault;
        this.fieldNameSpan = nameSpan;
        this.definingDeclaration = definingType;
    }

    export name() -> string {
        return this.fieldName;
    }

    export type() -> Type {
        return this.fieldType;
    }

    export visibility() -> Visibility {
        return this.fieldVisibility;
    }

    export isWeak() -> bool {
        return this.weakField;
    }

    export isConst() -> bool {
        return this.constField;
    }

    export isStatic() -> bool {
        return this.staticMarked;
    }

    export isLazy() -> bool {
        return this.lazyMarked;
    }

    export hasDefault() -> bool {
        return this.defaulted;
    }

    export nameSpan() -> Span {
        return this.fieldNameSpan;
    }

    export definingType() -> Type {
        return this.definingDeclaration;
    }

    // The evaluated value of a static const field, or null until the constants phase fills it
    // (or when the initializer failed to evaluate).
    export constantValue() -> ConstantValue? {
        return this.evaluatedConstant;
    }

    public setConstantValue(ConstantValue value) {
        this.evaluatedConstant = value;
    }
}

// One constraint a conditional member places on an enclosing type parameter: which parameter it
// restates, by index, and the extra bounds the member requires of it. The bounds stay written in
// the template's own terms; judging them for an instantiation substitutes its arguments in.
export class MemberConstraint {
    long constrainedIndex;
    Type[] requiredBounds;

    public constructor(this.constrainedIndex, this.requiredBounds);

    export parameterIndex() -> long {
        return this.constrainedIndex;
    }

    export bounds() -> Type[] {
        return this.requiredBounds;
    }
}

// One method of a struct, class, or interface. Constructors are stored under the name
// 'constructor' and destructors under 'destructor', so overload checks treat them uniformly. A
// static method takes no receiver, never dispatches, and is stored in the owner's staticMethods
// list. A conditional member exists only on instantiations that satisfy its constraints, and every
// list keeps it in place parallel to the template's, so consumers ask memberExistsOn first.
export class Method {
    Signature methodSignature;
    Visibility methodVisibility;
    bool constructorMethod;
    bool destructorMethod;
    bool overrideMarked;
    bool finalMarked;
    bool abstractMarked;
    bool staticMarked;
    bool bodied;
    MemberConstraint[] methodConstraints;
    Type definingDeclaration;

    public constructor(Signature signature, Visibility visibility, bool isConstructor, bool isDestructor,
                bool isOverride, bool isFinal, bool isAbstract, bool isStatic, bool hasBody,
                MemberConstraint[] constraints, Type definingType) {
        this.methodSignature = signature;
        this.methodVisibility = visibility;
        this.constructorMethod = isConstructor;
        this.destructorMethod = isDestructor;
        this.overrideMarked = isOverride;
        this.finalMarked = isFinal;
        this.abstractMarked = isAbstract;
        this.staticMarked = isStatic;
        this.bodied = hasBody;
        this.methodConstraints = constraints;
        this.definingDeclaration = definingType;
    }

    export name() -> string {
        return this.methodSignature.name();
    }

    export signature() -> Signature {
        return this.methodSignature;
    }

    export visibility() -> Visibility {
        return this.methodVisibility;
    }

    export isConstructor() -> bool {
        return this.constructorMethod;
    }

    export isDestructor() -> bool {
        return this.destructorMethod;
    }

    export isOverride() -> bool {
        return this.overrideMarked;
    }

    export isFinal() -> bool {
        return this.finalMarked;
    }

    export isAbstract() -> bool {
        return this.abstractMarked;
    }

    export isStatic() -> bool {
        return this.staticMarked;
    }

    export isNoreturn() -> bool {
        return this.methodSignature.isNoreturn();
    }

    protected hasBody() -> bool {
        return this.bodied;
    }

    export constraints() -> MemberConstraint[] {
        return this.methodConstraints;
    }

    export isConditional() -> bool {
        return this.methodConstraints.length > 0;
    }

    export definingType() -> Type {
        return this.definingDeclaration;
    }
}

// A type introduced by a declaration. The declaration green node is the stable identity of the
// declaration site; red views are rebuilt over it on demand.
export sealed abstract class DeclaredType extends Type {
    string declaredName;
    string declaredModulePath;
    string declaredPackagePrefix;
    string declaredFilePath;
    GreenNode declarationNode;
    Visibility declaredVisibility;
    string[] declaredTypeParameters;
    TypeParamType[]? resolvedTypeParameters;
    bool declaredMembersComplete;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        this.declaredName = name;
        this.declaredModulePath = modulePath;
        this.declaredPackagePrefix = packagePrefix;
        this.declaredFilePath = filePath;
        this.declarationNode = declaration;
        this.declaredVisibility = visibility;
        this.declaredTypeParameters = typeParameters;
        this.declaredMembersComplete = false;
    }

    export name() -> string {
        return this.declaredName;
    }

    export modulePath() -> string {
        return this.declaredModulePath;
    }

    export packagePrefix() -> string {
        return this.declaredPackagePrefix;
    }

    export filePath() -> string {
        return this.declaredFilePath;
    }

    export declaration() -> GreenNode {
        return this.declarationNode;
    }

    export visibility() -> Visibility {
        return this.declaredVisibility;
    }

    export typeParameters() -> string[] {
        return this.declaredTypeParameters;
    }

    export isGeneric() -> bool {
        return this.declaredTypeParameters.length > 0;
    }

    // The interned type parameters with their bounds, once the parameter list resolves.
    export typeParameterTypes() -> TypeParamType[] {
        let resolved = this.resolvedTypeParameters;
        if (resolved == null) {
            return [];
        }
        return resolved;
    }

    hasResolvedTypeParameters() -> bool {
        return this.resolvedTypeParameters != null;
    }

    public setTypeParameterTypes(TypeParamType[] parameters) {
        this.resolvedTypeParameters = parameters;
    }

    // True once every member's signature is resolved, so instantiations can fill from it.
    protected membersComplete() -> bool {
        return this.declaredMembersComplete;
    }

    public setMembersComplete() {
        this.declaredMembersComplete = true;
    }

    // The declaration's kind as it reads in a diagnostic: "class", "enum", ...
    public abstract kindWord() -> string;
}

export class ClassType extends DeclaredType {
    bool classIsAbstract;
    bool classIsFinal;
    bool classIsSealed;
    Type? classBase;
    Type[] classInterfaces;
    List<Field> classFields;
    long inheritedFieldCount;
    List<Method> classMethods;
    List<Field> classStaticFields;
    List<Method> classStaticMethods;
    List<ClassType> classDirectSubclasses;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters,
                bool isAbstract, bool isFinal, bool isSealed) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.classIsAbstract = isAbstract;
        this.classIsFinal = isFinal;
        this.classIsSealed = isSealed;
        this.classInterfaces = [];
        this.classFields = new List<Field>();
        this.inheritedFieldCount = 0;
        this.classMethods = new List<Method>();
        this.classStaticFields = new List<Field>();
        this.classStaticMethods = new List<Method>();
        this.classDirectSubclasses = new List<ClassType>();
    }

    export isAbstract() -> bool {
        return this.classIsAbstract;
    }

    export isFinal() -> bool {
        return this.classIsFinal;
    }

    export isSealed() -> bool {
        return this.classIsSealed;
    }

    // The resolved base: a ClassType, or an InstantiationType of a generic class.
    export base() -> Type? {
        return this.classBase;
    }

    public setBase(Type base) {
        this.classBase = base;
    }

    public clearBase() {
        this.classBase = null;
    }

    // The interfaces named in this class's own 'implements' clause.
    export interfaces() -> Type[] {
        return this.classInterfaces;
    }

    public setInterfaces(Type[] interfaces) {
        this.classInterfaces = interfaces;
    }

    // Flattened layout: inherited fields first, own fields after.
    export fields() -> List<Field> {
        return this.classFields;
    }

    public baseFieldCount() -> long {
        return this.inheritedFieldCount;
    }

    public setBaseFieldCount(long count) {
        this.inheritedFieldCount = count;
    }

    // Own methods only; inherited methods are reached through base().
    export methods() -> List<Method> {
        return this.classMethods;
    }

    // Static const fields, outside every instance layout.
    export staticFields() -> List<Field> {
        return this.classStaticFields;
    }

    // Static methods, reachable only through this class's name.
    export staticMethods() -> List<Method> {
        return this.classStaticMethods;
    }

    export directSubclasses() -> List<ClassType> {
        return this.classDirectSubclasses;
    }

    public removeDirectSubclass(ClassType subclass) {
        let kept = new List<ClassType>();
        for (long i = 0; i < this.classDirectSubclasses.length(); i++) {
            if (this.classDirectSubclasses.get(i) != subclass) {
                kept.push(this.classDirectSubclasses.get(i));
            }
        }
        this.classDirectSubclasses = kept;
    }

    public override kindWord() -> string {
        return "class";
    }
}

export class InterfaceType extends DeclaredType {
    Type? interfaceBase;
    List<Method> interfaceMethods;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.interfaceBase = null;
        this.interfaceMethods = new List<Method>();
    }

    // The resolved 'extends' target: an InterfaceType, or an InstantiationType of a generic
    // interface. Own methods only; inherited requirements are reached through it.
    export base() -> Type? {
        return this.interfaceBase;
    }

    public setBase(Type base) {
        this.interfaceBase = base;
    }

    public clearBase() {
        this.interfaceBase = null;
    }

    export methods() -> List<Method> {
        return this.interfaceMethods;
    }

    public override kindWord() -> string {
        return "interface";
    }
}

export class StructType extends DeclaredType {
    List<Field> structFields;
    List<Method> structMethods;
    List<Field> structStaticFields;
    List<Method> structStaticMethods;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.structFields = new List<Field>();
        this.structMethods = new List<Method>();
        this.structStaticFields = new List<Field>();
        this.structStaticMethods = new List<Method>();
    }

    export fields() -> List<Field> {
        return this.structFields;
    }

    export methods() -> List<Method> {
        return this.structMethods;
    }

    // Static const fields, outside every instance layout.
    export staticFields() -> List<Field> {
        return this.structStaticFields;
    }

    // Static methods, reachable only through this struct's name.
    export staticMethods() -> List<Method> {
        return this.structStaticMethods;
    }

    public override kindWord() -> string {
        return "struct";
    }
}

export class EnumType extends DeclaredType {
    string[] enumMemberNames;
    long[] enumMemberValues;
    bool numeric;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, []);
        this.enumMemberNames = [];
        this.enumMemberValues = [];
        this.numeric = false;
    }

    export memberNames() -> string[] {
        return this.enumMemberNames;
    }

    public setMemberNames(string[] names) {
        this.enumMemberNames = names;
    }

    // The integer value assigned to each member, parallel to memberNames(). A numeric enum's
    // values come from its member initializers; a plain enum's are the ordinals 0, 1, 2, ...
    export memberValues() -> long[] {
        return this.enumMemberValues;
    }

    public setMemberValues(long[] values) {
        this.enumMemberValues = values;
    }

    // A numeric enum assigns explicit integer values to its members and converts to and from
    // integers; a plain enum is a set of distinct names with no numeric identity.
    export isNumeric() -> bool {
        return this.numeric;
    }

    public setNumeric(bool value) {
        this.numeric = value;
    }

    public override kindWord() -> string {
        return "enum";
    }
}

export class ExternalType extends DeclaredType {
    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, []);
    }

    public override kindWord() -> string {
        return "external type";
    }
}

// What a primitive's members are: the standard library declaration the compiler links onto the
// primitive itself. The members belong to the primitive, so each one's defining type is that
// primitive and reads as 'string' or 'long' in a diagnostic; the binding answers for where they
// were written and how far each one reaches. A binding names no type of its own and is reachable
// only through the primitive it binds.
export class PrimitiveBinding extends DeclaredType {
    Type boundPrimitive;
    Type[] bindingInterfaces;
    List<Method> bindingMethods;
    List<Method> bindingStaticMethods;
    // A binding declares no static const, because a constant is not a member of a value; the
    // list stays empty so that asking a primitive for its statics answers a list rather than
    // nothing, which is what tells the static-member paths the primitive has a binding at all.
    List<Field> bindingStaticFields;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Type primitive) {
        super(name, modulePath, packagePrefix, filePath, declaration, Visibility.Export, []);
        this.boundPrimitive = primitive;
        this.bindingInterfaces = [];
        this.bindingMethods = new List<Method>();
        this.bindingStaticMethods = new List<Method>();
        this.bindingStaticFields = new List<Field>();
    }

    export primitive() -> Type {
        return this.boundPrimitive;
    }

    export interfaces() -> Type[] {
        return this.bindingInterfaces;
    }

    public setInterfaces(Type[] interfaces) {
        this.bindingInterfaces = interfaces;
    }

    export methods() -> List<Method> {
        return this.bindingMethods;
    }

    export staticMethods() -> List<Method> {
        return this.bindingStaticMethods;
    }

    export staticFields() -> List<Field> {
        return this.bindingStaticFields;
    }

    public override kindWord() -> string {
        return "primitive";
    }
}

// A generic type parameter, interned by (declaring node, position). Bounds are resolved once,
// when the owning declaration's signature resolves.
export class TypeParamType extends Type {
    GreenNode owningDeclaration;
    long parameterIndex;
    string parameterName;
    Type[] parameterBounds;

    protected constructor(GreenNode owner, long index, string name) {
        this.owningDeclaration = owner;
        this.parameterIndex = index;
        this.parameterName = name;
        this.parameterBounds = [];
    }

    export owner() -> GreenNode {
        return this.owningDeclaration;
    }

    export index() -> long {
        return this.parameterIndex;
    }

    export name() -> string {
        return this.parameterName;
    }

    // The resolved bounds: interfaces plus at most one class.
    export bounds() -> Type[] {
        return this.parameterBounds;
    }

    public setBounds(Type[] bounds) {
        this.parameterBounds = bounds;
    }
}

// A reference to a generic type with its arguments, interned by (template, arguments) so equal
// references share one identity. The type store fills the members in place - the template's
// members with every type parameter replaced by the matching argument - once the template's own
// members are complete, so the interned object keeps its identity through filling.
export class InstantiationType extends Type {
    DeclaredType instantiationTemplate;
    Type[] instantiationArguments;
    bool membersFilled;
    Type? instantiationBase;
    Type[] instantiationInterfaces;
    List<Field> instantiationFields;
    long inheritedFieldCount;
    List<Method> instantiationMethods;
    List<Method> instantiationStaticMethods;

    protected constructor(DeclaredType template, Type[] arguments) {
        this.instantiationTemplate = template;
        this.instantiationArguments = arguments;
        this.membersFilled = false;
        this.instantiationInterfaces = [];
        this.instantiationFields = new List<Field>();
        this.inheritedFieldCount = 0;
        this.instantiationMethods = new List<Method>();
        this.instantiationStaticMethods = new List<Method>();
    }

    export template() -> DeclaredType {
        return this.instantiationTemplate;
    }

    export arguments() -> Type[] {
        return this.instantiationArguments;
    }

    name() -> string {
        return this.instantiationTemplate.name();
    }

    export isFilled() -> bool {
        return this.membersFilled;
    }

    protected setFilled() {
        this.membersFilled = true;
    }

    // The template's base with this instantiation's arguments applied; a generic base rebinds
    // to its own concrete instantiation.
    export base() -> Type? {
        return this.instantiationBase;
    }

    protected setBase(Type base) {
        this.instantiationBase = base;
    }

    protected interfaces() -> Type[] {
        return this.instantiationInterfaces;
    }

    protected setInterfaces(Type[] interfaces) {
        this.instantiationInterfaces = interfaces;
    }

    // Flattened like the template's: inherited fields first, own fields after.
    export fields() -> List<Field> {
        return this.instantiationFields;
    }

    public baseFieldCount() -> long {
        return this.inheritedFieldCount;
    }

    protected setBaseFieldCount(long count) {
        this.inheritedFieldCount = count;
    }

    export methods() -> List<Method> {
        return this.instantiationMethods;
    }

    // The template's static methods with this instantiation's arguments applied, parallel to the
    // template's list. Static const fields are not copied: their types and initializers never
    // mention a type parameter, so the template's Field objects stand for every instantiation.
    export staticMethods() -> List<Method> {
        return this.instantiationStaticMethods;
    }
}

class DeclaredTypeKey {
    string keyModulePath;
    string keyName;

    protected constructor(string modulePath, string name) {
        this.keyModulePath = modulePath;
        this.keyName = name;
    }

    override hash() -> long {
        return this.keyModulePath.hash() * 31 + this.keyName.hash();
    }

    override equals(DeclaredTypeKey other) -> bool {
        return this.keyModulePath == other.keyModulePath && this.keyName == other.keyName;
    }
}

class TypeParamKey {
    GreenNode keyOwner;
    long keyIndex;

    protected constructor(GreenNode owner, long index) {
        this.keyOwner = owner;
        this.keyIndex = index;
    }

    override hash() -> long {
        return this.keyOwner.hash() * 31 + this.keyIndex;
    }

    override equals(TypeParamKey other) -> bool {
        return this.keyOwner == other.keyOwner && this.keyIndex == other.keyIndex;
    }
}

class FunctionTypeKey {
    Type[] keyParameterTypes;
    Type keyReturnType;
    Type[] keyThrownTypes;

    protected constructor(Type[] parameterTypes, Type returnType, Type[] thrownTypes) {
        this.keyParameterTypes = parameterTypes;
        this.keyReturnType = returnType;
        this.keyThrownTypes = thrownTypes;
    }

    override hash() -> long {
        long combined = this.keyReturnType.hash();
        for (let parameter in this.keyParameterTypes) {
            combined = combined * 31 + parameter.hash();
        }
        for (let thrown in this.keyThrownTypes) {
            combined = combined * 31 + thrown.hash();
        }
        return combined;
    }

    override equals(FunctionTypeKey other) -> bool {
        if (this.keyReturnType != other.keyReturnType) {
            return false;
        }
        if (!sameTypeList(this.keyParameterTypes, other.keyParameterTypes)) {
            return false;
        }
        return sameTypeList(this.keyThrownTypes, other.keyThrownTypes);
    }
}

sameTypeList(Type[] left, Type[] right) -> bool {
    if (left.length != right.length) {
        return false;
    }
    for (long i = 0; i < left.length; i++) {
        if (left[i] != right[i]) {
            return false;
        }
    }
    return true;
}

class InstantiationKey {
    DeclaredType keyTemplate;
    Type[] keyArguments;

    protected constructor(DeclaredType template, Type[] arguments) {
        this.keyTemplate = template;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyTemplate.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(InstantiationKey other) -> bool {
        if (this.keyTemplate != other.keyTemplate) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

// The single owner of every type object. All construction goes through it: primitives are interned
// by kind, optionals and arrays by their inner type's identity, declared types by (module path,
// name). Keep every mutation behind this API.
export class TypeStore {
    Map<PrimitiveKind, PrimitiveType> primitives;
    StringType internedString;
    NullType internedNull;
    ErrorType internedError;
    Map<Type, OptionalType> optionals;
    Map<Type, ArrayType> arrays;
    Map<FunctionTypeKey, FunctionType> functions;
    Map<DeclaredTypeKey, DeclaredType> declaredTypes;
    Map<TypeParamKey, TypeParamType> typeParameters;
    Map<InstantiationKey, InstantiationType> instantiations;
    List<InstantiationType> pendingFills;
    List<InstantiationType> instantiationChain;
    List<FileDiagnostic> instantiationOverflows;

    public constructor() {
        this.primitives = new Map<PrimitiveKind, PrimitiveType>();
        this.internedString = new StringType();
        this.internedNull = new NullType();
        this.internedError = new ErrorType();
        this.optionals = new Map<Type, OptionalType>();
        this.arrays = new Map<Type, ArrayType>();
        this.functions = new Map<FunctionTypeKey, FunctionType>();
        this.declaredTypes = new Map<DeclaredTypeKey, DeclaredType>();
        this.typeParameters = new Map<TypeParamKey, TypeParamType>();
        this.instantiations = new Map<InstantiationKey, InstantiationType>();
        this.pendingFills = new List<InstantiationType>();
        this.instantiationChain = new List<InstantiationType>();
        this.instantiationOverflows = new List<FileDiagnostic>();
    }

    export primitive(PrimitiveKind kind) -> PrimitiveType {
        let existing = this.primitives.get(kind);
        if (existing != null) {
            return existing;
        }
        let created = new PrimitiveType(kind);
        this.primitives.set(kind, created);
        return created;
    }

    export stringType() -> StringType {
        return this.internedString;
    }

    export nullType() -> NullType {
        return this.internedNull;
    }

    export errorType() -> ErrorType {
        return this.internedError;
    }

    // Optionals nest: an optional over 'T?' is the distinct type 'T??', whose outer level says
    // whether there is a 'T?' at all. An error stays an error so one diagnosis does not cascade.
    export optionalOf(Type inner) -> Type {
        if (inner is ErrorType) {
            return inner;
        }
        let existing = this.optionals.get(inner);
        if (existing != null) {
            return existing;
        }
        let created = new OptionalType(inner);
        this.optionals.set(inner, created);
        return created;
    }

    export arrayOf(Type element) -> Type {
        if (element is ErrorType) {
            return element;
        }
        let existing = this.arrays.get(element);
        if (existing != null) {
            return existing;
        }
        let created = new ArrayType(element);
        this.arrays.set(element, created);
        return created;
    }

    // An error anywhere in the shape stays an error, so one diagnosis does not cascade.
    export functionOf(Type[] parameterTypes, Type returnType, Type[] thrownTypes) -> Type {
        if (returnType is ErrorType) {
            return returnType;
        }
        for (let parameter in parameterTypes) {
            if (parameter is ErrorType) {
                return parameter;
            }
        }
        for (let thrown in thrownTypes) {
            if (thrown is ErrorType) {
                return thrown;
            }
        }
        let key = new FunctionTypeKey(parameterTypes, returnType, thrownTypes);
        let existing = this.functions.get(key);
        if (existing != null) {
            return existing;
        }
        let created = new FunctionType(parameterTypes, returnType, thrownTypes);
        this.functions.set(key, created);
        return created;
    }

    export typeParameter(GreenNode owner, long index, string name) -> TypeParamType {
        let key = new TypeParamKey(owner, index);
        let existing = this.typeParameters.get(key);
        if (existing != null) {
            return existing;
        }
        let created = new TypeParamType(owner, index, name);
        this.typeParameters.set(key, created);
        return created;
    }

    // Interns the instantiation, registering the shell before filling so a self-referential
    // member (e.g. 'Node<T>? next') resolves back to this same instance. The members fill
    // immediately when the template's members are complete, and queue otherwise.
    export instantiationOf(DeclaredType template, Type[] arguments) -> InstantiationType {
        let key = new InstantiationKey(template, arguments);
        let existing = this.instantiations.get(key);
        if (existing != null) {
            return existing;
        }
        let created = new InstantiationType(template, arguments);
        this.instantiations.set(key, created);
        if (this.instantiationChain.length() >= maxInstantiationDepth()) {
            this.recordInstantiationOverflow();
            return created;
        }
        if (template.membersComplete()) {
            this.fill(created);
        } else {
            this.pendingFills.push(created);
        }
        return created;
    }

    // Every instantiation interned so far, open and concrete alike, in no particular order.
    export allInstantiations() -> Iterable<InstantiationType> {
        return this.instantiations.values();
    }

    // The diagnostics for instantiation chains that never terminate, cleared as they are taken.
    public takeInstantiationOverflows() -> FileDiagnostic[] {
        FileDiagnostic[] taken = this.instantiationOverflows.toArray();
        this.instantiationOverflows = new List<FileDiagnostic>();
        return taken;
    }

    recordInstantiationOverflow() {
        let root = this.instantiationChain.get(0);
        let firstNested = this.instantiationChain.get(1);
        let secondNested = this.instantiationChain.get(2);
        string rootName = display(root);
        string message = "Instantiating '" + rootName + "' never finishes: each instantiation "
            + "requires another ('" + rootName + "' needs '" + display(firstNested)
            + "', which needs '" + display(secondNested)
            + "', ...). Break the recursive type argument.";
        let template = root.template();
        this.instantiationOverflows.push(
            new FileDiagnostic(template.filePath(), message, overflowSpan(template)));
    }

    // Fills one queued instantiation early, for a base link the layout phase needs now.
    public ensureFilled(InstantiationType instantiation) {
        if (!instantiation.isFilled() && instantiation.template().membersComplete()) {
            this.fill(instantiation);
        }
    }

    // Fills every queued instantiation whose template's members are complete, to fixpoint:
    // filling can request further instantiations, which fill or queue in turn. Instantiations
    // of still-incomplete templates stay queued for the next call.
    public materializeFills() {
        bool progress = true;
        while (progress) {
            progress = false;
            let queue = this.pendingFills;
            this.pendingFills = new List<InstantiationType>();
            for (long i = 0; i < queue.length(); i++) {
                let pending = queue.get(i);
                if (pending.isFilled()) {
                    continue;
                }
                if (pending.template().membersComplete()) {
                    this.fill(pending);
                    progress = true;
                } else {
                    this.pendingFills.push(pending);
                }
            }
        }
    }

    // The type with the template's parameters replaced by the instantiation's arguments,
    // recursing through optionals, arrays, and nested instantiations. Types untouched by the
    // substitution keep their identity.
    export substitute(Type type, GreenNode owner, Type[] arguments) -> Type {
        switch (type) {
            is TypeParamType parameter -> {
                if (parameter.owner() == owner && parameter.index() < arguments.length) {
                    return arguments[parameter.index()];
                }
                return parameter;
            },
            is OptionalType optional -> {
                return this.optionalOf(this.substitute(optional.inner(), owner, arguments));
            },
            is ArrayType array -> {
                return this.arrayOf(this.substitute(array.element(), owner, arguments));
            },
            is FunctionType functionType -> {
                return this.functionOf(
                    this.substituteAll(functionType.parameterTypes(), owner, arguments),
                    this.substitute(functionType.returnType(), owner, arguments),
                    this.substituteAll(functionType.thrownTypes(), owner, arguments));
            },
            is InstantiationType nested -> {
                return this.instantiationOf(nested.template(),
                    this.substituteAll(nested.arguments(), owner, arguments));
            },
            default -> {
                return type;
            },
        }
    }

    substituteAll(Type[] typeList, GreenNode owner, Type[] arguments) -> Type[] {
        let substituted = new List<Type>();
        for (let entry in typeList) {
            substituted.push(this.substitute(entry, owner, arguments));
        }
        return substituted.toArray();
    }

    fill(InstantiationType instantiation) {
        this.instantiationChain.push(instantiation);
        let template = instantiation.template();
        Type[] arguments = instantiation.arguments();
        GreenNode owner = template.declaration();
        switch (template) {
            is ClassType classTemplate -> {
                let base = classTemplate.base();
                if (base != null) {
                    instantiation.setBase(this.substitute(base, owner, arguments));
                }
                instantiation.setInterfaces(
                    this.substituteAll(classTemplate.interfaces(), owner, arguments));
                this.fillFields(instantiation, classTemplate.fields(), owner, arguments,
                    classTemplate.baseFieldCount());
                instantiation.setBaseFieldCount(classTemplate.baseFieldCount());
                this.fillMethods(instantiation, classTemplate.methods(), owner, arguments,
                    instantiation.methods());
                this.fillMethods(instantiation, classTemplate.staticMethods(), owner, arguments,
                    instantiation.staticMethods());
            },
            is StructType structTemplate -> {
                this.fillFields(instantiation, structTemplate.fields(), owner, arguments, 0);
                this.fillMethods(instantiation, structTemplate.methods(), owner, arguments,
                    instantiation.methods());
                this.fillMethods(instantiation, structTemplate.staticMethods(), owner, arguments,
                    instantiation.staticMethods());
            },
            is InterfaceType interfaceTemplate -> {
                let base = interfaceTemplate.base();
                if (base != null) {
                    instantiation.setBase(this.substitute(base, owner, arguments));
                }
                this.fillMethods(instantiation, interfaceTemplate.methods(), owner, arguments,
                    instantiation.methods());
            },
            default -> { },
        }
        instantiation.setFilled();
        this.instantiationChain.pop();
    }

    // The first inheritedCount template fields were declared by a base, so their defining type
    // is the base's, substituted; only the fields the template declared belong to the
    // instantiation itself.
    fillFields(InstantiationType instantiation, List<Field> templateFields,
                       GreenNode owner, Type[] arguments, long inheritedCount) {
        for (long i = 0; i < templateFields.length(); i++) {
            let field = templateFields.get(i);
            Type definingType = instantiation;
            if (i < inheritedCount) {
                definingType = this.substitute(field.definingType(), owner, arguments);
            }
            instantiation.fields().push(new Field(field.name(),
                this.substitute(field.type(), owner, arguments), field.visibility(),
                field.isWeak(), field.isConst(), field.isStatic(), field.isLazy(),
                field.hasDefault(), field.nameSpan(), definingType));
        }
    }

    fillMethods(InstantiationType instantiation, List<Method> templateMethods,
                        GreenNode owner, Type[] arguments, List<Method> filled) {
        for (long i = 0; i < templateMethods.length(); i++) {
            let method = templateMethods.get(i);
            let signature = this.substituteSignature(method.signature(), owner, arguments);
            filled.push(new Method(signature, method.visibility(),
                method.isConstructor(), method.isDestructor(), method.isOverride(),
                method.isFinal(), method.isAbstract(), method.isStatic(), method.hasBody(),
                method.constraints(), instantiation));
        }
    }

    substituteSignature(Signature signature, GreenNode owner, Type[] arguments)
            -> Signature {
        let parameters = new List<Parameter>();
        for (let parameter in signature.parameters()) {
            parameters.push(new Parameter(parameter.name(),
                this.substitute(parameter.type(), owner, arguments), parameter.bindsField(),
                parameter.isOut(), parameter.hasDefault(), parameter.span()));
        }
        return new Signature(signature.name(), parameters.toArray(),
            this.substitute(signature.returnType(), owner, arguments),
            signature.declaresThrows(), signature.isNoreturn(),
            this.substituteAll(signature.throwsTypes(), owner, arguments),
            signature.throwsTypeSpans(), signature.typeParameters(),
            signature.declaration(), signature.nameSpan());
    }

    export findDeclared(string modulePath, string name) -> DeclaredType? {
        return this.declaredTypes.get(new DeclaredTypeKey(modulePath, name));
    }

    export hasDeclared(string modulePath, string name) -> bool {
        return this.declaredTypes.contains(new DeclaredTypeKey(modulePath, name));
    }

    public addClass(string name, string modulePath, string packagePrefix, string filePath,
             GreenNode declaration, Visibility visibility, string[] typeParameters,
             bool isAbstract, bool isFinal, bool isSealed) -> ClassType {
        let created = new ClassType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters, isAbstract, isFinal, isSealed);
        this.add(created);
        return created;
    }

    public addInterface(string name, string modulePath, string packagePrefix, string filePath,
                 GreenNode declaration, Visibility visibility, string[] typeParameters)
            -> InterfaceType {
        let created = new InterfaceType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters);
        this.add(created);
        return created;
    }

    public addStruct(string name, string modulePath, string packagePrefix, string filePath,
              GreenNode declaration, Visibility visibility, string[] typeParameters)
            -> StructType {
        let created = new StructType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters);
        this.add(created);
        return created;
    }

    public addEnum(string name, string modulePath, string packagePrefix, string filePath,
            GreenNode declaration, Visibility visibility) -> EnumType {
        let created = new EnumType(name, modulePath, packagePrefix, filePath, declaration,
            visibility);
        this.add(created);
        return created;
    }

    public addExternal(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) -> ExternalType {
        let created = new ExternalType(name, modulePath, packagePrefix, filePath, declaration,
            visibility);
        this.add(created);
        return created;
    }

    // Links a binding to the primitive whose members it declares. The primitive itself is where
    // the link lives, so a second binding for the same primitive is visible as a diagnostic
    // instead of silently replacing the first, and a binding names no type of its own.
    public bindPrimitive(Type primitive, string name, string modulePath, string packagePrefix,
                  string filePath, GreenNode declaration) -> PrimitiveBinding {
        let created = new PrimitiveBinding(name, modulePath, packagePrefix, filePath, declaration,
            primitive);
        switch (primitive) {
            is StringType text -> {
                text.setBinding(created);
            },
            is PrimitiveType leaf -> {
                leaf.setBinding(created);
            },
            default -> {
                panic("Internal: '{display(primitive)}' is not a primitive and cannot carry a "
                    + "binding");
            },
        }
        return created;
    }

    add(DeclaredType created) {
        let key = new DeclaredTypeKey(created.modulePath(), created.name());
        if (this.declaredTypes.contains(key)) {
            panic("Internal: type '{created.name()}' is already declared in module "
                + "'{created.modulePath()}'");
        }
        this.declaredTypes.set(key, created);
    }
}

// The instantiation nesting a well-formed program stays far below; a chain that reaches it is a
// polymorphically recursive template that would never terminate.
maxInstantiationDepth() -> long {
    return 200;
}

// The span of the field whose type re-enters the template, so the diagnostic points at the
// recursive reference; the template's start otherwise.
overflowSpan(DeclaredType template) -> Span {
    let fields = fieldsOf(template);
    if (fields != null) {
        for (long i = 0; i < fields.length(); i++) {
            let field = fields.get(i);
            if (referencesTemplate(field.type(), template)) {
                return field.nameSpan();
            }
        }
    }
    return source.makeSpan(0, 0);
}

referencesTemplate(Type type, DeclaredType template) -> bool {
    switch (type) {
        is OptionalType optional -> {
            return referencesTemplate(optional.inner(), template);
        },
        is ArrayType array -> {
            return referencesTemplate(array.element(), template);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                if (referencesTemplate(parameter, template)) {
                    return true;
                }
            }
            for (let thrown in functionType.thrownTypes()) {
                if (referencesTemplate(thrown, template)) {
                    return true;
                }
            }
            return referencesTemplate(functionType.returnType(), template);
        },
        is InstantiationType instantiation -> {
            if (instantiation.template() == template) {
                return true;
            }
            for (let argument in instantiation.arguments()) {
                if (referencesTemplate(argument, template)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}

// The type as it reads in a diagnostic, spelled the way the language writes it: 'int',
// 'Box<string>?', 'T[]', '(int, int) -> int', '((int) -> bool)?'.
export display(Type type) -> string {
    switch (type) {
        is PrimitiveType primitive -> {
            return primitiveName(primitive.kind());
        },
        is StringType ignored -> {
            return "string";
        },
        is NullType ignored -> {
            return "null";
        },
        is ErrorType ignored -> {
            return "<error>";
        },
        is OptionalType optional -> {
            return displaySuffixed(optional.inner()) + "?";
        },
        is ArrayType array -> {
            return displaySuffixed(array.element()) + "[]";
        },
        is FunctionType functionType -> {
            let builder = new StringBuilder();
            builder.append("(");
            Type[] parameters = functionType.parameterTypes();
            for (long i = 0; i < parameters.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append(display(parameters[i]));
            }
            builder.append(") -> ");
            builder.append(display(functionType.returnType()));
            Type[] thrown = functionType.thrownTypes();
            for (long i = 0; i < thrown.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                } else {
                    builder.append(" throws ");
                }
                builder.append(display(thrown[i]));
            }
            return builder.toString();
        },
        is DeclaredType declared -> {
            return displayDeclared(declared);
        },
        is TypeParamType parameter -> {
            return parameter.name();
        },
        is InstantiationType instantiation -> {
            let builder = new StringBuilder();
            builder.append(instantiation.template().name());
            builder.append("<");
            Type[] arguments = instantiation.arguments();
            for (long i = 0; i < arguments.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append(display(arguments[i]));
            }
            builder.append(">");
            return builder.toString();
        },
    }
}

// A generic template stands at its own type parameters, so it reads 'Box<T>' rather than 'Box'.
displayDeclared(DeclaredType declared) -> string {
    string[] parameters = declared.typeParameters();
    if (parameters.length == 0) {
        return declared.name();
    }
    let builder = new StringBuilder();
    builder.append(declared.name());
    builder.append("<");
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameters[i]);
    }
    builder.append(">");
    return builder.toString();
}

// A type under a '?' or '[]' suffix. A function type takes parentheses there, because the
// suffixes of the written form bind to the return type instead.
displaySuffixed(Type type) -> string {
    if (type is FunctionType) {
        return "(" + display(type) + ")";
    }
    return display(type);
}

// The nullable spelling of a type, for a diagnostic suggesting a type that allows null. It is not
// always the type's own spelling with a '?' added, because a function type needs parentheses
// first: '((int) -> bool)?' is a function reference that may be null, while '(int) -> bool?' is a
// function whose return may be.
export displayNullable(Type type) -> string {
    return displaySuffixed(type) + "?";
}

public primitiveName(PrimitiveKind kind) -> string {
    return switch (kind) {
        Bool -> "bool",
        Byte -> "byte",
        Short -> "short",
        UShort -> "ushort",
        Int -> "int",
        UInt -> "uint",
        Long -> "long",
        ULong -> "ulong",
        Float -> "float",
        Double -> "double",
        Decimal -> "decimal",
        Char -> "char",
        Void -> "void",
    };
}

export isVoidType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Void;
    }
    return false;
}

export isDecimalType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Decimal;
    }
    return false;
}

export isCharType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Char;
    }
    return false;
}

// True for the reference types that participate in inheritance and conformance: classes,
// interfaces, and instantiations of generic classes or interfaces.
export isClassLike(Type type) -> bool {
    if (type is ClassType || type is InterfaceType) {
        return true;
    }
    if (type is InstantiationType) {
        let template = type.template();
        return template is ClassType || template is InterfaceType;
    }
    return false;
}

// True when a value of this type is one pointer at runtime: a class or interface reference, an
// array, a string, a function value, or a foreign handle, and one optional level over any of them,
// whose absence lives in the pointer itself. A second optional level is a tagged pair whatever it
// wraps, so it is not one pointer.
export isPointerShaped(Type type) -> bool {
    Type core = type;
    if (type is OptionalType) {
        core = type.inner();
    }
    return isClassLike(core) || core is ArrayType || core is StringType
        || core is ExternalType || core is FunctionType;
}

export isInterfaceLike(Type type) -> bool {
    if (type is InterfaceType) {
        return true;
    }
    if (type is InstantiationType) {
        return type.template() is InterfaceType;
    }
    return false;
}

// The standard library declaration of a primitive's members, or null for every other type and
// for a primitive nothing declares members for. One home for the primitive-to-binding step.
export bindingOf(Type type) -> PrimitiveBinding? {
    switch (type) {
        is StringType text -> {
            return text.binding();
        },
        is PrimitiveType primitive -> {
            return primitive.binding();
        },
        default -> {
            return null;
        },
    }
}

// The primitive a name spells, or null when the name is not a primitive's. The inverse of
// primitiveName.
export primitiveNamed(TypeStore store, string name) -> Type? {
    switch (name) {
        "bool" -> {
            return store.primitive(PrimitiveKind.Bool);
        },
        "byte" -> {
            return store.primitive(PrimitiveKind.Byte);
        },
        "short" -> {
            return store.primitive(PrimitiveKind.Short);
        },
        "ushort" -> {
            return store.primitive(PrimitiveKind.UShort);
        },
        "int" -> {
            return store.primitive(PrimitiveKind.Int);
        },
        "uint" -> {
            return store.primitive(PrimitiveKind.UInt);
        },
        "long" -> {
            return store.primitive(PrimitiveKind.Long);
        },
        "ulong" -> {
            return store.primitive(PrimitiveKind.ULong);
        },
        "float" -> {
            return store.primitive(PrimitiveKind.Float);
        },
        "double" -> {
            return store.primitive(PrimitiveKind.Double);
        },
        "decimal" -> {
            return store.primitive(PrimitiveKind.Decimal);
        },
        "char" -> {
            return store.primitive(PrimitiveKind.Char);
        },
        "void" -> {
            return store.primitive(PrimitiveKind.Void);
        },
        "string" -> {
            return store.stringType();
        },
        default -> {
            return null;
        },
    }
}

// The declared type that speaks for a reference in inheritance walks: an instantiation defers
// to its template until its members are filled, and a primitive defers to the binding that
// declares its members.
export authorityOf(Type type) -> DeclaredType? {
    switch (type) {
        is DeclaredType declared -> {
            return declared;
        },
        is InstantiationType instantiation -> {
            return instantiation.template();
        },
        default -> {
            return bindingOf(type);
        },
    }
}

// Whether `instantiation` is `declared` applied to its own type parameters. Inside a generic body
// `this` has the bare declared type, and the body spells that same type as the instantiation.
export isSelfInstantiation(Type instantiation, Type declared) -> bool {
    if (instantiation is InstantiationType && declared is DeclaredType
            && instantiation.template() == declared) {
        TypeParamType[] parameters = declared.typeParameterTypes();
        Type[] arguments = instantiation.arguments();
        if (arguments.length != parameters.length) {
            return false;
        }
        for (long i = 0; i < arguments.length; i++) {
            if (arguments[i] != parameters[i]) {
                return false;
            }
        }
        return true;
    }
    return false;
}

// The fields a type stores, or null for types without fields. A filled instantiation exposes
// its substituted fields; an unfilled one has none to expose yet.
export fieldsOf(Type type) -> List<Field>? {
    switch (type) {
        is ClassType classType -> {
            return classType.fields();
        },
        is StructType structType -> {
            return structType.fields();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.fields();
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

// The number of leading fields a flattened layout inherits from its base class. Zero for any
// type without a base, so own fields are those at this index and after.
export baseFieldCount(Type type) -> long {
    switch (type) {
        is ClassType classType -> {
            return classType.baseFieldCount();
        },
        is InstantiationType instantiation -> {
            return instantiation.baseFieldCount();
        },
        default -> {
            return 0;
        },
    }
}

// The static methods a type declares itself, or null for types that cannot carry statics. A
// filled instantiation exposes its substituted statics; an unfilled one has none to expose yet.
export staticMethodsOf(Type type) -> List<Method>? {
    switch (type) {
        is ClassType classType -> {
            return classType.staticMethods();
        },
        is StructType structType -> {
            return structType.staticMethods();
        },
        is PrimitiveBinding binding -> {
            return binding.staticMethods();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.staticMethods();
            }
            return null;
        },
        default -> {
            let bound = bindingOf(type);
            if (bound != null) {
                return bound.staticMethods();
            }
            return null;
        },
    }
}

// The type-level const fields a type declares, static and lazy alike, or null for types that
// cannot carry statics. An instantiation shares its template's fields, because neither kind of
// type-level field ever mentions a type parameter.
export staticFieldsOf(Type type) -> List<Field>? {
    switch (type) {
        is ClassType classType -> {
            return classType.staticFields();
        },
        is StructType structType -> {
            return structType.staticFields();
        },
        is PrimitiveBinding binding -> {
            return binding.staticFields();
        },
        is InstantiationType instantiation -> {
            return staticFieldsOf(instantiation.template());
        },
        default -> {
            let bound = bindingOf(type);
            if (bound != null) {
                return bound.staticFields();
            }
            return null;
        },
    }
}

// The methods a type declares itself, or null for types without methods.
export methodsOf(Type type) -> List<Method>? {
    switch (type) {
        is ClassType classType -> {
            return classType.methods();
        },
        is StructType structType -> {
            return structType.methods();
        },
        is InterfaceType interfaceType -> {
            return interfaceType.methods();
        },
        is PrimitiveBinding binding -> {
            return binding.methods();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.methods();
            }
            return null;
        },
        default -> {
            let bound = bindingOf(type);
            if (bound != null) {
                return bound.methods();
            }
            return null;
        },
    }
}

// The number of leading parameters without defaults: the least a call must supply.
export requiredParameterCount(Signature signature) -> long {
    Parameter[] parameters = signature.parameters();
    long required = 0;
    for (long i = 0; i < parameters.length; i++) {
        if (parameters[i].hasDefault()) {
            break;
        }
        required++;
    }
    return required;
}

// The constructor an implicit zero-argument construction binds on one type, or null when it
// declares none that takes no arguments: the first zero-parameter constructor in declaration
// order, else the first whose parameters all take defaults. The one home for the choice: code
// generation runs the winner, and sema asks whether that same winner exists on the
// instantiation, so the two can never latch onto different constructors.
export implicitConstructorChoice(Type classType) -> Method? {
    Method? fallback = null;
    let methods = methodsOf(classType);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (!method.isConstructor()) {
            continue;
        }
        if (method.signature().parameters().length == 0) {
            return method;
        }
        if (fallback == null && requiredParameterCount(method.signature()) == 0) {
            fallback = method;
        }
    }
    return fallback;
}

// A struct's own 'toString', or null when it declares none. Both an explicit '.toString()' and an
// interpolation hole ask this one question to decide whether a struct has a text form of its own
// instead of its JSON form. Its declaration is held to 'toString() -> string' without 'throws', so
// it always stands in.
export declaredToString(Type type) -> Method? {
    let methods = methodsOf(type);
    if (methods == null) {
        return null;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (method.name() == "toString") {
            return method;
        }
    }
    return null;
}

// The next link of the inheritance chain: a class's base class, or the interface an interface
// extends. A filled instantiation continues through its rebound base; an unfilled one falls back
// to its template's base.
export baseOf(Type type) -> Type? {
    switch (type) {
        is ClassType classType -> {
            return classType.base();
        },
        is InterfaceType interfaceType -> {
            return interfaceType.base();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.base();
            }
            switch (instantiation.template()) {
                is ClassType template -> {
                    return template.base();
                },
                is InterfaceType template -> {
                    return template.base();
                },
                default -> {
                    return null;
                },
            }
        },
        default -> {
            return null;
        },
    }
}

// The interfaces a type's own 'implements' clause names, substituted once it is filled.
export interfacesOf(Type type) -> Type[] {
    switch (type) {
        is ClassType classType -> {
            return classType.interfaces();
        },
        is PrimitiveBinding binding -> {
            return binding.interfaces();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.interfaces();
            }
            let template = instantiation.template();
            if (template is ClassType) {
                return template.interfaces();
            }
            return [];
        },
        default -> {
            let bound = bindingOf(type);
            if (bound != null) {
                return bound.interfaces();
            }
            return [];
        },
    }
}

// True when derived is ancestor or reaches it through its base chain.
export isSubclassOf(Type derived, Type ancestor) -> bool {
    let seen = new Set<Type>();
    Type? current = derived;
    while (current != null && seen.add(current)) {
        if (current == ancestor) {
            return true;
        }
        let declared = authorityOf(current);
        if (declared == null) {
            return false;
        }
        if (declared == ancestor) {
            return true;
        }
        current = baseOf(current);
    }
    return false;
}

// Whether every possible value of 'derived' is a subclass of 'ancestor'. A type parameter as the
// ancestor matches only itself, because each instantiation may name a different class.
export isAlwaysSubclassOf(Type derived, Type ancestor) -> bool {
    if (derived == ancestor) {
        return true;
    }
    if (derived is TypeParamType) {
        for (let bound in derived.bounds()) {
            if (isSubclassOf(bound, ancestor)) {
                return true;
            }
        }
        return false;
    }
    return isSubclassOf(derived, ancestor);
}

// A type parameter's class bound, or the type itself when it is not a parameter. This is the
// type to judge by where possibility is enough.
export boundClassOf(Type type) -> Type {
    if (type is TypeParamType) {
        for (let bound in type.bounds()) {
            if (isClassLike(bound)) {
                return bound;
            }
        }
    }
    return type;
}

// isAlwaysSubclassOf under a conditional member's constraint scope, where the restated
// parameter carries extra bounds.
export isAlwaysSubclassOfUnder(Type derived, Type ancestor, GreenNode? scopeOwner,
                               MemberConstraint[] scopeConstraints) -> bool {
    if (isAlwaysSubclassOf(derived, ancestor)) {
        return true;
    }
    for (let bound in extraBoundsFor(derived, scopeOwner, scopeConstraints)) {
        if (isSubclassOf(bound, ancestor)) {
            return true;
        }
    }
    return false;
}

export boundClassOfUnder(Type type, GreenNode? scopeOwner, MemberConstraint[] scopeConstraints) -> Type {
    Type reduced = boundClassOf(type);
    if (reduced == type && type is TypeParamType) {
        for (let bound in extraBoundsFor(type, scopeOwner, scopeConstraints)) {
            if (isClassLike(bound)) {
                return bound;
            }
        }
    }
    return reduced;
}

// An interface together with every ancestor its 'extends' chain reaches, nearest first.
export interfaceLadderOf(Type interfaceType) -> Type[] {
    let ladder = new List<Type>();
    let seen = new Set<Type>();
    Type? current = interfaceType;
    while (current != null && seen.add(current)) {
        ladder.push(current);
        current = baseOf(current);
    }
    return ladder.toArray();
}

// The type itself and every class or interface a value of it also is, nearest first and each once.
export conformanceLadderOf(Type type) -> Type[] {
    let ladder = new List<Type>();
    let seen = new Set<Type>();
    Type? current = type;
    while (current != null && seen.add(current)) {
        ladder.push(current);
        for (let implemented in interfacesOf(current)) {
            for (let ancestor in interfaceLadderOf(implemented)) {
                if (seen.add(ancestor)) {
                    ladder.push(ancestor);
                }
            }
        }
        current = baseOf(current);
    }
    return ladder.toArray();
}

// The nearest instantiation of 'template' a value of 'type' is or conforms to, or null.
export conformingInstantiationOf(Type type, DeclaredType template) -> InstantiationType? {
    for (let level in conformanceLadderOf(type)) {
        if (level is InstantiationType && level.template() == template) {
            return level;
        }
    }
    return null;
}

// True when source reaches the interface: source is the interface itself or extends it, or a
// class in source's chain implements it or an interface extending it. A primitive reaches one
// through the conformances its binding declares, which is a compile-time judgment only: nothing
// gives a primitive an interface value.
export conformsTo(Type source, Type interfaceType) -> bool {
    let seen = new Set<Type>();
    Type? current = source;
    while (current != null && seen.add(current)) {
        if (current == interfaceType) {
            return true;
        }
        for (let implemented in interfacesOf(current)) {
            for (let ancestor in interfaceLadderOf(implemented)) {
                if (ancestor == interfaceType) {
                    return true;
                }
            }
        }
        let declared = authorityOf(current);
        if (declared == null) {
            return false;
        }
        if (declared == interfaceType) {
            return true;
        }
        current = baseOf(current);
    }
    return false;
}

export isSubclassOrConforms(Type source, Type target) -> bool {
    if (isInterfaceLike(target)) {
        return conformsTo(source, target);
    }
    return isSubclassOf(source, target);
}

// Whether one type argument satisfies one bound: a class or interface value through the subclass
// chain or conformance, a primitive through the conformances its binding declares, and a
// type-parameter argument through its own declared bounds plus the extra bounds the enclosing
// conditional member's constraints put in scope. The one home for the judgment; the resolver's
// bound checks and the conditional-member existence checks both ask here.
export satisfiesBound(Type argument, Type bound, Type[] extraArgumentBounds) -> bool {
    if (isClassLike(argument)) {
        return isSubclassOrConforms(argument, bound);
    }
    if (bindingOf(argument) != null && isInterfaceLike(bound)) {
        return conformsTo(argument, bound);
    }
    if (argument is TypeParamType) {
        for (let own in argument.bounds()) {
            if (own == bound || isSubclassOrConforms(own, bound)) {
                return true;
            }
        }
        for (let own in extraArgumentBounds) {
            if (own == bound || isSubclassOrConforms(own, bound)) {
                return true;
            }
        }
    }
    return false;
}

// The extra bounds the active conditional member's constraints add to this type when it is one
// of the constrained parameters, or none. scopeOwner is the declaration whose parameters the
// active constraints restate; null outside any conditional member's scope.
export extraBoundsFor(Type argument, GreenNode? scopeOwner, MemberConstraint[] scopeConstraints)
        -> Type[] {
    if (argument is TypeParamType && scopeOwner != null && argument.owner() == scopeOwner) {
        for (let constraint in scopeConstraints) {
            if (constraint.parameterIndex() == argument.index()) {
                return constraint.bounds();
            }
        }
    }
    return [];
}

// One constraint an owner's type arguments fail: the constrained parameter, the bound as the
// member declares it, and the bound with the owner's arguments substituted in, for diagnostics.
export class FailedConstraint {
    long failedIndex;
    Type declaredBound;
    Type substitutedBound;

    public constructor(this.failedIndex, this.declaredBound, this.substitutedBound);

    export parameterIndex() -> long {
        return this.failedIndex;
    }

    export bound() -> Type {
        return this.declaredBound;
    }

    export boundHere() -> Type {
        return this.substitutedBound;
    }
}

// The first constraint of a conditional member that these type arguments fail, or null when
// every one holds (an unconditional member always holds). The arguments are the template's own
// parameters when judging the template itself, and an instantiation's arguments otherwise.
export firstFailedConstraint(TypeStore store, Method method, DeclaredType template,
                             Type[] arguments, GreenNode? scopeOwner,
                             MemberConstraint[] scopeConstraints) -> FailedConstraint? {
    for (let constraint in method.constraints()) {
        long index = constraint.parameterIndex();
        if (index >= arguments.length) {
            continue;
        }
        Type argument = arguments[index];
        if (argument is ErrorType) {
            continue;
        }
        for (let bound in constraint.bounds()) {
            Type here = store.substitute(bound, template.declaration(), arguments);
            if (!satisfiesBound(argument, here,
                    extraBoundsFor(argument, scopeOwner, scopeConstraints))) {
                return new FailedConstraint(index, bound, here);
            }
        }
    }
    return null;
}

// The type arguments a type stands at: an instantiation's own, and the template's parameters
// standing for themselves on the template or on any other declared type.
export typeArgumentsOf(Type owner) -> Type[] {
    if (owner is InstantiationType) {
        return owner.arguments();
    }
    let template = authorityOf(owner);
    if (template == null) {
        return [];
    }
    TypeParamType[] parameters = template.typeParameterTypes();
    let arguments = new List<Type>();
    for (let parameter in parameters) {
        arguments.push(parameter);
    }
    return arguments.toArray();
}

// Whether a member exists on the type that defines it: an unconditional member always does; a
// conditional one only where the defining type's arguments satisfy every constraint. The scope
// carries the enclosing conditional member's constraints, so a body may use members its own
// constraint unlocks; pass none outside a body.
export memberExistsOn(TypeStore store, Method method, GreenNode? scopeOwner,
                      MemberConstraint[] scopeConstraints) -> bool {
    if (!method.isConditional()) {
        return true;
    }
    let owner = method.definingType();
    let template = authorityOf(owner);
    if (template == null) {
        return true;
    }
    return firstFailedConstraint(store, method, template, typeArgumentsOf(owner), scopeOwner,
        scopeConstraints) == null;
}

export memberExistsOn(TypeStore store, Method method) -> bool {
    return memberExistsOn(store, method, null, []);
}

// True when the template declares any conditional member, instance or static; the plan and the
// harvest only pay the per-member filter for templates that need it.
export hasConditionalMembers(DeclaredType template) -> bool {
    let methods = methodsOf(template);
    if (methods != null) {
        for (long i = 0; i < methods.length(); i++) {
            if (methods.get(i).isConditional()) {
                return true;
            }
        }
    }
    let statics = staticMethodsOf(template);
    if (statics != null) {
        for (long i = 0; i < statics.length(); i++) {
            if (statics.get(i).isConditional()) {
                return true;
            }
        }
    }
    return false;
}

// Lossless primitive widening, the implicit numeric conversion the language allows.
export widensTo(Type from, Type to) -> bool {
    if (from is PrimitiveType && to is PrimitiveType) {
        return kindWidensTo(from.kind(), to.kind());
    }
    return false;
}

kindWidensTo(PrimitiveKind from, PrimitiveKind to) -> bool {
    if (from == to) {
        return false;
    }
    if (isIntegerKind(from) && isIntegerKind(to)) {
        long fromWidth = integerBitWidth(from);
        long toWidth = integerBitWidth(to);
        if (isSignedKind(from)) {
            return isSignedKind(to) && toWidth > fromWidth;
        }
        return toWidth > fromWidth;
    }
    // A 'char' is a code point rather than a quantity: arithmetic on it in integers is
    // meaningful, but as a floating-point number it has no use, so it converts only where the
    // program asks for it with 'as'.
    if (isIntegerKind(from) && isFloatKind(to)) {
        if (from == PrimitiveKind.Char) {
            return false;
        }
        long mantissa = 53;
        if (floatBitWidth(to) == 32) {
            mantissa = 24;
        }
        return integerBitWidth(from) <= mantissa;
    }
    if (isFloatKind(from) && isFloatKind(to)) {
        return floatBitWidth(from) < floatBitWidth(to);
    }
    return false;
}

isIntegerKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Byte, Short, UShort, Int, UInt, Long, ULong, Char -> true,
        default -> false,
    };
}

isSignedKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Short, Int, Long -> true,
        default -> false,
    };
}

isFloatKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Float, Double, Decimal -> true,
        default -> false,
    };
}

integerBitWidth(PrimitiveKind kind) -> long {
    return switch (kind) {
        Byte -> 8,
        Short, UShort -> 16,
        Int, UInt, Char -> 32,
        Long, ULong -> 64,
        default -> 0,
    };
}

floatBitWidth(PrimitiveKind kind) -> long {
    return switch (kind) {
        Float -> 32,
        Double -> 64,
        default -> 0,
    };
}

