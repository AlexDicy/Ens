// The sema type model. Every type object is created and interned by the TypeStore, so equal types
// are the same object and type equality is reference identity everywhere. Declared types carry
// the metadata published at name registration; members and bases are filled by later phases.
import GreenNode from @ens.frontend.syntax.green;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from support.diagnostics;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

public enum PrimitiveKind {
    Bool,
    Byte,
    Short,
    UShort,
    Int,
    UInt,
    Long,
    ULong,
    Float,
    Double,
    Decimal,
    Char,
    Void,
}

public enum Visibility {
    Public,
    Protected,
    Private,
    Export,
}

// The ladder position used by the boundary and leakage checks. Protected shares the private
// floor: its guaranteed reach is the declaring file.
public visibilityTier(Visibility visibility) -> long {
    return switch (visibility) {
        Private, Protected -> 0,
        Public -> 1,
        Export -> 2,
    };
}

public visibilityWord(Visibility visibility) -> string {
    return switch (visibility) {
        Private -> "private",
        Protected -> "protected",
        Public -> "public",
        Export -> "export",
    };
}

// The visibility of a member that follows its containing type: such a member is accessible
// wherever the type is nameable. A private type is nameable throughout its file, which for
// members is exactly the protected floor.
public followedMemberVisibility(Visibility container) -> Visibility {
    if (container == Visibility.Private) {
        return Visibility.Protected;
    }
    return container;
}

// True when a top-level declaration with the given visibility is nameable from the use site:
// the same module sees everything, 'export' crosses packages, and 'public' reaches the rest of
// its own package.
public isVisibleFrom(Visibility visibility, string declModulePath, string declPackagePrefix,
                     string useModulePath, string usePackagePrefix) -> bool {
    if (declModulePath == useModulePath) {
        return true;
    }
    if (visibility == Visibility.Export) {
        return true;
    }
    if (visibility == Visibility.Public) {
        return declPackagePrefix == usePackagePrefix;
    }
    return false;
}

// "<kindWord> '<name>' is private to module 'M'; ..." with the modifier that fixes it.
public notVisibleMessage(string kindWord, string name, Visibility visibility,
                         string declModulePath, string declPackagePrefix,
                         string usePackagePrefix) -> string {
    bool samePackage = declPackagePrefix == usePackagePrefix;
    if (visibility == Visibility.Public && !samePackage) {
        string packageName = "its package";
        if (declPackagePrefix.length > 0) {
            packageName = "package '{declPackagePrefix}'";
        }
        return "{kindWord} '{name}' is public inside {packageName} but not exported. Mark it "
            + "'export' in module '{declModulePath}' to use it from another package.";
    }
    string fix = "Mark it 'export' to use it from another package.";
    if (samePackage) {
        fix = "Mark it 'public' to use it from other modules in the package.";
    }
    return "{kindWord} '{name}' is private to module '{declModulePath}'; it can only be used "
        + "inside that file. " + fix;
}

public sealed abstract class Type {
}

public class PrimitiveType extends Type {
    PrimitiveKind primitiveKind;

    protected constructor(PrimitiveKind kind) {
        this.primitiveKind = kind;
    }

    public kind() -> PrimitiveKind {
        return this.primitiveKind;
    }
}

public class StringType extends Type {
    protected constructor();
}

public class NullType extends Type {
    protected constructor();
}

// Cascade suppression sentinel: the type of anything that already produced a diagnostic.
public class ErrorType extends Type {
    protected constructor();
}

public class OptionalType extends Type {
    Type innerType;

    protected constructor(Type inner) {
        this.innerType = inner;
    }

    public inner() -> Type {
        return this.innerType;
    }
}

public class ArrayType extends Type {
    Type elementType;

    protected constructor(Type element) {
        this.elementType = element;
    }

    public element() -> Type {
        return this.elementType;
    }
}

// One resolved parameter of a function, method, or constructor.
public class Parameter {
    string parameterName;
    Type parameterType;
    bool fieldShorthand;
    bool outParameter;
    bool defaulted;
    Span parameterSpan;

    public constructor(string name, Type type, bool bindsField, bool isOut, bool hasDefault,
                Span span) {
        this.parameterName = name;
        this.parameterType = type;
        this.fieldShorthand = bindsField;
        this.outParameter = isOut;
        this.defaulted = hasDefault;
        this.parameterSpan = span;
    }

    public name() -> string {
        return this.parameterName;
    }

    public type() -> Type {
        return this.parameterType;
    }

    // True for the 'this.field' constructor shorthand.
    public bindsField() -> bool {
        return this.fieldShorthand;
    }

    public isOut() -> bool {
        return this.outParameter;
    }

    public hasDefault() -> bool {
        return this.defaulted;
    }

    public span() -> Span {
        return this.parameterSpan;
    }
}

// A resolved callable signature. Declared throws types are resolved here; whether they are valid
// exception types is checked by a later pass, so the reference spans are kept alongside.
public class Signature {
    string signatureName;
    Parameter[] signatureParameters;
    Type signatureReturnType;
    bool marksThrows;
    bool marksNoreturn;
    Type[] resolvedThrowsTypes;
    Span[] resolvedThrowsSpans;
    TypeParamType[] signatureTypeParameters;
    GreenNode? declarationNode;
    Span signatureNameSpan;

    public constructor(string name, Parameter[] parameters, Type returnType, bool declaresThrows,
                bool declaresNoreturn, Type[] throwsTypes, Span[] throwsSpans,
                TypeParamType[] typeParameters, GreenNode? declaration, Span nameSpan) {
        this.signatureName = name;
        this.signatureParameters = parameters;
        this.signatureReturnType = returnType;
        this.marksThrows = declaresThrows;
        this.marksNoreturn = declaresNoreturn;
        this.resolvedThrowsTypes = throwsTypes;
        this.resolvedThrowsSpans = throwsSpans;
        this.signatureTypeParameters = typeParameters;
        this.declarationNode = declaration;
        this.signatureNameSpan = nameSpan;
    }

    public name() -> string {
        return this.signatureName;
    }

    public parameters() -> Parameter[] {
        return this.signatureParameters;
    }

    public returnType() -> Type {
        return this.signatureReturnType;
    }

    public declaresThrows() -> bool {
        return this.marksThrows;
    }

    // True when the callable is declared 'noreturn': it never completes normally, so a call to
    // it in statement position ends the path exactly as 'panic' does.
    public isNoreturn() -> bool {
        return this.marksNoreturn;
    }

    public throwsTypes() -> Type[] {
        return this.resolvedThrowsTypes;
    }

    public throwsTypeSpans() -> Span[] {
        return this.resolvedThrowsSpans;
    }

    public typeParameters() -> TypeParamType[] {
        return this.signatureTypeParameters;
    }

    public isGeneric() -> bool {
        return this.signatureTypeParameters.length > 0;
    }

    public declaration() -> GreenNode? {
        return this.declarationNode;
    }

    public nameSpan() -> Span {
        return this.signatureNameSpan;
    }
}

// True when the two signatures take exactly the same parameter types. Types are interned, so
// type equality is reference identity.
public sameParameterTypes(Signature first, Signature second) -> bool {
    Parameter[] left = first.parameters();
    Parameter[] right = second.parameters();
    if (left.length != right.length) {
        return false;
    }
    for (long i = 0; i < left.length; i++) {
        if (left[i].type() != right[i].type()) {
            return false;
        }
    }
    return true;
}

// One field of a struct or class. Flattened class layouts share the base class's Field objects,
// so definingType still names the class - or generic instantiation - that declared the field.
public class Field {
    string fieldName;
    Type fieldType;
    Visibility fieldVisibility;
    bool weakField;
    bool defaulted;
    Span fieldNameSpan;
    Type definingDeclaration;

    public constructor(string name, Type type, Visibility visibility, bool isWeak, bool hasDefault,
                Span nameSpan, Type definingType) {
        this.fieldName = name;
        this.fieldType = type;
        this.fieldVisibility = visibility;
        this.weakField = isWeak;
        this.defaulted = hasDefault;
        this.fieldNameSpan = nameSpan;
        this.definingDeclaration = definingType;
    }

    public name() -> string {
        return this.fieldName;
    }

    public type() -> Type {
        return this.fieldType;
    }

    public visibility() -> Visibility {
        return this.fieldVisibility;
    }

    public isWeak() -> bool {
        return this.weakField;
    }

    public hasDefault() -> bool {
        return this.defaulted;
    }

    public nameSpan() -> Span {
        return this.fieldNameSpan;
    }

    public definingType() -> Type {
        return this.definingDeclaration;
    }
}

// One method of a struct, class, or interface. Constructors are stored under the name
// 'constructor' and destructors under 'destructor', so overload checks treat them uniformly.
public class Method {
    Signature methodSignature;
    Visibility methodVisibility;
    bool constructorMethod;
    bool destructorMethod;
    bool overrideMarked;
    bool finalMarked;
    bool abstractMarked;
    bool bodied;
    Type definingDeclaration;

    public constructor(Signature signature, Visibility visibility, bool isConstructor, bool isDestructor,
                bool isOverride, bool isFinal, bool isAbstract, bool hasBody,
                Type definingType) {
        this.methodSignature = signature;
        this.methodVisibility = visibility;
        this.constructorMethod = isConstructor;
        this.destructorMethod = isDestructor;
        this.overrideMarked = isOverride;
        this.finalMarked = isFinal;
        this.abstractMarked = isAbstract;
        this.bodied = hasBody;
        this.definingDeclaration = definingType;
    }

    public name() -> string {
        return this.methodSignature.name();
    }

    public signature() -> Signature {
        return this.methodSignature;
    }

    public visibility() -> Visibility {
        return this.methodVisibility;
    }

    public isConstructor() -> bool {
        return this.constructorMethod;
    }

    public isDestructor() -> bool {
        return this.destructorMethod;
    }

    public isOverride() -> bool {
        return this.overrideMarked;
    }

    public isFinal() -> bool {
        return this.finalMarked;
    }

    public isAbstract() -> bool {
        return this.abstractMarked;
    }

    public isNoreturn() -> bool {
        return this.methodSignature.isNoreturn();
    }

    protected hasBody() -> bool {
        return this.bodied;
    }

    public definingType() -> Type {
        return this.definingDeclaration;
    }
}

// A type introduced by a declaration. The declaration green node is the stable identity of the
// declaration site; red views are rebuilt over it on demand.
public sealed abstract class DeclaredType extends Type {
    string declaredName;
    string declaredModulePath;
    string declaredPackagePrefix;
    string declaredFilePath;
    GreenNode declarationNode;
    Visibility declaredVisibility;
    string[] declaredTypeParameters;
    TypeParamType[]? resolvedTypeParameters;
    bool declaredMembersComplete;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        this.declaredName = name;
        this.declaredModulePath = modulePath;
        this.declaredPackagePrefix = packagePrefix;
        this.declaredFilePath = filePath;
        this.declarationNode = declaration;
        this.declaredVisibility = visibility;
        this.declaredTypeParameters = typeParameters;
        this.declaredMembersComplete = false;
    }

    public name() -> string {
        return this.declaredName;
    }

    public modulePath() -> string {
        return this.declaredModulePath;
    }

    public packagePrefix() -> string {
        return this.declaredPackagePrefix;
    }

    public filePath() -> string {
        return this.declaredFilePath;
    }

    public declaration() -> GreenNode {
        return this.declarationNode;
    }

    public visibility() -> Visibility {
        return this.declaredVisibility;
    }

    public typeParameters() -> string[] {
        return this.declaredTypeParameters;
    }

    public isGeneric() -> bool {
        return this.declaredTypeParameters.length > 0;
    }

    // The interned type parameters with their bounds, once the parameter list resolves.
    public typeParameterTypes() -> TypeParamType[] {
        let resolved = this.resolvedTypeParameters;
        if (resolved == null) {
            return [];
        }
        return resolved;
    }

    hasResolvedTypeParameters() -> bool {
        return this.resolvedTypeParameters != null;
    }

    public setTypeParameterTypes(TypeParamType[] parameters) {
        this.resolvedTypeParameters = parameters;
    }

    // True once every member's signature is resolved, so instantiations can fill from it.
    protected membersComplete() -> bool {
        return this.declaredMembersComplete;
    }

    public setMembersComplete() {
        this.declaredMembersComplete = true;
    }

    // The declaration's kind as it reads in a diagnostic: "class", "enum", ...
    abstract kindWord() -> string;
}

public class ClassType extends DeclaredType {
    bool classIsAbstract;
    bool classIsFinal;
    bool classIsSealed;
    Type? classBase;
    Type[] classInterfaces;
    List<Field> classFields;
    long inheritedFieldCount;
    List<Method> classMethods;
    List<ClassType> classDirectSubclasses;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters,
                bool isAbstract, bool isFinal, bool isSealed) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.classIsAbstract = isAbstract;
        this.classIsFinal = isFinal;
        this.classIsSealed = isSealed;
        this.classInterfaces = [];
        this.classFields = new List<Field>();
        this.inheritedFieldCount = 0;
        this.classMethods = new List<Method>();
        this.classDirectSubclasses = new List<ClassType>();
    }

    public isAbstract() -> bool {
        return this.classIsAbstract;
    }

    public isFinal() -> bool {
        return this.classIsFinal;
    }

    public isSealed() -> bool {
        return this.classIsSealed;
    }

    // The resolved base: a ClassType, or an InstantiationType of a generic class.
    public base() -> Type? {
        return this.classBase;
    }

    public setBase(Type base) {
        this.classBase = base;
    }

    public clearBase() {
        this.classBase = null;
    }

    // The interfaces named in this class's own 'implements' clause.
    public interfaces() -> Type[] {
        return this.classInterfaces;
    }

    public setInterfaces(Type[] interfaces) {
        this.classInterfaces = interfaces;
    }

    // Flattened layout: inherited fields first, own fields after.
    public fields() -> List<Field> {
        return this.classFields;
    }

    public baseFieldCount() -> long {
        return this.inheritedFieldCount;
    }

    public setBaseFieldCount(long count) {
        this.inheritedFieldCount = count;
    }

    // Own methods only; inherited methods are reached through base().
    public methods() -> List<Method> {
        return this.classMethods;
    }

    public directSubclasses() -> List<ClassType> {
        return this.classDirectSubclasses;
    }

    public removeDirectSubclass(ClassType subclass) {
        let kept = new List<ClassType>();
        for (long i = 0; i < this.classDirectSubclasses.length(); i++) {
            if (this.classDirectSubclasses.get(i) != subclass) {
                kept.push(this.classDirectSubclasses.get(i));
            }
        }
        this.classDirectSubclasses = kept;
    }

    public override kindWord() -> string {
        return "class";
    }
}

public class InterfaceType extends DeclaredType {
    List<Method> interfaceMethods;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.interfaceMethods = new List<Method>();
    }

    public methods() -> List<Method> {
        return this.interfaceMethods;
    }

    override kindWord() -> string {
        return "interface";
    }
}

public class StructType extends DeclaredType {
    List<Field> structFields;
    List<Method> structMethods;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility, string[] typeParameters) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, typeParameters);
        this.structFields = new List<Field>();
        this.structMethods = new List<Method>();
    }

    public fields() -> List<Field> {
        return this.structFields;
    }

    public methods() -> List<Method> {
        return this.structMethods;
    }

    override kindWord() -> string {
        return "struct";
    }
}

public class EnumType extends DeclaredType {
    string[] enumMemberNames;
    bool numeric;

    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, []);
        this.enumMemberNames = [];
        this.numeric = false;
    }

    public memberNames() -> string[] {
        return this.enumMemberNames;
    }

    public setMemberNames(string[] names) {
        this.enumMemberNames = names;
    }

    // A numeric enum assigns explicit integer values to its members and converts to and from
    // integers; a plain enum is a set of distinct names with no numeric identity.
    public isNumeric() -> bool {
        return this.numeric;
    }

    public setNumeric(bool value) {
        this.numeric = value;
    }

    public override kindWord() -> string {
        return "enum";
    }
}

public class ExternalType extends DeclaredType {
    protected constructor(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) {
        super(name, modulePath, packagePrefix, filePath, declaration, visibility, []);
    }

    override kindWord() -> string {
        return "external type";
    }
}

// A generic type parameter, interned by (declaring node, position). Bounds are resolved once,
// when the owning declaration's signature resolves.
public class TypeParamType extends Type {
    GreenNode owningDeclaration;
    long parameterIndex;
    string parameterName;
    Type[] parameterBounds;

    protected constructor(GreenNode owner, long index, string name) {
        this.owningDeclaration = owner;
        this.parameterIndex = index;
        this.parameterName = name;
        this.parameterBounds = [];
    }

    public owner() -> GreenNode {
        return this.owningDeclaration;
    }

    public index() -> long {
        return this.parameterIndex;
    }

    public name() -> string {
        return this.parameterName;
    }

    // The resolved bounds: interfaces plus at most one class.
    public bounds() -> Type[] {
        return this.parameterBounds;
    }

    public setBounds(Type[] bounds) {
        this.parameterBounds = bounds;
    }
}

// A reference to a generic type with its arguments, interned by (template, arguments) so equal
// references share one identity. The type store fills the members in place - the template's
// members with every type parameter replaced by the matching argument - once the template's own
// members are complete, so the interned object keeps its identity through filling.
public class InstantiationType extends Type {
    DeclaredType instantiationTemplate;
    Type[] instantiationArguments;
    bool membersFilled;
    Type? instantiationBase;
    Type[] instantiationInterfaces;
    List<Field> instantiationFields;
    long inheritedFieldCount;
    List<Method> instantiationMethods;

    protected constructor(DeclaredType template, Type[] arguments) {
        this.instantiationTemplate = template;
        this.instantiationArguments = arguments;
        this.membersFilled = false;
        this.instantiationInterfaces = [];
        this.instantiationFields = new List<Field>();
        this.inheritedFieldCount = 0;
        this.instantiationMethods = new List<Method>();
    }

    public template() -> DeclaredType {
        return this.instantiationTemplate;
    }

    public arguments() -> Type[] {
        return this.instantiationArguments;
    }

    name() -> string {
        return this.instantiationTemplate.name();
    }

    public isFilled() -> bool {
        return this.membersFilled;
    }

    protected setFilled() {
        this.membersFilled = true;
    }

    // The template's base with this instantiation's arguments applied; a generic base rebinds
    // to its own concrete instantiation.
    public base() -> Type? {
        return this.instantiationBase;
    }

    protected setBase(Type base) {
        this.instantiationBase = base;
    }

    protected interfaces() -> Type[] {
        return this.instantiationInterfaces;
    }

    protected setInterfaces(Type[] interfaces) {
        this.instantiationInterfaces = interfaces;
    }

    // Flattened like the template's: inherited fields first, own fields after.
    public fields() -> List<Field> {
        return this.instantiationFields;
    }

    public baseFieldCount() -> long {
        return this.inheritedFieldCount;
    }

    protected setBaseFieldCount(long count) {
        this.inheritedFieldCount = count;
    }

    public methods() -> List<Method> {
        return this.instantiationMethods;
    }
}

class DeclaredTypeKey {
    string keyModulePath;
    string keyName;

    protected constructor(string modulePath, string name) {
        this.keyModulePath = modulePath;
        this.keyName = name;
    }

    override hash() -> long {
        return this.keyModulePath.hash() * 31 + this.keyName.hash();
    }

    override equals(DeclaredTypeKey other) -> bool {
        return this.keyModulePath == other.keyModulePath && this.keyName == other.keyName;
    }
}

class TypeParamKey {
    GreenNode keyOwner;
    long keyIndex;

    protected constructor(GreenNode owner, long index) {
        this.keyOwner = owner;
        this.keyIndex = index;
    }

    override hash() -> long {
        return this.keyOwner.hash() * 31 + this.keyIndex;
    }

    override equals(TypeParamKey other) -> bool {
        return this.keyOwner == other.keyOwner && this.keyIndex == other.keyIndex;
    }
}

class InstantiationKey {
    DeclaredType keyTemplate;
    Type[] keyArguments;

    protected constructor(DeclaredType template, Type[] arguments) {
        this.keyTemplate = template;
        this.keyArguments = arguments;
    }

    override hash() -> long {
        long combined = this.keyTemplate.hash();
        for (let argument in this.keyArguments) {
            combined = combined * 31 + argument.hash();
        }
        return combined;
    }

    override equals(InstantiationKey other) -> bool {
        if (this.keyTemplate != other.keyTemplate) {
            return false;
        }
        if (this.keyArguments.length != other.keyArguments.length) {
            return false;
        }
        for (long i = 0; i < this.keyArguments.length; i++) {
            if (this.keyArguments[i] != other.keyArguments[i]) {
                return false;
            }
        }
        return true;
    }
}

// The single owner of every type object. All construction goes through it: primitives are interned
// by kind, optionals and arrays by their inner type's identity, declared types by (module path,
// name). Keep every mutation behind this API.
public class TypeStore {
    Map<PrimitiveKind, PrimitiveType> primitives;
    StringType internedString;
    NullType internedNull;
    ErrorType internedError;
    Map<Type, OptionalType> optionals;
    Map<Type, ArrayType> arrays;
    Map<DeclaredTypeKey, DeclaredType> declaredTypes;
    Map<TypeParamKey, TypeParamType> typeParameters;
    Map<InstantiationKey, InstantiationType> instantiations;
    List<InstantiationType> pendingFills;
    List<InstantiationType> instantiationChain;
    List<FileDiagnostic> instantiationOverflows;

    public constructor() {
        this.primitives = new Map<PrimitiveKind, PrimitiveType>();
        this.internedString = new StringType();
        this.internedNull = new NullType();
        this.internedError = new ErrorType();
        this.optionals = new Map<Type, OptionalType>();
        this.arrays = new Map<Type, ArrayType>();
        this.declaredTypes = new Map<DeclaredTypeKey, DeclaredType>();
        this.typeParameters = new Map<TypeParamKey, TypeParamType>();
        this.instantiations = new Map<InstantiationKey, InstantiationType>();
        this.pendingFills = new List<InstantiationType>();
        this.instantiationChain = new List<InstantiationType>();
        this.instantiationOverflows = new List<FileDiagnostic>();
    }

    public primitive(PrimitiveKind kind) -> PrimitiveType {
        let existing = this.primitives.get(kind);
        if (existing != null) {
            return existing;
        }
        let created = new PrimitiveType(kind);
        this.primitives.set(kind, created);
        return created;
    }

    public stringType() -> StringType {
        return this.internedString;
    }

    public nullType() -> NullType {
        return this.internedNull;
    }

    public errorType() -> ErrorType {
        return this.internedError;
    }

    // T?? collapses to T?, and an error stays an error so one diagnosis does not cascade.
    public optionalOf(Type inner) -> Type {
        if (inner is OptionalType) {
            return inner;
        }
        if (inner is ErrorType) {
            return inner;
        }
        let existing = this.optionals.get(inner);
        if (existing != null) {
            return existing;
        }
        let created = new OptionalType(inner);
        this.optionals.set(inner, created);
        return created;
    }

    public arrayOf(Type element) -> Type {
        if (element is ErrorType) {
            return element;
        }
        let existing = this.arrays.get(element);
        if (existing != null) {
            return existing;
        }
        let created = new ArrayType(element);
        this.arrays.set(element, created);
        return created;
    }

    public typeParameter(GreenNode owner, long index, string name) -> TypeParamType {
        let key = new TypeParamKey(owner, index);
        let existing = this.typeParameters.get(key);
        if (existing != null) {
            return existing;
        }
        let created = new TypeParamType(owner, index, name);
        this.typeParameters.set(key, created);
        return created;
    }

    // Interns the instantiation, registering the shell before filling so a self-referential
    // member (e.g. 'Node<T>? next') resolves back to this same instance. The members fill
    // immediately when the template's members are complete, and queue otherwise.
    public instantiationOf(DeclaredType template, Type[] arguments) -> InstantiationType {
        let key = new InstantiationKey(template, arguments);
        let existing = this.instantiations.get(key);
        if (existing != null) {
            return existing;
        }
        let created = new InstantiationType(template, arguments);
        this.instantiations.set(key, created);
        if (this.instantiationChain.length() >= maxInstantiationDepth()) {
            this.recordInstantiationOverflow();
            return created;
        }
        if (template.membersComplete()) {
            this.fill(created);
        } else {
            this.pendingFills.push(created);
        }
        return created;
    }

    // Every instantiation interned so far, open and concrete alike, in no particular order.
    public allInstantiations() -> InstantiationType[] {
        return this.instantiations.values();
    }

    // The diagnostics for instantiation chains that never terminate, cleared as they are taken.
    public takeInstantiationOverflows() -> FileDiagnostic[] {
        FileDiagnostic[] taken = this.instantiationOverflows.toArray();
        this.instantiationOverflows = new List<FileDiagnostic>();
        return taken;
    }

    recordInstantiationOverflow() {
        let root = this.instantiationChain.get(0);
        let firstNested = this.instantiationChain.get(1);
        let secondNested = this.instantiationChain.get(2);
        string rootName = display(root);
        string message = "Instantiating '" + rootName + "' never finishes: each instantiation "
            + "requires another ('" + rootName + "' needs '" + display(firstNested)
            + "', which needs '" + display(secondNested)
            + "', ...). Break the recursive type argument.";
        let template = root.template();
        this.instantiationOverflows.push(
            new FileDiagnostic(template.filePath(), message, overflowSpan(template)));
    }

    // Fills one queued instantiation early, for a base link the layout phase needs now.
    public ensureFilled(InstantiationType instantiation) {
        if (!instantiation.isFilled() && instantiation.template().membersComplete()) {
            this.fill(instantiation);
        }
    }

    // Fills every queued instantiation whose template's members are complete, to fixpoint:
    // filling can request further instantiations, which fill or queue in turn. Instantiations
    // of still-incomplete templates stay queued for the next call.
    public materializeFills() {
        bool progress = true;
        while (progress) {
            progress = false;
            let queue = this.pendingFills;
            this.pendingFills = new List<InstantiationType>();
            for (long i = 0; i < queue.length(); i++) {
                let pending = queue.get(i);
                if (pending.isFilled()) {
                    continue;
                }
                if (pending.template().membersComplete()) {
                    this.fill(pending);
                    progress = true;
                } else {
                    this.pendingFills.push(pending);
                }
            }
        }
    }

    // The type with the template's parameters replaced by the instantiation's arguments,
    // recursing through optionals, arrays, and nested instantiations. Types untouched by the
    // substitution keep their identity.
    public substitute(Type type, GreenNode owner, Type[] arguments) -> Type {
        switch (type) {
            is TypeParamType parameter -> {
                if (parameter.owner() == owner && parameter.index() < arguments.length) {
                    return arguments[parameter.index()];
                }
                return parameter;
            },
            is OptionalType optional -> {
                return this.optionalOf(this.substitute(optional.inner(), owner, arguments));
            },
            is ArrayType array -> {
                return this.arrayOf(this.substitute(array.element(), owner, arguments));
            },
            is InstantiationType nested -> {
                return this.instantiationOf(nested.template(),
                    this.substituteAll(nested.arguments(), owner, arguments));
            },
            default -> {
                return type;
            },
        }
    }

    substituteAll(Type[] typeList, GreenNode owner, Type[] arguments) -> Type[] {
        let substituted = new List<Type>();
        for (let entry in typeList) {
            substituted.push(this.substitute(entry, owner, arguments));
        }
        return substituted.toArray();
    }

    fill(InstantiationType instantiation) {
        this.instantiationChain.push(instantiation);
        let template = instantiation.template();
        Type[] arguments = instantiation.arguments();
        GreenNode owner = template.declaration();
        switch (template) {
            is ClassType classTemplate -> {
                let base = classTemplate.base();
                if (base != null) {
                    instantiation.setBase(this.substitute(base, owner, arguments));
                }
                instantiation.setInterfaces(
                    this.substituteAll(classTemplate.interfaces(), owner, arguments));
                this.fillFields(instantiation, classTemplate.fields(), owner, arguments);
                instantiation.setBaseFieldCount(classTemplate.baseFieldCount());
                this.fillMethods(instantiation, classTemplate.methods(), owner, arguments);
            },
            is StructType structTemplate -> {
                this.fillFields(instantiation, structTemplate.fields(), owner, arguments);
                this.fillMethods(instantiation, structTemplate.methods(), owner, arguments);
            },
            is InterfaceType interfaceTemplate -> {
                this.fillMethods(instantiation, interfaceTemplate.methods(), owner, arguments);
            },
            default -> { },
        }
        instantiation.setFilled();
        this.instantiationChain.pop();
    }

    fillFields(InstantiationType instantiation, List<Field> templateFields,
                       GreenNode owner, Type[] arguments) {
        for (long i = 0; i < templateFields.length(); i++) {
            let field = templateFields.get(i);
            instantiation.fields().push(new Field(field.name(),
                this.substitute(field.type(), owner, arguments), field.visibility(),
                field.isWeak(), field.hasDefault(), field.nameSpan(), instantiation));
        }
    }

    fillMethods(InstantiationType instantiation, List<Method> templateMethods,
                        GreenNode owner, Type[] arguments) {
        for (long i = 0; i < templateMethods.length(); i++) {
            let method = templateMethods.get(i);
            let signature = this.substituteSignature(method.signature(), owner, arguments);
            instantiation.methods().push(new Method(signature, method.visibility(),
                method.isConstructor(), method.isDestructor(), method.isOverride(),
                method.isFinal(), method.isAbstract(), method.hasBody(), instantiation));
        }
    }

    substituteSignature(Signature signature, GreenNode owner, Type[] arguments)
            -> Signature {
        let parameters = new List<Parameter>();
        for (let parameter in signature.parameters()) {
            parameters.push(new Parameter(parameter.name(),
                this.substitute(parameter.type(), owner, arguments), parameter.bindsField(),
                parameter.isOut(), parameter.hasDefault(), parameter.span()));
        }
        return new Signature(signature.name(), parameters.toArray(),
            this.substitute(signature.returnType(), owner, arguments),
            signature.declaresThrows(), signature.isNoreturn(),
            this.substituteAll(signature.throwsTypes(), owner, arguments),
            signature.throwsTypeSpans(), signature.typeParameters(),
            signature.declaration(), signature.nameSpan());
    }

    public findDeclared(string modulePath, string name) -> DeclaredType? {
        return this.declaredTypes.get(new DeclaredTypeKey(modulePath, name));
    }

    public hasDeclared(string modulePath, string name) -> bool {
        return this.declaredTypes.contains(new DeclaredTypeKey(modulePath, name));
    }

    public addClass(string name, string modulePath, string packagePrefix, string filePath,
             GreenNode declaration, Visibility visibility, string[] typeParameters,
             bool isAbstract, bool isFinal, bool isSealed) -> ClassType {
        let created = new ClassType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters, isAbstract, isFinal, isSealed);
        this.add(created);
        return created;
    }

    public addInterface(string name, string modulePath, string packagePrefix, string filePath,
                 GreenNode declaration, Visibility visibility, string[] typeParameters)
            -> InterfaceType {
        let created = new InterfaceType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters);
        this.add(created);
        return created;
    }

    public addStruct(string name, string modulePath, string packagePrefix, string filePath,
              GreenNode declaration, Visibility visibility, string[] typeParameters)
            -> StructType {
        let created = new StructType(name, modulePath, packagePrefix, filePath, declaration,
            visibility, typeParameters);
        this.add(created);
        return created;
    }

    public addEnum(string name, string modulePath, string packagePrefix, string filePath,
            GreenNode declaration, Visibility visibility) -> EnumType {
        let created = new EnumType(name, modulePath, packagePrefix, filePath, declaration,
            visibility);
        this.add(created);
        return created;
    }

    public addExternal(string name, string modulePath, string packagePrefix, string filePath,
                GreenNode declaration, Visibility visibility) -> ExternalType {
        let created = new ExternalType(name, modulePath, packagePrefix, filePath, declaration,
            visibility);
        this.add(created);
        return created;
    }

    add(DeclaredType created) {
        let key = new DeclaredTypeKey(created.modulePath(), created.name());
        if (this.declaredTypes.contains(key)) {
            panic("Internal: type '{created.name()}' is already declared in module "
                + "'{created.modulePath()}'");
        }
        this.declaredTypes.set(key, created);
    }
}

// The instantiation nesting a well-formed program stays far below; a chain that reaches it is a
// polymorphically recursive template that would never terminate.
maxInstantiationDepth() -> long {
    return 200;
}

// The span of the field whose type re-enters the template, so the diagnostic points at the
// recursive reference; the template's start otherwise.
overflowSpan(DeclaredType template) -> Span {
    let fields = fieldsOf(template);
    if (fields != null) {
        for (long i = 0; i < fields.length(); i++) {
            let field = fields.get(i);
            if (referencesTemplate(field.type(), template)) {
                return field.nameSpan();
            }
        }
    }
    return source.makeSpan(0, 0);
}

referencesTemplate(Type type, DeclaredType template) -> bool {
    switch (type) {
        is OptionalType optional -> {
            return referencesTemplate(optional.inner(), template);
        },
        is ArrayType array -> {
            return referencesTemplate(array.element(), template);
        },
        is InstantiationType instantiation -> {
            if (instantiation.template() == template) {
                return true;
            }
            for (let argument in instantiation.arguments()) {
                if (referencesTemplate(argument, template)) {
                    return true;
                }
            }
            return false;
        },
        default -> {
            return false;
        },
    }
}

// The type as it reads in a diagnostic: 'int', 'Box<string>?', 'T[]'.
public display(Type type) -> string {
    switch (type) {
        is PrimitiveType primitive -> {
            return primitiveName(primitive.kind());
        },
        is StringType ignored -> {
            return "string";
        },
        is NullType ignored -> {
            return "null";
        },
        is ErrorType ignored -> {
            return "<error>";
        },
        is OptionalType optional -> {
            return display(optional.inner()) + "?";
        },
        is ArrayType array -> {
            return display(array.element()) + "[]";
        },
        is DeclaredType declared -> {
            return declared.name();
        },
        is TypeParamType parameter -> {
            return parameter.name();
        },
        is InstantiationType instantiation -> {
            let builder = new StringBuilder();
            builder.append(instantiation.template().name());
            builder.append("<");
            Type[] arguments = instantiation.arguments();
            for (long i = 0; i < arguments.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append(display(arguments[i]));
            }
            builder.append(">");
            return builder.toString();
        },
    }
}

public primitiveName(PrimitiveKind kind) -> string {
    return switch (kind) {
        Bool -> "bool",
        Byte -> "byte",
        Short -> "short",
        UShort -> "ushort",
        Int -> "int",
        UInt -> "uint",
        Long -> "long",
        ULong -> "ulong",
        Float -> "float",
        Double -> "double",
        Decimal -> "decimal",
        Char -> "char",
        Void -> "void",
    };
}

public isVoidType(Type type) -> bool {
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Void;
    }
    return false;
}

// True for the reference types that participate in inheritance and conformance: classes,
// interfaces, and instantiations of generic classes or interfaces.
public isClassLike(Type type) -> bool {
    if (type is ClassType || type is InterfaceType) {
        return true;
    }
    if (type is InstantiationType) {
        let template = type.template();
        return template is ClassType || template is InterfaceType;
    }
    return false;
}

public isInterfaceLike(Type type) -> bool {
    if (type is InterfaceType) {
        return true;
    }
    if (type is InstantiationType) {
        return type.template() is InterfaceType;
    }
    return false;
}

// The declared type that speaks for a reference in inheritance walks: an instantiation defers
// to its template until its members are filled.
public authorityOf(Type type) -> DeclaredType? {
    switch (type) {
        is DeclaredType declared -> {
            return declared;
        },
        is InstantiationType instantiation -> {
            return instantiation.template();
        },
        default -> {
            return null;
        },
    }
}

// The fields a type stores, or null for types without fields. A filled instantiation exposes
// its substituted fields; an unfilled one has none to expose yet.
public fieldsOf(Type type) -> List<Field>? {
    switch (type) {
        is ClassType classType -> {
            return classType.fields();
        },
        is StructType structType -> {
            return structType.fields();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.fields();
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

// The number of leading fields a flattened layout inherits from its base class. Zero for any
// type without a base, so own fields are those at this index and after.
public baseFieldCount(Type type) -> long {
    switch (type) {
        is ClassType classType -> {
            return classType.baseFieldCount();
        },
        is InstantiationType instantiation -> {
            return instantiation.baseFieldCount();
        },
        default -> {
            return 0;
        },
    }
}

// The methods a type declares itself, or null for types without methods.
public methodsOf(Type type) -> List<Method>? {
    switch (type) {
        is ClassType classType -> {
            return classType.methods();
        },
        is StructType structType -> {
            return structType.methods();
        },
        is InterfaceType interfaceType -> {
            return interfaceType.methods();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.methods();
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

// The next link of the inheritance chain. A filled instantiation continues through its rebound
// base; an unfilled one falls back to its template's base.
public baseOf(Type type) -> Type? {
    switch (type) {
        is ClassType classType -> {
            return classType.base();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.base();
            }
            let template = instantiation.template();
            if (template is ClassType) {
                return template.base();
            }
            return null;
        },
        default -> {
            return null;
        },
    }
}

// The interfaces a type's own 'implements' clause names, substituted once it is filled.
public interfacesOf(Type type) -> Type[] {
    switch (type) {
        is ClassType classType -> {
            return classType.interfaces();
        },
        is InstantiationType instantiation -> {
            if (instantiation.isFilled()) {
                return instantiation.interfaces();
            }
            let template = instantiation.template();
            if (template is ClassType) {
                return template.interfaces();
            }
            return [];
        },
        default -> {
            return [];
        },
    }
}

// True when derived is ancestor or reaches it through its base chain.
public isSubclassOf(Type derived, Type ancestor) -> bool {
    let seen = new Set<Type>();
    Type? current = derived;
    while (current != null && seen.add(current)) {
        if (current == ancestor) {
            return true;
        }
        let declared = authorityOf(current);
        if (declared == null) {
            return false;
        }
        if (declared == ancestor) {
            return true;
        }
        current = baseOf(current);
    }
    return false;
}

// True when source is the interface itself or a class in source's chain implements it.
public conformsTo(Type source, Type interfaceType) -> bool {
    if (source == interfaceType) {
        return true;
    }
    let seen = new Set<Type>();
    Type? current = source;
    while (current != null && seen.add(current)) {
        let declared = authorityOf(current);
        if (declared == null) {
            return false;
        }
        if (declared == interfaceType) {
            return true;
        }
        for (let implemented in interfacesOf(current)) {
            if (implemented == interfaceType) {
                return true;
            }
        }
        current = baseOf(current);
    }
    return false;
}

public isSubclassOrConforms(Type source, Type target) -> bool {
    if (isInterfaceLike(target)) {
        return conformsTo(source, target);
    }
    return isSubclassOf(source, target);
}

// Lossless primitive widening, the implicit numeric conversion the language allows.
public widensTo(Type from, Type to) -> bool {
    if (from is PrimitiveType && to is PrimitiveType) {
        return kindWidensTo(from.kind(), to.kind());
    }
    return false;
}

kindWidensTo(PrimitiveKind from, PrimitiveKind to) -> bool {
    if (from == to) {
        return false;
    }
    if (isIntegerKind(from) && isIntegerKind(to)) {
        long fromWidth = integerBitWidth(from);
        long toWidth = integerBitWidth(to);
        if (isSignedKind(from)) {
            return isSignedKind(to) && toWidth > fromWidth;
        }
        return toWidth > fromWidth;
    }
    if (isIntegerKind(from) && isFloatKind(to)) {
        long mantissa = 53;
        if (floatBitWidth(to) == 32) {
            mantissa = 24;
        }
        return integerBitWidth(from) <= mantissa;
    }
    if (isFloatKind(from) && isFloatKind(to)) {
        return floatBitWidth(from) < floatBitWidth(to);
    }
    return false;
}

isIntegerKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Byte, Short, UShort, Int, UInt, Long, ULong, Char -> true,
        default -> false,
    };
}

isSignedKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Short, Int, Long -> true,
        default -> false,
    };
}

isFloatKind(PrimitiveKind kind) -> bool {
    return switch (kind) {
        Float, Double, Decimal -> true,
        default -> false,
    };
}

integerBitWidth(PrimitiveKind kind) -> long {
    return switch (kind) {
        Byte -> 8,
        Short, UShort -> 16,
        Int, UInt, Char -> 32,
        Long, ULong -> 64,
        default -> 0,
    };
}

floatBitWidth(PrimitiveKind kind) -> long {
    return switch (kind) {
        Float -> 32,
        Double -> 64,
        default -> 0,
    };
}

// Whether an override's return type may stand in for the base declaration's: the same type, a
// lossless widening, a subclass or conforming class, or the non-null form of an optional.
public overrideReturnCompatible(Type base, Type derived) -> bool {
    if (base is ErrorType || derived is ErrorType) {
        return true;
    }
    if (base == derived) {
        return true;
    }
    if (widensTo(derived, base)) {
        return true;
    }
    if (isClassLike(base) && isClassLike(derived) && isSubclassOrConforms(derived, base)) {
        return true;
    }
    if (base is OptionalType) {
        let inner = base.inner();
        if (derived is NullType) {
            return true;
        }
        if (inner == derived || widensTo(derived, inner)) {
            return true;
        }
        Type bare = derived;
        if (derived is OptionalType) {
            bare = derived.inner();
        }
        if (inner == bare) {
            return true;
        }
        if (isClassLike(inner) && isClassLike(bare) && isSubclassOrConforms(bare, inner)) {
            return true;
        }
    }
    return false;
}
