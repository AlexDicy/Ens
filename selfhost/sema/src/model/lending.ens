// Values the standard library lends a body for as long as that body runs, which nothing may keep
// longer: the 'Slice' and the 'ReadView' of '@std.parallel'. A value of such a type can be a
// parameter or a local and can be passed to a call. It can be nothing that could outlive the call:
// a field, an array element, a type argument, the result of a function, or a lambda's capture.
import model.typenames;
import TypeNames from model.typenames;
import Type from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import ClassType from model.types;
import InstantiationType from model.types;
import ThrownListType from model.types;

// Whether `type` is a lent type itself, with no nullable level around it.
public isLent(Type type) -> bool {
    Type core = type;
    if (core is InstantiationType) {
        core = core.template();
    }
    return core is ClassType && core.modulePath() == "std.parallel"
        && (core.name() == "Slice" || core.name() == "ReadView");
}

// The lent type `type` holds where a value of it could outlive the body it was lent to, or null
// where it holds none. A lent type is such a place itself, behind a nullable level or not, unless
// `topAllowed`, as it is for a parameter or a local. Inside a type, an array element, a type
// argument and the result of a function are such places, and a parameter of a function is not.
public escapingLent(Type type, bool topAllowed) -> Type? {
    switch (type) {
        is OptionalType optional -> {
            return escapingLent(optional.inner(), topAllowed);
        },
        is ArrayType array -> {
            return escapingLent(array.element(), false);
        },
        is FunctionType function -> {
            return escapingLent(function.returnType(), false);
        },
        is InstantiationType instantiation -> {
            if (isLent(instantiation)) {
                return topAllowed ? null : instantiation;
            }
            for (let argument in instantiation.arguments()) {
                let found = escapingLent(argument, false);
                if (found != null) {
                    return found;
                }
            }
            return null;
        },
        is ThrownListType listed -> {
            return null;
        },
        default -> {
            return null;
        },
    }
}

// Why nothing may keep a value of the lent type `lent`, as a clause with `subject` for its subject:
// "it is part of an array lent to one body of a 'parallel.split' call only until that body
// returns".
public lentReason(Type lent, TypeNames names, string subject) -> string {
    Type core = lent;
    if (core is InstantiationType) {
        core = core.template();
    }
    if (core is ClassType && core.name() == "ReadView") {
        return "{subject} is an array lent to one body of a 'parallel.split' call only until that "
            + "body returns";
    }
    return "{subject} is part of an array lent to one body of a 'parallel.split' call only until "
        + "that body returns";
}

// The fix that passes a value of the lent type `lent` on the one way it can go, as a sentence: "Pass
// it only to parameters written with its own type, as in 'Slice<int> slice'."
public parameterFix(Type lent, TypeNames names) -> string {
    string name = "slice";
    Type core = lent;
    if (core is InstantiationType) {
        core = core.template();
    }
    if (core is ClassType && core.name() == "ReadView") {
        name = "view";
    }
    return "Pass it only to parameters written with its own type, as in "
        + "'{names.of(lent)} {name}'.";
}

// A value of the lent type `lent` as a sentence names it, with its article: "a 'Slice<int>'".
public lentArticle(Type lent, TypeNames names) -> string {
    return "{typenames.typeArticle(names.of(lent))} {names.quoted(lent)}";
}

public capitalized(string text) -> string {
    return "{text.substring(0, 1).toUpperAscii()}{text.substring(1)}";
}
