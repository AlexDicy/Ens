// What checking one lambda against its target type produced: the shape its body was checked as,
// the function type it is checked against, and the values its body reads from the enclosing scope. A
// lambda copies each captured value when it is created, so every later phase reads it by position.
import LocalBinding from model.scopes;
import Signature from model.typemembers;
import Field from model.typemembers;
import Type from model.types;

// One value a lambda copies out of the enclosing scope. A capture that names no binding is the
// enclosing receiver: 'this', copied like any other reference. One that names a field copies that
// 'const' field of the receiver, which the lambda then reads through the binding.
export class LambdaCapture {
    LocalBinding? capturedBinding;
    Type capturedType;
    Field? copiedField;

    public constructor(LocalBinding? binding, Type type, Field? field = null) {
        this.capturedBinding = binding;
        this.capturedType = type;
        this.copiedField = field;
    }

    export field() -> Field? {
        return this.copiedField;
    }

    export binding() -> LocalBinding? {
        return this.capturedBinding;
    }

    export type() -> Type {
        return this.capturedType;
    }

    export isReceiver() -> bool {
        return this.capturedBinding == null;
    }
}

export class LambdaInfo {
    Signature lambdaSignature;
    Type lambdaType;
    LambdaCapture[] lambdaCaptures;

    public constructor(Signature signature, Type type, LambdaCapture[] captures) {
        this.lambdaSignature = signature;
        this.lambdaType = type;
        this.lambdaCaptures = captures;
    }

    // The lambda's own parameters, named as the source wrote them, and the return type its
    // target gave it. It never throws.
    export signature() -> Signature {
        return this.lambdaSignature;
    }

    export type() -> Type {
        return this.lambdaType;
    }

    export captures() -> LambdaCapture[] {
        return this.lambdaCaptures;
    }
}
