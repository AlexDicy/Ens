// Why a type lacks what a use of it needs: a text form, a meaningful type test, '==', 'hash',
// a member, a valid key, a JSON form, or a valid value for a new array slot.
import model.convert;
import model.hierarchy;
import model.typemembers;
import model.typenames;
import TypeNames from model.typenames;
import model.types;
import Type from model.types;
import DeclaredType from model.types;
import InstantiationType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import ClassType from model.types;
import ExternalType from model.types;
import ErrorType from model.types;
import TypeParamType from model.types;
import StringType from model.types;
import PrimitiveType from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;
import Set from @std.collections.set;

// How a refusal opens. The line that wrote the refused code reads 'Cannot', while a reader who
// only handed a generic a type argument reads the instantiation they wrote. Every refusal below
// takes 'instantiation' as "" for the first reader and as the quoted display for the second.
refusalSubject(string instantiation) -> string {
    if (instantiation.length == 0) {
        return "Cannot";
    }
    return "{instantiation} cannot";
}

// The fix a reader can act on. 'written' is for whoever wrote the refused code, and 'supplied'
// for whoever only chose the type argument that made it illegal.
suggestedFix(string instantiation, string written, string supplied) -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return supplied;
}

// The refusal followed by its fix, when there is one.
withFix(string refusal, string fix) -> string {
    if (fix.length == 0) {
        return refusal;
    }
    return "{refusal} {fix}";
}

// What a reader passes instead of a type argument nullable at more than one level, naming the
// shape one level shallower.
oneLevelArgumentFix(OptionalType nested, TypeNames names) -> string {
    return "Pass a type argument nullable at one level at most, such as "
        + "{names.quoted(nested.inner())}.";
}

// What a struct holding a floating-point field declares to get its hash back, and what the pair
// then guarantees. 'opening' leads into the struct's quoted name and differs by reader.
floatPairAdvice(string opening, string quotedOwner) -> string {
    return "{opening} {quotedOwner} its own 'equals' and 'hash', comparing each floating-point field "
        + "with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as long'.";
}

// What a text form is asked for by: a value in an interpolation hole, or a call to 'toString'.
public enum TextUse {
    Interpolation,
    ToStringCall,
}

// How a refusal of a text form opens, naming what asked for the text.
textRefusalSubject(string instantiation, TextUse use) -> string {
    string attempt = switch (use) {
        Interpolation -> "interpolate",
        ToStringCall -> "call 'toString' on",
    };
    return refusalSubject(instantiation) + " " + attempt;
}

// The advice to take the text a different way, opening with the verb the use asks for.
textAdvice(TextUse use, string interpolated, string called) -> string {
    return switch (use) {
        Interpolation -> interpolated,
        ToStringCall -> called,
    };
}

// The note beside a refusal earned by a type argument, naming the generic and what its own line
// does with the value.
public textUseNote(string owner, TextUse use, string quotedType) -> string {
    string action = switch (use) {
        Interpolation -> "interpolates",
        ToStringCall -> "calls 'toString' on",
    };
    return "{owner} {action} a value of type {quotedType} here";
}

// What asked a value for its text: the use, the instantiation a reader wrote when the use is
// inside a generic body, the null guidance for a value with several '?', and the value as written
// when it is short enough to quote in an example.
class TextRequest {
    string requestInstantiation;
    TextUse requestUse;
    string requestUnwrap;
    string requestSpelling;

    protected constructor(this.requestInstantiation, this.requestUse, this.requestUnwrap,
                          this.requestSpelling);

    protected instantiation() -> string {
        return this.requestInstantiation;
    }

    protected use() -> TextUse {
        return this.requestUse;
    }

    protected unwrap() -> string {
        return this.requestUnwrap;
    }

    protected spelling() -> string {
        return this.requestSpelling;
    }

    // How a refusal of this request opens, up to the type it names.
    protected subject() -> string {
        return textRefusalSubject(this.requestInstantiation, this.requestUse);
    }
}

// Why a value of this type cannot fill an interpolation hole, or null when it can. 'unwrap' is the
// null guidance for a hole whose type has more than one '?', and 'spelled' is the hole as written
// when it is short enough to quote in an example, or "".
public interpolationIssue(Type analyzed, TypeNames names, string unwrap = "", string spelled = "")
        -> string? {
    let request = new TextRequest("", TextUse.Interpolation, unwrap, spelled);
    return textIssueOf(request, analyzed, analyzed, names);
}

// Why a value of this type has no text for a 'toString()' call written on it, or null when it has.
// 'spelled' is the value the call is written on when it is short enough to quote, or "".
public toStringCallIssue(Type analyzed, TypeNames names, string spelled) -> string? {
    let request = new TextRequest("", TextUse.ToStringCall, "", spelled);
    return textIssueOf(request, analyzed, analyzed, names);
}

// The same judgment for a use inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public textIssue(string instantiation, TextUse use, Type analyzed, TypeNames names) -> string? {
    return textIssueOf(new TextRequest(instantiation, use, "", ""), analyzed, analyzed, names);
}

// 'shown' is the type the use was asked of, which every refusal names, and 'judged' is what decides
// whether there is any text to print: for a nullable value that is its payload, since one level
// prints the payload's text or 'null'.
textIssueOf(TextRequest request, Type shown, Type judged, TypeNames names) -> string? {
    string instantiation = request.instantiation();
    if (isJsonableLeaf(judged)) {
        return null;
    }
    if (types.isStructLike(judged)) {
        if (typemembers.declaredToString(judged) != null) {
            return null;
        }
        return structTextIssue(request, shown, judged, names);
    }
    if (types.isClassLike(judged)) {
        return null;
    }
    if (judged is ArrayType) {
        return arrayTextIssue(request, shown, judged, names);
    }
    if (judged is FunctionType) {
        return request.subject() + " a value of type {names.quoted(shown)}: a function value has "
            + "no text form. " + suggestedFix(instantiation,
                "Interpolate what the function returns, or a name you keep beside it.",
                "Pass a name you keep beside the function, or a type argument that has a text "
                    + "form.");
    }
    // One optional level prints the value's text or 'null', so what it wraps decides. A second
    // level has no text of its own: two absent levels would both read 'null'.
    if (judged is OptionalType) {
        if (judged.inner() is OptionalType) {
            return withFix(request.subject() + " a value of type {names.quoted(shown)}, because "
                + "it may be null at more than one level.",
                suggestedFix(instantiation, request.unwrap(), oneLevelArgumentFix(judged, names)));
        }
        return textIssueOf(request, shown, judged.inner(), names);
    }
    string reason = "a value of type {names.quoted(judged)} has no text form";
    if (judged is ExternalType) {
        reason = "an external type has no text form";
    }
    return request.subject() + " a value of type {names.quoted(shown)}: {reason}. "
        + suggestedFix(instantiation, "Interpolate a value you keep beside it instead.",
            "Pass a type argument that has a text form, or the text you want instead.");
}

// The innermost element type an array bottoms out at, through nested arrays and the elements'
// nullable wrappers.
innermostElementOf(ArrayType array) -> Type {
    Type element = convert.coreOf(array.element());
    while (element is ArrayType) {
        element = convert.coreOf(element.element());
    }
    return element;
}

// Why a value of this array type has no text form, or null when it does. Elements format as struct
// serialization writes them, so a struct element is its JSON form even with its own 'toString'.
arrayTextIssue(TextRequest request, Type shown, ArrayType array, TypeNames names) -> string? {
    string instantiation = request.instantiation();
    Type element = innermostElementOf(array);
    if (convert.containsTypeParam(element)) {
        return null;
    }
    if (isJsonableLeaf(element) || types.isClassLike(element)) {
        return null;
    }
    if (types.isStructLike(element)) {
        return arrayStructTextIssue(request, shown, array, element, names);
    }
    if (element is FunctionType) {
        return request.subject() + " a value of type {names.quoted(shown)}: its elements are "
            + "function values, which have no text form. " + suggestedFix(instantiation,
                textAdvice(request.use(), "Interpolate names you keep beside the functions instead.",
                    "Use names you keep beside the functions instead."),
                "Pass a type argument whose elements have a text form, such as names you keep "
                    + "beside the functions.");
    }
    string elements = "its elements have type {names.quoted(element)}";
    if (element is ExternalType) {
        elements = "its elements have the external type {names.quoted(element)}";
    }
    return request.subject() + " a value of type {names.quoted(shown)}: {elements}, which has no "
        + "text form. " + suggestedFix(instantiation,
            textAdvice(request.use(), "Interpolate a value you keep beside the elements instead.",
                "Call 'toString' on a value you keep beside the elements instead."),
            "Pass a type argument whose elements have a text form.");
}

// A value type, string, or enum that has a direct JSON form.
isJsonableLeaf(Type type) -> bool {
    if (convert.isIntegerType(type) || convert.isBoolType(type) || convert.isEnumLike(type)) {
        return true;
    }
    if (type is StringType) {
        return true;
    }
    if (type is PrimitiveType) {
        return type.kind() == PrimitiveKind.Float || type.kind() == PrimitiveKind.Double;
    }
    return false;
}

// Why 'is' or 'as?' between these concrete types is malformed, always true, or never true, or null
// when the test is meaningful. 'unwrap' is the null guidance for a tested value with several '?'.
public typeTestIssue(Type source, Type target, bool isCast, TypeNames names,
                     string unwrap = "") -> string? {
    return typeTestIssueOf("", source, target, isCast, unwrap, names);
}

// The same judgment for a test inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public typeTestIssue(string instantiation, Type source, Type target, bool isCast,
                     TypeNames names) -> string? {
    return typeTestIssueOf(instantiation, source, target, isCast, "", names);
}

// The refusal of 'is' or 'as?' on 'source' when it has two levels of null, of which the test checks
// one, with 'unwrap' as the fix the value has. Null for a source with one level or none.
public twoLevelTestIssue(Type source, bool isCast, TypeNames names, string unwrap) -> string? {
    return twoLevelIssueOf("", source, isCast, unwrap, names);
}

twoLevelIssueOf(string instantiation, Type source, bool isCast, string unwrap, TypeNames names) -> string? {
    if (!(source is OptionalType) || !(source.inner() is OptionalType)) {
        return null;
    }
    string operator = "is";
    if (isCast) {
        operator = "as?";
    }
    return withFix(refusalSubject(instantiation) + " use '{operator}' on a value of type "
        + "{names.quoted(source)}, because '{operator}' checks for only one level of null.",
        suggestedFix(instantiation, unwrap, oneLevelArgumentFix(source, names)));
}

typeTestIssueOf(string instantiation, Type source, Type target, bool isCast, string unwrap,
                TypeNames names) -> string? {
    string operator = "is";
    if (isCast) {
        operator = "as?";
    }
    // A written target is always a class or an interface, so these two arise only through a
    // type parameter's instantiation.
    if (target is OptionalType) {
        if (instantiation.length > 0) {
            return "{instantiation} cannot use '{operator}' against "
                + "{names.quoted(target)}: it is nullable, and '{operator}' never matches "
                + "null. Pass a type argument that is not nullable, such as "
                + "{names.quoted(convert.coreOf(target))}.";
        }
        return "The type after '{operator}' is {names.quoted(target)}, which is nullable, and "
            + "'{operator}' never matches null. Test against "
            + "{names.quoted(convert.coreOf(target))} instead.";
    }
    if (!types.isClassLike(target)) {
        if (instantiation.length > 0) {
            return "{instantiation} cannot use '{operator}' against "
                + "{names.quoted(target)}: only a class or an interface can be tested at run "
                + "time. Pass a class or an interface as the type argument.";
        }
        return "The type after '{operator}' is {names.quoted(target)}, and only a class or an "
            + "interface can be tested with '{operator}'. Test against a class or an interface, "
            + "or remove the test.";
    }
    let twoLevels = twoLevelIssueOf(instantiation, source, isCast, unwrap, names);
    if (twoLevels != null) {
        return twoLevels;
    }
    Type sourceCore = convert.bareOf(source);
    if (!types.isClassLike(sourceCore)) {
        string action = "tested";
        string removal = "test";
        if (isCast) {
            action = "cast";
            removal = "cast";
        }
        string refused = refusalSubject(instantiation) + " use '{operator}' on a value of type "
            + "{names.quoted(source)}, because only a class value can be {action} with "
            + "'{operator}'.";
        string kind = types.valueKindWord(sourceCore);
        if (kind.length > 0 && types.isInterfaceLike(target) && hierarchy.conformsTo(sourceCore, target)) {
            string sourceName = names.quoted(sourceCore);
            string targetName = names.quoted(target);
            refused = refused + " {sourceName} implements {targetName}, but a {kind} value is "
                + "never a class instance.";
            if (instantiation.length > 0) {
                return refused + " Pass a class that implements {targetName} instead.";
            }
            return refused + " Remove the {removal}, because every {sourceName} implements {targetName}.";
        }
        if (instantiation.length > 0) {
            return refused + " Pass a class as the type argument instead.";
        }
        return refused;
    }
    if (hierarchy.isSubclassOrConforms(sourceCore, target)) {
        if (!isCast && source is OptionalType) {
            return null;
        }
        if (isCast) {
            if (instantiation.length > 0) {
                return "{instantiation} casts a value of type {names.quoted(source)} to "
                    + "{names.quoted(target)}, which it always is. Use the value directly, or a "
                    + "type argument for which the cast can fail.";
            }
            string cast = names.quotedCode(["as? ", ""], [target]);
            return "{cast} is not needed here: a value of type {names.quoted(source)} always "
                + "converts to {names.quotedNullable(target)}. Use the value directly.";
        }
        if (instantiation.length > 0) {
            return "{instantiation} tests a value of type {names.quoted(source)} against "
                + "{names.quoted(target)}, which it always is, so the test is always true. Use a "
                + "type argument for which it can be false.";
        }
        return "A value of type {names.quoted(source)} is always {articled(target, names)}, so this "
            + "'is' test is always true.";
    }
    if (types.isInterfaceLike(sourceCore)) {
        return null;
    }
    if (types.isInterfaceLike(target)) {
        if (isFinalClass(sourceCore)) {
            if (instantiation.length > 0) {
                return "{instantiation} " + testsAgainst(source, target, isCast, names)
                    + ", which it can never be: "
                    + "{names.quoted(sourceCore)} is 'final' and does not "
                    + "implement it, so " + neverOutcome(isCast)
                    + " Use a type argument for which the test can be true or false.";
            }
            string outcome = "This 'is' test is always false.";
            if (isCast) {
                outcome = "This 'as?' cast always gives null.";
            }
            return "A value of type {names.quoted(source)} is never {articled(target, names)}: "
                + "{names.quoted(sourceCore)} does not implement {names.quoted(target)}, and because it "
                + "is 'final', no class extends it. {outcome}";
        }
        return null;
    }
    if (!hierarchy.isSubclassOf(target, sourceCore)) {
        if (instantiation.length > 0) {
            return "{instantiation} " + testsAgainst(source, target, isCast, names)
                + ", which it can never be, so " + neverOutcome(isCast)
                + " Use a type argument for which the test can be true or false.";
        }
        string outcome = "this 'is' test is always false.";
        if (isCast) {
            outcome = "this 'as?' cast always gives null.";
        }
        return "{names.quoted(target)} does not extend {names.quoted(sourceCore)}, so a value of type "
            + "{names.quoted(source)} is never {articled(target, names)}, and {outcome}";
    }
    return null;
}

// The type quoted after "a" or "an", as in "an 'Animal'".
articled(Type type, TypeNames names) -> string {
    return "{typenames.typeArticle(names.of(type))} {names.quoted(type)}";
}

// What a generic's own line does with the two types, as a refusal reported elsewhere retells it.
testsAgainst(Type source, Type target, bool isCast, TypeNames names) -> string {
    if (isCast) {
        return "casts a value of type {names.quoted(source)} to "
            + "{names.quoted(target)}";
    }
    return "tests a value of type {names.quoted(source)} against "
        + "{names.quoted(target)}";
}

// What a test that can never pass would produce.
neverOutcome(bool isCast) -> string {
    if (isCast) {
        return "the cast would always be null.";
    }
    return "the test would always be false.";
}

isFinalClass(Type type) -> bool {
    let authority = types.authorityOf(type);
    if (authority is ClassType) {
        return authority.isFinal();
    }
    return false;
}

// Why values of this struct or array type cannot be compared with '==', or null when they can.
// Names the offending field's dotted path and its type.
public equalityComparabilityIssue(Type structType, TypeNames names) -> string? {
    return equalityComparabilityIssueOf("", structType, names);
}

// The same judgment for a '==' inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public equalityComparabilityIssue(string instantiation, Type structType, TypeNames names)
        -> string? {
    return equalityComparabilityIssueOf(instantiation, structType, names);
}

equalityComparabilityIssueOf(string instantiation, Type structType, TypeNames names)
        -> string? {
    if (structType is ArrayType) {
        Type leaf = innermostElementOf(structType);
        if (convert.containsTypeParam(leaf)) {
            return null;
        }
        if (leaf is FunctionType) {
            return equalitySubject(instantiation, structType,
                    "{names.quoted(structType)} cannot be compared with '=='", names)
                + ": an array compares element by element, and its element type "
                + "{names.quoted(leaf)} has no '=='; {noEqualityReason(leaf)}. "
                + suggestedFix(instantiation, "Compare the elements you need directly instead.",
                    "Use a type argument whose elements have an '==' of their own.");
        }
        if (types.isStructLike(leaf)) {
            let inElement = firstIncomparableField(leaf, new Set<Type>());
            if (inElement != null) {
                return equalitySubject(instantiation, structType,
                        "{names.quoted(structType)} cannot be compared with '=='", names)
                    + ": an array compares element by element, and element field "
                    + "'{inElement.path()}' has type {names.quoted(inElement.leaf())}, which "
                    + "has no '=='; {noEqualityReason(inElement.leaf())}. "
                    + suggestedFix(instantiation,
                        "Compare the elements you need directly instead.",
                        "Use a type argument whose elements have an '==' of their own.");
            }
        }
        return null;
    }
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstIncomparableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    return equalitySubject(instantiation, structType,
            "Struct {names.quotedName(authority)} cannot be compared with '=='", names)
        + ". Field '{found.path()}' has type {names.quoted(found.leaf())}, which has no "
        + "'=='; {noEqualityReason(found.leaf())}. "
        + suggestedFix(instantiation, "Compare the fields you need directly instead.",
            "Use a type argument with an '==' of its own, or give {names.quotedName(authority)} its own "
                + "'equals' and 'hash'.");
}

// The subject of a '==' refusal: 'written' names what cannot be compared where the comparison
// was written, while a reader who only chose the type argument reads their own instantiation.
equalitySubject(string instantiation, Type compared, string written, TypeNames names)
        -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return "{instantiation} cannot compare two values of type {names.quoted(compared)} with '=='";
}

// Why a value of this type has no 'hash', or null when it has one. An optional hashes as its
// payload does, so the payload's type decides.
public hashabilityIssue(Type receiver, TypeNames names) -> string? {
    return hashabilityIssueOf("", receiver, names);
}

// The same judgment for a 'hash()' call inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line.
public hashabilityIssue(string instantiation, Type receiver, TypeNames names) -> string? {
    return hashabilityIssueOf(instantiation, receiver, names);
}

hashabilityIssueOf(string instantiation, Type receiver, TypeNames names) -> string? {
    Type core = convert.coreOf(receiver);
    if (core is FunctionType) {
        if (instantiation.length > 0) {
            return "{instantiation} cannot hash a value of type "
                + "{names.quoted(receiver)}: {noHashReason(core)}. Keep a name or tag beside "
                + "the function and pass that instead.";
        }
        return functionMemberIssue("hash", receiver, names);
    }
    if (core is ExternalType) {
        return refusalSubject(instantiation) + " hash a value of type "
            + "{names.quoted(receiver)}: {noHashReason(core)}. "
            + suggestedFix(instantiation,
                "Wrap the handle in a class, which hashes by identity, or hash a value you keep "
                    + "beside it.",
                "Wrap the handle in a class, which hashes by identity, and pass that, or pass a "
                    + "value you keep beside it.");
    }
    if (convert.isFloatType(core)) {
        return refusalSubject(instantiation) + " hash a value of type "
            + "{names.quoted(receiver)}: {noHashReason(core)}. "
            + suggestedFix(instantiation,
                "Hash the number's 'toCanonicalBits() as long' instead, which gives every NaN "
                    + "the same hash and the two zeros different ones.",
                "Pass the number's 'toCanonicalBits() as long' instead, which gives every NaN "
                    + "the same hash and the two zeros different ones.");
    }
    if (core is ArrayType) {
        Type leaf = innermostElementOf(core);
        if (convert.containsTypeParam(leaf)) {
            return null;
        }
        if (isOpaqueLeaf(leaf, true)) {
            return hashSubject(instantiation, receiver,
                    "{names.quoted(receiver)} cannot be hashed", names)
                + ": an array hashes element by element, and its element type "
                + "{names.quoted(leaf)} has no hash; {noHashReason(leaf)}. "
                + suggestedFix(instantiation,
                    "Hash a value you keep beside the elements instead.",
                    "Use a type argument whose elements have a hash of their own.");
        }
        if (types.isStructLike(leaf)) {
            let inElement = firstUnhashableField(leaf, new Set<Type>());
            if (inElement != null) {
                return hashSubject(instantiation, receiver,
                        "{names.quoted(receiver)} cannot be hashed", names)
                    + ": an array hashes element by element, and element field "
                    + "'{inElement.path()}' has type {names.quoted(inElement.leaf())}, which "
                    + "has no hash; {noHashReason(inElement.leaf())}. "
                    + suggestedFix(instantiation,
                        "Hash the fields you need directly instead.",
                        "Use a type argument whose elements have a hash of their own.");
            }
        }
        return null;
    }
    if (!types.isStructLike(core)) {
        return null;
    }
    let authority = types.authorityOf(core);
    let found = firstUnhashableField(core, new Set<Type>());
    if (authority == null || found == null) {
        return null;
    }
    string owner = names.quotedName(authority);
    string fix = suggestedFix(instantiation, "Hash the fields you need directly instead.",
        "Use a type argument with a hash of its own, or give {owner} its own 'equals' and 'hash'.");
    if (convert.isFloatType(found.leaf())) {
        fix = suggestedFix(instantiation, floatPairAdvice("Give", owner),
            floatPairAdvice("Use a type argument with a hash of its own, or give", owner));
    }
    return hashSubject(instantiation, receiver, "Struct {owner} cannot be hashed", names)
        + ". Field '{found.path()}' has type {names.quoted(found.leaf())}, which has no "
        + "hash; {noHashReason(found.leaf())}. " + fix;
}

// The subject of a hash refusal: 'written' names what has no hash where the call was written,
// while a reader who only chose the type argument reads their own instantiation.
hashSubject(string instantiation, Type receiver, string written, TypeNames names)
        -> string {
    if (instantiation.length == 0) {
        return written;
    }
    return "{instantiation} cannot hash a value of type {names.quoted(receiver)}";
}

// Why a member cannot be read or called on a function value, whatever the member.
public functionMemberIssue(string name, Type functionType, TypeNames names) -> string {
    return "A function value has no members, so '{name}' cannot be used on "
        + "{names.quoted(functionType)}. Call the value with '(...)', or keep the data you need "
        + "beside it.";
}

// A standard container that hashes or orders its entries by one type argument, and how a
// diagnostic names that argument's role, the container, and what a changing key would upset.
public final class KeyedContainer {
    long keyArgumentIndex;
    string roleText;
    string nounText;
    string homeText;
    string upsetText;
    bool findsByHash;

    protected constructor(this.keyArgumentIndex, this.roleText, this.nounText, this.homeText,
                          this.upsetText, this.findsByHash);

    public keyIndex() -> long {
        return this.keyArgumentIndex;
    }

    public role() -> string {
        return this.roleText;
    }

    public noun() -> string {
        return this.nounText;
    }

    public home() -> string {
        return this.homeText;
    }

    public upset() -> string {
        return this.upsetText;
    }

    // Whether the container finds a key by hashing it, which is what a type with no hash rules
    // out; one that walks an order needs 'compareTo' instead.
    public keysByHash() -> bool {
        return this.findsByHash;
    }
}

// The keyed standard containers, by template name and declaring module, the way sema picks
// 'Iterable<T>'; 'SortedMap' is named ahead of the library that adds it.
public keyedContainerOf(DeclaredType template) -> KeyedContainer? {
    if (!(template is ClassType)) {
        return null;
    }
    if (isDeclaredAs(template, "Map", "map")) {
        return new KeyedContainer(0, "a Map key", "key", "the map", "its hash", true);
    }
    if (isDeclaredAs(template, "Set", "set")) {
        return new KeyedContainer(0, "a Set element", "element", "the set", "its hash", true);
    }
    if (isDeclaredAs(template, "SortedMap", "sortedmap")) {
        return new KeyedContainer(0, "a SortedMap key", "key", "the map",
            "its place in the order", false);
    }
    return null;
}

// Why a value of this type cannot be the key argument of this container, or null when it can. A
// key that hashes by content must not change while it is in the container, and a key with no
// hash at all is refused here so the error lands on the mention rather than inside the library.
public keyTypeIssue(DeclaredType container, Type key, TypeNames names) -> string? {
    return keyTypeIssueOf("", container, key, names);
}

// The same judgment for a keyed container written inside a generic body, refused for the
// arguments of the 'instantiation' a reader wrote and reported at that reader's own line.
public keyTypeIssue(string instantiation, DeclaredType container, Type key,
                    TypeNames names) -> string? {
    return keyTypeIssueOf(instantiation, container, key, names);
}

keyTypeIssueOf(string instantiation, DeclaredType container, Type key, TypeNames names)
        -> string? {
    let keyed = keyedContainerOf(container);
    if (keyed == null) {
        return null;
    }
    Type core = convert.coreOf(key);
    string refused = refusalSubject(instantiation) + " use {names.quoted(key)} as "
        + "{keyed.role()}: ";
    if (core is ArrayType) {
        return refused + "an array's contents, and so {keyed.upset()}, can change while it "
            + "is in {keyed.home()}. Key by a value whose contents cannot change, such as a "
            + "string or an integer.";
    }
    if (isStandardCollection(core)) {
        return refused + "a collection's contents, and so {keyed.upset()}, can change while "
            + "it is in {keyed.home()}. Key by a value whose contents cannot change, such as "
            + "a string or an integer.";
    }
    // A container that finds a key by hashing it is the only one that refuses a type with no
    // hash, or judges what the fields of a struct key hold. One that walks an order requires
    // 'Comparable' of its key instead, which a struct satisfies with a 'compareTo' of its own, whatever
    // its fields hold, and the constructor's bound judges that.
    if (!keyed.keysByHash()) {
        return null;
    }
    if (core is ExternalType) {
        return refused + "{noHashReason(core)}. Wrap the handle in a class, which hashes by "
            + "identity, or key by a value you keep beside it.";
    }
    if (core is FunctionType) {
        return refused + "{noHashReason(core)}. Keep a name or tag beside each function and "
            + "key by that instead.";
    }
    if (convert.isFloatType(core)) {
        return refused + "{noHashReason(core)}. " + suggestedFix(instantiation,
            "Use a SortedMap, which finds a key by its order rather than by its hash, or key "
                + "by a struct of your own whose 'equals' compares the number with "
                + "'compareTo(...) == 0' and whose 'hash' returns 'toCanonicalBits() as "
                + "long'.",
            "Pass a type argument with a hash of its own, such as a struct holding the "
                + "number whose 'equals' compares it with 'compareTo(...) == 0' and whose "
                + "'hash' returns 'toCanonicalBits() as long'.");
    }
    if (!types.isStructLike(core)) {
        return null;
    }
    let changeable = firstChangeableField(core, new Set<Type>());
    if (changeable != null) {
        return refused + "its field '{changeable.path()}' has type "
            + "{names.quoted(changeable.leaf())}, whose contents can change while the "
            + "{keyed.noun()} is in {keyed.home()}. " + suggestedFix(instantiation,
            "Key by the fields whose contents cannot change. Or give {names.quoted(key)} its own "
                + "'equals' and 'hash' that leave '{changeable.path()}' out. Or key by a value "
                + "you keep beside the {keyed.noun()}.",
            "Pass a type argument whose contents cannot change, or give {names.quoted(key)} its "
                + "own 'equals' and 'hash' that leave '{changeable.path()}' out.");
    }
    let opaque = firstUnhashableField(core, new Set<Type>());
    if (opaque != null) {
        string fix = " Give {names.quoted(key)} its own 'equals' and 'hash', or key by the "
            + "fields that have one.";
        if (convert.isFloatType(opaque.leaf())) {
            fix = " " + suggestedFix(instantiation,
                floatPairAdvice("Key by the fields that are not floating-point numbers, or give",
                    names.quoted(key)),
                floatPairAdvice("Pass a type argument with a hash of its own, or give", names.quoted(key)));
        }
        return refused + "its field '{opaque.path()}' has type "
            + "{names.quoted(opaque.leaf())}, which has no hash; "
            + "{noHashReason(opaque.leaf())}." + fix;
    }
    return null;
}

// True for a keyed container instantiated at a refused key. The mention that formed it was
// reported where it was written, so the container's own bodies are never judged for it.
public hasRefusedKey(DeclaredType template, Type[] arguments, TypeNames names) -> bool {
    let keyed = keyedContainerOf(template);
    if (keyed == null || keyed.keyIndex() >= arguments.length) {
        return false;
    }
    return keyTypeIssue(template, arguments[keyed.keyIndex()], names) != null;
}

// The standard collections by template name and declaring module; 'Deque', 'PriorityQueue', and
// 'SortedMap' are named ahead of the library that adds them.
isStandardCollection(Type core) -> bool {
    if (!(core is InstantiationType)) {
        return false;
    }
    let template = core.template();
    if (!(template is ClassType)) {
        return false;
    }
    return isDeclaredAs(template, "List", "list") || isDeclaredAs(template, "Map", "map")
        || isDeclaredAs(template, "Set", "set") || isDeclaredAs(template, "Deque", "deque")
        || isDeclaredAs(template, "PriorityQueue", "priorityqueue")
        || isDeclaredAs(template, "SortedMap", "sortedmap");
}

isDeclaredAs(DeclaredType template, string name, string module) -> bool {
    return template.name() == name && template.modulePath() == "std.collections." + module;
}

// Why a value of struct type 'structType' cannot serialize to JSON, or null when every field is
// JSON-able. Names the offending field's dotted path and its type. 'shown' is the type the text
// was asked of, which may hold the struct behind a nullable level, so that is what the refusal
// names.
structTextIssue(TextRequest request, Type shown, Type structType, TypeNames names) -> string? {
    let authority = types.authorityOf(structType);
    if (authority == null) {
        return null;
    }
    let found = firstNonJsonableField(structType, new Set<Type>());
    if (found == null) {
        return null;
    }
    string owner = names.quotedName(authority);
    string subject = "Struct {owner} cannot be converted to a string.";
    if (request.instantiation().length > 0 || shown != structType) {
        subject = request.subject() + " a value of type {names.quoted(shown)}: struct {owner} "
            + "has no text form.";
    }
    return subject + " Without an 'override toString() -> string', a struct is written as JSON, "
        + "which lists each field's name and value. " + noJsonFormReason(found, "", names)
        + " Give {owner} an 'override toString() -> string' of its own, or "
        + joinedFixes(jsonFormFixes(request, found, authority, names)) + ".";
}

// Why an array whose innermost elements have struct type 'element' has no text form, or null when
// it has one. Each element is written as JSON whatever 'toString' its struct declares, so a
// 'toString' of its own is reached only by taking the elements one at a time.
arrayStructTextIssue(TextRequest request, Type shown, ArrayType array, Type element,
                     TypeNames names) -> string? {
    let authority = types.authorityOf(element);
    if (authority == null) {
        return null;
    }
    let found = firstNonJsonableField(element, new Set<Type>());
    if (found == null) {
        return null;
    }
    string owner = names.quotedName(authority);
    bool ownText = typemembers.declaredToString(element) != null;
    string written = "each struct element of an array is written as JSON, which lists each field's "
        + "name and value";
    if (ownText) {
        written = written + ", even though {owner} declares its own 'toString'";
    }
    string refusal = request.subject() + " a value of type {names.quoted(shown)}: {written}. "
        + noJsonFormReason(found, " of {owner}", names) + " ";
    string fixes = joinedFixes(jsonFormFixes(request, found, null, names));
    if (request.instantiation().length > 0 || !ownText) {
        return refusal + fixes.substring(0, 1).toUpperAscii() + fixes.substring(1) + ".";
    }
    string rest = loopExample(array, authority, request.spelling()) + ", or {fixes}.";
    return refusal + textAdvice(request.use(),
        "Interpolate the elements one at a time in a 'for' loop{rest}",
        "Call 'toString' on the elements one at a time in a 'for' loop{rest}");
}

// The field with no JSON form and why, with 'ownerClause' naming the struct it was reached from
// when the subject of the refusal does not, and the 'toString' the JSON form passes over, if any.
noJsonFormReason(OffendingField found, string ownerClause, TypeNames names) -> string {
    string reason = "Field '{found.path()}'{ownerClause} has type {names.quoted(found.leaf())}, "
        + "and {noJsonFormValue(found.leaf(), names)} has no JSON form.";
    let passed = found.passedText();
    if (passed == null) {
        return reason;
    }
    return reason + " The 'toString' of {names.quotedName(passed)} is not used inside another "
        + "struct.";
}

// The fixes that give the struct a JSON form, lowercase and in the order they are offered.
// 'centered' is the struct the refusal opens with, which a fix does not name again.
jsonFormFixes(TextRequest request, OffendingField found, DeclaredType? centered,
              TypeNames names) -> List<string> {
    let fixes = new List<string>();
    if (request.instantiation().length > 0) {
        fixes.push("pass a type argument that has a JSON form");
    }
    let argumentOwner = found.argumentOwner();
    if (found.argumentChose() && argumentOwner == null) {
        if (fixes.length() == 0) {
            fixes.push("pass a type argument that has a JSON form");
        }
        return fixes;
    }
    if (argumentOwner != null) {
        fixes.push("give the type of field '{found.argumentField()}'"
            + structClause(" of", argumentOwner, centered, names)
            + " a type argument that has a JSON form");
        return fixes;
    }
    fixes.push("remove field '{found.name()}'"
        + structClause(" from", found.declaring(), centered, names));
    return fixes;
}

// The struct a fix names after 'preposition', or "" when it is the one the refusal opens with.
structClause(string preposition, DeclaredType declaring, DeclaredType? centered,
             TypeNames names) -> string {
    if (declaring == centered) {
        return "";
    }
    return "{preposition} {names.quotedName(declaring)}";
}

joinedFixes(List<string> fixes) -> string {
    string joined = fixes.get(0);
    for (long i = 1; i < fixes.length(); i++) {
        joined = joined + ", or " + fixes.get(i);
    }
    return joined;
}

// A loop over the array as written, naming each element after its struct, or "" when the
// array is not quoted or its elements are arrays themselves.
loopExample(ArrayType array, DeclaredType elementType, string spelled) -> string {
    if (spelled.length == 0 || convert.coreOf(array.element()) is ArrayType) {
        return "";
    }
    string name = elementType.name();
    string element = name.substring(0, 1).toLowerAscii() + name.substring(1);
    if (element == spelled || element == name) {
        element = "element";
    }
    return ", as in 'for (let {element} in {spelled}) \{ ... \}'";
}

// The type a value bottoms out at through its nullable levels and nested arrays.
innermostCoreOf(Type type) -> Type {
    Type core = convert.coreOf(type);
    if (core is ArrayType) {
        return innermostElementOf(core);
    }
    return core;
}

// What a value of the leaf type is, for a sentence saying it has no JSON form.
noJsonFormValue(Type leaf, TypeNames names) -> string {
    Type core = innermostCoreOf(leaf);
    if (types.isInterfaceLike(core)) {
        return "an interface value";
    }
    if (types.isClassLike(core)) {
        return "a class value";
    }
    if (core is FunctionType) {
        return "a function value";
    }
    if (core is ExternalType) {
        return "a value of an external type";
    }
    return "a value of type {names.quoted(core)}";
}

// The type a struct's declaration writes for its field 'name', in the struct's own type
// parameters, or null when it declares no such field.
declaredFieldType(DeclaredType declaring, string name) -> Type? {
    let fields = typemembers.fieldsOf(declaring);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (field.name() == name) {
            return field.type();
        }
    }
    return null;
}

// A struct field with no operator of its own: the dotted path from the judged struct down to it,
// the offending leaf type it bottoms out at, its own name and the struct that declares it. For a
// missing JSON form it also records whether a type argument chose the field's type, the field
// whose type writes that argument when one does, and the nested struct whose own 'toString' the
// JSON form passes over.
class OffendingField {
    string fieldPath;
    Type fieldLeaf;

    string fieldName;
    DeclaredType declaringStruct;

    bool argumentChoice;
    string argumentFieldName;
    DeclaredType? argumentFieldOwner;

    DeclaredType? passedOver;

    constructor(this.fieldPath, this.fieldLeaf, this.fieldName, this.declaringStruct,
                this.argumentChoice, this.argumentFieldName, this.argumentFieldOwner,
                this.passedOver);

    // The field 'name' of 'declaring' itself, whose type bottoms out at 'leaf'.
    protected static at(string name, Type leaf, DeclaredType declaring) -> OffendingField {
        let declared = declaredFieldType(declaring, name);
        bool chosen = declared != null && innermostCoreOf(declared) is TypeParamType;
        return new OffendingField(name, leaf, name, declaring, chosen, "", null, null);
    }

    // The same field reached from one struct further out, through its field 'outer', which
    // 'outerDeclaring' declares with a type that holds the struct 'nested'.
    protected under(string outer, DeclaredType outerDeclaring, Type nested) -> OffendingField {
        string argumentName = this.argumentFieldName;
        DeclaredType? argumentOwner = this.argumentFieldOwner;
        if (this.argumentChoice && argumentOwner == null) {
            let declared = declaredFieldType(outerDeclaring, outer);
            if (declared == null || !convert.containsTypeParam(declared)) {
                argumentName = outer;
                argumentOwner = outerDeclaring;
            }
        }
        DeclaredType? passed = this.passedOver;
        if (typemembers.declaredToString(nested) != null) {
            passed = types.authorityOf(nested);
        }
        return new OffendingField(outer + "." + this.fieldPath, this.fieldLeaf, this.fieldName,
            this.declaringStruct, this.argumentChoice, argumentName, argumentOwner, passed);
    }

    protected path() -> string {
        return this.fieldPath;
    }

    protected leaf() -> Type {
        return this.fieldLeaf;
    }

    protected name() -> string {
        return this.fieldName;
    }

    protected declaring() -> DeclaredType {
        return this.declaringStruct;
    }

    // True when the declaring struct writes the field's type as one of its type parameters.
    protected argumentChose() -> bool {
        return this.argumentChoice;
    }

    // The field whose type writes the type argument that chose this field's type, when that is a
    // field rather than the type the refusal opens with.
    protected argumentField() -> string {
        return this.argumentFieldName;
    }

    protected argumentOwner() -> DeclaredType? {
        return this.argumentFieldOwner;
    }

    protected passedText() -> DeclaredType? {
        return this.passedOver;
    }
}

// Why a leaf type has no '=='.
noEqualityReason(Type leaf) -> string {
    if (leaf is ArrayType) {
        return "an array compares element by element, and its elements have no '==' of "
            + "their own";
    }
    return "a function value has no identity";
}

// Why a leaf type has no 'hash'.
noHashReason(Type leaf) -> string {
    if (leaf is FunctionType) {
        return "a function value has no identity, so it has no hash";
    }
    if (leaf is ArrayType) {
        return "an array hashes element by element, and its elements have no hash of their own";
    }
    if (convert.isFloatType(leaf)) {
        return "a NaN, the value a calculation such as 0.0 / 0.0 produces, is not equal to any "
            + "value, including itself, so nothing could find it again, and negative zero is "
            + "equal to zero but hashes differently, so one key would become two entries";
    }
    return "an external type's contents belong to the C library, so Ens has nothing of it to hash";
}

// The first field, at any depth, whose type has no '==': a function value or an array of them. An
// external handle compares by identity, so it never offends here.
firstIncomparableField(Type structType, Set<Type> visiting) -> OffendingField? {
    return firstOpaqueField(structType, visiting, false);
}

// The first field, at any depth, whose type has no 'hash'. An external handle, a function value
// and a floating-point number are the kinds that offend, as is an array of any of them.
firstUnhashableField(Type structType, Set<Type> visiting) -> OffendingField? {
    return firstOpaqueField(structType, visiting, true);
}

// A struct that declares its own 'equals' and 'hash' is judged by that pair, so the walk never descends
// into one; a field mentioning a type parameter is left for the per-instantiation replay.
firstOpaqueField(Type structType, Set<Type> visiting, bool hashing) -> OffendingField? {
    if (declaresOwnPair(structType) || !visiting.add(structType)) {
        return null;
    }
    let declaring = types.authorityOf(structType);
    if (declaring == null) {
        return null;
    }
    let fields = typemembers.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (isOpaqueLeaf(element, hashing)) {
                return OffendingField.at(field.name(), core, declaring);
            }
            if (types.isStructLike(element)) {
                let inElement = firstOpaqueField(element, visiting, hashing);
                if (inElement != null) {
                    return OffendingField.at(field.name(), core, declaring);
                }
            }
            continue;
        }
        if (isOpaqueLeaf(core, hashing)) {
            return OffendingField.at(field.name(), core, declaring);
        }
        if (types.isStructLike(core)) {
            let nested = firstOpaqueField(core, visiting, hashing);
            if (nested != null) {
                return nested.under(field.name(), declaring, core);
            }
        }
    }
    return null;
}

// A function value has neither operator, so it always offends. An external handle compares by
// identity and a floating-point value compares by IEEE rules, so each of those has an '==' and
// offends the hash walk alone.
isOpaqueLeaf(Type leaf, bool hashing) -> bool {
    if (leaf is FunctionType) {
        return true;
    }
    return hashing && (leaf is ExternalType || convert.isFloatType(leaf));
}

// The first field, at any depth through nullable wrappers and nested structs, whose type is an
// array or a standard collection. A struct that declares its own 'equals' and 'hash' decides
// which fields a match reads, so the walk never descends into one. A field mentioning a
// type parameter is left for the per-instantiation replay.
firstChangeableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (declaresOwnPair(structType) || !visiting.add(structType)) {
        return null;
    }
    let declaring = types.authorityOf(structType);
    if (declaring == null) {
        return null;
    }
    let fields = typemembers.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (core is ArrayType || isStandardCollection(core)) {
            return OffendingField.at(field.name(), core, declaring);
        }
        if (types.isStructLike(core)) {
            let nested = firstChangeableField(core, visiting);
            if (nested != null) {
                return nested.under(field.name(), declaring, core);
            }
        }
    }
    return null;
}

// Sema holds a struct's 'hash' and 'equals' to a matched pair, so either name proves both.
declaresOwnPair(Type structType) -> bool {
    let methods = typemembers.methodsOf(structType);
    if (methods == null) {
        return false;
    }
    for (long i = 0; i < methods.length(); i++) {
        let method = methods.get(i);
        if (!method.isConstructor() && method.name() == "hash") {
            return true;
        }
    }
    return false;
}

// The first field, at any depth, with no JSON form. A field mentioning a type parameter is left
// for the per-instantiation replay.
firstNonJsonableField(Type structType, Set<Type> visiting) -> OffendingField? {
    if (!visiting.add(structType)) {
        return null;
    }
    let declaring = types.authorityOf(structType);
    if (declaring == null) {
        return null;
    }
    let fields = typemembers.fieldsOf(structType);
    if (fields == null) {
        return null;
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        let fieldType = field.type();
        if (convert.containsTypeParam(fieldType)) {
            continue;
        }
        Type core = convert.coreOf(fieldType);
        if (isJsonableLeaf(core)) {
            continue;
        }
        if (core is ArrayType) {
            Type element = innermostElementOf(core);
            if (isJsonableLeaf(element)) {
                continue;
            }
            if (types.isStructLike(element)) {
                let inElement = firstNonJsonableField(element, visiting);
                if (inElement == null) {
                    continue;
                }
                return inElement.under(field.name(), declaring, element);
            }
            return OffendingField.at(field.name(), fieldType, declaring);
        }
        if (types.isStructLike(core)) {
            let nested = firstNonJsonableField(core, visiting);
            if (nested != null) {
                return nested.under(field.name(), declaring, core);
            }
            continue;
        }
        return OffendingField.at(field.name(), fieldType, declaring);
    }
    return null;
}

// Why a freshly allocated array of this element type would not hold valid values, or null when it
// would. A reference element is offered the fill loop the wording names, because filling as the
// array is created is what makes it sound; a struct's own field names which one is at fault.
public arrayElementIssue(Type element, bool hasFillName, string fillName, TypeNames names)
        -> string? {
    return arrayElementIssueOf("", element, hasFillName, fillName, names);
}

// The same judgment for a 'new T[n]' inside a generic body, refused for the arguments of the
// 'instantiation' a reader wrote and reported at that reader's own line. The fill loop belongs
// to whoever wrote the allocation, so this reader is offered the type argument instead.
public arrayElementIssue(string instantiation, Type element, TypeNames names) -> string? {
    return arrayElementIssueOf(instantiation, element, false, "", names);
}

arrayElementIssueOf(string instantiation, Type element, bool hasFillName, string fillName,
                    TypeNames names) -> string? {
    if (element is ErrorType || convert.isDefaultable(element)) {
        return null;
    }
    string quotedShown = names.quoted(element);
    string nullableArray = names.quotedCode(["", "?[]"], [element]);
    string hint = "";
    if (isReferenceElement(element)) {
        if (hasFillName) {
            return "An array of {quotedShown}, which cannot be null, must be filled as it is "
                + "created. Assign it to a new variable and follow the declaration with "
                + "'for (long i = 0; i < {fillName}.length; i++) \{ {fillName}[i] = ...; \}'. "
                + "Or use {nullableArray} so a slot can start as null.";
        }
        hint = suggestedFix(instantiation, " Use {nullableArray} so a new array's slots can start as null.",
            " Pass a type argument that makes the element type nullable, so a slot can start as null.");
    } else if (types.isStructLike(element)) {
        hint = offendingFieldHint(instantiation, element, quotedShown, names);
    }
    return refusalSubject(instantiation) + " use {quotedShown} as an array element type: a new "
        + "array's slots start as zero, which is not a valid {quotedShown}.{hint}";
}

offendingFieldHint(string instantiation, Type element, string quotedElement, TypeNames names) -> string {
    let fields = typemembers.fieldsOf(element);
    if (fields == null) {
        return "";
    }
    for (long i = 0; i < fields.length(); i++) {
        let field = fields.get(i);
        if (field.hasDefault()) {
            continue;
        }
        if (field.isConst()) {
            return " Field '{field.name()}' of {quotedElement} is 'const' with no default value, so "
                + "nothing could assign it in a new array's slot. "
                + suggestedFix(instantiation, "Give the field a default value.",
                    "Give the field a default value, or pass a type argument that makes the "
                        + "element type nullable.");
        }
        if (!convert.isDefaultable(field.type())) {
            return " Field '{field.name()}' of {quotedElement} has type "
                + "{names.quoted(field.type())}, which cannot start as zero. "
                + suggestedFix(instantiation, "Make that field nullable.",
                    "Make that field nullable, or pass a type argument that makes the element "
                        + "type nullable.");
        }
    }
    return "";
}

isReferenceElement(Type element) -> bool {
    return types.isClassLike(element) || element is ArrayType || element is StringType
        || element is ExternalType;
}
