// The storage paths a body has proven non-null or proven to be a subclass, and the layered state
// holding those proofs for flow narrowing. A path is a binding or a type-level 'const' field
// followed by 'const' field hops. Two spellings of one location are one path.
import Field from model.typemembers;
import Type from model.types;
import LocalBinding from model.scopes;
import List from @std.collections.list;
import Map from @std.collections.map;
import Span from @ens.frontend.support.source;

// One field hop in a narrowing path.
public class PathSegment {
    string segmentField;

    protected constructor(string field) {
        this.segmentField = field;
    }

    protected field() -> string {
        return this.segmentField;
    }

    public override hash() -> long {
        return 17 + this.segmentField.hash() * 31;
    }

    override equals(PathSegment other) -> bool {
        return this.segmentField == other.segmentField;
    }
}

public fieldSegment(string name) -> PathSegment {
    return new PathSegment(name);
}

// A storage location, as a root binding or type-level 'const' field and the field hops after it.
// Roots compare by identity and segments by content.
public class NarrowingPath {
    LocalBinding? bindingRoot;
    Field? typeLevelRoot;
    List<PathSegment> pathSegments;

    public constructor(LocalBinding root, List<PathSegment> segments) {
        this.bindingRoot = root;
        this.typeLevelRoot = null;
        this.pathSegments = segments;
    }

    // Exactly one of the two roots is set.
    protected constructor(LocalBinding? bindingRoot, Field? typeLevelRoot, List<PathSegment> segments) {
        this.bindingRoot = bindingRoot;
        this.typeLevelRoot = typeLevelRoot;
        this.pathSegments = segments;
    }

    // The root binding, or null when the path starts at a type-level field.
    public root() -> LocalBinding? {
        return this.bindingRoot;
    }

    // The declared type of the binding or the type-level field the path starts at.
    public rootType() -> Type {
        let binding = this.bindingRoot;
        if (binding != null) {
            return binding.type();
        }
        let field = this.typeLevelRoot;
        if (field == null) {
            panic("Internal: a narrowing path starts at neither a binding nor a type-level field");
        }
        return field.type();
    }

    // The names of the fields the hops after the root read, in order.
    public fieldNames() -> string[] {
        let names = new List<string>();
        for (let segment in this.pathSegments) {
            names.push(segment.field());
        }
        return names.toArray();
    }

    protected segmentCount() -> long {
        return this.pathSegments.length();
    }

    protected segment(long index) -> PathSegment {
        return this.pathSegments.get(index);
    }

    // The same path with one more field hop at its end.
    public extended(PathSegment segment) -> NarrowingPath {
        let segments = new List<PathSegment>();
        segments.pushAll(this.pathSegments);
        segments.push(segment);
        return new NarrowingPath(this.bindingRoot, this.typeLevelRoot, segments);
    }

    // Whether both paths start at the same binding or the same field.
    protected sameRoot(NarrowingPath other) -> bool {
        return this.bindingRoot == other.bindingRoot && this.typeLevelRoot == other.typeLevelRoot;
    }

    public override hash() -> long {
        long combined = 0;
        let binding = this.bindingRoot;
        if (binding != null) {
            combined = binding.hash();
        }
        let field = this.typeLevelRoot;
        if (field != null) {
            combined = field.hash();
        }
        for (long i = 0; i < this.pathSegments.length(); i++) {
            combined = combined * 31 + this.pathSegments.get(i).hash();
        }
        return combined;
    }

    override equals(NarrowingPath other) -> bool {
        return this.sameRoot(other) && this.sameFields(other);
    }

    // Whether 'other' starts at a binding declared where this path's binding is, or at the same field,
    // and reads the same fields: the path a later pass over the same code builds for this place.
    public sameDeclaration(NarrowingPath other) -> bool {
        let binding = this.bindingRoot;
        let otherBinding = other.bindingRoot;
        if (binding == null || otherBinding == null) {
            return this.sameRoot(other) && this.sameFields(other);
        }
        return binding.sameDeclaration(otherBinding) && this.sameFields(other);
    }

    sameFields(NarrowingPath other) -> bool {
        if (this.pathSegments.length() != other.pathSegments.length()) {
            return false;
        }
        for (long i = 0; i < this.pathSegments.length(); i++) {
            if (this.pathSegments.get(i) != other.pathSegments.get(i)) {
                return false;
            }
        }
        return true;
    }
}

public bindingPath(LocalBinding root) -> NarrowingPath {
    return new NarrowingPath(root, new List<PathSegment>());
}

// The path of a type-level 'const' field read through its type, as in 'Settings.label'.
public typeLevelPath(Field root) -> NarrowingPath {
    return new NarrowingPath(null, root, new List<PathSegment>());
}

// What a write that ended a proof did: an assignment, or a call that the place is passed to as 'out'.
public enum NarrowingEndKind {
    Assigned,
    PassedOut,
}

// The write that ended the proofs of a path: what it did, where it is written, the type an assignment
// stores, the function an 'out' argument is passed to and the place written, as the code spells it.
// A write found before a loop runs, because the loop can write the path on a later pass, also records
// where the loop is written, and where the write leaves a wider proof, the narrower type it ended.
public final class NarrowingEnd {
    protected NarrowingEndKind endKind;
    protected Span writeSpan;
    protected Type? storedType;
    protected string callee;
    protected string writtenPlace;
    protected Span? loopSpan;
    protected string joined = "";
    protected string joinedPart = "";
    protected Type? narrowerType = null;

    public constructor(this.endKind, this.writeSpan, this.storedType, this.callee, this.writtenPlace,
                       this.loopSpan);

    public kind() -> NarrowingEndKind {
        return this.endKind;
    }

    public at() -> Span {
        return this.writeSpan;
    }

    public stored() -> Type? {
        return this.storedType;
    }

    public calleeName() -> string {
        return this.callee;
    }

    public place() -> string {
        return this.writtenPlace;
    }

    public loop() -> Span? {
        return this.loopSpan;
    }

    // Whether the write is in a part of a statement that a read after the statement can be reached
    // without: one branch of a join, or a loop.
    public inJoin() -> bool {
        return this.joined.length > 0;
    }

    // The statement whose branches meet after the write, as in "'if' statement", or empty where none do.
    public joinedStatement() -> string {
        return this.joined;
    }

    // The part of that statement the write is in, as in "one branch of the 'if' statement".
    public joinedIn() -> string {
        return this.joinedPart;
    }

    // The narrower type the write ended where it leaves a wider proof, or null where it leaves none.
    public narrower() -> Type? {
        return this.narrowerType;
    }

    // The same write, found where the branches of 'statement', as in "'if' statement", meet, from 'part',
    // the part of it the write is in, as in "the 'while' loop".
    public throughJoin(string statement, string part) -> NarrowingEnd {
        let copied = this.copy();
        copied.joined = statement;
        copied.joinedPart = part;
        return copied;
    }

    // The same write, found before the loop written at 'loop' runs.
    public inLoop(Span loop) -> NarrowingEnd {
        let copied = this.copy();
        copied.loopSpan = loop;
        return copied;
    }

    // The same write, which leaves a wider proof where a proof of 'narrower' held.
    public narrowedFrom(Type narrower) -> NarrowingEnd {
        let copied = this.copy();
        copied.narrowerType = narrower;
        return copied;
    }

    copy() -> NarrowingEnd {
        let copied = new NarrowingEnd(this.endKind, this.writeSpan, this.storedType, this.callee,
            this.writtenPlace, this.loopSpan);
        copied.joined = this.joined;
        copied.joinedPart = this.joinedPart;
        copied.narrowerType = this.narrowerType;
        return copied;
    }
}

// The proofs one branch of control flow establishes, the writes there that ended proofs, and the writes
// that left the proofs it holds where a write left one.
public final class NarrowingLayer {
    protected Map<NarrowingPath, Type> proofs;
    protected Map<NarrowingPath, NarrowingEnd> ends;
    protected Map<NarrowingPath, NarrowingEnd> writes;
    // Where the layer is in its state, counted from the outermost one.
    protected long index;

    protected constructor(this.index) {
        this.proofs = new Map<NarrowingPath, Type>();
        this.ends = new Map<NarrowingPath, NarrowingEnd>();
        this.writes = new Map<NarrowingPath, NarrowingEnd>();
    }

    // Whether the layer holds no proof, no write and no end.
    protected isEmpty() -> bool {
        return this.proofs.isEmpty() && this.ends.isEmpty() && this.writes.isEmpty();
    }

    protected copy() -> NarrowingLayer {
        let copied = new NarrowingLayer(this.index);
        for (let key in this.proofs.keys()) {
            let proven = this.proofs.get(key);
            if (proven != null) {
                copied.proofs.set(key, proven);
            }
        }
        for (let key in this.ends.keys()) {
            let ended = this.ends.get(key);
            if (ended != null) {
                copied.ends.set(key, ended);
            }
        }
        for (let key in this.writes.keys()) {
            let write = this.writes.get(key);
            if (write != null) {
                copied.writes.set(key, write);
            }
        }
        return copied;
    }
}

// The proven types, one layer per branch of control flow. Establishment writes the top layer;
// lookup prefers the innermost layer; invalidation erases from every layer, since a write inside a
// branch may have happened by any later read, and records the write that ended each proof in the top
// layer. Only the layers that have held a proof, an end or a write are read.
public class NarrowingState {
    List<NarrowingLayer> layers;
    // The layers that have held a proof, an end or a write since they were pushed, outermost first.
    List<NarrowingLayer> filled;

    public constructor() {
        this.layers = new List<NarrowingLayer>();
        this.layers.push(new NarrowingLayer(0));
        this.filled = new List<NarrowingLayer>();
    }

    // A state whose one layer holds the proofs in 'proven'.
    public constructor(Map<NarrowingPath, Type> proven) {
        this.layers = new List<NarrowingLayer>();
        let layer = new NarrowingLayer(0);
        for (let key in proven.keys()) {
            let type = proven.get(key);
            if (type != null) {
                layer.proofs.set(key, type);
            }
        }
        this.layers.push(layer);
        this.filled = new List<NarrowingLayer>();
        this.fill(0);
    }

    // A state with the same proofs and ends in copies of the same layers.
    public copy() -> NarrowingState {
        let copied = new NarrowingState();
        copied.layers = copyLayers(this.layers);
        for (let layer in this.filled) {
            copied.filled.push(copied.layers.get(layer.index));
        }
        return copied;
    }

    public push() {
        this.layers.push(new NarrowingLayer(this.layers.length()));
    }

    public pop() {
        if (this.layers.length() > 1) {
            this.popLayer();
        }
    }

    popLayer() {
        long top = this.layers.length() - 1;
        if (!this.filled.isEmpty() && this.filled.last().index == top) {
            this.filled.pop();
        }
        this.layers.pop();
    }

    // Records that the layer at 'index' holds a proof, an end or a write.
    fill(long index) {
        long at = this.filled.length();
        while (at > 0 && this.filled.get(at - 1).index >= index) {
            if (this.filled.get(at - 1).index == index) {
                return;
            }
            at--;
        }
        this.filled.insert(at, this.layers.get(index));
    }

    public narrow(NarrowingPath path, Type proven) {
        this.fill(this.layers.length() - 1);
        let top = this.layers.get(this.layers.length() - 1);
        top.proofs.set(path, proven);
        top.ends.remove(path);
        top.writes.remove(path);
    }

    // Records 'write' as the write that left the proof of 'path' made here last.
    public noteWrite(NarrowingPath path, NarrowingEnd write) {
        this.fill(this.layers.length() - 1);
        this.layers.get(this.layers.length() - 1).writes.set(path, write);
    }

    // The write that left the proof of 'path' that holds here, or null where a test made it or none holds.
    public writeOf(NarrowingPath path) -> NarrowingEnd? {
        for (long i = this.filled.length() - 1; i >= 0; i--) {
            let layer = this.filled.get(i);
            let write = layer.writes.get(path);
            if (write != null) {
                return write;
            }
            if (layer.proofs.get(path) != null) {
                return null;
            }
        }
        return null;
    }

    // The write that left the proof of each path whose proof holds here where a write left it, as writeOf
    // finds it.
    public writes() -> Map<NarrowingPath, NarrowingEnd> {
        let found = new Map<NarrowingPath, NarrowingEnd>();
        for (let layer in this.filled) {
            if (layer.isEmpty()) {
                continue;
            }
            for (let key in layer.proofs.keys()) {
                found.remove(key);
            }
            for (let key in layer.writes.keys()) {
                let write = layer.writes.get(key);
                if (write != null) {
                    found.set(key, write);
                }
            }
        }
        return found;
    }

    public provenType(NarrowingPath path) -> Type? {
        for (long i = this.filled.length() - 1; i >= 0; i--) {
            let found = this.filled.get(i).proofs.get(path);
            if (found != null) {
                return found;
            }
        }
        return null;
    }

    // The write that ended the last proof of 'path', or null where a proof holds or none was ended.
    public endOf(NarrowingPath path) -> NarrowingEnd? {
        for (long i = this.filled.length() - 1; i >= 0; i--) {
            let layer = this.filled.get(i);
            if (layer.proofs.get(path) != null) {
                return null;
            }
            let ended = layer.ends.get(path);
            if (ended != null) {
                return ended;
            }
        }
        return null;
    }

    // The write that ended the last proof of each path whose proofs a write ended and no proof holds again,
    // as endOf finds it.
    public ends() -> Map<NarrowingPath, NarrowingEnd> {
        let found = new Map<NarrowingPath, NarrowingEnd>();
        for (let layer in this.filled) {
            if (layer.isEmpty()) {
                continue;
            }
            for (let key in layer.proofs.keys()) {
                found.remove(key);
            }
            for (let key in layer.ends.keys()) {
                let ended = layer.ends.get(key);
                if (ended != null) {
                    found.set(key, ended);
                }
            }
        }
        return found;
    }

    // Erases the narrowing of 'path', which the write 'end' ended, and records 'end' as what ended it where
    // an earlier write is recorded.
    public endProof(NarrowingPath path, NarrowingEnd end) {
        this.clearWhere((key) -> key == path, end);
        this.renewWhere((key) -> key == path, end);
    }

    // Erases every narrowing whose path starts at 'root', which the write 'end' replaces.
    public clearForRoot(LocalBinding root, NarrowingEnd end) {
        this.clearWhere((key) -> key.root() == root, end);
    }

    // Erases every narrowing whose path starts with the written path, since the write 'end' replaces
    // the storage those paths read.
    public clearPrefixedBy(NarrowingPath written, NarrowingEnd end) {
        this.clearWhere((key) -> startsWith(key, written), end);
    }

    // Records 'end' as what ended each path from 'root' that holds no proof, where an earlier write is
    // recorded as what ended it, so a read after 'end' names it.
    public renewForRoot(LocalBinding root, NarrowingEnd end) {
        this.renewWhere((key) -> key.root() == root, end);
    }

    // Records 'end' as what ended each path that starts with the written path and holds no proof, where
    // an earlier write is recorded as what ended it.
    public renewPrefixedBy(NarrowingPath written, NarrowingEnd end) {
        this.renewWhere((key) -> startsWith(key, written), end);
    }

    // Erases every narrowing 'cleared' accepts, and records 'end' as what ended it in the layer that held
    // it, which can outlast the branch the write is in.
    clearWhere((NarrowingPath) -> bool cleared, NarrowingEnd end) {
        for (let layer in this.filled) {
            if (layer.proofs.isEmpty()) {
                continue;
            }
            for (let key in layer.proofs.keys()) {
                if (cleared(key)) {
                    layer.ends.set(key, end);
                }
            }
            layer.proofs.removeWhere((key, proven) -> cleared(key));
            layer.writes.removeWhere((key, write) -> cleared(key));
        }
    }

    // Replaces with 'end' the earlier write each layer records as what ended a path 'renewed' accepts
    // that holds no proof.
    renewWhere((NarrowingPath) -> bool renewed, NarrowingEnd end) {
        for (let layer in this.filled) {
            if (layer.ends.isEmpty()) {
                continue;
            }
            for (let key in layer.ends.keys()) {
                if (renewed(key) && this.provenType(key) == null) {
                    layer.ends.set(key, end);
                }
            }
        }
    }

    // A deep copy of every layer, so a branch can be analyzed and then rolled back to the
    // state before it: the alternative arms of a merge each start from the same entry.
    public snapshotLayers() -> List<NarrowingLayer> {
        return copyLayers(this.layers);
    }

    public restoreLayers(List<NarrowingLayer> snapshot) {
        this.layers = copyLayers(snapshot);
        this.filled = new List<NarrowingLayer>();
        for (let layer in this.layers) {
            if (!layer.isEmpty()) {
                this.filled.push(layer);
            }
        }
    }

    // Every proven type visible here, merged outermost to innermost so the innermost proof of
    // a path wins, matching provenType.
    public flatten() -> Map<NarrowingPath, Type> {
        let merged = new Map<NarrowingPath, Type>();
        for (let layer in this.filled) {
            let proofs = layer.proofs;
            if (proofs.isEmpty()) {
                continue;
            }
            for (let key in proofs.keys()) {
                let value = proofs.get(key);
                if (value != null) {
                    merged.set(key, value);
                }
            }
        }
        return merged;
    }

    public clearPath(NarrowingPath path) {
        for (let layer in this.filled) {
            layer.proofs.remove(path);
            layer.writes.remove(path);
        }
    }
}

// Whether 'left' and 'right' prove the same type for the same paths.
public sameProofs(Map<NarrowingPath, Type> left, Map<NarrowingPath, Type> right) -> bool {
    if (left.length() != right.length()) {
        return false;
    }
    for (let path in left.keys()) {
        if (left.get(path) != right.get(path)) {
            return false;
        }
    }
    return true;
}

copyLayers(List<NarrowingLayer> layers) -> List<NarrowingLayer> {
    let copy = new List<NarrowingLayer>();
    for (long i = 0; i < layers.length(); i++) {
        copy.push(layers.get(i).copy());
    }
    return copy;
}

// Whether 'path' is 'prefix' or a path that reads further fields after it.
public startsWith(NarrowingPath path, NarrowingPath prefix) -> bool {
    if (!path.sameRoot(prefix) || path.segmentCount() < prefix.segmentCount()) {
        return false;
    }
    for (long i = 0; i < prefix.segmentCount(); i++) {
        if (path.segment(i) != prefix.segment(i)) {
            return false;
        }
    }
    return true;
}
