// The storage paths a body has proven non-null or proven to be a subclass, and the layered state
// holding those proofs for flow narrowing. A path is a binding or a type-level 'const' field
// followed by 'const' field hops. Two spellings of one location are one path.
import Type from model.types;
import Field from model.types;
import LocalBinding from model.scopes;
import List from @std.collections.list;
import Map from @std.collections.map;

// One field hop in a narrowing path.
public class PathSegment {
    string segmentField;

    protected constructor(string field) {
        this.segmentField = field;
    }

    public override hash() -> long {
        return 17 + this.segmentField.hash() * 31;
    }

    override equals(PathSegment other) -> bool {
        return this.segmentField == other.segmentField;
    }
}

public fieldSegment(string name) -> PathSegment {
    return new PathSegment(name);
}

// A storage location, as a root binding or type-level 'const' field and the field hops after it.
// Roots compare by identity and segments by content.
public class NarrowingPath {
    LocalBinding? bindingRoot;
    Field? typeLevelRoot;
    List<PathSegment> pathSegments;

    public constructor(LocalBinding root, List<PathSegment> segments) {
        this.bindingRoot = root;
        this.typeLevelRoot = null;
        this.pathSegments = segments;
    }

    // Exactly one of the two roots is set.
    protected constructor(LocalBinding? bindingRoot, Field? typeLevelRoot, List<PathSegment> segments) {
        this.bindingRoot = bindingRoot;
        this.typeLevelRoot = typeLevelRoot;
        this.pathSegments = segments;
    }

    // The root binding, or null when the path starts at a type-level field.
    public root() -> LocalBinding? {
        return this.bindingRoot;
    }

    protected segmentCount() -> long {
        return this.pathSegments.length();
    }

    protected segment(long index) -> PathSegment {
        return this.pathSegments.get(index);
    }

    // The same path with one more field hop at its end.
    public extended(PathSegment segment) -> NarrowingPath {
        let segments = new List<PathSegment>();
        segments.pushAll(this.pathSegments);
        segments.push(segment);
        return new NarrowingPath(this.bindingRoot, this.typeLevelRoot, segments);
    }

    // Whether both paths start at the same binding or the same field.
    protected sameRoot(NarrowingPath other) -> bool {
        return this.bindingRoot == other.bindingRoot && this.typeLevelRoot == other.typeLevelRoot;
    }

    public override hash() -> long {
        long combined = 0;
        let binding = this.bindingRoot;
        if (binding != null) {
            combined = binding.hash();
        }
        let field = this.typeLevelRoot;
        if (field != null) {
            combined = field.hash();
        }
        for (long i = 0; i < this.pathSegments.length(); i++) {
            combined = combined * 31 + this.pathSegments.get(i).hash();
        }
        return combined;
    }

    override equals(NarrowingPath other) -> bool {
        if (!this.sameRoot(other)) {
            return false;
        }
        if (this.pathSegments.length() != other.pathSegments.length()) {
            return false;
        }
        for (long i = 0; i < this.pathSegments.length(); i++) {
            if (this.pathSegments.get(i) != other.pathSegments.get(i)) {
                return false;
            }
        }
        return true;
    }
}

public bindingPath(LocalBinding root) -> NarrowingPath {
    return new NarrowingPath(root, new List<PathSegment>());
}

// The path of a type-level 'const' field read through its type, as in 'Settings.label'.
public typeLevelPath(Field root) -> NarrowingPath {
    return new NarrowingPath(null, root, new List<PathSegment>());
}

// The proven types, one map layer per branch of control flow. Establishment writes the top
// layer; lookup prefers the innermost layer; invalidation erases from every layer, since a
// write inside a branch may have happened by any later read.
public class NarrowingState {
    List<Map<NarrowingPath, Type>> layers;

    public constructor() {
        this.layers = new List<Map<NarrowingPath, Type>>();
        this.layers.push(new Map<NarrowingPath, Type>());
    }

    public push() {
        this.layers.push(new Map<NarrowingPath, Type>());
    }

    public pop() {
        if (this.layers.length() > 1) {
            this.layers.pop();
        }
    }

    public narrow(NarrowingPath path, Type proven) {
        this.layers.get(this.layers.length() - 1).set(path, proven);
    }

    public provenType(NarrowingPath path) -> Type? {
        for (long i = this.layers.length() - 1; i >= 0; i--) {
            let found = this.layers.get(i).get(path);
            if (found != null) {
                return found;
            }
        }
        return null;
    }

    public clearForRoot(LocalBinding root) {
        for (long i = 0; i < this.layers.length(); i++) {
            this.layers.get(i).removeWhere((key, proven) -> key.root() == root);
        }
    }

    // Erases every narrowing whose path starts with the written path, since the write replaces
    // the storage those paths read.
    public clearPrefixedBy(NarrowingPath written) {
        for (long i = 0; i < this.layers.length(); i++) {
            this.layers.get(i).removeWhere((key, proven) -> startsWith(key, written));
        }
    }

    // A deep copy of every layer, so a branch can be analyzed and then rolled back to the
    // state before it: the alternative arms of a merge each start from the same entry.
    public snapshotLayers() -> List<Map<NarrowingPath, Type>> {
        return copyLayers(this.layers);
    }

    public restoreLayers(List<Map<NarrowingPath, Type>> snapshot) {
        this.layers = copyLayers(snapshot);
    }

    // Every proven type visible here, merged outermost to innermost so the innermost proof of
    // a path wins, matching provenType.
    public flatten() -> Map<NarrowingPath, Type> {
        let merged = new Map<NarrowingPath, Type>();
        for (long i = 0; i < this.layers.length(); i++) {
            let layer = this.layers.get(i);
            for (let key in layer.keys()) {
                let value = layer.get(key);
                if (value != null) {
                    merged.set(key, value);
                }
            }
        }
        return merged;
    }

    public clearPath(NarrowingPath path) {
        for (long i = 0; i < this.layers.length(); i++) {
            this.layers.get(i).remove(path);
        }
    }
}

copyLayers(List<Map<NarrowingPath, Type>> layers) -> List<Map<NarrowingPath, Type>> {
    let copy = new List<Map<NarrowingPath, Type>>();
    for (long i = 0; i < layers.length(); i++) {
        let layer = layers.get(i);
        let duplicate = new Map<NarrowingPath, Type>();
        for (let key in layer.keys()) {
            let value = layer.get(key);
            if (value != null) {
                duplicate.set(key, value);
            }
        }
        copy.push(duplicate);
    }
    return copy;
}

startsWith(NarrowingPath path, NarrowingPath prefix) -> bool {
    if (!path.sameRoot(prefix) || path.segmentCount() < prefix.segmentCount()) {
        return false;
    }
    for (long i = 0; i < prefix.segmentCount(); i++) {
        if (path.segment(i) != prefix.segment(i)) {
            return false;
        }
    }
    return true;
}
