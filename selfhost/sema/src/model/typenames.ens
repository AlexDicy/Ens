// How a type is spelled in a diagnostic: the names each file has for the program's types, the
// spelling of a type through those names, and the messages about naming a type.
import model.types;
import PrimitiveKind from model.types;
import Type from model.types;
import PrimitiveType from model.types;
import StringType from model.types;
import NullType from model.types;
import ErrorType from model.types;
import OptionalType from model.types;
import ArrayType from model.types;
import FunctionType from model.types;
import DeclaredType from model.types;
import InterfaceType from model.types;
import ExternalType from model.types;
import PrimitiveBinding from model.types;
import TypeParamType from model.types;
import InstantiationType from model.types;
import TypeStore from model.types;
import support.diagnostics;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// The refusal for a type written under a module name, with 'spelling' the name as the file wrote
// it. Only a function can follow a module name, so the fix is the name this file already has for
// the type, or the import that would bind one.
public moduleQualifiedTypeMessage(string spelling, DeclaredType found, TypeNames names) -> string {
    string refusal = "'{spelling}' writes a type after a module name, and only a function can be "
        + "written after a module name.";
    let already = names.nameFor(found);
    if (already != null) {
        return "{refusal} This file already calls it '{already}', so write '{already}'.";
    }
    string bound = freeNameFor(found, names);
    string binding = found.name();
    if (bound != found.name()) {
        binding = "{found.name()} as {bound}";
    }
    return "{refusal} Write 'import {binding} from {names.importPathOf(found)};' and then write "
        + "'{bound}'.";
}

// The name an import of this type binds in the file: the type's own name, or that name behind as
// much of the module path as it takes for the file not to have the name already.
public freeNameFor(DeclaredType found, TypeNames names) -> string {
    if (!names.bindsTypeName(found.name())) {
        return found.name();
    }
    string[] segments = found.modulePath().split(".");
    string candidate = found.name();
    for (long i = segments.length - 1; i >= 0; i--) {
        candidate = capitalizedAscii(segments[i]) + candidate;
        if (!names.bindsTypeName(candidate)) {
            return candidate;
        }
    }
    return candidate;
}

public capitalizedAscii(string text) -> string {
    if (text.length == 0) {
        return text;
    }
    return text.substring(0, 1).toUpperAscii() + text.substring(1);
}

// How the static 'member' of 'head' is written in the file 'names' belongs to: through the names
// the file has for the types 'head' spells, or after the imports that give them one. A call to a
// static method is written between 'prefix' and 'suffix', as in 'try Root.make(...)'.
public qualifiedMemberSpelling(Type head, string member, TypeNames names, string prefix = "",
                               string suffix = "") -> string {
    let imported = importsFor([head], names);
    string code = "'{prefix}{headSpelling(head, imported.names())}.{member}{suffix}'";
    string[] imports = imported.imports();
    if (imports.length == 0) {
        return code;
    }
    let listed = new StringBuilder();
    for (long i = 0; i < imports.length; i++) {
        if (i > 0) {
            listed.append(", ");
        }
        listed.append("'{imports[i]}'");
    }
    return "{listed.toString()} and then {code}";
}

// A type written in front of a static member: a declared type by its name alone and an instantiation
// with its type arguments.
headSpelling(Type head, TypeNames names) -> string {
    if (head is DeclaredType) {
        return names.plainNameOf(head);
    }
    return names.of(head);
}

// The sentence that writes the static 'member' of 'declared' in the file 'names' belongs to.
public qualifiedMemberFix(DeclaredType declared, string member, TypeNames names) -> string {
    return "Write {qualifiedMemberSpelling(declared, member, names)}.";
}

// The name a static of 'declaring' is written behind in the file 'names' belongs to.
staticFront(DeclaredType declaring, TypeNames names) -> string {
    return names.nameFor(declaring) ?? freeNameFor(declaring, names);
}

// Why the static 'name' written through a subclass of 'declaring', which declares it, is refused.
public staticNotInheritedReason(string name, DeclaredType declaring, TypeNames names) -> string {
    return "'{name}' is declared by {names.quotedName(declaring)}, and a static is not inherited, so it "
        + "is always written with '{staticFront(declaring, names)}' in front.";
}

// The opening of the sentence after an access refusal of a static of 'declaring' written through a
// subclass, before the spelling that writes it once it is reachable.
public staticNotInheritedLead(DeclaredType declaring, TypeNames names) -> string {
    return "A static is not inherited, so write it with '{staticFront(declaring, names)}' in front";
}

// The sentence after an access refusal of the static 'name' of 'declaring' written through a
// subclass, which writes it behind 'head' once it is reachable.
public staticNotInheritedFollowUp(string name, DeclaredType declaring, Type head, TypeNames names,
                                  string prefix = "", string suffix = "") -> string {
    return "{staticNotInheritedLead(declaring, names)}: "
        + "{qualifiedMemberSpelling(head, name, names, prefix, suffix)}.";
}

// The refusal of the static 'name' written through a subclass of 'declaring', which declares it,
// with the fix that writes it behind 'head'.
public staticNotInheritedMessage(string name, DeclaredType declaring, Type head, TypeNames names,
                                 string prefix = "", string suffix = "") -> string {
    return "{staticNotInheritedReason(name, declaring, names)} Write "
        + "{qualifiedMemberSpelling(head, name, names, prefix, suffix)}.";
}

// The imports a file writes before it can name every type of a list, and its names once they are
// written.
public final class ImportedNames {
    string[] written;
    TypeNames extended;

    public constructor(this.written, this.extended);

    // Each import as the file writes it, as in 'import Root from base;'.
    public imports() -> string[] {
        return this.written;
    }

    // The file's names once every import is written.
    public names() -> TypeNames {
        return this.extended;
    }
}

// The imports the file 'names' belongs to needs for the types of 'types' it has no name for, each
// binding a name nothing in the file or an earlier import binds.
public importsFor(Type[] types, TypeNames names) -> ImportedNames {
    let unnamed = new List<DeclaredType>();
    for (let type in types) {
        collectUnnamed(type, names, unnamed);
    }
    TypeNames spelling = names;
    let written = new List<string>();
    for (let imported in unnamed) {
        string bound = freeNameFor(imported, spelling);
        string binding = imported.name();
        if (bound != imported.name()) {
            binding = "{imported.name()} as {bound}";
        }
        written.push("import {binding} from {names.importPathOf(imported)};");
        spelling = spelling.importing(imported, bound);
    }
    return new ImportedNames(written.toArray(), spelling);
}

// Adds each declared type the type mentions that this file has no name for, once.
collectUnnamed(Type type, TypeNames names, List<DeclaredType> found) {
    switch (type) {
        is OptionalType optional -> {
            collectUnnamed(optional.inner(), names, found);
        },
        is ArrayType array -> {
            collectUnnamed(array.element(), names, found);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                collectUnnamed(parameter, names, found);
            }
            for (let thrown in functionType.thrownTypes()) {
                collectUnnamed(thrown, names, found);
            }
            collectUnnamed(functionType.returnType(), names, found);
        },
        is InstantiationType instantiation -> {
            collectUnnamed(instantiation.template(), names, found);
            for (let argument in instantiation.arguments()) {
                collectUnnamed(argument, names, found);
            }
        },
        is DeclaredType declared -> {
            if (names.nameFor(declared) == null && !found.contains(declared)) {
                found.push(declared);
            }
        },
        default -> { },
    }
}

// The refusal of a member used on the external type 'declared', which has none. 'held' names what
// to pass to a C function instead.
public externalMemberMessage(DeclaredType declared, string held, TypeNames names) -> string {
    return "Cannot use a member of {names.quotedName(declared)} because it has no members: an external "
        + "type's contents belong to the C library. Pass {held} to a C function instead.";
}

// The refusal of the static 'name' read through 'head', a type that declares no static members.
public noStaticMembersMessage(Type head, string name, TypeNames names) -> string {
    string shown = names.quoted(head);
    string kind = "type";
    let authority = types.authorityOf(head);
    if (authority is ExternalType) {
        return "{names.quotedName(authority)} is an external type, and an external type has no members, "
            + "because its contents belong to the C library.";
    }
    if (authority != null) {
        kind = kindWordOf(authority);
        shown = names.quotedName(authority);
    }
    string holder = "a value of type {shown}";
    if (authority is InterfaceType) {
        holder = "a value of a class that implements {shown}";
    }
    return "{shown} is {typeArticle(kind)} {kind}, and {typeArticle(kind)} {kind} has no static members. "
        + "Call '{name}' on {holder}.";
}

// "an" before a type name that starts with a vowel sound, as 'int' does, and "a" otherwise.
public typeArticle(string type) -> string {
    if (type.startsWith("i") || type.startsWith("a") || type.startsWith("e") || type.startsWith("o")
            || type.startsWith("I") || type.startsWith("A") || type.startsWith("E") || type.startsWith("O")) {
        return "an";
    }
    return "a";
}

// The refusal for a name a type parameter took, with 'taken' naming the other meaning. Inside
// the declaration that introduces a type parameter, its name always means the type parameter.
public typeParameterTookNameMessage(string name, string ownerName, string taken) -> string {
    return "'{name}' means the type parameter of '{ownerName}' here, not {taken}, because inside "
        + "'{ownerName}' the name '{name}' always means the type parameter. Rename one of the two.";
}

// Where a meaning a refusal names is declared, read from the module the refusal is reported in.
public declaringPhrase(string kindWord, string modulePath, string readingModulePath) -> string {
    if (modulePath == readingModulePath) {
        return "the {kindWord} this file declares";
    }
    return "the {kindWord} declared in module '{modulePath}'";
}

// A module the file imports, as a refusal names it.
public importedModulePhrase(string modulePath) -> string {
    return "the module '{modulePath}' this file imports";
}

// The declaration keyword a diagnostic should use when it names a declared type's owner.
public kindWordOf(DeclaredType declared) -> string {
    return declared.kindWord();
}

// The names one file has for the program's declared types: what it declares, what its imports
// bind, and the modules whose types it names with no import written. A diagnostic reported in
// that file spells every type it names through these, so a fix it suggests is spelled as the
// file can write it.
export final class TypeNames {
    string namingFilePath;
    string namingModulePath;
    string namingPackagePrefix;
    TypeStore namingStore;

    // The modules whose types a bare name may resolve to, in the order unqualified resolution
    // reads them. Empty for names that belong to no file, which name no type at all.
    string[] implicitModulePaths;
    Map<DeclaredType, string> importedNames;
    Set<string> boundTypeNames;
    Set<string> boundModuleNames;

    public constructor(string filePath, string modulePath, string packagePrefix, TypeStore store,
                string[] implicitPaths, Map<DeclaredType, string> imported,
                Set<string> boundTypes, Set<string> boundModules) {
        this.namingFilePath = filePath;
        this.namingModulePath = modulePath;
        this.namingPackagePrefix = packagePrefix;
        this.namingStore = store;
        this.implicitModulePaths = implicitPaths;
        this.importedNames = imported;
        this.boundTypeNames = boundTypes;
        this.boundModuleNames = boundModules;
    }

    // The file these names belong to, which is the file a diagnostic spelled with them lands in.
    public filePath() -> string {
        return this.namingFilePath;
    }

    // The type as it reads in a diagnostic in this file, spelled the way the language writes it:
    // 'int', 'Box<string>?', 'Sort[]', 'Kind (from engine.kinds)', '(Sort) -> bool',
    // '((int) -> bool)?'.
    export of(Type type) -> string {
        return spelled(type, this, this);
    }

    // The nullable spelling of a type, for a diagnostic suggesting a type that allows null. It is
    // not always the type's own spelling with a '?' added, because a function type needs
    // parentheses first: '((int) -> bool)?' is a function reference that may be null, while
    // '(int) -> bool?' is a function whose return may be.
    public nullableOf(Type type) -> string {
        return spelledSuffixed(type, this, this) + "?";
    }

    // The type in quotes, spelled as this file names it, then the module of each type in it that
    // this file has no clear name for: 'Kind' (from sizes.b), 'Box<Kind>' (Kind from sizes.b).
    export quoted(Type type) -> string {
        return "'{spelled(type, this, null)}'{this.moduleNoteFor([type], true)}";
    }

    // The nullable spelling of a type in quotes, with the note quoted() writes after a type:
    // '((Kind) -> bool)?' (Kind from sizes.b).
    public quotedNullable(Type type) -> string {
        return "'{spelledSuffixed(type, this, null)}?'{this.moduleNoteFor([type], true)}";
    }

    // The name of a declared type without its type parameters in quotes, with the note quoted()
    // writes after a type: 'Box' (from sizes.c).
    public quotedName(DeclaredType declared) -> string {
        Type named = declared;
        return "'{this.plainNameOf(declared)}'{this.moduleNoteFor([named], true)}";
    }

    // Code in quotes, written as 'pieces' with each type of 'between' spelled between two of
    // them, then the module of each of those types that this file has no clear name for:
    // 'Root.limit' (Root from base).
    export quotedCode(string[] pieces, Type[] between) -> string {
        checkPieces(pieces.length, between.length);
        let code = new StringBuilder();
        for (long i = 0; i < between.length; i++) {
            code.append(pieces[i]);
            code.append(spelled(between[i], this, null));
        }
        code.append(pieces[between.length]);
        return "'{code.toString()}'{this.moduleNoteFor(between, false)}";
    }

    // Code in quotes, written as 'pieces' with each declared type of 'named' between two of them
    // by its name alone, without type parameters, then the module of each of those types that
    // this file has no clear name for: 'Box.make()' (Box from gamma.boxes).
    public quotedNamedCode(string[] pieces, DeclaredType[] named) -> string {
        checkPieces(pieces.length, named.length);
        let code = new StringBuilder();
        let writtenNames = new List<WrittenType>();
        for (long i = 0; i < named.length; i++) {
            string name = this.plainNameOf(named[i]);
            code.append(pieces[i]);
            code.append(name);
            writtenNames.push(new WrittenType(name, named[i]));
        }
        code.append(pieces[named.length]);
        return "'{code.toString()}'{this.noteOver(writtenNames, null)}";
    }

    // What follows a quote of the types in 'mentioned': ' (from sizes.b)' when 'quotesOneType'
    // and the quote writes no declared type but the one that needs its module, and ' (Kind from
    // sizes.b, Mode from sizes.d)' otherwise. Where one name is written for two types, the note
    // says which by position: ' (the second Kind from sizes.b)'. Empty when the file names every
    // type clearly.
    moduleNoteFor(Type[] mentioned, bool quotesOneType) -> string {
        let writtenNames = new List<WrittenType>();
        for (let type in mentioned) {
            collectWritten(type, this, writtenNames);
        }
        DeclaredType? head = null;
        if (quotesOneType) {
            head = headOf(mentioned[0]);
        }
        return this.noteOver(writtenNames, head);
    }

    // The note after a quote that writes 'writtenNames', in the forms moduleNoteFor describes. The
    // short form is only for a quote of one type that opens with 'head'.
    noteOver(List<WrittenType> writtenNames, DeclaredType? head) -> string {
        let noted = new List<DeclaredType>();
        for (let item in writtenNames) {
            let declared = item.declared;
            if (declared != null && this.needsModuleNote(declared) && !noted.contains(declared)) {
                noted.push(declared);
            }
        }
        if (noted.isEmpty()) {
            return "";
        }
        let entries = new StringBuilder();
        bool positioned = false;
        for (let declared in noted) {
            string name = this.plainNameOf(declared);
            let ordinals = new List<string>();
            bool shared = false;
            long seen = 0;
            for (let item in writtenNames) {
                if (item.written == name) {
                    seen++;
                    if (item.declared == declared) {
                        ordinals.push(diagnostics.ordinalWord(seen));
                    } else {
                        shared = true;
                    }
                }
            }
            if (!entries.isEmpty()) {
                entries.append(", ");
            }
            if (shared) {
                positioned = true;
                entries.append("the {diagnostics.andJoined(ordinals.toArray())} ");
            }
            entries.append("{name} from {this.importPathOf(declared)}");
        }
        if (head != null && noted.length() == 1 && !positioned) {
            let only = noted.first();
            bool alone = head == only;
            for (let item in writtenNames) {
                if (item.declared != null && item.declared != only) {
                    alone = false;
                }
            }
            if (alone) {
                return " (from {this.importPathOf(only)})";
            }
        }
        return " ({entries.toString()})";
    }

    // The name this file has for a declared type, without the type parameters its own spelling
    // carries, and with the module it comes from after it where the name alone does not say
    // which type it is.
    public nameOf(DeclaredType declared) -> string {
        return this.plainNameOf(declared) + this.moduleNoteOf(declared);
    }

    // What this file calls a declared type, or the type's own name where it calls it nothing.
    public plainNameOf(DeclaredType declared) -> string {
        return this.nameFor(declared) ?? declared.name();
    }

    // The module a diagnostic names after a type, as ' (from engine.sizing)', where this file
    // has no name for the type and that name alone does not say which type it is. Empty
    // everywhere else, so a type the reader can write reads as they would write it.
    public moduleNoteOf(DeclaredType declared) -> string {
        if (this.needsModuleNote(declared)) {
            return " (from {declared.modulePath()})";
        }
        return "";
    }

    // Whether a diagnostic in this file names the type's module beside it: the file has no name
    // for the type, and the type's own name means something else here or names another type too.
    needsModuleNote(DeclaredType declared) -> bool {
        if (this.nameFor(declared) != null) {
            return false;
        }
        return this.bindsTypeName(declared.name()) || this.namingStore.isRepeatedName(declared.name());
    }

    // The name this file writes for a declared type, or null when no declaration or import of
    // this file binds it.
    public nameFor(DeclaredType declared) -> string? {
        if (declared is PrimitiveBinding) {
            return declared.name();
        }
        if (declared.modulePath() == this.namingModulePath) {
            return declared.name();
        }
        let imported = this.importedNames.get(declared);
        if (imported != null) {
            return imported;
        }
        if (this.bareNameResolvesTo(declared)) {
            return declared.name();
        }
        return null;
    }

    // Whether this file already gives the name a meaning of its own, through a declaration, an
    // import, or an implicitly imported module. An import that binds another type under that
    // name needs an alias, and a diagnostic naming that other type says which module it is in.
    public bindsTypeName(string name) -> bool {
        if (this.namingStore.findDeclared(this.namingModulePath, name) != null) {
            return true;
        }
        if (this.boundTypeNames.contains(name) || this.boundModuleNames.contains(name)) {
            return true;
        }
        return this.implicitlyImportedType(name) != null;
    }

    // The path an import written in this file spells for the type's module, with the '@' a
    // module in another package takes.
    public importPathOf(DeclaredType declared) -> string {
        string packageName = declared.packagePrefix();
        if (packageName.length == 0) {
            return declared.modulePath();
        }
        if (packageName != this.namingPackagePrefix) {
            return "@{declared.modulePath()}";
        }
        string inside = "{packageName}.";
        if (declared.modulePath().startsWith(inside)) {
            return declared.modulePath().substring(inside.length);
        }
        return declared.modulePath();
    }

    // These names with one more import, which binds the type under 'bound'. A diagnostic that
    // suggests writing the import spells its code with them.
    public importing(DeclaredType declared, string bound) -> TypeNames {
        let imported = this.importedNames.copy();
        imported.set(declared, bound);
        let boundTypes = this.boundTypeNames.copy();
        boundTypes.add(bound);
        return new TypeNames(this.namingFilePath, this.namingModulePath, this.namingPackagePrefix,
            this.namingStore, this.implicitModulePaths, imported, boundTypes, this.boundModuleNames);
    }

    // Whether this file can write the type, which a diagnostic offering code to paste has to
    // know. A declared type the file has no name for reads by its own name, which resolves to
    // something else here or to nothing at all.
    public canSpell(Type type) -> bool {
        switch (type) {
            is OptionalType optional -> {
                return this.canSpell(optional.inner());
            },
            is ArrayType array -> {
                return this.canSpell(array.element());
            },
            is FunctionType functionType -> {
                for (let parameter in functionType.parameterTypes()) {
                    if (!this.canSpell(parameter)) {
                        return false;
                    }
                }
                for (let thrown in functionType.thrownTypes()) {
                    if (!this.canSpell(thrown)) {
                        return false;
                    }
                }
                return this.canSpell(functionType.returnType());
            },
            is DeclaredType declared -> {
                return this.nameFor(declared) != null;
            },
            is InstantiationType instantiation -> {
                if (this.nameFor(instantiation.template()) == null) {
                    return false;
                }
                for (let argument in instantiation.arguments()) {
                    if (!this.canSpell(argument)) {
                        return false;
                    }
                }
                return true;
            },
            // A type parameter belongs to a declaration rather than to a file, so these names
            // cannot say whether one is in scope. The null and error types have no spelling a
            // file writes at all.
            is TypeParamType ignored -> {
                return false;
            },
            is NullType ignored -> {
                return false;
            },
            is ErrorType ignored -> {
                return false;
            },
            default -> {
                return true;
            },
        }
    }

    // Whether the bare name resolves to this very type here: the file declares nothing else
    // under it, no import binds it, and an implicitly imported module is what carries it.
    bareNameResolvesTo(DeclaredType declared) -> bool {
        string name = declared.name();
        if (this.namingStore.findDeclared(this.namingModulePath, name) != null) {
            return false;
        }
        if (this.boundTypeNames.contains(name)) {
            return false;
        }
        return this.implicitlyImportedType(name) == declared;
    }

    // The type an implicitly imported module contributes under this name here, or null when none
    // of them does; the resolver's own fallback, read the same way.
    implicitlyImportedType(string name) -> DeclaredType? {
        for (let modulePath in this.implicitModulePaths) {
            let declared = this.namingStore.findDeclared(modulePath, name);
            if (declared != null && this.reaches(declared)) {
                return declared;
            }
        }
        return null;
    }

    // Whether this file may name the type at all, by the visibility it was declared with.
    reaches(DeclaredType declared) -> bool {
        return types.isVisibleFrom(declared.visibility(), declared.modulePath(),
            declared.packagePrefix(), this.namingModulePath, this.namingPackagePrefix);
    }
}

// The names every file of one program has for its types, for a diagnostic built outside the file
// it lands in. A file this program never linked names nothing but the primitive bindings, whose
// names are keywords, and spells every other declared type by its own name, because nothing
// records what that file could write.
export final class TypeNameDirectory {
    Map<string, TypeNames> namesByFile;
    TypeNames unnamedFile;

    public constructor(TypeNames[] files, TypeStore store) {
        this.namesByFile = new Map<string, TypeNames>();
        for (let names in files) {
            this.namesByFile.set(names.filePath(), names);
        }
        this.unnamedFile = new TypeNames("", "", "", store, [],
            new Map<DeclaredType, string>(), new Set<string>(), new Set<string>());
    }

    // The names of the file at this path.
    export namesFor(string filePath) -> TypeNames {
        return this.namesByFile.get(filePath) ?? this.unnamedFile;
    }
}

// The type as it reads where no file names it: every declared type by its own declared name. For
// an EIR dump and for an 'Internal:' message; a diagnostic spells a type through the names of the
// file it is reported in, which is what TypeNames supplies.
export display(Type type) -> string {
    return spelled(type, null, null);
}

// names is the file the spelling is for, or null where no file names the type, and notes the names
// a module note is read from, or null for a spelling with none.
spelled(Type type, TypeNames? names, TypeNames? notes) -> string {
    switch (type) {
        is PrimitiveType primitive -> {
            return primitiveName(primitive.kind());
        },
        is StringType ignored -> {
            return "string";
        },
        is NullType ignored -> {
            return "null";
        },
        is ErrorType ignored -> {
            return "<error>";
        },
        is OptionalType optional -> {
            return spelledSuffixed(optional.inner(), names, notes) + "?";
        },
        is ArrayType array -> {
            return spelledSuffixed(array.element(), names, notes) + "[]";
        },
        is FunctionType functionType -> {
            let builder = new StringBuilder();
            builder.append("(");
            Type[] parameters = functionType.parameterTypes();
            for (long i = 0; i < parameters.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append(spelled(parameters[i], names, notes));
            }
            builder.append(") -> ");
            builder.append(spelled(functionType.returnType(), names, notes));
            Type[] thrown = functionType.thrownTypes();
            for (long i = 0; i < thrown.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                } else {
                    builder.append(" throws ");
                }
                builder.append(spelled(thrown[i], names, notes));
            }
            return builder.toString();
        },
        is DeclaredType declared -> {
            return spelledDeclared(declared, names, notes);
        },
        is TypeParamType parameter -> {
            return parameter.name();
        },
        is InstantiationType instantiation -> {
            let builder = new StringBuilder();
            builder.append(nameIn(instantiation.template(), names));
            builder.append("<");
            Type[] arguments = instantiation.arguments();
            for (long i = 0; i < arguments.length; i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append(spelled(arguments[i], names, notes));
            }
            builder.append(">");
            builder.append(moduleNoteIn(instantiation.template(), notes));
            return builder.toString();
        },
    }
}

// A generic template is spelled at its own type parameters, so it reads 'Box<T>' rather than 'Box'.
spelledDeclared(DeclaredType declared, TypeNames? names, TypeNames? notes) -> string {
    string[] parameters = declared.typeParameters();
    if (parameters.length == 0) {
        return nameIn(declared, names) + moduleNoteIn(declared, notes);
    }
    let builder = new StringBuilder();
    builder.append(nameIn(declared, names));
    builder.append("<");
    for (long i = 0; i < parameters.length; i++) {
        if (i > 0) {
            builder.append(", ");
        }
        builder.append(parameters[i]);
    }
    builder.append(">");
    builder.append(moduleNoteIn(declared, notes));
    return builder.toString();
}

nameIn(DeclaredType declared, TypeNames? names) -> string {
    if (names == null) {
        return declared.name();
    }
    return names.plainNameOf(declared);
}

// The module a spelling names after a type, which follows the type arguments the type carries
// so that a generic reads 'Box<int> (from engine.boxes)'.
moduleNoteIn(DeclaredType declared, TypeNames? notes) -> string {
    if (notes == null) {
        return "";
    }
    return notes.moduleNoteOf(declared);
}

// A type under a '?' or '[]' suffix. A function type takes parentheses there, because the
// suffixes of the written form bind to the return type instead.
spelledSuffixed(Type type, TypeNames? names, TypeNames? notes) -> string {
    if (type is FunctionType) {
        return "(" + spelled(type, names, notes) + ")";
    }
    return spelled(type, names, notes);
}

// Refuses a quotedCode or quotedNamedCode call whose pieces do not surround its types, one more
// piece than types.
checkPieces(long pieces, long types) {
    if (pieces != types + 1) {
        panic("Internal: quoted code needs one more piece than types, but has {pieces} pieces for "
            + "{types} types");
    }
}

// Code a diagnostic quotes, written a piece at a time with the types it spells in between, for
// TypeNames.quotedCode to quote with the module note of those types.
public final class QuotedCode {
    List<string> pieces;
    List<Type> spelledTypes;
    string current;

    public constructor() {
        this.pieces = new List<string>();
        this.spelledTypes = new List<Type>();
        this.current = "";
    }

    public write(string text) {
        this.current = this.current + text;
    }

    public writeType(Type type) {
        this.pieces.push(this.current);
        this.current = "";
        this.spelledTypes.push(type);
    }

    // The code in quotes, then the module of each type it spells that 'names' has no clear name for.
    public quotedFor(TypeNames names) -> string {
        let all = new List<string>();
        for (let piece in this.pieces) {
            all.push(piece);
        }
        all.push(this.current);
        return names.quotedCode(all.toArray(), this.spelledTypes.toArray());
    }
}

// A name a spelling writes, with the declared type it names, or null for a type parameter, which a
// declared type of the same name can be taken for.
final class WrittenType {
    string written;
    DeclaredType? declared;

    constructor(this.written, this.declared);
}

// Adds each name the spelling of 'type' writes, in the order the spelling writes them.
collectWritten(Type type, TypeNames names, List<WrittenType> found) {
    switch (type) {
        is OptionalType optional -> {
            collectWritten(optional.inner(), names, found);
        },
        is ArrayType array -> {
            collectWritten(array.element(), names, found);
        },
        is FunctionType functionType -> {
            for (let parameter in functionType.parameterTypes()) {
                collectWritten(parameter, names, found);
            }
            collectWritten(functionType.returnType(), names, found);
            for (let thrown in functionType.thrownTypes()) {
                collectWritten(thrown, names, found);
            }
        },
        is DeclaredType declared -> {
            found.push(new WrittenType(names.plainNameOf(declared), declared));
            for (let parameter in declared.typeParameters()) {
                found.push(new WrittenType(parameter, null));
            }
        },
        is TypeParamType parameter -> {
            found.push(new WrittenType(parameter.name(), null));
        },
        is InstantiationType instantiation -> {
            let template = instantiation.template();
            found.push(new WrittenType(names.plainNameOf(template), template));
            for (let argument in instantiation.arguments()) {
                collectWritten(argument, names, found);
            }
        },
        default -> { },
    }
}

// The declared type a spelling of 'type' opens with once its '?' and '[]' are set aside, or null
// where it opens with something else, such as a function type.
headOf(Type type) -> DeclaredType? {
    switch (type) {
        is OptionalType optional -> {
            return headOf(optional.inner());
        },
        is ArrayType array -> {
            return headOf(array.element());
        },
        is DeclaredType declared -> {
            return declared;
        },
        is InstantiationType instantiation -> {
            return instantiation.template();
        },
        default -> {
            return null;
        },
    }
}

public primitiveName(PrimitiveKind kind) -> string {
    return switch (kind) {
        Bool -> "bool",
        Byte -> "byte",
        Short -> "short",
        UShort -> "ushort",
        Int -> "int",
        UInt -> "uint",
        Long -> "long",
        ULong -> "ulong",
        Float -> "float",
        Double -> "double",
        Decimal -> "decimal",
        Char -> "char",
        Void -> "void",
    };
}
