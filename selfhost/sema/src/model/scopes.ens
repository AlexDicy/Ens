// Lexical scopes for body checking. A binding is one named value in reach (a parameter, a local
// variable, a foreach element, a type-switch arm binding, a catch binding, or a sibling field
// inside a field default), and its identity is what side tables and later narrowing key on.
import Span from @ens.frontend.support.source;
import Type from model.types;
import Map from @std.collections.map;

// What a name in reach stands for. A sibling field is a field named on its own inside the
// default of another field of the same type.
public enum BindingKind {
    Parameter,
    Variable,
    SiblingField,
}

export class LocalBinding {
    string bindingName;
    Type bindingType;
    BindingKind bindingKind;
    bool constant;
    Span bindingNameSpan;

    public constructor(string name, Type type, BindingKind kind, bool isConst, Span nameSpan) {
        this.bindingName = name;
        this.bindingType = type;
        this.bindingKind = kind;
        this.constant = isConst;
        this.bindingNameSpan = nameSpan;
    }

    export name() -> string {
        return this.bindingName;
    }

    export type() -> Type {
        return this.bindingType;
    }

    public kind() -> BindingKind {
        return this.bindingKind;
    }

    export isConst() -> bool {
        return this.constant;
    }

    nameSpan() -> Span {
        return this.bindingNameSpan;
    }
}

// One lexical scope. Lookup walks outward through the parent chain.
public class Scope {
    Scope? parentScope;
    Map<string, LocalBinding> bindings;

    public constructor(Scope? parent) {
        this.parentScope = parent;
        this.bindings = new Map<string, LocalBinding>();
    }

    public parent() -> Scope? {
        return this.parentScope;
    }

    // False when the name is already bound in this scope; the caller diagnoses.
    public define(LocalBinding binding) -> bool {
        if (this.bindings.contains(binding.name())) {
            return false;
        }
        this.bindings.set(binding.name(), binding);
        return true;
    }

    public lookupLocal(string name) -> LocalBinding? {
        return this.bindings.get(name);
    }

    public lookup(string name) -> LocalBinding? {
        Scope? current = this;
        while (current != null) {
            let found = current.lookupLocal(name);
            if (found != null) {
                return found;
            }
            current = current.parent();
        }
        return null;
    }
}
