// Which declaration replaces a behavior the language provides for every class, 'toString', 'hash'
// and 'equals', whether a declaration of the program can run for one of them, and whether a subclass
// can replace the method an object of a class runs.
import model.hierarchy;
import model.typemembers;
import Method from model.typemembers;
import model.types;
import Type from model.types;
import ClassType from model.types;
import InstantiationType from model.types;
import PrimitiveKind from model.types;
import PrimitiveType from model.types;
import StringType from model.types;
import Visibility from model.types;

// The declaration a class carries for one of those behaviors: the nearest one down its chain, an
// abstract one included so a caller can still dispatch it through the vtable. Null when no class
// in the chain declares one, and for a type that is not a class, such as an interface, whose
// methods only describe what its implementers carry. A nullable class reads as the class it holds.
export declaredBehavior(Type type, string name) -> Method? {
    Type? current = types.classOf(type);
    while (current != null) {
        let methods = typemembers.methodsOf(current);
        if (methods == null) {
            return null;
        }
        for (let method in methods) {
            if (declaresBehavior(current, method, name)) {
                return method;
            }
        }
        current = hierarchy.baseOf(current);
    }
    return null;
}

// Whether the behavior 'name' can run a declaration of the program for an object whose class is
// 'owner', rather than the form the language provides.
export runsDeclaredBehavior(Type owner, string name) -> bool {
    return declaredBehavior(owner, name) != null || canHaveSubclasses(owner);
}

// Whether a subclass can replace 'method' for an object whose class is 'owner': 'owner' is a class
// that is not 'final', and 'method' is an instance method its subclasses inherit that is not
// 'final' either.
export subclassCanReplace(Type owner, Method method) -> bool {
    return canHaveSubclasses(owner) && !method.isFinal() && !method.isStatic()
        && !method.isConditional() && method.visibility() != Visibility.Private;
}

// Whether 'type' is a class that is not 'final'.
canHaveSubclasses(Type type) -> bool {
    let shape = types.classOf(type);
    if (shape == null) {
        return false;
    }
    let authority = types.authorityOf(shape);
    return authority is ClassType && !authority.isFinal();
}

// True when a method declared on 'owner' has exactly the signature of the behavior the language
// calls under its name. 'throws' never qualifies: these run where there is no room for a 'try'.
// A 'toString' additionally has to write the 'override' marker; a class 'toString' without it is
// an ordinary method the dispatch never reads.
declaresBehavior(Type owner, Method method, string name) -> bool {
    if (method.name() != name || method.isConstructor() || method.isDestructor()) {
        return false;
    }
    if (name == "toString" && !method.isOverride()) {
        return false;
    }
    let signature = method.signature();
    if (signature.declaresThrows()) {
        return false;
    }
    let parameters = signature.parameters();
    if (name == "equals") {
        return parameters.length == 1 && isPrimitive(signature.returnType(), PrimitiveKind.Bool)
            && isOwnType(owner, parameters[0].type());
    }
    if (parameters.length != 0) {
        return false;
    }
    if (name == "hash") {
        return isPrimitive(signature.returnType(), PrimitiveKind.Long);
    }
    return signature.returnType() is StringType;
}

isPrimitive(Type type, PrimitiveKind kind) -> bool {
    return type is PrimitiveType && type.kind() == kind;
}

// Whether a parameter has the owner's own type. Inside a generic class that type is written with
// the class's own type parameters, as 'Pair<T>' is inside 'Pair<T>'.
isOwnType(Type owner, Type parameterType) -> bool {
    let parameterClass = types.classOf(parameterType);
    if (parameterClass == owner) {
        return true;
    }
    if (!(owner is ClassType) || !(parameterClass is InstantiationType)
            || parameterClass.template() != owner) {
        return false;
    }
    let own = owner.typeParameterTypes();
    let arguments = parameterClass.arguments();
    if (arguments.length != own.length) {
        return false;
    }
    for (long i = 0; i < own.length; i++) {
        if (arguments[i] != own[i]) {
            return false;
        }
    }
    return true;
}
