// Which of a program's semantic diagnostics answer for the program the author wrote, when the
// parser had to guess at part of it.
//
// The parser recovers rather than stopping, so a file with a syntax error still has a tree and sema
// can walk it. Some of that tree is the parser's guess, and a semantic diagnostic about a guess
// says nothing about the author's program: it is a consequence of the syntax error. Reporting one
// is worse than reporting nothing, because the error count then grows as the author fixes things
// and the compiler stops being worth believing. So sema answers only for what parsed soundly.
//
// A guess is confined to a body when it sits between the braces of a block the source actually
// wrote. Nothing outside such a block can see what is inside it - a body declares nothing, changes
// no signature, and is invisible to every other declaration - so the guess cannot be behind a
// diagnostic anywhere else, and dropping the diagnostics of the one function owning the body is
// enough. Every other guess changes what the file declares: a name or type the parser invented,
// junk between declarations, or a bracket that never arrived and swallowed the rest of the file. A
// reference to any of it could sit anywhere in the program, so nothing semantic is worth reporting
// at all and the syntax errors stand on their own.
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import GreenElement from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import @ens.frontend.syntax.generated.kind;
import RecoveryScope from @ens.frontend.parse.recovery;
import ParseResult from @ens.frontend.parse.parser;
import GraphResult from program.graph;
import List from @std.collections.list;
import Map from @std.collections.map;

// What a program's parse leaves worth analyzing.
export final class ProgramTrust {
    bool programAnalyzable;
    Map<string, Span[]> quietPerFile;

    protected constructor(bool analyzable, Map<string, Span[]> quiet) {
        this.programAnalyzable = analyzable;
        this.quietPerFile = quiet;
    }

    // Whether any semantic diagnostic at all can be trusted. False when a guess reaches past the
    // one body it sits in, so what the program declares is the parser's answer, not the author's.
    export analyzable() -> bool {
        return this.programAnalyzable;
    }

    // Whether a diagnostic at this position is a consequence of a syntax error rather than a
    // problem of its own: it belongs to a declaration whose body the parser had to guess at.
    export quiets(string file, Span span) -> bool {
        let declarations = this.quietPerFile.get(file);
        if (declarations == null) {
            return false;
        }
        for (let declaration in declarations) {
            if (span.start >= declaration.start && span.start < declaration.end()) {
                return true;
            }
        }
        return false;
    }
}

// Reads every module's parse and answers what is worth analyzing. A graph diagnostic counts
// against the whole program the same way an unclosed bracket does: a manifest the compiler could
// not read or an import that resolved to nothing leaves names undefined everywhere, so every
// diagnostic about them would be a consequence of that.
export assess(GraphResult graphResult) -> ProgramTrust {
    let quiet = new Map<string, Span[]>();
    bool analyzable = graphResult.diagnostics().length == 0;
    for (let module in graphResult.modules()) {
        let parsed = module.parseResult();
        // The diagnostics decide whether the walk is needed, not the recoveries: an error node is
        // a region the parser skipped, so it reports without inventing a token, and a file holding
        // one has a diagnostic and no recovery. Keying this on the recoveries would trust junk
        // between declarations. Nothing the walk looks for is ever silent, so a file that reported
        // nothing has nothing to find.
        if (parsed.diagnostics().length == 0) {
            continue;
        }
        let verdict = assessFile(parsed);
        if (!verdict.confined) {
            analyzable = false;
        }
        quiet.set(module.filePath(), verdict.quiet.toArray());
    }
    return new ProgramTrust(analyzable, quiet);
}

// One file's verdict: whether every guess in it stayed inside a body, and the declarations owning
// the bodies that hold one.
class FileVerdict {
    protected bool confined;
    protected List<Span> quiet;

    protected constructor(bool confined, List<Span> quiet) {
        this.confined = confined;
        this.quiet = quiet;
    }
}

assessFile(ParseResult parsed) -> FileVerdict {
    let walk = new BodyWalk();
    walk.visit(parsed.root(), 0, null, null);
    bool confined = walk.errorNodesConfined;
    for (let recovery in parsed.recoveries()) {
        if (recovery.scope() == RecoveryScope.File) {
            confined = false;
            continue;
        }
        let owner = walk.ownerAt(recovery.span().start);
        if (owner == null) {
            confined = false;
        } else {
            walk.quiet.push(owner);
        }
    }
    return new FileVerdict(confined, walk.quiet);
}

// The interior of one block whose braces the source wrote, and the declaration owning it.
class BodyRegion {
    protected Span interior;
    protected Span owner;

    protected constructor(this.interior, this.owner);
}

// One pass over the green tree: the bodies a guess can hide in, and whether every error node sits
// in one. An error node is a region the parser skipped rather than a token it invented, so the tree
// carries it instead of the recovery list.
class BodyWalk {
    List<BodyRegion> bodies;
    protected List<Span> quiet;
    protected bool errorNodesConfined;

    protected constructor() {
        this.bodies = new List<BodyRegion>();
        this.quiet = new List<Span>();
        this.errorNodesConfined = true;
    }

    protected visit(GreenElement element, long fullStart, Span? declaration, Span? bodyOwner) {
        if (!(element is GreenNode)) {
            return;
        }
        if (kind.isErrorKind(element.kind())) {
            if (bodyOwner == null) {
                this.errorNodesConfined = false;
            } else {
                this.quiet.push(bodyOwner);
            }
            return;
        }
        Span? owning = declaration;
        if (ownsBodies(element.kind())) {
            owning = source.makeSpan(fullStart, element.fullLength());
        }
        Span? inside = bodyOwner;
        if (element.kind() == SyntaxKind.Block && owning != null) {
            let interior = soundInterior(element, fullStart);
            if (interior != null) {
                this.bodies.push(new BodyRegion(interior, owning));
                inside = owning;
            }
        }
        long offset = fullStart;
        for (long i = 0; i < element.slotCount(); i++) {
            let child = element.slot(i);
            if (child != null) {
                this.visit(child, offset, owning, inside);
                offset = offset + child.fullLength();
            }
        }
    }

    // The declaration owning the narrowest body holding this offset, or null when no body does.
    protected ownerAt(long offset) -> Span? {
        Span? owner = null;
        long narrowest = -1;
        for (long i = 0; i < this.bodies.length(); i++) {
            let body = this.bodies.get(i);
            if (offset < body.interior.start || offset > body.interior.end()) {
                continue;
            }
            long width = body.interior.end() - body.interior.start;
            if (narrowest < 0 || width < narrowest) {
                narrowest = width;
                owner = body.owner;
            }
        }
        return owner;
    }
}

// A block's interior when the source wrote both braces: everything between them, where a guess
// stays invisible to the rest of the file. Null when either brace is a placeholder, because then
// the block's extent is the parser's answer and what it holds could belong anywhere.
soundInterior(GreenNode block, long fullStart) -> Span? {
    long last = block.slotCount() - 1;
    if (last < 1) {
        return null;
    }
    let open = block.slot(0);
    let close = block.slot(last);
    if (!(open is GreenToken)) {
        return null;
    }
    if (!(close is GreenToken)) {
        return null;
    }
    if (open.kind() == SyntaxKind.Missing || close.kind() == SyntaxKind.Missing) {
        return null;
    }
    long interiorStart = fullStart + open.fullLength();
    long interiorEnd = fullStart + block.fullLength() - close.fullLength();
    return source.makeSpan(interiorStart, interiorEnd - interiorStart);
}

// The declarations a block can be the body of. A catch clause's block and every nested block belong
// to the function around them, so their guesses are the function's too.
ownsBodies(SyntaxKind nodeKind) -> bool {
    return nodeKind == SyntaxKind.FunctionDeclaration || nodeKind == SyntaxKind.TestDeclaration;
}
