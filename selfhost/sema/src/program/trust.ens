// Which of a program's semantic diagnostics are about the program the author wrote, when the
// parser had to guess at part of it. A diagnostic about a guess is a consequence of the syntax
// error rather than a problem of its own, so sema reports only on what parsed soundly.
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import GreenElement from @ens.frontend.syntax.green;
import GreenNode from @ens.frontend.syntax.green;
import GreenToken from @ens.frontend.syntax.green;
import SyntaxKind from @ens.frontend.syntax.generated.kind;
import @ens.frontend.syntax.generated.kind;
import RecoveryScope from @ens.frontend.parse.recovery;
import ParseResult from @ens.frontend.parse.parser;
import GraphResult from program.graph;
import List from @std.collections.list;
import Map from @std.collections.map;

// What a program's parse leaves worth analyzing.
export final class ProgramTrust {
    bool programAnalyzable;
    // The declarations whose diagnostics are dropped, by file, in the order they start and none inside
    // another.
    Map<string, Span[]> quietPerFile;

    protected constructor(bool analyzable, Map<string, Span[]> quiet) {
        this.programAnalyzable = analyzable;
        this.quietPerFile = quiet;
    }

    // Whether any semantic diagnostic at all is reliable. False when a guess reaches past the
    // one body it is in, so what the program declares is the parser's reading, not the author's.
    export analyzable() -> bool {
        return this.programAnalyzable;
    }

    // Whether a diagnostic at this position belongs to a declaration whose body the parser had to
    // guess at. A body declares nothing and is invisible to every other declaration, so dropping
    // that one declaration's diagnostics is enough. Any other guess changes what the file
    // declares, and then nothing semantic is worth reporting at all.
    export quiets(string file, Span span) -> bool {
        let declarations = this.quietPerFile.get(file);
        if (declarations == null) {
            return false;
        }
        long low = 0;
        long high = declarations.length - 1;
        long found = -1;
        while (low <= high) {
            long middle = (low + high) / 2;
            if (declarations[middle].start <= span.start) {
                found = middle;
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        return found >= 0 && span.start < declarations[found].end();
    }
}

// A graph diagnostic counts against the whole program the same way an unclosed bracket does. A
// manifest the compiler could not read, or an import that resolved to nothing, leaves names
// undefined everywhere, so every diagnostic about them would be a consequence of that.
export assess(GraphResult graphResult) -> ProgramTrust {
    let quiet = new Map<string, Span[]>();
    bool analyzable = graphResult.diagnostics().length == 0;
    for (let module in graphResult.modules()) {
        let parsed = module.parseResult();
        // The diagnostics determine whether the walk is needed, not the recoveries: an error node is
        // a region the parser skipped, so it reports without inventing a token, and a file holding
        // one has a diagnostic and no recovery. Keying this on the recoveries would accept junk
        // between declarations. Nothing the walk searches for is ever silent, so a file that reported
        // nothing has nothing to find.
        if (parsed.diagnostics().length == 0) {
            continue;
        }
        let verdict = assessFile(parsed);
        if (!verdict.confined) {
            analyzable = false;
        }
        quiet.set(module.filePath(), outermost(verdict.quiet));
    }
    return new ProgramTrust(analyzable, quiet);
}

// The spans of 'spans' that no other one holds, in the order they start.
outermost(List<Span> spans) -> Span[] {
    let ordered = spans.sorted((first, second) -> spanOrder(first, second));
    let kept = new List<Span>();
    for (let span in ordered) {
        if (kept.isEmpty() || span.end() > kept.last().end()) {
            kept.push(span);
        }
    }
    return kept.toArray();
}

// Whether 'first' comes before 'second': by where they start, then the wider first.
spanOrder(Span first, Span second) -> int {
    if (first.start != second.start) {
        return first.start < second.start ? -1 : 1;
    }
    if (first.length != second.length) {
        return first.length > second.length ? -1 : 1;
    }
    return 0;
}

// One file's verdict: whether every guess in it stayed inside a body, and the declarations owning
// the bodies that hold one.
class FileVerdict {
    protected bool confined;
    protected List<Span> quiet;

    protected constructor(bool confined, List<Span> quiet) {
        this.confined = confined;
        this.quiet = quiet;
    }
}

assessFile(ParseResult parsed) -> FileVerdict {
    let walk = new BodyWalk();
    walk.visit(parsed.root(), 0, null, -1);
    bool confined = walk.errorNodesConfined;
    for (let recovery in parsed.recoveries()) {
        if (recovery.scope() == RecoveryScope.File) {
            confined = false;
            continue;
        }
        let owner = walk.ownerAt(recovery.span().start);
        if (owner == null) {
            confined = false;
        } else {
            walk.quiet.push(owner);
        }
    }
    return new FileVerdict(confined, walk.quiet);
}

// The interior of one block whose '{' the source wrote, the declaration owning it, and the index of the
// body around it, or -1 where none is.
class BodyRegion {
    protected Span interior;
    protected Span owner;
    protected long enclosing;

    protected constructor(this.interior, this.owner, this.enclosing);
}

// One pass over the green tree: the bodies a guess can hide in, in the order their blocks start, and
// whether every error node is in one. An error node is a region the parser skipped rather than a token
// it invented, so the tree carries it instead of the recovery list.
class BodyWalk {
    List<BodyRegion> bodies;
    protected List<Span> quiet;
    protected bool errorNodesConfined;

    protected constructor() {
        this.bodies = new List<BodyRegion>();
        this.quiet = new List<Span>();
        this.errorNodesConfined = true;
    }

    // Visits 'element', inside the body at the index 'body' of the bodies, or -1 for none.
    protected visit(GreenElement element, long fullStart, Span? declaration, long body) {
        if (!(element is GreenNode)) {
            return;
        }
        if (kind.isErrorKind(element.kind())) {
            if (body < 0) {
                this.errorNodesConfined = false;
            } else {
                this.quiet.push(this.bodies.get(body).owner);
            }
            return;
        }
        Span? owning = declaration;
        if (ownsBodies(element.kind())) {
            owning = source.makeSpan(fullStart, element.fullLength());
        }
        long inside = body;
        if (element.kind() == SyntaxKind.Block && owning != null) {
            let interior = soundInterior(element, fullStart);
            if (interior != null) {
                inside = this.bodies.length();
                this.bodies.push(new BodyRegion(interior, owning, body));
            }
        }
        long offset = fullStart;
        for (long i = 0; i < element.slotCount(); i++) {
            let child = element.slot(i);
            if (child != null) {
                this.visit(child, offset, owning, inside);
                offset = offset + child.fullLength();
            }
        }
    }

    // The declaration owning the narrowest body holding this offset, or null when no body does. That
    // body is the last one to start at or before the offset, or a body around it.
    protected ownerAt(long offset) -> Span? {
        long low = 0;
        long high = this.bodies.length() - 1;
        long found = -1;
        while (low <= high) {
            long middle = (low + high) / 2;
            if (this.bodies.get(middle).interior.start <= offset) {
                found = middle;
                low = middle + 1;
            } else {
                high = middle - 1;
            }
        }
        while (found >= 0) {
            let body = this.bodies.get(found);
            if (offset <= body.interior.end()) {
                return body.owner;
            }
            found = body.enclosing;
        }
        return null;
    }
}

// A block's interior when the source wrote its '{': everything after it, where a guess stays
// invisible to the rest of the file. A '}' the parser left missing ends the block at the next
// declaration header, or at the end of the file, which records a guess about the whole file too.
// Null when the '{' is a placeholder, because then what the block holds could belong anywhere.
soundInterior(GreenNode block, long fullStart) -> Span? {
    long last = block.slotCount() - 1;
    if (last < 1) {
        return null;
    }
    let open = block.slot(0);
    let close = block.slot(last);
    if (!(open is GreenToken)) {
        return null;
    }
    if (!(close is GreenToken)) {
        return null;
    }
    if (open.kind() == SyntaxKind.Missing) {
        return null;
    }
    long interiorStart = fullStart + open.fullLength();
    long interiorEnd = fullStart + block.fullLength() - close.fullLength();
    return source.makeSpan(interiorStart, interiorEnd - interiorStart);
}

// The declarations a block can be the body of. A catch clause's block and every nested block belong
// to the function around them, so their guesses are the function's too.
ownsBodies(SyntaxKind nodeKind) -> bool {
    return nodeKind == SyntaxKind.FunctionDeclaration || nodeKind == SyntaxKind.TestDeclaration;
}
