// The module graph: a breadth-first walk from seed files that loads and parses every reachable
// module exactly once. A module is named by canonical path, so a package's bare sibling import and
// an external '@alias.module' import land on the same module. Nothing is written to shared state.
import Source from @ens.frontend.support.source;
import Span from @ens.frontend.support.source;
import @ens.frontend.support.source;
import @ens.frontend.parse.parser;
import ParseResult from @ens.frontend.parse.parser;
import @ens.frontend.syntax.generated.factory;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import ImportDeclarationNode from @ens.frontend.syntax.generated.nodes;
import ImportPathNode from @ens.frontend.syntax.generated.nodes;
import TopLevelItem from @ens.frontend.syntax.generated.nodes;
import FileLoader from support.loader;
import FileError from support.loader;
import FileDiagnostic from support.diagnostics;
import support.diagnostics;
import Workspace from program.workspace;
import WorkspaceLoader from program.workspace;
import NativeInfo from program.workspace;
import PackageSources from program.workspace;
import program.workspace;
import StandardLibrary from program.implicit;
import program.implicit;
import support.paths;
import @std.path;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import StringBuilder from @std.text.stringbuilder;

// One loaded and parsed module. The parse result is kept for the later sema phases; red trees are
// rebuilt over it on demand and never stored.
export class Module {
    string moduleCanonicalPath;
    string moduleFilePath;
    string modulePackagePrefix;
    Source moduleSource;
    ParseResult moduleParseResult;
    string[] moduleImports;
    string?[] moduleImportTargets;
    bool restrictedNatives;
    string[] moduleNativeNames;
    string moduleManifestPath;

    public constructor(string canonicalPath, string filePath, string packagePrefix, Source source,
                ParseResult parseResult, string[] imports, string?[] importTargets) {
        this.moduleCanonicalPath = canonicalPath;
        this.moduleFilePath = filePath;
        this.modulePackagePrefix = packagePrefix;
        this.moduleSource = source;
        this.moduleParseResult = parseResult;
        this.moduleImports = imports;
        this.moduleImportTargets = importTargets;
        this.restrictedNatives = false;
        this.moduleNativeNames = [];
        this.moduleManifestPath = "";
    }

    // Native-library policy from the owning workspace: when a package manifest governs the
    // module, `external from` may name only the natives it declares. Exported so a driver can
    // exempt a compiler-owned module it injected, such as the synthesized test runner.
    export setNativePolicy(bool restricted, string[] nativeNames, string manifestPath) {
        this.restrictedNatives = restricted;
        this.moduleNativeNames = nativeNames;
        this.moduleManifestPath = manifestPath;
    }

    public nativesRestricted() -> bool {
        return this.restrictedNatives;
    }

    public declaresNative(string name) -> bool {
        for (let declared in this.moduleNativeNames) {
            if (declared == name) {
                return true;
            }
        }
        return false;
    }

    public manifestPath() -> string {
        return this.moduleManifestPath;
    }

    export canonicalPath() -> string {
        return this.moduleCanonicalPath;
    }

    export filePath() -> string {
        return this.moduleFilePath;
    }

    export packagePrefix() -> string {
        return this.modulePackagePrefix;
    }

    export source() -> Source {
        return this.moduleSource;
    }

    export parseResult() -> ParseResult {
        return this.moduleParseResult;
    }

    // Canonical paths of the modules this module imports, in source order, each listed once.
    public imports() -> string[] {
        return this.moduleImports;
    }

    // One entry per import declaration in source order: the canonical path the declaration
    // resolved to, or null when the import was diagnosed instead.
    public importTargets() -> string?[] {
        return this.moduleImportTargets;
    }
}

export class GraphResult {
    Module[] graphModules;
    FileDiagnostic[] graphDiagnostics;
    NativeInfo[] graphNatives;
    string[] graphNotices;
    Map<string, Module> modulesByPath;

    protected constructor(Module[] modules, FileDiagnostic[] diagnostics, NativeInfo[] natives,
                string[] notices) {
        this.graphModules = modules;
        this.graphDiagnostics = diagnostics;
        this.graphNatives = natives;
        this.graphNotices = notices;
        this.modulesByPath = new Map<string, Module>();
        for (let loaded in modules) {
            this.modulesByPath.set(loaded.canonicalPath(), loaded);
        }
    }

    // Modules in load order: seeds first, then imports in discovery order.
    export modules() -> Module[] {
        return this.graphModules;
    }

    // Graph and workspace diagnostics, ordered by (file, offset). Parse diagnostics stay on each
    // module's ParseResult.
    export diagnostics() -> FileDiagnostic[] {
        return this.graphDiagnostics;
    }

    // Every native library the resolved packages declare, one entry per name in name order, so a
    // driver links what the graph's manifests asked for. Conflicting declarations of one name are
    // diagnosed during the build, so the first seen declaration stands for its name here.
    export natives() -> NativeInfo[] {
        return this.graphNatives;
    }

    // What loading this graph did that whoever ran the build should know about, already worded for
    // a reader. Not diagnostics: nothing here is wrong.
    export notices() -> string[] {
        return this.graphNotices;
    }

    export moduleWithPath(string canonicalPath) -> Module? {
        return this.modulesByPath.get(canonicalPath);
    }
}

// seedFiles are file paths relative to the tests root when one is given and to the source root
// otherwise, and stdlibRoot is the folder containing 'std/'. overridesFolder names the folder whose
// ens.overrides governs the whole build, and empty text leaves that to the manifest discovered
// above the sources. fetched carries the packages a driver resolved from outside the workspace,
// and a load given none of them reports what it could not find.
export buildGraph(FileLoader loader, string sourceRoot, string testsRoot, string stdlibRoot,
                  string[] seedFiles, string overridesFolder = "",
                  PackageSources? fetched = null) -> GraphResult {
    let builder = new GraphBuilder(loader, sourceRoot, testsRoot, stdlibRoot, overridesFolder,
        fetched);
    return builder.build(seedFiles);
}

// Builds the graph of a single-file program: the entry file is the program's main module
// regardless of its file name, and a bare import that leads back to the entry file resolves to
// that same module.
export buildFileProgram(FileLoader loader, string sourceRoot, string testsRoot, string stdlibRoot,
                        string entryFile, string overridesFolder = "",
                        PackageSources? fetched = null) -> GraphResult {
    let builder = new GraphBuilder(loader, sourceRoot, testsRoot, stdlibRoot, overridesFolder,
        fetched);
    return builder.buildProgram(entryFile);
}

class WorkItem {
    protected Workspace owner;
    protected string baseFolder;
    protected string relativePath;
    protected string canonicalPath;

    protected constructor(this.owner, this.baseFolder, this.relativePath, this.canonicalPath);
}

class ImportScan {
    protected string[] importedPaths;
    protected string?[] declarationTargets;

    protected constructor(this.importedPaths, this.declarationTargets);
}

class GraphBuilder {
    FileLoader loader;
    string stdlibRoot;

    WorkspaceLoader workspaceLoader;
    Workspace rootWorkspace;
    Map<string, Workspace> workspacesByFolder;

    Set<string> queuedPaths;
    List<WorkItem> workItems;
    long nextWorkIndex;
    string entryAlias;

    List<Module> loadedModules;
    List<FileDiagnostic> collected;

    protected constructor(FileLoader loader, string sourceRoot, string testsRoot, string stdlibRoot,
                string overridesFolder, PackageSources? fetched) {
        this.loader = loader;
        this.stdlibRoot = path.normalize(stdlibRoot);
        this.workspaceLoader = new WorkspaceLoader(loader,
            fetched ?? workspace.noPackageSources());
        this.queuedPaths = new Set<string>();
        this.workItems = new List<WorkItem>();
        this.nextWorkIndex = 0;
        this.entryAlias = "";
        this.loadedModules = new List<Module>();
        this.collected = new List<FileDiagnostic>();
        this.rootWorkspace = this.workspaceLoader.loadRoot(sourceRoot, testsRoot, overridesFolder);
        this.workspacesByFolder = new Map<string, Workspace>();
        this.workspacesByFolder.set(this.rootWorkspace.root(), this.rootWorkspace);
    }

    protected build(string[] seedFiles) -> GraphResult {
        this.enqueueImplicitImports();
        for (let seed in seedFiles) {
            this.enqueue(this.rootWorkspace, this.seedBase(), seed, modulePathOfRelative(seed));
        }
        return this.run();
    }

    protected buildProgram(string entryFile) -> GraphResult {
        string natural = modulePathOfRelative(entryFile);
        if (natural != "main") {
            this.entryAlias = natural;
        }
        this.enqueueImplicitImports();
        this.enqueue(this.rootWorkspace, this.seedBase(), entryFile, "main");
        return this.run();
    }

    // The implicitly imported modules load ahead of the program's own seeds: their exported
    // names are in scope in every module with no import written, so no program can do without
    // them.
    enqueueImplicitImports() {
        for (let modulePath in implicit.implicitImportPaths()) {
            let target = this.workspaceFor(path.join(this.stdlibRoot, "std"), "std");
            string relativePath = stdlibRelativePath(modulePath);
            string targetFile = path.join(target.sourceRoot(), relativePath);
            if (!this.loader.exists(targetFile)) {
                this.report(targetFile, source.makeSpan(0, 0), "Cannot find standard library "
                    + "module '{modulePath}', which every program needs for the names it "
                    + "provides without an import (looked for {targetFile}).");
                continue;
            }
            this.enqueue(target, target.sourceRoot(), relativePath, modulePath);
        }
    }

    seedBase() -> string {
        if (this.rootWorkspace.hasTestsRoot()) {
            return this.rootWorkspace.testsRoot();
        }
        return this.rootWorkspace.sourceRoot();
    }

    run() -> GraphResult {
        while (this.nextWorkIndex < this.workItems.length()) {
            let item = this.workItems.get(this.nextWorkIndex);
            this.nextWorkIndex++;
            this.process(item);
        }
        NativeInfo[] natives = this.collectNatives();
        this.keep(this.workspaceLoader.diagnostics());
        return new GraphResult(this.loadedModules.toArray(), diagnostics.sorted(this.collected),
            natives, this.workspaceLoader.notices());
    }

    // The natives of every resolved workspace, one entry per name in name order. The same
    // logical native library declared with different bindings anywhere in the resolved package
    // graph is a hard error; identical declarations dedupe at link time.
    collectNatives() -> NativeInfo[] {
        let names = new List<string>();
        let firstDeclarations = new List<NativeInfo>();
        let firstManifests = new List<string>();
        let workspaces = new List<Workspace>();
        for (let folder in this.workspacesByFolder.keys()) {
            let loaded = this.workspacesByFolder.get(folder);
            if (loaded != null) {
                workspaces.push(loaded);
            }
        }
        for (long w = 0; w < workspaces.length(); w++) {
            let owner = workspaces.get(w);
            for (let native in owner.natives()) {
                long existing = -1;
                for (long i = 0; i < names.length(); i++) {
                    if (names.get(i) == native.name()) {
                        existing = i;
                        break;
                    }
                }
                if (existing < 0) {
                    names.push(native.name());
                    firstDeclarations.push(native);
                    firstManifests.push(owner.manifestPath());
                    continue;
                }
                if (!workspace.sameNative(firstDeclarations.get(existing), native)) {
                    this.report(owner.manifestPath(), native.span(),
                        "Native library '{native.name()}' is declared with different bindings "
                        + "by {firstManifests.get(existing)} and {owner.manifestPath()}; every "
                        + "package must agree on a native library's binding.");
                }
            }
        }
        NativeInfo[] collected = firstDeclarations.toArray();
        for (long i = 1; i < collected.length; i++) {
            let current = collected[i];
            long j = i - 1;
            while (j >= 0 && collected[j].name().compareTo(current.name()) > 0) {
                collected[j + 1] = collected[j];
                j--;
            }
            collected[j + 1] = current;
        }
        return collected;
    }

    process(WorkItem item) {
        string filePath = path.join(item.baseFolder, item.relativePath);
        string? text = this.readOrNull(filePath);
        if (text == null) {
            this.report(filePath, source.makeSpan(0, 0), "Could not read {filePath}.");
            return;
        }
        let problem = source.firstUtf8Problem(text);
        if (problem != null) {
            this.report(filePath, source.makeSpan(problem.offset(), 1),
                "This file is not valid UTF-8 text: byte {problem.byteText()} "
                + "{problem.reason()}. Save the file with UTF-8 encoding.");
            return;
        }
        let moduleSource = new Source(filePath, text);
        let parsed = parser.parse(moduleSource);
        let scan = this.resolveImports(item, filePath, parsed);
        let loaded = new Module(item.canonicalPath, filePath,
            item.owner.packagePrefix(), moduleSource, parsed, scan.importedPaths,
            scan.declarationTargets);
        loaded.setNativePolicy(item.owner.hasPackageManifest(), item.owner.nativeNames(),
            item.owner.manifestPath());
        this.loadedModules.push(loaded);
    }

    readOrNull(string path) -> string? {
        return try this.loader.readText(path);
    } catch (FileError error) {
        return null;
    }

    // Resolves every import declaration in the parsed file, enqueuing newly reached modules, and
    // returns both the deduplicated canonical paths and the per-declaration targets.
    resolveImports(WorkItem item, string filePath, ParseResult parsed) -> ImportScan {
        let root = factory.createRoot(parsed.root());
        if (root is SourceFileNode) {
            long count = 0;
            for (long i = 0; i < root.itemsCount(); i++) {
                if (root.items(i) is ImportDeclarationNode) {
                    count++;
                }
            }
            let imports = new List<string>();
            let seen = new Set<string>();
            string?[] targets = new string?[count];
            long next = 0;
            for (long i = 0; i < root.itemsCount(); i++) {
                let topLevel = root.items(i);
                if (topLevel is ImportDeclarationNode) {
                    string? canonical = this.resolveImport(item, filePath, topLevel.path());
                    targets[next] = canonical;
                    next++;
                    if (canonical != null && seen.add(canonical)) {
                        imports.push(canonical);
                    }
                }
            }
            return new ImportScan(imports.toArray(), targets);
        }
        return new ImportScan([], []);
    }

    // The canonical path the import resolves to, or null when the import is diagnosed instead.
    resolveImport(WorkItem item, string filePath, ImportPathNode path) -> string? {
        string[] segments = segmentTexts(path);
        if (segments.length == 0) {
            return null;
        }
        string modulePath = paths.joinRange(segments, ".", 0, segments.length);
        let span = path.span();
        if (path.at() != null) {
            if (segments[0] == StandardLibrary.packagePrefix) {
                return this.resolveStdImport(filePath, span, modulePath, segments);
            }
            return this.resolvePackageImport(item, filePath, span, modulePath, segments);
        }
        if (isStdlibPath(modulePath)) {
            this.report(filePath, span,
                "Import the standard library as a package: write '@{modulePath}'.");
            return null;
        }
        return this.resolveBareImport(item, filePath, span, modulePath);
    }

    // `@std` is implicitly available to every package; the standard library itself is an
    // ordinary package under the stdlib root.
    resolveStdImport(string filePath, Span span, string modulePath, string[] segments)
            -> string? {
        if (segments.length == 1) {
            this.report(filePath, span,
                "Import a module within package 'std', not the package itself.");
            return null;
        }
        let target = this.workspaceFor(path.join(this.stdlibRoot, "std"), "std");
        if (this.queuedPaths.contains(modulePath)) {
            return modulePath;
        }
        string relativePath = relativeOfSegments(segments, 1);
        string targetFile = path.join(target.sourceRoot(), relativePath);
        if (!this.loader.exists(targetFile)) {
            this.report(filePath, span, "Cannot find standard library module '{modulePath}' "
                + "(looked for {targetFile}).");
            return null;
        }
        this.enqueue(target, target.sourceRoot(), relativePath, modulePath);
        return modulePath;
    }

    resolvePackageImport(WorkItem item, string filePath, Span span, string modulePath,
                                 string[] segments) -> string? {
        let match = item.owner.matchPackage(segments);
        if (match == null) {
            this.report(filePath, span, item.owner.missingPackageMessage(modulePath));
            return null;
        }
        if (match.segmentCount() == segments.length) {
            this.report(filePath, span,
                "Import a module within package '{modulePath}', not the package itself.");
            return null;
        }
        let target = this.workspaceFor(match.folder(),
            paths.joinRange(segments, ".", 0, match.segmentCount()));
        if (this.queuedPaths.contains(modulePath)) {
            return modulePath;
        }
        string relativePath = relativeOfSegments(segments, match.segmentCount());
        string targetFile = path.join(target.sourceRoot(), relativePath);
        if (!this.loader.exists(targetFile)) {
            this.report(filePath, span,
                "Cannot find module '{modulePath}' (looked for {targetFile}).");
            return null;
        }
        this.enqueue(target, target.sourceRoot(), relativePath, modulePath);
        return modulePath;
    }

    resolveBareImport(WorkItem item, string filePath, Span span, string modulePath)
            -> string? {
        Workspace owner = item.owner;
        string relativePath = relativeOfModulePath(modulePath);
        string canonical = modulePath;
        if (owner.packagePrefix().length > 0) {
            canonical = owner.packagePrefix() + "." + modulePath;
        }
        if (this.entryAlias.length > 0 && canonical == this.entryAlias) {
            return "main";
        }
        string baseFolder = owner.sourceRoot();
        // Only the root workspace resolves bare imports against its tests root as a fallback; a
        // module present under both roots is ambiguous.
        if (owner.hasTestsRoot()) {
            bool underSource = this.loader.exists(path.join(owner.sourceRoot(), relativePath));
            bool underTests = this.loader.exists(path.join(owner.testsRoot(), relativePath));
            if (underSource && underTests) {
                this.report(filePath, span, "Module '{modulePath}' exists under both the source "
                    + "folder and the tests folder; rename one of the files.");
                return null;
            }
            if (underTests) {
                baseFolder = owner.testsRoot();
            }
        }
        if (this.queuedPaths.contains(canonical)) {
            return canonical;
        }
        string targetFile = path.join(baseFolder, relativePath);
        if (!this.loader.exists(targetFile)) {
            string lookedFor = targetFile;
            if (owner.hasTestsRoot()) {
                lookedFor = lookedFor + " and " + path.join(owner.testsRoot(), relativePath);
            }
            this.report(filePath, span, "Cannot find module '{modulePath}' "
                + "(looked for {lookedFor}).");
            return null;
        }
        this.enqueue(owner, baseFolder, relativePath, canonical);
        return canonical;
    }

    // One workspace object per package folder, created the first time the folder is reached and
    // keyed by the folder, so every route to the package shares it (and the prefix it was first
    // given).
    workspaceFor(string folder, string packagePrefix) -> Workspace {
        let existing = this.workspacesByFolder.get(folder);
        if (existing != null) {
            return existing;
        }
        let loaded = this.workspaceLoader.loadPackage(folder, packagePrefix);
        this.workspacesByFolder.set(folder, loaded);
        return loaded;
    }

    enqueue(Workspace owner, string baseFolder, string relativePath, string canonical) {
        if (canonical.length == 0) {
            return;
        }
        if (!this.queuedPaths.add(canonical)) {
            return;
        }
        this.workItems.push(new WorkItem(owner, baseFolder, relativePath, canonical));
    }

    report(string file, Span span, string message) {
        this.collected.push(new FileDiagnostic(file, message, span));
    }

    keep(FileDiagnostic[] items) {
        for (let item in items) {
            this.collected.push(item);
        }
    }
}

segmentTexts(ImportPathNode path) -> string[] {
    let texts = new List<string>();
    for (long i = 0; i < path.segmentsCount(); i++) {
        texts.push(path.segments(i).text());
    }
    return texts.toArray();
}

isStdlibPath(string modulePath) -> bool {
    if (modulePath == StandardLibrary.packagePrefix) {
        return true;
    }
    return modulePath.length >= 4 && modulePath.substring(0, 4) == "std.";
}

// "a/b/c.ens" -> "a.b.c"
modulePathOfRelative(string relativePath) -> string {
    string bare = relativePath;
    if (bare.length >= 4 && bare.substring(bare.length - 4, bare.length) == ".ens") {
        bare = bare.substring(0, bare.length - 4);
    }
    let builder = new StringBuilder();
    byte[] bytes = bare.toBytes();
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '/') {
            builder.append(".");
        } else {
            builder.appendByte(bytes[i]);
        }
    }
    return builder.toString();
}

// "a.b.c" -> "a/b/c.ens"
relativeOfModulePath(string modulePath) -> string {
    let builder = new StringBuilder();
    byte[] bytes = modulePath.toBytes();
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] == '.') {
            builder.append("/");
        } else {
            builder.appendByte(bytes[i]);
        }
    }
    builder.append(".ens");
    return builder.toString();
}

relativeOfSegments(string[] segments, long from) -> string {
    return paths.joinRange(segments, "/", from, segments.length) + ".ens";
}

// "std.a.b" -> "a/b.ens", where a standard-library module sits inside the std package's sources.
stdlibRelativePath(string modulePath) -> string {
    string prefix = "std.";
    return relativeOfModulePath(modulePath.substring(prefix.length, modulePath.length));
}
