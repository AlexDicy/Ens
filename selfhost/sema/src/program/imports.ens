// Every import the program's modules write, read once the graph is loaded: what a refusal that
// has to stop a module from loading needs to name the imports to remove.
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;

// One import a module writes: the module it is written in, with that module's package and whether
// the user can edit it, the module it loads, and its text where it is written on one line.
public final class ImportSite {
    public const string importerPath;
    public const string importerPackagePrefix;
    public const bool editable;
    public const string targetPath;
    public const string? written;

    public constructor(this.importerPath, this.importerPackagePrefix, this.editable,
                this.targetPath, this.written);
}

// The imports of one program and the modules of it the user can edit. Read-only once built.
public final class ProgramImports {
    List<ImportSite> allSites;
    Map<string, List<ImportSite>> sitesByImporter;
    Set<string> editablePaths;

    public constructor(List<ImportSite> sites, Set<string> editablePaths) {
        this.allSites = sites;
        this.sitesByImporter = new Map<string, List<ImportSite>>();
        for (let site in sites) {
            this.sitesByImporter.getOrInsert(site.importerPath, () -> new List<ImportSite>())
                .push(site);
        }
        this.editablePaths = editablePaths;
    }

    // The imports in modules the user can edit that load the module at 'modulePath', in the order
    // the program's modules write them: each names that module, or a module the user cannot edit
    // that loads it through the imports of such modules. The program stops loading the module once
    // every one of them is removed.
    public loading(string modulePath) -> List<ImportSite> {
        let found = new List<ImportSite>();
        for (let site in this.allSites) {
            if (!site.editable || site.importerPath == modulePath) {
                continue;
            }
            if (site.targetPath == modulePath || (!this.editablePaths.contains(site.targetPath)
                    && this.reachesThroughUneditable(site.targetPath, modulePath))) {
                found.push(site);
            }
        }
        return found;
    }

    // Whether the imports of the uneditable module at 'start', and of the uneditable modules those
    // load, load the module at 'modulePath'.
    reachesThroughUneditable(string start, string modulePath) -> bool {
        let visited = new Set<string>();
        let pending = new List<string>();
        pending.push(start);
        visited.add(start);
        while (pending.length() > 0) {
            let current = pending.pop();
            let sites = this.sitesByImporter.get(current);
            if (sites == null) {
                continue;
            }
            for (let site in sites) {
                if (site.targetPath == modulePath) {
                    return true;
                }
                if (!this.editablePaths.contains(site.targetPath) && visited.add(site.targetPath)) {
                    pending.push(site.targetPath);
                }
            }
        }
        return false;
    }
}
