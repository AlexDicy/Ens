// The implicitly imported modules: ordinary standard-library modules whose exported names are in
// scope everywhere with no import written. The graph loads them ahead of a program's own seeds,
// and unqualified resolution falls back to them after a module's own declarations and imports.

export final class StandardLibrary {
    // The module holding the exception base class 'Error' and 'StackFrame'. The exception rules
    // resolve the base class through this path rather than by name. Code generation resolves the
    // same two classes, so this one member is exported.
    export static const string coreModule = "std.core";

    // The module holding 'print' and 'eprint', the only functions the prelude lends.
    public static const string printModule = "std.io.print";

    // The modules declaring the members of 'string' and of the number types.
    public static const string textModule = "std.text.string";
    public static const string numbersModule = "std.text.numbers";

    // The standard library's own package name, which is also the prefix its modules are addressed
    // through. Declaring what a primitive's members are is a statement about the language itself,
    // so it is allowed only inside this package; the module's package decides it, not where its
    // file happens to sit.
    public static const string packagePrefix = "std";
}

public implicitImportPaths() -> string[] {
    return [StandardLibrary.coreModule, StandardLibrary.printModule];
}

// The modules whose primitive bindings every program reads. What a 'string' or a number can do is
// declared there, so those members are reached with no import written; nothing else about these
// modules is in scope, which is what keeps them apart from the implicitly imported ones.
public bindingModulePaths() -> string[] {
    return [StandardLibrary.textModule, StandardLibrary.numbersModule];
}

// Whether a module belongs to the standard library, by the package its manifest declares. The
// package under test is addressed with no prefix, so the name is what holds while the library is
// the program being built.
public isStandardLibrary(string packageName) -> bool {
    return packageName == StandardLibrary.packagePrefix;
}
