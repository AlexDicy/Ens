// Whether a file calls 'frozen()'. An array's frozen form is a 'FrozenList', so the module that
// declares it loads for a file that calls 'frozen()' on anything, whether or not the file imports it.
import ParseResult from @ens.frontend.parse.parser;
import @ens.frontend.syntax.generated.factory;
import SyntaxNode from @ens.frontend.syntax.node;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;

export callsFrozen(string text, ParseResult parsed) -> bool {
    if (!text.contains("frozen")) {
        return false;
    }
    return containsFrozenCall(factory.createRoot(parsed.root()));
}

containsFrozenCall(SyntaxNode node) -> bool {
    if (node is CallExpressionNode && namesFrozen(node)) {
        return true;
    }
    for (let child in node.childNodes()) {
        if (containsFrozenCall(child)) {
            return true;
        }
    }
    return false;
}

namesFrozen(CallExpressionNode call) -> bool {
    switch (call.callee()) {
        is MemberExpressionNode member -> {
            return member.member().text() == "frozen";
        },
        is SafeMemberExpressionNode member -> {
            return member.member().text() == "frozen";
        },
        default -> {
            return false;
        },
    }
}
