// Statement-level rules: return-path analysis, loop placement of break/continue, for-each
// iterables, and throw/rethrow placement.
import @std.testing;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;

private analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    return analysis;
}

test "every terminating shape satisfies the return-path check" {
    let analysis = try analyzeOne("enum Color \{ Red, Green, \}\n"
        + "viaIf(int x) -> int \{\n"
        + "    if (x > 0) \{ return 1; \} else if (x < 0) \{ return -1; \}\n"
        + "    else \{ panic(\"zero\"); \}\n"
        + "\}\n"
        + "viaSwitch(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> \{ return 1; \}, Green -> \{ return 2; \}, \}\n"
        + "\}\n"
        + "viaLoop() -> int \{\n"
        + "    while (true) \{ let x = 0; \}\n"
        + "\}\n"
        + "viaNestedBreak() -> int \{\n"
        + "    while (true) \{\n"
        + "        while (false) \{ break; \}\n"
        + "    \}\n"
        + "\}\n"
        + "viaThrow(int x) -> int throws \{\n"
        + "    if (x > 0) \{ return x; \} else \{ throw new Error(\"bad\"); \}\n"
        + "\}\n"
        + "main() -> int \{ return viaIf(1) + viaSwitch(Color.Red); \}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a body that can fall off the end is rejected" {
    let analysis = try analyzeOne("bad(int x) -> int \{\n"
        + "    if (x > 0) \{ return 1; \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(1); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'bad' can reach the end of its body without returning a value");
}

test "a 'while (true)' loop with a bound break does not terminate" {
    let analysis = try analyzeOne("bad() -> int \{\n"
        + "    while (true) \{\n"
        + "        if (1 > 0) \{ break; \}\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'bad' can reach the end of its body without returning a value");
}

test "a switch with a non-returning arm or expression arms does not terminate" {
    let analysis = try analyzeOne("enum Color \{ Red, Green, \}\n"
        + "bad(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> \{ return 1; \}, Green -> \{ let x = 0; \}, \}\n"
        + "\}\n"
        + "alsoBad(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> 1, Green -> 2, \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(Color.Red); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'bad' can reach the end of its body without returning a value");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'alsoBad' can reach the end of its body without returning a value");
}

test "break and continue must sit inside a loop" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    break;\n"
        + "    continue;\n"
        + "    for (long i = 0; i < 3; i++) \{\n"
        + "        if (i == 1) \{ continue; \}\n"
        + "        if (i == 2) \{ break; \}\n"
        + "    \}\n"
        + "    while (false) \{ break; \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'break' can only be used inside a loop");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'continue' can only be used inside a loop");
}

test "for-each requires an iterable and a compatible binding" {
    let analysis = try analyzeOne("class Opaque \{ constructor(); \}\n"
        + "main() -> int \{\n"
        + "    let box = new Opaque();\n"
        + "    for (let item in box) \{ \}\n"
        + "    let n = 5;\n"
        + "    for (let item in n) \{ \}\n"
        + "    int[] xs = [1, 2, 3];\n"
        + "    for (string s in xs) \{ \}\n"
        + "    for (let x in xs) \{ let y = x + 1; \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'Opaque' is not iterable: it does not implement 'Iterable' from "
        + "'@std.collections.iterator'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'for (... in ...)' requires an array or an iterable object, got 'int'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Loop variable of type 'string' cannot hold the 'int' values this sequence yields.");
}

test "a class implementing Iterable<T> and an Iterable<T> value both iterate" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/collections/iterator.ens",
        "public interface Iterator<T> \{\n"
        + "    hasNext() -> bool;\n"
        + "    next() -> T;\n"
        + "\}\n"
        + "public interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    constructor(this.current);\n"
        + "    override hasNext() -> bool \{ return this.current < 3; \}\n"
        + "    override next() -> int \{\n"
        + "        this.current = this.current + 1;\n"
        + "        return this.current;\n"
        + "    \}\n"
        + "\}\n"
        + "class Range implements Iterable<int> \{\n"
        + "    constructor();\n"
        + "    override makeIterator() -> Iterator<int> \{ return new CountUp(0); \}\n"
        + "\}\n"
        + "sum(Range r) -> int \{\n"
        + "    let total = 0;\n"
        + "    for (let value in r) \{ total = total + value; \}\n"
        + "    return total;\n"
        + "\}\n"
        + "first(Iterable<int> source) -> int \{\n"
        + "    for (int value in source) \{ return value; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return sum(new Range()) + first(new Range()); \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "throw takes an Error and rethrow needs a catch clause" {
    let analysis = try analyzeOne("class Widget \{ constructor(); \}\n"
        + "class MyError extends Error \{\n"
        + "    constructor() \{ super(\"boom\"); \}\n"
        + "\}\n"
        + "bad() throws \{\n"
        + "    throw new Widget();\n"
        + "\}\n"
        + "alsoBad() \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "good(int x) -> int throws \{\n"
        + "    if (x < 0) \{ throw new MyError(); \}\n"
        + "    return x;\n"
        + "\}\n"
        + "handler() -> int \{\n"
        + "    return try good(1);\n"
        + "\} catch (Error e) \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "main() -> int \{ return handler(); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot throw a value of type 'Widget'; only 'Error' or a subclass of it can be "
        + "thrown.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'rethrow' can only be used inside a 'catch' block.");
}

test "a catch clause of a non-void function must also exit" {
    let analysis = try analyzeOne("mayThrow(int x) -> int throws \{\n"
        + "    if (x < 0) \{ throw new Error(\"negative\"); \}\n"
        + "    return x;\n"
        + "\}\n"
        + "bad() -> int \{\n"
        + "    return try mayThrow(1);\n"
        + "\} catch (Error e) \{\n"
        + "    let unused = 0;\n"
        + "\}\n"
        + "good() -> int \{\n"
        + "    return try mayThrow(1);\n"
        + "\} catch (Error e) \{\n"
        + "    return -1;\n"
        + "\}\n"
        + "main() -> int \{ return good(); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'bad' can reach the end of its body without returning a value");
}
