import @std.testing;
import FakeFileLoader from sema_support;
import sema_support;

test "noreturn rejects a return type and a return statement" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn withType() -> int \{\n"
        + "    panic(\"x\");\n"
        + "\}\n"
        + "noreturn usesReturn() \{\n"
        + "    return;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "A 'noreturn' function declares no return type");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A 'noreturn' function cannot use 'return'");
}

test "a noreturn body that can complete normally is rejected" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn dribble() \{\n"
        + "    print(\"still here\");\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "is declared 'noreturn' but can reach the end of its body");
}

test "noreturn is illegal on constructors and destructors" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    noreturn constructor() \{ panic(\"x\"); \}\n"
        + "    noreturn destructor() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A constructor cannot be marked 'noreturn'");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A destructor cannot be marked 'noreturn'");
}

test "an override cannot drop a base method's noreturn contract" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "abstract class Base \{\n"
        + "    protected abstract noreturn boom();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    override boom() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Override of 'boom' must be marked 'noreturn'");
}

test "noreturn functions and methods pass when every path ends" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "firstPositive(int[] values) -> int \{\n"
        + "    for (let value in values) \{\n"
        + "        if (value > 0) \{ return value; \}\n"
        + "    \}\n"
        + "    panic(\"no positive value\");\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected abstract noreturn halt();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    override noreturn halt() \{ panic(\"halt\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}
