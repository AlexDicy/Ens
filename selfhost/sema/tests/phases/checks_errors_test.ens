import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "a visible declaration may not mention a less visible type" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public expose(Secret s) \{ \}\n"
        + "public fetch() -> Secret \{ return new Secret(); \}\n"
        + "public class Child extends Secret \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'expose' is 'public', but its parameter type uses 'Secret', which is private to "
        + "module 'app'. Mark 'Secret' 'public', or remove 'public' from 'expose'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Function 'fetch' is 'public', but its return type uses 'Secret', which is private to "
        + "module 'app'. Mark 'Secret' 'public', or remove 'public' from 'fetch'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Class 'Child' is 'public', but its base class 'Secret' is private to module 'app'. Mark "
        + "'Secret' 'public', or remove 'public' from 'Child'.");
}

test "a protected member leaks only as far as its class can be subclassed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "export class Channel \{\n"
        + "    export constructor();\n"
        + "    protected open(Secret secret) \{ \}\n"
        + "\}\n"
        + "public class Registry \{\n"
        + "    protected Secret entry;\n"
        + "    protected constructor(this.entry);\n"
        + "\}\n"
        + "export final class Wrapper \{\n"
        + "    protected Secret inner;\n"
        + "    protected constructor(this.inner);\n"
        + "\}\n"
        + "class Open \{\n"
        + "    protected Secret held;\n"
        + "    protected constructor(this.held);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'open' of class 'Channel' is protected, and 'Channel' is 'export', so a subclass "
        + "in another package can call it, but its parameter type uses 'Secret', which is private "
        + "to module 'app'. Mark 'Secret' 'export'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'entry' of class 'Registry' is protected, and 'Registry' is 'public', so a subclass "
        + "anywhere in the package can use it, but its type uses 'Secret', which is private to "
        + "module 'app'. Mark 'Secret' 'public'. Or remove 'public' from 'Registry'. Or mark "
        + "'Registry' 'final'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Constructor of class 'Registry' is protected, and 'Registry' is 'public', so a subclass "
        + "anywhere in the package can call it, but its parameter type uses 'Secret', which is "
        + "private to module 'app'. Mark 'Secret' 'public'. Or remove 'public' from 'Registry'. Or "
        + "mark 'Registry' 'final'.");
}

// A sealed class can be subclassed from as far as its widest subclass can. All-'final' cases, a
// sealed case closed in turn, a file-private open case, no subclasses, and a file-private sealed class
// keep its protected members to the file. An open case, direct or two sealed levels down, widens them
// to that case's visibility. The refusal names every open case the mentioned type is out of reach of,
// with a note at each, and offers to close them, as for an open class, only where none has a subclass.
test "a sealed class's protected members leak as far as its open subclasses reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "public sealed abstract class Closed \{\n"
        + "    protected reveal() -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "public final class Ring extends Closed \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public sealed class Tile extends Closed \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public final class Brick extends Tile \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "class Loose extends Closed \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "public sealed class Lonely \{\n"
        + "    protected reveal() -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "sealed class Hidden \{\n"
        + "    protected reveal() -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "class Inner extends Hidden \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "public sealed class Shape \{\n"
        + "    protected Secret held = new Secret();\n"
        + "    protected reveal() -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "public final class Circle extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Polygon extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public sealed class Root \{\n"
        + "    protected reveal() -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "public sealed class Mid extends Root \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Leaf extends Mid \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public sealed class Box<T> \{\n"
        + "    protected peek(T value) -> Secret \{ return new Secret(); \}\n"
        + "\}\n"
        + "public class IntBox extends Box<int> \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/wide.ens",
        "public class Inside \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "export sealed class Shape \{\n"
        + "    protected reveal() -> Inside \{ return new Inside(); \}\n"
        + "\}\n"
        + "export class Polygon extends Shape \{\n"
        + "    export constructor();\n"
        + "\}\n"
        + "export sealed class Narrow \{\n"
        + "    protected reveal() -> Inside \{ return new Inside(); \}\n"
        + "\}\n"
        + "public class Middle extends Narrow \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/many.ens",
        "class Secret \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "public sealed class Shape \{\n"
        + "    protected reveal() -> Secret \{\n"
        + "        return new Secret();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public class First extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public sealed class Mid extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Leaf extends Mid \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Third extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "class Quiet extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n");
    loader.add("/proj/src/both.ens",
        "public class Inside \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "class Secret \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "export sealed class Shape \{\n"
        + "    protected reveal() -> Inside \{\n"
        + "        return new Inside();\n"
        + "    \}\n"
        + "\n"
        + "    protected hidden() -> Secret \{\n"
        + "        return new Secret();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public class First extends Shape \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "export class Second extends Shape \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.add("/proj/src/holder.ens",
        "class Secret \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Holder \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    protected reveal() -> Secret \{\n"
        + "        return new Secret();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public class Child extends Holder \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Lone \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    protected reveal() -> Secret \{\n"
        + "        return new Secret();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public sealed class Frame \{\n"
        + "    protected reveal() -> Secret \{\n"
        + "        return new Secret();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public class Panel extends Frame \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "class Pane extends Panel \{\n"
        + "    constructor();\n"
        + "\}\n");
    let files = ["app.ens", "wide.ens", "many.ens", "both.ens", "holder.ens"];
    let analysis = sema_support.analyzeAll(loader, "/proj/src", files);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 11L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens", "Field 'held' of class 'Shape' is "
        + "protected, and its type uses 'Secret', which is private to module 'app'. 'Shape' is sealed, but "
        + "its subclass 'Polygon' is 'public' and neither 'final' nor 'sealed', so a class anywhere in the "
        + "package can extend 'Polygon' and use 'held'. Mark 'Secret' 'public'. Or mark 'Polygon' 'final' or "
        + "'sealed'.");
    try testing.assertEqual(found[0].related().length, 1L);
    try testing.assertEqual(found[0].related()[0].note(), "'Polygon' is declared here.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens", "Method 'reveal' of class 'Shape' is "
        + "protected, and its return type uses 'Secret', which is private to module 'app'. 'Shape' is "
        + "sealed, but its subclass 'Polygon' is 'public' and neither 'final' nor 'sealed', so a class "
        + "anywhere in the package can extend 'Polygon' and call 'reveal'. Mark 'Secret' 'public'. Or mark "
        + "'Polygon' 'final' or 'sealed'.");
    try testing.assertEqual(found[1].related().length, 1L);
    try testing.assertEqual(found[1].related()[0].note(), "'Polygon' is declared here.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens", "Method 'reveal' of class 'Root' is "
        + "protected, and its return type uses 'Secret', which is private to module 'app'. 'Root' is sealed, "
        + "but its descendant 'Leaf' is 'public' and neither 'final' nor 'sealed', so a class anywhere in "
        + "the package can extend 'Leaf' and call 'reveal'. Mark 'Secret' 'public'. Or mark 'Leaf' 'final' "
        + "or 'sealed'.");
    try testing.assertEqual(found[2].related().length, 1L);
    try testing.assertEqual(found[2].related()[0].note(), "'Leaf' is declared here.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens", "Method 'peek' of class 'Box' is "
        + "protected, and its return type uses 'Secret', which is private to module 'app'. 'Box' is sealed, "
        + "but its subclass 'IntBox' is 'public' and neither 'final' nor 'sealed', so a class anywhere in "
        + "the package can extend 'IntBox' and call 'peek'. Mark 'Secret' 'public'. Or mark 'IntBox' 'final' "
        + "or 'sealed'.");
    try testing.assertEqual(found[3].related().length, 1L);
    try testing.assertEqual(found[3].related()[0].note(), "'IntBox' is declared here.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/both.ens", "Method 'reveal' of class 'Shape' is "
        + "protected, and its return type uses 'Inside', which is only public inside its own package. "
        + "'Shape' is sealed, but its subclass 'Second' is 'export' and neither 'final' nor 'sealed', so a "
        + "class in another package can extend 'Second' and call 'reveal'. Mark 'Inside' 'export'.");
    try testing.assertEqual(found[4].related().length, 1L);
    try testing.assertEqual(found[4].related()[0].note(), "'Second' is declared here.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/both.ens", "Method 'hidden' of class 'Shape' is "
        + "protected, and its return type uses 'Secret', which is private to module 'both'. 'Shape' is "
        + "sealed, but its subclasses 'First' and 'Second' are neither 'final' nor 'sealed', so a class in "
        + "another file can extend them and call 'hidden'. Mark 'Secret' 'export'.");
    try testing.assertEqual(found[5].related().length, 2L);
    try testing.assertEqual(found[5].related()[0].note(), "'First' is declared here.");
    try testing.assertEqual(found[5].related()[1].note(), "'Second' is declared here.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/holder.ens", "Method 'reveal' of class 'Holder' "
        + "is protected, and 'Holder' is 'public', so a subclass anywhere in the package can call it, but "
        + "its return type uses 'Secret', which is private to module 'holder'. Mark 'Secret' 'public'.");
    try testing.assertEqual(found[6].related().length, 0L);
    try sema_support.assertDiagnostic(found, 7, "/proj/src/holder.ens", "Method 'reveal' of class 'Lone' is "
        + "protected, and 'Lone' is 'public', so a subclass anywhere in the package can call it, but its "
        + "return type uses 'Secret', which is private to module 'holder'. Mark 'Secret' 'public'. Or remove "
        + "'public' from 'Lone' and its constructor. Or mark 'Lone' 'final'.");
    try testing.assertEqual(found[7].related().length, 0L);
    try sema_support.assertDiagnostic(found, 8, "/proj/src/holder.ens", "Method 'reveal' of class 'Frame' is "
        + "protected, and its return type uses 'Secret', which is private to module 'holder'. 'Frame' is "
        + "sealed, but its subclass 'Panel' is 'public' and neither 'final' nor 'sealed', so a class "
        + "anywhere in the package can extend 'Panel' and call 'reveal'. Mark 'Secret' 'public'.");
    try testing.assertEqual(found[8].related().length, 1L);
    try testing.assertEqual(found[8].related()[0].note(), "'Panel' is declared here.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/many.ens", "Method 'reveal' of class 'Shape' is "
        + "protected, and its return type uses 'Secret', which is private to module 'many'. 'Shape' is "
        + "sealed, but its descendants 'First', 'Leaf' and 'Third' are 'public' and neither 'final' nor "
        + "'sealed', so a class anywhere in the package can extend them and call 'reveal'. Mark 'Secret' "
        + "'public'. Or mark 'First', 'Leaf' and 'Third' 'final' or 'sealed'.");
    try testing.assertEqual(found[9].related().length, 3L);
    try testing.assertEqual(found[9].related()[0].note(), "'First' is declared here.");
    try testing.assertEqual(found[9].related()[1].note(), "'Leaf' is declared here.");
    try testing.assertEqual(found[9].related()[2].note(), "'Third' is declared here.");
    try sema_support.assertDiagnostic(found, 10, "/proj/src/wide.ens", "Method 'reveal' of class 'Shape' is "
        + "protected, and its return type uses 'Inside', which is only public inside its own package. "
        + "'Shape' is sealed, but its subclass 'Polygon' is 'export' and neither 'final' nor 'sealed', so a "
        + "class in another package can extend 'Polygon' and call 'reveal'. Mark 'Inside' 'export'.");
    try testing.assertEqual(found[10].related().length, 1L);
    try testing.assertEqual(found[10].related()[0].note(), "'Polygon' is declared here.");
}

test "a class with a non-defaulted 'const' field needs a constructor to assign it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Silent \{\n"
        + "    const int value;\n"
        + "\}\n"
        + "class Covered \{\n"
        + "    const int value = 1;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'value' of class 'Silent' is 'const' with no default value, and 'Silent' has no "
        + "constructor to assign it. Add one, for example 'constructor(this.value);', or give the "
        + "field a default value.");
}

test "field defaults may only reference earlier fields" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "helperValue() -> int \{ return 3; \}\n"
        + "struct Bad \{\n"
        + "    int area = width * height;\n"
        + "    int width = 4;\n"
        + "    int height = helperValue();\n"
        + "    int self = self;\n"
        + "    int fine = width;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The default value of field 'area' uses 'width', which is declared below 'area', so "
        + "'width' has no value yet. Move 'width' above 'area', or remove 'width' from the default.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The default value of field 'area' uses 'height', which is declared below 'area', so "
        + "'height' has no value yet. Move 'height' above 'area', or remove 'height' from the "
        + "default.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "The default value of field 'self' uses 'self' itself, and 'self' has no value until this "
        + "default is computed. Remove 'self' from its own default, or use a field declared above "
        + "'self'.");
}

// A cycle is reported once, from the struct in it that comes first in the file, with the path
// back to that struct.
test "struct value cycles are reported once with their path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Outer \{\n"
        + "    Inner nested;\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    Outer? back;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Struct 'Outer' contains itself: field 'nested' of 'Outer' has type 'Inner' and field "
        + "'back' of 'Inner' has type 'Outer?'. A struct keeps its fields inside itself, so every "
        + "'Outer' would contain another 'Outer' without end. Make 'Inner' a class, as in 'class "
        + "Inner \{ ... \}', because a class field only refers to another object.");
}

// Structs with more than one cycle between them are one problem: it is reported once, from the
// first of them, naming every struct and every field between them. The fix names one struct on
// every cycle where there is one, and enough structs to break every cycle otherwise.
test "the structs of several cycles between them are reported once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct North \{\n"
        + "    South south;\n"
        + "    East east;\n"
        + "\}\n"
        + "struct South \{\n"
        + "    North? north;\n"
        + "    East? east;\n"
        + "\}\n"
        + "struct East \{\n"
        + "    North? north;\n"
        + "    South? south;\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    Part one;\n"
        + "    Part two;\n"
        + "\}\n"
        + "struct Part \{\n"
        + "    Pair? pair;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Structs 'North', 'South' and 'East' contain each other through the fields listed below. A "
        + "struct keeps its fields inside itself, so each of these structs would contain another of "
        + "them without end. Make 'North' and 'South' classes, as in 'class North \{ ... \}', because "
        + "a class field only refers to another object.");
    let notes = found[0].related();
    try testing.assertEqual(notes.length, 6L);
    try testing.assertEqual(notes[0].note(), "field 'south' of 'North' has type 'South'");
    try testing.assertEqual(notes[5].note(), "field 'south' of 'East' has type 'South?'");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Structs 'Pair' and 'Part' contain each other: field 'one' of 'Pair' has type 'Part', field "
        + "'two' of 'Pair' has type 'Part' and field 'pair' of 'Part' has type 'Pair?'. A struct "
        + "keeps its fields inside itself, so each of these structs would contain another of them "
        + "without end. Make 'Pair' a class, as in 'class Pair \{ ... \}', because a class field only "
        + "refers to another object.");
}

// A cycle through two files is reported once, from the struct in the file whose path comes first.
test "a struct value cycle across modules is reported once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import Inner from inner;\n"
        + "public struct Outer \{\n"
        + "    public Inner nested;\n"
        + "\}\n");
    loader.add("/proj/src/inner.ens",
        "import Outer from main;\n"
        + "public struct Inner \{\n"
        + "    public Outer back;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/inner.ens",
        "Struct 'Inner' contains itself: field 'back' of 'Inner' has type 'Outer' and field "
        + "'nested' of 'Outer' has type 'Inner'. A struct keeps its fields inside itself, so every "
        + "'Inner' would contain another 'Inner' without end. Make 'Outer' a class, as in 'class "
        + "Outer \{ ... \}' where module 'main' declares it, because a class field only refers to "
        + "another object.");
}

test "declared throws types must be distinct exception classes" {
    let loader = new FakeFileLoader();
    string source = "class MyError extends Error \{\n"
        + "    constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Runner \{\n"
        + "    constructor();\n"
        + "    bad() throws Speaker \{ \}\n"
        + "    overlapping() throws MyError, Error \{ \}\n"
        + "\}\n"
        + "loose() throws MyError \{ \}\n"
        + "abstract class Vague \{\n"
        + "    abstract go() throws;\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 2L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "A declared throws type must be 'Error' or a subclass of it, and 'Speaker' is neither. "
        + "Remove 'Speaker' from the 'throws' list, or replace it with a class that extends "
        + "'Error'.");
    try sema_support.assertDiagnostic(checks, 1, "/proj/src/app.ens",
        "The 'throws' list names both 'Error' and 'MyError'. 'MyError' is a subclass of 'Error', "
        + "so 'Error' alone covers both. Remove 'MyError'.");
    try testing.assertEqual(checks[1].span().start, source.indexOf("MyError, Error"));
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Abstract method 'go' of 'Vague' is marked 'throws' but lists no exception types. Without "
        + "a body, the types it throws must be written out. List them after 'throws', as in "
        + "'throws Error', or remove 'throws'.");
    // A list on the free function 'loose' is accepted: it bounds the body, not only overrides.
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout, Stage.Checks]);
}

// A class that declares no constructor runs its base class's zero-argument constructor. The
// refusal is reported once, at the class. Building the class with 'new' or calling 'super()' on it
// reports nothing further. Each fix is written with the base's own parameters.
test "a class with no constructor needs a zero-argument base constructor it can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Hidden \{\n"
        + "    constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int width, string label = \"wide\") \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "\}\n"
        + "public class Mixed \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class OverMixed extends Mixed \{\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    protected constructor(T value) \{ \}\n"
        + "\}\n"
        + "class IntHolder extends Holder<int> \{\n"
        + "\}\n"
        + "class Wrapped<T> extends Holder<T> \{\n"
        + "\}\n"
        + "class Failure extends Error \{\n"
        + "\}\n"
        + "class Further extends OverSized \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let sized = new OverSized();\n"
        + "    let further = new Further();\n"
        + "    let wrapped = new Wrapped<string>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 7L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Class 'OverHidden' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Hidden', which declares none. Mark 'constructor(int)' in 'Hidden' as "
        + "'protected' so a subclass can call it, then declare a constructor that calls "
        + "'super(...)', as in 'constructor(int count) \{ super(count); \}'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Class 'OverSized' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Sized', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int width) \{ super(width); \}'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Class 'OverGuarded' declares no constructor, so it would run the zero-argument "
        + "constructor of its base class 'Guarded', which is private to 'Guarded'. Mark "
        + "'constructor()' in 'Guarded' as 'protected' so a subclass can call it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Class 'OverMixed' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Mixed', which is private to 'Mixed'. Declare a constructor that "
        + "calls 'super(...)', as in 'constructor(int width) \{ super(width); \}'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "Class 'IntHolder' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Holder<int>', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int value) \{ super(value); \}'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/main.ens",
        "Class 'Wrapped' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Holder<T>', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(T value) \{ super(value); \}'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/main.ens",
        "Class 'Failure' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Error', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(string message) \{ super(message); \}'.");
}

// A public constructor is out of reach of a subclass in another package. An exported one is within reach.
test "a class with no constructor cannot run a base constructor its package does not export" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Latched \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "export class Gear \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Latched from @acme.parts;\n"
        + "import Gear from @acme.parts;\n"
        + "class Bolt extends Latched \{\n"
        + "\}\n"
        + "class Cog extends Gear \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Class 'Bolt' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Latched', which is public inside package 'acme' but not exported. Mark "
        + "'constructor()' in 'Latched' as 'export' so a subclass in another package can call it.");
}

// The implicit chain stops at the nearest base class that declares constructors. A class below
// it with no constructor of its own is refused there, and the classes further down report
// nothing more. A constructor further down that reaches an excluded conditional constructor
// through such a class is refused where it is declared, with or without 'super()'.
test "the implicit chain walks through a class with no constructor to the base that declares them" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Mute \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Top<T> \{\n"
        + "    protected constructor<T: Speaker>() \{ \}\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "class Middle<T> extends Top<T> \{\n"
        + "\}\n"
        + "class Bottom extends Middle<Mute> \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class SuperBottom extends Middle<Mute> \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "\}\n"
        + "class Lower extends OverSized \{\n"
        + "\}\n"
        + "class Lowest extends OverSized \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let lower = new Lower();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 1L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "Class 'OverSized' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Sized', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int size) \{ super(size); \}'.");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Bottom' cannot initialize its base class 'Middle<Mute>'. 'Middle<Mute>' "
        + "declares no constructor, so it runs the zero-argument constructor of 'Top<Mute>'. That "
        + "constructor exists only when 'T' satisfies 'Speaker', and in 'Top<Mute>', 'T' is 'Mute', which "
        + "does not implement 'Speaker'. Give 'Top' a zero-argument constructor without that condition, "
        + "or use a type argument that implements 'Speaker'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'SuperBottom' cannot initialize its base class 'Middle<Mute>'. 'Middle<Mute>' "
        + "declares no constructor, so it runs the zero-argument constructor of 'Top<Mute>'. That "
        + "constructor exists only when 'T' satisfies 'Speaker', and in 'Top<Mute>', 'T' is 'Mute', which "
        + "does not implement 'Speaker'. Give 'Top' a zero-argument constructor without that condition, "
        + "or use a type argument that implements 'Speaker'.");
}

// The constructor a fix declares carries the marker that keeps the class as constructible as the
// constructor it replaces. A type the file has no name for comes with the import that binds one,
// under a name of its own where the file already uses the type's name.
test "a fix for a missing base constructor call keeps the class's reach and imports what it names" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens",
        "public class Widget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Gadget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor(Widget widget, Gadget[] gadgets) \{ \}\n"
        + "\}\n"
        + "export class Plain \{\n"
        + "    export constructor(int count) \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from parts;\n"
        + "import Plain from parts;\n"
        + "class Widget \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Child extends Base \{\n"
        + "\}\n"
        + "export class Shared extends Plain \{\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 2L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "Class 'Child' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Base', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'public constructor(PartsWidget widget, Gadget[] gadgets) \{ "
        + "super(widget, gadgets); \}', with 'import Widget as PartsWidget from parts;' and 'import "
        + "Gadget from parts;' at the top of the file.");
    try sema_support.assertDiagnostic(checked, 1, "/proj/src/main.ens",
        "Class 'Shared' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Plain', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'export constructor(int count) \{ super(count); \}'.");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Declared' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Base', which declares none. Start this constructor's "
        + "body with 'super(widget, gadgets);' and add 'PartsWidget widget, Gadget[] gadgets' to "
        + "its parameters, with 'import Widget as PartsWidget from parts;' and 'import Gadget from "
        + "parts;' at the top of the file.");
}

test "a throws list naming a type parameter beside its bound names both" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Boom extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "class Thrower<T: Boom> \{\n"
        + "    constructor();\n"
        + "    run() throws T, Boom \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The 'throws' list names both 'Boom' and 'T'. 'T' can only be 'Boom' or a subclass of it, "
        + "so 'Boom' alone covers both. Remove 'T'.");
}

test "a declaration that uses a type only its package can name is lowered to 'public'" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "public class Inner \{\n"
        + "\}\n"
        + "export class Holder \{\n"
        + "    export constructor();\n"
        + "    protected keep(Inner inner) \{\n"
        + "    \}\n"
        + "\}\n"
        + "export class Sizes \{\n"
        + "    public static const int limit = 3;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Sizes from @acme.parts;\n"
        + "class Local \{\n"
        + "    static const int copied = Sizes.limit;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'limit' is public inside package 'acme', so another package cannot read it. Mark it "
        + "'export' to read it here.");
    try sema_support.assertDiagnostic(found, 1, "/proj/vendor/acme/src/parts.ens",
        "Method 'keep' of class 'Holder' is protected, and 'Holder' is 'export', so a subclass in "
        + "another package can call it, but its parameter type uses 'Inner', which is only public "
        + "inside package 'acme'. Mark 'Inner' 'export'.");
}

test "a leak in a package names the module as a file of that package imports it" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/shapes/kit.ens",
        "class Secret \{\n"
        + "\}\n"
        + "export reveal(Secret secret) \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import @acme.shapes.kit;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/vendor/acme/src/shapes/kit.ens",
        "Function 'reveal' is 'export', but its parameter type uses 'Secret', which is private to "
        + "module 'shapes.kit'. Mark 'Secret' 'export'.");
}

// A fetched package is not the user's to edit, so a base constructor it keeps private is refused with
// the why and no fix that changes it.
test "a base constructor a fetched package keeps private is refused with no fix" {
    let loader = new FakeFileLoader();
    let fetched = sema_support.fetchedAcme(loader,
        "export class Base \{\n"
        + "    constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from @acme.parts;\n"
        + "class Child extends Base \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeWithFetched(loader, "/proj/src", ["main.ens"], fetched);
    let found = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens", "Class 'Child' declares no constructor, "
        + "so it would run the zero-argument constructor of its base class 'Base', which is private to "
        + "'Base'.");
    try testing.assertEqual(found.length, 1L);
}

// A leak is offered the fix that lowers the declaration only where nothing else breaks: never for an
// 'export' declaration, not for a type a more visible type implements, not for a member that overrides
// a method or belongs to a type in a module another module imports from, and for a function in a
// module no other module imports whole.
test "a leak offers to lower the declaration only where nothing else breaks" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "\n"
        + "public interface Shown \{\n"
        + "    show(Secret secret);\n"
        + "\}\n"
        + "\n"
        + "public class Board implements Shown \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public override show(Secret secret) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public class Plain \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public reveal(Secret secret) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public open(Secret secret) \{\n"
        + "\}\n"
        + "\n"
        + "export shipped(Secret secret) \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Board from lib;\n"
        + "\n"
        + "main() -> int \{\n"
        + "    let board = new Board();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    string file = "/proj/src/lib.ens";
    try sema_support.assertDiagnostic(found, 0, file, "Method 'show' of interface 'Shown' is 'public', but "
        + "its parameter type uses 'Secret', which is private to module 'lib'. Mark 'Secret' 'public'.");
    try sema_support.assertDiagnostic(found, 1, file, "Method 'show' of class 'Board' is 'public', but its "
        + "parameter type uses 'Secret', which is private to module 'lib'. Mark 'Secret' 'public'.");
    try sema_support.assertDiagnostic(found, 2, file, "Method 'reveal' of class 'Plain' is 'public', but its "
        + "parameter type uses 'Secret', which is private to module 'lib'. Mark 'Secret' 'public'.");
    try sema_support.assertDiagnostic(found, 3, file, "Function 'open' is 'public', but its parameter type "
        + "uses 'Secret', which is private to module 'lib'. Mark 'Secret' 'public', or remove 'public' "
        + "from 'open'.");
    try sema_support.assertDiagnostic(found, 4, file, "Function 'shipped' is 'export', but its parameter "
        + "type uses 'Secret', which is private to module 'lib'. Mark 'Secret' 'export'.");
    try testing.assertEqual(found.length, 5L);
}

// Lowering a type would make a more visible signature of the same module that names it leak it in
// turn, so the fix is withheld there. The type's own members are lowered with it, and a function no
// wider than the lowered type stays valid, so neither keeps the fix from being offered.
test "a type a more visible signature names is not offered the lowering" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/holder.ens",
        "class Secret \{\n"
        + "\}\n"
        + "\n"
        + "public class Holder \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    protected keep(Secret secret) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public make() -> Holder \{\n"
        + "    return new Holder();\n"
        + "\}\n"
        + "\n"
        + "public class Keeper \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    protected keep(Secret secret) \{\n"
        + "    \}\n"
        + "\n"
        + "    public copy() -> Keeper \{\n"
        + "        return new Keeper();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "made() -> Keeper \{\n"
        + "    return new Keeper();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "main() -> int \{\n    return 0;\n\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens", "holder.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    string file = "/proj/src/holder.ens";
    try sema_support.assertDiagnostic(found, 0, file, "Method 'keep' of class 'Holder' is "
        + "protected, and 'Holder' is 'public', so a subclass anywhere in the package can call it, "
        + "but its parameter type uses 'Secret', which is private to module 'holder'. Mark "
        + "'Secret' 'public'. Or mark 'Holder' 'final'.");
    try sema_support.assertDiagnostic(found, 1, file, "Method 'keep' of class 'Keeper' is "
        + "protected, and 'Keeper' is 'public', so a subclass anywhere in the package can call it, "
        + "but its parameter type uses 'Secret', which is private to module 'holder'. Mark "
        + "'Secret' 'public'. Or remove 'public' from 'Keeper', its constructor and 'copy'. Or mark "
        + "'Keeper' 'final'.");
    try testing.assertEqual(found.length, 2L);
}

// A package checked on its own is named by its manifest, as a build that consumes it names it.
test "a type only its package can name is named by the package's manifest when checked alone" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.lib \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/api.ens", "public class Inner \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "export make() -> Inner \{\n"
        + "    return new Inner();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["api.ens"]);
    let reported = analysis.checkDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/api.ens",
        "Function 'make' is 'export', but its return type uses 'Inner', which is only public inside "
        + "package 'demo.lib'. Mark 'Inner' 'export'.");
}

// A type that did not resolve is reported where it is written. A struct's method it could be the
// whole difference in is not compared with the requirement, and one that differs where both sides
// resolved is still reported.
test "a struct method that names an unresolved type is compared only where both sides resolved" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "interface Shape \{\n"
        + "    area() -> int;\n"
        + "    scaled(int x) -> int;\n"
        + "    measured(int width) -> int;\n"
        + "\}\n"
        + "struct Point implements Shape \{\n"
        + "    int x;\n"
        + "    override area() -> Lost \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    override scaled(Gone x) -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    override measured(Unknown width, string extra) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "    override missing(Absent value) \{\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    string file = "/proj/src/main.ens";
    let unknown = analysis.signatureDiagnostics();
    try testing.assertEqual(unknown.length, 4L);
    string fix = "Check the spelling, or import the module that declares it.";
    try sema_support.assertDiagnostic(unknown, 0, file, "Unknown type 'Lost'. {fix}");
    try sema_support.assertDiagnostic(unknown, 1, file, "Unknown type 'Gone'. {fix}");
    try sema_support.assertDiagnostic(unknown, 2, file, "Unknown type 'Unknown'. {fix}");
    try sema_support.assertDiagnostic(unknown, 3, file, "Unknown type 'Absent'. {fix}");
    let compared = analysis.checkDiagnostics();
    try testing.assertEqual(compared.length, 2L);
    try sema_support.assertDiagnostic(compared, 0, file, "Override of 'measured' is "
        + "'measured(Unknown, string) -> bool', but the 'measured' declared in interface 'Shape' is "
        + "'measured(int) -> int'. Change this 'measured' to match it, or remove 'override'.");
    try sema_support.assertDiagnostic(compared, 1, file, "Method 'missing' of 'Point' is marked "
        + "'override' but no interface 'Point' implements declares 'missing', and a struct inherits "
        + "nothing. Remove 'override'.");
}
