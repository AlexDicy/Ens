// Primitive bindings, the refused side: who may declare one, what it may name, what it may
// declare, and what a declared conformance still does not buy.
import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import ProgramAnalysis from pipeline;
import model.types;

// A program whose standard library carries the binding under test as one extra module.
analyzeStdBinding(string bindingSource) -> ProgramAnalysis {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens", bindingSource);
    loader.add("/proj/src/main.ens",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    return sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
}

test "only the standard library declares what a primitive's members are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "primitive string \{\n"
        + "    export shouted() -> string \{\n"
        + "        return this + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertDiagnostic(analysis.linkDiagnostics(), 0, "/proj/src/main.ens",
        "'primitive' declares what the members of a built-in type are, which only the standard "
        + "library may do. Elsewhere 'primitive' is an ordinary identifier. To add operations to "
        + "'string', write functions that take it, or a class or struct of your own.");
    try testing.assertEqual(analysis.linkDiagnostics().length, 1L);
    try testing.assertTrue(types.bindingOf(analysis.store().stringType()) == null,
        "a refused binding attaches nothing to the primitive");
}

test "a binding names a primitive that can carry members" {
    let analysis = analyzeStdBinding(
        "export class Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive void \{\n"
        + "\}\n"
        + "\n"
        + "primitive decimal \{\n"
        + "\}\n");
    let reported = analysis.linkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "'Widget' is not a primitive type, so it cannot carry a primitive binding. A binding "
        + "names one of 'bool', 'byte', 'short', 'ushort', 'int', 'uint', 'long', 'ulong', "
        + "'float', 'double', 'char', and 'string'; a type declared in Ens carries its members "
        + "in its own declaration.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "'void' cannot carry a primitive binding: 'void' is the absence of a value, so there is "
        + "nothing for a member to run on.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "'decimal' cannot carry a primitive binding: 'decimal' is reserved for a decimal type "
        + "the language does not have yet, so there is nothing to declare members on.");
    try testing.assertEqual(reported.length, 3L);
}

test "one primitive takes one binding program-wide" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens", "primitive string \{\n\}\n");
    loader.add("/stdlib/std/src/again.ens", "primitive string \{\n\}\n");
    loader.add("/proj/src/main.ens",
        "import @std.text;\n"
        + "import @std.again;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertDiagnostic(analysis.linkDiagnostics(), 0,
        "/stdlib/std/src/again.ens",
        "'string' already has a primitive binding, declared in module 'std.text'. One primitive "
        + "takes one binding, so its members read in one place; add the members there instead.");
    try testing.assertEqual(analysis.linkDiagnostics().length, 1L);
}

test "a binding cannot replace what a call site is not the only way to reach" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export length() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    export toString() -> string \{\n"
        + "        return \"\";\n"
        + "    \}\n"
        + "\n"
        + "    export hash() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n");
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'length' of the 'string' binding cannot be declared: 'string.length' is the "
        + "byte count, read without parentheses, so a method named 'length' could never be "
        + "called. Choose another name.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'toString' of the 'string' binding cannot be declared: the text form of a "
        + "'string' is what interpolation and struct serialization answer with as well, so a "
        + "binding cannot replace it. Declare an overload that takes arguments, such as "
        + "'toString(int radix)', instead.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'hash' of the 'string' binding cannot be declared: the hash of a 'string' is "
        + "what a map keyed by one answers with as well, so a binding cannot replace it. Choose "
        + "another name.");
    try testing.assertEqual(reported.length, 3L);
}

test "a member without a body names an intrinsic that exists, at the shape it exists in" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export shouted() -> string;\n"
        + "\n"
        + "    export byteAt(long index) -> long;\n"
        + "\n"
        + "    public static fromBytesUnchecked(byte[] bytes) -> string throws;\n"
        + "\}\n");
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'shouted' of the 'string' binding has no body, so it names an intrinsic the "
        + "compiler implements, and 'shouted() -> string' is not one of them. The intrinsics of "
        + "'string' are 'byteAt(long) -> byte', 'toBytes() -> byte[]', "
        + "'sliceUnchecked(long, long) -> string', and "
        + "'static fromBytesUnchecked(byte[]) -> string'. Correct the name or the signature to "
        + "match one of those, or give 'shouted' a body to write it in Ens.");
    try sema_support.assertMentions(reported,
        "and 'byteAt(long) -> long' is not one of them");
    try sema_support.assertMentions(reported,
        "and 'fromBytesUnchecked(byte[]) -> string' is not one of them");
    try testing.assertEqual(reported.length, 3L);
}

test "a primitive the compiler implements no intrinsic for takes only written members" {
    let analysis = analyzeStdBinding(
        "primitive bool \{\n"
        + "    export flipped() -> bool;\n"
        + "\}\n");
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'flipped' of the 'bool' binding has no body, so it names an intrinsic the "
        + "compiler implements, and the compiler implements none for 'bool'. Give 'flipped' a "
        + "body to write it in Ens.");
    try testing.assertEqual(reported.length, 1L);
}

test "a binding declares neither storage nor a way to construct or destroy a value" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    long count;\n"
        + "\n"
        + "    static const long limit = 4;\n"
        + "\n"
        + "    export constructor();\n"
        + "\n"
        + "    destructor() \{\n"
        + "    \}\n"
        + "\}\n");
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a field: 'count' would need storage in every "
        + "'string' value, and a primitive carries none. Declare methods here, and put the "
        + "state in a class or struct that holds a 'string'.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a static const: it declares what a 'string' "
        + "value can do, not constants under the primitive's name. Declare 'limit' on a class "
        + "or struct of this module instead.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a constructor: a 'string' is written as a "
        + "literal or produced by an expression, never built with 'new'. Declare a static that "
        + "returns a 'string' instead.");
    try sema_support.assertDiagnostic(reported, 3, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a destructor: a primitive owns nothing to "
        + "release, and its values are copied rather than destroyed.");
    try testing.assertEqual(reported.length, 4L);
}

test "a binding's members are written out, so nothing there is abstract or final" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export abstract missing() -> long;\n"
        + "\n"
        + "    export bodiless() -> long;\n"
        + "\n"
        + "    export final fixed() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n");
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'missing' of the 'string' binding cannot be 'abstract': a primitive has no "
        + "subclass to supply a body, so every member here is written out.");
    try sema_support.assertMentions(reported,
        "Method 'bodiless' of the 'string' binding has no body, so it names an intrinsic the "
        + "compiler implements");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'fixed' of the 'string' binding cannot be 'final': 'final' forbids an override, "
        + "and a primitive has nothing that could override it.");
    try testing.assertEqual(reported.length, 3L);
}

test "an implements clause on a binding names interfaces only" {
    let analysis = analyzeStdBinding(
        "export class Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive char implements Widget \{\n"
        + "\}\n");
    try sema_support.assertDiagnostic(analysis.signatureDiagnostics(), 0,
        "/stdlib/std/src/text.ens",
        "'char' can only implement an interface, and 'Widget' is not one. A primitive has no "
        + "object to inherit into, so a binding never extends a class.");
    try testing.assertEqual(analysis.signatureDiagnostics().length, 1L);
}

test "a declared conformance has to hold, with the override marker a class needs" {
    let analysis = analyzeStdBinding(
        "export interface Wanted \{\n"
        + "    wanted() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive int implements Wanted \{\n"
        + "    export named() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\n"
        + "    export override unrelated() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "primitive ushort implements Wanted \{\n"
        + "    export wanted() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n");
    let reported = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "The binding for 'int' implements 'Wanted' but does not provide 'wanted() -> long'. "
        + "Declare the method here, or stop implementing 'Wanted'.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'unrelated' of the 'int' binding is marked 'override' but no implemented "
        + "interface declares it. A primitive has no base to override, so 'override' here only "
        + "means the member answers a conformance.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'wanted' of the 'ushort' binding implements a method declared in interface "
        + "'Wanted'; mark it 'override'.");
    try testing.assertEqual(reported.length, 3L);
}

test "a conformance satisfies a bound and never becomes an interface value" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens",
        "export interface Measured \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive int implements Measured \{\n"
        + "    export override size() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Measured from @std.text;\n"
        + "kept(Measured held) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Measured slot = 3;\n"
        + "    let passed = kept(3);\n"
        + "    Measured[] all = [3];\n"
        + "    Measured? absent = null;\n"
        + "    let fallback = absent ?? 3;\n"
        + "    let tested = 3 is Measured;\n"
        + "    let cast = 3 as? Measured;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot assign value of type 'int' to variable of type 'Measured'. 'int' does implement "
        + "'Measured', but only as a generic bound: a '<T: Measured>' parameter accepts 'int', "
        + "while an interface-typed slot needs a value that carries the interface, and a "
        + "primitive is never wrapped in one. Write the slot as 'int', or make it a type "
        + "parameter bounded by 'Measured'.");
    try sema_support.assertMentions(reported,
        "Argument 1: expected 'Measured', got 'int'. 'int' does implement 'Measured', but only "
        + "as a generic bound");
    try sema_support.assertMentions(reported,
        "Element 1: expected 'Measured', got 'int'. 'int' does implement 'Measured', but only "
        + "as a generic bound");
    try sema_support.assertMentions(reported,
        "Right of '??' has type 'int', which is not compatible with 'Measured'. 'int' does "
        + "implement 'Measured', but only as a generic bound: a '<T: Measured>' parameter "
        + "accepts 'int', while an interface-typed slot needs a value that carries the "
        + "interface, and a primitive is never wrapped in one. Write the slot as 'int', or make "
        + "it a type parameter bounded by 'Measured'. '??' supplies the value for a null left "
        + "side, so the fallback has to be of type 'Measured' as well.");
    try sema_support.assertMentions(reported,
        "Cannot use 'is' on a value of type 'int'; only class values can be tested. 'int' does "
        + "implement 'Measured', but only as a generic bound: 'is' works over a value that "
        + "carries the interface, and a primitive is never wrapped in one.");
    try sema_support.assertMentions(reported,
        "Cannot use 'as?' on a value of type 'int'; only class values can be cast. 'int' does "
        + "implement 'Measured', but only as a generic bound: 'as?' works over a value that "
        + "carries the interface, and a primitive is never wrapped in one.");
    try testing.assertEqual(reported.length, 6L);
}

test "text does not iterate on its own" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "main() -> int \{\n"
        + "    for (let c in \"text\") \{\n"
        + "        print(\"\{c\}\");\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'for (... in ...)' cannot iterate a 'string': text is not a sequence of its own, so a "
        + "walk over it says which view it reads. Iterate 'text.chars()' to visit the characters, or 'text.bytes()' to visit the bytes.");
}

test "a bare primitive keyword is a type name, not a value" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "main() -> int \{\n"
        + "    let held = string;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'string' is a type, not a value. A type name starts a static member access such as "
        + "'string.member(...)'; to work with an instance, construct or reference one.");
}

test "a primitive nothing declares members for has no static and no member" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "main() -> int \{\n"
        + "    let missing = string.joined(\"a\", \"b\");\n"
        + "    let alsoMissing = \"a\".isEmpty();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'string' has no static members; what the members of a primitive are is declared by the "
        + "standard library.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Type 'string' has no member 'isEmpty'.");
}
