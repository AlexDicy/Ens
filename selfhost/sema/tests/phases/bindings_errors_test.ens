// Primitive bindings, the refused side: who may declare one, what it may name, what it may
// declare, and what a declared conformance still does not buy.
import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import ProgramAnalysis from pipeline;
import model.types;

// A program whose standard library carries the binding under test as one extra module.
analyzeStdBinding(string bindingSource) -> ProgramAnalysis {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens", bindingSource);
    loader.add("/proj/src/main.ens",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    return sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
}

test "only the standard library declares what a primitive's members are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "primitive string \{\n"
        + "    export shouted() -> string \{\n"
        + "        return this + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    try sema_support.assertDiagnostic(analysis.linkDiagnostics(), 0, "/proj/src/main.ens",
        "'primitive' declares the members of a built-in type, which only the standard library may "
        + "do; elsewhere it is an ordinary identifier. To add operations to 'string', write "
        + "functions that take it, or a class or a struct of your own.");
    try testing.assertEqual(analysis.linkDiagnostics().length, 1L);
    try testing.assertTrue(types.bindingOf(analysis.store().stringType()) == null,
        "a refused binding attaches nothing to the primitive");
}

test "a binding names a primitive that can carry members" {
    let analysis = analyzeStdBinding(
        "export class Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive void \{\n"
        + "\}\n"
        + "\n"
        + "primitive decimal \{\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let reported = analysis.linkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "'Widget' is not a primitive type, so it cannot carry a primitive binding. A binding names "
        + "one of 'bool', 'byte', 'short', 'ushort', 'int', 'uint', 'long', 'ulong', 'float', "
        + "'double', 'char' and 'string'. Declare the members of 'Widget' in 'Widget' itself.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "'void' cannot carry a primitive binding: 'void' is the absence of a value, so there is "
        + "nothing for a member to run on.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "'decimal' cannot carry a primitive binding: 'decimal' is reserved for a decimal type "
        + "the language does not have yet, so there is nothing to declare members on.");
    try testing.assertEqual(reported.length, 3L);
}

test "one primitive takes one binding program-wide" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens", "primitive string \{\n\}\n");
    loader.add("/stdlib/std/src/again.ens", "primitive string \{\n\}\n");
    loader.add("/proj/src/main.ens",
        "import @std.text;\n"
        + "import @std.again;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    try sema_support.assertDiagnostic(analysis.linkDiagnostics(), 0,
        "/stdlib/std/src/again.ens",
        "'string' already has a primitive binding, declared in module 'std.text'. One primitive "
        + "takes one binding, so add the members there instead.");
    try testing.assertEqual(analysis.linkDiagnostics().length, 1L);
}

test "a binding cannot replace what a call site is not the only way to reach" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export length() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    export toString() -> string \{\n"
        + "        return \"\";\n"
        + "    \}\n"
        + "\n"
        + "    export hash() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'length' of the 'string' binding cannot be declared: 'string.length' is the "
        + "byte count, read without parentheses, so a method named 'length' could never be "
        + "called. Choose another name.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'toString' of the 'string' binding cannot be declared: the text form of a value of "
        + "type 'string' is what interpolation reads too, so a binding cannot replace it. "
        + "Declare an overload that takes arguments instead, such as 'toString(int radix)'.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'hash' of the 'string' binding cannot be declared: the hash of a value of type "
        + "'string' is what a map keyed by one reads too, so a binding cannot replace it. Choose "
        + "another name.");
    try testing.assertEqual(reported.length, 3L);
}

test "a member without a body names an intrinsic that exists, at the shape it exists in" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export shouted() -> string;\n"
        + "\n"
        + "    export byteAt(long index) -> long;\n"
        + "\n"
        + "    public static fromBytesUnchecked(byte[] bytes) -> string throws;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'shouted' of the 'string' binding has no body, and 'shouted() -> string' is not a "
        + "member the compiler implements. The ones it does are 'byteAt(long) -> byte', "
        + "'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string', and 'static "
        + "fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'shouted' a body "
        + "to write it in Ens.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'byteAt' of the 'string' binding has no body, and 'byteAt(long) -> long' is not a "
        + "member the compiler implements. The ones it does are 'byteAt(long) -> byte', "
        + "'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string', and 'static "
        + "fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'byteAt' a body to "
        + "write it in Ens.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'fromBytesUnchecked' of the 'string' binding has no body, and "
        + "'fromBytesUnchecked(byte[]) -> string' is not a member the compiler implements. The "
        + "ones it does are 'byteAt(long) -> byte', 'toBytes() -> byte[]', 'sliceUnchecked(long, "
        + "long) -> string', and 'static fromBytesUnchecked(byte[]) -> string'. Match one of "
        + "those, or give 'fromBytesUnchecked' a body to write it in Ens.");
    try testing.assertEqual(reported.length, 3L);
}

test "a primitive the compiler implements no intrinsic for takes only written members" {
    let analysis = analyzeStdBinding(
        "primitive bool \{\n"
        + "    export flipped() -> bool;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'flipped' of the 'bool' binding has no body, and the compiler implements no member "
        + "of 'bool' itself. Give 'flipped' a body to write it in Ens.");
    try testing.assertEqual(reported.length, 1L);
}

test "a binding declares neither storage nor a way to construct or destroy a value" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    long count;\n"
        + "\n"
        + "    static const long limit = 4;\n"
        + "\n"
        + "    export constructor();\n"
        + "\n"
        + "    destructor() \{\n"
        + "    \}\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a field: 'count' would need room in every value of "
        + "type 'string', and a primitive has none. Declare methods here, and keep the field on "
        + "a class or a struct that holds one.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a static const; it declares only what a value of "
        + "type 'string' can do. Declare 'limit' on a class or a struct of this module instead.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a constructor; a value of type 'string' is written "
        + "as a literal, never built with 'new'. Declare a static that returns one instead.");
    try sema_support.assertDiagnostic(reported, 3, "/stdlib/std/src/text.ens",
        "A binding for 'string' cannot declare a destructor; a value of type 'string' is copied, "
        + "never destroyed.");
    try testing.assertEqual(reported.length, 4L);
}

test "a binding's members are written out, so nothing there is abstract or final" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export abstract missing() -> long;\n"
        + "\n"
        + "    export bodiless() -> long;\n"
        + "\n"
        + "    export final fixed() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "Method 'missing' of the 'string' binding cannot be 'abstract'; a primitive has no "
        + "subclass to give it a body.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'bodiless' of the 'string' binding has no body, and 'bodiless() -> long' is not a "
        + "member the compiler implements. The ones it does are 'byteAt(long) -> byte', "
        + "'toBytes() -> byte[]', 'sliceUnchecked(long, long) -> string', and 'static "
        + "fromBytesUnchecked(byte[]) -> string'. Match one of those, or give 'bodiless' a body "
        + "to write it in Ens.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'fixed' of the 'string' binding cannot be 'final'; a primitive has no subclass "
        + "that could override it.");
    try testing.assertEqual(reported.length, 3L);
}

test "an implements clause on a binding names interfaces only" {
    let analysis = analyzeStdBinding(
        "export class Widget \{\n"
        + "\}\n"
        + "\n"
        + "primitive char implements Widget \{\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    try sema_support.assertDiagnostic(analysis.signatureDiagnostics(), 0,
        "/stdlib/std/src/text.ens",
        "'char' can only implement an interface, and 'Widget' is not one. A binding never extends "
        + "a class.");
    try testing.assertEqual(analysis.signatureDiagnostics().length, 1L);
}

test "a declared conformance has to hold, with the override marker a class needs" {
    let analysis = analyzeStdBinding(
        "export interface Wanted \{\n"
        + "    wanted() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive int implements Wanted \{\n"
        + "    export named() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\n"
        + "    export override unrelated() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "primitive ushort implements Wanted \{\n"
        + "    export wanted() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let reported = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "The binding for 'int' implements 'Wanted' but does not provide 'wanted() -> long'. "
        + "Declare the method here, or stop implementing 'Wanted'.");
    try sema_support.assertDiagnostic(reported, 1, "/stdlib/std/src/text.ens",
        "Method 'unrelated' of the 'int' binding is marked 'override' but no interface it "
        + "implements declares it. Remove 'override'.");
    try sema_support.assertDiagnostic(reported, 2, "/stdlib/std/src/text.ens",
        "Method 'wanted' of the 'ushort' binding implements a method declared in interface "
        + "'Wanted'; mark it 'override'.");
    try testing.assertEqual(reported.length, 3L);
}

test "a conformance satisfies a bound and never becomes an interface value" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens",
        "export interface Measured \{\n"
        + "    size() -> long;\n"
        + "\}\n"
        + "\n"
        + "primitive int implements Measured \{\n"
        + "    export override size() -> long \{\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Measured from @std.text;\n"
        + "kept(Measured held) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Measured slot = 3;\n"
        + "    let passed = kept(3);\n"
        + "    Measured[] all = [3];\n"
        + "    Measured? absent = null;\n"
        + "    let fallback = absent ?? 3;\n"
        + "    let tested = 3 is Measured;\n"
        + "    let cast = 3 as? Measured;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot assign value of type 'int' to variable of type 'Measured'. 'int' does implement "
        + "'Measured', but only as a generic bound: a '<T: Measured>' parameter accepts 'int', "
        + "while a value of type 'Measured' has to be a class instance, and a primitive never "
        + "is. Write the slot as 'int', or make it a type parameter bounded by 'Measured'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Argument 1: expected 'Measured', got 'int'. 'int' does implement 'Measured', but only "
        + "as a generic bound: a '<T: Measured>' parameter accepts 'int', while a value of type "
        + "'Measured' has to be a class instance, and a primitive never is. Write the slot as "
        + "'int', or make it a type parameter bounded by 'Measured'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Element 1: expected 'Measured', got 'int'. 'int' does implement 'Measured', but only "
        + "as a generic bound: a '<T: Measured>' parameter accepts 'int', while a value of type "
        + "'Measured' has to be a class instance, and a primitive never is. Write the slot as "
        + "'int', or make it a type parameter bounded by 'Measured'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Right of '??' has type 'int', and '??' supplies the value for a null left side, so the "
        + "fallback has to be a 'Measured' too. 'int' does implement 'Measured', but only as a "
        + "generic bound: a '<T: Measured>' parameter accepts 'int', while a value of type "
        + "'Measured' has to be a class instance, and a primitive never is. Write the slot as "
        + "'int', or make it a type parameter bounded by 'Measured'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot use 'is' on a value of type 'int'; only class values can be tested. 'int' does "
        + "implement 'Measured', but only as a generic bound: 'is' works on class instances, and "
        + "a primitive never is one.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "Cannot use 'as?' on a value of type 'int'; only class values can be cast. 'int' does "
        + "implement 'Measured', but only as a generic bound: 'as?' works on class instances, "
        + "and a primitive never is one.");
    try testing.assertEqual(reported.length, 6L);
}

test "text does not iterate on its own" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "makeText() -> string \{\n"
        + "    return \"text\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    for (let c in \"text\") \{\n"
        + "        print(\"\{c\}\");\n"
        + "    \}\n"
        + "    for (let d in makeText() + \"!\") \{\n"
        + "        print(\"\{d\}\");\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "A 'string' cannot be iterated directly. Iterate '\"text\".chars()' to visit its "
        + "characters, or '\"text\".bytes()' to visit its bytes.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "A 'string' cannot be iterated directly. Iterate its 'chars()' to visit its characters, "
        + "or its 'bytes()' to visit its bytes.");
    try testing.assertEqual(reported.length, 2L);
}

test "a string binding cannot iterate 'this' either" {
    let analysis = analyzeStdBinding(
        "primitive string \{\n"
        + "    export characterCount() -> long \{\n"
        + "        long counted = 0;\n"
        + "        for (let c in this) \{\n"
        + "            counted = counted + 1;\n"
        + "        \}\n"
        + "        return counted;\n"
        + "    \}\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/stdlib/std/src/text.ens",
        "A 'string' cannot be iterated directly. Iterate 'this.chars()' to visit its characters, "
        + "or 'this.bytes()' to visit its bytes.");
    try testing.assertEqual(reported.length, 1L);
}

// A primitive's values are literals, and a primitive no binding declares members for has no
// static either, so the refusal has nothing to add to itself.
test "a bare primitive keyword is a type name, not a value" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "main() -> int \{\n"
        + "    let held = string;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'string' is a type, not a value.");
    try testing.assertEqual(reported.length, 1L);
}

// The statics a primitive has are the ones its binding declares, so the refusal names the first
// one this file can reach and passes over the one it cannot.
test "a bare primitive keyword names a static its binding declares" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/text.ens",
        "primitive string \{\n"
        + "    public static libraryOnly(string text) -> string \{\n"
        + "        return text;\n"
        + "    \}\n"
        + "\n"
        + "    export static joined(string left, string right) -> string \{\n"
        + "        return left + right;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import @std.text;\n"
        + "main() -> int \{\n"
        + "    let held = string;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'string' is a type, not a value. Write 'string.joined(...)' to reach a static member.");
    try testing.assertEqual(reported.length, 1L);
}

test "a primitive nothing declares members for has no static and no member" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "main() -> int \{\n"
        + "    let missing = string.joined(\"a\", \"b\");\n"
        + "    let alsoMissing = \"a\".isEmpty();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'string' has no static members. Call 'joined' on a value of type 'string' instead.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Type 'string' has no member 'isEmpty'.");
    try testing.assertEqual(reported.length, 2L);
}
