import @std.testing;
import @ens.frontend.support.source;
import Span from @ens.frontend.support.source;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import LocalBinding from model.scopes;
import BindingKind from model.scopes;
import Scope from model.scopes;
import model.narrow;
import NarrowingPath from model.narrow;
import NarrowingState from model.narrow;
import PathSegment from model.narrow;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;

binding(string name, Type type) -> LocalBinding {
    return new LocalBinding(name, type, BindingKind.Variable, false, source.makeSpan(0, 0));
}

pathOf(LocalBinding root, List<PathSegment> segments) -> NarrowingPath {
    return new NarrowingPath(root, segments);
}

fieldPath(LocalBinding root, string field) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.fieldSegment(field));
    return new NarrowingPath(root, segments);
}

test "paths compare and hash by content" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("root", intType);
    let other = binding("other", intType);

    try testing.assertTrue(narrow.bindingPath(root) == narrow.bindingPath(root),
        "two spellings of the same root should be equal");
    try testing.assertTrue(narrow.bindingPath(root).hash() == narrow.bindingPath(root).hash(),
        "equal paths should hash equally");
    try testing.assertTrue(narrow.bindingPath(root) != narrow.bindingPath(other),
        "distinct roots should differ");

    try testing.assertTrue(fieldPath(root, "door") == fieldPath(root, "door"),
        "field segments should compare by name");
    try testing.assertTrue(fieldPath(root, "door").hash() == fieldPath(root, "door").hash(),
        "equal field paths should hash equally");
    try testing.assertTrue(fieldPath(root, "door") != fieldPath(root, "window"),
        "different field names should differ");
    try testing.assertTrue(fieldPath(root, "door") != narrow.bindingPath(root),
        "a longer path should differ from its root");
}

test "state layers narrow, look up innermost-first, and pop cleanly" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let root = binding("value", optionalInt);
    let state = new NarrowingState();

    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "an unproven path reads as null");
    state.narrow(narrow.bindingPath(root), intType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "a narrowed path reads its proven type");

    state.push();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "an inner layer sees the outer proof");
    state.narrow(narrow.bindingPath(root), longType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == longType,
        "the innermost proof wins");
    state.pop();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "popping a layer restores the outer proof");
}

test "invalidation erases across every layer" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("room", intType);
    let unrelated = binding("other", intType);
    let state = new NarrowingState();

    state.narrow(fieldPath(root, "door"), intType);
    state.push();
    state.narrow(narrow.bindingPath(root), intType);
    state.narrow(fieldPath(unrelated, "door"), intType);

    state.clearForRoot(root);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "a root clear drops the binding's own narrowing");
    try testing.assertTrue(state.provenType(fieldPath(root, "door")) == null,
        "a root clear drops a member path, even in an outer layer");
    try testing.assertTrue(state.provenType(fieldPath(unrelated, "door")) == intType,
        "paths under other roots are untouched");
}

test "a deeper write drops the paths it prefixes and nothing shorter" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let house = binding("house", intType);
    let state = new NarrowingState();

    let roomDoor = new List<PathSegment>();
    roomDoor.push(narrow.fieldSegment("room"));
    roomDoor.push(narrow.fieldSegment("door"));
    state.narrow(fieldPath(house, "room"), intType);
    state.narrow(pathOf(house, roomDoor), intType);

    let written = new List<PathSegment>();
    written.push(narrow.fieldSegment("room"));
    written.push(narrow.fieldSegment("door"));
    state.clearPrefixedBy(pathOf(house, written));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "writing house.room.door keeps the shorter house.room narrowing");
    let reread = new List<PathSegment>();
    reread.push(narrow.fieldSegment("room"));
    reread.push(narrow.fieldSegment("door"));
    try testing.assertTrue(state.provenType(pathOf(house, reread)) == null,
        "writing house.room.door drops house.room.door itself");

    state.narrow(pathOf(house, roomDoor), intType);
    state.clearPrefixedBy(fieldPath(house, "room"));
    try testing.assertTrue(state.provenType(pathOf(house, roomDoor)) == null,
        "writing house.room drops the deeper house.room.door narrowing");

    let other = binding("other", intType);
    state.narrow(fieldPath(house, "room"), intType);
    state.clearPrefixedBy(fieldPath(other, "room"));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "a write under another root keeps the path");
}

analyzeBody(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "guards, re-checks, refinement, steps, and calls keep sound narrowings" {
    let analysis = try analyzeBody("class Door \{ protected int code; protected constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "use(Door d) \{ \}\n"
        + "guarded(Door? d) -> int \{\n"
        + "    if (d == null) \{ return 0; \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "recheck(int? n) -> int \{\n"
        + "    if (n != null) \{\n"
        + "        if (n != null) \{ return n; \}\n"
        + "        return n ?? 0;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "refined() -> int \{\n"
        + "    int? n = null;\n"
        + "    n = 5;\n"
        + "    return n;\n"
        + "\}\n"
        + "stepped(int? n) -> int \{\n"
        + "    if (n == null) \{ return 0; \}\n"
        + "    n++;\n"
        + "    --n;\n"
        + "    n += 1;\n"
        + "    return n;\n"
        + "\}\n"
        + "keepAcrossCall(Door? d) -> int \{\n"
        + "    if (d != null) \{\n"
        + "        use(d);\n"
        + "        return d.code;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "narrowedScrutinee(Color? c) -> int \{\n"
        + "    if (c == null) \{ return -1; \}\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "nullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, null -> 0, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return guarded(new Door(1)) + recheck(2) + refined() + stepped(5)\n"
        + "        + keepAcrossCall(new Door(3)) + narrowedScrutinee(Color.Red)\n"
        + "        + nullArm(null);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A stable place is a local, a parameter, 'this', or a 'const' field reached through a stable
// place, however long the chain, and a check on one narrows it. A call that cannot reach the
// chain's root keeps it narrowed. A value that is not stable reads cleanly once it is copied into
// a local, which is the fix the refusals suggest.
test "a check narrows a local, a parameter, 'this' and a 'const' field reached through one" {
    let analysis = try analyzeBody("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "    protected const int? count;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null, this.count = null);\n"
        + "\n"
        + "    protected limitLength() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected innerCount() -> int \{\n"
        + "        if (this.inner != null && this.inner.count != null) \{\n"
        + "            return this.inner.count;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "unrelated(Meter m) \{ \}\n"
        + "throughLocal(Gauge gauge, Meter m) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        unrelated(m);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedField(Meter m) -> int \{\n"
        + "    let level = m.level;\n"
        + "    if (level != null) \{\n"
        + "        return level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedElement(int?[] cells) -> int \{\n"
        + "    let value = cells[0];\n"
        + "    if (value != null) \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\", null, 3), 1);\n"
        + "    let m = new Meter();\n"
        + "    return (gauge.limitLength() + throughLocal(gauge, m)) as int + gauge.innerCount()\n"
        + "        + copiedField(m) + copiedElement(new int?[1]);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// The advice a null-use refusal gives for a value whose check cannot hold, naming the step that
// is not stable and the local copy that is.
unstableAdvice(string subject, string kind, string copy) -> string {
    return "{subject} is {kind}, so it can change at any time, and a null check on it does not "
        + "carry to a later use. Copy it into a local first ('{copy}') and check the local.";
}

// unstableAdvice for a value an operator changes, whose fix writes the result back.
unstableWriteAdvice(string subject, string copy, string place) -> string {
    return "{subject} is a field, so it can change at any time, and a null check on it does not "
        + "carry to a later use. Copy it into a local first ('{copy}'), check the local, and "
        + "write the result back to '{place}'.";
}

// A mutable field and an array element are never stable places, so a check on either narrows
// nothing and a write through either refines nothing. Each refusal that would otherwise suggest
// the check names the step at fault and the local copy instead, wherever it fires: passing the
// value on, reading a member, indexing, slicing, calling a function value, arithmetic, a compound
// assignment and '++'. In a chain it is the outermost unstable step, and a step too long to quote
// leaves the copy unspelled. A member only a subclass has gets the type test's version, and a
// member no subclass has gets none.
test "a mutable field or an array element keeps no narrowing" {
    let analysis = try analyzeBody("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "    protected Meter? next = null;\n"
        + "    protected const Meter? fixed;\n"
        + "    protected int[]? slots = null;\n"
        + "    protected ((int) -> int)? handler = null;\n"
        + "    protected Shape shape = new Circle();\n"
        + "\n"
        + "    protected constructor(this.fixed = null);\n"
        + "\n"
        + "    protected read() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Meter \{\n"
        + "    return new Meter();\n"
        + "\}\n"
        + "passed(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "written(Meter m) -> int \{\n"
        + "    m.level = 4;\n"
        + "    return m.level;\n"
        + "\}\n"
        + "memberRead(Meter m) -> int \{\n"
        + "    if (m.next != null) \{\n"
        + "        return m.next.read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "indexed(Meter m) -> int \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "sliced(Meter m) -> long \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots.slice(0, 1).length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "called(Meter m) -> int \{\n"
        + "    if (m.handler != null) \{\n"
        + "        return m.handler(1);\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "fixedThenMutable(Meter m) -> int \{\n"
        + "    if (m.fixed != null && m.fixed.level != null) \{\n"
        + "        return m.fixed.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "unspellable() -> int \{\n"
        + "    if (make().level != null) \{\n"
        + "        return make().level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "element(int?[] cells) -> int \{\n"
        + "    if (cells[0] != null) \{\n"
        + "        return cells[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementWrite(int?[] cells) -> int \{\n"
        + "    cells[0] = 4;\n"
        + "    return cells[0];\n"
        + "\}\n"
        + "elementUnspellable(int?[] cells, int i) -> int \{\n"
        + "    if (cells[i + 1] != null) \{\n"
        + "        return cells[i + 1];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementMember(Meter?[] meters) -> int \{\n"
        + "    if (meters[0] != null) \{\n"
        + "        return meters[0].read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "tested(Meter m) -> int \{\n"
        + "    if (m.shape is Circle) \{\n"
        + "        return m.shape.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "misspelled(Meter m) -> int \{\n"
        + "    return m.shape.radiuss;\n"
        + "\}\n"
        + "added(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level + 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "addedInPlace(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "stepped(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level++;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Meter();\n"
        + "    addedInPlace(m);\n"
        + "    stepped(m);\n"
        + "    int?[] cells = new int?[2];\n"
        + "    Meter?[] meters = new Meter?[1];\n"
        + "    return passed(m) + written(m) + memberRead(m) + indexed(m) + (sliced(m) as int)\n"
        + "        + called(m) + fixedThenMutable(m) + unspellable() + element(cells)\n"
        + "        + elementWrite(cells) + elementUnspellable(cells, 0) + elementMember(meters)\n"
        + "        + tested(m) + misspelled(m) + added(m);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string returned = "Cannot return value of type 'int?' from function returning 'int'. The "
        + "value may be null here. ";
    string ofLevel = unstableAdvice("'level'", "a field", "let level = m.level;");
    string ofCell = unstableAdvice("'cells[0]'", "an array element", "let value = cells[0];");
    string ofSlots = unstableAdvice("'slots'", "a field", "let slots = m.slots;");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", returned + ofLevel);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", returned + ofLevel);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Cannot read a member of 'Meter?' because it may be null here. "
        + unstableAdvice("'next'", "a field", "let next = m.next;"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Cannot index 'int[]?' because it may be null. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot call 'slice' on 'int[]?' because it may be null. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'handler' has type '((int) -> int)?', which may be null here. "
        + unstableAdvice("'handler'", "a field", "let handler = m.handler;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        returned + unstableAdvice("'level'", "a field", "let level = m.fixed.level;"));
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        returned + unstableAdvice("'level'", "a field", "let level = ...;"));
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens", returned + ofCell);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens", returned + ofCell);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        returned + unstableAdvice("This value", "an array element", "let value = ...;"));
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "Cannot read a member of 'Meter?' because it may be null here. "
        + unstableAdvice("'meters[0]'", "an array element", "let value = meters[0];"));
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "No field or method 'radius' on type 'Shape'. 'shape' is a field, so it can change at any "
        + "time, and a type test on it does not carry to a later use. Copy it into a local first "
        + "('let shape = m.shape;') and test the local.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "No field or method 'radiuss' on type 'Shape'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'+' needs numbers on both sides, got 'int?' and 'int'. " + ofLevel);
    string writtenBack = unstableWriteAdvice("'level'", "let level = m.level;", "m.level");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, got 'int?' and 'int'. " + writtenBack);
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "The '++' operator works only on numbers, and this value has type 'int?'. " + writtenBack);
    try testing.assertEqual(reported.length, 17L);
}

// Every operator that refuses an optional operand gives the same guidance when the operand is a
// checked mutable field: a comparison, a shift, a bitwise operator, string concatenation on
// either side, a prefix operator and '&&'. A compound form writes the result back, unless the
// field is read from a call's result, which no write can reach.
test "an operator refused on a checked mutable field names the field and the local copy" {
    let analysis = try analyzeBody("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "    protected string? label = \"a\";\n"
        + "    protected bool? flag = true;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected all() \{\n"
        + "        if (this.count != null && this.label != null && this.flag != null) \{\n"
        + "            bool compared = this.count <= 3;\n"
        + "            this.count <<= 1;\n"
        + "            int shifted = 1 << this.count;\n"
        + "            this.count &= 1;\n"
        + "            this.label += \"x\";\n"
        + "            string joined = \"x\" + this.label;\n"
        + "            int negated = -this.count;\n"
        + "            bool inverted = !this.flag;\n"
        + "            int flipped = ~this.count;\n"
        + "            bool both = this.flag && true;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Tally \{\n"
        + "    return new Tally();\n"
        + "\}\n"
        + "temporary() \{\n"
        + "    make().count++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    new Tally().all();\n"
        + "    temporary();\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofCount = unstableAdvice("'count'", "a field", "let count = this.count;");
    string ofFlag = unstableAdvice("'flag'", "a field", "let flag = this.flag;");
    string backToCount = unstableWriteAdvice("'count'", "let count = this.count;", "this.count");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'<=' compares numbers, got 'int?' and 'int'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'<<=' shifts an integer, got 'int?'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'<<' needs an integer shift distance, got 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'&=' needs integers on both sides, got 'int?' and 'int'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot add a string to a value of type 'string?'; only a string, a number and a 'bool' "
        + "can be added. " + unstableWriteAdvice("'label'", "let label = this.label;", "this.label"));
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "Cannot add a value of type 'string?' to a string; only a string, a number and a 'bool' "
        + "can be added. " + unstableAdvice("'label'", "a field", "let label = this.label;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Unary '-' needs a number, got 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'!' negates a 'bool', got 'bool?'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'~' flips the bits of an integer, got 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'&&' needs 'bool' on both sides, got 'bool?' and 'bool'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "The '++' operator works only on numbers, and this value has type 'int?'. "
        + unstableAdvice("'count'", "a field", "let count = ...;"));
    try testing.assertEqual(reported.length, 11L);
}

// No callee can write a 'const' field, so a call drops nothing a stable place proved: not through
// 'this' as the receiver, not through a chain as the receiver, and not through the root passed as
// an argument or to a constructor.
test "a call drops nothing a stable place proved" {
    let analysis = try analyzeBody("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null);\n"
        + "\n"
        + "    protected touch() \{\n"
        + "    \}\n"
        + "\n"
        + "    protected limitAfterCall() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            this.touch();\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Wrapper \{\n"
        + "    protected constructor(Gauge gauge) \{\n"
        + "    \}\n"
        + "\}\n"
        + "touched(Gauge gauge) \{ \}\n"
        + "afterCalls(Gauge gauge) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        gauge.inner.touch();\n"
        + "        touched(gauge);\n"
        + "        let wrapper = new Wrapper(gauge);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\"));\n"
        + "    return (gauge.limitAfterCall() + afterCalls(gauge)) as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "unsound reads stay rejected under narrowing" {
    let analysis = try analyzeBody("class Door \{ protected int code; protected constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "maybeInt() -> int? \{ return 3; \}\n"
        + "leaky(Door? d) -> int \{\n"
        + "    if (d == null) \{ \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "widened() -> int \{\n"
        + "    int? n = 5;\n"
        + "    n = maybeInt();\n"
        + "    return n;\n"
        + "\}\n"
        + "presence(int y) -> int \{\n"
        + "    return y ?? 3;\n"
        + "\}\n"
        + "missingNullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return leaky(null) + widened() + presence(1)\n"
        + "        + missingNullArm(null);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'Door?' because it may be null here. Check it for null first "
        + "('if (value != null)'), read it with '?.' to get a nullable result, or supply a "
        + "fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot return value of type 'int?' from function returning 'int'. The value may be null "
        + "here; check it first ('if (value != null)'), or supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Left of '??' must be a nullable value, got 'int', which can never be null. Remove the "
        + "'??', or make the left side nullable.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "This switch value can be null but no arm handles it. Add a 'null ->' arm or a 'default' arm.");
    try testing.assertEqual(reported.length, 4L);
}

// The advice a null-use refusal gives for a checked 'weak' field named 'target'.
weakAdvice(string copy) -> string {
    return "'target' is a 'weak' field, so it can become null at any time, and a null check on it "
        + "does not carry to a later use. Copy it into a local first ('{copy}') and check the local.";
}

test "weak fields never narrow, but weak checks and the strong-local copy stay legal" {
    let analysis = try analyzeBody("class Node \{ protected int size; protected constructor(this.size = 0); \}\n"
        + "class Holder \{ protected weak Node? target; protected constructor(); \}\n"
        + "watch(Holder h) -> int \{\n"
        + "    if (h.target == null) \{ return 0; \}\n"
        + "    bool alive = h.target != null;\n"
        + "    let target = h.target;\n"
        + "    if (target != null && alive) \{ return target.size; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return watch(new Holder()); \}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "uses of a checked weak field are rejected with the weak explanation" {
    let analysis = try analyzeBody("class Node \{ protected int size; protected constructor(this.size = 0); "
        + "protected report() -> int \{ return this.size; \} \}\n"
        + "class Holder \{ protected weak Node? target; protected constructor(); \}\n"
        + "class Chain \{ protected const Holder? holder; protected constructor(this.holder = null); \}\n"
        + "consume(Node node) \{ \}\n"
        + "readAfterCheck(Holder h) -> int \{\n"
        + "    if (h.target != null) \{ return h.target.size; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "callAfterCheck(Holder k) -> int \{\n"
        + "    if (k.target != null) \{ return k.target.report(); \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "interpolateAfterCheck(Holder h) -> string \{\n"
        + "    if (h.target != null) \{ return \"\{h.target\}\"; \}\n"
        + "    return \"gone\";\n"
        + "\}\n"
        + "passAfterCheck(Holder h) \{\n"
        + "    if (h.target != null) \{ consume(h.target); \}\n"
        + "\}\n"
        + "throughLongerPath(Chain c) -> int \{\n"
        + "    if (c.holder != null && c.holder.target != null) \{\n"
        + "        return c.holder.target.size;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    passAfterCheck(new Holder());\n"
        + "    int total = readAfterCheck(new Holder()) + callAfterCheck(new Holder())\n"
        + "        + throughLongerPath(new Chain());\n"
        + "    if (interpolateAfterCheck(new Holder()) == \"gone\") \{ return total; \}\n"
        + "    return total + 1;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string memberRead = "Cannot read a member of 'Node?' because it may be null here. ";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        memberRead + weakAdvice("let target = h.target;"));
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        memberRead + weakAdvice("let target = k.target;"));
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Argument 1: expected 'Node', got 'Node?'. The value may be null here. "
        + weakAdvice("let target = h.target;"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        memberRead + weakAdvice("let target = c.holder.target;"));
    try testing.assertEqual(reported.length, 4L);
}
