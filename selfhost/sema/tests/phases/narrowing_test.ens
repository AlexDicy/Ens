import @std.testing;
import @ens.frontend.support.source;
import Span from @ens.frontend.support.source;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;
import LocalBinding from model.scopes;
import BindingKind from model.scopes;
import Scope from model.scopes;
import model.narrow;
import NarrowingPath from model.narrow;
import NarrowingState from model.narrow;
import PathSegment from model.narrow;
import SegmentKind from model.narrow;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import List from @std.collections.list;

private binding(string name, Type type) -> LocalBinding {
    return new LocalBinding(name, type, BindingKind.Variable, false, source.makeSpan(0, 0));
}

private pathOf(LocalBinding root, List<PathSegment> segments) -> NarrowingPath {
    return new NarrowingPath(root, segments);
}

private fieldPath(LocalBinding root, string field) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.fieldSegment(field));
    return new NarrowingPath(root, segments);
}

private literalPath(LocalBinding root, long index) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.literalIndexSegment(index));
    return new NarrowingPath(root, segments);
}

private indexPath(LocalBinding root, LocalBinding index) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.bindingIndexSegment(index));
    return new NarrowingPath(root, segments);
}

test "paths compare and hash by content" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("root", intType);
    let other = binding("other", intType);

    try testing.assertTrue(narrow.bindingPath(root) == narrow.bindingPath(root),
        "two spellings of the same root should be equal");
    try testing.assertTrue(narrow.bindingPath(root).hash() == narrow.bindingPath(root).hash(),
        "equal paths should hash equally");
    try testing.assertTrue(narrow.bindingPath(root) != narrow.bindingPath(other),
        "distinct roots should differ");

    try testing.assertTrue(fieldPath(root, "door") == fieldPath(root, "door"),
        "field segments should compare by name");
    try testing.assertTrue(fieldPath(root, "door").hash() == fieldPath(root, "door").hash(),
        "equal field paths should hash equally");
    try testing.assertTrue(fieldPath(root, "door") != fieldPath(root, "window"),
        "different field names should differ");
    try testing.assertTrue(fieldPath(root, "door") != narrow.bindingPath(root),
        "a longer path should differ from its root");

    try testing.assertTrue(literalPath(root, 0) == literalPath(root, 0),
        "literal indices should compare by value");
    try testing.assertTrue(literalPath(root, 0) != literalPath(root, 1),
        "different literal indices should differ");

    let index = binding("i", intType);
    try testing.assertTrue(indexPath(root, index) == indexPath(root, index),
        "identifier indices should compare by binding identity");
    try testing.assertTrue(indexPath(root, index) != indexPath(root, binding("i", intType)),
        "same-named but distinct index bindings should differ");
    try testing.assertTrue(literalPath(root, 0) != indexPath(root, index),
        "segment kinds should not cross-match");
}

test "segment aliasing distinguishes literal indices and nothing else" {
    let door = narrow.fieldSegment("door");
    let window = narrow.fieldSegment("window");
    let zero = narrow.literalIndexSegment(0);
    let two = narrow.literalIndexSegment(2);
    let store = new TypeStore();
    let index = binding("i", store.primitive(PrimitiveKind.Int));
    let identIndex = narrow.bindingIndexSegment(index);
    let anyIndex = narrow.anyIndexSegment();

    try testing.assertTrue(narrow.segmentsMayAlias(door, door),
        "a field aliases itself");
    try testing.assertTrue(!narrow.segmentsMayAlias(door, window),
        "distinct fields never alias");
    try testing.assertTrue(!narrow.segmentsMayAlias(door, zero),
        "a field never aliases a subscript");
    try testing.assertTrue(narrow.segmentsMayAlias(zero, zero),
        "the same literal index aliases itself");
    try testing.assertTrue(!narrow.segmentsMayAlias(zero, two),
        "two distinct literal indices never alias");
    try testing.assertTrue(narrow.segmentsMayAlias(zero, identIndex),
        "an identifier index may alias any literal index");
    try testing.assertTrue(narrow.segmentsMayAlias(identIndex, zero),
        "a literal write may alias an identifier-index narrowing");
    try testing.assertTrue(narrow.segmentsMayAlias(identIndex, identIndex),
        "identifier indices may alias each other");
    try testing.assertTrue(narrow.segmentsMayAlias(zero, anyIndex),
        "a computed-index write may alias every element");
}

test "state layers narrow, look up innermost-first, and pop cleanly" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let root = binding("value", optionalInt);
    let state = new NarrowingState();

    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "an unproven path reads as null");
    state.narrow(narrow.bindingPath(root), intType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "a narrowed path reads its proven type");

    state.push();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "an inner layer sees the outer proof");
    state.narrow(narrow.bindingPath(root), longType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == longType,
        "the innermost proof wins");
    state.pop();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "popping a layer restores the outer proof");
}

test "invalidation erases across every layer" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("room", intType);
    let unrelated = binding("other", intType);
    let state = new NarrowingState();

    state.narrow(fieldPath(root, "door"), intType);
    state.push();
    state.narrow(narrow.bindingPath(root), intType);
    state.narrow(fieldPath(unrelated, "door"), intType);

    state.clearForRootMembers(root);
    try testing.assertTrue(state.provenType(fieldPath(root, "door")) == null,
        "a member path rooted at the touched binding drops, even in an outer layer");
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "the binding's own narrowing survives a member clear");
    try testing.assertTrue(state.provenType(fieldPath(unrelated, "door")) == intType,
        "paths under other roots are untouched");

    state.clearForRoot(root);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "a root clear drops the binding's own narrowing too");
}

test "write invalidation follows the aliasing matrix" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let xs = binding("xs", intType);
    let index = binding("i", intType);
    let state = new NarrowingState();

    state.narrow(literalPath(xs, 0), intType);
    state.narrow(literalPath(xs, 1), intType);
    state.narrow(indexPath(xs, index), intType);

    state.clearMayAlias(literalPath(xs, 2));
    try testing.assertTrue(state.provenType(literalPath(xs, 0)) == intType
        && state.provenType(literalPath(xs, 1)) == intType,
        "a write at a distinct literal index keeps other literal narrowings");
    try testing.assertTrue(state.provenType(indexPath(xs, index)) == null,
        "a literal write drops an identifier-index narrowing");

    state.narrow(indexPath(xs, index), intType);
    state.clearMayAlias(indexPath(xs, index));
    try testing.assertTrue(state.provenType(literalPath(xs, 0)) == null
        && state.provenType(literalPath(xs, 1)) == null,
        "an identifier-index write drops every literal narrowing");

    state.narrow(literalPath(xs, 0), intType);
    let anySegments = new List<PathSegment>();
    anySegments.push(narrow.anyIndexSegment());
    state.clearMayAlias(pathOf(xs, anySegments));
    try testing.assertTrue(state.provenType(literalPath(xs, 0)) == null,
        "a computed-index write drops every element narrowing");

    state.narrow(literalPath(xs, 0), intType);
    state.narrow(narrow.bindingPath(xs), intType);
    state.clearMayAlias(literalPath(xs, 0));
    try testing.assertTrue(state.provenType(narrow.bindingPath(xs)) == intType,
        "an element write keeps the array binding's own narrowing");
}

test "a deeper write drops the paths it prefixes and nothing shorter" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let house = binding("house", intType);
    let state = new NarrowingState();

    let roomDoor = new List<PathSegment>();
    roomDoor.push(narrow.fieldSegment("room"));
    roomDoor.push(narrow.fieldSegment("door"));
    state.narrow(fieldPath(house, "room"), intType);
    state.narrow(pathOf(house, roomDoor), intType);

    let written = new List<PathSegment>();
    written.push(narrow.fieldSegment("room"));
    written.push(narrow.fieldSegment("door"));
    state.clearMayAlias(pathOf(house, written));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "writing house.room.door keeps the shorter house.room narrowing");
    let reread = new List<PathSegment>();
    reread.push(narrow.fieldSegment("room"));
    reread.push(narrow.fieldSegment("door"));
    try testing.assertTrue(state.provenType(pathOf(house, reread)) == null,
        "writing house.room.door drops house.room.door itself");

    state.narrow(pathOf(house, roomDoor), intType);
    state.clearMayAlias(fieldPath(house, "room"));
    try testing.assertTrue(state.provenType(pathOf(house, roomDoor)) == null,
        "writing house.room drops the deeper house.room.door narrowing");
}

private analyzeBody(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    return analysis;
}

test "guards, re-checks, refinement, and calls keep sound narrowings" {
    let analysis = try analyzeBody("class Door \{ int code; constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "use(Door d) \{ \}\n"
        + "guarded(Door? d) -> int \{\n"
        + "    if (d == null) \{ return 0; \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "recheck(int? n) -> int \{\n"
        + "    if (n != null) \{\n"
        + "        if (n != null) \{ return n; \}\n"
        + "        return n ?? 0;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "refined() -> int \{\n"
        + "    int? n = null;\n"
        + "    n = 5;\n"
        + "    return n;\n"
        + "\}\n"
        + "keepAcrossCall(Door? d) -> int \{\n"
        + "    if (d != null) \{\n"
        + "        use(d);\n"
        + "        return d.code;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "narrowedScrutinee(Color? c) -> int \{\n"
        + "    if (c == null) \{ return -1; \}\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "nullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, null -> 0, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return guarded(new Door(1)) + recheck(2) + refined()\n"
        + "        + keepAcrossCall(new Door(3)) + narrowedScrutinee(Color.Red)\n"
        + "        + nullArm(null);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "unsound reads stay rejected under narrowing" {
    let analysis = try analyzeBody("class Door \{ int code; constructor(this.code = 0); \}\n"
        + "class Room \{ Door? door; constructor(this.door = null); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "touch(Room r) \{ \}\n"
        + "maybeInt() -> int? \{ return 3; \}\n"
        + "dropped(Room r) -> int \{\n"
        + "    if (r.door != null) \{\n"
        + "        touch(r);\n"
        + "        return r.door.code;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "leaky(Door? d) -> int \{\n"
        + "    if (d == null) \{ \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "widened() -> int \{\n"
        + "    int? n = 5;\n"
        + "    n = maybeInt();\n"
        + "    return n;\n"
        + "\}\n"
        + "presence(int y) -> int \{\n"
        + "    return y ?? 3;\n"
        + "\}\n"
        + "missingNullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return dropped(new Room()) + leaky(null) + widened() + presence(1)\n"
        + "        + missingNullArm(null);\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot read a member of 'Door?' because it may be null");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot return value of type 'int?' from function returning 'int'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Left of '??' must be a nullable value, got 'int'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "This switch value can be null but no arm handles it");
}

test "index-binding invalidation drops only paths indexed through it" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let xs = binding("xs", intType);
    let index = binding("i", intType);
    let otherIndex = binding("j", intType);
    let state = new NarrowingState();

    state.narrow(indexPath(xs, index), intType);
    state.narrow(indexPath(xs, otherIndex), intType);
    state.narrow(literalPath(xs, 0), intType);

    state.clearForIndexBinding(index);
    try testing.assertTrue(state.provenType(indexPath(xs, index)) == null,
        "reassigning the index variable drops paths indexed through it");
    try testing.assertTrue(state.provenType(indexPath(xs, otherIndex)) == intType,
        "paths indexed through another binding survive");
    try testing.assertTrue(state.provenType(literalPath(xs, 0)) == intType,
        "literal-index paths survive an index-binding clear");
}
