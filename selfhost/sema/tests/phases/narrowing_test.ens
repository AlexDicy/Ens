import @std.testing;
import @ens.frontend.support.source;
import Span from @ens.frontend.support.source;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import LocalBinding from model.scopes;
import BindingKind from model.scopes;
import Scope from model.scopes;
import model.narrow;
import NarrowingPath from model.narrow;
import NarrowingState from model.narrow;
import PathSegment from model.narrow;
import model.types;
import Type from model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Field from model.types;
import Visibility from model.types;
import List from @std.collections.list;

binding(string name, Type type) -> LocalBinding {
    return new LocalBinding(name, type, BindingKind.Variable, false, source.makeSpan(0, 0));
}

pathOf(LocalBinding root, List<PathSegment> segments) -> NarrowingPath {
    return new NarrowingPath(root, segments);
}

fieldPath(LocalBinding root, string field) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.fieldSegment(field));
    return new NarrowingPath(root, segments);
}

test "paths compare and hash by content" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("root", intType);
    let other = binding("other", intType);

    try testing.assertTrue(narrow.bindingPath(root) == narrow.bindingPath(root),
        "two spellings of the same root should be equal");
    try testing.assertTrue(narrow.bindingPath(root).hash() == narrow.bindingPath(root).hash(),
        "equal paths should hash equally");
    try testing.assertTrue(narrow.bindingPath(root) != narrow.bindingPath(other),
        "distinct roots should differ");

    try testing.assertTrue(fieldPath(root, "door") == fieldPath(root, "door"),
        "field segments should compare by name");
    try testing.assertTrue(fieldPath(root, "door").hash() == fieldPath(root, "door").hash(),
        "equal field paths should hash equally");
    try testing.assertTrue(fieldPath(root, "door") != fieldPath(root, "window"),
        "different field names should differ");
    try testing.assertTrue(fieldPath(root, "door") != narrow.bindingPath(root),
        "a longer path should differ from its root");
}

test "state layers narrow, look up innermost-first, and pop cleanly" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let root = binding("value", optionalInt);
    let state = new NarrowingState();

    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "an unproven path reads as null");
    state.narrow(narrow.bindingPath(root), intType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "a narrowed path reads its proven type");

    state.push();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "an inner layer sees the outer proof");
    state.narrow(narrow.bindingPath(root), longType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == longType,
        "the innermost proof wins");
    state.pop();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "popping a layer restores the outer proof");
}

test "invalidation erases across every layer" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("room", intType);
    let unrelated = binding("other", intType);
    let state = new NarrowingState();

    state.narrow(fieldPath(root, "door"), intType);
    state.push();
    state.narrow(narrow.bindingPath(root), intType);
    state.narrow(fieldPath(unrelated, "door"), intType);

    state.clearForRoot(root);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "a root clear drops the binding's own narrowing");
    try testing.assertTrue(state.provenType(fieldPath(root, "door")) == null,
        "a root clear drops a member path, even in an outer layer");
    try testing.assertTrue(state.provenType(fieldPath(unrelated, "door")) == intType,
        "paths under other roots are untouched");
}

test "a deeper write drops the paths it prefixes and nothing shorter" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let house = binding("house", intType);
    let state = new NarrowingState();

    let roomDoor = new List<PathSegment>();
    roomDoor.push(narrow.fieldSegment("room"));
    roomDoor.push(narrow.fieldSegment("door"));
    state.narrow(fieldPath(house, "room"), intType);
    state.narrow(pathOf(house, roomDoor), intType);

    let written = new List<PathSegment>();
    written.push(narrow.fieldSegment("room"));
    written.push(narrow.fieldSegment("door"));
    state.clearPrefixedBy(pathOf(house, written));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "writing house.room.door keeps the shorter house.room narrowing");
    let reread = new List<PathSegment>();
    reread.push(narrow.fieldSegment("room"));
    reread.push(narrow.fieldSegment("door"));
    try testing.assertTrue(state.provenType(pathOf(house, reread)) == null,
        "writing house.room.door drops house.room.door itself");

    state.narrow(pathOf(house, roomDoor), intType);
    state.clearPrefixedBy(fieldPath(house, "room"));
    try testing.assertTrue(state.provenType(pathOf(house, roomDoor)) == null,
        "writing house.room drops the deeper house.room.door narrowing");

    let other = binding("other", intType);
    state.narrow(fieldPath(house, "room"), intType);
    state.clearPrefixedBy(fieldPath(other, "room"));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "a write under another root keeps the path");
}

analyzeBody(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "guards, re-checks, refinement, steps, and calls keep sound narrowings" {
    let analysis = try analyzeBody("class Door \{ protected int code; protected "
        + "constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "use(Door d) \{ \}\n"
        + "guarded(Door? d) -> int \{\n"
        + "    if (d == null) \{ return 0; \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "recheck(int? n) -> int \{\n"
        + "    if (n != null) \{\n"
        + "        if (n != null) \{ return n; \}\n"
        + "        return n ?? 0;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "refined() -> int \{\n"
        + "    int? n = null;\n"
        + "    n = 5;\n"
        + "    return n;\n"
        + "\}\n"
        + "stepped(int? n) -> int \{\n"
        + "    if (n == null) \{ return 0; \}\n"
        + "    n++;\n"
        + "    --n;\n"
        + "    n += 1;\n"
        + "    return n;\n"
        + "\}\n"
        + "keepAcrossCall(Door? d) -> int \{\n"
        + "    if (d != null) \{\n"
        + "        use(d);\n"
        + "        return d.code;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "narrowedScrutinee(Color? c) -> int \{\n"
        + "    if (c == null) \{ return -1; \}\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "nullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, null -> 0, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return guarded(new Door(1)) + recheck(2) + refined() + stepped(5)\n"
        + "        + keepAcrossCall(new Door(3)) + narrowedScrutinee(Color.Red)\n"
        + "        + nullArm(null);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A stable place is a local, a parameter, 'this', or a 'const' field reached through a stable
// place, however long the chain, and a check on one narrows it. A call that cannot reach the
// chain's root keeps it narrowed. A value that is not stable reads cleanly once it is copied into
// a local, which is the fix the refusals suggest.
test "a check narrows a local, a parameter, 'this' and a 'const' field reached through one" {
    let analysis = try analyzeBody("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "    protected const int? count;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null, this.count = null);\n"
        + "\n"
        + "    protected limitLength() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected innerCount() -> int \{\n"
        + "        if (this.inner != null && this.inner.count != null) \{\n"
        + "            return this.inner.count;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "unrelated(Meter m) \{ \}\n"
        + "throughLocal(Gauge gauge, Meter m) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        unrelated(m);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedField(Meter m) -> int \{\n"
        + "    let level = m.level;\n"
        + "    if (level != null) \{\n"
        + "        return level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedElement(int?[] cells) -> int \{\n"
        + "    let value = cells[0];\n"
        + "    if (value != null) \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\", null, 3), 1);\n"
        + "    let m = new Meter();\n"
        + "    return (gauge.limitLength() + throughLocal(gauge, m)) as int + gauge.innerCount()\n"
        + "        + copiedField(m) + copiedElement(new int?[1]);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// The advice a null-use refusal gives for a value whose check cannot hold, naming the step that
// is not stable and the local copy that is.
unstableAdvice(string subject, string kind, string copy) -> string {
    return "{subject} is {kind}, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('{copy}') and check the local.";
}

// unstableAdvice for a value an operator changes, whose fix writes the result back.
unstableWriteAdvice(string subject, string copy, string place) -> string {
    return "{subject} is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('{copy}'), check the local, and "
        + "write the result back to '{place}'.";
}

// A mutable field and an array element are never stable places, so a check on either narrows
// nothing and a write through either refines nothing. Each refusal that would otherwise suggest
// the check names the step at fault and the local copy instead, wherever it fires: passing the
// value on, reading a member, indexing, slicing, calling a function value, arithmetic, a compound
// assignment and '++'. In a chain it is the outermost unstable step, and the copy spells it in
// full. A member only a subclass has gets the type test's version, and a member no subclass has gets none.
test "a mutable field or an array element keeps no narrowing" {
    let analysis = try analyzeBody("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "    protected Meter? next = null;\n"
        + "    protected const Meter? fixed;\n"
        + "    protected int[]? slots = null;\n"
        + "    protected ((int) -> int)? handler = null;\n"
        + "    protected Shape shape = new Circle();\n"
        + "\n"
        + "    protected constructor(this.fixed = null);\n"
        + "\n"
        + "    protected read() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Meter \{\n"
        + "    return new Meter();\n"
        + "\}\n"
        + "passed(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "written(Meter m) -> int \{\n"
        + "    m.level = 4;\n"
        + "    return m.level;\n"
        + "\}\n"
        + "memberRead(Meter m) -> int \{\n"
        + "    if (m.next != null) \{\n"
        + "        return m.next.read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "indexed(Meter m) -> int \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "sliced(Meter m) -> long \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots.slice(0, 1).length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "called(Meter m) -> int \{\n"
        + "    if (m.handler != null) \{\n"
        + "        return m.handler(1);\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "fixedThenMutable(Meter m) -> int \{\n"
        + "    if (m.fixed != null && m.fixed.level != null) \{\n"
        + "        return m.fixed.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "unspellable() -> int \{\n"
        + "    if (make().level != null) \{\n"
        + "        return make().level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "element(int?[] cells) -> int \{\n"
        + "    if (cells[0] != null) \{\n"
        + "        return cells[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementWrite(int?[] cells) -> int \{\n"
        + "    cells[0] = 4;\n"
        + "    return cells[0];\n"
        + "\}\n"
        + "elementUnspellable(int?[] cells, int i) -> int \{\n"
        + "    if (cells[i + 1] != null) \{\n"
        + "        return cells[i + 1];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementMember(Meter?[] meters) -> int \{\n"
        + "    if (meters[0] != null) \{\n"
        + "        return meters[0].read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "tested(Meter m) -> int \{\n"
        + "    if (m.shape is Circle) \{\n"
        + "        return m.shape.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "misspelled(Meter m) -> int \{\n"
        + "    return m.shape.radiuss;\n"
        + "\}\n"
        + "added(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level + 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "addedInPlace(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "stepped(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level++;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Meter();\n"
        + "    addedInPlace(m);\n"
        + "    stepped(m);\n"
        + "    int?[] cells = new int?[2];\n"
        + "    Meter?[] meters = new Meter?[1];\n"
        + "    return passed(m) + written(m) + memberRead(m) + indexed(m) + (sliced(m) as int)\n"
        + "        + called(m) + fixedThenMutable(m) + unspellable() + element(cells)\n"
        + "        + elementWrite(cells) + elementUnspellable(cells, 0) + elementMember(meters)\n"
        + "        + tested(m) + misspelled(m) + added(m);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string returned = "returns 'int', but this value has type 'int?'. The value may be null here. ";
    string ofLevel = unstableAdvice("'m.level'", "a field", "let level = m.level;");
    string ofCell = unstableAdvice("'cells[0]'", "an array element", "let value = cells[0];");
    string ofSlots = unstableAdvice("'m.slots'", "a field", "let slots = m.slots;");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Function 'passed' {returned}" + ofLevel);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Function 'written' {returned}" + ofLevel);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Cannot read a member of 'Meter?' because it may be null here. "
        + unstableAdvice("'m.next'", "a field", "let next = m.next;"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Cannot index 'int[]?' because it may be null here. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot call 'slice' on 'int[]?' because it may be null here. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'handler' has type '((int) -> int)?', which may be null here. "
        + unstableAdvice("'m.handler'", "a field", "let handler = m.handler;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Function 'fixedThenMutable' {returned}"
        + unstableAdvice("'m.fixed.level'", "a field", "let level = m.fixed.level;"));
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "Function 'unspellable' {returned}"
        + unstableAdvice("'make().level'", "a field", "let level = make().level;"));
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "Function 'element' {returned}" + ofCell);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "Function 'elementWrite' {returned}" + ofCell);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "Function 'elementUnspellable' {returned}"
        + unstableAdvice("'cells[i + 1]'", "an array element", "let value = cells[i + 1];"));
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "Cannot read a member of 'Meter?' because it may be null here. "
        + unstableAdvice("'meters[0]'", "an array element", "let value = meters[0];"));
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "Type 'Shape' has no field or method named 'radius'. 'm.shape' is a field, so it can change at "
        + "any time. A later read of it can be another type even after a type test. Copy it into a local "
        + "first ('let shape = m.shape;') and test the local.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "Type 'Shape' has no field or method named 'radiuss'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'+' needs numbers on both sides, but 'm.level' has type 'int?'. " + ofLevel);
    string writtenBack = unstableWriteAdvice("'m.level'", "let level = m.level;", "m.level");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, but 'm.level' has type 'int?'. " + writtenBack);
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "'++' works only on numbers, and 'm.level' has type 'int?'. " + writtenBack);
    try testing.assertEqual(reported.length, 17L);
}

// Every operator that refuses an optional operand gives the same guidance when the operand is a
// checked mutable field: a comparison, a shift, a bitwise operator, string concatenation on
// either side, a prefix operator and '&&'. A compound form writes the result back. A field read
// from a call's result is written back through a local that stores the result.
test "an operator refused on a checked mutable field names the field and the local copy" {
    let analysis = try analyzeBody("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "    protected string? label = \"a\";\n"
        + "    protected bool? flag = true;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected all() \{\n"
        + "        if (this.count != null && this.label != null && this.flag != null) \{\n"
        + "            bool compared = this.count <= 3;\n"
        + "            this.count <<= 1;\n"
        + "            int shifted = 1 << this.count;\n"
        + "            this.count &= 1;\n"
        + "            this.label += \"x\";\n"
        + "            string joined = \"x\" + this.label;\n"
        + "            int negated = -this.count;\n"
        + "            bool inverted = !this.flag;\n"
        + "            int flipped = ~this.count;\n"
        + "            bool both = this.flag && true;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Tally \{\n"
        + "    return new Tally();\n"
        + "\}\n"
        + "temporary() \{\n"
        + "    make().count++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    new Tally().all();\n"
        + "    temporary();\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofCount = unstableAdvice("'this.count'", "a field", "let count = this.count;");
    string ofFlag = unstableAdvice("'this.flag'", "a field", "let flag = this.flag;");
    string backToCount = unstableWriteAdvice("'this.count'", "let count = this.count;", "this.count");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'<=' compares numbers, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'<<=' shifts an integer, but 'this.count' has type 'int?'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'<<' needs an integer shift distance, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'&=' needs integers on both sides, but 'this.count' has type 'int?'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'+=' joins a string only when neither side can be null, but 'this.label' has type 'string?'. "
        + unstableWriteAdvice("'this.label'", "let label = this.label;", "this.label"));
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'+' joins a string only when neither side can be null, but 'this.label' has type 'string?'. "
        + unstableAdvice("'this.label'", "a field", "let label = this.label;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Unary '-' needs a number, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'!' negates a 'bool', but 'this.flag' has type 'bool?'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'&&' needs a 'bool' on both sides, but 'this.flag' has type 'bool?'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'++' works only on numbers, and 'make().count' has type 'int?'. "
        + "'make().count' is a field, so it can change at any time. A later read of it can be null "
        + "even after a null check. Store the result of 'make()' and the field in locals first ('let "
        + "makeResult = make(); let count = makeResult.count;'), check 'count', and write the result "
        + "back to 'makeResult.count'.");
    try testing.assertEqual(reported.length, 11L);
}

// No callee can write a 'const' field, so a call drops nothing a stable place proved: not through
// 'this' as the receiver, not through a chain as the receiver, and not through the root passed as
// an argument or to a constructor.
test "a call drops nothing a stable place proved" {
    let analysis = try analyzeBody("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null);\n"
        + "\n"
        + "    protected touch() \{\n"
        + "    \}\n"
        + "\n"
        + "    protected limitAfterCall() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            this.touch();\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Wrapper \{\n"
        + "    protected constructor(Gauge gauge) \{\n"
        + "    \}\n"
        + "\}\n"
        + "touched(Gauge gauge) \{ \}\n"
        + "afterCalls(Gauge gauge) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        gauge.inner.touch();\n"
        + "        touched(gauge);\n"
        + "        let wrapper = new Wrapper(gauge);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\"));\n"
        + "    return (gauge.limitAfterCall() + afterCalls(gauge)) as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "unsound reads stay rejected under narrowing" {
    let analysis = try analyzeBody("class Door \{ protected int code; protected "
        + "constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "maybeInt() -> int? \{ return 3; \}\n"
        + "leaky(Door? d) -> int \{\n"
        + "    if (d == null) \{ \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "widened() -> int \{\n"
        + "    int? n = 5;\n"
        + "    n = maybeInt();\n"
        + "    return n;\n"
        + "\}\n"
        + "presence(int y) -> int \{\n"
        + "    return y ?? 3;\n"
        + "\}\n"
        + "missingNullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return leaky(null) + widened() + presence(1)\n"
        + "        + missingNullArm(null);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'Door?' because it may be null here. Check 'd' for null first "
        + "('if (d != null)').");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Function 'widened' returns 'int', but this value has type 'int?'. The value may be null here. "
        + "Check 'n' for null first ('if (n != null)').");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'y' has type 'int', which can never be null, so the fallback after '??' is never used. Remove "
        + "'?? 3', or give 'y' a nullable type such as 'int?'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'c' can be null, and no arm of this switch matches null. Add a 'null ->' arm or a 'default' arm.");
    try testing.assertEqual(reported.length, 4L);
}

// The advice a null-use refusal gives for a checked 'weak' field 'target' read from 'owner'.
weakAdvice(string owner) -> string {
    return "'{owner}.target' is a 'weak' field, so it can become null at any time. A later read "
        + "of it can be null even after a null check. Copy it into a local first ('let target = "
        + "{owner}.target;') and check the local.";
}

test "weak fields never narrow, but weak checks and the strong-local copy stay legal" {
    let analysis = try analyzeBody("class Node \{ protected int size; protected "
        + "constructor(this.size = 0); \}\n"
        + "class Holder \{ protected weak Node? target; protected constructor(); \}\n"
        + "watch(Holder h) -> int \{\n"
        + "    if (h.target == null) \{ return 0; \}\n"
        + "    bool alive = h.target != null;\n"
        + "    let target = h.target;\n"
        + "    if (target != null && alive) \{ return target.size; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return watch(new Holder()); \}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "uses of a checked weak field are rejected with the weak explanation" {
    let analysis = try analyzeBody("class Node \{ protected int size; protected constructor(this.size = 0); "
        + "protected report() -> int \{ return this.size; \} \}\n"
        + "class Holder \{ protected weak Node? target; protected constructor(); \}\n"
        + "class Chain \{ protected const Holder? holder; protected constructor(this.holder = null); \}\n"
        + "consume(Node node) \{ \}\n"
        + "readAfterCheck(Holder h) -> int \{\n"
        + "    if (h.target != null) \{ return h.target.size; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "callAfterCheck(Holder k) -> int \{\n"
        + "    if (k.target != null) \{ return k.target.report(); \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "interpolateAfterCheck(Holder h) -> string \{\n"
        + "    if (h.target != null) \{ return \"\{h.target\}\"; \}\n"
        + "    return \"gone\";\n"
        + "\}\n"
        + "passAfterCheck(Holder h) \{\n"
        + "    if (h.target != null) \{ consume(h.target); \}\n"
        + "\}\n"
        + "throughLongerPath(Chain c) -> int \{\n"
        + "    if (c.holder != null && c.holder.target != null) \{\n"
        + "        return c.holder.target.size;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    passAfterCheck(new Holder());\n"
        + "    int total = readAfterCheck(new Holder()) + callAfterCheck(new Holder())\n"
        + "        + throughLongerPath(new Chain());\n"
        + "    if (interpolateAfterCheck(new Holder()) == \"gone\") \{ return total; \}\n"
        + "    return total + 1;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string memberRead = "Cannot read a member of 'Node?' because it may be null here. ";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", memberRead + weakAdvice("h"));
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", memberRead + weakAdvice("k"));
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Argument 1 of 'consume' has type 'Node?', but parameter 'node' has type 'Node'. The value may be "
        + "null here. " + weakAdvice("h"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", memberRead + weakAdvice("c.holder"));
    try testing.assertEqual(reported.length, 4L);
}

typeLevelField(string name, Type type) -> Field {
    return new Field(name, type, Visibility.Public, false, true, false, true, true,
        source.makeSpan(0, 0), type);
}

test "a type-level root compares by field identity and clears only its own paths" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let label = typeLevelField("label", optionalInt);
    let other = typeLevelField("label", optionalInt);
    let local = binding("label", optionalInt);

    try testing.assertTrue(narrow.typeLevelPath(label) == narrow.typeLevelPath(label),
        "two reads of one field should be one path");
    try testing.assertTrue(narrow.typeLevelPath(label).hash() == narrow.typeLevelPath(label).hash(),
        "equal type-level paths should hash equally");
    try testing.assertTrue(narrow.typeLevelPath(label) != narrow.typeLevelPath(other),
        "two fields of one name should be two paths");
    try testing.assertTrue(narrow.typeLevelPath(label) != narrow.bindingPath(local),
        "a field root should differ from a binding of the same name");

    let name = narrow.fieldSegment("name");
    try testing.assertTrue(narrow.typeLevelPath(label).extended(name)
        == narrow.typeLevelPath(label).extended(narrow.fieldSegment("name")),
        "an extended path should compare by its segments");
    try testing.assertTrue(narrow.typeLevelPath(label).extended(name) != narrow.typeLevelPath(label),
        "an extended path should differ from its root");

    let state = new NarrowingState();
    state.narrow(narrow.typeLevelPath(label).extended(name), intType);
    state.narrow(narrow.typeLevelPath(other).extended(name), intType);
    state.clearPrefixedBy(narrow.typeLevelPath(other));
    state.clearForRoot(local);
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == intType,
        "clearing another field or a binding should keep this field's path");
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(other).extended(name)) == null,
        "clearing a field should drop the paths it prefixes");
}

test "a lazy const read through its type narrows like a local" {
    let analysis = try analyzeBody("class Holder \{ protected const string? name; "
        + "protected constructor(this.name = null); \}\n"
        + "class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius; protected constructor(this.radius = 0); \}\n"
        + "class Box<T> \{ protected lazy const string? tag = pick(); protected constructor(); \}\n"
        + "class Settings \{\n"
        + "    protected lazy const string? label = pick();\n"
        + "    protected lazy const Holder holder = new Holder(\"holder\");\n"
        + "    protected lazy const Holder? maybeHolder = new Holder(\"maybe\");\n"
        + "    protected lazy const Shape shape = new Circle(3);\n"
        + "\}\n"
        + "pick() -> string? \{ return \"label\"; \}\n"
        + "checked() -> long \{\n"
        + "    if (Settings.label != null) \{ return Settings.label.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "guarded() -> long \{\n"
        + "    if (Settings.label == null) \{ return 0; \}\n"
        + "    return Settings.label.length;\n"
        + "\}\n"
        + "looped() -> long \{\n"
        + "    long total = 0;\n"
        + "    while (Settings.label != null && total < 10) \{ total = total + Settings.label.length; \}\n"
        + "    return total;\n"
        + "\}\n"
        + "shortCircuits() -> bool \{\n"
        + "    bool both = Settings.label != null && Settings.label.length > 0;\n"
        + "    return both || Settings.label == null || Settings.label.length > 0;\n"
        + "\}\n"
        + "negated() -> long \{\n"
        + "    if (!(Settings.label == null)) \{ return (Settings.label).length; \}\n"
        + "    return Settings.label != null ? Settings.label.length : 0;\n"
        + "\}\n"
        + "tested() -> int \{\n"
        + "    if (Settings.shape is Circle) \{ return Settings.shape.radius; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "chained() -> long \{\n"
        + "    if (Settings.holder.name != null) \{ return Settings.holder.name.length; \}\n"
        + "    if (Settings.maybeHolder != null && Settings.maybeHolder.name != null) \{\n"
        + "        return Settings.maybeHolder.name.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "insideLambda() -> long \{\n"
        + "    () -> long measure = () -> \{\n"
        + "        if (Settings.label != null) \{ return Settings.label.length; \}\n"
        + "        return 0;\n"
        + "    \};\n"
        + "    return measure();\n"
        + "\}\n"
        + "shared() -> long \{\n"
        + "    if (Box<int>.tag != null) \{ return Box<string>.tag.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    long total = checked() + guarded() + looped() + negated() + tested() + chained()\n"
        + "        + insideLambda() + shared();\n"
        + "    if (shortCircuits()) \{ return total as int; \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a lazy const narrowing stays outside a lambda, and a mutable field under one never narrows" {
    let analysis = try analyzeBody("class Tally \{ protected int? count; protected string? note; "
        + "protected constructor(this.count = null, this.note = null); \}\n"
        + "class Settings \{\n"
        + "    protected lazy const string? label = pick();\n"
        + "    protected lazy const Tally tally = new Tally(1, \"a\");\n"
        + "\}\n"
        + "pick() -> string? \{ return \"label\"; \}\n"
        + "unchecked() -> long \{\n"
        + "    return Settings.label.length;\n"
        + "\}\n"
        + "outsideLambda() -> long \{\n"
        + "    if (Settings.label != null) \{\n"
        + "        () -> long measure = () -> Settings.label.length;\n"
        + "        return measure();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "mutableField() -> long \{\n"
        + "    if (Settings.tally.note != null) \{ return Settings.tally.note.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "compound() \{\n"
        + "    if (Settings.tally.count != null) \{ Settings.tally.count += 1; \}\n"
        + "\}\n"
        + "refusedWrite() -> long \{\n"
        + "    if (Settings.label != null) \{\n"
        + "        Settings.label = null;\n"
        + "        return Settings.label.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    compound();\n"
        + "    return (unchecked() + outsideLambda() + mutableField() + refusedWrite()) as int;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Check 'Settings.label' for "
        + "null first ('if (Settings.label != null)').");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Supply a fallback for "
        + "'Settings.label' with '??'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. 'Settings.tally.note' is a field, "
        + "so it can change at any time. A later read of it can be null even after a null check. Copy it "
        + "into a local first ('let note = Settings.tally.note;') and check the local.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, but 'Settings.tally.count' has type 'int?'. "
        + "'Settings.tally.count' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let count = "
        + "Settings.tally.count;'), check the local, and write the result back to 'Settings.tally.count'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot assign to 'Settings.label': a lazy const keeps the value its initializer gives "
        + "it. Change the initializer, or use an instance field.");
    try testing.assertEqual(reported.length, 5L);
}

test "a static or lazy field without 'const' never narrows" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Counters \{\n"
        + "    protected static int? counter;\n"
        + "    protected lazy string? loose = pick();\n"
        + "\}\n"
        + "pick() -> string? \{ return \"loose\"; \}\n"
        + "counted() -> int \{\n"
        + "    if (Counters.counter != null) \{ return Counters.counter + 1; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "measured() -> long \{\n"
        + "    if (Counters.loose != null) \{ return Counters.loose.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return counted() + measured() as int; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout, Stage.Bodies]);
    let declared = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(declared, 0, "/proj/src/main.ens",
        "A 'static' field must also be 'const'. Write 'static const int? counter = ...', or make "
        + "'counter' an instance field.");
    try sema_support.assertDiagnostic(declared, 1, "/proj/src/main.ens",
        "Static const 'counter' needs its value on the declaration, because nothing else ever "
        + "assigns it. Write 'static const int? counter = ...'.");
    try sema_support.assertDiagnostic(declared, 2, "/proj/src/main.ens",
        "Static const 'counter' has type 'int?', but a static const can only have a number type, "
        + "'char', 'bool' or 'string'. Make 'counter' a 'lazy const', or give it one of those "
        + "types.");
    try sema_support.assertDiagnostic(declared, 3, "/proj/src/main.ens",
        "A 'lazy' field must also be 'const'; its value is built once on the first read and never "
        + "changes. Write 'lazy const string? loose = ...', or make 'loose' an instance field.");
    try testing.assertEqual(declared.length, 4L);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'+' needs numbers on both sides, but 'Counters.counter' has type 'int?'. Supply a fallback for "
        + "'Counters.counter' with '??'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Supply a fallback for "
        + "'Counters.loose' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

test "a type-level path and a binding path never prefix each other" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let label = typeLevelField("label", optionalInt);
    let local = binding("label", optionalInt);
    let name = narrow.fieldSegment("name");
    let state = new NarrowingState();

    state.narrow(narrow.typeLevelPath(label).extended(name), intType);
    state.narrow(narrow.bindingPath(local).extended(name), intType);
    state.clearPrefixedBy(narrow.bindingPath(local));
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == intType,
        "a write to a binding should keep a type-level path under a field of the same name");
    try testing.assertTrue(state.provenType(narrow.bindingPath(local).extended(name)) == null,
        "a write to a binding should drop the paths it prefixes");

    state.narrow(narrow.bindingPath(local).extended(name), intType);
    state.clearPrefixedBy(narrow.typeLevelPath(label));
    try testing.assertTrue(state.provenType(narrow.bindingPath(local).extended(name)) == intType,
        "clearing a type-level path should keep a binding path of the same name");
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == null,
        "clearing a type-level path should drop the paths it prefixes");
}

// A copy of a mutable field whose 'const' field is the value names that value, for a member read
// after a null check and for a type test.
test "a copy of a field before a 'const' field names the value it checks or tests" {
    let analysis = try analyzeBody("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Inner \{\n"
        + "    protected const Circle? circle = null;\n"
        + "    protected const Shape shape = new Circle();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Inner inner = new Inner();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "read(Holder h) -> int \{\n"
        + "    if (h.inner.circle != null) \{\n"
        + "        return h.inner.circle.radius;\n"
        + "    \}\n"
        + "    if (h.inner.shape is Circle) \{\n"
        + "        return h.inner.shape.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot read a member of 'Circle?' because it "
        + "may be null here. 'h.inner' is a field, so it can change at any time. A later read of "
        + "'h.inner.circle' can be null even after a null check. Copy it into a local first ('let inner = "
        + "h.inner;') and check 'inner.circle' for null.");
    try sema_support.assertDiagnostic(reported, 1, file, "Type 'Shape' has no field or method named "
        + "'radius'. 'h.inner' is a field, so it can change at any time. A later read of 'h.inner.shape' "
        + "can be another type even after a type test. Copy it into a local first ('let inner = h.inner;') "
        + "and test 'inner.shape'.");
    try testing.assertEqual(reported.length, 2L);
}

// A store, an argument, a return, a member read, an index, a call through a function value and a
// loop name the value they refuse, and a use that takes one '?' of several checks only the rest.
test "a value that may be null gets the fix for the place it is read from, in every refusal of one" {
    let analysis = try analyzeBody("class Tally \{\n"
        + "    int? count = 1;\n"
        + "\n"
        + "    constructor();\n"
        + "\n"
        + "    read() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "takes(int value) \{\n"
        + "\}\n"
        + "\n"
        + "pick() -> int? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "\n"
        + "returned(int? x) -> int \{\n"
        + "    return x;\n"
        + "\}\n"
        + "\n"
        + "uses(int? x, int?? xx, int[]??? deep, Tally? mt, int[]? xs, ((int) -> int)? f,\n"
        + "        Shape?? ss, int k) \{\n"
        + "    int first = x;\n"
        + "    int second = xx;\n"
        + "    takes(x);\n"
        + "    int third = pick();\n"
        + "    int fourth = mt?.count;\n"
        + "    string text = x.toString();\n"
        + "    int called = f(k);\n"
        + "    int element = xs[k];\n"
        + "    int? safe = deep?[0];\n"
        + "    () -> int later = () -> x;\n"
        + "    bool tested = ss is Circle;\n"
        + "    string hole = \"\{xx\}\";\n"
        + "    for (int item in xs) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "class Circle extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Function 'returned' returns 'int', but this "
        + "value has type 'int?'. The value may be null here. Check 'x' for null first ('if (x != null)').");
    try sema_support.assertDiagnostic(reported, 1, file, "Variable 'first' has type 'int', but its value "
        + "has type 'int?'. The value may be null here. Check 'x' for null first ('if (x != null)').");
    try sema_support.assertDiagnostic(reported, 2, file, "Variable 'second' has type 'int', but its value "
        + "has type 'int??'. The value may be null here. Check 'xx' for null twice, once for each '?' ('if "
        + "(xx != null) \{ if (xx != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 3, file, "Argument 1 of 'takes' has type 'int?', but "
        + "parameter 'value' has type 'int'. The value may be null here. Check 'x' for null first ('if (x "
        + "!= null)').");
    try sema_support.assertDiagnostic(reported, 4, file, "Variable 'third' has type 'int', but its value "
        + "has type 'int?'. The value may be null here. Each call to 'pick' returns its own result. A "
        + "later call can return null even after a null check on an earlier one. Store the result in a "
        + "local first ('let pickResult = pick();') and check the local.");
    try sema_support.assertDiagnostic(reported, 5, file, "Variable 'fourth' has type 'int', but its value "
        + "has type 'int?'. The value may be null here. 'mt?.count' is null whenever 'mt' is null. Supply "
        + "a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Cannot read a member of 'int?' because it may be "
        + "null here. Check 'x' for null first ('if (x != null)').");
    try sema_support.assertDiagnostic(reported, 7, file, "'f' has type '((int) -> int)?', which may be "
        + "null here. Check 'f' for null first ('if (f != null)').");
    try sema_support.assertDiagnostic(reported, 8, file, "Cannot index 'int[]?' because it may be null "
        + "here. Check 'xs' for null first ('if (xs != null)').");
    try sema_support.assertDiagnostic(reported, 9, file, "'?[' checks for one level of null, but the value "
        + "on its left has type 'int[]???', which can be null at more than one level. Check 'deep' for "
        + "null twice ('if (deep != null) \{ if (deep != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 10, file, "This lambda must return 'int', but its body has "
        + "type 'int?'. The value may be null here. Supply a fallback for 'x' with '??'.");
    try sema_support.assertDiagnostic(reported, 11, file, "Cannot use 'is' on a value of type 'Shape??', "
        + "because 'is' checks for only one level of null. Check 'ss' for null first ('if (ss != null)').");
    try sema_support.assertDiagnostic(reported, 12, file, "Cannot interpolate a value of type 'int??', "
        + "because it may be null at more than one level. Check 'xx' for null first ('if (xx != null)').");
    try sema_support.assertDiagnostic(reported, 13, file, "'for (... in ...)' cannot iterate 'int[]?' "
        + "because it may be null here. Check 'xs' for null first ('if (xs != null)').");
    try testing.assertEqual(reported.length, 14L);
}

// A '?:' or switch value that may be null gets the fix its nullable branch gets alone, with the
// fallback as the other choice. A fallback names the value it goes on.
test "a join value that may be null gets the fix for the branch it is read from" {
    let analysis = try analyzeBody("class Inner \{\n"
        + "    int f = 0;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "class Holder \{\n"
        + "    int? count = 0;\n"
        + "    Inner?? twice = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "takes(int value) \{\n"
        + "\}\n"
        + "\n"
        + "forms(Holder h, int k, bool flag, int? n, int[] xs) \{\n"
        + "    int r = switch (k) \{\n"
        + "        0 -> h.count,\n"
        + "        default -> 1,\n"
        + "    \};\n"
        + "    int r2 = flag ? h.count : 1;\n"
        + "    takes(flag ? h.count : 1);\n"
        + "    int r4 = flag ? n : 1;\n"
        + "    int r5 = switch (k) \{\n"
        + "        0 -> n,\n"
        + "        default -> 1,\n"
        + "    \};\n"
        + "    for (int i = 0; i < 3; i += h.twice?.f ?? 0) \{\n"
        + "    \}\n"
        + "    string text = xs.toString(1);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Variable 'r' has type 'int', but its value has "
        + "type 'int?'. The value may be null here. 'h.count' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "h.count;') and check the local, or supply a fallback for 'h.count' with '??'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Variable 'r2' has type 'int', but its value has "
        + "type 'int?'. The value may be null here. 'h.count' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "h.count;') and check the local, or supply a fallback for 'h.count' with '??'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Argument 1 of 'takes' has type 'int?', but "
        + "parameter 'value' has type 'int'. The value may be null here. 'h.count' is a field, so it can "
        + "change at any time. A later read of it can be null even after a null check. Copy it into a "
        + "local first ('let count = h.count;') and check the local, or supply a fallback for 'h.count' "
        + "with '??'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Variable 'r4' has type 'int', but its value has "
        + "type 'int?'. The value may be null here. Check 'n' for null first ('if (n != null)'), or supply "
        + "a fallback for 'n' with '??'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Variable 'r5' has type 'int', but its value has "
        + "type 'int?'. The value may be null here. Check 'n' for null first ('if (n != null)'), or supply "
        + "a fallback for 'n' with '??'.");
    try sema_support.assertDiagnostic(reported, 5, file, "'?.' checks for one level of null, but the value "
        + "on its left has type 'Inner??', which can be null at more than one level. Supply a fallback for "
        + "'h.twice' with '??'.");
    try sema_support.assertDiagnostic(reported, 6, file, "'toString' takes no arguments, but this call "
        + "passes one. Remove the extra argument.");
    try testing.assertEqual(reported.length, 7L);
}
