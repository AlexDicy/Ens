// Struct conformance, the refused side: a requirement left unprovided or provided at the wrong
// shape, an 'override' marker missing or answering nothing, a name that is not an interface, and
// the interface-typed slot a conformance never buys.
import @std.testing;
import ProgramAnalysis from pipeline;
import model.types;
import sema_support;
import FakeFileLoader from sema_support;

analyzeAll(string text) -> ProgramAnalysis {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    return sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
}

// The declarations every test here shares: one plain interface, one extending it, and a class.
contract() -> string {
    return "public interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "public interface Loud extends Speaker \{\n"
        + "    volume() -> int;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public constructor();\n"
        + "\}\n";
}

test "a missing requirement is reported at the struct that implements it" {
    let analysis = analyzeAll(contract()
        + "public struct Quiet implements Speaker \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Struct 'Quiet' implements 'Speaker' but does not provide 'speak() -> string'. Declare "
            + "the method here, or stop implementing 'Speaker'.");
}

test "an inherited requirement names the interface that declares it" {
    let analysis = analyzeAll(contract()
        + "public struct Shout implements Loud \{\n"
        + "    int level;\n"
        + "\n"
        + "    public override volume() -> int \{\n"
        + "        return this.level;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Struct 'Shout' implements 'Loud' but does not provide 'speak() -> string', required by "
            + "'Speaker', which 'Loud' extends.");
}

test "a requirement provided at the wrong return type is reported" {
    let analysis = analyzeAll(contract()
        + "public struct Counting implements Loud \{\n"
        + "    int level;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"hey\";\n"
        + "    \}\n"
        + "\n"
        + "    public override volume() -> string \{\n"
        + "        return \"loud\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Method 'volume' of struct 'Counting' does not match 'volume() -> int' declared in "
            + "interface 'Loud'.");
}

test "a requirement answered without 'override' asks for the marker" {
    let analysis = analyzeAll(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Method 'speak' of struct 'Note' implements a method declared in interface 'Speaker'; "
            + "mark it 'override'.");
}

test "'override' answering nothing names the conformances that were searched" {
    let analysis = analyzeAll(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\n"
        + "    override doubled() -> int \{\n"
        + "        return this.id * 2;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Plain \{\n"
        + "    int id;\n"
        + "\n"
        + "    override doubled() -> int \{\n"
        + "        return this.id * 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertMentions(found,
        "Method 'doubled' of 'Note' is marked 'override' but no interface that 'Note' "
            + "implements declares 'doubled', and a struct inherits nothing; only 'toString', "
            + "'hash', and 'equals' replace a built-in behavior of a struct. Remove 'override'.");
    try sema_support.assertMentions(found,
        "Method 'doubled' of 'Plain' is marked 'override' but structs do not inherit, so there "
            + "is nothing to override; only 'toString', 'hash', and 'equals' replace a built-in "
            + "behavior of a struct. Remove 'override'.");
}

test "a member answering a requirement must reach as far as the struct" {
    let analysis = analyzeAll(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Method 'speak' of struct 'Note' is private, but it provides 'speak() -> string' "
            + "required by 'Speaker', and a generic body reaching 'Note' through 'Speaker' "
            + "calls it, so it must reach as far as 'Note' itself. Mark it 'public'.");
}

test "a struct's 'implements' clause takes interfaces only" {
    let analysis = analyzeAll(contract()
        + "public struct Held implements Holder \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "'Holder' is a class, not an interface, and a struct never extends one. Name an "
            + "interface here, or hold a 'Holder' in a field of 'Held'.");
}

test "a conditional member cannot satisfy a requirement" {
    let analysis = analyzeAll(contract()
        + "public interface Ordered<T> \{\n"
        + "    order(T other) -> int;\n"
        + "\}\n"
        + "public struct Wrap<T> implements Ordered<Wrap<T>> \{\n"
        + "    T held;\n"
        + "\n"
        + "    public constructor(this.held);\n"
        + "\n"
        + "    public order<T: Ordered<T>>(Wrap<T> other) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Struct 'Wrap' implements 'Ordered<Wrap<T>>' but provides 'order(Wrap<T>) -> int' only "
            + "conditionally; an interface requirement must exist on every instantiation, so a "
            + "conditional member cannot satisfy it. Remove the '<...>' constraint list from "
            + "'order', or stop implementing 'Ordered<Wrap<T>>'.");
}

test "a conformance gives the struct no interface value" {
    let analysis = analyzeAll(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Note note = \{id: 1\};\n"
        + "    Speaker slot = note;\n"
        + "    if (note is Speaker) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertMentions(found,
        "Cannot assign value of type 'Note' to variable of type 'Speaker'. 'Note' does "
            + "implement 'Speaker', but only as a generic bound: a '<T: Speaker>' parameter "
            + "accepts 'Note', while an interface-typed slot needs a value that carries the "
            + "interface, and a struct is never wrapped in one. Write the slot as 'Note', or "
            + "make it a type parameter bounded by 'Speaker'.");
    try sema_support.assertMentions(found,
        "Cannot use 'is' on a value of type 'Note'; only class values can be tested. 'Note' "
            + "does implement 'Speaker', but only as a generic bound: 'is' works over a value "
            + "that carries the interface, and a struct is never wrapped in one.");
}

test "an implementation may not throw what the interface does not allow" {
    let analysis = analyzeAll(
        "public class Trouble extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public interface Quiet \{\n"
        + "    ask() -> int;\n"
        + "\}\n"
        + "public struct Noisy implements Quiet \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override ask() -> int throws \{\n"
        + "        throw new Trouble(\"boom\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    try sema_support.assertMentions(analysis.exceptionDiagnostics(),
        "Method 'ask' of 'Noisy' can throw 'Trouble', which interface 'Quiet' does not allow. "
            + "An implementing method may only throw types the interface method declares.");
}

test "a struct with no 'Iterable' conformance is refused by name" {
    let analysis = analyzeAll(contract()
        + "public struct Silent \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Silent silent = \{id: 1\};\n"
        + "    for (let each in silent) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'Silent' is not iterable: it does not implement 'Iterable' from "
            + "'@std.collections.iterator'. Declare 'implements Iterable<T>' and provide "
            + "'makeIterator() -> Iterator<T>' to use it in a for-in loop.");
}
