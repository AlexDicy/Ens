// Struct conformance, the refused side: a requirement left unprovided or provided at the wrong
// shape, an 'override' marker missing or implementing nothing, a name that is not an interface, and
// the interface-typed slot a conformance never buys.
import @std.testing;
import sema_support;
import Stage from sema_support;

// The declarations every test here shares: one plain interface, one extending it, and a class.
contract() -> string {
    return "public interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "public interface Loud extends Speaker \{\n"
        + "    volume() -> int;\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public constructor();\n"
        + "\}\n";
}

test "a missing requirement is reported at the struct that implements it" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Quiet implements Speaker \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Struct 'Quiet' implements 'Speaker' but does not provide 'speak() -> string'. Declare "
            + "the method here, or stop implementing 'Speaker'.");
}

test "an inherited requirement names the interface that declares it" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Shout implements Loud \{\n"
        + "    int level;\n"
        + "\n"
        + "    public override volume() -> int \{\n"
        + "        return this.level;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Struct 'Shout' implements 'Loud' but does not provide 'speak() -> string', required by "
            + "'Speaker', which 'Loud' extends. Declare the method here, or stop implementing 'Loud'.");
}

test "a requirement provided at the wrong return type is reported" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Counting implements Loud \{\n"
        + "    int level;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"hey\";\n"
        + "    \}\n"
        + "\n"
        + "    public override volume() -> string \{\n"
        + "        return \"loud\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'volume' of struct 'Counting' returns 'string', but interface 'Loud' requires "
            + "'int'. Change the return type of 'volume' to 'int'.");
}

test "a requirement implemented without 'override' reports the missing marker" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'speak' of struct 'Note' implements a method declared in interface 'Speaker' but "
            + "is not marked 'override'. Write 'override' before 'speak'.");
}

test "'override' answering nothing names the conformances that were searched" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\n"
        + "    override doubled() -> int \{\n"
        + "        return this.id * 2;\n"
        + "    \}\n"
        + "\n"
        + "    override equals(string other) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Plain \{\n"
        + "    int id;\n"
        + "\n"
        + "    override doubled() -> int \{\n"
        + "        return this.id * 2;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'doubled' of 'Note' is marked 'override' but no interface 'Note' implements "
        + "declares 'doubled', and a struct inherits nothing. Remove 'override'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Method 'equals' of 'Note' is marked 'override' but no interface 'Note' implements "
        + "declares 'equals', and a struct inherits nothing. An 'equals' that does not take exactly "
        + "one 'Note' is an ordinary method, not the struct's equality. Remove 'override'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Method 'doubled' of 'Plain' is marked 'override', and a struct inherits nothing to "
        + "override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a "
        + "struct. Remove 'override'.");
}

test "a member implementing a requirement must reach as far as the struct" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'speak' of struct 'Note' is private, but it provides 'speak() -> string' for "
        + "interface 'Speaker', so it must be usable everywhere 'Note' is. Mark it 'public'.");
}

test "a struct's 'implements' clause takes interfaces only" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Held implements Holder \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'Holder' is a class, not an interface, and a struct never extends a class. Name an "
        + "interface here, or give 'Held' a field of type 'Holder'.");
}

test "a conditional member cannot satisfy a requirement" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public interface Ordered<T> \{\n"
        + "    order(T other) -> int;\n"
        + "\}\n"
        + "public struct Wrap<T> implements Ordered<Wrap<T>> \{\n"
        + "    T held;\n"
        + "\n"
        + "    public constructor(this.held);\n"
        + "\n"
        + "    public order<T: Ordered<T>>(Wrap<T> other) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Struct 'Wrap' provides 'order(Wrap<T>) -> int' only for some type arguments, but "
        + "'Ordered<Wrap<T>>' needs it for every type argument. Remove the '<...>' list from "
        + "'order', or stop implementing 'Ordered<Wrap<T>>'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Method 'order' of struct 'Wrap' implements a method declared in interface "
        + "'Ordered<Wrap<T>>' but is not marked 'override'. Write 'override' before 'order'.");
}

test "a conformance gives the struct no interface value" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Note implements Speaker \{\n"
        + "    public int id;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Note note = \{id: 1\};\n"
        + "    Speaker slot = note;\n"
        + "    Speaker? absent = null;\n"
        + "    let fallback = absent ?? note;\n"
        + "    Note[] notes = [note];\n"
        + "    for (Speaker each in notes) \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "    if (note is Speaker) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Variable 'slot' has type 'Speaker', but its value has type 'Note'. 'Note' implements 'Speaker', "
        + "but a struct can only be passed where a type parameter such as '<T: Speaker>' is declared. A "
        + "value of type 'Speaker' must be an object of a class, and a struct value is not one. Declare "
        + "the type as 'Note', or declare '<T: Speaker>' and use 'T'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The fallback after '??' has type 'Note', but it replaces 'absent' when 'absent' is null, so it "
        + "must have type 'Speaker'. 'Note' implements 'Speaker', but a struct can only be passed where a "
        + "type parameter such as '<T: Speaker>' is declared. A value of type 'Speaker' must be an object "
        + "of a class, and a struct value is not one. Declare the type as 'Note', or declare '<T: "
        + "Speaker>' and use 'T'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Loop variable 'each' has type 'Speaker', but this loop gives it 'Note' values. 'Note' implements "
        + "'Speaker', but a struct can only be passed where a type parameter such as '<T: Speaker>' is "
        + "declared. A value of type 'Speaker' must be an object of a class, and a struct value is not "
        + "one. Declare the type as 'Note', or declare '<T: Speaker>' and use 'T'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Cannot use 'is' on a value of type 'Note', because only a class value can be tested with "
        + "'is'. 'Note' implements 'Speaker', but a struct value is never a class instance. Remove "
        + "the test, because every 'Note' implements 'Speaker'.");
    try testing.assertEqual(found.length, 4L);
}

test "an implementation may not throw what the interface does not allow" {
    let analysis = sema_support.analyzeProgram(
        "public class Trouble extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public interface Quiet \{\n"
        + "    ask() -> int;\n"
        + "\}\n"
        + "public struct Noisy implements Quiet \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override ask() -> int throws \{\n"
        + "        throw new Trouble(\"boom\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    let found = analysis.exceptionDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'ask' of struct 'Noisy' can throw 'Trouble', which the 'ask' declared by interface "
        + "'Quiet' does not list. An implementing method throws only what the interface lists. "
        + "Remove 'throws' and catch 'Trouble' with a 'catch' clause after the body. Or mark 'ask' "
        + "in 'Quiet' with 'throws Trouble'.");
}

test "a struct with no 'Iterable' conformance is refused by name" {
    let analysis = sema_support.analyzeProgram(contract()
        + "public struct Silent \{\n"
        + "    public int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Silent silent = \{id: 1\};\n"
        + "    for (let each in silent) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "'Silent' cannot be used in 'for (... in ...)', because it does not implement 'Iterable' from "
        + "'@std.collections.iterator'. Declare 'struct Silent implements Iterable<E>' and give it the "
        + "method 'override makeIterator() -> Iterator<E>', where 'E' is the type of its elements.");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

// A call through an interface follows the requirement's marker, so a struct's method matches it
// both ways, while a class implementing the same requirement writes no marker. A method that also
// changes 'this' is reported once, here, since the missing marker is one problem.
test "a struct method matches the 'mutating' marker of the requirement it implements" {
    let analysis = sema_support.analyzeProgram("public interface Bumpable \{\n"
        + "    mutating bump();\n"
        + "\}\n"
        + "public interface Readable \{\n"
        + "    read() -> int;\n"
        + "\}\n"
        + "public struct Loose implements Bumpable \{\n"
        + "    int value;\n"
        + "    public override bump() \{\n"
        + "        this.value += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Eager implements Readable \{\n"
        + "    int value;\n"
        + "    public override mutating read() -> int \{\n"
        + "        return this.value;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Clicker implements Bumpable \{\n"
        + "    public constructor();\n"
        + "    public override bump() \{\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Method 'bump' of struct 'Loose' must be marked 'mutating', because interface 'Bumpable' "
        + "declares it 'mutating'. 'mutating' marks a method that changes the struct it is called on. "
        + "Write 'mutating' before 'bump'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Method 'read' of struct 'Eager' is marked 'mutating', but interface 'Readable' does not "
        + "declare it 'mutating'. Code that calls 'read' through 'Readable' may call it on a value that "
        + "must not change, such as a 'const' local. Remove 'mutating' from 'read', or declare it "
        + "'mutating' in 'Readable'.");
    try testing.assertEqual(found.length, 2L);
}
