        + "of 'read' in 'Base', and write 'throws Boom, NetError' after the signature of this 'read'.");
}

test "a lazy const initializer may not throw and its value never takes an assignment" {
    let analysis = sema_support.analyzeProgram(
        "class Boom extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "risky() -> long throws \{\n"
        + "    throw new Boom(\"no\");\n"
        + "\}\n"
        + "public class Refused \{\n"
        + "    public lazy const long value = risky();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Refused.value = 3;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies, Stage.Exceptions]);
    try sema_support.assertDiagnostic(analysis.exceptionDiagnostics(), 0, "/proj/src/main.ens",
        "The initializer of lazy const 'Refused.value' calls 'risky', which can throw 'Boom'. A "
        + "lazy const is read without 'try', so its initializer must not throw. Move the call into "
        + "a function that catches 'Boom' with a 'catch' clause, and call that function here.");
    try testing.assertEqual(analysis.exceptionDiagnostics().length, 1L);
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot assign to 'Refused.value': a lazy const keeps the value its initializer gives it. "
        + "Change the initializer, or use an instance field.");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

test "a throwing static factory demands 'try' at its call sites" {
    let analysis = sema_support.analyzeProgram(
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Parsed \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static parse(string text) -> Parsed throws \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Failure(\"empty\");\n"
        + "        \}\n"
        + "        return new Parsed();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let parsed = Parsed.parse(\"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    try sema_support.assertDiagnostic(analysis.exceptionDiagnostics(), 0, "/proj/src/main.ens",
        "Call to 'parse' can throw 'Failure'. Prefix it with 'try', and either catch it with a "
        + "'catch' clause or mark this function 'throws'.");
    try testing.assertEqual(analysis.exceptionDiagnostics().length, 1L);
}

test "a lambda body that can throw is refused against a target that lists nothing" {
    try sema_support.assertOnlyProblem("public class Failure extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "mayFail(int value) -> int throws \{\n"
        + "    if (value < 0) \{ throw new Failure(\"negative\"); \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    (int) -> int f = (a) -> try mayFail(a);\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda can throw 'Failure', but the function type it is given to has no 'throws' "
        + "list. Add 'throws Failure' after that function type's return type, as in '((int) -> int "
        + "throws Failure)', or move the throwing code into a named function that catches "
        + "'Failure' with a 'catch' clause.");
}

test "a lambda body is held to the throws list its target declares" {
    try sema_support.assertOnlyProblem("public class Failure extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "public class Other extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "mayFail(int value) -> int throws Failure \{\n"
        + "    if (value < 0) \{ throw new Failure(\"negative\"); \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    ((int) -> int throws Other) f = (a) -> try mayFail(a);\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda can throw 'Failure', which the function type it is given to does not list. "
        + "Add 'Failure' to that function type's 'throws' list, or move the throwing code into a "
        + "named function that catches 'Failure' with a 'catch' clause.");
}

// The 'throws' list a fix adds is written in this file, so a type this file has no name for comes
// with the import that gives it one.
test "a missing throws list is written with the imports it needs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public class Snag extends Error \{\n"
        + "    public constructor() \{\n"
        + "        super(\"snag\");\n"
        + "    \}\n"
        + "\}\n"
        + "public risky() throws Snag \{\n"
        + "    throw new Snag();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import parts;\n"
        + "class Snag \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "careless() \{\n"
        + "    try parts.risky();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'careless' can throw 'Snag' "
        + "(from parts) but is not marked 'throws'. Write 'import Snag as PartsSnag from parts;' and add "
        + "'throws PartsSnag' after the signature, or catch it with a 'catch' clause after the body.");
}

// A 'try' before a call that cannot throw, with one call in its arguments that can, belongs on the
// inner call, so the one refusal moves it there.
test "a try before a call that cannot throw is moved to the call in its argument that can" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "take(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "caller() -> int throws \{\n"
        + "    return try take(query());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Call to 'query' can throw 'DatabaseError', and the 'try' before 'take' does "
        + "not cover it: a call inside an argument needs its own 'try', and 'take' cannot throw. Move the "
        + "'try' to 'query', as in 'take(try query())'.");
}

// Where several calls in the arguments need the 'try', the one refusal writes one before each.
test "a try before a call that cannot throw is moved to each call in its arguments that can" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "pair(int one, int two) -> int \{\n"
        + "    return one + two;\n"
        + "\}\n"
        + "caller() -> int throws \{\n"
        + "    return try pair(query(), query());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "The two calls to 'query' can throw 'DatabaseError', and the 'try' before "
        + "'pair' does not cover them: a call inside an argument needs its own 'try', and 'pair' cannot "
        + "throw. Write a 'try' before each of them, and remove the one before 'pair', as in "
        + "'pair(try query(), try query())'.");
}

// Each callee is named with what its own calls can throw, the one called twice by its count.
test "a try before a call that cannot throw is moved to the calls of each callee in its arguments" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "class Missing extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"missing\");\n"
        + "    \}\n"
        + "\}\n"
        + "get() -> int throws Missing \{\n"
        + "    throw new Missing();\n"
        + "\}\n"
        + "add(int one, int two, int three) -> int \{\n"
        + "    return one + two + three;\n"
        + "\}\n"
        + "caller() -> int throws \{\n"
        + "    return try add(query(), get(), query());\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "The two calls to 'query' can throw 'DatabaseError' and 'get' can throw "
        + "'Missing', and the 'try' before 'add' does not cover them: a call inside an argument "
        + "needs its own 'try', and 'add' cannot throw. Write a 'try' before each of them, and "
        + "remove the one before 'add', as in 'add(try query(), try get(), try query())'.");
}

// A 'try' written before a chain covers each call of the chain, so it is needed when any of them
// can throw, and a call inside an argument still needs its own.
test "a try before a chain of calls covers every call in the chain" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "class Program \{\n"
        + "    constructor();\n"
        + "\n"
        + "    links() -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "settle() -> Program throws \{\n"
        + "    throw new DatabaseError(\"x\");\n"
        + "\}\n"
        + "plain() -> Program \{\n"
        + "    return new Program();\n"
        + "\}\n"
        + "covered() -> bool throws \{\n"
        + "    return try settle().links();\n"
        + "\}\n"
        + "quiet() -> bool \{\n"
        + "    return try plain().links();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "'try' is not needed here: none of the calls it covers can throw. Remove 'try'.");
}

// A program whose constructors call 'super(...)' with a base class 'Named' and two error classes.
baseConstructionPrefix() -> string {
    return "class Refusal extends Error \{\n"
        + "    protected constructor() \{ super(\"refused\"); \}\n"
        + "\}\n"
        + "class Shortage extends Error \{\n"
        + "    protected constructor() \{ super(\"short\"); \}\n"
        + "\}\n"
        + "refuseText() -> string throws Refusal \{\n"
        + "    throw new Refusal();\n"
        + "\}\n"
        + "refuseCount() -> int throws Shortage \{\n"
        + "    throw new Shortage();\n"
        + "\}\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "    protected constructor(this.name);\n"
        + "\}\n";
}

test "a catch clause that finishes a constructor after 'super(...)' threw is refused at each exit" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Recovers extends Named \{\n"
        + "    protected constructor(bool early) \{\n"
        + "        super(try refuseText());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        if (early) \{\n"
        + "            return;\n"
        + "        \}\n"
        + "        print(\"recovered\");\n"
        + "    \}\n"
        + "\}\n");
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "The constructor of 'Recovers' can return an object whose base class 'Named' was never "
        + "constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', and this "
        + "'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' "
        + "and returns a value to pass to 'super(...)', and remove this 'catch' clause. If the "
        + "program cannot continue without that value, end the clause with 'panic(...)'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "This 'return' can end the constructor of 'Recovers' with an object whose base class 'Named' "
        + "was never constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', "
        + "and this 'catch' clause catches it. Move the call into a function that catches 'Refusal' "
        + "and returns a value to pass to 'super(...)', and remove this 'catch' clause. If the "
        + "program cannot continue without that value, replace 'return;' with 'panic(...)'.");
}

test "a 'super(...)' in a constructor's catch clause names the call to move where the clause catches it" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Fallback extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseText());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Later extends Named \{\n"
        + "    protected int count;\n"
        + "    protected constructor() \{\n"
        + "        super(\"named\");\n"
        + "        this.count = try refuseCount();\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        super(\"again\");\n"
        + "        this.count = 0;\n"
        + "    \}\n"
        + "\}\n");
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Move the call to 'refuseText' into a "
        + "function that catches 'Refusal' and returns a value to pass to 'super(...)', and remove "
        + "this 'catch' clause. If the program cannot continue without that value, replace this "
        + "call with 'panic(...)'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'super(...)' cannot be called in a 'catch' clause, because the clause can run after "
        + "the body has already called it. Remove this call.");
}

test "a catch clause finishing a constructor is refused only for what it catches from 'super(...)'" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Box<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "class Middle extends Named \{\n"
        + "    protected constructor(string name) \{ super(name); \}\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected int count;\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseText());\n"
        + "        this.count = try refuseCount();\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        this.count = 0;\n"
        + "    \} catch (Error error) \{\n"
        + "        this.count = -1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Label \{\n"
        + "    protected text() -> string \{\n"
        + "        return \"label\";\n"
        + "    \}\n"
        + "\}\n"
        + "refuseLabel() -> Label throws Refusal \{\n"
        + "    throw new Refusal();\n"
        + "\}\n"
        + "class TextBox extends Box<string> \{\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseLabel().text());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(\"recovered\");\n"
        + "    \}\n"
        + "\}\n");
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "The constructor of 'Leaf' can return an object whose base class 'Middle' was never "
        + "constructed: 'refuseText' can throw 'Refusal' in the arguments of 'super(...)', and this "
        + "'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' "
        + "and returns a value to pass to 'super(...)', and remove this 'catch' clause. If the "
        + "program cannot continue without that value, end the clause with 'panic(...)'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "The constructor of 'TextBox' can return an object whose base class 'Box<string>' was never "
        + "constructed: 'refuseLabel' can throw 'Refusal' in the arguments of 'super(...)', and this "
        + "'catch' clause then reaches its end. Move the call into a function that catches 'Refusal' "
        + "and returns a value to pass to 'super(...)', and remove this 'catch' clause. If the "
        + "program cannot continue without that value, end the clause with 'panic(...)'.");
}

test "a catch clause that runs before the base class exists cannot read a field of it" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Middle extends Named \{\n"
        + "    protected constructor(string name) \{ super(name); \}\n"
        + "\}\n"
        + "class Reads extends Middle \{\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseText());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(this.name);\n"
        + "        panic(\"stop\");\n"
        + "    \}\n"
        + "\}\n");
    try assertOne(analysis, "Field 'name' of base class 'Named' may have no value where this "
        + "'catch' clause reads it. When 'refuseText' throws 'Refusal' in the arguments of "
        + "'super(...)', 'Middle' is not constructed yet. Remove this read, or remove this 'catch' "
        + "clause and move the call to 'refuseText' into a function that catches 'Refusal' and "
        + "returns a value to pass to 'super(...)'.");
}

test "a catch clause reads a field only where the body assigns it before each throw it catches" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Source \{\n"
        + "    protected constructor() \{ \}\n"
        + "    protected use(string text) -> string throws Refusal \{\n"
        + "        return try refuseText();\n"
        + "    \}\n"
        + "\}\n"
        + "makeSource() -> Source throws Refusal \{\n"
        + "    throw new Refusal();\n"
        + "\}\n"
        + "class Chained \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        print(try makeSource().use(this.label = \"assigned\"));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(this.label);\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Thrown \{\n"
        + "    protected string label;\n"
        + "    protected constructor(bool fail) \{\n"
        + "        if (fail) \{\n"
        + "            throw new Shortage();\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        this.label += \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Unfinished \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(\"unfinished\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Selective \{\n"
        + "    protected string label;\n"
        + "    protected int count;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "        this.count = try refuseCount();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        panic(\"a label is required\");\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        print(this.label);\n"
        + "        this.count = 0;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    string left;\n"
        + "    string right;\n"
        + "\}\n"
        + "class Halves \{\n"
        + "    protected Pair pair;\n"
        + "    protected constructor() \{\n"
        + "        this.pair = \{left: try refuseText(), right: \"r\"\};\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        this.pair.left = \"l\";\n"
        + "        this.pair = \{left: \"a\", right: \"b\"\};\n"
        + "    \}\n"
        + "\}\n"
        + "class Paired \{\n"
        + "    protected Pair pair;\n"
        + "    protected constructor(string left) \{\n"
        + "        this.pair = \{left: left, right: \"r\"\};\n"
        + "    \}\n"
        + "\}\n"
        + "class Repaired extends Paired \{\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseText());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        this.pair.left = \"l\";\n"
        + "        panic(\"a pair is required\");\n"
        + "    \}\n"
        + "\}\n");
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 5L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Field 'label' of class 'Chained' may have no value where this 'catch' clause reads it. When "
        + "'makeSource' throws 'Refusal', the body has not assigned 'label' yet. Assign 'label' in the "
        + "clause before this line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Field 'label' of class 'Thrown' may have no value where this 'catch' clause reads it with "
        + "'+='. When the body throws 'Shortage', it has not assigned 'label' yet. Assign 'label' with "
        + "'=' in the clause before this line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "Field 'label' of class 'Unfinished' cannot be null, and it is not assigned on every path "
        + "through this constructor. Assign it on every path, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 3, "/proj/src/main.ens",
        "Field 'pair' of class 'Halves' may have no value where this 'catch' clause sets its field "
        + "'left'. When 'refuseText' throws 'Refusal', the body has not assigned 'pair' yet. Assign the "
        + "whole struct in the clause first, for example 'this.pair = \{...\};'.");
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/src/main.ens",
        "Field 'pair' of base class 'Paired' may have no value where this 'catch' clause sets "
        + "its field 'left'. When 'refuseText' throws 'Refusal' in the arguments of 'super(...)', "
        + "'Paired' is not constructed yet. Remove this write, or remove this 'catch' clause and "
        + "move the call to 'refuseText' into a function that catches 'Refusal' and returns a value "
        + "to pass to 'super(...)'.");
}

test "a use of 'this' in a catch clause is refused where the clause catches a throw before a field" {
    let analysis = try analyzeExceptions(baseConstructionPrefix()
        + "class Rendered \{\n"
        + "    protected string label;\n"
        + "    protected int count;\n"
        + "    protected constructor() \{\n"
        + "        this.count = try refuseCount();\n"
        + "        this.label = \"set\";\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        print(this.render());\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "    protected render() -> string \{\n"
        + "        return this.label;\n"
        + "    \}\n"
        + "\}\n"
        + "class Captured \{\n"
        + "    protected string label;\n"
        + "    protected constructor(bool fail) \{\n"
        + "        if (fail) \{\n"
        + "            throw new Shortage();\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        () -> void later = () -> \{\n"
        + "            print(this.label);\n"
        + "        \};\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Unbuilt extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(try refuseText());\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(this.describe());\n"
        + "        panic(\"a name is required\");\n"
        + "    \}\n"
        + "    protected describe() -> string \{\n"
        + "        return \"unbuilt\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Settled \{\n"
        + "    protected string label;\n"
        + "    protected int count;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "        this.count = try refuseCount();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        panic(\"a label is required\");\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        print(this.render());\n"
        + "        this.count = 0;\n"
        + "    \}\n"
        + "    protected render() -> string \{\n"
        + "        return this.label;\n"
        + "    \}\n"
        + "\}\n"
        + "class Passing \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        handOver(this);\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "handOver(Passing passing) \{\n"
        + "\}\n"
        + "class Stored \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        Stored kept = this;\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Printed \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        this.label = try refuseText();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(\"\{this\}\");\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Chosen \{\n"
        + "    protected string label;\n"
        + "    protected constructor(Chosen other, bool flag) \{\n"
        + "        this.label = try refuseText();\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        Chosen chosen = flag ? this : other;\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n");
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 7L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'render' is called on 'this' in this 'catch' clause, and 'render' may read field 'label' of "
        + "class 'Rendered'. When 'refuseCount' throws 'Shortage', the body has not assigned 'label' "
        + "yet. Assign 'label' in the clause before this call, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "This lambda in a 'catch' clause uses 'this', so calling it may read field 'label' of class "
        + "'Captured'. When the body throws 'Shortage', it has not assigned 'label' yet. Assign 'label' "
        + "in the clause before this lambda, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "'describe' is called on 'this' in this 'catch' clause, and 'describe' may read field "
        + "'name' of base class 'Named'. When 'refuseText' throws 'Refusal' in the arguments of "
        + "'super(...)', 'Named' is not constructed yet. Remove this call, or remove this 'catch' "
        + "clause and move the call to 'refuseText' into a function that catches 'Refusal' and "
        + "returns a value to pass to 'super(...)'.");
    try sema_support.assertDiagnostic(diagnostics, 3, "/proj/src/main.ens",
        "'this' is passed to 'handOver' in this 'catch' clause, and 'handOver' may read field 'label' "
        + "of class 'Passing'. When 'refuseText' throws 'Refusal', the body has not assigned 'label' "
        + "yet. Assign 'label' in the clause before this line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/src/main.ens",
        "'this' is stored in 'kept' in this 'catch' clause, and code that uses 'kept' may read field "
        + "'label' of class 'Stored'. When 'refuseText' throws 'Refusal', the body has not assigned "
        + "'label' yet. Assign 'label' in the clause before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 5, "/proj/src/main.ens",
        "'\{this\}' calls 'toString' on 'this' in this 'catch' clause, and 'toString' may read field "
        + "'label' of class 'Printed'. When 'refuseText' throws 'Refusal', the body has not assigned "
        + "'label' yet. Assign 'label' in the clause before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(diagnostics, 6, "/proj/src/main.ens",
        "'this' is stored in 'chosen' in this 'catch' clause, and code that uses 'chosen' may read "
        + "field 'label' of class 'Chosen'. When 'refuseText' throws 'Refusal', the body has not "
        + "assigned 'label' yet. Assign 'label' in the clause before this line, for example "
        + "'this.label = ...;'.");
}

// A 'super(...)' in a catch clause is refused for what the clause catches: a throw before the
// body's 'super(...)', after which the clause cannot finish the constructor, a throw after it, or
// any throw of a body that calls none.
test "a 'super(...)' in a catch clause gives the fix for what the clause catches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Refusal extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"refused\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "checkedName(string text) -> string throws Refusal \{\n"
        + "    if (text.length == 0) \{\n"
        + "        throw new Refusal();\n"
        + "    \}\n"
        + "    return text;\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class PreOnly extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        super(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PreOnlyBody extends Named \{\n"
        + "    string? label;\n"
        + "\n"
        + "    constructor(string text) \{\n"
        + "        this.label = try checkedName(text);\n"
        + "        super(\"named\");\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Thrown extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Refusal();\n"
        + "        \}\n"
        + "        super(text);\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Mixed extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        super(try checkedName(text));\n"
        + "        print(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class MixedThrown extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Refusal();\n"
        + "        \}\n"
        + "        super(text);\n"
        + "        print(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class After extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        super(\"named\");\n"
        + "        print(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OnlyCatch extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string text) \{\n"
        + "        this.label = try checkedName(text);\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "        this.label = \"\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OnlyCatchTwice extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string text) \{\n"
        + "        this.label = try checkedName(text);\n"
        + "        print(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "        this.label = \"\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OnlyCatchThrown extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Refusal();\n"
        + "        \}\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OnlyCatchSafe extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        print(text);\n"
        + "    \} catch (Error error) \{\n"
        + "        super(\"fallback\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 0L);
    let caught = analysis.exceptionDiagnostics();
    try testing.assertEqual(caught.length, 11L);
    try sema_support.assertDiagnostic(caught, 0, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Move the call to 'checkedName' "
        + "into a function that catches 'Refusal' and returns a value to pass to "
        + "'super(...)', and remove this 'catch' clause. If the program cannot continue "
        + "without that value, replace this call with 'panic(...)'.");
    try sema_support.assertDiagnostic(caught, 1, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Move the call to 'checkedName' "
        + "into a function that catches 'Refusal' and returns a fallback value, and remove "
        + "this 'catch' clause. If the program cannot continue without that value, replace "
        + "this call with 'panic(...)'.");
    try sema_support.assertDiagnostic(caught, 2, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Replace this call with "
        + "'panic(...)'.");
    try sema_support.assertDiagnostic(caught, 3, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because the clause can run "
        + "after the body has already called it. Move the call to 'checkedName' into a "
        + "function that catches 'Refusal' and returns a value to pass to 'super(...)', and "
        + "remove this call.");
    try sema_support.assertDiagnostic(caught, 4, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because the clause can run "
        + "after the body has already called it. Remove this call, and end the clause with "
        + "'panic(...)'.");
    try sema_support.assertDiagnostic(caught, 5, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because the clause can run "
        + "after the body has already called it. Remove this call.");
    try sema_support.assertDiagnostic(caught, 6, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Move the call to 'checkedName' "
        + "into a function that catches 'Refusal' and returns a fallback value, call "
        + "'super(...)' at the end of the body, and remove this 'catch' clause.");
    try sema_support.assertDiagnostic(caught, 7, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Move the call to 'checkedName' "
        + "into a function that catches 'Refusal' and returns a fallback value, call "
        + "'super(...)' at the end of the body, and remove this call.");
    try sema_support.assertDiagnostic(caught, 8, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Call 'super(...)' at the end of "
        + "the body, and replace this call with 'panic(...)'.");
    try sema_support.assertDiagnostic(caught, 9, "/proj/src/app.ens",
        "'constructor' has a 'catch' clause, but its body cannot throw, so the clause never "
        + "runs. Remove the 'catch' clause.");
    try sema_support.assertDiagnostic(caught, 10, "/proj/src/app.ens",
        "'super(...)' cannot be called in a 'catch' clause, because base class 'Named' is "
        + "constructed only in the body of the constructor. Call 'super(...)' at the end of "
        + "the body, and remove this call.");
}
