import @std.testing;
import ProgramAnalysis from pipeline;
import FileDiagnostic from support.diagnostics;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

// The analysis of 'text' as '/proj/src/main.ens', with every stage but the exception check asserted clean.
analyzeExceptions(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    return analysis;
}

assertOne(ProgramAnalysis analysis, string message) throws {
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", message);
}

errorPrefix() -> string {
    return "class DatabaseError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "query() -> int throws \{\n"
        + "    throw new DatabaseError(\"q\");\n"
        + "\}\n";
}

test "a throwing call without try names the types and the fixes" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "caller() -> int throws \{\n"
        + "    return query();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try caller();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try'.");
    let unmarked = try analyzeExceptions(errorPrefix()
        + "caller() -> int \{\n"
        + "    return query();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n");
    try assertOne(unmarked, "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and "
    + "either catch it with a 'catch' clause or mark this function 'throws'.");
}

test "try on a call that cannot throw is rejected" {
    let analysis = try analyzeExceptions("safe() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try safe();\n"
        + "\}\n");
    try assertOne(analysis, "'try' is not needed here: 'safe' cannot throw. Remove 'try'.");
}

test "an unmarked function that can throw must be marked or handle it" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "caller() -> int \{\n"
        + "    return try query();\n"
        + "\}\n");
    try assertOne(analysis, "'caller' can throw 'DatabaseError' but is not marked 'throws'. Add "
    + "'throws DatabaseError' after the signature, or catch it with a 'catch' clause after the "
    + "body.");
}

test "a bare throws marker on a function that cannot throw is rejected" {
    let analysis = try analyzeExceptions("safe() -> int throws \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "'safe' is marked 'throws', but no exception can leave its body. Remove "
        + "'throws'.");
}

test "a declared throws list must cover the computed set" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "    protected abstract read() -> int throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read() -> int throws IoError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "'read' can throw 'NetError', which its 'throws' list does not name. "
    + "Add it to the list, or catch it with a 'catch' clause.");
}

test "an override may not widen the base contract" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "    protected abstract read() -> int throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read() -> int throws NetError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Override 'read' can throw 'NetError', which the 'read' it overrides "
    + "in 'Base' does not list. An override throws only what the method it overrides lists. Remove "
    + "'throws NetError' and catch 'NetError' with a 'catch' clause after the body. Or add "
    + "'NetError' to the 'throws' list of 'read' in 'Base'.");
}

test "a widening into a method this package does not declare offers the catch alone" {
    let loader = new FakeFileLoader();
    loader.addToCore("export interface Ordered<T> \{\n"
        + "    order(T other) -> int;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "class Boom extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class Base \{\n"
        + "    constructor();\n"
        + "    read() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    override read() -> int throws Boom \{\n"
        + "        throw new Boom(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Item implements Ordered<Item> \{\n"
        + "    constructor();\n"
        + "    override order(Item other) -> int throws Boom \{\n"
        + "        throw new Boom(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout, Stage.Exceptions]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/main.ens",
        "Method 'read' is marked 'throws', but the method it overrides in 'Base' is not. Mark the base "
        + "method 'throws' too, or catch the exceptions inside the override.");
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Method 'order' of 'Item' can throw 'Boom', which the 'order' declared by interface "
        + "'Ordered<Item>' does not list. An implementing method throws only what the interface "
        + "lists. Remove 'throws Boom' and catch 'Boom' with a 'catch' clause after the body.");
}

test "an implementing method may not widen the interface contract" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "interface Store \{\n"
        + "    save() -> int throws IoError;\n"
        + "\}\n"
        + "class DiskStore implements Store \{\n"
        + "    constructor();\n"
        + "    protected override save() -> int throws NetError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Method 'save' of 'DiskStore' can throw 'NetError', which the 'save' "
    + "declared by interface 'Store' does not list. An implementing method throws only what the "
    + "interface lists. Remove 'throws NetError' and catch 'NetError' with a 'catch' clause after "
    + "the body. Or add 'NetError' to the 'throws' list of 'save' in 'Store'.");
}

test "a catch clause the body can never reach with its type is dead" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class ParseError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "load() -> int throws \{\n"
        + "    throw new IoError(\"x\");\n"
        + "\}\n"
        + "run() -> int \{\n"
        + "    return try load();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 0;\n"
        + "\} catch (ParseError e) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "This 'catch (ParseError ...)' never runs: the body of 'run' cannot "
    + "throw 'ParseError' or a subclass of it. Remove the clause.");
}

test "a catch clause behind a broader one is unreachable" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "run() -> int \{\n"
        + "    return try query();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "This 'catch (DatabaseError ...)' never runs, because an earlier "
    + "'catch' clause already catches every 'DatabaseError'. Move it above that clause, or remove "
    + "it.");
}

test "catch clauses on a body that cannot throw are redundant" {
    let analysis = try analyzeExceptions("run() -> int \{\n"
        + "    return 1;\n"
        + "\} catch (Error e) \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "'run' has a 'catch' clause, but its body cannot throw, so the clause "
        + "never runs. Remove the 'catch' clause.");
    let two = try analyzeExceptions(errorPrefix()
        + "run() -> int \{\n"
        + "    return 1;\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 2;\n"
        + "\} catch (Error e) \{\n"
        + "    return 3;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(two, "'run' has two 'catch' clauses, but its body cannot throw, so they never "
        + "run. Remove the 'catch' clauses.");
}

test "a constructor must not let exceptions escape" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class Resource \{\n"
        + "    protected constructor() \{\n"
        + "        throw new IoError(\"x\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let resource = new Resource();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "The constructor of 'Resource' cannot let exceptions escape, but it "
        + "can throw 'IoError'. Catch the exceptions with 'catch' clauses after the constructor body.");
}

test "a destructor must not let exceptions escape" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class Resource \{\n"
        + "    protected constructor();\n"
        + "    destructor() \{\n"
        + "        throw new IoError(\"x\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let resource = new Resource();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "The destructor of 'Resource' cannot let exceptions escape, but it can "
        + "throw 'IoError'. Catch the exceptions with 'catch' clauses after the destructor body.");
}

test "a parameter default must not call a throwing function" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "use(int value = query()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return use(1);\n"
        + "\}\n");
    try assertOne(analysis, "The default value of parameter 'value' calls 'query', which can throw "
        + "'DatabaseError'. A default value runs at each call that leaves the argument out, and no "
        + "'try' can be written there. Move the call into a function that catches 'DatabaseError' "
        + "with a 'catch' clause, and call that function here.");
}

test "a field default must not call a throwing function" {
    let analysis = try analyzeExceptions(errorPrefix()
        + "class Config \{\n"
        + "    int port = query();\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "The default value of field 'port' calls 'query', which can throw "
        + "'DatabaseError'. A field default runs as each object is built, where no 'try' can be "
        + "written. Move the call into a function that catches 'DatabaseError' with a 'catch' "
        + "clause, and call that function here.");
}

test "only Error or a subclass can be caught" {
    let analysis = try analyzeExceptions("class Widget \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "run() -> int throws \{\n"
        + "    throw new IoError(\"x\");\n"
        + "\} catch (Widget w) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try run();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "Cannot catch 'Widget', because only 'Error' or a subclass of it can "
        + "be thrown and caught. Catch a class that extends 'Error'.");
}

test "a test body validates try usage" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main_test.ens", errorPrefix()
        + "test \"calls need try here too\" \{\n"
        + "    int value = query();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main_test.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try'.");
}

test "a thrown type parameter must be declared or listed like any other exception" {
    let unmarked = try analyzeExceptions("forward<E: Error>(E error) \{\n"
        + "    throw error;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(unmarked, "'forward' can throw 'E' but is not marked 'throws'. Add 'throws E' "
    + "after the signature, or catch it with a 'catch' clause after the body.");
    let mislisted = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "forward<E: Error>(E error) throws IoError \{\n"
        + "    throw error;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(mislisted, "'forward' can throw 'E', which its 'throws' list does not name. Add "
    + "it to the list, or catch it with a 'catch' clause.");
}

// The one exceptions diagnostic of a program whose only other problem is the unknown type
// 'Unknwon'.
exceptionBesideMisspelledType(string text) -> FileDiagnostic throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let unresolved = analysis.signatureDiagnostics();
    try testing.assertEqual(unresolved.length, 1L);
    try sema_support.assertDiagnostic(unresolved, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    return reported[0];
}

test "a catch of Error handles a call whose throws list did not resolve" {
    let tried = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "caller() -> int \{\n"
        + "    return try misspelled();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try caller();\n"
        + "\}\n");
    try testing.assertEqual(tried.message(),
        "'try' is not needed here: 'caller' cannot throw. Remove 'try'.");
    let marked = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "caller() -> int throws \{\n"
        + "    return try misspelled();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(marked.message(),
        "'caller' is marked 'throws', but no exception can leave its body. Remove 'throws'.");
}

test "a call to a function marked throws needs try when its throws list did not resolve" {
    let reported = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "caller() -> int throws \{\n"
        + "    return misspelled();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.message(),
        "Call to 'misspelled' can throw, because it is marked 'throws'. Prefix it with 'try'.");
}

// Every exceptions diagnostic of a program the other stages accept.
exceptionProblems(string text) -> FileDiagnostic[] throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    return analysis.exceptionDiagnostics();
}

test "a missing try is fixed as the constructor, destructor or lambda holding the call allows" {
    let reported = try exceptionProblems(errorPrefix()
        + "class Holder \{\n"
        + "    protected constructor() \{\n"
        + "        int value = query();\n"
        + "    \} catch (DatabaseError e) \{\n"
        + "    \}\n"
        + "\n"
        + "    destructor() \{\n"
        + "        int value = query();\n"
        + "    \} catch (DatabaseError e) \{\n"
        + "    \}\n"
        + "\}\n"
        + "run((() -> int throws DatabaseError) body) -> int throws DatabaseError \{\n"
        + "    return try body();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder();\n"
        + "    return try run(() -> query());\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 3L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and catch it with a 'catch' "
        + "clause after the constructor body.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and catch it with a 'catch' "
        + "clause after the destructor body.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try'.");
}

test "a missing try in a lambda names what the target function type has to list" {
    let reported = try exceptionProblems(errorPrefix()
        + "run(() -> int body) -> int \{\n"
        + "    return body();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run(() -> query());\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and add 'DatabaseError' "
        + "to the 'throws' list of the function type the lambda is given to, or move the call into "
        + "a named function that catches 'DatabaseError' with a 'catch' clause.");
}

test "an unmarked function calling one whose list did not resolve must be marked or catch" {
    let reported = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "caller() -> int \{\n"
        + "    return try misspelled();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.message(), "'caller' can throw but is not marked 'throws'. Add "
        + "'throws' after the signature, or catch it with a 'catch' clause after the body.");
}

test "a lambda whose body raises what an unresolved list names needs a target that lists it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", sema_support.misspelledThrower()
        + "run(() -> int body) -> int \{\n"
        + "    return body();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run(() -> try misspelled());\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This lambda can throw, but the function type it is given to has no 'throws' list. Add a "
        + "'throws' list after that function type's return type, as in '(() -> int throws "
        + "Error)', or move the throwing code into a named function that catches it with a 'catch' "
        + "clause.");
}

test "a call without try in a lambda to a function whose list did not resolve is one report" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", sema_support.misspelledThrower()
        + "run(() -> int body) -> int \{\n"
        + "    return body();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run(() -> misspelled());\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to 'misspelled' can throw, because it is marked 'throws'. Prefix it with 'try', and "
        + "add what it throws to the 'throws' list of the function type the lambda is given to, or "
        + "move the call into a named function that catches it with a 'catch' clause.");
}

test "a default value calling a function whose list did not resolve is refused" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", sema_support.misspelledThrower()
        + "use(int value = misspelled()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "class Config \{\n"
        + "    int port = misspelled();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return use(1);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The default value of parameter 'value' calls 'misspelled', which is marked 'throws'. A "
        + "default value runs at each call that leaves the argument out, and no 'try' can be "
        + "written there. Move the call into a function that catches what it throws with a 'catch' "
        + "clause, and call that function here.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The default value of field 'port' calls 'misspelled', which is marked 'throws'. A field "
        + "default runs as each object is built, where no 'try' can be written. Move the call into "
        + "a function that catches what it throws with a 'catch' clause, and call that function "
        + "here.");
}

test "a default value calling through a function value names the expression written" {
    let reported = try exceptionProblems(errorPrefix()
        + "producer() -> (() -> int throws DatabaseError) \{\n"
        + "    return () -> try query();\n"
        + "\}\n"
        + "use(int value = producer()()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return use(1);\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The default value of parameter 'value' calls the function value 'producer()', which can "
        + "throw 'DatabaseError'. A default value runs at each call that leaves the argument out, "
        + "and no 'try' can be written there. Move the call into a function that catches "
        + "'DatabaseError' with a 'catch' clause, and call that function here.");
}

test "a call reported for its missing try leaves the function holding it judged on the rest" {
    let onlyCall = try exceptionProblems(errorPrefix()
        + "caller() -> int \{\n"
        + "    return query();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(onlyCall.length, 1L);
    try sema_support.assertDiagnostic(onlyCall, 0, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and either catch it with a "
        + "'catch' clause or mark this function 'throws'.");
    let mixed = try exceptionProblems(errorPrefix()
        + "class ParseError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "caller() -> int \{\n"
        + "    int value = query();\n"
        + "    throw new ParseError(\"p\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(mixed.length, 2L);
    try sema_support.assertDiagnostic(mixed, 0, "/proj/src/main.ens",
        "'caller' can throw 'ParseError' but is not marked 'throws'. Add 'throws ParseError' after the "
        + "signature, or catch it with a 'catch' clause after the body.");
    try sema_support.assertDiagnostic(mixed, 1, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and either catch it with a "
        + "'catch' clause or mark this function 'throws'.");
    let constructed = try exceptionProblems(errorPrefix()
        + "class Holder \{\n"
        + "    protected constructor() \{\n"
        + "        int value = query();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(constructed.length, 1L);
    try sema_support.assertDiagnostic(constructed, 0, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and catch it with a 'catch' "
        + "clause after the constructor body.");
}

test "a call without try to a function whose list did not resolve is the one report about it" {
    let reported = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "caller() -> int \{\n"
        + "    return misspelled();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.message(), "Call to 'misspelled' can throw, because it is marked "
        + "'throws'. Prefix it with 'try', and either catch it with a 'catch' clause or mark this "
        + "function 'throws'.");
}

test "a missing try in a catch clause's body is fixed as that position allows" {
    let reported = try exceptionProblems(errorPrefix()
        + "class Holder \{\n"
        + "    protected constructor() \{\n"
        + "        int value = try query();\n"
        + "    \} catch (DatabaseError e) \{\n"
        + "        int again = query();\n"
        + "    \}\n"
        + "\n"
        + "    destructor() \{\n"
        + "        int value = try query();\n"
        + "    \} catch (DatabaseError e) \{\n"
        + "        int again = query();\n"
        + "    \}\n"
        + "\}\n"
        + "unmarked() -> int \{\n"
        + "    return try query();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return query();\n"
        + "\}\n"
        + "marked() -> int throws \{\n"
        + "    return try query();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return query();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder();\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 4L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. A 'catch' clause does not catch what the code "
        + "inside it throws, and a constructor cannot be marked 'throws'. Move the call into a "
        + "function that catches it with a 'catch' clause.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. A 'catch' clause does not catch what the code "
        + "inside it throws, and a destructor cannot be marked 'throws'. Move the call into a "
        + "function that catches it with a 'catch' clause.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. A 'catch' clause does not catch what the code "
        + "inside it throws. Prefix it with 'try' and mark this function 'throws', or move the "
        + "call into a function that catches it with a 'catch' clause.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try'.");
}

test "a function value is quoted when written on one line without a comment" {
    let reported = try exceptionProblems(errorPrefix()
        + "open(string address) -> (() -> int throws DatabaseError) \{\n"
        + "    return () -> try query();\n"
        + "\}\n"
        + "quoted() -> int \{\n"
        + "    return open(\"http://example\")();\n"
        + "\}\n"
        + "commented() -> int \{\n"
        + "    return open(/* the source */ \"a\")();\n"
        + "\}\n"
        + "spread() -> int \{\n"
        + "    return open\n"
        + "        (\"b\")();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    string fix = "Prefix it with 'try', and either catch it with a 'catch' clause or mark this function "
        + "'throws'.";
    try testing.assertEqual(reported.length, 3L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to the function value 'open(\"http://example\")' can throw 'DatabaseError'. " + fix);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Call to the function value can throw 'DatabaseError'. " + fix);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Call to the function value can throw 'DatabaseError'. " + fix);
}

test "a constructor calling a function whose list did not resolve cannot let it escape" {
    let reported = try exceptionBesideMisspelledType(sema_support.misspelledThrower()
        + "class Holder \{\n"
        + "    protected constructor() \{\n"
        + "        int value = try misspelled();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder();\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.message(), "The constructor of 'Holder' cannot let exceptions "
        + "escape, but it can throw. Catch the exceptions with 'catch' clauses after the constructor body.");
}

test "an unmarked function that throws is the one report, however its callers call it" {
    let reported = try exceptionProblems(errorPrefix()
        + "quiet() -> int \{\n"
        + "    throw new DatabaseError(\"q\");\n"
        + "\}\n"
        + "plain() -> int \{\n"
        + "    return quiet();\n"
        + "\}\n"
        + "tried() -> int \{\n"
        + "    return try quiet();\n"
        + "\}\n"
        + "use(int value = quiet()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return plain() + tried() + use(1);\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'quiet' can throw 'DatabaseError' but is not marked 'throws'. Add 'throws DatabaseError' after "
        + "the signature, or catch it with a 'catch' clause after the body.");
}

test "an unmarked function missing a try is the one report, however its callers call it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", sema_support.misspelledThrower()
        + "quiet() -> int \{\n"
        + "    return misspelled();\n"
        + "\}\n"
        + "plain() -> int \{\n"
        + "    return quiet();\n"
        + "\}\n"
        + "tried() -> int \{\n"
        + "    return try quiet();\n"
        + "\}\n"
        + "use(int value = quiet()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return plain() + tried() + use(1);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Call to 'misspelled' can throw, because it is marked 'throws'. Prefix it with 'try', and either "
        + "catch it with a 'catch' clause or mark this function 'throws'.");
}

test "try on a call to an unmarked function that cannot throw is still not needed" {
    let reported = try exceptionProblems("clean() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try clean();\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'try' is not needed here: 'clean' cannot throw. Remove 'try'.");
}

test "an override or implementation is judged on what remains beside calls missing try" {
    let reported = try exceptionProblems("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "fetch() throws NetError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected abstract read() throws IoError;\n"
        + "\n"
        + "    protected abstract write() throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override read() \{\n"
        + "        fetch();\n"
        + "    \}\n"
        + "\n"
        + "    protected override write() \{\n"
        + "        fetch();\n"
        + "        throw new NetError(\"w\");\n"
        + "    \}\n"
        + "\}\n"
        + "interface Store \{\n"
        + "    save() throws IoError;\n"
        + "\n"
        + "    load() throws IoError;\n"
        + "\}\n"
        + "class DiskStore implements Store \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override save() \{\n"
        + "        fetch();\n"
        + "    \}\n"
        + "\n"
        + "    protected override load() \{\n"
        + "        fetch();\n"
        + "        throw new NetError(\"l\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    string missingTry = "Call to 'fetch' can throw 'NetError'. Prefix it with 'try', and catch it with a "
        + "'catch' clause after the body.";
    try testing.assertEqual(reported.length, 6L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", missingTry);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Override 'write' can throw 'NetError', which the 'write' it overrides in 'Base' does not "
        + "list. An override throws only what the method it overrides lists. Catch 'NetError' with "
        + "a 'catch' clause after the body. Or add 'NetError' to the 'throws' list of 'write' in "
        + "'Base', and write 'throws NetError' after the signature of this 'write'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", missingTry);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", missingTry);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Method 'load' of 'DiskStore' can throw 'NetError', which the 'load' declared by interface "
        + "'Store' does not list. An implementing method throws only what the interface lists. "
        + "Catch 'NetError' with a 'catch' clause after the body. Or add 'NetError' to the "
        + "'throws' list of 'load' in 'Store', and write 'throws NetError' after the signature of "
        + "this 'load'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", missingTry);
}

test "an unmarked override that widens its base is reported once, with every type to write" {
    let reported = try exceptionProblems("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected abstract run() throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override run() \{\n"
        + "        if (true) \{\n"
        + "            throw new IoError(\"i\");\n"
        + "        \}\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "plain() \{\n"
        + "    throw new NetError(\"p\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Override 'run' can throw 'NetError', which the 'run' it overrides in 'Base' does not "
        + "list. An override throws only what the method it overrides lists. Catch 'NetError' with "
        + "a 'catch' clause after the body. Or add 'NetError' to the 'throws' list of 'run' in "
        + "'Base', and write 'throws IoError, NetError' after the signature of this 'run'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'plain' can throw 'NetError' but is not marked 'throws'. Add 'throws NetError' after the "
        + "signature, or catch it with a 'catch' clause after the body.");
}

test "a caller of a function marked throws that raises nothing is told nothing about it" {
    let reported = try exceptionProblems(errorPrefix()
        + "empty() -> int throws \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "direct() -> int \{\n"
        + "    return try empty();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "relay() -> int throws \{\n"
        + "    return try empty();\n"
        + "\}\n"
        + "class Opener \{\n"
        + "    protected constructor() \{\n"
        + "        int value = try empty();\n"
        + "    \} catch (Error e) \{\n"
        + "    \}\n"
        + "\}\n"
        + "listed() -> int \{\n"
        + "    return try query();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return direct() + listed();\n"
        + "\}\n");
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'empty' is marked 'throws', but no exception can leave its body. Remove 'throws'.");
}

test "a missing try in an override or implementation offers the marker only where it compiles" {
    let reported = try exceptionProblems("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "fetchNet() throws NetError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "fetchIo() throws IoError \{\n"
        + "    throw new IoError(\"i\");\n"
        + "\}\n"
        + "fetchBoth(bool io) throws IoError, NetError \{\n"
        + "    if (io) \{\n"
        + "        throw new IoError(\"i\");\n"
        + "    \}\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected abstract unlisted() throws IoError;\n"
        + "\n"
        + "    protected abstract listed() throws IoError;\n"
        + "\n"
        + "    protected abstract mixed() throws IoError;\n"
        + "\n"
        + "    protected plain() \{\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override unlisted() \{\n"
        + "        fetchNet();\n"
        + "    \}\n"
        + "\n"
        + "    protected override listed() \{\n"
        + "        fetchIo();\n"
        + "    \}\n"
        + "\n"
        + "    protected override mixed() \{\n"
        + "        fetchBoth(true);\n"
        + "    \}\n"
        + "\n"
        + "    protected override plain() \{\n"
        + "        fetchIo();\n"
        + "    \}\n"
        + "\}\n"
        + "interface Store \{\n"
        + "    unlisted() throws IoError;\n"
        + "\n"
        + "    listed() throws IoError;\n"
        + "\n"
        + "    mixed() throws IoError;\n"
        + "\n"
        + "    plain();\n"
        + "\}\n"
        + "class DiskStore implements Store \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected override unlisted() \{\n"
        + "        fetchNet();\n"
        + "    \}\n"
        + "\n"
        + "    protected override listed() \{\n"
        + "        fetchIo();\n"
        + "    \}\n"
        + "\n"
        + "    protected override mixed() \{\n"
        + "        fetchBoth(true);\n"
        + "    \}\n"
        + "\n"
        + "    protected override plain() \{\n"
        + "        fetchIo();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    string catchOnly = "Prefix it with 'try', and catch it with a 'catch' clause after the body.";
    string markable = "Prefix it with 'try', and either catch it with a 'catch' clause or mark this function "
        + "'throws'.";
    string[] expected = [
        "Call to 'fetchNet' can throw 'NetError'. " + catchOnly,
        "Call to 'fetchIo' can throw 'IoError'. " + markable,
        "Call to 'fetchBoth' can throw 'IoError' and 'NetError'. " + catchOnly,
        "Call to 'fetchIo' can throw 'IoError'. " + catchOnly,
    ];
    try testing.assertEqual(reported.length, 8L);
    for (long i = 0; i < 8; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", expected[i % 4]);
    }
}

test "an override widening by several types names each one to catch" {
    let analysis = try analyzeExceptions("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class DiskError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "    protected abstract read(bool disk) -> int throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read(bool disk) -> int throws \{\n"
        + "        if (disk) \{\n"
        + "            throw new DiskError(\"d\");\n"
        + "        \}\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Override 'read' can throw 'DiskError' and 'NetError', which the 'read' "
        + "it overrides in 'Base' does not list. An override throws only what the method it "
        + "overrides lists. Remove 'throws' and catch 'DiskError' and 'NetError' with 'catch' clauses "
        + "after the body. Or add 'DiskError' and 'NetError' to the 'throws' list of 'read' in "
        + "'Base'.");
}

