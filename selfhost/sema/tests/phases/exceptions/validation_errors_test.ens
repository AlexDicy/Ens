        + "    protected read(bool b) -> int throws Boom \{\n"
        + "        throw new Boom(\"b\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Child extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read(bool b) -> int \{\n"
        + "        if (b) \{\n"
        + "            throw new Boom(\"b\");\n"
        + "        \}\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
