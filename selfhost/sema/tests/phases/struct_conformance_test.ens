// Struct conformance, the accepted side: an 'implements' clause resolves onto the struct type,
// a generic struct's clause substitutes onto each instantiation, and the conformance satisfies a
// generic bound without giving the struct an interface value.
import @std.testing;
import TestFailure from @std.testing;
import ProgramAnalysis from pipeline;
import InstantiationType from model.types;
import StructType from model.types;
import PrimitiveKind from model.types;
import Type from model.types;
import model.types;
import sema_support;
import FakeFileLoader from sema_support;

analyzeClean(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.exceptionDiagnostics());
    return analysis;
}

structNamed(ProgramAnalysis analysis, string name) -> StructType throws {
    return try sema_support.structNamed(analysis, "main", name);
}

test "a struct's 'implements' clause is recorded on the struct type" {
    let analysis = try analyzeClean(
        "public interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "public struct Note implements Speaker \{\n"
        + "    int id;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"note\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let note = try structNamed(analysis, "Note");
    let speaker = try sema_support.interfaceNamed(analysis, "main", "Speaker");
    try testing.assertEqual(note.interfaces().length, 1L);
    try testing.assertTrue(note.interfaces()[0] == speaker,
        "the clause resolves to the interface itself");
    let read = types.interfacesOf(note);
    try testing.assertEqual(read.length, 1L);
    try testing.assertTrue(read[0] == speaker, "interfacesOf answers for a struct");
    try testing.assertTrue(types.conformsTo(note, speaker),
        "the struct conforms to what it implements");
    try testing.assertTrue(types.satisfiesBound(note, speaker, []),
        "the conformance satisfies a bound naming the interface");
    try testing.assertTrue(types.baseOf(note) == null, "a struct never has a base");
}

test "a conformance reaches the interfaces the declared one extends" {
    let analysis = try analyzeClean(
        "public interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "public interface Loud extends Speaker \{\n"
        + "    volume() -> int;\n"
        + "\}\n"
        + "public struct Shout implements Loud \{\n"
        + "    int level;\n"
        + "\n"
        + "    public override speak() -> string \{\n"
        + "        return \"hey\";\n"
        + "    \}\n"
        + "\n"
        + "    public override volume() -> int \{\n"
        + "        return this.level;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let shout = try structNamed(analysis, "Shout");
    let speaker = try sema_support.interfaceNamed(analysis, "main", "Speaker");
    let loud = try sema_support.interfaceNamed(analysis, "main", "Loud");
    try testing.assertTrue(types.satisfiesBound(shout, loud, []),
        "the struct satisfies the interface it names");
    try testing.assertTrue(types.satisfiesBound(shout, speaker, []),
        "and the one that interface extends");
    let ladder = types.conformanceLadderOf(shout);
    try testing.assertEqual(ladder.length, 3L);
    try testing.assertTrue(ladder[0] == shout, "the ladder starts at the struct");
}

test "a generic struct's conformance substitutes onto each instantiation" {
    let analysis = try analyzeClean(
        "public interface Ordered<T> \{\n"
        + "    order(T other) -> int;\n"
        + "\}\n"
        + "public struct Pair<T> implements Ordered<Pair<T>> \{\n"
        + "    public T left;\n"
        + "    public T right;\n"
        + "\n"
        + "    public constructor(this.left, this.right);\n"
        + "\n"
        + "    public override order(Pair<T> other) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "lower<T: Ordered<T>>(T left, T right) -> T \{\n"
        + "    if (left.order(right) < 0) \{\n"
        + "        return left;\n"
        + "    \}\n"
        + "    return right;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let first = Pair<int>(1, 2);\n"
        + "    let second = Pair<int>(3, 4);\n"
        + "    let winner = lower<Pair<int>>(first, second);\n"
        + "    return winner.left;\n"
        + "\}\n");
    let store = analysis.store();
    let pair = try structNamed(analysis, "Pair");
    let ordered = try sema_support.interfaceNamed(analysis, "main", "Ordered");
    let intPair = store.instantiationOf(pair, [store.primitive(PrimitiveKind.Int)]);
    let wanted = store.instantiationOf(ordered, [intPair]);
    let read = types.interfacesOf(intPair);
    try testing.assertEqual(read.length, 1L);
    try testing.assertTrue(read[0] == wanted,
        "'Pair<int>' implements 'Ordered<Pair<int>>' with the argument substituted in");
    try testing.assertTrue(types.satisfiesBound(intPair, wanted, []),
        "the instantiation satisfies the bound at its own type");
    try testing.assertTrue(!types.satisfiesBound(intPair, ordered, []),
        "and not the open template the bound never names");
}

test "a struct with no conformance satisfies no interface bound" {
    let analysis = try analyzeClean(
        "public interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "public struct Silent \{\n"
        + "    int id;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let silent = try structNamed(analysis, "Silent");
    let speaker = try sema_support.interfaceNamed(analysis, "main", "Speaker");
    try testing.assertEqual(silent.interfaces().length, 0L);
    try testing.assertTrue(!types.conformsTo(silent, speaker),
        "a struct declaring nothing conforms to nothing");
    try testing.assertTrue(!types.satisfiesBound(silent, speaker, []),
        "so it satisfies no interface bound");
}

test "an interface declared in another module holds the conformance" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/contract.ens",
        "public interface Sized \{\n"
        + "    size() -> long;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Sized from contract;\n"
        + "public struct Box implements Sized \{\n"
        + "    long count;\n"
        + "\n"
        + "    public override size() -> long \{\n"
        + "        return this.count;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    let box = try structNamed(analysis, "Box");
    let sized = try sema_support.interfaceNamed(analysis, "contract", "Sized");
    try testing.assertTrue(types.satisfiesBound(box, sized, []),
        "the conformance holds across modules");
}

test "a struct that implements Iterable is walked by a for-in loop" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "public class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    public constructor(this.current);\n"
        + "    public override next() -> int? \{\n"
        + "        if (this.current >= 3) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        this.current = this.current + 1;\n"
        + "        return this.current;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Digits implements Iterable<int> \{\n"
        + "    public int start;\n"
        + "    public override makeIterator() -> Iterator<int> \{\n"
        + "        return new CountUp(this.start);\n"
        + "    \}\n"
        + "\}\n"
        + "total(Digits digits) -> int \{\n"
        + "    let sum = 0;\n"
        + "    for (let value in digits) \{\n"
        + "        sum = sum + value;\n"
        + "    \}\n"
        + "    return sum;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Digits digits = \{start: 0\};\n"
        + "    return total(digits) - 6;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let digits = try sema_support.structNamed(analysis, "main", "Digits");
    let iterable = try sema_support.interfaceNamed(analysis, "std.collections.iterator",
        "Iterable");
    try testing.assertTrue(types.conformingInstantiationOf(digits, iterable) != null,
        "the conformance ladder of a struct carries the 'Iterable' instantiation the loop reads");
}
