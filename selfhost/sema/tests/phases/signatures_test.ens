import @std.testing;
import FakeFileLoader from sema_support;
import sema_support;
import phases.signatures;

test "the entry point accepts no return type, 'int', 'throws', and 'noreturn'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/plain.ens", "main() \{ \}\n");
    loader.add("/proj/src/coded.ens", "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/proj/src/failing.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "main() -> int throws \{\n    throw new Failure(\"stop\");\n\}\n");
    loader.add("/proj/src/looping.ens", "noreturn main() \{\n    while (true) \{ \}\n\}\n");
    for (let entry in ["plain.ens", "coded.ens", "failing.ens", "looping.ens"]) {
        let analysis = sema_support.analyzeFileProgram(loader, "/proj/src", entry);
        try sema_support.assertProgramClean(analysis);
    }
}

// A base's list of subclasses belongs to the module that declares the base, so resolving another
// module's signatures only records that the base accepted the class.
test "resolving one module's signatures writes nothing into a class another module declares" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import Base from lib;\n"
        + "class Derived extends Base \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/lib.ens",
        "public class Base \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
    let base = try sema_support.classNamed(analysis, "lib", "Base");
    try testing.assertEqual(base.directSubclasses().length(), 1L);
    let resolved = signatures.resolveModule(try sema_support.contextFor(analysis, "app"));
    try testing.assertEqual(base.directSubclasses().length(), 1L);
    try testing.assertEqual(resolved.classItems().length(), 1L);
    try testing.assertTrue(resolved.classItems().get(0).listedByBase(),
        "the base accepted the class");
}

// Lists are filled in the order the modules and their declarations come, and a class whose base
// refused it keeps the base for its members but is not one of the subclasses the base lists.
test "every module's subclasses are listed once in order, and a refused one is left out" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import Base from lib;\n"
        + "import Closed from lib;\n"
        + "import other;\n"
        + "class First extends Base \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class Second extends Base \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class Refused extends Closed \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/other.ens",
        "import Base from lib;\n"
        + "public class Third extends Base \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/lib.ens",
        "public class Base \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public final class Closed \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let base = try sema_support.classNamed(analysis, "lib", "Base");
    let closed = try sema_support.classNamed(analysis, "lib", "Closed");
    let listed = base.directSubclasses();
    try testing.assertEqual(listed.length(), 3L);
    try testing.assertEqual(listed.get(0).name(), "First");
    try testing.assertEqual(listed.get(1).name(), "Second");
    try testing.assertEqual(listed.get(2).name(), "Third");
    try testing.assertEqual(closed.directSubclasses().length(), 0L);
    let refused = try sema_support.classNamed(analysis, "app", "Refused");
    try testing.assertTrue(refused.base() == closed, "the refused class keeps its base");
}
