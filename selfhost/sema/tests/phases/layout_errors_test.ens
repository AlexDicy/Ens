import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

// A type that did not resolve is reported where it is written. A comparison it could be the whole
// difference in is skipped, and one that differs where both sides resolved is still reported, with
// the type spelled as written.
test "a signature that names an unresolved type is compared only where both sides resolved" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected value() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    protected scaled(int x) -> int \{\n"
        + "        return x;\n"
        + "    \}\n"
        + "    protected resized(int x, int y) -> int \{\n"
        + "        return x;\n"
        + "    \}\n"
        + "    protected held(Faded x) -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "    protected override value() -> Missing \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "    protected override scaled(Lost x) -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "    protected override resized(Gone x, string y) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "    protected override held(int x) -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "    protected override missing(Absent value) \{\n"
        + "    \}\n"
        + "\}\n"
        + "interface Sized \{\n"
        + "    size(int x) -> int;\n"
        + "\}\n"
        + "interface Shape \{\n"
        + "    area() -> int;\n"
        + "    measured(int width) -> int;\n"
        + "\}\n"
        + "class Box implements Sized, Shape \{\n"
        + "    protected constructor();\n"
        + "    protected override size(Hidden x) -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    protected override area() -> Vanished \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    protected override measured(Unknown width, string extra) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 11L);
    string file = "/proj/src/main.ens";
    string fix = "Check the spelling, or import the module that declares it.";
    try sema_support.assertDiagnostic(found, 0, file, "Unknown type 'Faded'. {fix}");
    try sema_support.assertDiagnostic(found, 1, file, "Unknown type 'Missing'. {fix}");
    try sema_support.assertDiagnostic(found, 2, file, "Unknown type 'Lost'. {fix}");
    try sema_support.assertDiagnostic(found, 3, file, "Override of 'resized' is "
        + "'resized(Gone, string) -> bool', but the 'resized' declared in 'Base' is "
        + "'resized(int, int) -> int'. Change this 'resized' to match it, or remove 'override'.");
    try sema_support.assertDiagnostic(found, 4, file, "Unknown type 'Gone'. {fix}");
    try sema_support.assertDiagnostic(found, 5, file, "Method 'missing' of 'Derived' is marked "
        + "'override', but no base class or interface of 'Derived' declares 'missing'. Remove "
        + "'override', or check the spelling of 'missing'.");
    try sema_support.assertDiagnostic(found, 6, file, "Unknown type 'Absent'. {fix}");
    try sema_support.assertDiagnostic(found, 7, file, "Unknown type 'Hidden'. {fix}");
    try sema_support.assertDiagnostic(found, 8, file, "Unknown type 'Vanished'. {fix}");
    try sema_support.assertDiagnostic(found, 9, file, "Override of 'measured' is "
        + "'measured(Unknown, string) -> bool', but the 'measured' declared in interface 'Shape' is "
        + "'measured(int) -> int'. Change this 'measured' to match it, or remove 'override'.");
    try sema_support.assertDiagnostic(found, 10, file, "Unknown type 'Unknown'. {fix}");
}

// A fetched package is not the user's to edit, so an override of its class gets only the fix that
// changes the override.
test "an override of a fetched class is fixed in the override alone" {
    let loader = new FakeFileLoader();
    let fetched = sema_support.fetchedAcme(loader,
        "export class Base \{\n"
        + "    export constructor();\n"
        + "\n"
        + "    hidden() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    export run() \{\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from @acme.parts;\n"
        + "class Child extends Base \{\n"
        + "    constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\n"
        + "    override hidden() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\n"
        + "    override run() throws Error \{\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeWithFetched(loader, "/proj/src", ["main.ens"], fetched);
    let found = analysis.layoutDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(found, 0, file, "Cannot override 'hidden': 'Base' declares it "
        + "privately, so 'Child' does not inherit it. Remove 'override' to declare a separate method of "
        + "'Child'.");
    try sema_support.assertDiagnostic(found, 1, file, "Method 'run' is marked 'throws', but the method it "
        + "overrides in 'Base' is not. Catch the exceptions inside the override, and remove 'throws' from "
        + "it.");
    try testing.assertEqual(found.length, 2L);
}

test "the override matrix rejects hiding, final, missing bases, and mismatches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected greet() -> int \{ return 1; \}\n"
        + "    protected final locked() -> int \{ return 2; \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    greet() -> int \{ return 3; \}\n"
        + "    protected override locked() -> int \{ return 4; \}\n"
        + "    override missing() -> int \{ return 5; \}\n"
        + "    override greet(int x) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'greet' hides a method inherited from 'Base', so a call through 'Base' and one "
        + "through 'Derived' would run different code. Mark it 'override' to replace it, or give "
        + "it another name.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Cannot override 'locked', because it is declared 'final' in 'Base'. Rename this 'locked' "
        + "and remove 'override', or remove 'final' from 'locked' in 'Base'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'missing' of 'Derived' is marked 'override', but no base class or interface of "
            + "'Derived' declares 'missing'. Remove 'override', or check the spelling of 'missing'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'greet' of 'Derived' is marked 'override', but every 'greet' its base classes and "
            + "interfaces declare already has a matching method in 'Derived', so this one "
            + "overrides nothing. Remove 'override'.");
}

// The interface's overload the class provides is passed over for the one it does not, whether the
// class declares it before the override or after, so the one report names what is missing.
test "an override among an interface's overloads names the one the class still lacks" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak(string to) -> string;\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Talker extends Base implements Speaker \{\n"
        + "    protected constructor();\n"
        + "    override speak(string to) -> string \{ return to; \}\n"
        + "    override speak(int times) -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "class Reordered extends Base implements Speaker \{\n"
        + "    protected constructor();\n"
        + "    override speak(int times) -> string \{ return \"\"; \}\n"
        + "    override speak(string to) -> string \{ return to; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    for (long i = 0; i < 2; i++) {
        try sema_support.assertDiagnostic(found, i, "/proj/src/app.ens",
            "Override of 'speak' is 'speak(int) -> string', but the 'speak' declared in interface "
                + "'Speaker' is 'speak() -> string'. Change this 'speak' to match it, or remove "
                + "'override'.");
    }
}

// Of the overloads, the override is named beside the one the class does not override or provide
// yet, in whichever order they are declared, so the fix never repeats a method it has.
test "'override' among overloads names the one still to override or provide" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Named \{\n"
        + "    name(string prefix) -> string;\n"
        + "    name() -> string;\n"
        + "\}\n"
        + "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected title() -> string \{ return \"\"; \}\n"
        + "    protected title(string prefix) -> string \{ return prefix; \}\n"
        + "\}\n"
        + "class Card extends Base implements Named \{\n"
        + "    protected constructor();\n"
        + "    override name(string prefix) -> string \{ return prefix; \}\n"
        + "    override name(int times) -> string \{ return \"card\"; \}\n"
        + "    protected override title(string prefix) -> string \{ return prefix; \}\n"
        + "    protected override title(int times) -> string \{ return \"card\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Override of 'name' is 'name(int) -> string', but the 'name' declared in interface "
            + "'Named' is 'name() -> string'. Change this 'name' to match it, or remove 'override'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Override of 'title' is 'title(int) -> string', but the 'title' declared in 'Base' is "
            + "'title() -> string'. Change this 'title' to match it, or remove 'override'.");
}

test "a private base field is not inherited, so a subclass field, method or static reuses its name" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Base \{\n"
        + "    int secret;\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ this.secret = 1; this.shared = 2; \}\n"
        + "    protected baseSecret() -> int \{ return this.secret; \}\n"
        + "\}\n"
        + "class Reuses extends Base \{\n"
        + "    protected string secret;\n"
        + "    protected constructor() \{ super(); this.secret = \"own\"; \}\n"
        + "    protected ownSecret() -> string \{ return this.secret; \}\n"
        + "\}\n"
        + "class Reports extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected secret() -> int \{ return 3; \}\n"
        + "\}\n"
        + "class Tallies extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected static secret() -> int \{ return 4; \}\n"
        + "\}\n"
        + "class Collides extends Base \{\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'shared' is already declared in base class 'Base' and inherited by 'Collides'. Remove "
        + "this declaration and use the inherited field, or give this one another name.");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
}

test "abstract methods need abstract classes and concrete subclasses must implement them" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Solid \{\n"
        + "    constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "abstract class Shape \{\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Flat extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Abstract method 'area' has no body, so class 'Solid' must be 'abstract' too. Mark 'Solid' "
            + "'abstract', or give 'area' a body and remove 'abstract'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Class 'Flat' does not override 'area', an abstract method of 'Shape'. Declare 'area' in "
            + "'Flat' with a body and 'override', or mark 'Flat' 'abstract'.");
}

test "'final' means nothing on a private method, while a declared throws list still bounds it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor();\n"
        + "    final frozen() -> int \{ return 1; \}\n"
        + "    read() -> int throws Failure \{ return 2; \}\n"
        + "    protected final locked() -> int \{ return 3; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'frozen' cannot be 'final': it is private to 'Base', so no subclass can override "
        + "it anyway. Remove 'final'.");
}

test "interface satisfaction requires every method and the override marker" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak(int volume) -> string;\n"
        + "\}\n"
        + "class Silent implements Speaker \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Wrong implements Speaker \{\n"
        + "    constructor();\n"
        + "    speak(int volume) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'Silent' implements 'Speaker' but does not provide 'speak(int) -> string'. Declare "
        + "the method, or inherit it from a base class.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'speak' of 'Wrong' implements a method declared in interface 'Speaker' but is not "
        + "marked 'override'. Write 'override' before 'speak'.");
}

test "constructor and destructor rules hold" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    int id = 0;\n"
        + "    constructor() throws \{ \}\n"
        + "    Widget(int x) \{ \}\n"
        + "    destructor(int extra) -> int \{ return 1; \}\n"
        + "    destructor() \{ \}\n"
        + "    poke();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "    destructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 6L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "The constructor of 'Widget' cannot be marked 'throws'. A constructor never throws, so "
        + "building an object never needs 'try'. Remove 'throws', and catch the exceptions with "
        + "'catch' clauses after the constructor body.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Method 'Widget' has the name of its class, and a method cannot be named after its class. "
        + "To declare a constructor, write 'constructor(...)' instead of 'Widget(...)'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "The destructor of 'Widget' cannot take parameters. No code calls a destructor, so nothing "
        + "could pass them. Write it as 'destructor()'.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "The destructor of 'Widget' cannot declare a return type. No code calls a destructor, so "
        + "nothing could use the result. Remove '-> int'.");
    try sema_support.assertDiagnostic(layout, 4, "/proj/src/app.ens",
        "Class 'Widget' already declares a destructor. A class has at most one destructor. Remove "
        + "this second 'destructor', or move its body into the first.");
    try sema_support.assertDiagnostic(layout, 5, "/proj/src/app.ens",
        "'poke' has no body; it ends in ';'. Only a constructor or an 'abstract' method can leave "
        + "out its body. Replace the ';' with a body between '\{' and '\}'.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Struct 'Value' cannot declare a destructor. A destructor runs when the last reference to "
        + "an object goes away, and a struct is copied, never referenced. Remove the destructor, "
        + "or make 'Value' a class.");
}

test "a class's marked toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Throwing \{\n"
        + "    public constructor();\n"
        + "    public override toString() -> string throws Error \{ return \"t\"; \}\n"
        + "\}\n"
        + "public class Shaped \{\n"
        + "    public constructor();\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "abstract class Ghost \{\n"
        + "    abstract override toString() -> string;\n"
        + "\}\n"
        + "public class Quiet \{\n"
        + "    public constructor();\n"
        + "    protected override toString() -> string \{ return \"q\"; \}\n"
        + "\}\n"
        + "public class Legacy \{\n"
        + "    public constructor();\n"
        + "    public toString() -> string \{ return \"l\"; \}\n"
        + "\}\n"
        + "public class Sized \{\n"
        + "    public constructor();\n"
        + "    public toString(int scale) -> string \{ return \"s\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method "
        + "and remove 'override'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'toString' of 'Shaped' is marked 'override' but takes parameters, which makes it "
        + "an ordinary method rather than the text form every class has. Remove 'override'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'toString' of 'Ghost' cannot be 'abstract': every class already has a text form, "
        + "so an override of it needs a body. Write the body, or remove the method.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'toString' replaces the built-in text form of class 'Quiet', so it must be as "
        + "visible as 'Quiet' itself. Mark it 'public'.");
    // 'Legacy' has the text form's shape and writes no marker. 'Sized' takes an argument, so it
    // is an ordinary method that nothing in the language calls, and writing no marker is right.
    // 'Shaped' takes one too, which is why its marker has nothing to implement.
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Method 'toString' of 'Legacy' replaces the text form every class already has but is not "
        + "marked 'override'. Write 'override' before 'toString'.");
}

test "a field cannot be both 'weak' and 'const'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Tangle \{\n"
        + "    weak const Tangle? neighbor;\n"
        + "    constructor(this.neighbor);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'neighbor' cannot be both 'weak' and 'const': a 'const' field keeps one value for "
        + "the object's whole life, while a 'weak' field becomes null when the object it refers to "
        + "is destroyed. Remove one of the two.");
}

test "weak fields must be nullable classes and never be declared on structs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Watcher direct;\n"
        + "    weak Speaker? seen;\n"
        + "    constructor(this.direct);\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    weak int x;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 2L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'direct' of class 'Watcher' is 'weak', so its type must be nullable. A weak field "
        + "becomes 'null' when its object is destroyed. Write 'weak Watcher? direct'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'seen' of class 'Watcher' is 'weak', so its type must be a class. 'Speaker' is an "
        + "interface. Replace 'Speaker' with a class that implements 'Speaker'.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'x' of struct 'Value' cannot be 'weak'. A weak field becomes 'null' when its object "
        + "is destroyed. A struct is copied wherever it goes, so its copies could not all be set "
        + "to 'null'. Remove 'weak'.");
}

test "an unmarked member of a 'public' class cannot be abstract or provide a requirement" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public abstract class Vague \{\n"
        + "    public constructor();\n"
        + "    abstract go();\n"
        + "\}\n"
        + "public interface Speaker \{\n"
        + "    speak(int volume) -> string;\n"
        + "\}\n"
        + "public class Wrong implements Speaker \{\n"
        + "    public constructor();\n"
        + "    override speak(int volume) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Abstract method 'go' is private to 'Vague', so no subclass can implement it. Mark it 'protected'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'speak' of 'Wrong' is private, but it provides 'speak(int) -> string' for "
        + "interface 'Speaker', so it must be usable everywhere 'Wrong' is. Mark it 'public'.");
}

test "a subclass cannot reuse the name of a field it inherits" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    int value = 0;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    int value = 1;\n"
        + "\}\n"
        + "public class Shared \{\n"
        + "    protected int held = 0;\n"
        + "    public int open = 0;\n"
        + "    public constructor();\n"
        + "\}\n"
        + "class Takes extends Shared \{\n"
        + "    int held = 1;\n"
        + "    int open = 2;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'value' is already declared in base class 'Base' and inherited by 'Derived'. Remove "
        + "this declaration and use the inherited field, or give this one another name.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'held' is already declared in base class 'Shared' and inherited by 'Takes'. Remove "
        + "this declaration and use the inherited field, or give this one another name.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'open' is already declared in base class 'Shared' and inherited by 'Takes'. Remove "
        + "this declaration and use the inherited field, or give this one another name.");
}

test "interfaces, weak fields, destructors and hash name what to change" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "    constructor();\n"
        + "    destructor();\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak int count;\n"
        + "    weak Watcher?? twice;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Handle \{\n"
        + "    constructor();\n"
        + "    public destructor() \{ \}\n"
        + "\}\n"
        + "class Other \{\n"
        + "    constructor();\n"
        + "    override destructor() throws \{ \}\n"
        + "\}\n"
        + "class Keyed \{\n"
        + "    constructor();\n"
        + "    override hash(int seed) -> long \{ return 1; \}\n"
        + "    override equals(Keyed other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class Keyless \{\n"
        + "    constructor();\n"
        + "    override hash() \{ \}\n"
        + "    override equals(Keyless other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 2L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Interface 'Speaker' cannot declare a constructor. An interface has no objects of its own "
        + "to build. Remove the constructor.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Interface 'Speaker' cannot declare a destructor. An interface has no objects of its own "
        + "to destroy. Remove the destructor.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 7L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'count' of class 'Watcher' is 'weak', so its type must be a class. 'int' is not a "
        + "class. Remove 'weak'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'twice' of class 'Watcher' is 'weak', so its type needs exactly one '?'. "
        + "'Watcher??' has two. Write 'weak Watcher? twice'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "The destructor of 'Handle' cannot be 'public'. No code calls a destructor; it runs when "
        + "the object is destroyed. Remove 'public'.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try sema_support.assertDiagnostic(layout, 4, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be marked 'throws'. It runs when the object is "
        + "destroyed, where no code can catch an exception. Remove 'throws', and catch the "
        + "exceptions with 'catch' clauses after the destructor body.");
    try sema_support.assertDiagnostic(layout, 5, "/proj/src/app.ens",
        "Method 'hash' of 'Keyed' takes parameters. A Map or Set calls 'hash()' to find a key. "
        + "Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename both "
        + "'hash' and 'equals' and remove 'override' from each.");
    try sema_support.assertDiagnostic(layout, 6, "/proj/src/app.ens",
        "Method 'hash' of 'Keyless' returns nothing. A Map or Set calls 'hash()' to find a key. "
        + "Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename both "
        + "'hash' and 'equals' and remove 'override' from each.");
}

test "an override cannot drop a base method's noreturn contract" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "abstract class Base \{\n"
        + "    protected abstract noreturn boom();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected override boom() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "Override of 'boom' must be marked 'noreturn', because the 'boom' it overrides in 'Base' "
        + "is. Add 'noreturn' before the method name.");
    try testing.assertEqual(reported.length, 1L);
}

// A 'toString' marked 'throws' that overrides a base class's breaks the text form's rule, which names the
// real problem, so the override's own refusal of the 'throws' is not reported beside it.
test "an overriding toString marked throws is refused once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"failure\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Loud extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"loud\");\n"
        + "    \}\n"
        + "\n"
        + "    override toString() -> string throws Failure \{\n"
        + "        return \"loud\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method "
        + "and remove 'override'.");
    try testing.assertEqual(found.length, 1L);
}

test "an implementing toString marked throws is refused once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"failure\");\n"
        + "    \}\n"
        + "\}\n"
        + "interface Shown \{\n"
        + "    toString() -> string;\n"
        + "\}\n"
        + "class Showing implements Shown \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override toString() -> string throws Failure \{\n"
        + "        return \"showing\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method "
        + "and remove 'override'.");
    try testing.assertEqual(found.length, 1L);
    try testing.assertEqual(analysis.exceptionDiagnostics().length, 0L);
}
