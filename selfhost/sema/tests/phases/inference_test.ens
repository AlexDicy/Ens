import @std.testing;
import sema_support;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import TypeArgumentInference from phases.inference;
import ThrownListType from model.types;
import PendingThrowsType from model.types;

test "an argument that is no value leaves its slot open and keeps the first such argument" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let parameter = store.typeParameter(owner, 0, "T");
    let nothing = store.primitive(PrimitiveKind.Void);
    let inference = new TypeArgumentInference(store, owner, 1);
    inference.unifyArgument(1, parameter, nothing);
    inference.unifyArgument(2, parameter, nothing);
    try testing.assertTrue(inference.binding(0) == null, "no value should not bind 'T'");
    try testing.assertEqual(inference.voidArgument(0) ?? -1L, 1L);
    inference.unifyArgument(3, parameter, store.primitive(PrimitiveKind.Int));
    try testing.assertTrue(inference.binding(0) == store.primitive(PrimitiveKind.Int),
        "a later argument should still bind 'T'");
    try testing.assertTrue(inference.voidArgument(0) == null,
        "a bound slot should name no argument that offered 'void'");
}

test "a function that returns nothing binds 'void' until an argument gives a type" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let parameter = store.typeParameter(owner, 0, "T");
    let nothing = store.primitive(PrimitiveKind.Void);
    let inference = new TypeArgumentInference(store, owner, 1);
    inference.unifyArgument(0, store.functionOf([], parameter, []), store.functionOf([], nothing, []));
    try testing.assertTrue(inference.binding(0) == nothing, "'() -> void' should bind 'T' to 'void'");
    try testing.assertTrue(inference.voidArgument(0) == null,
        "a slot bound to 'void' should name no argument to refuse");
    inference.unifyArgument(1, parameter, store.primitive(PrimitiveKind.Int));
    try testing.assertTrue(inference.binding(0) == store.primitive(PrimitiveKind.Int),
        "an argument with a type should bind 'T' over a result of 'void'");
}

test "a template type settles only once every slot it mentions is bound" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let input = store.typeParameter(owner, 0, "T");
    let output = store.typeParameter(owner, 1, "R");
    let integer = store.primitive(PrimitiveKind.Int);
    let inference = new TypeArgumentInference(store, owner, 2);
    inference.unifyArgument(0, input, integer);
    try testing.assertTrue(inference.settled(store.functionOf([input], output, [])) == null,
        "a type that mentions the open 'R' should not settle");
    try testing.assertTrue(inference.settled(store.arrayOf(input)) == store.arrayOf(integer),
        "'T[]' should settle as 'int[]'");
    try testing.assertTrue(inference.voidArgument(1) == null,
        "an open slot no argument offered 'void' for should name no argument");
}

test "a throws list binds its type parameter to the rest of the argument's list, however long" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let thrown = store.typeParameter(owner, 0, "E");
    let integer = store.primitive(PrimitiveKind.Int);
    let first = store.stringType();
    let second = store.primitive(PrimitiveKind.Long);
    let template = store.functionOf([], integer, [thrown]);

    let both = new TypeArgumentInference(store, owner, 1);
    both.unifyArgument(0, template, store.functionOf([], integer, [first, second]));
    let listed = both.binding(0);
    try testing.assertTrue(listed is ThrownListType && listed.members().length == 2,
        "two thrown types should bind 'E' to a list of both");

    let one = new TypeArgumentInference(store, owner, 1);
    one.unifyArgument(0, template, store.functionOf([], integer, [first]));
    try testing.assertTrue(one.binding(0) == first, "a list of one type should be that type");

    let none = new TypeArgumentInference(store, owner, 1);
    none.unifyArgument(0, template, store.functionOf([], integer, []));
    let empty = none.binding(0);
    try testing.assertTrue(empty is ThrownListType && empty.members().length == 0,
        "a function that throws nothing should bind 'E' to the empty list");
    try testing.assertEqual(none.settledThrown([thrown])?.length ?? -1L, 0L);
}

test "a lambda's throws bind a throws-only parameter to what the lambda throws, pending" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let lambda = sema_support.anyGreenNode();
    let thrown = store.typeParameter(owner, 0, "E");
    let inference = new TypeArgumentInference(store, owner, 1);
    try testing.assertTrue(inference.settledThrown([thrown]) == null,
        "an open 'E' should leave the throws list unsettled");
    inference.pendThrows(0, [thrown], lambda, [false]);
    try testing.assertTrue(inference.binding(0) == null,
        "a parameter that is also the type of a value should not pend");
    inference.pendThrows(0, [thrown], lambda, [true]);
    let pending = inference.binding(0);
    try testing.assertTrue(pending is PendingThrowsType && pending.lambda() == lambda,
        "the lambda's throws should bind 'E'");
    try testing.assertEqual(inference.sourceOf(0), 0L);
}
