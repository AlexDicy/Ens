import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "a 'this.field' parameter refuses a private base field however deep the chain" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Base \{\n"
        + "    int secret = 1;\n"
        + "    protected int shared = 2;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Binds extends Base \{\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Middle extends Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Deeper extends Middle \{\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Absent extends Base \{\n"
        + "    protected constructor(this.missing);\n"
        + "\}\n"
        // Both of these bind a field their own class has, so both are accepted: 'Reuses'
        // declares 'secret' itself, and 'Shares' inherits 'shared'.
        + "class Reuses extends Base \{\n"
        + "    protected int secret = 3;\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Shares extends Base \{\n"
        + "    protected constructor(this.shared);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'secret' is private to 'Base', so 'Binds' has no field by that name. Declare one in "
        + "'Binds', or mark 'secret' 'protected' in 'Base'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'secret' is private to 'Base', so 'Deeper' has no field by that name. Declare one in "
        + "'Deeper', or mark 'secret' 'protected' in 'Base'.");
    // A name no field of the chain declares is reported as the absent field it is.
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Parameter 'this.missing' sets field 'missing', but 'Absent' has no field 'missing'. "
        + "Declare the field in 'Absent', or write the parameter's type instead of 'this.'.");
}

test "a base field a subclass inherits keeps its name from the subclass's own members" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ this.shared = 1; \}\n"
        + "\}\n"
        + "class Reports extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected shared() -> int \{ return 2; \}\n"
        + "\}\n"
        + "class Tallies extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected static shared() -> int \{ return 3; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    // Both messages name 'Base', the class that declares the field, rather than the subclass
    // the refused member is written in.
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'shared' is already declared as a field of 'Base', and a field and a method cannot share "
            + "a name. Rename one of the two.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Static member 'shared' has the same name as a field of 'Base'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
}

test "a class override carries the overridden method's visibility, capped at its own class" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "export class Wide \{\n"
        + "    export constructor();\n"
        + "    export greet() -> int \{ return 1; \}\n"
        + "    public wave() -> int \{ return 2; \}\n"
        + "\}\n"
        + "public class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected sound() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public class Unmarked extends Animal \{\n"
        + "    protected constructor();\n"
        + "    override sound() -> int \{ return 2; \}\n"
        + "\}\n"
        + "public class Wider extends Animal \{\n"
        + "    protected constructor();\n"
        + "    public override sound() -> int \{ return 3; \}\n"
        + "\}\n"
        + "public class Loud \{\n"
        + "    public constructor();\n"
        + "    public sound() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public class Narrower extends Loud \{\n"
        + "    public constructor();\n"
        + "    protected override sound() -> int \{ return 4; \}\n"
        + "\}\n"
        + "class Capped extends Wide \{\n"
        + "    protected constructor();\n"
        + "    export override greet() -> int \{ return 5; \}\n"
        + "\}\n"
        + "class Fine extends Wide \{\n"
        + "    protected constructor();\n"
        + "    protected override greet() -> int \{ return 6; \}\n"
        + "    protected override wave() -> int \{ return 7; \}\n"
        + "\}\n"
        + "public class AlsoFine extends Wide \{\n"
        + "    public constructor();\n"
        + "    public override greet() -> int \{ return 8; \}\n"
        + "    public override wave() -> int \{ return 9; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Override 'sound' must be 'protected', the visibility of the 'sound' it overrides in "
        + "'Animal'. Mark it 'protected'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Override 'sound' must be 'protected', the visibility of the 'sound' it overrides in "
        + "'Animal'. Replace 'public' with 'protected'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Override 'sound' must be 'public', the visibility of the 'sound' it overrides in 'Loud'. "
        + "Replace 'protected' with 'public'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Override 'greet' cannot be 'export' while 'Capped' is private to its file, because a "
        + "member is never more visible than the type that declares it. Remove 'export'. An "
        + "unmarked member of 'Capped' can already be used anywhere in its file.");
}

test "a member cannot be more visible than the type that contains it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Hidden \{\n"
        + "    export int wide;\n"
        + "    public constructor();\n"
        + "    export speak() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "public struct Pt \{\n"
        + "    export int x;\n"
        + "    export scaled() -> int \{ return this.x; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 3L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'wide' cannot be 'export' while 'Hidden' is private to its file, because a member "
        + "is never more visible than the type that declares it. Remove 'export'. An unmarked "
        + "member of 'Hidden' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "The constructor of 'Hidden' cannot be 'public' while 'Hidden' is private to its file, "
        + "because a member is never more visible than the type that declares it. Remove 'public'. "
        + "An unmarked member of 'Hidden' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Method 'speak' cannot be 'export' while 'Hidden' is private to its file, because a member "
        + "is never more visible than the type that declares it. Remove 'export'. An unmarked "
        + "member of 'Hidden' can already be used anywhere in its file.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 2L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'x' cannot be 'export' while 'Pt' is only 'public', because a member is never more "
        + "visible than the type that declares it. Replace 'export' with 'public', or mark 'Pt' "
        + "'export' too.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Method 'scaled' cannot be 'export' while 'Pt' is only 'public', because a member is never "
        + "more visible than the type that declares it. Replace 'export' with 'public', or mark "
        + "'Pt' 'export' too.");
}

test "hash and equals are validated as a pair with exact signatures" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class OnlyHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> long \{ return 1; \}\n"
        + "\}\n"
        + "class OnlyEquals \{\n"
        + "    constructor();\n"
        + "    override equals(OnlyEquals other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class BadHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> int \{ return 1; \}\n"
        + "\}\n"
        + "class Unmarked \{\n"
        + "    constructor();\n"
        + "    hash() -> long \{ return 1; \}\n"
        + "    override equals(Unmarked other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'OnlyHash' defines 'hash' but not 'equals'. A Map or Set uses the two together, so "
        + "a type that replaces one must replace both. Add 'override equals(OnlyHash other) -> "
        + "bool'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Class 'OnlyEquals' defines 'equals' but not 'hash'. A Map or Set uses the two together, "
        + "so a type that replaces one must replace both. Add 'override hash() -> long'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'hash' of 'BadHash' returns 'int'. A Map or Set calls 'hash()' to find a key. "
        + "Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename the "
        + "method.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'hash' of 'Unmarked' replaces the built-in identity hash but is not marked "
        + "'override'. Write 'override' before 'hash'.");
}

test "a struct member overrides only what the language gives a struct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Counter \{\n"
        + "    int value;\n"
        + "    override constructor(this.value);\n"
        + "    override doubled() -> int \{ return this.value * 2; \}\n"
        + "    override hash() -> long \{ return this.value; \}\n"
        + "    override equals(Counter other) -> bool \{ return true; \}\n"
        + "    override toString() -> string \{ return \"c\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The constructor of 'Counter' cannot be 'override'. A constructor never replaces the "
        + "constructor of a base class. Remove 'override'.");
    // The marker rule is whole-program, because an interface the struct implements may be
    // declared in another module.
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Method 'doubled' of 'Counter' is marked 'override', and a struct inherits nothing to "
        + "override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a "
        + "struct. Remove 'override'.");
}

test "a struct's hash is held to the content hash it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Unmarked \{\n"
        + "    int id;\n"
        + "    public hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Unmarked other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "public struct Shaped \{\n"
        + "    int id;\n"
        + "    public hash() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public struct Throwing \{\n"
        + "    int id;\n"
        + "    public override hash() -> long throws Error \{ return this.id; \}\n"
        + "\}\n"
        + "public struct Marked \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Marked other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'hash' of struct 'Unmarked' replaces the built-in content hash but is not marked "
        + "'override'. Write 'override' before 'hash'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'hash' of struct 'Shaped' returns 'int'. A Map or Set calls 'hash()' to find a "
        + "key. Every struct has a built-in 'hash() -> long'. Write 'override hash() -> long', or "
        + "rename the method.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A method named 'hash' cannot be marked 'throws': a hash is taken where no 'try' can be "
        + "written, such as on a Map or Set key. Remove 'throws', or rename the method.");
}

test "a struct's hash and equals are a matched pair, each written override" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct HashOnly \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "\}\n"
        + "public struct EqualsOnly \{\n"
        + "    int id;\n"
        + "    public override equals(EqualsOnly other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "public struct Ordinary \{\n"
        + "    int id;\n"
        + "    public equals(Ordinary other) -> bool \{ return true; \}\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "\}\n"
        + "public struct Paired \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Paired other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Struct 'HashOnly' defines 'hash' but not 'equals'. A Map or Set uses the two together, so "
        + "a type that replaces one must replace both. Add 'override equals(HashOnly other) -> "
        + "bool'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Struct 'EqualsOnly' defines 'equals' but not 'hash'. A Map or Set uses the two together, "
        + "so a type that replaces one must replace both. Add 'override hash() -> long'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'equals' of struct 'Ordinary' replaces the built-in memberwise equality but is not "
        + "marked 'override'. Write 'override' before 'equals'.");
}

test "a struct member cannot be abstract" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Box \{\n"
        + "    int value;\n"
        + "    abstract poke() -> int;\n"
        + "    abstract constructor(this.value);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'poke' of struct 'Box' cannot be 'abstract'; a struct has no subclass to give it a "
        + "body. Give 'poke' a body, or move it to an abstract class.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The constructor of 'Box' cannot be 'abstract'. 'abstract' marks a method each subclass "
        + "writes for itself, and a subclass never writes its base class's constructor. Remove "
        + "'abstract'.");
}

test "a method replacing a built-in behavior follows its type's visibility" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Point \{\n"
        + "    int x;\n"
        + "    protected override toString() -> string \{ return \"p\"; \}\n"
        + "\}\n"
        + "public class Key \{\n"
        + "    int id;\n"
        + "    public constructor(this.id);\n"
        + "    protected override hash() -> long \{ return this.id; \}\n"
        + "    protected override equals(Key other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class Quiet \{\n"
        + "    int id;\n"
        + "    protected constructor(this.id);\n"
        + "    override hash() -> long \{ return this.id; \}\n"
        + "    override equals(Quiet other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Method 'toString' replaces the built-in text form of struct 'Point', so it must be as "
        + "visible as 'Point' itself. Mark it 'public'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 2L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Method 'hash' replaces the built-in identity hash of class 'Key', so it must be as "
        + "visible as 'Key' itself. Mark it 'public'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Method 'equals' replaces the built-in identity equality of class 'Key', so it must be as "
        + "visible as 'Key' itself. Mark it 'public'.");
}

test "a field refuses every modifier but visibility, 'weak', 'const', and 'static'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box \{\n"
        + "    abstract int first = 0;\n"
        + "    override int second = 0;\n"
        + "    final int third = 0;\n"
        + "    noreturn int fifth = 0;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    sealed int fourth = 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 4L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'first' cannot be 'abstract'; 'abstract' is for a method with no body, which each "
        + "subclass then writes for itself. Remove 'abstract'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'second' cannot be 'override'; 'override' is for a method that replaces one the "
        + "type inherits. Remove 'override'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Field 'third' cannot be 'final'; 'final' stops a method from being overridden or a class "
        + "from being extended. Remove 'final'.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "Field 'fifth' cannot be 'noreturn'; 'noreturn' goes on a function or method that never "
        + "finishes normally, because it always throws or calls 'panic'. Remove 'noreturn'.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'fourth' cannot be 'sealed'; 'sealed' goes on a class, where it means only the same "
        + "module can extend it. Remove 'sealed'.");
}

test "no callable carries 'weak', 'sealed', or 'const', wherever it is declared" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    weak speak() -> string;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    sealed describe() -> int \{ return this.x; \}\n"
        + "\}\n"
        + "class Box \{\n"
        + "    const constructor();\n"
        + "    weak destructor() \{ \}\n"
        + "    sealed poke() -> int \{ return 1; \}\n"
        + "\}\n"
        + "const helper() -> int \{ return 2; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 3L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Method 'speak' cannot be 'weak'; 'weak' goes on a class field that refers to an object "
        + "without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Method 'describe' cannot be 'sealed'; 'sealed' goes on a class, where it means only the "
        + "same module can extend it. Remove 'sealed'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Function 'helper' cannot be 'const'; 'const' goes on a field or a variable inside a "
        + "function, as in 'const string name;' or 'const limit = 10;'. Remove 'const'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 3L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "The constructor of 'Box' cannot be 'const'; 'const' goes on a field or a variable inside "
        + "a function, as in 'const string name;' or 'const limit = 10;'. Remove 'const'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "The destructor of 'Box' cannot be 'weak'; 'weak' goes on a class field that refers to an "
        + "object without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Method 'poke' cannot be 'sealed'; 'sealed' goes on a class, where it means only the same "
        + "module can extend it. Remove 'sealed'.");
}

test "a top-level function refuses the dispatch markers nothing could inherit" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "override first() -> int \{ return 1; \}\n"
        + "final second() -> int \{ return 2; \}\n"
        + "abstract third() -> int \{ return 3; \}\n"
        + "static fourth() -> int \{ return 4; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'first' cannot be 'override'; 'override' is for a method that replaces one the "
        + "type inherits. Remove 'override'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Function 'second' cannot be 'final'; 'final' stops a method from being overridden or a "
        + "class from being extended. Remove 'final'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Function 'third' cannot be 'abstract'; 'abstract' is for a method with no body, which "
        + "each subclass then writes for itself. Remove 'abstract'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Function 'fourth' cannot be 'static'; 'static' goes on a method or a 'const' field of a "
        + "class or a struct, where it makes the member belong to the type itself; a top-level "
        + "function already belongs to no instance. Remove 'static'.");
}

test "a member of a file-private type marked 'public' or 'export' is refused with its fix" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Helper \{\n"
        + "    public int value = 0;\n"
        + "    export static const int LIMIT = 10;\n"
        + "    public constructor();\n"
        + "    export doubled() -> int \{ return this.value * 2; \}\n"
        + "    public static make() -> Helper \{ return new Helper(); \}\n"
        + "\}\n"
        + "struct Spot \{\n"
        + "    export int x;\n"
        + "    public constructor(this.x);\n"
        + "\}\n"
        + "public class Meter \{\n"
        + "    public constructor();\n"
        + "    public reading() -> int \{ return 1; \}\n"
        + "\}\n"
        + "class Needle extends Meter \{\n"
        + "    constructor();\n"
        + "    public override reading() -> int \{ return 7; \}\n"
        + "\}\n"
        + "public class Counter \{\n"
        + "    export long count = 0;\n"
        + "    export constructor();\n"
        + "    export bump() \{ this.count = this.count + 1; \}\n"
        + "\}\n"
        + "use() -> int \{\n"
        + "    return new Helper().value + Helper.LIMIT + Helper.make().doubled() + Spot(1).x;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 2L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'x' cannot be 'export' while 'Spot' is private to its file, because a member is "
        + "never more visible than the type that declares it. Remove 'export'. An unmarked member "
        + "of 'Spot' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "The constructor of 'Spot' cannot be 'public' while 'Spot' is private to its file, because "
        + "a member is never more visible than the type that declares it. Remove 'public'. An "
        + "unmarked member of 'Spot' can already be used anywhere in its file.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 9L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'value' cannot be 'public' while 'Helper' is private to its file, because a member "
        + "is never more visible than the type that declares it. Remove 'public'. An unmarked "
        + "member of 'Helper' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'LIMIT' cannot be 'export' while 'Helper' is private to its file, because a member "
        + "is never more visible than the type that declares it. Remove 'export'. An unmarked "
        + "member of 'Helper' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "The constructor of 'Helper' cannot be 'public' while 'Helper' is private to its file, "
        + "because a member is never more visible than the type that declares it. Remove 'public'. "
        + "An unmarked member of 'Helper' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "Method 'doubled' cannot be 'export' while 'Helper' is private to its file, because a "
        + "member is never more visible than the type that declares it. Remove 'export'. An "
        + "unmarked member of 'Helper' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 4, "/proj/src/app.ens",
        "Method 'make' cannot be 'public' while 'Helper' is private to its file, because a member "
        + "is never more visible than the type that declares it. Remove 'public'. An unmarked "
        + "member of 'Helper' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 5, "/proj/src/app.ens",
        "Override 'reading' cannot be 'public' while 'Needle' is private to its file, because a "
        + "member is never more visible than the type that declares it. Remove 'public'. An "
        + "unmarked member of 'Needle' can already be used anywhere in its file.");
    try sema_support.assertDiagnostic(layout, 6, "/proj/src/app.ens",
        "Field 'count' cannot be 'export' while 'Counter' is only 'public', because a member is "
        + "never more visible than the type that declares it. Replace 'export' with 'public', or "
        + "mark 'Counter' 'export' too.");
    try sema_support.assertDiagnostic(layout, 7, "/proj/src/app.ens",
        "The constructor of 'Counter' cannot be 'export' while 'Counter' is only 'public', because "
        + "a member is never more visible than the type that declares it. Replace 'export' with "
        + "'public', or mark 'Counter' 'export' too.");
    try sema_support.assertDiagnostic(layout, 8, "/proj/src/app.ens",
        "Method 'bump' cannot be 'export' while 'Counter' is only 'public', because a member is "
        + "never more visible than the type that declares it. Replace 'export' with 'public', or "
        + "mark 'Counter' 'export' too.");
}

test "a written 'private' is refused with how far the unmarked member already reaches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Helper \{\n"
        + "    private int value = 0;\n"
        + "    private constructor();\n"
        + "\}\n"
        + "public class Vault \{\n"
        + "    private int code = 0;\n"
        + "    private constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A member of 'Helper' can be used anywhere in the file that declares 'Helper', so "
        + "'private' is never written. Remove it from 'value'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "A member of 'Helper' can be used anywhere in the file that declares 'Helper', so "
        + "'private' is never written. Remove it from the constructor of 'Helper'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A member is private to its type unless it is marked, so 'private' is never written. "
        + "Remove it from 'code'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "A member is private to its type unless it is marked, so 'private' is never written. "
        + "Remove it from the constructor of 'Vault'.");
}

test "an override on a 'public' class is held to its base method and to the class's reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "export class Wide \{\n"
        + "    export constructor();\n"
        + "    export greet() -> int \{ return 1; \}\n"
        + "    public wave() -> int \{ return 2; \}\n"
        + "    export spin() -> int \{ return 3; \}\n"
        + "\}\n"
        + "public class Counter extends Wide \{\n"
        + "    public constructor();\n"
        + "    export override greet() -> int \{ return 6; \}\n"
        + "    export override wave() -> int \{ return 7; \}\n"
        + "    protected override spin() -> int \{ return 8; \}\n"
        + "\}\n"
        + "public class Plain extends Wide \{\n"
        + "    public constructor();\n"
        + "    override spin() -> int \{ return 9; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Override 'greet' cannot be 'export' while 'Counter' is only 'public', because a member is "
        + "never more visible than the type that declares it. Replace 'export' with 'public', or "
        + "mark 'Counter' 'export' too.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Override 'wave' cannot be 'export' while 'Counter' is only 'public', because a member is "
        + "never more visible than the type that declares it. Replace 'export' with 'public', the "
        + "visibility of the 'wave' it overrides in 'Wide'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Override 'spin' must be 'public', because the 'spin' it overrides in 'Wide' is 'export' "
        + "and 'Counter' is only 'public'. Replace 'protected' with 'public'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Override 'spin' must be 'public', because the 'spin' it overrides in 'Wide' is 'export' "
        + "and 'Plain' is only 'public'. Mark it 'public'.");
}

test "a written 'private' on a method replacing a built-in behavior names the type it follows" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Mark \{\n"
        + "    public int value = 0;\n"
        + "    private override toString() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "public class Seal \{\n"
        + "    public constructor();\n"
        + "    private override toString() -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "'toString' takes the visibility of 'Mark', so 'private' is never written. Remove it from "
        + "'toString'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "'toString' takes the visibility of 'Seal', so 'private' is never written. Remove it from "
        + "'toString'.");
}

test "a repeated visibility mark names the first, and a private abstract method is reported once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Visible \{\n"
        + "    public protected greet() \{ \}\n"
        + "    public public constructor() \{ \}\n"
        + "\}\n"
        + "public abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    abstract go();\n"
        + "\}\n"
        + "public class Square extends Shape \{\n"
        + "    public constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    override go() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'greet' is already marked 'public'. A declaration takes one visibility modifier. Remove "
        + "'protected'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The constructor of 'Visible' is already marked 'public'. A declaration takes one "
        + "visibility modifier. Remove this second 'public'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Abstract method 'go' is private to 'Shape', so no subclass can implement it. Mark it 'protected'.");
}

test "a missing body, a second class bound, and a destructor's markers name what applies there" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Rock \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder<T: Shape> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Free<W: Rock> \{\n"
        + "    Holder<W>? held;\n"
        + "\}\n"
        + "class Other \{\n"
        + "    constructor();\n"
        + "    public override destructor() \{ \}\n"
        + "\}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Speaker plainSeen;\n"
        + "    constructor(this.plainSeen);\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    poke();\n"
        + "    static make() -> Point;\n"
        + "\}\n"
        + "loose() -> int;\n"
        + "go() throws;\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 5L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Type argument 'W' for type parameter 'T' of 'Holder' must be 'Shape' or a subclass of it. "
        + "'W' already has the class bound 'Rock', and a type parameter takes one class bound. "
        + "Replace 'Rock' with 'Shape' or a class that extends 'Shape'.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "'poke' has no body; it ends in ';'. Only a constructor can leave out its body. Replace the "
        + "';' with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "'make' has no body; it ends in ';'. A static method always needs a body. Replace the ';' "
        + "with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 3, "/proj/src/app.ens",
        "'loose' has no body; it ends in ';'. A function outside a class or a struct always needs a "
        + "body. Replace the ';' with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 4, "/proj/src/app.ens",
        "'go' has no body; it ends in ';'. A function outside a class or a struct always needs a "
        + "body. Replace the ';' with a body between '\{' and '\}'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 3L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'public'. No code calls a destructor; it runs when the "
        + "object is destroyed. Remove 'public'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Field 'plainSeen' of class 'Watcher' is 'weak', so its type must be a class. 'Speaker' is "
        + "an interface. Replace 'Speaker' with a class that implements 'Speaker', and add '?' "
        + "after it.");
}

test "a constructor or destructor marker is refused at the marker word" {
    let loader = new FakeFileLoader();
    string source = "class Seventh \{\n"
        + "    final constructor();\n"
        + "\}\n"
        + "class Eighth \{\n"
        + "    constructor();\n"
        + "    final destructor() \{ \}\n"
        + "\}\n"
        + "class Ninth \{\n"
        + "    override constructor();\n"
        + "\}\n"
        + "class Tenth \{\n"
        + "    constructor();\n"
        + "    override destructor() \{ \}\n"
        + "\}\n"
        + "class Eleventh \{\n"
        + "    constructor();\n"
        + "    abstract destructor() \{ \}\n"
        + "\}\n"
        + "class Twelfth \{\n"
        + "    abstract constructor();\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 6L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The constructor of 'Seventh' cannot be 'final'. 'final' stops a subclass from replacing a "
        + "method, and no subclass replaces a constructor. Remove 'final'.");
    try testing.assertEqual(found[0].span().start, source.indexOf("final constructor"));
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The destructor of 'Eighth' cannot be 'final'. No destructor replaces another: when an object "
        + "is destroyed, its own class's destructor and every base class's destructor run. Remove "
        + "'final'.");
    try testing.assertEqual(found[1].span().start, source.indexOf("final destructor"));
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "The constructor of 'Ninth' cannot be 'override'. A constructor never replaces the "
        + "constructor of a base class. Remove 'override'.");
    try testing.assertEqual(found[2].span().start, source.indexOf("override constructor"));
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "The destructor of 'Tenth' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try testing.assertEqual(found[3].span().start, source.indexOf("override destructor"));
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "The destructor of 'Eleventh' cannot be 'abstract'. No destructor replaces another: when "
        + "an object is destroyed, its own class's destructor and every base class's destructor "
        + "run. Remove 'abstract'.");
    try testing.assertEqual(found[4].span().start, source.indexOf("abstract destructor"));
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "The constructor of 'Twelfth' cannot be 'abstract'. 'abstract' marks a method each "
        + "subclass writes for itself, and a subclass never writes its base class's constructor. "
        + "Remove 'abstract'.");
    try testing.assertEqual(found[5].span().start, source.indexOf("abstract constructor"));
}

test "an interface method named 'hash' is held to the one shape a Map or Set calls" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens", "interface Keyed \{\n"
        + "    hash() -> int;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'hash' of interface 'Keyed' returns 'int'. A Map or Set calls 'hash()' to find a "
        + "key. An interface method named 'hash' must be 'hash() -> long'. Write 'hash() -> long', "
        + "or rename the method.");
}

test "a struct's toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Shaped \{\n"
        + "    int x;\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "public struct Throwing \{\n"
        + "    int x;\n"
        + "    public override toString() -> string throws Error \{ return \"t\"; \}\n"
        + "\}\n"
        + "public struct Unmarked \{\n"
        + "    int x;\n"
        + "    public toString() -> string \{ return \"u\"; \}\n"
        + "\}\n"
        + "struct Following \{\n"
        + "    int x;\n"
        + "    override toString() -> string \{ return \"f\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'toString' of struct 'Unmarked' replaces the built-in text form but is not marked "
        + "'override'. Write 'override' before 'toString'.");
    // 'Shaped' takes an argument, so it is an ordinary method, and a struct has no ordinary
    // method to override. The refusal says which of the two reasons its marker failed on.
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Method 'toString' of 'Shaped' is marked 'override', and a struct inherits nothing to "
        + "override; a 'toString' that takes parameters is an ordinary method rather than the "
        + "struct's text form. Remove 'override'.");
}

// A subclass does inherit the base class's instance fields, so a static of that name collides with
// an instance member the subclass has.
test "a subclass static may not share a name with a base class instance field" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public int limit;\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public static const int limit = 7;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a field of 'Quota'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// A subclass does inherit the base class's methods, so a static of that name collides with an
// instance member the subclass has.
test "a subclass static may not share a name with a base class instance method" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public limit() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public static limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a method of 'Quota'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// An instance method of the type itself collides under the same rule, and the message names the
// owner.
test "a static may not share a name with an instance method of its own type" {
    let analysis = sema_support.analyzeProgram(
        "public class Allowance \{\n"
        + "    public limit() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\n"
        + "    public static limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a method of 'Allowance'; a static and an "
        + "instance member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

test "a lazy const field refuses 'static', a missing 'const', and a missing initializer" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Refused \{\n"
        + "    public static lazy const long both = 1;\n"
        + "    public lazy long unmarked = 2;\n"
        + "    public lazy const long missing;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "A 'lazy const' field already belongs to the type itself, so it cannot also be 'static'. "
        + "Remove 'static'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "A 'lazy' field must also be 'const'; its value is built once on the first read and "
        + "never changes. Write 'lazy const long unmarked = ...', or make 'unmarked' an "
        + "instance field.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Lazy const 'missing' needs its value on the declaration, because nothing else ever "
        + "assigns it. Write 'lazy const long missing = ...'.");
    try testing.assertEqual(reported.length, 3L);
}

test "noreturn rejects a return type and a return statement" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn withType() -> int \{\n"
        + "    panic(\"x\");\n"
        + "\}\n"
        + "noreturn usesReturn() \{\n"
        + "    return;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Bodies]);
    let signatures = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "A 'noreturn' function never returns a value, so it declares no return type. Remove the "
        + "'-> ...' clause after the parameter list.");
    try testing.assertEqual(signatures.length, 1L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/app.ens",
        "Function 'usesReturn' is 'noreturn', so it never returns and cannot contain 'return'. Throw, "
        + "call 'panic' or call another 'noreturn' function instead.");
    try testing.assertEqual(bodies.length, 1L);
}

test "noreturn is illegal on constructors and destructors" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    noreturn constructor() \{ panic(\"x\"); \}\n"
        + "    noreturn destructor() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "The constructor of 'Widget' cannot be marked 'noreturn'. A constructor always returns the "
        + "new object. Remove 'noreturn'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/app.ens",
        "The destructor of 'Widget' cannot be marked 'noreturn'. A destructor runs when the object "
        + "is destroyed, and it always returns. Remove 'noreturn'.");
    try testing.assertEqual(reported.length, 2L);
}
