import @std.testing;
import ProgramAnalysis from pipeline;
import FileDiagnostic from support.diagnostics;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    return analysis;
}

assertOne(ProgramAnalysis analysis, string message) throws {
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", message);
}

errorPrefix() -> string {
    return "class DatabaseError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "query() -> int throws \{\n"
        + "    throw new DatabaseError(\"q\");\n"
        + "\}\n";
}

test "a throwing call without try names the types and the fixes" {
    let analysis = try analyzeOne(errorPrefix()
        + "caller() -> int throws \{\n"
        + "    return query();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try caller();\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and "
    + "either catch it with a 'catch' clause or mark this function 'throws'.");
}

test "try on a call that cannot throw is rejected" {
    let analysis = try analyzeOne("safe() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try safe();\n"
        + "\}\n");
    try assertOne(analysis, "'try' is not needed here: 'safe' cannot throw. Remove 'try'.");
}

test "an unmarked function that can throw must be marked or handle it" {
    let analysis = try analyzeOne(errorPrefix()
        + "caller() -> int \{\n"
        + "    return try query();\n"
        + "\}\n");
    try assertOne(analysis, "'caller' can throw 'DatabaseError' but is not marked 'throws'. Add "
    + "'throws DatabaseError' after the signature, or catch it with a 'catch' clause after the "
    + "body.");
}

test "a bare throws marker on a function that cannot throw is rejected" {
    let analysis = try analyzeOne("safe() -> int throws \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "'safe' is marked 'throws' but cannot throw; remove 'throws'.");
}

test "a declared throws list must cover the computed set" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "    protected abstract read() -> int throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read() -> int throws IoError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "'read' can throw 'NetError', which its 'throws' list does not name. "
    + "Add it to the list, or catch it with a 'catch' clause.");
}

test "an override may not widen the base contract" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected constructor();\n"
        + "    protected abstract read() -> int throws IoError;\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    protected override read() -> int throws NetError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Override 'read' can throw 'NetError', which the 'read' it overrides "
    + "in 'Base' does not list. An override throws only what the method it overrides allows.");
}

test "an implementing method may not widen the interface contract" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "interface Store \{\n"
        + "    save() -> int throws IoError;\n"
        + "\}\n"
        + "class DiskStore implements Store \{\n"
        + "    constructor();\n"
        + "    protected override save() -> int throws NetError \{\n"
        + "        throw new NetError(\"n\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Method 'save' of 'DiskStore' can throw 'NetError', which the 'save' "
    + "declared by interface 'Store' does not list. An implementing method throws only what the "
    + "interface lists.");
}

test "a catch clause the body can never reach with its type is dead" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class ParseError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "load() -> int throws \{\n"
        + "    throw new IoError(\"x\");\n"
        + "\}\n"
        + "run() -> int \{\n"
        + "    return try load();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 0;\n"
        + "\} catch (ParseError e) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "This 'catch (ParseError ...)' never runs: the body of 'run' cannot "
    + "throw 'ParseError' or a subclass of it. Remove the clause.");
}

test "a catch clause behind a broader one is unreachable" {
    let analysis = try analyzeOne(errorPrefix()
        + "run() -> int \{\n"
        + "    return try query();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\} catch (DatabaseError e) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "This 'catch (DatabaseError ...)' is unreachable: an earlier 'catch' "
    + "clause already handles it. Move it above that clause, or remove it.");
}

test "catch clauses on a body that cannot throw are redundant" {
    let analysis = try analyzeOne("run() -> int \{\n"
        + "    return 1;\n"
        + "\} catch (Error e) \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return run();\n"
        + "\}\n");
    try assertOne(analysis, "'run' has 'catch' clauses but its body cannot throw; "
        + "remove them.");
}

test "a constructor must not let exceptions escape" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class Resource \{\n"
        + "    protected constructor() \{\n"
        + "        throw new IoError(\"x\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let resource = new Resource();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Constructor of 'Resource' cannot let exceptions escape, but "
        + "it can throw 'IoError'. Catch the exceptions with 'catch' clauses after the "
        + "constructor body.");
}

test "a destructor must not let exceptions escape" {
    let analysis = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class Resource \{\n"
        + "    protected constructor();\n"
        + "    destructor() \{\n"
        + "        throw new IoError(\"x\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let resource = new Resource();\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "Destructor of 'Resource' cannot let exceptions escape, but "
        + "it can throw 'IoError'. Catch the exceptions with 'catch' clauses after the "
        + "destructor body.");
}

test "a parameter default must not call a throwing function" {
    let analysis = try analyzeOne(errorPrefix()
        + "use(int value = query()) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return use(1);\n"
        + "\}\n");
    try assertOne(analysis, "A default value cannot call 'query' because it can throw "
        + "'DatabaseError'; it must not throw.");
}

test "a field default must not call a throwing function" {
    let analysis = try analyzeOne(errorPrefix()
        + "class Config \{\n"
        + "    int port = query();\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(analysis, "A field default cannot call 'query' because it can throw "
        + "'DatabaseError'; it must not throw.");
}

test "only Error or a subclass can be caught" {
    let analysis = try analyzeOne("class Widget \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "run() -> int throws \{\n"
        + "    throw new IoError(\"x\");\n"
        + "\} catch (Widget w) \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try run();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    try assertOne(analysis, "Cannot catch 'Widget'; only 'Error' or a subclass of it can "
        + "be caught.");
}

test "a test body validates try usage" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main_test.ens", errorPrefix()
        + "test \"calls need try here too\" \{\n"
        + "    int value = query();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    let diagnostics = analysis.exceptionDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main_test.ens",
        "Call to 'query' can throw 'DatabaseError'. Prefix it with 'try', and either catch it with "
        + "a 'catch' clause or mark this function 'throws'.");
}

test "a thrown type parameter must be declared or listed like any other exception" {
    let unmarked = try analyzeOne("forward<E: Error>(E error) \{\n"
        + "    throw error;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(unmarked, "'forward' can throw 'E' but is not marked 'throws'. Add 'throws E' "
    + "after the signature, or catch it with a 'catch' clause after the body.");
    let mislisted = try analyzeOne("class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "forward<E: Error>(E error) throws IoError \{\n"
        + "    throw error;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try assertOne(mislisted, "'forward' can throw 'E', which its 'throws' list does not name. Add "
    + "it to the list, or catch it with a 'catch' clause.");
}

// A caller holding the 'try' and the 'catch' that a call to the callee would need.
unresolvedCaller(string callee) -> string {
    return "caller() -> int \{\n"
        + "    return try {callee}();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n";
}

// The diagnostics of the signatures stage, after every other stage accepted the program.
signatureProblems(FakeFileLoader loader) -> FileDiagnostic[] throws {
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    return analysis.signatureDiagnostics();
}

test "a misspelled throws entry is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "misspelled() -> int throws Unknwon \{\n"
        + "    throw new Failure(\"f\");\n"
        + "\}\n"
        + unresolvedCaller("misspelled"));
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
}

test "a module-qualified throws entry is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public class Failure extends Error \{\n"
        + "    public constructor(string m) \{ super(m); \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import parts;\n"
        + "class Other extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "qualified() -> int throws parts.Failure \{\n"
        + "    throw new Other(\"o\");\n"
        + "\}\n"
        + unresolvedCaller("qualified"));
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.Failure' reaches a type through its module, and a module name reaches only "
        + "functions. Write 'import Failure from parts;' and use 'Failure'.");
}

test "a throws entry naming another module's private type raises no exceptions problem" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "class Hidden extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Hidden from parts;\n"
        + "class Other extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "guarded() -> int throws Hidden \{\n"
        + "    throw new Other(\"o\");\n"
        + "\}\n"
        + unresolvedCaller("guarded"));
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link, Stage.Signatures]);
    let refused = analysis.linkDiagnostics();
    try testing.assertEqual(refused.length, 1L);
    try sema_support.assertDiagnostic(refused, 0, "/proj/src/main.ens",
        "Type 'Hidden' is private to module 'parts', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
    let unresolved = analysis.signatureDiagnostics();
    try testing.assertEqual(unresolved.length, 1L);
    try sema_support.assertDiagnostic(unresolved, 0, "/proj/src/main.ens",
        "Unknown type 'Hidden'. Check the spelling, or import the module that declares it.");
}

test "a body throw is named by a throws list with an unresolved entry, whose other entries stay checked" {
    string errors = "class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n";
    let covered = new FakeFileLoader();
    covered.add("/proj/src/main.ens", errors
        + "fetch() -> int throws Unknwon, IoError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "caller() -> int \{\n"
        + "    return try fetch();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n");
    let reported = try signatureProblems(covered);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let repeated = new FakeFileLoader();
    repeated.add("/proj/src/main.ens", errors
        + "fetch() -> int throws Unknwon, IoError, IoError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try fetch();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(repeated, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let unresolved = analysis.signatureDiagnostics();
    try testing.assertEqual(unresolved.length, 1L);
    try sema_support.assertDiagnostic(unresolved, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 1L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "Declared throws type 'IoError' overlaps with another type in the list; list each exception once.");
}

test "a call through a function value whose throws list did not resolve needs its try" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "run((() -> void throws Unknwon) body) \{\n"
        + "    try body();\n"
        + "\} catch (Failure e) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
}

// A function whose 'throws' list does not resolve, and whose body throws a declared 'Failure'.
misspelledThrower() -> string {
    return "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "misspelled() -> int throws Unknwon \{\n"
        + "    throw new Failure(\"f\");\n"
        + "\}\n";
}

// The one exceptions diagnostic of a program whose only other problem is the unknown type
// 'Unknwon'.
exceptionBesideUnknwon(string text) -> FileDiagnostic throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Exceptions]);
    let unresolved = analysis.signatureDiagnostics();
    try testing.assertEqual(unresolved.length, 1L);
    try sema_support.assertDiagnostic(unresolved, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let reported = analysis.exceptionDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    return reported[0];
}

test "a catch of Error handles a call whose throws list did not resolve" {
    let tried = try exceptionBesideUnknwon(misspelledThrower()
        + "caller() -> int \{\n"
        + "    return try misspelled();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try caller();\n"
        + "\}\n");
    try testing.assertEqual(tried.message(),
        "'try' is not needed here: 'caller' cannot throw. Remove 'try'.");
    let marked = try exceptionBesideUnknwon(misspelledThrower()
        + "caller() -> int throws \{\n"
        + "    return try misspelled();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(marked.message(),
        "'caller' is marked 'throws' but cannot throw; remove 'throws'.");
}

test "a call to a function marked throws needs try when its throws list did not resolve" {
    let reported = try exceptionBesideUnknwon(misspelledThrower()
        + "main() -> int \{\n"
        + "    return misspelled();\n"
        + "\}\n");
    try testing.assertEqual(reported.message(),
        "Call to 'misspelled' can throw, because it is marked 'throws'. Prefix it with 'try', "
        + "and either catch it with a 'catch' clause or mark this function 'throws'.");
}

test "a call to an undefined function is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "caller() \{\n"
        + "    try nope();\n"
        + "\} catch (Failure e) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Undefined function 'nope'. Check the spelling, or import the module that declares it.");
}
