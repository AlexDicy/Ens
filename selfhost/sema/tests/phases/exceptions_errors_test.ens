import @std.testing;
import FileDiagnostic from support.diagnostics;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

// A caller holding the 'try' and the 'catch' that a call to the callee would need.
unresolvedCaller(string callee) -> string {
    return "caller() -> int \{\n"
        + "    return try {callee}();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n";
}

// The diagnostics of the signatures stage, after every other stage accepted the program.
signatureProblems(FakeFileLoader loader) -> FileDiagnostic[] throws {
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    return analysis.signatureDiagnostics();
}

test "a misspelled throws entry is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "misspelled() -> int throws Unknwon \{\n"
        + "    throw new Failure(\"f\");\n"
        + "\}\n"
        + unresolvedCaller("misspelled"));
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
}

test "a module-qualified throws entry is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public class Failure extends Error \{\n"
        + "    public constructor(string m) \{ super(m); \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import parts;\n"
        + "class Other extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "qualified() -> int throws parts.Failure \{\n"
        + "    throw new Other(\"o\");\n"
        + "\}\n"
        + unresolvedCaller("qualified"));
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.Failure' writes a type after a module name, and only a function can be written "
        + "after a module name. Write 'import Failure from parts;' and then write 'Failure'.");
}

test "a throws entry naming another module's private type is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "class Hidden extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Hidden from parts;\n"
        + "class Other extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "guarded() -> int throws Hidden \{\n"
        + "    throw new Other(\"o\");\n"
        + "\}\n"
        + unresolvedCaller("guarded"));
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let refused = analysis.linkDiagnostics();
    try testing.assertEqual(refused.length, 1L);
    try sema_support.assertDiagnostic(refused, 0, "/proj/src/main.ens",
        "Type 'Hidden' is private to module 'parts', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
}

test "a body throw is named by a throws list with an unresolved entry, whose other entries stay checked" {
    string errors = "class IoError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "class NetError extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n";
    let covered = new FakeFileLoader();
    covered.add("/proj/src/main.ens", errors
        + "fetch() -> int throws Unknwon, IoError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "caller() -> int \{\n"
        + "    return try fetch();\n"
        + "\} catch (IoError e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n");
    let reported = try signatureProblems(covered);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let repeated = new FakeFileLoader();
    repeated.add("/proj/src/main.ens", errors
        + "fetch() -> int throws Unknwon, IoError, IoError \{\n"
        + "    throw new NetError(\"n\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try fetch();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(repeated, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let unresolved = analysis.signatureDiagnostics();
    try testing.assertEqual(unresolved.length, 1L);
    try sema_support.assertDiagnostic(unresolved, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 1L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "The 'throws' list names 'IoError' twice. Remove this second 'IoError'.");
}

test "a call through a function value whose throws list did not resolve needs its try" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "run((() -> void throws Unknwon) body) \{\n"
        + "    try body();\n"
        + "\} catch (Failure e) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Unknown type 'Unknwon'. Check the spelling, or import the module that declares it.");
}

test "a call to an undefined function is the one problem reported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Failure extends Error \{\n"
        + "    protected constructor(string m) \{ super(m); \}\n"
        + "\}\n"
        + "caller() \{\n"
        + "    try nope();\n"
        + "\} catch (Failure e) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Undefined function 'nope'. Check the spelling, or import the module that declares it.");
}

test "a type that is not an Error is refused once, in a throws list and in a throw" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Widget \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "fetch() -> int throws Widget \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "thrower() \{\n"
        + "    throw new Widget();\n"
        + "\}\n"
        + "caller() -> int \{\n"
        + "    thrower();\n"
        + "    return try fetch();\n"
        + "\} catch (Error e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return caller();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let listed = analysis.checkDiagnostics();
    try testing.assertEqual(listed.length, 1L);
    try sema_support.assertDiagnostic(listed, 0, "/proj/src/main.ens",
        "A declared throws type must be 'Error' or a subclass of it, and 'Widget' is neither. "
        + "Remove 'Widget' from the 'throws' list, or replace it with a class that extends "
        + "'Error'.");
    let thrown = analysis.bodyDiagnostics();
    try testing.assertEqual(thrown.length, 1L);
    try sema_support.assertDiagnostic(thrown, 0, "/proj/src/main.ens",
        "Cannot throw a value of type 'Widget'. Only an 'Error', or an object of a subclass of 'Error', "
            + "can be thrown.");
}

test "a function marked throws passes on what a call whose list did not resolve raises" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", sema_support.misspelledThrower()
        + "caller() -> int throws \{\n"
        + "    return try misspelled();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return try caller();\n"
        + "\} catch (Error e) \{\n"
        + "    return 1;\n"
        + "\}\n");
    let reported = try signatureProblems(loader);
    try testing.assertEqual(reported.length, 1L);
}

test "a thrown type parameter with no bound under Error is refused once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "unbounded<T>(T value) \{\n"
        + "    throw value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot throw 'value', because its type 'T' is a type parameter without the bound 'Error'. "
        + "Declare it as '<T: Error>' in 'unbounded'.");
}
