    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Override 'run' can throw 'NetError', which the 'run' it overrides in 'Base' does not list. An "
        + "override throws only what the method it overrides allows. Catch it with a 'catch' clause "
