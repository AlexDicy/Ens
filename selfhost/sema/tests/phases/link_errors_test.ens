import @std.testing;
import FakeFileLoader from sema_support;
import sema_support;
import Stage from sema_support;

test "importing a missing name reports what the module actually offers" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import Missing from lib.box;\n");
    loader.add("/proj/src/lib/box.ens", "public class Box \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.box' has no type named 'Missing'. Check the spelling, "
            + "or import 'Missing' from the module that declares it.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

test "importing a function by name steers to the namespace form" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import doubled from lib.box;\n");
    loader.add("/proj/src/lib/box.ens", "public doubled(int x) -> int \{ return x * 2; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Only a type can be imported by name, and 'doubled' is a function. "
        + "Write 'import lib.box;' and call it as 'box.doubled(...)'.");
}

test "importing a package function by name keeps the package form in the suggestion" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/main.ens", "import greet from @acme.tools;\n");
    loader.add("/proj/vendor/acme/src/tools.ens", "public greet() \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Only a type can be imported by name, and 'greet' is a function. "
        + "Write 'import @acme.tools;' and call it as 'tools.greet(...)'.");
}

test "importing an external function by name is diagnosed like any function" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import ReadFile from lib.native;\n");
    loader.add("/proj/src/lib/native.ens",
        "external from kernel32 \{\n    ReadFile(int handle) -> int;\n\}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Only a type can be imported by name, and 'ReadFile' is a function. "
        + "Write 'import lib.native;' and call it as 'native.ReadFile(...)'.");
}

test "importing a private type is rejected with its module named" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import Secret from lib.secret;\n");
    loader.add("/proj/src/lib/secret.ens",
        "class Secret \{ \}\npublic class Gadget \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Type 'Secret' is private to module 'lib.secret', so only that file "
        + "can use it. Mark 'Secret' as 'public' to use it from other modules in the package.");
}

test "importing a public type from another package requires export" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\nimport Motor from @acme.parts;\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "public class Gear \{ \}\nexport class Motor \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Type 'Gear' is public inside package 'acme' but not exported. "
        + "Change 'public' to 'export' on 'Gear' in module '@acme.parts' to use it from another "
        + "package.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Motor")
        == pipeline.store().findDeclared("acme.parts", "Motor"),
        "an export type should bind across the package boundary");
}

test "a private type imported cross-package suggests export" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/main.ens", "import Coil from @acme.parts;\n");
    loader.add("/proj/vendor/acme/src/parts.ens", "class Coil \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Type 'Coil' is private to module '@acme.parts', so only that file "
        + "can use it. Mark 'Coil' as 'export' to use it from another package.");
}

test "two imports binding the same name conflict, and the first binding survives" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import Box from lib.first;\nimport Box from lib.second;\n");
    loader.add("/proj/src/lib/first.ens", "public class Box \{ \}\n");
    loader.add("/proj/src/lib/second.ens", "public class Box \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "'Box' is already imported earlier in this file. Remove this import, "
        + "or give it another name with 'as', as in 'import Box as OtherBox from lib.second;'.");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Box")
        == pipeline.store().findDeclared("lib.first", "Box"),
        "the first import should keep the name");
}

test "two namespace imports sharing a last segment conflict" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import lib.util;\nimport other.util;\n");
    loader.add("/proj/src/lib/util.ens", "");
    loader.add("/proj/src/other/util.ens", "");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens",
        "'util' is already imported earlier in this file. Remove this import, or give it another "
            + "name with 'as', as in 'import other.util as utilModule;'.");
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "main", "util"),
        "lib.util");
}

test "link diagnostics order by file and then offset" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import helper;\n"
        + "import Missing from lib.box;\n"
        + "import Secret from lib.box;\n");
    loader.add("/proj/src/helper.ens", "import doubled from lib.box;\n");
    loader.add("/proj/src/lib/box.ens",
        "class Secret \{ \}\npublic doubled(int x) -> int \{ return x; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try testing.assertEqual(diagnostics.length, 3L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/helper.ens",
        "Only a type can be imported by name, and 'doubled' is a function. Write 'import lib.box;' "
        + "and call it as 'box.doubled(...)'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module 'lib.box' has no type named 'Missing'. Check the spelling, or import 'Missing' "
            + "from the module that declares it.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "Type 'Secret' is private to module 'lib.box', so only that file can use it. Mark 'Secret' as "
        + "'public' to use it from other modules in the package.");
}

test "an alias collides with the file's other imports under the existing messages" {
    let loader = new FakeFileLoader();
    string source = "import lib.sizes;\n"
        + "import lib.colors as sizes;\n"
        + "import Kind from lib.sizes;\n"
        + "import Other as Kind from lib.colors;\n"
        + "import Kind as Sort from lib.sizes;\n"
        + "import Kind as Sort from lib.colors;\n";
    loader.add("/proj/src/main.ens", source);
    loader.add("/proj/src/lib/sizes.ens", "public enum Kind \{ Small \}\n");
    loader.add("/proj/src/lib/colors.ens",
        "public enum Kind \{ Red \}\npublic class Other \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try testing.assertEqual(diagnostics.length, 3L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'sizes' is already imported earlier in this file. Remove this import, or give it another "
            + "name with 'as', as in 'import lib.colors as sizesModule;'.");
    try testing.assertEqual(source.substring(diagnostics[0].span().start,
        diagnostics[0].span().end()), "sizes");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'Kind' is already imported earlier in this file. Remove this import, or give it another "
            + "name with 'as', as in 'import Other as OtherKind from lib.colors;'.");
    try testing.assertEqual(diagnostics[1].span().start, source.indexOf("Kind from lib.colors"));
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "'Sort' is already imported earlier in this file. Remove this import, or give it another "
            + "name with 'as', as in 'import Kind as OtherSort from lib.colors;'.");
    try testing.assertEqual(diagnostics[2].span().start, source.indexOf("Sort from lib.colors"));
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "main", "sizes"),
        "lib.sizes");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Sort")
        == pipeline.store().findDeclared("lib.sizes", "Kind"), "the first alias keeps the name");
}

test "an aliased function import keeps the function message and the module's own name" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import doubled as twice from lib.box;\n");
    loader.add("/proj/src/lib/box.ens", "public doubled(int x) -> int \{ return x * 2; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Only a type can be imported by name, and 'doubled' is a function. "
        + "Write 'import lib.box;' and call it as 'box.doubled(...)'.");
}

test "a refused import is the one problem reported, wherever the file uses its name" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "class Hidden \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected static make() -> Hidden \{\n"
        + "        return new Hidden();\n"
        + "    \}\n"
        + "\}\n"
        + "public helper() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Hidden from parts;\n"
        + "import Missing from parts;\n"
        + "import helper from parts;\n"
        + "take(Hidden value, Missing other, helper third) -> Hidden? \{\n"
        + "    Hidden? local = null;\n"
        + "    return local;\n"
        + "\}\n"
        + "build() \{\n"
        + "    let made = new Hidden();\n"
        + "    let other = Hidden.make();\n"
        + "    let missing = new Missing();\n"
        + "    int value = helper();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let reported = analysis.linkDiagnostics();
    try testing.assertEqual(reported.length, 3L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Type 'Hidden' is private to module 'parts', so only that file can use it. Mark 'Hidden' as "
        + "'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Module 'parts' has no type named 'Missing'. Check the spelling, or import 'Missing' from "
            + "the module that declares it.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Only a type can be imported by name, and 'helper' is a function. Write 'import parts;' "
        + "and call it as 'parts.helper(...)'.");
}

test "a refused import leaves its name to a later import that binds it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "class Widget \{ \}\n");
    loader.add("/proj/src/tools.ens", "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Widget from parts;\n"
        + "import Widget from tools;\n"
        + "main() -> int \{\n"
        + "    let made = new Widget();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let reported = analysis.linkDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Type 'Widget' is private to module 'parts', so only that file can use it. Mark 'Widget' as "
        + "'public' to use it from other modules in the package.");
}

test "a refused import leaves the file's own function and type of that name alone" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public helper() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import helper from lib.parts;\n"
        + "import Gadget from lib.parts;\n"
        + "class Gadget \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "helper() -> int \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "keep(Gadget value) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return helper();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let reported = analysis.linkDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Only a type can be imported by name, and 'helper' is a function. Write 'import "
        + "lib.parts;' and call it as 'parts.helper(...)'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Gadget'. Check the spelling, or import 'Gadget' "
            + "from the module that declares it.");
}

test "a refused import of a name an implicit module provides keeps the provided type" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public helper() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Error from lib.parts;\n"
        + "class Mine extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"mine\");\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Link]);
    let reported = analysis.linkDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Error'. 'Error' is available in every file without "
            + "an import, so remove this import.");
}

// The import to write instead names the one module the file may name that declares the type;
// a module whose type the file cannot name, and the file's own module, are not offered.
test "a missing type declared by one other module is fixed with the import of that module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public class Bolt \{ \}\n");
    loader.add("/proj/src/lib/tools.ens", "public class Gadget \{ \}\n");
    loader.add("/proj/src/lib/hidden.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gadget from lib.parts;\n"
        + "import Gadget as Widget from lib.parts;\n"
        + "import Bolt from lib.tools;\n"
        + "import Bolt as Pin from lib.tools;\n"
        + "import Nut from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Gadget'. Write 'import Gadget from lib.tools;' "
            + "instead.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Gadget'. Write 'import Gadget as Widget from "
            + "lib.tools;' instead.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "Module 'lib.tools' has no type named 'Bolt'. Write 'import Bolt from lib.parts;' instead.");
    try sema_support.assertDiagnostic(diagnostics, 3, "/proj/src/main.ens",
        "Module 'lib.tools' has no type named 'Bolt'. Write 'import Bolt as Pin from lib.parts;' "
            + "instead.");
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Nut'. Check the spelling, or import 'Nut' from the "
            + "module that declares it.");
    try testing.assertEqual(diagnostics.length, 5L);
}

test "a missing type declared by several modules is fixed with each import, by path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "import lib.sizes;\nimport lib.colors;\nimport shapes;\n");
    loader.add("/proj/src/lib/sizes.ens", "public enum Kind \{ Small \}\n");
    loader.add("/proj/src/lib/colors.ens", "public enum Kind \{ Red \}\n");
    loader.add("/proj/src/shapes.ens", "public enum Kind \{ Round \}\n");
    loader.add("/proj/src/main.ens", "import Kind from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'Kind'. Write 'import Kind "
            + "from lib.colors;', 'import Kind from lib.sizes;' or 'import Kind from shapes;' "
            + "instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

// A type of another package is offered only where it is exported, spelled with the '@' its import
// takes; one that is not exported is explained, with no fix where the package is not the user's.
test "a missing type exported by another package is fixed with its package import" {
    let loader = new FakeFileLoader();
    let fetched = sema_support.fetchedAcme(loader,
        "export class Gear \{ \}\npublic class Motor \{ \}\n");
    loader.add("/store/acme/src/tools.ens", "import parts;\nexport class Wrench \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gear from @acme.tools;\nimport Motor from @acme.tools;\n");
    let analysis = sema_support.analyzeWithFetched(loader, "/proj/src", ["main.ens"], fetched);

    let diagnostics = analysis.linkDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Gear'. Write 'import Gear from @acme.parts;' "
            + "instead.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Motor'. Module '@acme.parts' declares 'Motor', "
            + "which is public inside package 'acme' but not exported, so another package cannot "
            + "import it.");
    try testing.assertEqual(diagnostics.length, 2L);
}

// Where the package that keeps the type to itself is a workspace member, the fix marks the
// declaration and then writes the import, keeping the name the refused import bound.
test "a missing type another workspace package keeps to itself is fixed with the modifier" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/main.ens",
        "import Motor as Engine from @acme.tools;\nimport Coil from @acme.tools;\n");
    loader.add("/proj/vendor/acme/src/parts.ens", "public class Motor \{ \}\nclass Coil \{ \}\n");
    loader.add("/proj/vendor/acme/src/tools.ens", "import parts;\nexport class Wrench \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Motor'. Module '@acme.parts' declares 'Motor', "
            + "which is public inside package 'acme' but not exported, so another package cannot "
            + "import it. Change 'public' to 'export' on 'Motor' in module '@acme.parts', then "
            + "write 'import Motor as Engine from @acme.parts;' instead.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Coil'. Module '@acme.parts' declares 'Coil', but "
            + "it is private to that module, so only that file can use it. Mark 'Coil' as 'export' in "
            + "module '@acme.parts', then write 'import Coil from @acme.parts;' instead.");
    try testing.assertEqual(diagnostics.length, 2L);
}

// A private type of the file's own package is fixed with 'public'; every module that keeps the
// name to itself is explained, in import path order.
test "a missing type other modules of the package keep private is fixed with public" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "import lib.hidden;\nimport secret;\n");
    loader.add("/proj/src/lib/hidden.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/secret.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gadget from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'Gadget'. Module 'lib.hidden' "
            + "declares 'Gadget', but it is private to that module, so only that file can use it. "
            + "Mark 'Gadget' as 'public' in module 'lib.hidden', then write 'import Gadget from "
            + "lib.hidden;' instead. Module 'secret' declares 'Gadget', but it is private to that "
            + "module, so only that file can use it. Mark 'Gadget' as 'public' in module 'secret', "
            + "then write 'import Gadget from secret;' instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

// A name every file has without an import is only removed where the import binds it as itself;
// under an alias the import is written against the module that declares it.
test "an aliased import of a name every file has is fixed with the module that declares it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "");
    loader.add("/proj/src/main.ens", "import Error as Failure from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'Error'. Write 'import Error "
            + "as Failure from @std.core;' instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

// A module nothing imports is never loaded, so the modules of the file's own package, of the
// packages it depends on and of the standard library are read for the type as well, under the
// visibility a loaded module's type is offered with.
test "a missing type exported by an unloaded module of a dependency is fixed with its import" {
    let loader = new FakeFileLoader();
    let fetched = sema_support.fetchedAcme(loader,
        "export class Gear \{ \}\npublic class Motor \{ \}\n");
    loader.add("/store/acme/src/tools.ens", "export class Wrench \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gear from @acme.tools;\nimport Motor from @acme.tools;\n");
    let analysis = sema_support.analyzeWithFetched(loader, "/proj/src", ["main.ens"], fetched);

    let diagnostics = analysis.linkDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Gear'. Write 'import Gear from @acme.parts;' "
            + "instead.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Motor'. Module '@acme.parts' declares 'Motor', "
            + "which is public inside package 'acme' but not exported, so another package cannot "
            + "import it.");
    try testing.assertEqual(diagnostics.length, 2L);
}

// A file that does not parse is left out, so a type the parser would have guessed at in it is
// not offered; the build reports that file where it is loaded.
test "a missing type declared by an unloaded module of this package is fixed with its import" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public class Bolt \{ \}\n");
    loader.add("/proj/src/lib/tools.ens", "public class Gadget \{ \}\n");
    loader.add("/proj/src/lib/hidden.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/lib/broken.ens", "public class Nut \{\n");
    loader.add("/proj/src/main.ens", "import Gadget from lib.parts;\nimport Nut from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Gadget'. Write 'import Gadget from lib.tools;' "
            + "instead.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module 'lib.parts' has no type named 'Nut'. Check the spelling, or import 'Nut' from the "
            + "module that declares it.");
    try testing.assertEqual(diagnostics.length, 2L);
}

test "loaded and unloaded modules declaring a missing type are offered together, by path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "import lib.sizes;\n");
    loader.add("/proj/src/lib/sizes.ens", "public enum Kind \{ Small \}\n");
    loader.add("/proj/src/lib/colors.ens", "public enum Kind \{ Red \}\n");
    loader.add("/proj/src/shapes.ens", "public enum Kind \{ Round \}\n");
    loader.add("/proj/src/main.ens", "import Kind from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'Kind'. Write 'import Kind "
            + "from lib.colors;', 'import Kind from lib.sizes;' or 'import Kind from shapes;' "
            + "instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

test "a missing type the standard library declares is fixed with its '@std' import" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/lib/parts.ens", "");
    loader.add("/proj/src/main.ens", "import List from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'List'. Write 'import List "
            + "from @std.collections.list;' instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}

// An import a file writes resolves against the dependencies of its own package, so a type of a
// package it does not depend on is not offered, whether another package loaded that module or not.
test "a type of a package the file's package does not depend on is not offered" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "    member \"proj/vendor/util\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package",
        "package acme \{\n    ens \"0.1\";\n    dependency util;\n\}\n");
    loader.add("/proj/vendor/util/ens.package", "package util \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/tools.ens",
        "import @util.gears;\nimport Motor from @util.gears;\nexport class Wrench \{ \}\n");
    loader.add("/proj/vendor/util/src/gears.ens", "export class Gear \{ \}\n");
    loader.add("/proj/vendor/util/src/motors.ens", "export class Motor \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gear from @acme.tools;\nimport Motor from @acme.tools;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    let diagnostics = pipeline.linkResult().diagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Gear'. Check the spelling, or import 'Gear' from "
            + "the module that declares it.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Module '@acme.tools' has no type named 'Motor'. Check the spelling, or import 'Motor' from "
            + "the module that declares it.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/vendor/acme/src/tools.ens",
        "Module '@util.gears' has no type named 'Motor'. Write 'import Motor from @util.motors;' "
            + "instead.");
    try testing.assertEqual(diagnostics.length, 3L);
}

// A module the graph did not load that keeps the type out of reach is explained like a loaded
// one, with the modifier to write where its package is the user's, every module in path order.
test "a missing type unloaded modules keep out of reach is explained with each module's fix" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens", "public class Gadget \{ \}\n");
    loader.add("/proj/src/lib/parts.ens", "import lib.hidden;\n");
    loader.add("/proj/src/lib/hidden.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/secret.ens", "class Gadget \{ \}\n");
    loader.add("/proj/src/main.ens", "import Gadget from lib.parts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Module 'lib.parts' has no type named 'Gadget'. Module '@acme.parts' "
            + "declares 'Gadget', which is public inside package 'acme' but not exported, so "
            + "another package cannot import it. Change 'public' to 'export' on 'Gadget' in module "
            + "'@acme.parts', then write 'import Gadget from @acme.parts;' instead. Module "
            + "'lib.hidden' declares 'Gadget', but it is private to that module, so only that file "
            + "can use it. Mark 'Gadget' as 'public' in module 'lib.hidden', then write 'import Gadget "
            + "from lib.hidden;' instead. Module 'secret' declares 'Gadget', but it is private to "
            + "that module, so only that file can use it. Mark 'Gadget' as 'public' in module "
            + "'secret', then write 'import Gadget from secret;' instead.");
    try testing.assertEqual(pipeline.linkResult().diagnostics().length, 1L);
}
