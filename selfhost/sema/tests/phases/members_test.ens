import FakeFileLoader from sema_support;
import sema_support;

test "a callable keeps the markers its own shape governs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public abstract class Shape \{\n"
        + "    public abstract area() -> int;\n"
        + "    public final describe() -> int \{ return 1; \}\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public final class Square extends Shape \{\n"
        + "    public override area() -> int \{ return 4; \}\n"
        + "    public constructor() \{ super(); \}\n"
        + "    destructor() \{ \}\n"
        + "\}\n"
        + "public noreturn stop(string message) \{ panic(message); \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a field keeps its visibility modifiers and 'weak'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Node \{\n"
        + "    public int tag = 0;\n"
        + "    protected weak Node? owner = null;\n"
        + "    int hidden = 0;\n"
        + "    public constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a 'const' field is legal on a class and a struct, with or without a default" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Message \{\n"
        + "    public const string text;\n"
        + "    public const Message? cause;\n"
        + "    const int code = 3;\n"
        + "    public constructor(this.text, this.cause = null);\n"
        + "\}\n"
        + "public struct Frame \{\n"
        + "    public const string name;\n"
        + "    public const bool inlined = false;\n"
        + "\}\n"
        + "read(Message message) -> string \{\n"
        + "    Frame frame = \{name: message.text\};\n"
        + "    return frame.name;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}
