import sema_support;

test "a function type is an ordinary type wherever a type may be written" {
    let analysis = sema_support.analyzeProgram("public class Holder \{\n"
        + "    (int, int) -> int order;\n"
        + "    ((int) -> bool)? filter;\n"
        + "    public constructor((int, int) -> int order) \{\n"
        + "        this.order = order;\n"
        + "        this.filter = null;\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> (int) -> int \{ return (v) -> v; \}\n"
        + "hold(((int) -> int)[] steps) -> long \{ return steps.length; \}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder((a, b) -> a - b);\n"
        + "    return hold([(v) -> v, pick()]) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}
