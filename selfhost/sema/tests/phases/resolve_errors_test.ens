import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "type references diagnose unknown names, bare generics, arity, and non-generics" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Bad \{\n"
        + "    Nope a;\n"
        + "    Box b;\n"
        + "    Box<int, int> c;\n"
        + "    int<int> d;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Unknown type 'Nope'. Check the spelling, or import the module that declares it.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Generic type 'Box' needs type arguments. Write them in '<...>' after the name, as in "
            + "'Box<int>'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Generic type 'Box' takes 1 type argument, but 2 are written here. Write exactly one, for "
            + "'T'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Type 'int' is not generic and takes no type arguments. Remove the '<...>' after 'int'.");
}

test "the reserved word 'decimal' is refused wherever a type is named" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Money \{\n"
        + "    decimal amount;\n"
        + "    decimal? pending;\n"
        + "    decimal[]? history;\n"
        + "    Box<decimal>? boxed;\n"
        + "\}\n"
        + "rate(decimal factor) -> decimal \{\n"
        + "    return factor;\n"
        + "\}\n"
        + "use() \{\n"
        + "    decimal here = 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Bodies]);
    string message = "'decimal' is a reserved word and not a usable type yet. Use 'double' for "
    + "fractional values, or an integer scaled by hand (a 'long' count of cents, say) where the "
    + "value has to be exact.";
    let declared = analysis.signatureDiagnostics();
    try testing.assertEqual(declared.length, 6L);
    for (let diagnostic in declared) {
        try testing.assertEqual(diagnostic.message(), message);
    }
    let inBody = analysis.bodyDiagnostics();
    try testing.assertEqual(inBody.length, 1L);
    try testing.assertEqual(inBody[0].message(), message);
}

// What a module-qualified type name reads before the rule that refuses the spelling gets to it:
// a type this file cannot reach, a name the module does not declare, and a head that is no
// imported module at all.
test "qualified references diagnose visibility, missing types, and unknown aliases" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import lib.shapes;\n"
        + "struct Holder \{\n"
        + "    shapes.Hidden h;\n"
        + "    shapes.Missing m;\n"
        + "    foo.Thing t;\n"
        + "\}\n");
    loader.add("/proj/src/lib/shapes.ens",
        "class Hidden \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type 'Hidden' is private to module 'lib.shapes', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Module 'lib.shapes' has no type named 'Missing'. Check the spelling, or import 'Missing' "
            + "from the module that declares it.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'foo' is not an imported module, so 'foo.Thing' names no type. Import 'Thing' from the "
        + "module that declares it, then write 'Thing'.");
    try testing.assertEqual(found.length, 3L);
}

test "type parameter bounds reject duplicates, two classes, and non-class bounds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Robot \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Chorus<T: Speaker + Speaker> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Pen<T: Animal + Robot> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Sized<T: int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type parameter 'T' already has the bound 'Speaker'. Remove this second 'Speaker'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Type parameter 'T' already has the class bound 'Animal', and only one bound can be a "
        + "class. Remove 'Robot', or replace it with an interface.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A type-parameter bound must be a class that is not generic, or an interface, and 'int' is "
        + "neither. Name a class or an interface, or remove the bound.");
}

test "a bound naming its own parameter is judged with the type argument substituted in" {
    string shared = "interface Comparable<T> \{\n"
        + "    compareTo(T other) -> int;\n"
        + "\}\n"
        + "class Item implements Comparable<Item> \{\n"
        + "    protected int value;\n"
        + "    protected constructor(this.value);\n"
        + "    protected override compareTo(Item other) -> int \{\n"
        + "        return this.value - other.value;\n"
        + "    \}\n"
        + "\}\n"
        + "class Plain \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Sorted<T: Comparable<T>> \{\n"
        + "    protected constructor();\n"
        + "    protected static smallestOf(T first, T second) -> T \{\n"
        + "        if (second.compareTo(first) < 0) \{\n"
        + "            return second;\n"
        + "        \}\n"
        + "        return first;\n"
        + "    \}\n"
        + "\}\n"
        + "largest<T: Comparable<T>>(T[] values) -> T \{\n"
        + "    return values[0];\n"
        + "\}\n"
        + "interface Converts<T> \{\n"
        + "    convert() -> T;\n"
        + "\}\n"
        + "class Meters implements Converts<Feet> \{\n"
        + "    protected constructor();\n"
        + "    protected override convert() -> Feet \{\n"
        + "        return new Feet();\n"
        + "    \}\n"
        + "\}\n"
        + "class Feet implements Converts<Meters> \{\n"
        + "    protected constructor();\n"
        + "    protected override convert() -> Meters \{\n"
        + "        return new Meters();\n"
        + "    \}\n"
        + "\}\n"
        + "roundTrip<A: Converts<B>, B: Converts<A>>(A start) -> A \{\n"
        + "    return start.convert().convert();\n"
        + "\}\n";
    let satisfied = try sema_support.analyzeOne(shared
        + "main() -> int \{\n"
        + "    Item[] items = [new Item(1), new Item(2)];\n"
        + "    let inferred = largest(items);\n"
        + "    let explicit = largest<Item>(items);\n"
        + "    let smallest = Sorted.smallestOf(new Item(1), new Item(2));\n"
        + "    let sorted = new Sorted<Item>();\n"
        + "    let meters = roundTrip<Meters, Feet>(new Meters());\n"
        + "    return explicit.value + smallest.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(satisfied.bodyDiagnostics());
    let unmet = try sema_support.analyzeOne(shared
        + "main() -> int \{\n"
        + "    Plain[] plains = [new Plain()];\n"
        + "    let inferred = largest(plains);\n"
        + "    let explicit = largest<Plain>(plains);\n"
        + "    let smallest = Sorted.smallestOf(new Plain(), new Plain());\n"
        + "    let sorted = new Sorted<Plain>();\n"
        + "    let meters = roundTrip<Meters, Meters>(new Meters());\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = unmet.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 6L);
    string[] generics = ["largest", "largest", "Sorted", "Sorted"];
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(diagnostics, i, "/proj/src/main.ens",
            "Type argument 'Plain' for type parameter 'T' of '{generics[i]}' must implement "
            + "interface 'Comparable<Plain>'. Replace 'Plain' with a type that implements "
            + "'Comparable<Plain>', or add 'implements Comparable<Plain>' to the declaration of 'Plain'.");
    }
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/src/main.ens",
        "Type argument 'Meters' for type parameter 'A' of 'roundTrip' must implement interface "
        + "'Converts<Meters>'. Replace 'Meters' with a type that implements 'Converts<Meters>', or "
        + "add 'Converts<Meters>' to the 'implements' list of 'Meters'.");
    try sema_support.assertDiagnostic(diagnostics, 5, "/proj/src/main.ens",
        "Type argument 'Meters' for type parameter 'B' of 'roundTrip' must implement interface "
        + "'Converts<Meters>'. Replace 'Meters' with a type that implements 'Converts<Meters>', or "
        + "add 'Converts<Meters>' to the 'implements' list of 'Meters'.");
}

// One sentence refuses the spelling in every position a declaration writes a type in: a struct's
// field type, an 'implements' list, a parameter, a generic head, a return type and a 'throws'
// list, and a class's field type, which the layout stage is the one to read.
test "a module-qualified type name is refused in every declared position" {
    let loader = new FakeFileLoader();
    sema_support.partsLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "struct Pair \{\n"
        + "    parts.Widget left;\n"
        + "\}\n"
        + "public class Holder implements parts.Shape \{\n"
        + "    parts.Widget widget;\n"
        + "    public constructor(this.widget);\n"
        + "\}\n"
        + "keeps(parts.Shape shape, parts.Crate<int> crate) -> parts.Widget? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "guards() throws parts.Failure \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signed = analysis.signatureDiagnostics();
    string[] refused = ["Widget", "Shape", "Shape", "Crate", "Widget", "Failure"];
    for (long i = 0; i < refused.length; i++) {
        try sema_support.assertDiagnostic(signed, i, "/proj/src/main.ens",
            "'parts.{refused[i]}' writes a type after a module name, and only a function can be "
            + "written after a module name. Write 'import {refused[i]} from lib.parts;' and then "
            + "write '{refused[i]}'.");
    }
    try testing.assertEqual(signed.length, 6L);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "'parts.Widget' writes a type after a module name, and only a function can be written "
        + "after a module name. Write 'import Widget from lib.parts;' and then write 'Widget'.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// An array element in a declaration, a nullable, a type argument, 'new', 'is' and 'as?' are read
// while the bodies are checked, and each one reads the same refusal.
test "a module-qualified type name is refused in every position a body writes" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    sema_support.partsLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "import Shape from lib.parts;\n"
        + "import lib.parts as parts;\n"
        + "keeps(Shape shape) -> int \{\n"
        + "    parts.Widget[] all = [new parts.Widget()];\n"
        + "    parts.Widget? held = null;\n"
        + "    let listed = new List<parts.Widget>();\n"
        + "    if (shape is parts.Widget) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    let down = shape as? parts.Widget;\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    for (long i = 0; i < 6; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "'parts.Widget' writes a type after a module name, and only a function can be written "
            + "after a module name. Write 'import Widget from lib.parts;' and then write 'Widget'.");
    }
    try testing.assertEqual(reported.length, 6L);
}

test "a function type takes no 'void' parameter" {
    try sema_support.assertOnlyProblem("take((void) -> int f) \{ \}\n"
        + "main() -> int \{ return 0; \}\n",
        "'void' means no value, so it cannot be a parameter type. Write '() -> ...' for a "
        + "function value that takes nothing.");
}

test "parentheses in a type are allowed only around a function type" {
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    (int) count = 1;\n"
        + "    return count;\n"
        + "\}\n",
        "In a type, only a function type can be written in parentheses, as in '((int) -> bool)?'. "
        + "Remove the parentheses around 'int'.");
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    (((int) -> int)) step = (a) -> a;\n"
        + "    return step(1);\n"
        + "\}\n",
        "In a type, only a function type can be written in parentheses, as in '((int) -> bool)?'. "
        + "Remove the parentheses around '(int) -> int'.");
    let analysis = sema_support.analyzeProgram("take(((int) -> bool) -> int pick) \{ \}\n"
        + "main() -> int \{\n"
        + "    ((int) -> bool)? maybe = null;\n"
        + "    ((int) -> bool)[] many = [(v) -> v > 0];\n"
        + "    return many.length as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}
