// Every task can read a lazy const by name, so its type has to be one another task may hold, and the
// refusal of one that is not names the fix that makes it one.
import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "a lazy const another task could change is refused with its frozen form or a mutex" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "final class Tally \{\n"
        + "    long count = 0;\n"
        + "\}\n"
        + "flag() -> bool \{\n"
        + "    return true;\n"
        + "\}\n"
        + "final class Settings \{\n"
        + "    lazy const int[] numbers = [1, 2];\n"
        + "    lazy const int[] picked = flag() ? [1] : [2];\n"
        + "    lazy const int[] spread = [\n"
        + "        1, 2];\n"
        + "    lazy const Tally tally = new Tally();\n"
        + "    lazy const Tally[] tallies = [new Tally()];\n"
        + "    lazy const () -> int counter = () -> 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 6L);
    string changeable = "which can be changed through any reference to it, and every task can read a "
        + "lazy const by name, so its value could change while another task reads it.";
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Lazy const 'Settings.numbers' has type 'int[]', {changeable} Write 'import FrozenList from "
        + "@std.collections.frozen;' and declare it as a 'FrozenList<int>' with the initializer "
        + "'[1, 2].frozen()', or write 'import Mutex from @std.tasks;' and keep it in a "
        + "'Mutex<int[]>' if it has to change.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Lazy const 'Settings.picked' has type 'int[]', {changeable} Write 'import FrozenList from "
        + "@std.collections.frozen;' and declare it as a 'FrozenList<int>' with the initializer "
        + "'(flag() ? [1] : [2]).frozen()', or write 'import Mutex from @std.tasks;' and keep it in "
        + "a 'Mutex<int[]>' if it has to change.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Lazy const 'Settings.spread' has type 'int[]', {changeable} Write 'import FrozenList from "
        + "@std.collections.frozen;' and declare it as a 'FrozenList<int>' and end its initializer "
        + "with '.frozen()', or write 'import Mutex from @std.tasks;' and keep it in a "
        + "'Mutex<int[]>' if it has to change.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Lazy const 'Settings.tally' has type 'Tally', a class that is not 'shared', and every task "
        + "can read a lazy const by name, so its value could change while another task reads it. "
        + "Write 'shared' before 'class Tally'. If it has to change, write 'import Mutex from "
        + "@std.tasks;' and keep it in a 'Mutex<Tally>' instead.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "Lazy const 'Settings.tallies' has type 'Tally[]', {changeable} Write 'import Mutex from "
        + "@std.tasks;' and keep it in a 'Mutex<Tally[]>' instead, which lets one task at a time use "
        + "it.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/main.ens",
        "Lazy const 'Settings.counter' has type '() -> int', a function that may keep a value that "
        + "changes, and every task can read a lazy const by name, so its value could change while "
        + "another task reads it. Write 'shared' before the function type, as in "
        + "'shared () -> int'.");
}

test "a lazy const fix names a frozen collection or a mutex the file already imports by that name" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/collections/frozen.ens", "export shared final class FrozenList<T> \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.add("/stdlib/std/src/tasks.ens", "export shared final class Mutex<T> \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import FrozenList as Frozen from @std.collections.frozen;\n"
        + "import Mutex from @std.tasks;\n"
        + "final class Settings \{\n"
        + "    lazy const string[] names = [\"a\"];\n"
        + "    lazy const Frozen<string>? kept = null;\n"
        + "    lazy const Mutex<string[]>? guarded = null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Lazy const 'Settings.names' has type 'string[]', which can be changed through any reference "
        + "to it, and every task can read a lazy const by name, so its value could change while "
        + "another task reads it. Declare it as a 'Frozen<string>' with the initializer "
        + "'[\"a\"].frozen()', or keep it in a 'Mutex<string[]>' if it has to change.");
}

test "a lazy const of a type another task may hold is accepted" {
    let analysis = try sema_support.analyzeOne("shared final class Limits \{\n"
        + "    const long width;\n"
        + "\n"
        + "    constructor(this.width);\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "final class Settings \{\n"
        + "    lazy const string name = \"a\";\n"
        + "    lazy const Limits limits = new Limits(4);\n"
        + "    lazy const Point origin = \{x: 0\};\n"
        + "    lazy const bytes greeting = [1];\n"
        + "    lazy const shared () -> int counter = () -> 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}
