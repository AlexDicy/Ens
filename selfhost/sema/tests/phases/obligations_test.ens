import @std.testing;
import TestFailure from @std.testing;
import ProgramAnalysis from pipeline;
import FileDiagnostic from support.diagnostics;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "a generic function hole is judged once per concrete call type argument set" {
    string program = "class Point \{\n"
        + "    int x;\n"
        + "    protected constructor(this.x);\n"
        + "\}\n"
        + "describe<T>(T value) -> string \{\n"
        + "    return \"value is \{value\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(42));\n"
        + "    print(describe(\"tools\"));\n"
        + "    print(describe(new Point(1)));\n"
        + "    print(describe([1, 2]));\n"
        + "    (int) -> int doubler = (v) -> v * 2;\n"
        + "    print(describe(doubler));\n"
        + "    (int) -> int tripler = (v) -> v * 3;\n"
        + "    print(describe(tripler));\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try analyzeOne(program);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'describe<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function "
        + "value has no text form. Pass a name you keep beside the function, or a type argument "
        + "whose values have one.");
    // The call that supplied the type argument is what the refusal points at, and the hole
    // inside the generic is the note beside it.
    try testing.assertEqual(diagnostics[0].span().start, program.indexOf("describe(doubler)"));
    try testing.assertEqual(diagnostics[0].span().length, 17L);
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.file(), "/proj/src/main.ens");
    try testing.assertEqual(related.span().start, program.indexOf("\{value\}") + 1);
    try testing.assertEqual(related.note(),
        "'describe<T>' interpolates a value of type 'T' here");
}

test "two calls at one type argument report once, at the first of them" {
    string program = "describe<T>(T value) -> string \{\n"
        + "    return \"value is \{value\}\";\n"
        + "\}\n"
        + "first((int) -> int step) -> string \{\n"
        + "    return describe(step);\n"
        + "\}\n"
        + "second((int) -> int step) -> string \{\n"
        + "    return describe(step);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try analyzeOne(program);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try testing.assertEqual(diagnostics[0].span().start, program.indexOf("describe(step)"));
}

test "a class template hole is judged per instantiation and anchors at the mention" {
    string program = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Box<T> \{\n"
        + "    T item;\n"
        + "    protected constructor(T value) \{ this.item = value; \}\n"
        + "    protected label() -> string \{ return \"box of \{this.item\}\"; \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(new Box<int>(7).label());\n"
        + "    print(new Box<Shape>(new Shape()).label());\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    let bad = new Box<(int) -> int>(step);\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try analyzeOne(program);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'Box<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function value "
        + "has no text form. Pass a name you keep beside the function, or a type argument whose "
        + "values have one.");
    // The written instantiation carries the refusal, from its name through its type arguments.
    try testing.assertEqual(diagnostics[0].span().start, program.indexOf("Box<(int) -> int>"));
    try testing.assertEqual(diagnostics[0].span().length, 17L);
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.span().start, program.indexOf("\{this.item\}") + 1);
    try testing.assertEqual(related.note(), "'Box<T>' interpolates a value of type 'T' here");
}

test "a deferred type test is judged against each instantiation's concrete scrutinee" {
    let analysis = try analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Widget \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Wrap<T> \{\n"
        + "    T item;\n"
        + "    protected constructor(T value) \{ this.item = value; \}\n"
        + "    isShape() -> bool \{ return this.item is Shape; \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let related = new Wrap<Square>(new Square());\n"
        + "    let unrelated = new Wrap<Widget>(new Widget());\n"
        + "    let fine = new Wrap<Shape>(new Shape());\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 3L);
    bool sawAlwaysTrue = false;
    bool sawNeverTrue = false;
    for (let diagnostic in diagnostics) {
        if (diagnostic.message() == "'Wrap<Square>' tests a value of type 'Square' against "
        + "'Shape', which it always is, so the test is always true. Use a type argument for "
        + "which it can be false.") {
            sawAlwaysTrue = true;
        }
        if (diagnostic.message() == "'Wrap<Widget>' tests a value of type 'Widget' against "
                + "'Shape', which it can never be, so the test would always be false. Use a "
                + "type argument for which the test can be true or false.") {
            sawNeverTrue = true;
        }
    }
    try testing.assertTrue(sawAlwaysTrue, "Wrap<Square> makes the test constant");
    try testing.assertTrue(sawNeverTrue, "Wrap<Widget> can never pass the test");
}

test "an open generic call cascades the callee's obligations from the caller's arguments" {
    string program = "inner<T>(T value) -> string \{\n"
        + "    return \"got \{value\}\";\n"
        + "\}\n"
        + "outer<T>(T value) -> string \{\n"
        + "    return inner(value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(outer(3));\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    print(outer(step));\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try analyzeOne(program);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    // A cascade hands the origin down, so the call to 'outer' carries what 'inner' refused, and
    // the message names the instantiation this file wrote rather than the inner one.
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'outer<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function value "
        + "has no text form. Pass a name you keep beside the function, or a type argument whose "
        + "values have one.");
    try testing.assertTrue(diagnostics[0].message().indexOf("inner<") < 0,
        "the message names no instantiation the caller did not write");
    try testing.assertEqual(diagnostics[0].span().start, program.indexOf("outer(step)"));
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.span().start, program.indexOf("\{value\}") + 1);
    try testing.assertEqual(related.note(), "'inner<T>' interpolates a value of type 'T' here");
}

test "an instantiation open inside a generic body cascades from the enclosing template" {
    string program = "class Box<T> \{\n"
        + "    T item;\n"
        + "    protected constructor(T value) \{ this.item = value; \}\n"
        + "    protected label() -> string \{ return \"box of \{this.item\}\"; \}\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    T kept;\n"
        + "    protected constructor(T value) \{ this.kept = value; \}\n"
        + "    describe() -> string \{\n"
        + "        let boxed = new Box<T>(this.kept);\n"
        + "        return boxed.label();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let ok = new Holder<string>(\"fine\");\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    let bad = new Holder<(int) -> int>(step);\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try analyzeOne(program);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    // 'Box<T>' is reached only through 'Holder<(int) -> int>', which is the mention a reader
    // wrote, so that is where the refusal lands and what it names.
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'Holder<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function "
        + "value has no text form. Pass a name you keep beside the function, or a type argument "
        + "whose values have one.");
    try testing.assertTrue(diagnostics[0].message().indexOf("Box<") < 0,
        "the message names no instantiation this file did not write");
    try testing.assertEqual(diagnostics[0].span().start,
        program.indexOf("Holder<(int) -> int>"));
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.span().start, program.indexOf("\{this.item\}") + 1);
    try testing.assertEqual(related.note(), "'Box<T>' interpolates a value of type 'T' here");
}

test "an explicit toString call on a type parameter is judged per instantiation" {
    let analysis = try analyzeOne("render<T>(T value) -> string \{\n"
        + "    return value.toString();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(render(7));\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    print(render(step));\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'render<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function "
        + "value has no text form. Pass a name you keep beside the function, or a type argument "
        + "whose values have one.");
}

// A three-module program: 'shapes' declares a generic owner that 'main' and 'other' both use.
analyzeAcrossModules(string shapesText, string mainText, string otherText)
        -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/shapes.ens", shapesText);
    loader.add("/proj/src/main.ens", mainText);
    loader.add("/proj/src/other.ens", otherText);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens", "other.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "calls recorded by two modules against a third module's owner both replay" {
    let analysis = try analyzeAcrossModules(
        "public describe<T>(T value) -> string \{\n"
        + "    return \"value is \{value\}\";\n"
        + "\}\n",
        "import shapes;\n"
        + "main() -> int \{\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    print(shapes.describe(step));\n"
        + "    return 0;\n"
        + "\}\n",
        "import shapes;\n"
        + "public label(int?? deep) -> string \{\n"
        + "    return shapes.describe(deep);\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    // Each module reads its refusal in its own file, and the generic's hole is the note.
    try testing.assertEqual(diagnostics[0].file(), "/proj/src/main.ens");
    try testing.assertEqual(diagnostics[1].file(), "/proj/src/other.ens");
    for (let diagnostic in diagnostics) {
        let related = try sema_support.relatedOf(diagnostic);
        try testing.assertEqual(related.file(), "/proj/src/shapes.ens");
        try testing.assertEqual(related.note(),
            "'describe<T>' interpolates a value of type 'T' here");
    }
    try sema_support.assertMentions(diagnostics, "'describe<(int) -> int>' cannot interpolate a "
    + "value of type '(int) -> int': a function value has no text form. Pass a name you keep "
    + "beside the function, or a type argument whose values have one.");
    try sema_support.assertMentions(diagnostics, "'describe<int??>' cannot interpolate a "
        + "value of type 'int??' because it may be null at more than one level. Pass a type "
        + "argument nullable at one level at most, such as 'int?'.");
}

test "enum and optional substitutions keep the concrete judgment's own wording" {
    let analysis = try analyzeOne("enum Color \{ Red, Green, \}\n"
        + "describe<T>(T value) -> string \{\n"
        + "    return \"value is \{value\}\";\n"
        + "\}\n"
        + "perhaps() -> int? \{\n"
        + "    return 4;\n"
        + "\}\n"
        + "deeper(int? inner) -> int?? \{\n"
        + "    return inner;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(describe(Color.Red));\n"
        + "    print(describe(perhaps()));\n"
        + "    print(describe(deeper(perhaps())));\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'describe<int??>' cannot interpolate a value of type 'int??' because it may be null at "
            + "more than one level. Pass a type argument nullable at one level at most, such as "
            + "'int?'.");
}

// The shared program for the mention-guard pair below. Whether 'Wrap's member is conditional
// decides whether its 'Odd<T>' mention replays for 'Wrap' of a function type.
mentionProgram(string memberHeader) -> string {
    return "public interface Comparable<T> \{\n"
        + "    compareTo(T other) -> int;\n"
        + "\}\n"
        + "public struct Odd<T> \{\n"
        + "    public T value;\n"
        + "\n"
        + "    public describe() -> string \{\n"
        + "        return \"\{this.value\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "public class Wrap<T> \{\n"
        + "    protected T held;\n"
        + "\n"
        + "    protected constructor(this.held);\n"
        + "\n"
        + "    protected " + memberHeader + " -> string \{\n"
        + "        Odd<T> local = \{value: this.held\};\n"
        + "        return local.describe();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    (int) -> int step = (v) -> v;\n"
        + "    let w = new Wrap<(int) -> int>(step);\n"
        + "    return 0;\n"
        + "\}\n";
}

test "an open mention inside a conditional member replays only where the member exists" {
    let analysis = try analyzeOne(mentionProgram("label<T: Comparable<T>>()"));
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "an open mention outside any conditional member still replays everywhere" {
    let analysis = try analyzeOne(mentionProgram("label()"));
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'Wrap<(int) -> int>' cannot interpolate a value of type '(int) -> int': a function value "
        + "has no text form. Pass a name you keep beside the function, or a type argument whose "
        + "values have one.");
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.note(),
        "'Odd<T>' interpolates a value of type 'T' here");
}

analyzeWithCollections(string text) -> ProgramAnalysis {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/main.ens", text);
    return sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
}

test "a generic hash call is judged per instantiation and names the type" {
    let analysis = try analyzeOne("external type Handle;\n"
        + "struct Callback \{\n"
        + "    (int) -> int step;\n"
        + "\}\n"
        + "hashOf<T>(T value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "hashHandle(Handle handle) -> long \{\n"
        + "    return hashOf(handle);\n"
        + "\}\n"
        + "hashCallback(Callback callback) -> long \{\n"
        + "    return hashOf(callback);\n"
        + "\}\n"
        + "hashNumber(int number) -> long \{\n"
        + "    return hashOf(number);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertMentions(diagnostics, "'hashOf<Handle>' cannot hash a value of type "
        + "'Handle': an external type is an address with no value to hash. Wrap the handle in a "
        + "class, which hashes by identity, and pass that, or pass a value you keep beside it.");
    try sema_support.assertMentions(diagnostics, "'hashOf<Callback>' cannot hash a value of "
        + "type 'Callback'. Field 'step' has type '(int) -> int', which has no hash; a function "
        + "value has no identity, so it has no hash. Use a type argument with a hash of its own, "
        + "or give 'Callback' its own 'equals' and 'hash'.");
    for (let diagnostic in diagnostics) {
        let related = try sema_support.relatedOf(diagnostic);
        try testing.assertEqual(related.note(),
            "'hashOf<T>' calls 'hash()' on a value of type 'T' here");
    }
}

test "a handle compares by identity wherever '==' reaches it, and still has no hash" {
    let analysis = try analyzeOne("external type Handle;\n"
        + "struct Slot \{\n"
        + "    Handle handle;\n"
        + "    Handle? spare;\n"
        + "    Handle[] extras;\n"
        + "\}\n"
        + "compare(Slot left, Slot right, Handle[] some, Handle[] others, Handle? maybe,\n"
        + "        Handle sure) -> bool \{\n"
        + "    return left == right && some == others && maybe == sure && sure != maybe;\n"
        + "\}\n"
        + "hashSlot(Slot slot) -> long \{\n"
        + "    return slot.hash();\n"
        + "\}\n"
        + "hashExtras(Handle[] extras) -> long \{\n"
        + "    return extras.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertMentions(diagnostics, "Struct 'Slot' cannot be hashed. Field "
        + "'handle' has type 'Handle', which has no hash; an external type is an address with "
        + "no value to hash. Hash the fields you need directly instead.");
    try sema_support.assertMentions(diagnostics, "'Handle[]' cannot be hashed: an array hashes "
        + "element by element, and its element type 'Handle' has no hash; an external type is "
        + "an address with no value to hash. Hash a value you keep beside the elements instead.");
}

test "a keyed container written with an open key is judged per instantiation" {
    string program = "import Map from @std.collections.map;\n"
        + "class Index<K> \{\n"
        + "    Map<K, int>? table;\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "index<K>(K key) -> long \{\n"
        + "    let table = new Map<K, int>();\n"
        + "    return table.slotOf(key);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let rows = new Index<int[]>();\n"
        + "    let names = new Index<string>();\n"
        + "    long rowSlot = index([1, 2]);\n"
        + "    long nameSlot = index(\"left\");\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = analyzeWithCollections(program);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertMentions(diagnostics, "'Index<int[]>' cannot use 'int[]' as a Map "
        + "key: an array's contents, and so its hash, can change while it sits in the table. "
        + "Key by a value whose contents cannot change, such as a string or an integer.");
    try sema_support.assertMentions(diagnostics, "'index<int[]>' cannot use 'int[]' as a Map "
        + "key: an array's contents, and so its hash, can change while it sits in the table. "
        + "Key by a value whose contents cannot change, such as a string or an integer.");
    // The field's own 'Map<K, int>' is the note for both, since that is where the key was
    // written open; the refusals are on 'Index<int[]>' and on the 'index([1, 2])' call.
    try testing.assertEqual(diagnostics[0].span().start, program.indexOf("Index<int[]>"));
    try testing.assertEqual(diagnostics[1].span().start, program.indexOf("index([1, 2])"));
    for (let diagnostic in diagnostics) {
        let related = try sema_support.relatedOf(diagnostic);
        try testing.assertEqual(related.note(), "'Map' is keyed by 'K' here");
    }
}

test "a refused key is reported at its mention and never reaches the container's own hash" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "external type Handle;\n"
        + "struct Registry \{\n"
        + "    Map<Handle, int>? byHandle;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.signatureDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "Cannot use "
        + "'Handle' as a Map key: an external type is an address with no value to hash. Wrap the "
        + "handle in a class, which hashes by identity, or key by a value you keep beside it.");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
}

test "a struct with its own hash and equals is judged by that pair, not by its fields" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "external type Handle;\n"
        + "struct Slot \{\n"
        + "    int id;\n"
        + "    Handle handle;\n"
        + "    override hash() -> long \{\n"
        + "        return this.id;\n"
        + "    \}\n"
        + "    override equals(Slot other) -> bool \{\n"
        + "        return this.id == other.id;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Holder \{\n"
        + "    Slot slot;\n"
        + "\}\n"
        + "hashOf<T>(T value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "same(Holder left, Holder right) -> bool \{\n"
        + "    return left == right && hashOf(left) == left.hash();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let bySlot = new Map<Slot, int>();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

// The pair a struct declares decides which fields a match reads, at the top of a key or
// nested under a field of a struct that has none, so a changeable field below it is the author's
// business. 'Tagged' and 'Wrapped' both key by their 'id' alone.
test "a struct with its own pair keys a hashed container whatever its fields hold" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "import Set from @std.collections.set;\n"
        + "struct Tagged \{\n"
        + "    int id;\n"
        + "    string[] labels;\n"
        + "    override hash() -> long \{\n"
        + "        return this.id;\n"
        + "    \}\n"
        + "    override equals(Tagged other) -> bool \{\n"
        + "        return this.id == other.id;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Labeled \{\n"
        + "    Tagged tagged;\n"
        + "\}\n"
        + "struct Counted \{\n"
        + "    Map<string, int> counts;\n"
        + "\}\n"
        + "struct Wrapped \{\n"
        + "    Counted counted;\n"
        + "    int id;\n"
        + "    override hash() -> long \{\n"
        + "        return this.id;\n"
        + "    \}\n"
        + "    override equals(Wrapped other) -> bool \{\n"
        + "        return this.id == other.id;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let byTagged = new Map<Tagged, int>();\n"
        + "    let tags = new Set<Tagged>();\n"
        + "    let byLabeled = new Map<Labeled, int>();\n"
        + "    let byWrapped = new Map<Wrapped, int>();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

// A sorted container finds a key by the order the key's own 'compareTo' gives, which the real
// 'SortedMap' requires through the bound on its default constructor. What the key's fields hold
// is therefore never judged, while a bare array stays refused, since its own contents can change.
test "a sorted container accepts a struct key whose fields can change but no bare array" {
    let analysis = analyzeWithCollections("import SortedMap from @std.collections.sortedmap;\n"
        + "struct Ranked \{\n"
        + "    int[] steps;\n"
        + "    int rank;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let byRanked = new SortedMap<Ranked, string>();\n"
        + "    let bySteps = new SortedMap<int[], string>();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertMentions(diagnostics, "Cannot use 'int[]' as a SortedMap key: an "
        + "array's contents, and so its place in the order, can change while it sits in the map. "
        + "Key by a value whose contents cannot change, such as a string or an integer.");
}

// A reader who only handed the generic its type argument cannot reach the container inside it,
// so the refusal names the argument to change instead of the fields to key by.
test "a generic refused a changeable struct key names what its consumer should pass" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "struct Tagged \{\n"
        + "    protected int id;\n"
        + "    protected string[] labels;\n"
        + "\}\n"
        + "index<K>(K key) -> long \{\n"
        + "    let table = new Map<K, int>();\n"
        + "    return table.slotOf(key);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Tagged tagged = \{id: 1, labels: [\"one\"]\};\n"
        + "    long slot = index(tagged);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertMentions(diagnostics, "'index<Tagged>' cannot use 'Tagged' as a Map "
        + "key: its field 'labels' has type 'string[]', whose contents can change while the key "
        + "sits in the table. Pass a type argument whose contents cannot change, or give "
        + "'Tagged' its own 'equals' and 'hash' that leave 'labels' out.");
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.note(), "'Map' is keyed by 'K' here");
}

test "a floating-point value refused a hash or a key is sent to the canonical bits" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "import Set from @std.collections.set;\n"
        + "struct Reading \{\n"
        + "    protected double value;\n"
        + "    protected int sensor;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let byNumber = new Map<double, string>();\n"
        + "    let widths = new Set<float>();\n"
        + "    let byReading = new Map<Reading, int>();\n"
        + "    double measure = 1.5;\n"
        + "    long hashedNumber = measure.hash();\n"
        + "    Reading reading = \{value: 1.5, sensor: 1\};\n"
        + "    long hashedReading = reading.hash();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 5L);
    try sema_support.assertMentions(diagnostics, "Cannot use 'double' as a Map key: a NaN is equal "
    + "to no value, so nothing could find it again, and negative zero is equal to zero but "
    + "hashes differently, so one key would become two entries. Use a SortedMap, which finds a "
    + "key by its order rather than by its hash, or key by a struct of your own whose 'equals' "
    + "compares the number with 'compareTo(...) == 0' and whose 'hash' returns "
    + "'toCanonicalBits() as long'.");
    try sema_support.assertMentions(diagnostics, "Cannot use 'float' as a Set element: a NaN is "
    + "equal to no value, so nothing could find it again, and negative zero is equal to zero but "
    + "hashes differently, so one key would become two entries. Use a SortedMap, which finds a "
    + "key by its order rather than by its hash, or key by a struct of your own whose 'equals' "
    + "compares the number with 'compareTo(...) == 0' and whose 'hash' returns "
    + "'toCanonicalBits() as long'.");
    try sema_support.assertMentions(diagnostics, "Cannot use 'Reading' as a Map key: its field "
    + "'value' has type 'double', which has no hash; a NaN is equal to no value, so nothing "
    + "could find it again, and negative zero is equal to zero but hashes differently, so one "
    + "key would become two entries. Key by the fields that are exact, or give 'Reading' its own "
    + "'equals' and 'hash', comparing each floating-point field with 'compareTo(...) == 0' and "
    + "hashing it with 'toCanonicalBits() as long'.");
    try sema_support.assertMentions(diagnostics, "Cannot hash a value of type 'double': a NaN is "
        + "equal to no value, so nothing could find it again, and negative zero is equal to zero "
        + "but hashes differently, so one key would become two entries. Hash the number's "
        + "'toCanonicalBits() as long' instead, which gives every NaN the same hash and the two "
        + "zeros different ones.");
    try sema_support.assertMentions(diagnostics, "Struct 'Reading' cannot be hashed. Field 'value' "
    + "has type 'double', which has no hash; a NaN is equal to no value, so nothing could find "
    + "it again, and negative zero is equal to zero but hashes differently, so one key would "
    + "become two entries. Give 'Reading' its own 'equals' and 'hash', comparing each "
    + "floating-point field with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as "
    + "long'.");
}

// A reader who only handed a generic the type argument cannot reach the container or the call
// inside it, so every one of these names the type argument to change instead.
test "a generic refused a floating-point argument names what its consumer should pass" {
    let analysis = analyzeWithCollections("import Map from @std.collections.map;\n"
        + "struct Reading \{\n"
        + "    protected double value;\n"
        + "    protected int sensor;\n"
        + "\}\n"
        + "hashOf<T>(T value) -> long \{\n"
        + "    return value.hash();\n"
        + "\}\n"
        + "index<K>(K key) -> long \{\n"
        + "    let table = new Map<K, int>();\n"
        + "    return table.slotOf(key);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    double measure = 1.5;\n"
        + "    long hashedNumber = hashOf(measure);\n"
        + "    Reading reading = \{value: 1.5, sensor: 1\};\n"
        + "    long hashedReading = hashOf(reading);\n"
        + "    long numberSlot = index(measure);\n"
        + "    long readingSlot = index(reading);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 4L);
    try sema_support.assertMentions(diagnostics, "'hashOf<double>' cannot hash a value of type "
        + "'double': a NaN is equal to no value, so nothing could find it again, and negative "
        + "zero is equal to zero but hashes differently, so one key would become two entries. "
        + "Pass the number's 'toCanonicalBits() as long' instead, which gives every NaN the same "
        + "hash and the two zeros different ones.");
    try sema_support.assertMentions(diagnostics, "'hashOf<Reading>' cannot hash a value of type "
    + "'Reading'. Field 'value' has type 'double', which has no hash; a NaN is equal to no "
    + "value, so nothing could find it again, and negative zero is equal to zero but hashes "
    + "differently, so one key would become two entries. Use a type argument with a hash of its "
    + "own, or give 'Reading' its own 'equals' and 'hash', comparing each floating-point field "
    + "with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as long'.");
    try sema_support.assertMentions(diagnostics, "'index<double>' cannot use 'double' as a Map "
    + "key: a NaN is equal to no value, so nothing could find it again, and negative zero is "
    + "equal to zero but hashes differently, so one key would become two entries. Pass a type "
    + "argument with a hash of its own, such as a struct holding the number whose 'equals' "
    + "compares it with 'compareTo(...) == 0' and whose 'hash' returns 'toCanonicalBits() as "
    + "long'.");
    try sema_support.assertMentions(diagnostics, "'index<Reading>' cannot use 'Reading' as a Map "
    + "key: its field 'value' has type 'double', which has no hash; a NaN is equal to no value, "
    + "so nothing could find it again, and negative zero is equal to zero but hashes "
    + "differently, so one key would become two entries. Pass a type argument with a hash of its "
    + "own, or give 'Reading' its own 'equals' and 'hash', comparing each floating-point field "
    + "with 'compareTo(...) == 0' and hashing it with 'toCanonicalBits() as long'.");
}

test "a refusal and its note each name types as their own file does" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/shapes.ens", "public struct Path \{\n    public const string text;\n\}\n");
    loader.add("/proj/src/lib/slots.ens",
        "public class Slots<T> \{\n"
        + "    T[] items;\n"
        + "    public constructor(long count) \{\n"
        + "        this.items = new T[count];\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.slots as store;\n"
        + "import Path as Location from shapes;\n"
        + "main() -> int \{\n"
        + "    let held = new store.Slots<Location>(3);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);

    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    // The refusal lands in main.ens, which reaches the generic through 'store' and calls the
    // element type 'Location'; the note lands in the generic's own file, which calls them
    // 'Slots<T>' and 'T'.
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'store.Slots<Location>' cannot use 'Location' as an array element type: a new array's "
        + "slots start as zero, which is not a valid 'Location'. Field 'text' of 'Location' is "
        + "'const' with no default value, so nothing could assign it in a new array's slot. Give "
        + "the field a default value, or pass a type argument that makes the element type "
        + "nullable.");
    let related = try sema_support.relatedOf(diagnostics[0]);
    try testing.assertEqual(related.file(), "/proj/src/lib/slots.ens");
    try testing.assertEqual(related.note(), "'Slots<T>' creates an array of 'T' here");
}
