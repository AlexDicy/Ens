// The switch validation matrix: scrutinee kinds, label rules and duplicates, 'is' arm targets
// and reachability, and exhaustiveness for enums and sealed hierarchies.
import @std.testing;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;

private analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    return analysis;
}

test "enum labels resolve while duplicates and unknown members are reported" {
    let analysis = try analyzeOne("enum Color \{ Red, Green, Blue, \}\n"
        + "main() -> int \{\n"
        + "    const Color c = Color.Red;\n"
        + "    switch (c) \{\n"
        + "        Red -> \{ \},\n"
        + "        Color.Red -> \{ \},\n"
        + "        Purple -> \{ \},\n"
        + "        Green -> \{ \},\n"
        + "        Blue -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Duplicate switch label 'Red'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'Purple' is not a member of enum 'Color'.");
}

test "a non-exhaustive enum switch names the missing members" {
    let analysis = try analyzeOne("enum Color \{ Red, Green, Blue, \}\n"
        + "main() -> int \{\n"
        + "    const Color c = Color.Red;\n"
        + "    switch (c) \{\n"
        + "        Red -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "This switch does not handle enum 'Color' member(s) 'Green', 'Blue'. Add them or a "
        + "'default' arm.");
}

test "integer switches need constant labels, distinct values, and a default" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    let x = 3;\n"
        + "    let y = 2;\n"
        + "    switch (x) \{\n"
        + "        'A' -> \{ \},\n"
        + "        65 -> \{ \},\n"
        + "        y -> \{ \},\n"
        + "        \"one\" -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    switch (y) \{\n"
        + "        1 -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Duplicate switch label '65'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Switch labels for an integer switch must be integer constants.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Switch label of type 'string' does not match the switch value of type 'int'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch on 'int' must have a 'default' arm.");
}

test "string switches take distinct literal labels of the right type" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    string s = \"a\";\n"
        + "    switch (s) \{\n"
        + "        \"x\" -> \{ \},\n"
        + "        \"x\" -> \{ \},\n"
        + "        s -> \{ \},\n"
        + "        3 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Duplicate switch label 'x'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Switch labels for a string switch must be string literals.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Switch label of type 'int' does not match the switch value of type 'string'.");
}

test "one default arm and a supported scrutinee kind are required" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    let x = 1;\n"
        + "    switch (x) \{\n"
        + "        1 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    bool flag = true;\n"
        + "    switch (flag) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch can have only one 'default' arm.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot switch on a value of type 'bool'; switch supports enum, integer, string, and "
        + "class values.");
}

test "'is' arm targets must be classes that can match without always matching" {
    let analysis = try analyzeOne("class Base \{ constructor(); \}\n"
        + "class Left extends Base \{ constructor() \{ super(); \} \}\n"
        + "class Right extends Base \{ constructor() \{ super(); \} \}\n"
        + "class Lone \{ constructor(); \}\n"
        + "struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Base b = new Left();\n"
        + "    switch (b) \{\n"
        + "        is Lone -> \{ \},\n"
        + "        is Base -> \{ \},\n"
        + "        is Point -> \{ \},\n"
        + "        is Left -> \{ \},\n"
        + "        is Right -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A value of type 'Base' can never be a 'Lone'; this arm would never match. Remove "
        + "it.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'is Base' matches every value of this switch over 'Base'; use a 'default' arm "
        + "instead.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "The type of an 'is' arm must be a class or an interface, got 'Point'.");
}

test "arm order, label mixing, and the class-value arm requirement are checked" {
    let analysis = try analyzeOne("class Shape \{ constructor(); \}\n"
        + "class Circle extends Shape \{ constructor() \{ super(); \} \}\n"
        + "class Dot extends Circle \{ constructor() \{ super(); \} \}\n"
        + "main() -> int \{\n"
        + "    Shape s = new Dot();\n"
        + "    switch (s) \{\n"
        + "        is Circle -> \{ \},\n"
        + "        is Dot -> \{ \},\n"
        + "        5 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    switch (s) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    let x = 1;\n"
        + "    switch (x) \{\n"
        + "        is Circle -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "This 'is Dot' arm is unreachable: the earlier 'is Circle' arm already matches every "
        + "'Dot'. Move it before the broader arm, or remove it.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot mix value labels with 'is' arms in the same switch.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch over a class value needs at least one 'is Type ->' arm.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "An 'is' arm needs a class switch value, but this switch is over 'int'.");
}

test "sealed hierarchies drive type switch exhaustiveness" {
    let analysis = try analyzeOne("sealed abstract class Expr \{ constructor(); \}\n"
        + "class Num extends Expr \{ constructor() \{ super(); \} \}\n"
        + "class Neg extends Expr \{ constructor() \{ super(); \} \}\n"
        + "class DoubleNeg extends Neg \{ constructor() \{ super(); \} \}\n"
        + "sealed class Token \{ constructor(); \}\n"
        + "class Word extends Token \{ constructor() \{ super(); \} \}\n"
        + "interface Marker \{ \}\n"
        + "class Tagged implements Marker \{ constructor(); \}\n"
        + "class Open \{ constructor(); \}\n"
        + "class Sub extends Open \{ constructor() \{ super(); \} \}\n"
        + "main() -> int \{\n"
        + "    Expr e = new Num();\n"
        + "    switch (e) \{\n"
        + "        is Num -> \{ \},\n"
        + "    \}\n"
        + "    switch (e) \{\n"
        + "        is Num -> \{ \},\n"
        + "        is Neg -> \{ \},\n"
        + "    \}\n"
        + "    Token t = new Word();\n"
        + "    switch (t) \{\n"
        + "        is Word -> \{ \},\n"
        + "    \}\n"
        + "    Marker m = new Tagged();\n"
        + "    switch (m) \{\n"
        + "        is Tagged -> \{ \},\n"
        + "    \}\n"
        + "    Open o = new Sub();\n"
        + "    switch (o) \{\n"
        + "        is Sub -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "This switch does not handle subclass(es) 'Neg' of sealed class 'Expr'. Add arms for "
        + "them or a 'default' arm.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch over 'Token' must have a 'default' arm: 'Token' is concrete, so a value "
        + "may be a plain 'Token' that no subclass arm matches.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch over 'Marker' must have a 'default' arm: interfaces are open, so any class "
        + "anywhere may implement 'Marker'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "A switch over 'Open' must have a 'default' arm because 'Open' is not sealed.");
}

test "a duplicate 'null' label is reported" {
    let analysis = try analyzeOne("len(string? s) -> int \{\n"
        + "    return switch (s) \{\n"
        + "        \"hi\" -> 2,\n"
        + "        null -> -1,\n"
        + "        null -> -2,\n"
        + "        default -> 0,\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{ return len(null); \}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(), "Duplicate 'null' label.");
}
