import @std.testing;
import ClassType from model.types;
import EnumType from model.types;
import InterfaceType from model.types;
import StructType from model.types;
import ExternalType from model.types;
import Type from model.types;
import PrimitiveKind from model.types;
import FakeFileLoader from sema_support;
import sema_support;

test "a named import binds the target module's type by identity" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import lib.box;\nimport Box from lib.box;\n");
    loader.add("/proj/src/lib/box.ens",
        "public class Box \{ \}\npublic doubled(int x) -> int \{ return x * 2; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let bound = try sema_support.boundType(pipeline, "main", "Box");
    try testing.assertTrue(bound == pipeline.store().findDeclared("lib.box", "Box"),
        "the binding should be the interned type object");
    try testing.assertTrue(bound is ClassType, "Box should link as a class");
    let namespace = try sema_support.boundNamespace(pipeline, "main", "box");
    try testing.assertEqual(namespace, "lib.box");
}

test "named imports bind every declared type kind" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import Color from lib.zoo;\n"
        + "import Speaker from lib.zoo;\n"
        + "import Point from lib.zoo;\n");
    loader.add("/proj/src/lib/zoo.ens",
        "public enum Color \{ Red \}\n"
        + "public interface Speaker \{ speak() -> string; \}\n"
        + "public struct Point \{ int x; \}\n"
        + "external type HANDLE;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Color") is EnumType,
        "Color should link as an enum");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Speaker")
        is InterfaceType, "Speaker should link as an interface");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Point") is StructType,
        "Point should link as a struct");
}

test "an external type is private to its file and cannot be imported" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import HANDLE from lib.zoo;\n");
    loader.add("/proj/src/lib/zoo.ens", "external type HANDLE;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertDiagnostic(pipeline.linkResult().diagnostics(), 0,
        "/proj/src/main.ens", "Type 'HANDLE' is private to module 'lib.zoo', so only that file can "
        + "use it. Mark it 'public' to use it from other modules in the package.");
}

test "circular imports link cleanly in both directions" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/left.ens",
        "import right;\nimport Right from right;\npublic class Left \{ \}\n");
    loader.add("/proj/src/right.ens",
        "import left;\nimport Left from left;\npublic class Right \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["left.ens"]);

    try sema_support.assertClean(pipeline);
    try testing.assertTrue(try sema_support.boundType(pipeline, "left", "Right")
        == pipeline.store().findDeclared("right", "Right"), "left should see right's class");
    try testing.assertTrue(try sema_support.boundType(pipeline, "right", "Left")
        == pipeline.store().findDeclared("left", "Left"), "right should see left's class");
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "left", "right"), "right");
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "right", "left"), "left");
}

test "a package namespace import binds the last segment to the canonical module" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/tools\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme.tools;\n\}\n");
    loader.add("/proj/vendor/tools/ens.package", "package acme.tools \{ ens \"0.1\"; \}\n");
    loader.add("/proj/src/main.ens", "import @acme.tools.hammer;\n");
    loader.add("/proj/vendor/tools/src/hammer.ens", "public class Hammer \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let namespace = try sema_support.boundNamespace(pipeline, "main", "hammer");
    try testing.assertEqual(namespace, "acme.tools.hammer");
}

test "a failed named import is silenced when another import binds the name as a type" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import Gadget from lib.tools;\nimport Gadget from lib.parts;\n");
    loader.add("/proj/src/lib/tools.ens", "public Gadget() \{ \}\n");
    loader.add("/proj/src/lib/parts.ens", "public class Gadget \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Gadget")
        == pipeline.store().findDeclared("lib.parts", "Gadget"),
        "the class import should win and silence the function import");
}

test "duplicate declarations register the first one, which imports then resolve to" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/other.ens", "import Box from main;\n");
    loader.add("/proj/src/main.ens", "public class Box \{ \}\npublic struct Box \{ int x; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["other.ens", "main.ens"]);

    try testing.assertEqual(pipeline.declareDiagnostics().length, 1L);
    try sema_support.assertNoDiagnostics(pipeline.linkResult().diagnostics());
    try testing.assertTrue(try sema_support.boundType(pipeline, "other", "Box") is ClassType,
        "the first declaration should be the one imports bind to");
}

test "an alias replaces the last segment a namespace import binds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import lib.box as crate;\nimport lib.box as parcel;\n");
    loader.add("/proj/src/lib/box.ens", "public class Box \{ \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "main", "crate"), "lib.box");
    try testing.assertEqual(try sema_support.boundNamespace(pipeline, "main", "parcel"), "lib.box");
    let table = pipeline.linkResult().tableFor("main");
    if (table == null) {
        try testing.fail("main should have a link table");
    } else {
        try testing.assertTrue(table.binding("box") == null,
            "the last segment is not bound when an alias replaces it");
    }
}

test "an alias replaces the name a named import binds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import Kind as SizeKind from lib.sizes;\n"
        + "import Kind as ColorKind from lib.colors;\n"
        + "import Kind as Kind from lib.sizes;\n");
    loader.add("/proj/src/lib/sizes.ens", "public enum Kind \{ Small \}\n");
    loader.add("/proj/src/lib/colors.ens", "public enum Kind \{ Red \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "SizeKind")
        == pipeline.store().findDeclared("lib.sizes", "Kind"),
        "SizeKind should be the Kind of lib.sizes");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "ColorKind")
        == pipeline.store().findDeclared("lib.colors", "Kind"),
        "ColorKind should be the Kind of lib.colors");
    try testing.assertTrue(try sema_support.boundType(pipeline, "main", "Kind")
        == pipeline.store().findDeclared("lib.sizes", "Kind"),
        "an alias equal to the name binds it as written");
}

// A file names the type it declares and the type it imports, and a type it has no name for
// reads on its own, with the module after it where three modules declare that name.
test "a type is spelled as the file naming it can name it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/alpha/kinds.ens", "public enum Kind \{ One \}\n");
    loader.add("/proj/src/beta/kinds.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/gamma/kinds.ens", "public enum Kind \{ Three \}\n");
    loader.add("/proj/src/main.ens",
        "import Kind as Sort from alpha.kinds;\n"
        + "import beta.kinds;\n"
        + "public struct Local \{ int x; \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens", "gamma/kinds.ens"]);

    try sema_support.assertClean(pipeline);
    let names = try sema_support.namesOf(pipeline, "main");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "alpha.kinds",
        "Kind")), "Sort");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "beta.kinds",
        "Kind")), "Kind (from beta.kinds)");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "gamma.kinds",
        "Kind")), "Kind (from gamma.kinds)");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "main",
        "Local")), "Local");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "std.core",
        "Error")), "Error");
}

test "each file spells one type the way its own imports reach it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/beta/kinds.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/main.ens", "import Kind as Sort from beta.kinds;\nimport other;\n");
    loader.add("/proj/src/other.ens", "import Kind from beta.kinds;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let kind = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    try testing.assertEqual((try sema_support.namesOf(pipeline, "main")).of(kind), "Sort");
    try testing.assertEqual((try sema_support.namesOf(pipeline, "other")).of(kind), "Kind");
    try testing.assertEqual((try sema_support.namesOf(pipeline, "beta.kinds")).of(kind), "Kind");
}

// A module import binds the module's name and nothing under the type's own name, so the file
// that writes one still has no name for the type.
test "a module import leaves the module's types unnamed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/beta/kinds.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/main.ens", "import beta.kinds;\nimport other;\n");
    loader.add("/proj/src/other.ens", "import beta.kinds as sorts;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let kind = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    try testing.assertFalse((try sema_support.namesOf(pipeline, "main")).canSpell(kind),
        "a module import binds no name for the type");
    try testing.assertEqual((try sema_support.namesOf(pipeline, "main")).of(kind), "Kind");
    try testing.assertEqual((try sema_support.namesOf(pipeline, "other")).of(kind), "Kind");
}

test "an alias is the name even where the bare one is in scope" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import Error as Failure from @std.core;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let names = try sema_support.namesOf(pipeline, "main");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "std.core",
        "Error")), "Failure");
}

test "a name the file declares itself sends the implicit type to its module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "public class Error \{\n    public constructor() \{ \}\n\}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let names = try sema_support.namesOf(pipeline, "main");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "main", "Error")),
        "Error");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "std.core",
        "Error")), "Error (from std.core)");
}

// A type the file names reads by that name in every shape, and the module a type it has no name
// for carries follows the type arguments rather than the name.
test "a file's spelling composes through every shape a type takes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/alpha/kinds.ens", "public enum Kind \{ One \}\n");
    loader.add("/proj/src/beta/boxes.ens", "public class Box<T> \{\n    public constructor() \{ \}\n\}\n");
    loader.add("/proj/src/gamma/boxes.ens", "public class Box<T> \{\n    public constructor() \{ \}\n\}\n");
    loader.add("/proj/src/main.ens",
        "import Kind as Sort from alpha.kinds;\nimport Box from beta.boxes;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens", "gamma/boxes.ens"]);

    try sema_support.assertClean(pipeline);
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    Type sort = try sema_support.declaredType(pipeline, "alpha.kinds", "Kind");
    let box = try sema_support.declaredType(pipeline, "beta.boxes", "Box");
    let other = try sema_support.declaredType(pipeline, "gamma.boxes", "Box");
    try testing.assertEqual(names.of(store.arrayOf(sort)), "Sort[]");
    try testing.assertEqual(names.of(store.optionalOf(sort)), "Sort?");
    try testing.assertEqual(names.of(box), "Box<T>");
    try testing.assertEqual(names.of(store.optionalOf(store.instantiationOf(box, [sort]))),
        "Box<Sort>?");
    try testing.assertEqual(names.of(other), "Box<T> (from gamma.boxes)");
    try testing.assertEqual(names.of(store.optionalOf(store.instantiationOf(other, [sort]))),
        "Box<Sort> (from gamma.boxes)?");
    Type predicate = store.functionOf([sort], store.primitive(PrimitiveKind.Bool), []);
    try testing.assertEqual(names.of(predicate), "(Sort) -> bool");
    try testing.assertEqual(names.nullableOf(predicate), "((Sort) -> bool)?");
    try testing.assertEqual(names.of(store.arrayOf(store.functionOf([], sort, []))),
        "(() -> Sort)[]");
}

// The imported one keeps the bare name, and the module follows the other through every shape it
// takes, so one message can hold both.
test "two types of one name are distinguished by what the file calls each" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/alpha/kinds.ens", "public enum Kind \{ One \}\n");
    loader.add("/proj/src/beta/kinds.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/main.ens", "import Kind from alpha.kinds;\nimport beta.kinds;\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "alpha.kinds",
        "Kind")), "Kind");
    Type later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    try testing.assertEqual(names.of(later), "Kind (from beta.kinds)");
    try testing.assertEqual(names.of(store.arrayOf(later)), "Kind (from beta.kinds)[]");
    try testing.assertEqual(names.of(store.optionalOf(later)), "Kind (from beta.kinds)?");
}

test "a file the program never linked spells every type by its own name" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "public class Box \{\n    public constructor() \{ \}\n\}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);

    try sema_support.assertClean(pipeline);
    let names = pipeline.linkResult().namesByFile().namesFor("/proj/src/absent.ens");
    // Nothing records what that file could write, so every type reads by its declared name and
    // no name is left out of a message for want of one.
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "std.core",
        "Error")), "Error");
    try testing.assertEqual(names.of(try sema_support.declaredType(pipeline, "main", "Box")),
        "Box");
    try testing.assertEqual(names.of(pipeline.store().primitive(PrimitiveKind.Int)), "int");
}
