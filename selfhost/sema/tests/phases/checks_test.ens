import FakeFileLoader from sema_support;
import sema_support;

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes a class with no constructor is offered compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Hidden \{\n"
        + "    protected constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "    constructor(int count) \{ super(count); \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int width, string label = \"wide\") \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "    constructor(int width) \{ super(width); \}\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "\}\n"
        + "public class Mixed \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class OverMixed extends Mixed \{\n"
        + "    constructor(int width) \{ super(width); \}\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    protected constructor(T value) \{ \}\n"
        + "\}\n"
        + "class IntHolder extends Holder<int> \{\n"
        + "    constructor(int value) \{ super(value); \}\n"
        + "\}\n"
        + "class Wrapped<T> extends Holder<T> \{\n"
        + "    constructor(T value) \{ super(value); \}\n"
        + "\}\n"
        + "class Failure extends Error \{\n"
        + "    constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let hidden = new OverHidden(1);\n"
        + "    let sized = new OverSized(2);\n"
        + "    let guarded = new OverGuarded();\n"
        + "    let mixed = new OverMixed(3);\n"
        + "    let held = new IntHolder(4);\n"
        + "    let wrapped = new Wrapped<string>(\"five\");\n"
        + "    let failure = new Failure(\"six\");\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// The implicit chain picks a zero-argument constructor the class can reach, so a private one gives
// way to a reachable one whose parameters all take defaults.
test "an unreachable zero-argument base constructor gives way to a reachable one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Base \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int count = 4) \{ \}\n"
        + "\}\n"
        + "class Plain extends Base \{\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Leaf extends Plain \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let plain = new Plain();\n"
        + "    let declared = new Declared();\n"
        + "    let leaf = new Leaf();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes that import what they name compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens",
        "public class Widget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Gadget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor(Widget widget, Gadget[] gadgets) \{ \}\n"
        + "\}\n"
        + "export class Plain \{\n"
        + "    export constructor(int count) \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from parts;\n"
        + "import Plain from parts;\n"
        + "import Widget as PartsWidget from parts;\n"
        + "import Gadget from parts;\n"
        + "class Widget \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Child extends Base \{\n"
        + "    public constructor(PartsWidget widget, Gadget[] gadgets) \{ super(widget, gadgets); \}\n"
        + "\}\n"
        + "export class Shared extends Plain \{\n"
        + "    export constructor(int count) \{ super(count); \}\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor(int size, PartsWidget widget, Gadget[] gadgets) \{\n"
        + "        super(widget, gadgets);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let child = new Child(new PartsWidget(), [new Gadget()]);\n"
        + "    let shared = new Shared(1);\n"
        + "    let declared = new Declared(2, new PartsWidget(), []);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}
