// Type-level members through the sema phases: the model lists they land in, the constants on
// static const fields, and the rules a static of a generic type and a lazy const answer to.
import @std.testing;
import ProgramAnalysis from pipeline;
import ConstantKind from model.literalvalues;
import model.literalvalues;
import sema_support;
import FakeFileLoader from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    return analysis;
}

test "statics land beside the instance members, outside layout and dispatch" {
    let analysis = try analyzeOne(
        "public class Path \{\n"
        + "    public static const string separator = \"/\";\n"
        + "    public static const int limit = 10;\n"
        + "    public static const int doubled = Path.limit * 2 + 1;\n"
        + "\n"
        + "    public static join(string left, string right) -> string \{\n"
        + "        return left + Path.separator + right;\n"
        + "    \}\n"
        + "\n"
        + "    public describe() -> string \{\n"
        + "        return Path.separator;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(Path.join(\"a\", \"b\"));\n"
        + "    return Path.limit - 10;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let path = try sema_support.classNamed(analysis, "main", "Path");
    try testing.assertEqual(path.fields().length(), 0L);
    try testing.assertEqual(path.methods().length(), 1L);
    try testing.assertEqual(path.staticFields().length(), 3L);
    try testing.assertEqual(path.staticMethods().length(), 1L);
    try testing.assertTrue(path.staticMethods().get(0).isStatic(),
        "the static list must carry the marker");
    try testing.assertTrue(!path.methods().get(0).isStatic(),
        "an instance method must not carry the marker");
    let separator = path.staticFields().get(0).constantValue();
    try testing.assertTrue(separator != null, "'separator' should have evaluated");
    if (separator != null) {
        try testing.assertTrue(separator.kind() == ConstantKind.String, "a string constant");
        try testing.assertEqual(separator.text(), "/");
    }
    let doubled = path.staticFields().get(2).constantValue();
    try testing.assertTrue(doubled != null, "'doubled' should have evaluated");
    if (doubled != null) {
        try testing.assertEqual(doubled.integerBits(), 21L);
    }
}

test "the three type-argument forms resolve a generic type's static" {
    let analysis = try analyzeOne(
        "public class Registry<T> \{\n"
        + "    T?[] slots;\n"
        + "\n"
        + "    public constructor(T?[] slots) \{\n"
        + "        this.slots = slots;\n"
        + "    \}\n"
        + "\n"
        + "    public static withCapacity(long capacity) -> Registry<T> \{\n"
        + "        return new Registry<T>(new T?[capacity]);\n"
        + "    \}\n"
        + "\n"
        + "    public static of(T[] values) -> Registry<T> \{\n"
        + "        T?[] copied = new T?[values.length];\n"
        + "        for (long i = 0; i < copied.length; i++) \{\n"
        + "            copied[i] = values[i];\n"
        + "        \}\n"
        + "        return new Registry<T>(copied);\n"
        + "    \}\n"
        + "\}\n"
        + "build() -> Registry<bool> \{\n"
        + "    return Registry.withCapacity(2);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let explicit = Registry<int>.withCapacity(8);\n"
        + "    let inferred = Registry.of([\"a\", \"b\"]);\n"
        + "    Registry<char> targeted = Registry.withCapacity(4);\n"
        + "    let built = build();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.exceptionDiagnostics());
}

test "statics are reached only through the declaring type's name" {
    let analysis = try analyzeOne(
        "public class Widget \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static make() -> Widget \{\n"
        + "        return new Widget();\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair<A, B> \{\n"
        + "    public A first;\n"
        + "    public B second;\n"
        + "\n"
        + "    public static describe() -> string \{\n"
        + "        return \"pair\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let widget = Widget.make();\n"
        + "    let bad = widget.make();\n"
        + "    let bare = Pair.describe();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Use 'Widget.make(...)'; a static belongs to the type, not to an instance.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot tell the type arguments for 'Pair.describe': neither the call's arguments nor "
        + "the surrounding context supplies them. Write them on the type name, as in "
        + "'Pair<A, B>.describe(...)'.");
}

test "a static const initializer follows the member visibility rules" {
    let analysis = try analyzeOne(
        "public class Secret \{\n"
        + "    static const int hidden = 5;\n"
        + "\}\n"
        + "public class Reader \{\n"
        + "    public static const int copy = Secret.hidden + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "'hidden' is private to class 'Secret', so the initializer of 'Reader.copy' cannot "
        + "read it.");
}

test "a static const evaluates across modules in dependency order" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public class Config \{\n"
        + "    public static const int width = 6;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Config from lib;\n"
        + "public class Screen \{\n"
        + "    public static const int total = Config.width * 7;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Screen.total - 42;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let screen = try sema_support.classNamed(analysis, "main", "Screen");
    let total = screen.staticFields().get(0).constantValue();
    try testing.assertTrue(total != null, "'total' should have evaluated");
    if (total != null) {
        try testing.assertEqual(total.integerBits(), 42L);
    }
}

test "a lazy const lands beside the statics and takes no compile-time value" {
    let analysis = try analyzeOne(
        "public class Reader \{\n"
        + "    public const string text;\n"
        + "\n"
        + "    public constructor(this.text);\n"
        + "\}\n"
        + "makeReader() -> Reader \{\n"
        + "    return new Reader(\"in\");\n"
        + "\}\n"
        + "public class Streams \{\n"
        + "    public lazy const Reader input = makeReader();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Streams.input.text.length as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.exceptionDiagnostics());
    let streams = try sema_support.classNamed(analysis, "main", "Streams");
    try testing.assertEqual(streams.fields().length(), 0L);
    try testing.assertEqual(streams.staticFields().length(), 1L);
    let input = streams.staticFields().get(0);
    try testing.assertTrue(input.isLazy(), "the lazy marker must reach the model");
    try testing.assertTrue(!input.isStatic(), "'lazy' is not 'static'");
    try testing.assertTrue(input.constantValue() == null,
        "a lazy const holds no compile-time value");
}

test "a lazy const field refuses 'static', a missing 'const', and a missing initializer" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Refused \{\n"
        + "    public static lazy const long both = 1;\n"
        + "    public lazy long unmarked = 2;\n"
        + "    public lazy const long missing;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A 'lazy const' field already belongs to the type itself, so it cannot also be "
        + "'static': a static const holds a compile-time constant, while a lazy const builds "
        + "its value on the first read. Remove 'static'.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A 'lazy' field must also be 'const'; its value is built once on the first read and "
        + "never changes. Write 'lazy const long unmarked = ...', or make 'unmarked' an "
        + "instance field.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Lazy const 'missing' needs its value on the declaration, because nothing else ever "
        + "assigns it: write 'lazy const long missing = ...'.");
}

test "two lazy const initializers that read each other close a cycle" {
    let analysis = try analyzeOne(
        "public class Cycle \{\n"
        + "    public lazy const long first = Cycle.second + 1;\n"
        + "    public lazy const long second = Cycle.first + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Cycle.first as int;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "'Cycle.second' cannot take its value from 'Cycle.first' here: the chain of lazy "
        + "consts between them closes a cycle. Break the cycle by building one of the two "
        + "values without reading the other.");
}

test "a lazy const initializer may not throw and its value never takes an assignment" {
    let analysis = try analyzeOne(
        "class Boom extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "risky() -> long throws \{\n"
        + "    throw new Boom(\"no\");\n"
        + "\}\n"
        + "public class Refused \{\n"
        + "    public lazy const long value = risky();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Refused.value = 3;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.exceptionDiagnostics(),
        "The initializer of lazy const 'Refused.value' cannot call 'risky' because it can "
        + "throw 'Boom'; it must not throw.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign to 'Refused.value': a lazy const takes its one value from its "
        + "initializer and never changes. Change the initializer, or use an instance field.");
}

test "a throwing static factory demands 'try' at its call sites" {
    let analysis = try analyzeOne(
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Parsed \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static parse(string text) -> Parsed throws \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Failure(\"empty\");\n"
        + "        \}\n"
        + "        return new Parsed();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let parsed = Parsed.parse(\"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.exceptionDiagnostics(),
        "Call to 'parse' can throw 'Failure'; prefix it with 'try'");
}
