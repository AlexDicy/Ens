import FakeFileLoader from sema_support;
import sema_support;

test "an unmarked member of a file-private class is inherited, overridden, and provides a requirement" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Measured \{\n"
        + "    measure() -> int;\n"
        + "\}\n"
        + "public class Meter \{\n"
        + "    public constructor();\n"
        + "    public reading() -> int \{ return 1; \}\n"
        + "\}\n"
        + "abstract class Shape implements Measured \{\n"
        + "    int sides;\n"
        + "    constructor(this.sides);\n"
        + "    abstract area() -> int;\n"
        + "    final corners() -> int \{ return this.sides; \}\n"
        + "    override measure() -> int \{ return this.area(); \}\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    int side;\n"
        + "    constructor(this.side) \{ super(4); \}\n"
        + "    override area() -> int \{ return this.side * this.side + this.sides; \}\n"
        + "\}\n"
        + "class Needle extends Meter \{\n"
        + "    constructor();\n"
        + "    override reading() -> int \{ return 7; \}\n"
        + "\}\n"
        + "class Dial extends Meter \{\n"
        + "    constructor();\n"
        + "    protected override reading() -> int \{ return 8; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}
