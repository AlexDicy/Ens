import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

// Every instantiation of 'Node' reaches the same field, so the chain from 'Node<int>' and the one
// from the field's own 'Node<Node<T>>' are refused once, at the type the field writes, with an
// example that starts at a type a program can write.
test "a generic that wraps its own type parameter in itself is refused once, at the type it writes" {
    let loader = new FakeFileLoader();
    string source = "class Node<T> \{\n"
        + "    Node<Node<T>>? child;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Use \{\n"
        + "    Node<int>? head;\n"
        + "    constructor();\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Node<int>' uses 'Node<Node<int>>', which uses 'Node<Node<Node<int>>>', and so on without end, "
        + "so no program can contain a value of these types. The types grow because 'Node' uses "
        + "'Node<Node<T>>', where its type parameter 'T' is inside another type. Change "
        + "'Node<Node<T>>' to 'Node<T>'.");
    try testing.assertEqual(found[0].span().start, source.indexOf("Node<Node<T>>"));
}

// A cycle through two generics is refused at each type in it that wraps a type parameter, and
// not at one that passes its type parameter on as it is.
test "a cycle through two generics is refused at each type that makes it grow" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Left<T> \{\n"
        + "    Right<T[]>? other;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Right<U> \{\n"
        + "    Left<U>? back;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Up<T> \{\n"
        + "    Down<T[]>? other;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Down<U> \{\n"
        + "    Up<U?>? back;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Use \{\n"
        + "    Left<int>? left;\n"
        + "    Up<int>? up;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Left<int>' uses 'Right<int[]>', which uses 'Left<int[]>', and so on without end, so no "
        + "program can contain a value of these types. The types grow because 'Left' uses "
        + "'Right<T[]>', where its type parameter 'T' is inside another type. Change 'Right<T[]>' to "
        + "'Right<T>'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'Up<int>' uses 'Down<int[]>', which uses 'Up<int[]?>', and so on without end, so no program "
        + "can contain a value of these types. The types grow because 'Up' uses 'Down<T[]>', where "
        + "its type parameter 'T' is inside another type. Change 'Down<T[]>' to 'Down<T>'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'Down<int[]>' uses 'Up<int[]?>', which uses 'Down<int[]?[]>', and so on without end, so no "
        + "program can contain a value of these types. The types grow because 'Down' uses 'Up<U?>', "
        + "where its type parameter 'U' is inside another type. Change 'Up<U?>' to 'Up<U>'.");
}

// Every instantiation of 'Twice' needs two larger ones, so expanding every branch to the depth
// limit would never finish. Each field still grows one chain, refused once at its own type.
test "a generic that grows through two fields is refused once for each" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Twice<T> \{\n"
        + "    Twice<T?>? first = null;\n"
        + "    Twice<T[]>? second = null;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Use \{\n"
        + "    Twice<int>? twice;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Twice<int>' uses 'Twice<int?>', which uses 'Twice<int??>', and so on without end, so no "
        + "program can contain a value of these types. The types grow because 'Twice' uses "
        + "'Twice<T?>', where its type parameter 'T' is inside another type. Change 'Twice<T?>' to "
        + "'Twice<T>'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'Twice<int>' uses 'Twice<int[]>', which uses 'Twice<int[][]>', and so on without end, so no "
        + "program can contain a value of these types. The types grow because 'Twice' uses "
        + "'Twice<T[]>', where its type parameter 'T' is inside another type. Change 'Twice<T[]>' to "
        + "'Twice<T>'.");
}

// A base clause is resolved like a field type, so the type argument it wraps is where the refusal
// is reported.
test "a base clause that wraps the type parameter is refused at the type argument it writes" {
    let loader = new FakeFileLoader();
    string source = "class Base<T> \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Grow<T> extends Base<Grow<T[]>> \{\n"
        + "    constructor();\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Grow<T[]>' uses 'Grow<T[][]>', which uses 'Grow<T[][][]>', and so on without end, so no "
        + "program can contain a value of these types. The types grow because 'Grow' uses "
        + "'Grow<T[]>', where its type parameter 'T' is inside another type. Change 'Grow<T[]>' to "
        + "'Grow<T>'.");
    try testing.assertEqual(found[0].span().start, source.indexOf("Grow<T[]>"));
}

// One type parameter cannot replace an argument that wraps two, so the refusal names both and
// suggests no replacement. Two parameters wrapped in two arguments are each replaced.
test "type parameters wrapped in one argument or in several are named with where they are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Duo<A, B> \{\n"
        + "    Duo<(A) -> B, B>? inner;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Twin<A, B> \{\n"
        + "    Twin<A[], B?>? inner;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Use \{\n"
        + "    Duo<int, string>? duo;\n"
        + "    Twin<int, string>? twin;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Duo<int, string>' uses 'Duo<(int) -> string, string>', which uses "
        + "'Duo<((int) -> string) -> string, string>', and so on without end, so no program can contain "
        + "a value of these types. The types grow because 'Duo' uses 'Duo<(A) -> B, B>', where its "
        + "type parameters 'A' and 'B' are inside another type.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'Twin<int, string>' uses 'Twin<int[], string?>', which uses 'Twin<int[][], string??>', and "
        + "so on without end, so no program can contain a value of these types. The types grow because "
        + "'Twin' uses 'Twin<A[], B?>', where its type parameters 'A' and 'B' are inside other types. "
        + "Change 'Twin<A[], B?>' to 'Twin<A, B>'.");
}
