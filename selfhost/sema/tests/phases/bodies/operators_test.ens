import @std.testing;
import sema_support;

test "a literal that does not fit reports once, without a second operator error" {
    let analysis = try sema_support.analyzeBody(["byte small = 3;", "byte sum = small + 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'small', a 'byte'. Declare 'sum' as 'ushort' and convert 'small' ('ushort sum = small as "
        + "ushort + 300;').");
}

test "a literal that does not fit a compared type reports once" {
    let analysis = try sema_support.analyzeBody(["byte small = 3;", "let ordered = small < 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'small', a 'byte'. Convert 'small' first ('small as ushort < 300').");
}

test "an untyped literal adapts on either side of every bitwise operator" {
    let analysis = try sema_support.analyzeBody(["uint flags = 0x12345678;",
        "uint low = flags & 0xFF;",
        "uint high = 0xFF00 | flags;",
        "uint flipped = flags ^ 0xFFFFFFFF;",
        "byte small = 0xF0;",
        "byte half = small >> 4;",
        "long wide = -16;",
        "long together = wide | 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a shift adapts an untyped distance to the value it shifts" {
    let analysis = try sema_support.analyzeBody(["uint flags = 1;",
        "uint spread = flags << 8;",
        "ulong wide = 0xFF;",
        "ulong narrowed = wide >> 4;",
        "short signedHalf = -2;",
        "short doubled = signedHalf << 1;",
        "int word = -8;",
        "int dropped = word >>> 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the zero-filling shift follows the same operand rules as the other two" {
    let analysis = try sema_support.analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags >>> spread;", "double places = 2.0;",
        "let moved = 64 >>> places;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'>>>' shifts a 'uint' here, so the shift distance must be a 'uint' too, but 'spread' has type "
            + "'byte'. Write 'spread as uint'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'>>>' needs an integer shift distance, but 'places' has type 'double'.");
}

test "two named integer types still need a cast on a bitwise operator" {
    let analysis = try sema_support.analyzeBody(["uint flags = 1;", "int width = 255;",
        "let low = flags & width;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'&' needs the same integer type on both sides, but 'flags' has type 'uint' and 'width' has type "
            + "'int'. Convert both sides to 'long', as in 'flags as long & width as long'.");
}

test "a shift distance of another named type names the value's type in the fix" {
    let analysis = try sema_support.analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags << spread;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'<<' shifts a 'uint' here, so the shift distance must be a 'uint' too, but 'spread' has type "
            + "'byte'. Write 'spread as uint'.");
}

test "an untyped literal left of a shift keeps its own type, so the distance is cast" {
    let analysis = try sema_support.analyzeBody(["uint spread = 3;", "let mask = 1 << spread;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'<<' shifts an 'int' here, so the shift distance must be an 'int' too, but 'spread' has type "
            + "'uint'. Write 'spread as int'.");
}

test "a bitwise operator rejects a non-integer by name" {
    let analysis = try sema_support.analyzeBody(["double scale = 2.5;", "let masked = scale & 1;",
        "let moved = 64 >> scale;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'&' needs integers on both sides, but 'scale' has type 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'>>' needs an integer shift distance, but 'scale' has type 'double'.");
}

test "a bitwise literal that does not fit reports once" {
    let analysis = try sema_support.analyzeBody(["byte mask = 0x0F;", "byte bits = mask & 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'mask', a 'byte'. Declare 'bits' as 'ushort' and convert 'mask' ('ushort bits = mask as "
        + "ushort & 300;').");
}

test "the complement operator takes every integer type and keeps it" {
    let analysis = try sema_support.analyzeBody(["byte small = 0x0F;", "byte flippedSmall = ~small;",
        "short signedHalf = 1;", "short flippedHalf = ~signedHalf;",
        "ushort halfWord = 1;", "ushort flippedWord = ~halfWord;",
        "int word = 5;", "int flippedInt = ~word;",
        "uint flags = 1;", "uint flippedFlags = ~flags;",
        "long wide = 1;", "long flippedWide = ~wide;",
        "ulong unsignedWide = 1;", "ulong flippedUnsigned = ~unsignedWide;",
        "char letter = 'A';", "char flippedLetter = ~letter;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the complement operator names the real type it refused" {
    let analysis = try sema_support.analyzeBody(["double scale = 2.5;", "let flippedScale = ~scale;",
        "bool ready = true;", "let flippedReady = ~ready;",
        "string label = \"flags\";", "let flippedLabel = ~label;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 3);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'scale' has type 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'ready' has type 'bool'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'label' has type 'string'.");
}

test "a shift distance literal that does not fit reports once" {
    let analysis = try sema_support.analyzeBody(["byte mask = 0x0F;", "byte bits = mask >> 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'mask', a 'byte'.");
}

// '++' and '--' report a place that cannot change first, and the refusal of the type beside it.
test "'++' on a place that cannot change keeps the refusal of the type" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected const bool flag = true;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "changes(Tally inner) \{\n"
        + "    inner.flag++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "The '++' operator cannot change field 'flag': "
        + "a 'const' field is assigned once when the object is constructed and never again. Remove "
        + "'const' from the field if it needs to change.");
    try sema_support.assertDiagnostic(reported, 1, file, "'++' works only on numbers, and 'inner.flag' has "
        + "type 'bool'. Use it on an integer or a floating-point variable, for example 'count++'.");
    try testing.assertEqual(reported.length, 2L);
}

// A reading operator adapts an untyped literal to the type the other side has without its '?'
// before it checks the sides. So its texts name that type, and a literal that does not fit is
// refused on its own. A literal inside parentheses adapts the same way.
test "a reading operator adapts a literal to the other side before it checks them" {
    let analysis = try sema_support.analyzeOne("reads(byte? a, byte x) \{\n"
        + "    int sum = a + 1;\n"
        + "    int big = a + 300;\n"
        + "    bool less = a < 1;\n"
        + "    int masked = a & 1;\n"
        + "    byte pair = x + (1);\n"
        + "    bool same = x == (1);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'a' has type 'byte?'. {sema_support.checkFirst("a")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'a', a 'byte?'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'a' has type 'byte?'. {sema_support.checkFirst("a")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'&' needs integers on both sides, but 'a' has type 'byte?'. {sema_support.checkFirst("a")}");
    try testing.assertEqual(reported.length, 4L);
}

// A shift whose value and distance can both be null names both types.
test "a shift with both sides nullable names both types" {
    let analysis = try sema_support.analyzeOne("shifts(int? x, int? y) \{\n"
        + "    x <<= y;\n"
        + "    int moved = x >> y;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string both = "an integer to shift and an integer shift distance, got 'int?' and 'int?'. Check 'x' "
        + "and 'y' for null first ('if (x != null && y != null)').";
    try sema_support.assertDiagnostic(reported, 0, file, "'<<=' needs an integer to shift and an integer "
        + "shift distance, but 'x' and 'y' both have type 'int?'. Check 'x' and 'y' for null first ('if (x "
        + "!= null && y != null)').");
    try sema_support.assertDiagnostic(reported, 1, file, "'>>' needs an integer to shift and an integer "
        + "shift distance, but 'x' and 'y' both have type 'int?'. Check 'x' and 'y' for null first ('if (x "
        + "!= null && y != null)').");
    try testing.assertEqual(reported.length, 2L);
}

// Each refusal names the value it refuses by its spelling. A comparison with 'null' on a value that
// can never be null is refused with the result the comparison always has.
test "an operator refusal names the operand it refuses and the result a null comparison always has" {
    let analysis = try sema_support.analyzeOne("enum Coded \{\n"
        + "    One = 1,\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    int i = 3;\n"
        + "    uint u = 4;\n"
        + "    double d = 2.5;\n"
        + "    bool flag = true;\n"
        + "    string? maybe = null;\n"
        + "    int shifted = d << 2;\n"
        + "    int mixed = i + u;\n"
        + "    bool both = flag && i;\n"
        + "    int negated = -\"x\";\n"
        + "    bool inverted = !i;\n"
        + "    bool never = i == null;\n"
        + "    bool always = null != i;\n"
        + "    string fallback = maybe ?? 3;\n"
        + "    double converted = Coded.One as double;\n"
        + "    int tried = try 5;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<<' shifts an integer, but 'd' has type 'double'.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs the same number type on both sides, but 'i' has type 'int' and 'u' has type 'uint'. "
        + "Convert both sides to 'long', as in 'i as long + u as long'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'&&' needs a 'bool' on both sides, but 'i' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Unary '-' needs a number, but '\"x\"' has type 'string'.");
    try sema_support.assertDiagnostic(reported, 4, file, "'!' negates a 'bool', but 'i' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'i' has type 'int', which can never be null, so 'i == null' is always false. Remove the "
        + "comparison, or declare 'i' as 'int?' if it should allow null.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'i' has type 'int', which can never be null, so 'null != i' is always true. Remove the "
        + "comparison, or declare 'i' as 'int?' if it should allow null.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "The fallback after '??' has type 'int', but it replaces 'maybe' when 'maybe' is null, so it must "
        + "have type 'string'.");
    try sema_support.assertDiagnostic(reported, 8, file,
        "Cannot convert enum 'Coded' to 'double' with 'as'. An enum whose members have values converts "
        + "only to an integer type, such as 'int' or 'long'.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'try' must be written directly before a call, and '5' is not a call. Move 'try' to the call that "
        + "can throw.");
    try testing.assertEqual(reported.length, 10L);
}

// A switch whose first arm matches every value is written without the switch, a 'null' argument
// gets a nullable type argument, and two number types meet in the narrowest type with every value of
// both, or get no fix when none has them.
test "a fix never changes a value and always compiles where it is pasted" {
    let analysis = try sema_support.analyzeOne(
        "class Shape \{\n    constructor();\n\}\n\nfinal class Circle extends "
        + "Shape \{\n    constructor() \{\n        super();\n    \}\n\}\n\nclass Node \{\n    "
        + "constructor();\n\}\n\nidentity<T>(T value) -> T \{\n    return value;\n\}\n\nclass Pair2<A, B> "
        + "\{\n    constructor();\n\n    static make(A first) -> int \{\n        return 1;\n    "
        + "\}\n\}\n\nforms(Shape s, Circle c, Node? maybe, int k, uint u, long l, ulong ul, char ch, short "
        + "sh, ushort us, int n) \{\n    let a = switch (s) \{\n        is Shape -> 1,\n    \};\n    let b = "
        + "switch (c) \{\n        is Circle -> k + 1,\n    \};\n    let v = switch (maybe) \{\n        is "
        + "Node -> 1,\n        null -> 3,\n        default -> 2,\n    \};\n    let m = identity(null);\n    "
        + "let j = Pair2.make(first: 1);\n    bool below = k < u;\n    bool wide = l < ul;\n    double sum = "
        + "ch + 1.5;\n    int total = sh + us;\n    long masked = k & l;\n    long kept = (n as long) ?? "
        + "3;\n\}\n\nmain() -> int \{\n    return 0;\n\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'is Shape' matches every value of this switch over 'Shape', so the switch always takes this arm. "
        + "Write '1' instead of the switch.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'is Circle' matches every value of this switch over 'Circle', so the switch always takes this "
        + "arm. Write 'k + 1' instead of the switch.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'is Node' matches every value of this switch over 'Node?' that is not null. Check 'maybe' for "
        + "null with 'if' instead of switching on it.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'identity' is generic, and this call does not show what its type argument 'T' is. Write it, as "
        + "in 'identity<int?>(null)'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "When the type arguments of 'Pair2' come from the arguments, the call cannot name its arguments, "
        + "and no argument gives 'B' a type. Write the type arguments after 'Pair2', as in 'Pair2<int, "
        + "int>.make(first: 1)'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' needs the same number type on both sides, but 'k' has type 'int' and 'u' has type 'uint'. "
        + "Convert both sides to 'long', as in 'k as long < u as long'.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' needs the same number type on both sides, but 'l' has type 'long' and 'ul' has type 'ulong'.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+' needs the same number type on both sides, but 'ch' has type 'char' and '1.5' has type "
        + "'double'. Convert 'ch' to 'double', as in 'ch as double + 1.5'.");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'+' needs the same number type on both sides, but 'sh' has type 'short' and 'us' has type "
        + "'ushort'. Convert both sides to 'int', as in 'sh as int + us as int'.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'&' needs the same integer type on both sides, but 'k' has type 'int' and 'l' has type 'long'. "
        + "Convert 'k' to 'long', as in 'k as long & l'.");
    try sema_support.assertDiagnostic(reported, 10, file,
        "'n as long' has type 'long', which can never be null, so the fallback after '??' is never used. "
        + "Remove '?? 3'.");
    try testing.assertEqual(reported.length, 11L);
}

test "a class still has no text form of its own for a concatenation" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let shape = new Shape();\n"
        + "    let joined = \"shape: \" + shape;\n"
        + "    let trailed = shape + \" sides\";\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot add a value of type 'Shape' to a string. Only a string, a number or a 'bool' can be added "
            + "to one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot add a string to a value of type 'Shape'. Only a string, a number or a 'bool' can be added "
            + "to one.");
    try testing.assertEqual(reported.length, 2L);
}

// Every operator that refuses an optional operand gives the same guidance when the operand is a
// checked mutable field: a comparison, a shift, a bitwise operator, string concatenation on
// either side, a prefix operator and '&&'. A compound form writes the result back. A field read
// from a call's result is written back through a local that stores the result.
test "an operator refused on a checked mutable field names the field and the local copy" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "    protected string? label = \"a\";\n"
        + "    protected bool? flag = true;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected all() \{\n"
        + "        if (this.count != null && this.label != null && this.flag != null) \{\n"
        + "            bool compared = this.count <= 3;\n"
        + "            this.count <<= 1;\n"
        + "            int shifted = 1 << this.count;\n"
        + "            this.count &= 1;\n"
        + "            this.label += \"x\";\n"
        + "            string joined = \"x\" + this.label;\n"
        + "            int negated = -this.count;\n"
        + "            bool inverted = !this.flag;\n"
        + "            int flipped = ~this.count;\n"
        + "            bool both = this.flag && true;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Tally \{\n"
        + "    return new Tally();\n"
        + "\}\n"
        + "temporary() \{\n"
        + "    make().count++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    new Tally().all();\n"
        + "    temporary();\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofCount = sema_support.unstableAdvice("'this.count'", "a field", "let count = this.count;");
    string ofFlag = sema_support.unstableAdvice("'this.flag'", "a field", "let flag = this.flag;");
    string backToCount = sema_support.unstableWriteAdvice("'this.count'", "let count = this.count;",
        "this.count");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'<=' compares numbers, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'<<=' shifts an integer, but 'this.count' has type 'int?'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'<<' needs an integer shift distance, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'&=' needs integers on both sides, but 'this.count' has type 'int?'. " + backToCount);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'+=' joins a string only when neither side can be null, but 'this.label' has type 'string?'. "
        + sema_support.unstableWriteAdvice("'this.label'", "let label = this.label;", "this.label"));
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'+' joins a string only when neither side can be null, but 'this.label' has type 'string?'. "
        + sema_support.unstableAdvice("'this.label'", "a field", "let label = this.label;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Unary '-' needs a number, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'!' negates a 'bool', but 'this.flag' has type 'bool?'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'this.count' has type 'int?'. " + ofCount);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'&&' needs a 'bool' on both sides, but 'this.flag' has type 'bool?'. " + ofFlag);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'++' works only on numbers, and 'make().count' has type 'int?'. "
        + "'make().count' is a field, so it can change at any time. A later read of it can be null "
        + "even after a null check. Store the result of 'make()' and the field in locals first ('let "
        + "makeResult = make(); let count = makeResult.count;'), check 'count', and write the result "
        + "back to 'makeResult.count'.");
    try testing.assertEqual(reported.length, 11L);
}
