// A call that returns no value is refused where its value is used, with the place it is written
// in named and the value that place needs. A call that never returns keeps the refusals of the
// places it is written in, and two calls joined where nothing reads the result are accepted.
import @std.testing;
import sema_support;
import Stage from sema_support;

test "a call that returns no value is refused where a declaration, a call or a return takes it" {
    let analysis = sema_support.analyzeProgram("class Box \{\n"
        + "    int count = nothing();\n"
        + "    lazy const int shared = nothing();\n"
        + "\n"
        + "    constructor(int count) \{\n"
        + "        this.count = count;\n"
        + "    \}\n"
        + "\n"
        + "    run(int limit = nothing()) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    int left;\n"
        + "    int right;\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "take(int value) \{\n"
        + "\}\n"
        + "\n"
        + "same<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "pick() -> int \{\n"
        + "    return nothing();\n"
        + "\}\n"
        + "\n"
        + "finish() \{\n"
        + "    return nothing();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    int typed = nothing();\n"
        + "    take(nothing());\n"
        + "    same(nothing());\n"
        + "    take(value: nothing());\n"
        + "    let box = new Box(nothing());\n"
        + "    Pair pair = \{left: 1, right: nothing()\};\n"
        + "    int assigned = 0;\n"
        + "    assigned = nothing();\n"
        + "    () -> int counted = () -> nothing();\n"
        + "    () -> void deferred = () -> take(nothing());\n"
        + "    string text = \"\{nothing()\}\";\n"
        + "    int[] items = [1, nothing()];\n"
        + "    void refused = nothing();\n"
        + "    () -> void longer = () -> take(averyLongFunctionNameThatGoesOnAndOn(1, 2));\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "averyLongFunctionNameThatGoesOnAndOn(int first, int second) \{\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 18L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the default value of field "
        + "'count'. Remove '= nothing()', or give 'count' a default 'int' value.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the value of lazy const "
        + "'Box.shared'. Give 'Box.shared' an initializer that builds an 'int' value.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the default value of parameter "
        + "'limit'. Remove '= nothing()', or give 'limit' a default 'int' value.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be returned from function 'pick'. "
        + "Call it as a statement of its own, as in 'nothing();', and return an 'int' value.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Function 'finish' returns nothing, so this 'return' cannot have a value. Call "
        + "'nothing()' as a statement of its own, and write 'return;' after it.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the initial value of 'typed'. Call "
        + "it as a statement of its own, as in 'nothing();', and give 'typed' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Call it as a "
        + "statement of its own, as in 'nothing();', and pass an 'int' value to 'take'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'same'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Call it as a "
        + "statement of its own, as in 'nothing();', and pass an 'int' value to 'take'.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to the constructor of "
        + "'Box'. Call it as a statement of its own, as in 'nothing();', and pass an 'int' value "
        + "to the constructor of 'Box'.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the value of field 'right'. Call "
        + "it as a statement of its own, as in 'nothing();', and give 'right' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be assigned to 'assigned'. Call it as "
        + "a statement of its own, as in 'nothing();', and assign 'assigned' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be returned from this lambda. Give "
        + "the lambda a block body that calls 'nothing()' as a statement of its own, and return "
        + "an 'int' value.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Give the lambda "
        + "a block body that calls 'nothing()' as a statement of its own, and pass an 'int' value "
        + "to 'take'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot fill an interpolation hole. Call it "
        + "as a statement of its own, as in 'nothing();', and remove '\{nothing()\}' from the "
        + "string.");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be an element of an array. Call it as "
        + "a statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "Variable 'refused' cannot have type 'void', because 'void' means no value. Give "
        + "'refused' the type of the value it stores.");
    try sema_support.assertDiagnostic(reported, 17, "/proj/src/main.ens",
        "'averyLongFunctionNameThatGoesOnAndOn' returns no value, so a call to it cannot be passed "
        + "to 'take'. Give the lambda a block body with the call as a statement of its own, and "
        + "pass an 'int' value to 'take'.");
}

test "a call that returns no value is refused where an operator, a condition or a member reads it" {
    let analysis = sema_support.analyzeProgram("struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "point() \{\n"
        + "\}\n"
        + "\n"
        + "raise() \{\n"
        + "    throw nothing();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    int? maybe = null;\n"
        + "    int sum = 1 + nothing();\n"
        + "    bool same = nothing() == nothing();\n"
        + "    bool negated = !nothing();\n"
        + "    bool both = flag && nothing();\n"
        + "    bool either = flag || nothing();\n"
        + "    let held = maybe ?? nothing();\n"
        + "    sum += nothing();\n"
        + "    if (nothing()) \{\n"
        + "    \}\n"
        + "    while (nothing()) \{\n"
        + "    \}\n"
        + "    int picked = nothing() ? 1 : 2;\n"
        + "    string shown = nothing().toString();\n"
        + "    int read = point().x;\n"
        + "    long hashed = nothing().hash();\n"
        + "    let indexed = nothing()[0];\n"
        + "    nothing()();\n"
        + "    let converted = nothing() as int;\n"
        + "    for (let item in nothing()) \{\n"
        + "    \}\n"
        + "    switch (nothing()) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    bool acted = flag && action()();\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "action() -> () -> void \{\n"
        + "    return () -> nothing();\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 20L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to throw.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be compared with '=='. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '!'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '&&'. Call it in an 'if' "
        + "statement, as in 'if (flag) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '||'. Call it in an 'if' "
        + "statement, as in 'if (!flag) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '??'. Call it in an 'if' "
        + "statement, as in 'if (maybe == null) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+='. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this 'if'. Call "
        + "it as a statement of its own, as in 'nothing();', and give the 'if' a 'bool' "
        + "condition.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this 'while'. "
        + "Give the 'while' a 'bool' condition.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this '?:'. Call "
        + "it as a statement of its own, as in 'nothing();', and give the '?:' a 'bool' "
        + "condition.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call 'toString' on.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'point' returns no value, so there is no value to read 'x' from.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call 'hash' on.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to index.");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call.");
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to convert with 'as'.");
    try sema_support.assertDiagnostic(reported, 17, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to loop over.");
    try sema_support.assertDiagnostic(reported, 18, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to switch on.");
    try sema_support.assertDiagnostic(reported, 19, "/proj/src/main.ens",
        "This call returns no value, so it cannot be used with '&&'. Write it in an 'if' "
        + "statement, as in 'if (flag) \{ action()(); \}'.");
}

// A '?:' or a switch whose values are calls that return nothing is refused once, and a '?:'
// written as a statement of its own is accepted. Where no statement can be written, as in a
// field's default value, the refusal stops after why. A call that never returns keeps the refusal
// of the place it is written in.
test "a '?:' or a switch of calls that return no value is refused once" {
    let analysis = sema_support.analyzeProgram("noreturn fail() \{\n"
        + "    panic(\"failed\");\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "other() \{\n"
        + "\}\n"
        + "\n"
        + "third() \{\n"
        + "\}\n"
        + "\n"
        + "fourth() \{\n"
        + "\}\n"
        + "\n"
        + "action() -> () -> void \{\n"
        + "    return () -> nothing();\n"
        + "\}\n"
        + "\n"
        + "class Counter \{\n"
        + "    int count = 1 + nothing();\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    let both = flag ? nothing() : other();\n"
        + "    let twice = flag ? nothing() : nothing();\n"
        + "    let unnamed = flag ? action()() : nothing();\n"
        + "    let first = flag ? nothing() : 1;\n"
        + "    let second = true ? 1 : nothing();\n"
        + "    flag ? nothing() : other();\n"
        + "    let all = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        default -> other(),\n"
        + "    \};\n"
        + "    let many = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        2 -> other(),\n"
        + "        3 -> third(),\n"
        + "        4 -> fourth(),\n"
        + "        default -> nothing(),\n"
        + "    \};\n"
        + "    let calls = switch (1) \{\n"
        + "        1 -> action()(),\n"
        + "        default -> nothing(),\n"
        + "    \};\n"
        + "    let some = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    let lengthy = switch (1) \{\n"
        + "        1 -> 2,\n"
        + "        default -> averyLongFunctionNameThatGoesOnAndOn(),\n"
        + "    \};\n"
        + "    let stopped = panic(\"stopped\");\n"
        + "    int chosen = flag ? 1 : fail();\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "averyLongFunctionNameThatGoesOnAndOn() \{\n"
        + "\}\n"
        + "\n"
        + "stop() -> int \{\n"
        + "    return fail();\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 13L);
    string instead = "instead, with each call as a statement of its own.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' and 'other' return no value, so this '?:' has no value. Write an 'if' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so this '?:' has no value. Write an 'if' statement {instead}");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Both branches are calls that return no value, so this '?:' has no value. Write an 'if' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after '?' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after ':' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' and 'other' return no value, so this switch has no value. Write a 'switch' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing', 'other' and 2 others return no value, so this switch has no value. Write a "
        + "'switch' statement {instead}");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "Every arm is a call that returns no value, so this switch has no value. Write a 'switch' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so the arm '1 -> nothing()' gives this switch no value. "
        + "Give that arm an 'int' value.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'averyLongFunctionNameThatGoesOnAndOn' returns no value, so one of the arms gives this "
        + "switch no value. Give that arm an 'int' value.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "The two results of this '?:' are 'int' and 'void', which have no common type. Give "
        + "both branches the same type.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "Function 'stop' returns 'int', but this value has type 'void'.");
}
