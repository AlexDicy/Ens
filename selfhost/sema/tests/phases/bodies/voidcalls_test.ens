// A call that returns no value is refused where its value is used, with the place it is written
// in named and the value that place needs. A value that never returns takes the type of a place
// that states one and is refused where none is stated, and two calls joined where nothing reads
// the result are accepted.
import @std.testing;
import sema_support;
import Stage from sema_support;

test "a call that returns no value is refused where a declaration, a call or a return takes it" {
    let analysis = sema_support.analyzeProgram("class Box \{\n"
        + "    int count = nothing();\n"
        + "    lazy const int shared = nothing();\n"
        + "\n"
        + "    constructor(int count) \{\n"
        + "        this.count = count;\n"
        + "    \}\n"
        + "\n"
        + "    run(int limit = nothing()) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    int left;\n"
        + "    int right;\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "take(int value) \{\n"
        + "\}\n"
        + "\n"
        + "same<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "pick() -> int \{\n"
        + "    return nothing();\n"
        + "\}\n"
        + "\n"
        + "finish() \{\n"
        + "    return nothing();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    int typed = nothing();\n"
        + "    take(nothing());\n"
        + "    same(nothing());\n"
        + "    take(value: nothing());\n"
        + "    let box = new Box(nothing());\n"
        + "    Pair pair = \{left: 1, right: nothing()\};\n"
        + "    int assigned = 0;\n"
        + "    assigned = nothing();\n"
        + "    () -> int counted = () -> nothing();\n"
        + "    () -> void deferred = () -> take(nothing());\n"
        + "    string text = \"\{nothing()\}\";\n"
        + "    int[] items = [1, nothing()];\n"
        + "    void refused = nothing();\n"
        + "    () -> void longer = () -> take(averyLongFunctionNameThatGoesOnAndOn(1, 2));\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "averyLongFunctionNameThatGoesOnAndOn(int first, int second) \{\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 18L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the default value of field "
        + "'count'. Remove '= nothing()', or give 'count' a default 'int' value.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the value of lazy const "
        + "'Box.shared'. Give 'Box.shared' an initializer that builds an 'int' value.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the default value of parameter "
        + "'limit'. Remove '= nothing()', or give 'limit' a default 'int' value.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be returned from function 'pick'. "
        + "Call it as a statement of its own, as in 'nothing();', and return an 'int' value.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Function 'finish' returns nothing, so this 'return' cannot have a value. Call "
        + "'nothing()' as a statement of its own, and write 'return;' after it.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the initial value of 'typed'. Call "
        + "it as a statement of its own, as in 'nothing();', and give 'typed' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Call it as a "
        + "statement of its own, as in 'nothing();', and pass an 'int' value to 'take'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'same'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Call it as a "
        + "statement of its own, as in 'nothing();', and pass an 'int' value to 'take'.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to the constructor of "
        + "'Box'. Call it as a statement of its own, as in 'nothing();', and pass an 'int' value "
        + "to the constructor of 'Box'.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the value of field 'right'. Call "
        + "it as a statement of its own, as in 'nothing();', and give 'right' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be assigned to 'assigned'. Call it as "
        + "a statement of its own, as in 'nothing();', and assign 'assigned' an 'int' value.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be returned from this lambda. Give "
        + "the lambda a block body that calls 'nothing()' as a statement of its own, and return "
        + "an 'int' value.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'take'. Give the lambda "
        + "a block body that calls 'nothing()' as a statement of its own, and pass an 'int' value "
        + "to 'take'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot fill an interpolation hole. Call it "
        + "as a statement of its own, as in 'nothing();', and remove '\{nothing()\}' from the "
        + "string.");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be an element of an array. Call it as "
        + "a statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "Variable 'refused' cannot have type 'void', because 'void' means no value. Give "
        + "'refused' the type of the value it stores.");
    try sema_support.assertDiagnostic(reported, 17, "/proj/src/main.ens",
        "'averyLongFunctionNameThatGoesOnAndOn' returns no value, so a call to it cannot be passed "
        + "to 'take'. Give the lambda a block body with the call as a statement of its own, and "
        + "pass an 'int' value to 'take'.");
}

test "a call that returns no value is refused where an operator, a condition or a member reads it" {
    let analysis = sema_support.analyzeProgram("struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "point() \{\n"
        + "\}\n"
        + "\n"
        + "raise() \{\n"
        + "    throw nothing();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    int? maybe = null;\n"
        + "    int sum = 1 + nothing();\n"
        + "    bool same = nothing() == nothing();\n"
        + "    bool negated = !nothing();\n"
        + "    bool both = flag && nothing();\n"
        + "    bool either = flag || nothing();\n"
        + "    let held = maybe ?? nothing();\n"
        + "    sum += nothing();\n"
        + "    if (nothing()) \{\n"
        + "    \}\n"
        + "    while (nothing()) \{\n"
        + "    \}\n"
        + "    int picked = nothing() ? 1 : 2;\n"
        + "    string shown = nothing().toString();\n"
        + "    int read = point().x;\n"
        + "    long hashed = nothing().hash();\n"
        + "    let indexed = nothing()[0];\n"
        + "    nothing()();\n"
        + "    let converted = nothing() as int;\n"
        + "    for (let item in nothing()) \{\n"
        + "    \}\n"
        + "    switch (nothing()) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    bool acted = flag && action()();\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "action() -> () -> void \{\n"
        + "    return () -> nothing();\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 20L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to throw.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be compared with '=='. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '!'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '&&'. Call it in an 'if' "
        + "statement, as in 'if (flag) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '||'. Call it in an 'if' "
        + "statement, as in 'if (!flag) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '??'. Call it in an 'if' "
        + "statement, as in 'if (maybe == null) \{ nothing(); \}'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+='. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this 'if'. Call "
        + "it as a statement of its own, as in 'nothing();', and give the 'if' a 'bool' "
        + "condition.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this 'while'. "
        + "Give the 'while' a 'bool' condition.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be the condition of this '?:'. Call "
        + "it as a statement of its own, as in 'nothing();', and give the '?:' a 'bool' "
        + "condition.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call 'toString' on.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'point' returns no value, so there is no value to read 'x' from.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call 'hash' on.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to index.");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to call.");
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to convert with 'as'.");
    try sema_support.assertDiagnostic(reported, 17, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to loop over.");
    try sema_support.assertDiagnostic(reported, 18, "/proj/src/main.ens",
        "'nothing' returns no value, so there is no value to switch on.");
    try sema_support.assertDiagnostic(reported, 19, "/proj/src/main.ens",
        "This call returns no value, so it cannot be used with '&&'. Write it in an 'if' "
        + "statement, as in 'if (flag) \{ action()(); \}'.");
}

// A '?:' or a switch whose values are calls that return nothing is refused once, and a '?:'
// written as a statement of its own is accepted. Where no statement can be written, as in a
// field's default value, the refusal stops after why.
test "a '?:' or a switch of calls that return no value is refused once" {
    let analysis = sema_support.analyzeProgram("noreturn fail() \{\n"
        + "    panic(\"failed\");\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "other() \{\n"
        + "\}\n"
        + "\n"
        + "third() \{\n"
        + "\}\n"
        + "\n"
        + "fourth() \{\n"
        + "\}\n"
        + "\n"
        + "action() -> () -> void \{\n"
        + "    return () -> nothing();\n"
        + "\}\n"
        + "\n"
        + "class Counter \{\n"
        + "    int count = 1 + nothing();\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    let both = flag ? nothing() : other();\n"
        + "    let twice = flag ? nothing() : nothing();\n"
        + "    let unnamed = flag ? action()() : nothing();\n"
        + "    let first = flag ? nothing() : 1;\n"
        + "    let second = true ? 1 : nothing();\n"
        + "    flag ? nothing() : other();\n"
        + "    let all = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        default -> other(),\n"
        + "    \};\n"
        + "    let many = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        2 -> other(),\n"
        + "        3 -> third(),\n"
        + "        4 -> fourth(),\n"
        + "        default -> nothing(),\n"
        + "    \};\n"
        + "    let calls = switch (1) \{\n"
        + "        1 -> action()(),\n"
        + "        default -> nothing(),\n"
        + "    \};\n"
        + "    let some = switch (1) \{\n"
        + "        1 -> nothing(),\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    let lengthy = switch (1) \{\n"
        + "        1 -> 2,\n"
        + "        default -> averyLongFunctionNameThatGoesOnAndOn(),\n"
        + "    \};\n"
        + "    let stopped = panic(\"stopped\");\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "averyLongFunctionNameThatGoesOnAndOn() \{\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 11L);
    string instead = "instead, with each call as a statement of its own.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be used with '+'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' and 'other' return no value, so this '?:' has no value. Write an 'if' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so this '?:' has no value. Write an 'if' statement {instead}");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Both branches are calls that return no value, so this '?:' has no value. Write an 'if' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after '?' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after ':' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'nothing' and 'other' return no value, so this switch has no value. Write a 'switch' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'nothing', 'other' and 2 others return no value, so this switch has no value. Write a "
        + "'switch' statement {instead}");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "Every arm is a call that returns no value, so this switch has no value. Write a 'switch' "
        + "statement {instead}");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'nothing' returns no value, so the arm '1 -> nothing()' gives this switch no value. "
        + "Give that arm an 'int' value.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'averyLongFunctionNameThatGoesOnAndOn' returns no value, so one of the arms gives this "
        + "switch no value. Give that arm an 'int' value.");
}

// A value that never returns stands wherever the place gives the type of the value it reads, since
// nothing ever reads it. Where the place gives none, the refusal says that the call never returns.
test "a value that never returns takes the type the place it is read in gives" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stopped\");\n"
        + "\}\n"
        + "\n"
        + "class Box \{\n"
        + "    int size = stop();\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "\n"
        + "take(Box box) -> Box \{\n"
        + "    return box;\n"
        + "\}\n"
        + "\n"
        + "show(int value) \{\n"
        + "\}\n"
        + "\n"
        + "show(string value) \{\n"
        + "\}\n"
        + "\n"
        + "same<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "run<T>(() -> T action) -> T \{\n"
        + "    return action();\n"
        + "\}\n"
        + "\n"
        + "both<T>(T first, T second) -> T \{\n"
        + "    return first;\n"
        + "\}\n"
        + "\n"
        + "class Pair<T> \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    static both(T first, T second) -> T \{\n"
        + "        return first;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "accepted(bool flag) -> Box \{\n"
        + "    int inferred = both(stop(), 1);\n"
        + "    int paired = Pair.both(1, stop());\n"
        + "    long picked = switch (1) \{\n"
        + "        1 -> stop(),\n"
        + "        default -> stop(),\n"
        + "    \};\n"
        + "    int typed = stop();\n"
        + "    typed = stop();\n"
        + "    Box passed = take(stop());\n"
        + "    Box given = same<Box>(stop());\n"
        + "    () -> int made = () -> stop();\n"
        + "    Point point = \{x: stop()\};\n"
        + "    int[] values = [1, stop()];\n"
        + "    int ran = run<int>(() -> stop());\n"
        + "    return stop();\n"
        + "\}\n"
        + "\n"
        + "refused(bool flag) \{\n"
        + "    let inferred = same(stop());\n"
        + "    show(stop());\n"
        + "    int sum = 1 + stop();\n"
        + "    long hashed = stop().hash();\n"
        + "    string text = \"\{stop()\}\";\n"
        + "    let first = [stop(), 2];\n"
        + "    return stop();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 7L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'same' is generic, and this call does not show what its type argument 'T' is. Write it, as "
        + "in 'same<int>(stop())'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "This call matches 'show(int)' and 'show(string)' equally well, so it is not clear which one "
        + "to call. 'stop()', argument 1, never returns, so 'show' is never called, but the call "
        + "still has to match exactly one of them. Replace the whole call with 'stop()'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'stop' never returns, so a call to it cannot be used with '+'. Call it as a statement of its "
        + "own, as in 'stop();'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'stop' never returns, so there is no value to call 'hash' on.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'stop' never returns, so a call to it cannot fill an interpolation hole. Call it as a "
        + "statement of its own, as in 'stop();', and remove '\{stop()\}' from the string.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'stop' never returns, so a call to it cannot be the first element of an array whose type "
        + "is not written. Declare the type of 'first', as in 'int[] first = [stop()];'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Function 'refused' returns nothing, so this 'return' cannot have a value. Call 'stop()' as a "
        + "statement of its own.");
}

// An argument that never returns fits every overload, so the refusal of the ambiguous call says why
// the choice still matters. It offers to replace the whole call with that argument only where the
// call stands alone and nothing before the argument has effects, and a call no overload takes names
// only the arguments that rule the overloads out.
test "a call that an argument that never returns leaves ambiguous says why the choice matters" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stopped\");\n"
        + "\}\n"
        + "\n"
        + "noreturn stopBecauseOfAReasonWrittenOut(string reasonForStopping, int code) \{\n"
        + "    panic(reasonForStopping);\n"
        + "\}\n"
        + "\n"
        + "show(int value) \{\n"
        + "\}\n"
        + "\n"
        + "show(string value) \{\n"
        + "\}\n"
        + "\n"
        + "pair(int first, int second) \{\n"
        + "\}\n"
        + "\n"
        + "pair(int first, string second) \{\n"
        + "\}\n"
        + "\n"
        + "trio(int a, int b, int c) \{\n"
        + "\}\n"
        + "\n"
        + "trio(string a, string b, string c) \{\n"
        + "\}\n"
        + "\n"
        + "measure(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "measure(string value) -> bool \{\n"
        + "    return false;\n"
        + "\}\n"
        + "\n"
        + "logged() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "\n"
        + "class Shape \{\n"
        + "    int sides;\n"
        + "\n"
        + "    constructor(int sides) \{\n"
        + "        this.sides = sides;\n"
        + "    \}\n"
        + "\n"
        + "    constructor(string name) \{\n"
        + "        this.sides = 0;\n"
        + "    \}\n"
        + "\n"
        + "    put(int n) \{\n"
        + "    \}\n"
        + "\n"
        + "    put(string s) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Square extends Shape \{\n"
        + "    constructor() \{\n"
        + "        super(stop());\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "run(Shape shape, Shape? maybe, int count) -> int \{\n"
        + "    pair(count, stop());\n"
        + "    pair(logged(), stop());\n"
        + "    int direct = measure(stop());\n"
        + "    int total = 1 + measure(stop());\n"
        + "    measure(stop());\n"
        + "    Shape made = new Shape(stop());\n"
        + "    shape.put(stop());\n"
        + "    maybe?.put(stop());\n"
        + "    show(value: stop());\n"
        + "    show(stopBecauseOfAReasonWrittenOut(\"the reason is long\", 12345678));\n"
        + "    pair(stop(), true);\n"
        + "    trio(stop(), true, 'x');\n"
        + "    pair(stop());\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 14L);
    string shown = "This call matches 'show(int)' and 'show(string)' equally well, so it is not clear "
        + "which one to call.";
    string paired = "This call matches 'pair(int, int)' and 'pair(int, string)' equally well, so it is not "
        + "clear which one to call. 'stop()', argument 2, never returns, so 'pair' is never called, but "
        + "the call still has to match exactly one of them.";
    string measured = "This call matches 'measure(int)' and 'measure(string)' equally well, so it is not "
        + "clear which one to call. 'stop()', argument 1, never returns, so 'measure' is never called";
    string results = "{measured}. But 'measure(int)' returns 'int' and 'measure(string)' returns 'bool', "
        + "and the code that reads the value of the call is still checked against what one of them "
        + "returns.";
    string constructed = "This call matches 'constructor(int)' and 'constructor(string)' equally well, so "
        + "it is not clear which one to call. 'stop()', argument 1, never returns, so no constructor of "
        + "'Shape' is called, but the call still has to match exactly one of them.";
    string put = "This call matches 'put(int)' and 'put(string)' equally well, so it is not clear which "
        + "one to call. 'stop()', argument 1, never returns, so 'put' is never called, but the call "
        + "still has to match exactly one of them.";
    string replaced = "Replace the whole call with 'stop()'.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", constructed);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "{paired} {replaced}");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", paired);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "{results} {replaced}");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", results);
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "{measured}, but the call still has to match exactly one of them. {replaced}");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", "{constructed} {replaced}");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "{put} {replaced}");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens", put);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "{shown} 'stop()', the argument 'value', never returns, so 'show' is never called, but the "
        + "call still has to match exactly one of them. {replaced}");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "{shown} Argument 1 never returns, so 'show' is never called, but the call still has to match "
        + "exactly one of them. Replace the whole call with argument 1.");
    string listing = "They are 'pair(int, int)' and 'pair(int, string)'.";
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "None of the declared 'pair' functions takes a value of type 'bool' as argument 2. {listing} "
        + "Change argument 2 to match one of them.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "None of the declared 'trio' functions takes a value of type 'bool' as argument 2 and a value "
        + "of type 'char' as argument 3. They are 'trio(int, int, int)' and 'trio(string, string, "
        + "string)'. Change the arguments to match one of them.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "None of the declared 'pair' functions takes one argument. {listing} Add the arguments of one of "
        + "them.");
}

// A branch or an arm that never returns takes no part in the join, so the others decide its type,
// and a '?:' or a switch whose every value never returns never returns either and takes the type
// its place expects. A call that returns no value beside them is refused naming the values that
// never return.
test "a '?:' or a switch leaves a value that never returns out of its join" {
    let analysis = try sema_support.analyzeOne("noreturn fail() \{\n"
        + "    panic(\"failed\");\n"
        + "\}\n"
        + "\n"
        + "class Failure extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"failed\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "noreturn raise() throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "\n"
        + "class Guard \{\n"
        + "    constructor();\n"
        + "\n"
        + "    noreturn stop() \{\n"
        + "        panic(\"stopped\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "action() -> () -> void \{\n"
        + "    return () -> nothing();\n"
        + "\}\n"
        + "\n"
        + "enum Shade \{\n"
        + "    Light,\n"
        + "    Dark,\n"
        + "    Dim,\n"
        + "\}\n"
        + "\n"
        + "pick(bool flag, Shade shade, Guard guard) -> long throws Failure \{\n"
        + "    int chosen = flag ? 1 : fail();\n"
        + "    long widened = flag ? try raise() : 2;\n"
        + "    int stopping = flag ? 4 : guard.stop();\n"
        + "    char letter = flag ? 'a' : panic(\"no letter\");\n"
        + "    long nested = flag ? (shade == Shade.Dark ? panic(\"dark\") : fail()) : 3;\n"
        + "    long picked = switch (shade) \{\n"
        + "        Light -> 1,\n"
        + "        Dark -> panic(\"dark\"),\n"
        + "        Dim -> fail(),\n"
        + "    \};\n"
        + "    flag ? nothing() : fail();\n"
        + "    if (!flag) \{\n"
        + "        int typed = flag ? panic(\"typed\") : fail();\n"
        + "        long ended = switch (shade) \{\n"
        + "            Light -> panic(\"light\"),\n"
        + "            default -> fail(),\n"
        + "        \};\n"
        + "    \}\n"
        + "    return chosen + widened + stopping + letter + nested + picked;\n"
        + "\}\n"
        + "\n"
        + "refused(bool flag, Shade shade) \{\n"
        + "    let one = flag ? nothing() : fail();\n"
        + "    let mirrored = flag ? fail() : nothing();\n"
        + "    let arm = switch (shade) \{\n"
        + "        Light -> nothing(),\n"
        + "        default -> fail(),\n"
        + "    \};\n"
        + "    let unnamed = switch (shade) \{\n"
        + "        Light -> action()(),\n"
        + "        Dark -> fail(),\n"
        + "        Dim -> panic(\"dim\"),\n"
        + "    \};\n"
        + "    let several = switch (shade) \{\n"
        + "        Light -> action()(),\n"
        + "        Dark -> nothing(),\n"
        + "        Dim -> fail(),\n"
        + "    \};\n"
        + "    let given = switch (shade) \{\n"
        + "        Light -> nothing(),\n"
        + "        Dark -> 1,\n"
        + "        Dim -> fail(),\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "stopped(bool flag, Shade shade) -> int \{\n"
        + "    let neither = switch (shade) \{\n"
        + "        Light -> panic(\"light\"),\n"
        + "        default -> flag ? fail() : panic(\"other\"),\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int throws Failure \{\n"
        + "    return try pick(true, Shade.Light, new Guard()) as int + stopped(false, Shade.Dark);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 6L);
    string instead = "instead, with each call as a statement of its own.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, and the branch after ':' never returns, so this '?:' has no "
        + "value. Write an 'if' statement {instead}");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, and the branch after '?' never returns, so this '?:' has no "
        + "value. Write an 'if' statement {instead}");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, and the other arm never returns, so this switch has no value. "
        + "Write a 'switch' statement {instead}");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "One arm is a call that returns no value, and the other arms never return, so this switch "
        + "has no value. Write a 'switch' statement {instead}");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Some arms are calls that return no value, and the other arm never returns, so this switch "
        + "has no value. Write a 'switch' statement {instead}");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so the arm 'Light -> nothing()' gives this switch no value. "
        + "Give that arm an 'int' value.");
}

// A '?:' or a switch whose place states a type asks for a value of that type from the branch or arm
// that returns no value, even when the others never return. A switch whose every arm never returns
// is refused where no type is stated, and so is a call used as the index of an array.
test "a join or an index that has no value is refused with the value its place states" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stopped\");\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "other() \{\n"
        + "\}\n"
        + "\n"
        + "run(bool flag, int count, int[] values, int[]? maybe) -> int \{\n"
        + "    int first = flag ? nothing() : stop();\n"
        + "    int second = flag ? stop() : nothing();\n"
        + "    int third = switch (count) \{\n"
        + "        1 -> nothing(),\n"
        + "        2 -> other(),\n"
        + "        default -> stop(),\n"
        + "    \};\n"
        + "    int sum = 1 + switch (count) \{\n"
        + "        1 -> stop(),\n"
        + "        default -> panic(\"other\"),\n"
        + "    \};\n"
        + "    int ended = values[stop()];\n"
        + "    int empty = values[nothing()];\n"
        + "    int? safe = maybe?[stop()];\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 7L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after '?' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'nothing' returns no value, so the branch after ':' gives this '?:' no value. Give that "
        + "branch an 'int' value.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'nothing' returns no value, so the arm '1 -> nothing()' gives this switch no value. Give that "
        + "arm an 'int' value.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "This switch never returns, so it cannot be used with '+'. Write it as a statement of its own.");
    string index = "cannot be the index of an array. Call it as a statement of its own";
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'stop' never returns, so a call to it {index}, as in 'stop();', and index the array with an "
        + "integer.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it {index}, as in 'nothing();', and index the array "
        + "with an integer.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'stop' never returns, so a call to it {index}, as in 'stop();', and index the array with an "
        + "integer.");
}
