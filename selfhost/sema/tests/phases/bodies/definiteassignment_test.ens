import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "class fields must be initialized while struct fields may be non-defaultable" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Value \{\n"
        + "    string label;\n"
        + "\}\n"
        + "class Half \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "    constructor(this.first) \{\n"
        + "    \}\n"
        + "\}\n"
        + "class Assigned \{\n"
        + "    string first;\n"
        + "    constructor() \{\n"
        + "        this.first = \"ok\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    // A class that declares a constructor is checked by the definite-assignment pass over each
    // constructor body, so the unassigned field surfaces among the body diagnostics.
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'second' of class 'Half' cannot be null, and it is not assigned on every path through this "
        + "constructor. Assign it on every path, for example 'this.second = ...;'.");
}

test "a catch clause assigns a 'const' field only when the body could not have" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "shaky() -> int throws \{\n"
        + "    throw new Failure(\"boom\");\n"
        + "\}\n"
        + "boom() throws \{\n"
        + "    throw new Failure(\"boom\");\n"
        + "\}\n"
        + "class Fallback \{\n"
        + "    const int parsed;\n"
        + "    constructor() \{\n"
        + "        this.parsed = try shaky();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.parsed = -1;\n"
        + "    \}\n"
        + "\}\n"
        + "class TooLate \{\n"
        + "    const int early;\n"
        + "    constructor() \{\n"
        + "        this.early = 1;\n"
        + "        try boom();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.early = -1;\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    // The single diagnostic is what accepts 'Fallback.parsed', whose body could not have assigned
    // it before throwing.
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'early' cannot be assigned here, because it is 'const', and the constructor body may "
        + "have assigned it before a call there threw. In the body, move the assignment to 'early' "
        + "after the last call that can throw, or remove this assignment.");
    // The note lands on the body's assignment, which is what the exception path carried in.
    let earlier = try sema_support.relatedOf(found[0]);
    try testing.assertEqual(earlier.note(), "'early' is assigned here");
    try testing.assertTrue(earlier.span().start < found[0].span().start,
        "the note points at the assignment the body ran first");
}

// A catch clause starts with what the body may have assigned before it threw, so the clause's
// assignment of a 'const' field is refused for the body's assignment, and a second one in the clause
// itself is refused as one in a body is. A body that throws before every assignment leaves the
// clause free to assign.
test "a catch clause assigns a 'const' field only where the body cannot have assigned it" {
    let analysis = try sema_support.analyzeOne("class Failure extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "fail(bool flag) throws \{\n"
        + "    if (flag) \{\n"
        + "        throw new Failure(\"boom\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Between \{\n"
        + "    const int value;\n"
        + "    constructor(bool flag) \{\n"
        + "        try fail(flag);\n"
        + "        this.value = 1;\n"
        + "        try fail(flag);\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.value = 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Retried \{\n"
        + "    const int value;\n"
        + "    constructor(bool flag) \{\n"
        + "        try fail(flag);\n"
        + "        this.value = 1;\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        if (flag) \{\n"
        + "            this.value = 2;\n"
        + "        \}\n"
        + "        this.value = 3;\n"
        + "    \}\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Field 'value' cannot be assigned here, because it is 'const', and the constructor body may "
        + "have assigned it before a call there threw. In the body, move the assignment to 'value' "
        + "after the last call that can throw, or remove this assignment.");
    let body = try sema_support.relatedOf(found[0]);
    try testing.assertEqual(body.note(), "'value' is assigned here");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Field 'value' cannot be assigned here, because it is 'const' and on some paths it is "
        + "already assigned when this line runs. Assign 'value' only on the paths where it has no "
        + "value yet.");
    let branch = try sema_support.relatedOf(found[1]);
    try testing.assertTrue(branch.span().start > body.span().start
            && branch.span().start < found[1].span().start,
        "the note points at the clause's own first assignment");
    try testing.assertEqual(found.length, 2L);
}

test "a switch arm that never returns leaves no path with the local unassigned" {
    let analysis = try sema_support.analyzeOne("enum Shade \{\n"
        + "    Light,\n"
        + "    Dark,\n"
        + "\}\n"
        + "noreturn fail() \{\n"
        + "    panic(\"fail\");\n"
        + "\}\n"
        + "brightness(Shade shade) -> long \{\n"
        + "    long value;\n"
        + "    switch (shade) \{\n"
        + "        Shade.Light -> value = 1,\n"
        + "        Shade.Dark -> fail(),\n"
        + "    \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return brightness(Shade.Light) as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a switch used as a value on the right of '&&' assigns a local only where it runs" {
    let analysis = try sema_support.analyzeOne("larger(int first, int second) -> bool \{\n"
        + "    return first > second;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    int inside;\n"
        + "    bool matched = flag && switch (1) \{\n"
        + "        default -> (inside = 1) > 0,\n"
        + "    \};\n"
        + "    int beside;\n"
        + "    bool compared = flag && larger(switch (1) \{\n"
        + "        default -> 1,\n"
        + "    \}, beside = 2);\n"
        + "    int every;\n"
        + "    bool positive = switch (1) \{\n"
        + "        1 -> (every = 1) > 0,\n"
        + "        default -> (every = 2) > 0,\n"
        + "    \};\n"
        + "    return inside + beside + every;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Variable 'inside' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'inside = ...;'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "Variable 'beside' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'beside = ...;'.");
}

test "a '?:' assigns a local for sure only where both branches assign it and the '?:' always runs" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    int both;\n"
        + "    int first = flag ? (both = 1) : (both = 2);\n"
        + "    int one;\n"
        + "    int second = flag ? (one = 1) : 2;\n"
        + "    int inside;\n"
        + "    bool matched = flag && (flag ? (inside = 1) > 0 : (inside = 2) > 0);\n"
        + "    return both + one + inside;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Variable 'one' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'one = ...;'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "Variable 'inside' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'inside = ...;'.");
}

test "an assignment after '?.' or '?[' runs only when the value before it is not null" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    constructor();\n"
        + "\n"
        + "    take(long count) -> long \{\n"
        + "        return count;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "found(string name) -> Box? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    Box? box = null;\n"
        + "    string called;\n"
        + "    long? taken = box?.take((called = \"assigned\").length);\n"
        + "    int[]? values = null;\n"
        + "    string indexed;\n"
        + "    int? read = values?[(indexed = \"assigned\").length];\n"
        + "    string receiver;\n"
        + "    long? kept = found(receiver = \"assigned\")?.take(1);\n"
        + "    print(\"\{called\} \{indexed\} \{receiver\}\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Variable 'called' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'called = ...;'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "Variable 'indexed' is used "
        + "before it is assigned a value. Assign it on every path that leads to this line, for "
        + "example 'indexed = ...;'.");
}

test "a captured local must be assigned where the lambda is created" {
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    long total;\n"
        + "    (long) -> long add = (v) -> v + total;\n"
        + "    total = 1;\n"
        + "    return 0;\n"
        + "\}\n",
        "Variable 'total' is used before it is assigned a value. Assign it on every path that leads to "
        + "this line, for example 'total = ...;'.");
}

test "a read of a field through 'this' before every path assigns it is refused" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor() \{ super(\"failed\"); \}\n"
        + "\}\n"
        + "shaky() -> int throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "class Early \{\n"
        + "    string label;\n"
        + "    constructor() \{\n"
        + "        print(this.label);\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "class OneBranch \{\n"
        + "    string label;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.label = \"a\";\n"
        + "        \}\n"
        + "        print(this.label);\n"
        + "        this.label = \"b\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Appended \{\n"
        + "    string label;\n"
        + "    constructor() \{\n"
        + "        this.label += \"x\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Counted \{\n"
        + "    const int count;\n"
        + "    constructor() \{\n"
        + "        print(\"\{this.count\}\");\n"
        + "        this.count = 1;\n"
        + "    \}\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    string left;\n"
        + "    string right;\n"
        + "\}\n"
        + "class Halves \{\n"
        + "    Pair pair;\n"
        + "    constructor() \{\n"
        + "        this.pair.left = \"l\";\n"
        + "        print(this.pair.right);\n"
        + "        this.pair = \{left: \"a\", right: \"b\"\};\n"
        + "    \}\n"
        + "\}\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "    protected int length = 0;\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "class FromSelf extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"\{this.length\}\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Settled extends Named \{\n"
        + "    string label;\n"
        + "    int count;\n"
        + "    int? spare;\n"
        + "    constructor(this.label) \{\n"
        + "        super(this.label);\n"
        + "        print(\"\{this.count\} \{this.spare\} \{this.name\}\");\n"
        + "        this.count = try shaky();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        print(this.label);\n"
        + "    \}\n"
        + "\}\n"
        + "class Called \{\n"
        + "    () -> string callback;\n"
        + "    constructor() \{\n"
        + "        print(this.callback());\n"
        + "        this.callback = () -> \"c\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 7L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'label' of class 'Early' cannot be null, and it is read here before every path through "
        + "the constructor assigns it. Assign it before this line on every path, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'OneBranch' cannot be null, and it is read here before every path "
        + "through the constructor assigns it. Assign it before this line on every path, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'Appended' cannot be null, and '+=' reads it first, before every path "
        + "through the constructor assigns it. Assign it with '=' before this line on every path, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'count' of class 'Counted' is 'const' with no default value, and it is read here before "
        + "every path through the constructor assigns it. Assign it before this line on every path, "
        + "for example 'this.count = ...;'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'pair' of class 'Halves' has no value until every path through the constructor assigns "
        + "it, so its field 'left' cannot be set here. Assign the whole struct first, for example "
        + "'this.pair = \{...\};'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'length' of base class 'Named' has no value until 'Named' is constructed, so the "
        + "arguments of 'super(...)' cannot read it. Pass a value that does not come from 'this', "
        + "such as a parameter of the constructor.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'callback' of class 'Called' cannot be null, and it is read here before every path "
        + "through the constructor assigns it. Assign it before this line on every path, for example "
        + "'this.callback = ...;'.");
}

test "a use of 'this' other than its fields is refused while a field has no value" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Refusal extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"refused\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Shortage extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"short\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "checkedName(string text) -> string throws Refusal \{\n"
        + "    if (text.length == 0) \{\n"
        + "        throw new Refusal();\n"
        + "    \}\n"
        + "    return text;\n"
        + "\}\n"
        + "\n"
        + "checkedCount(int value) -> int throws Shortage \{\n"
        + "    if (value < 0) \{\n"
        + "        throw new Shortage();\n"
        + "    \}\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "take<T>(T value) \{\n"
        + "\}\n"
        + "\n"
        + "class Called \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        print(this.describe());\n"
        + "        print(this.label);\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\n"
        + "    describe() -> string \{\n"
        + "        return \"called\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Passed \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        take(this);\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Holder \{\n"
        + "    constructor(Held held) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Held \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        let holder = new Holder(this);\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Compared \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(Compared other) \{\n"
        + "        if (this == other) \{\n"
        + "            print(\"same\");\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Matched \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(Matched other) \{\n"
        + "        if (other != this) \{\n"
        + "            print(\"different\");\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Printed \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        print(\"printed \{this\}\");\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Kept \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        Kept kept = this;\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Linked \{\n"
        + "    string label;\n"
        + "    Linked? next;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.next = this;\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Chosen \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag, Chosen other) \{\n"
        + "        Chosen chosen = flag ? this : other;\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Deferred \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        () -> void later = () -> \{\n"
        + "            print(this.label);\n"
        + "        \};\n"
        + "        later();\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Early extends Named \{\n"
        + "    constructor() \{\n"
        + "        super(this.describe());\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    string tag;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.x = this.twice();\n"
        + "        this.tag = \"p\";\n"
        + "    \}\n"
        + "\n"
        + "    twice() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Rendered \{\n"
        + "    string label;\n"
        + "    int count;\n"
        + "\n"
        + "    constructor(int value) \{\n"
        + "        this.count = try checkedCount(value);\n"
        + "        this.label = \"set\";\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        print(this.render());\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\n"
        + "    render() -> string \{\n"
        + "        return this.label;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Captured \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool fail) \{\n"
        + "        if (fail) \{\n"
        + "            throw new Shortage();\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \} catch (Shortage shortage) \{\n"
        + "        () -> void later = () -> \{\n"
        + "            print(this.label);\n"
        + "        \};\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Unbuilt extends Named \{\n"
        + "    constructor(string text) \{\n"
        + "        super(try checkedName(text));\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        print(this.describe());\n"
        + "        panic(\"a name is required\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "pick(Offered? offered) \{\n"
        + "\}\n"
        + "\n"
        + "class Offered \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag) \{\n"
        + "        pick(flag ? this : null);\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Listed \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        Listed[] all = [this];\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Switched \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        string kind = switch (this) \{\n"
        + "            is Narrowed narrowed -> narrowed.label,\n"
        + "            default -> \"plain\",\n"
        + "        \};\n"
        + "        this.label = kind;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Narrowed extends Switched \{\n"
        + "\}\n"
        + "\n"
        + "class Remembered \{\n"
        + "    string label;\n"
        + "    () -> string callback;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.label = \"set\";\n"
        + "        this.callback = () -> this.label;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 16L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'describe' is called on 'this' before field 'label' of class 'Called' has a value, "
        + "and 'describe' may read 'label'. Assign 'label' before this call, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'this' is passed to 'take' before field 'label' of class 'Passed' has a value, and "
        + "'take' may read 'label'. Assign 'label' before this line, for example 'this.label "
        + "= ...;'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'this' is passed to the constructor of 'Holder' before field 'label' of class "
        + "'Held' has a value, and the constructor of 'Holder' may read 'label'. Assign "
        + "'label' before this line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "'==' calls 'equals' on 'this' before field 'label' of class 'Compared' has a "
        + "value, and 'equals' may read 'label'. Assign 'label' before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "'!=' passes 'this' to 'equals' before field 'label' of class 'Matched' has a "
        + "value, and 'equals' may read 'label'. Assign 'label' before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "'\{this\}' calls 'toString' on 'this' before field 'label' of class 'Printed' has a "
        + "value, and 'toString' may read 'label'. Assign 'label' before this line, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "'this' is stored in 'kept' before field 'label' of class 'Kept' has a value, and "
        + "code that uses 'kept' may read 'label'. Assign 'label' before this line, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "'this' is stored in field 'next' before field 'label' of class 'Linked' has a "
        + "value, and code that uses 'next' may read 'label'. Assign 'label' before this "
        + "line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "'this' is stored in 'chosen' before field 'label' of class 'Chosen' has a value, "
        + "and code that uses 'chosen' may read 'label'. Assign 'label' before this line, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "This lambda uses 'this', and it is created before field 'label' of class "
        + "'Deferred' has a value, so calling it may read 'label'. Assign 'label' before this "
        + "lambda, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 10, "/proj/src/app.ens",
        "'describe' is called on 'this' in the arguments of 'super(...)', before base class "
        + "'Named' is constructed, and 'describe' may read the fields of 'Named'. Pass "
        + "'super(...)' a value that does not come from 'this', such as a parameter of the "
        + "constructor.");
    try sema_support.assertDiagnostic(found, 11, "/proj/src/app.ens",
        "'twice' is called on 'this' before field 'tag' of struct 'Point' has a value, and "
        + "'twice' may read 'tag'. Assign 'tag' before this call, for example 'this.tag = "
        + "...;'.");
    try sema_support.assertDiagnostic(found, 12, "/proj/src/app.ens",
        "'this' is passed to 'pick' before field 'label' of class 'Offered' has a value, "
        + "and 'pick' may read 'label'. Assign 'label' before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 13, "/proj/src/app.ens",
        "'this' is put in an array before field 'label' of class 'Listed' has a value, and "
        + "code that reads the array may read 'label'. Assign 'label' before this line, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 14, "/proj/src/app.ens",
        "'this' is stored in 'narrowed' before field 'label' of class 'Switched' has a "
        + "value, and code that uses 'narrowed' may read 'label'. Assign 'label' before this "
        + "line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 15, "/proj/src/app.ens",
        "This lambda uses 'this', and it is created before field 'callback' of class "
        + "'Remembered' has a value, because 'callback' gets its value from the lambda. Until "
        + "every field has a value, 'this' can only be used to read and write its fields and "
        + "to test its type with 'is'. Give 'callback' a default value, as in '() -> string "
        + "callback = () -> \"\";', so that every field has a value when the lambda is created.");
    let caught = analysis.exceptionDiagnostics();
    try testing.assertEqual(caught.length, 3L);
    try sema_support.assertDiagnostic(caught, 0, "/proj/src/app.ens",
        "'render' is called on 'this' in this 'catch' clause, and 'render' may read field "
        + "'label' of class 'Rendered'. When 'checkedCount' throws 'Shortage', the body has "
        + "not assigned 'label' yet. Assign 'label' in the clause before this call, for "
        + "example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(caught, 1, "/proj/src/app.ens",
        "This lambda in a 'catch' clause uses 'this', so calling it may read field 'label' "
        + "of class 'Captured'. When the body throws 'Shortage', it has not assigned 'label' "
        + "yet. Assign 'label' in the clause before this lambda, for example 'this.label = "
        + "...;'.");
    try sema_support.assertDiagnostic(caught, 2, "/proj/src/app.ens",
        "'describe' is called on 'this' in this 'catch' clause, and 'describe' may read field "
        + "'name' of base class 'Named'. When 'checkedName' throws 'Refusal' in the arguments of "
        + "'super(...)', 'Named' is not constructed yet. Remove this call, or remove this 'catch' "
        + "clause and move the call to 'checkedName' into a function that catches 'Refusal' and "
        + "returns a value to pass to 'super(...)'.");
}

test "'this' may be used in any way once every field has a value" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected int count;\n"
        + "    protected string? note;\n"
        + "    protected constructor(this.name);\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "show(Named shown) \{\n"
        + "\}\n"
        + "class Settled extends Named \{\n"
        + "    string label;\n"
        + "    string tag = \"t\";\n"
        + "    constructor(this.label) \{\n"
        + "        super(this.label);\n"
        + "        print(this.describe());\n"
        + "        show(this);\n"
        + "        () -> void later = () -> \{\n"
        + "            print(this.label);\n"
        + "        \};\n"
        + "    \}\n"
        + "\}\n"
        + "class Implicit \{\n"
        + "    int count;\n"
        + "    constructor() \{\n"
        + "        print(this.render());\n"
        + "    \}\n"
        + "    render() -> string \{\n"
        + "        return \"\{this.count\}\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "'this' may be tested, and run what the language provides, before every field has a value" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Shape \{\n"
        + "    string label;\n"
        + "    constructor() \{\n"
        + "        if (this is Square) \{\n"
        + "            print(\"square\");\n"
        + "        \}\n"
        + "        string kind = switch (this) \{\n"
        + "            is Square -> \"square\",\n"
        + "            default -> \"shape\",\n"
        + "        \};\n"
        + "        this.label = kind;\n"
        + "    \}\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "\}\n"
        + "final class Plain \{\n"
        + "    string label;\n"
        + "    constructor(Plain? other) \{\n"
        + "        print(\"\{this\} \{this.toString()\} \{this.hash()\}\");\n"
        + "        if (this == other) \{\n"
        + "            print(\"compared\");\n"
        + "        \}\n"
        + "        this.label = \"set\";\n"
        + "    \}\n"
        + "\}\n"
        + "take(string text) -> string \{\n"
        + "    return text;\n"
        + "\}\n"
        + "take(int number) -> string \{\n"
        + "    return \"\{number\}\";\n"
        + "\}\n"
        + "final class Ranked \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "    constructor() \{\n"
        + "        this.first = \"a\";\n"
        + "        print(take(this.first));\n"
        + "        print(take(text: this.first));\n"
        + "        this.second = \"b\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a subclass constructor assigns its own fields before super(...) and its base fields after it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Refusal extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"refused\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "checkedName(string text) -> string throws Refusal \{\n"
        + "    if (text.length == 0) \{\n"
        + "        throw new Refusal();\n"
        + "    \}\n"
        + "    return text;\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Late extends Named \{\n"
        + "    string extra;\n"
        + "    string other;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        print(\"before\");\n"
        + "        super(\"a\");\n"
        + "        this.extra = \"e\";\n"
        + "        this.other = \"o\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Greeting extends Named \{\n"
        + "    string label;\n"
        + "    string mark;\n"
        + "\n"
        + "    constructor(string name) \{\n"
        + "        print(\"building\");\n"
        + "        super(name);\n"
        + "        this.label = this.name + \"!\";\n"
        + "        this.mark = \"\{this.describe()\}?\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Copied extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        print(\"building\");\n"
        + "        super(\"fixed\");\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Chosen extends Named \{\n"
        + "    string reason;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"building\");\n"
        + "        super(given);\n"
        + "        if (given.length == 0) \{\n"
        + "            this.reason = \"none\";\n"
        + "        \} else \{\n"
        + "            this.reason = given;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Reads extends Named \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.extra = this.name;\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Calls extends Named \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.extra = \"e\";\n"
        + "        print(this.describe());\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Writes extends Named \{\n"
        + "    constructor() \{\n"
        + "        this.name = \"n\";\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Root \{\n"
        + "    protected int count = 1;\n"
        + "\}\n"
        + "\n"
        + "class Implicit extends Root \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.extra = \"\{this.count\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Recovers extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string text) \{\n"
        + "        this.label = try checkedName(text);\n"
        + "        super(\"named\");\n"
        + "    \} catch (Refusal refusal) \{\n"
        + "        this.label = \"fallback\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 8L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Fields 'extra' and 'other' of class 'Late' are assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Move 'this.extra = \"e\";' and 'this.other = \"o\";' above "
        + "'super(\"a\");'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Fields 'label' and 'mark' of class 'Greeting' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. 'this.label = this.name + \"!\";' reads 'name', a field "
        + "of base class 'Named' that has no value until 'Named' is constructed. Compute 'label' "
        + "from 'name', the constructor's parameter, as in 'this.label = name + \"!\";', and move "
        + "it above 'super(name);'. 'this.mark = \"\{this.describe()\}?\";' calls 'describe' on "
        + "'this', and 'describe' may read the fields of 'Named'. Give 'mark' a first value above "
        + "'super(name);', as in 'this.mark = \"\";'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'Copied' is assigned after 'super(...)'. A subclass assigns its "
        + "own fields before 'super(...)', so they have values when the constructor of 'Named' "
        + "runs. 'this.label = this.name;' reads 'name', a field of base class 'Named' that has "
        + "no value until 'Named' is constructed. Give 'label' a first value above "
        + "'super(\"fixed\");', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'reason' of class 'Chosen' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Move the 'if' statement that assigns 'reason' above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Give 'extra' a first value here, as in 'this.extra = \"\";', and "
        + "write 'this.extra = this.name;' after 'super(\"a\");'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "'describe' is called on 'this' before base class 'Named' is constructed, and "
        + "'describe' may read the fields of 'Named'. Move this call after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Pass the value to 'super(...)', as in "
        + "'super(\"n\");', and remove this assignment.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' has no value until 'Root' is constructed, so it "
        + "cannot be read here. Give 'extra' a first value here, as in 'this.extra = \"\";', then "
        + "call 'super();' and write 'this.extra = \"\{this.count\}\";' after it.");
    let caught = analysis.exceptionDiagnostics();
    try testing.assertEqual(caught.length, 1L);
    try sema_support.assertDiagnostic(caught, 0, "/proj/src/app.ens",
        "The constructor of 'Recovers' can return an object whose base class 'Named' was "
        + "never constructed: 'checkedName' can throw 'Refusal' before 'super(...)', and this "
        + "'catch' clause then reaches its end. Move the call into a function that catches "
        + "'Refusal' and returns a fallback value, and remove this 'catch' clause. If the "
        + "program cannot continue without that value, end the clause with 'panic(...)'.");
}

// The refusal of an assignment to an own field after 'super(...)' names each call on the paths
// that reach it: a statement in the block of its call moves above it, one after a join moves above
// each call, and is written there as well where another path assigns the field first. A base
// field the statement reads is replaced by the parameter it holds, and a statement that cannot
// move gives the field a first value.
test "a late assignment is named for each 'super(...)' call on the paths that reach it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Renamed \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        this.name = this.name + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class HalfBranch extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.label = \"early\";\n"
        + "            super(\"a\");\n"
        + "        \} else \{\n"
        + "            super(\"b\");\n"
        + "            this.label = \"late\";\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class AfterJoin extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.label = \"early\";\n"
        + "            super(\"a\");\n"
        + "        \} else \{\n"
        + "            super(\"b\");\n"
        + "        \}\n"
        + "        this.label = \"late\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class BothBranches extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            super(\"a\");\n"
        + "        \} else \{\n"
        + "            super(\"b\");\n"
        + "        \}\n"
        + "        this.label = \"late\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OnlyOnePath extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag) \{\n"
        + "        print(\"first\");\n"
        + "        super(\"a\");\n"
        + "        if (flag) \{\n"
        + "            this.label = \"one\";\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Tagged extends Named \{\n"
        + "    string nameTag = \"t\";\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name + this.nameTag;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Literal extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = \"this.name is \{this.name\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Reassigned extends Renamed \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Described extends Named \{\n"
        + "    string mark;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.mark = this.describe();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Counted extends Named \{\n"
        + "    const string mark;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(\"x\");\n"
        + "        this.mark = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Later extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        string local = \"\{given\}!\";\n"
        + "        this.label = local;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 10L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'label' of class 'HalfBranch' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Move 'this.label = \"late\";' above 'super(\"b\");'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'AfterJoin' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Write 'this.label = \"late\";' above 'super(\"b\");' as "
        + "well.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'BothBranches' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Move 'this.label = \"late\";' above each of "
        + "'super(\"a\");' and 'super(\"b\");'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'label' of class 'OnlyOnePath' has no value when 'super(...)' is called. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Assign it before this call, for example 'this.label = "
        + "\"\";'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'label' of class 'Tagged' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. 'this.label = this.name + this.nameTag;' reads 'name', a field of "
        + "base class 'Named' that has no value until 'Named' is constructed. Compute 'label' "
        + "from 'given', the constructor's parameter, as in 'this.label = given + "
        + "this.nameTag;', and move it above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'label' of class 'Literal' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. 'this.label = \"this.name is \{this.name\}\";' reads "
        + "'name', a field of base class 'Named' that has no value until 'Named' is "
        + "constructed. Compute 'label' from 'given', the constructor's parameter, as in "
        + "'this.label = \"this.name is \{given\}\";', and move it above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'label' of class 'Reassigned' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Renamed' runs. 'this.label = this.name;' reads 'name', a field of "
        + "base class 'Renamed' that has no value until 'Renamed' is constructed. Give "
        + "'label' a first value above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'mark' of class 'Described' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. 'this.mark = this.describe();' calls 'describe' on "
        + "'this', and 'describe' may read the fields of 'Named'. Give 'mark' a first value "
        + "above 'super(given);', as in 'this.mark = \"\";'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "Field 'mark' of class 'Counted' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. 'this.mark = this.name;' reads 'name', a field of base class 'Named' "
        + "that has no value until 'Named' is constructed. 'mark' is 'const', so it is "
        + "assigned only once: compute its value above 'super(\"x\");' without reading the "
        + "fields of 'Named'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "Field 'label' of class 'Later' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Move 'string local = \"\{given\}!\";' and 'this.label = local;' above "
        + "'super(given);'.");
}

// A read of a base field in the value of an own field's first assignment, and a write of a base
// field, before 'super(...)' get a fix that compiles: the parameter the base field holds once the
// call returns, a first value for the own field, or the value passed to 'super(...)'.
test "a base field read or written before 'super(...)' is given its value another way" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Root \{\n"
        + "    protected int count = 1;\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Renamed \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        this.name = this.name + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Kept \{\n"
        + "    protected constructor(Kept? other) \{ \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsGiven extends Named \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.extra = \"\{this.name\}?\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsConst extends Named \{\n"
        + "    const string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.extra = this.name;\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsAtExit extends Root \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.extra = \"\{this.count\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class WritesKept extends Named \{\n"
        + "    constructor(string given) \{\n"
        + "        this.name = given;\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class WritesRenamed extends Renamed \{\n"
        + "    constructor(string given) \{\n"
        + "        this.name = given;\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class WritesAtExit extends Root \{\n"
        + "    constructor() \{\n"
        + "        this.count = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PassesThis extends Kept \{\n"
        + "    constructor() \{\n"
        + "        super(this);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 7L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so "
        + "it cannot be read here. Compute 'extra' from 'given', the constructor's parameter, "
        + "as in 'this.extra = \"\{given\}?\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so "
        + "it cannot be read here. 'extra' is 'const', so it is assigned only once: compute "
        + "its value without reading the fields of 'Named'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' has no value until 'Root' is constructed, so it "
        + "cannot be read here. Give 'extra' a first value here, as in 'this.extra = \"\";', "
        + "then call 'super();' and write 'this.extra = \"\{this.count\}\";' after it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is "
        + "constructed, because constructing 'Named' gives it its value. Pass the value to "
        + "'super(...)', as in 'super(given);', and remove this assignment.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'name' of base class 'Renamed' cannot be assigned before 'Renamed' is "
        + "constructed, because constructing 'Renamed' gives it its value. Assign it after "
        + "'super(...)'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' cannot be assigned before 'Root' is "
        + "constructed, because constructing 'Root' gives it its value. A constructor that "
        + "does not call 'super(...)' constructs 'Root' when it finishes, so call 'super();' "
        + "before this line.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "'this' is passed to 'super(...)' before base class 'Kept' is constructed, and the "
        + "constructor of 'Kept' may read its fields. Pass 'super(...)' a value that does not "
        + "come from 'this', such as a parameter of the constructor.");
}

// '++', '--' and a compound assignment change a base field, so each is refused before the base
// class is built and in the arguments of 'super(...)'.
test "'++', '--' and a compound assignment of a base field are refused before 'super(...)'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Counted \{\n"
        + "    protected int count;\n"
        + "\n"
        + "    protected constructor(this.count);\n"
        + "\}\n"
        + "\n"
        + "class Root \{\n"
        + "    protected int count = 1;\n"
        + "\}\n"
        + "\n"
        + "class Postfix extends Counted \{\n"
        + "    constructor() \{\n"
        + "        this.count++;\n"
        + "        super(7);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Prefix extends Counted \{\n"
        + "    constructor() \{\n"
        + "        --this.count;\n"
        + "        super(7);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class InArgument extends Counted \{\n"
        + "    constructor() \{\n"
        + "        super(this.count++);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Compound extends Counted \{\n"
        + "    constructor() \{\n"
        + "        this.count += 2;\n"
        + "        super(7);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class AtExit extends Root \{\n"
        + "    constructor() \{\n"
        + "        this.count++;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'count' of base class 'Counted' has no value until 'Counted' is constructed, "
        + "so '++' cannot change it here. Write this line after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'count' of base class 'Counted' has no value until 'Counted' is constructed, "
        + "so '--' cannot change it here. Write this line after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'count' of base class 'Counted' has no value until 'Counted' is constructed, "
        + "so the arguments of 'super(...)' cannot change it with '++'. Pass a value that does "
        + "not come from 'this', such as a parameter of the constructor.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'count' of base class 'Counted' has no value until 'Counted' is constructed, "
        + "so '+=' cannot change it here. Write this line after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' has no value until 'Root' is constructed, so '++' "
        + "cannot change it here. A constructor that does not call 'super(...)' constructs "
        + "'Root' when it finishes, so call 'super();' before this line.");
}

// A value is computed from a parameter only where the base field holds that parameter at the place
// the statement reads it: the base constructor and what it runs leave the field alone, nothing
// between changes it, and every 'super(...)' after a read before them passes the same parameter.
test "a fix computes a value from a parameter only where the base field holds it there" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Normalized \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        this.normalize();\n"
        + "    \}\n"
        + "\n"
        + "    protected normalize() \{\n"
        + "        this.name = this.name + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Described \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(this.describe());\n"
        + "    \}\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Fixed \{\n"
        + "    protected const string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(this.describe());\n"
        + "    \}\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Announced \{\n"
        + "    protected constructor() \{\n"
        + "        print(this.describe());\n"
        + "    \}\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return \"announced\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Middle extends Announced \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Plain \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(this.describe());\n"
        + "    \}\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ViaHelper extends Normalized \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ViaOverride extends Described \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\n"
        + "    protected override describe() -> string \{\n"
        + "        this.name = \"changed\";\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ViaUnknownSubclass extends Plain \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Deeper extends ViaUnknownSubclass \{\n"
        + "    constructor(string given) \{\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\n"
        + "    protected override describe() -> string \{\n"
        + "        this.name = \"changed by Deeper\";\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ViaConst extends Fixed \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ViaImplicitBase extends Middle \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Rebound extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, this.name) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ParameterChanged extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        given = \"other\";\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class WrittenBetween extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.name = \"other\";\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class CalledBetween extends Normalized \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        print(this.name);\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadBefore extends Normalized \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.label = this.name;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class SameInBranches extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag, string given) \{\n"
        + "        this.label = this.name;\n"
        + "        if (flag) \{\n"
        + "            super(given);\n"
        + "        \} else \{\n"
        + "            super(given);\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OtherInBranches extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag, string given) \{\n"
        + "        this.label = this.name;\n"
        + "        if (flag) \{\n"
        + "            super(given);\n"
        + "        \} else \{\n"
        + "            super(\"other\");\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadInBranch extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(bool flag, string given) \{\n"
        + "        if (flag) \{\n"
        + "            this.label = this.name;\n"
        + "            super(given);\n"
        + "        \} else \{\n"
        + "            this.label = \"plain\";\n"
        + "            super(\"other\");\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 13L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'label' of class 'ViaHelper' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Normalized' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Normalized' that has no value until 'Normalized' is constructed. Give 'label' a "
        + "first value above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'ViaOverride' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Described' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Described' that has no value until 'Described' is constructed. Give 'label' a first "
        + "value above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'ViaUnknownSubclass' is assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Plain' runs. 'this.label = this.name;' reads 'name', a field of base "
        + "class 'Plain' that has no value until 'Plain' is constructed. Give 'label' a first "
        + "value above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'label' of class 'ViaConst' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Fixed' runs. 'this.label = this.name;' reads 'name', a field of base class 'Fixed' "
        + "that has no value until 'Fixed' is constructed. Compute 'label' from 'given', the "
        + "constructor's parameter, as in 'this.label = given;', and move it above "
        + "'super(given);'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'label' of class 'ViaImplicitBase' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Middle' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Middle' that has no value until 'Middle' is constructed. Give 'label' a first value "
        + "above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'label' of class 'Rebound' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. 'this.label = this.name;' reads 'name', a field of base class 'Named' "
        + "that has no value until 'Named' is constructed. Give 'label' a first value above "
        + "'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'label' of class 'ParameterChanged' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Named' that has no value until 'Named' is constructed. Give 'label' a first value "
        + "above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'label' of class 'WrittenBetween' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Named' that has no value until 'Named' is constructed. Give 'label' a first value "
        + "above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "Field 'label' of class 'CalledBetween' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Normalized' runs. 'this.label = this.name;' reads 'name', a field of base class "
        + "'Normalized' that has no value until 'Normalized' is constructed. Give 'label' a "
        + "first value above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. Give 'label' a first value here, as in "
        + "'this.label = \"\";', and write 'this.label = this.name;' after 'super(given);'.");
    try sema_support.assertDiagnostic(found, 10, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Compute 'label' from 'given', the constructor's parameter, as in "
        + "'this.label = given;'.");
    try sema_support.assertDiagnostic(found, 11, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Give 'label' a first value here, as in 'this.label = \"\";', and "
        + "write 'this.label = this.name;' after each of 'super(given);' and 'super(\"other\");'.");
    try sema_support.assertDiagnostic(found, 12, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Compute 'label' from 'given', the constructor's parameter, as in "
        + "'this.label = given;'.");
}

// A fix moves or computes a statement only where the program does the same with it: the value
// behind the field has no part another value shares, the argument has the field's exact type, the
// field is only read, and nothing between the two places runs code or changes what it reads.
test "a fix moves or computes a statement only where the program does the same" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Bag \{\n"
        + "    int size;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        this.size = 0;\n"
        + "    \}\n"
        + "\n"
        + "    add() \{\n"
        + "        this.size = this.size + 1;\n"
        + "    \}\n"
        + "\n"
        + "    count() -> int \{\n"
        + "        return this.size;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Filled \{\n"
        + "    protected Bag items;\n"
        + "\n"
        + "    protected constructor(this.items) \{\n"
        + "        this.items.add();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class CountsLate extends Filled \{\n"
        + "    string summary;\n"
        + "\n"
        + "    constructor(Bag given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.summary = \"\{this.items.count()\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class CountsEarly extends Filled \{\n"
        + "    string summary;\n"
        + "\n"
        + "    constructor(Bag given) \{\n"
        + "        this.summary = \"\{this.items.count()\}\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Counter \{\n"
        + "    protected int count;\n"
        + "\n"
        + "    protected constructor(this.count);\n"
        + "\}\n"
        + "\n"
        + "class Bumped extends Counter \{\n"
        + "    string copy;\n"
        + "\n"
        + "    constructor(int given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.copy = \"\{this.count += 1\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Renames extends Named \{\n"
        + "    string copy;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.copy = (this.name = \"z\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Amount \{\n"
        + "    protected long amount;\n"
        + "\n"
        + "    protected constructor(this.amount);\n"
        + "\}\n"
        + "\n"
        + "class Scaled extends Amount \{\n"
        + "    string scaled;\n"
        + "\n"
        + "    constructor(int given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.scaled = \"\{this.amount * 1000000\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Maybe \{\n"
        + "    protected string? note;\n"
        + "\n"
        + "    protected constructor(this.note);\n"
        + "\}\n"
        + "\n"
        + "class Noted extends Maybe \{\n"
        + "    string shown;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.shown = this.note ?? \"none\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Reassigns extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string suffix = \"a\";\n"
        + "        super(given);\n"
        + "        suffix = \"b\";\n"
        + "        this.label = suffix;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Suffixed extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string suffix = \"a\";\n"
        + "        super(given);\n"
        + "        suffix = \"b\";\n"
        + "        this.label = this.name + suffix;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Overwrites extends Named \{\n"
        + "    constructor(string given) \{\n"
        + "        string value = \"a\";\n"
        + "        this.name = value;\n"
        + "        value = \"b\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Pushes extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, Bag parts) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        parts.add();\n"
        + "        this.label = \"\{parts.count()\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Kept extends Named \{\n"
        + "    string label;\n"
        + "    string mark;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string suffix = \"a\";\n"
        + "        super(given);\n"
        + "        this.label = this.name + suffix;\n"
        + "        this.mark = suffix;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Passed extends Named \{\n"
        + "    constructor(string given) \{\n"
        + "        string value = \"a\";\n"
        + "        this.name = value;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class NestedWrite extends Named \{\n"
        + "    string copy;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.copy = (this.name = \"z\");\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 13L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'summary' of class 'CountsLate' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Filled' runs. 'this.summary = \"\{this.items.count()\}\";' reads 'items', a "
        + "field of base class 'Filled' that has no value until 'Filled' is constructed. Give "
        + "'summary' a first value above 'super(given);', as in 'this.summary = \"\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'items' of base class 'Filled' has no value until 'Filled' is constructed, so "
        + "it cannot be read here. Give 'summary' a first value here, as in 'this.summary = "
        + "\"\";', and assign 'summary' its value after 'super(given);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'copy' of class 'Bumped' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Counter' runs. 'this.copy = \"\{this.count += 1\}\";' also assigns 'count', a field "
        + "of base class 'Counter' that cannot be assigned until 'Counter' is constructed. Give "
        + "'copy' a first value above 'super(given);', as in 'this.copy = \"\";'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'copy' of class 'Renames' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. 'this.copy = (this.name = \"z\");' also assigns 'name', a field of "
        + "base class 'Named' that cannot be assigned until 'Named' is constructed. Give 'copy' "
        + "a first value above 'super(given);', as in 'this.copy = \"\";'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'scaled' of class 'Scaled' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Amount' runs. 'this.scaled = \"\{this.amount * 1000000\}\";' reads 'amount', a "
        + "field of base class 'Amount' that has no value until 'Amount' is constructed. Give "
        + "'scaled' a first value above 'super(given);', as in 'this.scaled = \"\";'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'shown' of class 'Noted' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Maybe' runs. 'this.shown = this.note ?? \"none\";' reads 'note', a field of base "
        + "class 'Maybe' that has no value until 'Maybe' is constructed. Give 'shown' a first "
        + "value above 'super(given);', as in 'this.shown = \"\";'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'label' of class 'Reassigns' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label "
        + "= \"\";'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'label' of class 'Suffixed' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. 'this.label = this.name + suffix;' reads 'name', a field of base class "
        + "'Named' that has no value until 'Named' is constructed. Give 'label' a first value "
        + "above 'super(given);', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "Field 'label' of class 'Pushes' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "
        + "\"\";'.");
    try sema_support.assertDiagnostic(found, 10, "/proj/src/app.ens",
        "Fields 'label' and 'mark' of class 'Kept' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Move 'this.mark = suffix;' above 'super(given);'. "
        + "'this.label = this.name + suffix;' reads 'name', a field of base class 'Named' that "
        + "has no value until 'Named' is constructed. Compute 'label' from 'given', the "
        + "constructor's parameter, as in 'this.label = given + suffix;', and move it above "
        + "'super(given);'.");
    try sema_support.assertDiagnostic(found, 11, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Pass the value to 'super(...)', as "
        + "in 'super(value);', and remove this assignment.");
    try sema_support.assertDiagnostic(found, 12, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
}

// A statement moves past 'super(...)' as it is written only where neither it nor the code between
// runs code, and where the base constructor runs code, it reads no object through a reference.
test "a statement moves past 'super(...)' only where nothing between can tell" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Announced \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(\"announced\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Sized \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(this.label);\n"
        + "\}\n"
        + "\n"
        + "shout(string text) -> string \{\n"
        + "    return text + \"!\";\n"
        + "\}\n"
        + "\n"
        + "class QuietBase extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = shout(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class CallsPastBody extends Announced \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = shout(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class QuietPastBody extends Announced \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = given + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class DividesBetween extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, int total, int parts) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        int share = total / parts;\n"
        + "        this.label = given;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsThroughReference extends Announced \{\n"
        + "    string copied;\n"
        + "\n"
        + "    constructor(string given, Sized other) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.copied = other.label;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsOwnValue extends Announced \{\n"
        + "    string copied;\n"
        + "\n"
        + "    constructor(string given, string other) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.copied = other;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PassesPastCall extends Named \{\n"
        + "    constructor(string given) \{\n"
        + "        string value = \"a\";\n"
        + "        this.name = value;\n"
        + "        print(value);\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "struct Spot \{\n"
        + "    int x;\n"
        + "    int y;\n"
        + "\}\n"
        + "\n"
        + "class PartWritten extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        Spot spot = \{ x: 1, y: 2 \};\n"
        + "        super(given);\n"
        + "        spot.x = 5;\n"
        + "        this.label = \"\{spot.x\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 8L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'label' of class 'QuietBase' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Give 'label' a first value above 'super(given);', as in "
        + "'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'CallsPastBody' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Announced' runs. Give 'label' a first value above 'super(given);', as in "
        + "'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'QuietPastBody' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Announced' runs. Move 'this.label = given + \"!\";' above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'label' of class 'DividesBetween' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label "
        + "= \"\";'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'copied' of class 'ReadsThroughReference' is assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Announced' runs. Give 'copied' a first value above 'super(given);', "
        + "as in 'this.copied = \"\";'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'copied' of class 'ReadsOwnValue' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Announced' runs. Move 'this.copied = other;' above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'label' of class 'PartWritten' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label "
        + "= \"\";'.");
}

// A statement moves past 'super(...)', or its value into the arguments, only across code that
// calls nothing, creates nothing and changes nothing but locals of plain types and fields given
// their first value, the arguments of the call included.
test "a fix moves code past 'super(...)' only across code that changes nothing it uses" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box \{\n"
        + "    int value;\n"
        + "\n"
        + "    constructor(this.value);\n"
        + "\}\n"
        + "\n"
        + "class Tracker \{\n"
        + "    Box box;\n"
        + "\n"
        + "    constructor(this.box);\n"
        + "\n"
        + "    destructor() \{\n"
        + "        this.box.value = 5;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Announced \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(\"announced\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Described \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        print(this.describe());\n"
        + "    \}\n"
        + "\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Config \{\n"
        + "    lazy const string value = \"init\";\n"
        + "\}\n"
        + "\n"
        + "class Migrated extends Announced \{\n"
        + "    string label;\n"
        + "    int count;\n"
        + "    Box box;\n"
        + "\n"
        + "    constructor(string given, string label, int count, Box box) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = label;\n"
        + "        int doubled = count * 2;\n"
        + "        this.count = doubled;\n"
        + "        this.box = box;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Aliased extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, Box first, Box second) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        first.value = 5;\n"
        + "        this.label = \"\{second.value\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class LazyRead extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = Config.value;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Released extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, Box box) \{\n"
        + "        Tracker? keeper = new Tracker(box);\n"
        + "        super(given);\n"
        + "        keeper = null;\n"
        + "        this.label = \"\{box.value\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Rewrites extends Named \{\n"
        + "    Box box;\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given, Box first, Box second) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.box = first;\n"
        + "        this.box = second;\n"
        + "        this.label = given;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ChangesArgument extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string suffix = \"a\";\n"
        + "        super(given + suffix);\n"
        + "        this.label = (suffix = \"b\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ArgumentChangesRead extends Named \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string tag = \"a\";\n"
        + "        this.extra = this.name + tag;\n"
        + "        super(given + (tag = \"b\"));\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PassesAcrossRelease extends Named \{\n"
        + "    constructor(string given, Box box) \{\n"
        + "        Tracker? keeper = new Tracker(box);\n"
        + "        this.name = \"\{box.value\}\";\n"
        + "        keeper = null;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PassesAcrossAlias extends Named \{\n"
        + "    constructor(string given, Box first, Box second) \{\n"
        + "        this.name = \"\{second.value\}\";\n"
        + "        first.value = 5;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Lent extends Described \{\n"
        + "    string label;\n"
        + "    Box box;\n"
        + "\n"
        + "    constructor(string given, string label, Box box) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        this.label = label;\n"
        + "        this.box = box;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PassDropsWrite extends Named \{\n"
        + "    constructor(string given) \{\n"
        + "        string tag = \"a\";\n"
        + "        this.name = \"n\";\n"
        + "        super(tag = \"b\");\n"
        + "        print(tag);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 11L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Fields 'label' and 'box' of class 'Migrated' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Announced' runs. Move 'this.label = label;' and 'this.box = box;' "
        + "above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'Aliased' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "
        + "\"\";'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'LazyRead' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "
        + "\"\";'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'label' of class 'Released' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Give 'label' a first value above 'super(given);', as in 'this.label = "
        + "\"\";'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Fields 'box' and 'label' of class 'Rewrites' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Give 'box' and 'label' first values above "
        + "'super(given);', as in 'this.box = ...;' and 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'label' of class 'ChangesArgument' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. Give 'label' a first value above 'super(given + suffix);', as in "
        + "'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Give 'extra' a first value here, as in 'this.extra = \"\";', "
        + "and assign 'extra' its value after 'super(given + (tag = \"b\"));'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "Fields 'label' and 'box' of class 'Lent' are assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Described' runs. Move 'this.label = label;' above 'super(given);'. Give 'box' a "
        + "first value above 'super(given);', as in 'this.box = ...;'.");
    try sema_support.assertDiagnostic(found, 10, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' cannot be assigned before 'Named' is constructed, "
        + "because constructing 'Named' gives it its value. Assign it after 'super(...)'.");
}

// A field a 'super(...)' ran without has no value after it either, so a read of it there is refused
// at once, and a statement that reads it does not move above the call.
test "a read after 'super(...)' of a field it ran without is refused with the late assignment" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected string kind;\n"
        + "\n"
        + "    protected constructor(this.name, this.kind);\n"
        + "\}\n"
        + "\n"
        + "class LateTwo extends Named \{\n"
        + "    string label;\n"
        + "    string mark;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given, \"k\");\n"
        + "        this.mark = this.label;\n"
        + "        this.label = this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Appended extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given, \"k\");\n"
        + "        this.label = this.label + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ReadsLate extends Named \{\n"
        + "    string label;\n"
        + "    string mark;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given, \"k\");\n"
        + "        this.mark = this.label;\n"
        + "        this.label = given;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 6L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Fields 'label' and 'mark' of class 'LateTwo' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Give 'mark' a first value above 'super(given, \"k\");', "
        + "as in 'this.mark = \"\";'. 'this.label = this.name;' reads 'name', a field of base "
        + "class 'Named' that has no value until 'Named' is constructed. Give 'label' a first "
        + "value above 'super(given, \"k\");', as in 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'label' of class 'LateTwo' cannot be null, and it is read here before every "
        + "path through the constructor assigns it. Assign it before this line on every path, "
        + "for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'label' of class 'Appended' is assigned after 'super(...)'. A subclass assigns "
        + "its own fields before 'super(...)', so they have values when the constructor of "
        + "'Named' runs. Give 'label' a first value above 'super(given, \"k\");', as in "
        + "'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'label' of class 'Appended' cannot be null, and it is read here before every "
        + "path through the constructor assigns it. Assign it before this line on every path, "
        + "for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Fields 'label' and 'mark' of class 'ReadsLate' are assigned after 'super(...)'. A "
        + "subclass assigns its own fields before 'super(...)', so they have values when the "
        + "constructor of 'Named' runs. Give 'mark' and 'label' first values above "
        + "'super(given, \"k\");', as in 'this.mark = \"\";' and 'this.label = \"\";'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'label' of class 'ReadsLate' cannot be null, and it is read here before every "
        + "path through the constructor assigns it. Assign it before this line on every path, "
        + "for example 'this.label = ...;'.");
}

// The statements before 'super(...)' that read one base field are refused together, a local
// declared from it with the statements that use it, and a late assignment moves with the
// declarations of the locals it reads.
test "statements that read a base field before 'super(...)' are refused together with their fixes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "class Normalized \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        this.normalize();\n"
        + "    \}\n"
        + "\n"
        + "    protected normalize() \{\n"
        + "        this.name = this.name + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Root \{\n"
        + "    protected int count = 1;\n"
        + "\}\n"
        + "\n"
        + "class TwoFields extends Named \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.first = this.name;\n"
        + "        this.second = \"\{this.name\}?\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class TwoFieldsFixed extends Normalized \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.first = this.name;\n"
        + "        this.second = \"\{this.name\}?\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ThroughLocal extends Named \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string copy = this.name;\n"
        + "        this.extra = copy;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ThroughLocalFixed extends Normalized \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string copy = this.name;\n"
        + "        this.extra = copy;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ThroughLocalAtExit extends Root \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor() \{\n"
        + "        int copy = this.count;\n"
        + "        this.extra = \"\{copy\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ThroughLocalConst extends Normalized \{\n"
        + "    const string extra;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        string copy = this.name;\n"
        + "        this.extra = copy;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class ThroughLocalBranches extends Normalized \{\n"
        + "    string extra;\n"
        + "\n"
        + "    constructor(bool flag, string given) \{\n"
        + "        string copy = this.name;\n"
        + "        this.extra = copy;\n"
        + "        if (flag) \{\n"
        + "            super(given);\n"
        + "        \} else \{\n"
        + "            super(\"x\");\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PrintsLocal extends Normalized \{\n"
        + "    constructor(string given) \{\n"
        + "        string copy = this.name;\n"
        + "        print(copy);\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Later extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        string local = \"\{given\}!\";\n"
        + "        string other = local + \"?\";\n"
        + "        this.label = other;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class LaterReadsBase extends Named \{\n"
        + "    string label;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        print(\"first\");\n"
        + "        super(given);\n"
        + "        string local = this.name;\n"
        + "        this.label = local;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 10L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so "
        + "'this.first = this.name;' and 'this.second = \"\{this.name\}?\";' cannot read it. "
        + "Compute 'first' and 'second' from 'given', the constructor's parameter, as in "
        + "'this.first = given;' and 'this.second = \"\{given\}?\";'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so 'this.first = this.name;' and 'this.second = \"\{this.name\}?\";' "
        + "cannot read it. Give 'first' and 'second' first values instead, as in 'this.first = "
        + "\"\";' and 'this.second = \"\";', and write 'this.first = this.name;' and "
        + "'this.second = \"\{this.name\}?\";' after 'super(given);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'name' of base class 'Named' has no value until 'Named' is constructed, so it "
        + "cannot be read here. Compute 'copy' from 'given', the constructor's parameter, as in "
        + "'string copy = given;'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. Move 'string copy = this.name;' and "
        + "'this.extra = copy;' after 'super(given);', and give 'extra' a first value above that "
        + "call, as in 'this.extra = \"\";'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' has no value until 'Root' is constructed, so it "
        + "cannot be read here. Above this declaration, give 'extra' a first value, as in "
        + "'this.extra = \"\";', and call 'super();'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. 'extra' is 'const', so it is assigned only "
        + "once: compute its value without reading the fields of 'Normalized'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. Move this declaration and the statements that "
        + "use 'copy' after each of 'super(given);' and 'super(\"x\");', and give 'extra' a "
        + "first value above those calls, as in 'this.extra = \"\";'.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. Read it after 'super(given);'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "Field 'label' of class 'Later' is assigned after 'super(...)'. A subclass assigns its "
        + "own fields before 'super(...)', so they have values when the constructor of 'Named' "
        + "runs. Move 'string local = \"\{given\}!\";', 'string other = local + \"?\";' and "
        + "'this.label = other;' above 'super(given);'.");
    try sema_support.assertDiagnostic(found, 9, "/proj/src/app.ens",
        "Field 'label' of class 'LaterReadsBase' is assigned after 'super(...)'. A subclass "
        + "assigns its own fields before 'super(...)', so they have values when the constructor "
        + "of 'Named' runs. 'this.label = local;' reads 'local', which is declared after "
        + "'super(given);'. Give 'label' a first value above 'super(given);', as in 'this.label "
        + "= \"\";'.");
}

// The fixes for several 'const' fields, for statements too long to quote, and for a local in a
// constructor that calls no 'super(...)'.
test "a fix for statements before 'super(...)' names every field they assign" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Normalized \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name) \{\n"
        + "        this.normalize();\n"
        + "    \}\n"
        + "\n"
        + "    protected normalize() \{\n"
        + "        this.name = this.name + \"!\";\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Root \{\n"
        + "    protected int count = 1;\n"
        + "\}\n"
        + "\n"
        + "class TwoConstants extends Normalized \{\n"
        + "    const string first;\n"
        + "    const string second;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.first = this.name;\n"
        + "        this.second = this.name;\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class TwoLong extends Normalized \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "\n"
        + "    constructor(string given) \{\n"
        + "        this.first = \"\{this.name\} is the name this object was given when it was built\";\n"
        + "        this.second = \"\{this.name\} is the name that the base class wrote down when built\";\n"
        + "        super(given);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class PrintsAtExit extends Root \{\n"
        + "    constructor() \{\n"
        + "        int copy = this.count;\n"
        + "        print(\"\{copy\}\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so 'this.first = this.name;' and 'this.second = this.name;' cannot read "
        + "it. 'first' and 'second' are 'const', so each is assigned only once: compute their "
        + "values without reading the fields of 'Normalized'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'name' of base class 'Normalized' has no value until 'Normalized' is "
        + "constructed, so it cannot be read here. Give 'first' and 'second' first values "
        + "instead, as in 'this.first = \"\";' and 'this.second = \"\";', and assign 'first' and "
        + "'second' their values after 'super(given);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'count' of base class 'Root' has no value until 'Root' is constructed, so it "
        + "cannot be read here. Call 'super();' above this declaration.");
}
