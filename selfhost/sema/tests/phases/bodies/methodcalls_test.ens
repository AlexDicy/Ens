import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

test "method calls resolve through the base chain with visibility" {
    let analysis = try sema_support.analyzeOne("public class Base \{\n"
        + "    int hidden = 1;\n"
        + "    protected shared() -> int \{ return 2; \}\n"
        + "    protected reveal() -> int \{ return this.hidden; \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected use() -> int \{ return this.shared(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let derived = new Derived();\n"
        + "    let ok = derived.reveal() + derived.use();\n"
        + "    return derived.hidden;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'hidden' is private to class 'Base', so only code inside 'Base' can use it. Mark it 'public' to "
        + "use it here.");
    try testing.assertEqual(reported.length, 1L);
}

test "an explicit toString call on a type parameter defers like a hole" {
    let analysis = try sema_support.analyzeOne("interface Marker \{\n"
        + "\}\n"
        + "class Badge implements Marker \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "render<T>(T value) -> string \{\n"
        + "    return value.toString();\n"
        + "\}\n"
        + "renderMarked<T: Marker>(T value) -> string \{\n"
        + "    return value.toString();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(render(new Badge()));\n"
        + "    print(render(7));\n"
        + "    print(renderMarked(new Badge()));\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A 'super()' written in a method is refused for that alone, even over a chain whose zero-argument
// constructor the type arguments exclude.
test "a 'super()' in a method reports only that it belongs in a constructor" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Mute \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class Top<T> \{\n"
        + "    constructor<T: Speaker>() \{ \}\n"
        + "\}\n"
        + "class Middle<T> extends Top<T> \{\n"
        + "\}\n"
        + "class Bottom extends Middle<Mute> \{\n"
        + "    run() \{ super(); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'super(...)' runs the constructor of base class 'Middle', so it can only be called in a "
        + "constructor. Remove this call.");
}

test "a 'super(...)' is refused where it cannot run exactly once on each path of a constructor" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected constructor(this.name);\n"
        + "    protected describe() -> string \{\n"
        + "        return this.name;\n"
        + "    \}\n"
        + "\}\n"
        + "class Nested extends Named \{\n"
        + "    protected constructor(bool flag) \{\n"
        + "        print(\"before\");\n"
        + "        if (flag) \{\n"
        + "            super(\"x\");\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Branched extends Named \{\n"
        + "    protected constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            super(\"x\");\n"
        + "        \} else \{\n"
        + "            super(\"y\");\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Twice extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"a\");\n"
        + "        super(\"b\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Maybe extends Named \{\n"
        + "    protected constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            super(\"a\");\n"
        + "        \}\n"
        + "        super(\"b\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Early extends Named \{\n"
        + "    protected constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            return;\n"
        + "        \}\n"
        + "        super(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Looped extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        while (true) \{\n"
        + "            super(\"a\");\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Deferred extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        () -> void later = () -> \{\n"
        + "            super(\"x\");\n"
        + "        \};\n"
        + "    \}\n"
        + "\}\n"
        + "class ChainedDeferred extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"x\");\n"
        + "        () -> void later = () -> \{\n"
        + "            super(\"y\");\n"
        + "        \};\n"
        + "    \}\n"
        + "\}\n"
        + "class Wrapped extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        (super(\"x\"));\n"
        + "    \}\n"
        + "\}\n"
        + "class Passed extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        print(super(\"x\"));\n"
        + "    \}\n"
        + "\}\n"
        + "class InMethod extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"x\");\n"
        + "    \}\n"
        + "    protected override describe() -> string \{\n"
        + "        super(\"again\");\n"
        + "        return \"method\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 9L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'super(...)' is not called on every path through the constructor of 'Nested', and base "
        + "class 'Named' must be constructed before the constructor finishes. Call 'super(...)' on "
        + "the path that skips it.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'Twice' already calls 'super(...)' on this path, and base class 'Named' "
        + "is constructed only once. Remove this call.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "'super(...)' may already have run on a path that reaches this call, and base class 'Named' "
        + "is constructed only once. Call 'super(...)' once on each path.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "This 'return' ends the constructor of 'Early' before base class 'Named' is "
        + "constructed. Call 'super(...)' before this 'return'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "'super(...)' cannot be called inside a loop, because a loop can run it more than once or "
        + "not at all. Move it out of the loop, to where it runs once on each path.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/main.ens",
        "'super(...)' cannot be called inside a lambda, because a lambda can run later or not at "
        + "all. Call it in the body of the constructor of 'Deferred'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/main.ens",
        "'super(...)' cannot be called inside a lambda, and the constructor of 'ChainedDeferred' "
        + "already calls it. Remove this call.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/main.ens",
        "'super(...)' constructs base class 'Named', so it is a statement of its own. Write it "
        + "as 'super(\"x\");'.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/main.ens",
        "'super(...)' runs the constructor of base class 'Named', so it can only be called in a "
        + "constructor. Remove this call.");
}

test "a 'super(...)' in a method names the call of the base method its arguments fit" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected constructor(this.name);\n"
        + "    protected rename(string name) -> string \{\n"
        + "        return name;\n"
        + "    \}\n"
        + "    protected retitle(string title, string subtitle) -> string \{\n"
        + "        return title;\n"
        + "    \}\n"
        + "\}\n"
        + "class Renamed extends Named \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"x\");\n"
        + "    \}\n"
        + "    protected override rename(string name) -> string \{\n"
        + "        super(name);\n"
        + "        return name;\n"
        + "    \}\n"
        + "    protected override retitle(string title, string subtitle) -> string \{\n"
        + "        super(title, \"a subtitle long enough to spell\");\n"
        + "        return title;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    string refusal = "'super(...)' runs the constructor of base class 'Named', so it can only be called in a "
        + "constructor. Remove this call.";
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        refusal + " To call the base class's version of 'rename', write 'super.rename(name)'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        refusal + " To call the base class's version of 'retitle' with these arguments, write "
        + "'super.retitle' instead of 'super'.");
}

// A 'super(...)' that is the body of a switch arm or the initializer of a 'for' loop is told how
// to write it.
test "a 'super(...)' in a switch arm or in a loop's initializer says where to write it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "\n"
        + "enum Side \{\n"
        + "    Left,\n"
        + "    Right\n"
        + "\}\n"
        + "\n"
        + "class Armed extends Named \{\n"
        + "    constructor(Side side) \{\n"
        + "        switch (side) \{\n"
        + "            Side.Left -> super(\"left\"),\n"
        + "            Side.Right -> \{\n"
        + "                super(\"right\");\n"
        + "            \}\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Initialized extends Named \{\n"
        + "    constructor() \{\n"
        + "        for (super(\"a\"); false;) \{\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'super(...)' constructs base class 'Named', so it is a statement of its own. Write "
        + "the arm as 'Side.Left -> \{ super(\"left\"); \}'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'super(...)' is a statement of its own, so it cannot be the initializer of a 'for' "
        + "loop. Move it above the loop.");
}
