// The switch validation matrix: scrutinee kinds, label rules and duplicates, 'is' arm targets
// and reachability, and exhaustiveness for enums and sealed hierarchies.
import @std.testing;
import sema_support;

test "enum labels resolve while duplicates and unknown members are reported" {
    let analysis = try sema_support.analyzeOne("enum Color \{ Red, Green, Blue, \}\n"
        + "main() -> int \{\n"
        + "    const Color c = Color.Red;\n"
        + "    switch (c) \{\n"
        + "        Red -> \{ \},\n"
        + "        Color.Red -> \{ \},\n"
        + "        Purple -> \{ \},\n"
        + "        Green -> \{ \},\n"
        + "        Blue -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This switch already has an arm for 'Color.Red'. Remove this second one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Purple' is not a member of enum 'Color'. Its members are 'Red', 'Green' and 'Blue'.");
    try testing.assertEqual(reported.length, 2L);
}

test "a non-exhaustive enum switch names the missing members" {
    let analysis = try sema_support.analyzeOne("enum Color \{ Red, Green, Blue, \}\n"
        + "main() -> int \{\n"
        + "    const Color c = Color.Red;\n"
        + "    switch (c) \{\n"
        + "        Red -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This switch has no arm for 'Color.Green' and 'Color.Blue'. Add an arm for each, or a 'default' "
            + "arm.");
    try testing.assertEqual(reported.length, 1L);
}

test "integer switches need constant labels, distinct values, and a default" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    let x = 3;\n"
        + "    let y = 2;\n"
        + "    switch (x) \{\n"
        + "        'A' -> \{ \},\n"
        + "        65 -> \{ \},\n"
        + "        y -> \{ \},\n"
        + "        \"one\" -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    switch (y) \{\n"
        + "        1 -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This switch already has an arm for '65'. Remove this second one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Label 'y' is not an integer constant, and every label of a switch on an integer must be one, "
            + "such as '1'. Compare with 'y' in an 'if' instead.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Switch label of type 'string' does not match the switch value of type 'int'. Write a "
        + "label of type 'int'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "A switch on 'int' must have a 'default' arm, because its arms cannot list every 'int' value.");
    try testing.assertEqual(reported.length, 4L);
}

test "string switches take distinct literal labels of the right type" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    string s = \"a\";\n"
        + "    switch (s) \{\n"
        + "        \"x\" -> \{ \},\n"
        + "        \"x\" -> \{ \},\n"
        + "        s -> \{ \},\n"
        + "        3 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This switch already has an arm for '\"x\"'. Remove this second one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Label 's' is not a string literal, and every label of a switch on a string must be one, such as "
            + "'\"a\"'. Compare with 's' in an 'if' instead.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Switch label of type 'int' does not match the switch value of type 'string'. Write a "
        + "string literal label.");
    try testing.assertEqual(reported.length, 3L);
}

test "one default arm and a supported scrutinee kind are required" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    let x = 1;\n"
        + "    switch (x) \{\n"
        + "        1 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    bool flag = true;\n"
        + "    switch (flag) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "A switch can have only one 'default' arm.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot switch on 'flag', because its type 'bool' is not an enum, an integer, a string or a "
            + "class. Compare it with 'if' and 'else' instead.");
    try testing.assertEqual(reported.length, 2L);
}

test "'is' arm targets must be classes that can match without always matching" {
    let analysis = try sema_support.analyzeOne("class Base \{ constructor(); \}\n"
        + "class Left extends Base \{ constructor() \{ super(); \} \}\n"
        + "class Right extends Base \{ constructor() \{ super(); \} \}\n"
        + "class Lone \{ constructor(); \}\n"
        + "struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Base b = new Left();\n"
        + "    switch (b) \{\n"
        + "        is Lone -> \{ \},\n"
        + "        is Base -> \{ \},\n"
        + "        is Point -> \{ \},\n"
        + "        is Left -> \{ \},\n"
        + "        is Right -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "A value of type 'Base' can never be a 'Lone', because 'Lone' is not a subclass of 'Base'. Remove "
            + "this arm.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'is Base' matches every value of this switch over 'Base', so the switch always takes this arm. "
            + "Write the statements of this arm instead of the switch.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "The type of an 'is' arm must be a class or an interface, and 'Point' is neither.");
    try testing.assertEqual(reported.length, 3L);
}

test "arm order, label mixing, and the class-value arm requirement are checked" {
    let analysis = try sema_support.analyzeOne("class Shape \{ constructor(); \}\n"
        + "class Circle extends Shape \{ constructor() \{ super(); \} \}\n"
        + "class Dot extends Circle \{ constructor() \{ super(); \} \}\n"
        + "main() -> int \{\n"
        + "    Shape s = new Dot();\n"
        + "    switch (s) \{\n"
        + "        is Circle -> \{ \},\n"
        + "        is Dot -> \{ \},\n"
        + "        5 -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    switch (s) \{\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    let x = 1;\n"
        + "    switch (x) \{\n"
        + "        is Circle -> \{ \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This 'is Dot' arm never runs, because the earlier 'is Circle' arm already matches every 'Dot'. "
        + "Move it above that arm, or remove it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot mix value labels with 'is' arms in the same switch.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "A switch over a class value needs at least one 'is Type ->' arm.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "An 'is' arm needs a class switch value, but this switch is over 'int'.");
    try testing.assertEqual(reported.length, 4L);
}

test "sealed hierarchies drive type switch exhaustiveness" {
    let analysis = try sema_support.analyzeOne("sealed abstract class Expr \{ constructor(); \}\n"
        + "class Num extends Expr \{ constructor() \{ super(); \} \}\n"
        + "class Neg extends Expr \{ constructor() \{ super(); \} \}\n"
        + "class DoubleNeg extends Neg \{ constructor() \{ super(); \} \}\n"
        + "sealed class Token \{ constructor(); \}\n"
        + "class Word extends Token \{ constructor() \{ super(); \} \}\n"
        + "interface Marker \{ \}\n"
        + "class Tagged implements Marker \{ constructor(); \}\n"
        + "class Open \{ constructor(); \}\n"
        + "class Sub extends Open \{ constructor() \{ super(); \} \}\n"
        + "main() -> int \{\n"
        + "    Expr e = new Num();\n"
        + "    switch (e) \{\n"
        + "        is Num -> \{ \},\n"
        + "    \}\n"
        + "    switch (e) \{\n"
        + "        is Num -> \{ \},\n"
        + "        is Neg -> \{ \},\n"
        + "    \}\n"
        + "    Token t = new Word();\n"
        + "    switch (t) \{\n"
        + "        is Word -> \{ \},\n"
        + "    \}\n"
        + "    Marker m = new Tagged();\n"
        + "    switch (m) \{\n"
        + "        is Tagged -> \{ \},\n"
        + "    \}\n"
        + "    Open o = new Sub();\n"
        + "    switch (o) \{\n"
        + "        is Sub -> \{ \},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This switch has no arm for 'Neg', a subclass of sealed class 'Expr'. Add an arm for it, or a "
        + "'default' arm.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "A switch over 'Token' must have a 'default' arm, because 'Token' is not abstract, so a value can "
        + "be a 'Token' itself, which no subclass arm matches.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "A switch over 'Marker' must have a 'default' arm: interfaces are open, so any class "
        + "anywhere may implement 'Marker'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "A switch over 'Open' must have a 'default' arm, because 'Open' is not 'sealed', so it can have "
            + "subclasses that no arm matches.");
    try testing.assertEqual(reported.length, 4L);
}

test "a duplicate 'null' label is reported" {
    let analysis = try sema_support.analyzeOne("len(string? s) -> int \{\n"
        + "    return switch (s) \{\n"
        + "        \"hi\" -> 2,\n"
        + "        null -> -1,\n"
        + "        null -> -2,\n"
        + "        default -> 0,\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{ return len(null); \}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "This switch already has a 'null' "
        + "arm. Remove this second one.");
    try testing.assertEqual(reported.length, 1L);
}

// A 'null' arm on a value that can never be null, an empty switch used as a value, a block arm
// and an array of 'void' are each refused once.
test "a switch refusal names the value it is on and the arm to change" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    int k = 1;\n"
        + "    switch (k) \{\n"
        + "        null -> \{\},\n"
        + "        default -> \{\},\n"
        + "    \}\n"
        + "    int v = switch (k) \{\n"
        + "    \};\n"
        + "    int w = switch (k) \{\n"
        + "        1 -> \{\},\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    int[] never = new void[2];\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'k' has type 'int', which can never be null, so a 'null' arm never runs. Remove this arm.");
    try sema_support.assertDiagnostic(reported, 1, file, "A switch used as a value needs at least one arm.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "Each arm of a switch used as a value must give a value, as in '1 -> 0,', not run a '\{ \}' block.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Cannot create an array of 'void', because 'void' means no value.");
    try testing.assertEqual(reported.length, 4L);
}

// A string, an enum with a member left out, an open class and a sealed class that is not abstract each
// need a 'default' arm for a different reason.
test "a switch without a 'default' arm says why its arms cannot cover every value" {
    let analysis = try sema_support.analyzeOne("enum Color \{\n"
        + "    Red,\n"
        + "    Green,\n"
        + "\}\n"
        + "\n"
        + "class Base \{\n"
        + "\}\n"
        + "\n"
        + "class Open extends Base \{\n"
        + "\}\n"
        + "\n"
        + "sealed class Tree \{\n"
        + "\}\n"
        + "\n"
        + "class Leaf extends Tree \{\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    Color c = Color.Red;\n"
        + "    string text = \"a\";\n"
        + "    switch (text) \{\n"
        + "        \"a\" -> \{\},\n"
        + "    \}\n"
        + "    switch (c) \{\n"
        + "        Color.Red -> \{\},\n"
        + "    \}\n"
        + "    Base base = new Open();\n"
        + "    switch (base) \{\n"
        + "        is Open -> \{\},\n"
        + "    \}\n"
        + "    Tree tree = new Leaf();\n"
        + "    switch (tree) \{\n"
        + "        is Leaf -> \{\},\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "A switch on 'string' must have a 'default' arm, because its arms cannot list every 'string' value.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "This switch has no arm for 'Color.Green'. Add an arm for it, or a 'default' arm.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "A switch over 'Base' must have a 'default' arm, because 'Base' is not 'sealed', so it can have "
        + "subclasses that no arm matches.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "A switch over 'Tree' must have a 'default' arm, because 'Tree' is not abstract, so a value can "
        + "be a 'Tree' itself, which no subclass arm matches.");
    try testing.assertEqual(reported.length, 4L);
}

// The earlier 'is' arm stays, so the switch still has one, and the missing 'default' arm is not
// reported beside it.
test "an 'is' arm matching every value after another 'is' arm becomes the 'default' arm" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "class Circle extends Shape \{\n"
        + "    constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "pick(Shape s) -> int \{\n"
        + "    return switch (s) \{\n"
        + "        is Circle -> 1,\n"
        + "        is Shape -> 2,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'is Shape' matches every value of this switch over 'Shape'. Use a 'default' arm instead.");
    try testing.assertEqual(reported.length, 1L);
}

// A switch arm literal beside a typed arm takes that arm's type, so a literal too large for it gets
// the '?:' fix: declare the target wide enough and convert the typed arm. An arm of a type the target
// cannot take is refused as the assignment it is.
test "an integer literal arm takes the type of the typed arm beside it, as a '?:' branch does" {
    let analysis = try sema_support.analyzeOne("forms(byte b, int i, float f, int k, bool flag) \{\n"
        + "    short x = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        default -> 40000,\n"
        + "    \};\n"
        + "    ushort y = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        default -> 65536,\n"
        + "    \};\n"
        + "    int z = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    float w = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    short t = flag ? b : 40000;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 40000 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Declare 'x' as 'ushort' "
        + "and convert 'b' ('0 -> b as ushort').");
    try sema_support.assertDiagnostic(reported, 1, file, "Variable 'y' has type 'ushort', but its value "
        + "has type 'int'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'i', an 'int'. Declare 'z' as "
        + "'long' and convert 'i' ('0 -> i as long').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'w' as "
        + "'double' and convert 'f' ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 40000 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Declare 't' as 'ushort' "
        + "and convert 'b' ('ushort t = flag ? b as ushort : 40000;').");
    try testing.assertEqual(reported.length, 5L);
}
