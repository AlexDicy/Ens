import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

// 'as? char' gives 'char?' from an integer that may not be a code point. A 'byte' always is one, so
// it converts with 'as', a 'char' needs no conversion, a value that is not an integer has no code
// point to check, and two levels of null are refused first, the way the enum form refuses them.
test "an integer converts to 'char?' with 'as?', and a value that is always a code point is refused" {
    let analysis = try sema_support.analyzeBody(["int code = 65;", "char? found = code as? char;",
        "ushort high = 1;", "char? alsoFound = high as? char;", "long wide = 1;",
        "char picked = wide as? char ?? '?';", "byte small = 1;", "char? fromByte = small as? char;",
        "char letter = 'a';", "char? same = letter as? char;", "double ratio = 1.0;",
        "char? fromDouble = ratio as? char;", "int?? deep = null;", "char? fromDeep = deep as? char;"]);
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file, "Converting 'byte' to 'char' always succeeds, "
        + "because every 'byte' value is a code point. Write 'as' instead of 'as?'.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "'letter' is already a 'char', so 'as? char' "
        + "does not change it. Remove 'as? char'.");
    try sema_support.assertDiagnostic(diagnostics, 2, file, "Cannot convert 'double' to 'char' with 'as?'. "
        + "Only an integer can be checked against the code points of Unicode.");
    try sema_support.assertDiagnostic(diagnostics, 3, file, "Cannot use 'as?' on a value of type 'int??', "
        + "because 'as?' checks for only one level of null. Check 'deep' for null first "
        + "('if (deep != null)').");
    try testing.assertEqual(diagnostics.length, 4L);
}

// The enum form of 'as?' refuses two levels of null with the same text as the class and char forms.
test "an integer with two levels of null is refused by 'as?' to an enum before its integer check" {
    let analysis = try sema_support.analyzeOne("enum Level \{\n"
        + "    Low = 0,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int?? deep = null;\n"
        + "    Level? found = deep as? Level;\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "Cannot use 'as?' on a value "
        + "of type 'int??', because 'as?' checks for only one level of null. Check 'deep' for null first "
        + "('if (deep != null)').");
    try testing.assertEqual(diagnostics.length, 1L);
}

test "guards, re-checks, refinement, steps, and calls keep sound narrowings" {
    let analysis = try sema_support.analyzeOne("class Door \{ protected int code; protected "
        + "constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "use(Door d) \{ \}\n"
        + "guarded(Door? d) -> int \{\n"
        + "    if (d == null) \{ return 0; \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "recheck(int? n) -> int \{\n"
        + "    if (n != null) \{\n"
        + "        if (n != null) \{ return n; \}\n"
        + "        return n ?? 0;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "refined() -> int \{\n"
        + "    int? n = null;\n"
        + "    n = 5;\n"
        + "    return n;\n"
        + "\}\n"
        + "stepped(int? n) -> int \{\n"
        + "    if (n == null) \{ return 0; \}\n"
        + "    n++;\n"
        + "    --n;\n"
        + "    n += 1;\n"
        + "    return n;\n"
        + "\}\n"
        + "keepAcrossCall(Door? d) -> int \{\n"
        + "    if (d != null) \{\n"
        + "        use(d);\n"
        + "        return d.code;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "narrowedScrutinee(Color? c) -> int \{\n"
        + "    if (c == null) \{ return -1; \}\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "nullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, null -> 0, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return guarded(new Door(1)) + recheck(2) + refined() + stepped(5)\n"
        + "        + keepAcrossCall(new Door(3)) + narrowedScrutinee(Color.Red)\n"
        + "        + nullArm(null);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A stable place is a local, a parameter, 'this', or a 'const' field reached through a stable
// place, however long the chain, and a check on one narrows it. A call that cannot reach the
// chain's root keeps it narrowed. A value that is not stable reads cleanly once it is copied into
// a local, which is the fix the refusals suggest.
test "a check narrows a local, a parameter, 'this' and a 'const' field reached through one" {
    let analysis = try sema_support.analyzeOne("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "    protected const int? count;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null, this.count = null);\n"
        + "\n"
        + "    protected limitLength() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected innerCount() -> int \{\n"
        + "        if (this.inner != null && this.inner.count != null) \{\n"
        + "            return this.inner.count;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "unrelated(Meter m) \{ \}\n"
        + "throughLocal(Gauge gauge, Meter m) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        unrelated(m);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedField(Meter m) -> int \{\n"
        + "    let level = m.level;\n"
        + "    if (level != null) \{\n"
        + "        return level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "copiedElement(int?[] cells) -> int \{\n"
        + "    let value = cells[0];\n"
        + "    if (value != null) \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\", null, 3), 1);\n"
        + "    let m = new Meter();\n"
        + "    return (gauge.limitLength() + throughLocal(gauge, m)) as int + gauge.innerCount()\n"
        + "        + copiedField(m) + copiedElement(new int?[1]);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A mutable field and an array element are never stable places, so a check on either narrows
// nothing and a write through either refines nothing. Each refusal that would otherwise suggest
// the check names the step at fault and the local copy instead, wherever it fires: passing the
// value on, reading a member, indexing, slicing, calling a function value, arithmetic, a compound
// assignment and '++'. In a chain it is the outermost unstable step, and the copy spells it in
// full. A member only a subclass has gets the type test's version, and a member no subclass has gets none.
// 'this' is a stable place that no write can change, so a type test on it narrows it wherever
// one on a parameter would, and inside a lambda created where the test holds, as a captured
// parameter is narrowed there.
test "a type test narrows 'this' like a parameter, and inside a lambda created where it holds" {
    let analysis = try sema_support.analyzeOne("class Base \{\n"
        + "    constructor();\n"
        + "    measure() -> int \{\n"
        + "        int total = this is Box ? this.width : 0;\n"
        + "        if (this is Box && this.width > 1) \{\n"
        + "            total = total + 1;\n"
        + "        \}\n"
        + "        if (!(this is Box)) \{\n"
        + "            return total;\n"
        + "        \}\n"
        + "        () -> int read = () -> this.width;\n"
        + "        return total + this.width + read();\n"
        + "    \}\n"
        + "\}\n"
        + "class Box extends Base \{\n"
        + "    int width = 3;\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// '?.' tests the declared level of null and reads a member of the value, so where a type test holds
// it reads the tested type's members: in a branch, in a '?:', on a 'const' field and in a safe call.
// '??' gives its fallback the declared type, so any 'Shape' can stand in.
test "a '?.' on a place a type test narrowed reads the tested type's members" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected area() -> int \{\n"
        + "        return this.radius * 3;\n"
        + "    \}\n"
        + "\}\n"
        + "class Square extends Shape \{ protected constructor(); \}\n"
        + "class Frame \{\n"
        + "    protected const Shape? shape;\n"
        + "\n"
        + "    protected constructor(this.shape = null);\n"
        + "\}\n"
        + "branch(Shape? shape) -> int? \{\n"
        + "    if (shape is Circle) \{ return shape?.radius; \}\n"
        + "    return null;\n"
        + "\}\n"
        + "ternary(Shape? shape) -> int? \{\n"
        + "    return shape is Circle ? shape?.area() : null;\n"
        + "\}\n"
        + "field(Frame frame) -> int? \{\n"
        + "    if (frame.shape is Circle) \{ return frame.shape?.radius; \}\n"
        + "    return null;\n"
        + "\}\n"
        + "fallback(Shape? shape) -> Shape \{\n"
        + "    if (shape is Circle) \{ return shape ?? new Square(); \}\n"
        + "    return new Square();\n"
        + "\}\n"
        + "untested(Shape? shape) -> int? \{\n"
        + "    return shape?.radius;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Type 'Shape' has no field or method named 'radius'.");
    try testing.assertEqual(reported.length, 1L);
}

test "a mutable field or an array element keeps no narrowing" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Meter \{\n"
        + "    protected int? level = 5;\n"
        + "    protected Meter? next = null;\n"
        + "    protected const Meter? fixed;\n"
        + "    protected int[]? slots = null;\n"
        + "    protected ((int) -> int)? handler = null;\n"
        + "    protected Shape shape = new Circle();\n"
        + "\n"
        + "    protected constructor(this.fixed = null);\n"
        + "\n"
        + "    protected read() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "make() -> Meter \{\n"
        + "    return new Meter();\n"
        + "\}\n"
        + "passed(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "written(Meter m) -> int \{\n"
        + "    m.level = 4;\n"
        + "    return m.level;\n"
        + "\}\n"
        + "memberRead(Meter m) -> int \{\n"
        + "    if (m.next != null) \{\n"
        + "        return m.next.read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "indexed(Meter m) -> int \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "sliced(Meter m) -> long \{\n"
        + "    if (m.slots != null) \{\n"
        + "        return m.slots.slice(0, 1).length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "called(Meter m) -> int \{\n"
        + "    if (m.handler != null) \{\n"
        + "        return m.handler(1);\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "fixedThenMutable(Meter m) -> int \{\n"
        + "    if (m.fixed != null && m.fixed.level != null) \{\n"
        + "        return m.fixed.level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "unspellable() -> int \{\n"
        + "    if (make().level != null) \{\n"
        + "        return make().level;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "element(int?[] cells) -> int \{\n"
        + "    if (cells[0] != null) \{\n"
        + "        return cells[0];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementWrite(int?[] cells) -> int \{\n"
        + "    cells[0] = 4;\n"
        + "    return cells[0];\n"
        + "\}\n"
        + "elementUnspellable(int?[] cells, int i) -> int \{\n"
        + "    if (cells[i + 1] != null) \{\n"
        + "        return cells[i + 1];\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "elementMember(Meter?[] meters) -> int \{\n"
        + "    if (meters[0] != null) \{\n"
        + "        return meters[0].read();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "tested(Meter m) -> int \{\n"
        + "    if (m.shape is Circle) \{\n"
        + "        return m.shape.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "misspelled(Meter m) -> int \{\n"
        + "    return m.shape.radiuss;\n"
        + "\}\n"
        + "added(Meter m) -> int \{\n"
        + "    if (m.level != null) \{\n"
        + "        return m.level + 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "addedInPlace(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "stepped(Meter m) \{\n"
        + "    if (m.level != null) \{\n"
        + "        m.level++;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let m = new Meter();\n"
        + "    addedInPlace(m);\n"
        + "    stepped(m);\n"
        + "    int?[] cells = new int?[2];\n"
        + "    Meter?[] meters = new Meter?[1];\n"
        + "    return passed(m) + written(m) + memberRead(m) + indexed(m) + (sliced(m) as int)\n"
        + "        + called(m) + fixedThenMutable(m) + unspellable() + element(cells)\n"
        + "        + elementWrite(cells) + elementUnspellable(cells, 0) + elementMember(meters)\n"
        + "        + tested(m) + misspelled(m) + added(m);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string returned = "returns 'int', but this value has type 'int?'. The value may be null here. ";
    string ofLevel = sema_support.unstableAdvice("'m.level'", "a field", "let level = m.level;");
    string ofCell = sema_support.unstableAdvice("'cells[0]'", "an array element", "let value = cells[0];");
    string ofSlots = sema_support.unstableAdvice("'m.slots'", "a field", "let slots = m.slots;");
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Function 'passed' {returned}" + ofLevel);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Function 'written' {returned}" + ofLevel);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Cannot call a member of 'Meter?' because it may be null here. "
        + sema_support.unstableAdvice("'m.next'", "a field", "let next = m.next;"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Cannot index 'int[]?' because it may be null here. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Cannot call 'slice' on 'int[]?' because it may be null here. " + ofSlots);
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'handler' has type '((int) -> int)?', which may be null here. "
        + sema_support.unstableAdvice("'m.handler'", "a field", "let handler = m.handler;"));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Function 'fixedThenMutable' {returned}"
        + sema_support.unstableAdvice("'m.fixed.level'", "a field", "let level = m.fixed.level;"));
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "Function 'unspellable' {returned}"
        + sema_support.unstableAdvice("'make().level'", "a field", "let level = make().level;"));
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "Function 'element' {returned}" + ofCell);
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "Function 'elementWrite' {returned}" + ofCell);
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "Function 'elementUnspellable' {returned}"
        + sema_support.unstableAdvice("'cells[i + 1]'", "an array element", "let value = cells[i + 1];"));
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "Cannot call a member of 'Meter?' because it may be null here. "
        + sema_support.unstableAdvice("'meters[0]'", "an array element", "let value = meters[0];"));
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "Type 'Shape' has no field or method named 'radius'. 'm.shape' is a field, so it can change at "
        + "any time. A later read of it can be another type even after a type test. Copy it into a local "
        + "first ('let shape = m.shape;') and test the local.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "Type 'Shape' has no field or method named 'radiuss'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'+' needs numbers on both sides, but 'm.level' has type 'int?'. " + ofLevel);
    string writtenBack = sema_support.unstableWriteAdvice("'m.level'", "let level = m.level;", "m.level");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, but 'm.level' has type 'int?'. " + writtenBack);
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens",
        "'++' works only on numbers, and 'm.level' has type 'int?'. " + writtenBack);
    try testing.assertEqual(reported.length, 17L);
}

// No callee can write a 'const' field, so a call drops nothing a stable place proved: not through
// 'this' as the receiver, not through a chain as the receiver, and not through the root passed as
// an argument or to a constructor.
test "a call drops nothing a stable place proved" {
    let analysis = try sema_support.analyzeOne("class Gauge \{\n"
        + "    protected const string? limit;\n"
        + "    protected const Gauge? inner;\n"
        + "\n"
        + "    protected constructor(this.limit = null, this.inner = null);\n"
        + "\n"
        + "    protected touch() \{\n"
        + "    \}\n"
        + "\n"
        + "    protected limitAfterCall() -> long \{\n"
        + "        if (this.limit != null) \{\n"
        + "            this.touch();\n"
        + "            return this.limit.length;\n"
        + "        \}\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "class Wrapper \{\n"
        + "    protected constructor(Gauge gauge) \{\n"
        + "    \}\n"
        + "\}\n"
        + "touched(Gauge gauge) \{ \}\n"
        + "afterCalls(Gauge gauge) -> long \{\n"
        + "    if (gauge.inner != null && gauge.inner.limit != null) \{\n"
        + "        gauge.inner.touch();\n"
        + "        touched(gauge);\n"
        + "        let wrapper = new Wrapper(gauge);\n"
        + "        return gauge.inner.limit.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let gauge = new Gauge(\"ab\", new Gauge(\"c\"));\n"
        + "    return (gauge.limitAfterCall() + afterCalls(gauge)) as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "weak fields never narrow, but weak checks and the strong-local copy stay legal" {
    let analysis = try sema_support.analyzeOne("class Node \{ protected int size; protected "
        + "constructor(this.size = 0); \}\n"
        + "class Holder \{ protected weak Node? target; protected constructor(); \}\n"
        + "watch(Holder h) -> int \{\n"
        + "    if (h.target == null) \{ return 0; \}\n"
        + "    bool alive = h.target != null;\n"
        + "    let target = h.target;\n"
        + "    if (target != null && alive) \{ return target.size; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return watch(new Holder()); \}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a lazy const read through its type narrows like a local" {
    let analysis = try sema_support.analyzeOne("class Holder \{ protected const string? name; "
        + "protected constructor(this.name = null); \}\n"
        + "class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius; protected constructor(this.radius = 0); \}\n"
        + "class Box<T> \{ protected lazy const string? tag = pick(); protected constructor(); \}\n"
        + "class Settings \{\n"
        + "    protected lazy const string? label = pick();\n"
        + "    protected lazy const Holder holder = new Holder(\"holder\");\n"
        + "    protected lazy const Holder? maybeHolder = new Holder(\"maybe\");\n"
        + "    protected lazy const Shape shape = new Circle(3);\n"
        + "\}\n"
        + "pick() -> string? \{ return \"label\"; \}\n"
        + "checked() -> long \{\n"
        + "    if (Settings.label != null) \{ return Settings.label.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "guarded() -> long \{\n"
        + "    if (Settings.label == null) \{ return 0; \}\n"
        + "    return Settings.label.length;\n"
        + "\}\n"
        + "looped() -> long \{\n"
        + "    long total = 0;\n"
        + "    while (Settings.label != null && total < 10) \{ total = total + Settings.label.length; \}\n"
        + "    return total;\n"
        + "\}\n"
        + "shortCircuits() -> bool \{\n"
        + "    bool both = Settings.label != null && Settings.label.length > 0;\n"
        + "    return both || Settings.label == null || Settings.label.length > 0;\n"
        + "\}\n"
        + "negated() -> long \{\n"
        + "    if (!(Settings.label == null)) \{ return (Settings.label).length; \}\n"
        + "    return Settings.label != null ? Settings.label.length : 0;\n"
        + "\}\n"
        + "tested() -> int \{\n"
        + "    if (Settings.shape is Circle) \{ return Settings.shape.radius; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "chained() -> long \{\n"
        + "    if (Settings.holder.name != null) \{ return Settings.holder.name.length; \}\n"
        + "    if (Settings.maybeHolder != null && Settings.maybeHolder.name != null) \{\n"
        + "        return Settings.maybeHolder.name.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "insideLambda() -> long \{\n"
        + "    () -> long measure = () -> \{\n"
        + "        if (Settings.label != null) \{ return Settings.label.length; \}\n"
        + "        return 0;\n"
        + "    \};\n"
        + "    return measure();\n"
        + "\}\n"
        + "shared() -> long \{\n"
        + "    if (Box<int>.tag != null) \{ return Box<string>.tag.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    long total = checked() + guarded() + looped() + negated() + tested() + chained()\n"
        + "        + insideLambda() + shared();\n"
        + "    if (shortCircuits()) \{ return total as int; \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a static or lazy field without 'const' never narrows" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Counters \{\n"
        + "    protected static int? counter;\n"
        + "    protected lazy string? loose = pick();\n"
        + "\}\n"
        + "pick() -> string? \{ return \"loose\"; \}\n"
        + "counted() -> int \{\n"
        + "    if (Counters.counter != null) \{ return Counters.counter + 1; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "measured() -> long \{\n"
        + "    if (Counters.loose != null) \{ return Counters.loose.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return counted() + measured() as int; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout, Stage.Bodies]);
    let declared = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(declared, 0, "/proj/src/main.ens",
        "A 'static' field must also be 'const'. Write 'static const int? counter = ...', or make "
        + "'counter' an instance field.");
    try sema_support.assertDiagnostic(declared, 1, "/proj/src/main.ens",
        "Static const 'counter' needs its value on the declaration, because nothing else ever "
        + "assigns it. Write 'static const int? counter = ...'.");
    try sema_support.assertDiagnostic(declared, 2, "/proj/src/main.ens",
        "Static const 'counter' has type 'int?', but a static const can only have a number type, "
        + "'char', 'bool' or 'string'. Make 'counter' a 'lazy const', or give it one of those "
        + "types.");
    try sema_support.assertDiagnostic(declared, 3, "/proj/src/main.ens",
        "A 'lazy' field must also be 'const'; its value is built once on the first read and never "
        + "changes. Write 'lazy const string? loose = ...', or make 'loose' an instance field.");
    try testing.assertEqual(declared.length, 4L);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'+' needs numbers on both sides, but 'Counters.counter' has type 'int?'. Supply a fallback for "
        + "'Counters.counter' with '??'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Supply a fallback for "
        + "'Counters.loose' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

test "unsound reads stay rejected under narrowing" {
    let analysis = try sema_support.analyzeOne("class Door \{ protected int code; protected "
        + "constructor(this.code = 0); \}\n"
        + "enum Color \{ Red, Green, \}\n"
        + "maybeInt() -> int? \{ return 3; \}\n"
        + "leaky(Door? d) -> int \{\n"
        + "    if (d == null) \{ \}\n"
        + "    return d.code;\n"
        + "\}\n"
        + "widened() -> int \{\n"
        + "    int? n = 5;\n"
        + "    n = maybeInt();\n"
        + "    return n;\n"
        + "\}\n"
        + "presence(int y) -> int \{\n"
        + "    return y ?? 3;\n"
        + "\}\n"
        + "missingNullArm(Color? c) -> int \{\n"
        + "    return switch (c) \{ Red -> 1, Green -> 2, \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return leaky(null) + widened() + presence(1)\n"
        + "        + missingNullArm(null);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'Door?' because it may be null here. Check 'd' for null first "
        + "('if (d != null)').");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Function 'widened' returns 'int', but this value has type 'int?'. The value may be null here. "
        + "'n' is assigned a value of type 'int?', which can be null. Check 'n' for null after the "
        + "assignment ('if (n != null)').");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'y' has type 'int', which can never be null, so the fallback after '??' is never used. Remove "
        + "'?? 3', or give 'y' a nullable type such as 'int?'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'c' can be null, and no arm of this switch matches null. Add a 'null ->' arm or a 'default' arm.");
    try testing.assertEqual(reported.length, 4L);
}

// Nothing writes a lazy const, so a check of one holds inside a lambda created where it holds.
test "a lazy const narrowing reaches a lambda, and a mutable field under one never narrows" {
    let analysis = try sema_support.analyzeOne("class Tally \{ protected int? count; protected string? note; "
        + "protected constructor(this.count = null, this.note = null); \}\n"
        + "class Settings \{\n"
        + "    protected lazy const string? label = pick();\n"
        + "    protected lazy const Tally tally = new Tally(1, \"a\");\n"
        + "\}\n"
        + "pick() -> string? \{ return \"label\"; \}\n"
        + "unchecked() -> long \{\n"
        + "    return Settings.label.length;\n"
        + "\}\n"
        + "outsideLambda() -> long \{\n"
        + "    if (Settings.label != null) \{\n"
        + "        () -> long measure = () -> Settings.label.length;\n"
        + "        return measure();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "mutableField() -> long \{\n"
        + "    if (Settings.tally.note != null) \{ return Settings.tally.note.length; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "compound() \{\n"
        + "    if (Settings.tally.count != null) \{ Settings.tally.count += 1; \}\n"
        + "\}\n"
        + "refusedWrite() -> long \{\n"
        + "    if (Settings.label != null) \{\n"
        + "        Settings.label = null;\n"
        + "        return Settings.label.length;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    compound();\n"
        + "    return (unchecked() + outsideLambda() + mutableField() + refusedWrite()) as int;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Check 'Settings.label' for "
        + "null first ('if (Settings.label != null)').");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. 'Settings.tally.note' is a field, "
        + "so it can change at any time. A later read of it can be null even after a null check. Copy it "
        + "into a local first ('let note = Settings.tally.note;') and check the local.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, but 'Settings.tally.count' has type 'int?'. "
        + "'Settings.tally.count' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let count = "
        + "Settings.tally.count;'), check the local, and write the result back to 'Settings.tally.count'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Cannot assign to 'Settings.label': a lazy const keeps the value its initializer gives "
        + "it. Change the initializer, or use an instance field.");
    try testing.assertEqual(reported.length, 4L);
}

// Nothing can write a lambda's copy of what it captures, so a check inside the lambda narrows a
// capture wherever the check holds, the way it narrows a local: after a guard that returns, after
// the joins of an 'if' with an 'else' and of a switch, and in a nested lambda.
test "a check inside a lambda narrows what the lambda captures" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "class Label \{\n"
        + "    protected const string? text;\n"
        + "\n"
        + "    protected constructor(this.text = null);\n"
        + "\n"
        + "    protected measure() -> () -> long \{\n"
        + "        return () -> \{\n"
        + "            if (this.text == null) \{ return 0; \}\n"
        + "            return this.text.length;\n"
        + "        \};\n"
        + "    \}\n"
        + "\}\n"
        + "guarded(string? held) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        if (held == null) \{ return 0; \}\n"
        + "        return held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "joined(string? held, bool first) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        if (first) \{\n"
        + "            if (held == null) \{ return 0; \}\n"
        + "        \} else if (held == null) \{\n"
        + "            return 1;\n"
        + "        \}\n"
        + "        return held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "switched(string? held, int mode) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        switch (mode) \{\n"
        + "            0 -> \{ if (held == null) \{ return 0; \} \},\n"
        + "            default -> \{ if (held == null) \{ return 1; \} \},\n"
        + "        \}\n"
        + "        return held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "typed(Shape shape) -> () -> int \{\n"
        + "    return () -> \{\n"
        + "        if (!(shape is Circle)) \{ return 0; \}\n"
        + "        return shape.radius;\n"
        + "    \};\n"
        + "\}\n"
        + "nested(string? held) -> () -> () -> long \{\n"
        + "    return () -> () -> \{\n"
        + "        if (held == null) \{ return 0; \}\n"
        + "        return held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "capturedLocal() -> () -> long \{\n"
        + "    string? local = null;\n"
        + "    return () -> \{\n"
        + "        if (local == null) \{ return 0; \}\n"
        + "        return local.length;\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    long total = guarded(null)() + joined(null, true)() + switched(null, 0)()\n"
        + "        + nested(null)()() + capturedLocal()() + new Label().measure()();\n"
        + "    return total as int + typed(new Shape())();\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A lambda copies what it captures where it is created, and nothing writes the copy, so a narrowing
// that holds there holds inside the body: of a parameter, a local and a value its initializer gives,
// by a null check, a type test and at every level of null, on 'this', on a 'const' field of a struct
// it copies, in a lambda nested in it, in a lambda made in a loop or on the right of '&&', in a field
// default, and in a lambda passed to a generic call. Writing the local after the lambda is created
// changes neither the copy nor its narrowing.
test "a narrowing that holds where a lambda is created holds inside it for what it captures" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "struct Pair \{\n"
        + "    const string? fixed;\n"
        + "\}\n"
        + "class Fields \{\n"
        + "    protected string? name = pick();\n"
        + "    protected () -> long measure = name != null ? () -> name.length : () -> 0;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "run(() -> long body) -> bool \{ return body() > 0; \}\n"
        + "apply<T>(() -> T body) -> T \{ return body(); \}\n"
        + "parameter(string? held) -> () -> long \{\n"
        + "    if (held == null) \{ return () -> 0; \}\n"
        + "    return () -> held.length;\n"
        + "\}\n"
        + "local() -> () -> long \{\n"
        + "    string? found = pick();\n"
        + "    if (found != null) \{\n"
        + "        return () -> \{\n"
        + "            return found.length;\n"
        + "        \};\n"
        + "    \}\n"
        + "    return () -> 0;\n"
        + "\}\n"
        + "initialized() -> () -> int \{\n"
        + "    int? count = 5;\n"
        + "    return () -> count + 1;\n"
        + "\}\n"
        + "tested(Shape shape) -> () -> int \{\n"
        + "    if (shape is Circle) \{ return () -> shape.radius; \}\n"
        + "    return () -> 0;\n"
        + "\}\n"
        + "levels(string?? held) -> () -> long \{\n"
        + "    if (held != null && held != null) \{ return () -> held.length; \}\n"
        + "    return () -> 0;\n"
        + "\}\n"
        + "structField(Pair pair) -> () -> long \{\n"
        + "    if (pair.fixed == null) \{ return () -> 0; \}\n"
        + "    return () -> pair.fixed.length;\n"
        + "\}\n"
        + "nested(string? held) -> () -> () -> long \{\n"
        + "    if (held == null) \{ return () -> () -> 0; \}\n"
        + "    return () -> () -> held.length;\n"
        + "\}\n"
        + "looped(string?[] items) -> long \{\n"
        + "    long total = 0;\n"
        + "    for (let item in items) \{\n"
        + "        if (item != null) \{\n"
        + "            () -> long measure = () -> item.length;\n"
        + "            total = total + measure();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "conjunction(string? held) -> bool \{\n"
        + "    return held != null && run(() -> held.length);\n"
        + "\}\n"
        + "generic(string? held) -> long \{\n"
        + "    if (held == null) \{ return 0; \}\n"
        + "    return apply<long>(() -> held.length);\n"
        + "\}\n"
        + "reassigned() -> long \{\n"
        + "    string? held = pick();\n"
        + "    if (held == null) \{ return 0; \}\n"
        + "    () -> long measure = () -> held.length;\n"
        + "    held = null;\n"
        + "    return measure();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A 'const' field of a class object is read from the object when the lambda runs, and it can change
// until the object's constructor ends, so a narrowing of one outside a lambda does not reach the body.
// The refusal names the first field read from an object, and copying the whole value the lambda reads
// into a local before the lambda, which the lambda then reads instead. Two such operands share one
// sentence.
test "a narrowing of a field of a class object does not reach a lambda" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "class Holder \{\n"
        + "    protected const string? fixed;\n"
        + "    protected const Shape? shape;\n"
        + "    protected const int? low;\n"
        + "    protected const int? high;\n"
        + "\n"
        + "    protected constructor(this.fixed = null, this.shape = null, this.low = null, "
        + "this.high = null);\n"
        + "\n"
        + "    protected fixedLength() -> () -> long \{\n"
        + "        if (this.fixed == null) \{ return () -> 0; \}\n"
        + "        return () -> this.fixed.length;\n"
        + "    \}\n"
        + "\n"
        + "    protected radius() -> () -> int \{\n"
        + "        if (!(this.shape is Circle)) \{ return () -> 0; \}\n"
        + "        return () -> \{\n"
        + "            return this.shape.radius;\n"
        + "        \};\n"
        + "    \}\n"
        + "\n"
        + "    protected sum() -> () -> int \{\n"
        + "        if (this.low == null || this.high == null) \{ return () -> 0; \}\n"
        + "        return () -> \{\n"
        + "            return this.low + this.high;\n"
        + "        \};\n"
        + "    \}\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    const Holder holder;\n"
        + "\}\n"
        + "class Link \{\n"
        + "    protected const Holder target;\n"
        + "\n"
        + "    protected constructor(this.target);\n"
        + "\}\n"
        + "captured(Holder holder) -> () -> long \{\n"
        + "    if (holder.fixed == null) \{ return () -> 0; \}\n"
        + "    return () -> \{\n"
        + "        return holder.fixed.length;\n"
        + "    \};\n"
        + "\}\n"
        + "chained(Link link) -> () -> long \{\n"
        + "    if (link.target.fixed == null) \{ return () -> 0; \}\n"
        + "    return () -> \{\n"
        + "        return link.target.fixed.length;\n"
        + "    \};\n"
        + "\}\n"
        + "throughStruct(Pair pair) -> () -> long \{\n"
        + "    if (pair.holder.fixed == null) \{ return () -> 0; \}\n"
        + "    return () -> \{\n"
        + "        return pair.holder.fixed.length;\n"
        + "    \};\n"
        + "\}\n"
        + "tested(Holder holder) -> () -> int \{\n"
        + "    if (holder.shape is Circle) \{ return () -> holder.shape.radius; \}\n"
        + "    return () -> 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string constructed = "and a 'const' field can still change until its object's constructor ends.";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string inside = "and read the local inside the lambda.";
    try sema_support.assertDiagnostic(reported, 0, file, "{member} The lambda reads 'this.fixed' from "
        + "the object when the lambda runs, {constructed} Copy it into a local before the lambda, as in "
        + "'let fixed = this.fixed;', {inside}");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot read a member of 'Shape?' because it "
        + "may be null here. The lambda reads 'this.shape' from the object when the lambda runs, "
        + "{constructed} Copy it into a local before the lambda, as in 'let shape = this.shape;', {inside}");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but "
        + "'this.low' and 'this.high' both have type 'int?'. The lambda reads 'this.low' and 'this.high' "
        + "from their objects when the lambda runs, {constructed} Copy them into locals before the "
        + "lambda, as in 'let low = this.low; let high = this.high;', and read the locals inside the "
        + "lambda.");
    try sema_support.assertDiagnostic(reported, 3, file, "{member} The lambda reads 'holder.fixed' from "
        + "the object when the lambda runs, {constructed} Copy it into a local before the lambda, as in "
        + "'let fixed = holder.fixed;', {inside}");
    try sema_support.assertDiagnostic(reported, 4, file, "{member} The lambda reads 'link.target' from "
        + "the object when the lambda runs, {constructed} Copy 'link.target.fixed' into a local before the "
        + "lambda, as in 'let fixed = link.target.fixed;', {inside}");
    try sema_support.assertDiagnostic(reported, 5, file, "{member} The lambda reads 'pair.holder.fixed' "
        + "from the object when the lambda runs, {constructed} Copy it into a local before the lambda, as "
        + "in 'let fixed = pair.holder.fixed;', {inside}");
    try sema_support.assertDiagnostic(reported, 6, file, "Cannot read a member of 'Shape?' because it "
        + "may be null here. The lambda reads 'holder.shape' from the object when the lambda runs, "
        + "{constructed} Copy it into a local before the lambda, as in 'let shape = holder.shape;', "
        + "{inside}");
    try testing.assertEqual(reported.length, 7L);
}

// A copy made before the statement that creates the lambda holds no proof that a '?:', a '&&' or a '||'
// in that statement makes, so the fix changes each such test to test the copy, and the fixed code is
// accepted. Where a test proves a part of the place to copy, the copy would read that part before the
// test holds, so no copy is offered.
test "a copy for a lambda moves a test written in the same statement onto the copy" {
    string classes = "class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "class Box \{ protected const string? name = \"box\"; protected constructor(); \}\n"
        + "run(() -> long body) -> long \{ return body(); \}\n";
    let analysis = try sema_support.analyzeOne(classes
        + "class Holder \{\n"
        + "    protected const string? fixed = \"start\";\n"
        + "    protected const Shape? shape = null;\n"
        + "    protected const Box? box = null;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected ternary() -> () -> long \{\n"
        + "        return this.fixed == null ? () -> 0 : () -> this.fixed.length;\n"
        + "    \}\n"
        + "\n"
        + "    protected both() -> bool \{\n"
        + "        return this.fixed != null && run(() -> this.fixed.length) > 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected tested() -> () -> long \{\n"
        + "        return this.shape is Circle ? () -> this.shape.radius : () -> 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected part() -> () -> long \{\n"
        + "        return this.box != null && this.box.name != null ? () -> this.box.name.length : () -> 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string constructed = "and a 'const' field can still change until its object's constructor ends.";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string read = "and read the local inside the lambda.";
    try sema_support.assertDiagnostic(reported, 0, file, "{member} The lambda reads 'this.fixed' from "
        + "the object when the lambda runs, {constructed} Copy it into a local before the lambda, as in "
        + "'let fixed = this.fixed;'. Change the test 'this.fixed == null' to 'fixed == null', {read}");
    try sema_support.assertDiagnostic(reported, 1, file, "{member} The lambda reads 'this.fixed' from "
        + "the object when the lambda runs, {constructed} Copy it into a local before the lambda, as in "
        + "'let fixed = this.fixed;'. Change the test 'this.fixed != null' to 'fixed != null', {read}");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot read a member of 'Shape?' because it "
        + "may be null here. The lambda reads 'this.shape' from the object when the lambda runs, "
        + "{constructed} Copy it into a local before the lambda, as in 'let shape = this.shape;'. Change "
        + "the test 'this.shape is Circle' to 'shape is Circle', {read}");
    try sema_support.assertDiagnostic(reported, 3, file, "Cannot read a member of 'Box?' because it may "
        + "be null here. The lambda reads 'this.box' from the object when the lambda runs, {constructed} "
        + "Supply a fallback for 'this.box' with '??'.");
    try testing.assertEqual(reported.length, 4L);

    let fixed = try sema_support.analyzeOne(classes
        + "class Holder \{\n"
        + "    protected const string? fixed = \"start\";\n"
        + "    protected const Shape? shape = null;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected ternary() -> () -> long \{\n"
        + "        let fixed = this.fixed;\n"
        + "        return fixed == null ? () -> 0 : () -> fixed.length;\n"
        + "    \}\n"
        + "\n"
        + "    protected both() -> bool \{\n"
        + "        let fixed = this.fixed;\n"
        + "        return fixed != null && run(() -> fixed.length) > 0;\n"
        + "    \}\n"
        + "\n"
        + "    protected tested() -> () -> long \{\n"
        + "        let shape = this.shape;\n"
        + "        return shape is Circle ? () -> shape.radius : () -> 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(fixed.bodyDiagnostics().length, 0L);
}

// Where the lambda reads a chain of 'const' fields of objects that proofs made where it is created
// cover, the copy takes the whole chain, so the lambda reads nothing from an object afterwards.
test "a chain of fields of class objects is copied whole before a lambda" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    protected const string? fixed;\n"
        + "    protected const Holder? next;\n"
        + "\n"
        + "    protected constructor(this.fixed = null, this.next = null);\n"
        + "\}\n"
        + "chain(Holder holder) -> () -> long \{\n"
        + "    if (holder.next == null || holder.next.fixed == null) \{ return () -> 0; \}\n"
        + "    return () -> \{\n"
        + "        return holder.next.fixed.length;\n"
        + "    \};\n"
        + "\}\n"
        + "copied(Holder holder) -> () -> long \{\n"
        + "    if (holder.next == null || holder.next.fixed == null) \{ return () -> 0; \}\n"
        + "    let fixed = holder.next.fixed;\n"
        + "    return () -> fixed.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Cannot read a member of "
        + "'Holder?' because it may be null here. The lambda reads 'holder.next' from the object when the "
        + "lambda runs, and a 'const' field can still change until its object's constructor ends. Copy "
        + "'holder.next.fixed' into a local before the lambda, as in 'let fixed = holder.next.fixed;', and "
        + "read the local inside the lambda.");
    try testing.assertEqual(reported.length, 1L);
}

// The copy each refusal above writes compiles, and the lambda reads the narrowed local in place of the
// field of the object.
test "a field of a class object copied into a local before a lambda narrows inside it" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "class Holder \{\n"
        + "    protected const string? fixed;\n"
        + "    protected const Shape? shape;\n"
        + "\n"
        + "    protected constructor(this.fixed = null, this.shape = null);\n"
        + "\n"
        + "    protected radius() -> () -> int \{\n"
        + "        if (!(this.shape is Circle)) \{ return () -> 0; \}\n"
        + "        let shape = this.shape;\n"
        + "        return () -> shape.radius;\n"
        + "    \}\n"
        + "\}\n"
        + "class Link \{\n"
        + "    protected const Holder target;\n"
        + "\n"
        + "    protected constructor(this.target);\n"
        + "\}\n"
        + "chained(Link link) -> () -> long \{\n"
        + "    if (link.target.fixed == null) \{ return () -> 0; \}\n"
        + "    let fixed = link.target.fixed;\n"
        + "    return () -> fixed.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A type test inside a lambda that a proof made where the lambda is created already settles is
// refused with that reason. Where it is the whole condition of an 'if', the fix removes the test and
// keeps the body, with the 'else' branch removed too, and anywhere else the refusal stops after the
// reason. A value whose declared type settles the test, and one an earlier test settles outside any
// lambda, keep the plain refusal.
test "a type test settled where a lambda is created is refused with that reason" {
    let analysis = try sema_support.analyzeOne("class Shape \{ protected constructor(); \}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "plain(Shape shape) -> int \{\n"
        + "    if (shape is Circle) \{\n"
        + "        if (shape is Circle) \{ return shape.radius; \}\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "carried(Shape shape, bool flag) -> () -> int \{\n"
        + "    if (!(shape is Circle)) \{ return () -> 0; \}\n"
        + "    return () -> \{\n"
        + "        if ((shape is Circle)) \{ return shape.radius; \}\n"
        + "        if (shape is Circle) \{ return 1; \} else \{ return 2; \}\n"
        + "    \};\n"
        + "\}\n"
        + "joined(Shape shape, bool flag) -> () -> bool \{\n"
        + "    if (!(shape is Circle)) \{ return () -> false; \}\n"
        + "    return () -> flag && shape is Circle;\n"
        + "\}\n"
        + "declared(Circle circle) -> () -> bool \{\n"
        + "    return () -> circle is Circle;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string vacuous = "A value of type 'Circle' is always a 'Circle', so this 'is' test is always true.";
    string carried = "This test is always true: 'shape' is already a 'Circle' here, because "
        + "'shape is Circle' holds where the lambda is created.";
    try sema_support.assertDiagnostic(reported, 0, file, vacuous);
    try sema_support.assertDiagnostic(reported, 1, file, "{carried} Remove this test and keep its body.");
    try sema_support.assertDiagnostic(reported, 2, file, "{carried} Remove this test and its 'else' "
        + "branch, and keep its body.");
    try sema_support.assertDiagnostic(reported, 3, file, carried);
    try sema_support.assertDiagnostic(reported, 4, file, vacuous);
    try testing.assertEqual(reported.length, 5L);
}

// A lambda copies a local where it is created, so a write in a later argument of the same call does
// not narrow the copy, whether the call checks the lambda before that argument or after it, or the
// lambda is a field of a '{...}' argument, and a write in an earlier argument does.
test "a write in a later argument does not narrow what a lambda before it copies" {
    let analysis = try sema_support.analyzeOne("pick() -> string? \{ return null; \}\n"
        + "struct Holder \{ () -> long body; \}\n"
        + "struct Other \{ () -> long body; long extra; \}\n"
        + "run(Holder holder, string? value) -> long \{ return holder.body(); \}\n"
        + "run(Other other, int value) -> long \{ return other.body(); \}\n"
        + "single(Holder holder, string? value) -> long \{ return holder.body(); \}\n"
        + "make(string? text) -> () -> long \{ return () -> 0; \}\n"
        + "consume((() -> long)[] bodies) -> long \{ return 0; \}\n"
        + "consume(long[] values) -> long \{ return 0; \}\n"
        + "apply<T, U>(() -> T body, U value) -> T \{ return body(); \}\n"
        + "overloaded() -> long \{\n"
        + "    string? held = pick();\n"
        + "    return consume([() -> held.length, make(held = \"abc\")]);\n"
        + "\}\n"
        + "explicit() -> long \{\n"
        + "    string? other = pick();\n"
        + "    return apply<long, string?>(() -> other.length, other = \"abc\");\n"
        + "\}\n"
        + "fieldOverloaded() -> long \{\n"
        + "    string? third = pick();\n"
        + "    return run(\{ body: () -> third.length \}, third = \"abc\");\n"
        + "\}\n"
        + "fieldSingle() -> long \{\n"
        + "    string? fourth = pick();\n"
        + "    return single(\{ body: () -> fourth.length \}, fourth = \"abc\");\n"
        + "\}\n"
        + "earlier() -> long \{\n"
        + "    string? first = pick();\n"
        + "    return consume([make(first = \"abc\"), () -> first.length]);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    for (long i = 0; i < 4; i++) {
        string name = ["held", "other", "third", "fourth"][i];
        try sema_support.assertDiagnostic(reported, i, file, "{member} The lambda copies '{name}' when it is "
            + "created. The assignment '{name} = \"abc\"' comes later in the same call. Assign '{name}' before "
            + "the call, for example '{name} = \"abc\";'.");
    }
    try testing.assertEqual(reported.length, 4L);
}

// A narrowing of a capture is a narrowing of the name, so it ends where a local of the lambda takes
// the name, and a local the lambda copies the capture into narrows only by its own checks.
test "a capture's narrowing does not reach a lambda local that hides it or copies it" {
    let analysis = try sema_support.analyzeOne("pick() -> string? \{ return null; \}\n"
        + "hidden(string? held) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        if (held == null) \{ return 0; \}\n"
        + "        if (held.length > 0) \{\n"
        + "            string? held = pick();\n"
        + "            return held.length;\n"
        + "        \}\n"
        + "        return held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "copied(string? held) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        string? copy = held;\n"
        + "        if (copy == null) \{ return 0; \}\n"
        + "        copy = pick();\n"
        + "        return copy.length;\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return (hidden(null)() + copied(null)()) as int;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Check 'held' for null first "
        + "('if (held != null)').");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. 'copy' is assigned a value of "
        + "type 'string?', which can be null. Check 'copy' for null after the assignment "
        + "('if (copy != null)').");
    try testing.assertEqual(reported.length, 2L);
}

// A read refused because a write ended the narrowing that covered it names the write, with a note at
// it: an assignment of a value that can be null, an assignment of 'null', which no check can fix, a
// write of a 'const' field in a constructor, an 'out' argument, and an assignment in a loop, which can
// run before a later pass reaches the read, and before a read after the loop. A check that narrows
// again ends the reason.
test "a read whose narrowing a write ended names the write" {
    let analysis = try sema_support.analyzeOne("external from libc \{\n"
        + "    reset(out int? slot) -> int;\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "class Holder \{\n"
        + "    protected const string? fixed = \"start\";\n"
        + "\n"
        + "    protected constructor() \{\n"
        + "        if (this.fixed != null) \{\n"
        + "            this.fixed = pick();\n"
        + "            long size = this.fixed.length;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "assigned() -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    name = pick();\n"
        + "    return name.length;\n"
        + "\}\n"
        + "assignedNull() -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    name = null;\n"
        + "    return name.length;\n"
        + "\}\n"
        + "passedOut() -> int \{\n"
        + "    int? count = 3;\n"
        + "    let ignored = reset(out count);\n"
        + "    return count;\n"
        + "\}\n"
        + "looped() -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    long total = 0;\n"
        + "    while (total < 9) \{\n"
        + "        total = total + name.length;\n"
        + "        name = pick();\n"
        + "    \}\n"
        + "    return total + name.length;\n"
        + "\}\n"
        + "checkedAgain() -> long \{\n"
        + "    string? name = pick();\n"
        + "    name = pick();\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    return name.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    try sema_support.assertDiagnostic(reported, 0, file, "{member} 'this.fixed' is assigned a value of "
        + "type 'string?', which can be null. Check 'this.fixed' for null after the assignment "
        + "('if (this.fixed != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[0])).note(),
        "'this.fixed' is assigned here");
    try sema_support.assertDiagnostic(reported, 1, file, "{member} 'name' is assigned a value of type "
        + "'string?', which can be null. Check 'name' for null after the assignment ('if (name != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[1])).note(), "'name' is assigned here");
    try sema_support.assertDiagnostic(reported, 2, file, "{member} 'name' is assigned 'null'.");
    try testing.assertEqual((try sema_support.relatedOf(reported[2])).note(), "'name' is assigned here");
    try sema_support.assertDiagnostic(reported, 3, file, "Function 'passedOut' returns 'int', but this value "
        + "has type 'int?'. The value may be null here. Passing 'out count' lets 'reset' write any value to "
        + "'count'. Check 'count' for null after the call ('if (count != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[3])).note(),
        "'reset' can write 'count' here");
    try sema_support.assertDiagnostic(reported, 4, file, "{member} 'name' is not null when the loop "
        + "starts, but the loop assigns it, so it may be null on a later pass. Check 'name' for null inside "
        + "the loop ('if (name != null)').");
    let write = try sema_support.relatedOf(reported[4]);
    try testing.assertEqual(write.note(), "'name' is assigned here");
    try testing.assertTrue(write.span().start > reported[4].span().start,
        "the note points at the assignment after the read");
    try sema_support.assertDiagnostic(reported, 5, file, "{member} 'name' is assigned a value of type "
        + "'string?', which can be null. Check 'name' for null after the 'while' loop "
        + "('if (name != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[5])).note(), "'name' is assigned here");
    try testing.assertEqual(reported.length, 6L);
}

// A loop that drops a narrowing where it starts still names the write that runs before the read on the
// same pass, in the body or the condition, and the latest write is the one named. A write of 'null' in a
// branch, an arm or a loop the read comes after names where it is, with the check after that statement.
test "a write earlier on the same pass, or in a branch or loop before the read, is named" {
    string source = "pick() -> string? \{ return null; \}\n"
        + "enum Mode \{ Plain, Empty, \}\n"
        + "samePass(bool go) -> long \{\n"
        + "    string? fresh = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        fresh = pick();\n"
        + "        total = total + fresh.length;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "conditionWrite() -> long \{\n"
        + "    string? polled = \"a\";\n"
        + "    long total = 0;\n"
        + "    while ((polled = pick()) == null && total < 2) \{\n"
        + "        total = total + polled.length;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "latest() -> long \{\n"
        + "    string? last = \"a\";\n"
        + "    last = null;\n"
        + "    last = pick();\n"
        + "    return last.length;\n"
        + "\}\n"
        + "joinedNull(bool flag) -> long \{\n"
        + "    string? cleared = \"start\";\n"
        + "    if (flag) \{ cleared = null; \}\n"
        + "    return cleared.length;\n"
        + "\}\n"
        + "breakNull(bool go) -> long \{\n"
        + "    string? stopped = \"a\";\n"
        + "    while (go) \{\n"
        + "        stopped = null;\n"
        + "        if (go) \{ break; \}\n"
        + "        stopped = \"x\";\n"
        + "    \}\n"
        + "    return stopped.length;\n"
        + "\}\n"
        + "innerBreak(bool go) -> long \{\n"
        + "    string? inner = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (total < 3) \{\n"
        + "        total = total + 1;\n"
        + "        for (int i = 0; i < 2; i++) \{\n"
        + "            inner = null;\n"
        + "            break;\n"
        + "        \}\n"
        + "        total = total + inner.length;\n"
        + "        inner = \"y\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "switched(Mode mode) -> long \{\n"
        + "    string? chosen = \"start\";\n"
        + "    switch (mode) \{\n"
        + "        Plain -> \{ chosen = \"plain\"; \},\n"
        + "        Empty -> \{ chosen = null; \},\n"
        + "    \}\n"
        + "    return chosen.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    for (long i = 0; i < 3; i++) {
        string name = ["fresh", "polled", "last"][i];
        try sema_support.assertDiagnostic(reported, i, file, "{member} '{name}' is assigned a value of type "
            + "'string?', which can be null. Check '{name}' for null after the assignment "
            + "('if ({name} != null)').");
        try testing.assertEqual((try sema_support.relatedOf(reported[i])).note(), "'{name}' is assigned here");
    }
    try testing.assertEqual((try sema_support.relatedOf(reported[2])).span().start,
        source.indexOf("last = pick()"));
    try sema_support.assertDiagnostic(reported, 3, file, "{member} 'cleared' is assigned 'null' in one "
        + "branch of the 'if' statement. Check 'cleared' for null after the 'if' statement "
        + "('if (cleared != null)').");
    try sema_support.assertDiagnostic(reported, 4, file, "{member} 'stopped' is assigned 'null' in the "
        + "'while' loop. Check 'stopped' for null after the 'while' loop ('if (stopped != null)').");
    try sema_support.assertDiagnostic(reported, 5, file, "{member} 'inner' is assigned 'null' in the 'for' "
        + "loop. Check 'inner' for null after the 'for' loop ('if (inner != null)').");
    try sema_support.assertDiagnostic(reported, 6, file, "{member} 'chosen' is assigned 'null' in one arm "
        + "of the 'switch'. Check 'chosen' for null after the 'switch' ('if (chosen != null)').");
    for (long i = 3; i < 7; i++) {
        string name = ["cleared", "stopped", "inner", "chosen"][i - 3];
        try testing.assertEqual((try sema_support.relatedOf(reported[i])).note(), "'{name}' is assigned here");
    }
    try testing.assertEqual(reported.length, 7L);
}

// A write in a branch that ends a narrowing is named after the join too, with the check written after
// the statement whose branches meet, since the other branches reach the read as well. A write in the
// statement that reads the value leaves no place for a check, so the refusal stops after the reason. A
// loop that writes the local a field is read through names that write, and a read in the condition of a
// 'while' gets the check written at the start of that condition.
test "a read whose narrowing a write in a branch, a loop or the same statement ended names it" {
    let analysis = try sema_support.analyzeOne("struct Pair \{\n"
        + "    const string? fixed;\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "measure(string? text, long size) -> long \{ return size; \}\n"
        + "joined(bool flag) -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    if (flag) \{ name = pick(); \} else \{ name = pick(); \}\n"
        + "    return name.length;\n"
        + "\}\n"
        + "sameStatement() -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    return measure(name = pick(), name.length);\n"
        + "\}\n"
        + "rootWritten() -> long \{\n"
        + "    Pair pair = \{ fixed: \"start\" \};\n"
        + "    if (pair.fixed == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (total < 9) \{\n"
        + "        total = total + pair.fixed.length;\n"
        + "        pair = \{ fixed: pick() \};\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "condition() -> long \{\n"
        + "    string? name = \"start\";\n"
        + "    long total = 0;\n"
        + "    while (name.length < 5) \{\n"
        + "        name = pick();\n"
        + "        total++;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string nullable = "'name' is assigned a value of type 'string?', which can be null.";
    try sema_support.assertDiagnostic(reported, 0, file, "{member} {nullable} Check 'name' for null after the "
        + "'if' statement ('if (name != null)').");
    try sema_support.assertDiagnostic(reported, 1, file, "{member} {nullable}");
    try sema_support.assertDiagnostic(reported, 2, file, "{member} 'pair.fixed' is not null when the loop "
        + "starts, but the loop assigns 'pair', so 'pair.fixed' may be null on a later pass. Check "
        + "'pair.fixed' for null inside the loop ('if (pair.fixed != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[2])).note(), "'pair' is assigned here");
    try sema_support.assertDiagnostic(reported, 3, file, "{member} 'name' is not null when the loop "
        + "starts, but the loop assigns it, so it may be null on a later pass. Check 'name' for null at "
        + "the start of the condition, as in 'while (name != null && name.length < 5)'.");
    try testing.assertEqual(reported.length, 4L);
}

// What the branches of a statement change is put back for the next branch and joined after the statement,
// however the statements nest: an 'if', a 'switch', a '?:' or a loop inside another statement, a 'try',
// an 'else if' chain, a 'continue' or a 'break', and a lambda. A read that a write in one of them leaves
// without its narrowing names that write.
test "a write in a branch inside other statements ends its narrowing after the outermost one" {
    string source = "class Failure extends Error \{\n"
        + "    protected constructor() \{\n"
        + "        super(\"failed\");\n"
        + "    \}\n"
        + "\}\n"
        + "mayThrow(bool go) throws Failure \{\n"
        + "    if (go) \{\n"
        + "        throw new Failure();\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> string? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "note(string? value) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "run(() -> long body) -> long \{\n"
        + "    return body();\n"
        + "\}\n"
        + "refuseNestedIf(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        if (b) \{\n"
        + "            s = pick();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseNestedElse(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        if (b) \{\n"
        + "            s = \"x\";\n"
        + "        \} else \{\n"
        + "            s = pick();\n"
        + "        \}\n"
        + "    \} else \{\n"
        + "        s = \"y\";\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseSwitchInIf(bool a, int k) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        switch (k) \{\n"
        + "            1 -> \{\n"
        + "                s = pick();\n"
        + "            \},\n"
        + "            default -> \{ \},\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseTernaryInIf(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        long n = b ? note(s = pick()) : 0;\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseLoopInIf(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        while (b) \{\n"
        + "            s = pick();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseForInIf(bool a, long[] items) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        for (let item in items) \{\n"
        + "            if (item > 0) \{\n"
        + "                s = pick();\n"
        + "                break;\n"
        + "            \}\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseTry(bool a) -> long throws Failure \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        s = pick();\n"
        + "        try mayThrow(a);\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseElseIf(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "    \} else if (b) \{\n"
        + "        s = pick();\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseElseIfElse(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "    \} else if (b) \{\n"
        + "    \} else \{\n"
        + "        s = pick();\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseContinue(bool go, bool c) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    long n = 0;\n"
        + "    while (go) \{\n"
        + "        n = n + s.length;\n"
        + "        if (c) \{\n"
        + "            s = pick();\n"
        + "            continue;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return n;\n"
        + "\}\n"
        + "refuseBreak(bool go, bool c) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    while (go) \{\n"
        + "        if (c) \{\n"
        + "            s = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseDeep(bool a, bool b, int k) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    switch (k) \{\n"
        + "        1 -> \{\n"
        + "            if (a) \{\n"
        + "                while (b) \{\n"
        + "                    if (a) \{\n"
        + "                        long n = b ? note(s = pick()) : 0;\n"
        + "                    \}\n"
        + "                \}\n"
        + "            \}\n"
        + "        \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseSwitchArmIf(bool a, int k) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    switch (k) \{\n"
        + "        1 -> \{\n"
        + "            if (a) \{\n"
        + "                s = pick();\n"
        + "            \}\n"
        + "        \},\n"
        + "        default -> \{ \},\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseConditionTernary(bool a, bool c) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if ((c ? (s = pick()) : (s = \"x\")) != null) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseLambdaInBranch(bool a) -> long \{\n"
        + "    string? s = pick();\n"
        + "    () -> long f = () -> 0;\n"
        + "    if (a) \{\n"
        + "        f = () -> s.length;\n"
        + "    \}\n"
        + "    return f();\n"
        + "\}\n"
        + "refuseInLambda(bool a) -> long \{\n"
        + "    () -> long f = () -> \{\n"
        + "        string? s = \"a\";\n"
        + "        if (a) \{\n"
        + "            if (a) \{\n"
        + "                s = pick();\n"
        + "            \}\n"
        + "        \}\n"
        + "        return s.length;\n"
        + "    \};\n"
        + "    return f();\n"
        + "\}\n"
        + "refuseIfInTernaryLambda(bool a) -> long \{\n"
        + "    return a ? run(() -> \{\n"
        + "        string? t = \"b\";\n"
        + "        if (a) \{\n"
        + "            t = pick();\n"
        + "        \}\n"
        + "        return t.length;\n"
        + "    \}) : 0;\n"
        + "\}\n"
        + "refuseNestedLoopBreak(bool a, bool b) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    while (a) \{\n"
        + "        while (b) \{\n"
        + "            if (a) \{\n"
        + "                s = pick();\n"
        + "                break;\n"
        + "            \}\n"
        + "        \}\n"
        + "        if (b) \{\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "refuseForUpdateBranch(bool a) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    long n = 0;\n"
        + "    for (long i = 0; i < 3; i = i + s.length) \{\n"
        + "        if (a) \{\n"
        + "            if (a) \{\n"
        + "                s = pick();\n"
        + "            \}\n"
        + "            continue;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return n;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string ifStatement = "'if' statement";
    string check = "Check 's' for null inside the loop ('if (s != null)').";
    string fallback = "Supply a fallback for 's' with '??'.";
    string[] functions = ["refuseNestedIf(", "refuseNestedElse(", "refuseSwitchInIf(", "refuseTernaryInIf(",
        "refuseLoopInIf(", "refuseForInIf(", "refuseTry(", "refuseElseIf(", "refuseElseIfElse(",
        "refuseContinue(", "refuseBreak(", "refuseDeep(", "refuseSwitchArmIf(", "refuseConditionTernary(",
        "refuseLambdaInBranch(", "refuseInLambda(", "refuseIfInTernaryLambda(", "refuseNestedLoopBreak(",
        "refuseForUpdateBranch("];
    string[] reasons = [assignedAfter("s", ifStatement), assignedAfter("s", ifStatement),
        assignedAfter("s", ifStatement), assignedAfter("s", ifStatement), assignedAfter("s", ifStatement),
        assignedAfter("s", ifStatement), assignedAfter("s", ifStatement), assignedAfter("s", ifStatement),
        assignedAfter("s", ifStatement), assignedInLoop(check), assignedAfter("s", "'while' loop"),
        assignedAfter("s", "'switch'"), assignedAfter("s", "'switch'"), assignedAfter("s", "'?:'"),
        "{nullableRead()} {fallback}", assignedAfter("s", ifStatement), assignedAfter("t", ifStatement),
        assignedAfter("s", "'while' loop"), assignedInLoop(fallback)];
    for (long i = 0; i < functions.length; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", reasons[i]);
        if (functions[i] == "refuseLambdaInBranch(") {
            continue;
        }
        string place = functions[i] == "refuseIfInTernaryLambda(" ? "t" : "s";
        let related = try sema_support.relatedOf(reported[i]);
        try testing.assertEqual(related.note(), "'{place}' is assigned here");
        long write = source.indexOf("{place} = pick()", source.indexOf(functions[i]));
        try testing.assertEqual(related.span().start, write);
    }
    try testing.assertEqual(reported.length, 19L);
}

// The refusal of a read of 'place' after the statement 'statement', where a write in it may leave 'place'
// null.
assignedAfter(string place, string statement) -> string {
    return "{nullableRead()} '{place}' is assigned a value of type 'string?', which can be null. Check "
        + "'{place}' for null after the {statement} ('if ({place} != null)').";
}

// The refusal of a read of 's' inside a loop that can assign 's' a value that can be null before a later
// pass, with 'advice' after the reason.
assignedInLoop(string advice) -> string {
    return "{nullableRead()} 's' is not null when the loop starts, but the loop assigns it, so it may be null "
        + "on a later pass. {advice}";
}

// The refusal of a read of a member of a 'string?' that may be null.
nullableRead() -> string {
    return "Cannot read a member of 'string?' because it may be null here.";
}

// A branch that ends the function, or every branch writing a value that is not null, leaves nothing to
// join, a lambda created in a branch reads what holds where it is created, and a 'break' after a check
// that repairs a write leaves the narrowing in place.
test "a write in a branch the join does not reach, or that every branch makes, keeps the narrowing" {
    string source = "pick() -> string? \{\n"
        + "    return null;\n"
        + "\}\n"
        + "acceptBoth(bool a) -> long \{\n"
        + "    string? s = pick();\n"
        + "    if (a) \{\n"
        + "        s = \"x\";\n"
        + "    \} else \{\n"
        + "        s = \"y\";\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "acceptLambda(bool a) -> long \{\n"
        + "    string? s = pick();\n"
        + "    () -> long f = () -> 0;\n"
        + "    if (a) \{\n"
        + "        s = \"x\";\n"
        + "        f = () -> s.length;\n"
        + "    \}\n"
        + "    return f();\n"
        + "\}\n"
        + "acceptReturnBranch(bool a) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    if (a) \{\n"
        + "        s = pick();\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "acceptNestedBoth(bool a, bool b) -> long \{\n"
        + "    string? s = pick();\n"
        + "    if (a) \{\n"
        + "        if (b) \{\n"
        + "            s = \"x\";\n"
        + "        \} else \{\n"
        + "            s = \"y\";\n"
        + "        \}\n"
        + "    \} else \{\n"
        + "        s = \"z\";\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "acceptBreakRepaired(bool go, bool c) -> long \{\n"
        + "    string? s = \"a\";\n"
        + "    while (go) \{\n"
        + "        s = pick();\n"
        + "        if (s == null) \{\n"
        + "            s = \"x\";\n"
        + "        \}\n"
        + "        if (c) \{\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// A write that is refused never runs, so the narrowing it would drop holds after it, and in a loop
// it is not dropped before the body either. Each problem is then reported once, at the write.
test "a refused write keeps the narrowing of the place it names" {
    let analysis = try sema_support.analyzeOne("external from libc \{\n"
        + "    reset(out int? slot) -> int;\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "constant() -> long \{\n"
        + "    const string? fixed = pick();\n"
        + "    if (fixed == null) \{ return 0; \}\n"
        + "    fixed = pick();\n"
        + "    return fixed.length;\n"
        + "\}\n"
        + "constantLoop() -> long \{\n"
        + "    const string? fixed = pick();\n"
        + "    if (fixed == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (total < 4) \{\n"
        + "        total = total + fixed.length;\n"
        + "        fixed = null;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "captured(string? held) -> () -> long \{\n"
        + "    return () -> \{\n"
        + "        if (held == null) \{ return 0; \}\n"
        + "        long total = 0;\n"
        + "        for (int i = 0; i < 2; i++) \{\n"
        + "            total = total + held.length;\n"
        + "            held = pick();\n"
        + "        \}\n"
        + "        return total + held.length;\n"
        + "    \};\n"
        + "\}\n"
        + "constantOut() -> int \{\n"
        + "    const int? slot = 1;\n"
        + "    if (slot == null) \{ return 0; \}\n"
        + "    let ignored = reset(out slot);\n"
        + "    return slot;\n"
        + "\}\n"
        + "capturedOut(int? slot) -> () -> int \{\n"
        + "    return () -> \{\n"
        + "        if (slot == null) \{ return 0; \}\n"
        + "        let ignored = reset(out slot);\n"
        + "        return slot;\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot assign a new value to 'fixed', because "
        + "'fixed' is declared 'const'. Remove 'const' from its declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot assign a new value to 'fixed', because "
        + "'fixed' is declared 'const'. Remove 'const' from its declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot assign a new value to 'held' inside a "
        + "lambda: a lambda works on copies of what it captures, so the 'held' outside it would not "
        + "change. Return the value the lambda computes and store it where the lambda is called, or keep "
        + "the value in a field of an object the lambda uses.");
    try sema_support.assertDiagnostic(reported, 3, file, "Cannot pass 'slot' as 'out', because 'slot' is "
        + "declared 'const'. Remove 'const' from its declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 4, file, "Cannot pass 'slot' as 'out' inside a lambda: a "
        + "lambda works on copies of what it captures, so the 'slot' outside it would not change. Pass a "
        + "local the lambda declares instead, as in 'int? ownSlot = null;', and return the value the "
        + "lambda computes or keep it in a field of an object the lambda uses.");
    try testing.assertEqual(reported.length, 5L);
}

// An assignment narrows a local or a parameter to the class and the levels of null of the value it
// stores, at either level of a nested optional, in a lambda created after it and as the value of the
// assignment, and where branches meet, to the nearest class the branches share. A declaration keeps the
// class it declares, a 'const' field written through 'this' keeps its declared class, and a narrowing
// that can be null names the write that stored the value.
test "an assignment narrows a local or a parameter to the type of the value it stores" {
    string source = "interface Named \{\n"
        + "    name() -> string;\n"
        + "\}\n"
        + "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Polygon extends Shape \{\n"
        + "    protected int sides = 3;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Circle extends Shape implements Named \{\n"
        + "    protected int radius = 1;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    override name() -> string \{ return \"circle\"; \}\n"
        + "\}\n"
        + "class Square extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Triangle extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    const Shape held;\n"
        + "    protected constructor() \{\n"
        + "        this.held = new Circle();\n"
        + "        int r = this.held.radius;\n"
        + "    \}\n"
        + "\}\n"
        + "find() -> Circle? \{ return null; \}\n"
        + "run(() -> int body) -> int \{ return body(); \}\n"
        + "assigned(Shape given, bool flag) -> int \{\n"
        + "    Shape local;\n"
        + "    local = new Circle();\n"
        + "    given = new Circle();\n"
        + "    Shape? present = null;\n"
        + "    present = new Circle();\n"
        + "    Named named;\n"
        + "    named = new Circle();\n"
        + "    Shape?? deep = null;\n"
        + "    deep = find();\n"
        + "    int? inner = deep?.radius;\n"
        + "    int value = (given = new Circle()).radius;\n"
        + "    Shape? joined = null;\n"
        + "    if (flag) \{\n"
        + "        joined = new Square();\n"
        + "    \} else \{\n"
        + "        joined = new Triangle();\n"
        + "    \}\n"
        + "    return local.radius + given.radius + present.radius + named.radius + value\n"
        + "        + joined.sides + run(() -> local.radius);\n"
        + "\}\n"
        + "declared() -> int \{\n"
        + "    Shape kept = new Circle();\n"
        + "    return kept.radius;\n"
        + "\}\n"
        + "nullable() -> int \{\n"
        + "    Shape? found = null;\n"
        + "    found = find();\n"
        + "    return found.radius;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Type 'Shape' has no field or method named "
        + "'radius'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Type 'Shape' has no field or method named "
        + "'radius'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot read a member of 'Circle?' because it may be "
        + "null here. 'found' is assigned a value of type 'Circle?', which can be null. Check 'found' for "
        + "null after the assignment ('if (found != null)').");
    let related = try sema_support.relatedOf(reported[2]);
    try testing.assertEqual(related.note(), "'found' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("found = find()"));
    try testing.assertEqual(reported.length, 3L);
}

// A narrowing made before a loop holds on every pass when each write in the loop stores a value it
// covers, in the condition, the body or the update. A write that stores a value of a wider type that
// a proof still covers widens it to that type, and one that can store any other value drops it where
// the loop starts. A write can store a local whose own narrowing the loop drops, which then
// drops the narrowing of the local it is stored into too.
test "a narrowing made before a loop holds there unless a write in the loop can break it" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected int size = 1;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{ protected int radius = 1; protected constructor(); \}\n"
        + "class Square extends Shape \{ protected constructor(); \}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "widened(Shape? shape) -> long \{\n"
        + "    if (!(shape is Circle)) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        total = total + shape.size + shape.radius;\n"
        + "        shape = new Square();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "kept() -> long \{\n"
        + "    string? name = \"a\";\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 3; i++) \{\n"
        + "        total = total + name.length;\n"
        + "        name = \"b\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "keptByEveryBranch(string? name) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (total < 9) \{\n"
        + "        total = total + name.length;\n"
        + "        if (total > 5) \{ name = \"c\"; \} else \{ name = name + \"d\"; \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "keptByEachItem(string?[] items, string? name) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (let item in items) \{\n"
        + "        total = total + name.length;\n"
        + "        if (item != null) \{ name = item; \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "broken() -> long \{\n"
        + "    string? name = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (total < 9) \{\n"
        + "        total = total + name.length;\n"
        + "        name = pick();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "conditionWrite() -> long \{\n"
        + "    string? text = \"abc\";\n"
        + "    while (text.length > 5 || (text = pick()) == null) \{ \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "chained() -> long \{\n"
        + "    string? first = \"a\";\n"
        + "    string? second = \"b\";\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 3; i++) \{\n"
        + "        total = total + first.length;\n"
        + "        first = second;\n"
        + "        second = pick();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    try sema_support.assertDiagnostic(reported, 0, file, "Type 'Shape' has no field or method named 'radius'. "
        + "'shape' is a 'Circle' when the loop starts, but the loop assigns it a 'Square', so it may be any "
        + "'Shape' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Circle)'.");
    try testing.assertEqual((try sema_support.relatedOf(reported[0])).note(), "'shape' is assigned here");
    string later = "is not null when the loop starts, but the loop assigns it, so it may be null on a later "
        + "pass.";
    try sema_support.assertDiagnostic(reported, 1, file, "{member} 'name' {later} Check 'name' for null "
        + "inside the loop ('if (name != null)').");
    try sema_support.assertDiagnostic(reported, 2, file, "{member} 'text' {later}");
    try sema_support.assertDiagnostic(reported, 3, file, "{member} 'first' {later} Check 'first' for null "
        + "inside the loop ('if (first != null)').");
    try testing.assertEqual(reported.length, 4L);
}

// A write in a loop that stores a value of the class a type test proved before the loop keeps that
// narrowing, whether it builds the value, copies a parameter of that class or copies a local the loop
// keeps narrowed. One that stores a value of another class, in the pass or in one branch of it, keeps the
// nearest class both extend and is named, and one that stores a value that can be null leaves a narrowing
// that can be null, named at that write.
test "a write in a loop that stores the class a type test proved keeps the narrowing" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Polygon extends Shape \{\n"
        + "    protected int sides = 3;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Square extends Polygon \{\n"
        + "    protected int side = 1;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Triangle extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "find() -> Square? \{ return null; \}\n"
        + "kept(bool go, Shape shape, Square other, Shape copied) -> int \{\n"
        + "    if (!(shape is Square) || !(copied is Square)) \{ return 0; \}\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + shape.side + copied.side;\n"
        + "        shape = new Square();\n"
        + "        copied = shape;\n"
        + "        shape = other;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "shared(bool go, Shape shape) -> int \{\n"
        + "    if (!(shape is Square)) \{ return 0; \}\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + shape.sides + shape.side;\n"
        + "        shape = new Triangle();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "branched(bool go, bool flag, Shape shape) -> int \{\n"
        + "    if (!(shape is Square)) \{ return 0; \}\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + shape.side;\n"
        + "        if (flag) \{\n"
        + "            shape = new Square();\n"
        + "        \} else \{\n"
        + "            shape = new Triangle();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "nullable(bool go, Shape? shape) -> int \{\n"
        + "    if (!(shape is Square)) \{ return 0; \}\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + shape.side;\n"
        + "        shape = find();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Type 'Polygon' has no field or method named "
        + "'side'. 'shape' is a 'Square' when the loop starts, but the loop assigns it a 'Triangle', so it "
        + "may be any 'Polygon' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Square)'.");
    let widened = try sema_support.relatedOf(reported[0]);
    try testing.assertEqual(widened.note(), "'shape' is assigned here");
    try testing.assertEqual(widened.span().start, source.indexOf("shape = new Triangle()"));
    try sema_support.assertDiagnostic(reported, 1, file, "Type 'Polygon' has no field or method named "
        + "'side'. 'shape' is a 'Square' when the loop starts, but the loop assigns it a 'Triangle', so it "
        + "may be any 'Polygon' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Square)'.");
    let branched = try sema_support.relatedOf(reported[1]);
    try testing.assertEqual(branched.span().start, source.indexOf("shape = new Triangle()",
        source.indexOf("branched(")));
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot read a member of 'Square?' because it may "
        + "be null here. 'shape' is not null when the loop starts, but the loop assigns it, so it may be null "
        + "on a later pass. Check 'shape' for null inside the loop ('if (shape != null)').");
    let nulled = try sema_support.relatedOf(reported[2]);
    try testing.assertEqual(nulled.note(), "'shape' is assigned here");
    try testing.assertEqual(nulled.span().start, source.indexOf("shape = find()"));
    try testing.assertEqual(reported.length, 3L);
}

// A 'for' update runs after the end of the body and after each 'continue', so it reads what holds at
// all of them: a 'continue' after a write of 'null' leaves the value it reads nullable, and one after a
// write that proves the narrowing again keeps it.
test "a 'for' update reads what holds at the end of the body and at each 'continue'" {
    let analysis = try sema_support.analyzeOne("updated(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    for (long i = 0; i < 3; i = i + held.length) \{\n"
        + "        if (go) \{\n"
        + "            held = null;\n"
        + "            continue;\n"
        + "        \}\n"
        + "        held = \"x\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "kept(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    for (long i = 0; i < 3; i = i + held.length) \{\n"
        + "        if (go) \{\n"
        + "            held = \"y\";\n"
        + "            continue;\n"
        + "        \}\n"
        + "        held = \"x\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Cannot read a member of 'string?' "
        + "because it may be null here. 'held' is assigned 'null' before 'continue', and the update runs after "
        + "each 'continue'. Supply a fallback for 'held' with '??'.");
    try testing.assertEqual((try sema_support.relatedOf(reported[0])).note(), "'held' is assigned here");
    try testing.assertEqual(reported.length, 1L);
}

// A read where no statement can go, such as in a 'for' update, names the write that ended its narrowing
// the way any read does, and the fallback is the fix it takes.
test "a read in a 'for' update names the write that ended its narrowing" {
    string source = "pick() -> string? \{ return null; \}\n"
        + "updated(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    string? other = \"a\";\n"
        + "    long total = 0;\n"
        + "    for (long i = 0; go; i = i + held.length + other.length) \{\n"
        + "        held = pick();\n"
        + "        other = \"b\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Cannot read a member of 'string?' "
        + "because it may be null here. 'held' is assigned a value of type 'string?', which can be null. "
        + "Supply a fallback for 'held' with '??'.");
    let related = try sema_support.relatedOf(reported[0]);
    try testing.assertEqual(related.note(), "'held' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("held = pick()"));
    try testing.assertEqual(reported.length, 1L);
}

// A loop inside a loop is settled with it: a write in the inner loop reaches a narrowing the outer one
// starts with, a write in the outer loop reaches one the inner loop starts with, and a value one loop
// stores can be one whose narrowing the other drops.
test "a loop inside a loop is settled with it" {
    let analysis = try sema_support.analyzeOne("pick() -> string? \{ return null; \}\n"
        + "keptAcross(string? name) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        total = total + name.length;\n"
        + "        for (int j = 0; j < 2; j++) \{\n"
        + "            total = total + name.length;\n"
        + "            name = \"b\";\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "brokenInside(string? outer) -> long \{\n"
        + "    if (outer == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        total = total + outer.length;\n"
        + "        for (int j = 0; j < 2; j++) \{\n"
        + "            outer = pick();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "narrowedInside() -> long \{\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        string? kept = pick();\n"
        + "        string? inner = pick();\n"
        + "        if (kept == null || inner == null) \{ continue; \}\n"
        + "        for (int j = 0; j < 2; j++) \{\n"
        + "            total = total + kept.length + inner.length;\n"
        + "            kept = \"c\";\n"
        + "            inner = pick();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "chainedAcross() -> long \{\n"
        + "    string? first = \"a\";\n"
        + "    string? second = \"b\";\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        for (int j = 0; j < 2; j++) \{\n"
        + "            total = total + first.length;\n"
        + "            first = second;\n"
        + "        \}\n"
        + "        second = pick();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string later = "is not null when the loop starts, but the loop assigns it, so it may be null on a later "
        + "pass.";
    for (long i = 0; i < 3; i++) {
        string name = ["outer", "inner", "first"][i];
        try sema_support.assertDiagnostic(reported, i, file, "{member} '{name}' {later} Check '{name}' for "
            + "null inside the loop ('if ({name} != null)').");
        try testing.assertEqual((try sema_support.relatedOf(reported[i])).note(), "'{name}' is assigned here");
    }
    try testing.assertEqual(reported.length, 3L);
}

// A copy of one local into another in a loop proves what the copied local holds there, so a chain of
// copies keeps every narrowing when the write at its end proves it again, whether a copy is written
// before or after the copy that writes its source. Where that write can store null, every local along
// the chain loses its narrowing, and each read names the copy that stores into that local.
test "a chain of copies in a loop keeps its narrowings, or loses each where its end can store null" {
    string source = "pick() -> string? \{ return null; \}\n"
        + "kept(bool go, string? first, string? second, string? third, string? fourth) -> long \{\n"
        + "    if (first == null || second == null || third == null || fourth == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        while (go) \{\n"
        + "            total = total + first.length + second.length + third.length + fourth.length;\n"
        + "            first = second;\n"
        + "            third = fourth;\n"
        + "            second = third;\n"
        + "            fourth = \"d\";\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "dropped(bool go, string? one, string? two, string? three, string? four) -> long \{\n"
        + "    if (one == null || two == null || three == null || four == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        while (go) \{\n"
        + "            total = total + one.length + two.length + three.length + four.length;\n"
        + "            one = two;\n"
        + "            three = four;\n"
        + "            two = three;\n"
        + "            four = pick();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string[] names = ["one", "two", "three", "four"];
    string[] writes = ["one = two", "two = three", "three = four", "four = pick()"];
    for (long i = 0; i < 4; i++) {
        string name = names[i];
        try sema_support.assertDiagnostic(reported, i, file, "{member} '{name}' is not null when the loop "
            + "starts, but the loop assigns it, so it may be null on a later pass. Check '{name}' for null "
            + "inside the loop ('if ({name} != null)').");
        let related = try sema_support.relatedOf(reported[i]);
        try testing.assertEqual(related.note(), "'{name}' is assigned here");
        try testing.assertEqual(related.span().start, source.indexOf(writes[i]));
    }
    try testing.assertEqual(reported.length, 4L);
}

// Where a pass starts follows from what reaches the ends of the passes before it: the end of the body,
// each 'continue', and a 'for' update, which runs after both. A write followed by a 'break' or a 'return'
// reaches no later pass, a 'continue' does, and after the loop a narrowing holds where the condition is
// tested false and at each 'break', so a write that proves it again keeps it there too.
test "what reaches the back edges of a pass decides where the next pass starts" {
    string source = "pick() -> string? \{ return null; \}\n"
        + "brokenOut(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        if (flag) \{\n"
        + "            held = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "returned(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; go; i++) \{\n"
        + "        total = total + held.length;\n"
        + "        if (flag) \{\n"
        + "            held = pick();\n"
        + "            return total;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "continued(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        if (flag) \{\n"
        + "            held = pick();\n"
        + "            continue;\n"
        + "        \}\n"
        + "        held = \"b\";\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "keptAfter(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    string? counted = \"a\";\n"
        + "    for (int i = 0; i < 3; i++) \{\n"
        + "        counted = \"c\";\n"
        + "    \}\n"
        + "    while (go) \{\n"
        + "        held = \"b\";\n"
        + "    \}\n"
        + "    return held.length + counted.length;\n"
        + "\}\n"
        + "keptInner(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        while (go) \{\n"
        + "            held = \"b\";\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "brokenAfter(bool go) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    while (go) \{\n"
        + "        if (go) \{\n"
        + "            held = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return held.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    try sema_support.assertDiagnostic(reported, 0, file, "{member} 'held' is not null when the loop starts, "
        + "but the loop assigns it, so it may be null on a later pass. Check 'held' for null inside the loop "
        + "('if (held != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[0])).span().start,
        source.indexOf("held = pick();\n            continue;"));
    try sema_support.assertDiagnostic(reported, 1, file, "{member} 'held' is assigned a value of type "
        + "'string?', which can be null. Check 'held' for null after the 'while' loop ('if (held != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[1])).span().start,
        source.indexOf("held = pick();\n            break;\n        \}\n    \}\n    return held"));
    try testing.assertEqual(reported.length, 2L);
}

// What a nested loop leaves for the loop around it, and what a loop leaves after it, is decided where each
// way out of it starts from what held where the loop starts: a read names the write that leaves it without
// its narrowing on that way, not a later write in the pass that proves it again, and for a class, the
// write that stores a value of another class.
test "a read after a loop names the write that leaves its narrowing on a way out of the loop" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Square extends Shape \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "nestedContinue(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        while (flag) \{\n"
        + "            if (go) \{\n"
        + "                held = pick();\n"
        + "                continue;\n"
        + "            \}\n"
        + "            held = \"b\";\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "nestedBreak(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        while (flag) \{\n"
        + "            if (go) \{\n"
        + "                held = pick();\n"
        + "                break;\n"
        + "            \}\n"
        + "            held = \"b\";\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "afterBreak(bool go, bool flag) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    while (flag) \{\n"
        + "        if (go) \{\n"
        + "            held = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "        held = \"b\";\n"
        + "    \}\n"
        + "    return held.length;\n"
        + "\}\n"
        + "nestedClass(bool go, bool flag, Shape shape) -> int \{\n"
        + "    shape = new Circle();\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + shape.radius;\n"
        + "        while (flag) \{\n"
        + "            if (go) \{\n"
        + "                shape = new Square();\n"
        + "                continue;\n"
        + "            \}\n"
        + "            shape = new Circle();\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    string[] functions = ["nestedContinue(", "nestedBreak("];
    for (long i = 0; i < 2; i++) {
        try sema_support.assertDiagnostic(reported, i, file, "{member} 'held' is not null when the loop "
            + "starts, but the loop assigns it, so it may be null on a later pass. Check 'held' for null "
            + "inside the loop ('if (held != null)').");
        let related = try sema_support.relatedOf(reported[i]);
        try testing.assertEqual(related.note(), "'held' is assigned here");
        long write = source.indexOf("held = pick()", source.indexOf(functions[i]));
        try testing.assertEqual(related.span().start, write);
    }
    try sema_support.assertDiagnostic(reported, 2, file, "{member} 'held' is assigned a value of type "
        + "'string?', which can be null. Check 'held' for null after the 'while' loop ('if (held != null)').");
    try testing.assertEqual((try sema_support.relatedOf(reported[2])).span().start,
        source.indexOf("held = pick()", source.indexOf("afterBreak(")));
    try sema_support.assertDiagnostic(reported, 3, file, "Type 'Shape' has no field or method named "
        + "'radius'. 'shape' is a 'Circle' when the loop starts, but the loop assigns it a 'Square', so it "
        + "may be any 'Shape' on a later pass. Test 'shape' inside the loop, as in 'if (shape is Circle)'.");
    try testing.assertEqual((try sema_support.relatedOf(reported[3])).span().start,
        source.indexOf("shape = new Square()"));
    try testing.assertEqual(reported.length, 4L);
}

// A proof the condition of a loop makes holds after the loop only where every way out keeps it, the
// condition tested false and each 'break', whether the condition is that of a 'while' or of a 'for', and a
// read after the loop names the write before a 'break' that drops it.
test "a proof a loop condition makes holds after the loop only where each 'break' keeps it" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "name() -> string \{ return \"x\"; \}\n"
        + "circle() -> Circle \{ return new Circle(); \}\n"
        + "whileBreak(bool go, bool c) -> long \{\n"
        + "    string? s = pick();\n"
        + "    while ((s = name()).length > 0 && go) \{\n"
        + "        if (c) \{\n"
        + "            s = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "forBreak(bool go, bool c) -> long \{\n"
        + "    string? s = pick();\n"
        + "    for (long i = 0; (s = name()).length > 0 && go; i++) \{\n"
        + "        if (c) \{\n"
        + "            s = pick();\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "classBreak(Shape other, bool go, bool c) -> int \{\n"
        + "    Shape s = other;\n"
        + "    while ((s = circle()).radius > 0 && go) \{\n"
        + "        if (c) \{\n"
        + "            s = other;\n"
        + "            break;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return s.radius;\n"
        + "\}\n"
        + "keptBreak(bool go, bool c) -> long \{\n"
        + "    string? s = pick();\n"
        + "    while ((s = name()).length > 0 && go) \{\n"
        + "        if (c) \{\n"
        + "            s = \"y\";\n"
        + "            break;\n"
        + "        \}\n"
        + "        s = pick();\n"
        + "    \}\n"
        + "    return s.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string[] loops = ["'while' loop", "'for' loop"];
    string[] functions = ["whileBreak(", "forBreak("];
    for (long i = 0; i < 2; i++) {
        try sema_support.assertDiagnostic(reported, i, file, "Cannot read a member of 'string?' because it "
            + "may be null here. 's' is assigned a value of type 'string?', which can be null. Check 's' for "
            + "null after the {loops[i]} ('if (s != null)').");
        let related = try sema_support.relatedOf(reported[i]);
        try testing.assertEqual(related.note(), "'s' is assigned here");
        try testing.assertEqual(related.span().start, source.indexOf("s = pick();\n            break;",
            source.indexOf(functions[i])));
    }
    try sema_support.assertDiagnostic(reported, 2, file, "Type 'Shape' has no field or method named "
        + "'radius'.");
    long read = source.indexOf("radius;\n", source.indexOf("classBreak("));
    try testing.assertEqual(reported[2].span().start, read);
    try testing.assertEqual(reported.length, 3L);
}

// Where the ways back to the start of a loop widen a narrowing in turn, a read the widest type has no
// member for names the write that widened it last, which stores a type without that member.
test "a read in a loop names the write that widens its narrowing to the type it has" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Polygon extends Shape \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Quad extends Polygon \{\n"
        + "    protected int corners = 4;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Square extends Quad \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Rect extends Quad \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Triangle extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "widened(Shape s, bool go, bool a) -> int \{\n"
        + "    if (!(s is Square)) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    int n = 0;\n"
        + "    while (go) \{\n"
        + "        n = n + s.corners;\n"
        + "        if (a) \{\n"
        + "            s = new Triangle();\n"
        + "            continue;\n"
        + "        \}\n"
        + "        s = new Rect();\n"
        + "    \}\n"
        + "    return n;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Type 'Polygon' has no field or "
        + "method named 'corners'. 's' is a 'Square' when the loop starts, but the loop assigns it a "
        + "'Triangle', so it may be any 'Polygon' on a later pass. Test 's' inside the loop, as in "
        + "'if (s is Square)'.");
    let related = try sema_support.relatedOf(reported[0]);
    try testing.assertEqual(related.note(), "'s' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("s = new Triangle()"));
    try testing.assertEqual(reported.length, 1L);
}

// A read names the write whose value reaches the start of the next pass, not an earlier write of the
// same pass that a later one replaces, whether that write is a copy along a chain that a later write
// leaves without its narrowing, as in 'copied' and 'picked', or a write after a check that repairs an
// earlier one, as in 'repaired'.
test "a read names the write of the pass whose value reaches the start of the next one" {
    string loop = "    string? first = \"a\";\n"
        + "    string? second = \"a\";\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        held = flag ? second : \"z\";\n"
        + "        held = second;\n";
    string source = "pick() -> string? \{ return null; \}\n"
        + "copied(bool go, bool flag) -> long \{\n"
        + loop
        + "        second = first;\n"
        + "        first = pick();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "picked(bool go, bool flag) -> long \{\n"
        + loop
        + "        second = flag ? first : first;\n"
        + "        first = pick();\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "repaired(bool go, string? first, string? second) -> long \{\n"
        + "    string? held = \"a\";\n"
        + "    long total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.length;\n"
        + "        held = first;\n"
        + "        if (held == null) \{\n"
        + "            held = \"x\";\n"
        + "        \}\n"
        + "        held = second;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    long[] writes = [source.indexOf("held = second", source.indexOf("copied(")),
        source.indexOf("held = second", source.indexOf("picked(")), source.indexOf("held = second;\n    \}")];
    for (long i = 0; i < 3; i++) {
        try sema_support.assertDiagnostic(reported, i, file, "Cannot read a member of 'string?' because it "
            + "may be null here. 'held' is not null when the loop starts, but the loop assigns it, so it may "
            + "be null on a later pass. Check 'held' for null inside the loop ('if (held != null)').");
        let related = try sema_support.relatedOf(reported[i]);
        try testing.assertEqual(related.note(), "'held' is assigned here");
        try testing.assertEqual(related.span().start, writes[i]);
    }
    try testing.assertEqual(reported.length, 3L);
}

// A copy whose source a later write widens widens its target on the next pass, and a read names the
// type the copy stores there.
test "a read names what a copy stores where a later write widens what it copies" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected int radius = 1;\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n"
        + "widened(bool go, Shape other) -> int \{\n"
        + "    Shape first = new Circle();\n"
        + "    Shape held = new Circle();\n"
        + "    if (!(first is Circle) || !(held is Circle)) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    int total = 0;\n"
        + "    while (go) \{\n"
        + "        total = total + held.radius;\n"
        + "        held = first;\n"
        + "        first = other;\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Type 'Shape' has no field or "
        + "method named 'radius'. 'held' is a 'Circle' when the loop starts, but the loop assigns it a "
        + "'Shape', so it may be any 'Shape' on a later pass. Test 'held' inside the loop, as in "
        + "'if (held is Circle)'.");
    let related = try sema_support.relatedOf(reported[0]);
    try testing.assertEqual(related.note(), "'held' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("held = first"));
    try testing.assertEqual(reported.length, 1L);
}

// Each pass over a loop declares the locals inside it again, and what a pass learns about one of them
// holds on the next pass, so the passes end. A trial checks no lambda passed to a generic or an
// overloaded call, so the passes never reach a loop inside it, and that loop is settled on its own.
test "a local declared inside a loop settles, and a loop no pass reaches settles on its own" {
    let analysis = try sema_support.analyzeOne("class Node \{\n"
        + "    protected Node? next;\n"
        + "    protected constructor(this.next = null);\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "apply<T>(() -> T body) -> T \{ return body(); \}\n"
        + "keep(() -> long body, long value) -> long \{ return body(); \}\n"
        + "keep(() -> long body, string value) -> long \{ return body(); \}\n"
        + "declaredInside(string? name, Node head) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    while (total < 5) \{\n"
        + "        total = total + name.length;\n"
        + "        name = \"b\";\n"
        + "        string? inner = \"abc\";\n"
        + "        while (total < 10) \{\n"
        + "            inner = pick();\n"
        + "            total = total + 1;\n"
        + "        \}\n"
        + "        Node? cursor = head;\n"
        + "        while (cursor != null) \{\n"
        + "            cursor = cursor.next;\n"
        + "        \}\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "inGenericCall(string? name) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        total = total + name.length;\n"
        + "        name = \"b\";\n"
        + "        total = total + apply<long>(() -> \{\n"
        + "            string? inner = \"abc\";\n"
        + "            long count = 0;\n"
        + "            while (count < 10) \{\n"
        + "                count = count + inner.length;\n"
        + "                inner = pick();\n"
        + "            \}\n"
        + "            return count;\n"
        + "        \});\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "inOverloadedCall(string? name) -> long \{\n"
        + "    if (name == null) \{ return 0; \}\n"
        + "    long total = 0;\n"
        + "    for (int i = 0; i < 2; i++) \{\n"
        + "        total = total + name.length;\n"
        + "        name = \"b\";\n"
        + "        total = total + keep(() -> \{\n"
        + "            string? inner = \"abc\";\n"
        + "            long count = 0;\n"
        + "            for (int j = 0; j < 3; j++) \{\n"
        + "                count = count + inner.length;\n"
        + "                inner = pick();\n"
        + "            \}\n"
        + "            return count;\n"
        + "        \}, 1);\n"
        + "    \}\n"
        + "    return total;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string member = "Cannot read a member of 'string?' because it may be null here.";
    for (long i = 0; i < 2; i++) {
        try sema_support.assertDiagnostic(reported, i, file, "{member} 'inner' is not null when the loop "
            + "starts, but the loop assigns it, so it may be null on a later pass. Check 'inner' for null "
            + "inside the loop ('if (inner != null)').");
        try testing.assertEqual((try sema_support.relatedOf(reported[i])).note(), "'inner' is assigned here");
    }
    try testing.assertEqual(reported.length, 2L);
}

// Where a type test on a refused type holds, a member the value's declared type lacks may belong
// to the refused type, so only that read goes unreported. Every other use of the value, and every
// read on the side where the test fails, is still judged by the declared type.
test "a type test on an unknown type leaves out only the member reads it could explain" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "takesInt(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "measure(Shape shape) -> int \{\n"
        + "    if (shape is Circl) \{\n"
        + "        return shape.radius + takesInt(shape);\n"
        + "    \} else \{\n"
        + "        return shape.nonexistent;\n"
        + "    \}\n"
        + "\}\n"
        + "early(Shape shape) -> int \{\n"
        + "    if (shape is Circl) \{\n"
        + "        return shape.radius;\n"
        + "    \}\n"
        + "    return shape.missing;\n"
        + "\}\n"
        + "negated(Shape shape) -> int \{\n"
        + "    if (!(shape is Circl)) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return shape.radius;\n"
        + "\}\n"
        + "retested(Shape shape) -> bool \{\n"
        + "    if (shape is Circl) \{\n"
        + "        return shape is Shape;\n"
        + "    \}\n"
        + "    return false;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string unknown = "Unknown type 'Circl'. Check the spelling, or import the module that declares it.";
    try testing.assertEqual(reported.length, 8L);
    try sema_support.assertDiagnostic(reported, 0, file, unknown);
    try sema_support.assertDiagnostic(reported, 1, file,
        "Argument 1 of 'takesInt' has type 'Shape', but parameter 'value' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "Type 'Shape' has no field or method named 'nonexistent'.");
    try sema_support.assertDiagnostic(reported, 3, file, unknown);
    try sema_support.assertDiagnostic(reported, 4, file,
        "Type 'Shape' has no field or method named 'missing'.");
    try sema_support.assertDiagnostic(reported, 5, file, unknown);
    try sema_support.assertDiagnostic(reported, 6, file, unknown);
    try sema_support.assertDiagnostic(reported, 7, file,
        "A value of type 'Shape' is always a 'Shape', so this 'is' test is always true.");
}

// A comparison of an 'as?' cast with null narrows nothing, and a read that needs the cast's type
// names the 'is' test to write in the condition as it is written, and a comparison inside a lambda
// names its test for the reads inside the lambda only. A cast kept in a local narrows the local by
// the null check on it.
test "a read after an as? cast compared with null names the is test to write" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    int radius = 1;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "guard(Shape shape) -> int \{\n"
        + "    if ((shape as? Circle) == null) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return shape.radius;\n"
        + "\}\n"
        + "conjunction(Shape shape) -> bool \{\n"
        + "    return (shape as? Circle) != null && shape.radius > 0;\n"
        + "\}\n"
        + "kept(Shape shape) -> int \{\n"
        + "    Circle? circle = shape as? Circle;\n"
        + "    if (circle != null) \{\n"
        + "        return circle.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "inLambda(Shape shape) -> int \{\n"
        + "    if ((shape as? Circle) != null) \{\n"
        + "        () -> void later = () -> \{\n"
        + "            if ((shape as? Circle) == null) \{ return; \}\n"
        + "        \};\n"
        + "        return shape.radius;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string opening = "'shape' is still a 'Shape' here, because comparing an 'as?' cast with null does "
        + "not narrow 'shape'.";
    try testing.assertEqual(reported.length, 3L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "{opening} Write 'if (!(shape is Circle))' to narrow it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "{opening} Write 'shape is Circle && shape.radius > 0' to narrow it.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "{opening} Write 'if (shape is Circle)' to narrow it.");
}

// Each branch of a '?:' starts from what holds before it, so a write in one branch does not end a
// narrowing the other reads, whichever is analyzed first, and after the '?:' a narrowing holds where
// both branches that give a value leave it, as after an 'if' statement.
test "each branch of a '?:' starts from what holds before it, and both meet after it" {
    string source = "class P \{\n"
        + "    protected long x;\n"
        + "    protected constructor(this.x);\n"
        + "\}\n"
        + "pick() -> string? \{ return null; \}\n"
        + "note(string value) -> long \{ return value.length; \}\n"
        + "makeP(string? value) -> P \{ return new P(0); \}\n"
        + "make(string? value) -> (long) -> long \{ return (x) -> x; \}\n"
        + "both(bool up) -> long \{\n"
        + "    string? c;\n"
        + "    long n = up ? note(c = \"x\") : note(c = \"y\");\n"
        + "    return n + c.length;\n"
        + "\}\n"
        + "other(bool up, string? s) -> long \{\n"
        + "    if (s == null) \{ return 0; \}\n"
        + "    P made = up ? makeP(s = pick()) : new P(s.length);\n"
        + "    return made.x;\n"
        + "\}\n"
        + "lambdaFirst(bool up, string? s) -> long \{\n"
        + "    if (s == null) \{ return 0; \}\n"
        + "    (long) -> long add = up ? (x) -> x + s.length : make(s = pick());\n"
        + "    return add(1);\n"
        + "\}\n"
        + "after(bool up, string? s) -> long \{\n"
        + "    if (s == null) \{ return 0; \}\n"
        + "    long n = up ? note(s) : makeP(s = pick()).x;\n"
        + "    return n + s.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "Cannot read a member of 'string?' "
        + "because it may be null here. 's' is assigned a value of type 'string?', which can be null. Check "
        + "'s' for null after the '?:' ('if (s != null)').");
    let related = try sema_support.relatedOf(reported[0]);
    try testing.assertEqual(related.note(), "'s' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("s = pick()).x"));
    try testing.assertEqual(reported.length, 1L);
}

// An 'is' test that the class of an assigned value decides, and the declared type does not, says so and
// points at the assignment. Where branches that assign different classes meet, it names the class they
// share instead. A declaration keeps the class it declares, so a test after one is not decided.
test "an 'is' test an assignment decides names the assignment" {
    string source = "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Disc extends Circle \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Polygon extends Shape \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Square extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Triangle extends Polygon \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "alwaysTrue() -> int \{\n"
        + "    Shape shape;\n"
        + "    shape = new Disc();\n"
        + "    if (shape is Circle) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "alwaysFalse(Shape shape) -> bool \{\n"
        + "    shape = new Square();\n"
        + "    return shape is Circle;\n"
        + "\}\n"
        + "declared() -> bool \{\n"
        + "    Shape shape = new Circle();\n"
        + "    return shape is Circle;\n"
        + "\}\n"
        + "joined(bool flag, Shape shape) -> bool \{\n"
        + "    if (flag) \{\n"
        + "        shape = new Square();\n"
        + "    \} else \{\n"
        + "        shape = new Triangle();\n"
        + "    \}\n"
        + "    return shape is Circle;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n";
    let analysis = try sema_support.analyzeOne(source);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "This test is always true: the value assigned to "
        + "'shape' is a 'Disc', so 'shape' is always a 'Circle' here. Remove this test and keep its body.");
    try testing.assertEqual((try sema_support.relatedOf(reported[0])).span().start,
        source.indexOf("shape = new Disc()"));
    try sema_support.assertDiagnostic(reported, 1, file, "This test is always false: the value assigned to "
        + "'shape' is a 'Square', and 'Circle' does not extend 'Square', so 'shape' is never a 'Circle' here.");
    let related = try sema_support.relatedOf(reported[1]);
    try testing.assertEqual(related.note(), "'shape' is assigned here");
    try testing.assertEqual(related.span().start, source.indexOf("shape = new Square()"));
    try sema_support.assertDiagnostic(reported, 2, file, "This test is always false: 'shape' is a 'Polygon' "
        + "after the 'if' statement, whichever way it runs, and 'Circle' does not extend 'Polygon', so 'shape' "
        + "is never a 'Circle' here.");
    try testing.assertEqual((try sema_support.relatedOf(reported[2])).span().start,
        source.indexOf("shape = new Square()", source.indexOf("joined(")));
    try testing.assertEqual(reported.length, 3L);
}

// A type arm with no binding narrows a switched place inside the arm, and a write to the place
// there narrows it to the type of the value it stores, as anywhere else.
test "a type arm without a binding narrows the switched place inside the arm" {
    let analysis = try sema_support.analyzeOne("sealed abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "final class Circle extends Shape \{\n"
        + "    int radius = 1;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "final class Square extends Shape \{\n"
        + "    int side = 1;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "width(Shape shape) -> int \{\n"
        + "    return switch (shape) \{\n"
        + "        is Circle -> shape.radius,\n"
        + "        is Square -> shape.side,\n"
        + "    \};\n"
        + "\}\n"
        + "rewritten(Shape shape) -> int \{\n"
        + "    switch (shape) \{\n"
        + "        is Circle -> \{\n"
        + "            shape = new Square();\n"
        + "            return shape.radius;\n"
        + "        \},\n"
        + "        is Square -> \{\n"
        + "            return 0;\n"
        + "        \},\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Type 'Square' has no field or method named 'radius'.");
}
