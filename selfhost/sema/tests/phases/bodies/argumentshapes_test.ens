import @std.testing;
import sema_support;

// A lambda and an array literal pick the overload they fit by what is written, and are typed from the
// parameter of the overload chosen: an array literal's elements adapt to its element type, nested too.
// A literal of class instances fits the array of its first element's type where an overload takes it,
// and otherwise the array type every element fits.
test "an overloaded call picks the overload a lambda or an array literal fits" {
    let analysis = try sema_support.analyzeOne("class Base \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "shelve(Base[] items) -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "shelve(Derived[] items) -> int \{\n"
        + "    return 2;\n"
        + "\}\n"
        + "apply((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "apply(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "sum(float[] values) -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "sum(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "rows(long[][] values) -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "rows(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    float part = 0.5f;\n"
        + "    return apply((x) -> x + 1) + sum([1.5, 2.5]) + sum([part, 3]) + rows([[1], [2, 3]])\n"
        + "        + rows([]) + shelve([new Derived(), new Derived()]) + shelve([new Base(), new Derived()])\n"
        + "        + shelve([new Derived(), new Base()]);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// The name of a method or function fits a function type that one of the declarations it names can be
// called with, so the overload it picks gives the lambda that calls it. A name in an array literal fits
// the element type the same way.
test "a method or function name picks the overload by the parameter counts its declarations take" {
    let analysis = try sema_support.analyzeOne("class Plain \{\n"
        + "    static twice(int value) -> int \{\n"
        + "        return value * 2;\n"
        + "    \}\n"
        + "\n"
        + "    static twice(int value, int times) -> int \{\n"
        + "        return value * times;\n"
        + "    \}\n"
        + "\}\n"
        + "class Counter \{\n"
        + "    constructor();\n"
        + "\n"
        + "    bump(int by) -> int \{\n"
        + "        return by;\n"
        + "    \}\n"
        + "\}\n"
        + "identity<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "over((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "over(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "steps(((int) -> int)[] all) -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "steps(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let counter = new Counter();\n"
        + "    return over(Plain.twice) + over(identity) + over(counter.bump) + steps([Plain.twice]);\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file, "'twice' is a static method of 'Plain', and a "
        + "method's name is not a value. Write a lambda that calls it instead: "
        + "'(value) -> Plain.twice(value)'.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "'identity' is a function, and a function's name "
        + "is not a value. Write a lambda that calls it instead.");
    try sema_support.assertDiagnostic(diagnostics, 2, file, "'bump' is a method of 'Counter', and a method's "
        + "name is not a value. Write a lambda that calls it instead: '(by) -> counter.bump(by)'.");
    try sema_support.assertDiagnostic(diagnostics, 3, file, "'twice' is a static method of 'Plain', and a "
        + "method's name is not a value. Write a lambda that calls it instead: "
        + "'(value) -> Plain.twice(value)'.");
    try testing.assertEqual(diagnostics.length, 4L);
}

// A method read through '?.' names the methods of the type inside the optional, so it is shaped like
// a name; with one overload taking a function, the read is given that parameter's function type.
test "a method read through '?.' is a name argument and takes the function type of its parameter" {
    let analysis = try sema_support.analyzeOne("class Counter \{\n"
        + "    constructor();\n"
        + "\n"
        + "    bump(int by) -> int \{\n"
        + "        return by;\n"
        + "    \}\n"
        + "\}\n"
        + "tie((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "tie((int) -> long step) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "over((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "over(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Counter? maybe = new Counter();\n"
        + "    return tie(maybe?.bump) + over(maybe?.bump);\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file, "'bump' is a method of 'Counter', and a method's "
        + "name is not a value. Declare a lambda that calls it as a local first, and pass the local.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "'bump' is a method of 'Counter', and a method's "
        + "name is not a value. Write a lambda that calls it instead.");
    try testing.assertEqual(diagnostics.length, 2L);
}

// A '?:' or a switch holding a value with no type of its own fits an overload as well as its least
// fitting value does, and is typed from the parameter of the overload chosen. Where none or several
// fit, the refusal says what its values are, and the fix declares the whole value as a local.
test "a '?:' or a switch argument fits an overload as its least fitting value does" {
    let analysis = try sema_support.analyzeOne("struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "struct Size \{\n"
        + "    int x;\n"
        + "\}\n"
        + "over((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "over(string text) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "tie((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "tie((int) -> long step) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "pair((int) -> int step, int value) -> int \{\n"
        + "    return step(value);\n"
        + "\}\n"
        + "pair(string a, string b, string c) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "place(Point point) -> int \{\n"
        + "    return point.x;\n"
        + "\}\n"
        + "place(Size size) -> int \{\n"
        + "    return size.x;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    bool up = true;\n"
        + "    int fits = over(up ? (x) -> x : (x) -> 0) + place(up ? \{x: 1\} : \{x: 2\});\n"
        + "    int none = over(up ? (x, y) -> x : (x, y) -> y) + over(up ? (x) -> x : \"text\");\n"
        + "    int both = tie(up ? (x) -> x + 1 : (x) -> x);\n"
        + "    int counted = pair(switch (fits) \{ 1 -> (x, y) -> x, default -> (x, y) -> y, \}, 2);\n"
        + "    return fits + none + both + counted;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file, "This call matches 'place(Point)' and "
        + "'place(Size)' equally well, so it is not clear which one to call. Declare the '?:' as a local "
        + "first, as in 'Point point = up ? \{x: 1\} : \{x: 2\};', and pass 'point'.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "None of the declared 'over' functions takes a "
        + "'?:' that gives a lambda with two parameters. They are 'over((int) -> int)' and "
        + "'over(string)'. Change the argument to match one of them.");
    try sema_support.assertDiagnostic(diagnostics, 2, file, "None of the declared 'over' functions takes a "
        + "'?:' that gives a lambda with one parameter or a value of type 'string'. They are "
        + "'over((int) -> int)' and 'over(string)'. Change the argument to match one of them.");
    try sema_support.assertDiagnostic(diagnostics, 3, file, "This call matches 'tie((int) -> int)' and "
        + "'tie((int) -> long)' equally well, so it is not clear which one to call. Declare the '?:' as a "
        + "local first, as in '(int) -> int step = up ? (x) -> x + 1 : (x) -> x;', and pass 'step'.");
    try sema_support.assertDiagnostic(diagnostics, 4, file, "Argument 1 of 'pair' is a switch that gives "
        + "a lambda with two parameters, but 'pair((int) -> int, int)', the only 'pair' that takes two "
        + "arguments, takes a '(int) -> int' there, which takes one parameter.");
    try testing.assertEqual(diagnostics.length, 5L);
}

// A '{...}' literal that the parameter the call would pass it to cannot take waits as it does for a
// parameter not known yet, so the refusal of the call is the one report about it.
test "a '\{...\}' argument the only overload taking that many arguments cannot take is refused once" {
    let analysis = try sema_support.analyzeOne("pair((int) -> int step, int value) -> int \{\n"
        + "    return step(value);\n"
        + "\}\n"
        + "pair(string a, string b, string c) -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pair(\{x: 1\}, 2);\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "Argument 1 of 'pair' is a "
        + "'\{...\}' literal, but 'pair((int) -> int, int)', the only 'pair' that takes two arguments, takes "
        + "a '(int) -> int' there, which is not a struct type.");
    try testing.assertEqual(diagnostics.length, 1L);
}
