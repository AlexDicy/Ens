// A call whose type argument would be inferred as 'void' is refused at the argument that would make
// it so, and a call that cannot show a type argument checks its lambdas without a result to name
// the type their bodies give.
import @std.testing;
import sema_support;
import Stage from sema_support;

test "a type argument a call would infer as 'void' is refused at the argument that offers it" {
    let analysis = sema_support.analyzeProgram("class Wrap<T> \{\n"
        + "    T item;\n"
        + "\n"
        + "    constructor(T item) \{\n"
        + "        this.item = item;\n"
        + "    \}\n"
        + "\n"
        + "    static later(() -> T make) -> Wrap<T> \{\n"
        + "        return new Wrap<T>(make());\n"
        + "    \}\n"
        + "\n"
        + "    static of(T item) -> Wrap<T> \{\n"
        + "        return new Wrap<T>(item);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "run<T>(() -> T body) -> T \{\n"
        + "    return body();\n"
        + "\}\n"
        + "\n"
        + "map<T, R>(T value, (T) -> R step) -> R \{\n"
        + "    return step(value);\n"
        + "\}\n"
        + "\n"
        + "nested<T>(() -> () -> T maker) -> T \{\n"
        + "    return maker()();\n"
        + "\}\n"
        + "\n"
        + "same<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "noreturn stop() \{\n"
        + "    panic(\"stopped\");\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "relay((() -> void)? optional, (() -> () -> void) maker, bool flag) \{\n"
        + "    run(optional);\n"
        + "    nested(maker);\n"
        + "    run(maker());\n"
        + "    run(flag ? maker() : maker());\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    () -> void callback = () -> nothing();\n"
        + "    let result = run(callback);\n"
        + "    run(callback, 5);\n"
        + "    run(() -> nothing());\n"
        + "    run(() -> \{\n"
        + "        nothing();\n"
        + "    \});\n"
        + "    run(() -> \{\n"
        + "        return;\n"
        + "    \});\n"
        + "    map(1, (x) -> \{\});\n"
        + "    let kept = same(nothing());\n"
        + "    same(stop());\n"
        + "    run(() -> stop());\n"
        + "    let later = Wrap.later(callback);\n"
        + "    let wrapped = Wrap.of(nothing());\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 15L);
    string usesBody = "but 'run' uses the type of the value 'body' returns as its type argument 'T'.";
    string passValue = "Pass a function that returns a value.";
    string returnValue = "Return a value from the lambda.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'optional' returns no value, {usesBody} {passValue}");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'maker' is a '() -> () -> void', so the type argument 'T' of 'nested' would be 'void'. "
        + "'void' means no value, so it cannot be a type argument.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'maker()' returns a function that returns no value, {usesBody} {passValue}");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'flag ? maker() : maker()' is a function that returns no value, {usesBody} {passValue}");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'callback' returns no value, {usesBody} {passValue}");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "Function 'run' takes one argument, but this call passes two. Remove the extra argument.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "This lambda returns no value, {usesBody} {returnValue}");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "This lambda returns no value, {usesBody} {returnValue}");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "This lambda returns no value, {usesBody} {returnValue}");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "This lambda returns no value, but 'map' uses the type of the value 'step' returns as its "
        + "type argument 'R'. {returnValue}");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'same'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'same' is generic, and this call does not show what its type argument 'T' is. Write it, as "
        + "in 'same<int>(stop())'.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'run' is generic, and this call does not show what its type argument 'T' is. Write it, as "
        + "in 'run<int>(() -> stop())'.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens",
        "'callback' returns no value, but 'later' uses the type of the value 'make' returns as its "
        + "type argument 'T'. {passValue}");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens",
        "'nothing' returns no value, so a call to it cannot be passed to 'of'. Call it as a "
        + "statement of its own, as in 'nothing();'.");
}

test "'void' leaves a type argument open for a later argument to give" {
    try sema_support.assertOnlyProblem("after<T>(() -> T first, T second) -> T \{\n"
        + "    return second;\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    () -> void callback = () -> nothing();\n"
        + "    return after(callback, 1);\n"
        + "\}\n",
        "Argument 1 of 'after' has type '() -> void', but parameter 'first' has type '() -> int'. "
        + "'T' is 'int' in this call, taken from argument 2. To choose it yourself, write "
        + "'after<int>(...)' and change 'int' to the type you want.");
}

// The lambdas are checked in a trial to find the type their bodies give, and that type is the type
// argument, joined across branches as '?:' joins. A body whose own problem leaves it without a type
// reports that problem alone, since the call's type argument follows from it, and a body that gives
// no type at all, such as '[[]]', leaves the call refused.
test "a lambda binds the type argument its body gives, and one whose body gives none is refused" {
    let analysis = sema_support.analyzeProgram("run<T>(() -> T body) -> T \{\n"
        + "    return body();\n"
        + "\}\n"
        + "\n"
        + "map<T, R>(T value, (T) -> R step) -> R \{\n"
        + "    return step(value);\n"
        + "\}\n"
        + "\n"
        + "compute() -> string \{\n"
        + "    return \"computed\";\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    bool flag = true;\n"
        + "    string computed = run(() -> compute());\n"
        + "    int[] wrapped = map(1, (x) -> [x]);\n"
        + "    bool positive = map(1, (int x) -> x > 0);\n"
        + "    string chosen = run(() -> \{\n"
        + "        if (flag) \{\n"
        + "            return compute();\n"
        + "        \}\n"
        + "        return \"other\";\n"
        + "    \});\n"
        + "    int[] joined = run(() -> flag ? [] : [1]);\n"
        + "    run(() -> missing());\n"
        + "    run(() -> [[]]);\n"
        + "    run(() -> run((y) -> y));\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 3L);
    string unshown = "'run' is generic, and this call does not show what its type argument 'T' is.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Undefined function 'missing'. Check the spelling, or import the module that declares it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", unshown);
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", unshown);
}

// The body of a lambda whose own problem leaves the call without a type argument is checked once,
// so that problem is reported once and alone, in a body written as one expression and in a block.
test "a lambda's own problem is reported once and alone where it leaves a type argument open" {
    let analysis = sema_support.analyzeProgram("apply<T>(() -> T body) -> T \{\n"
        + "    return body();\n"
        + "\}\n"
        + "\n"
        + "measured(string? held) -> long \{\n"
        + "    return apply(() -> held.length);\n"
        + "\}\n"
        + "\n"
        + "assigned() -> int \{\n"
        + "    return apply(() -> \{\n"
        + "        int size = \"a\";\n"
        + "        return size;\n"
        + "    \});\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Supply a fallback for 'held' "
        + "with '??'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Variable 'size' has type 'int', but its value has type 'string'. Declare 'size' as a "
        + "'string' instead.");
}

// A lambda checked in a trial leaves the checker as it found it: the trial's lambdas keep no record,
// and the hint for an 'as?' test after the call is the one the code outside the lambda earns. The
// body is then checked for real, so it and the lambda around the call each capture what it reads.
test "a lambda checked in a trial leaves nothing behind for the code around it" {
    let analysis = sema_support.analyzeProgram("class Animal \{\n"
        + "    constructor() \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Dog extends Animal \{\n"
        + "    constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\n"
        + "    bark() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "run<T>(() -> T body) -> T \{\n"
        + "    return body();\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    Animal a = new Dog();\n"
        + "    long base = 1;\n"
        + "    () -> void outer = () -> \{\n"
        + "        run(() -> base);\n"
        + "    \};\n"
        + "    if ((a as? Dog) != null) \{\n"
        + "        run(() -> \{\n"
        + "            if ((a as? Dog) == null) \{\n"
        + "                nothing();\n"
        + "            \}\n"
        + "        \});\n"
        + "        int b = a.bark();\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "This lambda returns no value, but 'run' uses the type of the value 'body' returns as its "
        + "type argument 'T'. Return a value from the lambda.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'a' is still an 'Animal' here, because comparing an 'as?' cast with null does not narrow "
        + "'a'. Write 'if (a is Dog)' to narrow it.");
    let lambdas = sema_support.lambdasOf(analysis, "main");
    try testing.assertEqual(lambdas.length(), 2L);
    for (let lambda in lambdas) {
        try testing.assertEqual(lambda.captures().length, 1L);
    }
}

// Lambdas whose results are one type argument bind it to the type all of those results fit, as the
// branches of '?:' join, and where no type fits them all the call is refused. A lambda checked under a
// type argument that a later lambda widens leaves no choice of overload for its real check.
test "lambda results that a type argument returns are joined into the type argument" {
    string declarations = "class Base \{ protected constructor(); \}\n"
        + "class First extends Base \{ protected constructor() \{ super(); \} \}\n"
        + "class Second extends Base \{ protected constructor() \{ super(); \} \}\n"
        + "struct Count \{ long n; \}\n"
        + "struct Size \{ long n; \}\n"
        + "describe(First value, Count count) -> long \{ return 1; \}\n"
        + "describe(Base value, Size size) -> long \{ return 2; \}\n"
        + "both<A>(() -> A make, (A) -> long use, () -> A other) -> long \{ return use(make()) + use(other()); \}\n";
    let analysis = try sema_support.analyzeOne(declarations
        + "main() -> int \{\n"
        + "    long joined = both(() -> new First(), (value) -> describe(value, \{ n: 1 \}), () -> new Second());\n"
        + "    long apart = both(() -> 1, (value) -> 0, () -> \"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'both' is generic, and this call does not show what its type argument 'A' is.");
    try testing.assertEqual(reported.length, 1L);

    let fixed = try sema_support.analyzeOne(declarations
        + "main() -> int \{\n"
        + "    long joined = both<Base>(() -> new First(), (value) -> describe(value, \{ n: 1 \}), "
        + "() -> new Second());\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(fixed.bodyDiagnostics().length, 0L);
}
