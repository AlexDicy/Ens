import @std.testing;
import sema_support;

// The null check a refusal names for a stable place with two '?'.
checkTwice(string name) -> string {
    return "Check '{name}' for null twice, once for each '?' ('if ({name} != null) \{ if ({name} "
        + "!= null) \{ ... \} \}').";
}

// The advice for the nullable field 'name' of 't', whose null check proves nothing for a later read.
unstableFieldAdvice(string name) -> string {
    return "'t.{name}' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let {name} = t.{name};') and "
        + "check the local.";
}

// unstableFieldAdvice for a field with two '?', whose copy is checked twice.
unstableFieldAdviceTwice(string name) -> string {
    return "'t.{name}' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let {name} = t.{name};') and check "
        + "the local twice, once for each '?' ('if ({name} != null) \{ if ({name} != null) \{ ... \} \}').";
}

// The advice for a nullable result of a call to 'callee', stored in the local 'name'.
storedAdvice(string callee, string name, string call) -> string {
    return "Each call to '{callee}' returns its own result. A later call can return null even after "
        + "a null check on an earlier one. Store the result in a local first ('let {name} = "
        + "{call};') and check the local.";
}

// The sentence that explains why a field 'name' read from the result of 'makeFixed()' can be null.
ofCall(string name) -> string {
    return "'makeFixed().{name}' is a field of the result of a call. Each call to 'makeFixed' returns "
        + "its own result, so a later read of 'makeFixed().{name}' can be null even after a null check.";
}

// The sentence that points two strings at 'compareTo'.
orderedAs(string first, string operator, string second) -> string {
    return "Order strings with 'compareTo', as in '{first}.compareTo({second}) {operator} 0'.";
}

// A nullable string on either side still makes '+' a join.
// The refusal names the null on either side, in the compound form, and at any depth.
test "a join with a nullable local is refused for the null, not for the numbers" {
    let analysis = try sema_support.analyzeOne(
        "join(string? label, bool flag, int? count, string?? deep) \{\n"
        + "    string numbered = label + 1;\n"
        + "    string leading = 1 + label;\n"
        + "    string trailed = label + \"x\";\n"
        + "    string prefixed = \"x\" + label;\n"
        + "    string doubled = label + label;\n"
        + "    string flagged = label + flag;\n"
        + "    label += 1;\n"
        + "    string counted = count + \"x\";\n"
        + "    string nested = deep + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joins = "joins a string only when neither side can be null, got";
    string label = sema_support.checkFirst("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but both sides have type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'+=' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+' joins a string only when neither side can be null, but 'count' has type 'int?'. "
        + "{sema_support.checkFirst("count")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'+' joins a string only when neither side can be null, but 'deep' has type 'string??'. "
        + "{checkTwice("deep")}");
    try testing.assertEqual(reported.length, 9L);
}

// A join refused on a field also names the local copy to check.
test "a join with a nullable field names the null and the local copy" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected string? label = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "join(Tally t, bool flag) \{\n"
        + "    string numbered = t.label + 1;\n"
        + "    string leading = 1 + t.label;\n"
        + "    string trailed = t.label + \"x\";\n"
        + "    string prefixed = \"x\" + t.label;\n"
        + "    string doubled = t.label + t.label;\n"
        + "    string flagged = t.label + flag;\n"
        + "    t.label += 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joins = "joins a string only when neither side can be null, got";
    string advice = unstableFieldAdvice("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but both sides have type 'string?'. "
        + "{advice}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 6, file, "'+=' joins a string only when neither side can "
        + "be null, but 't.label' has type 'string?'. 't.label' is a field, so it can change at any time. "
        + "A later read of it can be null even after a null check. Copy it into a local first ('let label "
        + "= t.label;'), check the local, and write the result back to 't.label'.");
    try testing.assertEqual(reported.length, 7L);
}

// A value with no text form is refused by name beside a nullable string, on either side.
test "a join refused for its type names that type beside a nullable string" {
    let analysis = try sema_support.analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "join(string? label, Shape shape) \{\n"
        + "    string trailed = label + shape;\n"
        + "    string leading = shape + label;\n"
        + "    string nothing = label + null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string allowed = "Only a string, a number or a 'bool' can be added to one.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Cannot add a value of type 'Shape' to a string. {allowed}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Cannot add a string to a value of type 'Shape'. {allowed}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "Cannot add a value of type 'null' to a string. {allowed}");
    try testing.assertEqual(reported.length, 3L);
}

// Every ordering refusal between two strings names 'compareTo' with the operands' own names.
// A nullable local gets its null check first.
// Two nullable sides get one each.
test "ordering strings names 'compareTo' and the null check a nullable local needs" {
    let analysis = try sema_support.analyzeOne("shout(string text) -> string \{\n"
        + "    return text;\n"
        + "\}\n"
        + "order(string? label, string word, string?? deep) \{\n"
        + "    bool plain = word < \"b\";\n"
        + "    bool before = label < word;\n"
        + "    bool after = word >= label;\n"
        + "    bool same = label <= label;\n"
        + "    bool nested = deep > word;\n"
        + "    bool both = label < deep;\n"
        + "    bool called = shout(word) < word;\n"
        + "    bool counted = label < 3;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string label = sema_support.checkFirst("label");
    string literal = orderedAs("word", "<", "\"b\"");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'word' and '\"b\"' both have type 'string'. {literal}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'word' has type 'string'. {label} "
        + "{orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'>=' compares numbers, but 'word' has type 'string' and 'label' has type 'string?'. {label} "
        + "{orderedAs("word", ">=", "label")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<=' compares numbers, but both sides have type 'string?'. {label} "
        + "{orderedAs("label", "<=", "label")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'>' compares numbers, but 'deep' has type 'string??' and 'word' has type 'string'. "
        + "{checkTwice("deep")} {orderedAs("deep", ">", "word")}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'deep' has type 'string??'. {label} "
        + "{checkTwice("deep")} {orderedAs("label", "<", "deep")}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' compares numbers, but 'shout(word)' and 'word' both have type 'string'. "
        + "{orderedAs("shout(word)", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 7, file, "'<' compares numbers, but 'label' has type "
        + "'string?'.");
    try testing.assertEqual(reported.length, 8L);
}

// A nullable field gets its local copy instead of the plain null check.
// The 'compareTo' example then reads the copy.
test "ordering a nullable string field names 'compareTo' and the local copy" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected string? label = \"a\";\n"
        + "    protected string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "order(Tally t, string word) \{\n"
        + "    bool before = t.label < word;\n"
        + "    bool after = word < t.label;\n"
        + "    bool same = t.label <= t.label;\n"
        + "    bool nested = t.deep > word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofLabel = unstableFieldAdvice("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 't.label' has type 'string?' and 'word' has type 'string'. {ofLabel} "
        + "{orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'word' has type 'string' and 't.label' has type 'string?'. {ofLabel} "
        + "{orderedAs("word", "<", "label")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<=' compares numbers, but both sides have type 'string?'. {ofLabel} "
        + "{orderedAs("label", "<=", "label")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'>' compares numbers, but 't.deep' has type 'string??' and 'word' has type 'string'. "
        + "{unstableFieldAdviceTwice("deep")} {orderedAs("deep", ">", "word")}");
    try testing.assertEqual(reported.length, 4L);
}

// Every operator that takes the value once its '?' is removed names the same null check.
test "every operator refused on a nullable local names the null check on that local" {
    let analysis = try sema_support.analyzeOne("pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "all(int? count, int?? twice, bool? flag) \{\n"
        + "    int? held = pick();\n"
        + "    int added = held + 1;\n"
        + "    int doubled = twice + 1;\n"
        + "    bool compared = count < 3;\n"
        + "    int masked = count & 1;\n"
        + "    int shifted = count << 1;\n"
        + "    int moved = 1 << count;\n"
        + "    int negated = -count;\n"
        + "    bool inverted = !flag;\n"
        + "    int flipped = ~count;\n"
        + "    bool both = flag && true;\n"
        + "    twice += 1;\n"
        + "\}\n"
        + "stepped(int? count, int?? twice) \{\n"
        + "    count++;\n"
        + "    --twice;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string count = sema_support.checkFirst("count");
    string twice = checkTwice("twice");
    string numbers = "needs numbers on both sides, got";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'held' has type 'int?'. {sema_support.checkFirst("held")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'twice' has type 'int??'. {twice}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'&' needs integers on both sides, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<<' shifts an integer, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<<' needs an integer shift distance, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "Unary '-' needs a number, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'!' negates a 'bool', but 'flag' has type 'bool?'. {sema_support.checkFirst("flag")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'~' flips the bits of an integer, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'&&' needs a 'bool' on both sides, but 'flag' has type 'bool?'. {sema_support.checkFirst("flag")}");
    try sema_support.assertDiagnostic(reported, 10, file,
        "'+=' needs numbers on both sides, but 'twice' has type 'int??'. {twice}");
    try sema_support.assertDiagnostic(reported, 11, file,
        "'++' works only on numbers, and 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 12, file,
        "'--' works only on numbers, and 'twice' has type 'int??'. {twice}");
    try testing.assertEqual(reported.length, 13L);
}

// A 'const' field read through 'this' or a parameter gets its null check at the place it is read.
test "a 'const' chain gets its null check through 'this' or a parameter" {
    let analysis = try sema_support.analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "    protected const string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected const Fixed fixed = new Fixed();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected order(string word) \{\n"
        + "        bool before = this.fixed.label < word;\n"
        + "        int added = this.fixed.count + 1;\n"
        + "        bool nested = this.fixed.deep < word;\n"
        + "    \}\n"
        + "\}\n"
        + "reach(Fixed fixed) \{\n"
        + "    int added = fixed.count + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'this.fixed.label' has type 'string?' and 'word' has type 'string'. "
        + "{sema_support.checkFirst("this.fixed.label")} {orderedAs("this.fixed.label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'this.fixed.count' has type 'int?'. "
        + "{sema_support.checkFirst("this.fixed.count")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'this.fixed.deep' has type 'string??' and 'word' has type 'string'. "
        + "{checkTwice("this.fixed.deep")} {orderedAs("this.fixed.deep", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' needs numbers on both sides, but 'fixed.count' has type 'int?'. "
        + "{sema_support.checkFirst("fixed.count")}");
    try testing.assertEqual(reported.length, 4L);
}

// A field with two '?' has its copy checked twice.
// A compound form also writes the result back.
test "a nullable field and element are copied into a local, once for each '?'" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected int?? twice = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Tally t, int?[] counts, string?[] labels, int i, string word) \{\n"
        + "    int added = t.twice + 1;\n"
        + "    t.twice += 1;\n"
        + "    t.twice--;\n"
        + "    int element = counts[0] + 1;\n"
        + "    bool ordered = labels[i] < word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string unstable = "'t.twice' is a field, so it can change at any time. A later read of it can "
        + "be null even after a null check. Copy it into a local first ('let twice = t.twice;')";
    string nested = "check the local twice, once for each '?' ('if (twice != null) \{ if (twice != null) "
        + "\{ ... \} \}')";
    string writtenBack = "{unstable}, {nested}, and write the result back to 't.twice'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 't.twice' has type 'int??'. {unstable} and {nested}.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+=' needs numbers on both sides, but 't.twice' has type 'int??'. {writtenBack}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'--' works only on numbers, and 't.twice' has type 'int??'. {writtenBack}");
    try sema_support.assertDiagnostic(reported, 3, file, "'+' needs numbers on both sides, but 'counts[0]' "
        + "has type 'int?'. 'counts[0]' is an array element, so it can change at any time. A later read of "
        + "it can be null even after a null check. Copy it into a local first ('let value = counts[0];') "
        + "and check the local.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<' compares numbers, but 'labels[i]' has type 'string?' and 'word' has type 'string'. "
        + "'labels[i]' is an array element, so it can change at any time. A later read of it can be null "
        + "even after a null check. Copy it into a local first ('let value = labels[i];') and check the "
        + "local. {orderedAs("value", "<", "word")}");
    try testing.assertEqual(reported.length, 5L);
}

// A nullable call result is stored in a local named after the callee.
// A method called on a plain name gives a local named after both.
// The call is spelled in full on one line, whatever its arguments.
test "a nullable call result is stored in a local and checked there" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected lookup() -> string? \{\n"
        + "        return \"a\";\n"
        + "    \}\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "findDeep() -> string?? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "number(int x) -> int? \{\n"
        + "    return x;\n"
        + "\}\n"
        + "calls(Box box, string word, int x) \{\n"
        + "    bool found = find() < word;\n"
        + "    bool deep = findDeep() < word;\n"
        + "    bool looked = box.lookup() < word;\n"
        + "    bool after = word < find();\n"
        + "    string joined = find() + 1;\n"
        + "    int added = number(x) + 1;\n"
        + "    int complex = number(x + 1) + 1;\n"
        + "    int negated = -number(x);\n"
        + "    int spread = number(\n"
        + "        x // the count\n"
        + "    ) + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string find = storedAdvice("find", "findResult", "find()");
    string number = storedAdvice("number", "numberResult", "number(x)");
    string numbers = "'+' needs numbers on both sides, but";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'find()' has type 'string?' and 'word' has type 'string'. {find} "
        + "{orderedAs("findResult", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'findDeep()' has type 'string??' and 'word' has type 'string'. Each "
        + "call to 'findDeep' returns its own result. A later call can return null even after a null "
        + "check on an earlier one. Store the result in a local first ('let findDeepResult = "
        + "findDeep();') and check the local twice, once for each '?' ('if (findDeepResult != null) \{ if "
        + "(findDeepResult != null) \{ ... \} \}'). {orderedAs("findDeepResult", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'box.lookup()' has type 'string?' and 'word' has type 'string'. "
        + "{storedAdvice("lookup", "boxLookup", "box.lookup()")} {orderedAs("boxLookup", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 'word' has type 'string' and 'find()' has type 'string?'. {find} "
        + "{orderedAs("word", "<", "findResult")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but 'find()' has type 'string?'. {find}");
    try sema_support.assertDiagnostic(reported, 5, file, "{numbers} 'number(x)' has type 'int?'. {number}");
    try sema_support.assertDiagnostic(reported, 6, file, "{numbers} 'number(x + 1)' has type 'int?'. "
        + "{storedAdvice("number", "numberResult", "number(x + 1)")}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "Unary '-' needs a number, but 'number(x)' has type 'int?'. {number}");
    try sema_support.assertDiagnostic(reported, 8, file, "{numbers} 'number(x)' has type 'int?'. {number}");
    try testing.assertEqual(reported.length, 9L);
}

// A value that is no place, call or read through '?.' has no name for a local, so its refusal offers
// only the '??' fallback. The 'compareTo' sentence then explains the result instead of spelling it.
test "a nullable value that is no place, call or safe read gets only the '??' fallback" {
    let analysis = try sema_support.analyzeOne("order(string? label, string? other, string word) \{\n"
        + "    bool fallback = (label ?? other) < word;\n"
        + "    int added = (label ?? other) + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'<' compares numbers, but 'label ?? other' has "
        + "type 'string?' and 'word' has type 'string'. Supply a fallback for 'label ?? other' with '??'. "
        + "Order strings with 'compareTo'. Its result is below zero when the string it is called on sorts "
        + "before the argument.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 'label ?? other' has type 'string?'. "
        + "Supply a fallback for 'label ?? other' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

// Two operands with the same form of fix are explained once, and the fix names both.
// Locals that would share a name get 'left' and 'right' names, and a compound form writes back.
test "two operands with the same form of fix are explained once" {
    let analysis = try sema_support.analyzeOne("class Fixed \{\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "    protected string? name = \"a\";\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "seek() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "makeFixed() -> Fixed \{\n"
        + "    return new Fixed();\n"
        + "\}\n"
        + "both(Tally t, Tally u, string?[] labels, int i, int j, string? label, string? other) \{\n"
        + "    bool stable = label < other;\n"
        + "    bool called = find() < find();\n"
        + "    bool calls = find() < seek();\n"
        + "    bool fields = t.title < u.title;\n"
        + "    bool named = t.title < t.name;\n"
        + "    bool elements = labels[i] < labels[j];\n"
        + "    bool mixed = t.title < labels[i];\n"
        + "    t.count += u.count;\n"
        + "    int chained = makeFixed().count + makeFixed().count;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "compares numbers, got 'string?' and 'string?'.";
    string calls = "returns its own result. A later call can return null even after a null check on "
        + "an earlier one.";
    string fields = "so they can change at any time. A later read of them can be null even after a "
        + "null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'label' and 'other' both have type 'string?'. Check 'label' and "
        + "'other' for null first ('if (label != null && other != null)'). "
        + "{orderedAs("label", "<", "other")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but both sides have type 'string?'. Each call to 'find' returns its own "
        + "result. A later call can return null even after a null check on an earlier one. Store both "
        + "results in locals first ('let leftFindResult = find(); let rightFindResult = find();') and "
        + "check the locals. {orderedAs("leftFindResult", "<", "rightFindResult")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'find()' and 'seek()' both have type 'string?'. Each call to 'find' "
        + "and to 'seek' returns its own result. A later call can return null even after a null check on "
        + "an earlier one. Store both results in locals first ('let findResult = find(); let seekResult = "
        + "seek();') and check the locals. {orderedAs("findResult", "<", "seekResult")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 't.title' and 'u.title' both have type 'string?'. 't.title' and "
        + "'u.title' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let leftTitle = t.title; let rightTitle = "
        + "u.title;') and check the locals. {orderedAs("leftTitle", "<", "rightTitle")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<' compares numbers, but 't.title' and 't.name' both have type 'string?'. 't.title' and "
        + "'t.name' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let title = t.title; let name = t.name;') "
        + "and check the locals. {orderedAs("title", "<", "name")}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' compares numbers, but 'labels[i]' and 'labels[j]' both have type 'string?'. 'labels[i]' and "
        + "'labels[j]' are array elements, so they can change at any time. A later read of them can be "
        + "null even after a null check. Copy them into locals first ('let leftValue = labels[i]; let "
        + "rightValue = labels[j];') and check the locals. {orderedAs("leftValue", "<", "rightValue")}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' compares numbers, but 't.title' and 'labels[i]' both have type 'string?'. 't.title' is a "
        + "field and 'labels[i]' is an array element, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let title = t.title; "
        + "let value = labels[i];') and check the locals. {orderedAs("title", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 7, file, "'+=' needs numbers on both sides, but 't.count' "
        + "and 'u.count' both have type 'int?'. 't.count' and 'u.count' are fields, {fields} Copy them "
        + "into locals first ('let leftCount = t.count; let rightCount = u.count;'), check the locals, and "
        + "write the result back to 't.count'.");
    try sema_support.assertDiagnostic(reported, 8, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'makeFixed().count', a field of the result of a call. Each "
        + "call to 'makeFixed' returns its own result, so a later read of 'makeFixed().count' can be null "
        + "even after a null check. Store 'makeFixed().count' from both calls in locals first ('let "
        + "leftCount = makeFixed().count; let rightCount = makeFixed().count;') and check the locals.");
    try testing.assertEqual(reported.length, 9L);
}

// Two operands keep one sentence each when their forms differ or their levels differ.
// The same place on both sides keeps its one sentence, an element with a complex index included.
test "two operands with different forms of fix keep one sentence each" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "apart(Tally t, string?[] labels, int i, string? label, string?? deep) \{\n"
        + "    bool forms = label < find();\n"
        + "    bool levels = label < deep;\n"
        + "    bool complex = labels[i + 1] < labels[i + 1];\n"
        + "    bool same = labels[i] <= labels[i];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "compares numbers, but 'label' and 'find()' both have type 'string?'.";
    string ofElement = "is an array element, so it can change at any time. A later read of it can "
        + "be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'<' {both} {sema_support.checkFirst("label")} "
        + "{storedAdvice("find", "findResult", "find()")} {orderedAs("label", "<", "findResult")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'deep' has type 'string??'. "
        + "{sema_support.checkFirst("label")} {checkTwice("deep")} {orderedAs("label", "<", "deep")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but both sides have type 'string?'. 'labels[i + 1]' {ofElement} Copy it "
        + "into a local first ('let value = labels[i + 1];') and check the local. "
        + "{orderedAs("value", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<=' compares numbers, but both sides have type 'string?'. 'labels[i]' {ofElement} Copy it into a "
        + "local first ('let value = labels[i];') and check the local. {orderedAs("value", "<=", "value")}");
    try testing.assertEqual(reported.length, 4L);
}

// A name a binding in scope already has is numbered from 2 until it is free.
// This is true for a copy, a stored result and a name with a 'left' prefix.
test "a local name that is taken in scope is numbered until it is free" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "taken(Tally t, Tally u, string title, string?[] labels, string value, string value2) \{\n"
        + "    string findResult = \"x\";\n"
        + "    string leftTitle = \"x\";\n"
        + "    bool copied = t.title < title;\n"
        + "    bool stored = find() < title;\n"
        + "    bool element = labels[0] < value;\n"
        + "    bool prefixed = t.title < u.title;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string one = "compares numbers, but 'find()' has type 'string?' and 'title' has type 'string'.";
    string ofTitle = "'t.title' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 't.title' has type 'string?' and 'title' has type 'string'. {ofTitle} "
        + "Copy it into a local first ('let title2 = t.title;') and check the local. "
        + "{orderedAs("title2", "<", "title")}");
    try sema_support.assertDiagnostic(reported, 1, file, "'<' {one} "
        + "{storedAdvice("find", "findResult2", "find()")} {orderedAs("findResult2", "<", "title")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'labels[0]' has type 'string?' and 'value' has type 'string'. "
        + "'labels[0]' is an array element, so it can change at any time. A later read of it can be null "
        + "even after a null check. Copy it into a local first ('let value3 = labels[0];') and check the "
        + "local. {orderedAs("value3", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 't.title' and 'u.title' both have type 'string?'. 't.title' and "
        + "'u.title' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let leftTitle2 = t.title; let rightTitle = "
        + "u.title;') and check the locals. {orderedAs("leftTitle2", "<", "rightTitle")}");
    try testing.assertEqual(reported.length, 4L);
}

// A 'const' chain read from a call's result is stored whole, in a local named after its last field.
// An ordering example puts a receiver made of more than one term in parentheses.
test "a 'const' chain through a call is stored whole in a local" {
    let analysis = try sema_support.analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "    protected const string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "makeFixed() -> Fixed \{\n"
        + "    return new Fixed();\n"
        + "\}\n"
        + "chain(string word, string other) \{\n"
        + "    bool ordered = makeFixed().label < word;\n"
        + "    int added = makeFixed().count + 1;\n"
        + "    bool nested = makeFixed().deep < word;\n"
        + "    bool joined = word + other < word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'makeFixed().label' has type 'string?' and 'word' has type 'string'. "
        + "{ofCall("label")} Store 'makeFixed().label' in a local first ('let label = "
        + "makeFixed().label;') and check the local. {orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'makeFixed().count' has type 'int?'. {ofCall("count")} "
        + "Store 'makeFixed().count' in a local first ('let count = makeFixed().count;') and check the "
        + "local.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'makeFixed().deep' has type 'string??' and 'word' has type 'string'. "
        + "{ofCall("deep")} Store 'makeFixed().deep' in a local first ('let deep = makeFixed().deep;') "
        + "and check the local twice, once for each '?' ('if (deep != null) \{ if (deep != null) \{ ... "
        + "\} \}'). {orderedAs("deep", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 'word + other' and 'word' both have type 'string'. "
        + "{orderedAs("(word + other)", "<", "word")}");
    try testing.assertEqual(reported.length, 4L);
}

// A copy of the step before a 'const' field is checked through that field, since the copy itself is
// never null, at one level and once for each '?'.
// An element with a complex index is named by its whole spelling and pairs like any other.
test "a copy is checked through the rest of the value it contains" {
    let analysis = try sema_support.analyzeOne("class Inner \{\n"
        + "    protected const int?? count = 1;\n"
        + "    protected const string? label = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Inner inner = new Inner();\n"
        + "    protected Inner other = new Inner();\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Holder h, string?[] labels, int i) \{\n"
        + "    int added = h.inner.count + 1;\n"
        + "    bool ordered = h.inner.label < h.other.label;\n"
        + "    bool mixed = h.title < labels[i + 1];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but "
        + "'h.inner.count' has type 'int??'. 'h.inner' is a field, so it can change at any time. A later "
        + "read of 'h.inner.count' can be null even after a null check. Copy it into a local first ('let "
        + "inner = h.inner;') and check 'inner.count' for null twice, once for each '?' ('if (inner.count "
        + "!= null) \{ if (inner.count != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'h.inner.label' and 'h.other.label' both have type 'string?'. "
        + "'h.inner' and 'h.other' are fields, so they can change at any time. A later read of "
        + "'h.inner.label' and 'h.other.label' can be null even after a null check. Copy them into locals "
        + "first ('let inner = h.inner; let other = h.other;') and check 'inner.label' and 'other.label' "
        + "for null. {orderedAs("inner.label", "<", "other.label")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'h.title' and 'labels[i + 1]' both have type 'string?'. 'h.title' is a "
        + "field and 'labels[i + 1]' is an array element, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let title = h.title; "
        + "let value = labels[i + 1];') and check the locals. {orderedAs("title", "<", "value")}");
    try testing.assertEqual(reported.length, 3L);
}

// A local name is free only when nothing in scope has it and the callable declares no local of it.
// A function of the name counts, and so does a local declared later or in a nested block.
test "a local name avoids functions and locals declared later" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "count() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "find() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "names(Holder h) \{\n"
        + "    int hidden = h.count + count();\n"
        + "    int stored = find() + 1;\n"
        + "    int findResult = 2;\n"
        + "    if (true) \{\n"
        + "        int findResult2 = 3;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'h.count' and 'count()' both have type 'int?'. 'h.count' is "
        + "a field, so it can change at any time. A later read of it can be null even after a null check. "
        + "Copy it into a local first ('let count2 = h.count;') and check the local. "
        + "{storedAdvice("count", "countResult", "count()")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'find()' has type 'int?'. "
        + "{storedAdvice("find", "findResult3", "find()")}");
    try testing.assertEqual(reported.length, 2L);
}

// Two operands with the same number of levels share one nested check that names both.
test "two operands with the same number of levels share one nested check" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    protected int?? twice = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pickTwice() -> int?? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "levels(int?? pp, int?? qq, Holder h, Holder g) \{\n"
        + "    int stable = pp + qq;\n"
        + "    int fields = h.twice + g.twice;\n"
        + "    int calls = pickTwice() + pickTwice();\n"
        + "    h.twice += g.twice;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "'+' needs numbers on both sides, got 'int??' and 'int??'.";
    string fields = "'h.twice' and 'g.twice' are fields, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let leftTwice = h.twice; "
        + "let rightTwice = g.twice;')";
    string nested = "twice, once for each '?' ('if (leftTwice != null && rightTwice != null) \{ if "
        + "(leftTwice != null && rightTwice != null) \{ ... \} \}')";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 'pp' and "
        + "'qq' both have type 'int??'. Check 'pp' and 'qq' for null twice, once for each '?' ('if (pp != "
        + "null && qq != null) \{ if (pp != null && qq != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'h.twice' "
        + "and 'g.twice' both have type 'int??'. {fields} and check the locals {nested}.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int??'. Each call to 'pickTwice' returns its own result. A later call can return "
        + "null even after a null check on an earlier one. Store both results in locals first ('let "
        + "leftPickTwiceResult = pickTwice(); let rightPickTwiceResult = pickTwice();') and check the "
        + "locals twice, once for each '?' ('if (leftPickTwiceResult != null && rightPickTwiceResult != "
        + "null) \{ if (leftPickTwiceResult != null && rightPickTwiceResult != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 3, file, "'+=' needs numbers on both sides, but 'h.twice' "
        + "and 'g.twice' both have type 'int??'. {fields}, check the locals {nested}, and write the result "
        + "back to 'h.twice'.");
    try testing.assertEqual(reported.length, 4L);
}

// Two operands spelled alike that make a call can read different places, so each gets its local.
// Without a call, the same spelling on both sides is one place with one sentence.
test "two operands spelled alike that make a call are never one place" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "at() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "make() -> Holder \{\n"
        + "    return new Holder();\n"
        + "\}\n"
        + "calls(int?[] cells) \{\n"
        + "    int indexed = cells[at()] + cells[at()];\n"
        + "    int made = make().count + make().count;\n"
        + "    int same = cells[0] + cells[0];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "'+' needs numbers on both sides, got 'int?' and 'int?'.";
    string once = "so it can change at any time. A later read of it can be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'cells[at()]', an array element, {once} Copy each read into a "
        + "local first ('let leftValue = cells[at()]; let rightValue = cells[at()];') and check the locals.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'make().count', a field, {once} Copy each read into a local "
        + "first ('let leftCount = make().count; let rightCount = make().count;') and check the locals.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. 'cells[0]' is an array element, {once} Copy it into a local first ('let value "
        + "= cells[0];') and check the local.");
    try testing.assertEqual(reported.length, 3L);
}

// A copy that contains more than the value names the value in the check, at one level, and the
// parentheses around its receiver are left out of that name.
test "a one-level copy names the value it checks" {
    let analysis = try sema_support.analyzeOne("class Inner \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Inner inner = new Inner();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Holder h, string w) \{\n"
        + "    bool ordered = h.inner.label < w;\n"
        + "    int added = (h.inner).count + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'h.inner.label' has type 'string?' and 'w' has type 'string'. "
        + "'h.inner' is a field, so it can change at any time. A later read of 'h.inner.label' can be "
        + "null even after a null check. Copy it into a local first ('let inner = h.inner;') and check "
        + "'inner.label' for null. {orderedAs("inner.label", "<", "w")}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'(h.inner).count' has type 'int?'. 'h.inner' is a field, so it can change at any time. A later "
        + "read of 'h.inner.count' can be null even after a null check. Copy it into a local first ('let "
        + "inner = h.inner;') and check 'inner.count' for null.");
    try testing.assertEqual(reported.length, 2L);
}

// A field default and a parameter default have no statement to declare a local in, so a field, an
// element or a call there gets no fix, and the refusal stops after the why.
test "an initializer gets no local to copy or store into" {
    let analysis = try sema_support.analyzeOne("find() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "class Defaults \{\n"
        + "    protected int total = find() + 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "defaulted(int x = find() + 1) -> int \{\n"
        + "    return x;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'+' needs numbers on both sides, but 'find()' has type 'int?'. Supply a fallback for "
        + "'find()' with '??'.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", refused);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", refused);
    try testing.assertEqual(reported.length, 2L);
}

// A lambda written as a single expression has no statement to put a fix in, so the refusal offers
// only the '??' fallback there. A lambda with a block body gets the fix as any callable body does.
test "a lambda written as a single expression gets only the '??' fallback" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "lambdas(Tally t, int? p) \{\n"
        + "    (int) -> int field = (x) -> t.count + x;\n"
        + "    (int) -> int stable = (x) -> p + x;\n"
        + "    (int) -> int block = (x) -> \{\n"
        + "        return t.count + x;\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'+' needs numbers on both sides, but 't.count' has type 'int?'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 't.count' "
        + "has type 'int?'. Supply a fallback for 't.count' with '??'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'p' has "
        + "type 'int?'. Supply a fallback for 'p' with '??'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{refused} {unstableFieldAdvice("count")}");
    try testing.assertEqual(reported.length, 3L);
}

// An element whose index makes a call is written back through a stored index, so the write lands in
// the element the check was made on. A read keeps the plain copy.
test "an element with a call in its index is written back through a stored index" {
    let analysis = try sema_support.analyzeOne("index() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "items(int?[] items) \{\n"
        + "    items[index()] += 1;\n"
        + "    int read = items[index()] + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string element = "'items[index()]' is an array element, so it can change at any time. A later "
        + "read of it can be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+=' needs numbers on both sides, but "
        + "'items[index()]' has type 'int?'. {element} Store the index and the element in locals first "
        + "('let at = index(); let value = items[at];'), check 'value', and write the result back to "
        + "'items[at]'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'items[index()]' has type 'int?'. {element} Copy it into a local first ('let value = "
        + "items[index()];') and check the local.");
    try testing.assertEqual(reported.length, 2L);
}

// A lambda with a block body takes statements even inside a field default, so it gets the fix.
// A lambda written as a single expression there gets none.
test "a block lambda in a field default gets the fix" {
    let analysis = try sema_support.analyzeOne("class Leaf \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Defaults \{\n"
        + "    protected Leaf leaf = new Leaf();\n"
        + "    protected () -> int reader = () -> \{\n"
        + "        return leaf.count + 1;\n"
        + "    \};\n"
        + "    protected () -> int inline = () -> leaf.count + 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but "
        + "'leaf.count' has type 'int?'. 'leaf.count' is a field, so it can change at any time. A later "
        + "read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "leaf.count;') and check the local.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'leaf.count' has type 'int?'. Supply a fallback for 'leaf.count' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

// A write-back through a receiver that makes a call stores the receiver first, so the result is
// written back to the object the check was made on. A struct receiver that makes a call has no
// local that points at the same storage, so its refusal stops after the why.
test "a write-back through a receiver that makes a call stores the receiver first" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int? x;\n"
        + "\}\n"
        + "make() -> Tally \{\n"
        + "    return new Tally();\n"
        + "\}\n"
        + "index() -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "receivers(int?[][] rows, Point[] points) \{\n"
        + "    make().count++;\n"
        + "    make().count += 1;\n"
        + "    rows[index()][0] += 1;\n"
        + "    points[index()].x += 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string field = "'make().count' is a field, so it can change at any time. A later read of it "
        + "can be null even after a null check. Store the result of 'make()' and the field in locals "
        + "first ('let makeResult = make(); let count = makeResult.count;'), check 'count', and write "
        + "the result back to 'makeResult.count'.";
    try sema_support.assertDiagnostic(reported, 0, file, "'++' works only on numbers, and 'make().count' "
        + "has type 'int?'. {field}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+=' needs numbers on both sides, but "
        + "'make().count' has type 'int?'. {field}");
    try sema_support.assertDiagnostic(reported, 2, file, "'+=' needs numbers on both sides, but "
        + "'rows[index()][0]' has type 'int?'. 'rows[index()][0]' is an array element, so it can change at "
        + "any time. A later read of it can be null even after a null check. Store 'rows[index()]' and the "
        + "element in locals first ('let element = rows[index()]; let value = element[0];'), check "
        + "'value', and write the result back to 'element[0]'.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+=' needs numbers on both sides, but 'points[index()].x' has type 'int?'.");
    try testing.assertEqual(reported.length, 4L);
}

// A value read through '?.' or '?[' is null whenever the value in front of the '?' is null. A value
// in front that a null check can narrow gets that check; any other gets the fallback.
test "a value read through '?.' or '?[' names the value in front of the '?'" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    int plain = 0;\n"
        + "    int? count = null;\n"
        + "    Box? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "reads(Box? mb, int[]? ma, Box b) \{\n"
        + "    int first = mb?.plain + 1;\n"
        + "    int element = ma?[0] + 1;\n"
        + "    int nested = mb?.inner?.plain + 1;\n"
        + "    int unstable = b.inner?.plain + 1;\n"
        + "    int nullable = mb?.count + 1;\n"
        + "    int both = mb?.plain + mb?.plain;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string checked = "'mb?.plain' is null whenever 'mb' is null. Check 'mb' for null first "
        + "('if (mb != null)') and write 'mb.plain', or supply a fallback with '??'.";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 'mb?.plain' "
        + "has type 'int?'. {checked}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'ma?[0]' "
        + "has type 'int?'. 'ma?[0]' is null whenever 'ma' is null. Check 'ma' for null first ('if (ma != "
        + "null)') and write 'ma[0]', or supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but "
        + "'mb?.inner?.plain' has type 'int?'. 'mb?.inner?.plain' is null whenever 'mb?.inner' is null. "
        + "Supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'+' needs numbers on both sides, but "
        + "'b.inner?.plain' has type 'int?'. 'b.inner?.plain' is null whenever 'b.inner' is null. Supply a "
        + "fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 4, file, "'+' needs numbers on both sides, but 'mb?.count' "
        + "has type 'int?'. 'mb?.count' is null whenever 'mb' is null. Supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' needs numbers on both sides, but both sides have type 'int?'. {checked}");
    try testing.assertEqual(reported.length, 6L);
}

// '++' and '--' on a nullable number with no fix to give end after the refusal.
test "'++' on a nullable number with no fix ends after the refusal" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    int? f = null;\n"
        + "    Box? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "changes(Box b, int? x) \{\n"
        + "    b.inner?.f++;\n"
        + "    () -> void run = () -> x++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'++' cannot change 'b.inner?.f' through '?.', "
        + "because there is nothing to write to when 'b.inner' is null. Copy 'b.inner' into a local "
        + "first ('let inner = b.inner;') and check the local, as in 'if (inner != null) \{ inner.f++; \}'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot change 'x' inside a lambda: a lambda "
        + "works on copies of what it captures, so the 'x' outside it would not change. Return the value "
        + "the lambda computes and store it where the lambda is called, or keep the value in a field of an "
        + "object the lambda uses.");
    try sema_support.assertDiagnostic(reported, 2, file, "'++' works only on numbers, and 'x' has type "
        + "'int?'.");
    try testing.assertEqual(reported.length, 3L);
}

// A compound write on a field read through 'super' writes the result back to that field.
test "a compound write through 'super' writes the result back" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    int? f = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Derived extends Box \{\n"
        + "    constructor();\n"
        + "\n"
        + "    lift() \{\n"
        + "        super.f += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'+=' needs numbers on both "
        + "sides, but 'super.f' has type 'int?'. 'super.f' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let f = "
        + "super.f;'), check the local, and write the result back to 'super.f'.");
    try testing.assertEqual(reported.length, 1L);
}
