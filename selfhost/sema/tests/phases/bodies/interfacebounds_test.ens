// A value of a type parameter bounded only by interfaces where one of those interfaces is expected:
// every place a value converts refuses it with the reason, the change that gives the place the type
// parameter where one can, and a class of the file to bound the parameter by.
import @std.testing;
import sema_support;

// An interface with a method a call can make with no arguments, one extending it, one beside it, and
// classes implementing them and taking them.
contract() -> string {
    return "interface Named \{\n"
        + "    name() -> string;\n"
        + "\}\n"
        + "interface Ranked extends Named \{\n"
        + "    rank() -> int;\n"
        + "\}\n"
        + "interface Counted \{\n"
        + "    count() -> int;\n"
        + "\}\n"
        + "class Person implements Named \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override name() -> string \{\n"
        + "        return \"person\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Player implements Ranked \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override name() -> string \{\n"
        + "        return \"player\";\n"
        + "    \}\n"
        + "\n"
        + "    override rank() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    Named? named;\n"
        + "\n"
        + "    constructor(Named named) \{\n"
        + "        this.named = named;\n"
        + "    \}\n"
        + "\n"
        + "    set(Named named) \{\n"
        + "        this.named = named;\n"
        + "    \}\n"
        + "\n"
        + "    static make(Named named) -> Holder \{\n"
        + "        return new Holder(named);\n"
        + "    \}\n"
        + "\}\n"
        + "greet(Named named) -> string \{\n"
        + "    return named.name();\n"
        + "\}\n";
}

// The sentences after the refusal of a value of type 'T' bounded by 'Named' where 'Named' is
// expected, with 'fix' offered before the class to bound by.
named(string fix) -> string {
    string offered = "Bound 'T' by a class that implements 'Named', as in '<T: Person>'.";
    if (fix.length > 0) {
        offered = "{fix}, or bound 'T' by a class that implements 'Named', as in '<T: Person>'.";
    }
    return " 'T' can be any type that implements 'Named', including a struct. A value of type "
        + "'Named' must be an object of a class, and a struct value is not one. {offered}";
}

test "each place a value converts names the bound and the change that takes the type parameter" {
    let analysis = try sema_support.analyzeOne(contract()
        + "declared<T: Named>(T value) \{\n"
        + "    Named named = value;\n"
        + "    Named? maybe = value;\n"
        + "\}\n"
        + "assigned<T: Named>(T value, Named named, Holder holder) \{\n"
        + "    named = value;\n"
        + "    holder.named = value;\n"
        + "\}\n"
        + "passed<T: Named>(T value, Holder holder) -> string \{\n"
        + "    holder.set(value);\n"
        + "    let made = Holder.make(value);\n"
        + "    let built = new Holder(value);\n"
        + "    return greet(value);\n"
        + "\}\n"
        + "returned<T: Named>(T value) -> Named \{\n"
        + "    return value;\n"
        + "\}\n"
        + "stored<T: Named>(T value) \{\n"
        + "    Named[] all = [value];\n"
        + "\}\n"
        + "fallback<T: Named>(T value, Named? absent) -> string \{\n"
        + "    Named chosen = absent ?? value;\n"
        + "    return (absent ?? value).name();\n"
        + "\}\n"
        + "made<T: Named>(T value) \{\n"
        + "    () -> Named make = () -> value;\n"
        + "\}\n"
        + "optional<T: Named>(T? value) \{\n"
        + "    Named? maybe = value;\n"
        + "\}\n"
        + "class Box<T: Named> \{\n"
        + "    T item;\n"
        + "    Named? kept;\n"
        + "\n"
        + "    constructor(this.item);\n"
        + "\n"
        + "    take() -> Named \{\n"
        + "        this.kept = this.item;\n"
        + "        return this.item;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(found, 0, file, "Variable 'named' has type 'Named', but its value "
        + "has type 'T'." + named("Declare 'named' as a 'T'"));
    try sema_support.assertDiagnostic(found, 1, file, "Variable 'maybe' has type 'Named?', but its value "
        + "has type 'T'." + named("Declare 'maybe' as a 'T?'"));
    try sema_support.assertDiagnostic(found, 2, file, "'named' has type 'Named', but the value assigned "
        + "to it has type 'T'." + named("Declare 'named' as a 'T'"));
    try sema_support.assertDiagnostic(found, 3, file, "'holder.named' has type 'Named?', but the value "
        + "assigned to it has type 'T'." + named(""));
    try sema_support.assertDiagnostic(found, 4, file, "Argument 1 of 'set' has type 'T', but parameter "
        + "'named' has type 'Named'." + named(""));
    try sema_support.assertDiagnostic(found, 5, file, "Argument 1 of 'make' has type 'T', but parameter "
        + "'named' has type 'Named'." + named(""));
    try sema_support.assertDiagnostic(found, 6, file, "Argument 1 of the constructor of 'Holder' has type "
        + "'T', but parameter 'named' has type 'Named'." + named(""));
    try sema_support.assertDiagnostic(found, 7, file, "Argument 1 of 'greet' has type 'T', but parameter "
        + "'named' has type 'Named'."
        + named("Declare '<T: Named>' after 'greet' and declare parameter 'named' as 'T'"));
    try sema_support.assertDiagnostic(found, 8, file, "Function 'returned' returns 'Named', but this "
        + "value has type 'T'." + named("Change the return type of 'returned' to 'T'"));
    try sema_support.assertDiagnostic(found, 9, file, "Element 1 has type 'T', but the elements of this "
        + "array have type 'Named'." + named(""));
    try sema_support.assertDiagnostic(found, 10, file, "The fallback after '??' has type 'T', but it "
        + "replaces 'absent' when 'absent' is null, so it must have type 'Named'." + named(""));
    try sema_support.assertDiagnostic(found, 11, file, "The fallback after '??' has type 'T', but it "
        + "replaces 'absent' when 'absent' is null, so it must have type 'Named'."
        + named("Call the methods of 'Named' on 'value' directly, as in 'value.name()'"));
    try sema_support.assertDiagnostic(found, 12, file, "This lambda must return 'Named', but its body "
        + "has type 'T'." + named(""));
    try sema_support.assertDiagnostic(found, 13, file, "Variable 'maybe' has type 'Named?', but its value "
        + "has type 'T?'." + named("Declare 'maybe' as a 'T?'"));
    try sema_support.assertDiagnostic(found, 14, file, "'this.kept' has type 'Named?', but the value "
        + "assigned to it has type 'T'." + named("Declare field 'kept' of 'Box' as a 'T?'"));
    try sema_support.assertDiagnostic(found, 15, file, "Method 'take' returns 'Named', but this value "
        + "has type 'T'." + named("Change the return type of 'take' to 'T'"));
    try testing.assertEqual(found.length, 16L);
}

test "a '?:', a switch and a loop variable name the value of the type parameter" {
    let analysis = try sema_support.analyzeOne(contract()
        + "joined<T: Named>(T value, Named other, bool pick, int which) -> string \{\n"
        + "    Named branch = pick ? other : value;\n"
        + "    string called = (pick ? other : value).name();\n"
        + "    return (switch (which) \{\n"
        + "        0 -> other,\n"
        + "        default -> value,\n"
        + "    \}).name();\n"
        + "\}\n"
        + "walked<T: Named>(T[] values) \{\n"
        + "    for (Named each in values) \{\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string call = "Call the methods of 'Named' on 'value' directly, as in 'value.name()'";
    try sema_support.assertDiagnostic(found, 0, file, "The two results of this '?:' are 'Named' and 'T', "
        + "which have no common type." + named(""));
    try sema_support.assertDiagnostic(found, 1, file, "The two results of this '?:' are 'Named' and 'T', "
        + "which have no common type." + named(call));
    try sema_support.assertDiagnostic(found, 2, file, "Switch arms produce 'Named' and 'T', which have no "
        + "common type." + named(call));
    try sema_support.assertDiagnostic(found, 3, file, "Loop variable 'each' has type 'Named', but this "
        + "loop gives it 'T' values." + named("Declare it as 'T each'"));
    try testing.assertEqual(found.length, 4L);
}

test "the class to bound by implements the bound and keeps the other bounds" {
    let analysis = try sema_support.analyzeOne(contract()
        + "class Tally implements Counted \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override count() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "extended<T: Ranked>(T value) \{\n"
        + "    Named named = value;\n"
        + "\}\n"
        + "beside<T: Named + Counted>(T value) \{\n"
        + "    Counted counted = value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Variable 'named' has type 'Named', but its value has type 'T'. 'T' can be any type that "
        + "implements 'Ranked', including a struct. A value of type 'Named' must be an object of a "
        + "class, and a struct value is not one. Declare 'named' as a 'T', or bound 'T' by a class "
        + "that implements 'Ranked', as in '<T: Player>'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Variable 'counted' has type 'Counted', but its value has type 'T'. 'T' can be any type that "
        + "implements 'Named' and 'Counted', including a struct. A value of type 'Counted' must be an "
        + "object of a class, and a struct value is not one. Declare 'counted' as a 'T', or bound 'T' "
        + "by a class that implements 'Counted', as in '<T: Tally + Named>'.");
    try testing.assertEqual(found.length, 2L);
}

// A final, a generic or a less visible class cannot be the bound, no class implements a bound naming
// 'T' for every type argument, a field of another type cannot take 'T', and a value too long to repeat
// gets no call.
test "a fix offers only code that compiles where it is written" {
    let analysis = try sema_support.analyzeOne("interface Sized \{\n"
        + "    fits(int limit) -> bool;\n"
        + "\}\n"
        + "interface Ordered<E> \{\n"
        + "    before(E other) -> bool;\n"
        + "\}\n"
        + "interface Marker \{\n"
        + "    mark() -> int;\n"
        + "\}\n"
        + "final class Box implements Sized \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override fits(int limit) -> bool \{\n"
        + "        return true;\n"
        + "    \}\n"
        + "\}\n"
        + "class Crate<E> implements Marker \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override mark() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Mark implements Marker \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override mark() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\}\n"
        + "export interface Shown \{\n"
        + "    shown() -> string;\n"
        + "\}\n"
        + "class Label implements Shown \{\n"
        + "    constructor();\n"
        + "\n"
        + "    override shown() -> string \{\n"
        + "        return \"label\";\n"
        + "    \}\n"
        + "\}\n"
        + "struct Pair<T: Marker> \{\n"
        + "    Marker first;\n"
        + "\}\n"
        + "sized<T: Sized>(T value) \{\n"
        + "    Sized slot = value;\n"
        + "\}\n"
        + "marked<T: Marker>(T[] values, long index, Marker other, bool pick) -> int \{\n"
        + "    Pair<T> pair = \{first: values[index]\};\n"
        + "    return (pick ? values[index + index + index + index] : other).mark();\n"
        + "\}\n"
        + "export shown<T: Shown>(T value) \{\n"
        + "    Shown slot = value;\n"
        + "\}\n"
        + "compared<T: Ordered<T>>(T value) \{\n"
        + "    Ordered<T> slot = value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(found, 0, file, "Variable 'slot' has type 'Sized', but its value "
        + "has type 'T'. 'T' can be any type that implements 'Sized', including a struct. A value of type "
        + "'Sized' must be an object of a class, and a struct value is not one. Declare 'slot' as a 'T', "
        + "or bound 'T' by a class that implements 'Sized'.");
    string marker = " 'T' can be any type that implements 'Marker', including a struct. A value of type "
        + "'Marker' must be an object of a class, and a struct value is not one. Bound 'T' by a class "
        + "that implements 'Marker', as in '<T: Mark>'.";
    try sema_support.assertDiagnostic(found, 1, file, "Field 'first' has type 'Marker', but its value "
        + "here has type 'T'." + marker);
    try sema_support.assertDiagnostic(found, 2, file, "The two results of this '?:' are 'T' and "
        + "'Marker', which have no common type." + marker);
    try sema_support.assertDiagnostic(found, 3, file, "Variable 'slot' has type 'Shown', but its value "
        + "has type 'T'. 'T' can be any type that implements 'Shown', including a struct. A value of type "
        + "'Shown' must be an object of a class, and a struct value is not one. Declare 'slot' as a 'T', "
        + "or bound 'T' by a class that implements 'Shown'.");
    try sema_support.assertDiagnostic(found, 4, file, "Variable 'slot' has type 'Ordered<T>', but its "
        + "value has type 'T'. 'T' can be any type that implements 'Ordered<T>', including a struct. A "
        + "value of type 'Ordered<T>' must be an object of a class, and a struct value is not one. "
        + "Declare 'slot' as a 'T'.");
    try testing.assertEqual(found.length, 5L);
}

// A class bound converts, so only a parameter bounded by interfaces alone is refused this way; a value
// whose bound is another interface or that has no bound, an array, and a value that may be null where
// no null is taken are refused for other reasons.
test "only a value of a parameter bounded by interfaces where its bound is expected gets the reason" {
    let analysis = try sema_support.analyzeOne(contract()
        + "classBound<T: Person>(T value) \{\n"
        + "    Named named = value;\n"
        + "\}\n"
        + "unrelated<T: Counted>(T value) \{\n"
        + "    Named named = value;\n"
        + "\}\n"
        + "unbounded<T>(T value) \{\n"
        + "    Named named = value;\n"
        + "\}\n"
        + "array<T: Named>(T[] values) \{\n"
        + "    Named[] all = values;\n"
        + "\}\n"
        + "nullable<T: Named>(T? value) \{\n"
        + "    Named named = value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Variable 'named' has type 'Named', but its value has type 'T'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Variable 'named' has type 'Named', but its value has type 'T'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Variable 'all' has type 'Named[]', but its value has type 'T[]'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Variable 'named' has type 'Named', but its value has type 'T?'.");
    try testing.assertEqual(found.length, 4L);
}
