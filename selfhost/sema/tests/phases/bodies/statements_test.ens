// Statement-level rules: return-path analysis, loop placement of break/continue, for-each
// iterables, and throw/rethrow placement.
import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

test "break and continue must be inside a loop" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    break;\n"
        + "    continue;\n"
        + "    for (long i = 0; i < 3; i++) \{\n"
        + "        if (i == 1) \{ continue; \}\n"
        + "        if (i == 2) \{ break; \}\n"
        + "    \}\n"
        + "    while (false) \{ break; \}\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'break' can only be used inside a loop.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'continue' can only be used inside a loop.");
}

test "for-each requires an iterable and a compatible binding" {
    let analysis = try sema_support.analyzeOne("class Opaque \{ constructor(); \}\n"
        + "main() -> int \{\n"
        + "    let box = new Opaque();\n"
        + "    for (let item in box) \{ \}\n"
        + "    let n = 5;\n"
        + "    for (let item in n) \{ \}\n"
        + "    int[] xs = [1, 2, 3];\n"
        + "    for (string s in xs) \{ \}\n"
        + "    for (let x in xs) \{ let y = x + 1; \}\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 3L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'Opaque' cannot be used in 'for (... in ...)', because it does not implement 'Iterable' from "
        + "'@std.collections.iterator'. Declare 'class Opaque implements Iterable<E>' and give it the "
        + "method 'override makeIterator() -> Iterator<E>', where 'E' is the type of its elements.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'for (... in ...)' needs an array or an iterable value, but 'n' has type 'int'. A class or a "
        + "struct is iterable when it implements 'Iterable<T>' from '@std.collections.iterator'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "Loop variable 's' has type 'string', but this loop gives it 'int' values. Declare it as 'int s', "
        + "or with a wider type.");
}

test "a class implementing Iterable<T> and an Iterable<T> value both iterate" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/collections/iterator.ens",
        "export interface Iterator<T> \{\n"
        + "    next() -> T?;\n"
        + "\}\n"
        + "export interface Iterable<T> \{\n"
        + "    makeIterator() -> Iterator<T>;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Iterable from @std.collections.iterator;\n"
        + "import Iterator from @std.collections.iterator;\n"
        + "class CountUp implements Iterator<int> \{\n"
        + "    int current;\n"
        + "    protected constructor(this.current);\n"
        + "    protected override next() -> int? \{\n"
        + "        if (this.current >= 3) \{\n"
        + "            return null;\n"
        + "        \}\n"
        + "        this.current = this.current + 1;\n"
        + "        return this.current;\n"
        + "    \}\n"
        + "\}\n"
        + "class Range implements Iterable<int> \{\n"
        + "    protected constructor();\n"
        + "    protected override makeIterator() -> Iterator<int> \{ return new CountUp(0); \}\n"
        + "\}\n"
        + "sum(Range r) -> int \{\n"
        + "    let total = 0;\n"
        + "    for (let value in r) \{ total = total + value; \}\n"
        + "    return total;\n"
        + "\}\n"
        + "first(Iterable<int> source) -> int \{\n"
        + "    for (int value in source) \{ return value; \}\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{ return sum(new Range()) + first(new Range()); \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "throw takes an Error and rethrow needs a catch clause" {
    let analysis = sema_support.analyzeProgram("class Widget \{ constructor(); \}\n"
        + "class MyError extends Error \{\n"
        + "    constructor() \{ super(\"boom\"); \}\n"
        + "\}\n"
        + "bad() throws \{\n"
        + "    throw new Widget();\n"
        + "\}\n"
        + "alsoBad() \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "good(int x) -> int throws \{\n"
        + "    if (x < 0) \{ throw new MyError(); \}\n"
        + "    return x;\n"
        + "\}\n"
        + "handler() -> int throws Error \{\n"
        + "    return try good(1);\n"
        + "\} catch (Error e) \{\n"
        + "    rethrow;\n"
        + "\}\n"
        + "main() -> int throws Error \{ return try handler(); \}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Cannot throw a value of type 'Widget'. Only an 'Error', or an object of a subclass of 'Error', "
            + "can be thrown.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'rethrow' can only be used inside a 'catch' clause.");
}

test "a thrown type parameter needs a class bound under Error" {
    let bounded = try sema_support.analyzeOne("forward<E: Error>(E error) throws E \{\n"
        + "    throw error;\n"
        + "\}\n"
        + "class Open<E> \{\n"
        + "    protected constructor();\n"
        + "    protected forward<E: Error>(E error) throws E \{\n"
        + "        throw error;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n");
    try sema_support.assertNoDiagnostics(bounded.bodyDiagnostics());
    let unbounded = try sema_support.analyzeOne("drop<T>(T value) throws \{\n"
        + "    throw value;\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n");
    let diagnostics = unbounded.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Cannot throw 'value', because its type 'T' is a type parameter without the bound 'Error'. "
        + "Declare it as '<T: Error>' in 'drop'.");
}

// A condition, an index, a size and a loop value are named where the refusal quotes them, and a
// write to a constant local names the change its declaration needs.
test "a statement refusal names the value, the declaration and the place it is about" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    string name;\n"
        + "    string label;\n"
        + "\n"
        + "    constructor() \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Shape \{\n"
        + "\}\n"
        + "\n"
        + "class Circle extends Shape \{\n"
        + "\}\n"
        + "\n"
        + "class Settings \{\n"
        + "    int value = switch (1) \{\n"
        + "        1 -> \{\n"
        + "            return 3;\n"
        + "        \},\n"
        + "        default -> \{\},\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "nothing() \{\n"
        + "\}\n"
        + "\n"
        + "add(int a, int a) -> int \{\n"
        + "    return a;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    double d = 2.5;\n"
        + "    if (3) \{\n"
        + "    \}\n"
        + "    while (d) \{\n"
        + "    \}\n"
        + "    for (c in 5) \{\n"
        + "    \}\n"
        + "    int[] xs = new int[d];\n"
        + "    int e = xs[d];\n"
        + "    const k = 1;\n"
        + "    k = 2;\n"
        + "    const int j = 1;\n"
        + "    j = 2;\n"
        + "    for (const n in [1, 2]) \{\n"
        + "        n++;\n"
        + "    \}\n"
        + "    Shape s = new Circle();\n"
        + "    switch (s) \{\n"
        + "        is Circle c -> \{\n"
        + "            c = new Circle();\n"
        + "        \},\n"
        + "        default -> \{\},\n"
        + "    \}\n"
        + "    long h = nothing().hash();\n"
        + "    let w = new Holder?();\n"
        + "    let nulls = [null];\n"
        + "    Holder built = \{name: \"a\"\};\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Fields 'name' and 'label' of class 'Holder' cannot be null, and they are not assigned on every "
        + "path through this constructor. Assign them on every path, for example 'this.name = ...;'.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Each arm of a switch used as a value must give a value, as in '1 -> 0,', not run a '\{ \}' block.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'return' can only be used inside the body of a function, a method or a lambda, and this one is "
        + "in the default value of field 'value'. Remove it.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Each arm of a switch used as a value must give a value, as in '1 -> 0,', not run a '\{ \}' block.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "Parameter 'a' is declared twice in 'add'. Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "The condition of this 'if' must be a 'bool', but '3' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "The condition of this 'while' must be a 'bool', but 'd' has type 'double'.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'for (... in ...)' needs an array or an iterable value, but '5' has type 'int'. A class or a "
        + "struct is iterable when it implements 'Iterable<T>' from '@std.collections.iterator'.");
    try sema_support.assertDiagnostic(reported, 8, file,
        "The size of an array must be an integer, but 'd' has type 'double'.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "The index of an array must be an integer, but 'd' has type 'double'.");
    try sema_support.assertDiagnostic(reported, 10, file,
        "Cannot assign a new value to 'k', because 'k' is declared 'const'. Replace 'const' with 'let' in "
        + "its declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 11, file,
        "Cannot assign a new value to 'j', because 'j' is declared 'const'. Remove 'const' from its "
        + "declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 12, file,
        "'++' cannot change 'n', because 'n' is declared 'const'. Replace 'const' with 'let' in its "
        + "declaration if it needs to change.");
    try sema_support.assertDiagnostic(reported, 13, file,
        "Cannot assign a new value to 'c', because 'c' is the value this 'is' arm matched, and it cannot "
        + "change. Copy it into a variable if it needs to change, as in 'let changed = c;'.");
    try sema_support.assertDiagnostic(reported, 14, file,
        "'nothing()' returns no value, so there is nothing to call 'hash' on.");
    try sema_support.assertDiagnostic(reported, 15, file,
        "'new' always produces a value, so its type cannot be nullable. Remove the '?'.");
    try sema_support.assertDiagnostic(reported, 16, file,
        "'null' alone gives the elements of 'nulls' no type. Declare its type, as in 'string?[] nulls = "
        + "[null];'.");
    try sema_support.assertDiagnostic(reported, 17, file,
        "'Holder' is a class, and a '\{...\}' literal builds only a struct. Write 'new Holder()' to "
        + "create one.");
    try testing.assertEqual(reported.length, 18L);
}

test "locals require initializers they can type from" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    let unset = null;\n"
        + "    const int fixed;\n"
        + "    int paired = 1;\n"
        + "    let paired = 2;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'null' alone gives 'unset' no type. Declare its type, as in 'string? unset = null;'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Constant 'fixed' must be given its value where it is declared. Write it after the name, as in "
            + "'const int fixed = ...;'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Variable 'paired' is already declared earlier in this block. Rename one of the two.");
    try testing.assertEqual(reported.length, 3L);
}

// Each refusal names the value, member or type it is about and the change that removes it.
test "a refusal of a declaration, a literal, a member or a type argument names what to write" {
    let analysis = try sema_support.analyzeOne("enum Color \{\n"
        + "    Red,\n"
        + "    Green,\n"
        + "\}\n"
        + "\n"
        + "class Shape \{\n"
        + "\}\n"
        + "\n"
        + "final class Plain \{\n"
        + "\}\n"
        + "\n"
        + "class Mute \{\n"
        + "\}\n"
        + "\n"
        + "class Widget \{\n"
        + "    int size = 0;\n"
        + "\}\n"
        + "\n"
        + "class Base \{\n"
        + "\}\n"
        + "\n"
        + "class Open extends Base \{\n"
        + "\}\n"
        + "\n"
        + "sealed abstract class Token \{\n"
        + "\}\n"
        + "\n"
        + "class Number extends Token \{\n"
        + "\}\n"
        + "\n"
        + "sealed class Tree \{\n"
        + "\}\n"
        + "\n"
        + "class Leaf extends Tree \{\n"
        + "\}\n"
        + "\n"
        + "class Holder<A, B> \{\n"
        + "    A first;\n"
        + "    B second;\n"
        + "\n"
        + "    constructor(A first, B second) \{\n"
        + "        this.first = first;\n"
        + "        this.second = second;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "interface Speaker \{\n"
        + "    speak();\n"
        + "\}\n"
        + "\n"
        + "\n"
        + "takes((int) -> int f) \{\n"
        + "\}\n"
        + "\n"
        + "shows(int[] xs) \{\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    void nothing;\n"
        + "    int x = 1;\n"
        + "    takes(5);\n"
        + "    shows([]);\n"
        + "    Speaker built = \{a: 1\};\n"
        + "    int? n = null;\n"
        + "    let m = n?.size;\n"
        + "    int[]? rows = null;\n"
        + "    let q = rows?[0];\n"
        + "    Widget w = new Widget();\n"
        + "    let r = (w)?.size;\n"
        + "    let s = (1 + 2)<int>.make();\n"
        + "    Color c = Color<int>.Red;\n"
        + "    int called = w.size();\n"
        + "    let h = Holder(1, \"a\");\n"
        + "    Plain plain = new Plain();\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "other(int x) \{\n"
        + "    int x = 2;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Variable 'nothing' cannot have type 'void', because 'void' means no value. Give 'nothing' the "
        + "type of the value it stores.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Argument 1 of 'takes' has type 'int', but parameter 'f' has type '(int) -> int'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'Speaker' is not a struct, and a '\{...\}' literal builds only a struct.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'n' has type 'int?', and an 'int' has no members to read with '?.'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'w' has type 'Widget', which can never be null, so it needs no '?.'. Write 'w.size'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "Type arguments go after a type's name, and '1 + 2' is not one.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "Type 'Color' is not generic, so it takes no type arguments. Remove '<int>'.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'size' is a field of type 'int', not a method. Read it without parentheses.");
    try sema_support.assertDiagnostic(reported, 8, file, "'Holder' is a type, not a function.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "Variable 'x' has the same name as a parameter. Rename one of the two.");
    try testing.assertEqual(reported.length, 10L);
}
