// Conditional members through the sema phases: the constraints recorded on the model, the
// per-instantiation existence result, and what an unmet constraint reports.
import @std.testing;
import TestFailure from @std.testing;
import ProgramAnalysis from pipeline;
import model.hierarchy;
import Method from model.typemembers;
import model.typenames;
import ClassType from model.types;
import InstantiationType from model.types;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

analyzeAll(string text) -> ProgramAnalysis {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    return sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
}

analyzeClean(string text) -> ProgramAnalysis throws {
    let analysis = analyzeAll(text);
    try sema_support.assertProgramClean(analysis);
    return analysis;
}

// A shared program: 'Item' satisfies 'Comparable<Item>', 'Plain' satisfies nothing, and 'Duo'
// carries a conditional method and a conditional static beside unconditional members. Extra
// members join 'Duo'; extra declarations follow it.
duoProgram(string extraMembers, string extraDeclarations, string mainBody) -> string {
    return "public interface Comparable<T> \{\n"
        + "    compareTo(T other) -> int;\n"
        + "\}\n"
        + "public class Item implements Comparable<Item> \{\n"
        + "    int value;\n"
        + "\n"
        + "    public constructor(this.value);\n"
        + "\n"
        + "    public override compareTo(Item other) -> int \{\n"
        + "        return this.value - other.value;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Plain \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Duo<T> \{\n"
        + "    T first;\n"
        + "    T second;\n"
        + "\n"
        + "    public constructor(this.first, this.second);\n"
        + "\n"
        + "    public pair() -> T \{\n"
        + "        return this.first;\n"
        + "    \}\n"
        + "\n"
        + "    public lower<T: Comparable<T>>() -> T \{\n"
        + "        if (this.second.compareTo(this.first) < 0) \{\n"
        + "            return this.second;\n"
        + "        \}\n"
        + "        return this.first;\n"
        + "    \}\n"
        + "\n"
        + "    public static pickLower<T: Comparable<T>>(T left, T right) -> T \{\n"
        + "        if (right.compareTo(left) < 0) \{\n"
        + "            return right;\n"
        + "        \}\n"
        + "        return left;\n"
        + "    \}\n"
        + extraMembers
        + "\}\n"
        + extraDeclarations
        + "main() -> int \{\n"
        + mainBody
        + "    return 0;\n"
        + "\}\n";
}

methodNamed(ClassType owner, string name, bool statics) -> Method throws {
    let list = owner.methods();
    if (statics) {
        list = owner.staticMethods();
    }
    for (long i = 0; i < list.length(); i++) {
        if (list.get(i).name() == name) {
            return list.get(i);
        }
    }
    throw new TestFailure("no method '{name}' on '{owner.name()}'");
}

instanceMethodNamed(InstantiationType owner, string name) -> Method throws {
    let list = owner.methods();
    for (long i = 0; i < list.length(); i++) {
        if (list.get(i).name() == name) {
            return list.get(i);
        }
    }
    throw new TestFailure("no method '{name}' on '{typenames.display(owner)}'");
}

instantiationDisplayed(ProgramAnalysis analysis, string displayed) -> InstantiationType throws {
    for (let instantiation in analysis.store().allInstantiations()) {
        if (typenames.display(instantiation) == displayed) {
            return instantiation;
        }
    }
    throw new TestFailure("no instantiation '{displayed}' was interned");
}

test "a member's constraints land on the model and determine existence per instantiation" {
    let analysis = try analyzeClean(duoProgram("", "",
        "    let items = new Duo<Item>(new Item(2), new Item(1));\n"
        + "    let winner = items.lower();\n"
        + "    let lowest = Duo.pickLower(new Item(3), new Item(4));\n"
        + "    let plains = new Duo<Plain>(new Plain(), new Plain());\n"
        + "    let still = plains.pair();\n"));
    let duo = try sema_support.classNamed(analysis, "main", "Duo");
    let lower = try methodNamed(duo, "lower", false);
    try testing.assertTrue(lower.isConditional(), "'lower' must carry its constraint");
    try testing.assertEqual(lower.constraints().length, 1L);
    try testing.assertEqual(lower.constraints()[0].parameterIndex(), 0L);
    try testing.assertEqual(lower.constraints()[0].bounds().length, 1L);
    let pickLower = try methodNamed(duo, "pickLower", true);
    try testing.assertTrue(pickLower.isConditional(), "'pickLower' must carry its constraint");
    let pair = try methodNamed(duo, "pair", false);
    try testing.assertTrue(!pair.isConditional(), "'pair' must stay unconditional");

    let satisfied = try instantiationDisplayed(analysis, "Duo<Item>");
    let excluded = try instantiationDisplayed(analysis, "Duo<Plain>");
    try testing.assertEqual(satisfied.methods().length(), duo.methods().length());
    try testing.assertEqual(excluded.methods().length(), duo.methods().length());
    let store = analysis.store();
    let satisfiedLower = try instanceMethodNamed(satisfied, "lower");
    let excludedLower = try instanceMethodNamed(excluded, "lower");
    let excludedPair = try instanceMethodNamed(excluded, "pair");
    try testing.assertTrue(hierarchy.memberExistsOn(store, satisfiedLower),
        "'lower' must exist on 'Duo<Item>'");
    try testing.assertTrue(!hierarchy.memberExistsOn(store, excludedLower),
        "'lower' must not exist on 'Duo<Plain>'");
    try testing.assertTrue(hierarchy.memberExistsOn(store, excludedPair),
        "'pair' must exist on 'Duo<Plain>'");
}

test "the constraint's extra bound serves the member's own body and nowhere else" {
    let analysis = analyzeAll(duoProgram(
        "\n"
        + "    public peek() -> T \{\n"
        + "        return this.lower();\n"
        + "    \}\n", "", ""));
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'lower' exists on 'Duo<T>' only when 'T' satisfies 'Comparable<T>', and nothing here requires "
        + "that of 'T'. Add the bound to this method, as in '<T: Comparable<T>>', or to 'T' where it is "
        + "declared.");
    try testing.assertEqual(reported.length, 1L);
}

test "calls, constructions, and inferred statics on excluded instantiations name the unmet bound" {
    let analysis = analyzeAll(duoProgram("",
        "public class Sorted<T> \{\n"
        + "    long size;\n"
        + "\n"
        + "    public constructor<T: Comparable<T>>() \{\n"
        + "        this.size = 0;\n"
        + "    \}\n"
        + "\n"
        + "    public constructor(long capacity) \{\n"
        + "        this.size = capacity;\n"
        + "    \}\n"
        + "\}\n",
        "    let plains = new Duo<Plain>(new Plain(), new Plain());\n"
        + "    let missing = plains.lower();\n"
        + "    let inferred = Duo.pickLower(new Plain(), new Plain());\n"
        + "    let bag = new Sorted<Plain>();\n"));
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'lower' exists on 'Duo<T>' only when 'T' satisfies 'Comparable<T>', and in 'Duo<Plain>', 'T' is "
        + "'Plain', which does not implement 'Comparable<Plain>'. Use a type argument that implements "
        + "'Comparable<Plain>', or make 'Plain' implement it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'pickLower' exists on 'Duo<T>' only when 'T' satisfies 'Comparable<T>', and in 'Duo<Plain>', 'T' "
        + "is 'Plain', which does not implement 'Comparable<Plain>'. Use a type argument that implements "
        + "'Comparable<Plain>', or make 'Plain' implement it.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "This constructor of 'Sorted<T>' exists only when 'T' satisfies 'Comparable<T>', and in "
        + "'Sorted<Plain>', 'T' is 'Plain', which does not implement 'Comparable<Plain>'. Use a type "
        + "argument that implements 'Comparable<Plain>', or make 'Plain' implement it.");
    try testing.assertEqual(reported.length, 3L);
}

test "an obligation inside a conditional member is judged only where the member exists" {
    let analysis = try analyzeClean(duoProgram(
        "\n"
        + "    public tell<T: Comparable<T>>() -> string \{\n"
        + "        return \"\{this.first\}\";\n"
        + "    \}\n",
        "public struct Carrier \{\n"
        + "    public Item held;\n"
        + "\}\n",
        "    Carrier one = \{held: new Item(1)\};\n"
        + "    Carrier two = \{held: new Item(2)\};\n"
        + "    let mixed = new Duo<Carrier>(one, two);\n"
        + "    let still = mixed.pair();\n"
        + "    let items = new Duo<Item>(new Item(1), new Item(2));\n"
        + "    let told = items.tell();\n"));
}

test "constructor visibility gates new expressions and super chains" {
    let analysis = try sema_support.analyzeOne("public class Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Guarded \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Opened extends Guarded \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let locked = new Locked();\n"
        + "    let guarded = new Guarded();\n"
        + "    let opened = new Opened();\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Locked' is private, so only code inside 'Locked' can call it. Mark it "
        + "'public' to construct 'Locked' here.");
}

test "a public member, constructor or function stops at its package boundary" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Gear \{\n"
        + "    public int teeth = 3;\n"
        + "    export constructor();\n"
        + "\}\n"
        + "export class Latched \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public hidden() -> int \{ return 1; \}\n"
        + "export shipped() -> int \{ return 2; \}\n");
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\n"
        + "import Latched from @acme.parts;\n"
        + "import @acme.parts;\n"
        + "main() -> int \{\n"
        + "    let gear = new Gear();\n"
        + "    let latched = new Latched();\n"
        + "    return gear.teeth + parts.hidden() + parts.shipped();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Latched' is public inside package 'acme' but not exported. Mark it "
        + "'export' in module 'acme.parts' to construct 'Latched' from another package.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "'teeth' of 'Gear' is public inside package 'acme' but not exported. Mark it 'export' in "
        + "module 'acme.parts' to use it from another package.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Function 'hidden' is public inside package 'acme' but not exported. Mark it 'export' in "
        + "module 'acme.parts' to use it from another package.");
    try testing.assertEqual(found.length, 3L);
}

// A module-qualified name in a value position reads as what it is. A function this file can
// reach reads as a function, one it cannot reach as a visibility refusal, a name the module does
// not declare as absent, and a type as a type its module does not reach. The call in the message
// keeps the module as this file writes it, and the example is left out where this file has no
// name for the function's own types.
test "a module-qualified name in a value position reports what it is" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/vault.ens",
        "public class Vault \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib/parts.ens",
        "import Vault from lib.vault;\n"
        + "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "class Secret \{\n"
        + "\}\n"
        + "public shown(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "hidden() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "public keeper() -> Vault \{\n"
        + "    return new Vault();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "main() -> int \{\n"
        + "    let visible = parts.shown;\n"
        + "    let unspellable = parts.keeper;\n"
        + "    let unreachable = parts.hidden;\n"
        + "    let absent = parts.nosuch;\n"
        + "    let hiddenType = parts.Secret;\n"
        + "    let heldType = parts.Widget;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.shown' is a function, and a function's name is not a value. Call it as "
        + "'parts.shown(...)', or wrap it in a lambda, as in '(int) -> int callback = (value) -> "
        + "parts.shown(value);'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'parts.keeper' is a function, and a function's name is not a value. Call it as 'parts.keeper()', "
        + "or wrap it in a lambda.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Function 'hidden' is private to module 'lib.parts', so only that file can use it. Mark "
        + "it 'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nosuch' is not declared in module 'lib.parts'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Type 'Secret' is private to module 'lib.parts', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'parts.Widget' writes a type after a module name, and only a function can be written "
        + "after a module name. Write 'import Widget from lib.parts;' and then write 'Widget'.");
    try testing.assertEqual(reported.length, 6L);
}

// The refusal does not branch on what kind of type the module declares, so a class, an
// interface, an enum and a struct all read the same sentence, in a value position, as a static
// head, as an enum head and as a constructor call.
test "a module-qualified type name reads one refusal whatever the type is" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", sema_support.classKinds() + sema_support.valueKinds());
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "main() -> int \{\n"
        + "    let a = parts.Counter;\n"
        + "    let b = parts.Shown;\n"
        + "    let c = parts.Vault.open();\n"
        + "    let d = parts.Kind.Large;\n"
        + "    let e = parts.Made(1);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string[] refused = ["Counter", "Shown", "Vault", "Kind", "Made"];
    for (long i = 0; i < refused.length; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "'parts.{refused[i]}' writes a type after a module name, and only a function can be "
            + "written after a module name. Write 'import {refused[i]} from lib.parts;' and then "
            + "write '{refused[i]}'.");
    }
    try testing.assertEqual(reported.length, 5L);
}

// A method is reached by calling it, through 'this', through a value, or through '?.'. The name
// on its own is refused in each of the three, and a write to it is refused as a write, whether
// the write is an assignment or a '++'.
test "a method's name is not a value" {
    let analysis = try sema_support.analyzeOne("public class Counter \{\n"
        + "    int count;\n"
        + "\n"
        + "    public constructor() \{\n"
        + "        this.count = 0;\n"
        + "    \}\n"
        + "\n"
        + "    public bump(int by) -> int \{\n"
        + "        this.count = this.count + by;\n"
        + "        return this.count;\n"
        + "    \}\n"
        + "\n"
        + "    public readsItsOwn() \{\n"
        + "        let held = this.bump;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let counter = new Counter();\n"
        + "    let named = counter.bump;\n"
        + "    Counter? maybe = counter;\n"
        + "    let safe = maybe?.bump;\n"
        + "    counter.bump = 3;\n"
        + "    maybe?.bump = 3;\n"
        + "    (counter.bump) = 3;\n"
        + "    counter.bump++;\n"
        + "    return counter.bump(1);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string[] calls = ["this.bump(...)", "counter.bump(...)", "maybe?.bump(...)"];
    for (long i = 0; i < 3; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "'bump' is a method of 'Counter', and a method's name is not a value. Call it as '{calls[i]}'.");
    }
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'bump' is a method of 'Counter', so it cannot be assigned.");
    // A '?.' left side reports its own refusal beside the method's, since checking for null
    // would not leave a write that works either. A parenthesized left side names the same
    // place, so it reports the method's refusal alone.
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'?.' cannot appear on the left side of '=', because there is nothing to write to "
        + "when 'maybe' is null.");
    for (long i = 5; i < 8; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "'bump' is a method of 'Counter', so it cannot be assigned.");
    }
    try testing.assertEqual(reported.length, 8L);
}

// 'length' reports how much an array or a string holds, and neither has storage under that
// name, so a write to it is refused on a local, through a compound operator, through '++' and
// '--', on the result of a call, and on a 'T[]' inside a generic. The refusal names the type
// rather than the expression, so it reads the same for a value no name reaches, and an array's
// shows the replacement its element type allows.
test "'length' cannot be assigned" {
    let analysis = try sema_support.analyzeOne("lengthOf<T>(T[] items) \{\n"
        + "    items.length = 3;\n"
        + "\}\n"
        + "names() -> string[] \{\n"
        + "    return [\"a\"];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int[] slots = new int[2];\n"
        + "    string text = \"ab\";\n"
        + "    slots.length = 3;\n"
        + "    slots.length += 1;\n"
        + "    slots.length++;\n"
        + "    --slots.length;\n"
        + "    text.length = 3;\n"
        + "    text.length--;\n"
        + "    names().length = 3;\n"
        + "    lengthOf<int>(new int[1]);\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofInts = "'slots.length' is the number of elements in 'slots', so it cannot be assigned. An "
        + "array keeps the length it was created with. Create a new array of the size you need, as in "
        + "'new int[...]'.";
    string ofText = "'length' is the number of bytes in the string, so it cannot be assigned. A string "
        + "never changes once it is created, so build the text you need and assign that.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'items.length' is the number of elements in 'items', so it cannot be assigned. An array keeps "
        + "the length it was created with. Create a new array of the size you need, either by listing "
        + "every element, as in '[a, b]', or with 'T[] itemsResized = new T[size];' followed by 'for "
        + "(long i = 0; i < itemsResized.length; i++) \{ itemsResized[i] = ...; \}'.");
    for (long i = 1; i < 5; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", ofInts);
    }
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", ofText);
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", ofText);
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'names().length' is the number of elements in 'names()', so it cannot be assigned. An array "
        + "keeps the length it was created with. Create a new array of the size you need, either by "
        + "listing every element, as in '[a, b]', or with 'string[] resized = new string[size];' followed "
        + "by 'for (long i = 0; i < resized.length; i++) \{ resized[i] = ...; \}'.");
    try testing.assertEqual(reported.length, 8L);
}

// The 'length' refusal on an array shows how to create one of a new size. 'new T[size]' stands
// alone where a new slot's zero value is a valid element on every level it allocates, and any
// other element is created by listing every element or by the declaration and its fill loop.
// The declaration takes a fresh name from the array's own, or 'resized' when it has none.
test "the 'length' refusal shows a replacement the element type allows" {
    let analysis = try sema_support.analyzeOne("enum Color \{ Red, Green, \}\n"
        + "class Box \{ protected constructor(); \}\n"
        + "struct Point \{ int x; \}\n"
        + "struct Named \{ protected string name; \}\n"
        + "class Table \{\n"
        + "    protected string[] rows = [\"a\"];\n"
        + "    protected constructor();\n"
        + "    protected grow() \{ this.rows.length = 4; \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Box[] boxes = [new Box()];\n"
        + "    boxes.length = 2;\n"
        + "    Box?[] maybeBoxes = [null];\n"
        + "    maybeBoxes.length = 2;\n"
        + "    int[][] grid = new int[2][2];\n"
        + "    grid.length = 3;\n"
        + "    string[][] table = [[\"a\"]];\n"
        + "    table.length = 3;\n"
        + "    table[0].length = 3;\n"
        + "    int[]?[] rows = new int[2][];\n"
        + "    rows.length = 3;\n"
        + "    Point[] points = new Point[1];\n"
        + "    points.length = 2;\n"
        + "    Named[] names = [\{name: \"a\"\}];\n"
        + "    names.length = 2;\n"
        + "    Color[] colors = [Color.Red];\n"
        + "    colors.length = 2;\n"
        + "    (() -> int)[] makers = [() -> 1];\n"
        + "    makers.length = 2;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        lengthRefusal("this.rows", filledReplacement("string[]", "string", "rowsResized")));
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        lengthRefusal("boxes", filledReplacement("Box[]", "Box", "boxesResized")));
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        lengthRefusal("maybeBoxes", "as in 'new Box?[...]'"));
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        lengthRefusal("grid", "as in 'new int[...][...]'"));
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        lengthRefusal("table", filledReplacement("string[][]", "string[]", "tableResized")));
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        lengthRefusal("table[0]", filledReplacement("string[]", "string", "resized")));
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        lengthRefusal("rows", "as in 'new int[]?[...]'"));
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        lengthRefusal("points", "as in 'new Point[...]'"));
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        lengthRefusal("names", filledReplacement("Named[]", "Named", "namesResized")));
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        lengthRefusal("colors", filledReplacement("Color[]", "Color", "colorsResized")));
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        lengthRefusal("makers", filledReplacement("(() -> int)[]", "(() -> int)", "makersResized")));
    try testing.assertEqual(reported.length, 11L);
}

// The refusal of a write to the 'length' of the array 'array', ending in 'replacement'.
lengthRefusal(string array, string replacement) -> string {
    return "'{array}.length' is the number of elements in '{array}', so it cannot be assigned. An array "
        + "keeps the length it was created with. Create a new array of the size you need, {replacement}.";
}

// The replacement for an array whose slots cannot start as zero, declared as 'name'.
filledReplacement(string holder, string element, string name) -> string {
    return "either by listing every element, as in '[a, b]', or with '{holder} {name} = new "
        + "{element}[size];' followed by 'for (long i = 0; i < {name}.length; i++) \{ {name}[i] = ...; \}'";
}

// A 'protected' member or constructor used from another file names the files and types that can use
// it. A module name takes no '?.', and a loop over a class that is not iterable names the element type
// the loop declares.
test "a refusal across files names who can use the member and what to write instead" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public class Guarded \{\n"
        + "    protected int guarded = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Open \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "\n"
        + "public ping() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Guarded from lib.parts;\n"
        + "import Open from lib.parts;\n"
        + "import lib.parts;\n"
        + "\n"
        + "class Bag \{\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    let g = new Guarded();\n"
        + "    int read = g.guarded;\n"
        + "    let o = new Open();\n"
        + "    int n = parts?.ping();\n"
        + "    for (int each in new Bag()) \{\n"
        + "    \}\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'guarded' is 'protected' in class 'Guarded', so "
        + "only code in the file that declares 'Guarded' and in subclasses of 'Guarded' can use it. Mark "
        + "it 'public' to use it here.");
    try sema_support.assertDiagnostic(reported, 1, file, "The constructor of 'Open' is 'protected', so "
        + "only code in the file that declares 'Open' and in subclasses of 'Open' can call it. Mark it "
        + "'public' to construct 'Open' here.");
    try sema_support.assertDiagnostic(reported, 2, file, "'parts' is a module name, which is never null, so "
        + "'?.' cannot follow it. Replace '?.' with '.'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'Bag' cannot be used in 'for (... in ...)', "
        + "because it does not implement 'Iterable' from '@std.collections.iterator'. Declare 'class Bag "
        + "implements Iterable<int>' and give it the method 'override makeIterator() -> Iterator<int>'.");
    try testing.assertEqual(reported.length, 4L);
}

// A 'final' class has no subclasses, so a refusal of its 'protected' members names the declaring file
// alone.
test "a protected member of a final class is usable only in the file that declares the class" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public final class Vault \{\n"
        + "    protected int value;\n"
        + "\n"
        + "    protected constructor(this.value);\n"
        + "\n"
        + "    protected bump() \{\n"
        + "        this.value = this.value + 1;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "public makeVault() -> Vault \{\n"
        + "    return new Vault(1);\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Vault from lib.parts;\n"
        + "import lib.parts;\n"
        + "\n"
        + "main() -> int \{\n"
        + "    let made = new Vault(3);\n"
        + "    Vault held = parts.makeVault();\n"
        + "    held.bump();\n"
        + "    return held.value;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "The constructor of 'Vault' is 'protected', so "
        + "only code in the file that declares 'Vault' can call it. Mark it 'public' to construct "
        + "'Vault' here.");
    try sema_support.assertDiagnostic(reported, 1, file, "'bump' is 'protected' in class 'Vault', so only "
        + "code in the file that declares 'Vault' can use it. Mark it 'public' to use it here.");
    try sema_support.assertDiagnostic(reported, 2, file, "'value' is 'protected' in class 'Vault', so "
        + "only code in the file that declares 'Vault' can use it. Mark it 'public' to use it here.");
    try testing.assertEqual(reported.length, 3L);
}

// A 'sealed' class keeps its subclasses in its own file, but an open subclass there can be extended
// anywhere, so a refusal of its 'protected' members still names subclasses.
test "a protected member of a sealed class names the file and the subclasses that can use it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/tree.ens", "public sealed class Shape \{\n"
        + "    protected int sides = 0;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Polygon extends Shape \{\n"
        + "    public constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Shape from lib.tree;\n"
        + "import Polygon from lib.tree;\n"
        + "\n"
        + "class Square extends Polygon \{\n"
        + "    constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\n"
        + "    protected count() -> int \{\n"
        + "        return this.sides;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    let shape = new Shape();\n"
        + "    return shape.sides;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "The constructor of 'Shape' is 'protected', so "
        + "only code in the file that declares 'Shape' and in subclasses of 'Shape' can call it. Mark it "
        + "'public' to construct 'Shape' here.");
    try sema_support.assertDiagnostic(reported, 1, file, "'sides' is 'protected' in class 'Shape', so only "
        + "code in the file that declares 'Shape' and in subclasses of 'Shape' can use it. Mark it 'public' "
        + "to use it here.");
    try testing.assertEqual(reported.length, 2L);
}

// A struct has no subclasses, so a 'protected' member of one is usable only in the file that
// declares the struct.
test "a 'protected' struct member names the file that declares the struct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", "public struct Tally \{\n"
        + "    protected int count = 0;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Tally from lib.parts;\n"
        + "\n"
        + "main() -> int \{\n"
        + "    Tally t = \{\};\n"
        + "    return t.count;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'count' is 'protected' in struct "
        + "'Tally', so only code in the file that declares 'Tally' can use it. Mark it 'public' to use it "
        + "here.");
    try testing.assertEqual(reported.length, 1L);
}

test "a struct's members are private unless marked, exactly as a class's are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public struct Point \{\n"
        + "    public int x;\n"
        + "    int secret = 0;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Point from lib;\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    return p.x + p.secret;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'secret' is private to struct 'Point', so only code inside 'Point' can use it. Mark it 'public' "
        + "to use it here.");
}

test "an unmarked member of a file-private class or struct reaches its whole file" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app_test.ens",
        "class Helper \{\n"
        + "    int value;\n"
        + "    static const int LIMIT = 10;\n"
        + "    protected int spare = 0;\n"
        + "    constructor(this.value);\n"
        + "    doubled() -> int \{ return this.value * 2; \}\n"
        + "    static make(int value) -> Helper \{ return new Helper(value); \}\n"
        + "\}\n"
        + "struct Spot \{\n"
        + "    int x;\n"
        + "    constructor(this.x);\n"
        + "    shifted(int by) -> int \{ return this.x + by; \}\n"
        + "    static origin() -> Spot \{ return \{x: 0\}; \}\n"
        + "\}\n"
        + "class Reader \{\n"
        + "    constructor();\n"
        + "    read(Helper helper) -> int \{ return helper.value + helper.spare + Helper.LIMIT; \}\n"
        + "\}\n"
        + "struct Probe \{\n"
        + "    int depth = 0;\n"
        + "    probe(Spot spot) -> int \{ return spot.x + Spot(1).shifted(this.depth); \}\n"
        + "\}\n"
        + "measure() -> int \{\n"
        + "    let helper = Helper.make(4);\n"
        + "    () -> int reach = () -> helper.doubled() + new Helper(1).value;\n"
        + "    Spot spot = \{x: 3\};\n"
        + "    Probe probe = \{\};\n"
        + "    return reach() + new Reader().read(helper) + Spot.origin().x + probe.probe(spot);\n"
        + "\}\n"
        + "test \"reads a member\" \{\n"
        + "    let helper = new Helper(2);\n"
        + "    let total = helper.value + helper.doubled();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app_test.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a class with no constructor of its own is built wherever the class is visible" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public class Shared \{\n"
        + "    public int count = 3;\n"
        + "\}\n"
        + "class Local \{\n"
        + "    int count = 4;\n"
        + "\}\n"
        + "public countLocal() -> int \{\n"
        + "    return new Local().count;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Shared from lib;\n"
        + "main() -> int \{\n"
        + "    return new Shared().count;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "an unmarked member of a 'public' class or struct stays private to it in its own file" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Vault \{\n"
        + "    int code = 1;\n"
        + "    constructor();\n"
        + "    open() -> int \{ return this.code; \}\n"
        + "    static seal() -> int \{ return 2; \}\n"
        + "\}\n"
        + "public struct Pin \{\n"
        + "    int digits = 0;\n"
        + "\}\n"
        + "class Thief \{\n"
        + "    protected constructor();\n"
        + "    protected crack(Vault vault) -> int \{ return vault.code; \}\n"
        + "\}\n"
        + "steal(Vault vault, Pin pin) -> int \{\n"
        + "    let fresh = new Vault();\n"
        + "    return vault.open() + Vault.seal() + pin.digits;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'code' is private to class 'Vault', so only code inside 'Vault' can use it. Mark it 'public' to "
        + "use it here.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The constructor of 'Vault' is private, so only code inside 'Vault' can call it. Mark it 'public' "
        + "to construct 'Vault' here.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'open' is private to class 'Vault', so only code inside 'Vault' can use it. Mark it 'public' to "
        + "use it here.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "'seal' is private to class 'Vault', so only code inside 'Vault' can use it. Mark it 'public' to "
        + "use it here.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "'digits' is private to struct 'Pin', so only code inside 'Pin' can use it. Mark it 'public' to "
        + "use it here.");
}

test "a member of a file-private type used in another file after the type leaks is refused" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "class Helper \{\n"
        + "    int value = 1;\n"
        + "    bump() \{ this.value = this.value + 1; \}\n"
        + "\}\n"
        + "struct Spot \{\n"
        + "    int x;\n"
        + "\}\n"
        + "public make() -> Helper \{\n"
        + "    return new Helper();\n"
        + "\}\n"
        + "public place(Spot spot) -> int \{\n"
        + "    return spot.x;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib;\n"
        + "main() -> int \{\n"
        + "    let helper = lib.make();\n"
        + "    helper.value = 2;\n"
        + "    helper.bump();\n"
        + "    return helper.value + lib.place(\{x: 1\});\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 2L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/lib.ens",
        "Function 'make' is 'public', but its return type uses 'Helper', which is private to "
        + "module 'lib'. Mark 'Helper' 'public', or remove 'public' from 'make'.");
    try sema_support.assertDiagnostic(checks, 1, "/proj/src/lib.ens",
        "Function 'place' is 'public', but its parameter type uses 'Spot', which is private to "
        + "module 'lib'. Mark 'Spot' 'public', or remove 'public' from 'place'.");
    let bodies = analysis.bodyDiagnostics();
    try testing.assertEqual(bodies.length, 4L);
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/main.ens",
        "'value' belongs to class 'Helper', which is private to module 'lib', so only that file "
        + "can use it. Mark 'Helper' and 'value' 'public' to use it here.");
    try sema_support.assertDiagnostic(bodies, 1, "/proj/src/main.ens",
        "'bump' belongs to class 'Helper', which is private to module 'lib', so only that file "
        + "can use it. Mark 'Helper' and 'bump' 'public' to use it here.");
    try sema_support.assertDiagnostic(bodies, 2, "/proj/src/main.ens",
        "'value' belongs to class 'Helper', which is private to module 'lib', so only that file "
        + "can use it. Mark 'Helper' and 'value' 'public' to use it here.");
    try sema_support.assertDiagnostic(bodies, 3, "/proj/src/main.ens",
        "'x' belongs to struct 'Spot', which is private to module 'lib', so only that file can use "
        + "it. Mark 'Spot' and 'x' 'public' to use it here.");
}
