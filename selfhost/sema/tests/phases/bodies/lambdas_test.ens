// Function values: how a function type interns and displays, what a lambda takes from its target,
// what its body may read from the enclosing scope, and every rule the checker holds one to.
import @std.testing;
import ProgramAnalysis from pipeline;
import LambdaInfo from model.lambdas;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

test "a lambda takes its parameter and return types from its target" {
    let analysis = sema_support.analyzeProgram("apply((int) -> int f, int x) -> int \{ return f(x); \}\n"
        + "main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    return apply((v) -> v + 1, order(3, 1));\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a lambda records the values its body reads from the enclosing scope" {
    let analysis = sema_support.analyzeProgram("class Counter \{\n"
        + "    long total;\n"
        + "    constructor() \{ this.total = 0; \}\n"
        + "    adder(long step) -> (long) -> void \{\n"
        + "        long extra = step + 1;\n"
        + "        return (by) -> this.bump(by + step + extra);\n"
        + "    \}\n"
        + "    bump(long by) \{ this.total = this.total + by; \}\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n");
    try sema_support.assertProgramClean(analysis);
    let info = try onlyLambdaOf(analysis);
    let captures = info.captures();
    try testing.assertEqual(captures.length, 3L);
    try testing.assertTrue(captures[0].isReceiver(), "'this' is captured first, as it is read");
    let step = captures[1].binding();
    try testing.assertTrue(step != null && step.name() == "step", "then the parameter");
    let extra = captures[2].binding();
    try testing.assertTrue(extra != null && extra.name() == "extra", "then the local");
}

test "a lambda captures only what its body reads" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    long used = 1;\n"
        + "    long unused = 2;\n"
        + "    (long) -> long add = (v) -> v + used;\n"
        + "    return (add(unused)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let info = try onlyLambdaOf(analysis);
    try testing.assertEqual(info.captures().length, 1L);
    let captured = info.captures()[0].binding();
    try testing.assertTrue(captured != null && captured.name() == "used",
        "only the local the body reads");
}

// The names a loop writes are looked up before its body declares its own locals, and that lookup is
// not a read, so a loop that writes a local of its own copies no local of that name from outside.
test "a lambda does not capture a name its loop writes only as a local of its own" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    long size = 1;\n"
        + "    () -> long count = () -> \{\n"
        + "        long rounds = 0;\n"
        + "        while (rounds < 4) \{\n"
        + "            long size = 1;\n"
        + "            size = size + 1;\n"
        + "            rounds = rounds + size;\n"
        + "        \}\n"
        + "        return rounds;\n"
        + "    \};\n"
        + "    return (count() + size) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let info = try onlyLambdaOf(analysis);
    try testing.assertEqual(info.captures().length, 0L);
}

test "a nested lambda makes the lambda around it capture what it reads" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    long base = 1;\n"
        + "    () -> (long) -> long outer = () -> (v) -> v + base;\n"
        + "    return (outer()(2L)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let lambdas = sema_support.lambdasOf(analysis, "main");
    try testing.assertEqual(lambdas.length(), 2L);
    for (long i = 0; i < lambdas.length(); i++) {
        try testing.assertEqual(lambdas.get(i).captures().length, 1L);
    }
}

test "a lambda has no shape without a target type" {
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    let f = (a) -> a;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda has no function type to give its parameters and its result their types. Write it "
        + "where a function type is declared, as in '(int, int) -> int compare = (a, b) -> a - b;'.");
}

test "a lambda's parameter list must match its target's exactly" {
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (a) -> a;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda takes 1 parameter, but '(int, int) -> int' takes 2 parameters. Write it as "
        + "'(a, b) -> ...'.");
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (int a, b) -> a - b;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda gives a type to some parameters and not to others. Write a type for every parameter "
        + "or for none, as in '(int a, int b) -> a + b' or '(a, b) -> a + b'.");
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (long a, int b) -> b;\n"
        + "    return 0;\n"
        + "\}\n",
        "Parameter 'a' is declared 'long', but the function type '(int, int) -> int' gives it an 'int'. "
        + "Write 'int a', or leave the type out.");
}

test "a captured local cannot be written inside the lambda" {
    try sema_support.assertOnlyProblem("main() -> int \{\n"
        + "    long total = 0;\n"
        + "    (long) -> void add = (v) -> total = total + v;\n"
        + "    return 0;\n"
        + "\}\n",
        "Cannot assign a new value to 'total' inside a lambda: a lambda works on copies of what it "
        + "captures, so the 'total' outside it would not change. Return the value the lambda computes and "
        + "store it where the lambda is called, or keep the value in a field of an object the lambda uses.");
}

// 'out' lets the callee write the local it names, so a capture passed as 'out' would be written in
// the lambda's copy, and it is refused like an assignment. A local the lambda declares may be passed.
test "a captured local cannot be passed as 'out' inside the lambda" {
    try sema_support.assertOnlyProblem("external from libc \{\n"
        + "    measure(out long size) -> int;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    long size = 0;\n"
        + "    () -> long captured = () -> \{\n"
        + "        let ignored = measure(out size);\n"
        + "        return size;\n"
        + "    \};\n"
        + "    () -> long own = () -> \{\n"
        + "        long measured = 0;\n"
        + "        let ignored = measure(out measured);\n"
        + "        return measured;\n"
        + "    \};\n"
        + "    return (captured() + own()) as int;\n"
        + "\}\n",
        "Cannot pass 'size' as 'out' inside a lambda: a lambda works on copies of what it captures, so "
        + "the 'size' outside it would not change. Pass a local the lambda declares instead, as "
        + "in 'long ownSize = 0;', and return the value the lambda computes or keep it in a field of an "
        + "object the lambda uses.");
}

// A struct field lives in the value that holds it, so a write through a captured struct changes
// the copy the lambda holds. The refusal names the local at the root of the chain, however many
// fields the chain steps through, and covers a compound write, a '++' and a '--' with it.
test "a captured struct cannot be written through its fields" {
    let analysis = sema_support.analyzeProgram("struct Inner \{\n"
        + "    protected int x = 0;\n"
        + "\}\n"
        + "struct Outer \{\n"
        + "    protected Inner inner = \{\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Outer outer = \{\};\n"
        + "    (int) -> int assign = (v) -> (outer.inner.x = v);\n"
        + "    (int) -> int compound = (v) -> (outer.inner.x += v);\n"
        + "    () -> int step = () -> (outer.inner.x++);\n"
        + "    () -> int stepPrefix = () -> (--outer.inner.x);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string refusal = "Cannot change 'outer' inside a lambda: a lambda works on copies of what it "
        + "captures, so the 'outer' outside it would not change. Return the value the lambda computes and "
        + "store it where the lambda is called, or keep the value in a field of an object the lambda uses.";
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", refusal);
    }
    try testing.assertEqual(reported.length, 4L);
}

// A write through a captured class reference or a captured array lands in the object the caller
// holds, not in a copy, so the lambda changes what the caller reads afterwards.
test "a lambda may write through a captured reference" {
    let analysis = sema_support.analyzeProgram("public class Counter \{\n"
        + "    public long total;\n"
        + "    public constructor() \{\n"
        + "        this.total = 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let counter = new Counter();\n"
        + "    long[] slots = new long[1];\n"
        + "    (long) -> void store = (v) -> \{\n"
        + "        counter.total = v;\n"
        + "        slots[0] = v;\n"
        + "    \};\n"
        + "    store(1L);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a lambda's own local may be written" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    (long) -> long twice = (v) -> \{\n"
        + "        long total = v;\n"
        + "        total = total + v;\n"
        + "        return total;\n"
        + "    \};\n"
        + "    return (twice(2L)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a struct's method cannot hand its own 'this' to a lambda" {
    try sema_support.assertOnlyProblem("struct Point \{\n"
        + "    int x;\n"
        + "    reader() -> (int) -> int \{ return (v) -> v + this.x; \}\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n",
        "A lambda cannot capture 'this' here: 'Point' is a struct, so the lambda would work on a "
        + "copy of it. Copy the fields the lambda needs into locals, or make 'Point' a class.");
}

test "a lambda takes its shape from the target through a '?:' and through switch arms" {
    let ternary = sema_support.analyzeProgram("main() -> int \{\n"
        + "    bool ascending = true;\n"
        + "    (int, int) -> int order = ascending ? (a, b) -> a - b : (a, b) -> b - a;\n"
        + "    return order(1, 2);\n"
        + "\}\n");
    try sema_support.assertProgramClean(ternary);
    let switched = sema_support.analyzeProgram("main() -> int \{\n"
        + "    int mode = 1;\n"
        + "    (int) -> int step = switch (mode) \{\n"
        + "        1 -> (v) -> v + 1,\n"
        + "        default -> (v) -> v - 1,\n"
        + "    \};\n"
        + "    return step(10);\n"
        + "\}\n");
    try sema_support.assertProgramClean(switched);
}

// A lambda in a '?:' or a switch passed as an argument takes the type of the parameter the value goes
// to, whether one function takes it, the overload it fits is chosen, or a type argument is inferred.
test "a lambda in a '?:' or a switch argument takes the type of its parameter" {
    let analysis = sema_support.analyzeProgram("run((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "combine((int) -> int step) -> int \{\n"
        + "    return step(1);\n"
        + "\}\n"
        + "combine((long, long) -> long join) -> long \{\n"
        + "    return join(1, 2);\n"
        + "\}\n"
        + "pick<T>(T value, (T) -> T change) -> T \{\n"
        + "    return change(value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    bool up = true;\n"
        + "    long joined = combine(up ? (a, b) -> a + b : (a, b) -> a);\n"
        + "    string picked = pick(\"text\", switch (joined) \{ 1 -> (s) -> s, default -> ((s) -> s), \});\n"
        + "    return run(up ? (x) -> x + 1 : (x) -> x);\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let names = sema_support.namesOfNoFile(analysis.store());
    string[] expected = ["(long, long) -> long", "(long, long) -> long", "(string) -> string",
        "(string) -> string", "(int) -> int", "(int) -> int"];
    let lambdas = sema_support.lambdasOf(analysis, "main");
    try testing.assertEqual(lambdas.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(names.of(lambdas.get(i).type()), expected[i]);
    }
}

// With no context type, a lambda in a '?:' or a switch takes the type the values with a type of their
// own join to, as a number literal beside them does.
test "a lambda in a '?:' or a switch with no context type takes the type of the other values" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    bool up = true;\n"
        + "    (int) -> int twice = (x) -> x * 2;\n"
        + "    let first = up ? (x) -> x + 1 : twice;\n"
        + "    let second = switch (first(1)) \{ 1 -> null, 2 -> twice, default -> (x) -> x, \};\n"
        + "    return first(1) + (second ?? twice)(2);\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let lambdas = sema_support.lambdasOf(analysis, "main");
    let names = sema_support.namesOfNoFile(analysis.store());
    try testing.assertEqual(lambdas.length(), 3L);
    for (let lambda in lambdas) {
        try testing.assertEqual(names.of(lambda.type()), "(int) -> int");
    }
}

// A '?:' or a switch with no context type whose only values are lambdas, or lambdas and 'null', has
// nothing to give the lambdas their types, and is refused once.
test "a '?:' or a switch whose values are only lambdas needs a context type" {
    string place = "such as a variable, a field, a parameter, an array element or a return value.";
    try sema_support.assertOnlyProblem(sema_support.inMain(["bool up = true;",
        "let f = up ? (a) -> a : (a) -> -a;", "return 0;"]),
        "This '?:' has no function type to give the lambdas in its branches, so their parameters and "
        + "results have no types. Write the '?:' where a function type is declared, {place}");
    try sema_support.assertOnlyProblem(sema_support.inMain(["bool up = true;",
        "let f = up ? (a) -> a : null;", "return 0;"]),
        "This '?:' has no function type to give the lambda in one of its branches, so the lambda's "
        + "parameters and result have no types. Write the '?:' where a function type is declared, {place}");
    try sema_support.assertOnlyProblem(sema_support.inMain(["int mode = 1;",
        "let f = switch (mode) \{ 1 -> (a) -> a, default -> (mode > 0 ? (a) -> 0 : (a) -> 1), \};",
        "return 0;"]),
        "This switch has no function type to give the lambdas in its arms, so their parameters and "
        + "results have no types. Write the switch where a function type is declared, {place}");
}

// The single lambda a one-lambda program holds.
onlyLambdaOf(ProgramAnalysis analysis) -> LambdaInfo throws {
    let lambdas = sema_support.lambdasOf(analysis, "main");
    if (lambdas.length() == 1) {
        return lambdas.get(0);
    }
    try testing.fail("expected exactly one lambda but found {lambdas.length()}");
}

// The refusal text for a write to the field named 'assigned', inside the default of the field
// named 'defaulted'.
siblingWriteRefusal(string assigned, string defaulted) -> string {
    return "Field '{assigned}' cannot be assigned inside the default of '{defaulted}'. A "
        + "default gives its own field a value and reads earlier ones, so give '{assigned}' its "
        + "value in its own default, or assign both fields in a constructor.";
}

// A field takes its value from its own default or from a constructor, so a default that writes a
// sibling is refused, whether it writes with '=', with a compound operator, with a '++' or with
// a '--', and on a struct as on a class. A struct field lives in the value that holds it, so a
// chain of them is a write to the sibling at its root and names that field, however many fields
// the chain steps through. A default that names its own field is refused for the reference
// alone, by the rule the checks phase owns.
test "a field default cannot assign a sibling field" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Holder \{\n"
        + "    int a = 1;\n"
        + "    int b = (a = 5);\n"
        + "    int c = (a += 2);\n"
        + "    int d = (a++);\n"
        + "    int e = (--a);\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    int first = 1;\n"
        + "    int second = (first = 3);\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected Inner inner = \{\};\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Chained \{\n"
        + "    Corner corner = \{\};\n"
        + "    int written = (corner.x = 7);\n"
        + "    int deep = (corner.inner.x = 8);\n"
        + "    int stepped = (corner.x++);\n"
        + "    int compounded = (corner.x += 2);\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        siblingWriteRefusal("a", "b"));
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        siblingWriteRefusal("a", "c"));
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        siblingWriteRefusal("a", "d"));
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        siblingWriteRefusal("a", "e"));
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        siblingWriteRefusal("first", "second"));
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "written"));
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "deep"));
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "stepped"));
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "compounded"));
    try testing.assertEqual(found.length, 9L);
}

// An element of the array a sibling refers to, and a field of the object one refers to, are
// storage of their own, so writing them is not writing the sibling. A default may also read an
// earlier sibling, call a module function, and hold a lambda that reads a sibling.
test "a field default may write through a sibling and read one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "baseValue() -> int \{\n"
        + "    return 4;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Box \{\n"
        + "    protected int value = 0;\n"
        + "    protected Corner corner = \{\};\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    int[] slots = new int[2];\n"
        + "    int written = (slots[0] = 5);\n"
        + "    Box box = new Box();\n"
        + "    int inner = (box.value = 6);\n"
        + "    int throughClass = (box.corner.x = 7);\n"
        + "    Corner[] corners = new Corner[2];\n"
        + "    int throughElement = (corners[0].x = 8);\n"
        + "    int fromFunction = baseValue();\n"
        + "    int doubled = fromFunction * 2;\n"
        + "    () -> int reader = () -> doubled + 1;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}
