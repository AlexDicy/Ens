// Function values: how a function type interns and displays, what a lambda takes from its target,
// what its body may read from the enclosing scope, and every rule the checker holds one to.
import @std.testing;
import ProgramAnalysis from pipeline;
import model.typenames;
import Type from model.types;
import TypeStore from model.types;
import FunctionType from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import LambdaInfo from model.lambdas;
import FileDiagnostic from support.diagnostics;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

// The diagnostics of whichever of the body, signature, and exception stages reported first.
problemsIn(string text) -> FileDiagnostic[] throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis,
        [Stage.Signatures, Stage.Bodies, Stage.Exceptions]);
    let body = analysis.bodyDiagnostics();
    if (body.length > 0) {
        return body;
    }
    let signatures = analysis.signatureDiagnostics();
    if (signatures.length > 0) {
        return signatures;
    }
    return analysis.exceptionDiagnostics();
}

assertOnlyProblem(string text, string message) throws {
    let problems = try problemsIn(text);
    if (problems.length != 1) {
        string first = "";
        if (problems.length > 0) {
            first = problems[0].message();
        }
        try testing.fail("expected 1 problem but found {problems.length}; first: {first}");
    }
    try testing.assertEqual(problems[0].message(), message);
}

test "a function type interns by its parameter types and its return type" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let first = store.functionOf([intType, intType], intType, []);
    let again = store.functionOf([intType, intType], intType, []);
    try testing.assertTrue(first == again, "the same shape is the same type object");
    try testing.assertTrue(first != store.functionOf([intType], intType, []),
        "a different arity is a different type");
    try testing.assertTrue(first != store.functionOf([intType, longType], intType, []),
        "a different parameter type is a different type");
    try testing.assertTrue(first != store.functionOf([intType, intType], longType, []),
        "a different return type is a different type");
    try testing.assertTrue(first is FunctionType, "the store answers with a function type");
}

test "a function type's throws list is part of its identity" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let node = sema_support.anyGreenNode();
    let boom = store.addClass("Boom", "main", "", "main.ens", node, Visibility.Private, [],
        false, false, false);
    let other = store.addClass("Other", "main", "", "main.ens", node, Visibility.Private, [],
        false, false, false);
    let plain = store.functionOf([intType], intType, []);
    let throwing = store.functionOf([intType], intType, [boom]);
    try testing.assertTrue(plain != throwing, "a list makes a different type than none");
    try testing.assertTrue(throwing == store.functionOf([intType], intType, [boom]),
        "the same list is the same type object");
    try testing.assertTrue(throwing != store.functionOf([intType], intType, [other]),
        "a different listed type is a different type");
    try testing.assertTrue(throwing != store.functionOf([intType], intType, [boom, other]),
        "a longer list is a different type");
    try testing.assertEqual(typenames.display(throwing), "(int) -> int throws Boom");
    try testing.assertEqual(typenames.display(store.functionOf([intType], intType, [boom, other])),
        "(int) -> int throws Boom, Other");
}

test "an error anywhere in the shape keeps the whole type an error" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    try testing.assertTrue(store.functionOf([store.errorType()], intType, []) == store.errorType(),
        "an error parameter type");
    try testing.assertTrue(store.functionOf([intType], store.errorType(), []) == store.errorType(),
        "an error return type");
}

test "a function type displays the way the language writes it" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let voidType = store.primitive(PrimitiveKind.Void);
    let compare = store.functionOf([intType, intType], intType, []);
    try testing.assertEqual(typenames.display(compare), "(int, int) -> int");
    try testing.assertEqual(typenames.display(store.functionOf([], store.stringType(), [])),
        "() -> string");
    let test = store.functionOf([intType], boolType, []);
    try testing.assertEqual(typenames.display(store.optionalOf(test)), "((int) -> bool)?");
    try testing.assertEqual(typenames.display(store.arrayOf(test)), "((int) -> bool)[]");
    try testing.assertEqual(typenames.display(store.functionOf([intType], test, [])),
        "(int) -> (int) -> bool");
    try testing.assertEqual(typenames.display(store.functionOf([test, intType], voidType, [])),
        "((int) -> bool, int) -> void");
}

test "a lambda takes its parameter and return types from its target" {
    let analysis = sema_support.analyzeProgram("apply((int) -> int f, int x) -> int \{ return f(x); \}\n"
        + "main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    return apply((v) -> v + 1, order(3, 1));\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a function type is an ordinary type wherever a type may be written" {
    let analysis = sema_support.analyzeProgram("public class Holder \{\n"
        + "    (int, int) -> int order;\n"
        + "    ((int) -> bool)? filter;\n"
        + "    public constructor((int, int) -> int order) \{\n"
        + "        this.order = order;\n"
        + "        this.filter = null;\n"
        + "    \}\n"
        + "\}\n"
        + "pick() -> (int) -> int \{ return (v) -> v; \}\n"
        + "hold(((int) -> int)[] steps) -> long \{ return steps.length; \}\n"
        + "main() -> int \{\n"
        + "    let holder = new Holder((a, b) -> a - b);\n"
        + "    return hold([(v) -> v, pick()]) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a lambda records the values its body reads from the enclosing scope" {
    let analysis = sema_support.analyzeProgram("class Counter \{\n"
        + "    long total;\n"
        + "    constructor() \{ this.total = 0; \}\n"
        + "    adder(long step) -> (long) -> void \{\n"
        + "        long extra = step + 1;\n"
        + "        return (by) -> this.bump(by + step + extra);\n"
        + "    \}\n"
        + "    bump(long by) \{ this.total = this.total + by; \}\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n");
    try sema_support.assertProgramClean(analysis);
    let info = try onlyLambdaOf(analysis);
    let captures = info.captures();
    try testing.assertEqual(captures.length, 3L);
    try testing.assertTrue(captures[0].isReceiver(), "'this' is captured first, as it is read");
    let step = captures[1].binding();
    try testing.assertTrue(step != null && step.name() == "step", "then the parameter");
    let extra = captures[2].binding();
    try testing.assertTrue(extra != null && extra.name() == "extra", "then the local");
}

test "a lambda captures only what its body reads" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    long used = 1;\n"
        + "    long unused = 2;\n"
        + "    (long) -> long add = (v) -> v + used;\n"
        + "    return (add(unused)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let info = try onlyLambdaOf(analysis);
    try testing.assertEqual(info.captures().length, 1L);
    let captured = info.captures()[0].binding();
    try testing.assertTrue(captured != null && captured.name() == "used",
        "only the local the body reads");
}

test "a nested lambda makes the lambda around it capture what it reads" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    long base = 1;\n"
        + "    () -> (long) -> long outer = () -> (v) -> v + base;\n"
        + "    return (outer()(2L)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let lambdas = sema_support.lambdasOf(analysis, "main");
    try testing.assertEqual(lambdas.length(), 2L);
    for (long i = 0; i < lambdas.length(); i++) {
        try testing.assertEqual(lambdas.get(i).captures().length, 1L);
    }
}

test "a lambda has no shape without a target type" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    let f = (a) -> a;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda has no function type to give its parameters and its result their types. Write it "
        + "where a function type is declared, as in '(int, int) -> int compare = (a, b) -> a - b;'.");
}

test "a lambda's parameter list must match its target's exactly" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (a) -> a;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda takes 1 parameter, but '(int, int) -> int' takes 2 parameters. Write it as "
        + "'(a, b) -> ...'.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (int a, b) -> a - b;\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda gives a type to some parameters and not to others. Write a type for every parameter "
        + "or for none, as in '(int a, int b) -> a + b' or '(a, b) -> a + b'.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (long a, int b) -> b;\n"
        + "    return 0;\n"
        + "\}\n",
        "Parameter 'a' is declared 'long', but the function type '(int, int) -> int' gives it an 'int'. "
        + "Write 'int a', or leave the type out.");
}

test "assignability between function types is invariant" {
    try assertOnlyProblem("take((long, long) -> long order) \{ \}\n"
        + "main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    take(order);\n"
        + "    return 0;\n"
        + "\}\n",
        "Argument 1 of 'take' has type '(int, int) -> int', but parameter 'order' has type '(long, long) "
            + "-> long'.");
}

test "a captured local cannot be written inside the lambda" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    long total = 0;\n"
        + "    (long) -> void add = (v) -> total = total + v;\n"
        + "    return 0;\n"
        + "\}\n",
        "Cannot assign a new value to 'total' inside a lambda: a lambda works on copies of what it "
        + "captures, so the 'total' outside it would not change. Return the value the lambda computes and "
        + "store it where the lambda is called, or keep the value in a field of an object the lambda uses.");
}

// A struct field lives in the value that holds it, so a write through a captured struct changes
// the copy the lambda holds. The refusal names the local at the root of the chain, however many
// fields the chain steps through, and covers a compound write, a '++' and a '--' with it.
test "a captured struct cannot be written through its fields" {
    let analysis = sema_support.analyzeProgram("struct Inner \{\n"
        + "    protected int x = 0;\n"
        + "\}\n"
        + "struct Outer \{\n"
        + "    protected Inner inner = \{\};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Outer outer = \{\};\n"
        + "    (int) -> int assign = (v) -> (outer.inner.x = v);\n"
        + "    (int) -> int compound = (v) -> (outer.inner.x += v);\n"
        + "    () -> int step = () -> (outer.inner.x++);\n"
        + "    () -> int stepPrefix = () -> (--outer.inner.x);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string refusal = "Cannot change 'outer' inside a lambda: a lambda works on copies of what it "
        + "captures, so the 'outer' outside it would not change. Return the value the lambda computes and "
        + "store it where the lambda is called, or keep the value in a field of an object the lambda uses.";
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", refusal);
    }
    try testing.assertEqual(reported.length, 4L);
}

// A write through a captured class reference or a captured array lands in the object the caller
// holds, not in a copy, so the lambda changes what the caller reads afterwards.
test "a lambda may write through a captured reference" {
    let analysis = sema_support.analyzeProgram("public class Counter \{\n"
        + "    public long total;\n"
        + "    public constructor() \{\n"
        + "        this.total = 0;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let counter = new Counter();\n"
        + "    long[] slots = new long[1];\n"
        + "    (long) -> void store = (v) -> \{\n"
        + "        counter.total = v;\n"
        + "        slots[0] = v;\n"
        + "    \};\n"
        + "    store(1L);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a lambda's own local may be written" {
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    (long) -> long twice = (v) -> \{\n"
        + "        long total = v;\n"
        + "        total = total + v;\n"
        + "        return total;\n"
        + "    \};\n"
        + "    return (twice(2L)) as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a captured local must be assigned where the lambda is created" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    long total;\n"
        + "    (long) -> long add = (v) -> v + total;\n"
        + "    total = 1;\n"
        + "    return 0;\n"
        + "\}\n",
        "Variable 'total' is used before it is assigned a value. Assign it on every path that leads to "
        + "this line, for example 'total = ...;'.");
}

test "a lambda body that can throw is refused against a target that lists nothing" {
    try assertOnlyProblem("public class Failure extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "mayFail(int value) -> int throws \{\n"
        + "    if (value < 0) \{ throw new Failure(\"negative\"); \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    (int) -> int f = (a) -> try mayFail(a);\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda can throw 'Failure', but the function type it is given to has no 'throws' "
        + "list. Add 'throws Failure' after that function type's return type, as in '(() -> void "
        + "throws Failure)', or move the throwing code into a named function that catches "
        + "'Failure' with a 'catch' clause.");
}

test "a lambda body is held to the throws list its target declares" {
    try assertOnlyProblem("public class Failure extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "public class Other extends Error \{\n"
        + "    public constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "mayFail(int value) -> int throws Failure \{\n"
        + "    if (value < 0) \{ throw new Failure(\"negative\"); \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    ((int) -> int throws Other) f = (a) -> try mayFail(a);\n"
        + "    return 0;\n"
        + "\}\n",
        "This lambda can throw 'Failure', which the function type it is given to does not list. "
        + "Add 'Failure' to that function type's 'throws' list, or move the throwing code into a "
        + "named function that catches 'Failure' with a 'catch' clause.");
}

test "a function value has no identity, no members and no text form" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) -> int f = (a) -> a;\n"
        + "    (int) -> int g = (a) -> a;\n"
        + "    if (f == g) \{ return 1; \}\n"
        + "    return 0;\n"
        + "\}\n",
        "A function value has no identity, so '(int) -> int' and '(int) -> int' cannot be "
        + "compared. Compare what the functions produce, or keep a name or tag beside each one "
        + "and compare that.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) -> int f = (a) -> a;\n"
        + "    return (f.hash()) as int;\n"
        + "\}\n",
        "A function value has no members, so 'hash' cannot be used on '(int) -> int'. Call the "
        + "value with '(...)', or keep the data you need beside it.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) -> int f = (a) -> a;\n"
        + "    print(\"\{f\}\");\n"
        + "    return 0;\n"
        + "\}\n",
        "Cannot interpolate a value of type '(int) -> int': a function value has no text form. "
        + "Interpolate what the function returns, or a name you keep beside it.");
}

test "a function value is called by position, with the arity its type declares" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    return order(1);\n"
        + "\}\n",
        "'order' has type '(int, int) -> int', so it takes two arguments, but this call passes one. "
        + "Add one more argument.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) -> int step = (a) -> a;\n"
        + "    return step(a: 1);\n"
        + "\}\n",
        "A function type has no parameter names, so a function value takes its arguments by "
        + "position. Write the values in order, without 'a:'.");
}

test "a function value's type is already fixed, so a call writes no type arguments" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    return order<int>(1, 2);\n"
        + "\}\n",
        "A function value takes no type arguments; its type '(int, int) -> int' is already "
        + "fixed. Remove the '<...>' list.");
}

test "a nullable function value is called only after it narrows" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    ((int) -> int)? maybe = null;\n"
        + "    return maybe(1);\n"
        + "\}\n",
        "'maybe' has type '((int) -> int)?', which may be null here. Check 'maybe' for null first "
        + "('if (maybe != null)').");
    let analysis = sema_support.analyzeProgram("main() -> int \{\n"
        + "    ((int) -> int)? maybe = null;\n"
        + "    if (maybe != null) \{ return maybe(1); \}\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "a struct's method cannot hand its own 'this' to a lambda" {
    try assertOnlyProblem("struct Point \{\n"
        + "    int x;\n"
        + "    reader() -> (int) -> int \{ return (v) -> v + this.x; \}\n"
        + "\}\n"
        + "main() -> int \{ return 0; \}\n",
        "A lambda cannot capture 'this' here: 'Point' is a struct, so the lambda would work on a "
        + "copy of it. Copy the fields the lambda needs into locals, or make 'Point' a class.");
}

test "a function type takes no 'void' parameter" {
    try assertOnlyProblem("take((void) -> int f) \{ \}\n"
        + "main() -> int \{ return 0; \}\n",
        "'void' means no value, so it cannot be a parameter type. Write '() -> ...' for a "
        + "function value that takes nothing.");
}

test "parentheses in a type are allowed only around a function type" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) count = 1;\n"
        + "    return count;\n"
        + "\}\n",
        "In a type, only a function type can be written in parentheses, as in '((int) -> bool)?'. "
        + "Remove the parentheses around 'int'.");
    try assertOnlyProblem("main() -> int \{\n"
        + "    (((int) -> int)) step = (a) -> a;\n"
        + "    return step(1);\n"
        + "\}\n",
        "In a type, only a function type can be written in parentheses, as in '((int) -> bool)?'. "
        + "Remove the parentheses around '(int) -> int'.");
    let analysis = sema_support.analyzeProgram("take(((int) -> bool) -> int pick) \{ \}\n"
        + "main() -> int \{\n"
        + "    ((int) -> bool)? maybe = null;\n"
        + "    ((int) -> bool)[] many = [(v) -> v > 0];\n"
        + "    return many.length as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

// A '?' after a function type binds to its return type, so the type that allows null is the
// parenthesized one and the hint has to say so.
test "the hint for a function type that should allow null names the parenthesized form" {
    try assertOnlyProblem("main() -> int \{\n"
        + "    (int) -> bool? notNullable = null;\n"
        + "    return 0;\n"
        + "\}\n",
        "Variable 'notNullable' has type '(int) -> bool?', but its value has type 'null'. '(int) -> "
        + "bool?' can never be null. Write the type as '((int) -> bool?)?' if it should allow null.");
}

test "a lambda takes its shape from the target through a '?:' and through switch arms" {
    let ternary = sema_support.analyzeProgram("main() -> int \{\n"
        + "    bool ascending = true;\n"
        + "    (int, int) -> int order = ascending ? (a, b) -> a - b : (a, b) -> b - a;\n"
        + "    return order(1, 2);\n"
        + "\}\n");
    try sema_support.assertProgramClean(ternary);
    let switched = sema_support.analyzeProgram("main() -> int \{\n"
        + "    int mode = 1;\n"
        + "    (int) -> int step = switch (mode) \{\n"
        + "        1 -> (v) -> v + 1,\n"
        + "        default -> (v) -> v - 1,\n"
        + "    \};\n"
        + "    return step(10);\n"
        + "\}\n");
    try sema_support.assertProgramClean(switched);
}

// The single lambda a one-lambda program holds.
onlyLambdaOf(ProgramAnalysis analysis) -> LambdaInfo throws {
    let lambdas = sema_support.lambdasOf(analysis, "main");
    if (lambdas.length() == 1) {
        return lambdas.get(0);
    }
    try testing.fail("expected exactly one lambda but found {lambdas.length()}");
}

// The refusal text for a write to the field named 'assigned', inside the default of the field
// named 'defaulted'.
siblingWriteRefusal(string assigned, string defaulted) -> string {
    return "Field '{assigned}' cannot be assigned inside the default of '{defaulted}'. A "
        + "default gives its own field a value and reads earlier ones, so give '{assigned}' its "
        + "value in its own default, or assign both fields in a constructor.";
}

// A field takes its value from its own default or from a constructor, so a default that writes a
// sibling is refused, whether it writes with '=', with a compound operator, with a '++' or with
// a '--', and on a struct as on a class. A struct field lives in the value that holds it, so a
// chain of them is a write to the sibling at its root and names that field, however many fields
// the chain steps through. A default that names its own field is refused for the reference
// alone, by the rule the checks phase owns.
test "a field default cannot assign a sibling field" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Holder \{\n"
        + "    int a = 1;\n"
        + "    int b = (a = 5);\n"
        + "    int c = (a += 2);\n"
        + "    int d = (a++);\n"
        + "    int e = (--a);\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    int first = 1;\n"
        + "    int second = (first = 3);\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected Inner inner = \{\};\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Chained \{\n"
        + "    Corner corner = \{\};\n"
        + "    int written = (corner.x = 7);\n"
        + "    int deep = (corner.inner.x = 8);\n"
        + "    int stepped = (corner.x++);\n"
        + "    int compounded = (corner.x += 2);\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        siblingWriteRefusal("a", "b"));
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        siblingWriteRefusal("a", "c"));
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        siblingWriteRefusal("a", "d"));
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        siblingWriteRefusal("a", "e"));
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        siblingWriteRefusal("first", "second"));
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "written"));
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "deep"));
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "stepped"));
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "compounded"));
    try testing.assertEqual(found.length, 9L);
}

// An element of the array a sibling refers to, and a field of the object one refers to, are
// storage of their own, so writing them is not writing the sibling. A default may also read an
// earlier sibling, call a module function, and hold a lambda that reads a sibling.
test "a field default may write through a sibling and read one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "baseValue() -> int \{\n"
        + "    return 4;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Box \{\n"
        + "    protected int value = 0;\n"
        + "    protected Corner corner = \{\};\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    int[] slots = new int[2];\n"
        + "    int written = (slots[0] = 5);\n"
        + "    Box box = new Box();\n"
        + "    int inner = (box.value = 6);\n"
        + "    int throughClass = (box.corner.x = 7);\n"
        + "    Corner[] corners = new Corner[2];\n"
        + "    int throughElement = (corners[0].x = 8);\n"
        + "    int fromFunction = baseValue();\n"
        + "    int doubled = fromFunction * 2;\n"
        + "    () -> int reader = () -> doubled + 1;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}
