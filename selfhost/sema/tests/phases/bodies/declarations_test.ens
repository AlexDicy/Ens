import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;
import ProgramAnalysis from pipeline;
import ThisExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import InstantiationType from model.types;
import SemaResult from result;
import ConstructorCatch from result;
import CatchClauseNode from @ens.frontend.syntax.generated.nodes;
import List from @std.collections.list;

test "a noreturn body that can complete normally is rejected" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn dribble() \{\n"
        + "    print(\"still here\");\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "Function 'dribble' is declared 'noreturn', but a path through its body ends normally. End every "
        + "path by throwing, calling 'panic' or calling another 'noreturn' function.");
    try testing.assertEqual(reported.length, 1L);
}

test "noreturn functions and methods pass when every path ends" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "firstPositive(int[] values) -> int \{\n"
        + "    for (let value in values) \{\n"
        + "        if (value > 0) \{ return value; \}\n"
        + "    \}\n"
        + "    panic(\"no positive value\");\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected abstract noreturn halt();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected override noreturn halt() \{ panic(\"halt\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a 'this.field' parameter reaches a base field exactly where a body write reaches it" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Gear \{\n"
        + "    public int ratio = 2;\n"
        + "    protected int wear = 3;\n"
        + "    export int serial = 4;\n"
        + "    protected constructor();\n"
        + "\}\n");
    // 'Reaches' binds the two tiers a subclass in another package can write, so the public
    // field is the only one of the three a shorthand parameter cannot reach.
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\n"
        + "class Reaches extends Gear \{\n"
        + "    protected constructor(this.wear, this.serial);\n"
        + "\}\n"
        + "class Shorthand extends Gear \{\n"
        + "    protected constructor(this.ratio);\n"
        + "\}\n"
        + "class BodyWrite extends Gear \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "        this.ratio = 5;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    // A shorthand parameter writes the field, so both refusals read the same sentence.
    try testing.assertEqual(found[0].message(), found[1].message());
    try testing.assertEqual(found[0].message(),
        "'ratio' of 'Gear' is public inside package 'acme' but not exported. Change 'public' to "
        + "'export' on 'ratio' in module '@acme.parts' to use it from another package.");
}

// Test declarations belong to a '_test.ens' file, so a body of one is analyzed under that name.
analyzeTests(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/unit_test.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["unit_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "a test body is checked from a clean flow state, whatever came before it" {
    let narrowed = try analyzeTests(
        "class Door \{ protected int code; protected constructor(); \}\n"
        + "class Missing extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "opened(bool yes) -> Door? \{\n"
        + "    if (yes) \{\n"
        + "        return new Door();\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "test \"a throwing check narrows what follows it\" \{\n"
        + "    let door = opened(true);\n"
        + "    if (door == null) \{\n"
        + "        throw new Missing(\"nothing\");\n"
        + "    \}\n"
        + "    let code = door.code;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(narrowed.bodyDiagnostics());

    let unassigned = try analyzeTests("answer() -> long \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "test \"a local read before it is assigned\" \{\n"
        + "    long value;\n"
        + "    print(\"\{value\}\");\n"
        + "\}\n");
    try sema_support.assertDiagnostic(unassigned.bodyDiagnostics(), 0, "/proj/src/unit_test.ens",
        "Variable 'value' is used before it is assigned a value. Assign it on every path that leads to "
        + "this line, for example 'value = ...;'.");
    try testing.assertEqual(unassigned.bodyDiagnostics().length, 1L);
}

// A field default and a parameter default are built once per instantiation, where each type
// parameter stands for one written type argument. So both write one as a type argument, as an
// array element, as a lambda's parameter type, and as the argument of a generic type's static.
test "a type parameter is a type inside a field default and a parameter default" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "public class Zero<T> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static count() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Kept<Tag> \{\n"
        + "    public List<Tag> items = new List<Tag>();\n"
        + "    public Tag?[] slots = new Tag?[2];\n"
        + "    public (Tag) -> long weigh = (held) -> 1;\n"
        + "    public long zeroed = Zero<Tag>.count();\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public counts(List<Tag> more = new List<Tag>()) -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair<Left> \{\n"
        + "    public List<Left> lefts = new List<Left>();\n"
        + "    public Left carried;\n"
        + "\n"
        + "    public constructor(this.carried);\n"
        + "\}\n"
        + "carries<Value>(List<Value> items = new List<Value>()) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let kept = new Kept<int>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// A declared constructor that leaves out 'super(...)' is held to the rule a class with no
// constructor is, with the same variants of the refusal. A 'super(...)' call to a private base
// constructor is fixed by 'protected', which is what a subclass needs.
test "a declared constructor without 'super(...)' needs a zero-argument base constructor it can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Unchained extends Sized \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Matching extends Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Chained extends Sized \{\n"
        + "    protected constructor() \{ super(4); \}\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Hidden \{\n"
        + "    constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class CallsHidden extends Hidden \{\n"
        + "    protected constructor() \{ super(1); \}\n"
        + "\}\n"
        + "class Grand \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Middle extends Grand \{\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Unchained' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);' and add 'int width' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'Matching' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "The constructor of 'OverGuarded' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Guarded', which is private to 'Guarded'. "
        + "Mark 'constructor()' in 'Guarded' as 'protected' so a subclass can call it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "The constructor of 'OverHidden' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Hidden', which declares none. Mark "
        + "'constructor(int)' in 'Hidden' as 'protected' so a subclass can call it, then start "
        + "this constructor's body with 'super(count);' and add 'int count' to its parameters.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "The constructor of 'Hidden' is private, so only code inside 'Hidden' can call it. Mark it "
        + "'protected' to call it from a subclass.");
}

// A parameter the fix adds takes a number after its name when the constructor already uses the
// name for something else. A constructor with no body is told to gain one.
test "a declared constructor's fix keeps its own parameter names and its bodiless form" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width) \{ \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2) \{ \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Clash' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width2, height);' and add 'int width2, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'Crowded' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width3, height);' and add 'int width3, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "The constructor of 'Shorthand' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Give this constructor a body "
        + "that starts with 'super(width, height);' and add 'int width, int height' to its "
        + "parameters.");
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes that rename or give a body compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width, int width2, int height) \{ super(width2, height); \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2, int width3, int height) \{\n"
        + "        super(width3, height);\n"
        + "    \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth, int width, int height) \{ super(width, height); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let clash = new Clash(\"wide\", 1, 2);\n"
        + "    let crowded = new Crowded(\"wide\", true, 3, 4);\n"
        + "    let shorthand = new Shorthand(5, 6, 7);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// A subclass assigns its own fields before 'super(...)', so the fix for a constructor whose body
// assigns them calls 'super(...)' after those assignments, and the fixed class constructs.
test "a declared constructor's fix calls super(...) after the own fields its body assigns" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "class Labeled extends Named \{\n"
        + "    string label;\n"
        + "    constructor(string given) \{\n"
        + "        this.label = given;\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Labeled' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Named', which declares none. Call 'super(name);' in this "
        + "constructor's body after it assigns 'label', and add 'string name' to its parameters.");
    let fixed = new FakeFileLoader();
    fixed.add("/proj/src/main.ens",
        "class Named \{\n"
        + "    protected string name;\n"
        + "    protected constructor(this.name);\n"
        + "\}\n"
        + "class Labeled extends Named \{\n"
        + "    string label;\n"
        + "    constructor(string given, string name) \{\n"
        + "        this.label = given;\n"
        + "        super(name);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let labeled = new Labeled(\"label\", \"name\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(sema_support.analyzeAll(fixed, "/proj/src", ["main.ens"]));
}

// One 'lazy const' value is shared by every type argument, so its initializer cannot use a type
// parameter, whether the parameter is written as a type argument or stands where a value
// belongs. The refusal names the instance field that carries one value per instance instead.
test "a lazy const initializer refuses a type parameter written as a type or as a value" {
    let analysis = sema_support.analyzeProgram(
        "zeroOf<Value>() -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "public class Box<T> \{\n"
        + "    public lazy const long fromType = zeroOf<T>();\n"
        + "    public lazy const long fromValue = T;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The initializer of lazy const 'Box.fromType' cannot use a type parameter, because "
        + "one lazy const value is shared by every type argument of 'Box'. Remove 'lazy const' to give each "
        + "instance its own 'fromType'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The initializer of lazy const 'Box.fromValue' cannot use a type parameter, because "
        + "one lazy const value is shared by every type argument of 'Box'. Remove 'lazy const' to give each "
        + "instance its own 'fromValue'.");
    try testing.assertEqual(reported.length, 2L);
}

test "every terminating shape satisfies the return-path check" {
    let analysis = try sema_support.analyzeOne("enum Color \{ Red, Green, \}\n"
        + "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "viaIf(int x) -> int \{\n"
        + "    if (x > 0) \{ return 1; \} else if (x < 0) \{ return -1; \}\n"
        + "    else \{ panic(\"zero\"); \}\n"
        + "\}\n"
        + "viaSwitch(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> \{ return 1; \}, Green -> \{ return 2; \}, \}\n"
        + "\}\n"
        + "noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "viaNoreturnArms(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> \{ return 1; \}, Green -> panic(\"green\"), \}\n"
        + "\}\n"
        + "viaOnlyNoreturnArms(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> (stop()), Green -> panic(\"green\"), \}\n"
        + "\}\n"
        + "viaLoop() -> int \{\n"
        + "    while (true) \{ let x = 0; \}\n"
        + "\}\n"
        + "viaNestedBreak() -> int \{\n"
        + "    while (true) \{\n"
        + "        while (false) \{ break; \}\n"
        + "    \}\n"
        + "\}\n"
        + "viaForever() -> int \{\n"
        + "    for (;;) \{ let x = 0; \}\n"
        + "\}\n"
        + "viaForTrue(int n) -> int \{\n"
        + "    for (; true; n++) \{ \}\n"
        + "\}\n"
        + "viaForParenthesizedTrue(int n) -> int \{\n"
        + "    for (; (true); n++) \{ \}\n"
        + "\}\n"
        + "viaParenthesizedWhile() -> int \{\n"
        + "    while ((true)) \{ \}\n"
        + "\}\n"
        + "assignedAfterForever() -> string \{\n"
        + "    string label;\n"
        + "    for (;;) \{ \}\n"
        + "    return label;\n"
        + "\}\n"
        + "assignedAfterParenthesizedWhile() -> string \{\n"
        + "    string label;\n"
        + "    while ((true)) \{ \}\n"
        + "    return label;\n"
        + "\}\n"
        + "assignedBeforeBreakingWhile() -> int \{\n"
        + "    int x;\n"
        + "    while (true) \{ x = 1; break; \}\n"
        + "    return x;\n"
        + "\}\n"
        + "assignedBeforeBreakingParenthesizedWhile() -> int \{\n"
        + "    int x;\n"
        + "    while ((true)) \{ x = 1; break; \}\n"
        + "    return x;\n"
        + "\}\n"
        + "assignedBeforeBreakingFor() -> int \{\n"
        + "    int x;\n"
        + "    for (;;) \{ x = 1; break; \}\n"
        + "    return x;\n"
        + "\}\n"
        + "assignedBeforeBreakingForTrue() -> int \{\n"
        + "    int x;\n"
        + "    for (; true; ) \{ x = 1; break; \}\n"
        + "    return x;\n"
        + "\}\n"
        + "viaForInitializer(int n) -> int \{\n"
        + "    for (stop(); n < 3; n++) \{ \}\n"
        + "\}\n"
        + "noreturn haltsBeforeLooping(int n) \{\n"
        + "    for (stop(); n < 3; n++) \{ \}\n"
        + "\}\n"
        + "unassignedAfterHalting(int n) -> string \{\n"
        + "    string label;\n"
        + "    for (stop(); n < 3; n++) \{ \}\n"
        + "    return label;\n"
        + "\}\n"
        + "viaThrow(int x) -> int throws \{\n"
        + "    if (x > 0) \{ return x; \} else \{ throw new Failure(\"bad\"); \}\n"
        + "\}\n"
        + "main() -> int \{ return viaIf(1) + viaSwitch(Color.Red); \}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a body that can fall off the end is rejected" {
    let analysis = try sema_support.analyzeOne("bad(int x) -> int \{\n"
        + "    if (x > 0) \{ return 1; \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(1); \}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
}

test "a loop whose condition always holds does not terminate when a break binds to it" {
    let analysis = try sema_support.analyzeOne("bad() -> int \{\n"
        + "    while (true) \{\n"
        + "        if (1 > 0) \{ break; \}\n"
        + "    \}\n"
        + "\}\n"
        + "alsoBad() -> int \{\n"
        + "    for (;;) \{\n"
        + "        break;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{ return bad() + alsoBad(); \}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Function 'alsoBad' returns 'int', but a path through its body ends without a 'return'. "
        + "Add a 'return' at the end of every path.");
}

test "a for loop's update that never returns does not end the path after the loop" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "bad(int n) -> int \{\n"
        + "    for (; n < 3; stop()) \{ \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(0); \}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
}

test "a switch does not end the path when a block arm can finish or the arms give values" {
    let analysis = try sema_support.analyzeOne("enum Color \{ Red, Green, \}\n"
        + "bad(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> \{ return 1; \}, Green -> \{ let x = 0; \}, \}\n"
        + "\}\n"
        + "alsoBad(Color c) -> int \{\n"
        + "    switch (c) \{ Red -> 1, Green -> 2, \}\n"
        + "\}\n"
        + "main() -> int \{ return bad(Color.Red); \}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Function 'alsoBad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
}

test "a safe call to a noreturn method neither ends the path nor narrows after a null guard" {
    let analysis = try sema_support.analyzeOne("class Logger \{\n"
        + "    constructor();\n"
        + "\n"
        + "    noreturn fail() \{\n"
        + "        panic(\"failed\");\n"
        + "    \}\n"
        + "\}\n"
        + "bad(Logger? logger) -> int \{\n"
        + "    logger?.fail();\n"
        + "\}\n"
        + "lengthOf(string? text, Logger? logger) -> long \{\n"
        + "    if (text == null) \{\n"
        + "        logger?.fail();\n"
        + "    \}\n"
        + "    return text.length;\n"
        + "\}\n"
        + "main() -> int \{ return bad(null) + lengthOf(null, null) as int; \}\n");
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its body ends without a 'return'. Add a "
        + "'return' at the end of every path.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Cannot read a member of 'string?' because it may be null here. Check 'text' for null first "
        + "('if (text != null)').");
}

test "a catch clause of a non-void function must also exit" {
    let analysis = try sema_support.analyzeOne("class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "mayThrow(int x) -> int throws \{\n"
        + "    if (x < 0) \{ throw new Failure(\"negative\"); \}\n"
        + "    return x;\n"
        + "\}\n"
        + "bad() -> int \{\n"
        + "    return try mayThrow(1);\n"
        + "\} catch (Error e) \{\n"
        + "    let unused = 0;\n"
        + "\}\n"
        + "oneBranch(bool flag) -> int \{\n"
        + "    return try mayThrow(1);\n"
        + "\} catch (Error e) \{\n"
        + "    if (flag) \{ return -1; \}\n"
        + "\}\n"
        + "good() -> int \{\n"
        + "    return try mayThrow(1);\n"
        + "\} catch (Error e) \{\n"
        + "    return -1;\n"
        + "\}\n"
        + "main() -> int \{ return good(); \}\n");
    // Each clause is reported at its own span, so the text names the clause and not the body.
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Function 'bad' returns 'int', but a path through its 'catch' clause ends without a 'return'. Add "
        + "a 'return' at the end of every path.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Function 'oneBranch' returns 'int', but a path through its 'catch' clause ends without a "
        + "'return'. Add a 'return' at the end of every path.");
}

// 'this' in a member of a generic type is that type at its own type parameters, so a generic call
// infers from it as from any other value of the type.
test "'this' in a member of a generic type is the type at its own type parameters" {
    let analysis = sema_support.analyzeProgram("struct Pair<T> \{\n"
        + "    T first;\n"
        + "    count() -> long \{\n"
        + "        return countAll([this, this]);\n"
        + "    \}\n"
        + "\}\n"
        + "countAll<U>(U[] values) -> long \{\n"
        + "    return values.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let pair = try sema_support.structNamed(analysis, "main", "Pair");
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let receiver = firstThis(root);
    if (receiver == null) {
        try testing.fail("module 'main' writes no 'this'");
    }
    let recorded = context.result().typeOf(receiver.green());
    if (!(recorded is InstantiationType)) {
        try testing.fail("'this' was not recorded as an instantiation of 'Pair'");
    }
    try testing.assertTrue(recorded.template() == pair, "the template is 'Pair'");
    try testing.assertEqual(recorded.arguments().length, 1L);
    try testing.assertTrue(recorded.arguments()[0] == pair.typeParameterTypes()[0],
        "the argument is the parameter 'T' of 'Pair'");
}

firstThis(SyntaxNode node) -> ThisExpressionNode? {
    if (node is ThisExpressionNode) {
        return node;
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        let found = firstThis(children.get(i));
        if (found != null) {
            return found;
        }
    }
    return null;
}

test "a constructor's catch clause records each way a path through it finishes the constructor" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor() \{ super(\"failed\"); \}\n"
        + "\}\n"
        + "poke() throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "class Falls \{\n"
        + "    protected constructor() \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        print(\"fell through\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Returns \{\n"
        + "    protected constructor() \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        return;\n"
        + "    \}\n"
        + "\}\n"
        + "class Halts \{\n"
        + "    protected constructor() \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        panic(\"halt\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Branches \{\n"
        + "    protected constructor(bool early) \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        if (early) \{\n"
        + "            return;\n"
        + "        \}\n"
        + "        panic(\"halt\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Both \{\n"
        + "    protected constructor(bool early) \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        if (early) \{\n"
        + "            return;\n"
        + "        \}\n"
        + "        print(\"late\");\n"
        + "    \}\n"
        + "\}\n"
        + "class Method \{\n"
        + "    protected run() \{\n"
        + "        try poke();\n"
        + "    \} catch (Failure failure) \{\n"
        + "        print(\"handled\");\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let recorded = new List<string>();
    collectCatchExits(root, context.result(), recorded);
    string[] expected = ["end", "1 return", "none", "1 return", "end and 1 return", "none"];
    try testing.assertEqual(recorded.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(recorded.get(i), expected[i]);
    }
}

collectCatchExits(SyntaxNode node, SemaResult result, List<string> found) {
    if (node is CatchClauseNode) {
        found.push(describeExits(result.constructorCatchOf(node.green())));
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        collectCatchExits(children.get(i), result, found);
    }
}

describeExits(ConstructorCatch? exits) -> string {
    if (exits == null) {
        return "none";
    }
    string returns = "{exits.returns().length} return";
    if (!exits.reachesEnd()) {
        return returns;
    }
    if (exits.returns().length == 0) {
        return "end";
    }
    return "end and " + returns;
}
