import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;
import ProgramAnalysis from pipeline;

test "noreturn rejects a return type and a return statement" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn withType() -> int \{\n"
        + "    panic(\"x\");\n"
        + "\}\n"
        + "noreturn usesReturn() \{\n"
        + "    return;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Bodies]);
    let signatures = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "A 'noreturn' function never returns a value, so it declares no return type. Remove the "
        + "'-> ...' clause after the parameter list.");
    try testing.assertEqual(signatures.length, 1L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/app.ens",
        "Function 'usesReturn' is 'noreturn', so it never returns and cannot contain 'return'. Throw, "
        + "call 'panic' or call another 'noreturn' function instead.");
    try testing.assertEqual(bodies.length, 1L);
}

test "a noreturn body that can complete normally is rejected" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn dribble() \{\n"
        + "    print(\"still here\");\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "Function 'dribble' is declared 'noreturn', but a path through its body ends normally. End every "
        + "path by throwing, calling 'panic' or calling another 'noreturn' function.");
    try testing.assertEqual(reported.length, 1L);
}

test "noreturn is illegal on constructors and destructors" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    noreturn constructor() \{ panic(\"x\"); \}\n"
        + "    noreturn destructor() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "The constructor of 'Widget' cannot be marked 'noreturn'. A constructor always returns the "
        + "new object. Remove 'noreturn'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/app.ens",
        "The destructor of 'Widget' cannot be marked 'noreturn'. A destructor runs when the object "
        + "is destroyed, and it always returns. Remove 'noreturn'.");
    try testing.assertEqual(reported.length, 2L);
}

test "an override cannot drop a base method's noreturn contract" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "abstract class Base \{\n"
        + "    protected abstract noreturn boom();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected override boom() \{ panic(\"x\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/app.ens",
        "Override of 'boom' must be marked 'noreturn', because the 'boom' it overrides in 'Base' "
        + "is. Add 'noreturn' before the method name.");
    try testing.assertEqual(reported.length, 1L);
}

test "noreturn functions and methods pass when every path ends" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "firstPositive(int[] values) -> int \{\n"
        + "    for (let value in values) \{\n"
        + "        if (value > 0) \{ return value; \}\n"
        + "    \}\n"
        + "    panic(\"no positive value\");\n"
        + "\}\n"
        + "abstract class Base \{\n"
        + "    protected abstract noreturn halt();\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected override noreturn halt() \{ panic(\"halt\"); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a 'this.field' parameter reaches a base field exactly where a body write reaches it" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Gear \{\n"
        + "    public int ratio = 2;\n"
        + "    protected int wear = 3;\n"
        + "    export int serial = 4;\n"
        + "    protected constructor();\n"
        + "\}\n");
    // 'Reaches' binds the two tiers a subclass in another package can write, so the public
    // field is the only one of the three a shorthand parameter cannot reach.
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\n"
        + "class Reaches extends Gear \{\n"
        + "    protected constructor(this.wear, this.serial);\n"
        + "\}\n"
        + "class Shorthand extends Gear \{\n"
        + "    protected constructor(this.ratio);\n"
        + "\}\n"
        + "class BodyWrite extends Gear \{\n"
        + "    protected constructor() \{\n"
        + "        this.ratio = 5;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    // A shorthand parameter writes the field, so both refusals read the same sentence.
    try testing.assertEqual(found[0].message(), found[1].message());
    try testing.assertEqual(found[0].message(),
        "'ratio' of 'Gear' is public inside package 'acme' but not exported. Mark it 'export' "
        + "in module 'acme.parts' to use it from another package.");
}

// Test declarations belong to a '_test.ens' file, so a body of one is analyzed under that name.
analyzeTests(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/unit_test.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["unit_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "a test body is checked from a clean flow state, whatever came before it" {
    let narrowed = try analyzeTests(
        "class Door \{ protected int code; protected constructor(); \}\n"
        + "class Missing extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "opened(bool yes) -> Door? \{\n"
        + "    if (yes) \{\n"
        + "        return new Door();\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "test \"a throwing check narrows what follows it\" \{\n"
        + "    let door = opened(true);\n"
        + "    if (door == null) \{\n"
        + "        throw new Missing(\"nothing\");\n"
        + "    \}\n"
        + "    let code = door.code;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(narrowed.bodyDiagnostics());

    let unassigned = try analyzeTests("answer() -> long \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "test \"a local read before it is assigned\" \{\n"
        + "    long value;\n"
        + "    print(\"\{value\}\");\n"
        + "\}\n");
    try sema_support.assertDiagnostic(unassigned.bodyDiagnostics(), 0, "/proj/src/unit_test.ens",
        "Variable 'value' is used before it is assigned a value. Assign it on every path that leads to "
        + "this line, for example 'value = ...;'.");
    try testing.assertEqual(unassigned.bodyDiagnostics().length, 1L);
}

// A field default and a parameter default are built once per instantiation, where each type
// parameter stands for one written type argument. So both write one as a type argument, as an
// array element, as a lambda's parameter type, and as the argument of a generic type's static.
test "a type parameter is a type inside a field default and a parameter default" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "public class Zero<T> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static count() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Kept<Tag> \{\n"
        + "    public List<Tag> items = new List<Tag>();\n"
        + "    public Tag?[] slots = new Tag?[2];\n"
        + "    public (Tag) -> long weigh = (held) -> 1;\n"
        + "    public long zeroed = Zero<Tag>.count();\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public counts(List<Tag> more = new List<Tag>()) -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair<Left> \{\n"
        + "    public List<Left> lefts = new List<Left>();\n"
        + "    public Left carried;\n"
        + "\n"
        + "    public constructor(this.carried);\n"
        + "\}\n"
        + "carries<Value>(List<Value> items = new List<Value>()) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let kept = new Kept<int>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// A declared constructor that leaves out 'super(...)' is held to the rule a class with no
// constructor is, with the same variants of the refusal. A 'super(...)' call to a private base
// constructor is fixed by 'protected', which is what a subclass needs.
test "a declared constructor without 'super(...)' needs a zero-argument base constructor it can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Unchained extends Sized \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Matching extends Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Chained extends Sized \{\n"
        + "    protected constructor() \{ super(4); \}\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Hidden \{\n"
        + "    constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class CallsHidden extends Hidden \{\n"
        + "    protected constructor() \{ super(1); \}\n"
        + "\}\n"
        + "class Grand \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Middle extends Grand \{\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Unchained' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);' and add 'int width' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'Matching' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "The constructor of 'OverGuarded' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Guarded', which is private to 'Guarded'. "
        + "Mark 'constructor()' in 'Guarded' as 'protected' so a subclass can call it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "The constructor of 'OverHidden' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Hidden', which declares none. Mark "
        + "'constructor(int)' in 'Hidden' as 'protected' so a subclass can call it, then start "
        + "this constructor's body with 'super(count);' and add 'int count' to its parameters.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "The constructor of 'Hidden' is private, so only code inside 'Hidden' can call it. Mark it "
        + "'protected' to call it from a subclass.");
}

// A parameter the fix adds takes a number after its name when the constructor already uses the
// name for something else. A constructor with no body is told to gain one.
test "a declared constructor's fix keeps its own parameter names and its bodiless form" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width) \{ \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2) \{ \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Clash' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width2, height);' and add 'int width2, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "The constructor of 'Crowded' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width3, height);' and add 'int width3, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "The constructor of 'Shorthand' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Give this constructor a body "
        + "that starts with 'super(width, height);' and add 'int width, int height' to its "
        + "parameters.");
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes that rename or give a body compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width, int width2, int height) \{ super(width2, height); \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2, int width3, int height) \{\n"
        + "        super(width3, height);\n"
        + "    \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth, int width, int height) \{ super(width, height); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let clash = new Clash(\"wide\", 1, 2);\n"
        + "    let crowded = new Crowded(\"wide\", true, 3, 4);\n"
        + "    let shorthand = new Shorthand(5, 6, 7);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}
