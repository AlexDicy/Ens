import @std.testing;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

// The suggested declaration spells the function's own type, so it carries the 'throws' list and
// the 'try' a call to a raising function needs.
test "the suggested function type carries the throws list" {
    let analysis = try sema_support.analyzeOne("class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "risky(int value) -> int throws Error \{\n"
        + "    if (value < 0) \{\n"
        + "        throw new Failure(\"negative\");\n"
        + "    \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = risky;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "'risky' is a function, and a function's name is not a value. Call it as 'try risky(...)', or "
        + "wrap it in a lambda, as in '((int) -> int throws Error) callback = (value) -> try "
        + "risky(value);'.");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

// Where a function type is expected, a method's or a function's name is refused with a lambda of that
// type that calls it: its parameters named after the one it calls, a 'try' where that throws, and the
// list the type has to carry. No lambda is written where no candidate fits, where a type parameter
// decides the fit, and where the receiver runs code or is a struct's 'this', which a lambda refused it
// already leaves at the refusal. A method whose call returns a value of the function type is called
// instead.
test "a method or function named where a function type is expected is refused with a lambda" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/util.ens",
        "public helper(int count) -> int \{\n"
        + "    return count;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import util;\n"
        + "\n"
        + "class ParseError extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"bad\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class OtherError extends Error \{\n"
        + "    constructor() \{\n"
        + "        super(\"other\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Plain \{\n"
        + "    static make(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    static make(string text) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    static run() \{\n"
        + "    \}\n"
        + "\n"
        + "    static fail(int value) -> int throws ParseError \{\n"
        + "        throw new ParseError();\n"
        + "    \}\n"
        + "\n"
        + "    static vague() -> int throws \{\n"
        + "        throw new ParseError();\n"
        + "    \}\n"
        + "\n"
        + "    static padded(int a, int b = 2) -> int \{\n"
        + "        return a + b;\n"
        + "    \}\n"
        + "\n"
        + "    count(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    helper() -> (int) -> int \{\n"
        + "        return (a) -> a;\n"
        + "    \}\n"
        + "\n"
        + "    inside() -> int \{\n"
        + "        return apply(make) + apply(this.count);\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    int x = 0;\n"
        + "\n"
        + "    total() -> int \{\n"
        + "        return this.x;\n"
        + "    \}\n"
        + "\n"
        + "    handed() -> int \{\n"
        + "        return nothing(this.total);\n"
        + "    \}\n"
        + "\n"
        + "    nested() -> int \{\n"
        + "        () -> int outer = () -> nothing(this.total);\n"
        + "        return outer();\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "kept<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "makePlain() -> Plain \{\n"
        + "    return new Plain();\n"
        + "\}\n"
        + "\n"
        + "apply((int) -> int f) -> int \{\n"
        + "    return f(1);\n"
        + "\}\n"
        + "\n"
        + "applyText((string) -> int f) -> int \{\n"
        + "    return f(\"a\");\n"
        + "\}\n"
        + "\n"
        + "act(() -> void f) \{\n"
        + "    f();\n"
        + "\}\n"
        + "\n"
        + "nothing(() -> int f) -> int \{\n"
        + "    return f();\n"
        + "\}\n"
        + "\n"
        + "risky((() -> int throws ParseError) f) -> int \{\n"
        + "    return try f();\n"
        + "\} catch (ParseError e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "other(((int) -> int throws OtherError) f) -> int \{\n"
        + "    return try f(1);\n"
        + "\} catch (OtherError e) \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "use(Plain p) -> int \{\n"
        + "    int a = apply(Plain.make);\n"
        + "    int b = applyText(Plain.make);\n"
        + "    act(Plain.run);\n"
        + "    int c = nothing(Plain.run);\n"
        + "    int d = apply(Plain.fail);\n"
        + "    int e = other(Plain.fail);\n"
        + "    int f = nothing(Plain.vague);\n"
        + "    int g = risky(Plain.vague);\n"
        + "    int h = apply(Plain.padded);\n"
        + "    int i = apply(util.helper);\n"
        + "    int j = apply(kept);\n"
        + "    int k = apply(p.count);\n"
        + "    (int) -> int held = p.count;\n"
        + "    int l = apply(makePlain().count);\n"
        + "    int m = apply(p.make);\n"
        + "    let n = Plain.make;\n"
        + "    int o = apply(p.helper);\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'make' is a static method of "
        + "'Plain', and a static method is always called through its type name, even inside 'Plain'. A "
        + "method's name is not a value, so write a lambda that calls it: '(value) -> Plain.make(value)'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'count' is a method of 'Plain', "
        + "and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "this.count(value)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'total' is a method of 'Pair', and "
        + "a method's name is not a value. A lambda cannot capture 'this' here either: 'Pair' is a struct, "
        + "so the lambda would work on a copy of it. Copy the fields the lambda needs into locals, or make "
        + "'Pair' a class.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "A lambda cannot capture 'this' "
        + "here: 'Pair' is a struct, so the lambda would work on a copy of it. Copy the fields the lambda "
        + "needs into locals, or make 'Pair' a class.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", "'total' is a method of 'Pair', and "
        + "a method's name is not a value.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", "'make' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "Plain.make(value)'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", "'make' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '(text) -> "
        + "Plain.make(text)'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "'run' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '() -> "
        + "Plain.run()'.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens", "'run' is a static method of "
        + "'Plain', and a method's name is not a value. A function of type '() -> int' takes nothing and "
        + "returns an 'int', and no 'run' method does.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens", "'fail' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "try Plain.fail(value)'. The function type it is given to, '(int) -> int', must also list what "
        + "'fail' throws, as in '((int) -> int throws ParseError)'.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens", "'fail' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "try Plain.fail(value)'. The function type it is given to, '((int) -> int throws OtherError)', "
        + "must also list what 'fail' throws, as in '((int) -> int throws OtherError, ParseError)'.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens", "'vague' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '() -> try "
        + "Plain.vague()'. The function type it is given to, '() -> int', must also list what 'vague' "
        + "throws, as in '(() -> int throws Error)'.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens", "'vague' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '() -> try "
        + "Plain.vague()'.");
    try sema_support.assertDiagnostic(reported, 13, "/proj/src/main.ens", "'padded' is a static method of "
        + "'Plain', and a method's name is not a value. Write a lambda that calls it instead: '(a) -> "
        + "Plain.padded(a)'.");
    try sema_support.assertDiagnostic(reported, 14, "/proj/src/main.ens", "'util.helper' is a function, and "
        + "a function's name is not a value. Write a lambda that calls it instead: '(count) -> "
        + "util.helper(count)'.");
    try sema_support.assertDiagnostic(reported, 15, "/proj/src/main.ens", "'kept' is a function, and a "
        + "function's name is not a value. Write a lambda that calls it instead.");
    try sema_support.assertDiagnostic(reported, 16, "/proj/src/main.ens", "'count' is a method of 'Plain', "
        + "and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "p.count(value)'.");
    try sema_support.assertDiagnostic(reported, 17, "/proj/src/main.ens", "'count' is a method of 'Plain', "
        + "and a method's name is not a value. Write a lambda that calls it instead: '(value) -> "
        + "p.count(value)'.");
    try sema_support.assertDiagnostic(reported, 18, "/proj/src/main.ens", "'count' is a method of 'Plain', "
        + "and a method's name is not a value. Write a lambda that calls it instead.");
    try sema_support.assertDiagnostic(reported, 19, "/proj/src/main.ens", "'make' is a static method of "
        + "'Plain', so it is called on the type, not on the value 'p'. A method's name is not a value, so "
        + "write a lambda that calls it: '(value) -> Plain.make(value)'.");
    try sema_support.assertDiagnostic(reported, 20, "/proj/src/main.ens", "'make' is a static method of "
        + "'Plain', and a method's name is not a value. Call it as 'Plain.make(...)'.");
    try sema_support.assertDiagnostic(reported, 21, "/proj/src/main.ens", "'helper' is a method of 'Plain', "
        + "and a method's name is not a value. Call it as 'p.helper()'.");
    try testing.assertEqual(reported.length, 22L);
}

// Where a function type is expected, a base's static method read through a subclass is written as a
// lambda of that type. The function type selects the overloads, so access is judged on the ones it
// selects, and a type that no overload fits, or that lists nothing the method throws, is named.
test "a static method a subclass reaches where a function type is expected is written as a lambda" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/errors.ens",
        "public class FarError extends Error \{\n"
        + "    public constructor() \{\n"
        + "        super(\"far\");\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/base.ens",
        "import FarError from errors;\n"
        + "\n"
        + "public class Root<T> \{\n"
        + "    public static make() -> T? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\n"
        + "    public static wrap(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    public static far() -> int throws FarError \{\n"
        + "        throw new FarError();\n"
        + "    \}\n"
        + "\n"
        + "    public static const int limit = 3;\n"
        + "\}\n"
        + "\n"
        + "public class Guard \{\n"
        + "    static pick(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    public static pick(bool flag) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    static hidden(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/kinds.ens",
        "import Root from base;\n"
        + "import Guard from base;\n"
        + "\n"
        + "public class Branch extends Root<int> \{\n"
        + "\}\n"
        + "\n"
        + "public class Keeper extends Guard \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Branch from kinds;\n"
        + "import Keeper from kinds;\n"
        + "\n"
        + "apply((int) -> int f) -> int \{\n"
        + "    return f(1);\n"
        + "\}\n"
        + "\n"
        + "flag((bool) -> int f) -> int \{\n"
        + "    return f(true);\n"
        + "\}\n"
        + "\n"
        + "maybe(() -> int? f) -> int \{\n"
        + "    return f() ?? 0;\n"
        + "\}\n"
        + "\n"
        + "text((string) -> string f) -> string \{\n"
        + "    return f(\"a\");\n"
        + "\}\n"
        + "\n"
        + "use() -> int \{\n"
        + "    int a = maybe(Branch.make);\n"
        + "    int b = apply(Branch.wrap);\n"
        + "    int c = apply(Keeper.pick);\n"
        + "    int d = flag(Keeper.pick);\n"
        + "    int e = apply(Keeper.hidden);\n"
        + "    string f = text(Branch.wrap);\n"
        + "    int g = maybe(Branch.far);\n"
        + "    int h = apply(Branch.limit);\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '() -> "
        + "Root<int>.make()'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '(value) -> "
        + "Root<int>.wrap(value)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'pick(int)' is private to class "
        + "'Guard', so only code inside 'Guard' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Guard' in front. A method's name is not a value, so write a lambda "
        + "that calls it: 'import Guard from base;' and then '(value) -> Guard.pick(value)'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "'pick' is declared by 'Guard', and "
        + "a static is not inherited, so it is always written with 'Guard' in front. A method's name is not "
        + "a value, so write a lambda that calls it: 'import Guard from base;' and then '(flag) -> "
        + "Guard.pick(flag)'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", "'hidden' is private to class "
        + "'Guard', so only code inside 'Guard' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Guard' in front. A method's name is not a value, so write a lambda "
        + "that calls it: 'import Guard from base;' and then '(value) -> Guard.hidden(value)'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value. A function of type '(string) -> string' takes a 'string' and returns a 'string', and no "
        + "'wrap' method does.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", "'far' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '() -> try "
        + "Root<int>.far()'. The function type it is given to, '() -> int?', must also list what 'far' "
        + "throws.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "'limit' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.limit'.");
    try testing.assertEqual(reported.length, 8L);
}
