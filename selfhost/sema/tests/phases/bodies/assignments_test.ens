import @std.testing;
import sema_support;

// A write-back operator on a target no write can change reports that the target cannot change, and
// not the target's own null. What the value side of the write reports stays beside it.
test "a nullable target no write can change gets the refusal of the write instead of its null" {
    let analysis = try sema_support.analyzeOne("class Fixed \{\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes(Fixed fixed) \{\n"
        + "    fixed.count++;\n"
        + "    fixed.count += 1;\n"
        + "    fixed.count += 3000000000;\n"
        + "    pick()++;\n"
        + "    --pick();\n"
        + "    pick() += 1;\n"
        + "    pick() <<= 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string constant = "a 'const' field is assigned once when the object is constructed and never "
        + "again. Remove 'const' from the field if it needs to change.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "The '++' operator cannot change field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Literal 3000000000 is too large for 'int', whose largest value is 2147483647. Declare 'count' "
        + "as 'long?' instead.");
    try sema_support.assertDiagnostic(reported, 4, file, "'pick()' is not a variable, a field or an array "
        + "element, so '++' cannot change it.");
    try sema_support.assertDiagnostic(reported, 5, file, "'pick()' is not a variable, a field or an array "
        + "element, so '--' cannot change it.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'pick()' is not a variable, a field or an array element, so '+=' cannot store its result there.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'pick()' is not a variable, a field or an array element, so '<<=' cannot store its result there.");
    try testing.assertEqual(reported.length, 8L);
}

// A nullable target no write can change gets the refusal of the place first. After it come the texts
// the same write on the target without its '?' gets. They cover a refused type, a value that may be
// null, and a result that cannot be stored back.
test "a write refused for its types keeps the type refusal beside the place refusal" {
    let analysis = try sema_support.analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "pickCount() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes(Fixed fixed, Fixed other, Fixed third, int? p) \{\n"
        + "    fixed.label -= 1;\n"
        + "    other.count -= \"s\";\n"
        + "    pick() -= 1;\n"
        + "    third.count += p;\n"
        + "    pickCount() += \"a\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string constant = "a 'const' field is assigned once when the object is constructed and never "
        + "again. Remove 'const' from the field if it needs to change.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot use '-=' on field 'label': {constant}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'-=' needs numbers on both sides, but 'fixed.label' has type 'string?'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot use '-=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'-=' needs numbers on both sides, but 'other.count' has type 'int?' and '\"s\"' has type 'string'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'pick()' is not a variable, a field or an array element, so '-=' cannot store its result there.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'-=' needs numbers on both sides, but 'pick()' has type 'string?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+=' needs numbers on both sides, but 'third.count' and 'p' both have type 'int?'. "
        + "{sema_support.checkFirst("p")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'pickCount()' is not a variable, a field or an array element, so '+=' cannot store its result "
            + "there.");
    try sema_support.assertDiagnostic(reported, 9, file, "Cannot store the result of '+=' back into "
        + "'pickCount()', whose type is 'int?': adding 'string' to 'int' produces 'string'.");
    try testing.assertEqual(reported.length, 10L);
}

// A compound join into a nullable target that is no string cannot store its result back. The
// target's null is reported beside that refusal, so the two fixes together compile.
test "a join that cannot be stored back into a nullable target reports both refusals" {
    let analysis = try sema_support.analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "joins(int? held, Tally t) \{\n"
        + "    held += \"a\";\n"
        + "    t.count += \"a\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joined = "'+=' joins a string only when neither side can be null, but 'held' has type 'int?'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot store the result of '+=' back into "
        + "'held', whose type is 'int?': adding 'string' to 'int' produces 'string'. Declare 'held' as "
        + "'string?'.");
    try sema_support.assertDiagnostic(reported, 1, file, "{joined} {sema_support.checkFirst("held")}");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot store the result of '+=' back into "
        + "'t.count', whose type is 'int?': adding 'string' to 'int' produces 'string'. Declare field "
        + "'count' as 'string?'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'+=' joins a string only when neither side can "
        + "be null, but 't.count' has type 'int?'. 't.count' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "t.count;'), check the local, and write the result back to 't.count'.");
    try testing.assertEqual(reported.length, 4L);
}

// A compound write on a nullable target is checked as the same write on the target without its '?'.
// The texts that write gets come first, and the target's null comes after them. A literal that does
// not fit stops the check, as it does for the same write. A result that cannot be stored back is
// reported before the null.
test "a compound write on a nullable target keeps what the write on its core reports" {
    let analysis = try sema_support.analyzeOne("twins(byte? b, long? g, int? h, long wide) \{\n"
        + "    b += 300;\n"
        + "    b += (1);\n"
        + "    g += 3000000000;\n"
        + "    h &= wide;\n"
        + "    h += wide;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Literal 300 is too large for 'byte', whose largest value is 255. Declare 'b' as 'ushort?' instead.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+=' needs numbers on both sides, but 'b' has type 'byte?'. {sema_support.checkFirst("b")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+=' needs numbers on both sides, but 'g' has type 'long?'. {sema_support.checkFirst("g")}");
    try sema_support.assertDiagnostic(reported, 3, file, "'&=' needs the same integer type on both sides, "
        + "but 'h' has type 'int?' and 'wide' has type 'long'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'&=' needs integers on both sides, but 'h' has type 'int?'. {sema_support.checkFirst("h")}");
    try sema_support.assertDiagnostic(reported, 5, file, "Cannot store the result of '+=' back into 'h', "
        + "whose type is 'int?': adding 'long' to 'int' produces 'long'. Write 'wide as int', or declare "
        + "'h' as 'long?'.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'+=' needs numbers on both sides, but 'h' has type 'int?'. {sema_support.checkFirst("h")}");
    try testing.assertEqual(reported.length, 7L);
}

// A result that cannot be stored back names how the operator combined the two sides. The conversion
// with 'as' is offered only where both sides are numbers.
test "a result that cannot be stored back names how the operator combined the sides" {
    let analysis = try sema_support.analyzeOne("stored(int k, long wide, string text) \{\n"
        + "    k -= wide;\n"
        + "    k *= wide;\n"
        + "    k /= wide;\n"
        + "    k %= wide;\n"
        + "    k += text;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot store the result of '-=' back into 'k', "
        + "whose type is 'int': subtracting 'long' from 'int' produces 'long'. Write 'wide as int', or "
        + "declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot store the result of '*=' back into 'k', "
        + "whose type is 'int': multiplying 'int' by 'long' produces 'long'. Write 'wide as int', or "
        + "declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot store the result of '/=' back into 'k', "
        + "whose type is 'int': dividing 'int' by 'long' produces 'long'. Write 'wide as int', or declare "
        + "'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Cannot store the result of '%=' back into 'k', "
        + "whose type is 'int': the remainder of dividing 'int' by 'long' produces 'long'. Write 'wide as "
        + "int', or declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Cannot store the result of '+=' back into 'k', "
        + "whose type is 'int': adding 'string' to 'int' produces 'string'. Declare 'k' as 'string'.");
    try testing.assertEqual(reported.length, 5L);
}

// A refused write proves nothing about its target, so a later read is checked as if the write were
// not there. This is true for a compound assignment as it is for '++'.
test "a refused write narrows nothing" {
    let analysis = try sema_support.analyzeOne("pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes() \{\n"
        + "    int? h = pick();\n"
        + "    h += 1;\n"
        + "    int y = h + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+=' needs numbers on both sides, but 'h' has type 'int?'. {sema_support.checkFirst("h")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'h' has type 'int?'. {sema_support.checkFirst("h")}");
    try testing.assertEqual(reported.length, 2L);
}

// A write through '?.' whose value in front is a field copies that value first. A null check on a
// field proves nothing for the write after it.
test "a write through '?.' on a field copies the field before the check" {
    let analysis = try sema_support.analyzeOne("class Inner \{\n"
        + "    int plain = 0;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Box \{\n"
        + "    Inner? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "writes(Box b, Inner?[] rows) \{\n"
        + "    b.inner?.plain += 1;\n"
        + "    rows[0]?.plain -= 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string nothing = "because there is nothing to write to when";
    try sema_support.assertDiagnostic(reported, 0, file, "'?.' cannot appear on the left side of '+=', "
        + "{nothing} 'b.inner' is null. Copy 'b.inner' into a local first ('let inner = b.inner;') and "
        + "check the local, as in 'if (inner != null) \{ inner.plain += ...; \}'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'?.' cannot appear on the left side of '-=', "
        + "{nothing} 'rows[0]' is null. Copy 'rows[0]' into a local first ('let value = rows[0];') and "
        + "check the local, as in 'if (value != null) \{ value.plain -= ...; \}'.");
    try testing.assertEqual(reported.length, 2L);
}
