// Type-level members through the sema phases: the model lists they land in, the constants on
// static const fields, and the rules a static of a generic type and a lazy const follow.
import @std.testing;
import ConstantKind from model.literalvalues;
import model.literalvalues;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

test "statics land beside the instance members, outside layout and dispatch" {
    let analysis = try sema_support.analyzeOne(
        "public class Path \{\n"
        + "    public static const string separator = \"/\";\n"
        + "    public static const int limit = 10;\n"
        + "    public static const int doubled = Path.limit * 2 + 1;\n"
        + "\n"
        + "    public static join(string left, string right) -> string \{\n"
        + "        return left + Path.separator + right;\n"
        + "    \}\n"
        + "\n"
        + "    public describe() -> string \{\n"
        + "        return Path.separator;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(Path.join(\"a\", \"b\"));\n"
        + "    return Path.limit - 10;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let path = try sema_support.classNamed(analysis, "main", "Path");
    try testing.assertEqual(path.fields().length(), 0L);
    try testing.assertEqual(path.methods().length(), 1L);
    try testing.assertEqual(path.staticFields().length(), 3L);
    try testing.assertEqual(path.staticMethods().length(), 1L);
    try testing.assertTrue(path.staticMethods().get(0).isStatic(),
        "the static list must carry the marker");
    try testing.assertTrue(!path.methods().get(0).isStatic(),
        "an instance method must not carry the marker");
    let separator = path.staticFields().get(0).constantValue();
    try testing.assertTrue(separator != null, "'separator' should have evaluated");
    if (separator != null) {
        try testing.assertTrue(separator.kind() == ConstantKind.String, "a string constant");
        try testing.assertEqual(separator.text(), "/");
    }
    let doubled = path.staticFields().get(2).constantValue();
    try testing.assertTrue(doubled != null, "'doubled' should have evaluated");
    if (doubled != null) {
        try testing.assertEqual(doubled.integerBits(), 21L);
    }
}

test "the three type-argument forms resolve a generic type's static" {
    let analysis = try sema_support.analyzeOne(
        "public class Registry<T> \{\n"
        + "    T?[] slots;\n"
        + "\n"
        + "    public constructor(T?[] slots) \{\n"
        + "        this.slots = slots;\n"
        + "    \}\n"
        + "\n"
        + "    public static withCapacity(long capacity) -> Registry<T> \{\n"
        + "        return new Registry<T>(new T?[capacity]);\n"
        + "    \}\n"
        + "\n"
        + "    public static of(T[] values) -> Registry<T> \{\n"
        + "        T?[] copied = new T?[values.length];\n"
        + "        for (long i = 0; i < copied.length; i++) \{\n"
        + "            copied[i] = values[i];\n"
        + "        \}\n"
        + "        return new Registry<T>(copied);\n"
        + "    \}\n"
        + "\}\n"
        + "build() -> Registry<bool> \{\n"
        + "    return Registry.withCapacity(2);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let explicit = Registry<int>.withCapacity(8);\n"
        + "    let inferred = Registry.of([\"a\", \"b\"]);\n"
        + "    Registry<char> targeted = Registry.withCapacity(4);\n"
        + "    let built = build();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
}

test "statics are reached only through the declaring type's name" {
    let analysis = try sema_support.analyzeOne(
        "public class Widget \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static make() -> Widget \{\n"
        + "        return new Widget();\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair<A, B> \{\n"
        + "    public A first;\n"
        + "    public B second;\n"
        + "\n"
        + "    public static describe() -> string \{\n"
        + "        return \"pair\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let widget = Widget.make();\n"
        + "    let bad = widget.make();\n"
        + "    let bare = Pair.describe();\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'make' is a static method of 'Widget', so it is called on the type, not on the value 'widget'. "
            + "Write 'Widget.make()'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Pair' is generic, and this call does not show what its type arguments 'A' and 'B' are. Write "
        + "them, as in 'Pair<int, int>.describe()'.");
    try testing.assertEqual(reported.length, 2L);
}

// Statics are not inherited, so a base class's static leaves its name free for a subclass's own
// instance field.
test "a subclass instance field may share a name with a base class static" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public static const int limit = 5;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public int limit = 7;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let allowance = new Allowance();\n"
        + "    return allowance.limit - Quota.limit;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let quota = try sema_support.classNamed(analysis, "main", "Quota");
    let allowance = try sema_support.classNamed(analysis, "main", "Allowance");
    try testing.assertEqual(quota.fields().length(), 0L);
    try testing.assertEqual(quota.staticFields().length(), 1L);
    try testing.assertEqual(quota.staticFields().get(0).name(), "limit");
    try testing.assertEqual(allowance.staticFields().length(), 0L);
    try testing.assertEqual(allowance.fields().length(), 1L);
    try testing.assertEqual(allowance.fields().get(0).name(), "limit");
    try testing.assertTrue(!allowance.fields().get(0).isStatic(),
        "'allowance.limit' must reach the instance field");
}

// A subclass does inherit the base class's instance fields, so a static of that name collides with
// an instance member the subclass has.
test "a subclass static may not share a name with a base class instance field" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public int limit;\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public static const int limit = 7;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a field of 'Quota'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// Statics are not inherited, so a base class's static method leaves its name free for a
// subclass's own instance method.
test "a subclass instance method may share a name with a base class static method" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public static limit() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return new Allowance().limit() - Quota.limit();\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let quota = try sema_support.classNamed(analysis, "main", "Quota");
    let allowance = try sema_support.classNamed(analysis, "main", "Allowance");
    try testing.assertEqual(quota.methods().length(), 0L);
    try testing.assertEqual(quota.staticMethods().length(), 1L);
    try testing.assertEqual(quota.staticMethods().get(0).name(), "limit");
    try testing.assertEqual(allowance.staticMethods().length(), 0L);
    try testing.assertEqual(allowance.methods().length(), 1L);
    try testing.assertEqual(allowance.methods().get(0).name(), "limit");
}

// A subclass does inherit the base class's methods, so a static of that name collides with an
// instance member the subclass has.
test "a subclass static may not share a name with a base class instance method" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    public limit() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public static limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a method of 'Quota'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// An instance method of the type itself collides under the same rule, and the message names the
// owner.
test "a static may not share a name with an instance method of its own type" {
    let analysis = sema_support.analyzeProgram(
        "public class Allowance \{\n"
        + "    public limit() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\n"
        + "    public static limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    try sema_support.assertDiagnostic(analysis.layoutDiagnostics(), 0, "/proj/src/main.ens",
        "Static member 'limit' has the same name as a method of 'Allowance'; a static and an "
        + "instance member cannot share a name. Rename one of the two.");
    try testing.assertEqual(analysis.layoutDiagnostics().length, 1L);
}

// A private member belongs to its own class alone, so a subclass inherits nothing under that
// name. A static of the subclass may take it, for a private base method as for a private base
// field.
test "a private base class method and field leave their names free for a subclass static" {
    let analysis = sema_support.analyzeProgram(
        "public class Quota \{\n"
        + "    int room;\n"
        + "\n"
        + "    public constructor() \{\n"
        + "        this.room = 1;\n"
        + "    \}\n"
        + "\n"
        + "    limit() -> int \{\n"
        + "        return this.room;\n"
        + "    \}\n"
        + "\n"
        + "    public reach() -> int \{\n"
        + "        return this.limit();\n"
        + "    \}\n"
        + "\}\n"
        + "public class Allowance extends Quota \{\n"
        + "    public static limit() -> int \{\n"
        + "        return 7;\n"
        + "    \}\n"
        + "\n"
        + "    public static const int room = 2;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Allowance.limit() + Allowance.room - new Quota().reach();\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let allowance = try sema_support.classNamed(analysis, "main", "Allowance");
    try testing.assertEqual(allowance.staticMethods().length(), 1L);
    try testing.assertEqual(allowance.staticMethods().get(0).name(), "limit");
    try testing.assertEqual(allowance.staticFields().length(), 1L);
    try testing.assertEqual(allowance.staticFields().get(0).name(), "room");
}

test "a static method has no 'super', and only a class or a struct carries statics" {
    let analysis = try sema_support.analyzeOne(
        "public interface Contract \{ \}\n"
        + "public class Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public class Derived extends Base \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    public static probe() -> int \{\n"
        + "        return super.rank();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Contract.load();\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'super' is the part of the object a method was called on that its base class declares, and a "
        + "static method is not called on an object. Remove 'static' to make it an instance method.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Contract' is an interface, and an interface has no static members. Call 'load' on a value of a "
        + "class that implements 'Contract'.");
    try testing.assertEqual(reported.length, 2L);
}

test "a static const initializer follows the member visibility rules" {
    let analysis = sema_support.analyzeProgram(
        "public class Secret \{\n"
        + "    static const int hidden = 5;\n"
        + "\}\n"
        + "public class Reader \{\n"
        + "    public static const int copy = Secret.hidden + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    try sema_support.assertDiagnostic(analysis.checkDiagnostics(), 0, "/proj/src/main.ens",
        "'hidden' is private to class 'Secret', so only code inside 'Secret' can read it. Mark it "
        + "'protected' to read it here.");
    try testing.assertEqual(analysis.checkDiagnostics().length, 1L);
}

// A 'protected' static const reaches the file that declares its type, and the subclasses of a class
// that is not 'final'.
test "a protected static const read from another file names the code that can read it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public class Open \{\n"
        + "    protected static const int shared = 1;\n"
        + "\}\n"
        + "public final class Closed \{\n"
        + "    protected static const int kept = 2;\n"
        + "\}\n"
        + "public struct Limits \{\n"
        + "    protected static const int most = 3;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Open from lib;\n"
        + "import Closed from lib;\n"
        + "import Limits from lib;\n"
        + "public class Reader \{\n"
        + "    public static const int first = Open.shared;\n"
        + "    public static const int second = Closed.kept;\n"
        + "    public static const int third = Limits.most;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let reported = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'shared' is 'protected' in class "
        + "'Open', so only code in the file that declares 'Open' and in subclasses of 'Open' can read it. "
        + "Mark it 'public' to read it here.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'kept' is 'protected' in class "
        + "'Closed', so only code in the file that declares 'Closed' can read it. Mark it 'public' to read "
        + "it here.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'most' is 'protected' in struct "
        + "'Limits', so only code in the file that declares 'Limits' can read it. Mark it 'public' to read "
        + "it here.");
    try testing.assertEqual(reported.length, 3L);
}

// A static belongs to the class that declares it, so a static const initializer that reads one
// through a subclass is refused as a body is, once, naming the declaring class.
test "a static const initializer names the class that declares a static read through a subclass" {
    let analysis = sema_support.analyzeProgram(
        "class Root \{\n"
        + "    static const int limit = 3;\n"
        + "    lazy const string label = \"root\";\n"
        + "\n"
        + "    static make() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "class Branch extends Root \{\n"
        + "\}\n"
        + "class Leaf extends Branch \{\n"
        + "\}\n"
        + "class Reader \{\n"
        + "    static const int copied = Branch.limit;\n"
        + "    static const int deep = Leaf.limit + 1;\n"
        + "    static const string named = Branch.label;\n"
        + "    static const int called = Branch.make();\n"
        + "    lazy const int later = Branch.limit;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let constants = analysis.checkDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(constants, 0, file, "'limit' is declared by 'Root', and a static is "
        + "not inherited, so it is always written with 'Root' in front. Write 'Root.limit'.");
    try sema_support.assertDiagnostic(constants, 1, file, "'limit' is declared by 'Root', and a static is "
        + "not inherited, so it is always written with 'Root' in front. Write 'Root.limit'.");
    try sema_support.assertDiagnostic(constants, 2, file, "The initializer of static const 'Reader.named' "
        + "must be a compile-time constant, but 'Root.label' is a lazy const, whose value is built on its "
        + "first read at run time. A constant is built from literals, '+', '-', '*', '/', '%', string "
        + "concatenation and other static consts read through their type name.");
    try sema_support.assertDiagnostic(constants, 3, file, "The initializer of static const 'Reader.called' "
        + "must be a compile-time constant, but it calls a function, which only runs at run time. A "
        + "constant is built from literals, '+', '-', '*', '/', '%', string concatenation and other "
        + "static consts read through their type name.");
    try testing.assertEqual(constants.length, 4L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, file, "'limit' is declared by 'Root', and a static is not "
        + "inherited, so it is always written with 'Root' in front. Write 'Root.limit'.");
    try testing.assertEqual(bodies.length, 1L);
}

// A base class's static read through a subclass is written through the name the reading file has
// for the base, or after an import that gives it one, so the fix compiles where it is reported.
test "a static read through a subclass names the base the way the reading file can write it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/base.ens",
        "public class Root \{\n"
        + "    public static const int limit = 3;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Branch extends Root \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/alias.ens",
        "import Root as Base from base;\n"
        + "import Branch from base;\n"
        + "\n"
        + "public class AliasReader \{\n"
        + "    public static const int copied = Branch.limit;\n"
        + "\}\n"
        + "\n"
        + "public aliasRead() -> int \{\n"
        + "    return Branch.limit;\n"
        + "\}\n");
    loader.add("/proj/src/plain.ens",
        "import Branch from base;\n"
        + "\n"
        + "public class PlainReader \{\n"
        + "    public static const int copied = Branch.limit;\n"
        + "\}\n"
        + "\n"
        + "public plainRead() -> int \{\n"
        + "    return Branch.limit;\n"
        + "\}\n");
    loader.add("/proj/src/clash.ens",
        "import Branch from base;\n"
        + "\n"
        + "class Root \{\n"
        + "\}\n"
        + "\n"
        + "public class ClashReader \{\n"
        + "    public static const int copied = Branch.limit;\n"
        + "\}\n"
        + "\n"
        + "public clashRead() -> int \{\n"
        + "    return Branch.limit;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import alias;\n"
        + "import plain;\n"
        + "import clash;\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return alias.aliasRead() + plain.plainRead() + clash.clashRead();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let constants = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(constants, 0, "/proj/src/alias.ens", "'limit' is declared by 'Base', "
        + "and a static is not inherited, so it is always written with 'Base' in front. Write 'Base.limit'.");
    try sema_support.assertDiagnostic(constants, 1, "/proj/src/clash.ens", "'limit' is declared by 'Root "
        + "(from base)', and a static is not inherited, so it is always written with 'BaseRoot' in front. "
        + "Write 'import Root as BaseRoot from base;' and then 'BaseRoot.limit'.");
    try sema_support.assertDiagnostic(constants, 2, "/proj/src/plain.ens", "'limit' is declared by 'Root "
        + "(from base)', and a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'import Root from base;' and then 'Root.limit'.");
    try testing.assertEqual(constants.length, 3L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/alias.ens", "'limit' is declared by 'Base', and "
        + "a static is not inherited, so it is always written with 'Base' in front. Write 'Base.limit'.");
    try sema_support.assertDiagnostic(bodies, 1, "/proj/src/clash.ens", "'limit' is declared by 'Root (from "
        + "base)', and a static is not inherited, so it is always written with 'BaseRoot' in front. Write "
        + "'import Root as BaseRoot from base;' and then 'BaseRoot.limit'.");
    try sema_support.assertDiagnostic(bodies, 2, "/proj/src/plain.ens", "'limit' is declared by 'Root (from "
        + "base)', and a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'import Root from base;' and then 'Root.limit'.");
    try testing.assertEqual(bodies.length, 3L);
}

test "a static read through a subclass suggests the import a file with no name for the base needs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/base.ens",
        "public class Root \{\n"
        + "    public static const int limit = 3;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Branch extends Root \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Branch from base;\n"
        + "\n"
        + "class Reader \{\n"
        + "    static const int copied = Branch.limit;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return Branch.limit;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    string expected = "'limit' is declared by 'Root', and a static is not inherited, so it is always "
        + "written with 'Root' in front. Write 'import Root from base;' and then 'Root.limit'.";
    try sema_support.assertDiagnostic(analysis.checkDiagnostics(), 0, "/proj/src/main.ens", expected);
    try testing.assertEqual(analysis.checkDiagnostics().length, 1L);
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens", expected);
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

// A base class's static that the reading code cannot use is refused for its access, with the
// spelling it takes once it can be used. Only the overloads the argument count reaches decide it, and
// overloads the count cannot tell apart are named together with what keeps each out of reach.
test "a static read through a subclass that code here cannot use is refused for its access" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/base.ens",
        "public class Root \{\n"
        + "    static const int hidden = 1;\n"
        + "    protected static const int guarded = 2;\n"
        + "\n"
        + "    static make() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    protected static make(int seed) -> int \{\n"
        + "        return seed;\n"
        + "    \}\n"
        + "\n"
        + "    static secret() -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\n"
        + "    static open() -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\n"
        + "    public static open(int seed) -> int \{\n"
        + "        return seed;\n"
        + "    \}\n"
        + "\n"
        + "    static pick(int seed) -> int \{\n"
        + "        return seed;\n"
        + "    \}\n"
        + "\n"
        + "    protected static pick(string text) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Branch extends Root \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Branch from base;\n"
        + "\n"
        + "class Reader \{\n"
        + "    static const int copied = Branch.hidden;\n"
        + "    static const int kept = Branch.guarded;\n"
        + "\}\n"
        + "\n"
        + "class Leaf extends Branch \{\n"
        + "    constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\n"
        + "    protected read() -> int \{\n"
        + "        return Branch.make() + Branch.pick(\"a\");\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return Branch.hidden + Branch.guarded + Branch.make(1) + Branch.secret() + Branch.open(1)\n"
        + "        + Branch.pick(1);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let constants = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(constants, 0, "/proj/src/main.ens", "'hidden' is private to class "
        + "'Root', so only code inside 'Root' can read it. Mark it 'public' to read it here. A static is not "
        + "inherited, so write it with 'Root' in front: 'import Root from base;' and then 'Root.hidden'.");
    try sema_support.assertDiagnostic(constants, 1, "/proj/src/main.ens", "'guarded' is 'protected' in class "
        + "'Root', so only code in the file that declares 'Root' and in subclasses of 'Root' can read it. "
        + "Mark it 'public' to read it here. A static is not inherited, so write it with 'Root' in front: "
        + "'import Root from base;' and then 'Root.guarded'.");
    try testing.assertEqual(constants.length, 2L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/main.ens", "'make()' is private to class 'Root', "
        + "so only code inside 'Root' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Root' in front: 'import Root from base;' and then 'Root.make'.");
    try sema_support.assertDiagnostic(bodies, 1, "/proj/src/main.ens", "'pick' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.pick'. Of the 'pick' methods that take 1 argument, code here can use only "
        + "'pick(string)'.");
    try sema_support.assertDiagnostic(bodies, 2, "/proj/src/main.ens", "'hidden' is private to class 'Root', "
        + "so only code inside 'Root' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Root' in front: 'import Root from base;' and then 'Root.hidden'.");
    try sema_support.assertDiagnostic(bodies, 3, "/proj/src/main.ens", "'guarded' is 'protected' in class "
        + "'Root', so only code in the file that declares 'Root' and in subclasses of 'Root' can use it. "
        + "Mark it 'public' to use it here. A static is not inherited, so write it with 'Root' in front: "
        + "'import Root from base;' and then 'Root.guarded'.");
    try sema_support.assertDiagnostic(bodies, 4, "/proj/src/main.ens", "'make(int)' is 'protected' in class "
        + "'Root', so only code in the file that declares 'Root' and in subclasses of 'Root' can use it. "
        + "Mark it 'public' to use it here. A static is not inherited, so write it with 'Root' in front: "
        + "'import Root from base;' and then 'Root.make'.");
    try sema_support.assertDiagnostic(bodies, 5, "/proj/src/main.ens", "'secret' is private to class 'Root', "
        + "so only code inside 'Root' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Root' in front: 'import Root from base;' and then 'Root.secret'.");
    try sema_support.assertDiagnostic(bodies, 6, "/proj/src/main.ens", "'open' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.open'.");
    try sema_support.assertDiagnostic(bodies, 7, "/proj/src/main.ens", "None of the 'pick' methods of class "
        + "'Root' that take 1 argument can be used here: 'pick(int)' is private to 'Root' and 'pick(string)' "
        + "is 'protected' in 'Root'. Mark the one you want to use 'public'. A static is not inherited, so "
        + "write it with 'Root' in front: 'import Root from base;' and then 'Root.pick'.");
    try testing.assertEqual(bodies.length, 8L);
}

// Type arguments on the head are refused only once the member is a static const of that type; a
// member the head's class does not declare is refused for what it is first.
test "a static const initializer refuses type arguments only on a static const of the head" {
    let analysis = sema_support.analyzeProgram(
        "class Root \{\n"
        + "    static const int limit = 1;\n"
        + "\}\n"
        + "class Sub<T> extends Root \{\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    static const int size = 2;\n"
        + "\}\n"
        + "class Reader \{\n"
        + "    static const int inherited = Sub<int>.limit;\n"
        + "    static const int missing = Holder<int>.nothing;\n"
        + "    static const int argued = Holder<int>.size;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let reported = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'limit' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'Root.limit'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "The initializer of static const "
        + "'Reader.missing' must be a compile-time constant, but 'Holder.nothing' is not a static const. A "
        + "constant is built from literals, '+', '-', '*', '/', '%', string concatenation and other static "
        + "consts read through their type name.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "A static const never depends on "
        + "type arguments. Read it through the plain type name, as 'Holder.size'.");
    try testing.assertEqual(reported.length, 3L);
}

// A head that declares no statics is refused for what it is: an interface or an external type as a
// body refuses it, an enum by its members, and any other name as one this file cannot name.
test "a static const initializer names what a head without statics is" {
    let analysis = sema_support.analyzeProgram(
        "interface Speaker \{\n"
        + "    speak() -> int;\n"
        + "\}\n"
        + "enum Color \{\n"
        + "    Red,\n"
        + "\}\n"
        + "external type Handle;\n"
        + "class Reader \{\n"
        + "    static const int spoken = Speaker.limit;\n"
        + "    static const int held = Handle.limit;\n"
        + "    static const int missing = Color.limit;\n"
        + "    static const int red = Color.Red;\n"
        + "    static const int nowhere = Nowhere.limit;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let reported = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'Speaker' is an interface, and an "
        + "interface has no static members. Call 'limit' on a value of a class that implements 'Speaker'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'Handle' is an external type, and "
        + "an external type has no members, because its contents belong to the C library.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "The initializer of static const "
        + "'Reader.missing' must be a compile-time constant, but 'limit' is not a member of enum 'Color'. A "
        + "constant is built from literals, '+', '-', '*', '/', '%', string concatenation and other static "
        + "consts read through their type name.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "The initializer of static const "
        + "'Reader.red' must be a compile-time constant, but 'Color.Red' is a member of enum 'Color', and a "
        + "static const can only have a number type, 'char', 'bool' or 'string'. A constant is built from "
        + "literals, '+', '-', '*', '/', '%', string concatenation and other static consts read through "
        + "their type name.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", "The initializer of static const "
        + "'Reader.nowhere' must be a compile-time constant, but 'Nowhere' is not a class or struct this "
        + "file can name. A constant is built from literals, '+', '-', '*', '/', '%', string concatenation "
        + "and other static consts read through their type name.");
    try testing.assertEqual(reported.length, 5L);
}

// A head is named the way the reading file names it, a value of an external type has no members, and
// a read of a base class's static methods through a subclass is spelled as the call it has to be.
test "a refusal of a head or a static method read names what the reading file can write" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/base.ens",
        "public interface Speaker \{\n"
        + "    speak() -> int;\n"
        + "\}\n"
        + "\n"
        + "public external type Handle;\n"
        + "\n"
        + "public class Root \{\n"
        + "    static pick(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    protected static pick(string text) -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    public static pick(bool flag) -> int \{\n"
        + "        return 2;\n"
        + "    \}\n"
        + "\n"
        + "    static three(int a) -> int \{\n"
        + "        return a;\n"
        + "    \}\n"
        + "\n"
        + "    protected static three(string b) -> int \{\n"
        + "        return 3;\n"
        + "    \}\n"
        + "\n"
        + "    public static make() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\n"
        + "    static hidden() -> int \{\n"
        + "        return 5;\n"
        + "    \}\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "\n"
        + "public class Branch extends Root \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Speaker as Talker from base;\n"
        + "import Handle as Port from base;\n"
        + "import Branch from base;\n"
        + "\n"
        + "class Reader \{\n"
        + "    static const int spoken = Talker.limit;\n"
        + "    static const int held = Port.limit;\n"
        + "    static const int made = Branch.make;\n"
        + "\}\n"
        + "\n"
        + "use(Port h) -> int \{\n"
        + "    let f = Branch.pick;\n"
        + "    let g = Branch.three;\n"
        + "    let k = Branch.make;\n"
        + "    let m = Branch.hidden;\n"
        + "    return Talker.limit + Port.limit + h.size + h.limit();\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let constants = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(constants, 0, "/proj/src/main.ens", "'Talker' is an interface, and an "
        + "interface has no static members. Call 'limit' on a value of a class that implements 'Talker'.");
    try sema_support.assertDiagnostic(constants, 1, "/proj/src/main.ens", "'Port' is an external type, and "
        + "an external type has no members, because its contents belong to the C library.");
    try sema_support.assertDiagnostic(constants, 2, "/proj/src/main.ens", "The initializer of static const "
        + "'Reader.made' must be a compile-time constant, but 'Branch.make' is not a static const. A "
        + "constant is built from literals, '+', '-', '*', '/', '%', string concatenation and other static "
        + "consts read through their type name.");
    try testing.assertEqual(constants.length, 3L);
    let bodies = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(bodies, 0, "/proj/src/main.ens", "'pick' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.pick(...)'. Of the 'pick' methods, code here can use only 'pick(bool)'.");
    try sema_support.assertDiagnostic(bodies, 1, "/proj/src/main.ens", "None of the 'three' methods of class "
        + "'Root' can be used here: 'three(int)' is private to 'Root' and 'three(string)' is 'protected' in "
        + "'Root'. Mark the one you want to use 'public'. A static is not inherited, so write it with 'Root' "
        + "in front: 'import Root from base;' and then 'Root.three(...)'.");
    try sema_support.assertDiagnostic(bodies, 2, "/proj/src/main.ens", "'make' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.make()'.");
    try sema_support.assertDiagnostic(bodies, 3, "/proj/src/main.ens", "'hidden' is private to class 'Root', "
        + "so only code inside 'Root' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Root' in front: 'import Root from base;' and then 'Root.hidden()'.");
    try sema_support.assertDiagnostic(bodies, 4, "/proj/src/main.ens", "'Talker' is an interface, and an "
        + "interface has no static members. Call 'limit' on a value of a class that implements 'Talker'.");
    try sema_support.assertDiagnostic(bodies, 5, "/proj/src/main.ens", "'Port' is an external type, and an "
        + "external type has no members, because its contents belong to the C library.");
    try sema_support.assertDiagnostic(bodies, 6, "/proj/src/main.ens", "Cannot use a member of 'Port' "
        + "because it has no members: an external type's contents belong to the C library. Pass 'h' to a C "
        + "function instead.");
    try sema_support.assertDiagnostic(bodies, 7, "/proj/src/main.ens", "Cannot use a member of 'Port' "
        + "because it has no members: an external type's contents belong to the C library. Pass 'h' to a C "
        + "function instead.");
    try testing.assertEqual(bodies.length, 8L);
}

// A static method of a generic base is written behind the instantiation the subclass extends, two levels
// up and through a generic subclass alike, while a static const and a base whose type arguments are the
// subclass's own type parameters keep the plain name.
test "a generic base's static method is written with the type arguments a subclass gives it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Root<T> \{\n"
        + "    static make() -> T? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\n"
        + "    static wrap(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    static const int limit = 3;\n"
        + "\}\n"
        + "\n"
        + "class Branch extends Root<int> \{\n"
        + "\}\n"
        + "\n"
        + "class Leaf extends Branch \{\n"
        + "\}\n"
        + "\n"
        + "class Mid<U> extends Root<U> \{\n"
        + "\}\n"
        + "\n"
        + "use() -> int \{\n"
        + "    let a = Branch.make;\n"
        + "    let b = Branch.wrap;\n"
        + "    let c = Branch.make();\n"
        + "    let d = Leaf.make;\n"
        + "    let e = Mid<string>.make();\n"
        + "    let f = Mid.wrap(\"x\");\n"
        + "    let g = Leaf.limit;\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'Root<int>.make()'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'Root<int>.wrap(...)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'Root<int>.make'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'Root<int>.make()'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write "
        + "'Root<string>.make'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'Root.wrap'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", "'limit' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'Root.limit'.");
    try testing.assertEqual(reported.length, 7L);
}

// The spelling of a generic base's static method imports the base and every type argument the reading
// file has no name for, under a name the file does not bind already.
test "a generic base's static method is written after imports for the base and its type arguments" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/base.ens",
        "public class Root<T> \{\n"
        + "    public static make() -> T? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\n"
        + "    public static wrap(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    public static const int limit = 3;\n"
        + "\}\n");
    loader.add("/proj/src/shapes.ens",
        "public class Widget \{\n"
        + "\}\n"
        + "\n"
        + "public class Gadget \{\n"
        + "\}\n");
    loader.add("/proj/src/kinds.ens",
        "import Root from base;\n"
        + "import Widget from shapes;\n"
        + "\n"
        + "public class WidgetRoot extends Root<Widget> \{\n"
        + "\}\n"
        + "\n"
        + "public class LongRoot extends Root<long> \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import WidgetRoot from kinds;\n"
        + "import LongRoot from kinds;\n"
        + "import Gadget as Widget from shapes;\n"
        + "\n"
        + "use() -> int \{\n"
        + "    let a = WidgetRoot.make();\n"
        + "    let b = WidgetRoot.make;\n"
        + "    let c = LongRoot.wrap;\n"
        + "    let d = LongRoot.limit;\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;', 'import Widget as ShapesWidget from shapes;' and then 'Root<ShapesWidget>.make'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;', 'import Widget as ShapesWidget from shapes;' and then 'Root<ShapesWidget>.make()'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root<long>.wrap(...)'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "'limit' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.limit'.");
    try testing.assertEqual(reported.length, 4L);
}

// Where a function type is expected, a base's static method read through a subclass is written as a
// lambda of that type. The function type selects the overloads, so access is judged on the ones it
// selects, and a type that no overload fits, or that lists nothing the method throws, is named.
test "a static method a subclass reaches where a function type is expected is written as a lambda" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/errors.ens",
        "public class FarError extends Error \{\n"
        + "    public constructor() \{\n"
        + "        super(\"far\");\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/base.ens",
        "import FarError from errors;\n"
        + "\n"
        + "public class Root<T> \{\n"
        + "    public static make() -> T? \{\n"
        + "        return null;\n"
        + "    \}\n"
        + "\n"
        + "    public static wrap(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    public static far() -> int throws FarError \{\n"
        + "        throw new FarError();\n"
        + "    \}\n"
        + "\n"
        + "    public static const int limit = 3;\n"
        + "\}\n"
        + "\n"
        + "public class Guard \{\n"
        + "    static pick(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    public static pick(bool flag) -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\n"
        + "    static hidden(int value) -> int \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/kinds.ens",
        "import Root from base;\n"
        + "import Guard from base;\n"
        + "\n"
        + "public class Branch extends Root<int> \{\n"
        + "\}\n"
        + "\n"
        + "public class Keeper extends Guard \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Branch from kinds;\n"
        + "import Keeper from kinds;\n"
        + "\n"
        + "apply((int) -> int f) -> int \{\n"
        + "    return f(1);\n"
        + "\}\n"
        + "\n"
        + "flag((bool) -> int f) -> int \{\n"
        + "    return f(true);\n"
        + "\}\n"
        + "\n"
        + "maybe(() -> int? f) -> int \{\n"
        + "    return f() ?? 0;\n"
        + "\}\n"
        + "\n"
        + "text((string) -> string f) -> string \{\n"
        + "    return f(\"a\");\n"
        + "\}\n"
        + "\n"
        + "use() -> int \{\n"
        + "    int a = maybe(Branch.make);\n"
        + "    int b = apply(Branch.wrap);\n"
        + "    int c = apply(Keeper.pick);\n"
        + "    int d = flag(Keeper.pick);\n"
        + "    int e = apply(Keeper.hidden);\n"
        + "    string f = text(Branch.wrap);\n"
        + "    int g = maybe(Branch.far);\n"
        + "    int h = apply(Branch.limit);\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'make' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '() -> "
        + "Root<int>.make()'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '(value) -> "
        + "Root<int>.wrap(value)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", "'pick(int)' is private to class "
        + "'Guard', so only code inside 'Guard' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Guard' in front. A method's name is not a value, so write a lambda "
        + "that calls it: 'import Guard from base;' and then '(value) -> Guard.pick(value)'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", "'pick' is declared by 'Guard', and "
        + "a static is not inherited, so it is always written with 'Guard' in front. A method's name is not "
        + "a value, so write a lambda that calls it: 'import Guard from base;' and then '(flag) -> "
        + "Guard.pick(flag)'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens", "'hidden' is private to class "
        + "'Guard', so only code inside 'Guard' can use it. Mark it 'public' to use it here. A static is not "
        + "inherited, so write it with 'Guard' in front. A method's name is not a value, so write a lambda "
        + "that calls it: 'import Guard from base;' and then '(value) -> Guard.hidden(value)'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", "'wrap' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value. A function of type '(string) -> string' takes a 'string' and returns a 'string', and no "
        + "'wrap' method does.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", "'far' is declared by 'Root', and a "
        + "static is not inherited, so it is always written with 'Root' in front. A method's name is not a "
        + "value, so write a lambda that calls it: 'import Root from base;' and then '() -> try "
        + "Root<int>.far()'. The function type it is given to, '() -> int?', must also list what 'far' "
        + "throws.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens", "'limit' is declared by 'Root', and "
        + "a static is not inherited, so it is always written with 'Root' in front. Write 'import Root from "
        + "base;' and then 'Root.limit'.");
    try testing.assertEqual(reported.length, 8L);
}

test "a static const evaluates across modules in dependency order" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public class Config \{\n"
        + "    public static const int width = 6;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Config from lib;\n"
        + "public class Screen \{\n"
        + "    public static const int total = Config.width * 7;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Screen.total - 42;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
    let screen = try sema_support.classNamed(analysis, "main", "Screen");
    let total = screen.staticFields().get(0).constantValue();
    try testing.assertTrue(total != null, "'total' should have evaluated");
    if (total != null) {
        try testing.assertEqual(total.integerBits(), 42L);
    }
}

test "a lazy const lands beside the statics and takes no compile-time value" {
    let analysis = try sema_support.analyzeOne(
        "public class Reader \{\n"
        + "    public const string text;\n"
        + "\n"
        + "    public constructor(this.text);\n"
        + "\}\n"
        + "makeReader() -> Reader \{\n"
        + "    return new Reader(\"in\");\n"
        + "\}\n"
        + "public class Streams \{\n"
        + "    public lazy const Reader input = makeReader();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Streams.input.text.length as int;\n"
        + "\}\n");
    try sema_support.assertProgramClean(analysis);
    let streams = try sema_support.classNamed(analysis, "main", "Streams");
    try testing.assertEqual(streams.fields().length(), 0L);
    try testing.assertEqual(streams.staticFields().length(), 1L);
    let input = streams.staticFields().get(0);
    try testing.assertTrue(input.isLazy(), "the lazy marker must reach the model");
    try testing.assertTrue(!input.isStatic(), "'lazy' is not 'static'");
    try testing.assertTrue(input.constantValue() == null,
        "a lazy const holds no compile-time value");
}

test "a lazy const field refuses 'static', a missing 'const', and a missing initializer" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Refused \{\n"
        + "    public static lazy const long both = 1;\n"
        + "    public lazy long unmarked = 2;\n"
        + "    public lazy const long missing;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let reported = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "A 'lazy const' field already belongs to the type itself, so it cannot also be 'static'. "
        + "Remove 'static'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "A 'lazy' field must also be 'const'; its value is built once on the first read and "
        + "never changes. Write 'lazy const long unmarked = ...', or make 'unmarked' an "
        + "instance field.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Lazy const 'missing' needs its value on the declaration, because nothing else ever "
        + "assigns it. Write 'lazy const long missing = ...'.");
    try testing.assertEqual(reported.length, 3L);
}

test "two lazy const initializers that read each other close a cycle" {
    let analysis = sema_support.analyzeProgram(
        "public class Cycle \{\n"
        + "    public lazy const long first = Cycle.second + 1;\n"
        + "    public lazy const long second = Cycle.first + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return Cycle.first as int;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    try sema_support.assertDiagnostic(analysis.checkDiagnostics(), 0, "/proj/src/main.ens",
        "'Cycle.second' cannot take its value from 'Cycle.first': the lazy consts between them "
        + "form a cycle. Build one of the two without reading the other.");
    try testing.assertEqual(analysis.checkDiagnostics().length, 1L);
}

test "a lazy const initializer may not throw and its value never takes an assignment" {
    let analysis = sema_support.analyzeProgram(
        "class Boom extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "risky() -> long throws \{\n"
        + "    throw new Boom(\"no\");\n"
        + "\}\n"
        + "public class Refused \{\n"
        + "    public lazy const long value = risky();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Refused.value = 3;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies, Stage.Exceptions]);
    try sema_support.assertDiagnostic(analysis.exceptionDiagnostics(), 0, "/proj/src/main.ens",
        "The initializer of lazy const 'Refused.value' calls 'risky', which can throw 'Boom'. A "
        + "lazy const is read without 'try', so its initializer must not throw. Move the call into "
        + "a function that catches 'Boom' with a 'catch' clause, and call that function here.");
    try testing.assertEqual(analysis.exceptionDiagnostics().length, 1L);
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot assign to 'Refused.value': a lazy const keeps the value its initializer gives it. "
        + "Change the initializer, or use an instance field.");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

// One 'lazy const' value is shared by every type argument, so its initializer cannot use a type
// parameter, whether the parameter is written as a type argument or stands where a value
// belongs. The refusal names the instance field that carries one value per instance instead.
test "a lazy const initializer refuses a type parameter written as a type or as a value" {
    let analysis = sema_support.analyzeProgram(
        "zeroOf<Value>() -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "public class Box<T> \{\n"
        + "    public lazy const long fromType = zeroOf<T>();\n"
        + "    public lazy const long fromValue = T;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The initializer of lazy const 'Box.fromType' cannot use a type parameter, because "
        + "one lazy const value is shared by every type argument of 'Box'. Remove 'lazy const' to give each "
        + "instance its own 'fromType'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The initializer of lazy const 'Box.fromValue' cannot use a type parameter, because "
        + "one lazy const value is shared by every type argument of 'Box'. Remove 'lazy const' to give each "
        + "instance its own 'fromValue'.");
    try testing.assertEqual(reported.length, 2L);
}

// A static const is one value for every type argument as well, so its initializer refuses a
// type parameter for the same reason, whether the name stands alone or heads a member read.
test "a static const initializer refuses a type parameter as a name and as a head" {
    let analysis = sema_support.analyzeProgram(
        "public class Box<T> \{\n"
        + "    public static const int limit = 8;\n"
        + "    public static const int shared = T;\n"
        + "    public static const int reached = T.limit;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let reported = analysis.checkDiagnostics();
    string constantRule = " A constant is built from literals, '+', '-', '*', '/', '%', "
        + "string concatenation and other static consts read through their type name.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The initializer of static const 'Box.shared' must be a compile-time constant, but "
        + "'T' is a type parameter, and a static const of 'Box' has one value for every choice "
        + "of 'T'." + constantRule);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The initializer of static const 'Box.reached' must be a compile-time constant, but "
        + "'T' is a type parameter, and a static const of 'Box' has one value for every choice "
        + "of 'T'." + constantRule);
    try testing.assertEqual(reported.length, 2L);
}

test "a throwing static factory demands 'try' at its call sites" {
    let analysis = sema_support.analyzeProgram(
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Parsed \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static parse(string text) -> Parsed throws \{\n"
        + "        if (text.length == 0) \{\n"
        + "            throw new Failure(\"empty\");\n"
        + "        \}\n"
        + "        return new Parsed();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let parsed = Parsed.parse(\"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Exceptions]);
    try sema_support.assertDiagnostic(analysis.exceptionDiagnostics(), 0, "/proj/src/main.ens",
        "Call to 'parse' can throw 'Failure'. Prefix it with 'try', and either catch it with a "
        + "'catch' clause or mark this function 'throws'.");
    try testing.assertEqual(analysis.exceptionDiagnostics().length, 1L);
}

// A name the file does not have is imported from the standard library module that declares it, when
// the program has that module. A value, a function and a type that is not generic each get their own
// refusal.
test "type arguments after a name that is no generic type name what the name is" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/lists.ens", "import List from @std.collections.list;\n"
        + "\n"
        + "public empty() -> List<int> \{\n"
        + "    return new List<int>();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import lists;\n"
        + "\n"
        + "class Widget \{\n"
        + "\}\n"
        + "\n"
        + "helper() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    let a = List<int>.withCapacity(8);\n"
        + "    let b = Missing<int>.make();\n"
        + "    Widget w = new Widget();\n"
        + "    let c = w<int>.make();\n"
        + "    let d = helper<int>.make();\n"
        + "    let e = Widget<int>.make();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Undefined name 'List'. Check the spelling, or import it, as in 'import List from "
        + "@std.collections.list;'.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Undefined name 'Missing'. Check the spelling, or import it.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'w' is a value, not a type, so it cannot take type arguments.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'helper' is a function, not a type, so it cannot take type arguments.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "Type 'Widget' is not generic, so it takes no type arguments. Remove '<int>'.");
    try testing.assertEqual(reported.length, 5L);
}
