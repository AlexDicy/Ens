import @std.testing;
import sema_support;

// The refusal of a floating-point literal too large for a 'float' names the value or parameter
// that sets its type. At a declaration, the fix declares the variable as 'double'.
test "a literal too large for 'float' names where it takes its type from" {
    let analysis = try sema_support.analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "floats(float f, float? g) \{\n"
        + "    double a = f + 3.5e38;\n"
        + "    bool b = 3.5e38 > f;\n"
        + "    double c = g ?? 1e300;\n"
        + "    takesFloat(3.5e38);\n"
        + "    float d = 3.5e38;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from 'f', a 'float'. Convert 'f' first ('f as double + 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from 'f', a 'float'. Convert 'f' first ('3.5e38 > f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 1e300 {large} The literal takes its "
        + "type from the value of 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from parameter 'value' of 'takesFloat', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 {large} Declare 'd' as 'double' "
        + "instead.");
    try testing.assertEqual(reported.length, 5L);
}

// A literal in a '?:' or a switch beside a value with a floating-point type of its own takes that
// value's type. Under a 'float' declaration, the fix also declares the variable as 'double'. When
// every branch is a literal, the literal has the target's type.
test "a literal too large for 'float' in a join names the branch it takes its type from" {
    let analysis = try sema_support.analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "joins(float f, float? g, bool flag, int k) \{\n"
        + "    float a = flag ? f : 3.5e38;\n"
        + "    float b = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    takesFloat(flag ? f : 3.5e38);\n"
        + "    float? c = g ?? (flag ? f : 3.5e38);\n"
        + "    float d = flag ? 1.5 : 3.5e38;\n"
        + "    takesFloat(switch (k) \{\n"
        + "        0 -> 1.5,\n"
        + "        default -> 3.5e38,\n"
        + "    \});\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "{large} The literal takes its type from 'f', a "
        + "'float'. Declare 'a' as 'double' and convert 'f' ('double a = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "{large} The literal takes its type from 'f', a "
        + "'float'. Declare 'b' as 'double' and convert 'f' ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "{large} The literal takes its type from 'f', a "
        + "'float', and parameter 'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "{large} The literal takes its type from 'f', a "
        + "'float', and the value of 'g' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 4, file, "{large} Declare 'd' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 5, file, "{large} The literal takes its type from "
        + "parameter 'value' of 'takesFloat', a 'float'.");
    try testing.assertEqual(reported.length, 6L);
}

// The fix for a literal too large for 'float' beside a 'float' literal removes that literal's
// suffix, which makes both values 'double'. Under a 'float' declaration, the fix also declares the
// variable as 'double'.
test "a literal too large for 'float' beside a 'float' literal removes the suffix" {
    let analysis = try sema_support.analyzeOne("suffixes(bool flag) \{\n"
        + "    let p = flag ? 1.5f : 3.5e38;\n"
        + "    double q = flag ? 3.5e38 : -1.5F;\n"
        + "    double s = 1.5f + 3.5e38;\n"
        + "    float r = flag ? 1.5f : 3.5e38;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "{large} The literal takes its type from "
        + "'1.5f', a 'float'. Remove the 'f' from '1.5f' so that both branches are 'double'.");
    try sema_support.assertDiagnostic(reported, 1, file, "{large} The literal takes its type from "
        + "'-1.5F', a 'float'. Remove the 'F' from '-1.5F' so that both branches are 'double'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{large} The literal takes its type from "
        + "'1.5f', a 'float'. Remove the 'f' from '1.5f' so that both sides are 'double'.");
    try sema_support.assertDiagnostic(reported, 3, file, "{large} The literal takes its type from '1.5f', "
        + "a 'float'. Declare 'r' as 'double' and remove the 'f' from '1.5f'.");
    try testing.assertEqual(reported.length, 4L);
}

// The refusal of a literal too large for 'float' names the declaration to change to 'double': a variable,
// a field, a parameter, an array or a return type. In a join, the fix also converts the value beside
// the literal.
test "a literal too large for 'float' names the declaration to change" {
    let analysis = try sema_support.analyzeOne("class Holder \{\n"
        + "    float f = 1.0f;\n"
        + "    float g = 3.5e38;\n"
        + "    float joined = true ? f : 3.5e38;\n"
        + "    lazy const float shared = 3.5e38;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "apply(() -> float make) -> float \{\n"
        + "    return make();\n"
        + "\}\n"
        + "\n"
        + "giveBack() -> float \{\n"
        + "    return 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "scaled(float f, bool flag) -> float \{\n"
        + "    return flag ? f : 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "defaulted(float limit = 3.5e38) -> float \{\n"
        + "    return limit;\n"
        + "\}\n"
        + "\n"
        + "forms(Holder h, float f, float? g, bool flag, float[] values, int k) \{\n"
        + "    float local = 1.0f;\n"
        + "    local = 3.5e38;\n"
        + "    h.f = 3.5e38;\n"
        + "    values[0] = 3.5e38;\n"
        + "    float[] listed = [3.5e38];\n"
        + "    () -> float make = () -> 3.5e38;\n"
        + "    () -> float block = () -> \{\n"
        + "        return 3.5e38;\n"
        + "    \};\n"
        + "    apply(() -> 3.5e38);\n"
        + "    float? c = flag ? f : 3.5e38;\n"
        + "    local = flag ? f : 3.5e38;\n"
        + "    values[1] = flag ? f : 3.5e38;\n"
        + "    () -> float joinedMake = () -> flag ? f : 3.5e38;\n"
        + "    float n1 = flag ? g : 3.5e38;\n"
        + "    float x3 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    let x4 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        1 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    let x5 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'g' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'joined' "
        + "as 'double' and convert 'f' ('double joined = true ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'shared' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'giveBack' to 'double'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('return flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'limit' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'local' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'values' as 'double[]' instead.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'listed' as 'double[]' instead.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'make' to 'double'.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'block' to 'double'.");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'c' as "
        + "'double?' and convert 'f' ('double? c = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'local' "
        + "as 'double' and convert 'f' ('local = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 15, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'values' "
        + "as 'double[]' and convert 'f' ('values[1] = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 16, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'joinedMake' to 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 17, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 18, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Declare 'x3' "
        + "as 'double' and remove the 'f' from '1.5f'.");
    try sema_support.assertDiagnostic(reported, 19, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Convert "
        + "'1.5f' first ('0 -> 1.5f as double').");
    try sema_support.assertDiagnostic(reported, 20, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Remove the "
        + "'f' from '1.5f' so that both arms are 'double'.");
    try testing.assertEqual(reported.length, 21L);
}

// An operand literal too large for 'float' under a declaration gets the same fix as a literal in a join.
// A result stored back through a cast spells the whole cast, and a parameter of a constructor names
// its type.
test "an operand literal too large for 'float' names the declaration to change" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    float size;\n"
        + "    int total = 0;\n"
        + "\n"
        + "    constructor(this.size);\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    float x;\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "scaled(float f) -> float \{\n"
        + "    return f * 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "operands(float f, float? g, float[] values, long wide, Box box, int[]? xs, Box? mb) -> int \{\n"
        + "    float x11 = f * 3.5e38;\n"
        + "    float x13 = 3.5e38 - 1.5f;\n"
        + "    f += f * 3.5e38;\n"
        + "    values[0] = f * 3.5e38;\n"
        + "    takesFloat(f * 3.5e38);\n"
        + "    float h = g ?? f * 3.5e38;\n"
        + "    int total = 0;\n"
        + "    total += wide * 2;\n"
        + "    total += wide;\n"
        + "    box.total += wide;\n"
        + "    let made = new Box(3.5e38);\n"
        + "    Pair p = \{x: 3.5e38\};\n"
        + "    double big = 1.8e308;\n"
        + "    double low = -1.8e308;\n"
        + "    return xs?[0] + mb?.total;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('return f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'x11' "
        + "as 'double' and convert 'f' ('double x11 = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Declare "
        + "'x13' as 'double' and remove the 'f' from '1.5f'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f += f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare "
        + "'values' as 'double[]' and convert 'f' ('values[0] = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float', and parameter "
        + "'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float', and the value "
        + "of 'g' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 7, file, "Cannot store the result of '+=' back into "
        + "'total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write '(wide * 2) as "
        + "int', or declare 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Cannot store the result of '+=' back into "
        + "'total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write 'wide as int', or "
        + "declare 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Cannot store the result of '+=' back into "
        + "'box.total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write 'wide as int', "
        + "or declare field 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from parameter 'size' of the "
        + "constructor of 'Box', a 'float'.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare field 'x' of 'Pair' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 1.8e308 is too large for 'double', "
        + "whose largest value is about 1.797e308.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal -1.8e308 is below the smallest value of "
        + "'double', which is about -1.797e308.");
    try sema_support.assertDiagnostic(reported, 14, file, "'+' needs numbers on both sides, but 'xs?[0]' "
        + "and 'mb?.total' both have type 'int?'. 'xs?[0]' is null whenever 'xs' is null, and 'mb?.total' "
        + "whenever 'mb' is null. Check both for null first ('if (xs != null && mb != null)') and write "
        + "'xs[0] + mb.total', or supply fallbacks with '??'.");
    try testing.assertEqual(reported.length, 15L);
}

// A literal too large for 'float' in a chain of operators, under a sign or in a join is refused with
// the declaration to change. When the operand is the place written, the declaration is the whole
// fix, and a 'float' literal loses its suffix.
test "a literal too large for 'float' deep in an operand or with a suffix names the declaration" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    float size = 1.0;\n"
        + "\n"
        + "    constructor();\n"
        + "\n"
        + "    grow() \{\n"
        + "        this.size = this.size * 3.5e38;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "scaled(float f) -> float \{\n"
        + "    return f * 3.5e38 + 1.0;\n"
        + "\}\n"
        + "\n"
        + "nested(float f, float? g, bool flag) \{\n"
        + "    float x5 = f + 3.5e38 + 1.0;\n"
        + "    float n1 = -(f * 3.5e38);\n"
        + "    float n3 = f * (flag ? f : 3.5e38);\n"
        + "    float n4 = flag ? f * 3.5e38 : 1.0;\n"
        + "    f = f + 3.5e38;\n"
        + "    f += f * 3.5e38;\n"
        + "    float y = 3.5e38f;\n"
        + "    double y2 = 3.5e38f;\n"
        + "    double x2 = f * 3.5e38f;\n"
        + "    float x3 = f * 3.5e38f;\n"
        + "    takesFloat(3.5e38f);\n"
        + "    float y4 = g ?? 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'this.size', a 'float'. "
        + "Declare 'size' as 'double' ('this.size = this.size * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'x5' "
        + "as 'double' and convert 'f' ('f as double + 3.5e38').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n1' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n3' "
        + "as 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n4' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f = f + 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f += f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'y' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'f' ('f as double * "
        + "3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'x3' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'f' ('double x3 = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and the value of 'g' is a "
        + "'float' too.");
    try testing.assertEqual(reported.length, 14L);
}

// A switch inside an operand, an operand inside an arm and a nested switch get the fix of the
// declaration. A 'float' literal beside a 'float' branch or arm loses its suffix and the branch is
// converted, unless the branch reads the place written.
test "a switch in an operand and a 'float' literal beside a 'float' branch name the declaration" {
    let analysis = try sema_support.analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "forms(float f, float g, float? h, bool flag, int k) \{\n"
        + "    float s2 = f + switch (k) \{\n"
        + "        0 -> f * 3.5e38,\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float s3 = f + switch (k) \{\n"
        + "        0 -> flag ? f : 3.5e38,\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float s4 = f * switch (k) \{\n"
        + "        0 -> switch (k) \{\n"
        + "            1 -> f,\n"
        + "            default -> 3.5e38,\n"
        + "        \},\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float t1 = flag ? g : 3.5e38f;\n"
        + "    double t2 = flag ? g : 3.5e38f;\n"
        + "    let t3 = flag ? 3.5e38f : g;\n"
        + "    float t4 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let t5 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    takesFloat(3.5e38f);\n"
        + "    takesFloat(g * 3.5e38f);\n"
        + "    float y4 = h ?? 3.5e38f;\n"
        + "    f = 3.5e38f * f;\n"
        + "    f = -f * 3.5e38;\n"
        + "    f = f + 1.0 + 3.5e38;\n"
        + "    f = flag ? f : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's2' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's3' "
        + "as 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's4' "
        + "as 'double' and convert 'f' ('1 -> f as double').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't1' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('double t1 = flag ? g as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('flag ? g as "
        + "double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('flag ? 3.5e38 "
        + ": g as double').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't4' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('0 -> g as double').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('0 -> g as "
        + "double').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and the value of 'h' is a "
        + "'float' too.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' and remove the 'f' from '3.5e38f' ('f "
        + "= 3.5e38 * f;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '-f', a 'float'. Declare 'f' "
        + "as 'double' ('f = -f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f + 1.0', a 'float'. Declare "
        + "'f' as 'double' ('f = f + 1.0 + 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' and remove the 'f' from '3.5e38f' ('f "
        + "= flag ? f : 3.5e38;').");
    try testing.assertEqual(reported.length, 15L);
}

// A 'float' literal too large for 'float' beside a nullable value gets no conversion, and two such
// literals get one fix each. Beside a 'float' literal that fits, both lose their suffix.
test "a 'float' literal beside a nullable, a pending or a 'float' literal branch gets its own fix" {
    let analysis = try sema_support.analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    let a = flag ? h : 3.5e38f;\n"
        + "    float? b = flag ? h : 3.5e38f;\n"
        + "    let c = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let e = h * 3.5e38f;\n"
        + "    let p = flag ? 3.5e38f : 3.5e38f;\n"
        + "    float p2 = flag ? 3.5e38f : 3.5e38f;\n"
        + "    float t8 = flag ? 1.5f : 3.5e38f;\n"
        + "    let t9 = flag ? 1.5f : 3.5e38f;\n"
        + "    let t10 = flag ? 1.5F : 3.5e38f;\n"
        + "    let t11 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    float t12 = 1.5f * 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'*' needs numbers on both sides, but 'h' has "
        + "type 'float?'. Check 'h' for null first ('if (h != null)').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'p2' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'p2' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't8' as 'double' and remove the 'f' from '3.5e38f' and "
        + "from '1.5f' ('double t8 = flag ? 1.5 : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('flag ? 1.5 : "
        + "3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and the 'F' from '1.5F' ('flag ? "
        + "1.5 : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('0 -> 1.5').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't12' as 'double' and remove the 'f' from '3.5e38f' "
        + "and from '1.5f' ('double t12 = 1.5 * 3.5e38;').");
    try testing.assertEqual(reported.length, 14L);
}

// A 'float' literal among arms with a 'float' value converts that value, whichever arm comes first.
// Beside a nullable 'float' branch, a join or operator in the other branch gets no conversion.
test "a 'float' literal beside a nullable branch or several typed arms gets a fix that compiles" {
    let analysis = try sema_support.analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    float c8 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        1 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    float c19 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        1 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let c7 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let c11 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    float? c16 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    let c20 = flag ? h : (flag ? g : 3.5e38f);\n"
        + "    let c21 = flag ? h : g * 3.5e38;\n"
        + "    let c22 = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> flag ? g : 3.5e38,\n"
        + "    \};\n"
        + "    let c15 = flag ? (1.5f) : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'c8' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('1 -> g as double').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'c19' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('0 -> g as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('0 -> 1.5').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('flag ? 1.5 : "
        + "3.5e38').");
    try testing.assertEqual(reported.length, 9L);
}

// Beside a nullable 'float' branch or arm, no conversion gives a join a common type, so a join or
// operator on either side of it gets no conversion. The refusal is settled once every branch is known.
test "a join or operator beside a nullable 'float' branch ends after the why in either order" {
    let analysis = try sema_support.analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    let c11 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    let d11 = flag ? (flag ? g : 3.5e38) : h;\n"
        + "    float? c16 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    float? d16 = flag ? (flag ? g : 3.5e38) : h;\n"
        + "    let c20 = flag ? h : (flag ? g : 3.5e38f);\n"
        + "    let d20 = flag ? (flag ? g : 3.5e38f) : h;\n"
        + "    let c21 = flag ? h : g * 3.5e38;\n"
        + "    let d21 = flag ? g * 3.5e38 : h;\n"
        + "    let c22 = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> flag ? g : 3.5e38,\n"
        + "    \};\n"
        + "    let d22 = switch (k) \{\n"
        + "        0 -> flag ? g : 3.5e38,\n"
        + "        default -> h,\n"
        + "    \};\n"
        + "    let e1 = flag ? (flag ? g : 3.5e38) : g;\n"
        + "    let e2 = flag ? 1.0 : (flag ? (flag ? g : 3.5e38) : h);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('flag ? g as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try testing.assertEqual(reported.length, 12L);
}

// An argument, an index and a '??' fallback are checked against their own target, so a nullable
// branch beside them leaves their fix. A nested 'float' literal names its own neighbour and the branch.
test "a literal in a call, an index or a fallback keeps its fix beside a nullable branch" {
    let analysis = try sema_support.analyzeOne("takesDouble(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, float g2, float? h2, bool flag, int k, float[] values) \{\n"
        + "    let a2 = flag ? takesDouble(g * 3.5e38) : h;\n"
        + "    let b1 = flag ? takesFloat(g * 3.5e38) : g2;\n"
        + "    let b3 = flag ? (h2 ?? g * 3.5e38) : h;\n"
        + "    let a5 = flag ? values[(g * 3.5e38) as int] : h;\n"
        + "    let s1 = flag ? (flag ? g : 3.5e38f) : h;\n"
        + "    let s2 = switch (k) \{\n"
        + "        0 -> flag ? g : 3.5e38f,\n"
        + "        default -> h,\n"
        + "    \};\n"
        + "    let s3 = flag ? h : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and the value "
        + "of 'h2' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the arm 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try testing.assertEqual(reported.length, 7L);
}

// An array read and an argument whose type reaches the result can change the branch type, so beside
// a nullable 'float' branch they end after the why. An index and another argument keep their fix.
test "an array element or a generic argument beside a nullable branch ends after the why" {
    let analysis = try sema_support.analyzeOne("identity<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "pick<T>(T first, double scale) -> T \{\n"
        + "    return first;\n"
        + "\}\n"
        + "\n"
        + "takesDouble(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, bool flag, float[]? xs) \{\n"
        + "    let a = flag ? [g * 3.5e38][0] : h;\n"
        + "    let b = flag ? [g * 3.5e38]?[0] : h;\n"
        + "    let c = flag ? identity<float>(g * 3.5e38) : h;\n"
        + "    let d = flag ? pick<float>(g, g * 3.5e38) : h;\n"
        + "    let e = flag ? new Holder<float>(g * 3.5e38).held : h;\n"
        + "    let i = flag ? takesDouble(g * 3.5e38) : h;\n"
        + "    let j = flag ? xs?[(g * 3.5e38) as int] : h;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try testing.assertEqual(reported.length, 7L);
}

// A constructor parameter is named by the type it builds, with the type arguments that give the
// parameter its type, whether the call has one candidate or several.
test "a constructor parameter names the type the constructor builds" {
    let analysis = try sema_support.analyzeOne("class Keeper<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\}\n"
        + "\n"
        + "class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\n"
        + "    constructor(T held, int times) \{\n"
        + "        this.held = held;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Plain \{\n"
        + "    float size;\n"
        + "\n"
        + "    constructor(this.size);\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    float x;\n"
        + "\n"
        + "    constructor(this.x);\n"
        + "\}\n"
        + "\n"
        + "forms(float g) \{\n"
        + "    let k = new Keeper<float>(g * 3.5e38);\n"
        + "    let h = new Holder<float>(g * 3.5e38);\n"
        + "    let p = new Plain(g * 3.5e38);\n"
        + "    let q = Pair(g * 3.5e38);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'held' of the constructor of 'Keeper<float>' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'held' of the constructor of 'Holder<float>' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'size' of the constructor of 'Plain' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'x' of the constructor of 'Pair' is a 'float' too.");
    try testing.assertEqual(reported.length, 4L);
}

// Every place an integer literal takes its type from gets its own fix, as a floating-point literal
// does: a declaration, a return, an element, a parameter, a '??', an operand and a join. A literal
// nothing gives a type to gets the suffix or the conversion, and one no integer type takes gets none.
test "an integer literal too large for its type names where the type comes from and the type that takes it" {
    let analysis = try sema_support.analyzeOne("takes(int n) \{\n"
        + "\}\n"
        + "\n"
        + "overloaded(int n) \{\n"
        + "\}\n"
        + "\n"
        + "overloaded(string s) \{\n"
        + "\}\n"
        + "\n"
        + "counted() -> int \{\n"
        + "    return 3000000000;\n"
        + "\}\n"
        + "\n"
        + "class Holder \{\n"
        + "    int size = 3000000000;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "forms(int k, int? m, bool flag, byte mask) \{\n"
        + "    int declared = 3000000000;\n"
        + "    int? nullable = -3000000000;\n"
        + "    int[] elements = [1, 3000000000];\n"
        + "    takes(3000000000);\n"
        + "    overloaded(3000000000);\n"
        + "    int fallback = m ?? 3000000000;\n"
        + "    int sum = k + 3000000000;\n"
        + "    long wide = k + 3000000000;\n"
        + "    let joined = flag ? k : 3000000000;\n"
        + "    int chosen = flag ? k : 3000000000;\n"
        + "    let armed = switch (k) \{\n"
        + "        1 -> k,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    let listed = [k, 3000000000];\n"
        + "    byte masked = mask & 300;\n"
        + "    byte shifted = mask >> 300;\n"
        + "    uint unsigned = -1;\n"
        + "    int deep = -9223372036854775809;\n"
        + "    char letter = 2000000;\n"
        + "    byte code = 'Ω';\n"
        + "    let untyped = 3000000000;\n"
        + "    let huge = 10000000000000000000;\n"
        + "    let past = 99999999999999999999;\n"
        + "    let below = -99999999999999999999;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Change the return type of 'counted' to 'long'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'size' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'declared' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal -3000000000 is below the smallest value "
        + "of 'int', which is -2147483648. Declare 'nullable' as 'long?' instead.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'elements' as 'long[]' instead.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from parameter 'n' of 'takes', an 'int'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from parameter 'n' of 'overloaded', an "
        + "'int'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from the value of 'm', an 'int'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'k', an 'int'. Declare 'sum' as "
        + "'long' and convert 'k' ('long sum = k as long + 3000000000;').");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' first "
        + "('k as long + 3000000000').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('flag ? k as long : 3000000000').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Declare "
        + "'chosen' as 'long' and convert 'k' ('long chosen = flag ? k as long : 3000000000;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('1 -> k as long').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('[k as long, 3000000000]').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'mask', a 'byte'. Declare 'masked' as "
        + "'ushort' and convert 'mask' ('ushort masked = mask as ushort & 300;').");
    try sema_support.assertDiagnostic(reported, 15, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'mask', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 16, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. Declare 'unsigned' as 'int' instead.");
    try sema_support.assertDiagnostic(reported, 17, file, "Literal -9223372036854775809 is below the "
        + "smallest value of 'int', which is -2147483648. It is below the smallest value of 'long' too, "
        + "which is -9223372036854775808.");
    try sema_support.assertDiagnostic(reported, 18, file, "Literal 2000000 is too large for 'char', whose "
        + "largest value is 1114111.");
    try sema_support.assertDiagnostic(reported, 19, file, "The code point of 'Ω', 937, is too large for "
        + "'byte', whose largest value is 255.");
    try sema_support.assertDiagnostic(reported, 20, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 21, file, "Literal 10000000000000000000 is too large for "
        + "'int', whose largest value is 2147483647. Write '10000000000000000000 as ulong'.");
    try sema_support.assertDiagnostic(reported, 22, file, "Literal 99999999999999999999 is too large for "
        + "every integer type. The widest, 'ulong', has 18446744073709551615 as its largest value.");
    try sema_support.assertDiagnostic(reported, 23, file, "Literal -99999999999999999999 is below the "
        + "smallest value of every integer type. The lowest, 'long', has -9223372036854775808 as its "
        + "smallest value.");
    try testing.assertEqual(reported.length, 24L);
}

// An element takes the element type of the parameter or the '??' value the array fills, or else
// the type of the first element, and each refusal names which.
test "a literal in an array literal names the array's element type or the element beside it" {
    let analysis = try sema_support.analyzeOne("takesFloats(float[] items) -> float \{\n"
        + "    return items[0];\n"
        + "\}\n"
        + "\n"
        + "firstOf<T>(T[] items) -> T \{\n"
        + "    return items[0];\n"
        + "\}\n"
        + "\n"
        + "class Keeper<T> \{\n"
        + "    constructor(T[] items) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float[]? maybe, int k) \{\n"
        + "    float a = takesFloats([g, 3.5e38]);\n"
        + "    float b = firstOf<float>([g, 3.5e38]);\n"
        + "    byte c = firstOf<byte>([1, 2]);\n"
        + "    let d = new Keeper<float>([3.5e38]);\n"
        + "    float[] e = maybe ?? [3.5e38];\n"
        + "    let f = [g, 3.5e38];\n"
        + "    let h = [k, 3000000000];\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from the element type of parameter "
        + "'items' of 'takesFloats', a 'float'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from the element type of parameter "
        + "'items' of 'firstOf', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from the element type of parameter "
        + "'items' of the constructor of 'Keeper<float>', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from the element type of 'maybe', a "
        + "'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('[g as double, 3.5e38]').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' first "
        + "('[k as long, 3000000000]').");
    try testing.assertEqual(reported.length, 6L);
}
