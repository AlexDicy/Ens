import @std.testing;
import sema_support;

// The fallback on the right of '??' is checked against the type the left side has without its '?',
// as an assigned value is checked against its place. Parentheses, '?:' and a switch pass it along.
test "the fallback of '??' takes the type the left side has without its '?'" {
    let analysis = try sema_support.analyzeOne("fallbacks(byte? v, bool flag, int which) \{\n"
        + "    byte plain = v ?? 5;\n"
        + "    byte wrapped = v ?? (5);\n"
        + "    byte chosen = v ?? (flag ? 1 : 2);\n"
        + "    byte switched = v ?? switch (which) \{\n"
        + "        0 -> 1,\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    byte wide = v ?? (300);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from the value of 'v', a 'byte'.");
    try testing.assertEqual(reported.length, 1L);
}

// The value beside a literal too large for it converts to a type with every value of both sides,
// the declaration takes that type when the target is narrower, and no fix is given where no type
// has them all or a negative literal meets an unsigned target.
test "a literal beside a value converts that value only to a type with every value of both" {
    let analysis = try sema_support.analyzeOne(
        "forms(bool flag, uint u, long l, ulong ul, int i, ushort us, byte b) \{\n"
        + "    let a = flag ? u : -1;\n"
        + "    long c = flag ? u : -1;\n"
        + "    ulong d = flag ? u : -1;\n"
        + "    let e = flag ? l : 9223372036854775808;\n"
        + "    ulong f = flag ? l : 9223372036854775808;\n"
        + "    let g = flag ? ul : -1;\n"
        + "    int h = flag ? ul : -1;\n"
        + "    let k = flag ? us : -1;\n"
        + "    short m = flag ? us : -1;\n"
        + "    let n = flag ? b : -1;\n"
        + "    let o = flag ? i : 4294967295;\n"
        + "    uint p = flag ? i : 4294967295;\n"
        + "    int q = u + -1;\n"
        + "    let r = l + 9223372036854775808;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Convert 'u' first ('flag ? u "
        + "as long : -1').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Convert 'u' first ('flag ? u "
        + "as long : -1').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0. The literal takes its type from 'ul', a 'ulong'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0. The literal takes its type from 'ul', a 'ulong'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal -1 is below the smallest value of "
        + "'ushort', which is 0. The literal takes its type from 'us', a 'ushort'. Convert 'us' first "
        + "('flag ? us as int : -1').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'ushort', which is 0. The literal takes its type from 'us', a 'ushort'. Declare 'm' as 'int' "
        + "and convert 'us' ('int m = flag ? us as int : -1;').");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('flag ? b "
        + "as short : -1').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 4294967295 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'i', an 'int'. Convert 'i' "
        + "first ('flag ? i as long : 4294967295').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 4294967295 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'i', an 'int'. Declare 'p' "
        + "as 'long' and convert 'i' ('long p = flag ? i as long : 4294967295;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Declare 'q' as 'long' and "
        + "convert 'u' ('long q = u as long + -1;').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try testing.assertEqual(reported.length, 14L);
}

// Every literal of a switch, of a '?:' nested in a '?:' or of an array literal decides the type the
// typed value converts to, so the one fix covers them all and they get no report of their own. No
// fix is given where no integer type takes the typed value and every literal.
test "a join with several literals converts its typed value to one type every literal of the join takes" {
    let analysis = try sema_support.analyzeOne(
        "forms(byte b, int k, float f, bool flag, bool other, int i) \{\n"
        + "    let c = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let d = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        1 -> 3.5e38,\n"
        + "        default -> -3.5e38,\n"
        + "    \};\n"
        + "    let e = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> 70000,\n"
        + "    \};\n"
        + "    let g = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> -1,\n"
        + "        default -> 18446744073709551615,\n"
        + "    \};\n"
        + "    short h = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let m = flag ? (other ? b : 300) : -1;\n"
        + "    let n = flag ? b : (other ? 300 : -1);\n"
        + "    let o = [b, 300, -1];\n"
        + "    let q = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        1 -> -1,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    let r = flag ? (other ? b : 3) : -1;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as short').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Convert 'f' "
        + "first ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as uint').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from 'b', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as short').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('other "
        + "? b as short : 300').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[b as "
        + "short, 300, -1]').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'i', an 'int'. Convert 'i' first "
        + "('0 -> i as long').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from '(other ? b : 3)', a 'byte'. Convert "
        + "'(other ? b : 3)' first ('flag ? (other ? b : 3) as short : -1').");
    try testing.assertEqual(reported.length, 9L);
}

// The literals of a '?:', a switch or an array literal, with the joins inside it, are judged as one:
// one report at the first that does not fit, with the type that takes every literal and every
// integer value of the join, and no fix where no type does or a negative literal meets an unsigned target.
test "every literal of one join is judged together, whichever way the literals get their type" {
    let analysis = try sema_support.analyzeOne("forms(byte v, bool flag, bool other, int k) \{\n"
        + "    short x13 = flag ? v : (other ? 40000 : -40000);\n"
        + "    short[] x15 = [v, 40000, -40000];\n"
        + "    int x41 = flag ? v : (other ? 9223372036854775807 : -1);\n"
        + "    uint x42 = flag ? v : (other ? 9223372036854775807 : -1);\n"
        + "    let a = [flag ? v : 300, -1];\n"
        + "    let a8 = [flag ? v : 300, -1, 70000];\n"
        + "    let c = [switch (k) \{\n"
        + "        0 -> v,\n"
        + "        default -> 300,\n"
        + "    \}, -1];\n"
        + "    let x17 = flag ? v : (other ? 3000000000 : -1);\n"
        + "    uint x0 = switch (k) \{\n"
        + "        0 -> v,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let d = [v, flag ? 300 : -1];\n"
        + "    short e = flag ? 40000 : -40000;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'x13' as 'int' instead.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'x15' as 'int[]' instead.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 9223372036854775807 is too large for "
        + "'int', whose largest value is 2147483647. Declare 'x41' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 9223372036854775807 is too large for "
        + "'uint', whose largest value is 4294967295.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[flag "
        + "? v as short : 300, -1]').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[flag "
        + "? v as int : 300, -1, 70000]').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first "
        + "('[switch (k) \{ 0 -> v as short, default -> 300, \}, -1]').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[v as "
        + "short, flag ? 300 : -1]').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'e' as 'int' instead.");
    try testing.assertEqual(reported.length, 11L);
}

// Nested array literals and the '?:' and switch values inside them share one join, so one report
// names one type and converts every value of the type the literals took, spelled across the whole
// array. A switch whose literal arm comes before its typed arm keeps the literal's target.
test "the outermost array literal is the join of every array literal and join nested in it" {
    let analysis = try sema_support.analyzeOne("forms(byte b, bool flag, int k, int i) \{\n"
        + "    let a = [[b, 300], [-1]];\n"
        + "    let c = [[b, 300], [70000]];\n"
        + "    let d = [[b], [300, -1]];\n"
        + "    let e = [flag ? b : 300, flag ? -1 : b];\n"
        + "    let f = [switch (k) \{\n"
        + "        0 -> b,\n"
        + "        default -> 300,\n"
        + "    \}, flag ? -1 : b];\n"
        + "    let g = [[[b, 300]], [[-1]]];\n"
        + "    let h = [[3000000000], [i, -1]];\n"
        + "    short[][] m = [[b, 40000], [-40000]];\n"
        + "    uint[][] n = [[b, 300], [-1]];\n"
        + "    int w = switch (k) \{\n"
        + "        0 -> 70000,\n"
        + "        default -> b,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "short, 300], [-1]]').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "uint, 300], [70000]]').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "short], [300, -1]]').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[flag "
        + "? b as short : 300, flag ? -1 : b as short]').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first "
        + "('[switch (k) \{ 0 -> b as short, default -> 300, \}, flag ? -1 : b as short]').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[[b "
        + "as short, 300]], [[-1]]]').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'm' as 'int[][]' instead.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0.");
    try testing.assertEqual(reported.length, 9L);
}

// A literal arm after a typed arm takes the type the arms before it join to; when no arm has that
// type it is the target's, so a negative literal under an unsigned target gets no fix, and a literal
// too large for it gets the declaration its twin with the typed arm first gets.
test "a negative literal meeting an unsigned declared target ends after the why in every arm order" {
    let analysis = try sema_support.analyzeOne("forms(byte v, int k) \{\n"
        + "    uint a = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    ulong b = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    uint c = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> 5000000000,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 5000000000 is too large for 'uint', "
        + "whose largest value is 4294967295. Declare 'c' as 'ulong' instead.");
    try testing.assertEqual(reported.length, 3L);
}

test "a literal nothing gives a type to must fit the default it falls back to" {
    let analysis = try sema_support.analyzeBody(["let beyondInt = 3000000000;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 3000000000 is too large for 'int', whose largest value is 2147483647. Write "
            + "'3000000000L' to make it a 'long'.");
}

test "a literal past every integer type has no wider one to name" {
    let analysis = try sema_support.analyzeBody(["let beyondEveryType = 99999999999999999999;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 99999999999999999999 is too large for every integer type. The widest, 'ulong', has "
            + "18446744073709551615 as its largest value.");
}

test "a suffix moves the default, and the value must fit that" {
    let analysis = try sema_support.analyzeBody(["let beyondLong = 18446744073709551615L;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 18446744073709551615L is too large for 'long', whose largest value is "
            + "9223372036854775807. Write '18446744073709551615 as ulong'.");
}

test "an untyped floating-point literal past every type is reported too" {
    let analysis = try sema_support.analyzeBody(["let beyondDouble = 1e400;", "let beyondFloat = 3.5e38f;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 1e400 is too large for 'double', whose largest value is about 1.797e308.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Literal 3.5e38f is too large for 'float', whose largest value is about 3.402e38. Remove "
            + "the 'f' from '3.5e38f'.");
}

// The sign is outside the literal, and it moves the boundary, so both ends of a type's range
// are reachable and neither end is a false alarm.
test "the most negative value of a type is not mistaken for an overflow" {
    let analysis = try sema_support.analyzeBody(["let firstInt = -2147483648;", "let lastInt = 2147483647;",
        "let firstLong = -9223372036854775808L;", "long beyondInt = 3000000000;",
        "ulong beyondLong = 18446744073709551615;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}
