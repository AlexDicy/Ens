import @std.testing;
import sema_support;

test "an unsuffixed floating-point literal adapts to the surrounding float" {
    let analysis = try sema_support.analyzeBody(["float declared = 1.0;", "declared = 2.5;",
        "declared += 0.5;", "float negative = -1.5;", "float precise = 0.1;",
        "float largest = 3.4e38;", "float[] elements = [1.0, 2.0];",
        "float sibling = declared + 1.0;", "float leftSide = 1.0 + declared;",
        "float ternary = true ? 1.0 : declared;", "double wide = 1.0;",
        "double fromFloat = 1.0f;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a floating-point literal past the type's largest value is refused" {
    let analysis = try sema_support.analyzeBody(["float tooLarge = 3.5e38;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38. Declare "
            + "'tooLarge' as 'double' instead.");
}

test "a floating-point literal past every type names the widest one" {
    let analysis = try sema_support.analyzeBody(["double tooLarge = 1e400;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 1e400 is too large for 'double', whose largest value is about 1.797e308.");
}

test "a negative floating-point literal keeps its sign in the diagnostic" {
    let analysis = try sema_support.analyzeBody(["float tooSmall = -1e40;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal -1e40 is below the smallest value of 'float', which is about -3.402e38. Declare "
            + "'tooSmall' as 'double' instead.");
}

// The surrounding type reaches a literal directly under it, not one behind an operator, so
// this matches 'uint total = 1 + 4;' rather than diverging from it.
test "a floating-point literal behind an operator keeps the operands' own type" {
    let analysis = try sema_support.analyzeBody(["float sum = 1.0 + 2.0;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'sum' has type 'float', but its value has type 'double'.");
}

test "an untyped integer literal takes a floating-point type from its surroundings" {
    let analysis = try sema_support.analyzeBody(["float whole = 5;", "float negative = -5;",
        "double wide = 5;", "float rounded = 16777217;",
        "float largest = 9223372036854775807;", "float[] elements = [1, 2];",
        "float declared = 1.0;", "float sibling = declared + 2;",
        "float leftSide = 2 + declared;", "float ternary = true ? 3 : declared;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "an integer literal with a suffix keeps its type against a float target" {
    let analysis = try sema_support.analyzeBody(["float suffixed = 5L;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'suffixed' has type 'float', but its value has type 'long'.");
}

// A code point is a name for a character, not a measurement, so it reaches the integer types on
// its own and needs a cast to reach a floating-point one.
test "a char reaches the integer types but no floating-point type on its own" {
    let analysis = try sema_support.analyzeBody(["int asInteger = 'A';", "long wide = 'A';",
        "byte narrow = 'A';", "char letter = 'a';", "char masked = letter & 'a';",
        "char shifted = letter >> 1;", "char flipped = ~letter;",
        "double viaCast = 'A' as double;", "float narrowCast = 'A' as float;",
        "double fromVariable = letter as double;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// The fix widens the declaration that set the type to 'char', and a target no code can change in
// one edit is named instead.
test "a char literal whose code point the integer type cannot hold names where the type was set" {
    let analysis = try sema_support.analyzeOne("public class Gauge \{\n"
        + "    public byte level = '€';\n"
        + "\}\n"
        + "takesByte(byte value) \{\n"
        + "\}\n"
        + "code() -> byte \{\n"
        + "    return 'Ω';\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    byte? maybe = null;\n"
        + "    byte fallback = maybe ?? '€';\n"
        + "    takesByte('€');\n"
        + "    short wide = '😀';\n"
        + "    wide = '😀';\n"
        + "    byte small = 'A';\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string euro = "The code point of '€', its number in Unicode, is 8364, which is too large for 'byte', "
        + "whose largest value is 255.";
    try sema_support.assertDiagnostic(reported, 0, file, "{euro} Declare 'level' as 'char' instead.");
    try sema_support.assertDiagnostic(reported, 1, file, "The code point of 'Ω', its number in Unicode, "
        + "is 937, which is too large for 'byte', whose largest value is 255. Change the return type of "
        + "'code' to 'char'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{euro} The literal takes its type from the "
        + "value of 'maybe', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 3, file, "{euro} The literal takes its type from "
        + "parameter 'value' of 'takesByte', a 'byte'.");
    string smile = "The code point of '😀', its number in Unicode, is 128512, which is too large for "
        + "'short', whose largest value is 32767. Declare 'wide' as 'char' instead.";
    try sema_support.assertDiagnostic(reported, 4, file, smile);
    try sema_support.assertDiagnostic(reported, 5, file, smile);
    try testing.assertEqual(reported.length, 6L);
}

// A char literal operand or branch takes the integer type of the value beside it, as a number
// literal does, and a type argument sets the parameter type a literal argument takes.
test "a char literal beside a value or passed to a generic takes that type and names it" {
    let analysis = try sema_support.analyzeOne("pick<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    byte b = 0;\n"
        + "    byte sum = b + '€';\n"
        + "    byte picked = pick<byte>('€');\n"
        + "    byte masked = b & '€';\n"
        + "    byte shifted = b << '€';\n"
        + "    bool flag = true;\n"
        + "    let joined = flag ? b : '€';\n"
        + "    byte small = b + 'a';\n"
        + "    bool equal = b == 'a';\n"
        + "    byte low = b & 'a';\n"
        + "    byte kept = flag ? b : 'a';\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string euro = "The code point of '€', its number in Unicode, is 8364, which is too large for 'byte', "
        + "whose largest value is 255. The literal takes its type from";
    try sema_support.assertDiagnostic(reported, 0, file, "{euro} 'b', a 'byte'. Declare 'sum' as 'char' and "
        + "convert 'b' ('char sum = b as char + '€';').");
    try sema_support.assertDiagnostic(reported, 1, file, "{euro} parameter 'value' of 'pick', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{euro} 'b', a 'byte'. Declare 'masked' as 'char' "
        + "and convert 'b' ('char masked = b as char & '€';').");
    try sema_support.assertDiagnostic(reported, 3, file, "{euro} 'b', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 4, file, "{euro} 'b', a 'byte'. Convert 'b' first "
        + "('flag ? b as char : '€'').");
    try testing.assertEqual(reported.length, 5L);
}

// A literal past every integer type has no type to give what uses it, so it is reported once
// where it is written and nothing that uses it is reported as well.
test "a literal past every integer type is reported once wherever it is used" {
    let analysis = try sema_support.analyzeOne("takesWide(ulong value) \{\n"
        + "\}\n"
        + "wide() -> ulong \{\n"
        + "    return 18446744073709551616;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    ulong assigned = 18446744073709551616;\n"
        + "    ulong large = 1;\n"
        + "    ulong sum = large + 18446744073709551616;\n"
        + "    takesWide(18446744073709551616);\n"
        + "    ulong[] all = [1, 18446744073709551616];\n"
        + "    ulong picked = switch (large) \{\n"
        + "        18446744073709551616 -> 1,\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    long negative = -18446744073709551616;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string beyond = "Literal 18446744073709551616 is too large for every integer type. The widest, "
        + "'ulong', has 18446744073709551615 as its largest value.";
    for (long index = 0; index < 6; index++) {
        try sema_support.assertDiagnostic(reported, index, file, beyond);
    }
    try sema_support.assertDiagnostic(reported, 6, file, "Literal -18446744073709551616 is below the "
        + "smallest value of every integer type. The lowest, 'long', has -9223372036854775808 as its "
        + "smallest value.");
    try testing.assertEqual(reported.length, 7L);
}

test "a cast lets a literal the target holds stay exact, and still truncates one it cannot" {
    let analysis = try sema_support.analyzeBody(["uint full = 4294967295 as uint;",
        "long wide = 3000000000 as long;", "byte truncated = 300 as byte;",
        "float narrowed = 1.5 as float;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a suffix names a floating-point literal's type, leaving nothing to adapt" {
    let analysis = try sema_support.analyzeBody(["float suffixed = 3.0d;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'suffixed' has type 'float', but its value has type 'double'.");
}

// An untyped literal takes the type of a nullable target without its '?', wherever that target is
// expected. A literal too large for that type is refused against it.
test "an untyped literal takes the type of a nullable target without its '?'" {
    let analysis = try sema_support.analyzeOne("halve(float? value) -> float \{\n"
        + "    return (value ?? 0) / 2;\n"
        + "\}\n"
        + "ceiling() -> byte? \{\n"
        + "    return 200;\n"
        + "\}\n"
        + "literals(bool flag, int which) \{\n"
        + "    byte? small = 1;\n"
        + "    byte? wrapped = (2);\n"
        + "    float? ratio = 1.5;\n"
        + "    double? wide = 2;\n"
        + "    long? big = 3000000000;\n"
        + "    ulong? mask = 1;\n"
        + "    float half = halve(3);\n"
        + "    bool same = small == 1;\n"
        + "    if (small != null && mask != null) \{\n"
        + "        small += (1);\n"
        + "        small += flag ? 1 : 2;\n"
        + "        small += switch (which) \{\n"
        + "            0 -> 1,\n"
        + "            default -> 2,\n"
        + "        \};\n"
        + "        mask |= (1);\n"
        + "    \}\n"
        + "    byte? large = 300;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. Declare 'large' as "
        + "'ushort?' instead.");
    try testing.assertEqual(reported.length, 1L);
}

// A literal too large for a 'float' is pointed at 'double' only when a 'double' can take it.
test "a literal too large for 'float' and 'double' names both" {
    let analysis = try sema_support.analyzeBody(["float tooLarge = 1e400;", "let suffixed = 1e400f;"]);
    let diagnostics = analysis.bodyDiagnostics();
    string refusal = "is too large for 'float', whose largest value is about 3.402e38. It is too large "
        + "for 'double' too, whose largest value is about 1.797e308.";
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "Literal 1e400 {refusal}");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens", "Literal 1e400f {refusal}");
    try testing.assertEqual(diagnostics.length, 2);
}

// A negative literal past the range of its type is below the smallest value, not too large.
test "a negative floating-point literal below the range names the smallest value" {
    let analysis = try sema_support.analyzeBody(["double tooSmall = -1e400;", "let suffixed = -3.5e38f;",
        "float beyond = -1e400;"]);
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file,
        "Literal -1e400 is below the smallest value of 'double', which is about -1.797e308.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "Literal -3.5e38f is below the smallest value "
        + "of 'float', which is about -3.402e38. Remove the 'f' from '-3.5e38f'.");
    try sema_support.assertDiagnostic(diagnostics, 2, file, "Literal -1e400 is below the smallest value "
        + "of 'float', which is about -3.402e38. It is below the smallest value of 'double' too, which is "
        + "about -1.797e308.");
    try testing.assertEqual(diagnostics.length, 3);
}

test "interpolation holes render class values and arrays, and still reject function values" {
    let accepted = try sema_support.analyzeOne("interface Marker \{\n"
        + "\}\n"
        + "class Box implements Marker \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let box = new Box();\n"
        + "    Marker marked = box;\n"
        + "    let text = \"box \{box\} \{marked\} \{box.toString()\} \{marked.toString()\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(accepted.bodyDiagnostics());
    let arrays = try sema_support.analyzeOne("main() -> int \{\n"
        + "    int[] items = [1, 2];\n"
        + "    let text = \"items \{items\} \{items.toString()\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(arrays.bodyDiagnostics());
    let rejected = try sema_support.analyzeOne("main() -> int \{\n"
        + "    ((int) -> int)[] steps = [(v) -> v];\n"
        + "    let text = \"steps \{steps\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(rejected.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot interpolate a value of type '((int) -> int)[]': its elements are function values, "
        + "which have no text form. Interpolate names you keep beside the functions instead.");
    try testing.assertEqual(rejected.bodyDiagnostics().length, 1L);
    let opaque = try sema_support.analyzeOne("external type Handle;\n"
        + "main() -> int \{\n"
        + "    Handle?[] handles = new Handle?[2];\n"
        + "    let text = \"handles \{handles\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(opaque.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot interpolate a value of type 'Handle?[]'; its element type 'Handle' has no text "
        + "form. Interpolate a value you keep beside the elements instead.");
    try testing.assertEqual(opaque.bodyDiagnostics().length, 1L);
}

test "a class toString of another shape stays ordinary while holes use the type name" {
    let analysis = try sema_support.analyzeOne("class Legacy \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"legacy\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected toString(int scale) -> string \{\n"
        + "        return \"sized \{scale\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let legacy = new Legacy();\n"
        + "    let sized = new Sized();\n"
        + "    let text = \"\{legacy\} \{legacy.toString()\} \{sized\} \{sized.toString(2)\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "one nullable level fills a hole and two are still refused" {
    let analysis = try sema_support.analyzeOne("class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "render(Box? box, string? name, int? count, Point? spot) -> string \{\n"
        + "    return \"\{box\} \{name\} \{count\} \{spot\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let refused = try sema_support.analyzeOne("deep(string?? text) -> string \{\n"
        + "    return \"\{text\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(refused.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot interpolate a value of type 'string??', because it may be null at more than one "
        + "level. Check 'text' for null first ('if (text != null)').");
    try testing.assertEqual(refused.bodyDiagnostics().length, 1L);
}

test "a struct's own toString fills a hole, and its fields need no JSON form" {
    let analysis = try sema_support.analyzeOne("class Node \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Wrapper \{\n"
        + "    Node? node;\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"wrapped\";\n"
        + "    \}\n"
        + "\}\n"
        + "describe(Wrapper w) -> string \{\n"
        + "    return \"\{w\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "struct literals and constructor calls type cleanly" {
    let analysis = try sema_support.analyzeOne("struct Point \{\n"
        + "    protected int x;\n"
        + "    protected int y = 0;\n"
        + "\}\n"
        + "struct Made \{\n"
        + "    protected int a;\n"
        + "    protected int b;\n"
        + "    protected constructor(int start) \{\n"
        + "        this.a = start;\n"
        + "        this.b = start;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    Point q = \{x: 1, y: 2\};\n"
        + "    Made m = Made(5);\n"
        + "    return p.x + q.y + m.a + m.b;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a non-defaultable struct field is built through a literal" {
    let analysis = try sema_support.analyzeOne("class Cell \{\n"
        + "    protected int value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "struct Box \{\n"
        + "    protected Cell item;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell c = new Cell(3);\n"
        + "    Box b = \{item: c\};\n"
        + "    return b.item.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a generic struct is built through a typed literal" {
    let analysis = try sema_support.analyzeOne("struct Pair<A, B> \{\n"
        + "    protected A key;\n"
        + "    protected B value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Pair<int, int> p = \{key: 1, value: 2\};\n"
        + "    return p.key + p.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "struct literal errors are reported" {
    let missing = try sema_support.analyzeOne("struct Point \{ int x; int y; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(missing.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Struct literal for 'Point' does not set the field 'y'. Add 'y: ...', or give the field a "
        + "default value.");
    try testing.assertEqual(missing.bodyDiagnostics().length, 1L);

    let unknown = try sema_support.analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, z: 2\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(unknown.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Struct 'Point' has no field named 'z'. Its only field is 'x'.");
    try testing.assertEqual(unknown.bodyDiagnostics().length, 1L);

    let duplicate = try sema_support.analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, x: 2\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(duplicate.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Field 'x' is set twice in this struct literal. Remove the second 'x: ...'.");
    try testing.assertEqual(duplicate.bodyDiagnostics().length, 1L);

    let mismatch = try sema_support.analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: \"hi\"\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(mismatch.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Field 'x' has type 'int', but its value here has type 'string'.");
    try testing.assertEqual(mismatch.bodyDiagnostics().length, 1L);

    // A literal with nothing to take a type from names the positions that would give it one,
    // since no type is known here to put in an example.
    let untargeted = try sema_support.analyzeOne("main() -> int \{\n"
        + "    let p = \{x: 1\};\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(untargeted.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "This '\{...\}' literal has no declared struct type to build. Write it where a struct type is "
        + "declared, such as a variable, a field, a parameter, an array element or a return value.");
    try testing.assertEqual(untargeted.bodyDiagnostics().length, 1L);

    // A struct called with no constructor is built from a literal instead, named field by field,
    // with a generic struct keeping the type arguments its head carries. The first of these can
    // be built neither way here, since nothing outside 'Point' can set the field a literal of it
    // has to set.
    let noCtor = try sema_support.analyzeOne("public struct Point \{ int x; \}\n"
        + "public struct Measure \{\n"
        + "    public int width;\n"
        + "    public int height;\n"
        + "\}\n"
        + "public struct Pair<K, V> \{\n"
        + "    public K key;\n"
        + "    public V value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let a = Point(1);\n"
        + "    let b = Measure(1, 2);\n"
        + "    let c = Pair<int, string>(1, \"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = noCtor.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Struct 'Point' has no constructor to call. Add a 'constructor(...)' to it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Struct 'Measure' has no constructor to call. Build it with a literal, for example "
        + "'Measure value = \{width: ..., height: ...\};', or add a 'constructor(...)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Struct 'Pair' has no constructor to call. Build it with a literal, for example "
        + "'Pair<int, string> value = \{key: ..., value: ...\};', or add a 'constructor(...)'.");
    try testing.assertEqual(reported.length, 3L);
}

// Printing a number is the most ordinary thing a program does, so all three ways of turning one
// into text take a floating-point value. 'decimal' is reserved rather than implemented and has
// no text form, so it stays refused.
test "floating-point values convert to text in a hole, a call, and a concatenation" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    double wide = 2.5;\n"
        + "    float narrow = 1.5;\n"
        + "    let hole = \"\{wide\} \{narrow\}\";\n"
        + "    let called = wide.toString() + narrow.toString();\n"
        + "    let joined = \"n: \" + wide + narrow;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}
