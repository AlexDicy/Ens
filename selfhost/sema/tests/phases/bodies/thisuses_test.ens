import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import List from @std.collections.list;
import phases.bodies.thisuses;

test "a use of 'this' as a value is named for where the value goes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Sink \{\n"
        + "    protected constructor() \{ \}\n"
        + "    protected take(Probe? probe) -> string \{\n"
        + "        return \"taken\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Probe \{\n"
        + "    protected string label;\n"
        + "    protected constructor(bool flag) \{\n"
        + "        print(new Sink().take(flag ? this : null));\n"
        + "        this.label = \"x\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Listed \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        Listed[] all = [this];\n"
        + "        this.label = \"x\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Matched \{\n"
        + "    protected string label;\n"
        + "    protected constructor() \{\n"
        + "        string kind = switch (this) \{\n"
        + "            is Special matched -> \"special\",\n"
        + "            default -> \"plain\",\n"
        + "        \};\n"
        + "        this.label = kind;\n"
        + "    \}\n"
        + "\}\n"
        + "class Special extends Matched \{\n"
        + "\}\n"
        + "class Called \{\n"
        + "    protected string label;\n"
        + "    protected () -> string callback;\n"
        + "    protected constructor() \{\n"
        + "        this.callback = () -> this.label;\n"
        + "        this.label = \"x\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Recalled \{\n"
        + "    protected string label;\n"
        + "    protected (int, int) -> long callback;\n"
        + "    protected constructor() \{\n"
        + "        this.label = \"x\";\n"
        + "        this.callback = (first, second) -> this.label.length;\n"
        + "    \}\n"
        + "\}\n"
        + "class Built \{\n"
        + "    protected string label;\n"
        + "    protected () -> Built maker;\n"
        + "    protected constructor() \{\n"
        + "        this.label = \"x\";\n"
        + "        this.maker = () -> this;\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 6L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'this' is passed to 'take' before field 'label' of class 'Probe' has a value, and 'take' "
        + "may read 'label'. Assign 'label' before this line, for example 'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'this' is put in an array before field 'label' of class 'Listed' has a value, and code "
        + "that reads the array may read 'label'. Assign 'label' before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'this' is stored in 'matched' before field 'label' of class 'Matched' has a value, and code "
        + "that uses 'matched' may read 'label'. Assign 'label' before this line, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "This lambda uses 'this', and it is created before field 'label' of class 'Called' has a "
        + "value, so calling it may read 'label'. Assign 'label' before this lambda, for example "
        + "'this.label = ...;'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "This lambda uses 'this', and it is created before field 'callback' of class 'Recalled' has "
        + "a value, because 'callback' gets its value from the lambda. Until every field has a "
        + "value, 'this' can only be used to read and write its fields and to test its type with "
        + "'is'. Give 'callback' a default value, as in 'protected (int, int) -> long callback = "
        + "(first, second) -> 0;', so that every field has a value when the lambda is created.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "This lambda uses 'this', and it is created before field 'maker' of class 'Built' has a "
        + "value, because 'maker' gets its value from the lambda. Until every field has a value, "
        + "'this' can only be used to read and write its fields and to test its type with 'is'. "
        + "Give 'maker' a default value, so that every field has a value when the lambda is "
        + "created.");
}

// A base constructor keeps the value a 'this.field' parameter gives its field only where its body
// changes that field nowhere: not by assigning it or a part of it, and not with '++' or '--'.
test "a body changes a field of 'this' by assigning it or a part of it, or with '++' or '--'" {
    let root = sema_support.parseSource("main.ens", "class Box \{\n"
        + "    constructor() \{ this.name = \"a\"; \}\n"
        + "    constructor(int a) \{ this.count++; \}\n"
        + "    constructor(long a) \{ --this.count; \}\n"
        + "    constructor(bool b) \{ this.pair.left = 1; \}\n"
        + "    constructor(char c) \{ this.items[0] += 1; \}\n"
        + "    constructor(string s) \{ this.other = this.name; \}\n"
        + "    constructor(double d) \{ print(-this.count); \}\n"
        + "\}\n");
    string[] fields = ["name", "count", "count", "pair", "items", "name", "count"];
    bool[] changed = [true, true, true, true, true, false, false];
    let declarations = new List<FunctionDeclarationNode>();
    functionsIn(root, declarations);
    try testing.assertEqual(declarations.length(), fields.length);
    for (long i = 0; i < fields.length; i++) {
        try testing.assertEqual(thisuses.assignsField(declarations.get(i), fields[i]), changed[i]);
    }
}

functionsIn(SyntaxNode node, List<FunctionDeclarationNode> found) {
    if (node is FunctionDeclarationNode) {
        found.push(node);
    }
    for (let child in node.childNodes()) {
        functionsIn(child, found);
    }
}
