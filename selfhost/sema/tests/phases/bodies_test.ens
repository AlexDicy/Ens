import @std.testing;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "a clean body produces no diagnostics and fills the side tables" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    let total = 1 + 2;\n"
        + "    long widened = total;\n"
        + "    string text = \"total \{total\}\";\n"
        + "    if (widened > 2) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return 1;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    try testing.assertTrue(context.result().resolvedTypeCount() > 5,
        "expression nodes should have recorded types");
}

test "undefined names and non-functions are reported" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    let value = missing;\n"
        + "    let x = 1;\n"
        + "    x(2);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Undefined name 'missing'. Check the spelling, or declare it before it is used.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'x' has type 'int', which is not a function type, so it cannot be called.");
}

test "argument arity and types check against the signature" {
    let analysis = try analyzeOne("add(int a, int b) -> int \{\n"
        + "    return a + b;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    add(1);\n"
        + "    add(1, \"two\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'add' expects 2 arguments, got 1.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Argument 2: expected 'int', got 'string'");
}

// A defaulted parameter makes the count a range, and one count and a range read as the same
// sentence with the number the signature allows in it.
test "an arity failure names the range a signature with defaults accepts" {
    let analysis = try analyzeOne("span(int a, int b = 2, int c = 3) -> int \{\n"
        + "    return a + b + c;\n"
        + "\}\n"
        + "one(int a) \{ \}\n"
        + "main() -> int \{\n"
        + "    span(1, 2, 3, 4);\n"
        + "    one(1, 2);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'span' expects 1 to 3 arguments, got 4.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Function 'one' expects 1 argument, got 2.");
}

test "named arguments map to parameters and reject unknown names" {
    let clean = try analyzeOne("area(int width, int height = 2) -> int \{\n"
        + "    return width * height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return area(height: 3, width: 4) - area(width: 12);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(clean.bodyDiagnostics());
    let broken = try analyzeOne("area(int width, int height = 2) -> int \{\n"
        + "    return width * height;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return area(depth: 3);\n"
        + "\}\n");
    try sema_support.assertMentions(broken.bodyDiagnostics(),
        "Function 'area' has no parameter named 'depth'");
}

test "an overloaded call types a literal that names no type of its own from the parameter" {
    let clean = try analyzeOne("count(string[] names) -> long \{\n"
        + "    return names.length;\n"
        + "\}\n"
        + "count(string[] names, string label) -> long \{\n"
        + "    return names.length + label.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return (count([]) + count([], \"x\")) as int;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(clean.bodyDiagnostics());
    let broken = try analyzeOne("count(string[] names) -> long \{\n"
        + "    return names.length;\n"
        + "\}\n"
        + "count(long amount, string label) -> long \{\n"
        + "    return amount + label.length;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return count([], \"x\") as int;\n"
        + "\}\n");
    try sema_support.assertMentions(broken.bodyDiagnostics(),
        "Cannot assign an array literal to 'long'");
}

test "method calls resolve through the base chain with visibility" {
    let analysis = try analyzeOne("class Base \{\n"
        + "    int hidden = 1;\n"
        + "    protected shared() -> int \{ return 2; \}\n"
        + "    protected reveal() -> int \{ return this.hidden; \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    protected use() -> int \{ return this.shared(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let derived = new Derived();\n"
        + "    let ok = derived.reveal() + derived.use();\n"
        + "    return derived.hidden;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'hidden' is private to class 'Base'");
}

test "is and as? reject impossible and vacuous tests" {
    let analysis = try analyzeOne("class Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Dog extends Animal \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Rock \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Animal pet = new Dog();\n"
        + "    let fineTest = pet is Dog;\n"
        + "    let fineCast = pet as? Dog;\n"
        + "    let never = pet is Rock;\n"
        + "    Dog dog = new Dog();\n"
        + "    let vacuous = dog is Animal;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "can never be a 'Rock'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "this 'is' test would always be true");
}

test "new requires a concrete class and a matching constructor" {
    let analysis = try analyzeOne("abstract class Shape \{\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "enum Color \{\n"
        + "    Red,\n"
        + "\}\n"
        + "class Box \{\n"
        + "    int size;\n"
        + "    protected constructor(this.size);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let shape = new Shape();\n"
        + "    let point = new Point();\n"
        + "    let hue = new Color();\n"
        + "    let box = new Box();\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Cannot create an instance of abstract class 'Shape'. Create one of a subclass that is "
        + "not abstract.");
    // Nothing outside 'Point' can set the field its literal has to set, and it has no
    // constructor either, so neither way of building it can be written here.
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'new' builds a class, and 'Point' is a struct. Add a 'constructor(...)' to it.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'new' requires a class type, got 'Color'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Constructor 'Box' expects 1 argument, got 0.");
    try testing.assertEqual(reported.length, 4L);
}

// 'new' never builds a struct, so the refusal names the way that struct is built instead: a
// constructor call through its own name, an aggregate literal otherwise, and a generic struct
// keeps the type arguments its head carries. A module-qualified head reaches no constructor
// call, so it leaves the literal.
test "'new' on a struct names the way that struct is built" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", valueKinds()
        + "public struct Pair<K, V> \{\n"
        + "    public K key;\n"
        + "    public V value;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "import Point from lib.parts;\n"
        + "import Made from lib.parts;\n"
        + "import Hidden from lib.parts;\n"
        + "import Pair from lib.parts;\n"
        + "main() -> int \{\n"
        + "    let a = new Point();\n"
        + "    let b = new Made(1);\n"
        + "    let c = new Hidden();\n"
        + "    let d = new parts.Made(1);\n"
        + "    let e = new Pair<int, string>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'new' builds a class, and 'Point' is a struct. Write 'Point value = \{x: ..., "
        + "y: ...\};' to build one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'new' builds a class, and 'Made' is a struct. Write 'Made(...)' to construct one.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'new' builds a class, and 'Hidden' is a struct. Add a 'constructor(...)' to it.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'new' builds a class, and 'parts.Made' is a struct. Write 'parts.Made value = "
        + "\{a: ...\};' to build one.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'new' builds a class, and 'Pair' is a struct. Write 'Pair<int, string> value = "
        + "\{key: ..., value: ...\};' to build one.");
    try testing.assertEqual(reported.length, 5L);
}

test "a type nothing can instantiate is not also checked for its constructor's visibility" {
    let analysis = try analyzeOne("abstract class Shape \{\n"
        + "    int side;\n"
        + "    constructor(this.side);\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let shape = new Shape(2);\n"
        + "    return 0;\n"
        + "\}\n");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot create an instance of abstract class 'Shape'");
}

test "interpolation holes render class values and arrays, and still reject function values" {
    let accepted = try analyzeOne("interface Marker \{\n"
        + "\}\n"
        + "class Box implements Marker \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let box = new Box();\n"
        + "    Marker marked = box;\n"
        + "    let text = \"box \{box\} \{marked\} \{box.toString()\} \{marked.toString()\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(accepted.bodyDiagnostics());
    let arrays = try analyzeOne("main() -> int \{\n"
        + "    int[] items = [1, 2];\n"
        + "    let text = \"items \{items\} \{items.toString()\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(arrays.bodyDiagnostics());
    let rejected = try analyzeOne("main() -> int \{\n"
        + "    ((int) -> int)[] steps = [(v) -> v];\n"
        + "    let text = \"steps \{steps\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(rejected.bodyDiagnostics(),
        "Cannot interpolate a value of type '((int) -> int)[]': its elements are function "
            + "values, which have no text form. Interpolate names you keep beside the functions "
            + "instead.");
    let opaque = try analyzeOne("external type Handle;\n"
        + "main() -> int \{\n"
        + "    Handle?[] handles = new Handle?[2];\n"
        + "    let text = \"handles \{handles\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(opaque.bodyDiagnostics(),
        "Cannot interpolate a value of type 'Handle?[]'; its element type 'Handle' has no text "
            + "form. Interpolate a value you keep beside the elements instead.");
}

test "a class toString of another shape stays ordinary while holes use the type name" {
    let analysis = try analyzeOne("class Legacy \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"legacy\";\n"
        + "    \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected toString(int scale) -> string \{\n"
        + "        return \"sized \{scale\}\";\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let legacy = new Legacy();\n"
        + "    let sized = new Sized();\n"
        + "    let text = \"\{legacy\} \{legacy.toString()\} \{sized\} \{sized.toString(2)\}\";\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "an explicit toString call on a type parameter defers like a hole" {
    let analysis = try analyzeOne("interface Marker \{\n"
        + "\}\n"
        + "class Badge implements Marker \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "render<T>(T value) -> string \{\n"
        + "    return value.toString();\n"
        + "\}\n"
        + "renderMarked<T: Marker>(T value) -> string \{\n"
        + "    return value.toString();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    print(render(new Badge()));\n"
        + "    print(render(7));\n"
        + "    print(renderMarked(new Badge()));\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "one nullable level fills a hole and two are still refused" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "\}\n"
        + "render(Box? box, string? name, int? count, Point? spot) -> string \{\n"
        + "    return \"\{box\} \{name\} \{count\} \{spot\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let refused = try analyzeOne("deep(string?? text) -> string \{\n"
        + "    return \"\{text\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(refused.bodyDiagnostics(),
        "Cannot interpolate a value of type 'string??' because it may be null at more than one "
        + "level. Unwrap one level at a time with a null check ('if (value != null)') or a "
        + "fallback ('value ?? null'), until 'string' remains.");
}

// Printing a number is the most ordinary thing a program does, so all three ways of turning one
// into text take a floating-point value. 'decimal' is reserved rather than implemented and has
// no text form, so it stays refused.
test "floating-point values convert to text in a hole, a call, and a concatenation" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    double wide = 2.5;\n"
        + "    float narrow = 1.5;\n"
        + "    let hole = \"\{wide\} \{narrow\}\";\n"
        + "    let called = wide.toString() + narrow.toString();\n"
        + "    let joined = \"n: \" + wide + narrow;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a class still has no text form of its own for a concatenation" {
    let analysis = try analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let shape = new Shape();\n"
        + "    let joined = \"shape: \" + shape;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot add a value of type 'Shape' to a string; only a string, a number and a 'bool' can "
        + "be added.");
}

test "a struct's own toString fills a hole, and its fields need no JSON form" {
    let analysis = try analyzeOne("class Node \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Wrapper \{\n"
        + "    Node? node;\n"
        + "\n"
        + "    override toString() -> string \{\n"
        + "        return \"wrapped\";\n"
        + "    \}\n"
        + "\}\n"
        + "describe(Wrapper w) -> string \{\n"
        + "    return \"\{w\}\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "locals require initializers they can type from" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    let unset = null;\n"
        + "    const int fixed;\n"
        + "    int paired = 1;\n"
        + "    let paired = 2;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot tell the type from 'null' alone.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Constant 'fixed' must be given its value where it is declared");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Variable 'paired' is already declared here");
}

test "generic calls infer, check bounds, and substitute returns" {
    let clean = try analyzeOne("first<T>(T[] items, T fallback) -> T \{\n"
        + "    if (items.length > 0) \{\n"
        + "        return items[0];\n"
        + "    \}\n"
        + "    return fallback;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int chosen = first<int>([1, 2], 3);\n"
        + "    return chosen;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(clean.bodyDiagnostics());
    let broken = try analyzeOne("pick<T>() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick();\n"
        + "\}\n");
    try sema_support.assertMentions(broken.bodyDiagnostics(),
        "Cannot tell the type argument 'T' for 'pick'");
    let structural = try analyzeOne("class Box<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "interface Source<T> \{\n"
        + "    read() -> T;\n"
        + "\}\n"
        + "class Ticker implements Source<int> \{\n"
        + "    protected constructor();\n"
        + "    protected override read() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "unbox<T>(Box<T> box) -> T \{\n"
        + "    return box.value;\n"
        + "\}\n"
        + "readFrom<T>(Source<T> source) -> T \{\n"
        + "    return source.read();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int unboxed = unbox(new Box<int>(3));\n"
        + "    int ticked = readFrom(new Ticker());\n"
        + "    return unboxed + ticked;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(structural.bodyDiagnostics());
    let conflicting = try analyzeOne("interface Source<T> \{\n"
        + "    read() -> T;\n"
        + "\}\n"
        + "class Ticker implements Source<int> \{\n"
        + "    protected constructor();\n"
        + "    protected override read() -> int \{\n"
        + "        return 4;\n"
        + "    \}\n"
        + "\}\n"
        + "readBoth<T>(Source<T> source, T other) -> T \{\n"
        + "    return other;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let mixed = readBoth(new Ticker(), \"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(conflicting.bodyDiagnostics(),
        "Argument 2: expected 'int', got 'string'. 'T' was inferred as 'int' from argument 1");
}

test "this binds a generic function's parameter as the class at its own type parameters" {
    string shared = "class Box<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "    protected same() -> Box<T> \{\n"
        + "        return identity(this);\n"
        + "    \}\n"
        + "    protected twice() -> Pair<Box<T>> \{\n"
        + "        return pair(this, this);\n"
        + "    \}\n"
        + "    protected orOther(Box<T> other) -> Box<T> \{\n"
        + "        return first(this, other);\n"
        + "    \}\n"
        + "\}\n"
        + "class Pair<T> \{\n"
        + "    protected T left;\n"
        + "    protected T right;\n"
        + "    protected constructor(this.left, this.right);\n"
        + "\}\n"
        + "identity<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "pair<T>(T left, T right) -> Pair<T> \{\n"
        + "    return new Pair<T>(left, right);\n"
        + "\}\n"
        + "first<T>(T one, T two) -> T \{\n"
        + "    return one;\n"
        + "\}\n";
    let clean = try analyzeOne(shared + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(clean.bodyDiagnostics());
    let mixed = try analyzeOne(shared + "class Crate<T> \{\n"
        + "    protected Box<T> inner;\n"
        + "    protected constructor(this.inner);\n"
        + "    protected mixed() -> Crate<T> \{\n"
        + "        return first(this, new Crate<int>(new Box<int>(1)));\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(mixed.bodyDiagnostics(),
        "Argument 2: expected 'Crate<T>', got 'Crate<int>'. 'T' was inferred as 'Crate<T>' from "
        + "argument 1");
}

test "a bound naming its own parameter is judged with the type argument substituted in" {
    string shared = "interface Comparable<T> \{\n"
        + "    compareTo(T other) -> int;\n"
        + "\}\n"
        + "class Item implements Comparable<Item> \{\n"
        + "    protected int value;\n"
        + "    protected constructor(this.value);\n"
        + "    protected override compareTo(Item other) -> int \{\n"
        + "        return this.value - other.value;\n"
        + "    \}\n"
        + "\}\n"
        + "class Plain \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Sorted<T: Comparable<T>> \{\n"
        + "    protected constructor();\n"
        + "    protected static smallestOf(T first, T second) -> T \{\n"
        + "        if (second.compareTo(first) < 0) \{\n"
        + "            return second;\n"
        + "        \}\n"
        + "        return first;\n"
        + "    \}\n"
        + "\}\n"
        + "largest<T: Comparable<T>>(T[] values) -> T \{\n"
        + "    return values[0];\n"
        + "\}\n"
        + "interface Converts<T> \{\n"
        + "    convert() -> T;\n"
        + "\}\n"
        + "class Meters implements Converts<Feet> \{\n"
        + "    protected constructor();\n"
        + "    protected override convert() -> Feet \{\n"
        + "        return new Feet();\n"
        + "    \}\n"
        + "\}\n"
        + "class Feet implements Converts<Meters> \{\n"
        + "    protected constructor();\n"
        + "    protected override convert() -> Meters \{\n"
        + "        return new Meters();\n"
        + "    \}\n"
        + "\}\n"
        + "roundTrip<A: Converts<B>, B: Converts<A>>(A start) -> A \{\n"
        + "    return start.convert().convert();\n"
        + "\}\n";
    let satisfied = try analyzeOne(shared
        + "main() -> int \{\n"
        + "    Item[] items = [new Item(1), new Item(2)];\n"
        + "    let inferred = largest(items);\n"
        + "    let explicit = largest<Item>(items);\n"
        + "    let smallest = Sorted.smallestOf(new Item(1), new Item(2));\n"
        + "    let sorted = new Sorted<Item>();\n"
        + "    let meters = roundTrip<Meters, Feet>(new Meters());\n"
        + "    return explicit.value + smallest.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(satisfied.bodyDiagnostics());
    let unmet = try analyzeOne(shared
        + "main() -> int \{\n"
        + "    Plain[] plains = [new Plain()];\n"
        + "    let inferred = largest(plains);\n"
        + "    let explicit = largest<Plain>(plains);\n"
        + "    let smallest = Sorted.smallestOf(new Plain(), new Plain());\n"
        + "    let sorted = new Sorted<Plain>();\n"
        + "    let meters = roundTrip<Meters, Meters>(new Meters());\n"
        + "    return 0;\n"
        + "\}\n");
    let diagnostics = unmet.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 6L);
    string plainMessage = "Type argument 'Plain' for type parameter 'T' must implement "
        + "interface 'Comparable<Plain>'.";
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(diagnostics, i, "/proj/src/main.ens", plainMessage);
    }
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/src/main.ens",
        "Type argument 'Meters' for type parameter 'A' must implement interface "
        + "'Converts<Meters>'.");
    try sema_support.assertDiagnostic(diagnostics, 5, "/proj/src/main.ens",
        "Type argument 'Meters' for type parameter 'B' must implement interface "
        + "'Converts<Meters>'.");
}

test "a switch expression unifies its arm values" {
    let analysis = try analyzeOne("classify(int value) -> string \{\n"
        + "    return switch (value) \{\n"
        + "        0 -> \"zero\",\n"
        + "        1 -> 1,\n"
        + "        default -> \"many\",\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return classify(2).length as int;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Switch arms produce 'string' and 'int'");
}

test "struct literals and constructor calls type cleanly" {
    let analysis = try analyzeOne("struct Point \{\n"
        + "    protected int x;\n"
        + "    protected int y = 0;\n"
        + "\}\n"
        + "struct Made \{\n"
        + "    protected int a;\n"
        + "    protected int b;\n"
        + "    protected constructor(int start) \{\n"
        + "        this.a = start;\n"
        + "        this.b = start;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    Point q = \{x: 1, y: 2\};\n"
        + "    Made m = Made(5);\n"
        + "    return p.x + q.y + m.a + m.b;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a non-defaultable struct field is built through a literal" {
    let analysis = try analyzeOne("class Cell \{\n"
        + "    protected int value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "struct Box \{\n"
        + "    protected Cell item;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Cell c = new Cell(3);\n"
        + "    Box b = \{item: c\};\n"
        + "    return b.item.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a generic struct is built through a typed literal" {
    let analysis = try analyzeOne("struct Pair<A, B> \{\n"
        + "    protected A key;\n"
        + "    protected B value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Pair<int, int> p = \{key: 1, value: 2\};\n"
        + "    return p.key + p.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a generic struct is built through its constructor" {
    let analysis = try analyzeOne("struct Slot<T> \{\n"
        + "    protected T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Slot<int> s = Slot<int>(7);\n"
        + "    return s.value;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a generic struct constructor call without type arguments is rejected" {
    let analysis = try analyzeOne("struct Slot<T> \{\n"
        + "    T value;\n"
        + "    protected constructor(this.value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let s = Slot(7);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot tell which type arguments the generic struct 'Slot'");
}

test "constructor visibility gates new expressions and super chains" {
    let analysis = try analyzeOne("class Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Guarded \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Opened extends Guarded \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let locked = new Locked();\n"
        + "    let guarded = new Guarded();\n"
        + "    let opened = new Opened();\n"
        + "    return 0;\n"
        + "\}\n");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "The constructor of 'Locked' is private, so only code inside 'Locked' can call it. Mark it "
        + "'public' to construct 'Locked' here.");
}

test "a function has neither a receiver nor a base class to reach" {
    let withThis = try analyzeOne("main() -> int \{\n"
        + "    return this.size;\n"
        + "\}\n");
    try sema_support.assertMentions(withThis.bodyDiagnostics(),
        "'this' names the object a method was called on, and a function has none. Take the "
        + "object as a parameter, or move the code into a method of its type.");
    let withSuper = try analyzeOne("main() -> int \{\n"
        + "    return super.size;\n"
        + "\}\n");
    try sema_support.assertMentions(withSuper.bodyDiagnostics(),
        "'super' reaches the base class of the object a method was called on, and a function has "
        + "none. Move the code into a method of the subclass.");
}

test "a public member, constructor or function stops at its package boundary" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Gear \{\n"
        + "    public int teeth = 3;\n"
        + "    export constructor();\n"
        + "\}\n"
        + "export class Latched \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public hidden() -> int \{ return 1; \}\n"
        + "export shipped() -> int \{ return 2; \}\n");
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\n"
        + "import Latched from @acme.parts;\n"
        + "import @acme.parts;\n"
        + "main() -> int \{\n"
        + "    let gear = new Gear();\n"
        + "    let latched = new Latched();\n"
        + "    return gear.teeth + parts.hidden() + parts.shipped();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertMentions(found, "'teeth' of 'Gear' is public inside package "
        + "'acme' but not exported. Mark it 'export' in module 'acme.parts' to use it from "
        + "another package.");
    try sema_support.assertMentions(found, "Function 'hidden' is public inside package "
        + "'acme' but not exported. Mark it 'export' in module 'acme.parts' to use it from "
        + "another package.");
    try sema_support.assertMentions(found, "The constructor of 'Latched' is public inside "
        + "package 'acme' but not exported. Mark it 'export' in module 'acme.parts' to "
        + "construct 'Latched' from another package.");
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("shipped") >= 0) {
            try testing.fail("an export function must resolve cross-package: "
                + diagnostic.message());
        }
    }
}

test "a 'this.field' parameter reaches a base field exactly where a body write reaches it" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Gear \{\n"
        + "    public int ratio = 2;\n"
        + "    protected int wear = 3;\n"
        + "    export int serial = 4;\n"
        + "    protected constructor();\n"
        + "\}\n");
    // 'Reaches' binds the two tiers a subclass in another package can write, so the public
    // field is the only one of the three a shorthand parameter cannot reach.
    loader.add("/proj/src/main.ens",
        "import Gear from @acme.parts;\n"
        + "class Reaches extends Gear \{\n"
        + "    protected constructor(this.wear, this.serial);\n"
        + "\}\n"
        + "class Shorthand extends Gear \{\n"
        + "    protected constructor(this.ratio);\n"
        + "\}\n"
        + "class BodyWrite extends Gear \{\n"
        + "    protected constructor() \{\n"
        + "        this.ratio = 5;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    // A shorthand parameter writes the field, so both refusals read the same sentence.
    try testing.assertEqual(found[0].message(), found[1].message());
    try testing.assertEqual(found[0].message(),
        "'ratio' of 'Gear' is public inside package 'acme' but not exported. Mark it 'export' "
        + "in module 'acme.parts' to use it from another package.");
}

test "struct literal errors are reported" {
    let missing = try analyzeOne("struct Point \{ int x; int y; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertMentions(missing.bodyDiagnostics(),
        "does not set the field 'y'");

    let unknown = try analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, z: 2\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertMentions(unknown.bodyDiagnostics(),
        "Struct 'Point' has no field named 'z'");

    let duplicate = try analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1, x: 2\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertMentions(duplicate.bodyDiagnostics(),
        "Field 'x' is set more than once");

    let mismatch = try analyzeOne("struct Point \{ int x; \}\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: \"hi\"\};\n"
        + "    return p.x;\n"
        + "\}\n");
    try sema_support.assertMentions(mismatch.bodyDiagnostics(),
        "Field 'x': expected 'int', got 'string'");

    // A literal with nothing to take a type from names the positions that would give it one,
    // since no type is known here to put in an example.
    let untargeted = try analyzeOne("main() -> int \{\n"
        + "    let p = \{x: 1\};\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(untargeted.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "Cannot tell which struct this '\{...\}' literal builds. Write it where a declared "
        + "type names the struct: a variable, a field, a parameter, an array element, or a "
        + "return value.");
    try testing.assertEqual(untargeted.bodyDiagnostics().length, 1L);

    // A struct called with no constructor is built from a literal instead, named field by field,
    // with a generic struct keeping the type arguments its head carries. The first of these can
    // be built neither way here, since nothing outside 'Point' can set the field a literal of it
    // has to set.
    let noCtor = try analyzeOne("struct Point \{ int x; \}\n"
        + "public struct Measure \{\n"
        + "    public int width;\n"
        + "    public int height;\n"
        + "\}\n"
        + "public struct Pair<K, V> \{\n"
        + "    public K key;\n"
        + "    public V value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let a = Point(1);\n"
        + "    let b = Measure(1, 2);\n"
        + "    let c = Pair<int, string>(1, \"x\");\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = noCtor.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Struct 'Point' has no constructor to call. Add a 'constructor(...)' to it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Struct 'Measure' has no constructor to call. Build it with a literal, for example "
        + "'Measure value = \{width: ..., height: ...\};', or add a 'constructor(...)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Struct 'Pair' has no constructor to call. Build it with a literal, for example "
        + "'Pair<int, string> value = \{key: ..., value: ...\};', or add a 'constructor(...)'.");
    try testing.assertEqual(reported.length, 3L);
}

// Test declarations belong to a '_test.ens' file, so a body of one is analyzed under that name.
analyzeTests(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/unit_test.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["unit_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

test "a test body is checked from a clean flow state, whatever came before it" {
    let narrowed = try analyzeTests(
        "class Door \{ protected int code; protected constructor(); \}\n"
        + "class Missing extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "opened(bool yes) -> Door? \{\n"
        + "    if (yes) \{\n"
        + "        return new Door();\n"
        + "    \}\n"
        + "    return null;\n"
        + "\}\n"
        + "test \"a throwing check narrows what follows it\" \{\n"
        + "    let door = opened(true);\n"
        + "    if (door == null) \{\n"
        + "        throw new Missing(\"nothing\");\n"
        + "    \}\n"
        + "    let code = door.code;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(narrowed.bodyDiagnostics());

    let unassigned = try analyzeTests("answer() -> long \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "test \"a local read before it is assigned\" \{\n"
        + "    long value;\n"
        + "    print(\"\{value\}\");\n"
        + "\}\n");
    try sema_support.assertMentions(unassigned.bodyDiagnostics(),
        "Variable 'value' is used before it is assigned a value");
}

aliasingLibrary(FakeFileLoader loader) {
    loader.add("/proj/src/lib/sizes.ens",
        "public interface Measurable \{\n"
        + "    size() -> int;\n"
        + "\}\n"
        + "public class Ruler implements Measurable \{\n"
        + "    public static const int unit = 10;\n"
        + "    int marks;\n"
        + "    public constructor(int marks) \{\n"
        + "        this.marks = marks;\n"
        + "    \}\n"
        + "    public static create(int marks) -> Ruler \{\n"
        + "        return new Ruler(marks);\n"
        + "    \}\n"
        + "    public override size() -> int \{\n"
        + "        return this.marks;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Failure extends Error \{\n"
        + "    public constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Box<T> \{\n"
        + "\}\n"
        + "public enum Kind \{ Small, Large \}\n"
        + "public measure(Measurable shape) -> int \{\n"
        + "    return shape.size();\n"
        + "\}\n"
        + "public check(int size) throws Failure \{\n"
        + "    if (size < 0) \{\n"
        + "        throw new Failure(\"negative\");\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/lib/colors.ens",
        "public enum Kind \{ Red \}\n"
        + "public pick() -> Kind \{\n"
        + "    return Kind.Red;\n"
        + "\}\n");
}

test "an import alias reaches everything the name it replaces would" {
    let loader = new FakeFileLoader();
    aliasingLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import Kind as SizeKind from lib.sizes;\n"
        + "import Kind as ColorKind from lib.colors;\n"
        + "import lib.sizes as sizing;\n"
        + "import lib.colors as coloring;\n"
        + "import Ruler as Measure from lib.sizes;\n"
        + "public class Cube implements sizing.Measurable \{\n"
        + "    public override size() -> int \{\n"
        + "        return 8;\n"
        + "    \}\n"
        + "\}\n"
        + "check(int size) throws sizing.Failure \{\n"
        + "    try sizing.check(size);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    SizeKind size = SizeKind.Large;\n"
        + "    ColorKind color = coloring.pick();\n"
        + "    sizing.Ruler ruler = Measure.create(Measure.unit);\n"
        + "    sizing.Box<Measure> boxed = new sizing.Box<Measure>();\n"
        + "    sizing.Measurable shape = new sizing.Ruler(2);\n"
        + "    if (shape is Measure) \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "    let cube = shape as? Cube;\n"
        + "    try check(sizing.measure(shape) + ruler.size());\n"
        + "    return 0;\n"
        + "\} catch (sizing.Failure e) \{\n"
        + "    return 2;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "two types spelled alike are distinguished by the names their file bound" {
    let loader = new FakeFileLoader();
    aliasingLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import Kind as SizeKind from lib.sizes;\n"
        + "import Kind as ColorKind from lib.colors;\n"
        + "import lib.sizes as sizing;\n"
        + "import lib.colors as coloring;\n"
        + "main() -> int \{\n"
        + "    SizeKind size = coloring.pick();\n"
        + "    sizing.Box<SizeKind> boxed = new sizing.Box<ColorKind>();\n"
        + "    SizeKind[] sizes = [ColorKind.Red];\n"
        + "    int number = size;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'ColorKind' to variable of type 'SizeKind'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'sizing.Box<ColorKind>' to variable of type "
        + "'sizing.Box<SizeKind>'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Element 1: expected 'SizeKind', got 'ColorKind'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'SizeKind' to variable of type 'int'");
}

// A function's name stands for no value, so every position that writes a value refuses it. The
// suggested fix declares the function type a lambda calling that function fits.
test "a function's name is not a value in any position" {
    let analysis = try analyzeOne("twice(int value) -> int \{\n"
        + "    return value * 2;\n"
        + "\}\n"
        + "applies((int) -> int f, int value) -> int \{\n"
        + "    return f(value);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let untyped = twice;\n"
        + "    (int) -> int declared = twice;\n"
        + "    let passed = applies(twice, 3);\n"
        + "    twice = 4;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'twice' is a function, and a function's name is not a value. Call it as "
        + "'twice(...)', or hold a lambda in a declared function type, as in "
        + "'(int) -> int callback = (value) -> twice(value);'.";
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", refused);
    }
    try testing.assertEqual(reported.length, 4L);
}

// The suggested declaration spells the function's own type, so it carries the 'throws' list and
// the 'try' a call to a raising function needs.
test "the suggested function type carries the throws list" {
    let analysis = try analyzeOne("class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "risky(int value) -> int throws Error \{\n"
        + "    if (value < 0) \{\n"
        + "        throw new Failure(\"negative\");\n"
        + "    \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = risky;\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertDiagnostic(analysis.bodyDiagnostics(), 0, "/proj/src/main.ens",
        "'risky' is a function, and a function's name is not a value. Call it as 'risky(...)', "
        + "or hold a lambda in a declared function type, as in '((int) -> int throws Error) "
        + "callback = (value) -> try risky(value);'.");
    try testing.assertEqual(analysis.bodyDiagnostics().length, 1L);
}

// One function type has to cover the name for the fix to spell one, and a name several
// declarations share, a generic, and a 'throws' whose types the body decides leave none.
test "a function name no one function type covers is refused without a declaration" {
    let analysis = try analyzeOne("class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "overloaded(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "overloaded(string value) -> string \{\n"
        + "    return value;\n"
        + "\}\n"
        + "kept<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "inferred(int value) -> int throws \{\n"
        + "    if (value < 0) \{\n"
        + "        throw new Failure(\"negative\");\n"
        + "    \}\n"
        + "    return value;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let a = overloaded;\n"
        + "    let b = kept;\n"
        + "    let c = inferred;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string[] named = ["overloaded", "kept", "inferred"];
    for (long i = 0; i < named.length; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "'{named[i]}' is a function, and a function's name is not a value. Call it as "
            + "'{named[i]}(...)', or hold a lambda in a declared function type.");
    }
    try testing.assertEqual(reported.length, 3L);
}

// A module name only qualifies what the module declares. The message names the module the way
// the file does, the last segment of its path or the alias an import bound it to.
test "a module's name is not a value" {
    let loader = new FakeFileLoader();
    aliasingLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import lib.colors;\n"
        + "import lib.sizes as sizing;\n"
        + "main() -> int \{\n"
        + "    let named = colors;\n"
        + "    let aliased = sizing;\n"
        + "    return sizing.measure(new sizing.Ruler(2));\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'colors' names a module, not a value. A module name reaches what the module declares, "
        + "as in 'colors.pick(...)'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'sizing' names a module, not a value. A module name reaches what the module declares, "
        + "as in 'sizing.measure(...)'.");
    try testing.assertEqual(reported.length, 2L);
}


// A module the file can call nothing in has no example to offer, and one whose function throws
// keeps the 'try' the call needs.
test "a module's name is refused with a call only where it declares one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/quiet.ens",
        "public class Only \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib/risky.ens",
        "public class Failure extends Error \{\n"
        + "    public constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public risked(int value) throws Failure \{\n"
        + "    if (value < 0) \{\n"
        + "        throw new Failure(\"negative\");\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.quiet;\n"
        + "import lib.risky;\n"
        + "main() -> int \{\n"
        + "    let a = quiet;\n"
        + "    let b = risky;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'quiet' names a module, not a value.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'risky' names a module, not a value. A module name reaches what the module declares, "
        + "as in 'try risky.risked(...)'.");
    try testing.assertEqual(reported.length, 2L);
}
// A module-qualified name in a value position reads as what it is. A function this file can
// reach reads as a function, one it cannot reach as a visibility refusal, a name the module does
// not declare as absent, and a type as the type it is. The call in the message keeps the module
// as this file writes it, and the example is left out where this file has no name for the
// function's own types.
test "a module-qualified name in a value position reports what it is" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/vault.ens",
        "public class Vault \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib/parts.ens",
        "import Vault from lib.vault;\n"
        + "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "class Secret \{\n"
        + "\}\n"
        + "public shown(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "hidden() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "public keeper() -> Vault \{\n"
        + "    return new Vault();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "main() -> int \{\n"
        + "    let visible = parts.shown;\n"
        + "    let unspellable = parts.keeper;\n"
        + "    let unreachable = parts.hidden;\n"
        + "    let absent = parts.nosuch;\n"
        + "    let hiddenType = parts.Secret;\n"
        + "    let heldType = parts.Widget;\n"
        + "    parts.Widget widget = new parts.Widget();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.shown' is a function, and a function's name is not a value. Call it as "
        + "'parts.shown(...)', or hold a lambda in a declared function type, as in "
        + "'(int) -> int callback = (value) -> parts.shown(value);'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'parts.keeper' is a function, and a function's name is not a value. Call it as "
        + "'parts.keeper(...)', or hold a lambda in a declared function type.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Function 'hidden' is private to module 'lib.parts', so only that file can use it. Mark "
        + "it 'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'nosuch' is not declared in module 'lib.parts'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "Type 'Secret' is private to module 'lib.parts', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'parts.Widget' is a type, not a value. Write 'new parts.Widget()' to construct one.");
    try testing.assertEqual(reported.length, 6L);
}

// The same name a value position refuses is what a type position is written with. A field, a
// parameter, a return type, a type argument, an array element, 'new', 'is', 'as?', a 'throws'
// list and a catch clause all take it.
test "a module-qualified type name stays a type in every type position" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/lib/parts.ens",
        "public interface Shape \{\n"
        + "    size() -> int;\n"
        + "\}\n"
        + "public class Failure extends Error \{\n"
        + "    public constructor(string message) \{\n"
        + "        super(message);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Widget implements Shape \{\n"
        + "    public constructor();\n"
        + "    public override size() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Crate<T> \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "import lib.parts as parts;\n"
        + "public class Holder \{\n"
        + "    parts.Widget widget;\n"
        + "    public constructor(this.widget);\n"
        + "\}\n"
        + "keeps(parts.Shape shape, parts.Crate<int> crate) -> parts.Widget? \{\n"
        + "    parts.Widget[] all = [new parts.Widget()];\n"
        + "    let listed = new List<parts.Widget>();\n"
        + "    let held = new Holder(all[0]);\n"
        + "    if (shape is parts.Widget) \{\n"
        + "        return all[0];\n"
        + "    \}\n"
        + "    return shape as? parts.Widget;\n"
        + "\}\n"
        + "guards() throws parts.Failure \{\n"
        + "    throw new parts.Failure(\"boom\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    try guards();\n"
        + "    return 0;\n"
        + "\} catch (parts.Failure failure) \{\n"
        + "    return 1;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}


// The classes the type-as-value refusal branches over: a construction this file can reach with
// no argument and with arguments, one it reaches through a base class, two whose constructor it
// cannot reach, an abstract class with and without a static, and a generic class with and
// without one.
classKinds() -> string {
    return "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Sizer \{\n"
        + "    public int size;\n"
        + "\n"
        + "    public constructor(this.size);\n"
        + "\}\n"
        + "public class Derived extends Widget \{\n"
        + "\}\n"
        + "public class Vault \{\n"
        + "    constructor();\n"
        + "\n"
        + "    public static open() -> Vault \{\n"
        + "        return new Vault();\n"
        + "    \}\n"
        + "\}\n"
        + "public class Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "public class Counter \{\n"
        + "    public static const int limit = 10;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public abstract class Shape \{\n"
        + "    public static const int sides = 3;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public abstract area() -> int;\n"
        + "\}\n"
        + "public abstract class Plain \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public abstract area() -> int;\n"
        + "\}\n"
        + "public class Holder<T> \{\n"
        + "    public static const int limit = 4;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Crate<T> \{\n"
        + "    public constructor();\n"
        + "\}\n";
}

// The interface, enum, and structs the same refusal branches over: a struct with a constructor,
// one built from a literal, one every field of which has a default, and one whose field this file
// cannot set.
valueKinds() -> string {
    return "public interface Shown \{\n"
        + "    size() -> int;\n"
        + "\}\n"
        + "public enum Kind \{\n"
        + "    Large,\n"
        + "    Small,\n"
        + "\}\n"
        + "public struct Point \{\n"
        + "    public int x;\n"
        + "    public int y;\n"
        + "\}\n"
        + "public struct Made \{\n"
        + "    public int a;\n"
        + "\n"
        + "    public constructor(this.a);\n"
        + "\}\n"
        + "public struct Defaulted \{\n"
        + "    public int w = 1;\n"
        + "\}\n"
        + "public struct Hidden \{\n"
        + "    int secret;\n"
        + "\}\n";
}

// Every kind of type a class declaration makes, written where a value belongs. A class names the
// construction this file can reach, an abstract one names where a value comes from instead, and a
// class whose constructor this file cannot reach names nothing. A reachable static is named
// alongside, and a generic class names only a static, since its construction would need type
// arguments.
test "a bare class name in a value position names the construction this file can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", classKinds());
    loader.add("/proj/src/main.ens",
        "import Widget from lib.parts;\n"
        + "import Sizer from lib.parts;\n"
        + "import Derived from lib.parts;\n"
        + "import Vault from lib.parts;\n"
        + "import Locked from lib.parts;\n"
        + "import Counter from lib.parts;\n"
        + "import Shape from lib.parts;\n"
        + "import Plain from lib.parts;\n"
        + "import Holder from lib.parts;\n"
        + "import Crate from lib.parts;\n"
        + "main() -> int \{\n"
        + "    let a = Widget;\n"
        + "    let b = Sizer;\n"
        + "    let c = Derived;\n"
        + "    let d = Vault;\n"
        + "    let e = Locked;\n"
        + "    let f = Counter;\n"
        + "    let g = Shape;\n"
        + "    let h = Plain;\n"
        + "    let i = Holder;\n"
        + "    let j = Crate;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Widget' is a type, not a value. Write 'new Widget()' to construct one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Sizer' is a type, not a value. Write 'new Sizer(...)' to construct one.");
    // A class with no constructor of its own is constructed through its base class's.
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Derived' is a type, not a value. Write 'new Derived()' to construct one.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Vault' is a type, not a value. Write 'Vault.open(...)' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Locked' is a type, not a value.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Counter' is a type, not a value. Write 'new Counter()' to construct one, or write "
        + "'Counter.limit' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'Shape' is a type, not a value. Use a value of a subclass that is not abstract, or "
        + "write 'Shape.sides' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'Plain' is a type, not a value. Use a value of a subclass that is not abstract.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'Holder' is a type, not a value. Write 'Holder.limit' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'Crate' is a type, not a value.");
    try testing.assertEqual(reported.length, 10L);
}

// An interface has no instances of its own, an enum's values are its constants, and a struct
// value is a constructor call or an aggregate literal. A struct whose literal would have to set
// a field this file cannot set names nothing.
test "a bare interface, enum, or struct name says what a value of that kind is" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", valueKinds());
    loader.add("/proj/src/main.ens",
        "import Shown from lib.parts;\n"
        + "import Kind from lib.parts;\n"
        + "import Point from lib.parts;\n"
        + "import Made from lib.parts;\n"
        + "import Defaulted from lib.parts;\n"
        + "import Hidden from lib.parts;\n"
        + "main() -> int \{\n"
        + "    let a = Shown;\n"
        + "    let b = Kind;\n"
        + "    let c = Point;\n"
        + "    let d = Made;\n"
        + "    let e = Defaulted;\n"
        + "    let f = Hidden;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Shown' is a type, not a value. Use a value of a class that implements it.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Kind' is a type, not a value. Write 'Kind.Large' to name one of its constants.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Point' is a type, not a value. Write 'Point value = \{x: ..., y: ...\};' to build "
        + "one.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Made' is a type, not a value. Write 'Made(...)' to construct one.");
    // Every field of this one has a default, so a literal that sets nothing builds it.
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Defaulted' is a type, not a value. Write 'Defaulted value = \{\};' to build one.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Hidden' is a type, not a value.");
    try testing.assertEqual(reported.length, 6L);
}

// A type is refused the same way whether an import brought its name in or the file declares it,
// so one case of each kind is read here against the declarations of the file it is written in.
test "a type this file declares is refused as a value by the kind of type it is" {
    let analysis = try analyzeOne(classKinds() + valueKinds()
        + "main() -> int \{\n"
        + "    let a = Widget;\n"
        + "    let b = Shape;\n"
        + "    let c = Shown;\n"
        + "    let d = Kind;\n"
        + "    let e = Point;\n"
        + "    let f = Holder;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Widget' is a type, not a value. Write 'new Widget()' to construct one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Shape' is a type, not a value. Use a value of a subclass that is not abstract, or "
        + "write 'Shape.sides' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Shown' is a type, not a value. Use a value of a class that implements it.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Kind' is a type, not a value. Write 'Kind.Large' to name one of its constants.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Point' is a type, not a value. Write 'Point value = \{x: ..., y: ...\};' to build "
        + "one.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Holder' is a type, not a value. Write 'Holder.limit' to reach a static member.");
    try testing.assertEqual(reported.length, 6L);
}

// A local, a parameter, and a module function each take the name from this file's type of the
// same name, and the type still reads in a type position. Two lines of the program are refused:
// a function's name is not a value either, and the type nothing shadows is refused as a type.
test "a local, a parameter, or a module function of the same name keeps it from a type" {
    let analysis = try analyzeOne("public class Same \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Thing \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "Thing() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "localTakesTheName() -> int \{\n"
        + "    int Same = 3;\n"
        + "    return Same + 1;\n"
        + "\}\n"
        + "parameterTakesTheName(int Same) -> int \{\n"
        + "    return Same + 1;\n"
        + "\}\n"
        + "moduleFunctionTakesTheName() -> int \{\n"
        + "    return Thing();\n"
        + "\}\n"
        + "aTypePositionReadsTheType() -> bool \{\n"
        + "    Thing? held = null;\n"
        + "    return held == null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let a = Thing;\n"
        + "    let b = Same;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Thing' is a function, and a function's name is not a value. Call it as 'Thing(...)', "
        + "or hold a lambda in a declared function type, as in '() -> int callback = () -> "
        + "Thing();'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Same' is a type, not a value. Write 'new Same()' to construct one.");
    try testing.assertEqual(reported.length, 2L);
}

// Nothing written after a module-qualified head resolves, so the routes that need the type's own
// name are left out: a static, an enum constant, and a struct's constructor call. 'new' and an
// aggregate literal both take such a head, so those two are offered.
test "a module-qualified type name offers only what its head reaches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", classKinds() + valueKinds());
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "main() -> int \{\n"
        + "    let a = parts.Counter;\n"
        + "    let b = parts.Vault;\n"
        + "    let c = parts.Shown;\n"
        + "    let d = parts.Kind;\n"
        + "    let e = parts.Made;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.Counter' is a type, not a value. Write 'new parts.Counter()' to construct one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'parts.Vault' is a type, not a value.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'parts.Shown' is a type, not a value. Use a value of a class that implements it.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'parts.Kind' is a type, not a value.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'parts.Made' is a type, not a value. Write 'parts.Made value = \{a: ...\};' to build "
        + "one.");
    try testing.assertEqual(reported.length, 5L);
}

// A construction the receiver's type arguments exclude is not offered. This class declares no
// constructor, so it would run the one its base class declares, and that one exists only for a
// type argument its own does not satisfy.
test "a class whose base constructor a constraint excludes is offered no construction" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens",
        "public interface Ordered<T> \{\n"
        + "    compareTo(T other) -> int;\n"
        + "\}\n"
        + "public class Plain \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Holder<T> \{\n"
        + "    public constructor<T: Ordered<T>>();\n"
        + "\}\n"
        + "public class Derived extends Holder<Plain> \{\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Derived from lib.parts;\n"
        + "main() -> int \{\n"
        + "    let held = Derived;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Derived' is a type, not a value.");
    try testing.assertEqual(reported.length, 1L);
}

// Every kind of type written as the callee of a call, which reaches the routes a value of it
// takes: a construction this file can reach, a static factory, an enum constant, or nothing. A
// primitive's values are its literals, which the refusal leaves to the reader.
test "a type name written as a callee offers the routes a value of it takes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens", classKinds() + valueKinds());
    loader.add("/proj/src/main.ens",
        "import Widget from lib.parts;\n"
        + "import Sizer from lib.parts;\n"
        + "import Derived from lib.parts;\n"
        + "import Vault from lib.parts;\n"
        + "import Locked from lib.parts;\n"
        + "import Counter from lib.parts;\n"
        + "import Shape from lib.parts;\n"
        + "import Plain from lib.parts;\n"
        + "import Holder from lib.parts;\n"
        + "import Crate from lib.parts;\n"
        + "import Shown from lib.parts;\n"
        + "import Kind from lib.parts;\n"
        + "main() -> int \{\n"
        + "    let a = Widget();\n"
        + "    let b = Sizer(3);\n"
        + "    let c = Derived();\n"
        + "    let d = Vault();\n"
        + "    let e = Locked();\n"
        + "    let f = Counter();\n"
        + "    let g = Shape();\n"
        + "    let h = Plain();\n"
        + "    let i = Holder();\n"
        + "    let j = Crate();\n"
        + "    let k = Shown();\n"
        + "    let l = Kind(1);\n"
        + "    let m = int(3);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Widget' is a type, not a function. Write 'new Widget()' to construct one.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Sizer' is a type, not a function. Write 'new Sizer(...)' to construct one.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Derived' is a type, not a function. Write 'new Derived()' to construct one.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Vault' is a type, not a function. Write 'Vault.open(...)' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Locked' is a type, not a function.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Counter' is a type, not a function. Write 'new Counter()' to construct one, or write "
        + "'Counter.limit' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'Shape' is a type, not a function. Use a value of a subclass that is not abstract, or "
        + "write 'Shape.sides' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'Plain' is a type, not a function. Use a value of a subclass that is not abstract.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'Holder' is a type, not a function. Write 'Holder.limit' to reach a static member.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'Crate' is a type, not a function.");
    try sema_support.assertDiagnostic(reported, 10, "/proj/src/main.ens",
        "'Shown' is a type, not a function. Use a value of a class that implements it.");
    try sema_support.assertDiagnostic(reported, 11, "/proj/src/main.ens",
        "'Kind' is a type, not a function. Write 'Kind.Large' to name one of its constants.");
    try sema_support.assertDiagnostic(reported, 12, "/proj/src/main.ens",
        "'int' is a type, not a function.");
    try testing.assertEqual(reported.length, 13L);
}

// A module name and a module-qualified type name written as callees read the same examples their
// value position offers, and a module this file can call nothing in offers none.
test "a module name written as a callee is refused with a call the module declares" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/quiet.ens",
        "public class Only \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib/parts.ens",
        "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public shown(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import lib.quiet;\n"
        + "import lib.parts;\n"
        + "main() -> int \{\n"
        + "    let a = quiet();\n"
        + "    let b = parts(1);\n"
        + "    let c = parts.Widget();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'quiet' names a module, not a function.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'parts' names a module, not a function. A module name reaches what the module "
        + "declares, as in 'parts.shown(...)'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'parts.Widget' is a type, not a function. Write 'new parts.Widget()' to construct "
        + "one.");
    try testing.assertEqual(reported.length, 3L);
}

// A type parameter is a different type at each use, so a value of it is the only route offered,
// and a bound adds none: a static is refused through a parameter whatever it is bounded by. A
// name that is no parameter of the declaration reading it is still undefined.
test "a type parameter is refused in a value position and as a callee" {
    let analysis = try analyzeOne("public interface Shown \{\n"
        + "    size() -> int;\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public static const int limit = 4;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Unbounded<Tag> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reads() \{\n"
        + "        let held = Tag;\n"
        + "    \}\n"
        + "\n"
        + "    calls() \{\n"
        + "        let made = Tag(3);\n"
        + "    \}\n"
        + "\}\n"
        + "public class ClassBound<Tag: Base> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reads() \{\n"
        + "        let held = Tag;\n"
        + "    \}\n"
        + "\n"
        + "    reachesAStatic() \{\n"
        + "        let limit = Tag.limit;\n"
        + "    \}\n"
        + "\}\n"
        + "public class InterfaceBound<Tag: Shown> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reads() \{\n"
        + "        let held = Tag;\n"
        + "    \}\n"
        + "\}\n"
        + "carries<Tag>() \{\n"
        + "    let held = Tag;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let absent = Tag;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as a parameter "
        + "declared 'Tag value'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Tag' is a type parameter, not a function. Use a value of type 'Tag', such as a "
        + "parameter declared 'Tag value'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as a parameter "
        + "declared 'Tag value'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Statics cannot be reached through a type parameter: 'Tag' is a different type each "
        + "time it is used, so 'Tag.member' names nothing fixed. Write the type's own name "
        + "instead.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as a parameter "
        + "declared 'Tag value'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Tag' is a type parameter, not a value. Use a value of type 'Tag', such as a parameter "
        + "declared 'Tag value'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "Undefined name 'Tag'. Check the spelling, or declare it before it is used.");
    try testing.assertEqual(reported.length, 7L);
}

// A type parameter takes its name for the whole of the declaration that introduces it, so the
// meaning the name has outside is unreachable inside. One refusal covers every position, and it
// names what the parameter took the name from: a type or a function this file declares, a type
// it imports, a module it imports, or a static of the type that introduces the parameter, which
// the type name still reaches.
test "a type parameter that took its name from another meaning names both" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib/parts.ens",
        "public class Widget \{\n"
        + "    public static const int limit = 7;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public shown(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Widget from lib.parts;\n"
        + "import lib.parts;\n"
        + "public enum Kind \{\n"
        + "    Large,\n"
        + "\}\n"
        + "public struct Made \{\n"
        + "    public int a;\n"
        + "\n"
        + "    public constructor(this.a);\n"
        + "\}\n"
        + "public class Holder \{\n"
        + "    public static const int size = 1;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "helper(int value) -> int \{\n"
        + "    return value;\n"
        + "\}\n"
        + "public class ValueOfEnum<Kind> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    readsIt() \{\n"
        + "        let held = Kind;\n"
        + "    \}\n"
        + "\}\n"
        + "public class ConstantOfEnum<Kind> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reachesIt() \{\n"
        + "        let held = Kind.Large;\n"
        + "    \}\n"
        + "\}\n"
        + "public class CallOfStruct<Made> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    callsIt() \{\n"
        + "        let held = Made(3);\n"
        + "    \}\n"
        + "\}\n"
        + "public class StaticOfClass<Holder> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reachesIt() \{\n"
        + "        let held = Holder.size;\n"
        + "    \}\n"
        + "\}\n"
        + "public class CallOfFunction<helper> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    callsIt() \{\n"
        + "        let held = helper(1);\n"
        + "    \}\n"
        + "\}\n"
        + "public class StaticOfImport<Widget> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    reachesIt() \{\n"
        + "        let held = Widget.limit;\n"
        + "    \}\n"
        + "\}\n"
        + "public class CallOfModule<parts> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    callsIt() \{\n"
        + "        let held = parts.shown(1);\n"
        + "    \}\n"
        + "\}\n"
        + "public class StaticConstOwner<Limit> \{\n"
        + "    public static const int Limit = 3;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    readsIt() \{\n"
        + "        let held = Limit;\n"
        + "    \}\n"
        + "\}\n"
        + "public class StaticMethodOwner<make> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static make() -> int \{\n"
        + "        return 1;\n"
        + "    \}\n"
        + "\n"
        + "    callsIt() \{\n"
        + "        let held = make();\n"
        + "    \}\n"
        + "\}\n"
        + "carries<Kind>() \{\n"
        + "    let held = Kind.Large;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Kind' is the type parameter of 'ValueOfEnum' here, not the enum this file declares, "
        + "because a type parameter takes the name for the whole of 'ValueOfEnum'. Rename one "
        + "of the two.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Kind' is the type parameter of 'ConstantOfEnum' here, not the enum this file "
        + "declares, because a type parameter takes the name for the whole of 'ConstantOfEnum'. "
        + "Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'Made' is the type parameter of 'CallOfStruct' here, not the struct this file "
        + "declares, because a type parameter takes the name for the whole of 'CallOfStruct'. "
        + "Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Holder' is the type parameter of 'StaticOfClass' here, not the class this file "
        + "declares, because a type parameter takes the name for the whole of 'StaticOfClass'. "
        + "Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'helper' is the type parameter of 'CallOfFunction' here, not the function this file "
        + "declares, because a type parameter takes the name for the whole of 'CallOfFunction'. "
        + "Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Widget' is the type parameter of 'StaticOfImport' here, not the class declared in "
        + "module 'lib.parts', because a type parameter takes the name for the whole of "
        + "'StaticOfImport'. Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'parts' is the type parameter of 'CallOfModule' here, not the module 'lib.parts' this "
        + "file imports, because a type parameter takes the name for the whole of "
        + "'CallOfModule'. Rename one of the two.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'Limit' is the type parameter of 'StaticConstOwner' here, not the static const it "
        + "declares. Write 'StaticConstOwner.Limit' to read the static.");
    // A static method of a generic type is called through the type name with its parameters
    // written, because nothing else in such a call determines its type arguments.
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'make' is the type parameter of 'StaticMethodOwner' here, not the static method it "
        + "declares. Write 'StaticMethodOwner<make>.make(...)' to call the static.");
    try sema_support.assertDiagnostic(reported, 9, "/proj/src/main.ens",
        "'Kind' is the type parameter of 'carries' here, not the enum this file declares, "
        + "because a type parameter takes the name for the whole of 'carries'. Rename one of "
        + "the two.");
    try testing.assertEqual(reported.length, 10L);
}

// A field default and a parameter default are built once per instantiation, where each type
// parameter stands for one written type argument. So both write one as a type argument, as an
// array element, as a lambda's parameter type, and as the argument of a generic type's static.
test "a type parameter is a type inside a field default and a parameter default" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "public class Zero<T> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public static count() -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Kept<Tag> \{\n"
        + "    public List<Tag> items = new List<Tag>();\n"
        + "    public Tag?[] slots = new Tag?[2];\n"
        + "    public (Tag) -> long weigh = (held) -> 1;\n"
        + "    public long zeroed = Zero<Tag>.count();\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public counts(List<Tag> more = new List<Tag>()) -> long \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair<Left> \{\n"
        + "    public List<Left> lefts = new List<Left>();\n"
        + "    public Left carried;\n"
        + "\n"
        + "    public constructor(this.carried);\n"
        + "\}\n"
        + "carries<Value>(List<Value> items = new List<Value>()) -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let kept = new Kept<int>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// The refusal names a parameter of the type in reach, else the parameter a callable's body can
// declare. A default has neither, unless a lambda inside it brings its own.
test "a type parameter written as a value names the route its own position has" {
    let analysis = try analyzeOne("public enum Kind \{\n"
        + "    Large,\n"
        + "\}\n"
        + "public class Alone<Slot> \{\n"
        + "    public int bare = Slot;\n"
        + "    public int made = Slot(3);\n"
        + "    public int got = Slot.size;\n"
        + "    public ((Slot) -> long) weigh = (each) -> Slot;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Collides<Kind> \{\n"
        + "    public int held = Kind.Large;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Defaulted<Mark> \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public takes(Mark given, int other = Mark) -> int \{\n"
        + "        return other;\n"
        + "    \}\n"
        + "\n"
        + "    reads() \{\n"
        + "        let held = Mark;\n"
        + "    \}\n"
        + "\n"
        + "    reachesIt(Mark given) \{\n"
        + "        let held = Mark;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'Slot' is a type parameter, not a value.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Slot' is a type parameter, not a function.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Statics cannot be reached through a type parameter: 'Slot' is a different type each "
        + "time it is used, so 'Slot.member' names nothing fixed. Write the type's own name "
        + "instead.");
    // The lambda declares a parameter of the type the default around it cannot.
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'Slot' is a type parameter, not a value. Use a value of type 'Slot', such as "
        + "'each'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'Kind' is the type parameter of 'Collides' here, not the enum this file declares, "
        + "because a type parameter takes the name for the whole of 'Collides'. Rename one of "
        + "the two.");
    // A parameter default sees neither its siblings nor 'this', so 'given' is out of reach.
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'Mark' is a type parameter, not a value.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'Mark' is a type parameter, not a value. Use a value of type 'Mark', such as a "
        + "parameter declared 'Mark value'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'Mark' is a type parameter, not a value. Use a value of type 'Mark', such as "
        + "'given'.");
    try testing.assertEqual(reported.length, 8L);
}

// A method is reached by calling it, through 'this', through a value, or through '?.'. The name
// on its own is refused in each of the three, and a write to it is refused as a write, whether
// the write is an assignment or a '++'.
test "a method's name is not a value" {
    let analysis = try analyzeOne("public class Counter \{\n"
        + "    int count;\n"
        + "\n"
        + "    public constructor() \{\n"
        + "        this.count = 0;\n"
        + "    \}\n"
        + "\n"
        + "    public bump(int by) -> int \{\n"
        + "        this.count = this.count + by;\n"
        + "        return this.count;\n"
        + "    \}\n"
        + "\n"
        + "    public readsItsOwn() \{\n"
        + "        let held = this.bump;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let counter = new Counter();\n"
        + "    let named = counter.bump;\n"
        + "    Counter? maybe = counter;\n"
        + "    let safe = maybe?.bump;\n"
        + "    counter.bump = 3;\n"
        + "    maybe?.bump = 3;\n"
        + "    (counter.bump) = 3;\n"
        + "    counter.bump++;\n"
        + "    return counter.bump(1);\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'bump' is a method of 'Counter', and a method's name is not a value. Call "
        + "it as 'bump(...)'.";
    for (long i = 0; i < 3; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", refused);
    }
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'bump' is a method of 'Counter', so it cannot be assigned.");
    // A '?.' left side and a parenthesized one each report their own refusal and the method,
    // since neither checking for null nor dropping the parentheses leaves a write that works.
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'?.' cannot appear on the left side of '=', because there is nothing to write to "
        + "when 'maybe' is null.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'bump' is a method of 'Counter', so it cannot be assigned.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "The left side of '=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses, so the left side reads "
        + "'counter.bump'.");
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'bump' is a method of 'Counter', so it cannot be assigned.");
    try sema_support.assertDiagnostic(reported, 8, "/proj/src/main.ens",
        "'bump' is a method of 'Counter', so it cannot be assigned.");
    try testing.assertEqual(reported.length, 9L);
}

// 'length' reports how much an array or a string holds, and neither has storage under that
// name, so a write to it is refused on a local, through a compound operator, through '++' and
// '--', on the result of a call, and on a 'T[]' inside a generic. The refusal names the type
// rather than the expression, so it reads the same for a value no name reaches, and an array's
// names the element type a replacement is created with.
test "'length' cannot be assigned" {
    let analysis = try analyzeOne("lengthOf<T>(T[] items) \{\n"
        + "    items.length = 3;\n"
        + "\}\n"
        + "names() -> string[] \{\n"
        + "    return [\"a\"];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int[] slots = new int[2];\n"
        + "    string text = \"ab\";\n"
        + "    slots.length = 3;\n"
        + "    slots.length += 1;\n"
        + "    slots.length++;\n"
        + "    --slots.length;\n"
        + "    text.length = 3;\n"
        + "    text.length--;\n"
        + "    names().length = 3;\n"
        + "    lengthOf<int>(new int[1]);\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofInts = "'length' is how many elements the 'int[]' holds, so it cannot be "
        + "assigned. An array keeps the length it was created with, so create a new one of the "
        + "size you need, as in 'new int[...]'.";
    string ofText = "'length' is how many bytes the 'string' holds, so it cannot be assigned. "
        + "A string never changes once it is made, so build the text you need and assign that.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'length' is how many elements the 'T[]' holds, so it cannot be assigned. An array "
        + "keeps the length it was created with, so create a new one of the size you need, as "
        + "in 'new T[...]'.");
    for (long i = 1; i < 5; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", ofInts);
    }
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens", ofText);
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens", ofText);
    try sema_support.assertDiagnostic(reported, 7, "/proj/src/main.ens",
        "'length' is how many elements the 'string[]' holds, so it cannot be assigned. An "
        + "array keeps the length it was created with, so create a new one of the size you "
        + "need, as in 'new string[...]'.");
    try testing.assertEqual(reported.length, 8L);
}

// An enum's members are its constants, so a write naming one is refused, whether the write is
// an assignment, a compound operator or a '++'; a read of the same name is not. A variable of
// the enum's type is refused by '++' for not being a number, which is what it is.
test "an enum's constant cannot be assigned" {
    let analysis = try analyzeOne("enum Color \{\n"
        + "    Red,\n"
        + "    Green,\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Color hue = Color.Red;\n"
        + "    Color.Red = Color.Green;\n"
        + "    Color.Green += 1;\n"
        + "    Color.Red++;\n"
        + "    hue++;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refusesRed = "'Red' is a constant of enum 'Color', so it cannot be assigned.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", refusesRed);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'Green' is a constant of enum 'Color', so it cannot be assigned.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", refusesRed);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "The '++' operator works only on numbers, and this value has type 'Color'. Use it on "
        + "an integer or a floating-point variable, for example 'count++'.");
    try testing.assertEqual(reported.length, 4L);
}

// A parenthesized left side is refused for its parentheses, and every rule about what they hold
// applies through them, so a 'const' field reports its own refusal beside them.
test "a parenthesized left side is refused for its parentheses" {
    let analysis = try analyzeOne("public class Holder \{\n"
        + "    public const int value;\n"
        + "\n"
        + "    public constructor() \{\n"
        + "        this.value = 1;\n"
        + "        (this.value) = 99;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let held = new Holder();\n"
        + "    (held.value) = 99;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The left side of '=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses, so the left side reads "
        + "'this.value'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Field 'value' is 'const' and may already be assigned when this line runs. Remove one "
        + "of the assignments.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "The left side of '=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses, so the left side reads "
        + "'held.value'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Cannot assign a new value to field 'value': it is 'const', so it is assigned exactly "
        + "once, inside a constructor of 'Holder' as 'this.value = ...'. Remove 'const' from "
        + "the field if it needs to change.");
    try testing.assertEqual(reported.length, 4L);
}

// The refusal names the target the parentheses hold at every nesting depth, and the operator
// the line was written with. It stops at the parentheses when the target is too long to quote.
test "a parenthesized left side names the target the parentheses hold" {
    let analysis = try analyzeOne("main() -> int \{\n"
        + "    int x = 1;\n"
        + "    (x) = 3;\n"
        + "    ((x)) = 4;\n"
        + "    (((x))) = 5;\n"
        + "    int[] slots = [1, 2, 3];\n"
        + "    (slots[0]) = 6;\n"
        + "    (slots[x + 1]) = 7;\n"
        + "    (x) += 1;\n"
        + "    return x;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string plain = "The left side of '=' must be a variable, field, or array element, and a "
        + "parenthesized expression is none of those. Remove the parentheses, so the left side "
        + "reads 'x'.";
    for (long i = 0; i < 3; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", plain);
    }
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "The left side of '=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses, so the left side reads "
        + "'slots[0]'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "The left side of '=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "The left side of '+=' must be a variable, field, or array element, and a parenthesized "
        + "expression is none of those. Remove the parentheses, so the left side reads 'x'.");
    try testing.assertEqual(reported.length, 6L);
}

// '++' and '--' refuse parentheses around what they change the same way, and reach the field
// behind them, so a 'const' field reports its own refusal beside them.
test "parentheses around what '++' changes are refused for themselves" {
    let analysis = try analyzeOne("public class Holder \{\n"
        + "    public const int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int x = 1;\n"
        + "    (x)++;\n"
        + "    ++(x);\n"
        + "    (x)--;\n"
        + "    let held = new Holder();\n"
        + "    (held.value)++;\n"
        + "    return x;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string afterOperator = "operator can only change a variable, a field, or an array element, "
        + "and a parenthesized expression is none of those. Remove the parentheses, so it "
        + "reads ";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The '++' " + afterOperator + "'x++'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The '++' " + afterOperator + "'++x'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "The '--' " + afterOperator + "'x--'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "The '++' " + afterOperator + "'held.value++'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "The '++' operator cannot change field 'value': a 'const' field is assigned once when "
        + "the object is constructed and never again. Remove 'const' from the field if it needs "
        + "to change.");
    try testing.assertEqual(reported.length, 5L);
}

// A left side that names no storage at all keeps the message saying what a left side has to be,
// with or without parentheses, since removing them would leave the same refusal.
test "a left side that names no storage keeps the message that says so" {
    let analysis = try analyzeOne("value() -> int \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int x = 1;\n"
        + "    value() = 3;\n"
        + "    1 = 3;\n"
        + "    (value()) = 3;\n"
        + "    (x as long) = 3;\n"
        + "    5++;\n"
        + "    return x;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens",
            "The left side of '=' must be a variable, field, or array element.");
    }
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "The '++' operator can only change a variable, a field, or an array element, for "
        + "example 'count++'.");
    try testing.assertEqual(reported.length, 5L);
}

// Parentheses anywhere but around a write target are ordinary grouping.
test "parentheses around a value, a condition and a call are untouched" {
    let analysis = try analyzeOne("adds(int a, int b) -> int \{\n"
        + "    return a + b;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int x = (1 + 2) * 3;\n"
        + "    x = (x);\n"
        + "    if ((x > 3) && (x < 100)) \{\n"
        + "        x = (adds(x, 1));\n"
        + "    \}\n"
        + "    while ((x) < 20) \{\n"
        + "        x = x + (1);\n"
        + "    \}\n"
        + "    int[] slots = [1, 2, 3];\n"
        + "    slots[(0)] = (adds(1, 2));\n"
        + "    (slots)[1] = 4;\n"
        + "    return (x) - (adds(0, 0));\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// 'this' names the object a method runs on, and no line can point it at a different one. A
// class, a struct, a constructor, a destructor and a compound operator reach one refusal, which
// redirects the write to a field, and parentheses around 'this' report that refusal rather than
// the one that says to remove them.
test "'this' cannot be assigned" {
    let analysis = try analyzeOne("public class Box \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public constructor(Box other) \{\n"
        + "        this = other;\n"
        + "    \}\n"
        + "\n"
        + "    destructor() \{\n"
        + "        this = new Box();\n"
        + "    \}\n"
        + "\n"
        + "    public replace(Box other) \{\n"
        + "        this = other;\n"
        + "        (this) = other;\n"
        + "        this += other;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Point \{\n"
        + "    public int x = 0;\n"
        + "\n"
        + "    public replace(Point other) \{\n"
        + "        this = other;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string plain = "'this' is not a variable, so it cannot be assigned. Assign the fields that "
        + "should change, as in 'this.value = ...'.";
    for (long i = 0; i < 4; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", plain);
    }
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'this' is not a variable, so it cannot be assigned. Assign the fields that should "
        + "change, as in 'this.value += ...'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, got 'Box' and 'Box'.");
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'this' is not a variable, so it cannot be assigned. Assign the fields that should "
        + "change, as in 'this.x = ...'.");
    try testing.assertEqual(reported.length, 7L);
}

// The field the refusal names is one the writing code can reach: a 'const' field takes its value
// at construction, a 'static' one is reached through the type name, and a private field of a
// base class is out of reach, so the refusal stops after saying what happened. An inherited
// field the subclass can reach is named like one of its own.
test "assigning 'this' names a field only where there is one to name" {
    let analysis = try analyzeOne("public class Frozen \{\n"
        + "    public const int kept = 1;\n"
        + "    public static const int shared = 2;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public replace(Frozen other) \{\n"
        + "        this = other;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    int hidden = 0;\n"
        + "    public int shown = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Derived extends Base \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public replace(Derived other) \{\n"
        + "        this = other;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'this' is not a variable, so it cannot be assigned.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'this' is not a variable, so it cannot be assigned. Assign the fields that should "
        + "change, as in 'this.shown = ...'.");
    try testing.assertEqual(reported.length, 2L);
}

// A member of a built-in type runs on a value, so '++', '--' and a compound operator reach the
// same refusal as a plain assignment there, and none of them names a field, because a built-in
// type has none.
test "a primitive's member cannot write the value it runs on" {
    let loader = new FakeFileLoader();
    loader.addToCore("primitive int \{\n"
        + "    export replaced() \{\n"
        + "        this = 5;\n"
        + "    \}\n"
        + "\n"
        + "    export stepped() \{\n"
        + "        this++;\n"
        + "        --this;\n"
        + "    \}\n"
        + "\n"
        + "    export grown() \{\n"
        + "        this += 1;\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    string core = "/stdlib/std/src/core.ens";
    try sema_support.assertDiagnostic(reported, 0, core,
        "'this' is not a variable, so it cannot be assigned.");
    try sema_support.assertDiagnostic(reported, 1, core,
        "'this' is not a variable, so '++' cannot change it.");
    try sema_support.assertDiagnostic(reported, 2, core,
        "'this' is not a variable, so '--' cannot change it.");
    try sema_support.assertDiagnostic(reported, 3, core,
        "'this' is not a variable, so it cannot be assigned.");
    try testing.assertEqual(reported.length, 4L);
}

// 'super' names the same object as 'this', seen as its base class, so it is refused the same way
// and the example reaches a field of the base, which the line after '++' writes to cleanly.
// '++' and '--' on it keep the message about numbers, because a base class is never a number.
test "'super' cannot be assigned" {
    let analysis = try analyzeOne("public class Base \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Derived extends Base \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public constructor(Base other) \{\n"
        + "        super = other;\n"
        + "    \}\n"
        + "\n"
        + "    public replace(Base other) \{\n"
        + "        super = other;\n"
        + "        (super) = other;\n"
        + "        super += other;\n"
        + "        super++;\n"
        + "        super.value = other.value;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Sealed \{\n"
        + "    int hidden = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Reopened extends Sealed \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    public replace(Sealed other) \{\n"
        + "        super = other;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string plain = "'super' is not a variable, so it cannot be assigned. Assign the fields that "
        + "should change, as in 'super.value = ...'.";
    for (long i = 0; i < 3; i++) {
        try sema_support.assertDiagnostic(reported, i, "/proj/src/main.ens", plain);
    }
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'super' is not a variable, so it cannot be assigned. Assign the fields that should "
        + "change, as in 'super.value += ...'.");
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, got 'Base' and 'Base'.");
    try sema_support.assertDiagnostic(reported, 5, "/proj/src/main.ens",
        "The '++' operator works only on numbers, and this value has type 'Base'. Use it on an "
        + "integer or a floating-point variable, for example 'count++'.");
    // 'Sealed' keeps its only field to itself, so 'Reopened' reaches none through 'super' and
    // the refusal names no field.
    try sema_support.assertDiagnostic(reported, 6, "/proj/src/main.ens",
        "'super' is not a variable, so it cannot be assigned.");
    try testing.assertEqual(reported.length, 7L);
}

// Where the keyword reaches no type at all, the write is not refused a second time: a static
// method, a function, and a class with no base class each report what the keyword needs, once,
// with or without parentheses around it.
test "assigning a keyword that reaches no type reports only that" {
    let analysis = try analyzeOne("public class Lone \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public replace(Lone other) \{\n"
        + "        super = other;\n"
        + "    \}\n"
        + "\n"
        + "    public static swap(Lone other) \{\n"
        + "        this = other;\n"
        + "    \}\n"
        + "\}\n"
        + "replaceFree(Lone other) \{\n"
        + "    this = other;\n"
        + "    (this) = other;\n"
        + "    super = other;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'super' cannot be used in 'Lone' because it has no base class.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'this' names the object a method was called on, and a static method is called on none. "
        + "Take the object as a parameter, or drop 'static'.");
    string inFunction = "'this' names the object a method was called on, and a function has "
        + "none. Take the object as a parameter, or move the code into a method of its type.";
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", inFunction);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens", inFunction);
    try sema_support.assertDiagnostic(reported, 4, "/proj/src/main.ens",
        "'super' reaches the base class of the object a method was called on, and a function "
        + "has none. Move the code into a method of the subclass.");
    try testing.assertEqual(reported.length, 5L);
}

// Everything else a method does with 'this' stays legal: it writes fields through it, passes it,
// returns it, calls methods on it, and a class's method captures it in a lambda.
test "reading and passing 'this' stays legal" {
    let analysis = try analyzeOne("public class Box \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public own() -> Box \{\n"
        + "        this.value = 7;\n"
        + "        this.value++;\n"
        + "        takes(this);\n"
        + "        return this.itself();\n"
        + "    \}\n"
        + "\n"
        + "    public itself() -> Box \{\n"
        + "        () -> int read = () -> this.value;\n"
        + "        this.value = read();\n"
        + "        return this;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Point \{\n"
        + "    public int x = 0;\n"
        + "\n"
        + "    public write() -> int \{\n"
        + "        this.x = 4;\n"
        + "        this.x++;\n"
        + "        takesPoint(this);\n"
        + "        return this.read();\n"
        + "    \}\n"
        + "\n"
        + "    public read() -> int \{\n"
        + "        return this.x;\n"
        + "    \}\n"
        + "\}\n"
        + "takes(Box box) \{\n"
        + "\}\n"
        + "takesPoint(Point point) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

// '?.' and '?[' read null when what stands in front of them is null, so a write through either
// has nowhere to store into. The refusal names the operator the line used and the value to check,
// and spells that line without its '?' inside a null check.
test "a write through safe navigation is refused for the null it may find" {
    let analysis = try analyzeOne("public class Inner \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Outer \{\n"
        + "    public Inner? inner = null;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Inner? maybe = null;\n"
        + "    int[]? slots = null;\n"
        + "    maybe?.value = 3;\n"
        + "    slots?[0] = 4;\n"
        + "    (maybe?.value) = 5;\n"
        + "    let held = new Outer();\n"
        + "    held.inner?.value = 6;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string member = "'?.' cannot appear on the left side of '=', because there is nothing "
        + "to write to when 'maybe' is null. Check for null first, as in 'if (maybe != null) "
        + "\{ maybe.value = ...; \}'.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", member);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'?[' cannot appear on the left side of '=', because there is nothing to write to "
        + "when 'slots' is null. Check for null first, as in "
        + "'if (slots != null) \{ slots[0] = ...; \}'.");
    // Parentheses around a safe write report the write, not the parentheses, since removing them
    // leaves the same refusal.
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens", member);
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'?.' cannot appear on the left side of '=', because there is nothing to write to when "
        + "'held.inner' is null. Check for null first, as in 'if (held.inner != null) "
        + "\{ held.inner.value = ...; \}'.");
    try testing.assertEqual(reported.length, 4L);
}

// A compound operator names itself in the refusal and reports its own problem beside it, because
// what '?.' read is a nullable rather than a number. The value checked is named on its own where
// the rest of the write is too long to quote, and nothing is named where the value itself is.
test "a safe write names what it can and stops where it cannot" {
    let analysis = try analyzeOne("public class Inner \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "public class Outer \{\n"
        + "    public Inner? inner = null;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Inner? maybe = null;\n"
        + "    int[]? slots = null;\n"
        + "    int i = 0;\n"
        + "    maybe?.value += 1;\n"
        + "    slots?[i + 1] = 7;\n"
        + "    Outer? outer = null;\n"
        + "    outer?.inner?.value = 8;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'?.' cannot appear on the left side of '+=', because there is nothing to write to when "
        + "'maybe' is null. Check for null first, as in 'if (maybe != null) "
        + "\{ maybe.value += ...; \}'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "'+=' needs numbers on both sides, got 'int?' and 'int'.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "'?[' cannot appear on the left side of '=', because there is nothing to write to "
        + "when 'slots' is null. Check for null first, then write the same line without "
        + "the '?'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "'?.' cannot appear on the left side of '=', because there is nothing to write to when the "
        + "value in front of it is null. Check for null first, then write the same line without "
        + "the '?'.");
    try testing.assertEqual(reported.length, 4L);
}

// '++' and '--' on a safe read never reach the write rule: the numeric check refuses a nullable
// first, and it says so the same way it does for any other nullable.
test "'++' on a safe read keeps the message about numbers" {
    let analysis = try analyzeOne("public class Inner \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Inner? maybe = null;\n"
        + "    maybe?.value++;\n"
        + "    --maybe?.value;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "The '++' operator works only on numbers, and this value has type 'int?'. Use it on an "
        + "integer or a floating-point variable, for example 'count++'.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "The '--' operator works only on numbers, and this value has type 'int?'. Use it on an "
        + "integer or a floating-point variable, for example '--count'.");
    try testing.assertEqual(reported.length, 2L);
}

// Reading through '?.' and '?[' stays legal everywhere a value is read: in a chain, as a call
// receiver, inside '??', in a condition, and as a call argument. So does the null check the
// refusal suggests, for a local, a parameter, a field, and an array element.
test "safe reads and the null check the refusal suggests stay legal" {
    let analysis = try analyzeOne("public class Inner \{\n"
        + "    public int value = 0;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public doubled() -> int \{\n"
        + "        return this.value * 2;\n"
        + "    \}\n"
        + "\}\n"
        + "public class Outer \{\n"
        + "    public Inner? inner = null;\n"
        + "\n"
        + "    public constructor();\n"
        + "\n"
        + "    public write() -> int \{\n"
        + "        if (this.inner != null) \{\n"
        + "            this.inner.value = 1;\n"
        + "        \}\n"
        + "        return this.inner?.value ?? 0;\n"
        + "    \}\n"
        + "\}\n"
        + "takes(int given) -> int \{\n"
        + "    return given;\n"
        + "\}\n"
        + "throughParameter(Inner? given) -> int \{\n"
        + "    if (given != null) \{\n"
        + "        given.value = 2;\n"
        + "    \}\n"
        + "    return given?.value ?? 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    Inner? maybe = new Inner();\n"
        + "    int[]? slots = [1, 2, 3];\n"
        + "    Outer? outer = new Outer();\n"
        + "    if (maybe != null) \{\n"
        + "        maybe.value = 3;\n"
        + "    \}\n"
        + "    if (slots != null) \{\n"
        + "        slots[0] = 4;\n"
        + "    \}\n"
        + "    int total = takes(maybe?.value ?? 0);\n"
        + "    total = total + (outer?.inner?.value ?? 0);\n"
        + "    total = total + (outer?.inner?.doubled() ?? 0);\n"
        + "    total = total + (slots?[1] ?? 0);\n"
        + "    if (maybe?.value != null) \{\n"
        + "        total = total + 1;\n"
        + "    \}\n"
        + "    return total + throughParameter(maybe);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}
