import @std.testing;
import List from @std.collections.list;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import IdentifierExpressionNode from @ens.frontend.syntax.generated.nodes;
import MemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import ParenthesizedExpressionNode from @ens.frontend.syntax.generated.nodes;
import SafeMemberExpressionNode from @ens.frontend.syntax.generated.nodes;
import SwitchExpressionNode from @ens.frontend.syntax.generated.nodes;
import TernaryExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import SemaResult from result;
import FakeFileLoader from sema_support;
import sema_support;

test "a clean body produces no diagnostics and fills the side tables" {
    let analysis = try sema_support.analyzeOne("main() -> int \{\n"
        + "    let total = 1 + 2;\n"
        + "    long widened = total;\n"
        + "    string text = \"total \{total\}\";\n"
        + "    if (widened > 2) \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "    return 1;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    try testing.assertTrue(context.result().resolvedTypeCount() > 5,
        "expression nodes should have recorded types");
}

test "a char reaching a floating-point type reports why, for a literal and for a variable" {
    let analysis = try sema_support.analyzeBody(["double fromLiteral = 'A';", "char letter = 'B';",
        "float fromVariable = letter;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "A 'char' is a character's number in Unicode, its code point, and it never converts to 'double' "
        + "on its own. Add 'as double' after the literal to use that number as a 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "A 'char' is a character's number in Unicode, its code point, and it never converts to 'float' on "
        + "its own. Write 'letter as float' to use that number as a 'float'.");
}

// A 'char' has no floating-point form behind a nullable target either.
test "a char assigned to a nullable floating-point target says why it is refused" {
    let analysis = try sema_support.analyzeBody(["float? ratio = 'a';"]);
    let diagnostics = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "A 'char' is a character's "
        + "number in Unicode, its code point, and it never converts to 'float' on its own. Add 'as float' "
        + "after the literal to use that number as a 'float'.");
    try testing.assertEqual(diagnostics.length, 1);
}

test "a discarded call that never returns is recorded as written, and a safe call is not" {
    let analysis = try sema_support.analyzeOne("class Logger \{\n"
        + "    constructor();\n"
        + "\n"
        + "    noreturn fail() \{\n"
        + "        panic(\"failed\");\n"
        + "    \}\n"
        + "\}\n"
        + "noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "use(int n, Logger? logger) \{\n"
        + "    logger?.fail();\n"
        + "    () -> void halt = () -> stop();\n"
        + "    switch (n) \{\n"
        + "        1 -> (stop()),\n"
        + "        default -> \{\n"
        + "            new Logger().fail();\n"
        + "        \},\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    use(0, null);\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let recorded = new List<string>();
    collectNeverReturning(root, context.result(), recorded);
    string[] expected = ["panic()", "panic()", "stop()", "(stop())", "fail()"];
    try testing.assertEqual(recorded.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(recorded.get(i), expected[i]);
    }
}

test "a for loop's initializer and update that never return are recorded as written" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "first(int n) -> int \{\n"
        + "    for (stop(); n < 3; n++) \{ \}\n"
        + "\}\n"
        + "later(int n) -> int \{\n"
        + "    for (; n < 3; (stop())) \{ \}\n"
        + "    return n;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return later(first(0));\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let recorded = new List<string>();
    collectNeverReturning(root, context.result(), recorded);
    string[] expected = ["panic()", "stop()", "(stop())"];
    try testing.assertEqual(recorded.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(recorded.get(i), expected[i]);
    }
}

test "a local whose initial value never returns ends the path and is recorded as written" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "first(int n) -> int \{\n"
        + "    let stopped = stop();\n"
        + "\}\n"
        + "later(int n) -> int \{\n"
        + "    for (let started = (stop()); n < 3; n++) \{ \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return later(first(0));\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let recorded = new List<string>();
    collectNeverReturning(root, context.result(), recorded);
    string[] expected = ["panic()", "stop()", "(stop())"];
    try testing.assertEqual(recorded.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(recorded.get(i), expected[i]);
    }
}

test "a branch or an arm that never returns is recorded, and so is a join of such values" {
    let analysis = try sema_support.analyzeOne("noreturn stop() \{\n"
        + "    panic(\"stop\");\n"
        + "\}\n"
        + "pick(bool flag, int n) -> int \{\n"
        + "    int chosen = flag ? 1 : (stop());\n"
        + "    long picked = switch (n) \{\n"
        + "        1 -> 2,\n"
        + "        default -> stop(),\n"
        + "    \};\n"
        + "    flag ? stop() : panic(\"both\");\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return pick(true, 1);\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
    let context = try sema_support.contextFor(analysis, "main");
    let root = context.root();
    if (root == null) {
        try testing.fail("module 'main' did not parse");
    }
    let recorded = new List<string>();
    collectNeverReturning(root, context.result(), recorded);
    string[] expected = ["panic()", "(stop())", "stop()", "a '?:'", "stop()", "panic()"];
    try testing.assertEqual(recorded.length(), expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(recorded.get(i), expected[i]);
    }
}

collectNeverReturning(SyntaxNode node, SemaResult result, List<string> found) {
    if (result.neverReturns(node.green())) {
        found.push(describeCall(node));
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        collectNeverReturning(children.get(i), result, found);
    }
}

describeCall(SyntaxNode node) -> string {
    switch (node) {
        is ParenthesizedExpressionNode parenthesized -> {
            return "(" + describeCall(parenthesized.inner()) + ")";
        },
        is CallExpressionNode call -> {
            let callee = call.callee();
            switch (callee) {
                is IdentifierExpressionNode identifier -> {
                    return identifier.name().text() + "()";
                },
                is MemberExpressionNode member -> {
                    return member.member().text() + "()";
                },
                is SafeMemberExpressionNode -> {
                    return "a safe call";
                },
                default -> {
                    return "a call";
                },
            }
        },
        is TernaryExpressionNode ignored -> {
            return "a '?:'";
        },
        is SwitchExpressionNode ignored -> {
            return "a switch";
        },
        default -> {
            return "another expression";
        },
    }
}

// What was embedded cannot change, so a folder's files are a 'FrozenList' of them, and a standard
// library without 'FrozenList' is named as the reason the files have no type.
test "an embedded folder is a frozen list of its files" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/embed.ens", "export struct EmbeddedFile \{\n"
        + "    export const string path;\n"
        + "    export const bytes contents;\n"
        + "\}\n");
    loader.add("/stdlib/std/src/collections/frozen.ens", "export shared final class FrozenList<T> \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.addFolder("/proj/src/assets");
    loader.add("/proj/src/assets/a.dat", "a");
    loader.add("/proj/src/main.ens", "main() -> int \{\n"
        + "    string shown = embed folder \"assets\";\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Variable 'shown' has type 'string', but its value has type 'FrozenList<EmbeddedFile>'.");
}

test "an embedded folder names the module of the frozen list the standard library lacks" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/embed.ens", "export struct EmbeddedFile \{\n"
        + "    export const string path;\n"
        + "    export const bytes contents;\n"
        + "\}\n");
    loader.addFolder("/proj/src/assets");
    loader.add("/proj/src/main.ens", "main() -> int \{\n"
        + "    let files = embed folder \"assets\";\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'embed folder' gives its files as a 'FrozenList', which the standard library declares in "
        + "module 'std.collections.frozen', and the standard library in use has no such module. "
        + "Pass the folder that holds the whole standard library with '--stdlib'.");
}
