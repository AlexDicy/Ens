import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "interfaces reject fields, bodies, modifiers, and typeless throws" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    int volume;\n"
        + "    speak() -> string \{ return \"\"; \}\n"
        + "    public quiet();\n"
        + "    loud() throws;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Interface 'Speaker' cannot declare field 'volume'. An interface lists only the methods a "
        + "type must provide. Remove the field, or move it into a class that implements "
        + "'Speaker'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Interface method 'speak' cannot have a body, because each implementing class provides its "
        + "own. Replace the body with ';'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A member of an interface always has the interface's own visibility. Remove 'public' from "
        + "'quiet'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'loud' of interface 'Speaker' is marked 'throws' but lists no exception types. "
        + "Without a body, the types it throws must be written out. List them after 'throws', as "
        + "in 'throws Error', or remove 'throws'.");
}

test "inheritance rejects cycles once, wrong bases, and cross-module sealing" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import Sealed from lib;\n"
        + "class A extends B \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class B extends A \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class OnValue extends Value \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "final class Locked \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class OnLocked extends Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class OnSealed extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "sealed final class Both \{\n"
        + "    constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib.ens",
        "public sealed class Sealed \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public class SameModule extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Class 'A' extends 'B', which extends 'A', so 'A' would be its own base class. Remove one "
        + "of the 'extends' clauses in that chain.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 4L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "'Value' is not a class, and only a class can be extended. Remove 'extends Value'.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Cannot extend 'Locked', because it is declared 'final'. Remove 'final' from 'Locked', or "
            + "stop extending it.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Cannot extend 'Sealed', because it is declared 'sealed', and only module 'lib' can extend "
        + "it. Move this class into 'lib', or stop extending 'Sealed'.");
    try sema_support.assertDiagnostic(signatures, 3, "/proj/src/app.ens",
        "Class 'Both' cannot be both 'sealed' and 'final'; 'final' already forbids every subclass. "
        + "Remove one of the two.");
}

test "enums and struct clauses are validated" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "enum Color \{ Red, Red \}\n"
        + "enum Hollow \{ \}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "struct Point extends Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "struct Dot implements Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class Twice \{\n"
        + "    int a;\n"
        + "    int a;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout, Stage.Checks]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 3L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Enum 'Color' already has a member named 'Red'. Remove this second 'Red', or rename it.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Enum 'Hollow' has no members. Declare at least one, as in 'enum Hollow \{ Red \}'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Struct 'Point' cannot use 'extends'. Only a class can have a base class. Remove the "
        + "'extends ...' clause, or make 'Point' a class.");
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Struct 'Dot' implements 'Speaker' but does not provide 'speak() -> string'. Declare the "
        + "method here, or stop implementing 'Speaker'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'a' is already declared in 'Twice'. Remove this second 'a', or rename it.");
}

test "interface extension rejects bad targets, cycles, redeclarations, and leaks" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Marker extends Widget \{\n"
        + "\}\n"
        + "interface Loop extends Loop \{\n"
        + "\}\n"
        + "interface Alpha extends Beta \{\n"
        + "\}\n"
        + "interface Beta extends Alpha \{\n"
        + "\}\n"
        + "interface Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Buffered extends Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Hidden \{\n"
        + "\}\n"
        + "public interface Wide extends Hidden \{\n"
        + "\}\n"
        + "class Busted implements Buffered \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout, Stage.Checks]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 3L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Interface 'Marker' cannot extend class 'Widget'; an interface extends an interface. Write "
        + "'class Widget implements Marker' instead.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Interface 'Loop' cannot extend itself. Remove 'extends Loop'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Interface 'Alpha' extends 'Beta', which extends 'Alpha', so 'Alpha' would extend itself. "
        + "Remove one of the 'extends' clauses in that chain.");
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 2L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Interface 'Buffered' already requires 'get() -> int', because it extends 'Source', which "
        + "declares it. Remove this second declaration of 'get'.");
    try sema_support.assertDiagnostic(checks, 1, "/proj/src/app.ens",
        "Interface 'Wide' is 'public', but the interface it extends, 'Hidden', is private to "
        + "module 'app'. Mark 'Hidden' 'public', or remove 'public' from 'Wide'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 2L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Class 'Busted' implements 'Buffered' but does not provide 'get() -> int'. Declare the "
        + "method, or inherit it from a base class.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Class 'Busted' implements 'Buffered' but does not provide 'get() -> int', required by "
        + "'Source', which 'Buffered' extends. Declare the method, or inherit it from a base class.");
}
