import @std.testing;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;
import Stage from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    return analysis;
}

// A body wrapped around statements, so a test shows the lines it is about.
inMain(string[] lines) -> string {
    string text = "main() -> int \{\n";
    for (let line in lines) {
        text = text + "    " + line + "\n";
    }
    return text + "    return 0;\n\}\n";
}

analyzeBody(string[] lines) -> ProgramAnalysis throws {
    return try analyzeOne(inMain(lines));
}

test "a literal that does not fit reports once, without a second operator error" {
    let analysis = try analyzeBody(["byte small = 3;", "byte sum = small + 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'small', a 'byte'. Declare 'sum' as 'ushort' and convert 'small' ('ushort sum = small as "
        + "ushort + 300;').");
}

test "a literal that does not fit a compared type reports once" {
    let analysis = try analyzeBody(["byte small = 3;", "let ordered = small < 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'small', a 'byte'. Convert 'small' first ('small as ushort < 300').");
}

test "an untyped literal adapts on either side of every bitwise operator" {
    let analysis = try analyzeBody(["uint flags = 0x12345678;",
        "uint low = flags & 0xFF;",
        "uint high = 0xFF00 | flags;",
        "uint flipped = flags ^ 0xFFFFFFFF;",
        "byte small = 0xF0;",
        "byte half = small >> 4;",
        "long wide = -16;",
        "long together = wide | 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a shift adapts an untyped distance to the value it shifts" {
    let analysis = try analyzeBody(["uint flags = 1;",
        "uint spread = flags << 8;",
        "ulong wide = 0xFF;",
        "ulong narrowed = wide >> 4;",
        "short signedHalf = -2;",
        "short doubled = signedHalf << 1;",
        "int word = -8;",
        "int dropped = word >>> 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the zero-filling shift follows the same operand rules as the other two" {
    let analysis = try analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags >>> spread;", "double places = 2.0;",
        "let moved = 64 >>> places;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'>>>' shifts a 'uint' here, so the shift distance must be a 'uint' too, but 'spread' has type "
            + "'byte'. Write 'spread as uint'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'>>>' needs an integer shift distance, but 'places' has type 'double'.");
}

test "two named integer types still need a cast on a bitwise operator" {
    let analysis = try analyzeBody(["uint flags = 1;", "int width = 255;",
        "let low = flags & width;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'&' needs the same integer type on both sides, but 'flags' has type 'uint' and 'width' has type "
            + "'int'. Convert both sides to 'long', as in 'flags as long & width as long'.");
}

test "a shift distance of another named type names the value's type in the fix" {
    let analysis = try analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags << spread;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'<<' shifts a 'uint' here, so the shift distance must be a 'uint' too, but 'spread' has type "
            + "'byte'. Write 'spread as uint'.");
}

test "an untyped literal left of a shift keeps its own type, so the distance is cast" {
    let analysis = try analyzeBody(["uint spread = 3;", "let mask = 1 << spread;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'<<' shifts an 'int' here, so the shift distance must be an 'int' too, but 'spread' has type "
            + "'uint'. Write 'spread as int'.");
}

test "a bitwise operator rejects a non-integer by name" {
    let analysis = try analyzeBody(["double scale = 2.5;", "let masked = scale & 1;",
        "let moved = 64 >> scale;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'&' needs integers on both sides, but 'scale' has type 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'>>' needs an integer shift distance, but 'scale' has type 'double'.");
}

test "a bitwise literal that does not fit reports once" {
    let analysis = try analyzeBody(["byte mask = 0x0F;", "byte bits = mask & 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'mask', a 'byte'. Declare 'bits' as 'ushort' and convert 'mask' ('ushort bits = mask as "
        + "ushort & 300;').");
}

test "the complement operator takes every integer type and keeps it" {
    let analysis = try analyzeBody(["byte small = 0x0F;", "byte flippedSmall = ~small;",
        "short signedHalf = 1;", "short flippedHalf = ~signedHalf;",
        "ushort halfWord = 1;", "ushort flippedWord = ~halfWord;",
        "int word = 5;", "int flippedInt = ~word;",
        "uint flags = 1;", "uint flippedFlags = ~flags;",
        "long wide = 1;", "long flippedWide = ~wide;",
        "ulong unsignedWide = 1;", "ulong flippedUnsigned = ~unsignedWide;",
        "char letter = 'A';", "char flippedLetter = ~letter;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the complement operator names the real type it refused" {
    let analysis = try analyzeBody(["double scale = 2.5;", "let flippedScale = ~scale;",
        "bool ready = true;", "let flippedReady = ~ready;",
        "string label = \"flags\";", "let flippedLabel = ~label;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 3);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'scale' has type 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'ready' has type 'bool'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/src/main.ens",
        "'~' flips the bits of an integer, but 'label' has type 'string'.");
}

test "a shift distance literal that does not fit reports once" {
    let analysis = try analyzeBody(["byte mask = 0x0F;", "byte bits = mask >> 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'mask', a 'byte'.");
}

test "an unsuffixed floating-point literal adapts to the surrounding float" {
    let analysis = try analyzeBody(["float declared = 1.0;", "declared = 2.5;",
        "declared += 0.5;", "float negative = -1.5;", "float precise = 0.1;",
        "float largest = 3.4e38;", "float[] elements = [1.0, 2.0];",
        "float sibling = declared + 1.0;", "float leftSide = 1.0 + declared;",
        "float ternary = true ? 1.0 : declared;", "double wide = 1.0;",
        "double fromFloat = 1.0f;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a floating-point literal past the type's largest value is refused" {
    let analysis = try analyzeBody(["float tooLarge = 3.5e38;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38. Declare "
            + "'tooLarge' as 'double' instead.");
}

test "a floating-point literal past every type names the widest one" {
    let analysis = try analyzeBody(["double tooLarge = 1e400;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 1e400 is too large for 'double', whose largest value is about 1.797e308.");
}

test "a negative floating-point literal keeps its sign in the diagnostic" {
    let analysis = try analyzeBody(["float tooSmall = -1e40;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal -1e40 is below the smallest value of 'float', which is about -3.402e38. Declare "
            + "'tooSmall' as 'double' instead.");
}

// The surrounding type reaches a literal directly under it, not one behind an operator, so
// this matches 'uint total = 1 + 4;' rather than diverging from it.
test "a floating-point literal behind an operator keeps the operands' own type" {
    let analysis = try analyzeBody(["float sum = 1.0 + 2.0;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'sum' has type 'float', but its value has type 'double'.");
}

test "an untyped integer literal takes a floating-point type from its surroundings" {
    let analysis = try analyzeBody(["float whole = 5;", "float negative = -5;",
        "double wide = 5;", "float rounded = 16777217;",
        "float largest = 9223372036854775807;", "float[] elements = [1, 2];",
        "float declared = 1.0;", "float sibling = declared + 2;",
        "float leftSide = 2 + declared;", "float ternary = true ? 3 : declared;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "an integer literal with a suffix keeps its type against a float target" {
    let analysis = try analyzeBody(["float suffixed = 5L;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'suffixed' has type 'float', but its value has type 'long'.");
}

// A code point is a name for a character, not a measurement, so it reaches the integer types on
// its own and needs a cast to reach a floating-point one.
test "a char reaches the integer types but no floating-point type on its own" {
    let analysis = try analyzeBody(["int asInteger = 'A';", "long wide = 'A';",
        "byte narrow = 'A';", "char letter = 'a';", "char masked = letter & 'a';",
        "char shifted = letter >> 1;", "char flipped = ~letter;",
        "double viaCast = 'A' as double;", "float narrowCast = 'A' as float;",
        "double fromVariable = letter as double;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a char reaching a floating-point type reports why, for a literal and for a variable" {
    let analysis = try analyzeBody(["double fromLiteral = 'A';", "char letter = 'B';",
        "float fromVariable = letter;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "A 'char' is a character's number in Unicode, its code point, and it never converts to 'double' "
        + "on its own. Add 'as double' after the literal to use that number as a 'double'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "A 'char' is a character's number in Unicode, its code point, and it never converts to 'float' on "
        + "its own. Write 'letter as float' to use that number as a 'float'.");
}

test "a literal nothing gives a type to must fit the default it falls back to" {
    let analysis = try analyzeBody(["let beyondInt = 3000000000;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 3000000000 is too large for 'int', whose largest value is 2147483647. Write "
            + "'3000000000L' to make it a 'long'.");
}

test "a literal past every integer type has no wider one to name" {
    let analysis = try analyzeBody(["let beyondEveryType = 99999999999999999999;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 99999999999999999999 is too large for every integer type. The widest, 'ulong', has "
            + "18446744073709551615 as its largest value.");
}

test "a suffix moves the default, and the value must fit that" {
    let analysis = try analyzeBody(["let beyondLong = 18446744073709551615L;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 18446744073709551615L is too large for 'long', whose largest value is "
            + "9223372036854775807. Write '18446744073709551615 as ulong'.");
}

test "an untyped floating-point literal past every type is reported too" {
    let analysis = try analyzeBody(["let beyondDouble = 1e400;", "let beyondFloat = 3.5e38f;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 2);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Literal 1e400 is too large for 'double', whose largest value is about 1.797e308.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens",
        "Literal 3.5e38f is too large for 'float', whose largest value is about 3.402e38. Remove "
            + "the 'f' from '3.5e38f'.");
}

// The sign is outside the literal, and it moves the boundary, so both ends of a type's range
// are reachable and neither end is a false alarm.
test "the most negative value of a type is not mistaken for an overflow" {
    let analysis = try analyzeBody(["let firstInt = -2147483648;", "let lastInt = 2147483647;",
        "let firstLong = -9223372036854775808L;", "long beyondInt = 3000000000;",
        "ulong beyondLong = 18446744073709551615;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a cast lets a literal the target holds stay exact, and still truncates one it cannot" {
    let analysis = try analyzeBody(["uint full = 4294967295 as uint;",
        "long wide = 3000000000 as long;", "byte truncated = 300 as byte;",
        "float narrowed = 1.5 as float;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a suffix names a floating-point literal's type, leaving nothing to adapt" {
    let analysis = try analyzeBody(["float suffixed = 3.0d;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens",
        "Variable 'suffixed' has type 'float', but its value has type 'double'.");
}

// The null check a refusal names for a stable place with one '?'.
checkFirst(string name) -> string {
    return "Check '{name}' for null first ('if ({name} != null)').";
}

// The null check a refusal names for a stable place with two '?'.
checkTwice(string name) -> string {
    return "Check '{name}' for null twice, once for each '?' ('if ({name} != null) \{ if ({name} "
        + "!= null) \{ ... \} \}').";
}

// The advice for the nullable field 'name' of 't', whose null check proves nothing for a later read.
unstableFieldAdvice(string name) -> string {
    return "'t.{name}' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let {name} = t.{name};') and "
        + "check the local.";
}

// unstableFieldAdvice for a field with two '?', whose copy is checked twice.
unstableFieldAdviceTwice(string name) -> string {
    return "'t.{name}' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check. Copy it into a local first ('let {name} = t.{name};') and check "
        + "the local twice, once for each '?' ('if ({name} != null) \{ if ({name} != null) \{ ... \} \}').";
}

// The advice for a nullable result of a call to 'callee', stored in the local 'name'.
storedAdvice(string callee, string name, string call) -> string {
    return "Each call to '{callee}' returns its own result. A later call can return null even after "
        + "a null check on an earlier one. Store the result in a local first ('let {name} = "
        + "{call};') and check the local.";
}

// The sentence that explains why a field 'name' read from the result of 'makeFixed()' can be null.
ofCall(string name) -> string {
    return "'makeFixed().{name}' is a field of the result of a call. Each call to 'makeFixed' returns "
        + "its own result, so a later read of 'makeFixed().{name}' can be null even after a null check.";
}

// The sentence that points two strings at 'compareTo'.
orderedAs(string first, string operator, string second) -> string {
    return "Order strings with 'compareTo', as in '{first}.compareTo({second}) {operator} 0'.";
}

// A nullable string on either side still makes '+' a join.
// The refusal names the null on either side, in the compound form, and at any depth.
test "a join with a nullable local is refused for the null, not for the numbers" {
    let analysis = try analyzeOne("join(string? label, bool flag, int? count, string?? deep) \{\n"
        + "    string numbered = label + 1;\n"
        + "    string leading = 1 + label;\n"
        + "    string trailed = label + \"x\";\n"
        + "    string prefixed = \"x\" + label;\n"
        + "    string doubled = label + label;\n"
        + "    string flagged = label + flag;\n"
        + "    label += 1;\n"
        + "    string counted = count + \"x\";\n"
        + "    string nested = deep + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joins = "joins a string only when neither side can be null, got";
    string label = checkFirst("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but both sides have type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'+=' joins a string only when neither side can be null, but 'label' has type 'string?'. {label}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+' joins a string only when neither side can be null, but 'count' has type 'int?'. "
        + "{checkFirst("count")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'+' joins a string only when neither side can be null, but 'deep' has type 'string??'. "
        + "{checkTwice("deep")}");
    try testing.assertEqual(reported.length, 9L);
}

// A join refused on a field also names the local copy to check.
test "a join with a nullable field names the null and the local copy" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected string? label = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "join(Tally t, bool flag) \{\n"
        + "    string numbered = t.label + 1;\n"
        + "    string leading = 1 + t.label;\n"
        + "    string trailed = t.label + \"x\";\n"
        + "    string prefixed = \"x\" + t.label;\n"
        + "    string doubled = t.label + t.label;\n"
        + "    string flagged = t.label + flag;\n"
        + "    t.label += 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joins = "joins a string only when neither side can be null, got";
    string advice = unstableFieldAdvice("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but both sides have type 'string?'. "
        + "{advice}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' joins a string only when neither side can be null, but 't.label' has type 'string?'. {advice}");
    try sema_support.assertDiagnostic(reported, 6, file, "'+=' joins a string only when neither side can "
        + "be null, but 't.label' has type 'string?'. 't.label' is a field, so it can change at any time. "
        + "A later read of it can be null even after a null check. Copy it into a local first ('let label "
        + "= t.label;'), check the local, and write the result back to 't.label'.");
    try testing.assertEqual(reported.length, 7L);
}

// A value with no text form is refused by name beside a nullable string, on either side.
test "a join refused for its type names that type beside a nullable string" {
    let analysis = try analyzeOne("class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "join(string? label, Shape shape) \{\n"
        + "    string trailed = label + shape;\n"
        + "    string leading = shape + label;\n"
        + "    string nothing = label + null;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string allowed = "Only a string, a number or a 'bool' can be added to one.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Cannot add a value of type 'Shape' to a string. {allowed}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Cannot add a string to a value of type 'Shape'. {allowed}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "Cannot add a value of type 'null' to a string. {allowed}");
    try testing.assertEqual(reported.length, 3L);
}

// Every ordering refusal between two strings names 'compareTo' with the operands' own names.
// A nullable local gets its null check first.
// Two nullable sides get one each.
test "ordering strings names 'compareTo' and the null check a nullable local needs" {
    let analysis = try analyzeOne("shout(string text) -> string \{\n"
        + "    return text;\n"
        + "\}\n"
        + "order(string? label, string word, string?? deep) \{\n"
        + "    bool plain = word < \"b\";\n"
        + "    bool before = label < word;\n"
        + "    bool after = word >= label;\n"
        + "    bool same = label <= label;\n"
        + "    bool nested = deep > word;\n"
        + "    bool both = label < deep;\n"
        + "    bool called = shout(word) < word;\n"
        + "    bool counted = label < 3;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string label = checkFirst("label");
    string literal = orderedAs("word", "<", "\"b\"");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'word' and '\"b\"' both have type 'string'. {literal}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'word' has type 'string'. {label} "
        + "{orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'>=' compares numbers, but 'word' has type 'string' and 'label' has type 'string?'. {label} "
        + "{orderedAs("word", ">=", "label")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<=' compares numbers, but both sides have type 'string?'. {label} "
        + "{orderedAs("label", "<=", "label")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'>' compares numbers, but 'deep' has type 'string??' and 'word' has type 'string'. "
        + "{checkTwice("deep")} {orderedAs("deep", ">", "word")}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'deep' has type 'string??'. {label} "
        + "{checkTwice("deep")} {orderedAs("label", "<", "deep")}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' compares numbers, but 'shout(word)' and 'word' both have type 'string'. "
        + "{orderedAs("shout(word)", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 7, file, "'<' compares numbers, but 'label' has type "
        + "'string?'.");
    try testing.assertEqual(reported.length, 8L);
}

// A nullable field gets its local copy instead of the plain null check.
// The 'compareTo' example then reads the copy.
test "ordering a nullable string field names 'compareTo' and the local copy" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected string? label = \"a\";\n"
        + "    protected string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "order(Tally t, string word) \{\n"
        + "    bool before = t.label < word;\n"
        + "    bool after = word < t.label;\n"
        + "    bool same = t.label <= t.label;\n"
        + "    bool nested = t.deep > word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string ofLabel = unstableFieldAdvice("label");
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 't.label' has type 'string?' and 'word' has type 'string'. {ofLabel} "
        + "{orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'word' has type 'string' and 't.label' has type 'string?'. {ofLabel} "
        + "{orderedAs("word", "<", "label")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<=' compares numbers, but both sides have type 'string?'. {ofLabel} "
        + "{orderedAs("label", "<=", "label")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'>' compares numbers, but 't.deep' has type 'string??' and 'word' has type 'string'. "
        + "{unstableFieldAdviceTwice("deep")} {orderedAs("deep", ">", "word")}");
    try testing.assertEqual(reported.length, 4L);
}

// Every operator that takes the value once its '?' is removed names the same null check.
test "every operator refused on a nullable local names the null check on that local" {
    let analysis = try analyzeOne("pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "all(int? count, int?? twice, bool? flag) \{\n"
        + "    int? held = pick();\n"
        + "    int added = held + 1;\n"
        + "    int doubled = twice + 1;\n"
        + "    bool compared = count < 3;\n"
        + "    int masked = count & 1;\n"
        + "    int shifted = count << 1;\n"
        + "    int moved = 1 << count;\n"
        + "    int negated = -count;\n"
        + "    bool inverted = !flag;\n"
        + "    int flipped = ~count;\n"
        + "    bool both = flag && true;\n"
        + "    twice += 1;\n"
        + "\}\n"
        + "stepped(int? count, int?? twice) \{\n"
        + "    count++;\n"
        + "    --twice;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string count = checkFirst("count");
    string twice = checkTwice("twice");
    string numbers = "needs numbers on both sides, got";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'held' has type 'int?'. {checkFirst("held")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'twice' has type 'int??'. {twice}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'&' needs integers on both sides, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<<' shifts an integer, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<<' needs an integer shift distance, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "Unary '-' needs a number, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'!' negates a 'bool', but 'flag' has type 'bool?'. {checkFirst("flag")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'~' flips the bits of an integer, but 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'&&' needs a 'bool' on both sides, but 'flag' has type 'bool?'. {checkFirst("flag")}");
    try sema_support.assertDiagnostic(reported, 10, file,
        "'+=' needs numbers on both sides, but 'twice' has type 'int??'. {twice}");
    try sema_support.assertDiagnostic(reported, 11, file,
        "'++' works only on numbers, and 'count' has type 'int?'. {count}");
    try sema_support.assertDiagnostic(reported, 12, file,
        "'--' works only on numbers, and 'twice' has type 'int??'. {twice}");
    try testing.assertEqual(reported.length, 13L);
}

// A 'const' field read through 'this' or a parameter gets its null check at the place it is read.
test "a 'const' chain gets its null check through 'this' or a parameter" {
    let analysis = try analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "    protected const string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected const Fixed fixed = new Fixed();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected order(string word) \{\n"
        + "        bool before = this.fixed.label < word;\n"
        + "        int added = this.fixed.count + 1;\n"
        + "        bool nested = this.fixed.deep < word;\n"
        + "    \}\n"
        + "\}\n"
        + "reach(Fixed fixed) \{\n"
        + "    int added = fixed.count + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'this.fixed.label' has type 'string?' and 'word' has type 'string'. "
        + "{checkFirst("this.fixed.label")} {orderedAs("this.fixed.label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'this.fixed.count' has type 'int?'. "
        + "{checkFirst("this.fixed.count")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'this.fixed.deep' has type 'string??' and 'word' has type 'string'. "
        + "{checkTwice("this.fixed.deep")} {orderedAs("this.fixed.deep", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+' needs numbers on both sides, but 'fixed.count' has type 'int?'. {checkFirst("fixed.count")}");
    try testing.assertEqual(reported.length, 4L);
}

// A field with two '?' has its copy checked twice.
// A compound form also writes the result back.
test "a nullable field and element are copied into a local, once for each '?'" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected int?? twice = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Tally t, int?[] counts, string?[] labels, int i, string word) \{\n"
        + "    int added = t.twice + 1;\n"
        + "    t.twice += 1;\n"
        + "    t.twice--;\n"
        + "    int element = counts[0] + 1;\n"
        + "    bool ordered = labels[i] < word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string unstable = "'t.twice' is a field, so it can change at any time. A later read of it can "
        + "be null even after a null check. Copy it into a local first ('let twice = t.twice;')";
    string nested = "check the local twice, once for each '?' ('if (twice != null) \{ if (twice != null) "
        + "\{ ... \} \}')";
    string writtenBack = "{unstable}, {nested}, and write the result back to 't.twice'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 't.twice' has type 'int??'. {unstable} and {nested}.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+=' needs numbers on both sides, but 't.twice' has type 'int??'. {writtenBack}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'--' works only on numbers, and 't.twice' has type 'int??'. {writtenBack}");
    try sema_support.assertDiagnostic(reported, 3, file, "'+' needs numbers on both sides, but 'counts[0]' "
        + "has type 'int?'. 'counts[0]' is an array element, so it can change at any time. A later read of "
        + "it can be null even after a null check. Copy it into a local first ('let value = counts[0];') "
        + "and check the local.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<' compares numbers, but 'labels[i]' has type 'string?' and 'word' has type 'string'. "
        + "'labels[i]' is an array element, so it can change at any time. A later read of it can be null "
        + "even after a null check. Copy it into a local first ('let value = labels[i];') and check the "
        + "local. {orderedAs("value", "<", "word")}");
    try testing.assertEqual(reported.length, 5L);
}

// A nullable call result is stored in a local named after the callee.
// A method called on a plain name gives a local named after both.
// The call is spelled in full on one line, whatever its arguments.
test "a nullable call result is stored in a local and checked there" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    protected lookup() -> string? \{\n"
        + "        return \"a\";\n"
        + "    \}\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "findDeep() -> string?? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "number(int x) -> int? \{\n"
        + "    return x;\n"
        + "\}\n"
        + "calls(Box box, string word, int x) \{\n"
        + "    bool found = find() < word;\n"
        + "    bool deep = findDeep() < word;\n"
        + "    bool looked = box.lookup() < word;\n"
        + "    bool after = word < find();\n"
        + "    string joined = find() + 1;\n"
        + "    int added = number(x) + 1;\n"
        + "    int complex = number(x + 1) + 1;\n"
        + "    int negated = -number(x);\n"
        + "    int spread = number(\n"
        + "        x // the count\n"
        + "    ) + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string find = storedAdvice("find", "findResult", "find()");
    string number = storedAdvice("number", "numberResult", "number(x)");
    string numbers = "'+' needs numbers on both sides, but";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'find()' has type 'string?' and 'word' has type 'string'. {find} "
        + "{orderedAs("findResult", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'findDeep()' has type 'string??' and 'word' has type 'string'. Each "
        + "call to 'findDeep' returns its own result. A later call can return null even after a null "
        + "check on an earlier one. Store the result in a local first ('let findDeepResult = "
        + "findDeep();') and check the local twice, once for each '?' ('if (findDeepResult != null) \{ if "
        + "(findDeepResult != null) \{ ... \} \}'). {orderedAs("findDeepResult", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'box.lookup()' has type 'string?' and 'word' has type 'string'. "
        + "{storedAdvice("lookup", "boxLookup", "box.lookup()")} {orderedAs("boxLookup", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 'word' has type 'string' and 'find()' has type 'string?'. {find} "
        + "{orderedAs("word", "<", "findResult")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'+' joins a string only when neither side can be null, but 'find()' has type 'string?'. {find}");
    try sema_support.assertDiagnostic(reported, 5, file, "{numbers} 'number(x)' has type 'int?'. {number}");
    try sema_support.assertDiagnostic(reported, 6, file, "{numbers} 'number(x + 1)' has type 'int?'. "
        + "{storedAdvice("number", "numberResult", "number(x + 1)")}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "Unary '-' needs a number, but 'number(x)' has type 'int?'. {number}");
    try sema_support.assertDiagnostic(reported, 8, file, "{numbers} 'number(x)' has type 'int?'. {number}");
    try testing.assertEqual(reported.length, 9L);
}

// A value that is no place, call or read through '?.' has no name for a local, so its refusal offers
// only the '??' fallback. The 'compareTo' sentence then explains the result instead of spelling it.
test "a nullable value that is no place, call or safe read gets only the '??' fallback" {
    let analysis = try analyzeOne("order(string? label, string? other, string word) \{\n"
        + "    bool fallback = (label ?? other) < word;\n"
        + "    int added = (label ?? other) + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'<' compares numbers, but 'label ?? other' has "
        + "type 'string?' and 'word' has type 'string'. Supply a fallback for 'label ?? other' with '??'. "
        + "Order strings with 'compareTo'. Its result is below zero when the string it is called on sorts "
        + "before the argument.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' joins a string only when neither side can be null, but 'label ?? other' has type 'string?'. "
        + "Supply a fallback for 'label ?? other' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

// Two operands with the same form of fix are explained once, and the fix names both.
// Locals that would share a name get 'left' and 'right' names, and a compound form writes back.
test "two operands with the same form of fix are explained once" {
    let analysis = try analyzeOne("class Fixed \{\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "    protected string? name = \"a\";\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "seek() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "makeFixed() -> Fixed \{\n"
        + "    return new Fixed();\n"
        + "\}\n"
        + "both(Tally t, Tally u, string?[] labels, int i, int j, string? label, string? other) \{\n"
        + "    bool stable = label < other;\n"
        + "    bool called = find() < find();\n"
        + "    bool calls = find() < seek();\n"
        + "    bool fields = t.title < u.title;\n"
        + "    bool named = t.title < t.name;\n"
        + "    bool elements = labels[i] < labels[j];\n"
        + "    bool mixed = t.title < labels[i];\n"
        + "    t.count += u.count;\n"
        + "    int chained = makeFixed().count + makeFixed().count;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "compares numbers, got 'string?' and 'string?'.";
    string calls = "returns its own result. A later call can return null even after a null check on "
        + "an earlier one.";
    string fields = "so they can change at any time. A later read of them can be null even after a "
        + "null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'label' and 'other' both have type 'string?'. Check 'label' and "
        + "'other' for null first ('if (label != null && other != null)'). "
        + "{orderedAs("label", "<", "other")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but both sides have type 'string?'. Each call to 'find' returns its own "
        + "result. A later call can return null even after a null check on an earlier one. Store both "
        + "results in locals first ('let leftFindResult = find(); let rightFindResult = find();') and "
        + "check the locals. {orderedAs("leftFindResult", "<", "rightFindResult")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'find()' and 'seek()' both have type 'string?'. Each call to 'find' "
        + "and to 'seek' returns its own result. A later call can return null even after a null check on "
        + "an earlier one. Store both results in locals first ('let findResult = find(); let seekResult = "
        + "seek();') and check the locals. {orderedAs("findResult", "<", "seekResult")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 't.title' and 'u.title' both have type 'string?'. 't.title' and "
        + "'u.title' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let leftTitle = t.title; let rightTitle = "
        + "u.title;') and check the locals. {orderedAs("leftTitle", "<", "rightTitle")}");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'<' compares numbers, but 't.title' and 't.name' both have type 'string?'. 't.title' and "
        + "'t.name' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let title = t.title; let name = t.name;') "
        + "and check the locals. {orderedAs("title", "<", "name")}");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' compares numbers, but 'labels[i]' and 'labels[j]' both have type 'string?'. 'labels[i]' and "
        + "'labels[j]' are array elements, so they can change at any time. A later read of them can be "
        + "null even after a null check. Copy them into locals first ('let leftValue = labels[i]; let "
        + "rightValue = labels[j];') and check the locals. {orderedAs("leftValue", "<", "rightValue")}");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' compares numbers, but 't.title' and 'labels[i]' both have type 'string?'. 't.title' is a "
        + "field and 'labels[i]' is an array element, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let title = t.title; "
        + "let value = labels[i];') and check the locals. {orderedAs("title", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 7, file, "'+=' needs numbers on both sides, but 't.count' "
        + "and 'u.count' both have type 'int?'. 't.count' and 'u.count' are fields, {fields} Copy them "
        + "into locals first ('let leftCount = t.count; let rightCount = u.count;'), check the locals, and "
        + "write the result back to 't.count'.");
    try sema_support.assertDiagnostic(reported, 8, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'makeFixed().count', a field of the result of a call. Each "
        + "call to 'makeFixed' returns its own result, so a later read of 'makeFixed().count' can be null "
        + "even after a null check. Store 'makeFixed().count' from both calls in locals first ('let "
        + "leftCount = makeFixed().count; let rightCount = makeFixed().count;') and check the locals.");
    try testing.assertEqual(reported.length, 9L);
}

// Two operands keep one sentence each when their forms differ or their levels differ.
// The same place on both sides keeps its one sentence, an element with a complex index included.
test "two operands with different forms of fix keep one sentence each" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "apart(Tally t, string?[] labels, int i, string? label, string?? deep) \{\n"
        + "    bool forms = label < find();\n"
        + "    bool levels = label < deep;\n"
        + "    bool complex = labels[i + 1] < labels[i + 1];\n"
        + "    bool same = labels[i] <= labels[i];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "compares numbers, but 'label' and 'find()' both have type 'string?'.";
    string ofElement = "is an array element, so it can change at any time. A later read of it can "
        + "be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'<' {both} {checkFirst("label")} "
        + "{storedAdvice("find", "findResult", "find()")} {orderedAs("label", "<", "findResult")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'label' has type 'string?' and 'deep' has type 'string??'. "
        + "{checkFirst("label")} {checkTwice("deep")} {orderedAs("label", "<", "deep")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but both sides have type 'string?'. 'labels[i + 1]' {ofElement} Copy it "
        + "into a local first ('let value = labels[i + 1];') and check the local. "
        + "{orderedAs("value", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<=' compares numbers, but both sides have type 'string?'. 'labels[i]' {ofElement} Copy it into a "
        + "local first ('let value = labels[i];') and check the local. {orderedAs("value", "<=", "value")}");
    try testing.assertEqual(reported.length, 4L);
}

// A name a binding in scope already has is numbered from 2 until it is free.
// This is true for a copy, a stored result and a name with a 'left' prefix.
test "a local name that is taken in scope is numbered until it is free" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "find() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "taken(Tally t, Tally u, string title, string?[] labels, string value, string value2) \{\n"
        + "    string findResult = \"x\";\n"
        + "    string leftTitle = \"x\";\n"
        + "    bool copied = t.title < title;\n"
        + "    bool stored = find() < title;\n"
        + "    bool element = labels[0] < value;\n"
        + "    bool prefixed = t.title < u.title;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string one = "compares numbers, but 'find()' has type 'string?' and 'title' has type 'string'.";
    string ofTitle = "'t.title' is a field, so it can change at any time. A later read of it can be "
        + "null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 't.title' has type 'string?' and 'title' has type 'string'. {ofTitle} "
        + "Copy it into a local first ('let title2 = t.title;') and check the local. "
        + "{orderedAs("title2", "<", "title")}");
    try sema_support.assertDiagnostic(reported, 1, file, "'<' {one} "
        + "{storedAdvice("find", "findResult2", "find()")} {orderedAs("findResult2", "<", "title")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'labels[0]' has type 'string?' and 'value' has type 'string'. "
        + "'labels[0]' is an array element, so it can change at any time. A later read of it can be null "
        + "even after a null check. Copy it into a local first ('let value3 = labels[0];') and check the "
        + "local. {orderedAs("value3", "<", "value")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 't.title' and 'u.title' both have type 'string?'. 't.title' and "
        + "'u.title' are fields, so they can change at any time. A later read of them can be null even "
        + "after a null check. Copy them into locals first ('let leftTitle2 = t.title; let rightTitle = "
        + "u.title;') and check the locals. {orderedAs("leftTitle2", "<", "rightTitle")}");
    try testing.assertEqual(reported.length, 4L);
}

// A write-back operator on a target no write can change reports that the target cannot change, and
// not the target's own null. What the value side of the write reports stays beside it.
test "a nullable target no write can change gets the refusal of the write instead of its null" {
    let analysis = try analyzeOne("class Fixed \{\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes(Fixed fixed) \{\n"
        + "    fixed.count++;\n"
        + "    fixed.count += 1;\n"
        + "    fixed.count += 3000000000;\n"
        + "    pick()++;\n"
        + "    --pick();\n"
        + "    pick() += 1;\n"
        + "    pick() <<= 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string constant = "a 'const' field is assigned once when the object is constructed and never "
        + "again. Remove 'const' from the field if it needs to change.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "The '++' operator cannot change field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Literal 3000000000 is too large for 'int', whose largest value is 2147483647. Declare 'count' "
        + "as 'long?' instead.");
    try sema_support.assertDiagnostic(reported, 4, file, "'pick()' is not a variable, a field or an array "
        + "element, so '++' cannot change it.");
    try sema_support.assertDiagnostic(reported, 5, file, "'pick()' is not a variable, a field or an array "
        + "element, so '--' cannot change it.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'pick()' is not a variable, a field or an array element, so '+=' cannot store its result there.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'pick()' is not a variable, a field or an array element, so '<<=' cannot store its result there.");
    try testing.assertEqual(reported.length, 8L);
}

// A 'const' chain read from a call's result is stored whole, in a local named after its last field.
// An ordering example puts a receiver made of more than one term in parentheses.
test "a 'const' chain through a call is stored whole in a local" {
    let analysis = try analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "    protected const string?? deep = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "makeFixed() -> Fixed \{\n"
        + "    return new Fixed();\n"
        + "\}\n"
        + "chain(string word, string other) \{\n"
        + "    bool ordered = makeFixed().label < word;\n"
        + "    int added = makeFixed().count + 1;\n"
        + "    bool nested = makeFixed().deep < word;\n"
        + "    bool joined = word + other < word;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'makeFixed().label' has type 'string?' and 'word' has type 'string'. "
        + "{ofCall("label")} Store 'makeFixed().label' in a local first ('let label = "
        + "makeFixed().label;') and check the local. {orderedAs("label", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'makeFixed().count' has type 'int?'. {ofCall("count")} "
        + "Store 'makeFixed().count' in a local first ('let count = makeFixed().count;') and check the "
        + "local.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'makeFixed().deep' has type 'string??' and 'word' has type 'string'. "
        + "{ofCall("deep")} Store 'makeFixed().deep' in a local first ('let deep = makeFixed().deep;') "
        + "and check the local twice, once for each '?' ('if (deep != null) \{ if (deep != null) \{ ... "
        + "\} \}'). {orderedAs("deep", "<", "word")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'<' compares numbers, but 'word + other' and 'word' both have type 'string'. "
        + "{orderedAs("(word + other)", "<", "word")}");
    try testing.assertEqual(reported.length, 4L);
}

// A copy of the step before a 'const' field is checked through that field, since the copy itself is
// never null, at one level and once for each '?'.
// An element with a complex index is named by its whole spelling and pairs like any other.
test "a copy is checked through the rest of the value it contains" {
    let analysis = try analyzeOne("class Inner \{\n"
        + "    protected const int?? count = 1;\n"
        + "    protected const string? label = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Inner inner = new Inner();\n"
        + "    protected Inner other = new Inner();\n"
        + "    protected string? title = \"a\";\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Holder h, string?[] labels, int i) \{\n"
        + "    int added = h.inner.count + 1;\n"
        + "    bool ordered = h.inner.label < h.other.label;\n"
        + "    bool mixed = h.title < labels[i + 1];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but "
        + "'h.inner.count' has type 'int??'. 'h.inner' is a field, so it can change at any time. A later "
        + "read of 'h.inner.count' can be null even after a null check. Copy it into a local first ('let "
        + "inner = h.inner;') and check 'inner.count' for null twice, once for each '?' ('if (inner.count "
        + "!= null) \{ if (inner.count != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'<' compares numbers, but 'h.inner.label' and 'h.other.label' both have type 'string?'. "
        + "'h.inner' and 'h.other' are fields, so they can change at any time. A later read of "
        + "'h.inner.label' and 'h.other.label' can be null even after a null check. Copy them into locals "
        + "first ('let inner = h.inner; let other = h.other;') and check 'inner.label' and 'other.label' "
        + "for null. {orderedAs("inner.label", "<", "other.label")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'h.title' and 'labels[i + 1]' both have type 'string?'. 'h.title' is a "
        + "field and 'labels[i + 1]' is an array element, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let title = h.title; "
        + "let value = labels[i + 1];') and check the locals. {orderedAs("title", "<", "value")}");
    try testing.assertEqual(reported.length, 3L);
}

// A local name is free only when nothing in scope has it and the callable declares no local of it.
// A function of the name counts, and so does a local declared later or in a nested block.
test "a local name avoids functions and locals declared later" {
    let analysis = try analyzeOne("class Holder \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "count() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "find() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "names(Holder h) \{\n"
        + "    int hidden = h.count + count();\n"
        + "    int stored = find() + 1;\n"
        + "    int findResult = 2;\n"
        + "    if (true) \{\n"
        + "        int findResult2 = 3;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'h.count' and 'count()' both have type 'int?'. 'h.count' is "
        + "a field, so it can change at any time. A later read of it can be null even after a null check. "
        + "Copy it into a local first ('let count2 = h.count;') and check the local. "
        + "{storedAdvice("count", "countResult", "count()")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'find()' has type 'int?'. "
        + "{storedAdvice("find", "findResult3", "find()")}");
    try testing.assertEqual(reported.length, 2L);
}

// Two operands with the same number of levels share one nested check that names both.
test "two operands with the same number of levels share one nested check" {
    let analysis = try analyzeOne("class Holder \{\n"
        + "    protected int?? twice = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pickTwice() -> int?? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "levels(int?? pp, int?? qq, Holder h, Holder g) \{\n"
        + "    int stable = pp + qq;\n"
        + "    int fields = h.twice + g.twice;\n"
        + "    int calls = pickTwice() + pickTwice();\n"
        + "    h.twice += g.twice;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "'+' needs numbers on both sides, got 'int??' and 'int??'.";
    string fields = "'h.twice' and 'g.twice' are fields, so they can change at any time. A later read of "
        + "them can be null even after a null check. Copy them into locals first ('let leftTwice = h.twice; "
        + "let rightTwice = g.twice;')";
    string nested = "twice, once for each '?' ('if (leftTwice != null && rightTwice != null) \{ if "
        + "(leftTwice != null && rightTwice != null) \{ ... \} \}')";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 'pp' and "
        + "'qq' both have type 'int??'. Check 'pp' and 'qq' for null twice, once for each '?' ('if (pp != "
        + "null && qq != null) \{ if (pp != null && qq != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'h.twice' "
        + "and 'g.twice' both have type 'int??'. {fields} and check the locals {nested}.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int??'. Each call to 'pickTwice' returns its own result. A later call can return "
        + "null even after a null check on an earlier one. Store both results in locals first ('let "
        + "leftPickTwiceResult = pickTwice(); let rightPickTwiceResult = pickTwice();') and check the "
        + "locals twice, once for each '?' ('if (leftPickTwiceResult != null && rightPickTwiceResult != "
        + "null) \{ if (leftPickTwiceResult != null && rightPickTwiceResult != null) \{ ... \} \}').");
    try sema_support.assertDiagnostic(reported, 3, file, "'+=' needs numbers on both sides, but 'h.twice' "
        + "and 'g.twice' both have type 'int??'. {fields}, check the locals {nested}, and write the result "
        + "back to 'h.twice'.");
    try testing.assertEqual(reported.length, 4L);
}

// Two operands spelled alike that make a call can read different places, so each gets its local.
// Without a call, the same spelling on both sides is one place with one sentence.
test "two operands spelled alike that make a call are never one place" {
    let analysis = try analyzeOne("class Holder \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "at() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "make() -> Holder \{\n"
        + "    return new Holder();\n"
        + "\}\n"
        + "calls(int?[] cells) \{\n"
        + "    int indexed = cells[at()] + cells[at()];\n"
        + "    int made = make().count + make().count;\n"
        + "    int same = cells[0] + cells[0];\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string both = "'+' needs numbers on both sides, got 'int?' and 'int?'.";
    string once = "so it can change at any time. A later read of it can be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'cells[at()]', an array element, {once} Copy each read into a "
        + "local first ('let leftValue = cells[at()]; let rightValue = cells[at()];') and check the locals.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. Both sides read 'make().count', a field, {once} Copy each read into a local "
        + "first ('let leftCount = make().count; let rightCount = make().count;') and check the locals.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but both sides "
        + "have type 'int?'. 'cells[0]' is an array element, {once} Copy it into a local first ('let value "
        + "= cells[0];') and check the local.");
    try testing.assertEqual(reported.length, 3L);
}

// A copy that contains more than the value names the value in the check, at one level, and the
// parentheses around its receiver are left out of that name.
test "a one-level copy names the value it checks" {
    let analysis = try analyzeOne("class Inner \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    protected Inner inner = new Inner();\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "copy(Holder h, string w) \{\n"
        + "    bool ordered = h.inner.label < w;\n"
        + "    int added = (h.inner).count + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<' compares numbers, but 'h.inner.label' has type 'string?' and 'w' has type 'string'. "
        + "'h.inner' is a field, so it can change at any time. A later read of 'h.inner.label' can be "
        + "null even after a null check. Copy it into a local first ('let inner = h.inner;') and check "
        + "'inner.label' for null. {orderedAs("inner.label", "<", "w")}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'(h.inner).count' has type 'int?'. 'h.inner' is a field, so it can change at any time. A later "
        + "read of 'h.inner.count' can be null even after a null check. Copy it into a local first ('let "
        + "inner = h.inner;') and check 'inner.count' for null.");
    try testing.assertEqual(reported.length, 2L);
}

// A field default and a parameter default have no statement to declare a local in, so a field, an
// element or a call there gets no fix, and the refusal stops after the why.
test "an initializer gets no local to copy or store into" {
    let analysis = try analyzeOne("find() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "class Defaults \{\n"
        + "    protected int total = find() + 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "defaulted(int x = find() + 1) -> int \{\n"
        + "    return x;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'+' needs numbers on both sides, but 'find()' has type 'int?'. Supply a fallback for "
        + "'find()' with '??'.";
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", refused);
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens", refused);
    try testing.assertEqual(reported.length, 2L);
}

// A nullable target no write can change gets the refusal of the place first. After it come the texts
// the same write on the target without its '?' gets. They cover a refused type, a value that may be
// null, and a result that cannot be stored back.
test "a write refused for its types keeps the type refusal beside the place refusal" {
    let analysis = try analyzeOne("class Fixed \{\n"
        + "    protected const string? label = \"a\";\n"
        + "    protected const int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "pick() -> string? \{\n"
        + "    return \"a\";\n"
        + "\}\n"
        + "pickCount() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes(Fixed fixed, Fixed other, Fixed third, int? p) \{\n"
        + "    fixed.label -= 1;\n"
        + "    other.count -= \"s\";\n"
        + "    pick() -= 1;\n"
        + "    third.count += p;\n"
        + "    pickCount() += \"a\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string constant = "a 'const' field is assigned once when the object is constructed and never "
        + "again. Remove 'const' from the field if it needs to change.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot use '-=' on field 'label': {constant}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'-=' needs numbers on both sides, but 'fixed.label' has type 'string?'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot use '-=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'-=' needs numbers on both sides, but 'other.count' has type 'int?' and '\"s\"' has type 'string'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'pick()' is not a variable, a field or an array element, so '-=' cannot store its result there.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'-=' needs numbers on both sides, but 'pick()' has type 'string?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Cannot use '+=' on field 'count': {constant}");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+=' needs numbers on both sides, but 'third.count' and 'p' both have type 'int?'. "
        + "{checkFirst("p")}");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'pickCount()' is not a variable, a field or an array element, so '+=' cannot store its result "
            + "there.");
    try sema_support.assertDiagnostic(reported, 9, file, "Cannot store the result of '+=' back into "
        + "'pickCount()', whose type is 'int?': adding 'string' to 'int' produces 'string'.");
    try testing.assertEqual(reported.length, 10L);
}

// A lambda written as a single expression has no statement to put a fix in, so the refusal offers
// only the '??' fallback there. A lambda with a block body gets the fix as any callable body does.
test "a lambda written as a single expression gets only the '??' fallback" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "lambdas(Tally t, int? p) \{\n"
        + "    (int) -> int field = (x) -> t.count + x;\n"
        + "    (int) -> int stable = (x) -> p + x;\n"
        + "    (int) -> int block = (x) -> \{\n"
        + "        return t.count + x;\n"
        + "    \};\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string refused = "'+' needs numbers on both sides, but 't.count' has type 'int?'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 't.count' "
        + "has type 'int?'. Supply a fallback for 't.count' with '??'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'p' has "
        + "type 'int?'. Supply a fallback for 'p' with '??'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{refused} {unstableFieldAdvice("count")}");
    try testing.assertEqual(reported.length, 3L);
}

// A compound join into a nullable target that is no string cannot store its result back. The
// target's null is reported beside that refusal, so the two fixes together compile.
test "a join that cannot be stored back into a nullable target reports both refusals" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "joins(int? held, Tally t) \{\n"
        + "    held += \"a\";\n"
        + "    t.count += \"a\";\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string joined = "'+=' joins a string only when neither side can be null, but 'held' has type 'int?'.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot store the result of '+=' back into "
        + "'held', whose type is 'int?': adding 'string' to 'int' produces 'string'. Declare 'held' as "
        + "'string?'.");
    try sema_support.assertDiagnostic(reported, 1, file, "{joined} {checkFirst("held")}");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot store the result of '+=' back into "
        + "'t.count', whose type is 'int?': adding 'string' to 'int' produces 'string'. Declare field "
        + "'count' as 'string?'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'+=' joins a string only when neither side can "
        + "be null, but 't.count' has type 'int?'. 't.count' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "t.count;'), check the local, and write the result back to 't.count'.");
    try testing.assertEqual(reported.length, 4L);
}

// An element whose index makes a call is written back through a stored index, so the write lands in
// the element the check was made on. A read keeps the plain copy.
test "an element with a call in its index is written back through a stored index" {
    let analysis = try analyzeOne("index() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "items(int?[] items) \{\n"
        + "    items[index()] += 1;\n"
        + "    int read = items[index()] + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string element = "'items[index()]' is an array element, so it can change at any time. A later "
        + "read of it can be null even after a null check.";
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+=' needs numbers on both sides, but "
        + "'items[index()]' has type 'int?'. {element} Store the index and the element in locals first "
        + "('let at = index(); let value = items[at];'), check 'value', and write the result back to "
        + "'items[at]'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'items[index()]' has type 'int?'. {element} Copy it into a local first ('let value = "
        + "items[index()];') and check the local.");
    try testing.assertEqual(reported.length, 2L);
}

// A lambda with a block body takes statements even inside a field default, so it gets the fix.
// A lambda written as a single expression there gets none.
test "a block lambda in a field default gets the fix" {
    let analysis = try analyzeOne("class Leaf \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Defaults \{\n"
        + "    protected Leaf leaf = new Leaf();\n"
        + "    protected () -> int reader = () -> \{\n"
        + "        return leaf.count + 1;\n"
        + "    \};\n"
        + "    protected () -> int inline = () -> leaf.count + 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but "
        + "'leaf.count' has type 'int?'. 'leaf.count' is a field, so it can change at any time. A later "
        + "read of it can be null even after a null check. Copy it into a local first ('let count = "
        + "leaf.count;') and check the local.");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but "
        + "'leaf.count' has type 'int?'. Supply a fallback for 'leaf.count' with '??'.");
    try testing.assertEqual(reported.length, 2L);
}

// A compound write on a nullable target is checked as the same write on the target without its '?'.
// The texts that write gets come first, and the target's null comes after them. A literal that does
// not fit stops the check, as it does for the same write. A result that cannot be stored back is
// reported before the null.
test "a compound write on a nullable target keeps what the write on its core reports" {
    let analysis = try analyzeOne("twins(byte? b, long? g, int? h, long wide) \{\n"
        + "    b += 300;\n"
        + "    b += (1);\n"
        + "    g += 3000000000;\n"
        + "    h &= wide;\n"
        + "    h += wide;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "Literal 300 is too large for 'byte', whose largest value is 255. Declare 'b' as 'ushort?' instead.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+=' needs numbers on both sides, but 'b' has type 'byte?'. {checkFirst("b")}");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'+=' needs numbers on both sides, but 'g' has type 'long?'. {checkFirst("g")}");
    try sema_support.assertDiagnostic(reported, 3, file, "'&=' needs the same integer type on both sides, "
        + "but 'h' has type 'int?' and 'wide' has type 'long'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "'&=' needs integers on both sides, but 'h' has type 'int?'. {checkFirst("h")}");
    try sema_support.assertDiagnostic(reported, 5, file, "Cannot store the result of '+=' back into 'h', "
        + "whose type is 'int?': adding 'long' to 'int' produces 'long'. Write 'wide as int', or declare "
        + "'h' as 'long?'.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'+=' needs numbers on both sides, but 'h' has type 'int?'. {checkFirst("h")}");
    try testing.assertEqual(reported.length, 7L);
}

// A result that cannot be stored back names how the operator combined the two sides. The conversion
// with 'as' is offered only where both sides are numbers.
test "a result that cannot be stored back names how the operator combined the sides" {
    let analysis = try analyzeOne("stored(int k, long wide, string text) \{\n"
        + "    k -= wide;\n"
        + "    k *= wide;\n"
        + "    k /= wide;\n"
        + "    k %= wide;\n"
        + "    k += text;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Cannot store the result of '-=' back into 'k', "
        + "whose type is 'int': subtracting 'long' from 'int' produces 'long'. Write 'wide as int', or "
        + "declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot store the result of '*=' back into 'k', "
        + "whose type is 'int': multiplying 'int' by 'long' produces 'long'. Write 'wide as int', or "
        + "declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Cannot store the result of '/=' back into 'k', "
        + "whose type is 'int': dividing 'int' by 'long' produces 'long'. Write 'wide as int', or declare "
        + "'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Cannot store the result of '%=' back into 'k', "
        + "whose type is 'int': the remainder of dividing 'int' by 'long' produces 'long'. Write 'wide as "
        + "int', or declare 'k' as 'long'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Cannot store the result of '+=' back into 'k', "
        + "whose type is 'int': adding 'string' to 'int' produces 'string'. Declare 'k' as 'string'.");
    try testing.assertEqual(reported.length, 5L);
}

// '++' and '--' report a place that cannot change first, and the refusal of the type beside it.
test "'++' on a place that cannot change keeps the refusal of the type" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected const bool flag = true;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "changes(Tally inner) \{\n"
        + "    inner.flag++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "The '++' operator cannot change field 'flag': "
        + "a 'const' field is assigned once when the object is constructed and never again. Remove "
        + "'const' from the field if it needs to change.");
    try sema_support.assertDiagnostic(reported, 1, file, "'++' works only on numbers, and 'inner.flag' has "
        + "type 'bool'. Use it on an integer or a floating-point variable, for example 'count++'.");
    try testing.assertEqual(reported.length, 2L);
}

// A write-back through a receiver that makes a call stores the receiver first, so the result is
// written back to the object the check was made on. A struct receiver that makes a call has no
// local that points at the same storage, so its refusal stops after the why.
test "a write-back through a receiver that makes a call stores the receiver first" {
    let analysis = try analyzeOne("class Tally \{\n"
        + "    protected int? count = 1;\n"
        + "\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int? x;\n"
        + "\}\n"
        + "make() -> Tally \{\n"
        + "    return new Tally();\n"
        + "\}\n"
        + "index() -> long \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "receivers(int?[][] rows, Point[] points) \{\n"
        + "    make().count++;\n"
        + "    make().count += 1;\n"
        + "    rows[index()][0] += 1;\n"
        + "    points[index()].x += 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string field = "'make().count' is a field, so it can change at any time. A later read of it "
        + "can be null even after a null check. Store the result of 'make()' and the field in locals "
        + "first ('let makeResult = make(); let count = makeResult.count;'), check 'count', and write "
        + "the result back to 'makeResult.count'.";
    try sema_support.assertDiagnostic(reported, 0, file, "'++' works only on numbers, and 'make().count' "
        + "has type 'int?'. {field}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+=' needs numbers on both sides, but "
        + "'make().count' has type 'int?'. {field}");
    try sema_support.assertDiagnostic(reported, 2, file, "'+=' needs numbers on both sides, but "
        + "'rows[index()][0]' has type 'int?'. 'rows[index()][0]' is an array element, so it can change at "
        + "any time. A later read of it can be null even after a null check. Store 'rows[index()]' and the "
        + "element in locals first ('let element = rows[index()]; let value = element[0];'), check "
        + "'value', and write the result back to 'element[0]'.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'+=' needs numbers on both sides, but 'points[index()].x' has type 'int?'.");
    try testing.assertEqual(reported.length, 4L);
}

// An untyped literal takes the type of a nullable target without its '?', wherever that target is
// expected. A literal too large for that type is refused against it.
test "an untyped literal takes the type of a nullable target without its '?'" {
    let analysis = try analyzeOne("halve(float? value) -> float \{\n"
        + "    return (value ?? 0) / 2;\n"
        + "\}\n"
        + "ceiling() -> byte? \{\n"
        + "    return 200;\n"
        + "\}\n"
        + "literals(bool flag, int which) \{\n"
        + "    byte? small = 1;\n"
        + "    byte? wrapped = (2);\n"
        + "    float? ratio = 1.5;\n"
        + "    double? wide = 2;\n"
        + "    long? big = 3000000000;\n"
        + "    ulong? mask = 1;\n"
        + "    float half = halve(3);\n"
        + "    bool same = small == 1;\n"
        + "    if (small != null && mask != null) \{\n"
        + "        small += (1);\n"
        + "        small += flag ? 1 : 2;\n"
        + "        small += switch (which) \{\n"
        + "            0 -> 1,\n"
        + "            default -> 2,\n"
        + "        \};\n"
        + "        mask |= (1);\n"
        + "    \}\n"
        + "    byte? large = 300;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. Declare 'large' as "
        + "'ushort?' instead.");
    try testing.assertEqual(reported.length, 1L);
}

// A reading operator adapts an untyped literal to the type the other side has without its '?'
// before it checks the sides. So its texts name that type, and a literal that does not fit is
// refused on its own. A literal inside parentheses adapts the same way.
test "a reading operator adapts a literal to the other side before it checks them" {
    let analysis = try analyzeOne("reads(byte? a, byte x) \{\n"
        + "    int sum = a + 1;\n"
        + "    int big = a + 300;\n"
        + "    bool less = a < 1;\n"
        + "    int masked = a & 1;\n"
        + "    byte pair = x + (1);\n"
        + "    bool same = x == (1);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+' needs numbers on both sides, but 'a' has type 'byte?'. {checkFirst("a")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from 'a', a 'byte?'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'<' compares numbers, but 'a' has type 'byte?'. {checkFirst("a")}");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'&' needs integers on both sides, but 'a' has type 'byte?'. {checkFirst("a")}");
    try testing.assertEqual(reported.length, 4L);
}

// The fallback on the right of '??' is checked against the type the left side has without its '?',
// as an assigned value is checked against its place. Parentheses, '?:' and a switch pass it along.
test "the fallback of '??' takes the type the left side has without its '?'" {
    let analysis = try analyzeOne("fallbacks(byte? v, bool flag, int which) \{\n"
        + "    byte plain = v ?? 5;\n"
        + "    byte wrapped = v ?? (5);\n"
        + "    byte chosen = v ?? (flag ? 1 : 2);\n"
        + "    byte switched = v ?? switch (which) \{\n"
        + "        0 -> 1,\n"
        + "        default -> 2,\n"
        + "    \};\n"
        + "    byte wide = v ?? (300);\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Literal 300 is too large for 'byte', whose largest value is 255. The literal takes its type "
        + "from the value of 'v', a 'byte'.");
    try testing.assertEqual(reported.length, 1L);
}

// A literal too large for a 'float' is pointed at 'double' only when a 'double' can take it.
test "a literal too large for 'float' and 'double' names both" {
    let analysis = try analyzeBody(["float tooLarge = 1e400;", "let suffixed = 1e400f;"]);
    let diagnostics = analysis.bodyDiagnostics();
    string refusal = "is too large for 'float', whose largest value is about 3.402e38. It is too large "
        + "for 'double' too, whose largest value is about 1.797e308.";
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "Literal 1e400 {refusal}");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/src/main.ens", "Literal 1e400f {refusal}");
    try testing.assertEqual(diagnostics.length, 2);
}

// A refused write proves nothing about its target, so a later read is checked as if the write were
// not there. This is true for a compound assignment as it is for '++'.
test "a refused write narrows nothing" {
    let analysis = try analyzeOne("pick() -> int? \{\n"
        + "    return 1;\n"
        + "\}\n"
        + "writes() \{\n"
        + "    int? h = pick();\n"
        + "    h += 1;\n"
        + "    int y = h + 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'+=' needs numbers on both sides, but 'h' has type 'int?'. {checkFirst("h")}");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs numbers on both sides, but 'h' has type 'int?'. {checkFirst("h")}");
    try testing.assertEqual(reported.length, 2L);
}

// A 'char' has no floating-point form behind a nullable target either.
test "a char assigned to a nullable floating-point target says why it is refused" {
    let analysis = try analyzeBody(["float? ratio = 'a';"]);
    let diagnostics = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/src/main.ens", "A 'char' is a character's "
        + "number in Unicode, its code point, and it never converts to 'float' on its own. Add 'as float' "
        + "after the literal to use that number as a 'float'.");
    try testing.assertEqual(diagnostics.length, 1);
}

// A value read through '?.' or '?[' is null whenever the value in front of the '?' is null. A value
// in front that a null check can narrow gets that check; any other gets the fallback.
test "a value read through '?.' or '?[' names the value in front of the '?'" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    int plain = 0;\n"
        + "    int? count = null;\n"
        + "    Box? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "reads(Box? mb, int[]? ma, Box b) \{\n"
        + "    int first = mb?.plain + 1;\n"
        + "    int element = ma?[0] + 1;\n"
        + "    int nested = mb?.inner?.plain + 1;\n"
        + "    int unstable = b.inner?.plain + 1;\n"
        + "    int nullable = mb?.count + 1;\n"
        + "    int both = mb?.plain + mb?.plain;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string checked = "'mb?.plain' is null whenever 'mb' is null. Check 'mb' for null first "
        + "('if (mb != null)') and write 'mb.plain', or supply a fallback with '??'.";
    try sema_support.assertDiagnostic(reported, 0, file, "'+' needs numbers on both sides, but 'mb?.plain' "
        + "has type 'int?'. {checked}");
    try sema_support.assertDiagnostic(reported, 1, file, "'+' needs numbers on both sides, but 'ma?[0]' "
        + "has type 'int?'. 'ma?[0]' is null whenever 'ma' is null. Check 'ma' for null first ('if (ma != "
        + "null)') and write 'ma[0]', or supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 2, file, "'+' needs numbers on both sides, but "
        + "'mb?.inner?.plain' has type 'int?'. 'mb?.inner?.plain' is null whenever 'mb?.inner' is null. "
        + "Supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'+' needs numbers on both sides, but "
        + "'b.inner?.plain' has type 'int?'. 'b.inner?.plain' is null whenever 'b.inner' is null. Supply a "
        + "fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 4, file, "'+' needs numbers on both sides, but 'mb?.count' "
        + "has type 'int?'. 'mb?.count' is null whenever 'mb' is null. Supply a fallback with '??'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'+' needs numbers on both sides, but both sides have type 'int?'. {checked}");
    try testing.assertEqual(reported.length, 6L);
}

// A shift whose value and distance can both be null names both types.
test "a shift with both sides nullable names both types" {
    let analysis = try analyzeOne("shifts(int? x, int? y) \{\n"
        + "    x <<= y;\n"
        + "    int moved = x >> y;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string both = "an integer to shift and an integer shift distance, got 'int?' and 'int?'. Check 'x' "
        + "and 'y' for null first ('if (x != null && y != null)').";
    try sema_support.assertDiagnostic(reported, 0, file, "'<<=' needs an integer to shift and an integer "
        + "shift distance, but 'x' and 'y' both have type 'int?'. Check 'x' and 'y' for null first ('if (x "
        + "!= null && y != null)').");
    try sema_support.assertDiagnostic(reported, 1, file, "'>>' needs an integer to shift and an integer "
        + "shift distance, but 'x' and 'y' both have type 'int?'. Check 'x' and 'y' for null first ('if (x "
        + "!= null && y != null)').");
    try testing.assertEqual(reported.length, 2L);
}

// A negative literal past the range of its type is below the smallest value, not too large.
test "a negative floating-point literal below the range names the smallest value" {
    let analysis = try analyzeBody(["double tooSmall = -1e400;", "let suffixed = -3.5e38f;",
        "float beyond = -1e400;"]);
    let diagnostics = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(diagnostics, 0, file,
        "Literal -1e400 is below the smallest value of 'double', which is about -1.797e308.");
    try sema_support.assertDiagnostic(diagnostics, 1, file, "Literal -3.5e38f is below the smallest value "
        + "of 'float', which is about -3.402e38. Remove the 'f' from '-3.5e38f'.");
    try sema_support.assertDiagnostic(diagnostics, 2, file, "Literal -1e400 is below the smallest value "
        + "of 'float', which is about -3.402e38. It is below the smallest value of 'double' too, which is "
        + "about -1.797e308.");
    try testing.assertEqual(diagnostics.length, 3);
}

// '++' and '--' on a nullable number with no fix to give end after the refusal.
test "'++' on a nullable number with no fix ends after the refusal" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    int? f = null;\n"
        + "    Box? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "changes(Box b, int? x) \{\n"
        + "    b.inner?.f++;\n"
        + "    () -> void run = () -> x++;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "'++' cannot change 'b.inner?.f' through '?.', "
        + "because there is nothing to write to when 'b.inner' is null. Copy 'b.inner' into a local "
        + "first ('let inner = b.inner;') and check the local, as in 'if (inner != null) \{ inner.f++; \}'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Cannot change 'x' inside a lambda: a lambda "
        + "works on copies of what it captures, so the 'x' outside it would not change. Return the value "
        + "the lambda computes and store it where the lambda is called, or keep the value in a field of an "
        + "object the lambda uses.");
    try sema_support.assertDiagnostic(reported, 2, file, "'++' works only on numbers, and 'x' has type "
        + "'int?'.");
    try testing.assertEqual(reported.length, 3L);
}

// A write through '?.' whose value in front is a field copies that value first. A null check on a
// field proves nothing for the write after it.
test "a write through '?.' on a field copies the field before the check" {
    let analysis = try analyzeOne("class Inner \{\n"
        + "    int plain = 0;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Box \{\n"
        + "    Inner? inner = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "writes(Box b, Inner?[] rows) \{\n"
        + "    b.inner?.plain += 1;\n"
        + "    rows[0]?.plain -= 1;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string nothing = "because there is nothing to write to when";
    try sema_support.assertDiagnostic(reported, 0, file, "'?.' cannot appear on the left side of '+=', "
        + "{nothing} 'b.inner' is null. Copy 'b.inner' into a local first ('let inner = b.inner;') and "
        + "check the local, as in 'if (inner != null) \{ inner.plain += ...; \}'.");
    try sema_support.assertDiagnostic(reported, 1, file, "'?.' cannot appear on the left side of '-=', "
        + "{nothing} 'rows[0]' is null. Copy 'rows[0]' into a local first ('let value = rows[0];') and "
        + "check the local, as in 'if (value != null) \{ value.plain -= ...; \}'.");
    try testing.assertEqual(reported.length, 2L);
}

// The refusal of a floating-point literal too large for a 'float' names the value or parameter
// that sets its type. At a declaration, the fix declares the variable as 'double'.
test "a literal too large for 'float' names where it takes its type from" {
    let analysis = try analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "floats(float f, float? g) \{\n"
        + "    double a = f + 3.5e38;\n"
        + "    bool b = 3.5e38 > f;\n"
        + "    double c = g ?? 1e300;\n"
        + "    takesFloat(3.5e38);\n"
        + "    float d = 3.5e38;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from 'f', a 'float'. Convert 'f' first ('f as double + 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from 'f', a 'float'. Convert 'f' first ('3.5e38 > f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 1e300 {large} The literal takes its "
        + "type from the value of 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 {large} The literal takes its "
        + "type from parameter 'value' of 'takesFloat', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 {large} Declare 'd' as 'double' "
        + "instead.");
    try testing.assertEqual(reported.length, 5L);
}

// A compound write on a field read through 'super' writes the result back to that field.
test "a compound write through 'super' writes the result back" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    int? f = null;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Derived extends Box \{\n"
        + "    constructor();\n"
        + "\n"
        + "    lift() \{\n"
        + "        super.f += 1;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'+=' needs numbers on both "
        + "sides, but 'super.f' has type 'int?'. 'super.f' is a field, so it can change at any time. A "
        + "later read of it can be null even after a null check. Copy it into a local first ('let f = "
        + "super.f;'), check the local, and write the result back to 'super.f'.");
    try testing.assertEqual(reported.length, 1L);
}

// A literal in a '?:' or a switch beside a value with a floating-point type of its own takes that
// value's type. Under a 'float' declaration, the fix also declares the variable as 'double'. When
// every branch is a literal, the literal has the target's type.
test "a literal too large for 'float' in a join names the branch it takes its type from" {
    let analysis = try analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "joins(float f, float? g, bool flag, int k) \{\n"
        + "    float a = flag ? f : 3.5e38;\n"
        + "    float b = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    takesFloat(flag ? f : 3.5e38);\n"
        + "    float? c = g ?? (flag ? f : 3.5e38);\n"
        + "    float d = flag ? 1.5 : 3.5e38;\n"
        + "    takesFloat(switch (k) \{\n"
        + "        0 -> 1.5,\n"
        + "        default -> 3.5e38,\n"
        + "    \});\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "{large} The literal takes its type from 'f', a "
        + "'float'. Declare 'a' as 'double' and convert 'f' ('double a = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "{large} The literal takes its type from 'f', a "
        + "'float'. Declare 'b' as 'double' and convert 'f' ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "{large} The literal takes its type from 'f', a "
        + "'float', and parameter 'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "{large} The literal takes its type from 'f', a "
        + "'float', and the value of 'g' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 4, file, "{large} Declare 'd' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 5, file, "{large} The literal takes its type from "
        + "parameter 'value' of 'takesFloat', a 'float'.");
    try testing.assertEqual(reported.length, 6L);
}

// The fix for a literal too large for 'float' beside a 'float' literal removes that literal's
// suffix, which makes both values 'double'. Under a 'float' declaration, the fix also declares the
// variable as 'double'.
test "a literal too large for 'float' beside a 'float' literal removes the suffix" {
    let analysis = try analyzeOne("suffixes(bool flag) \{\n"
        + "    let p = flag ? 1.5f : 3.5e38;\n"
        + "    double q = flag ? 3.5e38 : -1.5F;\n"
        + "    double s = 1.5f + 3.5e38;\n"
        + "    float r = flag ? 1.5f : 3.5e38;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    string large = "Literal 3.5e38 is too large for 'float', whose largest value is about 3.402e38.";
    try sema_support.assertDiagnostic(reported, 0, file, "{large} The literal takes its type from "
        + "'1.5f', a 'float'. Remove the 'f' from '1.5f' so that both branches are 'double'.");
    try sema_support.assertDiagnostic(reported, 1, file, "{large} The literal takes its type from "
        + "'-1.5F', a 'float'. Remove the 'F' from '-1.5F' so that both branches are 'double'.");
    try sema_support.assertDiagnostic(reported, 2, file, "{large} The literal takes its type from "
        + "'1.5f', a 'float'. Remove the 'f' from '1.5f' so that both sides are 'double'.");
    try sema_support.assertDiagnostic(reported, 3, file, "{large} The literal takes its type from '1.5f', "
        + "a 'float'. Declare 'r' as 'double' and remove the 'f' from '1.5f'.");
    try testing.assertEqual(reported.length, 4L);
}

// The refusal of a literal too large for 'float' names the declaration to change to 'double': a variable,
// a field, a parameter, an array or a return type. In a join, the fix also converts the value beside
// the literal.
test "a literal too large for 'float' names the declaration to change" {
    let analysis = try analyzeOne("class Holder \{\n"
        + "    float f = 1.0f;\n"
        + "    float g = 3.5e38;\n"
        + "    float joined = true ? f : 3.5e38;\n"
        + "    lazy const float shared = 3.5e38;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "apply(() -> float make) -> float \{\n"
        + "    return make();\n"
        + "\}\n"
        + "\n"
        + "giveBack() -> float \{\n"
        + "    return 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "scaled(float f, bool flag) -> float \{\n"
        + "    return flag ? f : 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "defaulted(float limit = 3.5e38) -> float \{\n"
        + "    return limit;\n"
        + "\}\n"
        + "\n"
        + "forms(Holder h, float f, float? g, bool flag, float[] values, int k) \{\n"
        + "    float local = 1.0f;\n"
        + "    local = 3.5e38;\n"
        + "    h.f = 3.5e38;\n"
        + "    values[0] = 3.5e38;\n"
        + "    float[] listed = [3.5e38];\n"
        + "    () -> float make = () -> 3.5e38;\n"
        + "    () -> float block = () -> \{\n"
        + "        return 3.5e38;\n"
        + "    \};\n"
        + "    apply(() -> 3.5e38);\n"
        + "    float? c = flag ? f : 3.5e38;\n"
        + "    local = flag ? f : 3.5e38;\n"
        + "    values[1] = flag ? f : 3.5e38;\n"
        + "    () -> float joinedMake = () -> flag ? f : 3.5e38;\n"
        + "    float n1 = flag ? g : 3.5e38;\n"
        + "    float x3 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    let x4 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        1 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    let x5 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'g' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'joined' "
        + "as 'double' and convert 'f' ('double joined = true ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'shared' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'giveBack' to 'double'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('return flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'limit' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'local' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'values' as 'double[]' instead.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'listed' as 'double[]' instead.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'make' to 'double'.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Change the return type of 'block' to 'double'.");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'c' as "
        + "'double?' and convert 'f' ('double? c = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'local' "
        + "as 'double' and convert 'f' ('local = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 15, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'values' "
        + "as 'double[]' and convert 'f' ('values[1] = flag ? f as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 16, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'joinedMake' to 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 17, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 18, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Declare 'x3' "
        + "as 'double' and remove the 'f' from '1.5f'.");
    try sema_support.assertDiagnostic(reported, 19, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Convert "
        + "'1.5f' first ('0 -> 1.5f as double').");
    try sema_support.assertDiagnostic(reported, 20, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Remove the "
        + "'f' from '1.5f' so that both arms are 'double'.");
    try testing.assertEqual(reported.length, 21L);
}

// An operand literal too large for 'float' under a declaration gets the same fix as a literal in a join.
// A result stored back through a cast spells the whole cast, and a parameter of a constructor names
// its type.
test "an operand literal too large for 'float' names the declaration to change" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    float size;\n"
        + "    int total = 0;\n"
        + "\n"
        + "    constructor(this.size);\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    float x;\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "scaled(float f) -> float \{\n"
        + "    return f * 3.5e38;\n"
        + "\}\n"
        + "\n"
        + "operands(float f, float? g, float[] values, long wide, Box box, int[]? xs, Box? mb) -> int \{\n"
        + "    float x11 = f * 3.5e38;\n"
        + "    float x13 = 3.5e38 - 1.5f;\n"
        + "    f += f * 3.5e38;\n"
        + "    values[0] = f * 3.5e38;\n"
        + "    takesFloat(f * 3.5e38);\n"
        + "    float h = g ?? f * 3.5e38;\n"
        + "    int total = 0;\n"
        + "    total += wide * 2;\n"
        + "    total += wide;\n"
        + "    box.total += wide;\n"
        + "    let made = new Box(3.5e38);\n"
        + "    Pair p = \{x: 3.5e38\};\n"
        + "    double big = 1.8e308;\n"
        + "    double low = -1.8e308;\n"
        + "    return xs?[0] + mb?.total;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('return f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'x11' "
        + "as 'double' and convert 'f' ('double x11 = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '1.5f', a 'float'. Declare "
        + "'x13' as 'double' and remove the 'f' from '1.5f'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f += f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare "
        + "'values' as 'double[]' and convert 'f' ('values[0] = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float', and parameter "
        + "'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float', and the value "
        + "of 'g' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 7, file, "Cannot store the result of '+=' back into "
        + "'total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write '(wide * 2) as "
        + "int', or declare 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Cannot store the result of '+=' back into "
        + "'total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write 'wide as int', or "
        + "declare 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Cannot store the result of '+=' back into "
        + "'box.total', whose type is 'int': adding 'long' to 'int' produces 'long'. Write 'wide as int', "
        + "or declare field 'total' as 'long'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from parameter 'size' of the "
        + "constructor of 'Box', a 'float'.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare field 'x' of 'Pair' as 'double' instead.");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 1.8e308 is too large for 'double', "
        + "whose largest value is about 1.797e308.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal -1.8e308 is below the smallest value of "
        + "'double', which is about -1.797e308.");
    try sema_support.assertDiagnostic(reported, 14, file, "'+' needs numbers on both sides, but 'xs?[0]' "
        + "and 'mb?.total' both have type 'int?'. 'xs?[0]' is null whenever 'xs' is null, and 'mb?.total' "
        + "whenever 'mb' is null. Check both for null first ('if (xs != null && mb != null)') and write "
        + "'xs[0] + mb.total', or supply fallbacks with '??'.");
    try testing.assertEqual(reported.length, 15L);
}

// A literal too large for 'float' in a chain of operators, under a sign or in a join is refused with
// the declaration to change. When the operand is the place written, the declaration is the whole
// fix, and a 'float' literal loses its suffix.
test "a literal too large for 'float' deep in an operand or with a suffix names the declaration" {
    let analysis = try analyzeOne("class Box \{\n"
        + "    float size = 1.0;\n"
        + "\n"
        + "    constructor();\n"
        + "\n"
        + "    grow() \{\n"
        + "        this.size = this.size * 3.5e38;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "scaled(float f) -> float \{\n"
        + "    return f * 3.5e38 + 1.0;\n"
        + "\}\n"
        + "\n"
        + "nested(float f, float? g, bool flag) \{\n"
        + "    float x5 = f + 3.5e38 + 1.0;\n"
        + "    float n1 = -(f * 3.5e38);\n"
        + "    float n3 = f * (flag ? f : 3.5e38);\n"
        + "    float n4 = flag ? f * 3.5e38 : 1.0;\n"
        + "    f = f + 3.5e38;\n"
        + "    f += f * 3.5e38;\n"
        + "    float y = 3.5e38f;\n"
        + "    double y2 = 3.5e38f;\n"
        + "    double x2 = f * 3.5e38f;\n"
        + "    float x3 = f * 3.5e38f;\n"
        + "    takesFloat(3.5e38f);\n"
        + "    float y4 = g ?? 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'this.size', a 'float'. "
        + "Declare 'size' as 'double' ('this.size = this.size * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Change the "
        + "return type of 'scaled' to 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'x5' "
        + "as 'double' and convert 'f' ('f as double + 3.5e38').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n1' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n3' "
        + "as 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'n4' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f = f + 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'f' as "
        + "'double' ('f += f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'y' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'f' ('f as double * "
        + "3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'x3' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'f' ('double x3 = f as double * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and the value of 'g' is a "
        + "'float' too.");
    try testing.assertEqual(reported.length, 14L);
}

// A switch inside an operand, an operand inside an arm and a nested switch get the fix of the
// declaration. A 'float' literal beside a 'float' branch or arm loses its suffix and the branch is
// converted, unless the branch reads the place written.
test "a switch in an operand and a 'float' literal beside a 'float' branch name the declaration" {
    let analysis = try analyzeOne("takesFloat(float value) \{\n"
        + "\}\n"
        + "\n"
        + "forms(float f, float g, float? h, bool flag, int k) \{\n"
        + "    float s2 = f + switch (k) \{\n"
        + "        0 -> f * 3.5e38,\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float s3 = f + switch (k) \{\n"
        + "        0 -> flag ? f : 3.5e38,\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float s4 = f * switch (k) \{\n"
        + "        0 -> switch (k) \{\n"
        + "            1 -> f,\n"
        + "            default -> 3.5e38,\n"
        + "        \},\n"
        + "        default -> 1.0,\n"
        + "    \};\n"
        + "    float t1 = flag ? g : 3.5e38f;\n"
        + "    double t2 = flag ? g : 3.5e38f;\n"
        + "    let t3 = flag ? 3.5e38f : g;\n"
        + "    float t4 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let t5 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    takesFloat(3.5e38f);\n"
        + "    takesFloat(g * 3.5e38f);\n"
        + "    float y4 = h ?? 3.5e38f;\n"
        + "    f = 3.5e38f * f;\n"
        + "    f = -f * 3.5e38;\n"
        + "    f = f + 1.0 + 3.5e38;\n"
        + "    f = flag ? f : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's2' "
        + "as 'double' and convert 'f' ('f as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's3' "
        + "as 'double' and convert 'f' ('flag ? f as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 's4' "
        + "as 'double' and convert 'f' ('1 -> f as double').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't1' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('double t1 = flag ? g as double : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('flag ? g as "
        + "double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('flag ? 3.5e38 "
        + ": g as double').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't4' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('0 -> g as double').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and convert 'g' ('0 -> g as "
        + "double').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and the value of 'h' is a "
        + "'float' too.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' and remove the 'f' from '3.5e38f' ('f "
        + "= 3.5e38 * f;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from '-f', a 'float'. Declare 'f' "
        + "as 'double' ('f = -f * 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f + 1.0', a 'float'. Declare "
        + "'f' as 'double' ('f = f + 1.0 + 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'f' as 'double' and remove the 'f' from '3.5e38f' ('f "
        + "= flag ? f : 3.5e38;').");
    try testing.assertEqual(reported.length, 15L);
}

// A 'float' literal too large for 'float' beside a nullable value gets no conversion, and two such
// literals get one fix each. Beside a 'float' literal that fits, both lose their suffix.
test "a 'float' literal beside a nullable, a pending or a 'float' literal branch gets its own fix" {
    let analysis = try analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    let a = flag ? h : 3.5e38f;\n"
        + "    float? b = flag ? h : 3.5e38f;\n"
        + "    let c = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let e = h * 3.5e38f;\n"
        + "    let p = flag ? 3.5e38f : 3.5e38f;\n"
        + "    float p2 = flag ? 3.5e38f : 3.5e38f;\n"
        + "    float t8 = flag ? 1.5f : 3.5e38f;\n"
        + "    let t9 = flag ? 1.5f : 3.5e38f;\n"
        + "    let t10 = flag ? 1.5F : 3.5e38f;\n"
        + "    let t11 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    float t12 = 1.5f * 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 3, file, "'*' needs numbers on both sides, but 'h' has "
        + "type 'float?'. Check 'h' for null first ('if (h != null)').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'p2' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'p2' as 'double' and remove the 'f' from '3.5e38f'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't8' as 'double' and remove the 'f' from '3.5e38f' and "
        + "from '1.5f' ('double t8 = flag ? 1.5 : 3.5e38;').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('flag ? 1.5 : "
        + "3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and the 'F' from '1.5F' ('flag ? "
        + "1.5 : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('0 -> 1.5').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 't12' as 'double' and remove the 'f' from '3.5e38f' "
        + "and from '1.5f' ('double t12 = 1.5 * 3.5e38;').");
    try testing.assertEqual(reported.length, 14L);
}

// A 'float' literal among arms with a 'float' value converts that value, whichever arm comes first.
// Beside a nullable 'float' branch, a join or operator in the other branch gets no conversion.
test "a 'float' literal beside a nullable branch or several typed arms gets a fix that compiles" {
    let analysis = try analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    float c8 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        1 -> g,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    float c19 = switch (k) \{\n"
        + "        0 -> g,\n"
        + "        1 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let c7 = switch (k) \{\n"
        + "        0 -> 1.5f,\n"
        + "        default -> 3.5e38f,\n"
        + "    \};\n"
        + "    let c11 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    float? c16 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    let c20 = flag ? h : (flag ? g : 3.5e38f);\n"
        + "    let c21 = flag ? h : g * 3.5e38;\n"
        + "    let c22 = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> flag ? g : 3.5e38,\n"
        + "    \};\n"
        + "    let c15 = flag ? (1.5f) : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'c8' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('1 -> g as double').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Declare 'c19' as 'double', remove the 'f' from '3.5e38f' and "
        + "convert 'g' ('0 -> g as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('0 -> 1.5').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. Remove the 'f' from '3.5e38f' and from '1.5f' ('flag ? 1.5 : "
        + "3.5e38').");
    try testing.assertEqual(reported.length, 9L);
}

// Beside a nullable 'float' branch or arm, no conversion gives a join a common type, so a join or
// operator on either side of it gets no conversion. The refusal is settled once every branch is known.
test "a join or operator beside a nullable 'float' branch ends after the why in either order" {
    let analysis = try analyzeOne("forms(float g, float? h, bool flag, int k) \{\n"
        + "    let c11 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    let d11 = flag ? (flag ? g : 3.5e38) : h;\n"
        + "    float? c16 = flag ? h : (flag ? g : 3.5e38);\n"
        + "    float? d16 = flag ? (flag ? g : 3.5e38) : h;\n"
        + "    let c20 = flag ? h : (flag ? g : 3.5e38f);\n"
        + "    let d20 = flag ? (flag ? g : 3.5e38f) : h;\n"
        + "    let c21 = flag ? h : g * 3.5e38;\n"
        + "    let d21 = flag ? g * 3.5e38 : h;\n"
        + "    let c22 = switch (k) \{\n"
        + "        0 -> h,\n"
        + "        default -> flag ? g : 3.5e38,\n"
        + "    \};\n"
        + "    let d22 = switch (k) \{\n"
        + "        0 -> flag ? g : 3.5e38,\n"
        + "        default -> h,\n"
        + "    \};\n"
        + "    let e1 = flag ? (flag ? g : 3.5e38) : g;\n"
        + "    let e2 = flag ? 1.0 : (flag ? (flag ? g : 3.5e38) : h);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('flag ? g as double : 3.5e38').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try testing.assertEqual(reported.length, 12L);
}

// An argument, an index and a '??' fallback are checked against their own target, so a nullable
// branch beside them leaves their fix. A nested 'float' literal names its own neighbour and the branch.
test "a literal in a call, an index or a fallback keeps its fix beside a nullable branch" {
    let analysis = try analyzeOne("takesDouble(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, float g2, float? h2, bool flag, int k, float[] values) \{\n"
        + "    let a2 = flag ? takesDouble(g * 3.5e38) : h;\n"
        + "    let b1 = flag ? takesFloat(g * 3.5e38) : g2;\n"
        + "    let b3 = flag ? (h2 ?? g * 3.5e38) : h;\n"
        + "    let a5 = flag ? values[(g * 3.5e38) as int] : h;\n"
        + "    let s1 = flag ? (flag ? g : 3.5e38f) : h;\n"
        + "    let s2 = switch (k) \{\n"
        + "        0 -> flag ? g : 3.5e38f,\n"
        + "        default -> h,\n"
        + "    \};\n"
        + "    let s3 = flag ? h : 3.5e38f;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and the value "
        + "of 'h2' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the other branch 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'g', a 'float', and the arm 'h' is a 'float?'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float'. Without it the literal "
        + "takes its type from 'h', a 'float?'.");
    try testing.assertEqual(reported.length, 7L);
}

// An array read and an argument whose type reaches the result can change the branch type, so beside
// a nullable 'float' branch they end after the why. An index and another argument keep their fix.
test "an array element or a generic argument beside a nullable branch ends after the why" {
    let analysis = try analyzeOne("identity<T>(T value) -> T \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "pick<T>(T first, double scale) -> T \{\n"
        + "    return first;\n"
        + "\}\n"
        + "\n"
        + "takesDouble(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, bool flag, float[]? xs) \{\n"
        + "    let a = flag ? [g * 3.5e38][0] : h;\n"
        + "    let b = flag ? [g * 3.5e38]?[0] : h;\n"
        + "    let c = flag ? identity<float>(g * 3.5e38) : h;\n"
        + "    let d = flag ? pick<float>(g, g * 3.5e38) : h;\n"
        + "    let e = flag ? new Holder<float>(g * 3.5e38).held : h;\n"
        + "    let i = flag ? takesDouble(g * 3.5e38) : h;\n"
        + "    let j = flag ? xs?[(g * 3.5e38) as int] : h;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try testing.assertEqual(reported.length, 7L);
}

// An argument to a method of a generic type reaches the result only when the method declares its
// parameter and its return type with a type parameter. Any other argument keeps its fix.
test "a method argument on a generic instance reaches the result only through a type parameter" {
    let analysis = try analyzeOne("class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\n"
        + "    scaled(double by) -> T \{\n"
        + "        return this.held;\n"
        + "    \}\n"
        + "\n"
        + "    replaced(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, bool flag, Holder<float> box) \{\n"
        + "    let a = flag ? box.scaled(g * 3.5e38) : h;\n"
        + "    let b = flag ? box.replaced(g * 3.5e38) : h;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try testing.assertEqual(reported.length, 2L);
}

// An operand literal in a named argument is checked against the parameter it names, as a positional
// one is. A named argument reaches a generic method's result when its parameter has a type parameter.
test "a named argument gets the target of its parameter" {
    let analysis = try analyzeOne("class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\n"
        + "    replaced(T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    both(double by, T value) -> T \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Box \{\n"
        + "    constructor();\n"
        + "\n"
        + "    resize(float size = 1.0) \{\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "takesFloat(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "forms(float g, float? h, bool flag, Holder<float> holder, Box box) \{\n"
        + "    let a1 = takesFloat(value: g * 3.5e38);\n"
        + "    box.resize(size: g * 3.5e38);\n"
        + "    let a3 = holder.replaced(value: g * 3.5e38);\n"
        + "    let a4 = flag ? holder.replaced(value: g * 3.5e38) : h;\n"
        + "    let a5 = flag ? holder.both(by: g * 3.5e38, value: g) : h;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'takesFloat' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'size' of 'resize' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'replaced' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try testing.assertEqual(reported.length, 5L);
}

// An operator argument of a call with several candidates is refused once one is chosen. A 'float'
// parameter is named, a 'double' one keeps the conversion, and with none chosen the refusal ends
// after the why.
test "an operator argument of an overloaded call names the parameter the call resolves to" {
    let analysis = try analyzeOne("scale(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "scale(string text) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "count(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "count(float value, int times) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "widen(float value) -> float \{\n"
        + "    return value;\n"
        + "\}\n"
        + "\n"
        + "widen(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "class Box \{\n"
        + "    constructor();\n"
        + "\n"
        + "    put(float value) -> float \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\n"
        + "    put(string text) -> float \{\n"
        + "        return 1.0;\n"
        + "    \}\n"
        + "\n"
        + "    put(float value, int times) -> float \{\n"
        + "        return value;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "forms(float g, Box box, bool flag) \{\n"
        + "    let d1 = wide(g * 3.5e38);\n"
        + "    let n1 = none(g * 3.5e38);\n"
        + "    let s1 = scale(g * 3.5e38f);\n"
        + "    let a1 = scale(g * 3.5e38);\n"
        + "    let a2 = scale(value: g * 3.5e38);\n"
        + "    let a3 = count(g * 3.5e38);\n"
        + "    let a4 = count(g * 3.5e38, 2);\n"
        + "    let a5 = count(value: g * 3.5e38, times: 2);\n"
        + "    let a6 = box.put(g * 3.5e38);\n"
        + "    let a7 = box.put(value: g * 3.5e38);\n"
        + "    let a8 = box.put(g * 3.5e38, 3);\n"
        + "    let a9 = scale(flag ? g : 3.5e38);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "\n"
        + "wide(double value) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "wide(string text) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "none(string text) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n"
        + "\n"
        + "none(bool flag) -> float \{\n"
        + "    return 1.0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'. Convert 'g' "
        + "first ('g as double * 3.5e38').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38f is too large for 'float', whose "
        + "largest value is about 3.402e38. The 'f' makes the literal a 'float', and parameter 'value' of "
        + "'scale' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'scale' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'scale' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'count' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'count' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'count' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'put' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'put' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'put' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'value' of 'scale' is a 'float' too.");
    try testing.assertEqual(reported.length, 12L);
}

// A constructor parameter is named by the type it builds, with the type arguments that give the
// parameter its type, whether the call has one candidate or several.
test "a constructor parameter names the type the constructor builds" {
    let analysis = try analyzeOne("class Keeper<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\}\n"
        + "\n"
        + "class Holder<T> \{\n"
        + "    T held;\n"
        + "\n"
        + "    constructor(this.held);\n"
        + "\n"
        + "    constructor(T held, int times) \{\n"
        + "        this.held = held;\n"
        + "    \}\n"
        + "\}\n"
        + "\n"
        + "class Plain \{\n"
        + "    float size;\n"
        + "\n"
        + "    constructor(this.size);\n"
        + "\}\n"
        + "\n"
        + "struct Pair \{\n"
        + "    float x;\n"
        + "\n"
        + "    constructor(this.x);\n"
        + "\}\n"
        + "\n"
        + "forms(float g) \{\n"
        + "    let k = new Keeper<float>(g * 3.5e38);\n"
        + "    let h = new Holder<float>(g * 3.5e38);\n"
        + "    let p = new Plain(g * 3.5e38);\n"
        + "    let q = Pair(g * 3.5e38);\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'held' of the constructor of 'Keeper<float>' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'held' of the constructor of 'Holder<float>' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'size' of the constructor of 'Plain' is a 'float' too.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'g', a 'float', and parameter "
        + "'x' of the constructor of 'Pair' is a 'float' too.");
    try testing.assertEqual(reported.length, 4L);
}

// Every place an integer literal takes its type from gets its own fix, as a floating-point literal
// does: a declaration, a return, an element, a parameter, a '??', an operand and a join. A literal
// nothing gives a type to gets the suffix or the conversion, and one no integer type takes gets none.
test "an integer literal too large for its type names where the type comes from and the type that takes it" {
    let analysis = try analyzeOne("takes(int n) \{\n"
        + "\}\n"
        + "\n"
        + "overloaded(int n) \{\n"
        + "\}\n"
        + "\n"
        + "overloaded(string s) \{\n"
        + "\}\n"
        + "\n"
        + "counted() -> int \{\n"
        + "    return 3000000000;\n"
        + "\}\n"
        + "\n"
        + "class Holder \{\n"
        + "    int size = 3000000000;\n"
        + "\n"
        + "    constructor();\n"
        + "\}\n"
        + "\n"
        + "forms(int k, int? m, bool flag, byte mask) \{\n"
        + "    int declared = 3000000000;\n"
        + "    int? nullable = -3000000000;\n"
        + "    int[] elements = [1, 3000000000];\n"
        + "    takes(3000000000);\n"
        + "    overloaded(3000000000);\n"
        + "    int fallback = m ?? 3000000000;\n"
        + "    int sum = k + 3000000000;\n"
        + "    long wide = k + 3000000000;\n"
        + "    let joined = flag ? k : 3000000000;\n"
        + "    int chosen = flag ? k : 3000000000;\n"
        + "    let armed = switch (k) \{\n"
        + "        1 -> k,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    let listed = [k, 3000000000];\n"
        + "    byte masked = mask & 300;\n"
        + "    byte shifted = mask >> 300;\n"
        + "    uint unsigned = -1;\n"
        + "    int deep = -9223372036854775809;\n"
        + "    char letter = 2000000;\n"
        + "    byte code = 'Ω';\n"
        + "    let untyped = 3000000000;\n"
        + "    let huge = 10000000000000000000;\n"
        + "    let past = 99999999999999999999;\n"
        + "    let below = -99999999999999999999;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Change the return type of 'counted' to 'long'.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'size' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'declared' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal -3000000000 is below the smallest value "
        + "of 'int', which is -2147483648. Declare 'nullable' as 'long?' instead.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Declare 'elements' as 'long[]' instead.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from parameter 'n' of 'takes', an 'int'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from parameter 'n' of 'overloaded', an "
        + "'int'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from the value of 'm', an 'int'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'k', an 'int'. Declare 'sum' as "
        + "'long' and convert 'k' ('long sum = k as long + 3000000000;').");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' first "
        + "('k as long + 3000000000').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('flag ? k as long : 3000000000').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Declare "
        + "'chosen' as 'long' and convert 'k' ('long chosen = flag ? k as long : 3000000000;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('1 -> k as long').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'k', an 'int'. Convert 'k' "
        + "first ('[k as long, 3000000000]').");
    try sema_support.assertDiagnostic(reported, 14, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'mask', a 'byte'. Declare 'masked' as "
        + "'ushort' and convert 'mask' ('ushort masked = mask as ushort & 300;').");
    try sema_support.assertDiagnostic(reported, 15, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'mask', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 16, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. Declare 'unsigned' as 'int' instead.");
    try sema_support.assertDiagnostic(reported, 17, file, "Literal -9223372036854775809 is below the "
        + "smallest value of 'int', which is -2147483648. It is below the smallest value of 'long' too, "
        + "which is -9223372036854775808.");
    try sema_support.assertDiagnostic(reported, 18, file, "Literal 2000000 is too large for 'char', whose "
        + "largest value is 1114111.");
    try sema_support.assertDiagnostic(reported, 19, file, "The code point of 'Ω', 937, is too large for "
        + "'byte', whose largest value is 255.");
    try sema_support.assertDiagnostic(reported, 20, file, "Literal 3000000000 is too large for 'int', "
        + "whose largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 21, file, "Literal 10000000000000000000 is too large for "
        + "'int', whose largest value is 2147483647. Write '10000000000000000000 as ulong'.");
    try sema_support.assertDiagnostic(reported, 22, file, "Literal 99999999999999999999 is too large for "
        + "every integer type. The widest, 'ulong', has 18446744073709551615 as its largest value.");
    try sema_support.assertDiagnostic(reported, 23, file, "Literal -99999999999999999999 is below the "
        + "smallest value of every integer type. The lowest, 'long', has -9223372036854775808 as its "
        + "smallest value.");
    try testing.assertEqual(reported.length, 24L);
}

// The value beside a literal too large for it converts to a type with every value of both sides,
// the declaration takes that type when the target is narrower, and no fix is given where no type
// has them all or a negative literal meets an unsigned target.
test "a literal beside a value converts that value only to a type with every value of both" {
    let analysis = try analyzeOne("forms(bool flag, uint u, long l, ulong ul, int i, ushort us, byte b) \{\n"
        + "    let a = flag ? u : -1;\n"
        + "    long c = flag ? u : -1;\n"
        + "    ulong d = flag ? u : -1;\n"
        + "    let e = flag ? l : 9223372036854775808;\n"
        + "    ulong f = flag ? l : 9223372036854775808;\n"
        + "    let g = flag ? ul : -1;\n"
        + "    int h = flag ? ul : -1;\n"
        + "    let k = flag ? us : -1;\n"
        + "    short m = flag ? us : -1;\n"
        + "    let n = flag ? b : -1;\n"
        + "    let o = flag ? i : 4294967295;\n"
        + "    uint p = flag ? i : 4294967295;\n"
        + "    int q = u + -1;\n"
        + "    let r = l + 9223372036854775808;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Convert 'u' first ('flag ? u "
        + "as long : -1').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Convert 'u' first ('flag ? u "
        + "as long : -1').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0. The literal takes its type from 'ul', a 'ulong'.");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0. The literal takes its type from 'ul', a 'ulong'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal -1 is below the smallest value of "
        + "'ushort', which is 0. The literal takes its type from 'us', a 'ushort'. Convert 'us' first "
        + "('flag ? us as int : -1').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'ushort', which is 0. The literal takes its type from 'us', a 'ushort'. Declare 'm' as 'int' "
        + "and convert 'us' ('int m = flag ? us as int : -1;').");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('flag ? b "
        + "as short : -1').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 4294967295 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'i', an 'int'. Convert 'i' "
        + "first ('flag ? i as long : 4294967295').");
    try sema_support.assertDiagnostic(reported, 11, file, "Literal 4294967295 is too large for 'int', "
        + "whose largest value is 2147483647. The literal takes its type from 'i', an 'int'. Declare 'p' "
        + "as 'long' and convert 'i' ('long p = flag ? i as long : 4294967295;').");
    try sema_support.assertDiagnostic(reported, 12, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0. The literal takes its type from 'u', a 'uint'. Declare 'q' as 'long' and "
        + "convert 'u' ('long q = u as long + -1;').");
    try sema_support.assertDiagnostic(reported, 13, file, "Literal 9223372036854775808 is too large for "
        + "'long', whose largest value is 9223372036854775807. The literal takes its type from 'l', a "
        + "'long'.");
    try testing.assertEqual(reported.length, 14L);
}

// A switch arm literal beside a typed arm takes that arm's type, so a literal too large for it gets
// the '?:' fix: declare the target wide enough and convert the typed arm. An arm of a type the target
// cannot take is refused as the assignment it is.
test "an integer literal arm takes the type of the typed arm beside it, as a '?:' branch does" {
    let analysis = try analyzeOne("forms(byte b, int i, float f, int k, bool flag) \{\n"
        + "    short x = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        default -> 40000,\n"
        + "    \};\n"
        + "    ushort y = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        default -> 65536,\n"
        + "    \};\n"
        + "    int z = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    float w = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        default -> 3.5e38,\n"
        + "    \};\n"
        + "    short t = flag ? b : 40000;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 40000 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Declare 'x' as 'ushort' "
        + "and convert 'b' ('0 -> b as ushort').");
    try sema_support.assertDiagnostic(reported, 1, file, "Variable 'y' has type 'ushort', but its value "
        + "has type 'int'.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'i', an 'int'. Declare 'z' as "
        + "'long' and convert 'i' ('0 -> i as long').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Declare 'w' as "
        + "'double' and convert 'f' ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 40000 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Declare 't' as 'ushort' "
        + "and convert 'b' ('ushort t = flag ? b as ushort : 40000;').");
    try testing.assertEqual(reported.length, 5L);
}

// Every literal of a switch, of a '?:' nested in a '?:' or of an array literal decides the type the
// typed value converts to, so the one fix covers them all and they get no report of their own. No
// fix is given where no integer type takes the typed value and every literal.
test "a join with several literals converts its typed value to one type every literal of the join takes" {
    let analysis = try analyzeOne("forms(byte b, int k, float f, bool flag, bool other, int i) \{\n"
        + "    let c = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let d = switch (k) \{\n"
        + "        0 -> f,\n"
        + "        1 -> 3.5e38,\n"
        + "        default -> -3.5e38,\n"
        + "    \};\n"
        + "    let e = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> 70000,\n"
        + "    \};\n"
        + "    let g = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> -1,\n"
        + "        default -> 18446744073709551615,\n"
        + "    \};\n"
        + "    short h = switch (k) \{\n"
        + "        0 -> b,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let m = flag ? (other ? b : 300) : -1;\n"
        + "    let n = flag ? b : (other ? 300 : -1);\n"
        + "    let o = [b, 300, -1];\n"
        + "    let q = switch (k) \{\n"
        + "        0 -> i,\n"
        + "        1 -> -1,\n"
        + "        default -> 3000000000,\n"
        + "    \};\n"
        + "    let r = flag ? (other ? b : 3) : -1;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as short').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 3.5e38 is too large for 'float', whose "
        + "largest value is about 3.402e38. The literal takes its type from 'f', a 'float'. Convert 'f' "
        + "first ('0 -> f as double').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as uint').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from 'b', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('0 -> b "
        + "as short').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('other "
        + "? b as short : 300').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[b as "
        + "short, 300, -1]').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. The literal takes its type from 'i', an 'int'. Convert 'i' first "
        + "('0 -> i as long').");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'byte', which is 0. The literal takes its type from '(other ? b : 3)', a 'byte'. Convert "
        + "'(other ? b : 3)' first ('flag ? (other ? b : 3) as short : -1').");
    try testing.assertEqual(reported.length, 9L);
}

// The literals of a '?:', a switch or an array literal, with the joins inside it, are judged as one:
// one report at the first that does not fit, with the type that takes every literal and every
// integer value of the join, and no fix where no type does or a negative literal meets an unsigned target.
test "every literal of one join is judged together, whichever way the literals get their type" {
    let analysis = try analyzeOne("forms(byte v, bool flag, bool other, int k) \{\n"
        + "    short x13 = flag ? v : (other ? 40000 : -40000);\n"
        + "    short[] x15 = [v, 40000, -40000];\n"
        + "    int x41 = flag ? v : (other ? 9223372036854775807 : -1);\n"
        + "    uint x42 = flag ? v : (other ? 9223372036854775807 : -1);\n"
        + "    let a = [flag ? v : 300, -1];\n"
        + "    let a8 = [flag ? v : 300, -1, 70000];\n"
        + "    let c = [switch (k) \{\n"
        + "        0 -> v,\n"
        + "        default -> 300,\n"
        + "    \}, -1];\n"
        + "    let x17 = flag ? v : (other ? 3000000000 : -1);\n"
        + "    uint x0 = switch (k) \{\n"
        + "        0 -> v,\n"
        + "        1 -> 300,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    let d = [v, flag ? 300 : -1];\n"
        + "    short e = flag ? 40000 : -40000;\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'x13' as 'int' instead.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'x15' as 'int[]' instead.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 9223372036854775807 is too large for "
        + "'int', whose largest value is 2147483647. Declare 'x41' as 'long' instead.");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 9223372036854775807 is too large for "
        + "'uint', whose largest value is 4294967295.");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[flag "
        + "? v as short : 300, -1]').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[flag "
        + "? v as int : 300, -1, 70000]').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first "
        + "('[switch (k) \{ 0 -> v as short, default -> 300, \}, -1]').");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'.");
    try sema_support.assertDiagnostic(reported, 9, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'v', a 'byte'. Convert 'v' first ('[v as "
        + "short, flag ? 300 : -1]').");
    try sema_support.assertDiagnostic(reported, 10, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'e' as 'int' instead.");
    try testing.assertEqual(reported.length, 11L);
}

// Nested array literals and the '?:' and switch values inside them share one join, so one report
// names one type and converts every value of the type the literals took, spelled across the whole
// array. A switch whose literal arm comes before its typed arm keeps the literal's target.
test "the outermost array literal is the join of every array literal and join nested in it" {
    let analysis = try analyzeOne("forms(byte b, bool flag, int k, int i) \{\n"
        + "    let a = [[b, 300], [-1]];\n"
        + "    let c = [[b, 300], [70000]];\n"
        + "    let d = [[b], [300, -1]];\n"
        + "    let e = [flag ? b : 300, flag ? -1 : b];\n"
        + "    let f = [switch (k) \{\n"
        + "        0 -> b,\n"
        + "        default -> 300,\n"
        + "    \}, flag ? -1 : b];\n"
        + "    let g = [[[b, 300]], [[-1]]];\n"
        + "    let h = [[3000000000], [i, -1]];\n"
        + "    short[][] m = [[b, 40000], [-40000]];\n"
        + "    uint[][] n = [[b, 300], [-1]];\n"
        + "    int w = switch (k) \{\n"
        + "        0 -> 70000,\n"
        + "        default -> b,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "short, 300], [-1]]').");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "uint, 300], [70000]]').");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[b as "
        + "short], [300, -1]]').");
    try sema_support.assertDiagnostic(reported, 3, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[flag "
        + "? b as short : 300, flag ? -1 : b as short]').");
    try sema_support.assertDiagnostic(reported, 4, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first "
        + "('[switch (k) \{ 0 -> b as short, default -> 300, \}, flag ? -1 : b as short]').");
    try sema_support.assertDiagnostic(reported, 5, file, "Literal 300 is too large for 'byte', whose "
        + "largest value is 255. The literal takes its type from 'b', a 'byte'. Convert 'b' first ('[[[b "
        + "as short, 300]], [[-1]]]').");
    try sema_support.assertDiagnostic(reported, 6, file, "Literal 3000000000 is too large for 'int', whose "
        + "largest value is 2147483647. Write '3000000000L' to make it a 'long'.");
    try sema_support.assertDiagnostic(reported, 7, file, "Literal 40000 is too large for 'short', whose "
        + "largest value is 32767. Declare 'm' as 'int[][]' instead.");
    try sema_support.assertDiagnostic(reported, 8, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0.");
    try testing.assertEqual(reported.length, 9L);
}

// A literal arm after a typed arm takes the type the arms before it join to; when no arm has that
// type it is the target's, so a negative literal under an unsigned target gets no fix, and a literal
// too large for it gets the declaration its twin with the typed arm first gets.
test "a negative literal meeting an unsigned declared target ends after the why in every arm order" {
    let analysis = try analyzeOne("forms(byte v, int k) \{\n"
        + "    uint a = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    ulong b = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> -1,\n"
        + "    \};\n"
        + "    uint c = switch (k) \{\n"
        + "        0 -> 300,\n"
        + "        1 -> v,\n"
        + "        default -> 5000000000,\n"
        + "    \};\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file, "Literal -1 is below the smallest value of "
        + "'uint', which is 0.");
    try sema_support.assertDiagnostic(reported, 1, file, "Literal -1 is below the smallest value of "
        + "'ulong', which is 0.");
    try sema_support.assertDiagnostic(reported, 2, file, "Literal 5000000000 is too large for 'uint', "
        + "whose largest value is 4294967295. Declare 'c' as 'ulong' instead.");
    try testing.assertEqual(reported.length, 3L);
}

// Each refusal names the value it refuses by its spelling. A comparison with 'null' on a value that
// can never be null is refused with the result the comparison always has.
test "an operator refusal names the operand it refuses and the result a null comparison always has" {
    let analysis = try analyzeOne("enum Coded \{\n"
        + "    One = 1,\n"
        + "\}\n"
        + "\n"
        + "main() -> int \{\n"
        + "    int i = 3;\n"
        + "    uint u = 4;\n"
        + "    double d = 2.5;\n"
        + "    bool flag = true;\n"
        + "    string? maybe = null;\n"
        + "    int shifted = d << 2;\n"
        + "    int mixed = i + u;\n"
        + "    bool both = flag && i;\n"
        + "    int negated = -\"x\";\n"
        + "    bool inverted = !i;\n"
        + "    bool never = i == null;\n"
        + "    bool always = null != i;\n"
        + "    string fallback = maybe ?? 3;\n"
        + "    double converted = Coded.One as double;\n"
        + "    int tried = try 5;\n"
        + "    return 0;\n"
        + "\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'<<' shifts an integer, but 'd' has type 'double'.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'+' needs the same number type on both sides, but 'i' has type 'int' and 'u' has type 'uint'. "
        + "Convert both sides to 'long', as in 'i as long + u as long'.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'&&' needs a 'bool' on both sides, but 'i' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "Unary '-' needs a number, but '\"x\"' has type 'string'.");
    try sema_support.assertDiagnostic(reported, 4, file, "'!' negates a 'bool', but 'i' has type 'int'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'i' has type 'int', which can never be null, so 'i == null' is always false. Remove the "
        + "comparison, or declare 'i' as 'int?' if it should allow null.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'i' has type 'int', which can never be null, so 'null != i' is always true. Remove the "
        + "comparison, or declare 'i' as 'int?' if it should allow null.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "The fallback after '??' has type 'int', but it replaces 'maybe' when 'maybe' is null, so it must "
        + "have type 'string'.");
    try sema_support.assertDiagnostic(reported, 8, file,
        "Cannot convert enum 'Coded' to 'double' with 'as'. An enum whose members have values converts "
        + "only to an integer type, such as 'int' or 'long'.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'try' must be written directly before a call, and '5' is not a call. Move 'try' to the call that "
        + "can throw.");
    try testing.assertEqual(reported.length, 10L);
}

// A switch whose first arm matches every value is written without the switch, a 'null' argument
// gets a nullable type argument, and two number types meet in the narrowest type with every value of
// both, or get no fix when none has them.
test "a fix never changes a value and always compiles where it is pasted" {
    let analysis = try analyzeOne("class Shape \{\n    constructor();\n\}\n\nfinal class Circle extends "
        + "Shape \{\n    constructor() \{\n        super();\n    \}\n\}\n\nclass Node \{\n    "
        + "constructor();\n\}\n\nidentity<T>(T value) -> T \{\n    return value;\n\}\n\nclass Pair2<A, B> "
        + "\{\n    constructor();\n\n    static make(A first) -> int \{\n        return 1;\n    "
        + "\}\n\}\n\nforms(Shape s, Circle c, Node? maybe, int k, uint u, long l, ulong ul, char ch, short "
        + "sh, ushort us, int n) \{\n    let a = switch (s) \{\n        is Shape -> 1,\n    \};\n    let b = "
        + "switch (c) \{\n        is Circle -> k + 1,\n    \};\n    let v = switch (maybe) \{\n        is "
        + "Node -> 1,\n        null -> 3,\n        default -> 2,\n    \};\n    let m = identity(null);\n    "
        + "let j = Pair2.make(first: 1);\n    bool below = k < u;\n    bool wide = l < ul;\n    double sum = "
        + "ch + 1.5;\n    int total = sh + us;\n    long masked = k & l;\n    long kept = (n as long) ?? "
        + "3;\n\}\n\nmain() -> int \{\n    return 0;\n\}\n");
    let reported = analysis.bodyDiagnostics();
    string file = "/proj/src/main.ens";
    try sema_support.assertDiagnostic(reported, 0, file,
        "'is Shape' matches every value of this switch over 'Shape', so the switch always takes this arm. "
        + "Write '1' instead of the switch.");
    try sema_support.assertDiagnostic(reported, 1, file,
        "'is Circle' matches every value of this switch over 'Circle', so the switch always takes this "
        + "arm. Write 'k + 1' instead of the switch.");
    try sema_support.assertDiagnostic(reported, 2, file,
        "'is Node' matches every value of this switch over 'Node?' that is not null. Check 'maybe' for "
        + "null with 'if' instead of switching on it.");
    try sema_support.assertDiagnostic(reported, 3, file,
        "'identity' is generic, and this call does not show what its type argument 'T' is. Write it, as "
        + "in 'identity<int?>(null)'.");
    try sema_support.assertDiagnostic(reported, 4, file,
        "When the type arguments of 'Pair2' come from the arguments, the call cannot name its arguments, "
        + "and no argument gives 'B' a type. Write the type arguments after 'Pair2', as in 'Pair2<int, "
        + "int>.make(first: 1)'.");
    try sema_support.assertDiagnostic(reported, 5, file,
        "'<' needs the same number type on both sides, but 'k' has type 'int' and 'u' has type 'uint'. "
        + "Convert both sides to 'long', as in 'k as long < u as long'.");
    try sema_support.assertDiagnostic(reported, 6, file,
        "'<' needs the same number type on both sides, but 'l' has type 'long' and 'ul' has type 'ulong'.");
    try sema_support.assertDiagnostic(reported, 7, file,
        "'+' needs the same number type on both sides, but 'ch' has type 'char' and '1.5' has type "
        + "'double'. Convert 'ch' to 'double', as in 'ch as double + 1.5'.");
    try sema_support.assertDiagnostic(reported, 8, file,
        "'+' needs the same number type on both sides, but 'sh' has type 'short' and 'us' has type "
        + "'ushort'. Convert both sides to 'int', as in 'sh as int + us as int'.");
    try sema_support.assertDiagnostic(reported, 9, file,
        "'&' needs the same integer type on both sides, but 'k' has type 'int' and 'l' has type 'long'. "
        + "Convert 'k' to 'long', as in 'k as long & l'.");
    try sema_support.assertDiagnostic(reported, 10, file,
        "'n as long' has type 'long', which can never be null, so the fallback after '??' is never used. "
        + "Remove '?? 3'.");
    try testing.assertEqual(reported.length, 11L);
}
