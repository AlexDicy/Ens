import @std.testing;
import ProgramAnalysis from pipeline;
import sema_support;
import FakeFileLoader from sema_support;

analyzeOne(string text) -> ProgramAnalysis throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", text);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.declareDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.linkDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.layoutDiagnostics());
    try sema_support.assertNoDiagnostics(analysis.checkDiagnostics());
    return analysis;
}

// A body wrapped around statements, so a test reads as the lines it is about.
inMain(string[] lines) -> string {
    string text = "main() -> int \{\n";
    for (let line in lines) {
        text = text + "    " + line + "\n";
    }
    return text + "    return 0;\n\}\n";
}

analyzeBody(string[] lines) -> ProgramAnalysis throws {
    return try analyzeOne(inMain(lines));
}

test "a literal that does not fit reports once, without a second operator error" {
    let analysis = try analyzeBody(["byte small = 3;", "byte sum = small + 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 300 does not fit in 'byte' (range 0..255)");
}

test "a literal that does not fit a compared type reports once" {
    let analysis = try analyzeBody(["byte small = 3;", "let ordered = small < 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 300 does not fit in 'byte' (range 0..255)");
}

test "an untyped literal adapts on either side of every bitwise operator" {
    let analysis = try analyzeBody(["uint flags = 0x12345678;",
        "uint low = flags & 0xFF;",
        "uint high = 0xFF00 | flags;",
        "uint flipped = flags ^ 0xFFFFFFFF;",
        "byte small = 0xF0;",
        "byte half = small >> 4;",
        "long wide = -16;",
        "long together = wide | 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a shift adapts an untyped distance to the value it shifts" {
    let analysis = try analyzeBody(["uint flags = 1;",
        "uint spread = flags << 8;",
        "ulong wide = 0xFF;",
        "ulong narrowed = wide >> 4;",
        "short signedHalf = -2;",
        "short doubled = signedHalf << 1;",
        "int word = -8;",
        "int dropped = word >>> 1;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the zero-filling shift follows the same operand rules as the other two" {
    let analysis = try analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags >>> spread;", "double places = 2.0;",
        "let moved = 64 >>> places;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'>>>' shifts a value of type 'uint', so the shift distance must be 'uint' too, "
            + "got 'byte'; convert the distance with 'as'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'>>>' needs an integer shift distance, got 'double'.");
}

test "two named integer types still need a cast on a bitwise operator" {
    let analysis = try analyzeBody(["uint flags = 1;", "int width = 255;",
        "let low = flags & width;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'&' needs the same integer type on both sides, got 'uint' and 'int'; "
            + "convert one side with 'as'.");
}

test "a shift distance of another named type names the value's type in the fix" {
    let analysis = try analyzeBody(["uint flags = 1;", "byte spread = 3;",
        "let wide = flags << spread;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'<<' shifts a value of type 'uint', so the shift distance must be 'uint' too, "
            + "got 'byte'; convert the distance with 'as'.");
}

test "an untyped literal left of a shift keeps its own type, so the distance is cast" {
    let analysis = try analyzeBody(["uint spread = 3;", "let mask = 1 << spread;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'<<' shifts a value of type 'int', so the shift distance must be 'int' too, "
            + "got 'uint'; convert the distance with 'as'.");
}

test "a bitwise operator rejects a non-integer by name" {
    let analysis = try analyzeBody(["double scale = 2.5;", "let masked = scale & 1;",
        "let moved = 64 >> scale;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'&' needs integers on both sides, got 'double' and 'int'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'>>' needs an integer shift distance, got 'double'.");
}

test "a bitwise literal that does not fit reports once" {
    let analysis = try analyzeBody(["byte mask = 0x0F;", "byte bits = mask & 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 300 does not fit in 'byte' (range 0..255)");
}

test "the complement operator takes every integer type and keeps it" {
    let analysis = try analyzeBody(["byte small = 0x0F;", "byte flippedSmall = ~small;",
        "short signedHalf = 1;", "short flippedHalf = ~signedHalf;",
        "ushort halfWord = 1;", "ushort flippedWord = ~halfWord;",
        "int word = 5;", "int flippedInt = ~word;",
        "uint flags = 1;", "uint flippedFlags = ~flags;",
        "long wide = 1;", "long flippedWide = ~wide;",
        "ulong unsignedWide = 1;", "ulong flippedUnsigned = ~unsignedWide;",
        "char letter = 'A';", "char flippedLetter = ~letter;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "the complement operator names the real type it refused" {
    let analysis = try analyzeBody(["double scale = 2.5;", "let flippedScale = ~scale;",
        "bool ready = true;", "let flippedReady = ~ready;",
        "string label = \"flags\";", "let flippedLabel = ~label;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'~' flips the bits of an integer, got 'double'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'~' flips the bits of an integer, got 'bool'.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "'~' flips the bits of an integer, got 'string'.");
}

test "a shift distance literal that does not fit reports once" {
    let analysis = try analyzeBody(["byte mask = 0x0F;", "byte bits = mask >> 300;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 300 does not fit in 'byte' (range 0..255)");
}

test "an unsuffixed floating-point literal adapts to the surrounding float" {
    let analysis = try analyzeBody(["float declared = 1.0;", "declared = 2.5;",
        "declared += 0.5;", "float negative = -1.5;", "float precise = 0.1;",
        "float largest = 3.4e38;", "float[] elements = [1.0, 2.0];",
        "float sibling = declared + 1.0;", "float leftSide = 1.0 + declared;",
        "float ternary = true ? 1.0 : declared;", "double wide = 1.0;",
        "double fromFloat = 1.0f;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a floating-point literal past the type's largest value is refused" {
    let analysis = try analyzeBody(["float tooLarge = 3.5e38;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 3.5e38 is too large for 'float', which holds about 3.4e38 at most; "
            + "'double' reaches further.");
}

test "a floating-point literal past every type names the widest one" {
    let analysis = try analyzeBody(["double tooLarge = 1e400;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal 1e400 is too large for 'double', which holds about 1.8e308 at most.");
}

test "a negative floating-point literal keeps its sign in the diagnostic" {
    let analysis = try analyzeBody(["float tooSmall = -1e40;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal -1e40 is too large for 'float'");
}

// The surrounding type reaches a literal that sits against it, not one behind an operator, so
// this matches 'uint total = 1 + 4;' rather than diverging from it.
test "a floating-point literal behind an operator keeps the operands' own type" {
    let analysis = try analyzeBody(["float sum = 1.0 + 2.0;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'double' to variable of type 'float'");
}

test "an untyped integer literal takes a floating-point type from its surroundings" {
    let analysis = try analyzeBody(["float whole = 5;", "float negative = -5;",
        "double wide = 5;", "float rounded = 16777217;",
        "float largest = 9223372036854775807;", "float[] elements = [1, 2];",
        "float declared = 1.0;", "float sibling = declared + 2;",
        "float leftSide = 2 + declared;", "float ternary = true ? 3 : declared;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "an integer literal with a suffix keeps its type against a float target" {
    let analysis = try analyzeBody(["float suffixed = 5L;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'long' to variable of type 'float'");
}

test "a literal nothing gives a type to must fit the default it falls back to" {
    let analysis = try analyzeBody(["let beyondInt = 3000000000;"]);
    let diagnostics = analysis.bodyDiagnostics();
    try testing.assertEqual(diagnostics.length, 1);
    try sema_support.assertMentions(diagnostics,
        "Literal 3000000000 does not fit in 'int' (range -2147483648..2147483647); "
            + "declare 'long' to hold it.");
}

test "a literal past every integer type has no wider one to name" {
    let analysis = try analyzeBody(["let beyondEveryType = 99999999999999999999;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal 99999999999999999999 does not fit in any integer type; the widest, 'ulong', "
            + "holds up to 18446744073709551615.");
}

test "a suffix moves the default, and the value must fit that" {
    let analysis = try analyzeBody(["let beyondLong = 18446744073709551615L;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal 18446744073709551615L does not fit in 'long'");
    try sema_support.assertMentions(analysis.bodyDiagnostics(), "declare 'ulong' to hold it.");
}

test "an untyped floating-point literal past every type is reported too" {
    let analysis = try analyzeBody(["let beyondDouble = 1e400;", "let beyondFloat = 3.5e38f;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal 1e400 is too large for 'double', which holds about 1.8e308 at most.");
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Literal 3.5e38f is too large for 'float', which holds about 3.4e38 at most; "
            + "'double' reaches further.");
}

// The sign sits outside the literal, and it moves the boundary, so both ends of a type's range
// are reachable and neither end is a false alarm.
test "the most negative value of a type is not mistaken for an overflow" {
    let analysis = try analyzeBody(["let firstInt = -2147483648;", "let lastInt = 2147483647;",
        "let firstLong = -9223372036854775808L;", "long beyondInt = 3000000000;",
        "ulong beyondLong = 18446744073709551615;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a cast lets a literal the target holds stay exact, and still truncates one it cannot" {
    let analysis = try analyzeBody(["uint full = 4294967295 as uint;",
        "long wide = 3000000000 as long;", "byte truncated = 300 as byte;",
        "float narrowed = 1.5 as float;"]);
    try sema_support.assertNoDiagnostics(analysis.bodyDiagnostics());
}

test "a suffix names a floating-point literal's type, leaving nothing to adapt" {
    let analysis = try analyzeBody(["float suffixed = 3.0d;"]);
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Cannot assign value of type 'double' to variable of type 'float'");
}
