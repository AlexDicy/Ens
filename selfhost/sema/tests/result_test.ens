import @std.testing;
import sema_support;
import SemaResult from result;
import TypeStore from model.types;
import PrimitiveKind from model.types;

test "what a result records during a trial is undone when the trial ends" {
    let store = new TypeStore();
    let integer = store.primitive(PrimitiveKind.Int);
    let text = store.stringType();
    let kept = sema_support.anyGreenNode();
    let added = sema_support.anyGreenNode();
    let result = new SemaResult();
    result.setType(kept, integer);
    result.beginTrial();
    result.setType(kept, text);
    result.setType(added, text);
    result.setNeverReturns(added);
    result.beginTrial();
    result.setType(added, integer);
    result.endTrial();
    try testing.assertTrue(result.typeOf(added) == text, "an inner trial should undo only its own writes");
    result.endTrial();
    try testing.assertTrue(result.typeOf(kept) == integer, "an overwritten entry should be put back");
    try testing.assertTrue(result.typeOf(added) == null, "an added entry should be removed");
    try testing.assertTrue(!result.neverReturns(added), "every table should be undone");
    result.setType(added, text);
    try testing.assertTrue(result.typeOf(added) == text, "a write after the trial should be kept");
}
