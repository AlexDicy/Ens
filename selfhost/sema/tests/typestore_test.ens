import @std.testing;
import model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import ClassType from model.types;
import EnumType from model.types;
import Type from model.types;
import sema_support;

test "primitives intern by kind" {
    let store = new TypeStore();
    try testing.assertTrue(store.primitive(PrimitiveKind.Int) == store.primitive(PrimitiveKind.Int),
        "two lookups of int should be the same object");
    try testing.assertTrue(store.primitive(PrimitiveKind.Int) != store.primitive(PrimitiveKind.Bool),
        "int and bool should be distinct objects");
    try testing.assertTrue(store.primitive(PrimitiveKind.Int).kind() == PrimitiveKind.Int,
        "the interned primitive should keep its kind");
}

test "string, null, and error types are singletons" {
    let store = new TypeStore();
    try testing.assertTrue(store.stringType() == store.stringType(),
        "string should be one object");
    try testing.assertTrue(store.nullType() == store.nullType(), "null should be one object");
    try testing.assertTrue(store.errorType() == store.errorType(), "error should be one object");
}

test "optionals intern by inner type and collapse" {
    let store = new TypeStore();
    let inner = store.primitive(PrimitiveKind.Int);
    let optional = store.optionalOf(inner);
    try testing.assertTrue(optional == store.optionalOf(inner),
        "int? should intern to one object");
    try testing.assertTrue(store.optionalOf(optional) == optional, "int?? should collapse to int?");
    try testing.assertTrue(store.optionalOf(store.errorType()) == store.errorType(),
        "an optional over the error type should stay the error type");
    try testing.assertTrue(store.optionalOf(store.stringType()) != optional,
        "optionals over different inner types should be distinct");
}

test "arrays intern by element type" {
    let store = new TypeStore();
    let element = store.primitive(PrimitiveKind.Long);
    let array = store.arrayOf(element);
    try testing.assertTrue(array == store.arrayOf(element), "long[] should intern to one object");
    try testing.assertTrue(store.arrayOf(array) != array,
        "long[][] should be distinct from long[]");
    try testing.assertTrue(store.arrayOf(store.errorType()) == store.errorType(),
        "an array over the error type should stay the error type");
}

test "declared types intern by module path and name" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let added = store.addClass("Box", "lib.box", "/proj/src/lib/box.ens", node,
        Visibility.Public, ["T"], false, true, false);
    try testing.assertTrue(store.findDeclared("lib.box", "Box") == added,
        "the lookup should return the registered object");
    try testing.assertTrue(store.findDeclared("other", "Box") == null,
        "the same name in another module should be unknown");
    try testing.assertTrue(store.findDeclared("lib.box", "Crate") == null,
        "an unregistered name should be unknown");
    try testing.assertTrue(store.hasDeclared("lib.box", "Box"),
        "hasDeclared should see the registered type");
}

test "declared types carry their published metadata" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let added = store.addClass("Widget", "app", "/proj/src/app.ens", node, Visibility.Private,
        ["T", "U"], true, false, true);
    try testing.assertEqual(added.name(), "Widget");
    try testing.assertEqual(added.modulePath(), "app");
    try testing.assertEqual(added.filePath(), "/proj/src/app.ens");
    try testing.assertTrue(added.visibility() == Visibility.Private, "visibility should persist");
    try testing.assertTrue(added.isAbstract(), "abstract should persist");
    try testing.assertFalse(added.isFinal(), "final should not appear unasked");
    try testing.assertTrue(added.isSealed(), "sealed should persist");
    try testing.assertTrue(added.isGeneric(), "two type parameters make the class generic");
    try testing.assertEqual(added.typeParameters().length, 2L);
    try testing.assertEqual(added.typeParameters()[0], "T");
    try testing.assertEqual(added.kindWord(), "class");

    let color = store.addEnum("Color", "app", "/proj/src/app.ens", node, Visibility.Public);
    try testing.assertEqual(color.kindWord(), "enum");
    try testing.assertFalse(color.isGeneric(), "an enum is never generic");
}

test "type parameters intern by owner and index" {
    let store = new TypeStore();
    let owner = sema_support.anyGreenNode();
    let other = sema_support.anyGreenNode();
    let first = store.typeParameter(owner, 0, "T");
    try testing.assertTrue(first == store.typeParameter(owner, 0, "T"),
        "the same owner and index should intern to one object");
    try testing.assertTrue(first != store.typeParameter(owner, 1, "U"),
        "another index on the same owner should be distinct");
    try testing.assertTrue(first != store.typeParameter(other, 0, "T"),
        "the same index on another owner should be distinct");
    try testing.assertEqual(first.name(), "T");
    try testing.assertEqual(types.display(first), "T");
}

test "instantiations intern by template and argument identity" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let box = store.addClass("Box", "lib", "/proj/src/lib.ens", node, Visibility.Public,
        ["T"], false, false, false);
    let pair = store.addStruct("Pair", "lib", "/proj/src/lib.ens", node, Visibility.Public,
        ["A", "B"]);
    Type intArgument = store.primitive(PrimitiveKind.Int);
    Type stringArgument = store.stringType();
    let boxOfInt = store.instantiationOf(box, [intArgument]);
    try testing.assertTrue(boxOfInt == store.instantiationOf(box, [intArgument]),
        "Box<int> should intern to one object");
    try testing.assertTrue(boxOfInt != store.instantiationOf(box, [stringArgument]),
        "Box<int> and Box<string> should be distinct");
    try testing.assertTrue(boxOfInt != store.instantiationOf(pair,
        [intArgument, stringArgument]), "different templates should be distinct");
    try testing.assertEqual(types.display(boxOfInt), "Box<int>");
    try testing.assertEqual(types.display(store.instantiationOf(pair,
        [intArgument, stringArgument])), "Pair<int, string>");
    try testing.assertTrue(types.authorityOf(boxOfInt) == box,
        "an instantiation defers to its template");
    try testing.assertTrue(types.isClassLike(boxOfInt),
        "an instantiation of a class template is class-like");
}

test "subclass and conformance walks follow bases and implemented interfaces" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let speaker = store.addInterface("Speaker", "app", "/proj/src/app.ens", node,
        Visibility.Public, []);
    let base = store.addClass("Base", "app", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    derived.setBase(base);
    base.setInterfaces([speaker]);
    try testing.assertTrue(types.isSubclassOf(derived, base), "derived reaches its base");
    try testing.assertTrue(types.isSubclassOf(derived, derived), "a class is its own subclass");
    try testing.assertFalse(types.isSubclassOf(base, derived), "a base is not its subclass");
    try testing.assertTrue(types.conformsTo(derived, speaker),
        "conformance passes through the base chain");
    try testing.assertTrue(types.isSubclassOrConforms(derived, speaker),
        "the combined test picks conformance for an interface");
}

test "override return compatibility allows identity, widening, and subclasses" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    derived.setBase(base);
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    try testing.assertTrue(types.overrideReturnCompatible(intType, intType),
        "the same return type is compatible");
    try testing.assertTrue(types.overrideReturnCompatible(longType, intType),
        "an int return may stand in for a long return");
    try testing.assertFalse(types.overrideReturnCompatible(intType, longType),
        "a long return cannot stand in for an int return");
    try testing.assertTrue(types.overrideReturnCompatible(base, derived),
        "a subclass return is compatible");
    try testing.assertFalse(types.overrideReturnCompatible(derived, base),
        "a base return is not compatible with a subclass declaration");
    try testing.assertTrue(types.overrideReturnCompatible(store.optionalOf(base), derived),
        "the non-null form of an optional return is compatible");
}
