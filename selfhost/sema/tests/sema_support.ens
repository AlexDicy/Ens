// Shared helpers for the sema test files: an in-memory file tree standing in for the file system,
// and assertions over graph results and diagnostics.
import @std.testing;
import TestFailure from @std.testing;
import Map from @std.collections.map;
import FileLoader from loader;
import FileError from loader;
import FileDiagnostic from diagnostics;
import Module from graph;
import GraphResult from graph;

public class FakeFileLoader implements FileLoader {
    private Map<string, string> files;

    constructor() {
        this.files = new Map<string, string>();
    }

    add(string path, string text) {
        this.files.set(path, text);
    }

    override exists(string path) -> bool {
        return this.files.contains(path);
    }

    override readText(string path) -> string throws FileError {
        let text = this.files.get(path);
        if (text == null) {
            throw new FileError("Could not read '{path}'.");
        }
        return text;
    }
}

public assertNoDiagnostics(FileDiagnostic[] diagnostics) throws {
    if (diagnostics.length != 0) {
        try testing.fail("expected no diagnostics but found {diagnostics.length}; "
            + "first: {diagnostics[0].message()}");
    }
}

public assertDiagnostic(FileDiagnostic[] diagnostics, long index, string file, string message)
        throws {
    try testing.assertTrue(diagnostics.length > index,
        "expected a diagnostic at index {index} but found only {diagnostics.length}");
    let diagnostic = diagnostics[index];
    try testing.assertEqual(diagnostic.file(), file);
    try testing.assertEqual(diagnostic.message(), message);
}

// The graph's modules are expected to match exactly, in load order.
public assertModulePaths(GraphResult result, string[] expected) throws {
    Module[] modules = result.modules();
    if (modules.length != expected.length) {
        try testing.fail("expected {expected.length} modules but found {modules.length}; "
            + "first: {describeModules(modules)}");
    }
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(modules[i].canonicalPath(), expected[i]);
    }
}

public assertImports(Module loaded, string[] expected) throws {
    string[] imports = loaded.imports();
    try testing.assertEqual(imports.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(imports[i], expected[i]);
    }
}

public moduleWithPath(GraphResult result, string canonicalPath) -> Module throws {
    let found = result.moduleWithPath(canonicalPath);
    if (found == null) {
        throw new TestFailure("no module '{canonicalPath}' in the graph; loaded: "
            + describeModules(result.modules()));
    }
    return found;
}

private describeModules(Module[] modules) -> string {
    string described = "";
    for (long i = 0; i < modules.length; i++) {
        if (i > 0) {
            described = described + ", ";
        }
        described = described + modules[i].canonicalPath();
    }
    return described;
}
