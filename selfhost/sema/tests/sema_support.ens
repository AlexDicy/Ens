// Shared helpers for the sema test files: an in-memory file tree standing in for the file system,
// assertions over graph results and diagnostics, and the declare + link pipeline the harness runs.
import @std.testing;
import TestFailure from @std.testing;
import List from @std.collections.list;
import Map from @std.collections.map;
import Source from @ens.frontend.source;
import @ens.frontend.parser;
import @ens.frontend.syntax.factory;
import SourceFileNode from @ens.frontend.syntax.nodes;
import GreenNode from @ens.frontend.syntax.green;
import FileLoader from loader;
import FileError from loader;
import FileDiagnostic from diagnostics;
import diagnostics;
import Module from graph;
import GraphResult from graph;
import graph;
import DeclareResult from declare;
import FileDeclarations from declare;
import declare;
import TypeStore from types;
import DeclaredType from types;
import ClassType from types;
import StructType from types;
import InterfaceType from types;
import EnumType from types;
import LinkResult from link;
import NameBinding from link;
import ImportedType from link;
import ImportedNamespace from link;
import link;
import ModuleContext from context;
import ProgramAnalysis from pipeline;
import pipeline;

public class FakeFileLoader implements FileLoader {
    private Map<string, string> files;

    constructor() {
        this.files = new Map<string, string>();
    }

    add(string path, string text) {
        this.files.set(path, text);
    }

    override exists(string path) -> bool {
        return this.files.contains(path);
    }

    override readText(string path) -> string throws FileError {
        let text = this.files.get(path);
        if (text == null) {
            throw new FileError("Could not read '{path}'.");
        }
        return text;
    }
}

public assertNoDiagnostics(FileDiagnostic[] diagnostics) throws {
    if (diagnostics.length != 0) {
        try testing.fail("expected no diagnostics but found {diagnostics.length}; "
            + "first: {diagnostics[0].message()}");
    }
}

public assertDiagnostic(FileDiagnostic[] diagnostics, long index, string file, string message)
        throws {
    try testing.assertTrue(diagnostics.length > index,
        "expected a diagnostic at index {index} but found only {diagnostics.length}");
    let diagnostic = diagnostics[index];
    try testing.assertEqual(diagnostic.file(), file);
    try testing.assertEqual(diagnostic.message(), message);
}

// The graph's modules are expected to match exactly, in load order.
public assertModulePaths(GraphResult result, string[] expected) throws {
    Module[] modules = result.modules();
    if (modules.length != expected.length) {
        try testing.fail("expected {expected.length} modules but found {modules.length}; "
            + "first: {describeModules(modules)}");
    }
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(modules[i].canonicalPath(), expected[i]);
    }
}

public assertImports(Module loaded, string[] expected) throws {
    string[] imports = loaded.imports();
    try testing.assertEqual(imports.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(imports[i], expected[i]);
    }
}

public moduleWithPath(GraphResult result, string canonicalPath) -> Module throws {
    let found = result.moduleWithPath(canonicalPath);
    if (found == null) {
        throw new TestFailure("no module '{canonicalPath}' in the graph; loaded: "
            + describeModules(result.modules()));
    }
    return found;
}

private describeModules(Module[] modules) -> string {
    string described = "";
    for (long i = 0; i < modules.length; i++) {
        if (i > 0) {
            described = described + ", ";
        }
        described = described + modules[i].canonicalPath();
    }
    return described;
}

public parseSource(string filePath, string text) -> SourceFileNode {
    let parsed = parser.parse(new Source(filePath, text));
    let root = factory.createRoot(parsed.root());
    if (root is SourceFileNode) {
        return root;
    }
    panic("Internal: the parser did not produce a source file for {filePath}");
}

public declareSource(string filePath, string text) -> DeclareResult {
    return declare.declareFile(parseSource(filePath, text), filePath);
}

// A green node for tests that only need a declaration-site placeholder.
public anyGreenNode() -> GreenNode {
    return parser.parse(new Source("placeholder.ens", "")).root();
}

// The declared and linked view of one in-memory program, produced the way the harness produces
// it: graph, then declare over every module, then link.
public class Pipeline {
    private GraphResult pipelineGraph;
    private TypeStore pipelineStore;
    private LinkResult pipelineLink;
    private FileDiagnostic[] pipelineDeclareDiagnostics;

    constructor(GraphResult graphResult, TypeStore store, LinkResult linkResult,
                FileDiagnostic[] declareDiagnostics) {
        this.pipelineGraph = graphResult;
        this.pipelineStore = store;
        this.pipelineLink = linkResult;
        this.pipelineDeclareDiagnostics = declareDiagnostics;
    }

    graphResult() -> GraphResult {
        return this.pipelineGraph;
    }

    store() -> TypeStore {
        return this.pipelineStore;
    }

    linkResult() -> LinkResult {
        return this.pipelineLink;
    }

    declareDiagnostics() -> FileDiagnostic[] {
        return this.pipelineDeclareDiagnostics;
    }
}

public analyze(FakeFileLoader loader, string sourceRoot, string[] seeds) -> Pipeline {
    let result = graph.buildGraph(loader, sourceRoot, "", "/stdlib", seeds);
    let declarations = new List<FileDeclarations>();
    let declareDiagnostics = new List<FileDiagnostic>();
    for (let loaded in result.modules()) {
        let root = factory.createRoot(loaded.parseResult().root());
        if (root is SourceFileNode) {
            let declared = declare.declareFile(root, loaded.filePath());
            declarations.push(declared.declarations());
            for (let diagnostic in declared.diagnostics()) {
                declareDiagnostics.push(diagnostic);
            }
        } else {
            declarations.push(new FileDeclarations(loaded.filePath(), [], [], [], [], [], []));
        }
    }
    let store = new TypeStore();
    let linked = link.linkProgram(result.modules(), declarations.toArray(), store);
    return new Pipeline(result, store, linked, diagnostics.sorted(declareDiagnostics));
}

// Asserts the whole pipeline produced no diagnostics: graph, declare, and link.
public assertClean(Pipeline pipeline) throws {
    try assertNoDiagnostics(pipeline.graphResult().diagnostics());
    try assertNoDiagnostics(pipeline.declareDiagnostics());
    try assertNoDiagnostics(pipeline.linkResult().diagnostics());
}

public boundType(Pipeline pipeline, string modulePath, string name) -> DeclaredType throws {
    let binding = try namedBinding(pipeline, modulePath, name);
    if (binding is ImportedType) {
        return binding.target();
    }
    throw new TestFailure("binding '{name}' in module '{modulePath}' is not a type import");
}

public boundNamespace(Pipeline pipeline, string modulePath, string name) -> string throws {
    let binding = try namedBinding(pipeline, modulePath, name);
    if (binding is ImportedNamespace) {
        return binding.modulePath();
    }
    throw new TestFailure("binding '{name}' in module '{modulePath}' is not a namespace import");
}

private namedBinding(Pipeline pipeline, string modulePath, string name) -> NameBinding throws {
    let table = pipeline.linkResult().tableFor(modulePath);
    if (table == null) {
        throw new TestFailure("no link table for module '{modulePath}'");
    }
    let binding = table.binding(name);
    if (binding == null) {
        throw new TestFailure("no binding named '{name}' in module '{modulePath}'");
    }
    return binding;
}

// Runs the whole sema pipeline over an in-memory program: graph, declare, link, signatures,
// layout, and the declaration checks.
public analyzeAll(FakeFileLoader loader, string sourceRoot, string[] seeds) -> ProgramAnalysis {
    let result = graph.buildGraph(loader, sourceRoot, "", "/stdlib", seeds);
    return pipeline.analyzeProgram(result);
}

public assertProgramClean(ProgramAnalysis analysis) throws {
    try assertNoDiagnostics(analysis.declareDiagnostics());
    try assertNoDiagnostics(analysis.linkDiagnostics());
    try assertNoDiagnostics(analysis.signatureDiagnostics());
    try assertNoDiagnostics(analysis.layoutDiagnostics());
    try assertNoDiagnostics(analysis.checkDiagnostics());
}

// Asserts one of the diagnostics mentions the fragment.
public assertMentions(FileDiagnostic[] diagnostics, string fragment) throws {
    for (let diagnostic in diagnostics) {
        if (diagnostic.message().indexOf(fragment) >= 0) {
            return;
        }
    }
    string seen = "none";
    if (diagnostics.length > 0) {
        seen = diagnostics[0].message();
    }
    throw new TestFailure("no diagnostic mentions '{fragment}' "
        + "({diagnostics.length} reported; first: {seen})");
}

public contextFor(ProgramAnalysis analysis, string modulePath) -> ModuleContext throws {
    let contexts = analysis.contexts();
    for (long i = 0; i < contexts.length(); i++) {
        if (contexts.get(i).module().canonicalPath() == modulePath) {
            return contexts.get(i);
        }
    }
    throw new TestFailure("no analyzed module '{modulePath}'");
}

public classNamed(ProgramAnalysis analysis, string modulePath, string name) -> ClassType throws {
    let found = analysis.store().findDeclared(modulePath, name);
    if (found is ClassType) {
        return found;
    }
    throw new TestFailure("no class '{name}' in module '{modulePath}'");
}

public structNamed(ProgramAnalysis analysis, string modulePath, string name)
        -> StructType throws {
    let found = analysis.store().findDeclared(modulePath, name);
    if (found is StructType) {
        return found;
    }
    throw new TestFailure("no struct '{name}' in module '{modulePath}'");
}

public interfaceNamed(ProgramAnalysis analysis, string modulePath, string name)
        -> InterfaceType throws {
    let found = analysis.store().findDeclared(modulePath, name);
    if (found is InterfaceType) {
        return found;
    }
    throw new TestFailure("no interface '{name}' in module '{modulePath}'");
}

public enumNamed(ProgramAnalysis analysis, string modulePath, string name) -> EnumType throws {
    let found = analysis.store().findDeclared(modulePath, name);
    if (found is EnumType) {
        return found;
    }
    throw new TestFailure("no enum '{name}' in module '{modulePath}'");
}
